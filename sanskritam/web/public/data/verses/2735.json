[{"id": 2081897, "chapter_id": 2735, "verse_number": "१२-२४०-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081898, "chapter_id": 2735, "verse_number": "१२-२४०-१", "content_sanskrit": "भूतग्रामे नियुक्तं यत्तदेतत्कीर्तितं मया।\nब्राह्मणस्य तु यत्कृत्यं तत्ते वक्ष्यामि सांप्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081899, "chapter_id": 2735, "verse_number": "१२-२४०-२", "content_sanskrit": "जातकर्मप्रभृत्यस्य कर्मणां दक्षिणावताम्।\nक्रिया स्यादासमावृत्तेराचार्ये वेदपारगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081900, "chapter_id": 2735, "verse_number": "१२-२४०-३", "content_sanskrit": "अधीत्य वेदानखिलान्गुरुशुश्रूषणे रतः।\nगुरूणामनृणो भूत्वा समावर्तेत यज्ञवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081901, "chapter_id": 2735, "verse_number": "१२-२४०-४", "content_sanskrit": "आचार्येणाभ्यनुज्ञातश्चतुर्णामेकमाश्रमम्।\nआविमोक्षाच्छरीरस्य सोऽवतिष्ठेद्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081902, "chapter_id": 2735, "verse_number": "१२-२४०-५", "content_sanskrit": "प्रजासर्गण दारैश्च ब्रह्मचर्येण वा पुनः।\nवने गुरुसकाशे वा यतिधर्मेण वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081903, "chapter_id": 2735, "verse_number": "१२-२४०-६", "content_sanskrit": "गृहस्थस्त्वेष धर्माणां सर्वेषां मूलमुच्यते।\nयत्र पक्वकषायो हि दान्तः सर्वत्र सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081904, "chapter_id": 2735, "verse_number": "१२-२४०-७", "content_sanskrit": "प्रजावान्श्रोत्रियो यज्वा मुक्त एव ऋणैस्त्रिभिः।\nअथान्यानाश्रमान्पश्चात्पूतो गच्छेत कर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081905, "chapter_id": 2735, "verse_number": "१२-२४०-८", "content_sanskrit": "यत्पृथिव्यां पुण्यतमं विद्यात्स्थानं तदावसेत्।\nयतेत तस्मिन्प्रामाण्यं गन्तुं यशसि चोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081906, "chapter_id": 2735, "verse_number": "१२-२४०-९", "content_sanskrit": "तपसा वः सुमहता विद्यानां पारणेन वा।\nइज्यया वा प्रदानैर्वा विप्राणां वर्धते यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081907, "chapter_id": 2735, "verse_number": "१२-२४०-१०", "content_sanskrit": "यावदस्य भवत्यस्मिन्कीर्तिर्लोके यशस्करी।\nतावत्पुण्यकृताँल्लोकाननन्तान्पुरुषोऽश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081908, "chapter_id": 2735, "verse_number": "१२-२४०-११", "content_sanskrit": "अध्यापयेदधीयीत याजयेत यजेत वा।\nन वृथा प्रतिगृह्णीयान्न च दद्यात्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081909, "chapter_id": 2735, "verse_number": "१२-२४०-१२", "content_sanskrit": "याज्यतः शिष्यतो वाऽपि कन्याया वा धनं महत्।\nयद्यागच्छेद्यजेद्दद्यान्नैकोऽश्नीयात्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081910, "chapter_id": 2735, "verse_number": "१२-२४०-१३", "content_sanskrit": "गृहमावसतो ह्यस्य नान्यत्तीर्थमुदाहृतम्।\nदेवर्षिपितृगुर्वर्थं वृद्धातुरबुभुक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081911, "chapter_id": 2735, "verse_number": "१२-२४०-१४", "content_sanskrit": "अन्तर्हिताभितप्तानां यथाशक्ति बुभूषताम्।\nद्रव्याणामतिशक्त्याऽपि देयमेषां कृतादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081912, "chapter_id": 2735, "verse_number": "१२-२४०-१५", "content_sanskrit": "अर्हतामनुरूपाणां नादेयं ह्यस्ति किंचन।\nउच्चैः श्रवसमप्यक्षं काश्यपाय महात्मने।\nदत्त्वा जगाम प्रह्लादो लोकान्देवैरभिष्टुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081913, "chapter_id": 2735, "verse_number": "१२-२४०-१६", "content_sanskrit": "अनुनीय तथा काव्यः सत्यसन्धो महाव्रतः।\nस्वैः प्राणैर्ब्राह्मणप्राणान्परित्राय दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081914, "chapter_id": 2735, "verse_number": "१२-२४०-१७", "content_sanskrit": "रन्तिदेवश्च सांकृत्यो वसिष्ठाय महात्मने।\nअपः प्रदाय शीतोष्णा नाकपृष्ठे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081915, "chapter_id": 2735, "verse_number": "१२-२४०-१८", "content_sanskrit": "आत्रेयश्चेन्द्रद्रुमये ह्यर्हते विविधं धनम्।\nदत्त्वा लोकान्ययौ धीमाननन्तान्स महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081916, "chapter_id": 2735, "verse_number": "१२-२४०-१९", "content_sanskrit": "शिबिरौशीनरोऽङ्गानि सुतं च प्रियमौरसम्।\nब्राह्मणार्थमुपाकृत्य नाकपृष्ठमितो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081917, "chapter_id": 2735, "verse_number": "१२-२४०-२०", "content_sanskrit": "प्रतर्दनः काशिपतिः प्रदाय नयने स्वके।\nब्राह्मणायातुलां कीर्तिमिह चामुत्र चाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081918, "chapter_id": 2735, "verse_number": "१२-२४०-२१", "content_sanskrit": "दिव्यमष्टशलाकं तु सौवर्णं परमर्द्धिमत्।\nछत्रं देवावृधो दत्त्वा सराष्ट्रोऽभ्यगमद्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081919, "chapter_id": 2735, "verse_number": "१२-२४०-२२", "content_sanskrit": "सांकृतिश्च तथाऽऽत्रेयः शिष्येभ्यो ब्रह्म निर्गुणम्।\nउपदिश्य महातेजा गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081920, "chapter_id": 2735, "verse_number": "१२-२४०-२३", "content_sanskrit": "अम्बरीषो गवां दत्त्वा ब्राह्मणेभ्यः प्रतापवान्।\nअर्बुदानि दशैकं च सराष्ट्रोऽभ्यगमद्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081921, "chapter_id": 2735, "verse_number": "१२-२४०-२४", "content_sanskrit": "सावित्री कुण्डले दिव्ये शरीरं जनमेजयः।\nब्राह्मणार्थे परित्यज्य जग्मतुर्लोकमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081922, "chapter_id": 2735, "verse_number": "१२-२४०-२५", "content_sanskrit": "सर्वरत्नं वृषादर्विर्युवनाश्वः प्रियाः स्त्रियः।\nरम्यमावसथं चैव दत्त्वामुं लोकमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081923, "chapter_id": 2735, "verse_number": "१२-२४०-२६", "content_sanskrit": "निमी राष्ट्रं च वैदेहो जामदग्न्यो वसुंधराम्।\nब्राह्मणेभ्यो ददौ चापि गयश्चोर्वी सपत्तनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081924, "chapter_id": 2735, "verse_number": "१२-२४०-२७", "content_sanskrit": "अवर्षति च पर्जन्ये सर्वभूतानि भूतकृत।\nवसिष्ठो जीवयामास प्रजापतिरिव प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081925, "chapter_id": 2735, "verse_number": "१२-२४०-२८", "content_sanskrit": "करंधमस्य पुत्रस्तु मरुतो नृपतिस्तथा।\nकन्यामङ्गिरसे दत्त्वा दिवमाशु जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081926, "chapter_id": 2735, "verse_number": "१२-२४०-२९", "content_sanskrit": "ब्रह्मदत्तश्च पाञ्चाल्यो राजा बुद्धिमतां वरः।\nनिधिं शङ्खं द्विजाग्र्येभ्यो दत्त्वा लोकानवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081927, "chapter_id": 2735, "verse_number": "१२-२४०-३०", "content_sanskrit": "राजा मित्रसहश्चापि वसिष्ठाय महात्मने।\nमदयन्तीं प्रियां दत्त्वा तया सह दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081928, "chapter_id": 2735, "verse_number": "१२-२४०-३१", "content_sanskrit": "सहस्रजिच्च राजर्षिः प्राणानिंष्टान्महायशाः।\nब्राह्मणार्थं परित्यज्य गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081929, "chapter_id": 2735, "verse_number": "१२-२४०-३२", "content_sanskrit": "सर्वकामैश्च संपूर्णं दत्त्वा वेश्म हिरण्मयम्।\nमुद्गलाय गतः स्वर्गं शतद्युम्नो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081930, "chapter_id": 2735, "verse_number": "१२-२४०-३३", "content_sanskrit": "नाम्ना च द्युतिमान्नाम साल्वराजः प्रतापवान्।\nदत्त्वा राज्यमृचीकाय गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081931, "chapter_id": 2735, "verse_number": "१२-२४०-३४", "content_sanskrit": "लोमपादश्च राजर्षिः शान्तां दत्त्वा सुतां प्रभुः।\nऋश्यशृङ्गाय विपुलैः सर्वकामैरयुज्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081932, "chapter_id": 2735, "verse_number": "१२-२४०-३५", "content_sanskrit": "मदिराश्वश्च राजर्षिर्दत्त्वा कन्यां सुमध्यमाम्।\nहिरण्यहस्ताय गतो लोकान्देवैरभिष्टुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081933, "chapter_id": 2735, "verse_number": "१२-२४०-३६", "content_sanskrit": "दत्त्वा शतसहस्रं तु गवां राजा प्रसेनजित्।\nसवत्सानां महातेजा गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081934, "chapter_id": 2735, "verse_number": "१२-२४०-३७", "content_sanskrit": "एते चान्ये च बहवो दानेन तपसैव च।\nमहात्मानो गताः स्वर्गं शिष्टात्मानो जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081935, "chapter_id": 2735, "verse_number": "१२-२४०-३८", "content_sanskrit": "तेषां प्रतिष्ठिता कीर्तिर्यावत्स्थास्यति मेदिनी।\nदानयज्ञप्रजासर्गैरेते हि दिवमाप्नुवन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081936, "chapter_id": 2735, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]