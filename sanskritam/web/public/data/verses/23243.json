[{"id": 7003243000, "chapter_id": 23243, "verse_number": "१-४६-१", "content_sanskrit": "सूत उवाच  ।\nसप्तद्वीपा तथा पृथ्वी नदीपर्वतसंकुला  ।\nसमुद्रैः सप्तभिश्चैव सर्वतः समलंकृता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003243001, "chapter_id": 23243, "verse_number": "१-४६-२", "content_sanskrit": "जंबूः प्लक्षः शाल्मलिश्च कुशः क्रौञ्चस्तथैव च  ।\nशाकः पुष्करनामा च द्वीपास्त्वभ्यन्तरे क्रमात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003243002, "chapter_id": 23243, "verse_number": "१-४६-३", "content_sanskrit": "सप्तद्वीपेषु सर्वेषु सांबः सर्वगणैर्वृतः  ।\nनानावेषधरो भूत्वा सान्निध्यं कुरुते हरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003243003, "chapter_id": 23243, "verse_number": "१-४६-४", "content_sanskrit": "क्षारोदेक्षुरसोदश्च सुरोदश्च घृतोदधिः  ।\nदध्यर्णवश्च क्षीरोदः स्वादूदश्चाप्यनुक्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003243004, "chapter_id": 23243, "verse_number": "१-४६-५", "content_sanskrit": "समुद्रेष्विह सर्वेषु सर्वदा सगणः शिवः  ।\nजलरूपी भवः श्रीमान् क्रीडते चोर्मिबाहुभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003243005, "chapter_id": 23243, "verse_number": "१-४६-६", "content_sanskrit": "क्षीरार्णवामृतमिव सदा क्षीरार्णवे हरिः  ।\nशेते शिवज्ञानाधिया साक्षाद्वै योगनिद्रया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003243006, "chapter_id": 23243, "verse_number": "१-४६-७", "content_sanskrit": "यदा प्रबुद्धो भगवान्प्रबुद्धमखिलं जगत्  ।\nयदा सुप्तस्तदा सुप्तं तन्मयं च चराचरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003243007, "chapter_id": 23243, "verse_number": "१-४६-८", "content_sanskrit": "तेनैव सृष्टमखिलं धृतं रक्षितमेव च  ।\nसंहृतं देवदेवस्य प्रसादात्परमेष्ठिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003243008, "chapter_id": 23243, "verse_number": "१-४६-९", "content_sanskrit": "सुषेणा इति विख्याता यजंते पुरुषर्षभम्  ।\nअनिरुद्धं मुनिश्रेष्ठाः शंखचक्रगदाधरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003243009, "chapter_id": 23243, "verse_number": "१-४६-१०", "content_sanskrit": "ये चानिरुद्धं पुरुषं ध्यायंत्यात्मविदां वराः  ।\nनारायणसमाः सर्वे सर्वसंपत्समन्विताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003243010, "chapter_id": 23243, "verse_number": "१-४६-११", "content_sanskrit": "सनंदनश्च भगवान् सनकश्च सनातनः  ।\nवालखिल्याश्च सिद्धाश्च मित्रावरुणकौ तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003243011, "chapter_id": 23243, "verse_number": "१-४६-१२", "content_sanskrit": "यजंति सततं तत्र विश्वस्य प्रभवं हरिम्  ।\nसप्तद्वीपेषु तिष्ठंति नानाश्रृंगा महोदयाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003243012, "chapter_id": 23243, "verse_number": "१-४६-१३", "content_sanskrit": "आसमुद्रायताः केचिद्गिरयो गह्वरैस्तथा  ।\nधरायाः पतयश्चासन् बहवः कालगौरवात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003243013, "chapter_id": 23243, "verse_number": "१-४६-१४", "content_sanskrit": "सामर्थ्यात्परमेशानाः क्रौञ्चारेर्जनकात्प्रभोः  ।\nमन्वन्तरेषु सर्वेषु अतीतानागतेष्विह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003243014, "chapter_id": 23243, "verse_number": "१-४६-१५", "content_sanskrit": "प्रवक्ष्यामि धरेशान् वो वक्ष्ये स्वायंभुवेन्तरे  ।\nमन्वंतरेषु सर्वेषु अतीतानागतेषु च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003243015, "chapter_id": 23243, "verse_number": "१-४६-१६", "content_sanskrit": "तुल्याभिमानिनश्चैव सर्वे तुल्यप्रयोजनाः  ।\nस्वायंभुवस्य च मनोः पौत्रास्त्वासन्महा बलाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003243016, "chapter_id": 23243, "verse_number": "१-४६-१७", "content_sanskrit": "प्रियव्रतात्मजा वीरास्ते दशेह प्रकीर्तिताः  ।\nआग्नीध्रश्चाग्निबाहुश्च मेधा मेधातिथिर्वसुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003243017, "chapter_id": 23243, "verse_number": "१-४६-१८", "content_sanskrit": "ज्योतिष्मान्द्युतिमान् हव्यः सवनः पुत्र एव च  ।\nप्रियव्रतोऽभ्यषिंचत्तान् सप्त सप्तसु पार्थिवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003243018, "chapter_id": 23243, "verse_number": "१-४६-१९", "content_sanskrit": "जंबूद्वीपेश्वरं चक्रे आग्नीध्रं सुमहाबलम्  ।\nप्लक्षद्वीपेश्वरश्चापि तेन मेधातिथिः कृतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003243019, "chapter_id": 23243, "verse_number": "१-४६-२०", "content_sanskrit": "शाल्मलेश्च वपुष्मंतं राजानमभिषिक्तवान्  ।\nज्योतिष्मंतं कुशद्वीपे राजानं कृतवान्नृपः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003243020, "chapter_id": 23243, "verse_number": "१-४६-२१", "content_sanskrit": "द्युतिमंतं च राजानं क्रौंचद्वीपे समादिशत्  ।\nशाकद्वीपेश्वरं चापि हव्यं चक्रे प्रियव्रतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003243021, "chapter_id": 23243, "verse_number": "१-४६-२२", "content_sanskrit": "पुष्कराधिपतिं चक्रे सवनं चापि सुव्रताः  ।\nपुष्करे सवनस्यापि महावीतः सुतोऽभवत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003243022, "chapter_id": 23243, "verse_number": "१-४६-२३", "content_sanskrit": "धातकी चैव द्वावेतौ पुत्रौ पुत्रवतां वरौ  ।\nमहावीतं स्मृतं वर्षं तस्य नाम्ना महात्मनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003243023, "chapter_id": 23243, "verse_number": "१-४६-२४", "content_sanskrit": "नाम्ना तु धातकेश्चैव धातकीखंडमुच्यते  ।\nहव्योप्यजनयत्पुत्राञ्छाकद्वीपेश्वरः प्रभुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003243024, "chapter_id": 23243, "verse_number": "१-४६-२५", "content_sanskrit": "जलदं च कुमारं च सुकुमारं मणीचकम्  ।\nकुसुमोत्तरमोदाकी सप्तमस्तु महाद्रुमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003243025, "chapter_id": 23243, "verse_number": "१-४६-२६", "content_sanskrit": "अलदं जलदस्याथ वर्षं प्रथममुच्यते  ।\nकुमारस्य तु कौमारं द्वितीयं परिकीर्तितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003243026, "chapter_id": 23243, "verse_number": "१-४६-२७", "content_sanskrit": "सुकुमारं तृतीयं तु सुकुमारस्य कीर्त्यते  ।\nमणीचकं चतुर्थं तु माणचिकमिहोच्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003243027, "chapter_id": 23243, "verse_number": "१-४६-२८", "content_sanskrit": "कुसुमोत्तरस्य वै वर्षं पंचमं कुसुमोत्तरम्  ।\nमोदकं चापि मोदाकेर्वर्षं षष्ठं प्रकीर्तितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003243028, "chapter_id": 23243, "verse_number": "१-४६-२९", "content_sanskrit": "महाद्रुमस्य नाम्ना तु सप्तमं तन्महाद्रुमम्  ।\nतेषां तु नामभि स्तानि सप्त वर्षाणि तत्र वै ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003243029, "chapter_id": 23243, "verse_number": "१-४६-३०", "content_sanskrit": "क्रौंचद्वीपेश्वरस्यापि पुत्रा द्युतिमतस्तु वै  ।\nकुशलो मनुगश्चोष्णः पीवरश्चांधकारकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003243030, "chapter_id": 23243, "verse_number": "१-४६-३१", "content_sanskrit": "मुनिश्चदुंदुभिश्चैव सुता द्युतिमतस्तु वै  ।\nतेषां स्वनामभिर्देशाः क्रौंचद्वीपाश्रयाः शुभाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003243031, "chapter_id": 23243, "verse_number": "१-४६-३२", "content_sanskrit": "कुशलदेशः कुशले मनुगस्य मनोनुगः  ।\nउष्णस्योष्णः स्मृतो देशः पीवरः पीवरस्य च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003243032, "chapter_id": 23243, "verse_number": "१-४६-३३", "content_sanskrit": "अंधकारस्य कथितो देशो नाम्नांध कारकः  ।\nमुनेर्देशो मुनिः प्रोक्तो दुंदुभेर्दुंदुभिः स्मृतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003243033, "chapter_id": 23243, "verse_number": "१-४६-३४", "content_sanskrit": "एते जनपदाः सप्त क्रौंचद्वीपेषु भास्वराः  ।\nज्योतिष्मंतः कुशद्वीपे सप्त चासन्महौजसः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003243034, "chapter_id": 23243, "verse_number": "१-४६-३५", "content_sanskrit": "उद्भिदो वेणुमांश्चैव द्वैरथो लवणो धृतिः  ।\nषष्ठः प्रभाकरश्चापि सप्तमः कपिलः स्मृतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003243035, "chapter_id": 23243, "verse_number": "१-४६-३६", "content_sanskrit": "उद्भिदं प्रथमं वर्षं द्वितीयं वेणुमंडलम्  ।\nतृतीयं द्वैरथं चैव चतुर्थं लवणं स्मृतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003243036, "chapter_id": 23243, "verse_number": "१-४६-३७", "content_sanskrit": "पंचमं धृतिमत्षष्ठं प्रभाकरमनुत्तमम्  ।\nसप्तमं कपिलं नाम कपिलस्य प्रकीर्तितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003243037, "chapter_id": 23243, "verse_number": "१-४६-३८", "content_sanskrit": "शाल्मलस्येश्वराः सप्त सुतास्ते वै वपुष्मतः  ।\nश्वेतश्च हरितश्चैव जीमूतो रोहितस्तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003243038, "chapter_id": 23243, "verse_number": "१-४६-३९", "content_sanskrit": "वैद्युतो मानसश्चैव सुप्रभः सप्तमस्तथा  ।\nश्वेतस्य देशः श्वेतस्तु हरितस्य च हारितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003243039, "chapter_id": 23243, "verse_number": "१-४६-४०", "content_sanskrit": "जीमूतस्य च जीमूतो रोहितस्य च रोहितः  ।\nवैद्युतो वैद्युतस्यापि मानसस्य च मानसः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003243040, "chapter_id": 23243, "verse_number": "१-४६-४१", "content_sanskrit": "सुप्रभः सुप्रभस्यापि सप्त वै देशलांछकाः  ।\nप्लक्षद्वीपे तु वक्ष्यामि जंबूद्वीपादनंतरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003243041, "chapter_id": 23243, "verse_number": "१-४६-४२", "content_sanskrit": "सप्त मेधातिथेः पुत्राः प्लक्षद्वीपेश्वरा नृपाः  ।\nज्येष्ठ शांतभयस्तेषां सप्तवर्षाणि तानि वै ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003243042, "chapter_id": 23243, "verse_number": "१-४६-४३", "content_sanskrit": "तस्माच्छांतभयाच्चैव शिशिरस्तु सुखोदयः  ।\nआनंदश्च शिवश्चैव क्षेमकस्च ध्रुवस्तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003243043, "chapter_id": 23243, "verse_number": "१-४६-४४", "content_sanskrit": "तानि तेषां तु नामानि सप्तवर्षाणि भागशः  ।\nनिवेशितानि तैस्तानि पूर्वं स्वायंभुवेन्तरे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003243044, "chapter_id": 23243, "verse_number": "१-४६-४५", "content_sanskrit": "मेधातिथेस्तु पुत्रैस्तैः प्लक्षद्वीपनिवासिभिः  ।\nवर्णाश्रमाचारयुताः प्रजास्तत्रच निवेशिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003243045, "chapter_id": 23243, "verse_number": "१-४६-४६", "content_sanskrit": "प्लक्षद्वीपादिवर्षेषु शाकद्वीपांतिकेषु वै  ।\nज्ञेयः पंचसु धर्मो वै वर्णाश्रमविभागशः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003243046, "chapter_id": 23243, "verse_number": "१-४६-४७", "content_sanskrit": "सुखमायुः स्वरूपं च बलं धर्मो द्विजोत्तमाः  ।\nपंचस्वेतेषु द्वीपेषु सर्वसाधारणं स्मृतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003243047, "chapter_id": 23243, "verse_number": "१-४६-४८", "content_sanskrit": "रुद्रार्चनरता नित्यं महेश्वरपरायणाः  ।\nअन्ये च पुष्करद्वीपे प्रजाताश्च प्रजेश्वराः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003243048, "chapter_id": 23243, "verse_number": "१-४६-४९", "content_sanskrit": "प्रजापतेश्च रुद्रस्य भावामृतसुखोत्कटाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]