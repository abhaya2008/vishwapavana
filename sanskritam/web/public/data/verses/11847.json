[{"id": 50024303, "chapter_id": 11847, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। अग्निः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024304, "chapter_id": 11847, "verse_number": "2", "content_sanskrit": "आ त्वा॑ वहन्तु॒ हर॑यो॒ वृष॑णं॒ सोम॑पीतये। इन्द्र॑ त्वा॒ सूर॑चक्षसः॥ १६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024305, "chapter_id": 11847, "verse_number": "3", "content_sanskrit": "इ॒मा धा॒ना घृ॑त॒स्नुवो॒ हरी॑ इ॒होप॑ वक्षतः। इन्द्रं॑ सु॒खत॑मे॒ रथे॑॥ १६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024306, "chapter_id": 11847, "verse_number": "4", "content_sanskrit": "इन्द्रं॑ प्रा॒तर्ह॑वामह॒ इन्द्रं॑ प्रय॒त्य॑ध्व॒रे। इन्द्रं॒ सोम॑स्य पी॒तये॑॥ १६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024307, "chapter_id": 11847, "verse_number": "5", "content_sanskrit": "उप॑ नः सु॒तमा ग॑हि॒ हरि॑भिरिन्द्र के॒शिभि॑ः। सु॒ते हि त्वा॒ हवा॑महे॥ १६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024308, "chapter_id": 11847, "verse_number": "6", "content_sanskrit": "सेमं न॒ः स्तोम॒मा ग॒ह्युपे॒दं सव॑नं सु॒तम्। गौ॒रो न तृ॑षि॒तः पि॑ब॥ १६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024309, "chapter_id": 11847, "verse_number": "7", "content_sanskrit": "इ॒मे सोमा॑स॒ इन्द॑वः सु॒तासो॒ अधि॑ ब॒र्हिषि॑। ताँ इ॑न्द्र॒ सह॑से पिब॥ १६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024310, "chapter_id": 11847, "verse_number": "8", "content_sanskrit": "अ॒यं ते॒ स्तोमो॑ अग्रि॒यो हृ॑दि॒स्पृग॑स्तु॒ शंत॑मः। अथा॒ सोमं॑ सु॒तं पि॑ब॥ १६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024311, "chapter_id": 11847, "verse_number": "9", "content_sanskrit": "विश्व॒मित्सव॑नं सु॒तमिन्द्रो॒ मदा॑य गच्छति। वृ॒त्र॒हा सोम॑पीतये॥ १६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024312, "chapter_id": 11847, "verse_number": "10", "content_sanskrit": "सेमं न॒ः काम॒मा पृ॑ण॒ गोभि॒रश्वै॑ः शतक्रतो। स्तवा॑म त्वा स्वा॒ध्य॑ः॥ १६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]