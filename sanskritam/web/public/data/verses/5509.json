[{"id": 2211190, "chapter_id": 5509, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2211191, "chapter_id": 5509, "verse_number": "१", "content_sanskrit": "वासुदेवेन दानेषु कथितेषु यथाक्रमम् ।\nअवितृप्तस्तु धर्मेषु राजा केशवमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2211192, "chapter_id": 5509, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2211193, "chapter_id": 5509, "verse_number": "२", "content_sanskrit": "देव धर्मामृतमिदं शृण्वतोऽपि परन्तप ।\nन विद्यते सुरश्रेष्ठ मम तृप्तिर्हि माधव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2211194, "chapter_id": 5509, "verse_number": "३", "content_sanskrit": "अनडुत्(ह्)सम्प्रदानस्य यत्फलं तु विधीयते ।\nतत्फलं कथयस्वेह तव भक्तस्य मेऽच्युत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2211195, "chapter_id": 5509, "verse_number": "४", "content_sanskrit": "यानि चान्यानि दानानि त्वया नोक्तानि कानिचित् ।\nतान्याचक्ष्व सुरश्रेष्ठ तेषां चानुक्रमात् फलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2211196, "chapter_id": 5509, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2211197, "chapter_id": 5509, "verse_number": "५", "content_sanskrit": "शृणु धर्मामृतं श्रेष्ठं दत्तस्यानडुहः फलम् ।\nपवित्रत्वात् सुपुण्यत्वात् पावनत्वात् तथैव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2211198, "chapter_id": 5509, "verse_number": "६", "content_sanskrit": "दशधेनुसमोऽनड्वान् एकोऽपि कुरुपुङ्गव ।\nमेदोमांसविपुष्टाङ्गो नीरोगः कोपवर्जितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2211199, "chapter_id": 5509, "verse_number": "७", "content_sanskrit": "युवा भद्रः सुशीलश्च सर्वदोषविवर्जितः ।\nधुरं धारयतेऽनड्वान् दत्तो विप्राय पाण्डव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2211200, "chapter_id": 5509, "verse_number": "८", "content_sanskrit": "स तेन पुण्यदानेन वर्षकोटिं युधिष्ठिर ।\nयथाकामं महातेजा गवां लोके महीयते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2211201, "chapter_id": 5509, "verse_number": "९", "content_sanskrit": "यश्च दद्यादनड्वाहौ द्वौ युक्तौ तु धुरन्धरौ ।\nसुव्रताय दरिद्राय श्रोत्रियाय विशेषतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2211202, "chapter_id": 5509, "verse_number": "१०", "content_sanskrit": "तस्य यत् पुण्यमाख्यातं तच्छृणुष्व युधिष्ठिर ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2211203, "chapter_id": 5509, "verse_number": "११", "content_sanskrit": "सहस्रगोप्रदानेन यत्प्रोक्तं फलमुत्तमम् ।\nतत्पुण्यफलमाप्नोति याति लोकान् सनातनान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2211204, "chapter_id": 5509, "verse_number": "१२", "content_sanskrit": "यावन्ति चैव रोमाणि तयोश्चानडुहोर्नृप ।\nतावद् वर्षसहस्राणि मम लोके महीयते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2211205, "chapter_id": 5509, "verse_number": "१३", "content_sanskrit": "दरिद्रायैव दातव्यं न समृद्धाय पाण्डव ।\nवर्षाणां हि तटाकेषु फलं नैव पयोधिषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2211206, "chapter_id": 5509, "verse_number": "१४", "content_sanskrit": "यस्तु दद्यादनडुहं दरिद्राय द्विजातये ।\nस तेन पुण्यदानेन पूतात्मा कुरुपुङ्गव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2211207, "chapter_id": 5509, "verse_number": "१५", "content_sanskrit": "विमानं दिव्यमारूढो दिव्यरूपी यथासुखम् ।\nमम लोकेषु रमते यावदाभूतसम्प्लवम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2211208, "chapter_id": 5509, "verse_number": "१६", "content_sanskrit": "गृहं दीपप्रभायुक्तं शय्यासनविभूषितम् ।\nभाजनोपस्करैर्युक्तं धान्यपूर्णमलङ्कृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2211209, "chapter_id": 5509, "verse_number": "१७", "content_sanskrit": "दासीगोभूमिसंयुक्तमन्यूनं सर्वसाधनैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2211210, "chapter_id": 5509, "verse_number": "१८", "content_sanskrit": "ब्राह्मणाय दरिद्राय श्रोत्रियाय युधिष्ठिर ।\nदद्यात् सदक्षिणं यस्तु तस्य पुण्यफलं शृणु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2211211, "chapter_id": 5509, "verse_number": "१९", "content_sanskrit": "देवाः पितृगणाश्चैव ह्यग्नयो ऋषयस्तथा ।\nप्रयच्छन्ति प्रहृष्टा वै यानमादित्यसन्निभम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2211212, "chapter_id": 5509, "verse_number": "२०", "content_sanskrit": "तेन गच्छेच्छ्रिया युक्तो ब्रह्मलोकमनुत्तमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2211213, "chapter_id": 5509, "verse_number": "२१", "content_sanskrit": "स्त्रीसहस्रावृते दिव्ये भवने तत्र काञ्चने ।\nमोदते ब्रह्मलोकस्थो यावदाभूतसम्प्लवम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2211214, "chapter_id": 5509, "verse_number": "२२", "content_sanskrit": "शय्यां प्रस्तरणोपेतां यः प्रयच्छति पाण्डव ।\nअर्चयित्वा द्विजं भक्त्या वस्त्रमाल्यानुलेपनैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2211215, "chapter_id": 5509, "verse_number": "२३", "content_sanskrit": "भोजयित्वा विचित्रान्नं तस्य पुण्यफलं शृणु ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2211216, "chapter_id": 5509, "verse_number": "२४", "content_sanskrit": "धेनुदानस्य यत्पुण्यं विधिदत्तस्य पाण्डव ।\nतत्पुण्यं समनुप्राप्य पितृलोके महीयते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2211217, "chapter_id": 5509, "verse_number": "२५", "content_sanskrit": "शिल्पमध्ययनं वाऽपि विद्यामन्त्रौषधानि च ।\nयः प्रयच्छति विप्राय तस्य पुण्यफलं शृणु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2211218, "chapter_id": 5509, "verse_number": "२६", "content_sanskrit": "आहिताग्निसहस्रस्य तर्पितस्येह यत्फलम् ।\nतत्पुण्यफलमाप्नोति यस्तु विद्यां प्रयच्छति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2211219, "chapter_id": 5509, "verse_number": "२७", "content_sanskrit": "छन्दोभिः सम्प्रयुक्तेन विमानेन विराजता ।\nसप्तर्षिलोकान् व्रजति पूज्यते ब्रह्मवादिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2211220, "chapter_id": 5509, "verse_number": "२८", "content_sanskrit": "चतुर्युगानि वै त्रिंशत् क्रीडित्वा तत्र देववत् ।\nइह मानुष्यके लोके विप्रो भवति वेदवित् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2211221, "chapter_id": 5509, "verse_number": "२९", "content_sanskrit": "विश्रामयति यो विप्रं श्रान्तमध्वनि कर्शितम् ।\nविनश्यति तदा पापं तस्य वर्षकृतं नृप ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2211222, "chapter_id": 5509, "verse_number": "३०", "content_sanskrit": "अथ प्रक्षालयेत् पादौ तस्य तोयेन भक्तिमान् ।\nदशवर्षकृतं पापं व्यपोहति न संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2211223, "chapter_id": 5509, "verse_number": "३१", "content_sanskrit": "घृतेन वाऽथ तैलेन पादौ तस्य तु पूजयेत् ।\nस द्वादशसमारूढं पापमाशु व्यपोहति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2211224, "chapter_id": 5509, "verse_number": "३२", "content_sanskrit": "धेनुदानस्य दत्तस्य यच्च पुण्यमुदाहृतम् ।\nतत्पुण्यफलमाप्नोति यस्त्वेनं विप्रमर्चयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2211225, "chapter_id": 5509, "verse_number": "३३", "content_sanskrit": "स्वागतेन तु यो विप्रं पूजयेदासनेन च ।\nप्रत्युत्थानेन वा राजन् स देवानां प्रियो भवेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2211226, "chapter_id": 5509, "verse_number": "३४", "content_sanskrit": "स्वागतेनाग्नयो राजन्नासनेन शतक्रतुः ।\nप्रत्युत्थानेन पितरः प्रीतिं यान्त्यतिथिप्रियाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2211227, "chapter_id": 5509, "verse_number": "३५", "content_sanskrit": "अग्निशक्रपितॄणां च तेषां प्रीत्या नराधिप ।\nसंवत्सरकृतं पापं तस्य सद्यो विनश्यति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2211228, "chapter_id": 5509, "verse_number": "३६", "content_sanskrit": "यः प्रयच्छति विप्राय आसनं माल्यभूषितम् ।\nस याति मणियुक्तेन रथेन हरिकेतनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2211229, "chapter_id": 5509, "verse_number": "३७", "content_sanskrit": "पुरन्दरासने तत्र दिव्यनारीविभूषितः ।\nषष्टिं वर्षसहस्राणि क्रीडत्यप्सरसां गणैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2211230, "chapter_id": 5509, "verse_number": "३८", "content_sanskrit": "इह लोके तु धनवान् चतुर्वेदी द्विजो भवेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2211231, "chapter_id": 5509, "verse_number": "३९", "content_sanskrit": "वाहनं यः प्रयच्छेत ब्राह्मणाय युधिष्ठिर ।\nस याति रत्नचित्रेण वाहनेन सुरालयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2211232, "chapter_id": 5509, "verse_number": "४०", "content_sanskrit": "स तत्र कामं क्रीडित्वा सेव्यमानोऽप्सरोगणैः ।\nइह राजा भवेद् राजन् नात्र कार्या विचारणा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2211233, "chapter_id": 5509, "verse_number": "४१", "content_sanskrit": "पादपं पल्लवाकीर्णं पुष्पितं सफलं तथा ।\nगन्धमाल्यार्चितं कृत्वा वस्त्रभूषणभूषितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2211234, "chapter_id": 5509, "verse_number": "४२", "content_sanskrit": "यः प्रयच्छति विप्राय श्रोत्रियाय सदक्षिणम् ।\nभोजयित्वा यथाकामं तस्य पुण्यफलं शृणु ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2211235, "chapter_id": 5509, "verse_number": "४३", "content_sanskrit": "जाम्बूनदविचित्रेण विमानेन विराजता ।\nपुरन्दरपुरं याति जयशब्दरवैर्युतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2211236, "chapter_id": 5509, "verse_number": "४४", "content_sanskrit": "तत्र शक्रपुरे रम्ये तस्य कल्पकपादपः ।\nददाति चेप्सितं सर्वं मनसा यद्यदिच्छति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2211237, "chapter_id": 5509, "verse_number": "४५", "content_sanskrit": "यावन्ति तस्य पत्राणि पुष्पाणि च फलानि च ।\nतावद् वर्षसहस्राणि शक्रलोके महीयते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2211238, "chapter_id": 5509, "verse_number": "४६", "content_sanskrit": "शक्रलोकावतीर्णश्च मानुष्यं लोकमागतः ।\nरथाश्वगजसम्पूर्णं पुरं राज्यं च रक्षति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2211239, "chapter_id": 5509, "verse_number": "४७", "content_sanskrit": "स्थापयित्वा तु मद्भक्त्या यो मत्प्रतिकृतिं नरः ।\nआलयं विधिवत् कृत्वा पूजाकर्माणि कारयेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2211240, "chapter_id": 5509, "verse_number": "४८", "content_sanskrit": "स्वयं वा पूजयेद् भक्त्या तस्य पुण्यफलं शृणु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2211241, "chapter_id": 5509, "verse_number": "४९", "content_sanskrit": "अश्वमेधसहस्रस्य यत्फलं समुदाहृतम् ।\nतत्फलं समनुप्राप्तो मत्सालोक्यं प्रपद्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2211242, "chapter_id": 5509, "verse_number": "५०", "content_sanskrit": "न जाने निर्गमं तस्य मम लोकाद् युधिष्ठिर ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2211243, "chapter_id": 5509, "verse_number": "५१", "content_sanskrit": "देवालये विप्रगृहे गोवाटे चत्वरेऽपि वा ।\nप्रज्वालयति यो दीपं तस्य पुण्यफलं शृणु ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2211244, "chapter_id": 5509, "verse_number": "५२", "content_sanskrit": "आरुह्य काञ्चनं यानं द्योतयन् सर्वतो दिशम् ।\nगच्छेदादित्यलोकं स सेव्यमानः सुरोत्तमैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2211245, "chapter_id": 5509, "verse_number": "५३", "content_sanskrit": "तत्र प्रकामं क्रीडित्वा वर्षकोटिं महायशाः ।\nइह लोके भवेद् विप्रो वेदवेदाङ्गपारगः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2211246, "chapter_id": 5509, "verse_number": "५४", "content_sanskrit": "देवालयेषु वा राजन् ब्राह्मणावसथेषु वा ।\nचत्वरे वा चतुष्के वा रात्रौ वा यदि वा दिवा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2211247, "chapter_id": 5509, "verse_number": "५५", "content_sanskrit": "नानागन्धर्ववाद्यानि धर्मश्रावणिकानि च ।\nयस्तु कारयते भक्त्या मद्गतेनान्तरात्मना ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2211248, "chapter_id": 5509, "verse_number": "५६", "content_sanskrit": "तस्य देवा नरश्रेष्ठ पितरश्चापि हर्षिताः ।\nसुप्रीताः सम्प्रयच्छन्ति विमानं कामगं शुभम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2211249, "chapter_id": 5509, "verse_number": "५७", "content_sanskrit": "स च तेन विमानेन याति देवपुरं नरः ।\nतत्र दिव्याप्सरोभिस्तु सेव्यमानः प्रमोदते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2211250, "chapter_id": 5509, "verse_number": "५८", "content_sanskrit": "देवलोकावतीर्णस्तु स लोकेऽस्मिन् नराधिप ।\nवेदवेदाङ्गतत्वज्ञो भोगवान् ब्राह्मणो भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2211251, "chapter_id": 5509, "verse_number": "५९", "content_sanskrit": "चत्वरे वा सभायां वा विस्तीर्णे वा सभाङ्गणे ।\nकृत्वाऽग्निकुण्डं विपुलं स्थण्डिलं वा युधिष्ठिर ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2211252, "chapter_id": 5509, "verse_number": "६०", "content_sanskrit": "तत्राग्निं चतुरो मासान् ज्वालयेद् यस्तु भक्तिमान् ।\nसमाप्तेषु तु मासेषु पौष्यादिषु ततो द्विजान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2211253, "chapter_id": 5509, "verse_number": "६१", "content_sanskrit": "भोजयेत् पायसं मृष्टं मद्गतेनान्तरात्मना ।\nदक्षिणां च यथाशक्ति ब्राह्मणेभ्यो निवेदयेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2211254, "chapter_id": 5509, "verse_number": "६२", "content_sanskrit": "एवमग्निं तु यः कुर्यान्नित्यमेवार्चयंस्तु माम् ।\nतस्य पुण्यफलं यद्वै तन्निबोध युधिष्ठिर ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2211255, "chapter_id": 5509, "verse_number": "६३", "content_sanskrit": "तेनाहं शङ्करश्चैव पितरो ह्यग्नयस्तथा ।\nयास्यामः परमां प्रीतिं नात्र कार्या विचारणा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2211256, "chapter_id": 5509, "verse_number": "६४", "content_sanskrit": "षष्टिं वर्षसहस्राणि षष्टिं वर्षशतानि च ।\nसोऽस्मत्प्रीतिकरः श्रीमान् यमलोके महीयते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2211257, "chapter_id": 5509, "verse_number": "६५", "content_sanskrit": "यमलोकावतीर्णश्च सोऽस्मिन् लोके महायशाः ।\nवेदवेदाङ्गविद् विप्रो जायते राजपूजितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2211258, "chapter_id": 5509, "verse_number": "६६", "content_sanskrit": "यः करोति नरश्रेष्ठ भरणं ब्राह्मणस्य तु ।\nश्रोत्रियस्याभिजातस्य दरिद्रस्य विशेषतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2211259, "chapter_id": 5509, "verse_number": "६७", "content_sanskrit": "तस्य पुण्यफलं यद्वै तन्निबोध युधिष्ठिर ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2211260, "chapter_id": 5509, "verse_number": "६८", "content_sanskrit": "गवां कोटिप्रदानेन यत्पुण्यं समुदाहृतम् ।\nतत्पुण्यफलमाप्नोति वर्षेणैकेन पाण्डव ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2211261, "chapter_id": 5509, "verse_number": "६९", "content_sanskrit": "काञ्चनेन विचित्रेण यानेनाम्बरशालिना ।\nस याति यामकं लोकं दिव्यस्त्रीगणसेवितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2211262, "chapter_id": 5509, "verse_number": "७०", "content_sanskrit": "गीयमानो वरस्त्रीभिर्वर्षाणां कोटिविंशतिम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2211263, "chapter_id": 5509, "verse_number": "७१", "content_sanskrit": "क्रीडित्वा मामके लोके तत्र देवैरभिष्टुतः ।\nमानुष्यमवतीर्णस्तु वेदविद् ब्राह्मणो भवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2211264, "chapter_id": 5509, "verse_number": "७२", "content_sanskrit": "करकं कुण्डिकां वाऽपि महद्वा जलभाजनम् ।\nयः प्रयच्छति विप्राय तस्य पुण्यफलं शृणु ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2211265, "chapter_id": 5509, "verse_number": "७३", "content_sanskrit": "ब्रह्मकूर्चेन यत्पीते फलं प्रोक्तं युधिष्ठिर ।\nतत्पुण्यफलमाप्नोति जलभाजनदानतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2211266, "chapter_id": 5509, "verse_number": "७४", "content_sanskrit": "सुतृप्तः सुप्रभः सौम्यः प्रहृष्टेन्द्रियमानसः ।\nहंससारसयुक्तेन विमानेन विराजता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2211267, "chapter_id": 5509, "verse_number": "७५", "content_sanskrit": "स याति वारुणं लोकं दिव्यगन्धर्वसेवितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2211268, "chapter_id": 5509, "verse_number": "७६", "content_sanskrit": "पानीयं यः प्रयच्छेद् वै जीवानां जीवनं परम् ।\nग्रीष्मकेषु तु मासेषु तस्य पुण्यफलं शृणु ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2211269, "chapter_id": 5509, "verse_number": "७७", "content_sanskrit": "कपिलाकोटिदानस्य यत् पुण्यं तु विधीयते ।\nतत्पुण्यफलमाप्नोति पानीयं यः प्रयच्छति ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2211270, "chapter_id": 5509, "verse_number": "७८", "content_sanskrit": "पूर्णचन्द्रप्रकाशेन विमानेन विराजता ।\nस गच्छेच्चन्द्रसदनं सेव्यमानोऽप्सरोगणैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2211271, "chapter_id": 5509, "verse_number": "७९", "content_sanskrit": "त्रिंशत्कोटियुगं तत्र दिव्यगन्धर्वसेवितः ।\nक्रीडित्वा मानुषे लोके चतुर्वेदी द्विजो भवेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2211272, "chapter_id": 5509, "verse_number": "८०", "content_sanskrit": "शिरोभ्यङ्गप्रदानेन तेजस्वी प्रियदर्शनः ।\nसुभगो रूपवान् शूरः पण्डितश्च द्विजो भवेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2211273, "chapter_id": 5509, "verse_number": "८१", "content_sanskrit": "वस्त्रदायी तु तेजस्वी सर्वत्र प्रियदर्शनः ।\nसुभगो भवति श्रीमान् स्त्रीणां नित्यं मनोरमः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2211274, "chapter_id": 5509, "verse_number": "८२", "content_sanskrit": "उपानहौ च च्छत्रं च यो ददाति नरोत्तमः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2211275, "chapter_id": 5509, "verse_number": "८३", "content_sanskrit": "स याति रथमुख्येन काञ्चनेन विराजता ।\nशक्रलोकं महातेजाः सेव्यमानोऽप्सरोगणैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2211276, "chapter_id": 5509, "verse_number": "८४", "content_sanskrit": "काष्ठपादुकदा यान्ति विमानैर्वृक्षनिर्मितैः ।\nधर्मराजपुरं रम्यं सेव्यमानाः सुरोत्तमैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2211277, "chapter_id": 5509, "verse_number": "८५", "content_sanskrit": "दन्तकाष्ठप्रदानेन प्रियवाक्यो भवेन्नरः ।\nसुगन्धवदनः श्रीमान् मेधासौभाग्यसंयुतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2211278, "chapter_id": 5509, "verse_number": "८६", "content_sanskrit": "क्षीरं दधि घृतं वाऽपि गुडं मधुरसं तथा ।\nये प्रयच्छन्ति विप्रेभ्यः परां भक्तिं गता नराः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2211279, "chapter_id": 5509, "verse_number": "८७", "content_sanskrit": "ते वृषैरश्वयानैश्च श्वेतस्रग्दामभूषिताः ।\nउपगीयमाना गन्धर्वैर्यान्तीश्वरपुरं नराः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2211280, "chapter_id": 5509, "verse_number": "८८", "content_sanskrit": "तत्र दिव्याप्सरोभिस्तु सेव्यमाना यथासुखम् ।\nषष्टिवर्षसहस्राणि मोदन्ते देवसन्निभाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2211281, "chapter_id": 5509, "verse_number": "८९", "content_sanskrit": "ततः कालावतीर्णाश्च जायन्ते त्विह मानवाः ।\nप्रभूतधनधान्याश्च भोगवन्तो नरोत्तमाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2211282, "chapter_id": 5509, "verse_number": "९०", "content_sanskrit": "वैशाखे मासि वैशाखे दिवसे पाण्डुनन्दन ।\nवैवस्वतं समुद्दिश्य परां भक्तिमुपागताः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2211283, "chapter_id": 5509, "verse_number": "९१", "content_sanskrit": "अभ्यर्च्य विधिवद् विप्रान् तिलान् गुडसमायुतान् ।\nये प्रयच्छन्ति विप्रेभ्यस्तेषां पुण्यफलं शृणु ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2211284, "chapter_id": 5509, "verse_number": "९२", "content_sanskrit": "गोप्रदानेन यत्पुण्यं विधिवत् पाण्डुनन्दन ।\nतत्पुण्यं समनुप्राप्तो यमलोके महीयते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2211285, "chapter_id": 5509, "verse_number": "९३", "content_sanskrit": "ततश्चापि च्युतः कालादिह राजा भविष्यति ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2211286, "chapter_id": 5509, "verse_number": "९४", "content_sanskrit": "तस्मिन्नेव दिने विप्रान् भोजयित्वा सदक्षिणम् ।\nतोयपूर्णानि दिव्यानि भाजनानि दिशन्ति ये ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2211287, "chapter_id": 5509, "verse_number": "९५", "content_sanskrit": "ते यान्त्यादित्यवणाभैर्विमानैर्वरुणालयम् ।\nतत्र दिव्याङ्गनाभिस्तु रमन्ते कामगामिनः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2211288, "chapter_id": 5509, "verse_number": "९६", "content_sanskrit": "ततोऽवतीर्णाः कालेन ते चास्मिन् मानुषे पुनः ।\nभोगवन्तो द्विजश्रेष्ठा भविष्यन्ति न संशयः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2211289, "chapter_id": 5509, "verse_number": "९७", "content_sanskrit": "अनन्तराशी यश्चापि वर्तते व्रतवत् सदा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2211290, "chapter_id": 5509, "verse_number": "९८", "content_sanskrit": "सत्यवाक् क्रोधरहितः शुचिः स्नानरतः सदा ।\nस विमानेन दिव्येन याति शक्रपुरं नरः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2211291, "chapter_id": 5509, "verse_number": "९९", "content_sanskrit": "तत्र दिव्याप्सरोभिस्तु वर्षकोटिं महातपाः ।\nक्रीडित्वा मानुषे लोके जायते वेदविद् द्विजः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2211292, "chapter_id": 5509, "verse_number": "१००", "content_sanskrit": "एकभुक्तेन यश्चापि वर्षमेकं तु वर्तते ।\nब्रह्मचारी जितक्रोधः सत्यशौचसमन्वितः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2211293, "chapter_id": 5509, "verse_number": "१०१", "content_sanskrit": "स विमानेन दिव्येन याति शक्रपुरं सुखम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2211294, "chapter_id": 5509, "verse_number": "१०२", "content_sanskrit": "दशकोटिसमास्तत्र क्रीडित्वाऽप्सरसां गणैः ।\nइह मानुषके लोके ब्राह्मणो वेदविद् भवेत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2211295, "chapter_id": 5509, "verse_number": "१०३", "content_sanskrit": "चतुर्थकाले यो भुङ्क्ते ब्रह्मचारी जितेन्द्रियः ।\nवर्तते वर्षमेकं तु तस्य पुण्यफलं शृणु ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2211296, "chapter_id": 5509, "verse_number": "१०४", "content_sanskrit": "चित्रबर्हिणयुक्तेन विचित्रध्वजशोभिना ।\nयाति यानेन दिव्येन स महेन्द्रपुरं नरः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2211297, "chapter_id": 5509, "verse_number": "१०५", "content_sanskrit": "अकृशाभिर्वरस्त्रीभिः सेव्यमानो यथासुखम् ।\nतत्र द्वादशकोटिं स समाः सम्यक् प्रमोदते ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2211298, "chapter_id": 5509, "verse_number": "१०६", "content_sanskrit": "शक्रलोकावतीर्णस्तु लोके चास्मिन् नराधिप ।\nभवेद् वै ब्राह्मणो विद्वान् क्षमावान् वेदपारगः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2211299, "chapter_id": 5509, "verse_number": "१०७", "content_sanskrit": "षष्ठकालं तु योऽश्नाति वर्षमेकमकल्मषः ।\nब्रह्मचर्यव्रतैर्युक्तः शुचिः क्रोधविवर्जितः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2211300, "chapter_id": 5509, "verse_number": "१०८", "content_sanskrit": "तपोयुक्तस्य तस्यापि शृणुष्व फलमुत्तमम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2211301, "chapter_id": 5509, "verse_number": "१०९", "content_sanskrit": "अत्यादित्यप्रकाशेन विमानेनार्कसन्निभः ।\nस याति मम लोकान् वै दिव्यनारीनिषेवितः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2211302, "chapter_id": 5509, "verse_number": "११०", "content_sanskrit": "तत्र साध्यैर्मरुद्भिश्च पूज्यमानो यथासुखम् ।\nपश्यन्नेव सदा मां तु कीडत्यप्सरसां गणैः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2211303, "chapter_id": 5509, "verse_number": "१११", "content_sanskrit": "पक्षोपवासं यश्चापि कुरुते मद्गतात्मना ।\nसमाप्ते तु व्रते तस्मिन् तर्पयेत् श्रोत्रियान् शुचीन् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2211304, "chapter_id": 5509, "verse_number": "११२", "content_sanskrit": "सोऽपि गच्छति दिव्येन विमानेन महातपाः ।\nद्योतयन् प्रभया व्योम मम लोकं प्रपद्यते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2211305, "chapter_id": 5509, "verse_number": "११३", "content_sanskrit": "स तत्र मोदते कामं कामरूपी यथासुखम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2211306, "chapter_id": 5509, "verse_number": "११४", "content_sanskrit": "त्रिंशत्कोटिसमा राजन् क्रीडित्वा तत्र देववत् ।\nइह मानुष्यके लोके पूजनीयो द्विजोत्तमः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2211307, "chapter_id": 5509, "verse_number": "११५", "content_sanskrit": "त्रयाणामपि वेदानां साङ्गानां पारगो भवेत् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2211308, "chapter_id": 5509, "verse_number": "११६", "content_sanskrit": "यश्च मासोपवासं वै कुरुते मद्गतात्मना ।\nजितेन्द्रियो जितक्रोधो जितधीः स्नानतत्परः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2211309, "chapter_id": 5509, "verse_number": "११७", "content_sanskrit": "समाप्ते नियमे तत्र भोजयित्वा द्विजोत्तमान् ।\nदक्षिणां च ततो दद्यात् प्रहृष्टेनान्तरात्मना ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2211310, "chapter_id": 5509, "verse_number": "११८", "content_sanskrit": "स गच्छति महातेजा ब्रह्मलोकमनुत्तमम् ।\nसिंहयुक्तेन यानेन दिव्यस्त्रीगणसेवितः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2211311, "chapter_id": 5509, "verse_number": "११९", "content_sanskrit": "स तत्र ब्रह्मणो लोके देवर्षिगणसेवितः ।\nशतकोटिसमा राजन् यथाकामं प्रमोदते ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2211312, "chapter_id": 5509, "verse_number": "१२०", "content_sanskrit": "ततः कालावतीर्णश्च सोऽस्मिन् लोके द्विजो भवेत् ।\nषडङ्गविच्चतुर्वेदी त्रिंशज्जन्मान्यरोगवान् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2211313, "chapter_id": 5509, "verse_number": "१२१", "content_sanskrit": "यस्त्यक्त्वा सर्वकर्माणि शुचिः क्रोधविवर्जितः ।\nमहाप्रस्थानमेकाग्रो याति मद्गतमानसः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2211314, "chapter_id": 5509, "verse_number": "१२२", "content_sanskrit": "स गच्छेदिन्द्रसदनं विमानेन महातपाः ।\nमहामणिविचित्रेण सौवर्णेन विराजता ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2211315, "chapter_id": 5509, "verse_number": "१२३", "content_sanskrit": "शतकोटिसमास्तत्र सुराधिपतिपूजितः ।\nनाकपृष्ठे निवसति दिव्यस्त्रीगणसेवितः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2211316, "chapter_id": 5509, "verse_number": "१२४", "content_sanskrit": "शक्रलोकावतीर्णश्च मानुषेषूपजायते ।\nराज्ञां राजा महातेजाः सर्वलोकार्चितः प्रभुः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2211317, "chapter_id": 5509, "verse_number": "१२५", "content_sanskrit": "प्रायोपवेशं यः कुर्यान्मद्गतेनान्तरात्मना ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2211318, "chapter_id": 5509, "verse_number": "१२६", "content_sanskrit": "नमो ब्रह्मण्यदेवायेत्युक्त्वा मन्त्रं समाहितः ।\nअन्तःस्वस्थो जितक्रोधस्तस्य पुण्यफलं शृणु ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2211319, "chapter_id": 5509, "verse_number": "१२७", "content_sanskrit": "कामगः कामरूपी च बालसूर्यसमप्रभः ।\nस विमानेन दिव्येन याति लोकाननामयान् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2211320, "chapter_id": 5509, "verse_number": "१२८", "content_sanskrit": "स्वर्गात् स्वर्गं महातेजा गत्वा गत्वा यथासुखम् ।\nमम लोकेषु रमते यावदाभूतसम्प्लवम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2211321, "chapter_id": 5509, "verse_number": "१२९", "content_sanskrit": "अग्निप्रवेशं यश्चापि कुरुते मद्गतात्मना ।\nसोऽपि यानेन दिव्येन मम लोकं प्रपद्यते ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2211322, "chapter_id": 5509, "verse_number": "१३०", "content_sanskrit": "तत्र सर्वगुणोपेतः पश्यन्नेव स मां सदा ।\nत्रिंशत्कोटिसमा राजन् मोदते मम सन्निधौ ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2211323, "chapter_id": 5509, "verse_number": "१३१", "content_sanskrit": "ततोऽवतीर्णः कालेन वेदविद् ब्राह्मणो भवेत् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2211324, "chapter_id": 5509, "verse_number": "१३२", "content_sanskrit": "कारीषं साधयन् यस्तु मां प्रपन्नः शुचिव्रतः ।\nनमो ब्रह्मण्यदेवायेत्येतन्मत्रमुदाहरन् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2211325, "chapter_id": 5509, "verse_number": "१३३", "content_sanskrit": "बालसूर्यप्रकाशेन विमानेन विराजता ।\nयमलोकं समासाद्य वर्षकोटिं प्रमोदते ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2211326, "chapter_id": 5509, "verse_number": "१३४", "content_sanskrit": "यमलोकावतीर्णश्च लोकेऽस्मिन् क्षत्रियो भवेत् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2211327, "chapter_id": 5509, "verse_number": "१३५", "content_sanskrit": "निवेशयति मन्मूर्त्यामात्मानं मद्गतः शुचिः ।\nरुद्रदक्षिणमूर्त्यां वा चतुर्दश्यां विशेषतः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2211328, "chapter_id": 5509, "verse_number": "१३६", "content_sanskrit": "सिद्धैर्ब्रह्मर्षिभिश्चैव देवलोकैश्च पूजितः ।\nगन्धर्वैर्भूतसङ्घैश्च गीयमानो महातपाः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2211329, "chapter_id": 5509, "verse_number": "१३७", "content_sanskrit": "प्रविशेत् स महातेजा मां वा शङ्करमेव च ।\nन स्यात् पुनर्भवो राजन् नात्र कार्या विचारणा ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2211330, "chapter_id": 5509, "verse_number": "१३८", "content_sanskrit": "गोकृते स्त्रीकृते चैव गुरुविप्रकृतेऽपि वा ।\nहन्यन्ते ये तु राजेन्द्र शक्रलोकं व्रजन्ति ते ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2211331, "chapter_id": 5509, "verse_number": "१३९", "content_sanskrit": "तत्र जाम्बूनदमये विमाने कामगामिनि ।\nमन्वन्तरं प्रमोदन्ते दिव्यनारीनिषेविताः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2211332, "chapter_id": 5509, "verse_number": "१४०", "content_sanskrit": "आश्रुतस्याप्रदानेन दत्तस्य हरणेन च ।\nजन्मप्रभृति यद्दत्तं सर्वं नश्यति भारत ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2211333, "chapter_id": 5509, "verse_number": "१४१", "content_sanskrit": "नागोप्रदास्तत्र पयः पिबन्ति\nनाभूमिदा भूमिमथाश्नुवन्ति ।\nयान् यान् कामान् ब्राह्मणेभ्यो ददाति\nतांस्तान् कामान् स्वर्गलोके स भुङ्क्ते ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2211334, "chapter_id": 5509, "verse_number": "१४२", "content_sanskrit": "यद्यदिष्टतमं द्रव्यं न्यायेनोपार्जितं च यत् ।\nतत्तद् गुणवते देयं तदेवाक्षयमिच्छता ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2211335, "chapter_id": 5509, "verse_number": "१४३", "content_sanskrit": "अनुपोष्य त्रिरात्राणि तीर्थान्यनभिगम्य च ।\nअदत्त्वा काञ्चनं गां च दरिद्रो नाम जायते ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2211336, "chapter_id": 5509, "verse_number": "१४४", "content_sanskrit": "दानं यत् तत्फलं नैति श्रोत्रियाय न दीयते ।\nश्रोत्रिया यत्र नाश्नन्ति न देवास्तत्र भुञ्जते ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2211337, "chapter_id": 5509, "verse_number": "१४५", "content_sanskrit": "श्रोत्रियेभ्यः परं नास्ति परमं दैवतं महत् ।\nनिधानं चापि राजेन्द्र नास्माच्छ्रोत्रियभोजनात् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2211338, "chapter_id": 5509, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे दानकथनं नाम त्र्यधिकशततमोऽध्यायः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}]