[{"id": 7004484000, "chapter_id": 24484, "verse_number": "५-३-१७८-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र गङ्गावाहकमुत्तमम् ।\nनर्मदायां महापुण्यं भृगुतीर्थसमीपतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004484001, "chapter_id": 24484, "verse_number": "५-३-१७८-२", "content_sanskrit": "तत्र गङ्गा महापुण्या चचार विपुलं तपः ।\nपुरा वर्षशतं साग्रं परमं व्रतमास्थिता॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004484002, "chapter_id": 24484, "verse_number": "५-३-१७८-३", "content_sanskrit": "ध्यात्वा देवं जगद्योनिं नारायणमकल्मषम् ।\nआत्मानं परमं धाम सरित्सा जगतीपते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004484003, "chapter_id": 24484, "verse_number": "५-३-१७८-४", "content_sanskrit": "ततो जनार्दनो देव आगत्येदमुवाच ह॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004484004, "chapter_id": 24484, "verse_number": "५-३-१७८-५", "content_sanskrit": "विष्णुरुवाच ।\nतपसा तव तुष्टोऽहं मत्पादाम्बुजसम्भवे ।\nमत्तः किमिच्छसे देवि ब्रूहि किं करवाणि ते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004484005, "chapter_id": 24484, "verse_number": "५-३-१७८-६", "content_sanskrit": "गङ्गोवाच ।\nत्वत्पादकमलाद्भ्रष्टा गङ्गा सहचरा विभो ।\nयदृच्छया त्रिलोकेश वन्द्यमाना दिवौकसैः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004484006, "chapter_id": 24484, "verse_number": "५-३-१७८-७", "content_sanskrit": "नृपो भगीरथस्तस्मात्तपः कृत्वा सुदुष्करम् ।\nसमाराध्य जगन्नाथं शङ्करं लोकशङ्करम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004484007, "chapter_id": 24484, "verse_number": "५-३-१७८-८", "content_sanskrit": "अवतारयामास हि मां पृथिव्यां धरणीधर ।\nमया वै युवयोर्वाक्यादवतारः कृतो भुवि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004484008, "chapter_id": 24484, "verse_number": "५-३-१७८-९", "content_sanskrit": "वैष्णवीमिति मां मत्वा जनः सर्वाप्लुतो मयि ।\nये वै ब्रह्मणो लोके ये च वै गुरुतल्पगाः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004484009, "chapter_id": 24484, "verse_number": "५-३-१७८-१०", "content_sanskrit": "त्यागिनः पितृमातृभ्यां ये च स्वर्णहरा नराः ।\nगोघ्ना ये मनुजा लोके तथा ये प्राणिहिंसकाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004484010, "chapter_id": 24484, "verse_number": "५-३-१७८-११", "content_sanskrit": "अगम्यागामिनो ये च ह्यभक्ष्यस्य च भक्षकाः ।\nये चानृतप्रवक्तारो ये च विश्वासघातकाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004484011, "chapter_id": 24484, "verse_number": "५-३-१७८-१२", "content_sanskrit": "देवब्राह्मणवित्तानां हर्तारो ये नराधमाः ।\nदेवब्रह्मगुरुस्त्रीणां ये च निन्दाकरा नराः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004484012, "chapter_id": 24484, "verse_number": "५-३-१७८-१३", "content_sanskrit": "ब्रह्मशापप्रदग्धा ये ये चैवात्महनो द्विजाः ।\nभ्रष्टानशनसंन्यासनियतव्रतचारिणः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004484013, "chapter_id": 24484, "verse_number": "५-३-१७८-१४", "content_sanskrit": "तथैवापेयपेयाश्च ये च स्वगुरुनिन्दकाः ।\nनिषेधका ये दानानां पात्रदानपराङ्मुखाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004484014, "chapter_id": 24484, "verse_number": "५-३-१७८-१५", "content_sanskrit": "ऋतुघ्ना ये स्वपत्नीनां पित्रोः सेहपरा न हि ।\nबान्धवेषु च दीनेषु करुणा यस्य नास्ति वै॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004484015, "chapter_id": 24484, "verse_number": "५-३-१७८-१६", "content_sanskrit": "क्षेत्रसेतुविभेदी च पूर्वमार्गप्रलोपकः ।\nनास्तिकः शास्त्रहीनस्तु विप्रः सन्ध्याविवर्जितः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004484016, "chapter_id": 24484, "verse_number": "५-३-१७८-१७", "content_sanskrit": "अहुताशी ह्यसंतुष्टः सर्वाशी सर्वविक्रयी ।\nकदर्या नास्तिकाः क्रूराः कृतघ्ना ये द्विजायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004484017, "chapter_id": 24484, "verse_number": "५-३-१७८-१८", "content_sanskrit": "पैशुन्या रसविक्रेयाः सर्वकालविनाकृताः ।\nस्वगोत्रां परगोत्रां वा ये भुञ्जन्ति द्विजाधमाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004484018, "chapter_id": 24484, "verse_number": "५-३-१७८-१९", "content_sanskrit": "ते मां प्राप्य विमुच्यन्ते पापसङ्घैः सुसंचितैः ।\nतत्पापक्षारतप्ताया न शर्म मम विद्यते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004484019, "chapter_id": 24484, "verse_number": "५-३-१७८-२०", "content_sanskrit": "तथा कुरु जगन्नाथ यथाहं शर्म चाप्नुयाम् ।\nएवमुक्तस्तु देवेशस्तुष्टः प्रोवाच जाह्नवीम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004484020, "chapter_id": 24484, "verse_number": "५-३-१७८-२१", "content_sanskrit": "विष्णुरुवाच ।\nअहमत्र वसिष्यामि गङ्गाधरसहायवान् ।\nप्रविशस्व सदा रेवां त्वमत्रैव च मूर्तिना॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004484021, "chapter_id": 24484, "verse_number": "५-३-१७८-२२", "content_sanskrit": "मम पादतलं प्राप्य वह त्रिपथगामिनि ।\nयदा बहूदककाले नर्मदाजलसंभृता॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004484022, "chapter_id": 24484, "verse_number": "५-३-१७८-२३", "content_sanskrit": "प्रावृट्कालं समासाद्य भविष्यति जलाकुला ।\nप्लाव्योभयतटं देवी प्राप्य मामुत्तरस्थितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004484023, "chapter_id": 24484, "verse_number": "५-३-१७८-२४", "content_sanskrit": "प्लावयिष्यति तोयेन यदा शङ्खं करे स्थितम् ।\nतदा पर्वशतोद्युक्तं वैष्णवं पर्वसंज्ञितम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004484024, "chapter_id": 24484, "verse_number": "५-३-१७८-२५", "content_sanskrit": "न तेन सदृशं किंचिद्व्यतीपातादिसंक्रमम् ।\nअयने द्वे च न तथा पुण्यात्पुण्यतरं यथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004484025, "chapter_id": 24484, "verse_number": "५-३-१७८-२६", "content_sanskrit": "तस्मिन्पर्वणि देवेशि शङ्खं संस्पृश्य मानवः ।\nस्नानमाचरते तोये मिश्रे गाङ्गेयनार्मदे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004484026, "chapter_id": 24484, "verse_number": "५-३-१७८-२७", "content_sanskrit": "पुण्यं त्वशेषपुण्यानां मङ्गलानां च मङ्गलम् ।\nविष्णुना विधृतो येन तस्माच्छान्तिः प्रचक्रमे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004484027, "chapter_id": 24484, "verse_number": "५-३-१७८-२८", "content_sanskrit": "तत्रान्तं पापसङ्घस्य ध्रुवमाप्नोति मानवः ।\nशङ्खोद्धारे नरः स्नात्वा तर्पयेत्पितृदेवताः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004484028, "chapter_id": 24484, "verse_number": "५-३-१७८-२९", "content_sanskrit": "तृप्तास्ते द्वादशाब्दानि सिद्धिं च सार्वकामिकीम् ।\nगङ्गावहे तु यः श्राद्धं शङ्खोद्धारे प्रदास्यति॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004484029, "chapter_id": 24484, "verse_number": "५-३-१७८-३०", "content_sanskrit": "तेन पिण्डप्रदानेन नृत्यन्ति पितरस्तथा ।\nशङ्खोद्धारे नरः स्नात्वा पूजयेद्बलकेशवौ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004484030, "chapter_id": 24484, "verse_number": "५-३-१७८-३१", "content_sanskrit": "रात्रौ जागरणं कृत्वा शुद्धो भवति जाह्नवि ।\nयत्त्वं लोककृतं कर्म मन्यसे भुवि दुःसहम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004484031, "chapter_id": 24484, "verse_number": "५-३-१७८-३२", "content_sanskrit": "तस्मिन्पर्वणि तत्सर्वं तत्र स्नात्वा व्यपोहय ।\nएवमुक्त्वा नरश्रेष्ठ विष्णुश्चान्तरधीयत॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004484032, "chapter_id": 24484, "verse_number": "५-३-१७८-३३", "content_sanskrit": "तदाप्रभृति तत्तीर्थं गङ्गावाहकमुत्तमम् ।\nब्रह्माद्यैरृषिभिस्तात पारम्पर्यक्रमागतैः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004484033, "chapter_id": 24484, "verse_number": "५-३-१७८-३४", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा भक्तिभावेन भारत ।\nगङ्गातीर्थे तु स स्नातः समस्तेषु न संशयः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004484034, "chapter_id": 24484, "verse_number": "५-३-१७८-३५", "content_sanskrit": "तत्र तीर्थे मृतानां तु नराणां भावितात्मनाम् ।\nअनिवर्तिका गतिस्तेषां विष्णुलोकात्कदाचन॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]