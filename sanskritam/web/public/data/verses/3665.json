[{"id": 2124330, "chapter_id": 3665, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124331, "chapter_id": 3665, "verse_number": "१", "content_sanskrit": "श्रुत्वा तु विदुरं प्राप्तं राज्ञा तु परिसान्त्वितम् ।\nधृतराष्ट्रात्मजो राजन् पर्यतप्यत दुर्मतिः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124332, "chapter_id": 3665, "verse_number": "२", "content_sanskrit": "स सौबलं समानाप्य कर्णदुश्शासनौ तथा ।\nअब्रवीद् वचनं राजा प्रविश्यावुद्धिजं तमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124333, "chapter_id": 3665, "verse_number": "३", "content_sanskrit": "एष प्रत्यागतो मन्त्री धृतराष्ट्रस्य सम्मतः ।\nविदुरः पाण्डुपुत्राणां सुहृद् विद्वान् हिते रतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124334, "chapter_id": 3665, "verse_number": "४", "content_sanskrit": "यावदस्य पुनर्बुद्धिं विदुरो नापकर्षति ।\nपाण्डवानयने तावन्मन्त्रयध्वं हितं मम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124335, "chapter_id": 3665, "verse_number": "५", "content_sanskrit": "अथ पश्याम्यहं पार्थान् प्राप्तानिह कथञ्चन ।\nपुनः शोकं गमिष्यामि निरासून् निष्प्ररिग्रहान् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124336, "chapter_id": 3665, "verse_number": "६", "content_sanskrit": "क्षिप्रमुद्बन्धनं चैव शस्त्रमग्निप्रवेशनम् ।\nकरिष्ये न हि तान् वृद्धान् पुनर्द्रष्टुमिहोत्सहे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124337, "chapter_id": 3665, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124338, "chapter_id": 3665, "verse_number": "७", "content_sanskrit": "किं बालिशमतिं राजन्नास्थितोऽसि विशाम्पते ।\nगतास्ते समयं कृत्वा नैतदेवं भविष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124339, "chapter_id": 3665, "verse_number": "८", "content_sanskrit": "सत्यवाक्ये स्थिताः सर्वे पाण्डवा भरतर्षभ ।\nपितुस्ते वचनं तात न ग्रहीष्यन्ति कर्हिचित् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124340, "chapter_id": 3665, "verse_number": "९", "content_sanskrit": "अथवा ते ग्रहीष्यन्ति पुनरेष्यन्ति वा गृहम् ।\nनिरस्य समयं भूयः पणोऽस्माकं भविष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124341, "chapter_id": 3665, "verse_number": "१०", "content_sanskrit": "सर्वे भवामो मध्यस्था राज्ञश्छन्दानुवर्तिनः ।\nछिद्रं बहु प्रपश्यन्तः पाण्डवानां सुसंवृताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124342, "chapter_id": 3665, "verse_number": "", "content_sanskrit": "दुश्शासनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124343, "chapter_id": 3665, "verse_number": "११", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथा वदसि मातुल ।\nनित्यं हि मे कथयतस्तव बुद्धिर्हि रोचते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124344, "chapter_id": 3665, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124345, "chapter_id": 3665, "verse_number": "१२", "content_sanskrit": "काममीक्षामहे सर्वे दुर्योधन तवेप्सितम् ।\nऐकमत्यं हि नो राजन् सर्वेषामेव लक्ष्यते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124346, "chapter_id": 3665, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124347, "chapter_id": 3665, "verse_number": "१३", "content_sanskrit": "एवमुक्तस्तु कर्णेन राजा दुर्योधनस्तदा ।\nनातिहृष्टमनाः क्षिप्रमभवत् स पराङ्मुखः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124348, "chapter_id": 3665, "verse_number": "१४", "content_sanskrit": "उपलभ्य ततः कर्णो विवृत्य नयते शुभे ।\nरोषाद् दुश्शासनं चैव सौबलेयं च तावुभौ \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124349, "chapter_id": 3665, "verse_number": "१५", "content_sanskrit": "उवाच परमक्रृद्ध उद्यम्यात्मानमात्मना ।\nअहो मम मतं यत्तु तन्निबोध नराधिपाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124350, "chapter_id": 3665, "verse_number": "१६", "content_sanskrit": "प्रियं सर्वे चिकीर्षामो राज्ञः किं करवामहे ।\nन चास्य शक्नुमः सर्वे ह्यवस्थातुमतन्द्रिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124351, "chapter_id": 3665, "verse_number": "१७", "content_sanskrit": "वयं तु शस्त्राण्यादाय रथानास्थाय दंशिताः ।\nगच्छामः सहिता हन्तुं पाण्डवान् वनगोचरान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124352, "chapter_id": 3665, "verse_number": "१८", "content_sanskrit": "तेषु सर्वेषु शान्तेषु गतेष्वविदितां गतिम् ।\nनिर्विशङ्का भविष्यामो धार्तराष्ट्रास्तथा वयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124353, "chapter_id": 3665, "verse_number": "१९", "content_sanskrit": "यावदेव परिद्यूना यावच्छोकपरायणाः ।\nयावन्मन्त्रविहीनाश्च तावद् गच्छाम माचिरम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124354, "chapter_id": 3665, "verse_number": "२०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा पूजयन्तः पुनः पुनः ।\nप्रसन्नमनसः सर्वे प्रत्यूचुः सूतजं तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124355, "chapter_id": 3665, "verse_number": "२१", "content_sanskrit": "एतत् कृत्यतमं राज्ञः कौरवस्य महात्मनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124356, "chapter_id": 3665, "verse_number": "", "content_sanskrit": "वैशंपायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124357, "chapter_id": 3665, "verse_number": "२२", "content_sanskrit": "एवमुक्त्वा सुसङ्क्रुद्धा रथैः सर्वे पृथक्पृथक् ।\nनिर्ययुः पाण्डवान् हन्तुं सङ्घशः कृतनिश्चयाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124358, "chapter_id": 3665, "verse_number": "२३", "content_sanskrit": "तान् प्रस्थितान् परिज्ञाय कृष्णद्वैपायनस्तदा ।\nआजगाम महायोगी दृष्ट्वा दिव्येन चक्षुषा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124359, "chapter_id": 3665, "verse_number": "२४", "content_sanskrit": "प्रतिषिध्य तु तान् सर्वान् भगवाँल्लोकपूजितः ।\nप्रज्ञाचक्षुषमासीनमुवाचाभ्येत्य सत्वरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124360, "chapter_id": 3665, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वनपर्वणि\nसप्तमोऽध्यायः ॥७॥\n॥ आरण्यकपर्वणि सप्तमोऽध्यायः ॥७॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]