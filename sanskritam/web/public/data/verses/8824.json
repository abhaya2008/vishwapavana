[{"id": 40001252, "chapter_id": 8824, "verse_number": "1", "content_sanskrit": "कालधर्मं गते राम सगरे प्रकृतीजना:। राजानं रोचयामासुरंशुमन्तं सुधार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001253, "chapter_id": 8824, "verse_number": "2", "content_sanskrit": "स राजा सुमहानासीदंशुमान् रघुनन्दन । तस्य पुत्रो महानासीद्दिलीप इति विश्रुत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001254, "chapter_id": 8824, "verse_number": "3", "content_sanskrit": "तस्मिन् राज्यं समावेश्य दिलीपे रघुनन्दन। हिमवच्छिखरे पुण्ये तपस्तेपे सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001255, "chapter_id": 8824, "verse_number": "4", "content_sanskrit": "द्वात्रिंशच्च सहस्राणि वर्षाणि सुमहायशा:। तपोवनं गतो राम स्वर्गं लेभे तपोधन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001256, "chapter_id": 8824, "verse_number": "5", "content_sanskrit": "दिलीपस्तु महातेजाश्श्रुत्वा पैतामहं वधम्। दु:खोपहतया बुद्ध्या निश्चयं नाध्यगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001257, "chapter_id": 8824, "verse_number": "6", "content_sanskrit": "कथं गङ्गावतरणं कथं तेषां जलक्रिया। तारयेयं कथं चैतानिति चिन्तापरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001258, "chapter_id": 8824, "verse_number": "7", "content_sanskrit": "तस्य चिन्तयतो नित्यं धर्मेण विदितात्मन:। पुत्रो भगीरथो नाम जज्ञे परमधार्मिक: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001259, "chapter_id": 8824, "verse_number": "8", "content_sanskrit": "दिलीपस्तु महातेजा यज्ञैर्बहुभिरिष्टवान्। त्रिंशद्वर्षसहस्राणि राजा राज्यमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001260, "chapter_id": 8824, "verse_number": "9", "content_sanskrit": "अगत्वा निश्चयं राजा तेषामुद्धरणं प्रति । व्याधिना नरशार्दूल कालधर्ममुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001261, "chapter_id": 8824, "verse_number": "10", "content_sanskrit": "इन्द्रलोकं गतो राजा स्वार्जितेनैव कर्मणा। राज्ये भगीरथं पुत्रमभिषिच्य नरर्षभ: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001262, "chapter_id": 8824, "verse_number": "11", "content_sanskrit": "भगीरथस्तु राजर्षिर्धार्मिको रघुनन्दन। अनपत्यो महातेजा: प्रजाकामस्स चाप्रज: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001263, "chapter_id": 8824, "verse_number": "12", "content_sanskrit": "मन्त्रिष्वाधाय तद्राज्यं गङ्गावतरणे रत:। स तपो दीर्घमातिष्ठद्गोकर्णे रघुनन्दन ॥ ऊर्ध्वबाहु: पञ्चतपा मासाहारो जितेन्द्रिय:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001264, "chapter_id": 8824, "verse_number": "13", "content_sanskrit": "तस्य वर्षसहस्राणि घोरे तपसि तिष्ठत: ॥ अतीतानि महाबाहो तस्य राज्ञो महात्मन:। सुप्रीतो भगवान् ब्रह्मा प्रजानां पतिरीश्वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001265, "chapter_id": 8824, "verse_number": "14", "content_sanskrit": "तस्य वर्षसहस्राणि घोरे तपसि तिष्ठत: ॥ अतीतानि महाबाहो तस्य राज्ञो महात्मन:। सुप्रीतो भगवान् ब्रह्मा प्रजानां पतिरीश्वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001266, "chapter_id": 8824, "verse_number": "15", "content_sanskrit": "ततस्सुरगणैस्सार्धमुपागम्य पितामह:। भगीरथं महात्मानं तप्यमानमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001267, "chapter_id": 8824, "verse_number": "16", "content_sanskrit": "भगीरथ महाभाग प्रीतस्तेऽहं जनेश्वर। तपसा च सुतप्तेन वरं वरय सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001268, "chapter_id": 8824, "verse_number": "17", "content_sanskrit": "तमुवाच महातेजा: सर्वलोकपितामहम्। भगीरथो महाभाग: कृताञ्जलिरुपस्थित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001269, "chapter_id": 8824, "verse_number": "18", "content_sanskrit": "यदि मे भगवन् प्रीतो यद्यस्ति तपस: फलम्। सगरस्यात्मजास्सर्वे मत्तस्सलिलमाप्नुयु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001270, "chapter_id": 8824, "verse_number": "19", "content_sanskrit": "गङ्गायास्सलिलक्लिन्ने भस्मन्येषां महात्मनाम्। स्वर्गं गच्छेयुरत्यन्तं सर्वे मे प्रपितामहा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001271, "chapter_id": 8824, "verse_number": "20", "content_sanskrit": "देया च सन्ततिर्देव नावसीदेत्कुलं च न:। इक्ष्वाकूणां कुले देव एष मेऽस्तु वर:पर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001272, "chapter_id": 8824, "verse_number": "21", "content_sanskrit": "उक्तवाक्यं तु राजानं सर्वलोकपितामह:। प्रत्युवाच शुभां वाणीं मधुरां मधुराक्षराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001273, "chapter_id": 8824, "verse_number": "22", "content_sanskrit": "मनोरथो महानेष भगीरथ महारथ। एवं भवतु भद्रं ते इक्ष्वाकुकुलवर्धन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001274, "chapter_id": 8824, "verse_number": "23", "content_sanskrit": "इयं हैमवती गङ्गा ज्येष्ठा हिमवतस्सुता। तां वै धारयितुं शक्तो हरस्तत्र नियुज्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40001275, "chapter_id": 8824, "verse_number": "24", "content_sanskrit": "गङ्गाया: पतनं राजन् पृथिवी न सहिष्यति। तां वै धारयितुं वीर नान्यं पश्यामि शूलिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40001276, "chapter_id": 8824, "verse_number": "25", "content_sanskrit": "तमेवमुक्त्वा राजानं गङ्गां चाभाष्य लोककृत्। जगाम त्रिदिवं देवस्सहदेवैर्मरुद्गणै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]