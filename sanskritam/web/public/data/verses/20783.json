[{"id": 7000783000, "chapter_id": 20783, "verse_number": "६-१२६-१", "content_sanskrit": "वसिष्ठ उवाच ।\nअधुना माघमाहात्म्यं प्रवक्ष्यामि नृपोत्तम ।\nपृच्छते कार्तवीर्याय दत्तात्रेयेण भाषितम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000783001, "chapter_id": 20783, "verse_number": "६-१२६-२", "content_sanskrit": "दत्तात्रेयं हरिं साक्षाद्वसंतं सह्य पर्वते ।\nपप्रच्छ तं द्विजं गत्वा राजा माहिष्मतीपतिः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000783002, "chapter_id": 20783, "verse_number": "६-१२६-३", "content_sanskrit": "सहस्रार्जुन उवाच ।\nभगवन्योगिनां श्रेष्ठ सर्वे धर्माः श्रुता मया ।\nमाघस्नानफलं ब्रूहि कृपया मम सुव्रत॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000783003, "chapter_id": 20783, "verse_number": "६-१२६-४", "content_sanskrit": "दत्तात्रेय उवाच ।\nश्रूयतां नृपशार्दूल एतत्प्रश्नोत्तरं शुभम् ।\nब्रह्मणोक्तं पुरा ह्येतन्नारदाय महात्मने॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000783004, "chapter_id": 20783, "verse_number": "६-१२६-५", "content_sanskrit": "तत्सर्वं कथयिष्यामि माघस्नानफलं महत् ।\nयथादेशं यथातीर्थं यथाविधि यथाक्रियम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000783005, "chapter_id": 20783, "verse_number": "६-१२६-६", "content_sanskrit": "अस्मिन्वै भारते वर्षे कर्मभूमौ विशेषतः ।\nअमाघस्नायिनां नॄणां निष्फलं जन्मकीर्तितम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000783006, "chapter_id": 20783, "verse_number": "६-१२६-७", "content_sanskrit": "असूर्यं गगनं यद्वदचन्द्रमुडुमंडलम् ।\nतद्वन्नाभाति सत्कर्म माघस्नानं विना नृप॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000783007, "chapter_id": 20783, "verse_number": "६-१२६-८", "content_sanskrit": "व्रतैर्दानैस्तपोभिश्च न तथा प्रीयते हरिः ।\nमाघमज्जनमात्रेण यथा प्रीणाति केशवः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000783008, "chapter_id": 20783, "verse_number": "६-१२६-९", "content_sanskrit": "न समं विद्यते किंचित्तेजः सौरेण तेजसा ।\nतद्वत्स्नानेन माघस्य न समाः क्रतुजाः क्रियाः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000783009, "chapter_id": 20783, "verse_number": "६-१२६-१०", "content_sanskrit": "प्रीतये वासुदेवस्य सर्वपापापनुत्तये ।\nमाघस्नानं प्रकुर्वीत स्वर्गलाभाय मानवः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000783010, "chapter_id": 20783, "verse_number": "६-१२६-११", "content_sanskrit": "किं रक्षितेन देहेन सुपुष्टेन बलीयसा ।\nअध्रुवेणाप्यशुचिना माघस्नानं विना भवेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000783011, "chapter_id": 20783, "verse_number": "६-१२६-१२", "content_sanskrit": "अस्थिस्तंभं स्नायुबद्धं मांसक्षतज लेपनम् ।\nचर्मावनद्धं दुर्गंधं पात्रं मूत्रपुरीषयोः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000783012, "chapter_id": 20783, "verse_number": "६-१२६-१३", "content_sanskrit": "जराशोकविपद्व्याप्तं रोगमंदिरमातुरम् ।\nरजस्वलमनित्यं च सर्वदोषसमाश्रयम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000783013, "chapter_id": 20783, "verse_number": "६-१२६-१४", "content_sanskrit": "परोपतापितापार्तं परद्रोहि परं विषम् ।\nलोलुपं पिशुनं क्रूरं कृतघ्नं क्षणिकं तथा॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000783014, "chapter_id": 20783, "verse_number": "६-१२६-१५", "content_sanskrit": "दुष्पूरं दुर्धरं दुष्टं दोषत्रयसमन्वितम् ।\nअशुचिस्रावि सच्छिद्रं तापत्रयविमोहितम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000783015, "chapter_id": 20783, "verse_number": "६-१२६-१६", "content_sanskrit": "निसर्गतोऽधर्मरतं तृष्णाशत समाकुलम् ।\nकामक्रोध महालोभ नरकद्वार संस्थितम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000783016, "chapter_id": 20783, "verse_number": "६-१२६-१७", "content_sanskrit": "क्रिमिविड्भस्मभवति परिणामे शुनां हविः ।\nईदृक्शरीरं व्यर्थं हि माघस्नानविवर्जितम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000783017, "chapter_id": 20783, "verse_number": "६-१२६-१८", "content_sanskrit": "बुद्बुदाइव तोयेषु पूतिका इव जंतुषु ।\nजायंते मरणायैव माघस्नानविवर्जिताः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000783018, "chapter_id": 20783, "verse_number": "६-१२६-१९", "content_sanskrit": "अवैष्णवो हतो विप्रो हतं श्राद्धमयोगि च ।\nअब्रह्मण्यं हतं क्षेत्रमनाचारं हतं कुलम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000783019, "chapter_id": 20783, "verse_number": "६-१२६-२०", "content_sanskrit": "सदंभश्च हतो धर्मः क्रोधेनैव हतं तपः ।\nअदृढं च हतं ज्ञानं प्रमादेन हतं श्रुतम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000783020, "chapter_id": 20783, "verse_number": "६-१२६-२१", "content_sanskrit": "गुर्वभक्ता हता नारी ब्रह्मचारी तया हतः ।\nअदीप्तेऽग्नौ हतो होमो हता भुंक्तिरसाक्षिका॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000783021, "chapter_id": 20783, "verse_number": "६-१२६-२२", "content_sanskrit": "उपजीव्या हता कन्या स्वार्थे पाकक्रिया हता ।\nशूद्रभिक्षो हतो यागः कृपणस्य हतं धनम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000783022, "chapter_id": 20783, "verse_number": "६-१२६-२३", "content_sanskrit": "अनभ्यासा हता विद्या हतो राजा विरोधकृत् ।\nजीवनार्थं हतं तीर्थं जीवनार्थं हतं व्रतम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000783023, "chapter_id": 20783, "verse_number": "६-१२६-२४", "content_sanskrit": "असत्या च हता वाणी तथा पैशुन्यवादिनी ।\nसंदिग्धश्च हतो मंत्रो व्यग्रचित्तो हतो जपः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000783024, "chapter_id": 20783, "verse_number": "६-१२६-२५", "content_sanskrit": "हतमश्रोत्रिये दानं हतो लोकश्च नास्तिकः ।\nअश्रद्धया हतं सर्वं कृतं यत्पारलौकिकम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000783025, "chapter_id": 20783, "verse_number": "६-१२६-२६", "content_sanskrit": "इहलोको हतो नॄणां दरिद्राणां यथा नृप ।\nमनुष्याणां तथा जन्म माघस्नानं विना हतम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000783026, "chapter_id": 20783, "verse_number": "६-१२६-२७", "content_sanskrit": "मकरस्थे रवौ यो हि न स्नात्यनुदिते रवौ ।\nकथं पापैः प्रमुच्येत कथं स त्रिदिवं व्रजेत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000783027, "chapter_id": 20783, "verse_number": "६-१२६-२८", "content_sanskrit": "ब्रह्महा हेमहारी च सुरापो गुरुतल्पगः ।\nमाघस्नायी विपापः स्यात्तत्संसर्गी च पंचमः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000783028, "chapter_id": 20783, "verse_number": "६-१२६-२९", "content_sanskrit": "माघमासे रटंत्यापः किंचिदभ्युदिते रवौ ।\nब्रह्मघ्नं वा सुरापं वा कंपंतं तं पुनीमहे॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000783029, "chapter_id": 20783, "verse_number": "६-१२६-३०", "content_sanskrit": "उपपापानि सर्वाणि पातकानि महांत्यपि ।\nभस्मीभवंति सर्वाणि माघस्नानोद्यतं नरम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000783030, "chapter_id": 20783, "verse_number": "६-१२६-३१", "content_sanskrit": "कंपंति सर्वपापानि माघस्नानसमागमे ।\nनाशकालोऽयमस्माकं यदि स्नास्यति वारिणि॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000783031, "chapter_id": 20783, "verse_number": "६-१२६-३२", "content_sanskrit": "एवं क्रोशंति पापानि दृष्ट्वा स्नानोद्यतं नरम् ।\nपावका इव दीप्यंते माघस्नानैर्नरोत्तमाः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000783032, "chapter_id": 20783, "verse_number": "६-१२६-३३", "content_sanskrit": "विमुक्ताः सर्वपापेभ्यो मेघेभ्य इव चंद्रमाः ।\nआर्द्रशुष्कं लघुस्थूलं वाङ्मनः कर्मभिः कृतम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000783033, "chapter_id": 20783, "verse_number": "६-१२६-३४", "content_sanskrit": "माघस्नानं दहेत्पापं पावकः समिधो यथा ।\nप्रामादिकं च यत्पापं ज्ञानाज्ञानकृतं च यत्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000783034, "chapter_id": 20783, "verse_number": "६-१२६-३५", "content_sanskrit": "स्नानमात्रेण तन्नश्येन्मकरस्थे दिवाकरे ।\nनिष्पापास्त्रिदिवं यांति पापिष्ठा यांति शुद्धताम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000783035, "chapter_id": 20783, "verse_number": "६-१२६-३६", "content_sanskrit": "संदेहो नात्र कर्तव्यो माघस्नाने नराधिप ।\nसर्वेऽधिकारिणो माघे विष्णुभक्तौ यथा नृप॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000783036, "chapter_id": 20783, "verse_number": "६-१२६-३७", "content_sanskrit": "सर्वेषां स्वर्गदो माघः सर्वेषां पापनाशनः ।\nएष एव परो मंत्रो ह्येतदेव परं तपः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000783037, "chapter_id": 20783, "verse_number": "६-१२६-३८", "content_sanskrit": "प्रायश्चित्तं परं चैतन्माघस्नानमनुत्तमम् ।\nनृणां जन्मांतराभ्यासान्माघस्नाने मतिर्भवेत्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000783038, "chapter_id": 20783, "verse_number": "६-१२६-३९", "content_sanskrit": "अध्यात्मज्ञानकौशल्यं जन्माभ्यासाद्यथा नृप ।\nसंसारकर्दमालेप प्रक्षालन विशारदम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000783039, "chapter_id": 20783, "verse_number": "६-१२६-४०", "content_sanskrit": "पावनं पावनानां च माघस्नानपरं नृप ।\nस्नांति माघे न ये राजन्सर्वकामफलप्रदे॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000783040, "chapter_id": 20783, "verse_number": "६-१२६-४१", "content_sanskrit": "कथं ते भुंजते भोगांश्चंद्रसूर्यग्रहोपमान् ।\nशृणु राजन्महाश्चर्यं माघस्नानप्रभावजम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000783041, "chapter_id": 20783, "verse_number": "६-१२६-४२", "content_sanskrit": "कुब्जिका नाम कल्याणी ब्राह्मणी भृगुवंशजा ।\nबालवैधव्यदुःखार्ता तपस्तेपे सुदुस्तरम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000783042, "chapter_id": 20783, "verse_number": "६-१२६-४३", "content_sanskrit": "विंध्यपादे महाक्षेत्रे रेवाकपिलसंगमे ।\nतत्र सा व्रतिनी भूत्वा नारायणपरायणा॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000783043, "chapter_id": 20783, "verse_number": "६-१२६-४४", "content_sanskrit": "सदाचारवती नित्यं नित्यं संगविवर्जिता ।\nजितेंद्रिया जितक्रोधा सत्यवागल्पभाषिणी॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000783044, "chapter_id": 20783, "verse_number": "६-१२६-४५", "content_sanskrit": "सुशीला दानशीला च देहशोषणशालिनी ।\nपितृदेवद्विजेभ्यश्च दत्वा हुत्त्वा तथानले॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000783045, "chapter_id": 20783, "verse_number": "६-१२६-४६", "content_sanskrit": "षष्ठे काले च सा भुङ्क्ते ह्युंच्छवृत्तिः सदा नृप ।\nकृच्छ्रातिकृच्छ्र पाराक तप्तकृच्छ्रादिभिर्व्रतैः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000783046, "chapter_id": 20783, "verse_number": "६-१२६-४७", "content_sanskrit": "पुण्यान्नयति सा मासान्नर्मदायाश्च रोधसि ।\nएवं तया तपस्विन्या वल्कलिन्या सुशीलया॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000783047, "chapter_id": 20783, "verse_number": "६-१२६-४८", "content_sanskrit": "सुमहासत्त्वशालिन्या धृति संतोषयुक्तया ।\nषष्टिर्माघास्तया स्नाता रेवाकपिलसंगमे॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000783048, "chapter_id": 20783, "verse_number": "६-१२६-४९", "content_sanskrit": "ततः सा तपसा क्षीणा तस्मिंस्तीर्थे मृता नृप ।\nमाघस्नानजपुण्येन तेन सा वैष्णवे पुरे॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000783049, "chapter_id": 20783, "verse_number": "६-१२६-५०", "content_sanskrit": "उवास प्रमुदा युक्ता चतुर्युगसहस्रकम् ।\nसुंदोपसुंदनाशाय पश्चात्पद्मभवात्पुनः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000783050, "chapter_id": 20783, "verse_number": "६-१२६-५१", "content_sanskrit": "तिलोत्तमेति नाम्ना सा ब्रह्मलोकेऽवतारिता ।\nतेन पुण्यस्यशेषेण रूपस्यैकायनं ययौ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000783051, "chapter_id": 20783, "verse_number": "६-१२६-५२", "content_sanskrit": "अयोनिजाबलारत्नं देवानामपि मोहिनी ।\nलावण्यहृदनी तन्वी साभूदप्सरसां वरा॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000783052, "chapter_id": 20783, "verse_number": "६-१२६-५३", "content_sanskrit": "निपुणस्य विधेः स्रष्टुर्नूनमाश्चर्यकारिणी ।\nतामुत्पाद्य विधाता वै तुष्टोऽनुज्ञां तदा ददौ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000783053, "chapter_id": 20783, "verse_number": "६-१२६-५४", "content_sanskrit": "एणशावाक्षि गच्छ त्वं दैत्यनाशाय सत्वरम् ।\nततः सा ब्रह्मणो लोकाद्वीणामादाय भामिनी॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000783054, "chapter_id": 20783, "verse_number": "६-१२६-५५", "content_sanskrit": "गता पुष्करमार्गेण यत्र तौ देववैरिणौ ।\nतत्र स्नात्वा तु रेवायाः पवित्रे निर्मले जले॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000783055, "chapter_id": 20783, "verse_number": "६-१२६-५६", "content_sanskrit": "परिधायांबरं रक्तं बंधूककुसुमप्रभम् ।\nरणद्वलयिनीचारु सिंजन्मेखलनूपुरा॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000783056, "chapter_id": 20783, "verse_number": "६-१२६-५७", "content_sanskrit": "लोलमुक्तावलीकंठी चलत्कुंडलशोभना ।\nमाधवी कुसुमापीडा कंकेली विटपे स्थिता॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000783057, "chapter_id": 20783, "verse_number": "६-१२६-५८", "content_sanskrit": "गायंती सुस्वरं सापि पीडयंती तु वल्लकीम् ।\nमूर्च्छयंती स्वरषट्कं सुस्निग्धं कोमलं कलम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000783058, "chapter_id": 20783, "verse_number": "६-१२६-५९", "content_sanskrit": "इत्थं तिलोत्तमा बाला तिष्ठंत्यशोककानने ।\nदृष्ट्वा दैत्यभटैरिंदोः कलेव सुखदा हृदि॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000783059, "chapter_id": 20783, "verse_number": "६-१२६-६०", "content_sanskrit": "तां दृष्ट्वा विस्मितै राजन्सानंदैः सैनिकैर्भृशम् ।\nत्वरमाणैरदृष्ट्वैव गत्वा सुंदोपसुंदयोः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000783060, "chapter_id": 20783, "verse_number": "६-१२६-६१", "content_sanskrit": "कथिता संभ्रमेणैव वर्णयित्वा पुनः पुनः ।\nहे दैत्यौ न विजानीमो देवी वा दानवी नु किम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000783061, "chapter_id": 20783, "verse_number": "६-१२६-६२", "content_sanskrit": "नागांगनाथ वा यक्षी स्त्रीरत्नं सर्वथा तु सा ।\nयुवां रत्नभुजौ लोके रत्नभूता हि साबला॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000783062, "chapter_id": 20783, "verse_number": "६-१२६-६३", "content_sanskrit": "वर्तते नाति दूरेऽग्रे अशोके शोकहारिणी ।\nगत्वा तां पश्यतं शीघ्रं मन्मथस्यापि मोहिनीम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000783063, "chapter_id": 20783, "verse_number": "६-१२६-६४", "content_sanskrit": "इति सेनापतीनां तौ श्रुत्वा वाचं मनोहराम् ।\nचषकं सीधुनस्त्यक्त्वा विहाय जलसेचनम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000783064, "chapter_id": 20783, "verse_number": "६-१२६-६५", "content_sanskrit": "उत्तमस्त्रीसहस्राणि त्यक्त्वा तस्माज्जलाशयात् ।\nशतभारायसीं क्रूरां कालदंडोपमां गदाम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000783065, "chapter_id": 20783, "verse_number": "६-१२६-६६", "content_sanskrit": "भिन्नाभिन्नां गृहीत्वा तु जवेनाभिप्लुतं गतौ ।\nयत्र शृंगारसज्जा सा हंतुं चंडीव संस्थिता॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000783066, "chapter_id": 20783, "verse_number": "६-१२६-६७", "content_sanskrit": "राजन्संधुक्षयंतीव दैत्ययोर्मन्मथानलम् ।\nस्थित्वा तस्याः पुरो जाल्मौ तद्रूपेणविमोहितौ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000783067, "chapter_id": 20783, "verse_number": "६-१२६-६८", "content_sanskrit": "विशेषान्मधुनामत्तावूचतुस्तौपरस्परम् ।\nभ्रातर्विरम भार्येयं ममास्तु वरवर्णिनी॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000783068, "chapter_id": 20783, "verse_number": "६-१२६-६९", "content_sanskrit": "त्वमेवार्य त्यजैतां मे भार्यां तु मदिरेक्षणाम् ।\nइत्याग्रहेण संरब्धौ मातंगाविव सोन्मदौ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000783069, "chapter_id": 20783, "verse_number": "६-१२६-७०", "content_sanskrit": "अन्योन्यं कालनिर्दिष्टौ गदया जघ्नतुस्तदा ।\nपरस्परप्रहारेण गतासू पतितौ भुवि॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000783070, "chapter_id": 20783, "verse_number": "६-१२६-७१", "content_sanskrit": "तौ मृतौ सैनिकैर्दृष्ट्वा कृतः कोलाहलो महान् ।\nकालरात्रिसमा केयं हा किमेतदुपस्थितम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000783071, "chapter_id": 20783, "verse_number": "६-१२६-७२", "content_sanskrit": "एवं वदत्सु सैन्येषु दैत्यौ सुंदोपसुंदकौ ।\nपातयित्वा गिरेः शृंगे ह्रादिनीव त्तिलोत्तमा॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000783072, "chapter_id": 20783, "verse_number": "६-१२६-७३", "content_sanskrit": "प्रस्थिता गगनं शीघ्रं द्योतयंती दिशो दश ।\nदेवकार्यं ततः कृत्वा आगता ब्रह्मणः पुरः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000783073, "chapter_id": 20783, "verse_number": "६-१२६-७४", "content_sanskrit": "ततस्तुष्टेन देवेन विधिना सानुमोदिता ।\nस्थानं सूर्यरथे दत्तं तव चंद्रानने मया॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000783074, "chapter_id": 20783, "verse_number": "६-१२६-७५", "content_sanskrit": "भुंक्ष्व भोगाननेकांस्त्वं यावत्सूर्योंबरे स्थितः ।\nइत्थं सा ब्राह्मणी राजन्भूत्वा चाप्सरसां वरा॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000783075, "chapter_id": 20783, "verse_number": "६-१२६-७६", "content_sanskrit": "भुंक्तेद्यापि रवेर्लोके माघस्नानफलं महत् ।\nतस्मात्प्रयत्नतो राजन्श्रद्दधानैः सदा नरैः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000783076, "chapter_id": 20783, "verse_number": "६-१२६-७७", "content_sanskrit": "स्नातव्यं मकरादित्ये वांच्छद्भिः परमां गतिम् ।\nनानवाप्तोऽत्र तस्यास्ति पुरुषार्थो हि कश्चन॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000783077, "chapter_id": 20783, "verse_number": "६-१२६-७८", "content_sanskrit": "नाक्षीणं पातकं कंचिन्माघे मज्जति यो नरः ।\nतुलयंति न तेनात्र यज्ञाः सर्वे सदक्षिणाः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000783078, "chapter_id": 20783, "verse_number": "६-१२६-७९", "content_sanskrit": "माघस्नानेन राजेंद्र तीर्थे चैव विशेषतः ।\nन चान्यत्स्वर्गदं कर्म न चान्यत्पापनाशनम्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000783079, "chapter_id": 20783, "verse_number": "६-१२६-८०", "content_sanskrit": "न चान्यन्मोक्षदं यस्मान्माघस्नानसमं भुवि॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]