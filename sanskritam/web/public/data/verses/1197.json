[{"id": 2009925, "chapter_id": 1197, "verse_number": "१-१९८-०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009926, "chapter_id": 1197, "verse_number": "१-१९८-१", "content_sanskrit": "पुनश्चैव महातेजा विश्वामित्रजिघांसया।\nअग्निं संभृतवान्घोरं शाक्तेयः सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009927, "chapter_id": 1197, "verse_number": "१-१९८-२", "content_sanskrit": "वासिष्ठसंभृतश्चाग्निर्विश्वामित्रहितैषिणा।\nतेजसा वह्नितुल्येन ग्रस्तः स्कन्देन धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009928, "chapter_id": 1197, "verse_number": "१-१९८-३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009929, "chapter_id": 1197, "verse_number": "१-१९८-३", "content_sanskrit": "राज्ञा कल्माषपादेन गुरौ ब्रह्मविदां वरे।\nकारणं किं पुरस्कृत्य भार्या वै सन्नियोजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009930, "chapter_id": 1197, "verse_number": "१-१९८-४", "content_sanskrit": "जानता वै परं धर्मं वसिष्ठेन महात्मना।\nअगम्यागमनं कस्मात्कृतं तेन महर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009931, "chapter_id": 1197, "verse_number": "१-१९८-५", "content_sanskrit": "अधर्मिष्ठं वसिष्ठेन कृतं चापि पुरा सखे।\nएतन्मे संशयं सर्वं छेत्तुमर्हसि पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009932, "chapter_id": 1197, "verse_number": "१-१९८-६x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009933, "chapter_id": 1197, "verse_number": "१-१९८-६", "content_sanskrit": "धनञ्जय निबोधेयं यन्मां त्वं परिपृच्छसि।\nवसिष्ठं प्रति दुर्धर्ष तथा मित्रसहं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009934, "chapter_id": 1197, "verse_number": "१-१९८-७", "content_sanskrit": "कथितं ते मया सर्वं यथा शप्तः स पार्थिवः।\nशक्तिना भरतश्रेष्ठ वासिष्ठेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009935, "chapter_id": 1197, "verse_number": "१-१९८-८", "content_sanskrit": "स तु शापवशं प्राप्तः क्रोधपर्याकुलेक्षणः।\nनिर्जगाम पुराद्राजा सहदारः परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009936, "chapter_id": 1197, "verse_number": "१-१९८-९", "content_sanskrit": "अरण्यं निर्जनं गत्वा सदारः परिचक्रमे।\nनानामृगगणाकीर्णं नानासत्वसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009937, "chapter_id": 1197, "verse_number": "१-१९८-१०", "content_sanskrit": "नानागुल्मलताच्छन्नं नानाद्रुमसमावृतम्।\nअरण्यं घोरसन्नादं शापग्रस्तः परिभ्रमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009938, "chapter_id": 1197, "verse_number": "१-१९८-११", "content_sanskrit": "स कदाचित्क्षुधाविष्टो मृगयन्भक्ष्यमात्मनः।\nददर्श सुपरिक्लिष्टः कस्मिंश्चिन्निर्जने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009939, "chapter_id": 1197, "verse_number": "१-१९८-१२", "content_sanskrit": "ब्राह्मणं ब्राह्मणीं चैव मिथुनायोपसंगतौ।\nतौ तं वीक्ष्य सुवित्रस्तावकृतार्थौ प्रधावितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009940, "chapter_id": 1197, "verse_number": "१-१९८-१३", "content_sanskrit": "तयोः प्रद्रवतोर्विप्रं जग्राह नृपतिर्बलात्।\nदृष्ट्वा गृहीतं भर्तारमथ ब्राह्मण्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009941, "chapter_id": 1197, "verse_number": "१-१९८-१४", "content_sanskrit": "शृणु राजन्मम वचो यत्त्वां वक्ष्यामि सुव्रत।\nआदित्यवंशप्रभवस्त्वं हि लोके परिश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009942, "chapter_id": 1197, "verse_number": "१-१९८-१५", "content_sanskrit": "अप्रमत्तः स्थि धर्मे गुरुशुश्रूषणे रतः।\nशापोपहत दुर्धर्ष न पापं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009943, "chapter_id": 1197, "verse_number": "१-१९८-१६", "content_sanskrit": "ऋतुकाले तु संप्राप्ते भर्तृव्यसनकर्शिता।\nअकृतार्था ह्यहं भर्त्रा प्रसवार्थं समागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009944, "chapter_id": 1197, "verse_number": "१-१९८-१७", "content_sanskrit": "प्रसीद नृपतिश्रेष्ठ भर्ताऽयं मे विसृज्यताम्।\nएवं विक्रोशमानायास्तस्यास्तु न नृशंसवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009945, "chapter_id": 1197, "verse_number": "१-१९८-१८", "content_sanskrit": "भर्तारं भक्षयामास व्याघ्रो मृगमिवेप्सितम्।\nतस्याः क्रोधाभिभूताया यान्यश्रूण्यपतन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009946, "chapter_id": 1197, "verse_number": "१-१९८-१९", "content_sanskrit": "सोऽग्निः समभवद्दीप्तस्तं च देशं व्यदीपयत्।\nततः सा शोकसंतप्ता भर्तृव्यसनकर्शिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009947, "chapter_id": 1197, "verse_number": "१-१९८-२०", "content_sanskrit": "कल्माषपादं राजर्षिमशपद्ब्राह्मणी रुषा।\nयस्मान्ममाकृतार्थायास्त्वया क्षुद्र नृशंसवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009948, "chapter_id": 1197, "verse_number": "१-१९८-२१", "content_sanskrit": "प्रेक्षन्त्या भक्षितो मेऽद्य प्रियो भर्ता महायशाः।\nतस्मात्त्वमपि दुर्बुद्धे मच्छापपरिविक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009949, "chapter_id": 1197, "verse_number": "१-१९८-२२", "content_sanskrit": "पत्नीमृतावनुप्राप्य सद्यस्त्यक्ष्यसि जीवितम्।\nतेन प्रसाद्यमाना सा प्रसादमकरोत्तदा।\nयस्य चर्षेर्वसिष्ठस्य त्वया पुत्रा विनाशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009950, "chapter_id": 1197, "verse_number": "१-१९८-२३", "content_sanskrit": "तेन संगम्य ते भार्या तनयं जनयिष्यति।\nसते वंशकरः पुत्रो भविष्यति नृपाधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009951, "chapter_id": 1197, "verse_number": "१-१९८-२४", "content_sanskrit": "एवं शप्त्वा तु राजानं सा तमाङ्गिरसी शुभा।\nतस्यैव सन्निधौ दीप्तं प्रविवेश हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009952, "chapter_id": 1197, "verse_number": "१-१९८-२५", "content_sanskrit": "वसिष्ठश्च महाभागः सर्वमेतदवैक्षत।\nज्ञानयोगेन महता तपसा च परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009953, "chapter_id": 1197, "verse_number": "१-१९८-२६", "content_sanskrit": "मुक्तशापश्च राजर्षिः कालेन महता ततः।\nऋतुकालेऽभिपतितो मदयन्त्या निवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009954, "chapter_id": 1197, "verse_number": "१-१९८-२७", "content_sanskrit": "न हि सस्मार स नृपस्तं शापं काममोहितः।\nदेव्याः सोऽथ वचः श्रुत्वा संभ्रान्तो नृपसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009955, "chapter_id": 1197, "verse_number": "१-१९८-२८", "content_sanskrit": "तं शापमनुसंस्मृत्य पर्यतप्यद्भृशं तदा।\nएतस्मात्कारणाद्राजा वसिष्ठं सन्ययोजयत्।\nस्वदारेषु नरश्रेष्ठ शापदोषसमन्वितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009956, "chapter_id": 1197, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि अष्टनवत्यधिकशततमोऽध्यायः॥ १९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]