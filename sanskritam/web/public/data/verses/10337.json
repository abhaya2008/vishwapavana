[{"id": 6000337000, "chapter_id": 10337, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000337001, "chapter_id": 10337, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.001.m4a", "display_order": 2}, {"id": 6000337002, "chapter_id": 10337, "verse_number": "१२-५-१", "content_sanskrit": "एतन्निशम्य मुनिनाऽभिहितं परीक्षिद् व्यासात्मजेन निखिलात्मदृशा समेन।\nतत्पादपद्ममुपसृत्य नतेन मूर्ध्ना बद्धाञ्जलिस्तमिदमाह स विष्णुरातः॥ १२/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.002.m4a", "display_order": 3, "topics": [{"text": "राज्ञाऽनुज्ञातस्य शुकाचार्यस्य गमनानुपदं तक्षकेण राज्ञो दंशनम्", "range": "१–६"}]}, {"id": 6000337003, "chapter_id": 10337, "verse_number": null, "content_sanskrit": "परीक्षिदुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.003.m4a", "display_order": 4}, {"id": 6000337004, "chapter_id": 10337, "verse_number": "१२-५-२", "content_sanskrit": "सिद्धोऽस्म्यनुगृहीतोऽस्मि भवता करुणात्मना।\nश्रावितो यच्च मे साक्षादनादिनिधनो हरिः॥ १२/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.004.m4a", "display_order": 5}, {"id": 6000337005, "chapter_id": 10337, "verse_number": "१२-५-३", "content_sanskrit": "नात्यद्भुतमिदं मन्ये महतामच्युतात्मनाम्।\nदीनेषु तापतप्तेषु भूतेषु यदनुग्रहः॥ १२/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.005.m4a", "display_order": 6}, {"id": 6000337006, "chapter_id": 10337, "verse_number": "१२-५-४", "content_sanskrit": "पुराणसंहितामेतामश्रौषं भवतो ह्यहम्।\nयस्यां खलूत्तमश्लोको भगवाननुवर्ण्यते॥ १२/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.006.m4a", "display_order": 7}, {"id": 6000337007, "chapter_id": 10337, "verse_number": "१२-५-५", "content_sanskrit": "भगवंस्तक्षकादिभ्यो मृत्युभ्यो न बिभेम्यहम्।\nप्रविष्टो ब्रह्म निर्वाणमभयं दर्शितं त्वया॥ १२/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.007.m4a", "display_order": 8}, {"id": 6000337008, "chapter_id": 10337, "verse_number": "१२-५-६", "content_sanskrit": "अनुजानीहि मां ब्रह्मन् वाचं यच्छाम्यधोक्षजे।\nमुक्तकामाशयं चेतः प्रवेक्ष्ये विसृजाम्यसून्॥ १२/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.008.m4a", "display_order": 9}, {"id": 6000337009, "chapter_id": 10337, "verse_number": "१२-५-७", "content_sanskrit": "अज्ञानं च निरस्तं मे ज्ञानविज्ञाननिष्ठया।\nभवता दर्शितं क्षेमं परं भगवतः पदम्॥ १२/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.009.m4a", "display_order": 10, "topics": [{"text": "परीक्षित्पुत्रेण जनमेजयेन सर्पसत्रकरणम्", "range": "६–२८"}]}, {"id": 6000337010, "chapter_id": 10337, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.010.m4a", "display_order": 11}, {"id": 6000337011, "chapter_id": 10337, "verse_number": "१२-५-८", "content_sanskrit": "इत्युक्तस्तमनुज्ञाय भगवान् बादरायणिः।\nजगाम भिक्षुभिः साकं नरदेवेन पूजितः॥ १२/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.011.m4a", "display_order": 12}, {"id": 6000337012, "chapter_id": 10337, "verse_number": "१२-५-९", "content_sanskrit": "परीक्षिदपि राजर्षिरात्मन्यात्मानमात्मना।\nसमाधाय परं दध्यावस्पन्दासुर्यथा तरुः॥ १२/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.012.m4a", "display_order": 13}, {"id": 6000337013, "chapter_id": 10337, "verse_number": "१२-५-१०", "content_sanskrit": "प्राक्कूले बर्हिष्यासीनो गङ्गाकूल उदङ्मुखः।\nब्रह्मभूतो महायोगी निःसङ्गश्छिन्नसंशयः॥ १२/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.013.m4a", "display_order": 14}, {"id": 6000337014, "chapter_id": 10337, "verse_number": "१२-५-११", "content_sanskrit": "तक्षकः प्रहितो विप्राः क्रुद्धेन द्विजसूनुना।\nहन्तुकामो नृपं गच्छन् ददर्श पथि काश्यपम्॥ १२/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.014.m4a", "display_order": 15}, {"id": 6000337015, "chapter_id": 10337, "verse_number": "१२-५-१२", "content_sanskrit": "तं तर्पयित्वा द्रविणैर्निवर्त्य विषहारिणम्।\nद्विजरूपप्रतिच्छन्नः कामरूपोऽदशन्नृपम्॥ १२/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.015.m4a", "display_order": 16}, {"id": 6000337016, "chapter_id": 10337, "verse_number": "१२-५-१३", "content_sanskrit": "ब्रह्मभूतस्य राजर्षेर्देहोऽहिगरलाग्निना।\nबभूव भस्मसात् सद्यः पश्यतां सर्वदेहिनाम्॥ १२/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.016.m4a", "display_order": 17}, {"id": 6000337017, "chapter_id": 10337, "verse_number": "१२-५-१४", "content_sanskrit": "हाहाकारो महानासीद् भुवि खे दिक्षु सर्वतः।\nविस्मिता अभवन् सर्वे देवासुरनरादयः॥ १२/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.017.m4a", "display_order": 18}, {"id": 6000337018, "chapter_id": 10337, "verse_number": "१२-५-१५", "content_sanskrit": "देवदुन्दुभयो नेदुर्गन्धर्वाप्सरसो जगुः।\nववृषुः पुष्पवर्षाणि विबुधाः साधुवादिनः॥ १२/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.018.m4a", "display_order": 19}, {"id": 6000337019, "chapter_id": 10337, "verse_number": "१२-५-१६", "content_sanskrit": "जनमेजयः स्वपितरं श्रुत्वा तक्षकभक्षितम्।\nअथाजुहाव सङ्क्रुद्धः सर्पान् सत्रे सह द्विजैः॥ १२/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.019.m4a", "display_order": 20}, {"id": 6000337020, "chapter_id": 10337, "verse_number": "१२-५-१७", "content_sanskrit": "सर्पसत्रे समिद्धेऽग्नौ दह्यमानान् महोरगान्।\nदृष्ट्वेन्द्रं भयसंविग्नस्तक्षकः शरणं ययौ॥ १२/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.020.m4a", "display_order": 21}, {"id": 6000337021, "chapter_id": 10337, "verse_number": "१२-५-१८", "content_sanskrit": "नापश्यत् तक्षकं तत्र राजा पारिक्षितो द्विजान्।\nउवाच तक्षकः कस्मान्न दह्येतोरगाधमः॥ १२/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.021.m4a", "display_order": 22}, {"id": 6000337022, "chapter_id": 10337, "verse_number": "१२-५-१९", "content_sanskrit": "तं गोपायति राजेन्द्र इन्द्रः शरणमागतम्।\nतेन संस्तम्भितः सर्पस्तस्मान्नाग्नौ पतत्यसौ॥ १२/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.022.m4a", "display_order": 23}, {"id": 6000337023, "chapter_id": 10337, "verse_number": "१२-५-२०", "content_sanskrit": "पारिक्षित इति श्रुत्वा प्राहर्त्विज उदारधीः।\nसहेन्द्रस्तक्षको विप्रा नाग्नौ किमिति पात्यते॥ १२/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.023.m4a", "display_order": 24}, {"id": 6000337024, "chapter_id": 10337, "verse_number": "१२-५-२१", "content_sanskrit": "तच्छ्रुत्वा जुहुवुर्विप्राः सहेन्द्रं तक्षकं मखे।\nतक्षकाशु पतस्वेह सहेन्द्रेण मरुत्वता॥ १२/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.024.m4a", "display_order": 25}, {"id": 6000337025, "chapter_id": 10337, "verse_number": "१२-५-२२", "content_sanskrit": "इति ब्रह्मोदिताक्षेपैः स्थानादिन्द्रः प्रचालितः।\nबभूव सम्भ्रान्तमतिः सविमानः सतक्षकः॥ १२/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.025.m4a", "display_order": 26}, {"id": 6000337026, "chapter_id": 10337, "verse_number": "१२-५-२३", "content_sanskrit": "तं पतन्तं विमानेन सहतक्षकमम्बरात्।\nविलोक्याङ्गिरसः प्राह राजानं तं बृहस्पतिः॥ १२/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.026.m4a", "display_order": 27}, {"id": 6000337027, "chapter_id": 10337, "verse_number": "१२-५-२४", "content_sanskrit": "नैष त्वया मनुष्येन्द्र वधमर्हति सर्पराट्।\nअनेन पीतममृतमथायमजरामरः॥ १२/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.027.m4a", "display_order": 28}, {"id": 6000337028, "chapter_id": 10337, "verse_number": "१२-५-२५", "content_sanskrit": "जीवितं मरणं जन्तोर्गतिः स्वेनैव कर्मणा।\nराजंस्तेन विना नान्यो प्रदाता सुखदुःखयोः॥ १२/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.028.m4a", "display_order": 29}, {"id": 6000337029, "chapter_id": 10337, "verse_number": "१२-५-२६", "content_sanskrit": "सर्पचोरादिवह्न्यम्बुक्षुत्तृड्व्याध्यादिभिर्नृप।\nपञ्चत्वमृच्छते जन्तुर्भुङ्क्त आरब्धकर्म च॥ १२/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.029.m4a", "display_order": 30}, {"id": 6000337030, "chapter_id": 10337, "verse_number": "१२-५-२७", "content_sanskrit": "तस्मात् सत्रमिदं राजन् संस्थीयेताभिचारिकम्।\nसर्पा अनागसो दग्धा जनैर्दिष्टं हि भुज्यते॥ १२/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.030.m4a", "display_order": 31}, {"id": 6000337031, "chapter_id": 10337, "verse_number": "१२-५-२८", "content_sanskrit": "इत्युक्तः स तथेत्याह महर्षेर्मानयन् वचः।\nसर्पसत्रादुपरतः पूजयामास वाक्पतिम्॥ १२/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.031.m4a", "display_order": 32}, {"id": 6000337032, "chapter_id": 10337, "verse_number": "१२-५-२९", "content_sanskrit": "सैषा विष्णोर्महामाया बाध्यबाधकलक्षणा।\nयया मुह्यत्यसावात्मा भूतेषु गुणवृत्तिभिः॥ १२/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.032.m4a", "display_order": 33}, {"id": 6000337033, "chapter_id": 10337, "verse_number": "१२-५-३०", "content_sanskrit": "न यत्र दुर्भाव्यतया विराजते मायात्मवादेऽसकृदात्मवादिभिः।\nन यद्विवादो विविधस्तदाश्रयो मनश्च संकल्पविकल्पवृत्ति यत्॥ १२/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.033.m4a", "display_order": 34}, {"id": 6000337034, "chapter_id": 10337, "verse_number": "१२-५-३१", "content_sanskrit": "न यत्र सृज्यं सृजतोभयोः परं श्रेयश्च जीवस्त्रिभिरन्वितः स्वयम्।\nतदेतदुत्सादितबाध्यबाधकं निषिध्य चोर्मीन् विरमेत तन्मुनिः॥ १२/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.034.m4a", "display_order": 35}, {"id": 6000337035, "chapter_id": 10337, "verse_number": "१२-५-३२", "content_sanskrit": "परं पदं वैष्णवमामनन्ति यन्नेतिनेतीत्यतदुत्सिसृक्षवः।\nविसृज्य दौरात्म्यमनन्यसौहृदा हृदोपगुह्यावसितं समाहितैः॥ १२/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.035.m4a", "display_order": 36}, {"id": 6000337036, "chapter_id": 10337, "verse_number": "१२-५-३३", "content_sanskrit": "तदेतदधिगच्छन्ति विष्णोर्यत् परमं पदम्।\nअहं ममेति दौर्जन्यं न येषां देहगेहजम्॥ १२/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.036.m4a", "display_order": 37}, {"id": 6000337037, "chapter_id": 10337, "verse_number": "१२-५-३४", "content_sanskrit": "अतिवादांस्तितिक्षेत नावमंस्येत कञ्चन।\nन चेमं देहमाश्रित्य वैरं कुर्वीत केनचित्॥ १२/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.037.m4a", "display_order": 38}, {"id": 6000337038, "chapter_id": 10337, "verse_number": "१२-५-३५", "content_sanskrit": "नमो भगवते तस्मै कृष्णायाकुण्ठमेधसे।\nयत्पादाम्बुरुहध्यानात्संहितामध्यगामिमाम्॥ १२/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_005/BhP_12.005.038.m4a", "display_order": 39}, {"id": 6000337039, "chapter_id": 10337, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]