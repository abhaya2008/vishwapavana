[{"id": 6000090000, "chapter_id": 10090, "verse_number": null, "content_sanskrit": "अथ षड्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000090001, "chapter_id": 10090, "verse_number": null, "content_sanskrit": "नारद उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.001.m4a", "display_order": 2}, {"id": 6000090002, "chapter_id": 10090, "verse_number": "४-२६-१", "content_sanskrit": "स एकदा महेष्वासो रथं पञ्चाश्वमाशुगम्।\nद्विकर्मचक्रमेकाक्षं त्रिवेणुं पञ्चबन्धुरम्॥ ४/२६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.002.m4a", "display_order": 3, "topics": [{"text": "पुरञ्‍जनस्य मृगयार्थं वनगमनम्", "range": "१–११"}]}, {"id": 6000090003, "chapter_id": 10090, "verse_number": "४-२६-२", "content_sanskrit": "एकरश्म्येकदमनमेकनीडं द्विकूबरम्।\nपञ्चप्रहरणं सप्तवरूथं पञ्चविक्रमम्॥ ४/२६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.003.m4a", "display_order": 4}, {"id": 6000090004, "chapter_id": 10090, "verse_number": "४-२६-३", "content_sanskrit": "हेमोपस्करमारुह्य स्वर्णवर्माक्षयेषुधिः।\nएकादशचमूनाथः पञ्चप्रस्थमगाद् वनम्॥ ४/२६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.004.m4a", "display_order": 5}, {"id": 6000090005, "chapter_id": 10090, "verse_number": "४-२६-४", "content_sanskrit": "चचार मृगयां तत्र दृप्त आत्तेषुकार्मुकः।\nविहाय जायामतदर्हां मृगव्यसनलालसः॥ ४/२६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.005.m4a", "display_order": 6}, {"id": 6000090006, "chapter_id": 10090, "verse_number": "४-२६-५", "content_sanskrit": "आसुरीं वृत्तिमाश्रित्य घोरात्मा निरनुग्रहः।\nन्यहनन्निशितैर्बाणैर्वनेषु वनगोचरान्॥ ४/२६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.006.m4a", "display_order": 7}, {"id": 6000090007, "chapter_id": 10090, "verse_number": "४-२६-६", "content_sanskrit": "तीर्थेषु श्रुतिदृष्टेषु राजा मेध्यान् पशून् वने।\nयावदर्थमलं लुब्धो हन्यादिति नियम्यते॥ ४/२६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.007.m4a", "display_order": 8}, {"id": 6000090008, "chapter_id": 10090, "verse_number": "४-२६-७", "content_sanskrit": "य एवं कर्म नियतं विद्वान् कुर्वीत वा न वा।\nकर्मणा तेन राजेन्द्र ज्ञानेन स न लिप्यते॥ ४/२६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.008.m4a", "display_order": 9}, {"id": 6000090009, "chapter_id": 10090, "verse_number": "४-२६-८", "content_sanskrit": "अन्यथा कर्म कुर्वाणः कामारूढो निबध्यते।\nगुणप्रवाहपतितो नष्टप्रज्ञो व्रजत्यधः॥ ४/२६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.009.m4a", "display_order": 10}, {"id": 6000090010, "chapter_id": 10090, "verse_number": "४-२६-९", "content_sanskrit": "तत्र निर्भिण्णगात्राणां चित्रवाजैः शिलीमुखैः।\nविप्लवोऽभूद् दुःखितानां दुस्सहः करुणात्मनाम्॥ ४/२६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.010.m4a", "display_order": 11}, {"id": 6000090011, "chapter_id": 10090, "verse_number": "४-२६-१०", "content_sanskrit": "शशान्वराहान्महिषान् गवयान् रुरुशल्यकान्।\nमेध्यानन्यांश्च विविधान् विनिघ्नन् श्रममध्यगात्॥ ४/२६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.011.m4a", "display_order": 12}, {"id": 6000090012, "chapter_id": 10090, "verse_number": "४-२६-११", "content_sanskrit": "ततः क्षुत्तृट्‌परिश्रान्तो निवृत्तो गृहमेयिवान्।\nकृतस्नानोचिताहारः संविवेश गतक्लमः॥ ४/२६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.012.m4a", "display_order": 13}, {"id": 6000090013, "chapter_id": 10090, "verse_number": "४-२६-१२", "content_sanskrit": "आत्मानमर्हयाञ्चक्रे धूपलेपस्रगादिभिः।\nसाध्वलंकृतसर्वाङ्गो महिष्यामादधे मनः॥ ४/२६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.013.m4a", "display_order": 14, "topics": [{"text": "वनान्निवृत्तेन तेन क्रुद्धायाः स्वमडिष्याः सान्‍त्वनम्", "range": "१२–२६"}]}, {"id": 6000090014, "chapter_id": 10090, "verse_number": "४-२६-१३", "content_sanskrit": "तृप्तो हृष्टः सुदृप्तश्च कन्दर्पाकृष्टमानसः।\nन व्यचष्ट वरारोहां गृहिणीं गृहमेधिनीम्॥ ४/२६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.014.m4a", "display_order": 15}, {"id": 6000090015, "chapter_id": 10090, "verse_number": "४-२६-१४", "content_sanskrit": "अन्तःपुरस्‍त्रियोऽपृच्छद् विमना इव वेदिषन्।\nअपि वः कुशलं रामाः सेश्वरीणां यथा पुरा॥ ४/२६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.015.m4a", "display_order": 16}, {"id": 6000090016, "chapter_id": 10090, "verse_number": "४-२६-१५", "content_sanskrit": "न तथैतर्हि रोचन्ते गृहेषु गृहसम्पदः।\nयदि न स्याद् गृहे माता पत्नी वा पतिदेवता॥ ४/२६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.016.m4a", "display_order": 17}, {"id": 6000090017, "chapter_id": 10090, "verse_number": "४-२६-१६", "content_sanskrit": "व्यङ्गे रथ इव प्राज्ञः को नामासीत दीनवत्।क्‍व वर्तते सा ललना मज्जन्तं व्यसनार्णवे।\nया मामुद्धरति प्रज्ञां दीपयन्ती पदे पदे॥ ४/२६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.017.m4a", "display_order": 18}, {"id": 6000090018, "chapter_id": 10090, "verse_number": null, "content_sanskrit": "रामा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.018.m4a", "display_order": 19}, {"id": 6000090019, "chapter_id": 10090, "verse_number": "४-२६-१७", "content_sanskrit": "नरनाथ न जानीमस्त्वत्प्रिया यद् व्यवस्यति।\nभूतले निरवस्तारे शयानां पश्य शत्रुहन्॥ ४/२६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.019.m4a", "display_order": 20}, {"id": 6000090020, "chapter_id": 10090, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.020.m4a", "display_order": 21}, {"id": 6000090021, "chapter_id": 10090, "verse_number": "४-२६-१८", "content_sanskrit": "पुरञ्जनः स्वमहिषीं निरीक्ष्यावधुतां भुवि।\nतत्सङ्गोन्मथितज्ञानो वैक्लव्यं परमं ययौ॥ ४/२६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.021.m4a", "display_order": 22}, {"id": 6000090022, "chapter_id": 10090, "verse_number": "४-२६-१९", "content_sanskrit": "सान्त्वयन् श्लक्ष्णया वाचा हृदयेन विदूयता।\nप्रेयस्याः प्रेमसंरम्भलिङ्गमात्मनि नाध्यगात्॥ ४/२६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.022.m4a", "display_order": 23}, {"id": 6000090023, "chapter_id": 10090, "verse_number": "४-२६-२०", "content_sanskrit": "अनुनिन्येऽथ शनकैर्वीरोऽनुनयकोविदः।\nपस्पर्श पादयुगलमाह चोत्सङ्गलालिताम्॥ ४/२६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.023.m4a", "display_order": 24}, {"id": 6000090024, "chapter_id": 10090, "verse_number": "४-२६-२१", "content_sanskrit": "नूनं त्वकृतपुण्यास्ते भृत्या येष्वीश्वराः शुभे।\nकृतागस्स्वात्मसात् कृत्वा शिक्षादण्डं न युञ्जते॥ ४/२६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.024.m4a", "display_order": 25}, {"id": 6000090025, "chapter_id": 10090, "verse_number": "४-२६-२२", "content_sanskrit": "परमानुग्रहो दण्डो भृत्येषु प्रभुणाऽर्पितः।\nबालो न वेद तत् तन्वि बन्धुकृत्यममर्षणः॥ ४/२६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.025.m4a", "display_order": 26}, {"id": 6000090026, "chapter_id": 10090, "verse_number": "४-२६-२३", "content_sanskrit": "सा त्वं मुखं सुदति सुभ्र्वनुरागभारव्रीडाविलम्बविलसद्धसितावलोकम्।\nनीलालकालिभिरुपस्कृतमुन्नसं नः स्वानां प्रदर्शय मनस्विनि वल्गुवाक्यम्॥ ४/२६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.026.m4a", "display_order": 27}, {"id": 6000090027, "chapter_id": 10090, "verse_number": "४-२६-२४", "content_sanskrit": "तस्मिन् दधे दममहं तव वीरपत्नि योऽन्यत्र भूसुरकुलात् कृतकिल्बिषस्तम्।\nपश्ये न वीतभयमुन्मुदितं त्रिलोक्यां क्रुद्धस्य वै मुररिपोरितरत्र दासात्॥ ४/२६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.027.m4a", "display_order": 28}, {"id": 6000090028, "chapter_id": 10090, "verse_number": "४-२६-२५", "content_sanskrit": "वक्त्रं न ते वितिलकं मलिनं विहर्षं संरम्भभीममविमृष्टमपेतरागम्।\nपश्ये स्तनावपि शुचोपहतौ सुजातौ बिम्बाधरं विगतकुङ्कुमपङ्करागम्॥ ४/२६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.028.m4a", "display_order": 29}, {"id": 6000090029, "chapter_id": 10090, "verse_number": "४-२६-२६", "content_sanskrit": "तन्मे प्रसीद सुहृदः कृतकिल्बिषस्य स्वैरं गतस्य मृगयां व्यसनातुरस्य।\nका देवरं वशगतं कुसुमास्‍त्रवेगविस्रस्तपौंस्यमुशती न भजेत कृत्ये॥ ४/२६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_026/BhP_04.026.029.m4a", "display_order": 30}, {"id": 6000090030, "chapter_id": 10090, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे षड्विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]