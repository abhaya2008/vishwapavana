[{"id": 2195919, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195920, "chapter_id": 5176, "verse_number": "१", "content_sanskrit": "मित्रसौहृदभावेन उपदेशं करोति यः ।\nजात्याऽवरस्य राजर्षे दोषस्तस्य भवेन्न वा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195921, "chapter_id": 5176, "verse_number": "२", "content_sanskrit": "एतदिच्छामि तत्त्वेन व्याख्यातुं वै पितामह ।\nसूक्ष्मा गतिर्हि धर्मस्य यत्र मुह्यन्ति मानवाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195922, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195923, "chapter_id": 5176, "verse_number": "३", "content_sanskrit": "अत्र ते वर्तयिष्यामि शृणु राजन् यथागमम् ।\nऋषीणां वदतां श्रेष्ठ श्रुतमासीद् यथा मया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195924, "chapter_id": 5176, "verse_number": "४", "content_sanskrit": "उपदेशो न कर्तव्यो जातिहीनस्य कस्यचित् ।\nउपदेशे महान् दोष उपाध्यायस्य भाष्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195925, "chapter_id": 5176, "verse_number": "५", "content_sanskrit": "निदर्शनमिदं राजन् शृणु मे भरतर्षभ ।\nदुरुक्तवचने राजन् यथा पूर्वं युधिष्ठिर ।\nब्रह्माश्रमपदे वृत्तं पार्श्वे हिमवतः शुभे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195926, "chapter_id": 5176, "verse_number": "६", "content_sanskrit": "तत्राश्रमपदं पुण्यं नानावृक्षगणायुतम् ।\nबहुगुल्मलताकीर्णं मृगद्विजनिषेवितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195927, "chapter_id": 5176, "verse_number": "७", "content_sanskrit": "सिद्धचारणसङ्घुष्टं रम्यं पुष्पितकाननम् ।\nव्रतिभिर्बहुभिः कीर्णं तापसैरुपशोभितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195928, "chapter_id": 5176, "verse_number": "८", "content_sanskrit": "ब्राह्मणैश्च महाभागैः सूर्यज्वलनसन्निभैः ।\nनियमव्रतसम्पन्नैः समाकीर्णं तपस्विभिः ।\nदीक्षितैर्भरतश्रेष्ठ यताहारैः कृतात्मभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195929, "chapter_id": 5176, "verse_number": "९", "content_sanskrit": "वेदाध्ययनघोषैश्च नादितं भरतर्षभ ।\nवालखिल्यैश्च बहुभिर्यतिभिश्च निषेवितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195930, "chapter_id": 5176, "verse_number": "१०", "content_sanskrit": "तत्र कश्चित् समुत्साहं कृत्वा शूद्रो दयान्वितः ।\nआगतो ह्याश्रमपदं पूजितश्च तपस्विभिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195931, "chapter_id": 5176, "verse_number": "११", "content_sanskrit": "तांस्तु दृष्ट्वा मुनिगणान् देवकल्पान् महौजसः ।\nवहतो विविधा दीक्षाः सम्प्राहृष्यत भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195932, "chapter_id": 5176, "verse_number": "१२", "content_sanskrit": "अथास्य बुद्धिरभवत् तपस्ये भरतर्षभ ।\nततोऽब्रवीत् कुलपतिं पादौ सङ्गृह्य भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195933, "chapter_id": 5176, "verse_number": "१३", "content_sanskrit": "भवत्प्रसादादिच्छामि धर्मं चर्तुं द्विजर्षभ ।\nतन्मां त्वं भगवन् वक्तुं प्रव्राजयितुमर्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195934, "chapter_id": 5176, "verse_number": "१४", "content_sanskrit": "वर्णावरोऽहं भगवन् शूद्रो जात्यास्मि सत्तम ।\nशिश्रूषां कर्तुमिच्छामि प्रपन्नाय प्रसीद मे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195935, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "कुलपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195936, "chapter_id": 5176, "verse_number": "१५", "content_sanskrit": "न शक्यमिह शूद्रेण लिङ्गमाश्रित्य वर्तितुम् ।\nरम्यतां यदि ते बुद्धिः शिश्रूषानिरतो भव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195937, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195938, "chapter_id": 5176, "verse_number": "१६", "content_sanskrit": "एवमुक्तस्तु मुनिना स शूद्रोऽचिन्तयन्नृप ।\nकथमत्र मया कार्यं श्रद्धा धर्मे परा च मे ।\nविज्ञातमेवं भवतु करिष्ये प्रियमात्मनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195939, "chapter_id": 5176, "verse_number": "१७", "content_sanskrit": "गत्वाऽश्रमपदाद् दूरमुटजं कृतवांस्तु सः ।\nतत्र वेदिं च भूमिं च देवतायतनानि च ।\nनिवेश्य भरतश्रेष्ठ नियमस्थोऽभवत् सुखम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195940, "chapter_id": 5176, "verse_number": "१८", "content_sanskrit": "अभिषेकांश्च नियमान् देवतायतनेषु च ।\nबलिं च कृत्वा हुत्वा च देवतां चाप्यपूजयत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195941, "chapter_id": 5176, "verse_number": "१९", "content_sanskrit": "सङ्कल्पनियमोपेतः फलाहारो जितेन्द्रियः ।\nनित्यं सन्निहिताभिश्च ओषधीभिः फलैस्तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195942, "chapter_id": 5176, "verse_number": "२०", "content_sanskrit": "अतिथीन् पूजयामास यथावत् समुपागतान् ।\nएवं हि सुमहान् कालो व्यत्यक्रामत् स तस्य वै\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195943, "chapter_id": 5176, "verse_number": "२१", "content_sanskrit": "अथास्य मुनिरागच्छत् सङ्गत्या वै तमाश्रमम् ।\nसम्पूज्य स्वागतेनर्षिं विधिवत् पर्यतोषयत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195944, "chapter_id": 5176, "verse_number": "२२", "content_sanskrit": "अनुकूलाः कथाः कृत्वा यथावत् पर्यपृच्छत ।\nऋषिः परमतेजस्वी धर्मात्मा संयतेन्द्रियः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195945, "chapter_id": 5176, "verse_number": "२३", "content_sanskrit": "एवं स बहुशस्तस्य शूद्रस्य भरतर्षभ ।\nसोऽगच्छदाश्रममृषिः शूद्रं द्रष्टुं नरर्षभ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195946, "chapter_id": 5176, "verse_number": "२४", "content_sanskrit": "अथ तं तापसं शूद्रः सोऽब्रवीद् भरतर्षभ ।\nपितृकार्यं करिष्यामि तत्र मेऽनुग्रहं कुरु\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195947, "chapter_id": 5176, "verse_number": "२५", "content_sanskrit": "बाढमित्येव तं विप्र उवाच भरतर्षभ ।\nमुनिर्भूत्वा स शूद्रस्तु तस्यर्षेः पाद्यमानयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195948, "chapter_id": 5176, "verse_number": "२६", "content_sanskrit": "अथ दर्भांश्च वन्याश्च ओषधीर्भरतर्षभ ।\nपवित्रमासनं चैव बृसीं च समुपानयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195949, "chapter_id": 5176, "verse_number": "२७", "content_sanskrit": "अथ दक्षिणमाश्रित्य बृसीं पश्चिमशीर्षिकाम् ।\nकृतामन्यायतो दृष्ट्वा ततस्तमृषिरब्रवीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2195950, "chapter_id": 5176, "verse_number": "२८", "content_sanskrit": "कुरुष्वैतां पूर्वशीर्षां भव चोदङ्मुखः शुचिः ।\nस च तत्कृतवान् शूद्रः सर्वं यदृषिरब्रवीत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2195951, "chapter_id": 5176, "verse_number": "२९", "content_sanskrit": "यथोपदिष्टं मेधावी दर्भादींस्तान्यथातथम् ।\nहव्यकव्यविधिं कृत्स्नमुक्तं तेन तपस्विना\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2195952, "chapter_id": 5176, "verse_number": "३०", "content_sanskrit": "ऋषिणा पितृकार्ये च यथा धर्मपथि स्थितः ।\nपितृकार्ये कृते चापि विसृष्टः स जगाम ह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2195953, "chapter_id": 5176, "verse_number": "३१", "content_sanskrit": "अथ दीर्घस्य कालस्य स तप्यन् शूद्रतापसः ।\nवने पञ्चत्वमगमत् सुकृतेन च तेन वै ।\nअजायत महाराज राजवंशे महाद्युतिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2195954, "chapter_id": 5176, "verse_number": "३२", "content_sanskrit": "तथैव स ऋषिस्तात कालधर्ममवाप्य ह ।\nपुरोहितकुले विप्रः स जातो भरतर्षभ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2195955, "chapter_id": 5176, "verse_number": "३३", "content_sanskrit": "एवं तौ तत्र सम्भूतावुभौ शूद्रमुनी तदा ।\nक्रमेण वर्धितौ चापि विद्यासु कुशलावुभौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2195956, "chapter_id": 5176, "verse_number": "३४", "content_sanskrit": "अथर्ववेदे वेदे च बभूवर्षिः सुनिश्चितः ।\nकल्पप्रयोगे चोत्पन्ने ज्यौतिषे च परं गतः ।\nसख्ये चापि परा प्रीतिस्तयोश्चापि व्यवर्धत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2195957, "chapter_id": 5176, "verse_number": "३५", "content_sanskrit": "पितर्युपरते चापि कृतशौचः स भारत ।\nअभिषिक्तः प्रकृतिभी राजपुत्रः स पार्थिवः ।\nअभिषिक्तेन स ऋषिरभिषिक्तः पुरोहितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2195958, "chapter_id": 5176, "verse_number": "३६", "content_sanskrit": "स तं पुरोधाय सुखमवसद् भरतर्षभ ।\nराज्यं शशास धर्मेण प्रजाश्च परिपालयन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2195959, "chapter_id": 5176, "verse_number": "३७", "content_sanskrit": "पुण्याहवाचने नित्यं धर्मकार्येषु चासकृत् ।\nउत्स्मयन् प्राहसच्चापि दृष्ट्वा राजा पुरोधसम् ।\nएवं स बहुशो राजन् पुरोधसमुपाहसत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2195960, "chapter_id": 5176, "verse_number": "३८", "content_sanskrit": "लक्षयित्वा पुरोधास्तु बहुशस्तं नराधिपम् ।\nउत्स्मयन्तं च सततं दृष्ट्वाऽसौ मन्युमानभूत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2195961, "chapter_id": 5176, "verse_number": "३९", "content_sanskrit": "अथ शून्ये पुरोधास्तु सह राज्ञा समागतः ।\nकथाभिरनुकूलाभी राजानमभिरामयत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2195962, "chapter_id": 5176, "verse_number": "४०", "content_sanskrit": "ततोऽब्रवीन्नरेन्द्रं स पुरोधा भरतर्षभ ।\nवरमिच्छाम्यहं त्वेकं त्वया दत्तं महाद्युते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2195963, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2195964, "chapter_id": 5176, "verse_number": "४१", "content_sanskrit": "वराणां ते शतं दद्यां किमुतैकं द्विजोत्तम ।\nस्नेहाच्च बहुमानाच्च नास्त्यदेयं हि मे तव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2195965, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "पुरोहितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2195966, "chapter_id": 5176, "verse_number": "४२", "content_sanskrit": "एकं वै वरमिच्छामि यदि तुष्टोऽसि पार्थिव ।\nयद् ददासि महाराज सत्यं तद् वद मानृतम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2195967, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2195968, "chapter_id": 5176, "verse_number": "४३", "content_sanskrit": "बाढमित्येव तं राजा प्रत्युवाच युधिष्ठिर ।\nयदि ज्ञास्यामि वक्ष्यामि अजानन्न तु संवदे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2195969, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "पुरोहितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2195970, "chapter_id": 5176, "verse_number": "४४", "content_sanskrit": "पुण्याहवाचने नित्यं धर्मकृत्येषु चासकृत् ।\nशान्तिहोमेषु च सदा किं त्वं हससि वीक्ष्य माम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2195971, "chapter_id": 5176, "verse_number": "४५", "content_sanskrit": "सव्रीडं वै भवति हि मनो मे हसता त्वया ।\nकामया शापितो राजन् नान्यथा वक्तुमर्हसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2195972, "chapter_id": 5176, "verse_number": "४६", "content_sanskrit": "भाव्यं हि कारणेनात्र न ते हास्यमकारणम् ।\nकौतूहलं मे सुभृशं तत्त्वेन कथयस्व मे\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2195973, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2195974, "chapter_id": 5176, "verse_number": "४७", "content_sanskrit": "एवमुक्ते त्वया विप्र यदवाच्यं भवेदपि ।\nअवश्यमेव वक्तव्यं शृणुष्वैकमना द्विज\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2195975, "chapter_id": 5176, "verse_number": "४८", "content_sanskrit": "पूर्वदेहे यथा वृत्तं तन्निबोध द्विजोत्तम ।\nजातिं स्मराम्यहं ब्रह्मन्नवधानेन मे शृणु\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2195976, "chapter_id": 5176, "verse_number": "४९", "content_sanskrit": "शूद्रोऽहमभवं पूर्वं तापसे कृतनिश्चयः ।\nऋषिरुग्रतपास्त्वं च तदाऽभूर्द्विजसत्तम\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2195977, "chapter_id": 5176, "verse_number": "५०", "content_sanskrit": "प्रीयता हि तदा ब्रह्मन् ममानुग्रहबुद्धिना ।\nपितृकार्ये त्वया पूर्वमुपदेशः कृतोऽनघ ।\nबृस्यां दर्भेषु हव्ये च कव्ये च मुनिसत्तम\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2195978, "chapter_id": 5176, "verse_number": "५१", "content_sanskrit": "एतेन कर्मदोषेण पुरोधास्त्वमजायथाः ।\nअहं राजा च विप्रेन्द्र पश्य कालस्य पर्ययम् ।\nमत्कृते ह्युपदेशेन त्वया प्राप्तमिदं फलम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2195979, "chapter_id": 5176, "verse_number": "५२", "content_sanskrit": "एतस्मात् कारणाद् ब्रह्मन् प्रहसे त्वां द्विजोत्तम ।\nन त्वां परिभवन् ब्रह्मन् प्रहसामि गुरुर्भवान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2195980, "chapter_id": 5176, "verse_number": "५३", "content_sanskrit": "विपर्ययेण मे मन्युस्तेन सन्तप्यते मनः ।\nजातिं स्मराम्यहं तुभ्यमतस्त्वां प्रहसामि वै\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2195981, "chapter_id": 5176, "verse_number": "५४", "content_sanskrit": "एवं तवोग्रं हि तप उपदेशेन नाशितम् ।\nपुरोहितत्वमुत्सृज्य यतस्व त्वं पुनर्भवे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2195982, "chapter_id": 5176, "verse_number": "५५", "content_sanskrit": "इतस्त्वमधमामन्यां मा योनिं प्राप्स्यसे द्विज ।\nगृह्यतां द्रविणं विप्र पूतात्मा भव सत्तम\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2195983, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2195984, "chapter_id": 5176, "verse_number": "५६", "content_sanskrit": "ततो विसृष्टो राज्ञा तु विप्रो दानान्यनेकशः ।\nब्राह्मणेभ्यो ददौ वित्तं भूमिं ग्रामांश्च सर्वशः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2195985, "chapter_id": 5176, "verse_number": "५७", "content_sanskrit": "कृच्छ्राणि चीर्त्वा च ततो यथोक्तानि द्विजोत्तमः ।\nतीर्थानि चाभिगत्वा वै दानानि विविधानि च\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2195986, "chapter_id": 5176, "verse_number": "५८", "content_sanskrit": "दत्त्वा गाश्चैव सर्वेभ्यः पूतात्माऽभवदात्मवान् ।\nतमेव चाश्रमं गत्वा चचार विपुलं तपः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2195987, "chapter_id": 5176, "verse_number": "५९", "content_sanskrit": "ततः सिद्धि परां प्राप्तो ब्राह्मणो राजसत्तम ।\nसम्मतश्चाभवत् तेषामाश्रमेऽऽश्रमवासिनाम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2195988, "chapter_id": 5176, "verse_number": "६०", "content_sanskrit": "एवं प्राप्तो महत्कृच्छ्रमृषिः स नृपसत्तम ।\nब्राह्मणेन न वक्तव्यं तस्माद् वर्णावरे जने\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2195989, "chapter_id": 5176, "verse_number": "६१", "content_sanskrit": "वर्जयेदुपदेशं च सदैव ब्राह्मणो नृप ।\nउपदेशं हि कुर्वाणो द्विजः कृच्छ्रमवाप्नुयात्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2195990, "chapter_id": 5176, "verse_number": "६२", "content_sanskrit": "एषितव्यं सदा वाचा नृपेण द्विजसत्तमात् ।\nन प्रवक्तव्यमिह हि किञ्चिद् वर्णावरे जने\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2195991, "chapter_id": 5176, "verse_number": "६३", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्यास्त्रयो वर्णा द्विजातयः ।\nएतेषु कथयन् राजन् ब्राह्मणो न प्रदुष्यति\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2195992, "chapter_id": 5176, "verse_number": "६४", "content_sanskrit": "तस्मात् सद्भिर्न वक्तव्यं कस्यचित् किञ्चिदग्रतः ।\nसूक्ष्मा गतिर्हि धर्मस्य दुर्ज्ञेया ह्यकृतात्मभिः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2195993, "chapter_id": 5176, "verse_number": "६५", "content_sanskrit": "तस्मान्मौनानि मुनयो दीक्षां कुर्वन्ति चादृताः ।\nदुरुक्तस्य भयाद् राजन् नानुभाषन्ति किञ्चन\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2195994, "chapter_id": 5176, "verse_number": "६६", "content_sanskrit": "धार्मिका गुणसम्पन्नाः सत्यार्जवपरायणाः ।\nदुरुक्तवाचाऽभिहताः प्राप्नुवन्तीह दुष्कृतम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2195995, "chapter_id": 5176, "verse_number": "६७", "content_sanskrit": "उपदेशो न कर्तव्यः कदाचिदपि कस्यचित् ।\nउपदेशाद्धि तत्पापं ब्राह्मणः समवाप्नुयात्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2195996, "chapter_id": 5176, "verse_number": "६८", "content_sanskrit": "विमृश्य तस्मात् प्राज्ञेन वक्तव्यं धर्ममिच्छता ।\nसत्यानृतेन हि कृत उपदेशो हिनस्ति वै\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2195997, "chapter_id": 5176, "verse_number": "६९", "content_sanskrit": "वक्तव्यमिह पृष्टेन विनिश्चित्य विपर्ययम् ।\nस चोपदेशः कर्तव्यो येन धर्ममवाप्नुयात्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2195998, "chapter_id": 5176, "verse_number": "७०", "content_sanskrit": "एतत् ते सर्वमाख्यातमुपदेशे कृते सति ।\nमहान् क्लेशो हि भवति तस्मान्नोपदिशेत् क्वचित्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2195999, "chapter_id": 5176, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे वर्णावरे उपदेशोपाख्यानं नाम सप्तविंशोऽध्यायः ॥२७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]