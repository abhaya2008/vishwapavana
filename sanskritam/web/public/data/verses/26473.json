[{"id": 7006473000, "chapter_id": 26473, "verse_number": "३-१२-१", "content_sanskrit": "स्रष्टारं सर्वभूतानां ब्रह्माणं सर्वतोमुखम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006473001, "chapter_id": 26473, "verse_number": "३-१२-२", "content_sanskrit": "तस्मिन् हिरण्मये पद्मे बहुयोजनविस्तृते ।\nसर्वतेजोगुणमये पार्थिवैलक्षणैर्युते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006473002, "chapter_id": 26473, "verse_number": "३-१२-३", "content_sanskrit": "तच्च पद्मं पुराणज्ञाः पृथिवीरुहमुत्तमम् नारायणाङ्गसम्भूतं प्रवदन्ति महर्षयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006473003, "chapter_id": 26473, "verse_number": "३-१२-४", "content_sanskrit": "या तु पद्मासना देवी पृथिवीं ताँ प्रचक्षते ।\nये गर्भसाराङ्कुरतस्तान् दिव्यान् पर्वतान् विदुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006473004, "chapter_id": 26473, "verse_number": "३-१२-५", "content_sanskrit": "हिमवन्तं च मेरुं च नीलं निषधमेव च ।\nकैलासं मुञ्जवन्तं च तथाद्रिं गन्धमादनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006473005, "chapter_id": 26473, "verse_number": "३-१२-६", "content_sanskrit": "पुण्यं त्रिशिखरं चैव कान्तं मन्दरमेव च ॥। उदयं कन्दरं चैव विन्ध्यमस्तं च पर्वतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006473006, "chapter_id": 26473, "verse_number": "३-१२-७", "content_sanskrit": "एते देवगणानां च सिद्धानां च महात्मनाम् ।\nआश्रमाः पुण्यशीलानां सर्वकामयुताद्रयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006473007, "chapter_id": 26473, "verse_number": "३-१२-८", "content_sanskrit": "एतेषामन्तरो देशो जम्बूद्वीप इति स्मृतः ।\nजम्बूद्वीपस्य संख्यानं याज्ञिया यत्र चक्रिरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006473008, "chapter_id": 26473, "verse_number": "३-१२-९", "content_sanskrit": "गर्भाद् यत् स्रवते तोयं देवामृतरसोपमम् ।\nदिव्यतीर्थशतापाङ्ग्यस्ता दिव्याः सरितः स्मृताः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006473009, "chapter_id": 26473, "verse_number": "३-१२-१०", "content_sanskrit": "यान्येतानि तु पद्मस्य केसराणि समन्ततः ।\nअसंख्याताः पृथिव्यां तु विश्वे ते धातुपर्वताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006473010, "chapter_id": 26473, "verse_number": "३-१२-११", "content_sanskrit": "यानि पद्मस्य पत्राणि भूरीण्यूर्ध्वं नराधिप ।\nते दुर्गमाः शैलचिता म्लेच्छदेशा विकल्पिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006473011, "chapter_id": 26473, "verse_number": "३-१२-१२", "content_sanskrit": "यान्यधः पद्मपत्राणि वासार्थे तानि भागशः ।\nदैत्यानामुरगाणां च पातालं तन्महात्मनाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006473012, "chapter_id": 26473, "verse_number": "३-१२-१३", "content_sanskrit": "तेषामधोगतं यत्तदुदकेत्यभिसंज्ञितम् ।\nमहापातककर्माणो मज्जन्ते यत्र मानवाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006473013, "chapter_id": 26473, "verse_number": "३-१२-१४", "content_sanskrit": "पद्मस्यान्ते कुशं यत्तदेकार्णवजलं महत् ।\nप्रोक्तास्ते दिक्षु संघाताश्चत्वारो जलसागराः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006473014, "chapter_id": 26473, "verse_number": "३-१२-१५", "content_sanskrit": "ऋषेर्नारायणस्यायं महापुष्करसम्भवः ।\nप्रादुर्भावोऽप्ययं तस्मान्नाम्ना पुष्करसम्भवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006473015, "chapter_id": 26473, "verse_number": "३-१२-१६", "content_sanskrit": "एतस्मात् कारणात् तज्ज्ञैः पुराणैः परमर्षिभिः ।\nयज्ञियैर्वेददृष्टार्थैर्यज्ञे पद्मचिती कृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006473016, "chapter_id": 26473, "verse_number": "३-१२-१७", "content_sanskrit": "एवं भगवता पद्मे विश्वस्य परमो विधिः ।\nपर्वतानां नदीनां च देशानां च विनिर्मितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006473017, "chapter_id": 26473, "verse_number": "३-१२-१८", "content_sanskrit": "विभुस्तथैवाप्रतिमप्रभावः प्रभाकरो वै भगवान् महात्मा ।\nस्वयं स्वयंभूः शयनेऽसृजत् तदा जगन्मयं पद्मनिधिं महार्णवे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]