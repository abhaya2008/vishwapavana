[{"id": 50024816, "chapter_id": 11912, "verse_number": "1", "content_sanskrit": "स्वयं वा प्राश्निकैर्वादे चिन्तयेत् तत्त्वनिर्णयम्॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024817, "chapter_id": 11912, "verse_number": "2", "content_sanskrit": "रागद्वेषविहीनास्तु सर्वविद्याविशारदाः। प्राश्निका इति विज्ञेया 【पाठभेदः: BG—सम्प्रोक्ता】 विषमा एक एव वा॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024818, "chapter_id": 11912, "verse_number": "3", "content_sanskrit": "अशेषसंशयच्छेत्ता निःसंशय उदारधीः। एकश्चेत् प्राश्निको ज्ञेयस्सर्वदोषविवर्जितः॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024819, "chapter_id": 11912, "verse_number": "4", "content_sanskrit": "एको वा बहवो वा स्युर्विष्णुभक्तिपराः सदा। विष्णुभक्तिर्हि सर्वेषां सद्गुणानां स्वलक्षणम्॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]