[{"id": 7000841000, "chapter_id": 20841, "verse_number": "६-१८४-१", "content_sanskrit": "देव्युवाच ।\nसर्वज्ञ सर्वचैतन्य सर्वेश्वर गिरां गुरो ।\nधन्यास्मि शिवमान्येन दृश्यमानेन यत्त्वया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000841001, "chapter_id": 20841, "verse_number": "६-१८४-२", "content_sanskrit": "निरूपितमिदं पुण्यं नवमाध्यायवैभवम् ।\nअनेकविस्मयस्वादु कथानकमयं मधु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000841002, "chapter_id": 20841, "verse_number": "६-१८४-३", "content_sanskrit": "शृण्वंत्या मम देवेश न तृप्तिर्जातु जायते ।\nअकुंठाश्रवणोत्कंठा वर्द्धते वृषभध्वज ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000841003, "chapter_id": 20841, "verse_number": "६-१८४-४", "content_sanskrit": "आसीन्ममहिमांभोधे गीतानां श्रुतिजीवितम् ।\nतत्रापि दशमाध्यायं प्रधानं मुनयो जगुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000841004, "chapter_id": 20841, "verse_number": "६-१८४-५", "content_sanskrit": "तमुद्दिश्य महाध्यायमभिधेहि कथानकम् ।\nशिव उवाच ।\nशृणु सुश्रोणि निश्रेणीं स्वर्गदुर्गस्य दुर्ल्लभाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000841005, "chapter_id": 20841, "verse_number": "६-१८४-६", "content_sanskrit": "सीमामिव प्रभावानां पावनीं परमां कथाम् ।\nआसीत्काशीपुरे विप्रः पुण्यकीर्त्तिपरायणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000841006, "chapter_id": 20841, "verse_number": "६-१८४-७", "content_sanskrit": "प्रशांतचेता निर्मुक्त हिंसाकार्कश्यसाहसः ।\nनिवृत्तिनिरतो नित्यं जितेंद्रियतया तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000841007, "chapter_id": 20841, "verse_number": "६-१८४-८", "content_sanskrit": "धीरधीरिति विख्यातो नंदीव मयि भक्तिमान् ।\nनिस्तीर्णनिगमांभोधिः सर्वशास्त्रार्थकोविदः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000841008, "chapter_id": 20841, "verse_number": "६-१८४-९", "content_sanskrit": "तस्य ध्यानपराधीन चेतसः प्रतिगच्छतः ।\nअंतरात्मनि निर्मग्न मनसस्तत्त्वचक्षुषः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000841009, "chapter_id": 20841, "verse_number": "६-१८४-१०", "content_sanskrit": "करावलंबनं तस्य धावन्प्रीत्या ददाम्यहम् ।\nकदाचन चमत्कारकारकं विमना मुनिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000841010, "chapter_id": 20841, "verse_number": "६-१८४-११", "content_sanskrit": "आचांतः किंच नासाग्रपरमानंदमेदुराम् ।\nदृशमासाद्य निद्राणकरणोयमिवास्थितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000841011, "chapter_id": 20841, "verse_number": "६-१८४-१२", "content_sanskrit": "उपाधास्य विशालाक्षि विशालां द्वारदेहलीम् ।\nअशेत निशि निःशंकं तावल्लंबेक्षणः क्षणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000841012, "chapter_id": 20841, "verse_number": "६-१८४-१३", "content_sanskrit": "मामपृच्छद्भृंगिरिटिः प्रणम्यपादपंकजम् ।\nअनेन विधिना केन विहितं तव दर्शनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000841013, "chapter_id": 20841, "verse_number": "६-१८४-१४", "content_sanskrit": "तपस्तप्तं हुतं जप्तं किमनेन महात्मना ।\nदत्ते प्रतिपदं देवो यस्य हस्तावलंबनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000841014, "chapter_id": 20841, "verse_number": "६-१८४-१५", "content_sanskrit": "अयं न लभते गंतुं कस्मादस्मात्पुराद्बहिः ।\nयदृच्छया यदा काशी सीमामुल्लंघ्य गच्छति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000841015, "chapter_id": 20841, "verse_number": "६-१८४-१६", "content_sanskrit": "न पश्यति तदा सर्वान्पार्श्वस्थानपि देहिनः ।\nअत्र हेतुमहं ज्ञातुमिच्छामि स्वामिभाषिताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000841016, "chapter_id": 20841, "verse_number": "६-१८४-१७", "content_sanskrit": "अनुग्राह्योस्मि चेद्वक्तुं युक्तं चेत्तदुदीरय ।\nभृंगिरिटेरिमं प्रश्नं समाकर्ण्याहमूचिवान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000841017, "chapter_id": 20841, "verse_number": "६-१८४-१८", "content_sanskrit": "कदाचिदासं कैलासं पार्श्वे पुन्नागकानने ।\nरणत्खेचरसुश्रोणि पूर्णस्तबककानने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000841018, "chapter_id": 20841, "verse_number": "६-१८४-१९", "content_sanskrit": "कलकंठकुलालाप कल्लोलितदिगंतरे ।\nगरुत्मदादिदात्यूह समूहस्वरसंकुले ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000841019, "chapter_id": 20841, "verse_number": "६-१८४-२०", "content_sanskrit": "भ्रमद्दारुघटीयंत्र प्रोल्लसद्बिंदुदंतुरे ।\nप्रबुद्धसारणिप्रांत कदलीकंदलालसे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000841020, "chapter_id": 20841, "verse_number": "६-१८४-२१", "content_sanskrit": "कस्तूरीहरिणोपेते किंनरस्वरमोहिते ।\nरोमंथमंथरापांगैर्मृगैः क्वापि निषेविते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000841021, "chapter_id": 20841, "verse_number": "६-१८४-२२", "content_sanskrit": "हंसैः कीरेषु पांडित्यं कुर्वाणैः संकुले शुकैः ।\nनिर्हृदिक्वणिनीरंध्र समीरणविलोडिते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000841022, "chapter_id": 20841, "verse_number": "६-१८४-२३", "content_sanskrit": "माधवीपुष्पनिर्यासशीधुक्षीबमधुव्रते ।\nउन्मीलित्त्रिवलीपुष्पगुच्छसौरभनिर्भरे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000841023, "chapter_id": 20841, "verse_number": "६-१८४-२४", "content_sanskrit": "प्रोत्फुल्लबकुलामोदमदमंथरषट्पदे ।\nसोमादुद्भूतपीयूषक्षालितक्षितिमंडले ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000841024, "chapter_id": 20841, "verse_number": "६-१८४-२५", "content_sanskrit": "अध्यास्य वेदिकामेकामहं क्षणमवस्थितः ।\nउद्दंडशाखिसंघट्टस्फुटन्मंथामुखोत्करैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000841025, "chapter_id": 20841, "verse_number": "६-१८४-२६", "content_sanskrit": "प्रकंपिता चलच्छायो ववौ चंडसमीरणः ।\nपश्चादभून्महाघोषो निर्घोषित दरीतटः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000841026, "chapter_id": 20841, "verse_number": "६-१८४-२७", "content_sanskrit": "अवातरत्ततः कश्चित्पक्षी गगनगह्वरात् ।\nशारदानरिदच्छायः कज्जलानामिवोच्चयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000841027, "chapter_id": 20841, "verse_number": "६-१८४-२८", "content_sanskrit": "तमसामिव संघातः पक्षच्छेदीव पर्वतः ।\nअवष्टभ्य क्षितिं पद्मां पक्षी मां प्रणनाम सः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000841028, "chapter_id": 20841, "verse_number": "६-१८४-२९", "content_sanskrit": "आनीय पद्ममम्लानमसौ मत्पादयोर्व्यधात् ।\nअथासौ स्पष्टया वाचा पक्षी स्तोत्रमुदीरयत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000841029, "chapter_id": 20841, "verse_number": "६-१८४-३०", "content_sanskrit": "जयदेव चिदानंद सुधासिंधो जगत्पते ।\nसदा सद्भावना संग कल्लोलानंतविग्रह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000841030, "chapter_id": 20841, "verse_number": "६-१८४-३१", "content_sanskrit": "अद्वैतवासना मत्या मलत्रयविवर्जित ।\nजितेंद्रिय पराधीन समाधिप्राप्यविग्रह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000841031, "chapter_id": 20841, "verse_number": "६-१८४-३२", "content_sanskrit": "निरुपाधिविनिर्मुक्त निराकार निरामय ।\nनिःसीम निरहंकार निरावरणनिर्गुण ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000841032, "chapter_id": 20841, "verse_number": "६-१८४-३३", "content_sanskrit": "शरणागतसंत्राण प्रवीण चरणांबुज ।\nभीममाल महाव्याल ज्वालादग्धमनोभव ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000841033, "chapter_id": 20841, "verse_number": "६-१८४-३४", "content_sanskrit": "कुठारभिन्नदैत्येंद्र गंडूषित महाविभो ।\nत्रिपुरप्रमदाभाल सिंदूरोद्धूलिमार्जन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000841034, "chapter_id": 20841, "verse_number": "६-१८४-३५", "content_sanskrit": "कात्यायनीकुचांभोज वरकुंकुमचर्चित ।\nनमः प्रमाणदूराय नमः प्रमतिरूपिणे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000841035, "chapter_id": 20841, "verse_number": "६-१८४-३६", "content_sanskrit": "नमश्चैतन्यनाथाय नमस्त्रैलोक्यरूपिणे ।\nवंदे तव पदांभोजं योगिप्रवरचुंबितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000841036, "chapter_id": 20841, "verse_number": "६-१८४-३७", "content_sanskrit": "अपारभवपाथोऽधि पारावतरणाद्भुतम् ।\nवाचस्पतिरपि स्तोत्रे भवतो न प्रगल्भते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000841037, "chapter_id": 20841, "verse_number": "६-१८४-३८", "content_sanskrit": "सहस्रवदनस्यापि फणींद्रस्य न चातुरी ।\nत्वद्वर्णने महादेव कोऽहंमल्पमतिः खगः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000841038, "chapter_id": 20841, "verse_number": "६-१८४-३९", "content_sanskrit": "स्तोत्रमेतत्समाकर्ण्य कृतं तेन पतत्रिणा ।\nतमवोचमहं कोऽसि कुतस्त्योसि विहंगम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000841039, "chapter_id": 20841, "verse_number": "६-१८४-४०", "content_sanskrit": "हंसेन सदृशः कायो वर्णः काकेन संनिभः ।\nप्रयोजनं कमुद्दिश्य प्राप्तोसीह तदुच्यताम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000841040, "chapter_id": 20841, "verse_number": "६-१८४-४१", "content_sanskrit": "इति पक्षी मया पृष्टः प्रश्रयानतकंधरः ।\nजगाद श्लक्ष्णया वाचा पक्षीवाक्यविदांवरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000841041, "chapter_id": 20841, "verse_number": "६-१८४-४२", "content_sanskrit": "देवेश धूर्जटे विद्धि मां मरालं स्वयंभुवः ।\nकर्मणा येन मे कार्ष्ण्यं जातमाधुनिकं विभो ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000841042, "chapter_id": 20841, "verse_number": "६-१८४-४३", "content_sanskrit": "तदाकर्णय सर्वज्ञ पृष्टं यदि तदुच्यते ।\nमानसात्सरसः पृथ्वीं यातः प्राप्तोस्मि संकटम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000841043, "chapter_id": 20841, "verse_number": "६-१८४-४४", "content_sanskrit": "सौराष्ट्रनगरादारात्सरसि स्फुटदंबुजे ।\nबालेंदुखंडधवलान्मृणालकवलानहम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000841044, "chapter_id": 20841, "verse_number": "६-१८४-४५", "content_sanskrit": "आदाय बलमाश्रित्य निरगां गगनं द्रुतम् ।\nविहायसस्ततस्तस्मादकस्मादपतं भुवि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000841045, "chapter_id": 20841, "verse_number": "६-१८४-४६", "content_sanskrit": "अथ मोहपरीतात्मा सर्वथा विकलेंद्रियः ।\nवेपमानवपुर्मोहात्स्पृष्टः शीतैः समीरणैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000841046, "chapter_id": 20841, "verse_number": "६-१८४-४७", "content_sanskrit": "प्रबुद्धः पतने हेतुमपश्यन्नात्मनस्तदा ।\nअहो किमेतदापन्नमद्य पातः कथं मम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000841047, "chapter_id": 20841, "verse_number": "६-१८४-४८", "content_sanskrit": "कालिमा येन कायेस्मिन्पक्वकर्पूरपांडुरे ।\nइत्यहं विस्मयाविष्टो यावत्कुर्वे विचारणम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000841048, "chapter_id": 20841, "verse_number": "६-१८४-४९", "content_sanskrit": "तावदंबुरुहाद्वाणीमश्रौषमहमीदृशीम् ।\nउत्तिष्ठ हंस वक्ष्यामि कारणं पातकार्ष्ण्ययोः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000841049, "chapter_id": 20841, "verse_number": "६-१८४-५०", "content_sanskrit": "अथोत्थाय समागत्य मया मध्ये सरोवरे ।\nदृष्टराजीविनीरम्या राजीवैः पंचभिर्युता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000841050, "chapter_id": 20841, "verse_number": "६-१८४-५१", "content_sanskrit": "कारणं प्रष्टुमारेभे कार्ष्ण्यस्य पतनस्य च ।\nअथ तत्र घनश्यामान्स्वर्णवर्णांबरावृतान् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000841051, "chapter_id": 20841, "verse_number": "६-१८४-५२", "content_sanskrit": "चतुर्भुजान्गदाशंखचक्रपंकेरुहायुधान् ।\nकिरीटहारकेयूरकुंडलद्युतिचित्रितान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000841052, "chapter_id": 20841, "verse_number": "६-१८४-५३", "content_sanskrit": "अद्राक्षमंतरिक्षस्थान्पुरुषानयुतानि षट् ।\nनत्वा प्रदक्षिणीकृत्य पंचपद्मां सरोजिनीम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000841053, "chapter_id": 20841, "verse_number": "६-१८४-५४", "content_sanskrit": "आत्मीयं पातमारभ्य पृष्टं तदखिलं मया ।\nपद्मिन्युवाच ।\nकलहंस गतोऽसि त्वं मां विलंघ्य विहायसा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000841054, "chapter_id": 20841, "verse_number": "६-१८४-५५", "content_sanskrit": "तेन पातकयोगेन पतितोऽसि महीतले ।\nतेनैव कालिमा काये पक्षिसत्तम लक्ष्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000841055, "chapter_id": 20841, "verse_number": "६-१८४-५६", "content_sanskrit": "भवंतं पतितं वीक्ष्य कृपापूर्णेन चेतसा ।\nमध्यमेनामुनाब्जेन वदता जातसौरभम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000841056, "chapter_id": 20841, "verse_number": "६-१८४-५७", "content_sanskrit": "आघ्राय षट्पदाः षष्टिसहस्राणि दिवं ययुः ।\nएते ये भवतां दृष्टाः नीलोत्पलसमत्विषः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000841057, "chapter_id": 20841, "verse_number": "६-१८४-५८", "content_sanskrit": "सर्वे ते सप्तमेऽतीते जन्मन्यासन्मुनेः सुताः ।\nअस्यैव सरसस्तीरे तेपुस्ते परमं तपः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000841058, "chapter_id": 20841, "verse_number": "६-१८४-५९", "content_sanskrit": "कदाचित्कामिनी काचिच्चंपकस्तबकस्तनी ।\nचलापांगकालाकांततरंगित रसालिनी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000841059, "chapter_id": 20841, "verse_number": "६-१८४-६०", "content_sanskrit": "नासा मुक्ताफलज्योत्स्ना चुंबितस्मित दीधितिः ।\nवीणां विन्यस्य कुचयोर्वनेऽस्मिन्मधुरं जगौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000841060, "chapter_id": 20841, "verse_number": "६-१८४-६१", "content_sanskrit": "गायंत्या स्वरमाकर्ण्य ब्राह्मणा हरिणा इव ।\nतां समागत्य ते सर्वे सममेव व्यलोकयन् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000841061, "chapter_id": 20841, "verse_number": "६-१८४-६२", "content_sanskrit": "मया दृष्टा ममैवेयमित्यूचुस्ते परस्परम् ।\nमुष्टामुष्टि ततस्तेषां भ्रातॄणामभवद्रणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000841062, "chapter_id": 20841, "verse_number": "६-१८४-६३", "content_sanskrit": "अन्योन्यमुष्टिनिष्पिष्ट वक्षसस्त्यक्तजीविताः ।\nते भुक्त्वा निरयान्घोरान्बभूवुः सारसा भुवि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000841063, "chapter_id": 20841, "verse_number": "६-१८४-६४", "content_sanskrit": "तदा ते श्वापदान्जघ्नुर्दग्धावन्येन वह्निना ।\nततो मातंगतामेत्य पथिपांथानघातयन् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000841064, "chapter_id": 20841, "verse_number": "६-१८४-६५", "content_sanskrit": "वने विषोदकं पीत्वा ते ययुर्यममंदिरम् ।\nखरोष्ट्रकपिमार्जार जन्मान्यासाद्य च क्रमात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000841065, "chapter_id": 20841, "verse_number": "६-१८४-६६", "content_sanskrit": "ततो मधुव्रता जाता वर्तंतेऽत्र सरोवरे ।\nअद्य मे गंधमाघ्राय प्रापुस्ते वैष्णवं पदम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000841066, "chapter_id": 20841, "verse_number": "६-१८४-६७", "content_sanskrit": "शृणु पक्षींद्र वक्ष्यामि येन मय्यस्ति वैभवम् ।\nएतस्माज्जन्मनः पूर्वे तृतीये जन्मनि क्षितौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000841067, "chapter_id": 20841, "verse_number": "६-१८४-६८", "content_sanskrit": "सरोजवदनानाम द्विजातेः कन्यकाऽभवम् ।\nपातिव्रत्यैकनिरता गुरुशुश्रूषणे रता ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000841068, "chapter_id": 20841, "verse_number": "६-१८४-६९", "content_sanskrit": "कदाचित्सारिकामेकां पाठयंत्याविलंबितम् ।\nसारिका भव पापे त्वं पत्या शप्तास्मि कुप्यता ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000841069, "chapter_id": 20841, "verse_number": "६-१८४-७०", "content_sanskrit": "प्रेत्य सारित्वमासाद्य पातिव्रत्यप्रसादतः ।\nमुनीनामेव सदने कन्या काचित्पुपोष माम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000841070, "chapter_id": 20841, "verse_number": "६-१८४-७१", "content_sanskrit": "गीतानां दशमाध्यायं विभूतिरिति विश्रुतम् ।\nप्रातः पठति विप्रोसावश्रौषं तमघापहम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000841071, "chapter_id": 20841, "verse_number": "६-१८४-७२", "content_sanskrit": "कालेन सारिकादेहमहं हित्वा विहंगम ।\nदशमाध्यायमाहात्म्यादप्सराश्चाभवं दिवि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000841072, "chapter_id": 20841, "verse_number": "६-१८४-७३", "content_sanskrit": "पद्मावतीति विख्याता पद्माया दयिता सुखी ।\nकदाचन मया यांत्या विमानेन विहायसा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000841073, "chapter_id": 20841, "verse_number": "६-१८४-७४", "content_sanskrit": "एतत्सरोवरं रम्यं विलोक्य विमलांबुजम् ।\nअवतीर्य जलक्रीडायावदारभ्यते मया ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000841074, "chapter_id": 20841, "verse_number": "६-१८४-७५", "content_sanskrit": "दुर्वासास्तावदायातो विवस्त्रा तेन वीक्षिता ।\nतद्भयात्पद्मिनीरूपं धृतमेतन्मया स्वयम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000841075, "chapter_id": 20841, "verse_number": "६-१८४-७६", "content_sanskrit": "पद्भ्यां पद्मद्वयं चैव द्वयं हस्तद्वयेन च ।\nमुखेन पंचमांभोजमिति पंचांबुजास्म्यहम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000841076, "chapter_id": 20841, "verse_number": "६-१८४-७७", "content_sanskrit": "दृष्टा तेन मुनींद्रेण कोपज्वलित चक्षुषा ।\nअनेनैव स्वरूपेण तिष्ठ पापे शतं समाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000841077, "chapter_id": 20841, "verse_number": "६-१८४-७८", "content_sanskrit": "इति शापं समुत्सृज्य स चैवांतर्दधे क्षणात् ।\nविभूत्यध्यायमाहात्म्याद्वाणी मे न विलीयते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000841078, "chapter_id": 20841, "verse_number": "६-१८४-७९", "content_sanskrit": "मद्विलंघनमात्रेण पतितोसि महीतले ।\nअद्य शापनिवृत्तिर्मे तिष्ठतस्ते खगोत्तम ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000841079, "chapter_id": 20841, "verse_number": "६-१८४-८०", "content_sanskrit": "निशामय मया गीयमानमध्यायमुत्तमम् ।\nयस्याकर्णनमात्रेण त्वमद्यैव विमोक्ष्यसे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000841080, "chapter_id": 20841, "verse_number": "६-१८४-८१", "content_sanskrit": "इत्यसौ दशमाध्यायं पपाठ श्लक्ष्णया गिरा ।\nतमाकर्ण्य तया दत्तमादाय च सरोरुहम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000841081, "chapter_id": 20841, "verse_number": "६-१८४-८२", "content_sanskrit": "मया समर्पितं तुभ्यं पद्मिन्या पद्ममुत्तमम् ।\nइत्युक्त्वा स जहौ देहं तदद्भुतमिवाभवत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000841082, "chapter_id": 20841, "verse_number": "६-१८४-८३", "content_sanskrit": "भृंगिरिटिरुवाच ।\nपुरातने भवे कोऽयं ब्रह्म हंसोऽभवत्कथं ।\nतवाग्रतः कुतो हेतोरुत्ससर्ज कलेवरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000841083, "chapter_id": 20841, "verse_number": "६-१८४-८४", "content_sanskrit": "इति भृंगिरिटिर्वाक्यमाकर्ण्याहं तदाब्रुवम् ।\nद्विजवेश्मनि पूर्वस्मिन्जन्मन्ययमजायत ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000841084, "chapter_id": 20841, "verse_number": "६-१८४-८५", "content_sanskrit": "सुतपा इति विख्यातो ब्रह्मचारी जितेंद्रियः ।\nवसन्गुरुकुले कुर्वन्वेदाध्ययनमन्वहम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000841085, "chapter_id": 20841, "verse_number": "६-१८४-८६", "content_sanskrit": "गुरुशुश्रूषणं सम्यग्विदधाति च भक्तितः ।\nशयानस्य गुरोः शय्यां निद्रितः सपदा स्पृशत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000841086, "chapter_id": 20841, "verse_number": "६-१८४-८७", "content_sanskrit": "तेन पापेन तिर्यक्त्वमयं स्वर्गेऽपि लब्धवान् ।\nपद्मयोनिमरालानां मध्ये जातस्ततो द्विजः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000841087, "chapter_id": 20841, "verse_number": "६-१८४-८८", "content_sanskrit": "अस्मिञ्जन्मन्यमुष्येह पुरास्मल्लोकनावधि ।\nगीतानां दशमाध्यायं नलिन्या कथितं ततः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000841088, "chapter_id": 20841, "verse_number": "६-१८४-८९", "content_sanskrit": "आकर्ण्य विहगो लेभे ब्रह्मज्ञानमनुत्तमम् ।\nसोऽयं विप्रकुले जातो दशमाध्यायवैभवात् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000841089, "chapter_id": 20841, "verse_number": "६-१८४-९०", "content_sanskrit": "जन्माभ्यासवशादस्य शिशोरपि मुखांबुजात् ।\nगीतानां दशमाध्यायः समुल्लसति सर्वदा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000841090, "chapter_id": 20841, "verse_number": "६-१८४-९१", "content_sanskrit": "तदर्थपरिणामेन सर्वभूतेष्ववस्थितम् ।\nशंखचक्रधरं देवमयं पश्यति सर्वदा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000841091, "chapter_id": 20841, "verse_number": "६-१८४-९२", "content_sanskrit": "यस्मिन्यस्मिन्यदैवास्य दृष्टिः स्निग्धा शरीरिणः ।\nस स मुक्तो भवेत्सर्वः सुरापो ब्रह्महाऽपि वा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000841092, "chapter_id": 20841, "verse_number": "६-१८४-९३", "content_sanskrit": "तद्विज्ञाय मया विप्रः परमात्मस्वरूपिणा ।\nइदं नगरमानीतो मुक्तिक्षेत्रं स्वभावतः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000841093, "chapter_id": 20841, "verse_number": "६-१८४-९४", "content_sanskrit": "अत्रत्यानां मनुष्याणां मुक्तिः करतले स्थिता ।\nतेनास्य दृष्टिपातेन विशेषोऽन्यो न जायते ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000841094, "chapter_id": 20841, "verse_number": "६-१८४-९५", "content_sanskrit": "न ददामि बहिर्गंतुमहमस्य पुरा कृतम् ।\nदशमाध्यायमहात्म्यात्तत्वज्ञानं सुदुर्लभम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000841095, "chapter_id": 20841, "verse_number": "६-१८४-९६", "content_sanskrit": "लब्धमेतेन मुनिना जीवन्मुक्तिरियं तथा ।\nतेनास्य चलतो हस्तं ददामि पथि गच्छतः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000841096, "chapter_id": 20841, "verse_number": "६-१८४-९७", "content_sanskrit": "दशमाध्यायमहिमा भृंगिरिटे महानयम् ।\nइति भृंगिरिटेरग्रे कथितं यत्कथानकम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000841097, "chapter_id": 20841, "verse_number": "६-१८४-९८", "content_sanskrit": "तवेदमत्र कथितं सर्वपापप्रणाशनम् ।\nनरो वाप्यथवा नारी यापि कोऽपि च वा पुनः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000841098, "chapter_id": 20841, "verse_number": "६-१८४-९९", "content_sanskrit": "अस्य श्रवणमात्रेण सर्वाश्रमफलं लभेत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]