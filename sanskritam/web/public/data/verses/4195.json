[{"id": 2147663, "chapter_id": 4195, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147664, "chapter_id": 4195, "verse_number": "१", "content_sanskrit": "श्रुत्वा दुर्योधनो वाक्यं हेतुमत् कुरुसंसदि ।\nप्रत्युवाच महाबाहुं वासुदेवं यशस्विनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147665, "chapter_id": 4195, "verse_number": "२", "content_sanskrit": "प्रसमीक्ष्य भवानेतद् वक्तुमर्हति केशव ।\nमामेव हि विशेषेण विभाष्य परिगर्हसे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147666, "chapter_id": 4195, "verse_number": "३", "content_sanskrit": "भक्तिवादेन पार्थानामकस्मान्मधुसूदन ।\nभवान् गर्हयते नित्यं किं समीक्ष्य बलाबलम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147667, "chapter_id": 4195, "verse_number": "४", "content_sanskrit": "भवान् क्षत्ता च राजा च आचार्यो वा पितामहः ।\nमामेव परिगर्हन्ते नान्यं कञ्चन पार्थिवम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147668, "chapter_id": 4195, "verse_number": "५", "content_sanskrit": "न चाहं लक्षये कञ्चिद् व्यभिचारमिहात्मनः ।\nअथ सर्वे भवन्तो मां विद्विषन्ति सराजकाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147669, "chapter_id": 4195, "verse_number": "६", "content_sanskrit": "न चाहं कञ्चिदत्यर्थमपराधमरिन्दम ।\nविचिन्तयन् प्रपश्यामि सुसूक्ष्ममपि केशव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147670, "chapter_id": 4195, "verse_number": "७", "content_sanskrit": "प्रियाभ्युपगते द्यूते पाण्डवा मधुसूदन ।\nजिताः शकुनिना राज्यं तत्र किं मम दुष्कृतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147671, "chapter_id": 4195, "verse_number": "८", "content_sanskrit": "यत् पुनर्द्रविणं किञ्चित् तत्राजीयन्त पाण्डवाः ।\nतेभ्य एवाभ्यनुज्ञातं तत् तदा मधुसूदन\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147672, "chapter_id": 4195, "verse_number": "९", "content_sanskrit": "अपराधो न चास्माकं यत् ते ह्यक्षपराजिताः ।\nअजेया जयतां श्रेष्ठ पार्थाः प्रव्राजिता वनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147673, "chapter_id": 4195, "verse_number": "१०", "content_sanskrit": "केन वाऽप्यवमानेन विरुद्ध्यन्तरिभिः सह ।\nअशक्ताः पाण्डवाः कृष्ण प्रकृष्टाः स(प्र)त्यमित्रवत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147674, "chapter_id": 4195, "verse_number": "११", "content_sanskrit": "किमस्माभिः कृतं तेषां कस्मिन् वा पुनरागसि ।\nधार्तराष्ट्रान् जिघांसन्ति पाण्डवाः सृञ्जयैः सह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147675, "chapter_id": 4195, "verse_number": "१२", "content_sanskrit": "न चापि वयमुग्रेण कर्मणा वचनेन वा ।\nवित्रस्ताः प्रणमामेह भयादपि शतक्रतोः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147676, "chapter_id": 4195, "verse_number": "१३", "content_sanskrit": "न च तं कृष्ण पश्यामि क्षत्रधर्ममनुष्ठितम् ।\nउत्सहेत युधा जेतुं यो नः शत्रुनिबर्हण\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147677, "chapter_id": 4195, "verse_number": "१४", "content_sanskrit": "न हि भीष्मकृपद्रोणाः सकर्णा मधुसूदन ।\nदेवैरपि युधा जेतुं शक्याः किमुत पाण्डवैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147678, "chapter_id": 4195, "verse_number": "१५", "content_sanskrit": "स्वधर्ममनुपश्यन्तो यदि माधव संयुगे ।\nअस्त्रेण निधनं काले प्राप्स्यामः स्वर्गमेव तत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147679, "chapter_id": 4195, "verse_number": "१६", "content_sanskrit": "मुख्यश्चैवैष नो धर्मः क्षत्रियाणां जनार्दन ।\nयच्छयीमहि सङ्ग्रामे शरतल्पगता वयम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147680, "chapter_id": 4195, "verse_number": "१७", "content_sanskrit": "ते वयं वीरशयनं प्राप्स्यामो यदि संयुगे ।\nअप्रणम्यैव शत्रूणां न नस्तप्स्यति कृष्ण तत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147681, "chapter_id": 4195, "verse_number": "१८", "content_sanskrit": "कश्च जातु कुले जातः क्षत्रधर्मेण वर्तयन् ।\nभयाद्वा वृत्तिहेतोर्वा प्रणमेदिह कस्यचित्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147682, "chapter_id": 4195, "verse_number": "१९", "content_sanskrit": "उद्यच्छेदेव न नमेद् उद्यमो ह्येव पौरुषम् ।\nअप्यपर्वणि भज्येत न नमेदिह कस्यचित्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147683, "chapter_id": 4195, "verse_number": "समाप्तिः", "content_sanskrit": "इति मातङ्गवचनं परीप्सन्ति हितेप्सवः ।\nधर्माय चैव प्रणमेद् ब्राह्मणेभ्यश्च मद्विधः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147684, "chapter_id": 4195, "verse_number": "२१", "content_sanskrit": "अचिन्तयन् कञ्चिदन्यं यावज्जीवं तथा चरेत् ।\nएष धर्मः क्षत्रियाणां मतमेतच्च मे सदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147685, "chapter_id": 4195, "verse_number": "२२", "content_sanskrit": "राज्यांशश्चाभ्यनुज्ञातो यो मे पित्रा पुराऽभवत् ।\nन स लभ्यः पुनर्जातु मयि जीवति केशव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147686, "chapter_id": 4195, "verse_number": "२३", "content_sanskrit": "यावत् तु राजा ध्रियते धृतराष्ट्रो जनार्दन ।\nन्यस्तशस्त्रा वयं ते वाऽप्युपजीवाम माधव\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147687, "chapter_id": 4195, "verse_number": "२४", "content_sanskrit": "यद्धि देयं पुरा दत्तं राज्यं परवतो मम\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147688, "chapter_id": 4195, "verse_number": "२५", "content_sanskrit": "अज्ञानाद्वा भयाद्वाऽपि मयि बाले जनार्दन ।\nन तदद्य पुनर्लभ्यं पाण्डवैर्वृष्णिनन्दन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147689, "chapter_id": 4195, "verse_number": "२६", "content_sanskrit": "ध्रियमाणे महाबाहो मयि सम्प्रति केशव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147690, "chapter_id": 4195, "verse_number": "२७", "content_sanskrit": "यावद्धि तीक्ष्णया सूच्या विद्ध्येदग्रेण माधव ।\nतावदप्यपरित्याज्यं भूमेर्नः पाण्डवान् प्रति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147691, "chapter_id": 4195, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षड्विंशोत्तरशततमोऽध्यायः ॥१२६॥\nभगवद्यानपर्वणि सप्तपञ्चाशोऽध्यायः ॥५७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]