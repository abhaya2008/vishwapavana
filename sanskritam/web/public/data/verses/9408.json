[{"id": 40022765, "chapter_id": 9408, "verse_number": "1", "content_sanskrit": "श्रुत्वा किम्पुरुषोत्पत्तिं लक्ष्मणो भरतस्तदा । आश्चर्यमिति चाब्रूतामुभौ रामं जनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022766, "chapter_id": 9408, "verse_number": "2", "content_sanskrit": "अथ रामः कथामेतां भूय एव महायशाः । कथयामास धर्मात्मा प्रजापतिसुतस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022767, "chapter_id": 9408, "verse_number": "3", "content_sanskrit": "सर्वास्ता विद्रुता दृष्ट्वा किन्नरीर्ऋषिसत्तमः । उवाच रूपसम्पन्नां तां स्त्रियं प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022768, "chapter_id": 9408, "verse_number": "4", "content_sanskrit": "सोमस्याहं सुदयितः सुतः सुरुचिरानने । भजस्व मां वरारोहे भक्त्या स्निग्धेन चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022769, "chapter_id": 9408, "verse_number": "5", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शून्ये स्वजनवर्जिते । इला सुरुचिरप्रख्यं प्रत्युवाच महाग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022770, "chapter_id": 9408, "verse_number": "6", "content_sanskrit": "अहं कामचरी सौम्य तवास्मि वशवर्तिनी । प्रशाधि मां सोमसुत यथेच्छसि तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022771, "chapter_id": 9408, "verse_number": "7", "content_sanskrit": "तस्यास्तदद्भुतप्रख्यं श्रुत्वा हर्षमुपागतः । स वै कामी सह तया रेमे चन्द्रमसः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022772, "chapter_id": 9408, "verse_number": "8", "content_sanskrit": "बुधस्य माधवो मासस्तामिलां रुचिराननाम् । गतो रमयतो ऽत्यर्थं क्षणवत्तस्य कामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022773, "chapter_id": 9408, "verse_number": "9", "content_sanskrit": "अथ मासे तु सम्पूर्णे पूर्णेन्दुसदृशाननः । प्रजापतिसुतः श्रीमाञ्छयने प्रत्यबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022774, "chapter_id": 9408, "verse_number": "10", "content_sanskrit": "सो ऽपश्यत्सोमजं तत्र तपन्तं सलिलाशये । ऊर्ध्वबाहुं निरालम्बं तं राजा प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022775, "chapter_id": 9408, "verse_number": "11", "content_sanskrit": "भगवन्पर्वतं दुर्गं प्रविष्टो ऽस्मि सहानुगः । न च पश्यामि तत्सैन्यं क्व नु ते मामका गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022776, "chapter_id": 9408, "verse_number": "12", "content_sanskrit": "तच्छ्रुत्वा तस्य राजर्षेर्नष्टसञ्ज्ञस्य भाषितम् । प्रत्युवाच शुभं वाक्यं सान्त्वयन्परया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022777, "chapter_id": 9408, "verse_number": "13", "content_sanskrit": "अश्मवर्षेण महता भृत्यास्ते विनिपातिताः । त्वं चाश्रमपदे सुप्तो वातवर्षभयार्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022778, "chapter_id": 9408, "verse_number": "14", "content_sanskrit": "समाश्वसिहि भद्रं ते निर्भयो विगतज्वरः । फलमूलाशनो वीर निवसेह यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022779, "chapter_id": 9408, "verse_number": "15", "content_sanskrit": "स राजा तेन वाक्येन प्रत्याश्वस्तो महामतिः । प्रत्युवाच ततो वाक्यं दीनो भृत्यक्षयाद् भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022780, "chapter_id": 9408, "verse_number": "16", "content_sanskrit": "त्यक्ष्याम्यहं स्वकं राज्यं नाहं भृत्यैर्विनाकृतः । वर्तयेयं क्षणं ब्रह्मन्समनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022781, "chapter_id": 9408, "verse_number": "17", "content_sanskrit": "सुतो धर्मपरो ब्रह्मञ्ज्येष्ठो मम महायशाः । शशबिन्दुरिति ख्यातः स मे राज्यं प्रपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022782, "chapter_id": 9408, "verse_number": "18", "content_sanskrit": "न हि शक्ष्याम्यहं हित्वा भृत्यदारान्सुखान्वितान् । प्रतिवक्तुं महातेजः किञ्चिदप्यशुभं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022783, "chapter_id": 9408, "verse_number": "19", "content_sanskrit": "तथा ब्रुवति राजेन्द्रे बुधः परममद्भुतम् । सान्त्वपूर्वमथोवाच वासस्त इह रोचताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022784, "chapter_id": 9408, "verse_number": "20", "content_sanskrit": "न सन्तापस्त्वया कार्यः कार्दमेय महाबल । संवत्सरोषितस्येह कारयिष्यामि ते हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022785, "chapter_id": 9408, "verse_number": "21", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा बुधस्याक्लिष्टकर्मणः । वासाय विदधे बुद्धिं यदुक्तं ब्रह्मवादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022786, "chapter_id": 9408, "verse_number": "22", "content_sanskrit": "मासं स स्त्री तदा भूत्वा रमयत्यनिशं शुदा । मासं पुरुषभावेन धर्मबुद्धिं चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022787, "chapter_id": 9408, "verse_number": "23", "content_sanskrit": "ततः सा नवमे मासि इला सोमसुतात्सुतम् । जनयामास सुश्रोणी पुरूरवसमूर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022788, "chapter_id": 9408, "verse_number": "24", "content_sanskrit": "जातमात्रं तु सुश्रोणी पितुर्हस्ते न्यवेशयत् । बुधस्य समवर्णभमिला पुत्रं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022789, "chapter_id": 9408, "verse_number": "25", "content_sanskrit": "बुधस्तु पुरुषीभूतं स वै संवत्सरान्तरम् । कथाभी रमयामास धर्मयुक्ताभिरात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]