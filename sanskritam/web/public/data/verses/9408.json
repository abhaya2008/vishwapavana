[{"id": 5000408000, "chapter_id": 9408, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000408001, "chapter_id": 9408, "verse_number": "६-१-१", "content_sanskrit": "श्रुत्वा हनूमतो वाक्यं यथावदभिभाषितम्।\nरामः प्रीतिसमायुक्तो वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000408002, "chapter_id": 9408, "verse_number": "६-१-२", "content_sanskrit": "कृतं हनूमता कार्यं सुमहद् भुवि दुर्लभम्।\nमनसापि यदन्येन न शक्यं धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000408003, "chapter_id": 9408, "verse_number": "६-१-३", "content_sanskrit": "नहि तं परिपश्यामि यस्तरेत महोदधिम्।\nअन्यत्र गरुडाद् वायोरन्यत्र च हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000408004, "chapter_id": 9408, "verse_number": "६-१-४", "content_sanskrit": "देवदानवयक्षाणां गन्धर्वोरगरक्षसाम्।\nअप्रधृष्यां पुरीं लङ्कां रावणेन सुरक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000408005, "chapter_id": 9408, "verse_number": "६-१-५", "content_sanskrit": "प्रविष्टः सत्त्वमाश्रित्य जीवन् को नाम निष्क्रमेत्।\nको विशेत् सुदुराधर्षां राक्षसैश्च सुरक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000408006, "chapter_id": 9408, "verse_number": "६-१-६", "content_sanskrit": "यो वीर्यबलसम्पन्नो न समः स्याद्धनूमतः।\nभृत्यकार्यं हनुमता सुग्रीवस्य कृतं महत्।\nएवं विधाय स्वबलं सदृशं विक्रमस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000408007, "chapter_id": 9408, "verse_number": "६-१-७", "content_sanskrit": "यो हि भृत्यो नियुक्तः सन् भर्त्रा कर्मणि दुष्करे।\nकुर्यात् तदनुरागेण तमाहुः पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000408008, "chapter_id": 9408, "verse_number": "६-१-८", "content_sanskrit": "यो नियुक्तः परं कार्यं न कुर्यान्नृपतेः प्रियम्।\nभृत्यो युक्तः समर्थश्च तमाहुर्मध्यमं नरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000408009, "chapter_id": 9408, "verse_number": "६-१-९", "content_sanskrit": "नियुक्तो नृपतेः कार्यं न कुर्याद् यः समाहितः।\nभृत्यो युक्तः समर्थश्च तमाहुः पुरुषाधमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000408010, "chapter_id": 9408, "verse_number": "६-१-१०", "content_sanskrit": "तन्नियोगे नियुक्तेन कृतं कृत्यं हनूमता।\nन चात्मा लघुतां नीतः सुग्रीवश्चापि तोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000408011, "chapter_id": 9408, "verse_number": "६-१-११", "content_sanskrit": "अहं च रघुवंशश्च लक्ष्मणश्च महाबलः।\nवैदेह्या दर्शनेनाद्य धर्मतः परिरक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000408012, "chapter_id": 9408, "verse_number": "६-१-१२", "content_sanskrit": "इदं तु मम दीनस्य मनो भूयः प्रकर्षति।\nयदिहास्य प्रियाख्यातुर्न कुर्मि सदृशं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000408013, "chapter_id": 9408, "verse_number": "६-१-१३", "content_sanskrit": "एष सर्वस्वभूतस्तु परिष्वङ्गो हनूमतः।\nमया कालमिमं प्राप्य दत्तस्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000408014, "chapter_id": 9408, "verse_number": "६-१-१४", "content_sanskrit": "इत्युक्त्वा प्रीतिहृष्टाङ्गो रामस्तं परिषस्वजे।\nहनूमन्तं कृतात्मानं कृतकार्यमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000408015, "chapter_id": 9408, "verse_number": "६-१-१५", "content_sanskrit": "ध्यात्वा पुनरुवाचेदं वचनं रघुसत्तमः।\nहरीणामीश्वरस्यापि सुग्रीवस्योपशृण्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000408016, "chapter_id": 9408, "verse_number": "६-१-१६", "content_sanskrit": "सर्वथा सुकृतं तावत् सीतायाः परिमार्गणम्।\nसागरं तु समासाद्य पुनर्नष्टं मनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000408017, "chapter_id": 9408, "verse_number": "६-१-१७", "content_sanskrit": "कथं नाम समुद्रस्य दुष्पारस्य महाम्भसः।\nहरयो दक्षिणं पारं गमिष्यन्ति समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000408018, "chapter_id": 9408, "verse_number": "६-१-१८", "content_sanskrit": "यद्यप्येष तु वृत्तान्तो वैदेह्या गदितो मम।\nसमुद्रपारगमने हरीणां किमिवोत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000408019, "chapter_id": 9408, "verse_number": "६-१-१९", "content_sanskrit": "इत्युक्त्वा शोकसम्भ्रान्तो रामः शत्रुनिबर्हणः।\nहनूमन्तं महाबाहुस्ततो ध्यानमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000408020, "chapter_id": 9408, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]