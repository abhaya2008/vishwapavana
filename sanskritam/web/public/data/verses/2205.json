[{"id": 2055078, "chapter_id": 2205, "verse_number": "७-१३२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055079, "chapter_id": 2205, "verse_number": "७-१३२-१", "content_sanskrit": "[स्वयं शिष्यो महेशस्य भृगूत्तमधनुर्धरः।\nशिष्यत्वं प्राप्तवान्कर्णस्तस्य तुल्योऽस्त्रविद्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055080, "chapter_id": 2205, "verse_number": "७-१३२-२", "content_sanskrit": "तद्विशिष्टोऽपि वा कर्णः शिष्यः शिष्यगुणैर्युतः।\nकुन्तीपुत्रेण भीमेन निर्जितः स तु लीलया॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055081, "chapter_id": 2205, "verse_number": "७-१३२-३", "content_sanskrit": "यस्मिञ्जयाशा महती पुत्राणां मम सञ्जय।\nतं भीमाद्विमुखं दृष्ट्वा किन्नु दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055082, "chapter_id": 2205, "verse_number": "७-१३२-४", "content_sanskrit": "कथं च युयुधे भीमो वीर्यश्लाघी महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055083, "chapter_id": 2205, "verse_number": "७-१३२-५", "content_sanskrit": "कर्णो वा समरे तात किमकार्षीदतः परम्।\nभीमसेनं रणे दृष्ट्वा ज्वलन्तमिव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055084, "chapter_id": 2205, "verse_number": "७-१३२-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055085, "chapter_id": 2205, "verse_number": "७-१३२-६", "content_sanskrit": "रथमन्यं समास्थाय विधिवत्कल्पितं पुनः।\nअभ्ययात्पाण्डवं कर्णो वातोद्धूत इवार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055086, "chapter_id": 2205, "verse_number": "७-१३२-७", "content_sanskrit": "क्रुद्धमाधिरथिं दृष्ट्वा पुत्रास्तव विशाम्पते।\nभीमसेनममन्यन्त वैश्वानरमुखे हुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055087, "chapter_id": 2205, "verse_number": "७-१३२-८", "content_sanskrit": "चापशब्दं ततः कृत्वा तलशब्दं च भैरवम्।\nअभ्यद्रवत राधेयो भीमसेनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055088, "chapter_id": 2205, "verse_number": "७-१३२-९", "content_sanskrit": "पुनरेव तयो राजन्घोर आसीत्समागमः।\nवैकर्तनस्य शूरस्य भीमस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055089, "chapter_id": 2205, "verse_number": "७-१३२-१०", "content_sanskrit": "संरब्धौ हि महाबाहू परस्परवधैषिणौ।\nअन्योन्यभीक्षाञ्चक्राते दहन्ताविव लोचनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055090, "chapter_id": 2205, "verse_number": "७-१३२-११", "content_sanskrit": "क्रोधरक्रेक्षणौ तीव्रौ निःश्वसन्ताविवोरगौ।\nशूरावन्योन्यमासाद्य ततक्षतुररिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055091, "chapter_id": 2205, "verse_number": "७-१३२-१२", "content_sanskrit": "व्याघ्राविव सुसंरब्धौ श्येनाविव च शीघ्रगौ।\nशरभाविव सङ्क्रुद्धौ युयुधाते परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055092, "chapter_id": 2205, "verse_number": "७-१३२-१३", "content_sanskrit": "ततो भीमः स्मरन्क्लेशानक्षद्यूते वनेऽपि च।\nविराटनगरे चैव दुःखं प्राप्तमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055093, "chapter_id": 2205, "verse_number": "७-१३२-१४", "content_sanskrit": "राष्ट्राणां स्फीतरत्नानां हरणं च तवात्मजैः।\nसततं च परिक्लेशान्सपुत्रेण त्वया कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055094, "chapter_id": 2205, "verse_number": "७-१३२-१५", "content_sanskrit": "दग्धुमैच्छश्च यः कुन्तीं सपुत्रां त्वमनागसम्।\nकृष्णायाश्च परिक्लेशं सभामध्ये दुरात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055095, "chapter_id": 2205, "verse_number": "७-१३२-१६", "content_sanskrit": "केशपक्षग्रहं चैव दुःशासनकृतं तथा।\nपरुषाणि च वाक्यानि कर्णोनोक्तानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055096, "chapter_id": 2205, "verse_number": "७-१३२-१७", "content_sanskrit": "पतिमन्यं परीप्सस्व न सन्ति पतयस्तव।\nपतिता नरके पार्थाः सर्वे षण्डतिलोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055097, "chapter_id": 2205, "verse_number": "७-१३२-१८", "content_sanskrit": "समक्षं तव कौरव्य यदूचुः कौरवास्तदा।\nदासीभावेन कृष्णां च भोक्तुकामाः सुतास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055098, "chapter_id": 2205, "verse_number": "७-१३२-१९", "content_sanskrit": "यच्चापि तान्प्रव्रजतः कृष्णाजिननिवासिनः।\nपरुषाण्युक्तवान्कर्णः सभायां सन्निधौ तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055099, "chapter_id": 2205, "verse_number": "७-१३२-२०", "content_sanskrit": "तृणीकृत्य च यत्पार्थांस्तव पुत्रो ववल्ग ह।\nविषमस्थान्समस्थो हि संरब्धो गतचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055100, "chapter_id": 2205, "verse_number": "७-१३२-२१", "content_sanskrit": "बाल्यात्प्रभृति चारिघ्नः स्वानि दुःखानि चिन्तयन्।\nनिरविद्यत धर्मात्मा जीवितेन वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055101, "chapter_id": 2205, "verse_number": "७-१३२-२२", "content_sanskrit": "ततो विष्फार्य सुमहद्धेमपृष्ठं दुरासदम्।\nचापं भरतशार्दूलस्त्यक्तात्मा कर्णमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055102, "chapter_id": 2205, "verse_number": "७-१३२-२३", "content_sanskrit": "स सायकयैर्जालैर्भीमः कर्णरथं प्रति।\nभानुमद्भिः शिलाधौतैर्भानोः प्राच्छादयत्प्रभां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055103, "chapter_id": 2205, "verse_number": "७-१३२-२४", "content_sanskrit": "ततः प्रहस्याधिरथिस्तूर्णमस्यञ्शिताञ्शरान्।\nव्यधमद्भीमसेनस्य शरजालानि पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055104, "chapter_id": 2205, "verse_number": "७-१३२-२५", "content_sanskrit": "महारथो महाबाहुर्महाबाणैर्महाबलः।\nविव्याधाधिरथिर्भीमं नवभिर्निशितैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055105, "chapter_id": 2205, "verse_number": "७-१३२-२६", "content_sanskrit": "स तोत्रैरिव मातङ्गो वार्यमाणः पतत्त्रिभः।\nअभ्यधावदसम्भ्रान्तः सूतपुत्रं वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055106, "chapter_id": 2205, "verse_number": "७-१३२-२७", "content_sanskrit": "तमापतन्तं वेगेन रभसं पाण्डवर्षभम्।\nकर्णः प्रत्युद्ययौ युद्धे मत्तो मत्तमिव द्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055107, "chapter_id": 2205, "verse_number": "७-१३२-२८", "content_sanskrit": "ततः प्रध्याप्य जलजं भेरीशतसमस्वनम्।\nअक्षुभ्यत बलं हर्षादुद्धूत इव सागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055108, "chapter_id": 2205, "verse_number": "७-१३२-२९", "content_sanskrit": "तदुद्धूतं बलं दृष्ट्वा नागाश्वरथपत्तिमत्।\nभीमः कर्णं समासाद्य च्छादयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055109, "chapter_id": 2205, "verse_number": "७-१३२-३०", "content_sanskrit": "अश्वानृक्षसवर्णांश्च हंसवर्णैर्हयोत्तमैः।\nव्यामिश्रयद्रणे कर्णः पाण्डवं छादयञ्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055110, "chapter_id": 2205, "verse_number": "७-१३२-३१", "content_sanskrit": "ऋक्षवर्णान्हयान्कर्कैर्मिश्रान्मारुतरंहसः।\nनिरीक्ष्य तव पुत्राणां हाहाकृतमभूद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055111, "chapter_id": 2205, "verse_number": "७-१३२-३२", "content_sanskrit": "ते हया बह्वशोभन्त मिश्रिता वातरंहसः।\nसितासिता महाराज यथा व्योम्नि वलाहकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055112, "chapter_id": 2205, "verse_number": "७-१३२-३३", "content_sanskrit": "संरब्धौ क्रोधताम्राक्षौ प्रेक्ष्य कर्णवृकोदरौ।\nसन्त्रस्ताः समकम्पन्त त्वदीयानां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055113, "chapter_id": 2205, "verse_number": "७-१३२-३४", "content_sanskrit": "यमराष्ट्रोपमं घोरमासीदायोधनं तयोः।\nदुर्दर्शं भरतश्रेष्ठ प्रेतराजपुत्रं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055114, "chapter_id": 2205, "verse_number": "७-१३२-३५", "content_sanskrit": "समाजमिव तच्चित्रं प्रेक्षमाणा महारथाः।\nनालक्षयञ्जयं व्यक्तमेकस्यैव महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055115, "chapter_id": 2205, "verse_number": "७-१३२-३६", "content_sanskrit": "तयोः प्रैक्षन्त सम्मर्दं सन्निकृष्टं महास्त्रयोः।\nतव दुर्मन्त्रिते राजन्सपुत्रस्य विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055116, "chapter_id": 2205, "verse_number": "७-१३२-३७", "content_sanskrit": "छादयन्तौ हि शत्रुघ्नावन्योन्यं सायकैः शितैः।\nशरजालावृतं व्योम चक्रातेऽद्भुतविक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055117, "chapter_id": 2205, "verse_number": "७-१३२-३८", "content_sanskrit": "तावन्योन्यं जिघांसन्तौ शरैस्तीक्ष्णैर्महारथौ।\nप्रेक्षणीयतरावास्तां वृष्टिमन्ताविवाम्बुदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055118, "chapter_id": 2205, "verse_number": "७-१३२-३९", "content_sanskrit": "सुवर्णविकृतान्वाणान्विमुञ्चन्तावरिन्दमौ।\nभास्वरं व्योम चक्राते महोल्काभिरिव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055119, "chapter_id": 2205, "verse_number": "७-१३२-४०", "content_sanskrit": "ताभ्यां मुक्ताः शरा राजन्गार्ध्रपत्राश्चकाशिरे।\nश्रेण्यः शरदि मत्तानां सारसनामिवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2055120, "chapter_id": 2205, "verse_number": "७-१३२-४१", "content_sanskrit": "संसक्तं सूतपुत्रेण दृष्ट्वा भीममरिन्दमम्।\nअतिभारममन्येतां भीमे कृष्णधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2055121, "chapter_id": 2205, "verse_number": "७-१३२-४२", "content_sanskrit": "तत्राधिरथिभीमाभ्यां शरैर्मुक्तैर्दृढं हताः।\nइषुपातमतिक्रम्य पेतुरश्वनरद्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2055122, "chapter_id": 2205, "verse_number": "७-१३२-४३", "content_sanskrit": "पतद्भिः पतितैश्चान्यैर्गतासुभिरनेकशः।\nकृतो राजन्महाराज पुत्राणां ते जनक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2055123, "chapter_id": 2205, "verse_number": "७-१३२-४४", "content_sanskrit": "मनुप्याश्वगजानां च शरीरैर्गतजीवितैः।\nक्षणेन भूमिः सञ्जज्ञे संवृता भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2055124, "chapter_id": 2205, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे द्वात्रिंशदधिकरशततमोऽध्यायः॥ १३२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३२-१ कुण्डलितौ द्वौ श्लोकौ झ. पुस्तके एव वर्तेते। भृगूत्तमधनुर्धरो रामः॥ ५-१३२-३१ कर्कैः श्वेतैरश्वैः॥ ५-१३२-३५ समाजं रङ्गं। एकस्यैव कस्यचित् नान्यस्य॥ ५-१३२-१३२ द्वात्रिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]