[{"id": 2106747, "chapter_id": 3318, "verse_number": "१८-३-१", "content_sanskrit": "वैशम्पायन उवाच।\nस्थिते मुहूर्तं पार्थे तु धर्मराजे युधिष्ठिष्ठिरे।\nआजग्मुस्तत्र कौरव्यं देवाः शक्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106748, "chapter_id": 3318, "verse_number": "१८-३-२", "content_sanskrit": "स च विग्रहवान्धर्मो राजानं संपरीक्ष्य तम्।\nतत्राजगाम यत्रासौ कुरुराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106749, "chapter_id": 3318, "verse_number": "१८-३-३", "content_sanskrit": "तेषु भासुरदेहेषु पुण्याभिजनकर्मसु।\nसमागतेषु देवेषु व्यगमत्तत्तमो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106750, "chapter_id": 3318, "verse_number": "१८-३-४", "content_sanskrit": "नादृश्यन्त च तास्तत्र यातनाः पापकर्मणाम्।\nनदी वैतरणी चैव कूटशाल्मलिना सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106751, "chapter_id": 3318, "verse_number": "१८-३-५", "content_sanskrit": "लोहकुंभ्यः शिलाश्चैव नादृश्यन्त भयानकाः।\nविकृतानि शरीराणि यानि तत्र समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106752, "chapter_id": 3318, "verse_number": "१८-३-६", "content_sanskrit": "ददर्श राजा कौरव्यस्तान्सर्वान्सुमहाप्रभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106753, "chapter_id": 3318, "verse_number": "१८-३-७", "content_sanskrit": "ततो वायुः सुखस्पर्शः पुण्यगन्धवहः शुचिः।\nववौ देवसमीपस्थः शीतलोऽतीव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106754, "chapter_id": 3318, "verse_number": "१८-३-८", "content_sanskrit": "मरुतः सह शक्रेण वसवश्चाश्विनौ सह।\nसाध्या रुद्रास्तथाऽऽदित्या ये चान्येऽपिदिवौकसः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106755, "chapter_id": 3318, "verse_number": "१८-३-९", "content_sanskrit": "सर्वे तत्र समाजग्मुः सिद्धाश्च परमर्षयः।\nयत्र राजा महातेजा धर्मपुत्रः स्थितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106756, "chapter_id": 3318, "verse_number": "१८-३-१०", "content_sanskrit": "ततः शक्रः सुरपतिः श्रिया परमया युतः।\nयुधिष्ठिरमुवाचेदं सान्त्वपूर्वमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106757, "chapter_id": 3318, "verse_number": "१८-३-११", "content_sanskrit": "युधिष्ठिर महाबाहो प्रीता देवगणास्त्वया।\nएह्येहि पुरुषव्याघ्र कृतमेतावता विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106758, "chapter_id": 3318, "verse_number": "१८-३-१२", "content_sanskrit": "सिद्धिः प्राप्ता महाबाहो लोकाश्चाप्यक्षयास्तव।\nभ्रातॄणां सुहृदां चैव गतिर्नित्या सुपूजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106759, "chapter_id": 3318, "verse_number": "१८-३-१३", "content_sanskrit": "न च मन्युस्त्वया कार्यः शृणु चेदं वचो मम।\nअवश्यं नरकस्तात द्रष्टव्यः सर्वराजभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106760, "chapter_id": 3318, "verse_number": "१८-३-१४", "content_sanskrit": "शुभानामनशुभानां च द्वौ राशी पुरुषर्षभ।\nयः पूर्वं सुकृतं भुङ्क्ते पश्चान्निरयमेति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106761, "chapter_id": 3318, "verse_number": "१८-३-१५", "content_sanskrit": "पूर्वं नरकभाग्यस्तु पश्चात्स्वर्गमुपैति सः।\nभूयिष्ठं पापकर्मा यः स पूर्वं स्वर्गमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106762, "chapter_id": 3318, "verse_number": "१८-३-१६", "content_sanskrit": "`भूयिष्ठशुभकर्मा त्वमल्पजिह्मतयाऽच्युत।\nतेन त्वमेवं गमितो मया श्रेयोर्थिना नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106763, "chapter_id": 3318, "verse_number": "१८-३-१७", "content_sanskrit": "व्याजेन हि त्वया द्रोण उपचीर्णः सुतं प्रति।\nव्याजेनैव ततो राजन्दर्शितो नरकस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106764, "chapter_id": 3318, "verse_number": "१८-३-१८", "content_sanskrit": "यथैव त्वं तथा भीमस्तथा पार्थो यमौ तथा।\nद्रौपदी च तथा कृष्णा व्याजेन नरकं गताः।\nआगच्छ नरशार्दूल मुक्तास्ते चैव कल्मषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106765, "chapter_id": 3318, "verse_number": "१८-३-१९", "content_sanskrit": "स्वपक्ष्याश्चैव ये तुभ्यं पार्थिवा निहता रणे।\nसर्वे स्वर्गमनुप्राप्तास्तान्पश्य भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106766, "chapter_id": 3318, "verse_number": "१८-३-२०", "content_sanskrit": "कर्णश्चैव महेष्वासः सर्वशस्त्रभृतांवरः।\nस गतः परमां सिद्धिं यदर्थं परितप्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106767, "chapter_id": 3318, "verse_number": "१८-३-२१", "content_sanskrit": "तं पश्य पुरुषव्याघ्रमादित्यतनयं विभो।\nस्वस्थानस्थं महाबाहो जहि शोकं नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106768, "chapter_id": 3318, "verse_number": "१८-३-२२", "content_sanskrit": "भ्रातॄन्पुत्रांस्तथा पश्य स्वपक्ष्यांश्चैव पार्थिवान्।\nस्वंस्वं स्थानमनुप्राप्तान्व्येतु ते मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106769, "chapter_id": 3318, "verse_number": "१८-३-२३", "content_sanskrit": "कृच्छ्रं पूर्वं चानुभूय इतःप्रभृति कौरव।\nविहारस्व मया सार्धं गतशोको निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106770, "chapter_id": 3318, "verse_number": "१८-३-२४", "content_sanskrit": "कर्मणां तात पुण्यानां ज्ञानानां तपसां स्वयम्।\nदानानां च महाबाहो फलं प्राप्नुहि पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106771, "chapter_id": 3318, "verse_number": "१८-३-२५", "content_sanskrit": "अद्य त्वां देवगन्दर्वा दिव्याश्चाप्सरसो दिवि।\nउपसेवन्तु कल्याणं विरजंबरभूषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106772, "chapter_id": 3318, "verse_number": "१८-३-२६", "content_sanskrit": "राजसूयजितां लोकानश्वमेधभिनिर्मितान्।\nप्राप्नुहि त्वं महाबाहो तपसश्च महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106773, "chapter_id": 3318, "verse_number": "१८-३-२७", "content_sanskrit": "उपर्युपरि राज्ञां हि तव लोकाः युधिष्ठिर।\nहरिश्चन्द्रमसः पार्थ येषु त्वं विहरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106774, "chapter_id": 3318, "verse_number": "१८-३-२८", "content_sanskrit": "मान्धाता यत्र राजर्षिर्यत्र राजा भगीरथः।\nदौष्यन्तिर्यत्र भरतस्तत्र त्वं विहरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106775, "chapter_id": 3318, "verse_number": "१८-३-२९", "content_sanskrit": "एषा देवनदी पुण्या पार्थ त्रैलोक्यपावनी।\nआकाशगङ्गा राजेन्र्र तत्राप्लुत्य गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106776, "chapter_id": 3318, "verse_number": "१८-३-३०", "content_sanskrit": "अत्र स्नातस्य भावस्ते मानुषो विगमिष्यति।\nगतशोको निरायासो मुक्तवैरो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106777, "chapter_id": 3318, "verse_number": "१८-३-३१", "content_sanskrit": "एवं ब्रुवति देवेन्द्रे कौरवेन्द्रं युधिष्ठिरम्।\nधर्मो विग्रहवान्साक्षादुवाच सुतमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106778, "chapter_id": 3318, "verse_number": "१८-३-३२", "content_sanskrit": "भोभो राजन्महाप्राज्ञ प्रीतोस्मि तव पुत्रक।\nमद्भक्त्या सत्यवाक्यैश्च क्षमया च दमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106779, "chapter_id": 3318, "verse_number": "१८-३-३३", "content_sanskrit": "एषा तृतीया जिज्ञासा तव राजन्कृता मया।\nन शक्यसे चालयितुं स्वभावात्पार्थ हेतुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106780, "chapter_id": 3318, "verse_number": "१८-३-३४", "content_sanskrit": "पूर्वं परीक्षितो हि त्वं प्रश्नाद्द्वैतवने मया।\nअरणीसहितस्यार्थे तच्च निस्तीर्णवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106781, "chapter_id": 3318, "verse_number": "१८-३-३५", "content_sanskrit": "सोदर्येषु विनष्टेषु द्रौपद्या तत्र भारत।\nश्वरूपधारिणा तत्र पुनस्त्वं मे परीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106782, "chapter_id": 3318, "verse_number": "१८-३-३६", "content_sanskrit": "इदं तृतीयं भ्रातॄणामर्थे यतस्थातुमिच्छसि।\nविशुद्धोसि महाभाग सुखी विगतकल्मषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106783, "chapter_id": 3318, "verse_number": "१८-३-३७", "content_sanskrit": "न च ते भ्रातरः पार्थ नरकार्हा विशांपतै।\nमायैषा देवराजेन महेन्द्रेणि प्रयोजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106784, "chapter_id": 3318, "verse_number": "१८-३-३८", "content_sanskrit": "अवश्यं नरकास्तात द्रष्टव्याः सर्वराजभिः।\nततस्त्वया प्राप्तमिदं मुहूर्तं दुःखमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106785, "chapter_id": 3318, "verse_number": "१८-३-३९", "content_sanskrit": "न सव्यसाची भीमो वा यमौ वा पुरुषर्षभौ।\nकर्णो वा सत्यवाक् शूरो नरकार्हाश्चिरं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106786, "chapter_id": 3318, "verse_number": "१८-३-४०", "content_sanskrit": "न कृष्णा राजपुत्री च नरकार्हा कथञ्चन।\nएह्येहि भरतश्रेष्ठ पश्य चेमांस्त्रिलोकगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106787, "chapter_id": 3318, "verse_number": "१८-३-४१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106788, "chapter_id": 3318, "verse_number": "१८-३-४१", "content_sanskrit": "एवमुक्तः स राजर्षिस्तव पूर्वपितामहः।\nजगाम सह धर्मेणि सवैश्च त्रिदिवालयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106789, "chapter_id": 3318, "verse_number": "१८-३-४२", "content_sanskrit": "गङ्गां देवनदीं पुण्यां पावनीमृषिसंस्तुताम्।\nअवगाह्य ततो राजा तनुं तत्याज मानुषीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106790, "chapter_id": 3318, "verse_number": "१८-३-४३", "content_sanskrit": "ततो विव्यवपुर्भूत्वा धर्मराजो युधिष्ठिरः।\nनिर्वैरो गतसंतापो जले तस्मिन्समाप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106791, "chapter_id": 3318, "verse_number": "१८-३-४४", "content_sanskrit": "ततो ययौ वृतो देवैः कुरुराजो युधिष्ठिरः।\nधर्मेण सहितो धीमांस्तूयमानो महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106792, "chapter_id": 3318, "verse_number": "१८-३-४५", "content_sanskrit": "यत्र ते पुरुषव्याघ्राः शूरा विगतमन्यवः।\nपाण्डवा धार्तराष्ट्राश्च स्वानि स्थानानि भेजिरे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106793, "chapter_id": 3318, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्वर्गारोहणपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]