[{"id": 7005524000, "chapter_id": 25524, "verse_number": "२-४१-१", "content_sanskrit": "सुत उवाच ।\nइंद त्रैलोक्यविख्यातं तीर्थं नैमिशमुत्तमम ।\nमहादेवाप्रियकरं महापातकनाशनम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005524001, "chapter_id": 25524, "verse_number": "२-४१-२", "content_sanskrit": "महादेवं दिद्वक्षूणामृषीणां परमेष्ठिनाम ।\nब्रह्माणा निर्मितं स्थानं तपस्तप्तुं द्विजोत्तमाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005524002, "chapter_id": 25524, "verse_number": "२-४१-३", "content_sanskrit": "मरीचयोऽत्रयो विप्रा वसिष्ठाः क्रतवस्तथा ।\nभृगवोऽगिंरसः पुर्वाः ब्रह्माणां कमलोद्भवम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005524003, "chapter_id": 25524, "verse_number": "२-४१-४", "content_sanskrit": "समेत्य सर्ववरदं चतुर्मुर्तिं चतुर्मुखम ।\nपृच्छन्ति प्रणिपत्यैनं विश्वकर्माणमच्युतम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005524004, "chapter_id": 25524, "verse_number": "२-४१-५", "content_sanskrit": "षटकुलीया ऊचुः  ।\nभगवन देवमीशानं भर्गमेकं कपार्दिनम ।\nकेनोपायेन पश्यामो ब्रुहि देवनमस्कृतम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005524005, "chapter_id": 25524, "verse_number": "२-४१-६", "content_sanskrit": "ब्रह्मोवाच सत्रं सहस्त्रमासध्वं वाडमनोदोषवर्जिताः ।\nदेशं च वः प्रवक्ष्यामि यस्मिन देशे चरिष्यथ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005524006, "chapter_id": 25524, "verse_number": "२-४१-७", "content_sanskrit": "उक्त्वा मनोमयं चक्रं स सृष्टा तानुवाच ह ।\nक्षिप्तमेतन्मया चक्रमनव्रजत मा चिरम ।\nयत्रास्य नेमिः शीर्येत स देशः पुरुषर्षभाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005524007, "chapter_id": 25524, "verse_number": "२-४१-८", "content_sanskrit": "ततो मुमोच तच्चक्रं ते च तत्समनुव्रजन ।\nतस्य वै व्रजतः क्षिप्रं यत्र नेमिरशीर्यत ।\nनैमिशं तत्स्मृतं नाम्रां पुण्यं सर्वत्र पूजितम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005524008, "chapter_id": 25524, "verse_number": "२-४१-९", "content_sanskrit": "सिद्धचारणसंकीर्ण यक्षगन्धर्वसेवितम ।\nस्थानं भगवतः शम्भोरेतन्नैमिशमुत्तमम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005524009, "chapter_id": 25524, "verse_number": "२-४१-१०", "content_sanskrit": "अत्र देवाः सगन्धर्वाः सयक्षोरगराक्षसाः ।\nतपस्तप्त्वा पुरा देवा लेभिरे प्रवरान वरान ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005524010, "chapter_id": 25524, "verse_number": "२-४१-११", "content_sanskrit": "इमं देशं समाश्रित्यं षटकुलीयाः समाहिताः ।\nसत्रेणाराध्य देवेशं दृष्टावन्तो महेश्वरम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005524011, "chapter_id": 25524, "verse_number": "२-४१-१२", "content_sanskrit": "अत्र दानं तपस्तत्पं स्नानं जप्यादिकं च यत ।\nएकैकं पावयेत पापं सप्तजन्मकृतं द्विजाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005524012, "chapter_id": 25524, "verse_number": "२-४१-१३", "content_sanskrit": "अत्र पुर्वं स भगवानुषीणां सत्रमासाताम ।\nप्रोवाच वायुर्ब्रह्माण्डं पुराणं ब्रह्माभाषितम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005524013, "chapter_id": 25524, "verse_number": "२-४१-१४", "content_sanskrit": "अत्र देवो महादेवो रुद्राण्या किल विश्‍वकृत ।\nरमतेऽद्यापि भगवान प्रमथैः परिवारितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005524014, "chapter_id": 25524, "verse_number": "२-४१-१५", "content_sanskrit": "अत्र प्राणान परित्यज्य नियमेन द्विजातयः ।\nब्रह्मालोकं गमिष्यन्ति यत्र गत्वा न जायते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005524015, "chapter_id": 25524, "verse_number": "२-४१-१६", "content_sanskrit": "अन्यच्च तीर्थप्रवरं जाप्येश्वरमितिश्रुतम ।\nजजाप रुद्रमनिशं यत्र नन्दी महागणः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005524016, "chapter_id": 25524, "verse_number": "२-४१-१७", "content_sanskrit": "प्रीतस्तस्य महादेवो देव्या सह पिनाकधृक ।\nददावात्मसमानत्वं मृत्युवत्र्चनमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005524017, "chapter_id": 25524, "verse_number": "२-४१-१८", "content_sanskrit": "अभूदृषिः स धर्मात्मा शिलादो नाम धर्मवित ।\nआराधयन्महादेवं पुत्रार्थ वृषभध्वजम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005524018, "chapter_id": 25524, "verse_number": "२-४१-१९", "content_sanskrit": "तस्य वर्शसहस्त्रान्ते तप्यमानस्य विश्वकृत ।\nशर्वः सोमो गणवृतो वरदोऽस्मीत्यभाषत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005524019, "chapter_id": 25524, "verse_number": "२-४१-२०", "content_sanskrit": "स वव्रे वरमीशानं वरेण्यं गिरिजापतिम ।\nअयोनिजं मृत्युहिनं देहि पुत्रं त्वया समम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005524020, "chapter_id": 25524, "verse_number": "२-४१-२१", "content_sanskrit": "तथास्त्वित्याह भगवान देव्या सह महेश्वरः ।\nपश्यतस्तस्य विप्रर्षेरन्तर्धानं गतो हरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005524021, "chapter_id": 25524, "verse_number": "२-४१-२२", "content_sanskrit": "ततो यियक्षुः स्वां भूमिं शिलादो धर्मवित्तमः ।\nचकर्ष लांगलेनोर्वा भित्वादृश्यत शोभनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005524022, "chapter_id": 25524, "verse_number": "२-४१-२३", "content_sanskrit": "संवर्तकानलप्रख्यः कुमारः प्रहसान्निव ।\nरुपलावण्यसम्पन्नस्तेजसा भासयन दिशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005524023, "chapter_id": 25524, "verse_number": "२-४१-२४", "content_sanskrit": "कुमारतुल्योऽप्रतिमो मेघगम्भीरया गिरा ।\nशिलादं तात तातेति प्राह नन्दी पुनः पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005524024, "chapter_id": 25524, "verse_number": "२-४१-२५", "content_sanskrit": "तं दृष्टः नन्दनं जातं शिलादः परिषस्वजे ।\nमुनिभ्यो दर्शयामास ये तदाश्रमवासिनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005524025, "chapter_id": 25524, "verse_number": "२-४१-२६", "content_sanskrit": "जातकर्मादिकाः सर्वाः क्रियास्तस्य चकार ह ।\nउपनीय यथाशास्त्रं वेदमध्यापयत सुतम ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005524026, "chapter_id": 25524, "verse_number": "२-४१-२७", "content_sanskrit": "अधीतवेदो भगवान नन्दी मतिमनुत्तमाम ।\nचक्रे महेश्वरं द्रष्टुं जेष्यें मृत्युमिति प्रभुम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005524027, "chapter_id": 25524, "verse_number": "२-४१-२८", "content_sanskrit": "स गत्वा सरितं पुण्यमेकाग्रश्रद्धायन्वितः ।\nजजाप रुद्रमनिशं महेषासक्तमानसः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005524028, "chapter_id": 25524, "verse_number": "२-४१-२९", "content_sanskrit": "तस्य कोट्यं तु पुर्णायां शंकरो भक्तवत्सलः ।\nआगत्य साम्बः सगणो वरदोऽस्मीत्युवाच ह ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005524029, "chapter_id": 25524, "verse_number": "२-४१-३०", "content_sanskrit": "स वव्रे पुनरेवाहं जपेयं कोटिमीश्‍वरम ।\nतावदायुर्महादेव देहिति वरमीश्वर ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005524030, "chapter_id": 25524, "verse_number": "२-४१-३१", "content_sanskrit": "एवमस्त्विति सम्प्रोच्य देवोऽप्यन्तरधीयत ।\nजजाप कोटिं भगवान भुयस्तदगतमानसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005524031, "chapter_id": 25524, "verse_number": "२-४१-३२", "content_sanskrit": "द्वितीयायां च कोट्यां वै सम्पुर्णायां वृषध्वजः ।\nआगत्य वरदोऽस्मीति प्राह भूतगणैर्वृतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005524032, "chapter_id": 25524, "verse_number": "२-४१-३३", "content_sanskrit": "तृतीयां जप्तुमिच्छामि कोटिं भुयोऽपि शंकर ।\nतथास्त्वित्याह विश्‍वात्मा देवोऽप्यन्तरधीयत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005524033, "chapter_id": 25524, "verse_number": "२-४१-३४", "content_sanskrit": "कोटित्रयेऽथ सम्पुर्ण देवः प्रीतमना भृशम ।\nआगत्य वरदोऽस्मीति प्राह भूतगणैर्वृतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005524034, "chapter_id": 25524, "verse_number": "२-४१-३५", "content_sanskrit": "जपेयं कोटिमन्यां वैं भूयोऽपि तव तेजसा ।\nइत्युक्ते भगवानाह न जप्तव्यं त्वया पुनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005524035, "chapter_id": 25524, "verse_number": "२-४१-३६", "content_sanskrit": "अमरो जरया त्यक्तो मम पार्श्वगतः सदा ।\nमहागणपतिर्देव्याः पुत्रो भव महेश्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005524036, "chapter_id": 25524, "verse_number": "२-४१-३७", "content_sanskrit": "योगीश्वरो योगनेता गणानामीश्वरेश्वरः ।\nसर्वलोकाधिपः श्रीमान सर्वज्ञो मदबलान्वितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005524037, "chapter_id": 25524, "verse_number": "२-४१-३८", "content_sanskrit": "ज्ञानं तन्मामकं दिव्यंक हस्तामलकवत तव ।\nआभुतसम्प्लवस्थायी ततो यास्यासि मत्पदम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005524038, "chapter_id": 25524, "verse_number": "२-४१-३९", "content_sanskrit": "एतदुक्त्वा महादेवो गणानाहुया शंकरः ।\nअभिषेकेण युक्तेने नन्दीश्‍वरमयोजयत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005524039, "chapter_id": 25524, "verse_number": "२-४१-४०", "content_sanskrit": "उद्वाहयामास च तं स्वयमेव पिनाकधृक ।\nमरुतां च शुभां कन्यां सुयशेति च विश्रुताम ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005524040, "chapter_id": 25524, "verse_number": "२-४१-४१", "content_sanskrit": "एतज्जप्येश्‍वरं स्थानं देवदेवस्यं शुलिनः ।\nयत्र तत्र मृतो मर्त्यो रुद्रलोके महीयते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]