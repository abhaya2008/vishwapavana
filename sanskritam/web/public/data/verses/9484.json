[{"id": 5000484000, "chapter_id": 9484, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000484001, "chapter_id": 9484, "verse_number": "६-७७-१", "content_sanskrit": "निकुम्भो भ्रातरं दृष्ट्वा सुग्रीवेण निपातितम्।\nप्रदहन्निव कोपेन वानरेन्द्रमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000484002, "chapter_id": 9484, "verse_number": "६-७७-२", "content_sanskrit": "ततः स्रग्दामसंनद्धं दत्तपञ्चाङ्गुलं शुभम्।\nआददे परिघं धीरो महेन्द्रशिखरोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000484003, "chapter_id": 9484, "verse_number": "६-७७-३", "content_sanskrit": "हेमपट्टपरिक्षिप्तं वज्रविद्रुमभूषितम्।\nयमदण्डोपमं भीमं रक्षसां भयनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000484004, "chapter_id": 9484, "verse_number": "६-७७-४", "content_sanskrit": "तमाविध्य महातेजाः शक्रध्वजसमौजसम्।\nनिननाद विवृत्तास्यो निकुम्भो भीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000484005, "chapter_id": 9484, "verse_number": "६-७७-५", "content_sanskrit": "उरोगतेन निष्केण भुजस्थैरङ्गदैरपि।\nकुण्डलाभ्यां च चित्राभ्यां मालया च सचित्रया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000484006, "chapter_id": 9484, "verse_number": "६-७७-६", "content_sanskrit": "निकुम्भो भूषणैर्भाति तेन स्म परिघेण च।\nयथेन्द्रधनुषा मेघः सविद्युत्स्तनयित्नुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000484007, "chapter_id": 9484, "verse_number": "६-७७-७", "content_sanskrit": "परिघाग्रेण पुस्फोट वातग्रन्थिर्महात्मनः।\nप्रजज्वाल सघोषश्च विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000484008, "chapter_id": 9484, "verse_number": "६-७७-८", "content_sanskrit": "नगर्या विटपावत्या गन्धर्वभवनोत्तमैः।\nसतारागणनक्षत्रं सचन्द्रसमहाग्रहम्।\nनिकुम्भपरिघाघूर्णं भ्रमतीव नभस्थलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000484009, "chapter_id": 9484, "verse_number": "६-७७-९", "content_sanskrit": "दुरासदश्च संजज्ञे परिघाभरणप्रभः।\nक्रोधेन्धनो निकुम्भाग्निर्युगान्ताग्निरिवोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000484010, "chapter_id": 9484, "verse_number": "६-७७-१०", "content_sanskrit": "राक्षसा वानराश्चापि न शेकुः स्पन्दितुं भयात्।\nहनुमांस्तु विवृत्योरस्तस्थौ प्रमुखतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000484011, "chapter_id": 9484, "verse_number": "६-७७-११", "content_sanskrit": "परिघोपमबाहुस्तु परिघं भास्करप्रभम्।\nबली बलवतस्तस्य पातयामास वक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000484012, "chapter_id": 9484, "verse_number": "६-७७-१२", "content_sanskrit": "स्थिरे तस्योरसि व्यूढे परिघः शतधा कृतः।\nविकीर्यमाणः सहसा उल्काशतमिवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000484013, "chapter_id": 9484, "verse_number": "६-७७-१३", "content_sanskrit": "स तु तेन प्रहारेण न चचाल महाकपिः।\nपरिघेण समाधूतो यथा भूमिचलेऽचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000484014, "chapter_id": 9484, "verse_number": "६-७७-१४", "content_sanskrit": "स तथाभिहतस्तेन हनूमान् प्लवगोत्तमः।\nमुष्टिं संवर्तयामास बलेनातिमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000484015, "chapter_id": 9484, "verse_number": "६-७७-१५", "content_sanskrit": "तमुद्यम्य महातेजा निकुम्भोरसि वीर्यवान्।\nअभिचिक्षेप वेगेन वेगवान् वायुविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000484016, "chapter_id": 9484, "verse_number": "६-७७-१६", "content_sanskrit": "तत्र पुस्फोट वर्मास्य प्रसुस्राव च शोणितम्।\nमुष्टिना तेन संजज्ञे मेघे विद्युदिवोत्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000484017, "chapter_id": 9484, "verse_number": "६-७७-१७", "content_sanskrit": "स तु तेन प्रहारेण निकुम्भो विचचाल च।\nस्वस्थश्चापि निजग्राह हनूमन्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000484018, "chapter_id": 9484, "verse_number": "६-७७-१८", "content_sanskrit": "चुक्रुशुश्च तदा संख्ये भीमं लङ्कानिवासिनः।\nनिकुम्भेनोद्यतं दृष्ट्वा हनूमन्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000484019, "chapter_id": 9484, "verse_number": "६-७७-१९", "content_sanskrit": "स तथा ह्रियमाणोऽपि हनूमांस्तेन रक्षसा।\nआजघानानिलसुतो वज्रकल्पेन मुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000484020, "chapter_id": 9484, "verse_number": "६-७७-२०", "content_sanskrit": "आत्मानं मोक्षयित्वाथ क्षितावभ्यवपद्यत।\nहनूमानुन्ममाथाशु निकुम्भं मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000484021, "chapter_id": 9484, "verse_number": "६-७७-२१", "content_sanskrit": "निक्षिप्य परमायत्तो निकुम्भं निष्पिपेष च।\nउत्पत्य चास्य वेगेन पपातोरसि वेगवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000484022, "chapter_id": 9484, "verse_number": "६-७७-२२", "content_sanskrit": "परिगृह्य च बाहुभ्यां परिवृत्य शिरोधराम्।\nउत्पाटयामास शिरो भैरवं नदतो महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000484023, "chapter_id": 9484, "verse_number": "६-७७-२३", "content_sanskrit": "अथ निनदति सादिते निकुम्भे\nपवनसुतेन रणे बभूव युद्धम्।\nदशरथसुतराक्षसेन्द्रसून्वो-\nर्भृशतरमागतरोषयोः सुभीमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000484024, "chapter_id": 9484, "verse_number": "६-७७-२४", "content_sanskrit": "व्यपेते तु जीवे निकुम्भस्य हृष्टा\nविनेदुः प्लवंगा दिशः सस्वनुश्च।\nचचालेव चोर्वी पपातेव सा द्यौ-\nर्बलं राक्षसानां भयं चाविवेश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000484025, "chapter_id": 9484, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]