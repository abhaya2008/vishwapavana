[{"id": 2194860, "chapter_id": 5142, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194861, "chapter_id": 5142, "verse_number": "१", "content_sanskrit": "अथ तेन नरश्रेष्ठ ब्राह्मणेन तपस्विना ।\nनिराहारेण वसता दुःखितास्ते भुजङ्गमाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194862, "chapter_id": 5142, "verse_number": "२", "content_sanskrit": "सर्वे सम्भूय सहितास्तस्य नागस्य बान्धवाः ।\nभ्रातरस्तनया भार्या ययुस्तं ब्राह्मणं प्रति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194863, "chapter_id": 5142, "verse_number": "३", "content_sanskrit": "तेऽपश्यन् पुलिने तं वै विविक्ते नियतव्रतम् ।\nसमासीनं निराहारं द्विजं जप्यपरायणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194864, "chapter_id": 5142, "verse_number": "४", "content_sanskrit": "ते सर्वे समभिक्रम्य विप्रमभ्यर्च्य चासकृत् ।\nऊचुर्वाक्यमसंदिग्धमातिथेयस्य बान्धवाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194865, "chapter_id": 5142, "verse_number": "५", "content_sanskrit": "षष्ठो हि दिवसस्तेऽद्य प्राप्तस्येह तपोधन ।\nन चाभिलषसे किञ्चिदाहारं धर्मवत्सल\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194866, "chapter_id": 5142, "verse_number": "६", "content_sanskrit": "अस्मानभिगतश्चासि वयं च त्वामुपस्थिताः ।\nकार्यं चातिथ्यमस्माभिर्वयं सर्वे कुटुम्बिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194867, "chapter_id": 5142, "verse_number": "७", "content_sanskrit": "मूलं फलं वा पर्णं वा पयो वा द्विजसत्तम ।\nआहारहेतोरन्नं वा भोक्तुमर्हसि ब्राह्मण\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194868, "chapter_id": 5142, "verse_number": "८", "content_sanskrit": "त्यक्ताहारेण भवता वने निवसता सता ।\nबालवृद्धमिदं सर्वं पीड्यते धर्मसङ्कटात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194869, "chapter_id": 5142, "verse_number": "९", "content_sanskrit": "न हि नो भ्रूणहा कश्चिद् राजापथ्योऽनृतोऽपि वा ।\nपूर्वाशी वा कुले ह्यस्मिन् देवतातिथिबन्धुषु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194870, "chapter_id": 5142, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194871, "chapter_id": 5142, "verse_number": "१०", "content_sanskrit": "उपदेशेन युष्माकमाहारोऽयं मया वृतः ।\nद्विरूनं दशरात्रं वै नागस्यागमनं प्रति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194872, "chapter_id": 5142, "verse_number": "११", "content_sanskrit": "यद्यष्टरात्रे निर्याते नागमिष्यति पन्नगः ।\nतदाहारं करिष्यामि तन्निमित्तमिदं व्रतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194873, "chapter_id": 5142, "verse_number": "१२", "content_sanskrit": "कर्तव्यो न च सन्तापो गम्यतां च यथागतम् ।\nतन्निमित्तं व्रतं मह्यं नैतद् भेत्तुमिहार्हथ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2194874, "chapter_id": 5142, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2194875, "chapter_id": 5142, "verse_number": "१३", "content_sanskrit": "तेन ते समनुज्ञाता ब्राह्मणेन भुजङ्गमाः ।\nस्वमेव भवनं जग्मुरकृतार्था नरर्षभ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2194876, "chapter_id": 5142, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकनवत्युत्तरशततमोऽध्यायः ॥१९१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]