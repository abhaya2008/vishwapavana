[{"id": 7005113000, "chapter_id": 25113, "verse_number": "७-१-२९६-१", "content_sanskrit": "ईश्वर उवाच ।\nतस्मादाग्नेयदिग्भागे गव्यूतिसप्तकेन च ।\nस्थानं देवकुलंनाम देवानां यत्र संगमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005113001, "chapter_id": 25113, "verse_number": "७-१-२९६-२", "content_sanskrit": "ऋषीणां यत्र सिद्धानां पुरा लिंगे निपातिते ।\nयस्माज्जातो महादेवि तस्माद्देवकुलं स्मृतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005113002, "chapter_id": 25113, "verse_number": "७-१-२९६-३", "content_sanskrit": "तस्य पश्चिमदिग्भाग ऋषितोया महानदी ।\nऋषीणां वल्लभा देवि सर्वपातकनाशिनी ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005113003, "chapter_id": 25113, "verse_number": "७-१-२९६-४", "content_sanskrit": "तत्र स्नात्वा नरः सम्यक्पितॄणां निर्वपेन्नरः ।\nसप्तवर्षायुतान्येव पितॄणां तृप्तिमावहेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005113004, "chapter_id": 25113, "verse_number": "७-१-२९६-५", "content_sanskrit": "सुवर्णं तत्र देयं तु अजिनं कंबलं तथा ।\nआषाढे त्वमावास्यायां यत्किञ्चिद्दीयते ध्रुवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005113005, "chapter_id": 25113, "verse_number": "७-१-२९६-६", "content_sanskrit": "वर्द्धते षोडशगुणं यावदायाति पूर्णिमा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005113006, "chapter_id": 25113, "verse_number": "७-१-२९६-७", "content_sanskrit": "सुवर्णं तत्र देयं तु अजिनं कंबलं तथा ।\nमुच्यते पातकैः सर्वैः सप्तजन्मकृतैरपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005113007, "chapter_id": 25113, "verse_number": "७-१-२९६-८", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्य ऋषितोयानदीमाहात्म्यवर्णनंनाम षण्णवत्युत्तरद्विशततमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]