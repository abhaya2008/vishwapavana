[{"id": 7000709000, "chapter_id": 20709, "verse_number": "६-५२-१", "content_sanskrit": "युधिष्ठिरौवाच ।\nआषाढकृष्णपक्षे तु किं वै एकादशी भवेत् ।\nकथयस्व प्रसादेन वासुदेव ममाग्रतः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000709001, "chapter_id": 20709, "verse_number": "६-५२-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nव्रतानामुत्तमं राजन्कथयामि तवाग्रतः ।\nसर्वपापक्षयकरं सर्वमुक्तिप्रदायकम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000709002, "chapter_id": 20709, "verse_number": "६-५२-३", "content_sanskrit": "आषाढस्यासिते पक्षे योगिनी नाम नामतः ।\nएकादशी नृपश्रेष्ठ महापातकनाशिनी ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000709003, "chapter_id": 20709, "verse_number": "६-५२-४", "content_sanskrit": "संसारार्णवमग्नानां पोतभूता सनातनी ।\nजगत्त्रये सारभूता योगिनी व्रतकारिणाम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000709004, "chapter_id": 20709, "verse_number": "६-५२-५", "content_sanskrit": "कथयामि तवाग्रेऽहं कथां पौराणिकीं शुभाम् ।\nअलकायां राजराजः शिवभक्तिपरायणः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000709005, "chapter_id": 20709, "verse_number": "६-५२-६", "content_sanskrit": "तस्यासीत्पुष्पबटुको हेममालीति नामतः ।\nतस्य पत्नी सुरूपा च विशालाक्षीति नामतः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000709006, "chapter_id": 20709, "verse_number": "६-५२-७", "content_sanskrit": "स तस्यां चासक्तमना कामपाशवशं गतः ।\nमानसात्पुष्पनिचयमानीय स्वगृहे स्थितः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000709007, "chapter_id": 20709, "verse_number": "६-५२-८", "content_sanskrit": "पत्नीप्रेमरसासक्तो न कुबेरालयं गतः ।\nकुबेरो देवसदने करोति शिवपूजनम् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000709008, "chapter_id": 20709, "verse_number": "६-५२-९", "content_sanskrit": "मध्याह्नसमये राजन्पुष्पागमसमीक्षकः ।\nहेममाली स्वभवने रमते कांतया सह ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000709009, "chapter_id": 20709, "verse_number": "६-५२-१०", "content_sanskrit": "यक्षराट्प्रत्युवाचाथ कालातिक्रमकोपितः ।\nकस्मान्नायाति भो यक्षा हेममाली दुरात्मवान् ।\nनिश्चयः क्रियतामस्य इत्युवाच पुनः पुनः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000709010, "chapter_id": 20709, "verse_number": "६-५२-११", "content_sanskrit": "यक्षा ऊचुः ।\nवनिताकामुको गेहे रमते स्वेच्छया नृप ।\nतेषां वाक्यं समाकर्ण्य कुबेरः कोपपूरितः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000709011, "chapter_id": 20709, "verse_number": "६-५२-१२", "content_sanskrit": "आह्वयामास तं तूर्णं बटुकं हेममालिनम् ।\nज्ञात्वा कालात्ययं सोऽपि भयव्याकुललोचनः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000709012, "chapter_id": 20709, "verse_number": "६-५२-१३", "content_sanskrit": "अस्नात एव आगत्य कुबेरस्याग्रतः स्थितः ।\nतं दृष्ट्वा धनदः क्रुद्धः क्रोधसंरक्तलोचनः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000709013, "chapter_id": 20709, "verse_number": "६-५२-१४", "content_sanskrit": "प्रत्युवाच रुषाविष्टः कोपप्रस्फुरिताधरः ।\nधनद उवाच ।\nआः पाप दुष्ट दुर्वृत्त कृतवान्देवहेलनम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000709014, "chapter_id": 20709, "verse_number": "६-५२-१५", "content_sanskrit": "अष्टादशकुष्ठवृतो वियुक्तः कांतया तया ।\nअस्मात्स्थानादपध्वस्तो गच्छ स्वप्नमथाधम ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000709015, "chapter_id": 20709, "verse_number": "६-५२-१६", "content_sanskrit": "इत्युक्ते वचने तस्य तस्मात्स्थानात्पपात सः ।\nमहादुःखाभिभूतश्च कुष्ठैः पीडितविग्रहः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000709016, "chapter_id": 20709, "verse_number": "६-५२-१७", "content_sanskrit": "न सुखं दिवसे तस्य न निद्रां लभते निशि ।\nछायायां पीडिततनुर्निदाघेऽत्यंतपीडितः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000709017, "chapter_id": 20709, "verse_number": "६-५२-१८", "content_sanskrit": "शिवपूजाप्रभावेन स्मृतिस्तस्य न लुप्यते ।\nपातकेनाभिभूतोऽपि पूर्वं कर्म स्मरत्यसौ ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000709018, "chapter_id": 20709, "verse_number": "६-५२-१९", "content_sanskrit": "भ्रममाणस्ततो गच्छन्हिमाद्रिं पर्वतोत्तमम् ।\nतत्रापश्यन्मुनिवरं मार्कंडेयं तपोनिधिम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000709019, "chapter_id": 20709, "verse_number": "६-५२-२०", "content_sanskrit": "यस्यायुर्विद्यते राजन्ब्रह्मणो वयसा समम् ।\nववंदे चरणौ तस्य दूरतः पापकर्मकृत् ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000709020, "chapter_id": 20709, "verse_number": "६-५२-२१", "content_sanskrit": "मार्कंडेयो मुनिवरो दृष्ट्वा तं कंपितं तथा ।\nपरोपकरणार्थाय समाहूयेदमब्रवीत् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000709021, "chapter_id": 20709, "verse_number": "६-५२-२२", "content_sanskrit": "कस्मात्कुष्ठाभिभूतस्त्वं कुतो निंद्यतरो ह्यसि ।\nइत्युक्तः स प्रत्युवाच मार्कंडेयं महामुनिम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000709022, "chapter_id": 20709, "verse_number": "६-५२-२३", "content_sanskrit": "हेममाल्युवाच ।\nराजराजस्यानुचरो हेममालीति नामतः ।\nमानसात्पद्मनिचयमानीय प्रत्यहं मुने ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000709023, "chapter_id": 20709, "verse_number": "६-५२-२४", "content_sanskrit": "शिवपूजनवेलायां कुबेराय समर्पये ।\nएकस्मिन्दिवसे चैव कालश्चाविदितो मया ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000709024, "chapter_id": 20709, "verse_number": "६-५२-२५", "content_sanskrit": "पत्नीसौख्यप्रसक्तेन शोकव्याकुलचेतसा ।\nततः क्रुद्धेन शप्तोऽस्मि राजराजेन वै मुने ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000709025, "chapter_id": 20709, "verse_number": "६-५२-२६", "content_sanskrit": "कुष्ठाभिभूतः संजातो वियुक्तः कांतया तया ।\nअधुना तव सान्निध्यं प्राप्तोऽस्मि शुभकर्मणा ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000709026, "chapter_id": 20709, "verse_number": "६-५२-२७", "content_sanskrit": "सतां स्वभावतश्चित्तं परोपकरणे क्षमम् ।\nइति ज्ञात्वा मुनिश्रेष्ठ मां प्रशाधि कृतागसम् ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000709027, "chapter_id": 20709, "verse_number": "६-५२-२८", "content_sanskrit": "मार्कंडेय उवाच ।\nत्वया सत्यमिह प्रोक्तं नासत्यं भाषितं यतः ।\nअतो व्रतोपदेशं ते कथयामि शुभप्रदम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000709028, "chapter_id": 20709, "verse_number": "६-५२-२९", "content_sanskrit": "आषाढे कृष्णपक्षे तु योगिनीव्रतमाचर ।\nअस्य व्रतस्य पुण्येन कुष्ठं यास्यति वै ध्रुवम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000709029, "chapter_id": 20709, "verse_number": "६-५२-३०", "content_sanskrit": "इति वाक्यमृषेः श्रुत्वा दंडवत्पतितो भुवि ।\nउत्थापितः स मुनिना बभूवातीव हर्षितः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000709030, "chapter_id": 20709, "verse_number": "६-५२-३१", "content_sanskrit": "मार्कंडेयोपदेशेन व्रतं तेन कृतं यथा ।\nअष्टादशेव कुष्ठानि गतानि तस्य सर्वशः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000709031, "chapter_id": 20709, "verse_number": "६-५२-३२", "content_sanskrit": "मुनेर्वाचा ततः सम्यग्व्रते चीर्णेऽभवत्सुखी ।\nईदृग्विधं नृपश्रेष्ठ कथितं योगिनीव्रतम् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000709032, "chapter_id": 20709, "verse_number": "६-५२-३३", "content_sanskrit": "अष्टाशीतिसहस्राणि द्विजान्भोजयते तु यः ।\nतत्समं फलमाप्नोति योगिनीव्रतकृन्नरः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000709033, "chapter_id": 20709, "verse_number": "६-५२-३४", "content_sanskrit": "महापापप्रशमनं महापुण्यफलप्रदम् ।\nपठनाच्छ्रवणान्मर्त्यः सर्वपापैः प्रमुच्यते ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]