[{"id": 7003246000, "chapter_id": 23246, "verse_number": "१-४९-१", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003246001, "chapter_id": 23246, "verse_number": "१-४९-२", "content_sanskrit": "शतमेकं सहस्राणां योजनानां स तु स्मृतः  ।\nअनुद्वीपं सहस्राणां द्विगुणं द्विगुणोत्तरम्।। १", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003246002, "chapter_id": 23246, "verse_number": "१-४९-३", "content_sanskrit": "पंचाशत्कोटिविस्तीर्णा ससमुद्रा धरा स्मृता  ।\nद्वीपैश्च सप्तभिर्युक्ता लोकालोकावृता शुभा।। २", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003246003, "chapter_id": 23246, "verse_number": "१-४९-४", "content_sanskrit": "नीलस्तथोत्तरे मेरोः श्वेतस्तस्योत्तरे पुनः  ।\nश्रृंगी तस्योत्तरे विप्रास्त्रयस्ते वर्षपर्वताः।। ३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003246004, "chapter_id": 23246, "verse_number": "१-४९-५", "content_sanskrit": "जठरो देवकूटश्च पूर्वस्यां दिशि पर्वतौ  ।\nनिषधो दक्षिणे मेरोस्तस्य दक्षिणतो गिरिः  ।\nहेमकूट इति ख्यातो हिमवांस्तस्य दक्षिणे।। ४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003246005, "chapter_id": 23246, "verse_number": "१-४९-६", "content_sanskrit": "मेरोः पश्चिमतश्चैव पर्वतौ द्वौ धराधरौ  ।\nमाल्यवान्गंधमादश्च द्वावेतावुद गायतौ।। ५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003246006, "chapter_id": 23246, "verse_number": "१-४९-७", "content_sanskrit": "एते पर्वतराजानः सिद्धचारणसेविताः  ।\nतेषामंतरविष्कंभो नवसाहस्रमेकशः।। ६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003246007, "chapter_id": 23246, "verse_number": "१-४९-८", "content_sanskrit": "इदं हैमवतं वर्षं भारतं नाम विश्रुतम्  ।\nहेमकूटं परं तस्मान्नाम्ना किंपुरुषं स्मृतम्।। ७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003246008, "chapter_id": 23246, "verse_number": "१-४९-९", "content_sanskrit": "नैषधं हेमकूटात्तु हरिवर्षं तदुच्यते  ।\nहरिवर्षात्परं चैव मेरोः शुभमिलावृतम्।। ८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003246009, "chapter_id": 23246, "verse_number": "१-४९-१०", "content_sanskrit": "इलावृतात्परं नीलं रम्यकं नाम विश्रुतम्  ।\nरम्यात्परतरं श्वेतं विख्यातं तद्धिरण्मयम्।। ९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003246010, "chapter_id": 23246, "verse_number": "१-४९-११", "content_sanskrit": "हिरण्मयात्परं चापि श्रृंगी चैव कुरुः स्मृतः  ।\nधनुः संस्थे तु विज्ञेये द्वे वर्षे दक्षिणोत्तरे।। १०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003246011, "chapter_id": 23246, "verse_number": "१-४९-१२", "content_sanskrit": "दीर्घाणि तत्र चत्वारी मध्यतस्तदिलावृतम्  ।\nमेरोः पश्चिमपूर्वेण द्वे तु दीर्घे तरे स्मृते।। ११", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003246012, "chapter_id": 23246, "verse_number": "१-४९-१३", "content_sanskrit": "अर्वाक्तु निषधस्याथ वेद्यर्धं चोत्तरं स्मृतम्  ।\nवेद्यर्धे दक्षिणे त्रीणि वर्षाणि त्रीणि चोत्तरे।। १२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003246013, "chapter_id": 23246, "verse_number": "१-४९-१४", "content_sanskrit": "तयोर्मध्ये च विज्ञेयं मेरुमध्यमिलावृतम्  ।\nदक्षिणेन तु नीलस्य निषधस्योत्तरेण तु।। १३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003246014, "chapter_id": 23246, "verse_number": "१-४९-१५", "content_sanskrit": "उदगायतो महाशैलो माल्यवान्नाम पर्वतः  ।\nयोजनानां सहस्रे द्वे उपरिष्टात्तु विस्तृतः।। १४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003246015, "chapter_id": 23246, "verse_number": "१-४९-१६", "content_sanskrit": "आयामतश्चतुस्त्रिंशत्सहस्राणि प्रकीर्तितः  ।\nतस्य प्रतीच्यां विज्ञेयः पर्वतो गंधमादनः।। १५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003246016, "chapter_id": 23246, "verse_number": "१-४९-१७", "content_sanskrit": "आयामतः स विज्ञेयो माल्यवानिव विस्तृतः  ।\nजबूंद्वीपस्य विस्तारात्समेन तु समंततः।। १६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003246017, "chapter_id": 23246, "verse_number": "१-४९-१८", "content_sanskrit": "प्रागायताः सुपर्वाणः षडेते वर्षपर्वताः  ।\nअवगाढाश्चोभयतः समुद्रौ पूर्वपश्चिमौ।। १७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003246018, "chapter_id": 23246, "verse_number": "१-४९-१९", "content_sanskrit": "हिमप्रायस्तु हिमवान् हेमकूटस्तु हेमवान्  ।\nतरुणादित्यसंकाशो हौरण्यो निषधः स्मृतः।। १८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003246019, "chapter_id": 23246, "verse_number": "१-४९-२०", "content_sanskrit": "चतुर्वर्णः ससौवर्णो मेरुश्चोर्ध्वायतः स्मृतः  ।\nवृत्ताकृतिपरीणाहश्चातुरस्रः समुत्थितः।। १९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003246020, "chapter_id": 23246, "verse_number": "१-४९-२१", "content_sanskrit": "नीलश्च वैडूर्यमयः श्वेतः शुक्लो हिरण्मयः  ।\nमयूरबर्हवर्णस्तु शातकुंभस्त्रिश्रृंगवान्।। २०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003246021, "chapter_id": 23246, "verse_number": "१-४९-२२", "content_sanskrit": "एवं संक्षेपतः प्रोक्ताः पुनः श्रृणु गिरीश्वरान्  ।\nमंदरो देवकूटश्च पूर्वस्यां दिशि पर्वतौ।। २१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003246022, "chapter_id": 23246, "verse_number": "१-४९-२३", "content_sanskrit": "कैलासो गंधमादश्च हेमवांश्चैव पर्वतौ  ।\nपूर्वतश्चायतावेतावर्णवांतर्व्यवस्थितौ।। २२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003246023, "chapter_id": 23246, "verse_number": "१-४९-२४", "content_sanskrit": "निषधः पारियात्रश्च द्वावेतौ वरपर्वतौ  ।\nयथा पूर्वौ तथा याम्यावेतौ पश्चिमतः श्रितौ।। २३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003246024, "chapter_id": 23246, "verse_number": "१-४९-२५", "content_sanskrit": "त्रिश्रृंगो जारुचिश्चैव उत्तरौ वरपर्वतौ  ।\nपूर्वतश्चायतावेतावर्णवांतर्व्यवस्थितौ।। २४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003246025, "chapter_id": 23246, "verse_number": "१-४९-२६", "content_sanskrit": "मर्यादापर्वतानेतानष्टावाहुर्मनीषिणः  ।\nयोसौ मेरुर्द्विजश्रेष्ठाः प्रांशुः कनकपर्वतः।। २५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003246026, "chapter_id": 23246, "verse_number": "१-४९-२७", "content_sanskrit": "तस्य पादास्तु चत्वारश्चतुर्दिक्षु नगोत्तमाः  ।\nयैर्विष्टब्धा न चलति सप्तद्वीपवती मही।। २६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003246027, "chapter_id": 23246, "verse_number": "१-४९-२८", "content_sanskrit": "दशयोजनसाहस्रमायामस्तेषु पठ्यते  ।\nपूर्वे तु मंदरो नाम दक्षिणे गंधमादनः।। २७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003246028, "chapter_id": 23246, "verse_number": "१-४९-२९", "content_sanskrit": "विपुलः पश्चिमे पार्श्वे सुपार्श्वश्चोत्तरे स्मृतः  ।\nमहावृक्षाः समुत्पन्नाश्चत्वारो द्वीपकेतवः।। २८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003246029, "chapter_id": 23246, "verse_number": "१-४९-३०", "content_sanskrit": "मंदरस्य गिरेः श्रृंगे महावृक्षः सकेतुराट्  ।\nप्रलंबशाखाशिखरः कदंबश्चैत्यपादपः।। २९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003246030, "chapter_id": 23246, "verse_number": "१-४९-३१", "content_sanskrit": "दक्षिणस्यापि शैलस्य शिखरे देवसेविता  ।\nजंबूः सदा पुण्यफला सदा माल्योप शोभिता।। ३०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003246031, "chapter_id": 23246, "verse_number": "१-४९-३२", "content_sanskrit": "सकेतुर्दक्षिणे द्वीपे जंबूर्लोकेषु विश्रुता  ।\nविपुलस्यापि शैलस्य पश्चिमे च महात्मनः।। ३१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003246032, "chapter_id": 23246, "verse_number": "१-४९-३३", "content_sanskrit": "संजातः शिखरेऽश्वत्थः स महान् चैत्यपादपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003246033, "chapter_id": 23246, "verse_number": "१-४९-३४", "content_sanskrit": "सुपार्श्वस्योत्तरस्यापि श्रृंगे जातो महाद्रुमः।। ३२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003246034, "chapter_id": 23246, "verse_number": "१-४९-३५", "content_sanskrit": "न्यग्रोधो विपुलस्कंधोऽनेकयोजनमंडलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003246035, "chapter_id": 23246, "verse_number": "१-४९-३६", "content_sanskrit": "तेषां चतुर्णां वक्ष्यामि शैलेन्द्राणां यताक्रमम्।। ३३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003246036, "chapter_id": 23246, "verse_number": "१-४९-३७", "content_sanskrit": "अमानुष्याणि रम्याणि सर्वकालर्तुकानि च  ।\nमनोहराणि चत्वारि देवक्रीडनकानि च।। ३४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003246037, "chapter_id": 23246, "verse_number": "१-४९-३८", "content_sanskrit": "वनानि वै चतुर्दिक्षु नामतस्तु निबोधत  ।\nपूर्वे चैत्ररथं नाम दक्षिणे गंधमादनम्।। ३५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003246038, "chapter_id": 23246, "verse_number": "१-४९-३९", "content_sanskrit": "वैभ्राजं पश्चिमे विद्यादुत्तरे सवितुर्वनम्  ।\nमित्रेश्वरं तु पूर्वे तु षष्ठेश्वरमतः परम्।। ३६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003246039, "chapter_id": 23246, "verse_number": "१-४९-४०", "content_sanskrit": "वर्येश्वरं पश्चिमे तु उत्तरे चाम्रकेश्वरम्  ।\nमहा सरांसि च तथा चत्वारी मुनिपुंगवाः।। ३७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003246040, "chapter_id": 23246, "verse_number": "१-४९-४१", "content_sanskrit": "यत्र क्रीडंति मुनयः पर्वतेषु वनेषु च  ।\nअरुणोदं सरः पूर्वं दक्षिणं मानसं स्मृतम्।। ३८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003246041, "chapter_id": 23246, "verse_number": "१-४९-४२", "content_sanskrit": "सितोदं पश्चिमसरो महाभद्रं तथोत्तरम्  ।\nशाखस्य दक्षिणे क्षेत्रं विशाखस्य च पश्चिमे।। ३९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003246042, "chapter_id": 23246, "verse_number": "१-४९-४३", "content_sanskrit": "उत्तरे नैगमेयस्य कुमारस्य च पूर्वतः  ।\nअरुणोदस्य पूर्वेण शैलेंद्रा नामतः स्मृताः।। ४०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003246043, "chapter_id": 23246, "verse_number": "१-४९-४४", "content_sanskrit": "तांस्तु संक्षेपतो वक्ष्ये न शक्यं विस्तरेण तु  ।\nसितांतश्च कुरंडश्च कुररश्चाचलोत्तमः।। ४१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003246044, "chapter_id": 23246, "verse_number": "१-४९-४५", "content_sanskrit": "विकरो मणिशैलश्च वृक्षवांश्चाचलोत्तमः  ।\nमहानीलोथ रुचकः सबिन्दुर्दर्दुरस्तथा।। ४२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003246045, "chapter_id": 23246, "verse_number": "१-४९-४६", "content_sanskrit": "वेणुमांश्च समेघश्च निषधो देवपर्वतः  ।\nइत्येते पर्वतवरा ह्यन्ये च गिरयस्तथा।। ४३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003246046, "chapter_id": 23246, "verse_number": "१-४९-४७", "content_sanskrit": "पूर्वेण मंदरस्यैते सिद्धावासा उदाहृताः  ।\nतेषुतेषु गिरींद्रेषु गुहासु च वनेषु च।। ४४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003246047, "chapter_id": 23246, "verse_number": "१-४९-४८", "content_sanskrit": "रुद्रक्षेत्राणि दिव्यानि विष्णोर्नारायणस्य च  ।\nसरसो मानसस्येह दक्षिणेन महाचलाः।। ४५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003246048, "chapter_id": 23246, "verse_number": "१-४९-४९", "content_sanskrit": "ये कीर्त्यमानास्तान्सर्वान् संक्षिप्य प्रवदाम्यहम्  ।\nशैलश्च विशिराश्चैव शिखरश्चाचलोत्तमः।। ४६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003246049, "chapter_id": 23246, "verse_number": "१-४९-५०", "content_sanskrit": "एकश्रृंगो महाशूलो गजशैलः पिशाचकः  ।\nपंचशैलोथ कैलासो हिमवांश्चाचलोत्तमः।। ४७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003246050, "chapter_id": 23246, "verse_number": "१-४९-५१", "content_sanskrit": "इत्येते देवचरिता उत्कटाः पर्वतोत्तमाः  ।\nतेषुतेषु च सर्वेषु पर्वतेषु वनेषु च।। ४८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003246051, "chapter_id": 23246, "verse_number": "१-४९-५२", "content_sanskrit": "रुद्रक्षेत्राणि दिव्यानि स्थापितानि सुरोत्तमैः  ।\nदिग्भागे दक्षिणे प्रोक्ताः पश्चिमे च वदामि वः।। ४९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003246052, "chapter_id": 23246, "verse_number": "१-४९-५३", "content_sanskrit": "अपरेण सितोदश्च सुरपश्च महाबलः  ।\nकुमुदो मधुमांश्चैव ह्यंजनो मुकुटस्तथा।। ५०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003246053, "chapter_id": 23246, "verse_number": "१-४९-५४", "content_sanskrit": "कृष्णश्च पांडुरश्चैव सहस्रशिखरश्च यः  ।\nपारिजातश्च शैलेंद्रः श्रीश्रृंगश्चाचलोत्तमः।। ५१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003246054, "chapter_id": 23246, "verse_number": "१-४९-५५", "content_sanskrit": "इत्येते देवचरिता उत्कटाः पर्वतोत्तमाः  ।\nसर्वे पश्चिमदिग्भागे रुद्रक्षेत्रसमन्विताः।। ५२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003246055, "chapter_id": 23246, "verse_number": "१-४९-५६", "content_sanskrit": "महाभद्रस्य सरसश्चोत्तरे च महाबलाः  ।\nये स्थिताः कीर्त्यमानांस्तान्संक्षिप्येह निबोधत।। ५३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003246056, "chapter_id": 23246, "verse_number": "१-४९-५७", "content_sanskrit": "शंखकूटो महाशैलो वृषभो हंसपर्वतः  ।\nनागश्च कपिलश्चैव इंद्र शैलश्च सानुमान्।। ५४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003246057, "chapter_id": 23246, "verse_number": "१-४९-५८", "content_sanskrit": "नीलः कंटकश्रृंगश्च शतश्रृंगश्च पर्वतः  ।\nपुष्पकोशः प्रशैलश्च विरजश्चाचलोत्तमः।। ५५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003246058, "chapter_id": 23246, "verse_number": "१-४९-५९", "content_sanskrit": "वराहपर्वतश्चैव मयूरश्चाचलोत्तमः  ।\nजारुधिश्चैव शैलेंद्र एत उत्तरसंस्थिताः।। ५६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003246059, "chapter_id": 23246, "verse_number": "१-४९-६०", "content_sanskrit": "तेषु शैलेषु दिव्येषु देवदेवस्य शूलिनः  ।\nअसंख्यातानि दिव्यानि विमानानि सहस्रशः।। ५७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003246060, "chapter_id": 23246, "verse_number": "१-४९-६१", "content_sanskrit": "एतेषां शैलमुख्यानामंतरेषु यथाक्रमम्  ।\nसंति चैवांतरद्रोण्यः सरांस्युपवनानि च।। ५८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003246061, "chapter_id": 23246, "verse_number": "१-४९-६२", "content_sanskrit": "वसंति देवा मुनयः सिद्धाश्च शिवभाविताः  ।\nकृतवासाः सपत्नीकाः प्रसादात्परमेष्ठिनः।। ५९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003246062, "chapter_id": 23246, "verse_number": "१-४९-६३", "content_sanskrit": "लक्ष्म्याद्यानां बिल्ववने ककुभे कश्यपादयः  ।\nतथा तालवने प्रोक्तमिंद्रोपेंद्रोरगात्मनाम्।। ६०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003246063, "chapter_id": 23246, "verse_number": "१-४९-६४", "content_sanskrit": "उदुंबरे कर्दमस्य तथान्येषां महात्मनाम्  ।\nविद्याधराणां सिद्धानां पुण्ये त्वाम्रवने शुभे।। ६१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003246064, "chapter_id": 23246, "verse_number": "१-४९-६५", "content_sanskrit": "नागानां सिद्धसंघानां तथा निंबवने स्थितिः  ।\nसूर्यस्य किंशुकवने तथा रुद्रगणस्य च।। ६२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003246065, "chapter_id": 23246, "verse_number": "१-४९-६६", "content_sanskrit": "बीजपूरवने पुण्ये देवाचर्यो व्यवस्थितः  ।\nकौमुदे तु वने विष्णुप्रमुखानां महात्मनाम्।। ६३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003246066, "chapter_id": 23246, "verse_number": "१-४९-६७", "content_sanskrit": "स्थलपद्मवनांतस्थन्यग्रोधेऽशेषभोगिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003246067, "chapter_id": 23246, "verse_number": "१-४९-६८", "content_sanskrit": "शेषस्त्वशेषजगतां पतिरास्तेऽतिगर्वितः।। ६४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003246068, "chapter_id": 23246, "verse_number": "१-४९-६९", "content_sanskrit": "स एव जगतां कालः पाताले च व्यवस्थितः  ।\nविष्णोर्विश्वगुरोर्मूर्तिर्दिव्यः साक्षाद्धलायुधः।। ६५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003246069, "chapter_id": 23246, "verse_number": "१-४९-७०", "content_sanskrit": "शयनं देवदेवस्य स हरेः कंकणं विभोः  ।\nवने पनसवृक्षाणां सशुक्रा दानवादयः।। ६६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003246070, "chapter_id": 23246, "verse_number": "१-४९-७१", "content_sanskrit": "किन्नरैरुरगाश्चैव विशाखकवने स्थिताः  ।\nमनोहरवने वृक्षाः सर्व कोटिसमन्विताः।। ६७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003246071, "chapter_id": 23246, "verse_number": "१-४९-७२", "content_sanskrit": "नंदीश्वरो गणवरैः स्तूयमानो व्यवस्थितः  ।\nसंतानकस्थलीमध्ये साक्षाद्देवी सरस्वती।। ६८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003246072, "chapter_id": 23246, "verse_number": "१-४९-७३", "content_sanskrit": "एवं संक्षेपतः प्रोक्ता वनेषु वनवासिनः  ।\nअसंख्याता मयाप्यत्र वक्तुं नो विस्तरेण तु।। ६९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]