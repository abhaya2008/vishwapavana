[{"id": 7000315000, "chapter_id": 20315, "verse_number": "१-६९-१", "content_sanskrit": "व्यास उवाच ।\nतारेयो बलसंपन्नः शक्रतुल्यपराक्रमः ।\nजघान विशिखैस्स्कन्दं पितृघातिनमाहवे॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000315001, "chapter_id": 20315, "verse_number": "१-६९-२", "content_sanskrit": "ततस्स्कन्दो महाबाहुर्हरितुल्यपराक्रमः ।\nविचकर्त शरांस्तांस्तान्निर्बिभेद शरोत्तमैः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000315002, "chapter_id": 20315, "verse_number": "१-६९-३", "content_sanskrit": "स दैत्यस्सहसा स्कंदं छादयामास मार्गणैः ।\nअसंभ्रान्तः प्रचिच्छेद विशाखो विशिखैस्तदा॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000315003, "chapter_id": 20315, "verse_number": "१-६९-४", "content_sanskrit": "तारेयोग्निशरैः स्कंदं जघान रणमूर्धनि ।\nविशिखं भिदुरप्रख्यं चखान हरनंदने॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000315004, "chapter_id": 20315, "verse_number": "१-६९-५", "content_sanskrit": "वैश्वानरेण सेनानीस्तत्र संपर्यवारयत् ।\nरौद्रमस्त्रं पुनर्दैत्यः प्रेषयामास तं प्रति॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000315005, "chapter_id": 20315, "verse_number": "१-६९-६", "content_sanskrit": "तन्निरस्तं कृतं तेन बाणेनास्फालितेन च ।\nअघोरं प्राक्षिपद्दैत्यो घोररूपं सुदारुणं॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000315006, "chapter_id": 20315, "verse_number": "१-६९-७", "content_sanskrit": "भूधरा विटपास्सिंहास्तथा सर्पादयः शराः ।\nधावंति पार्वतीपुत्रं कोटिकोटिसहस्रशः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000315007, "chapter_id": 20315, "verse_number": "१-६९-८", "content_sanskrit": "छित्वा तांस्तुशरान्स्कंदो बिभेद दैत्यपुंगवं ।\nआपादं शीर्षपर्यंतं शरैरग्न्यर्कसन्निभैः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000315008, "chapter_id": 20315, "verse_number": "१-६९-९", "content_sanskrit": "स्वर्णपुंखाः शरा लग्ना देहे दैत्यपतेर्भृशं ।\nरेजुस्ते स्वर्णशकला यथा कृष्णशिलोच्चये॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000315009, "chapter_id": 20315, "verse_number": "१-६९-१०", "content_sanskrit": "तस्य देहात्ततश्चैव बहु सुस्राव शोणितं ।\nयथा च माधवे मासि पुरुपुष्पश्शमी तरुः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000315010, "chapter_id": 20315, "verse_number": "१-६९-११", "content_sanskrit": "स्यंदनाधश्चराश्वाश्च शिश्यिरे भूमिलग्नकाः ।\nअथ क्रुद्धो महादैत्यः शूलं भीमं च दारुणं॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000315011, "chapter_id": 20315, "verse_number": "१-६९-१२", "content_sanskrit": "धृत्वा तं प्रतिचिक्षेप कालमृत्युसमप्रभं ।\nपार्वतीनंदनेनापि शूलं पाशुपतेन ह॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000315012, "chapter_id": 20315, "verse_number": "१-६९-१३", "content_sanskrit": "क्षिप्तं तेन कृतं दग्धं मुहूर्तेन रणाजिरे ।\nपुनः शक्तिं मुमोचाथ ब्रह्मदत्तान्तु दानवः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000315013, "chapter_id": 20315, "verse_number": "१-६९-१४", "content_sanskrit": "शूलं प्रतिजघानाथ शतकूटसमप्रभम् ।\nततोऽस्त्रे वज्रसंकाशे जघटाते वियत्यपि॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000315014, "chapter_id": 20315, "verse_number": "१-६९-१५", "content_sanskrit": "तयोस्सवीर्ययोरस्त्रे धरण्यां प्रणिपेततुः ।\nततो दैत्यपतिः स्कंदं शरैरग्निशिखोपमैः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000315015, "chapter_id": 20315, "verse_number": "१-६९-१६", "content_sanskrit": "अर्दयामास सहसा घनधारेव पर्वतं ।\nतांस्तु च्छित्वा महाबाहुः सेनानीश्चापमस्य वै॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000315016, "chapter_id": 20315, "verse_number": "१-६९-१७", "content_sanskrit": "विचकर्तार्धचंद्रेण तथा यंतुः शिरोमहत् ।\nतथाश्वान्बहुभिर्बाणैः पातयामास भूतले॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000315017, "chapter_id": 20315, "verse_number": "१-६९-१८", "content_sanskrit": "गृहीत्वा मुसलं वेगात्स दुद्राव स्थले गुहं ।\nजघान तेन दैत्येन्द्रः शिखिनं शिखिवाहनं॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000315018, "chapter_id": 20315, "verse_number": "१-६९-१९", "content_sanskrit": "ततो मोहं गतो बर्ही प्रचकंपे मुहुर्मुहुः ।\nततः स्कंदः पुनस्तं च जघानासुरपुंगवं॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000315019, "chapter_id": 20315, "verse_number": "१-६९-२०", "content_sanskrit": "प्रचिच्छेदासिना वेगान्मुसलं चातिदारुणं ।\nतारेयः शक्तिमादाय जघान क्रौंचदारणम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000315020, "chapter_id": 20315, "verse_number": "१-६९-२१", "content_sanskrit": "सोपि शक्तिं मुमोचाथ अमोघां दुष्टघातिनीम् ।\nततः संदह्य सा शक्तिर्विश्वप्रलयकारिणी॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000315021, "chapter_id": 20315, "verse_number": "१-६९-२२", "content_sanskrit": "यमदंडसमानं च भित्वा पुनर्गुहं गता ।\nस गतासुः पपातोर्व्यां चालयंश्च वसुंधरां॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000315022, "chapter_id": 20315, "verse_number": "१-६९-२३", "content_sanskrit": "पुष्पधूपादिभिः स्कंदः सर्वदेवैः प्रपूजितः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]