[{"id": 7001715000, "chapter_id": 21715, "verse_number": "१-१०१-१", "content_sanskrit": "श्रीब्रह्मोवाच ।\nश्रृणु वत्स प्रवक्ष्यामि पुराणं दशमं तव ।\nब्रह्मवैवर्तकं नाम वेदमार्गानुदर्शकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001715001, "chapter_id": 21715, "verse_number": "१-१०१-२", "content_sanskrit": "सावर्णिर्यत्र भगवान्साक्षाद्देवर्षये स्थितः ।\nनारदाय पुराणार्थं प्राह सर्वमलौकिकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001715002, "chapter_id": 21715, "verse_number": "१-१०१-३", "content_sanskrit": "धर्मार्थकाममोक्षाणां सारः प्रीतिर्हरौ हरे ।\nतयोरभेदसिद्ध्यर्थं ब्रह्मवैवर्तमुत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001715003, "chapter_id": 21715, "verse_number": "१-१०१-४", "content_sanskrit": "रथंतरस्य कल्पस्य वृत्तांतं यन्मयोदितम् ।\nशतकोटिपुराणे तत्संक्षिप्य प्राह वेदवित् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001715004, "chapter_id": 21715, "verse_number": "१-१०१-५", "content_sanskrit": "व्यासश्चतुर्द्धा संव्यस्य ब्रह्मवैवर्तसंज्ञिते ।\nअष्टादशसहस्रं तत्पुराणं परिकीर्तितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001715005, "chapter_id": 21715, "verse_number": "१-१०१-६", "content_sanskrit": "ब्रह्मप्रकृतिविघ्नेशकृष्णखंडसमन्वितम् ।\nतत्र सूतर्षिसंवादे पुराणोपक्रमस्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001715006, "chapter_id": 21715, "verse_number": "१-१०१-७", "content_sanskrit": "सृष्टिप्रकरणं त्वाद्यं ततो नारदवेधसोः ।\nविवादः सुमहान्यत्र द्वयोरासीत्पराभवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001715007, "chapter_id": 21715, "verse_number": "१-१०१-८", "content_sanskrit": "शिवलोकगतिः पश्चाज्ज्ञानलाभः शिवात्मने ।\nशिववाक्येन तत्पश्चान्मरीचेर्नारदस्य तु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001715008, "chapter_id": 21715, "verse_number": "१-१०१-९", "content_sanskrit": "गमनं चैव सावर्णेर्ज्ञानार्थँ सिद्धसेविते ।\nआश्रमे सुमहापुण्ये त्रैलोक्याश्चर्यकारिणी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001715009, "chapter_id": 21715, "verse_number": "१-१०१-१०", "content_sanskrit": "एतद्धि ब्रह्मखंडं हि श्रुतं पापविनाशनम् ।\nततः सावर्णिसंवादो नारदस्य समीरितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001715010, "chapter_id": 21715, "verse_number": "१-१०१-११", "content_sanskrit": "कृष्णमाहात्म्यसंयुक्तो नानाख्यानकथोत्तरम् ।\nप्रकृतेरंशभूतानां कलानां चापि वर्णितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001715011, "chapter_id": 21715, "verse_number": "१-१०१-१२", "content_sanskrit": "माहात्म्यं पूजनाद्यं च विस्तरेण यथास्थितम् ।\nएतत्प्रकृतिखंडं हि श्रुतं भूतिविधायकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001715012, "chapter_id": 21715, "verse_number": "१-१०१-१३", "content_sanskrit": "गणेशजन्मसंप्रश्नः सपुण्यकमहाव्रतम् ।\nपार्वत्याः कार्तिकेयेन सह विघ्नेशसंभवम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001715013, "chapter_id": 21715, "verse_number": "१-१०१-१४", "content_sanskrit": "चरितं कार्तवीर्यस्य जामदग्र्यस्य चाद्भुतम् ।\nविवादः सुमहानासीज्जामदग्र्यगणेशयोः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001715014, "chapter_id": 21715, "verse_number": "१-१०१-१५", "content_sanskrit": "एतद्विघ्नेशखंडं हि सर्वविघ्नविनाशनम् ।\nश्रीकृष्णजन्मसंप्रश्नो जन्माख्यानं ततोऽद्भुतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001715015, "chapter_id": 21715, "verse_number": "१-१०१-१६", "content_sanskrit": "गोकुले गमनं गश्चात्पूतनादिवदाद्भूताः ।\nबाल्यकौमारजा लीला विविधास्तत्र वर्णिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001715016, "chapter_id": 21715, "verse_number": "१-१०१-१७", "content_sanskrit": "रासक्रीडा च गोपीभिः शारदी समुदाहृता ।\nरहस्ये राधया क्रीडा वर्णिता बहुविस्तरा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001715017, "chapter_id": 21715, "verse_number": "१-१०१-१८", "content_sanskrit": "सहाक्रूरेण तत्पश्चान्मथुरागमनं हरेः ।\nकंसादीनां वधे वृत्ते कृष्णस्य द्विजसंस्कृतिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001715018, "chapter_id": 21715, "verse_number": "१-१०१-१९", "content_sanskrit": "काश्यसांदीपनेः पश्चाद्विद्योपादानमद्भुतम् ।\nयवनस्य वधः पश्चाद्द्वारकागमनं हरेः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001715019, "chapter_id": 21715, "verse_number": "१-१०१-२०", "content_sanskrit": "नरकादिवधस्तत्र कृष्णेन विहितोऽद्भुतः ।\nकृष्णखंडमिदं विप्र नृणां संसारखंडनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001715020, "chapter_id": 21715, "verse_number": "१-१०१-२१", "content_sanskrit": "पठितं च श्रुतं ध्यातं पूजितं चाभिवंदितम् ।\nइत्येतद्ब्रह्मवैवर्तपुराणं चात्यलौकिकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001715021, "chapter_id": 21715, "verse_number": "१-१०१-२२", "content_sanskrit": "व्यासोक्तं चादि संभूतं पठञ्छृण्वन्विमुच्यते ।\nविज्ञानाज्ञानशमनाद्धोरात्संसारसागरात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001715022, "chapter_id": 21715, "verse_number": "१-१०१-२३", "content_sanskrit": "लिखित्वेदं च यो दद्यान्माध्यां धेनुसमन्वितम् ।\nब्रह्मलोकमवाप्नोति स मुक्तोऽज्ञानबंधनात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001715023, "chapter_id": 21715, "verse_number": "१-१०१-२४", "content_sanskrit": "यश्चानुक्रमणीं चापि पठेद्वा श्रृणुयादपि ।\nसोऽपि कृष्णप्रसादेन लभते वांछितं फलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001715024, "chapter_id": 21715, "verse_number": "१-१०१-२५", "content_sanskrit": "इति श्रीबृहन्नारदीयपुराणे पूर्वभागे बृहदुपाख्याने ब्रह्मवैवर्तपुराणानुक्रमणीनिरूपणं नामैकोत्तरशततमोऽध्यायाः ॥१०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]