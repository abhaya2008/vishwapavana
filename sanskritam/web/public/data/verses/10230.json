[{"id": 6000230000, "chapter_id": 10230, "verse_number": null, "content_sanskrit": "अथ चतुस्‍त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000230001, "chapter_id": 10230, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.001.m4a", "display_order": 2}, {"id": 6000230002, "chapter_id": 10230, "verse_number": "१०-३४-१", "content_sanskrit": "अथ तर्ह्यागतो गोष्ठमरिष्टो वृषभासुरः।\nमहीं महाककुत्कायः कम्पयन् खुरविक्षताम्॥ १०/३४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.002.m4a", "display_order": 3, "topics": [{"text": "अरिष्टनामकवृषभासुरवधः", "range": "१–१६"}]}, {"id": 6000230003, "chapter_id": 10230, "verse_number": "१०-३४-२", "content_sanskrit": "रवमाणः खरतरं पदा च विलिखन् महीम्।\nउद्यम्य पुच्छमभ्राणि विषाणाग्रेण चोद्धरन्॥ १०/३४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.003.m4a", "display_order": 4}, {"id": 6000230004, "chapter_id": 10230, "verse_number": "१०-३४-३", "content_sanskrit": "किञ्चित्किञ्चिच्छकृन्मुञ्चन् मूत्रयन् स्तब्धलोचनः।\nयस्य निर्ह्रादितेनाङ्ग निष्ठुरेण गवां नृणाम्॥ १०/३४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.004.m4a", "display_order": 5}, {"id": 6000230005, "chapter_id": 10230, "verse_number": "१०-३४-४", "content_sanskrit": "पतन्त्यकालतो गर्भाः स्रवन्ति स्म भयेन वै।\nनिर्विशन्ति घना यस्य ककुद्यचलशङ्कया॥ १०/३४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.005.m4a", "display_order": 6}, {"id": 6000230006, "chapter_id": 10230, "verse_number": "१०-३४-५", "content_sanskrit": "तं तीक्ष्णशृङ्गमुद्वीक्ष्य गोप्यो गोपाश्च तत्रसुः।\nपशवो दुद्रुवुर्भीता राजन् सन्त्यज्य गोकुलम्॥ १०/३४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.006.m4a", "display_order": 7}, {"id": 6000230007, "chapter_id": 10230, "verse_number": "१०-३४-६", "content_sanskrit": "कृष्ण कृष्णेति ते सर्वे गोविन्दं शरणं ययुः।\nभगवानथ तद् वीक्ष्य गोकुलं भयविद्रुतम्॥ १०/३४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.007.m4a", "display_order": 8}, {"id": 6000230008, "chapter_id": 10230, "verse_number": "१०-३४-७", "content_sanskrit": "मा भैष्टेति गिराऽऽश्वास्य वृषासुरमुपाह्वयत्।\nगोपालैः पशुभिर्मन्द त्रासितैः किमसत्तम॥ १०/३४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.008.m4a", "display_order": 9}, {"id": 6000230009, "chapter_id": 10230, "verse_number": "१०-३४-८", "content_sanskrit": "बलदर्पहाऽहं दुष्टानां त्वद्विधानां दुरात्मनाम्। इत्यास्फोट्याच्युतोऽरिष्टं तलशब्देन कोपयन्।\nसख्युरंसे भुजाभोगं प्रसार्यावस्थितो हरिः॥ १०/३४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.009.m4a", "display_order": 10}, {"id": 6000230010, "chapter_id": 10230, "verse_number": "१०-३४-९", "content_sanskrit": "सोऽप्येवं कोपितोऽरिष्टः खुरेणावनिमुल्लिखन्।\nउद्यत्पुच्छभ्रमन्मेघः क्रुद्धः कृष्णमुपाद्रवत्॥ १०/३४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.010.m4a", "display_order": 11}, {"id": 6000230011, "chapter_id": 10230, "verse_number": "१०-३४-१०", "content_sanskrit": "अग्रन्यस्तविषाणाग्रः स्तब्धासृग्लोचनोऽच्युतम्।\nकट्याक्षिप्याद्रवत् तूर्णमिन्द्रमुक्तोऽशनिर्यथा॥ १०/३४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.011.m4a", "display_order": 12}, {"id": 6000230012, "chapter_id": 10230, "verse_number": "१०-३४-११", "content_sanskrit": "गृहीत्वा शृङ्गयोस्तं वा अष्टादशपदानि सः।\nप्रत्यपोवाह भगवान् गजः प्रतिगजं यथा॥ १०/३४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.012.m4a", "display_order": 13}, {"id": 6000230013, "chapter_id": 10230, "verse_number": "१०-३४-१२", "content_sanskrit": "सोऽपविद्धो भगवता पुनरुत्थाय सत्वरः।\nआपतत् स्विन्नसर्वाङ्गो निःश्वसन् क्रोधमूर्च्छितः॥ १०/३४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.013.m4a", "display_order": 14}, {"id": 6000230014, "chapter_id": 10230, "verse_number": "१०-३४-१३", "content_sanskrit": "तमापतन्तं स निगृह्य शृङ्गयोः पदा समाक्रम्य निपात्य भूतले।\nनिष्पीडयामास यथाऽऽर्द्रमम्बरं कृत्त्वा विषाणेन जघान सोऽपतत्॥ १०/३४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.014.m4a", "display_order": 15}, {"id": 6000230015, "chapter_id": 10230, "verse_number": "१०-३४-१४", "content_sanskrit": "असृग् वमन् मूत्रशकृत् समुत्सृजन् क्षिपंश्च पादाननिमीलितेक्षणः।\nजगाम कृच्छ्रं निर्ऋतेरथ क्षयं पुष्पैः किरन्तो हरिमीडिरे सुराः॥ १०/३४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.015.m4a", "display_order": 16}, {"id": 6000230016, "chapter_id": 10230, "verse_number": "१०-३४-१५", "content_sanskrit": "एवं ककुद्मिनं हत्वा स्तूयमानः स्वजातिभिः।\nविवेश भगवान् गोष्ठं गोपीनां नयनोत्सवः॥ १०/३४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.016.m4a", "display_order": 17}, {"id": 6000230017, "chapter_id": 10230, "verse_number": "१०-३४-१६", "content_sanskrit": "अरिष्टे निहते गोष्ठे कृष्णेनाद्भुतकर्मणा।\nकंसाय प्राह भगवान् नारदो देवदर्शनः॥ १०/३४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.017.m4a", "display_order": 18}, {"id": 6000230018, "chapter_id": 10230, "verse_number": "१०-३४-१७", "content_sanskrit": "यशोदायाः सुतां कन्यां देवक्याः कृष्णमेव च। रामं च रोहिणीपुत्रं वसुदेवेन बिभ्यता।\nन्यस्तौ स्वमित्रे नन्दे वै याभ्यां ते पुरुषा हताः॥ १०/३४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.018.m4a", "display_order": 19, "topics": [{"text": "नारदेन कंसाय श्रीकृष्णबलरामयोः देवकीरोहिणीपुत्रत्वकथनम्", "range": "१७–२८"}]}, {"id": 6000230019, "chapter_id": 10230, "verse_number": "१०-३४-१८", "content_sanskrit": "निशम्य तद् भोजपतिः कोपात् प्रचलितेन्द्रियः।\nनिशातमसिमादत्त वसुदेवजिघांसया॥ १०/३४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.019.m4a", "display_order": 20}, {"id": 6000230020, "chapter_id": 10230, "verse_number": "१०-३४-१९", "content_sanskrit": "निवारितो नारदेन तत्सुतौ मृत्युमात्मनः।\nज्ञात्वा लोहमयैः पाशैर्बबन्ध सह भार्यया॥ १०/३४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.020.m4a", "display_order": 21}, {"id": 6000230021, "chapter_id": 10230, "verse_number": "१०-३४-२०", "content_sanskrit": "प्रतियाते तु देवर्षौ कंस आशास्य केशिनम्।\nप्रेषयामास हन्येतां भवता रामकेशवौ॥ १०/३४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.021.m4a", "display_order": 22}, {"id": 6000230022, "chapter_id": 10230, "verse_number": "१०-३४-२१", "content_sanskrit": "ततो मुष्टिकचाणूरछलकोसलकादिकान्।\nअमात्यान् हस्तिपांश्चैव समाहूयाह भोजराट्॥ १०/३४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.022.m4a", "display_order": 23}, {"id": 6000230023, "chapter_id": 10230, "verse_number": "१०-३४-२२", "content_sanskrit": "भोभो निशम्यतामेतद् वीर चाणूरमुष्टिकौ।\nनन्दव्रजे किलासाते सुतावानकदुन्दुभेः॥ १०/३४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.023.m4a", "display_order": 24}, {"id": 6000230024, "chapter_id": 10230, "verse_number": "१०-३४-२३", "content_sanskrit": "रामकृष्णौ सुतौ मह्यं मृत्यू कालनिदर्शितौ।\nभवद्भ्यामिह सम्प्राप्तौ हन्येतां मल्ललीलया॥ १०/३४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.024.m4a", "display_order": 25}, {"id": 6000230025, "chapter_id": 10230, "verse_number": "१०-३४-२४", "content_sanskrit": "मञ्चाः क्रियन्तां विविधा मल्लरङ्गपरिश्रिताः।\nपौरा जानपदाः सर्वे पश्यन्तु स्वैरसंयुगम्॥ १०/३४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.025.m4a", "display_order": 26}, {"id": 6000230026, "chapter_id": 10230, "verse_number": "१०-३४-२५", "content_sanskrit": "महामात्र निबोधेदं वचो मम महामते।\nगजः कुवलयापीडः प्रभिन्नकरटामुखः॥ १०/३४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.026.m4a", "display_order": 27}, {"id": 6000230027, "chapter_id": 10230, "verse_number": "१०-३४-२६", "content_sanskrit": "संस्थाप्यो द्वारि रङ्गस्य करारोपितमुद्गरः।\nतेन ते तत्र हन्तव्यौ सुतावानकदुन्दुभेः॥ १०/३४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.027.m4a", "display_order": 28}, {"id": 6000230028, "chapter_id": 10230, "verse_number": "१०-३४-२७", "content_sanskrit": "सोऽप्याकुलमतिः प्राह निहन्तव्यौ कथं मया।\nस्वस्रीयौ भोजराजस्य कंसस्य जगतीपतेः॥ १०/३४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.028.m4a", "display_order": 29}, {"id": 6000230029, "chapter_id": 10230, "verse_number": "१०-३४-२८", "content_sanskrit": "इत्युक्तस्तेन कंसस्तु महामात्रेण दुर्मतिः।\nउवाच भूयो वचनं समेतान् श्रावयन् नृप॥ १०/३४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.029.m4a", "display_order": 30}, {"id": 6000230030, "chapter_id": 10230, "verse_number": null, "content_sanskrit": "कंस उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.030.m4a", "display_order": 31}, {"id": 6000230031, "chapter_id": 10230, "verse_number": "१०-३४-२९", "content_sanskrit": "शृणुध्वमेतद् वचनं मयोदितं निशम्य सर्वे हृदि धारयन्तु तत्।\nयेनाहमेतेष्वसुहृत्त्वमादितश्चरामि बन्धुष्वपि तस्य कारणम्॥ १०/३४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.031.m4a", "display_order": 32, "topics": [{"text": "कंसेन स्वसेवकान्प्रति स्वमातरि दुमिलनामकगन्धर्वात् स्वस्योत्पत्तिकथाकथनम्", "range": "२९–५९"}]}, {"id": 6000230032, "chapter_id": 10230, "verse_number": "१०-३४-३०", "content_sanskrit": "माता मम महाभागा कदाचित् कमलेक्षणा।\nविचचार गृहोद्याने मन्दमारुतवीजिते॥ १०/३४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.032.m4a", "display_order": 33}, {"id": 6000230033, "chapter_id": 10230, "verse_number": "१०-३४-३१", "content_sanskrit": "प्रोत्फुल्लाशोकबकुलपूगपुन्नागशोभिते।\nभ्रमद्भ्रमरसङ्घाते कूजत्कोकिलसङ्कुले॥ १०/३४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.033.m4a", "display_order": 34}, {"id": 6000230034, "chapter_id": 10230, "verse_number": "१०-३४-३२", "content_sanskrit": "नृत्यच्छिखण्डिनिवहे मर्कटाटोपसुन्दरे।\nवसन्तसमये रम्ये सालमण्डलमण्डिते॥ १०/३४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.034.m4a", "display_order": 35}, {"id": 6000230035, "chapter_id": 10230, "verse_number": "१०-३४-३३", "content_sanskrit": "चरन्ती तत्र मे माता चिन्तयामास सुव्रता।\nभर्तारं कामसन्तप्ता ऋतुस्नाता स्वलङ्कृता॥ १०/३४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.035.m4a", "display_order": 36}, {"id": 6000230036, "chapter_id": 10230, "verse_number": "१०-३४-३४", "content_sanskrit": "तत्रैव कश्चिद् गन्धर्वो द्रुमिलो नाम नामतः।\nचरन्नन्तर्हितः काले दृष्ट्वा तामेकचारिणीम्॥ १०/३४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.036.m4a", "display_order": 37}, {"id": 6000230037, "chapter_id": 10230, "verse_number": "१०-३४-३५", "content_sanskrit": "विज्ञाय चिन्तितं तस्याः सर्वसत्त्वाशयार्थवित्।\nउग्रसेनवपुर्बिभ्रत् सस्मितालापवीक्षितम्॥ १०/३४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.037.m4a", "display_order": 38}, {"id": 6000230038, "chapter_id": 10230, "verse_number": "१०-३४-३६", "content_sanskrit": "तामाससाद कामार्तः कामयानां पतिव्रताम्।\nअजानमाना साऽभ्येत्य रेमे तेन समं वने॥ १०/३४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.038.m4a", "display_order": 39}, {"id": 6000230039, "chapter_id": 10230, "verse_number": "१०-३४-३७", "content_sanskrit": "सा तं विदित्वा रमणेतरं सती नितान्तखेदाविललोचनाशया।\nउवाच कस्त्वं कितवार्यगर्हितं दुरात्मना येन कृतं त्वयेदृशम्॥ १०/३४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.039.m4a", "display_order": 40}, {"id": 6000230040, "chapter_id": 10230, "verse_number": "१०-३४-३८", "content_sanskrit": "इति ब्रुवन्तीं परिसान्त्वयन् शनैः स दीर्घबाहुर्द्रुमिलोऽभ्यभाषत।\nवयं हि गन्धर्वकुलोद्भवाः प्रिये गीर्वाणतुल्यामरवल्लभानुगाः॥ १०/३४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.040.m4a", "display_order": 41}, {"id": 6000230041, "chapter_id": 10230, "verse_number": "१०-३४-३९", "content_sanskrit": "भवादृशीनां मनुजाङ्गनानां जानीहि भद्रे सुलभा वयं न च।\nजराविनाशाद्यखिलाधिभागिनां नृणां सुराणां महदन्तरं प्रिये॥ १०/३४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.041.m4a", "display_order": 42}, {"id": 6000230042, "chapter_id": 10230, "verse_number": "१०-३४-४०", "content_sanskrit": "इति ब्रुवन्तं सा भूयः प्राह क्रोधाकुलेन्द्रिया।\nकिं मां सान्त्वयसे भूयः कृत्वेत्थं दुष्टचेष्टितम्॥ १०/३४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.042.m4a", "display_order": 43}, {"id": 6000230043, "chapter_id": 10230, "verse_number": "१०-३४-४१", "content_sanskrit": "इमानतिक्रम्य जलाग्निमेदिनीसमीरणाकाशनिशेशसूर्यान्।\nदिक्कालधर्मानवधार्य येन दुरात्मनेत्थं मलिनीकृताऽहम्॥ १०/३४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.043.m4a", "display_order": 44}, {"id": 6000230044, "chapter_id": 10230, "verse_number": "१०-३४-४२", "content_sanskrit": "गजेनेव मदान्धेन पद्मिनी वनमध्यगा। विशृङ्खलेन विमला येनाहं मलिनीकृता।\nस त्वं किमिति मां भूयः सान्त्वयस्यमराधम॥ १०/३४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.044.m4a", "display_order": 45}, {"id": 6000230045, "chapter_id": 10230, "verse_number": "१०-३४-४३", "content_sanskrit": "इति ब्रुवन्तीं प्रोवाच स भूयः शापशङ्कितः।\nअनुलोमः सरोजाक्षि मनुष्यासु दिवौकसाम्॥ १०/३४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.045.m4a", "display_order": 46}, {"id": 6000230046, "chapter_id": 10230, "verse_number": "१०-३४-४४", "content_sanskrit": "नराणां देवकान्तासु प्रतिलोमो हि सङ्गमः।\nजानीहि नाहमागस्कृत् तेन पङ्कजगन्धिनि॥ १०/३४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.046.m4a", "display_order": 47}, {"id": 6000230047, "chapter_id": 10230, "verse_number": "१०-३४-४५", "content_sanskrit": "तस्मात् ते जायते पुत्रो मद्वीर्यं न वृथा भवेत्।\nश्रीमान् धीमान् महोत्साहो न मे वाग् जायते मृषा॥ १०/३४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.047.m4a", "display_order": 48}, {"id": 6000230048, "chapter_id": 10230, "verse_number": "१०-३४-४६", "content_sanskrit": "इत्येवं वादिनं क्रुद्धा माता मम यशस्विनी।\nप्राह सन्त्यज्य सन्तप्ता पातिव्रत्यं सुदुर्लभम्॥ १०/३४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.048.m4a", "display_order": 49}, {"id": 6000230049, "chapter_id": 10230, "verse_number": "१०-३४-४७", "content_sanskrit": "निस्सेतोर्भिन्नवृत्तस्य पापस्योन्मार्गवर्तिनः।\nक्रूरस्ते तनयो भूयात् साहसी निर्दयोऽघृणः॥ १०/३४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.049.m4a", "display_order": 50}, {"id": 6000230050, "chapter_id": 10230, "verse_number": "१०-३४-४८", "content_sanskrit": "नानुग्राह्यो देवतानां द्विजानां च तपस्विनाम्। इत्थं वदन्त्यां तस्यां स क्रुद्धायां शापशङ्कितः।\nतावकानां भवेच्छत्रुरित्युक्त्वाऽन्तरधीयत॥ १०/३४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.050.m4a", "display_order": 51}, {"id": 6000230051, "chapter_id": 10230, "verse_number": "१०-३४-४९", "content_sanskrit": "गते तस्मिन् महोद्यानान्माता मम तपस्विनी।\nकेनाप्यज्ञातवृत्तान्ता गृहानेवाभ्यपद्यत॥ १०/३४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.051.m4a", "display_order": 52}, {"id": 6000230052, "chapter_id": 10230, "verse_number": "१०-३४-५०", "content_sanskrit": "ततः सा गर्भमालम्ब्य कालेनैव सुषाव माम्॥ १०/३४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.052.m4a", "display_order": 53}, {"id": 6000230053, "chapter_id": 10230, "verse_number": "१०-३४-५१", "content_sanskrit": "इति मे नारदः प्राह कदाचिद् भगवान् ऋषिः।\nततः प्रभृत्यहं द्वेष्मि तानेतान् बन्धुदुर्जनान्॥ १०/३४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.053.m4a", "display_order": 54}, {"id": 6000230054, "chapter_id": 10230, "verse_number": "१०-३४-५२", "content_sanskrit": "यूयं तत्र प्रमाणं हि द्विषन्त्येतेऽपि मां सदा।\nउग्रसेनं च दुर्बुद्धिमाहुकं च दुराशयम्॥ १०/३४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.054.m4a", "display_order": 55}, {"id": 6000230055, "chapter_id": 10230, "verse_number": "१०-३४-५३", "content_sanskrit": "वसुदेवं च कितवमन्यांश्च तदुपाश्रयान्।\nहत्वा न जायते दोषो मम गन्धर्वजन्मनः॥ १०/३४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.055.m4a", "display_order": 56}, {"id": 6000230056, "chapter_id": 10230, "verse_number": "१०-३४-५४", "content_sanskrit": "तेनादेक्ष्यामि पुरुषं हन्येतामिति तावहम्।\nताभ्यां हताभ्यां बालाभ्यां कुञ्जरेण बलीयसा॥ १०/३४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.056.m4a", "display_order": 57}, {"id": 6000230057, "chapter_id": 10230, "verse_number": "१०-३४-५५", "content_sanskrit": "कृत्वा पारत्रिकीं पूजां यान्तु तत्पदवीमिमे।\nवसुदेवोग्रसेनौ च तथाऽन्यौ नन्ददेवकौ॥ १०/३४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.057.m4a", "display_order": 58}, {"id": 6000230058, "chapter_id": 10230, "verse_number": "१०-३४-५६", "content_sanskrit": "गोपाला यादवाश्चैव ये चान्ये ताननुव्रताः।\nपश्यन्तु निभृतैर्नेत्रैर्हन्यमानौ स्वदारकौ॥ १०/३४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.058.m4a", "display_order": 59}, {"id": 6000230059, "chapter_id": 10230, "verse_number": "१०-३४-५७", "content_sanskrit": "आहूयन्तां जनपदाः पश्यन्तु मम पौरुषम्।\nमहामात्र त्वया भद्र रङ्गद्वार्यपनीयताम्॥ १०/३४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.059.m4a", "display_order": 60}, {"id": 6000230060, "chapter_id": 10230, "verse_number": "१०-३४-५८", "content_sanskrit": "द्विपः कुवलयापीडो जहि तेन ममाहितौ।\nआरभ्यतां धनुर्यागश्चतुर्दश्यां यथाविधि॥ १०/३४/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.060.m4a", "display_order": 61}, {"id": 6000230061, "chapter_id": 10230, "verse_number": "१०-३४-५९", "content_sanskrit": "विशसन्तु पशून् मेध्यान् भूतराजाय मीढुषे। इत्याज्ञाप्यार्थतत्त्वज्ञमाहूय यदुपुङ्गवम्।\nगृहीत्वा पाणिना पाणिं तत्राक्रूरमुवाच ह॥ १०/३४/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.061.m4a", "display_order": 62}, {"id": 6000230062, "chapter_id": 10230, "verse_number": "१०-३४-६०", "content_sanskrit": "भो भो दानपते मह्यं क्रियतां मैत्रमादृतः।\nनान्यस्त्वत्तो हिततमो विद्यते भोजवृष्णिषु॥ १०/३४/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.062.m4a", "display_order": 63, "topics": [{"text": "श्रीकृष्णरामयोरानयनार्थं कंसेनाक्रूरप्रेषणम्", "range": "६०–७२"}]}, {"id": 6000230063, "chapter_id": 10230, "verse_number": "१०-३४-६१", "content_sanskrit": "अतस्त्वामाश्रितः सौम्य कार्यगौरवसाधनम्।\nयथेन्द्रो विष्णुमाश्रित्य स्वार्थमध्यगमद् विभुः॥ १०/३४/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.063.m4a", "display_order": 64}, {"id": 6000230064, "chapter_id": 10230, "verse_number": "१०-३४-६२", "content_sanskrit": "गच्छ नन्दव्रजं तत्र सुतावानकदुन्दुभेः।\nआसाते ताविहानेन रथेनानय माचिरम्॥ १०/३४/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.064.m4a", "display_order": 65}, {"id": 6000230065, "chapter_id": 10230, "verse_number": "१०-३४-६३", "content_sanskrit": "निसृष्टः किल मे मृत्युर्देवैर्वैकुण्ठसंश्रयैः।\nतावानय समं गोपैर्नन्दाद्यैः साभ्युपायनैः॥ १०/३४/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.065.m4a", "display_order": 66}, {"id": 6000230066, "chapter_id": 10230, "verse_number": "१०-३४-६४", "content_sanskrit": "घातयिष्य इहानीतौ कालकल्पेन हस्तिना।\nयदि मुक्तौ ततो मल्लैर्घातये वैद्युतोपमैः॥ १०/३४/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.066.m4a", "display_order": 67}, {"id": 6000230067, "chapter_id": 10230, "verse_number": "१०-३४-६५", "content_sanskrit": "तयोर्निहतयोस्तप्तान् वसुदेवपुरोगमान्।\nतद्बन्धून् निहनिष्यामि वृष्णिभोजदशार्हकान्॥ १०/३४/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.067.m4a", "display_order": 68}, {"id": 6000230068, "chapter_id": 10230, "verse_number": "१०-३४-६६", "content_sanskrit": "उग्रसेनं मत्पितरं स्थविरं राज्यकामुकम्।\nतद्भ्रातरं देवकं च ये चान्ये विद्विषो मम॥ १०/३४/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.068.m4a", "display_order": 69}, {"id": 6000230069, "chapter_id": 10230, "verse_number": "१०-३४-६७", "content_sanskrit": "ततश्चैषा मही मित्र भवित्री नष्टकण्टका।\nजरासन्धो मम गुरुर्विविदो दयितः सखा॥ १०/३४/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.069.m4a", "display_order": 70}, {"id": 6000230070, "chapter_id": 10230, "verse_number": "१०-३४-६८", "content_sanskrit": "शम्बरो नरको बाणो मय्येव कृतसौहृदाः।\nतैरहं सुरपक्षीयान् हत्वा भोक्ष्ये महीं नृपान्॥ १०/३४/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.070.m4a", "display_order": 71}, {"id": 6000230071, "chapter_id": 10230, "verse_number": "१०-३४-६९", "content_sanskrit": "एतज्ज्ञात्वाऽऽनय क्षिप्रं रामकृष्णाविहार्भकौ।\nधनुर्यागनिरीक्षार्थं द्रष्टुं यदुपुरश्रियम्॥ १०/३४/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.071.m4a", "display_order": 72}, {"id": 6000230072, "chapter_id": 10230, "verse_number": null, "content_sanskrit": "अक्रूर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.072.m4a", "display_order": 73}, {"id": 6000230073, "chapter_id": 10230, "verse_number": "१०-३४-७०", "content_sanskrit": "राजन् मनीषितं सम्यक् तव चावद्यमार्जनम्।\nसिद्ध्यसिद्ध्योः समं कुर्याद् दैवं हि फलभावनम्॥ १०/३४/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.073.m4a", "display_order": 74}, {"id": 6000230074, "chapter_id": 10230, "verse_number": "१०-३४-७१", "content_sanskrit": "मनोरथान् करोत्युच्चैर्जनो दैवहतानपि।\nयुज्यते हर्षशोकाभ्यां तथाप्याज्ञां करोमि ते॥ १०/३४/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.074.m4a", "display_order": 75}, {"id": 6000230075, "chapter_id": 10230, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.075.m4a", "display_order": 76}, {"id": 6000230076, "chapter_id": 10230, "verse_number": "१०-३४-७२", "content_sanskrit": "एवमादिश्य चाक्रूरं मन्त्रिणश्च विसृज्य सः।\nप्रविवेश गृहं कंसस्तथाऽक्रूरः स्वमालयम्॥ १०/३४/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_034/BhP_10.034.076.m4a", "display_order": 77}, {"id": 6000230077, "chapter_id": 10230, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे चतुस्‍त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]