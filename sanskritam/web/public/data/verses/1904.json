[{"id": 2040754, "chapter_id": 1904, "verse_number": "५-१४९-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040755, "chapter_id": 1904, "verse_number": "५-१४९-१", "content_sanskrit": "एवमुक्ते तु गान्धार्या धृतराष्ट्रो जनेश्वरः।\nदुर्योधनमुवाचेदं राजमध्ये जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040756, "chapter_id": 1904, "verse_number": "५-१४९-२", "content_sanskrit": "दुर्योधन निबोधेदं यत्त्वां वक्ष्यामि पुत्रक ।\nतथा तत्कुरु भद्रं ते यद्यस्ति पितृगौरवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040757, "chapter_id": 1904, "verse_number": "५-१४९-३", "content_sanskrit": "सोमः प्रजापतिः पूर्वं कुरूणां वंशवर्धनः ।\nसोमाद्बभूव षष्ठोऽयं ययातिर्नहुषात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040758, "chapter_id": 1904, "verse_number": "५-१४९-४", "content_sanskrit": "तस्य पुत्रा बभूवुर्हि पञ्च राजर्षिसत्तमाः ।\nतेषां यदुर्महातेजा ज्येष्ठः समभवत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040759, "chapter_id": 1904, "verse_number": "५-१४९-५", "content_sanskrit": "पूरुर्यवीयांश्च ततो योऽस्माकं वंशवर्धनः।\nशर्मिष्ठया संप्रसूतो दुहित्रा वृषपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040760, "chapter_id": 1904, "verse_number": "५-१४९-६", "content_sanskrit": "यदुश्च भरतश्रेष्ठ देवयान्याः सुतोऽभवत्।\nदौहित्रस्तात शुक्रस्य काव्यस्यामिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040761, "chapter_id": 1904, "verse_number": "५-१४९-७", "content_sanskrit": "यादवानां कुलकरो बलवान्वीर्यसंमतः ।\nअवमेने स तु क्षत्रं दर्पपूर्णः सुमन्दधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040762, "chapter_id": 1904, "verse_number": "५-१४९-८", "content_sanskrit": "न चातिष्ठत्पितुः शस्त्रि बलदर्पविमोहितः ।\nअवमेने च पितरं भ्रातॄंश्चाप्यपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040763, "chapter_id": 1904, "verse_number": "५-१४९-९", "content_sanskrit": "पृथिव्यां चतुरन्तायां यदुदेवाभवद्बली ।\nवशे कृत्वा स नृपतीन्न्यवसन्नागसाह्वये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040764, "chapter_id": 1904, "verse_number": "५-१४९-१०", "content_sanskrit": "तं पिता परमक्रुद्धो ययातिर्नहुषात्मजः ।\nशशाप पुत्रं गान्धारे राज्याच्चापि व्यरोपयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040765, "chapter_id": 1904, "verse_number": "५-१४९-११", "content_sanskrit": "ये चैनमन्ववर्तन्त भ्रातरो बलदर्पिताः ।\nशशाप तानपि क्रुद्धो ययातिस्तनयानथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040766, "chapter_id": 1904, "verse_number": "५-१४९-१२", "content_sanskrit": "यवीयांसं ततः पुरुं पुत्रं स्ववशवर्तिनम् ।\nराज्ये निवेशयामास विधेयं नृपसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040767, "chapter_id": 1904, "verse_number": "५-१४९-१३", "content_sanskrit": "एवं ज्येष्ठोऽप्यथोत्सिक्तो न राज्यमभिजायते ।\nयवीयांसोपि जायन्ते राज्यं वृद्धोपसेवया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040768, "chapter_id": 1904, "verse_number": "५-१४९-१४", "content_sanskrit": "तथैव सर्वधर्मज्ञः पितुर्मम पितामहः ।\nप्रतीपः पृथिवीपालस्त्रिषु लोकेषु विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040769, "chapter_id": 1904, "verse_number": "५-१४९-१५", "content_sanskrit": "तस्य पार्थिवसिंहस्य राज्यं धर्मेण शासतः ।\nत्रयः प्रजज्ञिरे पुत्रा देवकल्पा यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040770, "chapter_id": 1904, "verse_number": "५-१४९-१६", "content_sanskrit": "देवापिरभवच्छ्रेष्ठो बाह्लीकस्तदनन्तरम् ।\nतृतीयः शन्तनुस्तात धृतिमान्मे पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040771, "chapter_id": 1904, "verse_number": "५-१४९-१७", "content_sanskrit": "देवापिस्तु महातेजास्त्वग्दोषी राजसत्तमः ।\nधार्मिकः सत्यवादी च पितुः शुश्रूषणे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040772, "chapter_id": 1904, "verse_number": "५-१४९-१८", "content_sanskrit": "पौरजानपदानां च संमतः साधुसत्कृतः ।\nसर्वेषां बालवृद्धानां देवापिर्हृदयङ्गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040773, "chapter_id": 1904, "verse_number": "५-१४९-१९", "content_sanskrit": "वदान्यः सत्यसन्धश्च सर्वभूतहिते रतः ।\nवर्तमानः पितुः शास्त्रे ब्राह्मणानां तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040774, "chapter_id": 1904, "verse_number": "५-१४९-२०", "content_sanskrit": "बाह्लीकस्य प्रियो भ्राता शन्तनोश्च महात्मनः ।\nसौभ्रात्रं च परं तेषां सहितानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040775, "chapter_id": 1904, "verse_number": "५-१४९-२१", "content_sanskrit": "अथ कालस्य पर्याये वृद्धो नृपतिसत्तमः ।\nसंभारानभिषेकार्थं कारयामास शास्त्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040776, "chapter_id": 1904, "verse_number": "५-१४९-२२", "content_sanskrit": "कारयामास सर्वाणि मङ्गलार्थानि वै विभुः ।\nतं ब्राह्मणाश्च वृद्धाश्च पौरजानपदैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040777, "chapter_id": 1904, "verse_number": "५-१४९-२३", "content_sanskrit": "सर्वे निवारयामासुर्देवापेरभिषेचनम् ।\nस तच्छ्रुत्वा तु नृपतिरभिषेकनिवारणम्।\nअश्रुकण्ठोऽभवद्राजा पर्यशोचत चात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040778, "chapter_id": 1904, "verse_number": "५-१४९-२४", "content_sanskrit": "एवं वदान्यो धर्मज्ञः सत्यसन्धश्च सोऽभवत्।\nप्रियः प्रजानामपि संस्त्वग्दोषेण प्रदूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040779, "chapter_id": 1904, "verse_number": "५-१४९-२५", "content_sanskrit": "हीनाङ्गं पृथिवीपालं नाभिनन्दन्ति देवताः।\nइति कृत्वा नृपश्रेष्ठं प्रत्यषेधन्द्विजर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040780, "chapter_id": 1904, "verse_number": "५-१४९-२६", "content_sanskrit": "ततः प्रव्यथिताङ्गोऽसौ पुत्रशोकसमन्वितः ।\nममार तं मृतं दृष्ट्वा देवापिः संश्रितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040781, "chapter_id": 1904, "verse_number": "५-१४९-२७", "content_sanskrit": "बाह्लीको मातुलकुलं त्यक्त्वा राज्यं समाश्रितः ।\nपितृभ्रातॄन्परित्यज्य प्राप्तवान्परमर्धिमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040782, "chapter_id": 1904, "verse_number": "५-१४९-२८", "content_sanskrit": "बाह्लीकेन त्वनुज्ञातः शन्तनुर्लोकविश्रुतः ।\nपितर्युपरते राजन्राजा राज्यमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040783, "chapter_id": 1904, "verse_number": "५-१४९-२९", "content_sanskrit": "तथैवाहं मतिमता परिचिन्त्येह पाण्डुना।\nज्येष्ठः प्रभ्रंशितो राज्याद्धीनाङ्ग इति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040784, "chapter_id": 1904, "verse_number": "५-१४९-३०", "content_sanskrit": "पाण्डुस्तु राज्यं संप्राप्तः कनीयानपि सन्नृपः ।\nविनाशे तस्य पुत्राणामिदं राज्यमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040785, "chapter_id": 1904, "verse_number": "५-१४९-३१", "content_sanskrit": "मय्यभागिनि राज्याय कथं त्वं राज्यमिच्छसि।\nअराजपुत्रो ह्यस्वामी परस्वं हर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040786, "chapter_id": 1904, "verse_number": "५-१४९-३२", "content_sanskrit": "युधिष्ठिरो राजपुत्रो महात्मा\nन्यायागतं राज्यमिदं च तस्य।\nस कौरवस्यास्य कुलस्य भर्ता\nप्रशासिता चैव महानुभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040787, "chapter_id": 1904, "verse_number": "५-१४९-३३", "content_sanskrit": "स सत्यसन्धः स तथाऽप्रमत्तः\nशास्त्रे स्थितो बन्धुजनस्य साधुः।\nप्रियः प्रजानां सुहृदानुकम्पी\nजितेन्द्रियः साधुजनस्य भर्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040788, "chapter_id": 1904, "verse_number": "५-१४९-३४", "content_sanskrit": "क्षमा तितिक्षा दम आर्जवं च\nसत्यव्रतत्वं श्रुतमप्रमादः ।\nभूतानुकम्पा ह्यनुशासनं च\nयुधिष्ठिरे राजगुणाः समस्ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040789, "chapter_id": 1904, "verse_number": "५-१४९-३५", "content_sanskrit": "अराजपुत्रस्त्वमनार्यवृत्तो\nलुब्धः सदा बन्धुषु पापबुद्धिः ।\nक्रमागतं राज्यमिदं परेषां\nहर्तुं कथं शक्ष्यसि दुर्विनीत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040790, "chapter_id": 1904, "verse_number": "५-१४९-३६", "content_sanskrit": "प्रयच्छ राज्यार्धमपेतमोहः\nसवाहनं त्व सपरिच्छदं च ।\nततोऽवशेषं तव जीवितस्य\nसहानुजस्यैव भवेन्नरेन्द्र ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040791, "chapter_id": 1904, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकोनपञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]