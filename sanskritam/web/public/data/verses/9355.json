[{"id": 40021418, "chapter_id": 9355, "verse_number": "1", "content_sanskrit": "ततः पितामहं दृष्ट्वा वायुः पुत्रवधार्दितः । शिशुकं तं समादाय उत्तस्थौ धातुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021419, "chapter_id": 9355, "verse_number": "2", "content_sanskrit": "चलकुण्डलमौलिस्रक्तपनीयविभूषणः । पादयोर्न्यपतद्वायुस्तिस्रोपस्थाय वेधसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021420, "chapter_id": 9355, "verse_number": "3", "content_sanskrit": "तं तु वेदविदा तेन लम्बाभरणशोभिना । वायुमुत्थाप्य हस्तेन शिशुं तं परिमृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021421, "chapter_id": 9355, "verse_number": "4", "content_sanskrit": "स्पृष्टमात्रस्ततः सो ऽथ सलीलं पद्मयोनिना । जलसिक्तं यथा सस्यं पुनर्जीवितमाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021422, "chapter_id": 9355, "verse_number": "5", "content_sanskrit": "प्राणवन्तमिमं दृष्ट्वा प्राणो गन्धवहो मुदा । चचार सर्वभूतेषु सन्निरुद्धं यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021423, "chapter_id": 9355, "verse_number": "6", "content_sanskrit": "मरुद्रोधाद्विनिर्मुक्तास्ताः प्रजा मुदिता ऽभवन् । शीतदाहविनिर्मुक्ताः पद्मिन्य इव साम्बुजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021424, "chapter_id": 9355, "verse_number": "7", "content_sanskrit": "ततस्त्रियुग्मस्त्रिककुत्ऺित्रधामा त्रिदशार्चितः । उवाच देवता ब्रह्मा मारुतप्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021425, "chapter_id": 9355, "verse_number": "8", "content_sanskrit": "भो महेन्द्रेशवरुणप्रजेश्वरधनेश्वराः । जानतामपि वः सर्वं वक्ष्यामि श्रूयतां हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021426, "chapter_id": 9355, "verse_number": "9", "content_sanskrit": "अनेन शिशुना कार्यं कर्तव्यं वो भविष्यति । तद्वदध्वं वरान्सर्वे मारुतस्यास्य तुष्टये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021427, "chapter_id": 9355, "verse_number": "10", "content_sanskrit": "ततः सहस्रनयनः प्रीतियुक्तः शुभाननः । कुशेशयमयीं मालामुत्क्षिप्येदं वचो ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021428, "chapter_id": 9355, "verse_number": "11", "content_sanskrit": "मत्करोत्सृष्टवज्रेण हनुरस्य यथा हतः । नाम्ना वै कपिशार्दूलो भविता हनुमानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021429, "chapter_id": 9355, "verse_number": "12", "content_sanskrit": "अहमस्य प्रदास्यामि परमं वरमद्भुतम् । इतः प्रभृति वज्रस्य ममावध्यो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021430, "chapter_id": 9355, "verse_number": "13", "content_sanskrit": "मार्तण्डस्त्वब्रवीत्तत्र भगवांस्तिमिरापहः । तेजसो ऽस्य मदीयस्य ददामि शतिकां कलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021431, "chapter_id": 9355, "verse_number": "14", "content_sanskrit": "यदा तु शास्त्राण्यध्येतुं शक्तिरस्य भविष्यति । तदास्य शास्त्रं दास्यामि येन वाग्ग्मी भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021432, "chapter_id": 9355, "verse_number": "15", "content_sanskrit": "नचास्य भविता कश्चित्सदृशः शास्त्रदर्शने । वरुणश्च वरं प्रादान्नास्य मृत्युर्भविष्यति । वर्षायुतशतेनापि मत्पाशादुदकादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021433, "chapter_id": 9355, "verse_number": "16", "content_sanskrit": "यमो दण्डादवध्यत्वमरोगत्वं च नित्यशः । वरं ददामि सन्तुष्ट अविषादं च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021434, "chapter_id": 9355, "verse_number": "17", "content_sanskrit": "गदेयं मामिका नैनं संयुगेषु वधिष्यति । इत्येवं वरदः प्राह तदा ह्येकाक्षिपिङ्गलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021435, "chapter_id": 9355, "verse_number": "18", "content_sanskrit": "मत्तो मदायुधानां च न वध्यो ऽयं भविष्यति । इत्येवं शङ्करेणापि दत्तो ऽस्य परमो वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021436, "chapter_id": 9355, "verse_number": "19", "content_sanskrit": "सर्वेषां ब्रह्मदण्डानामवध्यो ऽयं भविष्यति । दीर्घायुश्च महात्मा च इति ब्रह्माब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021437, "chapter_id": 9355, "verse_number": "20", "content_sanskrit": "विश्वकर्मा च दृष्ट्वैनं बालसूर्योपमं शिशुम् । शिल्पिनां प्रवरः प्रादाद्वरमस्य महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021438, "chapter_id": 9355, "verse_number": "21", "content_sanskrit": "मत्कृतानि च शस्त्राणि यानि दिव्यानि संयुगे । तैरवध्यत्वमापन्नश्चिरजीवी भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021439, "chapter_id": 9355, "verse_number": "22", "content_sanskrit": "ततः सुराणां तु वरैर्दृष्ट्वा ह्येनमलङ्कृतम् । चतुर्मुखस्तुष्टमना वायुमाह जगद्गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021440, "chapter_id": 9355, "verse_number": "23", "content_sanskrit": "अमित्राणां भयकरो मित्राणामभयङ्करः । अजेयो भविता पुत्रस्तव मारुत मारुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021441, "chapter_id": 9355, "verse_number": "24", "content_sanskrit": "कामरूपः कामचारी कामगः प्लवतां वरः । भवत्यव्याहतगतिः कीर्तिमांश्च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021442, "chapter_id": 9355, "verse_number": "25", "content_sanskrit": "रावणोत्सादनार्थानि रामप्रियकरणि च । रोमहर्षकराण्येष कर्ता कर्माणि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021443, "chapter_id": 9355, "verse_number": "26", "content_sanskrit": "एवमुक्त्वा तमामन्त्र्य मारुतं त्वमरैः सह । यथागतं ययुः सर्वे पितामहपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021444, "chapter_id": 9355, "verse_number": "27", "content_sanskrit": "सो ऽपि गन्धवहः पुत्रं प्रगृह्य गृहमानयत् । अञ्जनायास्तमाचख्यौ वरदत्तं विनिर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021445, "chapter_id": 9355, "verse_number": "28", "content_sanskrit": "प्राप्य राम वरानेष वरदानसमन्वितः । बलेनात्मनि संस्थेन सो ऽपूर्यत यथा ऽर्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021446, "chapter_id": 9355, "verse_number": "29", "content_sanskrit": "तरसा पूर्यमाणो ऽपि तदा वानरपुङ्गवः । आश्रमेषु महर्षीणामपराध्यति निर्भयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021447, "chapter_id": 9355, "verse_number": "30", "content_sanskrit": "स्रुग्भाण्डान्यग्निहोत्रं च वल्कलाजिनसञ्चयान् । भग्नविच्छिन्नविध्वस्तान्संशान्तानां करोत्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021448, "chapter_id": 9355, "verse_number": "31", "content_sanskrit": "एवंविधानि कर्माणि प्रावर्तत महाबलः । सर्वेषां ब्रह्मदण्डानामवध्यः शम्भुना कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021449, "chapter_id": 9355, "verse_number": "32", "content_sanskrit": "जानन्त ऋषयस्तं वै सहन्ते तस्य शक्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021450, "chapter_id": 9355, "verse_number": "33", "content_sanskrit": "यथा केसरिणा त्वेष वायुना सो ऽञ्जनासुतः । प्रतिषिद्धो ऽपि मर्यादां लङ्घयत्येव वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021451, "chapter_id": 9355, "verse_number": "34", "content_sanskrit": "ततो महर्षयः क्रुद्धा भृग्वङ्गिरसवंशजाः । शेपुरेनं रघुश्रेष्ठ नातिक्रुद्धातिमन्यवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40021452, "chapter_id": 9355, "verse_number": "35", "content_sanskrit": "बाधसे यत्समाश्रित्य बलमस्मान्प्लवङ्गम । तद्दीर्घकालं वेत्तासि नास्माकं शापमोहितः । यदा ते स्मार्यते कीर्तिस्तदा ते वर्धते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40021453, "chapter_id": 9355, "verse_number": "36", "content_sanskrit": "ततस्स हृततेजौजा महर्षिवचनौजसा । एषोश्रमाणि तान्येव मृदुभावं गतो ऽचरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40021454, "chapter_id": 9355, "verse_number": "37", "content_sanskrit": "अथर्क्षरजसो नाम वालिसुग्रीवयोः पिता । सर्ववानरराजा ऽ ऽसीत्तेजसा भास्करप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40021455, "chapter_id": 9355, "verse_number": "38", "content_sanskrit": "स तु राज्यं चिरं कृत्वा वानराणां हरीश्वरः । स च ऋक्षरजा नाम कालधर्मेण सङ्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40021456, "chapter_id": 9355, "verse_number": "39", "content_sanskrit": "तस्मिन्नस्तमिते चाथ मन्त्रिभिर्मन्त्रकोविदैः । पित्र्ये पदे कृतो वाली सुग्रीवो वालिनः पदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40021457, "chapter_id": 9355, "verse_number": "40", "content_sanskrit": "सुग्रीवेण समं त्वस्य अद्वैधं छिद्रवर्जितम् । आबाल्यं सख्यमभवदनिलस्याग्निना यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40021458, "chapter_id": 9355, "verse_number": "41", "content_sanskrit": "एष शापवशादेव न वेद बलमात्मनः । वालिसुग्रीवयोर्वैरं यदा राम समुत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40021459, "chapter_id": 9355, "verse_number": "42", "content_sanskrit": "न ह्येष राम सुग्रीवो भ्राम्यमाणो ऽपि वालिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40021460, "chapter_id": 9355, "verse_number": "43", "content_sanskrit": "देव जानाति न ह्येष बलमात्मनि मारुतिः । ऋषिशापाहृतबलस्तदैष कपिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40021461, "chapter_id": 9355, "verse_number": "44", "content_sanskrit": "सिंहः कुञ्जररुद्धो वा आस्थितः सहितो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40021462, "chapter_id": 9355, "verse_number": "45", "content_sanskrit": "पराक्रमोत्साहमतिप्रतापसौशील्यमाधुर्यनयानयैश्च । गाम्भीर्यचातुर्यसुवीर्यधैर्यैर्हनूमतः को ऽभ्यधिको ऽस्ति लोके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40021463, "chapter_id": 9355, "verse_number": "46", "content_sanskrit": "असौ पुनर्व्याकरणं ग्रहीष्यन्सूर्योन्मुखः प्रष्टुमना कपीन्द्रः । उद्यद्गिरेरस्तगिरिं जगाम ग्रन्थं महद्धारयनप्रमेयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40021464, "chapter_id": 9355, "verse_number": "47", "content_sanskrit": "ससूत्रवृत्त्यर्थपदं महार्थं ससङ्ग्रहं साद्ध्यति वै कपीन्द्रः । नह्यस्य कश्चित्सदृशो ऽस्ति शास्त्रे वैशारदे च्छन्दगतौ तथैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40021465, "chapter_id": 9355, "verse_number": "48", "content_sanskrit": "सर्वासु विद्यासु तपोविधाने प्रस्पर्धते ऽयो हि गुरुं सुराणाम् । सो ऽयं नवव्याकरणार्थवेत्ता ब्रह्मा भविष्यत्यपि ते प्रसादात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40021466, "chapter_id": 9355, "verse_number": "49", "content_sanskrit": "प्रवीविवक्षोरिव सागरस्य लोकान्दिधक्षोरिव पावकस्ययुगक्षये ह्येव यथान्तकस्य हनूमतः स्थास्यति कः पुरस्तात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40021467, "chapter_id": 9355, "verse_number": "50", "content_sanskrit": "एषेव चान्ये च महाकपीन्द्राः सुग्रीवमैन्दद्विविदाः सनीलाः । सतारतारेयनलाः सरम्भास्त्वत्कारणाद्राम सुरैर्हि सृष्टाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40021468, "chapter_id": 9355, "verse_number": "51", "content_sanskrit": "तदेत्कथितं सर्वं यन्मां त्वं परिपृच्छसि । हनूमतो बालभावे कर्मैतत्कथितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40021469, "chapter_id": 9355, "verse_number": "52", "content_sanskrit": "श्रुत्वा ऽगस्त्यस्य कथितं रामः सौमित्रिरेव च । विस्मयं परमं जग्मुर्वानरा राक्षसैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40021470, "chapter_id": 9355, "verse_number": "53", "content_sanskrit": "अगस्त्यस्त्वब्रवीद्रामं सर्वमेतछ्रुतं त्वया । दृष्टः सम्भाषितश्चासि राम गच्छामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40021471, "chapter_id": 9355, "verse_number": "54", "content_sanskrit": "श्रुत्वैतद्राघवो वाक्यमगस्त्यस्योग्रतेजसः । प्राञ्जलिः प्रणतश्चापि महर्षिमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40021472, "chapter_id": 9355, "verse_number": "55", "content_sanskrit": "अद्य मे देवता हृष्टाः पितरः प्रपितामहाः । युष्माकं दर्शनादेव नित्यं तुष्टाः सबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40021473, "chapter_id": 9355, "verse_number": "56", "content_sanskrit": "विज्ञाप्यं तु ममैतद्धि यद्वदाम्यागतस्पृहः । तद्भवद्भिर्मम कृते कर्तव्यमनुकम्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40021474, "chapter_id": 9355, "verse_number": "57", "content_sanskrit": "पौरजानपदान्स्थाप्य स्वकार्येष्वहमागतः । क्रतूनेव करिष्यामि प्रभावाद्भवतां सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40021475, "chapter_id": 9355, "verse_number": "58", "content_sanskrit": "सदस्या मम यज्ञेषु भवन्तो नित्यमेव तत् । भविष्यथ महावीर्या ममानुग्रहकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40021476, "chapter_id": 9355, "verse_number": "59", "content_sanskrit": "अहं युष्मान्समाश्रित्य तपोनिर्धूतकल्मषान् । अनुग्रहीतः पितृभिर्भविष्यामि सुनिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40021477, "chapter_id": 9355, "verse_number": "60", "content_sanskrit": "तदागन्तव्यमनिशं भवद्भिरिह सङ्गतैः । अगस्त्याद्यास्तु तच्छ्रुत्वा ऋषयः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40021478, "chapter_id": 9355, "verse_number": "61", "content_sanskrit": "एवमस्त्विति तं चोक्त्वा प्रयातुमुपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40021479, "chapter_id": 9355, "verse_number": "62", "content_sanskrit": "एवमुक्त्वा गताः सर्वे ऋषयस्ते यथागतम् । राघवश्च तमेवार्थं चिन्तयामास विस्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40021480, "chapter_id": 9355, "verse_number": "63", "content_sanskrit": "ततो ऽस्तं भास्करे याते विसृज्य नृपवानरान् । सन्ध्यामुपास्य विधिवत्तदा नरवरोत्तमः । प्रवृत्तायां रजन्यां तु सो ऽन्तःपुरचरो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]