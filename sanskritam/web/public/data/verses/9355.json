[{"id": 5000355000, "chapter_id": 9355, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000355001, "chapter_id": 9355, "verse_number": "५-१६-१", "content_sanskrit": "प्रशस्य तु प्रशस्तव्यां सीतां तां हरिपुंगवः।\nगुणाभिरामं रामं च पुनश्चिन्तापरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000355002, "chapter_id": 9355, "verse_number": "५-१६-२", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा बाष्पपर्याकुलेक्षणः।\nसीतामाश्रित्य तेजस्वी हनूमान् विललाप ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000355003, "chapter_id": 9355, "verse_number": "५-१६-३", "content_sanskrit": "मान्या गुरुविनीतस्य लक्ष्मणस्य गुरुप्रिया।\nयदि सीता हि दुःखार्ता कालो हि दुरतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000355004, "chapter_id": 9355, "verse_number": "५-१६-४", "content_sanskrit": "रामस्य व्यवसायज्ञा लक्ष्मणस्य च धीमतः।\nनात्यर्थं क्षुभ्यते देवी गंगेव जलदागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000355005, "chapter_id": 9355, "verse_number": "५-१६-५", "content_sanskrit": "तुल्यशीलवयोवृत्तां तुल्याभिजनलक्षणाम्।\nराघवोऽर्हति वैदेहीं तं चेयमसितेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000355006, "chapter_id": 9355, "verse_number": "५-१६-६", "content_sanskrit": "तां दृष्ट्वा नवहेमाभां लोककान्तामिव श्रियम्।\nजगाम मनसा रामं वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000355007, "chapter_id": 9355, "verse_number": "५-१६-७", "content_sanskrit": "अस्या हेतोर्विशालाक्ष्या हतो वाली महाबलः।\nरावणप्रतिमो वीर्ये कबन्धश्च निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000355008, "chapter_id": 9355, "verse_number": "५-१६-८", "content_sanskrit": "विराधश्च हतः संख्ये राक्षसो भीमविक्रमः।\nवने रामेण विक्रम्य महेन्द्रेणेव शम्बरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000355009, "chapter_id": 9355, "verse_number": "५-१६-९", "content_sanskrit": "चतुर्दश सहस्राणि रक्षसां भीमकर्मणाम्।\nनिहतानि जनस्थाने शरैरग्निशिखोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000355010, "chapter_id": 9355, "verse_number": "५-१६-१०", "content_sanskrit": "खरश्च निहतः संख्ये त्रिशिराश्च निपातितः।\nदूषणश्च महातेजा रामेण विदितात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000355011, "chapter_id": 9355, "verse_number": "५-१६-११", "content_sanskrit": "ऐश्वर्यं वानराणां च दुर्लभं वालिपालितम्।\nअस्या निमित्ते सुग्रीवः प्राप्तवाँल्लोकविश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000355012, "chapter_id": 9355, "verse_number": "५-१६-१२", "content_sanskrit": "सागरश्च मयाऽऽक्रान्तः श्रीमान् नदनदीपतिः।\nअस्या हेतोर्विशालाक्ष्याः पुरी चेयं निरीक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000355013, "chapter_id": 9355, "verse_number": "५-१६-१३", "content_sanskrit": "यदि रामः समुद्रान्तां मेदिनीं परिवर्तयेत्।\nअस्याः कृते जगच्चापि युक्तमित्येव मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000355014, "chapter_id": 9355, "verse_number": "५-१६-१४", "content_sanskrit": "राज्यं वा त्रिषु लोकेषु सीता वा जनकात्मजा।\nत्रैलोक्यराज्यं सकलं सीताया नाप्नुयात् कलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000355015, "chapter_id": 9355, "verse_number": "५-१६-१५", "content_sanskrit": "इयं सा धर्मशीलस्य जनकस्य महात्मनः।\nसुता मैथिलराजस्य सीता भर्तृदृढव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000355016, "chapter_id": 9355, "verse_number": "५-१६-१६", "content_sanskrit": "उत्थिता मेदिनीं भित्त्वा क्षेत्रे हलमुखक्षते।\nपद्मरेणुनिभैः कीर्णा शुभैः केदारपांसुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000355017, "chapter_id": 9355, "verse_number": "५-१६-१७", "content_sanskrit": "विक्रान्तस्यार्यशीलस्य संयुगेष्वनिवर्तिनः।\nस्नुषा दशरथस्यैषा ज्येष्ठा राज्ञो यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000355018, "chapter_id": 9355, "verse_number": "५-१६-१८", "content_sanskrit": "धर्मज्ञस्य कृतज्ञस्य रामस्य विदितात्मनः।\nइयं सा दयिता भार्या राक्षसीवशमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000355019, "chapter_id": 9355, "verse_number": "५-१६-१९", "content_sanskrit": "सर्वान् भोगान् परित्यज्य भर्तृस्नेहबलात् कृता।\nअचिन्तयित्वा कष्टानि प्रविष्टा निर्जनं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000355020, "chapter_id": 9355, "verse_number": "५-१६-२०", "content_sanskrit": "संतुष्टा फलमूलेन भर्तृशुश्रूषणापरा।\nया परां भजते प्रीतिं वनेऽपि भवने यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000355021, "chapter_id": 9355, "verse_number": "५-१६-२१", "content_sanskrit": "सेयं कनकवर्णांगी नित्यं सुस्मितभाषिणी।\nसहते यातनामेतामनर्थानामभागिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000355022, "chapter_id": 9355, "verse_number": "५-१६-२२", "content_sanskrit": "इमां तु शीलसम्पन्नां द्रष्टुमिच्छति राघवः।\nरावणेन प्रमथितां प्रपामिव पिपासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000355023, "chapter_id": 9355, "verse_number": "५-१६-२३", "content_sanskrit": "अस्या नूनं पुनर्लाभाद् राघवः प्रीतिमेष्यति।\nराजा राज्यपरिभ्रष्टः पुनः प्राप्येव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000355024, "chapter_id": 9355, "verse_number": "५-१६-२४", "content_sanskrit": "कामभोगैः परित्यक्ता हीना बन्धुजनेन च।\nधारयत्यात्मनो देहं तत्समागमकाङ्क्षिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000355025, "chapter_id": 9355, "verse_number": "५-१६-२५", "content_sanskrit": "नैषा पश्यति राक्षस्यो नेमान् पुष्पफलद्रुमान्।\nएकस्थहृदया नूनं राममेवानुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000355026, "chapter_id": 9355, "verse_number": "५-१६-२६", "content_sanskrit": "भर्ता नाम परं नार्याः शोभनं भूषणादपि।\nएषा हि रहिता तेन शोभनार्हा न शोभते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000355027, "chapter_id": 9355, "verse_number": "५-१६-२७", "content_sanskrit": "दुष्करं कुरुते रामो हीनो यदनया प्रभुः।\nधारयत्यात्मनो देहं न दुःखेनावसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000355028, "chapter_id": 9355, "verse_number": "५-१६-२८", "content_sanskrit": "इमामसितकेशान्तां शतपत्रनिभेक्षणाम्।\nसुखार्हां दुःखितां ज्ञात्वा ममापि व्यथितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000355029, "chapter_id": 9355, "verse_number": "५-१६-२९", "content_sanskrit": "क्षितिक्षमा पुष्करसंनिभेक्षणा\nया रक्षिता राघवलक्ष्मणाभ्याम्।\nसा राक्षसीभिर्विकृतेक्षणाभिः\nसंरक्ष्यते सम्प्रति वृक्षमूले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000355030, "chapter_id": 9355, "verse_number": "५-१६-३०", "content_sanskrit": "हिमहतनलिनीव नष्टशोभा\nव्यसनपरम्परया निपीड्यमाना।\nसहचररहितेव चक्रवाकी\nजनकसुता कृपणां दशां प्रपन्ना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000355031, "chapter_id": 9355, "verse_number": "५-१६-३१", "content_sanskrit": "अस्या हि पुष्पावनताग्रशाखाः\nशोकं दृढं वै जनयन्त्यशोकाः।\nहिमव्यपायेन च शीतरश्मि-\nरभ्युत्थितो नैकसहस्ररश्मिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000355032, "chapter_id": 9355, "verse_number": "५-१६-३२", "content_sanskrit": "इत्येवमर्थं कपिरन्ववेक्ष्य\nसीतेयमित्येव तु जातबुद्धिः।\nसंश्रित्य तस्मिन् निषसाद वृक्षे\nबली हरीणामृषभस्तरस्वी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000355033, "chapter_id": 9355, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]