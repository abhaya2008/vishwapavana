[{"id": 6000279000, "chapter_id": 10279, "verse_number": null, "content_sanskrit": "अथ त्र्यशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000279001, "chapter_id": 10279, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.001.m4a", "display_order": 2}, {"id": 6000279002, "chapter_id": 10279, "verse_number": "१०-८३-१", "content_sanskrit": "अयुते द्वे शतान्यष्टौ लीलया युधि निर्जिताः।\nविनिर्गता गिरिद्रोण्यां मलिनो मलवाससः॥ १०/८३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णेन जरासन्धावरुद्धानां नृपार्णं मोचनं सत्कृत्य स्वस्वस्थानप्रेषणं च", "range": "१–७"}]}, {"id": 6000279003, "chapter_id": 10279, "verse_number": "१०-८३-२", "content_sanskrit": "क्षुत्क्षामाः शुष्कवदनाः संरोधपरिकर्शिताः।\nददृशुस्ते घनश्यामं पीतकौशेयवाससम्॥ १०/८३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.003.m4a", "display_order": 4}, {"id": 6000279004, "chapter_id": 10279, "verse_number": "१०-८३-३", "content_sanskrit": "श्रीवत्साङ्कं चतुर्बाहुं पद्मपत्रनिभेक्षणम्।\nचारुप्रसन्नवदनं स्फुरन्मकरकुण्डलम्॥ १०/८३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.004.m4a", "display_order": 5}, {"id": 6000279005, "chapter_id": 10279, "verse_number": "१०-८३-४", "content_sanskrit": "पद्महस्तं गदाशङ्खरथाङ्गैरुपलक्षितम्।\nकिरीटहारकटककटिसूत्राङ्गदान्वितम्॥ १०/८३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.005.m4a", "display_order": 6}, {"id": 6000279006, "chapter_id": 10279, "verse_number": "१०-८३-५", "content_sanskrit": "भ्राजद्वरमणिग्रीवं निवीतं वनमालया।\nपिबन्त इव चक्षुर्भ्यां लिहन्त इव जिह्वया॥ १०/८३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.006.m4a", "display_order": 7}, {"id": 6000279007, "chapter_id": 10279, "verse_number": "१०-८३-६", "content_sanskrit": "जिघ्रन्त इव नासाभ्यामीहन्त इव चेतसा।\nप्रणेमुर्हतपाप्मानो मूर्धभिः पादयोर्हरेः॥ १०/८३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.007.m4a", "display_order": 8}, {"id": 6000279008, "chapter_id": 10279, "verse_number": "१०-८३-७", "content_sanskrit": "कृष्णसन्दर्शनाह्लादध्वस्तसंरोधनक्लमाः।\nप्रशशंसुर्हृषीकेशं गीर्भिः प्राञ्जलयो नृपाः॥ १०/८३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.008.m4a", "display_order": 9}, {"id": 6000279009, "chapter_id": 10279, "verse_number": null, "content_sanskrit": "राजान ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.009.m4a", "display_order": 10}, {"id": 6000279010, "chapter_id": 10279, "verse_number": "१०-८३-८", "content_sanskrit": "नमस्ते देवदेवेश प्रपन्नार्तिहराव्यय।\nप्रपन्नान् पाहि नः कृष्ण निर्विण्णान् घोरसंसृतेः॥ १०/८३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.010.m4a", "display_order": 11, "topics": [{"text": "राजकृतप्रार्थना", "range": "८–१६"}]}, {"id": 6000279011, "chapter_id": 10279, "verse_number": "१०-८३-९", "content_sanskrit": "नैव नाथाभ्यसूयामो मागधं मधुसूदन।\nअनुग्रहो यद् भवतो राज्ञां राज्यच्युतिर्विभो॥ १०/८३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.011.m4a", "display_order": 12}, {"id": 6000279012, "chapter_id": 10279, "verse_number": "१०-८३-१०", "content_sanskrit": "राज्यैश्वर्यमदोन्नद्धा न श्रेयो विन्दते नृपाः।\nत्वन्मायामोहिता नित्या मन्यन्ते सम्पदश्चलाः॥ १०/८३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.012.m4a", "display_order": 13}, {"id": 6000279013, "chapter_id": 10279, "verse_number": "१०-८३-११", "content_sanskrit": "मृगतृष्णां यथा बाला मन्यन्ते उदकाशयम्।\nएवं वैकारिकीं मायामयुक्ता वस्तु चक्षते॥ १०/८३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.013.m4a", "display_order": 14}, {"id": 6000279014, "chapter_id": 10279, "verse_number": "१०-८३-१२", "content_sanskrit": "वयं पुरा श्रीमदनष्टबुद्धयो जिहीर्षयाऽस्या इतरेतरस्पृधः।\nघ्नन्तः प्रजाः स्वा अपि निर्घृणाः प्रभो मृत्युं परं त्वामगणय्य दुर्मदाः॥ १०/८३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.014.m4a", "display_order": 15}, {"id": 6000279015, "chapter_id": 10279, "verse_number": "१०-८३-१३", "content_sanskrit": "त एव कृष्णाद्य गभीररंहसा अनन्तवीर्येण विचालिताः श्रियः।\nकालेन तद् वै भवतोऽनुकम्पया विनष्टदर्पाश्चरणौ स्मरामहे॥ १०/८३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.015.m4a", "display_order": 16}, {"id": 6000279016, "chapter_id": 10279, "verse_number": "१०-८३-१४", "content_sanskrit": "अथो न राज्यं मृगतृष्णरूपितं देहेन शश्वत्पतता रजोभुवा।\nउपासितव्यं स्पृहयामहे विभो क्रियाफलं प्रेत्य च कर्णरोचनम्॥ १०/८३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.016.m4a", "display_order": 17}, {"id": 6000279017, "chapter_id": 10279, "verse_number": "१०-८३-१५", "content_sanskrit": "तन्नः समादिशोपायं येन ते चरणाब्जयोः।\nस्मृतिर्यथा न विरमेदपि संसरतामिह॥ १०/८३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.017.m4a", "display_order": 18}, {"id": 6000279018, "chapter_id": 10279, "verse_number": "१०-८३-१६", "content_sanskrit": "कृष्णाय वासुदेवाय हरये परमात्मने।\nप्रणतक्लेशनाशाय गोविन्दाय नमो नमः॥ १०/८३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.018.m4a", "display_order": 19}, {"id": 6000279019, "chapter_id": 10279, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.019.m4a", "display_order": 20}, {"id": 6000279020, "chapter_id": 10279, "verse_number": "१०-८३-१७", "content_sanskrit": "संस्तूयमानो भगवान् राजभिर्मुक्तबन्धनैः।\nतानाह करुणस्तात शरण्यः श्लक्ष्णया गिरा॥ १०/८३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.020.m4a", "display_order": 21}, {"id": 6000279021, "chapter_id": 10279, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.021.m4a", "display_order": 22}, {"id": 6000279022, "chapter_id": 10279, "verse_number": "१०-८३-१८", "content_sanskrit": "अद्य प्रभृति वो भूपा मय्यात्मन्यखिलेश्वरे।\nसुदृढा जायते भक्तिर्बाढमाशासितं तथा॥ १०/८३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.022.m4a", "display_order": 23, "topics": [{"text": "राज्ञा कृष्णोपदेशः", "range": "१८–३५"}]}, {"id": 6000279023, "chapter_id": 10279, "verse_number": "१०-८३-१९", "content_sanskrit": "दिष्ट्या व्यवसितं भूपा भवन्त ऋतभाषिणः।\nश्रियैश्वर्यमदोन्नाहं पश्यतोन्मादनं नृणाम्॥ १०/८३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.023.m4a", "display_order": 24}, {"id": 6000279024, "chapter_id": 10279, "verse_number": "१०-८३-२०", "content_sanskrit": "हैहयो नहुषो वेनो रावणो नरकोऽपरे।\nश्रीमदाद् ध्वंसिताः स्थानाद् देवदैत्यनरेश्वराः॥ १०/८३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.024.m4a", "display_order": 25}, {"id": 6000279025, "chapter_id": 10279, "verse_number": "१०-८३-२१", "content_sanskrit": "सञ्चिन्तयत विज्ञाय देहाद्युत्पाद्यमन्तवत्।\nमां यजन्तोऽध्वरैर्यत्ताः प्रजा धर्मेण रक्षत॥ १०/८३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.025.m4a", "display_order": 26}, {"id": 6000279026, "chapter_id": 10279, "verse_number": "१०-८३-२२", "content_sanskrit": "सन्तन्वन्तः प्रजातन्तून् सुखदुःखे भवाभवौ।\nप्राप्ताप्राप्तं च सेवन्तो मच्चित्ता विचरिष्यथ॥ १०/८३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.026.m4a", "display_order": 27}, {"id": 6000279027, "chapter_id": 10279, "verse_number": "१०-८३-२३", "content_sanskrit": "उदासीनाश्च देहादावात्मारामा धृतव्रताः।\nमय्यावेश्य मनः सम्यङ् मामन्ते ब्रह्म यास्यथ॥ १०/८३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.027.m4a", "display_order": 28}, {"id": 6000279028, "chapter_id": 10279, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.028.m4a", "display_order": 29}, {"id": 6000279029, "chapter_id": 10279, "verse_number": "१०-८३-२४", "content_sanskrit": "इत्यादिश्य नृपान् कृष्णो भगवान् भुवनेश्वरः।\nतेषां न्ययुङ्क्त पुरुषान् स्‍त्रियो मज्जनकर्मणि॥ १०/८३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.029.m4a", "display_order": 30}, {"id": 6000279030, "chapter_id": 10279, "verse_number": "१०-८३-२५", "content_sanskrit": "सपर्यां कारयामास सहदेवेन भारत।\nनरदेवोचितैर्वस्‍त्रैर्भूषणैः स्रग्विलेपनैः॥ १०/८३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.030.m4a", "display_order": 31}, {"id": 6000279031, "chapter_id": 10279, "verse_number": "१०-८३-२६", "content_sanskrit": "भोजयित्वा वरान्नेन सुस्नातान् समलङ्कृतान्।\nभोगैश्च विविधैर्युक्तास्ताम्बूलाद्यैर्नृपोचितैः॥ १०/८३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.031.m4a", "display_order": 32}, {"id": 6000279032, "chapter_id": 10279, "verse_number": "१०-८३-२७", "content_sanskrit": "ते पूजिता मुकुन्देन राजानो मृष्टकुण्डलाः।\nविरेजुर्मोचिताः क्लेशात् प्रावृडन्ते यथा ग्रहाः॥ १०/८३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.032.m4a", "display_order": 33}, {"id": 6000279033, "chapter_id": 10279, "verse_number": "१०-८३-२८", "content_sanskrit": "रथान् सदश्वानारोप्य मणिकाञ्चनभूषितान्।\nप्रीणय्य सूनृतैर्वाक्यैः स्वदेशान् प्रत्ययापयत्॥ १०/८३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.033.m4a", "display_order": 34}, {"id": 6000279034, "chapter_id": 10279, "verse_number": "१०-८३-२९", "content_sanskrit": "त एवं मोचिताः कृच्छ्रात् कृष्णेन सुमहात्मना।\nययुस्तमेव ध्यायन्तः कृतानि च जगत्पतेः॥ १०/८३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.034.m4a", "display_order": 35}, {"id": 6000279035, "chapter_id": 10279, "verse_number": "१०-८३-३०", "content_sanskrit": "जगदुः प्रकृतिभ्यस्ते महापुरुषचेष्टितम्।\nयथाऽन्वशासद् भगवान् तथा चक्रुरतन्द्रिताः॥ १०/८३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.035.m4a", "display_order": 36}, {"id": 6000279036, "chapter_id": 10279, "verse_number": "१०-८३-३१", "content_sanskrit": "जरासन्धं घातयित्वा भीमसेनेन केशवः।\nपार्थाभ्यां संयुतः प्रायात् सहदेवेन पूजितः॥ १०/८३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.036.m4a", "display_order": 37}, {"id": 6000279037, "chapter_id": 10279, "verse_number": "१०-८३-३२", "content_sanskrit": "ते गत्वा खाण्डवप्रस्थं शङ्खान् दध्मुर्जितारयः।\nहर्षयन्तः स्वसुहृदो दुर्हृदां चासुखावहाः॥ १०/८३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.037.m4a", "display_order": 38}, {"id": 6000279038, "chapter_id": 10279, "verse_number": "१०-८३-३३", "content_sanskrit": "तच्छ्रुत्वा प्रीतमनस इन्द्रप्रस्थनिवासिनः।\nमेनिरे मागधं शान्तं राजा प्राप्तमनोरथः॥ १०/८३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.038.m4a", "display_order": 39}, {"id": 6000279039, "chapter_id": 10279, "verse_number": "१०-८३-३४", "content_sanskrit": "अभिवाद्याथ राजानं भीमार्जुनजनार्दनाः।\nसर्वमाश्रावयाञ्चक्रुरात्मना यदनुष्ठितम्॥ १०/८३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.039.m4a", "display_order": 40}, {"id": 6000279040, "chapter_id": 10279, "verse_number": "१०-८३-३५", "content_sanskrit": "निशम्य धर्मराजस्तु केशवेनानुकम्पितम्।\nआनन्दाश्रुकणान्मुञ्चन् प्रेम्णा नोवाच किञ्चन॥ १०/८३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_083/BhP_10.083.040.m4a", "display_order": 41}, {"id": 6000279041, "chapter_id": 10279, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे त्र्यशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]