[{"id": 7004985000, "chapter_id": 24985, "verse_number": "७-१-१६८-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि देवीं शालकटंकटाम् ।\nसावित्र्या दक्षिणे भागे रैवतात्पूर्वतः स्थिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004985001, "chapter_id": 24985, "verse_number": "७-१-१६८-२", "content_sanskrit": "महापापोपशमनीं सर्वदुःखविनाशनीम्॥ पूजितां सर्वगन्धर्वैः स्फुरद्दंष्ट्रोग्रभीषणाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004985002, "chapter_id": 24985, "verse_number": "७-१-१६८-३", "content_sanskrit": "महाप्रचण्डदैत्यघ्नीं पौलस्त्येन प्रतिष्ठिताम् ।\nमहिषघ्नीं महाकायां क्षेत्रे प्राभासिके स्थिताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004985003, "chapter_id": 24985, "verse_number": "७-१-१६८-४", "content_sanskrit": "माघे मासे चतुर्दश्यां यस्ता माराधयेन्नरः ।\nस भवेत्पशुमान्धीमांल्लक्ष्मीवान्पुत्रवान्सुधीः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004985004, "chapter_id": 24985, "verse_number": "७-१-१६८-५", "content_sanskrit": "यस्तां पशुप्रदानेन सन्तर्पयति भक्तितः ।\nबलिपूजोपहारैश्च स स्याच्छत्रु विवर्जितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004985005, "chapter_id": 24985, "verse_number": "७-१-१६८-६", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहिताया सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये शालकटंकटा माहात्म्यवर्णनंनामाष्टषष्ट्युत्तरशततमोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]