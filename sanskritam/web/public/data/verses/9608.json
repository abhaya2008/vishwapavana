[{"id": 5000608000, "chapter_id": 9608, "verse_number": "७-७३-१", "content_sanskrit": "प्रस्थाप्य तु स शत्रुघ्नं भ्रातृभ्यां सह राघवः ।\nप्रमुमोद सुखी राज्यं धर्मेण परिपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000608001, "chapter_id": 9608, "verse_number": "७-७३-२", "content_sanskrit": "ततः कतिपयाहःसु वृद्धो जानपदो द्विजः ।\nमृतं बालमुपादाय राजद्वारमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000608002, "chapter_id": 9608, "verse_number": "७-७३-३", "content_sanskrit": "रुदन्बहुविधा वाचः स्नेहदुःखसमन्विताः ।\nअसकृत्पुत्र पुत्रेति वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000608003, "chapter_id": 9608, "verse_number": "७-७३-४", "content_sanskrit": "किं नु मे दुष्कृतं कर्म पुरा देहान्तरे कृतम् ।\nयदहं पुत्रमेकं त्वां पश्यामि निधनं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000608004, "chapter_id": 9608, "verse_number": "७-७३-५", "content_sanskrit": "अप्राप्तयौवनं बालं पञ्चवर्षसहस्रकम् ।\nअकाले कालमापन्नं मम दुःखाय पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000608005, "chapter_id": 9608, "verse_number": "७-७३-६", "content_sanskrit": "अल्पैरहोभिर्निधनं गमिष्यामि न संशयः ।\nअहं च जननी चैव तव शोकेन पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000608006, "chapter_id": 9608, "verse_number": "७-७३-७", "content_sanskrit": "न स्मराम्यनृतं ह्युक्तं न च हिंसां स्मराम्यहम् ।\nसर्वेषां प्राणिनां पापं कृतं नैव स्मराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000608007, "chapter_id": 9608, "verse_number": "७-७३-८", "content_sanskrit": "केनाद्य दुष्कृतेनायं बाल एव ममात्मजः ।\nअकृत्वा पितृकार्याणि गतो वैवस्वतक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000608008, "chapter_id": 9608, "verse_number": "७-७३-९", "content_sanskrit": "नेदृशं दृष्टपूर्वं मे श्रुतं वा घोरदर्शनम् ।\nमृत्युरप्राप्तकालानां रामस्य विषये यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000608009, "chapter_id": 9608, "verse_number": "७-७३-१०", "content_sanskrit": "रामस्य दुष्कृतं किञ्चिन्महदस्ति न संशयः ।\nयथा हि विषयस्थानां बालानां मृत्युरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000608010, "chapter_id": 9608, "verse_number": "७-७३-११", "content_sanskrit": "नह्यन्यविषयस्थानां बालानां मृत्युतो भयम् ।\nत्वं राजञ्जीवयस्वैनं बालं मृत्युवशं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000608011, "chapter_id": 9608, "verse_number": "७-७३-१२", "content_sanskrit": "राजद्वारि मरिष्यामि पत्न्या सार्धमनाथवत् ।\nब्रह्महत्यां ततो राम समुपेत्य सुखी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000608012, "chapter_id": 9608, "verse_number": "७-७३-१३", "content_sanskrit": "भ्रातृभिः सहितो राजन्दीर्घमायुरवाप्स्यसि ।\nउषिताः स्म सुखं राज्ये तवास्मिन्सुमहाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000608013, "chapter_id": 9608, "verse_number": "७-७३-१४", "content_sanskrit": "इदं तु पतितं तस्मात्तव राम वशे स्थिताः ।\nकालस्य वशमापन्नाः स्वल्पं हि नहि नः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000608014, "chapter_id": 9608, "verse_number": "७-७३-१५", "content_sanskrit": "सम्प्रत्यनाथो विषय इक्ष्वाकूणां महात्मनाम् ।\nरामं नाथमिहासाद्य बालान्तकरणं ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000608015, "chapter_id": 9608, "verse_number": "७-७३-१६", "content_sanskrit": "राजदोषैर्विपद्यन्ते प्रजा ह्यविधिपालिताः ।\nअसद्वृत्ते तु नृपतावकाले म्रियते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000608016, "chapter_id": 9608, "verse_number": "७-७३-१७", "content_sanskrit": "यद्वा पुरेष्वयुक्तानि जना जनपदेषु च ।\nकुर्वते न च रक्षा ऽस्ति तदा कालकृतं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000608017, "chapter_id": 9608, "verse_number": "७-७३-१८", "content_sanskrit": "सुव्यक्तं राजदोषो हि भविष्यति न संशयः ।\nपुरे जनपदे चापि ततो बालवधो ह्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000608018, "chapter_id": 9608, "verse_number": "७-७३-१९", "content_sanskrit": "एवं बहुविधैर्वाक्यैरुपरुध्य मुहुर्मुहुः ।\nराजानं दुःखसन्तप्तः सुतं तमुपगूहते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000608019, "chapter_id": 9608, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रिसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]