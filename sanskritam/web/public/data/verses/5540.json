[{"id": 2212921, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "वेशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212922, "chapter_id": 5540, "verse_number": "१", "content_sanskrit": "व्युषितायां रजन्यां तु धृतराष्ट्रोऽम्बिकासुतः ।\nविदुरं प्रेषयामास युधिष्ठिरनिवेशनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212923, "chapter_id": 5540, "verse_number": "२", "content_sanskrit": "स गत्वा राजवचनाद् उवाचाच्युतमीश्वरम् ।\nयुधिष्ठिरं महातेजाः सर्वबुद्धिमतां वरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212924, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212925, "chapter_id": 5540, "verse_number": "३", "content_sanskrit": "धृतराष्ट्रो महातेजा वनवासाय दीक्षितः ।\nगमिष्यति वनं राजा कार्तिकीमागतामिमाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212926, "chapter_id": 5540, "verse_number": "४", "content_sanskrit": "स त्वां कुरुकुलश्रेष्ठ किञ्चिदर्थमभीप्सति ।\nश्राद्धमिच्छति दातुं स गाङ्गेयस्य महात्मनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212927, "chapter_id": 5540, "verse_number": "५", "content_sanskrit": "द्रोणस्य सोमदत्तस्य बाह्लीकस्य च धीमतः ।\nपुत्राणां चैव सर्वेषां ये चान्ये सुहृदो हताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212928, "chapter_id": 5540, "verse_number": "६", "content_sanskrit": "यदि वाऽप्यनुजानीषे सैन्धवापशदस्य च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212929, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212930, "chapter_id": 5540, "verse_number": "७", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं विदुरस्य युधिष्ठिरः ।\nहृष्टः सम्पूजयामास गुडाकेशश्च पाण्डवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212931, "chapter_id": 5540, "verse_number": "८", "content_sanskrit": "न तु भीमो दृढक्रोधः तद्वचो जगृहे तदा ।\nविदुरस्य महातेजा दुर्योधनकृतं स्मरन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212932, "chapter_id": 5540, "verse_number": "९", "content_sanskrit": "अभिप्रायं विदित्वा तु भीमसेनस्य फल्गुनः ।\nकिरीटी किञ्चिदानम्य भीमं वचनमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212933, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212934, "chapter_id": 5540, "verse_number": "१०", "content_sanskrit": "भीम राजा पिता वृद्धो वनवासाय दीक्षितः ।\nदातुमिच्छति सर्वेषां सुहृदामौर्ध्वदैहिकम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212935, "chapter_id": 5540, "verse_number": "११", "content_sanskrit": "भवता निर्जितं वित्तं दातुमिच्छति कौरवः ।\nभीष्मादीनां महाबाहो तदनुज्ञातुमर्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212936, "chapter_id": 5540, "verse_number": "१२", "content_sanskrit": "दिष्ट्या त्वद्य महाबाहो धृतराष्ट्रः प्रयाचति ।\nयाचितोऽयं पुराऽस्माभिः पश्य कालस्य पर्ययम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212937, "chapter_id": 5540, "verse_number": "१३", "content_sanskrit": "योऽसौ पृथिव्याः कृत्स्नाया भर्ता भूत्वा नराधिपः ।\nपरैर्विनिहतामात्यो वनं गन्तुमभीप्सति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212938, "chapter_id": 5540, "verse_number": "१४", "content_sanskrit": "मा तेऽन्यत् पुरुषव्याघ्र दानाद् भवतु दर्शनम् ।\nअयशस्यमतोऽन्यत् स्याद् अधर्मश्च महाभुज\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212939, "chapter_id": 5540, "verse_number": "१५", "content_sanskrit": "राजानमुतिष्ठस्व ज्येष्ठं भ्रातरमीश्वरम् ।\nअर्हस्त्वमसि दातुं वै नादातुं भरतर्षभ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212940, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212941, "chapter_id": 5540, "verse_number": "१६", "content_sanskrit": "एवं ब्रुवाणं कौन्तेयं धर्मराजोऽभ्यपूजयत् ।\nभीमसेनस्तु सक्रोधमुवाच विजयं तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212942, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212943, "chapter_id": 5540, "verse_number": "१७", "content_sanskrit": "वयं भीष्मस्य कुर्मो हि प्रेतकार्याणि फल्गुन ।\nसोमदत्तस्य नृपतेर्भूरिश्रवस एव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212944, "chapter_id": 5540, "verse_number": "१८", "content_sanskrit": "बाह्लिकस्य च राजर्षेर्द्रोणस्य च महात्मनः ।\nअन्येषां चैव सुहृदां कुन्ती कर्णाय दास्यति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212945, "chapter_id": 5540, "verse_number": "१९", "content_sanskrit": "श्राद्धानि पुरुषव्याघ्र मा दात् कौरवको नृपः ।\nएवं ते वर्ततां बुद्धिर्मा वो नन्दन्तु शत्रवः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212946, "chapter_id": 5540, "verse_number": "२०", "content_sanskrit": "कष्टात् कष्टतरं यान्तु सर्वे दुर्योधनादयः ।\nयैरियं पृथिवी सर्वा घातिता कुलपांसनैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212947, "chapter_id": 5540, "verse_number": "२१", "content_sanskrit": "कुतस्त्वमद्य विस्मृत्य वैरं द्वादशवार्षिकम् ।\nअज्ञातवासगमनं द्रौपदीशोकवर्धनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212948, "chapter_id": 5540, "verse_number": "२२", "content_sanskrit": "क्व तदा धृतराष्ट्रस्य स्नेहोऽस्मास्वभवत् तथा ।\nकृष्णाजिनोपसंवीतो हृताभरणभूषणः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212949, "chapter_id": 5540, "verse_number": "२३", "content_sanskrit": "सार्धं पाञ्चालपुत्र्या त्वं राजानमुपजग्मिवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212950, "chapter_id": 5540, "verse_number": "२४", "content_sanskrit": "क्व तदा द्रोणभीष्मौ तौ सोमदत्तोऽपि वाऽभवत् ।\nयत्र द्वादश वर्षाणि वने वन्येन जीवसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212951, "chapter_id": 5540, "verse_number": "२५", "content_sanskrit": "न तदा त्वत्पिता ज्येष्ठः पितृत्वेनाभिवीक्षति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212952, "chapter_id": 5540, "verse_number": "२६", "content_sanskrit": "किं नु तद्विस्मृतं तेऽद्य यदेष कुलपांसनः ।\nदुर्वृत्तो विदुरं प्राह द्यूते किं जितमित्युत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212953, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212954, "chapter_id": 5540, "verse_number": "२७", "content_sanskrit": "तमेवंवादिनं राजा कुन्तीपुत्रो युधिष्ठिरः ।\nउवाच भ्रातरं धीमान् जोषमास्स्वेति भर्त्सयन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212955, "chapter_id": 5540, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि भीमवाक्यं नाम षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212956, "chapter_id": 5540, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि षोडशोऽध्यायः ॥१६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]