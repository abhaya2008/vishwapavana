[{"id": 2018634, "chapter_id": 1390, "verse_number": "३-२८-०x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018635, "chapter_id": 1390, "verse_number": "३-२८-१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nप्रह्लादस्य च संवादं बलेर्वैरोचनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018636, "chapter_id": 1390, "verse_number": "३-२८-२", "content_sanskrit": "असुरेन्द्रं महाप्राज्ञं धर्माणामागतागमम्।\nबलिः पप्रच्छ दैत्येनद्रं प्रह्लादं पितरं पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018637, "chapter_id": 1390, "verse_number": "३-२८-३", "content_sanskrit": "क्षमा स्विच्छ्रेयसी तात उताहो तेज इत्युत।\nएतन्मे संशयं तात यथावद्ब्रूहि पृच्छते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018638, "chapter_id": 1390, "verse_number": "३-२८-४", "content_sanskrit": "श्रेयो यदत्र धर्मज्ञ ब्रूहि मे तदसंशयम्।\nकरिष्यामि हि तत्सर्वं यथावदनुशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018639, "chapter_id": 1390, "verse_number": "३-२८-५", "content_sanskrit": "तस्मै प्रोवाच तत्सर्वमेवं पृष्टः पितामहः।\nसर्वनिश्चयवित्प्राज्ञः संशयं परिपृच्छते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018640, "chapter_id": 1390, "verse_number": "३-२८-६x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018641, "chapter_id": 1390, "verse_number": "३-२८-६", "content_sanskrit": "न श्रेयः सततं तेजो न नित्यं श्रेयसी क्षमा।\nइति तात विजानीहि द्वयमेतदसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018642, "chapter_id": 1390, "verse_number": "३-२८-७", "content_sanskrit": "यो नित्यं क्षमते तात बहून्दोषान्स विन्दति।\nभृत्याः परिभवन्त्येनमुदासीनास्तथाऽरयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018643, "chapter_id": 1390, "verse_number": "३-२८-८", "content_sanskrit": "सर्वभूतानि चाप्यस् न नमन्ते कदाचन।\nतस्मान्नित्यं क्षमा तात पण्डितैरपि वर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018644, "chapter_id": 1390, "verse_number": "३-२८-९", "content_sanskrit": "अवज्ञाय हितं भृत्या भजन्ते बहुदोषताम्।\nआदातुं चास्य वित्तानि प्रार्थयन्तेऽल्पचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018645, "chapter_id": 1390, "verse_number": "३-२८-१०", "content_sanskrit": "यानं वस्त्राण्यलंकाराञ्शयनान्यासनानि च।\nभोजनान्यथ पानानि सर्वोपकरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018646, "chapter_id": 1390, "verse_number": "३-२८-११", "content_sanskrit": "आददीरन्नधिकृता यथाकाममचेतसः।\nप्रदिष्टानि च देयानि न दद्युर्भर्तृशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018647, "chapter_id": 1390, "verse_number": "३-२८-१२", "content_sanskrit": "न चैनं भर्तृपूजाभिः पूजयन्ति कदाचन।\nअव्रज्ञानं हि लोकेऽस्मिन्मरणादपि गर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018648, "chapter_id": 1390, "verse_number": "३-२८-१३", "content_sanskrit": "क्षमिणं तादृशं तांत ब्रुवन्ति कटुकान्यपि।\nप्रेष्याः पुत्राश्च भृत्याश्च तथोदासीनवृत्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018649, "chapter_id": 1390, "verse_number": "३-२८-१४", "content_sanskrit": "अप्यस्य दारानिच्छन्ति परिभूय क्षमावतः।\nदाराश्चास्य प्रवर्तन्ते यथाकाममचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018650, "chapter_id": 1390, "verse_number": "३-२८-१५", "content_sanskrit": "तथा च नित्यमुदिता यदि नाल्पमपीश्वरात्।\n`अकृतोपद्रवः कश्चिन्महानपि न पूज्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018651, "chapter_id": 1390, "verse_number": "३-२८-१६", "content_sanskrit": "पूजयन्ति नरा नागान्न तार्क्ष्यं नामघातिनम् ॥\nएते चान्ये च बहवो नित्यं दोषाः क्षमावताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018652, "chapter_id": 1390, "verse_number": "३-२८-१७", "content_sanskrit": "अथ वैरोचने दोषानिमान्विद्ध्यक्षमांवताम् ॥\nअथ वैरोचने दोषानिमान्विद्ध्यक्षमावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018653, "chapter_id": 1390, "verse_number": "३-२८-१८", "content_sanskrit": "अस्थाने यदि वा स्थाने सततं रजसावृतः।\nक्रुद्धो दण्डान्प्रणयति विविधान्स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018654, "chapter_id": 1390, "verse_number": "३-२८-१९", "content_sanskrit": "मित्रैः सह विरोधं च प्राप्नुते तेजसाऽऽवृतः।\nआप्नोति द्वेष्यतां चैव लोकात्स्वजनतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018655, "chapter_id": 1390, "verse_number": "३-२८-२०", "content_sanskrit": "सोऽवमानादर्थहानिमुपालम्भमनादरम्।\nसंतापद्वेषमोहांश्च शत्रूंश्च लभते नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018656, "chapter_id": 1390, "verse_number": "३-२८-२१", "content_sanskrit": "क्रोधाद्दण्डान्मनुष्येषु विविधान्पुरुषोऽनयात्।\nभ्रश्यते शीघ्रमैश्वर्यात्प्राणेभ्यः स्वजनादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018657, "chapter_id": 1390, "verse_number": "३-२८-२२", "content_sanskrit": "योपकर्तॄश्च हर्तॄश्च तेजसैवोपगच्छति।\nतस्मादुद्विजते लोकः सर्पाद्वेश्मगतादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018658, "chapter_id": 1390, "verse_number": "३-२८-२३", "content_sanskrit": "यस्मादुद्विजतेलोकः कथं तस्य भवो भवेत्।\nअन्तरं तस्य दृष्ट्वैव लोको विकुरुते ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018659, "chapter_id": 1390, "verse_number": "३-२८-२४", "content_sanskrit": "तस्मान्नात्युत्सृजेत्तेजो न च नित्यं मृदुर्भवेत्।\nकालेकाले तु संप्राप्ते मृदुस्तीक्ष्णोपि वा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018660, "chapter_id": 1390, "verse_number": "३-२८-२५", "content_sanskrit": "काले मृदुर्यो भवति काले भवति दारुणः।\nस वै सुखमवाप्नोति लोकेऽमुष्मिन्निहैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018661, "chapter_id": 1390, "verse_number": "३-२८-२६", "content_sanskrit": "क्षमाकालांस्तु वक्ष्यामि शृणु मे विस्तरेण तान्।\nये ते नित्यमसंत्याज्या यथा प्राहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018662, "chapter_id": 1390, "verse_number": "३-२८-२७", "content_sanskrit": "पूर्वोपकारी यस्ते स्यादपराधे गरीयसि।\nउपकारेण तत्तस्य क्षन्तव्यमपराधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018663, "chapter_id": 1390, "verse_number": "३-२८-२८", "content_sanskrit": "अबुद्धिमाश्रितानां तु क्षन्तव्यमपराधिनाम्।\nन हि सर्वत्र पाण्डित्वं सुलभं पुरुषेण वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018664, "chapter_id": 1390, "verse_number": "३-२८-२९", "content_sanskrit": "अथ चेद्बुद्धिजं कृत्वा ब्रूयुस्ते तदबुद्धिजम्।\nपापान्स्वल्पेऽपि तान्हन्यादपराधे तथाऽनृजून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018665, "chapter_id": 1390, "verse_number": "३-२८-३०", "content_sanskrit": "सर्वस्यैकोपराधस्ते क्षन्तव्यः प्राणिनो भवेत्।\nद्वितीये सति वध्यस्तु स्वल्पेऽप्यपकृते भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018666, "chapter_id": 1390, "verse_number": "३-२८-३१", "content_sanskrit": "अजानता भवेत्कश्चिदपराधः कृतो यदि।\nक्षन्तव्यमेव तस्याहुः सुपरीक्ष्य परीक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018667, "chapter_id": 1390, "verse_number": "३-२८-३२", "content_sanskrit": "मृदुना दारुणं हन्ति मृदुना हन्त्यदारुणम्।\nनासाध्यं मृदुना किंचित्तस्मात्तीव्रतरं मृदु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018668, "chapter_id": 1390, "verse_number": "३-२८-३३", "content_sanskrit": "देशकालौ तु संप्रेक्ष्य बलाबलमथात्मनः।\nअन्वीक्ष्यकारणं चैव कार्यं तेजः क्षमापि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018669, "chapter_id": 1390, "verse_number": "३-२८-३४", "content_sanskrit": "नादेशकाले किंचित्स्याद्देशकालौ प्रतीक्षताम्।\nतथा लोकभयाच्चैव क्षन्तव्यमपराधितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018670, "chapter_id": 1390, "verse_number": "३-२८-३५", "content_sanskrit": "एत एवंविधाः कालाः क्षमायाः परिकीर्तिताः।\nअतोऽन्यथाऽनुवर्तत्सु तेजसः काल उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018671, "chapter_id": 1390, "verse_number": "३-२८-३६", "content_sanskrit": "तदहं तेजसः कालं तव मन्ये नराधिप।\nधार्तराष्ट्रेषु लुब्धेषु सततं चापकारिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018672, "chapter_id": 1390, "verse_number": "३-२८-३७", "content_sanskrit": "न हि कश्चित्क्षमाकालो विद्यतेऽद्य कुरून्प्रति।\nतेजसश्चागते काले तेज उत्स्रष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018673, "chapter_id": 1390, "verse_number": "३-२८-३८", "content_sanskrit": "मृदुर्भवत्यवज्ञातस्तीक्ष्णादुद्विजते जनः।\nकाले प्राप्ते द्वयं चैतद्यो वेद स महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018674, "chapter_id": 1390, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि अष्टाविंशोऽध्यायः ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]