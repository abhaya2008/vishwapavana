[{"id": 2173288, "chapter_id": 4689, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173289, "chapter_id": 4689, "verse_number": "१", "content_sanskrit": "ततः सेना तव विभो मद्रराजपुरस्कृता ।\nपुनरभ्यद्रवत् पार्थान् वेगेन महता रणे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173290, "chapter_id": 4689, "verse_number": "२", "content_sanskrit": "पीडितास्तावकाः सर्वे प्रधावन्तो रणोत्कटाः ।\nक्षणेन चैव पार्थास्ते बहुत्वात् समलोलयन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173291, "chapter_id": 4689, "verse_number": "३", "content_sanskrit": "तैर्वध्यमानाः कुरुभिः पाण्डवानावतस्थिरे ।\nनिवार्यमाणा भीमेन पश्यतोः कृष्णपार्थयोः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173292, "chapter_id": 4689, "verse_number": "४", "content_sanskrit": "क्षणेनैव हि ते राजन् समदृश्यन्त विद्रुताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173293, "chapter_id": 4689, "verse_number": "५", "content_sanskrit": "ततो धनञ्जयः क्रुद्धः कृपं सह पदानुगैः ।\nअवारयच्छरौघेण कृतवर्माणमेव च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173294, "chapter_id": 4689, "verse_number": "६", "content_sanskrit": "शकुनिं सहदेवश्च सहसैन्यमवारयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173295, "chapter_id": 4689, "verse_number": "७", "content_sanskrit": "नकुलः पार्श्वतः स्थित्वा मद्रराजमयोधयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173296, "chapter_id": 4689, "verse_number": "८", "content_sanskrit": "द्रौपदेया नरेन्द्रांश्च भूयिष्ठान् समवारयन् ।\nद्रोणपुत्रं च पाञ्चाल्यः शिखण्डी समवारयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173297, "chapter_id": 4689, "verse_number": "९", "content_sanskrit": "भीमसेनस्तु राजानं गदापाणिरवारयत् ।\nशल्यं तु सह सैन्येन कुन्तीपुत्रो युधिष्ठिरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173298, "chapter_id": 4689, "verse_number": "१०", "content_sanskrit": "ततः समभवद् युद्धं संसक्तं तत्र तत्र ह ।\nतावकानां परेषां च सङ्ग्रामेष्वनिवर्तिनाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173299, "chapter_id": 4689, "verse_number": "११", "content_sanskrit": "तत्र पश्यामहे कर्म शल्यस्यातिमहद्रणे ।\nयदेकः सर्वसैन्यानि पाण्डवानामयुध्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173300, "chapter_id": 4689, "verse_number": "१२", "content_sanskrit": "व्यदृश्यत तदा शल्यो युधिष्ठिरसमीपतः ।\nक्रूरश्चन्द्रमसोऽभ्याशे शनैश्चर इव ग्रहः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173301, "chapter_id": 4689, "verse_number": "१३", "content_sanskrit": "पीडयित्वा तु राजानं शरैराशीविषोपमैः ।\nअभ्यधावत् पुनर्भीमं शरवर्षैरवाकिरत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173302, "chapter_id": 4689, "verse_number": "१४", "content_sanskrit": "तस्य तल्लाघवं दृष्ट्वा तथैव च कृतास्त्रताम् ।\nअपूजयन्ननीकानि परेषां तावकानि च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173303, "chapter_id": 4689, "verse_number": "१५", "content_sanskrit": "पीड्यमानास्तु शल्येन पाण्डवा भृशविक्षताः ।\nप्राद्रवन्त रणं हित्वा क्रोशमाने युधिष्ठिरे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173304, "chapter_id": 4689, "verse_number": "१६", "content_sanskrit": "वध्यमानेष्वनीकेषु मद्रराजेन पाण्डवः ।\nअमर्षवशमापन्नो धर्मराजो युधिष्ठिरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173305, "chapter_id": 4689, "verse_number": "१७", "content_sanskrit": "ततः पौरुषमास्थाय मद्रराजमपीडयत् ।\nजयो वाऽस्तु वधो वेति कृतबुद्धिर्महारथः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173306, "chapter_id": 4689, "verse_number": "१८", "content_sanskrit": "समाहूयाब्रवीत् सर्वान् भ्रातॄन् कृष्णं च पाण्डवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173307, "chapter_id": 4689, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173308, "chapter_id": 4689, "verse_number": "१९", "content_sanskrit": "भीष्मो द्रोणश्च कर्णश्च ये चान्ये पृथिवीक्षितः ।\nकौरवार्थे पराक्रान्ताः सङ्ग्रामे निधनं गताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173309, "chapter_id": 4689, "verse_number": "२०", "content_sanskrit": "यथाभागं यथोत्साहं भवन्तः कृतपौरुषाः ।\nभागोऽवशिष्ट एवायं मम शल्यो महारथः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173310, "chapter_id": 4689, "verse_number": "२१", "content_sanskrit": "सोऽहमद्य युधा जेतुम् आशंसे मद्रकेश्वरम् ।\nअत्र यन्मानसं सर्वं तद्धितं निगदामि वः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173311, "chapter_id": 4689, "verse_number": "२२", "content_sanskrit": "चक्ररक्षाविमौ शूरौ मम माद्रवतीसुतौ ।\nअजय्यौ वासवेनापि समरे वीरसम्मतौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173312, "chapter_id": 4689, "verse_number": "२३", "content_sanskrit": "साध्विमौ मातुलं युद्धे क्षत्रधर्मपुरस्कृतौ ।\nमदर्थे प्रतियुध्येतां मानार्हौ सत्यसङ्गरौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173313, "chapter_id": 4689, "verse_number": "२४", "content_sanskrit": "मां वा शल्यो रणे हन्ता तं वाऽहं भद्रमस्तु वः ।\nइति सत्यामिमां वाचं लोकवीरा निबोधत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173314, "chapter_id": 4689, "verse_number": "२५", "content_sanskrit": "योत्स्येऽहं मातुलेनाद्य क्षत्रधर्मेण पार्थिवाः ।\nस्वमंशमभिसन्धाय विजयायेतराय च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173315, "chapter_id": 4689, "verse_number": "२६", "content_sanskrit": "तस्य ह्यभ्यधिकं शस्त्रं सर्वोपकरणानि च ।\nसंयुज्यन्तां रथे क्षिप्रं शास्त्रवद् रथयोजकैः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173316, "chapter_id": 4689, "verse_number": "२७", "content_sanskrit": "शैनेयो दक्षिणं पक्षं धृष्टद्युम्नस्तथोत्तरम् ।\nपृष्ठगोपो भवत्वद्य मम पार्थो धनञ्जयः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173317, "chapter_id": 4689, "verse_number": "२८", "content_sanskrit": "पुरस्सरो ममाद्यास्तु भीमः शस्त्रभृतां वरः ।\nएवमभ्यधिकः शल्याद् भविष्यामि महामृधे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173318, "chapter_id": 4689, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173319, "chapter_id": 4689, "verse_number": "२९", "content_sanskrit": "एवमुक्तास्तथा चक्रुः ततो राज्ञः प्रियैषिणः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173320, "chapter_id": 4689, "verse_number": "३०", "content_sanskrit": "ततः प्रहर्षः सैन्यानां पुनरासीत् तदा नृप ।\nपाञ्चालानां सोमकानां मत्स्यानां च महात्मनाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173321, "chapter_id": 4689, "verse_number": "३१", "content_sanskrit": "प्रतिज्ञातं च सङ्ग्रामे धर्मराजस्य पूजयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173322, "chapter_id": 4689, "verse_number": "३२", "content_sanskrit": "ततः शङ्खांश्च भेरीश्च शतशश्चैव पुष्करान् ।\nअवादयन्त पाञ्चालाः सिंहनादांश्च नेदिरे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173323, "chapter_id": 4689, "verse_number": "३३", "content_sanskrit": "तेऽभ्यधावंश्च संरब्धा मद्रराजं तरस्विनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173324, "chapter_id": 4689, "verse_number": "३४", "content_sanskrit": "महता हर्षजेनाथ नादेन कुरुनन्दन ।\nह्रादेन गजघण्टानां शङ्खानां निनदेन च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173325, "chapter_id": 4689, "verse_number": "३५", "content_sanskrit": "तूर्यशब्देन महता नादयन्तश्च मेदिनीम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173326, "chapter_id": 4689, "verse_number": "३६", "content_sanskrit": "तान् प्रत्यगृह्णात् पुत्रस्ते मद्रराजश्च वीर्यवान् ।\nमहामेघानिव बहून् शैलौ द्वौ तोयदागमे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173327, "chapter_id": 4689, "verse_number": "३७", "content_sanskrit": "शल्यस्तु समरश्लाघी धर्मराजमरिन्दमम् ।\nववर्ष शरवर्षेण मघवानिव पर्वतम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173328, "chapter_id": 4689, "verse_number": "३८", "content_sanskrit": "तथैव कुरुराजोऽपि प्रगृह्य रुचिरं धनुः ।\nद्रोणोपदेशान् विविधान् दर्शयानो महामनाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173329, "chapter_id": 4689, "verse_number": "३९", "content_sanskrit": "ववर्ष शरवर्षाणि चित्रं लघु च सुष्ठु च\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173330, "chapter_id": 4689, "verse_number": "४०", "content_sanskrit": "न चास्य विवरं कश्चिद् ददर्श चरतो रणे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173331, "chapter_id": 4689, "verse_number": "४१", "content_sanskrit": "तावुभौ विविधैर्बाणैः ततक्षाते परस्परम् ।\nशार्दूलावामिषप्रेप्सू पराक्रान्ताविवाहवे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173332, "chapter_id": 4689, "verse_number": "४२", "content_sanskrit": "भीमस्तु रणशौण्डेन तव पुत्रेण सङ्गतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173333, "chapter_id": 4689, "verse_number": "४३", "content_sanskrit": "पाञ्चाल्यः सात्यकिश्चैव तथा माद्रीसुतावुभौ ।\nशकुनिप्रमुखान् वीरान् प्रत्यगृह्णन् समन्ततः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173334, "chapter_id": 4689, "verse_number": "४४", "content_sanskrit": "तदाऽऽसीत् तुमुलं युद्धं पुनरेव जयैषिणाम् ।\nतावकानां परेषां च राजन् दुर्मन्त्रिते तव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173335, "chapter_id": 4689, "verse_number": "४५", "content_sanskrit": "दुर्योधनस्तु भीमस्य शरेणानतपर्वणा ।\nचिच्छेदोद्दिश्य सङ्ग्रामे ध्वजं हेमविभूषितम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173336, "chapter_id": 4689, "verse_number": "४६", "content_sanskrit": "सकिङ्किणीकजालेन महता चारुदर्शनः ।\nपपात रुचिरः सिंहो भीमसेनस्य पश्यतः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173337, "chapter_id": 4689, "verse_number": "४७", "content_sanskrit": "पुनश्चास्य धनुश्चित्रं गजराजकरोपमम् ।\nक्षुरेण शितधारेण प्रचकर्त नराधिपः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173338, "chapter_id": 4689, "verse_number": "४८", "content_sanskrit": "सञ्छिन्नधन्वा तेजस्वी रथशक्त्या सुतं तव ।\nबिभेदोरसि विक्रम्य रथोपस्थ उपाविशत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173339, "chapter_id": 4689, "verse_number": "४९", "content_sanskrit": "तस्मिन् मोहमनुप्राप्ते पुनरेव वृकोदरः ।\nयन्तुरेव शिरः कायात् क्षुरप्रेणाहरत् तदा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173340, "chapter_id": 4689, "verse_number": "५०", "content_sanskrit": "हतसूता हयास्तस्य रथमादाय भारत ।\nव्यद्रवन्त दिशो राजन् हाहाकारस्ततोऽभवत्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173341, "chapter_id": 4689, "verse_number": "५१", "content_sanskrit": "तमभ्यधावंस्त्राणार्थं द्रोणपुत्रो महारथः ।\nकृपश्च कृतवर्मा च पुत्रं तेऽभिपरीप्सवः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173342, "chapter_id": 4689, "verse_number": "५२", "content_sanskrit": "तस्मिन् विलुलिते सैन्ये त्रस्तास्तस्य पदानुगाः ।\nगाण्डीवधन्वा विष्फार्य धनुस्तानहनच्छरैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173343, "chapter_id": 4689, "verse_number": "५३", "content_sanskrit": "युधिष्ठिरस्तु मद्रेशमभ्यधावदमर्षितः ।\nस्वयं सञ्चोदयन्नश्वान् दन्तवर्णान् मनोजवान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173344, "chapter_id": 4689, "verse_number": "५४", "content_sanskrit": "तत्राद्भुतमपश्याम कुन्तीपुत्रो युधिष्ठिरः ।\nपुरा भूत्वा मृदुर्दान्तो यत् तदा दारुणोऽभवत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173345, "chapter_id": 4689, "verse_number": "५५", "content_sanskrit": "विवृताक्षस्तु कौन्तेयो दीप्यमानस्तु मन्युना ।\nचिच्छेद योधान् निशितैः शरैः शतसहस्रशः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2173346, "chapter_id": 4689, "verse_number": "५६", "content_sanskrit": "यां यां प्रत्युद्ययौ सेनां तां तां ज्येष्ठस्तु पाण्डवः ।\nशरैरपातयद् राजन् गिरीन् वज्रैरिवोत्तमैः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2173347, "chapter_id": 4689, "verse_number": "५७", "content_sanskrit": "साश्वसूतध्वजवरान् रथिनोऽपातयद् बहून् ।\nआक्रीडदेको बलवान् पवनस्तोयदैरिव\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2173348, "chapter_id": 4689, "verse_number": "५८", "content_sanskrit": "साश्वारोहांश्च तुरगान् पत्तीन् नैकसहस्रशः ।\nव्यपोथयत सङ्ग्रामे क्रुद्धो रुद्रः पशूनिव\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2173349, "chapter_id": 4689, "verse_number": "५९", "content_sanskrit": "शून्यमायोधनं कृत्वा शरवर्षैः समन्ततः ।\nअभ्यधावत मद्रेशं तिष्ठ तिष्ठेति चाब्रवीत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2173350, "chapter_id": 4689, "verse_number": "६०", "content_sanskrit": "तस्य तच्चरितं दृष्ट्वा सङ्ग्रामे भीमकर्मणः ।\nवित्रेसुस्तावकाः सर्वे शल्यस्त्वेनं समभ्ययात्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2173351, "chapter_id": 4689, "verse_number": "६१", "content_sanskrit": "ततस्तु तौ सुसंरब्धौ प्रध्माप्य सलिलोद्भवौ ।\nसमाहूय तदाऽन्योन्यं भर्त्सयन्तौ समीयतुः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2173352, "chapter_id": 4689, "verse_number": "६२", "content_sanskrit": "शल्यस्तु शरवर्षेण युधिष्ठिरमपीडयत् ।\nमद्रराजं च कौन्तेयः शरवर्षैरवाकिरत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2173353, "chapter_id": 4689, "verse_number": "६३", "content_sanskrit": "व्यदृश्येतां तदा राजन् कङ्कपत्रिभिराहवे ।\nउद्भिन्नरुधिरौ तत्र मद्रराजयुधिष्ठिरौ\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2173354, "chapter_id": 4689, "verse_number": "६४", "content_sanskrit": "पुष्पिताविव राजन्तौ वने शाल्मलिकिंशुकौ ।\nदीप्यमानौ महात्मानौ प्राणद्यूतेषु दुर्मदौ\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2173355, "chapter_id": 4689, "verse_number": "६५", "content_sanskrit": "दृष्ट्वा सैन्यानि सर्वाणि नाध्यवस्यंस्तयोर्जयम् ।\nहत्वा मद्राधिपं पार्थो भोक्ष्यतेऽद्य वसुन्धराम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2173356, "chapter_id": 4689, "verse_number": "६६", "content_sanskrit": "शल्यो वा पाण्डवं हत्वा दद्याद् दुर्योधनाय गाम् ।\nइति वा निश्चयो नाभूद् योधानां तत्र भारत\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2173357, "chapter_id": 4689, "verse_number": "६७", "content_sanskrit": "प्रदक्षिणमभूत् सर्वं धर्मराजस्य युध्यतः ।\nततः शरशतं शल्यो मुमोचाशु युधिष्ठिरे\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2173358, "chapter_id": 4689, "verse_number": "६८", "content_sanskrit": "धनुश्चास्य शिताग्रेण बाणेन निरकृन्तत\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2173359, "chapter_id": 4689, "verse_number": "६९", "content_sanskrit": "सोऽन्यत् कार्मुकमादाय शल्यं शरशतैस्त्रिभिः ।\nअविध्यत् कार्मुकं तस्य क्षुरप्रेण न्यकृन्तत\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2173360, "chapter_id": 4689, "verse_number": "७०", "content_sanskrit": "अथास्य निजघानाश्वान् चतुरो नतपर्वभिः ।\nद्वाभ्यामथ शिताग्राभ्यामुभौ वै पार्ष्णिसारथी\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2173361, "chapter_id": 4689, "verse_number": "७१", "content_sanskrit": "ततोऽस्य दीप्यमानेन पीतेन निशितेन च ।\nप्रमुखे वर्तमानस्य भल्लेनापाहरद् ध्वजम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2173362, "chapter_id": 4689, "verse_number": "७२", "content_sanskrit": "ततः प्रभग्नं तत्सैन्यं धार्तराष्ट्रमरिन्दम\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2173363, "chapter_id": 4689, "verse_number": "७३", "content_sanskrit": "ततो मद्राधिपं द्रौणिरभ्यधावत् तथा कृतम् ।\nआरोप्य चैनं स्वरथं त्वरमाणः प्रदुद्रुवे\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2173364, "chapter_id": 4689, "verse_number": "७४", "content_sanskrit": "मुहूर्तमिव तान् हत्वा नर्दमाने युधिष्ठिरे ।\nस्थित्वा ततो मद्रपतिरन्यं स्यन्दनमास्थितः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2173365, "chapter_id": 4689, "verse_number": "७५", "content_sanskrit": "विधिवत् कल्पितं शुभ्रं महाम्बुदनिनादिनम् ।\nन्यस्तयन्त्रोपकरणं द्विषतां रोमहर्षणम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2173366, "chapter_id": 4689, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2173367, "chapter_id": 4689, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि षोडशोऽध्यायः ॥१६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]