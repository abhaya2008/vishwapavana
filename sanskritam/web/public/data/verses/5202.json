[{"id": 2197622, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197623, "chapter_id": 5202, "verse_number": "१", "content_sanskrit": "किमाहुर्भरतश्रेष्ठ पात्रं विप्राः सनातनम् ।\nब्राह्मणं लिङ्गिनं चैव ब्राह्मणं वाप्यलिङ्गिनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197624, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197625, "chapter_id": 5202, "verse_number": "२", "content_sanskrit": "स्ववृत्तिमभिपन्नाय लिङ्गिने वेतराय वा ।\nदेयमाहुर्महाराज उभावेतौ तपस्विनौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197626, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197627, "chapter_id": 5202, "verse_number": "३", "content_sanskrit": "श्रद्धया परया पूतो यः प्रयच्छेद् द्विजातये ।\nहव्यं कव्यं तथा दानं को दोषः स्यात् पितामह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197628, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197629, "chapter_id": 5202, "verse_number": "४", "content_sanskrit": "श्रद्धापूतो नरस्तात दुर्दान्तोऽपि न संशयः ।\nपूतो भवति सर्वत्र किं पुनस्त्वं महीपते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197630, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197631, "chapter_id": 5202, "verse_number": "५", "content_sanskrit": "न ब्राह्मणं परीक्षेत दैवेषु सततं नरः ।\nकव्यप्रदाने तु बुधाः परीक्ष्यं ब्राह्मणं विदुः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197632, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197633, "chapter_id": 5202, "verse_number": "६", "content_sanskrit": "न ब्राह्मणः साधयते हव्यं दैवात् प्रसिध्यति ।\nदेवप्रसादादिज्यन्ते यजमाना न संशयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197634, "chapter_id": 5202, "verse_number": "७", "content_sanskrit": "ब्राह्मणा भरतश्रेष्ठ सततं ब्रह्मवादिनः ।\nमार्कण्डेयः पुरा प्राह इह लोकेषु बुद्धिमान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197635, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197636, "chapter_id": 5202, "verse_number": "८", "content_sanskrit": "अपूर्वोऽप्यथ वा विद्वान् सम्बन्धी वाऽथ यो भवेत् ।\nतपस्वी यज्ञशीलो वा कथं पात्रं भवेत् तु सः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197637, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197638, "chapter_id": 5202, "verse_number": "९", "content_sanskrit": "कुलीनः कर्मकृद् वैद्यस्तथा चाप्यानृशंस्यवान् ।\nह्रीमानृजुः सत्यवादी पात्रं पूर्वे च ते त्रयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197639, "chapter_id": 5202, "verse_number": "१०", "content_sanskrit": "तत्रेदं शृणु मे पार्थ चतुर्णां तेजसां मतम् ।\nपृथिव्याः काश्यपस्याग्नेर्मार्कण्डेयस्य चैव हि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197640, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "पृथिवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197641, "chapter_id": 5202, "verse_number": "११", "content_sanskrit": "यथा महार्णवे क्षिप्तः क्षिप्रं नेष्टुः विनश्यति ।\nतथा दुश्चरितं सर्वं त्रय्यावृत्त्या विनश्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197642, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197643, "chapter_id": 5202, "verse_number": "१२", "content_sanskrit": "सर्वे च वेदाः सह षड्भिरङ्गैः\nसाङ्ख्यं पुराणं च कुले च जन्म ।\nनैतानि सर्वाणि गतिर्भवन्ति\nशीलव्यपेतस्य नृप द्विजस्य \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197644, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197645, "chapter_id": 5202, "verse_number": "१३", "content_sanskrit": "अधीयानः पण्डितम्मन्यमानो\nयो विद्यया हन्ति यशः परेषाम् ।\nब्रह्मन् स तेनाचरते ब्रह्मवध्यां\nलोकास्तस्य ह्यन्तवन्तो भवन्ति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197646, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197647, "chapter_id": 5202, "verse_number": "१४", "content_sanskrit": "अश्वमेधसहस्रं च सत्यं च तुलया धृतम् ।\nनाभिजानामि यज्ञं तु सत्यस्यार्धमवाप्नुयात्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197648, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197649, "chapter_id": 5202, "verse_number": "१५", "content_sanskrit": "इत्युक्त्वा ते जग्मुराशु चत्वारोऽमिततेजसः ।\nपृथिवी काश्यपोऽग्निश्च प्रकृष्टायुश्च भार्गवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197650, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197651, "chapter_id": 5202, "verse_number": "१६", "content_sanskrit": "यदि ते ब्राह्मणा लोके व्रतिनो भुञ्जते हविः ।\nदत्तं ब्राह्मणकामाय कथं तत् सुकृतं भवेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197652, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197653, "chapter_id": 5202, "verse_number": "१७", "content_sanskrit": "आदिष्टिनो ये राजेन्द्र ब्राह्मणा वेदपारगाः ।\nभुञ्जते ब्रह्मकामाय व्रतलुप्ता भवन्ति ते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2197654, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2197655, "chapter_id": 5202, "verse_number": "१८", "content_sanskrit": "अनेकान्तं बहुद्वारं धर्ममाहुर्मनीषिणः ।\nकिं निमित्तं भवेत् तत्र तन्मे ब्रूहि पितामह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2197656, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2197657, "chapter_id": 5202, "verse_number": "१९", "content_sanskrit": "अहिंसा सत्यमक्रोध आनृशंस्यं दमस्तथा ।\nआर्जवं चैव राजेन्द्र निश्चितं धर्मलक्षणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2197658, "chapter_id": 5202, "verse_number": "२०", "content_sanskrit": "ये तु धर्मं प्रशंसन्तश्चरन्ति पृथिवीमिमाम् ।\nअनाचरन्तस्तद्धर्मं सङ्करे निरताः प्रभो\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2197659, "chapter_id": 5202, "verse_number": "२१", "content_sanskrit": "तेभ्यो रत्नं हिरण्यं वा गामश्वान् वा ददाति यः ।\nदश वर्षाणि विष्ठां स भुङ्क्ते निरयमाश्रितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2197660, "chapter_id": 5202, "verse_number": "२२", "content_sanskrit": "धनेन पुल्कसानां च तथैवान्तावसायिनाम् ।\nकृतं कर्माकृतं चापि रागमोहेन जल्पताम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2197661, "chapter_id": 5202, "verse_number": "२३", "content_sanskrit": "वैश्वदेवं च ये मूढा विप्राय ब्रह्मचारिणे ।\nददतीह न राजेन्द्र ते लोकान् भुञ्जतेऽशुभान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2197662, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2197663, "chapter_id": 5202, "verse_number": "२४", "content_sanskrit": "किं परं ब्रह्मचर्यस्य किं परं धर्मलक्षणम् ।\nकिं च श्रेष्ठतमं शौचं तन्मे ब्रूहि पितामह\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2197664, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2197665, "chapter_id": 5202, "verse_number": "२५", "content_sanskrit": "ब्रह्मचर्यं परं तात मधुमांसस्य वर्जनम् ।\nमर्यादायां स्थितो धर्मः शमः शौचस्य लक्षणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2197666, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2197667, "chapter_id": 5202, "verse_number": "२६", "content_sanskrit": "कस्मिन्काले चरेद् धर्मं कस्मिन्कालेऽर्थमाचरेत् ।\nकस्मिन्काले सुखी च स्यात्तन्मे ब्रूहि पितामह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2197668, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2197669, "chapter_id": 5202, "verse_number": "२७", "content_sanskrit": "काल्यमर्थं निषेवेत ततो धर्ममनन्तरम् ।\nपश्चात् कामं निषेवेत न च गच्छेत् प्रसङ्गिताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2197670, "chapter_id": 5202, "verse_number": "२८", "content_sanskrit": "ब्राह्मणांश्चाभिमन्येत गुरूंश्चाप्यभिपूजयेत् ।\nसर्वभूतानुलोमश्च मृदुशीलः प्रियंवदः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2197671, "chapter_id": 5202, "verse_number": "२९", "content_sanskrit": "अधिकारे यदनृतं  यच्च राजसु पैशुनम् ।\nगुरोश्चालीकनिर्बन्धः समं तद् ब्रह्महत्यया\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2197672, "chapter_id": 5202, "verse_number": "३०", "content_sanskrit": "प्रहरेन्न नरेन्द्रेषु न गां हन्यात् तथैव च ।\nभ्रूणहत्यासमं चैतदुभयं यो निषेवते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2197673, "chapter_id": 5202, "verse_number": "३१", "content_sanskrit": "नाग्निं परित्यजेज्जातु न च वेदान् परित्यजेत् ।\nन च ब्राह्मणमाक्रोशेत् समं तद् ब्रह्महत्यया\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2197674, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2197675, "chapter_id": 5202, "verse_number": "३२", "content_sanskrit": "कीदृशाः साधवो विप्राः केभ्यो दत्तं महाफलम् ।\nकीदृशानां च भोक्तव्यं तन्मे ब्रूहि पितामह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2197676, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2197677, "chapter_id": 5202, "verse_number": "३३", "content_sanskrit": "अक्रोधना धर्मपराः सत्यनित्या दमे रताः ।\nतादृशाः साधवो विप्रास्तेभ्यो दत्तं महाफलम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2197678, "chapter_id": 5202, "verse_number": "३४", "content_sanskrit": "अमानिनः सर्वसहा दृष्टार्था विजितेन्द्रियाः ।\nसर्वभूतहिता मैत्रास्तेभ्यो दत्तं महाफलम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2197679, "chapter_id": 5202, "verse_number": "३५", "content_sanskrit": "अलुब्धाः शुचयो वैद्या ह्रीमन्तः सत्यवादिनः ।\nस्वकर्मनिरता ये च तेभ्यो दत्तं महाफलम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2197680, "chapter_id": 5202, "verse_number": "३६", "content_sanskrit": "साङ्गांश्च चतुरो वेदान् योऽधीयीत द्विजर्षभः ।\nषड्भ्यो प्रवृत्तः कर्मभ्यस्तं पात्रमृषयो विदुः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2197681, "chapter_id": 5202, "verse_number": "३७", "content_sanskrit": "ये त्वेवङ्गुणजातीयास्तेभ्यो दत्तं महाफलम् ।\nसहस्रगुणमाप्नोति गुणार्हाय प्रदायकः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2197682, "chapter_id": 5202, "verse_number": "३८", "content_sanskrit": "प्रज्ञाश्रुताभ्यां वृत्तेन शीलेन च समन्वितः ।\nतारयेत कुलं कृत्स्नमेकोऽपीह द्विजर्षभः ।\nतृप्ते तृप्ताः सर्वदेवाः पितरो मुनयोऽपि च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2197683, "chapter_id": 5202, "verse_number": "३९", "content_sanskrit": "गामश्वं वित्तमन्नं वा तद्विधे प्रतिपादयेत् ।\nद्रव्याणि चान्यानि तथा प्रेत्यभावे न शोचति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2197684, "chapter_id": 5202, "verse_number": "४०", "content_sanskrit": "तारयेत कुलं कृत्स्नमेकोऽपीह द्विजोत्तमः ।\nकिमङ्ग पुनरेवैते तस्मात् पात्रं समाचरेत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2197685, "chapter_id": 5202, "verse_number": "४१", "content_sanskrit": "निशम्य च गुणोपेतं ब्राह्मणं साधुसम्मतम् ।\nदूरादानाययेत् कृत्ये सर्वतश्चाभिपूजयेत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2197686, "chapter_id": 5202, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे बहुप्रश्निको नाम त्रिपञ्चाशोऽध्यायः ॥५३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]