[{"id": 5000475000, "chapter_id": 9475, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000475001, "chapter_id": 9475, "verse_number": "६-६८-१", "content_sanskrit": "कुम्भकर्णं हतं दृष्ट्वा राघवेण महात्मना।\nराक्षसा राक्षसेन्द्राय रावणाय न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000475002, "chapter_id": 9475, "verse_number": "६-६८-२", "content_sanskrit": "राजन् स कालसंकाशः संयुक्तः कालकर्मणा।\nविद्राव्य वानरीं सेनां भक्षयित्वा च वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000475003, "chapter_id": 9475, "verse_number": "६-६८-३", "content_sanskrit": "प्रतपित्वा मुहूर्तं तु प्रशान्तो रामतेजसा।\nकायेनार्धप्रविष्टेन समुद्रं भीमदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000475004, "chapter_id": 9475, "verse_number": "६-६८-४", "content_sanskrit": "निकृत्तनासाकर्णेन विक्षरद्रुधिरेण च।\nरुद्‍ध्वा द्वारं शरीरेण लङ्कायाः पर्वतोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000475005, "chapter_id": 9475, "verse_number": "६-६८-५", "content_sanskrit": "कुम्भकर्णस्तव भ्राता काकुत्स्थशरपीडितः।\nअगण्डभूतो विवृतो दावदग्ध इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000475006, "chapter_id": 9475, "verse_number": "६-६८-६", "content_sanskrit": "श्रुत्वा विनिहतं संख्ये कुम्भकर्णं महाबलम्।\nरावणः शोकसंतप्तो मुमोह च पपात च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000475007, "chapter_id": 9475, "verse_number": "६-६८-७", "content_sanskrit": "पितृव्यं निहतं श्रुत्वा देवान्तकनरान्तकौ।\nत्रिशिराश्चातिकायश्च रुरुदुः शोकपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000475008, "chapter_id": 9475, "verse_number": "६-६८-८", "content_sanskrit": "भ्रातरं निहतं श्रुत्वा रामेणाक्लिष्टकर्मणा।\nमहोदरमहापार्श्वौ शोकाक्रान्तौ बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000475009, "chapter_id": 9475, "verse_number": "६-६८-९", "content_sanskrit": "ततः कृच्छ्रात् समासाद्य संज्ञां राक्षसपुङ्गवः।\nकुम्भकर्णवधाद् दीनो विललापाकुलेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000475010, "chapter_id": 9475, "verse_number": "६-६८-१०", "content_sanskrit": "हा वीर रिपुदर्पघ्न कुम्भकर्ण महाबल।\nत्वं मां विहाय वै दैवाद् यातोऽसि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000475011, "chapter_id": 9475, "verse_number": "६-६८-११", "content_sanskrit": "मम शल्यमनुद‍्धृत्य बान्धवानां महाबल।\nशत्रुसैन्यं प्रताप्यैकः क्व मां संत्यज्य गच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000475012, "chapter_id": 9475, "verse_number": "६-६८-१२", "content_sanskrit": "इदानीं खल्वहं नास्मि यस्य मे पतितो भुजः।\nदक्षिणोऽयं समाश्रित्य न बिभेमि सुरासुरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000475013, "chapter_id": 9475, "verse_number": "६-६८-१३", "content_sanskrit": "कथमेवंविधो वीरो देवदानवदर्पहा।\nकालाग्निप्रतिमो ह्यद्य राघवेण रणे हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000475014, "chapter_id": 9475, "verse_number": "६-६८-१४", "content_sanskrit": "यस्य ते वज्रनिष्पेषो न कुर्याद् व्यसनं सदा।\nस कथं रामबाणार्तः प्रसुप्तोऽसि महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000475015, "chapter_id": 9475, "verse_number": "६-६८-१५", "content_sanskrit": "एते देवगणाः सार्धमृषिभिर्गगने स्थिताः।\nनिहतं त्वां रणे दृष्ट्वा निनदन्ति प्रहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000475016, "chapter_id": 9475, "verse_number": "६-६८-१६", "content_sanskrit": "ध्रुवमद्यैव संहृष्टा लब्धलक्षाः प्लवंगमाः।\nआरोक्ष्यन्तीह दुर्गाणि लङ्काद्वाराणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000475017, "chapter_id": 9475, "verse_number": "६-६८-१७", "content_sanskrit": "राज्येन नास्ति मे कार्यं किं करिष्यामि सीतया।\nकुम्भकर्णविहीनस्य जीविते नास्ति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000475018, "chapter_id": 9475, "verse_number": "६-६८-१८", "content_sanskrit": "यद्यहं भ्रातृहन्तारं न हन्मि युधि राघवम्।\nननु मे मरणं श्रेयो न चेदं व्यर्थजीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000475019, "chapter_id": 9475, "verse_number": "६-६८-१९", "content_sanskrit": "अद्यैव तं गमिष्यामि देशं यत्रानुजो मम।\nनहि भ्रातॄन् समुत्सृज्य क्षणं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000475020, "chapter_id": 9475, "verse_number": "६-६८-२०", "content_sanskrit": "देवा हि मां हसिष्यन्ति दृष्ट्वा पूर्वापकारिणम्।\nकथमिन्द्रं जयिष्यामि कुम्भकर्ण हते त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000475021, "chapter_id": 9475, "verse_number": "६-६८-२१", "content_sanskrit": "तदिदं मामनुप्राप्तं विभीषणवचः शुभम्।\nयदज्ञानान्मया तस्य न गृहीतं महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000475022, "chapter_id": 9475, "verse_number": "६-६८-२२", "content_sanskrit": "विभीषणवचस्तावत् कुम्भकर्णप्रहस्तयोः।\nविनाशोऽयं समुत्पन्नो मां व्रीडयति दारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000475023, "chapter_id": 9475, "verse_number": "६-६८-२३", "content_sanskrit": "तस्यायं कर्मणः प्राप्तो विपाको मम शोकदः।\nयन्मया धार्मिकः श्रीमान् स निरस्तो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000475024, "chapter_id": 9475, "verse_number": "६-६८-२४", "content_sanskrit": "इति बहुविधमाकुलान्तरात्मा\nकृपणमतीव विलप्य कुम्भकर्णम्।\nन्यपतदपि दशाननो भृशार्त-\nस्तमनुजमिन्द्ररिपुं हतं विदित्वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000475025, "chapter_id": 9475, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]