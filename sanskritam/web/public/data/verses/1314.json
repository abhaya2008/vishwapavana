[{"id": 2015032, "chapter_id": 1314, "verse_number": "२-५५-१", "content_sanskrit": "भीष्ण उवाच॥\nशूरसेनपुरं त्यक्त्वा ततो यादवनन्दनः।\nद्वारकां भगवान्कृष्णः प्रत्यपद्यत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015033, "chapter_id": 1314, "verse_number": "२-५५-२", "content_sanskrit": "ततो महात्मा यानानि रत्नानि विविधानि च।\nयथार्हं पुण्डरीकाक्षो नैर्ऋतात्प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015034, "chapter_id": 1314, "verse_number": "२-५५-३", "content_sanskrit": "तत्र विघ्नं चरन्ति स्म दैतेयाः सहदानवैः।\nताञ्जघान महाबाहुर्वरमत्तान्महासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015035, "chapter_id": 1314, "verse_number": "२-५५-४", "content_sanskrit": "स विघ्नमकरोत्तत्र नरको नाम नैर्ऋतः।\nअदितिं धर्षयामास कुण्डलार्थं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015036, "chapter_id": 1314, "verse_number": "२-५५-५", "content_sanskrit": "न चासुरगणैः सर्वैः सहितैः कर्म तत्पुरा।\nकृतपूर्वं महाघोरं यदकार्षीन्महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015037, "chapter_id": 1314, "verse_number": "२-५५-६", "content_sanskrit": "यं मही सुषुवे देवी यस्य प्राग्ज्योतिषं पुरम्।\nविषयान्तपालाश्चत्वारो यस्यासन्युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015038, "chapter_id": 1314, "verse_number": "२-५५-७", "content_sanskrit": "आदेवयानमावृत्य पन्थानं पर्यवस्थिताः।\nत्रासनाः सुरसङ्घानां विरूपै राक्षसैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015039, "chapter_id": 1314, "verse_number": "२-५५-८", "content_sanskrit": "हयग्रीवो निकुम्भश्च घोरः पञ्चजनस्तदा।\nमुरः पुत्रसहस्रैश्च वरमत्तो महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015040, "chapter_id": 1314, "verse_number": "२-५५-९", "content_sanskrit": "तद्वधार्थं महाबाहुरेष चक्रगदासिभृत्।\nजातो वृष्णिषु देवक्यां वासुदेवो जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015041, "chapter_id": 1314, "verse_number": "२-५५-१०", "content_sanskrit": "तस्यास्य पुरुषेन्द्रस्यलोकप्रथिततेजसः।\nनिवासो द्वारकायां तु विदितो वः प्रधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015042, "chapter_id": 1314, "verse_number": "२-५५-११", "content_sanskrit": "अतीव हि पुरी रम्या द्वारका वासवक्षयात्।\nअतिवैराजमप्यद्धा प्रत्यक्षस्ते युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015043, "chapter_id": 1314, "verse_number": "२-५५-१२", "content_sanskrit": "तस्मिन्देवपुरप्रख्ये सा सभा वृष्ण्युपाश्रया।\nसुधर्मेति च विख्याता योजनायतविस्तृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015044, "chapter_id": 1314, "verse_number": "२-५५-१३", "content_sanskrit": "तत्र वृष्ण्यन्दकाः सर्वे रामकृष्णपुरोगमाः।\nलोकयात्रामिमां कृत्स्नां परिरक्षन्त आसते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015045, "chapter_id": 1314, "verse_number": "२-५५-१४", "content_sanskrit": "तत्रासीनेषु सर्वेषु कदाचिद्भरतर्षभ।\nदिव्यगन्धा ववुर्वाताः कुसुमानां च वृष्टयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015046, "chapter_id": 1314, "verse_number": "२-५५-१५", "content_sanskrit": "ततः सूर्यसहस्राभस्तेजोराशिर्महाद्भुतः।\nमध्ये तु तेजसस्तस्य पाण्डरं गजमास्थितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015047, "chapter_id": 1314, "verse_number": "२-५५-१६", "content_sanskrit": "वृतो देवगणैः सर्वैर्वासवः प्रत्यदृश्यत॥\nरामकृष्णौ च राजा च वृष्ण्यन्धकगणैः सह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015048, "chapter_id": 1314, "verse_number": "२-५५-१७", "content_sanskrit": "उत्पत्य सहसा देवे नमस्कारमकुर्वत॥\nसोऽवतीर्य गजात्तूर्णं परिष्वज्य जनार्दनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015049, "chapter_id": 1314, "verse_number": "२-५५-१८", "content_sanskrit": "सस्वजे बलदेवं च राजानं च तमाहुकम्॥\nवासुदेवोद्धवौ चैव विकद्रुं च महामतिम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015050, "chapter_id": 1314, "verse_number": "२-५५-१९", "content_sanskrit": "प्रद्युम्नसाम्बनिशठाननिरुद्धं च सात्यकिम्॥\nगदं सारणमक्रूरं भानुझल्लिविडूरथान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015051, "chapter_id": 1314, "verse_number": "२-५५-२०", "content_sanskrit": "तथैव कृतवर्णाणां चारुदेष्णं महाबलम्॥\nदेवकल्पान्महाराज तान्दाशार्हपुरोगमान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015052, "chapter_id": 1314, "verse_number": "२-५५-२१", "content_sanskrit": "पिरिष्वज्य च दृष्ट्वा च भगवान्भूतभावनः॥\nवृष्ण्यन्धकमहामात्रान्परिष्वज्याथ वासवः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015053, "chapter_id": 1314, "verse_number": "२-५५-२२", "content_sanskrit": "प्रगृह्य पूजां तैर्दत्तां भगवान्पाकशासनः॥\nसोऽदितेर्वचनात्तात कुण्डलार्थे जनार्दनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015054, "chapter_id": 1314, "verse_number": "२-५५-२३", "content_sanskrit": "उवाच परमप्रीतो जहि भौमं नरेश्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015055, "chapter_id": 1314, "verse_number": "२-५५-२३x", "content_sanskrit": "भीष्ण उवाच।\nनिहत्य नरकं भौममाहरिष्यामि कुण्डले।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015056, "chapter_id": 1314, "verse_number": "२-५५-२४", "content_sanskrit": "एवमुक्त्वाऽथ गोविन्दो राममेवाभ्यभाषत॥\nप्रद्युम्नमनिरुद्धं च साम्बं चाप्रतिमं बले।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015057, "chapter_id": 1314, "verse_number": "२-५५-२५", "content_sanskrit": "एतांश्चोच्त्का तथा तत्र वासुदेवो महायशाः॥\nअथारुह्य सुपर्णं वै शङ्खचक्रगदासिभृत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015058, "chapter_id": 1314, "verse_number": "२-५५-२६", "content_sanskrit": "ययौ तदा हृषीकेशो देवानां हितकाम्यया॥\nतं प्रयान्तममित्रघ्नं देवाः सहपुरन्दराः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015059, "chapter_id": 1314, "verse_number": "२-५५-२७", "content_sanskrit": "पृष्ठतोऽनुययुः प्रीत्या स्तुवन्तो विष्णुमच्युतम्।\nउग्रान्त्रक्षोगणान्हत्वा नरकस्य महासुरान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015060, "chapter_id": 1314, "verse_number": "२-५५-२८", "content_sanskrit": "क्षुरान्तान्मौरवान्पाशान्षट्सहस्रं ददर्श सः॥\nस़ञ्छिद्य पाशाच्छस्त्रेण मुरं हत्वा सहान्वयम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015061, "chapter_id": 1314, "verse_number": "२-५५-२९", "content_sanskrit": "शैलसङ्घानतिक्रम्य निशुम्भं च व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015062, "chapter_id": 1314, "verse_number": "२-५५-३०", "content_sanskrit": "यः सहस्रसहस्त्वेकः सर्वान्देवानपोथयत्।\nतं जघान महावीर्यं हयग्रीवं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015063, "chapter_id": 1314, "verse_number": "२-५५-३१", "content_sanskrit": "अपारतेजा दुर्धर्षः सर्वयादवनन्दनः॥\nमध्ये लोहितगङ्गायां भगवान्देवकीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015064, "chapter_id": 1314, "verse_number": "२-५५-३२", "content_sanskrit": "औदकायां विरूपाक्षं जघान मधुसूदनः।\nततः प्राग्ज्योतिषं नाम दीप्यमानमिव श्रिया।\nपुरमासादयामास तत्र युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015065, "chapter_id": 1314, "verse_number": "२-५५-३३", "content_sanskrit": "तद्युद्धमभवद्घोरं तेन भौमेन भारत।\nकुण्डलार्थे सुरेशस्य नरकेण महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015066, "chapter_id": 1314, "verse_number": "२-५५-३४", "content_sanskrit": "मुहूर्तं लालयित्वा तु नरकं मधूसूदनः।\nप्रवृत्तचक्रं चक्रेण प्रममाथ बलाद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015067, "chapter_id": 1314, "verse_number": "२-५५-३५", "content_sanskrit": "चक्रप्रमथितं तस्य पपात सहसा भुवि।\nउत्तमाङ्गं हताङ्गस्य वृत्रे वज्रहते यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015068, "chapter_id": 1314, "verse_number": "२-५५-३६", "content_sanskrit": "भूमिस्तु पतितं दृष्ट्वा प्रायच्छत्कुण्डले सुतम्।\nप्रदाय च महाबाहुमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015069, "chapter_id": 1314, "verse_number": "२-५५-३७", "content_sanskrit": "सृष्टस्त्वयैव मधुहंस्त्वयैव विनिपातितः।\nयथेच्छसि तथा क्रीडा प्रजास्तस्यानुपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015070, "chapter_id": 1314, "verse_number": "२-५५-३८x", "content_sanskrit": "श्रीवासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015071, "chapter_id": 1314, "verse_number": "२-५५-३८", "content_sanskrit": "देवानां च मुनीनां च पितॄणां च महात्मनाम्।\nउद्वेजनीयो भूतानां ब्रह्मद्विद् पुरुषाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015072, "chapter_id": 1314, "verse_number": "२-५५-३९", "content_sanskrit": "लोकद्विष्टः सुतस्ते तु देवारिर्लोककण्टकः।\nसर्वलोकनमस्कार्यामदितं बाधयद्वली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015073, "chapter_id": 1314, "verse_number": "२-५५-४०", "content_sanskrit": "कुण्डले हृतवान्दर्पात्ततस्ते निहतः सुतः।\nनैव मन्युस्त्वया कार्यो यत्कृतं मयि भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015074, "chapter_id": 1314, "verse_number": "२-५५-४१", "content_sanskrit": "त्वत्प्रभावाच्च ते पुत्रो लब्धवान्गतिमुत्तमाम्।\nतस्माद्गच्छ महाभागे भारावतरणं कृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015075, "chapter_id": 1314, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि पञ्चपञ्चाशोऽध्यायः॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]