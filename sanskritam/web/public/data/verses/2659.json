[{"id": 2078150, "chapter_id": 2659, "verse_number": "१२-१६४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078151, "chapter_id": 2659, "verse_number": "१२-१६४-१", "content_sanskrit": "कथान्तरमथासाद्य स्वङ्गयुद्धविशारदः।\nनकुलः शरतल्पस्थमिदमाह पितामहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078152, "chapter_id": 2659, "verse_number": "१२-१६४-२x", "content_sanskrit": "नकुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078153, "chapter_id": 2659, "verse_number": "१२-१६४-२", "content_sanskrit": "धनुः प्रहरणं श्रेष्ठमितिवादः पितामह।\nमतस्तु मम धर्मज्ञः खङ्ग एव सुसंशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078154, "chapter_id": 2659, "verse_number": "१२-१६४-३", "content_sanskrit": "छिन्ने च कार्मुके राजन्प्रक्षीणेषु शरेषु च।\nखङ्गेन शक्यते योद्धुमात्मानं परिरक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078155, "chapter_id": 2659, "verse_number": "१२-१६४-४", "content_sanskrit": "शरासनधरांश्चैव गदाशक्तिधरांस्तदा।\nएकः खङ्गधरो वीरः समर्थः प्रतिबाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078156, "chapter_id": 2659, "verse_number": "१२-१६४-५", "content_sanskrit": "अत्र मे संशयश्चैव कौतूहलमतीव च।\nकिंस्वित्प्रहरणं श्रेष्ठं सर्वयुद्धेषु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078157, "chapter_id": 2659, "verse_number": "१२-१६४-६", "content_sanskrit": "कथं चोत्पादितः खङ्गः कस्मै चार्थाय केन वा।\nपूर्वाचार्यं च खङ्गस्य प्रव्रवीहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078158, "chapter_id": 2659, "verse_number": "१२-१६४-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078159, "chapter_id": 2659, "verse_number": "१२-१६४-७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा माद्रीपुत्रस्य धीमतः।\nस्वरकौशलसंयुक्तं सूक्ष्मचित्रार्थवत्सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078160, "chapter_id": 2659, "verse_number": "१२-१६४-८", "content_sanskrit": "ततस्तस्योत्तरं वाक्यं स्वरवर्णोपपादितम्।\nशिक्षया चोपपन्नाय द्रोणशिष्याय पृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078161, "chapter_id": 2659, "verse_number": "१२-१६४-९", "content_sanskrit": "उवाच सर्वधर्मज्ञो धनुर्वेदस्य पारगः।\nशरतल्पगतो भीष्मो नकुलाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078162, "chapter_id": 2659, "verse_number": "१२-१६४-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078163, "chapter_id": 2659, "verse_number": "१२-१६४-१०", "content_sanskrit": "तत्त्वं शृणुष्व माद्रेय यथैतत्परिपृच्छसि।\nप्रबोधितोऽस्मि भवता सानुमानिव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078164, "chapter_id": 2659, "verse_number": "१२-१६४-११", "content_sanskrit": "सलिलैकार्णवं तात पुरा सर्वमभूदिदम्।\nअप्रज्ञातमनाकाशमनिर्देश्यमहीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078165, "chapter_id": 2659, "verse_number": "१२-१६४-१२", "content_sanskrit": "तमस्संवृतमस्पर्शमतिगम्भीरदर्शनम्।\nनिःशब्दं चाप्रमेयं च तत्र जज्ञे पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078166, "chapter_id": 2659, "verse_number": "१२-१६४-१३", "content_sanskrit": "सोऽसृजद्वायुमग्निं च भास्करं चापि वीर्यवान्।\nआकाशममृजच्चोर्ध्वमध्नो भूमिं च नैर्ऋतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078167, "chapter_id": 2659, "verse_number": "१२-१६४-१४", "content_sanskrit": "ततः सचन्द्रतारं च नक्षत्राणि ग्रहांस्तथा।\nसंवत्सरानहोरात्रानृतूनथ लवान्क्षणान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078168, "chapter_id": 2659, "verse_number": "१२-१६४-१५", "content_sanskrit": "ततः शरीरं लोकस्थं स्थापयित्वा पितामहः।\nजनयामास भगवान्पुत्रानुत्तमतेजसः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078169, "chapter_id": 2659, "verse_number": "१२-१६४-१६", "content_sanskrit": "मरीचिं भृगुमत्रिं च पुलस्त्यं पुलहं क्रतुम्।\nवसिष्ठाङ्गिरसौ चोभौ भरद्वाजं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078170, "chapter_id": 2659, "verse_number": "१२-१६४-१७", "content_sanskrit": "प्रजापतिस्तथा दक्षः कन्याः षष्टिमजीजनात्।\nताश्च ब्रह्मर्पीन्सर्वान्प्रजार्थं प्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078171, "chapter_id": 2659, "verse_number": "१२-१६४-१८", "content_sanskrit": "ताभ्यो विश्वानि भूतानि देवाः पितृगणास्तथा।\nगन्धर्वाप्सरसश्चैव रक्षासि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078172, "chapter_id": 2659, "verse_number": "१२-१६४-१९", "content_sanskrit": "पतत्रिमृगमीनाश्च गावश्चैव महोरगाः।\nनानाकृतिबलाश्चान्ये जलक्षितिविचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078173, "chapter_id": 2659, "verse_number": "१२-१६४-२०", "content_sanskrit": "उद्भिज्जाः स्वेदजाश्चैव साण्डजाश्च जरायुजाः।\nअज्ञे तात जगत्सर्वं तथा स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078174, "chapter_id": 2659, "verse_number": "१२-१६४-२१", "content_sanskrit": "अतः सर्गमिमं कृत्वा सर्वलोकपितामहः।\nअश्वतं वेदपठितं धर्मं च जुजुपे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078175, "chapter_id": 2659, "verse_number": "१२-१६४-२२", "content_sanskrit": "स्मन्धर्मे स्थिता देवाः सहाचार्यपुरोहिताः।\n---त्या वसवो रुद्राः ससाध्या मरुदश्विनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078176, "chapter_id": 2659, "verse_number": "१२-१६४-२३", "content_sanskrit": "भृ---त्र्यङ्गिरसः सिद्धाः कश्यपश्च तपोधनाः।\nवष्ठगौतमागस्त्यास्तथा नारदपर्वतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078177, "chapter_id": 2659, "verse_number": "१२-१६४-२४", "content_sanskrit": "क्रयो बालखिल्याश्च प्रभासाः सिकतास्तथा।\nघृगाच्या सोमवायव्या वैश्वानरमरीचिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078178, "chapter_id": 2659, "verse_number": "१२-१६४-२५", "content_sanskrit": "करूपाश्चैव हंसाश्च ऋषयो वाऽग्नियोनयः।\n---पप्रस्थाः पृश्नयश्च स्थिता ब्रह्मानुशासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078179, "chapter_id": 2659, "verse_number": "१२-१६४-२६", "content_sanskrit": "दानवेन्द्रास्त्वतिक्रम्य तत्पितामहशासनम्।\nधर्मस्यापनयं चक्रुः क्रोधलोभसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078180, "chapter_id": 2659, "verse_number": "१२-१६४-२७", "content_sanskrit": "हिरण्यकशिपुश्चैव हिरण्याक्षो विरोचनः।\nशम्बरो विप्रचित्तिश्च प्रह्लादो नमुचिर्बलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078181, "chapter_id": 2659, "verse_number": "१२-१६४-२८", "content_sanskrit": "एते चान्ये च बहवः सगणा दैत्यदानवाः।\nधर्मसेतुमतिक्रम्य रेमिरेऽधर्मनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078182, "chapter_id": 2659, "verse_number": "१२-१६४-२९", "content_sanskrit": "सर्वे तुल्याभिजातीया यथा देवास्तथा वयम्।\nइत्येवं हेतुमास्थाय स्पर्धमानाः सुरर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078183, "chapter_id": 2659, "verse_number": "१२-१६४-३०", "content_sanskrit": "न प्रियं नाप्यनुक्रोशं चक्रुर्भूतेषु भारत।\nत्रीनुपायानतिक्रम्य दण्डेन रुरुधुः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078184, "chapter_id": 2659, "verse_number": "१२-१६४-३१", "content_sanskrit": "न जग्मुः संविदं तैश्च दर्पादसुरसत्तमाः।\nअथ वै भगवान्ब्रह्मा सर्वलोकनमस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078185, "chapter_id": 2659, "verse_number": "१२-१६४-३२", "content_sanskrit": "तदा हिमवतः पृष्ठे सुरम्ये पद्मतारके।\nशतयोजनविस्तारे मणिमुक्ताचयाचिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078186, "chapter_id": 2659, "verse_number": "१२-१६४-३३", "content_sanskrit": "तस्मिन्गिरिवरे पुत्र पुष्पितद्रुमकानने।\nतस्थौ स विबुधश्रेष्ठो ब्रह्मा लोकार्थसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078187, "chapter_id": 2659, "verse_number": "१२-१६४-३४", "content_sanskrit": "ततो वर्षसहस्रान्ते वितानमकरोत्प्रभुः।\nविधिना कल्पदृष्टेन यथोक्तेनोपपादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078188, "chapter_id": 2659, "verse_number": "१२-१६४-३५", "content_sanskrit": "ऋषिभिर्यज्ञपटुभिर्यथावत्कर्मकर्तृभिः।\nमरुद्भिः परिसंकीर्णं दीप्यमानैश्च पावकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078189, "chapter_id": 2659, "verse_number": "१२-१६४-३६", "content_sanskrit": "काञ्चनैर्यज्ञभाण्डैश्च भ्राजिष्णुभिरलंकृतम्।\nवृतं देवगणैश्चैव प्रबभौ यज्ञमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078190, "chapter_id": 2659, "verse_number": "१२-१६४-३७", "content_sanskrit": "तथा ब्रह्मर्षिभिश्चैव सदस्यैरुपशोभितम्।\nअत्र घोरतमं वृत्तमृषीणां मे परिश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078191, "chapter_id": 2659, "verse_number": "१२-१६४-३८", "content_sanskrit": "चन्द्रमा विमलं व्योम यथाऽभ्युदिततारकम्।\nविदार्याग्निं तथा भूतमुत्थितं श्रूयते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078192, "chapter_id": 2659, "verse_number": "१२-१६४-३९", "content_sanskrit": "लोनीत्पलसवर्णाभं तीक्ष्णदंष्ट्रं कृशोदरम्।\nप्रांशुमुद्धर्षणं चापि तथैव ह्यमितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078193, "chapter_id": 2659, "verse_number": "१२-१६४-४०", "content_sanskrit": "अस्मिन्नुत्पद्यमाने च प्रचचास वसुंधरा।\nमहोर्मिकलिलावर्तश्रुक्षुभे स महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078194, "chapter_id": 2659, "verse_number": "१२-१६४-४१", "content_sanskrit": "पेतुश्चोत्का महोत्पाताः शाखाश्च मुमुचुर्द्रुमाः।\nअप्रसन्ना दिशः सर्वाः पवनश्चाशिवो ववौ।\nमुहुर्मुहुश्च भूतानि प्राव्यथन्त भयात्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078195, "chapter_id": 2659, "verse_number": "१२-१६४-४२", "content_sanskrit": "ततः स तुमुलं दृष्ट्वा तद्भूतं समुपस्थितम्।\nमहर्षिसुरगन्धर्वानुवाचेदं पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078196, "chapter_id": 2659, "verse_number": "१२-१६४-४३", "content_sanskrit": "मयैवं चिन्तितं भूतमसिर्नामैष वीर्यवान्।\nरक्षणार्थाय लोकस्य वधाय च सुरद्विषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2078197, "chapter_id": 2659, "verse_number": "१२-१६४-४४", "content_sanskrit": "ततस्तद्रुपमुत्सृज्य बभौ निस्त्रिंश एव सः।\nविमलस्तीक्ष्णधारश्च कालान्तक इवोद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2078198, "chapter_id": 2659, "verse_number": "१२-१६४-४५", "content_sanskrit": "ततस्तं नीलकण्ठाय रुद्रायर्षभकेतवे।\nब्रह्मा ददावसिं तीक्ष्णमधर्मप्रतिवारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2078199, "chapter_id": 2659, "verse_number": "१२-१६४-४६", "content_sanskrit": "ततः स भगवान्रुद्रो ब्रह्मर्षिगणपूजितः।\nप्रगृह्मासिममेयात्मा रूपमन्यच्चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2078200, "chapter_id": 2659, "verse_number": "१२-१६४-४७", "content_sanskrit": "चतुर्बाहुः स्पृशन्मूर्ध्ना भूमिष्ठोऽपि दिशो दश।\nऊर्ध्वदृष्टिर्महाबाहुर्मुखाज्ज्वालाः समुत्सृजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2078201, "chapter_id": 2659, "verse_number": "१२-१६४-४८", "content_sanskrit": "विकुर्वन्बहुधा वर्णान्नीलपाण्डुरलोहितान्।\nबिभ्रत्कृष्णाजिनं वासो हेमप्रवरतारकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2078202, "chapter_id": 2659, "verse_number": "१२-१६४-४९", "content_sanskrit": "नेत्रं चैकं ललाटस्थं भास्करप्रतिमं महत्।\nशुशुभाते सुविमले द्वे नेत्रे कृष्णपिङ्गले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2078203, "chapter_id": 2659, "verse_number": "१२-१६४-५०", "content_sanskrit": "ततो देवो महादेवः शूलपाणिर्भगाक्षिहा।\nसंप्रगृह्य तु निस्त्रिंशं कालाग्निसमवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2078204, "chapter_id": 2659, "verse_number": "१२-१६४-५१", "content_sanskrit": "त्रिकूटं चर्म चोद्यम्य सविद्युतमिवाम्बुदम्।\nचचार विविधान्मार्गान्दानवान्तचिकीर्षया।\nविधुन्वन्नसिमाकाशे तथा युद्धचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2078205, "chapter_id": 2659, "verse_number": "१२-१६४-५२", "content_sanskrit": "तस्य नादं विनदतो महाहासं च मुञ्चतः।\nबभौ प्रतिभयं रूपं तदा रुद्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2078206, "chapter_id": 2659, "verse_number": "१२-१६४-५३", "content_sanskrit": "तद्रूपधारिणं रुद्रं रौद्रकर्मचिकीर्षया।\nनिशाम्य दानवाः सर्वे हृष्टाः समभिदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2078207, "chapter_id": 2659, "verse_number": "१२-१६४-५४", "content_sanskrit": "अश्मभिश्चाम्यवर्षन्त प्रदीप्तैश्च तथोल्मुकैः।\nघोरैः प्रहरणैश्चान्यैः क्षुरधारैरयस्मयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2078208, "chapter_id": 2659, "verse_number": "१२-१६४-५५", "content_sanskrit": "ततस्तु दानवानीकं संप्रणेतृकमप्युत।\nखङ्गं दृष्ट्वा बलाधूतं प्रमुमोह चचाल च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2078209, "chapter_id": 2659, "verse_number": "१२-१६४-५६", "content_sanskrit": "चित्रं शीघ्रपदत्वाच्च चरन्तमसिपाणिनम्।\nतमेकमसुराः सर्वे सहस्रमिति मेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2078210, "chapter_id": 2659, "verse_number": "१२-१६४-५७", "content_sanskrit": "छिन्दन्भिन्दन्रुजन्कृन्तन्दारयन्प्रथमन्नपि।\nअचरद्वैरिसङ्घेषु दावाग्निरिव कक्षगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2078211, "chapter_id": 2659, "verse_number": "१२-१६४-५८", "content_sanskrit": "असिवेगप्रभग्नास्ते छिन्नबाहूरुवक्षसः।\nउत्तमाङ्गप्रकृत्ताश्च पेतुरुर्व्यां महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2078212, "chapter_id": 2659, "verse_number": "१२-१६४-५९", "content_sanskrit": "अपरे दानवा भग्नाः खङ्गधारावपीडिताः।\nअन्योन्यमभिनर्दन्तो दिशः संप्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2078213, "chapter_id": 2659, "verse_number": "१२-१६४-६०", "content_sanskrit": "भूमिं केचित्प्रविविशुः पर्वतानपरे तथा।\nअपरे जग्मुराकासमपरेऽम्भः समाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2078214, "chapter_id": 2659, "verse_number": "१२-१६४-६१", "content_sanskrit": "तस्मिन्महति संवृत्ते समरे भृशदारुणे।\nबभूव भूः प्रतिभया मांसशोणितकर्दमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2078215, "chapter_id": 2659, "verse_number": "१२-१६४-६२", "content_sanskrit": "दानवानां शरीरैश्च पतितैः शोणितोक्षितैः।\nसमाकीर्णा महाबाहो शैलैरिव सकिंशुकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2078216, "chapter_id": 2659, "verse_number": "१२-१६४-६३", "content_sanskrit": "`रुधिरेण परिक्लिन्ना प्रबभौ वसुधा तदा।\nरक्तार्द्रवसना श्यामा नारीव मदविह्वला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2078217, "chapter_id": 2659, "verse_number": "१२-१६४-६४", "content_sanskrit": "स रुद्रो दानवान्हत्वा कृत्वा धर्मोत्तरं जगत्।\nरौद्रं रुपमथाक्षिप्य चक्रे रूपं शिवं शिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2078218, "chapter_id": 2659, "verse_number": "१२-१६४-६५", "content_sanskrit": "ततो महर्षयः सर्वे सर्वे देवगणास्तथा।\nजयेनाद्भुतकल्पेन देवदेवमथास्तुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2078219, "chapter_id": 2659, "verse_number": "१२-१६४-६६", "content_sanskrit": "ततः स भगवान्रुद्रो दानवक्षतजोक्षितम्।\nअसिं धर्मस्य गोप्तारं ददौ सत्कृत्य विष्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2078220, "chapter_id": 2659, "verse_number": "१२-१६४-६७", "content_sanskrit": "विष्णुर्मरीचये प्रादान्मरीचिर्भार्गवाय तम्।\nमहर्षिभ्यो ददौ खङ्गमृषयो वासवाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2078221, "chapter_id": 2659, "verse_number": "१२-१६४-६८", "content_sanskrit": "महेन्द्रो लोकपालेभ्यो लोकपाला तु पुत्रक।\nमनवे सूर्यपुत्राय ददुः खङ्गं सुविस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2078222, "chapter_id": 2659, "verse_number": "१२-१६४-६९", "content_sanskrit": "ऊचुश्चैनं तथा वाक्यं मानुषाणां त्वमीश्वरः।\nअसिना धर्मगर्भेण पालयस्व प्रजा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2078223, "chapter_id": 2659, "verse_number": "१२-१६४-७०", "content_sanskrit": "धर्मसेतुमतिक्रान्ताः स्थूलसूक्ष्मार्थकारणात्।\nविभज्य दण्डं रक्ष्याः स्युर्धर्मतो न यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2078224, "chapter_id": 2659, "verse_number": "१२-१६४-७१", "content_sanskrit": "दुर्वाचा निग्रहो दण्डो हिरण्यबहुलस्तथा।\nव्यङ्गता च शरीरस्य वधो नाल्पस्य करणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2078225, "chapter_id": 2659, "verse_number": "१२-१६४-७२", "content_sanskrit": "असेरेतानि रूपाणि दुर्वारादीनि नि दशेत्।\nअसेरेवं प्रमाणानि परमाण्यभ्यतिक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2078226, "chapter_id": 2659, "verse_number": "१२-१६४-७३", "content_sanskrit": "अभिषिच्याथ पुत्रं स्वं प्रजानामधिपं ततः।\nमनुः प्रजानां रक्षार्थं क्षुपाय प्रददावसिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2078227, "chapter_id": 2659, "verse_number": "१२-१६४-७४", "content_sanskrit": "क्षुपाज्जग्राह चेक्ष्वाकुरिक्ष्वाकोश्च पुरूरवाः।\nआयुश्च तस्माल्लोभे तं नहुषश्च ततो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2078228, "chapter_id": 2659, "verse_number": "१२-१६४-७५", "content_sanskrit": "ययातिर्नहुषाच्चापि पूरुस्तस्माच्च लब्धवान्।\nआधूर्तश्च गयस्तस्मात्ततो भूमिशयो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2078229, "chapter_id": 2659, "verse_number": "१२-१६४-७६", "content_sanskrit": "भरतश्चापि दौष्यन्तिर्लेभे भूमिशयादसिम्।\nतस्माल्लोभे च धर्मज्ञो राजन्नैलबिलस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2078230, "chapter_id": 2659, "verse_number": "१२-१६४-७७", "content_sanskrit": "ततस्त्वैलबिलाल्लेभे धुन्धुमारो नरेश्वरः।\nधुन्धुमाराच्च काम्भोजो मुचुकुन्दस्ततोऽभजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2078231, "chapter_id": 2659, "verse_number": "१२-१६४-७८", "content_sanskrit": "मुचुकुन्दान्मरुत्तश्च मरुत्तादपि रैवतः।\nरैवताद्युवनाश्वश्च युवनाश्वात्ततो रघुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2078232, "chapter_id": 2659, "verse_number": "१२-१६४-७९", "content_sanskrit": "इक्ष्वाकुवंशजस्तस्माद्धरिणाश्वः प्रतापवान्।\nहरिणाश्वादसिं लेभे शुनकः शुनकादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2078233, "chapter_id": 2659, "verse_number": "१२-१६४-८०", "content_sanskrit": "उशीनरो वै धर्मात्मा तस्माद्भोजाः सयादवाः।\nयदुभ्यश्च शिबिर्लेभे शिबेश्चापि प्रतर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2078234, "chapter_id": 2659, "verse_number": "१२-१६४-८१", "content_sanskrit": "प्रतर्दनादष्टकश्च रुशदश्वोऽष्टकादपि।\nरुशदश्वाद्भरद्वाजो द्रोणस्तस्मात्कृपस्ततः।\nततस्त्वं भ्रातृभिः सार्धं परमासिमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2078235, "chapter_id": 2659, "verse_number": "१२-१६४-८२", "content_sanskrit": "कृत्तिकास्तस्य नक्षत्रमसेरग्निश्च दैवतम्।\nरोहिण्यो गोत्रमस्याथ रुद्राश्च गुरुसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2078236, "chapter_id": 2659, "verse_number": "१२-१६४-८३", "content_sanskrit": "असेरष्टौ हि नामानि रहस्यानि निबोध मे।\nपाण्डवेय सदा यानि कीर्तयँल्लभते जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2078237, "chapter_id": 2659, "verse_number": "१२-१६४-८४", "content_sanskrit": "असिर्विशसनः खङ्गस्तीक्ष्णचर्मा दुरासदः।\nश्रीगर्भो विजयश्चैव धर्मपालस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2078238, "chapter_id": 2659, "verse_number": "१२-१६४-८५", "content_sanskrit": "अग्र्यः प्रहरणानां च खङ्गो भुवि परिश्रुतः।\nमहेश्वरप्रणीतश्च पुराणे निश्चयं गतः।\n`एतानि चैव नामानि पुराणे निश्चितानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2078239, "chapter_id": 2659, "verse_number": "१२-१६४-८६", "content_sanskrit": "पृथुस्तूत्पादयामास धनुराद्यमरिंदमः।\nतेनेयं पृथिवी दुग्धा सस्यानि सुबहून्यपि।\nधर्मेण च यथापूर्वं वैन्येन परिरक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2078240, "chapter_id": 2659, "verse_number": "१२-१६४-८७", "content_sanskrit": "तदेतदार्षं माद्रेय प्रमाणं कर्तुमर्हसि।\nअसेश्च पूजा कर्तव्या सदा युद्धविशारदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2078241, "chapter_id": 2659, "verse_number": "१२-१६४-८८", "content_sanskrit": "इत्येष प्रथमः कल्पो मया ते कथितः पुनः।\nएवमेवासिसर्गोऽयं यथावद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2078242, "chapter_id": 2659, "verse_number": "१२-१६४-८९", "content_sanskrit": "सर्वथा तमिह श्रुत्वा स्वङ्गस्यागममुत्तमम्।\nलभते पुरुषः कीर्ति प्रेत्य चानन्त्यमश्नुते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2078243, "chapter_id": 2659, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि चतुःषष्ट्यधिकशततमोऽध्यायः॥ १६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]