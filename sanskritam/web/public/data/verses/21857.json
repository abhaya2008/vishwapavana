[{"id": 7001857000, "chapter_id": 21857, "verse_number": "३६-१", "content_sanskrit": "जड उवाच ।\nस एवमनुशिष्टः सन् मात्रा संप्राप्य यौवनम् ।\nऋतध्वजसुतश्चक्रे सम्यग्दारपरिग्रहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001857001, "chapter_id": 21857, "verse_number": "३६-२", "content_sanskrit": "पुत्रांश्चोत्पादयामास यज्ञैश्चाप्ययजद्विभुः ।\nपितुश्च सर्वकालेषु चकाराज्ञानुपालनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001857002, "chapter_id": 21857, "verse_number": "३६-३", "content_sanskrit": "ततः कालेन महता संप्राप्य चरमं वयः ।\nचक्रेऽभिषेकं पुत्रस्य तस्य रज्ये ऋतध्वजः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001857003, "chapter_id": 21857, "verse_number": "३६-४", "content_sanskrit": "भार्यया सह धर्मात्मा यियासुस्तपसे वनम् ।\nअवतीर्णो महारक्षो महाभागो महीपतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001857004, "chapter_id": 21857, "verse_number": "३६-५", "content_sanskrit": "मदालसा च तनयं प्राहेदं पश्चिमं वच ।\nकामोपभोगसंसर्गप्रहाणाय सुतस्य वै ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001857005, "chapter_id": 21857, "verse_number": "३६-६", "content_sanskrit": "मदालसोवाच ।\nयदा दुः खमसह्यं ते प्रियबन्धुवियोगजम् ।\nशत्रुबाधोद्भवं वापि वित्तनाशात्मसम्भवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001857006, "chapter_id": 21857, "verse_number": "३६-७", "content_sanskrit": "भवेत्तत् कुर्वतो राज्यं गृहधर्मावलम्बिनः ।\nदुः खायतनभूतो हि ममत्वालम्बनो गृही ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001857007, "chapter_id": 21857, "verse_number": "३६-८", "content_sanskrit": "तदास्मात् पुत्र ! निष्कृष्य मद्दत्तादङ्गुलीयकात् ।\nवाच्यं ते शासनं पट्टे सूक्ष्माक्षरनिवेशितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001857008, "chapter_id": 21857, "verse_number": "३६-९", "content_sanskrit": "जड उवाच ।\nइत्युक्त्वा प्रददौ तस्मै सौवर्णं साङ्गुलीयकम् ।\nआशिषश्चापि या योग्याः परुषस्य गृहे सतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001857009, "chapter_id": 21857, "verse_number": "३६-१०", "content_sanskrit": "ततः कुबलयाश्वोऽसौ सा च देवी मदालसा ।\nपुत्राय दत्त्वा तद्राज्यं तपसे काननं गतौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]