[{"id": 7002310000, "chapter_id": 22310, "verse_number": "३५५-१", "content_sanskrit": "स्कन्ध उवाच ।\nषोढ़ा समासं वक्ष्यामि अष्टाविंशातिधा पुनः ।\nनित्यानित्यविभागेन लुगलोपेन च द्विधा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002310001, "chapter_id": 22310, "verse_number": "३५५-२", "content_sanskrit": "कुम्भकारश्च नित्यः स्याद्धेमकारादिकस्तथा ।\nराज्ञः पुमान्राजपुमान् नित्योऽयञ्च समासकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002310002, "chapter_id": 22310, "verse_number": "३५५-३", "content_sanskrit": "कष्टश्रितो लुक्समासः कण्ठेकालादिकस्त्वलुक् ।\nस्यादष्टधा तत्पुरुषः प्रथमाद्यसुपा सह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002310003, "chapter_id": 22310, "verse_number": "३५५-४", "content_sanskrit": "प्रथमातत्पुरुषोऽयं पूर्व्वं कायस्य विग्रहे ।\nपूर्वकायोऽपरकायो ह्यधरोत्तरकायकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002310004, "chapter_id": 22310, "verse_number": "३५५-५", "content_sanskrit": "अर्द्धं कणाया अर्द्धकणा भिक्षातुर्य्यमथेदृशम् ।\nआपन्नजीविकस्तद्वत् द्वितीया चाधराश्रितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002310005, "chapter_id": 22310, "verse_number": "३५५-६", "content_sanskrit": "वर्षम्भोग्यो वर्षभोग्यो धान्यार्थश्च तृतीयया ।\nचतुर्थो स्याद्विषणुबलिर्वृकभीतिश्च पञ्चमी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002310006, "chapter_id": 22310, "verse_number": "३५५-७", "content_sanskrit": "राज्ञः पुमान् राजपुमान् षष्ठी वृक्षफलं तथा ।\nसप्तमी चाक्षशौण्डोऽयमहितो नञ्समासकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002310007, "chapter_id": 22310, "verse_number": "३५५-८", "content_sanskrit": "कर्मधारयः सप्तधा नीलोत्पलमुखाः स्मृताः ।\nविशेषणपूर्व्वपदो विशेष्योत्तरतस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002310008, "chapter_id": 22310, "verse_number": "३५५-९", "content_sanskrit": "वैयाकरणखसूचिः शीतोष्णं द्विपदं शुभम् ।\nउपमानपूर्वपदः शङ्खपाण्डर इत्यपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002310009, "chapter_id": 22310, "verse_number": "३५५-१०", "content_sanskrit": "उपमानोत्तरपदः पुरुषव्याघ्र इत्यपि ।\nसम्भावनापूर्वपदो गुणवृद्धिरितीदृशम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002310010, "chapter_id": 22310, "verse_number": "३५५-११", "content_sanskrit": "गुण इति वृद्धिर्वाच्या सुहृदेव सुबन्धुकः ।\nसवधारणपूर्वपदो बहुव्रीहिश्च सप्तधा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002310011, "chapter_id": 22310, "verse_number": "३५५-१२", "content_sanskrit": "द्विपदश्च बहुव्रीहिरारूढ़भवनो नरः ।\nअर्च्चिताशेषपूर्व्वोऽयं बह्वङ्घ्रिः परिकीर्त्तितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002310012, "chapter_id": 22310, "verse_number": "३५५-१३", "content_sanskrit": "एते विप्राश्चोपदशाः सङ्ख्योत्तरपदस्त्वयम् ।\nसङ्ख्योभयपदो यद्वद्द्वित्रा द्व्येकत्रयो नरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002310013, "chapter_id": 22310, "verse_number": "३५५-१४", "content_sanskrit": "सहपूर्षपदोऽयं स्यात् समूलोद्धृतकस्तरुः ।\nव्यतिहारलक्षणार्थः केशाकेशि नखानखि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002310014, "chapter_id": 22310, "verse_number": "३५५-१५", "content_sanskrit": "दिग्लक्ष्या स्याद्दक्षिणपूर्व्वा द्विगुराभाषितो द्विधा ।\nएकवद्भावि द्विश्रृङ्गं पञ्चमूली त्वनेकधा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002310015, "chapter_id": 22310, "verse_number": "३५५-१६", "content_sanskrit": "द्वन्द्वः समासो द्विविखधो हीतरेतरयोगकः ।\nरुद्रविष्णू समाहारो भेरीपटहमीदृशम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002310016, "chapter_id": 22310, "verse_number": "३५५-१७", "content_sanskrit": "द्विधाख्यातोऽव्ययीभावो नामपूर्वपदो यथा ।\nशाकस्य मात्रा शाकप्रति यथाऽव्ययपूर्व्यकः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002310017, "chapter_id": 22310, "verse_number": "३५५-१८", "content_sanskrit": "उपकुम्भञ्चोपरथ्यं प्राधान्येन चतुर्विंधः ।\nउत्तरपदार्थमुख्यो द्वन्द्वश्चोभयमुख्यकः ।\nपूर्वार्थेशोऽव्ययीभावो बहुव्रीहिश्च वाह्यगः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]