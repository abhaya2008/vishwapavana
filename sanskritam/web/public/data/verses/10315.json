[{"id": 6000315000, "chapter_id": 10315, "verse_number": null, "content_sanskrit": "चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000315001, "chapter_id": 10315, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.001.m4a", "display_order": 2}, {"id": 6000315002, "chapter_id": 10315, "verse_number": "११-१४-१", "content_sanskrit": "वदन्ति कृष्ण श्रेयांसि बहूनि ब्रह्मवादिनः।\nतेषां विकल्पः प्राधान्यमुताहो एकमुख्यता॥ ११/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.002.m4a", "display_order": 3, "topics": [{"text": "भगवद्भक्तेः परमश्रेयस्साधनत्वकथनम्", "range": "१–३०"}]}, {"id": 6000315003, "chapter_id": 10315, "verse_number": "११-१४-२", "content_sanskrit": "भवतोदाहृतः स्वामिन् भक्तियोगोऽनपेक्षितः।\nनिरस्य सर्वतः सङ्गं येन त्वय्याविशेन्मनः॥ ११/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.003.m4a", "display_order": 4}, {"id": 6000315004, "chapter_id": 10315, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.004.m4a", "display_order": 5}, {"id": 6000315005, "chapter_id": 10315, "verse_number": "११-१४-३", "content_sanskrit": "कालेन नष्टा प्रलये वाणीयं वेदसञ्ज्ञिता।\nमयाऽऽदौ ब्रह्मणे प्रोक्ता धर्मो यस्यां मदात्मकः॥ ११/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.005.m4a", "display_order": 6}, {"id": 6000315006, "chapter_id": 10315, "verse_number": "११-१४-४", "content_sanskrit": "तेन प्रोक्ता च पुत्राय मनवे पूर्वजाय सा।\nततो भृग्वादयोऽगृह्णन् शब्दब्रह्म महर्षयः॥ ११/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.006.m4a", "display_order": 7}, {"id": 6000315007, "chapter_id": 10315, "verse_number": "११-१४-५", "content_sanskrit": "तेभ्यः पितृभ्यस्तत्पुत्रा देवदानवगुह्यकाः।\nमनुष्याः सिद्धगन्धर्वाः सविद्याधरचारणाः॥ ११/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.007.m4a", "display_order": 8}, {"id": 6000315008, "chapter_id": 10315, "verse_number": "११-१४-६", "content_sanskrit": "किन्देवाः किन्नराः नागा रक्षःकिम्पुरुषादयः।\nबह्व्यस्तेषां प्रकृतयो रजःसत्त्वतमोभुवः॥ ११/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.008.m4a", "display_order": 9}, {"id": 6000315009, "chapter_id": 10315, "verse_number": "११-१४-७", "content_sanskrit": "याभिर्भूतानि भिद्यन्ते भूतानां मतयस्तथा।\nयथाप्रकृति सर्वेषां चित्रा वाचः स्रवन्ति हि॥ ११/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.009.m4a", "display_order": 10}, {"id": 6000315010, "chapter_id": 10315, "verse_number": "११-१४-८", "content_sanskrit": "एवं प्रकृतिवैचित्र्याद् भिद्यन्ते मतयो नृणाम्।\nपारम्पर्येण केषाञ्चित् पाखण्डमतयोऽपरे॥ ११/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.010.m4a", "display_order": 11}, {"id": 6000315011, "chapter_id": 10315, "verse_number": "११-१४-९", "content_sanskrit": "मन्मायामोहितधियः पुरुषाः पुरुषर्षभ।\nश्रेयो वदन्त्यनेकान्तं यथाकर्म यथारुचि॥ ११/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.011.m4a", "display_order": 12}, {"id": 6000315012, "chapter_id": 10315, "verse_number": "११-१४-१०", "content_sanskrit": "धर्ममेके यशश्चान्ये कामं सत्यं दमं शमम्। अन्ये वदन्ति चार्थं वा ऐश्वर्यं त्यागभोजने।\nकेचिद् यज्ञं तपो दानं व्रतानि नियमान् यमान्॥ ११/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.012.m4a", "display_order": 13}, {"id": 6000315013, "chapter_id": 10315, "verse_number": "११-१४-११", "content_sanskrit": "आद्यन्तवन्त एवैषां लोकाः कर्मविनिर्मिताः।\nदुःखोदर्कास्तमोनिष्ठाः क्षुद्रानन्दाः शुचाऽर्पिताः॥ ११/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.013.m4a", "display_order": 14}, {"id": 6000315014, "chapter_id": 10315, "verse_number": "११-१४-१२", "content_sanskrit": "मय्यर्पितात्मनः सत्ये निरपेक्षस्य सर्वतः।\nमदात्मकं सुखं यत् तत् कुतः स्याद् विषयात्मनाम्॥ ११/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.014.m4a", "display_order": 15}, {"id": 6000315015, "chapter_id": 10315, "verse_number": "११-१४-१३", "content_sanskrit": "अकिञ्चनस्य दान्तस्य शान्तस्य समचेतसः।\nमया सन्तुष्टमनसः सर्वाः सुखमया दिशः॥ ११/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.015.m4a", "display_order": 16}, {"id": 6000315016, "chapter_id": 10315, "verse_number": "११-१४-१४", "content_sanskrit": "न पारमेष्ठ्यं न महेन्द्रधिष्ण्यं न सार्वभौमं न रसाधिपत्यम्।\nन योगसिद्धीरपुनर्भवं वा मय्यर्पितात्मेच्छति मद् विनाऽन्यत्॥ ११/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.016.m4a", "display_order": 17}, {"id": 6000315017, "chapter_id": 10315, "verse_number": "११-१४-१५", "content_sanskrit": "न तथा मे प्रियतम आत्मयोनिर्न शङ्करः।\nन च सङ्कर्षणो न श्रीर्न वाऽऽत्मा च यथा भवान्॥ ११/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.017.m4a", "display_order": 18}, {"id": 6000315018, "chapter_id": 10315, "verse_number": "११-१४-१६", "content_sanskrit": "निरपेक्षं मुनिं शान्तं निर्वैरं समदर्शनम्।\nअनुव्रजाम्यहं नित्यं पूयेय स्वाङ्घ्रिरेणुभिः॥ ११/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.018.m4a", "display_order": 19}, {"id": 6000315019, "chapter_id": 10315, "verse_number": "११-१४-१७", "content_sanskrit": "निष्किञ्चना मय्यनुरक्तचेतसः शान्ता महान्तोऽखिलजीववत्सलाः।\nकामैरनालब्धधियोऽजुषश्च ते नैरपेक्ष्यं हि विदुः सुखं मम॥ ११/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.019.m4a", "display_order": 20}, {"id": 6000315020, "chapter_id": 10315, "verse_number": "११-१४-१८", "content_sanskrit": "बाध्यमानोऽपि मद्भक्तो विषयैरजितेन्द्रियः।\nप्रशस्तयाऽपि मद्भक्त्या विषयैर्नाभिभूयते॥ ११/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.020.m4a", "display_order": 21}, {"id": 6000315021, "chapter_id": 10315, "verse_number": "११-१४-१९", "content_sanskrit": "यथाऽग्निः सुसमिद्धार्चिः करोत्येनांसि भस्मसात्।\nतथा मद्विषया भक्तिरुद्धवैनांसि कृत्स्नशः॥ ११/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.021.m4a", "display_order": 22}, {"id": 6000315022, "chapter_id": 10315, "verse_number": "११-१४-२०", "content_sanskrit": "न साधयति मां योगो न साङ्ख्यं धर्म उद्धव।\nन स्वाध्यायस्तपस्त्यागो यथा भक्तिर्ममोर्जिता॥ ११/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.022.m4a", "display_order": 23}, {"id": 6000315023, "chapter_id": 10315, "verse_number": "११-१४-२१", "content_sanskrit": "भक्त्याऽहमेकया ग्राह्यः श्रद्धयाऽऽत्मा प्रियः सताम्।\nभक्तिः पुनाति मन्निष्ठा सकामानपि सम्भवात्॥ ११/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.023.m4a", "display_order": 24}, {"id": 6000315024, "chapter_id": 10315, "verse_number": "११-१४-२२", "content_sanskrit": "धर्मः सत्यदयोपेतो विद्या वा तपसाऽन्विता।\nमद्भक्त्यपेतमात्मानं न सम्यक् प्रपुनाति हि॥ ११/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.024.m4a", "display_order": 25}, {"id": 6000315025, "chapter_id": 10315, "verse_number": "११-१४-२३", "content_sanskrit": "कथं विना रोमहर्षं द्रवता चेतसा विना।\nविनाऽऽनन्दाश्रुकलया शुद्ध्येद् भक्त्या विनेश्वरः॥ ११/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.025.m4a", "display_order": 26}, {"id": 6000315026, "chapter_id": 10315, "verse_number": "११-१४-२४", "content_sanskrit": "वाग्गद्गदा द्रवते यस्य चित्तं रुदत्यभीक्ष्णं हसति क्‍वचिच्च।\nविलज्ज उद्गायति नृत्यते च मद्भक्तियुक्तो भुवनं पुनाति॥ ११/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.026.m4a", "display_order": 27}, {"id": 6000315027, "chapter_id": 10315, "verse_number": "११-१४-२५", "content_sanskrit": "यथाऽग्निना हेम मलं जहाति ध्मातं पुनः स्वं भजते च रूपम्।\nआत्मा च कर्मानुशयं विधूय मद्भक्तियोगेन भजत्यथो माम्॥ ११/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.027.m4a", "display_order": 28}, {"id": 6000315028, "chapter_id": 10315, "verse_number": "११-१४-२६", "content_sanskrit": "यथायथाऽऽत्मा परिमृज्यतेऽसौ मत्पुण्यगाथाश्रवणाभिधानैः।\nतथातथा पश्यति सूक्ष्मतत्वं चक्षुर्यथैवाञ्जनसम्प्रयुक्तम्॥ ११/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.028.m4a", "display_order": 29}, {"id": 6000315029, "chapter_id": 10315, "verse_number": "११-१४-२७", "content_sanskrit": "विषयान् ध्यायतश्चित्तं विषयेषु विषज्जते।\nमामनुस्मरतश्चित्तं मय्येव प्रविलीयते॥ ११/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.029.m4a", "display_order": 30}, {"id": 6000315030, "chapter_id": 10315, "verse_number": "११-१४-२८", "content_sanskrit": "तस्मादसदभिध्यानं यथा स्वप्नमनोरथम्।\nहित्वा मयि समाधत्स्व मनो मद्भावभावितम्॥ ११/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.030.m4a", "display_order": 31}, {"id": 6000315031, "chapter_id": 10315, "verse_number": "११-१४-२९", "content_sanskrit": "स्‍त्रीसङ्गसङ्गिनां सङ्गं त्यक्त्वा दूरत आत्मवान्।\nक्षेमे विविक्त आसीनश्चिन्तयेन्मामतन्द्रितः॥ ११/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.031.m4a", "display_order": 32}, {"id": 6000315032, "chapter_id": 10315, "verse_number": "११-१४-३०", "content_sanskrit": "न तथाऽस्य भवेत् क्लेशो बन्धश्चान्यप्रसङ्गतः।\nयोषित्सङ्गाद् यथा पुंसो यथा तत्सङ्गिसङ्गतः॥ ११/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.032.m4a", "display_order": 33}, {"id": 6000315033, "chapter_id": 10315, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.033.m4a", "display_order": 34}, {"id": 6000315034, "chapter_id": 10315, "verse_number": "११-१४-३१", "content_sanskrit": "यथा त्वामरविन्दाक्ष यादृशं वा यदात्मकम्।\nध्यायेन्मुमुक्षुरेतन्मे ध्यानं त्वं वक्तुमर्हसि॥ ११/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.034.m4a", "display_order": 35, "topics": [{"text": "ध्यानयोगनिरूपणम्", "range": "३१–४६"}]}, {"id": 6000315035, "chapter_id": 10315, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.035.m4a", "display_order": 36}, {"id": 6000315036, "chapter_id": 10315, "verse_number": "११-१४-३२", "content_sanskrit": "सम आसन आसीनः समकायो यथासुखम्।\nहस्तावुत्सङ्ग आधाय स्वनासाग्रकृतेक्षणः॥ ११/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.036.m4a", "display_order": 37}, {"id": 6000315037, "chapter_id": 10315, "verse_number": "११-१४-३३", "content_sanskrit": "प्राणस्य शोधयेन्मार्गं पूरकुम्भकरेचकैः।\nविपर्ययेणापि शनैरभ्यसेन्निर्जितेन्द्रियः॥ ११/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.037.m4a", "display_order": 38}, {"id": 6000315038, "chapter_id": 10315, "verse_number": "११-१४-३४", "content_sanskrit": "हृद्यविच्छिन्नमोङ्कारं घण्टानादं बिसोर्णवत्।\nप्राणेनोदीर्य तत्राथ पुनः संवेशयेत् स्वरम्॥ ११/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.038.m4a", "display_order": 39}, {"id": 6000315039, "chapter_id": 10315, "verse_number": "११-१४-३५", "content_sanskrit": "एवं प्रणवसंयुक्तं प्राणसंयममभ्यसेत्।\nदशकृत्वस्‍त्रिषवणं मासादर्वाग् जितानलः॥ ११/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.039.m4a", "display_order": 40}, {"id": 6000315040, "chapter_id": 10315, "verse_number": "११-१४-३६", "content_sanskrit": "हृत्पुण्डरीकमन्तःस्थमूर्ध्वनालमधोमुखम्।\nध्यात्वोर्ध्वमुखमुन्निद्रमष्टपत्रं सकर्णिकम्॥ ११/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.040.m4a", "display_order": 41}, {"id": 6000315041, "chapter_id": 10315, "verse_number": "११-१४-३७", "content_sanskrit": "कर्णिकायां न्यसेत् सूर्यसोमाग्नीनुत्तरोत्तरम्।\nवह्निमध्ये स्मरेद् रूपं ममैतद् ध्यानमङ्गलम्॥ ११/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.041.m4a", "display_order": 42}, {"id": 6000315042, "chapter_id": 10315, "verse_number": "११-१४-३८", "content_sanskrit": "समं प्रशान्तं सुमुखं दीर्घचारुचतुर्भुजम्।\nसुचारुसुन्दरग्रीवं सुकपोलं शुचिस्मितम्॥ ११/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.042.m4a", "display_order": 43}, {"id": 6000315043, "chapter_id": 10315, "verse_number": "११-१४-३९", "content_sanskrit": "समानकर्णविन्यस्तस्फुरन्मकरकुण्डलम्।\nहेमाम्बरं घनश्यामं श्रीवत्सं श्रीनिकेतनम्॥ ११/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.043.m4a", "display_order": 44}, {"id": 6000315044, "chapter_id": 10315, "verse_number": "११-१४-४०", "content_sanskrit": "शङ्खचक्रगदापद्मवनमालाविभूषितम्।\nनूपुरैर्विलसत्पादं कौस्तुभप्रभया युतम्॥ ११/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.044.m4a", "display_order": 45}, {"id": 6000315045, "chapter_id": 10315, "verse_number": "११-१४-४१", "content_sanskrit": "द्युमत्कीरीटकटककटिसूत्राङ्गदैर्युतम्। सर्वाङ्गसुन्दरं हृद्यं प्रसादसुमुखेक्षणम्।\nसुकुमारमभिध्यायेत् सर्वाङ्गेषु मनो दधत्॥ ११/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.045.m4a", "display_order": 46}, {"id": 6000315046, "chapter_id": 10315, "verse_number": "११-१४-४२", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थेभ्यो मनसाऽऽकृष्य तन्मनाः।\nबुद्ध्या सारथिना धीरः प्रणमेन्मयि सर्वतः॥ ११/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.046.m4a", "display_order": 47}, {"id": 6000315047, "chapter_id": 10315, "verse_number": "११-१४-४३", "content_sanskrit": "तत् सर्वं व्यापकं चित्तमाकृष्यैकत्र धारयेत्।\nनान्यानि चिन्तयेद् भूयः सुस्मितं भावयेन्मुखम्॥ ११/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.047.m4a", "display_order": 48}, {"id": 6000315048, "chapter_id": 10315, "verse_number": "११-१४-४४", "content_sanskrit": "तत्र लब्धपदं चित्तमाकृष्य व्योम्नि धारयेत्।\nतच्च त्यक्त्वा मदारोहो न किञ्चिदपि चिन्तयेत्॥ ११/१४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.048.m4a", "display_order": 49}, {"id": 6000315049, "chapter_id": 10315, "verse_number": "११-१४-४५", "content_sanskrit": "एवं समाहितमतिर्मामेवात्मानमात्मनि।\nविचष्टे मयि सर्वात्मन् ज्योतिर्ज्योतिषि संयुतम्॥ ११/१४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.049.m4a", "display_order": 50}, {"id": 6000315050, "chapter_id": 10315, "verse_number": "११-१४-४६", "content_sanskrit": "ध्यानेनेत्थं सुतीव्रेण युञ्जतो योगिनो मनः।\nसंयास्यत्याशु निर्वाणं द्रव्यज्ञानक्रियाभ्रमः॥ ११/१४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_014/BhP_11.014.050.m4a", "display_order": 51}, {"id": 6000315051, "chapter_id": 10315, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे चतुर्दशाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]