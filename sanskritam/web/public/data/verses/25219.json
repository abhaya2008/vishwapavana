[{"id": 7005219000, "chapter_id": 25219, "verse_number": "७-३-१७-१", "content_sanskrit": "पुलस्त्य उवाच ।\nपंगु तीर्थं ततो गच्छेत्सर्वपातकनाशनम् ।\nयत्र पूर्वं तपस्तप्तं पंगुना ब्राह्मणेन च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005219001, "chapter_id": 25219, "verse_number": "७-३-१७-२", "content_sanskrit": "पंगुनामा द्विजः पूर्वं च्यवनस्यान्वयेऽभवत् ।\nअशक्तश्चलितुं भूमौ पंगुभावान्नृपोत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005219002, "chapter_id": 25219, "verse_number": "७-३-१७-३", "content_sanskrit": "गृहकृत्यनियुक्तोऽसावेकदा बान्धवैर्नृप ।\nपंगुर्गंतुं न शक्तोऽसौ परं दुःखमवाप्तवान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005219003, "chapter_id": 25219, "verse_number": "७-३-१७-४", "content_sanskrit": "अथासौ तैः परित्यक्तो गत्वार्बुदमथाचलम् ।\nएकं सरः समासाद्य तपस्तेपे सुदारुणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005219004, "chapter_id": 25219, "verse_number": "७-३-१७-५", "content_sanskrit": "लिंगं संस्थाप्य तत्रैव पूजयामास तं विभुम् ।\nगन्धपुष्पादिनैवेद्यैः सम्यक्छ्रद्धासमन्वितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005219005, "chapter_id": 25219, "verse_number": "७-३-१७-६", "content_sanskrit": "शिवभक्तिपरो जातो वायुभक्षो बभूव ह ।\nजपहोमरतो नित्यं पंगुनामा द्विजोत्तमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005219006, "chapter_id": 25219, "verse_number": "७-३-१७-७", "content_sanskrit": "ततस्तुष्टो महादेवो ब्राह्मणं नृपसत्तम ।\nपंगुं प्रति महाराज वाक्यमेतदुवाच ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005219007, "chapter_id": 25219, "verse_number": "७-३-१७-८", "content_sanskrit": "ईश्वर उवाच ।\nपंगो तुष्टो महादेवो वरं वरय सुव्रत ।\nतव दास्याम्यहं सर्वं यद्यपि स्यात्सुदुर्लभम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005219008, "chapter_id": 25219, "verse_number": "७-३-१७-९", "content_sanskrit": "पंगुरुवाच ।\nनाम्ना मे ख्यातिमायातु तीर्थमेतत्सुरेश्वर ।\nपंगुभावोऽत्र मे यातु प्रसादात्तव शंकर ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005219009, "chapter_id": 25219, "verse_number": "७-३-१७-१०", "content_sanskrit": "तवास्तु सततं चात्र सांनिध्यं सह भार्यया ।\nएवमुक्तः स तेनाथ विप्रं प्रति वचोब्रवीत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005219010, "chapter_id": 25219, "verse_number": "७-३-१७-११", "content_sanskrit": "ईश्वर उवाच ।\nनाम्ना तव द्विजश्रेष्ठ तीर्थमेतद्भविष्यति ।\nख्यातिं तपःप्रभावेन तीर्थं यास्यति सत्तम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005219011, "chapter_id": 25219, "verse_number": "७-३-१७-१२", "content_sanskrit": "चैत्रशुक्लचतुर्द्दश्यां सांनिध्यं मे भवेत्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005219012, "chapter_id": 25219, "verse_number": "७-३-१७-१३", "content_sanskrit": "पुलस्त्य उवाच ।\nस्नानमात्रेण विप्रोऽसौ दिव्यरूपमवाप ह ।\nतत्र तस्थौ महादेवो गौर्या सह महेश्वरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005219013, "chapter_id": 25219, "verse_number": "७-३-१७-१४", "content_sanskrit": "तस्मिन्दिने नृपश्रेष्ठ स्नानं तत्र समाचरेत् ।\nस पंगुत्वाद्विनिर्मुक्तो दिव्यरूपमवाप्नुयात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005219014, "chapter_id": 25219, "verse_number": "७-३-१७-१५", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीति साहस्र्यां संहितायां सप्तमे प्रभासखण्डे तृतीयेऽर्बुदखण्डे पंगुतीर्थमाहात्म्यवर्णनंनाम सप्तदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]