[{"id": 2120844, "chapter_id": 3588, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120845, "chapter_id": 3588, "verse_number": "१", "content_sanskrit": "रक्षणाद् धर्मराजस्य सत्यस्य परिपालनात् ।\nशत्रूणां क्षपणाच्चैव स्वकर्मनिरताः प्रजाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120846, "chapter_id": 3588, "verse_number": "२", "content_sanskrit": "बलीनां सम्यगादानाद् धर्मतश्चानुशासनात् ।\nनिकामवर्षी पर्जन्यः स्फीतो जनपदोऽभवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120847, "chapter_id": 3588, "verse_number": "३", "content_sanskrit": "सर्वारम्भाः सम्प्रवृत्ता नीरुजो निरुपद्रवाः ।\nस्वादुसस्या च पृथिवी बहुपुष्पफला द्रुमाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120848, "chapter_id": 3588, "verse_number": "४", "content_sanskrit": "ब्राह्मणा यज्ञसन्तानाः कृषिगोरक्षणं वणिक् ।\nविशेषोत्सवमेवैतत् सञ्जज्ञे राजकर्मणा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120849, "chapter_id": 3588, "verse_number": "५", "content_sanskrit": "दस्युभ्यो वञ्चकेभ्यो वा प्रतिरोधात् परस्परम् ।\nराजवल्लभतश्चैव श्रूयते न मृषा गिरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120850, "chapter_id": 3588, "verse_number": "६", "content_sanskrit": "अवर्षं चातिवर्षं च व्याधिपावकमूर्च्छनम् ।\nसर्वमेतत् तदा नासीद् धर्मनित्ये युधिष्ठिरे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120851, "chapter_id": 3588, "verse_number": "७", "content_sanskrit": "मनस्तुष्टिं परां गच्छेद् इत्येवं मनसा नराः ।\nसर्वात्मना प्रियाण्येव कर्तुं समुपचक्रमुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120852, "chapter_id": 3588, "verse_number": "८", "content_sanskrit": "धर्म्यैर्धनागमैस्तस्य ववृधे निचयो महान् ।\nकर्तुं यस्य न शक्येत क्षयो वर्षशतैरपि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120853, "chapter_id": 3588, "verse_number": "९", "content_sanskrit": "कोशस्य स परीमाणं गोष्ठस्य च महीपतिः ।\nविज्ञाय राजन् कौन्तेयो यज्ञायैव मनो दधे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120854, "chapter_id": 3588, "verse_number": "१०", "content_sanskrit": "सुहृदश्चैव तं सर्वे पृथक्च सह चाब्रुवन् ।\nयज्ञकालस्तव विभो क्रियतामत्र साम्प्रतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120855, "chapter_id": 3588, "verse_number": "११", "content_sanskrit": "अथैवं ब्रुवतामेव तेषामभ्याययौ हरिः ।\nऋषिः पुराणो वेदात्मा दृश्यश्चात्मनि जानताम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120856, "chapter_id": 3588, "verse_number": "१२", "content_sanskrit": "जगतस्तस्थुषां श्रेष्ठः प्रभवश्चाप्ययश्च ह ।\nभूतभव्यभवन्नाथः केशवः केशिसूदनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120857, "chapter_id": 3588, "verse_number": "१३", "content_sanskrit": "प्राकारः सर्ववृष्णीनामापत्स्वभयदो गिरिः ।\nबलाधिकारे निक्षिप्य सम्मान्यानकदुन्दुभिम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120858, "chapter_id": 3588, "verse_number": "१४", "content_sanskrit": "उच्चावचमुपादाय धर्मराजाय माधवः ।\nधनौघं पुरुषव्याघ्रो बलेन महता वृतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120859, "chapter_id": 3588, "verse_number": "", "content_sanskrit": "तं धनौघमपर्यन्तं रत्नसागरमक्षयम् ।\nपूर्णमापूरयंस्तेषां द्विषच्छोकावहोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120860, "chapter_id": 3588, "verse_number": "१५", "content_sanskrit": "नादयन् रथघोषेण प्रविवेश पुरोत्तमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120861, "chapter_id": 3588, "verse_number": "१६", "content_sanskrit": "असूर्यमिव सूर्येण निवातमिव वायुना ।\nकृष्णेन समुपेतेन जहृषे भारतं पुरम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120862, "chapter_id": 3588, "verse_number": "१७", "content_sanskrit": "तं मुदाऽभिसमागम्य सत्कृत्य च यथाविधि ।\nस पृष्ट्वा कुशलं चैव सुखासीनं युधिष्ठिरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120863, "chapter_id": 3588, "verse_number": "१८", "content_sanskrit": "धौम्यद्वैपायनमुखैः ऋत्विग्भिः पुरुषर्षभः ।\nभीमार्जुनयमैश्चापि सहितः कृष्णमब्रवीत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120864, "chapter_id": 3588, "verse_number": "१९", "content_sanskrit": "त्वत्कृते पृथिवी सर्वा मद्वशे कृष्ण वर्तते ।\nधनं च बहु वार्ष्णेय त्वत्प्रसादादुपार्जितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120865, "chapter_id": 3588, "verse_number": "२०", "content_sanskrit": "सोऽहमिच्छामि तत् सर्वं विधिवद् देवकीसुत ।\nउपयोक्तुं द्विजाग्र्येषु हव्यवाहे च माधव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120866, "chapter_id": 3588, "verse_number": "२१", "content_sanskrit": "तदहं यष्टुमिच्छामि दाशार्ह सहितस्त्वया ।\nअनुजैश्च महाबाहो त्वमनुज्ञातुमर्हसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120867, "chapter_id": 3588, "verse_number": "२२", "content_sanskrit": "स दीक्षापय गोविन्द त्वमात्मानं महाभुज ।\nत्वयीष्टवति दाशार्ह विपाप्मा भविता ह्यहम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120868, "chapter_id": 3588, "verse_number": "२३", "content_sanskrit": "त्वं मामभ्यनुजानीहि सहैभिरनुजैर्विभो ।\nअनुज्ञातस्त्वया कृष्ण प्राप्नुयां क्रतुमुत्तमम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120869, "chapter_id": 3588, "verse_number": "२४", "content_sanskrit": "तं कृष्णः प्रत्युवाचेदं बहूक्त्वा गुणविस्तरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120870, "chapter_id": 3588, "verse_number": "२५", "content_sanskrit": "त्वमेव राजशार्दूल सम्राडर्हो महाक्रतुम् ।\nसम्प्राप्नुहि त्वया प्राप्ते कृतकृत्यास्ततो वयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120871, "chapter_id": 3588, "verse_number": "२६", "content_sanskrit": "यजस्वाभीप्सितं यज्ञं मयि श्रेयस्यवस्थिते ।\nनियुङ्क्ष्व चापि मां कृत्ये सर्वं कर्तास्मि ते वचः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120872, "chapter_id": 3588, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120873, "chapter_id": 3588, "verse_number": "२७", "content_sanskrit": "सफलः कृष्ण सङ्कल्पः सिद्धिश्च नियता मम ।\nयन्मम त्वं हृषीकेश यथेप्सितमवस्थितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120874, "chapter_id": 3588, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120875, "chapter_id": 3588, "verse_number": "२८", "content_sanskrit": "अनुज्ञातस्तु कृष्णेन पाण्डवो भ्रातृभिः सह ।\nईजितुं राजसूयाय साधनान्युपचक्रमे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120876, "chapter_id": 3588, "verse_number": "२९", "content_sanskrit": "तत आज्ञापयामास पाण्डवोऽरिनिबर्हणः ।\nसहदेवं युधां श्रेष्ठं मन्त्रिणश्चैव सर्वशः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120877, "chapter_id": 3588, "verse_number": "३०", "content_sanskrit": "अस्मिन् क्रतौ यथोक्तानि यज्ञाङ्गानि द्विजातिभिः ।\nतथोपकरणं सर्वं मङ्गलानि च सर्वशः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120878, "chapter_id": 3588, "verse_number": "३१", "content_sanskrit": "अधियज्ञार्थसम्भारान् धौम्योक्तान् क्षिप्रमेव हि ।\nसमानयन्तु पुरुषा यथायोगं यथाक्रमम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120879, "chapter_id": 3588, "verse_number": "", "content_sanskrit": "इन्द्रसेनो विशोकश्च रुग्मश्चार्जुनसारथिः ।\nशमीको ध्वजसेनश्च पञ्च सारथिपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120880, "chapter_id": 3588, "verse_number": "३२", "content_sanskrit": "अन्नाद्याहरणे युक्ताः सन्तु मत्प्रियकाम्यया\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120881, "chapter_id": 3588, "verse_number": "३३", "content_sanskrit": "सर्वे पेयांश्च भक्ष्यांश्च रसं गन्धसमन्वितान् ।\nमनोहरान् प्रीतिकरान् द्विजानां कुरुसत्तम\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120882, "chapter_id": 3588, "verse_number": "३४", "content_sanskrit": "तद्वाक्यसमकालं तु सर्वं कृतमवेदयत् ।\nसहदेवो युधां श्रेष्ठो धर्मराजे महात्मने\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120883, "chapter_id": 3588, "verse_number": "३५", "content_sanskrit": "ततो द्वैपायनो राजन् ऋत्विजः समुपानयत् ।\nवेदानिव महाभागान् साक्षान्मूर्तिमतो द्विजान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120884, "chapter_id": 3588, "verse_number": "३६", "content_sanskrit": "मूर्तिमान् सामवेदोऽथ वेदवेदाङ्गपारगः ।\nधनञ्जयानामृषभः सुसामा सामगोऽभवत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120885, "chapter_id": 3588, "verse_number": "३७", "content_sanskrit": "याज्ञवल्क्यो बभूवास्य ब्रह्मिष्ठोऽध्वर्युसत्तमः ।\nपैलो होता वसोः पुत्रो रैभ्यो ब्रह्माऽथ सत्तमः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120886, "chapter_id": 3588, "verse_number": "३८", "content_sanskrit": "एतेषां शिष्यवर्गाश्च पुत्राश्च भरतर्षभ ।\nबभूवुर्ऋत्विजः सर्वे वेदवेदाङ्गपारगाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120887, "chapter_id": 3588, "verse_number": "३९", "content_sanskrit": "स्वयं च भगवान् व्यासः शिष्यैः सर्वैः पुरस्कृतः ।\nकृष्णद्वैपायनो राजन् सादस्यमकरोत् प्रभुः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120888, "chapter_id": 3588, "verse_number": "४०", "content_sanskrit": "ते पूजयित्वा पुण्याहमीरयित्वा महाव्रताः ।\nशास्त्रोक्तं मापयामासुः तद् देवयजनं महत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120889, "chapter_id": 3588, "verse_number": "४१", "content_sanskrit": "ततश्चक्रुरनाज्ञाताः शरणान्यथ शिल्पिनः ।\nरत्नवन्ति विशालानि वेश्मानीव दिवौकसाम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120890, "chapter_id": 3588, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि त्रिंशोऽध्यायः ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120891, "chapter_id": 3588, "verse_number": "१", "content_sanskrit": "राजसूयपर्वणि प्रथमोऽध्यायः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120892, "chapter_id": 3588, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]