[{"id": 2050306, "chapter_id": 2102, "verse_number": "७-२९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050307, "chapter_id": 2102, "verse_number": "७-२९-१", "content_sanskrit": "तथा क्रुद्धः किमकरोद्भगदत्तस्य पाण्डवः।\nप्राग्ज्योतिषो वा पार्थस्य तन्मे शंस यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050308, "chapter_id": 2102, "verse_number": "७-२९-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050309, "chapter_id": 2102, "verse_number": "७-२९-२", "content_sanskrit": "प्राग्ज्योतिषेण संसक्तावुभौ दाशार्हपाण्डवौ।\nमृत्युदंष्ट्रान्तिकं प्राप्तौ सर्वभूतानि मेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050310, "chapter_id": 2102, "verse_number": "७-२९-३", "content_sanskrit": "तथा तु शरवर्षाणि पातयत्यनिशं प्रभो।\nगजस्कन्धान्महाराज कृष्णयोः स्यन्दनस्थयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050311, "chapter_id": 2102, "verse_number": "७-२९-४", "content_sanskrit": "अथ कार्ष्णायसैर्बाणैः पूर्णकार्मुकनिःसृतैः।\nअविध्यद्देवकीपुत्रं हेमपुङ्खैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050312, "chapter_id": 2102, "verse_number": "७-२९-५", "content_sanskrit": "अग्निस्पर्शसमास्तीक्ष्णा भगदत्तेन चोदिताः।\nनिर्भिद्य देवकीपुत्रं क्षितिं जग्मुः सुवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050313, "chapter_id": 2102, "verse_number": "७-२९-६", "content_sanskrit": "तस्य पार्थो धनुश्छित्त्वा परिवारं निहत्य च।\nलालयन्निव राजानं भगदत्तमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050314, "chapter_id": 2102, "verse_number": "७-२९-७", "content_sanskrit": "सोऽर्करश्मिनिभांस्तीक्ष्णांस्तोमरान्वै चतुर्दश।\nअप्रेषयत्सव्यसाची द्विधैकैकमथाच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050315, "chapter_id": 2102, "verse_number": "७-२९-८", "content_sanskrit": "ततो नागस्य तद्वर्म व्यधमत्पाकशासनिः।\nशरजालेन महता तद्व्यशीर्यत भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050316, "chapter_id": 2102, "verse_number": "७-२९-९", "content_sanskrit": "शीर्णवर्मा स तु गजः शरैः सुभृशमर्दितः।\nबभौ धारानिपाताक्तो व्यभ्रः पर्वतराडिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050317, "chapter_id": 2102, "verse_number": "७-२९-१०", "content_sanskrit": "ततः प्राग्ज्योतिषः शक्तिं हेमदण्डामयस्मयीम्।\nव्यसृजद्वासुदेवाय द्विधा तामर्जुनोऽच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050318, "chapter_id": 2102, "verse_number": "७-२९-११", "content_sanskrit": "ततश्छत्रं ध्वजं चैव च्छित्त्वा राज्ञोऽर्जुनः शरैः।\nविव्याध दशभिस्तूर्णमुत्स्मयन्पर्वतेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050319, "chapter_id": 2102, "verse_number": "७-२९-१२", "content_sanskrit": "सोऽतिविद्धोऽर्जुनशरैः सुपुङ्खैः कङ्कपत्रिभिः।\nभगदत्तस्ततः क्रुद्धः पाण्डवस्य जनाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050320, "chapter_id": 2102, "verse_number": "७-२९-१३", "content_sanskrit": "व्यसृजत्तोमरान्मूर्ध्नि श्वेताश्वस्योन्नाद च।\nतैरर्जुनस्य समरे किरीटं परिवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050321, "chapter_id": 2102, "verse_number": "७-२९-१४", "content_sanskrit": "परिवृत्तं किरीटं तद्यमयन्नेव पाण्डवः।\nसुदृष्टः क्रियतां लोक इति राजानमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050322, "chapter_id": 2102, "verse_number": "७-२९-१५", "content_sanskrit": "एवमुक्तस्तु सङ्क्रुद्धः शरवर्षेण पाण्डवम्।\nअभ्यवर्षत्स गोविन्दं धनुरादाय भास्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050323, "chapter_id": 2102, "verse_number": "७-२९-१६", "content_sanskrit": "तस्य पार्थो धनुश्छित्त्वा तूणीरान्सन्निकृत्य च।\nत्वरमाणो द्विसप्तत्या सर्वमर्मस्वताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050324, "chapter_id": 2102, "verse_number": "७-२९-१७", "content_sanskrit": "विद्धस्ततोऽतिव्यथितो वैष्णवास्त्रमुदीरयन्।\nअभिमन्त्र्याङ्कुशं क्रुद्धो व्यसृजत्पाण्डवोरसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050325, "chapter_id": 2102, "verse_number": "७-२९-१८", "content_sanskrit": "विसृष्टं भगदत्तेन तदस्त्रं सर्वघाति वै।\nउरसा प्रतिजग्राह पार्थं सञ्छाद्य केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050326, "chapter_id": 2102, "verse_number": "७-२९-१९", "content_sanskrit": "वैजयन्त्यभवन्माला तदस्त्रं केशवोरसि।\nपद्मकोशविचित्रा सा सर्वर्तुकुसुमोत्करा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050327, "chapter_id": 2102, "verse_number": "७-२९-२०", "content_sanskrit": "ज्वलनार्केन्दुवर्णाभा पावकोज्ज्वलपल्लवा।\nतया पद्मपलाशिन्या वातकम्पितपत्रया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050328, "chapter_id": 2102, "verse_number": "७-२९-२१", "content_sanskrit": "शुशुभेऽभ्यधिकं शौरिरतसीपुष्पसन्निभः।\nततोऽर्जुनः क्लान्तमनाः केशवं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050329, "chapter_id": 2102, "verse_number": "७-२९-२२", "content_sanskrit": "अयुध्यमानस्तुरगान्संयन्तास्मि जनार्दन।\nइत्युक्त्वा पुण्डरीकाक्ष प्रतिज्ञां स्वां न रक्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050330, "chapter_id": 2102, "verse_number": "७-२९-२३", "content_sanskrit": "यद्यहं व्यसनी वा स्यामशक्तो वा निवारणे।\nततस्त्वयैवं कार्यं स्यान्न तु कार्यं मयि स्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050331, "chapter_id": 2102, "verse_number": "७-२९-२४", "content_sanskrit": "सबाणः सधनुश्चाहं ससुहासुरमानुषान्।\nशक्तो लोकानिमाञ्जेतुं तच्चापि विदितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050332, "chapter_id": 2102, "verse_number": "७-२९-२५", "content_sanskrit": "ततोऽर्जुनं वासुदेवः प्रत्युवाचार्यवद्वचः।\nशृणु गुह्यमिदं पार्थ पुरावृत्तं यथाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050333, "chapter_id": 2102, "verse_number": "७-२९-२६", "content_sanskrit": "`येयं भूतधरा देवी सर्वभूतधरा धरा।\nसकामा लोककर्तारं नारायणमुपस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050334, "chapter_id": 2102, "verse_number": "७-२९-२७", "content_sanskrit": "स सङ्गत्य तया सार्धं प्रीतस्तस्या वरं ददौ।\nसा वव्रे विष्णुसदृशं पुत्रमस्त्रं च वैष्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050335, "chapter_id": 2102, "verse_number": "७-२९-२८", "content_sanskrit": "बभूव च सुतस्तस्या नरको नाम विश्रुतः।\nअस्त्रं च वैष्णवं तस्मै ददौ नारायणः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2050336, "chapter_id": 2102, "verse_number": "७-२९-२९", "content_sanskrit": "तदेवं नरकस्यासीदस्त्रं सर्वाहितान्तकम्।\nतस्मात्प्राग्ज्योतिषं प्राप्तं सर्वशस्त्रविघातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2050337, "chapter_id": 2102, "verse_number": "७-२९-३०", "content_sanskrit": "नास्यावध्योऽस्ति लोकेऽस्मिन्मदन्यः कश्चिदर्जुन।\nतस्मान्मया कृतं ह्येतन्मा भूत्ते बुद्धिरन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2050338, "chapter_id": 2102, "verse_number": "७-२९-३१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2050339, "chapter_id": 2102, "verse_number": "७-२९-३१", "content_sanskrit": "अनुनीय तु दाशार्हः पाण्डवं त्वरितोऽब्रवीत्।\nजहि प्राग्ज्योतिषं क्षिप्रं वाक्यशेषं च मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2050340, "chapter_id": 2102, "verse_number": "७-२९-३२", "content_sanskrit": "चतुर्मूर्तिरहं शश्वल्लोकत्राणार्थमुद्यतः।\nआत्मानं प्रविभज्येह लोकानां हितमादधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2050341, "chapter_id": 2102, "verse_number": "७-२९-३३", "content_sanskrit": "एका मूर्तिस्तपश्चर्यां कुरुते मे भुवि स्थिता।\nअपरा पश्यति जगत्कुर्वाणं साध्वसाधुनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2050342, "chapter_id": 2102, "verse_number": "७-२९-३४", "content_sanskrit": "अपरा कुरुते कर्म मानुषं लोकमाश्रिता।\nशेते चतुर्थीं त्वपरा निद्रां वर्षसहस्रिकीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2050343, "chapter_id": 2102, "verse_number": "७-२९-३५", "content_sanskrit": "याऽसौ वर्षसहस्रान्ते मूर्तिरुत्तिष्ठते मम।\nवरार्हेभ्यो वराञ्श्रेष्ठांस्तस्मिन्काले ददाति सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2050344, "chapter_id": 2102, "verse_number": "७-२९-३६", "content_sanskrit": "तं तु कालमनुप्राप्तं विदित्वा पृथिवी तदा।\nअयाचत वरं यन्मां नरकार्थाय तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2050345, "chapter_id": 2102, "verse_number": "७-२९-३७", "content_sanskrit": "देवानां दानवानां च अवध्यस्तनयोऽस्तु मे।\nउपेतो वैष्णवास्त्रेण तन्मे त्वं दातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2050346, "chapter_id": 2102, "verse_number": "७-२९-३८", "content_sanskrit": "एवं वरमहं श्रुत्वा जगत्यास्तनये तदा।\nअमोघमस्त्रं प्रायच्छं वैष्णवं परमं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2050347, "chapter_id": 2102, "verse_number": "७-२९-३९", "content_sanskrit": "अवोचं चैतदस्त्रं वै ह्यमोघं भवतु क्षमे।\nनरकस्याभिरक्षार्थं नैनं कश्चिद्वधिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2050348, "chapter_id": 2102, "verse_number": "७-२९-४०", "content_sanskrit": "अनेनास्त्रेण ते गुप्तः सुतः परबलार्दनः।\nभविष्यति दुराधर्षः सर्वलोकेषु सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2050349, "chapter_id": 2102, "verse_number": "७-२९-४१", "content_sanskrit": "तथेत्युक्त्वा गता देवी कृतकामा मनस्विनी।\nस चाप्यासीद्दुराधर्षो नरकः शत्रुतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2050350, "chapter_id": 2102, "verse_number": "७-२९-४२", "content_sanskrit": "तस्मात्प्राग्ज्योतिषं प्राप्तं तदस्त्रं पार्थ मामकम्।\nनास्यावध्योऽस्ति लोकेषु सेन्द्ररुद्रेषु मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2050351, "chapter_id": 2102, "verse_number": "७-२९-४३", "content_sanskrit": "तन्मया त्वत्कृते चैतदन्यथैवोपनिर्मितम्।\nवियुक्तं परमास्त्रेण जहि पार्थ महासुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2050352, "chapter_id": 2102, "verse_number": "७-२९-४४", "content_sanskrit": "`अवध्योऽयं महास्त्रेण भगदत्तः सुरासुरैः।\nवैरिणं जहि दुर्धर्षं भगदत्तं सुरद्विषम्।\nयथाऽहं जघ्निवान्पूर्वं हितार्थं नरकं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2050353, "chapter_id": 2102, "verse_number": "७-२९-४५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2050354, "chapter_id": 2102, "verse_number": "७-२९-४५", "content_sanskrit": "एवमुक्तस्तदा पार्थः केशवेन महात्मना।\nभगदत्तं शितैर्बाणैः सहसा समवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2050355, "chapter_id": 2102, "verse_number": "७-२९-४६", "content_sanskrit": "ततः पार्थो महाबाहुरसम्भ्रान्तो महामनाः।\nकुम्भयोरन्तरे नागं नाराचेन समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2050356, "chapter_id": 2102, "verse_number": "७-२९-४७", "content_sanskrit": "स समासाद्य तं नागं बाणो वज्र इवाचलम्।\nअभ्यगात्सह पुङ्खेन वल्मीकमिव पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2050357, "chapter_id": 2102, "verse_number": "७-२९-४८", "content_sanskrit": "स करी भगदत्तेन प्रेर्यमाणो मुहुर्मुहुः।\nन करोति वचस्तस्य दरिद्रस्येव योषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2050358, "chapter_id": 2102, "verse_number": "७-२९-४९", "content_sanskrit": "स तु विष्टभ्य गात्राणि दन्ताभ्यामवनिं ययौ।\nनदन्नार्तस्वनं प्राणानुत्ससर्ज महाद्विपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2050359, "chapter_id": 2102, "verse_number": "७-२९-५०", "content_sanskrit": "ततो गाण्डीवधन्वानमभ्यभाषत केशवः।\nअयं महत्तरः पार्थ पलितेन समावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2050360, "chapter_id": 2102, "verse_number": "७-२९-५१", "content_sanskrit": "वलीसञ्छन्ननयनः शूरः परमद्रुर्जयः।\nअक्ष्णोरुन्मीलनार्थाय बद्धपट्टो ह्यसौ नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2050361, "chapter_id": 2102, "verse_number": "७-२९-५२", "content_sanskrit": "देववाक्यात्प्रचिच्छेद शरेण भृशमर्जुनः।\nछिन्नमात्रेंऽशुके तस्मिन्रुद्धनेत्रो बभूव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2050362, "chapter_id": 2102, "verse_number": "७-२९-५३", "content_sanskrit": "तमोमयं जगन्मेने भगदत्तः प्रतापवान्।\nततश्चन्द्रार्धबिम्बेन बाणेन नतपर्वणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2050363, "chapter_id": 2102, "verse_number": "७-२९-५४", "content_sanskrit": "बिभेद हृदयं राज्ञो भगदत्तस्य पाण्डवः।\nस भिन्नहृदयो राजा भगदत्तः किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2050364, "chapter_id": 2102, "verse_number": "७-२९-५५", "content_sanskrit": "शरासनं शरांश्चैव गतासुः प्रमुमोच ह।\nशिरसस्तस्य विभ्रष्टं पपात च वरांशुकम्।\nनालताडनविभ्रष्टं पलाशं नलिनादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2050365, "chapter_id": 2102, "verse_number": "७-२९-५६", "content_sanskrit": "स हेममाली तपनीयभाण्डा\nत्पपात नागाद्गिरिसन्निकाशात्।\nसुपुष्पितो मारुतवेगभग्नो\nमहीधराग्रादिव कर्णिकारः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2050366, "chapter_id": 2102, "verse_number": "७-२९-५७", "content_sanskrit": "निहत्य तं नरपतिमिन्द्रविक्रमं\nसस्वायमिन्द्रस्य तदैन्द्रिराहवे।\nततोऽपरांस्तव जयकाङ्क्षिणो नरान्\nबभञ्ज वायुर्बलवान्द्रुमानिव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2050367, "chapter_id": 2102, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि संशप्तकवधपर्वणि द्वादशदिवसयुद्धे एकोनत्रिंशोऽध्यायः॥ २९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-२९-३३ एका मूर्तिर्बदरिकाश्रमे नारायणरूपा। अषरा परमात्मरूपा ॥ ५-२९-३४ अपरा रामकृष्णादिरूपा। अपरा जलशायिनी॥ ५-२९-४८ योषिता भागुरिमते टाप्॥ ५-२९-२९ एकोनत्रिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]