[{"id": 2165445, "chapter_id": 4563, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2165446, "chapter_id": 4563, "verse_number": "", "content_sanskrit": "एकवीरवधेऽमोघा शक्तिः सूतात्मजे यदा ।\nकस्मात् सर्वान् समुत्सृज्य स तां पार्थे न मुक्तवान्\t॥१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2165447, "chapter_id": 4563, "verse_number": "२", "content_sanskrit": "तस्मिन् हते हता हि स्युः सर्वे पाण्डवसृञ्जयाः ।\nएकवीरवधे कस्मान्न युद्धे जयमादधत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2165448, "chapter_id": 4563, "verse_number": "३", "content_sanskrit": "आहूतो न निवर्तेयमिति तस्य महाव्रतम् ।\nस्वयमाह्वयितव्यः स सूतपुत्रेण फल्गुनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2165449, "chapter_id": 4563, "verse_number": "४", "content_sanskrit": "ततो द्वैरथमानीय फल्गुनं शक्रदत्तया ।\nन जघान वृषा कस्मात् तन्ममाचक्ष्व सञ्जय\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2165450, "chapter_id": 4563, "verse_number": "५", "content_sanskrit": "नूनं बुद्धिविहीनश्चाप्यसहायश्च मे सुतः ।\nशत्रुभिर्व्यंसितोपायः कथं नु स जयेदरीन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2165451, "chapter_id": 4563, "verse_number": "६", "content_sanskrit": "या ह्यस्य परमा शक्तिर्जयस्य च परायणम् ।\nसा शक्तिर्वासुदेवेन व्यंसिता च घटोत्कचे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2165452, "chapter_id": 4563, "verse_number": "७", "content_sanskrit": "कुणेर्यथा हस्तगतं ह्रियेद् बिल्वं बलीयसा ।\nतथा शक्तिरमोघा सा मोघीभूता घटोत्कचे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2165453, "chapter_id": 4563, "verse_number": "८", "content_sanskrit": "यथा वराहस्य शुनश्च युद्ध्यतो-\nस्तयोरभावे श्वपचस्य लाभः ।\nमन्ये विद्वन् वासुदेवस्य तद्वद्-\nयुद्धे लाभः कर्णहैडिम्बयोर्वै\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2165454, "chapter_id": 4563, "verse_number": "९", "content_sanskrit": "घटोत्कचो यदि हन्याद्धि कर्णं\nपरो लाभः स भवेत् पाण्डवानाम् ।\nवैकर्तनो वा यदि तं निहन्यात्\nतथापि कृत्यं शक्तिनाशात् कृतं स्यात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2165455, "chapter_id": 4563, "verse_number": "समाप्तिः", "content_sanskrit": "इति प्राज्ञः प्रज्ञयैतद् विचार्य\nघटोत्कचं सूतपुत्रेण युद्धे ।\nअयोधयद् वासुदेवो नृसिंहः\nप्रियं कुर्वन् पाण्डवानां हितं च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2165456, "chapter_id": 4563, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2165457, "chapter_id": 4563, "verse_number": "११", "content_sanskrit": "एतच्चिकीर्षितं ज्ञात्वा कर्णे मधुनिहा नृप ।\nनियोजयामास तदा द्वैरथे राक्षसेश्वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2165458, "chapter_id": 4563, "verse_number": "१२", "content_sanskrit": "घटोत्कचं महावीर्यं महाबुद्धिर्जनार्दनः ।\nअमोघाया विघातार्थं राजन् दुर्मन्त्रिते तव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2165459, "chapter_id": 4563, "verse_number": "१३", "content_sanskrit": "तदैव कृतकार्या हि वयं स्याम कुरूद्वह ।\nन रक्षेद् यदि कृष्णस्तं पार्थं कर्णान्महारथात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2165460, "chapter_id": 4563, "verse_number": "१४", "content_sanskrit": "साश्वध्वजरथः सङ्खे धृतराष्ट्र पतेद् भुवि ।\nविना जनार्दनं पार्थो योगानामीश्वरं प्रभुम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2165461, "chapter_id": 4563, "verse_number": "१५", "content_sanskrit": "तैस्तैरुपायैर्बहुभी रक्ष्यमाणः स पार्थिव ।\nजयत्यभिमुखः शत्रून् पार्थः कृष्णेन पालितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2165462, "chapter_id": 4563, "verse_number": "१६", "content_sanskrit": "सविशेषं त्वमोघायाः कृष्णोऽरक्षत पाण्डवम् ।\nहन्यात् क्षिप्ता हि कौन्तेयं शक्तिर्वृक्षमिवाशनिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2165463, "chapter_id": 4563, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2165464, "chapter_id": 4563, "verse_number": "१७", "content_sanskrit": "विरोधी च कुमन्त्री च प्राज्ञमानी ममात्मजः ।\nयस्यैष समतिक्रान्तो वधोपायो जयं प्रति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2165465, "chapter_id": 4563, "verse_number": "१८", "content_sanskrit": "तवापि समतिक्रान्तमेतद् गावल्गणे कथम् ।\nएतमर्थं महाबुद्धे यत् त्वया नावबोधितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2165466, "chapter_id": 4563, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2165467, "chapter_id": 4563, "verse_number": "१९", "content_sanskrit": "दुर्योधनस्य शकुनेर्मम दुःशासनस्य च ।\nरात्रौ रात्रौ भवत्येषा नित्यमेव समर्थना\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2165468, "chapter_id": 4563, "verse_number": "२०", "content_sanskrit": "श्वः सर्वसैन्यानुत्सृज्य जहि कर्ण धनञ्जयम् ।\nप्रेष्यवत् पाण्डुपाञ्चालानुपभोक्ष्यामहे ततः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2165469, "chapter_id": 4563, "verse_number": "२१", "content_sanskrit": "अथ वा निहते पार्थे पाण्डुष्वन्यतमं ततः ।\nस्थापयेद् युधि वार्ष्णेयस्तस्मात्कृष्णो निपात्यताम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2165470, "chapter_id": 4563, "verse_number": "२२", "content_sanskrit": "कृष्णो हि मूलं पाण्डूनां पार्थः स्कन्ध इवोद्गतः ।\nशाखा इवेतरे पार्थाः पाञ्चालाः पत्रसञ्ज्ञिताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2165471, "chapter_id": 4563, "verse_number": "२३", "content_sanskrit": "कृष्णाश्रयाः कृष्णबलाः कृष्णनाथाश्च पाण्डवाः ।\nकृष्णः परायणं चैषां ज्योतिषामिव चन्द्रमाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2165472, "chapter_id": 4563, "verse_number": "२४", "content_sanskrit": "तस्मात्पर्णानि शाखाश्च स्कन्धं चोत्सृज्य सूतज ।\nकृष्णं निकृन्धि पाण्डूनां मूलं सर्वत्र सर्वदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2165473, "chapter_id": 4563, "verse_number": "२५", "content_sanskrit": "हन्याद् यदि हि दाशार्हं कर्णो यादवनन्दनम् ।\nकृत्स्ना वसुमती राजन् वशे ते स्यान्न संशयः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2165474, "chapter_id": 4563, "verse_number": "२६", "content_sanskrit": "यदि हि स निहतः शयीत भूमौ\nयदुकुलपाण्डवनन्दनो महात्मा ।\nननु तव वसुधा नरेन्द्र सर्वा\nसगिरिसमुद्रवना वशं व्रजेत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2165475, "chapter_id": 4563, "verse_number": "२७", "content_sanskrit": "सा तु बुद्धिः कृताप्येवं जाग्रति त्रिदशेश्वरे ।\nअप्रमेये हृषीकेशे युद्धकाले व्यमुह्यत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2165476, "chapter_id": 4563, "verse_number": "२८", "content_sanskrit": "अर्जुनं चापि कौन्तेयं सदा रक्षति केशवः ।\nन ह्येनमैच्छत् प्रमुखे सौतेः स्थापयितुं रणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2165477, "chapter_id": 4563, "verse_number": "२९", "content_sanskrit": "अन्यांश्चास्मै रथोदारानुपास्थापयदच्युतः ।\nअमोघां तां कथं शक्तिं मोघां कुर्यामिति प्रभो\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2165478, "chapter_id": 4563, "verse_number": "३०", "content_sanskrit": "ततः कृष्णं महाबाहुः सात्यकिः सत्यविक्रमः ।\nपप्रच्छ रथशार्दूल कर्णं प्रति महारथम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2165479, "chapter_id": 4563, "verse_number": "३१", "content_sanskrit": "अयं च प्रत्ययः कर्णे शक्त्या चामितविक्रम ।\nकिमर्थं सूतपुत्रेण न मुक्ता फल्गुने तु सा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2165480, "chapter_id": 4563, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2165481, "chapter_id": 4563, "verse_number": "३२", "content_sanskrit": "दुःशासनश्च कर्णश्च शकुनिश्च ससैन्धवः ।\nसततं मन्त्रयन्ति स्म दुर्योधनपुरोगमाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2165482, "chapter_id": 4563, "verse_number": "३३", "content_sanskrit": "कर्ण कर्ण महेष्वास रणेऽमितपराक्रम ।\nनान्यस्य शक्तिरेषा ते मोक्तव्या जयतां वर\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2165483, "chapter_id": 4563, "verse_number": "३४", "content_sanskrit": "ऋते महारथात् पार्थात् कुन्तीपुत्राद्धनञ्जयात् ।\nस हि तेषामतियशा देवानामिव वासवः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2165484, "chapter_id": 4563, "verse_number": "३५", "content_sanskrit": "तस्मिन् विनिहते सर्वे पाण्डवाः सृञ्जयैः सह ।\nभविष्यन्ति गतात्मानः सुरा इव निरग्नयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2165485, "chapter_id": 4563, "verse_number": "३६", "content_sanskrit": "तथेति च प्रतिज्ञातं कर्णेन शिनिपुङ्गव ।\nहृदि नित्यं तु कर्णस्य वधो गाण्डीवधन्वनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2165486, "chapter_id": 4563, "verse_number": "३७", "content_sanskrit": "अहमेव तु राधेयं मोहयामि युधांवर ।\nयतो नावसृजच्छक्तिं पाण्डवे श्वेतवाहने\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2165487, "chapter_id": 4563, "verse_number": "३८", "content_sanskrit": "फल्गुनस्य हि तां मृत्युमवगम्य युयुत्सतः ।\nन निद्रा न च मे हर्षो मनसोऽस्ति युधांवर\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2165488, "chapter_id": 4563, "verse_number": "३९", "content_sanskrit": "घटोत्कचे व्यंसितां तु दृष्ट्वा तां शिनिपुङ्गव ।\nमृत्योरास्यान्तरान्मुक्तं पश्याम्यद्य धनञ्जयम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2165489, "chapter_id": 4563, "verse_number": "४०", "content_sanskrit": "न पिता न च मे माता न यूयं भ्रातरस्तथा ।\nन च प्राणास्तथा रक्ष्या यथा बीभत्सुराहवे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2165490, "chapter_id": 4563, "verse_number": "४१", "content_sanskrit": "त्रैलोक्यराज्याद् यत्किञ्चिद् भवेदन्यत् सुदुर्लभम् ।\nनेच्छेयं सात्वताहं तद् विना पार्थं धनञ्जयम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2165491, "chapter_id": 4563, "verse_number": "४२", "content_sanskrit": "अतः प्रहर्षः सुमहान् युयुधानाद्य मेऽभवत् ।\nमृतं प्रत्यागतमिव दृष्ट्वा पार्थं धनञ्जयम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2165492, "chapter_id": 4563, "verse_number": "४३", "content_sanskrit": "अतश्च प्रहितो युद्धे मया कर्णाय राक्षसः ।\nन ह्यन्यः समरे रात्रौ शक्तः कर्णं प्रबाधितुम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2165493, "chapter_id": 4563, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2165494, "chapter_id": 4563, "verse_number": "समाप्तिः", "content_sanskrit": "इति सात्यकये प्राह तदा देवकिनन्दनः ।\nधनञ्जयहिते युक्तस्तत्प्रिये सततं रतः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2165495, "chapter_id": 4563, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि अष्टषष्ट्यधिकशततमोऽध्यायः ॥ १६८ ॥\nद्रोणवधपर्वणि तृतीयोऽध्यायः ॥ ३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]