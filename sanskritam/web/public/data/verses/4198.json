[{"id": 2147806, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147807, "chapter_id": 4198, "verse_number": "१", "content_sanskrit": "तत्तु वाक्यमनादृत्य सोऽर्थवन्मातृभाषितम् ।\nपुनः प्रतस्थे संरम्भात् सकाशमकृतात्मनाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147808, "chapter_id": 4198, "verse_number": "२", "content_sanskrit": "ततः सभाया निर्गत्य मन्त्रयामास कौरवः ।\nसौबलेन मताक्षेण राज्ञा शकुनिना सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147809, "chapter_id": 4198, "verse_number": "३", "content_sanskrit": "दुर्योधनं धार्तराष्ट्रं कर्णं दुःशासनोऽब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147810, "chapter_id": 4198, "verse_number": "४", "content_sanskrit": "नो चेत् सन्धास्यसे राजन् स्वेन कामेन पाण्डवैः ।\nबद्ध्वैव त्वां प्रदास्यन्ति पाण्डुपुत्राय भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147811, "chapter_id": 4198, "verse_number": "५", "content_sanskrit": "वैकर्तनं त्वां च मां च त्रीनेतान् भरतर्षभ ।\nपाण्डवेभ्यः प्रदास्यन्ति भीष्मद्रौणौ पिता च ते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147812, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147813, "chapter_id": 4198, "verse_number": "६", "content_sanskrit": "दुःशासनस्य तद्वाक्यं निशम्य भरतर्षभ ।\nदुर्योधनो धार्तराष्ट्रो निःश्वस्य प्रहसन्निव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147814, "chapter_id": 4198, "verse_number": "७", "content_sanskrit": "एकान्तमुपसृत्येह मन्त्रं पुनरमन्त्रयत् ।\nसौबलेन मताक्षेण राज्ञा शकुनिना सह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147815, "chapter_id": 4198, "verse_number": "८", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेः सौबलस्य च ।\nदुःशासनचतुर्थानाम् इदमासीद् विचेष्टितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147816, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "दुर्योधनादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147817, "chapter_id": 4198, "verse_number": "९", "content_sanskrit": "पुराऽयमस्मान् गृह्णाति क्षिप्रकारी जनार्दनः ।\nसहितो धृतराष्ट्रेण राज्ञा शान्तनवेन च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147818, "chapter_id": 4198, "verse_number": "१०", "content_sanskrit": "वयमेव निगृह्णीम हृषीकेशं बलादिव ।\nप्रसँह्य पुरुषव्याघ्रमिन्द्रो वैरोचनिं यथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147819, "chapter_id": 4198, "verse_number": "११", "content_sanskrit": "श्रुत्वा गृहीतं वार्ष्णेयं पाण्डवा हतचेतसः ।\nनिरुत्साहा भविष्यन्ति भग्नदंष्ट्रा इवोरगाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147820, "chapter_id": 4198, "verse_number": "१२", "content_sanskrit": "अयं ह्येषां महाबाहुः सर्वेषां शर्म वर्म च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147821, "chapter_id": 4198, "verse_number": "१३", "content_sanskrit": "अस्मिन् गृहीते वार्ष्णेये ऋषभे सर्वसात्वताम् ।\nनिरुद्यमा भविष्यन्ति पाण्डवाः सोमकैः सह\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147822, "chapter_id": 4198, "verse_number": "१४", "content_sanskrit": "तस्माद् वयमिहैवैकं केशवं क्षिप्रकारिणम् ।\nक्रोशतो धृतराष्ट्रस्य बद्ध्वा योत्स्यामहे रिपून्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147823, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147824, "chapter_id": 4198, "verse_number": "१५", "content_sanskrit": "तेषां पापमभिप्रायं पापानां दुष्टचेतसाम् ।\nइङ्गितज्ञः कविः क्षिप्रमन्वबुद्ध्यत सात्यकिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147825, "chapter_id": 4198, "verse_number": "१६", "content_sanskrit": "तदर्थमभिनिष्क्रम्य हार्दिक्येन सहास्थितः ।\nअब्रवीत् कृतवर्माणं क्षिप्रं योजय वाहिनीम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147826, "chapter_id": 4198, "verse_number": "१७", "content_sanskrit": "व्यूढानीकः सभाद्वारमुपतिष्ठस्व दंसितः ।\nयावदाख्याम्यहं चैतत् कृष्णायाक्लिष्टकारिणे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147827, "chapter_id": 4198, "verse_number": "१८", "content_sanskrit": "स प्रविश्य सभां वीरः सिंहो गिरिगुहामिव ।\nआचष्ट तमभिप्रायं केशवाय महात्मने\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147828, "chapter_id": 4198, "verse_number": "१९", "content_sanskrit": "धृतराष्ट्रं ततश्चैव विदुरं चात्मभाविनम् ।\nतेषामेतमभिप्रायमाचचक्षे स्मयन्निव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147829, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "सात्यकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147830, "chapter_id": 4198, "verse_number": "२०", "content_sanskrit": "धर्मादर्थाच्च कामाच्च कर्म साधुविगर्हितम् ।\nमन्दाः कर्तुमिहेच्छन्ति न चावाप्यं कथञ्चन\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147831, "chapter_id": 4198, "verse_number": "२१", "content_sanskrit": "पुरा विकुर्वते मूढाः पापात्मानः समागताः ।\nधर्षिताः काममन्युभ्यां क्रोधलोभवशानुगाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147832, "chapter_id": 4198, "verse_number": "२२", "content_sanskrit": "इमं हि पुण्डरीकाक्षं जिघृक्षन्त्यल्पचेतसः ।\nपटेनाग्निं प्रज्वलितं यथा बाला यथा जडाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147833, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147834, "chapter_id": 4198, "verse_number": "२३", "content_sanskrit": "सात्यकेस्तद्वचःश्रुत्वा विदुरो दीर्घदर्शिवान् ।\nधृतराष्ट्रं महाबाहुमब्रवीत् कुरुसंसदि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147835, "chapter_id": 4198, "verse_number": "२४", "content_sanskrit": "यथा वाराणसी दग्धा साश्वा सरथकुञ्जरा ।\nसानुबन्धस्तु कृष्णेन काशीनामृषभो हतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147836, "chapter_id": 4198, "verse_number": "२५", "content_sanskrit": "तथा नागपुरं दग्ध्वा शङ्खचक्रगदाधरः ।\nस्वयं कालेश्वरो भूत्वा नाशयिष्यति कौरवान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147837, "chapter_id": 4198, "verse_number": "२६", "content_sanskrit": "पारिजातहरं ह्येनमेकं यदुसुखावहम् ।\nनाभ्यवर्तत संरब्धो वृत्रहा वसुभिः सह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147838, "chapter_id": 4198, "verse_number": "२७", "content_sanskrit": "प्राप्य निर्मोचने पाशान् षट्सहस्रांस्तरस्विनः ।\nहृतास्ते वासुदेवेन ह्युपसङ्क्रम्य मौरवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147839, "chapter_id": 4198, "verse_number": "२८", "content_sanskrit": "द्वारमासाद्य सौभस्य विधूय गदया गिरिम् ।\nद्युमत्सेनः सहामात्यः कृष्णेन विनिपातितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147840, "chapter_id": 4198, "verse_number": "२९", "content_sanskrit": "शेषवत्त्वात् कुरूणां च धर्मापेक्षी तथाऽच्युतः ।\nक्षमते पुण्डरीकाक्षः शक्तः सन् पापकर्मणाम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2147841, "chapter_id": 4198, "verse_number": "३०", "content_sanskrit": "एते हि यदि गोविन्दमिच्छन्ति सह राजभिः ।\nअद्यैवातिथयः सर्वे भविष्यन्ति यमस्य ते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2147842, "chapter_id": 4198, "verse_number": "३१", "content_sanskrit": "यथा वायोस्तृणाग्राणि वशं यान्ति बलीयसः ।\nतथा चक्रभृतः सर्वे वशमेष्यन्ति कौरवाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2147843, "chapter_id": 4198, "verse_number": "३२", "content_sanskrit": "राजन् परीतकालस्ते पुत्राः सर्वे परन्तप ।\nअशक्यमयशस्यं च कर्म कर्तुं समुद्यताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2147844, "chapter_id": 4198, "verse_number": "३३", "content_sanskrit": "इमं हि पुण्डरीकाक्षमभिभूय प्रसँह्य च ।\nनिगृहीतुं किलेच्छन्ति सहिता वासवानुजम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2147845, "chapter_id": 4198, "verse_number": "३४", "content_sanskrit": "इमं पुरुषशार्दूलमप्रधृष्यं दुरासदम् ।\nआसाद्य न भविष्यन्ति पतङ्गा इव पावकम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2147846, "chapter_id": 4198, "verse_number": "३५", "content_sanskrit": "एते न शक्ताः सर्वे हि साहसात् कर्तुमुद्यताः ।\nअयमिच्छन् हि तान् सर्वान् युध्यमानान् जनार्दनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2147847, "chapter_id": 4198, "verse_number": "३६", "content_sanskrit": "सिंहो मृगानिव क्रुद्धो गमयेद् यमसादनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2147848, "chapter_id": 4198, "verse_number": "३७", "content_sanskrit": "न त्वयं निन्दितं कर्म कुर्यात् पापं कथञ्चन ।\nन च धर्मादपक्रामेदच्युतः पुरुषोत्तमः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2147849, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2147850, "chapter_id": 4198, "verse_number": "३८", "content_sanskrit": "विदुरेणैवमुक्ते तु केशवो वाक्यमब्रवीत् ।\nधृतराष्ट्रमभिप्रेक्ष्य सुहृदां शृण्वतां मिथः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2147851, "chapter_id": 4198, "verse_number": "३९", "content_sanskrit": "राजन्नेते यदि क्रुद्धा मां निगृह्णीयुरोजसा ।\nएते वा मामहं वैनान् अनुजानीहि पार्थिव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2147852, "chapter_id": 4198, "verse_number": "४०", "content_sanskrit": "एतान् हि सर्वान् संरब्धान् नियन्तुमहमुत्सहे ।\nन त्वहं निन्दितं कर्म कुर्यां पापं कथञ्चन\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2147853, "chapter_id": 4198, "verse_number": "४१", "content_sanskrit": "पाण्डवार्थे हि लुभ्यन्तः स्वार्थाद् भ्रश्यन्ति ते सुताः ।\nएते चेदेवमिच्छन्ति कृतकार्यो युधिष्ठिरः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2147854, "chapter_id": 4198, "verse_number": "४२", "content_sanskrit": "अद्यैव ह्यहमेनांश्च ये चैनाननु भारत ।\nनिगृह्य राज्ये राजानं स्थापयिष्यामि पाण्डवम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2147855, "chapter_id": 4198, "verse_number": "४३", "content_sanskrit": "एष मे निश्चयो राजन् यद्येषोऽस्य विनिश्चयः ।\nनर्दन्तु सहिताः शङ्खाः पणवानकनिस्वनैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2147856, "chapter_id": 4198, "verse_number": "४४", "content_sanskrit": "अनायासेन पार्थानां वर्ततां च शिवं महत् ।\nनिगृह्य राजन् पार्थेभ्यो दद्यां चेत् सुकृतं भवेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2147857, "chapter_id": 4198, "verse_number": "४५", "content_sanskrit": "इदं तु न प्रवर्तेत निन्दितं कर्म भारत ।\nसन्निधौ ते महाराज क्रोधजं पापबुद्धिजम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2147858, "chapter_id": 4198, "verse_number": "४६", "content_sanskrit": "एष दुर्योधनो राजन् यथेच्छति तथाऽस्तु तत् ।\nअहं तु सर्वान् समयान् अनुजानामि ते नृप\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2147859, "chapter_id": 4198, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2147860, "chapter_id": 4198, "verse_number": "४७", "content_sanskrit": "एतच्छ्रुत्वा तु विदुरं धृतराष्ट्रोऽभ्यभाषत\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2147861, "chapter_id": 4198, "verse_number": "४८", "content_sanskrit": "क्षिप्रमानय तं पापं राज्यलुब्धं सुयोधनम् ।\nसहमित्रं सहामात्यं ससोदर्यं सहानुगम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2147862, "chapter_id": 4198, "verse_number": "४९", "content_sanskrit": "शक्नुयां यदि पन्थानमवतारयितुं पुनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2147863, "chapter_id": 4198, "verse_number": "५०", "content_sanskrit": "ततो दुर्योधनं क्षत्ता पुनः प्रावेशयत् सभाम् ।\nअकामं भ्रातृभिः सार्धं राजभिः परिवारितम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2147864, "chapter_id": 4198, "verse_number": "५१", "content_sanskrit": "अथ दुर्योधनं राजा धृतराष्ट्रोऽभ्यभाषत ।\nकर्णदुःशासनाभ्यां च राजभिश्चापि संवृतम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2147865, "chapter_id": 4198, "verse_number": "५२", "content_sanskrit": "नृशंस हतभूयिष्ठ क्षुद्रकर्मसहायवान् ।\nपापैः सहायैः सङ्गत्य निगृहीतुं किलेच्छसि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2147866, "chapter_id": 4198, "verse_number": "५३", "content_sanskrit": "निर्मोचने षट्सहस्राः पाशैर्बद्ध्वा महासुराः ।\nग्रहीतुं नाशकंश्चैनं तं त्वं प्रार्थयसे बलात्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2147867, "chapter_id": 4198, "verse_number": "५४", "content_sanskrit": "प्राग्ज्योतिषगतं शौरिं नरकः सह दानवैः ।\nग्रहीतुं नाशकत् तत्र त्वं तं प्रार्थयसे बलात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2147868, "chapter_id": 4198, "verse_number": "५५", "content_sanskrit": "अनेन हि हता बाल्ये पूतना शिशुना तदा ।\nगोवर्धनो धारितश्च गवार्थे भरतर्षभ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2147869, "chapter_id": 4198, "verse_number": "५६", "content_sanskrit": "अरिष्टो धेनुकश्चैव चाणूरश्च महात्मना ।\nअश्वराजश्च निहतः कंसश्चारिष्टमाचरन्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2147870, "chapter_id": 4198, "verse_number": "५७", "content_sanskrit": "जरासन्धो दन्तवक्रः शिशुपालश्च वीर्यवान् ।\nबाणश्च निहतः सङ्खे राजानश्च निषूदिताः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2147871, "chapter_id": 4198, "verse_number": "५८", "content_sanskrit": "वरुणो निर्जितो राजा पावकश्चामितौजसा ।\nपारिजातं च हरता जितः साक्षाच्छचीपतिः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2147872, "chapter_id": 4198, "verse_number": "५९", "content_sanskrit": "एकार्णवे च स्वपता निहतौ मधुकैटभौ ।\nजन्मान्तरमुपागम्य हयग्रीवस्तथा हयः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2147873, "chapter_id": 4198, "verse_number": "६०", "content_sanskrit": "अयं च कर्ता न क्रियते कारणं चापि पौरुषे ।\nयद्यदिच्छेदयं शौरिः तत्तत् कुर्यादयत्नतः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2147874, "chapter_id": 4198, "verse_number": "६१", "content_sanskrit": "तं न बुध्यसि गोविन्दं घोरविक्रममच्युतम् ।\nआशीविषमिव क्रुद्धं तेजसां राशिमूर्जितम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2147875, "chapter_id": 4198, "verse_number": "६२", "content_sanskrit": "उद्धर्षयन् महाबाहुं कृष्णमक्लिष्टकारिणम् ।\nपतङ्गोऽग्निमिवासाद्य सामात्यो न भविष्यसि\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2147876, "chapter_id": 4198, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनत्रिंशोत्तरशततमोऽध्यायः ॥१२९॥\nभगवद्यानपर्वणि षष्टितमोऽध्यायः ॥६०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]