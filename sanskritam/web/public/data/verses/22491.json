[{"id": 7002491000, "chapter_id": 22491, "verse_number": "१-१५३-१", "content_sanskrit": "सुमन्तुरुवाच ।\nसुमतिश्च रवेर्भक्तः पाण्डवेय महामते ।\nअतस्ते निखिलं वच्मि शृणुष्वैकमना नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002491001, "chapter_id": 22491, "verse_number": "१-१५३-२", "content_sanskrit": "कल्पादौ सृजतो वीर ब्रह्मणो विविधाः प्रजाः ।\nअहंकारो महानासीन्नास्ति लोके मदुत्तमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002491002, "chapter_id": 22491, "verse_number": "१-१५३-३", "content_sanskrit": "तथा पालयतो वीर केशवस्य धरापते ।\nतथा संहरतो जज्ञेऽहङ्कारस्त्र्यम्बकस्य च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002491003, "chapter_id": 22491, "verse_number": "१-१५३-४", "content_sanskrit": "चिंतयन्तोथ ते देवाः केशवश्च नराधिप ।\nमिथस्ते स्पर्धया युक्ताः परस्परविरोधिनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002491004, "chapter_id": 22491, "verse_number": "१-१५३-५", "content_sanskrit": "विवादस्तु महानासीत्कञ्जाम्बुनगौकसाम् ।\nपरस्परं महाबाहो मनसाश्रित्य केवलम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002491005, "chapter_id": 22491, "verse_number": "१-१५३-६", "content_sanskrit": "अहं कर्ता विकर्ताऽहं पालकोऽहं जगत्प्रभुः ।\nइत्याह भगवान्ब्रह्मा कृष्णभीमौ समर्चितौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002491006, "chapter_id": 22491, "verse_number": "१-१५३-७", "content_sanskrit": "तथैत्य शंकरः क्रुद्धः कः शक्तो मदृते भुवि ।\nसंहर्तुं जगदेतद्धि स्रष्टुं पालयितुं तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002491007, "chapter_id": 22491, "verse_number": "१-१५३-८", "content_sanskrit": "नारायणोऽप्येवमेव मनाक् क्रोधसमन्वितः ।\nन वा शक्तो जगत्स्रष्टुं संहर्तुं रक्षितुं तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002491008, "chapter_id": 22491, "verse_number": "१-१५३-९", "content_sanskrit": "एवं तेषां प्रवदतां क्रुद्धानां च परस्परम् ।\nसमाविशत्तदाऽज्ञानं तमो मोहात्मकं विभो ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002491009, "chapter_id": 22491, "verse_number": "१-१५३-१०", "content_sanskrit": "तेन क्रान्तधियः सर्वे न पश्यन्ति परस्परम् ।\nअत्यर्थं मोहमापन्ना न जानन्तीह किञ्चन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002491010, "chapter_id": 22491, "verse_number": "१-१५३-११", "content_sanskrit": "अपश्यन्तो मिथस्ते तु निषण्णाः क्ष्मातले विभो ।\nआरमन्ति हि ये चान्ये ते दिवाकरमास्थिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002491011, "chapter_id": 22491, "verse_number": "१-१५३-१२", "content_sanskrit": "तमसा मोहिताः सर्वे निद्रावत्क्रान्तचेतसः ।\nमनाग्ज्ञानेन चाक्रान्ताः किं कुर्यामेति मोहिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002491012, "chapter_id": 22491, "verse_number": "१-१५३-१३", "content_sanskrit": "अथ भूताधिपो देवो गोश्रुताभरणोज्ज्वलः ।\nचन्द्रार्धकृतशोभस्तु शीतलांशुविशोधितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002491013, "chapter_id": 22491, "verse_number": "१-१५३-१४", "content_sanskrit": "आर्तिमेत्य परां वीर मोहितस्तमसा विभो ।\nअपश्यन्नब्रवीद्देवं माधवं भूधरं हरिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002491014, "chapter_id": 22491, "verse_number": "१-१५३-१५", "content_sanskrit": "महादेव उवाच ।\nकृष्ण कृष्ण महाबाहो क्व गतस्त्वं महामते ।\nब्रह्मा च क्व गतो वीर नाहं पश्यामि वां क्वचित् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002491015, "chapter_id": 22491, "verse_number": "१-१५३-१६", "content_sanskrit": "मोहेन महताहं वै तमसा च विमोहितः ।\nकिं करोमि क्व गच्छामि क्व चाहमधुना स्थितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002491016, "chapter_id": 22491, "verse_number": "१-१५३-१७", "content_sanskrit": "क्ष्माधरं पृथिवीं वृक्षान् देवगन्धर्वदानवान् ।\nविपुलं सागरं सिन्धून्नहि पश्यामि किञ्चन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002491017, "chapter_id": 22491, "verse_number": "१-१५३-१८", "content_sanskrit": "केनोपायेन पश्येयं जगत्स्थावरजङ्गमम् ।\nब्रूहि मे देवशार्दूल व्रीडा मेऽतीव जायते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002491018, "chapter_id": 22491, "verse_number": "१-१५३-१९", "content_sanskrit": "शङ्करस्य वचः श्रुत्वा हरिर्वचनमब्रवीत् ।\nशोकगद्गदया वाचा तमसा मोहितो नृप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002491019, "chapter_id": 22491, "verse_number": "१-१५३-२०", "content_sanskrit": "विष्णुरुवाच ।\nभीम भीम न जानेऽहं क्व भवान्वर्ततेऽधुना ।\nममापि मोहितं चेतस्तमसातीव शङ्कर ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002491020, "chapter_id": 22491, "verse_number": "१-१५३-२१", "content_sanskrit": "क्व गच्छामि क्व तिष्ठामि कथं तत्स्वस्थतां व्रजेत् ।\nतमसा पूरितं सर्वं जगद्धि परमेश्वर ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002491021, "chapter_id": 22491, "verse_number": "१-१५३-२२", "content_sanskrit": "यद्यसौ दृश्यते देवः सुरज्येष्ठोऽम्बुजोद्भवः ।\nपृच्छावस्तं महात्मानं यदि ते रोचते हर ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002491022, "chapter_id": 22491, "verse_number": "१-१५३-२३", "content_sanskrit": "हित्वा दर्पमहङ्कारं सममास्थाय केवलम् ।\nपद्माननं पद्मयोनिं पद्मपत्रनिभेक्षणम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002491023, "chapter_id": 22491, "verse_number": "१-१५३-२४", "content_sanskrit": "इत्येवं गदतो वाक्यं विष्णोरमिततेजसः ।\nश्रुत्वोवाच विभुर्ब्रह्मा गङ्गाधरमहीधरौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002491024, "chapter_id": 22491, "verse_number": "१-१५३-२५", "content_sanskrit": "कृष्ण कृष्ण महाबाहो भीम भीम महामते ।\nक्व भवन्तौ ब्रूत किं च किं युवामूचथुर्मिथः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002491025, "chapter_id": 22491, "verse_number": "१-१५३-२६", "content_sanskrit": "ममातीव मनोबुद्धी तमसा वशमागते ।\nन शृणोमि न पश्यामि निद्रामोहवशं गतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002491026, "chapter_id": 22491, "verse_number": "१-१५३-२७", "content_sanskrit": "अहो बत जगत्सर्वं सदेवासुरमानुषम् ।\nतमसा व्याष्टतं देवौ न जाने क्व गतं महः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002491027, "chapter_id": 22491, "verse_number": "१-१५३-२८", "content_sanskrit": "अथ तेषां प्रवदतां ब्रह्मादीनां दिवौकसाम् ।\nदर्पक्रोधभयार्तानां तमसाक्रान्तचेतसाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002491028, "chapter_id": 22491, "verse_number": "१-१५३-२९", "content_sanskrit": "तेषां दर्पापहाराय प्रबोधार्थं च गोपतेः ।\nतेजोरूपं समुद्भूतमष्टशृङ्गमनौपमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002491029, "chapter_id": 22491, "verse_number": "१-१५३-३०", "content_sanskrit": "अलक्ष्यं पापतमसा महद्व्योम नराधिप ।\nज्वालामालावृतं वीर बहुरूपं च भासते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002491030, "chapter_id": 22491, "verse_number": "१-१५३-३१", "content_sanskrit": "शतयोजनविस्तीर्णं गतमूर्ध्वं भ्रमत्तथा ।\nगोमध्यतो महाराज कर्णिकेवाम्बुजस्य तु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002491031, "chapter_id": 22491, "verse_number": "१-१५३-३२", "content_sanskrit": "प्रकाशं तेजसा तस्य जगत्सर्वमिदं नृप ।\nपुरेष्वन्तर्यथा वीर अम्बुजस्यार्चिभिः सदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002491032, "chapter_id": 22491, "verse_number": "१-१५३-३३", "content_sanskrit": "दृष्ट्वा परस्परं सर्वे हुङ्कारादिविकारिणः ।\nतेजसा मोहितास्तस्य जगत्सर्वमिदं नृप ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002491033, "chapter_id": 22491, "verse_number": "१-१५३-३४", "content_sanskrit": "तेजसा मोहितं तस्य महद्व्योम नराधिप ।\nततो विस्मयमासीनः दृष्टगोपतयो नृप ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002491034, "chapter_id": 22491, "verse_number": "१-१५३-३५", "content_sanskrit": "पश्यमाना महो व्योम्नि मिथो वचनमब्रुवन् ।\nअहो तेजः समुद्धूतमस्माकं श्रेयसे नृप ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002491035, "chapter_id": 22491, "verse_number": "१-१५३-३६", "content_sanskrit": "प्रकाशाय च लोकानां सर्वे पश्याम किं न्विदम् ।\nज्ञानायोर्ध्वं गतो ब्रह्मा चाधस्तात्त्रिपुरान्तक ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002491036, "chapter_id": 22491, "verse_number": "१-१५३-३७", "content_sanskrit": "तिर्यग्जगाम देवेशश्चक्राम्बुजगदाधरः ।\nअलब्ध्वा तस्य ते सर्वे प्रमाणं गैरिकाधिपाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002491037, "chapter_id": 22491, "verse_number": "१-१५३-३८", "content_sanskrit": "विस्मयोत्फुल्लनयना समागम्य परस्परम् ।\nसर्वे कञ्जादिका देवा इदं वचनमब्रुवन् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002491038, "chapter_id": 22491, "verse_number": "१-१५३-३९", "content_sanskrit": "कोऽयं किमात्मकश्चायं किमिदं तेजसां निधिः ।\nअहोऽस्य दर्शनात्सर्वे सञ्जाता ज्ञानिनो वयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002491039, "chapter_id": 22491, "verse_number": "१-१५३-४०", "content_sanskrit": "तस्मात्सर्वे प्रणम्यैनं स्तुवीमोऽद्भुतदर्शनम् ।\nकृताञ्जलिपुटाः सर्वे चास्तुवंस्त्रिदिवौकसः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002491040, "chapter_id": 22491, "verse_number": "१-१५३-४१", "content_sanskrit": "स्तुवतामप्यथैतेषां सहस्रकिरणो रविः ।\nआत्मानं दर्शयामास कृपया परया वृतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002491041, "chapter_id": 22491, "verse_number": "१-१५३-४२", "content_sanskrit": "ज्ञात्वा भक्तिं महाबाहो ब्रह्मादीनां महोपमाम् ।\nअथ ते व्योम्नि देवेशं ददृशुः परमेश्वरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002491042, "chapter_id": 22491, "verse_number": "१-१५३-४३", "content_sanskrit": "खषोल्कलोकनाथेशं सहस्रकिरणोज्ज्वलम् ।\nकृत्तिकाभिरसंस्पृष्टं यद्वा तत्कार्तिकास्थितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002491043, "chapter_id": 22491, "verse_number": "१-१५३-४४", "content_sanskrit": "दुर्जयं कृत्तिकानां तु तथैकेन विवर्जितम् ।\nतथा हस्तविहीनं च सप्तर्षिरहितं तथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002491044, "chapter_id": 22491, "verse_number": "१-१५३-४५", "content_sanskrit": "वर्षाब्दरहितं देवं सप्तस्वरविवर्जितम् ।\nसकलं निष्कलं चैव सदैकाकाररूपिणम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002491045, "chapter_id": 22491, "verse_number": "१-१५३-४६", "content_sanskrit": "तद्दृष्ट्वानेकशिरसमनेकचरणं तथा ।\nअनेकोदरबाह्वंसमनेकाभरणान्वितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002491046, "chapter_id": 22491, "verse_number": "१-१५३-४७", "content_sanskrit": "अनेकाननमक्षीबं सहस्राक्षमनौपमम् ।\nअनेकवर्णरूपं च अनेकमुकुटोज्ज्वलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002491047, "chapter_id": 22491, "verse_number": "१-१५३-४८", "content_sanskrit": "दृष्ट्वैवं देवदेवस्य रूपं भानोर्महात्मनः ।\nविस्मयोत्फुल्लनयनास्तुष्टवुस्ते दिवाकरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002491048, "chapter_id": 22491, "verse_number": "१-१५३-४९", "content_sanskrit": "कृताञ्जलिपुटो भूत्वा ब्रह्मा स्तोतुं प्रचक्रमे ।\nप्रणम्य शिरसा भानुमिदं वचनमब्रवीत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002491049, "chapter_id": 22491, "verse_number": "१-१५३-५०", "content_sanskrit": "ब्रह्मोवाच ।\nनमस्ते देवदेवेश सहस्रकिरणोज्ज्वल ।\nलोकदीप नमस्तेऽस्तु नमस्ते कोणवल्लभ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002491050, "chapter_id": 22491, "verse_number": "१-१५३-५१", "content_sanskrit": "भास्कराय नमो नित्यं खषोल्काय नमोनमः ।\nविष्णवे कालचक्राय सोमायामिततेजसे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002491051, "chapter_id": 22491, "verse_number": "१-१५३-५२", "content_sanskrit": "नमस्ते पञ्चकालाय इन्द्राय वसुरेतसे ।\nखगाय लोकनाथाय एकचक्ररथाय च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002491052, "chapter_id": 22491, "verse_number": "१-१५३-५३", "content_sanskrit": "जगद्धिताय देवाय शिवायामिततेजसे ।\nतमोघ्नाय सुरूपाय तेजसां निधये नमः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002491053, "chapter_id": 22491, "verse_number": "१-१५३-५४", "content_sanskrit": "अर्थाय कामरूपाय धर्मायामिततेजसे ।\nमोक्षाय मोक्षरूपाय सूर्याय च नमोनमः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002491054, "chapter_id": 22491, "verse_number": "१-१५३-५५", "content_sanskrit": "क्रोधलोभविहीनाय लोकानां स्थितिहेतवे ।\nशुभाय शुभरूपाय शुभदाय शुभात्मने ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002491055, "chapter_id": 22491, "verse_number": "१-१५३-५६", "content_sanskrit": "शान्ताय शान्तरूपाय शान्तयेऽस्मासु वै नमः ।\nनमस्ते ब्रह्मरूपाय ब्राह्मणाय नमोनमः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002491056, "chapter_id": 22491, "verse_number": "१-१५३-५७", "content_sanskrit": "ब्रह्मदेवाय ब्रह्मरूपाय ब्रह्मणे परमात्मने ।\nब्रह्मणे च प्रसादं वै कुरु देव जगत्पते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002491057, "chapter_id": 22491, "verse_number": "१-१५३-५८", "content_sanskrit": "एवं स्तुत्वा रविं ब्रह्मा श्रद्धया परया विभो ।\nतूष्णीमासीन्महाभाग प्रहृष्टेनान्तरात्मना ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002491058, "chapter_id": 22491, "verse_number": "१-१५३-५९", "content_sanskrit": "ब्रह्मणोऽनन्तरं रुद्रः स्तोत्रं चक्रे विभावसोः ।\nत्रिपुरारिर्महातेजाः प्रणम्य शिरसा रविम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002491059, "chapter_id": 22491, "verse_number": "१-१५३-६०", "content_sanskrit": "महादेव उवाच ।\nजय भाव जयाजेय जय हंस दिवाकर ।\nजय शम्भो महाबाहो खग गोचर भूधर ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002491060, "chapter_id": 22491, "verse_number": "१-१५३-६१", "content_sanskrit": "जय लोकप्रदीपेन जय भानो जगत्पते ।\nजय काल जयानन्त संवत्सर शुभानन ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002491061, "chapter_id": 22491, "verse_number": "१-१५३-६२", "content_sanskrit": "जय देवादितेः पुत्र कश्यपानन्दवर्धन ।\nतमोघ्न जय सप्तेश जय सप्ताश्ववाहन ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002491062, "chapter_id": 22491, "verse_number": "१-१५३-६३", "content_sanskrit": "महेश जय कान्तीश जय कालेश शङ्कर ।\nअर्थकामेश धर्मेश जय मोक्षेश शर्मद ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002491063, "chapter_id": 22491, "verse_number": "१-१५३-६४", "content_sanskrit": "जय वेदाङ्गरूपाय ग्रहरूपाय वै नमः ।\nसत्याय सत्यरूपाय सुरूपाय शुभाय च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002491064, "chapter_id": 22491, "verse_number": "१-१५३-६५", "content_sanskrit": "क्रोधलोभविनाशाय कामनाशाय वै जय ।\nकल्माषपक्षिरूपाय यतिरूपाय शम्भवे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002491065, "chapter_id": 22491, "verse_number": "१-१५३-६६", "content_sanskrit": "विश्वाय विश्वरूपाय विश्वकर्माय वै जय ।\nजयोङ्कार वषट्कार स्वाहाकार स्वधामय ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002491066, "chapter_id": 22491, "verse_number": "१-१५३-६७", "content_sanskrit": "जयाश्वमेधरूपाय चाग्निरूपार्यमाय च ।\nसंसारार्णवपीताय मोक्षद्वारप्रदाय च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002491067, "chapter_id": 22491, "verse_number": "१-१५३-६८", "content_sanskrit": "संसारार्णवमग्नस्य मम देव जगत्पते ।\nहस्तावलम्बनो देव भव त्वं गोपतेऽद्भुत ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002491068, "chapter_id": 22491, "verse_number": "१-१५३-६९", "content_sanskrit": "ईशोऽप्येवमहीनाङ्गं स्तुत्वा भानुं प्रयत्नतः ।\nविरराम महाराज प्रणम्य शिरसा रविम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002491069, "chapter_id": 22491, "verse_number": "१-१५३-७०", "content_sanskrit": "अथ विष्णुर्महातेजाः कृताञ्जलिपुटो रविम् ।\nउवाच राजशार्दूल भक्त्या श्रद्धासमन्वितः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002491070, "chapter_id": 22491, "verse_number": "१-१५३-७१", "content_sanskrit": "विष्णुरुवाच ।\nनमामि देवदेवेशं भूतभावनमव्ययम् ।\nदिवाकरं रविं भानुं मार्तण्डं भास्करं भगम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002491071, "chapter_id": 22491, "verse_number": "१-१५३-७२", "content_sanskrit": "इन्द्रं विष्णुं हरिं हंसमर्कं लोकगुरुं विभुम् ।\nत्रिनेत्रं त्र्यक्षरं त्र्यङ्गं त्रिमूर्तिं त्रिगतिं शुभम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002491072, "chapter_id": 22491, "verse_number": "१-१५३-७३", "content_sanskrit": "षण्मुखाय नमो नित्यं त्रिनेत्राय नमोनमः ।\nचतुर्विंशतिपादाय नमो द्वादशपाणये ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002491073, "chapter_id": 22491, "verse_number": "१-१५३-७४", "content_sanskrit": "नमस्ते भूतपतये लोकानां पतये नमः ।\nदेवानां पतये नित्यं वर्णानां पतये नमः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002491074, "chapter_id": 22491, "verse_number": "१-१५३-७५", "content_sanskrit": "त्वं ब्रह्मा त्वं जगन्नाथो रुद्रस्त्वं च प्रजापतिः ।\nत्वं सोमस्त्वं तथादित्यस्त्वमोंकारक एव हि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002491075, "chapter_id": 22491, "verse_number": "१-१५३-७६", "content_sanskrit": "बृहस्पतिर्बुधस्त्वं हि त्वं शुक्रस्त्वं विभावसुः ।\nयमस्त्वं वरुणस्त्वं हि नमस्ते कश्यपात्मज ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002491076, "chapter_id": 22491, "verse_number": "१-१५३-७७", "content_sanskrit": "त्वया ततमिदं सर्वं जगत्स्थावरजङ्गमम् ।\nत्वत्त एव समुत्पन्नं सदेवासुरमानुषम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002491077, "chapter_id": 22491, "verse_number": "१-१५३-७८", "content_sanskrit": "ब्रह्मा चाहं च रुद्रश्च समुत्पन्ना जगत्पते ।\nकल्पादौ तु पुरा देव स्थितये जगतोऽनघ ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002491078, "chapter_id": 22491, "verse_number": "१-१५३-७९", "content_sanskrit": "नमस्ते वेदरूपाय अहोरूपाय वै नमः ।\nनमस्ते ज्ञानरूपाय यज्ञाय च नमोनमः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002491079, "chapter_id": 22491, "verse_number": "१-१५३-८०", "content_sanskrit": "प्रसीदास्मासु देवेश भूतेश किरणोज्ज्वल ।\nसंसारार्णवमग्नानां प्रसादं कुरु गोपते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002491080, "chapter_id": 22491, "verse_number": "१-१५३-८१", "content_sanskrit": "वेदान्ताय नमो नित्यं नमो यज्ञकलाय च ।\nसुमन्तुरुवाच ।\nस्तुत्वैवं भास्करं भक्त्या विष्णुर्भरतसत्तम ।\nप्रदध्यौ नृपशार्दूल रविं तद्गतमानसः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002491081, "chapter_id": 22491, "verse_number": "१-१५३-८२", "content_sanskrit": "एवं ते नरशार्दूल देवा ब्रह्मादयोऽनघ ।\nस्तुवन्ति तं महात्मानं सहस्रकिरणं रविम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002491082, "chapter_id": 22491, "verse_number": "१-१५३-८३", "content_sanskrit": "इत्येवं स्तुवतां तेषां रविं भक्त्या महात्मनाम् ।\nअथ तुष्टो रविस्तेषां ब्रह्मदीनां जगत्पतिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002491083, "chapter_id": 22491, "verse_number": "१-१५३-८४", "content_sanskrit": "विज्ञाय भक्तिं परमां श्रद्धां च परमां विभुः ।\nउवाच स महातेजाः प्रहृष्टेनान्तरात्मना ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002491084, "chapter_id": 22491, "verse_number": "१-१५३-८५", "content_sanskrit": "ग्रहेशो व्योम चारूढस्तेजसा प्रज्वलन्दिशः ।\nब्रह्माणं विष्णुमीशानमामन्त्र्यैतान्विशांपते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002491085, "chapter_id": 22491, "verse_number": "१-१५३-८६", "content_sanskrit": "दृष्ट्वा तान्प्रणतान्त्सर्वाञ्छिरोभिरवनिं गतान् ।\nतुष्टोऽस्मि ते सुरज्येष्ठ चतुर्मुख जगत्पते ।\nवरं वरय भद्रं ते मनसा त्वं यदिच्छसि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002491086, "chapter_id": 22491, "verse_number": "१-१५३-८७", "content_sanskrit": "कृत्वा तु वचनं भानोर्ब्रह्मा लोकगुरुर्नृप ।\nजगाम शिरसा भूमावुवाच स कृताञ्जलिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002491087, "chapter_id": 22491, "verse_number": "१-१५३-८८", "content_sanskrit": "ब्रह्मोवाच ।\nकृतकृत्योऽस्मि देवेश पूतश्चास्मि खगाधिप ।\nधन्योऽस्म्यनुगृहीतोऽस्मि गतोऽस्मि परमां गतिम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002491088, "chapter_id": 22491, "verse_number": "१-१५३-८९", "content_sanskrit": "सहस्रकिरणैर्यन्मे भवान्दर्शनमागतः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002491089, "chapter_id": 22491, "verse_number": "१-१५३-९०", "content_sanskrit": "अपश्यतश्च देवेश मूढमासीन्मनो मम ।\nभगवन्सम्प्रसीद त्वं ममोपरि विभावसो ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002491090, "chapter_id": 22491, "verse_number": "१-१५३-९१", "content_sanskrit": "प्रयच्छ त्वं बलं भक्तिमात्मनो मम गोपते ।\nगत्वा शिरोभिरवनिमष्टाङ्गैः पतितस्य च ।\nभक्त्या विज्ञप्तिमाकर्ण्य प्रसादं कुरु गोपते ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002491091, "chapter_id": 22491, "verse_number": "१-१५३-९२", "content_sanskrit": "ब्रह्मणो वचनं श्रुत्वा पूषा देवो जगत्पतिः ।\nतथेत्याह महाराज विराट प्रश्रयान्वितम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002491092, "chapter_id": 22491, "verse_number": "१-१५३-९३", "content_sanskrit": "ब्रह्मणे च वरं दत्त्वा राजन्देवो दिवाकरः ।\nउवाच त्र्यम्बकं देवं शशाङ्ककृतशेखरम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002491093, "chapter_id": 22491, "verse_number": "१-१५३-९४", "content_sanskrit": "वरं वरय भूतेश भूभृज्जादयितानघ ।\nयमिच्छसि महादेव ददेऽहं तदशेषतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002491094, "chapter_id": 22491, "verse_number": "१-१५३-९५", "content_sanskrit": "भास्करस्य वचः श्रुत्वा ईश्वरस्त्रिपुरान्तक ।\nगत्वा तु शिरसा भूमौ प्रणम्योवाच भास्करम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002491095, "chapter_id": 22491, "verse_number": "१-१५३-९६", "content_sanskrit": "महादेव उवाच ।\nपुण्योऽहं पुण्यकर्माहं नास्ति धन्यतरो मम ।\nगतोऽहं परमां सिद्धिं गतश्च परमां गतिम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002491096, "chapter_id": 22491, "verse_number": "१-१५३-९७", "content_sanskrit": "नाप्राप्यमस्ति देवेश नासाध्यं मम किंचन ।\nयस्य मे भगवान्देवः प्रसादप्रवणः स्थितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002491097, "chapter_id": 22491, "verse_number": "१-१५३-९८", "content_sanskrit": "त्वया ततमिदं सर्वं जगत्स्थावरजङ्गमम् ।\nत्वत्त एव समुत्पन्नं लयं च त्वयि यास्यति ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002491098, "chapter_id": 22491, "verse_number": "१-१५३-९९", "content_sanskrit": "यदि तुष्टो मम विभो अनुग्राह्योऽस्मि ते यदि ।\nअचलां देहि मे भक्तिमात्मनश्चरणं नय ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002491099, "chapter_id": 22491, "verse_number": "१-१५३-१००", "content_sanskrit": "व्योमकेशवचः श्रुत्वा पूषा देवो दिवाकरः ।\nतथेत्याह हरं वीर ततो हरिमुवाच ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002491100, "chapter_id": 22491, "verse_number": "१-१५३-१०१", "content_sanskrit": "नारायण महाबाहो वरं वरय गोधर ।\nपरितुष्टोऽस्मि ते देव यमिच्छसि महाबल ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002491101, "chapter_id": 22491, "verse_number": "१-१५३-१०२", "content_sanskrit": "श्रुत्वा तु भास्करवचः कीलालजनको हरिः ।\nउवाच परया भक्त्या नत्वा च शिरसा रविम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002491102, "chapter_id": 22491, "verse_number": "१-१५३-१०३", "content_sanskrit": "नारायण उवाच ।\nजय देव जगन्नाथ जय देव गुरो रवे ।\nप्रसीद मम देवेश भक्तिं यच्छात्मनो रवे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002491103, "chapter_id": 22491, "verse_number": "१-१५३-१०४", "content_sanskrit": "येनाहं सर्वदेवानामुत्तमः स्यां जगत्पते ।\nअजेयश्च तथा देव दैत्यदानवरक्षसाम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002491104, "chapter_id": 22491, "verse_number": "१-१५३-१०५", "content_sanskrit": "त्वद्भक्त्या बृंहितबलस्तेजसा महतान्वितः ।\nततो मया महत्कर्म कर्तव्यं तव शासनात् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002491105, "chapter_id": 22491, "verse_number": "१-१५३-१०६", "content_sanskrit": "प्रजानां पालनं देव देवानां च ग्रहाधिप ।\nवर्णानामाश्रमाणां च वर्णधर्मस्य वा विभो ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002491106, "chapter_id": 22491, "verse_number": "१-१५३-१०७", "content_sanskrit": "दुष्टदैत्यविनाशाय लोकानां पालनाय च ।\nसृष्टोऽहं भवता पूर्वं कल्पादौ च कृतोऽनघ ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002491107, "chapter_id": 22491, "verse_number": "१-१५३-१०८", "content_sanskrit": "यस्य रुष्टो भवान्स्याद्वै कथञ्चित्पुरुषस्य तु ।\nव्याधिर्दुःखं मनोरोगं दारिद्र्यं सन्ततिक्षयः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002491108, "chapter_id": 22491, "verse_number": "१-१५३-१०९", "content_sanskrit": "तस्यैतानि भवन्तीह आधयो विविधास्तथा ।\nतस्मात्त्वं च ततो देव संस्तव्यः सततं बुधैः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002491109, "chapter_id": 22491, "verse_number": "१-१५३-११०", "content_sanskrit": "एवं त्वां गोपते देव भक्त्या श्रद्धासमन्वितः ।\nअहमर्चितुमिच्छामि तस्मान्मयि कृपां कुरु ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]