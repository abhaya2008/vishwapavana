[
  {
    "id": 20012350,
    "chapter_id": 6691,
    "verse_number": "19.1",
    "content_sanskrit": "अथ फल्गुनः सबलकृष्णकुसुमविशिखोऽभ्यवन्दत । हर्षभरितहृदयो मुदितां तरसोपसृत्य पदपद्मयोः पृथाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20012351,
    "chapter_id": 6691,
    "verse_number": "19.2",
    "content_sanskrit": "अथ सा स्म जिघ्रति शिरस्सु रुचिरमणिभूषणेषु तान् । फुल्लसुरभिकुसुमग्रथितस्रगलङ्कृतोरुकचचक्रचारुषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20012352,
    "chapter_id": 6691,
    "verse_number": "19.3",
    "content_sanskrit": "कृतपादवन्दनमदृष्टचरमपि मुकुन्दनन्दनम् । तातसदृशमथ साऽकलयत् पुनरर्जुनोक्तमपि रुक्मिणीसुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20012353,
    "chapter_id": 6691,
    "verse_number": "19.4",
    "content_sanskrit": "अथ सा स्वमङ्कमधिरोप्य नयनसलिलैस्स्म सिञ्चति । स्नेहपरिगलदुरोजरसैरपि तं जयन्तमिव वत्सलाऽदितिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20012354,
    "chapter_id": 6691,
    "verse_number": "19.5",
    "content_sanskrit": "अथ संभ्रमादुपनिनाय निभृतमणिभूषणात्मना । रत्नकिरणजटिलान्यसिता कनकासनानि कतिचिद्विचक्षणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20012355,
    "chapter_id": 6691,
    "verse_number": "19.6",
    "content_sanskrit": "गुरुसन्निधाननिभृतार्धनयनमथ सा धनञ्जयम् । स्नेहजलधिपरिवाहमिव श्रमवारिसन्तति ददर्श सोऽपिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20012356,
    "chapter_id": 6691,
    "verse_number": "19.7",
    "content_sanskrit": "अथ धर्मभूरधिरुरोह कनकमयमुत्तमासनम् । तप्तकनकरुचिचोरतनुस्तपनीयपर्वतमिव प्रभाकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20012357,
    "chapter_id": 6691,
    "verse_number": "19.8",
    "content_sanskrit": "कनकासने पृथुतरे च बलपवनजौ निषेदतुः । श्लिष्टमणिमदुरसोः शिखरौ हरिणाधिपाविव धराधराधिपे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20012358,
    "chapter_id": 6691,
    "verse_number": "19.9",
    "content_sanskrit": "युगपन्निपेतुरथ सर्वकुलयुवतिकेकिनीदृशः । शैलसदृशमणिपीठजुषो जलजाक्षजिष्णुजलमुक्तमालयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20012359,
    "chapter_id": 6691,
    "verse_number": "19.10",
    "content_sanskrit": "उपकुन्ति चासनवराणि नकुलसहदेवमन्मथाः । नेत्रशफरनिकरं सुदृशां दधतोऽधितस्थुरजलाशया अपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20012360,
    "chapter_id": 6691,
    "verse_number": "19.11",
    "content_sanskrit": "यमसूरुच्चतममुच्चतरमनिलजासिताम्बरौ । उच्चमजितविजयावभजन् यममन्मथा पुनरुच्चमासनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20012361,
    "chapter_id": 6691,
    "verse_number": "19.12",
    "content_sanskrit": "प्रकृतार्थसङ्कथनभाजि समयशकले गते ततः । मातरुपनय किरीटिवधूमिति'सिन्धुरध्वनिरुवाच धर्मराट् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20012362,
    "chapter_id": 6691,
    "verse_number": "19.13",
    "content_sanskrit": "पृथयाऽर्धनेत्रचलनेन सपदि गदिताऽथ पार्षती । नम्रवदनकमलां त्रपया निकटं धनञ्जयवधूमुपानयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20012363,
    "chapter_id": 6691,
    "verse_number": "19.14",
    "content_sanskrit": "अवलोक्य तेऽथ विजयस्य हलिहरिसहोदरां वधूम् । हर्षजलधिशफरीरदधुस्स्फुरिता विशालविशदायतादृशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20012364,
    "chapter_id": 6691,
    "verse_number": "19.15",
    "content_sanskrit": "सुकृताङ्कुशानिव पुरोऽथ दशनकिरणान् प्रकाशयन् । स्नेहनिगलितमना नृपतिः प्रणमन्नुवाच सहराममच्युतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20012365,
    "chapter_id": 6691,
    "verse_number": "19.16",
    "content_sanskrit": "शशिवंश एष विमलोऽद्य विमलतरतामुपैति ते । पादकमलरजसा सदने पतता हरेपरमपावनेन नः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20012366,
    "chapter_id": 6691,
    "verse_number": "19.17",
    "content_sanskrit": "तव पादपङ्कजरजांसि गृहमुपहरन्ति हन्त नः । पुरुभरतकुरुसंवरणप्रमुखादिराजसुकृतान्यधोक्षज ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20012367,
    "chapter_id": 6691,
    "verse_number": "19.18",
    "content_sanskrit": "सुक्रुदीक्षते सुपुरुषं हितमपचिनुते सुक्रुत्तरः । तं तु सुखयति यथाविभवं गृहमागतं गृहपतिस्सुक्रुत्तमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20012368,
    "chapter_id": 6691,
    "verse_number": "19.19",
    "content_sanskrit": "परमं सुखं त्वमपरञ्च परमपुरुषोच्यसे बुधैः । तस्य सुकृदपि सुखाय भवेन्न तवाऽसुकृत् किमुत मादृशो जनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20012369,
    "chapter_id": 6691,
    "verse_number": "19.20",
    "content_sanskrit": "स्खलितावलीसमनुमेयहृदयगतहर्षसंभ्रमैः । तुष्य वरद यदि तुष्यसि नः परमेभिरर्चनविडम्बनैरतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20012370,
    "chapter_id": 6691,
    "verse_number": "19.21",
    "content_sanskrit": "परितुष्ट एव यदि वा त्वमज ! न न जनेऽत्र सर्वथा । आजिशिरसि हरता भगिनीं विजयेन यत्त्वमजितोऽपि निर्जितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20012371,
    "chapter_id": 6691,
    "verse_number": "19.22",
    "content_sanskrit": "सुखचिद्धनस्त्वमनुपाधिरपि विभुरनादिरव्ययः । बन्धुरिव सुहृदिवाऽऽश्रयसे यदुपेन्द्र नः किमपि तत्र कारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20012372,
    "chapter_id": 6691,
    "verse_number": "19.23",
    "content_sanskrit": "स भवानपारपरिपूर्णरसकवलनोदरो हरिः । ज्ञानविहतसकलाभिमतिर्बिभृयात् कथं कुरुकुलस्य बन्धुताम् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20012373,
    "chapter_id": 6691,
    "verse_number": "19.24",
    "content_sanskrit": "न च ते प्रयोजयति जन्म भुवनजननादि माधव ! पूर्णनिजरसतनोर्भवतः किमनेन किञ्च विषयेण देहिनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20012374,
    "chapter_id": 6691,
    "verse_number": "19.25",
    "content_sanskrit": "जनिजीवन प्रलयनाकनरकगतिगर्भवासभाक् । धर्मदुरितकलिता सकला तव कर्मणा किमवकुन्थति प्रजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20012375,
    "chapter_id": 6691,
    "verse_number": "19.26",
    "content_sanskrit": "अथ भक्तलोकभवदुःखशमनफलमितीहितं तव । तर्हि भवविरतिरेव वरं भुवनैकनाथ भवचक्रदापनात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20012376,
    "chapter_id": 6691,
    "verse_number": "19.27",
    "content_sanskrit": "प्रकृतीरितस्त्वमथ देव धुतभवप्रभव कल्पसे । आत्थ बहुविधगुणो महिता योषितो ह ह ह किं न कुर्वते ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20012377,
    "chapter_id": 6691,
    "verse_number": "19.28",
    "content_sanskrit": "कतमोऽथवा तव पुराणपुरुषचरितं विचारयेत् ? यो विहरति सकलासुखगैस्तनुपञ्जरेषु निहितैर्गुणैस्सितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20012378,
    "chapter_id": 6691,
    "verse_number": "19.29",
    "content_sanskrit": "कबलीकृताखिलजगच्चमण्डुरतनुर्बभूविथ । सृष्टसकलभुवनस्तु पुनः सुमहाननन्तशयनाश्रितो हरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20012379,
    "chapter_id": 6691,
    "verse_number": "19.30",
    "content_sanskrit": "मधुकैटभासृशबलेन मधुमथन पीतवाससा । धातुमिलिततपनीयतटं जितवांस्त्वमञ्जनमहामहीधरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20012380,
    "chapter_id": 6691,
    "verse_number": "19.31",
    "content_sanskrit": "शुभति स्फुटास्फुटमितेन्दुमयनयनदीधितिश्रितम् । गायदजमधुकरं कमलं ननु पद्मनाभ तव नाभिपल्वले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20012381,
    "chapter_id": 6691,
    "verse_number": "19.32",
    "content_sanskrit": "हृदयावलम्बितमनन्तशयन शयितं पयोनिधौ । जन्मजलधितरणाय वपुस्तव कल्पते कथमशेषदेहिनाम् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20012382,
    "chapter_id": 6691,
    "verse_number": "19.33",
    "content_sanskrit": "मृगणापरापि न भवन्तमपगुण ! तथेक्षते श्रुतिः । आशु शफरवपुषा विचितां त्वमपान्निधेः पयसि तां यथैक्षथाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20012383,
    "chapter_id": 6691,
    "verse_number": "19.34",
    "content_sanskrit": "शफराकृतिर्जलपतेस्तवममणिमुकुरं यथा हरे । फेनदशनरुचिभिन्नमुखप्रतिबिम्बमृर्मिकरधारितोऽदधत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20012384,
    "chapter_id": 6691,
    "verse_number": "19.35",
    "content_sanskrit": "भ्रमितस्सुरासुरगणेन भुजगपतिनावर त्रया । कूर्मवपुषि तुलिताद्रितटे चिरमभ्रमत्तव मुकुन्द मन्दरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20012385,
    "chapter_id": 6691,
    "verse_number": "19.36",
    "content_sanskrit": "कमठात्मनोढमथिरूढशिखरमपरेण चात्मना । मन्थधरणिधरमभ्रमयो भगवन् पुरा त्वममृताम्भसां पुरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20012386,
    "chapter_id": 6691,
    "verse_number": "19.37",
    "content_sanskrit": "स्वभुजैश्चतुर्भिरुदधिं त्वमसुरमथन व्यलोलयः । स्वेदसलिलकणकीर्णवपुश्लथितांशुको रणितरत्नभूषणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20012387,
    "chapter_id": 6691,
    "verse_number": "19.38",
    "content_sanskrit": "हृतकौस्तुभो हृतरमस्त्वममृतममरैरहारयः । रत्ननिकरमपि साधु हरे विषमेव केवलमहारयो हरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20012388,
    "chapter_id": 6691,
    "verse_number": "19.39",
    "content_sanskrit": "असुरैर्गृहीतममृतं त्वमज युवतिमूर्तिमायया । वारिशिशिरतरया हृतवान् निजनान्दकासिलतयाऽतितीक्ष्णया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20012389,
    "chapter_id": 6691,
    "verse_number": "19.40",
    "content_sanskrit": "प्रविजृम्भिताञ्जनसवर्णतनुविहितभूनभोवधिः । हेमनयनरुधिराद्वैतया निजदंष्ट्रयोद्धतसमुद्रमेखलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20012390,
    "chapter_id": 6691,
    "verse_number": "19.41",
    "content_sanskrit": "प्रतिमापदेन जगदेतदसदखिलमात्मनि स्फुटम् । बिभ्रदिवसुविमले विपुले स भवानभूत् प्रथमसूकरः पुरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20012391,
    "chapter_id": 6691,
    "verse_number": "19.42",
    "content_sanskrit": "नरसिंहमूर्तिरपतस्तवमुरसि विबुधारिद्दन्तिनः । धृतनखनिखननोद्यदसृक्प्लुतभूरिकेसरकरालकन्धरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20012392,
    "chapter_id": 6691,
    "verse_number": "19.43",
    "content_sanskrit": "हतवान् हिरण्यकशिपुं त्वमसृगरुणकान्तिभिर्नखैः । सार्वसकलजनसाध्वसदं किरणैरिवान्धतमसं दिवाकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20012393,
    "chapter_id": 6691,
    "verse_number": "19.44",
    "content_sanskrit": "क्रमणच्छलादहमवैमि बलिमखगतेन वामन । व्याप्तसकलजगता भवता परमोऽणिमा च महिमा च दर्शितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20012394,
    "chapter_id": 6691,
    "verse_number": "19.45",
    "content_sanskrit": "कृतवान् कुतः कितवकर्म दितिसुतपरिवृढीयसि । कृष्ण सुकृति यदि नीचतया स भवान् किमर्थमभवस्तदा महान्? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20012395,
    "chapter_id": 6691,
    "verse_number": "19.46",
    "content_sanskrit": "प्रतिमामिवास्यविमलेन बलिवलभिदा त्रिविक्रम ! क्रान्तिसमयविततेनजगद्बत विग्रहेण सकलं त्वमग्रहीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20012396,
    "chapter_id": 6691,
    "verse_number": "19.47",
    "content_sanskrit": "शिरसि श्रुतावुरसि कुक्षिकटिचरणकण्ठबाहुषु । क्रान्तिसमयतरलस्य भवतः द्युमणिः क्रमादजनि देव भूषणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20012397,
    "chapter_id": 6691,
    "verse_number": "19.48",
    "content_sanskrit": "पटुरेष नैष वटुरेष मुरजिदयमाशु हन्यताम् । इत्थमजित वदतो दितिजान् युगपत्स्वबाहुपरिघैरपातयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20012398,
    "chapter_id": 6691,
    "verse_number": "19.49",
    "content_sanskrit": "धृतविश्वरूप इव तत्र सभयमसुरैस्त्वमैक्ष्यथाः । कान्तिविततविमलावयवप्रतिबिम्बिताखिलजगत् जगत्पते ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20012399,
    "chapter_id": 6691,
    "verse_number": "19.50",
    "content_sanskrit": "धृतशङ्खचक्रविमलासिधनुरिषुगदादिहेतिभिः । दोर्भिरमलकमलाभरणैर्मृतदानवेन्द्रगणरक्तचन्दनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20012400,
    "chapter_id": 6691,
    "verse_number": "19.51",
    "content_sanskrit": "कवलीकृतामरपथेन विकसदतसीवनत्विषा । ऋक्षनिकरनिभहारजयिद्युतिमन्महामणिमता महोरसा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20012401,
    "chapter_id": 6691,
    "verse_number": "19.52",
    "content_sanskrit": "मणिभासुरेण धृतपीतवसनवडवामुखाग्निना । कर्तुमखिलदितिजप्रलयं नवसिन्धुनेव वपुषा समुद्यता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20012402,
    "chapter_id": 6691,
    "verse_number": "19.53",
    "content_sanskrit": "पदमेकमत्यवनिचक्रमुदधिवलयेन वेष्टितम् । अन्तरुपलनिकरेण दधन् मुखरेण पादकटकानुसारिणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20012403,
    "chapter_id": 6691,
    "verse_number": "19.54",
    "content_sanskrit": "विबुधादिभिर्जय जयेति नुतमपचितन्नमस्कृतम् । क्रान्तगगनमपरं चरणं निदधाथ माधव किलाऽमरालये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20012404,
    "chapter_id": 6691,
    "verse_number": "19.55",
    "content_sanskrit": "अतिसर्वलोकमुपयातमुदवासितमात्मनोऽतिथिम् । पादममलसुरसिन्धुजलैस्स्म धावति कमण्डलूज्झितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20012405,
    "chapter_id": 6691,
    "verse_number": "19.56",
    "content_sanskrit": "प्रणिपत्य चाऽरुणसरोजशबलतुलसीदलस्रजा । पादकमलमपचित्य हरे चरितार्थतां तव ययौ चतुर्मुखः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20012406,
    "chapter_id": 6691,
    "verse_number": "19.57",
    "content_sanskrit": "गुरुभक्तिपूर्वमभिराध्य सपदिकपुरस्सुरास्सुराः । नूनमतिशुचिविशालनखप्रतिमापदेन विविशुः पदं तव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20012407,
    "chapter_id": 6691,
    "verse_number": "19.58",
    "content_sanskrit": "तव कृष्ण गोसरिदुवाह सुविपुलगभीरदीर्घया । पद्मकलशकुलिशादिशुभचरणारुणाम्बुजतलोर्ध्वरेखया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20012408,
    "chapter_id": 6691,
    "verse_number": "19.59",
    "content_sanskrit": "सविलासभ्रूजिततरङ्गगरुदतिसिता तरस्विनी । चक्रधरचरणवारिरुहं वरदेव देवतटिनी चुचुम्ब ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20012409,
    "chapter_id": 6691,
    "verse_number": "19.60",
    "content_sanskrit": "सुपवित्रमभ्रसरिदम्बु तव पदगमादुरुक्रम ! ब्रह्महननदुरितक्षतये शितिकन्धरोऽपि शिरसाऽग्रहीद्ध्रुवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20012410,
    "chapter_id": 6691,
    "verse_number": "19.61",
    "content_sanskrit": "विकषायमानसमजस्रमतिमुदितमृद्धिमत्तमम् । भक्तमपिमपि 'चकर्थ बलिं कृपया रसातलपतिं किलाऽच्युत ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20012411,
    "chapter_id": 6691,
    "verse_number": "19.62",
    "content_sanskrit": "कृतवीर्यसूनुभुजभूपवनशिखिचरः पुनर्भृगून् । शृङ्गलिखिततनुरद्य मृगैः परशुं दधत्त्वमचले तपस्यसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20012412,
    "chapter_id": 6691,
    "verse_number": "19.63",
    "content_sanskrit": "दशकन्धरस्य निधनाय दशरथसुतो बभूविथ । कृष्ण किल पुनरपारयशाः शिवकीर्तनो रविकुलैकभूषणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20012413,
    "chapter_id": 6691,
    "verse_number": "19.64",
    "content_sanskrit": "पृथुयुवनाश्वभरतैः दशरथभगीरथादयः । तेऽपि धरणिपतयः प्रथमे मुनयश्च माधव तवैव मूर्तयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20012414,
    "chapter_id": 6691,
    "verse_number": "19.65",
    "content_sanskrit": "कृष्णनामसि बलकृष्णनामसि सितकृष्णमसितपीतकाम्बरम् । बिभ्रदुभयमधुनाऽपि वपुर्बहुपुण्यभाजि जगतीह दृश्यसे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20012415,
    "chapter_id": 6691,
    "verse_number": "19.66",
    "content_sanskrit": "हतसर्वदुष्टनिवहेन कृतसकलधर्मगुप्तिना । कल्पविरतिसमये भगवन् भविता च विष्णुयशसा 'त्वयाख्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20012416,
    "chapter_id": 6691,
    "verse_number": "19.67",
    "content_sanskrit": "असुरक्षतिः सुरनरादितनुभृदवनं चतुर्भुज ! पुण्यसुखकरकथादि महच्चरितञ्च तेऽवतरणप्रयोजनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20012417,
    "chapter_id": 6691,
    "verse_number": "19.68",
    "content_sanskrit": "विकटं शकटाङ्गदानवं शिशुरुत्तानशयो निपातयन् । नवतामरसाग्रदीघसा युगलेनोल्लसता पदाब्जयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20012418,
    "chapter_id": 6691,
    "verse_number": "19.69",
    "content_sanskrit": "शयितः स्तनयोश्च पूतनायाः सह दुग्धेन विलीढजीवितायाः । कटिबद्धमुलूखलञ्च कर्षन् दलयन्नर्जुनपादपौ भुजाभ्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20012419,
    "chapter_id": 6691,
    "verse_number": "19.70",
    "content_sanskrit": "मुखरिततपनीयकिङ्किणीपदवलयं धुतकाकपक्षकम् । प्रविदधदपि जानुधावनं धुतधरणीतलधूलिधूसरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20012420,
    "chapter_id": 6691,
    "verse_number": "19.71",
    "content_sanskrit": "सपदि दश दिशो विलोक्य हृत्वा सह पयसा नवनीतमालयेभ्यः । व्रजयुवतिजनस्य चाऽपगच्छन् करविहितोत्स्वनकिङ्किणीकलापः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20012421,
    "chapter_id": 6691,
    "verse_number": "19.72",
    "content_sanskrit": "महासुरान् सप्तमहोक्षकायान् निपात्य नीलामुपयच्छमानः । मथ्नन्नरिष्टञ्च वृषाङ्गभाजं हयाकृतिं केशिनमप्यमित्रम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20012422,
    "chapter_id": 6691,
    "verse_number": "19.73",
    "content_sanskrit": "वृन्दावने चौक्षकवात्सकोप्तान् वृन्दावनेहाकुलितश्चरिष्णुः । गोपायिता पातितदेवशत्रुर्गोंपायिता नाकिमहीसुराणाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20012423,
    "chapter_id": 6691,
    "verse_number": "19.74",
    "content_sanskrit": "मन्दमारुतचलद्धनमालामौलिवर्हमृदुपीतकवासाः । पीतकान्तिरपि गोपवधूनामीक्षणावलिभिरव्ययकान्तिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20012424,
    "chapter_id": 6691,
    "verse_number": "19.75",
    "content_sanskrit": "नैकरन्ध्रपतदुद्यदङ्गुलिव्यञ्जिताखिलविरिञ्चसुध्वनिम् । वादयन्नधरविम्बचुम्बितां पाणियुग्मधृतवेणुयष्टिकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20012425,
    "chapter_id": 6691,
    "verse_number": "19.76",
    "content_sanskrit": "सवयोभिरमा पशुपालसुतैर्विदधद्विविधा विहृतीरनिशम् । प्रथितेन गवां पदवी रजसा धरणीरजसा रचितावयवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20012426,
    "chapter_id": 6691,
    "verse_number": "19.77",
    "content_sanskrit": "पादपरिक्रममञ्जुलकूजत्किङ्किणिकावलयाङ्घ्रिविभूषम् । बाहुविलासविधूतदुकूलं कालियनागशिरस्सु च नृत्यन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20012427,
    "chapter_id": 6691,
    "verse_number": "19.78",
    "content_sanskrit": "शीतालुव्रजवनितावलीकदुष्णप्राश्लिष्यत्कुचकलशोपगुह्यमानः । गोत्रास्रस्तवनमालतोऽस्तवृष्टिबिभ्राणो भुजपरिघेण भूधरञ्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20012428,
    "chapter_id": 6691,
    "verse_number": "19.79",
    "content_sanskrit": "मृत्साहारक्रुद्यशोदाविवृतास्ये साब्धिद्वीपक्षोणिधरादीनि जगन्ति । व्यञ्जद्भीत्या प्राञ्जलिर्यस्तां बहु लब्ध्वा दुग्धोत्कोचं संवृतमास्यं विदधच्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20012429,
    "chapter_id": 6691,
    "verse_number": "19.80",
    "content_sanskrit": "गोष्ठं नीतस्साग्रजो माथुराभ्यामाध्यायद्भ्यां शैशवे वत्सलाभ्याम् । दृष्टो न त्वं यद्घियाऽभूः पितृभ्यां दिष्ट्या पिष्टः स त्वया कृष्ण कंसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20012430,
    "chapter_id": 6691,
    "verse_number": "19.81",
    "content_sanskrit": "दुष्टं प्रमथ्य रजकं धृतपीतवासाः कुब्जाङ्गरागपुनरुक्तशरीरकान्तिः । मालाकृदर्पितमनोहरमालभारी कंसस्य चापमभिमानमिवाऽच्छिनस्त्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20012431,
    "chapter_id": 6691,
    "verse_number": "19.82",
    "content_sanskrit": "उत्खातदन्तमुसला शिथिलप्रहारक्षुण्णद्विजाधिपतनूच्चलितास्रसिक्तः । कोपातिरक्तनयनस्समनन्दयस्त्वं चाणूरमाशु हतवान् पितरौ मुरारे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20012432,
    "chapter_id": 6691,
    "verse_number": "19.83",
    "content_sanskrit": "चाणूरमल्लवधरुष्टमधिक्षिपन्तं बद्धौ कृशौ स्वपितरौ मथुराधिपं तम् । मञ्चाचलस्थमुरगेन्द्रमिव द्विपेन्द्रस्सम्पात्य दारुणकराहतिभिर्न्यगृह्णाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20012433,
    "chapter_id": 6691,
    "verse_number": "19.84",
    "content_sanskrit": "कंसं निपात्य चरणानभिवन्दमानस्तोषं कियन्तमनयः पितरौ हरे त्वम् । निष्पिष्टमुष्टिकसुनामशरीररक्तैस्सिक्तं प्रलम्बरिपुणा दधता सहाङ्गम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20012434,
    "chapter_id": 6691,
    "verse_number": "19.85",
    "content_sanskrit": "मातामहं तनयपीडितमुग्रसेनं कृत्वाऽवसि त्वमधिपं यदुभूपतीनाम् । दीनात्मनामपि च कंसपरिग्रहाणां पङ्केरुहाक्ष शरणं करुणाकरोऽसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20012435,
    "chapter_id": 6691,
    "verse_number": "19.86",
    "content_sanskrit": "कृत्वाऽतुलं वृकभयं प्रतिपद्य हृद्यं वृन्दावनं विहरसि स्म यथा तथा त्वम् । मन्ये विहाय मथुरां मगधेशभीतिद्वारेण कृष्ण रमसे रमया सहाऽब्धौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20012436,
    "chapter_id": 6691,
    "verse_number": "19.87",
    "content_sanskrit": "विक्रान्तिनिर्जितहरीश हरे यदि त्वं युद्धे सृगालमवधीः किमिवात्र चित्रम् ? आनीतनष्टमणिरप्यमलं कथं त्वं मायिन्नशेषजनचिन्मणिचोर कृष्ण ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20012437,
    "chapter_id": 6691,
    "verse_number": "19.88",
    "content_sanskrit": "करतलहतभेरीपुष्करः किङ्करोऽहं भुवनविजयिनस्ते विक्रमे चक्रपाणौ । गिरिशिखरसहस्रच्छिन्ननीलार्णवाभो रजनिचरबलौघो राघवत्वे च दासः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20012438,
    "chapter_id": 6691,
    "verse_number": "19.89",
    "content_sanskrit": "स तमपरतनुस्थं वेद्मि शार्ङ्गिन्निदानीं नहि मम बलमन्यस्साहयेन्मुष्टिघातैः । परममनुगृहीतस्स्वामिना युद्धकीर्त्या चरणकमलदासो जाम्बवानेष दिष्ट्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20012439,
    "chapter_id": 6691,
    "verse_number": "19.90",
    "content_sanskrit": "अभिधाय वाचमिति सर्क्षपतिस्तव पादयोर्न्यदधित जाम्बवतीम् । त्वमपि स्यमन्तकमतिज्वलितं कलितप्रसेनमृगपत्यसृजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20012440,
    "chapter_id": 6691,
    "verse_number": "19.91",
    "content_sanskrit": "अक्रूराय त्वं ददासि स्म रत्नं मध्येवृष्णिश्रेणि बालारुणाभम् । त्यक्त्वा रामं सत्यभामाञ्च देवीं मुक्त्वा लोभं व्यक्तमध्यस्थवृत्तिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20012441,
    "chapter_id": 6691,
    "verse_number": "19.92",
    "content_sanskrit": "परिभूय चेदिमगधाधिपतिप्रभृतीन्नृपान् शमितरुग्मिमदः । प्रतिपद्य कुण्डिनपुरं तरसा दयिताञ्च भीष्मकसुतामहरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20012442,
    "chapter_id": 6691,
    "verse_number": "19.93",
    "content_sanskrit": "स्तोतापदिष्टैर्भवतु प्रलापैस्त्वामर्चितुं केन च पारयेम ? प्राणाश्शरीराणि निवेशनानि स्वामिन्यतःस्वानि च तावकानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20012443,
    "chapter_id": 6691,
    "verse_number": "19.94",
    "content_sanskrit": "पिता च माता च सुतश्च पौत्रः पितामहश्च प्रपितामहश्च । मित्रं कलत्रं यदि वा समस्तं त्वमेव दामोदर नाऽपरो नः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20012444,
    "chapter_id": 6691,
    "verse_number": "19.95",
    "content_sanskrit": "बम्भ्रम्यमाणान् भवसिन्धुमध्ये कल्लोलिते दुःखपरम्पराभिः । आरोप्य नो धर्ममहातरित्रं त्रायस्व नारायणकर्णधार ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20012445,
    "chapter_id": 6691,
    "verse_number": "19.96",
    "content_sanskrit": "इति ब्रुवाणं तमुवाच चक्री स्तबैरलं सम्प्रति धर्मराज ! दामोदरः कर्मकरस्सदा ते भ्रूवल्लरीवेल्लनमिच्छतीति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20012446,
    "chapter_id": 6691,
    "verse_number": "19.97",
    "content_sanskrit": "आराधयन् पत्तनमाकुमारं रुच्याऽखिलावासपरिच्छदाढ्यम् । ददौ च भूरि द्रविणं भगिन्यै पृथासमक्षं पृथु लोहिताक्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20012447,
    "chapter_id": 6691,
    "verse_number": "19.98",
    "content_sanskrit": "हर्षप्रहर्षोल्लसितप्रथिम्ना विलोक्य कुन्ती नयनद्वयेन । अथाऽऽबभाषे वसुदेवसूनुं प्रेमाणमभ्यु'द्भिरतीव साक्षात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20012448,
    "chapter_id": 6691,
    "verse_number": "19.99",
    "content_sanskrit": "मा मुमुहः कमललोचन माययाऽस्मान्यद्वा विमोहयतरां यदि बन्धुरीदृक् । निश्रेयसं क्व तदनिर्वचनीयरूपं क्वेदृक्समागमसुखं तव वासुदेव ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20012449,
    "chapter_id": 6691,
    "verse_number": "19.100",
    "content_sanskrit": "कार्याणि कारय सुतान्मम पृच्छ एषां भूत्वा त्रिवर्गविषयाणि मुकुन्द शश्वत् । संवर्धयात्मनि परामपि भक्तिमेषामेषां त्वमेव शरणं करुणाकराऽसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20012450,
    "chapter_id": 6691,
    "verse_number": "19.101",
    "content_sanskrit": "पुण्यैरेवं दृश्यसे श्रीधर त्वं यैरस्माभिर्बन्धुमित्रादिरूपी । सर्वं कुर्वन् वत्सलः कार्यजातं देहे देहे देहि तान्येव देव ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20012451,
    "chapter_id": 6691,
    "verse_number": "19.102",
    "content_sanskrit": "इति ब्रुवाणामवदत्पृथां हरिस्तवाम्ब ! कर्तास्मि समस्तमीप्सितम् । तवाऽपि पौत्रो जनिता सुभद्रया समः पितुर्वंशकरश्चिरादिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20012452,
    "chapter_id": 6691,
    "verse_number": "19.103",
    "content_sanskrit": "वचः श्रुत्वा सत्यं तदथ निखिलाम्नायवचसं पृथाकृष्णापार्थाः स्वयमपि सुभद्रा मुमुदिरे । ततः स्नात्वा कृत्वा सुरपितृमनुष्याद्यपचितिं विजह्रुस्ते भुक्त्वा मरुत इव नाके सहरयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  }
]