[{"id": 7000591000, "chapter_id": 20591, "verse_number": "५-५०-१", "content_sanskrit": "शेष उवाच ।\nअथ रामानुजो वेगात्समागत्य स्वसेवकान् ।\nपप्रच्छ कुत्र वाहोऽसौ याज्ञिकः सुमनोहरः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000591001, "chapter_id": 20591, "verse_number": "५-५०-२", "content_sanskrit": "तदा ते वचनं प्रोचुः शत्रुघ्नं सुमहाबलाः ।\nन जानीमो भटाः केचिद्धयं नीत्वा गताः पुरे॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000591002, "chapter_id": 20591, "verse_number": "५-५०-३", "content_sanskrit": "वयं च धिक्कृताः सर्वे बलिभी राजसेवकैः ।\nअत्र प्रमाणं भगवानिति कर्तव्य तां प्रति॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000591003, "chapter_id": 20591, "verse_number": "५-५०-४", "content_sanskrit": "तच्छ्रुत्वा वचनं तेषां शत्रुघ्नः कुपितो भृशम् ।\nदशन्रोषात्स्वदशनाञ्जिह्वया लेलिहन्मुहुः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000591004, "chapter_id": 20591, "verse_number": "५-५०-५", "content_sanskrit": "उवाच वीरो मद्वाहं हृत्वा कुत्र गमिष्यसि ।\nइदानीं पातये बाणैः पुरंजनसमन्वितम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000591005, "chapter_id": 20591, "verse_number": "५-५०-६", "content_sanskrit": "इत्युक्त्वा सुमतिं प्राह कस्येदं पुटभेदनम् ।\nको वर्ततेऽस्याधिपतिर्यो मे वाहमजीहरत्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000591006, "chapter_id": 20591, "verse_number": "५-५०-७", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य भूपतेः कोपसंयुतम् ।\nजगाद मंत्री सुगिरा स्फुटाक्षरसमन्वितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000591007, "chapter_id": 20591, "verse_number": "५-५०-८", "content_sanskrit": "विद्धीदं कुंडलं नाम नगरं सुमनोहरम् ।\nअस्मिन्वसति धर्मात्मा सुरथः क्षत्त्रियो बली॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000591008, "chapter_id": 20591, "verse_number": "५-५०-९", "content_sanskrit": "नित्यं धर्मपरो रामचरणद्वंद्वसेवकः ।\nमनसा कर्मणा वाचा हनूमानिव सेवकः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000591009, "chapter_id": 20591, "verse_number": "५-५०-१०", "content_sanskrit": "चरितान्यस्य शतशो वर्तंते धर्मकारिणः ।\nमहाबलपरीवारः सुरथः सर्वशोभनः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000591010, "chapter_id": 20591, "verse_number": "५-५०-११", "content_sanskrit": "महद्युद्धं भवेदत्र हृतश्चेद्वाहसत्तमः ।\nअनेके प्रपतिष्यंति वीरा रणविशारदाः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000591011, "chapter_id": 20591, "verse_number": "५-५०-१२", "content_sanskrit": "एवमुक्तं समाश्रुत्य शत्रुघ्नः सचिवं प्रति ।\nउवाच पुनरप्येवं वचनं वदतां वरः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000591012, "chapter_id": 20591, "verse_number": "५-५०-१३", "content_sanskrit": "शत्रुघ्न उवाच ।\nकथमत्र प्रकर्तव्यं रामाश्वोऽनेन चेद्धृतः ।\nनायाति योद्धुं प्रबलं कटकं वीरसेवितम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000591013, "chapter_id": 20591, "verse_number": "५-५०-१४", "content_sanskrit": "सुमतिरुवाच ।\nदूतः प्रेष्यो महाराज राजानं प्रति वाग्मिकः ।\nयद्वाक्येन समायाति बलेन बलिनां वरः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000591014, "chapter_id": 20591, "verse_number": "५-५०-१५", "content_sanskrit": "नोचेदज्ञानतो वाहो धृतः केनापि मानिना ।\nअर्पयिष्यति नः साधुमश्वं क्रतुवरं शुभम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000591015, "chapter_id": 20591, "verse_number": "५-५०-१६", "content_sanskrit": "इति श्रुत्वातु तद्वाक्यं शत्रुघ्नो बुद्धिमान्बली ।\nअंगदं प्रत्युवाचेदं वचनं विनयान्वितम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000591016, "chapter_id": 20591, "verse_number": "५-५०-१७", "content_sanskrit": "शत्रुघ्न उवाच ।\nयाहि त्वं निकटस्थे वै सुरथस्य महापुरे ।\nदूतत्वेन ततो गत्वा प्रब्रूहि नृपतिं प्रति॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000591017, "chapter_id": 20591, "verse_number": "५-५०-१८", "content_sanskrit": "त्वया धृतो रामवाहो ज्ञानतोऽज्ञानतोपि वा ।\nअर्पयतु न वा यातु प्रधनं वीरसंयुतम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000591018, "chapter_id": 20591, "verse_number": "५-५०-१९", "content_sanskrit": "रामस्य दौत्यं लंकायां रावणं प्रति यत्कृतम् ।\nतथैव कुरु भूयिष्ठ बलसंयुतबुद्धिमन्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000591019, "chapter_id": 20591, "verse_number": "५-५०-२०", "content_sanskrit": "शेष उवाच ।\nएतच्छ्रुत्वांगदो वीर ओमिति प्रोच्य भूमिपम् ।\nजगाम संसदो मध्ये वीरश्रेणिसमन्विते॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000591020, "chapter_id": 20591, "verse_number": "५-५०-२१", "content_sanskrit": "ददर्श सुरथं भूपं तुलसीमंजरीधरम् ।\nरामभद्रं रसनया ब्रुवंतं सेवकान्निजान्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000591021, "chapter_id": 20591, "verse_number": "५-५०-२२", "content_sanskrit": "राजापि दृष्ट्वा प्लवगं मनोहरवपुर्धरम् ।\nशत्रुघ्नदूतं मत्वापि वालिजं प्रत्यभाषत॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000591022, "chapter_id": 20591, "verse_number": "५-५०-२३", "content_sanskrit": "सुरथ उवाच ।\nप्लवगाधिप कस्मात्त्वमागतोऽत्र कथं भवान् ।\nब्रूहि मे कारणं सर्वं यथा ज्ञात्वा करोमि तत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000591023, "chapter_id": 20591, "verse_number": "५-५०-२४", "content_sanskrit": "शेष उवाच ।\nइति संभाषमाणं तं प्रत्युवाच कपीश्वरः ।\nविस्मयंश्चेतसि भृशं रामसेवाकरं नृपम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000591024, "chapter_id": 20591, "verse_number": "५-५०-२५", "content_sanskrit": "जानीहि मां नृपश्रेष्ठ वालिपुत्रं हरीश्वरम् ।\nशत्रुघ्नेन च दूतत्वे प्रेषितो भवतोंऽतिकम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000591025, "chapter_id": 20591, "verse_number": "५-५०-२६", "content_sanskrit": "सेवकैः कैश्चिदागत्य धृतोऽश्वो मम सांप्रतम् ।\nअज्ञानतो महान्याय्यं कुर्वद्भिः सहसा नृप॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000591026, "chapter_id": 20591, "verse_number": "५-५०-२७", "content_sanskrit": "तमश्वं सह राज्येन सहपुत्रैर्मुदान्वितः ।\nशत्रुघ्नं याहि चरणे पतित्वाशु प्रदेहि च॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000591027, "chapter_id": 20591, "verse_number": "५-५०-२८", "content_sanskrit": "नोचेच्छत्रुघ्ननिर्मुक्तनाराचैः क्षतविग्रहः ।\nपृथ्वीतलमलं कुर्वञ्छयिष्यसि विशीर्षकः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000591028, "chapter_id": 20591, "verse_number": "५-५०-२९", "content_sanskrit": "येन लंकापतिर्नाशं प्रापितो लीलया क्षणात् ।\nतस्याश्वं यागयोग्यं तु हृत्वा कुत्र गमिष्यसि॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000591029, "chapter_id": 20591, "verse_number": "५-५०-३०", "content_sanskrit": "शेष उवाच ।\nइत्यादिभाषमाणं तं प्रत्युवाच महीश्वरः ।\nसर्वं तथ्यं ब्रवीषि त्वं नानृतं तव भाषितम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000591030, "chapter_id": 20591, "verse_number": "५-५०-३१", "content_sanskrit": "परं शृणुष्व मद्वाक्यं शत्रुघ्नपदसेवक ।\nमया धृतो महानश्वो रामचंद्रस्य धीमतः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000591031, "chapter_id": 20591, "verse_number": "५-५०-३२", "content_sanskrit": "न मोक्ष्ये सर्वथा वाहं शत्रुघ्नादिभयादहम् ।\nचेद्रामः स्वयमागत्य दर्शनं दास्यते मम॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000591032, "chapter_id": 20591, "verse_number": "५-५०-३३", "content_sanskrit": "तदाहं चरणौ नत्वा दास्यामि सुतसंयुतः ।\nसर्वं राज्यं कुटुंबं च धनं धान्यं बलं बहु॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000591033, "chapter_id": 20591, "verse_number": "५-५०-३४", "content_sanskrit": "क्षत्त्रियाणामयं धर्मः स्वामिनापि विरुद्ध्यते ।\nधर्मेण युद्धं तत्रापि रामदर्शनमिच्छता॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000591034, "chapter_id": 20591, "verse_number": "५-५०-३५", "content_sanskrit": "शत्रुघ्नादीन्प्रवीरांस्तानधुनाहं क्षणादपि ।\nजित्वा बध्नामि मद्गेहे नोचेद्रामः समाव्रजेत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000591035, "chapter_id": 20591, "verse_number": "५-५०-३६", "content_sanskrit": "शेष उवाच ।\nइति श्रुत्वांगदो धीमाञ्जहास नृपतिं तदा ।\nउवाच च महद्वाक्यं महाधैर्यसमन्वितम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000591036, "chapter_id": 20591, "verse_number": "५-५०-३७", "content_sanskrit": "अंगद उवाच ।\nबुद्धिहीनः प्रवदसि वृद्धत्वात्सागता तव ।\nयत्त्वं शत्रुघ्ननृपतिं धिक्करोषि धिया बली॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000591037, "chapter_id": 20591, "verse_number": "५-५०-३८", "content_sanskrit": "यो मांधातृरिपुं दैत्यं लवणं लीलयावधीत् ।\nयेनानेके जिताः संख्ये वैरिणः प्रबलोद्धताः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000591038, "chapter_id": 20591, "verse_number": "५-५०-३९", "content_sanskrit": "विद्युन्माली हतो येन राक्षसः कामगे स्थितः ।\nत्वं तं बध्नासि वीरेंद्रं मतिहीनः प्रभासि मे॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000591039, "chapter_id": 20591, "verse_number": "५-५०-४०", "content_sanskrit": "भ्रातृजो यस्य सुबली पुष्कलः परमास्त्रवित् ।\nयेन रुद्रगणः संख्ये वीरभद्रः सुतोषितः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000591040, "chapter_id": 20591, "verse_number": "५-५०-४१", "content_sanskrit": "वर्णयामि किमेतस्य पराक्रांतिं बलोर्जिताम् ।\nयेन नास्ति समः पृथ्व्यां बलेन यशसा श्रिया॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000591041, "chapter_id": 20591, "verse_number": "५-५०-४२", "content_sanskrit": "हनूमान्यस्य निकटे रघुनाथपदाब्जधीः ।\nयस्यानेकानि कर्माणि भविष्यंति श्रुतानि ते॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000591042, "chapter_id": 20591, "verse_number": "५-५०-४३", "content_sanskrit": "सत्रिकूटा राक्षसपूर्दग्धा येन क्षणाद्बलात् ।\nअक्षो येन हतः पुत्रो राक्षसेंद्रस्य दुर्मतेः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000591043, "chapter_id": 20591, "verse_number": "५-५०-४४", "content_sanskrit": "द्रोणोनाम गिरिर्येन पुच्छाग्रेण सदैवतः ।\nआनीतो जीवनार्थं तु सैनिकानां मुहुर्मुहुः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000591044, "chapter_id": 20591, "verse_number": "५-५०-४५", "content_sanskrit": "जानाति रामश्चारित्रं नान्यो जानाति मूढधीः ।\nयं कपींद्रं मनाक्स्वान्तान्न विस्मरति सेवकम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000591045, "chapter_id": 20591, "verse_number": "५-५०-४६", "content_sanskrit": "सुग्रीवाद्याः कपींद्रा ये पृथ्वीं सर्वां ग्रसंति ये ।\nते शत्रुघ्नं नृपं सर्वे सेवंते प्रेक्षणोत्सुकाः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000591046, "chapter_id": 20591, "verse_number": "५-५०-४७", "content_sanskrit": "कुशध्वजो नीलरत्नो रिपुतापो महास्त्रवित् ।\nप्रतापाग्र्यः सुबाहुश्च विमलः सुमदस्तथा॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000591047, "chapter_id": 20591, "verse_number": "५-५०-४८", "content_sanskrit": "राजा वीरमणिः सत्ययुतो रामस्य सेवकः ।\nएतेऽन्येपि नृपा भूमेः पतयः पर्युपासते॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000591048, "chapter_id": 20591, "verse_number": "५-५०-४९", "content_sanskrit": "तत्र त्वं वीर जलधौ मशकः को भवानिति ।\nतज्ज्ञात्वा गच्छ शत्रुघ्नं कृपालुं पुत्रकैर्युतः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000591049, "chapter_id": 20591, "verse_number": "५-५०-५०", "content_sanskrit": "वाहं समर्प्य गंतासि रामं राजीवलोचनम् ।\nदृष्ट्वा कृतार्थी कुरुषे स्वांगानि जनुषा सह॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000591050, "chapter_id": 20591, "verse_number": "५-५०-५१", "content_sanskrit": "शेष उवाच ।\nराजा प्रोवाच तं दूतं प्रब्रुवंतमनेकधा ।\nएतान्दर्शयसि क्षिप्रं सर्वे न ममगोचराः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000591051, "chapter_id": 20591, "verse_number": "५-५०-५२", "content_sanskrit": "यादृशं मद्बलं दूत तादृशं न हनूमतः ।\nयो रामं पृष्ठतः कृत्वा प्रागाद्यागस्य पालने॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000591052, "chapter_id": 20591, "verse_number": "५-५०-५३", "content_sanskrit": "यद्यहं मनसा वाचा कर्मणा कुतुकान्वितः ।\nभजामि रामं तर्ह्याशु दर्शयिष्यति स्वां तनुम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000591053, "chapter_id": 20591, "verse_number": "५-५०-५४", "content_sanskrit": "अन्यथा हनुमन्मुख्या वीरा बध्नंतु मां बलात् ।\nगृह्णंतु वाहं तरसा रामभक्तिसमन्विताः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000591054, "chapter_id": 20591, "verse_number": "५-५०-५५", "content_sanskrit": "गच्छ त्वं नृप शत्रुघ्नं कथयस्व ममोदितम् ।\nसज्जीभवंतु सुभटा एष यामि रणे बली॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000591055, "chapter_id": 20591, "verse_number": "५-५०-५६", "content_sanskrit": "स विचार्य यथायुक्तं करिष्यति रणांगणे ।\nमोचयंतु महावाहं न वामा मा ददंतु ते॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000591056, "chapter_id": 20591, "verse_number": "५-५०-५७", "content_sanskrit": "शेष उवाच ।\nइति श्रुत्वास्मि तं कृत्वा ययौ वीरो यतो नृपः ।\nगत्वा निवेदयामास यथोक्तं सुरथेन वै॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]