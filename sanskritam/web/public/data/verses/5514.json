[{"id": 2211765, "chapter_id": 5514, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2211766, "chapter_id": 5514, "verse_number": "१", "content_sanskrit": "अनेकान्तं बहुद्वारं धर्ममाहुर्मनीषिणः ।\nकिंलक्षणोऽसौ भवति तन्मे ब्रूहि जनार्दन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2211767, "chapter_id": 5514, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2211768, "chapter_id": 5514, "verse_number": "२", "content_sanskrit": "शृणु राजन् समासेन धर्मशौचविधिक्रमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2211769, "chapter_id": 5514, "verse_number": "३", "content_sanskrit": "अहिंसा सत्यमस्तेयमानृशंस्यं दमः शमः ।\nआर्जवं चैव राजेन्द्र निश्चितं धर्मलक्षणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2211770, "chapter_id": 5514, "verse_number": "४", "content_sanskrit": "ब्रह्मचर्यं तपः क्षान्तिर्मधुमांसस्य वर्जनम् ।\nमर्यादायां स्थितिश्चैव शमः शौचस्य लक्षणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2211771, "chapter_id": 5514, "verse_number": "५", "content_sanskrit": "बाल्ये विद्यां निषेवेत यौवने दारसङ्ग्रहम् ।\nवार्धके मौनमातिष्ठेत् सर्वदा धर्ममाचरेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2211772, "chapter_id": 5514, "verse_number": "६", "content_sanskrit": "ब्राह्मणान् नावमन्येत गुरून् परिवदेन्न च ।\nयतीनामनुकूलः स्याद् एष धर्मः सनातनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2211773, "chapter_id": 5514, "verse_number": "७", "content_sanskrit": "यतिर्गुरुर्द्विजातीनां वर्णानां ब्राह्मणो गुरुः ।\nपतिरेव गुरुः स्त्रीणां सर्वेषां पार्थिवो गुरुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2211774, "chapter_id": 5514, "verse_number": "८", "content_sanskrit": "यद् गृहस्थार्जितं पापं ज्ञानतोऽज्ञानतोऽपि वा ।\nनिर्दहिष्यति तत्सर्वमेकरात्रोषितो यतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2211775, "chapter_id": 5514, "verse_number": "९", "content_sanskrit": "दुर्वृत्ता वा सुवृत्ता वा ज्ञानिनोऽज्ञानिनोऽपि वा ।\nगृहस्थैर्यतयः पूज्या परत्र हितकाङ्क्षिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2211776, "chapter_id": 5514, "verse_number": "१०", "content_sanskrit": "एकदण्डी त्रिदण्डी वा शिखितो मुण्डितोऽपि वा ।\nकाषायदण्डसारोऽपि यतिः पूज्यो युधिष्ठिर ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2211777, "chapter_id": 5514, "verse_number": "११", "content_sanskrit": "अपूजितो गृहस्थैर्वा तथा चाप्यवमानितः ।\nयतिर्वाऽप्यतिथिर्वाऽपि नरके पातयिष्यतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2211778, "chapter_id": 5514, "verse_number": "१२", "content_sanskrit": "तस्मात् तु यतयः पूज्या मद्भक्ता मत्परायणाः ।\nमयि सन्न्यस्तकर्माणः परत्र हितकाङ्क्षिभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2211779, "chapter_id": 5514, "verse_number": "१३", "content_sanskrit": "प्रहरेन्न द्विजान् विप्रो गां न हन्यात् कदाचन ।\nभ्रूणहत्यासमं चैव उभयं यो निषेवते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2211780, "chapter_id": 5514, "verse_number": "१४", "content_sanskrit": "नाग्निं मुखेनोपधमेत् न च पादौ प्रतापयेत् ।\nनाधः कुर्यात् कदाचित्तु न पृष्ठं परितापयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2211781, "chapter_id": 5514, "verse_number": "१५", "content_sanskrit": "नान्तरा गमनं कुर्यान्न चामेध्यं विनिक्षिपेत् ।\nउच्छिष्टो न स्पृशेदग्निमशौचस्थो न जातुचित् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2211782, "chapter_id": 5514, "verse_number": "१६", "content_sanskrit": "श्वचण्डालादिभिः स्पृष्टो नाङ्गमग्नौ प्रतापयेत् ।\nसर्वदेवमयो वह्निस्तस्माच्छुद्धः सदा स्पृशेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2211783, "chapter_id": 5514, "verse_number": "१७", "content_sanskrit": "प्राप्तमूत्रपुरीषस्तु न स्पृशेद् वह्निमात्मवान् ।\nयावत्तु धारयेद् वेगं तावदप्रयतो भवेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2211784, "chapter_id": 5514, "verse_number": "१८", "content_sanskrit": "पचनाग्निं न गृह्णीयात् परवेश्मनि जातुचित् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2211785, "chapter_id": 5514, "verse_number": "१९", "content_sanskrit": "तेन पक्वेन चान्नेन यत्कर्म कुरुते शुभम् ।\nतच्छुभस्य फलं चार्धमग्निदत्तस्य भवेन्नृप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2211786, "chapter_id": 5514, "verse_number": "२०", "content_sanskrit": "तस्मात् शुभतरं कर्म प्रकुर्यादविनाशितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2211787, "chapter_id": 5514, "verse_number": "२१", "content_sanskrit": "प्रमादाद् यदि वाऽज्ञानात् तस्य नाशो भविष्यति ।\nगृह्णीयात् तु मथित्वा वा श्रोत्रियागारतोऽपि वा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2211788, "chapter_id": 5514, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2211789, "chapter_id": 5514, "verse_number": "२२", "content_sanskrit": "कीदृशाः साधवो विप्रास्तेभ्यो दत्तं महाफलम् ।\nकीदृशेभ्यो हि दातव्यं तन्मे ब्रूहि जनार्दन ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2211790, "chapter_id": 5514, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2211791, "chapter_id": 5514, "verse_number": "२३", "content_sanskrit": "अक्रोधनाः सत्यपरा धर्मनित्या जितेन्द्रियाः ।\nतादृशाः साधवो विप्रास्तेभ्यो दत्तं महत्फलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2211792, "chapter_id": 5514, "verse_number": "२४", "content_sanskrit": "अमानिनः सर्वसहा दृष्टार्था विजितेन्द्रियाः ।\nसर्वभूतहिता मैत्रास्तेभ्यो दत्तं महत्फलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2211793, "chapter_id": 5514, "verse_number": "२५", "content_sanskrit": "अलुब्धाः शुचयो वैद्या ह्रीमन्तः सत्यवादिनः ।\nस्वधर्मनिरता ये तु तेभ्यो दत्तं महत्फलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2211794, "chapter_id": 5514, "verse_number": "२६", "content_sanskrit": "साङ्गांश्च चतुरो वेदान् योऽधीयेत दिने दिने ।\nशूद्रान्नं यस्य देहे न तत् पात्रमृषयो विदुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2211795, "chapter_id": 5514, "verse_number": "२७", "content_sanskrit": "प्रज्ञाश्रुताभ्यां वृत्तेन शीलेन च समन्वितः ।\nतारयेत् तत्कुलं सर्वमेकोऽपीह युधिष्ठिर ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2211796, "chapter_id": 5514, "verse_number": "२८", "content_sanskrit": "गामश्वमन्नं वित्तं वा तद्विधे प्रतिपादयेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2211797, "chapter_id": 5514, "verse_number": "२९", "content_sanskrit": "निशम्य च गुणोपेतं ब्राह्मणं साधुसम्मतम् ।\nदूरादाहूय सत्कृत्य तं प्रयत्नेन पूजयेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2211798, "chapter_id": 5514, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2211799, "chapter_id": 5514, "verse_number": "३०", "content_sanskrit": "धर्माधर्मविधिर्देव मम भीष्मेण भाषितः ।\nभीष्मवाक्यात् सारभूतं वद धर्मं सुरेश्वर ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2211800, "chapter_id": 5514, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2211801, "chapter_id": 5514, "verse_number": "३१", "content_sanskrit": "अन्नेन धार्यते सर्वं जगदेतच्चराचरम् ।\nअन्नात् प्रभवति प्राणः प्रत्यक्षं नास्ति संशयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2211802, "chapter_id": 5514, "verse_number": "३२", "content_sanskrit": "कलत्रं पीडयित्वा तु देशकाले च शक्तितः ।\nदातव्यं भिक्षवे चान्नमात्मनो भूतिमिच्छता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2211803, "chapter_id": 5514, "verse_number": "३३", "content_sanskrit": "विप्रमध्वपरिश्रान्तं बालं वृद्धमथापि वा ।\nअर्चयेद् गुरुवत् प्रीतो गृहस्थो गृहमागतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2211804, "chapter_id": 5514, "verse_number": "३४", "content_sanskrit": "क्रोधमुत्पतितं हित्वा सुशीलो वीतमत्सरः ।\nअर्चयेदतिथिं प्रीतः परत्र हितभूतये ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2211805, "chapter_id": 5514, "verse_number": "३५", "content_sanskrit": "अतिथिं नावमन्येत नानृतां गिरमीरयेत् ।\nन पृच्छेद्गोत्रचरणं नाधीतं वा कदाचन ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2211806, "chapter_id": 5514, "verse_number": "३६", "content_sanskrit": "चण्डालो वा श्वपाको वा काले यः कश्चिदागतः ।\nअन्नेन पूजनीयः स्यात् परत्र हितमिच्छता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2211807, "chapter_id": 5514, "verse_number": "३७", "content_sanskrit": "पिधाय तु गृहद्वारं भुङ्क्ते योऽन्नं प्रहृष्टवान् ।\nस्वर्गद्वारपिधानं वै कृतं तेन युधिष्ठिर ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2211808, "chapter_id": 5514, "verse_number": "३८", "content_sanskrit": "पितॄन् देवान् ऋषीन् विप्रान् अतिथींश्च निराश्रयान् ।\nयो नरः प्रीणयत्यन्नैस्तस्य पुण्यफलं महत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2211809, "chapter_id": 5514, "verse_number": "३९", "content_sanskrit": "कृत्वाऽपि पापं बहुशो यो ददात्यन्नमर्थिने ।\nब्राह्मणाय विशेषेण सर्वपापैः प्रमुच्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2211810, "chapter_id": 5514, "verse_number": "४०", "content_sanskrit": "अन्नदः प्राणदो लोके प्राणदः सर्वदो भवेत् ।\nतस्मादन्नं प्रयत्नेन दातव्यं भूतिमिच्छता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2211811, "chapter_id": 5514, "verse_number": "४१", "content_sanskrit": "अन्नं ह्यमृतमित्याहुरन्नं प्रजननं स्मृतम् ।\nअन्नप्रणाशे सीदन्ति शरीरे पञ्च धातवः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2211812, "chapter_id": 5514, "verse_number": "४२", "content_sanskrit": "बलं बलवतो नश्येद् अन्नहीनस्य देहिनः ।\nतस्मादन्नं प्रदातव्यं श्रद्धयाऽश्रद्धयाऽपि वा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2211813, "chapter_id": 5514, "verse_number": "४३", "content_sanskrit": "आदत्ते हि रसं सर्वमादित्यः स्वगभस्तिभिः ।\nवायुस्तस्मात् समादाय रसं मेघेषु धारयेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2211814, "chapter_id": 5514, "verse_number": "४४", "content_sanskrit": "तत्तु मेघगतं भूमौ शक्रो वर्षति तद्रसम् ।\nतेन दिग्धा भवेद् देवी मही प्रीता च पाण्डव ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2211815, "chapter_id": 5514, "verse_number": "४५", "content_sanskrit": "तस्यां सस्यानि रोहन्ति यैर्जीवन्त्यखिलाः प्रजाः ।\nमांसमेदोस्थिमज्जानां सम्भवस्तेभ्यः एव हि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2211816, "chapter_id": 5514, "verse_number": "४६", "content_sanskrit": "एवं सूर्यश्च पवनो मेघः शक्रस्तथैव च ।\nएक एव स्थितो राशिर्यतो भूतानि जज्ञिरे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2211817, "chapter_id": 5514, "verse_number": "४७", "content_sanskrit": "भवनानि च दिव्यानि दिवि तेषां महात्मनाम् ।\nनानासंस्थानरूपाणि नानाभूतयुतानि च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2211818, "chapter_id": 5514, "verse_number": "४८", "content_sanskrit": "चन्द्रमण्डलशुभ्राणि किङ्किणीजालवन्ति च ।\nतरुणादित्यवर्णानि स्थावराणि चराणि च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2211819, "chapter_id": 5514, "verse_number": "४९", "content_sanskrit": "अनेकशतसङ्ख्यानि सान्तर्जलवनानि च ।\nतत्र पुष्पफलोपेताः कामदाः सुरपादपाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2211820, "chapter_id": 5514, "verse_number": "५०", "content_sanskrit": "वाप्यो दिव्याः सरः कूपाः दीर्घिकाश्च सहस्रशः ।\nभक्ष्यभोज्यमयाः शैला वासांस्याभरणानि च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2211821, "chapter_id": 5514, "verse_number": "५१", "content_sanskrit": "क्षीरस्रवन्त्यः सरितस्तथा चैवान्नपर्वताः ।\nघोषवन्ति च यानानि युक्तान्यथ सहस्रशः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2211822, "chapter_id": 5514, "verse_number": "५२", "content_sanskrit": "प्रासादाः पाण्डराः शुभ्राः शय्याश्च कनकोज्ज्वलाः ।\nअन्नदास्तत्र तिष्ठन्ति तस्मादन्नप्रदो भवेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2211823, "chapter_id": 5514, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे स्वर्गनरकगमनकथनं नाम अष्टाधिकशततमोऽध्यायः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]