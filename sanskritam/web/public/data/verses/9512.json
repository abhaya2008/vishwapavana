[{"id": 5000512000, "chapter_id": 9512, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000512001, "chapter_id": 9512, "verse_number": "६-१०५-१", "content_sanskrit": "ततो युद्धपरिश्रान्तं समरे चिन्तया स्थितम्।\nरावणं चाग्रतो दृष्ट्वा युद्धाय समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000512002, "chapter_id": 9512, "verse_number": "६-१०५-२", "content_sanskrit": "दैवतैश्च समागम्य द्रष्टुमभ्यागतो रणम्।\nउपगम्याब्रवीद् राममगस्त्यो भगवांस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000512003, "chapter_id": 9512, "verse_number": "६-१०५-३", "content_sanskrit": "राम राम महाबाहो शृणु गुह्यं सनातनम्।\nयेन सर्वानरीन् वत्स समरे विजयिष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000512004, "chapter_id": 9512, "verse_number": "६-१०५-४", "content_sanskrit": "आदित्यहृदयं पुण्यं सर्वशत्रुविनाशनम्।\nजयावहं जपं नित्यमक्षयं परमं शिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000512005, "chapter_id": 9512, "verse_number": "६-१०५-५", "content_sanskrit": "सर्वमङ्गलमाङ्गल्यं सर्वपापप्रणाशनम्।\nचिन्ताशोकप्रशमनमायुर्वर्धनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000512006, "chapter_id": 9512, "verse_number": "६-१०५-६", "content_sanskrit": "रश्मिमन्तं समुद्यन्तं देवासुरनमस्कृतम्।\nपूजयस्व विवस्वन्तं भास्करं भुवनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000512007, "chapter_id": 9512, "verse_number": "६-१०५-७", "content_sanskrit": "सर्वदेवात्मको ह्येष तेजस्वी रश्मिभावनः।\nएष देवासुरगणाँल्लोकान् पाति गभस्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000512008, "chapter_id": 9512, "verse_number": "६-१०५-८", "content_sanskrit": "एष ब्रह्मा च विष्णुश्च शिवः स्कन्दः प्रजापतिः।\nमहेन्द्रो धनदः कालो यमः सोमो ह्यपां पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000512009, "chapter_id": 9512, "verse_number": "६-१०५-९", "content_sanskrit": "पितरो वसवः साध्या अश्विनौ मरुतो मनुः।\nवायुर्वह्निः प्रजाः प्राण ऋतुकर्ता प्रभाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000512010, "chapter_id": 9512, "verse_number": "६-१०५-१०", "content_sanskrit": "आदित्यः सविता सूर्यः खगः पूषा गभस्तिमान्।\nसुवर्णसदृशो भानुर्हिरण्यरेता दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000512011, "chapter_id": 9512, "verse_number": "६-१०५-११", "content_sanskrit": "हरिदश्वः सहस्रार्चिः सप्तसप्तिर्मरीचिमान्।\nतिमिरोन्मथनः शम्भुस्त्वष्टा मार्तण्डकोंऽशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000512012, "chapter_id": 9512, "verse_number": "६-१०५-१२", "content_sanskrit": "हिरण्यगर्भः शिशिरस्तपनोऽहस्करो रविः।\nअग्निगर्भोऽदितेः पुत्रः शङ्खः शिशिरनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000512013, "chapter_id": 9512, "verse_number": "६-१०५-१३", "content_sanskrit": "व्योमनाथस्तमोभेदी ऋग्यजुःसामपारगः।\nघनवृष्टिरपां मित्रो विन्ध्यवीथीप्लवंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000512014, "chapter_id": 9512, "verse_number": "६-१०५-१४", "content_sanskrit": "आतपी मण्डली मृत्युः पिङ्गलः सर्वतापनः।\nकविर्विश्वो महातेजा रक्तः सर्वभवोद्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000512015, "chapter_id": 9512, "verse_number": "६-१०५-१५", "content_sanskrit": "नक्षत्रग्रहताराणामधिपो विश्वभावनः।\nतेजसामपि तेजस्वी द्वादशात्मन् नमोऽस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000512016, "chapter_id": 9512, "verse_number": "६-१०५-१६", "content_sanskrit": "नमः पूर्वाय गिरये पश्चिमायाद्रये नमः।\nज्योतिर्गणानां पतये दिनाधिपतये नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000512017, "chapter_id": 9512, "verse_number": "६-१०५-१७", "content_sanskrit": "जयाय जयभद्राय हर्यश्वाय नमो नमः।\nनमो नमः सहस्रांशो आदित्याय नमो नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000512018, "chapter_id": 9512, "verse_number": "६-१०५-१८", "content_sanskrit": "नम उग्राय वीराय सारङ्गाय नमो नमः।\nनमः पद्मप्रबोधाय प्रचण्डाय नमोऽस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000512019, "chapter_id": 9512, "verse_number": "६-१०५-१९", "content_sanskrit": "ब्रह्मेशानाच्युतेशाय सूरायादित्यवर्चसे।\nभास्वते सर्वभक्षाय रौद्राय वपुषे नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000512020, "chapter_id": 9512, "verse_number": "६-१०५-२०", "content_sanskrit": "तमोघ्नाय हिमघ्नाय शत्रुघ्नायामितात्मने।\nकृतघ्नघ्नाय देवाय ज्योतिषां पतये नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000512021, "chapter_id": 9512, "verse_number": "६-१०५-२१", "content_sanskrit": "तप्तचामीकराभाय हरये विश्वकर्मणे।\nनमस्तमोऽभिनिघ्नाय रुचये लोकसाक्षिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000512022, "chapter_id": 9512, "verse_number": "६-१०५-२२", "content_sanskrit": "नाशयत्येष वै भूतं तमेव सृजति प्रभुः।\nपायत्येष तपत्येष वर्षत्येष गभस्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000512023, "chapter_id": 9512, "verse_number": "६-१०५-२३", "content_sanskrit": "एष सुप्तेषु जागर्ति भूतेषु परिनिष्ठितः।\nएष चैवाग्निहोत्रं च फलं चैवाग्निहोत्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000512024, "chapter_id": 9512, "verse_number": "६-१०५-२४", "content_sanskrit": "देवाश्च क्रतवश्चैव क्रतूनां फलमेव च।\nयानि कृत्यानि लोकेषु सर्वेषु परमप्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000512025, "chapter_id": 9512, "verse_number": "६-१०५-२५", "content_sanskrit": "एनमापत्सु कृच्छ्रेषु कान्तारेषु भयेषु च।\nकीर्तयन् पुरुषः कश्चिन्नावसीदति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000512026, "chapter_id": 9512, "verse_number": "६-१०५-२६", "content_sanskrit": "पूजयस्वैनमेकाग्रो देवदेवं जगत्पतिम्।\nएतत् त्रिगुणितं जप्त्वा युद्धेषु विजयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000512027, "chapter_id": 9512, "verse_number": "६-१०५-२७", "content_sanskrit": "अस्मिन् क्षणे महाबाहो रावणं त्वं जहिष्यसि।\nएवमुक्त्वा ततोऽगस्त्यो जगाम स यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000512028, "chapter_id": 9512, "verse_number": "६-१०५-२८", "content_sanskrit": "एतच्छ्रुत्वा महातेजा नष्टशोकोऽभवत् तदा।\nधारयामास सुप्रीतो राघवः प्रयतात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000512029, "chapter_id": 9512, "verse_number": "६-१०५-२९", "content_sanskrit": "आदित्यं प्रेक्ष्य जप्त्वेदं परं हर्षमवाप्तवान्।\nत्रिराचम्य शुचिर्भूत्वा धनुरादाय वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000512030, "chapter_id": 9512, "verse_number": "६-१०५-३०", "content_sanskrit": "रावणं प्रेक्ष्य हृष्टात्मा जयार्थं समुपागमत्।\nसर्वयत्नेन महता वृतस्तस्य वधेऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000512031, "chapter_id": 9512, "verse_number": "६-१०५-३१", "content_sanskrit": "अथ रविरवदन्निरीक्ष्य रामं\nमुदितमनाः परमं प्रहृष्यमाणः।\nनिशिचरपतिसंक्षयं विदित्वा\nसुरगणमध्यगतो वचस्त्वरेति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000512032, "chapter_id": 9512, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]