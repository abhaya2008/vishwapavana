[{"id": 7001674000, "chapter_id": 21674, "verse_number": "१-६०-१", "content_sanskrit": "सनन्दन उवाच ।\nअवतीर्णेषु विप्रेषु यासः पुत्रसहायवान् ।\nतूर्ष्णीं ध्यानपरो धीमानेकांते समुपाविशत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001674001, "chapter_id": 21674, "verse_number": "१-६०-२", "content_sanskrit": "तमुवाचाशरीरी वाक् व्यासं पुत्रसमन्वितम् ।\nभो भो महर्षे वासिष्ठ ब्रह्मघोषो न वर्तते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001674002, "chapter_id": 21674, "verse_number": "१-६०-३", "content_sanskrit": "एको ध्यानपरस्तूष्णी किमास्से चिंतयन्निव ।\nब्रह्मघोषैर्विरहितः पर्वतोऽयं न शोभते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001674003, "chapter_id": 21674, "verse_number": "१-६०-४", "content_sanskrit": "तस्मादधीष्व भगवन्सार्द्ध पुत्रेण धीमता ।\nवेदान्वेदविदा चैव सुप्रसन्नमनाः सदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001674004, "chapter_id": 21674, "verse_number": "१-६०-५", "content_sanskrit": "तच्छुत्वा वचनं व्यासो नभोवाणीसमीरितम् ।\nशुकेन सह पुत्रेण वेदाभ्यासमथाकरोत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001674005, "chapter_id": 21674, "verse_number": "१-६०-६", "content_sanskrit": "तयोरभ्यसतोरेवं बहुकालं द्विजोत्तम ।\nवातोऽतिमात्रं प्रववौ समुद्रानिलवीजितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001674006, "chapter_id": 21674, "verse_number": "१-६०-७", "content_sanskrit": "ततोऽनध्याय इति तं व्यासः पुत्रमवारयत् ।\nशुको वारितमात्रस्तु कौतूहलसमन्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001674007, "chapter_id": 21674, "verse_number": "१-६०-८", "content_sanskrit": "अपृच्छत्पितरं तत्र कुतो वायुरभूदयम् ।\nआख्यातुमर्हति भवान्सर्वं वायोर्विचैष्टितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001674008, "chapter_id": 21674, "verse_number": "१-६०-९", "content_sanskrit": "शुकस्यैतद्वचः श्रुत्वा व्यासः परमविस्मितः ।\nअनध्यायनिमित्तऽस्मिन्निदं वचनं मब्रवीत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001674009, "chapter_id": 21674, "verse_number": "१-६०-१०", "content_sanskrit": "दिव्यं ते चक्षुरुत्पन्नं स्वस्थं ते निश्चलं मनः ।\nतमसा रजसा चापि त्यक्तः सत्ये व्यवस्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001674010, "chapter_id": 21674, "verse_number": "१-६०-११", "content_sanskrit": "तस्यात्मनि स्वयं वेदान्बुद्ध्वा समनुचिंतय ।\nदेवयानचरो विष्णोः पितृयानश्च तामसः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001674011, "chapter_id": 21674, "verse_number": "१-६०-१२", "content_sanskrit": "द्वावेतौ प्रत्ययं यातौ दिवं चाधश्च गच्छतः ।\nपिथिव्यामंतरिक्षे च यतः संयांति वायवः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001674012, "chapter_id": 21674, "verse_number": "१-६०-१३", "content_sanskrit": "सप्त ते वायुमार्गा वै तान्निबोधानुपूर्वशः ।\nतत्र देवगणाः साध्याः समभूवन्महाबलाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001674013, "chapter_id": 21674, "verse_number": "१-६०-१४", "content_sanskrit": "तेषामप्यभवत्पुत्रः समानो नाम दुर्जयः ।\nउदानस्तस्य पुत्रोऽभूव्द्यानस्तस्याभवत्सुतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001674014, "chapter_id": 21674, "verse_number": "१-६०-१५", "content_sanskrit": "अपानश्च ततो जज्ञे प्राणश्चापि ततः परम् ।\nअनपत्योऽभवत्प्राणो दुर्द्धर्षः शत्रुमर्दनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001674015, "chapter_id": 21674, "verse_number": "१-६०-१६", "content_sanskrit": "पृथक्क्र्म्माणि तेषां तु प्रवक्ष्यामि यथा तथा ।\nप्राणिनां सर्वतो वायुश्चेष्टा वर्तयते पृथक् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001674016, "chapter_id": 21674, "verse_number": "१-६०-१७", "content_sanskrit": "प्रीणनाञ्चैव सर्वेषां प्राण इत्यभिधीयते ।\nप्रेषयत्यभ्रसंघातान्धूमजांश्चोष्मजांस्तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001674017, "chapter_id": 21674, "verse_number": "१-६०-१८", "content_sanskrit": "प्रथमः प्रथमे मार्गे प्रवहो नाम सोऽनिलः ।\nअंबरे स्नेहमात्रेभ्यस्तडिद्भ्यश्चोत्तमद्युतिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001674018, "chapter_id": 21674, "verse_number": "१-६०-१९", "content_sanskrit": "आवहो नाम सोऽभ्येति द्वितीयः श्वसनो नदन् ।\nउदयं ज्योतिषां शश्वत्सोमादीनां करोति यः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001674019, "chapter_id": 21674, "verse_number": "१-६०-२०", "content_sanskrit": "अंतर्देहेषु चोदानं यं वदंति मनीषिणः ।\nयश्चतुर्भ्यः समुद्रेभ्यो वायुर्द्धारयते जलम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001674020, "chapter_id": 21674, "verse_number": "१-६०-२१", "content_sanskrit": "उद्धृत्य ददते चापो जीमूतेभ्यो वनेऽनिलः ।\nयोऽद्धिः संयोज्य जीमूतान्पर्जन्याय प्रयच्छती ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001674021, "chapter_id": 21674, "verse_number": "१-६०-२२", "content_sanskrit": "उद्वहो नाम बंहिष्ठस्तृतीयः स सदागतिः ।\nसंनीयमाना बहुधा येन नीला महाघनाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001674022, "chapter_id": 21674, "verse_number": "१-६०-२३", "content_sanskrit": "वर्षमोक्षकृतारंभास्ते भवंति घनाघनाः ।\nयोऽसौ वहति देवानां विमानानि विहायसा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001674023, "chapter_id": 21674, "verse_number": "१-६०-२४", "content_sanskrit": "चतुर्थः संवहो नाम वायुः स गिरिमर्दनः ।\n&nbsp;येन वेगवता रुग्णाः क्रियन्ते तरुजा रसाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001674024, "chapter_id": 21674, "verse_number": "१-६०-२५", "content_sanskrit": "पंचमः स महावेगो विवहो नाम मारुतः ।\nयस्मिन्परिप्लवे दिव्या वहंत्यापो विहायसा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001674025, "chapter_id": 21674, "verse_number": "१-६०-२६", "content_sanskrit": "पुण्यं चाकाशगंगायास्तोयं तिष्टति तिष्टति ।\nदूरात्प्रतिहतो यस्मिन्नेकरश्मिर्दिवाकरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001674026, "chapter_id": 21674, "verse_number": "१-६०-२७", "content_sanskrit": "योनिरंशुसहस्रस्य येन याति वसुंधराम् ।\nयस्मादाप्यायते सोमो निधिर्दिव्योऽमृतस्य च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001674027, "chapter_id": 21674, "verse_number": "१-६०-२८", "content_sanskrit": "षष्ठः परिवहो नाम स वायुर्जीवतां वरः ।\nसर्वप्राणभृतां प्राणार्न्योऽतकाले निरस्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001674028, "chapter_id": 21674, "verse_number": "१-६०-२९", "content_sanskrit": "यस्य धर्मेऽनुवर्तेते मृत्युवेवस्वतावुभौ ।\nसम्यगन्वीक्षता बुद्ध्या शांतयाऽध्यात्मनित्यया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001674029, "chapter_id": 21674, "verse_number": "१-६०-३०", "content_sanskrit": "ध्यानाभ्यासाभिरामाणां योऽमृतत्वाय कल्पते ।\nयं समासाद्य वेगेन दिशामंतं प्रपेदिरे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001674030, "chapter_id": 21674, "verse_number": "१-६०-३१", "content_sanskrit": "दक्षस्य दश पुत्राणां सहस्राणि प्रजापतेः ।\nयेन वृष्ट्या पराभूतस्तोयान्येन निवर्तते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001674031, "chapter_id": 21674, "verse_number": "१-६०-३२", "content_sanskrit": "परीवहो नाम वरो वायुः स दुरतिक्रमः ।\nएवमेते दितेः पुत्रा मरुतः परमाद्भुताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001674032, "chapter_id": 21674, "verse_number": "१-६०-३३", "content_sanskrit": "अनारमंतः सर्वांगाः सर्वचारिणः ।\nएतत्तु महदाश्चर्यं यदयं पर्वतोत्तमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001674033, "chapter_id": 21674, "verse_number": "१-६०-३४", "content_sanskrit": "कंपितः सहसा तेन पवमानेन वायुना ।\nविष्णोर्निःश्वासवातोऽयं यदा वेगसमीरितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001674034, "chapter_id": 21674, "verse_number": "१-६०-३५", "content_sanskrit": "सहसोदीर्यते तात जगत्प्रव्यथते तदा ।\nतस्माद्ब्रह्मविदो ब्रह्म न पठंत्यतिवायुतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001674035, "chapter_id": 21674, "verse_number": "१-६०-३६", "content_sanskrit": "वायोर्वायुभयं ह्युक्तं ब्रह्य तत्पीडितं भवेत् ।\nएतावदुक्त्वा वचनं पराशरसुतः प्रभुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001674036, "chapter_id": 21674, "verse_number": "१-६०-३७", "content_sanskrit": "उक्त्वा पुत्रमधीष्वेति व्योमगंगामगात्तदा ।\nततो व्यासे गते स्नातुं शुको ब्रह्मविदां वरः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001674037, "chapter_id": 21674, "verse_number": "१-६०-३८", "content_sanskrit": "स्वाध्यायमकरोद्ब्रह्मन्वेदवेदांगपारगः ।\nतत्र स्वाध्यायसंसक्तं शुकं व्याससुतं मुने ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001674038, "chapter_id": 21674, "verse_number": "१-६०-३९", "content_sanskrit": "सनत्कुमारो भगवानेकांते समुपागतः ।\nउत्थाय सत्कृतस्तेन ब्रह्मपुत्रो हि कार्ष्णिना ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001674039, "chapter_id": 21674, "verse_number": "१-६०-४०", "content_sanskrit": "ततः प्रोवाच विप्रेंद्र शुकं विदां वरः ।\nकिं करोषि महाभाग व्यासपुत्र महाद्युते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001674040, "chapter_id": 21674, "verse_number": "१-६०-४१", "content_sanskrit": "शुक उवाच ।\nस्वाध्याये संप्रवृत्तोऽहं ब्रह्मपुत्राधुना स्थितः ।\nत्वद्दर्शनमनुप्राप्तः केनापि सुकृतेन च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001674041, "chapter_id": 21674, "verse_number": "१-६०-४२", "content_sanskrit": "किंचित्त्वां प्रष्टुमिच्छामि तत्त्वं मोक्षार्थसाधनम् ।\nतद्वदस्व महाभाग यथा तज्ज्ञानमाप्नुयाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001674042, "chapter_id": 21674, "verse_number": "१-६०-४३", "content_sanskrit": "सनत्कुमार उवाच ।\nनास्ति विद्यासमं चक्षुर्नास्ति विद्यासमं तपः ।\nनास्ति रागसमं दुःखं नास्ति त्यागसमं सुखम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001674043, "chapter_id": 21674, "verse_number": "१-६०-४४", "content_sanskrit": "निवृत्तिः कर्मणः पापात्सततं पुण्यशीलता ।\nसद्वृत्तिः समुदाचारः श्रेय एतदनुत्तमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001674044, "chapter_id": 21674, "verse_number": "१-६०-४५", "content_sanskrit": "मानुष्यमसुखं प्राप्य यः सज्जति स मुह्यति ।\nनालं स दुःखमोक्षाय संगो वै दुःखलक्षणः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001674045, "chapter_id": 21674, "verse_number": "१-६०-४६", "content_sanskrit": "सक्तस्य बुद्धर्भवति मोहजालविवर्द्धिनी ।\nमोहजालावृतो दुःखमिहामुत्र तथाश्नुते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001674046, "chapter_id": 21674, "verse_number": "१-६०-४७", "content_sanskrit": "सर्वोपायेन कामस्य क्रोधस्य च विनिग्रहः ।\nकार्यः श्रेयोर्थिना तौ हि श्रेयोघातार्थमुद्यतौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001674047, "chapter_id": 21674, "verse_number": "१-६०-४८", "content_sanskrit": "नित्यं क्रोधात्तपो रक्षेच्छ्रियं रक्षेञ्च मत्सरात् ।\nविद्यां मानावमानाभ्यामात्मानं तु प्रमादतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001674048, "chapter_id": 21674, "verse_number": "१-६०-४९", "content_sanskrit": "आनृशंस्यं परो धर्मः क्षमा च परमं बलम् ।\nआत्मज्ञानं परं ज्ञानं सत्यं हि परमं हितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001674049, "chapter_id": 21674, "verse_number": "१-६०-५०", "content_sanskrit": "येन सर्वं परित्यक्तं स विद्वान्स च पंडितः ।\nइंद्रियैरिंद्रियार्‌थेभ्यश्चरत्यात्मवशैरिह ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001674050, "chapter_id": 21674, "verse_number": "१-६०-५१", "content_sanskrit": "असज्जमानः शांतात्मा निर्विकारः समाहितः ।\nआत्मभूतैरतद्भूतः सह चैव विनैव च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001674051, "chapter_id": 21674, "verse_number": "१-६०-५२", "content_sanskrit": "स विमुक्तः परं श्रेयो न चिरेणाधिगच्छति ।\nअदर्शनमसंस्पर्शस्तथैवाभाषाणं सदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001674052, "chapter_id": 21674, "verse_number": "१-६०-५३", "content_sanskrit": "यस्य भूतैः सह मुने स श्रेयो विंदते महत् ।\nन हिंस्यात्सर्वभूतानि भूतैर्मैत्रायणश्चरेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001674053, "chapter_id": 21674, "verse_number": "१-६०-५४", "content_sanskrit": "नेदं जन्म समासाद्य वैरं कुर्वीत केन चित् ।\nआकिंचन्यं सुसंतोषो निराशिष्ट्वमचापलम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001674054, "chapter_id": 21674, "verse_number": "१-६०-५५", "content_sanskrit": "एतदाहुः परं श्रेय आत्मज्ञस्य जितात्मनः ।\nपरिग्रहं परित्यज्य भव तातजितेंद्रियः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001674055, "chapter_id": 21674, "verse_number": "१-६०-५६", "content_sanskrit": "अशोकं स्थानमातिष्ट इह चामुत्र चाभयम् ।\nनिराशिषो न शोचंति त्यजेदाशिषमात्मनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001674056, "chapter_id": 21674, "verse_number": "१-६०-५७", "content_sanskrit": "परित्यज्याशिषं सौम्य दुःखग्रामाद्विमोक्ष्यसे ।\nतपरोनित्येन दांतेन मुनिना संयतात्मना ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001674057, "chapter_id": 21674, "verse_number": "१-६०-५८", "content_sanskrit": "अजितं जेतुकामेन भाव्यं संगेष्वसंगिना ।\nगुणसंगेष्वेष्वनासक्त एकचर्या रतः सदा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001674058, "chapter_id": 21674, "verse_number": "१-६०-५९", "content_sanskrit": "ब्राह्मणो न चिरादेव सुखमायात्यनुत्तमम् ।\nद्वंद्वारामेषु भूतेषु वराको रमते मुनिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001674059, "chapter_id": 21674, "verse_number": "१-६०-६०", "content_sanskrit": "किंचिन्प्रज्ञानतृप्तोऽसौ ज्ञानतृप्तो न शोचति ।\nशुभैर्लभेत देवत्वं व्यामिश्रैर्जन्म मानुषम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001674060, "chapter_id": 21674, "verse_number": "१-६०-६१", "content_sanskrit": "अशुभैश्चाप्यधो जन्म कर्मभिर्लभतेऽवशः ।\nतत्र मृत्युजरादुःखैः सततं समभिद्रुतम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001674061, "chapter_id": 21674, "verse_number": "१-६०-६२", "content_sanskrit": "संसारं पश्यते जंतुस्तत्कथं नावबुध्से ।\nअहिते हितसंज्ञस्त्वमध्रुवे ध्रुवसंज्ञकः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001674062, "chapter_id": 21674, "verse_number": "१-६०-६३", "content_sanskrit": "अनर्थे वार्थसंज्ञस्त्वं किमर्थं नावबुध्यसे ।\nसंवेष्ट्यमानं बहुभिर्मोहतंतुभिरात्मजैः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001674063, "chapter_id": 21674, "verse_number": "१-६०-६४", "content_sanskrit": "कोशकारवदात्मानं वेष्टितो नावबुध्यसे ।\nअलं परिग्रहेणेह दोषवान् हि परिग्रहः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001674064, "chapter_id": 21674, "verse_number": "१-६०-६५", "content_sanskrit": "कृमिर्हि कोशकारस्तु बध्यते स्वपरिग्रहात् ।\nपुत्रदारकुटुंबेषु सक्ताः सीदंति जंतवः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001674065, "chapter_id": 21674, "verse_number": "१-६०-६६", "content_sanskrit": "सरःपंकार्णवे मग्ना जीर्णा वनगजा इव ।\nमोहजालसमाकृष्टान्पश्यजंतून्सुदुःखितान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001674066, "chapter_id": 21674, "verse_number": "१-६०-६७", "content_sanskrit": "कुटुंबं पुत्रदारं च शरीरं द्रव्यसंचयम् ।\nपारक्यमध्रुवं सर्वं किं स्वं सुकृतदुष्कृते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001674067, "chapter_id": 21674, "verse_number": "१-६०-६८", "content_sanskrit": "यदा सर्वं परित्यज्य गंतव्यमवशेन वै ।\nअनर्थे किं प्रसक्तस्त्वं स्वमर्थं नानुतिष्टसि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001674068, "chapter_id": 21674, "verse_number": "१-६०-६९", "content_sanskrit": "अविश्रांतमनालंबमपाथेयमदैशिकम् ।\nतमः कर्त्तारमध्वानं कथमेको गमिष्यसि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001674069, "chapter_id": 21674, "verse_number": "१-६०-७०", "content_sanskrit": "नहि त्वां प्रस्थितं कश्चित्पृष्टतोऽनुगमिष्यति ।\nसुकृतं दुष्कृतं च त्वां गच्छंतमनुयास्यतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001674070, "chapter_id": 21674, "verse_number": "१-६०-७१", "content_sanskrit": "विद्या कर्म च शौर्यं च ज्ञानं च बहुविस्तरम् ।\nअर्थार्थमनुशीर्यंते सिद्धार्थस्तु विमुच्यते ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001674071, "chapter_id": 21674, "verse_number": "१-६०-७२", "content_sanskrit": "निबंधिनी रज्जुरेषा या ग्रामे वसतो रतिः ।\nछित्वैनां सुकृतो यांति नैनां छिंदंति दुष्कृतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001674072, "chapter_id": 21674, "verse_number": "१-६०-७३", "content_sanskrit": "तुल्यजातिवयोरूपान् हृतान्पस्यसि मृत्युना ।\nन च नामास्ति निर्वेदो लोहं हि हृदयं तव ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001674073, "chapter_id": 21674, "verse_number": "१-६०-७४", "content_sanskrit": "रूपकूलां मनः स्रोतां स्पर्शद्वीपां रसावहाम् ।\nगंधपंकां शब्दजलां स्वर्गमार्गदुरारुहाम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001674074, "chapter_id": 21674, "verse_number": "१-६०-७५", "content_sanskrit": "क्षमारित्रां सत्यमयीं धर्मस्थैर्यकराकराम् ।\nत्यागवाताध्वगां शीघ्रां बुद्धिनावं नदीं तरेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001674075, "chapter_id": 21674, "verse_number": "१-६०-७६", "content_sanskrit": "त्यक्त्वा धर्ममधर्मं च ह्युभे सत्यानृते त्यज ।\nत्यज धर्ममसंकल्पादधर्मं चाप्यहिंसया ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001674076, "chapter_id": 21674, "verse_number": "१-६०-७७", "content_sanskrit": "उभे सत्यानृते बुद्धिं परमनिश्चयात् ।\nअस्थिस्थूणं स्नायुयुतं मांसशोणितलेपनम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001674077, "chapter_id": 21674, "verse_number": "१-६०-७८", "content_sanskrit": "धर्मावनद्धं दुर्गंधिं पूर्णं मूत्रपुरीषयोः ।\nजराशोकसमाविष्टं रोगायतनमस्थिरम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001674078, "chapter_id": 21674, "verse_number": "१-६०-७९", "content_sanskrit": "रजस्वलमनित्यं च भूतावासं समुत्सृज ।\nइदं विश्वं जगत्सर्वमजगञ्चापि यद्भवेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001674079, "chapter_id": 21674, "verse_number": "१-६०-८०", "content_sanskrit": "महाभूतात्मकं सर्वमस्माद्यत्परमाणुमत् ।\nइंद्रियाणि च पंचैव तमः सत्त्वं रजस्तथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001674080, "chapter_id": 21674, "verse_number": "१-६०-८१", "content_sanskrit": "इत्येष सप्तदशको राशिख्यक्तसंज्ञकः ।\nसर्वैरिहेंद्रियार्थैश्च व्यक्ताव्यक्तैर्हि हितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001674081, "chapter_id": 21674, "verse_number": "१-६०-८२", "content_sanskrit": "पंचविंशक इत्येष व्यक्ताव्यक्तमयो गणः ।\nएतैः सर्वैः समायुक्तमनित्यमभिधीयते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001674082, "chapter_id": 21674, "verse_number": "१-६०-८३", "content_sanskrit": "त्रिवर्गोऽत्र सुखं दुःख जीवितं मरणं तथा ।\nय इदं वेद तत्त्वेन सस वेद प्रभवाप्ययौ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001674083, "chapter_id": 21674, "verse_number": "१-६०-८४", "content_sanskrit": "इन्द्रियैर्गृह्यते यद्यत्तद्व्यक्तमभिधीयते ।\nअव्यक्तमथ तज्ज्ञेयं लिंगग्राह्यमतींद्रियम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001674084, "chapter_id": 21674, "verse_number": "१-६०-८५", "content_sanskrit": "इन्द्रियैर्नियतैर्देही धाराभिरिव तर्प्यते ।\nलोके विहितमात्मानं लोकं चात्मनि पश्यति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001674085, "chapter_id": 21674, "verse_number": "१-६०-८६", "content_sanskrit": "परावरदृशः शक्तिर्ज्ञानवेलां न पश्यति ।\nपश्यतः सर्वभूतानि सर्वावस्थासु सर्वदा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001674086, "chapter_id": 21674, "verse_number": "१-६०-८७", "content_sanskrit": "ब्रह्मभूतस्य संयोगो नाशुभेनोपपद्यते ।\nज्ञानेन विविधात्क्लेशान्न निवृत्तिश्च देहजात् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001674087, "chapter_id": 21674, "verse_number": "१-६०-८८", "content_sanskrit": "लोकबुद्धिप्रकाशेन लोकमार्गो न रिष्यति ।\nअनादिनिधनं जंतुमात्मनि स्थितमव्ययम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001674088, "chapter_id": 21674, "verse_number": "१-६०-८९", "content_sanskrit": "अकर्तारममूढं च भगवानाह तीर्तवित् ।\nयो जन्तुः स्वकृतैस्तैस्तैः कर्मभिर्नित्यदुःखितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001674089, "chapter_id": 21674, "verse_number": "१-६०-९०", "content_sanskrit": "स्वदुःखप्रतिघातार्थं हंति जंतुरनेकधा ।\nततः कर्म समादत्ते पुनरन्यन्नवं बहु ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001674090, "chapter_id": 21674, "verse_number": "१-६०-९१", "content_sanskrit": "तप्यतेऽथ पुनस्तेन भुक्त्वाऽपथ्यमिवातुरः ।\nअजस्रमेव मोहांतो दुःखेषु सुखसंज्ञितः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001674091, "chapter_id": 21674, "verse_number": "१-६०-९२", "content_sanskrit": "वध्यते तप्यते चैव भयवत्यर्मभिः सदा ।\nततो निवृत्तो बंधात्स्वात्कर्मणामुदयादिह ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001674092, "chapter_id": 21674, "verse_number": "१-६०-९३", "content_sanskrit": "परिभ्रमति संसारे चक्रवद्बाहुवर्जितः ।\nसंयमेन च संबंधान्निवृत्त्या तपसो बलात् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001674093, "chapter_id": 21674, "verse_number": "१-६०-९४", "content_sanskrit": "सम्प्राप्ता बहवः सिद्धिं अव्याबाधां सुखोदयाम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]