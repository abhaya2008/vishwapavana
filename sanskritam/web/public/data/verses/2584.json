[{"id": 2074948, "chapter_id": 2584, "verse_number": "१२-८९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074949, "chapter_id": 2584, "verse_number": "१२-८९-१", "content_sanskrit": "वनस्पतीभक्ष्यफलान्न च्छिन्द्युर्विषये तव।\nब्राह्मणानां मूलफलं धर्ममाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074950, "chapter_id": 2584, "verse_number": "१२-८९-२", "content_sanskrit": "ब्राह्मणेभ्योऽतिरिक्तं च भुञ्जीरन्नितरे जनाः।\nन ब्राह्मणोपरोधेन हरेदन्यः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074951, "chapter_id": 2584, "verse_number": "१२-८९-३", "content_sanskrit": "विप्रश्चेत्त्यागमातिष्ठेदाख्याया वृत्तिकर्शितः।\nपरिकल्यास्य वृत्तिः स्यात्सदारस्य नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074952, "chapter_id": 2584, "verse_number": "१२-८९-४", "content_sanskrit": "स चेन्नोपनिवर्तेत वाच्यो ब्राह्मणसंसदि।\nकस्मिन्निदानीं मर्यादामयं लोकः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074953, "chapter_id": 2584, "verse_number": "१२-८९-५", "content_sanskrit": "असंशयं निवर्तेत न चेत्त्यक्ष्यत्यतः परम्।\nपूर्वं परोक्षं वक्तव्यमेतत्कौन्तेय शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074954, "chapter_id": 2584, "verse_number": "१२-८९-६", "content_sanskrit": "आहुरेतज्जना ब्रह्मन्न चैतच्छ्रद्दधाम्यहम्।\nनिमन्त्र्यश्च भवेद्भोगैरवृत्त्या च तदा चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074955, "chapter_id": 2584, "verse_number": "१२-८९-७", "content_sanskrit": "कृषिगोरक्ष्यवाणिज्यं लोकानामिह जीवनम्।\nऊर्ध्वं चैव त्रयी विद्या सा भूतान्भावयत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074956, "chapter_id": 2584, "verse_number": "१२-८९-८", "content_sanskrit": "तस्यां प्रपतमानायां ये स्युस्तत्परिपन्थिनः।\nदस्यवस्तद्वधायेह ब्रह्मा क्षत्रमथासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074957, "chapter_id": 2584, "verse_number": "१२-८९-९", "content_sanskrit": "शत्रूञ्जय प्रजा रक्ष यजस्व क्रतुभिर्नृप।\nयुध्यस्व समरे वीरो भूत्वा कौरवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074958, "chapter_id": 2584, "verse_number": "१२-८९-१०", "content_sanskrit": "संरक्ष्यान्रक्षते राजा स राजा राजसत्तमः।\nये केचित्तान्न रक्षन्ति तैरर्थो नास्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074959, "chapter_id": 2584, "verse_number": "१२-८९-११", "content_sanskrit": "सदैव राज्ञा योद्धव्यं सर्वलोकाद्युधिष्ठिर।\nतस्याद्धेतोर्हि भुञ्जीत मनुष्यानेव मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074960, "chapter_id": 2584, "verse_number": "१२-८९-१२", "content_sanskrit": "आन्तरेभ्यः परान्रक्षन्परेभ्यः पुनरान्तरान्।\nपरान्परेभ्यः स्वान्खेभ्यः सर्वान्पालय नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074961, "chapter_id": 2584, "verse_number": "१२-८९-१३", "content_sanskrit": "आत्मानं सर्वतो रक्षन्राजन्रक्षस्व मेदिनीम्।\nआत्ममूलमिदं सर्वमाहुर्वै विदुषो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074962, "chapter_id": 2584, "verse_number": "१२-८९-१४", "content_sanskrit": "किं छिद्रं कोनु सङ्गो मे किंवाऽस्त्यविनिपातितम्।\nकुतो मामाश्रयेद्दोष इति नित्यं विचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074963, "chapter_id": 2584, "verse_number": "१२-८९-१५", "content_sanskrit": "अतीतदिवसे वृत्तं प्रशंसन्ति न वा पुनः।\nगुप्तैश्चारैरनुमतैः पृथिवीमनुसारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074964, "chapter_id": 2584, "verse_number": "१२-८९-१६", "content_sanskrit": "जानीत यदि मे वृत्तं प्रशंसन्ति न वा पुनः।\nकच्चिद्रोचेज्जनपदे कच्चिद्राष्ट्रे च मे वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074965, "chapter_id": 2584, "verse_number": "१२-८९-१७", "content_sanskrit": "धर्मज्ञानां धृतिमतां संग्रामेष्वपलायिनाम्।\nराष्ट्रे तु येऽनुजीवन्ति ये तु राज्ञोऽनुजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074966, "chapter_id": 2584, "verse_number": "१२-८९-१८", "content_sanskrit": "अमात्यानां च सर्वेषां मध्यस्थानां च सर्वशः।\nये च त्वाऽभिप्रशंसेयुर्निन्देयुरथवा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074967, "chapter_id": 2584, "verse_number": "१२-८९-१९", "content_sanskrit": "सर्वान्सुपरिणीतांस्तान्कारयेथा युधिष्ठिर।\nएकान्तेन हि सर्वेषां न शक्यं तात रोचितुम्।\nमित्रामित्रमथो मध्यं सर्वभूतेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074968, "chapter_id": 2584, "verse_number": "१२-८९-२०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074969, "chapter_id": 2584, "verse_number": "१२-८९-२०", "content_sanskrit": "तुल्यबाहुबलानां च तुल्यानां च गुणैरपि।\nकथं स्यादधिकः कश्चित्स च भुञ्जीत मानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074970, "chapter_id": 2584, "verse_number": "१२-८९-२१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074971, "chapter_id": 2584, "verse_number": "१२-८९-२१", "content_sanskrit": "यच्चरा ह्यचरानद्युरदंष्ट्रान्दंष्ट्रिणस्तथा।\nआशीविषा इव क्रुद्धा भुजङ्गान्भुजगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074972, "chapter_id": 2584, "verse_number": "१२-८९-२२", "content_sanskrit": "एतेभ्यश्चाप्रमत्तः स्यात्सदा शत्रोर्युधिष्ठिर।\nभारुण्डसदृशा ह्येते निपतन्ति प्रमादतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074973, "chapter_id": 2584, "verse_number": "१२-८९-२३", "content_sanskrit": "कच्चित्ते वणिजो राष्ट्रे नोद्विजन्ति करार्दिताः।\nक्रीणन्तो बहुनाऽल्पेन कान्तारकृतविश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074974, "chapter_id": 2584, "verse_number": "१२-८९-२४", "content_sanskrit": "कच्चित्कृषिकरा राष्ट्रं न जहत्यतिपीडिताः।\nये बहन्ति धुरं राज्ञां ते भरन्तीतरानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074975, "chapter_id": 2584, "verse_number": "१२-८९-२५", "content_sanskrit": "`आलस्येन हृतः पादः पादः पाषण़्डमाश्रितः।\nराजानं सेवते पादः पादः कृषिमुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074976, "chapter_id": 2584, "verse_number": "१२-८९-२६", "content_sanskrit": "एकपादं त्रयः पादा भक्षयन्ति दिनेदिने।\nतस्मात्सर्वप्रयत्नेन पादं रक्ष युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074977, "chapter_id": 2584, "verse_number": "१२-८९-२७", "content_sanskrit": "इतो दत्तेन जीवन्ति देवाः पितृगणास्तथा।\nमानुषोरगरक्षांसि वयांसि पशवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074978, "chapter_id": 2584, "verse_number": "१२-८९-२८", "content_sanskrit": "एषा ते राष्ट्रवृत्तिश्च राज्ञां गुप्तिश्च भारत।\nप्रोक्तोद्दिश्यैतमेवार्थं भूयो वक्ष्यामि पा--व॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074979, "chapter_id": 2584, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोननवतितमोऽध्यायः॥ ८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]