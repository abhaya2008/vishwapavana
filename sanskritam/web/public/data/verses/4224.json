[{"id": 2148934, "chapter_id": 4224, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148935, "chapter_id": 4224, "verse_number": "१", "content_sanskrit": "आपगेयं महात्मानं भीष्मं शस्त्रभृतां वरम् ।\nपितामहं भारतानां ध्वजं सर्वमहीक्षिताम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148936, "chapter_id": 4224, "verse_number": "२", "content_sanskrit": "बृहस्पतिसमं बुद्ध्या क्षमया पृथिवीसमम् ।\nसमुद्रमिव गाम्भीर्ये हिमवन्तमिवातुलम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148937, "chapter_id": 4224, "verse_number": "३", "content_sanskrit": "प्रजापतिमिवौदार्ये तेजसा भास्करोपमम् ।\nमहेन्द्रमिव शत्रूणां ध्वंसने शरवृष्टिभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148938, "chapter_id": 4224, "verse_number": "४", "content_sanskrit": "रणयज्ञे प्रवितते सुभीमे रोमहर्षणे ।\nदीक्षितं चिररात्राय श्रुत्वा राजा युधिष्ठिरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148939, "chapter_id": 4224, "verse_number": "५", "content_sanskrit": "किमब्रवीन्महाबाहुः सर्वधर्मविशारदः ।\nभीमसेनार्जुनौ वाऽपि कृष्णो वा प्रत्यपद्यत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148940, "chapter_id": 4224, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148941, "chapter_id": 4224, "verse_number": "६", "content_sanskrit": "आपद्धर्मार्थकुशलो महाबुद्धिर्युधिष्ठिरः ।\nसर्वान् भ्रातॄन् समानीय वासुदेवं च शाश्वतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148942, "chapter_id": 4224, "verse_number": "७", "content_sanskrit": "उवाच वदतां श्रेष्ठः सान्त्वपूर्वमिदं वचः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148943, "chapter_id": 4224, "verse_number": "८", "content_sanskrit": "पर्याक्रामत सैन्यानि यत्तास्तिष्ठत दंसिताः ।\nपितामहेन वो युद्धं पूर्वमेव भविष्यति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148944, "chapter_id": 4224, "verse_number": "९", "content_sanskrit": "तस्मात् सप्तसु सेनासु प्रणेतॄन् मम पश्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148945, "chapter_id": 4224, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148946, "chapter_id": 4224, "verse_number": "१०", "content_sanskrit": "यथाऽर्हति भवान् वक्तुमस्मिन् काले ह्युपस्थिते ।\nतदेतदर्थवद् वाक्यमुक्तं ते भरतर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148947, "chapter_id": 4224, "verse_number": "११", "content_sanskrit": "रोचते मे महाबाहो क्रियतां यदनन्तरम् ।\nनायकास्तव सैन्यानां क्रियन्तामिव सप्त वै\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148948, "chapter_id": 4224, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148949, "chapter_id": 4224, "verse_number": "१२", "content_sanskrit": "ततो द्रुपदमानीय विराटं शिनिपुङ्गवम् ।\nधृष्टद्युम्नं च पाञ्चाल्यं धृष्टकेतुं च पार्थिवम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148950, "chapter_id": 4224, "verse_number": "१३", "content_sanskrit": "शिखण्डिनं च पाञ्चाल्यं सहदेवं च मागधम् ।\nएतान् सप्त महेष्वासान् वीरान् युद्धाभिनन्दिनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148951, "chapter_id": 4224, "verse_number": "१४", "content_sanskrit": "सेनाप्रणेतॄन् विधिवद् अभ्यषिञ्चद् युधिष्ठिरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148952, "chapter_id": 4224, "verse_number": "१५", "content_sanskrit": "सर्वसेनापतिं चात्र धृष्टद्युम्नमथादिशत् ।\nद्रोणान्तहेतुरुत्पन्नो य इष्टाज्जातवेदसः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148953, "chapter_id": 4224, "verse_number": "१६", "content_sanskrit": "सर्वेषामेव तेषां तु समस्तानां महात्मनाम् ।\nसेनापतिपतिं चक्रे गुडाकेशं धनञ्जयम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148954, "chapter_id": 4224, "verse_number": "१७", "content_sanskrit": "अर्जुनस्यापि नेता च संयन्ता चैव वाजिनाम् ।\nसङ्कर्षणानुजः श्रीमान् महाबुद्धिर्जनार्दनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148955, "chapter_id": 4224, "verse_number": "१८", "content_sanskrit": "तद् दृष्ट्वोपस्थितं युद्धं समासन्नं महात्ययम् ।\nप्राविशद् भवनं राज्ञः पाण्डवस्य हलायुधः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148956, "chapter_id": 4224, "verse_number": "१९", "content_sanskrit": "सहाक्रूरप्रभृतिभिः गदसाम्बोद्धवादिभिः ।\nरौग्मिणेयाहुकयुतैः चारुदेष्णपुरोगमैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148957, "chapter_id": 4224, "verse_number": "२०", "content_sanskrit": "वृष्णिमुख्यैरुपगतैः व्याघ्रैरिव मदोत्कटैः ।\nअभिगुप्तो महाबाहुः मरुद्भिरिव वासवः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148958, "chapter_id": 4224, "verse_number": "२१", "content_sanskrit": "नीलकौशेयवसनः कैलासशिखरोपमः ।\nसिंहखेलगतिः श्रीमान् मदरक्तान्तलोचनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148959, "chapter_id": 4224, "verse_number": "२२", "content_sanskrit": "तं दृष्ट्वा धर्मराजश्च केशवश्च महाद्युतिः ।\nउदतिष्ठत् ततः पार्थो भीमकर्मा वृकोदरः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148960, "chapter_id": 4224, "verse_number": "२३", "content_sanskrit": "गाण्डीवधन्वा ये चान्ये राजानस्तत्र केचन ।\nपूजयाञ्चक्रुरभ्येत्य ते स्म सर्वे हलायुधम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148961, "chapter_id": 4224, "verse_number": "२४", "content_sanskrit": "ततस्तं पाण्डवो राजा करे पस्पर्श पाणिना ।\nवासुदेवपुरोगास्तं सर्व एवाभ्यवादयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148962, "chapter_id": 4224, "verse_number": "२५", "content_sanskrit": "विराटद्रुपदौ वृद्धावभिवाद्य हलायुधः ।\nयुधिष्ठिरेण सहित उपाविशदरिन्दमः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148963, "chapter_id": 4224, "verse_number": "२६", "content_sanskrit": "ततस्तेषूपविष्टेषु पार्थिवेषु समन्ततः ।\nवासुदेवमभिप्रेक्ष्य रौहिणेयोऽभ्यभाषत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148964, "chapter_id": 4224, "verse_number": "२७", "content_sanskrit": "भविताऽयं महारौद्रो दारुणः पुरुषक्षयः ।\nदिष्टमेतद् ध्रुवं मन्ये न शक्यमतिवर्तितुम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148965, "chapter_id": 4224, "verse_number": "२८", "content_sanskrit": "तस्माद् युद्धात् समुत्तीर्णान् अपि वः ससुहृद्गणान् ।\nअरोगानक्षतैर्देहैः द्रष्टास्मीति मतिर्मम\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148966, "chapter_id": 4224, "verse_number": "२९", "content_sanskrit": "समेतं पार्थिवं क्षत्रं कालपक्वमसंशयम् ।\nविमर्दः सुमहान् भावी मांसशोणितकर्दमः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148967, "chapter_id": 4224, "verse_number": "३०", "content_sanskrit": "उक्तो मया वासुदेवः पुनः पुनरुपह्वरे ।\nसम्बन्धिषु समां वृत्तिं वर्तस्व मधुसूदन\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148968, "chapter_id": 4224, "verse_number": "३१", "content_sanskrit": "पाण्डवा हि यथाऽस्माकं तथा दुर्योधनो नृपः ।\nतस्यापि क्रियतां साह्यं स पर्येति पुनः पुनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148969, "chapter_id": 4224, "verse_number": "३२", "content_sanskrit": "तच्च मे नाकरोद् वाक्यं त्वदर्थे मधुसूदनः ।\nनिविष्टः सर्वभावेन धनञ्जयमवेक्ष्य ह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148970, "chapter_id": 4224, "verse_number": "३३", "content_sanskrit": "ध्रुवो जयः पाण्डवानामिति मे निश्चिता मतिः ।\nतथा ह्यभिनिवेशोऽयं वासुदेवस्य भारत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148971, "chapter_id": 4224, "verse_number": "३४", "content_sanskrit": "न चाहमुत्सहे कृष्णम् ऋते लोकमुदीक्षितुम् ।\nततोऽहमनुवर्तामि केशवस्य चिकीर्षितम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148972, "chapter_id": 4224, "verse_number": "३५", "content_sanskrit": "उभौ शिष्यौ हि मे वीरौ गदायुद्धविशारदौ ।\nतुल्यस्नेहोऽस्म्यतो भीमे तथा दुर्योधने नृपे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148973, "chapter_id": 4224, "verse_number": "३६", "content_sanskrit": "तस्माद् यास्यामि तीर्थानि सरस्वत्या निषेवितुम् ।\nन हि शक्ष्यामि कौरव्यान् नश्यमानानवेक्षितुम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148974, "chapter_id": 4224, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148975, "chapter_id": 4224, "verse_number": "३७", "content_sanskrit": "एवमुक्त्वा महाबाहुरनुज्ञातश्च पाण्डवैः ।\nतीर्थयात्रां ययौ रामो निमन्त्र्य मधुसूदनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2148976, "chapter_id": 4224, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चपञ्चाशोत्तरशततमोऽध्यायः ॥१५५॥\nभीष्माभिषेचनपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]