[{"id": 2045058, "chapter_id": 2005, "verse_number": "६-५४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045059, "chapter_id": 2005, "verse_number": "६-५४-१", "content_sanskrit": "मम पुत्रसमादिष्टः कलिङ्गोः वाहिनीपतिः।\nकथमद्भुतकर्माणं भीमसेनं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045060, "chapter_id": 2005, "verse_number": "६-५४-२", "content_sanskrit": "चरन्तं गदया वीर दण्डहस्तमिवान्तकम् ।\nयोधयामास समरे कलिङ्गः सह सेनया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045061, "chapter_id": 2005, "verse_number": "६-५४-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045062, "chapter_id": 2005, "verse_number": "६-५४-३", "content_sanskrit": "पुत्रेण तव राजेन्द्र स तथोक्तो महाबलः ।\nमहत्या सेनया गुप्तः प्रायाद्भीमरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045063, "chapter_id": 2005, "verse_number": "६-५४-४", "content_sanskrit": "तामापतन्तीं महतीं कलिङ्गानां महाचमूम्।\nरथाश्वनागकलिलां प्रगृहीतमहायुधाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045064, "chapter_id": 2005, "verse_number": "६-५४-५", "content_sanskrit": "भीमसेनः कलिङ्गानामार्च्छद्भारत वाहिनीम् ।\nकेतुमन्तं च नैषादिमायान्तं सह चेदिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045065, "chapter_id": 2005, "verse_number": "६-५४-६", "content_sanskrit": "ततः श्रुतायुः संक्रुद्धो राज्ञा केतुमता सह।\nआससाद रणे भीमं व्यूढानीकेषु चेदिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045066, "chapter_id": 2005, "verse_number": "६-५४-७", "content_sanskrit": "रथैरनेकसाहस्रैः कलिङ्गानां नराधिप ।\nअयुतेन गजानां च निषादैःक सह केतुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045067, "chapter_id": 2005, "verse_number": "६-५४-८", "content_sanskrit": "भिमसेनं रणे राजन्समन्तात्पर्यवारयत् ।\nचेदिमत्स्यकरूषाश्च भीमसेनपदानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045068, "chapter_id": 2005, "verse_number": "६-५४-९", "content_sanskrit": "अभ्यधावन्त समरे निषादान्सह राजभिः ।\nततः प्रववृते युद्धं घोररूपं भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045069, "chapter_id": 2005, "verse_number": "६-५४-१०", "content_sanskrit": "न प्राजानन्त योधाः स्वान्परस्परजिघांसया ।\nघोरमासीत्ततो युद्धं भीमस्य सहसा परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045070, "chapter_id": 2005, "verse_number": "६-५४-११", "content_sanskrit": "यथेन्द्रस्य महाराज महत्या दैत्यसेनया।\nतस्य सैन्यस्य संग्रामे युध्यमानस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045071, "chapter_id": 2005, "verse_number": "६-५४-१२", "content_sanskrit": "बभूव सुमहाञ्शब्दः सागरस्येव गर्जतः।\nअन्योन्यं स्म तदा योधा विकर्षन्तो विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045072, "chapter_id": 2005, "verse_number": "६-५४-१३", "content_sanskrit": "महीं चक्रुश्चितां सर्वां शशलोहितसन्निभाम् ।\nयोधांश्च स्वान्परान्वापि नाभ्यजानञ्जिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045073, "chapter_id": 2005, "verse_number": "६-५४-१४", "content_sanskrit": "स्वानप्याददते स्वाश्च शूराः परमदुर्जयाः।\nविमर्दः सुमहानासीदल्पानां बहुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045074, "chapter_id": 2005, "verse_number": "६-५४-१५", "content_sanskrit": "कलिङ्गैः सह चैदीनां निषादैश्च विशांपते ।\nकृत्वा पुरुषकारं तु यथाशक्ति महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045075, "chapter_id": 2005, "verse_number": "६-५४-१६", "content_sanskrit": "भीमसेनं परित्यज्य संन्यवर्तनक्त चेदयः।\nसर्वैः कलिङ्गैरासन्नः सन्निवृत्तेषु चेदिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045076, "chapter_id": 2005, "verse_number": "६-५४-१७", "content_sanskrit": "स्वबाहुबलमस्थाय अभ्यवर्षन्त पाण्डवम् ।\nन चचाल रथोपस्थाद्भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045077, "chapter_id": 2005, "verse_number": "६-५४-१८", "content_sanskrit": "शितैरवाकिरद्बाणैः कलिङ्गानां वरूथिनीम् ।\nकालिङ्गस्तु महेष्वासः पुत्रश्चास्य महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045078, "chapter_id": 2005, "verse_number": "६-५४-१९", "content_sanskrit": "शक्रदेव इति ख्यातो जघ्नतुः पाण्डवं शरैः।\nततो भीमो महाबाहुर्विधुन्वन्रुचिरं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045079, "chapter_id": 2005, "verse_number": "६-५४-२०", "content_sanskrit": "योधयामास कालिङ्गं स्वबाहुबलमाश्रितः।\nशक्रदेवस्तु समरे विसृजन्सायकान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045080, "chapter_id": 2005, "verse_number": "६-५४-२१", "content_sanskrit": "अश्वाञ्जघान समरे भीमसेनस्य सायकैः।\nतं दृष्ट्वा विरथं तत्र भीमसेनमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045081, "chapter_id": 2005, "verse_number": "६-५४-२२", "content_sanskrit": "शक्रदेवोऽभिदुद्राव शरैरवकिरञ्सितैः।\nभीमस्योपरि राजेन्द्र शक्रदेवो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045082, "chapter_id": 2005, "verse_number": "६-५४-२३", "content_sanskrit": "ववर्ष शरवर्षाणि तपान्ते जलदो यथा।\nहताश्वे तु रथे तिष्ठन्भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045083, "chapter_id": 2005, "verse_number": "६-५४-२४", "content_sanskrit": "शक्रदेवाय चिक्षेप सर्वशैक्यायसीं गदाम्।\nस तया निहतो राजन्कालिङ्गतनयो रथात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045084, "chapter_id": 2005, "verse_number": "६-५४-२५", "content_sanskrit": "विरथः सह सूतेन जगाम धरणीतलम्।\nकहतमात्मसुतं दृष्ट्वा कलिङ्गानां जनाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045085, "chapter_id": 2005, "verse_number": "६-५४-२६", "content_sanskrit": "रथैरनेकसाहस्रैर्भीमस्यावारयद्दिशः ।\n`अयुतेन गजानां च निषादैः परिवारितः।\nततो भीमो महावेगां त्यक्त्वा गुर्वी महागदां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045086, "chapter_id": 2005, "verse_number": "६-५४-२७", "content_sanskrit": "निस्त्रिंशमाददे घोरं चिकीर्षुः कर्म दारुणम् ।\nचर्म चाप्रतिमं राजन्नार्षभं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045087, "chapter_id": 2005, "verse_number": "६-५४-२८", "content_sanskrit": "नक्षत्रैरर्धचन्द्रैश्च शातकुम्भमयैश्चितम् ।\nकालिङ्गस्तु ततः क्रुद्धो धनुर्ज्यामवमृज्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045088, "chapter_id": 2005, "verse_number": "६-५४-२९", "content_sanskrit": "प्रगृह्य च शरं घोरमेकं सर्पविषोपमम्।\nप्राहिणोद्भीमसेनाय वधाकाङ्क्षी जनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045089, "chapter_id": 2005, "verse_number": "६-५४-३०", "content_sanskrit": "तमापतन्तं वेगेन प्रेरितं निशितं शरम्।\nभीमसेनो द्विधा राजंश्चिच्छेद विपुलासिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045090, "chapter_id": 2005, "verse_number": "६-५४-३१", "content_sanskrit": "उदक्रोशच्च संहृष्टस्त्रासयानो वरूथिनीम् ।\nकालिङ्गोऽथ ततः क्रुद्धो भीमसेनाय संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045091, "chapter_id": 2005, "verse_number": "६-५४-३२", "content_sanskrit": "तोमरान्प्राहिणोच्छीघ्रं चतुर्दश शिलाशितान्।\nतानप्राप्तान्महाबाहुः खगतानेव पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045092, "chapter_id": 2005, "verse_number": "६-५४-३३", "content_sanskrit": "चिच्छेद सहसा राजन्नसंभ्रान्तो वरासिना।\nनित्यत्य तु रणे भीमस्तोमरान्वै चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045093, "chapter_id": 2005, "verse_number": "६-५४-३४", "content_sanskrit": "भानुमन्तं ततो भीमः प्राद्रवत्पुरुषर्षभः ।\nभानुमांस्तु ततो भीमं शरवर्षेण च्छादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045094, "chapter_id": 2005, "verse_number": "६-५४-३५", "content_sanskrit": "ननाद बलवन्नादं नादयानो नभस्तलम्।\nन च तं ममृषे भीमः सिंहनादं महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045095, "chapter_id": 2005, "verse_number": "६-५४-३६", "content_sanskrit": "ततः शब्देन महता विननाद महास्वनः।\nतेन नादेन वित्रस्ता कलिङ्गानां वरूथिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045096, "chapter_id": 2005, "verse_number": "६-५४-३७", "content_sanskrit": "न भीमं समरे मेने मानुषं भरतर्षभ ।\nततो भीमो महाबाहुर्नर्दित्वा विपुलं स्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045097, "chapter_id": 2005, "verse_number": "६-५४-३८", "content_sanskrit": "सासिर्वेगवदाप्लुत्य दन्ताभ्यां वारणोत्तमम् ।\nआरुरोह ततो मध्यं नागराजस्य मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045098, "chapter_id": 2005, "verse_number": "६-५४-३९", "content_sanskrit": "ततो मुमोच कालिङ्गः शक्तिं तामकरोद्द्वीधा ।\nखङ्गेन पृथुना मध्ये भानुमन्तमथाच्छिनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045099, "chapter_id": 2005, "verse_number": "६-५४-४०", "content_sanskrit": "सोऽन्तरायुधिनं हत्वा राजपुत्रमरिन्दमः।\nगुरुभारसहे स्कन्धे नागस्यासिमपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045100, "chapter_id": 2005, "verse_number": "६-५४-४१", "content_sanskrit": "छिन्नस्कन्धः स विनदन्पपात गजयूथपः।\nआरुगणः सिन्धुवेगन सानुमानिव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045101, "chapter_id": 2005, "verse_number": "६-५४-४२", "content_sanskrit": "ततस्तस्मादप्लुत्य गजाद्भारत भारतः।\nखङ्गपाणिरदीनात्मा तस्थौ भूमौ सुदंशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2045102, "chapter_id": 2005, "verse_number": "६-५४-४३", "content_sanskrit": "स चचार बहून्मार्गानभितः पातयन्गजान् ।\nअग्निचक्रमिवाविद्धं सर्वतः प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2045103, "chapter_id": 2005, "verse_number": "६-५४-४४", "content_sanskrit": "अश्वबृन्देषु नागेषु रथानीकेषु चाभिभूः ।\nपदातीनां च सङ्घेषु विनिघ्नञ्शोणितोक्षितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2045104, "chapter_id": 2005, "verse_number": "६-५४-४५", "content_sanskrit": "श्येनवद्व्यचरद्भीमो रणेऽरिषु बलोत्कटः।\nछिन्दंस्तेषाकं शरीराणि शिरांसि च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2045105, "chapter_id": 2005, "verse_number": "६-५४-४६", "content_sanskrit": "खङघ्गेकन शितधारेण संयुगे गजयोधिनाम्।\nपदातिरेकः संक्रुद्धः शत्रूणां भयवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2045106, "chapter_id": 2005, "verse_number": "६-५४-४७", "content_sanskrit": "संमाहयामास स तान्कालान्तकयमोपमः।\nमूढाश्च ते तमेवाजौ विनदन्तः समाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2045107, "chapter_id": 2005, "verse_number": "६-५४-४८", "content_sanskrit": "सासिमुत्तमवेगेन विचरन्तं महारणे।\nनिकृत्य रथिनां चाजौ रथेषाश्च युगानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2045108, "chapter_id": 2005, "verse_number": "६-५४-४९", "content_sanskrit": "जघान रथिनश्चापि बलवान्रिपुमर्दनः।\nभीमसेनश्चरन्मार्गान्सुबहून्प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2045109, "chapter_id": 2005, "verse_number": "६-५४-५०", "content_sanskrit": "भ्रान्तमाविद्धमुद्भ्रान्तमाप्लुतं प्रसृतं प्लुतम् ।\nसंपातं समुदीर्णं च दर्शयामास पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2045110, "chapter_id": 2005, "verse_number": "६-५४-५१", "content_sanskrit": "केचिदग्रासिना छिन्नाः पाण्डवेन महात्मना।\nविनेदुर्भिन्नमर्माणो निपेतुश्च गतासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2045111, "chapter_id": 2005, "verse_number": "६-५४-५२", "content_sanskrit": "छइन्नदन्ताग्रहस्ताश्च भिन्नकुम्भास्तथाऽपरे ।\nवियोधाः स्वान्यनीकानि जघ्नुर्भारत वारणाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2045112, "chapter_id": 2005, "verse_number": "६-५४-५३", "content_sanskrit": "निपेतुरुर्व्यां च तथा विनदन्तो महारवान्।\nछिन्नांश्च तोमरान्राजन्महामात्रशिरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2045113, "chapter_id": 2005, "verse_number": "६-५४-५४", "content_sanskrit": "परिस्तोमान्विचित्रांश्च कक्ष्याश्च कनकोज्ज्वलाः।\nग्रैवेयाण्यथ शक्तीश्च पताकाः कणपांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2045114, "chapter_id": 2005, "verse_number": "६-५४-५५", "content_sanskrit": "तूणीरानथ यन्त्राणि धनूंषि च।\nभिन्दिपालानि शुभ्राणि तोत्राणि चाङ्कुशैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2045115, "chapter_id": 2005, "verse_number": "६-५४-५६", "content_sanskrit": "घण्टाश्च विविधा राजन्हेमगर्भान्त्सरूनपि ।\nपततः पातितांश्चैव पश्यामः सह सादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2045116, "chapter_id": 2005, "verse_number": "६-५४-५७", "content_sanskrit": "छिन्नगात्रावरकरैर्निहतैश्चाप वारणैः ॥\nआसीद्भूमिःक समास्तीर्णा पतितैर्भूधरैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2045117, "chapter_id": 2005, "verse_number": "६-५४-५८", "content_sanskrit": "विमृद्यैवं महानागान्ममर्दाश्वान्महाबलः ।\nअश्वारोहवरांश्चैव पातयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2045118, "chapter_id": 2005, "verse_number": "६-५४-५९", "content_sanskrit": "तद्धोरमभवद्युद्धं तस्य तेषां च भारत।\nखलीनान्यथ योक्राणि कक्ष्याश्च कनकोज्ज्वलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2045119, "chapter_id": 2005, "verse_number": "६-५४-६०", "content_sanskrit": "परिस्तोमाश्च प्रासाश्च ऋष्टयश्च महाधनाः।\nकवचान्यथ चर्माणि चित्राण्यास्तरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2045120, "chapter_id": 2005, "verse_number": "६-५४-६१", "content_sanskrit": "तत्रतत्रापविद्धआनि व्यदृश्यन्त महाहवे।\nप्रासैर्यन्त्रैर्विचित्रैश्च शस्त्रैश्च विमलैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2045121, "chapter_id": 2005, "verse_number": "६-५४-६२", "content_sanskrit": "स चक्रे वसुधां कीर्णां शबलैः कुसुमैरिव ।\nआप्लुत्य रथिनः काश्चित्परामृश्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2045122, "chapter_id": 2005, "verse_number": "६-५४-६३", "content_sanskrit": "पातयामास खङ्गेन सध्वजानपि पाण्डवः।\nमुहुरुत्पततो दिक्षु धावतश्च यशस्विनःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2045123, "chapter_id": 2005, "verse_number": "६-५४-६४", "content_sanskrit": "मार्गांश्च चरतश्चित्रं व्यस्मयन्त रणे जनाः ।\nस जघान पदा कांश्चिद्व्याक्षिप्यान्यानपोथयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2045124, "chapter_id": 2005, "verse_number": "६-५४-६५", "content_sanskrit": "खह्गेनान्यांश्च चिच्छेद नादेनान्यांश्च भीषयन्।\nऊरुवेगेन चाप्यन्यान्पातयामास भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2045125, "chapter_id": 2005, "verse_number": "६-५४-६६", "content_sanskrit": "अपरे चैनमालोक्य भयात्पञ्चत्वमागताः।\nएवं सा बहुला सेना कलिङ्गानां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2045126, "chapter_id": 2005, "verse_number": "६-५४-६७", "content_sanskrit": "परिवार्य रणे भीष्मं भीमसेनमुपाद्रवत्।\nततः कालिङ्गयैन्यानां प्रमुखे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2045127, "chapter_id": 2005, "verse_number": "६-५४-६८", "content_sanskrit": "श्रुतायुषमभिप्रेक्ष्य भीमसेनः समभ्ययात्।\nतमायान्तमभिप्रेक्ष्य कालिङ्गो नवभिः शरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2045128, "chapter_id": 2005, "verse_number": "६-५४-६९", "content_sanskrit": "भीमसेनममेयात्मा प्रत्यविध्यत्स्तनान्तरे ।\nकलिङ्गबाणाभिहतस्तोत्रार्दित इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2045129, "chapter_id": 2005, "verse_number": "६-५४-७०", "content_sanskrit": "भीमसेनः प्रजज्वाल क्रोदेनाग्निरिवैधितः।\nअथाशोकः समादाय रथं हेमपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2045130, "chapter_id": 2005, "verse_number": "६-५४-७१", "content_sanskrit": "भीमं संपादयामास रथेन रथसारथिः।\nतामरुह्य रथं तूर्णं कौन्तेयः शत्रुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2045131, "chapter_id": 2005, "verse_number": "६-५४-७२", "content_sanskrit": "कलिङ्गमभिदुद्राव तिष्ठितिष्ठेति चाब्रवीत् ।\nततः श्रुतायुर्बलावान्भीमाय निशिताञ्शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2045132, "chapter_id": 2005, "verse_number": "६-५४-७३", "content_sanskrit": "प्रेषयामास संक्रुद्धो दर्शयन्पाणिलाघवम्।\nस कार्मुकवरोत्सृष्टैर्नवभिर्निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2045133, "chapter_id": 2005, "verse_number": "६-५४-७४", "content_sanskrit": "समाहतो महाराज कलिङ्गेन महात्मना ।\nसंचुक्रुशे भृशं भीमो दण्डाहत इवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2045134, "chapter_id": 2005, "verse_number": "६-५४-७५", "content_sanskrit": "क्रुद्धश्च चापमायम्य बलवद्बलिनां वरः।\nकलिङ्गमवधीत्पार्थो भीमः सप्तभिरायसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2045135, "chapter_id": 2005, "verse_number": "६-५४-७६", "content_sanskrit": "क्षुराभ्यां चक्ररक्षौ च कलिङ्गस्य महाबलौ ।\nसत्यदेवं च सत्यं च प्राहिणोद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2045136, "chapter_id": 2005, "verse_number": "६-५४-७७", "content_sanskrit": "ततः पुनमेयात्मा नासचैर्निशितैस्त्रिभिः ।\nकेतुमन्तं रणे भीमोऽगमयद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2045137, "chapter_id": 2005, "verse_number": "६-५४-७८", "content_sanskrit": "ततः कलिङ्गाः सन्नद्धा भीमसेनममर्षणम् ।\nअनीकैर्बहुसाहस्रैः क्षत्रियाः समवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2045138, "chapter_id": 2005, "verse_number": "६-५४-७९", "content_sanskrit": "ततः शक्तिगदाखङ्गतोमरर्ष्टिपरश्वथैः ।\nकलिङ्गाश्च ततो राजन्भीमसेनमवाकिरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2045139, "chapter_id": 2005, "verse_number": "६-५४-८०", "content_sanskrit": "संनिवार्य स तां घोरां शरवृष्टिं समुत्थिताम्।\nगदामादाय तरसा संनिपत्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2045140, "chapter_id": 2005, "verse_number": "६-५४-८१", "content_sanskrit": "भीमः सप्तशतान्वीराननयद्यमसादनम् ।\nपुनश्चैव द्विसाहस्रान्कलिङ्गानरिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2045141, "chapter_id": 2005, "verse_number": "६-५४-८२", "content_sanskrit": "प्राहिणोन्मृत्युलोकाय तदद्भुतमिवाभवत्।\nएवं स तान्यनीकानि कलिङ्गानां पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2045142, "chapter_id": 2005, "verse_number": "६-५४-८३", "content_sanskrit": "बिभेद समरे तूर्णं प्रेक्ष्य भीष्मं महारथम् ।\nहतारोहाश्च मातङ्गाः पाण्डवेन कृता रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2045143, "chapter_id": 2005, "verse_number": "६-५४-८४", "content_sanskrit": "विप्रजग्मुरनीकेषु मेघा वातहता इव।\nमृद्गन्तः स्वान्यनीकानि विनदन्तः शरातुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2045144, "chapter_id": 2005, "verse_number": "६-५४-८५", "content_sanskrit": "ततो भीमो महाबाहुः खङ्गहस्तो महाभुजःक ।\nसंप्रहृष्टो महाघोषं शङ्खं प्राध्मापयद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2045145, "chapter_id": 2005, "verse_number": "६-५४-८६", "content_sanskrit": "सर्वकालिङ्गसैन्यानां मनांसि समकम्पयत् ।\nमोहश्चापि कलिङ्गानामाविवेश परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2045146, "chapter_id": 2005, "verse_number": "६-५४-८७", "content_sanskrit": "प्राकम्पन्त च सैन्यानि वाहनानि च सर्वशः ।\nभीमेन समरे राजन्गजेन्द्रेणेव सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2045147, "chapter_id": 2005, "verse_number": "६-५४-८८", "content_sanskrit": "मार्गान्बहून्विचरता धावता च ततस्ततः।\nमुहुरुत्पतता चैव संमोहः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2045148, "chapter_id": 2005, "verse_number": "६-५४-८९", "content_sanskrit": "भीमसेनभयत्रस्तं सैन्यं च समकम्पत।\nक्षोभ्यमाणमसंबाधं ग्राहेणेव महत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2045149, "chapter_id": 2005, "verse_number": "६-५४-९०", "content_sanskrit": "त्रासितेषु च सर्वेषु भीमेनाद्भुतकर्मणा ।\nपुनरावर्तमानेषु विद्रवत्सु च सङ्घशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2045150, "chapter_id": 2005, "verse_number": "६-५४-९१", "content_sanskrit": "सर्वकालिङ्गयोधेषु पाण्डूनां ध्वजिनीपतिः ।\nअब्रवीत्स्वान्यनीकानि युध्यध्वमिति पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2045151, "chapter_id": 2005, "verse_number": "६-५४-९२", "content_sanskrit": "सेनापतिवचः श्रुत्वा शिखण्डिप्रमुखा गणाः।\nभीममेवाभ्यवर्तन्त रथानीकैः प्रहारिभिः ॥ ६-५४-९३aधर्मराजश्च तान्सर्वानुपजग्राह पाण्डवः।\nमहता मेघवर्णेन नागानीकेन पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2045152, "chapter_id": 2005, "verse_number": "६-५४-९४", "content_sanskrit": "एवं संनोद्य सर्वामि स्वान्यनीकानि पार्षतः।\nभीमसेनस्य जग्राह पार्ष्णि सत्पुरुषैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2045153, "chapter_id": 2005, "verse_number": "६-५४-९५", "content_sanskrit": "न हि पञ्चालराजस्य लोके कश्चन विद्यते।\nभीमसात्यकयोरन्यः प्राणेभ्यः प्रियकृत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2045154, "chapter_id": 2005, "verse_number": "६-५४-९६", "content_sanskrit": "सोऽपश्यच्च कलिङ्गेषु चरन्तमरिसूदनः ।\nभीमसेनं महाबाहुं पार्षतः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2045155, "chapter_id": 2005, "verse_number": "६-५४-९७", "content_sanskrit": "ननर्द बहुधा राजन्हृष्टश्चासीत्परंतपः।\nशङ्खं दध्मौ च समरे सिंहनादं ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2045156, "chapter_id": 2005, "verse_number": "६-५४-९८", "content_sanskrit": "स च पारावताश्वस्य रथे हेमपरिष्कृते।\nकोविदारध्वजं दृष्ट्वा भीमसेनः समाश्वसत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2045157, "chapter_id": 2005, "verse_number": "६-५४-९९", "content_sanskrit": "धृष्टद्युम्नस्तु तं दृष्ट्वा कलिङ्गैः समभिद्रुतम् ॥\nभीमसेनममेयात्मा त्राणायाजौ समभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2045158, "chapter_id": 2005, "verse_number": "६-५४-१००", "content_sanskrit": "तौ दूरात्सात्यकिं दृष्ट्वा धृष्टद्युम्नवृकोदरौ ।\nकलिङ्गान्समरे वीरौ योधयेतां मनस्विनौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2045159, "chapter_id": 2005, "verse_number": "६-५४-१०१", "content_sanskrit": "स तत्र गत्वा शैनेयो जवेन जयतां वरः।\nपार्थपार्षतयोः पार्षिं जग्राह पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2045160, "chapter_id": 2005, "verse_number": "६-५४-१०२", "content_sanskrit": "स कृत्कवा दारुणं कर्म प्रगृहीतशरासनः ।\nआस्थितो रौद्रमात्मानं कलिङ्गानन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2045161, "chapter_id": 2005, "verse_number": "६-५४-१०३", "content_sanskrit": "कलिङ्गप्रभवां चैव मांसशोणितकर्दमाम्।\nरुधिरस्यन्दिनीं तत्र भीमः प्रावर्तयन्नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2045162, "chapter_id": 2005, "verse_number": "६-५४-१०४", "content_sanskrit": "अन्तरेण कलिङ्गानां पाण्डवानां च वाहिनीम्।\nतां संततार दुस्तारां भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2045163, "chapter_id": 2005, "verse_number": "६-५४-१०५", "content_sanskrit": "भीमसेनं तथा दृष्ट्वा प्राक्रोशंस्तावका नृप।\nकालोऽयं भीमरूपेण कलिङ्गैः कसह युध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2045164, "chapter_id": 2005, "verse_number": "६-५४-१०६", "content_sanskrit": "ततः शान्तनवो भीष्मः श्रुत्वा तं निनदं रणे।\nअभ्ययात्त्वरितो भीमं व्यूढानीकः समंततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2045165, "chapter_id": 2005, "verse_number": "६-५४-१०७", "content_sanskrit": "तं सात्यकिर्भीमसेनो धृष्टद्युम्नश्च पार्षतः ।\nअभ्यद्रवन्त भीष्मस्य रथं हेमपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2045166, "chapter_id": 2005, "verse_number": "६-५४-१०८", "content_sanskrit": "परिवार्य तु ते सर्वे गाङ्गेयं तरसा रणे।\nत्रिभिस्त्रिभिः शरैर्घोरैर्भीष्ममानर्च्छुरोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2045167, "chapter_id": 2005, "verse_number": "६-५४-१०९", "content_sanskrit": "प्रत्यविध्यत तान्सर्वान्पिता देवव्रतस्तव ।\nयतमानान्महेष्वासांस्त्रिभिस्त्रिभिरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2045168, "chapter_id": 2005, "verse_number": "६-५४-११०", "content_sanskrit": "ततः शरसहस्रेण सन्निवार्य महारथान् ।\nहयान्काञ्चनसन्नाहान्भीमस्य न्यहनच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2045169, "chapter_id": 2005, "verse_number": "६-५४-१११", "content_sanskrit": "हताश्वे स रथे तिष्ठन्भीमसेनः प्रतापवान् ।\nशक्तिं चिक्षेप तरसा गाङ्गेयस्य रथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2045170, "chapter_id": 2005, "verse_number": "६-५४-११२", "content_sanskrit": "अप्राप्तामथ तां शक्तिं पिता देवव्रतस्तव ।\nत्रिधा चिच्छेद समरे सा पृथिव्यामशीर्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2045171, "chapter_id": 2005, "verse_number": "६-५४-११३", "content_sanskrit": "ततः शैक्यायसीं गुर्वी प्रगृह्य बलवान्गदाम् ।\nभीमसेनस्ततस्तूर्णं पुप्लुवे मनुजर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2045172, "chapter_id": 2005, "verse_number": "६-५४-११४", "content_sanskrit": "सात्यकोऽपि ततस्तूर्णं भीमस्य प्रियकाम्यया ।\nगाङ्गेयसारथिं तूर्णं पातयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2045173, "chapter_id": 2005, "verse_number": "६-५४-११५", "content_sanskrit": "भीष्मस्तु निहते तस्मिन्सारथौ रथिनां वरः ।\nवातायमानैस्तैरश्वैरपनीतो रणाजिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2045174, "chapter_id": 2005, "verse_number": "६-५४-११६", "content_sanskrit": "भीमसेनस्ततो राजन्नपयाते महाव्रते ।\nप्रजज्वाल यथा वह्निर्दहन्कक्षमिवैधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2045175, "chapter_id": 2005, "verse_number": "६-५४-११७", "content_sanskrit": "स हत्वा सर्वकालिङ्गान्सेनामध्ये व्यतिष्ठत।\nनैनमभ्युत्सहन्केचित्तावका भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2045176, "chapter_id": 2005, "verse_number": "६-५४-११८", "content_sanskrit": "धृष्टद्युम्नस्तमारोप्य स्वरथे रथिनां वरः।\nपश्यतां सर्वसैन्यानामपोवाहक यशस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2045177, "chapter_id": 2005, "verse_number": "६-५४-११९", "content_sanskrit": "संपूज्यमानः पाञ्चाल्यैर्मत्स्यैश्च भरतर्षभ ।\nधृष्टद्युम्नं परिष्वज्य समेयादथ सात्यकिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2045178, "chapter_id": 2005, "verse_number": "६-५४-१२०", "content_sanskrit": "अथाब्रवीद्भीमसेनं सात्यकिः सत्यविक्रमः ।\nप्रहर्षयन्यदुव्याघ्रो धृष्टद्युम्नस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2045179, "chapter_id": 2005, "verse_number": "६-५४-१२१", "content_sanskrit": "दिष्ट्या कालिङ्गराजश्च राजपुत्रश्च केतुमान ।\nशक्रदेवश्च कालिङ्गः कलिङ्गाश्च मृधे हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2045180, "chapter_id": 2005, "verse_number": "६-५४-१२२", "content_sanskrit": "स्वबाहुबलवीर्येण नागाश्वरथसंकुलः ।\nमहापुरुषभूयिष्ठो धीरयोधनिषेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2045181, "chapter_id": 2005, "verse_number": "६-५४-१२३", "content_sanskrit": "महाव्यूहः कलिङ्गानामेकेन मृदितस्त्वया ।\nएवमुक्त्वा शिनेर्नप्ता दीर्घबाहुररिन्दम।\nरथाद्रथमभिद्रुत्य पर्यष्वजत पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2045182, "chapter_id": 2005, "verse_number": "६-५४-१२४", "content_sanskrit": "ततः स्वरथमास्थाय पुनरेव महारथः ।\nतावकानवधीत्क्रुद्धो भीमस्य बलमादधत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2045183, "chapter_id": 2005, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि द्वितीयदिवसयुद्धे चतुःपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}]