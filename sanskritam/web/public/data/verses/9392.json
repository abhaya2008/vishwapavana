[{"id": 40022376, "chapter_id": 9392, "verse_number": "1", "content_sanskrit": "प्रस्थाप्य तु स शत्रुघ्नं भ्रातृभ्यां सह राघवः । प्रमुमोद सुखी राज्यं धर्मेण परिपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022377, "chapter_id": 9392, "verse_number": "2", "content_sanskrit": "ततः कतिपयाहःसु वृद्धो जानपदो द्विजः । मृतं बालमुपादाय राजद्वारमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022378, "chapter_id": 9392, "verse_number": "3", "content_sanskrit": "रुदन्बहुविधा वाचः स्नेहदुःखसमन्विताः । असकृत्पुत्र पुत्रेति वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022379, "chapter_id": 9392, "verse_number": "4", "content_sanskrit": "किं नु मे दुष्कृतं कर्म पुरा देहान्तरे कृतम् । यदहं पुत्रमेकं त्वां पश्यामि निधनं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022380, "chapter_id": 9392, "verse_number": "5", "content_sanskrit": "अप्राप्तयौवनं बालं पञ्चवर्षसहस्रकम् । अकाले कालमापन्नं मम दुःखाय पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022381, "chapter_id": 9392, "verse_number": "6", "content_sanskrit": "अल्पैरहोभिर्निधनं गमिष्यामि न संशयः । अहं च जननी चैव तव शोकेन पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022382, "chapter_id": 9392, "verse_number": "7", "content_sanskrit": "न स्मराम्यनृतं ह्युक्तं न च हिंसां स्मराम्यहम् । सर्वेषां प्राणिनां पापं कृतं नैव स्मराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022383, "chapter_id": 9392, "verse_number": "8", "content_sanskrit": "केनाद्य दुष्कृतेनायं बाल एव ममात्मजः । अकृत्वा पितृकार्याणि गतो वैवस्वतक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022384, "chapter_id": 9392, "verse_number": "9", "content_sanskrit": "नेदृशं दृष्टपूर्वं मे श्रुतं वा घोरदर्शनम् । मृत्युरप्राप्तकालानां रामस्य विषये यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022385, "chapter_id": 9392, "verse_number": "10", "content_sanskrit": "रामस्य दुष्कृतं किञ्चिन्महदस्ति न संशयः । यथा हि विषयस्थानां बालानां मृत्युरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022386, "chapter_id": 9392, "verse_number": "11", "content_sanskrit": "नह्यन्यविषयस्थानां बालानां मृत्युतो भयम् । त्वं राजञ्जीवयस्वैनं बालं मृत्युवशं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022387, "chapter_id": 9392, "verse_number": "12", "content_sanskrit": "राजद्वारि मरिष्यामि पत्न्या सार्धमनाथवत् । ब्रह्महत्यां ततो राम समुपेत्य सुखी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022388, "chapter_id": 9392, "verse_number": "13", "content_sanskrit": "भ्रातृभिः सहितो राजन्दीर्घमायुरवाप्स्यसि । उषिताः स्म सुखं राज्ये तवास्मिन्सुमहाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022389, "chapter_id": 9392, "verse_number": "14", "content_sanskrit": "इदं तु पतितं तस्मात्तव राम वशे स्थिताः । कालस्य वशमापन्नाः स्वल्पं हि नहि नः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022390, "chapter_id": 9392, "verse_number": "15", "content_sanskrit": "सम्प्रत्यनाथो विषय इक्ष्वाकूणां महात्मनाम् । रामं नाथमिहासाद्य बालान्तकरणं ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022391, "chapter_id": 9392, "verse_number": "16", "content_sanskrit": "राजदोषैर्विपद्यन्ते प्रजा ह्यविधिपालिताः । असद्वृत्ते तु नृपतावकाले म्रियते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022392, "chapter_id": 9392, "verse_number": "17", "content_sanskrit": "यद्वा पुरेष्वयुक्तानि जना जनपदेषु च । कुर्वते न च रक्षा ऽस्ति तदा कालकृतं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022393, "chapter_id": 9392, "verse_number": "18", "content_sanskrit": "सुव्यक्तं राजदोषो हि भविष्यति न संशयः । पुरे जनपदे चापि ततो बालवधो ह्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022394, "chapter_id": 9392, "verse_number": "19", "content_sanskrit": "एवं बहुविधैर्वाक्यैरुपरुध्य मुहुर्मुहुः । राजानं दुःखसन्तप्तः सुतं तमुपगूहते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]