[{"id": 5000392000, "chapter_id": 9392, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000392001, "chapter_id": 9392, "verse_number": "५-५३-१", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा दशग्रीवो महात्मनः।\nदेशकालहितं वाक्यं भ्रातुरुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000392002, "chapter_id": 9392, "verse_number": "५-५३-२", "content_sanskrit": "सम्यगुक्तं हि भवता दूतवध्या विगर्हिता।\nअवश्यं तु वधायान्यः क्रियतामस्य निग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000392003, "chapter_id": 9392, "verse_number": "५-५३-३", "content_sanskrit": "कपीनां किल लाङ्गूलमिष्टं भवति भूषणम्।\nतदस्य दीप्यतां शीघ्रं तेन दग्धेन गच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000392004, "chapter_id": 9392, "verse_number": "५-५३-४", "content_sanskrit": "ततः पश्यन्त्वमुं दीनमङ्गवैरूप्यकर्शितम्।\nसुमित्रज्ञातयः सर्वे बान्धवाः ससुहृज्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000392005, "chapter_id": 9392, "verse_number": "५-५३-५", "content_sanskrit": "आज्ञापयद् राक्षसेन्द्रः पुरं सर्वं सचत्वरम्।\nलाङ्गूलेन प्रदीप्तेन रक्षोभिः परिणीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000392006, "chapter_id": 9392, "verse_number": "५-५३-६", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राक्षसाः कोपकर्कशाः।\nवेष्टन्ते तस्य लाङ्गूलं जीर्णैः कार्पासिकैः पटैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000392007, "chapter_id": 9392, "verse_number": "५-५३-७", "content_sanskrit": "संवेष्ट्यमाने लाङ्गूले व्यवर्धत महाकपिः।\nशुष्कमिन्धनमासाद्य वनेष्विव हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000392008, "chapter_id": 9392, "verse_number": "५-५३-८", "content_sanskrit": "तैलेन परिषिच्याथ तेऽग्निं तत्रोपपादयन्।\nलाङ्गूलेन प्रदीप्तेन राक्षसांस्तानताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000392009, "chapter_id": 9392, "verse_number": "५-५३-९", "content_sanskrit": "रोषामर्षपरीतात्मा बालसूर्यसमाननः।\nस भूयः संगतैः क्रूरै राक्षसैर्हरिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000392010, "chapter_id": 9392, "verse_number": "५-५३-१०", "content_sanskrit": "सहस्त्रीबालवृद्धाश्च जग्मुः प्रीतिं निशाचराः।\nनिबद्धः कृतवान् वीरस्तत्कालसदृशीं मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000392011, "chapter_id": 9392, "verse_number": "५-५३-११", "content_sanskrit": "कामं खलु न मे शक्ता निबद्धस्यापि राक्षसाः।\nछित्त्वा पाशान् समुत्पत्य हन्यामहमिमान् पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000392012, "chapter_id": 9392, "verse_number": "५-५३-१२", "content_sanskrit": "यदि भर्तृहितार्थाय चरन्तं भर्तृशासनात्।\nनिबध्नन्ते दुरात्मानो न तु मे निष्कृतिः कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000392013, "chapter_id": 9392, "verse_number": "५-५३-१३", "content_sanskrit": "सर्वेषामेव पर्याप्तो राक्षसानामहं युधि।\nकिं तु रामस्य प्रीत्यर्थं विषहिष्येऽहमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000392014, "chapter_id": 9392, "verse_number": "५-५३-१४", "content_sanskrit": "लङ्का चारयितव्या मे पुनरेव भवेदिति।\nरात्रौ नहि सुदृष्टा मे दुर्गकर्मविधानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000392015, "chapter_id": 9392, "verse_number": "५-५३-१५", "content_sanskrit": "अवश्यमेव द्रष्टव्या मया लङ्का निशाक्षये।\nकामं बध्नन्तु मे भूयः पुच्छस्योद्दीपनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000392016, "chapter_id": 9392, "verse_number": "५-५३-१६", "content_sanskrit": "पीडां कुर्वन्ति रक्षांसि न मेऽस्ति मनसः श्रमः।\nततस्ते संवृताकारं सत्त्ववन्तं महाकपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000392017, "chapter_id": 9392, "verse_number": "५-५३-१७", "content_sanskrit": "परिगृह्य ययुर्हृष्टा राक्षसाः कपिकुञ्जरम्।\nशङ्खभेरीनिनादैश्च घोषयन्तः स्वकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000392018, "chapter_id": 9392, "verse_number": "५-५३-१८", "content_sanskrit": "राक्षसाः क्रूरकर्माणश्चारयन्ति स्म तां पुरीम्।\nअन्वीयमानो रक्षोभिर्ययौ सुखमिरंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000392019, "chapter_id": 9392, "verse_number": "५-५३-१९", "content_sanskrit": "हनूमांश्चारयामास राक्षसानां महापुरीम्।\nअथापश्यद् विमानानि विचित्राणि महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000392020, "chapter_id": 9392, "verse_number": "५-५३-२०", "content_sanskrit": "संवृतान् भूमिभागांश्च सुविभक्तांश्च चत्वरान्।\nरथ्याश्च गृहसम्बाधाः कपिः शृङ्गाटकानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000392021, "chapter_id": 9392, "verse_number": "५-५३-२१", "content_sanskrit": "तथा रथ्योपरथ्याश्च तथैव च गृहान्तरान्।\nचत्वरेषु चतुष्केषु राजमार्गे तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000392022, "chapter_id": 9392, "verse_number": "५-५३-२२", "content_sanskrit": "घोषयन्ति कपिं सर्वे चार इत्येव राक्षसाः।\nस्त्रीबालवृद्धा निर्जग्मुस्तत्र तत्र कुतूहलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000392023, "chapter_id": 9392, "verse_number": "५-५३-२३", "content_sanskrit": "तं प्रदीपितलाङ्गूलं हनूमन्तं दिदृक्षवः।\nदीप्यमाने ततस्तस्य लाङ्गूलाग्रे हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000392024, "chapter_id": 9392, "verse_number": "५-५३-२४", "content_sanskrit": "राक्षस्यस्ता विरूपाक्ष्यः शंसुर्देव्यास्तदप्रियम्।\nयस्त्वया कृतसंवादः सीते ताम्रमुखः कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000392025, "chapter_id": 9392, "verse_number": "५-५३-२५", "content_sanskrit": "लाङ्गूलेन प्रदीप्तेन स एष परिणीयते।\nश्रुत्वा तद् वचनं क्रूरमात्मापहरणोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000392026, "chapter_id": 9392, "verse_number": "५-५३-२६", "content_sanskrit": "वैदेही शोकसंतप्ता हुताशनमुपागमत्।\nमङ्गलाभिमुखी तस्य सा तदासीन्महाकपेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000392027, "chapter_id": 9392, "verse_number": "५-५३-२७", "content_sanskrit": "उपतस्थे विशालाक्षी प्रयता हव्यवाहनम्।\nयद्यस्ति पतिशुश्रूषा यद्यस्ति चरितं तपः।\nयदि वा त्वेकपत्नीत्वं शीतो भव हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000392028, "chapter_id": 9392, "verse_number": "५-५३-२८", "content_sanskrit": "यदि किंचिदनुक्रोशस्तस्य मय्यस्ति धीमतः।\nयदि वा भाग्यशेषो मे शीतो भव हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000392029, "chapter_id": 9392, "verse_number": "५-५३-२९", "content_sanskrit": "यदि मां वृत्तसम्पन्नां तत्समागमलालसाम्।\nस विजानाति धर्मात्मा शीतो भव हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000392030, "chapter_id": 9392, "verse_number": "५-५३-३०", "content_sanskrit": "यदि मां तारयेदार्यः सुग्रीवः सत्यसंगरः।\nअस्माद् दुःखाम्बुसंरोधाच्छीतो भव हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000392031, "chapter_id": 9392, "verse_number": "५-५३-३१", "content_sanskrit": "ततस्तीक्ष्णार्चिरव्यग्रः प्रदक्षिणशिखोऽनलः।\nजज्वाल मृगशावाक्ष्याः शंसन्निव शुभं कपेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000392032, "chapter_id": 9392, "verse_number": "५-५३-३२", "content_sanskrit": "हनूमज्जनकश्चैव पुच्छानलयुतोऽनिलः।\nववौ स्वास्थ्यकरो देव्याः प्रालेयानिलशीतलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000392033, "chapter_id": 9392, "verse_number": "५-५३-३३", "content_sanskrit": "दह्यमाने च लाङ्गूले चिन्तयामास वानरः।\nप्रदीप्तोऽग्निरयं कस्मान्न मां दहति सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000392034, "chapter_id": 9392, "verse_number": "५-५३-३४", "content_sanskrit": "दृश्यते च महाज्वालः करोति च न मे रुजम्।\nशिशिरस्येव सम्पातो लाङ्गूलाग्रे प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000392035, "chapter_id": 9392, "verse_number": "५-५३-३५", "content_sanskrit": "अथ वा तदिदं व्यक्तं यद् दृष्टं प्लवता मया।\nरामप्रभावादाश्चर्यं पर्वतः सरितां पतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000392036, "chapter_id": 9392, "verse_number": "५-५३-३६", "content_sanskrit": "यदि तावत् समुद्रस्य मैनाकस्य च धीमतः।\nरामार्थं सम्भ्रमस्तादृक् किमग्निर्न करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000392037, "chapter_id": 9392, "verse_number": "५-५३-३७", "content_sanskrit": "सीतायाश्चानृशंस्येन तेजसा राघवस्य च।\nपितुश्च मम सख्येन न मां दहति पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000392038, "chapter_id": 9392, "verse_number": "५-५३-३८", "content_sanskrit": "भूयः स चिन्तयामास मुहूर्तं कपिकुञ्जरः।\nकथमस्मद्विधस्येह बन्धनं राक्षसाधमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000392039, "chapter_id": 9392, "verse_number": "५-५३-३९", "content_sanskrit": "प्रतिक्रियास्य युक्ता स्यात् सति मह्यं पराक्रमे।\nततश्छित्त्वा च तान् पाशान् वेगवान् वै महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000392040, "chapter_id": 9392, "verse_number": "५-५३-४०", "content_sanskrit": "उत्पपाताथ वेगेन ननाद च महाकपिः।\nपुरद्वारं ततः श्रीमान् शैलशृङ्गमिवोन्नतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000392041, "chapter_id": 9392, "verse_number": "५-५३-४१", "content_sanskrit": "विभक्तरक्षःसम्बाधमाससादानिलात्मजः।\nस भूत्वा शैलसंकाशः क्षणेन पुनरात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000392042, "chapter_id": 9392, "verse_number": "५-५३-४२", "content_sanskrit": "ह्रस्वतां परमां प्राप्तो बन्धनान्यवशातयत्।\nविमुक्तश्चाभवच्छ्रीमान् पुनः पर्वतसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000392043, "chapter_id": 9392, "verse_number": "५-५३-४३", "content_sanskrit": "वीक्षमाणश्च ददृशे परिघं तोरणाश्रितम्।\nस तं गृह्य महाबाहुः कालायसपरिष्कृतम्।\nरक्षिणस्तान् पुनः सर्वान् सूदयामास मारुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000392044, "chapter_id": 9392, "verse_number": "५-५३-४४", "content_sanskrit": "स तान् निहत्वा रणचण्डविक्रमः\nसमीक्षमाणः पुनरेव लङ्काम्।\nप्रदीप्तलाङ्गूलकृतार्चिमाली\nप्रकाशितादित्य इवार्चिमाली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000392045, "chapter_id": 9392, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]