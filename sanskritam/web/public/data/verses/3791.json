[{"id": 2129676, "chapter_id": 3791, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129677, "chapter_id": 3791, "verse_number": "१", "content_sanskrit": "चङ्क्रम्यमाणः स तदा यवक्रीरकुतोभयः ।\nजगाम माधवे मासि रैभ्याश्रमपदं प्रति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129678, "chapter_id": 3791, "verse_number": "२", "content_sanskrit": "स ददर्शाश्रमे रम्ये पुष्पितद्रुमभूषिते ।\nविचरन्तीं स्नुषां तस्य किन्नरीमिव भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129679, "chapter_id": 3791, "verse_number": "३", "content_sanskrit": "यवक्रीस्तामुवाचेदमुपातिष्ठस्व मामिति ।\nनिर्लज्जो लज्जया युक्तां कामेन हृतचेतनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129680, "chapter_id": 3791, "verse_number": "४", "content_sanskrit": "सा तस्य शीलमाज्ञाय तस्माच्छापाच्च बिभ्यती ।\nतेजस्वितां च रैभ्यस्य तथेत्युक्त्वाऽऽजगाम ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129681, "chapter_id": 3791, "verse_number": "५", "content_sanskrit": "तत एकान्तमुन्नीय लज्जयामास भारत ।\nआजगाम तदा रैभ्यः स्वमाश्रममरिन्दम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129682, "chapter_id": 3791, "verse_number": "६", "content_sanskrit": "रुदतीं च स्नुषां दृष्ट्वा भार्यामार्तां परावसोः ।\nसान्त्वयन् श्लक्ष्णया वाचा पर्यपृच्छद् युधिष्ठिर\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129683, "chapter_id": 3791, "verse_number": "७", "content_sanskrit": "सा तस्मै सर्वमाचष्ट यवक्रीभाषितं शुभा ।\nप्रत्युक्तं च यवक्रीतं प्रेक्षापूर्वं तथाऽऽत्मना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129684, "chapter_id": 3791, "verse_number": "८", "content_sanskrit": "शृण्वानस्यैव रैभ्यस्य यवक्रीतविचेष्टितम् ।\nदहन्निव तदा चेतःक्रोधः समभवन्महान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129685, "chapter_id": 3791, "verse_number": "९", "content_sanskrit": "स तदा मन्युनाऽऽविष्टस्तपस्वी कोपनो भृशम् ।\nअवलुच्य जटामेकां जुहावाग्नौ सुसंस्कृते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129686, "chapter_id": 3791, "verse_number": "१०", "content_sanskrit": "ततः समभवन्नारी तस्या रूपेण सम्मिता ।\nअवलुच्यापरां चापि जुहावाग्नौ जटां पुनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129687, "chapter_id": 3791, "verse_number": "११", "content_sanskrit": "ततः समभवद् रक्षो घोराक्षं भीमदर्शनम् ।\nअब्रूतां तौ तदा रैभ्यं किं कार्यं करवावहै\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129688, "chapter_id": 3791, "verse_number": "१२", "content_sanskrit": "तावब्रवीद् ऋषिः क्रुद्वो यवक्रीर्वध्यतामिति ।\nजग्मतुस्तौ तथेत्युक्त्वा यवक्रीतजिघांसया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129689, "chapter_id": 3791, "verse_number": "", "content_sanskrit": "ततः स्नुषाकृतीकृत्य यवक्रीतमुपागमत् ।\nयवक्रीतोऽपि रैभ्यस्य स्नुषां मत्वा जगाम ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129690, "chapter_id": 3791, "verse_number": "१३", "content_sanskrit": "ततस्तं समुपास्थाय कृत्या सृष्टा महात्मना ।\nकमण्डलुं जहारास्य मोहयित्वैव भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129691, "chapter_id": 3791, "verse_number": "१४", "content_sanskrit": "उच्छिष्टं तु यवक्रीतमपकृष्टकमण्डलुम् ।\nतत उद्यतशूलः स राक्षसः समुपाद्रवत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129692, "chapter_id": 3791, "verse_number": "१५", "content_sanskrit": "तमाद्रवन्तं(पतन्तं) सम्प्रेक्ष्य शूलहस्तं जिघांसया ।\nयवक्रीः सहसोत्थाय प्राद्रवद् येन वै सरः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129693, "chapter_id": 3791, "verse_number": "१६", "content_sanskrit": "जलहीनं सरो दृष्ट्वा यवक्रीस्त्वरितः पुनः ।\nजगाम सरितः सर्वास्ताश्चाप्यासन् विशोषिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129694, "chapter_id": 3791, "verse_number": "१७", "content_sanskrit": "स काल्यमानो घोरेण शूलहस्तेन रक्षसा ।\nअग्निहोत्रं पितुर्भीतः सहसा प्रविवेश ह \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129695, "chapter_id": 3791, "verse_number": "१८", "content_sanskrit": "स वै प्रविशमानस्तु शूद्रेणान्धेन रक्षिणा ।\nनिगृहीतो बलाद् द्वारि सोऽवातिष्ठत पार्थिव \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129696, "chapter_id": 3791, "verse_number": "१९", "content_sanskrit": "निगृहीतं तु शूद्रेण यवक्रीतं स राक्षसः ।\nताडयामास शूलेन स भिन्नहृदयोऽपतत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129697, "chapter_id": 3791, "verse_number": "२०", "content_sanskrit": "यवक्रीतं स हत्वा तु राक्षसो रैभ्यमागमत् ।\nअनुज्ञातस्तु रैभ्येण तया नार्या सहावसत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129698, "chapter_id": 3791, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रयस्त्रिंशदधिकशततमोऽध्यायः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129699, "chapter_id": 3791, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि एकोननवतितमोऽध्यायः ॥८९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]