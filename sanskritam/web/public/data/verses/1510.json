[{"id": 2023795, "chapter_id": 1510, "verse_number": "३-१४८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023796, "chapter_id": 1510, "verse_number": "३-१४८-१", "content_sanskrit": "तत्र ते पुरुषव्याघ्राः परमं शौचमास्थिताः।\nषड्रात्रमवसन्वीरा धनंजयदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023797, "chapter_id": 1510, "verse_number": "३-१४८-२", "content_sanskrit": "तस्मिन्विहरमाणाश्च रममाणाश्च पाण्डवाः।\nमनोज्ञे काननवरे सर्व भूतमनोरमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023798, "chapter_id": 1510, "verse_number": "३-१४८-३", "content_sanskrit": "पादपैः पुष्पविकचैः फलभारावनामितैः।\nशोभितः पर्वतो रम्यः पुंस्कोकिलकुलाकुलैः।\nस्निग्धपत्रैरविरलैः शीतच्छायैर्मनोरमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023799, "chapter_id": 1510, "verse_number": "३-१४८-४", "content_sanskrit": "सरांसि च विचित्राणि प्रसन्नसलिलानि च।\nकमलैः सोत्पलैस्तत्रभ्राजमानानि सर्वशः।\nपश्यन्तश्चारुरूपाणइ रेमिरे तत्र पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023800, "chapter_id": 1510, "verse_number": "३-१४८-५", "content_sanskrit": "पुण्यगन्धः सुखस्पर्शो ववौ तत्र समीरणः।\nह्लादयन्पाण्डवान्सर्बान्सकृष्णान्सद्विजर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023801, "chapter_id": 1510, "verse_number": "३-१४८-६", "content_sanskrit": "ततः पूर्वोत्तरे वायुः प्लवमानो यदृच्छया।\nसहस्रपत्रमर्काभं दिव्यं पद्ममुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023802, "chapter_id": 1510, "verse_number": "३-१४८-७", "content_sanskrit": "तदवैक्षत पाञ्चाली दिव्यगन्धं मनोरमम्।\nअनिलेनाहृतंभूमौ पतितं जलजं शुचि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023803, "chapter_id": 1510, "verse_number": "३-१४८-८", "content_sanskrit": "तच्छुभा शुभमासाद्य सौगन्धिकमनुत्तमम्।\nअतीव मुदिता राजन्भीमसेनमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023804, "chapter_id": 1510, "verse_number": "३-१४८-९", "content_sanskrit": "पश्य दिव्यं सुरुचिरं भीम पुष्पमनुत्तमम्।\nगन्धसंस्थानसंपन्नं मनसो मम नन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023805, "chapter_id": 1510, "verse_number": "३-१४८-१०", "content_sanskrit": "इदं च धर्मराजाय प्रदास्यामि परंतप।\n`गृह्यापराणि पुष्पाणि बहूनि पुरुषर्षभ।\nहरेरिदं मे कामाय काम्यके पुनराश्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023806, "chapter_id": 1510, "verse_number": "३-१४८-११", "content_sanskrit": "यदि तेऽहं प्रिया पार्थ बहूनीमान्युपाहर।\nतान्यहं नेतुमिच्छामि काम्यकं पुनराश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023807, "chapter_id": 1510, "verse_number": "३-१४८-१२", "content_sanskrit": "एवमुक्त्वा तु पाञ्चली भीमसेनमनिन्दिता।\nजगाम पुष्पमादाय धर्मराजाय तत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023808, "chapter_id": 1510, "verse_number": "३-१४८-१३", "content_sanskrit": "अभिप्रायं तु विज्ञाय महिष्याः पुरुषर्षभः।\nप्रियायाः प्रियकामः स प्रायाद्भीमो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023809, "chapter_id": 1510, "verse_number": "३-१४८-१४", "content_sanskrit": "वातं तमेवाभिमुखो यतस्तत्पुष्पमागतम्।\nआजिहीर्षुर्जगामाशु सपुष्पाण्यपराण्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023810, "chapter_id": 1510, "verse_number": "३-१४८-१५", "content_sanskrit": "रुक्मपृष्ठं धनुर्गृह्य शरांश्चाशीविषोपमान्।\nमृगराडिव संक्रुद्धः प्रभिन्न इव कुञ्जरः।\n[ददृशुः सर्वभूतानि महाबाणधनुर्धरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023811, "chapter_id": 1510, "verse_number": "३-१४८-१६", "content_sanskrit": "न ग्लानिर्न च वैक्लब्यं न भयं न च संभ्रमः।\nकदाचिज्जुषते पार्थमात्मजं मातरिश्वनः ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023812, "chapter_id": 1510, "verse_number": "३-१४८-१७", "content_sanskrit": "द्रौपद्याः प्रियमन्विच्छन्स बाहुबलमाश्रितः।\nव्यपेतभयसमोहः शैलमभ्यपतद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023813, "chapter_id": 1510, "verse_number": "३-१४८-१८", "content_sanskrit": "स तं द्रुमलतागुल्मच्छन्नं नीलशिलातलम्।\nगिरिं चचारारिहरः किन्नराचरितं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023814, "chapter_id": 1510, "verse_number": "३-१४८-१९", "content_sanskrit": "नानावर्णधरैश्चित्रं धातुद्रुममृगाण्डजैः।\nसर्वभूषणसंपूर्णं भूमेर्भुजमिवोच्छ्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023815, "chapter_id": 1510, "verse_number": "३-१४८-२०", "content_sanskrit": "सर्वर्तुरमणीयेषु गन्धमादनसानुषु।\nसक्तचक्षुरभिप्रायान्हृदयेनानुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023816, "chapter_id": 1510, "verse_number": "३-१४८-२१", "content_sanskrit": "पुंस्कोकिलनिनादेषु षट्पदाचरितेषु च।\nबद्धश्रोत्रमनश्चक्षुर्जगामामितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023817, "chapter_id": 1510, "verse_number": "३-१४८-२२", "content_sanskrit": "आजिघ्रन्स महातेजाः सर्वर्तुकुसुमोद्भवम्।\nगन्धमुद्धतमुद्दामो वने मत्त इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023818, "chapter_id": 1510, "verse_number": "३-१४८-२३", "content_sanskrit": "वीज्यमानः सुपुण्येन नानाकुसुमगन्धिना।\nपितुः संस्पर्शशीतेन गन्धमादनवायुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023819, "chapter_id": 1510, "verse_number": "३-१४८-२४", "content_sanskrit": "ह्रियमाणश्रमः पित्रा संप्रहृष्टतनूरुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023820, "chapter_id": 1510, "verse_number": "३-१४८-२५", "content_sanskrit": "स यक्षगन्धर्वसुरब्रह्मर्षिगणसेवितम्।\nविलोकयामास तदा पुष्पहेतोररिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023821, "chapter_id": 1510, "verse_number": "३-१४८-२६", "content_sanskrit": "विषमच्छदैरचितैरनुलिप्त इवाङ्गुलैः।\nविमलैर्धातुविच्छेदैः काञ्चनाञ्जनराजतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023822, "chapter_id": 1510, "verse_number": "३-१४८-२७", "content_sanskrit": "सपक्षमिव नृत्यन्तं पार्श्वलग्नैः पयोधरैः।\nमुक्ताहारैरिव चितं च्युतैः प्रस्रवणोदकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023823, "chapter_id": 1510, "verse_number": "३-१४८-२८", "content_sanskrit": "अभिरामदरीकुञ्जनिर्झरोदककन्दरम्।\nअप्सरोनूपुररवैः प्रनृत्तवरबर्हिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023824, "chapter_id": 1510, "verse_number": "३-१४८-२९", "content_sanskrit": "दिग्वारणविषाणाग्रैर्घृष्टोपलशिलातलम्।\nस्रस्तांशुकमिवाश्रोभ्यैर्निम्नगानिःसृतैर्जलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023825, "chapter_id": 1510, "verse_number": "३-१४८-३०", "content_sanskrit": "सशष्पकबलैः स्वस्थैरदूरपरिवर्तिभिः।\nभयानभिक्षज्ञैर्हरिणैः कौतूहलनिरीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023826, "chapter_id": 1510, "verse_number": "३-१४८-३१", "content_sanskrit": "चालयानः स्ववेगेन लताजालान्यनेकशः।\nआक्रीडमानः कौन्तेयः श्रीमान्वायुसुतो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023827, "chapter_id": 1510, "verse_number": "३-१४८-३२", "content_sanskrit": "प्रियामनोरथं कर्तुमुद्यतश्चारुलोचनः।\nप्रांशुः कनकवर्णाभः सिंहसंहननो युवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023828, "chapter_id": 1510, "verse_number": "३-१४८-३३", "content_sanskrit": "मत्तवारणविक्रन्तो मत्तवारणवेगवान्।\nमत्तवारणताम्राक्षो मत्तवारणवारणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023829, "chapter_id": 1510, "verse_number": "३-१४८-३४", "content_sanskrit": "प्रियपार्श्वोपविष्टाभिर्वायवृत्ताभिर्विचेष्टितैः।\nयक्षगन्धर्वयोषाभिरदृश्याभिर्निरीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023830, "chapter_id": 1510, "verse_number": "३-१४८-३५", "content_sanskrit": "नवावतारं रूपस् विक्रीडन्निव पाण्डवः।\nचचार रमणीयेषु गन्धमादनसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023831, "chapter_id": 1510, "verse_number": "३-१४८-३६", "content_sanskrit": "संस्मरन्विविधान्क्लेशान्दुर्योधनकृतान्बहून्।\nद्रौपद्या वनवासिन्याः प्रियं कर्तुं समुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023832, "chapter_id": 1510, "verse_number": "३-१४८-३७", "content_sanskrit": "सोऽचिन्तयत्तथा पार्थे मयि त्वतिविलम्बिते।\nपुष्पहेतोः कथं त्वार्यः करिष्यति युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023833, "chapter_id": 1510, "verse_number": "३-१४८-३८", "content_sanskrit": "स्नेहान्नरवरो नूनमविश्वासाद्बलस्य च।\nनकुलं सहदेवं च न मोक्ष्यति युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023834, "chapter_id": 1510, "verse_number": "३-१४८-३९", "content_sanskrit": "कथं नु कुसुमावाप्तिः स्याच्छीघ्रमिति चिन्तयन्।\nप्रतस्थे नरशार्दूलः पक्षिराडिव वेगितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023835, "chapter_id": 1510, "verse_number": "३-१४८-४०", "content_sanskrit": "[सज्जमानमनोदृष्टिः फुल्लेषु गिरिसानुषु।\nद्रौपदीवाक्यपाथेयो भीमः शीघ्रतरं ययौ ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023836, "chapter_id": 1510, "verse_number": "३-१४८-४१", "content_sanskrit": "कम्पयन्मेदिनीं पद्भ्यां निर्घात इव पर्वसु।\nत्रासयन्गजयूथानि वातरंहा वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023837, "chapter_id": 1510, "verse_number": "३-१४८-४२", "content_sanskrit": "सिंहव्याघ्रमृगांश्चैव मर्दयानो महाबलः।\nउन्मूलयन्महावृक्षान्पोथयंश्चोरसा बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023838, "chapter_id": 1510, "verse_number": "३-१४८-४३", "content_sanskrit": "लतावल्लीश्च वेगेन विकर्षन्पाण्डुनन्दनः।\nउपर्युपरि शैलाग्रमारुरुक्षुरिव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023839, "chapter_id": 1510, "verse_number": "३-१४८-४४", "content_sanskrit": "जलावलम्बोऽतिभृशं सविद्युदिव तोयदः।\n`व्यनदत्स महानादं भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023840, "chapter_id": 1510, "verse_number": "३-१४८-४५", "content_sanskrit": "तेन शब्देन महता भीमस्य प्रतिबोधिताः।\nगुहां संतत्यजुर्व्याघ्रा निलिल्युर्वनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023841, "chapter_id": 1510, "verse_number": "३-१४८-४६", "content_sanskrit": "समुत्पेतुः खगास्त्रस्ता मृगयूथानि दुद्रुवुः।\nऋक्षाश्चोत्ससृजर्वृक्षांस्तत्यजुर्हरयो गुहाम्।\nव्यजृम्भन्त महासिंहा महिषाश्च वनेचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2023842, "chapter_id": 1510, "verse_number": "३-१४८-४७", "content_sanskrit": "तेन वित्रासिता नागाः करेणुपरिवारिताः।\nतद्वनं संपरित्यज्य जग्मुरन्यन्महावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2023843, "chapter_id": 1510, "verse_number": "३-१४८-४८", "content_sanskrit": "वराहमृगसङ्घाश्च महिषाश्च वनेचराः।\nव्याघ्रगोमायुसङ्घाश्च प्रणेदुर्गवयैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2023844, "chapter_id": 1510, "verse_number": "३-१४८-४९", "content_sanskrit": "रथाङ्गसाह्वदात्यूहा हंसकारण्डवप्लवाः।\nशुकाः पारावताः कौञ्चा विसंज्ञा भेजिरे दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2023845, "chapter_id": 1510, "verse_number": "३-१४८-५०", "content_sanskrit": "तथाऽन्ये दर्पिता नागाः करेणुशरपीडिताः।\nसिंहव्याघ्राश्च संक्रुद्धा भीमसेनमथाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2023846, "chapter_id": 1510, "verse_number": "३-१४८-५१", "content_sanskrit": "शकृन्मूत्रं च मुञ्चाना भयविभ्रान्तमानसाः।\nव्यादितास्या महारौद्र व्यनदन्भीषणान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2023847, "chapter_id": 1510, "verse_number": "३-१४८-५२", "content_sanskrit": "ततो वायुसुतः क्रोधात्स्वबाहुबलमाश्रितः।\nगजेनान्यान्गजान्श्रीमान्सिंहं सिंहेन वा विभुः।\nतलप्रहारैरन्यांश्च व्यहनत्पाण्डवो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2023848, "chapter_id": 1510, "verse_number": "३-१४८-५३", "content_sanskrit": "ते वध्यमाना भीमेन सिंहव्याघ्रतरक्षवः।\nभयाद्विससृजुर्भीमं शकृन्मूत्रं च सुस्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2023849, "chapter_id": 1510, "verse_number": "३-१४८-५४", "content_sanskrit": "प्रविवेश ततः क्षिप्रं तानपास्य महाबलः।\nवनं पाण्डुसुतः श्रीमाञ्शब्देनापूरयन्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2023850, "chapter_id": 1510, "verse_number": "३-१४८-५५", "content_sanskrit": "अथापश्यन्महाबाहुर्गनधमादनसानुषु।\nसुरम्यं कदलीषणअडं बहुयोजनविस्तृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2023851, "chapter_id": 1510, "verse_number": "३-१४८-५६", "content_sanskrit": "तमभ्यगच्छद्वेगेन क्षोभयिष्यन्महाबलः।\nमहागज इवास्रावी प्रभञ्जन्विविधान्द्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2023852, "chapter_id": 1510, "verse_number": "३-१४८-५७", "content_sanskrit": "उत्पाट्य कदलीस्तम्भान्बहुतालसमुच्छ्रयान्।\nचिक्षेप तरसा भीमः समन्ताद्बलिनां वरः।\nविमर्दन्सुमहातेजा नृसिंह इव दर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2023853, "chapter_id": 1510, "verse_number": "३-१४८-५८", "content_sanskrit": "ततः संन्यपतंस्तत्रसुबहूनि महान्ति च।\nरुरुवारणयूथानि महिषाश्च जलाश्रयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2023854, "chapter_id": 1510, "verse_number": "३-१४८-५९", "content_sanskrit": "`प्रविवेश ततः क्षिप्रं तानपास्य महाबलः।\nवनं पाण्डुसुतः श्रीमान्नादेनापूरयन्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2023855, "chapter_id": 1510, "verse_number": "३-१४८-६०", "content_sanskrit": "तेन शब्देन चैवाथ भीमसेनरवेण च।\nवनान्तरगताश्चापि वित्रेसुर्मृहपक्षिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2023856, "chapter_id": 1510, "verse_number": "३-१४८-६१", "content_sanskrit": "तस्मिननथ प्रवृत्ते तु संक्षोभे मृगपक्षिणाम्।\nजलार्द्रपक्षा विहगाः समुत्पेतुः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2023857, "chapter_id": 1510, "verse_number": "३-१४८-६२", "content_sanskrit": "तानौदकान्पक्षिगणान्निरीक्ष्य भरतर्षभः।\nतानेवानुसरन्रम्यं ददर्श सुमहत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2023858, "chapter_id": 1510, "verse_number": "३-१४८-६३", "content_sanskrit": "काञ्चनैः कदलीषण्डैर्मन्दमारुतकम्पितैः।\nवीज्यमानमिवाक्षोभ्यं तीरात्तीरविसर्पिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2023859, "chapter_id": 1510, "verse_number": "३-१४८-६४", "content_sanskrit": "तत्सरोऽथावतीर्याशु प्रभूतनलिनोत्पलम्।\nमहागज इवोद्दामश्चिक्रीड बलवद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2023860, "chapter_id": 1510, "verse_number": "३-१४८-६५", "content_sanskrit": "विक्रीड्यतस्मिन्रुचिरमुत्ततारामितद्युतिः।\n`क्षोभयन्सलिलं भीमः प्रभिन्न इववारणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2023861, "chapter_id": 1510, "verse_number": "३-१४८-६६", "content_sanskrit": "ततो जगाहे वेगेन तद्वनं बहुपादपम्।\nदध्मौ च शङ्खं स्वनवत्सर्वप्राणेन पाण्डवः।\n[आस्फोटयच्च बलवान्भीमः संनादयन्दिशः ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2023862, "chapter_id": 1510, "verse_number": "३-१४८-६७", "content_sanskrit": "तस्य शङ्खस्य शब्दन भीमसेनरवेण च।\nबाहुशब्दन चोग्रेण नदन्तीव गिरेर्गुहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2023863, "chapter_id": 1510, "verse_number": "३-१४८-६८", "content_sanskrit": "तं वज्रनिष्पेषसममास्फोटितमहारवम्।\nश्रुत्वा शैलगुहासुप्तैः सिंहैर्मुक्तो महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2023864, "chapter_id": 1510, "verse_number": "३-१४८-६९", "content_sanskrit": "सिंहनादभयत्रस्तैः कुञ्जरैरपि भारत।\nमुक्तो विरावः सुमहान्पर्वतो येन पूरितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2023865, "chapter_id": 1510, "verse_number": "३-१४८-७०", "content_sanskrit": "तं तु नादं ततः श्रुत्वा सुप्तो वानरपुङ्गवः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2023866, "chapter_id": 1510, "verse_number": "३-१४८-७०", "content_sanskrit": "[भ्रातरं भीमसेनं तु विज्ञाय हनुमान्कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2023867, "chapter_id": 1510, "verse_number": "३-१४८-७१", "content_sanskrit": "दिवंगमं रुरोधाथ मार्गं भीमस्य कारणात्।\nअनेन हि पथा मा वै गच्छेदिति विचार्य सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2023868, "chapter_id": 1510, "verse_number": "३-१४८-७२", "content_sanskrit": "आस्त एकायने मार्गे कदलीषण्डमण्डिते।\nभ्रातुर्भीमस्य रक्षार्थं तं मार्गमवरुध्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2023869, "chapter_id": 1510, "verse_number": "३-१४८-७३", "content_sanskrit": "माऽत्र प्राप्स्यति शापं वा धर्षणां वेति पाण्डवः।\nकदलीषण्डमध्यस्थो ह्येवं संचिन्त्य वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2023870, "chapter_id": 1510, "verse_number": "३-१४८-७४", "content_sanskrit": "प्राजृम्भत महाकायो हनूमान्नाम वानरः।\nकदलीषण्डमध्यस्थो निद्रावशगतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2023871, "chapter_id": 1510, "verse_number": "३-१४८-७५", "content_sanskrit": "`तेन शब्देन महता व्यबुध्यत महाकपिः।\nजृम्भमाणः सुविपुलं शक्रध्वजमिवोच्छ्रितम्।\nआस्फोटयच्चलाङ्गूलमिन्द्राशनिसमस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2023872, "chapter_id": 1510, "verse_number": "३-१४८-७६", "content_sanskrit": "तस्य लाङ्गूलनिनदं पर्वतः सुगुहामुखैः।\nउद्गारमिव गौर्नर्दन्नुत्ससर्ज समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2023873, "chapter_id": 1510, "verse_number": "३-१४८-७७", "content_sanskrit": "लाङ्गूलास्फोटशब्दाच्च चलितः स महागिरिः।\nविघूर्णमानशिखरः समन्तात्पर्यशीर्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2023874, "chapter_id": 1510, "verse_number": "३-१४८-७८", "content_sanskrit": "स लाङ्गूलरवस्तस्य मत्तवारणनिस्वनम्।\nअन्तर्धायविचित्रेषु चचार गिरिसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2023875, "chapter_id": 1510, "verse_number": "३-१४८-७९", "content_sanskrit": "स भीमसेनस्तच्छ्रुत्वा संप्रहृष्टतनूरुहः।\nशब्दप्रभवमन्विच्छंश्चचार कदलीवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2023876, "chapter_id": 1510, "verse_number": "३-१४८-८०", "content_sanskrit": "कदलीवनमध्यस्थमथ पीने शिलातले।\nददर्श सुमहाबाहुर्वानराधिपतिं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2023877, "chapter_id": 1510, "verse_number": "३-१४८-८१", "content_sanskrit": "विद्युत्संपातदुष्प्रेक्षं विद्युत्संपातपिङ्गलम्।\nविद्युत्संपातनिनदं विद्युत्संपातचञ्चलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2023878, "chapter_id": 1510, "verse_number": "३-१४८-८२", "content_sanskrit": "बाहुस्वस्तिकविन्यस्तपीनवृत्तशिरोधरम्।\nस्कन्धभूयिष्ठकायत्वात्तनुमध्यकटीतटम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2023879, "chapter_id": 1510, "verse_number": "३-१४८-८३", "content_sanskrit": "किंचिच्चाभुग्नशीर्षेण दीर्घरोमाञ्चितेन च।\nलाङ्गूलेनोर्ध्वगतिना ध्वजेनेव विराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2023880, "chapter_id": 1510, "verse_number": "३-१४८-८४", "content_sanskrit": "ह्रस्वौष्ठं ताम्रजिह्वास्यं रक्तकर्णं चलद्धुवम्।\nअपश्यद्वदनं तस्य रश्मिवन्तमिवोडुपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2023881, "chapter_id": 1510, "verse_number": "३-१४८-८५", "content_sanskrit": "वदनाभ्यन्तरगतैः शुक्लैर्दन्तैरलंकृतम्।\nकेसरोत्करसंमिश्रमशोकानामिवोत्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2023882, "chapter_id": 1510, "verse_number": "३-१४८-८६", "content_sanskrit": "हिरण्मयीनां मध्यस्थं कदलीनां महाद्युतिम्।\nदीप्यमानेन वपुषा स्वर्चिष्मन्तमिवानलम्।\nनिरीक्षन्तमपत्रस्तं लोचनैर्मधुपिङ्गलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2023883, "chapter_id": 1510, "verse_number": "३-१४८-८७", "content_sanskrit": "तं वानरवरं धीमानतिकायं महाबलम्।\nस्वर्गपन्थानमावृत्य हिमवन्तमिव स्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2023884, "chapter_id": 1510, "verse_number": "३-१४८-८८", "content_sanskrit": "दृष्ट्वा चैनं महाबाहुरेकं तस्मिन्महावने।\nअथोपसृत्यतरसा भीमो भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2023885, "chapter_id": 1510, "verse_number": "३-१४८-८९", "content_sanskrit": "सिंहनादं चकारोग्रं वज्राशनिसमं बली।\nतेन शब्देन भीमस्य वित्रेसुर्मृगपक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2023886, "chapter_id": 1510, "verse_number": "३-१४८-९०", "content_sanskrit": "हनूमांश्च महासत्व ईषदुन्मील्य लोचने।\nदृष्ट्वा तमथ सावज्ञं लोचनैर्मधुपिङ्गलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2023887, "chapter_id": 1510, "verse_number": "३-१४८-९१", "content_sanskrit": "`ततः पवनजः श्रीमानन्तिकस्थं महौजसम्।\nस्मितेन चैनमासाद्यहनूमानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2023888, "chapter_id": 1510, "verse_number": "३-१४८-९२", "content_sanskrit": "किमर्थं सरुजस्तेऽहं सुखसुप्तः प्रबोधितः।\nननु नाम त्वया कार्या दया भूतेषु जानता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2023889, "chapter_id": 1510, "verse_number": "३-१४८-९३", "content_sanskrit": "वयं धर्मं न जानीमस्तिर्यग्योनिमुपाश्रिताः।\nनरास्तु बुद्धिसंपन्ना दयां कुर्वन्ति जन्तुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2023890, "chapter_id": 1510, "verse_number": "३-१४८-९४", "content_sanskrit": "क्रूरेषु कर्मसु कथं देहवाक्चित्तदूषिषु।\nधर्मघातिषु सज्जन्ते बुद्दिमन्तो भवद्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2023891, "chapter_id": 1510, "verse_number": "३-१४८-९५", "content_sanskrit": "न त्वं धर्मं विजानासि वृद्धा नोपासितास्त्वया।\nअल्पबुद्धितया बाल्यादुत्सादयसि यन्मृगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2023892, "chapter_id": 1510, "verse_number": "३-१४८-९६", "content_sanskrit": "ब्रूहि कस्त्वं किमर्थं वा किमिदं वनमागतः।\nवर्जितं मानुषैर्भावैस्तथैव पुरुषैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2023893, "chapter_id": 1510, "verse_number": "३-१४८-९७", "content_sanskrit": "क्व च त्वयाऽद्यगन्तव्यं प्रब्रूहि पुरुषर्षभ।\nअतः परमगम्योऽयं पर्वतः सुदुरारुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2023894, "chapter_id": 1510, "verse_number": "३-१४८-९८", "content_sanskrit": "विना सिद्धगतिं वीर गतिरत्र न विद्यते।\n[देवलोकस्य मार्गोऽयमगम्यो मानुषैः सदा] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2023895, "chapter_id": 1510, "verse_number": "३-१४८-९९", "content_sanskrit": "कारुण्यात्त्वामहं वीर वारयामि निबोध मे।\nनातः परं त्वया शक्यं गन्तुमाश्वसिहि प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2023896, "chapter_id": 1510, "verse_number": "३-१४८-१००", "content_sanskrit": "स्वागतं सर्वथैवेह तवाद्य मनुजर्षभ।\nइमान्यमृतकल्पानि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2023897, "chapter_id": 1510, "verse_number": "३-१४८-१०१", "content_sanskrit": "भक्षयित्वा निवर्तस्व मा वृथा प्राप्स्यसे वधम्।\nग्राह्यं यदि वचो मह्यं हितं मनुजपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2023898, "chapter_id": 1510, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारेत अरण्यपर्वणि तीर्थयात्रापर्वणि अष्टचत्वारिंशदधिकशततमोऽध्यायः ॥ २४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]