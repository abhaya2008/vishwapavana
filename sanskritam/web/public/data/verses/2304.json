[{"id": 2061004, "chapter_id": 2304, "verse_number": "८-२५-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061005, "chapter_id": 2304, "verse_number": "८-२५-१", "content_sanskrit": "पितृदेवर्षिसङ्घेभ्योऽभये दत्ते महात्मना।\nसत्कृत्य शंकरं प्राह ब्रह्मा लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061006, "chapter_id": 2304, "verse_number": "८-२५-२", "content_sanskrit": "इमान्यसुरदुर्गाणि लोकांस्त्रीनाक्रमन्ति हि।\nकश्च प्रजापतिर्घोरांस्तान्स्रर्वाञ्जहि मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061007, "chapter_id": 2304, "verse_number": "८-२५-३", "content_sanskrit": "वरातिसर्गाद्देवेश प्राजापत्यमिदं परम्।\nमयाऽधितिष्ठता दत्तो दानवेभ्यो महान्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061008, "chapter_id": 2304, "verse_number": "८-२५-४", "content_sanskrit": "नास्त्यन्यो युधि तेषां वै निहन्ता इति नः श्रुतम्।\nतानतिक्रान्तमर्यादान्नान्यः संहर्तुमर्हति।\nत्वामृते सर्वभूतेश त्वं ह्येषां प्रत्यरिर्वधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061009, "chapter_id": 2304, "verse_number": "८-२५-५", "content_sanskrit": "स त्वं देव प्रपन्नानां याचतां च दिवोकसाम्।\nकुरु प्रसादं वरद दानवाञ्जहि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061010, "chapter_id": 2304, "verse_number": "८-२५-६", "content_sanskrit": "त्वत्प्रसादाज्जगत्सर्वं सुखमैधत मानद।\nशरण्यस्त्वं हि देवानां वयं त्वां शरणं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061011, "chapter_id": 2304, "verse_number": "८-२५-७x", "content_sanskrit": "ईश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061012, "chapter_id": 2304, "verse_number": "८-२५-७", "content_sanskrit": "हन्तव्याः शत्रवः सर्वे युष्माकमिति मे मतिः।\nन त्वेकश्चोत्सहे हन्तुं बलिनः सुरविद्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061013, "chapter_id": 2304, "verse_number": "८-२५-८", "content_sanskrit": "ते यूयं सहिताः सर्वे मदीयेनापि तेजसा।\nजयध्वं युधि तान्सर्वान्सङ्घातेन महाबलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061014, "chapter_id": 2304, "verse_number": "८-२५-९x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061015, "chapter_id": 2304, "verse_number": "८-२५-९", "content_sanskrit": "अस्मत्तेजोबलं यावत्तावद्द्विगुणमेव वा।\nतत्तेषामिति मन्यामो दृष्टतेजोबला हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061016, "chapter_id": 2304, "verse_number": "८-२५-१०x", "content_sanskrit": "ईश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061017, "chapter_id": 2304, "verse_number": "८-२५-१०", "content_sanskrit": "वध्यास्ते सर्वथा पापा ये युष्मास्वपराधिनः।\nमम तेजोबलार्धेन सर्वे मृद्गथ शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061018, "chapter_id": 2304, "verse_number": "८-२५-११x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061019, "chapter_id": 2304, "verse_number": "८-२५-११", "content_sanskrit": "बिभर्तुं तव तेजोर्धं न शक्ष्याम सुरेश्वर।\nसर्वेषां नो बलार्धेन त्वमेव जहि शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061020, "chapter_id": 2304, "verse_number": "८-२५-१२", "content_sanskrit": "वयं च सर्वथा देव रक्षणीयास्तथैव च।\nस नो रक्ष महादेव त्वमेव जहि शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061021, "chapter_id": 2304, "verse_number": "८-२५-१३x", "content_sanskrit": "ईश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061022, "chapter_id": 2304, "verse_number": "८-२५-१३", "content_sanskrit": "मम तेजो न शक्ता हि सर्वे धारयितुं यदि।\nअहमेनान्वधिष्यामि युष्मत्तेजोर्धसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061023, "chapter_id": 2304, "verse_number": "८-२५-१४", "content_sanskrit": "बलार्धं यदि मे देवा न धारयितुमाहवे।\nशक्ताः सर्वे हि सङ्गम्य यूयं तत्प्रब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061024, "chapter_id": 2304, "verse_number": "८-२५-१५", "content_sanskrit": "समा भवन्ति मे सर्वे दानवाश्चामराश्च ये।\nशिवोऽस्मि सर्वभूतानां शिवत्वं तेन मे सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061025, "chapter_id": 2304, "verse_number": "८-२५-१६", "content_sanskrit": "किन्त्वधर्मेण वर्तन्ते यस्मात्ते सुरशत्रवः।\nतस्माद्वध्या मयाप्येते युष्माकं च हितेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061026, "chapter_id": 2304, "verse_number": "८-२५-१७", "content_sanskrit": "शरणं वः प्रपन्नानां धर्मेण च जिगीषताम्।\nसाहाय्यं वः करिष्यामि निहनिष्यामि वो रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061027, "chapter_id": 2304, "verse_number": "८-२५-१८", "content_sanskrit": "दीयतां च बलार्धं मे सर्वैरपि पृथक्पृथक्।\nपशुत्वं चैव मे लोकाः सर्वे कल्पन्तु पीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061028, "chapter_id": 2304, "verse_number": "८-२५-१९", "content_sanskrit": "पशूनां तु पतित्वं मे भवत्वद्य दिवौकसः।\nएवं न पापं प्राप्स्यामि पशून्हत्वा सुरद्विपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061029, "chapter_id": 2304, "verse_number": "८-२५-२०", "content_sanskrit": "कल्पयध्वं रथं दिव्यं रथाश्वांश्चैव पारगान्।\nधनुः शरं सारथिं च ततो जेष्यामि वो रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061030, "chapter_id": 2304, "verse_number": "८-२५-२१", "content_sanskrit": "इति श्रुत्वा वचो देवा देवदेवस्य भूपतेः।\nविषादमगमन्सर्वे पशुत्वं प्रति शङ्किताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061031, "chapter_id": 2304, "verse_number": "८-२५-२२", "content_sanskrit": "तेषां भावं भवो ज्ञात्वा देवस्तानब्रवीदिदम्।\nमा वोस्तु पशुभावेऽस्मिन्भयं विबुधसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061032, "chapter_id": 2304, "verse_number": "८-२५-२३", "content_sanskrit": "श्रूयतां पशुभावस्य विमोक्षः क्रियतां च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061033, "chapter_id": 2304, "verse_number": "८-२५-२४", "content_sanskrit": "यो वः पशुपतेश्चर्यां चरिष्यति स मोक्ष्यते।\nपशुत्वादिति सत्यं वः प्रतिजाने समागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061034, "chapter_id": 2304, "verse_number": "८-२५-२५", "content_sanskrit": "ये चाप्यन्ये चरिष्यन्ति व्रतं मोक्ष्यन्ति तेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061035, "chapter_id": 2304, "verse_number": "८-२५-२६", "content_sanskrit": "नै(त्य)ष्ठिकं द्वादशाब्दं वा अर्धमब्दमृतुत्रयम्।\nमासं द्वादशरात्रं गुह्यं व्रतं दिव्यं चरिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061036, "chapter_id": 2304, "verse_number": "८-२५-२७", "content_sanskrit": "तं तथेत्यब्रुवन्देवा देवदेवनमस्कृतम्।\nऊचुश्चेदं गृहाणेदं तेजसोऽर्धमिति प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061037, "chapter_id": 2304, "verse_number": "८-२५-२८", "content_sanskrit": "प्रत्युवाच तथेत्येव शूलधृद्राजसत्तम।\nततस्ते प्रददुः सर्वे तेजसोऽर्धं महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061038, "chapter_id": 2304, "verse_number": "८-२५-२९", "content_sanskrit": "सर्वमादाय सर्वेषां तेजसोऽर्धं दिवौकसाम्।\nतेजसाप्यधिको भूत्वा भूयोऽप्यतिबलोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061039, "chapter_id": 2304, "verse_number": "८-२५-३०", "content_sanskrit": "ततः प्रभृति देवानां देवदेवोऽभवद्भवः।\nपतिश्च सर्वभूतानां पशूनां चाभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061040, "chapter_id": 2304, "verse_number": "८-२५-३१", "content_sanskrit": "तस्मात्पशुपतिश्चोक्तो भवत्वाच्च भवेति वै॥\nअर्धमादाय सर्वेषां तेजसा प्रज्वलन्निव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061041, "chapter_id": 2304, "verse_number": "८-२५-३२", "content_sanskrit": "भासयामास तान्सर्वान्देवदेवो महाद्युतिः॥\nततोऽभिषिषिच्युः सर्वे सुरा रुद्रं पुरारिणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061042, "chapter_id": 2304, "verse_number": "८-२५-३३", "content_sanskrit": "महादेव इति ह्यासीद्देवदेवो महेश्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061043, "chapter_id": 2304, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि पञ्चविंशोऽध्यायः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]