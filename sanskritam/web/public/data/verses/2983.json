[{"id": 2093075, "chapter_id": 2983, "verse_number": "१३-११३-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्त्वा ततो भीष्मः पुनर्धर्मसुतं नृपम्।\nजनमेजयभूपाल उवाचेदं सहेतुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093076, "chapter_id": 2983, "verse_number": "१३-११३-२", "content_sanskrit": "एतस्मिन्नेव काले तु वसिष्ठमृषिसत्तमम्।\nइक्ष्वाकुवंशजो राजा सौदासो वदतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093077, "chapter_id": 2983, "verse_number": "१३-११३-३", "content_sanskrit": "सर्वलोकचरं सिद्धं ब्रह्मकोशं सनातनम्।\nपुरोहितमभिप्रष्टुमभिवाद्योपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093078, "chapter_id": 2983, "verse_number": "१३-११३-४", "content_sanskrit": "त्रैलोक्ये भगवन्किंस्वित्पविइत्रं कथ्यतेऽनघ।\nयत्कीर्तयन्सदा मर्त्यः प्राप्नुयात्पुण्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093079, "chapter_id": 2983, "verse_number": "१३-११३-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093080, "chapter_id": 2983, "verse_number": "१३-११३-५", "content_sanskrit": "तस्मै प्रोवाच वचनं प्रणताय हितं तदा।\nगवामुपनिषद्विद्यां नमस्कृत्य गवां शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093081, "chapter_id": 2983, "verse_number": "१३-११३-६", "content_sanskrit": "गावः सुरभिगन्धिन्यस्तथा गुग्गुलुगन्धयः।\nगावः प्रतिष्ठा भूतानां गावः स्वस्त्ययनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093082, "chapter_id": 2983, "verse_number": "१३-११३-७", "content_sanskrit": "गावो भूतं च भव्यं च गावः पुष्टिः सनातनी।\nगावो लक्ष्म्यास्तथा मूलं गोषु दत्तं न नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093083, "chapter_id": 2983, "verse_number": "१३-११३-८", "content_sanskrit": "अन्नं हि परमं गावो देवानां परमं हविः।\nस्वाहाकारवषट्कारौ गोषु नित्यं प्रतिष्ठितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093084, "chapter_id": 2983, "verse_number": "१३-११३-९", "content_sanskrit": "गावो यज्ञस्य हि फलं गोषु यज्ञाः प्रतिष्ठिताः।\nगावो भविष्यं भूतं च गोषु यज्ञाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093085, "chapter_id": 2983, "verse_number": "१३-११३-१०", "content_sanskrit": "सायं प्रातश्च सततं होमकाले महाद्युते।\nगावो ददति वै हौम्यमृषिभ्यः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093086, "chapter_id": 2983, "verse_number": "१३-११३-११", "content_sanskrit": "यानि कानि च दुर्गाणि दुष्कृतानि कृतानि च।\nतरन्ति चैव पाप्मानं धेनुं ये ददति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093087, "chapter_id": 2983, "verse_number": "१३-११३-१२", "content_sanskrit": "एकां च दशगुर्दद्याद्दश दद्याच्च गोशती।\nशतं सहस्रगुर्दद्यात्सर्वे तुल्यफला हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093088, "chapter_id": 2983, "verse_number": "१३-११३-१३", "content_sanskrit": "अनाहिताग्निः शतगुरयज्वा च सहस्रगुः।\nसमृद्धो यश्च कीनाशो नार्घमर्हन्ति ते त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093089, "chapter_id": 2983, "verse_number": "१३-११३-१४", "content_sanskrit": "कपिलां ये प्रयच्छन्ति सवत्सां कांस्यदोहनाम्।\nसुव्रतां वस्त्रसंवीतामुभौ लोकौ जयन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093090, "chapter_id": 2983, "verse_number": "१३-११३-१५", "content_sanskrit": "युवानमिन्द्रियोपेतं शतेन सहयूथपम्।\nगवेन्द्रं ब्राह्मणेन्द्राय भूरिशृङ्गमलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093091, "chapter_id": 2983, "verse_number": "१३-११३-१६", "content_sanskrit": "वृषबं ये प्रयच्छन्ति श्रोत्रियाय परन्तप।\nऐश्वर्यं तेऽधिगच्छन्ति जायमानाः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093092, "chapter_id": 2983, "verse_number": "१३-११३-१७", "content_sanskrit": "नाकीर्तयित्वा गाःक सुप्यात्तासां संस्मृत्य चोत्पतेत्।\nसायं प्रातर्नमस्येच्च गास्ततः पुष्टिमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093093, "chapter_id": 2983, "verse_number": "१३-११३-१८", "content_sanskrit": "गवां मूत्रपुरीषस्य नोद्विजेत कथञ्चन।\nन चासां मांसमश्नीयाद्गवां पुष्टिं तथाऽऽप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093094, "chapter_id": 2983, "verse_number": "१३-११३-१९", "content_sanskrit": "गाश्च संकीर्तयन्नित्यं नावमन्येत तास्तथा।\nअनिष्टं स्वप्नमालक्ष्य गां नरः सम्प्रकीर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093095, "chapter_id": 2983, "verse_number": "१३-११३-२०", "content_sanskrit": "गोमयेन सदा स्नायाद्गोकरीषे च संविशेत्।\nश्लोष्ममूत्रपुरीषाणि प्रतिघातं च वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093096, "chapter_id": 2983, "verse_number": "१३-११३-२१", "content_sanskrit": "सार्द्रे चर्मणि भुञ्जीत निरीक्षेद्वारुणीं दिशम्।\nवाग्यतः सर्पिषा भूमौ गवां व्युष्टिं सदाऽऽश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093097, "chapter_id": 2983, "verse_number": "१३-११३-२२", "content_sanskrit": "घृतेन जुहुयादग्निं घृतेन स्वस्ति वाचयेत्।\nघृतं दद्याद्धृतं प्राशेद्गवां व्युष्टिं सदाऽऽश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093098, "chapter_id": 2983, "verse_number": "१३-११३-२३", "content_sanskrit": "गोमत्या विद्यया धेनुं तिलानामभिमन्त्र्य यः।\nसर्वरत्नमयीं दद्यान्न स शोचेत्कृताकृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093099, "chapter_id": 2983, "verse_number": "१३-११३-२४", "content_sanskrit": "गावो मामुपतिष्ठन्तु हेमशृङ्ग्यः पयोमुचः।\nसुरभ्यः सौरभेय्यश्च सरितः सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093100, "chapter_id": 2983, "verse_number": "१३-११३-२५", "content_sanskrit": "गा वै पश्याम्यहं नित्यं गावः पश्यन्तु मां सदा।\nगावोस्माकं वयं तासां यतो गावस्ततो वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093101, "chapter_id": 2983, "verse_number": "१३-११३-२६", "content_sanskrit": "एवं रात्रौ दिवा चापि समेषु विषमेषु च।\nमहाभयेषु च नरः कीर्तयन्मुच्यते भवात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093102, "chapter_id": 2983, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयोदशाधिकशततमोऽध्यायः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]