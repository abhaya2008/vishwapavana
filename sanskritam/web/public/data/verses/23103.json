[{"id": 7003103000, "chapter_id": 23103, "verse_number": "४-३९-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nइति स्तुत्वा हिमगिरिर्वसतः शङ्करस्य च ।\nउवास पुरतो दूरे लब्धाज्ञः  सर्वसंमतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003103001, "chapter_id": 23103, "verse_number": "४-३९-२", "content_sanskrit": "मधुपर्कादिकं तस्मै प्रददौ भक्तिपूर्वकम् ।\nमुनीन्संपूजयामास ततः शङ्करपार्षदान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003103002, "chapter_id": 23103, "verse_number": "४-३९-३", "content_sanskrit": "तदा तत्र समागत्य मेनका स्त्रीगणैः सह ।\nददर्श वटमूलस्थं शङ्करं चन्द्रशेखरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003103003, "chapter_id": 23103, "verse_number": "४-३९-४", "content_sanskrit": "ईषद्धास्यप्रसन्नास्यं वसन्तं व्याघ्रचर्मणि ।\nमध्ये मुनिगणानां च ज्वलन्तं ब्रह्मतेजसा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003103004, "chapter_id": 23103, "verse_number": "४-३९-५", "content_sanskrit": "यथाऽऽकाशे तारकाणां द्विजराजं विराजितम् ।\nपरमाह्लादकं रूपं कंदर्पकोटिसन्निभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003103005, "chapter_id": 23103, "verse_number": "४-३९-६", "content_sanskrit": "विहाय वार्द्धकावस्थां दधतं नवयौवनम् ।\nअतीव सुन्दरं रम्यं चित्तचोरं च योषिताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003103006, "chapter_id": 23103, "verse_number": "४-३९-७", "content_sanskrit": "कामं कामातुराणां च सतीनां च सुतं यथा ।\nवैष्णवानां महाविष्णुं शैवानां च सदाशिवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003103007, "chapter_id": 23103, "verse_number": "४-३९-८", "content_sanskrit": "शक्तिस्वरूपं शाक्तानां सौराणां सूर्यरूपिणम् ।\nकालस्वरूपं दुष्टानां शिष्टानां परिपालकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003103008, "chapter_id": 23103, "verse_number": "४-३९-९", "content_sanskrit": "कालकालसमं मृत्योर्मृत्युमृत्यु भयानकम् ।\nव्याघ्रचर्म चारुवस्त्रं बभूव भस्म चंदनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003103009, "chapter_id": 23103, "verse_number": "४-३९-१०", "content_sanskrit": "सर्पाः सुंदरमाल्यानि कस्तूरी या विषप्रभा ।\nजटासु ललिता चूडा चंद्रस्त्वलिकचंदनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003103010, "chapter_id": 23103, "verse_number": "४-३९-११", "content_sanskrit": "सुचार्वी मालतीमाला गंगाधारा मनोहरा ।\nअस्थिमाला रत्नमाला धत्तूरं चारुचंपकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003103011, "chapter_id": 23103, "verse_number": "४-३९-१२", "content_sanskrit": "एकीभूतं पंचवक्त्रं नेत्रयुग्माब्जशोभितम् ।\nशरत्पार्वणचंद्राभं प्रच्छाद्य दीप्तमुत्तम म् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003103012, "chapter_id": 23103, "verse_number": "४-३९-१३", "content_sanskrit": "बंधुजीवविनिंद्यैकमोष्ठाधरमनोहरम् ।\nश्वेतश्चन्द्रो वृषेंद्रश्च भूताद्या नर्तका इव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003103013, "chapter_id": 23103, "verse_number": "४-३९-१४", "content_sanskrit": "सद्यो व्यतिक्रमं सर्वं महेशस्य महेश्वरि ।\nदृष्ट्वैवं शिवरूपं च मेना तुष्टा बभूव ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003103014, "chapter_id": 23103, "verse_number": "४-३९-१५", "content_sanskrit": "काश्चिन्निमेषरहिताः कामेन पुलकांचिताः ।\nअतिकामातुराः सत्यः प्रापुर्मूर्च्छां च काश्चन ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003103015, "chapter_id": 23103, "verse_number": "४-३९-१६", "content_sanskrit": "काश्चिद्विनिंद्य कांतांश्च प्रशशंसुर्महेश्वरम् ।\nमनोरथेन मनसा समाश्लिष्यंति काश्चन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003103016, "chapter_id": 23103, "verse_number": "४-३९-१७", "content_sanskrit": "काचिन्मानसिकं कामात्कुर्वन्ती चुम्बनं मुदा ।\nध्रुवं कामं करिष्यामो वयं च कामसागरे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003103017, "chapter_id": 23103, "verse_number": "४-३९-१८", "content_sanskrit": "अस्माकमेव भर्ता चेत्परत्रैव यशो भवेत् ।\nइहैवं किं करिष्यामो वयं कांतैरतैरलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003103018, "chapter_id": 23103, "verse_number": "४-३९-१९", "content_sanskrit": "दृष्ट्वा तमेवं सुचिरमिति जल्पंति काश्चन ।\nकाश्चिद्दृष्ट्वा शिवं किंचिन्मुखमाच्छाद्य वाससा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003103019, "chapter_id": 23103, "verse_number": "४-३९-२०", "content_sanskrit": "सस्मिता वक्रनयनाः पश्यंत्येव पुनःपुनः ।\nवयं गृहं न यास्यामो यास्यामः शिवसन्निधिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003103020, "chapter_id": 23103, "verse_number": "४-३९-२१", "content_sanskrit": "शरत्सुधांशुवदनं द्रक्ष्यामोऽहर्निशं मुदा ।\nसंसारं न करिष्यामः प्रविशामो हुताशनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003103021, "chapter_id": 23103, "verse_number": "४-३९-२२", "content_sanskrit": "भविता नः शिवः स्वामीत्येवं जल्पंति काश्चन ।\nअहो पुण्यवती दुर्गा श्लाघ्यते जन्म भारते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003103022, "chapter_id": 23103, "verse_number": "४-३९-२३", "content_sanskrit": "यस्या अयं शिवः स्वामीत्येवं जल्पंति काश्चन ।\nमुदा मेना शिवं दृष्ट्वा गृहं ताभिर्जगाम ह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003103023, "chapter_id": 23103, "verse_number": "४-३९-२४", "content_sanskrit": "शिवं संपूज्य शैलेंद्रः प्रणम्य स्वगृहं ययौ ।\nकृत्वाऽनुमानं रहसि गिरीशो मेनया सह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003103024, "chapter_id": 23103, "verse_number": "४-३९-२५", "content_sanskrit": "दुर्गां प्रस्थापयामास शिवाय शिवसन्निधिम् ।\nपार्वती सखिभिः सार्द्धं वेषं कृत्वा मनोहरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003103025, "chapter_id": 23103, "verse_number": "४-३९-२६", "content_sanskrit": "भावानुरक्ता हर्षेण जगाम शिवसंनिधिम् ।\nदृष्ट्वा शिवा शिवं शांतं प्रसन्नवदनेक्षणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003103026, "chapter_id": 23103, "verse_number": "४-३९-२७", "content_sanskrit": "सप्तप्रदक्षिणं कृत्वा सस्मिता प्रणनाम सा ।\nअनन्यभावं गुणिनमपरं ज्ञानिनां वरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003103027, "chapter_id": 23103, "verse_number": "४-३९-२८", "content_sanskrit": "सुंदरं लभ भर्तारं सुन्दरीत्याशिषं ददौ ।\nभविता तव सौभाग्यं शुभे स्वामिनि संततम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003103028, "chapter_id": 23103, "verse_number": "४-३९-२९", "content_sanskrit": "पुत्रस्ते भविता साध्वि नारायणसमो गुणैः ।\nभविता ते परा पूजा त्रैलोक्ये जगदम्बिके ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003103029, "chapter_id": 23103, "verse_number": "४-३९-३०", "content_sanskrit": "ब्रह्माण्डेषु च सर्वेषु सर्वेषां च परा भव ।\nसप्तप्रदक्षिणाः कृत्वा यतो भक्त्या त्वया नतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003103030, "chapter_id": 23103, "verse_number": "४-३९-३१", "content_sanskrit": "सप्तजन्मनि तुष्टोऽहं तत्फलं लभ सुन्दरि ।\nतीर्थे कान्तेऽभीष्टदेवे गुरौ मन्त्रे तथौषधे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003103031, "chapter_id": 23103, "verse_number": "४-३९-३२", "content_sanskrit": "आस्था च यादृशी यासां सिद्धिस्तासां च तादृशी ।\nइत्युक्त्वा शङ्करस्तूर्णं ब्रह्मज्योतिः परं च माम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003103032, "chapter_id": 23103, "verse_number": "४-३९-३३", "content_sanskrit": "दध्यौ योगासनं कृत्वा योगीशो व्याघ्रचर्मणि ।\nप्रक्षाल्य चरणौ देवी पपौ तच्चरणोदकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003103033, "chapter_id": 23103, "verse_number": "४-३९-३४", "content_sanskrit": "चकार मार्जनं भक्त्या वह्निशौचेन वाससा ।\nरत्नसिंहासनं रम्यं विश्वकर्मादिनिर्मितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003103034, "chapter_id": 23103, "verse_number": "४-३९-३५", "content_sanskrit": "अपूर्वं कांस्यपात्रस्थं नैवेद्यं प्रददौ किल ।\nअर्घ्यं मंदाकिनीतोय संयुक्तं चरणे ददौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003103035, "chapter_id": 23103, "verse_number": "४-३९-३६", "content_sanskrit": "सुगन्धिचन्दनं चारु कस्तूरीकुङ्कुमान्वितम् ।\nप्रददौ मालतीमालां गले गरलसुन्दरे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003103036, "chapter_id": 23103, "verse_number": "४-३९-३७", "content_sanskrit": "भक्त्या पूजां चकाराथ पुष्पवृष्टिं च तुष्टये ।\nपीयूषं स्वर्णपात्रस्थं प्रददौ मधुरं मधु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003103037, "chapter_id": 23103, "verse_number": "४-३९-३८", "content_sanskrit": "रत्नप्रदीपशतकं समन्ताद्धूपमुत्तमम् ।\nत्रैलोक्यदुर्लभं वस्त्रं स्वर्णयज्ञोपवीतकम्  ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003103038, "chapter_id": 23103, "verse_number": "४-३९-३९", "content_sanskrit": "सुगन्धिशीततोयं च पानार्थं पार्वती ददौ ।\nअतीव सुन्दरं रम्यं रत्नसारेन्द्रभूषणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003103039, "chapter_id": 23103, "verse_number": "४-३९-४०", "content_sanskrit": "दुर्लभां कामधेनुं च  स्वर्णशृङ्गसमन्विताम् ।\nस्नानीयं तीर्थतोयं च ताम्बूलं च मनोहरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003103040, "chapter_id": 23103, "verse_number": "४-३९-४१", "content_sanskrit": "दत्त्वा षोडशोपचारं प्रणनाम पुनः पुनः ।\nसंपूज्य शूलिनं भक्त्या ययौ नित्यं पितुर्गृहम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003103041, "chapter_id": 23103, "verse_number": "४-३९-४२", "content_sanskrit": "शुश्रावाप्सरसां वक्त्राद्देवीमिन्द्रो महेश्वरः ।\nश्रुत्वा वार्तां शुनासीरो ननर्त हर्षसंयुतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003103042, "chapter_id": 23103, "verse_number": "४-३९-४३", "content_sanskrit": "दूतद्वारा कामदेवमानिनाय त्वरान्वितः ।\nइन्द्राज्ञया कामदेवः प्रजगामामरावतीम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003103043, "chapter_id": 23103, "verse_number": "४-३९-४४", "content_sanskrit": "तूर्णं प्रस्थापयामास तं च यत्र शिवः शिवा ।\nपञ्चसायकसंयुक्तो जगाम पञ्चसायकः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003103044, "chapter_id": 23103, "verse_number": "४-३९-४५", "content_sanskrit": "प्रसन्नवदनः श्रीमान्यत्र शक्तियुतः शिवः।\nगत्वा ददर्श मदनः शिवायुक्तं शिवं विभुम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003103045, "chapter_id": 23103, "verse_number": "४-३९-४६", "content_sanskrit": "शान्तं त्रैलोक्यकान्तं च प्रसन्नवदनेक्षणम्। ।\nकामः स्थितोऽन्तरिक्षे च धृत्वा च सशरं धनुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003103046, "chapter_id": 23103, "verse_number": "४-३९-४७", "content_sanskrit": "चिक्षेपास्त्रं दुर्निवार्यममोघं शंकरे मुदा ।\nबभूवामोघमस्त्रं च मोघं तत्परमात्मनि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003103047, "chapter_id": 23103, "verse_number": "४-३९-४८", "content_sanskrit": "आकाश इव निर्लिप्ते निर्लिप्ते परमात्मनि ।\nमोघीभूते च शस्त्रे च भयमाप च मन्मथः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003103048, "chapter_id": 23103, "verse_number": "४-३९-४९", "content_sanskrit": "चकम्पे पुरतः स्थित्वा दृष्ट्वा मृत्युंजयं विभुम् ।\nसस्मार त्रिदशान्कामः शक्रादीन्भयविह्वलः॥ ।४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003103049, "chapter_id": 23103, "verse_number": "४-३९-५०", "content_sanskrit": "आययुर्देवताः सर्वाः शंभुकोपेन वेपिताः। ।\nचक्रुः स्तुतिं च स्तोत्रेण शंकरं त्रिदशेश्वरम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003103050, "chapter_id": 23103, "verse_number": "४-३९-५१", "content_sanskrit": "कोपाग्निमुद्गिरन्तं तं कपाललोचनादहो ।\nस्तुतिं कुर्वत्सु देवेषु स वह्निः शंभुसंभवः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003103051, "chapter_id": 23103, "verse_number": "४-३९-५२", "content_sanskrit": "जज्वालोर्ध्वशिखो दीप्तः प्रलयाग्निशिखोपमः ।\nउत्पत्य गगने घूर्णन्निपत्य    धरणीतले ।\nभ्रामंभ्रामं च परितः पपात मदनोपरि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003103052, "chapter_id": 23103, "verse_number": "४-३९-५३", "content_sanskrit": "बभूव भस्मसात्कामः क्षणेन हरकोपतः। ।\nविषण्णा देवताः सर्वा नतवक्त्रा च पार्वती ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003103053, "chapter_id": 23103, "verse_number": "४-३९-५४", "content_sanskrit": "विललाप बहुतरं हरस्य पुरतो रतिः ।\nतुष्टुवुर्देवताः सर्वाः कम्पिताश्चन्द्रशेखरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003103054, "chapter_id": 23103, "verse_number": "४-३९-५५", "content_sanskrit": "रतिमूचुः सुराः सर्वे रुरुदुश्च मुहुर्मुहुः ।\nकिंचिद्भस्म गृहीत्वा च रक्ष मातर्भयं त्यज ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003103055, "chapter_id": 23103, "verse_number": "४-३९-५६", "content_sanskrit": "वयं तं जीवयिष्यामो लभिष्यसि प्रियं पुनः ।\nहरकोपापनयने सुप्रसन्ने दिने तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003103056, "chapter_id": 23103, "verse_number": "४-३९-५७", "content_sanskrit": "दृष्ट्वा रतेर्विलापं च मूर्च्छां संप्राप पार्वती ।\nअतीन्द्रियं गुणातीतं तुष्टाव चन्द्रशेखरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003103057, "chapter_id": 23103, "verse_number": "४-३९-५८", "content_sanskrit": "रुदन्तीं पार्वतीं त्यक्त्वा स्वस्थानं प्रययौ शिवः। ।\nसद्यो बभूव तत्रैव पार्वतीदर्पमोक्षणम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003103058, "chapter_id": 23103, "verse_number": "४-३९-५९", "content_sanskrit": "रूपयौवनयोर्गर्वं तत्याज शैलकन्यका ।\nमुखं दर्शयितुं लज्जा तद्बभूव सखीगणे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003103059, "chapter_id": 23103, "verse_number": "४-३९-६०", "content_sanskrit": "सुराश्च रतिमाश्वास्य सर्वे जग्मुः स्वमन्दिरम् ।\nप्रणम्य दण्डवद्रुद्रं शोकादुद्विग्नमानसाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003103060, "chapter_id": 23103, "verse_number": "४-३९-६१", "content_sanskrit": "स्तुत्वा रुदित्वा शोकेन भयेन कामकामिनी ।\nकोपरक्तेक्षणं रुद्रं राधिके स्वालयं ययौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003103061, "chapter_id": 23103, "verse_number": "४-३९-६२", "content_sanskrit": "न जगाम पितुर्गेहं पार्वती सा तु लज्जया ।\nस्वालिभिर्वार्यमाणाऽपि जगाम तपसे वनम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003103062, "chapter_id": 23103, "verse_number": "४-३९-६३", "content_sanskrit": "प्रजग्मुः सहचारिण्यस्तत्पश्चाच्छोकविह्वलाः ।\nमातृभिर्वार्यमाणा सा स्वर्णदीतीरजं वनम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003103063, "chapter_id": 23103, "verse_number": "४-३९-६४", "content_sanskrit": "सुचिरं च तपस्तप्त्वा सा संप्राप त्रिलोचनम् ।\nरतिः संप्राप मदनं शंकरस्य वरेण च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003103064, "chapter_id": 23103, "verse_number": "४-३९-६५", "content_sanskrit": "इत्येवं कथितं सर्वं पार्वतीदर्पमोक्षणम् ।\nनिगूढचरितं राधे किं भूयः श्रोतुमिच्छसि ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]