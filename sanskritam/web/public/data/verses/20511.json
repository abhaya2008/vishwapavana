[{"id": 7000511000, "chapter_id": 20511, "verse_number": "३-५८-१", "content_sanskrit": "व्यास उवाच ।\nएवं गृहाश्रमे स्थित्वा द्वितीयं भागमायुषः ।\nवानप्रस्थाश्रमं गच्छेत्सदारः साग्निरेव च॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000511001, "chapter_id": 20511, "verse_number": "३-५८-२", "content_sanskrit": "निक्षिप्य भार्यां पुत्रेषु गच्छेद्वनमथापि वा ।\nदृष्ट्वापत्यस्य वापत्यं जर्जरीकृतविग्रहः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000511002, "chapter_id": 20511, "verse_number": "३-५८-३", "content_sanskrit": "शुक्लपक्षस्य पूर्वाह्णे प्रशस्ते चोत्तरायणे ।\nगत्वारण्यं नियमवांस्तपः कुर्यात्समाहितः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000511003, "chapter_id": 20511, "verse_number": "३-५८-४", "content_sanskrit": "फलमूलानि पूतानि नित्यमाहारमाहरेत् ।\nयदाहारो भवेत्तेन पूजयेत्पितृदेवताः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000511004, "chapter_id": 20511, "verse_number": "३-५८-५", "content_sanskrit": "पूजयेदतिथिं नित्यं स्नात्वा चाभ्यर्चयेत्सुरान् ।\nगृहादादाय चाश्नीयादष्टौ ग्रासान्समाहितः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000511005, "chapter_id": 20511, "verse_number": "३-५८-६", "content_sanskrit": "जटाश्च बिभृयान्नित्यं नखरोमाणि नोत्सृजेत् ।\nस्वाध्यायं सर्वथा कुर्यान्नियच्छेद्वाचमन्यतः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000511006, "chapter_id": 20511, "verse_number": "३-५८-७", "content_sanskrit": "अग्निहोत्रं च जुहुयात्पंचयज्ञान्समाचरेत् ।\nउत्पन्नैर्विविधैर्मेध्यैः शाकमूलफलेन वा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000511007, "chapter_id": 20511, "verse_number": "३-५८-८", "content_sanskrit": "चीरवासा भवेन्नित्यं स्नायात्त्रिषवणं शुचिः ।\nसर्वभूतानुकंपश्च प्रतिग्रहविवर्जितः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000511008, "chapter_id": 20511, "verse_number": "३-५८-९", "content_sanskrit": "दर्शेन पौर्णमासेन यजेत नियतं द्विजः ।\nऋत्विष्ट्याग्रयणे चैव चातुर्मास्यानि कारयेत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000511009, "chapter_id": 20511, "verse_number": "३-५८-१०", "content_sanskrit": "उत्तरायणं च क्रमशो दक्षिणायनमेव च ।\nवासंतशारदैर्मेद्ध्यैरुत्पन्नैः स्वयमाहृतैः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000511010, "chapter_id": 20511, "verse_number": "३-५८-११", "content_sanskrit": "पुरोडाशांश्चरूंश्चैव विधिवन्निर्वपेत्पृथक् ।\nदेवताभ्यः पितृभ्यश्च दत्त्वा मेध्यतरं हविः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000511011, "chapter_id": 20511, "verse_number": "३-५८-१२", "content_sanskrit": "शेषं समुपभुंजीत लवणं च स्वयंकृतम् ।\nवर्ज्जयेन्मद्यमांसानि भौमानि कवकानि च॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000511012, "chapter_id": 20511, "verse_number": "३-५८-१३", "content_sanskrit": "भूस्तृणं शष्पकं चैव श्लेष्मातक फलानि च ।\nन फालकृष्टमश्नीयादुत्सृष्टमपि केनचित्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000511013, "chapter_id": 20511, "verse_number": "३-५८-१४", "content_sanskrit": "न ग्रामजातान्यार्तोपि पुष्पाणि च फलानि च ।\nश्रावणेनैव विधिना वह्निं परिचरेत्सदा॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000511014, "chapter_id": 20511, "verse_number": "३-५८-१५", "content_sanskrit": "न द्रुह्येत्सर्वभूतानि निर्द्वंद्वो निर्भयो भवेत् ।\nन नक्तं किंचिदश्नीयाद्रात्रौ ध्यानपरो भवेत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000511015, "chapter_id": 20511, "verse_number": "३-५८-१६", "content_sanskrit": "जितेंद्रियो जितक्रोधस्तत्त्वज्ञानविचिंतकः ।\nब्रह्मचारी भवेन्नित्यं न पत्नीमपि संश्रयेत्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000511016, "chapter_id": 20511, "verse_number": "३-५८-१७", "content_sanskrit": "यस्तु पत्न्या वनं गत्वा मैथुनं कामतश्चरेत् ।\nतद्व्रतं तस्य लुप्येत प्रायश्चित्तीयते द्विजः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000511017, "chapter_id": 20511, "verse_number": "३-५८-१८", "content_sanskrit": "तत्र यो जायते गर्भो न स स्पृश्यो द्विजातिभिः ।\nन हि वेदेधिकारोस्य तद्वंशेप्येवमेव हि॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000511018, "chapter_id": 20511, "verse_number": "३-५८-१९", "content_sanskrit": "भूमौ शयीत सततं सावित्रीजप्यतत्परः ।\nशरण्यः सर्वभूतानां सद्विभागपरः सदा॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000511019, "chapter_id": 20511, "verse_number": "३-५८-२०", "content_sanskrit": "परिवादं मृषावादं निद्रालस्ये च वर्जयेत् ।\nएकाग्निरनिकेतः स्यात्प्रोक्षितां भूमिमाश्रयेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000511020, "chapter_id": 20511, "verse_number": "३-५८-२१", "content_sanskrit": "मृगैः सह चरेद्दांतस्तैः सहैव च संवसेत् ।\nशिलायां शर्करायां वा शयीत सुसमाहितः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000511021, "chapter_id": 20511, "verse_number": "३-५८-२२", "content_sanskrit": "सद्यः प्रक्षालको वा स्यान्माससंचयिकोपि वा ।\nषण्मासनिचयो वापि समानिचय एव वा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000511022, "chapter_id": 20511, "verse_number": "३-५८-२३", "content_sanskrit": "नक्तं चान्नं समश्नीयाद्दिवा चाहृत्य शक्तितः ।\nचतुर्थकालको वा स्यात्किं वाप्यष्टमकालिकः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000511023, "chapter_id": 20511, "verse_number": "३-५८-२४", "content_sanskrit": "चांद्रायणविधानैर्वा शुक्लेकृष्णे च वर्जयेत् ।\nपक्षेपक्षे समश्नीयाद्यवागूं क्वथितां सकृत्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000511024, "chapter_id": 20511, "verse_number": "३-५८-२५", "content_sanskrit": "पुष्पमूलफलैर्वापि केवलैर्वर्तयेत्सदा ।\nस्वाभाविकैः स्वयंशीर्णैर्वैखानसमते स्थितः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000511025, "chapter_id": 20511, "verse_number": "३-५८-२६", "content_sanskrit": "भूमौ वा परिवर्तेत तिष्ठेद्वा प्रपदैर्दिनम् ।\nस्थानासनाभ्यां विहरेन्न क्वचिद्धैर्य्यमुत्सृजेत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000511026, "chapter_id": 20511, "verse_number": "३-५८-२७", "content_sanskrit": "ग्रीष्मे पंचतपाश्च स्याद्वर्षास्वभ्रावकाशिकः ।\nआर्द्रवासाश्च हेमंते क्रमशो वर्द्धयेत्तपः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000511027, "chapter_id": 20511, "verse_number": "३-५८-२८", "content_sanskrit": "उपस्पृशेत्त्रिषवणं पितृदेवांश्च तर्पयेत् ।\nएकपादेन तिष्ठेत मरीचिं वा पिबेत्सदा॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000511028, "chapter_id": 20511, "verse_number": "३-५८-२९", "content_sanskrit": "पंचाग्निधूमगो वा स्यादूष्मगः सोमपोपि वा ।\nपयः पिबेच्छुक्लपक्षे कृष्णपक्षे तु गोमयम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000511029, "chapter_id": 20511, "verse_number": "३-५८-३०", "content_sanskrit": "शीर्णपर्णाशनो वा स्यात्कृच्छ्रैर्वा वर्तयेत्सदा ।\nयोगाभ्यासरतश्च स्याद्रुद्राध्यायी भवेत्सदा॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000511030, "chapter_id": 20511, "verse_number": "३-५८-३१", "content_sanskrit": "अथर्वशिरसोध्येता वेदांताभ्यासतत्परः ।\nयमान्सेवेत सततं नियमांश्चाप्यतंद्रितः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000511031, "chapter_id": 20511, "verse_number": "३-५८-३२", "content_sanskrit": "अथ चाग्नीन्समारोप्य स्वात्मनि ध्यानतत्परः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000511032, "chapter_id": 20511, "verse_number": "३-५८-३३", "content_sanskrit": "अनग्निरनिकेतो वा मुनिर्मोक्षपरो भवेत् ।\nतापसेष्वेव विप्रेषु यात्रिकं भैक्षमाहरेत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000511033, "chapter_id": 20511, "verse_number": "३-५८-३४", "content_sanskrit": "गृहमेधिषु चान्येषु द्विजेषु वनचारिषु ।\nग्रामादाहृत्य चाश्नीयादष्टौ ग्रासान्वने वसन्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000511034, "chapter_id": 20511, "verse_number": "३-५८-३५", "content_sanskrit": "प्रतिगृह्य पुटेनैव पाणिना शकलेन वा ।\nविविधाश्चोपनिषद आत्मसंसिद्धये जपेत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000511035, "chapter_id": 20511, "verse_number": "३-५८-३६", "content_sanskrit": "विद्याविशेषान्सावित्रीं रुद्राध्यायं तथैव च ।\nमहाप्रस्थानिकं वासौ कुर्य्यादनशनं तथा ।\nअग्निप्रवेशमन्यद्वा ब्रह्मार्पणविधौ स्थितः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]