[{"id": 6000136000, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "अथ सप्तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000136001, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.001.m4a", "display_order": 2}, {"id": 6000136002, "chapter_id": 10136, "verse_number": "६-१७-१", "content_sanskrit": "यतश्चान्तर्हितोऽनन्तस्तस्यै कृत्वा दिशे नमः।\nविद्याधरश्चित्रकेतुश्चचार गगनेचरः॥ ६/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.002.m4a", "display_order": 3, "topics": [{"text": "महर्षिप्राप्तेन चित्रकेतुना महादेवस्य निन्दनम्", "range": "१–१०"}]}, {"id": 6000136003, "chapter_id": 10136, "verse_number": "६-१७-२", "content_sanskrit": "सलक्षं लक्षवर्षाणामव्याहतबलेन्द्रियः।\nस्तूयमानो महायोगी मुनिभिः सिद्धचारणैः॥ ६/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.003.m4a", "display_order": 4}, {"id": 6000136004, "chapter_id": 10136, "verse_number": "६-१७-३", "content_sanskrit": "कुलाचलेन्द्रद्रोणीषु नानासङ्कल्पसिद्धिषु।\nरेमे विद्याधरस्‍त्रीभिर्गापयन् हरिमीश्वरम्॥ ६/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.004.m4a", "display_order": 5}, {"id": 6000136005, "chapter_id": 10136, "verse_number": "६-१७-४", "content_sanskrit": "एकदा स विमानेन विष्णुदत्तेन भास्वता।\nगिरिशं ददृशे गच्छन् परीतं सिद्धचारणैः॥ ६/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.005.m4a", "display_order": 6}, {"id": 6000136006, "chapter_id": 10136, "verse_number": "६-१७-५", "content_sanskrit": "आलिङ्ग्याङ्कीकृतां देवीं बाहुना मुनिसंसदि।\nउवाच देव्यां शृृण्वन्त्यां जहासोच्चैस्तदन्तिके॥ ६/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.006.m4a", "display_order": 7}, {"id": 6000136007, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "चित्रकेतुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.007.m4a", "display_order": 8}, {"id": 6000136008, "chapter_id": 10136, "verse_number": "६-१७-६", "content_sanskrit": "एष लोकगुरुः साक्षाद् धर्मं वक्ता शरीरिणाम्।\nआस्ते मुख्यः सभायां वै मिथुनीभूय भार्यया॥ ६/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.008.m4a", "display_order": 9}, {"id": 6000136009, "chapter_id": 10136, "verse_number": "६-१७-७", "content_sanskrit": "जटाधरस्तीव्रतपा ब्रह्मवादी सतां पतिः।\nअङ्के कृत्य स्‍त्रियं चास्ते गतह्रीः प्राकृतो यथा॥ ६/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.009.m4a", "display_order": 10}, {"id": 6000136010, "chapter_id": 10136, "verse_number": "६-१७-८", "content_sanskrit": "प्रायशः प्राकृताश्चापि स्‍त्रियं रहसि बिभ्रति।\nअयं महाव्रतधरो बिभर्ति सदसि स्‍त्रियम्॥ ६/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.010.m4a", "display_order": 11}, {"id": 6000136011, "chapter_id": 10136, "verse_number": "६-१७-९", "content_sanskrit": "भगवानपि तच्छ्रुत्वा प्रहस्यागाधधीर्नृप।\nतूष्णीं बभूव सदसि सभ्याश्च तदनुव्रताः॥ ६/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.011.m4a", "display_order": 12}, {"id": 6000136012, "chapter_id": 10136, "verse_number": "६-१७-१०", "content_sanskrit": "इत्यतद्वीर्यविदुषि ब्रुवाणे बह्वशोभनम्।\nरुषाऽऽह देवी धृष्टाय निर्जितात्माभिमानिने॥ ६/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.012.m4a", "display_order": 13}, {"id": 6000136013, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "पार्वत्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.013.m4a", "display_order": 14}, {"id": 6000136014, "chapter_id": 10136, "verse_number": "६-१७-११", "content_sanskrit": "अयं किमधुना लोके शास्ता दण्डधरः प्रभुः।\nअस्मद्विधानां दुष्टानां निर्लज्जानां च विप्रकृत्॥ ६/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.014.m4a", "display_order": 15, "topics": [{"text": "तेन क्रुद्धाया उमायाः शापाद् वृत्रासुरजन्मप्राप्तिः", "range": "११–४१"}]}, {"id": 6000136015, "chapter_id": 10136, "verse_number": "६-१७-१२", "content_sanskrit": "न वेद धर्मं किल पद्मयोनिर्न ब्रह्मपुत्रा भृगुनारदाद्याः।\nन वै कुमारः कपिलो मनुश्च ये नो निषेधन्त्यतिवर्तिनं हरम्॥ ६/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.015.m4a", "display_order": 16}, {"id": 6000136016, "chapter_id": 10136, "verse_number": "६-१७-१३", "content_sanskrit": "एषामनुध्येयपदाब्जयुग्मं जगद्गुरुं मङ्गलमङ्गलं स्वयम्।\nयः क्षत्रबन्धुः परिभूय सूरीन् प्रशास्ति धृष्टस्तदयं हि दण्ड्यः॥ ६/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.016.m4a", "display_order": 17}, {"id": 6000136017, "chapter_id": 10136, "verse_number": "६-१७-१४", "content_sanskrit": "नायमर्हति वैकुण्ठपादमूलोपसर्पणम्।\nसम्भावितमतिः स्तब्धः साधुभिः पर्युपासितम्॥ ६/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.017.m4a", "display_order": 18}, {"id": 6000136018, "chapter_id": 10136, "verse_number": "६-१७-१५", "content_sanskrit": "अतः पापीयसीं योनिमासुरीं याहि दुर्मते।\nयथेह भूयो महतां न कर्ताऽमुत्र किल्बिषम्॥ ६/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.018.m4a", "display_order": 19}, {"id": 6000136019, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.019.m4a", "display_order": 20}, {"id": 6000136020, "chapter_id": 10136, "verse_number": "६-१७-१६", "content_sanskrit": "एवं शप्तश्चित्रकेतुर्विमानादवरुह्य सः।\nप्रसादयामास सतीं मूर्ध्ना नम्रेण भारत॥ ६/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.020.m4a", "display_order": 21}, {"id": 6000136021, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "चित्रकेतुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.021.m4a", "display_order": 22}, {"id": 6000136022, "chapter_id": 10136, "verse_number": "६-१७-१७", "content_sanskrit": "प्रतिगृह्णामि ते शापमात्मनोऽञ्जलिनाऽम्बिके।\nदेवैर्मर्त्याय यत् प्रोक्तं पूर्वदिष्टं हि तस्य तत्॥ ६/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.022.m4a", "display_order": 23}, {"id": 6000136023, "chapter_id": 10136, "verse_number": "६-१७-१८", "content_sanskrit": "संसारचक्र एतस्मिन् जन्तुरज्ञानमोहितः।\nभ्राम्यन् सुखं च दुःखं च भुङ्क्ते सर्वत्र सर्वदा॥ ६/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.023.m4a", "display_order": 24}, {"id": 6000136024, "chapter_id": 10136, "verse_number": "६-१७-१९", "content_sanskrit": "नैवात्मा न परश्चापि कर्ता स्यात् सुखदुःखयोः।\nकर्तारं मन्यतेऽत्राज्ञ आत्मानं परमेव च॥ ६/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.024.m4a", "display_order": 25}, {"id": 6000136025, "chapter_id": 10136, "verse_number": "६-१७-२०", "content_sanskrit": "गुणप्रवाह एतस्मिन् कः शापः को न्वनुग्रहः।\nकः स्वर्गो नरकः को वा किं दुःखं सुखमेव च॥ ६/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.025.m4a", "display_order": 26}, {"id": 6000136026, "chapter_id": 10136, "verse_number": "६-१७-२१", "content_sanskrit": "एकः सृजति भूतानि भगवानात्ममायया।\nएषां बन्धं च मोक्षं च सुखं दुःखं च निष्कलः॥ ६/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.026.m4a", "display_order": 27}, {"id": 6000136027, "chapter_id": 10136, "verse_number": "६-१७-२२", "content_sanskrit": "न तस्य कश्चिद् दयितः प्रतीपो न ज्ञातिबन्धुर्न परो न च स्वः।\nसमस्य सर्वत्र निरञ्जनस्य कुतोऽनुरागः कुत एव रोषः॥ ६/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.027.m4a", "display_order": 28}, {"id": 6000136028, "chapter_id": 10136, "verse_number": "६-१७-२३", "content_sanskrit": "तथाऽपि तच्छक्तिविसर्ग एषां सुखाय दुःखाय हिताहिताय।\nबन्धाय मोक्षाय च मृत्युजन्मनोः शरीरिणां संसृतये च कल्पते॥ ६/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.028.m4a", "display_order": 29}, {"id": 6000136029, "chapter_id": 10136, "verse_number": "६-१७-२४", "content_sanskrit": "अथ प्रसादये न त्वां शापमोक्षाय भामिनि।\nयन्मन्यसे असाधूक्तं मम तत् क्षम्यतां सति॥ ६/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.029.m4a", "display_order": 30}, {"id": 6000136030, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.030.m4a", "display_order": 31}, {"id": 6000136031, "chapter_id": 10136, "verse_number": "६-१७-२५", "content_sanskrit": "इति प्रसाद्य गिरिशौ चित्रकेतुररिन्दम।\nजगाम स्वविमानेन पश्यतोः स्मयतोस्तयोः॥ ६/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.031.m4a", "display_order": 32}, {"id": 6000136032, "chapter_id": 10136, "verse_number": "६-१७-२६", "content_sanskrit": "ततस्तु भगवान् रुद्रो रुद्राणीमिदमब्रवीत्।\nदेवर्षिदैत्यसिद्धानां पार्षदानां च शृण्वताम्॥ ६/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.032.m4a", "display_order": 33}, {"id": 6000136033, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "देवदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.033.m4a", "display_order": 34}, {"id": 6000136034, "chapter_id": 10136, "verse_number": "६-१७-२७", "content_sanskrit": "दृष्टवत्यसि सुश्रोणि हरेरद्भुतकर्मणः।\nमाहात्म्यं भृत्यभृत्यानां निःस्पृहाणां महात्मनाम्॥ ६/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.034.m4a", "display_order": 35}, {"id": 6000136035, "chapter_id": 10136, "verse_number": "६-१७-२८", "content_sanskrit": "नारायणपराः सर्वे न कुतश्चन बिभ्यति।\nस्वर्गापवर्गनरकेष्वपि तुल्यार्थदर्शिनः॥ ६/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.035.m4a", "display_order": 36}, {"id": 6000136036, "chapter_id": 10136, "verse_number": "६-१७-२९", "content_sanskrit": "देहिनां देहसंयोगाद् द्वन्द्वानीश्वरलीलया।\nसुखं दुःखं मृतिर्जन्म शापानुग्रह एव च॥ ६/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.036.m4a", "display_order": 37}, {"id": 6000136037, "chapter_id": 10136, "verse_number": "६-१७-३०", "content_sanskrit": "अविवेककृतः पुंसो ह्यर्थभेद इहात्मनि।\nगुणदोषविकल्पश्च भिदेव स्वप्नकल्पिता॥ ६/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.037.m4a", "display_order": 38}, {"id": 6000136038, "chapter_id": 10136, "verse_number": "६-१७-३१", "content_sanskrit": "वासुदेवे भगवति भक्तिमुद्वहतां नृणाम्।\nज्ञानविज्ञानवीर्याणां न हि कश्चिद् व्यपाश्रयः॥ ६/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.038.m4a", "display_order": 39}, {"id": 6000136039, "chapter_id": 10136, "verse_number": "६-१७-३२", "content_sanskrit": "नाहं विरिञ्चो न कुमारनारदौ न ब्रह्मपुत्रा मुनयः सुरेशाः।\nविदाम यस्येहितमंशकांशका न तत्स्वरूपं पृथगीशमानिनः॥ ६/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.039.m4a", "display_order": 40}, {"id": 6000136040, "chapter_id": 10136, "verse_number": "६-१७-३३", "content_sanskrit": "न ह्यस्यातिप्रियः कश्चिन्नाप्रियः स्वः परोऽपि वा।\nआत्मत्वात् सर्वभूतानां सर्वभूतप्रियो हरिः॥ ६/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.040.m4a", "display_order": 41}, {"id": 6000136041, "chapter_id": 10136, "verse_number": "६-१७-३४", "content_sanskrit": "तस्य चायं महाभागश्चित्रकेतुः प्रियोऽनुगः।\nसर्वत्र समदृक् शान्तो ह्यहं चैवाच्युतप्रियः॥ ६/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.041.m4a", "display_order": 42}, {"id": 6000136042, "chapter_id": 10136, "verse_number": "६-१७-३५", "content_sanskrit": "तस्मान्न विस्मयः कार्यः पुरुषेषु महत्सु च।\nमहापुरुषभक्तेषु शान्तेषु समदर्शिषु॥ ६/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.042.m4a", "display_order": 43}, {"id": 6000136043, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.043.m4a", "display_order": 44}, {"id": 6000136044, "chapter_id": 10136, "verse_number": "६-१७-३६", "content_sanskrit": "इति श्रुत्वा भगवतः शिवस्योमाऽभिभाषितम्।\nबभूव शान्तधी राजन् देवी विगतविस्मया॥ ६/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.044.m4a", "display_order": 45}, {"id": 6000136045, "chapter_id": 10136, "verse_number": "६-१७-३७", "content_sanskrit": "इति भागवतो देव्याः प्रतिशप्तुमलंतमः।\nमूर्ध्ना सञ्जगृहे शापमेतावत् साधुलक्षणम्॥ ६/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.045.m4a", "display_order": 46}, {"id": 6000136046, "chapter_id": 10136, "verse_number": "६-१७-३८", "content_sanskrit": "जज्ञे त्वष्टुर्दक्षिणाग्नौ दानवीं योनिमाश्रितः।\nवृत्र इत्यभिविख्यातो ज्ञानविज्ञानसंयुतः॥ ६/१७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.046.m4a", "display_order": 47}, {"id": 6000136047, "chapter_id": 10136, "verse_number": "६-१७-३९", "content_sanskrit": "एतत् ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि।\nवृत्रस्यासुरजातेश्च कारणं भगवन्मतेः॥ ६/१७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.047.m4a", "display_order": 48}, {"id": 6000136048, "chapter_id": 10136, "verse_number": "६-१७-४०", "content_sanskrit": "इतिहासमिमं पुण्यं चित्रकेतोर्महात्मनः।\nमाहात्म्यं विष्णुभक्तानां श्रुत्वा बन्धाद् विमुच्यते॥ ६/१७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.048.m4a", "display_order": 49}, {"id": 6000136049, "chapter_id": 10136, "verse_number": "६-१७-४१", "content_sanskrit": "य एतत् प्रातरुत्थाय श्रद्धया वाग्यतः पठेत्।\nइतिहासं हरिं स्मृत्वा स याति परमां गतिम्॥ ६/१७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_017/BhP_06.017.049.m4a", "display_order": 50}, {"id": 6000136050, "chapter_id": 10136, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे सप्तदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]