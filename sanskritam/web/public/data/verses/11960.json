[{"id": 50024978, "chapter_id": 11960, "verse_number": "1", "content_sanskrit": "अतो विष्णोर्गुणोत्कर्ष एव सर्वश्रुतिस्मृतीनां महातात्पर्यम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024979, "chapter_id": 11960, "verse_number": "2", "content_sanskrit": "॥ परपक्षे प्रमाणाभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024980, "chapter_id": 11960, "verse_number": "3", "content_sanskrit": "नचाभेदे तात्पर्यमित्यत्र किञ्चिन्मानम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024981, "chapter_id": 11960, "verse_number": "4", "content_sanskrit": "॥ विष्णोः सर्वोत्तमत्वे महातात्पर्यमित्यत्र बाधकपरिहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024982, "chapter_id": 11960, "verse_number": "5", "content_sanskrit": "॥ अन्योन्याश्रयग्रस्तत्वाद्ययुक्ततापरिहाराय भेदस्य पदार्थस्वरूपत्वनिरूपणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024983, "chapter_id": 11960, "verse_number": "6", "content_sanskrit": "नच विशेषणविशेष्यतया भेदसिद्धिः, विशेषणविशेष्यभावश्च भेदापेक्षः, धर्मिप्रतियोग्यपेक्षया भेदसिद्धिः, भेदापेक्षं च धर्मिप्रतियोगित्वम् - इत्यन्योन्याश्रयतया भेदस्यायुक्तिः। पदार्थस्वरूपत्वाद् भेदस्य।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024984, "chapter_id": 11960, "verse_number": "7", "content_sanskrit": "॥ भेदस्य पदार्थस्वरूपत्वसमर्थनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]