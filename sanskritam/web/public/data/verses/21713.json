[{"id": 7001713000, "chapter_id": 21713, "verse_number": "१-९९-१", "content_sanskrit": "श्रीब्रह्मोवाच ।\nअथातः संप्रवक्ष्यामि तवाग्नेयपुराणकम् ।\nईशानकल्पवृत्तांतं वसिष्ठायानलोऽब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001713001, "chapter_id": 21713, "verse_number": "१-९९-२", "content_sanskrit": "तत्पंचदशसाहस्रं नाना चरितमद्भुतम् ।\nपठतां श्रृण्वतां चैव सर्वपापहरं नृणाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001713002, "chapter_id": 21713, "verse_number": "१-९९-३", "content_sanskrit": "प्रश्नः पूर्वं पुराणस्य कथा सर्वावतारजा ।\nसृष्टिप्रकरणं चाथ विष्णुपूजादिकं ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001713003, "chapter_id": 21713, "verse_number": "१-९९-४", "content_sanskrit": "अग्निकार्यं ततः पश्चान्मंत्रमुद्रादिलक्षणम् ।\nसर्वदीक्षाविधानं च अभिषेकनिरूपणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001713004, "chapter_id": 21713, "verse_number": "१-९९-५", "content_sanskrit": "लक्षणं मंडलादीनां कुशापामार्जनं ततः ।\nपवित्रारोपणविधिर्देवालयविधिस्ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001713005, "chapter_id": 21713, "verse_number": "१-९९-६", "content_sanskrit": "शालग्रामादिपूजा च मूर्तिलक्ष्म पृथक्पृथक् ।\nन्यासादीनां विधानं च प्रतिष्ठापूर्तकं ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001713006, "chapter_id": 21713, "verse_number": "१-९९-७", "content_sanskrit": "विनायकादिपूजा च नानादीक्षाविधिः परम् ।\nप्रतिष्ठा सर्वदेवानां ब्रह्मंडस्य निरूपणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001713007, "chapter_id": 21713, "verse_number": "१-९९-८", "content_sanskrit": "गंगादितीर्थमाहात्म्यं द्वीपवर्षानुवर्णनम् ।\nऊर्द्ध्वाधोलोकरचना ज्योतिश्चक्रनिरूपणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001713008, "chapter_id": 21713, "verse_number": "१-९९-९", "content_sanskrit": "ज्योतिषं च ततः प्रोक्तं शास्त्रं युद्धजयार्णवम् ।\nषट्कर्म च ततः प्रोक्तं मंत्रमंत्रौषधीगणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001713009, "chapter_id": 21713, "verse_number": "१-९९-१०", "content_sanskrit": "कुब्जिकादिसमर्चत्वं षोढा न्यासविधिस्तथा ।\nकोटिहोमविधानं च मन्वंतरनिरूपणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001713010, "chapter_id": 21713, "verse_number": "१-९९-११", "content_sanskrit": "ब्रह्मचर्यादिधर्मांश्च श्राद्धकल्पविधिस्ततः ।\nग्रहयज्ञस्ततः प्रोक्तोवैदिकस्मार्तकर्म च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001713011, "chapter_id": 21713, "verse_number": "१-९९-१२", "content_sanskrit": "प्रायश्चित्तानुकथनं तिथीनां च व्रतादिकम् ।\nवारव्रतानुकथनं नक्षत्रव्रतकीर्तनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001713012, "chapter_id": 21713, "verse_number": "१-९९-१३", "content_sanskrit": "मासिकव्रतनिर्द्देशो दीपदानविधिस्तथा ।\nनवव्यूहार्चनं प्रोक्तं नरकाणां निरूपणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001713013, "chapter_id": 21713, "verse_number": "१-९९-१४", "content_sanskrit": "व्रतानां चापि दानानां निरूपणमिहोदितम् ।\nनाडीचक्रसमुद्देशः संध्याविधिरनुत्तमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001713014, "chapter_id": 21713, "verse_number": "१-९९-१५", "content_sanskrit": "गायत्र्यर्थस्य निर्द्देशो लिंगस्तोत्रं ततः परम् ।\nराज्याभिषेकमन्त्रोक्तिर्द्धर्मकृत्यं च भूभुजाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001713015, "chapter_id": 21713, "verse_number": "१-९९-१६", "content_sanskrit": "स्वप्नाध्यायस्ततः प्रोक्तः शकुनादिनिरूपणम् ।\nमंडलादिकनिर्द्देंशो रत्नदीक्षाविधिस्ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001713016, "chapter_id": 21713, "verse_number": "१-९९-१७", "content_sanskrit": "रामोक्तनीतिनिर्द्देशो रत्नानां लक्षणं ततः ।\nधनुर्विद्या ततः प्रोक्ता व्यवहारप्रदर्शनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001713017, "chapter_id": 21713, "verse_number": "१-९९-१८", "content_sanskrit": "देवासुरविमर्दाख्या ह्यायुर्वेदनिरूपणम् ।\nगजादीनां चिकित्सा च तेषां शांतिस्ततः परम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001713018, "chapter_id": 21713, "verse_number": "१-९९-१९", "content_sanskrit": "गोनरादिचिकित्सा च नानापूजास्ततः परम् ।\nशांतयश्चापि विविधाश्छन्दः शास्त्रमतः परम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001713019, "chapter_id": 21713, "verse_number": "१-९९-२०", "content_sanskrit": "साहित्यं च ततः पश्चादेकार्णादिसमाह्वयाः ।\nसिद्धशब्दानुशिष्टिश्चकोशः सर्गादिवर्गकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001713020, "chapter_id": 21713, "verse_number": "१-९९-२१", "content_sanskrit": "प्रलयानां लक्षणं च शारीरकनिरूपणम् ।\nवर्णनं नरकाणां च योगाशास्त्र परम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001713021, "chapter_id": 21713, "verse_number": "१-९९-२२", "content_sanskrit": "ब्रह्मज्ञानं ततः पश्चात्पुराणश्रवणे फलम् ।\nएतदाग्नेयकं विप्र पुराणं परिकीर्तितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001713022, "chapter_id": 21713, "verse_number": "१-९९-२३", "content_sanskrit": "तल्लिखित्वा तु यो दद्यात्सुवर्णकलमान्वितम् ।\nतिलधेनु युतं चापि मार्गशीर्ष्यां विधानतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001713023, "chapter_id": 21713, "verse_number": "१-९९-२४", "content_sanskrit": "पुराणार्थविदे सोऽथ स्वर्गलोके महीयते ।\nएषानुक्रमणी प्रोक्ता तवाग्नेयस्य मुक्तिदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001713024, "chapter_id": 21713, "verse_number": "१-९९-२५", "content_sanskrit": "श्रृण्वतां पठतां चैव नृणां चेह परत्र च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]