[{"id": 40000776, "chapter_id": 8806, "verse_number": "1", "content_sanskrit": "तत: प्रभाते विमले कृताह्निकमरिन्दमौ। विश्वामित्रं पुरस्कृत्य नद्यास्तीरमुपागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40000777, "chapter_id": 8806, "verse_number": "2", "content_sanskrit": "ते च सर्वे महात्मानो मुनयस्संश्रितव्रता:। उपस्थाप्य शुभां नावं विश्वामित्रमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40000778, "chapter_id": 8806, "verse_number": "3", "content_sanskrit": "आरोहतु भवान्नावं राजपुत्रपुरस्कृत:। अरिष्टं गच्छ पन्थानं मा भूत्कालविपर्यय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40000779, "chapter_id": 8806, "verse_number": "4", "content_sanskrit": "विश्वामित्रस्तथेत्युक्तवा तानृषीनभिपूज्य च। ततार सहितस्ताभ्यां सरितं सागरङ्गमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40000780, "chapter_id": 8806, "verse_number": "5", "content_sanskrit": "ततश्शुश्राव वै शब्दमतिसंरम्भवर्धितम्। मध्यमागम्य तोयस्य सह राम:कनीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40000781, "chapter_id": 8806, "verse_number": "6", "content_sanskrit": "अथ रामस्सरिन्मध्ये पप्रच्छ मुनिपुङ्गवम्। वारिणो भिद्यमानस्य किमयं तुमुलो ध्वनि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40000782, "chapter_id": 8806, "verse_number": "7", "content_sanskrit": "राघवस्य वचश्श्रुत्वा कौतूहलसमन्वित:। कथयामास धर्मात्मा तस्य शब्दस्य निश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40000783, "chapter_id": 8806, "verse_number": "8", "content_sanskrit": "कैलासपर्वते राम मनसा निर्मितं सर:। ब्रह्मणा नरशार्दूल तेनेदं मानसं सर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40000784, "chapter_id": 8806, "verse_number": "9", "content_sanskrit": "तस्मात्सुस्राव सरसस्सायोध्यामुपगूहते । सर प्रवृत्ता सरयू: पुण्या ब्रह्मसरश्च्युता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40000785, "chapter_id": 8806, "verse_number": "10", "content_sanskrit": "तस्यायमतुलश्शब्दो जाह्नवीमभिवर्तते। वारिसङ्क्षोभजो राम प्रणामं नियत:कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40000786, "chapter_id": 8806, "verse_number": "11", "content_sanskrit": "ताभ्यां तु तावुभौ कृत्वा प्रणाममतिधार्मिकौ। तीरं दक्षिणमासाद्य जग्मतुर्लघुविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40000787, "chapter_id": 8806, "verse_number": "12", "content_sanskrit": "स वनं घोरसङ्काशं दृष्ट्वा नृपवरात्मज:। अविप्रहतमैक्ष्वाक: पप्रच्छ मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40000788, "chapter_id": 8806, "verse_number": "13", "content_sanskrit": "अहो वनमिदं दुर्गं झिल्लिकागणनादितम्। भैरवैश्शपदै: पूर्णं शकुन्तैर्दारुणारुतै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40000789, "chapter_id": 8806, "verse_number": "14", "content_sanskrit": "नानाप्रकारैश्शकुनै र्वाश्यद्भिर्भैरवस्वनै:। सिंहव्याघ्रवराहैश्च वारणैश्चोपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40000790, "chapter_id": 8806, "verse_number": "15", "content_sanskrit": "धवाश्वकर्णककुभैर्बिल्वतिन्दुकपाटलै:। सङ्कीर्णं बदरीभिश्च किन्न्वेतद्दारुणं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40000791, "chapter_id": 8806, "verse_number": "16", "content_sanskrit": "तमुवाच महातेजा विश्वामित्रो महामुनि:। श्रूयतां वत्स काकुत्स्थ यस्यैतद्दारुणं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40000792, "chapter_id": 8806, "verse_number": "17", "content_sanskrit": "एतौ जनपदौ स्फीतौ पूर्वमास्तां नरोत्तम। मलदाश्च करूशाश्च देवनिर्माणनिर्मितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40000793, "chapter_id": 8806, "verse_number": "18", "content_sanskrit": "पुरा वृत्रवधे राम मलेन समभिप्लुतम्। क्षुधा चैव सहस्राक्षं ब्रह्महत्या समाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40000794, "chapter_id": 8806, "verse_number": "19", "content_sanskrit": "तमिन्द्रं स्नापयन् देवा ऋषयश्च तपोधना:। कलशैस्स्नापयामासुर्मलं चास्य प्रमोचयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40000795, "chapter_id": 8806, "verse_number": "20", "content_sanskrit": "इह भूम्यां मलं दत्वा दत्वा कारूशमेव च। शरीरजं महेन्द्रस्य ततो हर्षं प्रपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40000796, "chapter_id": 8806, "verse_number": "21", "content_sanskrit": "निर्मलो निष्करूशश्च शुचिरिंन्द्रो यदाभवत्। ददौ देशस्य सुप्रीतो वरं प्रभुरनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40000797, "chapter_id": 8806, "verse_number": "22", "content_sanskrit": "इमौ जनपदौ स्फीतौ ख्यातिं लोके गमिष्यत:। मलदाश्च करूशाश्च ममाङ्गमलधारिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40000798, "chapter_id": 8806, "verse_number": "23", "content_sanskrit": "साधु साध्विति तं देवा: पाकशासनमब्रुवन्। देशस्य पूजां तां दृष्ट्वा कृतां शक्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40000799, "chapter_id": 8806, "verse_number": "24", "content_sanskrit": "एतौ जनपदौ स्फीतौ दीर्घकालमरिन्दम। मलदाश्च करूशाश्च मुदितौ धनधान्यत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40000800, "chapter_id": 8806, "verse_number": "25", "content_sanskrit": "कस्यचित्त्वथ कालस्य यक्षी वै कामरूपिणी। बलं नागसहस्रस्य धारयन्ती तदा ह्यभूत् ॥ ताटका नाम भद्रं ते भार्या सुन्दस्य धीमत:। 2 मारीचो राक्षस: पुत्रो यस्याश्शक्रपराक्रम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40000801, "chapter_id": 8806, "verse_number": "26", "content_sanskrit": "कस्यचित्त्वथ कालस्य यक्षी वै कामरूपिणी। बलं नागसहस्रस्य धारयन्ती तदा ह्यभूत् ॥ ताटका नाम भद्रं ते भार्या सुन्दस्य धीमत:। 2 मारीचो राक्षस: पुत्रो यस्याश्शक्रपराक्रम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40000802, "chapter_id": 8806, "verse_number": "27", "content_sanskrit": "वृत्तबाहुर्महावीर्यो विपुलास्य तनुर्महान्। राक्षसो भैरवाकारो नित्यं त्रासयते प्रजा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40000803, "chapter_id": 8806, "verse_number": "28", "content_sanskrit": "इमौ जनपदौ नित्यं विनाशयति राघव। मलदांश्च करूशांश्च ताटका दुष्टचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40000804, "chapter_id": 8806, "verse_number": "29", "content_sanskrit": "सेयं पन्थानमावृत्य वसत्यध्यर्धयोजने। अत एव न गन्तव्यं ताटकाया वनं यत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40000805, "chapter_id": 8806, "verse_number": "30", "content_sanskrit": "स्वबाहुबलमाश्रित्य जहीमां दुष्टचारिणीम्। मन्नियोगादिमं देशं कुरु निष्कण्टकं पुन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40000806, "chapter_id": 8806, "verse_number": "31", "content_sanskrit": "न हि कश्चिदिमं देशं शक्नोत्यागन्तुमीदृशम्। यक्षिण्या घोरया राम उत्सादितमसह्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40000807, "chapter_id": 8806, "verse_number": "32", "content_sanskrit": "एतत्ते सर्वमाख्यातं यथैतद्दारुणं वनम्। यक्ष्या चोत्सादितं सर्वमद्यापि न निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]