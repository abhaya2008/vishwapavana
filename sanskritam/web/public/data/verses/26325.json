[{"id": 7006325000, "chapter_id": 26325, "verse_number": "१-३५-१", "content_sanskrit": "वैशम्पायन उवाच याः पत्न्यो वसुदेवस्य चतुर्दश वराङ्गनाः ।\nपौरवी रोहिणी नाम इन्दिरा च तथा वरा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006325001, "chapter_id": 26325, "verse_number": "१-३५-२", "content_sanskrit": "वैशाखी च तथा भद्रा सुनाम्नी चैव पञ्चमी ।\nसहदेवा शान्तिदेवा श्रीदेवा देवरक्षिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006325002, "chapter_id": 26325, "verse_number": "१-३५-३", "content_sanskrit": "वृकदेव्युपदेवी च देवकी चैव सप्तमी ।\nसुतनुर्वडवा चैव द्वे एते परिचारिके ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006325003, "chapter_id": 26325, "verse_number": "१-३५-४", "content_sanskrit": "पौरवी रोहिणी नाम बाह्लिकस्यात्मजाभवत् ।\nज्येष्ठा पत्नी महाराज दयिताऽऽनकदुन्दुभेः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006325004, "chapter_id": 26325, "verse_number": "१-३५-५", "content_sanskrit": "लेभे ज्येष्ठं सुतं रामं सारणं शठमेव च ।\nदुर्दमं दमनं श्वभ्रं पिण्डारकमुशीनरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006325005, "chapter_id": 26325, "verse_number": "१-३५-६", "content_sanskrit": "चित्रां नाम कुमारीं च रोहिणीतनया दश ।\nचित्रा सुभद्रेति पुनर्विख्याता कुरुनन्दन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006325006, "chapter_id": 26325, "verse_number": "१-३५-७", "content_sanskrit": "वसुदेवाच्च देवक्यां जज्ञे शौरिर्महायशाः ।\nरामाच्च निशठो जज्ञे रेवत्यां दयितः सुतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006325007, "chapter_id": 26325, "verse_number": "१-३५-८", "content_sanskrit": "सुभद्रायां रथी पार्थादभिमन्युरजायत ।\nअक्रूरात् काशिकन्यायां सत्यकेतुरजायत ॥८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006325008, "chapter_id": 26325, "verse_number": "१-३५-९", "content_sanskrit": "वसुदेवस्य भार्यासु महाभागासु सप्तसु ।\nये पुत्रा जज्ञिरे शूरा नामतस्तान् निबोध मे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006325009, "chapter_id": 26325, "verse_number": "१-३५-१०", "content_sanskrit": "भोजश्च विजयश्चैव शान्तिदेवासुतावुभौ ।\nवृकदेवः सुनामायां गदश्चास्ता सुतावुभौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006325010, "chapter_id": 26325, "verse_number": "१-३५-११", "content_sanskrit": "उपासङ्गवरं लेभे तनयं देवरक्षिता ।\nअगावहं महात्मानं वृकदेवी व्यजायत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006325011, "chapter_id": 26325, "verse_number": "१-३५-१२", "content_sanskrit": "कन्या त्रिगर्तराजस्य भर्ता वै शैशिरायणः ।\nजिज्ञासां पौरुषे चक्रे न चस्कन्देऽथ पौरुषम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006325012, "chapter_id": 26325, "verse_number": "१-३५-१३", "content_sanskrit": "कृष्णायससमप्रख्यो वर्षे द्वादशमे तथा ।\nमिथ्याभिशप्तो गार्ग्यस्तु मन्युनाभिसमीरितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006325013, "chapter_id": 26325, "verse_number": "१-३५-१४", "content_sanskrit": "गोपकन्यामुपादाय मैथुनायोपचक्रमे ।\nगोपाली त्वप्सरास्तस्य गोपस्त्रीवेषधारिणी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006325014, "chapter_id": 26325, "verse_number": "१-३५-१५", "content_sanskrit": "धारयामास गार्ग्यस्य गर्भं दुर्धरमच्युतम् ।\nमानुष्यां गार्ग्यभार्यायां नियोगाच्छूलपाणिनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006325015, "chapter_id": 26325, "verse_number": "१-३५-१६", "content_sanskrit": "स कालयवनो नाम जज्ञे राजा महाबलः ।\nवृषपूर्वार्धकायास्तमवहन् वाजिनो रणे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006325016, "chapter_id": 26325, "verse_number": "१-३५-१७", "content_sanskrit": "अपुत्रस्य स राज्ञस्तु ववृधेऽन्तःपुरे शिशुः ।\nयवनस्य महाराज स कालयवनोऽभवत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006325017, "chapter_id": 26325, "verse_number": "१-३५-१८", "content_sanskrit": "स युद्धकामी नृपतिः पर्यपृच्छद् द्विजोत्तमान्।\nवृष्ण्यन्धककुलं तस्य नारदोऽकथयद् विभुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006325018, "chapter_id": 26325, "verse_number": "१-३५-१९", "content_sanskrit": "अक्षौहिण्या तु सैन्यस्य मथुरामभ्ययात्तदा ।\nदूतं सम्प्रेषयामास वृष्ण्यन्धकनिवेशनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006325019, "chapter_id": 26325, "verse_number": "१-३५-२०", "content_sanskrit": "ततो वृष्ण्यन्धकाः कृष्णं पुरस्कृत्य महामतिम्।\nसमेता मन्त्रयामासुर्यवनस्य भयात् तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006325020, "chapter_id": 26325, "verse_number": "१-३५-२१", "content_sanskrit": "कृत्वा च निश्चयं सर्वे पलायनपरायणाः ।\nविहाय मथुरां रम्यां मानयन्तः पिनाकिनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006325021, "chapter_id": 26325, "verse_number": "१-३५-२२", "content_sanskrit": "कुशस्थलीं द्वारवतीं निवेशयितुमीप्सवः ।\nइति कृष्णस्य जन्मेदं यः शुचिर्नियतेन्द्रियः ।\nपर्वसु श्रावयेद् विद्वाननृणः स सुखी भवेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]