[{"id": 5000613000, "chapter_id": 9613, "verse_number": "७-७८-१", "content_sanskrit": "श्रुत्वा तु भाषितं वाक्यं मम राम शुभाक्षरम् ।\nप्राञ्जलिः प्रत्युवाचेदं स स्वर्गी रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000613001, "chapter_id": 9613, "verse_number": "७-७८-२", "content_sanskrit": "शृणु ब्रह्मन्पुरा वृत्तं ममैतत्सुखदुःखयोः ।\nअनतिक्रमणीयं हि यथा पृच्छसि मां द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000613002, "chapter_id": 9613, "verse_number": "७-७८-३", "content_sanskrit": "पुरा वैदर्भको राजा पिता मम महायशाः ।\nसुदेव इति विख्यातस्त्रिषु लोकेषु वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000613003, "chapter_id": 9613, "verse_number": "७-७८-४", "content_sanskrit": "तस्य पुत्रद्वयं ब्रह्मन्द्वाभ्यां स्त्रीभ्यामजायत ।\nअहं श्वेत इति ख्यातो यवीयान्सुरथो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000613004, "chapter_id": 9613, "verse_number": "७-७८-५", "content_sanskrit": "ततः पितरि स्वर्याते पौरा मामभ्यषेचयन् ।\nतत्राहं कृतवान्राज्यं धर्म्यं च सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000613005, "chapter_id": 9613, "verse_number": "७-७८-६", "content_sanskrit": "एवं वर्षसहस्राणि समतीतानि सुव्रत ।\nराज्यं कारयतो ब्रह्मन्प्रजा धर्मेण रक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000613006, "chapter_id": 9613, "verse_number": "७-७८-७", "content_sanskrit": "सो ऽहं निमित्ते कस्मिंश्चिद्विज्ञातायुर्द्विजोत्तम ।\nकालधर्मं हृदि न्यस्य ततो वनमुपागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000613007, "chapter_id": 9613, "verse_number": "७-७८-८", "content_sanskrit": "सो ऽहं वनमिदं दुर्गं मृगपक्षिविवर्जितम् ।\nतपश्चर्तुं प्रविष्टो ऽस्मि समीपे सरसः शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000613008, "chapter_id": 9613, "verse_number": "७-७८-९", "content_sanskrit": "भ्रातरं सुरथं राज्ये ह्यभिषिच्य महीपतिम् ।\nइदं सरः समासाद्य तपस्तप्तं मया चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000613009, "chapter_id": 9613, "verse_number": "७-७८-१०", "content_sanskrit": "सो ऽहं वर्षसहस्राणि तपस्त्रीणि महावने ।\nतप्त्वा सुदुष्करं प्राप्तो ब्रह्मलोकमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000613010, "chapter_id": 9613, "verse_number": "७-७८-११", "content_sanskrit": "तस्य मे स्वर्गभूतस्य क्षुत्पिपासे द्विजोत्तम ।\nबाधेते परमोदार ततो ऽहं व्यथितेन्द्रियः ।\nगत्वा त्रिभुवनश्रेष्ठं पितामहमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000613011, "chapter_id": 9613, "verse_number": "७-७८-१२", "content_sanskrit": "भगवन्ब्रह्मलोको ऽयं क्षुत्पिपासाविवर्जितः ।\nकस्यायं कर्मणः पाकः क्षुत्पिपासानुगो ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000613012, "chapter_id": 9613, "verse_number": "७-७८-१३", "content_sanskrit": "आहारः कश्च मे देव तन्मे ब्रूहि पितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000613013, "chapter_id": 9613, "verse_number": "७-७८-१४", "content_sanskrit": "पितामहस्तु मामाह तवाहारः सुदेवज ।\nस्वादूनि स्वानि मांसानि तानि भक्षय नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000613014, "chapter_id": 9613, "verse_number": "७-७८-१५", "content_sanskrit": "स्वशरीरं त्वया पुष्टं कुर्वता तप उत्तमम् ।\nअनुप्तं रोहते श्वेत न कदाचिन्महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000613015, "chapter_id": 9613, "verse_number": "७-७८-१६", "content_sanskrit": "तृप्तिर्न ते ऽस्ति सूक्ष्मा ऽपि वने सत्वनिषेविते ।\nपुरा तु भिक्षमाणाय भिक्षा वै यतये नृप ।\nन हि दत्ता त्वयेन्द्राभ यस्मादतिथये ऽपि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000613016, "chapter_id": 9613, "verse_number": "७-७८-१७", "content_sanskrit": "दत्तं न ते ऽस्ति सूक्ष्मो ऽपि तप एव निषेवसे ।\nतेन स्वर्गगतो वत्स बाध्यसे क्षुत्पिपासया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000613017, "chapter_id": 9613, "verse_number": "७-७८-१८", "content_sanskrit": "स त्वं सुपुष्टमाहारैः स्वशरीरमनुत्तमम् ।\nभक्षयित्वामृतरसं तेन तृप्तिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000613018, "chapter_id": 9613, "verse_number": "७-७८-१९", "content_sanskrit": "यदा तु तद्वनं श्वेत अगस्त्यः सुमहानृषिः ।\nआगमिष्यति दुर्धर्षस्तदा कृच्छ्राद्विमोक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000613019, "chapter_id": 9613, "verse_number": "७-७८-२०", "content_sanskrit": "स हि तारयितुं सौम्य शक्तः सुरगणानपि ।\nकिं पुनस्त्वां महाबाहो क्षुत्पिपासावशं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000613020, "chapter_id": 9613, "verse_number": "७-७८-२१", "content_sanskrit": "सो ऽहं भगवतः श्रुत्वा देवदेवस्य निश्चयम् ।\nआहारं गर्हितं स्वशरीरं द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000613021, "chapter_id": 9613, "verse_number": "७-७८-२२", "content_sanskrit": "बहून्वर्षगणान्ब्रह्मन्भुज्यमानमिदं मया ।\nक्षयं नाभ्येति ब्रह्मर्षे तृप्तिश्चापि ममोत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000613022, "chapter_id": 9613, "verse_number": "७-७८-२३", "content_sanskrit": "तस्य मे कृच्छ्रभूतस्य कृच्छ्रादस्माद्विमोचय ।\nअन्येषां न गतिर्ह्यत्र कुम्भयोनिमृते द्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000613023, "chapter_id": 9613, "verse_number": "७-७८-२४", "content_sanskrit": "इदमाभरणं सौम्य तारणार्थं द्विजोत्तम ।\nप्रतिगृह्णीष्व भद्रं ते प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000613024, "chapter_id": 9613, "verse_number": "७-७८-२५", "content_sanskrit": "इदं तावत्सुवर्णं च धनं वस्त्राणि च द्विज ।\nभक्ष्यं भोज्यं च ब्रह्मर्षे ददात्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000613025, "chapter_id": 9613, "verse_number": "७-७८-२६", "content_sanskrit": "सर्वान्कामान्प्रयच्छामि भोगांश्च मुनिपुङ्गव ।\nतारणे भगवन्मह्यं प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000613026, "chapter_id": 9613, "verse_number": "७-७८-२७", "content_sanskrit": "तस्याहं स्वर्गिणो वाक्यं श्रुत्वा दुःखसमन्वितम् ।\nतारणायोपजग्राह तदाभरणमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000613027, "chapter_id": 9613, "verse_number": "७-७८-२८", "content_sanskrit": "मया प्रतिगृहीते तु तस्मिन्नाभरणे शुभे ।\nमानुषः पूर्वको देहो राजर्षेर्विननाश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000613028, "chapter_id": 9613, "verse_number": "७-७८-२९", "content_sanskrit": "प्रनष्टे तु शरीरे ऽसौ राजर्षिः परया मुदा ।\nतृप्तः प्रमुदितो राजा जगाम त्रिदिवं सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000613029, "chapter_id": 9613, "verse_number": "७-७८-३०", "content_sanskrit": "तेनेदं शक्रतुल्येन दिव्यमाभरणं मम ।\nतस्मिन्निमित्ते काकुत्स्थ दत्तमद्भुतदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000613030, "chapter_id": 9613, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]