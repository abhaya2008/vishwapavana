[{"id": 5000382000, "chapter_id": 9382, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000382001, "chapter_id": 9382, "verse_number": "५-४३-१", "content_sanskrit": "ततः स किंकरान् हत्वा हनूमान् ध्यानमास्थितः।\nवनं भग्नं मया चैत्यप्रासादो न विनाशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000382002, "chapter_id": 9382, "verse_number": "५-४३-२", "content_sanskrit": "तस्मात् प्रासादमद्यैवमिमं विध्वंसयाम्यहम्।\nइति संचिन्त्य हनुमान् मनसादर्शयन् बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000382003, "chapter_id": 9382, "verse_number": "५-४३-३", "content_sanskrit": "चैत्यप्रासादमुत्प्लुत्य मेरुशृङ्गमिवोन्नतम्।\nआरुरोह हरिश्रेष्ठो हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000382004, "chapter_id": 9382, "verse_number": "५-४३-४", "content_sanskrit": "आरुह्य गिरिसंकाशं प्रासादं हरियूथपः।\nबभौ स सुमहातेजाः प्रतिसूर्य इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000382005, "chapter_id": 9382, "verse_number": "५-४३-५", "content_sanskrit": "सम्प्रधृष्य तु दुर्धर्षश्चैत्यप्रासादमुन्नतम्।\nहनूमान् प्रज्वलँल्लक्ष्म्या पारियात्रोपमोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000382006, "chapter_id": 9382, "verse_number": "५-४३-६", "content_sanskrit": "स भूत्वा सुमहाकायः प्रभावान् मारुतात्मजः।\nधृष्टमास्फोटयामास लङ्कां शब्देन पूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000382007, "chapter_id": 9382, "verse_number": "५-४३-७", "content_sanskrit": "तस्यास्फोटितशब्देन महता श्रोत्रघातिना।\nपेतुर्विहंगमास्तत्र चैत्यपालाश्च मोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000382008, "chapter_id": 9382, "verse_number": "५-४३-८", "content_sanskrit": "अस्त्रविज्जयतां रामो लक्ष्मणश्च महाबलः।\nराजा जयति सुग्रीवो राघवेणाभिपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000382009, "chapter_id": 9382, "verse_number": "५-४३-९", "content_sanskrit": "दासोऽहं कोसलेन्द्रस्य रामस्याक्लिष्टकर्मणः।\nहनूमान् शत्रुसैन्यानां निहन्ता मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000382010, "chapter_id": 9382, "verse_number": "५-४३-१०", "content_sanskrit": "न रावणसहस्रं मे युद्धे प्रतिबलं भवेत्।\nशिलाभिश्च प्रहरतः पादपैश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000382011, "chapter_id": 9382, "verse_number": "५-४३-११", "content_sanskrit": "धर्षयित्वा पुरीं लङ्कामभिवाद्य च मैथिलीम्।\nसमृद्धार्थो गमिष्यामि मिषतां सर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000382012, "chapter_id": 9382, "verse_number": "५-४३-१२", "content_sanskrit": "एवमुक्त्वा महाकायश्चैत्यस्थो हरियूथपः।\nननाद भीमनिर्ह्रादो रक्षसां जनयन् भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000382013, "chapter_id": 9382, "verse_number": "५-४३-१३", "content_sanskrit": "तेन नादेन महता चैत्यपालाः शतं ययुः।\nगृहीत्वा विविधानस्त्रान् प्रासान् खड्गान् परश्वधान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000382014, "chapter_id": 9382, "verse_number": "५-४३-१४", "content_sanskrit": "विसृजन्तो महाकाया मारुतिं पर्यवारयन्।\nते गदाभिर्विचित्राभिः परिघैः काञ्चनाङ्गदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000382015, "chapter_id": 9382, "verse_number": "५-४३-१५", "content_sanskrit": "आजग्मुर्वानरश्रेष्ठं बाणैश्चादित्यसंनिभैः।\nआवर्त इव गङ्गायास्तोयस्य विपुलो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000382016, "chapter_id": 9382, "verse_number": "५-४३-१६", "content_sanskrit": "परिक्षिप्य हरिश्रेष्ठं स बभौ रक्षसां गणः।\nततो वातात्मजः क्रुद्धो भीमरूपं समास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000382017, "chapter_id": 9382, "verse_number": "५-४३-१७", "content_sanskrit": "प्रासादस्य महांस्तस्य स्तम्भं हेमपरिष्कृतम्।\nउत्पाटयित्वा वेगेन हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000382018, "chapter_id": 9382, "verse_number": "५-४३-१८", "content_sanskrit": "ततस्तं भ्रामयामास शतधारं महाबलः।\nतत्र चाग्निः समभवत् प्रासादश्चाप्यदह्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000382019, "chapter_id": 9382, "verse_number": "५-४३-१९", "content_sanskrit": "दह्यमानं ततो दृष्ट्वा प्रासादं हरियूथपः।\nस राक्षसशतं हत्वा वज्रेणेन्द्र इवासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000382020, "chapter_id": 9382, "verse_number": "५-४३-२०", "content_sanskrit": "अन्तरिक्षस्थितः श्रीमानिदं वचनमब्रवीत्।\nमादृशानां सहस्राणि विसृष्टानि महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000382021, "chapter_id": 9382, "verse_number": "५-४३-२१", "content_sanskrit": "बलिनां वानरेन्द्राणां सुग्रीववशवर्तिनाम्।\nअटन्ति वसुधां कृत्स्नां वयमन्ये च वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000382022, "chapter_id": 9382, "verse_number": "५-४३-२२", "content_sanskrit": "दशनागबलाः केचित् केचिद् दशगुणोत्तराः।\nकेचिन्नागसहस्रस्य बभूवुस्तुल्यविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000382023, "chapter_id": 9382, "verse_number": "५-४३-२३", "content_sanskrit": "सन्ति चौघबलाः केचित् सन्ति वायुबलोपमाः।\nअप्रमेयबलाः केचित् तत्रासन् हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000382024, "chapter_id": 9382, "verse_number": "५-४३-२४", "content_sanskrit": "ईदृग्विधैस्तु हरिभिर्वृतो दन्तनखायुधैः।\nशतैः शतसहस्रैश्च कोटिभिश्चायुतैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000382025, "chapter_id": 9382, "verse_number": "५-४३-२५", "content_sanskrit": "आगमिष्यति सुग्रीवः सर्वेषां वो निषूदनः।\nनेयमस्ति पुरी लङ्का न यूयं न च रावणः।\nयस्य त्विक्ष्वाकुवीरेण बद्धं वैरं महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000382026, "chapter_id": 9382, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]