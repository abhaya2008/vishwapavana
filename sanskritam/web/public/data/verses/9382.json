[{"id": 40022123, "chapter_id": 9382, "verse_number": "1", "content_sanskrit": "एवमुक्तस्तु रामेण परां व्रीडामुपागमत् । शत्रुघ्नो वीर्यसम्पन्नो मन्दं मन्दमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022124, "chapter_id": 9382, "verse_number": "2", "content_sanskrit": "अधर्मं विद्म काकुत्स्थ ह्यस्मिन्नर्थे नरेश्वर । कथं तिष्ठत्सु ज्येष्ठेषु कनीयानभिषिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022125, "chapter_id": 9382, "verse_number": "3", "content_sanskrit": "अवश्यं करणीयं च शासनं पुरुषर्षभ । तव चैव महाभाग शासनं दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022126, "chapter_id": 9382, "verse_number": "4", "content_sanskrit": "त्वत्तो मया श्रुतं वीर श्रुतिभ्यश्च मया श्रुतम् । नोत्तरं हि मया वाच्यं मध्यमे प्रतिजानति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022127, "chapter_id": 9382, "verse_number": "5", "content_sanskrit": "व्याहृतं दुर्वचो घोरं हन्तास्मि लवणं मृधे । तस्यैवं मे दुरुक्तस्य दुर्गतिः पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022128, "chapter_id": 9382, "verse_number": "6", "content_sanskrit": "उत्तरं नहि वक्तव्यं ज्येष्ठेनाभिहिते पुनः । अधर्मसहितं चैव परलोकविवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022129, "chapter_id": 9382, "verse_number": "7", "content_sanskrit": "सो ऽहं द्वितीयं काकुत्स्थ न वक्ष्यामि तवोत्तरम् । मा द्वितीयेन दण्डो वै निपतेन्मयि मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022130, "chapter_id": 9382, "verse_number": "8", "content_sanskrit": "कामकारो ह्यहं राजंस्तवास्मि पुरुषर्षभ । अधर्मं जहि काकुत्स्थ मत्कृते रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022131, "chapter_id": 9382, "verse_number": "9", "content_sanskrit": "एवमुक्ते तु शूरेण शत्रुघ्नेन महात्मना । उवाच रामः संहृष्टो भरतं लक्ष्मणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022132, "chapter_id": 9382, "verse_number": "10", "content_sanskrit": "सम्भारानभिषेकस्य आनयध्वं समाहिताः । अद्यैव पुरुषव्याघ्रमभिषेक्ष्यामि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022133, "chapter_id": 9382, "verse_number": "11", "content_sanskrit": "पुरोहितं च काकुत्स्थं नैगमानृत्विजस्तथा । मन्त्रिणश्चैव तान्सर्वानानयध्वं ममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022134, "chapter_id": 9382, "verse_number": "12", "content_sanskrit": "राज्ञः शासनमाज्ञाय तथा ऽकुर्वन्महारथाः । अभिषेकसमारम्भं पुरस्कृत्य पुरोधसम् । प्रविष्टा राजभवनं राजानो ब्राह्मणास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022135, "chapter_id": 9382, "verse_number": "13", "content_sanskrit": "तथो ऽभिषेको ववृधे शत्रुघ्नस्य महात्मनः । सम्प्रहर्षकरः श्रीमान्राघवस्य पुरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022136, "chapter_id": 9382, "verse_number": "14", "content_sanskrit": "अभिषिक्तस्तु शत्रुघ्नो बभौ चादित्यसन्निभः । अभिषिक्तः पुरा स्कन्दः सेन्द्रैरिव मरुद्गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022137, "chapter_id": 9382, "verse_number": "15", "content_sanskrit": "अभिषिक्ते तु शत्रुघ्ने रामेणाक्लिष्टकर्मणा । पौराः प्रमुदिताश्चासन्ब्राह्मणाश्च बहुश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022138, "chapter_id": 9382, "verse_number": "16", "content_sanskrit": "कौसल्या च सुमित्रा च मङ्गलं केकयी तथा । चक्रुस्ता राजभवने याश्चान्या राजयोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022139, "chapter_id": 9382, "verse_number": "17", "content_sanskrit": "ऋषयश्च महात्मानो यमुनातीरवासिनः । हतं लवणमाशंसुः शत्रुघ्नस्याभिषेचनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022140, "chapter_id": 9382, "verse_number": "18", "content_sanskrit": "ततो ऽभिषिक्तं शत्रुघ्नमङ्कमारोप्य राघवः । उवाच मधुरां वाणीं तेजस्तस्याभिपूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022141, "chapter_id": 9382, "verse_number": "19", "content_sanskrit": "अयं शरस्त्वमोघस्ते दिव्यः परपुरञ्जयः । अनेन लवणं सौम्य हन्ता ऽसि रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022142, "chapter_id": 9382, "verse_number": "20", "content_sanskrit": "सृष्टः शरो ऽयं काकुत्स्थ यदा शेते महार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022143, "chapter_id": 9382, "verse_number": "21", "content_sanskrit": "स्वयम्भूरजितो देवो यन्नापश्यन्सुरासुराः । अदृश्यः सर्वभूतानां तेनायं तु शरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022144, "chapter_id": 9382, "verse_number": "22", "content_sanskrit": "सृष्टः क्रोधाभिभूतेन विनाशार्थं दुरात्मनोः । मधुकैटभयोर्वीर विघाते वर्तमानयोः । स्रष्टुकामेन लोकांस्त्रींस्तौ चानेन हतौ युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022145, "chapter_id": 9382, "verse_number": "23", "content_sanskrit": "तौ हत्वा जनभोगार्थं कैटभं तु मधुं तथा । अनेन शरमुख्येन ततो लोकांश्चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022146, "chapter_id": 9382, "verse_number": "24", "content_sanskrit": "नायं मया शरः पूर्वं रावणस्य वधार्थिना । मुक्तः शत्रुघ्न भूतानां महांस्त्रासो भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022147, "chapter_id": 9382, "verse_number": "25", "content_sanskrit": "यच्च तस्य महच्छूलं त्र्यम्बकेण महात्मना । दत्तं शत्रुविनाशाय मधोरायुधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022148, "chapter_id": 9382, "verse_number": "26", "content_sanskrit": "स तं निक्षिप्य भवने पूज्यमान पुनः पुनः । दिशः सर्वाः समासाद्य प्राप्नोत्याहारमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40022149, "chapter_id": 9382, "verse_number": "27", "content_sanskrit": "यदा तु युद्धमाकाङ्क्षन् कश्चिदेनं समाह्वयेत् । तदा शूलं गहीत्वा तं भस्म रक्षः करोति हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40022150, "chapter_id": 9382, "verse_number": "28", "content_sanskrit": "स त्वं पुरुषशार्दूल तमायुधविनाकृतम् । अप्रविष्टं पुरं पूर्वं द्वारि तिष्ठ धृतायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40022151, "chapter_id": 9382, "verse_number": "29", "content_sanskrit": "अप्रविष्टं च भवनं युद्धाय पुरुषर्षभ । आह्वयेथा महाबाहो ततो हन्तासि राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40022152, "chapter_id": 9382, "verse_number": "30", "content_sanskrit": "अन्यथा क्रियमाणे तु अवध्यः स भविष्यति । यदि त्वेवं कृते वीर विनाशमुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40022153, "chapter_id": 9382, "verse_number": "31", "content_sanskrit": "एतत्ते सर्वमाख्यातं शूलस्य च विपर्ययः । श्रीमतः शितिकण्ठस्य कृत्यं हि दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]