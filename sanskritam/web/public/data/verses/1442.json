[{"id": 2021024, "chapter_id": 1442, "verse_number": "३-८०-०x", "content_sanskrit": "पुलस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021025, "chapter_id": 1442, "verse_number": "३-८०-१", "content_sanskrit": "अनेन तव धर्मज्ञ प्रश्रयेण दमेन च।\nसत्येन च महाभाग तुष्टोस्मि तव सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021026, "chapter_id": 1442, "verse_number": "३-८०-२", "content_sanskrit": "यस्येदृशस्ते धर्मोऽयं पितृवाक्याश्रितोऽनघ।\nतेन पश्यसि मां पुत्र प्रीतिश्च परमा त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021027, "chapter_id": 1442, "verse_number": "३-८०-३", "content_sanskrit": "अमोघदर्शी भीष्माहं ब्रूहि किं करवाणि ते।\nयद्वक्ष्यसि कुरुश्रेष्ठ तस्य दाताऽस्मि तेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021028, "chapter_id": 1442, "verse_number": "३-८०-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021029, "chapter_id": 1442, "verse_number": "३-८०-४", "content_sanskrit": "प्रीते त्वयि महाभाग सर्वलोकाभिपूजिते।\nकृतमित्येव मन्येऽहं यदहं दृष्टवान्प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021030, "chapter_id": 1442, "verse_number": "३-८०-५", "content_sanskrit": "यदि त्वहमनुग्राह्यस्तव धर्मभृतांवर।\nसंदेहं ते प्रवक्ष्यामि तन्मे त्वं छेत्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021031, "chapter_id": 1442, "verse_number": "३-८०-६", "content_sanskrit": "अस्ति मे भगवन्कश्चित्तीर्थानि प्रति संशयः।\nतमहं श्रोतुमिच्छामि तद्भवान्वक्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021032, "chapter_id": 1442, "verse_number": "३-८०-७", "content_sanskrit": "प्रदक्षिणां यः पृथिवीं करोत्यमरसन्निभ।\nकिं फलं तस्य विप्रर्षे तन्मे ब्रूहि तषोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021033, "chapter_id": 1442, "verse_number": "३-८०-८x", "content_sanskrit": "पुलस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021034, "chapter_id": 1442, "verse_number": "३-८०-८", "content_sanskrit": "हन्त तेऽहंप्रवक्ष्यामि यदृषीणां परायणम्।\nतदेकाग्रमनास्तात शृणु तीर्थेषु यत्फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021035, "chapter_id": 1442, "verse_number": "३-८०-९", "content_sanskrit": "यस्य हस्तौ च पादौ च मनश्चैव सुसंयतम्।\nविद्या तपश्च कीर्तिश्च स तीर्थफलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021036, "chapter_id": 1442, "verse_number": "३-८०-१०", "content_sanskrit": "प्रतिग्रहादपावृत्तः संतुष्टो येन केनचित्।\nअहंकारनिवृत्तश्च स तीर्थफलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021037, "chapter_id": 1442, "verse_number": "३-८०-११", "content_sanskrit": "अकल्कको निरारम्भो लध्वाहारो जितेन्द्रियः।\nविमुक्तः सर्वपापेभ्यः स तीर्थफलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021038, "chapter_id": 1442, "verse_number": "३-८०-१२", "content_sanskrit": "अक्रोधनश्च राजेन्द्र सत्यशीलो दृढव्रतः।\nआत्मोपमश्च भूतेषु स तीर्धफलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021039, "chapter_id": 1442, "verse_number": "३-८०-१३", "content_sanskrit": "ऋषिभिः क्रतवः प्रोक्ता देवेष्विह यथाक्रमम्।\nफलं चैव यथातत्त्वं प्रेत्य चेह च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021040, "chapter_id": 1442, "verse_number": "३-८०-१४", "content_sanskrit": "न ते शक्या दरिद्रेण यज्ञाः प्राप्तुं महीपते।\nबहूपकरणा यज्ञा नानासंभारविस्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021041, "chapter_id": 1442, "verse_number": "३-८०-१५", "content_sanskrit": "प्राप्यन्ते पार्थिवैरेतैः समृद्धैर्वा नरैः क्वचित्।\nनार्थन्यूनोपकरणैरेकात्मभिरसंहतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021042, "chapter_id": 1442, "verse_number": "३-८०-१६", "content_sanskrit": "यो दरिद्रैरपि विधिः शक्यः प्राप्तुं नरेश्वर।\nतुल्यो यज्ञफलैः पुण्यैस्तं निबोध युधांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021043, "chapter_id": 1442, "verse_number": "३-८०-१७", "content_sanskrit": "ऋषीणां परमं गुह्यमिदं भरतसत्तम।\nतीर्थाभिगमनं पुण्यं यज्ञैरपि विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021044, "chapter_id": 1442, "verse_number": "३-८०-१८", "content_sanskrit": "अनपोष्य त्रिरात्राणि तीर्थान्यनभिगम्य च।\nअदत्त्वा काञ्चनं गाश्च दरिद्रो नाम जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021045, "chapter_id": 1442, "verse_number": "३-८०-१९", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैरिष्ट्वा विपुलदक्षिणैः।\nन तत्फलमवाप्नोति तीर्थाभिगमनेन यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021046, "chapter_id": 1442, "verse_number": "३-८०-२०", "content_sanskrit": "सर्वतीर्थेषु राजेन्द्र तीर्थं त्रैलोक्यविश्रुतम्।\nपुष्करं नाम विख्यातं महाभागः समाविशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021047, "chapter_id": 1442, "verse_number": "३-८०-२१", "content_sanskrit": "दशकोटिसहस्राणि तीर्थानां वै महामते।\nसान्निध्यं पुष्करे येषां त्रिसन्ध्यं कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021048, "chapter_id": 1442, "verse_number": "३-८०-२२", "content_sanskrit": "आदित्या वसवो रुद्राः साध्याश्च समरुद्गणाः।\nगन्धर्वाप्सरसश्चैव नित्यं सन्निहिता विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021049, "chapter_id": 1442, "verse_number": "३-८०-२३", "content_sanskrit": "यत्र देवास्तपस्तप्त्वा दैत्या ब्रह्मर्षयस्तथा।\n`तपोविशेषैर्बहुभिः स्थानान्यापुर्महौजसः।\nदिव्ययोगा महाराज पुण्येन महताऽन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021050, "chapter_id": 1442, "verse_number": "३-८०-२४", "content_sanskrit": "मनसाभ्येतुकामस्य पुष्कराणि मनस्विनः।\nपूयन्ते सर्वपापानि नाकपृष्ठे च पूज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021051, "chapter_id": 1442, "verse_number": "३-८०-२५", "content_sanskrit": "तस्मिंस्तीर्थे महाभागो नित्यमेव पितामहः।\nउवास परमप्रीतो देवदानवसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021052, "chapter_id": 1442, "verse_number": "३-८०-२६", "content_sanskrit": "पुष्करेषु महाभाग देवाः सर्पिगणाः पुरा।\nसिद्धिं समभिसंप्राप्ताः पुण्येन महताऽन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021053, "chapter_id": 1442, "verse_number": "३-८०-२७", "content_sanskrit": "तत्राभिषेकं यः कुर्यात्पितृदेवांश्च तर्पयेत्।\nसर्वपापविनिर्मुक्तो ब्रह्मलोके च पूज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021054, "chapter_id": 1442, "verse_number": "३-८०-२८", "content_sanskrit": "अप्येकं भोजयेद्विप्रं पुष्करारण्यमाश्रितः।\nतेनासौ कर्मणा भीष्म प्रेत् यचेह च मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021055, "chapter_id": 1442, "verse_number": "३-८०-२९", "content_sanskrit": "शाकैर्मूलैः फलैर्वाऽपिचेन वर्तयते स्वयम्।\nतद्वै दद्याद्ब्राह्मणाय श्रद्धावाननसूयकः।\nतेनैव प्राप्नुयात्प्राज्ञो हयमेधफलं नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2021056, "chapter_id": 1442, "verse_number": "३-८०-३०", "content_sanskrit": "`अपि वाऽप्युदपात्रेण ब्राह्मणान्स्वस्ति वाचयेत्।\nतेनापि पूजनेनाशु प्रेत्यानन्त्याय कल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2021057, "chapter_id": 1442, "verse_number": "३-८०-३१", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा वा राजसत्तम।\nन वै योनौ प्रजायन्ते स्नातास्तीर्थे महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2021058, "chapter_id": 1442, "verse_number": "३-८०-३२", "content_sanskrit": "कार्तिक्यां तु विशेषेण योऽभिगच्छति पुष्करम्।\n`फलं तत्राक्षयं तेन लभते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2021059, "chapter_id": 1442, "verse_number": "३-८०-३३", "content_sanskrit": "सायंप्रातः स्मरेद्यस्तु पुष्कराणि कृताञ्जलिः।\nउपस्पृष्टं भवेत्तेन सर्वतीर्थेषु भारत।\nप्राप्नुयाच्च नरो लोकान्ब्रह्मणः सदनेऽक्षयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2021060, "chapter_id": 1442, "verse_number": "३-८०-३४", "content_sanskrit": "जन्मप्रभृतियत्पापं स्त्रिया वा पुरुषस् वा।\nपुष्करे स्नातमात्रस्य सर्वमेव प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2021061, "chapter_id": 1442, "verse_number": "३-८०-३५", "content_sanskrit": "यथा सुराणां सर्वेषामादिस्तु मधुसूदनः।\nतथैव पुष्करं राजंस्तीर्थानामादिरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2021062, "chapter_id": 1442, "verse_number": "३-८०-३६", "content_sanskrit": "उष्य द्वादशवर्षाणि पुष्करे नियतः शुचिः।\nक्रतून्सर्वानवाप्नोति ब्रह्मलोकं स गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2021063, "chapter_id": 1442, "verse_number": "३-८०-३७", "content_sanskrit": "यस्तु वर्षशतं पूर्णमग्निहोत्रमुपासते।\nकार्तिकीं वा वसेदेकां पुष्करे सममेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2021064, "chapter_id": 1442, "verse_number": "३-८०-३८", "content_sanskrit": "[त्रीणि शृङ्गाणि शुभ्राणि त्रीणि प्रस्रवणानि च।\nपुष्कराण्यादिसिद्धानि न विद्मस्तत्र कारणम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2021065, "chapter_id": 1442, "verse_number": "३-८०-३९", "content_sanskrit": "दुष्करं पुष्करं गन्तुं दुष्करं पुष्करे तपः।\nदुष्करं पुष्करे दानं वस्तुं चैव सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2021066, "chapter_id": 1442, "verse_number": "३-८०-४०", "content_sanskrit": "उष्य द्वादशरात्रं तु नियतो नियताशनः।\nप्रदक्षिणमुपावृत्य जम्बूमार्गं समाविशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2021067, "chapter_id": 1442, "verse_number": "३-८०-४१", "content_sanskrit": "जम्बूमार्गं समाक्श्यि देवर्षिपितृसेवितम्।\nअश्वमेधमवाप्नोति विष्णुलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2021068, "chapter_id": 1442, "verse_number": "३-८०-४२", "content_sanskrit": "तत्रोष्य रजनीः पञ्च कषष्ठकालक्षमी नरः।\nन दुर्गतिमवाप्नोति विष्णुलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2021069, "chapter_id": 1442, "verse_number": "३-८०-४३", "content_sanskrit": "`तत्रगत्वा महाप्राज्ञः कुर्याच्छ्राद्धं दृढव्रतः।\nवाजपेयमवाप्नोति दुष्कृतं चास्य नश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2021070, "chapter_id": 1442, "verse_number": "३-८०-४४", "content_sanskrit": "जम्बूमार्गादुपावृकत्यगच्छेत्स्थण्डिलकाश्रमम्।\nन दुर्गतिमवाप्नोति ब्रह्मलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2021071, "chapter_id": 1442, "verse_number": "३-८०-४५", "content_sanskrit": "आगस्त्यं सर आसाद्य पितृदेवार्चने रतः।\nत्रिरात्रोपोषितो राजन्नग्निष्टोमफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2021072, "chapter_id": 1442, "verse_number": "३-८०-४६", "content_sanskrit": "शाकवृत्तिः फलैर्वाऽपि कौमारं विन्दते पदम्।\nकण्वाश्रमं ततो गच्छेच्ध्रीजुष्टं लोकपूजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2021073, "chapter_id": 1442, "verse_number": "३-८०-४७", "content_sanskrit": "धर्मारण्यं हि तत्पुण्यमाद्यं च भरतर्षभ।\nयत्र प्रविष्टमात्रो वै सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2021074, "chapter_id": 1442, "verse_number": "३-८०-४८", "content_sanskrit": "अर्चयुत्वा पितॄन्देवान्नियतो नियताशनः।\nसर्वकामसमृद्धः स्याद्यज्ञस्य फलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2021075, "chapter_id": 1442, "verse_number": "३-८०-४९", "content_sanskrit": "प्रदक्षिणं ततः कृत्वा ययातिपतनं व्रजेत्।\nहयमेधस्य यज्ञस्य फंल प्राप्नोति तत्र वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2021076, "chapter_id": 1442, "verse_number": "३-८०-५०", "content_sanskrit": "महाकालं ततो गच्छेन्नियतो नियताशनः।\nकोटितीर्थमुपस्पृश्य हयमेधफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2021077, "chapter_id": 1442, "verse_number": "३-८०-५१", "content_sanskrit": "ततो गच्छेत धर्मज्ञः स्थाणोस्तीर्थमुमापतेः।\nनाम्ना भद्रवटं नाम त्रिषु लोकेषु विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2021078, "chapter_id": 1442, "verse_number": "३-८०-५२", "content_sanskrit": "तत्राभिगम्य चेशानं गोसहस्रफलं लभेत्।\nमहादेवप्रसादाच्च गाणपत्यं च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2021079, "chapter_id": 1442, "verse_number": "३-८०-५३", "content_sanskrit": "समृद्धमसपत्नं च श्रिया युक्तं नरोत्तमः।\n`राज्ञां चैवाधिपत्यं हि तत्र गत्वा समाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2021080, "chapter_id": 1442, "verse_number": "३-८०-५४", "content_sanskrit": "नर्मदां स समासाद्य नदीं त्रैलोक्यविश्रुताम्।\nतर्पयित्वा पितृन्देवानग्निष्टोमफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2021081, "chapter_id": 1442, "verse_number": "३-८०-५५", "content_sanskrit": "दक्षिमं सिन्धुमासाद्य ब्रह्मचारी जितेन्द्रियः।\nअग्निष्टोममवाप्नोति विमानं चाधिरोहति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2021082, "chapter_id": 1442, "verse_number": "३-८०-५६", "content_sanskrit": "चर्मण्वतीं समासाद्य नियतो नियताशनः।\nरन्तिदेवाभ्यनुज्ञातमग्निष्टोमफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2021083, "chapter_id": 1442, "verse_number": "३-८०-५७", "content_sanskrit": "ततो गच्छेत धर्मज्ञं हिमवत्सुतमर्बुदम्।\nपृथिव्यां यत्रवै छिद्रं पूर्वमासीद्युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2021084, "chapter_id": 1442, "verse_number": "३-८०-५८", "content_sanskrit": "तत्राश्रमो वसिष्ठस्य त्रिषु लोकेषु विश्रुतः।\nतत्रोष्य रजनीमेकां गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2021085, "chapter_id": 1442, "verse_number": "३-८०-५९", "content_sanskrit": "पिङ्गतीर्थमुपस्पृश्य ब्रह्मचारी जितेन्द्रियः।\nकपिलानां नरश्रेष्ठ शतस् फलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2021086, "chapter_id": 1442, "verse_number": "३-८०-६०", "content_sanskrit": "ततो गच्छेत राजेन्द्र प्रभासं लोकविश्रुतम्।\n`तीर्थं देवगणैः पूज्यमृषिभिश्च निषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2021087, "chapter_id": 1442, "verse_number": "३-८०-६१", "content_sanskrit": "देवतानां मुखं वीर ज्वलनोऽनिलसारथिः।\nदेवतानां मुखं वीर ज्वलनोऽनिलसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2021088, "chapter_id": 1442, "verse_number": "३-८०-६२", "content_sanskrit": "तस्मिंस्तीर्थे नरः स्नात्वा शुचिः प्रयतमानसः।\nअग्निष्टोमातिरात्राभ्यां फलं प्राप्नोति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2021089, "chapter_id": 1442, "verse_number": "३-८०-६३", "content_sanskrit": "ततो गत्वा सरस्वत्याः सागरस्य च संगमे।\nगोसहस्रफलं तस्य स्वर्गलोकं च विन्दति।\nप्रभया दीप्यते नित्यमग्निवद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2021090, "chapter_id": 1442, "verse_number": "३-८०-६४", "content_sanskrit": "वरदानं ततो गच्छेत्तीर्थं भरतसत्तम।\nविष्णोर्दुर्वाससा यत्र वरो दत्तो युधिष्ठिर।\nप्रभासते यथा सोमः सोश्वमेधं च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2021091, "chapter_id": 1442, "verse_number": "३-८०-६५", "content_sanskrit": "वरदानं ततो गच्छेत्तीर्थं भरतसत्तम।\nविष्णोर्दुर्वाससा यत्र वरो दत्तो युधिष्ठिर।\nवरदाने नरः स्नात्वा गोसहस्रफंल लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2021092, "chapter_id": 1442, "verse_number": "३-८०-६६", "content_sanskrit": "ततो द्वारवतीं गच्छेन्नियतो नियताशनः।\nपिण्डारके नरः स्नात्वा लभेद्बहुसुवर्णकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2021093, "chapter_id": 1442, "verse_number": "३-८०-६७", "content_sanskrit": "तस्मिंस्तीर्थे महाभाग पद्मलक्षणलक्षिताः।\nअद्यापि मुद्रा दृश्यन्ते तदद्भुतमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2021094, "chapter_id": 1442, "verse_number": "३-८०-६८", "content_sanskrit": "त्रिशूलाङ्कानि पद्मानि दृश्यन्ते कुरुनन्दन।\nमहादेवस्य सांनिध्यं तत्र वै पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2021095, "chapter_id": 1442, "verse_number": "३-८०-६९", "content_sanskrit": "सागरस्य च सिन्धोश्च संगमं प्राप्य दुर्लभम्।\nतीर्थे सलिलराजस्य स्नात्वा प्रयतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2021096, "chapter_id": 1442, "verse_number": "३-८०-७०", "content_sanskrit": "तर्पयित्वा पितॄन्देवानृषींश्च भरतर्षभ।\nप्राप्नोति वारुणं लोकं दीप्यमानं स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2021097, "chapter_id": 1442, "verse_number": "३-८०-७१", "content_sanskrit": "शङ्कुकर्णेश्वरं देवमर्चयित्वा युधिष्ठिर।\nअश्वमेधाद्दशगुणं प्रवदन्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2021098, "chapter_id": 1442, "verse_number": "३-८०-७२", "content_sanskrit": "प्रदक्षिणमुपावृत्य गच्छेत भरतर्षभ।\nतीर्थं कुरुवरश्रेष्ठ त्रिषु लोकेषु विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2021099, "chapter_id": 1442, "verse_number": "३-८०-७३", "content_sanskrit": "शमीति नाम्ना विख्यातं सर्वपापप्रणाशनम्।\nतत्रब्रह्मादयो देवा उपासन्ते महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2021100, "chapter_id": 1442, "verse_number": "३-८०-७४", "content_sanskrit": "तत्रस्नात्वाऽर्चयित्वा च रुद्रं देवगणैर्वृतम्।\nजन्मप्रभृतियत्पापं तत्स्नातस्य प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2021101, "chapter_id": 1442, "verse_number": "३-८०-७५", "content_sanskrit": "शमी चात्रनरश्रेष्ठ सर्वदेवैरभिष्टुता।\nतत्र स्नात्वा नरव्याघ्र हयमेधमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2021102, "chapter_id": 1442, "verse_number": "३-८०-७६", "content_sanskrit": "गत्वा यत्रमहाप्राज्ञ विष्णुना प्रभविष्णुना।\nपुरा शौचं कृतंराजन्हत्वा दैवतकण्टकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2021103, "chapter_id": 1442, "verse_number": "३-८०-७७", "content_sanskrit": "ततो गच्छेत धर्मज्ञ वसोर्धारामभिष्टुताम्।\nगमनादेवतस्यां हि हयमेधफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2021104, "chapter_id": 1442, "verse_number": "३-८०-७८", "content_sanskrit": "स्नात्वा कुरुवरश्रेष्ठ प्रयतात्मा समाहितः।\nतर्प्य देवान्पितॄंश्चैव विष्णुलोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2021105, "chapter_id": 1442, "verse_number": "३-८०-७९", "content_sanskrit": "तीर्थे चात्र सर पुण्यं वसूनां भरतर्षभ।\nतत्र स्नात्वा च पीत्वा च वसूनां संमतोभवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2021106, "chapter_id": 1442, "verse_number": "३-८०-८०", "content_sanskrit": "सिन्धूत्तममिति ख्यातं सर्वपापप्रणाशनम्।\nतत्र स्नात्वा नरश्रेष्ठ लभेद्बहुसुवर्णकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2021107, "chapter_id": 1442, "verse_number": "३-८०-८१", "content_sanskrit": "ब्रह्मतीर्थं समासाद्य शुचिः शीलसमन्वितः।\nब्रह्मलोकमवाप्नोति गतिं च परमां व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2021108, "chapter_id": 1442, "verse_number": "३-८०-८२", "content_sanskrit": "कुमारिकाणां शक्रस्य तीर्थं सिद्धनिषेवितम्।\nतत्र स्नात्वा नरः क्षिप्रं स्वर्गलोकमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2021109, "chapter_id": 1442, "verse_number": "३-८०-८३", "content_sanskrit": "रेणुकायाश्च तत्रैव तीर्थं सिद्धनिषेवितम्।\nतत्र स्नात्वा भवेद्विप्रो निर्मलश्चन्द्रमा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2021110, "chapter_id": 1442, "verse_number": "३-८०-८४", "content_sanskrit": "अथ पञ्चनदं गत्वा नियतो नियताशनः।\nपञ्चयज्ञानवाप्नोति क्रमशो येऽनुकीर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2021111, "chapter_id": 1442, "verse_number": "३-८०-८५", "content_sanskrit": "ततो गच्छेत राजेन्द्र भीमायाः स्थानमुत्तमम्।\nतत्रस्नात्वा न योन्यां वै भवेद्भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2021112, "chapter_id": 1442, "verse_number": "३-८०-८६", "content_sanskrit": "देव्याः पुत्रो भवेद्राजंस्तप्तकुण्डलभूषणः।\nगवां शतसहस्रस्य फलं प्राप्नोति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2021113, "chapter_id": 1442, "verse_number": "३-८०-८७", "content_sanskrit": "गिरिकुञ्जं समासाद्य त्रिषु लोकेषु विश्रुतम्।\nपितामहं नमस्कृत्य गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2021114, "chapter_id": 1442, "verse_number": "३-८०-८८", "content_sanskrit": "ततो गच्छेत धर्मज्ञ विमलं तीर्थमुत्तमम्।\nअद्यापि यत्रदृश्यन्ते मत्स्याः सौवर्णराजताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2021115, "chapter_id": 1442, "verse_number": "३-८०-८९", "content_sanskrit": "तत्र स्नात्वा नरः क्षिप्रं वासवं लोकमाप्नुयात्।\nसर्वपापविशुद्धात्मा गच्छेत परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2021116, "chapter_id": 1442, "verse_number": "३-८०-९०", "content_sanskrit": "वितस्तां च समासाद्य संतर्प्य पितृदेवताः।\nनरः फलमवाप्नोति वाजपेयस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2021117, "chapter_id": 1442, "verse_number": "३-८०-९१", "content_sanskrit": "काश्मीरष्वेव नागस्य भवनं तक्षकस्य च।\nवितस्ताख्यमिति ख्यातं सर्वपापप्रमोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2021118, "chapter_id": 1442, "verse_number": "३-८०-९२", "content_sanskrit": "तत्रस्नात्वा नरो नूनं वाजपेयमवाप्नुयात्।\nसर्वपापविशुद्धात्मा गच्छेच्च परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2021119, "chapter_id": 1442, "verse_number": "३-८०-९३", "content_sanskrit": "ततो गच्छेत मलदां त्रिषु लोकेषु विश्रुताम्।\nपश्चिमायां तु संध्यायामुपस्पृश्य यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2021120, "chapter_id": 1442, "verse_number": "३-८०-९४", "content_sanskrit": "चरुं सप्तार्चिषे राजन्यथाशक्ति निवेदयेत्।\nपितॄणामक्षयं दानं प्रवदन्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2021121, "chapter_id": 1442, "verse_number": "३-८०-९५", "content_sanskrit": "ऋषयः पितरो देवा गन्धर्वाप्सरसां गणाः।\nगुह्यकाः किन्नरा यक्षाः सिद्धा विद्याधरा नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2021122, "chapter_id": 1442, "verse_number": "३-८०-९६", "content_sanskrit": "राक्षसा दितिजा रुद्रा ब्रह्मा च मनुजाधिप।\nनियतः परमां दीक्षामास्थायाब्दसहस्रिकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2021123, "chapter_id": 1442, "verse_number": "३-८०-९७", "content_sanskrit": "विष्णोः प्रसादनं कुर्वंश्चरुं च श्रपयंस्तथा।\nसप्तभिः सप्तभिश्चैव ऋग्भिस्तुष्टाव केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2021124, "chapter_id": 1442, "verse_number": "३-८०-९८", "content_sanskrit": "ददावष्टगुणैश्वर्यं तेषां तुष्टस्तु केशवः।\nयथाभिलषितानन्यान्कामान्दत्वा महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2021125, "chapter_id": 1442, "verse_number": "३-८०-९९", "content_sanskrit": "तत्रैवान्तर्दधे देवो विद्युदभ्रेषु वै यथा।\nनाम्ना सप्तचरुं तेन ख्यातं लोकेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2021126, "chapter_id": 1442, "verse_number": "३-८०-१००", "content_sanskrit": "गवां शतसहस्रेण राजसूयशतेन च।\nअश्वमेधसहस्रेण श्रेयान्सप्तार्चिषे चरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2021127, "chapter_id": 1442, "verse_number": "३-८०-१०१", "content_sanskrit": "ततो निवृत्तो राजेन्द्र रुद्रं पदमथाविशेत्।\nअर्चयित्वामहादेवमश्वमेधफलं लभेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2021128, "chapter_id": 1442, "verse_number": "३-८०-१०२", "content_sanskrit": "मणिमन्तं समासाद्य ब्रह्मचारी समाहितः।\nएकरात्रोपितो राजन्नग्निष्टोमफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2021129, "chapter_id": 1442, "verse_number": "३-८०-१०३", "content_sanskrit": "अथ गच्छेत राजेन्द्र देविकां लोकविश्रुतम्।\nप्रसूतिर्यत्र विप्राणां श्रूयते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2021130, "chapter_id": 1442, "verse_number": "३-८०-१०४", "content_sanskrit": "त्रिशूलपाणएः स्थानं च त्रिषु लोकेषु विश्रुतम्।\nदेविकायां नरः स्नात्वा समभ्यर्च्य महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2021131, "chapter_id": 1442, "verse_number": "३-८०-१०५", "content_sanskrit": "यथाशक्ति चरुं तत्र निवेद्य भरतर्षभ।\nसर्वकामसमृद्धस्य यज्ञस्य लभते फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2021132, "chapter_id": 1442, "verse_number": "३-८०-१०६", "content_sanskrit": "कामाख्यं तत्र रुद्रस्य तीर्थं देवनिषेवितम्।\nतत्रस्नात्वा नरः क्षिप्रं सिद्धिं प्राप्नोति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2021133, "chapter_id": 1442, "verse_number": "३-८०-१०७", "content_sanskrit": "यजनं याजनं चैवतथैव ब्रह्मबालुकम्।\nपुष्पाम्भश्च उपस्पृश्य न शोचेन्मरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2021134, "chapter_id": 1442, "verse_number": "३-८०-१०८", "content_sanskrit": "अर्धयोजनविस्तारां पञ्चयोजनमायताम्।\nएतां हि देविकामाहुः पुण्यां देवर्षिसेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2021135, "chapter_id": 1442, "verse_number": "३-८०-१०९", "content_sanskrit": "ततो गच्छेत धर्मज्ञ दीर्घसत्रं यथाक्रमम्।\nतत्र ब्रह्मादयो देवाः सिद्धाश्च परमर्षपः।\nदीर्घसत्रमुपासन्ते दीक्षिता नियतव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2021136, "chapter_id": 1442, "verse_number": "३-८०-११०", "content_sanskrit": "गमनादेव राजेन्द्र दीर्घसत्रमरिंदम।\nराजसूयाश्वमेधाभ्यां फलं प्राप्नोति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2021137, "chapter_id": 1442, "verse_number": "३-८०-१११", "content_sanskrit": "ततो विनशनं गच्छेन्नियतो नियताशनः।\nगच्छत्यन्तर्हिता यत्रमेरुपृष्ठे सरस्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2021138, "chapter_id": 1442, "verse_number": "३-८०-११२", "content_sanskrit": "चमसेऽथ शिवोद्भेदे नागोद्भेदे च दृश्यते।\n`तत्र स्नात्वा नरव्याघ्र द्योतते शशिवत्वदा।\nस्नात्वा तु चमसोद्भेदे अग्निष्टोमफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2021139, "chapter_id": 1442, "verse_number": "३-८०-११३", "content_sanskrit": "शिवोद्भेदे नरः स्नात्वा गोसहस्रफंल लभेत्।\nनागोद्भेदे नरः स्नात्वा नागलोकमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2021140, "chapter_id": 1442, "verse_number": "३-८०-११४", "content_sanskrit": "शशयानं च राजेन्द्रतीर्थमासाद्य दुर्लभम्।\nशतरूपप्रतिच्छन्नाः पुष्करा यत्र भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2021141, "chapter_id": 1442, "verse_number": "३-८०-११५", "content_sanskrit": "सरस्वत्यां महाराज शतं संवत्सरं च ते।\nदृश्यन्ते भरतश्रेष्ठ वृत्तां वै कार्तिकीं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2021142, "chapter_id": 1442, "verse_number": "३-८०-११६", "content_sanskrit": "तत्रस्नात्वा नरव्याघ्र द्योतते शशिवत्सदा।\nगोसहस्रफलं चैव प्राप्नुयाद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2021143, "chapter_id": 1442, "verse_number": "३-८०-११७", "content_sanskrit": "कुमारकोटीमासाद्य नियतः कुरुनन्दन।\nतत्राभिषेकं कुर्वीत पितृदेवार्चने रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2021144, "chapter_id": 1442, "verse_number": "३-८०-११८", "content_sanskrit": "गवामयुतमाप्नोति कुलं चैव समुद्धरेत्।\nततो गच्छेत धर्मज्ञ रुद्रकोटिं समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2021145, "chapter_id": 1442, "verse_number": "३-८०-११९", "content_sanskrit": "पुरा यत्र महाराज मुनिकोटिः समागता।\nहर्षेण महताऽऽविष्टा रुद्रदर्शनकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2021146, "chapter_id": 1442, "verse_number": "३-८०-१२०", "content_sanskrit": "अहंपूर्वमहंपूर्वं द्रक्ष्यामि वृषभध्वजम्।\nएवं संप्रस्थिता राजन्नृषयः किल भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2021147, "chapter_id": 1442, "verse_number": "३-८०-१२१", "content_sanskrit": "ततो योगीश्वरेणापि योगमास्थाय भूपते।\nतेषां मन्युप्रणाशार्थमृषीणां भावितात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2021148, "chapter_id": 1442, "verse_number": "३-८०-१२२", "content_sanskrit": "स्रष्टा कोटीस्तु रुद्राणामृषीणामग्रतः स्थिता।\nमया पूर्वतरं दृष्ट इतिते मेनिरे पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2021149, "chapter_id": 1442, "verse_number": "३-८०-१२३", "content_sanskrit": "तेषां तुष्टो महादेवो मुनीनां भावितात्मनाम्।\nभक्त्या परमया राजन्वरं तेषां प्रदिष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2021150, "chapter_id": 1442, "verse_number": "३-८०-१२४", "content_sanskrit": "अद्यप्रभृति युष्माकं धर्मवृद्धिर्भविष्यति।\nतत्रस्नात्वा नरव्याघ्र रुद्रकोट्यां नरः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2021151, "chapter_id": 1442, "verse_number": "३-८०-१२५", "content_sanskrit": "अश्वमेधमवाप्नोति कुलं चैव समुद्धरेत्।\nततो गच्छेत राजेन्द्र संगमं लोकविश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2021152, "chapter_id": 1442, "verse_number": "३-८०-१२६", "content_sanskrit": "सरस्वत्या महापुण्यं केशवं समुपासते।\nयत्रब्रह्माहयो देवा ऋषयश्च तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2021153, "chapter_id": 1442, "verse_number": "३-८०-१२७", "content_sanskrit": "अभिगच्छन्ति राजेन्द्र चैत्रशुक्लचतुर्दशीम्।\nतत्रस्नात्वा नरव्याघ्र विन्देद्बहुसुवर्णकम्।\nसर्वपापविशुद्धात्मा ब्रह्मलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2021154, "chapter_id": 1442, "verse_number": "३-८०-१२८", "content_sanskrit": "ऋषीणां यत्र सत्राणि समाप्तानि नराधिप।\nतत्रावसानमासाद्य गोसहस्रफलं लभेत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2021155, "chapter_id": 1442, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि अशीतितमोऽध्यायः ॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}]