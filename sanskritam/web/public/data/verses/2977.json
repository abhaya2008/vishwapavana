[{"id": 2092872, "chapter_id": 2977, "verse_number": "१३-१०७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nउक्तं ते गोप्रदानं वै नाचिकेतमृषिं प्रति।\nमाहात्म्यमपि चैवोक्तमुद्देशेन गवां प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092873, "chapter_id": 2977, "verse_number": "१३-१०७-२", "content_sanskrit": "नृगेण च महद्दुःखमनुभूतं महात्मना।\nएकापराधादज्ञानात्पितामह महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092874, "chapter_id": 2977, "verse_number": "१३-१०७-३", "content_sanskrit": "द्वारवत्यां यथा चासौ निविशन्त्यां समुद्धृतः।\nमोक्षहेतुरभूत्कृष्णस्तदप्यवधृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092875, "chapter_id": 2977, "verse_number": "१३-१०७-४", "content_sanskrit": "किं त्वस्ति मम संदेहो गवां लोकं प्रति प्रभो।\nतत्त्वतः श्रोतुमिच्छामि गोदा यत्र वसन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092876, "chapter_id": 2977, "verse_number": "१३-१०७-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092877, "chapter_id": 2977, "verse_number": "१३-१०७-५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nयथाऽपृच्छत्पद्मयोनिमेतदेव शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092878, "chapter_id": 2977, "verse_number": "१३-१०७-६x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092879, "chapter_id": 2977, "verse_number": "१३-१०७-६", "content_sanskrit": "स्वर्लोकवासिनां लक्ष्मीमभिभूय स्वयाऽर्चिषा।\nगोलोकवासिनः पश्ये वदतां संशयोऽत्र मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092880, "chapter_id": 2977, "verse_number": "१३-१०७-७", "content_sanskrit": "कीदृशा भगवँल्लोका गवां तद्बूहि मेऽनघ।\nयानावसन्ति दातार एतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092881, "chapter_id": 2977, "verse_number": "१३-१०७-८", "content_sanskrit": "कीदृशाः किंफलाः किंस्वित्परमस्तत्र को गुणः।\nकथं च पुरुषास्तत्र गच्छन्ति विगतज्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092882, "chapter_id": 2977, "verse_number": "१३-१०७-९", "content_sanskrit": "कियत्कालं प्रदानस्य दाता च फलमश्नुते।\nकथं बहुविधं दानं स्यादल्पमपि वा कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092883, "chapter_id": 2977, "verse_number": "१३-१०७-१०", "content_sanskrit": "बह्वीनां कीदृशं दानमल्पानां वाऽपि दीदृशम्।\nअदत्त्वा गोप्रदाः सन्ति केन वा तच्च शंस मे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092884, "chapter_id": 2977, "verse_number": "१३-१०७-११", "content_sanskrit": "कथं वा बहुदाता स्यादल्पदात्रा समः प्रभो।\nअल्पप्रदाता बहुदः कथं स्वित्स्यादिहेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092885, "chapter_id": 2977, "verse_number": "१३-१०७-१२", "content_sanskrit": "कीदृशी दक्षिणा चैव गोप्रदाने विशिष्यते।\nएतत्तथ्येन भगवन्मम शंसितुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092886, "chapter_id": 2977, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्ताधिकशततमोऽध्यायः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]