[{"id": 7006360000, "chapter_id": 26360, "verse_number": "२-१६-१", "content_sanskrit": "वैशम्पायन उवाच\nगोपवृद्धस्य वचनं श्रुत्वा शक्रपरिग्रहे ।\nप्रभावज्ञोऽपि शक्रस्य वाक्यं दामोदरोऽब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006360001, "chapter_id": 26360, "verse_number": "२-१६-२", "content_sanskrit": "वयं वनचरा गोपाः सदा गोधनजीविनः ।\nगावोऽस्मद्दैवतं विद्धि गिरयश्च वनानि च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006360002, "chapter_id": 26360, "verse_number": "२-१६-३", "content_sanskrit": "कर्षुकाणां कृषिर्वृत्तिः पण्यं विपणिजीविनाम् ।\nगावोऽस्माकं परा वृत्तिरेतत् त्रैविद्यमुच्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006360003, "chapter_id": 26360, "verse_number": "२-१६-४", "content_sanskrit": "विद्यया यो यया युक्तस्तस्य सा दैवतं परम् ।\nसैव पूज्यार्चनीया च सैव तस्योपकारिणी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006360004, "chapter_id": 26360, "verse_number": "२-१६-५", "content_sanskrit": "योऽन्यस्य फलमश्नानः करोत्यन्यस्य सत्क्रियाम् ।\nद्वावनर्थौ स लभते प्रेत्य चेह च मानवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006360005, "chapter_id": 26360, "verse_number": "२-१६-६", "content_sanskrit": "कृष्यन्ता प्रथिता सीमा सीमान्तं श्रूयते वनम् ।\nवनान्ता गिरयः सर्वे ते चास्माकं गतिर्ध्रुवा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006360006, "chapter_id": 26360, "verse_number": "२-१६-७", "content_sanskrit": "श्रूयन्ते गिरयश्चापि वनेऽस्मिन् कामरूपिणः ।\nप्रविश्य तास्तास्तनवो रमन्ते स्वेषु सानुषु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006360007, "chapter_id": 26360, "verse_number": "२-१६-८", "content_sanskrit": "भूत्वा केसरिणः सिंहा व्याघ्राश्च नखिनां वराः ।\nवनानि स्वानि रक्षन्ति त्रासयन्तो वनच्छिदः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006360008, "chapter_id": 26360, "verse_number": "२-१६-९", "content_sanskrit": "यदा चैषां विकुर्वन्ति ते वनालयजीविनः ।\nघ्नन्ति तानेव दुर्वृत्तान् पौरुषादेन कर्मणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006360009, "chapter_id": 26360, "verse_number": "२-१६-१०", "content_sanskrit": "मन्त्रयज्ञपरा विप्राः सीतायज्ञाश्च कर्षुकाः ।\nगिरियज्ञास्तथा गोपा इज्योऽस्माभिर्गिरिर्वने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006360010, "chapter_id": 26360, "verse_number": "२-१६-११", "content_sanskrit": "तन्मह्यं रोचते गोपा गिरियज्ञः प्रवर्तताम् ।\nकर्म कृत्वा सुखस्थाने पादपेष्वथवा गिरौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006360011, "chapter_id": 26360, "verse_number": "२-१६-१२", "content_sanskrit": "तत्र हत्वा पशून् मेध्यान् वितत्यायतने शुभे ।\nसर्वघोषस्य संदोहः क्रियतां किं विचार्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006360012, "chapter_id": 26360, "verse_number": "२-१६-१३", "content_sanskrit": "तं शरत्कुसुमापीडाः परिवार्य प्रदक्षिणम् ।\nगावो गिरिवरं सर्वास्ततो यान्तु पुनर्व्रजम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006360013, "chapter_id": 26360, "verse_number": "२-१६-१४", "content_sanskrit": "प्राप्ता किलेयं हि गवां स्वादुतोयतृणा गुणैः ।\nशरत् प्रमुदिता रम्या गतमेघजलाशया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006360014, "chapter_id": 26360, "verse_number": "२-१६-१५", "content_sanskrit": "प्रियकैः पुष्पितैर्गौरं श्याम बाणासनैः क्वचित् ।\nकठोरतृणमाभाति निर्मयूररुतं वनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006360015, "chapter_id": 26360, "verse_number": "२-१६-१६", "content_sanskrit": "विजला विमला व्योम्नि विबलाका विविद्युतः ।\nविवर्धन्ते जलधरा विदन्ता इव कुञ्जराः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006360016, "chapter_id": 26360, "verse_number": "२-१६-१७", "content_sanskrit": "पटुना मेघवातेन नवतोयानुकर्षिणा ।\nपर्णोत्करघनाः सर्वे प्रसादं यान्ति पादपाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006360017, "chapter_id": 26360, "verse_number": "२-१६-१८", "content_sanskrit": "सितवर्णाम्बुदोष्णीषं हंसचामरवीजितम् ।\nपूर्णचन्द्रामलच्छत्रं साभिषेकमिवाम्बरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006360018, "chapter_id": 26360, "verse_number": "२-१६-१९", "content_sanskrit": "हंसैः प्रहसितानीव समुत्कृष्टानि सारसैः ।\nसर्वाणि तनुतां यान्ति जलानि जलदक्षये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006360019, "chapter_id": 26360, "verse_number": "२-१६-२०", "content_sanskrit": "चक्रवाकस्तनतटाः पुलिनश्रोणिमण्डलाः ।\nहंसलक्षणहासिन्यः पतिं यान्ति समुद्रगाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006360020, "chapter_id": 26360, "verse_number": "२-१६-२१", "content_sanskrit": "कुमुदोत्फुल्लमुदकं ताराभिश्चित्रमम्बरम् ।\nसममभ्युत्स्मयन्तीव शर्वरीष्वितरेतरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006360021, "chapter_id": 26360, "verse_number": "२-१६-२२", "content_sanskrit": "मत्तक्रौञ्चावघुष्टेषु कलमापक्वपाण्डुषु ।\nनिर्विष्टरमणीयेषु वनेषु रमते मनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006360022, "chapter_id": 26360, "verse_number": "२-१६-२३", "content_sanskrit": "पुष्करिण्यस्तडागानि वाप्यश्च विकचोत्पलाः ।\nकेदाराः सरितश्चैव सरांसि च श्रियाज्वलन् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006360023, "chapter_id": 26360, "verse_number": "२-१६-२४", "content_sanskrit": "पङ्कजानि च ताम्राणि तथान्यानि सितान्यपि ।\nउत्पलानि च नीलानि भेजिरे वारिजां श्रियम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006360024, "chapter_id": 26360, "verse_number": "२-१६-२५", "content_sanskrit": "मदं जहुः सितापाङ्गा मन्दं ववृधिरेऽनिलाः ।\nअभवद् व्यभ्रमाकाशमभूच्च निभृतोऽर्णवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006360025, "chapter_id": 26360, "verse_number": "२-१६-२६", "content_sanskrit": "ऋतुपर्यायशिथिलैर्वृत्तनृत्यसमुज्झितैः ।\nमयूराङ्गरुहैर्भूमिर्बहुनेत्रेव लक्ष्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006360026, "chapter_id": 26360, "verse_number": "२-१६-२७", "content_sanskrit": "स्वपङ्कमलिनैस्तीरैः काशपुष्पलताकुलैः ।\nहंससारसविन्यासैर्यमुना भाति शोभना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006360027, "chapter_id": 26360, "verse_number": "२-१६-२८", "content_sanskrit": "कलमापाकरम्येषु केदारेषु जलेषु च ।\nसस्यादा जलजादाश्च मत्ता विरुरुवुः खगाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006360028, "chapter_id": 26360, "verse_number": "२-१६-२९", "content_sanskrit": "सिषिचुर्यानि जलदा जलेन जलदागमे ।\nतानि सस्यानि बालानि कठिनत्वं गतानि वै ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006360029, "chapter_id": 26360, "verse_number": "२-१६-३०", "content_sanskrit": "त्यक्त्वा मेघमयं वासः शरद्गुणविदीपितः ।\nएष वै विमले व्योम्नि हृष्टो वसति चन्द्रमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006360030, "chapter_id": 26360, "verse_number": "२-१६-३१", "content_sanskrit": "क्षीरिण्यो द्विगुणं गावः प्रमत्ता द्विगुणं वृषाः ।\nवनानां द्विगुणा लक्ष्मीः सस्यैर्गुणवती मही ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006360031, "chapter_id": 26360, "verse_number": "२-१६-३२", "content_sanskrit": "ज्योतींषि घनमुक्तानि पद्मवन्ति जलानि च ।\nमनांसि च मनुष्याणां प्रसादमुपयान्ति वै ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006360032, "chapter_id": 26360, "verse_number": "२-१६-३३", "content_sanskrit": "असृजत्सविता व्योम्नि निर्मुक्तो जलदैर्भृशम् ।\nशरत्प्रज्वलितं तेजस्तीक्ष्णरश्मिर्विशोषयन् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006360033, "chapter_id": 26360, "verse_number": "२-१६-३४", "content_sanskrit": "नीराजयित्वा सैन्यानि प्रयान्ति विजिगीषवः ।\nअन्योन्यराष्ट्राभिमुखाः पार्थिवाः पृथिवीक्षितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006360034, "chapter_id": 26360, "verse_number": "२-१६-३५", "content_sanskrit": "बन्धुजीवाभिताम्रासु बद्धपङ्कवतीषु च ।\nमनस्तिष्ठति कान्तासु चित्रासु वनराजिषु ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006360035, "chapter_id": 26360, "verse_number": "२-१६-३६", "content_sanskrit": "वनेषु च विराजन्ते पादपा वनशोभिनः ।\nअसनाः सप्तपर्णाश्च कोविदाराश्च पुष्पिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006360036, "chapter_id": 26360, "verse_number": "२-१६-३७", "content_sanskrit": "इषुसाह्वा निकुम्भाश्च प्रियकाः स्वर्णकास्तथा ।\nसृमराः पेचकाश्चैव केतक्यश्च समन्ततः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006360037, "chapter_id": 26360, "verse_number": "२-१६-३८", "content_sanskrit": "व्रजेषु च विशेषेण गर्गरोद्गारहासिषु ।\nशरत्प्रकाशयोषेव गोष्ठेष्वटति रूपिणी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006360038, "chapter_id": 26360, "verse_number": "२-१६-३९", "content_sanskrit": "नूनं त्रिदशभूयिष्ठं मेघकालसुखोषितम् ।\nपतत्त्रिकेतनं देवं बोधयन्ति दिवौकसः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006360039, "chapter_id": 26360, "verse_number": "२-१६-४०", "content_sanskrit": "शरद्येवं सुसस्यायां प्राप्तायां प्रावृषः क्षये ।\nनीलचन्द्रार्कवर्णैश्च रचितं बहुभिर्द्विजैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006360040, "chapter_id": 26360, "verse_number": "२-१६-४१", "content_sanskrit": "फलैः प्रवालैश्च घनमिन्द्रचापघनोपमम् ।\nभवनाकारविटपं लतापरममण्डितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006360041, "chapter_id": 26360, "verse_number": "२-१६-४२", "content_sanskrit": "विशालमूलावनतं पवनाभोगमण्डितम् ।\nअर्चयामो गिरिं देवं गाश्चैव च विशेषतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006360042, "chapter_id": 26360, "verse_number": "२-१६-४३", "content_sanskrit": "सावतंसैर्विषाणैश्च बर्हापीडैश्च दंशितैः ।\nघण्टाभिश्च प्रलम्बाभिः पुष्पैः शारदिकैस्तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006360043, "chapter_id": 26360, "verse_number": "२-१६-४४", "content_sanskrit": "शिवाय गावः पूज्यन्तां गिरियज्ञः प्रवर्त्यताम् ।\nपूज्यतां त्रिदशैः शक्रो गिरिरस्माभिरिज्यताम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006360044, "chapter_id": 26360, "verse_number": "२-१६-४५", "content_sanskrit": "कारयिष्यामि गोयज्ञं बलादपि न संशयः ।\nयद्यस्ति मयि वः प्रीतिर्यदि वा सुहृदो वयम् ।\nगावो हि पूज्याः सततं सर्वेषां नात्र संशयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006360045, "chapter_id": 26360, "verse_number": "२-१६-४६", "content_sanskrit": "यदि साम्ना भवेत् प्रीतिर्भवतां वैभवाय च ।\nएतन्मम वचस्तथ्यं क्रियतामविचारितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]