[{"id": 900010154, "chapter_id": 8776, "verse_number": "3.1", "content_sanskrit": "पृथगात्मानं प्रेरितारं च मत्वा जुष्टस्ततस्तेनामृतत्वमेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010155, "chapter_id": 8776, "verse_number": "3.2", "content_sanskrit": "स यो ह वै तत्परमं ब्रह्म वेद ब्रह्मैव भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010156, "chapter_id": 8776, "verse_number": "3.3", "content_sanskrit": "भगवद्गीताऽपि न जीवब्रह्मणोरैक्यबोधिका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010157, "chapter_id": 8776, "verse_number": "3.4", "content_sanskrit": "वेदार्थनिर्णायकानि ब्रह्मसूत्राण्यपि जीवब्रह्मणोर्भेदप्रतिपादकान्येव न त्वैक्यप्रतिपादकानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010158, "chapter_id": 8776, "verse_number": "3.5", "content_sanskrit": "शास्त्रदृष्ट्या तूपदेशो वामदेववत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900010159, "chapter_id": 8776, "verse_number": "3.6", "content_sanskrit": "तदनन्यत्वाधिकरणस्य तद्विषयवाक्यानां च विश्वमिथ्यात्वपरत्वनिरासेन विश्वसत्यत्वपरत्वसमर्थनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900010160, "chapter_id": 8776, "verse_number": "3.7", "content_sanskrit": "सर्वस्वाप्नानां मिथ्यात्वविषये प्रब्रोधकालीन बाधस्य शङ्कराचार्योंक्तहेतुत्व निराकरणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900010161, "chapter_id": 8776, "verse_number": "3.8", "content_sanskrit": "शङ्कराचार्योक्तस्वप्नदृष्टांनां रथादीनां मिथ्यात्वे प्रबोधकाले बाधितत्वहेतुभङ्ग:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900010162, "chapter_id": 8776, "verse_number": "3.9", "content_sanskrit": "स्वाप्नपदार्थानां मिथ्यात्वे उपादानकारणाभावस्य हेतुत्वभङ्ग:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900010163, "chapter_id": 8776, "verse_number": "3.10", "content_sanskrit": "स्वाप्नपदार्थानां (मिथ्यात्वे )सर्जनसमर्थपुरुषाभावस्य हेतुत्वभङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900010164, "chapter_id": 8776, "verse_number": "3.11", "content_sanskrit": "स्वाप्नपदार्थानांमिथ्यात्वे स्वाप्नपदार्थज्ञानकारणाभावस्य हेतुत्वभङ्ग:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900010165, "chapter_id": 8776, "verse_number": "3.12", "content_sanskrit": "ॐवैधर्म्याच्च न स्वप्नादिवत्ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900010166, "chapter_id": 8776, "verse_number": "3.13", "content_sanskrit": "ॐ भावे चोपलब्धेः ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900010167, "chapter_id": 8776, "verse_number": "3.14", "content_sanskrit": "ॐ सत्त्वाच्चावरस्य ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900010168, "chapter_id": 8776, "verse_number": "3.15", "content_sanskrit": "ॐ असद्व्यपदेशान्नेति चेन्न धर्मान्तरेण वाक्यशेषात् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900010169, "chapter_id": 8776, "verse_number": "3.16", "content_sanskrit": "ॐ युक्तेश्शब्दांतराच्च ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900010170, "chapter_id": 8776, "verse_number": "3.17", "content_sanskrit": "ॐ पटवच्च ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900010171, "chapter_id": 8776, "verse_number": "3.18", "content_sanskrit": "ॐ इतरव्यपदेशाद्धिताकरणादिदोषप्रसक्ति: ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900010172, "chapter_id": 8776, "verse_number": "3.19", "content_sanskrit": "वाक्यान्वयाधिकरणस्य जीवत्वोपलक्षितब्रह्मपरत्वनिरासपूर्वकं जीवपरमात्मभेदपरत्वसमर्थनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900010173, "chapter_id": 8776, "verse_number": "3.20", "content_sanskrit": "प्रकृत्यधिकरणस्य ब्रह्मणः विवर्तोपादानकारणतापरत्वनिरासपूर्वकं विश्वकर्तृत्वपरत्व समर्थनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900010174, "chapter_id": 8776, "verse_number": "3.21", "content_sanskrit": "उत्पत्त्यसंभवाधिकरणस्य पञ्चरात्राप्रामाण्यपरत्वाभावसमर्थनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]