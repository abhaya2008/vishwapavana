[{"id": 7006559000, "chapter_id": 26559, "verse_number": "३-९८-१", "content_sanskrit": "बलभद्रस्य एकलव्येन सार्धं युद्धं, बलभद्रेण निषादानां संहारः वैशम्पायन उवाच एतस्मिन्नन्तरे क्रुद्ध एकलव्यो निषादपः ।\nबलभद्रमभि क्षिप्रं धनुरादाय सत्वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006559001, "chapter_id": 26559, "verse_number": "३-९८-२", "content_sanskrit": "नाराचैर्दशभिर्विद्ध्वा बाणैश्च दशभिः परैः ।\nचिच्छेद धनुरर्धं तत् सर्वक्षत्रस्य पश्यतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006559002, "chapter_id": 26559, "verse_number": "३-९८-३", "content_sanskrit": "सूतं दशभिराहत्य रथं त्रिंशद्भिरेव च ।\nध्वजं चिच्छेद भल्लेन निषादस्य जगत्पतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006559003, "chapter_id": 26559, "verse_number": "३-९८-४", "content_sanskrit": "ततः परं महच्चापं निषादो वीर्यसम्मतः ।\nदृढमौर्व्या समायुक्तं दशतालप्रमाणतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006559004, "chapter_id": 26559, "verse_number": "३-९८-५", "content_sanskrit": "कामपालं शरेणाशु जघान जनमध्यतः ।\nबलदेवो महावीर्यः सर्पः शेष इव श्वसन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006559005, "chapter_id": 26559, "verse_number": "३-९८-६", "content_sanskrit": "दशभिस्तद्धनुर्दिव्यं शरैः सर्पसमैर्बलः ।\nचिच्छेद मुष्टिदेशे तु माधवो माधवाग्रजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006559006, "chapter_id": 26559, "verse_number": "३-९८-७", "content_sanskrit": "एकलव्यो निषादेशः खड्गमादाय सत्वरः ।\nप्राहिणोद् बलमादाय निशितं घोरविग्रहम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006559007, "chapter_id": 26559, "verse_number": "३-९८-८", "content_sanskrit": "तमन्तरे पटुर्वीरो वृष्णिवीरः प्रतापवान् ।\nतिलशः पञ्चभिर्बाणैश्चकार यदुनन्दनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006559008, "chapter_id": 26559, "verse_number": "३-९८-९", "content_sanskrit": "ततोऽपरं महत् खड्गं सर्वकालायसं शुभम् ।\nप्राहिणोत् सारथेः कायमालोक्याथ निषादजः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006559009, "chapter_id": 26559, "verse_number": "३-९८-१०", "content_sanskrit": "तं चापि दशभिर्वीरो माधवो यदुनन्दनः ।\nबाह्वोरन्तरयोश्चैव निर्बिभेद महारणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006559010, "chapter_id": 26559, "verse_number": "३-९८-११", "content_sanskrit": "ततः शक्तिं समादाय घण्टामालाकुलां नृपः ।\nनिषादो बलदेवाय प्रेषयित्वा महाबलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006559011, "chapter_id": 26559, "verse_number": "३-९८-१२", "content_sanskrit": "सिंहनादं महाघोरमकरोत् स निषादपः ।\nसा शक्तिः सर्वकल्याणी बलदेवमुपागमत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006559012, "chapter_id": 26559, "verse_number": "३-९८-१३", "content_sanskrit": "उत्पतन्तीं महाघोरां बलभद्रः प्रतापवान् ।\nआदायाथ निषादेशं सर्वान् विस्मापयन्निव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006559013, "chapter_id": 26559, "verse_number": "३-९८-१४", "content_sanskrit": "तयैव तं जघानाशु वक्षोदेशे च माधवः ।\nस तया ताडितो वीरः स्वशक्त्याथ निषादपः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006559014, "chapter_id": 26559, "verse_number": "३-९८-१५", "content_sanskrit": "विह्वलः सर्वगात्रेषु निपपात महीतले ।\nप्राणसंशयमापन्नो निषादो रामताडितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006559015, "chapter_id": 26559, "verse_number": "३-९८-१६", "content_sanskrit": "निषादास्तस्य राजेन्द्र शतशोऽथ सहस्रशः ।\nअष्टाशीतिसहस्राणि निषादास्तस्य योधिनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006559016, "chapter_id": 26559, "verse_number": "३-९८-१७", "content_sanskrit": "गदिनः खड्गिनश्चैव महेष्वासा महाबलाः ।\nशरैरनेकसाहस्रैः शक्तिभिश्च परश्वधैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006559017, "chapter_id": 26559, "verse_number": "३-९८-१८", "content_sanskrit": "गदाभिः पट्टिशैः शूलैः परिघैः प्रासतोमरैः ।\nकुन्तैरथ कुठारैश्च यादवानां महौजसाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006559018, "chapter_id": 26559, "verse_number": "३-९८-१९", "content_sanskrit": "शलभा इव राजेन्द्र दीप्यमानं हुताशनम् ।\nते शरैः पातयांचक्रू रामं राममिवापरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006559019, "chapter_id": 26559, "verse_number": "३-९८-२०", "content_sanskrit": "केचित् कुठारैराजघ्नुः केचित् कुन्तैः परश्वधैः ।\nगदाभिः केचिदाघ्नन्ति शक्तिभिश्च तथा परे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006559020, "chapter_id": 26559, "verse_number": "३-९८-२१", "content_sanskrit": "निजघ्नुः सहसा रामं स्फुरन्तं पावकं यथा ।\nततः क्रुद्धो हली साक्षाद्धलमुद्यम्य सत्वरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006559021, "chapter_id": 26559, "verse_number": "३-९८-२२", "content_sanskrit": "सर्वानाकर्षयामास मुसलेन हि पीडयन् ।\nते हन्यमाना राजेन्द्र निषादाः पर्वताश्रयाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006559022, "chapter_id": 26559, "verse_number": "३-९८-२३", "content_sanskrit": "निपेतुर्धरणीपृष्ठे शतशोऽथ सहस्रशः ।\nक्षणेन तन्महाराज हत्वा सर्वान् महाबलान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006559023, "chapter_id": 26559, "verse_number": "३-९८-२४", "content_sanskrit": "सिंहवद् व्यनदंस्तत्र तस्थौ रामो महाबलः ।\nततो रात्रौ महाघोराः पिशाचाः पिशिताशनाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006559024, "chapter_id": 26559, "verse_number": "३-९८-२५", "content_sanskrit": "आकृष्य मांसयूथानि भक्षयन्तः समासते ।\nपिबन्तः शोणितं कोष्ठात् संछिद्य च शवं बहु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]