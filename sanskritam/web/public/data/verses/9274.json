[{"id": 40017918, "chapter_id": 9274, "verse_number": "1", "content_sanskrit": "अथतस्यामवस्थायांलक्ष्मणंरावणानुजः । परेषामहितंवाक्यमर्थसाधकमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017919, "chapter_id": 9274, "verse_number": "2", "content_sanskrit": "यदेतद्राक्षसानीकंमेघश्यामंविलोक्यते । एतदायोध्यतांशीघ्रंकपिभिपादपायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017920, "chapter_id": 9274, "verse_number": "3", "content_sanskrit": "अस्यानीकस्यमहतोभेदनेयतलक्ष्मण । राक्षसेन्द्रसुतोऽप्यत्रभिन्नेदृश्योभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017921, "chapter_id": 9274, "verse_number": "4", "content_sanskrit": "सत्वमिन्द्राशनिप्रख्यैःशरैरवकिरन्परान् । अभिद्रवाशुयावद्वैनैतत्कर्मसमाप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017922, "chapter_id": 9274, "verse_number": "5", "content_sanskrit": "ज हिवीरदुरात्मानंमायापरमधार्मिकम् । रावणिंक्रूरकर्माणंसर्वलोकभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017923, "chapter_id": 9274, "verse_number": "6", "content_sanskrit": "विभीषणवच्श्रुत्वालक्ष्मणश्शुभलक्षणः । ववर्षशरवर्षाणिराक्षसेन्द्रसुतंप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017924, "chapter_id": 9274, "verse_number": "7", "content_sanskrit": "ऋक्षाःशाखामृगाश्चैवद्रुमद्रिनखयोधिनः । अभ्यधावन्तसहितास्तदनीकमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017925, "chapter_id": 9274, "verse_number": "8", "content_sanskrit": "राक्षसाश्चशितैर्भाणैरसिभिश्शक्तितोमरैः । उद्यदैससम् वर्तन्तसमरेकपिसैन्यजिघांसवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017926, "chapter_id": 9274, "verse_number": "9", "content_sanskrit": "स सम्प्रहारस्तुमुलःसञ्जज्ञेकपिरक्षसाम् । शब्देनमहतालङ्कांनादयन्वैसमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017927, "chapter_id": 9274, "verse_number": "10", "content_sanskrit": "शस्त्रश्चविविधाकारैश्शितैर्बाणैश्चपादपैः । उद्यतैर्गिरिशृङ्गैश्चघोरैराकाशमावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017928, "chapter_id": 9274, "verse_number": "11", "content_sanskrit": "तेराक्षसावानरेषुविकृताननबाहवः । निवेशयन्तःशस्त्राणिचक्रुस्तेसुमहद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017929, "chapter_id": 9274, "verse_number": "12", "content_sanskrit": "तथैवसकलैर्वृक्षैर्गिरिशृङ्गैश्चवानराः । अभिजघ्नुजघ्नुश्चसमरेराक्षसर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017930, "chapter_id": 9274, "verse_number": "13", "content_sanskrit": "ऋक्षवानरमुख्यैश्चमहाकायैर्महाबलैः । रक्षसांयुध्यमानानांमहद्भयमजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017931, "chapter_id": 9274, "verse_number": "14", "content_sanskrit": "स्वमनीकंविषण्णंतुश्रुत्वाशत्रुभिरर्दितम् । उदतिष्ठतदुर्दर्षः स कर्मण्यननुष्ठिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017932, "chapter_id": 9274, "verse_number": "15", "content_sanskrit": "वृक्षान्धकारान्निर्गम्यजातक्रोधः स रावणिः । आरुरोहरथंसज्जंपूर्वयुक्तंसुसंयतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017933, "chapter_id": 9274, "verse_number": "16", "content_sanskrit": "स भीमकार्मुकधरःकालमेघसमप्रभ: । रक्तास्यनयनोकृद्धोमभौमृत्युरिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017934, "chapter_id": 9274, "verse_number": "17", "content_sanskrit": "दृष्टवैवतुरथस्थंतंपर्यवर्तततद्बलम् । रक्षसांभीमवेगानांलक्ष्मणेनयुयुत्सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017935, "chapter_id": 9274, "verse_number": "18", "content_sanskrit": "तस्मिन् कालेतुहनूमानुद्यम्यसुदुरासदम् । धरणीधरसङ्काशोमहावृक्षमरिन्दमः ॥ स राक्षसानांतत्सैन्यंकालाग्निरिवनिर्दहन् । चकारबहुभिर्वक्षैर्निःसंज्ञंयुधिवानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017936, "chapter_id": 9274, "verse_number": "19", "content_sanskrit": "तस्मिन् कालेतुहनूमानुद्यम्यसुदुरासदम् । धरणीधरसङ्काशोमहावृक्षमरिन्दमः ॥ स राक्षसानांतत्सैन्यंकालाग्निरिवनिर्दहन् । चकारबहुभिर्वक्षैर्निःसंज्ञंयुधिवानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017937, "chapter_id": 9274, "verse_number": "20", "content_sanskrit": "विध्वंसन्तंतरसादृष्टवैवपवनात्मजम् । राक्षसानांसहस्राणिहनूमन्तमवाकिरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017938, "chapter_id": 9274, "verse_number": "21", "content_sanskrit": "शितशूलधराश्शूलैरसिभिश्चासिपाणयः । शक्तिहस्ताश्चभिश्शक्तिपट्टसै: पट्टसायुधाः ॥ परिघैश्चगदाभिश्चकुन्तैश्चशुभदर्शनैः । शतशश्चशतघ्नीभिरायसैरपिमुद्गरैः ॥ घोरैःपरशुभिश्चैवभिदनिपालैश्चराक्षसाः । मुष्टिभिर्वज्रकल्पैश्चतलैरशनिसन्निभैः ॥ अभिजघ्नुःसमासाद्यसमन्तात्पर्वतोपमम् । तेषामपि च सङ्ग्रुद्धश्चकारकदनंमहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017939, "chapter_id": 9274, "verse_number": "22", "content_sanskrit": "शितशूलधराश्शूलैरसिभिश्चासिपाणयः । शक्तिहस्ताश्चभिश्शक्तिपट्टसै: पट्टसायुधाः ॥ परिघैश्चगदाभिश्चकुन्तैश्चशुभदर्शनैः । शतशश्चशतघ्नीभिरायसैरपिमुद्गरैः ॥ घोरैःपरशुभिश्चैवभिदनिपालैश्चराक्षसाः । मुष्टिभिर्वज्रकल्पैश्चतलैरशनिसन्निभैः ॥ अभिजघ्नुःसमासाद्यसमन्तात्पर्वतोपमम् । तेषामपि च सङ्ग्रुद्धश्चकारकदनंमहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017940, "chapter_id": 9274, "verse_number": "23", "content_sanskrit": "शितशूलधराश्शूलैरसिभिश्चासिपाणयः । शक्तिहस्ताश्चभिश्शक्तिपट्टसै: पट्टसायुधाः ॥ परिघैश्चगदाभिश्चकुन्तैश्चशुभदर्शनैः । शतशश्चशतघ्नीभिरायसैरपिमुद्गरैः ॥ घोरैःपरशुभिश्चैवभिदनिपालैश्चराक्षसाः । मुष्टिभिर्वज्रकल्पैश्चतलैरशनिसन्निभैः ॥ अभिजघ्नुःसमासाद्यसमन्तात्पर्वतोपमम् । तेषामपि च सङ्ग्रुद्धश्चकारकदनंमहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017941, "chapter_id": 9274, "verse_number": "24", "content_sanskrit": "शितशूलधराश्शूलैरसिभिश्चासिपाणयः । शक्तिहस्ताश्चभिश्शक्तिपट्टसै: पट्टसायुधाः ॥ परिघैश्चगदाभिश्चकुन्तैश्चशुभदर्शनैः । शतशश्चशतघ्नीभिरायसैरपिमुद्गरैः ॥ घोरैःपरशुभिश्चैवभिदनिपालैश्चराक्षसाः । मुष्टिभिर्वज्रकल्पैश्चतलैरशनिसन्निभैः ॥ अभिजघ्नुःसमासाद्यसमन्तात्पर्वतोपमम् । तेषामपि च सङ्ग्रुद्धश्चकारकदनंमहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017942, "chapter_id": 9274, "verse_number": "25", "content_sanskrit": "स ददर्शकपिश्रेष्ठमचलोपममिन्द्रजित् । सूदमानमसन्त्रस्तममित्रान् पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017943, "chapter_id": 9274, "verse_number": "26", "content_sanskrit": "स सारथिमुवाचेदंयाहियत्रैषवानरः । क्षयमेवहिनःकुर्याद्राक्षसामुपेक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017944, "chapter_id": 9274, "verse_number": "27", "content_sanskrit": "इत्युक्तस्सारथिस्तेनययौयत्र न मारुतिः । वहन् परमदुर्धर्षंस्थितमिन्द्रजितंरथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017945, "chapter_id": 9274, "verse_number": "28", "content_sanskrit": "सोऽभ्युपेत्यशरान्खङ्गान्पट्टसासिपरश्वधान् । अभ्यवर्षतदुर्धर्षःकपिमूर्थनिराक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017946, "chapter_id": 9274, "verse_number": "29", "content_sanskrit": "तानिशस्त्राणिघोराणिप्रतिगृह्य स मारुतिः । रोषेणमहताविष्टोवाक्यंचेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017947, "chapter_id": 9274, "verse_number": "30", "content_sanskrit": "युध्यस्वयदिशूरोऽसिरावणात्मजदुर्मते । वायुपुत्रंसमासाद्य न जीवन् प्रतियास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017948, "chapter_id": 9274, "verse_number": "31", "content_sanskrit": "बाहुभ्यांसम्प्रतियुध्यस्वयदिमेद्वन्द्वमाहवे । वेगंसहस्वदुर्बुद्धेततस्त्वंरक्षसांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017949, "chapter_id": 9274, "verse_number": "32", "content_sanskrit": "हनूमन्तंजिघांसन्तंसमुद्यतशरासनम् । रावणात्मजमाचष्टे लक्ष्मणाय विभीषण: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017950, "chapter_id": 9274, "verse_number": "33", "content_sanskrit": "यस्सवासवनिर्जेतारावणस्यात्मसम्भवः । स एषरथमास्थायहनूमन्तंजिघांसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017951, "chapter_id": 9274, "verse_number": "34", "content_sanskrit": "तमप्रतिमसंस्थानैश्शरैश्शत्रुनिवारणैः । जीवितान्तकरैर्घोरैःसौमित्रेरावणिंजहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]