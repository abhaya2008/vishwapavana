[{"id": 5000274000, "chapter_id": 9274, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000274001, "chapter_id": 9274, "verse_number": "४-२-१", "content_sanskrit": "तौ तु दृष्ट्वा महात्मानौ भ्रातरौ रामलक्ष्मणौ।\nवरायुधधरौ वीरौ सुग्रीवः शङ्कितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000274002, "chapter_id": 9274, "verse_number": "४-२-२", "content_sanskrit": "उद्विग्नहृदयः सर्वा दिशः समवलोकयन्।\nन व्यतिष्ठत कस्मिंश्चिद् देशे वानरपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000274003, "chapter_id": 9274, "verse_number": "४-२-३", "content_sanskrit": "नैव चक्रे मनः स्थातुं वीक्षमाणौ महाबलौ।\nकपेः परमभीतस्य चित्तं व्यवससाद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000274004, "chapter_id": 9274, "verse_number": "४-२-४", "content_sanskrit": "चिन्तयित्वा स धर्मात्मा विमृश्य गुरुलाघवम्।\nसुग्रीवः परमोद्विग्नः सर्वैस्तैर्वानरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000274005, "chapter_id": 9274, "verse_number": "४-२-५", "content_sanskrit": "ततः स सचिवेभ्यस्तु सुग्रीवः प्लवगाधिपः।\nशशंस परमोद्विग्नः पश्यंस्तौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000274006, "chapter_id": 9274, "verse_number": "४-२-६", "content_sanskrit": "एतौ वनमिदं दुर्गं वालिप्रणिहितौ ध्रुवम्।\nछद्मना चीरवसनौ प्रचरन्ताविहागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000274007, "chapter_id": 9274, "verse_number": "४-२-७", "content_sanskrit": "ततः सुग्रीवसचिवा दृष्ट्वा परमधन्विनौ।\nजग्मुर्गिरितटात् तस्मादन्यच्छिखरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000274008, "chapter_id": 9274, "verse_number": "४-२-८", "content_sanskrit": "ते क्षिप्रमभिगम्याथ यूथपा यूथपर्षभम्।\nहरयो वानरश्रेष्ठं परिवार्योपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000274009, "chapter_id": 9274, "verse_number": "४-२-९", "content_sanskrit": "एवमेकायनगताः प्लवमाना गिरेर्गिरिम्।\nप्रकम्पयन्तो वेगेन गिरीणां शिखराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000274010, "chapter_id": 9274, "verse_number": "४-२-१०", "content_sanskrit": "ततः शाखामृगाः सर्वे प्लवमाना महाबलाः।\nबभञ्जुश्च नगांस्तत्र पुष्पितान् दुर्गमाश्रितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000274011, "chapter_id": 9274, "verse_number": "४-२-११", "content_sanskrit": "आप्लवन्तो हरिवराः सर्वतस्तं महागिरिम्।\nमृगमार्जारशार्दूलांस्त्रासयन्तो ययुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000274012, "chapter_id": 9274, "verse_number": "४-२-१२", "content_sanskrit": "ततः सुग्रीवसचिवाः पर्वतेन्द्रे समाहिताः।\nसंगम्य कपिमुख्येन सर्वे प्राञ्जलयः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000274013, "chapter_id": 9274, "verse_number": "४-२-१३", "content_sanskrit": "ततस्तु भयसंत्रस्तं वालिकिल्बिषशङ्कितम्।\nउवाच हनुमान् वाक्यं सुग्रीवं वाक्यकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000274014, "chapter_id": 9274, "verse_number": "४-२-१४", "content_sanskrit": "सम्भ्रमस्त्यज्यतामेष सर्वैर्वालिकृते महान्।\nमलयोऽयं गिरिवरो भयं नेहास्ति वालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000274015, "chapter_id": 9274, "verse_number": "४-२-१५", "content_sanskrit": "यस्मादुद्विग्नचेतास्त्वं विद्रुतो हरिपुङ्गव।\nतं क्रूरदर्शनं क्रूरं नेह पश्यामि वालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000274016, "chapter_id": 9274, "verse_number": "४-२-१६", "content_sanskrit": "यस्मात् तव भयं सौम्य पूर्वजात् पापकर्मणः।\nस नेह वाली दुष्टात्मा न ते पश्याम्यहं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000274017, "chapter_id": 9274, "verse_number": "४-२-१७", "content_sanskrit": "अहो शाखामृगत्वं ते व्यक्तमेव प्लवङ्गम।\nलघुचित्ततयाऽऽत्मानं न स्थापयसि यो मतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000274018, "chapter_id": 9274, "verse_number": "४-२-१८", "content_sanskrit": "बुद्धिविज्ञानसम्पन्न इङ्गितैः सर्वमाचर।\nनह्यबुद्धिं गतो राजा सर्वभूतानि शास्ति हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000274019, "chapter_id": 9274, "verse_number": "४-२-१९", "content_sanskrit": "सुग्रीवस्तु शुभं वाक्यं श्रुत्वा सर्वं हनूमतः।\nततः शुभतरं वाक्यं हनूमन्तमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000274020, "chapter_id": 9274, "verse_number": "४-२-२०", "content_sanskrit": "दीर्घबाहू विशालाक्षौ शरचापासिधारिणौ।\nकस्य न स्याद् भयं दृष्ट्वा ह्येतौ सुरसुतोपमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000274021, "chapter_id": 9274, "verse_number": "४-२-२१", "content_sanskrit": "वालिप्रणिहितावेव शङ्केऽहं पुरुषोत्तमौ।\nराजानो बहुमित्राश्च विश्वासो नात्र हि क्षमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000274022, "chapter_id": 9274, "verse_number": "४-२-२२", "content_sanskrit": "अरयश्च मनुष्येण विज्ञेयाश्छद्मचारिणः।\nविश्वस्तानामविश्वस्ताश्छिद्रेषु प्रहरन्त्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000274023, "chapter_id": 9274, "verse_number": "४-२-२३", "content_sanskrit": "कृत्येषु वाली मेधावी राजानो बहुदर्शिनः।\nभवन्त परहन्तारस्ते ज्ञेयाः प्राकृतैर्नरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000274024, "chapter_id": 9274, "verse_number": "४-२-२४", "content_sanskrit": "तौ त्वया प्राकृतेनेव गत्वा ज्ञेयौ प्लवंगम।\nइङ्गितानां प्रकारैश्च रूपव्याभाषणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000274025, "chapter_id": 9274, "verse_number": "४-२-२५", "content_sanskrit": "लक्षयस्व तयोर्भावं प्रहृष्टमनसौ यदि।\nविश्वासयन् प्रशंसाभिरिङ्गितैश्च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000274026, "chapter_id": 9274, "verse_number": "४-२-२६", "content_sanskrit": "ममैवाभिमुखं स्थित्वा पृच्छ त्वं हरिपुङ्गव।\nप्रयोजनं प्रवेशस्य वनस्यास्य धनुर्धरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000274027, "chapter_id": 9274, "verse_number": "४-२-२७", "content_sanskrit": "शुद्धात्मानौ यदि त्वेतौ जानीहि त्वं प्लवङ्गम।\nव्याभाषितैर्वा रूपैर्वा विज्ञेया दुष्टतानयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000274028, "chapter_id": 9274, "verse_number": "४-२-२८", "content_sanskrit": "इत्येवं कपिराजेन संदिष्टो मारुतात्मजः।\nचकार गमने बुद्धिं यत्र तौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000274029, "chapter_id": 9274, "verse_number": "४-२-२९", "content_sanskrit": "तथेति सम्पूज्य वचस्तु तस्य\nकपेः सुभीतस्य दुरासदस्य।\nमहानुभावो हनुमान् ययौ तदा\nस यत्र रामोऽतिबली सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000274030, "chapter_id": 9274, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]