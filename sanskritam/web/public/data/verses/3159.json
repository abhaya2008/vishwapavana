[{"id": 2100605, "chapter_id": 3159, "verse_number": "१४-१५-१", "content_sanskrit": "`वैशम्पायन उवाच।\nस समाश्वास्य पितरं प्रज्ञाचक्षुषमीश्वरम्।\nअन्वशासत धर्मात्मा पृथिवीं भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100606, "chapter_id": 3159, "verse_number": "१४-१५-२", "content_sanskrit": "यथा मनुर्महाराजो रामो दाशरथिर्यथा।\nतथा भरतसिंहोऽपि पालयामास मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100607, "chapter_id": 3159, "verse_number": "१४-१५-३", "content_sanskrit": "नाधर्म्यमभवत्तत्र सर्वो धर्मरुचिर्जनः।\nबभूव नरशार्दूल यथा कृतयुगे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100608, "chapter_id": 3159, "verse_number": "१४-१५-४", "content_sanskrit": "कलिमासन्नमाविष्टं निवार्य नृपनन्दनः।\nभ्रातृभिः सहितो धीमान्बभौ धर्मबलोद्धतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100609, "chapter_id": 3159, "verse_number": "१४-१५-५", "content_sanskrit": "ववर्ष भगवान्देवः काले देशे यथेप्सितम्।\nनिरामयं जगदभूत्क्षुत्पिपासे न किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100610, "chapter_id": 3159, "verse_number": "१४-१५-६", "content_sanskrit": "आधिर्नास्ति मनुष्याणां व्यसने नाभवन्मतिः।\nब्राह्म्णप्रमुखा वर्णास्ते स्वधर्मोत्तराः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100611, "chapter_id": 3159, "verse_number": "१४-१५-७", "content_sanskrit": "धर्मसत्यप्रधानाश्च सत्यं सद्विषयान्वितम्।\nधर्मासनस्थः सद्भिः स स्त्रीबालातुरवृद्धकान्।\nवर्णक्रमान्पूर्णभृतान्साकल्याद्रक्षणोद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100612, "chapter_id": 3159, "verse_number": "१४-१५-८", "content_sanskrit": "अवृत्तिवृत्तिदानाद्यैर्यज्ञाद्यैर्व्याधितैरपि।\nआमुष्मिकं भयं नास्ति लौकिकं कृतमेव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100613, "chapter_id": 3159, "verse_number": "१४-१५-९", "content_sanskrit": "स्वर्गलोकोपमो लोकस्तदा तस्मिन्प्रशासति।\nबभूव सुखमेवाग्रं तद्विशिष्टतरं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100614, "chapter_id": 3159, "verse_number": "१४-१५-१०", "content_sanskrit": "नार्यः पतिव्रताः सर्वा रूपवत्यः स्वलंकृताः।\nयथोक्तवृत्ताः स्वगुणैर्बभूवुः प्रीतिहेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100615, "chapter_id": 3159, "verse_number": "१४-१५-११", "content_sanskrit": "पुमांसः पुण्यशीलाढ्याः स्वंस्वं धर्ममनुव्रताः।\nसुखिनः सूक्ष्ममप्येनो न कुर्वन्ति कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100616, "chapter_id": 3159, "verse_number": "१४-१५-१२", "content_sanskrit": "सर्वे नरांश्च नार्यश्च सततं प्रियवादिनः।\nअजिह्ममनसः शुक्ला बभूवुः श्रमवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100617, "chapter_id": 3159, "verse_number": "१४-१५-१३", "content_sanskrit": "भूषिताः कुण्डलैर्हारैः कटकैः कटिसूत्रकैः।\nसुवाससः सुगन्धाढ्याः प्रायशः पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100618, "chapter_id": 3159, "verse_number": "१४-१५-१४", "content_sanskrit": "सर्वे ब्रह्मविदो विप्राः सर्वत्र परिनिष्ठिताः।\nवलीपलितहीनास्तु सुखिनो दीर्घदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100619, "chapter_id": 3159, "verse_number": "१४-१५-१५", "content_sanskrit": "इच्छा न जायतेऽन्यत्र वर्णेषु न च सङ्करः।\nमनुष्याणां महाराज मर्यादा सुव्यवस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100620, "chapter_id": 3159, "verse_number": "१४-१५-१६", "content_sanskrit": "तस्मिञ्शासति राजेन्द्रे मृगव्यालसरीसृपाः।\nअन्योन्यमपि चान्येषु न बाधन्ते कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100621, "chapter_id": 3159, "verse_number": "१४-१५-१७", "content_sanskrit": "गावः सुक्षीरभूयिष्ठाः सुस्ववालमुखोदराः।\nअपीडिताः कर्षकाद्यैर्हृतव्याधिकवत्सकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100622, "chapter_id": 3159, "verse_number": "१४-१५-१८", "content_sanskrit": "अवन्ध्यकाला मनुजाः पुरुषार्थेषु च क्रमात्।\nविषयेष्वनिषिद्धेषु वेदशास्त्रेषु चोद्यताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100623, "chapter_id": 3159, "verse_number": "१४-१५-१९", "content_sanskrit": "सुवृत्ता वृषभाः पुष्टा रसनाभाः सुखोदयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100624, "chapter_id": 3159, "verse_number": "१४-१५-२०", "content_sanskrit": "अतीव मधुरः शब्दः स्पर्शश्चातिसुखं रसम्।\nकरूपं दृष्टिक्षमं रम्यं मनोज्ञं गन्धवद्बभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100625, "chapter_id": 3159, "verse_number": "१४-१५-२१", "content_sanskrit": "धर्मार्थकामसंयुक्तं मोक्षाभ्युदयसाधनम्।\nप्रह्लादजननं पुण्यं सम्बभूवाथ मानसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100626, "chapter_id": 3159, "verse_number": "१४-१५-२२", "content_sanskrit": "स्थावरा बहुपुष्पाढ्याः फलच्छायावहास्तथा।\nसुस्पर्शा विषहीनाश्च सुपत्रत्वक्प्ररोहिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100627, "chapter_id": 3159, "verse_number": "१४-१५-२३", "content_sanskrit": "मनोनुकूलाः सर्वेषां चेष्टाभूतापवर्जिताः।\nतथा बभूव राजर्षिस्तद्वृत्तमभवद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100628, "chapter_id": 3159, "verse_number": "१४-१५-२४", "content_sanskrit": "सर्वलक्षणसम्पन्नाः पाण्डवा धर्मचारिणः।\nज्येष्ठानुवर्तिनः सर्वे बभूवुः प्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100629, "chapter_id": 3159, "verse_number": "१४-१५-२५", "content_sanskrit": "सिंहोरस्का जितक्रोधास्तेजोबलसमन्विताः।\nआजानुबाहवः सर्वे दानशीला जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100630, "chapter_id": 3159, "verse_number": "१४-१५-२६", "content_sanskrit": "तेषु शासत्सु धरणीमृतवः स्वगुणैर्बभुः।\nसुखोदयाय वर्तन्ते ग्रहास्तारागणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100631, "chapter_id": 3159, "verse_number": "१४-१५-२७", "content_sanskrit": "मही च सस्यबहुला सर्वरत्नगुणोदया।\nकामधुग्धेनुवद्भोगान्फलन्ति स्म सहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100632, "chapter_id": 3159, "verse_number": "१४-१५-२८", "content_sanskrit": "मन्वादिभिः कृताः पूर्वं मर्यादा मानवेषु याः।\nअनतिक्रम्य ताः सर्वाः कुलेषु समयानि च।\nअन्वशासत राजानो धर्मपुत्रप्रियंकराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100633, "chapter_id": 3159, "verse_number": "१४-१५-२९", "content_sanskrit": "महाकुलानि धर्मिष्ठा वर्धयन्तो विशेषतः।\nमनुप्रणीतया वृत्त्या तेऽन्वशासनसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100634, "chapter_id": 3159, "verse_number": "१४-१५-३०", "content_sanskrit": "राजवृत्तिर्हि सा शश्वद्धर्मिष्ठाऽभून्महीतले।\nप्रायो लोकमतिस्तान राजवृत्तानुगामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100635, "chapter_id": 3159, "verse_number": "१४-१५-३१", "content_sanskrit": "एवं भारतवर्षं स्वं राजा स्वर्गं सुरेन्द्रवत्।\nशशास जिष्णुना सार्धं गोत्रां गाण्डीवधन्वन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100636, "chapter_id": 3159, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि पञ्चदशोऽध्यायः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]