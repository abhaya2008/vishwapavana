[{"id": 2033858, "chapter_id": 1732, "verse_number": "४-५५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033859, "chapter_id": 1732, "verse_number": "४-५५-१", "content_sanskrit": "तमदूरमुपायान्तं दृष्ट्वा पाण्डवमर्जुनम् ।\nनारयः प्रेक्षितुं शेकुस्तपन्तं हि यथा रविम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033860, "chapter_id": 1732, "verse_number": "४-५५-२", "content_sanskrit": "स तं दृष्ट्वा रथानीकं पार्थः सारथिमब्रवीत् ।\nइषुपातमात्रे सेनायाः स्थापयाश्वानरिंदम।\nयावत्समीक्षे व्यूहेऽस्मिन्मम शत्रुं सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033861, "chapter_id": 1732, "verse_number": "४-५५-३", "content_sanskrit": "रक्तवैडूर्यविकृतं मणिप्रवरभूषितम् ।\nपरं जानाम्यहं तस्य ध्वजं दूरात्समुच्छ्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033862, "chapter_id": 1732, "verse_number": "४-५५-४", "content_sanskrit": "यद्येनमिह पश्यामि दुर्बुद्धिमतिमानिनम् ।\nयमाय प्रेषयिष्यामि सहायः स्याद्यदीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033863, "chapter_id": 1732, "verse_number": "४-५५-५", "content_sanskrit": "सर्वानन्याननादृत्य दृष्ट्वा तमतिमानिनम् ।\nसिंहः क्षुद्रमृगस्येव पतिष्ये तस्य मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033864, "chapter_id": 1732, "verse_number": "४-५५-६", "content_sanskrit": "हनिष्यामि तमेवाद्य शरैर्गाण्डीवनिःसृतैः ।\nतस्मिन्हते भविष्यन्ति सर्व एव पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033865, "chapter_id": 1732, "verse_number": "४-५५-७", "content_sanskrit": "शरैश्च शमयिष्येऽहं धार्तराष्ट्रं ससौबलम् ।\nअसभ्यानां च वक्तारं कुरूणां किल किल्विषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033866, "chapter_id": 1732, "verse_number": "४-५५-८", "content_sanskrit": "राजानं नेह पश्यामि निरापिषमिदं बलम्।\nअभिद्रेव ह राजानं व्यक्तमित्यत्र निर्भयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033867, "chapter_id": 1732, "verse_number": "४-५५-९", "content_sanskrit": "आस्थितो मध्यमाचार्योप्यश्वत्थामाऽप्यनन्तरम्।\nकृपकर्णौ पुरस्तात्तु महेष्वासौ व्यवस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033868, "chapter_id": 1732, "verse_number": "४-५५-१०", "content_sanskrit": "भूरिश्रवाः सोमदत्तो बाह्लीकश्च जयद्रथः ।\nदक्षिणं पक्षमाश्रित्य स्थिता युद्धविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033869, "chapter_id": 1732, "verse_number": "४-५५-११", "content_sanskrit": "साल्वराजो द्युमत्सेनो वृषसेनश्च सौबलः।\nदशार्णश्चैव कालिङ्गो वामं पक्षं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033870, "chapter_id": 1732, "verse_number": "४-५५-१२", "content_sanskrit": "पृष्ठतः कुरुमुख्यश्च भीष्मस्तिष्ठति दंशितः।\nसोऽर्धसैन्येन बलवान्सर्वेषां नः पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033871, "chapter_id": 1732, "verse_number": "४-५५-१३", "content_sanskrit": "दुर्योधनं न पश्यामि क्व नु राजा स तिष्ठति।\nउत्सृंज्यैतद्रथानीकं याहि यत्र सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033872, "chapter_id": 1732, "verse_number": "४-५५-१४", "content_sanskrit": "तं हत्वा संनिवर्तिष्ये गाः स आदाय गच्छति।\nगवाग्रमभितो याहि यत्र राजा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033873, "chapter_id": 1732, "verse_number": "४-५५-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033874, "chapter_id": 1732, "verse_number": "४-५५-१५", "content_sanskrit": "इत्युक्त्वा समरे पार्थो वैराटिमपराजितः।\nसंस्पृशानो धनुर्दिव्यं त्वरमाणोऽगमत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033875, "chapter_id": 1732, "verse_number": "४-५५-१६", "content_sanskrit": "ततो भीष्मोऽब्रवीद्वाक्यं कुरुमध्ये परंतपः।\nचिरदृष्टोऽयमस्माभिर्धर्मज्ञो बान्धवप्रियः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033876, "chapter_id": 1732, "verse_number": "४-५५-१७", "content_sanskrit": "अतीव ज्वलते लक्ष्म्या पाकशासनिरागतः।\nएष दुर्योधनं पार्थो मार्गते निकृतिं स्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033877, "chapter_id": 1732, "verse_number": "४-५५-१८", "content_sanskrit": "सेनामत्यर्थमालोक्य त्वरते ग्रहणेऽस्य च।\nमृगं सिंह इवादातुमीक्षते पाकशासनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033878, "chapter_id": 1732, "verse_number": "४-५५-१९", "content_sanskrit": "नैषोऽन्तरेण राजानं बीभत्सुः स्थातुमर्हति।\nतस्य पार्ष्णि ग्रहीष्यामो जवेनाभिप्रधावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033879, "chapter_id": 1732, "verse_number": "४-५५-२०", "content_sanskrit": "न ह्येनमभिसंक्रुद्धमेको युद्ध्येत संयुगे।\nअन्यो देवान्महादेवात्कृष्णाद्वा देवकीसुतात्।\nआचार्याच्च सपुत्राद्वा भारद्वाजान्महारथात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033880, "chapter_id": 1732, "verse_number": "४-५५-२१", "content_sanskrit": "किं नो गावः करिष्यन्ति द्रव्यं वा विपुलं तथा।\nदुर्योधनः पार्थगतः पुरा प्राणान्विमुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033881, "chapter_id": 1732, "verse_number": "४-५५-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033882, "chapter_id": 1732, "verse_number": "४-५५-२२", "content_sanskrit": "इत्युक्त्वा समरे भीष्मः सेनया सह कौरवः।\nअन्वधावत्तदा पार्थं धार्तराष्ट्रस्य रक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033883, "chapter_id": 1732, "verse_number": "४-५५-२३", "content_sanskrit": "विक्रोशमात्रं यात्वा तु पार्थो वैराटिमब्रवीत्।\nइषुपातमात्रे सेनायाः स्थापयाश्वानरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033884, "chapter_id": 1732, "verse_number": "४-५५-२४", "content_sanskrit": "एतदग्रं गवां दृष्टं मन्दं वाहय सारथे।\nयाह्युत्तरेण सेनाया गाश्चैव प्रविभज्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033885, "chapter_id": 1732, "verse_number": "४-५५-२५", "content_sanskrit": "परिक्षिप्य गवां यूथमत्र योत्स्ये सुयोधनम् ।\nगच्छन्ति सत्वरा गावः सगोपाः परिमोचय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033886, "chapter_id": 1732, "verse_number": "४-५५-२६", "content_sanskrit": "तत्र गत्वा पशून्वीर सगोपान्परिमोचय।\nअन्तरेण च सेनायाः प्राङ्मुखो गच्छ चोत्तर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033887, "chapter_id": 1732, "verse_number": "४-५५-२७", "content_sanskrit": "इमे त्वतिरथाः सर्वे मम वीर्यपराक्रमम्।\nपश्यन्तु कुरवो युद्धे महेन्द्रस्येव दानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033888, "chapter_id": 1732, "verse_number": "४-५५-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033889, "chapter_id": 1732, "verse_number": "४-५५-२८", "content_sanskrit": "ततः स रथिनां श्रेष्ठो नाम विश्राव्य चात्मनः।\nनिशिताग्राञ्शरांस्तीक्ष्णान्मुमोचांतकसन्निभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033890, "chapter_id": 1732, "verse_number": "४-५५-२९", "content_sanskrit": "शलभैरिव चाकाशं धाराभिरिव पर्वतम्।\nनिरावकाशमभवच्छरैः क्षिप्तैः किरीटिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033891, "chapter_id": 1732, "verse_number": "४-५५-३०", "content_sanskrit": "विकीर्यमाणास्तु शरैस्ते योधा धार्तराष्ट्रिकाः।\nगाश्चैव न च पश्यन्ति पार्थमुक्तैरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033892, "chapter_id": 1732, "verse_number": "४-५५-३१", "content_sanskrit": "सा चापि बहुला सेना पार्थबाणाभिपीडिता।\nनापश्यद्विवृतां भूमिं नान्तरिक्षं दिशोपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033893, "chapter_id": 1732, "verse_number": "४-५५-३२", "content_sanskrit": "अर्जुनस्तु तदा हृष्टो दर्शयन्वीर्यमात्मनः।\nपीडयामास सैन्यानि गाण्डीवप्रसृतैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033894, "chapter_id": 1732, "verse_number": "४-५५-३३", "content_sanskrit": "तेषां नैवापयाने च नाभियाने भवन्मतिः ।\nशीघ्रतामेव पार्थस्य पूजयन्तस्तु विस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033895, "chapter_id": 1732, "verse_number": "४-५५-३४", "content_sanskrit": "चन्द्रावदातं सामुद्रं कुरुसैन्यभयंकरम्।\nततः शङ्खमुपाध्मासीद्द्विषतां रोमहर्षणम्।\nज्याघोषं तलघोषं च कृत्वा भूतान्यमोहयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033896, "chapter_id": 1732, "verse_number": "४-५५-३५", "content_sanskrit": "तस्य शङ्खस्य शब्देन धनुषो निस्वनेन च।\nशब्देनामानुषाणां च भूतानां ध्वजवासिनाम् ।\nवियद्गतानां देवानां मानुषाणां रवेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033897, "chapter_id": 1732, "verse_number": "४-५५-३६", "content_sanskrit": "ऊर्ध्वं पुच्छं विधून्वाना हेममाणाः समन्ततः ।\nगावः सवत्साः संत्रस्ता निवृत्ता दक्षिणां दिशं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033898, "chapter_id": 1732, "verse_number": "४-५५-३७", "content_sanskrit": "ततः स समरे शूरो बीभत्सुः शत्रुपूगहा।\nगोपालांश्चोदयामास गावश्चोदयतेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033899, "chapter_id": 1732, "verse_number": "४-५५-३८", "content_sanskrit": "उत्तरं चाह बीभत्सुर्हर्षयन्पाण्डुनन्दनः ।\nगवामग्रं समीक्षस्व गश्चैवाशु निवर्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033900, "chapter_id": 1732, "verse_number": "४-५५-३९", "content_sanskrit": "यावदेते निवर्तन्ते कुरवो जवमास्थिताः ।\nयाह्युत्तरेण गाश्चैताः सैन्यानां च नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033901, "chapter_id": 1732, "verse_number": "४-५५-४०", "content_sanskrit": "पश्यन्तु कुरवः सर्वे मम वीर्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033902, "chapter_id": 1732, "verse_number": "४-५५-४१x", "content_sanskrit": "वैशम्पायन उवाच।\nते लाभमिव मन्वानाः कुरवोऽर्जुनमाहव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2033903, "chapter_id": 1732, "verse_number": "४-५५-४१", "content_sanskrit": "दृष्टवा यान्तमदूरस्थं क्षिप्रमभ्यपतन्रथैः ॥\nहस्त्यश्वपरिवारेण महताऽभिविराजता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2033904, "chapter_id": 1732, "verse_number": "४-५५-४२", "content_sanskrit": "योधैः प्रासासिहस्तैश्च चापबाणोद्यतायुधैः ॥\nतान्यनीकान्यशोभन्त कुरूणामाततायिनाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2033905, "chapter_id": 1732, "verse_number": "४-५५-४३", "content_sanskrit": "संसर्पन्त इवाकाशे विद्युत्वन्तो वलाहकाः ॥\nतानि दृष्ट्वाऽप्यनीकानि निवर्तितरथानि च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2033906, "chapter_id": 1732, "verse_number": "४-५५-४४", "content_sanskrit": "पार्थोऽपि वायुवद्धोरं सैन्याग्रं व्यधुनोच्छरैः ॥\nतां शत्रुसेनां तरसा प्रणुद्य गाश्चापि जित्वा धनुषा परेण।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2033907, "chapter_id": 1732, "verse_number": "४-५५-४५", "content_sanskrit": "दुर्योधनायाभिमुखं प्रयान्तं कुरुप्रवीराः सहसाऽभ्यगच्छन् ॥\nगोषु प्रयातासु जवेन मात्स्यान्किरीटिनं प्रीतियुतं च दृष्ट्वा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2033908, "chapter_id": 1732, "verse_number": "४-५५-४६", "content_sanskrit": "पशून्समादाय ततो निवृत्ता गोपाः समस्ताः प्रययुश्च राष्ट्रम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2033909, "chapter_id": 1732, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि पञ्चपञ्चासोऽध्यायः ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]