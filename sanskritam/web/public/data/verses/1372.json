[{"id": 2017880, "chapter_id": 1372, "verse_number": "३-१०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017881, "chapter_id": 1372, "verse_number": "३-१०-१", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथा वदसि मां मुने।\nअहं चैव विजानामि सर्वे चेमे नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017882, "chapter_id": 1372, "verse_number": "३-१०-२", "content_sanskrit": "भवांश्च मन्यते साधु यत्कुरूणां सुखोदयम्।\nतदेव विदुरोऽप्याह भीष्मो द्रोणश्च मां मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017883, "chapter_id": 1372, "verse_number": "३-१०-३", "content_sanskrit": "यदित्वहमनुग्राह्यः कौरव्येषु दया यदि।\nअन्वशाधि दुरात्मानं पुत्रं दुर्योधनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017884, "chapter_id": 1372, "verse_number": "३-१०-४x", "content_sanskrit": "व्यास उवाच.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017885, "chapter_id": 1372, "verse_number": "३-१०-४", "content_sanskrit": "अयमायाति वै राजन्मैत्रेयो भगवानृषिः।\nअन्वीक्ष्य पाण्डवान्भ्रातृनिहैवाऽस्मद्दिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017886, "chapter_id": 1372, "verse_number": "३-१०-५", "content_sanskrit": "एष दुर्योधनं पुत्रं तव राजन्महानृषिः।\nअनुशास्ता यथान्यायं शमायास्य कुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017887, "chapter_id": 1372, "verse_number": "३-१०-६", "content_sanskrit": "ब्रूयाद्यदेष कौरव्य तत्कार्यमविशङ्कया।\nअक्रियायां तु कार्यस्य पुत्रं ते शप्स्यते रुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017888, "chapter_id": 1372, "verse_number": "३-१०-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017889, "chapter_id": 1372, "verse_number": "३-१०-७", "content_sanskrit": "एवमुक्त्वा ययौ व्यासो मैत्रेयः प्रत्यदृश्यत।\nपूजया प्रतिजग्राह सपुत्रस्तं नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017890, "chapter_id": 1372, "verse_number": "३-१०-८", "content_sanskrit": "कृत्वाऽर्ध्याद्याः क्रियाः सर्वा विश्रान्तं मुनिसत्तमम्\nप्रश्रयेणाब्रवीद्राजा धृतराष्ट्रोऽम्बिकासुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017891, "chapter_id": 1372, "verse_number": "३-१०-९", "content_sanskrit": "सुखेनागमनं कच्चिद्भगवन्कुरुजाङ्गले।\nकच्चित्कुशलिनो वीरा भ्रातरः पञ्च पाण्डवाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017892, "chapter_id": 1372, "verse_number": "३-१०-१०", "content_sanskrit": "समये स्थातुमिच्छन्ति कच्चिच्च भरतर्षभाः।\nकच्चित्कुरूणां सौभ्रात्रमव्युच्छिन्नं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017893, "chapter_id": 1372, "verse_number": "३-१०-११x", "content_sanskrit": "मैत्रेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017894, "chapter_id": 1372, "verse_number": "३-१०-११", "content_sanskrit": "तीर्थयात्रामनुक्रामन्प्राप्तोऽस्मि कुरुजाङ्गलान्।\nयदृच्छया धर्मराजं दृष्ट्ववान्काम्यके वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017895, "chapter_id": 1372, "verse_number": "३-१०-१२", "content_sanskrit": "तं जटाजिनसंवीतं तपोवननिवासिनम्।\nसमाजग्मुर्महात्मानं द्रष्टुं मुनिगणाः प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017896, "chapter_id": 1372, "verse_number": "३-१०-१३", "content_sanskrit": "तत्राश्रौषं महाराज पुत्राणां तव विग्रहम्।\nअनयं द्यूतरूपेण महाभयमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017897, "chapter_id": 1372, "verse_number": "३-१०-१४", "content_sanskrit": "ततोऽहं त्वामनुप्राप्तः कौरवाणामवेक्षया ॥\nसदा ह्यभ्यधिकः स्नेहः प्रीतिश्च त्वयि मे प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017898, "chapter_id": 1372, "verse_number": "३-१०-१५", "content_sanskrit": "नैतदौपयिकं राजंस्त्वयि भीष्मे च जीवति।\nयदन्योन्येन ते पुत्रा विरुध्यन्ते कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017899, "chapter_id": 1372, "verse_number": "३-१०-१६", "content_sanskrit": "मेढीभूतः स्वयं राजन्निग्रहे प्रग्रहे भवान्।\nकिमर्थमनयं घोरमुत्पतन्तमुपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017900, "chapter_id": 1372, "verse_number": "३-१०-१७", "content_sanskrit": "दस्यूनामिव यद्वृत्तं सभायां कुरुनन्दन।\nतेन न भ्राजसे राजंस्तापसानां समागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017901, "chapter_id": 1372, "verse_number": "३-१०-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017902, "chapter_id": 1372, "verse_number": "३-१०-१८", "content_sanskrit": "ततो व्यावृत्य राजानं दुर्योधनममर्षणम्।\nउवाच श्लक्ष्णया वाचा मैत्रेयो भगवानृपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017903, "chapter_id": 1372, "verse_number": "३-१०-१९x", "content_sanskrit": "मैत्रेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017904, "chapter_id": 1372, "verse_number": "३-१०-१९", "content_sanskrit": "दुर्योधन महाबाहो निबोध वदतां वर।\nवचनं मे महाभाग ब्रुवतो यद्धितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017905, "chapter_id": 1372, "verse_number": "३-१०-२०", "content_sanskrit": "मा द्रुहः पाण्डवान्राजन्कुरुष्व हितमात्मनः।\nपाण्डवानां कुरूणां च लोकस्य च नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017906, "chapter_id": 1372, "verse_number": "३-१०-२१", "content_sanskrit": "पाण्डवान्प्राप्य तान्रात्रौ किर्मीरो नाम राक्षसः।\nअवृत्य मार्गं रौद्रात्मा तस्थौ गिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017907, "chapter_id": 1372, "verse_number": "३-१०-२२", "content_sanskrit": "तं भीमः समरस्लाघी बलेन बलिनां वरः।\nजघान पशुमारेण व्याघ्रः क्षुद्रमृगं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017908, "chapter_id": 1372, "verse_number": "३-१०-२३", "content_sanskrit": "पश्य दिग्विजये राजन्यथा भीमेन पातितः।\nजरासन्धो महेष्वासो नागायुतबलो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017909, "chapter_id": 1372, "verse_number": "३-१०-२४", "content_sanskrit": "संबन्धी वासुदेवश्च श्यालाः सर्वे च पार्षताः।\nते हि सर्वे नरव्याघ्राः शूरा विक्रान्तयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017910, "chapter_id": 1372, "verse_number": "३-१०-२५", "content_sanskrit": "सर्वे नागायुतप्राणा वज्रसंहनना दृढः।\nसत्यव्रतधराः सर्वेसर्वे पुरुषमानिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017911, "chapter_id": 1372, "verse_number": "३-१०-२६", "content_sanskrit": "हन्तारो देवशत्रूणां रक्षसां कामरूपिणाम्।\nहिडिम्बबकमुख्यानां किर्मीरस् च रक्षसः।\nकस्तान्युधि समासीत जरामरणवान्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017912, "chapter_id": 1372, "verse_number": "३-१०-२७", "content_sanskrit": "तस्य ते शम एवास्तु पाण्डवैर्भरतर्षभ।\nकुरु मे वचनं राजन्मा मृत्युवशमन्वगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017913, "chapter_id": 1372, "verse_number": "३-१०-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017914, "chapter_id": 1372, "verse_number": "३-१०-२८", "content_sanskrit": "एवं तु ब्रुवतस्तस्य मैत्रेयस्य विशांपते।\nऊरुं करिकराकारं करेणाभिजघान तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017915, "chapter_id": 1372, "verse_number": "३-१०-२९", "content_sanskrit": "दुर्योधनः स्मितं कृत्वा चरणेनोल्लिखन्महीम्।\nनकिंचिदुक्त्वा दुर्मेधास्तस्थौ किंचिदवाङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017916, "chapter_id": 1372, "verse_number": "३-१०-३०", "content_sanskrit": "तमशुश्रूषमाणं तु विलिखन्तं वसुंधराम्।\nदृष्ट्वा दुर्योधनं राजन्मैत्रेयं कोप आविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017917, "chapter_id": 1372, "verse_number": "३-१०-३१", "content_sanskrit": "स कोपवशमापन्नो मैत्रेयो मुनिसत्तमः।\nविधिना संप्रयुक्तश्च शापायास्य मनो दधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017918, "chapter_id": 1372, "verse_number": "३-१०-३२", "content_sanskrit": "ततः स वार्युपस्पृश्य कोपसंरक्तलोचनः।\nमैत्रेयो धार्तराष्ट्रं तमशपद्दुष्टचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017919, "chapter_id": 1372, "verse_number": "३-१०-३३", "content_sanskrit": "यस्मात्त्वं मामनादृत्य नेमां वाचं चिकीर्षसि।\nतस्मादस्यातिमानस्य सद्यः फलमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017920, "chapter_id": 1372, "verse_number": "३-१०-३४", "content_sanskrit": "त्वदभिद्रोहसंयुक्तं युद्धमुत्पत्स्यते महत्।\nयत्र भीमो गदाघातैस्तवोरुं भेत्स्यते बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017921, "chapter_id": 1372, "verse_number": "३-१०-३५", "content_sanskrit": "इत्येवमुक्ते वचने धृतराष्ट्रो महीपतिः।\nप्रसादयामास मुनिं नैतदेवं भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017922, "chapter_id": 1372, "verse_number": "३-१०-३६x", "content_sanskrit": "मैत्रेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017923, "chapter_id": 1372, "verse_number": "३-१०-३६", "content_sanskrit": "शमं यास्यति चेत्पुत्रस्तव राजन्यदा तदा।\nशायो न भविता तात विपरीते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017924, "chapter_id": 1372, "verse_number": "३-१०-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017925, "chapter_id": 1372, "verse_number": "३-१०-३७", "content_sanskrit": "सविलक्षस्तु राजेन्द्रो दुर्योधनपिता तदा।\nमैत्रेयं प्राह किर्मीरः कथं भीमेन पातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017926, "chapter_id": 1372, "verse_number": "३-१०-३८x", "content_sanskrit": "मैत्रेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017927, "chapter_id": 1372, "verse_number": "३-१०-३८", "content_sanskrit": "नाहं वक्ष्याम्यसूया ते न ते शुश्रूषते सुतः।\nएष ते विदुरः सर्वमाख्यास्यति गते मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017928, "chapter_id": 1372, "verse_number": "३-१०-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017929, "chapter_id": 1372, "verse_number": "३-१०-३९", "content_sanskrit": "इत्येवमुक्त्वा मैत्रेयः प्रातिष्ठत यथागतम्।\nकिर्मीरवधसंविग्नो भयं दुर्योधनो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017930, "chapter_id": 1372, "verse_number": "", "content_sanskrit": "॥ इतिश्रीमन्महाभारते अरण्यपर्वणि किर्मीरवधपर्वणि दशमोऽध्यायः ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]