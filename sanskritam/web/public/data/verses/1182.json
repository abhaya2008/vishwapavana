[{"id": 2009298, "chapter_id": 1182, "verse_number": "१-१८३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009299, "chapter_id": 1182, "verse_number": "१-१८३-१", "content_sanskrit": "एतच्छ्रुत्वा ततः सर्वे पाण्डवा भरतर्षभ।\nमनसा द्रौपदीं जग्मुरनङ्गशरपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009300, "chapter_id": 1182, "verse_number": "१-१८३-२", "content_sanskrit": "ततस्तां रजनीं राजञ्छल्यविद्धा इवाभवन्।\nसर्वे चास्वस्थमनसो बभूवुस्ते महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009301, "chapter_id": 1182, "verse_number": "१-१८३-३", "content_sanskrit": "ततः कुन्ती सुतान्दृष्ट्वा सर्वांस्तद्गतचेतसः।\nयुधिष्ठिरमुवाचेदं वचनं सत्यवादिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009302, "chapter_id": 1182, "verse_number": "१-१८३-४", "content_sanskrit": "चिररात्रोषिताः स्मेह ब्राह्मणस्य निवेशने।\nरममाणाः पुरे रम्ये लब्धभैक्षा महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009303, "chapter_id": 1182, "verse_number": "१-१८३-५", "content_sanskrit": "यानीह रमणीयानि वनान्युपवनानि च।\nसर्वाणि तानि दृष्टानि पुनःपुनररिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009304, "chapter_id": 1182, "verse_number": "१-१८३-६", "content_sanskrit": "पुनर्दृष्टानि तानीह प्रीणयन्ति न नस्तथा।\nभैक्षं च न तथा वीर लभ्यते कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009305, "chapter_id": 1182, "verse_number": "१-१८३-७", "content_sanskrit": "ते वयं साधु पञ्चालान्गच्छाम यदि मन्यसे।\nअपूर्वदर्शनं वीर रमणीयं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009306, "chapter_id": 1182, "verse_number": "१-१८३-८", "content_sanskrit": "सुभिक्षाश्चैव पञ्चालाः श्रूयन्ते शत्रुकर्शन।\nयज्ञसेनश्च राजाऽसौ ब्रह्मण्य इति सुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009307, "chapter_id": 1182, "verse_number": "१-१८३-९", "content_sanskrit": "एकत्र चिरवासश्च क्षमो न च मतो मम।\nते तत्र साधु गच्छामो यदि त्वं पुत्र मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009308, "chapter_id": 1182, "verse_number": "१-१८३-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009309, "chapter_id": 1182, "verse_number": "१-१८३-१०", "content_sanskrit": "भवत्या यन्मतं कार्यं तदस्माकं परं हितम्।\nअनुजांस्तु न जानामि गच्छेयुर्नेति वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009310, "chapter_id": 1182, "verse_number": "१-१८३-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009311, "chapter_id": 1182, "verse_number": "१-१८३-११", "content_sanskrit": "ततः कुन्ती भीमसेनमर्जुनं यमजौ तथा।\nउवाच गमनं ते च तथेत्येवाब्रुवंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009312, "chapter_id": 1182, "verse_number": "१-१८३-१२", "content_sanskrit": "तत आमन्त्र्य तं विप्रं कुन्ती राजसुतैः सह।\nप्रतस्थे नगरीं रम्यां द्रुपदस्य महात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009313, "chapter_id": 1182, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि त्र्यशीत्यधिकशततमोऽध्यायः॥ १८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]