[{"id": 2096352, "chapter_id": 3059, "verse_number": "१३-१८९-१", "content_sanskrit": "[भीष्म उवाच।\nकेन ते च भवेत्प्रीतिः कथं तुष्टिं तु गच्छसि।\nइति पृष्टः सुरेन्द्रेण प्रोवाच हरिरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096353, "chapter_id": 3059, "verse_number": "१३-१८९-२", "content_sanskrit": "ब्राह्मणानां परीवादो मम विद्वेषणं महत्।\nब्राह्मणैः पूजितैर्नित्यं पूजितोऽहं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096354, "chapter_id": 3059, "verse_number": "१३-१८९-३", "content_sanskrit": "नित्याभिवाद्या विप्रेन्द्रा भुक्त्वा पादौ तथाऽऽत्मनः।\nतेषां तुष्यामि मर्त्यानां यश्चक्रे च बलिं हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096355, "chapter_id": 3059, "verse_number": "१३-१८९-४", "content_sanskrit": "वामनं ब्राह्मणं दृष्ट्वा वराहं च जलोत्थितम्।\nउद्धृतां धरणीं चैव मूर्ध्ना धारयते तु यः।\nन तेषामशुभं किञ्चित्कल्मषं चोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096356, "chapter_id": 3059, "verse_number": "१३-१८९-५", "content_sanskrit": "अश्वत्थं रोचनां गां च पूजयेद्यो नरः सदा।\nपूजितं च जगत्तेन सदेवासुरमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096357, "chapter_id": 3059, "verse_number": "१३-१८९-६", "content_sanskrit": "तेन रूपेण तेषां च पूजां गृह्णामि तत्त्वतः।\nपूजा ममैषा नास्त्यन्या यावल्लोकाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096358, "chapter_id": 3059, "verse_number": "१३-१८९-७", "content_sanskrit": "अन्यथा हि वृथा मर्त्याः पूजयन्त्यल्पबुद्ध्यः।\nनाहं तत्प्रतिगृह्णामि न सा तुष्टिकरी मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096359, "chapter_id": 3059, "verse_number": "१३-१८९-८x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096360, "chapter_id": 3059, "verse_number": "१३-१८९-८", "content_sanskrit": "चक्रं पादौ वराहं च ब्राह्मणं चापि वामनम्।\nउद्धृतां धरणीं चैव किमर्थं त्वं प्रशंससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096361, "chapter_id": 3059, "verse_number": "१३-१८९-९", "content_sanskrit": "भवान्सृजति भूतानि भावन्संहरति प्रजाः।\nप्रकृतिः सर्वभूतानां समर्त्यानां सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096362, "chapter_id": 3059, "verse_number": "१३-१८९-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096363, "chapter_id": 3059, "verse_number": "१३-१८९-१०", "content_sanskrit": "सम्प्रहस्य ततो विष्णुरिदं वचनमब्रवीत्।\nचक्रेण निहता दैत्याः पद्म्यां क्रान्ता वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096364, "chapter_id": 3059, "verse_number": "१३-१८९-११", "content_sanskrit": "वाराहं रूपमास्थाय हिरण्याक्षो निपातितः।\nवामनं रूपमास्थाय जितो राजा मया बलिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096365, "chapter_id": 3059, "verse_number": "१३-१८९-१२", "content_sanskrit": "परितुष्टो भवाम्येवं मानुषाणां महात्मनाम्।\nतन्मां ये पूजयिष्यन्ति नास्ति तेषां पराभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096366, "chapter_id": 3059, "verse_number": "१३-१८९-१३", "content_sanskrit": "अपि वा ब्राह्म्णं दृष्ट्वा ब्रह्म चारिणमागतम्।\nब्राह्मणाग्र्याहुतिं दत्त्वा अमृतं तस्य भोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096367, "chapter_id": 3059, "verse_number": "१३-१८९-१४", "content_sanskrit": "ऐन्द्रीं संध्यामुपासित्वा आदित्याभिमुखः स्थितः।\nसर्वतीर्थेषु स स्नातो मुच्यते सर्वकिल्बिषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096368, "chapter_id": 3059, "verse_number": "१३-१८९-१५", "content_sanskrit": "एतद्वः कथितं गुह्यमखिलेनि तपोधनाः।\nसंशयं पृच्छमानानां किं भूयः कथयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096369, "chapter_id": 3059, "verse_number": "१३-१८९-१६x", "content_sanskrit": "बलदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096370, "chapter_id": 3059, "verse_number": "१३-१८९-१६", "content_sanskrit": "श्रूयतां परमं गुह्यं मानुषाणां सुखावहम्।\nअजानन्तो यदबुधाः क्लिश्यन्ते भूतपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096371, "chapter_id": 3059, "verse_number": "१३-१८९-१७", "content_sanskrit": "कल्य उत्थाय यो मर्त्यः स्पृशेद्गां वै घृतं दधि।\nसर्षपं च प्रियङ्गं च कल्मषात्प्रतिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096372, "chapter_id": 3059, "verse_number": "१३-१८९-१८", "content_sanskrit": "भूतानि चैव सर्वाणि अग्रतः पृष्ठतोपि वा।\nउच्छिष्टं वाऽपि च्छिद्रेषु वर्जयन्ति तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096373, "chapter_id": 3059, "verse_number": "१३-१८९-१९x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096374, "chapter_id": 3059, "verse_number": "१३-१८९-१९", "content_sanskrit": "प्रगृह्यौदुम्बरं पात्रं तोयपूर्णमुदङ्भुखः।\nउपवासं तु गृह्णीयाद्यद्वा सङ्कल्पयेद्व्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096375, "chapter_id": 3059, "verse_number": "१३-१८९-२०", "content_sanskrit": "देवतास्तस्य तुष्यन्ति कामिकं चापि सिध्यति।\nअन्यथा हि वृथा मर्त्याः कुर्वते स्वल्पबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096376, "chapter_id": 3059, "verse_number": "१३-१८९-२१", "content_sanskrit": "उपवासे बलौ चापि ताम्रपात्रं विशिष्यते।\nबलिर्भिक्षा तथाऽर्ध्यं च पितॄणां च तिलोदकं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096377, "chapter_id": 3059, "verse_number": "१३-१८९-२२", "content_sanskrit": "ताम्रपात्रेण दातव्यमन्यथाऽल्पफलं भवेत्।\nगुह्यमेतत्समुद्दिष्टं यथा तुष्यन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096378, "chapter_id": 3059, "verse_number": "१३-१८९-२३x", "content_sanskrit": "धर्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096379, "chapter_id": 3059, "verse_number": "१३-१८९-२३", "content_sanskrit": "राजपौरुषिके विप्रे घाण्टिके परिचारिके।\nगोरक्षके वाणिजके तथा कारुकुशीलवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096380, "chapter_id": 3059, "verse_number": "१३-१८९-२४", "content_sanskrit": "मित्रद्रुह्यनधीयाने यश्च स्याद्वृषलीपतिः।\nएतेषु दैवं पित्र्यं वा न देयं स्यात्कथञ्चन।\nपिण्डदास्तस्य हीयन्ते न च प्रीणाति वै पितॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096381, "chapter_id": 3059, "verse_number": "१३-१८९-२५", "content_sanskrit": "अतिथिर्यस्य भग्नाशो गृहात्प्रतिनिवर्तते।\nपितरस्तस्य देवाश्च अग्नयश्च तथैव हि।\nनिराशाः प्रतिगच्छन्ति अतिथेरप्रतिग्रहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096382, "chapter_id": 3059, "verse_number": "१३-१८९-२६", "content_sanskrit": "स्त्रीघ्नैर्गोघ्नैः कृतघ्नैश्च ब्रह्मघ्नैर्गुरुतल्पगैः।\nतुल्यदोषो भवत्येभिर्यस्यातिथितरनर्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096383, "chapter_id": 3059, "verse_number": "१३-१८९-२७x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096384, "chapter_id": 3059, "verse_number": "१३-१८९-२७", "content_sanskrit": "पादमुद्यम्य यो मर्त्यः स्पृशेद्गाश्च सुदुर्मतिः।\nब्राह्मणं वा महाभागं दीप्यमानं तथाऽनलम्।\nतस्य दोषान्प्रवक्ष्यामि तच्छृणुध्वं समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096385, "chapter_id": 3059, "verse_number": "१३-१८९-२८", "content_sanskrit": "दिवं स्पृशत्यशब्दोऽस्य त्रस्यन्ति पितरश्च वै।\nवैमनस्यं च देवानां कृतं भवति पुष्कलम्।\nपावकश्च महातेजा हव्यं न प्रतिगृह्णति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096386, "chapter_id": 3059, "verse_number": "१३-१८९-२९", "content_sanskrit": "आजन्मनां शतं चैव नरके पच्यते तु सः।\nनिष्कृतिं च न तस्यापि अनुमन्यन्ति कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096387, "chapter_id": 3059, "verse_number": "१३-१८९-३०", "content_sanskrit": "तस्माद्गावो न पादेन स्प्रष्टव्या वै कदाचन।\nब्राह्मणश्च महातेजा दीप्यमानस्तथाऽनलः।\nश्रद्दधानेन मर्त्येन आत्मनो हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096388, "chapter_id": 3059, "verse_number": "१३-१८९-३१", "content_sanskrit": "एते दोषा मया प्रोक्तास्त्रिषु यः पादमुत्सृजेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096389, "chapter_id": 3059, "verse_number": "१३-१८९-३२x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096390, "chapter_id": 3059, "verse_number": "१३-१८९-३२", "content_sanskrit": "श्रूयतां परमं गुह्यं रहस्यं धर्मसंहितम्।\nपरमान्नेन यो दद्यात्पितॄणामौपहारिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096391, "chapter_id": 3059, "verse_number": "१३-१८९-३३", "content_sanskrit": "गजच्छायायां पूर्वस्यां कुतपे दक्षिणामुखः।\nयदा भाद्रपदे मासि भवते बहुले मघा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096392, "chapter_id": 3059, "verse_number": "१३-१८९-३४", "content_sanskrit": "श्रूयतां तस्य दानस्य यादृशो गुणविस्तरः।\nकृतं तेन महच्छ्राद्धं वर्षाणीह त्रयोदश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096393, "chapter_id": 3059, "verse_number": "१३-१८९-३५", "content_sanskrit": "बहपल् समङ्गे ह्यकुतोभये च\nक्षेमे च संख्येव हि भूयसी च।\nयथा पुरा ब्रह्मपुरे सवत्सा\nशतक्रतोर्वज्रधरस्य यज्ञे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2096394, "chapter_id": 3059, "verse_number": "१३-१८९-३६", "content_sanskrit": "भूयश्च या विष्णुपदे स्थिताया\nविभावसोश्चापि पथे स्थिता या।\nदेवाश्च सर्वे सह नारदेन\nप्रकुर्वते सर्वसहेति नाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096395, "chapter_id": 3059, "verse_number": "१३-१८९-३७", "content_sanskrit": "मन्त्रेणैतेनाभिवन्देत यो वै\nविमुच्यते पापकृतेन कर्मणा।\nलोकानवाप्नोति पुरंदरस्य\nगवां फलं चन्द्रमसो द्युतिं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2096396, "chapter_id": 3059, "verse_number": "१३-१८९-३८", "content_sanskrit": "एवं हि मन्त्रं त्रिदशाभिजुष्टं\nपठेत यः पर्वसु गोष्ठमध्ये।\nन तस्यि पापं न भयं न शोकः\nसहस्रनेत्रस्य च याति लोकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2096397, "chapter_id": 3059, "verse_number": "१३-१८९-३९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2096398, "chapter_id": 3059, "verse_number": "१३-१८९-३९", "content_sanskrit": "अथ सप्त महाभाग ऋषयो लोकविश्रुताः।\nवसिष्ठप्रमुखाः सर्वे ब्रह्मणं पद्मसम्भवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2096399, "chapter_id": 3059, "verse_number": "१३-१८९-४०", "content_sanskrit": "प्रदक्षिणमभिक्रम्य सर्वे प्राञ्जलयः स्थिताः॥\nउवाच वचनं तेषां वसिष्ठो ब्रह्मवित्तमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2096400, "chapter_id": 3059, "verse_number": "१३-१८९-४१", "content_sanskrit": "सर्वप्राणिहितं प्रश्नं ब्रह्मिक्षत्रे विशेषतः॥\nद्रव्यहीनाः कथं मर्त्या दरिद्राः साधुवर्तिनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2096401, "chapter_id": 3059, "verse_number": "१३-१८९-४२", "content_sanskrit": "प्राप्नुवन्तीह यज्ञस्य फलं केन च कर्मणा॥\nएतच्छ्रुत्वा वचस्तेषां ब्रह्मा वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2096402, "chapter_id": 3059, "verse_number": "१३-१८९-४३", "content_sanskrit": "अहो प्रश्नो महाभाग गूढार्थः परमः शुभः।\nसूक्ष्मः श्रेयांश्च मर्त्यानां भवद्भिः समुदाहृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2096403, "chapter_id": 3059, "verse_number": "१३-१८९-४४", "content_sanskrit": "श्रूयतां सर्वमाख्यास्ये निखिलेन तपोधनाः।\nयथा यज्ञफलं मर्त्यो लभते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2096404, "chapter_id": 3059, "verse_number": "१३-१८९-४५", "content_sanskrit": "पौषमासस्य शुक्ले वै यदा युज्येत रोहिणी।\nतेन नक्षत्रयोगेन आकाशशयनो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2096405, "chapter_id": 3059, "verse_number": "१३-१८९-४६", "content_sanskrit": "एकवस्त्रः शुचिः स्नातः श्रद्दधानः समाहितः।\nसोमस्य रश्मयः पीत्वा महायज्ञफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2096406, "chapter_id": 3059, "verse_number": "१३-१८९-४७", "content_sanskrit": "एतद्वः परमं गुह्यं कथितं द्विजसत्तमाः।\nयन्मां भवन्तः पृच्छन्ति सूक्ष्मतत्त्वार्थदर्शिनः]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2096407, "chapter_id": 3059, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोननवत्यधिकशततमोऽध्यायः॥ १८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]