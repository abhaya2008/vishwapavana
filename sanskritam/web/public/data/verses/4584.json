[{"id": 2166837, "chapter_id": 4584, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2166838, "chapter_id": 4584, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा महाराज धृतराष्ट्रोऽम्बिकासुतः ।\nशोकस्यान्तमपश्यन् वै हतं मत्वा सुयोधनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2166839, "chapter_id": 4584, "verse_number": "२", "content_sanskrit": "विह्वलः पतितो भूमौ नष्टचेता इव द्विपः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2166840, "chapter_id": 4584, "verse_number": "३", "content_sanskrit": "तस्मिन् निपतिते भूमौ विह्वले राजसत्तमे ।\nआर्तनादो महानासीत् स्त्रीणां भरतसत्तम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2166841, "chapter_id": 4584, "verse_number": "४", "content_sanskrit": "स शब्दः पृथिवीं सर्वां पूरयामास सर्वतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2166842, "chapter_id": 4584, "verse_number": "", "content_sanskrit": "शोकार्णवे महाघोरे तदा पुप्लुविरे स्त्रियः ।\n(नेत्राणि वारिणाऽऽपूर्य सरितः सागरं यथा\t॥५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2166843, "chapter_id": 4584, "verse_number": "६", "content_sanskrit": "राजानं च समासाद्य गान्धारी भरतर्षभ ।\nनिःसञ्ज्ञा न्यपतद् भूमौ सर्वाण्यन्तःपुराणि च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2166844, "chapter_id": 4584, "verse_number": "७", "content_sanskrit": "ततस्ताः सञ्जयो राजन्नाश्वासयत योषितः ।\nमुह्यमानाः सुबहुशो मुञ्चन्तीर्वारि नेत्रजम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2166845, "chapter_id": 4584, "verse_number": "८", "content_sanskrit": "आश्वासिताः स्त्रियस्तास्तु वेपमानाः प्रदृश्यत ।\nकदल्य इव वातेन धूयमानाः समन्ततः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2166846, "chapter_id": 4584, "verse_number": "९", "content_sanskrit": "राजानं विदुरश्चापि प्रज्ञाचक्षुर्नराधिपम् ।\nआश्वासयत् सुशीतेन सिञ्चंस्तोयेन कौरवम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2166847, "chapter_id": 4584, "verse_number": "१०", "content_sanskrit": "स लब्ध्वा शनकैः सञ्ज्ञां ताश्च दृष्ट्वा स्त्रियो नृप ।\nउन्मत्त इव राजा वै तूष्णीमासीद् विशाम्पते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2166848, "chapter_id": 4584, "verse_number": "११", "content_sanskrit": "सम्प्रध्याय चिरं राजा विनिश्वस्य पुनः पुनः ।\nदैवं च गर्हयामास बहु मेने च पाण्डवान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2166849, "chapter_id": 4584, "verse_number": "१२", "content_sanskrit": "निनिन्द चात्मनो बुद्धिं शकुनेः सौबलस्य च ।\nध्यात्वा च सुचिरं कालं वेपमानो मुहुर्मुहुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2166850, "chapter_id": 4584, "verse_number": "१३", "content_sanskrit": "संस्तभ्य च मनो भूयो राजा धैर्यसमन्वितः ।\nपुनर्गावल्गणिं सूतं पर्यपृच्छत् स सञ्जयम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2166851, "chapter_id": 4584, "verse_number": "१४", "content_sanskrit": "न त्वया कथितं वाक्यं श्रुतं सञ्जय तत्वतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2166852, "chapter_id": 4584, "verse_number": "१५", "content_sanskrit": "कच्चिद् दुर्योधनः सूत न गतो वै यमक्षयम् ।\nब्रूया निराशां सततं पुत्राणां शिवतामुत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2166853, "chapter_id": 4584, "verse_number": "१६", "content_sanskrit": "ब्रूहि सञ्जय तत्त्वेन पुनरुक्तां कथामिमाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2166854, "chapter_id": 4584, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2166855, "chapter_id": 4584, "verse_number": "१७", "content_sanskrit": "एवमुक्तोऽब्रवीत् सूतो राजानं जनमेजय\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2166856, "chapter_id": 4584, "verse_number": "१८", "content_sanskrit": "हतो वैकर्तनो राजन् सह पुत्रैर्महारथः ।\nसोदर्यैश्च महेष्वासैः सूतपुत्रैस्तनुत्यजैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2166857, "chapter_id": 4584, "verse_number": "१९", "content_sanskrit": "दुःशासनश्च निहतः पाण्डवेन महात्मना ।\nपीतं च रुधिरं कोपाद् भीमसेनेन संयुगे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2166858, "chapter_id": 4584, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां कर्णपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]