[{"id": 40008918, "chapter_id": 9054, "verse_number": "1", "content_sanskrit": "स तां पुष्करिणीं गत्वा पद्मोत्पलझषाकुलाम्। रामस्सौमित्रि सहितो विललापाकुलेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40008919, "chapter_id": 9054, "verse_number": "2", "content_sanskrit": "तस्य दृष्ट्वैव तां हर्षादिन्द्रियाणि चकम्पिरे। स कामवशमापन्नस्सौमित्रिमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40008920, "chapter_id": 9054, "verse_number": "3", "content_sanskrit": "सौमित्रे शोभते पम्पा वैदूर्यविमलोदका। फुल्लपद्मोत्पलवती शोभिता विविधैर्द्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40008921, "chapter_id": 9054, "verse_number": "4", "content_sanskrit": "सौमित्रे पश्य पम्पायाः काननं शुभदर्शनम्। यत्र राजन्ति शैला वा द्रुमास्सशिखरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40008922, "chapter_id": 9054, "verse_number": "5", "content_sanskrit": "मां तु शोकाभिसन्तप्तं माधवः पीडयन्ति वै। भरतस्य च दुःखेन वैदेह्या हरणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40008923, "chapter_id": 9054, "verse_number": "6", "content_sanskrit": "शोकार्तस्यापि मे पम्पा शोभते चित्रकानना। व्यवकीर्णा बहुविधैः पुष्पैश्शीतोदका शिवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40008924, "chapter_id": 9054, "verse_number": "7", "content_sanskrit": "नलिनैरपि सञ्छन्ना ह्यत्यर्थशुभदर्शना। सर्पव्यालानुचरिता मृगद्विजसमाकुला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40008925, "chapter_id": 9054, "verse_number": "8", "content_sanskrit": "अधिकं प्रविभात्येतन्नीलपीतं तु शाद्वलम्। द्रुमाणां विविधैः पुष्पैः परिस्तोमैरिवार्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40008926, "chapter_id": 9054, "verse_number": "9", "content_sanskrit": "पुष्पभारसमृद्धानि शिखराणि समन्ततः। लताभिः पुष्पिताग्राभिरुपगूढानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40008927, "chapter_id": 9054, "verse_number": "10", "content_sanskrit": "सुखानिलोऽयं सौमित्रे कालः प्रचुरमन्मथः। गन्धवान्सुरभिर्मासो जातपुष्पफलद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40008928, "chapter_id": 9054, "verse_number": "11", "content_sanskrit": "पश्य रूपाणि सौमित्रे वनानां पुष्पशालिनाम्। सृजतां पुष्पवर्षाणि तोयं तोयमुचामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40008929, "chapter_id": 9054, "verse_number": "12", "content_sanskrit": "प्रस्तरेषु च रम्येषु विविधाः काननद्रुमाः। वायुवेगप्रचलिताः पुष्पैरवकिरन्ति गाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40008930, "chapter_id": 9054, "verse_number": "13", "content_sanskrit": "पतितैः पतमानैश्च पादपस्थैश्च मारुतः। कुसुमैः पश्य सौमित्रे क्रीडन्निव समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40008931, "chapter_id": 9054, "verse_number": "14", "content_sanskrit": "विक्षिपन्विविधाश्शाखा नगानां कुसुमोत्कचाः। मारुतश्चलितस्थानैष्षट्पदैरनुगीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40008932, "chapter_id": 9054, "verse_number": "15", "content_sanskrit": "मत्तकोकिलसन्नादैर्नर्तयन्निव पादपान्। शैलकन्दरनिष्क्रान्तः प्रगीत इव चानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40008933, "chapter_id": 9054, "verse_number": "16", "content_sanskrit": "तेन विक्षिपताऽत्यर्थं पवनेन समन्ततः। अमी संसक्तशाखाग्रा ग्रथिता इव पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40008934, "chapter_id": 9054, "verse_number": "17", "content_sanskrit": "स एष सुखसंस्पर्शो वाति चन्दनशीतलः। गन्धमभ्यवहन्पुण्यं श्रमापनयनोऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40008935, "chapter_id": 9054, "verse_number": "18", "content_sanskrit": "अमी पवनविक्षिप्ता विनदन्तीव पादपाः। षट्पदैरनुकूजन्तो वनेषु मधुगन्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40008936, "chapter_id": 9054, "verse_number": "19", "content_sanskrit": "गिरिप्रस्थेषु रम्येषु पुष्पवद्भिर्मनोरमैः। संसक्तशिखराश्शैला विराजन्ते महाद्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40008937, "chapter_id": 9054, "verse_number": "20", "content_sanskrit": "पुष्पसञ्छन्नशिखरा मारुतोत्क्षेपचञ्चलाः। अमी मधुकरोत्तंसाः प्रगीता इव पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40008938, "chapter_id": 9054, "verse_number": "21", "content_sanskrit": "सुपुष्पितांस्तु पश्येमान्कर्णिकारांत्समन्ततः। हाटकप्रतिसञ्छन्नान्नरान्पीताम्बरानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40008939, "chapter_id": 9054, "verse_number": "22", "content_sanskrit": "अयं वसन्तस्सौमित्रे नानाविहगनादितः। सीतया विप्रहीनस्य शोकसन्दीपनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40008940, "chapter_id": 9054, "verse_number": "23", "content_sanskrit": "मां हि शोकसमाक्रान्तं सन्तापयति मन्मथः। हृष्टः प्रवदमानश्च ममाह्वयति कोकिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40008941, "chapter_id": 9054, "verse_number": "24", "content_sanskrit": "एष दात्यूहको हृष्टो रम्ये मां वननिर्झरे। प्रणदन्मन्मथाविष्टं शोचयिष्यति लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40008942, "chapter_id": 9054, "verse_number": "25", "content_sanskrit": "श्रुत्वैतस्य पुरा शब्दमाश्रमस्था मम प्रिया। मामाहूय प्रमुदिताः परमं प्रत्यनन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40008943, "chapter_id": 9054, "verse_number": "26", "content_sanskrit": "एवं विचित्राः पतगा नानारावविराविणः। वृक्षगुल्मलताः पश्य सम्पतन्ति समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40008944, "chapter_id": 9054, "verse_number": "27", "content_sanskrit": "विमिश्रा विहगाः पुम्भिरात्मव्यूहाभिनन्दिताः। भृङ्गराजप्रमुदितास्सौमित्रे मधुरस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40008945, "chapter_id": 9054, "verse_number": "28", "content_sanskrit": "दात्यूहरतिविक्रन्दैः पुंस्कोकिलरुतैरपि। स्वनन्ति पादपाश्चेमे ममानङ्गप्रदीपनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40008946, "chapter_id": 9054, "verse_number": "29", "content_sanskrit": "अशोकस्तबकाङ्गारष्षट्पदस्वननिःस्वनः। मां हि पल्लवताम्रार्चिर्वसन्ताग्निः प्रधक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40008947, "chapter_id": 9054, "verse_number": "30", "content_sanskrit": "न हि तां सूक्ष्मपक्ष्माक्षीं सुकेशीं मृदुभाषिणीम्। अपश्यतो मे सौमित्रे जीवितेऽस्ति प्रयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40008948, "chapter_id": 9054, "verse_number": "31", "content_sanskrit": "अयं हि दयितस्तस्याः कालो रुचिरकाननः। कोकिलाकुलसीमान्तो दयिताया ममानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40008949, "chapter_id": 9054, "verse_number": "32", "content_sanskrit": "मन्मथाऽयाससम्भूतो वसन्तगुणवर्धितः। अयं मां धक्ष्यति क्षिप्रं शोकाग्निर्नचिरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40008950, "chapter_id": 9054, "verse_number": "33", "content_sanskrit": "अपश्यतस्तां दयितां पश्यतो रुचिरद्रुमान्। ममायमात्मप्रभवो भूयस्त्वमुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40008951, "chapter_id": 9054, "verse_number": "34", "content_sanskrit": "अदृश्यमाना वैदेही शोकं वर्धयते मम। दृश्यमानो वसन्तश्च स्वेदसंसर्गदूषकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40008952, "chapter_id": 9054, "verse_number": "35", "content_sanskrit": "मां ह्यद्य मृगशाबाक्षी चिन्ताशोकबलात्कृतम्। सन्तापयति सौमित्रे क्रूरश्चैत्रवनानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40008953, "chapter_id": 9054, "verse_number": "36", "content_sanskrit": "अमी मयूराश्शोभन्ते प्रनृत्यन्तस्ततस्ततः। स्वैः पक्षैः पवनोद्धूतैर्गवाक्षैः स्फाटिकैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40008954, "chapter_id": 9054, "verse_number": "37", "content_sanskrit": "शिखिनीभिः परिवृतास्ते एते मदमूर्छिताः। मन्मथाभिपरीतस्य मम मन्मथवर्धनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40008955, "chapter_id": 9054, "verse_number": "38", "content_sanskrit": "पश्य लक्ष्मण नृत्यन्तं मयूरमुपनृत्यति। शिखिनी मन्मथार्तैषा भर्तारं गिरिसानुनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40008956, "chapter_id": 9054, "verse_number": "39", "content_sanskrit": "तामेव मन्मथाविष्टो मयूरोऽप्युपधावति। वितत्य रुचिरौ पक्षौ रुतैरुपहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40008957, "chapter_id": 9054, "verse_number": "40", "content_sanskrit": "मयूरस्य वने नूनं रक्षसा न हृता प्रिया। तस्मान्नृत्यति रम्येषु वनेषु सह कान्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40008958, "chapter_id": 9054, "verse_number": "41", "content_sanskrit": "मम त्वयं विना वासः पुष्पमासे सुदुस्सहः। पश्य लक्ष्मण संरागः तिर्यग्योनिगतेष्वपि। यदेषा शिखिनी कामाद्भर्तारं रमतेऽन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40008959, "chapter_id": 9054, "verse_number": "42", "content_sanskrit": "मामप्येवं विशालाक्षी जानकी जातसम्भ्रमा। मदनेनाभिवर्तेत यदि नाऽपहृता भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40008960, "chapter_id": 9054, "verse_number": "43", "content_sanskrit": "पश्य लक्ष्मण पुष्पाणि निष्फलानि भवन्ति मे। पुष्पभारसमृद्धानां वनानां शिशिरात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40008961, "chapter_id": 9054, "verse_number": "44", "content_sanskrit": "रुचिराण्यपि पुष्पाणि पादपानामतिश्रिया। निष्फलानि महीं यान्ति समं मधुकरोत्करैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40008962, "chapter_id": 9054, "verse_number": "45", "content_sanskrit": "नदन्ति कामं शकुना मुदितास्सङ्घशः कलम्। आह्वयन्त इवान्योन्यं कामोन्मादकरा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40008963, "chapter_id": 9054, "verse_number": "46", "content_sanskrit": "वसन्तो यदि तत्रापि यत्र मे वसति प्रिया। नूनं परवशा सीता सापि शोचत्यहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40008964, "chapter_id": 9054, "verse_number": "47", "content_sanskrit": "नूनं न तु वसन्तोऽतं देशं स्पृशति यत्र सा। कथं ह्यसितपद्माक्षी वर्तयेत्सा मया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40008965, "chapter_id": 9054, "verse_number": "48", "content_sanskrit": "अथवा वर्तते तत्र वसन्तो यत्र मे प्रिया। किं करिष्यति सुश्रोणी सा तु निर्भर्त्सिता परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40008966, "chapter_id": 9054, "verse_number": "49", "content_sanskrit": "श्यामा पद्मपलाशाक्षी मृदुपूर्वाभिभाषिणी। नूनं वसन्तमासाद्य परित्यक्ष्यति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40008967, "chapter_id": 9054, "verse_number": "50", "content_sanskrit": "दृढं हि हृदये बुद्धिर्मम सम्परिवर्तते। नालं वर्तयितुं सीता साध्वी मद्विरहं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40008968, "chapter_id": 9054, "verse_number": "51", "content_sanskrit": "मयि भावस्तु वैदेह्यास्तत्त्वतो विनिवेशितः। ममापि भावस्सीतायां सर्वथा विनिवेशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40008969, "chapter_id": 9054, "verse_number": "52", "content_sanskrit": "एष पुष्पवहो वायुस्सुखस्पर्शो हिमावहः। तां विचिन्तयतः कान्तां पावकप्रतिमो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40008970, "chapter_id": 9054, "verse_number": "53", "content_sanskrit": "सदा सुखमहं मन्ये यं पुरा सह सीतया। मारुतस्स विना सीतां शोकं वर्धयते मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40008971, "chapter_id": 9054, "verse_number": "54", "content_sanskrit": "तां विना विहङ्गो यः पक्षी प्रणदितस्तदा। वायसः पादपगतः प्रहृष्टमभिनर्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40008972, "chapter_id": 9054, "verse_number": "55", "content_sanskrit": "एष वै तत्र वैदेह्या विहगः प्रतिहारकः। पक्षी मां तु विशालाक्ष्यास्समीपमुपनेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40008973, "chapter_id": 9054, "verse_number": "56", "content_sanskrit": "शृणु लक्ष्मण सन्नादं वने मद्विवर्धनम्। पुष्पिताग्रेषु वृक्षेषु द्विजानामुपकूजताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40008974, "chapter_id": 9054, "verse_number": "57", "content_sanskrit": "विक्षिप्तां पवनेनैतामसौ तिलकमञ्जरीम्। षट्पदस्सहसाऽभ्येति मदोद्धूतामिव प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40008975, "chapter_id": 9054, "verse_number": "58", "content_sanskrit": "कामिनामयमत्यन्तमशोकश्शोकवर्धनः। स्तबकैः पवनोत्क्षिप्तैस्तर्जयन्निव मां स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40008976, "chapter_id": 9054, "verse_number": "59", "content_sanskrit": "अमी लक्ष्मण दृश्यन्ते चूताः कुसुमशालिनः। विभ्रमोत्सिक्तमनसः साङ्गरागा नरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40008977, "chapter_id": 9054, "verse_number": "60", "content_sanskrit": "सौमित्रे पश्य पम्पायाश्चित्रासु वनराजिषु। किन्नरा नरशार्दूल विचरन्ति ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40008978, "chapter_id": 9054, "verse_number": "61", "content_sanskrit": "इमानि शुभगन्धीनि पश्य लक्ष्मण सर्वशः। नलिनानि प्रकाशन्ते जले तरुणसूर्यवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40008979, "chapter_id": 9054, "verse_number": "62", "content_sanskrit": "एषा प्रसन्नसलिला पद्मनीलोत्पलायुता। हंसकारण्डवाकीर्णा पम्पा सौगन्धिकान्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40008980, "chapter_id": 9054, "verse_number": "63", "content_sanskrit": "जले तरुणसूर्याभैष्षट्पदाहतकेसरैः। पङ्कजैश्शोभते पम्पा समन्तादभिसंवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40008981, "chapter_id": 9054, "verse_number": "64", "content_sanskrit": "चक्रवाकयुता नित्यं चित्रप्रस्तवनान्तरा। मातङ्गमृगयूथैश्च शोभते सलिलार्थिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40008982, "chapter_id": 9054, "verse_number": "65", "content_sanskrit": "पवनाहतवेगाभिरूर्मिभिर्विमलेऽम्भसि। पङ्कजानि विराजन्ते ताड्यमानानि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40008983, "chapter_id": 9054, "verse_number": "66", "content_sanskrit": "पद्मपत्रविशालाक्षीं सततं पङ्कजप्रियाम्। अपश्यतो मे वैदेहीं जीवितं नाभिरोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40008984, "chapter_id": 9054, "verse_number": "67", "content_sanskrit": "अहो कामस्य वामत्वं यो गतामपि दुर्लभाम्। स्मारयिष्यति कल्याणीं कल्याणतरवादिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40008985, "chapter_id": 9054, "verse_number": "68", "content_sanskrit": "शक्यो धारयितुं कामो भवेदभ्यागतो मया। यदि भूयो वसन्तो मां न हन्यात्पुष्पितद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40008986, "chapter_id": 9054, "verse_number": "69", "content_sanskrit": "यानि स्म रमणीयानि तया सह भवन्ति मे। तान्येवारमणीयानि जायन्ते मे तया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40008987, "chapter_id": 9054, "verse_number": "70", "content_sanskrit": "पद्मकोशपलाशानि द्रष्टुं दृष्टिर्हि मन्यते। सीताया नेत्रकोशाभ्यां सदृशानीति लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 40008988, "chapter_id": 9054, "verse_number": "71", "content_sanskrit": "पद्मकेसरसंसृष्टो वृक्षान्तरविनिस्सृतः। निश्श्वास इव सीताया वाति वायुर्मनोहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 40008989, "chapter_id": 9054, "verse_number": "72", "content_sanskrit": "सौमित्रे पश्य पम्पाया दक्षिणे गिरिसानुनि। पुष्पितां कर्णिकारस्य यष्टिं परमशोभनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 40008990, "chapter_id": 9054, "verse_number": "73", "content_sanskrit": "अधिकं शैलराजोऽयं धातुभिः सुविभूषितः। विचित्रं सृजते रेणुं वायुवेगविघट्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 40008991, "chapter_id": 9054, "verse_number": "74", "content_sanskrit": "गिरिप्रस्थास्तु सौमित्रे सर्वतस्सम्प्रपुष्पितैः। निष्पत्रैस्सर्वतो रम्यैः प्रदीप्ता इव किंशुकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 40008992, "chapter_id": 9054, "verse_number": "75", "content_sanskrit": "पम्पातीररुहाश्चेमे संसक्ता मधुगन्धिनः। मालतीमल्लिकाषण्डाः करवीराश्च पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 40008993, "chapter_id": 9054, "verse_number": "76", "content_sanskrit": "केतक्यस्सिन्दुवाराश्च वासन्त्यश्च सुपुष्पिताः। माधव्यो गन्धपूर्णाश्च कुन्दगुल्माश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 40008994, "chapter_id": 9054, "verse_number": "77", "content_sanskrit": "चिरिबिल्वा मधूकाश्च वञ्जुला वकुलास्तथा। चम्पकास्तिलकाश्चैव नागवृक्षास्सुपुष्पिताः ॥ नीपाश्च वरणाश्चैव खर्जूराश्च सुपुष्पिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 40008995, "chapter_id": 9054, "verse_number": "78", "content_sanskrit": "पद्मकाश्चैव शोभन्ते नीलाशोकाश्च पुष्पिताः। लोध्राश्च गिरिपृष्ठेषु सिंहकेसरपिञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 40008996, "chapter_id": 9054, "verse_number": "79", "content_sanskrit": "अङ्कोलाश्च कुरण्टाश्च चूर्णकाः पारिभद्रकाः। चूताः पाटलयश्चैव कोविदाराश्च पुष्पिताः ॥ मुचुकुन्दार्जुनाश्चैव दृश्यन्ते गिरिसानुषु। केतकोद्दालकाश्चैव शिरीषाः शिंशुपा धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 40008997, "chapter_id": 9054, "verse_number": "80", "content_sanskrit": "अङ्कोलाश्च कुरण्टाश्च चूर्णकाः पारिभद्रकाः। चूताः पाटलयश्चैव कोविदाराश्च पुष्पिताः ॥ मुचुकुन्दार्जुनाश्चैव दृश्यन्ते गिरिसानुषु। केतकोद्दालकाश्चैव शिरीषाः शिंशुपा धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 40008998, "chapter_id": 9054, "verse_number": "81", "content_sanskrit": "शाल्मल्यः किंशुकाश्चैव रक्ताः कुरवकास्तथा ॥ त्रिनिशा नक्तमालाश्च चन्दनास्स्यन्दनास्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 40008999, "chapter_id": 9054, "verse_number": "82", "content_sanskrit": "पुष्पितान्पुष्पिताग्राभिर्लताभिः परिवेष्टितान्। द्रुमान्पश्येह सौमित्रे पम्पाया रुचिरान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 40009000, "chapter_id": 9054, "verse_number": "83", "content_sanskrit": "पुष्पितान्पुष्पिताग्राभिर्लताभिः परिवेष्टितान्। द्रुमान्पश्येह सौमित्रे पम्पाया रुचिरान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 40009001, "chapter_id": 9054, "verse_number": "84", "content_sanskrit": "वातविक्षिप्तविटपान्यथाऽसन्नान्द्रुमानिमान्। लतास्समनुवर्तन्ते मत्ता इव वरस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 40009002, "chapter_id": 9054, "verse_number": "85", "content_sanskrit": "पादपात्पादपं गच्छन् शैलाच्छैलं वनाद्वनम्। वाति नैकरसास्वादस्सम्मोदित इवानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 40009003, "chapter_id": 9054, "verse_number": "86", "content_sanskrit": "केचित्पर्याप्तकुसुमाः पादपा मधुगन्धिनः। केचिन्मुकुलसंवीताः श्यामवर्णा इवाबभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 40009004, "chapter_id": 9054, "verse_number": "87", "content_sanskrit": "इदं मृष्टमिदं स्वादु प्रफुल्लमिदमित्यपि। रागयुक्तो मधुकरः कुसुमेष्वेव लीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 40009005, "chapter_id": 9054, "verse_number": "88", "content_sanskrit": "निलीय पुनरुत्पत्य सहसाऽन्यत्र गच्छति। मधुलुब्धो मधुकरः पम्पातीरद्रुमेष्वसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 40009006, "chapter_id": 9054, "verse_number": "89", "content_sanskrit": "इयं कुसुमसङ्घातैरुपस्तीर्णा सुखाकृता। स्वयं निपतितैर्भूमिश्शयनप्रस्तरैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 40009007, "chapter_id": 9054, "verse_number": "90", "content_sanskrit": "विविधा विविधैः पुष्पैस्तैरेव नगसानुषु। विकीर्णै पीतरक्ताहि सौमित्रे प्रस्तराः कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 40009008, "chapter_id": 9054, "verse_number": "91", "content_sanskrit": "हिमान्ते पश्य सौमित्रे वृक्षाणां पुष्पसम्भवम्। पुष्पमासे हि तरवस्सङ्घर्षादिव पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 40009009, "chapter_id": 9054, "verse_number": "92", "content_sanskrit": "आह्वयन्त इवान्योन्यं नगाष्षट्पदनादिताः। कुसुमोत्तंसविटपाश्शोभन्ते बहु लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 40009010, "chapter_id": 9054, "verse_number": "93", "content_sanskrit": "एष कारण्डवः पक्षी विगाह्य सलिलं शुभम्। रमते कान्तया सार्धं काममुद्दीपयन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 40009011, "chapter_id": 9054, "verse_number": "94", "content_sanskrit": "मन्दाकिन्यास्तु यदिदं रूपमेवं मनोहरम्। स्थाने जगति विख्याता गुणास्तस्या मनोरमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 40009012, "chapter_id": 9054, "verse_number": "95", "content_sanskrit": "यदि दृश्येत सा साध्वी यदि चेह वसेमहि। स्पृहयेयं न शक्राय नायोध्यायै रघूत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 40009013, "chapter_id": 9054, "verse_number": "96", "content_sanskrit": "नह्येवं रमणीयेषु शाद्वलेषु तया सह। रमतो मे भवेच्चिन्ता न स्पृहाऽन्येषु वा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 40009014, "chapter_id": 9054, "verse_number": "97", "content_sanskrit": "अमी हि विविधैः पुष्पैस्तरवो रुचिरच्छदाः। काननेऽऽस्मिन्विना कान्तां चिन्तामुत्पादयन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 40009015, "chapter_id": 9054, "verse_number": "98", "content_sanskrit": "पश्य शीतजलां चेमां सौमित्रे पुष्करायुताम्। चक्रवाकानुचरितां कारण्डव निषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 40009016, "chapter_id": 9054, "verse_number": "99", "content_sanskrit": "प्लवैः क्रौञ्चैश्च सम्पूर्णां महामृगनिषेविताम्। अधिकं शोभते पम्पा विकूजद्भिःर्विहङ्गमैः ॥ दीपयन्तीव मे कामं विविधा मुदिता द्विजाः। श्यामां चन्द्रमुखीं स्मृत्वा प्रियां पद्मनिभेक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 40009017, "chapter_id": 9054, "verse_number": "100", "content_sanskrit": "प्लवैः क्रौञ्चैश्च सम्पूर्णां महामृगनिषेविताम्। अधिकं शोभते पम्पा विकूजद्भिःर्विहङ्गमैः ॥ दीपयन्तीव मे कामं विविधा मुदिता द्विजाः। श्यामां चन्द्रमुखीं स्मृत्वा प्रियां पद्मनिभेक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 40009018, "chapter_id": 9054, "verse_number": "101", "content_sanskrit": "पश्य सानुषु चित्रेषु मृगीभिस्सहितान्मृगान्। मां पुनर्मृगशाबाक्ष्या वैदेह्या विरहीकृतम् ॥ व्यथयन्तीव मे चित्तं सञ्चरन्तस्ततस्ततः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 40009019, "chapter_id": 9054, "verse_number": "102", "content_sanskrit": "अस्मिन्सानुनि रम्ये हि मत्तद्विजगणायुते। पश्येयं यदि तां कान्तां ततस्स्वस्ति भवेन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 40009020, "chapter_id": 9054, "verse_number": "103", "content_sanskrit": "जीवेयं खलु सौमित्रे मया सह सुमध्यमा। सेवते यदि वैदेही पम्पायाः पवनं सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 40009021, "chapter_id": 9054, "verse_number": "104", "content_sanskrit": "पद्मसौगन्धिकवहं शिवं शोकविनाशनम्। धन्या लक्ष्मण सेवन्ते पम्पोपवनमारुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 40009022, "chapter_id": 9054, "verse_number": "105", "content_sanskrit": "श्यामा पद्मपलाशाक्षी प्रिया विरहिता मया। कथं धारयति प्राणान्विवशा जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 40009023, "chapter_id": 9054, "verse_number": "106", "content_sanskrit": "किन्नु वक्ष्यामि राजानं धर्मज्ञं सत्यवादिनम्। सीताया जनकं पृष्टः कुशलं जनसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 40009024, "chapter_id": 9054, "verse_number": "107", "content_sanskrit": "या मामनुगता मन्दं पित्रा प्रव्राजितं वनम्। सीता सत्पथमास्थाय क्व नु सा वर्तते प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 40009025, "chapter_id": 9054, "verse_number": "108", "content_sanskrit": "तया विहीनः कृपणः कथं लक्ष्मण धारये। या मामनुगता राज्याद्भ्रष्टं विगतचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 40009026, "chapter_id": 9054, "verse_number": "109", "content_sanskrit": "तच्चार्वञ्चितपद्माक्षं सुगन्धि शुभमव्रणम्। अपश्यतो मुखं तस्यास्सीदतीव मनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 40009027, "chapter_id": 9054, "verse_number": "110", "content_sanskrit": "स्मितहास्यान्तरयुतं गुणवन्मधुरं हितम्। वैदेह्या वाक्यमतुलं कदा श्रोष्यामि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 40009028, "chapter_id": 9054, "verse_number": "111", "content_sanskrit": "प्राप्य दुखं वने श्यामा मां मन्मथविकर्शितम्। नष्टदुःखेव हृष्टेव साध्वी साध्वभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 40009029, "chapter_id": 9054, "verse_number": "112", "content_sanskrit": "किं नु वक्ष्यामि कौसल्यामयोध्यायां नृपात्मज। क्व सा स्नुषेति पृच्छन्तीं कथं चापि तु मनस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 40009030, "chapter_id": 9054, "verse_number": "113", "content_sanskrit": "गच्छ लक्ष्मण पश्य त्वं भरतं भ्रातृवत्सलम्। न ह्यहं जीवितु शक्तस्तामृते जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 40009031, "chapter_id": 9054, "verse_number": "114", "content_sanskrit": "इति रामं महात्मानं विलपन्तमनाथवत्। उवाच लक्ष्मणो भ्राता वचनं युक्तमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 40009032, "chapter_id": 9054, "verse_number": "115", "content_sanskrit": "संस्तम्भ राम भद्रं ते मा शुचः पुरुषोत्तम। नेदृशानां मतिर्मन्दा भवत्यकलुषात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 40009033, "chapter_id": 9054, "verse_number": "116", "content_sanskrit": "स्मृत्वा वियोगजं दुःखं त्यज स्नेहं प्रिये जने। अतिस्नेहपरिष्वङ्गाद्वर्तिरार्द्रापि दह्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 40009034, "chapter_id": 9054, "verse_number": "117", "content_sanskrit": "यदि गच्छति पातालं ततोऽभ्यधिकमेव वा। सर्वथा रावणस्तावन्न भविष्यति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 40009035, "chapter_id": 9054, "verse_number": "118", "content_sanskrit": "प्रवृत्तिर्लभ्यतां तावत्तस्य पापस्य रक्षसः। ततो हास्यति वा सीतां निधनं वा गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 40009036, "chapter_id": 9054, "verse_number": "119", "content_sanskrit": "यदि यातिदितेर्गर्भं रावणस्सह सीतया। तत्राप्येनं हनिष्यामि न चेद्दास्यति मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 40009037, "chapter_id": 9054, "verse_number": "120", "content_sanskrit": "स्वास्थ्यं भद्रं भजस्वार्य त्यज्यतां कृपणा मतिः। अर्थो हि नष्टकार्यार्थैर्नायत्नेनाधिगम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 40009038, "chapter_id": 9054, "verse_number": "121", "content_sanskrit": "उत्साहो बलवानार्य नास्त्युत्साहात्परं बलम्। सोत्साहस्यास्ति लोकेऽस्मिन् न किञ्चिदपि दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 40009039, "chapter_id": 9054, "verse_number": "122", "content_sanskrit": "उत्साहवन्तः पुरुषा नावसीदन्ति कर्मसु। उत्साहमात्रमाश्रित्य सीतां प्रतिलभेमहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 40009040, "chapter_id": 9054, "verse_number": "123", "content_sanskrit": "त्यज्यतां कामवृत्तत्वं शोकं सन्न्यस्य पृष्ठतः। महात्मानं कृतात्मानमात्मानं नावबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 40009041, "chapter_id": 9054, "verse_number": "124", "content_sanskrit": "एवं सम्बोधितस्तत्र शोकोपहतचेतनः। त्यज्य शोकञ्च मोहञ्च ततो धैर्यमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 40009042, "chapter_id": 9054, "verse_number": "125", "content_sanskrit": "सोऽभ्यतिक्रामदव्यग्रस्तामचिन्त्यपराक्रमः। रामः पम्पां सुरुचिरां रम्यपारिप्लवद्रुमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 40009043, "chapter_id": 9054, "verse_number": "126", "content_sanskrit": "निरीक्षमाणस्सहसा महात्मा सर्वं वनं निर्झरकन्दराश्च। उद्विग्नचेतास्सह लक्ष्मणेन विचार्य दुःखोपहतः प्रतस्थे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 40009044, "chapter_id": 9054, "verse_number": "127", "content_sanskrit": "तं मत्तमातङ्गविलासगामी गच्छन्तमव्यग्रमना महात्मा। स लक्ष्मणो राघवमप्रमत्तो ररक्ष धर्मेण बलेन चैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 40009045, "chapter_id": 9054, "verse_number": "128", "content_sanskrit": "तावृष्यमूकस्य समीपचारी चरन्ददर्शाद्भुतदर्शनीयौ। शाखामृगाणामधिपस्तरस्वी वितत्रसे नैव चिचेष्ट किञ्चित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 40009046, "chapter_id": 9054, "verse_number": "129", "content_sanskrit": "स तौ महात्मा गजमन्दगामी शाखामृगस्तत्र चरञ्चरन्तौ। दृष्ट्वा विषादं परमं जगाम चिन्तापरीतो भयभारमग्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 40009047, "chapter_id": 9054, "verse_number": "130", "content_sanskrit": "तमाश्रमं पुण्यसुखं शरण्यं सदैव शाखामृगसेवितान्तम्। त्रस्ताश्च दृष्ट्वा हरयोऽभिजग्मुर्महौजसौ राघवलक्ष्मणौ तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}]