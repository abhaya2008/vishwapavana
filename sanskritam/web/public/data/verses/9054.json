[{"id": 5000054000, "chapter_id": 9054, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000054001, "chapter_id": 9054, "verse_number": "१-५४-१", "content_sanskrit": "कामधेनुं वसिष्ठोऽपि यदा न त्यजते मुनिः।\nतदास्य शबलां राम विश्वामित्रोऽन्वकर्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000054002, "chapter_id": 9054, "verse_number": "१-५४-२", "content_sanskrit": "नीयमाना तु शबला राम राज्ञा महात्मना।\nदुःखिता चिन्तयामास रुदन्ती शोककर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000054003, "chapter_id": 9054, "verse_number": "१-५४-३", "content_sanskrit": "परित्यक्ता वसिष्ठेन किमहं सुमहात्मना।\nयाहं राजभृतैर्दीना ह्रियेय भृशदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000054004, "chapter_id": 9054, "verse_number": "१-५४-४", "content_sanskrit": "किं मयापकृतं तस्य महर्षेर्भावितात्मनः।\nयन्मामनागसं दृष्ट्वा भक्तां त्यजति धार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000054005, "chapter_id": 9054, "verse_number": "१-५४-५", "content_sanskrit": "इति संचिन्तयित्वा तु निःश्वस्य च पुनः पुनः।\nजगाम वेगेन तदा वसिष्ठं परमौजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000054006, "chapter_id": 9054, "verse_number": "१-५४-६", "content_sanskrit": "निर्धूय तांस्तदा भृत्यान् शतशः शत्रुसूदन।\nजगामानिलवेगेन पादमूलं महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000054007, "chapter_id": 9054, "verse_number": "१-५४-७", "content_sanskrit": "शबला सा रुदन्ती च क्रोशन्ती चेदमब्रवीत्।\nवसिष्ठस्याग्रतः स्थित्वा रुदन्ती मेघनिःस्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000054008, "chapter_id": 9054, "verse_number": "१-५४-८", "content_sanskrit": "भगवन् किं परित्यक्ता त्वयाहं ब्रह्मणः सुत।\nयस्माद् राजभटा मां हि नयन्ते त्वत्सकाशतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000054009, "chapter_id": 9054, "verse_number": "१-५४-९", "content_sanskrit": "एवमुक्तस्तु ब्रह्मर्षिरिदं वचनमब्रवीत्।\nशोकसंतप्तहृदयां स्वसारमिव दुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000054010, "chapter_id": 9054, "verse_number": "१-५४-१०", "content_sanskrit": "न त्वां त्यजामि शबले नापि मेऽपकृतं त्वया।\nएष त्वां नयते राजा बलान्मत्तो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000054011, "chapter_id": 9054, "verse_number": "१-५४-११", "content_sanskrit": "नहि तुल्यं बलं मह्यं राजा त्वद्य विशेषतः।\nबली राजा क्षत्रियश्च पृथिव्याः पतिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000054012, "chapter_id": 9054, "verse_number": "१-५४-१२", "content_sanskrit": "इयमक्षौहिणी पूर्णा गजवाजिरथाकुला।\nहस्तिध्वजसमाकीर्णा तेनासौ बलवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000054013, "chapter_id": 9054, "verse_number": "१-५४-१३", "content_sanskrit": "एवमुक्ता वसिष्ठेन प्रत्युवाच विनीतवत्।\nवचनं वचनज्ञा सा ब्रह्मर्षिमतुलप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000054014, "chapter_id": 9054, "verse_number": "१-५४-१४", "content_sanskrit": "न बलं क्षत्रियस्याहुर्ब्राह्मणा बलवत्तराः।\nब्रह्मन् ब्रह्मबलं दिव्यं क्षात्राच्च बलवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000054015, "chapter_id": 9054, "verse_number": "१-५४-१५", "content_sanskrit": "अप्रमेयं बलं तुभ्यं न त्वया बलवत्तरः।\nविश्वामित्रो महावीर्यस्तेजस्तव दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000054016, "chapter_id": 9054, "verse_number": "१-५४-१६", "content_sanskrit": "नियुङ्क्ष्व मां महातेजस्त्वं ब्रह्मबलसम्भृताम्।\nतस्य दर्पं बलं यत्नं नाशयामि दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000054017, "chapter_id": 9054, "verse_number": "१-५४-१७", "content_sanskrit": "इत्युक्तस्तु तया राम वसिष्ठस्तु महायशाः।\nसृजस्वेति तदोवाच बलं परबलार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000054018, "chapter_id": 9054, "verse_number": "१-५४-१८", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा सुरभिः सासृजत् तदा।\nतस्या हुंभारवोत्सृष्टाः पह्लवाः शतशो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000054019, "chapter_id": 9054, "verse_number": "१-५४-१९", "content_sanskrit": "नाशयन्ति बलं सर्वं विश्वामित्रस्य पश्यतः।\nस राजा परमक्रुद्धः क्रोधविस्फारितेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000054020, "chapter_id": 9054, "verse_number": "१-५४-२०", "content_sanskrit": "पह्लवान् नाशयामास शस्त्रैरुच्चावचैरपि।\nविश्वामित्रार्दितान् दृष्ट्वा पह्लवान् शतशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000054021, "chapter_id": 9054, "verse_number": "१-५४-२१", "content_sanskrit": "भूय एवासृजद् घोरान् शकान् यवनमिश्रितान्।\nतैरासीत् संवृता भूमिः शकैर्यवनमिश्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000054022, "chapter_id": 9054, "verse_number": "१-५४-२२", "content_sanskrit": "प्रभावद्भिर्महावीर्यैर्हेमकिंजल्कसंनिभैः।\nतीक्ष्णासिपट्टिशधरैर्हेमवर्णाम्बरावृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000054023, "chapter_id": 9054, "verse_number": "१-५४-२३", "content_sanskrit": "निर्दग्धं तद‍्बलं सर्वं प्रदीप्तैरिव पावकैः।\nततोऽस्त्राणि महातेजा विश्वामित्रो मुमोच ह।\nतैस्ते यवनकाम्बोजा बर्बराश्चाकुलीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000054024, "chapter_id": 9054, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]