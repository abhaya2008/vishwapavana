[{"id": 6000272000, "chapter_id": 10272, "verse_number": null, "content_sanskrit": "अथ षट्सप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "अनिरुद्धेन रोचनायाः परिणयः", "range": null}]}, {"id": 6000272001, "chapter_id": 10272, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.001.m4a", "display_order": 2}, {"id": 6000272002, "chapter_id": 10272, "verse_number": "१०-७६-१", "content_sanskrit": "एकैकशस्ताः कृष्णस्य पुत्रान् दश दशाबलाः।\nअजीजनन्ननवमान् पितुः सर्वात्मसम्पदा॥ १०/७६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.002.m4a", "display_order": 3, "topics": [{"text": "सर्वासु भार्यासु कृष्णस्यापत्यानि", "range": "१–७"}]}, {"id": 6000272003, "chapter_id": 10272, "verse_number": "१०-७६-२", "content_sanskrit": "गृहादनपगं वीक्ष्य राजपुत्र्योऽच्युतं स्थितम्।\nआत्मनोऽमंसत प्रेष्ठं न तत्तत्त्वविदः स्‍त्रियः॥ १०/७६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.003.m4a", "display_order": 4}, {"id": 6000272004, "chapter_id": 10272, "verse_number": "१०-७६-३", "content_sanskrit": "चार्वब्जकोशवदनायतचारुनेत्रसप्रेमहासरसवीक्षितवल्गुजल्पैः।\nसम्मोहिता भगवतो न मनो विजेतुं स्वैर्विभ्रमैः समशकन् वनिता विभूम्नः॥ १०/७६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.004.m4a", "display_order": 5}, {"id": 6000272005, "chapter_id": 10272, "verse_number": "१०-७६-४", "content_sanskrit": "स्मायावलोकलवदर्शितभावहारिभ्रूमण्डलप्रहितसौरतमन्त्रशौण्डैः।\nपत्न्यस्तु षोडशसहस्रमनङ्गबाणैर्यस्येन्द्रियं विमथितुं करणैर्न शेकुः॥ १०/७६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.005.m4a", "display_order": 6}, {"id": 6000272006, "chapter_id": 10272, "verse_number": "१०-७६-५", "content_sanskrit": "याः स्वीप्सितं स्वभवनेष्वधिरूढमुच्चैर्लक्ष्म्येकधामसरसप्लुतवीक्षणेन।\nऐक्षन् सतामपि पतिं च सतीः कटाक्षैः स्थूणान्तरेण नवसङ्गमलज्जयेव॥ १०/७६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.006.m4a", "display_order": 7}, {"id": 6000272007, "chapter_id": 10272, "verse_number": "१०-७६-६", "content_sanskrit": "रामा गृहे विहरतः पुरतः कराभ्यां बद्धेक्षणाः स्वदयितस्य मुदाऽहसन्त्यः।\nगात्रान्तराण्यपि दधुर्निजपूरुषस्य क्लेशावहान्यपि तदङ्गजभङ्गभीताः॥ १०/७६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.007.m4a", "display_order": 8}, {"id": 6000272008, "chapter_id": 10272, "verse_number": "१०-७६-७", "content_sanskrit": "तासां या दशपुत्राणां कृष्णस्‍त्रीणां पुरोदिताः।\nअष्टौ महिष्यस्तत्पुत्रान् प्रद्युम्नादीन् गृणन्ति तान्॥ १०/७६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.008.m4a", "display_order": 9}, {"id": 6000272009, "chapter_id": 10272, "verse_number": "१०-७६-८", "content_sanskrit": "चारुदेष्णः सुदेष्णश्च चारुदेहश्च वीर्यवान्।\nसुचारुश्चारुगुप्तश्च भद्रचारुस्तथाऽपरे॥ १०/७६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.009.m4a", "display_order": 10, "topics": [{"text": "तेषु प्रधानानां नामानि", "range": "८–१७"}]}, {"id": 6000272010, "chapter_id": 10272, "verse_number": "१०-७६-९", "content_sanskrit": "चारुचन्द्रोऽतिचारुश्च चारुमान् दशमो हरेः।\nप्रद्युम्नप्रमुखा जाता रुग्मिण्या नवमाः पितुः॥ १०/७६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.010.m4a", "display_order": 11}, {"id": 6000272011, "chapter_id": 10272, "verse_number": "१०-७६-१०", "content_sanskrit": "भानुः सुभानुः स्वर्भानुः प्रभानुर्भानुमांस्तथा।\nचन्द्रभानुर्बृहद्भानुरभिभानुस्तथाऽष्टमः॥ १०/७६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.011.m4a", "display_order": 12}, {"id": 6000272012, "chapter_id": 10272, "verse_number": "१०-७६-११", "content_sanskrit": "श्रीभानुः प्रतिभानुश्च सत्यभामात्मजा दश।\nसाम्बः सुमित्रः पुरुजिच्छतजिच्च सहस्रजित्॥ १०/७६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.012.m4a", "display_order": 13}, {"id": 6000272013, "chapter_id": 10272, "verse_number": "१०-७६-१२", "content_sanskrit": "विजयश्चित्रकेतुश्च वसुमान् द्रविणः क्रतुः।\nजाम्बवत्याः सुता ह्येते साम्बाद्याः पितृसम्मताः॥ १०/७६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.013.m4a", "display_order": 14}, {"id": 6000272014, "chapter_id": 10272, "verse_number": "१०-७६-१३", "content_sanskrit": "भानुश्चन्द्रोऽश्वसेनश्च चित्रगुर्वेगवान् वृषः।\nआमः शङ्कुर्वसुः श्रीमान् कृतिर्नाग्नजितेः सुताः॥ १०/७६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.014.m4a", "display_order": 15}, {"id": 6000272015, "chapter_id": 10272, "verse_number": "१०-७६-१४", "content_sanskrit": "श्रुतः कविर्वृषो वीरः सुबाहुर्भद्र एकलः।\nशान्तिर्दर्शः पूर्णमास्यः कालिन्द्याः सोमकोऽपरः॥ १०/७६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.015.m4a", "display_order": 16}, {"id": 6000272016, "chapter_id": 10272, "verse_number": "१०-७६-१५", "content_sanskrit": "प्रघोषो गात्रवान् सिद्धो बलः प्रबल ऊर्ध्वगः।\nमाद्र्याः पुत्रा महाशक्तिः सह ओजोऽपराजितः॥ १०/७६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.016.m4a", "display_order": 17}, {"id": 6000272017, "chapter_id": 10272, "verse_number": "१०-७६-१६", "content_sanskrit": "वृकोऽर्हकोऽनिलो नीलो बह्वन्नोऽन्नाद एव च।\nमहाशः पवनो वह्निर्मित्रविन्दात्मजाः कृतिः॥ १०/७६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.017.m4a", "display_order": 18}, {"id": 6000272018, "chapter_id": 10272, "verse_number": "१०-७६-१७", "content_sanskrit": "सङ्ग्रामजिद् बृहत्सेनः शूरः प्रहरणोऽरिजित्। जयः सुभद्रो भद्राश्वो वाम आयुश्च सत्यकः।\nदीप्तिमांस्ताम्रपत्राद्या रोहिण्यास्तनया हरेः॥ १०/७६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.018.m4a", "display_order": 19}, {"id": 6000272019, "chapter_id": 10272, "verse_number": "१०-७६-१८", "content_sanskrit": "प्रद्युम्नाच्चानिरुद्धोऽभूद् रुग्मवत्यां महाबलः।\nपुत्र्यां च रुग्मिणो राजन् नाम्ना भोजकटे पुरे॥ १०/७६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.019.m4a", "display_order": 20}, {"id": 6000272020, "chapter_id": 10272, "verse_number": "१०-७६-१९", "content_sanskrit": "एतेषां पुत्रपौत्राश्च बभूवुः कोटिशो नृप।\nमातरः कृष्णभार्याणां सहस्राणि च षोडश॥ १०/७६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.020.m4a", "display_order": 21}, {"id": 6000272021, "chapter_id": 10272, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.021.m4a", "display_order": 22}, {"id": 6000272022, "chapter_id": 10272, "verse_number": "१०-७६-२०", "content_sanskrit": "कथं रुग्म्यरिपुत्राय प्रादाद् दुहितरं युधि।\nकृष्णेन परिभूतस्तं हन्तुं रन्ध्रं प्रतीक्षते॥ १०/७६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.022.m4a", "display_order": 23}, {"id": 6000272023, "chapter_id": 10272, "verse_number": "१०-७६-२१", "content_sanskrit": "एतदाख्याहि मे ब्रह्मन् द्विषोर्वैवाहिकीं क्रियाम्। अनागतमतीतं च वर्तमानमतीन्द्रियम्।\nविप्रकृष्टं व्यवहितं सम्यक् पश्यन्ति योगिनः॥ १०/७६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.023.m4a", "display_order": 24}, {"id": 6000272024, "chapter_id": 10272, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.024.m4a", "display_order": 25}, {"id": 6000272025, "chapter_id": 10272, "verse_number": "१०-७६-२२", "content_sanskrit": "यद्यप्यनुस्मरन् वैरं रुग्मी कृष्णावमानितः।\nव्यतरद् भागिनेयाय सुतां कुर्वन् स्वसुः प्रियम्॥ १०/७६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.025.m4a", "display_order": 26}, {"id": 6000272026, "chapter_id": 10272, "verse_number": "१०-७६-२३", "content_sanskrit": "तदेवानुस्मरन् वैरं रुग्मी कृष्णावमानितः।\nतोषयामास तपसा श्रीशैलनिलयं हरम्॥ १०/७६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.026.m4a", "display_order": 27}, {"id": 6000272027, "chapter_id": 10272, "verse_number": "१०-७६-२४", "content_sanskrit": "तपसाऽऽराधितो रुद्रो रुग्मिणा वरदर्षभः।\nवरेण च्छन्दयामास स च वव्रे दृढं धनुः॥ १०/७६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.027.m4a", "display_order": 28}, {"id": 6000272028, "chapter_id": 10272, "verse_number": "१०-७६-२५", "content_sanskrit": "अजेयं शत्रुसङ्घानामभेद्यं त्रिदशैरपि।\nतथेति कार्मुकं दत्त्वा वाक्यं चोवाच शङ्करः॥ १०/७६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.028.m4a", "display_order": 29}, {"id": 6000272029, "chapter_id": 10272, "verse_number": "१०-७६-२६", "content_sanskrit": "यदा विरुद्ध्यसे विष्णौ तदेतत् कार्मुकं नृप।\nहित्वा तदा त्वा मामेव प्रतिपत्स्यति नान्यथा॥ १०/७६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.029.m4a", "display_order": 30}, {"id": 6000272030, "chapter_id": 10272, "verse_number": "१०-७६-२७", "content_sanskrit": "इत्युक्त्वा कार्मुकं दत्वा शङ्करो न व्यदृश्यत।\nसोऽपि लब्धवरो राजा प्राप्य भोजकटं पुरम्॥ १०/७६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.030.m4a", "display_order": 31}, {"id": 6000272031, "chapter_id": 10272, "verse_number": "१०-७६-२८", "content_sanskrit": "तेन चापेन सकलान् नृपान् प्रख्यातपौरुषान्।\nवशीचकार सङ्ग्रामे रुग्मी कृष्णमृते नृप॥ १०/७६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.031.m4a", "display_order": 32}, {"id": 6000272032, "chapter_id": 10272, "verse_number": "१०-७६-२९", "content_sanskrit": "विरोद्धुं वासुदेवेन रुग्मी नैवाकरोन्मनः।\nधनुर्लोभान्महाराज न मैत्रीमप्यकल्मषाम्॥ १०/७६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.032.m4a", "display_order": 33}, {"id": 6000272033, "chapter_id": 10272, "verse_number": "१०-७६-३०", "content_sanskrit": "यद्यप्यनुस्मरन् वैरं गिरिशस्य स्मरन् वचः।\nवृतः स्वयंवरे साक्षादनङ्गोऽङ्गयुतस्तया॥ १०/७६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.033.m4a", "display_order": 34}, {"id": 6000272034, "chapter_id": 10272, "verse_number": "१०-७६-३१", "content_sanskrit": "राज्ञः समेतान् निर्जित्य जहारैकरथो युधि।\nअनिरुद्धो रुग्मवत्यां तस्यां जज्ञे महारथः॥ १०/७६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.034.m4a", "display_order": 35}, {"id": 6000272035, "chapter_id": 10272, "verse_number": "१०-७६-३२", "content_sanskrit": "जहार यं चित्रलेखा बाणपुत्र्या प्रचोदिता।\nसहस्रबाहुर्बाणश्च यत्कृते द्विभुजोऽभवत्॥ १०/७६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.035.m4a", "display_order": 36}, {"id": 6000272036, "chapter_id": 10272, "verse_number": "१०-७६-३३", "content_sanskrit": "रुग्मिण्यास्तनयां राजन् कृतवर्मसुतो बली।\nउपयेमे विशालाक्षः कन्यां चारुमतीं किल॥ १०/७६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.036.m4a", "display_order": 37}, {"id": 6000272037, "chapter_id": 10272, "verse_number": "१०-७६-३४", "content_sanskrit": "दौहित्रायानिरुद्धाय पौत्रीं रुग्म्यददाद् हरेः।\nरोचनां बद्धवैरोऽपि स्वसुः प्रियचिकीर्षया॥ १०/७६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.037.m4a", "display_order": 38}, {"id": 6000272038, "chapter_id": 10272, "verse_number": "१०-७६-३५", "content_sanskrit": "जानन्नधर्मं तद्योगं स्नेहपाशानुबन्धनः।\nतस्मिन्नभ्युदये राजन् रुग्मिणी रामकेशवौ॥ १०/७६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.038.m4a", "display_order": 39}, {"id": 6000272039, "chapter_id": 10272, "verse_number": "१०-७६-३६", "content_sanskrit": "पुरं भोजकटं जग्मुः साम्बप्रद्युम्नकादयः।\nतस्मिन् प्रवृत्त उद्वाहे कलिङ्गप्रमुखा नृपाः॥ १०/७६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.039.m4a", "display_order": 40, "topics": [{"text": "तत्र द्यूतप्रसङ्गे बलरामेण रुग्मिणो वधः", "range": "३६–५०"}]}, {"id": 6000272040, "chapter_id": 10272, "verse_number": "१०-७६-३७", "content_sanskrit": "दृप्तास्ते रुग्मिणं प्रोचुर्बलमक्षैर्विनिर्जय।\nअनक्षज्ञो बलो राजन्नपि तद्व्यसनी महान्॥ १०/७६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.040.m4a", "display_order": 41}, {"id": 6000272041, "chapter_id": 10272, "verse_number": "१०-७६-३८", "content_sanskrit": "इत्युक्तो बलमाहूय तेनाक्षै रुग्म्यदीव्यत।\nशतं सहस्रमयुतं रामस्तत्राददे पणम्॥ १०/७६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.041.m4a", "display_order": 42}, {"id": 6000272042, "chapter_id": 10272, "verse_number": "१०-७६-३९", "content_sanskrit": "तं तु रुग्म्यजयत् तत्र कलिङ्गः प्राहसद्बलम्।\nदन्तान् सन्दर्शयन्नुच्चैर्नामृष्यत् तद् हलायुधः॥ १०/७६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.042.m4a", "display_order": 43}, {"id": 6000272043, "chapter_id": 10272, "verse_number": "१०-७६-४०", "content_sanskrit": "ततो लक्षं रुग्म्यगृह्णाद् ग्लहं तदजयद् बलः।\nजितवानहमित्याह रुग्मी कैतवमाश्रितः॥ १०/७६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.043.m4a", "display_order": 44}, {"id": 6000272044, "chapter_id": 10272, "verse_number": "१०-७६-४१", "content_sanskrit": "मन्युना क्षुभितः श्रीमान् समुद्र इव पर्वणि।\nजातारुणाक्षोऽतिरुषा न्यर्बुदं ग्लहमाददे॥ १०/७६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.044.m4a", "display_order": 45}, {"id": 6000272045, "chapter_id": 10272, "verse_number": "१०-७६-४२", "content_sanskrit": "तं चापि जितवान् रामो धर्मेण च्छलतोऽब्रवीत्।\nरुग्मी जितं मयाऽत्रेमे वदन्तु प्राश्निका इति॥ १०/७६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.045.m4a", "display_order": 46}, {"id": 6000272046, "chapter_id": 10272, "verse_number": "१०-७६-४३", "content_sanskrit": "तथेत्याह कलिङ्गोऽपि दन्तान् सन्दर्श्य सीरिणः।\nततः कोपपरीतात्मा तूष्णीमासीद् हलायुधः॥ १०/७६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.046.m4a", "display_order": 47}, {"id": 6000272047, "chapter_id": 10272, "verse_number": "१०-७६-४४", "content_sanskrit": "तदाऽब्रवीन्नभोवाणी बलेनैव जितो ग्लहः।\nधर्मतो, वचनेनैव रुग्मी वदति वै मृषा॥ १०/७६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.047.m4a", "display_order": 48}, {"id": 6000272048, "chapter_id": 10272, "verse_number": "१०-७६-४५", "content_sanskrit": "तामनादृत्य वैदर्भो दुष्टराजन्यचोदितः।\nसङ्कर्षणं परिहसन् बभाषे कालचोदितः॥ १०/७६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.048.m4a", "display_order": 49}, {"id": 6000272049, "chapter_id": 10272, "verse_number": "१०-७६-४६", "content_sanskrit": "नैवाक्षकोविदा यूयं गोपाला वनगोचराः।\nअक्षैर्दीव्यन्ति राजानो बाणैश्च न भवादृशाः॥ १०/७६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.049.m4a", "display_order": 50}, {"id": 6000272050, "chapter_id": 10272, "verse_number": "१०-७६-४७", "content_sanskrit": "रुग्मिणैवमधिक्षिप्तो राजभिश्चोपहासितः।\nक्रुद्धस्त्वष्टापदेनैनं जघानोद्वाहपर्वणि॥ १०/७६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.050.m4a", "display_order": 51}, {"id": 6000272051, "chapter_id": 10272, "verse_number": "१०-७६-४८", "content_sanskrit": "कलिङ्गराजं तरसा गृहीत्वा दशमे पदे।\nदन्तानपातयत् क्रुद्धो योऽहसद् विवृतैर्द्विजैः॥ १०/७६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.051.m4a", "display_order": 52}, {"id": 6000272052, "chapter_id": 10272, "verse_number": "१०-७६-४९", "content_sanskrit": "अन्ये निर्भिन्नबाहूरुशिरसो रुधिरोक्षिताः।\nराजानो दुद्रुवुर्भीता बलेन परमार्दिताः॥ १०/७६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.052.m4a", "display_order": 53}, {"id": 6000272053, "chapter_id": 10272, "verse_number": "१०-७६-५०", "content_sanskrit": "निहते रुग्मिणि श्याले नाब्रवीत् साध्वसाधु वा।\nरुग्मिणीबलयो राजन् स्नेहभङ्गभयाद् हरिः॥ १०/७६/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.053.m4a", "display_order": 54}, {"id": 6000272054, "chapter_id": 10272, "verse_number": "१०-७६-५१", "content_sanskrit": "अथानिरुद्धं सह भार्यया वरं रथं समारोप्य ययुः कुशस्थलीम्।\nरामादयो भोजकटाद् दशार्हकाः सिद्धाखिलार्था मधुसूदनाश्रयाः॥ १०/७६/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_076/BhP_10.076.054.m4a", "display_order": 55}, {"id": 6000272055, "chapter_id": 10272, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे षट्सप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]