[{"id": 2083334, "chapter_id": 2777, "verse_number": "१२-२८२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083335, "chapter_id": 2777, "verse_number": "१२-२८२-१", "content_sanskrit": "भ्रातरः पितरः पौत्रा ज्ञातयः सुहृदः सुताः।\nअर्थहेतोर्हताः क्रूरैरस्माभिः पापबुद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083336, "chapter_id": 2777, "verse_number": "१२-२८२-२", "content_sanskrit": "येयमर्थोद्भवा तृष्णा कथमेतां पितामह।\nनिवर्तयेयं पापानि तृष्णया कारिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083337, "chapter_id": 2777, "verse_number": "१२-२८२-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083338, "chapter_id": 2777, "verse_number": "१२-२८२-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nगीतं विदेहराजेन माण्डव्यायानुपृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083339, "chapter_id": 2777, "verse_number": "१२-२८२-४", "content_sanskrit": "सुसुखं बत जीवामि यस्य मे नास्ति किंचन।\nमिथिलायां प्रदीप्तायां न मे दह्यति किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083340, "chapter_id": 2777, "verse_number": "१२-२८२-५", "content_sanskrit": "अर्थाः खलु समृद्धा हि गाढं दुःखं विजानताम्।\nअसमृद्धास्त्वपि सदा मोहयन्त्यविचक्षणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083341, "chapter_id": 2777, "verse_number": "१२-२८२-६", "content_sanskrit": "यच्च कामसुखं लोके यच्च दिव्यं महत्सुखम्।\nतृष्णाक्षयसुखस्यैते नार्हतः षोडशीं कलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083342, "chapter_id": 2777, "verse_number": "१२-२८२-७", "content_sanskrit": "यथैव शृङ्गं गोः काले वर्धमानस्य वर्धते।\nतथैव तृष्णा वित्तेन वर्धमानेन वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083343, "chapter_id": 2777, "verse_number": "१२-२८२-८", "content_sanskrit": "किंचिदेव ममत्वेन यदा भवति कल्पितम्।\nतदेव परितापाय नाशे संपद्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083344, "chapter_id": 2777, "verse_number": "१२-२८२-९", "content_sanskrit": "न कामाननुरुध्येत दुःखं कामेषु वै रतिः।\nप्राप्यार्थमुपयुञ्जीत धर्मं कामान्विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083345, "chapter_id": 2777, "verse_number": "१२-२८२-१०", "content_sanskrit": "विद्वान्सर्वेषु भूतेषु व्याघ्रमांसोपमो भवेत्।\nकृतकृत्यो विशुद्धात्मा सर्वं ज्यजति वै स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083346, "chapter_id": 2777, "verse_number": "१२-२८२-११", "content_sanskrit": "उभे सत्यानृते त्यक्त्वा शोकानन्दौ प्रियाप्रिये।\nभयाभये च संत्यज्य भव शान्तो निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083347, "chapter_id": 2777, "verse_number": "१२-२८२-१२", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः।\nयोसौ प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083348, "chapter_id": 2777, "verse_number": "१२-२८२-१३", "content_sanskrit": "चारित्रमात्मनः पश्यंश्चन्द्रशुद्धमनामयम्।\nधर्मात्मा लभते कीर्ति प्रेत्य चेह यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083349, "chapter_id": 2777, "verse_number": "१२-२८२-१४", "content_sanskrit": "राज्ञस्तद्वचनं श्रुत्वा प्रीतिमानभवद्द्विजः।\nपूजयित्वा च तद्वाक्यं माण्डव्यो मोक्षमाश्रितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083350, "chapter_id": 2777, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्व्यशीत्यधिकद्विशततमोऽध्यायः॥ २८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]