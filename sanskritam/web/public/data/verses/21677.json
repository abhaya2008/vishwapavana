[{"id": 7001677000, "chapter_id": 21677, "verse_number": "१-६३-१", "content_sanskrit": "शौनक उवाच ।\nसूत साधो चिरं जीव सर्वशास्त्रविशारदः ।\nयत्त्वया पायिता विद्वन्वयं कृष्णकथामृतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001677001, "chapter_id": 21677, "verse_number": "१-६३-२", "content_sanskrit": "श्रुत्वा तु मोक्षधर्मान्वै नारदो भगवत्प्रियः ।\nसनंदनमुखोद्गीतान्किं पप्रच्छं ततः परम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001677002, "chapter_id": 21677, "verse_number": "१-६३-३", "content_sanskrit": "मानसा ब्रह्मणः पुत्राः सनकाद्या मुनीश्वराः ।\nचरंति लोकानन्तसिद्धा लोकोद्धरणतत्पराः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001677003, "chapter_id": 21677, "verse_number": "१-६३-४", "content_sanskrit": "नारदोऽपि महाभाग नित्यं कृष्णपरायणः ।\nतेषां समागमे भद्रा का कथा लोकपावनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001677004, "chapter_id": 21677, "verse_number": "१-६३-५", "content_sanskrit": "सूत उवाच ।\nसाधु पृष्टं महाभाग त्वया लोकोपकारिणा ।\nकथयिष्यामि तत्सर्वं यत्पृष्ट नारदर्षिणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001677005, "chapter_id": 21677, "verse_number": "१-६३-६", "content_sanskrit": "श्रुत्वा सनंदनप्रोक्तान्मोक्षधर्मान्सनातनान् ।\nनारदो भार्गवश्रेष्ठ पुनः पप्रच्छ तान्मुनीन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001677006, "chapter_id": 21677, "verse_number": "१-६३-७", "content_sanskrit": "नारद उवाच ।\nसर्वदेवेश्वरो विष्णुर्वेदे तंत्रे च कीर्तितः ।\nसमाराध्यः स एवात्र सर्वैः सर्वार्थकांक्षिभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001677007, "chapter_id": 21677, "verse_number": "१-६३-८", "content_sanskrit": "कैर्मंत्रैर्भगवान्विष्णुः समाराध्यो मुनीश्वराः ।\nके देवाः पूजनीयाश्च विष्णुपादपरायणैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001677008, "chapter_id": 21677, "verse_number": "१-६३-९", "content_sanskrit": "तंत्रं भागवतं विप्रा गुरुशिष्यप्रयोजकम् ।\nदीक्षणं प्रातराद्यं च कृत्यं स्याद्यत्तदुच्यताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001677009, "chapter_id": 21677, "verse_number": "१-६३-१०", "content_sanskrit": "यैर्मासैः कर्मभिर्यैर्वा जप्यैर्होमादिभिस्तथा ।\nप्रीयेत परमात्मा वै तद्ब्रूत मम मानदाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001677010, "chapter_id": 21677, "verse_number": "१-६३-११", "content_sanskrit": "सूत उवाच ।\nएतच्छ्रुत्वा वचस्तस्य नारदस्य महात्मनः ।\nसनत्कुमारो भगवानुवाचार्कसमद्युतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001677011, "chapter_id": 21677, "verse_number": "१-६३-१२", "content_sanskrit": "सनत्कुमार उवाच ।\nश्रृणु नारद वक्ष्यामि तंत्रं भागवतं तव ।\nयज्ज्ञात्वाऽमलया भक्त्या साधयेद्विष्णुमव्ययम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001677012, "chapter_id": 21677, "verse_number": "१-६३-१३", "content_sanskrit": "त्रिपदार्थं चतुष्पादं महातंत्रं प्रचक्षते ।\nभोगमोक्षक्रियाचर्याह्वया पादाः प्रकीर्तिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001677013, "chapter_id": 21677, "verse_number": "१-६३-१४", "content_sanskrit": "पादार्थास्तु पशुपतिः पशुपाशास्त्रय एव हि ।\nपतिस्तत्र शिवोह्येको जीवास्तु पशवः स्मृताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001677014, "chapter_id": 21677, "verse_number": "१-६३-१५", "content_sanskrit": "यावन्मोहादिसंयोगाः स्वरूपाबोधलक्षणाः ।\nतावत्पशुत्वमेतेषां द्वैतवत्पश्य नारद ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001677015, "chapter_id": 21677, "verse_number": "१-६३-१६", "content_sanskrit": "पाशाः पंचविधास्त्वेषां प्रत्येकं तेषु लक्षणम् ।\nपशवस्त्रिविधाश्चापि विज्ञाताः कलसंज्ञिकाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001677016, "chapter_id": 21677, "verse_number": "१-६३-१७", "content_sanskrit": "तलपाकलसंज्ञश्च सकलश्चेति नामतः ।\nतत्राद्यो मलसंयुक्तो मलकर्मयुतः परः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001677017, "chapter_id": 21677, "verse_number": "१-६३-१८", "content_sanskrit": "मलमायाकर्मयुतस्तृतीयः परिकीर्तितः ।\nआद्यस्तु द्विविधस्तत्र समासकलुषस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001677018, "chapter_id": 21677, "verse_number": "१-६३-१९", "content_sanskrit": "असमासमलश्चेति द्वितीयोऽपि पुनस्तथा ।\nपक्वापक्वमलेनैव द्विविधः परिकीर्तितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001677019, "chapter_id": 21677, "verse_number": "१-६३-२०", "content_sanskrit": "शुद्धेऽध्वनि गतावेतौ विज्ञानप्रलयाकलौ ।\nकलादितत्त्वनियतः सकलः पर्यटत्ययम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001677020, "chapter_id": 21677, "verse_number": "१-६३-२१", "content_sanskrit": "कर्मानुगशरीरेषु तत्तद्भुवनगेषु च ।\nपाशाः पंच तथा तत्र प्रथमौ मलकर्मजौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001677021, "chapter_id": 21677, "verse_number": "१-६३-२२", "content_sanskrit": "मायेयश्च तिरोधानशक्तिजो बिंदुजः परः ।\nएकोऽप्यनेकशक्तिर्दृक्क्रियाच्छादनकोमलः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001677022, "chapter_id": 21677, "verse_number": "१-६३-२३", "content_sanskrit": "तुषकंचुकवद्देहनिमित्तं चात्मनामिह ।\nधर्माधर्मात्मकं कर्म विचित्रफलभोगदम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001677023, "chapter_id": 21677, "verse_number": "१-६३-२४", "content_sanskrit": "प्रवाहनित्यं तद्बीजांकुरन्यायेन संस्थितम् ।\nइत्येतौ प्रथमौ चाथ मायेयाद्यान् श्रृणुद्विज ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001677024, "chapter_id": 21677, "verse_number": "१-६३-२५", "content_sanskrit": "सञ्चिदानंदविभवः परमात्मा सनातनः ।\nपतिर्जयति सर्वेषामेको बीजं विभुः परम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001677025, "chapter_id": 21677, "verse_number": "१-६३-२६", "content_sanskrit": "मनस्यति न चोदेति निवृत्तिं च प्रयच्छति ।\nवर्वर्ति दृक्क्रियारूपं तत्तेजः शांभवं परम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001677026, "chapter_id": 21677, "verse_number": "१-६३-२७", "content_sanskrit": "शक्तो मया हरौ भुक्तो पशुगणस्य हि ।\nतच्छक्तिमाद्यामेकांतां विद्रूपाख्यां वदंति हि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001677027, "chapter_id": 21677, "verse_number": "१-६३-२८", "content_sanskrit": "तया चोज्जृंभितो बिंदुर्दिक्क्रियात्मा शिवाभिधः ।\nअशेषतत्त्वजातस्य कारणं विभुरव्ययम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001677028, "chapter_id": 21677, "verse_number": "१-६३-२९", "content_sanskrit": "अस्मिन्निलीना निखिला इच्छायाः शक्तयः स्वकम् ।\nकृत्यं कुर्वंति तेनेदं सर्वानुग्राहकं मुने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001677029, "chapter_id": 21677, "verse_number": "१-६३-३०", "content_sanskrit": "चिज्जडानुग्रहार्थाय यस्य विश्वं सिसृक्षतः ।\nआद्योन्मेषोऽस्य नादात्मा शांत्यादिभुवनात्मकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001677030, "chapter_id": 21677, "verse_number": "१-६३-३१", "content_sanskrit": "तच्छक्तितत्त्वं विप्रेंद्र प्रोक्तं सावयवं परम् ।\nततो ज्ञानक्रियाशक्त्योस्तथोत्कर्षापकर्षयोः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001677031, "chapter_id": 21677, "verse_number": "१-६३-३२", "content_sanskrit": "प्रसरश्चाप्यभावेन तत्त्वं चैतत्सदाशिवम् ।\nदृक्शक्तिर्यत्र न्यग्भूता क्रियाशक्तिर्विशिष्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001677032, "chapter_id": 21677, "verse_number": "१-६३-३३", "content_sanskrit": "ईश्वराख्यं तु तत्तत्त्वं प्रोक्तं सर्वार्थकर्तृकम् ।\nयत्र क्रिया हि न्यग्भूता ज्ञानाख्योद्रेकमश्नुते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001677033, "chapter_id": 21677, "verse_number": "१-६३-३४", "content_sanskrit": "तत्तत्त्वं चैव विद्याख्यं ज्ञानरूपं प्रकाशकम् ।\nनादो बिंदुश्च सकलः सदाख्यं तत्त्वमाश्रितौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001677034, "chapter_id": 21677, "verse_number": "१-६३-३५", "content_sanskrit": "विद्येशाः पुनरैशं तु मंत्रा विद्याभिधं पुनः ।\nइमानि चैव तत्त्वानि शुद्धाध्वेति प्रकीर्तितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001677035, "chapter_id": 21677, "verse_number": "१-६३-३६", "content_sanskrit": "साक्षान्निमित्तमीशोऽत्रेत्युपादानसबिंदुराट् ।\nपंचानां कालराहित्याक्रमो नास्तीति निश्चितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001677036, "chapter_id": 21677, "verse_number": "१-६३-३७", "content_sanskrit": "व्यापारवसतो ह्येषां विहिता खलु कल्पना ।\nतत्त्वं वस्तुत एकं तु शिवाख्यं चित्रशक्तिकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001677037, "chapter_id": 21677, "verse_number": "१-६३-३८", "content_sanskrit": "शक्तं यां वृत्तिभेदात्तुविहिताः खलु कल्पनाः ।\nचिज्जडानुग्रहार्थाय कृत्वा रूपाणि वै प्रभुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001677038, "chapter_id": 21677, "verse_number": "१-६३-३९", "content_sanskrit": "अनादिमलरुद्धानां कुरुतेऽनुग्रहं चिताम् ।\nमुक्तिं च विश्वेषां स्वव्यापारे समर्थेताम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001677039, "chapter_id": 21677, "verse_number": "१-६३-४०", "content_sanskrit": "विधत्ते जडवर्गस्य सर्वानुग्राहकः शिवः ।\nशिवसामान्यरूपो हि मोक्षस्तु चिदनुग्रहः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001677040, "chapter_id": 21677, "verse_number": "१-६३-४१", "content_sanskrit": "सोऽनादित्वात्कर्मणो हि तत्तद्भोगं विना भवेत् ।\nतेनानुग्राहकः शम्भुस्तद्भुक्त्यै प्रभुर्व्ययः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001677041, "chapter_id": 21677, "verse_number": "१-६३-४२", "content_sanskrit": "कुरुते सूक्ष्मकरणभुवनोत्पत्तिमंजसा ।\nकर्त्तोपादानकरणैर्विना कार्ये न दृश्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001677042, "chapter_id": 21677, "verse_number": "१-६३-४३", "content_sanskrit": "शक्तयः करणं चात्र मायोपादानमिष्यते ।\nनित्यैका च शिवा शक्त्या ह्यनादिनिधना सती ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001677043, "chapter_id": 21677, "verse_number": "१-६३-४४", "content_sanskrit": "साधारणी नराणां वै भुवनानां च कारणम् ।\nस्वभावान्मोहजननी स्वचिताजनकर्मभिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001677044, "chapter_id": 21677, "verse_number": "१-६३-४५", "content_sanskrit": "विश्वी सूक्ष्मा परा माया विकृतैः परत्तु सा ।\nकर्माण्यावेक्ष्य विद्येशो मायां विक्षोभ्य शक्तिभिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001677045, "chapter_id": 21677, "verse_number": "१-६३-४६", "content_sanskrit": "विधत्ते जीवभोगार्थं वपूंषि करणानि च ।\nसृजत्यादो कालतत्त्वं नानाशक्तिमयी च सा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001677046, "chapter_id": 21677, "verse_number": "१-६३-४७", "content_sanskrit": "भावि भूतं मवञ्चेदं जगत्कलयते लयम् ।\nसूते ह्यनंतरं माया शक्तिं नियमनात्मिकाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001677047, "chapter_id": 21677, "verse_number": "१-६३-४८", "content_sanskrit": "सर्वं नियमयत्येषा तेनेयं नियतिः स्मृता ।\nअनंतरं च सा माया नित्या विश्वविमोहिनी ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001677048, "chapter_id": 21677, "verse_number": "१-६३-४९", "content_sanskrit": "अनादिनिधना तत्त्वं कलाख्यं जनयत्यपि ।\nएकतस्तु नृणां येन कलयित्वा मलं ततः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001677049, "chapter_id": 21677, "verse_number": "१-६३-५०", "content_sanskrit": "कर्तृशक्तिं व्यंजयति तेनेदं तु कलाभिधम् ।\nकालेन च नियत्योपसर्गतां समुपेतया ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001677050, "chapter_id": 21677, "verse_number": "१-६३-५१", "content_sanskrit": "व्यापारं विदधात्येषा भूपर्यंतं स्वकीयकम् ।\nप्रदर्शनाथ वै पुंसो विषयाणां च सा पुनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001677051, "chapter_id": 21677, "verse_number": "१-६३-५२", "content_sanskrit": "प्रकाशरूपं विद्याख्यं तत्त्वं सूते कलैव हि ।\nविद्या त्वावरणं भित्वा ज्ञानशक्तेः स्वकर्मणा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001677052, "chapter_id": 21677, "verse_number": "१-६३-५३", "content_sanskrit": "विषयान्दर्शयत्येषात्मनांशाकारणं ह्यतः ।\nकरोति भोग्यं यानासौ करणेन परेण वै ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001677053, "chapter_id": 21677, "verse_number": "१-६३-५४", "content_sanskrit": "उद्बुद्धशक्तिः पुरुषः प्रचोद्य महदादिकान् ।\nभोग्ये भोगं च भोक्तारं तत्परं करणं तु सा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001677054, "chapter_id": 21677, "verse_number": "१-६३-५५", "content_sanskrit": "भोग्येस्य भोग्यतिर्मासाञ्चिद्व्यक्तिर्भोग उच्यते ।\nसुखादिरूपो विषयाकारा बुद्धिः समासतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001677055, "chapter_id": 21677, "verse_number": "१-६३-५६", "content_sanskrit": "भोग्यं भोक्तुश्च स्वेनैव विद्याख्यं करणं तु तत् ।\nयद्यर्कवत्प्रकाशा धीः कर्मत्वाञ्च तथापि हि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001677056, "chapter_id": 21677, "verse_number": "१-६३-५७", "content_sanskrit": "करणांतरसापेक्षा शक्ता ग्राहयितुं च तम् ।\nसंबन्धात्कारणाद्यैस्तद्भोगौत्सुक्येन चोदनात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001677057, "chapter_id": 21677, "verse_number": "१-६३-५८", "content_sanskrit": "तञ्चष्टाफलयोगाञ्च संसिद्धा कर्तृतास्य तु ।\nअकर्तृत्वाभ्युपगमे भोक्तृत्वाख्या वृथास्य तु ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001677058, "chapter_id": 21677, "verse_number": "१-६३-५९", "content_sanskrit": "किं च प्रधानचरितं व्यर्थं सर्वं भवेत्ततः ।\nकर्तृत्वरहिते पुंसि करणाद्यप्रयोजके ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001677059, "chapter_id": 21677, "verse_number": "१-६३-६०", "content_sanskrit": "भोगस्यासंभवस्तस्मात्स एवात्र प्रवर्तकः ।\nकरणादिप्रयोक्तॄत्वं विद्ययैवास्य संमतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001677060, "chapter_id": 21677, "verse_number": "१-६३-६१", "content_sanskrit": "अनंतरं कलारागं सूते भिद्यंगरूपकम् ।\nयेन भोग्याय जनिता भिद्यंगे पुरुषे पुनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001677061, "chapter_id": 21677, "verse_number": "१-६३-६२", "content_sanskrit": "क्रियाप्रवृत्तिर्भवति तेनेदं रागसंज्ञिकम् ।\nएभिस्तत्त्वैश्च भोक्तृत्वदशायां कलितो यदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001677062, "chapter_id": 21677, "verse_number": "१-६३-६३", "content_sanskrit": "नित्यस्तदायमात्मा तु लभते पुरुषाभिधाम् ।\nकलैव प्रश्चादव्यक्तं सूते भोग्याय चास्य तु ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001677063, "chapter_id": 21677, "verse_number": "१-६३-६४", "content_sanskrit": "सप्तग्रंथिविधानस्य यत्तद्गौणस्यकारणम् ।\nगुणानामविभागोऽत्र ह्याधारे क्ष्मादिभागवत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001677064, "chapter_id": 21677, "verse_number": "१-६३-६५", "content_sanskrit": "आधारोऽपि च यस्तेषां तदव्यक्तं च गीयते ।\nत्रय एव गुणा ह्यषामव्यक्तादेव संभवः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001677065, "chapter_id": 21677, "verse_number": "१-६३-६६", "content_sanskrit": "सत्त्वं रजस्तमःप्रख्या व्यापारनियमात्मिका ।\nगुणतो धीश्च विषयाध्यवसायस्वरूपिणी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001677066, "chapter_id": 21677, "verse_number": "१-६३-६७", "content_sanskrit": "गुणतस्त्रिविधा सापि प्रोक्ता कर्मानुसारतः ।\nमहत्तत्तवादहंकारो जातः संरंभवृत्तिमान् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001677067, "chapter_id": 21677, "verse_number": "१-६३-६८", "content_sanskrit": "संभोदादस्य विषयः प्राप्नोति व्यवहार्यताम् ।\nसत्त्वा द्विगुणभेदेन स पुनस्त्रिविधो भवेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001677068, "chapter_id": 21677, "verse_number": "१-६३-६९", "content_sanskrit": "तैजसो राजसश्चैव तामसश्चेति नामतः ।\nतत्र तैजसतो ज्ञानेंद्रियाणि मनसा सह ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001677069, "chapter_id": 21677, "verse_number": "१-६३-७०", "content_sanskrit": "प्रकाशान्व यतस्तस्माद्वोधकानि भवन्ति हि ।\nराजसाञ्च क्रियाहेतोस्तथा कर्मेंद्रियाणि तु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001677070, "chapter_id": 21677, "verse_number": "१-६३-७१", "content_sanskrit": "तामसाञ्चैव जायन्ते तन्मात्रा भूतयोनयः ।\nइच्छारूपं च संकल्पव्यापारं तत्र वै मनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001677071, "chapter_id": 21677, "verse_number": "१-६३-७२", "content_sanskrit": "द्विधाधिकारि तञ्चित्तं भोक्तृभोगोपपादकम् ।\nबहिः करणभावेन स्वोचितेन यतः सदा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001677072, "chapter_id": 21677, "verse_number": "१-६३-७३", "content_sanskrit": "इंद्रियाणां च सामर्थ्यं संकल्पेनात्मवृत्तिना ।\nकरोत्यंतःस्थितं भूयस्ततोऽन्तः करणं मनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001677073, "chapter_id": 21677, "verse_number": "१-६३-७४", "content_sanskrit": "मनोऽहंकारबुद्ध्याख्यमस्त्यन्तः कारणं त्रिधा ।\nइच्छासंरंभबोधाख्या वृत्तयः क्रमतोऽस्य तु ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001677074, "chapter_id": 21677, "verse_number": "१-६३-७५", "content_sanskrit": "ज्ञानेंद्रियाणि श्रोत्रं त्वक् चक्षुर्जिह्वा च नासिका ।\nग्राह्याश्च विषया ह्येषां ज्ञेयाः शब्दादयो मुने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001677075, "chapter_id": 21677, "verse_number": "१-६३-७६", "content_sanskrit": "शब्दस्पर्शरूपरसगन्धाः शब्दादयो मताः ।\nवाक्पाणिपादपायूपस्थास्तु कर्मेंद्रियाण्यपि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001677076, "chapter_id": 21677, "verse_number": "१-६३-७७", "content_sanskrit": "वचनादानगमनोत्सर्गानंदेषु कर्मसु ।\nकरणानि च सिद्धिना न कृतिः करणैर्विना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001677077, "chapter_id": 21677, "verse_number": "१-६३-७८", "content_sanskrit": "दशधा करणैश्चेष्टां कार्यमाविश्य कार्यते ।\nचेष्टंते कार्यमालंब्य विभुत्वात्करणानि तु ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001677078, "chapter_id": 21677, "verse_number": "१-६३-७९", "content_sanskrit": "तन्मात्राणि तु खवायुस्तेजोऽम्भः क्ष्मेति पञ्च वै ।\nतेभ्यो भूतान्येकगुणान्याख्यातानि भवंति हि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001677079, "chapter_id": 21677, "verse_number": "१-६३-८०", "content_sanskrit": "इति पञ्चसु शब्दोऽयं स्पर्शो भूतचतुष्टये ।\nरूपं त्रिषु रसश्चैव द्वयोर्गंधः क्षितौ तथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001677080, "chapter_id": 21677, "verse_number": "१-६३-८१", "content_sanskrit": "कार्याण्येषां क्रमेणैवावकाशो व्यूहकल्पनम् ।\nपाकश्च संग्रहश्चैव धारणं चेति कथ्यते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001677081, "chapter_id": 21677, "verse_number": "१-६३-८२", "content_sanskrit": "आशीतोष्णौ महा वाद्यौ शीतोष्णौ वारितेजसोः ।\nभास्वदग्नौ जले शुक्लं क्षितौ शुक्लाद्यनेकधा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001677082, "chapter_id": 21677, "verse_number": "१-६३-८३", "content_sanskrit": "रूपं त्रिषु रसोंऽभः सु मधुरः षड्विधः क्षितौ ।\nगन्धः क्षितावसुरभिः सुरभिश्च प्रकीर्तितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001677083, "chapter_id": 21677, "verse_number": "१-६३-८४", "content_sanskrit": "तन्मात्रं तद्भूतगुणं करणं पोषणं तथा ।\nभूतस्य तु विशेषोऽयं विशेषरहितं तु तत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001677084, "chapter_id": 21677, "verse_number": "१-६३-८५", "content_sanskrit": "इमानि पञ्चभूतानि संनिविष्टानि सर्वतः ।\nपञ्चभूतात्मकं सर्वं जगत्स्थावरजङ्गमम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001677085, "chapter_id": 21677, "verse_number": "१-६३-८६", "content_sanskrit": "शरीरसंनिविष्टत्वमेषां तावन्निरूप्यते ।\nदेहेऽस्थिमांसकेशत्वङ्नखदन्ताश्च पार्थिवाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001677086, "chapter_id": 21677, "verse_number": "१-६३-८७", "content_sanskrit": "मूत्ररक्तकफस्वेदशुक्रादिषु जलस्थितिः ।\nहृदि पंक्तौ दृशोः पित्ते तेजस्तद्धर्मदर्शनात् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001677087, "chapter_id": 21677, "verse_number": "१-६३-८८", "content_sanskrit": "प्राणादिवृत्तिभेदेन वायुश्चैवात्र संस्थितः ।\nवियत्सर्वासु नाडीषु गर्भवृत्यनुषंगतः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001677088, "chapter_id": 21677, "verse_number": "१-६३-८९", "content_sanskrit": "प्रयोक्त्यादिमहीप्रांतमेतदंडार्थसाधनम् ।\nप्रत्यात्मनियतं भोगभेदतो व्यवसीयते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001677089, "chapter_id": 21677, "verse_number": "१-६३-९०", "content_sanskrit": "तत्त्वान्येवं कलाद्यानि प्रतिपुंनियतानि हि ।\nदेहेषु कर्मवशतः सर्वेषु विचरंति हि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001677090, "chapter_id": 21677, "verse_number": "१-६३-९१", "content_sanskrit": "मायेयश्चैव पाशोऽयं येनावृतमिदं जगत् ।\nअशुद्धाध्वामतो ह्येष धरण्यादिकलावधिः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001677091, "chapter_id": 21677, "verse_number": "१-६३-९२", "content_sanskrit": "तत्र भूमण्डलस्थोऽसौ स्थावरो जङ्गमात्मकः ।\nस्थावरा गिरिवृक्षाद्या जङ्गमस्त्रिविधः पुनः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001677092, "chapter_id": 21677, "verse_number": "१-६३-९३", "content_sanskrit": "स्वेदजाश्चांडजाश्चैव तथैव च जरायुजाः ।\nचराचरेषु लक्षाणां चतुराशीतियोनयः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001677093, "chapter_id": 21677, "verse_number": "१-६३-९४", "content_sanskrit": "भ्रममाणस्तेषु जीवः कदाचिन्मानुषं वपुः ।\nप्राप्नोति कर्मवशतः परं सर्वार्थसाधकम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001677094, "chapter_id": 21677, "verse_number": "१-६३-९५", "content_sanskrit": "तत्रापि भारते खण्डे ब्राह्मणादिकुलेषु च ।\nमहापुण्यवशेनैव जनिर्भवति दुर्लभा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001677095, "chapter_id": 21677, "verse_number": "१-६३-९६", "content_sanskrit": "जनिश्च पुंस्त्रियोर्योगः शुक्रशोणितयोगतः ।\nबिंदुरेकः प्रविशति यदा गर्भे द्वयात्मकः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001677096, "chapter_id": 21677, "verse_number": "१-६३-९७", "content_sanskrit": "तदा रजोऽधिके नारी भवेद्रेतोऽधिके पुमान् ।\nमलकर्मादिपाशेन कश्चिदात्मा नियंत्रितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001677097, "chapter_id": 21677, "verse_number": "१-६३-९८", "content_sanskrit": "जीवभावं तदा तस्मिन्सकलः प्रतिपद्यते ।\nअथ तत्राहृतैर्मात्रा पानान्नाद्यैश्च पोषितः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001677098, "chapter_id": 21677, "verse_number": "१-६३-९९", "content_sanskrit": "पक्षमासादिकालेन वर्धते वपुरत्र हि ।\nदुःखाद्यः पीडितश्चैवाच्छन्नदेहो जरायुणा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001677099, "chapter_id": 21677, "verse_number": "१-६३-१००", "content_sanskrit": "एवं तत्र स्थितो गर्भे प्राग्जन्‌मोत्थं शुभाशुभम् ।\nस्मरंस्तिष्टति दुःखात्मापीड्यमानो मुहुर्मुहुः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001677100, "chapter_id": 21677, "verse_number": "१-६३-१०१", "content_sanskrit": "कालक्रमेण बालोऽसौ मातरं पीडयन्नपि ।\nसंपीडितो निःसरति योनियंत्रादवाङ्मुखः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001677101, "chapter_id": 21677, "verse_number": "१-६३-१०२", "content_sanskrit": "क्षणं तिष्ठति निश्चेष्टस्ततो रोदितुमिच्छति ।\nततः क्रमेण स शिशुर्वर्धमानो दिनेदिने ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001677102, "chapter_id": 21677, "verse_number": "१-६३-१०३", "content_sanskrit": "बालपौगंडभेदेन युवत्वं प्रतिपद्यते ।\nएवं क्रमेण लोकेऽस्मिन्देहिनां देहसंभवः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001677103, "chapter_id": 21677, "verse_number": "१-६३-१०४", "content_sanskrit": "मानुषं दुर्लभं प्राप्य सर्वलोकोपकारकम् ।\nयस्तारयति नात्मानं तस्मात्पापतरोऽत्र कः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001677104, "chapter_id": 21677, "verse_number": "१-६३-१०५", "content_sanskrit": "आहारश्चैव निद्रा च भयं मैथुनमेव च ।\nपश्वादीनां च सर्वेषां च सर्वेषां साधारणमितीरितम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001677105, "chapter_id": 21677, "verse_number": "१-६३-१०६", "content_sanskrit": "चतुर्ष्वेवानुरक्तो यः स मूर्खो ह्यात्मधातकः ।\nमनुष्याणामयं धर्मः रवबंधच्छेदनात्मकः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001677106, "chapter_id": 21677, "verse_number": "१-६३-१०७", "content_sanskrit": "पाशबंधनविच्छेदो दीक्षयैव प्रजायते ।\nअतो बंधनविच्छित्त्यै मंत्रदीक्षां समाचरेत् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001677107, "chapter_id": 21677, "verse_number": "१-६३-१०८", "content_sanskrit": "दीक्षाज्ञानाख्यया शक्त्या ह्यपध्वंसितबन्धनः ।\nशुद्धात्मतत्त्वनामासौ निर्वाणपदमश्नुते ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001677108, "chapter_id": 21677, "verse_number": "१-६३-१०९", "content_sanskrit": "स्वशक्त्यात्मिकया दृष्ट्या शिवं ध्यायति पश्यति ।\nयजते शिवमंत्रैश्च स्वपरेषां हिताय सः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001677109, "chapter_id": 21677, "verse_number": "१-६३-११०", "content_sanskrit": "शिवार्कशक्तिदीधित्या समर्थीकृतचिद्दृशा ।\nशिवशक्त्यादिभिः सार्द्धं पश्यत्यात्मगतावृतिः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001677110, "chapter_id": 21677, "verse_number": "१-६३-१११", "content_sanskrit": "अंतःकरणवृत्तिर्या बोधाख्या सा महेश्वरम् ।\nन प्रकाशयितुं शक्ता पाशत्वान्निगडादिवत् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001677111, "chapter_id": 21677, "verse_number": "१-६३-११२", "content_sanskrit": "दीक्षैव परमो हेतुः पाशविच्छेदने पुनः ।\nअतः शास्त्रोक्तविधिना मन्त्रदीक्षां समाचरेत् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001677112, "chapter_id": 21677, "verse_number": "१-६३-११३", "content_sanskrit": "दीक्षितस्तंत्रविधिना स्ववर्णाचारतत्परः ।\nअनुष्ठानं प्रकुर्वीत नित्यनैमित्तिकात्मकम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001677113, "chapter_id": 21677, "verse_number": "१-६३-११४", "content_sanskrit": "निजवर्णाश्रमाचारान्मनसापि न लंघयेत् ।\nयो यस्मिन्नाश्रमे तिष्ठन्दीक्षां प्राप्नोति मानवः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001677114, "chapter_id": 21677, "verse_number": "१-६३-११५", "content_sanskrit": "स तस्मिन्नाश्रमे तिष्ठेत्तद्धर्माननुपालयेत् ।\nकृतान्यपि न कर्माणि बंधनाय भवंति हि ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001677115, "chapter_id": 21677, "verse_number": "१-६३-११६", "content_sanskrit": "एकं तु फलदं कर्म मंत्रानुष्ठानसंभवम् ।\nदीक्षितोऽभिलषेद्भोगान्यद्यल्लोकगतानसौ ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001677116, "chapter_id": 21677, "verse_number": "१-६३-११७", "content_sanskrit": "मंत्राराधनसामर्थ्यात्तद्भुक्त्वा मोक्षमश्नुते ।\nनित्यं नैमित्तिकं दीक्षां प्राप्य यो नाचरेन्नरः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001677117, "chapter_id": 21677, "verse_number": "१-६३-११८", "content_sanskrit": "कंचित्कालं पिशाचत्वं प्राप्यांते मोक्षमश्नुते ।\nतस्मात्तु दीक्षितः कुर्य्यान्नित्यनैमित्तिकादिकम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001677118, "chapter_id": 21677, "verse_number": "१-६३-११९", "content_sanskrit": "अनुष्ठानं च तेनास्य दीक्षां प्राप्याऽनुमीयते ।\nनित्यनैमित्तिकाचार पालकस्य नरस्य तु ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001677119, "chapter_id": 21677, "verse_number": "१-६३-१२०", "content_sanskrit": "दीक्षावैकल्यविरहात्सद्यो मुक्तिस्तु जायते ।\nतत्रापि गुरुभक्तस्य गतिर्भवति नान्यथा ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001677120, "chapter_id": 21677, "verse_number": "१-६३-१२१", "content_sanskrit": "दीक्षया गुरुमूर्तिस्थः सर्वानुग्राहकः शिवः ।\nदृष्टाद्यर्थतया यस्य गुरुभक्तिस्तु कृत्रिमा ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001677121, "chapter_id": 21677, "verse_number": "१-६३-१२२", "content_sanskrit": "कृतेऽपि विफलं तस्य प्रायश्चित्तं पदे पदे ।\nकायेन मनसा वाचा गुरुभक्तिपरस्य च ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001677122, "chapter_id": 21677, "verse_number": "१-६३-१२३", "content_sanskrit": "प्रायश्चित्तं भवेन्नैव सिद्धिस्तस्य पदे पदे ।\nगुरुभक्तियुते शिष्ये सर्वस्वविनिवेदके ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001677123, "chapter_id": 21677, "verse_number": "१-६३-१२४", "content_sanskrit": "मिथ्याप्रयुक्तमन्त्रस्तु प्रायश्चित्ती भवेद्गुरुः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}]