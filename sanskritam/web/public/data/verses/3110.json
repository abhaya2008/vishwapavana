[{"id": 2098626, "chapter_id": 3110, "verse_number": "१३-२४०-१", "content_sanskrit": "उमोवाच।\nभगवन्सर्वभूतेश पुरमर्दन शङ्कर।\nश्रुतं पापकृतां दुःखं यमलोके वरप्रद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098627, "chapter_id": 3110, "verse_number": "१३-२४०-२", "content_sanskrit": "श्रोतुमिच्छाम्यहं देव नृणां सुकृतकर्मणाम्।\nकथं ते भुञ्जते भोगान्स्वर्गलोके महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098628, "chapter_id": 3110, "verse_number": "१३-२४०-३", "content_sanskrit": "कथिताः कीदृशा लोका नृणां सुकृतकारिणाम्।\nएतन्मे वद देवश श्रोतुं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098629, "chapter_id": 3110, "verse_number": "१३-२४०-४x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098630, "chapter_id": 3110, "verse_number": "१३-२४०-४", "content_sanskrit": "शृणु कल्याणि तत्सर्वं यत्त्वमिच्छसि शोभने।\nविविधाः पुण्यलोकास्ते कर्मकर्मण्यतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098631, "chapter_id": 3110, "verse_number": "१३-२४०-५", "content_sanskrit": "मेरुं हि कनकात्मानं परितः सर्वतोदिशम्।\nभद्राश्चः केतुमालश्च उत्तराः कुरवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098632, "chapter_id": 3110, "verse_number": "१३-२४०-६", "content_sanskrit": "जम्बूवनादयः स्वर्गा इत्येते कर्मवर्जिताः।\nतेषु भूत्वा स्वयंभूताः प्रदृश्यते यतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098633, "chapter_id": 3110, "verse_number": "१३-२४०-७", "content_sanskrit": "योजनानां सहस्रं च एकैकं मानमात्रया।\nनित्यं पुष्पफलोपेतास्तत्र वृक्षाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098634, "chapter_id": 3110, "verse_number": "१३-२४०-८", "content_sanskrit": "आसक्तवस्त्राभरणाः सर्वे कनकसन्निभाः।\nद्विरेफाश्चाण्डजास्तत्र प्रवालमणिसन्निभाः।\nविचित्राश्च मनोज्ञाश्च कूजितैः शोभयन्ति तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098635, "chapter_id": 3110, "verse_number": "१३-२४०-९", "content_sanskrit": "कुशेशयवनच्छन्ना नलिन्यश्च मनोरमाः।\nतत्र वान्त्यनिला नित्यं दिव्यगन्धसुखावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098636, "chapter_id": 3110, "verse_number": "१३-२४०-१०", "content_sanskrit": "सर्वे चाम्लानमाल्याश्च विरजोम्बरसंवृताः।\nएवं बहुविधा देवि दिव्यभोगाः सुखावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098637, "chapter_id": 3110, "verse_number": "१३-२४०-११", "content_sanskrit": "स्त्रियश्च पुरुषाश्चैव सर्वे सुकृतकारिणः।\nरमन्ते तत्र चान्योन्यं कामरागसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098638, "chapter_id": 3110, "verse_number": "१३-२४०-१२", "content_sanskrit": "मनोहरा महाभागाः सर्वे ललितकुण्डलाः।\nएवं तत्र स्थिता मर्त्याः प्रमदाः प्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098639, "chapter_id": 3110, "verse_number": "१३-२४०-१३", "content_sanskrit": "नानाभावसमायुक्ता यौवनस्थाः सदैव तु।\nयुवत्यः कल्पितास्तत्र कामजा ललितास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098640, "chapter_id": 3110, "verse_number": "१३-२४०-१४", "content_sanskrit": "मनोनुकूला मधुरा भोगिनामुपकल्पिताः।\nप्रमदाश्चोद्भवन्त्येव स्वर्गलोके यथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098641, "chapter_id": 3110, "verse_number": "१३-२४०-१५", "content_sanskrit": "एवंविधाः स्त्रियश्चात्र पुरुषाश्च परस्परम्।\nरमन्ते चेन्द्रियैः स्वस्थै शरीरैर्भोगसंस्कृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098642, "chapter_id": 3110, "verse_number": "१३-२४०-१६", "content_sanskrit": "कामहर्षगुणाभ्यस्ता नान्ये क्रोधादयः प्रिये।\nक्षुत्पिपासा न चास्त्यत्रि गात्रक्लेशाश्च शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098643, "chapter_id": 3110, "verse_number": "१३-२४०-१७", "content_sanskrit": "सर्वतो रमणीयं च सर्वत्र कुसुमान्विम्।\nयावत्पुण्यफलं तावद्दृश्यन्ते बहुसङ्गताः।\nनिरन्तरं भोगयुता रमन्ते स्वर्गवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098644, "chapter_id": 3110, "verse_number": "१३-२४०-१८", "content_sanskrit": "तत्र भोगान्यथायोगं भुक्त्वा पुण्यक्षयात्पुनः।\nनश्यन्ति जायमानास्ते शरीरैः सहसा प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098645, "chapter_id": 3110, "verse_number": "१३-२४०-१९", "content_sanskrit": "स्वर्गलोकात्परिभ्रष्टाः जायन्ते मानुषे पुनः।\nपूर्वपुण्यावशेषेण विशिष्टाः सम्भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098646, "chapter_id": 3110, "verse_number": "१३-२४०-२०", "content_sanskrit": "एषा स्वर्गगतिः प्रोक्ता पृच्छन्त्यास्तव भामिनि।\nअत ऊर्ध्वं पदान्यष्टौ सुकर्माणि शृणु प्रिये।\nभोगयुक्तानि पुण्यानि उच्छ्रितानि परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098647, "chapter_id": 3110, "verse_number": "१३-२४०-२१", "content_sanskrit": "विद्याधराः किम्पुरुषा यक्षगन्धर्वकिन्नराः।\nअप्सरोदानवा देवा यथाक्रममुदाहृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098648, "chapter_id": 3110, "verse_number": "१३-२४०-२२", "content_sanskrit": "तेषु स्थानेषु जायन्ते प्राणिनाः पुण्यकर्मणः।\nतेषामपि च ये लोकाः स्वर्गलोकोपमाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098649, "chapter_id": 3110, "verse_number": "१३-२४०-२३", "content_sanskrit": "स्वर्गवत्तत्र ते भोगान्भुञ्जते च रमन्ति च।\nरूपसत्वबलोपेताः सर्वे दीर्घायुषस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098650, "chapter_id": 3110, "verse_number": "१३-२४०-२४", "content_sanskrit": "तेषां सर्वक्रियारम्भो मानुषेष्विव दृश्यते।\nअतिमानुषमैश्वर्यमत्र मायाबलात्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098651, "chapter_id": 3110, "verse_number": "१३-२४०-२५", "content_sanskrit": "जराप्रसूतिमरणं तेषु स्थानेषु दृश्यते।\nगुणा दोषाश्च सन्त्यत्र आकाशगमनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098652, "chapter_id": 3110, "verse_number": "१३-२४०-२६", "content_sanskrit": "अन्तर्धानं बलं सत्त्वमायुश्च चिरजीवितम्।\nतपोविशेषज्जायन्ते यथा कर्म्णि भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098653, "chapter_id": 3110, "verse_number": "१३-२४०-२७", "content_sanskrit": "देवलोके प्रवृत्तिस्तु तेषामेव विधीयते।\nन तथा देवलोको हि तद्विशिष्टाः सुराः स्मृताः॥i", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098654, "chapter_id": 3110, "verse_number": "१३-२४०-२८", "content_sanskrit": "तत्र भोगमनिर्देश्यममृतत्वं च विद्यते।\nविमानगमनं नित्यमप्सरोगणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098655, "chapter_id": 3110, "verse_number": "१३-२४०-२९", "content_sanskrit": "एवमन्यच्च तत्कर्म देवताभ्यो विशिष्यते।\nप्रत्यक्षं तव तत्सर्वं देवलोके प्रवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098656, "chapter_id": 3110, "verse_number": "१३-२४०-३०", "content_sanskrit": "तस्मान्न वर्णये देवि विदितं च त्वया शुभे।\nतत्सर्वं सुकृतैरेव प्राप्यते चोत्तमं पदम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098657, "chapter_id": 3110, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]