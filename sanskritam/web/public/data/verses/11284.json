[{"id": 50006029, "chapter_id": 11284, "verse_number": "1", "content_sanskrit": "--- --- तत्र स्पष्टार्थवच्छ्रुतिः। विशेषश्रुतिवैरूप्यं माहात्म्यं व्यक्तसद्गुणः 【पाठभेदः: BG—व्यक्तसद्गुणाः】 ॥ २॥ दृष्टायुक्तिः समानत्वं कर्तृशक्तिर्विमिश्रता। 【पाठभेदः: TRK—कर्तृशक्तिर्विमिश्रिता।】 युक्तयः पूर्वपक्षेषु सुनिर्णीतास्तु तादृशाः॥ युक्तयो निर्णयस्यैव स्वयं भगवतोदिताः॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006030, "chapter_id": 11284, "verse_number": "2", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते ब्रह्मसूत्रानुव्याख्याने द्वितीयाध्यायस्य चतुर्थः पादः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006031, "chapter_id": 11284, "verse_number": "3", "content_sanskrit": "॥ समाप्तश्चायमध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006032, "chapter_id": 11284, "verse_number": "4", "content_sanskrit": "॥ तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006033, "chapter_id": 11284, "verse_number": "5", "content_sanskrit": "॥ प्रथमः पादः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]