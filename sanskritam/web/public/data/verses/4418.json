[{"id": 2157798, "chapter_id": 4418, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157799, "chapter_id": 4418, "verse_number": "१", "content_sanskrit": "व्यथयेयुरिमे सेनां देवानामपि सञ्जय ।\nआहवे ये न्यवर्तन्त वृकोदरपुरोगमाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157800, "chapter_id": 4418, "verse_number": "२", "content_sanskrit": "सम्प्रयुक्तः किलैवायं दिष्टे भवति पूरुषः ।\nतस्मिन्नेव च सर्वार्था दृश्यन्तेऽर्थाः पृथग्विधाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157801, "chapter_id": 4418, "verse_number": "३", "content_sanskrit": "दीर्घं विप्रोषितः कालमरण्येषु जटाजिनी ।\nअज्ञातश्चैव लोकस्य विजहार युधिष्ठिरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157802, "chapter_id": 4418, "verse_number": "४", "content_sanskrit": "स एव महतीं सेनां समावर्तयदाहवे ।\nकिमन्यद् दैवसंयोगान्मम पुत्राभवाय च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157803, "chapter_id": 4418, "verse_number": "५", "content_sanskrit": "युक्त एव हि भाग्येन ध्रुवमुत्पद्यते नरः ।\nस तथाऽऽकृष्यते तेन न यथा स्वयमिच्छति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157804, "chapter_id": 4418, "verse_number": "६", "content_sanskrit": "द्यूतव्यसनमासाद्य क्लेशितो हि युधिष्ठिरः ।\nस पुनर्भागधेयेन सहायानुपलब्धवान् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157805, "chapter_id": 4418, "verse_number": "७", "content_sanskrit": "अर्धं मे केकया लब्धाः काशयः कोसलास्तथा॥\nचेदयश्चापरे वङ्गा मामेव समुपाश्रिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157806, "chapter_id": 4418, "verse_number": "८", "content_sanskrit": "पृथिवी भूयसी तात मम पार्थस्य नो तथा ।\nइति मामब्रवीत् सूत मन्दो दुर्योधनस्तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157807, "chapter_id": 4418, "verse_number": "९", "content_sanskrit": "तस्य सेनासमूहस्य मध्ये द्रोणः सुरक्षितः ।\nनिहतः पार्षतेनाजौ किमन्यद् भागधेयतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157808, "chapter_id": 4418, "verse_number": "१०", "content_sanskrit": "मध्ये राज्ञां महाबाहुं सदा युद्धाभिनन्दिनम् ।\nब्रह्मास्त्रविदुषं द्रोणं कथं मृत्युरुपेयिवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157809, "chapter_id": 4418, "verse_number": "११", "content_sanskrit": "समनुप्राप्तकृच्छ्रोऽहं सम्मोहं परमं गतः ।\nभीष्मद्रोणौ हतौ श्रुत्वा नाहं जीवितुमुत्सहे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157810, "chapter_id": 4418, "verse_number": "१२", "content_sanskrit": "यन्मां क्षत्ताऽब्रवीत् तात प्रपश्यन् पुत्रगृद्धिनम् ।\nदुर्योधनेन तत् प्राप्तं सर्वं सूत मया सह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157811, "chapter_id": 4418, "verse_number": "१३", "content_sanskrit": "नृशंसं तु परं तात त्यक्त्वा दुर्योधनं यदि ।\nपुत्रशेषस्तु रक्ष्यः स्यान्न सर्वमरणं भवेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157812, "chapter_id": 4418, "verse_number": "१४", "content_sanskrit": "यो हि धर्मं परित्यज्य भवत्यर्थपरो नरः ।\nअस्माच्च हीयते लोकात् क्षुद्रभावं च गच्छति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157813, "chapter_id": 4418, "verse_number": "१५", "content_sanskrit": "अद्य चाप्यस्य राष्ट्रस्य कृतोत्सेधस्य सञ्जय ।\nअवशेषं न पश्यामि कुरूणामीदृशे सति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157814, "chapter_id": 4418, "verse_number": "१६", "content_sanskrit": "कथं स्यादवशेषो हि धुर्ययोरप्यतीतयोः ।\nयौ नित्यमुपजीवामः क्षमिणौ पुरुषर्षभौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157815, "chapter_id": 4418, "verse_number": "१७", "content_sanskrit": "व्यक्तमेतद्धि मे शंस यथा युद्धमवर्तत ।\nकेऽयुध्यन् के ह्यपाकर्षन् के क्षुद्राः प्राद्रवन् भयात्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157816, "chapter_id": 4418, "verse_number": "१८", "content_sanskrit": "धनञ्जयं च मे शंस यद्यच्चक्रे रथर्षभः ।\nतस्माद् भयं नो भूयिष्ठं भ्रातृव्याणां भयङ्करात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157817, "chapter_id": 4418, "verse_number": "१९", "content_sanskrit": "यदासीत् सन्निवृत्तेषु पाण्डवेषु च सञ्जय ।\nमम सेनावशेषस्य सन्निपातः सुदारुणः\nमामकानां च ये शूराः तत्र तान् समवारयन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157818, "chapter_id": 4418, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157819, "chapter_id": 4418, "verse_number": "२३", "content_sanskrit": "द्रोणपर्वणि त्रयोविंशोऽध्यायः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157820, "chapter_id": 4418, "verse_number": "", "content_sanskrit": "संशप्तकवधपर्वणि अष्टमोऽध्यायः ॥ ८ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]