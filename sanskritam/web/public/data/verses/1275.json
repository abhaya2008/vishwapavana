[{"id": 2013400, "chapter_id": 1275, "verse_number": "२-१६-१", "content_sanskrit": "युधिष्ठिर उवाच॥\nसम्राड्गुणमभीप्सन्वै युष्मान्स्वार्थपरायणः।\nकथं प्रहिणुयां कृष्ण सोऽहं केवलसाहसात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013401, "chapter_id": 1275, "verse_number": "२-१६-२", "content_sanskrit": "भीमार्जुनावुभौ नेत्रे मनो मन्ये जनार्दनम्।\nमनश्चक्षुर्विहीनस्य कीदृशं जीवितं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013402, "chapter_id": 1275, "verse_number": "२-१६-३", "content_sanskrit": "जरासन्धबलं प्राप्य दुष्पारं भीमविक्रमम्।\nयमोपि न विजेताऽऽजौ तत्र वः किं विचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013403, "chapter_id": 1275, "verse_number": "२-१६-४", "content_sanskrit": "अस्मिंस्त्वर्थान्तरे युक्तमनर्थः प्रतिपद्यते।\nतस्मान्न प्रतिपत्तिस्तु कार्या युक्ता मता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013404, "chapter_id": 1275, "verse_number": "२-१६-५", "content_sanskrit": "यथाऽहं विमृशाम्येकस्तत्तावच्छ्रूयतां मम।\nसंन्यासं रोचये साधु कार्यस्यास्य जनार्दन।\nप्रतिहन्ति मनो मेऽद्य राजसूयो दूराहरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013405, "chapter_id": 1275, "verse_number": "२-१६-६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013406, "chapter_id": 1275, "verse_number": "२-१६-६", "content_sanskrit": "पार्थः प्राप्य धनुः श्रेष्ठमक्षय्यौ च महेषुधी।\nरथं ध्वजं हयांश्चैव युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013407, "chapter_id": 1275, "verse_number": "२-१६-७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013408, "chapter_id": 1275, "verse_number": "२-१६-७", "content_sanskrit": "धनुः शस्त्रं शरा वीर्यं पक्षो भूमिर्यशो बलम्।\nप्राप्तमेतन्मय राजन्दुष्प्रापं यदभीप्सितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013409, "chapter_id": 1275, "verse_number": "२-१६-८", "content_sanskrit": "कुले जन्म प्रशंसन्ति वैद्याः साधु सुनिष्ठिताः।\nबलेन सदृशं नास्ति वीर्यं तु मम रोचते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013410, "chapter_id": 1275, "verse_number": "२-१६-९", "content_sanskrit": "कृतवीर्यकुले जातो निर्वीर्यः किं करिष्यति।\nनिर्वीर्ये तु कुले जातो वीर्यवांस्तु विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013411, "chapter_id": 1275, "verse_number": "२-१६-१०", "content_sanskrit": "क्षत्रियः सर्वशो राजन्यस्य वृत्तिर्द्विषज्जये।\nसर्वैगुणैर्विहीनोऽपि वीर्यवान्हि तरेन्द्रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013412, "chapter_id": 1275, "verse_number": "२-१६-११", "content_sanskrit": "सर्वैरपि गुणैर्युक्तो निर्वीर्यः किं करिष्यति।\nजयस्य हेतुः सिद्धिर्हि कर्म दैवं च संश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013413, "chapter_id": 1275, "verse_number": "२-१६-१२", "content_sanskrit": "संयुक्तो हि बलैः कश्चित्प्रमादान्नोपयुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013414, "chapter_id": 1275, "verse_number": "२-१६-१३", "content_sanskrit": "तेन द्वारेण शत्रुभ्यः क्षीयते सबलो रिपुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013415, "chapter_id": 1275, "verse_number": "२-१६-१४", "content_sanskrit": "दैन्यं यथा बलवति तथा मोहो बलान्विते।\nतावुभौ नाशकौ हेतू राज्ञा त्याज्यौ जयार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013416, "chapter_id": 1275, "verse_number": "२-१६-१५", "content_sanskrit": "जरासन्धिविनाशं च राज्ञां च परिरक्षणम्।\nयदि कुर्याम् यज्ञार्थं किं ततः परमं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013417, "chapter_id": 1275, "verse_number": "२-१६-१६", "content_sanskrit": "अनारम्भे हि नियतो भवेदगुणनिश्चयः।\nगुणान्निः संशयाद्राजन्नैर्गुण्यं मन्यसे कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013418, "chapter_id": 1275, "verse_number": "२-१६-१७", "content_sanskrit": "काषायं सुलभं पश्चान्मुनीनां शममिच्छताम्।\nसाम्राज्यं तु भवेच्छक्यं वयं योत्स्यामहे परान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013419, "chapter_id": 1275, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि षोडशोऽध्यायः॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]