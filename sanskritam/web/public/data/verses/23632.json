[{"id": 7003632000, "chapter_id": 23632, "verse_number": "१-२-१९-१", "content_sanskrit": "नारद उवाच ।\nकालनेमी रुषाविष्टस्तेषां रूपं न बुद्धवान् ।\nततो निमिं च दैत्येन्द्रं मत्वा देवं महाजवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003632001, "chapter_id": 23632, "verse_number": "१-२-१९-२", "content_sanskrit": "केशेषु गृह्य तं वीरं चकर्ष च ननाद च ।\nततो निमिरुवाचेदं कालनेमिं महाबलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003632002, "chapter_id": 23632, "verse_number": "१-२-१९-३", "content_sanskrit": "अहं निमिः कालनेमे सुतं मत्वा वधस्व मा ।\nभवता मोहितेनाजौ देवान्मत्वासुराः स्वकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003632003, "chapter_id": 23632, "verse_number": "१-२-१९-४", "content_sanskrit": "सुरैः सुदुर्जयाः कोट्यो निहतादश विद्धि तत् ।\nसर्वास्त्रवारणं मुंच ब्रह्ममस्त्रं त्वरान्वितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003632004, "chapter_id": 23632, "verse_number": "१-२-१९-५", "content_sanskrit": "स तेन बोधितो दैत्यो मुक्त्वा तं संभ्रमाकुलः ।\nबाणं ब्रह्मास्त्रविहितं मुमोच त्वरयान्वितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003632005, "chapter_id": 23632, "verse_number": "१-२-१९-६", "content_sanskrit": "ब्रह्मास्त्रं तत्प्रजज्वाल ततः खे सुमहाद्भुतम् ।\nदेवानां चाभवत्सैन्यं सर्वमेव भयाकुलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003632006, "chapter_id": 23632, "verse_number": "१-२-१९-७", "content_sanskrit": "शंबरास्त्रं ततः शांतं ब्राह्मप्रतिहतं तदा ।\nतस्मिन्प्रतिहते ह्यस्त्रे भास्करः प्रभुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003632007, "chapter_id": 23632, "verse_number": "१-२-१९-८", "content_sanskrit": "महेंद्रजालमास्ताय चक्रे भीषणां तनुम् ।\nविस्फूर्जत्करसंघातसमाक्रांतजगत्त्रयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003632008, "chapter_id": 23632, "verse_number": "१-२-१९-९", "content_sanskrit": "तताप दानवानीकं गलन्मज्जाङ्घ्रिशोणितम् ।\nचक्षूंषि दानवेन्द्राणां चकारांधानि स प्रभुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003632009, "chapter_id": 23632, "verse_number": "१-२-१९-१०", "content_sanskrit": "गजानामगलन्मेदः पेतुश्चापि रथा भुवि ।\nतुरंगमाः श्वसंतश्च घर्मार्ता रथिनोपि च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003632010, "chapter_id": 23632, "verse_number": "१-२-१९-११", "content_sanskrit": "इतश्चेतश्च सलिलं प्रार्थयंतस्तृषातुराः ।\nगिरिद्रोणीश्च पादांश्च गिरिणां गहनानि च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003632011, "chapter_id": 23632, "verse_number": "१-२-१९-१२", "content_sanskrit": "तेषां प्रार्थयतां शीघ्रमन्योन्यं च विसर्पिणाम् ।\nदावाग्निरज्वलत्तीव्रो घोरो नर्दग्धपादपः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003632012, "chapter_id": 23632, "verse_number": "१-२-१९-१३", "content_sanskrit": "तोयार्थिनः पुरो दृष्ट्वा तोयं कल्लो लमालितम् ।\nपुरःस्थितमपि प्राप्तुं न शेकुरुपसादितुम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003632013, "chapter_id": 23632, "verse_number": "१-२-१९-१४", "content_sanskrit": "अप्राप्य सलिलं भूमावभ्याशे द्रुतमेव ते ।\nतत्रतत्र व्यदृश्यन्त मृता दैत्येश्वराभुवि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003632014, "chapter_id": 23632, "verse_number": "१-२-१९-१५", "content_sanskrit": "रथा गजाश्च पतितास्तुरंगाश्च श्रमान्विताः ।\nस्थिता वमंतो धावंतो गलद्द्रुतवसास्रजः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003632015, "chapter_id": 23632, "verse_number": "१-२-१९-१६", "content_sanskrit": "दानवानां कोटिकोटि व्यदृश्यतमृतं तदा ।\nएवं क्षयो जानवानां तस्मिन्महति वर्तिते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003632016, "chapter_id": 23632, "verse_number": "१-२-१९-१७", "content_sanskrit": "प्रकोपोद्भूतताम्राक्षः कालनेमी रुषातुरः ।\nबभूव कालमेधाभः स्फुरद्रोमशतह्रदः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003632017, "chapter_id": 23632, "verse_number": "१-२-१९-१८", "content_sanskrit": "गंभीरास्फोटनिर्ह्रादजगद्धृदयकंपनः ।\nप्रच्छाद्य गगनं सूर्यप्रभां सर्वां व्यनाशयत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003632018, "chapter_id": 23632, "verse_number": "१-२-१९-१९", "content_sanskrit": "ववर्ष शीतं च जलं दानवेन्द्रबलं प्रति ।\nदैत्यास्तां वृष्टिमासाद्य समाश्वस्तास्ततः क्रमात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003632019, "chapter_id": 23632, "verse_number": "१-२-१९-२०", "content_sanskrit": "बीजांकुरा इव म्लानाः प्राप्य वृष्टिं धरातले ।\nततः स मेघरूपेण कालनेमिर्महासुराः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003632020, "chapter_id": 23632, "verse_number": "१-२-१९-२१", "content_sanskrit": "शस्त्रवृष्टिं ववर्षोग्रां देवनीकेषु दुर्जयः ।\nतया वृष्ट्या पीड्यमाना दैत्यैरन्यैश्च देवताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003632021, "chapter_id": 23632, "verse_number": "१-२-१९-२२", "content_sanskrit": "गतिं कांचिन्न पश्यन्ति गावः शीतार्दिता इव ।\nपरस्परं व्यलीयंत गजेषु तुरगेषु च ।\nरथेषु च भयत्रस्तास्तत्रतत्र निलिल्यिरे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003632022, "chapter_id": 23632, "verse_number": "१-२-१९-२३", "content_sanskrit": "एवं ते लीयमानाश्च निहताः कालने मिना ।\nदृश्यंते पतिता देवाः शस्त्रभिन्नंगसंधयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003632023, "chapter_id": 23632, "verse_number": "१-२-१९-२४", "content_sanskrit": "विभिन्ना भिन्नमूर्धानस्तथा भिन्नोरुजानवः ।\nविपर्यस्तं रथांगैश्च पतितं ध्वजशक्तिभिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003632024, "chapter_id": 23632, "verse_number": "१-२-१९-२५", "content_sanskrit": "तुरंगाणां सहस्राणि गजानामयुतानि च ।\nरक्तेन तेषां घोरेण दुस्तरा चाभवन्मही ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003632025, "chapter_id": 23632, "verse_number": "१-२-१९-२६", "content_sanskrit": "एवमाजौ महादैत्यः कालनेमिर्महासुरः ।\nजघ्ने मुहुर्तमात्रेण गंधर्वाणां दशायुतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003632026, "chapter_id": 23632, "verse_number": "१-२-१९-२७", "content_sanskrit": "यक्षाणां पंचलक्षाणि किंनराणां तथैव च ।\nजघ्ने पिशाचमुख्यानां सप्तलक्षाणि निर्भयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003632027, "chapter_id": 23632, "verse_number": "१-२-१९-२८", "content_sanskrit": "इतरेषां न संख्यास्ति सुरजातिनिकायिनाम् ।\nजघ्ने स कोटिशः क्रद्धः कालनेमिर्मदोत्कटः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003632028, "chapter_id": 23632, "verse_number": "१-२-१९-२९", "content_sanskrit": "एवं प्रतिभये भीमे तदामर महाक्षये ।\nसंक्रुद्धावश्विनौ वीरौ चित्रास्त्रकवचोज्जवलौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003632029, "chapter_id": 23632, "verse_number": "१-२-१९-३०", "content_sanskrit": "जघ्नतुस्तौ रणे दैत्यमेकैकं षष्टिभिः शरैः ।\nनिर्भिद्य ते महादैत्यं सपुंखा विविशुर्महीम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003632030, "chapter_id": 23632, "verse_number": "१-२-१९-३१", "content_sanskrit": "ताभ्यां बाणप्रहारैस्तु किंचित्सोऽवाप्तचेतनः ।\nजग्राह चक्रं लक्षारं तैलधौतं रणेऽधिकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003632031, "chapter_id": 23632, "verse_number": "१-२-१९-३२", "content_sanskrit": "तेन चक्रेण सोश्विभ्यां चिच्छेद रथकूबरम् ।\nजग्राहाथ धनुर्दैत्यः शरांश्चाशीविषोपमान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003632032, "chapter_id": 23632, "verse_number": "१-२-१९-३३", "content_sanskrit": "ववर्ष भिषजोर्मूर्ध्नि संछाद्याकाशगोचरम् ।\nतावप्यस्त्रैः स्मृतैः सर्वाश्छेदतुर्दैत्यसायकान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003632033, "chapter_id": 23632, "verse_number": "१-२-१९-३४", "content_sanskrit": "तच्च करम तयोर्दृष्ट्वा विस्मितः कोपमाविशत् ।\nजग्राह मुद्गरं भीम कालदंडविभीषणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003632034, "chapter_id": 23632, "verse_number": "१-२-१९-३५", "content_sanskrit": "स तदमुद्भ्राम्य वेगेन चिक्षेपास्य रथं प्रति ।\nतं तु मुद्गरमायांतमालोक्यांबरगोचरे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003632035, "chapter_id": 23632, "verse_number": "१-२-१९-३६", "content_sanskrit": "मुक्त्वा रथावुभौ वेगादाप्लुतौ तरसाश्विनौ ।\nतौ रथौ स तु निष्पिष्य मुद्गरोऽचलसंनिभः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003632036, "chapter_id": 23632, "verse_number": "१-२-१९-३७", "content_sanskrit": "दारयामास धरणीं हेमजालपरिष्कृतः ।\nतस्य कर्माथ तद्दृष्ट्वा भिषजौ चित्रयोधिनौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003632037, "chapter_id": 23632, "verse_number": "१-२-१९-३८", "content_sanskrit": "वज्रास्त्रं च प्रकुर्वाणौ दानवेंद्रमयुध्यताम् ।\nघोरवज्रप्रहारैस्तु दानवः स परिक्षतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003632038, "chapter_id": 23632, "verse_number": "१-२-१९-३९", "content_sanskrit": "रथो ध्वजो धनुश्चैव छत्रं च कवचं तथा ।\nक्षणेन शतधा भूतं सर्वसैन्यस्य पश्यतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003632039, "chapter_id": 23632, "verse_number": "१-२-१९-४०", "content_sanskrit": "तद्दृष्ट्वा दुकरं कर्म सोऽश्विभ्यां भीमविक्रमः ।\nनारायणास्त्रं बलवान्मुमोच रणमूर्धनि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003632040, "chapter_id": 23632, "verse_number": "१-२-१९-४१", "content_sanskrit": "ततः शशाम वज्रास्त्रं कालनेमिस्ततो रुषा ।\nजीवग्राहं ग्राहयितुमश्विनौ तौ प्रचक्रमे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003632041, "chapter_id": 23632, "verse_number": "१-२-१९-४२", "content_sanskrit": "तावभिप्रायमालक्ष्य संत्यज्य समरांगणम् ।\nपदाती वेपमानांगौ प्रद्रुतौ वासवोयतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003632042, "chapter_id": 23632, "verse_number": "१-२-१९-४३", "content_sanskrit": "तयोरनुगतो दैत्यः कालनेमिर्नदन्मुहुः ।\nप्राप्येंद्रस्य बलं क्रूरो दैत्यानीकपदानुगः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003632043, "chapter_id": 23632, "verse_number": "१-२-१९-४४", "content_sanskrit": "स काल इव कल्पांते यदा वासवमाद्रुतः ।\nतं दृष्ट्वा सर्वभूतानि विविशुर्विह्वलानि तु ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003632044, "chapter_id": 23632, "verse_number": "१-२-१९-४५", "content_sanskrit": "हाहारावं प्रकुर्वाणास्तदा देवाश्च मेनिरे ।\nपराजयं महेंद्रस्य सर्वलोकक्षयावहम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003632045, "chapter_id": 23632, "verse_number": "१-२-१९-४६", "content_sanskrit": "चेलुः शिखरिणो मुख्याः पेतुरुल्का नभस्तलात् ।\nजगर्जुर्जलदा दिक्षु संभूतश्च महारवः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003632046, "chapter_id": 23632, "verse_number": "१-२-१९-४७", "content_sanskrit": "तां भूताविकृतिं दृष्ट्वा देवाः सेंद्रा भयावहाः ।\nमनसा शरणं जग्मुर्वासुदेवं जगत्पतिम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003632047, "chapter_id": 23632, "verse_number": "१-२-१९-४८", "content_sanskrit": "नमो ब्रह्मण्यदेवाय गोब्राह्मणहिताय च ।\nजगद्धिताय कृष्णाय गोविंदाय नमोनमः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003632048, "chapter_id": 23632, "verse_number": "१-२-१९-४९", "content_sanskrit": "स नो रक्षतु गोविंदो भयार्तास्ते जगुः सुराः ।\nसुराणां चिंतितं ज्ञात्वा भगवान्गरुडध्वजः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003632049, "chapter_id": 23632, "verse_number": "१-२-१९-५०", "content_sanskrit": "विबुध्यैव च पर्यंकाद्योगनिद्रां विहाय सः ।\nलक्ष्मीकरयुगांभोजलालितांघ्रिसरोरुहः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003632050, "chapter_id": 23632, "verse_number": "१-२-१९-५१", "content_sanskrit": "शारदंबरनीराब्जकांतिदेहच्छविः प्रभुः ।\nकौस्तुभोद्भासिहृदयः कांतकेयूरभास्करः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003632051, "chapter_id": 23632, "verse_number": "१-२-१९-५२", "content_sanskrit": "विमृश्य सुरसंक्षोभं वैनतेयमाताह्वयत् ।\nआहूतेऽविस्थितेतस्मिन्गरुडे दुःखिते भृशम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003632052, "chapter_id": 23632, "verse_number": "१-२-१९-५३", "content_sanskrit": "दिव्यनानास्त्रतीक्ष्णार्चिरारुह्यागात्सुराहवम् ।\nतत्रापश्यत देवेंद्रं भयभीतमभिद्रुतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003632053, "chapter_id": 23632, "verse_number": "१-२-१९-५४", "content_sanskrit": "दानवेंद्रैर्नवांभोदसच्छायैः सर्वथोत्कटैः ।\nयथा हि पुरुषं घोरैरभाग्यैरर्थकांक्षिभिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003632054, "chapter_id": 23632, "verse_number": "१-२-१९-५५", "content_sanskrit": "तत्त्राणायाव्रजद्विष्णुः स्तूयमानो मुहुः सुरैः ।\nअभाग्येभ्यः परित्रातुं सुकृतं निर्मलं यथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003632055, "chapter_id": 23632, "verse_number": "१-२-१९-५६", "content_sanskrit": "अथापश्यत दैत्येंद्रो वियति द्युतिमंडलम् ।\nस्फुरंतमुदयाच्छीघ्रं कांतं सूर्यशतं यथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003632056, "chapter_id": 23632, "verse_number": "१-२-१९-५७", "content_sanskrit": "प्रभवं ज्ञातुमिच्छंतो दानवास्तस्य तेजसः ।\nगरुडं तमथा पश्यन्कल्पांतानलभैरवम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003632057, "chapter_id": 23632, "verse_number": "१-२-१९-५८", "content_sanskrit": "तत्र स्थितं चतुर्बाहुं हरिं चानुपमद्युतिम् ।\nतमालोक्यासुरेंद्रास्तु हर्षसंपूर्णमानसाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003632058, "chapter_id": 23632, "verse_number": "१-२-१९-५९", "content_sanskrit": "अयं स देवः सर्वेषां शरणं केशवोऽरिहा ।\nअस्मिञ्जिते जिताः सर्वा देवता नात्र संशयः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003632059, "chapter_id": 23632, "verse_number": "१-२-१९-६०", "content_sanskrit": "एनमाश्रित्य लोकेशा यज्ञभागभुजोऽमराः ।\nइत्युक्त्वा ते समागम्य सर्व एव ततस्ततः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003632060, "chapter_id": 23632, "verse_number": "१-२-१९-६१", "content_sanskrit": "तं जघ्नुर्विविधैः शस्त्रैः परिवार्य समंततः ।\nकालनेमिप्रभृतयो दश दैत्यमहारथाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003632061, "chapter_id": 23632, "verse_number": "१-२-१९-६२", "content_sanskrit": "षष्ट्या विव्याधबाणानां कालनेमिर्जनार्दनम् ।\nनिमिः शतेन बाणानां मथनोऽशीतिभिः शरैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003632062, "chapter_id": 23632, "verse_number": "१-२-१९-६३", "content_sanskrit": "जंभकश्चैव सप्तत्या शुंभो दशभिरेव च ।\nशेषा दैत्ये श्वराः सव विष्णुमेकैकशः शरैः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003632063, "chapter_id": 23632, "verse_number": "१-२-१९-६४", "content_sanskrit": "दशभिर्दशभिः शल्यैर्जघ्नुः सगरुडं रणे ।\nतेषाममृष्यत्तत्कर्म विष्णुर्दानवसूदनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003632064, "chapter_id": 23632, "verse_number": "१-२-१९-६५", "content_sanskrit": "एकैकं दानवं जघ्ने षड्भिः पड्भिरजिह्नगैः ।\nआकर्णकृष्टैर्भूयश्च कालनेमिस्त्रिभिः शरैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003632065, "chapter_id": 23632, "verse_number": "१-२-१९-६६", "content_sanskrit": "विष्णुं विव्याध हृदये रोषाद्रक्तविलोचनः ।\nतस्याशोभंत ते बाणा हृदये तप्तकांचनाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003632066, "chapter_id": 23632, "verse_number": "१-२-१९-६७", "content_sanskrit": "मयूखा इव संदीप्ताः कौस्तुभस्य स्फुरत्त्विषः ।\nतैर्बाणैः किंचिदायस्तो हरिर्जग्राह मुद्गरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003632067, "chapter_id": 23632, "verse_number": "१-२-१९-६८", "content_sanskrit": "स तमुद्ग्राह्य वेगेन दानवाय मुमोच वै ।\nदानवेन्द्रस्तमप्राप्तं वियत्येव शतैः शरैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003632068, "chapter_id": 23632, "verse_number": "१-२-१९-६९", "content_sanskrit": "चिच्छेद तिलशः क्रुद्धो दर्शयन्पाणिलाघवम् ।\nततो विष्णुः प्रकुपितः प्रासं जग्राह भैरवम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003632069, "chapter_id": 23632, "verse_number": "१-२-१९-७०", "content_sanskrit": "तेन दैत्यस्य हृदयं ताडयामास वेगतः ।\nक्षणेन लब्धसंज्ञस्तु कालनेमिर्महासुरः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003632070, "chapter_id": 23632, "verse_number": "१-२-१९-७१", "content_sanskrit": "शक्तिं जग्राह तीक्ष्णाग्रां हेमघंटाट्टहासिनीम् ।\nतया वामं भुजं विष्णोर्बिभेद दितिनंदनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003632071, "chapter_id": 23632, "verse_number": "१-२-१९-७२", "content_sanskrit": "भिन्नं शक्त्या भुजं तस्य स्रुतशोणितमाबभौ ।\nनीले बला हके विद्युद्विद्योतंती यथा मुहुः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003632072, "chapter_id": 23632, "verse_number": "१-२-१९-७३", "content_sanskrit": "ततो विष्णुः प्रकुपितो जग्राह विपुलं धनुः ।\nसप्तदश च नाराचांस्तीक्ष्णाग्रान्मर्मभेदिनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003632073, "chapter_id": 23632, "verse_number": "१-२-१९-७४", "content_sanskrit": "दैत्यस्य हृदयं षड्भिर्विव्याध च शरैस्त्रिभिः ।\nचतुर्भिः सारथिं चास्य ध्वजं चैकेन पत्रिणा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003632074, "chapter_id": 23632, "verse_number": "१-२-१९-७५", "content_sanskrit": "द्वाभ्यां धनुर्ज्याधनुषी भुजं चैकेन पत्रिणा ।\nस विद्धो हृदये गाढं दोषैर्मूढो यथा नरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003632075, "chapter_id": 23632, "verse_number": "१-२-१९-७६", "content_sanskrit": "स्रुतरक्तारुणः प्रांशुः पीडाचलितमानसः ।\nचकंपे मारुतेनेव चोदितः किंशुकद्रुमः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003632076, "chapter_id": 23632, "verse_number": "१-२-१९-७७", "content_sanskrit": "ततः कंपितमालक्ष्य गदां जग्राह केशवः ।\nतां च वेगेन चिक्षेप कालनेमिवधं प्रति ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003632077, "chapter_id": 23632, "verse_number": "१-२-१९-७८", "content_sanskrit": "सा पपात शिरस्युग्रा सहसा कालनेमिनः ।\nसंचूर्णितोत्तमां गस्तु निष्पिष्टमुकुटोसुरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003632078, "chapter_id": 23632, "verse_number": "१-२-१९-७९", "content_sanskrit": "स्रुतरक्तौघरंध्रश्च स्रुतधातुरिवाचलः ।\nपपात स्वे रथे भग्नो विसंज्ञः शिष्टजीवनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003632079, "chapter_id": 23632, "verse_number": "१-२-१९-८०", "content_sanskrit": "पतितस्य रथोपस्थे दानवस्याच्युतोऽरिहा ।\nस्मितपूर्वमुवाचेदं वाक्यं चक्रायुधः प्रभुः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003632080, "chapter_id": 23632, "verse_number": "१-२-१९-८१", "content_sanskrit": "गच्छासुर विमुक्तोऽसि सांप्रतं जीव निर्वृतः ।\nततः स्वल्पेन कालेन अहमेव तवांतकः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003632081, "chapter_id": 23632, "verse_number": "१-२-१९-८२", "content_sanskrit": "एवं वचस्तस्य निशम्य विष्णोः सर्वेश्वरस्याथ रथं निमेषात् ।\nनिनाय दूरं किल कालनेमिनो भीतस्तदा सारथिर्लोकनाथात् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]