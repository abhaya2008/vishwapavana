[{"id": 2033422, "chapter_id": 1720, "verse_number": "४-४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033423, "chapter_id": 1720, "verse_number": "४-४३-१", "content_sanskrit": "एतस्मिन्नन्तरे पार्थं न मूढात्मा व्यजानत।\nविराटपुत्रः प्रभुखे पप्रच्छ पुनरेव तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033424, "chapter_id": 1720, "verse_number": "४-४३-२", "content_sanskrit": "सुवर्णरुचिराण्येषामायुधानि महात्मनाम् ।\nरुचिराणि प्रकाशन्ते पार्थानामाशुकारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033425, "chapter_id": 1720, "verse_number": "४-४३-३", "content_sanskrit": "क्वनु ते पाण्डवाः शूराः संग्रामेष्वपराजिताः।\nयेषामिमानि दीप्तानि श्रिया दीप्यन्ति भान्ति च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033426, "chapter_id": 1720, "verse_number": "४-४३-४", "content_sanskrit": "कस्मिन्वसन्ति देशे च धर्मज्ञा बन्धुवत्सलाः।\nक्व धर्मराजः कौन्तेयो धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033427, "chapter_id": 1720, "verse_number": "४-४३-५", "content_sanskrit": "धर्मशीलश्च धर्मात्मा धर्मवान्धर्मवित्सुधीः ।\nधर्माध्यक्षो धर्मपुत्रो धर्मज्ञो धर्ममूर्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033428, "chapter_id": 1720, "verse_number": "४-४३-६", "content_sanskrit": "धर्मनिष्ठो धर्मकर्ता धर्मगोप्ता सुधर्मकृत्।\nसत्यार्जवक्षमाधारो घृणी धर्मपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033429, "chapter_id": 1720, "verse_number": "४-४३-७", "content_sanskrit": "भीमसेनार्जुनौ चापि सर्वे ते मातुला मम।\nनकुलः सहदेवो वा सर्वास्त्रकुशलौ रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033430, "chapter_id": 1720, "verse_number": "४-४३-८", "content_sanskrit": "सर्व एव महात्मानः सर्वामित्रविनाशनाः।\nराज्यमक्षैः पराजित्य नः श्रूयन्ते वनं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033431, "chapter_id": 1720, "verse_number": "४-४३-९", "content_sanskrit": "द्रौपदी चापि पाञ्चाली स्त्रीरत्नमिति मे श्रुता।\nजिता चाक्षैस्तदा कृष्णा तानेवान्वगमद्वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033432, "chapter_id": 1720, "verse_number": "४-४३-१०", "content_sanskrit": "उत्सृज्य राज्यं धर्म्यं ते नः श्रूयन्ते वनं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033433, "chapter_id": 1720, "verse_number": "४-४३-११", "content_sanskrit": "पाण्डवान्यदि जानीषे क्वनु ते धर्मचारिणः ।\nक्वनु वा निवसन्तीति सत्यं ब्रूहि बृहन्नले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033434, "chapter_id": 1720, "verse_number": "४-४३-१२", "content_sanskrit": "किमर्थमागतान्यत्र शस्त्रास्त्राणि महात्मनाम्।\nकथं ज्ञातानि भवता तथा मे ब्रूहि शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033435, "chapter_id": 1720, "verse_number": "४-४३-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033436, "chapter_id": 1720, "verse_number": "४-४३-१३", "content_sanskrit": "ततः प्रहस्य बीभत्सुः कौन्तेयः श्वेतवाहनः।\nउवाच राजपुत्रं तमुत्तरं शृणु मे वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033437, "chapter_id": 1720, "verse_number": "४-४३-१४", "content_sanskrit": "मा भैस्त्वं राजशार्दूल सर्वं ते वर्णयाम्यहम् ।\nनात्र भेतव्यमद्यापि राजपुत्र यथातथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033438, "chapter_id": 1720, "verse_number": "४-४३-१५", "content_sanskrit": "वयं ते पाण्डवा नाम वनवासस्य पारगाः।\nअतीते द्वादशे वर्षे च्छन्नवासमिहोषिताः।\nतस्मादशङ्कितमनाः शृणुष्वावहितोत्तर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033439, "chapter_id": 1720, "verse_number": "४-४३-१६", "content_sanskrit": "अहमस्म्यर्जुनो नाम कङ्को नाम युधिष्ठिरः।\nभीमसेनस्तु वललः पितुस्ते रसपाचकः।\nअश्वबन्धस्तु नकुलः सहदेवस्तु गोपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033440, "chapter_id": 1720, "verse_number": "४-४३-१७", "content_sanskrit": "सैरन्ध्रीं द्रौपदीं विद्धि यदर्थे कीचको हतः।\nभीमसेनेन दुर्वृत्तः सहभ्रातृभिराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033441, "chapter_id": 1720, "verse_number": "४-४३-१८", "content_sanskrit": "श्रुत्वैतद्वचनं जिष्णोर्विस्मयस्फारितेक्षणः ।\nपश्यन्ननिमिषः पार्थं शनैर्वाचमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033442, "chapter_id": 1720, "verse_number": "४-४३-१९x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033443, "chapter_id": 1720, "verse_number": "४-४३-१९", "content_sanskrit": "दश पार्थस्य नामानि श्रूयन्ते मे कथासु च।\nप्रब्रूयास्तानि यदि मे श्रद्दध्यां सर्वमेव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033444, "chapter_id": 1720, "verse_number": "४-४३-२०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033445, "chapter_id": 1720, "verse_number": "४-४३-२०", "content_sanskrit": "अहं तर्हि तवाचक्षे दश नामानि तानि मे।\nवैराटे शृणु तानि त्वं यानि पूर्वं श्रुतानि ते।\nईशानो विदधे देवस्त्रिदिवस्येश्वरो दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033446, "chapter_id": 1720, "verse_number": "४-४३-२१", "content_sanskrit": "अर्जुनः फल्गुनो जिष्णुः किरीटी श्वेतवाहनः।\nबीभत्सुर्विजयः पार्थः सव्यसाची धनञ्जयः।\nएतानि मम नामानि स्थापितानि सुरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033447, "chapter_id": 1720, "verse_number": "४-४३-२२x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033448, "chapter_id": 1720, "verse_number": "४-४३-२२", "content_sanskrit": "गुणतो दश नामानि समवेतानि पाण्डवे।\nचरन्ति लोके ख्यातानि विदितानि ममावघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033449, "chapter_id": 1720, "verse_number": "४-४३-२३", "content_sanskrit": "केनासि विजयो नाम केनासि श्वेतवाहनः।\nसव्यसाची च केनासि जिष्णुर्बीभत्सुरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033450, "chapter_id": 1720, "verse_number": "४-४३-२४", "content_sanskrit": "अर्जुनः फल्गुनः पार्थः किरीटी केन सारथे।\nधनञ्जयश्च केनासि शीघ्रं वद बृहन्नले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033451, "chapter_id": 1720, "verse_number": "४-४३-२५", "content_sanskrit": "श्रुता मे तस्य वीरस्य केवला नामहेतवः।\nइतस्ततश्चलत्येतन्मनो मे चञ्चलं त्वयि।\nअर्जुनो वा भवान्नेति वद शीघ्रं बृहन्नले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033452, "chapter_id": 1720, "verse_number": "४-४३-२६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033453, "chapter_id": 1720, "verse_number": "४-४३-२६", "content_sanskrit": "सर्वाञ्जित्वा जनपदान्धनं चाच्छिद्य सर्वशः।\nमध्ये धनस्य तिष्ठन्तं तन्मामाहुर्धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033454, "chapter_id": 1720, "verse_number": "४-४३-२७", "content_sanskrit": "अभिप्रयामि संग्रामे यदाऽहं युद्धदुर्मदान्।\nअजित्वा न निविर्तेयं तेन वै विजयं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033455, "chapter_id": 1720, "verse_number": "४-४३-२८", "content_sanskrit": "श्वेताः काञ्चनसन्नाहा रथे युज्यन्ति मे हयाः।\nशत्रुभिर्युध्यमानस्य तेनाहं श्वेतवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033456, "chapter_id": 1720, "verse_number": "४-४३-२९", "content_sanskrit": "किरीटं सूर्यसंकाशं भ्राजते मे शिरोगतम्।\nरणमध्ये रथस्थस्य सूर्यपावकसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033457, "chapter_id": 1720, "verse_number": "४-४३-३०", "content_sanskrit": "अच्छेद्यं रुचिरं चित्रं जाम्बूनदपरिष्कृतम्।\nइन्द्रदत्तमनाहार्यं तेनाहुर्मां किरीटिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033458, "chapter_id": 1720, "verse_number": "४-४३-३१", "content_sanskrit": "न कुर्यां कर्म बीभत्सं युध्यमानः कदाचन।\nतेन देवमनुष्येषु बीभत्सुरिति मां विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033459, "chapter_id": 1720, "verse_number": "४-४३-३२", "content_sanskrit": "उभौ मे तुल्यकर्माणौ गाण्डीवस्य विकर्षणे।\nभुजौ मे भवतः सङ्ख्ये परसैन्यविनाशिनौ।\nतयोः सव्योऽधिकस्तस्मात्सव्यसाचीति मां विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033460, "chapter_id": 1720, "verse_number": "४-४३-३३", "content_sanskrit": "पृथिव्यां सागरान्तायां वर्णो मे दुर्लभः समः।\nशुद्धत्वाद्रुपवत्त्वाच्च तेन मामार्जुनं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033461, "chapter_id": 1720, "verse_number": "४-४३-३४", "content_sanskrit": "उत्तराभ्यां तु पूर्वाभ्यां फल्गुनीभ्यामहं दिवा ।\nजातो हिमवतः पृष्ठे तेन मां फल्गुनं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033462, "chapter_id": 1720, "verse_number": "४-४३-३५", "content_sanskrit": "यो ममाङ्गे व्रणं कुर्याद्धातुर्ज्येष्ठस्य पश्यतः।\nयुधिष्ठिरस्य रुधिरं दर्शयेद्वा कदाचन ।\nपराभवमहं तस्य कुले कुर्यां न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033463, "chapter_id": 1720, "verse_number": "४-४३-३६", "content_sanskrit": "योत्स्यामि तैरहं सर्वैर्न मे तेभ्यः पराभवः।\nतेन देवमनुष्येषु जिष्णुर्नामास्मि विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033464, "chapter_id": 1720, "verse_number": "४-४३-३७", "content_sanskrit": "माता मम पृथा नाम तेन मां पार्थमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033465, "chapter_id": 1720, "verse_number": "४-४३-३८", "content_sanskrit": "देवदानवगन्धर्वपिशाचोरगराक्षसान् ।\nअहं पुरा रणे जित्वा खाण्डवेऽग्निमतर्पयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033466, "chapter_id": 1720, "verse_number": "४-४३-३९", "content_sanskrit": "हुताशनं तर्पयित्वा सहितः शार्ङ्गधन्वना ।\n[ त्रिविष्टपगतौ* दृष्ट्वा पितामहमहेश्वरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2033467, "chapter_id": 1720, "verse_number": "४-४३-४०", "content_sanskrit": "मूर्च्छया पतितं भूमावागतौ देवसत्तमौ ।\nदृष्ट्वा तौ वरदौ देवौ संज्ञां लब्ध्वोत्थितः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2033468, "chapter_id": 1720, "verse_number": "४-४३-४१", "content_sanskrit": "मूर्ध्ना हि प्रणतं भूमौ तौ देवौ वरदौ वरौ।\nकृष्णेत्येकादशं नाम प्रीत्या मे चक्रतुस्तदा।\nतुष्टौ च मम वीर्येण कर्मणा चाभिराधितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2033469, "chapter_id": 1720, "verse_number": "४-४३-४२", "content_sanskrit": "सर्वदेवैः परिवृतौ भूयो मां स्वयमूचतुः।\nवरं तात वृणीष्वेति यं प्रार्थयसि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2033470, "chapter_id": 1720, "verse_number": "४-४३-४३", "content_sanskrit": "ततोऽहमस्त्राण्यलभं दिव्यानि च दृढानि च।\nब्राह्मं पाशुपतं चैव स्थूणाकर्णं च दुर्जयम् ।\nऐन्द्रं वारुणमाग्नेयं वायव्यमथ वैष्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2033471, "chapter_id": 1720, "verse_number": "४-४३-४४", "content_sanskrit": "ततोऽहमजयं भूयो रथेनैन्द्रेण दुर्जयान्।\nमातलिं सारथिं कृत्वा निवातकवचान्रणे ।\nअवध्यकवचांन्देवैर्वरदृप्तान्महासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2033472, "chapter_id": 1720, "verse_number": "४-४३-४५", "content_sanskrit": "तिस्रः कोटीर्दानवानां संयुगेष्वनिवर्तिनाम्।\nएको निर्जित्य संग्रामे भूयो देवानतोषयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2033473, "chapter_id": 1720, "verse_number": "४-४३-४६", "content_sanskrit": "ततो मे भगवानिन्द्रः किरीटमददात्स्वयम्।\nदेवाश्च शङ्खमददुः शत्रुसैन्यनिवारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2033474, "chapter_id": 1720, "verse_number": "४-४३-४७", "content_sanskrit": "अहं पारे समुद्रस्य हिरण्यपुरवासिनाम्।\nहत्वा षष्टिं सहस्राणि जयं संप्राप्तवान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2033475, "chapter_id": 1720, "verse_number": "४-४३-४८", "content_sanskrit": "असंभ्रान्तो रथे तिष्ठन्सहस्रेषु शतेषु च।\nशत्रुमध्ये दुराधर्षो न मुह्यन्ति च मे दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2033476, "chapter_id": 1720, "verse_number": "४-४३-४९", "content_sanskrit": "अहं गन्धर्वराजेन ह्रियमाणं सुयोधनम्।\nभ्रातृभिः सहितं तात गन्धर्वैः समरे जितम्।\nचतुर्दश सहस्राणि हत्वा चैनममोचयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2033477, "chapter_id": 1720, "verse_number": "४-४३-५०", "content_sanskrit": "एतानि मम नामानि योऽहन्यहनि कीर्तयेत्।\nतं न पश्यन्ति सत्त्वानि न तं निघ्नन्ति शत्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2033478, "chapter_id": 1720, "verse_number": "४-४३-५१", "content_sanskrit": "अद्य पश्य महाबाहो मम वीर्यं सुदुःसहम्।\nमा भैर्विगतसंत्रासः कुरूनेतान्समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2033479, "chapter_id": 1720, "verse_number": "४-४३-५२", "content_sanskrit": "सुयोधनस्य मिषतः कर्णस्य च कृपस्य च।\nपितामहस्य भीष्मस्य द्रौणेर्द्रोणस्य च स्वयम्।\nसर्वानेव कुरूञ्जित्वा प्रत्यानेष्यामि ते पशूऩ्] ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2033480, "chapter_id": 1720, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि त्रिचत्वारिंशोऽध्यायः ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]