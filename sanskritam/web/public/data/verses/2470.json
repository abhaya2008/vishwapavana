[{"id": 2070191, "chapter_id": 2470, "verse_number": "११-४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070192, "chapter_id": 2470, "verse_number": "११-४-१", "content_sanskrit": "कथं संसारगहनं विज्ञेयं वदतां वर।\nएतदिच्छाम्यहं श्रोतुं तत्त्वमाख्याहि पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070193, "chapter_id": 2470, "verse_number": "११-४-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070194, "chapter_id": 2470, "verse_number": "११-४-२", "content_sanskrit": "जन्मप्रभृति भूतानां क्रियाः सर्वास्तु लक्षयन्।\nपूर्वमेवेह कलिले वसते किञ्चिदन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070195, "chapter_id": 2470, "verse_number": "११-४-३", "content_sanskrit": "ततः स पञ्चमेऽतीते मासे मांसमकल्पयत्।\nततः सर्वाङ्गसम्पूर्णो गर्भो मासे तु जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070196, "chapter_id": 2470, "verse_number": "११-४-४", "content_sanskrit": "अमेध्यमध्ये वसति मांसशोणितलेपने।\nततस्तु वायुवेगेन ऊर्ध्वपादो ह्यधोमुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070197, "chapter_id": 2470, "verse_number": "११-४-५", "content_sanskrit": "योनिद्वारमुपागम्य बहून्क्लेशान्समृच्छति।\nयोनिसंपीडनाच्चैव पूर्वकर्मभिरन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070198, "chapter_id": 2470, "verse_number": "११-४-६", "content_sanskrit": "तस्मान्मुक्तः स संसारादन्यान्पश्यत्युपद्रवान्।\nग्रहास्तमनुच्छन्ति सारमेया इवामिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070199, "chapter_id": 2470, "verse_number": "११-४-७", "content_sanskrit": "ततः कालान्तरे प्राप्ते व्याधयश्चापि तं तथा।\nउपसर्पन्ति जीवन्तं बध्यमानं स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070200, "chapter_id": 2470, "verse_number": "११-४-८", "content_sanskrit": "बद्धमिन्द्रियपाशैस्तं सङ्गकामुकमातुरम्।\nव्यसनान्यनुवर्तन्ते विविधानि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070201, "chapter_id": 2470, "verse_number": "११-४-९", "content_sanskrit": "बाध्यमानश्च तैर्भूयो नैव तृप्तिमुपैति सः।\n[तदा नावैति चैवायं प्रकुर्वन्साध्वसाधु वा॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070202, "chapter_id": 2470, "verse_number": "११-४-१०", "content_sanskrit": "तत्रैनं परिपश्यन्ति ये ध्यानपरिनिष्ठिताः।\nअयं न बुध्यते तावद्यमलोकादिहागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070203, "chapter_id": 2470, "verse_number": "११-४-११", "content_sanskrit": "यमदूतैर्विकृष्यंश्च मृत्युं कालेन गच्छति।\nवाग्घीनस्य च या मात्रा इष्टानिष्टकृताऽस्य वै।\nभूय एवात्मनाऽऽत्मानं बध्यमानमुपैति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070204, "chapter_id": 2470, "verse_number": "११-४-१२", "content_sanskrit": "अहो विनिकृतो लोको लोभेन च वशीकृतः।\nलोभक्रोधमदोन्मत्तो नात्मानमवबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070205, "chapter_id": 2470, "verse_number": "११-४-१३", "content_sanskrit": "कुलीनत्वे च रमते दुष्कुलीनान्विकुत्सयन्।\nधनदर्पेण दृप्तश्च दरिद्रान्परिकुत्सयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070206, "chapter_id": 2470, "verse_number": "११-४-१४", "content_sanskrit": "मूर्खानिति परानाह नात्मानं समवेक्षते।\nदोषान्क्षिपति चान्येषां नात्मानं शास्तुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070207, "chapter_id": 2470, "verse_number": "११-४-१५", "content_sanskrit": "यदा प्राज्ञाश्च मूर्खाश्च धनवन्तश्च निर्धनाः।\nकुलीनाश्चाकुलीनाश्च मानिनोऽथाप्यमानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070208, "chapter_id": 2470, "verse_number": "११-४-१६", "content_sanskrit": "सर्वे पितृवनं प्राप्ताः स्वपन्ति विगतत्वचः।\nनिर्मांसैरस्थिभूयिष्ठैर्गात्रैः स्नायुनिबन्धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070209, "chapter_id": 2470, "verse_number": "११-४-१७", "content_sanskrit": "किं विशेषं प्रपश्यन्ति तत्र तेषां परे जनाः।\nयेन प्रत्यवगच्छेयुः कुलरूपविशेषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070210, "chapter_id": 2470, "verse_number": "११-४-१८", "content_sanskrit": "यदा सर्वे समं न्यस्ताः स्वपन्ति धरणीतले।\nकस्मादन्योन्यमिच्छन्ति विप्रलब्धुमिहाबुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070211, "chapter_id": 2470, "verse_number": "११-४-१९", "content_sanskrit": "प्रत्यक्षं च परोक्षं च यो निशम्य श्रुतिं त्विमाम्।\n[अध्रुवे जीवलोकेऽस्मिन्यो धर्ममनुपालयन्।]\nजन्मप्रभृति वर्तेत प्राप्नुयात्परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070212, "chapter_id": 2470, "verse_number": "११-४-२०", "content_sanskrit": "एवं सर्वं विदित्वा वै यस्तत्त्वमनुवर्तते।\nस प्रमोक्षयते चैव पन्थानं मनुजेश्वर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070213, "chapter_id": 2470, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि चतुर्थोऽध्यायः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]