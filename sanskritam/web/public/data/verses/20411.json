[{"id": 7000411000, "chapter_id": 20411, "verse_number": "२-८३-१", "content_sanskrit": "सुकर्मोवाच ।\nसमाहूय प्रजाः सर्वा द्वीपानां वसुधाधिपः ।\nहर्षेण महताविष्ट इदं वचनमब्रवीत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000411001, "chapter_id": 20411, "verse_number": "२-८३-२", "content_sanskrit": "इंद्रलोकं ब्रह्मलोकं रुद्रलोकमतः परम् ।\nवैष्णवं सर्वपापघ्नं प्राणिनां गतिदायकम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000411002, "chapter_id": 20411, "verse_number": "२-८३-३", "content_sanskrit": "व्रजाम्यहं न संदेहो ह्यनया सह सत्तमाः ।\nब्राह्मणाः क्षत्रिया वैश्याः सशूद्रा श्च प्रजा मम॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000411003, "chapter_id": 20411, "verse_number": "२-८३-४", "content_sanskrit": "सुखेनापि सकुटुंबैः स्थातव्यं तु महीतले ।\nपूरुरेष महाभागो भवतां पालकस्त्विह॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000411004, "chapter_id": 20411, "verse_number": "२-८३-५", "content_sanskrit": "स्थापितोस्ति मया लोका राजा धीरः सदंडकः ।\nएवमुक्तास्तु ताः सर्वाः प्रजा राजानमब्रुवन्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000411005, "chapter_id": 20411, "verse_number": "२-८३-६", "content_sanskrit": "श्रूयते सर्ववेदेषु पुराणेषु नृपोत्तम ।\nधर्म एवं यतो लोके न दृष्टः केन वै पुरा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000411006, "chapter_id": 20411, "verse_number": "२-८३-७", "content_sanskrit": "दृष्टोस्माभिरसौ धर्मो दशांगः सत्यवल्लभः ।\nसोमवंशसमुत्पन्नो नहुषस्य महागृहे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000411007, "chapter_id": 20411, "verse_number": "२-८३-८", "content_sanskrit": "हस्तपादमुखैर्युक्तः सर्वाचारप्रचारकः ।\nज्ञानविज्ञानसंपन्नः पुण्यानां च महानिधिः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000411008, "chapter_id": 20411, "verse_number": "२-८३-९", "content_sanskrit": "गुणानां हि महाराज आकरः सत्यपंडितः ।\nकुर्वंति च महाधर्मं सत्यवंतो महौजसः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000411009, "chapter_id": 20411, "verse_number": "२-८३-१०", "content_sanskrit": "तं धर्मं दृष्टवंतः स्म भवंतं कामरूपिणम् ।\nभवंतं कामकर्तारमीदृशं सत्यवादिनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000411010, "chapter_id": 20411, "verse_number": "२-८३-११", "content_sanskrit": "कर्मणा त्रिविधेनापि वयं त्यक्तुं न शक्नुमः ।\nयत्र त्वं तत्र गच्छामः सुसुखं पुण्यमेव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000411011, "chapter_id": 20411, "verse_number": "२-८३-१२", "content_sanskrit": "नरकेपि भवान्यत्र वयं तत्र न संशयः ।\nकिं दारैर्धनभोगैश्च किं जीवैर्जीवितेन च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000411012, "chapter_id": 20411, "verse_number": "२-८३-१३", "content_sanskrit": "त्वां विनासुमहाराज तेन नास्त्यत्र कारणम् ।\nत्वयैव सह राजेंद्र वयं यास्याम नान्यथा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000411013, "chapter_id": 20411, "verse_number": "२-८३-१४", "content_sanskrit": "एवं श्रुत्वा वचस्तासां प्रजानां पृथिवीपतिः ।\nहर्षेण महताविष्टः प्रजावाक्यमुवाच ह॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000411014, "chapter_id": 20411, "verse_number": "२-८३-१५", "content_sanskrit": "आगच्छंतु मया सार्द्धं सर्वे लोकाः सुपुण्यकाः ।\nनृपो रथं समारुह्य तया वै कामकन्यया॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000411015, "chapter_id": 20411, "verse_number": "२-८३-१६", "content_sanskrit": "रथेन हंसवर्णेन चंद्रबिंबानुकारिणा ।\nचामरैर्व्यजनैश्चापि वीज्यमानो गतव्यथः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000411016, "chapter_id": 20411, "verse_number": "२-८३-१७", "content_sanskrit": "केतुना तेन पुण्येन शुभ्रेणापि महीयसा ।\nशोभमानो यथा देवो देवराजः पुरंदरः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000411017, "chapter_id": 20411, "verse_number": "२-८३-१८", "content_sanskrit": "ऋषिभिः स्तूयमानस्तु बंदिभिश्चारणैस्तथा ।\nप्रजाभिः स्तूयमानश्च ययातिर्नहुषात्मजः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000411018, "chapter_id": 20411, "verse_number": "२-८३-१९", "content_sanskrit": "प्रजाः सर्वास्ततो यानैः समायाता नरेश्वरम् ।\nगजैरश्वै रथैश्चान्यैः प्रस्थिताश्च दिवं प्रति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000411019, "chapter_id": 20411, "verse_number": "२-८३-२०", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चान्ये पृथग्जनाः ।\nसर्वे च वैष्णवा लोका विष्णुध्यानपरायणाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000411020, "chapter_id": 20411, "verse_number": "२-८३-२१", "content_sanskrit": "तेषां तु केतवः शुक्ला हेमदंडैरलंकृताः ।\nशंखचक्रांकिताः सर्वे सदंडाः सपताकिनः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000411021, "chapter_id": 20411, "verse_number": "२-८३-२२", "content_sanskrit": "प्रजावृंदेषु भासंते पताका मारुतेरिताः ।\nदिव्यमालाधरास्सर्वे शोभितास्तुलसीदलैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000411022, "chapter_id": 20411, "verse_number": "२-८३-२३", "content_sanskrit": "दिव्यचंदनदिग्धांगा दिव्यगंधानुलेपनाः ।\nदिव्यवस्त्रकृता शोभा दिव्याभरणभूषिताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000411023, "chapter_id": 20411, "verse_number": "२-८३-२४", "content_sanskrit": "सर्वे लोकाः सुरूपास्ते राजानमुपजग्मिरे ।\nप्रजाशतसहस्राणि लक्षकोटिशतानि च॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000411024, "chapter_id": 20411, "verse_number": "२-८३-२५", "content_sanskrit": "अर्वखर्वसहस्राणि ते जनाः प्रतिजग्मिरे ।\nते तु राज्ञा समं सर्वे वैष्णवाः पुण्यकारिणः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000411025, "chapter_id": 20411, "verse_number": "२-८३-२६", "content_sanskrit": "विष्णुध्यानपराः सर्वे जपदानपरायणाः ।\nसुकर्मोवाच ।\nएवं ते प्रस्थिताः सर्वे हर्षेण महतान्विताः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000411026, "chapter_id": 20411, "verse_number": "२-८३-२७", "content_sanskrit": "पूरुं पुत्रं महाराज स्वराज्ये परिषिच्य तम् ।\nऐंद्रं लोकं जगामाथ ययातिः पृथिवीपतिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000411027, "chapter_id": 20411, "verse_number": "२-८३-२८", "content_sanskrit": "तेजसा तस्य पुण्येन धर्मेण तपसा तदा ।\nते जनाः प्रस्थिताः सर्वे वैष्णवं लोकमुत्तमम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000411028, "chapter_id": 20411, "verse_number": "२-८३-२९", "content_sanskrit": "ततो देवाः सगंधर्वाः किन्नराश्चारणास्तथा ।\nसहिता देवराजेन आगताः संमुखं तदा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000411029, "chapter_id": 20411, "verse_number": "२-८३-३०", "content_sanskrit": "तस्यैवापि नृपेंद्रस्य पूजयंतो नृपोत्तम ।\nइंद्र उवाच ।\nस्वागतं ते महाराज मम गेहं समाविश॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000411030, "chapter_id": 20411, "verse_number": "२-८३-३१", "content_sanskrit": "अत्र भोगान्प्रभुंक्ष्व त्वं दिव्यान्कामान्मनोऽनुगान् ।\nराजोवाच ।\nसहस्राक्ष महाप्राज्ञ तव पादांबुजद्वयम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000411031, "chapter_id": 20411, "verse_number": "२-८३-३२", "content_sanskrit": "नमस्करोम्यहं देव ब्रह्मलोकं व्रजाम्यहम् ।\nदेवैः संस्तूयमानश्च ब्रह्मलोकं जगाम ह॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000411032, "chapter_id": 20411, "verse_number": "२-८३-३३", "content_sanskrit": "पद्मयोनिर्महातेजाः सार्धं मुनिवरैस्तदा ।\nआतिथ्यं च चकारास्य पाद्यार्घादि सुविष्टरैः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000411033, "chapter_id": 20411, "verse_number": "२-८३-३४", "content_sanskrit": "उवाच विष्णुलोकं हि प्रयाहि त्वं स्वकर्मणा ।\nएवमाभाषिते धात्रा जगाम शिवमंदिरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000411034, "chapter_id": 20411, "verse_number": "२-८३-३५", "content_sanskrit": "चक्रे आतिथ्यपूजां च उमया सह शंकरः ।\nतस्यै वापि नृपेंद्रस्य राजानमिदमब्रवीत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000411035, "chapter_id": 20411, "verse_number": "२-८३-३६", "content_sanskrit": "कृष्णभक्तोसि राजेंद्र ममापि सुप्रियो भवान् ।\nततो ययाते राजेंद्र वस त्वं मम मंदिरम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000411036, "chapter_id": 20411, "verse_number": "२-८३-३७", "content_sanskrit": "सर्वान्भोगान्प्रभुंक्ष्व त्वं दुःखप्राप्यान्हि मानुषैः ।\nअंतरं नास्ति राजेंद्र मम विष्णोर्न संशयः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000411037, "chapter_id": 20411, "verse_number": "२-८३-३८", "content_sanskrit": "योसौ विष्णुस्वरूपेण स वै रुद्रो न संशयः ।\nयो रुद्रो विद्यते राजन्स च विष्णुः सनातनः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000411038, "chapter_id": 20411, "verse_number": "२-८३-३९", "content_sanskrit": "उभयोरंतरं नास्ति तस्माच्चैव वदाम्यहम् ।\nविष्णुभक्तस्यपुण्यस्यस्थानमेवददाम्यहम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000411039, "chapter_id": 20411, "verse_number": "२-८३-४०", "content_sanskrit": "तस्मादत्र महाराज स्थातव्यं हि त्वयानघ ।\nएवमुक्तः शिवेनापि ययातिर्हरिवल्लभः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000411040, "chapter_id": 20411, "verse_number": "२-८३-४१", "content_sanskrit": "भक्त्या प्रणम्य देवेशं शंकरं नतकंधरः ।\nएतत्सर्वं महादेव त्वयोक्तमिह सांप्रतम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000411041, "chapter_id": 20411, "verse_number": "२-८३-४२", "content_sanskrit": "युवयोरंतरं नास्ति एका मूर्तिर्द्विधाभवत् ।\nवैष्णवं गंतुमिच्छामि पादौ तव नमाम्यहम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000411042, "chapter_id": 20411, "verse_number": "२-८३-४३", "content_sanskrit": "एवमस्तु महाराज गच्छ लोकं तु वैष्णवम् ।\nसमादिष्टः शिवेनापि प्रतस्थे वसुधाधिपः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000411043, "chapter_id": 20411, "verse_number": "२-८३-४४", "content_sanskrit": "पृथ्वीशस्तैर्महापुण्यैर्वैष्णवैर्विष्णुवल्लभैः ।\nनृत्यमानैस्ततस्तैस्तु पुरतस्तस्य भूपतेः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000411044, "chapter_id": 20411, "verse_number": "२-८३-४५", "content_sanskrit": "शंखशब्दैः सुपापघ्नैः सिंहनादैः सुपुष्कलैः ।\nजगाम निःस्वनै राजा पूज्यमानः सुचारणैः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000411045, "chapter_id": 20411, "verse_number": "२-८३-४६", "content_sanskrit": "सुस्वरैर्गीयमानस्तु पाठकैः शास्त्रकोविदैः ।\nगायंति पुरतस्तस्य गंधर्वा गीततत्पराः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000411046, "chapter_id": 20411, "verse_number": "२-८३-४७", "content_sanskrit": "ऋषिभिः स्तूयमानश्च देववृंदैः समन्वितैः ।\nअप्सरोभिः सुरूपाभिः सेव्यमानः स नाहुषिः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000411047, "chapter_id": 20411, "verse_number": "२-८३-४८", "content_sanskrit": "गंधर्वैः किन्नरैः सिद्धैश्चारणैः पुण्यमंगलैः ।\nसाध्यैर्विद्याधरै राजा मरुद्भिर्वसुभिस्तथा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000411048, "chapter_id": 20411, "verse_number": "२-८३-४९", "content_sanskrit": "रुद्रैश्चादित्यवर्गैश्च लोकपालैर्दिगीश्वरैः ।\nस्तूयमानो महाराजस्त्रैलोक्येन समंततः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000411049, "chapter_id": 20411, "verse_number": "२-८३-५०", "content_sanskrit": "ददृशे वैष्णवं लोकमनौपम्यमनामयम् ।\nविमानैः कांचनै राजन्सर्वशोभासमाविलैः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000411050, "chapter_id": 20411, "verse_number": "२-८३-५१", "content_sanskrit": "हंसकुंदेंदुधवलैर्विमानैरुपशोभितैः ।\nप्रासादैः शतभौमैश्च मेरुमंदरसंनिभैः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000411051, "chapter_id": 20411, "verse_number": "२-८३-५२", "content_sanskrit": "शिखरैरुल्लिखद्भिश्च स्वर्व्योमहाटकान्वितैः ।\nजाज्वल्यमानैः कलशैः शोभते सुपुरोत्तमम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000411052, "chapter_id": 20411, "verse_number": "२-८३-५३", "content_sanskrit": "तारागणैर्यथाकाशं तेजः श्रिया प्रकाशते ।\nप्रज्वलत्तेजोज्वालाभिर्लोचनैरिव लोकते॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000411053, "chapter_id": 20411, "verse_number": "२-८३-५४", "content_sanskrit": "नानारत्नैर्हरेर्लोकः प्रहसद्दशनैरिव ।\nसमाह्वयति तान्पुण्यान्वैष्णवान्विष्णुवल्लभान्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000411054, "chapter_id": 20411, "verse_number": "२-८३-५५", "content_sanskrit": "ध्वज व्याजेन राजेंद्र चलिताग्रैः सुपल्लवैः ।\nश्वसनांदोलितैस्तैश्च ध्वजाग्रैश्च मनोहरैः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000411055, "chapter_id": 20411, "verse_number": "२-८३-५६", "content_sanskrit": "हेमदंडैश्च घंटाभिः सर्वत्रसमलंकृतम् ।\nसूर्यतेजः प्रकाशैश्च गोपुराट्टालकैस्ततः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000411056, "chapter_id": 20411, "verse_number": "२-८३-५७", "content_sanskrit": "गवाक्षैर्जालमालैश्च वातायनमनोहरैः ।\nप्रतोलीनां प्रकाशैश्च प्राकारैर्हेमरूपकैः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000411057, "chapter_id": 20411, "verse_number": "२-८३-५८", "content_sanskrit": "तोरणैः सुपताकाभिर्नानाशब्दैः सुमंगलैः ।\nकलशाग्रैश्चक्रबिंबै रविबिंबसमप्रभैः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000411058, "chapter_id": 20411, "verse_number": "२-८३-५९", "content_sanskrit": "सुभोगैः शतकक्षैश्च निर्जलांबुदसन्निभैः ।\nदंडच्छत्रसमाकीर्णैः कलशैरुपशोभितैः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000411059, "chapter_id": 20411, "verse_number": "२-८३-६०", "content_sanskrit": "प्रावृट्कालांबुदाकारैर्मदिरैरुपशोभितैः ।\nकलशैः शोभमानैस्तैरृक्षैर्द्यौरिव भूतलम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000411060, "chapter_id": 20411, "verse_number": "२-८३-६१", "content_sanskrit": "दंडजालपताकाभिरृक्षजालसमप्रभैः ।\nतादृशैः स्फाटिकाकारैः कांतिशंखेंदुसन्निभैः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000411061, "chapter_id": 20411, "verse_number": "२-८३-६२", "content_sanskrit": "हेमप्रासादसंबाधैर्नानाधातुमयैस्ततः ।\nविमानैरर्बुदसंख्यैः शतकोटिसहस्रकैः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000411062, "chapter_id": 20411, "verse_number": "२-८३-६३", "content_sanskrit": "सर्वभोगयुतैश्चैव शोभते हरिपत्तनम् ।\nयैः समाराधितो देवः शंखचक्रगदाधरः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000411063, "chapter_id": 20411, "verse_number": "२-८३-६४", "content_sanskrit": "ते प्रसादात्तस्य तेषु निवसंति गृहेषु च ।\nसर्वपुण्येषु दिव्येषु भोगाढ्येषु च मानवाः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000411064, "chapter_id": 20411, "verse_number": "२-८३-६५", "content_sanskrit": "वैष्णवाः पुण्यकर्माणो निर्धूताशेषकल्मषाः ।\nएवंविधैर्गृहैः पुण्यैः शोभितं विष्णुमंदिरम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000411065, "chapter_id": 20411, "verse_number": "२-८३-६६", "content_sanskrit": "नानावृक्षैः समाकीर्णं वनैश्चंदनशोभितैः ।\nसर्वकामफलै राजन्सर्वत्र समलंकृतम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000411066, "chapter_id": 20411, "verse_number": "२-८३-६७", "content_sanskrit": "वापीकुंडतडागैश्च सारसैरुपशोभितैः ।\nहंसकारंडवाकीर्णैः कल्हारैरुपशोभितैः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000411067, "chapter_id": 20411, "verse_number": "२-८३-६८", "content_sanskrit": "शतपत्रैर्महापद्मैः पद्मोत्पलविराजितैः ।\nकनकोत्पलवर्णैश्च सरोभिश्च विराजते॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000411068, "chapter_id": 20411, "verse_number": "२-८३-६९", "content_sanskrit": "वैकुंठं सर्वशोभाढ्यं देवोद्यानैरलंकृतम् ।\nदिव्यशोभासमाकीर्णं वैष्णवैरुपशोभितम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000411069, "chapter_id": 20411, "verse_number": "२-८३-७०", "content_sanskrit": "वैकुंठं ददृशे राजा मोक्षस्थानमनुत्तमम् ।\nदेववृंदैः समाकीर्णं ययातिर्नहुषात्मजः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000411070, "chapter_id": 20411, "verse_number": "२-८३-७१", "content_sanskrit": "प्रविवेश पुरं रम्यं सर्वदाहविवर्जितम् ।\nददृशे सर्वक्लेशघ्नं नारायणमनामयम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000411071, "chapter_id": 20411, "verse_number": "२-८३-७२", "content_sanskrit": "विमानैरुपशोभंतं सर्वाभरणशालिनम् ।\nपीतवासं जगन्नाथं श्रीवत्सांकं महाद्युतिम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000411072, "chapter_id": 20411, "verse_number": "२-८३-७३", "content_sanskrit": "वैनतेयसमारूढं श्रियायुक्तं परात्परम् ।\nसर्वेषां देवलोकानां यो गतिः परमेश्वरः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000411073, "chapter_id": 20411, "verse_number": "२-८३-७४", "content_sanskrit": "परमानंदरूपेण कैवल्येन विराजते ।\nसेव्यमानं महालोकैःसुपुण्यैर्वैष्णवैर्हरिम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000411074, "chapter_id": 20411, "verse_number": "२-८३-७५", "content_sanskrit": "देववृंदैः समाकीर्णं गंधर्वगणसेवितम् ।\nअप्सरोभिर्महात्मानं दुःखक्लेशापहं हरिम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000411075, "chapter_id": 20411, "verse_number": "२-८३-७६", "content_sanskrit": "नारायणं ननामाथ स्वपत्न्या सह भूपतिः ।\nप्रणेमुर्मानवाः सर्वे वैष्णवा मधुसूदनम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000411076, "chapter_id": 20411, "verse_number": "२-८३-७७", "content_sanskrit": "गता ये वैष्णवाः सर्वे सह राज्ञा महामते ।\nपादांबुजद्वयं तस्य नेमुर्भक्त्या महामते॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000411077, "chapter_id": 20411, "verse_number": "२-८३-७८", "content_sanskrit": "प्रणमंतं महात्मानं राजानं दीप्ततेजसम् ।\nतमुवाच हृषीकेशस्तुष्टोऽहं तव सुव्रत॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000411078, "chapter_id": 20411, "verse_number": "२-८३-७९", "content_sanskrit": "वरं वरय राजेंद्र यत्ते मनसि वर्तते ।\nतत्ते ददाम्यसंदेहं मद्भक्तोसि महामते॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000411079, "chapter_id": 20411, "verse_number": "२-८३-८०", "content_sanskrit": "राजोवाच ।\nयदि त्वं देवदेवेश तुष्टोसि मधुसूदन ।\nदासत्वं देहि सततमात्मनश्च जगत्पते॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000411080, "chapter_id": 20411, "verse_number": "२-८३-८१", "content_sanskrit": "विष्णुरुवाच ।\nएवमस्तु महाभाग मम भक्तो न संशयः ।\nलोके मम महाराज स्थातव्यमनया सह॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000411081, "chapter_id": 20411, "verse_number": "२-८३-८२", "content_sanskrit": "एवमुक्तो महाराजो ययातिः पृथिवीपतिः ।\nप्रसादात्तस्य देवस्य विष्णुलोकं प्रसाधितम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000411082, "chapter_id": 20411, "verse_number": "२-८३-८३", "content_sanskrit": "निवसत्येष भूपालो वैष्णवं लोकमुत्तमम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]