[{"id": 2042386, "chapter_id": 1946, "verse_number": "५-१९१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042387, "chapter_id": 1946, "verse_number": "५-१९१-१", "content_sanskrit": "ततः शिखण्डिनो माता यथातत्त्वं नराधिप।\nआचचक्षे महाबाहो भर्त्र कन्यां शिखण्डिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042388, "chapter_id": 1946, "verse_number": "५-१९१-२", "content_sanskrit": "अपुत्रया मया राजन्सपत्नीनां भयादिदम् ।\nकन्या शिखण्डिनी जाता पुरुषो वै निवेदिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042389, "chapter_id": 1946, "verse_number": "५-१९१-३", "content_sanskrit": "त्वया चैव नरश्रेष्ठ तन्मे प्रीत्याऽनुमोदितम् ।\nपुत्रकर्म कृतं चैव कन्यायाः पार्थिवर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042390, "chapter_id": 1946, "verse_number": "५-१९१-४", "content_sanskrit": "भार्या चोढा त्वया राजन्दशार्णाधिपतेः सुता।\nमया च प्रत्यभिहितं देववाक्यार्थदर्शनात्।\nकन्या भूत्वा पुमान्भावीत्येवं चैतदुपेक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042391, "chapter_id": 1946, "verse_number": "५-१९१-५", "content_sanskrit": "एतच्छ्रुत्वा द्रुपदो यज्ञसेनः\nसर्वं तत्त्वं मन्त्रविद्भ्यो निवेद्य।\nमन्त्रं राजा मन्त्रयामास राजन्\nयथायुक्तं रक्षणे वै प्रजानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042392, "chapter_id": 1946, "verse_number": "५-१९१-६", "content_sanskrit": "संबन्धकं चैव समर्थ्य तस्मिन्\nदाशार्णके वै नृपतौ नरेन्द्र।\nस्वयं कृत्वा विप्रलम्भं यथाव-\nन्मन्त्र्यैकाग्रो निश्चयं वै जगाम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042393, "chapter_id": 1946, "verse_number": "५-१९१-७", "content_sanskrit": "स्वभावगुप्तं नगरमापत्काले तु भारत।\nगोपयामास राजेन्द्र सर्वतः समलङ्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042394, "chapter_id": 1946, "verse_number": "५-१९१-८", "content_sanskrit": "आर्तिं च परमां राजा जगाम सह भार्यया।\nदशार्णपतिना सार्धं विरोधे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042395, "chapter_id": 1946, "verse_number": "५-१९१-९", "content_sanskrit": "कथं संबन्धिना सार्धं न मे स्याद्विग्रहो महान्।\nइति संचिन्त्य मनसा देवतामर्चयत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042396, "chapter_id": 1946, "verse_number": "५-१९१-१०", "content_sanskrit": "तं तु दृष्ट्वा तदा राजन्देवी देवपरं तदा।\nअर्चां प्रयुञ्जानमथो भार्या वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042397, "chapter_id": 1946, "verse_number": "५-१९१-११", "content_sanskrit": "देवानां प्रतिपत्तिश्च सत्यं साधुमता सताम् ।\nकिमु दुःस्वार्णवं प्राप्य तस्मादर्चयतां गुरून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042398, "chapter_id": 1946, "verse_number": "५-१९१-१२", "content_sanskrit": "दैवतानि च सर्वाणि पूज्यनां भूरिदक्षिणम् ।\nअग्नयश्चापि हृयन्तां दाशार्णप्रतिषेधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042399, "chapter_id": 1946, "verse_number": "५-१९१-१३", "content_sanskrit": "अयुद्धेन निवृत्तिं च मनसा चिन्तय प्रभो।\nदेवतानां प्रसादेन सर्वमेतद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042400, "chapter_id": 1946, "verse_number": "५-१९१-१४", "content_sanskrit": "मन्त्रिभिर्मन्त्रितं सार्धं त्वया पृथुललोचन।\nपुरस्यास्याविनाशाय यच्च राजंस्तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042401, "chapter_id": 1946, "verse_number": "५-१९१-१५", "content_sanskrit": "दैवं हि मानुषोपेतं भृशं सिद्ध्यति पार्थिव ।\nपरम्परविरोधाद्धि सिद्धिरस्ति न चैतयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042402, "chapter_id": 1946, "verse_number": "५-१९१-१६", "content_sanskrit": "तस्माद्विधाय नगरे विधानं सचिवैः सह।\nअर्चयस्व यथाकामं दैवतानि विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042403, "chapter_id": 1946, "verse_number": "५-१९१-१७", "content_sanskrit": "एवं संभाषमाणौ तु दृष्ट्वा शोकपरायणौ।\nशिखण्डिनी तदा कन्या व्रीडितेव तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042404, "chapter_id": 1946, "verse_number": "५-१९१-१८", "content_sanskrit": "ततः सा चिन्तयामास मन्कृते दुःखितावुभौ ।\nइमाविति ततश्चक्रे मतिं प्राणविनाशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042405, "chapter_id": 1946, "verse_number": "५-१९१-१९", "content_sanskrit": "एवं सा निश्चयं कृत्वा भृशं शोकपरायणा।\nनिर्जगाम गृहं त्यक्त्वा गहनं निर्जनं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042406, "chapter_id": 1946, "verse_number": "५-१९१-२०", "content_sanskrit": "यक्षेणर्द्धिमता राजन्स्थूणाकर्णेन पालितम् ।\nतद्भयादेव च जनो विसर्जयति तद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042407, "chapter_id": 1946, "verse_number": "५-१९१-२१", "content_sanskrit": "तत्र च स्थूणभवनं सुधामृत्तिकलेपनम् ।\nलाजोल्लापिकधूमाढ्यमुच्चप्राकारतोरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042408, "chapter_id": 1946, "verse_number": "५-१९१-२२", "content_sanskrit": "तन्प्रविश्य शिखण्डी सा द्रुपदस्यात्मजा नृप ।\nअनश्नाना बहुतिथं शरीरमुदशोपयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042409, "chapter_id": 1946, "verse_number": "५-१९१-२३", "content_sanskrit": "दर्शयामास तां यक्षः स्थूणो मार्दवसंयुतः ।\nकिमर्थोऽयं तवारम्भः करिष्ये ब्रूहि माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042410, "chapter_id": 1946, "verse_number": "५-१९१-२४", "content_sanskrit": "अशक्ययिति सा यक्षं पुनः पुनरुवाच ह।\nकरिष्यामीति वै क्षिप्रं प्रत्युवाचाथ गुह्यकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042411, "chapter_id": 1946, "verse_number": "५-१९१-२५", "content_sanskrit": "धनेश्वरस्यानुचरो वरदोऽस्मि नृपात्मजे।\nअदेयमपि दास्यादि ब्रूहि यत्ते विवक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042412, "chapter_id": 1946, "verse_number": "५-१९१-२६", "content_sanskrit": "ततः शिखण्डी तत्सर्वमखिलेन न्यवेदयत्।\nतस्मै यक्षप्रधानाय स्थूणाकर्णाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042413, "chapter_id": 1946, "verse_number": "५-१९१-२७x", "content_sanskrit": "शिखण्ड्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042414, "chapter_id": 1946, "verse_number": "५-१९१-२७", "content_sanskrit": "आपन्नो मे पिता यक्ष न चिरान्नाशमेष्यति।\nअभियास्यति सक्रोधो दशार्णाधिपतिर्हि तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042415, "chapter_id": 1946, "verse_number": "५-१९१-२८", "content_sanskrit": "मन्निमित्तं महोत्साहः सहेमकवचो नृपः ।\nतस्माद्रक्षस्व मां यक्ष मातरं पितरं च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042416, "chapter_id": 1946, "verse_number": "५-१९१-२९", "content_sanskrit": "प्रतिज्ञातो हि भवता दुःखप्रतिशमो मम ।\nभवेयं पुरुषो यक्ष त्वत्प्रसादादनिन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042417, "chapter_id": 1946, "verse_number": "५-१९१-३०", "content_sanskrit": "यावदेव स राजा वै नोपयाति पुरं मम ।\nतावदेव महायक्ष प्रसादं कुरु गुह्यक ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042418, "chapter_id": 1946, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यनपर्वणि एकनवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]