[{"id": 2111898, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111899, "chapter_id": 3415, "verse_number": "१", "content_sanskrit": "इक्ष्वाकूणामन्यतमो राजाऽऽसीत् पृथिवीपतिः ।\nमहाभिषगिति ख्यातः सत्यवाक् सत्यविक्रमः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111900, "chapter_id": 3415, "verse_number": "२", "content_sanskrit": "सोऽश्वमेधसहस्रेण शतसङ्ख्येन भारत ।\nतोषयामास देवेन्द्रं स्वर्गं लेभे च स प्रभुः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111901, "chapter_id": 3415, "verse_number": "३", "content_sanskrit": "ततः कदाचिद् ब्रह्माणमुपासाञ्चक्रिरे सुराः ।\nतथा राजर्षयः सर्वे स च राजा महाभिषक्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111902, "chapter_id": 3415, "verse_number": "४", "content_sanskrit": "अथ गङ्गा सरिच्छ्रेष्ठा समुपायात् पितामहम् ।\nतस्या वासः समुद्धूतं मारुतेन शशिप्रभम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111903, "chapter_id": 3415, "verse_number": "५", "content_sanskrit": "ततोऽभवन् सुरगणाः सहसाऽवाङ्मुखास्तदा ।\nमहाभिषक् तु राजर्षिरशङ्को दृष्टवान् नदीम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111904, "chapter_id": 3415, "verse_number": "६", "content_sanskrit": "सोऽपध्यातो भगवता ब्रह्मणा स महाभिषक् ।\nउक्तश्च जातो मर्त्येपु पुनर्लोकानवाप्स्यसि \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111905, "chapter_id": 3415, "verse_number": "७", "content_sanskrit": "मनुष्येषु चिरं स्थित्वा लोकान् प्राप्स्यसि शाश्वतान् ।\nयया हृतमनाश्चासि गङ्गया त्वं सुदुर्मते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111906, "chapter_id": 3415, "verse_number": "८", "content_sanskrit": "सा तु ते मानुषे लोके विप्रियाण्याचरिष्यति ।\nयदा ते भविता मन्युस्तदा शापाद् विमोक्ष्यसे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111907, "chapter_id": 3415, "verse_number": "९", "content_sanskrit": "स चिन्तयित्वा नृपतिर्नृपान् सर्वांस्तपोधनान् ।\nप्रतीपं रोचयामास पितरं भूरिवर्चसम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111908, "chapter_id": 3415, "verse_number": "१०", "content_sanskrit": "सा महाभिषजं दृष्ट्वा नदी धैर्याच्च्युतं नृपम् ।\nतमेव मनसा ध्वायन्त्युपावृत्ता सरिद्वरा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111909, "chapter_id": 3415, "verse_number": "११", "content_sanskrit": "सा च विध्वस्तसङ्काशान् कश्मलाभिहतान् भुवि ।\nददर्श पथि गच्छन्ती वसून् देवान् दिवौकसः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111910, "chapter_id": 3415, "verse_number": "१२", "content_sanskrit": "तथारूपांश्च तान् दृष्ट्वा पप्रच्छ सरितां वरा ।\nकिमिदं नष्टरूपाः स्थ कच्चित् क्षेमं दिवौकसाम् ।\nकिमर्थं मनुजा भूमौ निपतिष्यन्ति दुःखिताः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111911, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111912, "chapter_id": 3415, "verse_number": "१३", "content_sanskrit": "तामूचुर्वसवो दीनाः शप्ता वै स्मो महानदि ।\nअस्वयङ्कृतया बुद्ध्या वसिष्ठेन महात्मना \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111913, "chapter_id": 3415, "verse_number": "१४", "content_sanskrit": "वयं हि सहसा सर्वे प्रच्छन्नं नावबुध्नुमः ।\nसन्ध्यां वसिष्ठमासीनं तमभ्यनुसृताः पुरा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111914, "chapter_id": 3415, "verse_number": "१५", "content_sanskrit": "तेन कोपाद् वयं शाप्ता योनौ सम्भवतेति ह ।\nन तच्छक्यमकर्तुं च यदुक्तं ब्रह्मवादिना\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111915, "chapter_id": 3415, "verse_number": "१६", "content_sanskrit": "त्वमस्मान् मानुषी भूत्वा सूष्व पुत्रान् वसून् भुवि ।\nन मानुषीणां जठरं प्रविशाम कथञ्चन \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111916, "chapter_id": 3415, "verse_number": "१७", "content_sanskrit": "तानुवाच वसून् गङ्गा तथाऽस्तु समयादिति ।\nमर्त्येषु पुरुषश्रेष्ठः को वा भर्ता भविष्यति \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111917, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "वसवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111918, "chapter_id": 3415, "verse_number": "१८", "content_sanskrit": "प्रतीपस्य सुतो विद्वान् शन्तनुर्नाम धार्मिकः ।\nत्वत्कृते मानुषे जातः स नः कर्ता भविष्यति \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111919, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111920, "chapter_id": 3415, "verse_number": "१९", "content_sanskrit": "ममाप्येवं मनो जातं यथा मां वदथानघाः ।\nप्रियं तस्य करिष्यामि वचनं च दिवौकसाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111921, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "वसवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111922, "chapter_id": 3415, "verse_number": "२०", "content_sanskrit": "जातान् कुमारान् स्वानप्सु प्रक्षेप्तुं वै त्वमर्हसि ।\nयथा न चिरकालं नो निष्कृतिः स्यात् त्रिलोकगे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111923, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111924, "chapter_id": 3415, "verse_number": "२१", "content_sanskrit": "एवमेव करिष्यामि पुत्रस्तस्य विधीयताम्। ।\nनास्य मोघं भवेत् कर्म पुत्रहेतोः कृतं मया \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111925, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "वसवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111926, "chapter_id": 3415, "verse_number": "२२", "content_sanskrit": "तुर्यांशं वै प्रदास्यामो वीर्यस्यैकैकशो वयम् ।\nतेन वीर्येण पुत्रस्ते भविता तस्य चेप्सितः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111927, "chapter_id": 3415, "verse_number": "२३", "content_sanskrit": "न संपत्स्यति मर्त्येषु पुनस्तस्य च सन्ततिः ।\nअपुत्रस्तु नरव्याघ्रो भविष्यति सुतस्तव \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111928, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111929, "chapter_id": 3415, "verse_number": "२४", "content_sanskrit": "एवं च समयं कृत्वा गङ्गया वसवश्च ते ।\nजग्मुः प्रहृष्टमनसो यथासङ्कल्पमञ्जसा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111930, "chapter_id": 3415, "verse_number": "९४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायामादिपर्वणि\nचतुर्नवतितमोऽध्यायः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111931, "chapter_id": 3415, "verse_number": "४२", "content_sanskrit": "॥ इति सम्भवपर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111932, "chapter_id": 3415, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]