[{"id": 2123835, "chapter_id": 3655, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123836, "chapter_id": 3655, "verse_number": "१", "content_sanskrit": "आमन्त्रयामि भवतः तथा वृद्धं पितामहम् ।\nराजानं सोमदत्तं च महाराजं च बाह्लिकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123837, "chapter_id": 3655, "verse_number": "२", "content_sanskrit": "द्रोणं कृपं नृपांश्चान्यान् अश्वत्थामानमेव च ।\nविदुरं धृतराष्ट्रं च धार्तराष्ट्रांश्च सर्वशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123838, "chapter_id": 3655, "verse_number": "३", "content_sanskrit": "सौमदत्तिं महावीर्यं विकर्णं च महाबलम् ।\nयुयुत्सुं सञ्जयं चैव तथैवान्यान् सभासदः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123839, "chapter_id": 3655, "verse_number": "४", "content_sanskrit": "गान्धारीं च महाभागां मातरं च तथा पृथाम् ।\nसर्वानामन्त्र्य गच्छामि द्रक्ष्यामि पुनरेत्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123840, "chapter_id": 3655, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123841, "chapter_id": 3655, "verse_number": "५", "content_sanskrit": "नैव किञ्चित् तदोचुस्ते ह्रिया सन्तो युधिष्ठिरम् ।\nमनोभिरेव कल्याणं दध्युस्ते तस्य धीमतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123842, "chapter_id": 3655, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123843, "chapter_id": 3655, "verse_number": "६", "content_sanskrit": "आर्या पृथा राजपुत्री नारण्यं वस्तुमर्हति ।\nसुकुमारी च वृद्धा च नित्यं चैव सुखोचिता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123844, "chapter_id": 3655, "verse_number": "७", "content_sanskrit": "इह वत्स्यति कल्याणी सत्कृता मम वेश्मनि ।\nइदं पार्था विजानीध्वमभयं वोऽस्तु सर्वशः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123845, "chapter_id": 3655, "verse_number": "८", "content_sanskrit": "युधिष्ठिर विजानीहि ममेदं भरतर्षभ ।\nन धर्मोपचितः कश्चिद् विन्दते वै पराभवम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123846, "chapter_id": 3655, "verse_number": "९", "content_sanskrit": "त्वं वै धर्मं विजानीषे युद्धं वेत्ता धनञ्जयः ।\nहन्ताऽरीणां भीमसेनो नकुलस्त्वर्थसङ्ग्रही ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123847, "chapter_id": 3655, "verse_number": "१०", "content_sanskrit": "सहदेवस्तु संयन्ता धौम्यो ब्रह्मविदुत्तमः ।\nधर्मार्थकुशला चैव द्रौपदी धर्मचारिणी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123848, "chapter_id": 3655, "verse_number": "११", "content_sanskrit": "अन्योन्यस्य प्रियाः सर्वे तथैव प्रियवादिनः ।\nपरैरलङ्घ्याः सन्तुष्टाः को वो न स्पृहयेदिह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123849, "chapter_id": 3655, "verse_number": "१२", "content_sanskrit": "एष वै सर्वकल्याणः समाधिस्तव भारत ।\nनैव शत्रुर्विषहते शक्रेणापि समद्युतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123850, "chapter_id": 3655, "verse_number": "१३", "content_sanskrit": "हिमवत्यनुशिष्टोऽसि मेरुसावर्णिना पुरा ।\nद्वैपायनेन कृष्णेन नगरे वारणावते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123851, "chapter_id": 3655, "verse_number": "१४", "content_sanskrit": "भृगुतुङ्गे च रामेण दृषद्वत्यां च शम्भुना ।\nअश्रौषीरसितस्यापि महर्षेरथ धीमतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123852, "chapter_id": 3655, "verse_number": "१५", "content_sanskrit": "द्रष्टा सदा नारदस्य धौम्यस्तेऽयं पुरोहितः ।\nमहर्षिः साम्पराये ते बुद्धिं तामृषिपूजिताम् ।\nपुरूरवसमैलं च बुद्ध्या जयसि पाण्डव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123853, "chapter_id": 3655, "verse_number": "१६", "content_sanskrit": "शक्त्या जयसि राज्ञोऽन्यान् ऋषीन् धर्मोपसेवया ।\nऐन्द्रे जये धृतात्मा त्वं याम्ये कोपविधारणे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123854, "chapter_id": 3655, "verse_number": "१७", "content_sanskrit": "विसर्गे चैव धनदो वरुणश्चैव संयमे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123855, "chapter_id": 3655, "verse_number": "१८", "content_sanskrit": "आत्मप्रदाने सोम्ये त्वमग्र्यश्चैवात्मजीवने ।\nभूमेः क्षमां च तेजश्च सामग्र्यं सूर्यमण्डलात् ।\nवायोश्चैव बलं विद्धि भूतेभ्यश्चात्मसम्पदः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123856, "chapter_id": 3655, "verse_number": "१९", "content_sanskrit": "अगदं वोऽस्तु सर्वं वो द्रक्ष्यामि पुनरागतान् ।\nआपद्धर्मार्थकृच्छ्रेषु सर्वकार्येषु वा पुनः ।\nयथावत् प्रतिपद्येथाः काले काले युधिष्ठिर ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123857, "chapter_id": 3655, "verse_number": "२०", "content_sanskrit": "आपृष्टस्त्विह कौन्तेय स्वस्ति प्राप्नुहि भारत ।\nकृतार्थं स्वस्तिमन्तं त्वा द्रक्ष्यामः पुनरागतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123858, "chapter_id": 3655, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123859, "chapter_id": 3655, "verse_number": "२१", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा पाण्डवः सत्यविक्रमः ।\nभीष्मद्रोणौ नमस्कृत्य प्रातिष्ठत युधिष्ठिरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123860, "chapter_id": 3655, "verse_number": "५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि सप्तनवतितमोऽध्यायः ॥ ॥ अनुद्यूतपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]