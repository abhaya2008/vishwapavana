[{"id": 7003501000, "chapter_id": 23501, "verse_number": "१४१-१", "content_sanskrit": "अथ बदरिकाश्रममाहात्म्यम् ।\nश्रीवराह उवाच ।\nतस्मिन्हिमवतः पृष्ठे परं गुह्यमतः शृणु ।\nबदरीति च विख्याता देवानामपि दुर्ल्लभा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003501001, "chapter_id": 23501, "verse_number": "१४१-२", "content_sanskrit": "न तत्प्राप्नोति मनुजः कृत्वा कर्म सुदुष्करम् ।\nप्राप्नुवन्ति च भक्ता ये बदरीं विश्वतारिणीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003501002, "chapter_id": 23501, "verse_number": "१४१-३", "content_sanskrit": "दुर्ल्लभं तन्मम क्षेत्रं हिमकूटशिलातले ।\nयस्तत्प्राप्नोति हि क्षेत्रं कृतकृत्यो भवेन्नरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003501003, "chapter_id": 23501, "verse_number": "१४१-४", "content_sanskrit": "ब्रह्मकुण्डमिति ख्यातमास्ते तत्र शिलोच्चये ।\nहिमसंस्थं तथात्मानं कृत्वा तिष्ठामि माधवि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003501004, "chapter_id": 23501, "verse_number": "१४१-५", "content_sanskrit": "स्नानं करोति यस्तत्र त्रिरात्रोपोषितो नरः ।\nअग्निष्टोमस्य यज्ञस्य फलं प्राप्नोति मानवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003501005, "chapter_id": 23501, "verse_number": "१४१-६", "content_sanskrit": "मुञ्चेत्प्राणांस्तत्र यदि  व्रतनिष्ठो जितेन्द्रियः ।\nसत्यलोकमतिक्रम्य मम लोकं च गच्छति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003501006, "chapter_id": 23501, "verse_number": "१४१-७", "content_sanskrit": "अग्निसत्यपदं नाम तस्मिन्क्षेत्रे परं मम ।\nशृङ्गत्रयात्पतन्त्यत्र धारा मुसलसन्निभाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003501007, "chapter_id": 23501, "verse_number": "१४१-८", "content_sanskrit": "यस्तत्र कुरुते स्नानं त्रिरात्रोपोषितो नरः ।\nसत्यवादी भवेद्दक्षो मम कर्मपरायणः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003501008, "chapter_id": 23501, "verse_number": "१४१-९", "content_sanskrit": "यस्तत्र मुञ्चते प्राणान्यदि कृत्वा जलाशयम् ।\nसत्यलोकमतिक्रम्य मम लोके स मोदते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003501009, "chapter_id": 23501, "verse_number": "१४१-१०", "content_sanskrit": "इन्द्रलोकमिति ख्यातो बदर्यां च ममाश्रमः ।\nतत्राहं देवि शक्रेण निष्कलं परितोषितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003501010, "chapter_id": 23501, "verse_number": "१४१-११", "content_sanskrit": "तत्र चैव तु शृङ्गेभ्यः स्थूलधारा पतेत्पुनः ।\nस्थूले शिलातले तत्र मम धर्मो व्यवस्थितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003501011, "chapter_id": 23501, "verse_number": "१४१-१२", "content_sanskrit": "स्नानं करोति यस्तत्र  एकरात्रोषितो नरः ।\nसत्यवादी शुचिर्भूत्वा सत्यलोके महीयते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003501012, "chapter_id": 23501, "verse_number": "१४१-१३", "content_sanskrit": "अथात्र मुञ्चते प्राणान्कृत्वा चानाशकं व्रतम्।\nसत्यलोकमतिक्रम्य मम लोकेषु तिष्ठति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003501013, "chapter_id": 23501, "verse_number": "१४१-१४", "content_sanskrit": "अस्ति पञ्चशिखं नाम बदर्याश्रमतीर्थकम् ।\nयत्र धाराः पतन्त्यत्र पंचशृङ्गसमाश्रिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003501014, "chapter_id": 23501, "verse_number": "१४१-१५", "content_sanskrit": "यस्तत्र कुरुते स्नानं पंचस्रोतसि मानवः ।\nअश्वमेधफलं प्राप्य देवैश्च सह मोदते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003501015, "chapter_id": 23501, "verse_number": "१४१-१६", "content_sanskrit": "यद्यत्र मुञ्चते प्राणान् कृत्वा कर्म सुदुष्करम् ।\nस्वर्गलोकमतिक्रम्य मम लोके महीयते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003501016, "chapter_id": 23501, "verse_number": "१४१-१७", "content_sanskrit": "चतुःस्रोत इति ख्यातं तस्मिन्क्षेत्रे परे मम ।\nचतुर्धाराः पतन्त्यत्र चतस्रो दिश आश्रिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003501017, "chapter_id": 23501, "verse_number": "१४१-१८", "content_sanskrit": "यस्तत्र कुरुते स्नानमेकरात्रोषितो नरः ।\nमोदते नाकपृष्ठे तु मम भक्तश्च जायते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003501018, "chapter_id": 23501, "verse_number": "१४१-१९", "content_sanskrit": "अथ प्राणान्परित्यज्य कृत्वा कर्म सुदुष्करम् ।\nनाकपृष्ठमतिक्रम्य मम लोकं प्रपद्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003501019, "chapter_id": 23501, "verse_number": "१४१-२०", "content_sanskrit": "वेदधारमिति ख्यातं तस्मिन्क्षेत्रे परे मम ।\nयत्र ब्रह्ममुखाद्भ्रष्टा वेदाश्चत्वार एव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003501020, "chapter_id": 23501, "verse_number": "१४१-२१", "content_sanskrit": "तत्रैव हिमवत्पृष्ठे चतुःशृङ्गाद्बृहत्तराः ।\nचतुर्धाराः  पतन्त्यत्र विषमाश्च शिलोच्चये ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003501021, "chapter_id": 23501, "verse_number": "१४१-२२", "content_sanskrit": "यस्तत्र कुरुते स्नानं चतूरात्रोषितो नरः ।\nचतुर्णामपि वेदानां ग्रहणे कारणं भवेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003501022, "chapter_id": 23501, "verse_number": "१४१-२३", "content_sanskrit": "अथात्र मुञ्चते प्राणान्मम कर्मपथे स्थितः।\nदेवलोकमतिक्रम्य मम लोकं प्रतिष्ठते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003501023, "chapter_id": 23501, "verse_number": "१४१-२४", "content_sanskrit": "द्वादशादित्यकुण्डेति तस्मिन्क्षेत्रे परे मम ।\nयत्र ते द्वादशादित्या देवि संस्थापिता मया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003501024, "chapter_id": 23501, "verse_number": "१४१-२५", "content_sanskrit": "तत्र पर्वतशृंगे तु स्थूलमूले शिलातले ।\nद्वादश पतन्ति धारा मम कर्मसुखावहाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003501025, "chapter_id": 23501, "verse_number": "१४१-२६", "content_sanskrit": "यस्तत्र कुरुते स्नानं यां काञ्चिद्द्वादशीं यदि।\nयत्र ते द्वादशादित्यास्तत्र गच्छेन्न संशयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003501026, "chapter_id": 23501, "verse_number": "१४१-२७", "content_sanskrit": "अथात्र मुञ्चते प्राणान्मम कर्मणि संस्थितः ।\nसमतिक्रम्य चादित्यान् मम लोके महीयते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003501027, "chapter_id": 23501, "verse_number": "१४१-२८", "content_sanskrit": "लोकपालमिति ख्यातं तस्मिन्क्षेत्रे परे मम ।\nतत्र ते लोकपालास्तु मया संस्थापिताः पुरा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003501028, "chapter_id": 23501, "verse_number": "१४१-२९", "content_sanskrit": "तत्र पर्वतमध्ये तु स्थलकुण्डं बृहन्मम ।\nभित्वा पर्वतमुद्गीर्णं यत्र सोमसमुद्भवः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003501029, "chapter_id": 23501, "verse_number": "१४१-३०", "content_sanskrit": "तत्र स्नानं तु कुर्वीत ज्येष्ठमासस्य द्वादशीम् ।\nमोदते लोकपालेषु मम भक्तश्च जायते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003501030, "chapter_id": 23501, "verse_number": "१४१-३१", "content_sanskrit": "अथात्र मुञ्चते प्राणान्मम कर्मसु तत्परः ।\nलोकपालानतिक्रम्य मम लोकं प्रपद्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003501031, "chapter_id": 23501, "verse_number": "१४१-३२", "content_sanskrit": "अस्ति मेरोर्वरं नाम तस्मिन् गुह्यं परं मम ।\nतत्र स्थितेन वै भूमे मेरुः संस्थापितः स्वयम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003501032, "chapter_id": 23501, "verse_number": "१४१-३३", "content_sanskrit": "धारास्तिस्रः पतन्त्यत्र सुवर्णसदृशप्रभाः ।\nपतेत्तु तज्जलं भूमौ व्यक्तिं नैवोपलभ्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003501033, "chapter_id": 23501, "verse_number": "१४१-३४", "content_sanskrit": "यस्तत्र कुरुते स्नानं त्रिरात्रोपोषितो नरः ।\nमोदते मेरुशृंगेषु मम भक्तश्च जायते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003501034, "chapter_id": 23501, "verse_number": "१४१-३५", "content_sanskrit": "अथ तत्र मृतो देवि तस्मिन् गुह्ये परे मम ।\nमेरुपृष्ठमतिक्रम्य मम लोकं तु गच्छति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003501035, "chapter_id": 23501, "verse_number": "१४१-३६", "content_sanskrit": "मानसोद्भेदमिति च तत्रान्यत्तीर्थमुत्तमम् ।\nपृथ्वीमुद्भिद्य मध्ये तु जलं गच्छति सत्वरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003501036, "chapter_id": 23501, "verse_number": "१४१-३७", "content_sanskrit": "देवा अपि न जानन्ति तं देशं तत्र संस्थितम् ।\nमानुषा हि विजानन्ति भूम्यां पतति तज्जलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003501037, "chapter_id": 23501, "verse_number": "१४१-३८", "content_sanskrit": "यस्तत्र कुरुते स्नानमहोरात्रोषितो नरः ।\nमोदते मानसे दिव्ये मम भक्तश्च जायते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003501038, "chapter_id": 23501, "verse_number": "१४१-३९", "content_sanskrit": "अस्ति पञ्चशिरं नाम तस्मिन्गुह्यं परं मम ।\nब्रह्मणा च्छिद्यते यत्र शिरश्चैव महाद्युति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003501039, "chapter_id": 23501, "verse_number": "१४१-४०", "content_sanskrit": "तत्र वै पंच कुण्डानि स्थूलशीर्षशिलोच्चये ।\nपञ्चात्र शिरसः स्थाने बहुधारासमन्विताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003501040, "chapter_id": 23501, "verse_number": "१४१-४१", "content_sanskrit": "यत्र तन्मध्यमं कुण्डं छिन्नमेव स्वयम्भुवा ।\nतत्र रक्तजला भूमिर्दृश्यते धारसंकुला ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003501041, "chapter_id": 23501, "verse_number": "१४१-४२", "content_sanskrit": "यस्तत्र कुरुते स्नानं पंचरात्रोषितो नरः ।\nमोदते ब्रह्मलोकस्थो मम भक्तश्च जायते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003501042, "chapter_id": 23501, "verse_number": "१४१-४३", "content_sanskrit": "तथात्र मुञ्चते प्राणान् गुह्ये पञ्चशिरे मम ।\nजलचांद्रायणं कृत्वा मम कर्मसु निष्ठितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003501043, "chapter_id": 23501, "verse_number": "१४१-४४", "content_sanskrit": "बुद्धिमान्मतिमांश्चैव रागमोहविवर्जितः ।\nब्रह्मलोकमतिक्रम्य मम लोकं स गच्छति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003501044, "chapter_id": 23501, "verse_number": "१४१-४५", "content_sanskrit": "अस्ति सोमाभिषेकेति तीर्थमन्यत्परं मम।\nराजत्वे ब्राह्मणानां तु मया सोमोऽभिषेचितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003501045, "chapter_id": 23501, "verse_number": "१४१-४६", "content_sanskrit": "तत्राहं तोषितस्तेन अत्रिपुत्रेण माधवि ।\nनवपञ्चककोट्यस्तु कृत्वा कर्म सुदुष्करम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003501046, "chapter_id": 23501, "verse_number": "१४१-४७", "content_sanskrit": "प्राप्तश्च परमां सिद्धिं मत्प्रसादाद्वसुन्धरे ।\nतदायत्तं जगत्सर्वं व्रीहयः परमौषधीः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003501047, "chapter_id": 23501, "verse_number": "१४१-४८", "content_sanskrit": "जायतेऽस्मिन्प्रलीयंते स्कन्देन्द्राः समरुद्गणाः ।\nभूमे सोममयं सर्वं मम संस्थं भविष्यति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003501048, "chapter_id": 23501, "verse_number": "१४१-४९", "content_sanskrit": "तत्र सोमगिरिर्नाम यत्र धारा पतेद्भुवि ।\nकुण्डेऽरण्ये विशाले तु एतत्ते कथितं मया ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003501049, "chapter_id": 23501, "verse_number": "१४१-५०", "content_sanskrit": "यस्तत्र कुरुते स्नानं त्रिरात्रोपोषितो नरः ।\nमोदते सोमलोकेषु एवमेतन्न संशयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003501050, "chapter_id": 23501, "verse_number": "१४१-५१", "content_sanskrit": "अथात्र म्रियते देवि कृत्वा कर्म सुदुष्करम् ।\nसोमलोकमतिक्रम्य मम लोकं प्रपद्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003501051, "chapter_id": 23501, "verse_number": "१४१-५२", "content_sanskrit": "अस्ति चोर्वशिकुण्डेति गुह्यं क्षेत्रे परं मम ।\nयत्र चैवोर्वशी भित्त्वा दक्षिणोरुमजायत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003501052, "chapter_id": 23501, "verse_number": "१४१-५३", "content_sanskrit": "तत्र तप्याम्यहं देवि देवानामपि कारणात् ।\nन मां कश्चिद्विजानाति स्वात्मानो हि विजानते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003501053, "chapter_id": 23501, "verse_number": "१४१-५४", "content_sanskrit": "ततो मे तप्यमानस्य बहुवर्षव्यतिक्रमात् ।\nदेवा अपि न जानन्ति वज्रिब्रह्ममहेश्वराः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003501054, "chapter_id": 23501, "verse_number": "१४१-५५", "content_sanskrit": "एकैकेन फलेनाऽत्र बदर्यां तु सुनिश्चितम् ।\nबहुवर्षसहस्रं तु तपश्चीर्णं मया भुवि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003501055, "chapter_id": 23501, "verse_number": "१४१-५६", "content_sanskrit": "तत्राहं दश कोट्यस्तु दशवर्षं दशार्बुदम् ।\nदश भूमे तथान्यानि पद्मानि तपसि स्थितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003501056, "chapter_id": 23501, "verse_number": "१४१-५७", "content_sanskrit": "ततस्ते मां न पश्यन्ति देवा गुह्यपथे स्थितम् ।\nविस्मयं परमं जग्मुर्देवा दुःखपरायणाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003501057, "chapter_id": 23501, "verse_number": "१४१-५८", "content_sanskrit": "अहं पश्यामि सर्वं वै तपःसंस्थो वसुन्धरे ।\nन मां सर्वे प्रपश्यन्ति योगमायासमावृताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003501058, "chapter_id": 23501, "verse_number": "१४१-५९", "content_sanskrit": "ततस्ता देवताः सर्वाः प्रत्यूचुश्च पितामहम् ।\nविष्णुना च विना लोके शान्तिं नैव लभामहे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003501059, "chapter_id": 23501, "verse_number": "१४१-६०", "content_sanskrit": "देवानां तु वचः श्रुत्वा ब्रह्मा लोकापितामहः ।\nयोगमायापटच्छन्नं कथयामास मां तदा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003501060, "chapter_id": 23501, "verse_number": "१४१-६१", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः ।\nतत्र जग्मुर्महाभागे तुष्यन्तः परमं मुदा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003501061, "chapter_id": 23501, "verse_number": "१४१-६२", "content_sanskrit": "विभावयन्ति मां तत्र देवा इन्द्रपुरोगमाः ।\nत्वया नाथ परित्यक्ता दुःखिताः श्रमवर्जिताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003501062, "chapter_id": 23501, "verse_number": "१४१-६३", "content_sanskrit": "त्रायस्व नो हृषीकेश परमानुग्रहेण वै ।\nएतत्कृत्वा विशालाक्षि देवान् प्रणतिपूर्वकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003501063, "chapter_id": 23501, "verse_number": "१४१-६४", "content_sanskrit": "मया विलोकिताः सर्वे परां निर्वृतिमागताः ।\nएतस्मिन्नुर्वशीकुण्डे एकरात्रोषितो नरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003501064, "chapter_id": 23501, "verse_number": "१४१-६५", "content_sanskrit": "यः स्नाति सर्वपापेभ्यो मुच्यते नात्र संशयः ।\nउर्वशीलोकमासाद्य क्रीडते कालमक्षयम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003501065, "chapter_id": 23501, "verse_number": "१४१-६६", "content_sanskrit": "यस्तत्रोत्सृजते प्राणान्मम कर्मपरायणः ।\nपुण्यपापविनिर्मुक्तो याति मल्लीनतां प्रिये ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003501066, "chapter_id": 23501, "verse_number": "१४१-६७", "content_sanskrit": "श्रीबदर्याश्रमं पुण्यं यत्र यत्र स्थितः स्मरेत् ।\nस याति वैष्णवं स्थानं पुनरावृत्तिवर्जितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003501067, "chapter_id": 23501, "verse_number": "१४१-६८", "content_sanskrit": "य इदं शृणुयान्नित्यं मद्भक्तः सततं पठेत् ।\nब्रह्मचारी जितक्रोधः सत्यवादी जितेन्द्रियः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003501068, "chapter_id": 23501, "verse_number": "१४१-६९", "content_sanskrit": "ध्यानयोगरतो नित्यं स मुक्तिफलभाग्भवेत् ।\nयस्यैतद्विदितं सर्वं ध्यानयोगं वसुन्धरे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003501069, "chapter_id": 23501, "verse_number": "१४१-७०", "content_sanskrit": "योऽवगच्छति चात्मानं स गच्छेत्परमां गतिम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]