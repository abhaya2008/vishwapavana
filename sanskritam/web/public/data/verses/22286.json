[{"id": 7002286000, "chapter_id": 22286, "verse_number": "३३१-१", "content_sanskrit": "अग्निरुवाच ।\nचतुःशतमुत्कृतिः स्यादुकृतेश्चतुरस्त्यजेत् ।\nअभिसंव्या प्रत्यकृतिस्तानि छन्दांसि वै पृथक् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002286001, "chapter_id": 22286, "verse_number": "३३१-२", "content_sanskrit": "कृतिश्चातिधृतिवृत्ती अत्यष्टिष्चाष्टिरित्यतः ।\nअतिशर्क्करी शक्करीति अतिजगती जगत्यपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002286002, "chapter_id": 22286, "verse_number": "३३१-३", "content_sanskrit": "छन्दोऽत्र लौकिकंस्याच्च आर्षमात्रैष्टुभात् स्मृतम् ।\nत्रिष्टुप्पङ्क्तिवृहती अनुष्टुवुष्णिगी रितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002286003, "chapter_id": 22286, "verse_number": "३३१-४", "content_sanskrit": "गायत्री स्यात् सुप्रतिष्ठा प्रतिष्ठा मध्यया सह ।\nअत्युक्तात्युक्त आदिश्च एकैकाक्षरवर्जितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002286004, "chapter_id": 22286, "verse_number": "३३१-५", "content_sanskrit": "चतुर्भागो भवेत् पादो गण्च्छन्दः प्रदर्श्यते ।\nतावन्तः समुद्रा गणा ह्यादिमध्यान्तसर्वगाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002286005, "chapter_id": 22286, "verse_number": "३३१-६", "content_sanskrit": "चतुर्णः पञ्च च गणा आर्य्यालक्षणमुच्यते ।\nस्वरार्द्धञ्चार्य्यार्द्धं स्यादार्य्यांयां विषमेनजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002286006, "chapter_id": 22286, "verse_number": "३३१-७", "content_sanskrit": "षष्ठो जो नलपूर्वा स्याद्द्वितीयादिपदं नले ।\nसप्तमेऽन्ते प्रथमा च द्वितीये पञ्चमे नले ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002286007, "chapter_id": 22286, "verse_number": "३३१-८", "content_sanskrit": "अर्द्धे पदं प्रथमादि षष्ठ एको लघुर्भवेत् ।\nत्रिषु गणेषु पादः स्यादार्य्या पञ्चार्द्धके स्मृता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002286008, "chapter_id": 22286, "verse_number": "३३१-९", "content_sanskrit": "विपुलान्याथ चपला गुरुमध्यागतौ च जौ ।\nद्वितीयचतुर्थौ पूर्वे च चपला मुखपुर्विका ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002286009, "chapter_id": 22286, "verse_number": "३३१-१०", "content_sanskrit": "द्वितीथे जघनपूर्व्वा चपलार्य्या प्रकीर्त्तिता ।\nउभयोर्महाचपला गीतवाद्यार्द्धतुल्यका ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002286010, "chapter_id": 22286, "verse_number": "३३१-११", "content_sanskrit": "अन्त्येनार्द्धेनोपगीतिरुद्गीतिश्चोत्क्रमात् स्मृता ।\nअर्द्धे रक्षगणा आर्य्या गीतच्छन्दोऽथ मात्रया ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002286011, "chapter_id": 22286, "verse_number": "३३१-१२", "content_sanskrit": "वैतालीयं द्विस्वरा स्यादयुष्पादे समे नलः ।\nवसवोऽन्ते वनगाश्च गोपुच्छन्दशकं भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002286012, "chapter_id": 22286, "verse_number": "३३१-१३", "content_sanskrit": "भगणआन्ता पाटलिका शेषे परे च पूर्ववत् ।\nसाकं षड्वा मिश्रायुक् प्राच्यवृत्तिः प्रदर्श्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002286013, "chapter_id": 22286, "verse_number": "३३१-१४", "content_sanskrit": "पञ्चमेन पूर्वसाकं तृतीयेन सहस्रयुक् ।\nउदीच्यवृत्तिर्वाच्यां स्याद् युगपच्च प्रवर्त्तकं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002286014, "chapter_id": 22286, "verse_number": "३३१-१५", "content_sanskrit": "अयुक्चारुहासिनी स्याद्युगपच्चान्तिका भवेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002286015, "chapter_id": 22286, "verse_number": "३३१-१६", "content_sanskrit": "सप्तार्च्चिर्वसवश्चैव मात्रासमकमीरितम् ।\nभवेन्नलवमौ लश्च द्वादशो वा नवासिका ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002286016, "chapter_id": 22286, "verse_number": "३३१-१७", "content_sanskrit": "विश्वोकः पञ्चमाष्टौ मो चित्र लवमकश्चलः ।\nपरयुक्तेनोपचित्रा पादाकुलकमित्यतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002286017, "chapter_id": 22286, "verse_number": "३३१-१८", "content_sanskrit": "गीतार्य्या लोपश्चेत् सौम्या लः पूर्वः ज्योतिरीरिता ।\nस्याच्छिखा विपर्य्यास्तार्द्धा तूलिका समुदाहृता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002286018, "chapter_id": 22286, "verse_number": "३३१-१९", "content_sanskrit": "एकोनत्रिंशदन्ते गः स्याज्ज्ञेजनसमावला ।\nगु इत्येकगुरुं संख्यावर्णाद्दशविपर्य्ययात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]