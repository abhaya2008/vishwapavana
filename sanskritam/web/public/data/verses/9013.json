[{"id": 5000013000, "chapter_id": 9013, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000013001, "chapter_id": 9013, "verse_number": "१-१३-१", "content_sanskrit": "पुनः प्राप्ते वसन्ते तु पूर्णः संवत्सरोऽभवत् ।\nप्रसवार्थं गतो यष्टुं हयमेधेन वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000013002, "chapter_id": 9013, "verse_number": "१-१३-२", "content_sanskrit": "अभिवाद्य वसिष्ठं च न्यायतः प्रतिपूज्य च ।\nअब्रवीत् प्रश्रितं वाक्यं प्रसवार्थं द्विजोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000013003, "chapter_id": 9013, "verse_number": "१-१३-३", "content_sanskrit": "यज्ञो मे क्रियतां ब्रह्मन् यथोक्तं मुनिपुङ्गव ।\nयथा न विघ्नाः क्रियन्ते यज्ञाङ्गेषु विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000013004, "chapter_id": 9013, "verse_number": "१-१३-४", "content_sanskrit": "भवान् स्निग्धः सुहृन्मह्यं गुरुश्च परमो महान् ।\nवोढव्यो भवता चैव भारो यज्ञस्य चोद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000013005, "chapter_id": 9013, "verse_number": "१-१३-५", "content_sanskrit": "तथेति च स राजानमब्रवीद् द्विजसत्तमः ।\nकरिष्ये सर्वमेवैतद् भवता यत् समर्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000013006, "chapter_id": 9013, "verse_number": "१-१३-६", "content_sanskrit": "ततोऽब्रवीद् द्विजान् वृद्धान् यज्ञकर्मसुनिष्ठितान् ।\nस्थापत्ये निष्ठितांश्चैव वृद्धान् परमधार्मिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000013007, "chapter_id": 9013, "verse_number": "१-१३-७", "content_sanskrit": "कर्मान्तिकाञ्शिल्पकारान् वर्धकीन् खनकानपि ।\nगणकाञ्शिल्पिनश्चैव तथैव नटनर्तकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000013008, "chapter_id": 9013, "verse_number": "१-१३-८", "content_sanskrit": "तथा शुचीञ्शास्त्रविदः पुरुषान् सुबहुश्रुतान् ।\nयज्ञकर्म समीहन्तां भवन्तो राजशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000013009, "chapter_id": 9013, "verse_number": "१-१३-९", "content_sanskrit": "इष्टका बहुसाहस्री शीघ्रमानीयतामिति ।\nउपकार्याः क्रियन्तां च राज्ञो बहुगुणान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000013010, "chapter_id": 9013, "verse_number": "१-१३-१०", "content_sanskrit": "ब्राह्मणावसथाश्चैव कर्तव्याः शतशः शुभाः ।\nभक्ष्यान्नपानैर्बहुभिः समुपेताः सुनिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000013011, "chapter_id": 9013, "verse_number": "१-१३-११", "content_sanskrit": "तथा पौरजनस्यापि कर्तव्याश्च सुविस्तराः ।\nआगतानां सुदूराच्च पार्थिवानां पृथक् पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000013012, "chapter_id": 9013, "verse_number": "१-१३-१२", "content_sanskrit": "वाजिवारणशालाश्च तथा शय्यागृहाणि च ।\nभटानां महदावासा वैदेशिकनिवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000013013, "chapter_id": 9013, "verse_number": "१-१३-१३", "content_sanskrit": "आवासा बहुभक्ष्या वै सर्वकामैरुपस्थिताः ।\nतथा पौरजनस्यापि जनस्य बहुशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000013014, "chapter_id": 9013, "verse_number": "१-१३-१४", "content_sanskrit": "दातव्यमन्नं विधिवत् सत्कृत्य न तु लीलया ।\nसर्वे वर्णा यथा पूजां प्राप्नुवन्ति सुसत्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000013015, "chapter_id": 9013, "verse_number": "१-१३-१५", "content_sanskrit": "न चावज्ञा प्रयोक्तव्या कामक्रोधवशादपि ।\nयज्ञकर्मसु ये व्यग्राः पुरुषाः शिल्पिनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000013016, "chapter_id": 9013, "verse_number": "१-१३-१६", "content_sanskrit": "तेषामपि विशेषेण पूजा कार्या यथाक्रमम् ।\nये स्युः सम्पूजिताः सर्वे वसुभिर्भोजनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000013017, "chapter_id": 9013, "verse_number": "१-१३-१७", "content_sanskrit": "यथा सर्वं सुविहितं न किंचित् परिहीयते ।\nतथा भवन्तः कुर्वन्तु प्रीतियुक्तेन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000013018, "chapter_id": 9013, "verse_number": "१-१३-१८", "content_sanskrit": "ततः सर्वे समागम्य वसिष्ठमिदमब्रुवन् ।\nयथेष्टं तत् सुविहितं न किंचित् परिहीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000013019, "chapter_id": 9013, "verse_number": "१-१३-१९", "content_sanskrit": "यथोक्तं तत् करिष्यामो न किंचित् परिहास्यते ।\nततः सुमन्त्रमाहूय वसिष्ठो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000013020, "chapter_id": 9013, "verse_number": "१-१३-२०", "content_sanskrit": "निमन्त्रयस्व नृपतीन् पृथिव्यां ये च धार्मिकाः ।\nब्राह्मणान् क्षत्रियान् वैश्याञ्शूद्रांश्चैव सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000013021, "chapter_id": 9013, "verse_number": "१-१३-२१", "content_sanskrit": "समानयस्व सत्कृत्य सर्वदेशेषु मानवान् ।\nमिथिलाधिपतिं शूरं जनकं सत्यवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000013022, "chapter_id": 9013, "verse_number": "१-१३-२२", "content_sanskrit": "तमानय महाभागं स्वयमेव सुसत्कृतम् ।\nपूर्वं सम्बन्धिनं ज्ञात्वा ततः पूर्वं ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000013023, "chapter_id": 9013, "verse_number": "१-१३-२३", "content_sanskrit": "तथा काशिपतिं स्निग्धं सततं प्रियवादिनम् ।\nसद्वृत्तं देवसंकाशं स्वयमेवानयस्व ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000013024, "chapter_id": 9013, "verse_number": "१-१३-२४", "content_sanskrit": "तथा केकयराजानं वृद्धं परमधार्मिकम् ।\nश्वशुरं राजसिंहस्य सपुत्रं तमिहानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000013025, "chapter_id": 9013, "verse_number": "१-१३-२५", "content_sanskrit": "अङ्गेश्वरं महेष्वासं रोमपादं सुसत्कृतम् ।\nवयस्यं राजसिंहस्य सपुत्रं तमिहानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000013026, "chapter_id": 9013, "verse_number": "१-१३-२६", "content_sanskrit": "तथा कोसलराजानं भानुमन्तं सुसंस्कृतम् ।\nमगधाधिपतिं शूरं सर्वशास्त्रविशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000013027, "chapter_id": 9013, "verse_number": "१-१३-२७", "content_sanskrit": "प्राप्तिज्ञं परमोदारं सत्कृतं पुरुषर्षभम् ।\nराज्ञः शासनमादाय चोदयस्व नृपर्षभान् ।\nप्राचीनान् सिन्धुसौवीरान् सौराष्ठ्रेयांश्च पार्थिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000013028, "chapter_id": 9013, "verse_number": "१-१३-२८", "content_sanskrit": "दाक्षिणात्यान् नरेन्द्रांश्च समस्तानानयस्व ह ।\nसन्ति स्निग्धाश्च ये चान्ये राजानः पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000013029, "chapter_id": 9013, "verse_number": "१-१३-२९", "content_sanskrit": "तानानय यथा क्षिप्रं सानुगान् सहबान्धवान् ।\nएतान् दूतैर्महाभागैरानयस्व नृपाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000013030, "chapter_id": 9013, "verse_number": "१-१३-३०", "content_sanskrit": "वसिष्ठवाक्यं तच्छ्रुत्वा सुमन्त्रस्त्वरितं तदा ।\nव्यादिशत् पुरुषांस्तत्र राज्ञामानयने शुभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000013031, "chapter_id": 9013, "verse_number": "१-१३-३१", "content_sanskrit": "स्वयमेव हि धर्मात्मा प्रयातो मुनिशासनात् ।\nसुमन्त्रस्त्वरितो भूत्वा समानेतुं महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000013032, "chapter_id": 9013, "verse_number": "१-१३-३२", "content_sanskrit": "ते च कर्मान्तिकाः सर्वे वसिष्ठाय महर्षये ।\nसर्वं निवेदयन्ति स्म यज्ञे यदुपकल्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000013033, "chapter_id": 9013, "verse_number": "१-१३-३३", "content_sanskrit": "ततः प्रीतो द्विजश्रेष्ठस्तान् सर्वान् मुनिरब्रवीत् ।\nअवज्ञया न दातव्यं कस्यचिल्लीलयापि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000013034, "chapter_id": 9013, "verse_number": "१-१३-३४", "content_sanskrit": "अवज्ञया कृतं हन्याद् दातारं नात्र संशयः ।\nततः कैश्चिदहोरात्रैरुपयाता महीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000013035, "chapter_id": 9013, "verse_number": "१-१३-३५", "content_sanskrit": "बहूनि रत्नान्यादाय राज्ञो दशरथस्य ह ।\nततो वसिष्ठः सुप्रीतो राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000013036, "chapter_id": 9013, "verse_number": "१-१३-३६", "content_sanskrit": "उपयाता नरव्याघ्र राजानस्तव शासनात् ।\nमयापि सत्कृताः सर्वे यथार्हं राजसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000013037, "chapter_id": 9013, "verse_number": "१-१३-३७", "content_sanskrit": "यज्ञियं च कृतं सर्वं पुरुषैः सुसमाहितैः ।\nनिर्यातु च भवान् यष्टुं यज्ञायतनमन्तिकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000013038, "chapter_id": 9013, "verse_number": "१-१३-३८", "content_sanskrit": "सर्वकामैरुपहृतैरुपेतं वै समन्ततः ।\nद्रष्टुमर्हसि राजेन्द्र मनसेव विनिर्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000013039, "chapter_id": 9013, "verse_number": "१-१३-३९", "content_sanskrit": "तथा वसिष्ठवचनादृशष्यशृङ्गस्य चोभयोः ।\nदिवसे शुभनक्षत्रे निर्यातो जगतीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000013040, "chapter_id": 9013, "verse_number": "१-१३-४०", "content_sanskrit": "ततो वसिष्ठप्रमुखाः सर्व एव द्विजोत्तमाः ।\nऋष्यशृङ्गं पुरस्कृत्य यज्ञकर्मारभंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000013041, "chapter_id": 9013, "verse_number": "१-१३-४१", "content_sanskrit": "यज्ञवाटं गताः सर्वे यथाशास्त्रं यथाविधि ।\nश्रीमांश्च सह पत्नीभी राजा दीक्षामुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000013042, "chapter_id": 9013, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]