[{"id": 2038352, "chapter_id": 1837, "verse_number": "५-८२-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038353, "chapter_id": 1837, "verse_number": "५-८२-१", "content_sanskrit": "कुरूणामद्य सर्वेषां भवान्सुहृदनुत्तमः।\nसंबन्धी दयितो नित्यमुभयोः पक्षयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038354, "chapter_id": 1837, "verse_number": "५-८२-२", "content_sanskrit": "पाण्डवैर्धार्तराष्ट्राणां प्रतिपाद्यमनामयम्।\nसमर्थः प्रशमं चैव कर्तुमर्हसि केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038355, "chapter_id": 1837, "verse_number": "५-८२-३", "content_sanskrit": "त्वमित्तः पुण्डरीकाक्ष सुयोधनममर्षणम् ।\nशान्त्यर्थं भ्रातरं ब्रूया यत्तद्वाच्यममित्रहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038356, "chapter_id": 1837, "verse_number": "५-८२-४", "content_sanskrit": "त्वया धर्मार्थयुक्तं चेदुक्तं शिवमनामयम्।\nहितं नादास्यते बालो दिष्टस्य वशमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038357, "chapter_id": 1837, "verse_number": "५-८२-५x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038358, "chapter_id": 1837, "verse_number": "५-८२-५", "content_sanskrit": "धर्म्यमस्मद्धितं चैव कुरूणां यदनामयम्।\nएष यास्यामि राजानं धृतराष्ट्रमभीप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038359, "chapter_id": 1837, "verse_number": "५-८२-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038360, "chapter_id": 1837, "verse_number": "५-८२-६", "content_sanskrit": "ततो व्यपेते तमसि सूर्ये विमल उद्गते ।\nमैत्रे मुहूर्ते संप्राप्ते मद्वर्चिषि दिवाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038361, "chapter_id": 1837, "verse_number": "५-८२-७", "content_sanskrit": "कौमुदे मासि रेवत्यां शरदन्ते हिमागमे ।\nस्फीतसस्यसुखे काले कल्यः सत्ववतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038362, "chapter_id": 1837, "verse_number": "५-८२-८", "content_sanskrit": "मङ्गल्याः पुण्यनिर्घोषा वाचः श्रृण्वंश्च सूनृताः ।\nब्राह्मणानां प्रतीतानामृषीणामिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038363, "chapter_id": 1837, "verse_number": "५-८२-९", "content_sanskrit": "कृत्वा पौर्वाह्णिकं कृत्यं स्नातः शुचिरलङ्कृतः ।\nउपतस्थे विवस्वन्तं पावकं च जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038364, "chapter_id": 1837, "verse_number": "५-८२-१०", "content_sanskrit": "ऋषभं पृष्ठ आलभ्य ब्राह्मणानभिवाद्य च।\nअग्निं प्रदक्षिणं कृत्वा पश्यन्कल्याणमग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038365, "chapter_id": 1837, "verse_number": "५-८२-११", "content_sanskrit": "तत्प्रतिज्ञाय वचनं पाण्डवस्य जनार्दनः।\nशिनेर्नप्तारमासीनमभ्यभाषत सात्यकिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038366, "chapter_id": 1837, "verse_number": "५-८२-१२", "content_sanskrit": "रथ आरोप्यतां शङ्खश्चक्रं च गदया सह।\nउपासङ्गाश्च शक्त्यश्च सर्वप्रहरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038367, "chapter_id": 1837, "verse_number": "५-८२-१३", "content_sanskrit": "दुर्योधनश्च दुष्टात्मा कर्णश्च सहसौबलः ।\nन च शत्रुरवज्ञेयो दुर्बलोऽपि बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038368, "chapter_id": 1837, "verse_number": "५-८२-१४", "content_sanskrit": "ततस्तन्मतमाज्ञाय केशवस्य पुनःसराः ।\nप्रसस्त्नुर्योजयिष्यन्तो रथं चक्रगदाभृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038369, "chapter_id": 1837, "verse_number": "५-८२-१५", "content_sanskrit": "तं दीप्तमिव कालाग्निमाकाशगमिवाशुगम् ।\nसूर्यचन्द्रप्रकाशाभ्यां चक्राभ्यां समलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038370, "chapter_id": 1837, "verse_number": "५-८२-१६", "content_sanskrit": "अर्धचन्द्रैश्च चन्द्रैश्च मत्स्यैः समृगपक्षिभिः ।\nपुष्पैश्च विविधैश्चित्रं मणिरत्नैश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038371, "chapter_id": 1837, "verse_number": "५-८२-१७", "content_sanskrit": "तरुणादित्यसङ्काशं बृहन्तं चारुदर्शनम् ।\nमणिहेमविचित्राङ्गं सुध्वजं सुपताकिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038372, "chapter_id": 1837, "verse_number": "५-८२-१८", "content_sanskrit": "सूपस्करमनाधृष्यं वैयाघ्रपरिवारणम्।\nयशोघ्नं प्रत्यमित्राणां यदूनां नन्दिवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038373, "chapter_id": 1837, "verse_number": "५-८२-१९", "content_sanskrit": "वाजिभिः शैब्यसुग्रीवमेधपुष्पबलाहकैः ।\nस्नातैः संपादयामासुः संपन्नैः सर्वसंपदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038374, "chapter_id": 1837, "verse_number": "५-८२-२०", "content_sanskrit": "महिमानं तु कृष्णस्य भूय एवाभिवर्धयन्।\nसुघोषः पतगेन्द्रेण ध्वजेन युयुजे रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038375, "chapter_id": 1837, "verse_number": "५-८२-२१", "content_sanskrit": "तं मेरुशिखरप्रख्यं मेघदुन्दुभिनिस्वनम् ।\nआरुरोह रथं सौरिर्विमानमिव कामगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038376, "chapter_id": 1837, "verse_number": "५-८२-२२", "content_sanskrit": "ततः सात्यकिमारोप्य प्रययौ पुरुषोत्तमः।\nपृथिवीं चान्तरिक्षं च रथघोषेण नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038377, "chapter_id": 1837, "verse_number": "५-८२-२३", "content_sanskrit": "व्यपोढाभ्रस्ततः कालः क्षणेन समपद्यत।\nशिवश्चानुववौ वायुः प्रशान्तमभवद्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038378, "chapter_id": 1837, "verse_number": "५-८२-२४", "content_sanskrit": "प्रदक्षिणानुलोमाश्च मङ्गल्या मृगपक्षिणः।\nप्रयाणे वासुदेवस्य बभूवुरनुयायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038379, "chapter_id": 1837, "verse_number": "५-८२-२५", "content_sanskrit": "मङ्गल्यार्थप्रदैः शब्दैरन्ववर्तन्त सर्वशः।\nसारसाः शतपत्राश्च हंसाश्च मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038380, "chapter_id": 1837, "verse_number": "५-८२-२६", "content_sanskrit": "मन्त्राहुतिमहाहोमैर्हूयमानश्च पावकः ।\nप्रदक्षिणशिखो भूत्वा विधूमः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038381, "chapter_id": 1837, "verse_number": "५-८२-२७", "content_sanskrit": "वसिष्ठो वामदेवश्च भूरिद्युम्नो गयः क्रथः।\nशुकनारदवाल्मीका मरुत्तः कुशिको भृगुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038382, "chapter_id": 1837, "verse_number": "५-८२-२८", "content_sanskrit": "देवब्रह्मर्षयश्चैव कृष्णं यदुसुखावहम्।\nप्रदक्षिणमवर्तन्त सहिता वासवानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038383, "chapter_id": 1837, "verse_number": "५-८२-२९", "content_sanskrit": "एवमेतैर्महाभागैर्महर्षिगणसाधुभिः ।\nपूजितः प्रययौ कृष्णः कुरूणां सदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038384, "chapter_id": 1837, "verse_number": "५-८२-३०", "content_sanskrit": "` देवताभ्यो नमस्कृत्य ब्राह्मणान्स्वस्ति वाच्य च।\nप्रययौ पुण्डरीकाक्षः सात्यकेन सहाच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038385, "chapter_id": 1837, "verse_number": "५-८२-३१", "content_sanskrit": "तं प्रयान्तमनुप्रायात्कुन्तीपुत्रो युधिष्ठिरः ।\nभीमसेनार्जुनौ चोभौ माद्रीपुत्रौ च पाण्डवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038386, "chapter_id": 1837, "verse_number": "५-८२-३२", "content_sanskrit": "चेकितानश्च विक्रान्तो धृष्टकेतुश्च चेदिपः ।\nद्रुपदः काशिराजश्च शिखण्डी च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038387, "chapter_id": 1837, "verse_number": "५-८२-३३", "content_sanskrit": "धृष्टद्युम्नः सपुत्रश्च विराटः केकयैः सह।\nसंसाधनार्थं प्रययुः क्षत्रियाः क्षत्रियर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038388, "chapter_id": 1837, "verse_number": "५-८२-३४", "content_sanskrit": "ततोऽनुव्रज्य गोविन्दं धर्मराजो युधिष्ठिरः।\nराज्ञां सकाशे द्युतिमानुवाचेदं वचस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038389, "chapter_id": 1837, "verse_number": "५-८२-३५", "content_sanskrit": "यो वै न कामान्न भयान्न लोभान्नार्थकारणात्।\nअन्यायमनुवर्तेत स्थिरबुद्धिरलोलुपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038390, "chapter_id": 1837, "verse_number": "५-८२-३६", "content_sanskrit": "धर्मज्ञो धृतिमान्प्राज्ञः सर्वभूतेषु केशवः ।\nईश्वरः सर्वभूतानां देवदेवः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038391, "chapter_id": 1837, "verse_number": "५-८२-३७", "content_sanskrit": "तं सर्वगुणसंपन्नं श्रीवत्सकृतलक्षणम्।\nसंरिष्वज्य कौन्तेयः सन्देष्टुमुपचक्रमे ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038392, "chapter_id": 1837, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि द्व्यशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]