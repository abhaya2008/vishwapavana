[{"id": 2169930, "chapter_id": 4632, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169931, "chapter_id": 4632, "verse_number": "१", "content_sanskrit": "द्रौणिर्युधिष्ठिरं दृष्ट्वा शैनेयेनाभिरक्षितम् ।\nद्रौपदेयैस्तथा शूरैरभ्यवर्तत हृष्टवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169932, "chapter_id": 4632, "verse_number": "२", "content_sanskrit": "किरन्निषुगणान् घोरान् स्वर्णपुङ्खान् शिलाशितान् ।\nदर्शयन् विविधान् मार्गान् शिक्षार्थं लघुहस्तवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169933, "chapter_id": 4632, "verse_number": "३", "content_sanskrit": "ततः खं पूरयामास शरैर्दिव्यास्त्रमन्त्रितैः ।\nयुधिष्ठिरं च समरे पर्यवारयदस्त्रवित् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169934, "chapter_id": 4632, "verse_number": "४", "content_sanskrit": "द्रौणायनिशरच्छन्नं न प्राज्ञायत किञ्चन ।\nबाणभूतमभूत्सर्वमायोधनशिरो महत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169935, "chapter_id": 4632, "verse_number": "५", "content_sanskrit": "तद्बाणजालं विविधं स्वर्णजालविभूषितम् ।\nशुशुभे भरतश्रेष्ठ वितानमिव विष्ठितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169936, "chapter_id": 4632, "verse_number": "६", "content_sanskrit": "तेन च्छन्ने रणे राजन् बाणजालेन भास्वता ।\nअभ्रच्छायेव सञ्जज्ञे बाणरुद्धे नभस्थले\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169937, "chapter_id": 4632, "verse_number": "७", "content_sanskrit": "तत्राश्चर्यमपश्याम बाणभूते तथाविधे ।\nन स्म सम्पतते भूतं किञ्चिदेवान्तरिक्षगम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169938, "chapter_id": 4632, "verse_number": "८", "content_sanskrit": "सात्यकिर्यतमानस्तु धर्मराजश्च पाण्डवः ।\nतथेतराणि सैन्यानि न स्म चक्रुः पराक्रमम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169939, "chapter_id": 4632, "verse_number": "९", "content_sanskrit": "लाघवं द्रोणपुत्रस्य दृष्ट्वा तत्र महारथाः ।\nव्यस्मयन्त महाराज न चैनं प्रतिवीक्षितुम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169940, "chapter_id": 4632, "verse_number": "१०", "content_sanskrit": "शेकुस्ते सर्वराजानस्तपन्तमिव भास्करम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169941, "chapter_id": 4632, "verse_number": "११", "content_sanskrit": "वध्यमाने ततः सैन्ये द्रौपदेया महारथाः ।\nसात्यकिर्धर्मराजश्च पाञ्चालाश्चापि सङ्गताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169942, "chapter_id": 4632, "verse_number": "१२", "content_sanskrit": "त्यक्त्वा मृत्युभयं घोरं द्रौणायनिमुपाद्रवन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169943, "chapter_id": 4632, "verse_number": "१३", "content_sanskrit": "सात्यकिः पञ्चविंशत्या द्रौणिं विद्ध्वा शिलीमुखैः ।\nपुनर्विव्याध नाराचैः सप्तभिः स्वर्णभूषितैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169944, "chapter_id": 4632, "verse_number": "१४", "content_sanskrit": "युधिष्ठिरस्त्रिसप्तत्या प्रतिविन्ध्यश्च सप्तभिः ।\nश्रुतकर्मा त्रिभिर्बाणैः श्रुतकीर्तिस्तु सप्तभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169945, "chapter_id": 4632, "verse_number": "१५", "content_sanskrit": "सुतसोमश्च नवभिः शतानीकश्च सप्तभिः ।\nअन्ये च बहवः शूराः विव्यधुस्तं समन्ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169946, "chapter_id": 4632, "verse_number": "१६", "content_sanskrit": "स तु क्रुद्धस्ततो राजन्नाशीविष इव श्वसन् ।\nसात्यकिं पञ्चविंशत्या प्राविध्यत शिलाशितैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169947, "chapter_id": 4632, "verse_number": "१७", "content_sanskrit": "श्रुतकीर्तिं च नवभिः सुतसोमं च पञ्चभिः ।\nसप्तभिः श्रुतकर्माणं प्रतिविन्ध्यं त्रिभिः शरैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169948, "chapter_id": 4632, "verse_number": "१८", "content_sanskrit": "शतानीकं च नवभिर्धर्मपुत्रं च सप्तभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169949, "chapter_id": 4632, "verse_number": "१९", "content_sanskrit": "अथेतरांस्ततः शूरान् द्वाभ्यां द्वाभ्यामताडयत् ।\nश्रुतकीर्तेस्तथा चापं चिच्छेद निशितैः शरैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169950, "chapter_id": 4632, "verse_number": "२०", "content_sanskrit": "अथान्यद्धनुरादाय श्रुतकीर्तिर्महारथः ।\nद्रौणायनिं त्रिभिर्विद्ध्वा विव्याधान्यैः शितैः शरैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169951, "chapter_id": 4632, "verse_number": "२१", "content_sanskrit": "ततो द्रौणिर्महाराज शरवर्षेण मारिष ।\nछादयामास तत्सैन्यं समन्तात् भरतर्षभ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169952, "chapter_id": 4632, "verse_number": "२२", "content_sanskrit": "ततः पुनरमेयात्मा धर्मराजस्य कार्मुकम् ।\nद्रौणिश्चिच्छेद विहसन् विव्याध च शरैस्त्रिभिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169953, "chapter_id": 4632, "verse_number": "२३", "content_sanskrit": "ततो धर्मसुतो राजन् प्रगृह्यान्यन्महद्धनुः ।\nद्रौणिं विव्याध सप्तत्या बाह्वोरुरसि चार्दयत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169954, "chapter_id": 4632, "verse_number": "२४", "content_sanskrit": "सात्यकिस्तु ततः क्रुद्धो द्रौणेः प्रहरतो रणे ।\nअर्धचन्द्रेण तीक्ष्णेन धनुश्छित्त्वानदद्भृशम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169955, "chapter_id": 4632, "verse_number": "२५", "content_sanskrit": "छिन्नधन्वा ततो द्रौणिः शक्त्या शक्तिमतां वरः ।\nसारथिं पातयामास शैनेयस्य रथाद् द्रुतम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169956, "chapter_id": 4632, "verse_number": "२६", "content_sanskrit": "अथान्यद्धनुरादाय द्रोणपुत्रः प्रतापवान् ।\nशैनेयं शरवर्षेण छादयामास भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169957, "chapter_id": 4632, "verse_number": "२७", "content_sanskrit": "तस्याश्वाः प्रद्रुताः सङ्खे पतिते रथसारथौ ।\nतत्र तत्रैव धावन्तः समदृश्यन्त भारत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169958, "chapter_id": 4632, "verse_number": "२८", "content_sanskrit": "युधिष्ठिरपुरोगास्ते द्रौणिं शस्त्रभृतां वरम् ।\nअभ्यवर्षन्त वेगेन विसृजन्तः शितान् शरान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169959, "chapter_id": 4632, "verse_number": "२९", "content_sanskrit": "आगच्छमानांस्तान् दृष्ट्वा क्रुद्धरूपान् परन्तपः ।\nप्रहसन् प्रतिजग्राह द्रोणपुत्रो महारणे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169960, "chapter_id": 4632, "verse_number": "३०", "content_sanskrit": "ततः शरशतज्वालः सेनाकक्षं महारथः ।\nद्रौणिर्ददाह समरे कक्षमग्निर्यथा वने\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169961, "chapter_id": 4632, "verse_number": "३१", "content_sanskrit": "तद्बलं पाण्डुपुत्रस्य द्रोणपुत्रप्रतापितम् ।\nचुक्षुभे भरतश्रेष्ठ तिमिनेव नदीमुखम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169962, "chapter_id": 4632, "verse_number": "३२", "content_sanskrit": "दृष्ट्वा ते च महाराज द्रोणपुत्रपराक्रमम् ।\nनिहतान् मेनिरे सर्वान् पाण्डून् द्रोणसुतेन वै\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169963, "chapter_id": 4632, "verse_number": "३३", "content_sanskrit": "युधिष्ठिरस्तु त्वरितो द्रोणशिष्यो महारथः ।\nअब्रवीद् द्रोणपुत्रं तु रोषामर्षसमन्वितः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169964, "chapter_id": 4632, "verse_number": "३४", "content_sanskrit": "नैव नाम तव प्रीतिर्नैव नाम कृतज्ञता ।\nयतस्त्वं पुरुषव्याघ्र मामेवाद्य जिघांससि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169965, "chapter_id": 4632, "verse_number": "३५", "content_sanskrit": "ब्राह्मणेन तपः कार्यं दानमध्ययनं तथा ।\nक्षत्रियेण धनुर्नाम्यं स भवान् ब्राह्मणब्रुवः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169966, "chapter_id": 4632, "verse_number": "३६", "content_sanskrit": "मिषतस्ते महाबाहो जेष्यामि युधि कौरवान् ।\nकुरुष्व समरे कर्म ब्रह्मबन्धुरसि ध्रुवम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169967, "chapter_id": 4632, "verse_number": "३७", "content_sanskrit": "एवमुक्तो महाराज द्रोणपुत्रः स्मयन्निव ।\nयुक्तत्वं तच्च सञ्चिन्त्य नोत्तरं किञ्चिदब्रवीत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169968, "chapter_id": 4632, "verse_number": "३८", "content_sanskrit": "अनुक्त्वा च ततः किञ्चिच्छरवर्षेण पाण्डवान् ।\nछादयामास समरे क्रुद्धोऽन्तक इव प्रजाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169969, "chapter_id": 4632, "verse_number": "३९", "content_sanskrit": "सञ्छाद्यमानस्तु तदा द्रोणपुत्रेण मारिष ।\nपार्थोऽपयातः शीघ्रं वै विहाय महतीं चमूम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169970, "chapter_id": 4632, "verse_number": "४०", "content_sanskrit": "अपयाते ततस्तस्मिन् धर्मपुत्रे युधिष्ठिरे ।\nद्रोणपुत्रस्ततो राजन् प्रत्यागात् स महामनाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169971, "chapter_id": 4632, "verse_number": "४१", "content_sanskrit": "ततो युधिष्ठिरो राजा त्यक्त्वा द्रौणिं महाहवे ।\nप्रययौ तावकं सैन्यं युक्तः क्रूराय कर्मणे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169972, "chapter_id": 4632, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nद्विपञ्चाशोऽध्यायः ॥५२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]