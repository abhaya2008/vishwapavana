[{"id": 2012320, "chapter_id": 1252, "verse_number": "१-२५३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012321, "chapter_id": 1252, "verse_number": "१-२५३-१", "content_sanskrit": "तस्याथ वर्षतो वारि पाण्डवः प्रत्यवारयत्।\nशरवर्षेण बीभत्सुरुत्तमास्त्राणि दर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012322, "chapter_id": 1252, "verse_number": "१-२५३-२", "content_sanskrit": "खाण्डवं च वनं सर्वं पाण्डवो बहुभिः शरैः।\nप्राच्छादयदमेयात्मा नीहारेणेव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012323, "chapter_id": 1252, "verse_number": "१-२५३-३", "content_sanskrit": "न च स्म किंचिच्छक्नोति भूतं निश्चरितुं ततः।\nसंछाद्यमाने खे बाणैरस्यता सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012324, "chapter_id": 1252, "verse_number": "१-२५३-४", "content_sanskrit": "तक्षकस्तु न तत्रासीन्नागराजो महाबलः।\nदह्यमाने वने तस्मिन्कुरुक्षेत्रं गतो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012325, "chapter_id": 1252, "verse_number": "१-२५३-५", "content_sanskrit": "अश्वसेनोऽभवत्तत्र तक्षकस्य सुतो बली।\nस यत्नमकरोत्तीव्रं मोक्षार्थं जातवेदसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012326, "chapter_id": 1252, "verse_number": "१-२५३-६", "content_sanskrit": "न शशाक स निर्गन्तुं निरुद्धोऽर्जुनपत्रिभिः।\nमोक्षयामास तं माता निगीर्य भुजगात्मजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012327, "chapter_id": 1252, "verse_number": "१-२५३-७", "content_sanskrit": "तस्य पूर्वं शिरो ग्रस्तं पुच्छमस्य निगीर्यते।\nनिगीर्य सोर्ध्वमक्रामत्सुतं नागी मुमुक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012328, "chapter_id": 1252, "verse_number": "१-२५३-८", "content_sanskrit": "तस्याः शरेण तीक्ष्णेन पृथुधारेण पाण्डवः।\nशिरश्चिच्छेद गच्छन्त्यास्तामपश्यच्छचीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012329, "chapter_id": 1252, "verse_number": "१-२५३-९", "content_sanskrit": "तं मुमोचयिषुर्वज्री वातवर्षेण पाण्डवम्।\nमोहयामास तत्कालमश्वसेनस्त्वमुच्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012330, "chapter_id": 1252, "verse_number": "१-२५३-१०", "content_sanskrit": "तां च मायां तदा दृष्टा घोरां नागेन वञ्चितः।\nद्विधा त्रिधा च खगतान्प्राणिनः पाण्डवोच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012331, "chapter_id": 1252, "verse_number": "१-२५३-११", "content_sanskrit": "शशाप तं च संक्रुद्धो बीभत्सुर्जिह्मगामिनम्।\nपावको वासुदेवश्चाप्यप्रतिष्ठो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012332, "chapter_id": 1252, "verse_number": "१-२५३-१२", "content_sanskrit": "ततो जिष्णुः सहस्राक्षं खं वितत्याशुगैः शरैः।\nयोधयामास संक्रुद्धो वञ्चनां तामनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012333, "chapter_id": 1252, "verse_number": "१-२५३-१३", "content_sanskrit": "देवराजोऽपि तं दृष्ट्वा संरब्धं समरेऽर्जुनम्।\nस्वमस्त्रमसृजत्तीव्रं छादयित्वाऽखिलं नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012334, "chapter_id": 1252, "verse_number": "१-२५३-१४", "content_sanskrit": "ततो वायुर्महाघोषः क्षोभयन्सर्वसागरान्।\nवियत्स्थो जनयन्मेघाञ्जलधारासमाकुलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012335, "chapter_id": 1252, "verse_number": "१-२५३-१५", "content_sanskrit": "ततोऽशनिमुचो घोरांस्तडित्स्तनितनिःस्वनान्।\nतद्विघातार्थमसृजदर्जुनोऽप्यस्त्रमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012336, "chapter_id": 1252, "verse_number": "१-२५३-१६", "content_sanskrit": "वायव्यमभिमन्त्र्याथ प्रतिपत्तिविशारदः।\nतेनेन्द्राशनिमेघानां वीर्यौजस्तद्विनाशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012337, "chapter_id": 1252, "verse_number": "१-२५३-१७", "content_sanskrit": "जलधाराश्च ताः शोषं जग्मुर्नेशुश्च विद्युतः।\nक्षणेन चाभवद्व्योम संप्रशान्तरजस्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012338, "chapter_id": 1252, "verse_number": "१-२५३-१८", "content_sanskrit": "सुखशीतानिलवहं प्रकृतिस्थार्कमण्डलम्।\nनिष्प्रतीकारहृष्टश्च हुतभुग्विविधाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012339, "chapter_id": 1252, "verse_number": "१-२५३-१९", "content_sanskrit": "सिच्यमानो वसौघैस्तैः प्राणिनां देहनिःसृतैः।\nप्रजज्वालाथ सोऽर्चिष्मान्स्वनादैः पूरयञ्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012340, "chapter_id": 1252, "verse_number": "१-२५३-२०", "content_sanskrit": "कृष्णाभ्यां रक्षितं दृष्ट्वा तं च दावमहङ्कृताः।\nखमुत्पेतुर्महाराज सुपर्णाद्याः पतत्त्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012341, "chapter_id": 1252, "verse_number": "१-२५३-२१", "content_sanskrit": "गरुत्मान्वज्रसदृशैः पक्षतुण्डनखैस्तथा।\nप्रहर्तुकामो न्यपतदाकाशात्कृष्णपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012342, "chapter_id": 1252, "verse_number": "१-२५३-२२", "content_sanskrit": "तथैवोरगसङ्घाताः पाण्डवस्य समीपतः।\nउत्सृजन्तो विषं घोरं निपेतुर्ज्वलिताननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012343, "chapter_id": 1252, "verse_number": "१-२५३-२३", "content_sanskrit": "तांश्चकर्त शरैः पार्थः सरोषाग्निसमुक्षितैः।\nविविशुश्चापि तं दीप्तं देहाभावाय पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012344, "chapter_id": 1252, "verse_number": "१-२५३-२४", "content_sanskrit": "ततः सुराः सगन्धर्वा यक्षराक्षसपन्नगाः।\nउत्पेतुर्नादमतुलमुत्सृजन्तो रणार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012345, "chapter_id": 1252, "verse_number": "१-२५३-२५", "content_sanskrit": "अयःकणपचक्राश्मभुशुण्ड्युद्यतबाहवः।\nकृष्णपार्थौ जिघांसन्तः क्रोधसंमूर्च्छितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012346, "chapter_id": 1252, "verse_number": "१-२५३-२६", "content_sanskrit": "तेषामतिव्याहरतां शस्त्रवर्षं प्रमुञ्चताम्।\nप्रममाथोत्तमाङ्गानि बीभत्सुर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012347, "chapter_id": 1252, "verse_number": "१-२५३-२७", "content_sanskrit": "कृष्णश्च सुमहातेजाश्चक्रेणारिविनाशनः।\nदैत्यदानवसङ्घानां चकार कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012348, "chapter_id": 1252, "verse_number": "१-२५३-२८", "content_sanskrit": "अथापरे शरैर्विद्धाश्चक्रवेगेरितास्तथा।\nवेलामिव समासाद्य व्यतिष्ठन्नमितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012349, "chapter_id": 1252, "verse_number": "१-२५३-२९", "content_sanskrit": "ततः शक्रोऽतिसक्रुद्धस्त्रिदशानां महेश्वरः।\nपाण्डुरं गजमास्थाय तावुभौ समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012350, "chapter_id": 1252, "verse_number": "१-२५३-३०", "content_sanskrit": "वेगेनाशनिमादाय वज्रमस्त्रं च सोऽसृजत्।\nहतावेताविति प्राह सुरानसुरसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012351, "chapter_id": 1252, "verse_number": "१-२५३-३१", "content_sanskrit": "ततः समुद्यतां दृष्ट्वा देवेन्द्रेण महाशनिम्।\nजगृहुः सर्वशस्त्राणि स्वानि स्वानि सुरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012352, "chapter_id": 1252, "verse_number": "१-२५३-३२", "content_sanskrit": "कालदण्डं यमो राजन् गदां चैव धनेश्वरः।\nपाशांश्च तत्र वरुणो विचित्रां च तथाऽशनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012353, "chapter_id": 1252, "verse_number": "१-२५३-३३", "content_sanskrit": "स्कन्दः शक्तिं समादाय तस्थौ मेरुरिवाचलः।\nओषधीर्दीप्यमानाश्च जगृहातेऽस्विनावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012354, "chapter_id": 1252, "verse_number": "१-२५३-३४", "content_sanskrit": "जगृहे च धनुर्धाता मुसलं तु जयस्तथा।\nपर्वतं चापि जग्राह क्रूद्धस्त्वष्टा महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012355, "chapter_id": 1252, "verse_number": "१-२५३-३५", "content_sanskrit": "अंशस्तु शक्तिं जग्राह मृत्युर्देवः परश्वधम्।\nप्रगृह्य परिघं घोरं विचचारार्यमा अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012356, "chapter_id": 1252, "verse_number": "१-२५३-३६", "content_sanskrit": "मित्रश्च क्षुरपर्यन्तं चक्रमादाय तस्थिवान्।\nपूषा भगश्च संक्रुद्धः सविता च विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012357, "chapter_id": 1252, "verse_number": "१-२५३-३७", "content_sanskrit": "आत्तकार्मुकनिस्त्रिंशाः कृष्णापार्थौ प्रदुद्रुवुः।\nरुद्राश्च वसवश्चैव मरुतश्च महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012358, "chapter_id": 1252, "verse_number": "१-२५३-३८", "content_sanskrit": "विश्वेदेवास्तथा साध्या दीप्यमानाः स्वतेजसा।\nएते चान्ये च बहवो देवास्तौ पुरुषोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012359, "chapter_id": 1252, "verse_number": "१-२५३-३९", "content_sanskrit": "कृष्णपार्थौ जिघांसन्तः प्रतीयुर्विविधायुधाः।\nतत्राद्भुतान्यदृश्यन्त निमित्तानि महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012360, "chapter_id": 1252, "verse_number": "१-२५३-४०", "content_sanskrit": "युगान्तसमरूपाणि भूतसंमोहनानि च।\nतथा दृष्ट्वा सुसंरब्धं शक्रं देवैः सहाच्युतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012361, "chapter_id": 1252, "verse_number": "१-२५३-४१", "content_sanskrit": "अभीतौ युधि दुर्धर्षौ तस्थतुः सज्जकार्मुकौ।\nआगच्छतस्ततो देवानुभौ युद्धविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012362, "chapter_id": 1252, "verse_number": "१-२५३-४२", "content_sanskrit": "व्यताडयेतां संक्रुद्धौ शरैर्वज्रोपमैस्तदा।\nअसकृद्भग्नसंकल्पाः सुराश्च बहुशः कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012363, "chapter_id": 1252, "verse_number": "१-२५३-४३", "content_sanskrit": "भयाद्रणं परित्यज्य शख्रमेवाभिशिश्रियुः।\nदृष्ट्वा निवारितान्देवान्माधवेनार्जुनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012364, "chapter_id": 1252, "verse_number": "१-२५३-४४", "content_sanskrit": "आश्चर्यमगमंस्तत्र मुनयो नभसि स्थिताः।\nशक्रश्चापि तयोर्वीर्यमुपलभ्यासकृद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2012365, "chapter_id": 1252, "verse_number": "१-२५३-४५", "content_sanskrit": "बभूव परमप्रीतो भूयश्चैतावयोधयत्।\nततोऽश्मवर्षं सुमहद्व्यसृजत्पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2012366, "chapter_id": 1252, "verse_number": "१-२५३-४६", "content_sanskrit": "भूय एव तदा वीर्यं जिज्ञासुः सव्यसाचिनः।\nतच्छैरर्जुनो वर्षं प्रतिजघ्नेऽत्यमर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2012367, "chapter_id": 1252, "verse_number": "१-२५३-४७", "content_sanskrit": "विफलं क्रियमाणं तत्समवेक्ष्य शतक्रतुः।\nभूयः संवर्धयामास तद्वर्षं पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2012368, "chapter_id": 1252, "verse_number": "१-२५३-४८", "content_sanskrit": "सोश्मवर्षं महावेगैरिषुभिः पाकशासनिः।\nविलयं गमयामास हर्षयन्पितरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2012369, "chapter_id": 1252, "verse_number": "१-२५३-४९", "content_sanskrit": "तत उत्पाट्य पाणिभ्यां मन्दराच्छिखरं महत्।\nसद्रुमं व्यसृजच्छक्रो जिघांसुः पाण्डुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2012370, "chapter_id": 1252, "verse_number": "१-२५३-५०", "content_sanskrit": "ततोऽर्जुनो वेगवद्भिर्ज्वलिताग्रैरजिह्मगैः।\nशरैर्विध्वंसयामास गिरेः शृङ्गं सहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2012371, "chapter_id": 1252, "verse_number": "१-२५३-५१", "content_sanskrit": "गिरेर्विशीर्यमाणस्य तस्य रूपं तदा बभौ।\nसार्कचन्द्रग्रहस्येव नभसः परिशीर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2012372, "chapter_id": 1252, "verse_number": "१-२५३-५२", "content_sanskrit": "तेनाभिपतता दावं शैलेन महता भृशम्।\nशृङ्गेण निहतास्तत्र प्राणिनः खाण्डवालयाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2012373, "chapter_id": 1252, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि खाण्डवदाहपर्वणि त्रिपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५३ ॥ ॥ समाप्तं च खाण्डवदाहपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]