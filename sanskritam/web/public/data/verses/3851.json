[{"id": 2131827, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131828, "chapter_id": 3851, "verse_number": "१", "content_sanskrit": "युधिष्ठिरस्तमासाद्य सर्पभोगेन वेष्टितम् ।\nदयितं भ्रातरं धीमानिदं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131829, "chapter_id": 3851, "verse_number": "२", "content_sanskrit": "कुन्तीमातः कथमिमामापदं त्वमवाप्तवान् ।\nकश्चायं पर्वताभोगप्रतिमः पन्नगोत्तमः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131830, "chapter_id": 3851, "verse_number": "३", "content_sanskrit": "स धर्मराजमालक्ष्य भ्राता भ्रातरमग्रजम् ।\nकथयामास तत्सर्वं ग्रहणादिविचेष्टितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131831, "chapter_id": 3851, "verse_number": "४", "content_sanskrit": "अयमार्य महासत्त्वो भक्षार्थं मां गृहीतवान् ।\nनहुषो नाम राजर्षिः प्राणवानिव संस्थितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131832, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131833, "chapter_id": 3851, "verse_number": "५", "content_sanskrit": "मुच्यतामयमायुष्मन् भ्राता मेऽमितविक्रमः ।\nवयमाहारमन्यं ते दास्यामः क्षुन्निवारणम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131834, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131835, "chapter_id": 3851, "verse_number": "६", "content_sanskrit": "आहारो राजपुत्रोऽयं मया प्राप्तो मुखागतः ।\nगम्यतां नेह स्थातव्यं श्वो भवानपि मे भवेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131836, "chapter_id": 3851, "verse_number": "७", "content_sanskrit": "व्रतमेतन्महाबाहो विषयं मम यो व्रजेत् ।\nस मे भक्षो भवेत् तात त्वं चापि विषये मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131837, "chapter_id": 3851, "verse_number": "८", "content_sanskrit": "चिरेणाद्य मयाऽऽहारः प्राप्तोऽयमनुजस्तव ।\nनाहमेनं विमोक्ष्यामि न चान्यमभिकाङ्क्षये\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131838, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131839, "chapter_id": 3851, "verse_number": "९", "content_sanskrit": "देवो वा यदि वा दैत्य उरगो वा भवान् यदि ।\nसत्यं सर्प वचो ब्रूहि पृच्छति त्वां युधिष्ठिरः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131840, "chapter_id": 3851, "verse_number": "१०", "content_sanskrit": "किमर्थं च त्वया ग्रस्तो भीमसेनो भुजङ्गम ।\nकिमाहृत्य विदित्वा वा प्रीतिस्ते स्याद् भुजङ्गम ।\nकिमाहारं प्रयच्छामि कथं मुञ्चेद् भवानिमम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131841, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131842, "chapter_id": 3851, "verse_number": "११", "content_sanskrit": "नहुषो नाम राजाऽहमासं पूर्वस्तवानघ ।\nप्रथितः पञ्चमः सोमादायोः पुत्रो नराधिप \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131843, "chapter_id": 3851, "verse_number": "१२", "content_sanskrit": "क्रतुभिस्तपसा चैव स्वाध्यायेन दमेन च ।\nत्रैलोक्यैश्वर्यमव्यग्रं प्राप्तोऽहं विक्रमेण च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131844, "chapter_id": 3851, "verse_number": "१३", "content_sanskrit": "तदैश्वर्यं समासाद्य दर्पो मामगमत् तदा ।\nसहस्रं हि द्विजातीनामुवाह शिबिकां मम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131845, "chapter_id": 3851, "verse_number": "१४", "content_sanskrit": "ऐश्वर्यमदमत्तोऽहमवमन्य ततो द्विजान् ।\nइमामगस्त्येन दशामानीतः पृथिवीपते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131846, "chapter_id": 3851, "verse_number": "१५", "content_sanskrit": "न तु मामजहात्प्रज्ञा यावदद्येति पाण्डव ।\nतस्यैवानुग्रहाद्राजन्नगस्त्यस्य महात्मनः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131847, "chapter_id": 3851, "verse_number": "१६", "content_sanskrit": "षष्ठे काले मयाऽहारः प्राप्तोऽयमनुजस्तव ।\nनाहमेनं विमोक्ष्यामि न चान्यदपि कामये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131848, "chapter_id": 3851, "verse_number": "१७", "content_sanskrit": "प्रश्नानुच्चारितानद्य व्याहरिष्यसि चेन्मम ।\nअथ पश्चाद् विमोक्ष्यामि भ्रातरं ते वृकोदरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131849, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131850, "chapter_id": 3851, "verse_number": "१८", "content_sanskrit": "ब्रूहि सर्प यथाकामं प्रतिवक्ष्यामि ते वचः ।\nअपि चेच्छक्नुयां प्रीतिमाहर्तुं ते भुजङ्गम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131851, "chapter_id": 3851, "verse_number": "१९", "content_sanskrit": "वेद्यं च ब्राह्मणेनेह तद् भवान्वेत्ति केवलम् ।\nसर्पराज ततः श्रुत्वा प्रतिवक्ष्यामि ते वचः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131852, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131853, "chapter_id": 3851, "verse_number": "२०", "content_sanskrit": "ब्राह्मणः को भवेद् राजन् वेद्यं किं च युधिष्ठिर ।\nब्रवीह्यतिमतिं त्वां हि वाक्यैरनुमिमीमहे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131854, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131855, "chapter_id": 3851, "verse_number": "२१", "content_sanskrit": "सत्यं दानं क्षमा शीलमानृशंस्यं तपो घृणा ।\nदृश्यन्ते यत्र नागेन्द्र स ब्राह्मण इति स्मृतिः(तः)\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131856, "chapter_id": 3851, "verse_number": "२२", "content_sanskrit": "दीनानुकम्पी सततं सततं साधुवत्सलः ।\nनित्यं दानरतश्चैव तं देवा ब्राह्मणं विदुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131857, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131858, "chapter_id": 3851, "verse_number": "२३", "content_sanskrit": "यत्नेन ब्रूहि राजेन्द्र कः कालः श्राद्धदानयोः ।\nप्रश्नं प्रश्नविदां श्रेष्ठ सर्ववित्त्वं मतोऽसि मे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131859, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131860, "chapter_id": 3851, "verse_number": "२४", "content_sanskrit": "यत्र वै ब्राह्मणं पश्येच्छ्रोत्रियं ध्यानतत्परम् ।\nधनं मन्येद् विशिष्टं तु स कालः श्राद्धदानयोः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131861, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131862, "chapter_id": 3851, "verse_number": "२५", "content_sanskrit": "किं वेद्यं परमं राजन् प्रशंस मे त्वं युधिष्ठिर ।\nसर्वज्ञोऽसि महाबाहो वाक्यैरनुमिमीमहे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131863, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131864, "chapter_id": 3851, "verse_number": "२६", "content_sanskrit": "वेद्यं सर्प परं ब्रह्म निर्दुःखमसुखं च यत् ।\nयत्र गत्वा न शोचन्ति भवतः किं विवक्षितम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131865, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131866, "chapter_id": 3851, "verse_number": "२७", "content_sanskrit": "चातुर्वर्ण्यं प्रमाणं च सत्यं च ब्रह्म चैव हि ।\nशूद्रेष्वपि च सत्यं च दानमक्रोध एव च \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131867, "chapter_id": 3851, "verse_number": "२८", "content_sanskrit": "आनृशंस्यमहिंसा च घृणा चैव युधिष्ठिर ।\nवेद्यं यच्चात्र निर्दुःखमसुखं च नराधिप ।\nताभ्यां हीनं पदं चान्यन्न तदस्तीति लक्षये\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131868, "chapter_id": 3851, "verse_number": "२९", "content_sanskrit": "तांश्च सर्वानशेषेण कथयस्व नराधिप \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131869, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131870, "chapter_id": 3851, "verse_number": "३०", "content_sanskrit": "शूद्रे तु यद् भवेल्लक्ष्म द्विजे तच्च न विद्यते ।\nन वै शूद्रो भवेच्छूद्रो ब्राह्मणो न च ब्राह्मणः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131871, "chapter_id": 3851, "verse_number": "३१", "content_sanskrit": "यत्रैतल्लक्ष्यते सर्प वृत्तं स ब्राह्मणः स्मृतः ।\nयत्रैतन्न भवेत् सर्प तं शूद्रमिति निर्दिशेत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131872, "chapter_id": 3851, "verse_number": "३२", "content_sanskrit": "यत् पुनर्भवता प्रोक्तं न वेद्यं विद्यतीति च ।\nताभ्यां हीनमतोऽन्यत्र पदं नास्ती(दमस्ती)ति चेदपि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2131873, "chapter_id": 3851, "verse_number": "३३", "content_sanskrit": "एवमेतन्मतं सर्प ताभ्यां हीनं न विद्यते ।\nयथा शीतोष्णयोर्मध्ये भवेन्नोष्णं न शीतता\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2131874, "chapter_id": 3851, "verse_number": "३४", "content_sanskrit": "एवं वै सुखदुःखाभ्यां हीनं नास्ति पदं क्वचित् ।\nएषा मम मतिः सर्प यथा वा मन्यते भवान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2131875, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2131876, "chapter_id": 3851, "verse_number": "३५", "content_sanskrit": "यदि ते वृत्ततो राजन् ब्राह्मणः प्रसमीक्षितः ।\nवृथा जातिस्तदाऽऽयुष्मन् कृतिर्यावन्न विद्यते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2131877, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2131878, "chapter_id": 3851, "verse_number": "३६", "content_sanskrit": "जातिरत्र महासर्प मनुष्यत्वे महामते ।\nसङ्करात् सर्ववर्णानां दुष्परीक्ष्येति मे मतिः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2131879, "chapter_id": 3851, "verse_number": "३७", "content_sanskrit": "सर्वे सर्वास्वपत्यानि जनयन्ति सदा नराः ।\nवाङ्मैथुनमथो जन्म मरणं च समं नृणाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2131880, "chapter_id": 3851, "verse_number": "३८", "content_sanskrit": "इदमार्षं प्रमाणं च ये यजामह इत्यपि ।\nतस्माच्छीलं प्रधानेष्टं विदुर्ये तत्त्वदर्शिनः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2131881, "chapter_id": 3851, "verse_number": "३९", "content_sanskrit": "प्राङ्नाभिवर्धनात् पुंसो जातकर्म विधीयते ।\nततस्तु नामकरणं ततश्चौलं विधीयते \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2131882, "chapter_id": 3851, "verse_number": "४०", "content_sanskrit": "ततोपनयनं प्रोक्तं द्विजातीनां यथाविधि ।\nतदास्य माता सावित्री पिता त्वाचार्य उच्यते \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2131883, "chapter_id": 3851, "verse_number": "४१", "content_sanskrit": "तावच्छूद्रसमो ह्येष यावद्वेदे न जायते ।\nतस्मिन्नेवं मतिद्वैधे मनुः स्वायम्भुवोऽब्रवीत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2131884, "chapter_id": 3851, "verse_number": "४२", "content_sanskrit": "कृतकृत्याः पुनर्वर्णा यदि वृत्तं न विद्यते ।\nसङ्करस्त्वत्र नागेन्द्र बलवान् प्रसमीक्षितः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2131885, "chapter_id": 3851, "verse_number": "४३", "content_sanskrit": "यत्रेदानीं महासर्प संस्कृतं वृत्तमिष्यते ।\nतं ब्राह्मणमहं पूर्वमुक्तवान् भुजगोत्तम\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2131886, "chapter_id": 3851, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2131887, "chapter_id": 3851, "verse_number": "४४", "content_sanskrit": "श्रुतं विदितवेद्यस्य तव वाक्यं युधिष्ठिर ।\nभक्षयेयमहं कस्माद् भ्रातरं ते वृकोदरम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2131888, "chapter_id": 3851, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुःसप्तत्यधिकशततमोऽध्यायः ॥ १७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2131889, "chapter_id": 3851, "verse_number": "४", "content_sanskrit": "अजगरपर्वणि युधिष्ठिरसर्पसंवादे चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]