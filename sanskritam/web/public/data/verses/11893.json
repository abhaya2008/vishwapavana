[{"id": 50024762, "chapter_id": 11893, "verse_number": "1", "content_sanskrit": "सत्यचिच्चेत्यपतये मुक्तामुक्तोत्तमाय ते। नमो नारायणायार्यवृन्दवन्दितपद्द्वय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024763, "chapter_id": 11893, "verse_number": "2", "content_sanskrit": "“आनन्दतीर्थपुंसिहो मायावादिदितेः सुतान्। विदार्य युक्तिनखरैरप्रतीपो विभासते 【पाठभेदः: BG—युक्तिनखरैरप्रतीपोऽतिशोभते】 ॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024764, "chapter_id": 11893, "verse_number": "3", "content_sanskrit": "“पलायध्वम्पलायध्वं त्वरया मायिदानवाः। सर्वज्ञहरिरायाति तर्कागमदरारिभृत् 【पाठभेदः: BG—तर्कागमदरारिधृत्】 ॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024765, "chapter_id": 11893, "verse_number": "4", "content_sanskrit": "“द्रवतद्रवताशु मायिनः प्रविशध्वमतन्द्रिता गुहाः। कमलारमणाम्बराश्रयः 【पाठभेदः: BG—कमळारमणाम्बराश्रयः】 समुदेत्यखिलज्ञभास्करः॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024766, "chapter_id": 11893, "verse_number": "5", "content_sanskrit": "“नृहरिः सकलज्ञनामकः 【पाठभेदः: BG—सकळज्ञनामकः】 समुपैति हि मायिदानवान्। प्रपलायनमत्र तत् क्षमं त्वरया 【पाठभेदः: TRK—त्वरया वो】 वसतिर्गुहासु च॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024767, "chapter_id": 11893, "verse_number": "6", "content_sanskrit": "“जयत्यानन्दतीर्थेष्टदेवता नरकेसरी। विपाटिताज्ञानतमःकपाटात्युरुहुङ्कृतः 【पाठभेदः: BG—विपाटिताज्ञानतमःकवाटात्युरुहुङ्कृतः】 ॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024768, "chapter_id": 11893, "verse_number": "7", "content_sanskrit": "“जयत्यमितपौरुषः स्वजनतेष्टचिन्तामणिः। अजेशमुखवन्दितो गुणगणार्णवः श्रीपतिः॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024769, "chapter_id": 11893, "verse_number": "8", "content_sanskrit": "“सर्वज्ञसन्मुनीन्द्रोच्चसन्मनःपङ्कजालयः। अजितो जयति श्रीशो रमाबाहुलताश्रयः॥”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024770, "chapter_id": 11893, "verse_number": "9", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितस्तत्त्वोद्योतः (वादः) सम्पूर्णः॥ 【पाठभेदः: BG—॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितवादः सम्पूर्णः॥, TRK—॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितस्तत्त्वोद्योतः सम्पूर्णः॥】", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]