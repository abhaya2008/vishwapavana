[{"id": 2214116, "chapter_id": 5576, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214117, "chapter_id": 5576, "verse_number": "१", "content_sanskrit": "प्रविश्य त्वर्जुनो राजन्नाश्रमं सत्यवादिनः ।\nददर्शासीनमेकान्ते मुनिं सत्यवतीसुतम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214118, "chapter_id": 5576, "verse_number": "२", "content_sanskrit": "स तमासाद्य धर्मज्ञमुपतस्थे महाव्रतम् ।\nअर्जुनोस्मीति नामास्मै निवेद्याभ्यवदत् ततः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214119, "chapter_id": 5576, "verse_number": "३", "content_sanskrit": "स्वागतं तेऽस्त्विति प्राह मुनिः सत्यवतीसुतः ।\nआस्यतामिति होवाच प्रसन्नात्मा महामुनिः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214120, "chapter_id": 5576, "verse_number": "४", "content_sanskrit": "तमप्रतीतमनसं निःश्वसन्तं पुनः पुनः ।\nनिर्विण्णमनसं दृष्ट्वा पार्थं व्यासोऽब्रवीदिदम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214121, "chapter_id": 5576, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214122, "chapter_id": 5576, "verse_number": "", "content_sanskrit": "(नखकेशदशाकुम्भवारिणा किं समुक्षितः ॥५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214123, "chapter_id": 5576, "verse_number": "६", "content_sanskrit": "आवीरजानुगमनं ब्राह्मणो वा हतस्त्वया\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214124, "chapter_id": 5576, "verse_number": "७", "content_sanskrit": "युद्धे पराजितो वाऽसि गतश्रीरिव लक्ष्यसे ।\nन त्वां प्रभिन्नं जानामि किमिदं भरतर्षभ\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214125, "chapter_id": 5576, "verse_number": "८", "content_sanskrit": "श्रोतव्यं चेन्मया पार्थ क्षिप्रमाख्यातुमर्हसि\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214126, "chapter_id": 5576, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214127, "chapter_id": 5576, "verse_number": "९", "content_sanskrit": "यः स मेघवपुः श्रीमान् बृहत्पङ्कजलोचनः ।\nस कृष्णः सह रामेण त्यक्त्वा देहं दिवं गतः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214128, "chapter_id": 5576, "verse_number": "१०", "content_sanskrit": "मौसले वृष्णिवीराणां विनाशो ब्रह्मशापजः ।\nबभूव वीरान्तकरः प्रभासे रोमहर्षणः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214129, "chapter_id": 5576, "verse_number": "११", "content_sanskrit": "एते शूरा महात्मानः सिंहदर्पा महाबलाः ।\nभोजवृष्ण्यन्धका ब्रह्मन्नन्योन्यं तैर्हतं युधि\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214130, "chapter_id": 5576, "verse_number": "१२", "content_sanskrit": "गदापरिघशक्तीनां सहाः परिघबाहवः ।\nत एरकाभिर्निहताः पश्य कालस्य पर्ययम्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214131, "chapter_id": 5576, "verse_number": "१३", "content_sanskrit": "पञ्च पञ्चशतं तेषां सहस्रं बाहुशालिनाम् ।\nनिधनं समनुप्राप्तं समासाद्येतरेतरम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214132, "chapter_id": 5576, "verse_number": "१४", "content_sanskrit": "पुनःपुनर्न मृष्यामि विनाशममितौजसाम् ।\nचिन्तयानो यदूनां च कृष्णस्य च यशस्विनः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214133, "chapter_id": 5576, "verse_number": "१५", "content_sanskrit": "शोषणं सागरस्येव मन्दरस्येव चालनम् ।\nनभसः पतनं चैव शैत्यमग्नेस्तथैव च\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214134, "chapter_id": 5576, "verse_number": "१६", "content_sanskrit": "अश्रद्धेयमहं मन्ये विनाशं शार्ङ्गधन्वनः ।\nन चेह स्थातुमिच्छामि लोके कृष्णविनाकृतः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214135, "chapter_id": 5576, "verse_number": "१७", "content_sanskrit": "इतः कष्टतरं चान्यच्छृणु तद्वै तपोधन ।\nमनो मे दीर्यते येन चिन्तयानस्य वै मुहुः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214136, "chapter_id": 5576, "verse_number": "१८", "content_sanskrit": "पश्यतो वृष्णिदाराश्च मम ब्रह्मन् सहस्रशः ।\nआभिरैरभिभूयाजौ हृताः पञ्चनदालयैः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214137, "chapter_id": 5576, "verse_number": "१९", "content_sanskrit": "धनुरादाय तत्राहं नाशकं तस्य पूरणे ।\nयथा पुरा च मे वीर्यं भुजयोर्न तथाऽभवत्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214138, "chapter_id": 5576, "verse_number": "२०", "content_sanskrit": "अस्त्राणि मे प्रनष्टानि विविधानि महाद्युते ।\nशराश्च क्षयमापन्नाः क्षणेनैव समन्ततः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214139, "chapter_id": 5576, "verse_number": "२१", "content_sanskrit": "तद्धनुस्तानि चास्त्राणि सरथस्ते च वाजिनः ।\nसर्वमेकपदे भ्रष्टं दानमश्रोत्रिये यथा\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214140, "chapter_id": 5576, "verse_number": "२२", "content_sanskrit": "पुरुषश्चाप्रमेयात्मा शङ्खचक्रगदाधरः ।\nचतुर्भुजः पीतवासाः श्यामः पद्मदलेक्षणः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214141, "chapter_id": 5576, "verse_number": "२३", "content_sanskrit": "यश्च याति पुरस्तान्मे रथस्य सुमहाद्युतिः ।\nप्रदहन् रिपुसैन्यानि न पश्याम्यहमद्य तम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214142, "chapter_id": 5576, "verse_number": "२४", "content_sanskrit": "येन पूर्वं प्रदग्धानि शत्रुसैन्यानि तेजसा ।\nशरैर्गाण्डीवनिर्मुक्तैरहं पश्चादशातयम्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214143, "chapter_id": 5576, "verse_number": "२५", "content_sanskrit": "तमपश्यन् विमुक्तोस्मि घूर्णामीव च सत्तम ।\nपरिनिर्विण्णचेताश्च शान्तिं नोपलभेऽपि च\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214144, "chapter_id": 5576, "verse_number": "२६", "content_sanskrit": "(देवकीनन्दनं देवं वासुदेवमजं प्रभुम् ।)\nविना जनार्दनं वीरं नाहं जीवितुमुत्सहे\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214145, "chapter_id": 5576, "verse_number": "२७", "content_sanskrit": "श्रुत्वैव हि गतं विष्णुं ममापि मुमुहुर्दिशः ।\nप्रनष्टज्ञातिवीर्यस्य शून्यस्य परिधावतः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214146, "chapter_id": 5576, "verse_number": "२८", "content_sanskrit": "उपदेष्टुं मम श्रेयो भवानर्हति सत्तम\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214147, "chapter_id": 5576, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214148, "chapter_id": 5576, "verse_number": "२९", "content_sanskrit": "ब्रह्मशापविनिर्दग्धा वृष्ण्यन्धकमहारथाः ।\nविनष्टाः कुरुशार्दूल न तान् शोचितुमर्हसि\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2214149, "chapter_id": 5576, "verse_number": "३०", "content_sanskrit": "भवितव्यं तथा तच्च दिष्टमेतन्महात्मनाम् ।\nउपेक्षितं च कृष्णेन शक्तेनापि व्यपोहितुम्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2214150, "chapter_id": 5576, "verse_number": "३१", "content_sanskrit": "त्रैलोक्यमपि गोविन्दः कृत्स्नं स्थावरजङ्गमम् ।\nप्रसहेदन्यथा कर्तुं कुतः शापं महात्मनाम्\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2214151, "chapter_id": 5576, "verse_number": "३२", "content_sanskrit": "रथस्य पुरतो याति शङ्खचक्रगदाधरः ।\nतव स्नेहात् पुराणर्षिर्वासुदेवश्चतुर्भुजः\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2214152, "chapter_id": 5576, "verse_number": "३३", "content_sanskrit": "कृत्वा भारावतरणं पृथिव्याः पृथुलोचनः ।\nमोक्षयित्वा तनुं प्राप्तः कृष्णः स्वस्थानमुत्तमम्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2214153, "chapter_id": 5576, "verse_number": "३४", "content_sanskrit": "त्वयाऽपीह महत्कर्म देवानां पुरुषर्षभ ।\nकृतं भीमसहायेन यमाभ्यां च महाभुज\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2214154, "chapter_id": 5576, "verse_number": "३५", "content_sanskrit": "कृतकृत्यांश्च वो मन्ये संसिद्धान् कुरुपुङ्गव ।\nगमनं प्राप्तकालं व इदं श्रेयस्करं विभो\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2214155, "chapter_id": 5576, "verse_number": "३६", "content_sanskrit": "बलं बुद्धिश्च तेजश्च प्रतिपत्तिश्च भारत ।\nभवन्ति भवकालेषु विपद्यन्ते विपर्यये\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2214156, "chapter_id": 5576, "verse_number": "३७", "content_sanskrit": "कालमूलमिदं सर्वं जगद्बीजं धनञ्जय ।\nकाल एव समादत्ते पुनरेव यदृच्छया\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2214157, "chapter_id": 5576, "verse_number": "३८", "content_sanskrit": "स एव बलवान् भूत्वा पुनर्भवति दुर्बलः ।\nस एवेशश्च भूत्वेह परैराज्ञाप्यते पुनः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2214158, "chapter_id": 5576, "verse_number": "३९", "content_sanskrit": "कृतकृत्यानि चास्त्राणि गतान्यद्य यथागतम् ।\nपुनरेष्यन्ति ते हस्तं यदा कालो भविष्यति\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2214159, "chapter_id": 5576, "verse_number": "४०", "content_sanskrit": "कालो गन्तुं गतिं मुख्यां भवतामपि भारत ।\nएतच्छ्रेयो हि वो मन्ये परमं भरतर्षभ\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2214160, "chapter_id": 5576, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2214161, "chapter_id": 5576, "verse_number": "४१", "content_sanskrit": "एतद् वचनमाज्ञाय व्यासस्यामिततेजसः ।\nअनुज्ञातो ययौ पार्थो नगरं नागसाह्वयम्\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2214162, "chapter_id": 5576, "verse_number": "४२", "content_sanskrit": "प्रविश्य च पुरीं वीरः समासाद्य युधिष्ठिरम् ।\nआचष्ट तद् यथावृत्तं वृष्ण्यन्धककुलं प्रति\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2214163, "chapter_id": 5576, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् मौसलपर्वणि\nअर्जुननगरप्रवेशकथनं नाम नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2214164, "chapter_id": 5576, "verse_number": "", "content_sanskrit": "॥ समाप्तं मौसलपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]