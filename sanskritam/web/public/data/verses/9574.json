[{"id": 5000574000, "chapter_id": 9574, "verse_number": "७-३९-१", "content_sanskrit": "ते प्रयाता महात्मानः पार्थिवास्ते प्रहृष्टवत् ।\nगजवाजिसहस्रौघैः कम्पयन्तो वसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000574001, "chapter_id": 9574, "verse_number": "७-३९-२", "content_sanskrit": "अक्षौहिण्यो हि तत्रासन्राघवार्थे समुद्यताः ।\nभरतस्याज्ञया ऽनेकाः प्रहृष्टा बलवाहनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000574002, "chapter_id": 9574, "verse_number": "७-३९-३", "content_sanskrit": "ऊचुस्ते च महीपाला बलदर्पसमन्विताः ।\nन रामरावणं युद्धे पश्यामः पुरतः स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000574003, "chapter_id": 9574, "verse_number": "७-३९-४", "content_sanskrit": "भरतेन वयं पश्चात्समानीता निरर्थकम् ।\nहता हि राक्षसाः क्षिप्रं पार्थिवैः स्युर्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000574004, "chapter_id": 9574, "verse_number": "७-३९-५", "content_sanskrit": "रामस्य बाहुवीर्येण रक्षिता लक्ष्मणस्य च ।\nसुखं पारेसमुद्रस्य युध्येम विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000574005, "chapter_id": 9574, "verse_number": "७-३९-६", "content_sanskrit": "एताश्चान्याश्च राजानः कथास्तत्र सहस्रशः ।\nकथयन्तः स्वराज्यानि जग्मुर्हर्षसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000574006, "chapter_id": 9574, "verse_number": "७-३९-७", "content_sanskrit": "स्वानि राज्यानि मुख्यानि ऋद्धानि मुदितानि च ।\nसमृद्धधनधान्यानि पूर्णानि वसुमन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000574007, "chapter_id": 9574, "verse_number": "७-३९-८", "content_sanskrit": "यथापुराणि ते गत्वा रत्नानि विविधान्यथ ।\nरामस्य प्रियकामार्थमुपहारान् नृपा ददुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000574008, "chapter_id": 9574, "verse_number": "७-३९-९", "content_sanskrit": "अश्वान्यानानि रत्नानि हस्तिनश्च मदोत्कटान् ।\nचन्दनानि च मुख्यानि दिव्यान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000574009, "chapter_id": 9574, "verse_number": "७-३९-१०", "content_sanskrit": "मणिमुक्ताप्रवालांस्तु दास्यो रूपसमन्विताः ।\nअजाविकांश्च विविधान् रथांस्तु विविधान्ददुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000574010, "chapter_id": 9574, "verse_number": "७-३९-११", "content_sanskrit": "भरतो लक्ष्मणश्चैव शत्रुघ्नश्च महाबलाः ।\nआदाय तानि रत्नानि स्वां पुरीं पुनरागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000574011, "chapter_id": 9574, "verse_number": "७-३९-१२", "content_sanskrit": "आगम्य च पुरीं रम्यामयोध्यां पुरुषर्षभाः ।\nतानि रत्नानि चित्राणि रामाय समुपाहरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000574012, "chapter_id": 9574, "verse_number": "७-३९-१३", "content_sanskrit": "प्रतिगृह्य च तत्सर्वं रामः प्रीतिसमन्वितः ।\nसुग्रीवाय ददौ राज्ञे महात्मा कृतकर्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000574013, "chapter_id": 9574, "verse_number": "७-३९-१४", "content_sanskrit": "बिभीषणाय च ददौ तथान्येभ्यो ऽपि राघवः ।\nराक्षसेभ्यः कपिभ्यश्च यैर्वृतो जयमाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000574014, "chapter_id": 9574, "verse_number": "७-३९-१५", "content_sanskrit": "ते सर्वे रामदत्तानि रत्नानि कपिराक्षसाः ।\nशिरोभिर्धारयामासुर्बाहुभिश्च महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000574015, "chapter_id": 9574, "verse_number": "७-३९-१६", "content_sanskrit": "हनूमन्तं च नृपतिरिक्ष्वाकूणां महारथः ।\nअङ्गदं च महाबाहुमङ्कमारोप्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000574016, "chapter_id": 9574, "verse_number": "७-३९-१७", "content_sanskrit": "रामः कमलपत्राक्षः सुग्रीवमिदमब्रवीत् ।\nअङ्गदस्ते सुपुत्रो ऽयं मन्त्री चाप्यनिलात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000574017, "chapter_id": 9574, "verse_number": "७-३९-१८", "content_sanskrit": "सुग्रीवमन्त्रिते युक्तौ मम चापि हिते रतौ ।\nअर्हतो विविधां पूजां त्वत्कृते वै हरीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000574018, "chapter_id": 9574, "verse_number": "७-३९-१९", "content_sanskrit": "इत्युक्त्वा व्यवमुच्याङ्गाद्भूषणानि महायशाः ।\nस बबन्ध महार्हाणि तदाङ्गदहनूमतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000574019, "chapter_id": 9574, "verse_number": "७-३९-२०", "content_sanskrit": "आभाष्य च महावीर्यान्राघवो यूथपर्षभान् ।\nनीलं नलं केसरिणं कुमुदं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000574020, "chapter_id": 9574, "verse_number": "७-३९-२१", "content_sanskrit": "सुषेणं पनसं वीरं मैन्दं द्विविदमेव च ।\nजाम्बवन्तं गवाक्षं च विनतं धूम्रमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000574021, "chapter_id": 9574, "verse_number": "७-३९-२२", "content_sanskrit": "वलीमुखं प्रजङ्घं च सन्नादं च महाबलम् ।\nदरीमुखं दधिमुखमिन्द्रजानुं च यूथपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000574022, "chapter_id": 9574, "verse_number": "७-३९-२३", "content_sanskrit": "मधुरं श्लक्ष्णया वाचा नेत्राभ्यामापिबन्निव ।\nसुहृदो मे भवन्तश्च शरीरं भ्रातरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000574023, "chapter_id": 9574, "verse_number": "७-३९-२४", "content_sanskrit": "युष्माभिरुद्धृतश्चाहं व्यसनात्काननौकसः ।\nधन्यो राजा च सुग्रीवो भवद्भिः सुहृदां वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000574024, "chapter_id": 9574, "verse_number": "७-३९-२५", "content_sanskrit": "एवमुक्त्वा ददौ तेभ्यो भूषणानि यथार्हतः ।\nवज्राणि च महार्हाणि सस्वजे च नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000574025, "chapter_id": 9574, "verse_number": "७-३९-२६", "content_sanskrit": "ते पिबन्तः सुगन्धीनि मधूनि मधुपिङ्गलाः ।\nमांसानि च सुमृष्टानि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000574026, "chapter_id": 9574, "verse_number": "७-३९-२७", "content_sanskrit": "एवं तेषां निवसतां मासः साग्रो ययौ तदा ।\nमुहूर्तमिव ते सर्वे रामभक्त्या च मेनिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000574027, "chapter_id": 9574, "verse_number": "७-३९-२८", "content_sanskrit": "रामो ऽपि रेमे तैः सार्धं वानरैः कामरूपिभिः ।\nराक्षसैश्च महावीर्यैर्ऋक्षैश्चैव महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000574028, "chapter_id": 9574, "verse_number": "७-३९-२९", "content_sanskrit": "एवं तेषां ययौ मासो द्वितीयः शिशिरः सुखम् ।\nवानराणां प्रहृष्टानां राक्षसानां च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000574029, "chapter_id": 9574, "verse_number": "७-३९-३०", "content_sanskrit": "इक्ष्वाकुनगरे रम्ये परां प्रीतिमुपासताम् ।\nरामस्य प्रीतिकरणैः कालस्तेषां सुखं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000574030, "chapter_id": 9574, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]