[{"id": 7002657000, "chapter_id": 22657, "verse_number": "६-३५-१", "content_sanskrit": "सूत उवाच ।\nचित्रकूटे गिरौ रम्ये नानाधातुविचित्रिते ।\nतत्रावसन्महाप्राज्ञ उपाध्यायः पतञ्जलिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002657001, "chapter_id": 22657, "verse_number": "६-३५-२", "content_sanskrit": "वेदवेदांगतत्त्वज्ञो गीताशास्त्रपरायणः ।\nविष्णुभक्तः सत्यसन्धो भाष्यशास्त्र विशारदः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002657002, "chapter_id": 22657, "verse_number": "६-३५-३", "content_sanskrit": "कदाचित्स तु शुद्धात्मा गतस्तीर्थांतरं प्रति ।\nकाश्यां कात्यायनेनैव तस्य वादो महानभूत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002657003, "chapter_id": 22657, "verse_number": "६-३५-४", "content_sanskrit": "वर्षान्ते च तदा विप्रो देवीभक्तेन निर्जितः ।\nलज्जितः स तु धर्मात्मा संतुष्टाव सरस्वतीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002657004, "chapter_id": 22657, "verse_number": "६-३५-५", "content_sanskrit": "पतञ्जलिरुवाच ।\nनमो देव्यै महामूर्त्यै सर्वमूर्त्यै नमो नम ।\nशिवायै सर्वमांगल्यै विष्णुमाये च ते नमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002657005, "chapter_id": 22657, "verse_number": "६-३५-६", "content_sanskrit": "त्वमेव श्रद्धा बुद्धिस्त्वं मेधा विद्या शिवंकरी ।\nशांतिर्वाणी त्वमेवासि नारायणि नमोनमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002657006, "chapter_id": 22657, "verse_number": "६-३५-७", "content_sanskrit": "इत्युक्ते सति विप्रे तु वागुवाचाशरीरिणी ।\nविप्रोत्तम चरित्रं मे जप चैकाग्रमानसः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002657007, "chapter_id": 22657, "verse_number": "६-३५-८", "content_sanskrit": "तच्चरित्रप्रभावेण सत्यं ज्ञानमवाप्स्यसि ।\nकात्यायनस्य विप्रस्य राजसंज्ञानमुद्धतम् ।\nमद्भक्त्या तेन संप्राप्तं पराजय पतञ्जले ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002657008, "chapter_id": 22657, "verse_number": "६-३५-९", "content_sanskrit": "इति श्रुत्वा वचो देव्या विन्ध्यवासिनि मन्दिरम् ।\nगत्वा तां पूजयामास तुष्टाव स्तोत्रपाठतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002657009, "chapter_id": 22657, "verse_number": "६-३५-१०", "content_sanskrit": "ज्ञानं प्रसादजं विप्रः प्राप्य विष्णुपरायणम् ।\nकात्यायनं पराजित्य परां मुदमवाप ह ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002657010, "chapter_id": 22657, "verse_number": "६-३५-११", "content_sanskrit": "ऊर्द्ध्वपुंड्रं च तिलकं तुलसीकण्ठमालिकाम् ।\nकृष्णमन्त्रं च शिवदं स्थापयित्वा गृहेगृहे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002657011, "chapter_id": 22657, "verse_number": "६-३५-१२", "content_sanskrit": "जनेजने तथा कृत्वा महाभाष्य मुदैरयत् ।\nचिरंजीवित्वमगमद्विष्णुमायाप्रसादतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002657012, "chapter_id": 22657, "verse_number": "६-३५-१३", "content_sanskrit": "इति ते कथितो विप्र जाप्यानामुत्तमो जपः ।\nकिमन्यच्छ्रोतुमिच्छंति शौनकाद्या महर्षयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002657013, "chapter_id": 22657, "verse_number": "६-३५-१४", "content_sanskrit": "सर्वे भद्राणि पश्यंतु मा कश्चिद्दुःखभाग्भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002657014, "chapter_id": 22657, "verse_number": "६-३५-१५", "content_sanskrit": "मंगलं भगवान्विष्णुर्मंगलं गरुडध्वजः ।\nमंगलं पुंडरीकाक्षो मंगला यतनो हरिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002657015, "chapter_id": 22657, "verse_number": "६-३५-१६", "content_sanskrit": "शुचिर्यो हि नरो नित्यमितिहाससमुच्चयम् ।\nशृणुयाद्धर्मकामार्थी स याति परमां गतिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]