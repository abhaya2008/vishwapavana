[{"id": 7002313000, "chapter_id": 22313, "verse_number": "३५८-१", "content_sanskrit": "कुमार उवाच ।\nतिङ्विभक्तिं प्रवक्ष्यामि तथादेशं समासतः ।\nतिङस्त्रिष्वपि वर्त्तन्ते भावे कर्म्मणि कर्त्तरि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002313001, "chapter_id": 22313, "verse_number": "३५८-२", "content_sanskrit": "सकर्म्मकाकर्म्मकाच्च कर्त्तरि द्विपदे स्मृताः ।\nसकर्म्मकाकर्म्मणि च तदादेशस्तथेरितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002313002, "chapter_id": 22313, "verse_number": "३५८-३", "content_sanskrit": "वर्त्तमाने लडाख्यातो विध्याद्यर्थे लिङीरितः ।\nविध्यादौ लोडाशिषि च भूतानद्यतने च लङ् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002313003, "chapter_id": 22313, "verse_number": "३५८-४", "content_sanskrit": "भूते लुङ् लिट् परोक्षेऽथ भाविन्यद्यतने च लुट् ।\nलिङाशिषि च शेषेऽर्थे लृड् भविष्यति लृङ्भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002313004, "chapter_id": 22313, "verse_number": "३५८-५", "content_sanskrit": "लिङ्निमित्ते क्रियातिपत्तौ परे नवात्मनेपदम् ।\nपूर्व्वं न परस्मैपदन्तिप्तसन्तीति प्रथमः पुमान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002313005, "chapter_id": 22313, "verse_number": "३५८-६", "content_sanskrit": "सिप्थस्थ मध्यमनरो मिप्वस्मस्चोत्तमः पुमान् ।\nत आतां अन्तात्मने मुख्यः थासाथां ध्वञ्च मध्यमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002313006, "chapter_id": 22313, "verse_number": "३५८-७", "content_sanskrit": "उत्तम इ वहि महि भूवाद्या धातवः स्मृताः ।\nभुविरेधिः पचिर्नन्दिर्ध्वंसिः श्रंसिः पदिस्त्वदिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002313007, "chapter_id": 22313, "verse_number": "३५८-८", "content_sanskrit": "शीङः क्रीड़ो जुहोतिश्च जहातिश्च दधात्यपि ।\nदीव्यतिः स्वपितिर्नहिः सुनोतिर्वसिरेच च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002313008, "chapter_id": 22313, "verse_number": "३५८-९", "content_sanskrit": "तुदिर्मृशतिर्मुञ्चतिः रुधिर्भुजिस्त्यजिस्तनिः ।\nशवादिके विकरणे मनिश्चैव करोत्यपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002313009, "chapter_id": 22313, "verse_number": "३५८-१०", "content_sanskrit": "क्रीड़तिर्वृङो ग्रहिश्चोरिः पा नीरच्चिश्च नायकाः ।\nभुवि स्यात् तिङ् भवति सः भवतस्तौ भवन्ति ते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002313010, "chapter_id": 22313, "verse_number": "३५८-११", "content_sanskrit": "भवसि त्वं युवां भवथो यूयं भवथ चाप्यहं ।\nभवाम्यावां भवावश्च भवामो ह्येधते कुलं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002313011, "chapter_id": 22313, "verse_number": "३५८-१२", "content_sanskrit": "एधेते द्वे तथैधन्ते एधसे त्वं हि मेधया ।\nएधेथे च समेधध्वे एधे ह्येधावहे धिया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002313012, "chapter_id": 22313, "verse_number": "३५८-१३", "content_sanskrit": "एधामहे हरेर्भक्त्या पचतीत्यादि पूर्व्ववत् ।\nभूयतेऽनुभूयतेऽसौ भावे कर्म्मणि वै यकि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002313013, "chapter_id": 22313, "verse_number": "३५८-१४", "content_sanskrit": "वुभूषति सनीत्येवं णिचि बाचवयतीश्वरं ।\nयङि वोभूयते वाद्यं वोभोति स्याच्च यङ्लुकि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002313014, "chapter_id": 22313, "verse_number": "३५८-१५", "content_sanskrit": "पुत्रीयति पुत्रकाम्यत्येवं पटपटायते ।\nघटयत्यऽथ सनि णिचि बुभूषयति रूपकं ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002313015, "chapter_id": 22313, "verse_number": "३५८-१६", "content_sanskrit": "भवेद्भवेताञ्च लिङि भवेयुश्च भवेः परे ।\nभवेतञ्च भवेतैवं भवेयञ्च भवेव च भवेम च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002313016, "chapter_id": 22313, "verse_number": "३५८-१७", "content_sanskrit": "एधेत एधेयातामेधेरन् मनसा श्रिया ।\nएधेथाश्च एधेयाथामेधेध्वमेधेय एधेवाहि एधेमहि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002313017, "chapter_id": 22313, "verse_number": "३५८-१८", "content_sanskrit": "अस्तु तावद्भवतां लोटि भवन्तु भवताद्भव ।\nभवतं भवत् भवानि भवाव च भवाम् च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002313018, "chapter_id": 22313, "verse_number": "३५८-१९", "content_sanskrit": "एधतामेधेता मेधन्तामेधै पटावहै पचामहै ।\nअभ्यनन्ददपचतामपचन्नपचस्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002313019, "chapter_id": 22313, "verse_number": "३५८-२०", "content_sanskrit": "अभवतमभवतापचमपचावापचाम च ।\nऐधतैधेतामैधध्वं ऐधे चैधामहीरितं ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002313020, "chapter_id": 22313, "verse_number": "३५८-२१", "content_sanskrit": "अभूदभूतामभूवनभूश्चभूवमेव लुङ् ।\nऐधिष्टैधिषातां नरावैधिष्ठा ऐधिषीदृशं ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002313021, "chapter_id": 22313, "verse_number": "३५८-२२", "content_sanskrit": "लिटि बभूव बभूवतुः बभूवुश्च बभूविथ ।\nबभूवथुर्बभूव च बभूविव वभूविम ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002313022, "chapter_id": 22313, "verse_number": "३५८-२३", "content_sanskrit": "पेचे पेचाते पेचिरे त्वमेधाञ्चकृषे तथा ।\nएधाञ्चक्राथे पेचिध्वे पेचे पेचिमहे तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002313023, "chapter_id": 22313, "verse_number": "३५८-२४", "content_sanskrit": "लुटि भविता भचवितारौ भवितारो हरादयः ।\nभवितासि भवितास्थो भवितास्मस्तथा वयं ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002313024, "chapter_id": 22313, "verse_number": "३५८-२५", "content_sanskrit": "पक्ता पक्तारौ पक्तारः पक्तासे त्वं शुभौदनं ।\nपक्ताध्वे पक्ताहे चाहं पक्तास्महे हरेश्चरुं ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002313025, "chapter_id": 22313, "verse_number": "३५८-२६", "content_sanskrit": "लिङाशिषि सुखं भूयात् भूयास्तां हरिशङ्करौ ।\nभूयासुस्ते च भूयास्त्वं युवां भूयास्तमीश्वरौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002313026, "chapter_id": 22313, "verse_number": "३५८-२७", "content_sanskrit": "भूयास्त यूयं भूयासमहं भूयास्म सर्व्वदा ।\nयक्षीष्ट ह्येधिषीयास्तां यक्षीरन्नेधिषीय च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002313027, "chapter_id": 22313, "verse_number": "३५८-२८", "content_sanskrit": "यक्षीवह्येधिषीमहि लिङि चायक्ष्यतेति लृङ् ।\nअयक्ष्येतामयक्ष्यन्तायक्ष्येऽयक्ष्येथां युवां ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002313028, "chapter_id": 22313, "verse_number": "३५८-२९", "content_sanskrit": "अयक्षअयध्वमैधिष्यावह्यैधिष्यामह्यरेर्वयम् ।\nलृटि स्याद्भविष्यतीति एधिष्यामह ईदृशम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002313029, "chapter_id": 22313, "verse_number": "३५८-३०", "content_sanskrit": "एवं विभावयिष्यन्ति बोभविष्यति रूपकं ।\nघटयेत् पटयेत्तद्वत् पुत्रीयति च काम्यति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]