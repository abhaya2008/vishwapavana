[{"id": 5000490000, "chapter_id": 9490, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्र्यशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000490001, "chapter_id": 9490, "verse_number": "६-८३-१", "content_sanskrit": "राघवश्चापि विपुलं तं राक्षसवनौकसाम्।\nश्रुत्वा संग्रामनिर्घोषं जाम्बवन्तमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000490002, "chapter_id": 9490, "verse_number": "६-८३-२", "content_sanskrit": "सौम्य नूनं हनुमता कृतं कर्म सुदुष्करम्।\nश्रूयते च यथा भीमः सुमहानायुधस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000490003, "chapter_id": 9490, "verse_number": "६-८३-३", "content_sanskrit": "तद् गच्छ कुरु साहाय्यं स्वबलेनाभिसंवृतः।\nक्षिप्रमृक्षपते तस्य कपिश्रेष्ठस्य युध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000490004, "chapter_id": 9490, "verse_number": "६-८३-४", "content_sanskrit": "ऋक्षराजस्तथेत्युक्त्वा स्वेनानीकेन संवृतः।\nआगच्छत् पश्चिमं द्वारं हनूमान् यत्र वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000490005, "chapter_id": 9490, "verse_number": "६-८३-५", "content_sanskrit": "अथायान्तं हनूमन्तं ददर्शर्क्षपतिस्तदा।\nवानरैः कृतसंग्रामैः श्वसद्भिरभिसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000490006, "chapter_id": 9490, "verse_number": "६-८३-६", "content_sanskrit": "दृष्ट्वा पथि हनूमांश्च तदृक्षबलमुद्यतम्।\nनीलमेघनिभं भीमं संनिवार्य न्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000490007, "chapter_id": 9490, "verse_number": "६-८३-७", "content_sanskrit": "स तेन सह सैन्येन संनिकर्षं महायशाः।\nशीघ्रमागम्य रामाय दुःखितो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000490008, "chapter_id": 9490, "verse_number": "६-८३-८", "content_sanskrit": "समरे युध्यमानानामस्माकं प्रेक्षतां च सः।\nजघान रुदतीं सीतामिन्द्रजिद् रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000490009, "chapter_id": 9490, "verse_number": "६-८३-९", "content_sanskrit": "उद‍्भ्रान्तचित्तस्तां दृष्ट्वा विषण्णोऽहमरिंदम।\nतदहं भवतो वृत्तं विज्ञापयितुमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000490010, "chapter_id": 9490, "verse_number": "६-८३-१०", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राघवः शोकमूर्च्छितः।\nनिपपात तदा भूमौ छिन्नमूल इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000490011, "chapter_id": 9490, "verse_number": "६-८३-११", "content_sanskrit": "तं भूमौ देवसंकाशं पतितं दृश्य राघवम्।\nअभिपेतुः समुत्पत्य सर्वतः कपिसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000490012, "chapter_id": 9490, "verse_number": "६-८३-१२", "content_sanskrit": "आसिञ्चन् सलिलैश्चैनं पद्मोत्पलसुगन्धिभिः।\nप्रदहन्तमसंहार्यं सहसाग्निमिवोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000490013, "chapter_id": 9490, "verse_number": "६-८३-१३", "content_sanskrit": "तं लक्ष्मणोऽथ बाहुभ्यां परिष्वज्य सुदुःखितः।\nउवाच राममस्वस्थं वाक्यं हेत्वर्थसंयुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000490014, "chapter_id": 9490, "verse_number": "६-८३-१४", "content_sanskrit": "शुभे वर्त्मनि तिष्ठन्तं त्वामार्य विजितेन्द्रियम्।\nअनर्थेभ्यो न शक्नोति त्रातुं धर्मो निरर्थकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000490015, "chapter_id": 9490, "verse_number": "६-८३-१५", "content_sanskrit": "भूतानां स्थावराणां च जङ्गमानां च दर्शनम्।\nयथास्ति न तथा धर्मस्तेन नास्तीति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000490016, "chapter_id": 9490, "verse_number": "६-८३-१६", "content_sanskrit": "यथैव स्थावरं व्यक्तं जङ्गमं च तथाविधम्।\nनायमर्थस्तथा युक्तस्त्वद्विधो न विपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000490017, "chapter_id": 9490, "verse_number": "६-८३-१७", "content_sanskrit": "यद्यधर्मो भवेद् भूतो रावणो नरकं व्रजेत्।\nभवांश्च धर्मसंयुक्तो नैव व्यसनमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000490018, "chapter_id": 9490, "verse_number": "६-८३-१८", "content_sanskrit": "तस्य च व्यसनाभावाद् व्यसनं चागते त्वयि।\nधर्मो भवत्यधर्मश्च परस्परविरोधिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000490019, "chapter_id": 9490, "verse_number": "६-८३-१९", "content_sanskrit": "धर्मेणोपलभेद् धर्ममधर्मं चाप्यधर्मतः।\nयद्यधर्मेण युज्येयुर्येष्वधर्मः प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000490020, "chapter_id": 9490, "verse_number": "६-८३-२०", "content_sanskrit": "न धर्मेण वियुज्येरन्नाधर्मरुचयो जनाः।\nधर्मेणाचरतां तेषां तथा धर्मफलं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000490021, "chapter_id": 9490, "verse_number": "६-८३-२१", "content_sanskrit": "यस्मादर्था विवर्धन्ते येष्वधर्मः प्रतिष्ठितः।\nक्लिश्यन्ते धर्मशीलाश्च तस्मादेतौ निरर्थकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000490022, "chapter_id": 9490, "verse_number": "६-८३-२२", "content_sanskrit": "वध्यन्ते पापकर्माणो यद्यधर्मेण राघव।\nवधकर्महतोऽधर्मः स हतः कं वधिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000490023, "chapter_id": 9490, "verse_number": "६-८३-२३", "content_sanskrit": "अथवा विहितेनायं हन्यते हन्ति चापरम्।\nविधिः स लिप्यते तेन न स पापेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000490024, "chapter_id": 9490, "verse_number": "६-८३-२४", "content_sanskrit": "अदृष्टप्रतिकारेण अव्यक्तेनासता सता।\nकथं शक्यं परं प्राप्तुं धर्मेणारिविकर्षण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000490025, "chapter_id": 9490, "verse_number": "६-८३-२५", "content_sanskrit": "यदि सत् स्यात् सतां मुख्य नासत् स्यात् तव किंचन।\nत्वया यदीदृशं प्राप्तं तस्मात् तन्नोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000490026, "chapter_id": 9490, "verse_number": "६-८३-२६", "content_sanskrit": "अथवा दुर्बलः क्लीबो बलं धर्मोऽनुवर्तते।\nदुर्बलो हृतमर्यादो न सेव्य इति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000490027, "chapter_id": 9490, "verse_number": "६-८३-२७", "content_sanskrit": "बलस्य यदि चेद् धर्मो गुणभूतः पराक्रमैः।\nधर्ममुत्सृज्य वर्तस्व यथा धर्मे तथा बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000490028, "chapter_id": 9490, "verse_number": "६-८३-२८", "content_sanskrit": "अथ चेत् सत्यवचनं धर्मः किल परंतप।\nअनृतं त्वय्यकरणे किं न बद्धस्त्वया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000490029, "chapter_id": 9490, "verse_number": "६-८३-२९", "content_sanskrit": "यदि धर्मो भवेद् भूत अधर्मो वा परंतप।\nन स्म हत्वा मुनिं वज्री कुर्यादिज्यां शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000490030, "chapter_id": 9490, "verse_number": "६-८३-३०", "content_sanskrit": "अधर्मसंश्रितो धर्मो विनाशयति राघव।\nसर्वमेतद् यथाकामं काकुत्स्थ कुरुते नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000490031, "chapter_id": 9490, "verse_number": "६-८३-३१", "content_sanskrit": "मम चेदं मतं तात धर्मोऽयमिति राघव।\nधर्ममूलं त्वया छिन्नं राज्यमुत्सृजता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000490032, "chapter_id": 9490, "verse_number": "६-८३-३२", "content_sanskrit": "अर्थेभ्योऽथ प्रवृद्धेभ्यः संवृत्तेभ्यस्ततस्ततः।\nक्रियाः सर्वाः प्रवर्तन्ते पर्वतेभ्य इवापगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000490033, "chapter_id": 9490, "verse_number": "६-८३-३३", "content_sanskrit": "अर्थेन हि विमुक्तस्य पुरुषस्याल्पचेतसः।\nविच्छिद्यन्ते क्रियाः सर्वा ग्रीष्मे कुसरितो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000490034, "chapter_id": 9490, "verse_number": "६-८३-३४", "content_sanskrit": "सोऽयमर्थं परित्यज्य सुखकामः सुखैधितः।\nपापमाचरते कर्तुं तदा दोषः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000490035, "chapter_id": 9490, "verse_number": "६-८३-३५", "content_sanskrit": "यस्यार्थास्तस्य मित्राणि यस्यार्थास्तस्य बान्धवाः।\nयस्यार्थाः स पुमाँल्लोके यस्यार्थाः स च पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000490036, "chapter_id": 9490, "verse_number": "६-८३-३६", "content_sanskrit": "यस्यार्थाः स च विक्रान्तो यस्यार्थाः स च बुद्धिमान्।\nयस्यार्थाः स महाभागो यस्यार्थाः स गुणाधिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000490037, "chapter_id": 9490, "verse_number": "६-८३-३७", "content_sanskrit": "अर्थस्यैते परित्यागे दोषाः प्रव्याहृता मया।\nराज्यमुत्सृजता धीर येन बुद्धिस्त्वया कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000490038, "chapter_id": 9490, "verse_number": "६-८३-३८", "content_sanskrit": "यस्यार्था धर्मकामार्थास्तस्य सर्वं प्रदक्षिणम्।\nअधनेनार्थकामेन नार्थः शक्यो विचिन्वता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000490039, "chapter_id": 9490, "verse_number": "६-८३-३९", "content_sanskrit": "हर्षः कामश्च दर्पश्च धर्मः क्रोधः शमो दमः।\nअर्थादेतानि सर्वाणि प्रवर्तन्ते नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000490040, "chapter_id": 9490, "verse_number": "६-८३-४०", "content_sanskrit": "येषां नश्यत्ययं लोकश्चरतां धर्मचारिणाम्।\nतेऽर्थास्त्वयि न दृश्यन्ते दुर्दिनेषु यथा ग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000490041, "chapter_id": 9490, "verse_number": "६-८३-४१", "content_sanskrit": "त्वयि प्रव्रजिते वीर गुरोश्च वचने स्थिते।\nरक्षसापहृता भार्या प्राणौः प्रियतरा तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000490042, "chapter_id": 9490, "verse_number": "६-८३-४२", "content_sanskrit": "तदद्य विपुलं वीर दुःखमिन्द्रजिता कृतम्।\nकर्मणा व्यपनेष्यामि तस्मादुत्तिष्ठ राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000490043, "chapter_id": 9490, "verse_number": "६-८३-४३", "content_sanskrit": "उत्तिष्ठ नरशार्दूल दीर्घबाहो धृतव्रत।\nकिमात्मानं महात्मानमात्मानं नावबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000490044, "chapter_id": 9490, "verse_number": "६-८३-४४", "content_sanskrit": "अयमनघ तवोदितः प्रियार्थं\nजनकसुतानिधनं निरीक्ष्य रुष्टः।\nसरथगजहयां सराक्षसेन्द्रां\nभृशमिषुभिर्विनिपातयामि लङ्काम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000490045, "chapter_id": 9490, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्र्यशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]