[{"id": 50004644, "chapter_id": 10770, "verse_number": "1", "content_sanskrit": "॥ [ॐ] प्राणस्तथाऽनुगमात् [ॐ]॥ १/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50004645, "chapter_id": 10770, "verse_number": "2", "content_sanskrit": "॥ [ॐ] न वक्तुरात्मोपदेशादिति चेदध्यात्मसम्बन्धभूमा ह्यस्मिन् [ॐ]॥ १/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50004646, "chapter_id": 10770, "verse_number": "3", "content_sanskrit": "॥ [ॐ] शास्त्रदृष्ट्या तूपदेशो वामदेववत् [ॐ]॥ १/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50004647, "chapter_id": 10770, "verse_number": "4", "content_sanskrit": "॥ [ॐ] जीवमुख्यप्राणलिङ्गान्नेति चेन्नोपासात्रैविध्यादाश्रितत्वादिह तद्योगात् [ॐ]॥ १/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50004648, "chapter_id": 10770, "verse_number": "5", "content_sanskrit": "॥ अन्यत्रप्रसिद्धलिङ्गात्मकशब्दसमन्वयपादः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]