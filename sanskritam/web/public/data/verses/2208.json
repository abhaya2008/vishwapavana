[{"id": 2055207, "chapter_id": 2208, "verse_number": "७-१३५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055208, "chapter_id": 2208, "verse_number": "७-१३५-१", "content_sanskrit": "दैवमेव परं मन्ये धिक्पौरुषमनर्थकम्।\nयत्राधिरथिरायत्तौ नातरत्पाण्डवं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055209, "chapter_id": 2208, "verse_number": "७-१३५-२", "content_sanskrit": "कर्णः पार्थान्सगोविन्दाञ्जेतुमुत्सहते रणे।\nन च कर्णसमं लोके पश्यामि कञ्चन।\nइति दुर्योधनस्याहमश्रौषं जल्पतो मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055210, "chapter_id": 2208, "verse_number": "७-१३५-३", "content_sanskrit": "कर्णो हि बलवाञ्छूरो दृढधन्वा जितक्लमः।\nइति मामब्रवीत्सूत मन्दो दुर्योधनः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055211, "chapter_id": 2208, "verse_number": "७-१३५-४", "content_sanskrit": "वसुषेणसहायं मां नालं देवाऽपि संयुगे।\nकिं नु पाण्डुसुता राजन्गतसत्वा विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055212, "chapter_id": 2208, "verse_number": "७-१३५-५", "content_sanskrit": "तत्र तं निर्जितं दृष्ट्वा भुजङ्गमिव निर्विषम्।\nयुद्धात्कर्णमपक्रान्तं किंस्विद्दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055213, "chapter_id": 2208, "verse_number": "७-१३५-६", "content_sanskrit": "अहो दुर्मुखमेवैकं युद्धानामविशारदम्।\nप्रावेशयद्धुतवहं पतङ्गमिव मोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055214, "chapter_id": 2208, "verse_number": "७-१३५-७", "content_sanskrit": "अश्वत्थामा मद्रराजः कृपः कर्णश्च सङ्गताः।\nन शक्त्याः प्रमुखे स्थातुं नूनं भीमस्य सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055215, "chapter_id": 2208, "verse_number": "७-१३५-८", "content_sanskrit": "तेऽपि चास्य महाघोरं बलं नागायुतोपमम्।\nजानन्तो व्यवसायं च क्रूरं मारुततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055216, "chapter_id": 2208, "verse_number": "७-१३५-९", "content_sanskrit": "किमर्थं क्रूरकर्माणं यमकालान्तकोपमम्।\nबलसंरम्भवीर्यज्ञाः कोपयिष्यन्ति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055217, "chapter_id": 2208, "verse_number": "७-१३५-१०", "content_sanskrit": "कर्णस्त्वेको महाबाहुः स्वबाहुबलदर्पितम्।\nभीमसेनमनादृत्य रणेऽयुध्यत सूतजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055218, "chapter_id": 2208, "verse_number": "७-१३५-११", "content_sanskrit": "योऽजयत्समरे कर्णं पुरन्दर इवासुरम्।\nन स पाण्डुसुतो जेतुं शक्यः केनचिदाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055219, "chapter_id": 2208, "verse_number": "७-१३५-१२", "content_sanskrit": "द्रोणं यः सम्प्रमथ्यैकः प्रविष्टो मम वाहिनीम्।\nभीमो धनञ्जयान्वेषी कस्तमार्च्छेज्जिजीविषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055220, "chapter_id": 2208, "verse_number": "७-१३५-१३", "content_sanskrit": "को हि सञ्जय भीमस्य स्थातुमुत्सहतेऽग्रतः।\nउद्यताशनिहस्तस्य महेन्द्रस्येव दानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055221, "chapter_id": 2208, "verse_number": "७-१३५-१४", "content_sanskrit": "प्रेतराजपुरं प्राप्य निवर्तेतापि मानवः।\nन भीमसेनं सम्प्राप्य निवर्तेत कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055222, "chapter_id": 2208, "verse_number": "७-१३५-१५", "content_sanskrit": "पतङ्गा इव वह्निं ते प्राविशन्नल्पचेतसः।\nये भीमसेनं सङ्क्रुद्धमन्वधावन्विमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055223, "chapter_id": 2208, "verse_number": "७-१३५-१६", "content_sanskrit": "यत्तत्सभायां भीमेन मम पुत्रवधाश्रयम्।\nउक्तं संरम्भिणोग्रेण कुरूणां शृण्वतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055224, "chapter_id": 2208, "verse_number": "७-१३५-१७", "content_sanskrit": "तन्नूनमभिसञ्चिन्त्य दृष्ट्वा कर्णं च निर्जितम्।\nदुःशासनः सह भ्रात्रा भयाद्भीमादुपारमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055225, "chapter_id": 2208, "verse_number": "७-१३५-१८", "content_sanskrit": "यश्च सञ्जय दुर्बुद्धिरब्रवीत्समितौ मुहुः।\nकर्णो दुःशासनोऽहं च जेष्यामो युधि पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055226, "chapter_id": 2208, "verse_number": "७-१३५-१९", "content_sanskrit": "स नूनं विरथं दृष्ट्वा कर्णं भीमेन निर्जितम्।\nप्रत्याख्यानाच्च कृष्णस्य भृशं तप्यति पुत्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055227, "chapter_id": 2208, "verse_number": "७-१३५-२०", "content_sanskrit": "दृष्ट्वा भ्रातॄन्हतान्सङ्ख्ये भीमसेनेन दंशितान्।\nआत्मापराधात्सम्मूढो नूनं तप्यति पुत्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055228, "chapter_id": 2208, "verse_number": "७-१३५-२१", "content_sanskrit": "को हि जीवितमन्विच्छन्प्रतीपं पाण्डवं व्रजेत्।\nभीमं भीमायुधं क्रुद्धं साक्षात्कालमिव स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055229, "chapter_id": 2208, "verse_number": "७-१३५-२२", "content_sanskrit": "बडबामुखमध्यस्थो मुच्येतापि हि मानवः।\nन भीममुखसम्प्राप्तो मुच्येदिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055230, "chapter_id": 2208, "verse_number": "७-१३५-२३", "content_sanskrit": "न पार्था न च पञ्चाला न च केशवसात्यकी।\nजानते युधि संरब्धा जीवितं परिरक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055231, "chapter_id": 2208, "verse_number": "७-१३५-२४", "content_sanskrit": "अहो मम सुतानां हि विपन्नं सूत जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055232, "chapter_id": 2208, "verse_number": "७-१३५-२५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055233, "chapter_id": 2208, "verse_number": "७-१३५-२५", "content_sanskrit": "यस्त्वं शोचसि कौरव्य वर्तमाने महाभये।\nत्वमस्य जगतो मूलं विनाशस्य न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055234, "chapter_id": 2208, "verse_number": "७-१३५-२६", "content_sanskrit": "स्वयं वैरं महत्कृत्वा पुत्राणां वचने स्थितः।\nउच्यमानो न गृह्णीषे मर्त्यः पथ्यमिवौषधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055235, "chapter_id": 2208, "verse_number": "७-१३५-२७", "content_sanskrit": "स्वयं पीत्वा महाराज कालकूटं सुदुर्जरम्।\nतस्येदानीं फलं कृत्स्नमवाप्नुहि नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055236, "chapter_id": 2208, "verse_number": "७-१३५-२८", "content_sanskrit": "यत्तु कुत्सयसे योधान्युध्यमानान्महाबलान्।\nतत्र ते वर्तयिष्यामि यथा युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055237, "chapter_id": 2208, "verse_number": "७-१३५-२९", "content_sanskrit": "दृष्ट्वा कर्णं तु पुत्रास्ते भीमसेनपराजितम्।\nनामृष्यन्त महेष्वासाः सोदर्याः पञ्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055238, "chapter_id": 2208, "verse_number": "७-१३५-३०", "content_sanskrit": "दुर्मर्षणो दुःसहश्च दुर्मदो दुर्धरो जयः।\nपाण्डवं चित्रसन्नाहास्तं प्रतीपमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055239, "chapter_id": 2208, "verse_number": "७-१३५-३१", "content_sanskrit": "ते समन्तान्महाबाहुं परिवार्य वृकोदरम्।\nदिशः शरैः समावृण्वञ्शलभानामिव व्रजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055240, "chapter_id": 2208, "verse_number": "७-१३५-३२", "content_sanskrit": "आगच्छतस्तान्सहसा कुमारान्देवरूपिणः।\nप्रतिजग्राह समरे भीमसेनो हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055241, "chapter_id": 2208, "verse_number": "७-१३५-३३", "content_sanskrit": "तव दृष्ट्वा तु तनयान्दुर्मर्षणपुरोगमान्।\nअभ्यवर्तत राधेयो भीमसेनं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055242, "chapter_id": 2208, "verse_number": "७-१३५-३४", "content_sanskrit": "विसृजन्विशिखांस्तीक्ष्णान्स्वर्णपुङ्खांञ्छिलाशितान्।\nतं तु भीमोऽभ्ययात्तूर्णं वार्यमाणः सुतैस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055243, "chapter_id": 2208, "verse_number": "७-१३५-३५", "content_sanskrit": "कुरवस्तु ततः कर्णं परिवार्य समन्ततः।\nअवाकिरन्भीमसेनं शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055244, "chapter_id": 2208, "verse_number": "७-१३५-३६", "content_sanskrit": "तान्बाणैः पञ्चविंशत्या साश्वान्राजन्नरर्षभान्।\nससूतान्भीमधनुषो भीमो निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055245, "chapter_id": 2208, "verse_number": "७-१३५-३७", "content_sanskrit": "प्रापतन्स्यन्दनेभ्यस्ते सार्धं सूतैर्गतासवः।\nचित्रपुष्पधरा भग्ना वातेनेव महाद्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055246, "chapter_id": 2208, "verse_number": "७-१३५-३८", "content_sanskrit": "तत्राद्भुतमपश्याम भीमसेनस्य विक्रमम्।\nसंवार्याधिरथिं बाणैर्यज्जघान तवात्मजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055247, "chapter_id": 2208, "verse_number": "७-१३५-३९", "content_sanskrit": "स वार्यमाणो भीमेन शितैर्बाणैः समन्ततः।\nसूतपुत्रो महाराज भीमसेनमवैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055248, "chapter_id": 2208, "verse_number": "७-१३५-४०", "content_sanskrit": "तं भीससेनः संरम्भात्क्रोधसंरक्तलोचनः।\nविष्फार्य सुमहच्चापं मुहुः कर्णमवैक्षत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2055249, "chapter_id": 2208, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे पञ्चत्रिंशदधिकशततमोऽध्यायः॥ १३५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३५-९ यमः संयमनव्यापारः कालः कलनव्यापरः अन्तको मारणव्यापारः तदुपमम्॥ ५-१३५-१३५ पञ्चत्रिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]