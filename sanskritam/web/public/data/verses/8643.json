[{"id": 900008517, "chapter_id": 8643, "verse_number": "24.1", "content_sanskrit": "अत्र पादसङ्गतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008518, "chapter_id": 8643, "verse_number": "24.2", "content_sanskrit": "अत्र ‘‘अथ यदिदमस्मिन्ब्रह्मपुरे दहरं पुण्डरीकं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008519, "chapter_id": 8643, "verse_number": "24.3", "content_sanskrit": "अत्र यद्यपि ‘‘दहरोऽस्मिन्नन्तराकाश’’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008520, "chapter_id": 8643, "verse_number": "24.4", "content_sanskrit": "यद्वा अन्वेष्टव्य इति वाक्योक्ते हृत्पद्मस्थत्वे चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008521, "chapter_id": 8643, "verse_number": "24.5", "content_sanskrit": "पूर्वपक्षस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008522, "chapter_id": 8643, "verse_number": "24.6", "content_sanskrit": "न चान्वेष्टव्यं प्रत्याधारतया तदुक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008523, "chapter_id": 8643, "verse_number": "24.7", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008524, "chapter_id": 8643, "verse_number": "24.8", "content_sanskrit": "तत्रायं भावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008525, "chapter_id": 8643, "verse_number": "24.9", "content_sanskrit": "पक्षद्वयेऽपि ‘‘अथयदिद’’मिति वाक्ये ब्रह्मपुरशब्दः शरीरेऽपि वर्तते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008526, "chapter_id": 8643, "verse_number": "24.10", "content_sanskrit": "अत्राद्ये सूत्रे स्वपक्षसाधनाय ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008527, "chapter_id": 8643, "verse_number": "24.11", "content_sanskrit": "अत्रान्यैः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008528, "chapter_id": 8643, "verse_number": "24.12", "content_sanskrit": "किञ्च ‘‘य एषोऽन्तर्हृदय आकाशस्तस्मिन् शेते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008529, "chapter_id": 8643, "verse_number": "24.13", "content_sanskrit": "यच्चोक्तमुभाभ्यां ‘‘आकाश इति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008530, "chapter_id": 8643, "verse_number": "24.14", "content_sanskrit": "टीकाक्षरार्थस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]