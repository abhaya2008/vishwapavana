[{"id": 2190440, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190441, "chapter_id": 5053, "verse_number": "१", "content_sanskrit": "कथं राजा प्रजा रक्षेन्न च किञ्चित् प्रतापयेत् ।\nपृच्छामि त्वां सतां श्रेष्ठ तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190442, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190443, "chapter_id": 5053, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nद्युमत्सेनस्य संवादं राज्ञा सत्यवता सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190444, "chapter_id": 5053, "verse_number": "३", "content_sanskrit": "अव्याहृतं व्याजहार सत्यवानिति नः श्रुतम् ।\nवधाय नीयमानेषु पितुरेवानुशासनात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190445, "chapter_id": 5053, "verse_number": "४", "content_sanskrit": "अधर्मतां याति धर्मो यात्यधर्मश्च धर्मताम् ।\nवधो नाम भवेद्धर्मो नैतद्भवितुमर्हति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190446, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190447, "chapter_id": 5053, "verse_number": "५", "content_sanskrit": "अथ चेदवधो धर्मो धर्मः को जातु चिद्भवेत् ।\nदस्यवश्चेन्न हन्येरन् सत्यवन् सङ्करो भवेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190448, "chapter_id": 5053, "verse_number": "६", "content_sanskrit": "ममेदमिति नास्यैतत् प्रवर्तेत कलौ युगे ।\nलोकयात्रा न चैव स्यादथ चेद् वेत्थ शंस नः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190449, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190450, "chapter_id": 5053, "verse_number": "७", "content_sanskrit": "सर्व एव त्रयो वर्णाः कार्या ब्राह्मणबन्धनाः ।\nधर्मपाशनिबद्धानामल्पो व्यपचरिष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190451, "chapter_id": 5053, "verse_number": "८", "content_sanskrit": "यो यस्तेषामपचरेत्तमाचक्षीत वै द्विजः ।\nअयं मे न शृणोतीति तस्मिन्राजा प्रधारयेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190452, "chapter_id": 5053, "verse_number": "९", "content_sanskrit": "तत्त्वाभेदेन यच्छास्त्रं तत् कार्यं नान्यथा वधः ।\nअसमीक्ष्यैव कर्माणि नीतिशास्त्रं यथाविधि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190453, "chapter_id": 5053, "verse_number": "१०", "content_sanskrit": "दस्यून् हिनस्ति वै राजा भूयसो वाप्यनागसः ।\nभार्या माता पिता पुत्रो हन्यते पुरुषे हते॥\nपरेणापकृते राजा तस्मात् सम्यक्प्रधारयेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190454, "chapter_id": 5053, "verse_number": "११", "content_sanskrit": "असाधुश्चैव पुरुषो लभते शीलमेकदा ।\nसाधोश्चापि ह्यसाधुभ्यो जायतेऽशोभना प्रजा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190455, "chapter_id": 5053, "verse_number": "१२", "content_sanskrit": "न मूलघातः कर्तव्यो नैष धर्मः सनातनः ।\nअपि खल्ववधेनैव प्रायश्चित्तं विधीयते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190456, "chapter_id": 5053, "verse_number": "१३", "content_sanskrit": "उद्वेजनेन बन्धेन विरूपकरणेन च ।\nवधदण्डेन ते क्लेश्या न पुरोऽहितसम्पदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190457, "chapter_id": 5053, "verse_number": "१४", "content_sanskrit": "यदा पुरोहितं वा ते पर्येयुः शरणैषिणः ।\nकरिष्यामः पुनर्ब्रह्मन्न पापमिति वादिनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190458, "chapter_id": 5053, "verse_number": "१५", "content_sanskrit": "तदा विसर्गमर्हाः स्युरितीदं नृपशासनम् ।\nबिभ्रद्दण्डाजिनं मुण्डो ब्राह्मणोऽर्हति वाससम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190459, "chapter_id": 5053, "verse_number": "१६", "content_sanskrit": "गरीयांसो गरीयांसमपराधे पुनः पुनः ।\nतथा विसर्गमर्हन्ति न यथा प्रथमे तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190460, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190461, "chapter_id": 5053, "verse_number": "१७", "content_sanskrit": "यत्र यत्रैव शक्येरन् संयन्तुं समये प्रजाः ।\nस तावत् प्रोच्यते धर्मो यावन्न प्रतिलङ्घ्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190462, "chapter_id": 5053, "verse_number": "१८", "content_sanskrit": "अहन्यमानेषु पुनः सर्वमेव पराभवेत् ।\nपूर्वे पूर्वतरे चैव सुशास्या अभवञ्जनाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190463, "chapter_id": 5053, "verse_number": "१९", "content_sanskrit": "मृदवः सत्यभूयिष्ठा अल्पद्रोहाल्पमन्यवः ।\nपुरा धिग्दण्ड एवासीद्वाग्दण्डस्तदनन्तरम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2190464, "chapter_id": 5053, "verse_number": "२०", "content_sanskrit": "आसीदादानदण्डोऽपि वधदण्डोऽद्य वर्तते ।\nवधेनापि न शक्यन्ते नियन्तुमपरे जनाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2190465, "chapter_id": 5053, "verse_number": "२१", "content_sanskrit": "नैव दस्युर्मनुष्याणां न देवानामिति श्रुतिः ।\nन गन्धर्वपितॄणां च कः कस्येह न कश्चन\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2190466, "chapter_id": 5053, "verse_number": "२२", "content_sanskrit": "पक्वं श्मशानादादत्ते पिशाचाच्चापि दैवतम् ।\nतेषु यः समयं कुर्यादज्ञेषु हतबुद्धिषु\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2190467, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2190468, "chapter_id": 5053, "verse_number": "२३", "content_sanskrit": "तान्न शक्नोषि चेत् साधून् परित्रातुमहिंसया ।\nकस्यचिद्भूतभव्यस्य लाभेनान्तं तथा कुरु\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2190469, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2190470, "chapter_id": 5053, "verse_number": "२४", "content_sanskrit": "राजानो लोकयात्रार्थं तप्यन्ते परमं तपः ।\nअपत्रपन्ति तादृग्भ्यस्तथावृत्ता भवन्ति च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2190471, "chapter_id": 5053, "verse_number": "२५", "content_sanskrit": "वित्रास्यमानाः सुकृतो न कामाद् घ्नन्ति दुष्कृतीन् ।\nसुकृतेनैव राजानो भूयिष्ठं शासते प्रजाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2190472, "chapter_id": 5053, "verse_number": "२६", "content_sanskrit": "श्रेयसः श्रेयसीमेवं वृत्तिं लोकोऽनुवर्तते ।\nसदैव हि गुरोर्वृत्तमनुवर्तन्ति मानवाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2190473, "chapter_id": 5053, "verse_number": "२७", "content_sanskrit": "आत्मानमसमाधाय समाधित्सति यः परान् ।\nविषयेष्विन्द्रियवशं मानवाः प्रहसन्ति तम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2190474, "chapter_id": 5053, "verse_number": "२८", "content_sanskrit": "यो राज्ञो दम्भमोहेन किञ्चित्कुर्यादसाम्प्रतम् ।\nसर्वोपायैर्नियम्यः स तथा पापान्निवर्तते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2190475, "chapter_id": 5053, "verse_number": "२९", "content_sanskrit": "आत्मैवादौ नियन्तव्यो दुष्कृतं सन्नियच्छता ।\nदण्डयेच्च महादण्डैरपि बन्धूननन्तरान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2190476, "chapter_id": 5053, "verse_number": "३०", "content_sanskrit": "यत्र वै पापकृत् क्लेश्यो न महद्दुःखमर्छति ।\nवर्धन्ते तत्र पापानि धर्मो ह्रसति च ध्रुवम्॥\nइति कारुण्यशीलस्तु विद्वान् वै ब्राह्मणोऽन्वशात्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2190477, "chapter_id": 5053, "verse_number": "समाप्तिः", "content_sanskrit": "इति चैवानुशिष्टोऽस्मि पूर्वैस्तात पितामहैः ।\nआश्वासयद्भिः सुभृशमनुक्रोशात्तथैव च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2190478, "chapter_id": 5053, "verse_number": "३२", "content_sanskrit": "एतत् प्रथमकल्पेन राजा कृतयुगेऽभजत् ।\nपादोनेनापि धर्मेण गच्छेत् त्रेतायुगे तथा॥\nद्वापरे तु द्विपादेन पादेन त्वपरे युगे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2190479, "chapter_id": 5053, "verse_number": "३३", "content_sanskrit": "तथा कलियुगे प्राप्ते राज्ञां दुश्चरितेन ह ।\nभवेत् कालविशेषेण कला धर्मस्य षोडशी\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2190480, "chapter_id": 5053, "verse_number": "", "content_sanskrit": "अथ प्रथमकल्पेन सत्यवन् सङ्करो भवेत् ।\nआयुः शक्तिं च कालं च निर्दिश्य तप आदिशेत्\t॥३४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2190481, "chapter_id": 5053, "verse_number": "३५", "content_sanskrit": "सत्याय हि यथा नेह जह्याद्धर्मफलं महत् ।\nभूतानामनुकम्पार्थं मनुः स्वायम्भुवोऽब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2190482, "chapter_id": 5053, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां शान्तिपर्वणि मोक्षधर्मे द्युमत्सेनसत्यवत्संवादो नाम द्व्यधिकशततमोऽध्यायः ॥१०३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]