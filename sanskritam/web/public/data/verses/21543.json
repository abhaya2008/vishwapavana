[{"id": 7001543000, "chapter_id": 21543, "verse_number": "१-४०-१", "content_sanskrit": "॥सूत उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001543001, "chapter_id": 21543, "verse_number": "१-४०-२", "content_sanskrit": "मर्य्यादापर्वते शुभ्रे देवकूटे निबोधत ।\nविस्तीर्णे सिखरे तस्य कूटे गिरिवरस्य ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001543002, "chapter_id": 21543, "verse_number": "१-४०-३", "content_sanskrit": "समन्ताद्योजनशतं महाभवनमण्डितम् ।\nजन्मक्षेत्रं सुपर्णस्य वैनतेयस्य धीमतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001543003, "chapter_id": 21543, "verse_number": "१-४०-४", "content_sanskrit": "नैकैर्महा पक्षिगणैर्गारुडैः शीग्रविक्रमैः ।\nसम्पूर्णवीर्यसम्पन्नैर्दमनैरुरगारिभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001543004, "chapter_id": 21543, "verse_number": "१-४०-५", "content_sanskrit": "पक्षिराजस्य भवनं प्रथमं तन्महात्मनः ।\nमहावायुप्रवेशस्य शाल्मलि द्वीपवासिनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001543005, "chapter_id": 21543, "verse_number": "१-४०-६", "content_sanskrit": "तस्यैव चारुमूर्ध्नस्तु कूटेषु च महर्द्धिषु ।\nदक्षिणेषु विचित्रेषु सप्तस्वपि तु शोभिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001543006, "chapter_id": 21543, "verse_number": "१-४०-७", "content_sanskrit": "सन्ध्याभ्राभाः समुदिता रुक्मप्राकारतोरणाः ।\nमहाभवनमालाभिः शोभिता देवनिर्मिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001543007, "chapter_id": 21543, "verse_number": "१-४०-८", "content_sanskrit": "त्रिंशद्योजनविस्तीर्णाश्चत्वारिंशत्तमायताः ।\nसप्त गन्धर्वनगरा नर नारीसमाकुलाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001543008, "chapter_id": 21543, "verse_number": "१-४०-९", "content_sanskrit": "आग्नेया नाम गन्धर्वा महाबलपराक्रमाः ।\nकुबेरानुचरा दीप्तास्तेषान्ते भवनोत्तमाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001543009, "chapter_id": 21543, "verse_number": "१-४०-१०", "content_sanskrit": "तस्य चोत्तरकूटेषु भुवनस्य महागिरेः ।\nहर्म्यप्रासादबद्धं च उद्यानवनशोभितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001543010, "chapter_id": 21543, "verse_number": "१-४०-११", "content_sanskrit": "पुरमाशीविषैः पुर्णं महाप्राकारतोरणम् ।\nवादित्रशतनिर्घोषैरानन्दितवनान्तरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001543011, "chapter_id": 21543, "verse_number": "१-४०-१२", "content_sanskrit": "दुष्प्रसह्यममित्राणां त्रिंशद्योजनमण्डलम् ।\nनगरं सैंहिकेयानामुदीर्णं देवविद्विषाम् ।\nसिद्धदेवर्षिचरितं देवकूटे निबोधत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001543012, "chapter_id": 21543, "verse_number": "१-४०-१३", "content_sanskrit": "द्वितीये द्विजशार्दूल मर्य्यादापर्वते शुभे ।\nमहाभवनमालाभिर्नानावर्णाभिरावृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001543013, "chapter_id": 21543, "verse_number": "१-४०-१४", "content_sanskrit": "सुवर्णमणिचित्राभिरनेकाभिरलंकृतम्  ।\nविशालरथ्यं दुर्धर्षं नित्यं प्रमुदितं शिवम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001543014, "chapter_id": 21543, "verse_number": "१-४०-१५", "content_sanskrit": "नरनारीगणाकीर्णं प्रांशुप्राकारतोरणम्  ।\nषष्टियोजनविस्तीर्णं शतयोजनमायतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001543015, "chapter_id": 21543, "verse_number": "१-४०-१६", "content_sanskrit": "नगरं कालकेयानामसुराणां दुरासदम् ।\nदेवकूटतटे रम्ये सन्निविष्टं सुदुर्जयम् ।\nमहाभ्रचयसङ्काशं सुनासन्नाम विश्रुतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001543016, "chapter_id": 21543, "verse_number": "१-४०-१७", "content_sanskrit": "तस्यैव दक्षिणे कूटे विंशद्योजनविस्तरम् ।\nद्विषष्टियोजनायामं हेमप्राकारतोरणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001543017, "chapter_id": 21543, "verse_number": "१-४०-१८", "content_sanskrit": "हृष्टपुष्टावलिप्तानामावासाः कामरूपिणाम् ।\nऔत्कचानां प्रमुदितं राक्षसानां महापुरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001543018, "chapter_id": 21543, "verse_number": "१-४०-१९", "content_sanskrit": "मध्यमे तु महाकूटे देवकूटस्य वै गिरेः  ।\nसुवर्णमणिपाषाणैश्चित्रैः श्लक्षणतरैः शुभैः ।\nशाखाशतसहस्राद्यैर्नैकारोहसमाकुलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001543019, "chapter_id": 21543, "verse_number": "१-४०-२०", "content_sanskrit": "स्रिग्ध पर्णमहामूलमनेकस्कन्धवाहनम् ।\nरम्यं ह्यविरलच्छायं दशयोजनमण्डलम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001543020, "chapter_id": 21543, "verse_number": "१-४०-२१", "content_sanskrit": "तत्र भूतवटन्नाम नानाभूतगणालयम् ।\nमहादेवस्य प्रथितं त्र्यम्बकस्य महात्मनः ।\nदीप्तमायतनं तत्र सर्वलोकेषु विश्रुतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001543021, "chapter_id": 21543, "verse_number": "१-४०-२२", "content_sanskrit": "वराहगजसिंहर्क्षशार्दूलकरभाननैः ।\nगृध्रोलूकमुखैश्चैव मेषोष्ट्राजमहामुखैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001543022, "chapter_id": 21543, "verse_number": "१-४०-२३", "content_sanskrit": "कदम्बैर्विकटैः स्थूलैर्लम्बकेशतनूरुहैः ।\nनानावर्णाकृतिधरैर्नानासंस्थानसंस्थितैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001543023, "chapter_id": 21543, "verse_number": "१-४०-२४", "content_sanskrit": "दीप्तैरनेकैरुग्रास्यैर्भूतैरुग्रपराक्रमैः ।\nअशून्यमभवन्नित्यं महापारिषदैस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001543024, "chapter_id": 21543, "verse_number": "१-४०-२५", "content_sanskrit": "तत्र भूतपतेर्भूता नित्यम्पूजां प्रयुञ्जते ।\nझर्झरैः शङ्खपटहैर्भेरीडिण्डिमगोमुखैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001543025, "chapter_id": 21543, "verse_number": "१-४०-२६", "content_sanskrit": "रणितालसितोद्गीतै र्नित्यं वलितवर्जितैः ।\nविस्फूर्ज्जितशतैस्तत्र पूजायुक्ता गणेश्वराः ।\nप्रीताः पुरारिप्रमथास्तत्र क्रीडापराः सदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001543026, "chapter_id": 21543, "verse_number": "१-४०-२७", "content_sanskrit": "सिद्धदेवर्षिगन्धर्वयक्षनागेन्द्र पूजितः ।\nस्थाने तस्मिन् महादेवः साक्षाल्लोकशिवः शिवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001543027, "chapter_id": 21543, "verse_number": "१-४०-२८", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते भुवनविन्यासो नाम चत्वारिंशोऽध्यायः ॥ ४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]