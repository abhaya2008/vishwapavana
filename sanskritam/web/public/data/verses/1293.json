[{"id": 2014198, "chapter_id": 1293, "verse_number": "२-३४-१", "content_sanskrit": "वैशम्पायन उवाच॥\nसहदेवस्ततो राजा मन्त्रिभिः सह भारत।\nसम्प्रधार्य महाबाहुः सचिवैर्बुद्धिमत्तरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014199, "chapter_id": 1293, "verse_number": "२-३४-२", "content_sanskrit": "स विचार्य तदा राजन्सहदेवस्त्वरान्वितः।\nचिन्तयामास राजेन्द्र भ्रातुः पुत्रं घटोत्कचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014200, "chapter_id": 1293, "verse_number": "२-३४-३", "content_sanskrit": "ततश्चिन्तितमात्रे तु राक्षसः प्रत्यदृश्यत।\nअतिदीर्घो महाबाहु सर्वाभरणभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014201, "chapter_id": 1293, "verse_number": "२-३४-४", "content_sanskrit": "नीलजीमूतसङ्काशस्तप्तकाञ्चनकुण्डलः।\nविचित्रहारकेयूरः किङ्किणीमणिभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014202, "chapter_id": 1293, "verse_number": "२-३४-५", "content_sanskrit": "हेममाली महादंष्ट्रः किरीटी कुक्षिबन्धनः।\nताम्रकेशो हरिश्मश्रुर्भीमाङ्गः कटकाङ्गदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014203, "chapter_id": 1293, "verse_number": "२-३४-६", "content_sanskrit": "रक्तचन्दनदिग्धाङ्गः सूक्ष्माम्बरधरो बली।\nबलेन स ययौ तत्र चालयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014204, "chapter_id": 1293, "verse_number": "२-३४-७", "content_sanskrit": "ततो दृष्ट्वा जना राजन्नायान्तं पर्वतोपमम्।\nभयाद्धि दुद्रुवुः सर्वे सिंहात्क्षुद्रमृगा यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014205, "chapter_id": 1293, "verse_number": "२-३४-८", "content_sanskrit": "आससाद च माद्रेयं पुलस्त्यं रावणो यथा।\nअभिवाद्य ततो राजन्सहदेवं घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014206, "chapter_id": 1293, "verse_number": "२-३४-९", "content_sanskrit": "प्रह्वः कृताञ्जलिस्तस्थौ किं कार्यमिति चाब्रवीत्।\nतं परिष्वज्य बाहुभ्यां मूर्ध्न्युपाघ्राय पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014207, "chapter_id": 1293, "verse_number": "२-३४-१०", "content_sanskrit": "तं मेरुशिखराकारमागतं पाण्डुनन्दनः।\nपूजयित्वा सहामात्यः प्रीतो वाक्यमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014208, "chapter_id": 1293, "verse_number": "२-३४-११", "content_sanskrit": "गच्छ लङ्कां पुरीं वत्स करार्थं मम शासनात्। ॥\nतत्र दृष्ट्वा महात्मानं राक्षसेन्द्रं बिभीषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014209, "chapter_id": 1293, "verse_number": "२-३४-१२", "content_sanskrit": "रत्नानि राजसूयार्थं विविधानि बहूनि च।\nउपादाय च सर्वाणि प्रत्यागच्छ महाबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014210, "chapter_id": 1293, "verse_number": "२-३४-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014211, "chapter_id": 1293, "verse_number": "२-३४-१३", "content_sanskrit": "पाण्डवेनैवमुक्तस्तु मुदा युक्तो घटोत्कचः।\nतथेत्युक्त्वा महाराज प्रतस्ये दक्षिणां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014212, "chapter_id": 1293, "verse_number": "२-३४-१४", "content_sanskrit": "प्रययौ दक्षिणं कृत्वा सहदेवं घटोत्कचः।\nलङ्कामभिमुको राजन्समुद्रं स व्यलोकयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014213, "chapter_id": 1293, "verse_number": "२-३४-१५", "content_sanskrit": "कूर्मग्राहझषाकीर्णं मीननक्रैस्तथाऽऽकुलम्।\nशुक्तिव्रातसमाकीर्णं शङ्कानां निचयाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014214, "chapter_id": 1293, "verse_number": "२-३४-१६", "content_sanskrit": "स दृष्ट्वा रामसेतुं च चिन्तयन्रामविक्रमम्॥\nगत्वा पारं समुद्रस्य दक्षिणं स घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014215, "chapter_id": 1293, "verse_number": "२-३४-१७", "content_sanskrit": "ददर्श लङ्कां राजेन्द्र नाकपृष्ठोपमां शुभाम्।\nप्राकारेणावृतां रम्यां शुभद्वारैश्च शोभिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014216, "chapter_id": 1293, "verse_number": "२-३४-१८", "content_sanskrit": "प्रासादैर्बहुसाहस्रैः श्वेतरक्तैश्च सङ्कुलाम्।\nदिव्यदुन्दुभिनिर्ह्रादामुद्यानवनशोभिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014217, "chapter_id": 1293, "verse_number": "२-३४-१९", "content_sanskrit": "सर्वकालफलैर्वृक्षैः पुष्पितैरुपशोभिताम्।\nपुष्पगन्धैश्च सङ्कीर्णां रमणीयमहारथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014218, "chapter_id": 1293, "verse_number": "२-३४-२०", "content_sanskrit": "नानारत्नैश्च सम्पूर्णामिन्द्रस्येवामरावतीम्।\nविवेश स पुरीं लङ्कां राक्षसैश्च निषेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014219, "chapter_id": 1293, "verse_number": "२-३४-२१", "content_sanskrit": "ददर्श स पुरीं लङ्कां राक्षसैश्च निषेविताम्॥\nनानावेषधरान्दक्षान्नारीश्च प्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014220, "chapter_id": 1293, "verse_number": "२-३४-२२", "content_sanskrit": "दिव्यमाल्याम्बरधरा दिव्यभूषणभूषिताः।\nमदरक्तान्तनयनाः पीनश्रोणिपयोधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014221, "chapter_id": 1293, "verse_number": "२-३४-२३", "content_sanskrit": "भैमसेनिं ततो दृष्ट्वा हृष्टास्ते विस्मयं गताः।\nआससाद गृहं राज्ञ इन्द्रस्य सदनोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014222, "chapter_id": 1293, "verse_number": "२-३४-२४", "content_sanskrit": "स द्वारपालमासाद्य वाक्यमेतदुवाच ह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014223, "chapter_id": 1293, "verse_number": "२-३४-२४x", "content_sanskrit": "घटोत्कच उवाच॥\nकुरूणामृष्टबो राजा पाण्डुर्नाम महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014224, "chapter_id": 1293, "verse_number": "२-३४-२५", "content_sanskrit": "कनीयांस्तस्य दायादः सहदेव इति श्रुतः।\nतेनाहं प्रेषितो दूतः करार्थं कौरवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014225, "chapter_id": 1293, "verse_number": "२-३४-२६", "content_sanskrit": "द्रष्टुमिच्छामि राजेनद्रं त्वं क्षिप्रं मां निवेदय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014226, "chapter_id": 1293, "verse_number": "२-३४-२६x", "content_sanskrit": "वैशम्पायन उवाच॥\nतस्य तद्वचनं श्रुत्वा द्वारपालो महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014227, "chapter_id": 1293, "verse_number": "२-३४-२७", "content_sanskrit": "तथेत्युक्त्वा विवेशाथ भवनं स निवेदकः।\nप्राञ्जलिः स्रवमाचष्ट स्रवां दूतगिरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014228, "chapter_id": 1293, "verse_number": "२-३४-२८", "content_sanskrit": "द्वारपालवचः श्रुत्वा राक्षसेन्द्रो विभीषणः।\nउवाच वाक्यं धर्मात्मा समीपं मे प्रवेश्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014229, "chapter_id": 1293, "verse_number": "२-३४-२९", "content_sanskrit": "एवमुक्तस्तु राज्ञा स धर्मज्ञेन महात्मना।\nअथनिष्कम्य सम्भ्रान्तो द्वार्स्थोहैडिम्बमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014230, "chapter_id": 1293, "verse_number": "२-३४-३०", "content_sanskrit": "एहि दूत नृपं द्रष्टुं क्षिप्रं प्रविश च स्वयम्।\nद्वारपालवचः श्रुत्वा प्रविवेश घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014231, "chapter_id": 1293, "verse_number": "२-३४-३१", "content_sanskrit": "स प्रविश्य ददर्शाथ राक्षसेन्द्रस्य मन्दिरम्।\nततः कैलाससङ्काशं तत्पकाञ्चनतोरणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014232, "chapter_id": 1293, "verse_number": "२-३४-३२", "content_sanskrit": "प्राकारेण परिक्षिप्तं गोपुरैश्चापि शोभितम्।\nहर्म्यप्रासादसम्बाधं नानारत्नोपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014233, "chapter_id": 1293, "verse_number": "२-३४-३३", "content_sanskrit": "काञ्चनैस्तापनीयैश्च स्फाटिकै राजतैरपि।\nवज्रवैडूर्यजुष्टैश्च स्तम्भैश्च सुमनोहरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014234, "chapter_id": 1293, "verse_number": "२-३४-३४", "content_sanskrit": "नानाध्वजपताकाभिर्युक्तं मणिविचित्रितम्।\nचित्रमाल्यावृतं रम्यं तप्तकाञ्चनवेदिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2014235, "chapter_id": 1293, "verse_number": "२-३४-३५", "content_sanskrit": "स दृष्ट्वा तत्र सर्वं च भैमसेनिर्मनोहरम्।\nप्रविशन्नेव हैडिम्बः शुश्राव मधुरस्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2014236, "chapter_id": 1293, "verse_number": "२-३४-३६", "content_sanskrit": "तन्त्रीगीतसमाकीर्णं समतालमिताक्षरम्।\nदिव्यदुन्दुभिनिर्ह्रादं वादित्रसततं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2014237, "chapter_id": 1293, "verse_number": "२-३४-३७", "content_sanskrit": "स श्रुत्वा मधुरं शब्दं प्रीतिमानभवत्तदा।\nततो विगाह्य हैडिम्बो बहुकक्ष्यां मनोरमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2014238, "chapter_id": 1293, "verse_number": "२-३४-३८", "content_sanskrit": "स ददर्श महात्मानं द्वार्स्थेन सह भारत।\nतं विभीषणमासीनं काञ्चने परमासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2014239, "chapter_id": 1293, "verse_number": "२-३४-३९", "content_sanskrit": "दिवि भास्करसङ्काशं मुक्तामणिविभूषितम्।\nदिव्याभरणचित्राङ्गं दिव्यरूपधरं विभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2014240, "chapter_id": 1293, "verse_number": "२-३४-४०", "content_sanskrit": "दिव्यमाल्याम्बरधरं दिव्यगन्धोक्षितं शुभम्।\nविभ्राजमानं वपुषा सूर्यवैश्वानरप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2014241, "chapter_id": 1293, "verse_number": "२-३४-४१", "content_sanskrit": "उपोपविष्टं सचिवैर्देवैरिव शतक्रतुम्।\nयक्षैर्महात्मभिर्दिव्यनारीभिर्हृद्यकान्तिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2014242, "chapter_id": 1293, "verse_number": "२-३४-४२", "content_sanskrit": "गीतैर्मङ्गलयुक्तैश्च पूज्यमानं यथा दिवि।\nचामरे व्यजने चाग्र्ये हेमदण्डे महाधने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2014243, "chapter_id": 1293, "verse_number": "२-३४-४३", "content_sanskrit": "गृहीते वरनारीभ्यां धूयमाने च मूर्धनि।\nअर्चिष्मन्तं श्रिया जुष्टं कुबेरवरुणोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2014244, "chapter_id": 1293, "verse_number": "२-३४-४४", "content_sanskrit": "धर्मे चैव स्थितं नित्यमद्भुतं राक्षसेस्वरम्।\nराममिक्ष्वाकुनाथं वै स्मरन्तं मनसा सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2014245, "chapter_id": 1293, "verse_number": "२-३४-४५", "content_sanskrit": "दृष्ट्वा घटोत्कचो राजन्ववन्दे तं कृताञ्जलिः।\nप्रह्वस्तस्थौ महावीर्यः शक्रं चित्ररथो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2014246, "chapter_id": 1293, "verse_number": "२-३४-४६", "content_sanskrit": "तं दूतमागतं दृष्ट्वा राक्षसेन्द्रो विभीषणः।\nपूजयित्वा यथान्यायं सान्त्वपूर्वं वचोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2014247, "chapter_id": 1293, "verse_number": "२-३४-४७x", "content_sanskrit": "विभीषण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2014248, "chapter_id": 1293, "verse_number": "२-३४-४७", "content_sanskrit": "कस्य वंशे स सञ्जातः करमिच्छन्महीपतिः।\nतस्यानुजान्समस्तांश्च पुरं देशं च तस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2014249, "chapter_id": 1293, "verse_number": "२-३४-४८", "content_sanskrit": "त्वां च कार्यं च तत्सर्वं श्रोतुमिच्छामि तत्वतः।\nविस्तरेण मम ब्रूहि सर्वानेतान्पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2014250, "chapter_id": 1293, "verse_number": "२-३४-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2014251, "chapter_id": 1293, "verse_number": "२-३४-४९", "content_sanskrit": "एवमुक्तस्तु हैडिम्बः पौलस्त्येन महात्मना।\nकृताञ्जलिरुवाचाथ समर्थमिदमुत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2014252, "chapter_id": 1293, "verse_number": "२-३४-५०x", "content_sanskrit": "घटोत्कच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2014253, "chapter_id": 1293, "verse_number": "२-३४-५०", "content_sanskrit": "सोमवंशोद्भवो राजा पाण्डुर्नाम महाबलः।\nपाण्डोश्च पुत्राः पञ्चासञ्छक्रतुल्यपराक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2014254, "chapter_id": 1293, "verse_number": "२-३४-५१", "content_sanskrit": "तेषां ज्येष्ठस्तु नाम्ना वै युधिष्ठिर इति श्रुतः।\nअजातशत्रुर्धर्मात्मा धर्मो विग्रहवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2014255, "chapter_id": 1293, "verse_number": "२-३४-५२", "content_sanskrit": "ततो युधिष्ठिरो राजा प्राप्य राज्यमकारयत्।\nगङ्गाया दक्षिणे तीरे नगरे नागसाह्वये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2014256, "chapter_id": 1293, "verse_number": "२-३४-५३", "content_sanskrit": "तद्दत्वा धृतराष्ट्राय शक्रप्रस्थं ययौ ततः।\nभ्रातृभिः सह राजेन्द्र शक्रप्रस्थेऽन्वमोदत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2014257, "chapter_id": 1293, "verse_number": "२-३४-५४", "content_sanskrit": "गङ्गायमुनयोर्मध्ये ते उभे नगरोत्तमे।\nनित्यं धर्मे स्थितो राजा शक्रप्रस्थे प्रशास्ति नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2014258, "chapter_id": 1293, "verse_number": "२-३४-५५", "content_sanskrit": "तस्यानुजो महाबाहुर्भीमसेन इति श्रुतः।\nमहातेजा महाकीर्तिः शक्रतुल्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2014259, "chapter_id": 1293, "verse_number": "२-३४-५६", "content_sanskrit": "दशनागसहस्राणां बले तुल्यः स पाण्डवः।\nतस्यानुजोऽर्जुनो नाम महाबलपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2014260, "chapter_id": 1293, "verse_number": "२-३४-५७", "content_sanskrit": "सुकुमारो महासत्वो लोके वीर्येण विश्रुतः।\nकार्तवीर्यसमो वीर्ये सागरप्रतिमो बले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2014261, "chapter_id": 1293, "verse_number": "२-३४-५८", "content_sanskrit": "जामदग्न्यसमश्चास्त्रे सङ्ख्ये रामसमोऽर्जुनः।\nरूपे शक्रसमः पार्थस्तेजसा भास्करोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2014262, "chapter_id": 1293, "verse_number": "२-३४-५९", "content_sanskrit": "देवदानवगन्धर्वैः पिशाचोरगराक्षसैः।\nमानुषैश्च समस्तैस्तु अजेयः फल्गुनो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2014263, "chapter_id": 1293, "verse_number": "२-३४-६०", "content_sanskrit": "तेन तत्खण्डवं दावं तर्पितं जातवेदसे।\nविजित्य तरसा शक्रं युधि देवगणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2014264, "chapter_id": 1293, "verse_number": "२-३४-६१", "content_sanskrit": "लब्धान्यस्त्राणि दिव्यानि तर्पयित्वा हुताशनम्।\nतेन लब्धा महाराज दुर्लभा दैवतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2014265, "chapter_id": 1293, "verse_number": "२-३४-६२", "content_sanskrit": "वासुदेवस्य भगिनी सुभद्रा नाम विश्रुता।\nअर्जुनस्यानुजो राजन्नकुलश्चेति विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2014266, "chapter_id": 1293, "verse_number": "२-३४-६३", "content_sanskrit": "दर्शनीयतमो लोके मूर्तिमानिव मन्मथः।\nतस्यानुजो महातेजाः सहदेव इति श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2014267, "chapter_id": 1293, "verse_number": "२-३४-६४", "content_sanskrit": "तेनाहं प्रेषितो राजन्कुमारेण समो रणे।\nअहं घटोत्कचो नाम भीमसेनसुतो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2014268, "chapter_id": 1293, "verse_number": "२-३४-६५", "content_sanskrit": "मम माता महाभागा हिडिम्बा नाम राक्षसी।\nपार्थानामुपकारार्थं चरामि पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2014269, "chapter_id": 1293, "verse_number": "२-३४-६६", "content_sanskrit": "आसीत्पृथिव्याः सर्वस्या महीपालो युधिष्ठिरः।\nराजसूयं क्रतुश्रेष्ठमाहर्तुमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2014270, "chapter_id": 1293, "verse_number": "२-३४-६७", "content_sanskrit": "सन्दिदेश च स भ्रातृन्करार्थं सर्वतोदिशम्।\nवृष्णिवीरेण सहितः सन्दिदेशानुजान्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2014271, "chapter_id": 1293, "verse_number": "२-३४-६८", "content_sanskrit": "उदीचीमर्जुनस्तूर्णं गत्वा मेरोरथोत्तमः।\nगत्वा शतसहस्राणि योजनानि महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2014272, "chapter_id": 1293, "verse_number": "२-३४-६९", "content_sanskrit": "जित्वा सर्वान्नृपान्युद्धे हत्वा च तरसा वशी।\nस्वर्गद्वारमुपागम्य रत्नान्यादाय वै भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2014273, "chapter_id": 1293, "verse_number": "२-३४-७०", "content_sanskrit": "अश्वांश्च विविधान्दिव्यान्सर्वानादाय फल्गुनः।\nधनं बहुविधं राजन्धर्मपुत्राय वै ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2014274, "chapter_id": 1293, "verse_number": "२-३४-७१", "content_sanskrit": "भीमसेनो हि राजेन्द्र जित्वा प्राचीं दिशं बलात्।\nवशे कृत्वा महीपालान्पाण्डवाय धनं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2014275, "chapter_id": 1293, "verse_number": "२-३४-७२", "content_sanskrit": "दिशं प्रतीचीं नकुलः करार्थं प्रययौ तथा।\nसहदेवो दिशं याम्यां जित्वा सर्वान्महीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2014276, "chapter_id": 1293, "verse_number": "२-३४-७३", "content_sanskrit": "मां सन्दिदेश राजेन्द्र करार्थमिह सत्कृतः।\nपार्थानां चरितं तुभ्यं सङ्क्षेपात्समुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2014277, "chapter_id": 1293, "verse_number": "२-३४-७४", "content_sanskrit": "तमवेक्ष्य महाराज धर्मराजं युधिष्ठिरम्।\nपावनं राजसूयं च भगवन्तं हरिं प्रभुम्।\nएतानवेक्ष्य धर्मज्ञ करं दातुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2014278, "chapter_id": 1293, "verse_number": "२-३४-७५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2014279, "chapter_id": 1293, "verse_number": "२-३४-७५", "content_sanskrit": "तेन तद्भाषितं श्रुत्वा राक्षसेन्द्रो बिभीषणः।\nशासनं प्रतिजग्राह धर्मात्मा राक्षसैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2014280, "chapter_id": 1293, "verse_number": "२-३४-७६", "content_sanskrit": "तच्च कृष्णकृतं धीमानित्यमन्यत स प्रभुः।\nततो ददौ विचित्राणि कम्बलानि कुथानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2014281, "chapter_id": 1293, "verse_number": "२-३४-७७", "content_sanskrit": "दान्तकाञ्चनपर्यङ्कान्मणिहेमविचित्रितान्।\nभूषणानि महार्हाणि प्रवालानि मणींश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2014282, "chapter_id": 1293, "verse_number": "२-३४-७८", "content_sanskrit": "काञ्चनानि च भाण्डनि कलशानि घटानि च।\nकटाहानि विचित्रानि द्रोण्यश्चैव सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2014283, "chapter_id": 1293, "verse_number": "२-३४-७९", "content_sanskrit": "राजतानि च भाण्डानि रत्नगर्भांश्च कुण्डलान्।\nहेमपुष्पानि चान्यानि रुक्ममुख्यानि चापरान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2014284, "chapter_id": 1293, "verse_number": "२-३४-८०", "content_sanskrit": "शङ्खांश्च चन्द्रसङ्काशांश्चित्रावर्तविचित्रितान्।\nयज्ञस्य तोरणे युक्तान्ददौ तालांश्चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2014285, "chapter_id": 1293, "verse_number": "२-३४-८१", "content_sanskrit": "रुक्मपङ्कजपुष्पाणि शिबिका मणिभूषिताः।\nमुकुटानि महार्हाणि रत्नगर्भांश्च कङ्कणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2014286, "chapter_id": 1293, "verse_number": "२-३४-८२", "content_sanskrit": "चन्दनानि च मुख्यानि वासांसि विविधानि च।\nस ददौ सहदेवाय तदा राजा विभीषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2014287, "chapter_id": 1293, "verse_number": "२-३४-८३", "content_sanskrit": "तानि सर्वाणि रत्नानि आजह्रुस्ते निशाचराः।\nअष्टाशीतिसहस्राणि समदा रक्तलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2014288, "chapter_id": 1293, "verse_number": "२-३४-८४", "content_sanskrit": "रत्नान्यादाय सर्वाणि प्रतस्थे स घटोत्कचः।\nविभीषणं च राजानमभिवाद्य कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2014289, "chapter_id": 1293, "verse_number": "२-३४-८५", "content_sanskrit": "प्रदक्षिणं परीत्यैव निर्जगाम घटोत्कचः।\nततो रत्नान्युपादाय हैडिम्बो राक्षसैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2014290, "chapter_id": 1293, "verse_number": "२-३४-८६", "content_sanskrit": "जगाम तूर्णं लङ्कायाः सहदेवपदं प्रति।\nआसेदुः पाण्डवं सर्वे लङ्घयित्वा महोदधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2014291, "chapter_id": 1293, "verse_number": "२-३४-८७", "content_sanskrit": "सहदेवो ददर्शाथ रत्नाहारान्निशाचरान्।\nआगतान्भीमसङ्काशान्हैडिम्बं च तथा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2014292, "chapter_id": 1293, "verse_number": "२-३४-८८", "content_sanskrit": "द्रमिला नैऋतान्दृष्ट्वा दुद्रुवुस्ते भयार्दिताः।\nभैमसेनिस्ततो गत्वा मार्देयं प्राञ्जलिः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2014293, "chapter_id": 1293, "verse_number": "२-३४-८९", "content_sanskrit": "प्रीतिमानभवद्दृष्ट्वा रत्नौधं तं च पाण्डवः।\nतं परिष्वज्य पाणिभ्यां दृष्ट्वा तान्प्रीतिमानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2014294, "chapter_id": 1293, "verse_number": "२-३४-९०", "content_sanskrit": "विसृज्य द्रविडान्सर्वान्गमनायोपचक्रमे।\nन्यवर्तम ततो धीमान्सहदेवो नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2014295, "chapter_id": 1293, "verse_number": "२-३४-९१", "content_sanskrit": "एवं विजित्य तरसा सान्त्वेन विजयेन च।\nकरदान्पार्थिवान्कृत्वा प्रत्यागच्छदरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2014296, "chapter_id": 1293, "verse_number": "२-३४-९२", "content_sanskrit": "रत्नसालमुपादाय ययौ सहनिशाचरः।\nइन्द्रप्रस्थं विवेशाथ कम्पयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2014297, "chapter_id": 1293, "verse_number": "२-३४-९३", "content_sanskrit": "दृष्ट्वा युधिष्ठिरं राजन्सहदेवः कृताञ्जलिः।\nप्रह्वोऽभिवाद्य तस्थौ स पूजितश्चापि तेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2014298, "chapter_id": 1293, "verse_number": "२-३४-९४", "content_sanskrit": "लङ्काप्राप्तान्धनौघांश्च दृष्ट्वा तान्दुर्लभान्बहून्।\nप्रीतिमानभवद्राजा विस्मयं परमं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2014299, "chapter_id": 1293, "verse_number": "२-३४-९५", "content_sanskrit": "धर्मराजाय तत्सर्वं निवेद्य भरतर्षभ।\nकोटीसहस्रमधिकं हिरण्यस्य महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2014300, "chapter_id": 1293, "verse_number": "२-३४-९६", "content_sanskrit": "विविधानि च रत्नानि गोजाविमहिषांस्तथा।\nकृतकर्मा सुखं राजन्नुवास जनमेजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2014301, "chapter_id": 1293, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि चतुस्त्रिंसोऽध्यायः॥ ३४॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]