[{"id": 7004021000, "chapter_id": 24021, "verse_number": "३-२-३२-१", "content_sanskrit": "व्यास उवाच ।\nततश्च रामदूतास्ते नत्वा राममथाब्रुवन् ।\nरामराम महाबाहो वरनारी शुभानना॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004021001, "chapter_id": 24021, "verse_number": "३-२-३२-२", "content_sanskrit": "सुवस्त्रभूषाभरणां मृदुवाक्यपरायणाम् ।\nएकाकिनीं क्रदमानाम दृष्ट्वा तां विस्मिता वयम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004021002, "chapter_id": 24021, "verse_number": "३-२-३२-३", "content_sanskrit": "समीपवर्तिनो भूत्वा पृष्टा सा सुरसुन्दरी ।\nका त्वं देवि वरारोहे देवी वा दानवी नु किम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004021003, "chapter_id": 24021, "verse_number": "३-२-३२-४", "content_sanskrit": "रामः पृच्छति देवि त्वां ब्रूहि सर्वं यथातथम् ।\nतच्छ्रुत्वा वचनं रामा सोवाच मधुरं वचः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004021004, "chapter_id": 24021, "verse_number": "३-२-३२-५", "content_sanskrit": "रामं प्रेषयत भद्रं वो मम दुःखापहं परम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004021005, "chapter_id": 24021, "verse_number": "३-२-३२-६", "content_sanskrit": "तदाकर्ण्य ततो रामः संभ्रमात्त्वरितो ययौ ।\nदृष्ट्वा तां दुःखसंतप्तां स्वयं दुःखमवाप सः ।\nउवाच वचनं रामः कृतांजलिपुटस्तदा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004021006, "chapter_id": 24021, "verse_number": "३-२-३२-७", "content_sanskrit": "श्रीराम उवाच ।\nका त्वं शुभे कस्य परिग्रहो वा केनावधूता विजने निरस्ता ।\nमुष्टं धनं केन च तावकीनमाचक्ष्व मातः सकलं ममाग्रे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004021007, "chapter_id": 24021, "verse_number": "३-२-३२-८", "content_sanskrit": "इत्युक्त्वा चातिदुःखार्तो रामो मतिमतां वरः ।\nप्रणामं दंडवच्चक्रे चक्रपाणिरिवापरः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004021008, "chapter_id": 24021, "verse_number": "३-२-३२-९", "content_sanskrit": "तयाभिवंदितो रामः प्रगम्य च पुनःपुनः ।\nतुष्टया परया प्रीत्या स्तुतो मधुरया गिरा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004021009, "chapter_id": 24021, "verse_number": "३-२-३२-१०", "content_sanskrit": "परमात्मन्परेशान दुःखहारिन्सनातन ।\nयदर्थमवतारस्ते तच्च कार्यं त्वया कृतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004021010, "chapter_id": 24021, "verse_number": "३-२-३२-११", "content_sanskrit": "रावणः कुम्भकर्णश्च शक्रजित्प्रमुखास्तथा ।\nखरदूषणत्रिशिरोमारीचाक्षकुमारकाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004021011, "chapter_id": 24021, "verse_number": "३-२-३२-१२", "content_sanskrit": "असंख्या निर्जिता रौद्रा राक्षसाः समरांगणे॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004021012, "chapter_id": 24021, "verse_number": "३-२-३२-१३", "content_sanskrit": "किं वच्मि लोकेश सुकीर्त्तिमद्य ते वेधास्त्वदीयांगजपद्मसंभवः ।\nविश्वं निविष्टं च ततो ददर्श वटस्य पत्रे हि यथो वटो मतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004021013, "chapter_id": 24021, "verse_number": "३-२-३२-१४", "content_sanskrit": "धन्यो दशरथो लोके कौशल्या जननी तव ।\nययोर्जातोसि गोविंद जगदीश परः पुमान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004021014, "chapter_id": 24021, "verse_number": "३-२-३२-१५", "content_sanskrit": "धन्यं च तत्कुलं राम यत्र त्वमागतः स्वयम् ।\nधन्याऽयोध्यापुरी राम धन्यो लोकस्त्वदाश्रयः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004021015, "chapter_id": 24021, "verse_number": "३-२-३२-१६", "content_sanskrit": "धन्यः सोऽपि हि वाल्मीकिर्येन रामायणं कृतम् ।\nकविना विप्रमुख्येभ्य आत्मबुद्ध्या ह्यनागतम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004021016, "chapter_id": 24021, "verse_number": "३-२-३२-१७", "content_sanskrit": "त्वत्तोऽभवत्कुलं चेदं त्वया देव सुपावितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004021017, "chapter_id": 24021, "verse_number": "३-२-३२-१८", "content_sanskrit": "नरपतिरिति लोकैः स्मर्यते वैष्णवांशः स्वयमसि रमणीयैस्त्वं गुणैर्विष्णुरेव ।\nकिमपि भुवनकार्यं यद्विचिंत्यावतीर्य तदिह घटयतस्ते वत्स निर्विघ्नमस्तु॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004021018, "chapter_id": 24021, "verse_number": "३-२-३२-१९", "content_sanskrit": "स्तुत्वा वाचाथ रामं हि त्वयि नाथे नु सांप्रतम् ।\nशून्या वर्ते चिरं कालं यथा दोषस्तथैव हि॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004021019, "chapter_id": 24021, "verse_number": "३-२-३२-२०", "content_sanskrit": "धर्मारण्यस्य क्षेत्रस्य विद्धि मामधिदेवताम् ।\nवर्षाणि द्वादशेहैव जातानि दुःखि तास्म्यहम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004021020, "chapter_id": 24021, "verse_number": "३-२-३२-२१", "content_sanskrit": "निर्जनत्वं ममाद्य त्वमुद्धरस्व महामते ।\nलोहासुरभयाद्राम विप्राः सर्वे दिशो दश॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004021021, "chapter_id": 24021, "verse_number": "३-२-३२-२२", "content_sanskrit": "गताश्च वणिजः सर्वे यथास्थानं सुदुःखिताः ।\nस दैत्यो घातितो राम देवैः सुरभयंकरः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004021022, "chapter_id": 24021, "verse_number": "३-२-३२-२३", "content_sanskrit": "आक्रम्यात्र महामायो दुराधर्षो दुरत्ययः ।\nन ते जनाः समायांति तद्भयादति शंकिताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004021023, "chapter_id": 24021, "verse_number": "३-२-३२-२४", "content_sanskrit": "अद्य वै द्वादश समाः शून्यागारमनाथवत् ।\nयस्माच्च दीर्घिकायां मे स्नानदानोद्यतो जनः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004021024, "chapter_id": 24021, "verse_number": "३-२-३२-२५", "content_sanskrit": "राम तस्यां दीर्घिकायां निपतंति च शूकराः ।\nयत्रांगना भर्तृयुता जलक्रीडापरायणाः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004021025, "chapter_id": 24021, "verse_number": "३-२-३२-२६", "content_sanskrit": "चिक्रीडुस्तत्र महिषा निपतंति जलाशये ।\nयत्र स्थाने सुपुष्पाणां प्रकरः प्रचुरोऽभवत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004021026, "chapter_id": 24021, "verse_number": "३-२-३२-२७", "content_sanskrit": "तद्रुद्धं कंटकैर्वृक्षैः सिंहव्याघ्रसमाकुलैः ।\nसंचिक्रीडुः कुमाराश्च यस्यां भूमौ निरंतरम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004021027, "chapter_id": 24021, "verse_number": "३-२-३२-२८", "content_sanskrit": "कुमार्यश्चित्रकाणां च तत्र क्रीडं ति हर्षिताः ।\nअकुर्वन्वाडवा यत्र वेदगानं तिरंतरम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004021028, "chapter_id": 24021, "verse_number": "३-२-३२-२९", "content_sanskrit": "शिवानां तत्र फेत्काराः श्रूयंतेऽतिभयंकराः ।\nयत्र धूमोऽग्निहोत्राणां दृश्यते वै गृहेगृहे॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004021029, "chapter_id": 24021, "verse_number": "३-२-३२-३०", "content_sanskrit": "तत्र दावाः सधूमाश्च दृश्यंतेऽत्युल्बणा भृशम् ।\nनृत्यंते नर्त्तका यत्र हर्षिता हि द्विजाग्रतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004021030, "chapter_id": 24021, "verse_number": "३-२-३२-३१", "content_sanskrit": "तत्रैव भूतवेताला प्रेताः नृत्यंति मोहिताः ।\nनृपा यत्र सभायां तु न्यषीदन्मंत्रतत्पराः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004021031, "chapter_id": 24021, "verse_number": "३-२-३२-३२", "content_sanskrit": "तस्मिन्स्थाने निषीदंति गवया ऋक्षशल्लकाः ।\nआवासा यत्र दृश्यन्ते द्विजानां वणिजां तथा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004021032, "chapter_id": 24021, "verse_number": "३-२-३२-३३", "content_sanskrit": "कुट्टिमप्रतिमा राम दृश्यंतेत्र बिलानि वै ।\nकोटराणीह वृक्षाणां गवाक्षाणीह सर्वतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004021033, "chapter_id": 24021, "verse_number": "३-२-३२-३४", "content_sanskrit": "चतुष्का यज्ञवेदिर्हि सोच्छ्राया ह्यभवत्पुरा ।\nतेऽत्र वल्मीकनिचयैर्दृश्यंते परिवेष्टिताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004021034, "chapter_id": 24021, "verse_number": "३-२-३२-३५", "content_sanskrit": "एवंविधं निवासं मे विद्धि राम नृपोत्तम ।\nशून्यं तु सर्वतो यस्मान्निवासाय द्विजा गताः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004021035, "chapter_id": 24021, "verse_number": "३-२-३२-३६", "content_sanskrit": "तेन मे सुमहद्दुःखं तस्मात्त्राहि नरेश्वर ।\nएतच्छ्रुत्वा वचो राम उवाच वदतां वरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004021036, "chapter_id": 24021, "verse_number": "३-२-३२-३७", "content_sanskrit": "श्रीराम उवाच ।\nन जाने तावकान्विप्रांश्चतुर्दिक्षु समाश्रितान् ।\nन तेषां वेद्म्यहं संख्यां नामगोत्रे द्विजन्मनाम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004021037, "chapter_id": 24021, "verse_number": "३-२-३२-३८", "content_sanskrit": "यथा ज्ञातिर्यथा गोत्रं याथातथ्यं निवेदय ।\nतत आनीय तान्सर्वान्स्वस्थाने वासयाम्यहम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004021038, "chapter_id": 24021, "verse_number": "३-२-३२-३९", "content_sanskrit": "श्रीमातोवाच ।\nब्रह्मविष्णुमहेशैश्च स्थापिता ये नरेश्वर ।\nअष्टादश सहस्राणि ब्राह्मणा वेदपारगाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004021039, "chapter_id": 24021, "verse_number": "३-२-३२-४०", "content_sanskrit": "त्रयीविद्यासु विख्याता लोकेऽस्मिन्नमितद्युते ।\nचतुष्षष्टिकगोत्राणां वाडवा ये प्रतिष्ठिताः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004021040, "chapter_id": 24021, "verse_number": "३-२-३२-४१", "content_sanskrit": "श्रीमातादात्त्रयीविद्यां लोके सर्वे द्विजोत्तमाः ।\nषट्त्रिंशच्च सहस्राणि वैश्या धर्मपरायणाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004021041, "chapter_id": 24021, "verse_number": "३-२-३२-४२", "content_sanskrit": "आर्यवृत्तास्तु विज्ञेया द्विजशुश्रूषणे रताः ।\nबहुलार्को नृपो यत्र संज्ञया सह राजते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004021042, "chapter_id": 24021, "verse_number": "३-२-३२-४३", "content_sanskrit": "कुमारावश्विनौ देवौ धनदो व्ययपूरकः ।\nअधिष्ठात्री त्वहं राम नाम्ना भट्टारिका स्मृता॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004021043, "chapter_id": 24021, "verse_number": "३-२-३२-४४", "content_sanskrit": "श्रीसूत उवाच ।\nस्थानाचाराश्च ये केचित्कुलाचारास्तथैव च ।\nश्रीमात्रा कथितं सर्वं रामस्याग्रे पुरातनम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004021044, "chapter_id": 24021, "verse_number": "३-२-३२-४५", "content_sanskrit": "तस्यास्तु वचनं श्रुत्वा रामो मुदमवाप ह ।\nसत्यंसत्यं पुनः सत्यं सत्यं हि भाषितं त्वया॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004021045, "chapter_id": 24021, "verse_number": "३-२-३२-४६", "content_sanskrit": "यस्मात्सत्यं त्वया प्रोक्तं तन्नाम्ना नगरं शुभम् ।\nवासयामि जगन्मातः सत्यमंदिरमेव च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004021046, "chapter_id": 24021, "verse_number": "३-२-३२-४७", "content_sanskrit": "त्रैलोक्ये ख्यातिमाप्नोतु सत्यमंदिरमु त्तमम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004021047, "chapter_id": 24021, "verse_number": "३-२-३२-४८", "content_sanskrit": "एतदुक्त्वा ततो रामः सहस्रशतसंख्यया ।\nस्वभृत्यान्प्रेषयामास विप्रानयनहेतवे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004021048, "chapter_id": 24021, "verse_number": "३-२-३२-४९", "content_sanskrit": "यस्मिन्देशे प्रदेशे वा वने वा सरि तस्तटे ।\nपर्यंते वा यथास्थाने ग्रामे वा तत्रतत्र च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004021049, "chapter_id": 24021, "verse_number": "३-२-३२-५०", "content_sanskrit": "धर्मारण्यनिवासाश्च याता यत्र द्विजोत्तमाः ।\nअर्घपाद्यैः पूजयित्वा शीघ्रमानयतात्र तान्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004021050, "chapter_id": 24021, "verse_number": "३-२-३२-५१", "content_sanskrit": "अहमत्र तदा भोक्ष्ये यदा द्रक्ष्ये द्विजोत्तमान्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004021051, "chapter_id": 24021, "verse_number": "३-२-३२-५२", "content_sanskrit": "विमान्य च द्विजानेतानागमिष्यति यो नरः ।\nस मे वध्यश्च दंड्यश्च निर्वास्यो विषयाद्बहिः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004021052, "chapter_id": 24021, "verse_number": "३-२-३२-५३", "content_sanskrit": "तच्छ्रुत्वा दारुणं वाक्यं दुःसहं दुःप्रधर्षणम् ।\nरामाज्ञाकारिणो दूता गताः सर्वे दिशो दश॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004021053, "chapter_id": 24021, "verse_number": "३-२-३२-५४", "content_sanskrit": "शोधिता वाडवाः सर्वे लब्धाः सर्वे सुहर्षिताः ।\nयथोक्तेन विधानेन अर्घपाद्यैरपूजयन्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004021054, "chapter_id": 24021, "verse_number": "३-२-३२-५५", "content_sanskrit": "स्तुतिं चक्रुश्च विधिवद्विनयाचारपूर्वकम् ।\nआमंत्र्य च द्विजान्सर्वान्रामवाक्यं प्रकाशयन्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004021055, "chapter_id": 24021, "verse_number": "३-२-३२-५६", "content_sanskrit": "ततस्ते वाडवाः सर्वे द्विजाः सेवकसंयुताः ।\nगमनायोद्यताः सर्वे वेदशास्त्रपरायणाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004021056, "chapter_id": 24021, "verse_number": "३-२-३२-५७", "content_sanskrit": "आगता रामपार्श्वं च बहुमानपुरःसराः ।\nसमागतान्द्विजान्दृष्ट्वा रोमांचिततनूरुहः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004021057, "chapter_id": 24021, "verse_number": "३-२-३२-५८", "content_sanskrit": "कृतकृत्यमिवात्मानं मेने दाशरथिर्नृपः ।\nस संभ्रमात्समुत्थाय पदातिः प्रययौ पुरः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004021058, "chapter_id": 24021, "verse_number": "३-२-३२-५९", "content_sanskrit": "करसंपुटकं कृत्वा हर्षाश्रु प्रतिमुञ्चयन् ।\nजानुभ्यामवनिं गत्वा इदं वचनमब्रवीत्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004021059, "chapter_id": 24021, "verse_number": "३-२-३२-६०", "content_sanskrit": "विप्रप्रसादात्कमलावरोऽहं विप्रप्रसादाद्धरणीधरोऽहम् ।\nविप्रप्रसादाज्जगतीपतिश्च विप्रप्रसादान्मम रामनाम॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004021060, "chapter_id": 24021, "verse_number": "३-२-३२-६१", "content_sanskrit": "इत्येवमुक्ता रामेण वाड वास्ते प्रहर्षिताः ।\nजयाशीर्भिः प्रपूज्याथ दीर्घायुरिति चाब्रुवन्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004021061, "chapter_id": 24021, "verse_number": "३-२-३२-६२", "content_sanskrit": "आवर्जितास्ते रामेण पाद्यार्घ्यविष्टरादिभिः ।\nस्तुतिं चकार विप्राणां दण्डवत्प्रणिपत्य च॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004021062, "chapter_id": 24021, "verse_number": "३-२-३२-६३", "content_sanskrit": "कृतांजलिपुटः स्थित्वा चक्रे पादाभिवंदनम् ।\nआसनानि विचित्राणि हैमान्याभरणानि च॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004021063, "chapter_id": 24021, "verse_number": "३-२-३२-६४", "content_sanskrit": "समर्पयामास ततो रामो दशरथात्मजः ।\nअंगुलीयकवासांसि उपवीतानि कर्णकान्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004021064, "chapter_id": 24021, "verse_number": "३-२-३२-६५", "content_sanskrit": "प्रददौ विप्रमुख्येभ्यो नानावर्णाश्च धेनवः ।\nएकैकशत संख्याका घटोध्नीश्च सवत्सकाः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004021065, "chapter_id": 24021, "verse_number": "३-२-३२-६६", "content_sanskrit": "सवस्त्रा बद्धघंटाश्च हेमशृंगविभूषिताः ।\nरूप्यखुरास्ताम्रपृष्ठीः कांस्यपात्रसमन्विताः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]