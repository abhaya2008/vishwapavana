[{"id": 2015191, "chapter_id": 1317, "verse_number": "२-५८-१", "content_sanskrit": "भीष्म उवाच।\nएवमालोकयाञ्चक्रुर्द्वारकामृषभास्त्रयः।\nउपेन्द्रबलदेवौ च वासवश्च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015192, "chapter_id": 1317, "verse_number": "२-५८-२", "content_sanskrit": "ततस्तं पाण्डरं शौरिर्मूर्ध्नि तिष्ठन्गरुत्मतः।\nप्रीतः शङ्खमुपाध्मासीद्द्विषतां रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015193, "chapter_id": 1317, "verse_number": "२-५८-३", "content_sanskrit": "तस्य शङ्खस्य शब्देन सारश्चुक्षुभे भृशम्।\nररास च नभः सर्वं तच्चित्रमभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015194, "chapter_id": 1317, "verse_number": "२-५८-४", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं निशम्य कुकुरान्दकाः।\nप्रीयमाणाः समाजग्मुरालोक्य मधुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015195, "chapter_id": 1317, "verse_number": "२-५८-५", "content_sanskrit": "वसुदेवं पुरस्कृत्य वेणुशङ्खरवैः सह।\nउग्रसेनो ययौ राजा वासुदेवनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015196, "chapter_id": 1317, "verse_number": "२-५८-६", "content_sanskrit": "आनन्दितुं पर्यचन्स्वेषु वेश्मसु देवकी।\nरोहिणी च ययौ देशमाहुकस्य च याः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015197, "chapter_id": 1317, "verse_number": "२-५८-७", "content_sanskrit": "हता ब्रह्मद्विषः सर्वे जयन्त्यन्धकवृष्णयटः।\nएवमुक्तः सह स्त्रीभिरक्षतैर्मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015198, "chapter_id": 1317, "verse_number": "२-५८-८", "content_sanskrit": "ततः शौरिः सुपर्णेन स्वं निवेशनमभ्ययात्।\nचकाराथ यथोद्देशमीश्वरो मणिपर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015199, "chapter_id": 1317, "verse_number": "२-५८-९", "content_sanskrit": "ततो धनानि रत्नानि सभायां मधुसूदनः।\nनिधाय पुण्डरीकाक्षः पितुर्दर्शनलालसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015200, "chapter_id": 1317, "verse_number": "२-५८-१०", "content_sanskrit": "ततः सान्दीपिनिं पूर्वं ब्राह्मणं चापि भारत।\nयथान्यायं वासुदेव उपस्पृष्ट्वा महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015201, "chapter_id": 1317, "verse_number": "२-५८-११", "content_sanskrit": "ववन्दे पृथुताम्राक्षः प्रीयमाणो महायशाः।\nतथाऽश्रुपरिपूर्णाक्षमानन्दभृतचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015202, "chapter_id": 1317, "verse_number": "२-५८-१२", "content_sanskrit": "ववन्दे सह रामेण पितरं वासवानुजः।\nताभ्यां च मूर्ध्न्युपाघ्रातः केशवः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015203, "chapter_id": 1317, "verse_number": "२-५८-१३", "content_sanskrit": "यथाश्रेष्ठमुपागम्य सात्वतान्यदुनन्दनः।\nसर्वेषां नाम जग्राह दाशार्हाणामधोक्षजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015204, "chapter_id": 1317, "verse_number": "२-५८-१४", "content_sanskrit": "ततः सर्वाणि वित्तानि सर्वरत्नमयानि च।\nव्यभजत्तानि तेभ्योऽथ सर्वेभ्यो यदुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015205, "chapter_id": 1317, "verse_number": "२-५८-१५", "content_sanskrit": "सा केशवमहामात्रैर्महेन्द्रप्रतिमैः सभा।\nशुशुभे वृष्णिशार्दूलैः सिंहैरिव गिरेर्गुहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015206, "chapter_id": 1317, "verse_number": "२-५८-१६", "content_sanskrit": "अथासनगतान्सर्वानुवाच विबुधाधिपः।\nशुभया हर्षयन्वाचा महेन्द्रस्तान्महायशाः।\nकुकुरान्धकमुख्यांश्च तं च राजानमाहुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015207, "chapter_id": 1317, "verse_number": "२-५८-१७x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015208, "chapter_id": 1317, "verse_number": "२-५८-१७", "content_sanskrit": "यदर्थं जन्म कृष्णस्य मानुषेषु महात्मनः।\nयत्कृतं वासुदेवेन तद्वक्ष्यामि समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015209, "chapter_id": 1317, "verse_number": "२-५८-१८", "content_sanskrit": "अयं शतसहस्राणि दानवानामरिन्दमः।\nनिहय् पुण्डरीकाक्षः पातालविवरं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015210, "chapter_id": 1317, "verse_number": "२-५८-१९", "content_sanskrit": "यच्च नाधिगतं पूर्वैः प्रह्लादबलिशम्बरैः।\nतदिदं शौरिणा वित्तं प्रापितं भवतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015211, "chapter_id": 1317, "verse_number": "२-५८-२०", "content_sanskrit": "सपाशं मुरमाक्रमय् पाञ्चजन्यं च धीमता।\nशिलासङ्घानतिक्रम्य निशुम्भः सगणो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015212, "chapter_id": 1317, "verse_number": "२-५८-२१", "content_sanskrit": "हयग्रीवश्च विक्रान्तो दानवो निहतो बली।\nमथितश्च मृधे भौमः कुण्डले चाहृते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015213, "chapter_id": 1317, "verse_number": "२-५८-२२", "content_sanskrit": "पुनर्बाणवधे शौरिमादित्या वसुभिः सह।\nमन्मुखा आगमिष्यन्ति साध्याश्च मधुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015214, "chapter_id": 1317, "verse_number": "२-५८-२३", "content_sanskrit": "एवमुक्त्वा ततः सर्वानामन्त्र्य कुकुरान्धकान्।\nसस्वजे रामकृष्णौ च वसुदेवं च वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015215, "chapter_id": 1317, "verse_number": "२-५८-२४", "content_sanskrit": "प्रद्युम्नसाम्बप्रमुखाननिरूद्धं च सारणम्।\nबभ्रुं झल्लिं गदं भानुं चारुदेष्णं च वृत्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015216, "chapter_id": 1317, "verse_number": "२-५८-२५", "content_sanskrit": "सत्कृत्य सारणाक्रूरौ पुनराभाष्य सात्यकिम्।\nसस्वजे वृष्णिराजानमाहुकं कुकुराधिपम्।\nभोजं च कृतवर्णाणमन्यांश्चान्दकवृष्णिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015217, "chapter_id": 1317, "verse_number": "२-५८-२६", "content_sanskrit": "आमन्त्र्य देवप्रवरैर्वासवो वासवानुजम्।\nततः श्वेताचलप्रख्यं गजमैरावतं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015218, "chapter_id": 1317, "verse_number": "२-५८-२७", "content_sanskrit": "पश्यतां सर्वभातानामारुरोह शचीपतिः।\nपृथिवीं चान्तरिक्षं च दिवं च वरवारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015219, "chapter_id": 1317, "verse_number": "२-५८-२८", "content_sanskrit": "मुखाडम्बरनिर्घोषैः पूरयन्तमिवासकृत्।\nहैमयन्त्रमहाकक्ष्यं हिरण्मयविषाणिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015220, "chapter_id": 1317, "verse_number": "२-५८-२९", "content_sanskrit": "मनोहरकुथास्तीर्णं सर्वरत्नविभूषितम्।\nनित्यस्रुतमदस्रावं क्षरन्तमिव तोयदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015221, "chapter_id": 1317, "verse_number": "२-५८-३०", "content_sanskrit": "दिशागजं महामात्रं काञ्चनस्रजमास्थितः।\nप्रबभौ मन्दराग्रस्थः प्रतपन्भानुमानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015222, "chapter_id": 1317, "verse_number": "२-५८-३१", "content_sanskrit": "ततो वज्मयं भीमं प्रगृह्य परामाङ्कुशम्।\nययौ बलवता सार्धं पावकेन शचीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015223, "chapter_id": 1317, "verse_number": "२-५८-३२", "content_sanskrit": "तं करेणुगजव्रातैर्विमानैश्च मरुद्गणाः।\nपृष्ठतोऽनुययुः प्रीताः कुबेरवरुणग्रहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015224, "chapter_id": 1317, "verse_number": "२-५८-३३", "content_sanskrit": "स वायुपक्षमास्थाय वैश्वानरपथं गतः।\nप्राप्य सूर्यपथं देवस्तत्रैवान्तरधीयत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015225, "chapter_id": 1317, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि अष्टपञ्चाशोऽध्यायः॥ ५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]