[{"id": 6000054000, "chapter_id": 10054, "verse_number": null, "content_sanskrit": "अथ चतुर्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000054001, "chapter_id": 10054, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.001.m4a", "display_order": 2}, {"id": 6000054002, "chapter_id": 10054, "verse_number": "३-२४-१", "content_sanskrit": "पितृभ्यां प्रस्थिते साध्वी पतिमिङ्गितकोविदा।\nनित्यं पर्यचरत् प्रीत्या भवानीव भवं प्रभुम्॥ ३/२४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.002.m4a", "display_order": 3, "topics": [{"text": "ततश्चिरतरदुश्चरशुश्रूषया कर्शितनिजदेहां देवहूतिं प्रति तुष्टेन कर्दमेनाभीष्टवरणचोदना", "range": "१–११"}]}, {"id": 6000054003, "chapter_id": 10054, "verse_number": "३-२४-२", "content_sanskrit": "विस्रम्भेणात्मशौचेन गौरवेण दमेन च।\nशुश्रूषया सौहृदेन वाचा मधुरया प्रभो॥ ३/२४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.003.m4a", "display_order": 4}, {"id": 6000054004, "chapter_id": 10054, "verse_number": "३-२४-३", "content_sanskrit": "विसृज्य कामं दम्भं च द्वेषं लोभमघं मदम्।\nअप्रमत्तोद्यता नित्यं तेजीयांसमतोषयत्॥ ३/२४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.004.m4a", "display_order": 5}, {"id": 6000054005, "chapter_id": 10054, "verse_number": "३-२४-४", "content_sanskrit": "स वै देवर्षिवर्यस्तां मानवीं समनुव्रताम्।\nदैवाद् गरीयसः पत्युराशासानां महाशिषः॥ ३/२४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.005.m4a", "display_order": 6}, {"id": 6000054006, "chapter_id": 10054, "verse_number": "३-२४-५", "content_sanskrit": "कालेन भूयसा क्षामां कर्शितां व्रतचर्यया।\nप्रेमगद्गदया वाचा पीडितः कृपयाऽब्रवीत्॥ ३/२४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.006.m4a", "display_order": 7}, {"id": 6000054007, "chapter_id": 10054, "verse_number": "३-२४-६", "content_sanskrit": "तुष्टोऽहमद्य तव मानवि मानदायाः शुश्रूषया परमया परया च भक्त्या।\nयो देहिनामयमतीव सुहृत् स्वदेहो नापेक्षितः समुचितं क्षपितुं यदर्थे॥ ३/२४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.007.m4a", "display_order": 8}, {"id": 6000054008, "chapter_id": 10054, "verse_number": "३-२४-७", "content_sanskrit": "या मे स्वधर्मनिरतस्य तपःसमाधिविद्यात्मयोगविजिता भगवत्प्रसादात्।\nतामेव ते तदनुभावनयाऽवरुद्धां दृष्टिं प्रपश्य वितराम्यभयामशोकाम्॥ ३/२४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.008.m4a", "display_order": 9}, {"id": 6000054009, "chapter_id": 10054, "verse_number": "३-२४-८", "content_sanskrit": "अन्ये पुनर्भगवतो भ्रुव उद्विजृम्भविभ्रंशितार्थरचनाः किमुरुक्रमस्य।\nसिद्धासि भुङ्क्ष्व विभवान् निजधर्मदोहान् दिव्यान् नरैर्दुरधिगान् नृपविक्रियाभिः॥ ३/२४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.009.m4a", "display_order": 10}, {"id": 6000054010, "chapter_id": 10054, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.010.m4a", "display_order": 11}, {"id": 6000054011, "chapter_id": 10054, "verse_number": "३-२४-९", "content_sanskrit": "एवं ब्रुवाणमबलाऽखिलयोगमायाविद्याविचक्षणमवेत्य गताधिरासीत्।\nसप्रश्रयप्रणयविह्वलया गिरैषा व्रीडावलोकविलसद्धसिताननाऽऽह॥ ३/२४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.011.m4a", "display_order": 12}, {"id": 6000054012, "chapter_id": 10054, "verse_number": null, "content_sanskrit": "देवहूतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.012.m4a", "display_order": 13}, {"id": 6000054013, "chapter_id": 10054, "verse_number": "३-२४-१०", "content_sanskrit": "राद्धं तव द्विजवृषैतदमोघयोगमायाधिपे त्वयि विभो तदवैमि भर्तः।\nयस्तेऽभ्यधायि समयः सकृदङ्गसङ्गो भूयाद् वरीयसि गुणप्रसवः सतीनाम्॥ ३/२४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.013.m4a", "display_order": 14}, {"id": 6000054014, "chapter_id": 10054, "verse_number": "३-२४-११", "content_sanskrit": "तत्रेतिकृत्यमुपशिक्ष यथोपदेशं येनैष मे कर्शितोऽतिरिरंसयाऽऽत्मा।\nसिध्येत ते कृतमनोभवधर्षितायाः कामस्तदीश भवनं सदृशं विचक्ष्व॥ ३/२४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.014.m4a", "display_order": 15}, {"id": 6000054015, "chapter_id": 10054, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.015.m4a", "display_order": 16}, {"id": 6000054016, "chapter_id": 10054, "verse_number": "३-२४-१२", "content_sanskrit": "प्रियायाः प्रियमन्विच्छन् कर्दमो योगमास्थितः।\nविमानं कामगं क्षत्तस्तर्ह्येवाविरचीकरत्॥ ३/२४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.016.m4a", "display_order": 17, "topics": [{"text": "तया सुखविहरणपूर्वकमपत्योत्पादनं प्रार्थितेन तेन योगविभवेन दिव्यविमाननिर्माणपूर्वकं बिन्दुसरःस्नानमात्रेण दिव्यरूपवत्या योगप्रभावेण नव देहान् धारितवत्या देवहूत्या सह स्वयमपि नवधाऽऽत्मानं विभज्य कामगमं विमानमारुह्य नन्दनवनादिषु सुखेन विहरणं नवकन्योत्पादनं च", "range": "१२–४८"}]}, {"id": 6000054017, "chapter_id": 10054, "verse_number": "३-२४-१३", "content_sanskrit": "सर्वकामदुघं दिव्यं सर्वरत्नसमन्वितम्।\nसर्वर्द्ध्युपचयोदर्कं मणिस्तम्भैरुपस्कृतम्॥ ३/२४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.017.m4a", "display_order": 18}, {"id": 6000054018, "chapter_id": 10054, "verse_number": "३-२४-१४", "content_sanskrit": "दिव्योपस्करणोपेतं सर्वकालसुखावहम्।\nपट्टिकाभिर्विचित्राभिः पताकाभिरलंकृतम्॥ ३/२४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.018.m4a", "display_order": 19}, {"id": 6000054019, "chapter_id": 10054, "verse_number": "३-२४-१५", "content_sanskrit": "स्रग्भिर्विचित्रमालाभिर्मञ्जुसिञ्जत्षडङ्घ्रिभिः।\nदुकूलक्षौमकौशेयैर्नानावस्‍त्रैर्विराजितम्॥ ३/२४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.019.m4a", "display_order": 20}, {"id": 6000054020, "chapter_id": 10054, "verse_number": "३-२४-१६", "content_sanskrit": "उपर्युपरि विन्यस्तनिलयेषु पृथक् पृथक्।\nकॢप्तैः कशिपुभिः कान्तं पर्यङ्कव्यजनासनैः॥ ३/२४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.020.m4a", "display_order": 21}, {"id": 6000054021, "chapter_id": 10054, "verse_number": "३-२४-१७", "content_sanskrit": "तत्र तत्र विनिक्षिप्तनानाशिल्पोपशोभितम्।\nमहामरकतस्थल्या जुष्टं विद्रुमवेदिभिः॥ ३/२४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.021.m4a", "display_order": 22}, {"id": 6000054022, "chapter_id": 10054, "verse_number": "३-२४-१८", "content_sanskrit": "द्वास्सु विद्रुमदेहल्या भातं वज्रकपाटिमत्।\nशिखरेष्विन्द्रनीलेषु हेमकुम्भैरधिष्ठितम्॥ ३/२४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.022.m4a", "display_order": 23}, {"id": 6000054023, "chapter_id": 10054, "verse_number": "३-२४-१९", "content_sanskrit": "चक्षुष्मत्पद्मरागाद्यैर्वज्रभित्तिषु निर्मितैः।\nजुष्टं विचित्रवैतानैर्महार्हैर्हेमतोरणैः॥ ३/२४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.023.m4a", "display_order": 24}, {"id": 6000054024, "chapter_id": 10054, "verse_number": "३-२४-२०", "content_sanskrit": "हंसपारावतव्रातैस्तत्र तत्र निकूजितम्।\nकृत्रिमान् मन्यमानैः स्वानधिरुह्याधिरुह्य च॥ ३/२४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.024.m4a", "display_order": 25}, {"id": 6000054025, "chapter_id": 10054, "verse_number": "३-२४-२१", "content_sanskrit": "विहारस्थानविश्रामसंवेशप्राङ्गणाजिरैः।\nयथोपजोषं रचितैर्विस्मापनमिवात्मनः॥ ३/२४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.025.m4a", "display_order": 26}, {"id": 6000054026, "chapter_id": 10054, "verse_number": "३-२४-२२", "content_sanskrit": "ईदृग् गृहं तत् पश्यन्तीं नातिप्रीतेन चेतसा।\nसर्वभूताशयाभिज्ञः प्रावोचत् कर्दमः स्वयम्॥ ३/२४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.026.m4a", "display_order": 27}, {"id": 6000054027, "chapter_id": 10054, "verse_number": "३-२४-२३", "content_sanskrit": "निमज्जास्मिन् ह्रदे भीरु विमानमिदमारुह।\nइदं शुक्लकृतं तीर्थमाशिषामाप्तये नृणाम्॥ ३/२४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.027.m4a", "display_order": 28}, {"id": 6000054028, "chapter_id": 10054, "verse_number": "३-२४-२४", "content_sanskrit": "सा तद् भर्तुः समादाय वचः कुवलयेक्षणा।\nसरजं बिभ्रती वासो वेणीभूतांश्च मूर्धजान्॥ ३/२४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.028.m4a", "display_order": 29}, {"id": 6000054029, "chapter_id": 10054, "verse_number": "३-२४-२५", "content_sanskrit": "अङ्गं च मलपङ्केन संछन्नं शबलस्तनम्।\nआविवेश सरस्वत्याः सरः शिवजलाशयम्॥ ३/२४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.029.m4a", "display_order": 30}, {"id": 6000054030, "chapter_id": 10054, "verse_number": "३-२४-२६", "content_sanskrit": "साऽन्तःसरसि वेश्मस्थाः शतानि दश कन्यकाः।\nसर्वाः कैशोरवयसो ददर्शोत्पलगन्धयः॥ ३/२४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.030.m4a", "display_order": 31}, {"id": 6000054031, "chapter_id": 10054, "verse_number": "३-२४-२७", "content_sanskrit": "तां दृष्ट्वा सहसोत्थाय प्रोचुः प्राञ्जलयः स्‍त्रियः।\nवयं कर्मकरीस्तुभ्यं शाधि नः करवाम किम्॥ ३/२४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.031.m4a", "display_order": 32}, {"id": 6000054032, "chapter_id": 10054, "verse_number": "३-२४-२८", "content_sanskrit": "स्नानेन तां महार्हेण स्नापयित्वा मनस्विनीम्।\nदुकूले निर्मले नूत्ने ददुरस्यै च मानद॥ ३/२४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.032.m4a", "display_order": 33}, {"id": 6000054033, "chapter_id": 10054, "verse_number": "३-२४-२९", "content_sanskrit": "भूषणानि परार्घ्यानि वरीयांसि द्युमन्ति च।\nअन्नं सर्वगुणोपेतं पानं चैवामृतासवम्॥ ३/२४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.033.m4a", "display_order": 34}, {"id": 6000054034, "chapter_id": 10054, "verse_number": "३-२४-३०", "content_sanskrit": "अथाऽदर्शे स्वमात्मानं स्रग्विणं विरजाम्बरम्।\nविरजं कृतस्वस्त्ययनं कन्याभिर्बहुमानितम्॥ ३/२४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.034.m4a", "display_order": 35}, {"id": 6000054035, "chapter_id": 10054, "verse_number": "३-२४-३१", "content_sanskrit": "दृष्ट्वा कृतशिरःस्नानं सर्वाभरणभूषितम्।\nनिष्कग्रीवं वलयिनं कूजत्काञ्चननूपुरम्॥ ३/२४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.035.m4a", "display_order": 36}, {"id": 6000054036, "chapter_id": 10054, "verse_number": "३-२४-३२", "content_sanskrit": "श्रोण्योरध्यस्तया काञ्च्या काञ्चन्या बहुरत्नया।\nहारेण च महार्हेण रुचकेन च भूषितम्॥ ३/२४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.036.m4a", "display_order": 37}, {"id": 6000054037, "chapter_id": 10054, "verse_number": "३-२४-३३", "content_sanskrit": "सुभ्रुवा सुदता श्लक्ष्णस्निग्धापाङ्गेन चक्षुषा।\nपद्मकोशस्पृधा नीलैरलकैश्च लसन्मुखम्॥ ३/२४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.037.m4a", "display_order": 38}, {"id": 6000054038, "chapter_id": 10054, "verse_number": "३-२४-३४", "content_sanskrit": "यदा सस्मार ऋषभमृषीणां दयितं पतिम्।\nतत्र चास्ते सह स्‍त्रीभिर्यत्रास्ते स प्रजापतिः॥ ३/२४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.038.m4a", "display_order": 39}, {"id": 6000054039, "chapter_id": 10054, "verse_number": "३-२४-३५", "content_sanskrit": "भर्तुः पुरस्तादात्मानं स्‍त्रीसहस्रवृतं तदा।\nनिशाम्य तद्योगगतिं संशयं प्रत्यपद्यत॥ ३/२४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.039.m4a", "display_order": 40}, {"id": 6000054040, "chapter_id": 10054, "verse_number": "३-२४-३६", "content_sanskrit": "स तां कृतमलस्नानां विभ्राजन्तीमपूर्ववत्।\nआत्मनो बिभ्रतीं रूपं संवीतरुचिरस्तनम्॥ ३/२४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.040.m4a", "display_order": 41}, {"id": 6000054041, "chapter_id": 10054, "verse_number": "३-२४-३७", "content_sanskrit": "विद्याधरीसहस्रेण सेव्यमानां सुवाससम्।\nजातभावो विमानं तदारोहयदमित्रहन्॥ ३/२४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.041.m4a", "display_order": 42}, {"id": 6000054042, "chapter_id": 10054, "verse_number": "३-२४-३८", "content_sanskrit": "तस्मिन्नलुप्तमहिमा प्रिययाऽनुषक्तो विद्याधरीभिरुपचीर्णवपुर्विमाने।\nबभ्राज उत्कचक उद्गुणपानवीच्यस्ताराभिरावृत इवोडुपतिर्नभस्स्थः॥ ३/२४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.042.m4a", "display_order": 43}, {"id": 6000054043, "chapter_id": 10054, "verse_number": "३-२४-३९", "content_sanskrit": "तेनाष्टलोकपविहारकुलाचलेन्द्रद्रोणीष्वनङ्गसखमारुतसौभगासु।\nसिद्धैर्नुतो द्युधुनिपातशिवस्वनासु रेमे चिरं धनदवल्ललनावरूथी॥ ३/२४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.043.m4a", "display_order": 44}, {"id": 6000054044, "chapter_id": 10054, "verse_number": "३-२४-४०", "content_sanskrit": "वैस्रम्भके सुरवने नन्दने पुष्पभद्रके।\nमानसे चैत्ररथ्ये च स रेमे रामया सह॥ ३/२४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.044.m4a", "display_order": 45}, {"id": 6000054045, "chapter_id": 10054, "verse_number": "३-२४-४१", "content_sanskrit": "भ्राजिष्णुना विमानेन कामगेन महीयसा।\nवैमानिकानत्यशेत चरन् लोकान् यथाऽनिलः॥ ३/२४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.045.m4a", "display_order": 46}, {"id": 6000054046, "chapter_id": 10054, "verse_number": "३-२४-४२", "content_sanskrit": "किं दुरापादनं तेषां पुंसामुद्दामचेतसाम्।\nयैराश्रितस्तीर्थपदश्चरणो व्यसनात्ययः॥ ३/२४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.046.m4a", "display_order": 47}, {"id": 6000054047, "chapter_id": 10054, "verse_number": "३-२४-४३", "content_sanskrit": "प्रेक्षयित्वा भुवो गोलं पत्न्यै यावान् स्वसंस्थया।\nबह्वाश्चर्यं महायोगी स्वाश्रमाय न्यवर्तत॥ ३/२४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.047.m4a", "display_order": 48}, {"id": 6000054048, "chapter_id": 10054, "verse_number": "३-२४-४४", "content_sanskrit": "विभज्य नवधाऽऽत्मानं मानवीं सुरतोत्सुकाम्।\nरामां निरमयन् रेमे वर्षपूगान् मुहूर्तवत्॥ ३/२४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.048.m4a", "display_order": 49}, {"id": 6000054049, "chapter_id": 10054, "verse_number": "३-२४-४५", "content_sanskrit": "तस्मिन् विमान उत्कृष्टां शय्यां रतिकरीं श्रिता।\nन चाबुद्ध्यत तं कालं पत्याऽऽवीच्येन सङ्गता॥ ३/२४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.049.m4a", "display_order": 50}, {"id": 6000054050, "chapter_id": 10054, "verse_number": "३-२४-४६", "content_sanskrit": "एवं योगानुभावेन दम्पत्यो रममाणयोः।\nशतं व्यतीयुः शरदः कामलालसयोर्मनाक्॥ ३/२४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.050.m4a", "display_order": 51}, {"id": 6000054051, "chapter_id": 10054, "verse_number": "३-२४-४७", "content_sanskrit": "तस्यामाधत्त रेतस्तां भावयन्नात्मनाऽऽत्मवित्।\nनवधा विधाय रूपं स्वं सत्यसंकल्पविद् विभुः॥ ३/२४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.051.m4a", "display_order": 52}, {"id": 6000054052, "chapter_id": 10054, "verse_number": "३-२४-४८", "content_sanskrit": "ततः सा सुषुवे सद्यो देवहूतिः स्‍त्रियः प्रजाः।\nसर्वास्ताश्चारुसर्वाङ्ग्यो लोहितोत्पलगन्धयः॥ ३/२४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.052.m4a", "display_order": 53}, {"id": 6000054053, "chapter_id": 10054, "verse_number": "३-२४-४९", "content_sanskrit": "पतिं सा प्रव्रजिष्यन्तं तदाऽऽलक्ष्योशती सती।\nस्मयमाना विक्लवेन हृदयेन विदूयता॥ ३/२४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.053.m4a", "display_order": 54, "topics": [{"text": "ततः प्रव्रजिष्यन्तं तमृषिं विज्ञाय देवहूत्या पुमपत्योत्पादनप्रार्थना", "range": "४९–५७"}]}, {"id": 6000054054, "chapter_id": 10054, "verse_number": "३-२४-५०", "content_sanskrit": "लिखन्त्यधोमुखी भूमिं पदा नखमणिश्रिया।\nउवाच ललितां वाचं निरुध्याश्रुकलां शनैः॥ ३/२४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.054.m4a", "display_order": 55}, {"id": 6000054055, "chapter_id": 10054, "verse_number": "३-२४-५१", "content_sanskrit": "सर्वं तद् भगवान् मह्यमुपोवाह प्रतिश्रुतम्।\nअथापि मे प्रपन्नाया अभयं दातुमर्हसि॥ ३/२४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.055.m4a", "display_order": 56}, {"id": 6000054056, "chapter_id": 10054, "verse_number": "३-२४-५२", "content_sanskrit": "ब्रह्मन् दुहितृभिस्तुभ्यं विमृश्याः पतयः समाः।\nअपि स्यान्मे विशोकाय त्वयि प्रव्रजिते वनम्॥ ३/२४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.056.m4a", "display_order": 57}, {"id": 6000054057, "chapter_id": 10054, "verse_number": "३-२४-५३", "content_sanskrit": "एतावताऽलं कालेन व्यतिक्रान्तेन मे प्रभो।\nइन्द्रियार्थप्रसङ्गेन परित्यक्तपरात्मनः॥ ३/२४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.057.m4a", "display_order": 58}, {"id": 6000054058, "chapter_id": 10054, "verse_number": "३-२४-५४", "content_sanskrit": "इन्द्रियार्थेषु सज्जन्त्या प्रसङ्गस्त्वयि मे कृतः।\nअजानन्त्या परं भावं तथाऽप्यस्त्वभवाय मे॥ ३/२४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.058.m4a", "display_order": 59}, {"id": 6000054059, "chapter_id": 10054, "verse_number": "३-२४-५५", "content_sanskrit": "संयोगः संसृतेर्हेतुरसत्सु विहितो धिया।\nस एव साधुषु कृतो निःसङ्गत्वाय कल्पते॥ ३/२४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.059.m4a", "display_order": 60}, {"id": 6000054060, "chapter_id": 10054, "verse_number": "३-२४-५६", "content_sanskrit": "नेह यत् कर्म धर्माय न विरागाय कल्पते।\nन तीर्थपदसेवायै जीवन्नपि मृतो हि सः॥ ३/२४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.060.m4a", "display_order": 61}, {"id": 6000054061, "chapter_id": 10054, "verse_number": "३-२४-५७", "content_sanskrit": "साऽहं भगवतो नूनं वञ्चिता मायया दृढम्।\nया त्वां विमुक्तिदं प्राप्य न मुमुक्षे ह बन्धनात्॥ ३/२४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_024/BhP_03.024.061.m4a", "display_order": 62}, {"id": 6000054062, "chapter_id": 10054, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे चतुर्विंशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]