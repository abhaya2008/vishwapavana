[{"id": 2008179, "chapter_id": 1158, "verse_number": "१-१५९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008180, "chapter_id": 1158, "verse_number": "१-१५९-१", "content_sanskrit": "विदुरस्य सुहृत्कश्चित्खनकः कुशलः क्वचित्।\nविविक्ते पाण्डवान्राजन्निदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008181, "chapter_id": 1158, "verse_number": "१-१५९-२", "content_sanskrit": "प्रहितो विदुरेणास्मि खनकः कुशलो ह्यहम्।\nपाण्डवानां प्रियं कार्यमिति किं करवाणि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008182, "chapter_id": 1158, "verse_number": "१-१५९-३", "content_sanskrit": "प्रच्छन्नं विदुरेणोक्तं प्रियं यन्म्लेच्छभाषया।\nत्वया च तत्तथेत्युक्तमेतद्विश्वासकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008183, "chapter_id": 1158, "verse_number": "१-१५९-४", "content_sanskrit": "कृष्णपक्षे चतुर्दश्यां रात्रावस्यां पुरोचनः।\nभवनस्य तव द्वारि प्रदास्यति हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008184, "chapter_id": 1158, "verse_number": "१-१५९-५", "content_sanskrit": "मात्रा सह प्रदग्धव्याः पाण्डवाः पुरुषर्षभाः।\nइति व्यवसितं तस्य धार्तराष्ट्रस्य दुर्मतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008185, "chapter_id": 1158, "verse_number": "१-१५९-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008186, "chapter_id": 1158, "verse_number": "१-१५९-६", "content_sanskrit": "उवाच तं सत्यधृतिः कुन्तीपुत्रो युधिष्ठिरः।\nअभिजानामि सौम्य त्वां सुहृदं विदुरस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008187, "chapter_id": 1158, "verse_number": "१-१५९-७", "content_sanskrit": "शुचिमाप्तं प्रियं चैव सदा च दृढभक्तिकम्।\nन विद्यते कवेः किंचिदविज्ञातं प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008188, "chapter_id": 1158, "verse_number": "१-१५९-८", "content_sanskrit": "यथा तस्य तथा नस्त्वं निर्विशेषा वयं त्वयि।\nभवतश्च यथा तस्य पालयास्मान्यथा कविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008189, "chapter_id": 1158, "verse_number": "१-१५९-९", "content_sanskrit": "इदं शरणमाग्नेयं मदर्थमिति मे मतिः।\nपुरोचनेन विहितं धार्तराष्ट्रस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008190, "chapter_id": 1158, "verse_number": "१-१५९-१०", "content_sanskrit": "स पापः कोशवांश्चैव ससहायश्च दुर्मतिः।\nअस्मानपि च पापात्मा नित्यकालं प्रबाधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008191, "chapter_id": 1158, "verse_number": "१-१५९-११", "content_sanskrit": "स भवान्भोक्षयत्वस्मान्यत्नेनास्माद्धुताशनात्।\nअस्मास्विह हि दग्धेषु सकामः स्यात्सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008192, "chapter_id": 1158, "verse_number": "१-१५९-१२", "content_sanskrit": "समृद्धमायुधागारमिदं तस्य दुरात्मनः।\nवप्रान्तं निष्प्रतीकारमाश्रित्येदं कृतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008193, "chapter_id": 1158, "verse_number": "१-१५९-१३", "content_sanskrit": "इदं तदशुभं नूनं तस्य कर्म चिकीर्षितम्।\nप्रागेव विदुरो वेद तेनास्मानन्वबोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008194, "chapter_id": 1158, "verse_number": "१-१५९-१४", "content_sanskrit": "सेयमापदनुप्राप्ता क्षत्ता यां दृष्टवान्पुरा।\nपुरोचनस्याविदितानस्मांस्त्वं प्रतिमोचय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008195, "chapter_id": 1158, "verse_number": "१-१५९-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008196, "chapter_id": 1158, "verse_number": "१-१५९-१५", "content_sanskrit": "स तथेति प्रतिश्रुत्य खनको यत्नमास्थितः।\nपरिखामुत्किरन्नाम चकार च महाबिलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008197, "chapter_id": 1158, "verse_number": "१-१५९-१६", "content_sanskrit": "चक्रे च वेश्मनस्तस्य मध्ये नातिमहद्बिलम्।\nकपाटयुक्तमज्ञातं समं भूम्याश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008198, "chapter_id": 1158, "verse_number": "१-१५९-१७", "content_sanskrit": "पुरोचनभयादेव व्यदधात्संवृतं मुखम्।\nस तस्य तु गृहद्वारि वसत्यशुभधीः सदा।\nतत्र ते सायुधाः सर्वे वसन्ति स्म क्षपां नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008199, "chapter_id": 1158, "verse_number": "१-१५९-१८", "content_sanskrit": "दिवा चरन्ति मृगयां पाण्डवेया वनाद्वनम्।\nविश्वस्तवदविश्वस्ता वञ्चयन्तः पुरोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008200, "chapter_id": 1158, "verse_number": "१-१५९-१९", "content_sanskrit": "अतुष्टास्तुष्टवद्राजन्नूषुः परमविस्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008201, "chapter_id": 1158, "verse_number": "१-१५९-२०", "content_sanskrit": "न चैनानन्वबुध्यन्त नरा नगरवासिनः।\nअन्यत्र विदुरामात्यात्तस्मात्खनकसत्तमात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008202, "chapter_id": 1158, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि ऊनषष्ट्यधिकशततमोऽध्यायः॥ १५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]