[{"id": 2100247, "chapter_id": 3149, "verse_number": "१४-५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nपथंवीर्यः समभवत्स राजा ददतांवरः।\nकथं च जातरूपेण समयुज्यत वै नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100248, "chapter_id": 3149, "verse_number": "१४-५-२", "content_sanskrit": "क्व च तत्सांप्रतं द्रव्यं भगवन्नवतिष्ठते।\nकथं च शक्यमस्माभिस्तदवाप्नुं तचपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100249, "chapter_id": 3149, "verse_number": "१४-५-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100250, "chapter_id": 3149, "verse_number": "१४-५-३", "content_sanskrit": "असुराश्चैव देवाश्च दक्षस्यासन्प्रजापतेः।\nअपत्यं बहुलं तात तेऽस्पर्धन्त परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100251, "chapter_id": 3149, "verse_number": "१४-५-४", "content_sanskrit": "तथैवाङ्गिरसः पुत्रौ पितृतुल्यौ बभूवतुः।\nबृहस्पतिर्बृहत्तेजाः संवर्तश्च तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100252, "chapter_id": 3149, "verse_number": "१४-५-५", "content_sanskrit": "तावति स्पर्धिनौ राजन्पृथगास्तां परस्परम्।\nबृहस्पतिः स संवर्तं बाधते स्म पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100253, "chapter_id": 3149, "verse_number": "१४-५-६", "content_sanskrit": "स बाध्यमानः सततं भ्रात्रा ज्येष्ठेन भारत।\nअर्थानुत्सृज्य दिग्वासा वने वासमरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100254, "chapter_id": 3149, "verse_number": "१४-५-७", "content_sanskrit": "वासवोऽप्यसुरान्सर्वान्विजित्य च निपात्य च।\nइन्द्रत्वं प्राप्य लोकेषु ततो वव्रे पुरोहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100255, "chapter_id": 3149, "verse_number": "१४-५-८", "content_sanskrit": "पुत्रमङ्गिरसो ज्येष्ठं विप्रज्येष्ठं बृहस्पतिम्।\nयाज्यस्त्वङ्गिरसः पूर्वमासीद्राजा करंधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100256, "chapter_id": 3149, "verse_number": "१४-५-९", "content_sanskrit": "वीर्येणाप्रतिमो लोके वृत्तेन च बलेन च।\nशतक्रतुरिवौजस्वी धर्मात्मा संशितव्रतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100257, "chapter_id": 3149, "verse_number": "१४-५-१०", "content_sanskrit": "वाहनं यस्य योधाश्च मित्राणि विविधानि च।\nशयनानि च मुख्यानि महार्हाणि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100258, "chapter_id": 3149, "verse_number": "१४-५-११", "content_sanskrit": "ध्यानादेवाभवद्राजन्मुखवातेन सर्वशः।\nस गुणैः पार्थिवान्सर्वान्वशे चक्रे नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100259, "chapter_id": 3149, "verse_number": "१४-५-१२", "content_sanskrit": "संजीव्य कालमिष्टं च सशरीरो दिवं गतः।\nबभूव तस्य पुत्रस्तु ययातिरिव धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100260, "chapter_id": 3149, "verse_number": "१४-५-१३", "content_sanskrit": "अविक्षिन्नाम शत्रुंजित्स वशे कृतवान्महीम्।\nविक्रमेण गुणैश्चैव पितेवासीत्स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100261, "chapter_id": 3149, "verse_number": "१४-५-१४", "content_sanskrit": "तस्य वासवतुल्योऽभून्मरुत्तो नाम वीर्यवान्।\nपुत्रस्तमनुरक्ताऽभूत्पृथिवी सागराम्बरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100262, "chapter_id": 3149, "verse_number": "१४-५-१५", "content_sanskrit": "स्पर्धते स स्म सततं देवराजेन नित्यदा।\nवासवोऽपि मरुत्तेनि स्पर्धते पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100263, "chapter_id": 3149, "verse_number": "१४-५-१६", "content_sanskrit": "शुचिः स गुणवानासीन्मरुत्तः पृथिवीपतिः।\nयतमानोपि यं शक्रो न विशेषयति स्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100264, "chapter_id": 3149, "verse_number": "१४-५-१७", "content_sanskrit": "सोऽशक्नुवन्विशेषाय समाहूय बृहस्पतिम्।\nउवाचेदं वचो देवैः सहितो हरिवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100265, "chapter_id": 3149, "verse_number": "१४-५-१८", "content_sanskrit": "बृहस्पते मरुत्तस्य मा स्म कार्षीः कथञ्चन।\nदैवं कर्माथ पित्र्यं वा कर्तासि मम चेत्प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100266, "chapter_id": 3149, "verse_number": "१४-५-१९", "content_sanskrit": "अहं हि त्रिषु लोकेषु सुराणां च बृहस्पते।\nइन्द्रत्वं प्राप्तवानेको मरुत्तस्तु महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100267, "chapter_id": 3149, "verse_number": "१४-५-२०", "content_sanskrit": "कथं ह्यमर्त्यं ब्रह्मंस्त्वं याजयित्वा सुराधिपम्।\nयाजयेर्मृत्युसंयुक्तं मरुत्तमविशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100268, "chapter_id": 3149, "verse_number": "१४-५-२१", "content_sanskrit": "मां वा वृणीष्व भद्रं ते मरुत्तं वा महीपतिम्।\nपरित्यज्य मरुत्तं वा यथाजोषं भजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100269, "chapter_id": 3149, "verse_number": "१४-५-२२", "content_sanskrit": "एवमुक्तः स करकव्य देवराज्ञा बृहस्पतिः।\nमुहूर्तमिव सञ्चिन्त्य देवराजानमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100270, "chapter_id": 3149, "verse_number": "१४-५-२३", "content_sanskrit": "त्वं भूतानामधिपतिस्त्वयि लोकाः प्रतिष्ठिताः।\nनमुचेर्विश्वरूपस्य निहन्ता त्वं बलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100271, "chapter_id": 3149, "verse_number": "१४-५-२४", "content_sanskrit": "त्वमाजहर्थ् देवानामेको वीरश्रियं पराम्।\nत्वं बिभर्षि भुवं द्यां च सदैव बलसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100272, "chapter_id": 3149, "verse_number": "१४-५-२५", "content_sanskrit": "परोहित्यं कथं कृत्वा तव देवगणेश्वर।\nयाजयेयमहं मर्त्यं मरुत्तं पाकशासन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100273, "chapter_id": 3149, "verse_number": "१४-५-२६", "content_sanskrit": "समाश्वसिहि देवेन्द्र नाहं मर्त्यस्य कर्हिचित्।\nग्रहीष्यामि स्रुवं यज्ञे शृणु चेदं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100274, "chapter_id": 3149, "verse_number": "१४-५-२७", "content_sanskrit": "हिरण्यरेता नोष्णः स्यात्परिवर्तेत मेदिनी।\nभासं तु न रविः कुर्यान्न तु सत्यं चलेन्मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100275, "chapter_id": 3149, "verse_number": "१४-५-२८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100276, "chapter_id": 3149, "verse_number": "१४-५-२८", "content_sanskrit": "बृहस्पतिवचःक श्रुत्वा शक्रो विगतमत्सरः।\nप्रशस्यैनं विवेशाथ स्वमेव भवनं तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100277, "chapter_id": 3149, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि पञ्चमोऽध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]