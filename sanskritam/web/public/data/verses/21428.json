[{"id": 7001428000, "chapter_id": 21428, "verse_number": "७-१-१-१", "content_sanskrit": "व्यास उवाच ।\nनमश्शिवाय सोमाय सगणाय ससूनवे ।\nप्रधानपुरुषेशाय सर्गस्थित्यंतहेतवे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001428001, "chapter_id": 21428, "verse_number": "७-१-१-२", "content_sanskrit": "शक्तिरप्रतिमा यस्य ह्यैश्वर्यं चापि सर्वगम् ।\nस्वामित्वं च विभुत्वं च स्वभावं संप्रचक्षते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001428002, "chapter_id": 21428, "verse_number": "७-१-१-३", "content_sanskrit": "तमजं विश्वकर्माणं शाश्वतं शिवमव्ययम् ।\nमहादेवं महात्मानं व्रजामि शरणं शिवम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001428003, "chapter_id": 21428, "verse_number": "७-१-१-४", "content_sanskrit": "धर्मक्षेत्रे महातीर्थे गंगाकालिंदिसंगमे ।\nप्रयागे नैमिषारण्ये ब्रह्मलोकस्य वर्त्मनि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001428004, "chapter_id": 21428, "verse_number": "७-१-१-५", "content_sanskrit": "मुनयश्शंसितात्मानः सत्यव्रतपरायणाः ।\nमहौजसो महाभागा महासत्रं वितेनिरे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001428005, "chapter_id": 21428, "verse_number": "७-१-१-६", "content_sanskrit": "तत्र सत्रं समाकर्ण्य तेषामक्लिष्टकर्मणाम् ।\nसाक्षात्सत्यवतीसूनोर्वेदव्यासस्य धीमतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001428006, "chapter_id": 21428, "verse_number": "७-१-१-७", "content_sanskrit": "शिष्यो महात्मा मेधावी त्रिषु लोकेषु विश्रुतः ।\nपञ्चावयवयुक्तस्य वाक्यस्य गुणदोषवित्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001428007, "chapter_id": 21428, "verse_number": "७-१-१-८", "content_sanskrit": "उत्तरोत्तरवक्ता च ब्रुवतो ऽपि बृहस्पतेः ।\nमधुरः श्रवणानां च मनोज्ञपदपर्वणाम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001428008, "chapter_id": 21428, "verse_number": "७-१-१-९", "content_sanskrit": "कथानां निपुणो वक्ता कालविन्नयवित्कविः ।\nआजगाम स तं देशं सूतः पौराणिकोत्तमः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001428009, "chapter_id": 21428, "verse_number": "७-१-१-१०", "content_sanskrit": "तं दृष्ट्वा सूतमायांतं मुनयो हृष्टमानसाः ।\nतस्मै साम च पूजां च यथावत्प्रत्यपादयन्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001428010, "chapter_id": 21428, "verse_number": "७-१-१-११", "content_sanskrit": "प्रतिगृह्य सतां पूजां मुनिभिः प्रतिपादिताम् ।\nउद्दिष्टमानसं भेजे नियुक्तो युक्तमात्मनः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001428011, "chapter_id": 21428, "verse_number": "७-१-१-१२", "content_sanskrit": "ततस्तत्संगमादेव मुनीनां भावितात्मनाम् ।\nसोत्कंठमभवच्चितं श्रोतुं पौराणिकीं कथाम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001428012, "chapter_id": 21428, "verse_number": "७-१-१-१३", "content_sanskrit": "तदा तमनुकूलाभिर्वाग्भिः पूज्य १ महर्षयः ।\nअतीवाभिमुखं कृत्वा वचनं चेदमब्रुवन्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001428013, "chapter_id": 21428, "verse_number": "७-१-१-१४", "content_sanskrit": "ऋषय ऊचुः ।\nरोमहर्षण सर्वज्ञ भवान्नो भाग्यगौरवात् ।\nसंप्राप्तोद्य महाभाग शैवराज महामते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001428014, "chapter_id": 21428, "verse_number": "७-१-१-१५", "content_sanskrit": "पुराणविद्यामखिलां व्यासात्प्रत्यक्षमीयिवान् ।\nतस्मादाश्चर्यभूतानां कथानां त्वं हि भाजनम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001428015, "chapter_id": 21428, "verse_number": "७-१-१-१६", "content_sanskrit": "रत्नानामुरुसाराणां रत्नाकर इवार्णवः ।\nयच्च भूतं यच्च भव्यं यच्चान्यद्वस्तु वर्तते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001428016, "chapter_id": 21428, "verse_number": "७-१-१-१७", "content_sanskrit": "न तवाविदितं किञ्चित्त्रिषु लोकेषु विद्यते ।\nत्वमदृष्टवशादस्मद्दर्शनार्थमिहागतः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001428017, "chapter_id": 21428, "verse_number": "७-१-१-१८", "content_sanskrit": "अकुर्वन्किमपि श्रेयो न वृथा गन्तुमर्हसि ।\nतस्माच्छ्राव्यतरं पुण्यं सत्कथाज्ञानसंहितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001428018, "chapter_id": 21428, "verse_number": "७-१-१-१९", "content_sanskrit": "वेदांतसारसर्वस्वं पुराणं श्रावयाशु नः ।\nएवमभ्यर्थितस्सूतो मुनिभिर्वेदवादिभिः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001428019, "chapter_id": 21428, "verse_number": "७-१-१-२०", "content_sanskrit": "श्लक्ष्णां च न्यायसंयुक्तां प्रत्युवाच शुभां गिरम् ।\nसूत उवाच ।\nपूजितो ऽनुगृहीतश्च भवद्भिरिति चोदितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001428020, "chapter_id": 21428, "verse_number": "७-१-१-२१", "content_sanskrit": "कस्मात्सम्यङ्न विब्रूयां पुराणमृषिपूजितम् ।\nअभिवंद्य महादेवं देवीं स्कंदं विनायकम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001428021, "chapter_id": 21428, "verse_number": "७-१-१-२२", "content_sanskrit": "नंदिनं च तथा व्यासं साक्षात्सत्यवतीसुतम् ।\nवक्ष्यामि परमं पुण्यं पुराणं वेदसंमितम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001428022, "chapter_id": 21428, "verse_number": "७-१-१-२३", "content_sanskrit": "शिवज्ञानार्णवं साक्षाद्भक्तिमुक्तिफलप्रदम् ।\nशब्दार्थन्यायसंयुक्तै रागमार्थैर्विभूषितम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001428023, "chapter_id": 21428, "verse_number": "७-१-१-२४", "content_sanskrit": "श्वेतकल्पप्रसंगेन वायुना कथितं पुरा ।\nविद्यास्थानानि सर्वाणि पुराणानुक्रमं तथा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001428024, "chapter_id": 21428, "verse_number": "७-१-१-२५", "content_sanskrit": "तत्पुराणस्य चोत्पत्तिं ब्रुवतो मे निबोधत ।\nअंगानि वेदाश्चत्वारो मीमांसान्यायविस्तरः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001428025, "chapter_id": 21428, "verse_number": "७-१-१-२६", "content_sanskrit": "पुराणं धर्मशास्त्रं च विद्याश्चेताश्चतुर्दश ।\nआयुर्वेदो धनुर्वेदो गांधर्वश्चेत्यनुक्रमात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001428026, "chapter_id": 21428, "verse_number": "७-१-१-२७", "content_sanskrit": "अर्थशास्त्रं परं तस्माद्विद्या ह्यष्टादश स्मृताः ।\nअष्टादशानां विद्यानामेतासां भिन्नवर्त्मनाम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001428027, "chapter_id": 21428, "verse_number": "७-१-१-२८", "content_sanskrit": "आदिकर्ता कविस्साक्षाच्छूलपाणिरिति श्रुतिः ।\nस हि सर्वजगन्नाथः सिसृक्षुरखिलं जगत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001428028, "chapter_id": 21428, "verse_number": "७-१-१-२९", "content_sanskrit": "ब्रह्माणं विदधे साक्षात्पुत्रमग्रे सनातनम् ।\nतस्मै प्रथमपुत्राय ब्रह्मणे विश्वयोनये॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001428029, "chapter_id": 21428, "verse_number": "७-१-१-३०", "content_sanskrit": "विद्याश्चेमा ददौ पूर्वं विश्वसृष्ट्यर्थमीश्वरः ।\nपालनाय हरिं देवं रक्षाशक्तिं ददौ ततः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001428030, "chapter_id": 21428, "verse_number": "७-१-१-३१", "content_sanskrit": "मध्यमं तनयं विष्णुं पातारं ब्रह्मणो ऽपि हि ।\nलब्धविद्येन विधिना प्रजासृष्टिं वितन्वता॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001428031, "chapter_id": 21428, "verse_number": "७-१-१-३२", "content_sanskrit": "प्रथमं सर्वशास्त्राणां पुराणं ब्रह्मणा स्मृतम् ।\nअनंतरं तु वक्त्रेभ्यो वेदास्तस्य विनिर्गताः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001428032, "chapter_id": 21428, "verse_number": "७-१-१-३३", "content_sanskrit": "प्रवृत्तिस्सर्वशास्त्राणां तन्मुखादभवत्ततः ।\nयदास्य विस्तरं शक्ता नाधिगंतुं प्रजा भुवि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001428033, "chapter_id": 21428, "verse_number": "७-१-१-३४", "content_sanskrit": "तदा विद्यासमासार्थं विश्वेश्वरनियोगतः ।\nद्वापरांतेषु विश्वात्मा विष्णुर्विश्वंभरः प्रभुः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001428034, "chapter_id": 21428, "verse_number": "७-१-१-३५", "content_sanskrit": "व्यासनाम्ना चरत्यस्मिन्नवतीर्य महीतले ।\nएवं व्यस्ताश्च वेदाश्च द्वापरेद्वापरे द्विजाः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001428035, "chapter_id": 21428, "verse_number": "७-१-१-३६", "content_sanskrit": "निर्मितानि पुराणानि अन्यानि च ततः परम् ।\nस पुनर्द्वापरे चास्मिन्कृष्णद्वैपायनाख्यया॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001428036, "chapter_id": 21428, "verse_number": "७-१-१-३७", "content_sanskrit": "अरण्यामिव हव्याशी सत्यवत्यामजायत ।\nसंक्षिप्य स पुनर्वेदांश्चतुर्धा कृतवान्मुनिः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001428037, "chapter_id": 21428, "verse_number": "७-१-१-३८", "content_sanskrit": "व्यस्तवेदतया लोके वेदव्यास इति श्रुतः ।\nपुराणानाञ्च संक्षिप्तं चतुर्लक्षप्रमाणतः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001428038, "chapter_id": 21428, "verse_number": "७-१-१-३९", "content_sanskrit": "अद्यापि देवलोके तच्छतकोटिप्रविस्तरम् ।\nयो विद्याच्चतुरो वेदान् सांगोपणिषदान्द्विजः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001428039, "chapter_id": 21428, "verse_number": "७-१-१-४०", "content_sanskrit": "न चेत्पुराणं संविद्यान्नैव स स्याद्विचक्षणः ।\nइतिहासपुराणाभ्यां वेदं समुपबृंहयेत्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001428040, "chapter_id": 21428, "verse_number": "७-१-१-४१", "content_sanskrit": "बिभेत्यल्पश्रुताद्वेदो मामयं प्रतरिष्यति ।\nसर्गश्च प्रतिसर्गश्च वंशो मन्वंतराणि च॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001428041, "chapter_id": 21428, "verse_number": "७-१-१-४२", "content_sanskrit": "वंशानुचरितं चैव पुराणं पञ्चलक्षणम् ।\nदशधा चाष्टधा चैतत्पुराणमुपदिश्यते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001428042, "chapter_id": 21428, "verse_number": "७-१-१-४३", "content_sanskrit": "बृहत्सूक्ष्मप्रभेदेन मुनिभिस्तत्त्ववित्तमैः ।\nब्राह्मं पाद्मं वैष्णवं च शैवं भागवतं तथा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001428043, "chapter_id": 21428, "verse_number": "७-१-१-४४", "content_sanskrit": "भविष्यं नारदीयं च मार्कंडेयमतः परम् ।\nआग्नेयं ब्रह्मवैवर्तं लैंगं वाराहमेव च॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001428044, "chapter_id": 21428, "verse_number": "७-१-१-४५", "content_sanskrit": "स्कान्दं च वामनं चैव कौर्म्यं मात्स्यं च गारुडम् ।\nब्रह्मांडं चेति पुण्यो ऽयं पुराणानामनुक्रमः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001428045, "chapter_id": 21428, "verse_number": "७-१-१-४६", "content_sanskrit": "तत्र शैवं तुरीयं यच्छार्वं सर्वार्थसाधकम् ।\nग्रंथो लक्षप्रमाणं तद्व्यस्तं द्वादशसंहितम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001428046, "chapter_id": 21428, "verse_number": "७-१-१-४७", "content_sanskrit": "निर्मितं तच्छिवेनैव तत्र धर्मः प्रतिष्ठितः ।\nतदुक्तेनैव धर्मेण शैवास्त्रैवर्णिका नराः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001428047, "chapter_id": 21428, "verse_number": "७-१-१-४८", "content_sanskrit": "तस्माद्विमुकुतिमन्विच्छञ्च्छिवमेव समाश्रयेत् ।\nतमाश्रित्यैव देवानामपि मुक्तिर्न चान्यथा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001428048, "chapter_id": 21428, "verse_number": "७-१-१-४९", "content_sanskrit": "यदिदं शैवमाख्यातं पुराणं वेदसंमितम् ।\nतस्य भेदान्समासेन ब्रुवतो मे निबोधत॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001428049, "chapter_id": 21428, "verse_number": "७-१-१-५०", "content_sanskrit": "विद्येश्वरं तथा रौद्रं वैनायकमनुत्तमम् ।\nऔमं मातृपुराणं च रुद्रैकादशकं तथा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001428050, "chapter_id": 21428, "verse_number": "७-१-१-५१", "content_sanskrit": "कैलासं शतरुद्रं च शतरुद्राख्यमेव च ।\nसहस्रकोटिरुद्राख्यं वायवीयं ततःपरम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001428051, "chapter_id": 21428, "verse_number": "७-१-१-५२", "content_sanskrit": "धर्मसंज्ञं पुराणं चेत्येवं द्वादश संहिताः ।\nविद्येशं दशसाहस्रमुदितं ग्रंथसंख्यया॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001428052, "chapter_id": 21428, "verse_number": "७-१-१-५३", "content_sanskrit": "रौद्रं वैनायकं चौमं मातृकाख्यं ततः परम् ।\nप्रत्येकमष्टसाहस्रं त्रयोदशसहस्रकम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001428053, "chapter_id": 21428, "verse_number": "७-१-१-५४", "content_sanskrit": "रौद्रकादशकाख्यं यत्कैलासं षट्सहस्रकम् ।\nशतरुद्रं त्रिसाहस्रं कोटिरुद्रं ततः परम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001428054, "chapter_id": 21428, "verse_number": "७-१-१-५५", "content_sanskrit": "सहस्रैर्नवभिर्युक्तं सर्वार्थज्ञानसंयुतम् ।\nसहस्रकोटिरुद्राख्यमेकादशसहस्रकम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001428055, "chapter_id": 21428, "verse_number": "७-१-१-५६", "content_sanskrit": "चतुस्सहस्रसंख्येयं वायवीयमनुत्तमम् ।\nधर्मसंज्ञं पुराणं यत्तद्द्वादशसहस्रकम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001428056, "chapter_id": 21428, "verse_number": "७-१-१-५७", "content_sanskrit": "तदेवं लक्षमुद्दिष्टं शैवं शाखाविभेदतः ।\nपुराणं वेदसारं तद्भुक्तिमुक्तिफलप्रदम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001428057, "chapter_id": 21428, "verse_number": "७-१-१-५८", "content_sanskrit": "व्यासेन तत्तु संक्षिप्तं चतुर्विंशत्सहस्रकम् ।\nशैवन्तत्र पुराणं वै चतुर्थं सप्तसंहितम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001428058, "chapter_id": 21428, "verse_number": "७-१-१-५९", "content_sanskrit": "विद्येश्वराख्या तत्राद्या द्वितीया रुद्रसंहिता ।\nतृतीया शतरुद्राख्या कोटिरुद्रा चतुर्थिका॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001428059, "chapter_id": 21428, "verse_number": "७-१-१-६०", "content_sanskrit": "पञ्चमी कथिता चोमा षष्ठी कैलाससंहिता ।\nसप्तमी वायवीयाख्या सप्तैवं संहिता इह॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001428060, "chapter_id": 21428, "verse_number": "७-१-१-६१", "content_sanskrit": "विद्येश्वरं द्विसाहस्रं रौद्रं पञ्चशतायुतम् ।\nत्रिंशत्तथा द्विसाहस्रं सार्धैकशतमीरितम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001428061, "chapter_id": 21428, "verse_number": "७-१-१-६२", "content_sanskrit": "शतरुद्रन्तथा कोटिरुद्रं व्योमयुगाधिकम् ।\nद्विसाहस्रं च द्विशतं तथोमं भूसहस्रकम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001428062, "chapter_id": 21428, "verse_number": "७-१-१-६३", "content_sanskrit": "चत्वारिंशत्साष्टशतं कैलासं भूसहस्रकम् ।\nचत्वारिंशच्च द्विशतं वायवीयमतः परम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001428063, "chapter_id": 21428, "verse_number": "७-१-१-६४", "content_sanskrit": "चतुस्साहस्रसंख्याकमेवं संख्याविभेदतः ।\nश्रुतम्परमपुण्यन्तु पुराणं शिवसंज्ञकम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001428064, "chapter_id": 21428, "verse_number": "७-१-१-६५", "content_sanskrit": "चतुःसाहस्रकं यत्तु वायवीयमुदीरितम् ।\nतदिदं वर्तयिष्यामि भागद्वयसमन्वितम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001428065, "chapter_id": 21428, "verse_number": "७-१-१-६६", "content_sanskrit": "नावेदविदुषे वाच्यमिदं शास्त्रमनुत्तमम् ।\nन चैवाश्रद्धधानाय नापुराणविदे तथा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001428066, "chapter_id": 21428, "verse_number": "७-१-१-६७", "content_sanskrit": "परीक्षिताय शिष्याय धार्मिकायानसूयवे ।\nप्रदेयं शिवभक्ताय शिवधर्मानुसारिणे॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001428067, "chapter_id": 21428, "verse_number": "७-१-१-६८", "content_sanskrit": "पुराणसंहिता यस्य प्रसादान्मयि वर्तते ।\nनमो भगवते तस्मै व्यासायामिततेजसे॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]