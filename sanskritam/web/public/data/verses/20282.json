[{"id": 7000282000, "chapter_id": 20282, "verse_number": "१-३६-१", "content_sanskrit": "पुलस्त्य उवाच ।\nततो देवाः प्रयातास्ते विमानैर्बहुभिस्तदा ।\nरामोप्यनुजगामाशु कुंभयोनेस्तपोवनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000282001, "chapter_id": 20282, "verse_number": "१-३६-२", "content_sanskrit": "उक्तं भगवता तेन भूयोप्यागमनं क्रियाः ।\nपूर्वमेव सभायां च यो मां द्रष्टुं समागतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000282002, "chapter_id": 20282, "verse_number": "१-३६-३", "content_sanskrit": "तदहं देवतादेशात्तत्कार्यार्थे महामुनिं ।\nपश्यामि तं मुनिं गत्वा देवदानवपूजितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000282003, "chapter_id": 20282, "verse_number": "१-३६-४", "content_sanskrit": "उपदेशं च मे तुष्टः स्वयं दास्यति सत्तमः ।\nदुःखी येन पुनर्मर्त्ये न भवामि कदाचन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000282004, "chapter_id": 20282, "verse_number": "१-३६-५", "content_sanskrit": "पिता दशरथो मह्यं कौसल्या जननी तथा ।\nसूर्यवंशे समुत्पन्नस्तथाप्येवं सुदुःखितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000282005, "chapter_id": 20282, "verse_number": "१-३६-६", "content_sanskrit": "राज्यकाले वने वासो भार्यया चानुजेन च ।\nहरणं चापि भार्याया रावणेन कृतं मम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000282006, "chapter_id": 20282, "verse_number": "१-३६-७", "content_sanskrit": "असहायेन तु मया तीर्त्वा सागरमुत्तमम् ।\nरुद्ध्वा तु तां पुरीं सर्वां कृत्वा तस्य कुलक्षयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000282007, "chapter_id": 20282, "verse_number": "१-३६-८", "content_sanskrit": "दृष्टा सीता मया त्यक्ता देवानां तु पुरस्तदा ।\nशुद्धां तां मां तथोचुस्ते मया सीता तथा गृहम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000282008, "chapter_id": 20282, "verse_number": "१-३६-९", "content_sanskrit": "समानीता प्रीतिमता लोकवाक्याद्विसर्जिता ।\nवने वसति सा देवी पुरे चाहं वसामि वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000282009, "chapter_id": 20282, "verse_number": "१-३६-१०", "content_sanskrit": "जातोहमुत्तमे वंशे उत्तमोहं धनुष्मताम् ।\nउत्तमं दुःखमापन्नो हृदयं नैव भिद्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000282010, "chapter_id": 20282, "verse_number": "१-३६-११", "content_sanskrit": "वज्रसारस्य सारेण धात्राहं निर्मितो ध्रुवम् ।\nइदानीं ब्राह्मणादेशाद्भ्रमामि धरणीतले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000282011, "chapter_id": 20282, "verse_number": "१-३६-१२", "content_sanskrit": "तपः स्थितस्तु शूद्रोसौ मया पापो निपातितः ।\nदेववाक्यात्तु मे भूयः प्राणो मे हृदि संस्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000282012, "chapter_id": 20282, "verse_number": "१-३६-१३", "content_sanskrit": "पश्यामि तं मुनिं वंद्यं जगतोस्य हिते रतम् ।\nदृष्टेन मे तथा दुःखं नाशमेष्यति सत्वरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000282013, "chapter_id": 20282, "verse_number": "१-३६-१४", "content_sanskrit": "उदयेन सहस्रांशोर्हिमं यद्वद्विलीयते ।\nतद्वन्मे दुःखसंप्राप्तिः सर्वथा नाशमेष्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000282014, "chapter_id": 20282, "verse_number": "१-३६-१५", "content_sanskrit": "दृष्ट्वा च देवान्संप्राप्तानगस्त्यो भगवानृषिः ।\nअर्घ्यमादाय सुप्रीतः सर्वांस्तानभ्यपूजयत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000282015, "chapter_id": 20282, "verse_number": "१-३६-१६", "content_sanskrit": "ते तु गृह्य ततः पूजां संभाष्य च महामुनिं ।\nजग्मुस्तेन तदा हृष्टा नाकपृष्ठं सहानुगाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000282016, "chapter_id": 20282, "verse_number": "१-३६-१७", "content_sanskrit": "गतेषु तेषु काकुत्स्थः पुष्पकादवरुह्य च ।\nअभिवादयितुं प्राप्तः सोगस्त्यमृषिमुत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000282017, "chapter_id": 20282, "verse_number": "१-३६-१८", "content_sanskrit": "राजोवाच ।\nसुतो दशरथस्याहं भवंतमभिवादितुम् ।\nआगतो वै मुनिश्रेष्ठ सौम्येनेक्षस्व चक्षुषा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000282018, "chapter_id": 20282, "verse_number": "१-३६-१९", "content_sanskrit": "निर्धूतपापस्त्वां दृष्ट्वा भवामीह न संशयः ।\nएतावदुक्त्वा स मुनिमभिवाद्य पुनः पुनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000282019, "chapter_id": 20282, "verse_number": "१-३६-२०", "content_sanskrit": "कुशलं भृत्यवर्गस्य मृगाणां तनयस्य च ।\nभगवद्दर्शनाकांक्षी शूद्रं हत्वा त्विहागतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000282020, "chapter_id": 20282, "verse_number": "१-३६-२१", "content_sanskrit": "अगस्त्य उवाच ।\nस्वागतं ते रघुश्रेष्ठ जगद्वंद्य सनातन ।\nदर्शनात्तव काकुत्स्थ पूतोहं मुनिभिः सह ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000282021, "chapter_id": 20282, "verse_number": "१-३६-२२", "content_sanskrit": "त्वत्कृते रघुशार्दूल गृहाणार्घं महाद्युते ।\nस्वागतं नरशार्दूल दिष्ट्या प्राप्तोसि शत्रुहन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000282022, "chapter_id": 20282, "verse_number": "१-३६-२३", "content_sanskrit": "त्वं हि नित्यं बहुमतो गुणैर्बहुभिरुत्तमैः ।\nअतस्त्वं पूजनीयो वै मम नित्यं हृदिस्थितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000282023, "chapter_id": 20282, "verse_number": "१-३६-२४", "content_sanskrit": "सुरा हि कथयंति त्वां शूद्रघातिनमागतं ।\nब्राह्मणस्य च धर्मेण त्वया वै जीवितः सुतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000282024, "chapter_id": 20282, "verse_number": "१-३६-२५", "content_sanskrit": "उष्यतां चेह भगवः सकाशे मम राघव ।\nप्रभाते पुष्पकेणासि गंतायोध्यां महामते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000282025, "chapter_id": 20282, "verse_number": "१-३६-२६", "content_sanskrit": "इदं चाभरणं सौम्य सुकृतं विश्वकर्मणा ।\nदिव्यं दिव्येनवपुषा दीप्यमानं स्वतेजसा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000282026, "chapter_id": 20282, "verse_number": "१-३६-२७", "content_sanskrit": "प्रतिगृह्णीष्व राजेन्द्र मत्प्रियं कुरु राघव ।\nलब्धस्य हि पुनर्द्दाने सुमहत्फलमुच्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000282027, "chapter_id": 20282, "verse_number": "१-३६-२८", "content_sanskrit": "त्वं हि शक्तः परित्रातुं सेंद्रानपि सुरोत्तमान् ।\nतस्मात्प्रदास्ये विधिवत्प्रतीच्छस्व नरर्षभ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000282028, "chapter_id": 20282, "verse_number": "१-३६-२९", "content_sanskrit": "अथोवाच महाबाहुरिक्ष्वाकूणां महारथः ।\nकृतांजलिर्मुनिश्रेष्ठं स्वं च धर्ममनुस्मरन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000282029, "chapter_id": 20282, "verse_number": "१-३६-३०", "content_sanskrit": "प्रतिग्रहो वै भगवंस्तव मेऽत्र विगर्हितः ।\nक्षत्रियेण कथं विप्र प्रतिग्राह्यं विजानता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000282030, "chapter_id": 20282, "verse_number": "१-३६-३१", "content_sanskrit": "ब्राह्मणेन तु यद्दत्तं तन्मे त्वं वक्तुमर्हसि ।\nसपुत्रो गृहवानस्मि समर्थोस्मि महामुने ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000282031, "chapter_id": 20282, "verse_number": "१-३६-३२", "content_sanskrit": "आपदा चन चाक्रांतः कथं ग्राह्यः प्रतिग्रहः ।\nभार्या मे सुचिरं नष्टा न चान्या मम विद्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000282032, "chapter_id": 20282, "verse_number": "१-३६-३३", "content_sanskrit": "केवलं दोषभागी च भवामीह न संशयः ।\nकष्टां चैव दशां प्राप्य क्षत्रियोपि प्रतिग्रही ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000282033, "chapter_id": 20282, "verse_number": "१-३६-३४", "content_sanskrit": "कुर्वन्न दोषमाप्नोति मनुरेवात्र कारणम् ।\nवृद्धौ च मातापितरौ साध्वी भार्या शिशुः सुतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000282034, "chapter_id": 20282, "verse_number": "१-३६-३५", "content_sanskrit": "अप्यकार्यशतं कृत्वा भर्तव्या मनुरब्रवीत् ।\nनाहं प्रतीच्छे विप्रर्षे त्वया दत्तं प्रतिग्रहं ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000282035, "chapter_id": 20282, "verse_number": "१-३६-३६", "content_sanskrit": "न च मे भवता कोपः कार्यो वै सुरपूजित ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000282036, "chapter_id": 20282, "verse_number": "१-३६-३७", "content_sanskrit": "अगस्त्य उवाच ।\nन च प्रतिग्रहे दोषो गृहीते पार्थिवैर्नृप ।\nभवान्वै तारणे शक्तस्त्रैलोक्यस्यापि राघव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000282037, "chapter_id": 20282, "verse_number": "१-३६-३८", "content_sanskrit": "तारय ब्राह्मणं राम विशेषेण तपस्विनं ।\nतस्मात्प्रदास्ये विधिवत्प्रतीच्छस्व नराघिप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000282038, "chapter_id": 20282, "verse_number": "१-३६-३९", "content_sanskrit": "राम उवाच ।\nक्षत्रियेण कथं विप्र प्रतिग्राह्यं विजानता ।\nब्राह्मणेन तु यद्दत्तं तन्मे त्वं वक्तुमर्हसि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000282039, "chapter_id": 20282, "verse_number": "१-३६-४०", "content_sanskrit": "अगस्त्य उवाच ।\nआसीत्कृतयुगे राम ब्रह्मपूते पुरातने ।\nअपार्थिवाः प्रजाः सर्वाः सुराणां च शतक्रतुः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000282040, "chapter_id": 20282, "verse_number": "१-३६-४१", "content_sanskrit": "ताः प्रजा देवदेवेशं राजार्थं समुपागमन् ।\nसुराणां विद्यते राजा देवदेवः शतक्रतुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000282041, "chapter_id": 20282, "verse_number": "१-३६-४२", "content_sanskrit": "श्रेयसेस्मासु लोकेश पार्थिवं कुरु सांप्रतं ।\nयस्मिन्पूजां प्रयुंजानाः पुरुषा भुंजते महीम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000282042, "chapter_id": 20282, "verse_number": "१-३६-४३", "content_sanskrit": "ततो ब्रह्मा सुरश्रेष्ठो लोकपालान्सवासवान् ।\nसमाहूयाब्रवीत्सर्वांस्तेजोभागोऽत्र युज्यताम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000282043, "chapter_id": 20282, "verse_number": "१-३६-४४", "content_sanskrit": "ततो ददुर्लोकपालाश्चतुर्भागं स्वतेजसा ।\nअक्षयश्च ततो ब्रह्मा यतो जातोऽक्षयो नृपः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000282044, "chapter_id": 20282, "verse_number": "१-३६-४५", "content_sanskrit": "तं ब्रह्मा लोकपालानामंशं पुंसामयोजयत् ।\nततो नृपस्तदा तासां प्रजानां क्षेमपंडितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000282045, "chapter_id": 20282, "verse_number": "१-३६-४६", "content_sanskrit": "तत्रैंद्रेण तु भागेन सर्वानाज्ञापयेन्नृपः ।\nवारुणेन च भागेन सर्वान्पुष्णाति देहिनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000282046, "chapter_id": 20282, "verse_number": "१-३६-४७", "content_sanskrit": "कौबेरेण तथांशेन त्वर्थान्दिशति पार्थिवः ।\nयश्च याम्यो नृपे भागस्तेन शास्ति च वै प्रजाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000282047, "chapter_id": 20282, "verse_number": "१-३६-४८", "content_sanskrit": "तत्र चैंद्रेण भागेन नरेन्द्रोसि रघूत्तम ।\nप्रतिगृह्णीष्वाभरणं तारणार्थे मम प्रभो ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000282048, "chapter_id": 20282, "verse_number": "१-३६-४९", "content_sanskrit": "ततो रामः प्रजग्राह मुनेर्हस्तान्महात्मनः ।\nदिव्यमाभरणं चित्रं प्रदीप्तमिव भास्करं ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000282049, "chapter_id": 20282, "verse_number": "१-३६-५०", "content_sanskrit": "प्रतिगृह्य ततोगस्त्याद्राघवः परवीरहा ।\nनिरीक्ष्य सुचिरं कालं विचार्य च पुनः पुनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000282050, "chapter_id": 20282, "verse_number": "१-३६-५१", "content_sanskrit": "मौक्तिकानि विचित्राणि धात्रीफलसमानि च ।\nजांबूनदनिबद्धानि वज्रविद्रुमनीलकैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000282051, "chapter_id": 20282, "verse_number": "१-३६-५२", "content_sanskrit": "पद्मरागैः सगोमेधैर्वैडूर्यैः पुष्परागकैः ।\nसुनिबद्धं सुविभक्तं सुकृतं विश्वकर्मणा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000282052, "chapter_id": 20282, "verse_number": "१-३६-५३", "content_sanskrit": "दृष्ट्वा प्रीतिसमायुक्तो भूयश्चेदं व्यचिंतयत् ।\nनेदृशानि च रत्नानि मया दृष्टानि कानिचित् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000282053, "chapter_id": 20282, "verse_number": "१-३६-५४", "content_sanskrit": "उपशोभानि बद्धानि पृथ्वीमूल्यसमानि च ।\nविभीषणस्य लंकायां न दृष्टानि मया पुरा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000282054, "chapter_id": 20282, "verse_number": "१-३६-५५", "content_sanskrit": "इति संचित्य मनसा राघवस्तमृषिं पुनः ।\nआगमं तस्य दिव्यस्य प्रष्टुं समुपचक्रमे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000282055, "chapter_id": 20282, "verse_number": "१-३६-५६", "content_sanskrit": "अत्यद्भुतमिदं ब्रह्मन्न प्राप्यं च महीक्षिताम् ।\nकथं भगवता प्राप्तं कुतो वा केन निर्मितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000282056, "chapter_id": 20282, "verse_number": "१-३६-५७", "content_sanskrit": "कुतूहलवशाच्चैव पृच्छामि त्वां महामते ।\nकरतलेस्थिते रत्ने करमध्यं प्रकाशते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000282057, "chapter_id": 20282, "verse_number": "१-३६-५८", "content_sanskrit": "अधमं तद्विजानीयात्सर्वशास्त्रेषु गर्हितम् ।\nदिशः प्रकाशयेद्यत्तन्मध्यमं मुनिसत्तम ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000282058, "chapter_id": 20282, "verse_number": "१-३६-५९", "content_sanskrit": "ऊर्ध्वगं त्रिशिखं यत्स्यादुत्तमं तदुदाहृतम् ।\nएतान्युत्तमजातीनि ऋषिभिः कीर्तितानि तु ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000282059, "chapter_id": 20282, "verse_number": "१-३६-६०", "content_sanskrit": "आश्चर्याणां बहूनां हि दिव्यानां भगवान्निधिः ।\nएवं वदति काकुत्स्थे मुनिर्वाक्यमथाब्रवीत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000282060, "chapter_id": 20282, "verse_number": "१-३६-६१", "content_sanskrit": "अगस्त्य उवाच ।\nशृणु राम पुरावृत्तं पुरा त्रेतायुगे महत् ।\nद्वापरे समनुप्राप्ते वने यद्दृष्टवानहम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000282061, "chapter_id": 20282, "verse_number": "१-३६-६२", "content_sanskrit": "आश्चर्यं सुमहाबाहो निबोध रघुनंदन ।\nपुरा त्रेतायुगे ह्यासीदरण्यं बहुविस्तरम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000282062, "chapter_id": 20282, "verse_number": "१-३६-६३", "content_sanskrit": "समंताद्योजनशतं मृगव्याघ्रविवर्जितम् ।\nतस्मिन्निष्पुरुषेऽरण्ये चिकीर्षुस्तप उत्तमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000282063, "chapter_id": 20282, "verse_number": "१-३६-६४", "content_sanskrit": "अहमाक्रमितुं सौम्य तदरण्यमुपागतः ।\nतस्यारण्यस्य मध्यं तु युक्तं मूलफलैः सदा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000282064, "chapter_id": 20282, "verse_number": "१-३६-६५", "content_sanskrit": "शाकैर्बहुविधाकारैर्नानारूपैः सुकाननैः ।\nतस्यारण्यस्य मध्ये तु पंचयोजनमायतम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000282065, "chapter_id": 20282, "verse_number": "१-३६-६६", "content_sanskrit": "हंसकारंडवाकीर्णं चक्रवाकोपशोभितम् ।\nतत्राश्चर्यं मया दृष्टं सरः परमशोभितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000282066, "chapter_id": 20282, "verse_number": "१-३६-६७", "content_sanskrit": "विसारिकच्छपाकीर्णं बकपंक्तिगणैर्युतम् ।\nसमीपे तस्य सरसस्तपस्तप्तुं गतः पुरा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000282067, "chapter_id": 20282, "verse_number": "१-३६-६८", "content_sanskrit": "देशं पुण्यमुपेत्यैवं सर्वहिंसाविवर्जितम् ।\nतत्राहमवसं रात्रिं नैदाघीं पुरुषर्षभ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000282068, "chapter_id": 20282, "verse_number": "१-३६-६९", "content_sanskrit": "प्रभाते पुरुत्थाय सरस्तदुपचक्रमे ।\nअथापश्यं शवमहमस्पृष्टजरसं क्वचित् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000282069, "chapter_id": 20282, "verse_number": "१-३६-७०", "content_sanskrit": "तिष्ठंतं परया लक्ष्म्या सरसो नातिदूरतः ।\nतदर्थं चिंतयानोहं मुहूर्तमिव राघव ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000282070, "chapter_id": 20282, "verse_number": "१-३६-७१", "content_sanskrit": "अस्य तीरे न वै प्राणी को वाप्येष सुरर्षभः ।\nमुनिर्वा पार्थिवो वापि क्व मुनिः पार्थिवोपि वा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000282071, "chapter_id": 20282, "verse_number": "१-३६-७२", "content_sanskrit": "अथवा पार्थिवसुतस्तस्यैवं संभवः कृतः ।\nअतीतेहनि रात्रौ वा प्रातर्वापि मृतो यदि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000282072, "chapter_id": 20282, "verse_number": "१-३६-७३", "content_sanskrit": "अवश्यं तु मया ज्ञेया सरसोस्य विनिष्क्रिया ।\nयावदेवं स्थितश्चाहं चिंतयानो रघूत्तम ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000282073, "chapter_id": 20282, "verse_number": "१-३६-७४", "content_sanskrit": "अथापश्यं मूहूर्तात्तु दिव्यमद्भुतदर्शनम् ।\nविमानं परमोदारं हंसयुक्तं मनोजवम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000282074, "chapter_id": 20282, "verse_number": "१-३६-७५", "content_sanskrit": "पुरस्तत्र सहस्रं तु विमानेप्सरसां नृप ।\nगंधर्वाश्चैव तत्संख्या रमयंति वरं नरम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000282075, "chapter_id": 20282, "verse_number": "१-३६-७६", "content_sanskrit": "गायंति दिव्यगेयानि वादयंति तथा परे ।\nअथापश्यं नरं तस्माद्विमानादवरोहितम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000282076, "chapter_id": 20282, "verse_number": "१-३६-७७", "content_sanskrit": "शवमांसं भक्षयन्तं च स्नात्वा रघुकुलोद्वह ।\nततो भुक्त्वा यथाकामं स मांसं बहुपीवरम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000282077, "chapter_id": 20282, "verse_number": "१-३६-७८", "content_sanskrit": "अवतीर्य सरः शीघ्रमारुरोह दिवं पुनः ।\nतमहं देवसंकाशं श्रिया परमयान्वितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000282078, "chapter_id": 20282, "verse_number": "१-३६-७९", "content_sanskrit": "भो भो स्वर्गिन्महाभाग पृच्छामि त्वां कथं त्विदम् ।\nजुगुप्सितस्तवाहारो गतिश्चेयं तवोत्तमा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000282079, "chapter_id": 20282, "verse_number": "१-३६-८०", "content_sanskrit": "यदि गुह्यं न चैतत्ते कथय त्वद्य मे भवान् ।\nकामतः श्रोतुमिच्छामि किमेतत्परमं वचः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000282080, "chapter_id": 20282, "verse_number": "१-३६-८१", "content_sanskrit": "को भवान्वद संदेहमाहारश्च विगर्हितः ।\nत्वयेदं भुज्यते सौम्य किमर्थं क्व च वर्तसे ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000282081, "chapter_id": 20282, "verse_number": "१-३६-८२", "content_sanskrit": "कस्यायमैश्वरोभावः शवत्वेन विनिर्मितः ।\nआहारं च कथं निंद्यं श्रोतुमिच्छामि तत्त्वतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000282082, "chapter_id": 20282, "verse_number": "१-३६-८३", "content_sanskrit": "श्रुत्वा च भाषितं तत्र मम राम सतां वर ।\nप्रांजलिः प्रत्युवाचेदं स स्वर्गी रघुनंदन ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000282083, "chapter_id": 20282, "verse_number": "१-३६-८४", "content_sanskrit": "शृणुष्वाद्य यथावृत्तं ममेदं सुखदुःखजम् ।\nकामो हि दुरितक्रम्यः शृणु यत्पृच्छसे द्विज ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000282084, "chapter_id": 20282, "verse_number": "१-३६-८५", "content_sanskrit": "पुरा वैदर्भको राजा पिता मे हि महायशाः ।\nवासुदेव इति ख्यातस्त्रिषु लोकेषु धार्मिकः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000282085, "chapter_id": 20282, "verse_number": "१-३६-८६", "content_sanskrit": "तस्य पुत्रद्वयं ब्रह्मन्द्वाभ्यां स्त्रीभ्यामजायत ।\nअहं श्वेत इति ख्यातो यवीयान्सुरथोऽभवत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000282086, "chapter_id": 20282, "verse_number": "१-३६-८७", "content_sanskrit": "पितर्युपरते तस्मिन्पौरा मामभ्यषेचयन् ।\nतत्राहंकारयन्राज्यं धर्मे चासं समाहितः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000282087, "chapter_id": 20282, "verse_number": "१-३६-८८", "content_sanskrit": "एवं वर्षसहस्राणि बहूनि समुपाव्रजन् ।\nमम राज्यं कारयतः परिपालयतः प्रजाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000282088, "chapter_id": 20282, "verse_number": "१-३६-८९", "content_sanskrit": "सोहं निमित्ते कस्मिंश्चिद्वैराग्येण द्विजोत्तम ।\nमरणं हृदये कृत्वा तपोवनमुपागमम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000282089, "chapter_id": 20282, "verse_number": "१-३६-९०", "content_sanskrit": "सोहं वनमिदं रम्यं भृशं पक्षिविवर्जितम् ।\nप्रविष्टस्तप आस्थातुमस्यैव सरसोंतिके ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000282090, "chapter_id": 20282, "verse_number": "१-३६-९१", "content_sanskrit": "राज्येऽभिषिच्य सुरथं भ्रातरं तं नराधिपम् ।\nइदं सरः समासाद्य तपस्तप्तं सुदारुणम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000282091, "chapter_id": 20282, "verse_number": "१-३६-९२", "content_sanskrit": "दशवर्षसहस्राणि तपस्तप्त्वा महावने ।\nशुभं तु भवनं प्राप्तो ब्रह्मलोकमनामयम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000282092, "chapter_id": 20282, "verse_number": "१-३६-९३", "content_sanskrit": "स्वर्गस्थमपि मां ब्रह्मन्क्षुत्पिपासे द्विजोत्तम ।\nअबाधेतां भृशं चाहमभवं व्यथितेंद्रियः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000282093, "chapter_id": 20282, "verse_number": "१-३६-९४", "content_sanskrit": "ततस्त्रिभुवनश्रेष्ठमवोचं वै पितामहम् ।\nभगवन्स्वर्गलोकोऽयं क्षुत्पिपासा विवर्जितः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000282094, "chapter_id": 20282, "verse_number": "१-३६-९५", "content_sanskrit": "कस्येयं कर्मणः पक्तिः क्षुत्पिपासे यतो हि मे ।\nआहारः कश्च मे देव ब्रूहि त्वं श्रीपितामह ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000282095, "chapter_id": 20282, "verse_number": "१-३६-९६", "content_sanskrit": "ततः पितामहः सम्यक्चिरं ध्यात्वा महामुने ।\nमामुवाच ततो वाक्यं नास्ति भोज्यं स्वदेहजम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000282096, "chapter_id": 20282, "verse_number": "१-३६-९७", "content_sanskrit": "ॠते ते स्वानि मांसानि भक्षय त्वं तु हि नित्यशः ।\nस्वशरीरं त्वया पुष्टं कुर्वता तप उत्तमम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000282097, "chapter_id": 20282, "verse_number": "१-३६-९८", "content_sanskrit": "नादत्तं जायते तात श्वेत पश्य महीतले ।\nआग्रहाद्भिक्षमाणाय भिक्षापि प्राणिने पुरा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000282098, "chapter_id": 20282, "verse_number": "१-३६-९९", "content_sanskrit": "न हि दत्ता गृहे भ्रांत्या मोहादतिथये तदा ।\nतेन स्वर्गगतस्यापि क्षुत्पिपासे तवाधुना ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000282099, "chapter_id": 20282, "verse_number": "१-३६-१००", "content_sanskrit": "स त्वं प्रपुष्टमाहारैः स्वशरीरमनुत्तमम् ।\nभक्षयस्व च राजेंद्र सा ते तृप्तिर्भविष्यति ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000282100, "chapter_id": 20282, "verse_number": "१-३६-१०१", "content_sanskrit": "एवमुक्तस्ततो देवं ब्रह्माणमहमुक्तवान् ।\nभक्षिते च स्वके देहे पुनरन्यन्न मे विभो ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000282101, "chapter_id": 20282, "verse_number": "१-३६-१०२", "content_sanskrit": "क्षुधानिवारणं नैव देहस्यास्य विनौदनं ।\nखादामि ह्यक्षयं देव प्रियं मे न हि जायते ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000282102, "chapter_id": 20282, "verse_number": "१-३६-१०३", "content_sanskrit": "ततोब्रवीत्पुनर्ब्रह्मा तव देहोऽक्षयः कृतः ।\nदिनेदिने ते पुष्टात्मा शवः श्वेत भविष्यति ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000282103, "chapter_id": 20282, "verse_number": "१-३६-१०४", "content_sanskrit": "यावद्वर्षशतं पूर्णं स्वमांसं खाद भो नृप ।\nयदागच्छति चागस्त्यः श्वेतारण्यं महातपाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000282104, "chapter_id": 20282, "verse_number": "१-३६-१०५", "content_sanskrit": "भगवानतिदुर्धर्षस्तदा कृच्छ्राद्विमोक्ष्यसे ।\nस हि तारयितुं शक्तः सेंद्रानपि सुरासुरान् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000282105, "chapter_id": 20282, "verse_number": "१-३६-१०६", "content_sanskrit": "आहारं कुत्सितं चेमं राजर्षे किं पुनस्तव ।\nसुरकार्यं महत्तेन सुकृतं तु महात्मना ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000282106, "chapter_id": 20282, "verse_number": "१-३६-१०७", "content_sanskrit": "उदधिं निर्जलं कृत्वा दानवाश्च निपातिताः ।\nविंध्यश्चादित्यविद्वेषाद्वर्धमानो निवारितः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000282107, "chapter_id": 20282, "verse_number": "१-३६-१०८", "content_sanskrit": "लंबमाना मही चैषा गुरुत्वेनाधिवासिता ।\nदक्षिणा दिग्दिवं याता त्रैलाक्यं विषमस्थितम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000282108, "chapter_id": 20282, "verse_number": "१-३६-१०९", "content_sanskrit": "मया गत्वा सुरैः सार्द्धं प्रेषितो दक्षिणां दिशम् ।\nसमां कुरु महाभाग गुरुत्वेन जगत्समम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000282109, "chapter_id": 20282, "verse_number": "१-३६-११०", "content_sanskrit": "एवं च तेन मुनिना स्थित्वा सर्वा धरा समा ।\nकृता राजेंद्र मुनिना एवमद्यापि दृश्यते ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000282110, "chapter_id": 20282, "verse_number": "१-३६-१११", "content_sanskrit": "सोहं भगवत श्रुत्वा देवदेवस्य भाषितम् ।\nभुंजे च कुत्सिताहारं स्वशरीरमनुत्तमम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000282111, "chapter_id": 20282, "verse_number": "१-३६-११२", "content_sanskrit": "पूर्णं वर्षशतं चाद्य भोजनं कुत्सितं च मे ।\nक्षयं नाभ्येति तद्विप्र तृप्तिश्चापि ममोत्तमा ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000282112, "chapter_id": 20282, "verse_number": "१-३६-११३", "content_sanskrit": "तं मुनिं कृच्छ्रसन्तप्तश्चिंतयामि दिवानिशम् ।\nकदा वै दर्शनं मह्यं स मुनिर्दास्यते वने ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000282113, "chapter_id": 20282, "verse_number": "१-३६-११४", "content_sanskrit": "एवं मे चिंतयानस्य गतं वर्षशतन्त्विह ।\nसोगस्त्यो हि गतिर्ब्रह्मन्मुनिर्मे भविता ध्रुवं ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000282114, "chapter_id": 20282, "verse_number": "१-३६-११५", "content_sanskrit": "न गतिर्भविता मह्यं कुंभयोनिमृते द्विजम् ।\nश्रुत्वेत्थं भाषितं राम दृष्ट्वाहारं च कुत्सितम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000282115, "chapter_id": 20282, "verse_number": "१-३६-११६", "content_sanskrit": "कृपया परया युक्तस्तं नृपं स्वर्गगामिनम् ।\nकरोम्यहं सुधाभोज्यं नाशयामि च कुत्सितम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000282116, "chapter_id": 20282, "verse_number": "१-३६-११७", "content_sanskrit": "चिन्तयन्नित्यवोचं तमगस्त्यः किं करिष्यति ।\nअहमेतत्कुत्सितं ते नाशयामि महामते ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000282117, "chapter_id": 20282, "verse_number": "१-३६-११८", "content_sanskrit": "ईप्सितं प्रार्थयस्वास्मान्मनः प्रीतिकरं परम् ।\nस स्वर्गी मां ततः प्राह कथं ब्रह्मवचोन्यथा ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000282118, "chapter_id": 20282, "verse_number": "१-३६-११९", "content_sanskrit": "कर्तुं मुने मया शक्यं न चान्यस्तारयिष्यति ।\nॠते वै कुंभयोनिं तं मैत्रावरुणसंभवम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000282119, "chapter_id": 20282, "verse_number": "१-३६-१२०", "content_sanskrit": "अपृष्टोपि मया ब्रह्मन्नेवमूचे पितामहः ।\nएवं ब्रुवाणं तं श्वेतमुक्तवानहमस्मि सः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000282120, "chapter_id": 20282, "verse_number": "१-३६-१२१", "content_sanskrit": "आगतस्तव भाग्येन दृष्टोहं नात्र संशयः ।\nततः स्वर्गी स मां ज्ञात्वा दंडवत्पतितो भुवि ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000282121, "chapter_id": 20282, "verse_number": "१-३६-१२२", "content_sanskrit": "तमुत्थाप्य ततो रामाब्रवं किं ते करोम्यहम् ।\nराजोवाच ।\nआहारात्कुत्सिताद्ब्रह्मंस्तारयस्वाद्य दुष्कृतात् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000282122, "chapter_id": 20282, "verse_number": "१-३६-१२३", "content_sanskrit": "येन लोकोऽक्षयः स्वर्गो भविता त्वत्कृतेन मे ।\nततः प्रतिग्रहो दत्तो जगद्वंद्य नृपेण हि ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000282123, "chapter_id": 20282, "verse_number": "१-३६-१२४", "content_sanskrit": "भवान्मामनुगृह्णातु प्रतीच्छस्व प्रतिग्रहम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000282124, "chapter_id": 20282, "verse_number": "१-३६-१२५", "content_sanskrit": "कृता मतिस्तारणाय न लोभाद्रघुनंदन ।\nगृहीते भूषणे राम मम हस्तगते तदा ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000282125, "chapter_id": 20282, "verse_number": "१-३६-१२६", "content_sanskrit": "मानुषः पौर्विको देहस्तदा नष्टोस्य भूपते ।\nप्रणष्टे तु शरीरे च राजर्षिः परया मुदा ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000282126, "chapter_id": 20282, "verse_number": "१-३६-१२७", "content_sanskrit": "मयोक्तोसौ विमानेन जगाम त्रिदिवं पुनः ।\nतेन मे शक्रतुल्येन दत्तमाभरणं शुभं ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000282127, "chapter_id": 20282, "verse_number": "१-३६-१२८", "content_sanskrit": "तस्मिन्निमित्ते काकुत्स्थ दत्तमद्भुतकर्मणा ।\nश्वेतो वैदर्भको राजा तदाभूद्गतकल्मषः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}]