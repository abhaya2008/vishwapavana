[
  {
    "id": 20131681,
    "chapter_id": 7009,
    "verse_number": "27.1",
    "content_sanskrit": "अथ सप्तविंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20131682,
    "chapter_id": 7009,
    "verse_number": "27.2",
    "content_sanskrit": "सिद्धीनां तु प्रवक्ष्यामि लक्षणं नाटकाश्रयम् । यस्मात्प्रयोगः सर्वो ऽयं सिद्ध्यर्थंं संप्रदर्शितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20131683,
    "chapter_id": 7009,
    "verse_number": "27.3",
    "content_sanskrit": "सिद्धिस्तु द्विविधा ज्ञेया वाङ्मनोङ्गसमुद्भवा । दैवी च मानुषी चैव नानाभावसमुत्थिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20131684,
    "chapter_id": 7009,
    "verse_number": "27.4",
    "content_sanskrit": "दशाङ्गा मानुषी सिद्धीर्दैवी तु द्विविधा स्मृता । नानासत्त्वाश्रयकृता वाङ्नैपथ्यशरीरजा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20131685,
    "chapter_id": 7009,
    "verse_number": "27.5",
    "content_sanskrit": "स्मितापहासिनी हासा साध्वहो कष्टमेव च । प्रबद्धनादा च तथा सिद्धिर्ज्ञेयाथ वाङ्मयी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20131686,
    "chapter_id": 7009,
    "verse_number": "27.6",
    "content_sanskrit": "पुलकैश्च सरोमाञ्चैरभ्युत्थानैस्तथैव च । चेलदानाङ्गुलिक्षेपैः शारीरी सिद्धिरिष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20131687,
    "chapter_id": 7009,
    "verse_number": "27.7",
    "content_sanskrit": "किञ्चिच्छिष्टो रसो हास्यो नृत्यद्भिर्यत्र युज्यते । स्मितेन स प्रतिग्राह्यः प्रेक्षकैर्नित्यमेव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20131688,
    "chapter_id": 7009,
    "verse_number": "27.8",
    "content_sanskrit": "किञ्चिदस्पष्टहास्यं यत्तथा वचनमेव च । अर्थहास्येन तद्ग्राह्यं प्रेक्षकैर्नित्यमेव हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20131689,
    "chapter_id": 7009,
    "verse_number": "27.9",
    "content_sanskrit": "विदूषकोच्छेदकृतं भवेच्छिल्पकृतं च यत् । अतिहास्येन तद्ग्राह्यं प्रेक्षकैर्नित्यमेव तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20131690,
    "chapter_id": 7009,
    "verse_number": "27.10",
    "content_sanskrit": "अहोकारस्तथा कार्यो नृणां प्रकृतिसंभवः । यद्धर्मपदसंयुक्तं यथातिशयसंभवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20131691,
    "chapter_id": 7009,
    "verse_number": "27.11",
    "content_sanskrit": "तत्र साध्विति यद्वाक्यं प्रयोक्तव्यं हि साधकैः । विस्मयाविष्टभावेषु प्रहर्षार्थेषु चैव हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20131692,
    "chapter_id": 7009,
    "verse_number": "27.12",
    "content_sanskrit": "करुणे ऽपि प्रयोक्तव्यं कष्टं शास्त्रकृतेन तु । प्रबद्धनादा च तथा विस्मयार्थेषु नित्यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20131693,
    "chapter_id": 7009,
    "verse_number": "27.13",
    "content_sanskrit": "साधिक्षेपेषु वाक्येषु प्रस्पन्दिततनूरुहैः । कुतूहलोत्तरावेधैर्बहुमानेन साधयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20131694,
    "chapter_id": 7009,
    "verse_number": "27.14",
    "content_sanskrit": "दीप्तप्रदेशं यत्कार्यं छेद्यभेद्याहवात्मकम् । सविद्रवमथोत्फुल्लं तथा युद्धनियुद्धजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20131695,
    "chapter_id": 7009,
    "verse_number": "27.15",
    "content_sanskrit": "प्रकम्पितांसशीर्षञ्च साश्रं सोत्थानमेव च । तत्प्रेक्षकैस्तु कुशलैस्साध्यमेवं विधानतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20131696,
    "chapter_id": 7009,
    "verse_number": "27.16",
    "content_sanskrit": "एवं साधयितव्यैषा तज्ज्ञैः सिद्धिस्तु मानुषी । दैविकीञ्च पुनः सिद्धिं संप्रवक्ष्यामि तत्त्वतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20131697,
    "chapter_id": 7009,
    "verse_number": "27.17",
    "content_sanskrit": "या भावातिशयोपेता सत्त्वयुक्ता तथैव च । सा प्रेक्षकैस्तु कर्तव्या दैवी सिद्धिः प्रयोगतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20131698,
    "chapter_id": 7009,
    "verse_number": "27.18",
    "content_sanskrit": "न शब्दो न यत्र न क्षोभो न चोत्पातनिदर्शनम् । संपूर्णता च रंगस्य दैवी सिद्धिस्तु सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20131699,
    "chapter_id": 7009,
    "verse_number": "27.19",
    "content_sanskrit": "दैवी च मानुषी चैव सिद्धिरेषा मयोदिता । अत ऊर्ध्वं प्रवक्ष्यामि घातान्दैवसमुत्थितन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20131700,
    "chapter_id": 7009,
    "verse_number": "27.20",
    "content_sanskrit": "दैवात्मपरसमुत्था त्रिविधा घाता बुधैस्तु विज्ञेया । औत्पातिकश्चतुर्थः कदाचिदथ संभवत्येषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20131701,
    "chapter_id": 7009,
    "verse_number": "27.21",
    "content_sanskrit": "वाताग्निवर्षकुञ्जरभुजङ्गमण्डपनिपाताः । कीटव्यालपिपीलिकपशुप्रवेशनाश्च दैवककृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20131702,
    "chapter_id": 7009,
    "verse_number": "27.22",
    "content_sanskrit": "घातनतः परमहं परयुक्तान् संप्रवक्ष्यामि । [वैवर्ण्यं चाचेष्टं विभ्रमितत्वं स्मृतिप्रमोहश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20131703,
    "chapter_id": 7009,
    "verse_number": "27.23",
    "content_sanskrit": "अन्यवचनं च काव्यं तथांगदोषो विहस्तत्वम् । एते त्वात्मसमुत्था घाता ज्ञेया प्रयोगज्ञैः] ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20131704,
    "chapter_id": 7009,
    "verse_number": "27.24",
    "content_sanskrit": "मात्सर्याद्द्वेषाद्वा तत्पक्षत्वात्तथार्थभेदत्वात् । एते तु परसमुत्था ज्ञेया घाता बुधैर्नित्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20131705,
    "chapter_id": 7009,
    "verse_number": "27.25",
    "content_sanskrit": "अतिहसितरुदितविस्फोटितान्यथोत्कृष्टनालिकापाताः । गोमयलोष्टपिपीलिकाविक्षेपाश्चारिसंभूताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20131706,
    "chapter_id": 7009,
    "verse_number": "27.26",
    "content_sanskrit": "औत्पतिकाश्च घाता मत्तोन्मत्तप्रवेशलिङ्गकृतः । पुनरात्मसमुत्था ये घातांस्तांस्तान् प्रवक्ष्यामि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20131707,
    "chapter_id": 7009,
    "verse_number": "27.27",
    "content_sanskrit": "वैलक्षण्यमचेष्टितविभूमिकत्वं स्मृतिप्रमोषश्च । अन्यवचनं च काव्यं तथार्तनादो विहस्तत्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20131708,
    "chapter_id": 7009,
    "verse_number": "27.28",
    "content_sanskrit": "अतिहसितरुदितविस्वरपिपीलिकाकीटपशुविरावाश्च । मुकुटाभरणनिपाता पुष्करजाः काव्यदोषाश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20131709,
    "chapter_id": 7009,
    "verse_number": "27.29",
    "content_sanskrit": "अतिहसितरुदितहसितानि सिद्धैर्भावस्य दूषकाणि स्युः । कीटपिपीलिकपाता सिद्धिं सर्वात्मना घ्नान्त ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20131710,
    "chapter_id": 7009,
    "verse_number": "27.30",
    "content_sanskrit": "विवस्वरमजाततालं वर्णस्वरसंपदा च परिहीणम् । अज्ञातस्थानलयं स्वरगतमेवंविधं हन्यात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20131711,
    "chapter_id": 7009,
    "verse_number": "27.31",
    "content_sanskrit": "मुकुटाभरणनिपातः प्रबद्धनादश्च नाशनो भवति । पशुविशसनं तथ अ स्याद्बहुवचनघ्नं प्रयोगेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20131712,
    "chapter_id": 7009,
    "verse_number": "27.32",
    "content_sanskrit": "विषमं मानविहीनं विमार्जनं चाकुलप्रहारं च । अविभक्तग्रहमोक्षं पुष्करगतमीदृशं हन्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20131713,
    "chapter_id": 7009,
    "verse_number": "27.33",
    "content_sanskrit": "पुनरुक्तो ह्यसमासो विभक्तिभेदो विसन्धयो ऽपार्थः । त्रैलिङ्गजश्च दोषः प्रत्यक्षपरोक्षसंमोहाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20131714,
    "chapter_id": 7009,
    "verse_number": "27.34",
    "content_sanskrit": "छन्दोवृत्तत्यागो गुरुलाघवसङ्करो यतेर्भेदः । एतानि यथा स्थूलं घातस्थानानि काव्यस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20131715,
    "chapter_id": 7009,
    "verse_number": "27.35",
    "content_sanskrit": "ज्ञेयौ तु काव्यजातौ द्वौ घातावप्रतिक्रियौ नित्यम् । प्रकृतिव्यसनसमुत्थः शेषोदकनालिकत्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20131716,
    "chapter_id": 7009,
    "verse_number": "27.36",
    "content_sanskrit": "अप्रतिभागं स्खलनं विस्वरमुच्चारणं च काव्यस्य । अस्थानभूषणत्वं पतनं मुकुटस्य विभ्रंशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20131717,
    "chapter_id": 7009,
    "verse_number": "27.37",
    "content_sanskrit": "वाजिस्यन्दनकुञ्जरखरोष्ट्रशिबिकाविमानयानानाम् । आरोहणावतरणेष्वनभिज्ञत्वं विहस्त्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20131718,
    "chapter_id": 7009,
    "verse_number": "27.38",
    "content_sanskrit": "प्रहरणकवचानामप्ययथाग्रहणं विधारणं चापि । अमुकुटभूषणयोगश्चिरप्रवेशो ऽथवा रङ्गे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20131719,
    "chapter_id": 7009,
    "verse_number": "27.39",
    "content_sanskrit": "एभिः स्थानविशेषैर्घाता लक्ष्यास्तु सूरिभिः कुशलैः । यूपाग्निचयनदर्भस्त्रग्भाण्डपरिग्रहान्मुक्त्वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20131720,
    "chapter_id": 7009,
    "verse_number": "27.40",
    "content_sanskrit": "सिद्ध्या मिश्रो घातस्सर्वगतश्चैकदेशजो वापि । नाट्यकुशलैः सलेख्या सिद्धिर्वा स्याद्विघातो वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20131721,
    "chapter_id": 7009,
    "verse_number": "27.41",
    "content_sanskrit": "नालेख्यो बहुदिनजः सर्वगतो ऽव्यक्तलक्षणविशेषः । यस्त्वैकदिवसजातस्स प्रत्यवरो ऽपि लेख्यस्स्यात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20131722,
    "chapter_id": 7009,
    "verse_number": "27.42",
    "content_sanskrit": "जर्जरमोक्ष्यस्यान्ते सिद्धेर्मोक्षस्तु नालिकायास्तु । कर्तव्यस्त्विह सततं नाट्यज्ञैः प्राश्निकैर्विधिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20131723,
    "chapter_id": 7009,
    "verse_number": "27.43",
    "content_sanskrit": "दैन्ये दीनत्वमायान्ति ते नाट्ये प्रेक्षकाः स्मृताः । ये तुष्टौ तुष्टिमायान्ति शोके शोकं व्रजन्ति च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20131724,
    "chapter_id": 7009,
    "verse_number": "27.44",
    "content_sanskrit": "यो ऽन्यस्य महे मूर्धो नांदीश्लोकं पठेद्धि देवस्य । स्ववशेन पूर्वरङ्गे सिद्धेर्घातः प्रयोगस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20131725,
    "chapter_id": 7009,
    "verse_number": "27.45",
    "content_sanskrit": "यो देशभावरहितं भाषाकाव्यं प्रयोजयेद्बुद्ध्या । तस्याप्यभिलेख्यः स्याद्घातो देशः प्रयोगज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20131726,
    "chapter_id": 7009,
    "verse_number": "27.46",
    "content_sanskrit": "कः शक्तो नाट्यविधौ यथावदुपपादनं प्रयोगस्य । कर्तुं व्यग्रमना वा यथावदुक्तं परिज्ञातम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20131727,
    "chapter_id": 7009,
    "verse_number": "27.47",
    "content_sanskrit": "तस्माद्गम्भीरार्थाः शब्दा ये लोकवेदसंसिद्धाः । सर्वजनेन ग्राह्या योज्या नाटके विधिवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20131728,
    "chapter_id": 7009,
    "verse_number": "27.48",
    "content_sanskrit": "न च किञ्चिद्गुणहीनं दोषैः परिवर्जितं न चाकिञ्चित् । तस्मान्नाट्यप्रकृतौ दोषा नाट्यार्थतो ग्राह्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20131729,
    "chapter_id": 7009,
    "verse_number": "27.49",
    "content_sanskrit": "न च नादरस्तु कार्यो नटेन वागङ्गसत्त्वनेपथ्ये । रसभावयोश्च गीतेष्वातोद्ये लोकयुक्त्यां च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20131730,
    "chapter_id": 7009,
    "verse_number": "27.50",
    "content_sanskrit": "एवमेतत्तु विज्ञेयं सिद्धीनां लक्षणं बुधैः । अत ऊर्ध्वं प्रवक्ष्यामि प्राश्निकानां तु लक्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20131731,
    "chapter_id": 7009,
    "verse_number": "27.51",
    "content_sanskrit": "चारित्राभिजनोपेताः शान्तवृत्ताः कृतश्रमाः । यशोधर्मपराश्चैव मध्यस्थवयसान्विताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20131732,
    "chapter_id": 7009,
    "verse_number": "27.52",
    "content_sanskrit": "षडङ्गनाट्यकुशलाः प्रबुद्धाः शुचयः समाः । चतुरातोद्यकुशलाः वृत्तज्ञास्तत्त्वदर्शिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20131733,
    "chapter_id": 7009,
    "verse_number": "27.53",
    "content_sanskrit": "देशभाषाविधानज्ञाः कलाशिल्पप्रयोजकाः । चतुर्थाभिनयोपेता रसभावविकल्पकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20131734,
    "chapter_id": 7009,
    "verse_number": "27.54",
    "content_sanskrit": "शब्दच्छन्दोविधानज्ञा नानाशास्त्रविचक्षणाः । एवं विधास्तु कर्तव्याः प्राश्निका दशरूपके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20131735,
    "chapter_id": 7009,
    "verse_number": "27.55",
    "content_sanskrit": "अव्यग्रैरिन्द्रियैः शुद्ध ऊहापोहविशारदः । त्यक्तदोषोनुअरागी च स नाट्ये प्रेक्षकः स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20131736,
    "chapter_id": 7009,
    "verse_number": "27.56",
    "content_sanskrit": "न चैवेते गुणाः सम्यक् सर्वस्मिन् प्रेक्षके स्मृताः । विज्ञेयस्याप्रमेयत्वात्संकीर्णानां च पार्षदि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20131737,
    "chapter_id": 7009,
    "verse_number": "27.57",
    "content_sanskrit": "यद्यस्य शिल्पं नेपथ्यं कर्मचेष्टितमेव वा । तत्तथा तेन कार्यं तु स्वकर्मविषयं प्रति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20131738,
    "chapter_id": 7009,
    "verse_number": "27.58",
    "content_sanskrit": "नानाशीलाः प्रकृतयः शीले नाट्यं विनिर्मितम् । उत्तमाधममध्यानां वृद्धबालिशयोषिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20131739,
    "chapter_id": 7009,
    "verse_number": "27.59",
    "content_sanskrit": "तुष्यन्ति तरुणाः कामे विदग्धाः समयात्विते । अर्थेष्वर्थपराश्चैव मोक्षे चाथ विरागिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20131740,
    "chapter_id": 7009,
    "verse_number": "27.60",
    "content_sanskrit": "शूरास्तु वीररौद्रेषु नियुद्धेष्वाहवेषु च । धर्माख्याने पुराणेषु वृद्धास्तुष्यन्ति नित्यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20131741,
    "chapter_id": 7009,
    "verse_number": "27.61",
    "content_sanskrit": "न शक्यमधमैर्ज्ञातुमुत्तमानां विचेष्टितम् । तत्त्वभावेषु सर्वेषु तुष्यन्ति सततं बुधाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20131742,
    "chapter_id": 7009,
    "verse_number": "27.62",
    "content_sanskrit": "बाला मूर्खाः स्त्रियश्चैव हास्यनैपथ्ययोः सदा । यस्तुष्टो तुष्टिमायाति शोके शोकमुपैति च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20131743,
    "chapter_id": 7009,
    "verse_number": "27.63",
    "content_sanskrit": "क्रुद्धः क्रोधे भये भीतः स श्रेष्ठः प्रेक्षकः स्मृतः । एवं भावानुकरणे यो यस्मिन् प्रविशेन्नरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20131744,
    "chapter_id": 7009,
    "verse_number": "27.64",
    "content_sanskrit": "स तत्र प्रेक्षको ज्ञेयो गुणैरेभिरलङ्कृतः । एवं हि प्रेक्षका ज्ञेयाः प्रयोगे दशरूपतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20131745,
    "chapter_id": 7009,
    "verse_number": "27.65",
    "content_sanskrit": "संघर्षे तु समुत्पन्ने प्राश्निकान् संनिबोधत । यज्ञविन्नर्तकश्चैव छन्दोविच्छब्दवित्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20131746,
    "chapter_id": 7009,
    "verse_number": "27.66",
    "content_sanskrit": "अस्त्रविच्चित्रकृद्वेश्या गन्धर्वो रजसेवकः । यज्ञविद्यज्ञयोगे तु नर्तको ऽभिनये स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20131747,
    "chapter_id": 7009,
    "verse_number": "27.67",
    "content_sanskrit": "छन्दोविद्वृत्तबन्धेषु शब्दवित्पाठ्यविस्तरे । इष्वस्त्रवित्सौष्ठवे तु नेपथ्ये चैव चित्रकृत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20131748,
    "chapter_id": 7009,
    "verse_number": "27.68",
    "content_sanskrit": "कामोपचारे वेश्या च गान्धर्वः स्वरकर्मणि । सेवकस्तूपचारे स्यादेते वै प्राश्निकाः स्मृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20131749,
    "chapter_id": 7009,
    "verse_number": "27.69",
    "content_sanskrit": "एभिर्दृष्टान्तसंयुक्तैर्दोषा वाच्यास्तथा गुणाः । अशास्त्रज्ञा विवादेषु यथा प्रकृतिकर्मतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20131750,
    "chapter_id": 7009,
    "verse_number": "27.70",
    "content_sanskrit": "अथैते प्रश्निका ज्ञेयाः कथिता ये मयानघाः । शास्त्रज्ञानाद्यदा तु स्यात्संघर्षः शास्त्रसंश्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20131751,
    "chapter_id": 7009,
    "verse_number": "27.71",
    "content_sanskrit": "शास्त्रप्रामाणनिर्माणैर्व्यवहारो भवेत्तदा । भर्तृनियोगादन्यो ऽन्यविग्रात्स्पर्धयापि भरतानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20131752,
    "chapter_id": 7009,
    "verse_number": "27.72",
    "content_sanskrit": "अर्थपताका हेतोस्संघर्षो नाम संभवति । तेषां कार्यं व्यवहारदर्शनं पक्षपातविरहेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20131753,
    "chapter_id": 7009,
    "verse_number": "27.73",
    "content_sanskrit": "कृत्वा पणं पताकां व्यवहारः स भवितव्यस्तु । सर्वैरनन्यमतिभिः सुखोपविष्टैश्च शुद्धभावैश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20131754,
    "chapter_id": 7009,
    "verse_number": "27.74",
    "content_sanskrit": "यैर्लेखकगमकसहायास्सह सिद्धिभिर्घाताः । नात्यासनैर्नदूरसंस्थितैः प्रेक्षकैस्तु भवितव्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20131755,
    "chapter_id": 7009,
    "verse_number": "27.75",
    "content_sanskrit": "तेषामासनयोगो द्वादशहस्तस्थितः कार्यः । यानि विहितानि पूर्वं सिद्धिस्थानानि तानि लक्ष्याणि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20131756,
    "chapter_id": 7009,
    "verse_number": "27.76",
    "content_sanskrit": "घाताश्च लक्षणीयाः प्रयोगतो नाट्ययोगे तु । दैवाद्घातसमुत्थाः परोत्थिता वा बुधैर्नवैर्लेख्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20131757,
    "chapter_id": 7009,
    "verse_number": "27.77",
    "content_sanskrit": "घाता नाट्यसमुत्था ह्यात्मसमुत्थास्तु लेख्याः स्युः । घाता यस्य त्वल्पाः संख्याताः सिद्धयश्च बहुलाः स्युः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20131758,
    "chapter_id": 7009,
    "verse_number": "27.78",
    "content_sanskrit": "विदितं कृत्वा राज्ञस्तस्मै देया पताका हि । सिध्यतिशयात्पताका समसिद्धौ पार्थिवाज्ञया देया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20131759,
    "chapter_id": 7009,
    "verse_number": "27.79",
    "content_sanskrit": "अथ नरपतिः समः स्यादुभयोरपि सा तदा देया । एवं विधिज्ञैर्यष्टव्यो व्यवहारः समञ्जसाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20131760,
    "chapter_id": 7009,
    "verse_number": "27.80",
    "content_sanskrit": "स्वस्थचित्तसुखासिनैः सुविशिष्टैर्गुणार्थिभिः । विमृश्य प्रेक्षकैर्ग्राह्यं सर्वरागपराङ्गमुखैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20131761,
    "chapter_id": 7009,
    "verse_number": "27.81",
    "content_sanskrit": "साधन दूषणाभासः प्रयोगसमयाश्रितैः । समत्वमङ्गमाधुर्यं पाठ्यं प्रकृतयो रसाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20131762,
    "chapter_id": 7009,
    "verse_number": "27.82",
    "content_sanskrit": "वाद्यं गानं सनेपथ्यमेतज्ज्ञेयं प्रयत्नतः । गीतवादित्रतालेन कलान्तरकलासु च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20131763,
    "chapter_id": 7009,
    "verse_number": "27.83",
    "content_sanskrit": "उअदङ्गं क्रियते नाट्यं समन्तात् सममुच्यते । अङ्गोपाङ्गसमायुक्तं गीतताललयान्वितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20131764,
    "chapter_id": 7009,
    "verse_number": "27.84",
    "content_sanskrit": "गानवाद्यसमत्वं च तद्बुधैः सममुच्यते । सनिर्भुग्नमुरः कृत्वा चतुरश्रक्रुतौ करौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20131765,
    "chapter_id": 7009,
    "verse_number": "27.85",
    "content_sanskrit": "ग्रीवाञ्चिता तथा कर्या त्वङ्गमाधुर्यमेव च । पूर्व्रोक्तानीह शेषाणि यानि द्रव्याणि साधकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20131766,
    "chapter_id": 7009,
    "verse_number": "27.86",
    "content_sanskrit": "वद्यादीनां पुनर्वुप्रा लक्षणं सन्निबोधत । वाद्यप्रभृतयो गानं वाद्यमाणानि निर्दिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20131767,
    "chapter_id": 7009,
    "verse_number": "27.87",
    "content_sanskrit": "यानि स्थानानि सिद्धीनां तैः सिद्धिं तु प्रकाशयेत् । हर्षादङ्गसमुद्भूतां नानारससमुत्थिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20131768,
    "chapter_id": 7009,
    "verse_number": "27.88",
    "content_sanskrit": "वारकालास्तु विज्ञेया नाट्यज्ञैर्विविधाश्रयाः । दिवसैश्चैव रात्रिश्च तयोर्वारान् निबोधत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20131769,
    "chapter_id": 7009,
    "verse_number": "27.89",
    "content_sanskrit": "पूर्वाह्णस्त्वथ मध्याह्नस्त्वपराह्णस्तथैव च । दिवा समुत्था विज्ञेया नाट्यवाराः प्रयोगतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20131770,
    "chapter_id": 7009,
    "verse_number": "27.90",
    "content_sanskrit": "प्रादोषिकार्धरात्रिश्च तथा प्राभातिको ऽपरः । नाट्यवारा भवन्त्येते रात्रावित्यनुपूर्वशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20131771,
    "chapter_id": 7009,
    "verse_number": "27.91",
    "content_sanskrit": "एतेषां अत्र यद्योज्यं नाट्यकार्यं रसाश्रयम् । तदहं संप्रवक्ष्यामि वारकालसमाश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20131772,
    "chapter_id": 7009,
    "verse_number": "27.92",
    "content_sanskrit": "यच्छ्रोत्ररमणीयं स्याद्धर्मोत्थनकृतं च यत् । पूर्वाह्णे तत्प्रयोक्तव्यं शुद्धं वा विकृतं तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20131773,
    "chapter_id": 7009,
    "verse_number": "27.93",
    "content_sanskrit": "सत्त्वोत्थानगुणैर्युक्तं वाद्यभूयिष्ठमेव च । पुष्कलं सत्त्वयुक्तं च अपराह्णे प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20131774,
    "chapter_id": 7009,
    "verse_number": "27.94",
    "content_sanskrit": "कैशिकीवृत्तिसंयुक्तं शृङ्गारससंश्रयम् । नृत्यवादित्रगीताढ्यं प्रदोषे नाट्यमिष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20131775,
    "chapter_id": 7009,
    "verse_number": "27.95",
    "content_sanskrit": "यन्नर्महास्यबहुलं करुणप्रायमेव च । प्रभातकाले तत्कार्यं नाट्यं निद्राविनाशनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20131776,
    "chapter_id": 7009,
    "verse_number": "27.96",
    "content_sanskrit": "अर्धरात्रे नियुञ्जीत समध्याह्ने तथैव च । सन्ध्याभोजनकाले च नाट्यं नैव प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20131777,
    "chapter_id": 7009,
    "verse_number": "27.97",
    "content_sanskrit": "एवं कालं च देशं च समीक्ष्य च बलाबलम् । नित्यं नाट्यं प्रयुञ्जीत यथाभावं यथारसम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20131778,
    "chapter_id": 7009,
    "verse_number": "27.98",
    "content_sanskrit": "अथव देशकालौ च न परीक्ष्यौ प्रयोक्तृभिः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20131779,
    "chapter_id": 7009,
    "verse_number": "27.99",
    "content_sanskrit": "तथा समुदिआताश्चैव विज्ञेया नाटकाश्रिताः । पात्रं प्रयोगमृद्धिश्च विज्ञेयास्तु त्रयो गुणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20131780,
    "chapter_id": 7009,
    "verse_number": "27.100",
    "content_sanskrit": "बुद्धिमत्वं सुरूपत्वं लयतालज्ञता तथा । रसभावज्ञता चैव वयस्स्थत्वं कुतूहलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20131781,
    "chapter_id": 7009,
    "verse_number": "27.101",
    "content_sanskrit": "ग्रहणं धारणं चैव गात्रावैकल्यमेव च । निजसाध्वसतोत्साह इति पात्रगतो विधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20131782,
    "chapter_id": 7009,
    "verse_number": "27.102",
    "content_sanskrit": "सुवाद्यता सुगानत्वं सुपाठ्यत्वं तथैव च । शास्त्रकर्मसमायोगः प्रयोग इति संज्ञितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20131783,
    "chapter_id": 7009,
    "verse_number": "27.103",
    "content_sanskrit": "शुचिभूषणतायां तु माल्याभरणवाससाम् । विचित्ररचना चैव समृद्धिरिति संज्ञिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20131784,
    "chapter_id": 7009,
    "verse_number": "27.104",
    "content_sanskrit": "यदा समुदिताः सर्वे एकीभूता भवन्ति हि । अलङ्काराः सकुतपा मन्तव्यो नाटकाश्रयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20131785,
    "chapter_id": 7009,
    "verse_number": "27.105",
    "content_sanskrit": "एतदुक्तं द्विजश्रेष्ठाः सिद्धीनां लक्षणं मया । अत ऊर्ध्वं प्रवक्ष्याम्यातोद्यानां विकल्पनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20131786,
    "chapter_id": 7009,
    "verse_number": "27.106",
    "content_sanskrit": "इति भारतीये नाट्यशास्त्रे सिद्धिव्यञ्जको नाम सप्तविंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  }
]