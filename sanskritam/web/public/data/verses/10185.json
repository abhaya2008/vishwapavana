[{"id": 6000185000, "chapter_id": 10185, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000185001, "chapter_id": 10185, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.001.m4a", "display_order": 2}, {"id": 6000185002, "chapter_id": 10185, "verse_number": "९-१०-१", "content_sanskrit": "कुशस्य चातिथिस्तस्मान्निषधस्तत्सुतो नभः।\nपुण्डरीकोऽथ तत्पुत्रः क्षेमधन्वाऽभवत् ततः॥ ९/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.002.m4a", "display_order": 3, "topics": [{"text": "अतीतानामनागतानां च रामवंश्यानां कथनम्", "range": "१"}]}, {"id": 6000185003, "chapter_id": 10185, "verse_number": "९-१०-२", "content_sanskrit": "देवानीकस्ततोऽहीनः पारिपात्रश्च तत्सुतः।\nततो बलस्थलस्तस्माद् वज्रनाभोऽर्कसम्भवः॥ ९/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.003.m4a", "display_order": 4}, {"id": 6000185004, "chapter_id": 10185, "verse_number": "९-१०-३", "content_sanskrit": "खगणस्तत्सुतस्तस्माद् विधृतश्चाभवत् सुतः।\nततो हिरण्यनाभोऽभूद् योगाचार्यस्तु जैमिनेः॥ ९/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.004.m4a", "display_order": 5}, {"id": 6000185005, "chapter_id": 10185, "verse_number": "९-१०-४", "content_sanskrit": "शिष्यः सकलमध्यात्मं याज्ञवल्क्योऽध्यगाद् यतः।\nयोगं महोदयमृषिर्हृदयग्रन्थिभेदनम्॥ ९/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.005.m4a", "display_order": 6}, {"id": 6000185006, "chapter_id": 10185, "verse_number": "९-१०-५", "content_sanskrit": "पुष्यो हिरण्यनाभस्य ध्रुवसन्धिस्ततोऽभवत्।\nसुदर्शनोऽथाग्निवर्णः शीघ्रस्तस्य मरुत् सुतः॥ ९/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.006.m4a", "display_order": 7}, {"id": 6000185007, "chapter_id": 10185, "verse_number": "९-१०-६", "content_sanskrit": "योऽसावास्ते योगसिद्धः कलापग्राममास्थितः।\nकलेरन्ते सूर्यवंशं नष्टं भावयिता पुनः॥ ९/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.007.m4a", "display_order": 8}, {"id": 6000185008, "chapter_id": 10185, "verse_number": "९-१०-७", "content_sanskrit": "तस्मात् तु सुश्रुतस्तस्य सन्धिस्तस्यापि मर्षणः।\nमहस्वांस्तत्सुतस्तस्माद् विश्वसाह्वानजायत॥ ९/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.008.m4a", "display_order": 9}, {"id": 6000185009, "chapter_id": 10185, "verse_number": "९-१०-८", "content_sanskrit": "ततो बृहद्बलो यस्तु पित्रा ते समरे हतः।\nएते हीक्ष्वाकुभूपाला अतीताः शृण्वनागतान्॥ ९/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.009.m4a", "display_order": 10}, {"id": 6000185010, "chapter_id": 10185, "verse_number": "९-१०-९", "content_sanskrit": "बृहद्बलस्य भविता पुत्रो नाम्ना बृहद्रणः।\nउरुक्षयः सुतस्तस्य वसुप्रीतिर्भविष्यति॥ ९/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.010.m4a", "display_order": 11}, {"id": 6000185011, "chapter_id": 10185, "verse_number": "९-१०-१०", "content_sanskrit": "प्रतिव्योमस्ततो भानुर्दिवार्को वाहिनीपतिः।\nसहदेवस्ततो भावी बृहदश्वोऽथ भानुमान्॥ ९/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.011.m4a", "display_order": 12}, {"id": 6000185012, "chapter_id": 10185, "verse_number": "९-१०-११", "content_sanskrit": "प्रतीकाश्वो भानुमतः सुप्रतीकोऽथ तत्सुतः।\nभविता मरुदेवोऽथ सुनक्षत्रोऽथ रुक्षकः॥ ९/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.012.m4a", "display_order": 13}, {"id": 6000185013, "chapter_id": 10185, "verse_number": "९-१०-१२", "content_sanskrit": "तस्यान्तरिक्षस्तत्पुत्रः सुतपास्तदमित्रजित्।\nबृहद्भोजस्तु तस्यापि बर्हिस्तस्मात् कृतञ्जयः॥ ९/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.013.m4a", "display_order": 14}, {"id": 6000185014, "chapter_id": 10185, "verse_number": "९-१०-१३", "content_sanskrit": "रणञ्जयस्तस्य सुतः सञ्जयो भविता ततः।\nतस्माच्छक्तोऽथ शुद्धोदो लाङ्गलस्तत्सुतः स्मृतः॥ ९/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.014.m4a", "display_order": 15}, {"id": 6000185015, "chapter_id": 10185, "verse_number": "९-१०-१४", "content_sanskrit": "ततः प्रसेनजित् तस्माद् क्षुद्रको भविता ततः। कुणको भविता तस्मात् सुरथस्तनयस्ततः।\nसुमित्रो नाम निष्ठान्तस्त्वेते बार्हद्बला नृपाः॥ ९/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.015.m4a", "display_order": 16}, {"id": 6000185016, "chapter_id": 10185, "verse_number": "९-१०-१५", "content_sanskrit": "इक्ष्वाकूणामयं वंशः सुमित्रान्तो भविष्यति।\nयतस्तं प्राप्य राजानं संस्थां प्राप्स्यति वै कलौ॥ ९/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_010/BhP_09.010.016.m4a", "display_order": 17}, {"id": 6000185017, "chapter_id": 10185, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे दशमाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]