[{"id": 50020081, "chapter_id": 11654, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50020082, "chapter_id": 11654, "verse_number": "2", "content_sanskrit": "सरस्वत्यास्तटे राजन् ऋषयः सत्रमासत। वितर्कः समभूत् तेषां त्रिष्वधीशेषु को महान्॥ १०/९३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50020083, "chapter_id": 11654, "verse_number": "3", "content_sanskrit": "तस्य जिज्ञासया ते वै भृगुं ब्रह्मसुतं नृप। तज्ज्ञप्त्यै प्रेषयामासुः सोऽभ्यगाद् ब्रह्मणः सभाम्॥ १०/९३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50020084, "chapter_id": 11654, "verse_number": "4", "content_sanskrit": "न तस्मै ब्रह्मणे स्तोत्रं चक्रे सत्वपरीक्षया। तस्मै चुक्रोध भगवान् प्रज्वलन् स्वेन तेजसा॥ १०/९३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50020085, "chapter_id": 11654, "verse_number": "5", "content_sanskrit": "स आत्मन्युत्थितं मन्युमात्मजायात्मनः प्रभुः। अशीशमद् यथा वह्निं शमयेद् वारिणा प्रभुः॥ १०/९३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50020086, "chapter_id": 11654, "verse_number": "6", "content_sanskrit": "ततः कैलासमगमत् स तं देवो महेश्वरः। परिरब्धुं समारेभे उत्थाय भ्रातरं मुदा॥ १०/९३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50020087, "chapter_id": 11654, "verse_number": "7", "content_sanskrit": "नैच्छत् तमशुभाचार इति देवश्चुकोप ह। शूलमुद्यम्य तं हन्तुमारेभे तिग्मलोचनः॥ १०/९३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50020088, "chapter_id": 11654, "verse_number": "8", "content_sanskrit": "पतित्वा पादयोर्देवी शमयामास तं गिरा। इति कृच्छ्रात् ततो मुक्तः कैलासाद् रजताचलात्॥ १०/९३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50020089, "chapter_id": 11654, "verse_number": "9", "content_sanskrit": "मुनिर्जगाम वैकुण्ठं यत्र देवो जनार्दनः। शयानं श्रिय उत्सङ्गे पदा वक्षस्यताडयत्॥ १०/९३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50020090, "chapter_id": 11654, "verse_number": "10", "content_sanskrit": "तत उत्थाय भगवान् सह लक्ष्म्या सतां गतिः। स्वतल्पादवरुह्याशु ननाम शिरसा मुनिम्॥ १०/९३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50020091, "chapter_id": 11654, "verse_number": "11", "content_sanskrit": "आह ते स्वागतं ब्रह्मन् निषीदात्रासने क्षणम्। अजानतामागसं नः क्षन्तुमर्हसि मानद॥ १०/९३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50020092, "chapter_id": 11654, "verse_number": "12", "content_sanskrit": "पुनीहि सहलोकं मां लोकपालांश्च मद्गतान्। पादोदकेन भवतस्तीर्थानां तीर्थकारिणा॥ १०/९३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50020093, "chapter_id": 11654, "verse_number": "13", "content_sanskrit": "अद्याहं भगवन् लक्ष्म्या आसमेकान्तभाजनम्। वत्स्यत्युरसि नो भूतिर्भवत्पादहतांहसि॥ १०/९३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50020094, "chapter_id": 11654, "verse_number": "14", "content_sanskrit": "श्रीवत्समिति नामापि जायतां पादलक्षणम्॥ १०/९३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50020095, "chapter_id": 11654, "verse_number": "15", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50020096, "chapter_id": 11654, "verse_number": "16", "content_sanskrit": "एवं ब्रुवाणे वैकुण्ठे भृगुस्तत्सार्द्रया गिरा। निर्वृत४स्तर्पितस्तूष्णीं भक्त्युत्कण्ठोऽश्रुलोचनः॥ १०/९३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50020097, "chapter_id": 11654, "verse_number": "17", "content_sanskrit": "पुनः स्वसत्रमासाद्य मुनीनां ब्रह्मवादिनाम्। स्वानुभूतमशेषेण राजन् भृगुरवर्णयत्॥ १०/९३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50020098, "chapter_id": 11654, "verse_number": "18", "content_sanskrit": "तं निशम्याथ मुनयो विस्मिता मुक्तसंशयाः। भूयांसं श्रद्दधुर्विष्णुं यतः शान्तिर्यतोऽभयम्॥ १०/९३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50020099, "chapter_id": 11654, "verse_number": "19", "content_sanskrit": "धर्मः साक्षाद् यतो ज्ञानं वैराग्यं च चतुर्विधम्। ≠श्वर्यं चाष्टधा यस्माद् यशश्चात्ममलापहम्॥ १०/९३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50020100, "chapter_id": 11654, "verse_number": "20", "content_sanskrit": "मुनीनां न्यस्तदण्डानां शान्तानां समचेतसाम्। अकिञ्चनानां साधूनां यमाहुः परमां गतिम्॥ १०/९३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50020101, "chapter_id": 11654, "verse_number": "21", "content_sanskrit": "सत्वं यस्य प्रिया मूर्तिर्ब्राह्मणास्त्विष्टदेवताः। भजन्त्यनाशिषः शान्ता यं वा निपुणबुद्धयः॥ १०/९३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50020102, "chapter_id": 11654, "verse_number": "22", "content_sanskrit": "त्रिविधा मूर्तयस्तस्य राक्षसा असुराः सुराः। गुणास्तन्मायया सृष्टाः सत्वं तत्रार्यदर्शनम्॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50020103, "chapter_id": 11654, "verse_number": "23", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50020104, "chapter_id": 11654, "verse_number": "24", "content_sanskrit": "इत्थं सारस्वता विप्रा नृणां संशयनुत्तये। पुरुषस्य पदाम्भोजसेवया तद्गतिं गताः॥ १०/९३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50020105, "chapter_id": 11654, "verse_number": "25", "content_sanskrit": "इत्येतन्मुनितनयस्य पदम्गर्भपीयूषं भवभयभित् परस्य पुंसः। सुश्लोकैः श्रवणपुटैः पिबन्नभीक्ष्णं पान्थोऽथ भ्रमणपरिश्रमं जहाति॥ १०/९३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50020106, "chapter_id": 11654, "verse_number": "26", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे त्रिनवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]