[{"id": 2001491, "chapter_id": 1025, "verse_number": "१-२६-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001492, "chapter_id": 1025, "verse_number": "१-२६-१", "content_sanskrit": "एवं स्तुतस्तदा कद्र्वा भगवान्हरिवाहनः।\nनीलजीमूतसंघातैः सर्वमम्बरमावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001493, "chapter_id": 1025, "verse_number": "१-२६-२", "content_sanskrit": "मेघानाज्ञापयामास वर्षध्वममृतं शुभम्।\nते मेघा मुमुचुस्तोयं प्रभूतं विद्युदुज्ज्वलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001494, "chapter_id": 1025, "verse_number": "१-२६-३", "content_sanskrit": "परस्परमिवात्यर्थं गर्जन्तः सततं दिवि।\nसंवर्तितमिवाकाशं जलदैः सुमहाद्भुतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001495, "chapter_id": 1025, "verse_number": "१-२६-४", "content_sanskrit": "सृजद्भिरतुलं तोयमजस्रं सुमहारवैः।\nसंप्रनृत्तमिवाकाशं धारोर्मिभिरनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001496, "chapter_id": 1025, "verse_number": "१-२६-५", "content_sanskrit": "मेघस्तनितनिर्घोषौर्विद्युत्पवनकम्पितैः।\nतैर्मेघैः सततासारं वर्षद्भिरनिशं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001497, "chapter_id": 1025, "verse_number": "१-२६-६", "content_sanskrit": "नष्टचन्द्रार्ककिरणमम्बरं समपद्यत।\nनागानामुत्तमो हर्षस्तथा वर्षति वासवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001498, "chapter_id": 1025, "verse_number": "१-२६-७", "content_sanskrit": "आपूर्यत मही चापि सलिलेन समन्ततः।\nरसातलमनुप्राप्तं शीतलं विमलं जलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001499, "chapter_id": 1025, "verse_number": "१-२६-८", "content_sanskrit": "तदा भूरभवच्छन्ना जलोर्मिभिरनेकशः।\nरामणीयकमागच्छन्मात्रा सह भुजंगमाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001500, "chapter_id": 1025, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि षड्विंशोऽध्यायः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]