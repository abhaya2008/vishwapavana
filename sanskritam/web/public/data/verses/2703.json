[{"id": 2080005, "chapter_id": 2703, "verse_number": "१२-२०८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080006, "chapter_id": 2703, "verse_number": "१२-२०८-१", "content_sanskrit": "पितामह महाप्राज्ञ युधि सत्यपराक्रम।\nश्रोतुमिच्छामि कार्त्स्न्येन वृष्णमव्ययमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080007, "chapter_id": 2703, "verse_number": "१२-२०८-२", "content_sanskrit": "यच्चास्य तेजः सुमहद्यच्च कर्म पुरा कृतम्।\nतन्मे सर्वं यथातत्त्वं ब्रूहि त्वं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080008, "chapter_id": 2703, "verse_number": "१२-२०८-३", "content_sanskrit": "तिर्यग्योनिगतो रूपं कथं धारितवान्प्रभुः।\nकेन कार्यनिसर्गेण तमाख्याहि महाबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080009, "chapter_id": 2703, "verse_number": "१२-२०८-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080010, "chapter_id": 2703, "verse_number": "१२-२०८-४", "content_sanskrit": "पुराऽहं मृगयां यातो मार्कण्डेयाश्रमे स्थितः।\nतत्रापश्यं मुनिगणान्समासीनान्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080011, "chapter_id": 2703, "verse_number": "१२-२०८-५", "content_sanskrit": "ततस्ते मधुपर्केण पूजां चक्रुरथो मयि।\nप्रतिगृह्य च तां पूजां चक्रुरथो मयि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080012, "chapter_id": 2703, "verse_number": "१२-२०८-६", "content_sanskrit": "कथैषा कथिता तत्र कश्यपेन महर्षिणा।\nमनः प्रह्वादिनीं दिव्यां तामिहैकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080013, "chapter_id": 2703, "verse_number": "१२-२०८-७", "content_sanskrit": "पुरा दानवमुख्या हि क्रोधलोभसमन्विताः।\nबलेन मत्ताः शतशो नरकाद्या महासुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080014, "chapter_id": 2703, "verse_number": "१२-२०८-८", "content_sanskrit": "तथैव चान्ये बहवो दानवा युद्धदुर्मदाः।\nन सहन्ते स्म देवानां समृद्धिं तामनुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080015, "chapter_id": 2703, "verse_number": "१२-२०८-९", "content_sanskrit": "`नराकाद्या महाघोरा हिरण्याक्षमुपाश्रिताः।\nउद्योगं परमं चक्रुर्देवानां निग्रहे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080016, "chapter_id": 2703, "verse_number": "१२-२०८-१०", "content_sanskrit": "नियुतं वत्सराणां तु वायुभक्षोऽभवत्तदा।\nहिरण्याक्षो महारौद्रो लेभे देवात्पितामहात्।\nवरानचिन्त्यानतुलाञ्शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080017, "chapter_id": 2703, "verse_number": "१२-२०८-११", "content_sanskrit": "दानवैरर्द्यमानास्तु देवा देवर्षयस्तथा।\nन शर्म लेभिरे राजन्क्लिश्यमानास्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080018, "chapter_id": 2703, "verse_number": "१२-२०८-१२", "content_sanskrit": "पृथिवीमार्तरूपां ते समपश्यन्दिवौकसः।\nदानवैरभिसंकीर्णां घोररूपैर्महाबलैः।\nभारार्तामप्रहृष्टां च दुःखितां संनिमज्जतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080019, "chapter_id": 2703, "verse_number": "१२-२०८-१३", "content_sanskrit": "`गृहीत्वा पृथिवी देवी पाताले न्यवसत्तदा।\nततस्त्रैलोक्यमखिलं निरोषधिगणान्वितम्।\nनिःस्वाध्यायवषट्कारमभूत्सर्वं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080020, "chapter_id": 2703, "verse_number": "१२-२०८-१४", "content_sanskrit": "अथादितेयाः संत्रस्ता ब्रह्माणमिदमब्रुवन्।\nकथं शक्ष्यामहे ब्रह्मन्दानवैरभिमर्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080021, "chapter_id": 2703, "verse_number": "१२-२०८-१५", "content_sanskrit": "`हिरण्याक्षेण भगवन्गृहीतेयं वसुन्धरा।\nन शक्ष्यामो वयं तत्र प्रवेष्टुं जलदुर्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080022, "chapter_id": 2703, "verse_number": "१२-२०८-१६", "content_sanskrit": "तानाह भगवान्ब्रह्मा मुनिरेव प्रसाद्यताम्।\nअगस्त्योऽसौ महातेजाः पातु तज्जलमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080023, "chapter_id": 2703, "verse_number": "१२-२०८-१७", "content_sanskrit": "तथेति चोक्त्वा ते देवा मुनिमूचुर्मुदान्विताः।\nत्रायस्व लोकान्विप्रर्षे जलमेतत्क्षयं नय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080024, "chapter_id": 2703, "verse_number": "१२-२०८-१८", "content_sanskrit": "तथेति चोक्त्वा भगवान्कालानलसमद्युतिः।\nध्यायञ्जलादनिवहं स क्षणेन पपौ जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080025, "chapter_id": 2703, "verse_number": "१२-२०८-१९", "content_sanskrit": "शोषिते तु समुद्रे च देवाः सर्षिपुरोगमाः।\nब्रह्माणं प्रणिपत्योचुर्मुनिना शोषितं जलम्।\nइति भूयः समाचक्ष्व किं करिष्यामहे विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080026, "chapter_id": 2703, "verse_number": "१२-२०८-२०", "content_sanskrit": "स्वयंभूस्तानुवाचेदं निसृष्टोऽत्र विधिर्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080027, "chapter_id": 2703, "verse_number": "१२-२०८-२१", "content_sanskrit": "ते वरेणाभिसंपन्ना बलेन च मदेन च।\nनावबुद्ध्यन्ति संमूढा विष्णुमव्यक्तदर्शनम्।\nवराहरूपिणं देवमधृष्यममरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080028, "chapter_id": 2703, "verse_number": "१२-२०८-२२", "content_sanskrit": "एष वेगेन गत्वा हि यत्र ते दानवाधमाः।\nअन्तर्भूमिगता घोरा निवसन्ति सहस्रशः।\nशमयिष्यति तच्छ्रुत्वा जहृषुः सुरसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080029, "chapter_id": 2703, "verse_number": "१२-२०८-२३", "content_sanskrit": "ततो विष्णुर्महातेजा वाराहं रूपमास्थितः।\nअन्तर्भूमिं संप्रविश्य जगाम दितिजान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080030, "chapter_id": 2703, "verse_number": "१२-२०८-२४", "content_sanskrit": "दृष्ट्वा च सहिताः सर्वे दैत्याः सत्वममानुषम्।\nप्रसह्य तरसा सर्वे संतस्थुः कालमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080031, "chapter_id": 2703, "verse_number": "१२-२०८-२५", "content_sanskrit": "ततस्ते समभिद्रुत्य वराहं जगृहुः समम्।\nसंक्रुद्धाश्च वराहं तं व्यकर्षन्त समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080032, "chapter_id": 2703, "verse_number": "१२-२०८-२६", "content_sanskrit": "दानवेन्द्रा महाकाया महावीर्यबलोच्छ्रिताः।\nनाशक्नुवंश्च किंचित्ते तस्य कर्तुं तदा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080033, "chapter_id": 2703, "verse_number": "१२-२०८-२७", "content_sanskrit": "ततोऽगच्छन्विस्मयं ते दानवेन्द्रा भयं तथा।\nसंशयं गतमात्मानं मेनिरे च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080034, "chapter_id": 2703, "verse_number": "१२-२०८-२८", "content_sanskrit": "ततो देवाधिदेवः स योगात्मा योगसारथिः।\nयोगमास्थाय भगवांस्तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080035, "chapter_id": 2703, "verse_number": "१२-२०८-२९", "content_sanskrit": "विननाद महानादं क्षोभयन्दैत्यदानवान्।\nसन्नादिता येन लोकाः सर्वाश्चैव दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080036, "chapter_id": 2703, "verse_number": "१२-२०८-३०", "content_sanskrit": "तेन सन्नादशब्देन लोकानां क्षोभ आगमत्।\nसंश्रान्ताश्च दिशः सर्वा देवाः शक्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080037, "chapter_id": 2703, "verse_number": "१२-२०८-३१", "content_sanskrit": "निर्विचेष्टं जगच्चापि बभूवातिभृशं तदा।\nस्थावरं जङ्गमं चैव तेन नादेन मोहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080038, "chapter_id": 2703, "verse_number": "१२-२०८-३२", "content_sanskrit": "ततस्ते दानवाः सर्वे तेन नादेन भीषिताः।\nपेतुर्गतासवश्चैव विष्णुतेजः प्रमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080039, "chapter_id": 2703, "verse_number": "१२-२०८-३३", "content_sanskrit": "`त्रस्तांश्च देवानालोक्य ब्रह्मा प्राह पितामहः।\nयोगेश्वरोऽयं भगवान्वाराहं रूपमास्थितः।\nनर्दमानोऽत्र संयाति मा भैष्ट सुरसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080040, "chapter_id": 2703, "verse_number": "१२-२०८-३४", "content_sanskrit": "एवमुक्त्वा ततो ब्रह्मा नमश्चक्रे पितामहः।\nदेवता मुनयश्चैव विष्णुं वै मुक्तिहेतवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080041, "chapter_id": 2703, "verse_number": "१२-२०८-३५", "content_sanskrit": "ततो हरिर्महातेजा ब्रह्माणमभिनन्द्य च।\nरसातलगतश्चापि वराहस्त्रिदशद्विषाम्।\nखुरैर्विदारयामास मांसमेदोस्थिसंचयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080042, "chapter_id": 2703, "verse_number": "१२-२०८-३६", "content_sanskrit": "नादेन तेन महता सनातन इति स्मृतः।\nपद्मनाभो महायोगी भूतात्मा भूतभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080043, "chapter_id": 2703, "verse_number": "१२-२०८-३७", "content_sanskrit": "ततो देवगणाः सर्वे पितामहमुपाद्रवन्।\nतत्र गत्वा महात्मानमूचुश्चैव जगत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080044, "chapter_id": 2703, "verse_number": "१२-२०८-३८", "content_sanskrit": "नादोऽयं कीदृशो देव नेतं विद्म वयं प्रभो।\nकोसौ हि कस्य वा नादो येन विह्वलितं जगत्।\nदेवाश्च दानवाश्चैव मोहितास्तस्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080045, "chapter_id": 2703, "verse_number": "१२-२०८-३९", "content_sanskrit": "एतस्मिन्नन्तरे विष्णुर्वाराहं रूपमास्थितः।\nउदतिष्ठन्महाबाहो स्तूयमानो महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080046, "chapter_id": 2703, "verse_number": "१२-२०८-४०x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080047, "chapter_id": 2703, "verse_number": "१२-२०८-४०", "content_sanskrit": "`दिव्यं------ युद्धमासीन्महात्मनोः।\nहिरण्याक्षस्य विष्णोश्च सर्वसंक्षोभकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080048, "chapter_id": 2703, "verse_number": "१२-२०८-४१", "content_sanskrit": "जघान च हिरण्याक्षमन्तर्भूमिगतं हरिः।\nतदाकर्ण्य महातेजा ब्रह्मा मधुरमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080049, "chapter_id": 2703, "verse_number": "१२-२०८-४२x", "content_sanskrit": "पीतामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080050, "chapter_id": 2703, "verse_number": "१२-२०८-४२", "content_sanskrit": "निहत्य दानवपतीन्महावर्ष्मा महाबलः।\nएष देवो महायोगी भूतात्मा भूतभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080051, "chapter_id": 2703, "verse_number": "१२-२०८-४३", "content_sanskrit": "सर्वभूतेश्वरो योगी मुनिरात्मा तथाऽऽत्मनः।\nस्थिरीभवत कृष्णोऽयं सर्वविध्नविनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080052, "chapter_id": 2703, "verse_number": "१२-२०८-४४", "content_sanskrit": "कृत्वा कर्मातिसाध्वेतदशक्यममितप्रभः।\nसमायातः स्वमात्मानं महाभागो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080053, "chapter_id": 2703, "verse_number": "१२-२०८-४५", "content_sanskrit": "पद्मनाभो महायोगी पुराणपुरुषोत्तमः।\nन संतापो न भीः कार्या शोको वा सुरसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080054, "chapter_id": 2703, "verse_number": "१२-२०८-४६", "content_sanskrit": "विधिरेष प्रभावश्च कालः संक्षयकारकः।\nलोकान्धारयता तेन नादो मुक्तो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080055, "chapter_id": 2703, "verse_number": "१२-२०८-४७", "content_sanskrit": "स एष हि महाबाहुः सर्वलोकनमस्कृतः।\nअच्युतः पुण़्डरीकाक्षः सर्वभूतादिरीश्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080056, "chapter_id": 2703, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टाधिकद्विशततमोऽध्यायः॥ २०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]