[{"id": 7001092000, "chapter_id": 21092, "verse_number": "२-१-३-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूतसूत महाभाग व्यासशिष्य नमोऽस्तु ते ।\nअद्भुतेयं कथा तात वर्णिता कृपया हि नः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001092001, "chapter_id": 21092, "verse_number": "२-१-३-२", "content_sanskrit": "मुनौ गते हरिस्तात किं चकार ततः परम् ।\nनारदोपि गतः कुत्र तन्मे व्याख्यातुमर्हसि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001092002, "chapter_id": 21092, "verse_number": "२-१-३-३", "content_sanskrit": "व्यास उवाच ।\nइत्याकर्ण्य वचस्तेषां सूतः पौराणिकोत्तमः ।\nप्रत्युवाच शिवं स्मृत्वा नानासूतिकरं बुधः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001092003, "chapter_id": 21092, "verse_number": "२-१-३-४", "content_sanskrit": "सूत उवाच ।\nमुनौ यदृच्छया विष्णुर्गते तस्मिन्हि नारदे ।\nशिवेच्छया चकाराशु माया मायाविशारदः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001092004, "chapter_id": 21092, "verse_number": "२-१-३-५", "content_sanskrit": "मुनिमार्गस्य मध्ये तु विरेचे नगरं महत् ।\nशतयोजनविस्तारमद्भुतं सुमनोहरम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001092005, "chapter_id": 21092, "verse_number": "२-१-३-६", "content_sanskrit": "स्वलोकादधिकं रम्यं नानावस्तुविराजितम् ।\nनरनारीविहाराढ्यं चतुर्वर्णाकुलं परम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001092006, "chapter_id": 21092, "verse_number": "२-१-३-७", "content_sanskrit": "तत्र राजा शीलनिर्धिर्नामैश्वर्यसमन्वितः ।\nसुतास्वयम्वरोद्युक्तो महोत्सवसमन्वितः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001092007, "chapter_id": 21092, "verse_number": "२-१-३-८", "content_sanskrit": "चतुर्दिग्भ्यः समायातैस्संयुतं नृपनन्दतैः ।\nनानावेषैस्सुशोभैश्च तत्कन्यावरणोत्सुकैः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001092008, "chapter_id": 21092, "verse_number": "२-१-३-९", "content_sanskrit": "एतादृशम्पुरं दृष्ट्वा मोहम्प्राप्तोऽथ नारदः ।\nकौतुकी तन्नृपद्वारं जगाम मदनेधितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001092009, "chapter_id": 21092, "verse_number": "२-१-३-१०", "content_sanskrit": "आगतं मुनिवर्यं तं दृष्ट्वा शीलनिधिर्नृपः ।\nउपवेश्यार्चयांचक्रे रत्नसिंहासने वरे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001092010, "chapter_id": 21092, "verse_number": "२-१-३-११", "content_sanskrit": "अथ राजा स्वतनयां नामतश्श्रीमतीं वराम् ।\nसमानीय नारदस्य पादयोस्समपातयत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001092011, "chapter_id": 21092, "verse_number": "२-१-३-१२", "content_sanskrit": "तत्कन्यां प्रेक्ष्य स मुनिर्नारदः प्राह विस्मितः ।\nकेयं राजन्महाभागा कन्या सुरसुतोपमा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001092012, "chapter_id": 21092, "verse_number": "२-१-३-१३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राजा प्राह कृतांजलिः ।\nदुहितेयं मम मुने श्रीमती नाम नामतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001092013, "chapter_id": 21092, "verse_number": "२-१-३-१४", "content_sanskrit": "प्रदानसमयं प्राप्ता वरमन्वेषती शुभम् ।\nसा स्वयंवरसंप्राप्ता सर्वलक्षणलक्षिता॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001092014, "chapter_id": 21092, "verse_number": "२-१-३-१५", "content_sanskrit": "अस्या भाग्यं वद मुने सर्वं जातकमादरात् ।\nकीदृशं तनयेयं मे वरमाप्स्यति तद्वद॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001092015, "chapter_id": 21092, "verse_number": "२-१-३-१६", "content_sanskrit": "इत्युक्तो मुनिशार्दूलस्तामिच्छुः कामविह्वलः ।\nसमाभाष्य स राजानं नारदो वाक्यमब्रवीत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001092016, "chapter_id": 21092, "verse_number": "२-१-३-१७", "content_sanskrit": "सुतेयं तव भूपाल सर्वलक्षणलक्षिता ।\nमहाभाग्यवती धन्या लक्ष्मीरिव गुणालया॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001092017, "chapter_id": 21092, "verse_number": "२-१-३-१८", "content_sanskrit": "सर्वेश्वरोऽजितो वीरो गिरीशसदृशो विभुः ।\nअस्याः पतिर्ध्रुवं भावी कामजित्सुरसत्तमः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001092018, "chapter_id": 21092, "verse_number": "२-१-३-१९", "content_sanskrit": "इत्युक्त्वा नृपमामंत्र्य ययौ यादृच्छिको मुनिः ।\nबभूव कामविवशश्शिवमाया विमोहितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001092019, "chapter_id": 21092, "verse_number": "२-१-३-२०", "content_sanskrit": "चित्ते विचिन्त्य स मुनिराप्नुयां कथमेनकाम् ।\nस्वयंवरे नृपालानामेकं मां वृणुयात्कथम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001092020, "chapter_id": 21092, "verse_number": "२-१-३-२१", "content_sanskrit": "सौन्दर्यं सर्वनारीणां प्रियं भवति सर्वथा ।\nतद्दृष्ट्वैव प्रसन्ना सा स्ववशा नात्र संशयः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001092021, "chapter_id": 21092, "verse_number": "२-१-३-२२", "content_sanskrit": "विधायेत्थं विष्णुरूपं ग्रहीतुं मुनिसत्तमः ।\nविष्णुलोकं जगामाशु नारदः स्मरविह्वलः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001092022, "chapter_id": 21092, "verse_number": "२-१-३-२३", "content_sanskrit": "प्रणिपत्य हृषीकेशं वाक्यमेतदुवाच ह ।\nरहसि त्वां प्रवक्ष्यामि स्ववृत्तान्तमशेषतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001092023, "chapter_id": 21092, "verse_number": "२-१-३-२४", "content_sanskrit": "तथेत्युक्ते तथा भूते शिवेच्छा कार्यकर्त हि ।\nब्रूहीत्युक्तवति श्रीशे मुनिराह च केशवम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001092024, "chapter_id": 21092, "verse_number": "२-१-३-२५", "content_sanskrit": "नारद उवाच ।\nत्वदीयो भूपतिः शीलनिधिस्स वृषतत्परः ।\nतस्य कन्या विशालाक्षी श्रीमतीवरवर्णिनी॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001092025, "chapter_id": 21092, "verse_number": "२-१-३-२६", "content_sanskrit": "जगन्मोहिन्यभिख्याता त्रैलोक्येप्यति सुन्दरी ।\nपरिणेतुमहं विष्णो तामिच्छाम्यद्य मा चिरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001092026, "chapter_id": 21092, "verse_number": "२-१-३-२७", "content_sanskrit": "स्वयंवरं चकरासौ भूपतिस्तनयेच्छया ।\nचतुर्दिग्भ्यः समायाता राजपुत्रास्सहस्रशः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001092027, "chapter_id": 21092, "verse_number": "२-१-३-२८", "content_sanskrit": "यदि दास्यसि रूपं मे तदा तां प्राप्नुयां ध्रुवम् ।\nत्वद्रूपं सा विना कंठे जयमालां न धास्यति॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001092028, "chapter_id": 21092, "verse_number": "२-१-३-२९", "content_sanskrit": "स्वरूपं देहि मे नाथ सेवकोऽहं प्रियस्तव ।\nवृणुयान्मां यथा सा वै श्रीमती क्षितिपात्मजा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001092029, "chapter_id": 21092, "verse_number": "२-१-३-३०", "content_sanskrit": "सुत उवाच॥ वचः श्रुत्वा मुनेरित्थं विहस्य मधुसूदनः  ।\nशांकरीं प्रभुतां बुद्ध्वा प्रत्युवाच दयापरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001092030, "chapter_id": 21092, "verse_number": "२-१-३-३१", "content_sanskrit": "विष्णुरुवाच ।\nस्वेष्टदेशं मुने गच्छ करिष्यामि हितं तव ।\nभिषग्वरो यथार्त्तस्य यतः प्रियतरोऽसि मे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001092031, "chapter_id": 21092, "verse_number": "२-१-३-३२", "content_sanskrit": "इत्युक्त्वा मुनये तस्मै ददौ विष्णुर्मुखं हरे ।\nस्वरूपमनुगृह्यास्य तिरोधानं जगाम सः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001092032, "chapter_id": 21092, "verse_number": "२-१-३-३३", "content_sanskrit": "एवमुक्तो मुनिर्हृष्टः स्वरूपं प्राप्य वै हरेः ।\nमेने कृतार्थमात्मानं तद्यत्नं न बुबोध सः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001092033, "chapter_id": 21092, "verse_number": "२-१-३-३४", "content_sanskrit": "अथ तत्र गतः शीघ्रन्नारदो मुनिसत्तमः ।\nचक्रे स्वयम्वरं यत्र राजपुत्रैस्समाकुलम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001092034, "chapter_id": 21092, "verse_number": "२-१-३-३५", "content_sanskrit": "स्वयम्वरसभा दिव्या राजपुत्रसमावृता ।\nशुशुभेऽतीव विप्रेन्द्रा यथा शक्रस भा परा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001092035, "chapter_id": 21092, "verse_number": "२-१-३-३६", "content_sanskrit": "तस्यां नृपसभायां वै नारदः समुपाविशत् ।\nस्थित्वा तत्र विचिन्त्येति प्रीतियुक्तेन चेतसा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001092036, "chapter_id": 21092, "verse_number": "२-१-३-३७", "content_sanskrit": "मां वरिष्यति नान्यं सा विष्णुरूपधरन्ध्रुवम् ।\nआननस्य कुरूपत्वं न वेद मुनिसत्तमः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001092037, "chapter_id": 21092, "verse_number": "२-१-३-३८", "content_sanskrit": "पूर्वरूपं मुनिं सर्वे ददृशुऽस्तत्र मानवाः ।\nतद्भेदं बुबुधुस्ते न राजपुत्रादयो द्विजाः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001092038, "chapter_id": 21092, "verse_number": "२-१-३-३९", "content_sanskrit": "तत्र रुद्रगणौ द्वौ तद्रक्षणार्थं समागतौ ।\nविप्ररूपधरौ गूढौ तत्रेदं जज्ञतुः परम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001092039, "chapter_id": 21092, "verse_number": "२-१-३-४०", "content_sanskrit": "मूढ मत्वा मुनिं तौ तन्निकटं जग्मतुर्गणौ ।\nकुरुतस्तत्प्रहासं वै भाषमाणौ परस्परम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001092040, "chapter_id": 21092, "verse_number": "२-१-३-४१", "content_sanskrit": "पश्य नारद रूपं हि विष्णोरिव महोत्तमम् ।\nमुखं तु वानरस्येव विकटं च भयंकरम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001092041, "chapter_id": 21092, "verse_number": "२-१-३-४२", "content_sanskrit": "इच्छत्ययं नृपसुता वृथैव स्मरमोहितः ।\nइत्युक्त्वा सच्छलं वाक्यमुपहासं प्रचक्रतुः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001092042, "chapter_id": 21092, "verse_number": "२-१-३-४३", "content_sanskrit": "न शुश्राव यथार्थं तु तद्वाक्यं स्मरविह्वलः ।\nपर्यैक्षच्छ्रीमतीं तां वै तल्लिप्सुर्मोहितो मुनिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001092043, "chapter_id": 21092, "verse_number": "२-१-३-४४", "content_sanskrit": "एतस्मिन्नंतरे भूपकन्या चांतःपुरात्तु सा ।\nस्त्रीभिस्समावृता तत्राजगाम वरवर्णिनी॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001092044, "chapter_id": 21092, "verse_number": "२-१-३-४५", "content_sanskrit": "मालां हिरण्मयीं रम्यामादाय शुभ क्षणा ।\nतत्र स्वयम्बरे रेजे स्थिता मध्ये रमेव सा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001092045, "chapter_id": 21092, "verse_number": "२-१-३-४६", "content_sanskrit": "बभ्राम सा सभां सर्वां मालामादाय सुव्रता ।\nवरमन्वेषती तत्र स्वात्माभीष्टं नृपात्मजा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001092046, "chapter_id": 21092, "verse_number": "२-१-३-४७", "content_sanskrit": "वानरास्यं विष्णुतनुं मुनिं दृष्ट्वा चुकोप सा ।\nदृष्टिं निवार्य च ततः प्रस्थिता प्रीतमानसा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001092047, "chapter_id": 21092, "verse_number": "२-१-३-४८", "content_sanskrit": "न दृष्ट्वा स्ववरं तत्र त्रस्तासीन्मनसेप्सितम् ।\nअंतस्सभास्थिता कस्मिन्नर्पयामास न स्रजम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001092048, "chapter_id": 21092, "verse_number": "२-१-३-४९", "content_sanskrit": "एतस्मिन्नंतरे विष्णुराजगाम नृपाकृतिः ।\nन दृष्टः कैश्चिदपरैः केवलं सा ददर्श हि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001092049, "chapter_id": 21092, "verse_number": "२-१-३-५०", "content_sanskrit": "अथ सा तं समालोक्य प्रसन्नवदनाम्बुजा ।\nअर्पयामास तत्कण्ठे तां मालां वरवर्णिनी॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001092050, "chapter_id": 21092, "verse_number": "२-१-३-५१", "content_sanskrit": "तामादाय ततो विष्णू राजरूपधरः प्रभुः ।\nअंतर्धानमगात्सद्यस्स्वस्थानं प्रययौ किल॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001092051, "chapter_id": 21092, "verse_number": "२-१-३-५२", "content_sanskrit": "सर्वे राजकुमाराश्च निराशाः श्रीमतीम्प्रति ।\nमुनिस्तु विह्वलोऽतीव बभूव मदनातुरः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001092052, "chapter_id": 21092, "verse_number": "२-१-३-५३", "content_sanskrit": "तदा तावूचतुस्सद्यो नारदं स्वरविह्वलम् ।\nविप्ररूपधरौ रुद्रगणौ ज्ञानविशारदौ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001092053, "chapter_id": 21092, "verse_number": "२-१-३-५४", "content_sanskrit": "गणावूचतुः ।\nहे नारदमुने त्वं हि वृथा मदनमोहितः ।\nतल्लिप्सुस्स्वमुखं पश्य वानरस्येव गर्हितम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001092054, "chapter_id": 21092, "verse_number": "२-१-३-५५", "content_sanskrit": "सूत उवाच ।\nइत्याकर्ण्य तयोर्वाक्यं नारदो विस्मितोऽभवत् ।\nमुखं ददर्श मुकुरे शिवमायाविमोहितः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001092055, "chapter_id": 21092, "verse_number": "२-१-३-५६", "content_sanskrit": "स्वमुखं वानरस्येव दृष्ट्वा चुक्रोध सत्वरम् ।\nशापन्ददौ तयोस्तत्र गणयोर्मोहितो मुनिः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001092056, "chapter_id": 21092, "verse_number": "२-१-३-५७", "content_sanskrit": "युवां ममोपहासं वै चक्रतुर्ब्राह्मणस्य हि ।\nभवेतां राक्षसौ विप्रवीर्यजौ वै तदाकृती॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001092057, "chapter_id": 21092, "verse_number": "२-१-३-५८", "content_sanskrit": "श्रुत्वा हरगणावित्थं स्वशापं ज्ञानिसत्तमौ ।\nन किंचिदूचतुस्तौ हि मुनिमाज्ञाय मोहितम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001092058, "chapter_id": 21092, "verse_number": "२-१-३-५९", "content_sanskrit": "स्वस्थानं जग्मतुर्विप्रा उदासीनौ शिवस्तुतिम् ।\nचक्रतुर्मन्यमानौ वै शिवेच्छां सकलां सदा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]