[{"id": 7006261000, "chapter_id": 26261, "verse_number": "३-१५-१", "content_sanskrit": "तच्छ्रुत्वा वचनं देवी मन्दस्मितमुखांबुजा ।\nउवाच स ततो वाक्यं ब्रह्मविष्णुमुखान्सुरान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006261001, "chapter_id": 26261, "verse_number": "३-१५-२", "content_sanskrit": "स्वतन्त्राहं सदा देवाः स्वेच्छाचारविहारिणी ।\nममानुरूपचरितो भविता तु मम प्रियः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006261002, "chapter_id": 26261, "verse_number": "३-१५-३", "content_sanskrit": "तथेति तत्प्रतिश्रुत्य सर्वेर्देवैः पितामहः ।\nउवाच च महादेवीं धर्मार्थसहितं वचः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006261003, "chapter_id": 26261, "verse_number": "३-१५-४", "content_sanskrit": "कालक्रीता क्रयक्रीता पितृदत्ता स्वयंयुता ।\nनारीपुरुषयोरेवमुद्वाहस्तु चतुर्विधः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006261004, "chapter_id": 26261, "verse_number": "३-१५-५", "content_sanskrit": "कालक्रीता तु वेश्या स्यात्क्रयक्रीता तु दासिका ।\nगन्धर्वोद्वाहिता युक्ता भार्या स्यात्पितृदत्तका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006261005, "chapter_id": 26261, "verse_number": "३-१५-६", "content_sanskrit": "समानधर्मिणी युक्ता भार्या पितृवशंवदा ।\nयदद्वैतं परं ब्रह्म सदसद्भाववर्जितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006261006, "chapter_id": 26261, "verse_number": "३-१५-७", "content_sanskrit": "चिदानन्दात्मकं तस्मात्प्रकृतिः समजायत ।\nत्वमेवासीच्च तद्ब्रह्म प्रकृतिः सा त्वमेव हि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006261007, "chapter_id": 26261, "verse_number": "३-१५-८", "content_sanskrit": "त्वमेवानादिरखिला कार्यकारणरूपिणी ।\nत्वामेव हि विचिन्वन्ति योगिनः सनकादयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006261008, "chapter_id": 26261, "verse_number": "३-१५-९", "content_sanskrit": "सदसत्कर्मरूपां च व्यक्ताव्यक्तो दयात्मिकाम् ।\nत्वामेव हि प्रशंसंति पञ्चब्रह्मस्वरूपिणीम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006261009, "chapter_id": 26261, "verse_number": "३-१५-१०", "content_sanskrit": "त्वामेव हि सृजस्यादौ त्वमेव ह्यवसि क्षणात् ।\nभजस्व पुरुषं कञ्चिल्लोकानुग्रहकाम्यया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006261010, "chapter_id": 26261, "verse_number": "३-१५-११", "content_sanskrit": "इति विज्ञापिता देवी ब्रह्मणा सकलैः सुरैः ।\nस्रजमुद्यम्य हस्तेन चक्षेप गगनान्तरे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006261011, "chapter_id": 26261, "verse_number": "३-१५-१२", "content_sanskrit": "तयोत्सृष्टा हि सा माला शोभयन्ती नभस्थलम् ।\nपपात कण्ठदेशे हि तदा कामेश्वरस्य तु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006261012, "chapter_id": 26261, "verse_number": "३-१५-१३", "content_sanskrit": "ततो मुमुदिरे देवा ब्रह्मविष्णुपुरोगमाः ।\nववृषुः पुष्पवर्षाणि मन्दवातेरिता घनाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006261013, "chapter_id": 26261, "verse_number": "३-१५-१४", "content_sanskrit": "अथोवाच विधाता तु भगवन्तं जनार्दनम् ।\nकर्तव्यो विधिनोद्वाहस्त्वनयोः शिवयोर्हरे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006261014, "chapter_id": 26261, "verse_number": "३-१५-१५", "content_sanskrit": "मुहुर्तो देवसम्प्राप्तो जगन्मङ्गलकारकः ।\nत्वद्रूपा हि महादेवी सहजश्च भवानपि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006261015, "chapter_id": 26261, "verse_number": "३-१५-१६", "content_sanskrit": "दातुमर्हसि कल्याणीमस्मै कामशिवाय तु ।\nतच्छ्रुत्वा वचनं तस्य देवदेवस्त्रिविक्रमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006261016, "chapter_id": 26261, "verse_number": "३-१५-१७", "content_sanskrit": "ददौ तस्यै विधानेन प्रीत्या तां शङ्कराय तु ।\nदेवर्षिपितृमुख्यानां सर्वेषां देवयोगिनाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006261017, "chapter_id": 26261, "verse_number": "३-१५-१८", "content_sanskrit": "कल्याणं कारयामास शिवयोरादिकेशवः ।\nउपायनानि प्रददुः सर्वे ब्रह्मादयः सुराः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006261018, "chapter_id": 26261, "verse_number": "३-१५-१९", "content_sanskrit": "ददौ ब्रह्मेक्षुचापं तु वज्रसारमनश्वरम् ।\nतयोः पुष्पायुधं प्रादादम्लानं हरिरव्ययम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006261019, "chapter_id": 26261, "verse_number": "३-१५-२०", "content_sanskrit": "नागपाशं ददौ ताभ्यां वरुणो यादसांपतिः ।\nअङ्कुशं च ददौ ताभ्यां विश्वकर्मा विशांपतिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006261020, "chapter_id": 26261, "verse_number": "३-१५-२१", "content_sanskrit": "किरीटमग्निः प्रायच्छत्ताटङ्कौ चन्द्रभास्करौ ।\nनवरत्नमयीं भूषां प्रादाद्रत्नाकरः स्वयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006261021, "chapter_id": 26261, "verse_number": "३-१५-२२", "content_sanskrit": "ददौ सुराणामधिपो मधुपात्रमथाक्षयम् ।\nचिन्तामणिमयीं मालां कुबेरः प्रददौ तदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006261022, "chapter_id": 26261, "verse_number": "३-१५-२३", "content_sanskrit": "साम्राज्यसूचकं छत्रं ददौ लक्ष्मीपतिः स्वयम् ।\nगङ्गा च यमुना ताभ्यां चामरे चन्द्रभास्वरे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006261023, "chapter_id": 26261, "verse_number": "३-१५-२४", "content_sanskrit": "अष्टौ च वसवो रुद्रा आदित्याश्चाश्विनौ तथा ।\nदिक्पाला मरुतः साध्या गन्धर्वाः प्रमथेश्वराः ।\nस्वानिस्वान्यायुधान्यस्यै प्रददुः परितोषिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006261024, "chapter_id": 26261, "verse_number": "३-१५-२५", "content_sanskrit": "रथांश्च तुरगान्नागान्महावेगान्महाबलान् ।\nउष्टानरोगानश्वांस्तान्क्षुत्तृष्णापरिवर्जितान् ।\nददुर्वज्रोपमाकारान्सायुधान्सपरिच्छदान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006261025, "chapter_id": 26261, "verse_number": "३-१५-२६", "content_sanskrit": "अथाभिषेकमातेनुः साम्राज्ये शिवयोः शिवम् ।\nअथाकरोद्विमानं च नाम्ना तु कुसुमाकरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006261026, "chapter_id": 26261, "verse_number": "३-१५-२७", "content_sanskrit": "विधाताम्लानमालं वै नित्यं चाभेद्यमायुधैः ।\nदिवि भुव्यन्तरिक्षे च कामगं सुसमृद्धिमत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006261027, "chapter_id": 26261, "verse_number": "३-१५-२८", "content_sanskrit": "यद्गन्धघ्राणमात्रेण भ्रान्तिरोगक्षुर्धातयः ।\nतत्क्षणादेव नश्यन्ति मनोह्लादकरं शुभम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006261028, "chapter_id": 26261, "verse_number": "३-१५-२९", "content_sanskrit": "तद्विमानमथारोप्य तावुभौ दिव्यदंपती ।\nचामख्याजनच्छत्रध्वजयष्टिमनोहरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006261029, "chapter_id": 26261, "verse_number": "३-१५-३०", "content_sanskrit": "वीणावेणुमृदङ्गादिविविधैस्तौर्यवादनैः ।\nसेव्यमाना सुरगणैर्निर्गत्य नृपमन्दिरात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006261030, "chapter_id": 26261, "verse_number": "३-१५-३१", "content_sanskrit": "ययौ वीथीं विहारेशा शोभयन्ती निजौजसा ।\nप्रतिहर्म्याग्रसंस्थाभिरप्सरोभिः सहस्रशः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006261031, "chapter_id": 26261, "verse_number": "३-१५-३२", "content_sanskrit": "सलाजाक्षतहस्ताभिः पुरन्ध्रीभिश्च वर्षिता ।\nगाथाभिर्मङ्गलार्थाभिर्वीणावेण्वादिनिस्वनैः ।\nतुष्यन्ती वीवीथिवीथीषु मन्दमन्दमथाययौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006261032, "chapter_id": 26261, "verse_number": "३-१५-३३", "content_sanskrit": "प्रतिगृह्याप्स रोभिस्तु कृतं नीराजनाविधिम् ।\nअवरुह्य विमानग्रात्प्रविवेश महासभाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006261033, "chapter_id": 26261, "verse_number": "३-१५-३४", "content_sanskrit": "सिंहासनमधिष्ठाय सह देवेन शंभुना ।\nयद्यद्वाञ्छन्ति तत्रस्था मनसैव महाजनाः ।\nसर्वज्ञा साक्षिपातेन तत्तत्कामानपूरयत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006261034, "chapter_id": 26261, "verse_number": "३-१५-३५", "content_sanskrit": "तद्दृष्ट्वा चरितं देव्या ब्रह्मा लोक पितामहः ।\nकामाक्षीति तदाभिख्यां ददौ कामेश्वरीति च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006261035, "chapter_id": 26261, "verse_number": "३-१५-३६", "content_sanskrit": "ववर्षाश्चर्यमेघोऽपि पुरे तस्मिंस्तदाज्ञया ।\nमहार्हाणि च वस्तूनि दिव्यान्याभरणानि च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006261036, "chapter_id": 26261, "verse_number": "३-१५-३७", "content_sanskrit": "चिन्तामणिः कल्पवृक्षः कमला कामधेनवः ।\nप्रतिवेश्म ततस्तस्थुः पुरो देव्याजयाय ते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006261037, "chapter_id": 26261, "verse_number": "३-१५-३८", "content_sanskrit": "तां सेवैकरसाकारां विमुक्तान्यक्रियागुणाः ।\nसर्वकामार्थसंयुक्ता हृष्यन्तः सार्वकालिकम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006261038, "chapter_id": 26261, "verse_number": "३-१५-३९", "content_sanskrit": "पितामहो हरिश्चैव महादेवश्च वासवः ।\nअन्ये दिशामधीशास्तु सकला देवतागणाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006261039, "chapter_id": 26261, "verse_number": "३-१५-४०", "content_sanskrit": "देवर्षयो नारदाद्याः सनकाद्याश्च योगिनः ।\nमहर्षयश्च मन्वाद्या वशिष्ठाद्यास्तपोधनाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006261040, "chapter_id": 26261, "verse_number": "३-१५-४१", "content_sanskrit": "गन्धर्वाप्सरसो यक्षा याश्चान्या देवजातयः ।\nदिवि भूम्यन्तरिक्षेषु ससंबाधं वसंति ये ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006261041, "chapter_id": 26261, "verse_number": "३-१५-४२", "content_sanskrit": "ते सर्वे चाप्यसंबाधं निवसंति स्म तत्पुरे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006261042, "chapter_id": 26261, "verse_number": "३-१५-४३", "content_sanskrit": "एवं तद्वत्सला देवी नान्यत्रैत्यखिलाज्जनात् ।\nतोषयामास सततमनुरागेण भूयसा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006261043, "chapter_id": 26261, "verse_number": "३-१५-४४", "content_sanskrit": "राज्ञो महति भूर्लोके विदुषः सकलेप्सिताम् ।\nराज्ञी दुदोहाभीष्टानि सर्वभूतलवासिनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006261044, "chapter_id": 26261, "verse_number": "३-१५-४५", "content_sanskrit": "त्रिलोकैकमहीपाले सांबिके कामशङ्करे ।\nदशवर्षसहस्राणि ययुः क्षण इवापरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006261045, "chapter_id": 26261, "verse_number": "३-१५-४६", "content_sanskrit": "ततः कदा चिदागत्य नारदो भगवानृषिः ।\nप्रणम्य परमां शक्तिं प्रोवाच विनयान्वितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006261046, "chapter_id": 26261, "verse_number": "३-१५-४७", "content_sanskrit": "पर ब्रह्म परं धाम पवित्रं परमैश्वरि ।\nमदसद्भावसंकल्पविकल्पकलनात्मिका ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006261047, "chapter_id": 26261, "verse_number": "३-१५-४८", "content_sanskrit": "जगदभ्युदयार्थाय व्यक्तभावमुपागता ।\nअसज्जनविनाशार्था सज्जनाभ्युदयार्थिनी ।\nप्रवृत्तिस्तव कल्याणि साधूनां रक्षणाय हि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006261048, "chapter_id": 26261, "verse_number": "३-१५-४९", "content_sanskrit": "अयं भण्डोऽसुरो देवि बाधते जगतां त्रयम् ।\nत्वयैकयैव जेतव्यो न शक्यस्त्वपरैः सुरैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006261049, "chapter_id": 26261, "verse_number": "३-१५-५०", "content_sanskrit": "त्वत्सेवैकपरा देवाश्चिरकालमिहोषिताः ।\nत्वदाज्ञया गमिष्यन्ति स्वानिस्वानि पुराणि तु ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006261050, "chapter_id": 26261, "verse_number": "३-१५-५१", "content_sanskrit": "अमङ्गलानि शून्यानि समृद्धार्थानि संत्वतः ।\nएवं विज्ञापिता देवी नारदेनाखिलेश्वरी ।\nस्वस्ववासनिवासाय प्रेषयामास चामरान् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006261051, "chapter_id": 26261, "verse_number": "३-१५-५२", "content_sanskrit": "ब्रह्माणं च हरिं शंभुं वासवादीन्दिशां पतीन् ।\nयथार्हं पूजयित्वा तु प्रेषयामास चांबिका ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006261052, "chapter_id": 26261, "verse_number": "३-१५-५३", "content_sanskrit": "अपराधं ततस्त्यक्तुमपि संप्रेषिताः सुराः ।\nस्वस्वांशैः शिवयोः सेवामादिपित्रोरकुर्वत ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006261053, "chapter_id": 26261, "verse_number": "३-१५-५४", "content_sanskrit": "एतदाख्यानमायुष्यं सर्वमङ्गलकारणम् ।\nआविर्भावं महादेव्यास्तस्या राज्याभिषेचनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006261054, "chapter_id": 26261, "verse_number": "३-१५-५५", "content_sanskrit": "यः प्रातरुत्थितो विद्वान्भक्तिश्रद्धासमन्वितः ।\nजपेद्धनसमृद्धः स्यात्सुधासंमितवाग्भवेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006261055, "chapter_id": 26261, "verse_number": "३-१५-५६", "content_sanskrit": "नाशुभं विद्यते तस्य परत्रेह च धीमतः ।\nयशः प्राप्नोति विपुलं समानोत्तमतामपि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006261056, "chapter_id": 26261, "verse_number": "३-१५-५७", "content_sanskrit": "अचला श्रीर्भवेतस्य श्रेयश्चैव पदेपदे ।\nकदाचिन्न भयं तस्य तेजस्वी वीर्यवान्भवेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006261057, "chapter_id": 26261, "verse_number": "३-१५-५८", "content_sanskrit": "तापत्रयविहीनश्च पुरुषार्थैश्च पूर्यते ।\nत्रिसंध्यं यो जपेन्नित्यं ध्यात्वा सिंहासनेश्वरीम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006261058, "chapter_id": 26261, "verse_number": "३-१५-५९", "content_sanskrit": "षण्मासान्महतीं लक्ष्मीं प्राप्नुयाज्जापकोत्तमः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]