[{"id": 2084383, "chapter_id": 2797, "verse_number": "१२-३०२-०x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084384, "chapter_id": 2797, "verse_number": "१२-३०२-१", "content_sanskrit": "वर्णो विशेषवर्णानां महर्षे केन जायते।\nएतदिच्छाम्यहं ज्ञातुं तद्ब्रूहि वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084385, "chapter_id": 2797, "verse_number": "१२-३०२-२", "content_sanskrit": "यदेतज्जायतेऽपत्यं स एवायमिति श्रुतिः।\nकथं ब्राह्मणतो जातो विशेषग्रहणं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084386, "chapter_id": 2797, "verse_number": "१२-३०२-३x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084387, "chapter_id": 2797, "verse_number": "१२-३०२-३", "content_sanskrit": "एवमेतन्महाराज येन जातः स एव सः।\nतपसस्त्वपकर्षेण जातिग्रहणतां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084388, "chapter_id": 2797, "verse_number": "१२-३०२-४", "content_sanskrit": "सुक्षेत्राच्च सुबीजाच्च पुण्यो भवति संभवः।\nअतोऽन्यतरतो हीनादवरो नाम जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084389, "chapter_id": 2797, "verse_number": "१२-३०२-५", "content_sanskrit": "वक्राद्भुजाभ्यामूरुभ्यां पद्भ्यां चैवाथ जज्ञिरे।\nसृजतः प्रजापतेर्लोकानिति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084390, "chapter_id": 2797, "verse_number": "१२-३०२-६", "content_sanskrit": "मुखजा ब्राह्मणास्तात बाहुजाः क्षत्रियाः स्मृताः।\nऊरुजा धनिनो राजन्पादजाः परिचारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084391, "chapter_id": 2797, "verse_number": "१२-३०२-७", "content_sanskrit": "चतुर्णामेव वर्णानामागमः पुरुषर्षभ।\nअतोन्ये त्वतिरिक्ता ये ते वै संकरजाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084392, "chapter_id": 2797, "verse_number": "१२-३०२-८", "content_sanskrit": "क्षत्रियातिरथाम्बष्ठा उग्रा वैदेहकास्तथा।\nश्वपाकाः पुल्कसाः स्तेना निषादाः सूतमागधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084393, "chapter_id": 2797, "verse_number": "१२-३०२-९", "content_sanskrit": "अयोगाः कारणा व्रात्याश्चाण्डालाश्च नराधिप।\nएते चतुर्भ्यो वर्णेभ्यो जायन्ते वै परस्परात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084394, "chapter_id": 2797, "verse_number": "१२-३०२-१०x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084395, "chapter_id": 2797, "verse_number": "१२-३०२-१०", "content_sanskrit": "ब्रह्मणैकेन जातानां नानात्वं गोत्रतः कथम्।\nबहूनीह हि लोके वै गोत्राणि मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084396, "chapter_id": 2797, "verse_number": "१२-३०२-११", "content_sanskrit": "यत्र तत्र कथं जाताः स्वयोनिं मुनयो गताः।\nशूद्रयोनौ समुत्पन्ना वियोनौ च तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084397, "chapter_id": 2797, "verse_number": "१२-३०२-१२x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084398, "chapter_id": 2797, "verse_number": "१२-३०२-१२", "content_sanskrit": "राजन्नैतद्भवेद्ब्राह्ममपकृष्टेन जन्मना।\nमहात्मनां समुत्पत्तिस्तपसा भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084399, "chapter_id": 2797, "verse_number": "१२-३०२-१३", "content_sanskrit": "उत्पाद्य पुत्रान्मुनयो नृपते यत्र तत्र ह।\nस्वेनैव तपसा तेषामृषित्वं विदधुः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084400, "chapter_id": 2797, "verse_number": "१२-३०२-१४", "content_sanskrit": "पितामहश्च मे पूर्वमृश्यशृङ्गश्च काश्यपः।\nवेदस्ताण्ड्यः कृपश्चैव काक्षीवत्कमठादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084401, "chapter_id": 2797, "verse_number": "१२-३०२-१५", "content_sanskrit": "यवक्रीतश्च नृपते द्रोणश्च वदतांवरः।\nआयुर्मतङ्गो दत्तश्च द्रुमदो मात्स्य एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084402, "chapter_id": 2797, "verse_number": "१२-३०२-१६", "content_sanskrit": "एते स्वां प्रकृतिं प्राप्ता वैदेह तपसो बलात्।\nप्रतिष्ठिता वेदविदो दमेन तपसैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084403, "chapter_id": 2797, "verse_number": "१२-३०२-१७", "content_sanskrit": "मूलगोत्राणि चत्वारि समुत्पन्नानि पार्थिव।\nअङ्गिराः कश्यपश्चैव वसिष्ठो भृगुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084404, "chapter_id": 2797, "verse_number": "१२-३०२-१८", "content_sanskrit": "कर्मतोऽन्यानि गोत्राणि समुत्पन्नानि पार्थिव।\nनामधेयानि तपसा तानि च ग्रहणं सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084405, "chapter_id": 2797, "verse_number": "१२-३०२-१९x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084406, "chapter_id": 2797, "verse_number": "१२-३०२-१९", "content_sanskrit": "विशेषधर्मान्वर्णानां प्रब्रूहि भगवन्मम।\nततः सामान्यधर्मांश्च सर्वत्र कुशलो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084407, "chapter_id": 2797, "verse_number": "१२-३०२-२०x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084408, "chapter_id": 2797, "verse_number": "१२-३०२-२०", "content_sanskrit": "प्रतिग्रहो याजनं च तथैवाध्यापनं नृप।\nविशेषधर्मा विप्राणां रक्षा क्षत्रस्य शोभना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084409, "chapter_id": 2797, "verse_number": "१२-३०२-२१", "content_sanskrit": "कृषिश्च पाशुपाल्यं च वाणिज्यं च विशामपि।\nद्विजानां परिचर्या च शूद्रकर्म नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084410, "chapter_id": 2797, "verse_number": "१२-३०२-२२", "content_sanskrit": "विशेषधर्मा नृपते वर्णानां परिकीर्तिताः।\nधर्मान्साधारणांस्तात विस्तरेण शृणुष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084411, "chapter_id": 2797, "verse_number": "१२-३०२-२३", "content_sanskrit": "आनृशंस्यमर्हिसा चाप्रमादः संविभागिता।\nश्राद्धकर्मातिथेयं च सत्यमक्रोध एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084412, "chapter_id": 2797, "verse_number": "१२-३०२-२४", "content_sanskrit": "स्वेषु दारेषु संतोषः शौचं नित्याऽनसूयता।\nआत्मज्ञानं तितिक्षा च धर्माः साधारणा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084413, "chapter_id": 2797, "verse_number": "१२-३०२-२५", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्यास्रयो वर्णा द्विजातयः।\nअत्र तेषामधीकारो धर्मेषु द्विपदां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084414, "chapter_id": 2797, "verse_number": "१२-३०२-२६", "content_sanskrit": "विकर्मावस्थिता वर्णाः पतन्ति नृपते त्रयः।\nउन्नमन्ति यथा सन्त आश्रित्येह स्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084415, "chapter_id": 2797, "verse_number": "१२-३०२-२७", "content_sanskrit": "न चापि शूद्रः पततीति निश्चयो\nन चापि संस्कारमिहार्हतीति वा।\nश्रुतिप्रयुक्तं न च धर्ममाप्नुते\nन चास्य धर्मे प्रतिषेधनं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084416, "chapter_id": 2797, "verse_number": "१२-३०२-२८", "content_sanskrit": "वैदेहकं शूद्रमुदाहरन्ति\nद्विजा महाराज श्रुतोपपन्नाः।\nअहं हि पश्यामि नरेन्द्र देवं\nविश्वस्य विष्णुं जगतः प्रधानम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084417, "chapter_id": 2797, "verse_number": "१२-३०२-२९", "content_sanskrit": "सतां वृत्तमधिष्ठाय निहीना उद्दिधीर्षवः।\nमन्त्रवर्जं न दुष्यन्ति कुर्वाणाः पौष्टिकीः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084418, "chapter_id": 2797, "verse_number": "१२-३०२-३०", "content_sanskrit": "यथायथा हि सद्वॄत्तमालम्बन्तीतरे जनाः।\nयथातथा सुखं प्राप्य प्रेत्य चेह च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084419, "chapter_id": 2797, "verse_number": "१२-३०२-३१x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084420, "chapter_id": 2797, "verse_number": "१२-३०२-३१", "content_sanskrit": "किं कर्म दूषयत्येनमथो जातिर्महामुने।\nसंदेहो मे समुत्पन्नस्तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084421, "chapter_id": 2797, "verse_number": "१२-३०२-३२x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084422, "chapter_id": 2797, "verse_number": "१२-३०२-३२", "content_sanskrit": "असंशयं महाराज उभयं दोषकारकम्।\nकर्म चैव हि जातिश्च विशेषं तु निशामय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084423, "chapter_id": 2797, "verse_number": "१२-३०२-३३", "content_sanskrit": "जात्या च कर्मणा चैव दुष्टं कर्म न सेवते।\nजात्या दुष्टश्च यः पापं न करोति स पूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084424, "chapter_id": 2797, "verse_number": "१२-३०२-३४", "content_sanskrit": "जात्या प्रधानं पुरुषं कुर्वाणं कर्म धिक्कृतम्\nकर्म तद्दूषयत्येनं तस्मात्कर्म न शोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084425, "chapter_id": 2797, "verse_number": "१२-३०२-३५x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084426, "chapter_id": 2797, "verse_number": "१२-३०२-३५", "content_sanskrit": "कानि कर्माणि धर्म्याणि लोकेऽस्मिन्द्विजसत्तम्।\nन हिंसन्तीह भूतानि क्रियमाणानि सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084427, "chapter_id": 2797, "verse_number": "१२-३०२-३६x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084428, "chapter_id": 2797, "verse_number": "१२-३०२-३६", "content_sanskrit": "शृणु मेऽत्र महाराज यन्मां त्वं परिपृच्छसि।\nयानि कर्माण्यहिंस्राणि नरं त्रायन्ति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084429, "chapter_id": 2797, "verse_number": "१२-३०२-३७", "content_sanskrit": "संन्यस्याग्नीनुदासीनाः पश्यन्ति विगतज्वराः।\nनैःश्रेयसं कर्मपथं समारुह्य यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084430, "chapter_id": 2797, "verse_number": "१२-३०२-३८", "content_sanskrit": "प्रश्रिता विनयोपेता दमनित्याः सुसंशिताः।\nपयान्ति स्थानमजरं सर्वकर्मविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084431, "chapter_id": 2797, "verse_number": "१२-३०२-३९", "content_sanskrit": "सर्वे वर्णा धर्मकार्याणि सम्यक्\nकृत्वा राजन्सत्यवाक्यानि चोक्त्वा।\nत्यक्त्वा धर्मं दारुणं जीवलोके\nयान्ति स्वर्गं नात्र कार्यो विचारः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084432, "chapter_id": 2797, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्व्यधिकत्रिशततमोऽध्यायः॥ ३०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]