[{"id": 7002766000, "chapter_id": 22766, "verse_number": "९-५१-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअन्यामपि प्रवक्ष्यामि शोभनां शुभसप्तमीम् ।\nयामुपोष्य नरो रोगाच्छोकदुःखात्प्रमुच्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002766001, "chapter_id": 22766, "verse_number": "९-५१-२", "content_sanskrit": "पुण्य आश्वयुजे मासि कृतस्नानः पयः शुचिः ।\nवाचयेत ततो विप्रानारभेच्छुभसप्तमीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002766002, "chapter_id": 22766, "verse_number": "९-५१-३", "content_sanskrit": "कपिलां पूजयेद्भक्त्या गन्धमाल्यानुलेपनैः ।\nनमामि सूर्यसंभूतामशेषभुवनालयाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002766003, "chapter_id": 22766, "verse_number": "९-५१-४", "content_sanskrit": "त्वामहं शुभकल्याणशरीरां सर्वसिद्धये ।\nअथाहृत्य तिलप्रस्थं ताम्रपात्रेण संयुतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002766004, "chapter_id": 22766, "verse_number": "९-५१-५", "content_sanskrit": "काञ्चनं वृषभं तद्वद्वस्त्रमाल्यगुडान्वितम् ।\nदद्याद्विकालवेलायामर्यमा प्रीयतामिति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002766005, "chapter_id": 22766, "verse_number": "९-५१-६", "content_sanskrit": "पञ्चगव्यं च संप्राश्य स्वप्याद्भूमौ विमत्सरः ।\nततः प्रभाते संजाते भक्त्या संतर्पयेद्द्विजान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002766006, "chapter_id": 22766, "verse_number": "९-५१-७", "content_sanskrit": "अनेन विधिना दद्यान्मासिमासि सदा नरः ।\nवाससी वृषभं हैमं तद्वद्धेनोस्तु पूजनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002766007, "chapter_id": 22766, "verse_number": "९-५१-८", "content_sanskrit": "संवत्सरांते शयनमिक्षुदण्डगुडान्वितम् ।\nसोपधानकविश्रामं भाजनासनसंयुतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002766008, "chapter_id": 22766, "verse_number": "९-५१-९", "content_sanskrit": "ताम्रपात्रं तिलप्रस्थं सौवर्णवृषसंयुतम् ।\nदद्याद्वेदविदे सर्वं विश्वात्मा प्रीयतामिति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002766009, "chapter_id": 22766, "verse_number": "९-५१-१०", "content_sanskrit": "अनेन विधिना राजन्कुर्याद्यः शुभसप्तमीम् ।\nतस्य श्रीर्विमला कीर्तिर्भ वेजन्मनिजन्मनि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002766010, "chapter_id": 22766, "verse_number": "९-५१-११", "content_sanskrit": "अप्सरोगणगन्धर्वैः पूज्यमानः सुरालये ।\nवसेद्गणाधिपो भूत्वा यावदाभूतसंप्लवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002766011, "chapter_id": 22766, "verse_number": "९-५१-१२", "content_sanskrit": "स कल्पादवतीर्णस्तु सप्तद्वीपाधिपो भवेत् ।\nब्रह्महत्यासहस्रस्य भ्रूणहत्याशतस्य च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002766012, "chapter_id": 22766, "verse_number": "९-५१-१३", "content_sanskrit": "नाशङ्करोति पुण्येयं कृता वै शुभसप्तमी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002766013, "chapter_id": 22766, "verse_number": "९-५१-१४", "content_sanskrit": "इमां पठेद्यः शृणुया न्मुहूर्तं वीक्षेत संगादपि दीयमानम् ।\nसोऽप्यत्र संबाध्य विमुक्तदेहः प्राप्नोति विद्याधरनायकत्वम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]