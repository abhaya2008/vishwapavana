[{"id": 7005893000, "chapter_id": 25893, "verse_number": "१-७६-१", "content_sanskrit": "सूत उवाच ।\nहिमवत्युत्तरदेशे वीर्य्यं पतितं सुरद्विस्तस्य।\nसंप्राप्तमुत्तमानामाकरतां भीष्मरत्नानाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005893001, "chapter_id": 25893, "verse_number": "१-७६-२", "content_sanskrit": "शुक्लाः शङ्खाब्जनिभाः स्योनाकसन्निभाः प्रभावन्तः।\nप्रभवन्ति ततस्तरुणा वज्रनिभा भीष्मपाषाणाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005893002, "chapter_id": 25893, "verse_number": "१-७६-३", "content_sanskrit": "हेमादिप्रतिबद्धाः शुद्धमपि श्रद्धया विधत्ते यः ।\nभीष्ममणिं ग्रीवादिषु सुसम्पदं स सर्वदा लभते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005893003, "chapter_id": 25893, "verse_number": "१-७६-४", "content_sanskrit": "निरीक्ष्य पलायन्ते यं तमरण्यनिवासिनः समपेऽपि।\nद्वीपिवृकशरभकुञ्जरसिंहव्याघ्रादयो हिंस्राः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005893004, "chapter_id": 25893, "verse_number": "१-७६-५", "content_sanskrit": "तसोयत्कलतष्टतरोर्भवति भयं न चास्तीशमुपहसन्त।\nभीष्ममणिर्गुणयुक्तो सम्यक्प्राप्ताङ्गुलीकलत्रत्वः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005893005, "chapter_id": 25893, "verse_number": "१-७६-६", "content_sanskrit": "पितॄतर्पणे पितॄणां तृप्तिर्बहुवार्षिकी भवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005893006, "chapter_id": 25893, "verse_number": "१-७६-७", "content_sanskrit": "शाम्यन्त्यद्भुतान्यपि सर्पाण्डजाखुवृश्चिकविषणि।\nसलिलाग्निवैरितस्करभयानि भीमानि नश्यन्ति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005893007, "chapter_id": 25893, "verse_number": "१-७६-८", "content_sanskrit": "शैवलबलाहकाभं पुरुषं पीतप्रभं प्रभाहीनम् ।\nमलिनद्युति च विवर्णं दूरात्परिवर्जयेत्प्राज्ञः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005893008, "chapter_id": 25893, "verse_number": "१-७६-९", "content_sanskrit": "मूल्यं प्रकल्प्यमेषां विबुधवरैर्दैशकालविजञानात्।\nदूरे भूतानां बहु किञ्चिन्निकटप्रसूतानाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]