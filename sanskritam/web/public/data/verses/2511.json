[{"id": 2071670, "chapter_id": 2511, "verse_number": "१२-१६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071671, "chapter_id": 2511, "verse_number": "१२-१६-१", "content_sanskrit": "अर्जुनस्य वचः श्रुत्वा भीमसेनोऽत्यमर्षणः।\nधैर्यमास्थाय तं ज्येष्ठं भ्राता भ्रातरमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071672, "chapter_id": 2511, "verse_number": "१२-१६-२", "content_sanskrit": "राजन्विदितधर्मोऽसि न तेऽस्त्यविदितं भुवि।\nउपशिक्षाम ते वृत्तं सदैव न च शक्नुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071673, "chapter_id": 2511, "verse_number": "१२-१६-३", "content_sanskrit": "न वक्ष्यामि न वक्ष्यामीत्येवं मे मनसि स्थितम्।\nअतिदुःखात्तु वक्ष्यामि तन्निबोध जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071674, "chapter_id": 2511, "verse_number": "१२-१६-४", "content_sanskrit": "भवतः संप्रमोहेन सर्वं संशयितं कृतम्।\nविक्लबत्वं च नः प्राप्तमबलत्वं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071675, "chapter_id": 2511, "verse_number": "१२-१६-५", "content_sanskrit": "कथं हि राजा लोकस्य सर्वशास्त्रविशारदः।\nमोहमापद्यसे दैन्याद्यथा कापुरुषस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071676, "chapter_id": 2511, "verse_number": "१२-१६-६", "content_sanskrit": "आगतिश्च गतिश्चैव लोकस्य विदिता तव।\nआयत्यां च तदात्वे च न तेऽस्त्यविदितं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071677, "chapter_id": 2511, "verse_number": "१२-१६-७", "content_sanskrit": "एवं गते महाराज राज्यं प्रति जनाधिप।\nहेतुमात्रं तु वक्ष्यामि तमिहैकमनाः श्रृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071678, "chapter_id": 2511, "verse_number": "१२-१६-८", "content_sanskrit": "द्विविधो जायते व्याधिः शारीरो मानसस्तथा।\nपरस्परं तयोर्जन्म निर्द्वन्द्वं नोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071679, "chapter_id": 2511, "verse_number": "१२-१६-९", "content_sanskrit": "शारीराज्जायते व्याधिर्मानसो नात्र संशयः।\nमानसाज्जायते व्याधिः शारीर इति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071680, "chapter_id": 2511, "verse_number": "१२-१६-१०", "content_sanskrit": "शारीरमानसे दुःखे योऽतीते त्वनुशोचति।\nदुःखेन लभते दुःखं द्वावनर्थौ च विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071681, "chapter_id": 2511, "verse_number": "१२-१६-११", "content_sanskrit": "शीतोष्णे चैव वायुश्च त्रयः शारीरजा गुणाः।\nतेषां गुणानां साम्यं यत्तदाहुः स्वस्थलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071682, "chapter_id": 2511, "verse_number": "१२-१६-१२", "content_sanskrit": "तेषामन्यतमोद्रेके विधानमुपदिश्यते।\nउष्णेन बाध्यते शीतं शीतेनोष्णं प्रबाध्यते।\n`उभाभ्यां बाध्यते वायुर्विधानमिदमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071683, "chapter_id": 2511, "verse_number": "१२-१६-१३", "content_sanskrit": "सत्वं रजस्तय इति मानसाः स्युस्त्रयो गुणाः।\nतेषां गुणानां साम्यं यत्तदाहुः स्वस्थलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071684, "chapter_id": 2511, "verse_number": "१२-१६-१४", "content_sanskrit": "तेषामन्यतमोद्रेके विधानमुपदिश्यते।\nहर्षेण बाध्यते शोको हर्षः शोकेन बाध्यते।\n`उभाभ्यां बाध्यते मोहो विधानमिदमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071685, "chapter_id": 2511, "verse_number": "१२-१६-१५", "content_sanskrit": "कश्चित्सुखे वर्तमानो दुःखस्य स्मर्तुमिच्छति।\nकश्चिद्दुःखे वर्तमानः सुखस्य स्मर्तुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071686, "chapter_id": 2511, "verse_number": "१२-१६-१६", "content_sanskrit": "स त्वं न दुःखी दुःखस्य न सुखी च सुखस्य च।\nनादुःखी दुःखभागस्य नासुखी च सुखस्य च।\nस्मर्तुमर्हसि कौरव्य दिष्टं हि बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071687, "chapter_id": 2511, "verse_number": "१२-१६-१७", "content_sanskrit": "अथवा ते स्वभावोऽयं येन पार्थिव तुष्यसे।\nदृष्ट्वा सभागतां कृष्णामेकवस्त्रां रजस्वलाम्।\nमिषतां पाण्डुपुत्राणां न तस्य स्मर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071688, "chapter_id": 2511, "verse_number": "१२-१६-१८", "content_sanskrit": "प्रव्राजनं च नगरादजिनैश्च विवासनम्।\nमहारण्यनिवासश्च न तस्य स्मर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071689, "chapter_id": 2511, "verse_number": "१२-१६-१९", "content_sanskrit": "जटासुरात्परिक्लेशं चित्रसेनेन चाहवम्।\nसैन्धवाच्च परिक्लेशं कथं विस्मृतवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071690, "chapter_id": 2511, "verse_number": "१२-१६-२०", "content_sanskrit": "पुनरज्ञातचर्यायां कीचकेन पदा वधम्।\nद्रौपद्या राजपुत्र्यांश्च कथं विस्मृतवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071691, "chapter_id": 2511, "verse_number": "१२-१६-२१", "content_sanskrit": "यच्च ते द्रोणभीष्माभ्यां युद्धमासीदरिंदम्।\nमनसैकेन योद्धव्यं तत्ते युद्धमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071692, "chapter_id": 2511, "verse_number": "१२-१६-२२", "content_sanskrit": "यत्र नास्ति शरैः कार्यं न मित्रैर्न च बन्धुभिः।\nआत्मनैकेन योद्धव्यं तत्ते युद्धमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071693, "chapter_id": 2511, "verse_number": "१२-१६-२३", "content_sanskrit": "तस्मिन्ननिर्जिते युद्धे प्राणान्यदि विमोक्ष्यसे।\nअन्यं देहं समास्थाय ततस्तैरिह योत्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071694, "chapter_id": 2511, "verse_number": "१२-१६-२४", "content_sanskrit": "`यो ह्यनाढ्यः स पतितस्तदुच्छिष्टं तदल्पकम्।\nबह्वपथ्यं बलवतो न किंचित्रायते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071695, "chapter_id": 2511, "verse_number": "१२-१६-२५", "content_sanskrit": "तस्मादद्यैव गन्तव्यं युध्यस्व भरतर्षभ।\nपरमव्यक्तरूपस्य व्यक्तं त्यक्त्वा स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071696, "chapter_id": 2511, "verse_number": "१२-१६-२६", "content_sanskrit": "तस्मिन्ननिर्जिते युद्धे कामवस्थां गमिष्यसि।\nएतज्जित्वा महाराज कृतकृत्यो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071697, "chapter_id": 2511, "verse_number": "१२-१६-२७", "content_sanskrit": "एतां बुद्धिं विनिश्चित्य भूतानामागतिं गतिम्।\nपितृपैतामहे वृत्ते शाधि राज्यं यथोचितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071698, "chapter_id": 2511, "verse_number": "१२-१६-२८", "content_sanskrit": "दिष्ट्या दुर्योधनः पापो निहतः सानुगो युधि।\nद्रौपद्याः केशपक्षस्य दिष्ट्या ते पदवीं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071699, "chapter_id": 2511, "verse_number": "१२-१६-२९", "content_sanskrit": "यजस्व वाजिमेधेन विधिवद्दक्षिणावता।\nवयं ते किंकराः पार्थ वासुदेवश्च वीर्यवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071700, "chapter_id": 2511, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षोडशोऽध्यायः॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]