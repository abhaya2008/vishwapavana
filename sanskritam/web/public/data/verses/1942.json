[{"id": 2042288, "chapter_id": 1942, "verse_number": "५-१८७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042289, "chapter_id": 1942, "verse_number": "५-१८७-१", "content_sanskrit": "ततस्ते तापसाः सर्वे तपसे धृतनिश्चयाम्।\nदृष्ट्वा न्यवर्तयंस्तात किं कार्यमिति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042290, "chapter_id": 1942, "verse_number": "५-१८७-२", "content_sanskrit": "तानुवाच ततः कन्या तपोवृद्धानृषींस्तदा ।\nनिराकृतास्मि भीष्मेण भ्रंशिता पतिधर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042291, "chapter_id": 1942, "verse_number": "५-१८७-३", "content_sanskrit": "वधार्थं तस्य दीक्षा मे न लोकार्थं तपोधनाः ।\nनिहत्य भीष्मं गच्छेयं शान्तिमित्येव निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042292, "chapter_id": 1942, "verse_number": "५-१८७-४", "content_sanskrit": "यत्कृते दुःखवसतिमिमां प्राप्तऽस्मि शाश्वतीम् ।\nपतिलोकाद्विहीना च नैव स्त्री न पुमानिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042293, "chapter_id": 1942, "verse_number": "५-१८७-५", "content_sanskrit": "नाहत्वा युधि गाङ्गेयं निवर्तिष्ये तपोधनाः ।\nएष मे हृदि संकल्पो यदिदं कथितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042294, "chapter_id": 1942, "verse_number": "५-१८७-६", "content_sanskrit": "स्त्रीभावे परिनिर्विण्णा पुंस्त्वार्थे कृतनिश्चया ।\nभीष्मे प्रतिचिकीर्षामि नास्मि वार्येति वै पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042295, "chapter_id": 1942, "verse_number": "५-१८७-७", "content_sanskrit": "तां देवो दर्शयामास शूलपाणिरुमापतिः ।\nमध्ये तेषां महार्षीणां स्वेन रूपेण तापसीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042296, "chapter_id": 1942, "verse_number": "५-१८७-८", "content_sanskrit": "छन्द्यमाना वरेणाथ सा वव्रे मत्पराजयम् ।\nहनिष्यसीति तां देवः प्रत्युवाच मनस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042297, "chapter_id": 1942, "verse_number": "५-१८७-९", "content_sanskrit": "ततः सा पुनरेवाथ कन्या रुद्रमुवाच ह।\nउपपद्येत्कथं देव स्त्रिया युधि जयो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042298, "chapter_id": 1942, "verse_number": "५-१८७-१०", "content_sanskrit": "स्त्रीभावेन च मे गाढं मनः शान्तमुमापते ।\nप्रतिश्रुतश्च भूतेश त्वया भीष्मपराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042299, "chapter_id": 1942, "verse_number": "५-१८७-११", "content_sanskrit": "यथा स सत्यो भवति तथा कुरु वृषध्वज ।\nयथा हन्यां समागम्य भीष्मं शान्तनवं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042300, "chapter_id": 1942, "verse_number": "५-१८७-१२", "content_sanskrit": "तामुवाच महादेवः कन्यां किल वृषध्वजः ।\nन मे वागमृतं प्राह सत्यं भद्रे भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042301, "chapter_id": 1942, "verse_number": "५-१८७-१३", "content_sanskrit": "हनिष्यसि रणे भीष्मं पुरुषत्वं च लप्स्यति ॥\nस्मरिष्यसि च तत्सर्वं देहमन्यं गता सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042302, "chapter_id": 1942, "verse_number": "५-१८७-१४", "content_sanskrit": "द्रुपदस्य कुले जाता भविष्यसि महारथः।\nशीघ्रास्त्रश्चित्रयोधी च भविष्यसि सुसंमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042303, "chapter_id": 1942, "verse_number": "५-१८७-१५", "content_sanskrit": "यथोक्तमेव कल्याणि सर्वमेतद्भविष्यति।\nभविष्यसि पुमान्पश्चात्कस्माच्चित्कालपर्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042304, "chapter_id": 1942, "verse_number": "५-१८७-१६", "content_sanskrit": "एवमुक्त्वा महादेवः कपर्दी वृषभध्वजः।\nपश्यतामेव विप्राणां तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042305, "chapter_id": 1942, "verse_number": "५-१८७-१७", "content_sanskrit": "ततः सा पश्यतां तेषां महर्षीणामनिन्दिता ।\nसमाहृत्य वनात्तस्मात्काष्ठानि वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042306, "chapter_id": 1942, "verse_number": "५-१८७-१८", "content_sanskrit": "चितां कृत्वा सुमहतीं प्रदाय च हुताशनम् ।\nप्रदीप्तेऽग्नौ महाराज रोषदीप्तेन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042307, "chapter_id": 1942, "verse_number": "५-१८७-१९", "content_sanskrit": "उक्त्वा भीष्मवधायेति प्रविवेश हुताशनम् ।\nज्येष्ठा काशिसुता राजन्यमुनामभितो नदीम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042308, "chapter_id": 1942, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि सप्ताशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]