[{"id": 2173740, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173741, "chapter_id": 4696, "verse_number": "१", "content_sanskrit": "वर्तमाने महायुद्धे घोररूपे भयानके ।\nअभज्यत बलं तत्र तव पुत्रस्य पाण्डवैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173742, "chapter_id": 4696, "verse_number": "२", "content_sanskrit": "तांस्तु यत्नेन महता सन्निवर्त्य महारथान् ।\nपुत्रास्ते योधयामासुः पाण्डवानामनीकिनीम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173743, "chapter_id": 4696, "verse_number": "३", "content_sanskrit": "निवृत्ताः सहसा योधाः तव पुत्रप्रियैषिणः ।\nसन्निवृत्तेषु तेष्वेव युद्धमासीत् सुदारुणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173744, "chapter_id": 4696, "verse_number": "४", "content_sanskrit": "तावकानां परेषां च सुरासुररणोपमम् ।\nपरेषां तव सैन्ये वा नास्ति कश्चित् पराङ्मुखः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173745, "chapter_id": 4696, "verse_number": "५", "content_sanskrit": "अनुमानेन युध्यन्ते सञ्ज्ञाभिश्च परस्परम् ।\nतेषां क्षयो महानासीद् युध्यतामितरेतरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173746, "chapter_id": 4696, "verse_number": "६", "content_sanskrit": "ततो युधिष्ठिरो राजा क्रोधेन महता वृतः ।\nजिगीषमाणः सङ्ग्रामे धार्तराष्ट्रान् सराजकान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173747, "chapter_id": 4696, "verse_number": "७", "content_sanskrit": "त्रिभिः शारद्वतं विद्ध्वा रुग्मपुङ्खैः शिलाशितैः ।\nचतुर्भिर्निजघानाश्वान् नाराचैः कृतवर्मणः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173748, "chapter_id": 4696, "verse_number": "८", "content_sanskrit": "अश्वत्थामा तु हार्दिक्यमपोवाह यशस्विनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173749, "chapter_id": 4696, "verse_number": "९", "content_sanskrit": "अथ शारद्वतोऽष्टाभिः प्रत्ययुध्यद्युधिष्ठिरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173750, "chapter_id": 4696, "verse_number": "१०", "content_sanskrit": "ततो दुर्योधनो राजा रथान् सप्तशतान् रणे ।\nप्रैषयद्यत्र राजाऽसौ धर्मपुत्रो युधिष्ठिरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173751, "chapter_id": 4696, "verse_number": "११", "content_sanskrit": "ते रथा रथिभिर्युक्ता मनोमारुतरंहसः ।\nअभ्यद्रवन्त सङ्ग्रामे कौन्तेयस्य रथं प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173752, "chapter_id": 4696, "verse_number": "१२", "content_sanskrit": "ते समन्तान्महाराज परिवार्य युधिष्ठिरम् ।\nअदृश्यं सायकैश्चक्रुः मेघा इव दिवाकरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173753, "chapter_id": 4696, "verse_number": "१३", "content_sanskrit": "तं दृष्ट्वा धर्मराजानं कौरवैस्तैः समावृतम् ।\nनामृष्यन्त सुसङ्क्रुद्धाः शिखण्डिप्रमुखा रथाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173754, "chapter_id": 4696, "verse_number": "१४", "content_sanskrit": "रथैरश्ववरैर्युक्तैः किङ्किणीजालसंवृतैः ।\nआजग्मुरभिरक्षन्तः कुन्तीपुत्रं युधिष्ठिरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173755, "chapter_id": 4696, "verse_number": "१५", "content_sanskrit": "ततः प्रववृते घोरः सङ्ग्रामः शोणितोदकः ।\nपाण्डवानां कुरूणां च यमराष्ट्रविवर्धनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173756, "chapter_id": 4696, "verse_number": "१६", "content_sanskrit": "रथान् सप्तदशान् हत्वा कुरूणामाततायिनाम् ।\nपाण्डवाः सह पाञ्चालैः पुनरेवाभ्यवारयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173757, "chapter_id": 4696, "verse_number": "१७", "content_sanskrit": "तत्र युद्धं महच्चासीत् तव पुत्रस्य पाण्डवैः ।\nन च तत्तादृशं दृष्टं नैव चापि परिश्रुतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173758, "chapter_id": 4696, "verse_number": "१८", "content_sanskrit": "वर्तमाने महायुद्धे निर्मर्यादे समन्ततः ।\nवध्यमानेषु योधेषु तावकेष्वितरेषु च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173759, "chapter_id": 4696, "verse_number": "१९", "content_sanskrit": "निनदत्सु च वीरेषु शङ्खवर्यैश्च पूरितैः ।\nउत्कृष्टैः सिंहनादैश्च गर्जितेन च धन्विनाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173760, "chapter_id": 4696, "verse_number": "२०", "content_sanskrit": "अतिप्रवृद्धे युद्धे च भिद्यमानेषु मर्मसु ।\nवध्यमानेषु योधेषु जयगृध्रेषु भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173761, "chapter_id": 4696, "verse_number": "२१", "content_sanskrit": "संहारे सर्वतो जाते पृथिव्यां घोरसम्भवे ।\nबह्वीनामुत्तमस्त्रीणां सीमन्तोद्धरणे कृते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173762, "chapter_id": 4696, "verse_number": "२२", "content_sanskrit": "निर्मर्यादे महायुद्धे वर्तमाने सुदारुणे ।\nप्रादुरासन् विनाशाय तदोत्पाताः सुदारुणाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173763, "chapter_id": 4696, "verse_number": "२३", "content_sanskrit": "चचाल शब्दं कुर्वाणा सपर्वतवना मही ।\nसदण्डाश्चोल्मुका राजन् निपतन्ति समन्ततः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173764, "chapter_id": 4696, "verse_number": "२४", "content_sanskrit": "उल्काः पेतुर्दिवो भूमावाहत्य रविमण्डलम् ।\nविष्वग्वाताः प्रादुरासन् नीचैः शर्करवर्षिणः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173765, "chapter_id": 4696, "verse_number": "२५", "content_sanskrit": "अश्रूणि मुमुचुर्नागाः वेपथुश्चाविशद् भृशम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173766, "chapter_id": 4696, "verse_number": "२६", "content_sanskrit": "एतान् घोराननादृत्य समुत्पातान् सुदारुणान् ।\nपुनर्युद्धाय सम्मन्त्र्य क्षत्रियास्तस्थुरव्यथाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173767, "chapter_id": 4696, "verse_number": "२७", "content_sanskrit": "रमणीये कुरुक्षेत्रे पुण्ये स्वर्गयियासवः ।\nततो गान्धारराजस्य पुत्रः शकुनिरब्रवीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173768, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173769, "chapter_id": 4696, "verse_number": "२८", "content_sanskrit": "युध्यध्वमग्रतो यावत् पृष्ठतो हन्मि पाण्डवान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173770, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173771, "chapter_id": 4696, "verse_number": "२९", "content_sanskrit": "ततोऽभ्यधावंस्त्वरिता मद्रयोधास्तरस्विनः ।\nहृष्टाः किलकिलाशब्दान् अकुर्वन्नपरे तथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173772, "chapter_id": 4696, "verse_number": "३०", "content_sanskrit": "तेऽस्मांस्तु पुनरासाद्य लब्धलक्षा दुरासदाः ।\nशरासनानि धून्वानाः शरवर्षैरवाकिरन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173773, "chapter_id": 4696, "verse_number": "३१", "content_sanskrit": "ततो हतं परैस्तत्र मद्रराजबलं तदा ।\nदुर्योधनबलं दृष्ट्वा पुनरासीत् पराङ्मुखम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173774, "chapter_id": 4696, "verse_number": "३२", "content_sanskrit": "गान्धारराजस्तु पुनर्वाक्यमाह ततो बली\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173775, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173776, "chapter_id": 4696, "verse_number": "३३", "content_sanskrit": "निवर्तध्वमधर्मज्ञा युध्यध्वं किं द्रुतेन वः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173777, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173778, "chapter_id": 4696, "verse_number": "३४", "content_sanskrit": "अनीकं दशसाहस्रमश्वानां भरतर्षभ ।\nआसीद् गान्धारराजस्य विमलप्रासयोधिनाम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173779, "chapter_id": 4696, "verse_number": "३५", "content_sanskrit": "बलेन तेन विक्रम्य वर्तमाने जनक्षये ।\nपृष्ठतः पाण्डवानीकमभ्यघ्नन् निशितैः शरैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173780, "chapter_id": 4696, "verse_number": "३६", "content_sanskrit": "तदभ्रमिव वातेन क्षिप्यमाणं समन्ततः ।\nअभज्यत महाराज पाण्डवानां महद्बलम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173781, "chapter_id": 4696, "verse_number": "३७", "content_sanskrit": "ततो युधिष्ठिरः प्रेक्ष्य भग्नं स्वबलमन्तिकात् ।\nअभ्यचोदयदव्यग्रः सहदेवं महाबलम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173782, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173783, "chapter_id": 4696, "verse_number": "३८", "content_sanskrit": "असौ सुबलपुत्रो नो जघने पश्य दंसितः ।\nसेनां निषूदयत्येष पश्य पाण्डव दुर्मतिम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173784, "chapter_id": 4696, "verse_number": "३९", "content_sanskrit": "गच्छ त्वं द्रौपदेयैश्च शकुनिं सौबलं जहि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173785, "chapter_id": 4696, "verse_number": "४०", "content_sanskrit": "रथानीकेन युद्ध्येऽहं पाञ्चालैः सहितोऽनघ ।\nगच्छन्तु कुञ्जराः सर्वे वाजिनश्च महाजवाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173786, "chapter_id": 4696, "verse_number": "४१", "content_sanskrit": "पादाताश्च त्रिसाहस्राः शकुनिं तैर्वृतो जहि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173787, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173788, "chapter_id": 4696, "verse_number": "४२", "content_sanskrit": "ततो गजाः सप्तशतं चापपाणिभिरावृताः ।\nपञ्च चाश्वसहस्राणि सहदेवश्च वीर्यवान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173789, "chapter_id": 4696, "verse_number": "४३", "content_sanskrit": "पादाताश्च त्रिसाहस्रा द्रौपदेयाश्च सर्वशः ।\nरणे वाऽभ्यद्रवन्ते तु शकुनिं युद्धदुर्मदम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173790, "chapter_id": 4696, "verse_number": "४४", "content_sanskrit": "ततस्तु सौबलो राजन्नभ्यतिक्रम्य पाण्डवान् ।\nजघान पृष्ठतः सेनां जयगृध्नुः प्रतापवान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173791, "chapter_id": 4696, "verse_number": "४५", "content_sanskrit": "अश्वारोहाः समारब्धाः पाण्डवानां तरस्विनाम् ।\nप्राविशन् सौबलानीकमभ्यतिक्रम्य तान् रथान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173792, "chapter_id": 4696, "verse_number": "४६", "content_sanskrit": "ते तत्र सादिनः शूराः सौबलस्य महद्बलम् ।\nगजमध्ये व्यवस्थाप्य शरवर्षैरवाकिरन्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173793, "chapter_id": 4696, "verse_number": "४७", "content_sanskrit": "तदुद्यतगदाप्रासं महापुरुषसेवितम् ।\nप्रावर्तत महद्युद्धं राजन् दुर्मन्त्रिते तव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173794, "chapter_id": 4696, "verse_number": "४८", "content_sanskrit": "उपारमन्त निःशब्दाः प्रेक्षका रथिनोऽभवन् ।\nन हि स्वेषां परेषां च विशेषः समदृश्यत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173795, "chapter_id": 4696, "verse_number": "४९", "content_sanskrit": "शूरबाहुविसृष्टानां शराणां भरतर्षभ ।\nज्योतिषामिव सम्पातमपश्यन् कुरुपाण्डवाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173796, "chapter_id": 4696, "verse_number": "५०", "content_sanskrit": "शक्तिभिर्विमलाभिश्च तत्र तत्र विशाम्पते ।\nसम्पतन्तीभिराकाशमावृतं बह्वशोभत\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173797, "chapter_id": 4696, "verse_number": "५१", "content_sanskrit": "प्रासानां पततां राजन् रूपमासीत् समन्ततः ।\nशलभानामिवाकाशे तदा भरतसत्तम\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2173798, "chapter_id": 4696, "verse_number": "५२", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गैर्विप्रविद्धैर्नियन्तृभिः ।\nहयाः परिपतन्ति स्म शतशोऽथ सहस्रशः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2173799, "chapter_id": 4696, "verse_number": "५३", "content_sanskrit": "अन्योन्यं प्रतिविद्धाश्च समासाद्य परस्परम् ।\nपरिक्षताः स्म दृश्यते वमन्तो रुधिरं मुखैः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2173800, "chapter_id": 4696, "verse_number": "५४", "content_sanskrit": "ततोऽभवत् तमो घोरं सैन्येन रजसा वृतम् ।\nतानपाक्रमतोऽद्राक्षं तस्माद्देशादरिन्दमान्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2173801, "chapter_id": 4696, "verse_number": "५५", "content_sanskrit": "अश्वान् गजान् मनुष्यांश्च रजसा संवृतो सति ।\nभूमौ निपतिताश्चान्ये वमन्तो रुधिरं बहु\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2173802, "chapter_id": 4696, "verse_number": "५६", "content_sanskrit": "केशाकेशि समालग्ना न शेकुश्चेष्टितुं नराः ।\nअन्योन्यमश्वपृष्ठेभ्यो विकर्षन्तो महाबलाः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2173803, "chapter_id": 4696, "verse_number": "५७", "content_sanskrit": "मल्ला इव समासक्ता निजघ्नुरितरेतरम् ।\nअश्वाश्च व्यपकृष्यन्त बहवोऽत्र गतासवः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2173804, "chapter_id": 4696, "verse_number": "५८", "content_sanskrit": "भूमौ निपतिताश्चान्ये बहवोऽथ जिगीषवः ।\nतत्र तत्र व्यदृश्यन्त पुरुषाः शूरमानिनः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2173805, "chapter_id": 4696, "verse_number": "५९", "content_sanskrit": "रक्तोक्षितैश्छिन्नभुजैः अपकृष्टशिरोधरैः ।\nव्यदृश्यत मही कीर्णा शतशोऽथ सहस्रशः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2173806, "chapter_id": 4696, "verse_number": "६०", "content_sanskrit": "अन्योन्यं प्रतिविद्धाश्च समासाद्य परस्परम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2173807, "chapter_id": 4696, "verse_number": "६१", "content_sanskrit": "दूरं न शक्यं तत्रासीद् गन्तुमश्वेन केनचित् ।\nसारोहैर्निहतैरश्वैरावृते वसुधातळे\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2173808, "chapter_id": 4696, "verse_number": "६२", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गैरात्तशस्त्रैरुदायुधैः ।\nनानाप्रहरणैर्घोरैः परस्परवधैषिभिः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2173809, "chapter_id": 4696, "verse_number": "६३", "content_sanskrit": "सुसन्निविष्टे सङ्ग्रामे हतभूयिष्ठसैनिके ।\nस मुहूर्तं तदा युद्ध्वा सर्वयोधवधे कृते\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2173810, "chapter_id": 4696, "verse_number": "६४", "content_sanskrit": "षट्सहस्रैर्हयैः शिष्टैरपायाच्छकुनिस्ततः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2173811, "chapter_id": 4696, "verse_number": "६५", "content_sanskrit": "तथैव पाण्डवानीकं रुधिरेण समुक्षितम् ।\nत्रिसाहस्रै रथैः शिष्टैरपायाच्छ्रान्तवाहनम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2173812, "chapter_id": 4696, "verse_number": "६६", "content_sanskrit": "अश्वारोहास्तु पाण्डूनामब्रुवन् रुधिरोक्षिताः ।\nसुसन्निविष्टे सङ्ग्रामे भूयिष्ठं त्यक्तजीविताः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2173813, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "पाण्डवसादिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2173814, "chapter_id": 4696, "verse_number": "६७", "content_sanskrit": "न हि शक्यं रथैर्योद्धुं कुत एव महागजैः ।\nरथानेव रथा यान्तु कुञ्जराः कुञ्जरानपि\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2173815, "chapter_id": 4696, "verse_number": "६८", "content_sanskrit": "प्रतियातोऽपि शकुनिः स्वमनीकमवस्थितः ।\nस पुनः सौबलो राजा युद्धमभ्यागमिष्यति\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2173816, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2173817, "chapter_id": 4696, "verse_number": "६९", "content_sanskrit": "ततश्च द्रौपदेयास्तु ते च मत्ता महागजाः ।\nप्रययुर्यत्र पाञ्चाल्यो धृष्टद्युम्नो महारथः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2173818, "chapter_id": 4696, "verse_number": "७०", "content_sanskrit": "सहदेवोऽपि कौरव्य रजोमेघे समुत्थिते ।\nएकाकी प्रययौ तत्र यत्र राजा युधिष्ठिरः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2173819, "chapter_id": 4696, "verse_number": "७१", "content_sanskrit": "तत्र तेषु प्रयातेषु शकुनिः सौबलः पुनः ।\nपार्श्वतोऽभ्यहनत् क्रुद्धो धृष्टद्युम्नस्य वाहिनीम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2173820, "chapter_id": 4696, "verse_number": "७२", "content_sanskrit": "तत् पुनस्तुमुलं युद्धं प्राणांस्त्यक्त्वाऽभ्यवर्तत ।\nतावकानां परेषां च परस्परवधैषिणाम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2173821, "chapter_id": 4696, "verse_number": "७३", "content_sanskrit": "ते ह्यन्योन्यमतक्षन्त तस्मिन् वीरसमागमे ।\nयोधाः पर्यपतन् राजन् शतशोऽथ सहस्रशः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2173822, "chapter_id": 4696, "verse_number": "७४", "content_sanskrit": "असिभिश्छिद्यमानानां शिरसां लोकसङ्क्षये ।\nप्रादुरासीन्महाशब्दस्तालानां पततामिव\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2173823, "chapter_id": 4696, "verse_number": "७५", "content_sanskrit": "विमुक्तानां शरीराणां भिन्नानां पततां भुवि ।\nसायुधानां च बाहूनां वीराणां च विशाम्पते\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2173824, "chapter_id": 4696, "verse_number": "७६", "content_sanskrit": "आसीत् कटकटाशब्दः सुमहान् रोमहर्षणः ।\nनिघ्नन्तो निशितैः शस्त्रैः भ्रातॄन् पुत्रान् सखीनपि\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2173825, "chapter_id": 4696, "verse_number": "७७", "content_sanskrit": "योधाः परिपतन्ति स्म यथाऽऽमिषकृते खगाः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2173826, "chapter_id": 4696, "verse_number": "७८", "content_sanskrit": "अन्योन्यं प्रतिसंरब्धाः परस्परवधैषिणः ।\nअहं पूर्वमहं पूर्वमित्यभ्यघ्नन् सहस्रशः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2173827, "chapter_id": 4696, "verse_number": "७९", "content_sanskrit": "सङ्घातैरासनाद् भ्रष्टैरश्वारोहैर्गतासुभिः ।\nहयाः परिपतन्ति स्म शतशोऽथ सहस्रशः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2173828, "chapter_id": 4696, "verse_number": "८०", "content_sanskrit": "स्फुरतां प्रतिविष्टानामश्वानां शीघ्रसारिणाम् ।\nस्तनतां च मनुष्याणां पततां च विशाम्पते\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2173829, "chapter_id": 4696, "verse_number": "८१", "content_sanskrit": "शक्त्यृष्टिप्रासशब्दश्च तुमलः समजायत ।\nभिन्दन्तः परमर्माणि राजन् दुर्मन्त्रिते तव\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2173830, "chapter_id": 4696, "verse_number": "८२", "content_sanskrit": "निहताश्च शितैः शस्त्रैः न न्यवर्तन्त तावकाः ।\nमत्ताः रुधिरगन्धेन बहवो गतचेतसः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2173831, "chapter_id": 4696, "verse_number": "८३", "content_sanskrit": "जघ्नुः परान् स्वकांश्चैव प्राप्तान् प्राप्ताननन्तरान् ।\nबहवश्च गतप्राणाः क्षत्रियाः जयगृध्निनः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2173832, "chapter_id": 4696, "verse_number": "८४", "content_sanskrit": "एवं हि योधाः संरब्धाः परस्परसमाहताः ।\nभूमावभ्यपतन् राजन् शरशक्तिभिराहताः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2173833, "chapter_id": 4696, "verse_number": "८५", "content_sanskrit": "वृकगृध्रश्वकाकानामतुले मोदके सति ।\nआसीद् बलक्षयो घोरस्तव पुत्रस्य पश्यतः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2173834, "chapter_id": 4696, "verse_number": "८६", "content_sanskrit": "नराश्वकायैः सञ्छन्ना भूमिरासीद् विशाम्पते ।\nरुधिरोदकचित्रा च भीरूणां भयवर्धिनी\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2173835, "chapter_id": 4696, "verse_number": "८७", "content_sanskrit": "असिभिः पट्टसैः शूलैः तक्षमाणाः पुनः पुनः ।\nतावकाः पाण्डवेयांश्च नात्यवर्तन्त भारत\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2173836, "chapter_id": 4696, "verse_number": "८८", "content_sanskrit": "प्रहरन्तो यथाशक्ति यावत् प्राणस्य धारणा ।\nयोधाः परिपतन्ति स्म वमन्तो रुधिरं मुखैः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2173837, "chapter_id": 4696, "verse_number": "८९", "content_sanskrit": "शिरो गृहीत्वा केशेषु कबन्धः प्रत्यदृश्यत ।\nउद्यम्य निशितं खड्गं रुधिरेण समुक्षितम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2173838, "chapter_id": 4696, "verse_number": "९०", "content_sanskrit": "अथोत्थितेषु कबन्धेषु युद्धे तस्मिन् जनाधिप ।\nतदा रुधिरगन्धेन योधाः कश्मलमाविशन्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2173839, "chapter_id": 4696, "verse_number": "९१", "content_sanskrit": "मन्दीभूते ततः शब्दे पाण्डवानां महद्बलम् ।\nअल्पावशिष्टैस्तुरगैरभ्यवर्तत सौबलः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2173840, "chapter_id": 4696, "verse_number": "९२", "content_sanskrit": "ततोऽभ्यधावंस्त्वरिताः पाण्डवा जयगृद्धिनः ।\nपदातयश्च नागाश्च सादिनश्चोद्यतायुधाः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2173841, "chapter_id": 4696, "verse_number": "९३", "content_sanskrit": "कोष्ठीकृत्य तदा ह्येनं परिक्षिप्य च सर्वशः ।\nशस्त्रैर्नानाविधैर्जघ्नुर्युद्धपारं तितीर्षवः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2173842, "chapter_id": 4696, "verse_number": "९४", "content_sanskrit": "त्वदीयांस्तं तु सम्प्रेक्ष्य सर्वशः समभिद्रुतम् ।\nसाश्वपत्तिद्विपरथाः पाण्डवानभिदुद्रुवुः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2173843, "chapter_id": 4696, "verse_number": "९५", "content_sanskrit": "केचित् पदातयः पद्भिर्मुष्टिभिश्च परस्परम् ।\nनिजघ्नुः समरे शूराः क्षीणशस्त्रास्ततोऽपतन्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2173844, "chapter_id": 4696, "verse_number": "९६", "content_sanskrit": "रथेभ्यो रथिनः पेतुर्द्विपेभ्यो हस्तिसादिनः ।\nविमानेभ्यः परिभ्रष्टाः सिद्धाः पुण्यक्षये यथा\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2173845, "chapter_id": 4696, "verse_number": "९७", "content_sanskrit": "एवमन्योन्यमायत्ता योधा जघ्नुर्महामृधे ।\nपितॄन् भ्रातॄन् वयस्यांश्च पुत्रानपि तथाऽपरे\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2173846, "chapter_id": 4696, "verse_number": "९८", "content_sanskrit": "एवमासीदमर्यादं युद्धं भरतसत्तम ।\nप्रासासिबाणकलिले वर्तमाने सुदारुणे\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2173847, "chapter_id": 4696, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2173848, "chapter_id": 4696, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि त्रयोविंशोऽध्यायः ॥२३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}]