[{"id": 7006019000, "chapter_id": 26019, "verse_number": "१-२०२-१", "content_sanskrit": "हरिरुवाच ।\nएकं पुनर्नवामूलमपामार्गस्य वा शिव ।\nसरसं योनिनिः क्षिप्तं वराङ्गस्य व्यथां रेत् ।\nप्रसूतिवेदनाञ्चैव तरुणीनां व्यथां हरेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006019001, "chapter_id": 26019, "verse_number": "१-२०२-२", "content_sanskrit": "भूमि कूष्माण्डमूलं वै शालिचूर्णमथापि वा ।\nसप्ताहं दुग्धपीतं स्यात्स्त्रीणां बहुपयस्करम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006019002, "chapter_id": 26019, "verse_number": "१-२०२-३", "content_sanskrit": "रुद्रेन्द्रवारुणीमुलं लेपात्स्त्रीस्तनवेदना ।\nनश्येत घृतपक्वा च कार्यावश्यन्तु पोलिका ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006019003, "chapter_id": 26019, "verse_number": "१-२०२-४", "content_sanskrit": "भक्षिता सा महेशान योनिशूलं विनाशयेत्। ।\nप्रलेपिता कारवेल्लमूलेनैव विनिर्गता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006019004, "chapter_id": 26019, "verse_number": "१-२०२-५", "content_sanskrit": "योनिः प्रवेशमायाति नात्र कार्या विचरणा ।\nनीलीपटोलमूलानि साज्यानि तिलवारिणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006019005, "chapter_id": 26019, "verse_number": "१-२०२-६", "content_sanskrit": "पिष्टान्येषां प्रलेपो वै ज्वालागर्दभरागनत ।\nपाठामूलं रुद्र पीतं पिष्टं तण्डुलवारिणा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006019006, "chapter_id": 26019, "verse_number": "१-२०२-७", "content_sanskrit": "पापरोगहरं स्याच्च कुष्ठपानं तथैव च ।\nवास्योदकञ्च समधु पीतमन्तर्गतस्य वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006019007, "chapter_id": 26019, "verse_number": "१-२०२-८", "content_sanskrit": "पापरोगस्य सन्तापनिवृक्तिं कुरुते शिव ।\nघृततुल्या रुद्र लाक्षा पीता क्षीरेण वै सह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006019008, "chapter_id": 26019, "verse_number": "१-२०२-९", "content_sanskrit": "प्रदरं हरते रोगं नात्र कार्या विचारणा ।\nद्विजयष्टी त्रिकटुकं चूर्णं पीतं हरेच्छिव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006019009, "chapter_id": 26019, "verse_number": "१-२०२-१०", "content_sanskrit": "तिलक्वाथेन संयुक्तं रक्तगुल्मं स्त्रिया ।\nकुसुमस्य निबद्धञ्च तरुणीनां महेश्वर ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006019010, "chapter_id": 26019, "verse_number": "१-२०२-११", "content_sanskrit": "रक्तोत्पलस्य वै कन्दंशर्करातिलसंयुतम् ।\nपीतं सशर्करं स्त्रीणां धारयेद्गर्भपातनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006019011, "chapter_id": 26019, "verse_number": "१-२०२-१२", "content_sanskrit": "रक्तस्त्रावस्य नाशः स्याच्छीतोदकनिषेवणात् ।\nपीतन्तु काञ्जिक रुद्र क्वथितं शरपुङ्खया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006019012, "chapter_id": 26019, "verse_number": "१-२०२-१३", "content_sanskrit": "हिङ्गुस्त्रैन्धवसंयुक्तं शीघ्रं स्त्रीणां प्रसूतकत् ।\nमातुलुङ्गस्य वै मूलं कटिबद्धं प्रसूतिकृत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006019013, "chapter_id": 26019, "verse_number": "१-२०२-१४", "content_sanskrit": "अपामार्गस्य वै मूले गर्भवत्यास्तु नामतः ।\nउत्पाट्यमाने सकले पुत्त्रः स्यादान्यथा सुता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006019014, "chapter_id": 26019, "verse_number": "१-२०२-१५", "content_sanskrit": "अपामार्गस्य वै मूले नारीणां शिरसि स्थिते ।\nगर्भशूलं विनश्येत नात्र कार्या विचारणा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006019015, "chapter_id": 26019, "verse_number": "१-२०२-१६", "content_sanskrit": "कर्पूरमदनफलमधुकैः पूरितः शिव ।\nयोनिः सुभा स्याद्वृद्धाया युवत्याः किं पुनर्हर ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006019016, "chapter_id": 26019, "verse_number": "१-२०२-१७", "content_sanskrit": "यस्य बालस्य तिलकः कृतो गौरोचनाख्यया ।\nशर्कराकुष्ठपानञ्च दत्तं स स्याच्च निरयः ।\nविषभूतग्रहादिभ्यो व्याधिभ्यो बालकः शिव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006019017, "chapter_id": 26019, "verse_number": "१-२०२-१८", "content_sanskrit": "शङ्खनाभिवचाकुष्ठलोहानां धारणं सदा ।\nबालानामुपसर्गेभ्यो रुद्र रक्षाकरं भवेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006019018, "chapter_id": 26019, "verse_number": "१-२०२-१९", "content_sanskrit": "पलाशचूर्णं समधु गव्याज्यामलकान्वितम् ।\nसविडङ्गं पीतमात्रं नरं कुर्यान्महामतिम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006019019, "chapter_id": 26019, "verse_number": "१-२०२-२०", "content_sanskrit": "मासैकेन महादेव जरामरणवर्जितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006019020, "chapter_id": 26019, "verse_number": "१-२०२-२१", "content_sanskrit": "पलाशबीजं सघृतं तिलमध्वन्वितं समम् ।\nसप्ताहं भक्षितं रुद्र जरां नयति संक्षयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006019021, "chapter_id": 26019, "verse_number": "१-२०२-२२", "content_sanskrit": "रुद्रामलकचूर्णं वै मधुतैल घृतान्वितम् ।\nजग्ध्वा मासं युवा स्याच्च नरो वागीश्वरी भवेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006019022, "chapter_id": 26019, "verse_number": "१-२०२-२३", "content_sanskrit": "शिवामलकचूर्णं वै मधुना उदकेन वा ।\nबलानि कुर्यान्नासायाः प्रत्यूषे भक्षितं शिव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006019023, "chapter_id": 26019, "verse_number": "१-२०२-२४", "content_sanskrit": "कुष्ठचूर्णं साज्यमधु प्रातर्जग्ध्वा भवेन्र ।\nसाक्षात्सुरभिदेहो वै जीवेद्वर्षसहस्रकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006019024, "chapter_id": 26019, "verse_number": "१-२०२-२५", "content_sanskrit": "माषस्य विदलान्ये वितुषाणि महेश्वर ।\nघृतभावितशुष्काणि पयसा साधितानि वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006019025, "chapter_id": 26019, "verse_number": "१-२०२-२६", "content_sanskrit": "समाध्वाज्यपयोभिश्च भक्षयित्वा च कामयेत् ।\nस्त्रीणां शतं महादेव तत्क्षणान्नात्र संशयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006019026, "chapter_id": 26019, "verse_number": "१-२०२-२७", "content_sanskrit": "रसश्चैरण्डतैलेन गन्धकेन शुभो भवेत् ।\nत्रिकालोदकसंघुष्टो बलकृद्भक्षणाद्भवेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006019027, "chapter_id": 26019, "verse_number": "१-२०२-२८", "content_sanskrit": "दुग्धं वितुषमाषैश्च शिम्बाबीजैश्च साधितम् ।\nअपामार्गस्य तैलेन पीतं स्त्रीशतकामकृत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]