[{"id": 2024521, "chapter_id": 1524, "verse_number": "३-१६२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024522, "chapter_id": 1524, "verse_number": "३-१६२-१", "content_sanskrit": "श्रुत्वा बहुविधैः शब्दैर्नाद्यमानां गिरेर्गुहाम्।\nअजातशत्रुः कौन्तेयो माद्रीपुत्रावुभावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024523, "chapter_id": 1524, "verse_number": "३-१६२-२", "content_sanskrit": "धौम्यः कृष्णा च विप्राश्च सर्वे च सुहृदस्तथा।\nभीमसेनमपश्यन्तः सर्वे विमनसोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024524, "chapter_id": 1524, "verse_number": "३-१६२-३", "content_sanskrit": "द्रौपदीमार्ष्टिषेणाय संप्रधार्य महारथाः।\nसहिताः सायुधाः शूराः शैलमारुरुहुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024525, "chapter_id": 1524, "verse_number": "३-१६२-४", "content_sanskrit": "ततः संप्राप्य शैलाग्रं वीक्षमाणा महारथाः।\nददृशुस्ते महेष्वासा भीमसेनमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024526, "chapter_id": 1524, "verse_number": "३-१६२-५", "content_sanskrit": "स्फुरतश्च महाकायान्गतसत्वांश्च राक्षसान्।\nमहाबलान्महासत्वान्भीमसेनेव पातितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024527, "chapter_id": 1524, "verse_number": "३-१६२-६", "content_sanskrit": "शुशुरतश्च महाकायान्गतसत्वांश्च राक्षसान्।\nमहाबलान्महासत्वान्भीमसेनेन पातितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024528, "chapter_id": 1524, "verse_number": "३-१६२-७", "content_sanskrit": "ततस्ते समतिक्रम्य परिष्वज्य वृकोदरम्।\nतत्रोपविविशुः पार्थाः प्राप्ता गतिमनुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024529, "chapter_id": 1524, "verse_number": "३-१६२-८", "content_sanskrit": "तैश्चतुर्भिर्महेष्वासैर्गिरिशृङ्गमशोभत।\nलोकपालैर्महाभागैर्दिवं देववरैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024530, "chapter_id": 1524, "verse_number": "३-१६२-९", "content_sanskrit": "कुबेरसदनं दृष्ट्वा राक्षसांश्च निपातितान्।\nभ्राता भ्रातरमासीनमथोवाच युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024531, "chapter_id": 1524, "verse_number": "३-१६२-१०", "content_sanskrit": "साहसाद्यदिवा मोहाद्बीम पापमिदं कृतम्।\nनैतत्ते सदृशं वीर मुनेरिव मृषा वधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024532, "chapter_id": 1524, "verse_number": "३-१६२-११", "content_sanskrit": "राजद्विष्टं न कर्तव्यमिति धर्मविदो विदुः।\nत्रिदशानामिदं द्विष्टं भीमसेन त्वया कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024533, "chapter_id": 1524, "verse_number": "३-१६२-१२", "content_sanskrit": "अर्थधर्मावनादृत्य यः पापे कुरुते मनः।\nकर्मणां पार्थ पापानां स फलं विन्दते ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024534, "chapter_id": 1524, "verse_number": "३-१६२-१३", "content_sanskrit": "`साहसंवत भद्रं ते देवानामपि चाप्रियम्।\nपुनरेवं न कर्तव्यं मम चेदिच्छसि प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024535, "chapter_id": 1524, "verse_number": "३-१६२-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024536, "chapter_id": 1524, "verse_number": "३-१६२-१४", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा भ्राता भ्रातरमच्युतम्।\n`भीमसेनं महाबाहुमप्रधृष्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024537, "chapter_id": 1524, "verse_number": "३-१६२-१५", "content_sanskrit": "अर्थतत्त्वविभागज्ञः कुन्तीपुत्रो युधिष्ठिरः।\nविराम महातेजास्तमेवार्थं विचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024538, "chapter_id": 1524, "verse_number": "३-१६२-१६", "content_sanskrit": "ततस्ते हतशिष्टा ये भीमसेनेन राक्षसाः।\nसहिताः प्रत्यपद्यन्त कुबेरसदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024539, "chapter_id": 1524, "verse_number": "३-१६२-१७", "content_sanskrit": "ते जवेन महावेगाः प्राप्य वैश्रवणालयम्।\nभीममार्तस्वरं चक्रुर्भीमसेनभयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024540, "chapter_id": 1524, "verse_number": "३-१६२-१८", "content_sanskrit": "न्यस्तशस्त्रायुधाः क्लान्ताः शोणिताक्तपरिच्छदाः।\nप्रकीर्णमूर्धजा राजन्यक्षाधिपतिमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024541, "chapter_id": 1524, "verse_number": "३-१६२-१९", "content_sanskrit": "गदापरिघनिस्त्रिंसतोमरप्रासयोधिनः।\nराक्षसा निहताः सर्वे तव देवपुरःसराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024542, "chapter_id": 1524, "verse_number": "३-१६२-२०", "content_sanskrit": "प्रमृद्यतरसा शैलं मानुषेण धनेश्वर।\nएकेन निहताः सङ्ख्ये गताः क्रोधवशा गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024543, "chapter_id": 1524, "verse_number": "३-१६२-२१", "content_sanskrit": "प्रवरा राक्षसेन्द्राणां यक्षाणां च नराधिप।\nशेरते निहता देव गतसत्वाः परासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024544, "chapter_id": 1524, "verse_number": "३-१६२-२२", "content_sanskrit": "भग्नः शैलो वयं भग्ना मणिमांस्ते सखा हतः।\nमानुषेणं कृतं कर्म विधत्स्व यदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024545, "chapter_id": 1524, "verse_number": "३-१६२-२३", "content_sanskrit": "स तच्छ्रुत्वा तु संक्रुद्धः सर्वयक्षगणाधिपः।\nकोपसंरक्तनयनः कथमित्यब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024546, "chapter_id": 1524, "verse_number": "३-१६२-२४", "content_sanskrit": "द्वितीयमपराध्यन्तं भीमं श्रुत्वा धनेश्वरः।\nचुक्रोध यक्षाधिपतिर्युज्यतामिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024547, "chapter_id": 1524, "verse_number": "३-१६२-२५", "content_sanskrit": "अथाभ्रघनसंकाशं गिरिकूटमिवोच्छ्रितम्।\nरथं संयोजयामासुर्गर्न्धैवर्हेममालिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024548, "chapter_id": 1524, "verse_number": "३-१६२-२६", "content_sanskrit": "तस्य सर्वगुणोपेता विमलाक्षा हयोत्तमाः।\nतेजोबलगुणोपेता नानारत्नविभूषिताः।\nशोभमाना रथे युक्तास्तरिष्यन्त इवाशुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024549, "chapter_id": 1524, "verse_number": "३-१६२-२७", "content_sanskrit": "`ततस्ते तु महायक्षाः क्रुद्धं दृष्ट्वा धनेश्वरम्।\nहर्षयामासुरन्योन्यमिङ्गितैर्विजयावहैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024550, "chapter_id": 1524, "verse_number": "३-१६२-२८", "content_sanskrit": "स तमास्थाय भगवान्राजराजो महारथम्।\nप्रययौ देवगनधर्वैः स्तूयमानो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024551, "chapter_id": 1524, "verse_number": "३-१६२-२९", "content_sanskrit": "तं प्रयान्तं महात्मानं सर्वे यक्षा धनाधिपम्।\n`अनुजग्मुर्महात्मानं धनदं घोरदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024552, "chapter_id": 1524, "verse_number": "३-१६२-३०", "content_sanskrit": "रक्ताक्षा हेमसंकाशा महाकाया महाबलाः।\nसायुधा बद्धनिस्त्रिंशा यक्षा बहुशतायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024553, "chapter_id": 1524, "verse_number": "३-१६२-३१", "content_sanskrit": "ते जवेन महावेगाः प्लवमाना विहायसा।\nगन्धमादनमाजग्मुः प्रकर्षन्त इवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024554, "chapter_id": 1524, "verse_number": "३-१६२-३२", "content_sanskrit": "तत्केसरिमहाजालं धनाधिपतिपालितम्।\n`रम्यं चैव गिरेः शृङ्गमासेदुर्यत्रपाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024555, "chapter_id": 1524, "verse_number": "३-१६२-३३", "content_sanskrit": "कुबेरं च महात्मानं यक्षरक्षोगणावृतम्।\nददृशुर्हृष्टरोमाणः पाण्डवाः प्रियदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024556, "chapter_id": 1524, "verse_number": "३-१६२-३४", "content_sanskrit": "कुबेरस्तु महासत्वान्पाण्डोः पुत्रान्महारथान्।\nआत्तकार्मुकनिस्त्रिंशान्दृष्ट्वा प्रीतोऽभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024557, "chapter_id": 1524, "verse_number": "३-१६२-३५", "content_sanskrit": "`सर्वे चेमे नरव्याघ्राः पुरन्दरसमौजसः।\nदेवकार्यं करिष्यन्ति हृदयेन तुतोष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024558, "chapter_id": 1524, "verse_number": "३-१६२-३६", "content_sanskrit": "ते पक्षिण इवापेतुर्गिरिशृङ्गं महाजवाः।\nतस्थुस्तेषां सकाशे वै धनेश्वरपुरःसराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024559, "chapter_id": 1524, "verse_number": "३-१६२-३७", "content_sanskrit": "ततस्तं हृष्टमनसं पाण्डवान्प्रति भारत।\nसमीक्ष्ययक्षगन्धर्वा निर्विकारमवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024560, "chapter_id": 1524, "verse_number": "३-१६२-३८", "content_sanskrit": "पाण्डवाश्च महात्मानः प्रणम्य धनदं प्रभुम्।\nनकुलः सहदेवश् धर्मपुत्रश्च धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024561, "chapter_id": 1524, "verse_number": "३-१६२-३९", "content_sanskrit": "अपराद्धमिवात्मानं मन्यमाना महारथाः।\nतस्थुः प्राञ्जलयः सर्वे परिवार्य धनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024562, "chapter_id": 1524, "verse_number": "३-१६२-४०", "content_sanskrit": "शय्यासनयुतं श्रीमत्पुष्पकं विश्वकर्मणा।\nविहितं चित्रपर्यन्तमातिष्ठत धनाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024563, "chapter_id": 1524, "verse_number": "३-१६२-४१", "content_sanskrit": "तमासीनं महाकायाः शङ्कुकर्णा महाजवाः।\nउपोपविविशुर्यक्षा राक्षसाश् सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024564, "chapter_id": 1524, "verse_number": "३-१६२-४२", "content_sanskrit": "शतशश्चापि गन्धर्वास्तथैवाप्सरसां गणाः।\nपरिवार्योपतिष्ठन्ति यथा देवाः शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024565, "chapter_id": 1524, "verse_number": "३-१६२-४३", "content_sanskrit": "काञ्जनीं शिरसा बिभ्रद्भीमसेनः स्रजं शुभाम्।\nबाणखङ्गधनुष्पाणिरुदैक्षत धनाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2024566, "chapter_id": 1524, "verse_number": "३-१६२-४४", "content_sanskrit": "न भीर्भीमस्य न ग्लानिर्विक्षतस्यापि राक्षसैः।\nआसीत्तस्यामवस्तायां कुबेरमपि पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2024567, "chapter_id": 1524, "verse_number": "३-१६२-४५", "content_sanskrit": "आददानं शितान्बाणान्योद्धुकाममवस्थितम्।\nदृष्ट्वा भीमं धर्मसुतमब्रवीन्नरवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2024568, "chapter_id": 1524, "verse_number": "३-१६२-४६", "content_sanskrit": "विदुस्त्वां सर्वभूतानि पार्थ भूतहिते रतम्।\nनिर्भयश्चापिशैलाग्रे वस त्वं सह बन्धुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2024569, "chapter_id": 1524, "verse_number": "३-१६२-४७", "content_sanskrit": "न च मन्युस्त्वया कार्यो भीमसेनस्य पाण्डव।\nकालेनैते हताः पूर्वं निमित्तमनुजस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2024570, "chapter_id": 1524, "verse_number": "३-१६२-४८", "content_sanskrit": "व्रीडा चात्रन कर्तव्या साहसं यदिदं कृतम्।\nदृष्टश्चापि सुरैः पूर्वंविनाशो यक्षरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2024571, "chapter_id": 1524, "verse_number": "३-१६२-४९", "content_sanskrit": "न भीमसेने कोपो मे प्रीतोस्मि भरतर्षभ।\nकर्मणा भीमसेनस्य मम तुष्टिरभूत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2024572, "chapter_id": 1524, "verse_number": "३-१६२-५०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2024573, "chapter_id": 1524, "verse_number": "३-१६२-५०", "content_sanskrit": "स एवमुक्त्वा राजानं भीमसेनमभाषत।\nनैतन्मनसि मे तात वर्तते कुरुसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2024574, "chapter_id": 1524, "verse_number": "३-१६२-५१", "content_sanskrit": "यदिदं साहसं भीम कृष्णार्थे कृतवानसि।\nमामनादृत्य देवांश्च विनाशं यक्षरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2024575, "chapter_id": 1524, "verse_number": "३-१६२-५२", "content_sanskrit": "स्वबाहुबलमाश्रित्य तेनाहं प्रीतिमांस्त्वयि।\nशापादद्य विनिर्मुक्तो घोरादस्माद्वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2024576, "chapter_id": 1524, "verse_number": "३-१६२-५३", "content_sanskrit": "अहं पूर्वमगस्त्येन क्रुद्धेन परमर्षिणा।\nशप्तोऽपराधे कस्मिंश्चित्तस्यैषा निष्कृतिर्ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2024577, "chapter_id": 1524, "verse_number": "३-१६२-५४", "content_sanskrit": "दृष्टो हि मम संक्लेशः पुरा पाण्डवनन्दन।\nन तवात्रापराधोस्ति कथंचिदपि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2024578, "chapter_id": 1524, "verse_number": "३-१६२-५५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2024579, "chapter_id": 1524, "verse_number": "३-१६२-५५", "content_sanskrit": "कथं शप्तोसि भगवन्नगस्त्येन महात्मना।\nश्रोतुमिच्छाम्यहं देव यथैतच्छापकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2024580, "chapter_id": 1524, "verse_number": "३-१६२-५६", "content_sanskrit": "इदं चाश्चर्यभूतं मे यत्क्रोधात्तस् धीमतः।\nतदैव त्वं न निर्दग्धः सबलः सपदानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2024581, "chapter_id": 1524, "verse_number": "३-१६२-५७x", "content_sanskrit": "धनेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2024582, "chapter_id": 1524, "verse_number": "३-१६२-५७", "content_sanskrit": "देवतानामभून्मन्त्रः कुशावत्यां नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2024583, "chapter_id": 1524, "verse_number": "३-१६२-५८", "content_sanskrit": "वृतस्तत्राहमगमं महापद्मशतैस्त्रिभिः।\nयक्षाणआं घोररूपाणां विविधायुधधारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2024584, "chapter_id": 1524, "verse_number": "३-१६२-५९", "content_sanskrit": "अध्वन्यहमथापश्यमगस्त्यमृपिसत्तमम्।\nउग्रं तपस्तप्यभानं यमुनातीरमाश्रितम्।\nनानापक्षिगणाकीर्णं पुष्पितद्रुमशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2024585, "chapter_id": 1524, "verse_number": "३-१६२-६०", "content_sanskrit": "तमूर्द्वबाहुं दृष्ट्वैव सूर्यस्याभिमुखे स्थितम्।\nतेजोराशिं दीप्यमानं हुताशनमिवैधितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2024586, "chapter_id": 1524, "verse_number": "३-१६२-६१", "content_sanskrit": "राक्षसाधिपतिः श्रीमान्मणिमान्नाम मे सखा।\nमौर्क्यादज्ञानभावाच्च दर्पान्मोहाच्च पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2024587, "chapter_id": 1524, "verse_number": "३-१६२-६२", "content_sanskrit": "न्यष्ठीवदाकाशगतो महर्षेस्तस्य मूर्धनि।\nततः क्रुद्धः स भगवानुवाचेदं तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2024588, "chapter_id": 1524, "verse_number": "३-१६२-६३", "content_sanskrit": "मामवज्ञाय दुष्टात्मा यस्मादेष सखा तव।\nधर्षणां कृतवानेतां पश्यतस्ते धनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2024589, "chapter_id": 1524, "verse_number": "३-१६२-६४", "content_sanskrit": "त्वं चाप्येभिर्हतैः सैन्यैः क्लेशं प्राप्नुहि दुर्भते।\nतमेव मानुषं दृष्ट्वाकिल्विषाद्विप्रमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2024590, "chapter_id": 1524, "verse_number": "३-१६२-६५", "content_sanskrit": "सैन्यानां तु तवैतेषां पुत्रपौत्रबलान्वितम्।\nन शापं प्राप्यते घोरं गच्छ तेऽऽज्ञां करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2024591, "chapter_id": 1524, "verse_number": "३-१६२-६६", "content_sanskrit": "एष शापो मया प्राप्तः प्राक्तस्मादृषिसत्तमात्।\nस भीमेन महाराज भ्रात्रा तव विमोक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2024592, "chapter_id": 1524, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि यक्षयुद्धपर्वणि द्विषष्ट्यधिकशततमोऽध्यायः ॥ १६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]