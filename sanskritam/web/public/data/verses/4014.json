[{"id": 2139358, "chapter_id": 4014, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139359, "chapter_id": 4014, "verse_number": "१", "content_sanskrit": "सा सूत्रपुत्राभिहता राजपुत्री यशस्विनी ।\nवधं कृष्णा प्ररीप्सन्ती सूतपुत्रस्य भामिनी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139360, "chapter_id": 4014, "verse_number": "२", "content_sanskrit": "जगामावासवेश्माथ तदा सा द्रुपदात्मजा ।\nकृत्वा शौचं यथान्यायं कृष्णाऽपि तनुमध्यमा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139361, "chapter_id": 4014, "verse_number": "३", "content_sanskrit": "गात्राणि वाससी चैव प्रक्षाल्य सलिलेन च ।\nचिन्तयामास रुदती तस्य दुःखस्य निर्णयम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139362, "chapter_id": 4014, "verse_number": "४", "content_sanskrit": "किं करोमि क्व गच्छामि कथं कार्यं भवेन्मम ।\nइत्येवं चिन्तयित्वा सा भीमं तं मनसाऽगमत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139363, "chapter_id": 4014, "verse_number": "५", "content_sanskrit": "नान्यः कर्ता विना भीमान्ममाद्य मनसेप्सितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139364, "chapter_id": 4014, "verse_number": "६", "content_sanskrit": "प्रादुर्भूतक्षणा रात्रौ विहाय शयनं स्वकम् ।\nदुःखेन महता युक्ता मानसेन मनस्विनी\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139365, "chapter_id": 4014, "verse_number": "७", "content_sanskrit": "प्राद्रवन्नाथमिच्छन्ती यथा नाथवती सती\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139366, "chapter_id": 4014, "verse_number": "८", "content_sanskrit": "सा वै महानसं प्राप्य भीमसेनं शुचिस्मिता ।\nउपासर्पत पाञ्चाली वाशितेव महागजम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139367, "chapter_id": 4014, "verse_number": "९", "content_sanskrit": "वृषेन्द्रमिव माहेयी वने वृद्धा त्रिहायनी ।\nउपातिष्ठत पाञ्चाली भीमं कौरव्यमच्युतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139368, "chapter_id": 4014, "verse_number": "१०", "content_sanskrit": "मृगराजं यथा दृप्तं मण्डनी वननिर्झरे ।\nसुप्तं सिंहं तदा स्थाने मृगराजं वधूरिव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139369, "chapter_id": 4014, "verse_number": "११", "content_sanskrit": "अभिप्रसार्य बाहुभ्यां पतिं सुप्तं समाश्लिषत् ।\nसुजातं गोमतीतीरे सालं वल्लीव पुष्पिता\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139370, "chapter_id": 4014, "verse_number": "१२", "content_sanskrit": "परिस्पृश्य च पाणिभ्यां पतिं सुप्तमबोधयत् ।\nश्रीरिवान्या महोत्साहं सुप्तं विष्णुमिवार्णवे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139371, "chapter_id": 4014, "verse_number": "१३", "content_sanskrit": "क्षौमावदाते शयने शयानमृषभेक्षणम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139372, "chapter_id": 4014, "verse_number": "१४", "content_sanskrit": "यथा शची देवराजं रुद्राणी शङ्करं यथा ।\nब्रह्माणमिव सावित्री यथा षष्ठी गुहं तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139373, "chapter_id": 4014, "verse_number": "१५", "content_sanskrit": "दिशाङ्गजसमाकारं गजं गजवधूरिव ।\nभीमं प्राबोधयत् कान्ता लक्ष्मीर्दामोदरं यथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139374, "chapter_id": 4014, "verse_number": "१६", "content_sanskrit": "वीणेव मधुरारक्तं स्वरं गान्धारमाश्रिता ।\nअभ्यभाषत पाञ्चाली कौरव्यं पाण्डुनन्दनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139375, "chapter_id": 4014, "verse_number": "१७", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ किं शेषे भीमसेन यथा मृतः ।\nन मृतः स हि पापीयान् भार्यामालम्ब्य जीवति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139376, "chapter_id": 4014, "verse_number": "१८", "content_sanskrit": "तस्मिन् जीवति पापिष्ठे सेनावाहे मम द्विषि ।\nतत् कर्म कृतवत्यद्य कथं निद्रां निषेवसे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139377, "chapter_id": 4014, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139378, "chapter_id": 4014, "verse_number": "१९", "content_sanskrit": "सुखसुप्तश्च तं शब्दं निशम्य स वृकोदरः ।\nसंवेजितः कुरुश्रेष्ठः तोत्रैरिव महागजः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139379, "chapter_id": 4014, "verse_number": "२०", "content_sanskrit": "स वै विहाय शयनं यस्मिन् सुप्तः प्रबोधितः ।\nउदतिष्ठेदमेयात्मा पर्यङ्के सोत्तरच्छदे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139380, "chapter_id": 4014, "verse_number": "२१", "content_sanskrit": "उपविश्य च दुर्धर्षः पाञ्चालकुलवर्धनीम् ।\nअथाब्रवीद् राजपुत्रीं कौरव्यो महिषीं प्रियाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139381, "chapter_id": 4014, "verse_number": "२२", "content_sanskrit": "केनास्यर्थेन सम्प्राप्ता त्वरितेन ममान्तिकम् ।\nन ते प्रकृतिमान् वर्णः कृशा त्वं भीरु लक्षये\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139382, "chapter_id": 4014, "verse_number": "२३", "content_sanskrit": "प्रकाशं यदि वा गुह्यं सर्वमाख्यातुमर्हसि ।\nआचक्ष्व त्वमशेषेण सर्वं विद्यामहं यथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139383, "chapter_id": 4014, "verse_number": "२४", "content_sanskrit": "सुखं वा यदि वा दुःखं शुभं वा यदि वाऽशुभम् ।\nयद्यप्यसुकृतं कर्म कृतमित्यवधारय\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139384, "chapter_id": 4014, "verse_number": "२५", "content_sanskrit": "अहमेव हि ते कृष्णे विश्वास्यः सर्वकर्मसु ।\nअहमापत्सु चापि त्वां मोक्षयामि पुनः पुनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139385, "chapter_id": 4014, "verse_number": "२६", "content_sanskrit": "शीघ्रमुक्त्वा यथाकामं यत् ते कार्यं विवक्षितम् ।\nगच्छ वै शयनायैव यावदन्यो न बुध्यते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139386, "chapter_id": 4014, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139387, "chapter_id": 4014, "verse_number": "२७", "content_sanskrit": "सा लज्जमाना भीता च अधोमुखमुखी ततः ।\nनोवाच किञ्चिद् वचनं बाष्पदूषितलोचना\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139388, "chapter_id": 4014, "verse_number": "", "content_sanskrit": "अथाब्रवीद् भीमपराक्रमो बली वृकोदरः पाण्डवमुख्यसम्मतः ।\nप्रब्रूहि किं ते करवाणि सुन्दरि प्रियं प्रिये वारणमत्तगामिनि\t ॥२८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139389, "chapter_id": 4014, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139390, "chapter_id": 4014, "verse_number": "२९", "content_sanskrit": "अशोच्यत्वं कुतस्तस्य यस्या भर्ता युधिष्ठिरः ।\nजानन् सर्वाणि दुःखानि किं मां भीमानुपृच्छसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139391, "chapter_id": 4014, "verse_number": "३०", "content_sanskrit": "यन्मां दासीप्रवादेन प्रातिकामी तदाऽनयत् ।\nसभायां परिषन्मध्ये तन्मे मर्माणि कृन्तति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139392, "chapter_id": 4014, "verse_number": "३१", "content_sanskrit": "विकृष्टा हस्तिनपुरे सभायां राजसंसदि ।\nदुःशासनेन केशान्ते परामृष्टा रजस्वला\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139393, "chapter_id": 4014, "verse_number": "३२", "content_sanskrit": "क्षत्रियैस्तत्र कर्णाद्यैर्दृष्टा दुर्योधनेन च ।\nश्वशुराभ्यां च भीष्मेण विदुरेण च धीमता\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139394, "chapter_id": 4014, "verse_number": "३३", "content_sanskrit": "द्रोणेन च महाबाहो कृपेण च परन्तप\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139395, "chapter_id": 4014, "verse_number": "३४", "content_sanskrit": "साऽहं श्वशुरयोर्मध्ये भ्रातृमध्ये च पाण्डव ।\nकेशे गृह्य सभां नीता त्वयि जीवति भारत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139396, "chapter_id": 4014, "verse_number": "३५", "content_sanskrit": "विप्रमुक्ता ततश्चाहं हृतराज्या वनं गता ।\nसाऽहं वने दुर्वसतीर्वसन्ती चाध्वकर्शिता\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139397, "chapter_id": 4014, "verse_number": "३६", "content_sanskrit": "गजस्वरपरिक्लेशे तत्रापि सुमहद् भयम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139398, "chapter_id": 4014, "verse_number": "३७", "content_sanskrit": "पार्थिवस्य सुता नाम का नु जीवेत मादृशी ।\nअनुभूय भृशं दुःखमन्यत्र द्रौपदीं प्रभो\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139399, "chapter_id": 4014, "verse_number": "३८", "content_sanskrit": "वनवासगतायाश्च सैन्धवेन दुरात्मना ।\nपरामर्शं द्वितीयं च सोढुमुत्सहते नु का\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139400, "chapter_id": 4014, "verse_number": "३९", "content_sanskrit": "पद्भ्यां पर्यचरं चाहं देशान् विषमसंस्थितान् ।\nदुर्गान् श्वापदसङ्कीर्णान् त्वयि जीवति पाण्डव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139401, "chapter_id": 4014, "verse_number": "४०", "content_sanskrit": "ततोऽहं द्वादशे वर्षे कन्दमूलफलाशना ।\nइमां पुरमनुप्राप्ता सुदेष्णापरिचारिका\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139402, "chapter_id": 4014, "verse_number": "४१", "content_sanskrit": "परस्त्रियमुपातिष्ठे सत्यधर्मपथे स्थिता ।\nगोशीर्षकं पद्मकं च हरिं पिङ्क्षे च चन्दनम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139403, "chapter_id": 4014, "verse_number": "४२", "content_sanskrit": "नित्यं पिङ्क्षे विराटस्य त्वयि जीवति पाण्डव\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139404, "chapter_id": 4014, "verse_number": "४३", "content_sanskrit": "साऽहं बहूनि दुःखानि गणयामि कृते न ते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139405, "chapter_id": 4014, "verse_number": "४४", "content_sanskrit": "मत्स्यराजसमक्षं तु तस्य धूर्तस्य पश्यतः ।\nकीचकेन पदा स्पृष्टा का नु जीवेत मादृशी\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139406, "chapter_id": 4014, "verse_number": "४५", "content_sanskrit": "एवं बहुविधैः क्लेशैः क्लिश्यमानां च पाण्डव ।\nन मां जानासि कौन्तेय किं फलं जीवितेन मे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139407, "chapter_id": 4014, "verse_number": "४६", "content_sanskrit": "द्रुपदस्य सुता चाहं धृष्टद्युम्नस्य चानुजा ।\nअग्निकुण्डात् समुद्भूता नोर्व्यां जातु चरामि भो\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139408, "chapter_id": 4014, "verse_number": "४७", "content_sanskrit": "कीचकं चेन्न हन्यास्त्वं ग्रीवां बद्ध्वा जले म्रिये ।\nविषमालोड्य पास्यामि प्रवेक्ष्याम्यथवाऽनलम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139409, "chapter_id": 4014, "verse_number": "४८", "content_sanskrit": "आत्मानं नाशयिष्यामि वृक्षमारुह्य वा पते ।\nशस्त्रेणाङ्गं च भेत्स्यामि किं फलं जीवितेन मे\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139410, "chapter_id": 4014, "verse_number": "४९", "content_sanskrit": "योऽयं राज्ञो विराटस्य कीचको नाम भारत ।\nसेनानीः पुरुषव्याघ्र स्यालः परमदुर्मतिः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139411, "chapter_id": 4014, "verse_number": "५०", "content_sanskrit": "स मां सैरन्ध्रिवेषेण चरन्तीं राजवेश्मनि ।\nनित्यमेवाह दुष्टात्मा भार्या भव ममेति वै\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139412, "chapter_id": 4014, "verse_number": "५१", "content_sanskrit": "तेनैवं चोद्यमानाया वधार्हेणारिसूदन ।\nकालेनेव फलं पक्वं हृदयं मे विदीर्यते\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139413, "chapter_id": 4014, "verse_number": "५२", "content_sanskrit": "स्वरूपं तव कौन्तेय मा स्म गच्छ युधिष्टिरम् ।\nनिरुद्योगं निरामर्षं निर्वीर्यमरिनन्दनम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139414, "chapter_id": 4014, "verse_number": "५३", "content_sanskrit": "मा स्म सीमन्तिनी काचित् जनयेत् पुत्रमीदृशम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2139415, "chapter_id": 4014, "verse_number": "५४", "content_sanskrit": "विजानामि तवामर्षं बलं वीर्यं च पाण्डव ।\nततोऽहं परिदेवामि चाग्रतस्ते महाबल\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2139416, "chapter_id": 4014, "verse_number": "५५", "content_sanskrit": "यथा यूथपतिर्मत्तः कुञ्जरः षष्टिहायनः ।\nभूमौ निपतितं बिल्वं पद्भ्यामाक्रम्य पीडयेत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2139417, "chapter_id": 4014, "verse_number": "५६", "content_sanskrit": "तथैव च शिरस्तस्य निपात्य धरणीतळे ।\nगमने पुरुषव्याघ्र मर्द पादेन पाण्डव\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2139418, "chapter_id": 4014, "verse_number": "५७", "content_sanskrit": "स चेदुद्यन्तमादित्यं प्रातरुत्थाय पश्यति ।\nकीचकः शर्वरीं व्युष्टां नाहं जीवितुमुत्सहे\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2139419, "chapter_id": 4014, "verse_number": "५८", "content_sanskrit": "शापितोऽसि मम प्राणैः सुकृतेनार्जुनस्य च ।\nयुधिष्ठिरस्य पादाभ्यां यमयोर्जीवितेन च ।\nयत् कीचकवधं नाद्य प्रतिजानासि भारत\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2139420, "chapter_id": 4014, "verse_number": "५९", "content_sanskrit": "भ्रातरं च विगर्हस्व ज्येष्ठं दुर्द्यूतदेविनम् ।\nयस्यास्मि कर्मणा प्राप्ता दुःखमेतदनन्तकम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2139421, "chapter_id": 4014, "verse_number": "६०", "content_sanskrit": "को हि राज्यं परित्यज्य सपुत्रपशुबान्धवम् ।\nप्रव्रजेत महारण्यमजनैः परिवारितम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2139422, "chapter_id": 4014, "verse_number": "६१", "content_sanskrit": "यदि निष्कसहस्राणि यच्चान्यत् सारवद्धनम् ।\nसायं प्रातरदेविष्यदपि संवत्सरायुतम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2139423, "chapter_id": 4014, "verse_number": "६२", "content_sanskrit": "रूप्यं हिरण्यं वासांसि यानं युग्यमजाविकम् ।\nअश्वाश्च रथसङ्घाश्च न जातु क्षयमाव्रजेत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2139424, "chapter_id": 4014, "verse_number": "६३", "content_sanskrit": "सोऽयं द्यूतप्रवादेन श्रियश्चाप्यवरोपितः ।\nतूष्णीमास्ते यथा मूढः स्वानि कर्माण्यचिन्तयन्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2139425, "chapter_id": 4014, "verse_number": "६४", "content_sanskrit": "पुरा शतसहस्राणि दन्तिनां हेममालिनाम् ।\nयं यान्तमनुयान्ति स्म सोऽयं द्यूतेन जीवति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2139426, "chapter_id": 4014, "verse_number": "६५", "content_sanskrit": "तथा दशसहस्राणि नृपाणामतितेजसाम् ।\nउपासते स्म राजानमिन्द्रप्रस्थे युधिष्ठिरम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2139427, "chapter_id": 4014, "verse_number": "६६", "content_sanskrit": "शतं दासीसहस्राणां यस्य नित्यं महानसे ।\nपात्रहस्तं दिवारात्रमतिथीन् भोजयत्युत\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2139428, "chapter_id": 4014, "verse_number": "६७", "content_sanskrit": "एष निष्कसहस्राणि दत्त्वा प्रातर्दिनेदिने ।\nद्यूतजेन ह्यनर्थेन महता समुपाश्रितः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2139429, "chapter_id": 4014, "verse_number": "६८", "content_sanskrit": "एनं सुस्वरसम्पन्ना बहवः सूतमागधाः ।\nसुप्तं प्रातरुपातिष्ठन् सुमृष्टमणिकुण्डलाः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2139430, "chapter_id": 4014, "verse_number": "६९", "content_sanskrit": "सहस्रमृषयो यस्य नित्यमासन् सभासदः ।\nतपःश्रुतोपसम्पन्नाः सर्वकामैरुपस्थिताः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2139431, "chapter_id": 4014, "verse_number": "७०", "content_sanskrit": "अष्टाशीतिसहस्राणि स्नातका गृहमेधिनः ।\nत्रिंशद्दासीक एकैको यान् बिभर्ति युधिष्ठिरः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2139432, "chapter_id": 4014, "verse_number": "७१", "content_sanskrit": "अप्रतिग्राहिणं चैव यतीनामूर्ध्वरेतसाम् ।\nदश चापि सहस्राणि सोयमास्ते नरेश्वरः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2139433, "chapter_id": 4014, "verse_number": "७२", "content_sanskrit": "आनृशंस्यमनुक्रोशः संविभागस्तथैव च ।\nयस्मिन्नेतानि सर्वाणि सोयमास्ते युधिष्ठिरः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2139434, "chapter_id": 4014, "verse_number": "७३", "content_sanskrit": "अन्धान् वृद्धांस्तथा दीनान् सर्वराष्ट्रेषु दुःखितान् ।\nबिभर्त्यन्नार्थिनो नित्यम् आनृशंस्याद् युधिष्ठिरः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2139435, "chapter_id": 4014, "verse_number": "७४", "content_sanskrit": "स एष निलयं प्राप्तो मात्स्यस्य परिचारकः ।\nसभायां विदितो राज्ञः कङ्को नाम युधिष्ठिरः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2139436, "chapter_id": 4014, "verse_number": "७५", "content_sanskrit": "इन्द्रप्रस्थे निवसतः समये यस्य पार्थिवाः ।\nआसन् बलिकराः सर्वे सोऽन्येभ्यो भूतिमिच्छति\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2139437, "chapter_id": 4014, "verse_number": "७६", "content_sanskrit": "पार्थिवाः पृथिवीपाला यस्यासन् वशवर्तिनः ।\nस वशे विवशो राज्ञां परेषामद्य वर्तते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2139438, "chapter_id": 4014, "verse_number": "७७", "content_sanskrit": "सम्प्राप्य पृथिवीं सर्वां रश्मिमानिव तेजसा ।\nसोऽद्य राज्ञो विराटस्य सभास्तारो युधिष्ठिरः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2139439, "chapter_id": 4014, "verse_number": "७८", "content_sanskrit": "यमुपासत राजानं सभायामृषिसत्तमाः ।\nतमुपासन्तमद्यान्यं पश्य पाण्डव पाण्डवम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2139440, "chapter_id": 4014, "verse_number": "७९", "content_sanskrit": "सहस्रं वालखिल्यानां सहस्रमुदवासिनाम् ।\nसहस्रमग्निकुण्डानां सहस्रं वायुभोजिनाम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2139441, "chapter_id": 4014, "verse_number": "८०", "content_sanskrit": "सहस्रं मुक्तपत्नीनां सहस्रं ब्रह्मचारिणाम् ।\nसहस्रमाहिताग्नीनां सहस्रं गृहमेधिनाम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2139442, "chapter_id": 4014, "verse_number": "८१", "content_sanskrit": "हंसाः परमहंसाश्च योगिनश्च द्विजातयः ।\nकुटीचका परिव्राजो ये चान्ये व्रतचारिणः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2139443, "chapter_id": 4014, "verse_number": "८२", "content_sanskrit": "संविभक्तात्मकाश्चैव बहवश्चोर्ध्वरेतसः ।\nचतुर्वेदविदो विप्राः शिक्षामीमांसपारगाः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2139444, "chapter_id": 4014, "verse_number": "८३", "content_sanskrit": "क्रमपाठाश्च ये विप्राः सामाध्यायनिकाश्च ये ।\nस एष निलयं प्राप्तो मात्स्यस्य परिचारकः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2139445, "chapter_id": 4014, "verse_number": "८४", "content_sanskrit": "अनवद्यं महाप्राज्ञं जीवितार्थेन संवृतम् ।\nदृष्ट्वा कस्य न दुःखं स्याद् धर्मराजं युधिष्ठिरम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2139446, "chapter_id": 4014, "verse_number": "८५", "content_sanskrit": "उपास्ते स्म सभायां यं कृत्स्ना चैव वसुन्धरा ।\nतमुपासन्तमद्यान्यं पश्य भारत भारतम्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2139447, "chapter_id": 4014, "verse_number": "८६", "content_sanskrit": "एवं बहुविधैर्दुःखैः पीड्यमानामनाथवत् ।\nशोकसागरमध्यस्थां किं मां भीम न पश्यसि\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2139448, "chapter_id": 4014, "verse_number": "८७", "content_sanskrit": "इदं तु मे दुःखतरं यत् त्वां वक्ष्यामि भारत ।\nन मे ह्यसूया कर्तव्या दुःखादेतद् ब्रवीम्यहम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2139449, "chapter_id": 4014, "verse_number": "८८", "content_sanskrit": "शार्दूलैर्महिषैर्नागैरगारे योत्स्यसे सदा ।\nकैकेय्याः प्रेक्षमाणायाः तदा मे कश्मलोऽभवत्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2139450, "chapter_id": 4014, "verse_number": "८९", "content_sanskrit": "सूदकर्मणि भीम त्वमसमे भरतर्षभ ।\nब्रुवन् वल्लवजातीयः कस्य शोकं न वर्धयेः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2139451, "chapter_id": 4014, "verse_number": "९०", "content_sanskrit": "सूपकारं विराटस्य वल्लवं त्वं विदुर्जनाः ।\nप्रेष्यत्वं समनुप्राप्तं ततो दुःखतरं नु किम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2139452, "chapter_id": 4014, "verse_number": "९१", "content_sanskrit": "यदा महानसे सिद्धे विराटमुपतिष्ठसि ।\nब्रुवाणो वल्लवः सूदस्तदा सीदति मे मनः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2139453, "chapter_id": 4014, "verse_number": "९२", "content_sanskrit": "यदा प्रहृष्टः सम्राट् त्वां संयोधयति कुञ्जरैः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2139454, "chapter_id": 4014, "verse_number": "९३", "content_sanskrit": "हसन्त्यन्तःपुरे नार्यो मम चेष्टां निरीक्ष्य च\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2139455, "chapter_id": 4014, "verse_number": "९४", "content_sanskrit": "तत उत्थाय कैकेयी सर्वास्ताः प्रत्यभाषत ।\nप्रेक्ष्य मामनवद्याङ्गीं कश्मलाभिहतामिव\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2139456, "chapter_id": 4014, "verse_number": "९५", "content_sanskrit": "स्नेहात् संवासजादेव सदा वै चारुहासिनी ।\nयुध्यमानं महावीर्यमिमं समनुशोचति\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2139457, "chapter_id": 4014, "verse_number": "९६", "content_sanskrit": "कल्याणरूपा सैरन्ध्री वललश्चापि सुन्दरः ।\nस्त्रीणां चित्तं हि दुर्ज्ञेयं युक्तरूपौ हि मे मतौ\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2139458, "chapter_id": 4014, "verse_number": "९७", "content_sanskrit": "सैरन्ध्री प्रियसंवासान्नित्यं करुणवादिनी ।\nअस्मिन् राजकुले चेमौ तुल्यकालनिवासिनौ\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2139459, "chapter_id": 4014, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवाणा वाक्यानि सा मां नित्यमजीजपत्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2139460, "chapter_id": 4014, "verse_number": "९९", "content_sanskrit": "क्रुध्यन्तीं मां च सम्प्रेक्ष्य पर्यशङ्कत मां त्वयि\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2139461, "chapter_id": 4014, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2139462, "chapter_id": 4014, "verse_number": "१००", "content_sanskrit": "तस्यां तथा ब्रुवन्त्यां तु भीमो भीमपराक्रमः ।\nनोवाच किञ्चिद् वचनं संरम्भाद् रक्तलोचनः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2139463, "chapter_id": 4014, "verse_number": "१०१", "content_sanskrit": "ज्ञात्वा तु रुषितं भीमं द्रौपदी पुनरब्रवीत् ।\nत्वय्येव निरयं प्राप्ते भीम भीमपराक्रमे\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2139464, "chapter_id": 4014, "verse_number": "१०२", "content_sanskrit": "शोके यौधिष्ठिरे मग्ना नाहं जीवितुमुत्सहे\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2139465, "chapter_id": 4014, "verse_number": "१०३", "content_sanskrit": "यः स देवान् मनुष्यांश्च सर्वानेकरथोऽजयत् ।\nसोऽयं राज्ञो विराटस्य कन्यानर्तनको युवा\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2139466, "chapter_id": 4014, "verse_number": "१०४", "content_sanskrit": "योऽतर्पयदमेयात्मा खाण्डवे जातवेदसम् ।\nसोऽन्तःपुरगतः पार्थः कूपेऽग्निरिव संवृतः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2139467, "chapter_id": 4014, "verse_number": "१०५", "content_sanskrit": "यस्माद् भयममित्राणां सदैव पुरुषर्षभात् ।\nस लोकपरिभूतेन वेषेणास्ते धनञ्जयः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2139468, "chapter_id": 4014, "verse_number": "१०६", "content_sanskrit": "यस्य ज्याक्षेपकठिनैः बाहू परिघसन्निभौ ।\nस शङ्खपरिपूर्णाभ्यां शोचन्नास्ते धनञ्जयः\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2139469, "chapter_id": 4014, "verse_number": "१०७", "content_sanskrit": "यस्य ज्यातळनिर्घोषात् समकम्पन्त शत्रवः ।\nषण्डरूपं वहन्तं तं नृत्यगीतैश्च लम्बिनम्\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2139470, "chapter_id": 4014, "verse_number": "१०८", "content_sanskrit": "कुर्वन्तमर्जुनं दृष्ट्वा न मे स्वास्थ्यं मनो व्रजेत् ।\nस्त्रियो गीतस्वनं तस्य मुदिताः पर्युपासते\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2139471, "chapter_id": 4014, "verse_number": "१०९", "content_sanskrit": "किरीटं सूर्यसङ्काशं यस्य मूर्धन्यशोभत ।\nवेणीविकृतकेशान्तः सोऽयमद्य धनञ्जयः\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2139472, "chapter_id": 4014, "verse_number": "११०", "content_sanskrit": "यस्मिन्नस्त्राणि दिव्यानि सुबहूनि महात्मनि ।\nआधारः सर्वविद्यानां स धारयति कुण्डले\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2139473, "chapter_id": 4014, "verse_number": "१११", "content_sanskrit": "यं वै राजसहस्राणि तेजसाऽप्रतिमं भुवि ।\nसमरे नातिवर्तन्ते वेलामिव महोर्मयः\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2139474, "chapter_id": 4014, "verse_number": "११२", "content_sanskrit": "सोऽयं राज्ञो विराटस्य कन्यानर्तनको युवा ।\nआस्ते वेषप्रतिच्छन्नः कन्यानां परिचारकः\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2139475, "chapter_id": 4014, "verse_number": "११३", "content_sanskrit": "यस्य स्म रथघोषेण समकम्पन्त मेदिनी ।\nसपर्वतवनाकाशा सहस्थावरजङ्गमा\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2139476, "chapter_id": 4014, "verse_number": "११४", "content_sanskrit": "यस्मिन् जाते महेष्वासे कुन्त्याः प्रीतिरवर्धत ।\nस संशोचति मामद्य भीमसेन तवानुजः\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2139477, "chapter_id": 4014, "verse_number": "११५", "content_sanskrit": "विभूषितमलङ्कारैः कुण्डलैः परिपादुकैः ।\nकम्बुपाणिमथायान्तं दृष्ट्वा सीदति मे मनः\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2139478, "chapter_id": 4014, "verse_number": "११६", "content_sanskrit": "वेणीविकृतकेशान्तं भीमधन्वानमर्जुनम् ।\nकन्यापरिवृतं दृष्ट्वा शोकं गच्छति मे मनः\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2139479, "chapter_id": 4014, "verse_number": "११७", "content_sanskrit": "यदा ह्येनं परिवृतं कन्याभिर्देवरूपिणम् ।\nप्रभिन्नमिव मातङ्गं परिकीर्णं करेणुभिः\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2139480, "chapter_id": 4014, "verse_number": "११८", "content_sanskrit": "मात्स्यं पार्थं च गायन्तं विराटं समुपस्थितम् ।\nपश्यामि तूर्यमध्यस्थं दृष्ट्वा मुह्यति मे मनः\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2139481, "chapter_id": 4014, "verse_number": "११९", "content_sanskrit": "नूनमार्या न जानाति कृच्छ्रं प्राप्तं धनञ्जयम् ।\nअजातशत्रुं राजानं मग्नं द्युर्द्यूतदेवने\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2139482, "chapter_id": 4014, "verse_number": "१२०", "content_sanskrit": "ऐन्द्रवारुणवायव्यब्राह्माग्नेयैश्च वैष्णवैः ।\nअग्नीन् सन्तर्पयन् पार्थः सर्वांश्चैकरथोऽजयत्\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2139483, "chapter_id": 4014, "verse_number": "१२१", "content_sanskrit": "दिव्यैरस्त्रैरचिन्त्यात्मा सर्वशत्रुनिबर्हणः\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2139484, "chapter_id": 4014, "verse_number": "१२२", "content_sanskrit": "दिव्यं गान्धर्वमस्त्रं च वायव्यमथ वैष्णवम् ।\nब्राह्मं पाशुपतं चैव स्थूणाकर्णं च दर्शयन्\t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2139485, "chapter_id": 4014, "verse_number": "१२३", "content_sanskrit": "पौलोमान् कालकेयांश्च इन्द्रशत्रून् महारथान् ।\nनिवातकवचैः सार्धं घोरानेकरथोऽजयत्\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2139486, "chapter_id": 4014, "verse_number": "१२४", "content_sanskrit": "सोऽन्तःपुरगतः पार्थः कूपेऽग्निरिव संवृतः\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2139487, "chapter_id": 4014, "verse_number": "१२५", "content_sanskrit": "कन्यापुरगतं दृष्ट्वा गोष्ठेष्विव महर्षभम् ।\nस्त्रीवेषविकृतं पार्थं कुन्तीं गच्छति मे मनः\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2139488, "chapter_id": 4014, "verse_number": "१२६", "content_sanskrit": "यः स्त्रीभिर्नित्यसम्पन्नो रूपेणास्त्रेण मेधया ।\nसोऽश्वबन्धो विराटस्य पश्य कालस्य पर्ययम्\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2139489, "chapter_id": 4014, "verse_number": "१२७", "content_sanskrit": "राजकन्याश्च वेश्याश्च विशां दुहितरः स्त्रियः ।\nसर्वाः सारयुता नार्यो दामग्रन्थिवशं गताः\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2139490, "chapter_id": 4014, "verse_number": "१२८", "content_sanskrit": "प्रेष्यकर्मणि तं दृष्ट्वा शोचामि विलपामि च\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2139491, "chapter_id": 4014, "verse_number": "१२९", "content_sanskrit": "विराटमुपतिष्ठन्तं दर्शयन्तं च वाजिनः ।\nअभ्यकीर्यन्त वृन्दानि दामग्रन्थिमुदीक्षितुम्\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2139492, "chapter_id": 4014, "verse_number": "१३०", "content_sanskrit": "विनयन्तं जवेनाश्वान् मत्स्यराजस्य पश्यतः\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2139493, "chapter_id": 4014, "verse_number": "१३१", "content_sanskrit": "किं नु मां मन्यसे पार्थ सुखितेति परन्तप ।\nतथा दृष्ट्वा यवीयांसं सहदेवं युधाम्पतिम्\t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2139494, "chapter_id": 4014, "verse_number": "१३२", "content_sanskrit": "तं दृष्ट्वा गोषु गोसङ्ख्यं वत्सचर्मक्षितीशयम् ।\nदुःखशोकपरीताङ्गी पाण्डुभूताऽस्मि पाण्डव\t॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2139495, "chapter_id": 4014, "verse_number": "१३३", "content_sanskrit": "सहदेवस्य वृत्तानि चिन्तयन्ती पुनः पुनः ।\nन निद्रामधिगच्छामि भीमसेन कुतो रतिम्\t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2139496, "chapter_id": 4014, "verse_number": "१३४", "content_sanskrit": "न पश्यामि महाबाहो सहदेवस्य दुष्कृतम्\t॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2139497, "chapter_id": 4014, "verse_number": "१३५", "content_sanskrit": "यस्मिन्नेवंविधं क्लेशं प्राप्नुयात् सत्यविक्रमः ।\nदूयामि भरतश्रेष्ठ दृष्ट्वा ते भ्रातरं प्रियम्\t॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2139498, "chapter_id": 4014, "verse_number": "१३६", "content_sanskrit": "गोषु गोवृषसङ्काशं मात्स्येनाभिसमीक्षितम् ।\nसंरब्धतररक्ताक्षं गोपालानां पुरोगमम्\t॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2139499, "chapter_id": 4014, "verse_number": "१३७", "content_sanskrit": "विराटमभिनन्दन्तमथ मे भवति ज्वरः\t॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2139500, "chapter_id": 4014, "verse_number": "१३८", "content_sanskrit": "सहदेवं हि मे नित्यं वीरमार्या प्रशंसति ।\nमहाभिजनसम्पन्नो नीतिमान् शीलवानपि\t॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2139501, "chapter_id": 4014, "verse_number": "१३९", "content_sanskrit": "ह्रीनिषेधो ह्यनवमो धार्मिकश्च प्रियश्च मे ।\nस तेऽरण्येषु वोढव्यः पाञ्चालि रजनीष्वपि\t॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2139502, "chapter_id": 4014, "verse_number": "१४०", "content_sanskrit": "सुकुमारश्च शूरश्च राजानं चाप्यनुव्रतः ।\nज्येष्ठाय चापि तं वीरं स्वयं पाञ्चालि भाजयेः\t॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2139503, "chapter_id": 4014, "verse_number": "१४१", "content_sanskrit": "इत्युवाच हि मां कुन्ती रुदती पुत्रगृद्धिनी ।\nप्रव्रजन्तं महारण्यं तं परिष्वज्य तिष्ठती\t॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2139504, "chapter_id": 4014, "verse_number": "१४२", "content_sanskrit": "तं दृष्ट्वा गोषु गोपालवेशमास्थाय धिष्ठितम् ।\nसहदेवं युधां श्रेष्ठं किं नु जीवामि पाण्डव\t॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2139505, "chapter_id": 4014, "verse_number": "१४३", "content_sanskrit": "एवं दुःखशताविष्टा युधिष्ठिरनिमित्ततः\t॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2139506, "chapter_id": 4014, "verse_number": "१४४", "content_sanskrit": "पुनः प्रतिप्रशिष्टानि दुःखानि शृणु भारत ।\nवर्तन्ते मयि कौन्तेय वक्ष्याम्यन्यानि तानि ते\t॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2139507, "chapter_id": 4014, "verse_number": "१४५", "content_sanskrit": "युष्मासु ध्रियमाणेषु दुःखानि विविधान्युत ।\nशोषयन्ति शरीरं मे किं नु दुःखतरं ततः\t॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2139508, "chapter_id": 4014, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि द्वाविंशोऽध्यायः ॥२२॥\nकीचकवधपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}]