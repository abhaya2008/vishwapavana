[{"id": 7003188000, "chapter_id": 23188, "verse_number": "४-१२४-१", "content_sanskrit": "अथ चतुर्विंशत्यधिकशततमोऽध्योयः ।\nनालायण उवाच ।\nराधा संपूज्य विधिना स्तुत्वा लम्बोदरं सती ।\nअमूल्यरत्ननिर्माणं सर्वाङ्गभूषणं ददौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003188001, "chapter_id": 23188, "verse_number": "४-१२४-२", "content_sanskrit": "राधायाः स्तवनं श्रुत्वा पूजां दृष्ट्वा च वस्तु च ।\nउवाच मधुरं शान्तः शान्तां त्रैलोक्यमातरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003188002, "chapter_id": 23188, "verse_number": "४-१२४-३", "content_sanskrit": "गणेश उवाच ।\nतव पूजा जगन्मातर्लोकशिक्षाकरी शुभे ।\nब्रह्मस्वरूपा भवती कृष्णवक्षः स्थलस्थिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003188003, "chapter_id": 23188, "verse_number": "४-१२४-४", "content_sanskrit": "यत्पादपद्मतुलं ध्यायन्ते ते सुदुर्लभम् ।\nसुरा ब्रह्मेशशेषाद्या मुनीन्द्राः सनकादयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003188004, "chapter_id": 23188, "verse_number": "४-१२४-५", "content_sanskrit": "जीवन्मुक्ताश्च भक्ताश्च सिद्धेन्द्राः कपिलादयः ।\nतस्य प्राणाधिदेवी त्वं प्रिया प्राणाधिका परा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003188005, "chapter_id": 23188, "verse_number": "४-१२४-६", "content_sanskrit": "वामाङ्गनिर्मिता राधा दक्षिणाङ्गश्च माधवः ।\nमहालक्ष्मीर्जगन्माता तव वामाङ्गनिर्मिता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003188006, "chapter_id": 23188, "verse_number": "४-१२४-७", "content_sanskrit": "वसोः सर्वनिवासस्य प्रसूस्त्वं परमेश्वरी ।\nवेदानां जगतामेव मूल्प्रकृतिरीश्वरी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003188007, "chapter_id": 23188, "verse_number": "४-१२४-८", "content_sanskrit": "सर्वाः प्राकृतिका मातः सृष्ट्यां च त्वद्विभूतयः ।\nविश्वानि कार्यरूपाणि त्वं च कारणरूपिणी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003188008, "chapter_id": 23188, "verse_number": "४-१२४-९", "content_sanskrit": "प्रलये ब्रह्मणः पाते तन्निमेषो हरेरपि ।\nआदौ राधां समुच्चार्य पश्चात्कृष्णं परात्परम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003188009, "chapter_id": 23188, "verse_number": "४-१२४-१०", "content_sanskrit": "स एव पण्डितो योगी गोलोकं याति लीलया ।\nआदौ राधां समुच्चार्य पश्चात्कृष्णं परात्परम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003188010, "chapter_id": 23188, "verse_number": "४-१२४-११", "content_sanskrit": "जगतां भवती माता परमात्मा पिता हरिः ।\nपितुरेव गुरुर्माता पूज्या वन्द्या परात्परा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003188011, "chapter_id": 23188, "verse_number": "४-१२४-१२", "content_sanskrit": "भजते देवमन्यं वा कृष्णं वा सर्वकारणम् ।\nपुण्यक्षेत्रे महामूढो यदि निन्दति राधिकाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003188012, "chapter_id": 23188, "verse_number": "४-१२४-१३", "content_sanskrit": "वंशहानिर्भवेत्तस्य दुःखशोकमिहैव च ।\nपच्यते निरये घोरे यावच्चन्द्रदिवाकरौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003188013, "chapter_id": 23188, "verse_number": "४-१२४-१४", "content_sanskrit": "गुरुश्चज्ञानोद्गिरणाज्ज्ञानं स्यान्मन्त्रतन्त्रयोः ।\nस च मन्त्रश्च तत्तन्त्रं भक्तिः स्याद्ध्रुवयोर्यतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003188014, "chapter_id": 23188, "verse_number": "४-१२४-१५", "content_sanskrit": "निषेव्य मन्त्रं देवानां जीवा जन्मनि जन्मनि ।\nभक्ता भवन्ति दुर्गायाः पादपद्मे सुदुर्लभे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003188015, "chapter_id": 23188, "verse_number": "४-१२४-१६", "content_sanskrit": "निषेव्य मन्त्रे शंभोश्च जगतां कारणस्य च ।\nतदा प्राप्नोति युवयोः पादपद्मं सुदुर्लभम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003188016, "chapter_id": 23188, "verse_number": "४-१२४-१७", "content_sanskrit": "युक्योः पादपद्मं च दुर्लभं प्राप्य पुण्यवान् ।\nक्षणार्धं षोडशांशं च नहि मुञ्चति दैवतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003188017, "chapter_id": 23188, "verse_number": "४-१२४-१८", "content_sanskrit": "भक्त्या च युवचोर्मन्त्रं गृहीत्वा वैष्मपादपि ।\nस्तवं वा कवचं वाऽपि कर्ममूलनिकृन्तनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003188018, "chapter_id": 23188, "verse_number": "४-१२४-१९", "content_sanskrit": "योजयेत्परया भक्त्या पुण्यक्षेत्रे च भारते ।\nपुरुषाणां सहस्रं च त्वात्मना सार्धमुद्धरेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003188019, "chapter_id": 23188, "verse_number": "४-१२४-२०", "content_sanskrit": "गुरुमभ्यर्च्य विधिवद्वस्त्रालंकारचन्दनैः ।\nकवचं धारयेद्यो हि विष्णुतुल्यो भवेद्ध्रुवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003188020, "chapter_id": 23188, "verse_number": "४-१२४-२१", "content_sanskrit": "यद्दत्तं वस्तु मे मातस्तत्सर्वं सार्थकं कुरु ।\nदेहि विप्राय मत्प्रीत्या तदा भोक्ष्यामि सांप्रतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003188021, "chapter_id": 23188, "verse_number": "४-१२४-२२", "content_sanskrit": "देवे देयानि दानानि देवे देया च दक्षिणा ।\nतत्सर्वं ब्राह्मणे दद्यात्तदानन्त्याय कल्पते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003188022, "chapter_id": 23188, "verse_number": "४-१२४-२३", "content_sanskrit": "ब्राह्मणानां मुखं राधे देवानां मुखमुख्यकम् ।\nविप्रभुक्तं च यद्द्रव्यं प्राप्नुवन्त्येव देवताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003188023, "chapter_id": 23188, "verse_number": "४-१२४-२४", "content_sanskrit": "विप्रांश्च भोजयामास तत्सर्व राधिका सती ।\nबभूव तत्क्षणादेव प्रीतो लम्बोदरो मुने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003188024, "chapter_id": 23188, "verse_number": "४-१२४-२५", "content_sanskrit": "एतस्मिन्नन्तरे देवा ब्रह्मेशशेषसंज्ञकाः ।\nआययुर्वटमूलं च देवपूजार्थमेव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003188025, "chapter_id": 23188, "verse_number": "४-१२४-२६", "content_sanskrit": "तत्र गत्वा शिवचरो देवान्देवीरुवाच सः ।\nश्रीकृष्णं शुष्ककण्ठश्च भयभीतश्च रक्षकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003188026, "chapter_id": 23188, "verse_number": "४-१२४-२७", "content_sanskrit": "रक्षक उवाच ।\nगणेशं पूजयामास सर्वादौ च शुभक्षणे ।\nवृषभानसुता राधा प्रकृत्य स्वस्तिवाचनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003188027, "chapter_id": 23188, "verse_number": "४-१२४-२८", "content_sanskrit": "सहिता सा बलवती गोपीत्रिशतकोटिभिः ।\nवारितोऽहं वलिष्ठाभिर्युष्मांश्च कथयामि तत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003188028, "chapter_id": 23188, "verse_number": "४-१२४-२९", "content_sanskrit": "मर्वादौ पूजयेद्यो हि सोऽनन्तं फलमालभेत् ।\nमध्ये मध्यविधं पुण्यं शेषे स्वल्पमिति स्मृतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003188029, "chapter_id": 23188, "verse_number": "४-१२४-३०", "content_sanskrit": "देवेन्द्रेषु मुनीन्द्रेषु देवस्त्रीषु स्थितासु च ।\nगोपीभिश्च सह तया राधया पूजितः परः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003188030, "chapter_id": 23188, "verse_number": "४-१२४-३१", "content_sanskrit": "दूतवाक्यं समाकर्ण्य जहसुः सर्वदेवताः ।\nमुनयो मनवश्चैव राजानो देवयोषितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003188031, "chapter_id": 23188, "verse_number": "४-१२४-३२", "content_sanskrit": "रुक्मिण्याद्या रमण्यश्च या देव्यो विस्मयं ययुः ।\nसरस्वती च सावित्री पार्वती परमेश्वरी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003188032, "chapter_id": 23188, "verse_number": "४-१२४-३३", "content_sanskrit": "रोहिणी च सती संज्ञा स्वाहाद्या देवयोषितः ।\nमुदिताः प्रययुः सर्वा मुनिपत्न्यः पतिव्रताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003188033, "chapter_id": 23188, "verse_number": "४-१२४-३४", "content_sanskrit": "मुनयो मनवः सर्वे देवाश्चापि नरास्तथा ।\nश्रीकृष्णः स गणैः सार्धं ये चान्ये प्रययुर्मुदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003188034, "chapter_id": 23188, "verse_number": "४-१२४-३५", "content_sanskrit": "ते सर्वे विविधैर्द्रव्यैः पूजां चक्रुः शुभक्षणे ।\nबलिष्ठा दुर्बलाश्चैव क्रमेण च पृथक्पृथक् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003188035, "chapter_id": 23188, "verse_number": "४-१२४-३६", "content_sanskrit": "लड्डुकानां च राशीनां शतकोटिर्बभूव ह ।\nशर्कराणां तदर्धं च स्वस्तिकानां तथैव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003188036, "chapter_id": 23188, "verse_number": "४-१२४-३७", "content_sanskrit": "अन्नानां भव्यवस्तूनां शतकोटिर्बभूव ह ।\nअसंख्यानि फलान्येव स्वादूनि मधुराणि च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003188037, "chapter_id": 23188, "verse_number": "४-१२४-३८", "content_sanskrit": "मधुकुल्या दुग्धकुल्या दधिकुल्या घृतस्य च ।\nबभूवुः शतसंख्याश्च त्रैलोक्यानां च पूजने ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003188038, "chapter_id": 23188, "verse_number": "४-१२४-३९", "content_sanskrit": "पूजां कृत्वा तु ते सर्वे समूषुश्च सुखासने ।\nपार्वती परमप्रीत्या राधास्थानं समाययौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003188039, "chapter_id": 23188, "verse_number": "४-१२४-४०", "content_sanskrit": "सा राधा पार्वतीं दृष्ट्वा समुत्थाय जवेन च ।\nयथायोग्यां च संभाषां चकार सादरं मुदा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003188040, "chapter_id": 23188, "verse_number": "४-१२४-४१", "content_sanskrit": "आश्लेषणं चुम्बनं च बभूव च परस्परम् ।\nउवाच मधुरं दुर्गा राधां कृत्वा स्ववक्षसि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003188041, "chapter_id": 23188, "verse_number": "४-१२४-४२", "content_sanskrit": "पार्वत्युवाच ।\nकिंवा प्रश्नं करिष्यामि त्वां राधा मङ्गलालयाम् ।\nगता ते विरहज्वाला श्रीदाम्नः शापमोक्षणे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003188042, "chapter_id": 23188, "verse_number": "४-१२४-४३", "content_sanskrit": "सततं मन्मनः प्राणास्त्वय्येव मयि ते तथा ।\nन ह्येवमावयोर्भेदः शक्तिपूरुषयोस्तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003188043, "chapter_id": 23188, "verse_number": "४-१२४-४४", "content_sanskrit": "येत्वां निन्दन्ति मद्भक्तास्त्वद्भक्ताश्चापि मामपि ।\nकुम्भीपाके च पज्यन्ते यावच्चन्द्र दिवाकरौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003188044, "chapter_id": 23188, "verse_number": "४-१२४-४५", "content_sanskrit": "राधामाधवयोर्भेदं ये कुर्वन्ति नराधमाः ।\nवंशहानिर्भवेत्तेषां पच्यन्ते नरके चिरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003188045, "chapter_id": 23188, "verse_number": "४-१२४-४६", "content_sanskrit": "यान्ति सूकरयोनिं च पितृभिः शतकैः सह ।\nषष्टिवर्षसहस्राणि विष्ठायां कृमयस्तथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003188046, "chapter_id": 23188, "verse_number": "४-१२४-४७", "content_sanskrit": "त्वयैव पूजितः पुत्रो न मया च गणेश्वरः ।\nसर्वादौ सर्वपूज्योऽयं यथा तव तथा मम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003188047, "chapter_id": 23188, "verse_number": "४-१२४-४८", "content_sanskrit": "यावज्जीवनपर्यन्तं न विच्छेदो भविष्यति ।\nराधामाधवयोर्देवि दुग्धधावल्ययोर्यथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003188048, "chapter_id": 23188, "verse_number": "४-१२४-४९", "content_sanskrit": "सिद्धाश्रमे महातीर्थे पुण्यक्षेत्रे च भारते ।\nनिर्वघ्नं लभगोविन्दं संपूज्य विघ्नखण्डनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003188049, "chapter_id": 23188, "verse_number": "४-१२४-५०", "content_sanskrit": "रासेश्वरी त्वं रसिका श्रीकृष्णो रसिकेश्वरः ।\nविदग्धाया विदग्धेन संगमो गुणवान्भदेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003188050, "chapter_id": 23188, "verse_number": "४-१२४-५१", "content_sanskrit": "श्रीदाम्नः शापनिर्मुक्ता शतवर्षान्तरे सति ।\nकुरुष्व मद्रेणाद्य कृष्णेन सह संगमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003188051, "chapter_id": 23188, "verse_number": "४-१२४-५२", "content_sanskrit": "ममाऽऽज्ञया दुर्लभया सुवेषं कुरु सुन्दरि ।\nसुदुर्लभः कामिनीनां सत्पुंसा सह संगमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003188052, "chapter_id": 23188, "verse_number": "४-१२४-५३", "content_sanskrit": "चक्रुः सुवेषं राधायाः प्रियाल्यश्च शिवाज्ञया ।\nरत्नसिंहासने रम्ये वासयामासुरीश्वरीम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003188053, "chapter_id": 23188, "verse_number": "४-१२४-५४", "content_sanskrit": "पुरतो रत्नमाला सा रत्नमालां गले ददौ ।\nराधाया दक्षिणे हस्ते क्रीडापद्मं मनोहरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003188054, "chapter_id": 23188, "verse_number": "४-१२४-५५", "content_sanskrit": "ददौ पद्ममुखी पादपद्मयुग्मेऽप्यलक्तकम् ।\nप्रददौ सुन्दरी गोपी सिन्दूरं सुन्दरं वरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003188055, "chapter_id": 23188, "verse_number": "४-१२४-५६", "content_sanskrit": "चन्दनेन समयुतं सीमन्ताधः स्थलोज्ज्वलम् ।\nसुचारुकबरीं रम्यां चकार मालती सती ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003188056, "chapter_id": 23188, "verse_number": "४-१२४-५७", "content_sanskrit": "मनोहरां मुनीनां च मालतीमाल्यभूषिताम् ।\nकस्तूरीकुङ्कुमाक्तं च चारुचन्दनपत्रकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003188057, "chapter_id": 23188, "verse_number": "४-१२४-५८", "content_sanskrit": "स्तनयुग्मे सुकठिने चकार चन्दना सती ।\nचारुचम्पकपुप्पाणां मालां गन्धमनोहराम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003188058, "chapter_id": 23188, "verse_number": "४-१२४-५९", "content_sanskrit": "मालावती ददौ तस्यौ प्रफुल्लां नवमल्लिकाम् ।\nरतीषु रसिका गोपी रत्नभूषणभूषिताम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003188059, "chapter_id": 23188, "verse_number": "४-१२४-६०", "content_sanskrit": "तां चकारातिरसिकां वरां रतिरसोत्सुकाम् ।\nशरत्पद्मदलाभं च लोजनं कज्जलोज्ज्वलम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003188060, "chapter_id": 23188, "verse_number": "४-१२४-६१", "content_sanskrit": "कृत्वा ददौ सुललितं वस्त्रं च ललिता सती ।\nमहेन्द्रेण प्रदत्तं च पारिजातप्रसूनकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003188061, "chapter_id": 23188, "verse_number": "४-१२४-६२", "content_sanskrit": "सुगन्धियुक्तं तस्याश्च पारिजातं करे ददौ ।\nसुशीलं मधुरोक्तं च भर्तुः पार्श्वे यथोचितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003188062, "chapter_id": 23188, "verse_number": "४-१२४-६३", "content_sanskrit": "शिक्षां चकार नीतिं च सुशीला गोपिका सती ।\nस्त्रीणां च षोडशकलां विपत्तौ विस्मृतांतयोः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003188063, "chapter_id": 23188, "verse_number": "४-१२४-६४", "content_sanskrit": "स्मरणं कारयामास राधामाता कलावती ।\nश्रृङ्गारविषयोक्तं च वचनं च सुधोपमम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003188064, "chapter_id": 23188, "verse_number": "४-१२४-६५", "content_sanskrit": "स्मरणं कारयामास भगिनी च सुधामुखी ।\nकमलानां चम्पकानां दले चन्दनचर्चिते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003188065, "chapter_id": 23188, "verse_number": "४-१२४-६६", "content_sanskrit": "चकार रतितल्पं च कमला चाऽऽशु कोमलम् ।\nचारुचम्पकपुष्पं च कृष्णार्थं पुटकस्थितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003188066, "chapter_id": 23188, "verse_number": "४-१२४-६७", "content_sanskrit": "चकार चन्दनाक्तं च स्वयं च पार्वती सती ।\nपुष्पं केलिकदम्बानां स्तबकं च मनोहरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003188067, "chapter_id": 23188, "verse_number": "४-१२४-६८", "content_sanskrit": "कदम्बमालां कृष्णार्थ विद्यमानां चकार सा ।\nताम्बूलं च वरं सम्यं कर्पूरादिसुवासितम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003188068, "chapter_id": 23188, "verse_number": "४-१२४-६९", "content_sanskrit": "कृष्णप्रिया च कृष्णार्थं चकार वासितं जलम् ।\nएतस्मिन्नन्तरे सर्वमाश्रमं सजलस्थलम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003188069, "chapter_id": 23188, "verse_number": "४-१२४-७०", "content_sanskrit": "साक्षाद्गोरोचनाभं च ददृशुर्मुनयः सुराः ।\nते सर्वे विस्मयं गत्वा पप्रच्छुः कृष्णमीश्वरम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003188070, "chapter_id": 23188, "verse_number": "४-१२४-७१", "content_sanskrit": "उवाच भगवांस्ताश्च सर्वज्ञः सर्वकाराणा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003188071, "chapter_id": 23188, "verse_number": "४-१२४-७२", "content_sanskrit": "श्रीभगवानुवाच ।\nअभिशप्ता च श्रीदाम्ना भ्रष्टशोभा राधिका ।\nसर्वं ज्ञानं विसस्मार मद्विच्छेदज्वरातुरा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003188072, "chapter_id": 23188, "verse_number": "४-१२४-७३", "content_sanskrit": "विमुक्ते वर्षशतके ज्ञानं सस्मार सा सती ।\nसिद्धाश्रमं च पीताभं रासेश्वर्याश्च तेजसा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003188073, "chapter_id": 23188, "verse_number": "४-१२४-७४", "content_sanskrit": "परमाह्लादकं तेजश्चन्द्रकोटिसमप्रभम् ।\nसुखदृश्यं च सुखदं चक्षुधां प्राणिनामपि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003188074, "chapter_id": 23188, "verse_number": "४-१२४-७५", "content_sanskrit": "तच्छ्रुत्वा परमाश्चर्यं मुनयो मनवस्तथा ।\nदेव्यश्च सर्वदेवास्ते ब्रह्मेशानादयस्तथा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003188075, "chapter_id": 23188, "verse_number": "४-१२४-७६", "content_sanskrit": "जवेन गत्वा तत्स्थानं भक्तिनम्रात्मकंधरा ।\nसर्वे जनास्ते ददृशुस्त्रैलोक्यस्थाश्च राधिकाम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003188076, "chapter_id": 23188, "verse_number": "४-१२४-७७", "content_sanskrit": "श्वेतचम्पकवर्णाभामतुलां सुमनोहराम् ।\nमोहिनीं मानसानां च मुनीनामूर्ध्वरेतसाम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003188077, "chapter_id": 23188, "verse_number": "४-१२४-७८", "content_sanskrit": "सुकेशीं सुन्दरीं श्यामां न्यग्रोधपरिमण्डलाम् ।\nनितम्बकठिनश्रोणीं स्तनयुग्मोन्नताननाम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003188078, "chapter_id": 23188, "verse_number": "४-१२४-७९", "content_sanskrit": "कोटीन्दुनिन्दितास्यां तां सस्मितां सुदतीं सतीम् ।\nकज्जलोज्ज्वलरूपां च शरत्कमललोजनाम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003188079, "chapter_id": 23188, "verse_number": "४-१२४-८०", "content_sanskrit": "महालक्ष्मीं बीजरूपां परामाद्यां सनातीम् ।\nपरमात्मस्वरूपस्य प्राणाधिष्ठातृदेवताम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003188080, "chapter_id": 23188, "verse_number": "४-१२४-८१", "content_sanskrit": "स्तुतां च पूजितां चैव परां च परमात्मने ।\nब्रह्मस्वरूपां निर्लिप्तां नित्यरूपां च निर्गुणाम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003188081, "chapter_id": 23188, "verse_number": "४-१२४-८२", "content_sanskrit": "विश्वानुरोधात्प्रकृतिं भक्तानुग्रहविग्रहाम् ।\nमत्यस्वरूपां शुद्धां च पूतां पतितपावनीम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003188082, "chapter_id": 23188, "verse_number": "४-१२४-८३", "content_sanskrit": "सुतीर्थपूतां सत्कीर्तिं विधात्रीं वेदसामपि ।\nमहत्प्रियां च महतीं महाविष्णोश्च मातरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003188083, "chapter_id": 23188, "verse_number": "४-१२४-८४", "content_sanskrit": "रासेश्वरेश्वरीं रम्यां रसिकां रसिकेश्वरीम् ।\nवह्निशुद्धांशुकाधामां स्वेच्छारूपां शुभालयाम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003188084, "chapter_id": 23188, "verse_number": "४-१२४-८५", "content_sanskrit": "गोपीभिः सप्तभिः शश्वत्सेवितां श्वेतचामरैः ।\nचतसृभिः प्रियालीभिः पादपद्मोपसेविताम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003188085, "chapter_id": 23188, "verse_number": "४-१२४-८६", "content_sanskrit": "अमूल्यरत्ननिर्माणभूषणोच्चैर्विभूषिताम् ।\nचारुकुण्डलयुग्मेन श्रुतिगण्डस्थलोज्ज्वलाम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003188086, "chapter_id": 23188, "verse_number": "४-१२४-८७", "content_sanskrit": "सुनासां गजमुक्तार्हां खगेन्द्रचञ्चुनिन्दिताम् ।\nकुङ्कुमालक्तकस्तूरीस्निग्धचन्दनचर्चिताम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003188087, "chapter_id": 23188, "verse_number": "४-१२४-८८", "content_sanskrit": "दधानां सुकपोलं च कोमलाङ्गीं सुकामुकीम् ।\nगचेन्द्रगामिनीं रामां कामनीयां सुकामिनीम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003188088, "chapter_id": 23188, "verse_number": "४-१२४-८९", "content_sanskrit": "कामास्त्रजयरूपां च कामकाम्यालयां वराम् ।\nक्रीडाकमलमम्लानं पारिजातप्रसूनकम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003188089, "chapter_id": 23188, "verse_number": "४-१२४-९०", "content_sanskrit": "अमूल्यरत्ननिर्माणं दधानां दर्पणोज्ज्वलम् ।\nनानारत्नविचित्राढ्यरतनसिंहासनस्थिताम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003188090, "chapter_id": 23188, "verse_number": "४-१२४-९१", "content_sanskrit": "पद्मैः पद्मार्चितं पादपद्मं च मङ्गलालयम् ।\nहृत्पद्मे ध्यायमानं च कृणस्य परमात्मनः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003188091, "chapter_id": 23188, "verse_number": "४-१२४-९२", "content_sanskrit": "कर्मणा मनसा वाचा स्वप्ने जागरणेऽपि च ।\nतत्प्रीतिं प्रेम सौभाग्यं स्मरन्तीं नित्यनूतनम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003188092, "chapter_id": 23188, "verse_number": "४-१२४-९३", "content_sanskrit": "भावानुरक्तसंसक्तां शुद्धभक्तां पतिव्रताम् ।\nधन्यां मान्यां गौरवर्णां शश्वद्वक्षः स्थलस्थिताम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003188093, "chapter_id": 23188, "verse_number": "४-१२४-९४", "content_sanskrit": "प्रियासु प्रियभक्तेषु सुप्रियां प्रियवादिनीम् ।\nकृष्णवामाङ्गसंभूतामभेदां गुणरूपयोः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003188094, "chapter_id": 23188, "verse_number": "४-१२४-९५", "content_sanskrit": "गोलोकवासिनीं देवदेवीं सर्वोपरिस्थितम् ।\nवृषभानसुताख्यां तां पुण्यक्षेत्रे च भारते ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003188095, "chapter_id": 23188, "verse_number": "४-१२४-९६", "content_sanskrit": "गोपीश्वरीं गुप्तरूपां सिद्धिदां सिद्धिरूपिणीम् ।\nध्यानासाध्यां दुराराध्यां वन्दे सद्भक्तवन्दिताम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003188096, "chapter_id": 23188, "verse_number": "४-१२४-९७", "content_sanskrit": "ध्याने ध्यानेन राधाया व्यायन्ते ध्यानतत्पराः ।\nइहैव जीवन्मुक्तास्ते परत्र कृष्णपार्षदाः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003188097, "chapter_id": 23188, "verse_number": "४-१२४-९८", "content_sanskrit": "दृष्ट्वा ब्रह्मा च सर्वादौ तुष्टाव परमेश्वरीम् ।\nस्वयं विधाता जगतां मातरं वेधसामपि ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003188098, "chapter_id": 23188, "verse_number": "४-१२४-९९", "content_sanskrit": "ब्राह्मोवाच ।\nषष्टिवर्षसहस्रणि दिव्यानि परमेश्वरि ।\nपुष्करे च तपस्तप्तं पुण्यक्षेत्रे च भारते ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003188099, "chapter_id": 23188, "verse_number": "४-१२४-१००", "content_sanskrit": "त्वत्पादपद्मधुरमधुलुब्धेन चेतसा ।\nमधुव्रतेन लोलेन प्रेरितेन मया सति ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003188100, "chapter_id": 23188, "verse_number": "४-१२४-१०१", "content_sanskrit": "तथाऽपि न मया लब्धं त्वत्पादपद्ममीप्सितम् ।\nन दृष्टमपि स्वप्नेऽयि जाता वागशरीरिणी ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003188101, "chapter_id": 23188, "verse_number": "४-१२४-१०२", "content_sanskrit": "वाराहे भारते वर्षे पुण्ये वृन्दावने वने ।\nसिद्धाश्रमे गणेशस्य पादपद्मं च द्रक्ष्यसि ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003188102, "chapter_id": 23188, "verse_number": "४-१२४-१०३", "content_sanskrit": "राधामाधवयोर्दास्यं कुतो विषयिणस्तव ।\nनिवर्तस्व महाभाग परमेतत्मुदुर्लभम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003188103, "chapter_id": 23188, "verse_number": "४-१२४-१०४", "content_sanskrit": "इति श्रुत्वा निवृत्तोऽहं तपसे भग्नमानसः ।\nपरिपुर्ण तदधुना वाञ्छितं तपसः फलम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003188104, "chapter_id": 23188, "verse_number": "४-१२४-१०५", "content_sanskrit": "महादेव उवाच ।\nपद्मैः पद्मार्चितं पादपदमं यस्य सुदुर्लभम् ।\nध्यायन्ते ध्याननिष्ठाश्च शाश्वद्रब्रह्मादयः सुराः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003188105, "chapter_id": 23188, "verse_number": "४-१२४-१०६", "content_sanskrit": "मुनयो मनवश्चैव सिद्धाः सन्तश्च योगिनः ।\nद्रष्टुं नैव क्षमाः स्वप्ने भवती तस्य वक्षसि ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003188106, "chapter_id": 23188, "verse_number": "४-१२४-१०७", "content_sanskrit": "अनन्त उवाच ।\nवेदाश्च वेदमाता च पुराणानि च सुव्रते ।\nअहं सरस्वती सन्त स्तोतुं नालं च संततम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003188107, "chapter_id": 23188, "verse_number": "४-१२४-१०८", "content_sanskrit": "अस्माकं स्तवने यस्य भ्रूभङ्गं च सुदुर्लभम् ।\nतवैव भत्सेने भीताश्चावयोरन्तरं हरेः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003188108, "chapter_id": 23188, "verse_number": "४-१२४-१०९", "content_sanskrit": "एवं देवाश्च देव्यश्चाप्यन्ये ये च समागताः ।\nप्रणतास्तुष्टुवुः सर्वे मुनिमन्वादयस्तथा ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003188109, "chapter_id": 23188, "verse_number": "४-१२४-११०", "content_sanskrit": "लज्जया नम्रवक्त्राश्च रुक्मिण्यद्याश्च योषितः ।\nमलीमसं च चक्रुस्ताः श्वासेन रत्नदर्पणम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003188110, "chapter_id": 23188, "verse_number": "४-१२४-१११", "content_sanskrit": "मृततुल्या सत्यभामा निराहारा कृशोदरी ।\nमनसोऽप्यभिमानं च सर्व तत्याच नारद ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]