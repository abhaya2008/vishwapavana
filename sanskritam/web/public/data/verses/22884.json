[{"id": 7002884000, "chapter_id": 22884, "verse_number": "९-१६९-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअन्नदानस्य माहात्म्यं कथयामि तवानघ ।\nयत्प्रोक्तमृषिभिः पूर्वं तदिहैकमनाः शृणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002884001, "chapter_id": 22884, "verse_number": "९-१६९-२", "content_sanskrit": "ददस्वान्नं ददस्वान्नं ददस्वान्नं युधिष्ठिर ।\nसद्यस्तुष्टिकरं लोके किं दत्तेन परेण ते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002884002, "chapter_id": 22884, "verse_number": "९-१६९-३", "content_sanskrit": "रामेण दशरथिना वनस्थेन निजानुजः ।\nनिर्वेदाद्यत्पुरा प्रोक्तस्तदहं प्रब्रवीमि ते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002884003, "chapter_id": 22884, "verse_number": "९-१६९-४", "content_sanskrit": "पृथिव्यामन्नपूर्णायां वयमन्नस्य कांक्षिणः ।\nसौमित्रे नूनमस्माभिर्न ब्राह्मणमुखे हुतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002884004, "chapter_id": 22884, "verse_number": "९-१६९-५", "content_sanskrit": "यदुच्यते कर्मबीजं तस्यावश्यं फलं नरैः ।\nप्राप्यते लक्ष्मणास्माभिर्नान्नं विप्रमुखे हुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002884005, "chapter_id": 22884, "verse_number": "९-१६९-६", "content_sanskrit": "यत्र प्राप्यं तदप्राप्यं विद्यया पौरुषेण वा ।\nसत्यो लोकप्रवादोऽयं नादत्तमुपतिष्ठति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002884006, "chapter_id": 22884, "verse_number": "९-१६९-७", "content_sanskrit": "भक्षोपयोगादन्नस्य दानं श्रेयस्करं परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002884007, "chapter_id": 22884, "verse_number": "९-१६९-८", "content_sanskrit": "प्रकारांतरभोज्यानि दानान्यन्यानि भारत ।\nअन्नमेव परं दानं सत्यवाक्यं परं पदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002884008, "chapter_id": 22884, "verse_number": "९-१६९-९", "content_sanskrit": "बुद्धिश्चार्थात्परो लोभः सन्तोषः परमं सुखम् ।\nस्नातानामनुलिप्तानां भूषितानां च भूषणैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002884009, "chapter_id": 22884, "verse_number": "९-१६९-१०", "content_sanskrit": "न सुखं न च सन्तोषो भवेदन्नादृते नृणाम् ।\nश्वेतो नाम महीपालः सार्वभौमोऽभवत्पुरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002884010, "chapter_id": 22884, "verse_number": "९-१६९-११", "content_sanskrit": "तेनेष्टं बहुभिर्यज्ञैः संग्रामा बहवो जिताः ।\nदानानि च प्रदत्तानि धर्मतः पालिता मही ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002884011, "chapter_id": 22884, "verse_number": "९-१६९-१२", "content_sanskrit": "भुक्ता भोगाः सुविपुला शत्रूणां मूर्धनि स्थितम् ।\nवानप्रस्थेन विधिना त्यक्त्वा राजश्रियं नृप ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002884012, "chapter_id": 22884, "verse_number": "९-१६९-१३", "content_sanskrit": "स्वर्गं जगाम भुक्त्वा तु पूज्यमानो मरुद्गणैः ।\nविमानमर्कप्रतिमं प्रतिपेदे मुदा युतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002884013, "chapter_id": 22884, "verse_number": "९-१६९-१४", "content_sanskrit": "तत्रास्ते रममाणोऽसौ साकं विद्याधरैः सुखम् ।\nप्रसिद्धैः स्तूयते सिद्धैः सेव्यतेऽप्सरसां गणैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002884014, "chapter_id": 22884, "verse_number": "९-१६९-१५", "content_sanskrit": "गंधर्वैर्गीयते हृष्टैः शक्रेणाप्यनुगम्यते ।\nदिव्यमाल्यांबरधरो दिव्याभरणभूषितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002884015, "chapter_id": 22884, "verse_number": "९-१६९-१६", "content_sanskrit": "स च नित्यं वितानाग्र्यादवतीर्य महीतलम् ।\nस्वमांसान्यत्ति कौंतेय पूर्वं त्यक्त्वा कलेवरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002884016, "chapter_id": 22884, "verse_number": "९-१६९-१७", "content_sanskrit": "तच्छरीरं तथैवास्ते रक्षितं पूर्वकर्मभिः ।\nस कदाचित्सुरेशानं ब्रह्माणं समुपस्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002884017, "chapter_id": 22884, "verse_number": "९-१६९-१८", "content_sanskrit": "प्रणम्य प्रांजलिर्भूत्वा निर्वेदादिदमब्रवीत् ।\nभगवंस्त्वत्प्रसादेन प्राप्तं स्वर्गसुखं मया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002884018, "chapter_id": 22884, "verse_number": "९-१६९-१९", "content_sanskrit": "सर्वेषामपि संपूज्यः सुराणां सुरपुंगव ।\nकिं तु क्षुद्बाधतेऽत्यर्थं स्वर्गस्थस्यापि मे प्रभो ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002884019, "chapter_id": 22884, "verse_number": "९-१६९-२०", "content_sanskrit": "यया मांसान्यहं स्वस्य भक्ष्ययाम्यशनं विना ।\nब्रह्मोवाच ।\nश्वेताभिजनसंपन्न श्वेत शृणु वचो मम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002884020, "chapter_id": 22884, "verse_number": "९-१६९-२१", "content_sanskrit": "त्वयाधीतं हुतं दत्तं गुरवः परितोषिताः ।\nनाशनं भवता दत्तं यद्द्विजेभ्यो नराधिप ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002884021, "chapter_id": 22884, "verse_number": "९-१६९-२२", "content_sanskrit": "अनन्नदानस्य फलं त्वयेदमुपभुज्यते ।\nतर्ह्यन्नदानतो नान्यच्छरीरारोग्यकारकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002884022, "chapter_id": 22884, "verse_number": "९-१६९-२३", "content_sanskrit": "नान्यदन्नादृते पुंसां किञ्चित्सञ्जीवनौषधम् ।\nमहीं गत्वा महाराज कुरुष्व वचनं मम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002884023, "chapter_id": 22884, "verse_number": "९-१६९-२४", "content_sanskrit": "तपः स्वाध्यायसंपन्ने शास्त्रज्ञे संजितेन्द्रिये ।\nयेन संपद्यते तृप्तिरक्षया क्ष्मांपते तव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002884024, "chapter_id": 22884, "verse_number": "९-१६९-२५", "content_sanskrit": "विरिंचेर्वचनाद्गत्वा त्वरायुक्तो महीतलम् ।\nअगस्त्यं भोजयामास भक्त्या भरतसत्तम ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002884025, "chapter_id": 22884, "verse_number": "९-१६९-२६", "content_sanskrit": "भोजयित्वा ततः प्रादाद्दक्षिणां क्षीणकल्मषः ।\nएकावलिं स्वकात्कण्ठात्समुत्तार्य समुज्ज्वलाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002884026, "chapter_id": 22884, "verse_number": "९-१६९-२७", "content_sanskrit": "ततो दुन्दुभिघोषेण पूजितः सुरसत्तमैः ।\nश्वेतस्तृप्तो गतः स्वर्गं दत्त्वान्नं दक्षिणायुतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002884027, "chapter_id": 22884, "verse_number": "९-१६९-२८", "content_sanskrit": "पौलस्त्ये निहते पश्चाद्देवदानवसंकटे ।\nरामायैकावलिं प्रादादगस्त्यः परया मुदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002884028, "chapter_id": 22884, "verse_number": "९-१६९-२९", "content_sanskrit": "एतदन्नस्य माहात्म्यं कथयाम्यपरं च ते ।\nन चान्नादपरं किञ्चित्सत्यं तव मयोदितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002884029, "chapter_id": 22884, "verse_number": "९-१६९-३०", "content_sanskrit": "अन्नं वै प्राणिनां प्राणा अन्नमोजो बलं सुखम् ।\nएतस्मात्कारणात्सद्भिरन्नदः प्राणदः स्मृतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002884030, "chapter_id": 22884, "verse_number": "९-१६९-३१", "content_sanskrit": "सुदूरादाशया यस्य गृहं प्राप्ता बुभुक्षिताः ।\nतृप्ताः प्रतिनिवर्तंते कोऽन्यस्तत्सदृशः पुमान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002884031, "chapter_id": 22884, "verse_number": "९-१६९-३२", "content_sanskrit": "दीक्षितः कपिला सत्री राजा भिक्षुर्महोदधिः ।\nदृष्टमात्रा पुनंत्येते तस्मात्पश्यंति नित्यशः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002884032, "chapter_id": 22884, "verse_number": "९-१६९-३३", "content_sanskrit": "एकस्याप्यतिथेरन्नं यः प्रदातुमशक्तिमान् ।\nतस्याऽरम्भैः परिक्लेशैर्वसतः किं फलं गृहे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002884033, "chapter_id": 22884, "verse_number": "९-१६९-३४", "content_sanskrit": "शक्यते दुष्करेऽप्यर्थे चिररात्राय जीवितुम् ।\nन त्वाहारविहीनेन शक्यं वर्तयितुं चिरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002884034, "chapter_id": 22884, "verse_number": "९-१६९-३५", "content_sanskrit": "भुक्त्वा गृहे गृहस्थस्य मैथुनं यश्च सेवते ।\nयस्यान्नं तस्य ते पुत्रा इति प्राहुर्मनीषिणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002884035, "chapter_id": 22884, "verse_number": "९-१६९-३६", "content_sanskrit": "दुष्कृतं हि मनुष्याणामन्नमाश्रित्य तिष्ठति ।\nयो यस्यान्नं समश्नाति स तस्याश्नाति दुष्कृतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002884036, "chapter_id": 22884, "verse_number": "९-१६९-३७", "content_sanskrit": "वनस्पतिगते सोमे परान्नं यस्तु भुंजति ।\nतस्य मासकृतं पुण्यं दातारमुपगच्छति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002884037, "chapter_id": 22884, "verse_number": "९-१६९-३८", "content_sanskrit": "कस्मान्न दीयते नित्यं कस्मादन्नं न दीयते ।\nयस्येदृशी फलावाप्तिः कथिता पूर्वसूरिभिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002884038, "chapter_id": 22884, "verse_number": "९-१६९-३९", "content_sanskrit": "भिक्षां वा पुष्कलां वापि हंतकारं द्विजातये ।\nभोजनं वा यथालाभमदत्त्वाश्नाति किल्बिषम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002884039, "chapter_id": 22884, "verse_number": "९-१६९-४०", "content_sanskrit": "येनायुतं सहस्रं वा भोजितं स्याद्द्विजन्मनाम् ।\nतेन ब्रह्मगृहासन्नं नूनं बद्धं कुटीरकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002884040, "chapter_id": 22884, "verse_number": "९-१६९-४१", "content_sanskrit": "वाराणस्यां पुरा पार्थ वणिगापणजीवनः ।\nधनेश्वर इति ख्यातो देवब्राह्मणपूजकः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002884041, "chapter_id": 22884, "verse_number": "९-१६९-४२", "content_sanskrit": "तस्यापणैकदेशे तु मुक्त्वांडं पांडुरच्छवि ।\nससर्प सर्पस्तद्देशाद्वणिग्दृष्ट्वा विशंकितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002884042, "chapter_id": 22884, "verse_number": "९-१६९-४३", "content_sanskrit": "तदंडं वणिजा तेन दृष्टं कारुण्यबुद्धिना ।\nततः प्रभृत्यनुदिनं ररक्ष च पुषोष च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002884043, "chapter_id": 22884, "verse_number": "९-१६९-४४", "content_sanskrit": "निर्जगाम दिनैः कैश्चिद्भित्वांडं सर्पपोतकः ।\nतं वणिक्क्षीरपानाद्यैरुपचारैरवर्धयत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002884044, "chapter_id": 22884, "verse_number": "९-१६९-४५", "content_sanskrit": "लिलिहे घृतभांडानि जिघ्रे च गंधसंचयान् ।\nलुलोठ पांसुप्रकरे चचार वारिमध्यगः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002884045, "chapter_id": 22884, "verse_number": "९-१६९-४६", "content_sanskrit": "वणिजा रक्ष्यमाणः स स्नेहाच्चाहरहः पुनः ।\nजगाम सुमहान्कालोऽभवदेष भयंकरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002884046, "chapter_id": 22884, "verse_number": "९-१६९-४७", "content_sanskrit": "अथैकस्मिन्दिने गंगां गतः स्नातुं त्रिलोकगाम् ।\nवणिगापणे पण्यविदं स्थापयित्वा सुतं मतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002884047, "chapter_id": 22884, "verse_number": "९-१६९-४८", "content_sanskrit": "व्यवहर्तुं समारब्धं वणिक्पुत्रेण धीमता ।\nददाति प्रतिगृह्णाति घृततैलयवैक्षवम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002884048, "chapter_id": 22884, "verse_number": "९-१६९-४९", "content_sanskrit": "व्यवहाराकुलतया पादयोरंतरेण सः ।\nसर्पश्चचाल चापल्याद्वणिग्विक्षेपमभ्यगात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002884049, "chapter_id": 22884, "verse_number": "९-१६९-५०", "content_sanskrit": "जानन्नपि तद्वृत्तांतं निदाने नियतेर्वशात् ।\nत्रासात्संतर्जयामास बलेन पदचारिणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002884050, "chapter_id": 22884, "verse_number": "९-१६९-५१", "content_sanskrit": "स महीतः समुत्थाय मूर्द्धानमवरुह्य च ।\nउवाच दारुणतरं वचनं पन्नगाधमः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002884051, "chapter_id": 22884, "verse_number": "९-१६९-५२", "content_sanskrit": "शरणागतं पोषितं च तव पित्रा प्रियंकरम् ।\nकस्मान्मां हंसि दुष्टात्मन्कथं जीवन्विमोक्ष्यसे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002884052, "chapter_id": 22884, "verse_number": "९-१६९-५३", "content_sanskrit": "अनंतरं कलकलः संजातो रोदतां नृणाम् ।\nधनेश्वरसुतो दष्टः सर्पेणापि भृशाकुलः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002884053, "chapter_id": 22884, "verse_number": "९-१६९-५४", "content_sanskrit": "अच्युतानंत गोविंद कृष्णकृष्णेत्युदीरयन् ।\nधनेश्वरोप्यनुप्राप्तः प्रोवाचाकुलया गिरा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002884054, "chapter_id": 22884, "verse_number": "९-१६९-५५", "content_sanskrit": "किं कृतं मम पुत्रेण तव पव्रग विप्रियम् ।\nयदयं भवता मूर्ध्नि स्वभोगेनाभिवेष्टितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002884055, "chapter_id": 22884, "verse_number": "९-१६९-५६", "content_sanskrit": "मूर्ख मित्रं सुसंबंधं हीनजातिजनो हि यः ।\nयः करोत्यबुथोंगारान्स स्वहस्तेन कर्षति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002884056, "chapter_id": 22884, "verse_number": "९-१६९-५७", "content_sanskrit": "तमुवाच च सर्पोऽसौ वाष्पगद्गदया गिरा ।\nनिरपराधो भवतः पुत्रेणाहं समाहतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002884057, "chapter_id": 22884, "verse_number": "९-१६९-५८", "content_sanskrit": "तदहं पश्यतस्तेऽद्य दशाम्येनं नराधिप ।\nयथा न भूयो भूतानां भवेदस्मात्क्वचिद्भयम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002884058, "chapter_id": 22884, "verse_number": "९-१६९-५९", "content_sanskrit": "धनेश्वर उवाच ।\nउपकारं व्रतं भक्त्या स्नेहपारो न यस्य च ।\nसतां मार्गमपाक्रम्य प्रयातः केन वार्यते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002884059, "chapter_id": 22884, "verse_number": "९-१६९-६०", "content_sanskrit": "क्षणमात्रं प्रतीक्षस्व यावदेव शिशुर्मम ।\nऔर्ध्वदेहिककर्माणि करोति स्वयमात्मनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002884060, "chapter_id": 22884, "verse_number": "९-१६९-६१", "content_sanskrit": "एवमुक्ता गृहं गत्वा यतीनां ब्रह्मचारिणाम् ।\nसहस्रं भोजयामास घृतपायसभोजनैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002884061, "chapter_id": 22884, "verse_number": "९-१६९-६२", "content_sanskrit": "समुत्थाय ततः सर्वे ब्राह्मणा हृष्टमानसाः ।\nवणिक्पुत्रस्योत्तमांगे चिक्षिपुः कुसुमाक्षतान् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002884062, "chapter_id": 22884, "verse_number": "९-१६९-६३", "content_sanskrit": "वणिक्पुत्र चिरं जीव नश्यंतु तव शत्रवः ।\nअभीष्टफलसंसिद्धिरस्तु ते ब्राह्मणाज्ञया ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002884063, "chapter_id": 22884, "verse_number": "९-१६९-६४", "content_sanskrit": "ततः स दुष्टप्रकृतिर्विप्र वाग्वज्रताडितः ।\nपन्नगो नगसंकाशः पपात च ममार च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002884064, "chapter_id": 22884, "verse_number": "९-१६९-६५", "content_sanskrit": "विपन्नं पन्नगं दृष्ट्वा त्रस्तचक्षुर्धनेश्वरः ।\nआः किमेतदिति प्रोच्य विषादमगमत्परम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002884065, "chapter_id": 22884, "verse_number": "९-१६९-६६", "content_sanskrit": "पोषितोऽयं मया बालः पालितो लालितस्तथा ।\nममापचारात्पंचत्वमापन्नः पवनाशनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002884066, "chapter_id": 22884, "verse_number": "९-१६९-६७", "content_sanskrit": "उपकारिषु यः साधुः साधुत्वे तस्य को गुणः ।\nअपकारिषु यः साधुः स साधुः सद्भिरिष्यते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002884067, "chapter_id": 22884, "verse_number": "९-१६९-६८", "content_sanskrit": "इत्येवमवधार्यासौ दुःखसंतप्तमानसः ।\nबुभुजे नाकुलतया न च सुष्वाप तां निशाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002884068, "chapter_id": 22884, "verse_number": "९-१६९-६९", "content_sanskrit": "ततः प्रभाते गंगायां स्नात्वा संतर्प्य देवताः ।\nसहस्रं भोजयामास पुनरेव द्विजन्मनाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002884069, "chapter_id": 22884, "verse_number": "९-१६९-७०", "content_sanskrit": "तैर्भुक्तैरिष्टसंसिद्धैर्ब्राह्मणै रनुमोदितः ।\nवणिक्प्राह ममाभीष्टं संजीवत्वेष पन्नगः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002884070, "chapter_id": 22884, "verse_number": "९-१६९-७१", "content_sanskrit": "ततो द्विजवरोन्मुक्तैरंबुभिः परिषिंचितः ।\nउदतिष्ठदहीनांगः सहसा हि महाकुलः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002884071, "chapter_id": 22884, "verse_number": "९-१६९-७२", "content_sanskrit": "प्रहर्षमतुलं लेभे दृष्ट्वा तं पुरतः स्थितम् ।\nप्रत्यग्रावयवं दृष्ट्वा सृक्किणीपरिलेलिहम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002884072, "chapter_id": 22884, "verse_number": "९-१६९-७३", "content_sanskrit": "साधुवादो महाञ्जातः प्रशशंसुर्धनेश्वरम् ।\nपुरीनिवासिनः सर्वे विस्मयोत्फुल्ललोचनाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002884073, "chapter_id": 22884, "verse_number": "९-१६९-७४", "content_sanskrit": "सहस्रभोज्यमाहात्म्यं कथितं ते युधिष्ठिर ।\nसम्यक्छ्रद्धाप्रयुक्तस्य किमन्यत्कथयामि ते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002884074, "chapter_id": 22884, "verse_number": "९-१६९-७५", "content_sanskrit": "यच्छंति येऽनुदिवसं द्विजपुंगवानामन्नं विशुद्धमनसो भृशमागतानाम् ।\nमर्त्ये विहृत्य सुचिरं ससुहृज्जनास्ते प्रेत्य प्रयांति भवनं मुदिता मुरारेः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]