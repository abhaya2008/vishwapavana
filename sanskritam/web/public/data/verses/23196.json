[{"id": 7003196000, "chapter_id": 23196, "verse_number": "४-१३२-१", "content_sanskrit": "अथ द्वात्रिंशदधिकशततमोऽध्यायः ।\nशौनक उवाच ।\nश्रुतं सर्वं नावशेषं धर्मेश व्रह्मणं च माम् ।\nकथयस्व महाभाग पुराणं पुनरेव हि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003196001, "chapter_id": 23196, "verse_number": "४-१३२-२", "content_sanskrit": "एवंविधं पुराणं च जन्मनैव न हि श्रुतम् ।\nनधृष्टं न श्रुतं तात ता (त्वा) दृशं वाजकं तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003196002, "chapter_id": 23196, "verse_number": "४-१३२-३", "content_sanskrit": "सूत उवाच ।\nश्रूयतां भो महाभाग सावधानं च संयतम् ।\nअध्यायश्रवणेनैव पुराणफलमालभेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003196003, "chapter_id": 23196, "verse_number": "४-१३२-४", "content_sanskrit": "ब्रह्मखण्डं च कथितं परं ब्रह्मनिरूपणम् ।\nतदनिर्वचनीयं च येषामपि यथागमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003196004, "chapter_id": 23196, "verse_number": "४-१३२-५", "content_sanskrit": "साकारं च निराकारं सगुणं निर्गुणं पृथक् ।\nयेषामपि यथा शक्तिस्तथैव ध्यानमेव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003196005, "chapter_id": 23196, "verse_number": "४-१३२-६", "content_sanskrit": "गोलोकादेर्वर्णनं च क्रमेण च पृथक्पृथक् ।\nतत्रोपयुक्तोपाख्यानं यद्यत्प्रासङ्गिकं द्विज ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003196006, "chapter_id": 23196, "verse_number": "४-१३२-७", "content_sanskrit": "जातीनां नीर्णयश्चैव संकराणां तथैव च ।\nयद्यद्विशिष्टोपाख्यानं तत्तत्प्रशनानुरोधतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003196007, "chapter_id": 23196, "verse_number": "४-१३२-८", "content_sanskrit": "राधामाधवयोः क्रीडा महाविष्णोः समुद्भवः ।\nनिरूपणं च विश्वेषां समासेन द्विजोत्तम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003196008, "chapter_id": 23196, "verse_number": "४-१३२-९", "content_sanskrit": "ब्रह्मनारदयोश्चैव संवादः परमार्थतः ।\nविपेको नारदस्यैव मुनीन्द्रस्य तथैव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003196009, "chapter_id": 23196, "verse_number": "४-१३२-१०", "content_sanskrit": "आज्ञया ब्रह्मणश्चैव नरनारायणाश्रमम् ।\nगमनं नारदस्यैव तेन सार्थं च दर्शनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003196010, "chapter_id": 23196, "verse_number": "४-१३२-११", "content_sanskrit": "तयोः संभाषणं चैव नारदाद्य(य) निवेदनम् ।\nतत्र देव ब्रह्मखण्डं क्रमेणोक्तं द्विजोत्तम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003196011, "chapter_id": 23196, "verse_number": "४-१३२-१२", "content_sanskrit": "श्रूयतां प्रकृतेः खण्डं सुधाखण्डसमं मुने ।\nप्रकृतेर्लक्षणं प्रोक्तं प्रकृतीनां च वर्णनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003196012, "chapter_id": 23196, "verse_number": "४-१३२-१३", "content_sanskrit": "उपाश्यानं च तासां च वर्णनं बूजनादिकम् ।\nलक्ष्मीः सरस्वती दुर्गा सावित्री राधिका तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003196013, "chapter_id": 23196, "verse_number": "४-१३२-१४", "content_sanskrit": "एतासां चरितं चैवमन्यासां च पृथक्पृथक् ।\nउपाख्यानं महालक्ष्म्याः सरस्वत्यास्तथैव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003196014, "chapter_id": 23196, "verse_number": "४-१३२-१५", "content_sanskrit": "अपूर्वं राधिकाख्यानं सावित्र्याश्च तथैव च ।\nसंवादो यमसावित्र्योः सत्यवज्जीवदानकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003196015, "chapter_id": 23196, "verse_number": "४-१३२-१६", "content_sanskrit": "कृण्डानां वर्णनं प्रोक्तं तेषां च लक्षणं तथा ।\nजीवितर्मविपाकश्च भोगनिर्णय एव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003196016, "chapter_id": 23196, "verse_number": "४-१३२-१७", "content_sanskrit": "अपूर्व राधिकाख्यानं पुराणेषु सुगोप्यकम् ।\nसुयज्ञस्च नृपेन्द्रस्य चरितं परमाद्भुतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003196017, "chapter_id": 23196, "verse_number": "४-१३२-१८", "content_sanskrit": "प्रोक्तं तुलस्युपाख्यानं पुराणेषु सुगोप्यकम् ।\nमहायुद्धं च संवादे महेशशङ्खचूडयोः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003196018, "chapter_id": 23196, "verse_number": "४-१३२-१९", "content_sanskrit": "तुलसीकृष्णसंवादस्तयोः संभोग एव च ।\nनिधनं शङ्खचूडस्य श्रीदाम्नः शापमोक्षणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003196019, "chapter_id": 23196, "verse_number": "४-१३२-२०", "content_sanskrit": "पदप्राप्तिः सुराणां च विपदां खण्डनं तथा ।\nजीविनां मोक्षबीजं च गङ्गोपाख्यानमीप्सितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003196020, "chapter_id": 23196, "verse_number": "४-१३२-२१", "content_sanskrit": "तथैव मनसाख्यानं परं हर्षविवर्धनम् ।\nस्वाहास्वधाख्यानमेवमन्यासां च निरूपणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003196021, "chapter_id": 23196, "verse_number": "४-१३२-२२", "content_sanskrit": "यद्यतप्रासङ्गिकाख्यानं वक्तुः प्रश्नानुरोधतः ।\nप्रोक्तं तत्प्रकृतेः खण्डं खण्डं गणपतेः श्रृणु ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003196022, "chapter_id": 23196, "verse_number": "४-१३२-२३", "content_sanskrit": "अतीव मधुरं रम्यं स्वादु स्वादु पदे पदे ।\nसुगोप्यं तत्पुराणेषु रम्यं रम्यं नवं नवम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003196023, "chapter_id": 23196, "verse_number": "४-१३२-२४", "content_sanskrit": "सुदुर्लभमुपाख्यानं श्रोतृप्रीतिकरं परम् ।\nप्रोक्ता क्रीडा च परमा पार्वतीपरमेशयोः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003196024, "chapter_id": 23196, "verse_number": "४-१३२-२५", "content_sanskrit": "स्कन्दोत्पत्तिः प्रथमतः क्रीडाभङ्गस्तयोस्तथा ।\nपार्वतीतोषणं चैवमभिमानविमोक्षणम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003196025, "chapter_id": 23196, "verse_number": "४-१३२-२६", "content_sanskrit": "पुण्यकं च व्रतं विष्णोर्देव्याश्चरितमुत्तमम् ।\nवरदानं हरेरेव सुव्रतां पार्वतीं प्रति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003196026, "chapter_id": 23196, "verse_number": "४-१३२-२७", "content_sanskrit": "हरेश्च दर्शनं चैव ब्राह्मणातिथिरूपिणः ।\nआविर्भावो गणेशस्य कृपया शिवमन्दिरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003196027, "chapter_id": 23196, "verse_number": "४-१३२-२८", "content_sanskrit": "दर्शनं पुत्रवक्त्रस्य पार्वतीपरमेशयोः ।\nपरमानन्दरूपं च शिवगेहे महोत्सवम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003196028, "chapter_id": 23196, "verse_number": "४-१३२-२९", "content_sanskrit": "देवाद्या ददृशुः सर्वे बालं नित्यमजं विभुम् ।\nसत्यस्वरूपं परमं परब्रह्मस्वरूपिणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003196029, "chapter_id": 23196, "verse_number": "४-१३२-३०", "content_sanskrit": "सर्वविघ्नहरं शान्तं दातारं सर्वसंपदाम् ।\nतपसां जपयज्ञानां व्रतानां फलदं विभुम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003196030, "chapter_id": 23196, "verse_number": "४-१३२-३१", "content_sanskrit": "अतीव कमनीयं च रमणीयं च योषिताम् ।\nप्राणाधिकं प्रियतम् पार्वतीपरमेशयोः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003196031, "chapter_id": 23196, "verse_number": "४-१३२-३२", "content_sanskrit": "परमात्मस्वरूपं च भगवन्तं सनातनम् ।\nसर्वेशं सर्वबीजं च साक्षान्नारायणात्मकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003196032, "chapter_id": 23196, "verse_number": "४-१३२-३३", "content_sanskrit": "यद्दर्शनाच्च स्तवनात्प्रणामात्पूजनात्तथा ।\nध्यानासाध्यं दुराराध्यं जन्मकोट्यघनाशनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003196033, "chapter_id": 23196, "verse_number": "४-१३२-३४", "content_sanskrit": "कार्तिकोद्धरणं प्रोक्तं तस्याभिषेक एव च ।\nगणेशपूजनं चैव सर्वविघ्नविनाशनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003196034, "chapter_id": 23196, "verse_number": "४-१३२-३५", "content_sanskrit": "जमदग्नेश्च युद्धं च कार्तवीर्यार्जुनेन च ।\nसुरभीहरणं चैव निधनं च मुनेस्तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003196035, "chapter_id": 23196, "verse_number": "४-१३२-३६", "content_sanskrit": "पतिव्रतारेशुकायाश्चितारोहणमेव च ।\nप्रतिज्ञातं भृगोश्चैव दारुणं च सुदारुणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003196036, "chapter_id": 23196, "verse_number": "४-१३२-३७", "content_sanskrit": "निःक्षत्रीकरणं चैवमेकविंशतिकं द्विज ।\nसंवादो ज्ञानलाभश्च गणेशपर्शुरामयोः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003196037, "chapter_id": 23196, "verse_number": "४-१३२-३८", "content_sanskrit": "तयोर्युद्धं दारुमं च हेरम्बदन्तभञ्जनम् ।\nदुर्गायाश्च विलापश्चाभिशापो भार्गवं प्रति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003196038, "chapter_id": 23196, "verse_number": "४-१३२-३९", "content_sanskrit": "स्मरणे पर्शुरामस्याप्याविर्भावो हरेरपि ।\nपार्वतीं बोधयामास स्वयं नारायणः प्रभुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003196039, "chapter_id": 23196, "verse_number": "४-१३२-४०", "content_sanskrit": "वर्णनं शिवलोकस्य परमाश्चर्यमीप्सितम् ।\nप्रदत्तं पर्शुरामाय महास्त्रं शंकरेण च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003196040, "chapter_id": 23196, "verse_number": "४-१३२-४१", "content_sanskrit": "मन्त्रं च कवचं चैव कृष्णस्य परमात्मनः ।\nवरदानं चाभयं च प्रदानं सर्वसंपदाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003196041, "chapter_id": 23196, "verse_number": "४-१३२-४२", "content_sanskrit": "त्रिःसप्तकृत्वो भूपानां निधनं च चकार सः ।\nबभूव भृगुणा विप्र भुवश्च भारमीक्षणम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003196042, "chapter_id": 23196, "verse_number": "४-१३२-४३", "content_sanskrit": "प्रश्नानुरोधक्रमतः पूर्वापाख्यानमेव च ।\nप्रोक्तं गणपतेः खण्डं समासेन द्विजोत्तम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003196043, "chapter_id": 23196, "verse_number": "४-१३२-४४", "content_sanskrit": "श्रीकृष्णजन्मखण्डं च श्रूयतां सावधानतः ।\nजन्ममृत्युजराव्याधिहरं मोक्षकरं परम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003196044, "chapter_id": 23196, "verse_number": "४-१३२-४५", "content_sanskrit": "हरिदास्यप्रदं शुद्धं सुश्राव्यं च सुधोपमम् ।\nअत्यबूर्वमुणाख्यानं रम्यं रम्यं नवं नवम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003196045, "chapter_id": 23196, "verse_number": "४-१३२-४६", "content_sanskrit": "न श्रुतं चन्मना यद्यत्स्वदु स्वादु पदे पदे ।\nप्रदीपं सर्वसत्त्वानां भवाब्धितारणं परम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003196046, "chapter_id": 23196, "verse_number": "४-१३२-४७", "content_sanskrit": "कर्मेपभोगरोगाणां मर्दनं च रसायनम् ।\nश्रीकृष्णचरणाम्भोजप्राप्तिसोपानकारणम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003196047, "chapter_id": 23196, "verse_number": "४-१३२-४८", "content_sanskrit": "श्रीदामराधाकलहवर्णनं दारुणं द्विज ।\nतयोः शापप्रकथनं ततस्तेषां विसर्जनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003196048, "chapter_id": 23196, "verse_number": "४-१३२-४९", "content_sanskrit": "ब्रह्मण प्रार्थितस्यैव हरेर्जनम् महीतले ।\nप्रोक्तं च जन्मखण्डे च परमाद्भुतमेव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003196049, "chapter_id": 23196, "verse_number": "४-१३२-५०", "content_sanskrit": "आविर्भावो हरेरेव वसुदेवस्य मन्दिरे ।\nकंसासुरभयेनैव गोकुले गमनं हरेः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003196050, "chapter_id": 23196, "verse_number": "४-१३२-५१", "content_sanskrit": "वृषभानसुता राधा श्रीदाम्नः शापहेतुना ।\nबालक्रीडावर्णनं च गोकुले परमात्मनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003196051, "chapter_id": 23196, "verse_number": "४-१३२-५२", "content_sanskrit": "दैत्यादिनिधनं चैव कीर्तितं हरिणा तथा ।\nगर्गस्याऽऽगमनं प्रोक्तं शुभान्नप्राशनं हरेः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003196052, "chapter_id": 23196, "verse_number": "४-१३२-५३", "content_sanskrit": "निधनं पूतनायाश्च सद्यः शकटभञ्जनम् ।\nश्रीकृष्णबन्धमोक्षं च यमलार्जुनभञ्जनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003196053, "chapter_id": 23196, "verse_number": "४-१३२-५४", "content_sanskrit": "त्रैलोक्यदर्शनं वक्त्रे गोवत्साहरणं तथा ।\nकृत्वा गोवत्सनिर्माणं ब्रह्मणः स्तवनं हरेः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003196054, "chapter_id": 23196, "verse_number": "४-१३२-५५", "content_sanskrit": "सहसा गोकुलं त्यवत्वा पुण्यं वृन्दावनं वनम् ।\nभयाज्जगाम नन्दश्च सार्धं च नन्दनेन च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003196055, "chapter_id": 23196, "verse_number": "४-१३२-५६", "content_sanskrit": "वृन्दावनस्य निर्माणं प्रोक्तं च परमाद्भुतम् ।\nसार्धं च बालकैः सार्ध तत्र संक्रीडनं हरे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003196056, "chapter_id": 23196, "verse_number": "४-१३२-५७", "content_sanskrit": "सदन्नं ब्राह्मणीनां च भोजनं कथितं हरेः ।\nवरदानं च तासां वै प्राक्तनेन निरूपणम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003196057, "chapter_id": 23196, "verse_number": "४-१३२-५८", "content_sanskrit": "क्रतूनां वर्णनं चैव वस्त्रापहरणं तथा ।\nवरदानं च गोपीनां कृष्णेनैव कऋतं द्विज ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003196058, "chapter_id": 23196, "verse_number": "४-१३२-५९", "content_sanskrit": "कात्यायनीव्रतं प्रोक्तं श्रीदुर्गापूजनं तथा ।\nपार्वत्या च वरो दत्तो गोपीभ्यो यमुनातटे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003196059, "chapter_id": 23196, "verse_number": "४-१३२-६०", "content_sanskrit": "तालानां भक्षणं प्रोक्तं शक्रयामाविमर्दनम् ।\nराधया सह कृष्णस्य विरहो मेलनं तथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003196060, "chapter_id": 23196, "verse_number": "४-१३२-६१", "content_sanskrit": "गोपीक्रीडा च संप्रोक्ता कृष्णक्रोडे च राधिका ।\nछाया रायणगेहे च संप्रोक्ता मायया हरेः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003196061, "chapter_id": 23196, "verse_number": "४-१३२-६२", "content_sanskrit": "शृङ्गारं षोडसविधं कृत्वा तु रासमण्डले ।\nअन्तर्धानं हरेरेव राधया सह कानने ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003196062, "chapter_id": 23196, "verse_number": "४-१३२-६३", "content_sanskrit": "मलयागमनं चैव तया सार्धं द्विजोत्तम ।\nराधामाधवयोश्चैव संवादस्तत्र निर्जने ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003196063, "chapter_id": 23196, "verse_number": "४-१३२-६४", "content_sanskrit": "कैवल्यमपि गोपीनां प्रोक्तं नानाविधं मुने ।\nपुनरागमनं चैव पुण्यं वृन्दावनं वनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003196064, "chapter_id": 23196, "verse_number": "४-१३२-६५", "content_sanskrit": "श्रीकृष्णदर्शनं चैव गोपीनां हर्षवर्थनम् ।\nनानाप्रकारक्रीडा च प्रोक्ता तस्य जले स्थले ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003196065, "chapter_id": 23196, "verse_number": "४-१३२-६६", "content_sanskrit": "गोपीनामपि सौभाग्यं राधायाश्च विशेषतः ।\nप्रोक्तं व्यासेन सौन्दर्य रम्यं रम्यं नवं नवम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003196066, "chapter_id": 23196, "verse_number": "४-१३२-६७", "content_sanskrit": "नभःस्थितानां देवानां दर्शनं प्रोक्तमेव च ।\nमनसः स्खलनं चैव देवीनां रासमण्डले ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003196067, "chapter_id": 23196, "verse_number": "४-१३२-६८", "content_sanskrit": "अंशेन लेभिरे जन्म देव्यश्चोक्तमिदं द्विज ।\nअक्रूरागमनं चैव गोपीनां च विलापनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003196068, "chapter_id": 23196, "verse_number": "४-१३२-६९", "content_sanskrit": "प्रोक्तं सर्वं क्रमेगैव चाक्रूरभर्त्सनं तथा ।\nमथुरागमनं विष्णोः शोकं गोकुलवासिनाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003196069, "chapter_id": 23196, "verse_number": "४-१३२-७०", "content_sanskrit": "राधिकाविरहज्वालाजालं प्रोक्तं यथोचितम् ।\nस्वमूल्तिदर्शनं चैवमक्रूरं यमुनातटे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003196070, "chapter_id": 23196, "verse_number": "४-१३२-७१", "content_sanskrit": "मथुरावेशनं प्रोक्तं निधनं रजकस्य च ।\nकुब्जया सह संभोगस्तस्या मोक्षणमेव च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003196071, "chapter_id": 23196, "verse_number": "४-१३२-७२", "content_sanskrit": "प्रसादनं कुविन्दस्य मालाकारस्य मोक्षणम् ।\nधनुधो भञ्जनं शंभोर्हस्तिनो निधनं तथा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003196072, "chapter_id": 23196, "verse_number": "४-१३२-७३", "content_sanskrit": "सभाप्रवेशनं प्रोक्तं नानारूपप्रदर्शनम् ।\nकंसस्य निधनं प्रोक्तं तद्बन्धूनां विलापनम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003196073, "chapter_id": 23196, "verse_number": "४-१३२-७४", "content_sanskrit": "संस्कारं तस्य विधिवद्राजत्वं तत्पितुस्तथा ।\nविलापनं च नन्दस्य स्तवनं परमाद्भुतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003196074, "chapter_id": 23196, "verse_number": "४-१३२-७५", "content_sanskrit": "प्रोक्तस्तयोश्च संवादो निर्जने तातपुत्रयोः ।\nपरमाध्यात्मिकं ज्ञानं नन्दाय च ददौ विभुः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003196075, "chapter_id": 23196, "verse_number": "४-१३२-७६", "content_sanskrit": "मुनीनां गमनं चैव धन्योपाख्यानमेव च ।\nकथितं च कुमारेण प्रोक्तमेव सुदुर्लभम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003196076, "chapter_id": 23196, "verse_number": "४-१३२-७७", "content_sanskrit": "उद्धवागमनं प्रोक्तं राधास्थानं च निर्जनम् ।\nज्ञानं तयोश्च संवादे प्रोक्तमेव शुभावहम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003196077, "chapter_id": 23196, "verse_number": "४-१३२-७८", "content_sanskrit": "यज्ञोपवीतं कृष्णस्य विद्यादानं गृरोर्गृहे ।\nमृतपुत्रप्रदानं च प्रोक्तं तद्गुरवे पुरा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003196078, "chapter_id": 23196, "verse_number": "४-१३२-७९", "content_sanskrit": "जरासंधस्य दमनं निधनं यवनस्य च ।\nद्वारकायाश्च निर्माणं विश्वकारोद्यमं तथा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003196079, "chapter_id": 23196, "verse_number": "४-१३२-८०", "content_sanskrit": "द्वारकावेशनं प्रोक्तमुग्रसेनविलापनम् ।\nरुक्मिणीहरणं चैव नृपाणां दमनं तथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003196080, "chapter_id": 23196, "verse_number": "४-१३२-८१", "content_sanskrit": "सर्वासं कामिनीनां च प्रोक्तमुद्वाहनं तथा ।\nमायावतीमोक्षणं च निधनं शम्बरस्य च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003196081, "chapter_id": 23196, "verse_number": "४-१३२-८२", "content_sanskrit": "धर्मपुत्रराजसूये शिशुपालस्य मोक्षणम् ।\nदन्तवक्त्रस्य च मुनेः शाल्वस्य निधनं तथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003196082, "chapter_id": 23196, "verse_number": "४-१३२-८३", "content_sanskrit": "मणेश्च हरणं चैव पारिजातस्य स्वर्गतः ।\nकुरुपाण्डवयुद्धे च भुवश्च भारमोक्षणम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003196083, "chapter_id": 23196, "verse_number": "४-१३२-८४", "content_sanskrit": "ऊषाया हरणं प्रोक्तं बाणस्य भुजकृन्तनम् ।\nबलेश्च स्तवनं प्रोक्तमनिरुद्धस्य विक्रमः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003196084, "chapter_id": 23196, "verse_number": "४-१३२-८५", "content_sanskrit": "राधायशोदासंवादः प्रोक्तः परमदुर्लभः ।\nमोक्षणं च शृगालस्य प्रोक्तं च परमाद्भुतम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003196085, "chapter_id": 23196, "verse_number": "४-१३२-८६", "content_sanskrit": "तीर्थयात्राप्रसङ्गेन गणेशपूजनं तथा ।\nदर्शनं राधिकासार्धं कुष्णस्य परमात्मनः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003196086, "chapter_id": 23196, "verse_number": "४-१३२-८७", "content_sanskrit": "राधाया दर्शनं देव्या राधातेजःप्रकाशनम् ।\nराधाय रमणं तीर्थे भ्रमणं रहसि स्मृतम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003196087, "chapter_id": 23196, "verse_number": "४-१३२-८८", "content_sanskrit": "निधनं यदुवंशानां ब्रह्मशापेन शौनक ।\nमोक्षणं पाण्डवानां च स्वपदे गमनं हरेः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003196088, "chapter_id": 23196, "verse_number": "४-१३२-८९", "content_sanskrit": "विवाहो नारदस्यैवोत्पत्तिर्वह्निसुवर्णयोः ।\nप्रोक्तं सर्व महाभाग पुनरेव समासतः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003196089, "chapter_id": 23196, "verse_number": "४-१३२-९०", "content_sanskrit": "चतुःखण्डैः पुराणं च ब्रह्मवैवर्तमेव च ।\nअतः परं मुनिश्रेष्ठ किं भूयः श्रातुमिच्छसि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]