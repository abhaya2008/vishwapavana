[{"id": 2132740, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "मार्कण्डेयेन युधिष्ठिरं प्रति कृतयुगवृत्तान्तकथनपूर्वकं धर्माचरणचोदना । भगवता कल्किना कृतयुगसंस्थापनम् । युधिष्ठिरं प्रति मार्कण्डेयस्य धर्मोपदेशश्च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2132741, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2132742, "chapter_id": 3865, "verse_number": "१", "content_sanskrit": "ततश्चोरक्षयं कृत्वा द्विजेभ्यः पृथिवीमिमाम् ।\nवाजिमेधे महायज्ञे विधिवत् कल्पयिष्यति \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2132743, "chapter_id": 3865, "verse_number": "२", "content_sanskrit": "स्थापयित्वा च मर्यादाः स्वयम्भुविहिताः शुभाः ।\nवनं पुण्ययशःकर्मा जरया संश्र(क्ष)यिष्यति ।\nतच्छीलमनुवर्त्स्यन्ति मनुष्या लोकवासिनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2132744, "chapter_id": 3865, "verse_number": "३", "content_sanskrit": "विप्रैश्चोरक्षये चैव कृते क्षेमं भविष्यति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2132745, "chapter_id": 3865, "verse_number": "४", "content_sanskrit": "कृष्णाजिनानि शक्तीश्च त्रिशूलान्यायुधानि च ।\nस्थापयन् विप्रशार्दूलान् देशेषु विजितेषु च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2132746, "chapter_id": 3865, "verse_number": "५", "content_sanskrit": "संस्तूयमानो विप्रेन्द्रैर्मानयानो द्विजोत्तमान् ।\nकल्की चरिष्यति महीं सदा दस्युवधे रतः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2132747, "chapter_id": 3865, "verse_number": "६", "content_sanskrit": "हा मातस्तात पुत्रेति तास्ता वाचः सुदारुणाः ।\nविक्रोशमानान् सुभृशं दस्यून् नेष्यति सङ्क्षयम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2132748, "chapter_id": 3865, "verse_number": "७", "content_sanskrit": "ततोऽधर्मविनाशो वै धर्मवृद्धिश्च भारत ।\nभविष्यति कृते प्राप्ते क्रियावांश्च जनस्तथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2132749, "chapter_id": 3865, "verse_number": "८", "content_sanskrit": "आरामाश्चैव चैत्याश्च तटाकावसथास्तथा ।\nयज्ञक्रियाश्च विविधा भविष्यन्ति कृते युगे ।\nब्राह्मणाः साधवश्चैव मुनयश्च तपस्विनः \t॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2132750, "chapter_id": 3865, "verse_number": "९", "content_sanskrit": "आश्रमाश्चाविपाषण्डाः स्थिताः सत्ये जनास्तदा ।\nजायन्ति सर्वभूतानि शुध्यमानानि चैव हि \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2132751, "chapter_id": 3865, "verse_number": "१०", "content_sanskrit": "सर्वेष्वृतुषु राजेन्द्र सर्वं सस्यं भविष्यति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2132752, "chapter_id": 3865, "verse_number": "११", "content_sanskrit": "नरा दानेषु निरता व्रतेषु नियमेषु च ।\nजपयज्ञपरा विप्रा धर्मकामा मुदा युताः ।\nपालयिष्यन्ति राजानो धर्मेणेमां वसुन्धराम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2132753, "chapter_id": 3865, "verse_number": "१२", "content_sanskrit": "व्यवहाररता वैश्या भविष्यन्ति कृते युगे ।\nषट्कर्मनिरता विप्राः क्षत्रिया विक्रमे रताः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2132754, "chapter_id": 3865, "verse_number": "१३", "content_sanskrit": "शुश्रूषायां रताः शूद्रास्तथा वर्णत्रयस्य च \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2132755, "chapter_id": 3865, "verse_number": "१४", "content_sanskrit": "एष धर्मः कृतयुगे त्रेतायां द्वापरे तथा ।\nपश्चिमे युगकाले च यः स ते सम्प्रकीर्तितः ।\nसर्वलोकस्य विदिता युगसङ्ख्या च पाण्डव \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2132756, "chapter_id": 3865, "verse_number": "१५", "content_sanskrit": "एतत् ते सर्वमाख्यातमतीतानागतं तथा ।\nवायुप्रोक्तमनुस्मृत्य पुराणमृषिसंस्तुतम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2132757, "chapter_id": 3865, "verse_number": "१६", "content_sanskrit": "एवं संसारमार्गा मे बहुशश्चिरजीविना ।\nदृष्टाश्चैवानुभूताश्च तांस्ते कथितवानहम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2132758, "chapter_id": 3865, "verse_number": "१७", "content_sanskrit": "इदं चैवापरं भूयः सह भ्रातृभिरच्युत ।\nधर्मसंशयमोक्षार्थं निबोध वचनं मम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2132759, "chapter_id": 3865, "verse_number": "१८", "content_sanskrit": "धर्मे त्वयाऽऽत्मा संयोज्यो नित्यं धर्मभृतां वर ।\nधर्मात्मा हि सुखं राजन् प्रेत्य चेह च विन्दति ।\nनिबोध च शुभां वाणीं यां प्रवक्ष्यामि तेऽनघ \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2132760, "chapter_id": 3865, "verse_number": "१९", "content_sanskrit": "न ब्राह्मणे परिभवः कर्तव्यस्ते कदाचन ।\nब्राह्मणः कुपितो हन्यादपि लोकान्प्रतिज्ञया\t ॥ १९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2132761, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2132762, "chapter_id": 3865, "verse_number": "२०", "content_sanskrit": "मार्कण्डेयवचः श्रुत्वा कुरूणां प्रवरो नृपः ।\nउवाच वचनं धीमान् परमं परमद्युतिः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2132763, "chapter_id": 3865, "verse_number": "२१", "content_sanskrit": "एतच्छ्रुत्वा मया किं स्यात् कर्त्तव्यं मुनिसत्तम ।\nकथं चायं जितो लोको रक्षितव्यो भविष्यति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2132764, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2132765, "chapter_id": 3865, "verse_number": "२२", "content_sanskrit": "दयावान् सर्वभूतेषु हितो रक्तोऽनसूयकः ।\nसत्यवादी मृदुर्दान्तः प्रजानां रक्षणे रतः \t॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2132766, "chapter_id": 3865, "verse_number": "२३", "content_sanskrit": "चर धर्मं त्यजाधर्मं पितॄन् देवांश्च पूजय ।\nप्रमादाद् यत्कृतं तेऽभूत् सम्यग्दानेन तज्जय\t॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2132767, "chapter_id": 3865, "verse_number": "२४", "content_sanskrit": "अलं ते मानमाश्रित्य सततं परवान् भव ।\nविजित्य पृथिवीं सर्वां मोदमानः सुखी भव \t॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2132768, "chapter_id": 3865, "verse_number": "२५", "content_sanskrit": "एष भूतो भविष्यश्च धर्मस्ते समुदीरितः ।\nन तेऽस्त्यविदितं किञ्चिदतीतानागतं भुवि \t॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2132769, "chapter_id": 3865, "verse_number": "२६", "content_sanskrit": "तस्मादिमं परिक्लेशं त्वं तात हृदि मा कृथाः ।\nप्राज्ञास्तात न मुह्यन्ति कालेनापि प्रपीडिताः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2132770, "chapter_id": 3865, "verse_number": "२७", "content_sanskrit": "एष कालो महाबाहो अपि सर्वदिवौकसाम् ।\nमुह्यन्ते हि प्रजास्तात कालेनापि प्रचोदिताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2132771, "chapter_id": 3865, "verse_number": "२८", "content_sanskrit": "मा च तत्र विशङ्काभूद् यन्मयोक्तं तवानघ ।\nआशङ्क्य मद्वचो ह्येतद् धर्मलोपो भवेत् तव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2132772, "chapter_id": 3865, "verse_number": "२९", "content_sanskrit": "जातोऽपि(सि) पश्चिमे वंशे कुरूणां भरतर्षभ ।\nकर्मणा मनसा वाचा सर्वमेतत्समाचर \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2132773, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2132774, "chapter_id": 3865, "verse_number": "३०", "content_sanskrit": "यत् त्वयोक्तं द्विजश्रेष्ठ वाक्यं श्रुतिमनोहरम् ।\nतथा करिष्ये यत्नेन भवतः शासनं विभो \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2132775, "chapter_id": 3865, "verse_number": "३१", "content_sanskrit": "न मे लोभोऽस्ति विप्रेन्द्र न भयं न च मत्सरः ।\nकरिष्यामि हि तत्सर्वमुक्तं यत् ते मयि प्रभो \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2132776, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2132777, "chapter_id": 3865, "verse_number": "३२", "content_sanskrit": "श्रुत्वा तु वचनं तस्य मार्कण्डेयस्य धीमतः ।\nसंहृष्टाः पाण्डवा राजन् सहिताः शार्ङ्गधन्वना\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2132778, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "विप्रर्षभाश्च ते सर्वे ये तत्रासन्समागताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2132779, "chapter_id": 3865, "verse_number": "३३", "content_sanskrit": "तथा कथां शुभां श्रुत्वा मार्कण्डेयस्य धीमतः ।\nविस्मिताः समपद्यन्त पुराणस्य निवेदनात्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2132780, "chapter_id": 3865, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि युधिष्ठिरानुशासने षडशीत्यधिकशततमोऽध्यायः ॥१८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2132781, "chapter_id": 3865, "verse_number": "", "content_sanskrit": "मार्कण्डेयसमास्यापर्वणि एकादशोऽध्यायः ॥११॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]