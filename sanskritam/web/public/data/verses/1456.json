[{"id": 2021956, "chapter_id": 1456, "verse_number": "३-९४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021957, "chapter_id": 1456, "verse_number": "३-९४-१", "content_sanskrit": "ततः संप्रस्थितो राजा कौन्तेयो भूरिदक्षिणः।\nअगस्त्याश्रममासाद्य दुर्जयायामुवास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021958, "chapter_id": 1456, "verse_number": "३-९४-२", "content_sanskrit": "तत्रैव लोमशं राजा पप्रच्छ वदतांवरः।\nअगस्त्येनेह वातापिः किमर्थमुपशामितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021959, "chapter_id": 1456, "verse_number": "३-९४-३", "content_sanskrit": "आसीद्वा किंप्रभावश्च स दैत्यो मानवान्तकः।\nकिमर्थं चोदितो मन्युरगस्त्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021960, "chapter_id": 1456, "verse_number": "३-९४-४x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021961, "chapter_id": 1456, "verse_number": "३-९४-४", "content_sanskrit": "इल्वलो नाम दैतेय आसीत्कौरवनन्दना।\nमणिमत्यां पुरि पुरा वातापिस्तस्य चानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021962, "chapter_id": 1456, "verse_number": "३-९४-५", "content_sanskrit": "स ब्राह्मणं तपोयुक्तमुवाच दितिनन्दनः।\nपुत्रं मे भगवानेकमिन्द्रतुल्यं प्रयच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021963, "chapter_id": 1456, "verse_number": "३-९४-६", "content_sanskrit": "तस्मै स ब्राह्मणो नादात्पुत्रं वासवसंमितम्।\nचुक्रोध सोऽसुरस्तस्य ब्राह्मणस्य ततो भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021964, "chapter_id": 1456, "verse_number": "३-९४-७", "content_sanskrit": "तदाप्रभृतिराजेन्द्र इल्वलो ब्रह्महाऽसुरः।\nमन्युमान्भ्रातरं छागं मायावी ह्यकरोत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021965, "chapter_id": 1456, "verse_number": "३-९४-८", "content_sanskrit": "मेषरूपी च वातापिः कामरूप्यभवत्क्षणात्।\nसंस्कृत्यतं भोजयति ततो विप्रं जिधांसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021966, "chapter_id": 1456, "verse_number": "३-९४-९", "content_sanskrit": "स चाह्वयति यं वाचा गतं वैवस्वतक्षयम्।\nस पुनर्देहमास्थाय जीवन्स्म प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021967, "chapter_id": 1456, "verse_number": "३-९४-१०", "content_sanskrit": "ततो वातापिमसुरं छागं कृत्वा सुसंस्कृतम्।\nतं ब्राह्मणं भोजयित्वा पुनरेव समाह्वयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021968, "chapter_id": 1456, "verse_number": "३-९४-११", "content_sanskrit": "तामिल्वलेन महता स्वरेण गिरमीरिताम्।\nश्रुत्वाऽतिमायो बालवान्क्षिप्रं ब्राह्मणकण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021969, "chapter_id": 1456, "verse_number": "३-९४-१२", "content_sanskrit": "तस्य पार्श्वं विनिर्भिद्य ब्राह्मणस्य महासुरः।\nवातापिः प्रहसन्राजन्निश्चक्राम विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021970, "chapter_id": 1456, "verse_number": "३-९४-१३", "content_sanskrit": "एवं स ब्राह्मणान्राजन्भोजयित्वा पुनःपुनः।\nहिंसयामायस दैतेय इल्वलो दुष्टचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021971, "chapter_id": 1456, "verse_number": "३-९४-१४", "content_sanskrit": "अगस्त्यश्चापि भगवानेतस्मिन्काल एव तु।\nपितॄन्ददर्श गर्ते वै लम्बमानानधोमुखान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021972, "chapter_id": 1456, "verse_number": "३-९४-१५", "content_sanskrit": "सोऽपृच्छल्लम्बमानांस्तान्भगवन्तश्च किंपराः।\n`किंमर्थं वेह लम्बध्वे गर्ते यूयमधोमुखाः।\nसंतानहेतोरिति ते प्रत्यूचुर्ब्रह्मवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021973, "chapter_id": 1456, "verse_number": "३-९४-१६", "content_sanskrit": "ते तस्मै कथयामासुर्वयं ते पितरः स्वकाः।\nगर्तमेतमनुप्राप्ता लम्बामः प्रसवार्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021974, "chapter_id": 1456, "verse_number": "३-९४-१७", "content_sanskrit": "यदि नो जनयेथास्त्वमगस्त्यापत्यमुत्तमम्।\nस्यान्नोस्मान्निरयान्मोक्षस्त्वं च पुत्राप्नुया गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021975, "chapter_id": 1456, "verse_number": "३-९४-१८", "content_sanskrit": "स तानुवाच तेजस्वी सत्यधर्मपरायणः।\nकरिष्ये पितरः कामं व्येतु वो मानसो ज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021976, "chapter_id": 1456, "verse_number": "३-९४-१९", "content_sanskrit": "ततः प्रसवसन्तानं चिन्तयन्भगवानृषिः।\nआत्मनः प्रसवस्यार्थे नापश्यत्सदृशीं स्त्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021977, "chapter_id": 1456, "verse_number": "३-९४-२०", "content_sanskrit": "स तस्य तस् सत्वस्य तत्तदङ्गमनुत्तमम्।\nसंगृह्यतत्समैरङ्गैर्निर्ममे स्त्रियमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021978, "chapter_id": 1456, "verse_number": "३-९४-२१", "content_sanskrit": "स तां विदर्भराजाय पुत्रकामाय ताम्यते।\nनिर्मितामात्मनोऽर्थाय मुनिः प्रादान्महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021979, "chapter_id": 1456, "verse_number": "३-९४-२२", "content_sanskrit": "सा तत्र जज्ञे सुभगा विद्युत्सौदामनी यथा।\nविभ्राजमाना वपुषा व्यवर्धत शुभानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021980, "chapter_id": 1456, "verse_number": "३-९४-२३", "content_sanskrit": "जातमात्रां च तां दृष्ट्वा वैदर्भः पृथिवीपतिः।\nप्रहर्षेण द्विजातिभ्यो न्यवेदयत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021981, "chapter_id": 1456, "verse_number": "३-९४-२४", "content_sanskrit": "अभ्यनन्दन्त तां सर्वे ब्राह्मणा वसुधाधिप।\nलोपामुद्रेति तस्याश्च चक्रिरे नाम ते द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021982, "chapter_id": 1456, "verse_number": "३-९४-२५", "content_sanskrit": "ववृधे सा महाराज बिभ्रती रूपमुत्तमम्।\nअप्स्विवोत्पलिनी शीघ्रमग्नेरिव शिखा शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021983, "chapter_id": 1456, "verse_number": "३-९४-२६", "content_sanskrit": "तां यौवनस्थां राजेन्द्रशतं कन्याः स्वलंकृताः।\nदास्यः शतं च कल्याणीमुपातस्थुर्वशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021984, "chapter_id": 1456, "verse_number": "३-९४-२७", "content_sanskrit": "सा स्म दासीशतवृता मध्ये कन्याशतस्य च।\nआरस्ते तेजस्विनी कन्या रोहिणीव दिविप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021985, "chapter_id": 1456, "verse_number": "३-९४-२८", "content_sanskrit": "यौवनस्थामपि च तां शीलाचारसमन्विताम्।\nन वव्रे पुरुषः कश्चिद्भयात्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021986, "chapter_id": 1456, "verse_number": "३-९४-२९", "content_sanskrit": "सा तु सत्यवती कन्या रूपेणाप्सरसोप्यति।\nतोषयामास पितरं शीलेन स्वजनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021987, "chapter_id": 1456, "verse_number": "३-९४-३०", "content_sanskrit": "वैदर्भी तु तथायुक्तां युवतीं प्रेक्ष्य वै पिता।\nमनसा चिन्तयामास कस्मै दद्यामिमांसुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2021988, "chapter_id": 1456, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि चतुर्नवतितमोऽध्यायः ॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]