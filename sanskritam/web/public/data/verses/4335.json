[{"id": 2153748, "chapter_id": 4335, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2153749, "chapter_id": 4335, "verse_number": "१", "content_sanskrit": "अकरोत् तुमुलं युद्धं भीष्मः शान्तनवस्तदा ।\nभीमसेनभयादिच्छन् पुत्रांस्तारयितुं तव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2153750, "chapter_id": 4335, "verse_number": "२", "content_sanskrit": "पूर्वाह्णे तन्महारौद्रं राज्ञां युद्धमवर्तत ।\nकुरूणां पाण्डवानां च मुख्यशूरविनाशनम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2153751, "chapter_id": 4335, "verse_number": "३", "content_sanskrit": "तस्मिन्नाकुलसङ्ग्रामे वर्तमाने महाभये ।\nअभवत् तुमुलः शब्दः संस्पृशन् गगनं महत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2153752, "chapter_id": 4335, "verse_number": "४", "content_sanskrit": "नदद्भिश्च महानागैर्हेषमाणैश्च वाजिभिः ।\nभेरीशङ्खनिनादैश्च तुमुलः समपद्यत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2153753, "chapter_id": 4335, "verse_number": "५", "content_sanskrit": "युयुत्सवस्ते विक्रान्ता विजयाय महाबलाः ।\nअन्योन्यमभिगर्जन्तो गोष्ठेष्विव महर्षभाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2153754, "chapter_id": 4335, "verse_number": "६", "content_sanskrit": "शिरसां पात्यमानानां समरे निशितैः शरैः ।\nअश्मवृष्टिरिवाकाशे बभूव भरतर्षभ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2153755, "chapter_id": 4335, "verse_number": "७", "content_sanskrit": "कुण्डलोष्णीषधारीणि जातरूपोज्ज्वलानि च ।\nपतितानि स्म दृश्यन्ते शिरांसि भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2153756, "chapter_id": 4335, "verse_number": "८", "content_sanskrit": "विशिखोन्मथितैर्गात्रैर्बाहुभिश्च सकार्मुकैः ।\nसहस्ताभरणैश्चान्यैरभवच्छादिता मही\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2153757, "chapter_id": 4335, "verse_number": "९", "content_sanskrit": "कवचोपहितैर्गात्रैर्हस्तैश्च समलङ्कृतैः ।\nमुखैश्च चन्द्रसङ्काशै रक्तान्तनयनैः शुभैः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2153758, "chapter_id": 4335, "verse_number": "१०", "content_sanskrit": "गजवाजिमनुष्याणां सर्वगात्रैश्च भूपते ।\nआसीत् सर्वा समाकीर्णा मुहूर्तेन वसुन्धरा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2153759, "chapter_id": 4335, "verse_number": "११", "content_sanskrit": "रजोमेघैश्च तुमुलैः शस्त्रविद्युत्प्रकाशितैः ।\nआयुधानां च निर्घोषः स्तनयित्नुसमोऽभवत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2153760, "chapter_id": 4335, "verse_number": "१२", "content_sanskrit": "स सम्प्रहारस्तुमुलः कटुकः शोणितोदकः ।\nप्रावर्तत कुरूणां च पाण्डवानां च भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2153761, "chapter_id": 4335, "verse_number": "१३", "content_sanskrit": "तस्मिन् महाभये घोरे तुमुले लोमहर्षणे ।\nववर्षुः शरवर्षाणि क्षत्रिया युद्धदुर्मदाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2153762, "chapter_id": 4335, "verse_number": "१४", "content_sanskrit": "क्रोशन्ति कुञ्जरास्तत्र शरवर्षप्रतापिताः ।\nतावकानां परेषां च संयुगे भरतोत्तम \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2153763, "chapter_id": 4335, "verse_number": "१५", "content_sanskrit": "संरब्धानां च वीराणां धीराणाममितौजसाम् ।\nधनुर्ज्यातलशब्देन न प्राज्ञायत किञ्चन \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2153764, "chapter_id": 4335, "verse_number": "१६", "content_sanskrit": "उत्थितेषु कबन्धेषु सर्वतः शोणितोदके ।\nसमरे पर्यधावन्त नृपा रिपुवधोद्यताः ।\nशरशक्तिगदाभिस्ते खड्गैश्चामिततेजसः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2153765, "chapter_id": 4335, "verse_number": "१७", "content_sanskrit": "निजघ्नुः समरे शूरास्तेऽन्योन्यं च परन्तप ।\nबभ्रमुः कुञ्जराश्चात्र शरैर्विद्धा निरङ्कुशाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2153766, "chapter_id": 4335, "verse_number": "१८", "content_sanskrit": "अश्वाश्च पर्यधावन्त हतारोहा दिशो दश\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2153767, "chapter_id": 4335, "verse_number": "१९", "content_sanskrit": "उत्पत्य निपतन्त्यन्ये शरघातप्रपीडिताः ।\nतावकानां परेषां च योधानां भरतर्षभ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2153768, "chapter_id": 4335, "verse_number": "२०", "content_sanskrit": "बाहूनामुत्तमाङ्गानां कार्मुकाणां तथैव च ।\nगदानां परिघाणां च हस्तानां चोरुभिः सह \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2153769, "chapter_id": 4335, "verse_number": "२१", "content_sanskrit": "पादानां भूषणानां च केयूराणां च सङ्घशः ।\nराशयः स्म प्रदृश्यन्ते भीष्मभीमपराक्रमे \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2153770, "chapter_id": 4335, "verse_number": "२२", "content_sanskrit": "अश्वानां कुञ्जराणां च रथानां चातिवर्तताम् ।\nसङ्घाताः स्म प्रदृश्यन्ते तत्र तत्र विशाम्पते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2153771, "chapter_id": 4335, "verse_number": "२३", "content_sanskrit": "गदाभिरसिभिः प्रासैर्बाणैश्च नतपर्वभिः ।\nजघ्नुः परस्परं तत्र क्षत्रियाः कालचोदिताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2153772, "chapter_id": 4335, "verse_number": "२४", "content_sanskrit": "अपरे बाहुभिर्वीरा नियुद्धकुशला युधि ।\nबहुधा समसज्जन्त आयसैः परिघैरिव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2153773, "chapter_id": 4335, "verse_number": "२५", "content_sanskrit": "मुष्टिभिर्जानुभिश्चैव तळैश्चैव विशाम्पते ।\nअन्योन्यं जघ्निरे वीरास्तावकाः पाण्डवैः सह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2153774, "chapter_id": 4335, "verse_number": "२६", "content_sanskrit": "पतितैः पात्यमानैश्च विचेष्टद्भिश्च भूतळे ।\nघोरमायोधनं जज्ञे तत्रतत्र जनेश्वर \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2153775, "chapter_id": 4335, "verse_number": "२७", "content_sanskrit": "विरथा रथिनश्चात्र निस्त्रिंशवरधारिणः ।\nअन्योन्यमभिधावन्त परस्परवधैषिणः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2153776, "chapter_id": 4335, "verse_number": "२८", "content_sanskrit": "ततो दुर्योधनो राजा कळिङ्गैर्बहुभिर्वृतः ।\nपुरस्कृत्य रणे भीष्मं पाण्डवानभ्यवर्तत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2153777, "chapter_id": 4335, "verse_number": "२९", "content_sanskrit": "तथैव पाण्डवाः सर्वे परिवार्य वृकोदरम् ।\nभीष्ममभ्यद्रवन् क्रुद्धा रणे रभसवाहनाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2153778, "chapter_id": 4335, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि षट्षष्टितमोऽध्यायः ॥६६॥\n॥ इति भीष्मवधपर्वणि षड्विंशोऽध्यायः ॥२६॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]