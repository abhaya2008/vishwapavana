[{"id": 2173849, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173850, "chapter_id": 4697, "verse_number": "१", "content_sanskrit": "तस्मिन् शब्दे मुदौ जाते पाण्डवैर्निहते बले ।\nअश्वैः सप्तशतैः शिष्टैः उपावर्तत सौबलः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173851, "chapter_id": 4697, "verse_number": "२", "content_sanskrit": "स गत्वा वाहिनीं तूर्णं चोदयानः स्वकान् युधि ।\nयुध्यध्वमिति संहृष्टः पुनः पुनररिन्दमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173852, "chapter_id": 4697, "verse_number": "३", "content_sanskrit": "अपृच्छत् क्षत्रियांश्चात्र क्व स राजा सुयोधनः ।\nशकुनेस्तु वचः श्रुत्वा त ऊचुर्भरतर्षभ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173853, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "सैनिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173854, "chapter_id": 4697, "verse_number": "४", "content_sanskrit": "असौ तिष्ठति कौरव्यो रणमध्ये महारथः ।\nयत्रैतत् सुमहच्छत्रं पूर्णचन्द्रसमप्रभम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173855, "chapter_id": 4697, "verse_number": "५", "content_sanskrit": "यत्रैते सतलत्राणा रथास्तिष्ठन्ति दंसिताः ।\nयत्रैष शब्दस्तुमुलः पर्जन्यनिनदोपमः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173856, "chapter_id": 4697, "verse_number": "६", "content_sanskrit": "तत्र गच्छ द्रुतं राजन् ततो द्रक्ष्यसि कौरवम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173857, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173858, "chapter_id": 4697, "verse_number": "७", "content_sanskrit": "एवमुक्तस्तु तैः शूरैः शकुनिः सौबलस्तदा ।\nप्रययौ तत्र यत्रासौ पुत्रस्तव जनाधिप\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173859, "chapter_id": 4697, "verse_number": "८", "content_sanskrit": "सर्वतः संवृतो वीरैः समरेष्वनिवर्तिभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173860, "chapter_id": 4697, "verse_number": "९", "content_sanskrit": "ततो दुर्योधनं दृष्ट्वा रथानीके व्यवस्थितम् ।\nसरथांस्तावकान् सर्वान् हर्षयन् शकुनिस्ततः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173861, "chapter_id": 4697, "verse_number": "१०", "content_sanskrit": "दुर्योधनमिदं वाक्यं हृष्टरूपो विशाम्पते ।\nकृतकार्यमिवात्मानं मन्यमानोऽब्रवीन्नृपम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173862, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173863, "chapter_id": 4697, "verse_number": "११", "content_sanskrit": "जहि राजन् रथानीकमश्वाः सर्वे हता मया ।\nनात्यक्त्वा जीवितं सङ्खे शक्यो जेतुं युधिष्ठिरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173864, "chapter_id": 4697, "verse_number": "१२", "content_sanskrit": "हते तस्मिन् रथानीके पाण्डवेनाभिपालिते ।\nगजानेतान् हनिष्यामः पदातींश्चेतरान् बहून्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173865, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173866, "chapter_id": 4697, "verse_number": "१३", "content_sanskrit": "श्रुत्वा तु वचनं तस्य तावका जयगृध्नवः ।\nजवेनाभ्यपतन् हृष्टाः पाण्डवानामनीकिनीम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173867, "chapter_id": 4697, "verse_number": "१४", "content_sanskrit": "बद्धनिस्त्रिंशतूणीराः प्रगृहीतशरासनाः ।\nशरासनानि धून्वानाः सिंहनादान् प्रचक्रिरे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173868, "chapter_id": 4697, "verse_number": "१५", "content_sanskrit": "ततो ज्यातळनिर्घोषः पुनरासीद् विशाम्पते ।\nप्रादुरासीत् शराणां च प्रमुक्तानां सुदारुणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173869, "chapter_id": 4697, "verse_number": "१६", "content_sanskrit": "तान् समीपगतान् दृष्ट्वा जवेनोद्यतकार्मुकान् ।\nउवाच देवकीपुत्रं कुन्तीपुत्रो धनञ्जयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173870, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173871, "chapter_id": 4697, "verse_number": "१७", "content_sanskrit": "चोदयाश्वानसम्भ्रान्तः प्रविशैतद् बलार्णवम् ।\nअन्तमद्य गमिष्यामि शत्रूणां निशितैः शरैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173872, "chapter_id": 4697, "verse_number": "१८", "content_sanskrit": "अष्टादश दिनान्यद्य युद्धस्यास्य जनार्दन ।\nवर्तमानस्य महतः समासाद्य परस्परम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173873, "chapter_id": 4697, "verse_number": "१९", "content_sanskrit": "अनन्तकल्पा ध्वजिनी हता ह्येषां महात्मनाम् ।\nक्षयमद्य गता युद्धे पश्य दैवं यथाविधम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173874, "chapter_id": 4697, "verse_number": "२०", "content_sanskrit": "समुद्रकल्पं तु बलं धार्तराष्ट्रस्य माधव ।\nअस्मानासाद्य सञ्जातं गोष्पदोपममच्युत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173875, "chapter_id": 4697, "verse_number": "२१", "content_sanskrit": "हते भीष्मे तु सन्दध्यात् शिवं स्यादिति माधव ।\nन च तत् कृतवान् मूढो धार्तराष्ट्रः सुबालिशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173876, "chapter_id": 4697, "verse_number": "२२", "content_sanskrit": "उक्तं भीष्मेण यद्वाक्यं हितं पथ्यं च माधव ।\nतच्चापि नासौ कृतवान् हीनबुद्धिः सुयोधनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173877, "chapter_id": 4697, "verse_number": "२३", "content_sanskrit": "तस्मिंस्तु निहते भीष्मे प्रच्युते पृथिवीपतौ ।\nन जाने कारणं किन्नु येन युद्धमवर्तत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173878, "chapter_id": 4697, "verse_number": "२४", "content_sanskrit": "मूढांस्तु सर्वथा मन्ये धार्तराष्ट्रान् सुबालिशान् ।\nपतिते शन्तनोः पुत्रे येऽकार्षुः सङ्गरं पुनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173879, "chapter_id": 4697, "verse_number": "२५", "content_sanskrit": "अनन्तरं च निहते द्रोणे ब्रह्मविदां वरे ।\nराधेये च विकर्णे च नैव शाम्यति वैशसम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173880, "chapter_id": 4697, "verse_number": "२६", "content_sanskrit": "अल्पावशिष्टे सैन्येऽस्मिन् सूतपुत्रे निपातिते ।\nसहपुत्रे नरव्याघ्रे नैव शाम्यति वैशसम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173881, "chapter_id": 4697, "verse_number": "२७", "content_sanskrit": "भूरिश्रवसि शल्ये च साल्वे चैव जनार्दन ।\nआवन्त्येषु च शूरेषु नैव शाम्यति वैशसम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173882, "chapter_id": 4697, "verse_number": "२८", "content_sanskrit": "भगदत्ते हते शूरे काम्भोजे च सुदक्षिणे ।\nदुःशासने च निहते नैव शाम्यति वैशसम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173883, "chapter_id": 4697, "verse_number": "२९", "content_sanskrit": "दृष्ट्वा च निहतान् शूरान् परान् मण्डलिकान् नृपान् ।\nबलिनश्च रणे कृष्ण नैव शाम्यति वैशसम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173884, "chapter_id": 4697, "verse_number": "३०", "content_sanskrit": "अक्षोहिणीं हतां दृष्ट्वा भीमसेनेन संयुगे ।\nमोहाद्वा यदि वा लोभान्नैव शाम्यति वैशसम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173885, "chapter_id": 4697, "verse_number": "३१", "content_sanskrit": "को नु राजा कुले जातः कौरवेयो विशेषतः ।\nनिरर्थकं महद्वैरं कुर्यादन्यः सुयोधनात्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173886, "chapter_id": 4697, "verse_number": "३२", "content_sanskrit": "गुणतोऽभ्यधिकान् श्रुत्वा बलतः शौर्यतोऽपि वा ।\nअमूढः को नु युद्ध्येत जानन् प्राज्ञो हिताहितम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173887, "chapter_id": 4697, "verse_number": "३३", "content_sanskrit": "यत्तु(यत्र) तस्य मनो ह्यासीत् त्वयोक्तस्य हितं वचः ।\nप्रशमे पाण्डवैः सार्धं सोऽन्यस्य शृणुयात् कथम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173888, "chapter_id": 4697, "verse_number": "३४", "content_sanskrit": "येन शान्तनवो भीष्मो द्रोणो विदुर एव च ।\nप्रत्याख्याताः शमस्यार्थे किन्नु तस्यास्ति भेषजम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173889, "chapter_id": 4697, "verse_number": "३५", "content_sanskrit": "मोहाद्येन पिता वृद्धः प्रत्याख्यातो जनार्दन ।\nतथा माता हितं वाक्यं भाषमाणा हितैषिणी\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173890, "chapter_id": 4697, "verse_number": "३६", "content_sanskrit": "प्रत्याख्याता ह्यसत्कृत्य कस्माद् रोचयते वचः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173891, "chapter_id": 4697, "verse_number": "३७", "content_sanskrit": "कुलान्तकरणो व्यक्तं जात एष जनार्दन ।\nयथाऽस्य दृश्यते चेष्टा नीतिश्चैव विशाम्पते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173892, "chapter_id": 4697, "verse_number": "३८", "content_sanskrit": "नैष दास्यति नो राज्यमिति मे मतिरच्युत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173893, "chapter_id": 4697, "verse_number": "३९", "content_sanskrit": "उक्तो हि बहुशस्तात विदुरेण महात्मना ।\nन जीवन् दास्यते भागं धार्तराष्ट्रः कथञ्चन\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173894, "chapter_id": 4697, "verse_number": "४०", "content_sanskrit": "यावत् प्राणा धरिष्यन्ति धार्तराष्ट्रोऽपि मानद ।\nतावद्युष्मास्वपापेषु प्रकरिष्यन्ति पापकम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173895, "chapter_id": 4697, "verse_number": "४१", "content_sanskrit": "न च शक्योऽन्यथा जेतुम् ऋते युद्धेन माधव ।\nइत्यब्रवीत् सदा मां हि विदुरः सत्यदर्शनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173896, "chapter_id": 4697, "verse_number": "४२", "content_sanskrit": "तत् सर्वमद्य जानामि व्यवसायं दुरात्मनः ।\nयदुक्तं वचनं तेन विदुरेण महात्मना\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173897, "chapter_id": 4697, "verse_number": "४३", "content_sanskrit": "यो हि श्रुत्वा वचः पथ्यं धार्तराष्ट्रो यथातथम् ।\nनाकरोद् विदुरस्यातो ध्रुवं नाश उपस्थितः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173898, "chapter_id": 4697, "verse_number": "४४", "content_sanskrit": "उक्तं हि बहुभिः सिद्धैर्जातमात्रे सुयोधने ।\nएनं प्राप्य दुरात्मानं क्षयं क्षत्रं गमिष्यति\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173899, "chapter_id": 4697, "verse_number": "४५", "content_sanskrit": "तदिदं वचनं तेषां सत्करिष्यामि माधव\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173900, "chapter_id": 4697, "verse_number": "४६", "content_sanskrit": "क्षत्रियेषु हतेष्वाशु शून्ये च शिबिरे कृते ।\nवधाय चात्मनोऽस्माभिः संयुगं रोचयिष्यति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173901, "chapter_id": 4697, "verse_number": "४७", "content_sanskrit": "तदन्तं हि भवेद् वैरमनुमानेन माधव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173902, "chapter_id": 4697, "verse_number": "४८", "content_sanskrit": "एवं पश्यामि वार्ष्णेय चिन्तयन् प्रज्ञया स्वयम् ।\nविदुरस्य च वाक्येन चेष्टया च दुरात्मनः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173903, "chapter_id": 4697, "verse_number": "४९", "content_sanskrit": "तस्माद् याहि चमूं वीर यावद्धन्मि शितैः शरैः ।\nदुर्योधनं दुरात्मानं वाहिनीं चास्य संयुगे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173904, "chapter_id": 4697, "verse_number": "५०", "content_sanskrit": "क्षेममद्य करिष्यामि धर्मराजस्य माधव ।\nहत्वेतद् दुर्बलं सैन्यं धार्तराष्ट्रस्य पश्यतः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173905, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173906, "chapter_id": 4697, "verse_number": "५१", "content_sanskrit": "अभीशुहस्तो दाशार्हस्तथोक्तः सव्यसाचिना ।\nतं बलौघममित्राणां तूर्णं सम्प्राविशद् रणे\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2173907, "chapter_id": 4697, "verse_number": "५२", "content_sanskrit": "शरासनवरं घोरं शक्तिकण्टकसंवृतम् ।\nगदापरिघपाषाणं रथनागमहाद्रुमम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2173908, "chapter_id": 4697, "verse_number": "५३", "content_sanskrit": "हयपत्तिसमाकीर्णं गाहमानो महायशाः ।\nव्यचरत् तत्र गोविन्दः स्वरथेनाशुपातिना\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2173909, "chapter_id": 4697, "verse_number": "५४", "content_sanskrit": "ते हयाः पाण्डरा राजन् वहन्तोऽर्जुनमाहवे ।\nदिक्षु सर्वास्वदृश्यन्त दाशार्हेण प्रचोदिताः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2173910, "chapter_id": 4697, "verse_number": "५५", "content_sanskrit": "ततः प्रायाद् रथेनाजौ सव्यसाची परन्तपः ।\nकिरन् शरशतांस्तीक्ष्णान् वारिधारा इवाम्बुदः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2173911, "chapter_id": 4697, "verse_number": "५६", "content_sanskrit": "प्रादुरासीन्महाशब्दः शराणां नतपर्वणाम् ।\nइषुभिश्छाद्यमानानां सङ्ग्रामे सव्यसाचिना\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2173912, "chapter_id": 4697, "verse_number": "५७", "content_sanskrit": "असज्जन्तस्तनुत्रेषु शरौघाः प्रापतन् भुवि ।\nइन्द्राशनिसमस्पर्शा गाण्डीवप्रेषिताः शराः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2173913, "chapter_id": 4697, "verse_number": "५८", "content_sanskrit": "नरान् नागान् समाहत्य हयांश्चापि विशाम्पते ।\nअपतंस्तु रणे बाणाः पतङ्गा इव घोषिणः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2173914, "chapter_id": 4697, "verse_number": "५९", "content_sanskrit": "आसीत् सर्वमवच्छन्नं गाण्डीवप्रेषितैः शरैः ।\nन प्राज्ञायन्त सङ्ग्रामे दिशो वा प्रदिशोऽपि वा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2173915, "chapter_id": 4697, "verse_number": "६०", "content_sanskrit": "सर्वमासीज्जगत् पूर्णं पार्थनामाङ्कितैः शरैः ।\nरुग्मपुङ्खैः शितैर्बाणैः कर्मारपरिमार्जितैः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2173916, "chapter_id": 4697, "verse_number": "६१", "content_sanskrit": "ते दह्यमानाः पार्थेन पावकेनेव कुञ्जराः ।\nसमासीदंस्तु कौरव्या वध्यमानाः शितैः शरैः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2173917, "chapter_id": 4697, "verse_number": "६२", "content_sanskrit": "शरचापधरः पार्थः प्रज्वलन्निव भारत ।\nददाह समरे योधान् कक्षमग्निरिव ज्वलन्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2173918, "chapter_id": 4697, "verse_number": "६३", "content_sanskrit": "यथा वनान्ते वनजैर्विसृष्टः\nकक्षं दहेत् कृष्णगतिः सुघोरः ।\nभूरिद्रुमं शुष्कलताप्रतानं\nभृशं समिद्धो ज्वलनः प्रतापी\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2173919, "chapter_id": 4697, "verse_number": "६४", "content_sanskrit": "एवं स नाराचगणप्रतापी\nशराग्निरुच्चावचतिग्मतेजाः ।\nददाह सर्वां तव पुत्रसेनाम्\nअमृष्यमाणस्तरसा तरस्वी\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2173920, "chapter_id": 4697, "verse_number": "६५", "content_sanskrit": "तस्येषवः प्राणहराः सुमुक्ता\nन सज्जन्ते वर्मसु रुग्मपङ्खाः ।\nन च द्वितीयं प्रमुमोच काण्डम्\nनरे हये वाऽपि रथे द्विपे वा\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2173921, "chapter_id": 4697, "verse_number": "६६", "content_sanskrit": "अनेकरूपाकृतिभिश्च बाणैः\nमहारथानीकमनुप्रविश्य ।\nस एवमेकं तव पुत्रसेनां\nजघान दैत्यानिव वज्रपाणिः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2173922, "chapter_id": 4697, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2173923, "chapter_id": 4697, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि चतुर्विंशोऽध्यायः ॥२४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]