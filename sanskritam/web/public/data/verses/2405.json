[{"id": 2066607, "chapter_id": 2405, "verse_number": "९-२३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066608, "chapter_id": 2405, "verse_number": "९-२३-१", "content_sanskrit": "अल्पावशिष्टे सैन्ये तु पाण्डवैर्निहते बले।\nअश्वैः सप्तसहस्रैस्तु उपावर्तत सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066609, "chapter_id": 2405, "verse_number": "९-२३-२", "content_sanskrit": "स यात्वा वाहिनीं तूर्णं चोदयानः स्वकान्युधि।\nयुध्यध्वमिति संहृष्टाः पुनःपुनररिन्दमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066610, "chapter_id": 2405, "verse_number": "९-२३-३", "content_sanskrit": "अपृच्छत्क्षत्रियांस्तत्र क्व नु राजा महाबलः।\nशकुनेस्तद्वचः श्रुत्वा तमूचुर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066611, "chapter_id": 2405, "verse_number": "९-२३-४", "content_sanskrit": "असौ तिष्ठति कौरव्यो रणमध्ये महाबलः।\nयत्रैतत्सुमहच्छत्रं पूर्णचन्द्रसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066612, "chapter_id": 2405, "verse_number": "९-२३-५", "content_sanskrit": "यत्र ते सतनुत्राणा रथास्तिष्ठन्ति दंशिताः।\nयत्रैष तुमुलः शब्दः पर्जन्यनिनदोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066613, "chapter_id": 2405, "verse_number": "९-२३-६", "content_sanskrit": "तत्र गच्छ द्रुतं राजंस्ततो द्रक्ष्यसि कौरवम्।\nएवमुक्तस्तु तैर्योधैः शकुनिः सौबलस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066614, "chapter_id": 2405, "verse_number": "९-२३-७", "content_sanskrit": "प्रययौ तत्र यत्रास्ते पुत्रस्तव नराधिप।\nसर्वतः संवृतो वीरैः समरे चित्रयोधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066615, "chapter_id": 2405, "verse_number": "९-२३-८", "content_sanskrit": "ततो दुर्योधनं दृष्ट्वा रथानीके व्यवस्थितम्।\nस रथांस्तावकान्सर्वान्हर्षयञ्शकुनिस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066616, "chapter_id": 2405, "verse_number": "९-२३-९", "content_sanskrit": "दुर्योधनमिदं वाक्यं हृष्टरूपो विशाम्पते।\nकृतकार्यमिवात्मानं मन्यमानोऽब्रवीन्नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066617, "chapter_id": 2405, "verse_number": "९-२३-१०", "content_sanskrit": "जहि राजन्रथानीकमश्वाः सर्वे जिता मया।\nनात्यक्त्वा जीवितं सङ्ख्ये शक्यो जेतुं युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066618, "chapter_id": 2405, "verse_number": "९-२३-११", "content_sanskrit": "हते तस्मिन्रथानीके पाण्डवेनाभिपालिते।\nगजानेतान्हनिष्यामः पदातींश्चेतरांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066619, "chapter_id": 2405, "verse_number": "९-२३-१२", "content_sanskrit": "श्रुत्वा तु वचनं तस्य तावका जयगृद्विनः।\nजवेनाभ्यपतन्हृष्टाः पाण्डवानामनीकिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066620, "chapter_id": 2405, "verse_number": "९-२३-१३", "content_sanskrit": "बद्वनिस्त्रिंशहस्ताश्च प्रगृहीतशरासनाः।\nशरासनानि धून्वानाः सिंहनादान्प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066621, "chapter_id": 2405, "verse_number": "९-२३-१४", "content_sanskrit": "ततो ज्यातलनिर्धोषः पुनरासीद्विशाम्पते।\nप्रादुरासीच्छराणां च सुमुक्तानां सुदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066622, "chapter_id": 2405, "verse_number": "९-२३-१५", "content_sanskrit": "तान्समीपगतान्दृष्ट्वा जनानुद्यतकार्मुकान्।\nउवाच देवकीपुत्रं कुन्तीपुत्रो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066623, "chapter_id": 2405, "verse_number": "९-२३-१६", "content_sanskrit": "चोदयाश्वानसम्भ्रान्तः प्रविशैतद्बलार्णवम्।\nअन्तमद्य गमिष्यामि शत्रूणां निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066624, "chapter_id": 2405, "verse_number": "९-२३-१७", "content_sanskrit": "अष्टादश दिनान्यद्य युद्धस्यास्य जनार्दन।\nवर्तमानस्य महतः समासाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066625, "chapter_id": 2405, "verse_number": "९-२३-१८", "content_sanskrit": "अनन्तकल्पा ध्वजिनी भूत्वा ह्येषां महात्मनाम्।\nक्षयमद्य गता युद्धे पश्य दैवं यथाविधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066626, "chapter_id": 2405, "verse_number": "९-२३-१९", "content_sanskrit": "समुद्रकल्पं च बलं धार्तराष्ट्रस्य माधव।\nअस्मनासाद्य सञ्जातं गोष्पदोपममच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066627, "chapter_id": 2405, "verse_number": "९-२३-२०", "content_sanskrit": "हते भीष्मे धीर्ममासीच्छमः स्यादिति माधव।\nन च तत्कृतवान्मूढो धार्तराष्ट्रः सुबालिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066628, "chapter_id": 2405, "verse_number": "९-२३-२१", "content_sanskrit": "उक्तं भीष्मेण यद्वाक्यं हितं तथ्यं च माधव।\nतच्चापि नासौ कृतवान्वीतबुद्धिः सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066629, "chapter_id": 2405, "verse_number": "९-२३-२२", "content_sanskrit": "तस्मिंस्तु निहते भीष्मे प्रच्युते पृथिवीपतौ।\nन जाने कारणं किन्तु येन युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066630, "chapter_id": 2405, "verse_number": "९-२३-२३", "content_sanskrit": "मूढांस्तु सर्वथा मन्ये धार्तराष्ट्रान्सुबालिशान्।\nपतिते शन्तनोः पुत्रे येऽकार्युः संयुगं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066631, "chapter_id": 2405, "verse_number": "९-२३-२४", "content_sanskrit": "अनन्तरं च निहते द्रोणे ब्रह्मविदां वरे।\nराधेये च विकर्णे च नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066632, "chapter_id": 2405, "verse_number": "९-२३-२५", "content_sanskrit": "अल्पावशिष्टे सैन्येऽस्मिन्सूतपुत्रे च पातिते।\nसपुत्रे वै नरव्याघ्रे नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066633, "chapter_id": 2405, "verse_number": "९-२३-२६", "content_sanskrit": "श्रुतायुषि हते वीरे जलसन्धे च मागधे।\nश्रुतायुधे च नृपतौ नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066634, "chapter_id": 2405, "verse_number": "९-२३-२७", "content_sanskrit": "भूरिश्रवसि शल्ये च साल्ये चैव जनार्दन।\nआवन्त्येषु च वीरेषु नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066635, "chapter_id": 2405, "verse_number": "९-२३-२८", "content_sanskrit": "जयद्रथे च निहते राक्षसे चाप्यलायुधे।\nबाह्लिके सोमदत्ते च नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066636, "chapter_id": 2405, "verse_number": "९-२३-२९", "content_sanskrit": "भगदत्ते हते शूरे काम्भोजे च सुदारुणे।\nदुःशासने च निहते नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066637, "chapter_id": 2405, "verse_number": "९-२३-३०", "content_sanskrit": "दृष्ट्वा विनिहताञ्शूरान्पृथङ्माण़्डलिकान्नृपान्।\nबलिनश्च रणे कृष्ण नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066638, "chapter_id": 2405, "verse_number": "९-२३-३१", "content_sanskrit": "अक्षौहिणीपतीन्दृष्ट्वा भीमसेननिपातितान्।\nमोहाद्वा यदि वा लोभान्नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066639, "chapter_id": 2405, "verse_number": "९-२३-३२", "content_sanskrit": "`हतप्रवीरां विध्वस्तां दृष्ट्वा चेमां चमूं रणे।\nअलम्बले च निहते नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066640, "chapter_id": 2405, "verse_number": "९-२३-३३", "content_sanskrit": "भ्रातॄन्विनिहतान्दृष्ट्वा वयस्यान्मातुलानपि।\nपुत्रान्विनिहतान्दृष्ट्वा नैव शाम्यति वैशसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066641, "chapter_id": 2405, "verse_number": "९-२३-३४", "content_sanskrit": "को नु राजकुले जातः कौरवेषु विशेषतः।\nनिरर्थकं महद्वैरं कुर्यादन्यः सुयोधनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066642, "chapter_id": 2405, "verse_number": "९-२३-३५", "content_sanskrit": "गुणतोऽभ्यधिकाञ्ज्ञात्वा बलतः शौर्यतोपि वा।\nअमूढः को नु युध्येत जानन्प्राज्ञो हिताहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066643, "chapter_id": 2405, "verse_number": "९-२३-३६", "content_sanskrit": "किन्नु तस्य मनो ह्यासीत्त्वयोक्तस्य हितं वचः।\nप्रशमे पाण्डवैः सार्धं सोन्यस्य शृणुयात्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066644, "chapter_id": 2405, "verse_number": "९-२३-३७", "content_sanskrit": "येन शान्तनवो भीष्मो द्रोणो विदुर एव च।\nप्रत्याख्याताः शंमस्यार्थे किन्नु तस्याद्य भेषजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066645, "chapter_id": 2405, "verse_number": "९-२३-३८", "content_sanskrit": "मौर्ख्याद्येन पिता वृद्वः प्रत्याख्यातो जनार्दन।\nतथा माता हितं वाक्यं भाषमाणा हितैषिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066646, "chapter_id": 2405, "verse_number": "९-२३-३९", "content_sanskrit": "प्रत्याख्याता ह्यसत्कृत्य स कस्मै रोचयेद्वचः।\nकुलान्तकरणो व्यक्तं जात एष जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066647, "chapter_id": 2405, "verse_number": "९-२३-४०", "content_sanskrit": "तथास्य दृश्यते चेष्टा नीतिश्चैव विशाम्पते।\nनैष दास्यति नो राज्यमिति मे मतिरच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066648, "chapter_id": 2405, "verse_number": "९-२३-४१", "content_sanskrit": "उक्तोऽहं बहुशस्तात विदुरेण महात्मना।\nन जीवन्दास्यते भागं धार्तराष्ट्रः सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066649, "chapter_id": 2405, "verse_number": "९-२३-४२", "content_sanskrit": "यावत्प्राणा धरिष्यन्ति धार्तराष्ट्रस्य दुर्मतेः।\nतावद्युष्मास्वपापेषु प्रचरिष्यति पापकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066650, "chapter_id": 2405, "verse_number": "९-२३-४३", "content_sanskrit": "न च युक्तोऽन्यथा जेतुमृते युद्धेन माधव।\nइत्यब्रवीत्सदा मां हि विदुरः सत्यदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066651, "chapter_id": 2405, "verse_number": "९-२३-४४", "content_sanskrit": "तत्सर्वमद्य जानामि व्यवसायं दुरात्मनः।\nयदुक्तं वचनं तेन विदुरेण महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066652, "chapter_id": 2405, "verse_number": "९-२३-४५", "content_sanskrit": "यो हि श्रुत्वा वचः पथ्यं जामदग्न्याद्यथातथम्।\nअवामन्यत दुर्बुद्धिर्ध्रुवं नाशमुखे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066653, "chapter_id": 2405, "verse_number": "९-२३-४६", "content_sanskrit": "उक्तं हि बहुभिः सिद्धैर्जातमात्रे सुयोधने।\nएनं प्राप्य दुरात्मानं क्षयं क्षत्रं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066654, "chapter_id": 2405, "verse_number": "९-२३-४७", "content_sanskrit": "तदिदं वचनं तेषां निरुक्तं वै जनार्दन।\nक्षयं याता हि राजानो दुर्योधनकृते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066655, "chapter_id": 2405, "verse_number": "९-२३-४८", "content_sanskrit": "सोऽद्य सर्वान्रणे योधान्निहनिष्यामि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066656, "chapter_id": 2405, "verse_number": "९-२३-४९", "content_sanskrit": "क्षत्रियेषु हतेष्वाशु शून्ये च शिबिरे कृते।\nवधाय चात्मनोऽस्माभिः संयुगं रोचयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066657, "chapter_id": 2405, "verse_number": "९-२३-५०", "content_sanskrit": "तदन्तं हि भवेद्वैरमनुमानेन माधव।\nएवं पश्यामि वार्ष्णेय चिन्तयन्प्रज्ञया स्वया।\nविदुरस्य च वाक्येन चेष्टया च दुरात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066658, "chapter_id": 2405, "verse_number": "९-२३-५१", "content_sanskrit": "तस्माद्याहि चमूं वीर यावद्वन्मि शितैः शरैः।\nदुर्योधनं महाबाहो वाहिनीं चास्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066659, "chapter_id": 2405, "verse_number": "९-२३-५२", "content_sanskrit": "क्षेममद्य करिष्यामि धर्मराजस्य माधव।\nहत्वैतद्दुर्बलं सैन्यं धार्तराष्ट्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066660, "chapter_id": 2405, "verse_number": "९-२३-५३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066661, "chapter_id": 2405, "verse_number": "९-२३-५३", "content_sanskrit": "अभीशुहस्तो दाशार्हस्तथोक्तः सव्यसाचिना।\nतद्बलौघममित्राणामभीतः प्राविशद्बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066662, "chapter_id": 2405, "verse_number": "९-२३-५४", "content_sanskrit": "शरासनवनं घोरं शक्तिकण्टकसङ्कुलम्।\nगदापरिघपाषाणं रथनागमहाद्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066663, "chapter_id": 2405, "verse_number": "९-२३-५५", "content_sanskrit": "हयपत्तिलताकीर्णं गाहमानो महायशाः।\nव्यचरत्तत्र गोविन्दो रथेनातिपताकिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066664, "chapter_id": 2405, "verse_number": "९-२३-५६", "content_sanskrit": "ते हयाः पाण्डुरा राजन्वहन्तोऽर्जुनमाहवे।\nदिक्षु सर्वास्वदृश्यन्त दाशार्हेण प्रचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066665, "chapter_id": 2405, "verse_number": "९-२३-५७", "content_sanskrit": "ततः प्रायाद्रथेनाजौ सव्यसाची परन्तपः।\nकिरञ्शरशतांस्तीक्ष्णान्वारिधारा घनो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2066666, "chapter_id": 2405, "verse_number": "९-२३-५८", "content_sanskrit": "प्रादुरासीन्महाञ्शब्दः शराणां नतपर्वणाम्।\nइषुभिश्छाद्यमानानां समरे सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2066667, "chapter_id": 2405, "verse_number": "९-२३-५९", "content_sanskrit": "असज्जन्तस्तनुत्रेषु शरौघाः प्रापतन्भुवि।\nइन्द्राशनिसमस्पर्शा गाण्डीवप्रेषिताः शराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2066668, "chapter_id": 2405, "verse_number": "९-२३-६०", "content_sanskrit": "नरान्नागान्समाहत्य हयांश्चापि विशाम्पते।\nअपतन्त रणे बाणाः पतङ्गा इव घोषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2066669, "chapter_id": 2405, "verse_number": "९-२३-६१", "content_sanskrit": "आसीत्सर्वमवच्छन्नं गाण्डीवप्रेषितैः शरैः।\nन प्राज्ञायन्त समरे दिशो वा प्रदिशोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2066670, "chapter_id": 2405, "verse_number": "९-२३-६२", "content_sanskrit": "सर्वमासीज्जगत्पूर्णं पार्थनामाङ्कितैः शरैः।\nरुक्मपुङ्खैस्तैलधौतैः कर्मारपरिमार्जितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2066671, "chapter_id": 2405, "verse_number": "९-२३-६३", "content_sanskrit": "ते दह्यमानाः पार्थेन पावकेनेव कुञ्जराः।\nपार्थं न प्राजहुर्घारा वध्यमानाः शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2066672, "chapter_id": 2405, "verse_number": "९-२३-६४", "content_sanskrit": "शरचापधरः पार्थः प्रज्वलन्निव भास्करः।\nददाह समरे योधान्कक्षमग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2066673, "chapter_id": 2405, "verse_number": "९-२३-६५", "content_sanskrit": "यथा वनान्ते वनपैर्विसृष्टः\nकक्षं दहेत्कृष्णगतिः सुघोषः।\nभूरिद्रुमं शुष्कलतावितानं\nभृशं समृद्धो ज्वलनः प्रतापी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2066674, "chapter_id": 2405, "verse_number": "९-२३-६६", "content_sanskrit": "एवं स नाराचगणम्प्रतापी\nशरार्चिरुच्चावचतिग्मतेजाः।\nददाह सर्वां तव पुत्रसेना--\nममृष्यमाणस्तरसा तरस्वी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2066675, "chapter_id": 2405, "verse_number": "९-२३-६७", "content_sanskrit": "तस्येषवः प्राणहराः सुमुक्ता\nनासज्जन्वै वर्मसु रुक्मपुङ्खाः।\nन च द्वितीयं प्रमुमोच बाणं\nनरे हये वा परमद्विपे वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2066676, "chapter_id": 2405, "verse_number": "९-२३-६८", "content_sanskrit": "अनेकरूपाकृतिभिर्हि बाणै--\nर्महारथानीकमनुप्रविश्य।\nस एव एकस्तव पुत्रस्य सेनां\nजघान दैत्यानिव वज्रपाणिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2066677, "chapter_id": 2405, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे त्रयोविंशोऽध्यायः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]