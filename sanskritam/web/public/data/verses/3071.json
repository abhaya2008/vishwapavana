[{"id": 2096650, "chapter_id": 3071, "verse_number": "१३-२०१-१", "content_sanskrit": "[युधिष्ठिर उवाच।\nश्रुतं मे भवतस्तात सत्यव्रतपराक्रम।\nदानधर्मेण महता ये प्राप्तास्त्रिदिवं नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096651, "chapter_id": 3071, "verse_number": "१३-२०१-२", "content_sanskrit": "इमांस्तु श्रोतुमिच्छामि ध्रमान्धर्मभृतांवर।\nदानं कतिविधं देयं किं तस्य च फलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096652, "chapter_id": 3071, "verse_number": "१३-२०१-३", "content_sanskrit": "कथं केभ्यस्च धर्म्यं च दानं दातव्यमिष्यते।\nकैः कारणैः कतिविधं श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096653, "chapter_id": 3071, "verse_number": "१३-२०१-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096654, "chapter_id": 3071, "verse_number": "१३-२०१-४", "content_sanskrit": "शृणु तत्त्वेन कौन्तेय दानं प्रति ममानघ।\nयथा दानं प्रदातव्यं सर्ववर्णेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096655, "chapter_id": 3071, "verse_number": "१३-२०१-५", "content_sanskrit": "धर्मादर्थाद्भयात्कामात्कारुण्यादिति भारत।\nदानं पञ्चविधं ज्ञेयं कारणैर्यैर्निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096656, "chapter_id": 3071, "verse_number": "१३-२०१-६", "content_sanskrit": "इह कीर्तिमवाप्नोति प्रेत्य चानुत्तमं सुखम्।\nइति दानं प्रदातव्यं ब्राह्मणेभ्योऽनसूयता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096657, "chapter_id": 3071, "verse_number": "१३-२०१-७", "content_sanskrit": "ददाति वा दास्यति वा मह्यं दत्तमनेन वा।\nइत्यर्तिभ्यो निशम्यैव सर्वं दातव्यमर्थिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096658, "chapter_id": 3071, "verse_number": "१३-२०१-८", "content_sanskrit": "नास्याहं न मदीयोऽयं पापं कुर्याद्विमानितः।\nइति दद्याद्भयादेव दृढं मूढाय पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096659, "chapter_id": 3071, "verse_number": "१३-२०१-९", "content_sanskrit": "प्रियो मे यं प्रियोऽस्याहमिति सम्प्रेक्ष्य बुद्धिमान्।\nवयस्यायैवमक्लिष्टं दानं दद्यादतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096660, "chapter_id": 3071, "verse_number": "१३-२०१-१०", "content_sanskrit": "दीनश्च याचते चायमल्पेनापि हि तुष्यति।\nइति दद्याद्दरिद्राय कारुण्यादिति सर्वथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096661, "chapter_id": 3071, "verse_number": "१३-२०१-११", "content_sanskrit": "इति पञ्चविधं दानं पुण्यकीर्तिविवर्धनम्।\nयथाशक्त्या प्रदातव्यमेवमाह प्रजापतिः॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096662, "chapter_id": 3071, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकाधिकद्विशततमोऽध्यायः॥ २०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]