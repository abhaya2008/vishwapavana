[{"id": 5000482000, "chapter_id": 9482, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000482001, "chapter_id": 9482, "verse_number": "६-७५-१", "content_sanskrit": "ततोऽब्रवीन्महातेजाः सुग्रीवो वानरेश्वरः।\nअर्थ्यं विज्ञापयंश्चापि हनूमन्तमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000482002, "chapter_id": 9482, "verse_number": "६-७५-२", "content_sanskrit": "यतो हतः कुम्भकर्णः कुमाराश्च निषूदिताः।\nनेदानीमुपनिर्हारं रावणो दातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000482003, "chapter_id": 9482, "verse_number": "६-७५-३", "content_sanskrit": "ये ये महाबलाः सन्ति लघवश्च प्लवंगमाः।\nलङ्कामभिपतन्त्वाशु गृह्योल्काः प्लवगर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000482004, "chapter_id": 9482, "verse_number": "६-७५-४", "content_sanskrit": "ततोऽस्तं गत आदित्ये रौद्रे तस्मिन् निशामुखे।\nलङ्कामभिमुखाः सोल्का जग्मुस्ते प्लवगर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000482005, "chapter_id": 9482, "verse_number": "६-७५-५", "content_sanskrit": "उल्काहस्तैर्हरिगणैः सर्वतः समभिद्रुताः।\nआरक्षस्था विरूपाक्षाः सहसा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000482006, "chapter_id": 9482, "verse_number": "६-७५-६", "content_sanskrit": "गोपुराट्टप्रतोलीषु चर्यासु विविधासु च।\nप्रासादेषु च संहृष्टाः ससृजुस्ते हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000482007, "chapter_id": 9482, "verse_number": "६-७५-७", "content_sanskrit": "तेषां गृहसहस्राणि ददाह हुतभुक् तदा।\nप्रासादाः पर्वताकाराः पतन्ति धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000482008, "chapter_id": 9482, "verse_number": "६-७५-८", "content_sanskrit": "अगुरुर्दह्यते तत्र परं चैव सुचन्दनम्।\nमौक्तिका मणयः स्निग्धा वज्रं चापि प्रवालकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000482009, "chapter_id": 9482, "verse_number": "६-७५-९", "content_sanskrit": "क्षौमं च दह्यते तत्र कौशेयं चापि शोभनम्।\nआविकं विविधं चौर्णं काञ्चनं भाण्डमायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000482010, "chapter_id": 9482, "verse_number": "६-७५-१०", "content_sanskrit": "नानाविकृतसंस्थानं वाजिभाण्डपरिच्छदम्।\nगजग्रैवेयकक्ष्याश्च रथभाण्डांश्च संस्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000482011, "chapter_id": 9482, "verse_number": "६-७५-११", "content_sanskrit": "तनुत्राणि च योधानां हस्त्यश्वानां च वर्म च।\nखड्गा धनूंषि ज्याबाणास्तोमराङ्कुशशक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000482012, "chapter_id": 9482, "verse_number": "६-७५-१२", "content_sanskrit": "रोमजं वालजं चर्म व्याघ्रजं चाण्डजं बहु।\nमुक्तामणिविचित्रांश्च प्रासादांश्च समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000482013, "chapter_id": 9482, "verse_number": "६-७५-१३", "content_sanskrit": "विविधानस्त्रसंघातानग्निर्दहति तत्र वै।\nनानाविधान् गृहांश्चित्रान् ददाह हुतभुक् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000482014, "chapter_id": 9482, "verse_number": "६-७५-१४", "content_sanskrit": "आवासान् राक्षसानां च सर्वेषां गृहगृध्नुनाम्।\nहेमचित्रतनुत्राणां स्रग्भाण्डाम्बरधारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000482015, "chapter_id": 9482, "verse_number": "६-७५-१५", "content_sanskrit": "सीधुपानचलाक्षाणां मदविह्वलगामिनाम्।\nकान्तालम्बितवस्त्राणां शत्रुसंजातमन्युनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000482016, "chapter_id": 9482, "verse_number": "६-७५-१६", "content_sanskrit": "गदाशूलासिहस्तानां खादतां पिबतामपि।\nशयनेषु महार्हेषु प्रसुप्तानां प्रियैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000482017, "chapter_id": 9482, "verse_number": "६-७५-१७", "content_sanskrit": "त्रस्तानां गच्छतां तूर्णं पुत्रानादाय सर्वतः।\nतेषां शतसहस्राणि तदा लङ्कानिवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000482018, "chapter_id": 9482, "verse_number": "६-७५-१८", "content_sanskrit": "अदहत् पावकस्तत्र जज्वाल च पुनः पुनः।\nसारवन्ति महार्हाणि गम्भीरगुणवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000482019, "chapter_id": 9482, "verse_number": "६-७५-१९", "content_sanskrit": "हेमचन्द्रार्धचन्द्राणि चन्द्रशालोन्नतानि च।\nतत्र चित्रगवाक्षाणि साधिष्ठानानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000482020, "chapter_id": 9482, "verse_number": "६-७५-२०", "content_sanskrit": "मणिविद्रुमचित्राणि स्पृशन्तीव दिवाकरम्।\nक्रौञ्चबर्हिणवीणानां भूषणानां च निःस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000482021, "chapter_id": 9482, "verse_number": "६-७५-२१", "content_sanskrit": "नादितान्यचलाभानि वेश्मान्यग्निर्ददाह सः।\nज्वलनेन परीतानि तोरणानि चकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000482022, "chapter_id": 9482, "verse_number": "६-७५-२२", "content_sanskrit": "विद्युद्भिरिव नद्धानि मेघजालानि घर्मगे।\nज्वलनेन परीतानि गृहाणि प्रचकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000482023, "chapter_id": 9482, "verse_number": "६-७५-२३", "content_sanskrit": "दावाग्निदीप्तानि यथा शिखराणि महागिरेः।\nविमानेषु प्रसुप्ताश्च दह्यमाना वराङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000482024, "chapter_id": 9482, "verse_number": "६-७५-२४", "content_sanskrit": "त्यक्ताभरणसंयोगा हाहेत्युच्चैर्विचुक्रुशुः।\nतत्र चाग्निपरीतानि निपेतुर्भवनान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000482025, "chapter_id": 9482, "verse_number": "६-७५-२५", "content_sanskrit": "वज्रिवज्रहतानीव शिखराणि महागिरेः।\nतानि निर्दह्यमानानि दूरतः प्रचकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000482026, "chapter_id": 9482, "verse_number": "६-७५-२६", "content_sanskrit": "हिमवच्छिखराणीव दह्यमानानि सर्वशः।\nहर्म्याग्रैर्दह्यमानैश्च ज्वालाप्रज्वलितैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000482027, "chapter_id": 9482, "verse_number": "६-७५-२७", "content_sanskrit": "रात्रौ सा दृश्यते लङ्का पुष्पितैरिव किंशुकैः।\nहस्त्यध्यक्षैर्गजैर्मुक्तैर्मुक्तैश्च तुरगैरपि।\nबभूव लङ्का लोकान्ते भ्रान्तग्राह इवार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000482028, "chapter_id": 9482, "verse_number": "६-७५-२८", "content_sanskrit": "अश्वं मुक्तं गजो दृष्ट्वा क्वचिद् भीतोऽपसर्पति।\nभीतो भीतं गजं दृष्ट्वा क्वचिदश्वो निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000482029, "chapter_id": 9482, "verse_number": "६-७५-२९", "content_sanskrit": "लङ्कायां दह्यमानायां शुशुभे च महोदधिः।\nछायासंसक्तसलिलो लोहितोद इवार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000482030, "chapter_id": 9482, "verse_number": "६-७५-३०", "content_sanskrit": "सा बभूव मुहूर्तेन हरिभिर्दीपिता पुरी।\nलोकस्यास्य क्षये घोरे प्रदीप्तेव वसुन्धरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000482031, "chapter_id": 9482, "verse_number": "६-७५-३१", "content_sanskrit": "नारीजनस्य धूमेन व्याप्तस्योच्चैर्विनेदुषः।\nस्वनो ज्वलनतप्तस्य शुश्रुवे शतयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000482032, "chapter_id": 9482, "verse_number": "६-७५-३२", "content_sanskrit": "प्रदग्धकायानपरान् राक्षसान् निर्गतान् बहिः।\nसहसा ह्युत्पतन्ति स्म हरयोऽथ युयुत्सवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000482033, "chapter_id": 9482, "verse_number": "६-७५-३३", "content_sanskrit": "उद‍्घुष्टं वानराणां च राक्षसानां च निःस्वनम्।\nदिशो दश समुद्रं च पृथिवीं च व्यनादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000482034, "chapter_id": 9482, "verse_number": "६-७५-३४", "content_sanskrit": "विशल्यौ च महात्मानौ तावुभौ रामलक्ष्मणौ।\nअसम्भ्रान्तौ जगृहतुस्ते उभे धनुषी वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000482035, "chapter_id": 9482, "verse_number": "६-७५-३५", "content_sanskrit": "ततो विस्फारयामास रामश्च धनुरुत्तमम्।\nबभूव तुमुलः शब्दो राक्षसानां भयावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000482036, "chapter_id": 9482, "verse_number": "६-७५-३६", "content_sanskrit": "अशोभत तदा रामो धनुर्विस्फारयन् महत्।\nभगवानिव संक्रुद्धो भवो वेदमयं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000482037, "chapter_id": 9482, "verse_number": "६-७५-३७", "content_sanskrit": "उद‍्घुष्टं वानराणां च राक्षसानां च निःस्वनम्।\nज्याशब्दस्तावुभौ शब्दावति रामस्य शुश्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000482038, "chapter_id": 9482, "verse_number": "६-७५-३८", "content_sanskrit": "वानरोद‍्घुष्टघोषश्च राक्षसानां च निःस्वनः।\nज्याशब्दश्चापि रामस्य त्रयं व्याप दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000482039, "chapter_id": 9482, "verse_number": "६-७५-३९", "content_sanskrit": "तस्य कार्मुकनिर्मुक्तैः शरैस्तत्पुरगोपुरम्।\nकैलासशृङ्गप्रतिमं विकीर्णमभवद् भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000482040, "chapter_id": 9482, "verse_number": "६-७५-४०", "content_sanskrit": "ततो रामशरान् दृष्ट्वा विमानेषु गृहेषु च।\nसंनाहो राक्षसेन्द्राणां तुमुलः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000482041, "chapter_id": 9482, "verse_number": "६-७५-४१", "content_sanskrit": "तेषां संनह्यमानानां सिंहनादं च कुर्वताम्।\nशर्वरी राक्षसेन्द्राणां रौद्रीव समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000482042, "chapter_id": 9482, "verse_number": "६-७५-४२", "content_sanskrit": "आदिष्टा वानरेन्द्रास्ते सुग्रीवेण महात्मना।\nआसन्नं द्वारमासाद्य युध्यध्वं च प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000482043, "chapter_id": 9482, "verse_number": "६-७५-४३", "content_sanskrit": "यश्च वो वितथं कुर्यात् तत्र तत्राप्युपस्थितः।\nस हन्तव्योऽभिसम्प्लुत्य राजशासनदूषकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000482044, "chapter_id": 9482, "verse_number": "६-७५-४४", "content_sanskrit": "तेषु वानरमुख्येषु दीप्तोल्कोज्ज्वलपाणिषु।\nस्थितेषु द्वारमाश्रित्य रावणं क्रोध आविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000482045, "chapter_id": 9482, "verse_number": "६-७५-४५", "content_sanskrit": "तस्य जृम्भितविक्षेपाद् व्यामिश्रा वै दिशो दश।\nरूपवानिव रुद्रस्य मन्युर्गात्रेष्वदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000482046, "chapter_id": 9482, "verse_number": "६-७५-४६", "content_sanskrit": "स कुम्भं च निकुम्भं च कुम्भकर्णात्मजावुभौ।\nप्रेषयामास संक्रुद्धो राक्षसैर्बहुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000482047, "chapter_id": 9482, "verse_number": "६-७५-४७", "content_sanskrit": "यूपाक्षः शोणिताक्षश्च प्रजङ्घः कम्पनस्तथा।\nनिर्ययुः कौम्भकर्णिभ्यां सह रावणशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000482048, "chapter_id": 9482, "verse_number": "६-७५-४८", "content_sanskrit": "शशास चैव तान् सर्वान् राक्षसान् स महाबलान्।\nराक्षसा गच्छताद्यैव सिंहनादं च नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000482049, "chapter_id": 9482, "verse_number": "६-७५-४९", "content_sanskrit": "ततस्तु चोदितास्तेन राक्षसा ज्वलितायुधाः।\nलङ्काया निर्ययुर्वीराः प्रणदन्तः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000482050, "chapter_id": 9482, "verse_number": "६-७५-५०", "content_sanskrit": "रक्षसां भूषणस्थाभिर्भाभिः स्वाभिश्च सर्वशः।\nचक्रुस्ते सप्रभं व्योम हरयश्चाग्निभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000482051, "chapter_id": 9482, "verse_number": "६-७५-५१", "content_sanskrit": "तत्र ताराधिपस्याभा ताराणां भा तथैव च।\nतयोराभरणाभा च ज्वलिता द्यामभासयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000482052, "chapter_id": 9482, "verse_number": "६-७५-५२", "content_sanskrit": "चन्द्राभा भूषणाभा च ग्रहाणां ज्वलतां च भा।\nहरिराक्षससैन्यानि भ्राजयामास सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000482053, "chapter_id": 9482, "verse_number": "६-७५-५३", "content_sanskrit": "तत्र चार्धप्रदीप्तानां गृहाणां सागरः पुनः।\nभाभिः संसक्तसलिलश्चलोर्मिः शुशुभेऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000482054, "chapter_id": 9482, "verse_number": "६-७५-५४", "content_sanskrit": "पताकाध्वजसंयुक्तमुत्तमासिपरश्वधम्।\nभीमाश्वरथमातङ्गं नानापत्तिसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000482055, "chapter_id": 9482, "verse_number": "६-७५-५५", "content_sanskrit": "दीप्तशूलगदाखड्गप्रासतोमरकार्मुकम्।\nतद् राक्षसबलं भीमं घोरविक्रमपौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000482056, "chapter_id": 9482, "verse_number": "६-७५-५६", "content_sanskrit": "ददृशे ज्वलितप्रासं किङ्किणीशतनादितम्।\nहेमजालाचितभुजं व्यावेष्टितपरश्वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000482057, "chapter_id": 9482, "verse_number": "६-७५-५७", "content_sanskrit": "व्याघूर्णितमहाशस्त्रं बाणसंसक्तकार्मुकम्।\nगन्धमाल्यमधूत्सेकसम्मोदितमहानिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000482058, "chapter_id": 9482, "verse_number": "६-७५-५८", "content_sanskrit": "घोरं शूरजनाकीर्णं महाम्बुधरनिःस्वनम्।\nतद् दृष्ट्वा बलमायातं राक्षसानां दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000482059, "chapter_id": 9482, "verse_number": "६-७५-५९", "content_sanskrit": "संचचाल प्लवंगानां बलमुच्चैर्ननाद च।\nजवेनाप्लुत्य च पुनस्तद् बलं रक्षसां महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000482060, "chapter_id": 9482, "verse_number": "६-७५-६०", "content_sanskrit": "अभ्ययात् प्रत्यरिबलं पतंगा इव पावकम्।\nतेषां भुजपरामर्शव्यामृष्टपरिघाशनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000482061, "chapter_id": 9482, "verse_number": "६-७५-६१", "content_sanskrit": "राक्षसानां बलं श्रेष्ठं भूयः परमशोभत।\nतत्रोन्मत्ता इवोत्पेतुर्हरयोऽथ युयुत्सवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000482062, "chapter_id": 9482, "verse_number": "६-७५-६२", "content_sanskrit": "तरुशैलैरभिघ्नन्तो मुष्टिभिश्च निशाचरान्।\nतथैवापततां तेषां हरीणां निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000482063, "chapter_id": 9482, "verse_number": "६-७५-६३", "content_sanskrit": "शिरांसि सहसा जह्रू राक्षसा भीमविक्रमाः।\nदशनैर्हतकर्णाश्च मुष्टिभिर्भिन्नमस्तकाः।\nशिलाप्रहारभग्नाङ्गा विचेरुस्तत्र राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000482064, "chapter_id": 9482, "verse_number": "६-७५-६४", "content_sanskrit": "तथैवाप्यपरे तेषां कपीनामसिभिः शितैः।\nप्रवरानभितो जघ्नुर्घोररूपा निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000482065, "chapter_id": 9482, "verse_number": "६-७५-६५", "content_sanskrit": "घ्नन्तमन्यं जघानान्यः पातयन्तमपातयत्।\nगर्हमाणं जगर्हान्यो दशन्तमपरोऽदशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000482066, "chapter_id": 9482, "verse_number": "६-७५-६६", "content_sanskrit": "देहीत्यन्यो ददात्यन्यो ददामीत्यपरः पुनः।\nकिं क्लेशयसि तिष्ठेति तत्रान्योन्यं बभाषिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000482067, "chapter_id": 9482, "verse_number": "६-७५-६७", "content_sanskrit": "विप्रलम्भितशस्त्रं च विमुक्तकवचायुधम्।\nसमुद्यतमहाप्रासं मुष्टिशूलासिकुन्तलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000482068, "chapter_id": 9482, "verse_number": "६-७५-६८", "content_sanskrit": "प्रावर्तत महारौद्रं युद्धं वानररक्षसाम्।\nवानरान् दश सप्तेति राक्षसा जघ्नुराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000482069, "chapter_id": 9482, "verse_number": "६-७५-६९", "content_sanskrit": "राक्षसान् दश सप्तेति वानराश्चाभ्यपातयन्।\nविप्रलम्भितवस्त्रं च विमुक्तकवचध्वजम्।\nबलं राक्षसमालम्ब्य वानराः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000482070, "chapter_id": 9482, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]