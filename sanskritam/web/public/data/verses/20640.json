[{"id": 7000640000, "chapter_id": 20640, "verse_number": "५-९९-१", "content_sanskrit": "यम उवाच ।\nबभूव भूपतिः पूर्वं ख्यातो नाम्ना महीरथः ।\nपूर्वपुण्यफलावाप्त प्रभूतैश्वर्यसंपदः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000640001, "chapter_id": 20640, "verse_number": "५-९९-२", "content_sanskrit": "केवलं कामकलना ललना ललितस्थितः ।\nतदेकव्यसनासक्तिर्न धर्मार्थ व्यवस्थितः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000640002, "chapter_id": 20640, "verse_number": "५-९९-३", "content_sanskrit": "मंत्रिणि न्यस्य राज्यश्रीर्बुभुजे विषयान्नृपः ।\nस कामिनी सहचरो राज्यकार्यपराङ्मुखः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000640003, "chapter_id": 20640, "verse_number": "५-९९-४", "content_sanskrit": "न प्रजा न धनं धर्मं नार्थं कार्यं च पश्यति ।\nकेवलं कामिनीकेलि कलनोचितवासनः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000640004, "chapter_id": 20640, "verse_number": "५-९९-५", "content_sanskrit": "अथ कालेन महता पुरोधास्तस्य कश्यपः ।\nवचः प्रोवाच तं धर्म्यमिति चेतस्यचिंतयत् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000640005, "chapter_id": 20640, "verse_number": "५-९९-६", "content_sanskrit": "न वारयति यो मोहादधर्मान्नृपतिं गुरुः ।\nसोपि तत्पापभुक्तस्माद्बोधनीयः पुरोधसा ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000640006, "chapter_id": 20640, "verse_number": "५-९९-७", "content_sanskrit": "बोधितोऽप्यवजानाति स चेद्वाक्यं पुरोधसः ।\nपुरोधास्तत्र निर्दोषो राजा स्यात्सर्वदोषभाक् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000640007, "chapter_id": 20640, "verse_number": "५-९९-८", "content_sanskrit": "शृणु राजन्मम गुरोर्वचो धर्मार्थसंहितम् ।\nअभिन्नार्थमुपेतार्थमिच्छारागादि वर्जितम् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000640008, "chapter_id": 20640, "verse_number": "५-९९-९", "content_sanskrit": "अयमेव परो धर्मो यद्गुरोर्वचसि स्थितिः ।\nगुर्वाज्ञायालवो राज्ञामायुः श्री सौख्यवर्द्धनः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000640009, "chapter_id": 20640, "verse_number": "५-९९-१०", "content_sanskrit": "न विप्रास्तर्पिता दानैर्विष्णुर्नाराधितस्त्वया ।\nन व्रतं न तपः किंचिन्न तीर्थं हि कृतं त्वया ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000640010, "chapter_id": 20640, "verse_number": "५-९९-११", "content_sanskrit": "हरिनाम त्वया कामवशगेन न चिंतितम् ।\nहा त्वया भीरुसंगत्या न विद्वत्संगतिः कृता ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000640011, "chapter_id": 20640, "verse_number": "५-९९-१२", "content_sanskrit": "स्मरचामरवाहिन्यो वल्लभाः कस्य न प्रियाः ।\nकिंतु ताः पवनोल्लोलकदलीदलवच्चलाः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000640012, "chapter_id": 20640, "verse_number": "५-९९-१३", "content_sanskrit": "तरंगतरलैरर्थैर्भोगैर्भ्रूभंगभंगुरैः ।\nमुहूर्तपेयैस्तारुण्यैर्न तृप्यंते महाशयाः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000640013, "chapter_id": 20640, "verse_number": "५-९९-१४", "content_sanskrit": "किं विद्यया च तपसा किं त्यागेन नयेन वा ।\nकिं विविक्तेन मनसा स्त्रीभिर्यस्य हृतं मनः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000640014, "chapter_id": 20640, "verse_number": "५-९९-१५", "content_sanskrit": "एक एव सुहृद्धर्मो निधनेष्वनुयाति यः ।\nसर्वमन्यच्छरीरेण समं नाशं गमिष्यति ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000640015, "chapter_id": 20640, "verse_number": "५-९९-१६", "content_sanskrit": "धर्मं शनैः संचिनुयाद्वल्मीकमिव पुत्तिकाः ।\nधर्मेण हि सहायेन तमस्तरति दुस्तरम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000640016, "chapter_id": 20640, "verse_number": "५-९९-१७", "content_sanskrit": "अनिलोल्लासितोत्ताल जलकल्लोल चंचलम् ।\nकिं न जानासि राजेंद्र नृणां जीवित विभ्रमम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000640017, "chapter_id": 20640, "verse_number": "५-९९-१८", "content_sanskrit": "विनयो रत्नमुकुटः सत्यधर्मौ च कुंडले ।\nत्यागश्च कंकणो येषां किं तेषां जडमंडनैः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000640018, "chapter_id": 20640, "verse_number": "५-९९-१९", "content_sanskrit": "मृतं शरीरमुत्सृज्य काष्ठलोष्टसमं भुवि ।\nविमुखा बांधवा यांति धर्मस्तमनुगच्छति ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000640019, "chapter_id": 20640, "verse_number": "५-९९-२०", "content_sanskrit": "गम्यमानेषु सर्वेषु क्षीयमाणे तथायुषि ।\nजीविते लुप्यमाने च किमुत्थाय न धावसि ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000640020, "chapter_id": 20640, "verse_number": "५-९९-२१", "content_sanskrit": "कुटुंबं पुत्रदारादि शरीरं द्रव्यसंचयः ।\nपारक्यमध्रुवं किंतु स्वीये सुकृतदुष्कृते ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000640021, "chapter_id": 20640, "verse_number": "५-९९-२२", "content_sanskrit": "यदा सर्वं परित्यज्य गंतव्यमवशेन ते ।\nअनर्थे किं प्रसक्तस्त्वं स्वधर्मं नानुतिष्ठसि ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000640022, "chapter_id": 20640, "verse_number": "५-९९-२३", "content_sanskrit": "अविश्राममनालंबमपाथेयमदेशिकम् ।\nमृतः कांतारमध्वानं कथमेको गमिष्यसि ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000640023, "chapter_id": 20640, "verse_number": "५-९९-२४", "content_sanskrit": "न हि त्वां प्रस्थितं कश्चित्पृष्ठतोऽनुगमिष्यति ।\nसुकृतं दुष्कृतं च त्वां यास्यंतमनुयास्यति ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000640024, "chapter_id": 20640, "verse_number": "५-९९-२५", "content_sanskrit": "श्रुतिस्मृत्युदितं कर्म कुलदेशोचितं हितम् ।\nधर्ममूलं निषेवस्व सदाचारमतंद्रितः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000640025, "chapter_id": 20640, "verse_number": "५-९९-२६", "content_sanskrit": "परित्यजेदर्थकामौ स्यातां चेद्धर्मवर्जितौ ।\nधर्मेण प्राप्यते सर्वमर्थकामादिकं सुखम् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000640026, "chapter_id": 20640, "verse_number": "५-९९-२७", "content_sanskrit": "इंद्रियाणां जयं योगं समातिष्ठेद्दिवानिशम् ।\nजितेंद्रियो हि शक्नोति पथि स्थापयितुं प्रजाः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000640027, "chapter_id": 20640, "verse_number": "५-९९-२८", "content_sanskrit": "अतिप्रगल्भ ललना कटाक्ष चपलाश्रियः ।\nविनये प्रणिधानेन चिरं तिष्ठंति भूभुजाम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000640028, "chapter_id": 20640, "verse_number": "५-९९-२९", "content_sanskrit": "कामदर्पादिशीलानामविचारित कारिणाम् ।\nआयुषा सह नश्यंति संपदो मूढचेतसाम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000640029, "chapter_id": 20640, "verse_number": "५-९९-३०", "content_sanskrit": "भूतिभिर्नष्टदृष्टाभिर्नृत्यंते न महाशयाः ।\nनागताभिर्न याताभिर्नदीभिश्चीयतेंबुधिः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000640030, "chapter_id": 20640, "verse_number": "५-९९-३१", "content_sanskrit": "व्यसनस्य च मृत्योश्च व्यसनं कष्टमुच्यते ।\nव्यसन्यधोधो व्रजति स्वर्गाम्यव्यसनी नृपः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000640031, "chapter_id": 20640, "verse_number": "५-९९-३२", "content_sanskrit": "व्यसनानि दुरंतानि कामजानि विशेषतः ।\nत्यज तस्मान्महाराज कामं धर्मविरोधिनम् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000640032, "chapter_id": 20640, "verse_number": "५-९९-३३", "content_sanskrit": "जडानामविवेकानामसुराणां दुरात्मनाम् ।\nभाग्यभोग्यानि राज्यानि संत्यनीतिमतामपि ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000640033, "chapter_id": 20640, "verse_number": "५-९९-३४", "content_sanskrit": "नैव स्थिराणि तानीह दुरितैरनुसेवितैः ।\nविलीयंते यथा वह्निसंसर्गेणेंधनानि च ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000640034, "chapter_id": 20640, "verse_number": "५-९९-३५", "content_sanskrit": "गच्छतस्तिष्ठतो वापि जाग्रतः स्वपतोऽपि वा ।\nन विचारपरं चेतो यस्यासौ मृत एव सः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000640035, "chapter_id": 20640, "verse_number": "५-९९-३६", "content_sanskrit": "उपदेष्टा श्रुतवतां गुरुरित्युच्यते यतः ।\nकिंतु त्वासन्नविपदामुपदेशाः शिरोरुहाः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000640036, "chapter_id": 20640, "verse_number": "५-९९-३७", "content_sanskrit": "विषयज्वरमुत्सृज्य समया स्वस्थया धिया ।\nयुक्त्या च व्यवहारिण्या स्वार्थः प्राज्ञेन साध्यते ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000640037, "chapter_id": 20640, "verse_number": "५-९९-३८", "content_sanskrit": "अशुभाच्चलितं याति शुभं तस्मादपीतरम् ।\nजंतोश्चित्तं च शिशुवत्तस्मात्तच्चालयेद्बलात् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000640038, "chapter_id": 20640, "verse_number": "५-९९-३९", "content_sanskrit": "उपधार्य मतिं राजन्वृद्धानां धर्मदर्शिनाम् ।\nनियच्छेत्परया बुद्ध्या चित्तमुत्पथगामि यत् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000640039, "chapter_id": 20640, "verse_number": "५-९९-४०", "content_sanskrit": "न धनान्युपकुर्वंति न मित्राणि न बांधवाः ।\nन हस्तपादचलनं न देशांतरसंगतम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000640040, "chapter_id": 20640, "verse_number": "५-९९-४१", "content_sanskrit": "न कायक्लेशवैधुर्यं न तीर्थायतनाश्रयः ।\nकेवलं तन्मनस्कस्य जपेनासाद्यते पदम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000640041, "chapter_id": 20640, "verse_number": "५-९९-४२", "content_sanskrit": "विषये वर्तमानस्य तस्माच्चित्तस्य संयमे ।\nयत्नं कुर्याद्बुधो राजन्ध्रुवं यंतेव वाजिनाम् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000640042, "chapter_id": 20640, "verse_number": "५-९९-४३", "content_sanskrit": "तत्तत्कुर्याद्यतो राजन्भवता येन वंचितः ।\nमुनिभिश्च फलैस्तैस्तैरतोप्याकर्णयाधुना ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000640043, "chapter_id": 20640, "verse_number": "५-९९-४४", "content_sanskrit": "मुह्यतापि मनुष्येण प्रष्टव्याः सुहृदो बुधाः ।\nते च पृष्टा यथा ब्रूयुस्तत्कर्त्तव्यं यथोचितम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000640044, "chapter_id": 20640, "verse_number": "५-९९-४५", "content_sanskrit": "सर्वोपायेन कर्त्तव्यो निग्रहः कामकोपयोः ।\nश्रेयोऽर्थिना यतस्तौ हि श्रेयोघातार्थमुद्यतौ ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000640045, "chapter_id": 20640, "verse_number": "५-९९-४६", "content_sanskrit": "कामो हि बलवान्राजञ्छरीरस्थो रिपुर्महान् ।\nन तस्य वशगो भूयाज्जनः श्रेयोभिलाषुकः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000640046, "chapter_id": 20640, "verse_number": "५-९९-४७", "content_sanskrit": "यः कामो देवदेवेन पुरा तेनैव शूलिना ।\nललाटवह्निना दग्धः कृतोनंग इति स्थितिः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000640047, "chapter_id": 20640, "verse_number": "५-९९-४८", "content_sanskrit": "यदा वांछत्यसौ नारीं निहंतुं समनोभवः ।\nपुंसां कायं समाश्रित्य स्वरूपं दर्शयत्यसौ ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000640048, "chapter_id": 20640, "verse_number": "५-९९-४९", "content_sanskrit": "चिंत्यमानस्य वै पुंसो नार्या रूपं पुनःपुनः ।\nतमदृष्टं समाश्रित्य नरमुन्मादयत्यसौ ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000640049, "chapter_id": 20640, "verse_number": "५-९९-५०", "content_sanskrit": "तथैवोन्मादयत्येष योषिदंगं न संशयः ।\nस्मरः संस्मरणान्नाम जातं तस्य ततो नृप ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000640050, "chapter_id": 20640, "verse_number": "५-९९-५१", "content_sanskrit": "यादृशस्तादृशो रंगो वस्त्रं वीरसमाश्रयेत् ।\nआत्मतेजः प्रकाशात्सोऽश्रुधारा पेयतां व्रजेत् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000640051, "chapter_id": 20640, "verse_number": "५-९९-५२", "content_sanskrit": "नार्यारूपं समारुह्य धीरं तमपि मोहयेत् ।\nपुरुषं तु समाश्रित्य द्रावयत्येष योषितम् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000640052, "chapter_id": 20640, "verse_number": "५-९९-५३", "content_sanskrit": "स एव सहजो राजन्नशरीरी शरीरगः ।\nशरीरकस्यापि विभो कथं पापं विधीयते ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000640053, "chapter_id": 20640, "verse_number": "५-९९-५४", "content_sanskrit": "यं प्राप्यातिपवित्राणि पंचगव्यहवींषि च ।\nअशुचित्वं क्षणं यांति कोऽन्य स्यादशुचिस्ततः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000640054, "chapter_id": 20640, "verse_number": "५-९९-५५", "content_sanskrit": "जिघ्रन्नपि स्वदुर्गंधं पश्यन्नपि मलं स्वकम् ।\nन विरज्यति लोकोऽयं पीडयन्नपि नासिकाम् ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000640055, "chapter_id": 20640, "verse_number": "५-९९-५६", "content_sanskrit": "हृद्यान्नमन्नपानानि यं प्राप्य सुरभीणि च ।\nअशुचित्वं प्रयांत्याशु कोऽन्यस्यादशुचिस्ततः ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000640056, "chapter_id": 20640, "verse_number": "५-९९-५७", "content_sanskrit": "यस्योदरगतं चान्नं स्वं हि रूपं परित्यजेत् ।\nकृमिमिश्रममेध्यत्वं शीघ्रं प्रज्ञायते किल ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000640057, "chapter_id": 20640, "verse_number": "५-९९-५८", "content_sanskrit": "तथापि देहे भूपाल निजरूपं परित्यजेत् ।\nशुनतां याति वै पश्चात्कृमिदुर्गंधिसंकुले ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000640058, "chapter_id": 20640, "verse_number": "५-९९-५९", "content_sanskrit": "जायंते तत्र वै यूकाः कृमयो वा न संशयः ।\nसकृमिः कुरुते स्फोटं कंडूश्च परिदारुणः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000640059, "chapter_id": 20640, "verse_number": "५-९९-६०", "content_sanskrit": "व्यथामुत्पादयेद्भूयः सर्वांगं परिचालयेत् ।\nनखाग्रैर्घृष्यमाणा सा कंडूः शांता प्रजायते ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000640060, "chapter_id": 20640, "verse_number": "५-९९-६१", "content_sanskrit": "तद्वत्सुखं भवत्येव सुरतस्य न संशयः ।\nभुंजत्येवं रसान्मर्त्यः सुभक्षान्पिबते पुनः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000640061, "chapter_id": 20640, "verse_number": "५-९९-६२", "content_sanskrit": "तत्रस्थं पचते वह्निरपाने पातयेन्मलम् ।\nसारभूतो रसस्तत्र उद्रिक्तस्तु प्रजायते ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000640062, "chapter_id": 20640, "verse_number": "५-९९-६३", "content_sanskrit": "निर्मलः शुद्धवीर्यस्तु ब्रह्मस्थानं प्रयाति च ।\nआकृष्टः स समानेन नीतस्तेनापि वायुना ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000640063, "chapter_id": 20640, "verse_number": "५-९९-६४", "content_sanskrit": "स्थानं न लभते वीर्यं चंचलत्वेन वर्तते ।\nप्राणिनां हि कपालेषु कृमयः संति पंच वै ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000640064, "chapter_id": 20640, "verse_number": "५-९९-६५", "content_sanskrit": "द्वावेतौ कर्णमूले तु नेत्रस्थाने ततः पुनः ।\nकनिष्ठांगुलिमानेन रक्तपुच्छाश्च भूपते ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000640065, "chapter_id": 20640, "verse_number": "५-९९-६६", "content_sanskrit": "नवनीतस्य वर्णेन कृष्णपुच्छा न संशयः ।\nतेषां नामानि भद्रं ते मत्तो निगदतः शृणु ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000640066, "chapter_id": 20640, "verse_number": "५-९९-६७", "content_sanskrit": "पिङ्गली शृंगली नाम द्वौ कृमी कर्णमूलयोः ।\nशृंगली जंगली चान्यौ नेत्रयोरंतरस्थितौ ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000640067, "chapter_id": 20640, "verse_number": "५-९९-६८", "content_sanskrit": "कृमीणां शतपंचाशत्तादृग्भूता न संशयः ।\nललाटांतः स्थिताः सर्वे राजिकायाः प्रमाणतः ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000640068, "chapter_id": 20640, "verse_number": "५-९९-६९", "content_sanskrit": "कपालरोगिणः सर्वे कुर्वंति न संशयः ।\nअन्यमेवं प्रवक्ष्यामि प्राजापत्यो महाकृमिः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000640069, "chapter_id": 20640, "verse_number": "५-९९-७०", "content_sanskrit": "सतंडुलप्रमाणेन तद्वद्वर्णेन संशयः ।\nकेशद्वयं मुखे तस्य विद्यते शृणु भूपते ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000640070, "chapter_id": 20640, "verse_number": "५-९९-७१", "content_sanskrit": "प्राणिनां संक्षयाबुद्धिस्तत्क्षणाद्धि न संशयः ।\nस्वस्थाने संस्थितस्यापि प्राजापत्यस्य वै मुखे ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000640071, "chapter_id": 20640, "verse_number": "५-९९-७२", "content_sanskrit": "तद्वीर्यं रसरूपेण पतते नात्र संशयः ।\nसुखेन पिबते वीर्यं तेन मत्तः प्रजायते ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000640072, "chapter_id": 20640, "verse_number": "५-९९-७३", "content_sanskrit": "तालुस्थानं प्रभेद्यैव चंचलत्वेन वर्त्तते ।\nइडा च पिंगला नाडी सुषुम्ना तत्र संस्थिताः ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000640073, "chapter_id": 20640, "verse_number": "५-९९-७४", "content_sanskrit": "स्वबलेनापि तस्यैव कंपिता नाडिका क्षणम् ।\nकामकंडूर्भवेद्राजन्सर्वेषां प्राणिनां किल ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000640074, "chapter_id": 20640, "verse_number": "५-९९-७५", "content_sanskrit": "नरस्य स्फुटते लिगं नार्या योनिश्च भूपते ।\nस्त्रीनरौ च प्रमत्तौ तौ गच्छतः संगमं ततः ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000640075, "chapter_id": 20640, "verse_number": "५-९९-७६", "content_sanskrit": "कायेन कायं संघृष्य मैथुनेन हि जायते ।\nक्षणमात्रं सुखं तत्र पुनः कंडूश्च तादृशी ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000640076, "chapter_id": 20640, "verse_number": "५-९९-७७", "content_sanskrit": "सर्वत्र दृश्यते वीर भाव एवंविधः किल ।\nविरसः परिपाकोऽयं विषयस्य न संशयः ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000640077, "chapter_id": 20640, "verse_number": "५-९९-७८", "content_sanskrit": "धर्म एव पुनः श्रेयान्विधिना समनुष्ठितः ।\nधैर्यमालंब्य च ततो धर्ममेव समाचर ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000640078, "chapter_id": 20640, "verse_number": "५-९९-७९", "content_sanskrit": "श्वास एष चपलः क्षणमध्ये यो गतागत शतानि विधत्ते ।\nजीवितं तनुभृतां तदधीनं कः समाचरति धर्मविलंबम् ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000640079, "chapter_id": 20640, "verse_number": "५-९९-८०", "content_sanskrit": "दशमीमपि यातस्य चेतो नाद्यापि भूपते ।\nविषयेभ्यो निषिद्धेभ्यो हाहा न विरमेच्चलम् ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000640080, "chapter_id": 20640, "verse_number": "५-९९-८१", "content_sanskrit": "न जातुकामः कामानामुपभोगेन शाम्यति ।\nहविषा कृष्णवर्त्मेव भूय एवाभिवर्द्धते ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000640081, "chapter_id": 20640, "verse_number": "५-९९-८२", "content_sanskrit": "पुंश्चल्यापहृतं चित्तं कश्चान्यो मोचितुं क्षमः ।\nआत्मारामेश्वरमृते भगवंतं च माधवम् ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000640082, "chapter_id": 20640, "verse_number": "५-९९-८३", "content_sanskrit": "तस्मात्सर्वं निष्फलत्वं प्रयातं कामकश्मलात् ।\nवयस्तेऽप्यधुना भूप समाचर हितं निजम् ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000640083, "chapter_id": 20640, "verse_number": "५-९९-८४", "content_sanskrit": "वदाम्यहं तव नृपहितं सर्वोत्तमोत्तमम् ।\nपुरोहितो यतस्तेऽहं सदसत्कर्मभागपि ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000640084, "chapter_id": 20640, "verse_number": "५-९९-८५", "content_sanskrit": "एकतः सर्वपुण्यानि पापनाशाय पापिनाम् ।\nएकतो माधवे मासो माधवस्यप्रियः सदा ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000640085, "chapter_id": 20640, "verse_number": "५-९९-८६", "content_sanskrit": "ब्रह्महत्या सुरापानं स्तेयं गुर्वंगनागमः ।\nमहांति पातकान्येव कीर्तितानि मुनीश्वरैः ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000640086, "chapter_id": 20640, "verse_number": "५-९९-८७", "content_sanskrit": "तत्र यन्मनसा काये व्रतेनापि कृतं नरैः ।\nनाशयेन्माधवो मासः सर्वं पापतमो महत् ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000640087, "chapter_id": 20640, "verse_number": "५-९९-८८", "content_sanskrit": "दिवाकर इव ध्वांतं नाशयेन्नृपसर्वशः ।\nतथा श्री माधवोमासस्तमाचर विधानतः ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000640088, "chapter_id": 20640, "verse_number": "५-९९-८९", "content_sanskrit": "आजन्मनोऽपि विहितानि महांति राजन्घोराणि तानि दुरितानि विहाय मर्त्याः ।\nवैशाखमासविहिताचरणप्रभाव पुण्येन ते हरिपुरं मुदिता लभंते ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000640089, "chapter_id": 20640, "verse_number": "५-९९-९०", "content_sanskrit": "यद्येकमपि वैशाखमाचरंति विधानतः ।\nभावतः पापिनोऽप्यंते प्रयांति हरिमंदिरम् ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000640090, "chapter_id": 20640, "verse_number": "५-९९-९१", "content_sanskrit": "तस्मात्त्वमपि राजेंद्र मासेऽस्मिन्माधवेधुना ।\nप्रातःस्नात्वा विधानेन समर्चय मधुद्विषम् ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000640091, "chapter_id": 20640, "verse_number": "५-९९-९२", "content_sanskrit": "तंडुलस्य यथा चर्म यथा ताम्रस्य कालिमा ।\nनश्यंति क्रियया वीर पुरुषस्य तथा मलः ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000640092, "chapter_id": 20640, "verse_number": "५-९९-९३", "content_sanskrit": "जीवस्य तंडुलस्येव सहजोऽपि मलो महान् ।\nनश्यत्येव न संदेहस्तस्मात्कर्मोदितं कुरु ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]