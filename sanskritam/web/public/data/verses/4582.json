[{"id": 2166781, "chapter_id": 4582, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2166782, "chapter_id": 4582, "verse_number": "१", "content_sanskrit": "हते कर्णे महाराज निशि गावल्गणिस्तदा ।\nदीनो ययौ नागपुरमश्वैर्वातसमैर्जवे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2166783, "chapter_id": 4582, "verse_number": "२", "content_sanskrit": "स हास्तिनपुरं गत्वा भृशमुद्विग्नचेतनः ।\nजगाम धृतराष्ट्रस्य क्षयं प्रक्षीणबान्धवम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2166784, "chapter_id": 4582, "verse_number": "३", "content_sanskrit": "स तमुद्वीक्ष्य राजानं कश्मलाभिहतौजसम् ।\nववन्दे प्राञ्जलिर्भूत्वा मूर्ध्ना पादौ नृपस्य ह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2166785, "chapter_id": 4582, "verse_number": "४", "content_sanskrit": "सम्पूज्य च यथान्यायं धृतराष्ट्रं महीपतिम् ।\nहा कष्टमिति चोक्त्वा स ततो वचनमाददे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2166786, "chapter_id": 4582, "verse_number": "५", "content_sanskrit": "सञ्जयोऽहं क्षितिपते कच्चिदास्ते सुखं भवान् ।\nस्वदोषैरापदं प्राप्य कच्चिन्नाद्य विमुह्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2166787, "chapter_id": 4582, "verse_number": "६", "content_sanskrit": "हितान्युक्तानि विदुरद्रोणगाङ्गेयकेशवैः ।\nअगृहीतान्यनुस्मृत्य कच्चिन्न कुरुषे व्यथाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2166788, "chapter_id": 4582, "verse_number": "७", "content_sanskrit": "सुहृदस्त्वद्धिते युक्तान् भीष्मद्रोणमुखान् परैः ।\nनिहतान् युधि संस्मृत्य कच्चिन्न कुरुषे व्यथाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2166789, "chapter_id": 4582, "verse_number": "८", "content_sanskrit": "रामनारदकण्वाद्यैर्हितमुक्तं सभातळे ।\nन गृहीतमनुस्मृत्य कच्चिन्न कुरुषे व्यथाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2166790, "chapter_id": 4582, "verse_number": "९", "content_sanskrit": "तमेवंवादिनं राजा सूतपुत्रं कृताञ्जलिम् ।\nसुदीर्घमथ निःश्वस्य दुःखार्त इदमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2166791, "chapter_id": 4582, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2166792, "chapter_id": 4582, "verse_number": "१०", "content_sanskrit": "आपगेये हते शूरे दिव्यास्त्रवति सञ्जय ।\nद्रोणे च परमेष्वासे भृशं मे व्यथितं मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2166793, "chapter_id": 4582, "verse_number": "११", "content_sanskrit": "यो रथानां सहस्राणि दंसितानां दशैव तु ।\nअहन्यहनि तेजस्वी निजघ्ने वसुसम्भवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2166794, "chapter_id": 4582, "verse_number": "१२", "content_sanskrit": "तं हतं यज्ञसेनस्य पुत्रेणेह शिखण्डिना ।\nपाण्डवेयाभिगुप्तेन श्रुत्वा मे व्यथितं मनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2166795, "chapter_id": 4582, "verse_number": "१३", "content_sanskrit": "भार्गवः प्रददौ यस्मै परमास्त्रं महाहवे ।\nसाक्षाद् रामेण यो बाल्ये धनुर्वेद उपाकृतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2166796, "chapter_id": 4582, "verse_number": "१४", "content_sanskrit": "यस्य प्रसादात् कौन्तेया राजपुत्रा महारथाः ।\nमहारथत्वं सम्प्राप्तास्तथाऽन्ये वसुधाधिपाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2166797, "chapter_id": 4582, "verse_number": "१५", "content_sanskrit": "तं द्रोणं निहतं श्रुत्वा धृष्टद्युम्नेन संयुगे ।\nसत्यसन्धं महेष्वासं भृशं मे व्यथितं मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2166798, "chapter_id": 4582, "verse_number": "१६", "content_sanskrit": "ययोर्लोके पुमानस्त्रे न समोऽस्ति चतुर्विधे ।\nतौ द्रोणभीष्मौ श्रुत्वा तु हतौ मे व्यथितं मनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2166799, "chapter_id": 4582, "verse_number": "१७", "content_sanskrit": "त्रैलोक्ये यस्य चास्त्रेषु न पुमान् विद्यते समः ।\nतं द्रोणं निहतं श्रुत्वा किमकुर्वत मामकाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2166800, "chapter_id": 4582, "verse_number": "१८", "content_sanskrit": "संशप्तकानां च बले पाण्डवेन महात्मना ।\nधनञ्जयेन विक्रम्य गमिते यमसादनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2166801, "chapter_id": 4582, "verse_number": "१९", "content_sanskrit": "नारायणास्त्रे च हते द्रोणपुत्रस्य धीमतः ।\nविप्रद्रुतेष्वनीकेषु किमकुर्वत मामकाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2166802, "chapter_id": 4582, "verse_number": "२०", "content_sanskrit": "विप्रद्रुतानहं मन्ये निमग्नान् शोकसागरे ।\nप्लवमानान् हते द्रोणे सन्ननौकानिवार्णवे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2166803, "chapter_id": 4582, "verse_number": "२१", "content_sanskrit": "दुर्योधनस्य कर्णस्य भोजस्य कृतवर्मणः ।\nमद्रराजस्य शल्यस्य द्रौणेश्चैव कृपस्य च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2166804, "chapter_id": 4582, "verse_number": "२२", "content_sanskrit": "मत्पुत्रस्य च शेषस्य तथाऽन्येषां च सञ्जय ।\nविप्रद्रुतेष्वनीकेषु मुखवर्णोऽभवत् कथम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2166805, "chapter_id": 4582, "verse_number": "२३", "content_sanskrit": "एतत्सर्वं यथावृत्तं तथा गावल्गणे मम ।\nआचक्ष्व पाण्डवेयानां मामकानां च विक्रमम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2166806, "chapter_id": 4582, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2166807, "chapter_id": 4582, "verse_number": "२४", "content_sanskrit": "तवापराधाद्यद् वृत्तं कौरवेयेषु मारिष ।\nतच्छ्रुत्वा मा व्यथां कार्षीर्दिष्टे न व्यथते बुधः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2166808, "chapter_id": 4582, "verse_number": "२५", "content_sanskrit": "यस्मादभावी भावी वा भवेदर्थो नरं प्रति ।\nअप्राप्तौ तस्य वा प्राप्तौ न कश्चिद् व्यथते बुधः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2166809, "chapter_id": 4582, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2166810, "chapter_id": 4582, "verse_number": "२६", "content_sanskrit": "न व्यथाऽभ्यधिका काचिद् विद्यते मम सञ्जय ।\nदिष्टमेतत् पुरा मन्ये कथयस्व यथेच्छकम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2166811, "chapter_id": 4582, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nद्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]