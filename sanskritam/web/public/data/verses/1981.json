[{"id": 2043763, "chapter_id": 1981, "verse_number": "६-३०-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043764, "chapter_id": 1981, "verse_number": "६-३०-१", "content_sanskrit": "अनाश्रितः कर्मफलं कार्यं कर्म करोति यः।\nस संन्यासी च योगी च न निरग्निर्न चाक्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043765, "chapter_id": 1981, "verse_number": "६-३०-२", "content_sanskrit": "यं संन्यासमिति प्राहुर्योगं तं विद्धि पाण्डव ।\nन ह्यसंन्यस्तसिंकल्पो योगी भवति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043766, "chapter_id": 1981, "verse_number": "६-३०-३", "content_sanskrit": "आरुरुक्षोर्मुनेर्योगं कर्म कारणमुच्यते।\nयोगारूढस्य तस्यैव शमः कारणमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043767, "chapter_id": 1981, "verse_number": "६-३०-४", "content_sanskrit": "यदा हि नेन्द्रियार्थेषु न कर्मस्वनुषञ्जते ।\nसर्वसंकल्पसंन्यासी योगारूढस्तदोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043768, "chapter_id": 1981, "verse_number": "६-३०-५", "content_sanskrit": "उद्धरेदात्मनात्मानं नात्मानमवसादयेत् ।\nआत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043769, "chapter_id": 1981, "verse_number": "६-३०-६", "content_sanskrit": "बन्धुरात्माऽऽत्मनस्तस्य येनात्मैवात्मना जितः।\nअनात्मनस्तु शत्रुत्वे वर्तेतात्मैव शत्रुवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043770, "chapter_id": 1981, "verse_number": "६-३०-७", "content_sanskrit": "जितात्मनः प्रशान्तस्य परमात्मा समाहितः।\nशीतोष्णसुखदुःखेषु तथा मानापमानयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043771, "chapter_id": 1981, "verse_number": "६-३०-८", "content_sanskrit": "ज्ञानविज्ञानतृप्तात्मा कूटस्थो विजितेन्द्रियः ।\nयुक्त इत्युच्यते योगी समलोष्ठाश्मकाञ्चनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043772, "chapter_id": 1981, "verse_number": "६-३०-९", "content_sanskrit": "सुहृन्मित्रार्युदासीनमध्यस्थद्वेष्यबन्धुषु।\nसाधुष्वपि च पापेषु समबुद्धिर्विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043773, "chapter_id": 1981, "verse_number": "६-३०-१०", "content_sanskrit": "योगी युञ्जीत सततमात्मानं रहसि स्थितः ।\nएकाकी यतचित्तात्मा निराशीरपरिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043774, "chapter_id": 1981, "verse_number": "६-३०-११", "content_sanskrit": "शुचौ देशे प्रतिष्ठाप्य स्थिरमासनमात्मनः ।\nनात्युच्छ्रितं नातिनीचं चैलाजिनकुशोत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043775, "chapter_id": 1981, "verse_number": "६-३०-१२", "content_sanskrit": "तत्रैकाग्रं मनः कृत्वा यतचित्तेन्द्रियक्रियः ।\nउपविश्यासने युञ्ज्याद्योगमात्मविशुद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043776, "chapter_id": 1981, "verse_number": "६-३०-१३", "content_sanskrit": "समं कायशिरोग्रीवं धारयन्नचलं स्थिरः।\nसंप्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकथन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043777, "chapter_id": 1981, "verse_number": "६-३०-१४", "content_sanskrit": "प्रशान्तात्मा विगतभीर्ब्रह्मचारिव्रते स्थितः ।\nप्रनः संयम्य मच्चित्तो युक्त आसीत मत्परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043778, "chapter_id": 1981, "verse_number": "६-३०-१५", "content_sanskrit": "युञ्जन्नेवं सदात्मानं योगी नियतमानसः ।\nशान्तिं निर्वाणपरमां मत्संस्थामधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043779, "chapter_id": 1981, "verse_number": "६-३०-१६", "content_sanskrit": "नात्यश्रतस्तु योगोऽस्ति न चैकान्तमनश्नतः ।\nन चातिस्वप्रशीलस्य जाग्रतो नैव चार्जुन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043780, "chapter_id": 1981, "verse_number": "६-३०-१७", "content_sanskrit": "युक्ताहारविहारस्य युक्तचेष्टस्य कर्मसु।\nयुक्तस्वप्नाववोधस्य योगो भवति दुःखहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043781, "chapter_id": 1981, "verse_number": "६-३०-१८", "content_sanskrit": "यदा विनियतं चित्तमात्मन्येवावतिष्ठते।\nनिस्पृहः सर्वकामेभ्यो युक्त इत्युच्यते तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043782, "chapter_id": 1981, "verse_number": "६-३०-१९", "content_sanskrit": "यथा दीपो निवातस्थो नेङ्गते सोपमा स्मृता।\nयोगिनो यतचित्तस्य युञ्जतो योगमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043783, "chapter_id": 1981, "verse_number": "६-३०-२०", "content_sanskrit": "यत्रोपरमते चित्तं निरुद्धं योगसेवया ।\nयत्र चैवात्मनात्मानं पश्यन्नात्मनि तुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043784, "chapter_id": 1981, "verse_number": "६-३०-२१", "content_sanskrit": "मुखमात्यन्तिकं यत्तद्वुद्धिग्राह्यमतीन्द्रियम्।\nवेत्ति यत्र न चैवायं स्थितश्चलति तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043785, "chapter_id": 1981, "verse_number": "६-३०-२२", "content_sanskrit": "यं लब्ध्वा चापरं लाभं मन्यते नाधिकं ततः।\nयस्मिन्स्थितो न दुःखेन गुरुणापि विचाल्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043786, "chapter_id": 1981, "verse_number": "६-३०-२३", "content_sanskrit": "तं विद्याद्दुःखसंयोगवयोगं योगसंज्ञितम्।\nस निश्चयेन योक्तव्यो योगोऽनिर्विण्णचेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043787, "chapter_id": 1981, "verse_number": "६-३०-२४", "content_sanskrit": "संकल्पप्रभवान्कामांस्त्यक्त्वा सर्वानशेषतः ।\nमनसैवेन्द्रियग्रामं विनिवम्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043788, "chapter_id": 1981, "verse_number": "६-३०-२५", "content_sanskrit": "शनैः शनैरुपरमेद्भुद्ध्या धृतिगृहीतया ।\nआत्मसंस्थं मनः कृत्वा न किंचिदपि चिन्तयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043789, "chapter_id": 1981, "verse_number": "६-३०-२६", "content_sanskrit": "यतो यतो निश्चरति मनश्चञ्चलमस्थिरम् ।\nततस्ततो नियम्यैतदात्मन्येव वशं नयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043790, "chapter_id": 1981, "verse_number": "६-३०-२७", "content_sanskrit": "प्रशान्तमनसं ह्येनं योगिनं मुखमुत्तमम् ।\nउपैति श्चान्तरजसं ब्रह्मभूतमकल्मषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043791, "chapter_id": 1981, "verse_number": "६-३०-२८", "content_sanskrit": "युञ्चयेवं सदात्मानं योगी विमतकल्मषःक ।\nमुखेन ब्रह्मसंस्कपर्शमत्यन्तं सुखमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2043792, "chapter_id": 1981, "verse_number": "६-३०-२९", "content_sanskrit": "सर्वभूतस्थमात्मानं सर्वभूतानि चात्मनि।\nईक्षते कयोगयुक्तात्मा सर्वत्र समदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2043793, "chapter_id": 1981, "verse_number": "६-३०-३०", "content_sanskrit": "यो मां पश्यति सर्वत्र सर्वं च मयि पश्यति ।\nतस्याहं न प्रणश्यामि स च मे न प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2043794, "chapter_id": 1981, "verse_number": "६-३०-३१", "content_sanskrit": "सर्वभूतस्थितं यो मां भजत्येकत्वमास्थितः ।\nसर्वथा वर्तमानोऽपि स योगी मयि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2043795, "chapter_id": 1981, "verse_number": "६-३०-३२", "content_sanskrit": "आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन ।\nसुखंक वा यदि वा दुःखं स योगी मरमो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2043796, "chapter_id": 1981, "verse_number": "६-३०-३३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2043797, "chapter_id": 1981, "verse_number": "६-३०-३३", "content_sanskrit": "योऽयं योगस्त्वया प्रोक्तः साम्येन मधुसूदन।\nएतस्याहं न पश्यामि चञ्चलत्वात्स्थितिं स्थिरां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2043798, "chapter_id": 1981, "verse_number": "६-३०-३४", "content_sanskrit": "चञ्चलं हि मनः कृष्ण प्रमाथि बलवद्दृढम् ।\nतस्याहं निग्रहं मन्ये वायोरिव सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2043799, "chapter_id": 1981, "verse_number": "६-३०-३५x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2043800, "chapter_id": 1981, "verse_number": "६-३०-३५", "content_sanskrit": "असंशयं महाबाहो मनो दुर्निग्रहं चलम्।\nअभ्यासेन तु कौन्तेय वैराग्येण च गृह्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2043801, "chapter_id": 1981, "verse_number": "६-३०-३६", "content_sanskrit": "असंयतात्मना योगो दुष्प्राप इति मे मतिः।\nवश्यात्मना तु यतता शक्योऽऽवाप्तुमुपायतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2043802, "chapter_id": 1981, "verse_number": "६-३०-३७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2043803, "chapter_id": 1981, "verse_number": "६-३०-३७", "content_sanskrit": "अयतिः श्रद्धयोपेतो योगाच्चलितमानसः।\nअप्राप्य योगसंसिद्धिं कां गतिं कृष्ण गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2043804, "chapter_id": 1981, "verse_number": "६-३०-३८", "content_sanskrit": "कच्चिन्नोभयविभ्रष्टश्छिन्नाभ्रमिव नश्यति।\nअप्रतिकष्ठो महाबाहो विमूढो ब्रह्मणः पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2043805, "chapter_id": 1981, "verse_number": "६-३०-३९", "content_sanskrit": "एतन्मे संशयं कृष्ण छेत्तुमर्हस्यशेषतः ।\nत्वदन्यः संशयस्यास्य छेत्ता न ह्युपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2043806, "chapter_id": 1981, "verse_number": "६-३०-४०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2043807, "chapter_id": 1981, "verse_number": "६-३०-४०", "content_sanskrit": "पार्थ नैवेह नामुत्र विनाशस्तस्य विद्यते।\nन हि कल्याणकृत्कश्चिद्दुर्गतिं तात गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2043808, "chapter_id": 1981, "verse_number": "६-३०-४१", "content_sanskrit": "प्राप्य पुण्यकृतां लोकानुषित्वा शाश्वतीः समाः ।\nशुचीनां श्रीमतां गेहे योगभ्रष्टोऽभिजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2043809, "chapter_id": 1981, "verse_number": "६-३०-४२", "content_sanskrit": "अथवा योगिनामेव कुले भवति धीमताम् ।\nएतद्धि दुर्लभतरं लोके जन्म यदीदृश्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2043810, "chapter_id": 1981, "verse_number": "६-३०-४३", "content_sanskrit": "तत्र तं बुद्धिसंयोगं लभते पौर्वदेहिकम् ।\nयतते च ततो भूयः संसिद्धौ कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2043811, "chapter_id": 1981, "verse_number": "६-३०-४४", "content_sanskrit": "पूर्वाभ्यासेन तेनैव ह्रियते ह्यवशेऽपि सः।\nजिज्ञासुरपि योगस्य शब्दब्रह्मातिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2043812, "chapter_id": 1981, "verse_number": "६-३०-४५", "content_sanskrit": "प्रयत्नाद्यतमानस्तु योगी संशुद्धकिल्विषः ।\nअनेकन्मसंसिद्धस्ततो याति परां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2043813, "chapter_id": 1981, "verse_number": "६-३०-४६", "content_sanskrit": "तपस्विभ्योऽधिको योगी ज्ञानिभ्योपि मतोऽधिकः ।\nकर्मिभ्यश्चाधिको योगी तस्माद्योगी भावार्जुन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2043814, "chapter_id": 1981, "verse_number": "६-३०-४७", "content_sanskrit": "योगिनामपि सर्वेषां मद्गतेनान्तरात्मना।\nश्रद्धावान्भजते यो मां स मे युक्ततमो मतः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2043815, "chapter_id": 1981, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि त्रिंशोऽध्यायः ॥\nइति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे अध्यात्मयोगोनाम षष्ठोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]