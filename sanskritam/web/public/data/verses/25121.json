[{"id": 7005121000, "chapter_id": 25121, "verse_number": "७-१-३०४-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि गंगां त्रिपथगामिनीम् ।\nसंगालेशादथैशान्यां धनुषां सप्तके स्थिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005121001, "chapter_id": 25121, "verse_number": "७-१-३०४-२", "content_sanskrit": "तस्यां त्रिनेत्रा मत्स्याः स्युर्नित्यमांभसिकाः प्रिये ।\nकलौयुगेऽपि दृश्यंते सत्यंसत्यं मयोदितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005121002, "chapter_id": 25121, "verse_number": "७-१-३०४-३", "content_sanskrit": "तस्यां स्नात्वा महादेवि मुच्यते पञ्चपातकैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005121003, "chapter_id": 25121, "verse_number": "७-१-३०४-४", "content_sanskrit": "सूत उवाच ।\nतस्य तद्वचनं श्रुत्वा विस्मिता गिरिजा सती ।\nउवाच तं द्विजश्रेष्ठाः प्रचलच्चंद्रशेखरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005121004, "chapter_id": 25121, "verse_number": "७-१-३०४-५", "content_sanskrit": "पार्वत्युवाच ।\nकथं तत्र समायाता गंगा त्रिपथगामिनी ।\nकथं त्रिनेत्राः संजाता मत्स्या आंभसिकाः शिव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005121005, "chapter_id": 25121, "verse_number": "७-१-३०४-६", "content_sanskrit": "एतद्विस्तरतो ब्रूहि यद्यहं ते प्रिया विभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005121006, "chapter_id": 25121, "verse_number": "७-१-३०४-७", "content_sanskrit": "ईश्वर उवाच ।\nशृणु देवि प्रवक्ष्यामि यदि पृच्छसि मां शुभे ।\nआस्तिकाः श्रद्दधानाश्च भवंतीति मतिर्मम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005121007, "chapter_id": 25121, "verse_number": "७-१-३०४-८", "content_sanskrit": "यदा शप्तो महादेवो ह्यज्ञानतिमिरावृतैः ।\nऋषिभिः कोपयुक्तैश्च कस्मिंश्चित्कारणांतरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005121008, "chapter_id": 25121, "verse_number": "७-१-३०४-९", "content_sanskrit": "तदा ते मुनयः सर्वे शप्तं ज्ञात्वा महेश्वरम् ।\nनिरानंदं जगत्सर्वं दृष्ट्वा चात्मानमेव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005121009, "chapter_id": 25121, "verse_number": "७-१-३०४-१०", "content_sanskrit": "आराध्य परमेशानं दधतं गजरूपकम् ।\nउन्नतं स्थानमानीय सानंदं चक्रिरे द्विजाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005121010, "chapter_id": 25121, "verse_number": "७-१-३०४-११", "content_sanskrit": "ततः प्रभृति सर्वे ते शिवद्रोहकरं परम् ।\nआत्मानं मेनिरे नित्यं प्रसन्नेऽपि महेश्वरे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005121011, "chapter_id": 25121, "verse_number": "७-१-३०४-१२", "content_sanskrit": "महोदयान्महातीर्थं सर्व आगत्य सत्वरम् ।\nतपस्तेपुर्महाघोरं संगालेश्वरसन्निधौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005121012, "chapter_id": 25121, "verse_number": "७-१-३०४-१३", "content_sanskrit": "संगालेश्वरनामानं सर्वे पूज्य यथाविधि ।\nभृगुरत्रिस्तथा मंकिः कश्यपः कण्व एव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005121013, "chapter_id": 25121, "verse_number": "७-१-३०४-१४", "content_sanskrit": "गौतमः कौशिकश्चैव कुशिकश्च महातपाः ।\nशूकरोऽथ भरद्वाजो भार्गविश्च महातपाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005121014, "chapter_id": 25121, "verse_number": "७-१-३०४-१५", "content_sanskrit": "जातूकर्ण्यो वसिष्ठश्च सावर्णिश्च पराशरः ।\nशांडिल्यश्च पुलस्त्यश्च वत्सश्चैव महातपाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005121015, "chapter_id": 25121, "verse_number": "७-१-३०४-१६", "content_sanskrit": "एते चान्ये च बहवो ह्यसंख्याता महर्षयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005121016, "chapter_id": 25121, "verse_number": "७-१-३०४-१७", "content_sanskrit": "संगालेश्वरमासाद्य प्रभासे पापनाशने ।\nतपः कुर्वंति सततं प्रतिष्ठाप्य महेश्वरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005121017, "chapter_id": 25121, "verse_number": "७-१-३०४-१८", "content_sanskrit": "ततः कालेन महता ते सर्वे मुनिपुंगवाः ।\nध्यानात्त्रिलोचनस्यैव अदृष्टे तु महेश्वरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005121018, "chapter_id": 25121, "verse_number": "७-१-३०४-१९", "content_sanskrit": "त्रिनेत्रत्वमनुप्राप्तास्तपोनिष्ठास्तपोधनाः ।\nपरस्परं वीक्षमाणास्त्रिनेत्रस्याभिशंकया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005121019, "chapter_id": 25121, "verse_number": "७-१-३०४-२०", "content_sanskrit": "स्तुवंति विविधैः स्तोत्रैर्मन्यमाना महेश्वरम् ।\nज्ञात्वा ध्यानेन देवस्य त्रिनेत्रत्वमुपागताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005121020, "chapter_id": 25121, "verse_number": "७-१-३०४-२१", "content_sanskrit": "चकुरुग्रं तपस्ते तु पूजां देवस्य शूलिनः ।\nतेषु वै तप्यमानेषु कृपाविष्टो महेश्वरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005121021, "chapter_id": 25121, "verse_number": "७-१-३०४-२२", "content_sanskrit": "उवाच तान्मुनीन्सर्वाञ्छृणुध्वं वरमुत्तमम् ।\nप्रसन्नोऽहं मुनिश्रेष्ठास्तपसा पूजयापि च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005121022, "chapter_id": 25121, "verse_number": "७-१-३०४-२३", "content_sanskrit": "ऋषय ऊचुः ।\nयदि प्रसन्नो देवेश वरं नो दातुमर्हसि ।\nगंगामानय वेगेन ह्यभिषेकाय नो हर ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005121023, "chapter_id": 25121, "verse_number": "७-१-३०४-२४", "content_sanskrit": "तस्यां कृताभिषेकास्तु तव द्रोहकरा वयम् ।\nअज्ञानभावात्पूतत्वं यास्यामः पृथिवीतले ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005121024, "chapter_id": 25121, "verse_number": "७-१-३०४-२५", "content_sanskrit": "ईश्वर उवाच ।\nयूयं पवित्रकरणाः पावनानां च पावनाः ।\nगंगां चैवानयिष्यामि युष्माकं चित्ततुष्टये ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005121025, "chapter_id": 25121, "verse_number": "७-१-३०४-२६", "content_sanskrit": "पावित्र्याद्भवतां जातं त्रैनेत्र्यं मुनिसत्तमाः ।\nएवमुक्त्वा ततः शंभुर्ध्यानस्तिमितलोचनः ।\nसस्मार क्षणमात्रेण गंगां मीनकुलावृताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005121026, "chapter_id": 25121, "verse_number": "७-१-३०४-२७", "content_sanskrit": "स्मृतमात्रा तदा देवी गंगा त्रिपथगामिनी ।\nभित्वा भूमितलं प्राप्ता तत्र मीनकुलावृता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005121027, "chapter_id": 25121, "verse_number": "७-१-३०४-२८", "content_sanskrit": "ऋषिभिश्च यदा दृष्टा गंगा मीनयुता शुभा ।\nदृष्टमात्रास्तु ते मत्स्यास्त्रिनेत्रत्वमुपागताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005121028, "chapter_id": 25121, "verse_number": "७-१-३०४-२९", "content_sanskrit": "ईश्वर उवाच ।\nयुष्माकं दर्शनाद्विप्रास्त्रिनेत्रत्वमुपागताः ।\nएतन्निदर्शनं सर्वं लोकानां च प्रदर्शनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005121029, "chapter_id": 25121, "verse_number": "७-१-३०४-३०", "content_sanskrit": "ऋषय ऊचुः ।\nअस्मिन्कुंडे महादेव मत्स्यानां संततिः सदा ।\nत्रिनेत्रा त्वत्प्रसादेन भूयात्सर्वा युगेयुगे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005121030, "chapter_id": 25121, "verse_number": "७-१-३०४-३१", "content_sanskrit": "अस्मिन्कुंडे समागत्य नरः स्नानं करोति यः ।\nददाति हेम विप्राय गाश्च वस्त्रं तथा तिलान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005121031, "chapter_id": 25121, "verse_number": "७-१-३०४-३२", "content_sanskrit": "अमावास्यां विशेषेण त्रिनेत्रः स प्रजायताम् ।\nएवं भविष्यतीत्युक्त्वा ह्यन्तर्धानं गतो हरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005121032, "chapter_id": 25121, "verse_number": "७-१-३०४-३३", "content_sanskrit": "ब्राह्मणास्तुष्टिसंयुक्ता गताः सर्वे महोदयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005121033, "chapter_id": 25121, "verse_number": "७-१-३०४-३४", "content_sanskrit": "एतत्ते कथितं देवि गंगामाहात्म्यमुत्तमम् ।\nश्रुतं पापप्रशमनं सर्वकामफलप्रदम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005121034, "chapter_id": 25121, "verse_number": "७-१-३०४-३५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये संगालेश्वरसमीपवर्ति गंगामाहात्म्यवर्णनंनाम चतुरुत्तरत्रिशततमोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]