[{"id": 7000593000, "chapter_id": 20593, "verse_number": "५-५२-१", "content_sanskrit": "शेष उवाच ।\nचंपकं पतितं दृष्ट्वा सुरथः क्षत्रियो बली ।\nपुत्रदुःखपरीतांगो जगाम स्यंदने स्थितः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000593001, "chapter_id": 20593, "verse_number": "५-५२-२", "content_sanskrit": "कपींद्रमाजुहावाथ सुरथः कोपसंयुतः ।\nनिःश्वासवेगं संमुंचन्महाबलसमन्वितः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000593002, "chapter_id": 20593, "verse_number": "५-५२-३", "content_sanskrit": "आह्वयानं नृपं दृष्ट्वा निजं वीरः कपीश्वरः ।\nजगाम तं महावीरो महावेगसमन्वितः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000593003, "chapter_id": 20593, "verse_number": "५-५२-४", "content_sanskrit": "तमागतं हनूमंतं तृणीकुर्वं तमुद्भटान् ।\nउवाच सुरथो राजा मेघगंभीरसुस्वरः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000593004, "chapter_id": 20593, "verse_number": "५-५२-५", "content_sanskrit": "सुरथ उवाच ।\nधन्योसि कपिवर्य त्वं महाबलपराक्रमः ।\nयेन राममहत्कृत्यं कृतं राक्षसके पुरे॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000593005, "chapter_id": 20593, "verse_number": "५-५२-६", "content_sanskrit": "त्वं रामचरणस्यासि सेवको भक्तिसंयुतः ।\nत्वया वीरेण मत्पुत्रः पातितश्चंपको बली॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000593006, "chapter_id": 20593, "verse_number": "५-५२-७", "content_sanskrit": "इदानीं त्वां तु संबध्य गंतास्मि नगरेमम ।\nयत्नात्तिष्ठ कपीशेशसत्यमुक्तं मया स्मृतम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000593007, "chapter_id": 20593, "verse_number": "५-५२-८", "content_sanskrit": "इति भाषितमाकर्ण्य सुरथस्य कपीश्वरः ।\nउवाच धीरया वाण्या रणे वीरैकभूषिते॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000593008, "chapter_id": 20593, "verse_number": "५-५२-९", "content_sanskrit": "हनूमानुवाच ।\nत्वं रामचरणस्मारी वयं रामस्य सेवकाः ।\nबध्नासि चेन्मां प्रसभं मोचयिष्यति मत्प्रभुः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000593009, "chapter_id": 20593, "verse_number": "५-५२-१०", "content_sanskrit": "कुरु वीर भवत्स्वांतस्थितं सत्यं प्रतिश्रुतम् ।\nरामं स्मरन्वै दुःखांतं याति वेदा वदंत्यदः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000593010, "chapter_id": 20593, "verse_number": "५-५२-११", "content_sanskrit": "शेष उवाच ।\nइति ब्रुवंतं सुरथः प्रशस्य पवनात्मजम् ।\nविव्याध बाणैर्बहुभिः शितैः शाणेन दारुणैः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000593011, "chapter_id": 20593, "verse_number": "५-५२-१२", "content_sanskrit": "तान्मुक्तानगणय्याथ बाणाञ्छोणितपातिनः ।\nकरे जग्राह कोदंडं सज्यं शरसमन्वितम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000593012, "chapter_id": 20593, "verse_number": "५-५२-१३", "content_sanskrit": "गृहीत्वा करयोश्चापं बभंज कुपितः कपिः ।\nचीत्कुर्वंस्त्रासयन्वीरान्नखैर्दीर्णान्सृजन्भटान्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000593013, "chapter_id": 20593, "verse_number": "५-५२-१४", "content_sanskrit": "तेन भग्नं धनुर्दृष्ट्वा स्वकीयं गुणसंयुतम् ।\nअपरं धनुरादत्त महद्गुणविशोभितम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000593014, "chapter_id": 20593, "verse_number": "५-५२-१५", "content_sanskrit": "तच्चापि जगृहे रोषात्कपिश्चापं बभंज तत् ।\nअन्यच्चापं समादत्त तद्बभंज महाबलः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000593015, "chapter_id": 20593, "verse_number": "५-५२-१६", "content_sanskrit": "तस्मिंश्चापे प्रभग्नेऽपि सोऽन्यद्धनुरुपाददत् ।\nसोपि चापं बभंजाशु महावेगसमन्वितः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000593016, "chapter_id": 20593, "verse_number": "५-५२-१७", "content_sanskrit": "एवं राज्ञस्तु चापानामशीतिर्विदलीकृता ।\nक्षणे क्षणे महारोषात्कुर्वन्नादाननेकधा॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000593017, "chapter_id": 20593, "verse_number": "५-५२-१८", "content_sanskrit": "तदात्यंतं प्रकुपितः शक्तिमुग्रामथाददे ।\nशक्त्या स ताडितो वीरः पपात क्षणमुत्सुकः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000593018, "chapter_id": 20593, "verse_number": "५-५२-१९", "content_sanskrit": "उत्थाय स्यंदनं राज्ञो जग्राह कुपितो भृशम् ।\nउड्डीनस्तं गृहीत्वा तु समुद्रमतिवेगतः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000593019, "chapter_id": 20593, "verse_number": "५-५२-२०", "content_sanskrit": "तमुड्डीनं समालक्ष्य सुरथः परवीरहा ।\nताडयामास परिघैर्हृदि मारुतिमुद्यतम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000593020, "chapter_id": 20593, "verse_number": "५-५२-२१", "content_sanskrit": "मुक्तस्तेन रथो दूराच्चूर्णीभूतोऽभवत्क्षणात् ।\nसोऽन्यरथं समारुह्य ययौ वेगात्समीरजम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000593021, "chapter_id": 20593, "verse_number": "५-५२-२२", "content_sanskrit": "हनूमांस्तद्रथं पुच्छे संवेष्ट्य प्रधनांगणे ।\nहयसारथिसंयुक्तं बभंज सपताकिनम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000593022, "chapter_id": 20593, "verse_number": "५-५२-२३", "content_sanskrit": "अन्यं रथं समास्थाय ययौ राजा महाबलः ।\nबभंज तं रथं वेगान्मारुतिः कुपितांगकः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000593023, "chapter_id": 20593, "verse_number": "५-५२-२४", "content_sanskrit": "भग्नं तं स्यंदनं वीक्ष्य सुरथोऽन्यसमाश्रितः ।\nभग्नः स तेन सहसा हयसारथिसंयुतः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000593024, "chapter_id": 20593, "verse_number": "५-५२-२५", "content_sanskrit": "एवमेकोनपंचाशद्रथा भग्ना हनूमता ।\nतत्कर्म वीक्ष्य राजापि विसिस्माय ससैनिकः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000593025, "chapter_id": 20593, "verse_number": "५-५२-२६", "content_sanskrit": "कुपितः प्राह कीशेंद्रं धन्योसि पवनात्मज ।\nपराक्रमन्निदं कर्म न कर्ता न करिष्यति॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000593026, "chapter_id": 20593, "verse_number": "५-५२-२७", "content_sanskrit": "क्षणमेकं प्रतीक्षस्व यावत्सज्यं धनुस्त्वहम् ।\nकरोमि पवनोद्भूत रामपादाब्जषट्पद॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000593027, "chapter_id": 20593, "verse_number": "५-५२-२८", "content_sanskrit": "इत्युक्त्वा चापमात्तज्यं कृत्वा रोषपरिप्लुतः ।\nअस्त्रं पाशुपतं नाम संदधे शर उल्बणे॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000593028, "chapter_id": 20593, "verse_number": "५-५२-२९", "content_sanskrit": "ततो भूताश्च वेतालाः पिशाचा योगिनीमुखाः ।\nप्रादुर्बभूवुः सहसा भीषयंतः समीरजम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000593029, "chapter_id": 20593, "verse_number": "५-५२-३०", "content_sanskrit": "कपिः पाशुपतैरस्त्रैर्बद्धो लोकैरभीक्षितः ।\nहाहेति च वदंत्येते यावत्तावत्समीरजः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000593030, "chapter_id": 20593, "verse_number": "५-५२-३१", "content_sanskrit": "स्मृत्वा रामं स्वमनसा त्रोटयामास तत्क्षणात् ।\nस मुक्तगात्रः सहसा युयुधे सुरथं नृपम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000593031, "chapter_id": 20593, "verse_number": "५-५२-३२", "content_sanskrit": "तं मुक्तगात्रं संवीक्ष्य सुरथः परमास्त्रवित् ।\nमहाबलं मन्यमानो ब्राह्ममस्त्रं समाददे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000593032, "chapter_id": 20593, "verse_number": "५-५२-३३", "content_sanskrit": "मारुतिर्ब्राह्ममस्त्रं तु निजगाल हसन्बली ।\nतन्निगीर्णं नृपो दृष्ट्वा रामं सस्मार भूमिपः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000593033, "chapter_id": 20593, "verse_number": "५-५२-३४", "content_sanskrit": "स्मृत्वा दाशरथिं रामं रामास्त्रं स्वशरासने ।\nसंधाय तं जगादेदं बद्धोसि कपिपुंगव॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000593034, "chapter_id": 20593, "verse_number": "५-५२-३५", "content_sanskrit": "श्रुत्वा तत्प्रक्रमेद्यावत्तावद्बद्धो रणांगणे ।\nराज्ञा रामास्त्रतो वीरो हनूमान्रामसेवकः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000593035, "chapter_id": 20593, "verse_number": "५-५२-३६", "content_sanskrit": "उवाच भूपं हनुमान्किंकरोमि महीभुज ।\nमत्स्वाम्यस्त्रेण संबद्धो नान्येन प्राकृतेन वै॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000593036, "chapter_id": 20593, "verse_number": "५-५२-३७", "content_sanskrit": "तन्मानयामिभूपालनयस्वस्वपुरंप्रति ।\nमोचयिष्यति मत्स्वामी आगत्य स दयानिधिः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000593037, "chapter_id": 20593, "verse_number": "५-५२-३८", "content_sanskrit": "बद्धे समीरजे क्रुद्धः पुष्कलो भूमिपं ययौ ।\nतं पुष्कलं समायांतं विव्याध वसुभिः शरैः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000593038, "chapter_id": 20593, "verse_number": "५-५२-३९", "content_sanskrit": "अनेकबाणसाहस्रैर्निजघान नृपं बली ।\nराज्ञानेके शरास्तस्य च्छिन्नाः प्रधनमंडले॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000593039, "chapter_id": 20593, "verse_number": "५-५२-४०", "content_sanskrit": "एवं समरसंक्रुद्धे सुरथे पुष्कले तथा ।\nबाणैर्व्याप्तं जगत्सर्वं स्थास्नुभूयश्चरिष्णु च॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000593040, "chapter_id": 20593, "verse_number": "५-५२-४१", "content_sanskrit": "तेषां रणोद्यमं वीक्ष्य मुमुहुः सुरसैनिकाः ।\nमानवानां तु का वार्ता क्षणात्त्रासं समीयुषाम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000593041, "chapter_id": 20593, "verse_number": "५-५२-४२", "content_sanskrit": "अस्त्रप्रत्यस्त्रविगमैर्महामंत्रपरिस्तुतैः ।\nबभूव तुमुलं युद्धं वीराणां रोमहर्षणम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000593042, "chapter_id": 20593, "verse_number": "५-५२-४३", "content_sanskrit": "तदा प्रकुपितो राजा नाराचं तु समाददे ।\nछिन्नः स तु क्रुधा मुक्तैर्वत्सदंतैः सभारतैः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000593043, "chapter_id": 20593, "verse_number": "५-५२-४४", "content_sanskrit": "छिन्ने तस्मिञ्छरे राजा कोपादन्यं समाददे ।\nछिनत्ति यावत्स शरं तावल्लग्नो हृदि क्षतः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000593044, "chapter_id": 20593, "verse_number": "५-५२-४५", "content_sanskrit": "मूर्च्छां प्राप महातेजाः पुष्कलो महदद्भुतम् ।\nयुद्धं विधाय सुमहद्राज्ञा सह महामतिः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000593045, "chapter_id": 20593, "verse_number": "५-५२-४६", "content_sanskrit": "पुष्कले पतिते राजा शत्रुघ्नः शत्रुतापनः ।\nसुरथं प्रति संक्रुद्धो जगाम स्यंदनस्थितः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000593046, "chapter_id": 20593, "verse_number": "५-५२-४७", "content_sanskrit": "उवाच सुरथं भूपं रामभ्राता महाबलः ।\nत्वया महत्कृतं कर्म यद्बद्धः पवनात्मजः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000593047, "chapter_id": 20593, "verse_number": "५-५२-४८", "content_sanskrit": "पुष्कलोऽपि महावीरस्तथान्ये मम सैनिकाः ।\nपातिताः प्रधने घोरे महाबलपराक्रमाः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000593048, "chapter_id": 20593, "verse_number": "५-५२-४९", "content_sanskrit": "इदानीं तिष्ठ मद्वीरान्पातयित्वा रणांगणे ।\nकुत्र यास्यसि भूमीश सहस्व मम सायकान्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000593049, "chapter_id": 20593, "verse_number": "५-५२-५०", "content_sanskrit": "इत्थमाश्रुत्य वीरस्य भाषितं सुरथो बली ।\nजगाद रामपादाब्जं दधच्चेतसि शोभनम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000593050, "chapter_id": 20593, "verse_number": "५-५२-५१", "content_sanskrit": "मया ते पातिताः संख्ये वीरा मारुतजोन्मुखाः ।\nइदानीं पातयिष्यामि त्वामपि प्रधनांगणे॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000593051, "chapter_id": 20593, "verse_number": "५-५२-५२", "content_sanskrit": "स्मरस्व रामं यो वीरः स्वमागत्य प्ररक्षति ।\nअन्यथा जीवितं नास्ति मत्पुरः शत्रुतापन॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000593052, "chapter_id": 20593, "verse_number": "५-५२-५३", "content_sanskrit": "इत्युक्त्वा बाणसाहस्रैस्तं जघान महीपतिः ।\nशत्रुघ्नं शरसंघातपंजरे न्यदधात्परम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000593053, "chapter_id": 20593, "verse_number": "५-५२-५४", "content_sanskrit": "शत्रुघ्नः शरसंघातं मुंचंतं वह्निदैवतम् ।\nअस्त्रं मुमोच दाहार्थं शराणां नतपर्वणाम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000593054, "chapter_id": 20593, "verse_number": "५-५२-५५", "content_sanskrit": "तदस्त्रं मुक्तमालोक्य राजा वै सुरथो महान् ।\nवारुणास्त्रेण शमयन्विव्याध शरकोटिभिः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000593055, "chapter_id": 20593, "verse_number": "५-५२-५६", "content_sanskrit": "तदा तद्योगिनीदत्तमस्त्रं धनुषि संदधे ।\nमोहनं सर्ववीराणां निद्राप्रापकमद्भुतम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000593056, "chapter_id": 20593, "verse_number": "५-५२-५७", "content_sanskrit": "तन्मोहनं महास्त्रं स वीक्ष्य राजा हरिंस्मरन् ।\nजगाद शत्रुघ्नमयं सर्वशस्त्रास्त्रकोविदः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000593057, "chapter_id": 20593, "verse_number": "५-५२-५८", "content_sanskrit": "मोहितस्य मम श्रीमद्रामस्य स्मरणेन ह ।\nनान्यन्मोहनमाभाति ममापि भयतापदम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000593058, "chapter_id": 20593, "verse_number": "५-५२-५९", "content_sanskrit": "इत्युक्तवति वीरे तु मुमोच स महास्त्रकम् ।\nतेन बाणेन संछिन्नं पपात रणमंडले॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000593059, "chapter_id": 20593, "verse_number": "५-५२-६०", "content_sanskrit": "तन्मोहनं महास्त्रं तु निष्फलं वीक्ष्य भूमिपे ।\nअत्यंतं विस्मयं प्राप्य बाणं धनुषि संदधे॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000593060, "chapter_id": 20593, "verse_number": "५-५२-६१", "content_sanskrit": "लवणो येन निहतो महासुरविमर्दनः ।\nतं बाणं चाप आधत्त घोरं कान्त्यानलप्रभम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000593061, "chapter_id": 20593, "verse_number": "५-५२-६२", "content_sanskrit": "तं वीक्ष्य राजा प्रोवाच बाणोऽयमसतां हृदि ।\nलगते रामभक्तस्य संमुखेऽपि न भात्यसौ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000593062, "chapter_id": 20593, "verse_number": "५-५२-६३", "content_sanskrit": "इत्येवं भाषमाणं तु बाणेनानेन शत्रुहा ।\nविव्याध हृदये क्षिप्रं वह्निज्वालासमप्रभम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000593063, "chapter_id": 20593, "verse_number": "५-५२-६४", "content_sanskrit": "तेन बाणेन दुःखार्तो महापीडासमन्वितः ।\nरथोपस्थे क्षणं मूर्च्छामवाप परतापनः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000593064, "chapter_id": 20593, "verse_number": "५-५२-६५", "content_sanskrit": "स क्षणात्तां व्यथां तीर्त्वा जगाद रिपुमग्रतः ।\nसहस्वैकं प्रहारं मे कुत्र यासि ममाग्रतः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000593065, "chapter_id": 20593, "verse_number": "५-५२-६६", "content_sanskrit": "एवमुक्त्वा महासंख्ये बाणमाधत्त सायके ।\nज्वालामालापरीतांगं स्वर्णपुंखसमन्वितम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000593066, "chapter_id": 20593, "verse_number": "५-५२-६७", "content_sanskrit": "स बाणो धनुषो मुक्तः शत्रुघ्नेन पथिस्थितः ।\nछिन्नोऽप्यग्रफलेनाशु हृदये समपद्यत॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000593067, "chapter_id": 20593, "verse_number": "५-५२-६८", "content_sanskrit": "तेन बाणेन संमूर्छ्य पपात स्यंदनोपरि ।\nततो हाहाकृतं सैन्यं भग्नं सर्वं पराद्रवत्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000593068, "chapter_id": 20593, "verse_number": "५-५२-६९", "content_sanskrit": "सुरथो जयमापेदे संग्रामे रामसेवकः ।\nदशवीरा दशसुतैर्मूर्च्छिताः पतिताः क्वचित्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]