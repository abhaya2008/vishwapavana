[{"id": 2172800, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "उभयसैन्यानां व्यूहकरणपूर्वकं द्वन्द्वीभूय युद्धाय निर्गमनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172801, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172802, "chapter_id": 4681, "verse_number": "१", "content_sanskrit": "व्यतीतायां रजन्यां तु राजा दुर्योधनस्तदा ।\nअब्रवीत् तावकान् सर्वान् सन्नह्यन्तां महारथाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172803, "chapter_id": 4681, "verse_number": "२", "content_sanskrit": "राज्ञस्तु मतमास्थाय समनह्यत सा चमूः ।\nअचोदयंस्तदा तूर्णं पर्यधावंस्तथा परान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172804, "chapter_id": 4681, "verse_number": "३", "content_sanskrit": "अकल्प्यन्त च मातङ्गान् समनह्यन्त पत्तयः ।\nहयानास्तरणोपेतान् चक्रुरन्ये सहस्रशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172805, "chapter_id": 4681, "verse_number": "४", "content_sanskrit": "वादित्राणां च निनदः प्रादुरासीद् विशाम्पते ।\nचोदनार्थं च सैन्यानां योधानां चाप्यनेकशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172806, "chapter_id": 4681, "verse_number": "५", "content_sanskrit": "ततो बलानि सर्वाणि हतशिष्टानि भारत ।\nसन्नद्धान्येव दृश्यन्ते मृत्युं कृत्वा निवर्तनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172807, "chapter_id": 4681, "verse_number": "६", "content_sanskrit": "शल्यं सेनापतिं कृत्वा मद्रराजं महारथम् ।\nप्रविभज्य बलं सर्वमनीकेषु व्यवस्थिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172808, "chapter_id": 4681, "verse_number": "७", "content_sanskrit": "ततः सर्वे समागम्य पुत्रेण तव चोदिताः ।\nकृपश्च कृतवर्मा च द्रौणिः शल्योऽथ सौबलः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172809, "chapter_id": 4681, "verse_number": "८", "content_sanskrit": "अन्ये च पार्थिवाः सर्वे समयं चक्रिरे तदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172810, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "कौरवसैनिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172811, "chapter_id": 4681, "verse_number": "९", "content_sanskrit": "न त्वेकेन च योद्धव्यं कथञ्चिदिह पाण्डवैः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172812, "chapter_id": 4681, "verse_number": "१०", "content_sanskrit": "यो ह्येकः पाण्डवैर्युद्ध्येद् यो वा युध्यन्तमुत्सृजेत् ।\nस पञ्चभिर्भवेद्युक्तः पातकैश्चोपपातकैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172813, "chapter_id": 4681, "verse_number": "११", "content_sanskrit": "अद्याचार्यसुतो द्रौणिः नैको युध्येत शत्रुभिः ।\nअन्योन्यं परिरक्षद्भिर्योद्धव्यं सहितैश्च नः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172814, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172815, "chapter_id": 4681, "verse_number": "१२", "content_sanskrit": "एवं ते समयं कृत्वा सर्वे तत्र महारथाः ।\nमद्राधिपं पुरस्कृत्य तूर्णमभ्यद्रवन् परान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172816, "chapter_id": 4681, "verse_number": "१३", "content_sanskrit": "तथैव पाण्डवा राजन् व्यूह्य सैन्यं महारणे ।\nअभ्ययुः कौरवान् युद्धे योत्स्यमानाः समन्ततः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172817, "chapter_id": 4681, "verse_number": "१४", "content_sanskrit": "तद्बलं भरतश्रेष्ठ क्षुब्धार्णवसमस्वनम् ।\nसमुद्धतपदात्यश्वमुद्धूतरथकुञ्जरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172818, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172819, "chapter_id": 4681, "verse_number": "१५", "content_sanskrit": "द्रोणस्येव च भीष्मस्य राधेयस्य मया श्रुतम् ।\nपतनं शंस मे भूयः शल्यस्याथ सुतस्य मे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172820, "chapter_id": 4681, "verse_number": "१६", "content_sanskrit": "कथं रणे हतः शल्यो धर्मराजेन सञ्जय ।\nभीमसेनेन बलिना पुत्रो दुर्योधनो मम\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172821, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172822, "chapter_id": 4681, "verse_number": "१७", "content_sanskrit": "क्षयं मनुष्यदेहानां रथनागाश्वसङ्क्षयम् ।\nशृणु राजन् स्थिरो भूत्वा सङ्ग्रामं शंसतो मम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172823, "chapter_id": 4681, "verse_number": "१८", "content_sanskrit": "आशा बलवती राजन् पुत्राणां तेऽभवत् तदा ।\nहते भीष्मे हते द्रोणे सूतपुत्रे च पातिते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172824, "chapter_id": 4681, "verse_number": "१९", "content_sanskrit": "शल्यः पार्थान् रणे सर्वान् निहनिष्यति पार्थिवः ।\nतामाशां हृदये कृत्वा समाश्वास्य च भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172825, "chapter_id": 4681, "verse_number": "२०", "content_sanskrit": "मद्रराजं च समरे समाश्रित्य महारथम् ।\nनाथवन्तमिवात्मानम् अमन्यत सुतस्तव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172826, "chapter_id": 4681, "verse_number": "२१", "content_sanskrit": "यदा कर्णे हते पार्थाः सिंहनादं प्रचक्रिरे ।\nतदा राजन् धार्तराष्ट्रान् आविवेश महद्भयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172827, "chapter_id": 4681, "verse_number": "२२", "content_sanskrit": "तान् समाश्वासयामास मद्रराजो महारथः ।\nव्यूह्य व्यूहं महाराज सर्वतोभद्रमृद्धिमत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172828, "chapter_id": 4681, "verse_number": "२३", "content_sanskrit": "प्रत्युद्यातो रणे पार्थान् मद्रराजः प्रतापवान् ।\nविधून्वन् कार्मुकं चित्रं भारघ्नं वेगवत्तरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172829, "chapter_id": 4681, "verse_number": "२४", "content_sanskrit": "रथप्रवरमास्थाय सैन्यपार्श्वे महारथः ।\nतस्य सीता महाराज रथस्थोऽशोभयद् रथम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172830, "chapter_id": 4681, "verse_number": "२५", "content_sanskrit": "स तेन संवृतो राजा बलेनामित्रकर्शनः ।\nतस्थौ शूरो महाराज पुत्राणां ते भयप्रणुत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172831, "chapter_id": 4681, "verse_number": "२६", "content_sanskrit": "पूर्वतो मद्रराजोऽभून्मुखं व्यूहस्य दंसितः ।\nमद्रकैः सहितो वीरैः कर्णपुत्रैश्च रक्षितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172832, "chapter_id": 4681, "verse_number": "२७", "content_sanskrit": "सव्येऽभूत् कृतवर्मा तु त्रिगर्तैः परिवारितः ।\nगौतमो दक्षिणे पार्श्वे शकैश्च यवनैः सह\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172833, "chapter_id": 4681, "verse_number": "२८", "content_sanskrit": "अश्वत्थामा पृष्ठतोऽभूत् काम्भोजैः परिवारितः ।\nदुर्योधनोऽभवन्मध्ये रक्षितः कुरुपुङ्गवैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172834, "chapter_id": 4681, "verse_number": "२९", "content_sanskrit": "हयानीकेन महता सौबलश्चापि संवृतः ।\nप्रययौ सर्वसैन्यानि कैतव्यश्च महारथः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172835, "chapter_id": 4681, "verse_number": "३०", "content_sanskrit": "पाण्डवेया महेष्वासा व्यूह्य सैन्यमरिन्दमाः ।\nत्रिधा भूता महाराज तव सैन्यमभिद्रवन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172836, "chapter_id": 4681, "verse_number": "३१", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च सात्यकिश्च महारथः ।\nशल्यस्य वाहिनीं तूर्णमभिदुद्रुवुराहवे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172837, "chapter_id": 4681, "verse_number": "३२", "content_sanskrit": "ततो युधिष्ठिरो राजा स्वेनानीकेन संवृतः ।\nशल्यमेवाभिदुद्राव जिघांसुर्भरतर्षभ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172838, "chapter_id": 4681, "verse_number": "३३", "content_sanskrit": "हार्दिक्यं तु महेष्वासः अर्जुनः शत्रुपूगहा ।\nसंशप्तकगणांश्चैव वेगितोऽभिविदुद्रवे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172839, "chapter_id": 4681, "verse_number": "३४", "content_sanskrit": "गौतमं भीमसेनोऽपि सोमकाश्च महारथाः ।\nअभ्यद्रवन्त राजेन्द्र जिघांसन्तः परान् युधि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172840, "chapter_id": 4681, "verse_number": "३५", "content_sanskrit": "माद्रीपुत्रौ च शकुनिमुलूकं च महारथम् ।\nससैन्यौ सहसैवोभावुपतस्थतुराहवे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172841, "chapter_id": 4681, "verse_number": "३६", "content_sanskrit": "तथैवायुतशो योधाः तावकाः पाण्डवान् रणे ।\nअभ्यद्रवन्त सङ्क्रुद्धा विविधायुधपाणयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172842, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172843, "chapter_id": 4681, "verse_number": "३७", "content_sanskrit": "हते भीष्मे महेष्वासे द्रोणे कर्णे जयद्रथे ।\nकुरुष्वल्पावशिष्टेषु पाण्डवेषु च संयुगे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172844, "chapter_id": 4681, "verse_number": "३८", "content_sanskrit": "संरब्धेषु च पार्थेषु पराक्रान्तेषु सञ्जय ।\nमामकानां परेषां च किं शिष्टमभवद् बलम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172845, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172846, "chapter_id": 4681, "verse_number": "३९", "content_sanskrit": "यथा वयं परै राजन् युद्धाय समवस्थिताः ।\nयावच्चासीद् बलं शिष्टं सङ्ग्रामे तन्निबोध मे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172847, "chapter_id": 4681, "verse_number": "४०", "content_sanskrit": "एकादशसहस्राणि रथानां भरतर्षभ ।\nदश दन्तिसहस्राणि सप्त चैव शतानि च\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172848, "chapter_id": 4681, "verse_number": "४१", "content_sanskrit": "पूर्णे शतसहस्रे द्वे हयानां भरतर्षभ ।\nपत्ति कोट्यस्तथा तिस्रो बलमेतत् तवानघ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172849, "chapter_id": 4681, "verse_number": "४२", "content_sanskrit": "रथानां षट् सहस्राणि षट् सहस्राश्च कुञ्जराः ।\nदश चाश्वसहस्राणि पत्तिकोटिशतानि च\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172850, "chapter_id": 4681, "verse_number": "४३", "content_sanskrit": "एतद् बलं पाण्डवानामभवच्छेषमाहवे ।\nएत एव समाजग्मुर्युद्धाय भरतर्षभ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172851, "chapter_id": 4681, "verse_number": "४४", "content_sanskrit": "एवं विभज्य राजेन्द्र मद्रराजमते स्थिताः ।\nपाण्डवान् प्रत्युपाजग्मुः जयगृद्ध्राः प्रमन्यवः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172852, "chapter_id": 4681, "verse_number": "४५", "content_sanskrit": "तथैव पाण्डवाः शूराः समरे जितकाशिनः ।\nउपयाता नरव्याघ्राः पाञ्चालाश्च यशस्विनः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172853, "chapter_id": 4681, "verse_number": "४६", "content_sanskrit": "एवमेते बलौघेन परस्परजयैषिणः ।\nउपयाता महाव्याघ्राः पूर्वां सन्ध्यां प्रति प्रभो\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172854, "chapter_id": 4681, "verse_number": "४७", "content_sanskrit": "ततः प्रववृते युद्धं घोररूपं भयानकम् ।\nतावकानां परेषां च निघ्नतामितरेतरम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172855, "chapter_id": 4681, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172856, "chapter_id": 4681, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]