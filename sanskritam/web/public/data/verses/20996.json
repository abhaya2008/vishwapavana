[{"id": 7000996000, "chapter_id": 20996, "verse_number": "४-२-१", "content_sanskrit": "श्रीपराशर उवाच ।\nयावच्च ब्रह्मलोकात्स ककुद्मी रैवतो नाभ्येति तावत्पुण्यजनसंज्ञा राक्षसास्तामस्य पुरीं कुशस्थलीं निजघ्नुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000996001, "chapter_id": 20996, "verse_number": "४-२-२", "content_sanskrit": "तच्चास्य भ्रातृशतं पुण्यजनत्रासाद्दिशो भेजे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000996002, "chapter_id": 20996, "verse_number": "४-२-३", "content_sanskrit": "तदन्वयाश्च क्षत्रियास्सर्वदिक्ष्वभवन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000996003, "chapter_id": 20996, "verse_number": "४-२-४", "content_sanskrit": "वृष्टस्यापि वार्ष्टकं क्षत्त्रमभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000996004, "chapter_id": 20996, "verse_number": "४-२-५", "content_sanskrit": "नाभागस्यात्मजो नाभागसंत्रोभवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000996005, "chapter_id": 20996, "verse_number": "४-२-६", "content_sanskrit": "तस्याप्यंबरीषः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000996006, "chapter_id": 20996, "verse_number": "४-२-७", "content_sanskrit": "अंबरीषस्यापि विरूपोभवत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000996007, "chapter_id": 20996, "verse_number": "४-२-८", "content_sanskrit": "विरूपात्पृषदश्वो जज्ञे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000996008, "chapter_id": 20996, "verse_number": "४-२-९", "content_sanskrit": "ततश्च रथीतरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000996009, "chapter_id": 20996, "verse_number": "४-२-१०", "content_sanskrit": "अत्रायं श्लोकः ।\nएते क्षत्रप्रसूता वै पुनश्चांगिरसाः स्मृताः ।\nरथीतराणां प्रवराः क्षत्त्रोपेता द्विजातयः इति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000996010, "chapter_id": 20996, "verse_number": "४-२-११", "content_sanskrit": "क्षुतवतश्च मनोरिक्ष्वाकुः पुत्रो जज्ञे घ्राणतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000996011, "chapter_id": 20996, "verse_number": "४-२-१२", "content_sanskrit": "तस्य पुत्रशतप्रधाना विकुक्षिनिमिदंडाख्यास्त्रयः पुत्रा बभूवुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000996012, "chapter_id": 20996, "verse_number": "४-२-१३", "content_sanskrit": "शकुनिप्रमुखाः पंचाशत्पुत्राः उत्तरापथरक्षितारो बभूवुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000996013, "chapter_id": 20996, "verse_number": "४-२-१४", "content_sanskrit": "चत्वारिंशदष्टौ च दक्षिणापथभूपालाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000996014, "chapter_id": 20996, "verse_number": "४-२-१५", "content_sanskrit": "स चेक्ष्वाकुरष्टकायाश्श्राद्धमुत्पाद्य श्राद्धार्हं मांसमानयेति विकुक्षिमाज्ञापयामास ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000996015, "chapter_id": 20996, "verse_number": "४-२-१६", "content_sanskrit": "स तथेति गृहीताज्ञो विधृतशरासनो वनमभ्येत्यानेकशो मृगान् हत्वा श्रांतोतिक्षुत्परीतो विकुक्षिरेकं शशमभक्षयत् ।\nश्षॐ च मांसमानीय पित्रे निवेदयामास ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000996016, "chapter_id": 20996, "verse_number": "४-२-१७", "content_sanskrit": "इक्ष्वाकुकुलाचार्यो वशिष्ठस्तत्प्रोक्षणाय चोदितः प्राह ।\nअलमनेनामेध्येनामिषेण दुरात्मना तव पुत्रेणैतन्मांसमुपहतं यतोऽनेन शशो भक्षितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000996017, "chapter_id": 20996, "verse_number": "४-२-१८", "content_sanskrit": "ततश्चासौ विकुक्षिर्गुरुणैवमुक्तश्शशादसंज्ञामवाप पित्रा च परित्यक्तः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000996018, "chapter_id": 20996, "verse_number": "४-२-१९", "content_sanskrit": "पितर्युपरते चासावखिलामेतां पृथ्वीं धर्मतश्शाशास ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000996019, "chapter_id": 20996, "verse_number": "४-२-२०", "content_sanskrit": "शशादस्य तस्य पुरंजयोनाम पुत्रोभवत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000996020, "chapter_id": 20996, "verse_number": "४-२-२१", "content_sanskrit": "तस्येदं चान्यत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000996021, "chapter_id": 20996, "verse_number": "४-२-२२", "content_sanskrit": "पुरा हि त्रेतायां देवासुरयुद्धमतिभीषणमभवत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000996022, "chapter_id": 20996, "verse_number": "४-२-२३", "content_sanskrit": "तत्र चातिबलिभिरसुरैरमराः पराजितास्ते भगवंतं विष्णुमाराधयांचक्रुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000996023, "chapter_id": 20996, "verse_number": "४-२-२४", "content_sanskrit": "प्रसन्नश्च देवानामनादिनिधनोखिलजगत्परायणो नारायणः प्राह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000996024, "chapter_id": 20996, "verse_number": "४-२-२५", "content_sanskrit": "ज्ञातमेतन्मया युष्माभिर्यदभिलषितं तदर्थमिदं श्रूयताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000996025, "chapter_id": 20996, "verse_number": "४-२-२६", "content_sanskrit": "पुरंजयो नाम राजर्षेश्शशादस्य तनयः क्षत्त्रियवरो यस्तस्य शरीरेहमंश्नो स्वयमेवावतीर्य तानश्षोआ!नसुरान्निहनिष्यामि तद्भवद्भिः पुरंजयोऽसुरवधार्थमुद्योगं कार्यतामिति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000996026, "chapter_id": 20996, "verse_number": "४-२-२७", "content_sanskrit": "एतच्च श्रुत्वा प्रणम्य भगवंतं विष्णुममराः पुरंजयसकाशमाजग्मुरूचुश्चैनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000996027, "chapter_id": 20996, "verse_number": "४-२-२८", "content_sanskrit": "भोभोः क्षत्त्रियवर्यास्माभिरभ्यर्थितेन भवतास्माकमरातिवधोद्यतानां कर्तव्यं साहाय्यमिच्छामः तद्भवतास्माकमभ्यागतानां प्रणयभंगो न कार्य इत्युक्तः पुरंजयः प्राह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000996028, "chapter_id": 20996, "verse_number": "४-२-२९", "content_sanskrit": "त्रैलोक्यनाथो योयं युष्माकमिंद्र ः! शतक्रतुरस्य यद्यहं स्कंधाधिरूढो युष्माकमरातिभस्सह योत्स्ये तदहं भवतां सहायः स्याम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000996029, "chapter_id": 20996, "verse_number": "४-२-३०", "content_sanskrit": "इत्याकर्ण्य समस्तदेवैरिंद्रे ण च बाढमित्येवं समन्विच्छितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000996030, "chapter_id": 20996, "verse_number": "४-२-३१", "content_sanskrit": "ततश्च शतक्रतोर्वृषरूपधारिणः ककुदि स्थितोऽतिरोषसमन्वितो भगवतश्चराचरगुरोरच्युतस्य तेजसाप्यायितो देवासुरसंग्रामे समस्तानेवासुरान्निजघान ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000996031, "chapter_id": 20996, "verse_number": "४-२-३२", "content_sanskrit": "यतश्च वृषभककुदि स्थितेन राज्ञा दैतेयबलं निषूदितमतश्चासौ ककुत्स्थसंज्ञामवाप ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000996032, "chapter_id": 20996, "verse_number": "४-२-३३", "content_sanskrit": "ककुत्स्थस्याप्यनेनाः पुत्रोऽभवत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000996033, "chapter_id": 20996, "verse_number": "४-२-३४", "content_sanskrit": "पृथुरनेनसः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000996034, "chapter_id": 20996, "verse_number": "४-२-३५", "content_sanskrit": "पृथोर्विष्टराश्वः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000996035, "chapter_id": 20996, "verse_number": "४-२-३६", "content_sanskrit": "तस्यापि चांद्रो युवनाश्वः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000996036, "chapter_id": 20996, "verse_number": "४-२-३७", "content_sanskrit": "चांद्र स्य तस्य युवनाश्वस्य शावस्तः यः पुरीं शावस्तीं निवेशयामास ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000996037, "chapter_id": 20996, "verse_number": "४-२-३८", "content_sanskrit": "शावस्तस्य बृहदश्वः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000996038, "chapter_id": 20996, "verse_number": "४-२-३९", "content_sanskrit": "तस्यापि कुवलयाश्वः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000996039, "chapter_id": 20996, "verse_number": "४-२-४०", "content_sanskrit": "योसावुदकस्य महर्षेरपकारिणं दुंदुनामानमसुरं वैष्णवेन तेजसाप्यायितः पुत्रसहस्रैरेकविंशद्भिः परिवृतो जघान दुंदुमारसंज्ञामवाप ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000996040, "chapter_id": 20996, "verse_number": "४-२-४१", "content_sanskrit": "तस्य च तनयास्समस्ता एव दुंदुमुखनिश्वासाग्निना विप्लुष्टा विनेशुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000996041, "chapter_id": 20996, "verse_number": "४-२-४२", "content_sanskrit": "दृढाश्वचंद्रा श्वकपिलाश्वाश्च त्रयः केवलं शो!षिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000996042, "chapter_id": 20996, "verse_number": "४-२-४३", "content_sanskrit": "वृढाश्वाद्धर्यश्वः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000996043, "chapter_id": 20996, "verse_number": "४-२-४४", "content_sanskrit": "तस्माच्च निकुंभः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000996044, "chapter_id": 20996, "verse_number": "४-२-४५", "content_sanskrit": "निकुंभस्यामिताश्वः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000996045, "chapter_id": 20996, "verse_number": "४-२-४६", "content_sanskrit": "ततश्च कृशाश्वः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000996046, "chapter_id": 20996, "verse_number": "४-२-४७", "content_sanskrit": "तस्माच्च प्रसेनजित् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000996047, "chapter_id": 20996, "verse_number": "४-२-४८", "content_sanskrit": "प्रसेनजितो युवनाश्वोभवत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000996048, "chapter_id": 20996, "verse_number": "४-२-४९", "content_sanskrit": "तस्य चापुत्रस्यातिनिर्वेदान्मुनीनामाश्रममंडले निवसतो दयालुभिर्मुनिभिरपत्योत्पादनायेष्टः कृता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000996049, "chapter_id": 20996, "verse_number": "४-२-५०", "content_sanskrit": "तस्यां च मध्यरात्रौ निवृत्तायां मंत्रपूतजलपूर्णं कलशं वेदिमध्ये निवेश्य ते मुनयः सुषुपुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000996050, "chapter_id": 20996, "verse_number": "४-२-५१", "content_sanskrit": "सुप्तेषु तेषु अतीव तृट्परीतस्स भूपालस्तमाश्रमं विवेश ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000996051, "chapter_id": 20996, "verse_number": "४-२-५२", "content_sanskrit": "सुप्तांश्च तानृषीन्नैवोत्थापयामास ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000996052, "chapter_id": 20996, "verse_number": "४-२-५३", "content_sanskrit": "तच्च कलशमपरिमेयमाहात्म्यमंत्रपूतं पपौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000996053, "chapter_id": 20996, "verse_number": "४-२-५४", "content_sanskrit": "प्रबुद्धाश्च ऋषयः पप्रछुः केनैतं मंत्रपूतं वारि पीतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000996054, "chapter_id": 20996, "verse_number": "४-२-५५", "content_sanskrit": "अत्र हि राज्ञो युवनाश्वस्य पत्नी महाबलपराक्रमं पुत्रं जनयिष्यति ।\nइत्याकर्ण्ये स राजा अजानता मया पीतमित्याह ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000996055, "chapter_id": 20996, "verse_number": "४-२-५६", "content_sanskrit": "गर्भश्च युवनाश्वस्योदरे अभवत्क्रमेण च ववृधे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000996056, "chapter_id": 20996, "verse_number": "४-२-५७", "content_sanskrit": "प्राप्तसमयश्च दक्षिणांगुष्ठेन कुक्षिमवनिपतेर्निर्भिद्य निश्चक्राम ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000996057, "chapter_id": 20996, "verse_number": "४-२-५८", "content_sanskrit": "स चासौ राजा ममार ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000996058, "chapter_id": 20996, "verse_number": "४-२-५९", "content_sanskrit": "जातो नामैष कं धास्यतीति ते मुनयः प्रोचुः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000996059, "chapter_id": 20996, "verse_number": "४-२-६०", "content_sanskrit": "अथागत्य देवराजोब्रवीत् मामयं धास्यतीति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000996060, "chapter_id": 20996, "verse_number": "४-२-६१", "content_sanskrit": "ततो माधातृनामा सोभवत् ।\nवक्त्रे चास्य प्रदेशिनी न्यस्ता देवेंद्रे ण न्यस्तातां पपौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000996061, "chapter_id": 20996, "verse_number": "४-२-६२", "content_sanskrit": "तां चामृतस्राविणीमास्वाद्याह्नैव स व्यवर्द्धत ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000996062, "chapter_id": 20996, "verse_number": "४-२-६३", "content_sanskrit": "ततस्तु मांधाता चक्रवर्त्ती सप्तद्वीपां महीं वुभुजे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000996063, "chapter_id": 20996, "verse_number": "४-२-६४", "content_sanskrit": "तत्रायं श्लोकः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000996064, "chapter_id": 20996, "verse_number": "४-२-६५", "content_sanskrit": "यावत्सूर्य उदेत्यस्तं यावच्च प्रतितिष्ठति ।\nसर्वं तद्यौवनाश्वस्य मांधातुः क्षेत्रमुच्यते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000996065, "chapter_id": 20996, "verse_number": "४-२-६६", "content_sanskrit": "मांधाता शतबिंदोर्दुहितरं बिंदुमतीमुपयेमे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000996066, "chapter_id": 20996, "verse_number": "४-२-६७", "content_sanskrit": "पुरुकुत्समंबरीषं मुचुकुंदं च तस्यां पुत्रत्रयमुत्पादयामास ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000996067, "chapter_id": 20996, "verse_number": "४-२-६८", "content_sanskrit": "पंचाशद्दुहितरस्तस्यामेव तस्य नृपतेर्बभूवुः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000996068, "chapter_id": 20996, "verse_number": "४-२-६९", "content_sanskrit": "एकस्मिन्नंतरे बह्वृचश्च सौभरिर्नाम महर्षिरंतर्जले द्वादशाब्दं कालमुवास ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000996069, "chapter_id": 20996, "verse_number": "४-२-७०", "content_sanskrit": "तत्र चांतर्जले संमदो नामातिबहु- प्रजोतिमात्रप्रमाणो मीनाधिपतिरासीत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000996070, "chapter_id": 20996, "verse_number": "४-२-७१", "content_sanskrit": "तस्य च पुत्रपौत्रदौहित्राः पृष्ठतोऽग्रतः पार्श्वयोः पक्षपुच्छशिरसां चोपरि भ्रमंतस्तेनैव सदाहर्निशमतिनिर्वृत्ता रेमिरे ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000996071, "chapter_id": 20996, "verse_number": "४-२-७२", "content_sanskrit": "स चापत्यस्पर्शोपचीयमानप्रहर्षप्रकर्षो बहुप्रकारं तस्य ऋषेः पश्यतस्तैरात्मजपुत्रपौत्रदौहित्रादिभिः सहानुदिनं सुतरां रेमे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000996072, "chapter_id": 20996, "verse_number": "४-२-७३", "content_sanskrit": "अथांतर्जलावस्थितस्सौभरिरेकाग्रतस्समाधिमपहायानुदिनं तस्य सत्स्यस्यात्मजपुत्रपौत्रदौहित्रादिभिस्सहातिरमणीयतामवेक्ष्याचिंतयत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000996073, "chapter_id": 20996, "verse_number": "४-२-७४", "content_sanskrit": "अहो धन्योयमीदृशमनभिमतं योन्यंतरमवाप्यैभिरात्मजपुत्रपौत्रदौहित्रादिभिस्सह रममाणोतीवास्माकं स्पृहामुत्पादयति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000996074, "chapter_id": 20996, "verse_number": "४-२-७५", "content_sanskrit": "वयमप्येवं पुत्रादिभिस्सह ललितं रमिष्याम इत्येवमभिकांक्षन् स तस्मादंतर्जलान्निष्क्रम्य संतानाय निवेष्टुकामः कन्यार्थं मांधातारं राजानमगच्छत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000996075, "chapter_id": 20996, "verse_number": "४-२-७६", "content_sanskrit": "आगमनश्रवणसमनन्तरं चोत्थाय तेन राज्ञा सम्यगर्घ्यादिना संपूजितः कृतासनपरिग्रहः सौभरिरुवाच राजानम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000996076, "chapter_id": 20996, "verse_number": "४-२-७७", "content_sanskrit": "सौभरिरुवाच।\nनिवेष्टुकामोऽस्मि नरेन्द्र कन्यां प्रयच्छ मे मा प्रणयं विभांक्षीः ।\nन ह्यर्थिनः कार्यवशादुपेताः ककुत्स्थवंशो! विमुखाः प्रयांति ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000996077, "chapter_id": 20996, "verse_number": "४-२-७८", "content_sanskrit": "अन्येपि संत्येव नृपाः पृथिव्यां मांधातरेषां तनयाः प्रसूताः ।\nकिं त्वर्थिनामर्थितदानदीक्षाकृतव्रतश्लाघ्यमिदं कुलं ते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000996078, "chapter_id": 20996, "verse_number": "४-२-७९", "content_sanskrit": "शतार्धसंख्यास्तव संति कन्यास्तासां ममैकां नृपते प्रयच्छ ।\nयत्प्रार्थनाभंगभयाद्बिभेमि तस्मादहं राजवरातिदुःखात् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000996079, "chapter_id": 20996, "verse_number": "४-२-८०", "content_sanskrit": "श्रीपराशर उवाच ।\nइति ऋषिवचनमाकर्ण्य स राजा जराजर्जरितदेहमृषिमालोक्य प्रत्याख्यानकातरस्तस्माच्च शापभीतो बिभ्यत्किंचिदधोमुखश्चिरं दध्यौ च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000996080, "chapter_id": 20996, "verse_number": "४-२-८१", "content_sanskrit": "सौभरिरुवाच ।\nनरेंद्र कस्मात्समुपैषि चिंतामसह्यमुक्तं न मयात्र किंचित् ।।\nयावश्यदेया तनया तयैव कृतार्थता नो यदि किं न लब्धा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000996081, "chapter_id": 20996, "verse_number": "४-२-८२", "content_sanskrit": "श्रीपराशर उवाच ।\nअथ तस्य भगवतश्शापभीतस्सप्रश्रयस्तमुवाचासौ राजा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000996082, "chapter_id": 20996, "verse_number": "४-२-८३", "content_sanskrit": "राजोवाच ।\nभगवन् अस्मत्कुलस्थितिरियं य एव कन्याभिरुचितोऽभिजनवान्वरस्तस्मै कन्या प्रदीयते भगवद्याच्ञा चास्मन्मनोरथानामप्यतिगोचरवर्त्तिनी कथमप्येषा संजाता तदेवमुपस्थिते न विद्मः किं कुर्म इत्येतन्मयाऽचिंत्यत इत्यभिहिते च तेन भूभुजा मुनिरचिंतयत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000996083, "chapter_id": 20996, "verse_number": "४-२-८४", "content_sanskrit": "अयमन्योऽस्मत्प्रत्याख्यानोपायो वृद्धोयमनभिमतः स्त्रीणां किमत कन्याकानामित्यमुना संचिंत्यैतदभिहितमेवमस्तु तथा करिष्यामीति संचिंत्य मांधातारमुवाच ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000996084, "chapter_id": 20996, "verse_number": "४-२-८५", "content_sanskrit": "यद्येवं तदादिश्यतामस्माकं प्रवेशाय ।\nकंन्यांतःपुरं वर्षवरो यदि कन्यैव काचिन्मामभिलषति तदाहं दारसंग्रहं करिष्यामि अन्यथा चेत्तदलमस्माकमेतेनातीतकालारंभणेनेत्युक्त्वा विरराम ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000996085, "chapter_id": 20996, "verse_number": "४-२-८६", "content_sanskrit": "ततश्च मांधात्रा मुनिशापशंकितेन कन्यांतःपुरवर्षधरस्समाज्ञप्तः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000996086, "chapter_id": 20996, "verse_number": "४-२-८७", "content_sanskrit": "तेन सह कन्यांतःपुरं प्रविशन्नेव भगवानखिलसिद्धगंधर्वेभ्योतिशयेन कमनीयं रूपमकरोत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000996087, "chapter_id": 20996, "verse_number": "४-२-८८", "content_sanskrit": "प्रवेश्य च तमृषिमंतःपुरे वर्षधरस्ताः कन्याः प्राह ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000996088, "chapter_id": 20996, "verse_number": "४-२-८९", "content_sanskrit": "भवतीनां जनयिता महाराजस्समाज्ञापयति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000996089, "chapter_id": 20996, "verse_number": "४-२-९०", "content_sanskrit": "अयमस्मान् ब्रह्मर्षिः कन्यार्थं समभ्यागतः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000996090, "chapter_id": 20996, "verse_number": "४-२-९१", "content_sanskrit": "मया चास्य प्रतिज्ञातं यद्यस्मत्कन्या या काचिद्भगवंतं वरयति तत्कन्याच्छंदे नाहं परिपंथानं करिष्यामीत्याकर्ण्य सर्वा एव ताः कन्याः सानुरागाः सप्रमदाः करेणव इव मृगयूथपतिं तमृषिमहमहमिकया वरयांबभूवुरूचुश्च ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000996091, "chapter_id": 20996, "verse_number": "४-२-९२", "content_sanskrit": "अलं भगिन्योहमिमं वृणोमि वृणोम्यहं नैष तवानुरूपः ।\nममैष भर्त्ता विधिनैव सृष्टस्सृष्टाहमस्योपशमं प्रयाहि ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000996092, "chapter_id": 20996, "verse_number": "४-२-९३", "content_sanskrit": "वृतो मयायं प्रथमं मयायं गृहं विशन्नेव विहन्यसे किम् ।\nमया मयोतिक्षितिपात्मजानां तदर्थमत्यर्थकलिर्बभूव ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000996093, "chapter_id": 20996, "verse_number": "४-२-९४", "content_sanskrit": "यदा मुनिस्ताभिरतीवहार्दाद्वृतस्स कन्याभिरनिंद्यकीर्तिः ।\nतदा स कन्याधिकृतो नृपाय यथावदाचष्ट विनम्रमूर्त्तिः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000996094, "chapter_id": 20996, "verse_number": "४-२-९५", "content_sanskrit": "श्रीपराशर उवाच ।\nतदवगमात्किंकिमेतत्कथमेतत्किं किं करोमि किं मयाभिहितमित्याकुलमतिरनिच्छन्नपि कथमपि राजानुमेने ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000996095, "chapter_id": 20996, "verse_number": "४-२-९६", "content_sanskrit": "कृतानुरूपविवाहश्च महर्षिस्सकला एव ताः कन्यास्स्वमाश्रममनयत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000996096, "chapter_id": 20996, "verse_number": "४-२-९७", "content_sanskrit": "तत्र चाऽशेषशिल्पकल्पप्रणेतारं धातारमिवान्यं विश्वकर्माणमाहूय सकलकन्यानामेकैकस्याः प्रोत्फुल्लपंकजाः कूजत्कलहंसकारंडवादिविहंगमाभिरामजलाशयास्सोपधानाः ।\nसावकाशास्साधुशय्यापरिच्छदाः प्रासादाः क्रियंतामित्यादिदेश ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000996097, "chapter_id": 20996, "verse_number": "४-२-९८", "content_sanskrit": "तच्च तथैवानुष्ठितमश्षोशिल्पविशेषाचार्यस्त्वष्टा दर्शितवान् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000996098, "chapter_id": 20996, "verse_number": "४-२-९९", "content_sanskrit": "ततः परमर्षिणा सौभरिणाज्ञप्तस्तेषु गृहेष्वनिवार्यानंदकुंदमहानिधिरासांचक्रे ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000996099, "chapter_id": 20996, "verse_number": "४-२-१००", "content_sanskrit": "ततोऽनवरतेन भक्ष्यभोज्यलेह्याद्युपभोगैरागतानुगतभृत्यादीनहर्निशमश्षोगृहेषु ताः क्षितीशदुहितरो भोजयामासुः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000996100, "chapter_id": 20996, "verse_number": "४-२-१०१", "content_sanskrit": "एकदा तु दुहितृस्नेहाकृष्टहृदयस्स महीपतिरतिदुःखितास्ता उत सुखिता वा इति विचिंत्य तस्य महर्षेराश्रमसमीपमुपेत्य स्फुरदंशुमालाललामां स्फटिकमयप्रासादमालामतिरम्योपवनजलाशयां ददर्श ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000996101, "chapter_id": 20996, "verse_number": "४-२-१०२", "content_sanskrit": "प्रविश्य चैकं प्रासादमात्मजां परिष्वज्य कृतासनपरिग्रहः प्रवृद्धस्नेहनयनांबुगर्भनयनोब्रवीत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000996102, "chapter_id": 20996, "verse_number": "४-२-१०३", "content_sanskrit": "अप्यत्र वत्से भवत्यास्सुखमुत किंचिदसुखमपि ते महर्षिस्स्नेहवानुत न स्मर्यतेस्मद्गृहवास इत्युक्ता तं तनया पितरमाह ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000996103, "chapter_id": 20996, "verse_number": "४-२-१०४", "content_sanskrit": "तातातिरमणीयः प्रासादोत्रातिमनोज्ञमुपवनमेते कलवाक्यविहंगमाभिरुताः प्रोत्फुल्लपद्माकरजलाशयाः मनोनुकूलभक्ष्यभोज्यानुलेपनवस्त्रभूषणादिभोगो मृदूनि शयनासनानि सर्वसंपत्समेतं मे गार्हस्थ्यम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000996104, "chapter_id": 20996, "verse_number": "४-२-१०५", "content_sanskrit": "तथापि केन वा जन्मभूमिर्न स्मर्यते ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000996105, "chapter_id": 20996, "verse_number": "४-२-१०६", "content_sanskrit": "त्वत्प्रसादादिदमश्षोमतिशोभनम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000996106, "chapter_id": 20996, "verse_number": "४-२-१०७", "content_sanskrit": "किं त्वेकं ममैतद्दुःखकारणं यदस्मद्गृहान्महर्षिरयम्मद्भर्त्ता न विष्क्रामति ममैव केवलमतिप्रीत्या समीपपरिवर्त्तिनीनामन्यासामस्मद्भगिनीनाम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000996107, "chapter_id": 20996, "verse_number": "४-२-१०८", "content_sanskrit": "एवं च मम सोदर्योतिदुःखिता इत्येवमतिदुःखकारणमित्युक्तस्तया द्वितीयं प्रासादमुपेत्य स्वतनयां परिष्वज्योपविष्टस्तथैव पृष्टवान् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000996108, "chapter_id": 20996, "verse_number": "४-२-१०९", "content_sanskrit": "तयापि च सर्वमेतत्तत्प्रासादाद्युपभोगसुखं भृशमाख्यातं ममैव केवलमतिप्रीत्या पार्श्वपरिवर्त्तिनीनामन्यासामस्मद्भगिनीनामित्येवमादिश्रुत्वा समस्तप्रासादेषु राजा प्रविवेश तनयां तनयां तथैवावृच्छत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000996109, "chapter_id": 20996, "verse_number": "४-२-११०", "content_sanskrit": "सर्वाभिश्च ताभिस्तथैवाभिहितः परितोषविस्मयनिर्भरविवशहृदयो भगवंतं सौभरिमेकांतावस्थितमुपेत्य कृतपूजोब्रवीत् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000996110, "chapter_id": 20996, "verse_number": "४-२-१११", "content_sanskrit": "दृष्टस्ते भगवन् सुमहानेष सिद्धिप्रभावो नैवंविधमन्यस्य कस्यचिदस्माभिर्विभूतिभिर्विलसितमुपलक्षितं यदेतद्भगवतस्तपसः फलमित्यभिपूज्य तमृषिं तत्रैव तेन ऋषिवर्येण सह किंचित्कालमभिमतोपभोगान् बुभुजे स्वपुरं च जगाम ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000996111, "chapter_id": 20996, "verse_number": "४-२-११२", "content_sanskrit": "कालेन गच्छता तस्य तासु राजतनयासु पुत्रशतं सार्धमभवत् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000996112, "chapter_id": 20996, "verse_number": "४-२-११३", "content_sanskrit": "अनुदिनानुरूढस्नेहप्रसरश्च स तत्रातीवममताकृष्टहृदयोऽभवत् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000996113, "chapter_id": 20996, "verse_number": "४-२-११४", "content_sanskrit": "अप्येतेऽस्मत्पुत्राः कलभाषिणः पद्भ्यां गच्छेयुः अप्येते यौवनिनो भवेयुः अपि कृतदारानेतान् पश्येयमप्येषां पुत्रा भवेयुः अप्येतत्पुत्रान्पुत्रसमन्वितान्पश्यामीत्यादिमनोरथाननुदिनं कालसंपत्तिप्रवृद्धानुपेक्ष्यैतच्चिंतयामास ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000996114, "chapter_id": 20996, "verse_number": "४-२-११५", "content_sanskrit": "अहो मे मोहस्यातिविस्तारः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000996115, "chapter_id": 20996, "verse_number": "४-२-११६", "content_sanskrit": "मनोरथानां न समाप्तिरस्ति वर्षायुतेनाप्यथ वापि लक्षैः ।\nपूर्णेषुपूर्णेषु मनोरथानामुत्पत्तयस्संति पुनर्नवानाम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000996116, "chapter_id": 20996, "verse_number": "४-२-११७", "content_sanskrit": "पद्भ्यां गता यौवनिनश्च जाता दारैश्च संयोगमिताः प्रसूताः ।\nदृष्टाः सुतास्तत्तनयप्रसूतिं द्रष्टुं पुनर्वांच्छति मेंऽतरात्मा ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000996117, "chapter_id": 20996, "verse_number": "४-२-११८", "content_sanskrit": "द्रक्ष्यामि तेषामिति चेत्प्रसूतिं मनोरथो मे भविता ततोन्यः ।\nपूर्णेपि तत्राप्यपरस्य जन्म निवार्यते केन मनोरथस्य ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000996118, "chapter_id": 20996, "verse_number": "४-२-११९", "content_sanskrit": "आमृत्युतो नैव मनोरथानामंतोस्ति विज्ञातमिदं मयाद्य ।\nमनोरथासक्तिपरस्य चित्तं न जायते वै परमार्थसंगि ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000996119, "chapter_id": 20996, "verse_number": "४-२-१२०", "content_sanskrit": "स मे समाधिर्जलवासमित्रमत्स्यस्य संगात्सहसैव नष्टः ।\nपरिग्रहस्संगकृतो मयायं परिग्रहोत्था च ममातिलिप्सा ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000996120, "chapter_id": 20996, "verse_number": "४-२-१२१", "content_sanskrit": "दुःखं यदैवैकशरीरजन्म शतार्द्धसंख्याकमिदं प्रसूतम् ।\nपरिग्रहेण क्षितिपात्मजानां सुतैरनेकैर्बहुलीकृतं तत ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000996121, "chapter_id": 20996, "verse_number": "४-२-१२२", "content_sanskrit": "सुतात्मजैस्तत्तनयैश्च भूयो भूयश्च तेषां परिग्रहेण ।\nविस्तारमेष्यत्यतिदुःखहेतुः परिग्रहो वै ममताभिधानः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000996122, "chapter_id": 20996, "verse_number": "४-२-१२३", "content_sanskrit": "चीर्णं तपो यत्तु जलाश्रयेण तस्यार्द्धिरेषा तपसोंतरायः ।\nमत्स्यस्य संगादभवच्च यो मे सुतादिरागो मुषितोस्मि तेन ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000996123, "chapter_id": 20996, "verse_number": "४-२-१२४", "content_sanskrit": "निस्संगता मुक्तिपदं यतीनां संगादशेषाः प्रभवंति दोषाः ।\nआरूढयोगो विनिपात्यतेधस्संगेन योगी किमुताल्पबुद्धिः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000996124, "chapter_id": 20996, "verse_number": "४-२-१२५", "content_sanskrit": "अहं चरिष्यामि तदात्मनोर्थे परिग्रहग्राहगृहीतबुद्धिः ।\nयदा हि भूयः परिहीनदोषो जनस्य दुःखैर्भविता न दुःखी ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000996125, "chapter_id": 20996, "verse_number": "४-२-१२६", "content_sanskrit": "सर्वस्य धातारमचिंत्यरूपमणोरणीयांसमतिप्रमाणम् ।\nसितासितं चेश्वरमीश्वराणामाराधयिष्ये तपसैव विष्णुम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000996126, "chapter_id": 20996, "verse_number": "४-२-१२७", "content_sanskrit": "तस्मिन्नशेषौजसि सर्वरूपिण्यव्यक्तविस्पष्टतनावनंते ।\nममाचलं चित्तमपेतदोषं सदास्तु विष्णावभवाय भूयः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000996127, "chapter_id": 20996, "verse_number": "४-२-१२८", "content_sanskrit": "समस्तभूतादमलादनंतात्सर्वेश्वरादन्यदनादिमध्यात् ।\nयस्मान्न किंचित्तमहं गुरूणां परं गुरुं संश्रयमेमि विष्णुम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000996128, "chapter_id": 20996, "verse_number": "४-२-१२९", "content_sanskrit": "श्रीपराशर उवाच।\nइत्यात्मानमात्मनैवाभिधायासौ सौभरिरपहाय पुत्रगृहासनपरिग्रहादिकमशेषमर्थजातं सकलभार्यासमन्वितो वनं प्रविवेश ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000996129, "chapter_id": 20996, "verse_number": "४-२-१३०", "content_sanskrit": "तत्राप्यनुदिनं वैखानसनिष्पाद्यमशेषक्रियाकलापं निष्पाद्य क्षपितसकलपापः परिपक्वमनोवृत्तिरात्मन्यग्नीन्समारोप्य भिक्षुरभवत् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000996130, "chapter_id": 20996, "verse_number": "४-२-१३१", "content_sanskrit": "भगवत्यासज्याखिलं कर्मकलापं हित्वानं तमजमनादिनिधनमविकारमरणादिधर्ममवाप परमनन्तं परवतामच्युतं पदम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000996131, "chapter_id": 20996, "verse_number": "४-२-१३२", "content_sanskrit": "इत्येतन्मांधातृदुहितृसंबंधादाख्यातम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000996132, "chapter_id": 20996, "verse_number": "४-२-१३३", "content_sanskrit": "यश्चैतत्सौभरिचरितमनुस्मरति पठति पाठयति शृणोति श्रावयति धरत्यवधारयति लिखति लेखयति शिक्षयत्यध्यापयत्युपदिशति वा तस्य षट् जन्मानि दुस्संततिरसद्धर्मो वाड्मनसोरसन्मार्गाचरणमशेषहेतुषु वा ममत्वं न भवति ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}]