[{"id": 40014403, "chapter_id": 9196, "verse_number": "1", "content_sanskrit": "ततोनीलाम्बुदनिभ: प्रहस्तोनामराक्षसः । अब्रवीत्प्राञ्जलिर्वाक्यंशूरस्सेनापतिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014404, "chapter_id": 9196, "verse_number": "2", "content_sanskrit": "देवदानवगन्धर्वाःपिशाचपतगोरगाः । नत्वांधर्षयितुंशक्याःकिंपुनर्वानरारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014405, "chapter_id": 9196, "verse_number": "3", "content_sanskrit": "सर्वेप्रमत्ताविश्वस्तावञ्चितास्स्महनूमता । नहिमेजीवतोगच्छेज्जीवन् सवनगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014406, "chapter_id": 9196, "verse_number": "4", "content_sanskrit": "सर्वांसागरपर्यन्तांसशैलवनकाननाम् । करोम्यवानरांभूमिमाज्ञापयतुमांभवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014407, "chapter_id": 9196, "verse_number": "5", "content_sanskrit": "रक्षांचैवविधास्यामिवानराद्रजनीचर । नागमिष्यतितेदुःखंकिञ्चिदात्मापराधजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014408, "chapter_id": 9196, "verse_number": "6", "content_sanskrit": "अब्रवीच्चसुसङ्कृद्धोदुर्मुखोनामराक्षसः । इदंनक्षमणीयंहिसर्वेषांनःप्रधर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014409, "chapter_id": 9196, "verse_number": "7", "content_sanskrit": "अयंपरिभवोभूयःपुरस्यान्तःपुरस्यच । श्रीमतोराक्षसेन्द्रस्यवानरेणप्रधर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014410, "chapter_id": 9196, "verse_number": "8", "content_sanskrit": "अस्मिन् मुहूर्तेगत्वैकोनिवर्तिष्यामिवानरान् । प्रविष्टान् सागरंभीममम्बरंवारसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014411, "chapter_id": 9196, "verse_number": "9", "content_sanskrit": "ततोऽब्रवीत्सुसङ्कृद्धोवज्रदंष्ट्रोमहाबलः । प्रगृह्यपरिघंघोरंमांसशोणितरूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014412, "chapter_id": 9196, "verse_number": "10", "content_sanskrit": "किंवोहनुमताकार्यंकृपणेनतपस्विना । रामेतिष्ठतिदुर्धर्षेससुग्रीवेऽपिसलक्ष्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014413, "chapter_id": 9196, "verse_number": "11", "content_sanskrit": "अद्यरामंससुग्रीवंपरिघेणसलक्ष्मणम् । आगमिष्यामिहत्वैकोविक्षोभ्यहरिवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014414, "chapter_id": 9196, "verse_number": "12", "content_sanskrit": "इदंममापरंवाक्यंशृणुराजन् यदीच्छसि । उपायकुशलोह्येवजयेच्छत्रूनतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014415, "chapter_id": 9196, "verse_number": "13", "content_sanskrit": "कामरूपधराश्शूरास्सुभीमाभीमदर्शनाः । राक्षसावैसहस्राणिराक्षसाधिपनिश्चिताः ॥ काकुत्स्थमुपसङ्गम्यबिभ्रतोमानुषंवपुः । सर्वेह्यसम्भ्रमाभूत्वाब्रुवन्तुरघुसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014416, "chapter_id": 9196, "verse_number": "14", "content_sanskrit": "कामरूपधराश्शूरास्सुभीमाभीमदर्शनाः । राक्षसावैसहस्राणिराक्षसाधिपनिश्चिताः ॥ काकुत्स्थमुपसङ्गम्यबिभ्रतोमानुषंवपुः । सर्वेह्यसम्भ्रमाभूत्वाब्रुवन्तुरघुसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014417, "chapter_id": 9196, "verse_number": "15", "content_sanskrit": "प्रेषिताभरतेनैवभ्रात्रातवयवीयसा । सहिसेनांसमुत्थाप्यक्षिप्रमेवोपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014418, "chapter_id": 9196, "verse_number": "16", "content_sanskrit": "ततोवयमितस्तूर्णंशूलशक्तिगदाधराः । चापबाणासिहस्ताश्चत्वरितास्तत्रयामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014419, "chapter_id": 9196, "verse_number": "17", "content_sanskrit": "आकाशेगणशस्थ्सित्वाहत्वातांहरिवाहिनीम् । अश्मशस्त्रमहावृष्ट्याप्रापयामयमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014420, "chapter_id": 9196, "verse_number": "18", "content_sanskrit": "एवंचेदुपसर्पेतामनयंरामलक्ष्मणौ । अवश्यमपनीतेनजहतामेवजीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014421, "chapter_id": 9196, "verse_number": "19", "content_sanskrit": "कौम्भकर्णिस्ततोवीरोनिकुम्भोनामवीर्यवान् । अब्रवीत्परमक्रुद्धोरावणंलोकरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014422, "chapter_id": 9196, "verse_number": "20", "content_sanskrit": "सर्वेभवन्तस्तिष्ठन्तुमहाराजेनसङ्गताः । अहमेकोहनिष्यामिराघवंसहलक्ष्मणम् ॥ सुग्रीवञ्चहनूमन्तंसर्वांनेवचवानरान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014423, "chapter_id": 9196, "verse_number": "21", "content_sanskrit": "ततोवज्रहनुर्नामराक्षसःपर्वतोपमः ॥ क्रुद्ध: परिलिहन्सृक्कांजिह्वयावाक्यमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014424, "chapter_id": 9196, "verse_number": "22", "content_sanskrit": "स्वैरंकुर्वन्तुकर्माणिभवन्तोविगतज्वराः ॥ एकोऽहंभक्षयिष्यामितांसर्वांहरियूथपान् । स्वस्थाःक्रीडन्तुनिश्चिन्ताःपिबन्तुमधुवारुणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014425, "chapter_id": 9196, "verse_number": "23", "content_sanskrit": "स्वैरंकुर्वन्तुकर्माणिभवन्तोविगतज्वराः ॥ एकोऽहंभक्षयिष्यामितांसर्वांहरियूथपान् । स्वस्थाःक्रीडन्तुनिश्चिन्ताःपिबन्तुमधुवारुणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014426, "chapter_id": 9196, "verse_number": "24", "content_sanskrit": "अहमेकोवधिष्यामिसुग्रीवंसहलक्ष्मणम् । साङ्गदंचहनूमन्तंरामंचरणकुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]