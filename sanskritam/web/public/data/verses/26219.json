[{"id": 7006219000, "chapter_id": 26219, "verse_number": "२-४७-१", "content_sanskrit": "वसिष्ठ उवाच ततो मूर्द्धाभिषिक्तानां राज्ञाममिततेजसाम् ।\nषट्सहस्रद्वयं रामो जीवग्राहं गृहीतवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006219001, "chapter_id": 26219, "verse_number": "२-४७-२", "content_sanskrit": "ततो राजसहस्राणि गृहीत्वा मुनिभिः सह ।\nस जगाम महातेजाः कुरुक्षेत्रं तपोमयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006219002, "chapter_id": 26219, "verse_number": "२-४७-३", "content_sanskrit": "सरसां पञ्चकं तत्र खानयित्वा भृगुद्वहः ।\nसुखावगाहतीर्थानि तानि चक्रे समन्ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006219003, "chapter_id": 26219, "verse_number": "२-४७-४", "content_sanskrit": "जघान तत्र वै राज्ञः शरीरप्रभवामृजा ।\nसरांसि तानि वै पञ्च पूरयामास भार्गवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006219004, "chapter_id": 26219, "verse_number": "२-४७-५", "content_sanskrit": "स्नात्वा तेषु यथान्यायं जामदग्नयः प्रतापवान् ।\nपितॄन्संतर्पयामास यथाशास्त्रमतन्द्रितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006219005, "chapter_id": 26219, "verse_number": "२-४७-६", "content_sanskrit": "पितुः प्रेतस्य राजेन्द्र श्राद्धादिकमशेषतः ।\nब्राह्मणैः सह मातुश्च तत्र चक्रे यथोदितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006219006, "chapter_id": 26219, "verse_number": "२-४७-७", "content_sanskrit": "एवं तीर्णप्रतीकः स कुरुक्षेत्रे तपोमये ।\nउवासातन्द्रितः सम्यक्पितृपूजापरायणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006219007, "chapter_id": 26219, "verse_number": "२-४७-८", "content_sanskrit": "ततः प्रभृत्यभूद्राजंस्तीर्थानामुत्तमोत्तमम् ।\nविहितं जामदग्न्येन कुरुक्षेत्रे तपोवने ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006219008, "chapter_id": 26219, "verse_number": "२-४७-९", "content_sanskrit": "सस्यमं तपञ्चकमिति स्थानं त्रैलोक्यविश्रुतम् ।\nयत्र यक्रे भृगुश्रेष्ठः पितॄणां तृप्तिमक्षयाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006219009, "chapter_id": 26219, "verse_number": "२-४७-१०", "content_sanskrit": "स्नानदानतपोहोमद्विजभोजनतर्पणैः ।\nभृशमाप्यायितास्तेन यत्र ते पितरोऽखिलाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006219010, "chapter_id": 26219, "verse_number": "२-४७-११", "content_sanskrit": "अवापुरक्षयां तृप्तिं पितृलोकं च शाश्वतम् ।\nसमन्तपञ्चकं नाम तीर्थं लोके परिश्रुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006219011, "chapter_id": 26219, "verse_number": "२-४७-१२", "content_sanskrit": "सर्वपापक्षयकरं महापुण्योपबृंहितम् ।\nमर्त्यानां यत्र यातानामेनांसि निखिलानि तु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006219012, "chapter_id": 26219, "verse_number": "२-४७-१३", "content_sanskrit": "दूरादेवापयास्यन्ति प्रवाते शुष्कपर्णवत् ।\nतत्क्षेत्रचर्यागमनं मर्त्यानामसतामिह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006219013, "chapter_id": 26219, "verse_number": "२-४७-१४", "content_sanskrit": "न लभ्यते महाराज जातु जन्मशतैरपि ।\nसमन्तपञ्चकं तीर्थं कुरुक्षेत्रेऽतिपावनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006219014, "chapter_id": 26219, "verse_number": "२-४७-१५", "content_sanskrit": "यत्र स्नातः सर्वतीर्थैः स्नातो भवति मानवः ।\nकृतकृत्यस्ततो रामः सम्यक्पूर्णमनोरथः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006219015, "chapter_id": 26219, "verse_number": "२-४७-१६", "content_sanskrit": "उवास तत्र नियतः कञ्चित्कालं महामतिः ।\nततः संवत्सरस्यान्ते ब्राह्मणैः सहितो वशी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006219016, "chapter_id": 26219, "verse_number": "२-४७-१७", "content_sanskrit": "पितृपिण्डप्रदानाय जामदग्न्योऽगमद्गयाम् ।\nततो गत्वा ततः श्राद्धे यथाशास्त्रमरिन्दमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006219017, "chapter_id": 26219, "verse_number": "२-४७-१८", "content_sanskrit": "ब्राह्मणांस्तर्पयामास पितॄनुद्दिश्य सत्कृतान् ।\nशैवं तत्र परं स्थानं चन्द्रपादमिति स्मृतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006219018, "chapter_id": 26219, "verse_number": "२-४७-१९", "content_sanskrit": "पितृतृप्तिकरं क्षेत्रं तादृग्लोके न विद्यते ।\nयत्रार्चिताः स्वकुलजैर्यथाशक्ति मनागपि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006219019, "chapter_id": 26219, "verse_number": "२-४७-२०", "content_sanskrit": "पितरः पिण्डदानाद्यैः प्राप्स्यन्ति गतिमक्षयाम् ।\nपितॄनुद्दिश्य तत्रासौ तर्प्पितेषु द्विजातिषु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006219020, "chapter_id": 26219, "verse_number": "२-४७-२१", "content_sanskrit": "ददौ च विधिवत्पिण्डं पितृभक्तिसमन्वितः ।\nततस्तत्पितरः सर्वे पितृलोकादुपागताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006219021, "chapter_id": 26219, "verse_number": "२-४७-२२", "content_sanskrit": "जगृहुस्तत्कृतां पूजां जमदग्निपुरोगमाः ।\nअथ संप्रीतमनसः समेत्य भृगुनन्दनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006219022, "chapter_id": 26219, "verse_number": "२-४७-२३", "content_sanskrit": "ऊचुस्तत्पितरः सर्वेऽदृश्या भूत्वान्तरिक्षगाः ।\nपितर ऊचुः महत्कर्म कृतं वीर भवतान्यैः सुदुष्करम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006219023, "chapter_id": 26219, "verse_number": "२-४७-२४", "content_sanskrit": "अस्मानपि यथान्यायं सम्यक्तर्पितवानसि ।\nअस्माकमक्षयां प्रीतिं तथापि त्वं न यच्छसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006219024, "chapter_id": 26219, "verse_number": "२-४७-२५", "content_sanskrit": "क्षत्रहत्यां हि कृत्वा तु कृतकर्माभवद्यतः ।\nक्षेत्रस्यास्य प्रभावेण भक्त्या च तव दर्शनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006219025, "chapter_id": 26219, "verse_number": "२-४७-२६", "content_sanskrit": "प्राप्ताःस्म पूजिताः किं तु नाक्षय्यफलभागिनः ।\nत्समात्त्वं वीरहत्यादिपापप्रशमनाय हि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006219026, "chapter_id": 26219, "verse_number": "२-४७-२७", "content_sanskrit": "प्रायश्चित्तं यथान्यायं कुरु धर्मं च शाश्वतम् ।\nवधाच्च विनिवर्तस्व क्षत्रियाणामतः परम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006219027, "chapter_id": 26219, "verse_number": "२-४७-२८", "content_sanskrit": "पितुर्न्न तेऽपराध्यन्ते न स्वतन्त्रं यतो जगत् ।\nतन्निमित्तं तु मरणं पितुस्ते विहितं पुरा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006219028, "chapter_id": 26219, "verse_number": "२-४७-२९", "content_sanskrit": "हन्तुं कं कः समर्थः स्याल्लोके रक्षितुमेव वा ।\nनिमित्तमात्रमेवेह सर्वः सर्वस्य चैतयोः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006219029, "chapter_id": 26219, "verse_number": "२-४७-३०", "content_sanskrit": "ध्रुवं कर्मानुरूपं ते चेष्टन्ते सर्व एव हि ।\nकालानुवृत्तं बलवान्नृलोको नात्र संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006219030, "chapter_id": 26219, "verse_number": "२-४७-३१", "content_sanskrit": "बाधितुं भुवि भूतानि भूतानां न विधिं विना ।\nशक्यते वत्स सर्वोऽपि यतः शक्त्या स्वकर्मकृत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006219031, "chapter_id": 26219, "verse_number": "२-४७-३२", "content_sanskrit": "क्षत्रं प्रति ततो रोषं विमुच्यास्मत्प्रियेप्सया ।\nशममा प्नुहि भद्रं ते स ह्यस्माकं परं बलम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006219032, "chapter_id": 26219, "verse_number": "२-४७-३३", "content_sanskrit": "वसिष्ठ उवाच इत्युक्त्वान्तर्दधुः सर्वे पितरो भृगुनन्दनम् ।\nस चापि तद्वचः सर्वं प्रतिजग्राह सादरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006219033, "chapter_id": 26219, "verse_number": "२-४७-३४", "content_sanskrit": "अकृतव्रणसंयुक्तो मुदा परमया युतः ।\nप्रययौ च तदा रामस्तस्मात्सिद्धवनाश्रमम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006219034, "chapter_id": 26219, "verse_number": "२-४७-३५", "content_sanskrit": "तस्मिन्स्थित्वा भृगुश्रेष्ठो ब्राह्मणैः सहितो नृप ।\nतपसे धृतसंकल्पो बभूव स महामनाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006219035, "chapter_id": 26219, "verse_number": "२-४७-३६", "content_sanskrit": "सरथं सहसाहं च धनुःसंहननानि च ।\nपुनरागमसंकेतं कृत्वा प्रास्थापयत्तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006219036, "chapter_id": 26219, "verse_number": "२-४७-३७", "content_sanskrit": "ततः स सर्वतीर्थेषु चक्रे स्नानमतन्द्रितः ।\nपरीत्यपृथिवीं सर्वां पितृदेवादिबूजकः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006219037, "chapter_id": 26219, "verse_number": "२-४७-३८", "content_sanskrit": "एवं क्रमेण पृथिवीं त्रिवारं भुगुनन्दनः ।\nपरिचक्राम राजेन्द्र लोकवृत्तमनुव्रतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006219038, "chapter_id": 26219, "verse_number": "२-४७-३९", "content_sanskrit": "ततः स पर्वतश्रेष्ठं महेन्द्रं पुनरप्यथ ।\nजगाम तपसे राजन्बाह्मणैरभिसंवृतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006219039, "chapter_id": 26219, "verse_number": "२-४७-४०", "content_sanskrit": "स तस्मिंश्चिररात्राय मुनि सिद्धनिषेविते ।\nनिवासमात्मनो राजन्कल्पयामास धर्मवित् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006219040, "chapter_id": 26219, "verse_number": "२-४७-४१", "content_sanskrit": "मुनयस्तं तपस्यन्तं सर्वक्षेत्रनिवासिनः ।\nद्रष्टुकामाः समाजग्मुर्नियता ब्रह्मवादिनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006219041, "chapter_id": 26219, "verse_number": "२-४७-४२", "content_sanskrit": "ददृशुस्ते मुनिगणास्तपस्यासक्तमानसम् ।\nक्षात्रं कक्षमशेषेण दग्ध्वा शान्तमिवानलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006219042, "chapter_id": 26219, "verse_number": "२-४७-४३", "content_sanskrit": "अथ तानागतान्दृष्ट्वा मुनीन्दिव्यांस्तपोमयान् ।\nअर्घ्यादिसमुदाचारैः पूजयामास भार्गवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006219043, "chapter_id": 26219, "verse_number": "२-४७-४४", "content_sanskrit": "कृतकौशलसंप्रश्नपूर्वकाः सुमहोदयाः ।\nतेषां तस्य च संवृत्ताः कथाः पुण्या मनोहराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006219044, "chapter_id": 26219, "verse_number": "२-४७-४५", "content_sanskrit": "ततस्तेषामनुमते मुनीनां भावितात्मनाम् ।\nहयमेधं महायज्ञमाहर्तुमुपचक्रमे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006219045, "chapter_id": 26219, "verse_number": "२-४७-४६", "content_sanskrit": "संभृत्य सर्वसंभारानौर्वाद्यैः सहितो नृप ।\nविश्वामित्रभरद्वाजमार्कण्डेयादिभिस्तथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006219046, "chapter_id": 26219, "verse_number": "२-४७-४७", "content_sanskrit": "तेषा मनुमते कृत्वा काश्यपं गुरुमात्मनः ।\nवाजिमेधं ततो राजन्नाजहार महाक्रतुम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006219047, "chapter_id": 26219, "verse_number": "२-४७-४८", "content_sanskrit": "तस्याभूत्काश्यपोऽध्वर्युरुद्गाता गौतमो मुनिः ।\nविश्वामित्रोऽभवद्धोता रामस्य विदितात्मनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006219048, "chapter_id": 26219, "verse_number": "२-४७-४९", "content_sanskrit": "ब्रह्मत्वमकरोत्तस्य मार्कण्डेयो महामुनिः ।\nभरद्वाजाग्निवेश्याद्या वेद वेदाङ्गपारगाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006219049, "chapter_id": 26219, "verse_number": "२-४७-५०", "content_sanskrit": "मुनयश्चक्रुरन्यानि कर्माण्यन्ये यथाक्रमम् ।\nपुत्त्रैः शिष्यैः प्रशिष्यैश्च सहितो भगवान्भृगुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006219050, "chapter_id": 26219, "verse_number": "२-४७-५१", "content_sanskrit": "सादस्यमकरोद्राजन्नन्यैश्च मुनिभिः सह ।\nस तैः सहाखिलं कर्म समाप्य भृगुपुङ्गवः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006219051, "chapter_id": 26219, "verse_number": "२-४७-५२", "content_sanskrit": "ब्रह्माणं पूजयामास यथावद्गुरुणा सह ।\nअलङ्कृत्य यथान्याय कन्यां रूपवतीं महीम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006219052, "chapter_id": 26219, "verse_number": "२-४७-५३", "content_sanskrit": "पुरग्रामशतोपेतां समुद्रांबरमालिनीम् ।\nआहूय भृगुशार्दूलः सशैलवनकाननाम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006219053, "chapter_id": 26219, "verse_number": "२-४७-५४", "content_sanskrit": "काश्यपाय ददौ सर्वामृते तं शैलमुत्तमम् ।\nआत्मनः सन्निवासार्थं तं रामः पर्यकल्पयत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006219054, "chapter_id": 26219, "verse_number": "२-४७-५५", "content_sanskrit": "ततः प्रभृतिराजेन्द्र पूजयामास शास्त्रतः ।\nहिरण्यरत्नवस्त्रश्वगोगजान्नादिभिस्तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006219055, "chapter_id": 26219, "verse_number": "२-४७-५६", "content_sanskrit": "पुरा समाप्य यज्ञान्ते तथा चावभृथाप्लुतः ।\nचक्रे द्रव्यपरित्यागं तेषामनुमते तदा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006219056, "chapter_id": 26219, "verse_number": "२-४७-५७", "content_sanskrit": "दत्त्वा च सर्वभूतानामभयं भृगुनन्दनः ।\nतत्रापि पर्वतवरे तपश्चर्तुं समारभत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006219057, "chapter_id": 26219, "verse_number": "२-४७-५८", "content_sanskrit": "ततस्तं समनुज्ञाय सदस्या ऋत्विजस्तथा ।\nययुर्यथागतं सर्वे मुनयः शंसितव्रताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006219058, "chapter_id": 26219, "verse_number": "२-४७-५९", "content_sanskrit": "गतेषु तेषु भगवानकृतव्रणसंयुतः ।\nतपो महत्समास्थाय तत्रैव न्यवसत्सुखी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006219059, "chapter_id": 26219, "verse_number": "२-४७-६०", "content_sanskrit": "काश्यपी तु ततो भूमिर्जननाथा ह्यनेकशः ।\nसर्वदुःखप्रशान्त्यर्थं मारीचानुमतेन तु ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006219060, "chapter_id": 26219, "verse_number": "२-४७-६१", "content_sanskrit": "तत्र दीपप्रतिष्ठाख्यव्रतं विष्णुमुखोदितम् ।\nचचार धरणी सम्यक्दुखैर्ःमुक्ताभवच्च सा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006219061, "chapter_id": 26219, "verse_number": "२-४७-६२", "content_sanskrit": "इत्येष जामदग्न्यस्य प्रादुर्भाव उदाहृतः ।\nयस्मिञ्श्रुते नरः सर्वपातकैर्विप्रमुच्यते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006219062, "chapter_id": 26219, "verse_number": "२-४७-६३", "content_sanskrit": "प्रभावः कार्त्तवीर्यस्य लोके प्रथिततेजसः ।\nप्रसंगात्कथितः सम्यङ्नातिसंक्षेपविस्तरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006219063, "chapter_id": 26219, "verse_number": "२-४७-६४", "content_sanskrit": "एवंप्रभावः स नृपः कार्त्तवीर्योऽभवद्भुवि ।\nन तादृशः पुमात्कश्चिद्भावी भूताथवा श्रुतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006219064, "chapter_id": 26219, "verse_number": "२-४७-६५", "content_sanskrit": "दत्तात्रेयाद्वरं वव्रे मृतिमुत्तमपूरुषात् ।\nयत्पुरा सोऽगमन्मुक्तिं रणे रामेण घातितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006219065, "chapter_id": 26219, "verse_number": "२-४७-६६", "content_sanskrit": "तस्यासीत्पञ्चमः पुत्रः पख्यातो यो जयध्वजः ।\nपुत्रस्तस्य महाबाहुस्तालजङ्घोऽभवन्नृप ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006219066, "chapter_id": 26219, "verse_number": "२-४७-६७", "content_sanskrit": "अभूत्तस्यापि पुत्राणां शतमुत्तमधन्विनाम् ।\nतालजङ्घाभिधा येषां वीतिहोत्रोऽग्रजोऽभवत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006219067, "chapter_id": 26219, "verse_number": "२-४७-६८", "content_sanskrit": "पुत्रैः सवीतिहोत्राद्यैर्हैहयाद्यैश्च राजभिः ।\nकालं महान्तमवसद्धिमाद्रिवानगह्वरे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006219068, "chapter_id": 26219, "verse_number": "२-४७-६९", "content_sanskrit": "यः पूर्वं राम बाणेन द्रवन्पृष्ठेऽभिताडितः ।\nतालजङ्घोऽपतद्भूमौ मूर्छितो गाढवेदनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006219069, "chapter_id": 26219, "verse_number": "२-४७-७०", "content_sanskrit": "ददर्श वीतिहोत्रस्तं द्रवन्दैववशादिव ।\nरथमारोप्य वेगेन पलायनपरोऽभवत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006219070, "chapter_id": 26219, "verse_number": "२-४७-७१", "content_sanskrit": "ते तत्र न्यवसन्सर्वे हिमाद्रौ भयपीडिताः ।\nकृच्छ्रं महान्तमासाद्य शाकमूलफलाशनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006219071, "chapter_id": 26219, "verse_number": "२-४७-७२", "content_sanskrit": "ततः शान्तिं गते रामे तपस्यासक्तमानसे ।\nजालजङ्घः स्वकं राज्यं सपुत्रः प्रत्यपद्यत ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006219072, "chapter_id": 26219, "verse_number": "२-४७-७३", "content_sanskrit": "सन्निवेश्य पुरीं भूयः पूर्ववन्नृपसत्तमः ।\nवसंस्तदा निजं राज्यमापालयदरिन्दमः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006219073, "chapter_id": 26219, "verse_number": "२-४७-७४", "content_sanskrit": "सुपुत्रः सानुगबलः पूर्ववैरमनुस्मरन् ।\nअभ्याययौ महाराज तालजङ्घः पुरं तव ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006219074, "chapter_id": 26219, "verse_number": "२-४७-७५", "content_sanskrit": "चतुरङ्गबलोपेतः कंपयन्निव मेदिनीम् ।\nरुरोदाभ्येत्य नगरीमयोध्यां स महीपतिः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006219075, "chapter_id": 26219, "verse_number": "२-४७-७६", "content_sanskrit": "ततो निष्क्रम्य नगरात्फलगुतन्त्रोऽपि ते पिता ।\nयुयुधे तैर्नृपैः सर्वैर्वृद्धोऽपि तरुणो यथा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006219076, "chapter_id": 26219, "verse_number": "२-४७-७७", "content_sanskrit": "निहतानेकमातगतुरङ्गरथसैनिकः ।\nशत्रुभिर्निर्जितो वृद्धः पलायनपरोऽ भवत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006219077, "chapter_id": 26219, "verse_number": "२-४७-७८", "content_sanskrit": "त्यक्त्वा स नगरं राज्यं सकोशबलवाहनम् ।\nअन्तर्वत्न्या च ते मात्रा सहितो वनमाविशत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006219078, "chapter_id": 26219, "verse_number": "२-४७-७९", "content_sanskrit": "तत्र चौर्वाश्रमोपान्ते निवसन्नचिरादिव ।\nशोकामर्षसमाविष्टो वृद्धभावेन च स्वयम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006219079, "chapter_id": 26219, "verse_number": "२-४७-८०", "content_sanskrit": "विलोक्यमानो मात्रा ते बाष्पगद्गदकण्ठया ।\nअनाथ इव राजेन्द्र स्वर्गलोकमितो गतः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006219080, "chapter_id": 26219, "verse_number": "२-४७-८१", "content_sanskrit": "ततस्ते जननी राजन्दुःखशोकसमन्विता ।\nचितामारोपयद्भर्तू रुदती सा कलेवरम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006219081, "chapter_id": 26219, "verse_number": "२-४७-८२", "content_sanskrit": "अनशनादिदुःखेन भर्त्तुर्व्यसनकर्शिता ।\nचकाराग्निप्रवेशाय सुदृढां मतिमात्मनः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006219082, "chapter_id": 26219, "verse_number": "२-४७-८३", "content_sanskrit": "और्वस्तदखिलं श्रुत्वा स्वयमेव महामुनिः ।\nनिर्गत्य चाश्रमात्तां च वारयन्निदमब्रवीत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006219083, "chapter_id": 26219, "verse_number": "२-४७-८४", "content_sanskrit": "न मर्त्तव्यं त्वया राज्ञि सांप्रतं जठरे तव ।\nपुत्रस्तिष्ठति सर्वेषां प्रवरश्चवर्त्तिनाम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006219084, "chapter_id": 26219, "verse_number": "२-४७-८५", "content_sanskrit": "इति तद्वचनं श्रुत्वा माता तव मनस्विनी ।\nविरराम मृतेस्तां तु मुनिः स्वाश्रममानयत् ।\nततः सा सर्वदुःखानि नियम्य त्वन्मुखांबुजम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006219085, "chapter_id": 26219, "verse_number": "२-४७-८६", "content_sanskrit": "दिदृक्षुराश्रमोपान्ते तस्यैव न्यवसत्सुखम् ।\nसुषाव च ततः काले सा त्वामौर्वाश्रमे तदा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006219086, "chapter_id": 26219, "verse_number": "२-४७-८७", "content_sanskrit": "जातकर्मादिकं सर्वं भवतः सोऽकरोन्मुनिः ।\nऔर्वाश्रमे विवृद्धश्च भवांस्तेनानुकंपितः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006219087, "chapter_id": 26219, "verse_number": "२-४७-८८", "content_sanskrit": "त्वयैव विदितं सर्वमतः परमरिन्दम ।\nएवं प्रभावो नृपतिः कार्त्तवीर्योऽभवद्भुवि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006219088, "chapter_id": 26219, "verse_number": "२-४७-८९", "content_sanskrit": "व्रतस्यास्य प्रभावेण सर्वलोकेषु विश्रुतः ।\nयद्वंशजैर्जितो युद्धे पिता ते वनमादिशत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006219089, "chapter_id": 26219, "verse_number": "२-४७-९०", "content_sanskrit": "तद्वृत्तान्तमशेषेण मया ते समुदीरितम् ।\nएतच्च सर्वमाख्यातं व्रतानामुत्तमं तव ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006219090, "chapter_id": 26219, "verse_number": "२-४७-९१", "content_sanskrit": "समन्त्रतन्त्रं लोकेषु सर्वलोकफलप्रदम् ।\nन ह्यस्य कर्त्तुर्नृपतेः पुरुषार्थचतुष्टये ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006219091, "chapter_id": 26219, "verse_number": "२-४७-९२", "content_sanskrit": "भवत्यभीप्सितं किञ्चिद्दर्ल्लभं भुवनत्रये ।\nसंक्षेपेण मयाख्यातं व्रतं हैहयभूभुजः ।\nजामदग्न्यस्य च मुने किमन्यत्कथयामि ते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006219092, "chapter_id": 26219, "verse_number": "२-४७-९३", "content_sanskrit": "जैमिनिरुवाच ततः स सगरो राजा कृताञ्जलिपुटो मुनिम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006219093, "chapter_id": 26219, "verse_number": "२-४७-९४", "content_sanskrit": "उवाच भगवन्नेतत्कर्तुमिच्छाम्यहं व्रतम् ।\nसम्यक्तमुपदेशेन तत्रानुज्ञां प्रयच्छ मे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006219094, "chapter_id": 26219, "verse_number": "२-४७-९५", "content_sanskrit": "कर्मणानेन विप्रर्षे कृतार्थोऽस्मि न संशयः ।\nइत्युक्तस्तेन राज्ञातु तथेत्युक्त्वा महामुनिः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006219095, "chapter_id": 26219, "verse_number": "२-४७-९६", "content_sanskrit": "दीक्षयामास राजानं शस्त्रोक्तेनैव वर्त्मना ।\nस दीक्षितो वसिष्ठेन सगरो राजसत्तमः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006219096, "chapter_id": 26219, "verse_number": "२-४७-९७", "content_sanskrit": "द्रव्याण्यानीय विधिवत्प्रचचार शुभव्रतम् ।\nपूजयित्वा जगन्नाथं विधिना तेन पार्थिवः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006219097, "chapter_id": 26219, "verse_number": "२-४७-९८", "content_sanskrit": "समाप्य च यथायोग्यमनुज्ञाय गुरुं ततः ।\nप्रतिज्ञामकरोद्राजा व्रतमेतदनुत्तमम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006219098, "chapter_id": 26219, "verse_number": "२-४७-९९", "content_sanskrit": "आजीवान्तं धरिष्यामि यत्नेनेति महामतिः ।\nअथानुज्ञाप्य राजानं वसिष्ठो भगवानृषिः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006219099, "chapter_id": 26219, "verse_number": "२-४७-१००", "content_sanskrit": "सन्निवर्त्यानुगच्छन्तं प्रजगाम निजाश्रमम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]