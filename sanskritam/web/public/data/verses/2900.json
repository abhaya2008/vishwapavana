[{"id": 2088817, "chapter_id": 2900, "verse_number": "१३-३०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nब्राह्मणानां तु ये लोके प्रतिश्रुत्य पितामह।\nन प्रयच्छन्ति लोभात्ते के भवन्ति महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088818, "chapter_id": 2900, "verse_number": "१३-३०-२", "content_sanskrit": "एतन्मे तत्वतो ब्रूहि धर्मे धर्मभृतांवर।\nप्रतिश्रुत्य दुरात्मानो न प्रयच्छन्ति ये नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088819, "chapter_id": 2900, "verse_number": "१३-३०-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088820, "chapter_id": 2900, "verse_number": "१३-३०-३", "content_sanskrit": "यो न दद्यात्प्रतिश्रुत्य स्वल्पं वा यदि वा बहु।\nआशास्तस्य हताः सर्वाः क्लीबस्येव प्रजाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088821, "chapter_id": 2900, "verse_number": "१३-३०-४", "content_sanskrit": "यां रात्रिं जायते पापो यां च रात्रिं विनश्यति।\nएतस्मिन्नन्तरे यद्यत्सुकृतं तस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088822, "chapter_id": 2900, "verse_number": "१३-३०-५", "content_sanskrit": "यच्च तस्य हुतं किञ्चिद्दत्तं वा भरतर्षभ।\nतपस्तप्तमथो वाऽपि सर्वं तस्योपहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088823, "chapter_id": 2900, "verse_number": "१३-३०-६", "content_sanskrit": "अथैतद्वचनं प्राहुर्धर्मशास्त्रविदो जनाः।\nनिशास्य भरतश्रेष्ठ बुद्ध्या परमयुक्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088824, "chapter_id": 2900, "verse_number": "१३-३०-७", "content_sanskrit": "अपि चोदाहरन्तीमं धर्मशास्त्रविदो जनाः।\nअश्वानां श्यामकर्णानां सहस्रेण स मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088825, "chapter_id": 2900, "verse_number": "१३-३०-८", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nसृगालस्य च संवादं वानरस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088826, "chapter_id": 2900, "verse_number": "१३-३०-९", "content_sanskrit": "तौ सखायौ पुरा ह्यास्तां मानुषत्वे परंतप।\nअन्यां योनिं समापन्नौ सृगालीं वानरीं तथा।\nसम्भाषणात्ततः सख्यं तत्रतत्र परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088827, "chapter_id": 2900, "verse_number": "१३-३०-१०", "content_sanskrit": "ततः परासून्खादन्तं सृगालं वानरोऽब्रवीत्।\nश्मशानमध्ये सम्प्रेक्ष्य पूर्वजातिमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088828, "chapter_id": 2900, "verse_number": "१३-३०-११", "content_sanskrit": "किं त्वया पापकं पूर्वं कृतं कर्म सुदारुणम्।\nयस्त्वं श्मशाने मृतकान्पूतिकानत्सि कुत्सितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088829, "chapter_id": 2900, "verse_number": "१३-३०-१२", "content_sanskrit": "एवमुक्तः प्रत्युवाच सृगालो वानरं तदा।\nब्राह्मणस्य प्रतिश्रुत्य न मया तदुपाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088830, "chapter_id": 2900, "verse_number": "१३-३०-१३", "content_sanskrit": "तत्कृते पापिकां योनिमापन्नोस्मि प्लवङ्गम।\nतस्मादेवंविधं भक्ष्यं भक्षयामि बुभुक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088831, "chapter_id": 2900, "verse_number": "१३-३०-१४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088832, "chapter_id": 2900, "verse_number": "१३-३०-१४", "content_sanskrit": "सृगालो वानरं प्राह पुनरेव नरोत्तम।\nकिं त्वया पातकं कर्म कृतं येनासि वानरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088833, "chapter_id": 2900, "verse_number": "१३-३०-१५x", "content_sanskrit": "वानर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088834, "chapter_id": 2900, "verse_number": "१३-३०-१५", "content_sanskrit": "स चाप्याह फलाहारो ब्राह्मणानां प्लवङ्गमः।\nतस्मान्न ब्राह्मणस्वं तु हर्त्तव्यं विदुषा सदा।\nसीमाविवादे मोक्तव्यं दातव्यं च प्रतिश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088835, "chapter_id": 2900, "verse_number": "१३-३०-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088836, "chapter_id": 2900, "verse_number": "१३-३०-१६", "content_sanskrit": "इत्येतद्ब्रुवतो राजन्ब्राह्मणस्य मया श्रुतम्।\nकथां कथयतः पुण्यां धर्मज्ञस्य पुरातनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088837, "chapter_id": 2900, "verse_number": "१३-३०-१७", "content_sanskrit": "श्रुतं चापि मया भूयः कृष्णस्यापि विशांपते।\nकथां कथयतः पूर्वं ब्राह्मणं प्रति पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088838, "chapter_id": 2900, "verse_number": "१३-३०-१८", "content_sanskrit": "न हर्तव्यं विप्रधनं क्षन्तव्यं तेषु नित्यशः।\nबालाश्च नावमन्तव्या दरिद्राः कृपणा अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088839, "chapter_id": 2900, "verse_number": "१३-३०-१९", "content_sanskrit": "एवमेव च मां नित्यं ब्राह्मणाः संदिशन्ति वै।\nप्रतिश्रुतं भवेद्देयं नाशा कार्या द्विजोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088840, "chapter_id": 2900, "verse_number": "१३-३०-२०", "content_sanskrit": "ब्राह्मणो ह्याशया पूर्वं कृतया पृथिवीपते।\nसुसमिद्धो यता दीप्तः पावकस्तद्विधः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088841, "chapter_id": 2900, "verse_number": "१३-३०-२१", "content_sanskrit": "यं निरीक्षेत सङ्क्रुद्ध आशया पूर्वजातया।\nप्रदहेच्च हितं राजन्कक्षमक्षय्यभुग्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088842, "chapter_id": 2900, "verse_number": "१३-३०-२२", "content_sanskrit": "स एव हि यदा तुष्टो वचसा प्रतिनन्दति।\nभवत्यगदसंकाशो विषये तस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088843, "chapter_id": 2900, "verse_number": "१३-३०-२३", "content_sanskrit": "पुत्रान्पौत्रान्पशूंश्चैव बान्धवान्सचिवांस्तथा।\nपुरं जनपदं चैव शान्तिरिष्टेन पोषयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088844, "chapter_id": 2900, "verse_number": "१३-३०-२४", "content_sanskrit": "एतद्धि परमं तेजो ब्राह्मणस्येह दृश्यते।\nसहस्रकिरणस्येव सवितुर्धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088845, "chapter_id": 2900, "verse_number": "१३-३०-२५", "content_sanskrit": "तस्माद्दातव्यमेवेह प्रतिश्रुत्य युधिष्ठिर।\nयदीच्छेच्छोभनां जातिं प्राप्तुं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088846, "chapter_id": 2900, "verse_number": "१३-३०-२६", "content_sanskrit": "ब्राह्मणस्य हि दत्तेन ध्रुवं स्वर्गो ह्यनुत्तमः।\nशक्यः प्राप्तुं विशेषेण दानं हि महती क्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088847, "chapter_id": 2900, "verse_number": "१३-३०-२७", "content_sanskrit": "इतो दत्तेन जीवन्ति देवताः पितरस्था।\nतस्माद्दानानि देयानि ब्राह्मणेभ्यो विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088848, "chapter_id": 2900, "verse_number": "१३-३०-२८", "content_sanskrit": "महद्धि भरतश्रेष्ठ ब्राह्मणस्तीर्थमुच्यते।\nवेलायां न तु कस्यां चिद्गच्छेद्विप्रो ह्यपूजितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088849, "chapter_id": 2900, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिंशोऽध्यायः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]