 {"id": 900001860, "chapter_id": 8250, "verse_number": "7.163", "content_sanskrit": "यदीच्छया यजेत्तेषामपहर्ता भविष्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 900001861, "chapter_id": 8250, "verse_number": "7.164", "content_sanskrit": "सप्तान्नसृष्टितत्वज्ञस्त्वेकहोमेन मुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 900001862, "chapter_id": 8250, "verse_number": "7.165", "content_sanskrit": "अथ त्रयो वाव लोका मनुष्यलोकः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 900001863, "chapter_id": 8250, "verse_number": "7.166", "content_sanskrit": "पृथिव्यै चैनमग्नेश्च दैवी वागाविशति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}, {"id": 900001864, "chapter_id": 8250, "verse_number": "7.167", "content_sanskrit": "अथातो व्रतमीमांसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 167}, {"id": 900001865, "chapter_id": 8250, "verse_number": "7.168", "content_sanskrit": "अथाधिदैवतं ज्वलिष्याम्येवाहमित्यग्निर्दध्रे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 168}, {"id": 900001866, "chapter_id": 8250, "verse_number": "7.169", "content_sanskrit": "इन्द्रियाणि ससर्जादौ वासुदेवः प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 169}, {"id": 900001867, "chapter_id": 8250, "verse_number": "7.170", "content_sanskrit": "तानेताञ्छ्रमरूपेण प्राप ब्रह्मा प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 170}, {"id": 900001868, "chapter_id": 8250, "verse_number": "7.171", "content_sanskrit": "त्रयं वा इदं नाम रूपं कर्म तेषां नाम्नां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 171}]