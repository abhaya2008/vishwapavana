[{"id": 6000262000, "chapter_id": 10262, "verse_number": null, "content_sanskrit": "अथ षट्‌षष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "तथा कुबेरेण सह युद्धे तत्कार्मुकच्छेदः", "range": null}]}, {"id": 6000262001, "chapter_id": 10262, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.001.m4a", "display_order": 2}, {"id": 6000262002, "chapter_id": 10262, "verse_number": "१०-६६-१", "content_sanskrit": "सुरानभिद्रुतान् दृष्ट्वा सत्यामाह जगत्पतिः।\nइमे प्राहुणिकाः प्राप्तास्तव वृन्दारका इति॥ १०/६६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.002.m4a", "display_order": 3}, {"id": 6000262003, "chapter_id": 10262, "verse_number": "१०-६६-२", "content_sanskrit": "तथा ब्रुवाणे देवेशे प्रेषिता देवसैनिकाः।\nनदन्तो मुमुचुः कृष्णे शरवृष्टिं कुरूद्वह॥ १०/६६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.003.m4a", "display_order": 4}, {"id": 6000262004, "chapter_id": 10262, "verse_number": "१०-६६-३", "content_sanskrit": "ततः शार्ङ्गं समादाय सत्या व्यसनविक्लवा।\nमुक्तांश्चिच्छेद बाणौघैस्ताञ्छरान् देवसैनिकैः॥ १०/६६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.004.m4a", "display_order": 5, "topics": [{"text": "आगतैर्देवैः सह शार्ङ्गहस्तायाः सत्यभामाया युद्धम्", "range": "३–९"}]}, {"id": 6000262005, "chapter_id": 10262, "verse_number": "१०-६६-४", "content_sanskrit": "ततो वैश्रवणः श्रीमान् बहुभिर्गुह्यकैर्वृतः।\nविष्फारयंस्तालमात्रं कार्मुकं कनकाटवि॥ १०/६६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.005.m4a", "display_order": 6}, {"id": 6000262006, "chapter_id": 10262, "verse_number": "१०-६६-५", "content_sanskrit": "स्वर्णपुङ्खान् शरान् मुञ्चन् सिंहवच्च नदन् मुहुः।\nअभिदुद्राव समरे तिष्ठ तिष्ठेति चाब्रवीत्॥ १०/६६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.006.m4a", "display_order": 7}, {"id": 6000262007, "chapter_id": 10262, "verse_number": "१०-६६-६", "content_sanskrit": "तं पञ्चभिः शरैः सत्या निशितैर्मर्मभेदिभिः।\nअर्पयामास वेगेन विशाले जठरे नृप॥ १०/६६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.007.m4a", "display_order": 8}, {"id": 6000262008, "chapter_id": 10262, "verse_number": "१०-६६-७", "content_sanskrit": "सोऽतिविद्धो रणे बाणैस्‍त्रिभिः भल्लैर्हरिप्रियाम्।\nअयोधयद् धनपतिः सिंहनादं व्यनीनदत्॥ १०/६६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.008.m4a", "display_order": 9}, {"id": 6000262009, "chapter_id": 10262, "verse_number": "१०-६६-८", "content_sanskrit": "तानप्राप्तानर्धचन्द्रैस्‍त्रिभिश्चिच्छेद सा शरैः।\nभूयोऽष्टभिः शरैर्देवी वत्सदन्तैर्मनोजवैः॥ १०/६६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.009.m4a", "display_order": 10}, {"id": 6000262010, "chapter_id": 10262, "verse_number": "१०-६६-९", "content_sanskrit": "विव्याध गुह्यकपतेर्ललाटे कुरुपुङ्गव।\nपीडितस्तैर्भृशं बाणैः पौलस्त्यः क्रोधमूर्च्छितः॥ १०/६६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.010.m4a", "display_order": 11}, {"id": 6000262011, "chapter_id": 10262, "verse_number": "१०-६६-१०", "content_sanskrit": "सन्दधे निशितान् बाणानेकविंशतिसंयुगे।\nतानन्तरे सत्यभामा सायकैः सप्तभिर्नृप॥ १०/६६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.011.m4a", "display_order": 12}, {"id": 6000262012, "chapter_id": 10262, "verse_number": "१०-६६-११", "content_sanskrit": "चिच्छेद निमिषार्धेन त्रिधैकैकं हरिप्रिया।\nसत्यभामा ततः क्रुद्धा पौलस्त्यस्य महद्धनुः॥ १०/६६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.012.m4a", "display_order": 13}, {"id": 6000262013, "chapter_id": 10262, "verse_number": "१०-६६-१२", "content_sanskrit": "अर्धचन्द्रेण चिच्छेद मुष्टिदेशे द्विधा नृप।\nततोऽन्यच्चापमादाय सज्जं कृत्वा धनेश्वरः॥ १०/६६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.013.m4a", "display_order": 14}, {"id": 6000262014, "chapter_id": 10262, "verse_number": "१०-६६-१३", "content_sanskrit": "ववर्ष शरजालानि क्रोधात् सर्प इव श्वसन्।\nसर्वांस्तान् सायकान् सङ्ख्ये शरैः सन्नतपर्वभिः॥ १०/६६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.014.m4a", "display_order": 15}, {"id": 6000262015, "chapter_id": 10262, "verse_number": "१०-६६-१४", "content_sanskrit": "चिच्छेद लीलया देवी तदद्भुतमिवाभवत्।\nततः क्रुद्धो वैश्रवणः सत्यभामां विलोक्य च॥ १०/६६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.015.m4a", "display_order": 16}, {"id": 6000262016, "chapter_id": 10262, "verse_number": "१०-६६-१५", "content_sanskrit": "प्राह पश्य हनिष्यामि त्वामद्य मम पौरुषम्।\nइत्युक्त्वा तालमात्रे तु चापे गुह्यकसत्तमः॥ १०/६६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.016.m4a", "display_order": 17}, {"id": 6000262017, "chapter_id": 10262, "verse_number": "१०-६६-१६", "content_sanskrit": "पश्यतां सर्वदेवानां मार्ष्टुकामः पराभवम्।\nसन्दधे सूदितुं देवीमर्धचन्द्रं शरोत्तमम्॥ १०/६६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.017.m4a", "display_order": 18}, {"id": 6000262018, "chapter_id": 10262, "verse_number": "१०-६६-१७", "content_sanskrit": "तदवेत्य मनस्तस्य क्षुरप्रेण हरिप्रिया।\nचिच्छेद कार्मुकं तस्य मुष्टिदेशे कुरूद्वह॥ १०/६६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.018.m4a", "display_order": 19}, {"id": 6000262019, "chapter_id": 10262, "verse_number": "१०-६६-१८", "content_sanskrit": "ततो मुद्गरमादाय घोरं दानवभीषणम्।\nभ्रामयित्वा शतगुणं देव्यै चिक्षेप वित्तपः॥ १०/६६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.019.m4a", "display_order": 20, "topics": [{"text": "एवं कुबेरं जितवत्याः सत्यभामायाः प्रशंसनपूर्वकं श्रीकृष्णस्य देवैः सह युद्धारम्भः", "range": "१८–२३"}]}, {"id": 6000262020, "chapter_id": 10262, "verse_number": "१०-६६-१९", "content_sanskrit": "तं मुद्गरं महाघोरमायान्तं कुरुपुङ्गव।\nवामेन पाणिना कृष्णो जग्राहोच्चैर्जहास च॥ १०/६६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.020.m4a", "display_order": 21}, {"id": 6000262021, "chapter_id": 10262, "verse_number": "१०-६६-२०", "content_sanskrit": "ततो निवृत्तसङ्ग्रामो विदुद्राव धनेश्वरः।\nशशंस देवीं कृष्णश्च समाश्लिष्याभिपूजयन्॥ १०/६६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.021.m4a", "display_order": 22}, {"id": 6000262022, "chapter_id": 10262, "verse_number": "१०-६६-२१", "content_sanskrit": "पलायिते धनपतौ सङ्ग्रामे कंसवैरिणा।\nवरुणोऽभ्यद्रवत् कृष्णं पाशमुद्यम्य संयुगे॥ १०/६६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.022.m4a", "display_order": 23}, {"id": 6000262023, "chapter_id": 10262, "verse_number": "१०-६६-२२", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य तार्क्ष्यो मकरवाहनम्।\nअभ्यद्रवन्महासत्वः शार्दूल इव गोवृषम्॥ १०/६६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.023.m4a", "display_order": 24}, {"id": 6000262024, "chapter_id": 10262, "verse_number": "१०-६६-२३", "content_sanskrit": "तयोः समभवद् युद्धं घोरं तार्क्ष्यजलेशयोः।\nयथा देवासुरे युद्धे बलिवासवयोरिव॥ १०/६६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.024.m4a", "display_order": 25}, {"id": 6000262025, "chapter_id": 10262, "verse_number": "१०-६६-२४", "content_sanskrit": "तत्र काश्यपपुत्रस्य कण्ठे पाशं जलेश्वरः।\nक्रुद्धश्चकर्ष विन्यस्य सिंहः सिंहमिवौजसा॥ १०/६६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.025.m4a", "display_order": 26, "topics": [{"text": "गरुडेन वरुणपराजयः", "range": "२४–२५"}]}, {"id": 6000262026, "chapter_id": 10262, "verse_number": "१०-६६-२५", "content_sanskrit": "तं पक्षकोट्या गरुडः समुद्धृत्य जलेश्वरम्।\nपद्भ्यां गृहीत्वा मकरं चिक्षेप वरुणालये॥ १०/६६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.026.m4a", "display_order": 27}, {"id": 6000262027, "chapter_id": 10262, "verse_number": "१०-६६-२६", "content_sanskrit": "कृच्छ्राद् गृहीतपाशस्तु वरुणो गतवाहनः।\nपदातिरेव सङ्ग्रामाद् विदुद्राव यथागतम्॥ १०/६६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.027.m4a", "display_order": 28}, {"id": 6000262028, "chapter_id": 10262, "verse_number": "१०-६६-२७", "content_sanskrit": "तथा गते वार्धिपतौ सङ्ग्रामे वायुपावकौ।\nसममेवाभ्यवर्तेतां गोविन्दं कुरुसत्तम॥ १०/६६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.028.m4a", "display_order": 29}, {"id": 6000262029, "chapter_id": 10262, "verse_number": "१०-६६-२८", "content_sanskrit": "पावकः पञ्चभिर्बाणैर्मारुतश्च तथा त्रिभिः।\nअयोधयद् हृषीकेशं तदद्भुतमिवाभवत्॥ १०/६६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.029.m4a", "display_order": 30}, {"id": 6000262030, "chapter_id": 10262, "verse_number": "१०-६६-२९", "content_sanskrit": "ततः प्रहस्य गोविन्दो बाणेनैकेन पावकम्।\nविव्याध सप्तभिश्चैव समीरणमरिन्दमः॥ १०/६६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.030.m4a", "display_order": 31}, {"id": 6000262031, "chapter_id": 10262, "verse_number": "१०-६६-३०", "content_sanskrit": "एकेनाग्निः क्षुरप्रेण गाढं वक्षसि ताडितः।\nतमसाधारणं मत्वा विदुद्राव रणाद् द्रुतम्॥ १०/६६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.031.m4a", "display_order": 32}, {"id": 6000262032, "chapter_id": 10262, "verse_number": "१०-६६-३१", "content_sanskrit": "दृष्ट्वा समीरणो युद्धादपयातं हुताशनम्।\nसायकाचितसर्वाङ्गमात्मानं चातिविह्वलः॥ १०/६६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.032.m4a", "display_order": 33}, {"id": 6000262033, "chapter_id": 10262, "verse_number": "१०-६६-३२", "content_sanskrit": "विदित्वा पुण्डरीकाक्षं सङ्ग्रामे प्रत्युपस्थितम्।\nन्यवर्तत कुरुश्रेष्ठ प्राणत्राणपरायणः॥ १०/६६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.033.m4a", "display_order": 34}, {"id": 6000262034, "chapter_id": 10262, "verse_number": "१०-६६-३३", "content_sanskrit": "ततो महिषमारुह्य दण्डमुद्यम्य भास्वरम्।\nकृष्णमभ्यद्रवद् युद्धे यमः क्रोधारुणेक्षणः॥ १०/६६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.034.m4a", "display_order": 35}, {"id": 6000262035, "chapter_id": 10262, "verse_number": "१०-६६-३४", "content_sanskrit": "तमुद्यतमहादण्डं दृष्ट्वा कमललोचनः।\nगदां विसृज्य तद्धस्तात् पातयामास भूतले॥ १०/६६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.035.m4a", "display_order": 36}, {"id": 6000262036, "chapter_id": 10262, "verse_number": "१०-६६-३५", "content_sanskrit": "गदया ताडिते दण्डे त्रस्तहस्तः परेतराट्।\nविदुद्राव परावृत्य महिषेण कुरूद्वह॥ १०/६६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.036.m4a", "display_order": 37}, {"id": 6000262037, "chapter_id": 10262, "verse_number": "१०-६६-३६", "content_sanskrit": "वैवस्वतं गतं दृष्ट्वा निर्ऋतिर्भयविह्वलः।\nनाभ्यवर्तत गोविन्दं योद्धुं विदिततद्बलः॥ १०/६६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.037.m4a", "display_order": 38}, {"id": 6000262038, "chapter_id": 10262, "verse_number": "१०-६६-३७", "content_sanskrit": "शङ्करस्तु महातेजास्‍त्रिशूली वृषवाहनः।\nअनेकभूतसङ्घातैः कृष्णमभ्यद्रवद् रणे॥ १०/६६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.038.m4a", "display_order": 39, "topics": [{"text": "कृष्णेन त्रिशूलिनः पराजयः", "range": "३७–४९"}]}, {"id": 6000262039, "chapter_id": 10262, "verse_number": "१०-६६-३८", "content_sanskrit": "तावुभौ लोकविख्यातौ बलिनौ वीर्यशालिनौ।\nचक्राते कदनं घोरं परस्परजयैषिणौ॥ १०/६६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.039.m4a", "display_order": 40}, {"id": 6000262040, "chapter_id": 10262, "verse_number": "१०-६६-३९", "content_sanskrit": "ईशानो दशभिर्बाणैः कृष्णं तार्क्ष्यं च पञ्चभिः।\nविव्याध समरे राजन् तिष्ठतिष्ठेति चाब्रवीत्॥ १०/६६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.040.m4a", "display_order": 41}, {"id": 6000262041, "chapter_id": 10262, "verse_number": "१०-६६-४०", "content_sanskrit": "ततः शार्ङ्गं समादाय कृष्णः परपुरञ्जयः।\nत्रिंशद्भिर्युगपद् बाणैर्विव्याध वृषवाहनम्॥ १०/६६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.041.m4a", "display_order": 42}, {"id": 6000262042, "chapter_id": 10262, "verse_number": "१०-६६-४१", "content_sanskrit": "गरुडः पन्नगरिपुः पद्भ्यां द्वाभ्यां च संयुगे।\nपक्षाभ्यां चञ्चुकोट्या च मर्दयामास तं वृषम्॥ १०/६६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.042.m4a", "display_order": 43}, {"id": 6000262043, "chapter_id": 10262, "verse_number": "१०-६६-४२", "content_sanskrit": "भूयोऽपि कृष्णो नाराचैः पञ्चाशत्प्रमितैर्नृप।\nयोधयामास समरे शङ्करं लोकशङ्करम्॥ १०/६६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.043.m4a", "display_order": 44}, {"id": 6000262044, "chapter_id": 10262, "verse_number": "१०-६६-४३", "content_sanskrit": "ततस्त्रिशूलमाविध्य निशितं घोरदर्शनम्।\nप्राहिणोद् वासुदेवाय कुपितो धूर्जटिर्नृप॥ १०/६६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.044.m4a", "display_order": 45}, {"id": 6000262045, "chapter_id": 10262, "verse_number": "१०-६६-४४", "content_sanskrit": "दृष्ट्वा त्रिशूलमायान्तं केशवस्तं निवारितुम्।\nगदां कौमोदकीं गुर्वीं प्राहिणोद् दैत्यमर्दनीम्॥ १०/६६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.045.m4a", "display_order": 46}, {"id": 6000262046, "chapter_id": 10262, "verse_number": "१०-६६-४५", "content_sanskrit": "ते वै कौमोदकीशूले कृत्वा नभसि सङ्गरम्।\nज्वलमाने महाघोरे पेततुः सममम्बुधौ॥ १०/६६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.046.m4a", "display_order": 47}, {"id": 6000262047, "chapter_id": 10262, "verse_number": "१०-६६-४६", "content_sanskrit": "निपात्याब्धौ त्रिशूलं तद्गदा कौमोदकी पुनः।\nआससाद करं विष्णोस्‍त्रिशूलमपि शूलिनः॥ १०/६६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.047.m4a", "display_order": 48}, {"id": 6000262048, "chapter_id": 10262, "verse_number": "१०-६६-४७", "content_sanskrit": "तत उद्यम्य निशितं खड्गं पन्नगभूषणः।\nकृष्णमभ्यद्रवत् सङ्ख्ये पार्ष्णिभ्यां चोदयन् वृषम्॥ १०/६६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.048.m4a", "display_order": 49}, {"id": 6000262049, "chapter_id": 10262, "verse_number": "१०-६६-४८", "content_sanskrit": "तूर्णं गृहीत्वा पाणिभ्यां विषाणे तस्य नन्दिनः।\nसशूलपाणिं चिक्षेप वैनतेयो धनुश्शतम्॥ १०/६६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.049.m4a", "display_order": 50}, {"id": 6000262050, "chapter_id": 10262, "verse_number": "१०-६६-४९", "content_sanskrit": "ततो विसृज्य सङ्ग्रामं त्रिशूली वृषवाहनः।\nप्रमथैः सहितः प्रायात् कुरुश्रेष्ठ यथागतम्॥ १०/६६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_066/BhP_10.066.050.m4a", "display_order": 51}, {"id": 6000262051, "chapter_id": 10262, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे षट्‌षष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]