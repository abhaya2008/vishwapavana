[{"id": 2104896, "chapter_id": 3260, "verse_number": "१४-११६-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकीदृशा ब्राह्मणाः पुण्या भावशुद्धाः सुरेश्वर।\nयत्कर्म सफलं नेति कथयस्य ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104897, "chapter_id": 3260, "verse_number": "१४-११६-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104898, "chapter_id": 3260, "verse_number": "१४-११६-२", "content_sanskrit": "शृणु पाण्डव तत्सर्वं ब्राह्मणानां यथाक्रमम्।\nसफलं निष्फलं चैव तेषां कर्म ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104899, "chapter_id": 3260, "verse_number": "१४-११६-३", "content_sanskrit": "त्रिदण्डधारणं मौनं जटाधारणमुण्डनम्।\nवल्कलाजिनसंवासो व्रतचर्याऽभिषेचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104900, "chapter_id": 3260, "verse_number": "१४-११६-४", "content_sanskrit": "अग्निहोत्रं गृहे वासः स्वाध्यायं दारसत्क्रिया।\nसर्वाण्येतानि वै मिथ्या यदि भावो न निर्मलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104901, "chapter_id": 3260, "verse_number": "१४-११६-५", "content_sanskrit": "अग्निहोत्रं वृथा राजन्वृथा वेदास्तथैव च।\nशीलेन देवास्तुष्यन्ति श्रुतयस्तत्र कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104902, "chapter_id": 3260, "verse_number": "१४-११६-६", "content_sanskrit": "क्षान्तः दान्तं जितक्रोधं जितात्मानं जितेन्द्रियम्।\nतमग्र्यं ब्राह्मणं मन्ये शेषाः शूद्रा इति स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104903, "chapter_id": 3260, "verse_number": "१४-११६-७", "content_sanskrit": "अग्निहोत्रव्रतपरान्स्वाध्यायनिरताञ्शुचीन्।\nउपवासरतान्दान्तांस्तादेवा ब्राह्मणान्विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104904, "chapter_id": 3260, "verse_number": "१४-११६-८", "content_sanskrit": "न जात्या पुजीतो राजन्गुणाः कल्याणकारणाः।\nचण्डालमपि वृत्तस्थं तं देवा ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104905, "chapter_id": 3260, "verse_number": "१४-११६-९", "content_sanskrit": "मनश्शौचं कर्मशौचं कुलशौचं च भारत।\nशरीरशौचं वाक्छौचं शौचं पञ्चविधं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104906, "chapter_id": 3260, "verse_number": "१४-११६-१०", "content_sanskrit": "पञ्चस्वेतेषु शौचेषु हृदिं शौचं विशिष्यते।\nहृदयस्य च शौचेन स्वर्गं गच्छन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104907, "chapter_id": 3260, "verse_number": "१४-११६-११", "content_sanskrit": "अग्निहोत्रपरिभ्रष्टः प्रसक्तः क्रयविक्रयैः।\nवर्णसङ्करकर्ता च ब्राह्मणो वृषलैः समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104908, "chapter_id": 3260, "verse_number": "१४-११६-१२", "content_sanskrit": "यस्य वेदश्रुतिर्नष्टा कर्षकश्चापि यो द्विजः।\nविकर्मसेवी कौन्तेय स वै वृषल उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104909, "chapter_id": 3260, "verse_number": "१४-११६-१३", "content_sanskrit": "वृषो हि धर्मो विज्ञेयस्तस्य यः कुरुते लयम्।\nवृषलं तं विदुर्देवा निकृष्टं श्वपचादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104910, "chapter_id": 3260, "verse_number": "१४-११६-१४", "content_sanskrit": "स्तुतिभिर्ब्रह्मगीताभिर्यः शूद्रं स्तौति मानवः।\nन तु मां स्तौति पापात्मा स तु चण्डालतः समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104911, "chapter_id": 3260, "verse_number": "१४-११६-१५", "content_sanskrit": "श्वदृतौ तु यथा क्षीरं ब्रह्म वै वृषले तथा।\nदुष्टतामेति तत्सर्वं शुना लीढं हविर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104912, "chapter_id": 3260, "verse_number": "१४-११६-१६", "content_sanskrit": "अङ्गानि वेदाश्चत्वारो मीमांसान्यायविस्तरः।\nधर्मशास्त्रं पुराणं च विद्या ह्येताश्चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104913, "chapter_id": 3260, "verse_number": "१४-११६-१७", "content_sanskrit": "यान्युक्तानि मया सम्यग्विद्यास्थानानि भारत।\nउत्पन्नानि पवित्राणि भुवनार्थं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104914, "chapter_id": 3260, "verse_number": "१४-११६-१८", "content_sanskrit": "तस्मात्तानि न शूद्रस्य स्प्रष्टव्यानि युधिष्ठिर।\nसर्वं त्रीण्यपवित्राणि पञ्चामेध्यानि भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104915, "chapter_id": 3260, "verse_number": "१४-११६-१९", "content_sanskrit": "श्वा च शूद्रः श्वपाकश्च अपवित्राणि पाण्डव॥\nगायकः कुक्कुटो यूपो ह्युदक्या वृषलीपतिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104916, "chapter_id": 3260, "verse_number": "१४-११६-२०", "content_sanskrit": "प़ञ्चैते स्युरमेध्याश्च स्प्रष्टव्या न कदातन।\nस्पृष्ट्वैतानष्ट वै विप्रः सचेलो जलमाविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104917, "chapter_id": 3260, "verse_number": "१४-११६-२१", "content_sanskrit": "मद्भक्ताञ्शूद्रसामान्यादवमन्यन्ति ये नराः।\nनरकेष्वेव तिष्ठन्ति वर्षकोटिं नराधमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104918, "chapter_id": 3260, "verse_number": "१४-११६-२२", "content_sanskrit": "चण्डालमपि मद्भक्तं नावमन्येत बुद्धिमान्।\nअवमानात्पतन्त्येव नरके रौरवे नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104919, "chapter_id": 3260, "verse_number": "१४-११६-२३", "content_sanskrit": "मम भक्तस्य भक्तेषु प्रीतिरभ्यधिका मम।\nतस्मान्मद्भक्तभक्ताश्च पूजनीया विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104920, "chapter_id": 3260, "verse_number": "१४-११६-२४", "content_sanskrit": "कीटपक्षिमृगाणां च मयि संन्यस्तचेतसाम्।\nऊर्ध्वामेव गतिं विद्धि किं पुनर्ज्ञानिनां नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104921, "chapter_id": 3260, "verse_number": "१४-११६-२५", "content_sanskrit": "पत्रं वाऽप्यथवा पुष्पंक फलं वाऽप्यप एव वा।\nददाति मम शूद्रो यच्छिरसा धारयामि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104922, "chapter_id": 3260, "verse_number": "१४-११६-२६", "content_sanskrit": "विप्रानेवार्चयेद्भक्त्या शूद्रप्रायांश्च मत्प्रियान्।\nतेषां तेनैव रूपेण पूजां गृह्णामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104923, "chapter_id": 3260, "verse_number": "१४-११६-२७", "content_sanskrit": "वेदोत्तेनैव मार्गेण सर्वभूतहृदि स्थितम्।\nमामर्चयन्ति ये पिप्रा मत्सायुज्यं व्रजन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104924, "chapter_id": 3260, "verse_number": "१४-११६-२८", "content_sanskrit": "मद्भक्तानां हितायैव प्रादुर्भावः कृतो मया।\nप्रदुर्भावकृता काचिदर्चनीया युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104925, "chapter_id": 3260, "verse_number": "१४-११६-२९", "content_sanskrit": "आसामन्यतमां मूर्तिं यो मद्भक्त्या समर्चति।\nतेनैव परितुष्टोऽहं भविष्यामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104926, "chapter_id": 3260, "verse_number": "१४-११६-३०", "content_sanskrit": "मृदा च मणिरत्नैश्च ताम्रेण रजतेन च।\nकृत्वा प्रतिकृतिं कुर्यादर्चनां काञ्चनेन वा।\nपुण्यं दशगुणं विद्यादेतेषामुत्तरोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104927, "chapter_id": 3260, "verse_number": "१४-११६-३१", "content_sanskrit": "जपकामो भवेद्राजा विद्याकामो द्विजोत्तमः।\nवैश्यो वा धनकामस्तु शूद्रः सुखफलप्रियः।\nसर्वकामाः स्त्रियो वाऽपि सर्वान्कामानवाप्नुयुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104928, "chapter_id": 3260, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि षोडशाधिकशततमोऽध्यायः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]