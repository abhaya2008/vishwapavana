[{"id": 2070952, "chapter_id": 2494, "verse_number": "११-२६-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070953, "chapter_id": 2494, "verse_number": "११-२६-१", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ गान्धारि मा च शोके मनः कृथाः।\nतवैव ह्यपराधेन कुरवो निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070954, "chapter_id": 2494, "verse_number": "११-२६-२", "content_sanskrit": "यत्त्वं पुत्रं दुरात्मानमीर्षुमत्यन्तमानिनम्।\nदुर्योधनं पुरस्कृत्य दुष्कृतं साधु मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070955, "chapter_id": 2494, "verse_number": "११-२६-३", "content_sanskrit": "निष्ठुरं वैरपुरुषं वृद्धानां शासनातिगम्।\nकथमात्मकृतं दोषं मय्याधातुमिहेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070956, "chapter_id": 2494, "verse_number": "११-२६-४", "content_sanskrit": "मृतं वा यदि वा नष्टं योऽतीतमनुशोचति।\nदुःखेन लभते दुःखं द्वावनर्थौ प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070957, "chapter_id": 2494, "verse_number": "११-२६-५", "content_sanskrit": "तपोर्थीयं ब्राह्मणी धत्त गर्भं\nगौर्वोढारं धावितारं तुरङ्गी।\nशूद्रा दासं पशुपालं च वैश्या\nवधार्थीयं त्वद्विधा राजपुत्री॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070958, "chapter_id": 2494, "verse_number": "११-२६-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070959, "chapter_id": 2494, "verse_number": "११-२६-६", "content_sanskrit": "तच्छ्रुत्वा वासुदेवस्य पुनरुक्तं वचोऽप्रियम्।\nतूष्णीं बभूव गान्धारी शोकव्याकुललोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070960, "chapter_id": 2494, "verse_number": "११-२६-७", "content_sanskrit": "धृतराष्ट्रस्तु राजर्षिर्निगृह्याबुद्धिजं तमः।\nपर्यपृच्छत धर्मज्ञो धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070961, "chapter_id": 2494, "verse_number": "११-२६-८", "content_sanskrit": "जीवतां परिमाणज्ञः सैन्यानामसि पाण्डव।\nहतानां यदि जानीषे परिमाणं वदस्वं मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070962, "chapter_id": 2494, "verse_number": "११-२६-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070963, "chapter_id": 2494, "verse_number": "११-२६-९", "content_sanskrit": "दशायुतसहस्राणि सहस्राणि च विंशतिः।\nकोट्यः षष्टिश्च षट् चैव ह्यस्मिन्राजन्मृधे हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070964, "chapter_id": 2494, "verse_number": "११-२६-१०", "content_sanskrit": "आलक्षाणां च वीराणां सहस्राणि चतुर्दश।\nदश चान्यानि राजेन्द्र शतं षष्टिश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070965, "chapter_id": 2494, "verse_number": "११-२६-११x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070966, "chapter_id": 2494, "verse_number": "११-२६-११", "content_sanskrit": "युधिष्ठिरगतिं कां ते गताः पुरुषसत्तम।\nआचक्ष्व मे महाबाहो सर्वज्ञो ह्यसि मे मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070967, "chapter_id": 2494, "verse_number": "११-२६-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070968, "chapter_id": 2494, "verse_number": "११-२६-१२", "content_sanskrit": "यैर्हुतानि शरीराणि हृष्टैः परमसंयुगे।\nदेवराजसमाँल्लोकान्गतास्ते सत्यविक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070969, "chapter_id": 2494, "verse_number": "११-२६-१३", "content_sanskrit": "ये त्वहृष्टेन मनसा मर्तव्यमिति भारत।\nयुध्यमाना हताः सङ्ख्ये गन्धर्वैः सह सङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070970, "chapter_id": 2494, "verse_number": "११-२६-१४", "content_sanskrit": "ये च सङ्ग्रामभूमिष्ठा याचमानाः पराङ्मुखाः।\nशस्त्रेण निधनं प्राप्ता गतास्ते गुह्यकान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070971, "chapter_id": 2494, "verse_number": "११-२६-१५", "content_sanskrit": "पात्यमानाः परैर्ये तु हीयमाना निरायुधाः।\nहीनिषेवा महात्मानः परानभिमुखा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070972, "chapter_id": 2494, "verse_number": "११-२६-१६", "content_sanskrit": "छिद्यमानाः शितैः शस्त्रैः क्षत्रधर्मपरायणाः।\nहतास्ते ब्रह्मसदनं गता वीराः सुवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070973, "chapter_id": 2494, "verse_number": "११-२६-१७", "content_sanskrit": "ये त्वत्र निहता राजन्नन्तरायोधनं प्रति।\nयथाकथञ्चित्पुरुषास्ते गता ह्युत्तरां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070974, "chapter_id": 2494, "verse_number": "११-२६-१८x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070975, "chapter_id": 2494, "verse_number": "११-२६-१८", "content_sanskrit": "केन ज्ञानबलेनैव पुत्र पश्यसि सिद्धवत्।\nतन्मे वद महाबाहो श्रोतव्यं यदि वै मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070976, "chapter_id": 2494, "verse_number": "११-२६-१९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070977, "chapter_id": 2494, "verse_number": "११-२६-१९", "content_sanskrit": "निदेशाद्भवतः पूर्वं वने विचरता मया।\nतीर्थयात्राप्रसङ्गेन सम्प्राप्तोऽयमनुग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070978, "chapter_id": 2494, "verse_number": "११-२६-२०", "content_sanskrit": "देवर्षिर्लोमशो दृष्टस्ततः प्राप्तोऽस्म्यनुस्मृतिम्।\nदिव्यं चक्षुरपि प्राप्तं ज्ञानयोगेन वै पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070979, "chapter_id": 2494, "verse_number": "११-२६-२१x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070980, "chapter_id": 2494, "verse_number": "११-२६-२१", "content_sanskrit": "ये त्वनाथा जनास्तात नाथवन्तश्च पाण़्डव।\nकच्चित्तेषां शरीराणि धक्ष्यन्ति विधिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070981, "chapter_id": 2494, "verse_number": "११-२६-२२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070982, "chapter_id": 2494, "verse_number": "११-२६-२२", "content_sanskrit": "न येषां शान्तिकर्तारो न च येऽत्राहिताग्नयः।\nवयं च तेषां कुर्यामो बहुत्वात्तात कर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070983, "chapter_id": 2494, "verse_number": "११-२६-२३", "content_sanskrit": "यान्सुपर्णाश्च गुध्राश्च विकर्षन्ति ततस्ततः।\nतेषां सङ्कर्षणा लोका भविष्यन्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070984, "chapter_id": 2494, "verse_number": "११-२६-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070985, "chapter_id": 2494, "verse_number": "११-२६-२४", "content_sanskrit": "एवमुक्त्वा महाराज कुन्तीपुत्रो युधिष्ठिरः।\nआदिदेश सुधर्माणं धौम्यं सूतं च सञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070986, "chapter_id": 2494, "verse_number": "११-२६-२५", "content_sanskrit": "विदुरं च महाबुद्धिं युयुत्सुं चैव कौरवम्।\nइन्द्रसेनमुखान्भृत्यान्सूतांश्चैव सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070987, "chapter_id": 2494, "verse_number": "११-२६-२६", "content_sanskrit": "भवन्तः कारयन्त्वेषां प्रेतकार्याण्यशेषतः।\nयथा नाथवतां किञ्चिच्छरीरं न विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070988, "chapter_id": 2494, "verse_number": "११-२६-२७", "content_sanskrit": "शासनाद्धर्मराजस्य क्षत्ता सूतश्च सञ्जयः।\nसुधर्मा धौम्यसहित इन्द्रसेनादयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070989, "chapter_id": 2494, "verse_number": "११-२६-२८", "content_sanskrit": "चन्दनागुरुकाष्ठानि तथा कालीयकान्युत।\nघृतं तैलं च गन्धांश्च क्षौमाणि वसनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070990, "chapter_id": 2494, "verse_number": "११-२६-२९", "content_sanskrit": "समाहृत्य महार्हाणि दारुणां चैव सञ्चयान्।\nरथांश्च मृदितास्तत्र नानाप्रहरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070991, "chapter_id": 2494, "verse_number": "११-२६-३०", "content_sanskrit": "चिताः कृत्वा प्रयत्नेन यथामुख्यान्नराधिपान्।\nदाहयामासुरव्याग्राः शास्त्रदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2070992, "chapter_id": 2494, "verse_number": "११-२६-३१", "content_sanskrit": "दुर्योधनं च राजानं भ्रातॄंश्चास्य कर्मणा॥\nशल्यं शलं च राजानं भूरिश्रवसमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2070993, "chapter_id": 2494, "verse_number": "११-२६-३२", "content_sanskrit": "जयद्रथं च राजानमभिमन्युं च भारत।\nदौःशासनिं लक्ष्मणं च धृष्टकेतुं च पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2070994, "chapter_id": 2494, "verse_number": "११-२६-३३", "content_sanskrit": "बृहद्वलं सोमदत्तं सृञ्जयं च महारथम्।\nराजानं क्षेमधन्वानं विराटद्रुपदौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2070995, "chapter_id": 2494, "verse_number": "११-२६-३४", "content_sanskrit": "शिखण्डिनं च पाञ्चाल्यं धृष्टद्युम्नं च पार्षतम्।\nयुधामन्युं च विक्रान्तमुत्तमौजसमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2070996, "chapter_id": 2494, "verse_number": "११-२६-३५", "content_sanskrit": "कौसल्यं द्रौपदेयांश्च शकुनिं चापि सौबलम्।\nअचलं वृषकं चैव भगदत्ते च पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2070997, "chapter_id": 2494, "verse_number": "११-२६-३६", "content_sanskrit": "कर्णं वैकर्तनं चैव सहपुत्रममर्षणम्।\nकेकयांश्च महेष्वासांस्त्रिगर्तांश्च महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2070998, "chapter_id": 2494, "verse_number": "११-२६-३७", "content_sanskrit": "घटोत्कचं राक्षसेन्द्रं बकभ्रातरमेव च।\nअलम्बुसं राक्षसेन्द्रं जलसन्धं च पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2070999, "chapter_id": 2494, "verse_number": "११-२६-३८", "content_sanskrit": "एतांश्चान्यांस्च सुबहून्पार्थिवांश्च सहस्रशः।\nधृतधाराहुतैर्दीप्तैः पावकैः समदाहयन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2071000, "chapter_id": 2494, "verse_number": "११-२६-३९", "content_sanskrit": "पितृमेधाश्च केषाञ्चित्प्रावर्तन्त महात्मनाम्।\nसामभिश्चाप्यगायन्त तेऽन्वशासत चापरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2071001, "chapter_id": 2494, "verse_number": "११-२६-४०", "content_sanskrit": "साम्नामृचां च नादेन स्त्रीणां च रुदितस्वनैः।\nकश्मलं सर्वभूतानां निशायां समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2071002, "chapter_id": 2494, "verse_number": "११-२६-४१", "content_sanskrit": "हुताश्च तत्प्रदीप्ताश्च दीप्यमानाश्च पावकाः।\nनभसीवान्वदृश्यन्त ग्रहास्तन्वभ्रसंवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2071003, "chapter_id": 2494, "verse_number": "११-२६-४२", "content_sanskrit": "ये चाप्यनाथास्तत्रासन्नानादेशसमागताः।\nतांश्च सर्वान्समानीय राशीकृत्वा सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2071004, "chapter_id": 2494, "verse_number": "११-२६-४३", "content_sanskrit": "चित्वा दारुभिरव्यग्रैः प्रभूतैः स्नेहपाचितैः।\nदाहयामास तान्सर्वान्विदुरो राजशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2071005, "chapter_id": 2494, "verse_number": "११-२६-४४", "content_sanskrit": "कारयित्वा क्रियास्तेषां कुरुराजो युधिष्ठिरः।\nधृतराष्ट्रं पुरस्कृत्य गङ्गामभिमुखोऽगमत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2071006, "chapter_id": 2494, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि श्राद्धपर्वणि षड्विंशोऽध्यायः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]