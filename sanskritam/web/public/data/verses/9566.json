[{"id": 5000566000, "chapter_id": 9566, "verse_number": "७-३१-१", "content_sanskrit": "ततो रामो महातेजा विस्मयात्पुनरेव हि ।\nउवाच प्रणतो वाक्यमगस्त्यमृषिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000566001, "chapter_id": 9566, "verse_number": "७-३१-२", "content_sanskrit": "भगवन्राक्षसः क्रूरो यदाप्रभृति मेदिनीम् ।\nपर्यटत्किं तदा लोकाः शून्या आसन्द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000566002, "chapter_id": 9566, "verse_number": "७-३१-३", "content_sanskrit": "राजा वा राजमात्रो वा किं तदा नात्र कश्चन ।\nधर्षणं यत्र न प्राप्तो रावणो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000566003, "chapter_id": 9566, "verse_number": "७-३१-४", "content_sanskrit": "उताहो हतवीर्यास्ते बभूवुः पृथिवीक्षितः ।\nबहिष्कृता वरास्त्रैश्च बहवो निर्जिता नृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000566004, "chapter_id": 9566, "verse_number": "७-३१-५", "content_sanskrit": "राघवस्य वचः श्रुत्वा ह्यगस्त्यो भगवानृषिः ।\nउवाच रामं प्रहसन्पितामह इवेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000566005, "chapter_id": 9566, "verse_number": "७-३१-६", "content_sanskrit": "इत्येवं बाधमानस्तु पार्थिवान्पार्थिवर्षभ ।\nचचार रावणो राम पृथिवीं पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000566006, "chapter_id": 9566, "verse_number": "७-३१-७", "content_sanskrit": "ततो माहिष्मतीं नाम पुरीं स्वर्गपुरीप्रभाम् ।\nसम्प्राप्तो यत्र सान्निध्यं सदासीद्वसुरेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000566007, "chapter_id": 9566, "verse_number": "७-३१-८", "content_sanskrit": "तुल्य आसीन्नृपस्तस्य प्रभावाद्वसुरेतसः ।\nअर्जुनो नाम यत्राग्निः शरकुण्डेशयः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000566008, "chapter_id": 9566, "verse_number": "७-३१-९", "content_sanskrit": "तमेव दिवसं सो ऽथ हैहयाधिपतिर्बली ।\nअर्जुनो नर्मदां रन्तुं गतः स्त्रीभिः सहेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000566009, "chapter_id": 9566, "verse_number": "७-३१-१०", "content_sanskrit": "तमेव दिवसं सो ऽथ रावणस्तत्र आगतः ।\nरावणो राक्षसेन्द्रस्तु तस्यामात्यानपृच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000566010, "chapter_id": 9566, "verse_number": "७-३१-११", "content_sanskrit": "क्वार्जुनो नृपतिः शीघ्रं सम्यगाख्यातुमर्हथ ।\nरावणो ऽहमनुप्राप्तो युद्धेप्सुर्नृवरेण ह ।\nममागमनमप्यग्रे युष्माभिः सन्निवेद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000566011, "chapter_id": 9566, "verse_number": "७-३१-१२", "content_sanskrit": "इत्येवं रावणेनोक्तास्ते ऽमात्याः सुविपश्चितः ।\nअब्रुवन्राक्षसपतिमसान्निध्यं महीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000566012, "chapter_id": 9566, "verse_number": "७-३१-१३", "content_sanskrit": "श्रुत्वा विश्रवसः पुत्रः पौराणामर्जुनं गतम् ।\nअपसृत्यागतो विन्ध्यं हिमवत्सन्निभं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000566013, "chapter_id": 9566, "verse_number": "७-३१-१४", "content_sanskrit": "स तमभ्रमिवाविष्टमुद्भ्रन्तमिव मेदिनीम् ।\nअपश्यद्रावणो विन्ध्यमालिखन्तमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000566014, "chapter_id": 9566, "verse_number": "७-३१-१५", "content_sanskrit": "सहस्रशिखरोपेतं सिंहाध्युषितकन्दरम् ।\nप्रपातपतितैस्तोयैः साट्टहासमिवाम्बुधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000566015, "chapter_id": 9566, "verse_number": "७-३१-१६", "content_sanskrit": "देवदानवगन्धर्वैः साप्सरोगणकिन्नरैः ।\nस्वस्त्रीभिः क्रीडमानैश्च स्वर्गभूतं महोच्छ्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000566016, "chapter_id": 9566, "verse_number": "७-३१-१७", "content_sanskrit": "नदीभिः स्यन्दमानाभिः स्फटिकप्रतिमं जलम् ।\nफणाभिश्चलजिह्वाभिरनन्तमिव विष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000566017, "chapter_id": 9566, "verse_number": "७-३१-१८", "content_sanskrit": "उत्क्रामन्तं दरीवन्तं हिमवत्सन्निभं गिरिम् ।\nपश्यमानस्ततो विन्ध्यं रावणो नर्मदां ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000566018, "chapter_id": 9566, "verse_number": "७-३१-१९", "content_sanskrit": "चलोपलजलां पुण्यां पश्चिमोदधिगामिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000566019, "chapter_id": 9566, "verse_number": "७-३१-२०", "content_sanskrit": "महिषैः सृमरैः सिंहैः शार्दूलर्क्षगजोत्तमैः ।\nउष्णाभितप्तैस्तृषितैः सङ्क्षोभितजलाशयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000566020, "chapter_id": 9566, "verse_number": "७-३१-२१", "content_sanskrit": "चक्रवाकैः सकारण्डैः सहंसजलकुक्कुटैः ।\nसारसैश्च सदा मत्तैः सुकूजद्भिः समावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000566021, "chapter_id": 9566, "verse_number": "७-३१-२२", "content_sanskrit": "फुल्लद्रुमकृतोत्तंसां चक्रवाकयुगस्तनीम् ।\nविस्तीर्णपुलिनश्रोणीं हंसावलिसुमेखलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000566022, "chapter_id": 9566, "verse_number": "७-३१-२३", "content_sanskrit": "पुष्परेण्वनुलिप्ताङ्गीं जलफेनामलांशुकाम् ।\nजलावगाहसंस्पर्शां फुल्लोत्पलशुभेक्षणाम् ।\nपुष्पकादवरुह्याशु नर्मदां सरितां वराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000566023, "chapter_id": 9566, "verse_number": "७-३१-२४", "content_sanskrit": "इष्टामिव वरां नारीमवगाह्य दशाननः ।\nस तस्याः पुलिने रम्ये नानामुनिनिषेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000566024, "chapter_id": 9566, "verse_number": "७-३१-२५", "content_sanskrit": "उपोपविष्टैः सचिवैः सार्धं राक्षसपुङ्गवः ।\nप्रख्याय नर्मदां सो ऽथ गङ्गेयमिति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000566025, "chapter_id": 9566, "verse_number": "७-३१-२६", "content_sanskrit": "नर्मदादर्शजं हर्षमाप्तवान् राक्षसाधिपः ।\nउवाच सचिवांस्तत्र सलीलं शुकसारणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000566026, "chapter_id": 9566, "verse_number": "७-३१-२७", "content_sanskrit": "एष रश्मिसहस्रेण जगत्कृत्वैव काञ्चनम् ।\nतीक्ष्णतापकरः सूर्यो नभसो ऽर्धं समाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000566027, "chapter_id": 9566, "verse_number": "७-३१-२८", "content_sanskrit": "मामासीनं विदित्वैव चन्द्रायति दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000566028, "chapter_id": 9566, "verse_number": "७-३१-२९", "content_sanskrit": "नर्मदाजलशीतश्च सुगन्धिः श्रमनाशनः ।\nमद्भयादनिलो ऽप्यत्र वात्येष सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000566029, "chapter_id": 9566, "verse_number": "७-३१-३०", "content_sanskrit": "इयं वापि सरिच्छ्रेष्ठा नर्मदा नर्मवर्धिनी ।\nनक्रमीनविहङ्गोर्मिः सभयेवाङ्गना स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000566030, "chapter_id": 9566, "verse_number": "७-३१-३१", "content_sanskrit": "तद्भवन्तः क्षताः शस्त्रैर्नृपैरिन्द्रसमैर्युधि ।\nचन्दनस्य रसेनेव रुधिरेण समुक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000566031, "chapter_id": 9566, "verse_number": "७-३१-३२", "content_sanskrit": "ते यूयमवगाहध्वं नर्मदां शर्मदां शुभाम् ।\nमहापद्ममुखा मत्ता गङ्गामिव गहागजाः ।\nअस्यां स्नात्वा महानद्यां पाप्मानं विप्रमोक्ष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000566032, "chapter_id": 9566, "verse_number": "७-३१-३३", "content_sanskrit": "अहमप्यद्य पुलिने शरदिन्दुसमप्रभे ।\nपुष्पोपहारं शनकैः करिष्यामि कपर्दिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000566033, "chapter_id": 9566, "verse_number": "७-३१-३४", "content_sanskrit": "रावणेनैवमुक्तास्तु प्रहस्तशुकसारणाः ।\nसमहोदरधूम्राक्षा नर्मदां विजगाहिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000566034, "chapter_id": 9566, "verse_number": "७-३१-३५", "content_sanskrit": "राक्षसेन्द्रगजैस्तैस्तु क्षोभिता नर्मदा नदी ।\nवामनाञ्जनपद्माद्यैर्गङ्गा इव महागजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000566035, "chapter_id": 9566, "verse_number": "७-३१-३६", "content_sanskrit": "ततस्ते राक्षसाः स्नात्वा नर्मदायां महाबलाः ।\nउत्तीर्य पुष्पाण्याजह्रुर्बल्यर्थं रावणस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000566036, "chapter_id": 9566, "verse_number": "७-३१-३७", "content_sanskrit": "नर्मदापुलिने हृद्ये शुभ्राभ्रसदृशप्रभे ।\nराक्षसैस्तु मुहूर्तेन कृतः पुष्पमयो गिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000566037, "chapter_id": 9566, "verse_number": "७-३१-३८", "content_sanskrit": "पुष्पेषूपहृतेष्वेवं रावणो राक्षसेश्वरः ।\nअवतीर्णो नदीं स्नातुं गङ्गामिव महागजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000566038, "chapter_id": 9566, "verse_number": "७-३१-३९", "content_sanskrit": "तत्र स्नात्वा च विधिवज्जप्त्वा जप्यमनुत्तमम् ।\nनर्मदासलिलात्तस्मादुत्ततार स रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000566039, "chapter_id": 9566, "verse_number": "७-३१-४०", "content_sanskrit": "ततः क्लिन्नाम्बरं त्यक्त्वा शुक्लवस्त्रसमावृतम् ।\nरावणं प्राञ्जलिं यान्तमन्वयुः सर्वराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000566040, "chapter_id": 9566, "verse_number": "७-३१-४१", "content_sanskrit": "तद्गतीवशमापन्ना मूर्तिमन्त इवाचलाः ।\nयत्र यत्र च याति स्म रावणो राक्षसेश्वरः ।\nजाम्बूनदमयं लिङ्गं तत्र तत्र स्म नीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000566041, "chapter_id": 9566, "verse_number": "७-३१-४२", "content_sanskrit": "वालुकावेदिमध्ये तु तल्लिङ्गं स्थाप्य रावणः ।\nअर्चयामास गन्धैश्च पुष्पैश्चामृतगन्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000566042, "chapter_id": 9566, "verse_number": "७-३१-४३", "content_sanskrit": "ततः सतामार्तिहरं परं वरं वरप्रदं चन्द्रमयूखभूषणम् ।\nसमर्चयित्वा स निशाचरो जगौ प्रसार्य हस्तान्प्रणनर्त चाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000566043, "chapter_id": 9566, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]