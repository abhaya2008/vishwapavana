[{"id": 7006233000, "chapter_id": 26233, "verse_number": "२-६१-१", "content_sanskrit": "सूत उवाच विसर्गं मनुपुत्राणां विस्तरेण निबोधत ।\nपृषध्रो हिंसयित्वा तु गुरोर्गां निशि तत्क्षये ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006233001, "chapter_id": 26233, "verse_number": "२-६१-२", "content_sanskrit": "शापाच्छूद्रत्वमापन्नश्च्यवनस्य महात्मनः ।\nकरूषस्य तु कारूषाः क्षत्त्रिया युद्धदुर्मदाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006233002, "chapter_id": 26233, "verse_number": "२-६१-३", "content_sanskrit": "सहस्रं क्षत्त्रियगणो विक्रान्तः संबभूव ह ।\nनाभागो दिष्टपुत्रस्तु विद्वानासीद्भलन्दनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006233003, "chapter_id": 26233, "verse_number": "२-६१-४", "content_sanskrit": "भलन्दनस्य पुत्रोऽभूत्प्रांशुर्नाम महाबलः ।\nप्रांशोरेकोऽभवत्पुत्रः प्रजापतिसमो नृपः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006233004, "chapter_id": 26233, "verse_number": "२-६१-५", "content_sanskrit": "संवर्तेन दिवं नीतः ससुहृत्सहबान्धवः ।\nविवादोऽत्र महानासीत्संवर्त्तस्य बृहस्पतेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006233005, "chapter_id": 26233, "verse_number": "२-६१-६", "content_sanskrit": "ऋद्धिं दृष्ट्वा तु यज्ञस्य क्रुद्धस्तस्य बृहस्पतिः ।\nसंवर्त्तेन तते यज्ञे चुकोप स भृशं तदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006233006, "chapter_id": 26233, "verse_number": "२-६१-७", "content_sanskrit": "लोकानां सहि नाशाय दैवतैर्हि प्रसादितः ।\nमरुत्तश्चक्रवर्त्ती स नरिष्यन्तमवासवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006233007, "chapter_id": 26233, "verse_number": "२-६१-८", "content_sanskrit": "नरिष्यन्तस्य दायादो राजा दण्डधरो दमः ।\nतस्य पुत्रस्तु विज्ञातो राजासीद्राष्ट्रवर्द्धनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006233008, "chapter_id": 26233, "verse_number": "२-६१-९", "content_sanskrit": "सुधृतिस्तस्य पुत्रस्तु नरः सुधृतितः पुनः ।\nकेवलस्य पुत्रस्तु बन्धुमान्केवलात्मजः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006233009, "chapter_id": 26233, "verse_number": "२-६१-१०", "content_sanskrit": "अथ बन्धुमतः पुत्रोधर्मात्मा वेगवान्नृप ।\nबुधो वेगवतः पुत्रस्तृणबिन्दुर्बुधात्मजः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006233010, "chapter_id": 26233, "verse_number": "२-६१-११", "content_sanskrit": "त्रेतायुगमुखे राजा तृतीये संबभूव ह ।\nकन्या तु तस्येडविडामाता विश्रवसो हि सा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006233011, "chapter_id": 26233, "verse_number": "२-६१-१२", "content_sanskrit": "पुत्रो योऽस्य विशालोऽभूद्राजा परमधार्मिकः ।\nदाश्वान्प्रख्यातवीर्य्यौजा विशाला येन निर्मिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006233012, "chapter_id": 26233, "verse_number": "२-६१-१३", "content_sanskrit": "विशालस्य सुतो राजा हेमचन्द्रो महाबलः ।\nसुचन्द्र इति विख्यातो हेमचन्द्रादनन्तरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006233013, "chapter_id": 26233, "verse_number": "२-६१-१४", "content_sanskrit": "सुचन्द्रतनयो राजा धूम्राश्व इति विश्रुतः ।\nधूम्राश्वतनयो विद्वान्सृंजयः समपद्यत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006233014, "chapter_id": 26233, "verse_number": "२-६१-१५", "content_sanskrit": "सृञ्जयस्य सुतः श्रीमान्सहदेवः प्रतापवान् ।\nकृशाश्वः सहदेवस्य पुत्रः परमधार्मिकः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006233015, "chapter_id": 26233, "verse_number": "२-६१-१६", "content_sanskrit": "कृशाश्वस्य महातेजा सोमदत्तः प्रतापवान् ।\nसोमदत्तस्य राजर्षेः सुतोऽभूज्जनमेजयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006233016, "chapter_id": 26233, "verse_number": "२-६१-१७", "content_sanskrit": "जनमेजयात्मजश्चैव प्रमतिर्नाम विश्रुतः ।\nतृणबिन्दुप्रभावेण सर्वे वैशालका नृपाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006233017, "chapter_id": 26233, "verse_number": "२-६१-१८", "content_sanskrit": "दीर्घायुषो महात्मानो वीर्यवन्तः सुधार्मिकाः ।\nशर्यातेर्मिथुनं त्वासीदानर्त्तो नाम विश्रुतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006233018, "chapter_id": 26233, "verse_number": "२-६१-१९", "content_sanskrit": "पुत्रः सुकन्या कन्या च भार्या या च्यवनस्य च ।\nआनर्त्तस्य तु दायादो रेवो नाम सुवीर्यवान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006233019, "chapter_id": 26233, "verse_number": "२-६१-२०", "content_sanskrit": "आनर्त्तविषयो यस्य पुरी चापि कुशस्थली ।\nरेवस्य रैवतः पुत्रः ककुद्मी नाम धार्मिकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006233020, "chapter_id": 26233, "verse_number": "२-६१-२१", "content_sanskrit": "ज्येष्ठो भ्रातृशतस्यासीद्राज्यं प्राप्य कुशस्थलीम् ।\nकन्यया सह श्रुत्वा च गान्धर्वं ब्रह्मणोंऽतिके ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006233021, "chapter_id": 26233, "verse_number": "२-६१-२२", "content_sanskrit": "मुहर्त्तं देवदेवस्य मार्त्यं बहुयुगं विभो ।\nआजगाम युवा चैव स्वां पुरीं यादवैर्वृताम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006233022, "chapter_id": 26233, "verse_number": "२-६१-२३", "content_sanskrit": "कृतां द्वारवतीं नाम बहुद्वारां मनोरमाम् ।\nभोजवृष्ण्यन्धकैर्गुप्तां वसुदेवपुरोगमैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006233023, "chapter_id": 26233, "verse_number": "२-६१-२४", "content_sanskrit": "तां कथां रेवतः श्रुत्वा यथातत्त्वमरिन्दमः ।\nकन्यां तु बलदेवाय सुव्रतां नाम रेवतीम् ।\nदत्त्वा जगाम शिखरं मेरोस्तपसि संस्थितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006233024, "chapter_id": 26233, "verse_number": "२-६१-२५", "content_sanskrit": "रेमे रामश्च धर्मात्मा रेवत्या सहितः किल ।\nतां कथामृषयः श्रुत्वा पप्रच्छुक्तदनन्तरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006233025, "chapter_id": 26233, "verse_number": "२-६१-२६", "content_sanskrit": "ऋषय ऊचुः कथं बहुयुगे काले समतीते महामते ।\nन जरा रेवतीं प्राप्ता रैवतं वा ककुद्मिनम् ।\nएतच्छुश्रूषमाणान्नो गान्धर्वं वद चैव हि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006233026, "chapter_id": 26233, "verse_number": "२-६१-२७", "content_sanskrit": "सूत उवाच न जरा क्षुत्पिपासे वा न च मृत्युभयं ततः ।\nन च रोगः प्रभवति ब्रह्मलोकं गतस्य ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006233027, "chapter_id": 26233, "verse_number": "२-६१-२८", "content_sanskrit": "गान्धर्वं प्रति यच्चापि पृष्टस्तु मुनिसत्तमाः ।\nततोऽहं संप्रवक्ष्यामि याथातथ्येन सुव्रताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006233028, "chapter_id": 26233, "verse_number": "२-६१-२९", "content_sanskrit": "सप्त स्वरास्त्रयो ग्रामा मूर्छनास्त्वेकविंशतिः ।\nतानाश्चैकोनपञ्चाशदित्येत्स्वरमण्डलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006233029, "chapter_id": 26233, "verse_number": "२-६१-३०", "content_sanskrit": "षड्जषभौ च गान्धारो मध्यमः पञ्चमस्तथा ।\nधैवतश्चापि विज्ञेयस्तथा चापि निषादकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006233030, "chapter_id": 26233, "verse_number": "२-६१-३१", "content_sanskrit": "सौवीरा मध्यमा ग्रामा हरिणाश्च तथैव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006233031, "chapter_id": 26233, "verse_number": "२-६१-३२", "content_sanskrit": "तस्याः कालोयनोपेताश्चतुर्थाशुद्धमध्यमाः ।\nनग्निं च पौषा वै देव दृष्ट्वा काञ्च यथाक्रमः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006233032, "chapter_id": 26233, "verse_number": "२-६१-३३", "content_sanskrit": "मध्यमग्रामिकाख्याता षड्जग्रामा निबोधत ।\nउत्तरं मन्द्रा रजनी तथा वाचोन्नरायताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006233033, "chapter_id": 26233, "verse_number": "२-६१-३४", "content_sanskrit": "मध्यषड्जा तथा चैव तथान्या चाभिमुद्गणा ।\nगान्धारग्रामिका श्यामा कीर्तिमाना निबोधत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006233034, "chapter_id": 26233, "verse_number": "२-६१-३५", "content_sanskrit": "अग्निष्टोमं तु माद्यं तु द्वितीयं वाजपेयिकम् ।\nयवरातसूयस्तु षष्ठवत्तु सुवर्मकम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006233035, "chapter_id": 26233, "verse_number": "२-६१-३६", "content_sanskrit": "सप्त गौसवना नाम महावृष्टिकताष्टमाम् ।\nब्रह्मदानं च नवमं प्राजापत्यमनन्तरम् ।\nनागयक्षाश्रयं विद्वान् तद्गोत्तरतथैव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006233036, "chapter_id": 26233, "verse_number": "२-६१-३७", "content_sanskrit": "पदक्रान्तमृगक्रान्तं विष्णुक्रान्तमनोहरा ।\nसूर्यकान्तधरेण्यैव संतकोकिलविश्रुतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006233037, "chapter_id": 26233, "verse_number": "२-६१-३८", "content_sanskrit": "तेनवानित्यपवशपिशाचातीवनह्यपि ।\nसावित्रमर्धसावित्रं सर्वतोभद्रमेव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006233038, "chapter_id": 26233, "verse_number": "२-६१-३९", "content_sanskrit": "मनोहरमधात्र्यं च गन्धर्वानुपतश्च यः ।\nअलंबुषेसेष्टमथो विष्णुवैणवरावुभौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006233039, "chapter_id": 26233, "verse_number": "२-६१-४०", "content_sanskrit": "सागराविजयं चैव सर्वभूतमनोहरः ।\nहतोत्सृष्टो विजानीत स्कन्धं तु प्रियमेव च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006233040, "chapter_id": 26233, "verse_number": "२-६१-४१", "content_sanskrit": "मनोहरमधात्र्यं च गन्धर्वानुपतश्च यः ।\nअलंबुसेष्टस्य तथा नारदप्रिय एव च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006233041, "chapter_id": 26233, "verse_number": "२-६१-४२", "content_sanskrit": "कथितो भीमसेनेन नगरातानयप्रियः ।\nविकलोपनीतविनताश्रीराख्यो भार्गवप्रियः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006233042, "chapter_id": 26233, "verse_number": "२-६१-४३", "content_sanskrit": "चतुर्दश तथा पञ्चदशेच्छन्तीह नारदः ।\nससौवीरां सुसोवीरा ब्रह्मणो ह्यपगीयते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006233043, "chapter_id": 26233, "verse_number": "२-६१-४४", "content_sanskrit": "उत्तरादिस्वरश्चैव ब्रह्मा वै देवतास्त्रयः ।\nहरिदेशसमुत्पन्ना हरिणस्याव्यजायत ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006233044, "chapter_id": 26233, "verse_number": "२-६१-४५", "content_sanskrit": "मूर्छना हरिणा ते वै चन्द्रस्यास्याधिदैवतम् ।\nकरोपनीता विवृतावनुद्रिः स्वरमण्डले ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006233045, "chapter_id": 26233, "verse_number": "२-६१-४६", "content_sanskrit": "साकलोपनतातस्मान्मनुतस्यान्नदैवतः ।\nमनुदेशाः समुत्पन्ना मूर्च्छनाशुद्धमात्मना ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006233046, "chapter_id": 26233, "verse_number": "२-६१-४७", "content_sanskrit": "तस्मात्तस्मान्मृगामर्गीमृगेन्द्रोस्याधिदैवता ।\nसावश्रमसमाद्युम्ना अनेकापौरुषानखान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006233047, "chapter_id": 26233, "verse_number": "२-६१-४८", "content_sanskrit": "मूर्च्छनायोजनाह्येषास्याद्रजसारजनीततः ।\nतानि उत्तर मद्रांसपद्गदैवतकं विदुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006233048, "chapter_id": 26233, "verse_number": "२-६१-४९", "content_sanskrit": "तस्मादुत्तरतायावत्प्रथमं स्वायमं विदुः ।\nतमोदुत्तरमैद्रोयदेवतास्याद्रुवेन च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006233049, "chapter_id": 26233, "verse_number": "२-६१-५०", "content_sanskrit": "अपामदुत्तरत्वावधैवतस्योत्तरायणः ।\nस्यादिजमूर्छनाह्येच पितरः श्राद्धदेवताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006233050, "chapter_id": 26233, "verse_number": "२-६१-५१", "content_sanskrit": "शुद्धषड्जस्वर कृत्वा यस्मादग्निमहर्षयः ।\nउपैति तस्मान्नजानी याच्छुद्धयच्छिकरासभा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006233051, "chapter_id": 26233, "verse_number": "२-६१-५२", "content_sanskrit": "इत्येता मूर्छनाः कृत्वा यस्यामीदृशभावनः ।\nपक्षिणां मूर्छनाः श्रुत्वा पक्षोका मूर्छनाः स्मृताः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006233052, "chapter_id": 26233, "verse_number": "२-६१-५३", "content_sanskrit": "नागादृष्टिविषागीतानोपसर्पन्तिमूर्छनाः ।\nनानासाधारमश्चैववडवात्रिविदस्तथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]