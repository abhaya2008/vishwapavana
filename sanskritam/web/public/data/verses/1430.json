[{"id": 2020550, "chapter_id": 1430, "verse_number": "३-६८-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020551, "chapter_id": 1430, "verse_number": "३-६८-१", "content_sanskrit": "अथ दीर्घस्य कालस्य पर्णादो नाम वै द्विजः।\nप्रत्येत्य नगरं भैमीमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020552, "chapter_id": 1430, "verse_number": "३-६८-२", "content_sanskrit": "नैषधं मृगयाणेन दमयन्ति दिवानिशम्।\nअयोध्यां नगरीं गत्वा भागस्वरिरुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020553, "chapter_id": 1430, "verse_number": "३-६८-३", "content_sanskrit": "श्रावितश्च मया वाक्यं त्वदीयं स महाजने।\nऋतुपर्णो महाभागो यथोक्तं वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020554, "chapter_id": 1430, "verse_number": "३-६८-४", "content_sanskrit": "तच्छ्रुत्वा नाब्रवीत्किंचिदृतुपर्णो नराधिपः।\nन च पारिषदः कश्चिद्भाष्यमाणो मयाऽसकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020555, "chapter_id": 1430, "verse_number": "३-६८-५", "content_sanskrit": "अनुज्ञातं तु मां राज्ञा विजने कश्चिदब्रवीत्।\nऋतुपर्णस्य पुरुषो बाहुको नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020556, "chapter_id": 1430, "verse_number": "३-६८-६", "content_sanskrit": "सूतस्तस्य नरेन्द्रस्य विरूपो ह्रस्वबाहुकः।\nशीघ्रयानेषु कुशलो मृष्टकर्ता च भोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020557, "chapter_id": 1430, "verse_number": "३-६८-७", "content_sanskrit": "स विनिःश्वस्य बंहुशो रुदित्वा च षुनःपुनः।\nकुशलं चैव मां पृष्ट्वा पश्चादिदमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020558, "chapter_id": 1430, "verse_number": "३-६८-८", "content_sanskrit": "वैषम्यमपि संप्राप्ता गोपायन्ति कुलस्त्रियः।\nआत्मानमात्मना सत्यो जितः स्वर्गो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020559, "chapter_id": 1430, "verse_number": "३-६८-९", "content_sanskrit": "रहिता भर्तृभिश्चैव न कुप्यन्ति कदाचन। ३-६८-९bप्राणांश्चारित्रकवचान्धारयन्ति वरस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020560, "chapter_id": 1430, "verse_number": "३-६८-१०", "content_sanskrit": "विषमस्थेन मूढेन परिभ्रष्टसुखेन च।\nयत्सा तेन परित्यक्ता तत्र न क्रोद्धुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020561, "chapter_id": 1430, "verse_number": "३-६८-११", "content_sanskrit": "प्राणयात्रां परिप्रेप्सोः शकुनैर्हृतवाससः।\nआधिभिर्दह्यमानस्य श्यामा न क्रोद्धुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020562, "chapter_id": 1430, "verse_number": "३-६८-१२", "content_sanskrit": "सत्कृताऽसत्कृता वाऽपि पतिं दृष्ट्वा तथागतम्।\nभ्रष्टराज्यं श्रित्या हीनं श्यामा न क्रोद्धुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020563, "chapter_id": 1430, "verse_number": "३-६८-१३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा त्वरितोऽहमिहागतः।\nश्रुत्वा प्रमाणं भवती राज्ञश्चैव निवेदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020564, "chapter_id": 1430, "verse_number": "३-६८-१४", "content_sanskrit": "एतच्छ्रुत्वाऽश्रुपूर्णाक्षी पर्णादस्य विशांपते।\nदमयन्ती रहोऽभ्येत्य मातरं प्रत्यभापत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020565, "chapter_id": 1430, "verse_number": "३-६८-१५", "content_sanskrit": "अयमर्थौ न संवेद्यो भीमे मातः कदाचन।\nत्वत्सन्निधौ नियोक्ष्येऽहंसुदेवं द्विजसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020566, "chapter_id": 1430, "verse_number": "३-६८-१६", "content_sanskrit": "यथा न नृपतिर्भीमः प्रतिपद्येत मे मतम्।\nयथा त्वया प्रकर्तव्यं मम चेत्प्रियमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020567, "chapter_id": 1430, "verse_number": "३-६८-१७", "content_sanskrit": "यथा चाहं समानीता सुदेवेनाशु बान्धवान्।\nतेनैव मङ्गलेनाद्य सुदेवो यातु मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020568, "chapter_id": 1430, "verse_number": "३-६८-१८", "content_sanskrit": "समानेतुं नलं मातरयोध्यां नगरीमितः।\n`ऋतुपर्णस्य नगरे निवसन्तमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020569, "chapter_id": 1430, "verse_number": "३-६८-१९", "content_sanskrit": "विश्रान्तं तु ततः पश्चात्पर्णादं द्विजसत्तमम्।\nअर्चयामास वैदर्भी धनेनातीव भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020570, "chapter_id": 1430, "verse_number": "३-६८-२०", "content_sanskrit": "`लवाच चैनं महता संपूज्य द्रविणेन वै।\nनले चेहागते विप्र भूयो दास्याभि ते वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020571, "chapter_id": 1430, "verse_number": "३-६८-२१", "content_sanskrit": "त्वया हि मे बहुकृतंयदन्यो न करिष्यति।\nयद्भर्त्राऽहं समेष्यामि शीघ्रमेव द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020572, "chapter_id": 1430, "verse_number": "३-६८-२२", "content_sanskrit": "स एवमुक्तोऽथाश्वास्य आशीर्वादैः सुमङ्गलैः।\nगृहानुपययौ चापि कृतार्थः सुमहामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020573, "chapter_id": 1430, "verse_number": "३-६८-२३", "content_sanskrit": "ततः सुदेवमानाय्य दमयन्ती युधिष्ठिर।\nअब्रवीत्सन्निदौ मातुर्दुःखशोकसमन्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020574, "chapter_id": 1430, "verse_number": "३-६८-२४", "content_sanskrit": "गत्वा सुदेव नगरीमयोध्यावासिनं नृपम्।\nऋतुपर्णं वचो ब्रूहि पतिमन्यं चिकीर्षती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020575, "chapter_id": 1430, "verse_number": "३-६८-२५", "content_sanskrit": "आस्थास्यति पुनर्भैमी दमयन्ती स्वयंवरम्।\nतत्र गच्छन्ति राजानो राजपुत्राश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020576, "chapter_id": 1430, "verse_number": "३-६८-२६", "content_sanskrit": "तथा च गणितः कालः श्वोभूते स भविष्यति।\nयदि संभाविनीयं ते गच्छ शीघ्रमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020577, "chapter_id": 1430, "verse_number": "३-६८-२७", "content_sanskrit": "सूर्योदये द्वतीयं सा भर्तारं वरयिष्यति।\nन हि स ज्ञायते वीरो नलो जीवन्मृतोपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020578, "chapter_id": 1430, "verse_number": "३-६८-२८", "content_sanskrit": "एवं तथा यथोक्तो वै गत्वा राजानमब्रवीत्।\nऋतुपर्णं महाराज सुदेवो ब्राह्मणस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020579, "chapter_id": 1430, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपास्त्र्यानपर्वणि अष्टषष्ठितमोऽध्यायः ॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]