[{"id": 2147153, "chapter_id": 4179, "verse_number": "", "content_sanskrit": "गरुडेन गालवं प्रति उत्तरदिगनुवर्णनपूर्वकम्\nअभिमतदिगभिगमनाय स्वपृष्ठाधिरोहणविधानम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147154, "chapter_id": 4179, "verse_number": "", "content_sanskrit": "सुपर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147155, "chapter_id": 4179, "verse_number": "१", "content_sanskrit": "यस्मादुत्तार्यते पापाद् यस्मान्निश्रेयसोऽश्नुते ।\nअस्मादुत्तारणफलाद् उत्तरेत्युच्यते बुधैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147156, "chapter_id": 4179, "verse_number": "२", "content_sanskrit": "उत्तरस्य हि पुण्यस्य परिवापस्य गालव ।\nमार्गः पश्चिमपूर्वाभ्यां दिग्भ्यां वै मध्यमः स्मृतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147157, "chapter_id": 4179, "verse_number": "३", "content_sanskrit": "अस्यां दिशि वरिष्ठायामुत्तरायां द्विजर्षभ ।\nनासौम्यो नाविधेयात्मा नाधर्मो वर्तते जनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147158, "chapter_id": 4179, "verse_number": "४", "content_sanskrit": "अत्र नारायणः कृष्णो जिष्णुश्चैव नरोत्तमः ।\nबदर्यामाश्रमपदे तथा ब्रह्मा च शाश्वतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147159, "chapter_id": 4179, "verse_number": "५", "content_sanskrit": "अत्र वै हिमवत्पृष्ठे नित्यमास्ते महेश्वरः ।\nप्रकृत्या पुरुषः सार्धं युगान्ताग्निसमप्रभः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147160, "chapter_id": 4179, "verse_number": "६", "content_sanskrit": "न सन्दृश्यो मुनिगणैस्तथा देवैः सवासवैः ।\nगन्धर्वयक्षसिद्धैर्वा नरनारायणादृते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147161, "chapter_id": 4179, "verse_number": "७", "content_sanskrit": "अत्र विष्णुः सहस्राक्षः सहस्रचरणोऽव्ययः ।\nसहस्रशिरसः श्रीमान् एकः पश्यति मायया\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147162, "chapter_id": 4179, "verse_number": "८", "content_sanskrit": "अत्र राज्येन विप्राणां चन्द्रमाश्चाभ्यषिच्यत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147163, "chapter_id": 4179, "verse_number": "९", "content_sanskrit": "अत्र गङ्गां महादेवः पतन्तीं गगनाच्च्युताम् ।\nप्रतिगृह्य ददौ लोके मानुषे ब्रह्मवित्तमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147164, "chapter_id": 4179, "verse_number": "१०", "content_sanskrit": "अत्रोमया तपस्तप्तं महेश्वरपरीप्सया ।\nअत्र कामश्च रोषश्च शैलश्चोमा च सम्बभुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147165, "chapter_id": 4179, "verse_number": "११", "content_sanskrit": "अत्र राक्षसयक्षाणां गन्धर्वाणां च गालव ।\nआधिपत्येन कैलासे धनदोऽप्यभिषेचितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147166, "chapter_id": 4179, "verse_number": "१२", "content_sanskrit": "अत्र चैत्ररथं रम्यमनु वैखानसाश्रमः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147167, "chapter_id": 4179, "verse_number": "१३", "content_sanskrit": "अत्र मन्दाकिनी चैव मन्दरश्च द्विजर्षभ ।\nअत्र सौगन्धिकवनं दैवतैरभिरक्ष्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147168, "chapter_id": 4179, "verse_number": "१४", "content_sanskrit": "शाद्वलं कदळीस्कन्धमत्र सन्तानगा नगाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147169, "chapter_id": 4179, "verse_number": "१५", "content_sanskrit": "अत्र संयमनित्यानां सिद्धानां स्वैरचारिणाम् ।\nविमानान्यनुरूपाणि कामभोग्यानि गालव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147170, "chapter_id": 4179, "verse_number": "१६", "content_sanskrit": "अत्र ते ऋषयः सप्त देवी चारुन्धती तथा ।\nअत्र तिष्ठति वै स्वातिरत्रास्या उदयः स्मृतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147171, "chapter_id": 4179, "verse_number": "१७", "content_sanskrit": "अत्र यज्ञं समारुह्य ध्रुवं स्थाता पितामहः ।\nज्योतींषि चन्द्रसूर्यौ च परिवर्तन्ति नित्यशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147172, "chapter_id": 4179, "verse_number": "१८", "content_sanskrit": "अत्र गङ्गामहाद्वारं रक्षन्ति द्विजसत्तमाः ।\nधामा नाम महात्मानो मुनयः सत्यवादिनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147173, "chapter_id": 4179, "verse_number": "१९", "content_sanskrit": "न तेषां ज्ञायते सूतिर्नाकृतिर्न तु पश्चिमः ।\nपरिवर्तसहस्राणि कामभोग्यानि गालव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147174, "chapter_id": 4179, "verse_number": "२०", "content_sanskrit": "यथा यथा प्रवेक्ष्यन्ति तस्मात् परतरं नरः ।\nतथा तथा द्विजश्रेष्ठ प्रविलीयति गालव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147175, "chapter_id": 4179, "verse_number": "२१", "content_sanskrit": "नैतत् केनचिदन्येन गतपूर्वं द्विजर्षभ ।\nऋते नारायणं देवं नरं वा जिष्णुमव्ययम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147176, "chapter_id": 4179, "verse_number": "२२", "content_sanskrit": "अत्र कैलासमित्युक्तं स्थानमैलबिलस्य तत् ।\nअत्र विद्युत्प्रभा नाम जज्ञिरेऽप्सरसो दश\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147177, "chapter_id": 4179, "verse_number": "२३", "content_sanskrit": "अत्र विष्णुपदं नाम क्रमता विष्णुना कृतम् ।\nत्रिलोकविक्रमे ब्रह्मन्नुत्तरां दिशमाश्रितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147178, "chapter_id": 4179, "verse_number": "२४", "content_sanskrit": "अत्र राज्ञा मरुत्तेन यज्ञेनेष्टं द्विजोत्तम ।\nउशीरबीजे विप्रर्षे यत्र जाम्बूनदं सरः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147179, "chapter_id": 4179, "verse_number": "२५", "content_sanskrit": "जीमूतस्यात्र विप्रर्षेरुपतस्थे महात्मनः ।\nसाक्षाद्धैमवतः पुण्यो विमलः कमलाकरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147180, "chapter_id": 4179, "verse_number": "२६", "content_sanskrit": "ब्राह्मणेषु च यत् कृत्स्नं स्वकं कृत्वा धनं महत् ।\nवव्रे वनं महर्षिः स जैमूतं तद्वनं ततः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147181, "chapter_id": 4179, "verse_number": "२७", "content_sanskrit": "अत्र नित्यं दिशां पालाः सायं प्रातर्द्विजर्षभ ।\nकस्य कार्यं किमिति वै परिक्रोशन्ति गालव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147182, "chapter_id": 4179, "verse_number": "२८", "content_sanskrit": "एवमेषा द्विजश्रेष्ठ गुणैरन्यैर्दिगुत्तरा ।\nउत्तरेति परिख्याता सर्वकर्मसु चोत्तरा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147183, "chapter_id": 4179, "verse_number": "२९", "content_sanskrit": "एता विस्तरशस्तात तव सङ्कीर्तिता दिशः ।\nचतस्रः क्रमयोगेन कामाशां गन्तुमिच्छसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147184, "chapter_id": 4179, "verse_number": "३०", "content_sanskrit": "उद्यतोऽहं द्विजश्रेष्ठ तव दर्शयितुं जगत् ।\nपृथिवीं चाखिलां ब्रह्मन् तस्मादारोह मां द्विज\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147185, "chapter_id": 4179, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि दशोत्तरशततमोऽध्यायः ॥११०॥\nभगवद्यानपर्वणि एकचत्वारिंशोऽध्यायः ॥४१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]