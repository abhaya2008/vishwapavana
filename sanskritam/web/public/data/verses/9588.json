[{"id": 5000588000, "chapter_id": 9588, "verse_number": "७-५३-१", "content_sanskrit": "लक्ष्मणस्य तु तद्वाक्यं निशम्य परमाद्भुतम् ।\nसुप्रीतश्चाभवद्रामो वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000588001, "chapter_id": 9588, "verse_number": "७-५३-२", "content_sanskrit": "दुर्लभस्त्वीदृशो बन्धुरस्मिन्काले विशेषतः ।\nयादृशस्त्वं महाबुद्धेर्मम सौम्य मनो ऽनुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000588002, "chapter_id": 9588, "verse_number": "७-५३-३", "content_sanskrit": "यच्च मे हृदये किञ्चिद्वर्तते शुभलक्षण ।\nतन्निशामय च श्रुत्वा कुरुष्व वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000588003, "chapter_id": 9588, "verse_number": "७-५३-४", "content_sanskrit": "चत्वारो दिवसाः सौम्य कार्यं पौरजनस्य वै ।\nअकुर्वाणस्य सौमित्रे तन्मे मर्माणि कृन्तति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000588004, "chapter_id": 9588, "verse_number": "७-५३-५", "content_sanskrit": "आहूयन्तां प्रकृतयः पुरोधा मन्त्रिणस्तथा ।\nकार्यार्थिनश्च पुरुषाः स्त्रियश्च पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000588005, "chapter_id": 9588, "verse_number": "७-५३-६", "content_sanskrit": "पौरकार्याणि यो राजा न करोति दिने दिने ।\nसंवृते नरके घोरे पतितो नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000588006, "chapter_id": 9588, "verse_number": "७-५३-७", "content_sanskrit": "श्रूयते हि पुरा राजा नृगो नाम महायशाः ।\nबभूव पृथिवीपालो ब्रह्मण्यः सत्यवाक् शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000588007, "chapter_id": 9588, "verse_number": "७-५३-८", "content_sanskrit": "स कदाचिद्गवां कोटीः सवत्साः स्वर्णभूषिताः ।\nनृदेवो भूमिदेवेभ्यः पुष्करेषु ददौ नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000588008, "chapter_id": 9588, "verse_number": "७-५३-९", "content_sanskrit": "ततः सङ्गाद्गता धेनुः सवत्सा स्पर्शिता ऽनघ ।\nब्राह्मणस्याहिताग्नेश्च दरिद्रस्योञ्छवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000588009, "chapter_id": 9588, "verse_number": "७-५३-१०", "content_sanskrit": "स नष्टां गां क्षुधार्तो वै अन्विषंस्तत्र तत्र च ।\nनापश्यत्सर्वराज्येषु संवत्सरगणान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000588010, "chapter_id": 9588, "verse_number": "७-५३-११", "content_sanskrit": "ततः कनखलं गत्वा जीर्णवत्सां निरामयाम् ।\nददर्श गां स्वकां धेनुं ब्राह्मणस्य निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000588011, "chapter_id": 9588, "verse_number": "७-५३-१२", "content_sanskrit": "अथ तां नामधेयेन स्वकेनोवाच स द्विजः ।\nआगच्छ शबलेत्येवं सा तु शुश्राव गौः स्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000588012, "chapter_id": 9588, "verse_number": "७-५३-१३", "content_sanskrit": "तस्य तं स्वरमाज्ञाय क्षुधार्तस्य द्विजस्य वै ।\nअन्वगात्पृष्ठतः सा गौर्गच्छन्तं पावकोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000588013, "chapter_id": 9588, "verse_number": "७-५३-१४", "content_sanskrit": "यो ऽपि पालयते विप्रः सो ऽपि गामन्वगाद्द्रुतम् ।\nगत्वा तमृषिमाचष्ट मम गौरिति सत्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000588014, "chapter_id": 9588, "verse_number": "७-५३-१५", "content_sanskrit": "स्पर्शिता राजसिंहेन मम दत्ता नृगेण ह ।\nतयोर्ब्राह्मणयोर्वादो महानासीद्विपश्चितोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000588015, "chapter_id": 9588, "verse_number": "७-५३-१६", "content_sanskrit": "विवदन्तौ ततो ऽन्योन्यं दातारमभिजग्मतुः ।\nतौ राजभवनद्वारि न प्राप्तौ नृगशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000588016, "chapter_id": 9588, "verse_number": "७-५३-१७", "content_sanskrit": "अहोरात्राण्यनेकानि वसन्तौ क्रोधमीयतुः ।\nऊचतुश्च महात्मानौ तावुभौ द्विजसत्तमौ ॥\nक्रुद्धौ परमसम्प्राप्तौ वाक्यं घोराभिसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000588017, "chapter_id": 9588, "verse_number": "७-५३-१८", "content_sanskrit": "अर्थिनां कार्यसिद्ध्यर्थं यस्मात्त्वं नैषि दर्शनम् ।\nअदृश्यः सर्वभूतानां कृकलासो भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000588018, "chapter_id": 9588, "verse_number": "७-५३-१९", "content_sanskrit": "बहुवर्षसहस्राणि बहुवर्षशतानि च ।\nश्वभ्रे ऽस्मिन् कृकलासो वै दीर्घकालं वसिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000588019, "chapter_id": 9588, "verse_number": "७-५३-२०", "content_sanskrit": "उत्पत्स्यते हि लोके ऽस्मिन्यदूनां कीर्तिवर्धनः ।\nवासुदेव इति ख्यातो विष्णुः पुरुषविग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000588020, "chapter_id": 9588, "verse_number": "७-५३-२१", "content_sanskrit": "स ते मोक्षयिता राजंस्तस्माच्छापाद्भविष्यसि ।\nकृता च तेन कालेन निष्कृतिस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000588021, "chapter_id": 9588, "verse_number": "७-५३-२२", "content_sanskrit": "भारावतरणार्थं हि नरनारायणावुभौ ।\nउत्पत्स्येते महावीर्यौ कलौ युग उपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000588022, "chapter_id": 9588, "verse_number": "७-५३-२३", "content_sanskrit": "एवं तौ शापमुत्सृज्य ब्राह्मणौ विगतज्वरौ ।\nतां गां हि दुर्बलां वृद्धां ददतुर्ब्राह्मणाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000588023, "chapter_id": 9588, "verse_number": "७-५३-२४", "content_sanskrit": "एवं स राजा तं शापमुपभुङ्क्ते सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000588024, "chapter_id": 9588, "verse_number": "७-५३-२५", "content_sanskrit": "कार्यार्थिनां विमर्दो हि राज्ञां दोषाय कल्पते ।\nतच्छीघ्रं दर्शनं मह्यमभिवर्तन्तु कार्यिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000588025, "chapter_id": 9588, "verse_number": "७-५३-२६", "content_sanskrit": "सुकृतस्य हि कार्यस्य फलं नापैति पार्थिवः ।\nतस्माद्गच्छ प्रतीक्षस्व सौमित्रे कार्यवाञ्जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000588026, "chapter_id": 9588, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]