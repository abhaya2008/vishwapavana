[{"id": 2096682, "chapter_id": 3073, "verse_number": "१३-२०३-१", "content_sanskrit": "भीष्म उवाच।\nअयं नारायणः श्रीमान्पुत्रार्थे व्रतकाङ्क्षया।\nदीक्षितोऽभून्महाबाहुः पुरा द्वादशवार्षिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096683, "chapter_id": 3073, "verse_number": "१३-२०३-२", "content_sanskrit": "दीक्षितं केशवं द्रष्टुमभिजग्मुर्महर्षयः।\nसेवित्वा च महात्मानः प्रीयमाणं जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096684, "chapter_id": 3073, "verse_number": "१३-२०३-३", "content_sanskrit": "नारदः पर्वतश्चैव कृष्णद्वैपायनस्तथा।\nदेवलः काश्यपश्चैव हस्तिकाश्यप एव च।\nजमदग्निश्च राजेन्द्र धौम्यो वाल्मीकिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096685, "chapter_id": 3073, "verse_number": "१३-२०३-४", "content_sanskrit": "अपरेऽपि तपःसिद्धाः सत्यव्रतपरायणाः।\nशिष्यैरनुगताः सर्वे ब्रह्मविद्भिरकल्मषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096686, "chapter_id": 3073, "verse_number": "१३-२०३-५", "content_sanskrit": "केशवस्तानभिगतान्प्रीत्या सम्परिगृह्य च।\nतेषामतिथिसत्कारं पूजनार्थं कुलोचितम्।\nदेवकीतनयो हृष्टो देवतुल्यमकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096687, "chapter_id": 3073, "verse_number": "१३-२०३-६", "content_sanskrit": "उपविष्टेषु सर्वेषु विष्टरेषु तदाऽनघ।\nविश्वस्तेष्व्नभितुष्टेषु केशवार्चनया पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096688, "chapter_id": 3073, "verse_number": "१३-२०३-७", "content_sanskrit": "परस्परं कथा दिव्याः प्रावर्तन्त मनोरमाः।\nविष्णोर्नारायणस्यैव प्रसादात्कथयामि ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096689, "chapter_id": 3073, "verse_number": "१३-२०३-८", "content_sanskrit": "तस्यैव व्रतचर्यायां मुनिभिर्विस्मितं पुरा।\nयत्र गोवृषभाङ्कस्य प्रभावोऽभून्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096690, "chapter_id": 3073, "verse_number": "१३-२०३-९", "content_sanskrit": "यत्र देवी महादेवमपृच्छत्संशयान्पुरा।\nकथयामास सर्वांस्तान्देव्याः प्रियचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096691, "chapter_id": 3073, "verse_number": "१३-२०३-१०", "content_sanskrit": "उमापत्योश्च संवादं शृणु तात मनोरमम्।\nवर्णाश्रमाणां धर्मश्च तत्र तात समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096692, "chapter_id": 3073, "verse_number": "१३-२०३-११", "content_sanskrit": "ऋषिधर्मश्च निखिलो राजधर्मस्च पुष्कलः।\nगृहस्थधर्मश्च शुभः कर्मपाकफलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096693, "chapter_id": 3073, "verse_number": "१३-२०३-१२", "content_sanskrit": "देवगुह्यं च विविधं दानधर्मविधिस्तथा।\nविधानमत्र प्रोक्तं यद्यमस्य नियमस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096694, "chapter_id": 3073, "verse_number": "१३-२०३-१३", "content_sanskrit": "यमलोकविधानं च स्वर्गलोकगतिस्तथा।\nप्राणमोक्षविधिश्चैव तीर्थचर्या च पुष्कला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096695, "chapter_id": 3073, "verse_number": "१३-२०३-१४", "content_sanskrit": "मोक्षधर्मविधानं च साङ्ख्ययोगसमन्वितम्।\nस्त्रीधर्मश्च स्वयं देव्या देवदेवाय भाषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096696, "chapter_id": 3073, "verse_number": "१३-२०३-१५", "content_sanskrit": "एवमादि शुभं सर्वं तत्र तात समाहितम्।\nरुद्राण्याः संशयप्रश्नो यत्र तात प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096697, "chapter_id": 3073, "verse_number": "१३-२०३-१६", "content_sanskrit": "धन्यं यशस्यमायुष्यं धर्म्यं च परमं हितम्।\nपुष्टियोगमिमं दिव्यं कथ्यमानं मया शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096698, "chapter_id": 3073, "verse_number": "१३-२०३-१७", "content_sanskrit": "इतिहासमिमं दिव्यं पवित्रं परमं शुभम्।\nसायं प्रातः सदा सम्यक् श्रोतव्यं च बुभूषता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096699, "chapter_id": 3073, "verse_number": "१३-२०३-१८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096700, "chapter_id": 3073, "verse_number": "१३-२०३-१८", "content_sanskrit": "ततो नारायणो देवः संक्लिष्टो व्रतचर्यया।\nवह्निर्विनिःसृतो वक्त्रात्कृष्णस्याद्भुतदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096701, "chapter_id": 3073, "verse_number": "१३-२०३-१९", "content_sanskrit": "अग्निना तेन महता निःसृतेन मुखाद्विभोः।\nपश्यतामेव सर्वेषां दग्ध एव नगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096702, "chapter_id": 3073, "verse_number": "१३-२०३-२०", "content_sanskrit": "मृगपक्षिगणाकीर्णः श्वापदैरपि सङ्कुलः।\nवृक्षगुल्मलताकीर्णो मथितो दीनदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096703, "chapter_id": 3073, "verse_number": "१३-२०३-२१", "content_sanskrit": "पुनः स दृष्टमात्रेण हरिणा सौम्यचेतसा।\nस बभूव गिरिः क्षिप्रं प्रफुल्लद्रुमकाननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096704, "chapter_id": 3073, "verse_number": "१३-२०३-२२", "content_sanskrit": "सिद्धचारणसङ्घैश्च प्रसन्नैरुपशोभितः।\nमत्तवारणसंयुक्तो नानापक्षिगणैर्युतः।\nतदद्भुतमचिन्त्यं च सर्वेषामभवद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096705, "chapter_id": 3073, "verse_number": "१३-२०३-२३", "content_sanskrit": "तं दृष्ट्वा हृष्टरोमाणः सर्वे मुनिगणास्तदा।\nविस्तिताः परमायत्ताः साध्यसाकुललोचनाः।\nन किञ्चिदब्रुवंस्तत्र शुभं वा यदि वेतरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096706, "chapter_id": 3073, "verse_number": "१३-२०३-२४", "content_sanskrit": "ततो नारायणो देवो मुनिसङ्घे तु विस्मिते।\nतान्समीक्ष्यैव मधुरं बभाषे पुष्करेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096707, "chapter_id": 3073, "verse_number": "१३-२०३-२५", "content_sanskrit": "किमर्थं मुनिसङ्घेऽस्मिन्विस्मयोऽयमनुत्तमः।\nएतन्मे संशयं सर्वे याथातथ्येन नन्दिताः।\nऋषयो वक्तुमर्हन्ति निश्चयेनार्थकोविदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096708, "chapter_id": 3073, "verse_number": "१३-२०३-२६", "content_sanskrit": "केशवस्य वचः श्रुत्वा तुष्टुवुर्मुनिपुङ्गवाः।\nभवान्सृजति वै लोकान्भवान्संहरति प्रजाः।\nभवाञ्शीतं भवानुष्णं भवान्सत्यं भवान्क्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096709, "chapter_id": 3073, "verse_number": "१३-२०३-२७", "content_sanskrit": "भवानादिर्भवानन्तो भवतोऽन्यन्न विद्यते।\nस्थावरं जङ्गमं सर्वं त्वमेव पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096710, "chapter_id": 3073, "verse_number": "१३-२०३-२८", "content_sanskrit": "त्वत्तः सर्वमिदं तात लोकचक्रं प्रवर्तते।\nत्वमेवार्हसि तद्वक्तुं मुखादग्निविनिर्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096711, "chapter_id": 3073, "verse_number": "१३-२०३-२९", "content_sanskrit": "एतन्नो विस्मयकरं बभूव मधुसूदन।\nततो विगतसंत्रासा भवाम पुरुषोत्तम।\nयदिच्छेत्तत्र वक्तव्यं कुतोऽस्माकं नियोगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096712, "chapter_id": 3073, "verse_number": "१३-२०३-३०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096713, "chapter_id": 3073, "verse_number": "१३-२०३-३०", "content_sanskrit": "नित्यं हितार्थं लोकानां भवद्भिः क्रियते तपः।\nतस्माल्लोकहितं गुह्यं श्रूयतां कथयामि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096714, "chapter_id": 3073, "verse_number": "१३-२०३-३१", "content_sanskrit": "असुरः साम्प्रतं कश्चिदहितो लोकनाशनः।\nमायास्त्रकुशलश्चैव बलदर्पसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096715, "chapter_id": 3073, "verse_number": "१३-२०३-३२", "content_sanskrit": "बभूव स मया बद्धो लोकानां हितकाम्यया।\nपुत्रेण मे वधो दृष्टस्तस्य वै मुनिपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096716, "chapter_id": 3073, "verse_number": "१३-२०३-३३", "content_sanskrit": "तदर्थं पुत्रमेवाहं सिसृक्षुर्वनमागतः।\nआत्मनः सदृशं पुत्रमहं जनयितुं व्रतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096717, "chapter_id": 3073, "verse_number": "१३-२०३-३४", "content_sanskrit": "एवं व्रतपरीतस्य तपस्तीव्रतया मम।\nअथात्मा मम देहस्थः सोग्निर्भूत्वा विनिःसृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096718, "chapter_id": 3073, "verse_number": "१३-२०३-३५", "content_sanskrit": "विनिःसृत्य गतो द्रष्टुं क्षणेन च पितामहम्।\nब्रह्मणा मन्मथोऽनङ्गः पुत्रत्वेन प्रकल्पितः।\nअनुज्ञातश्च तेनैव पुनरायान्ममान्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096719, "chapter_id": 3073, "verse_number": "१३-२०३-३६", "content_sanskrit": "एवं मे वैष्णवं तेजो मम वक्त्राद्विनिःसृतम्।\nतत्तेजसा निर्मथितः पुरतोऽयं गिरिः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096720, "chapter_id": 3073, "verse_number": "१३-२०३-३७", "content_sanskrit": "दृष्ट्वा दाहं गिरेस्तस्य सौम्यभावतया मम।\nपुनः स दृष्टमात्रेण गिरिरासीद्यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096721, "chapter_id": 3073, "verse_number": "१३-२०३-३८", "content_sanskrit": "एतद्गुह्यं यथातथ्यं कथितं वः समासतः।\nभवन्तो व्यथिता येन विस्मिताश्च तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096722, "chapter_id": 3073, "verse_number": "१३-२०३-३९", "content_sanskrit": "ऋषीणामेवमुक्त्वा तु तान्पुनः प्रत्यभाषत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096723, "chapter_id": 3073, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्र्यधिकद्विशततमोऽध्यायः॥ २०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]