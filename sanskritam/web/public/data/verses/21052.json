[{"id": 7001052000, "chapter_id": 21052, "verse_number": "५-३४-१", "content_sanskrit": "चक्र कर्म्म महच्छौरिर्बिब्राणो मानुषीं तनुम् ।\nजिगाय शक्र सर्व्वञ्च सर्व्वदेवांश्व लीलया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001052001, "chapter_id": 21052, "verse_number": "५-३४-२", "content_sanskrit": "यज्वान्यदकरोत् कर्म्म दिव्यचेष्टाविघातकृत् ।\nतत् कथ्यतां महाभाग!परं कातूहलं हि मे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001052002, "chapter_id": 21052, "verse_number": "५-३४-३", "content_sanskrit": "पराशर उवाच ।\nगदतो मम विप्रर्षे!श्रूयतामिदमादरात् ।\nनरावतारे कृष्णेन दग्धा वाराणसी यथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001052003, "chapter_id": 21052, "verse_number": "५-३४-४", "content_sanskrit": "पौण्डुको वासुदेवस्तु वासुदेवीऽभवद् भिवि ।\nअवतीर्णस्त्वमित्युक्तो जनैरज्ञानमोहितैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001052004, "chapter_id": 21052, "verse_number": "५-३४-५", "content_sanskrit": "स-मेने वासुदेवोऽहमवतीर्णो महीतले ।\nनष्टस्मृतिस्ततः सर्व्व विष्णचिह्निमचीकरत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001052005, "chapter_id": 21052, "verse_number": "५-३४-६", "content_sanskrit": "दूतञ्च प्रेरयामास कृष्णाय सुमहात्मने ।\nत्यत्तवा चक्रादिकं चिह्न मदीयं नाम चात्मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001052006, "chapter_id": 21052, "verse_number": "५-३४-७", "content_sanskrit": "वासुदेवात्मकं मूढ़!मुत्तवा सर्व्वं विशेषतः ।\nआत्मनो जीवितार्थाय ततो मे प्रणति व्रज ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001052007, "chapter_id": 21052, "verse_number": "५-३४-८", "content_sanskrit": "इत्युक्तः सम्प्रहस्यैन दूतं प्राह जनार्द्दनः ।\nनिजचिह्नमहं चक्र समुत्स्मरक्ष्य त्वयीति वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001052008, "chapter_id": 21052, "verse_number": "५-३४-९", "content_sanskrit": "वाच्यः स पौण्ड्रको गत्वा त्वया दूत!वचो मम ।\nज्ञातस्त्वद्राक्यसद्भावो यत् कार्य्यं तद्रिधीयताभ् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001052009, "chapter_id": 21052, "verse_number": "५-३४-१०", "content_sanskrit": "गृहीतचिह्न एवाहमागमिष्यामि ते पुरम् ।\nसमुत्स्त्रक्ष्यामि ते चक्र निजनिह्नमसंशयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001052010, "chapter_id": 21052, "verse_number": "५-३४-११", "content_sanskrit": "आज्ञापूर्व्वञ्च यदिदमागच्छेति त्वयोदितम् ।\nसम्पादयिष्ये श्वस्तुभ्यं तदप्येषोऽविलम्बितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001052011, "chapter_id": 21052, "verse_number": "५-३४-१२", "content_sanskrit": "शरणां ते समब्येत्य कर्त्तास्मि नृपते!तदा ।\nयथा त्वत्त्वो भयं बूयो न मे किञ्चिद्भविष्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001052012, "chapter_id": 21052, "verse_number": "५-३४-१३", "content_sanskrit": "इत्युक्तेऽपगते दूते संस्मृत्याभ्यागतं हरिः ।\nगरुत्मन्तमथारुह्य त्वरितं तत्पुरं ययौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001052013, "chapter_id": 21052, "verse_number": "५-३४-१४", "content_sanskrit": "स चापि केशवोद्योगं श्रुत्वा काशिपतिस्तदा ।\nसर्व्वसैन्यपरीवारः पार्ष्णिग्राह उपाययौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001052014, "chapter_id": 21052, "verse_number": "५-३४-१५", "content_sanskrit": "ततो बलेन महता काशिराजबलेन च ।\nपौण्ड्रको वासुदेवोऽसौ केशवाभिमुखं ययौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001052015, "chapter_id": 21052, "verse_number": "५-३४-१६", "content_sanskrit": "तं ददर्श हरिर्द्दूरादुदारस्यन्दने स्थितम् ।\nचक्रहस्तं गदाखड़ गबाहु पाणिगताम्बुजम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001052016, "chapter_id": 21052, "verse_number": "५-३४-१७", "content_sanskrit": "स्त्रग्धरं धृतशाङ्गञ्च सुपर्णारचितध्वजम् ।\nवक्षःस्थले कृतञ्चास्य श्रीवत्सं ददृशे हिरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001052017, "chapter_id": 21052, "verse_number": "५-३४-१८", "content_sanskrit": "किरीटकूणडलधरं पीतवासःसमन्वितम् ।\nदृष्ट्वा तं भावगम्भरं जहास गरुडध्वजः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001052018, "chapter_id": 21052, "verse_number": "५-३४-१९", "content_sanskrit": "युयुध च बलेनास्य हस्त्यश्वबहलिना द्रिज!\nनिस्त्रिंशर्ष्टिगदाशूलशक्तिकार्म्मुकशालिना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001052019, "chapter_id": 21052, "verse_number": "५-३४-२०", "content_sanskrit": "क्षणेन शार्ह्गनिर्म्मुक्तैः शरैरिषुविदारणैः ।\nगदाचक्रनिपातैश्व सूदयामास तदूबलम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001052020, "chapter_id": 21052, "verse_number": "५-३४-२१", "content_sanskrit": "काशिराजबलञ्चैव क्षर्यं नित्वा जनार्द्दनः ।\nउवाच पौण्ड्रकं मूद़मात्मचिह्नोपलक्ष्णम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001052021, "chapter_id": 21052, "verse_number": "५-३४-२२", "content_sanskrit": "पौण्ड्रकोक्तं त्वया यत्तु दूतवक्तूणे मां प्रति ।\nसमुतूसृजेति चिह्नानि तत्ते सम्पादयाम्यहम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001052022, "chapter_id": 21052, "verse_number": "५-३४-२३", "content_sanskrit": "चक्रमेतत् समुत्सृष्टं गदेयं ते विसर्जिता ।\nगरुत्मानेष निर्द्दिष्टः समारोहतु ते ध्वजम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001052023, "chapter_id": 21052, "verse_number": "५-३४-२४", "content_sanskrit": "इत्युज्वार्य्य विमुक्तेन चक्रणोसौ विदारितः ।\nपोथितो गदया भग्रो गरुत्माश्व गरुत्मता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001052024, "chapter_id": 21052, "verse_number": "५-३४-२५", "content_sanskrit": "ततो हाहाकृते लोके काशिपुर्य्यधिपो बली ।\nयुयुधे वासुदेवेन मित्रस्यापचितौ स्थितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001052025, "chapter_id": 21052, "verse_number": "५-३४-२६", "content_sanskrit": "ततः शार्ङ्गधनुर्मुक्तैश्छित्त्वा तस्य शरैः शिरः ।\nकाशिपुर्य्याञ्च चिक्षेप कुर्व्वन् सोकस्य विस्मयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001052026, "chapter_id": 21052, "verse_number": "५-३४-२७", "content_sanskrit": "हत्वा च पौणड्रकं शौरिः काखिराजञ्च सानुगम् ।\nपुनर्द्रारवतीं प्राप्तो रेमे स्वर्गगतो यथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001052027, "chapter_id": 21052, "verse_number": "५-३४-२८", "content_sanskrit": "तच्छिरः पतितं दृष्ट्वा तत्र काशिपतेः पुरे ।\nजनः किमेतदित्याह केनत्यत्यन्तविस्मितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001052028, "chapter_id": 21052, "verse_number": "५-३४-२९", "content_sanskrit": "ज्ञात्वा तं वासुदेवेन हतं तस्य सुतस्ततः ।\nपुरोहितेन सहितस्तो।यामास शङ्करम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001052029, "chapter_id": 21052, "verse_number": "५-३४-३०", "content_sanskrit": "अविमुक्ते महाक्षेत्रे तोषितस्तन शङ्करः ।\nवरं वृणीष्वेति तदा तं प्रोवाच नृपात्मजम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001052030, "chapter_id": 21052, "verse_number": "५-३४-३१", "content_sanskrit": "स वब्र भगवान् कृत्या पितृहन्तुर्वधाय मे ।\nसमुत्तिष्ठतु कृष्णस्य त्वत्प्रसादान्महेश्वर ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001052031, "chapter_id": 21052, "verse_number": "५-३४-३२", "content_sanskrit": "एवं भविष्यतीत्युक्ते दक्षिणाग्नेरनन्तरम् ।\nमहाकृत्या समुत्तस्थौ तस्यैवाग्नेर्विन्मशिनी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001052032, "chapter_id": 21052, "verse_number": "५-३४-३३", "content_sanskrit": "ततो ज्वालाकरालास्या ज्वलत्केशकलापिका ।\nकृष्ण कृष्णेति कुपिता कृत्या द्रारवतीं ययौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001052033, "chapter_id": 21052, "verse_number": "५-३४-३४", "content_sanskrit": "तामवेक्ष्य जनस्त्रासविचल्लोचनो मुने!\nययौ शरण्यं जगतां शरणं मधुसूदनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001052034, "chapter_id": 21052, "verse_number": "५-३४-३५", "content_sanskrit": "काशिराजसुतेनेयमाराध्य वृषभध्वजम् ।\nउत्पादिता महाकृत्येत्यवगम्याथ चक्रिणा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001052035, "chapter_id": 21052, "verse_number": "५-३४-३६", "content_sanskrit": "जहि कृत्यामिमामुग्रां वह्निज्वालाजटालकाम् ।\nचक्रमुत्सृष्टमक्षेषु क्रीड़ासक्तेन लीलया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001052036, "chapter_id": 21052, "verse_number": "५-३४-३७", "content_sanskrit": "तदग्रिमालाजटिलज्वालोदूगारातिभीषणाम् ।\nकृत्यामनुजगामाशु विष्णुचक्र सुदर्शनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001052037, "chapter_id": 21052, "verse_number": "५-३४-३८", "content_sanskrit": "चक्रगतापविध्वस्ता कृत्या माहेश्वरी तदा ।\nननाश वेगिनी वेगात् तदप्यनुजगाम ताम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001052038, "chapter_id": 21052, "verse_number": "५-३४-३९", "content_sanskrit": "कृत्.या वाराणसीमेव प्रविवेश त्वरान्विता ।\nविष्णचक्रप्रतिहतप्रभावा मुनिसत्तम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001052039, "chapter_id": 21052, "verse_number": "५-३४-४०", "content_sanskrit": "ततः काशिबलं भूरि प्मथानां तथा बलम् ।\nसमस्तशस्त्रस्त्रयुतं चक्रस्याभिमुखं ययौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001052040, "chapter_id": 21052, "verse_number": "५-३४-४१", "content_sanskrit": "शस्त्रस्त्रमोक्षचतुरं दग्ध्वा तदूबलमोजसा ।\nकृत्यागर्भामशेषां तां दग्ध्वा वाराणसीं पुरीम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001052041, "chapter_id": 21052, "verse_number": "५-३४-४२", "content_sanskrit": "सभूभृदूभृत्यपौरान्तु साश्वमातङ्गमानवाम् ।\nअशेषकोषकोष्ठां तां दुनिंरीक्ष्यां सुरैरपि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001052042, "chapter_id": 21052, "verse_number": "५-३४-४३", "content_sanskrit": "ज्वालापरिप्लुताशेष-गृहृ-प्राकारचत्वराम् ।\nददाह तद्धरेश्वक्रं सकलामेव तां पुरीम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001052043, "chapter_id": 21052, "verse_number": "५-३४-४४", "content_sanskrit": "अक्षीणामर्षमत्युग्रसाध्यसाधनसस्पृहम् ।\nतज्वक्र प्रस्फुरद्दीप्ति विष्णोरभ्याययौ करम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]