[{"id": 2096663, "chapter_id": 3072, "verse_number": "१३-२०२-१", "content_sanskrit": "वैशम्पायन* उवाच।\nअनुशास्य शुभैर्वाक्यैर्भीष्ममाह महामतिः।\nप्रीत्या पुनः स शुश्रूषुर्वचनं यद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096664, "chapter_id": 3072, "verse_number": "१३-२०२-२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096665, "chapter_id": 3072, "verse_number": "१३-२०२-२", "content_sanskrit": "पितामहो मे विप्रर्षे भीष्मं कालवशं गतम्।\nकिमपृच्छत्तदा राजा सर्वसामाजिकं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096666, "chapter_id": 3072, "verse_number": "१३-२०२-३", "content_sanskrit": "उभयोर्लोकयोर्युक्तं पुरुषार्थमनुत्तमम्।\nतन्मे वद महाप्राज्ञ श्रोतुं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096667, "chapter_id": 3072, "verse_number": "१३-२०२-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096668, "chapter_id": 3072, "verse_number": "१३-२०२-४", "content_sanskrit": "भूय एव महाराज शृणु धर्मसमुच्चयम्।\nयदपृच्छत्तदा राजा कुन्तीपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096669, "chapter_id": 3072, "verse_number": "१३-२०२-५", "content_sanskrit": "शरतल्पगतं भीष्मं सर्वपार्थिवसन्निधौ।\nअजातशत्रुः प्रीतात्मा पुनरेवाभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096670, "chapter_id": 3072, "verse_number": "१३-२०२-६", "content_sanskrit": "पितामह महाप्राज्ञ सर्वशास्त्रविशारदः।\nश्रूयतां मे हि वचनमर्थित्वात्प्रब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096671, "chapter_id": 3072, "verse_number": "१३-२०२-७", "content_sanskrit": "परावरज्ञो भूतानां दयावान्सर्वजन्तुषु।\nआगमैर्बहुभिः प्रीतो भवान्नः परमं कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096672, "chapter_id": 3072, "verse_number": "१३-२०२-८", "content_sanskrit": "त्वादृशो दुर्लभो लोके साम्प्रतं ज्ञानसंयुतः।\nभवता गुरुणा चैव धन्याश्चैव वयं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096673, "chapter_id": 3072, "verse_number": "१३-२०२-९", "content_sanskrit": "अयं स कालः सम्प्राप्तो दुर्लभैर्ज्ञातिबान्धवैः।\nशास्ता तु नास्ति नः कश्चित्त्वदृते पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096674, "chapter_id": 3072, "verse_number": "१३-२०२-१०", "content_sanskrit": "तस्माद्धर्मार्थसहितमायत्यां च हितोदयम्।\nआश्चर्यं परमं वाक्यं श्रोतुमिच्छामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096675, "chapter_id": 3072, "verse_number": "१३-२०२-११", "content_sanskrit": "अयं नारायणः श्रीमन्सर्वपार्थिवसन्निधौ।\nभवन्तं बहुमानाच्च प्रणयाच्चैव सेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096676, "chapter_id": 3072, "verse_number": "१३-२०२-१२", "content_sanskrit": "अस्यैव तु समक्षं नः पार्तिवानां तथैव च।\nइतिवृत्तं पुराणं च श्रोतॄणां परमं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096677, "chapter_id": 3072, "verse_number": "१३-२०२-१३", "content_sanskrit": "यदि तेऽहमनुग्राह्यो भ्रातृभिः सहितोऽनघ।\nमत्प्रियार्थं हि कौरव्य स्नेहाद्भाषितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096678, "chapter_id": 3072, "verse_number": "१३-२०२-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096679, "chapter_id": 3072, "verse_number": "१३-२०२-१४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा स्नेहादागतविक्लवः।\nप्रविबन्निव तं दृष्ट्वा भीष्मो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096680, "chapter_id": 3072, "verse_number": "१३-२०२-१५", "content_sanskrit": "शृणु राजन्पुरावृत्तिमितिहासं पुरातनम्।\nएतावदुक्त्वा गाङ्गेयः प्रणम्य शिरसा हरिम्।\nधर्मराजं समीक्ष्येदं पुनर्वक्तुं समारभत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096681, "chapter_id": 3072, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्व्यधिकद्विशततमोऽध्यायः॥ २०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]