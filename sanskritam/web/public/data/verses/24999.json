[{"id": 7004999000, "chapter_id": 24999, "verse_number": "७-१-१८२-१", "content_sanskrit": "ततो मातृगणान्पश्येद्वसुनन्दादिनामतः ।\nअर्क स्थलसमीपस्थान्दक्षिणे नातिदूरतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004999001, "chapter_id": 24999, "verse_number": "७-१-१८२-२", "content_sanskrit": "आश्वयुक्छुक्लपक्षे तु नवम्यां नियतात्मवान् ।\nयस्ताः पूजयते मातॄर्विधिना भावितात्मवान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004999002, "chapter_id": 24999, "verse_number": "७-१-१८२-३", "content_sanskrit": "स समृद्धिमवाप्नोति दुरापामकृतात्मभिः ।\nतत्रैव संस्थितं पश्येच्छ्रीमुखं विवरप्रियम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004999003, "chapter_id": 24999, "verse_number": "७-१-१८२-४", "content_sanskrit": "तस्मिन्नेव दिने पूज्यं सिद्धिकामैर्नरैः सदा ।\nएतत्पूर्वं मयाख्यातं तव विस्तरतः प्रिये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004999004, "chapter_id": 24999, "verse_number": "७-१-१८२-५", "content_sanskrit": "तस्मिन्नेव दिने पूज्यं तीर्थयात्राप्रसंगतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004999005, "chapter_id": 24999, "verse_number": "७-१-१८२-६", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखंडे प्रथमे प्रभासक्षेत्रमाहात्म्ये वसुनन्दामातृगणश्रीमुखविवर माहात्म्यवर्णनंनाम द्व्यशीत्युत्तरशततमोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]