[{"id": 7004794000, "chapter_id": 24794, "verse_number": "६-२५६-१", "content_sanskrit": "गालव उवाच ।\nएकदा भगवान्रुद्रः कैलासशिखरे स्थितः ।\nदधार परमां लक्ष्मीमुमया सहितः किल ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004794001, "chapter_id": 24794, "verse_number": "६-२५६-२", "content_sanskrit": "गणानां कोटयस्तिस्रस्तं यदा पर्यवारयन् ।\nवीरबाहुर्वीरभद्रो वीरसेनश्च भृङ्गिराट् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004794002, "chapter_id": 24794, "verse_number": "६-२५६-३", "content_sanskrit": "रुचिस्तुटिस्तथा नन्दी पुष्पदन्तस्तथोत्कटः ।\nविकटः कण्टकश्चैव हरः केशो विघंटकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004794003, "chapter_id": 24794, "verse_number": "६-२५६-४", "content_sanskrit": "मालाधरः पाशधरः शृङ्गी च नरनस्तथा ।\nपुण्योत्कटः शालिभद्रो महाभद्रो विभद्रकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004794004, "chapter_id": 24794, "verse_number": "६-२५६-५", "content_sanskrit": "कणपः कालपः कालो धनपो रक्तलोचनः ।\nविकटास्यो भद्रकश्च दीर्घजिह्वो विरोचनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004794005, "chapter_id": 24794, "verse_number": "६-२५६-६", "content_sanskrit": "पारदो घनदो ध्वांक्षी हंसक्री नरकस्तथा ।\nपंचशीर्षस्त्रिशीर्षश्च क्रोडदंष्ट्रो महाद्भुत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004794006, "chapter_id": 24794, "verse_number": "६-२५६-७", "content_sanskrit": "सिंहवक्त्रो वृषहनुः प्रचण्डस्तुंडिरेव च ।\nएते चान्ये च बहवस्तदा भवसमीपगाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004794007, "chapter_id": 24794, "verse_number": "६-२५६-८", "content_sanskrit": "महादेव जयेत्युच्चैर्भद्रकालीसमन्विताः ।\nभूतप्रेतपिशाचानां समूहा यस्य वल्लभाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004794008, "chapter_id": 24794, "verse_number": "६-२५६-९", "content_sanskrit": "अस्तुवंस्तं समीपस्था वसन्ते समुपागते ।\nवनराजिर्विभाति स्म नवकोरकशोभिता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004794009, "chapter_id": 24794, "verse_number": "६-२५६-१०", "content_sanskrit": "दक्षिणानिलसंस्पर्शः कवीनां सुखकृद्बभौ ।\nवियोगिहृदयाकर्षी किंशुकः पुष्पशोभितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004794010, "chapter_id": 24794, "verse_number": "६-२५६-११", "content_sanskrit": "द्वन्द्वादिविक्रियाभावं चिक्रीडुश्च समंततः ।\nतस्मिन्विगाढे समये मनस्युन्मादके तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004794011, "chapter_id": 24794, "verse_number": "६-२५६-१२", "content_sanskrit": "नंदी दंडधरः संज्ञां दृष्ट्वा चक्रे हरो परः ।\nअलं चापलदोषेण तपः कुर्वंतु भो गणाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004794012, "chapter_id": 24794, "verse_number": "६-२५६-१३", "content_sanskrit": "तदा सर्वे वनमपि भूकांडजमभूत्पुनः ।\nगणास्ते तप आतस्थुर्दृष्ट्वा कान्तिंवसन्तजाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004794013, "chapter_id": 24794, "verse_number": "६-२५६-१४", "content_sanskrit": "ततः सा विश्वजननी पार्वती प्राह शंकरम् ।\nइयं ते करगा नित्यमक्षमाला महेश्वर ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004794014, "chapter_id": 24794, "verse_number": "६-२५६-१५", "content_sanskrit": "त्वया किं जप्यते देव संदेहयति मे मनः ।\nत्वमेकः सर्व भूतानामादिकृत्सकलेश्वरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004794015, "chapter_id": 24794, "verse_number": "६-२५६-१६", "content_sanskrit": "न माता न पिता बंधुस्तव जातिर्न कश्चन ।\nअहं तव परं किंचिद्वेद्मि नास्तीति किंचन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004794016, "chapter_id": 24794, "verse_number": "६-२५६-१७", "content_sanskrit": "श्रमेण त्वं समायुक्तो श्वासोच्छ्वासपरायणः ।\nजपन्नपि महाभक्त्या दृश्यसे त्वं मया सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004794017, "chapter_id": 24794, "verse_number": "६-२५६-१८", "content_sanskrit": "त्वत्तःपरतरं किचिद्यत्त्वं ध्यायसि चेतसा ।\nतन्मे कथय देवेश यद्यहं दयिता तव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004794018, "chapter_id": 24794, "verse_number": "६-२५६-१९", "content_sanskrit": "इति स्पृष्टस्तदा शंभुरुवाच हरिसेवकः ।\nहरेर्नामसहस्राणां सारं ध्यायामि नित्यशः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004794019, "chapter_id": 24794, "verse_number": "६-२५६-२०", "content_sanskrit": "जपामि रामनामांकमवातरं ससप्तमम् ।\nचतुर्विशतिसंख्याकान्प्रादुर्भावान्हरेर्गुणान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004794020, "chapter_id": 24794, "verse_number": "६-२५६-२१", "content_sanskrit": "एतेषामपि यत्सारं प्रणवाख्यं महत्फलम् ।\nद्वादशाक्षरसंयुक्तं ब्रह्मरूपं सना तनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004794021, "chapter_id": 24794, "verse_number": "६-२५६-२२", "content_sanskrit": "अक्षरत्रयसंबद्धं ग्रामत्रयसमन्वितम् ।\nसबिंदुं प्रणवं शश्वज्जपामि जपमालया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004794022, "chapter_id": 24794, "verse_number": "६-२५६-२३", "content_sanskrit": "वेदसारमिदं नित्यं द्व्यक्षरं सततोद्यतम् ।\nनिर्मलं ह्यमृतं शांतं सदूपममृतोपमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004794023, "chapter_id": 24794, "verse_number": "६-२५६-२४", "content_sanskrit": "कलातीतं निर्वशगं निर्व्यापारं महत्परम् ।\nविश्वाधारं जगन्मध्यं कोटिब्रह्मांडबीजकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004794024, "chapter_id": 24794, "verse_number": "६-२५६-२५", "content_sanskrit": "जडं शुद्धक्रियं वापि निरंजनं नियामकम् ।\nयज्ज्ञात्वा मुच्यते क्षिप्रं घोरसंसारबंधनात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004794025, "chapter_id": 24794, "verse_number": "६-२५६-२६", "content_sanskrit": "ओंकारसहितं यच्च द्वादशाक्षरबीजकम् ।\nजपतः पापकोटीनां दावाग्नित्वं प्रजायते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004794026, "chapter_id": 24794, "verse_number": "६-२५६-२७", "content_sanskrit": "एतदेव परं गुह्यमेतदेव परं महः ।\nएतद्धि दुर्लभं लोके लोकत्रयविभूषणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004794027, "chapter_id": 24794, "verse_number": "६-२५६-२८", "content_sanskrit": "प्राप्यते जन्मकोटीभिः शुभाशुभविनाशकम् ।\nएतदेव परं ज्ञानं द्वादशाक्षरचिन्तनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004794028, "chapter_id": 24794, "verse_number": "६-२५६-२९", "content_sanskrit": "चातुर्मास्ये विशेषेण ब्रह्मदं चिंतितप्रदम् ।\nएतदक्षरजं स्तोत्रं यः समाश्रयते सदा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004794029, "chapter_id": 24794, "verse_number": "६-२५६-३०", "content_sanskrit": "मनसा कर्मणा वाचा तस्य नास्ति पुनर्भवः ।\nद्वादशाक्षरसंयुक्तं चक्रद्वादशभूषितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004794030, "chapter_id": 24794, "verse_number": "६-२५६-३१", "content_sanskrit": "मासद्वादशनामानि विष्णोर्यो भक्तितत्परः ।\nशालग्रामेषु तान्युक्त्वा न्यसेदघहराणि च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004794031, "chapter_id": 24794, "verse_number": "६-२५६-३२", "content_sanskrit": "दिवसेदिवसे तस्य द्वादशाहफलं लभेत् ।\nद्वादशाक्षर माहात्म्यं वर्णितुं नैव शक्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004794032, "chapter_id": 24794, "verse_number": "६-२५६-३३", "content_sanskrit": "जिह्वासहस्रैरपि च ब्रह्मणापि न वार्यते ।\nमहामन्त्रो ह्ययं लोके जप्यो ध्यातः स्तुतस्तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004794033, "chapter_id": 24794, "verse_number": "६-२५६-३४", "content_sanskrit": "पापहा सर्वमासेषु चातुर्मास्ये विशेषतः ।\nइदं रहस्यं वेदानां पुराणानामनेकशः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004794034, "chapter_id": 24794, "verse_number": "६-२५६-३५", "content_sanskrit": "स्मृतीनामपि सर्वासां द्वादशाक्षरचिन्तनम् ।\nचिंतनादेव मर्त्यानां सिद्धिर्भवति हीप्सिता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004794035, "chapter_id": 24794, "verse_number": "६-२५६-३६", "content_sanskrit": "पुण्यदानेन याम्येन मुक्तिर्भवति शाश्वती ।\nवर्णैस्तथाश्रमैरेव प्रणवेन समन्वितैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004794036, "chapter_id": 24794, "verse_number": "६-२५६-३७", "content_sanskrit": "जपैर्ध्यानैः शमपरैर्मोक्षं यास्येत निश्चितम ।\nशूद्राणां चापि नारीणां प्रणवेन विवर्जितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004794037, "chapter_id": 24794, "verse_number": "६-२५६-३८", "content_sanskrit": "प्रकृतीनां च सर्वासां न मन्त्रो द्वादशाक्षरः ।\nन जपो न तपः कार्यं कायक्लेशाद्विशुद्धिता ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004794038, "chapter_id": 24794, "verse_number": "६-२५६-३९", "content_sanskrit": "विप्रभक्त्या च दानेन विष्णुध्यानेन सिद्ध्यति ।\nतासां मन्त्रो रामनाम ध्येयः कोट्यधिको भवेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004794039, "chapter_id": 24794, "verse_number": "६-२५६-४०", "content_sanskrit": "रामेति द्व्यक्षरजपः सर्वपापापनोदकः ।\nगच्छंस्तिष्ठञ्छयानो वा मनुजो रामकीर्तनात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004794040, "chapter_id": 24794, "verse_number": "६-२५६-४१", "content_sanskrit": "इह निर्वर्ततो याति प्रान्ते हरिगणो भवेत् ।\nरामेति द्व्यक्षरो मन्त्रो मंत्रकोटिशताधिकः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004794041, "chapter_id": 24794, "verse_number": "६-२५६-४२", "content_sanskrit": "सर्वासां प्रकृतीनां च कथितः पापनाशकः ।\nचातुर्मास्येऽथ संप्राप्ते सोऽप्यनंतफलप्रदः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004794042, "chapter_id": 24794, "verse_number": "६-२५६-४३", "content_sanskrit": "चातुर्मास्ये महापुण्ये लभ्यते भक्तितत्परैः ।\nदेववन्निष्फलं तेषां यमलोकस्यसेवनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004794043, "chapter_id": 24794, "verse_number": "६-२५६-४४", "content_sanskrit": "न रामादधिकं किंचित्पठनं जगतीतले ।\nरामनामाश्रया ये वै न तेषां यमयातना ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004794044, "chapter_id": 24794, "verse_number": "६-२५६-४५", "content_sanskrit": "ये च दोषा विघ्नकरा मृतका विग्रहाश्च ये ।\nराम नामैव विलयं यांति नात्र विचारणा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004794045, "chapter_id": 24794, "verse_number": "६-२५६-४६", "content_sanskrit": "रमते सर्वभूतेषु स्थावरेषु चरेषु च ।\nअन्तरात्मस्वरूपेण यच्च रामेति कथ्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004794046, "chapter_id": 24794, "verse_number": "६-२५६-४७", "content_sanskrit": "रामेति मत्रराजोऽयं भयव्याधिनिषूदकः ।\nरणे विजयदश्चापि सर्वकार्यार्थसाधकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004794047, "chapter_id": 24794, "verse_number": "६-२५६-४८", "content_sanskrit": "सर्वतीर्थफलः प्रोक्तो विप्राणामपि कामदः ।\nरामचन्द्रेति रामेति रामेति समुदाहृतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004794048, "chapter_id": 24794, "verse_number": "६-२५६-४९", "content_sanskrit": "द्व्यक्षरो मन्त्रराजोऽयं सर्वकार्यकरो भुवि ।\nदेवा अपि प्रगायंति रामनामगुणाकरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004794049, "chapter_id": 24794, "verse_number": "६-२५६-५०", "content_sanskrit": "तस्मात्त्वमपि देवेशि रामनाम सदा वद ।\nरामनाम जपेद्यो वै मुच्यते सर्वकिल्बिषैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004794050, "chapter_id": 24794, "verse_number": "६-२५६-५१", "content_sanskrit": "सहस्रनामजं पुण्यं रामनाम्नैव जायते ।\nचातुर्मास्ये विशेषेण तत्पुण्यं दशधोत्तरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004794051, "chapter_id": 24794, "verse_number": "६-२५६-५२", "content_sanskrit": "हीनजातिप्रजातानां महदह्यति पातकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004794052, "chapter_id": 24794, "verse_number": "६-२५६-५३", "content_sanskrit": "रामो ह्ययं विश्वमिदं समयं स्वतेजसा व्याप्य जनांतरात्मना ।\nपुनाति जन्मांतरपातकानि स्थूलानि सूक्ष्माणि क्षणाच्च दग्ध्वा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004794053, "chapter_id": 24794, "verse_number": "६-२५६-५४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये शेषशाय्युपाख्याने ब्रह्मनारदसंवादे चातुर्मास्यमाहात्म्ये रामनाममहिमवर्णनं नाम षट्पंचाशदुत्तरद्विशततमोऽध्यायः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]