[{"id": 900008231, "chapter_id": 8623, "verse_number": "4.1", "content_sanskrit": "उक्तस्य लक्षणस्यातिव्याप्तिनिरासाय प्रमाणमुच्यत..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008232, "chapter_id": 8623, "verse_number": "4.2", "content_sanskrit": "उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008233, "chapter_id": 8623, "verse_number": "4.3", "content_sanskrit": "यद्वा अत्रानुमानेन पूर्वपक्षे तदयोग्यत्वेन सिद्धान्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008234, "chapter_id": 8623, "verse_number": "4.4", "content_sanskrit": "यद्यप्यागमप्रामाण्यवादिनेहाप्यसम्भवो वक्तुं शक्यस्तथापि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008235, "chapter_id": 8623, "verse_number": "4.5", "content_sanskrit": "किञ्चास्य समन्वयप्रस्तावायोक्तलक्षणे ब्रह्मणि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008236, "chapter_id": 8623, "verse_number": "4.6", "content_sanskrit": "अत्र जगत्कारणत्वं किमन्यस्यापि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008237, "chapter_id": 8623, "verse_number": "4.7", "content_sanskrit": "यद्वा महाकल्पत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008238, "chapter_id": 8623, "verse_number": "4.8", "content_sanskrit": "यद्वा कार्यत्वाद्यनुमानेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008239, "chapter_id": 8623, "verse_number": "4.9", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008240, "chapter_id": 8623, "verse_number": "4.10", "content_sanskrit": "अत्र परेषां भाष्ये शास्त्रस्य योनिरिति विग्रहमाश्रित्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008241, "chapter_id": 8623, "verse_number": "4.11", "content_sanskrit": "अत्र भामतीविवरणयोः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008242, "chapter_id": 8623, "verse_number": "4.12", "content_sanskrit": "विवरणे तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008243, "chapter_id": 8623, "verse_number": "4.13", "content_sanskrit": "ननु तर्हि पूर्वसूत्रोक्तसर्वकारणत्वाक्षेपे तत्समाधानार्थमिदमस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008244, "chapter_id": 8623, "verse_number": "4.14", "content_sanskrit": "केचित्तु जगत्कारणं न वेदवाक्यप्रतिपाद्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008245, "chapter_id": 8623, "verse_number": "4.15", "content_sanskrit": "एतेनैवाद्वैतिनां शास्त्रं योनिः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008246, "chapter_id": 8623, "verse_number": "4.16", "content_sanskrit": "यादवप्रकाशीये तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008247, "chapter_id": 8623, "verse_number": "4.17", "content_sanskrit": "टीकाक्षरार्थस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]