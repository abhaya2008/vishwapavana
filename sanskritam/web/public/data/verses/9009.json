[{"id": 5000009000, "chapter_id": 9009, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000009001, "chapter_id": 9009, "verse_number": "१-९-१", "content_sanskrit": "एतच्छ्रुत्वा रहः सूतो राजानमिदमब्रवीत् ।\nश्रूयतां तत् पुरावृत्तं पुराणे च मया श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000009002, "chapter_id": 9009, "verse_number": "१-९-२", "content_sanskrit": "ऋत्विग्भिरुपदिष्टोऽयं पुरावृत्तो मया श्रुतः ।\nसनत्कुमारो भगवान् पूर्वं कथितवान् कथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000009003, "chapter_id": 9009, "verse_number": "१-९-३", "content_sanskrit": "ऋषीणां संनिधौ राजंस्तव पुत्रागमं प्रति ।\nकाश्यपस्य च पुत्रोऽस्ति विभाण्डक इति श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000009004, "chapter_id": 9009, "verse_number": "१-९-४", "content_sanskrit": "ऋश्यशृङ्ग इति ख्यातस्तस्य पुत्रो भविष्यति ।\nस वने नित्यसंवृद्धो मुनिर्वनचरः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000009005, "chapter_id": 9009, "verse_number": "१-९-५", "content_sanskrit": "नान्यं जानाति विप्रेन्द्रो नित्यं पित्रनुवर्तनात् ।\nद्वैविध्यं ब्रह्मचर्यस्य भविष्यति महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000009006, "chapter_id": 9009, "verse_number": "१-९-६", "content_sanskrit": "लोकेषु प्रथितं राजन् विप्रैश्च कथितं सदा ।\nतस्यैवं वर्तमानस्य कालः समभिवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000009007, "chapter_id": 9009, "verse_number": "१-९-७", "content_sanskrit": "अग्निं शुश्रूषमाणस्य पितरं च यशस्विनम् ।\nएतस्मिन्नेव काले तु रोमपादः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000009008, "chapter_id": 9009, "verse_number": "१-९-८", "content_sanskrit": "अङ्गेषु प्रथितो राजा भविष्यति महाबलः ।\nतस्य व्यतिक्रमाद् राज्ञो भविष्यति सुदारुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000009009, "chapter_id": 9009, "verse_number": "१-९-९", "content_sanskrit": "अनावृष्टिः सुघोरा वै सर्वलोकभयावहा ।\nअनावृष्ट्यां तु वृत्तायां राजा दुःखसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000009010, "chapter_id": 9009, "verse_number": "१-९-१०", "content_sanskrit": "ब्राह्मणाञ्छ्रुतसंवृद्धान् समानीय प्रवक्ष्यति व ।\nभवन्तः श्रुतकर्माणो लोकचारित्रवेदिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000009011, "chapter_id": 9009, "verse_number": "१-९-११", "content_sanskrit": "समादिशन्तु नियमं प्रायश्चित्तं यथा भवेत् ।\nइत्युक्तास्ते ततो राज्ञा सर्वे ब्राह्मणसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000009012, "chapter_id": 9009, "verse_number": "१-९-१२", "content_sanskrit": "वक्ष्यन्ति ते महीपालं ब्राह्मणा वेदपारगाः ।\nविभाण्डकसुतं राजन् सर्वोपायैरिहानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000009013, "chapter_id": 9009, "verse_number": "१-९-१३", "content_sanskrit": "आनाय्य तु महीपाल ऋष्यशृङ्गं सुसत्कृतम् ।\nविभाण्डकसुतं राजन् ब्राह्मणं वेदपारगम् ।\nप्रयच्छ कन्यां शान्तां वै विधिना सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000009014, "chapter_id": 9009, "verse_number": "१-९-१४", "content_sanskrit": "तेषां तु वचनं श्रुत्वा राजा चिन्तां प्रपत्स्यते ।\nकेनोपायेन वै शक्यमिहानेतुं स वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000009015, "chapter_id": 9009, "verse_number": "१-९-१५", "content_sanskrit": "ततो राजा विनिश्चित्य सह मन्त्रिभिरात्मवान् ।\nपुरोहितममात्यांश्च प्रेषयिष्यति सत्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000009016, "chapter_id": 9009, "verse_number": "१-९-१६", "content_sanskrit": "ते तु राज्ञो वचः श्रुत्वा व्यथिता विनताननाः ।\nन गच्छेम ऋषेर्भीता अनुनेष्यन्ति तं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000009017, "chapter_id": 9009, "verse_number": "१-९-१७", "content_sanskrit": "वक्ष्यन्ति चिन्तयित्वा ते तस्योपायांश्च तान्क्षमान् ।\nआनेष्यामो वयं विप्रं न च दोषो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000009018, "chapter_id": 9009, "verse_number": "१-९-१८", "content_sanskrit": "एवमङ्गाधिपेनैव गणिकाभिर्ऋषेः सुतः ।\nआनीतोऽवर्षयद् देवः शान्ता चास्मै प्रदीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000009019, "chapter_id": 9009, "verse_number": "१-९-१९", "content_sanskrit": "ऋश्यशृङ्गस्तु जामाता पुत्रांस्तव विधास्यति ।\nसनत्कुमारकथितमेतावद् व्याहृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000009020, "chapter_id": 9009, "verse_number": "१-९-२०", "content_sanskrit": "अथ हृष्टो दशरथः सुमन्त्रं प्रत्यभाषत।\nयथर्ष्यशृङ्गस्त्वानीतो येनोपायेन सोच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000009021, "chapter_id": 9009, "verse_number": null, "content_sanskrit": "इति श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]