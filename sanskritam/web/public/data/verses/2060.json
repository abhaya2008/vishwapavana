[{"id": 2048054, "chapter_id": 2060, "verse_number": "६-१०९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048055, "chapter_id": 2060, "verse_number": "६-१०९-१", "content_sanskrit": "कथं शिखण्डी गाङ्गेयमभ्यधावत्पितामहम् ।\nपाञ्चाल्यः समरे क्रुद्धो धर्मात्मानं यतव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048056, "chapter_id": 2060, "verse_number": "६-१०९-२", "content_sanskrit": "केऽरक्षन्पाण्डवानीके शिखण्डिनमुदायुधाः।\nत्वरमाणास्त्वराकाले जिगीषन्तो महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048057, "chapter_id": 2060, "verse_number": "६-१०९-३", "content_sanskrit": "कथं शान्तनवो भीष्मः स तस्मिन्दशमेऽहनि।\nअयुध्यत महावीर्यः पाण्डवैः सह सृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048058, "chapter_id": 2060, "verse_number": "६-१०९-४", "content_sanskrit": "न मृष्यामि रणे भीष्मं प्रत्युद्यातं शिखण्डिना ।\nकच्चिन्न रथमद्गोऽस्व धनुर्वाऽशीर्यतास्थतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048059, "chapter_id": 2060, "verse_number": "६-१०९-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048060, "chapter_id": 2060, "verse_number": "६-१०९-५", "content_sanskrit": "नाशीर्यत धनुश्चास्य रथभङ्गो न चाप्यभूत्।\nयुध्यमानस्य संग्रामे भीष्मस्य भरतर्षभ।\nनिघ्नतः समरे शत्रून्शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048061, "chapter_id": 2060, "verse_number": "६-१०९-६", "content_sanskrit": "अनेकशतसाहस्रावकानां महारथाः ।\nतथा दन्तिगणा राजन्हायश्चैव सुसञ्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048062, "chapter_id": 2060, "verse_number": "६-१०९-७", "content_sanskrit": "अभ्यवर्तन्त युद्धाय पुरस्कृत्य पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048063, "chapter_id": 2060, "verse_number": "६-१०९-८", "content_sanskrit": "यथाप्रतिज्ञं कौरव्य स चापि समिर्तिजयः ।\nपार्यानामकरोद्भीष्मः सततं समिति क्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048064, "chapter_id": 2060, "verse_number": "६-१०९-९", "content_sanskrit": "युध्यमानं महेष्वासं विनिघ्नन्तं पराञ्शरैः ।\nपाञ्चालाः पाण्डवैः सार्ध सर्वतः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048065, "chapter_id": 2060, "verse_number": "६-१०९-१०", "content_sanskrit": "दशमेऽहनि संप्राप्ते ततस्तां रिपुवाहिनीम् ।\nकीर्यमाणां शितैर्बाणैः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048066, "chapter_id": 2060, "verse_number": "६-१०९-११", "content_sanskrit": "न हि भीष्मं महेष्वासं पाण्डवाः पाण्डुपूर्वज ।\nअशक्नुवन्रणे जेतुं पाशहस्तमिवानतकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048067, "chapter_id": 2060, "verse_number": "६-१०९-१२", "content_sanskrit": "अथोपायान्महाराज सव्यसाची धनञ्जयः ।\nत्रासयन्रथिनः सर्वान्बीभत्सुरपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048068, "chapter_id": 2060, "verse_number": "६-१०९-१३", "content_sanskrit": "सिंहवद्विनदन्नुच्चैर्धनुर्ज्यां विक्षिपन्मुहुः ।\nशरौघान्विसृजन्पार्थो व्यचरत्कालवद्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048069, "chapter_id": 2060, "verse_number": "६-१०९-१४", "content_sanskrit": "तस्य शब्देन वित्रस्तास्तावका भारतर्षभ ।\nसिंहस्येव मृगा राजन्व्यद्रवन्त महाभयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048070, "chapter_id": 2060, "verse_number": "६-१०९-१५", "content_sanskrit": "जयन्तं पाण्डवं दृष्ट्वा त्वत्सैन्यं चाभिपीडितम् ।\nदुर्योधनस्ततो भीष्ममब्रवीद्भृशपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048071, "chapter_id": 2060, "verse_number": "६-१०९-१६", "content_sanskrit": "एष पाण्डुसुतस्तात श्वेताश्वः कृष्णसारथिः।\nदहते मामकान्सर्वान्कृष्णवर्त्मेन काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048072, "chapter_id": 2060, "verse_number": "६-१०९-१७", "content_sanskrit": "पश्य सैन्यानि गाङ्गेय द्रवमाणानि सर्वशः ।\nपण्डवेन युधां श्रेष्ठ काल्यमानानि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048073, "chapter_id": 2060, "verse_number": "६-१०९-१८", "content_sanskrit": "यथा पशुगणान्पालः संकालयति कानने ।\nतथेदं मामकं सैन्यं काल्यते शत्रुतापन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048074, "chapter_id": 2060, "verse_number": "६-१०९-१९", "content_sanskrit": "धनञ्जयशरैर्भग्नं द्रवमाणं ततस्ततः ।\nभीमोऽप्येवं दुराधर्पो विद्रावयति मे बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048075, "chapter_id": 2060, "verse_number": "६-१०९-२०", "content_sanskrit": "सात्यकिश्चेकितानश्च माद्रीपुत्रौ च पाण्डवौ।\nअभिमन्युः सुविक्रान्तो वाहिनीं द्रवते मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048076, "chapter_id": 2060, "verse_number": "६-१०९-२१", "content_sanskrit": "धृष्टद्युम्नस्तथा शूरो राक्षसश्च घटोत्कचः ।\nव्यद्रावयेतां सहसा सैन्यं मम महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048077, "chapter_id": 2060, "verse_number": "६-१०९-२२", "content_sanskrit": "वध्यमानस्य सैन्यस्य सर्वैरेतैर्महारथैः ।\nनान्यां गतिं प्रपश्यामि स्थाने युद्धे च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048078, "chapter_id": 2060, "verse_number": "६-१०९-२३", "content_sanskrit": "ऋते त्वां पुरुषव्याघ्र देवतुल्यपराक्रमम्।\nपर्याप्तस्तु भवाञ्शीघ्रं पीडितानां गतिर्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048079, "chapter_id": 2060, "verse_number": "६-१०९-२४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048080, "chapter_id": 2060, "verse_number": "६-१०९-२४", "content_sanskrit": "एवमुक्तो महाराज पिता देवव्रतस्तव।\nचिन्तयित्वा मुहूर्तं तु कृत्वा निश्चयमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048081, "chapter_id": 2060, "verse_number": "६-१०९-२५", "content_sanskrit": "तव संधारयन्पुत्रमब्रवीच्छंतनोः सुतः।\nदुर्योधन विजानीहि स्थिरो भूत्वा विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048082, "chapter_id": 2060, "verse_number": "६-१०९-२६", "content_sanskrit": "`पातयिष्ये रिपूनन्यान्पाण्डवान्प्रतिपालयन् ।\nप्रतिज्ञातो जयो ह्यद्य पाण्डवानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048083, "chapter_id": 2060, "verse_number": "६-१०९-२७", "content_sanskrit": "पूर्वकालं तव मया प्रतिज्ञानं महाबल ।\nहत्वा दशसहस्राणि क्षत्रियाणां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048084, "chapter_id": 2060, "verse_number": "६-१०९-२८", "content_sanskrit": "संग्रामादपयास्यामि ह्येतत्कर्म समाहितम् ।\nइति तत्कृतवांश्चाहं यथोक्तं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048085, "chapter_id": 2060, "verse_number": "६-१०९-२९", "content_sanskrit": "अद्य चापि महत्कर्म प्रकरिष्ये यथाबलम् ।\nअहं वाऽद्य हतः शेष्ये हनिष्ये वाऽद्य पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048086, "chapter_id": 2060, "verse_number": "६-१०९-३०", "content_sanskrit": "`अशक्याः पाण्डवा जेतुं देवैरपि सवासवैः।\nकिं पुनर्मर्त्यधर्मेण क्षत्रियेण महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048087, "chapter_id": 2060, "verse_number": "६-१०९-३१", "content_sanskrit": "अद्य ते पुरुषव्याघ्र प्रतरिष्ये ऋणं तव।\nभर्तृपिण्डकृतं राजन्निहताः पृतनामुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048088, "chapter_id": 2060, "verse_number": "६-१०९-३२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048089, "chapter_id": 2060, "verse_number": "६-१०९-३२", "content_sanskrit": "इत्युक्त्वा भरतश्रेष्ठ क्षत्रियान्प्रवपञ्छरैः।\nआससाद दुराधर्षः पाण्डवानामनीकिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048090, "chapter_id": 2060, "verse_number": "६-१०९-३३", "content_sanskrit": "अनीकमध्ये तिष्ठन्तं गाङ्गेयं भारतर्षभ ।\nआशीविषमिव क्रुद्धं पाण्डवाः प्रत्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048091, "chapter_id": 2060, "verse_number": "६-१०९-३४", "content_sanskrit": "दशमेऽहनि भीष्मस्तु दर्शयञ्शक्तिमात्मनः ।\nराजञ्शतसहस्राणि सोऽवधीत्कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048092, "chapter_id": 2060, "verse_number": "६-१०९-३५", "content_sanskrit": "पाञ्चालानां च ये श्रेष्ठा राजपुत्रा महारथाः ।\nतेषामादत्त तेजांसि जलं सूर्य इवांशुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048093, "chapter_id": 2060, "verse_number": "६-१०९-३६", "content_sanskrit": "हत्वा दशसहस्राणि कुञ्जराणां तरस्विनाम् ।\nसारोहाणां महाराज हयानां चायुतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048094, "chapter_id": 2060, "verse_number": "६-१०९-३७", "content_sanskrit": "पूर्णे शतसहस्रे द्वे पादातानां नरोत्तमः ।\nप्रजज्वाल रणे भीष्मो विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048095, "chapter_id": 2060, "verse_number": "६-१०९-३८", "content_sanskrit": "न चैवं पाण्डवेयानां केचिच्छेकुर्निरीक्षितुम् ।\nउत्तरं मार्गमास्थाय तपन्तमिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048096, "chapter_id": 2060, "verse_number": "६-१०९-३९", "content_sanskrit": "ते पाण्डवेवाः संरब्धा महेष्वासेन पीडिताः ।\nवधायाभ्यद्रवन्भीष्मं सृञ्जयाश्च महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048097, "chapter_id": 2060, "verse_number": "६-१०९-४०", "content_sanskrit": "स वध्यमानो बहुभिर्भीष्मः शान्तनवस्तथा ।\nअवकीर्णो महेष्वासैः शैलो मेघैरिवावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048098, "chapter_id": 2060, "verse_number": "६-१०९-४१", "content_sanskrit": "पुत्रास्तु तव गाङ्गेयं समन्तात्पर्यवारयन् ।\nमहत्या सेनया सार्धं ततो युद्धमवर्तत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048099, "chapter_id": 2060, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे नवाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१०९-८ समितिंजयः संग्रामजित्। समिति युद्धे ॥ ६-१०९-२० द्रवते द्रावयति ॥ ६-१०९-२२ गतिं धाम। आश्रयमिति यावत्। स्थाने अवस्थाने ॥ ६-१०९-२९ शेष्ये स्वप्स्यामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]