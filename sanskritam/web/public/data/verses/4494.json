[{"id": 2161658, "chapter_id": 4494, "verse_number": "", "content_sanskrit": "अर्जुनं गच्छतः सात्यकेः कृतवर्मणा सह युद्धम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2161659, "chapter_id": 4494, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2161660, "chapter_id": 4494, "verse_number": "१", "content_sanskrit": "प्रयाते तव सैन्यं तु युयुधाने युयुत्सया ।\nधर्मराजो महाराज स्वेनानीकेन संवृतः\nप्रायाद् द्रोणरथप्रेप्सुः युयुधानस्य पृष्ठतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2161661, "chapter_id": 4494, "verse_number": "२", "content_sanskrit": "ततः पाञ्चालराजस्य पुत्रः सङ्ग्रामदुर्मदः ।\nप्रयाते माधवे राजन्निदं वचनमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2161662, "chapter_id": 4494, "verse_number": "३", "content_sanskrit": "प्राक्रोशत् पाण्डवानीके वसुदानश्च पार्थिवः \t॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2161663, "chapter_id": 4494, "verse_number": "४", "content_sanskrit": "आगच्छत प्रहरत द्रुतं विपरिधावत ।\nयथा सुखेन गच्छेत सात्यकिर्युद्धदुर्मदः\nमहारथा हि बहवो यतिष्यन्तेऽस्य निर्जये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2161664, "chapter_id": 4494, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2161665, "chapter_id": 4494, "verse_number": "५", "content_sanskrit": "सेनापतिवचः श्रुत्वा पाण्डवेयाः समन्ततः ।\nअभ्युद्ययुर्महाराज तव सैन्यं समन्ततः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2161666, "chapter_id": 4494, "verse_number": "६", "content_sanskrit": "जहि प्रहर गृह्णीहि विध्य विद्रावयाद्रव ।\nइति ब्रुवन्तो वेगेन समापेतुर्बलं तव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2161667, "chapter_id": 4494, "verse_number": "७", "content_sanskrit": "वयं प्रतिजिगीषन्तस्तत्र तान् समभिद्रुताः ।\nबाणशब्दरवान् कृत्वा विमिश्रान् शङ्खनिस्वनैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2161668, "chapter_id": 4494, "verse_number": "८", "content_sanskrit": "युयुधानरथं दृष्ट्वा तावका अभिदुद्रुवुः ।\nततः शब्दो महानासीद् युयुधानरथं प्रति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2161669, "chapter_id": 4494, "verse_number": "९", "content_sanskrit": "प्रकम्प्यमाना महती तव पुत्रस्य वाहिनी ।\nसात्वतेन महाराज शतधाऽभिव्यदीर्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2161670, "chapter_id": 4494, "verse_number": "१०", "content_sanskrit": "तस्यां विदीर्यमाणायां शिनेः पौत्रो महारथः ।\nसप्त वीरान् महेष्वासान् अग्रानीकेष्वपोथयत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2161671, "chapter_id": 4494, "verse_number": "११", "content_sanskrit": "अथान्यानपि राजेन्द्र नानाजनपदेश्वरान् ।\nशरैरनलसङ्काशैर्निन्ये वीरान् यमक्षयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2161672, "chapter_id": 4494, "verse_number": "१२", "content_sanskrit": "शतमेकेन विव्याध शतेनैकं च पत्रिणा ।\nद्विपारोहान् द्विपांश्चैव हयारोहान् हयांस्तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2161673, "chapter_id": 4494, "verse_number": "१३", "content_sanskrit": "रथिनः साश्वसूतांश्च जघानेशः पशूनिव ।\nतं तथाभूतकर्माणं शरसङ्घातवर्षिणम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2161674, "chapter_id": 4494, "verse_number": "१४", "content_sanskrit": "न केचनाभ्यधावन् वै सात्यकिं तव सैनिकाः ।\nते भीत्वा मृद्यमानाश्च प्रमृष्टा दीर्घबाहुना \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2161675, "chapter_id": 4494, "verse_number": "१५", "content_sanskrit": "आयोधनं जहुर्वीरा दृष्ट्वा तमतिपौरुषम् ।\nतमेकं बहुधा पश्यन् मोहितास्तस्य तेजसा \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2161676, "chapter_id": 4494, "verse_number": "१६", "content_sanskrit": "सङ्ग्रामकोविदं वीरं विचरन्तमभीतवत् ।\nरथैर्विमथिताक्षैश्च भग्ननीडैश्च मारिष \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2161677, "chapter_id": 4494, "verse_number": "१७", "content_sanskrit": "चक्रैर्विमथितैश्छिन्नैर्ध्वजैश्च विनिपातितैः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2161678, "chapter_id": 4494, "verse_number": "१८", "content_sanskrit": "अनुकर्षैः पताकाभिः शिरस्त्राणैः सकाञ्चनैः ।\nबाहुभिश्चन्दनादिग्धैः साङ्गदैश्च विशाम्पते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2161679, "chapter_id": 4494, "verse_number": "१९", "content_sanskrit": "हस्तिहस्तोपमैश्चापि भुजगाभोगसन्निभैः ।\nऊरुभिः पृथिवी च्छन्ना मनुजानां नरोत्तम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2161680, "chapter_id": 4494, "verse_number": "२०", "content_sanskrit": "शशाङ्कसदृशाकारैः वदनैश्च सकुण्डलैः ।\nपतितैर्वृषभाक्षाणां बभौ भारत मेदिनी\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2161681, "chapter_id": 4494, "verse_number": "२१", "content_sanskrit": "गजैश्च बहुधा च्छिन्नैः शयानैः पर्वतोपमैः ।\nरराजातिभृशं भूमिः विकीर्णैरिव पर्वतैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2161682, "chapter_id": 4494, "verse_number": "२२", "content_sanskrit": "तपनीयमयैर्योक्त्रैर्मुक्ताजालविभूषितैः ।\nउरश्छदैर्विचित्रैश्च व्यरोचन्त तुरङ्गमाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2161683, "chapter_id": 4494, "verse_number": "२३", "content_sanskrit": "गतसत्त्वा महीं प्राप्ताः प्रमृष्टा दीर्घबाहुना \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2161684, "chapter_id": 4494, "verse_number": "२४", "content_sanskrit": "नानाविधानि सैन्यानि तव हत्वा तु सात्वतः ।\nप्रविष्टस्तावकं सैन्यं द्रावयित्वा चमूं तव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2161685, "chapter_id": 4494, "verse_number": "२५", "content_sanskrit": "ततस्तेनैव मार्गेण येन यातो धनञ्जयः ।\nइयेष सात्यकिर्गन्तुं ततो द्रोणेन वारितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2161686, "chapter_id": 4494, "verse_number": "२६", "content_sanskrit": "भारद्वाजं समासाद्य युयुधानस्तु मारिष ।\nनात्यवर्तत सङ्क्रुद्धो वेलामिव जलाशयः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2161687, "chapter_id": 4494, "verse_number": "२७", "content_sanskrit": "निगृह्य तु रणे द्रोणो युयुधानं महारथम् ।\nविव्याध निशितैर्बाणैः पञ्चभिर्मर्मभेदिभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2161688, "chapter_id": 4494, "verse_number": "२८", "content_sanskrit": "सात्यकिस्तु रणे द्रोणं राजन् विव्याध सप्तभिः ।\nहेमपुङ्खैः शिलाधौतैः कङ्कबर्हिणवाजितैः\nतं षड्भिः सायकैर्द्रोणः साश्वयन्तारमार्दयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2161689, "chapter_id": 4494, "verse_number": "२९", "content_sanskrit": "स तं न ममृषे द्रोणं युयुधानो महारथः ।\nसिंहनादं ततः कृत्वा द्रोणं विव्याध सात्यकिः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2161690, "chapter_id": 4494, "verse_number": "३०", "content_sanskrit": "दशभिः सायकैश्चान्यैः षड्भिरष्टाभिरेव च ।\nयुयुधानः पुनर्द्रोणं विव्याध दशभिः शरैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2161691, "chapter_id": 4494, "verse_number": "३१", "content_sanskrit": "एकेन सारथिं चास्य चतुर्भिश्चतुरो हयान् ।\nध्वजमेकेन बाणेन युधि विव्याध मारिष\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2161692, "chapter_id": 4494, "verse_number": "३२", "content_sanskrit": "तं द्रोणः साश्वयन्तारं सरथध्वजमाशुगैः ।\nत्वरन् प्रच्छादयद् बाणैः शलभानामिव व्रजैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2161693, "chapter_id": 4494, "verse_number": "३३", "content_sanskrit": "तथैव युयुधानोऽपि द्रोणं बहुभिराशुगैः ।\nप्राच्छादयदसम्भ्रान्तः त्वरमाणो महारथः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2161694, "chapter_id": 4494, "verse_number": "३४", "content_sanskrit": "द्रोणस्तु परमक्रुद्धः सात्यकिं परवीरहा ।\nअवाकिरच्छितैर्बाणैर्वासुदेवपराक्रमम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2161695, "chapter_id": 4494, "verse_number": "३५", "content_sanskrit": "तं तथा शरजालेन प्रच्छाद्य महता पुनः ।\nद्रोणः प्रहस्य शैनेयमिदं वचनमब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2161696, "chapter_id": 4494, "verse_number": "३६", "content_sanskrit": "तवाचार्यो रणं हित्वा यातः कापुरुषो यथा ।\nयोधयन्तं हि हित्वाऽसौ मां प्रदक्षिणतो बली\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2161697, "chapter_id": 4494, "verse_number": "३७", "content_sanskrit": "त्वं न मे युद्ध्यमानस्य जीवन् सात्यक मोक्ष्यसे ।\nयदि मां त्वं रणे हित्वा न यास्याचार्यवद् द्रुतम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2161698, "chapter_id": 4494, "verse_number": "", "content_sanskrit": "सात्यकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2161699, "chapter_id": 4494, "verse_number": "३९", "content_sanskrit": "धनञ्जयस्य पदवीं धर्मराजस्य शासनात् ।\nगच्छामि स्वस्ति ते ब्रह्मन् न मे कालात्ययो भवेत्।३८।\nआचार्यानुगतो मार्गः शिष्यैरन्वास्यते सदा ।\nतस्मादेव व्रजाम्याशु यथा मे स गुरुर्गतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2161700, "chapter_id": 4494, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2161701, "chapter_id": 4494, "verse_number": "४०", "content_sanskrit": "एवमुक्त्वा तु शैनेय आचार्यं परिवर्जयन् ।\nप्रयातः सहसा राजन् सारथिं चेदमब्रवीत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2161702, "chapter_id": 4494, "verse_number": "४१", "content_sanskrit": "द्रोणः करिष्यते यत्नं सर्वथा मम वारणे ।\nयत्तो याहि रणे सूत शृणु चेदं वचोऽपरम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2161703, "chapter_id": 4494, "verse_number": "४२", "content_sanskrit": "एतदालोक्यते सैन्यमावन्त्यानां महाप्रभम् ।\nअभेद्यमरिभिर्वीरैः सुमहद्भिर्महद् बलम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2161704, "chapter_id": 4494, "verse_number": "४३", "content_sanskrit": "अस्यानन्तरतश्चैतद् बाह्लीकानां महद् बलम् ।\nतदनन्तरमेवैतद् दाक्षिणात्यं महद् बलम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2161705, "chapter_id": 4494, "verse_number": "४४", "content_sanskrit": "बाह्लिकाभ्याशसंयुक्तं कर्णस्यापि महद् बलम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2161706, "chapter_id": 4494, "verse_number": "४५", "content_sanskrit": "अन्योन्येन च सैन्यानि भिन्नान्येतानि सारथे ।\nअन्योन्यं समुपाश्रित्य न त्यक्ष्यन्ति रणाजिरम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2161707, "chapter_id": 4494, "verse_number": "४६", "content_sanskrit": "एतदन्तरमासाद्य चोदयाश्वान् प्रहृष्टवत् ।\nमध्यमं जवमास्थाय वह मामत्र सारथे\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2161708, "chapter_id": 4494, "verse_number": "४७", "content_sanskrit": "बाह्लिका यत्र दृश्यन्ते नानाप्रहरणोद्यताः ।\nदाक्षिणात्याश्च बहुशः सूतपुत्रपुरोगमाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2161709, "chapter_id": 4494, "verse_number": "४८", "content_sanskrit": "हस्त्यश्वरथसम्बाधं यत्रानीकं विलोक्यते ।\nनानादेशसमुत्थैश्च पदातिभिरधिष्ठितम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2161710, "chapter_id": 4494, "verse_number": "४९", "content_sanskrit": "ततः शक्यो महाव्यूहो भेत्तुं स्म सहसा रणे ।\nतं देशं त्वरिता यामो मृद्नन्तो युधि शात्रवान्\nतत्रैते सम्प्रहृष्टत्वान्नास्मान् प्रति युयुत्सवः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2161711, "chapter_id": 4494, "verse_number": "५०", "content_sanskrit": "अयुद्ध्यमानो बहुभिरेकं प्राप्य सुदुर्बलम् ।\nबलं प्रमथ्य गच्छामि मिषतां सर्वधन्विनाम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2161712, "chapter_id": 4494, "verse_number": "५१", "content_sanskrit": "सव्यतो याहि यत्रोग्रं कर्णस्य सुमहद् बलम् ।\nयत्रैते परमक्रुद्धा दाक्षिणात्या महारथाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2161713, "chapter_id": 4494, "verse_number": "५२", "content_sanskrit": "एतान् विजित्य सङ्ग्रामे ततो यामो धनञ्जयम्॥ ५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2161714, "chapter_id": 4494, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2161715, "chapter_id": 4494, "verse_number": "५३", "content_sanskrit": "युयुधानवचः श्रुत्वा युयुधानस्य सारथिः ।\nयथोक्तमगमद् राजन् वर्जयन् द्रोणमाहवे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2161716, "chapter_id": 4494, "verse_number": "५४", "content_sanskrit": "तं द्रोणोऽनुययौ क्रुद्धो विकिरन्निशितान् शरान् ।\nयुयुधानं महाबाहुं गच्छन्तमनिवर्तिनम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2161717, "chapter_id": 4494, "verse_number": "५५", "content_sanskrit": "स च सैन्यं महद् भित्त्वा दाक्षिणात्यबलं च तत् ।\nकर्णस्य सैन्यं सुमहन्निहत्य च शितैः शरैः\nप्राविशद् भारतीं सेनामपर्यन्तां स सात्यकिः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2161718, "chapter_id": 4494, "verse_number": "५६", "content_sanskrit": "सात्यको हि ततः सैन्यं द्रावयन् स समन्ततः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2161719, "chapter_id": 4494, "verse_number": "५७", "content_sanskrit": "विद्रुते तु बले तस्मिन् भग्ने भारत भारते ।\nअमर्षी कृतवर्मा तु सात्यकिं पर्यवारयत्\t॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2161720, "chapter_id": 4494, "verse_number": "५८", "content_sanskrit": "तमापतन्तं विशिखैः षड्भिराहत्य सात्यकिः ।\nचतुर्भिश्चतुरोऽस्याश्वानाजघानाशु वीर्यवान्\t॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2161721, "chapter_id": 4494, "verse_number": "५९", "content_sanskrit": "ततः पुनः षोडशभिर्नतपर्वभिराशुगैः ।\nसात्यकिः कृतवर्माणं प्रत्यविद्ध्यत् स्तनान्तरे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2161722, "chapter_id": 4494, "verse_number": "६०", "content_sanskrit": "स तुद्यमानो विशिखैर्बहुभिस्तिग्मतेजनैः ।\nसात्वतेन महाराज कृतवर्मा न चक्षमे\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2161723, "chapter_id": 4494, "verse_number": "६१", "content_sanskrit": "स वत्सदन्तं सन्धाय जिह्मगानलसन्निभम् ।\nआकृष्य राजन्नाकर्णं विव्याधोरसि सात्यकिम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2161724, "chapter_id": 4494, "verse_number": "६२", "content_sanskrit": "स तस्य देहावरणं भित्त्वा देहं च सायकः ।\nसपत्रपुङ्खः पृथिवीं विवेश रुधिरोक्षितः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2161725, "chapter_id": 4494, "verse_number": "६३", "content_sanskrit": "अथास्य बहुभिर्बाणैराच्छिनत् परमास्त्रवित् ।\nसमार्गणगुणं चापं कृतवर्मा महारथः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2161726, "chapter_id": 4494, "verse_number": "६४", "content_sanskrit": "विव्याध च रणे राजन् सात्यकिं सत्यविक्रमम् ।\nदशभिर्विशिखैश्चापि सुशितैस्तं स्तनान्तरे\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2161727, "chapter_id": 4494, "verse_number": "६५", "content_sanskrit": "ततः प्रशीर्णे धनुषि शक्त्या शक्तिमतां वरः ।\nअभ्यघ्नद् दक्षिणं बाहुं सात्यकिः कृतवर्मणः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2161728, "chapter_id": 4494, "verse_number": "६६", "content_sanskrit": "ततोऽन्यत् सुदृढं वीरो धनुरादाय सात्यकिः ।\nव्यसृजद् विशिखांस्तूर्णं शतशोऽथ सहस्रशः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2161729, "chapter_id": 4494, "verse_number": "६७", "content_sanskrit": "सरथं कृतवर्माणं समन्तात् पर्यवाकिरत् ।\nते शराः सात्वतेनास्ताः कृतवर्माणमाहवे ।\nछादयाञ्चक्रिरे वृक्षं शलभा इव घोषिणः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2161730, "chapter_id": 4494, "verse_number": "६८", "content_sanskrit": "छादयित्वा रणे राजन् हार्दिक्यं तु स सात्यकिः ।\nअथास्य भल्लेन शिरः सारथेः समकृन्तत\t॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2161731, "chapter_id": 4494, "verse_number": "६९", "content_sanskrit": "स पपात हतः सूतो हार्दिक्यस्य महारथात् ।\nततस्ते यन्तरि हते प्राद्रवंस्तुरगा भृशम् \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2161732, "chapter_id": 4494, "verse_number": "७०", "content_sanskrit": "अथ भोजस्त्वसम्भ्रान्तो निगृह्य तुरगान् स्वयम् ।\nतस्थौ शरधनुष्पाणिस्तत् सैन्यं प्रत्यपूजयत्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2161733, "chapter_id": 4494, "verse_number": "७१", "content_sanskrit": "स मुहूर्तमिवाश्वस्य सदश्वानभ्यचोदयत् ।\nव्यपेतभीरमित्राणामादधत् सुमहद् भयम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2161734, "chapter_id": 4494, "verse_number": "७२", "content_sanskrit": "सात्यकिं नाभ्ययात् तस्मात् स तु भीममुपाद्रवत् ।\nयुयुधानोऽपि राजेन्द्र भोजानीकमतिक्रमन्\nप्रययौ त्वरितस्तूर्णं काम्बोजानां महाचमूम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2161735, "chapter_id": 4494, "verse_number": "७३", "content_sanskrit": "स तत्र बहुभिः शूरैः सन्निरुद्धो महारथैः ।\nन चचाल महाराज सात्यकिः सत्यविक्रमः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2161736, "chapter_id": 4494, "verse_number": "७४", "content_sanskrit": "सन्धाय च चमूं द्रोणो भोजे भारं निवेश्य च ।\nअन्वधावद् रणे यत्तो युयुधानं युयुत्सया\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2161737, "chapter_id": 4494, "verse_number": "७५", "content_sanskrit": "तथा तमनुधावन्तं युयुधानस्य पृष्ठतः ।\nन्यवारयन्त सङ्क्रुद्धाः पाण्डुसैन्ये बृहत्तमाः\nसमासाद्य तु हार्दिक्यं रथिनां प्रवरं रथम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2161738, "chapter_id": 4494, "verse_number": "७६", "content_sanskrit": "पाञ्चाला विगतोत्साहा भीमसेनपुरोगमाः ।\nविक्रम्य वारिता राजन् वीरेण कृतवर्मणा\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2161739, "chapter_id": 4494, "verse_number": "७७", "content_sanskrit": "यतमानांस्तु तान् सर्वान् द्विषतो गतचेतसः ।\nअभितस्तान् शरौघेण क्लान्तरूपानवारयत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2161740, "chapter_id": 4494, "verse_number": "७८", "content_sanskrit": "निगृहीतास्तु भोजेन भोजानीकेप्सवो रणे ।\nअतिष्ठन्नाहवे वीराः प्रार्थयन्तो महद् यशः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2161741, "chapter_id": 4494, "verse_number": "७९", "content_sanskrit": "हार्दिक्यं समरे यत्ता न शेकुः प्रतिवीक्षितुम् \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2161742, "chapter_id": 4494, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि एकोनशततमोऽध्यायः॥ ९९॥\nजयद्रथवधपर्वणि त्रयोविंशोऽध्यायः॥ २३॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]