[{"id": 7000618000, "chapter_id": 20618, "verse_number": "५-७७-१", "content_sanskrit": "पार्वत्युवाच ।\nविस्तरेण समाचक्ष्व नामार्थपदगौरवम् ।\nईश्वरस्य स्वरूपं च तत्स्थानानां विभूतयः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000618001, "chapter_id": 20618, "verse_number": "५-७७-२", "content_sanskrit": "तद्विष्णोः परमं धाम व्यूहभेदास्तथा हरेः ।\nनिर्वाणाख्याहि तत्त्वेन मम सर्वं सुरेश्वर॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000618002, "chapter_id": 20618, "verse_number": "५-७७-३", "content_sanskrit": "ईश्वर उवाच ।\nसारे वृंदावने कृष्णं गोपीकोटिभिरावृतम् ।\nतत्र गंगा पराशक्तिस्तत्स्थमानंदकाननम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000618003, "chapter_id": 20618, "verse_number": "५-७७-४", "content_sanskrit": "नाना सुकुसुमामोदसमीरसुरभीकृतम् ।\nकलिंदतनया दिव्यतरंगरागशीतलम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000618004, "chapter_id": 20618, "verse_number": "५-७७-५", "content_sanskrit": "सनकाद्यैर्भागवतैः संसृष्टं मुनिपुंगवैः ।\nआह्लादिमधुरारावैर्गोवृंदैरभिमंडितम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000618005, "chapter_id": 20618, "verse_number": "५-७७-६", "content_sanskrit": "रम्यस्रग्भूषणोपेतैर्नृत्यद्भिर्बालकैर्वृतम् ।\nतत्र श्रीमान्कल्पतरुर्जांबूनदपरिच्छदः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000618006, "chapter_id": 20618, "verse_number": "५-७७-७", "content_sanskrit": "नानारत्नप्रवालाढ्यो नानामणिफलोज्ज्वलः ।\nतस्य मूले रत्नवेदी रत्नदीधितिदीपिता॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000618007, "chapter_id": 20618, "verse_number": "५-७७-८", "content_sanskrit": "तत्र त्रयीमयं रत्नसिंहासनमनुत्तमम् ।\nतत्रासीनं जगन्नाथं त्रिगुणातीतमव्ययम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000618008, "chapter_id": 20618, "verse_number": "५-७७-९", "content_sanskrit": "कोटिचंद्रप्रतीकाशं कोटिभास्करभास्वरम् ।\nकोटिकंदर्पलावण्यं भासयन्तं दिशोदश॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000618009, "chapter_id": 20618, "verse_number": "५-७७-१०", "content_sanskrit": "त्रिनेत्रं द्विभुजं गौरं तप्तजांबूनदप्रभम् ।\nश्लिष्यमाणमंगनाभिः सदामानं च सर्वशः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000618010, "chapter_id": 20618, "verse_number": "५-७७-११", "content_sanskrit": "ब्रह्माद्यैः सनकाद्यैश्च ध्येयं भक्तवशीकृतम् ।\nसदाघूर्णितनेत्राभिर्नृत्यंतीभिर्महोत्सवैः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000618011, "chapter_id": 20618, "verse_number": "५-७७-१२", "content_sanskrit": "चुंबंतीभिर्हसंतीभिः श्लिष्यंतीभिर्मुहुर्मुहुः ।\nअवाप्तगोपीदेहाभिः श्रुतिभिः कोटिकोटिभिः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000618012, "chapter_id": 20618, "verse_number": "५-७७-१३", "content_sanskrit": "तत्पादांबुजमाध्वीकचित्ताभिः परितो वृतम् ।\nतासां तु मध्ये या देवी तप्तचामीकरप्रभा॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000618013, "chapter_id": 20618, "verse_number": "५-७७-१४", "content_sanskrit": "द्योतमाना दिशः सर्वाः कुर्वती विद्युदुज्ज्वलाः ।\nप्रधानं या भगवती यया सर्वमिदं ततम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000618014, "chapter_id": 20618, "verse_number": "५-७७-१५", "content_sanskrit": "सृष्टिस्थित्यंतरूपा या विद्या विद्यात्रयीपरा ।\nस्वरूपा शक्तिरुपा च मायारूपा च चिन्मयी॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000618015, "chapter_id": 20618, "verse_number": "५-७७-१६", "content_sanskrit": "ब्रह्मविष्णुशिवादीनां देहकारणकारणम् ।\nचराचरं जगत्सर्वं यन्मायापरिरंभितम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000618016, "chapter_id": 20618, "verse_number": "५-७७-१७", "content_sanskrit": "वृंदावनेश्वरी नाम्ना राधा धात्रानुकारणात् ।\nतामालिंग्य वसंतं तं मुदा वृंदावनेश्वरम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000618017, "chapter_id": 20618, "verse_number": "५-७७-१८", "content_sanskrit": "अन्योन्यचुंबनाश्लेष मदावेशविघूर्णितम् ।\nध्यायेदेवं कृष्णदेवं स च सिद्धिमवाप्नुयात्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000618018, "chapter_id": 20618, "verse_number": "५-७७-१९", "content_sanskrit": "मंत्रराजमिमं गुह्यं तस्य मंत्रं च मंत्रवित् ।\nयो जपेच्छृणुयाद्वापि स महात्मा सुदुर्ल्लभः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000618019, "chapter_id": 20618, "verse_number": "५-७७-२०", "content_sanskrit": "राधिंका चित्ररेखा च चंद्रा मदनसुंदरी ।\nश्रीप्रिया श्रीमधुमती शशिरेखा हरिप्रिया॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000618020, "chapter_id": 20618, "verse_number": "५-७७-२१", "content_sanskrit": "सुवर्णशोभा संमोहा प्रेमरोमांचराजिता ।\nवैवर्ण्यस्वेदसंयुक्ता भावासक्ता प्रियंवदा॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000618021, "chapter_id": 20618, "verse_number": "५-७७-२२", "content_sanskrit": "सुवर्णमालिनी शांता सुरासरसिका तथा ।\nसर्वस्त्री जीवना दीनवत्सला विमलाशया॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000618022, "chapter_id": 20618, "verse_number": "५-७७-२३", "content_sanskrit": "निपीतनामपीयूषा सा राधा परिकीर्तिता ।\nसुदीर्घस्मितसंयुक्ता तप्तचामीकरप्रभा॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000618023, "chapter_id": 20618, "verse_number": "५-७७-२४", "content_sanskrit": "मूर्च्छत्प्रेमनदी राधा वरणा लोचनांजना ।\nमायामात्सर्यसंयुक्ता दानसाम्राज्य जीवना॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000618024, "chapter_id": 20618, "verse_number": "५-७७-२५", "content_sanskrit": "सुरतोत्सव संग्रामा चित्ररेखा प्रकीर्तिता ।\nगौरांगी नातिदीर्घा च सदा वादनतत्परा॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000618025, "chapter_id": 20618, "verse_number": "५-७७-२६", "content_sanskrit": "दैन्यानुरागनटना मूर्च्छारोमांचविह्वला ।\nहरिदक्षिणपार्श्वस्था सर्वमंत्रप्रिया तथा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000618026, "chapter_id": 20618, "verse_number": "५-७७-२७", "content_sanskrit": "अनंगलोभमाधुर्या चंद्रा सा परिकीर्तिता ।\nसलीलमंथरगतिर्मंजुमुद्रित लोचना॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000618027, "chapter_id": 20618, "verse_number": "५-७७-२८", "content_sanskrit": "प्रेमधारोज्ज्वलाकीर्णा दलितांजन शोभना ।\nकृष्णानुरागरसिका रासध्वनिसमुत्सुका॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000618028, "chapter_id": 20618, "verse_number": "५-७७-२९", "content_sanskrit": "अहंकारसमायुक्ता मुखनिंदितचंद्रमाः ।\nमधुरालापचतुरा जितेंद्रियशिरोमणिः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000618029, "chapter_id": 20618, "verse_number": "५-७७-३०", "content_sanskrit": "सुंदरस्मितसंयुक्ता सा वै मदनसुंदरी ।\nविविक्तरासरसिका श्यामा श्याममनोहरा॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000618030, "chapter_id": 20618, "verse_number": "५-७७-३१", "content_sanskrit": "प्रेम्णा प्रेमकटाक्षेण हरेश्चित्तविमोहनी ।\nजितेंद्रिया जितक्रोधा सा प्रिया परिकीर्तिता॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000618031, "chapter_id": 20618, "verse_number": "५-७७-३२", "content_sanskrit": "सुतप्तस्वर्णगौरांगी लीलागमनसुंदरी ।\nस्मरोत्थ प्रेमरोमांच वैचित्रमधुराकृतिः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000618032, "chapter_id": 20618, "verse_number": "५-७७-३३", "content_sanskrit": "सुंदरस्मितसंयुक्त मुखनिंदितचंद्रमाः ।\nमधुरालापचतुरा जितेंद्रियशिरोमणिः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000618033, "chapter_id": 20618, "verse_number": "५-७७-३४", "content_sanskrit": "कीर्तिता सा मधुमती प्रेमसाधनतत्परा ।\nसंमोहज्वररोमांच प्रेमधारा समन्विता॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000618034, "chapter_id": 20618, "verse_number": "५-७७-३५", "content_sanskrit": "दानधूलिविनोदा च रासध्वनि महानटी ।\nशशिरेखा च विज्ञेया गोपालप्रेयसी सदा॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000618035, "chapter_id": 20618, "verse_number": "५-७७-३६", "content_sanskrit": "कृष्णात्मा सोत्तमा श्यामा मधुपिंगललोचना ।\nतत्पादप्रेमसंमोहात्क्वचित्पुलकचुंबिता॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000618036, "chapter_id": 20618, "verse_number": "५-७७-३७", "content_sanskrit": "शिवकुंडे शिवानंदा नंदिनी देहिकातटे ।\nरुक्मिणी द्वारवत्यां तु राधा वृंदावने वने॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000618037, "chapter_id": 20618, "verse_number": "५-७७-३८", "content_sanskrit": "देवकी मथुरायां तु जाता मे परमेश्वरी ।\nचंद्रकूटे तथा सीता विंध्ये विंध्यनिवासिनी॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000618038, "chapter_id": 20618, "verse_number": "५-७७-३९", "content_sanskrit": "वाराणस्यां विशालाक्षी विमला पुरुषोत्तमे ।\nवृंदावनाधिपत्यं च दत्तं तस्यै प्रसीदता॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000618039, "chapter_id": 20618, "verse_number": "५-७७-४०", "content_sanskrit": "कृष्णेनान्यत्र देवी तु राधा वृंदावने वने ।\nनित्यानंदतनुः शौरिर्योऽशरीरीति भाष्यते॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000618040, "chapter_id": 20618, "verse_number": "५-७७-४१", "content_sanskrit": "वाय्वग्निनाकभूमीनामंगाधिष्ठितदेवता ।\nनिरूप्यते ब्रह्मणोऽपि तथा गोविंदविग्रहः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000618041, "chapter_id": 20618, "verse_number": "५-७७-४२", "content_sanskrit": "सेंद्रियोऽपि यथा सूर्यस्तेजसा नोपलक्ष्यते ।\nतथा कांतियुतः कृष्णः कालं मोहयति ध्रुवम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000618042, "chapter_id": 20618, "verse_number": "५-७७-४३", "content_sanskrit": "न तस्य प्राकृती मूर्तिर्मेदोमांसास्थिसंभवा ।\nयोगी चैवेश्वरश्चान्यः सर्वात्मा नित्यविग्रहः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000618043, "chapter_id": 20618, "verse_number": "५-७७-४४", "content_sanskrit": "काठिन्यं देवयोगेन करकाघृतयोरिव ।\nकृष्णस्यामिततत्त्वस्य पादपृष्ठं न देवता॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000618044, "chapter_id": 20618, "verse_number": "५-७७-४५", "content_sanskrit": "वृंदावनरजोवृंदे तत्र स्युर्विष्णुकोटयः ।\nआनंदकिरणे वृंदव्याप्तविश्वकलानिधिः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000618045, "chapter_id": 20618, "verse_number": "५-७७-४६", "content_sanskrit": "गुणात्मतात्मनि यथा जीवास्तत्किरणांगकाः ।\nभुजद्वयवृतः कृष्णो न कदाचिच्चतुर्भुजः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000618046, "chapter_id": 20618, "verse_number": "५-७७-४७", "content_sanskrit": "गोप्यैकया वृतस्तत्र परिक्रीडति सर्वदा ।\nगोविंद एव पुरुषो ब्रह्माद्याः स्त्रिय एव च॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000618047, "chapter_id": 20618, "verse_number": "५-७७-४८", "content_sanskrit": "तत एव स्वभावोयंऽप्रकृतेर्भाव ईश्वरः ।\nपुरुषः प्रकृतिश्चाद्यौ राधावृंदावनेश्वरौ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000618048, "chapter_id": 20618, "verse_number": "५-७७-४९", "content_sanskrit": "प्रकृतेर्विकृतं सर्वं विना वृंदावनेश्वरम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000618049, "chapter_id": 20618, "verse_number": "५-७७-५०", "content_sanskrit": "समुद्भवेनैव समुद्भवेदिदं भेदं गतं तस्य विनाशतो हि ।\nस्वर्णस्य नाशो न हि विद्यते तथा मत्स्यादिनाशेऽपि न कृष्णविच्युतिः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000618050, "chapter_id": 20618, "verse_number": "५-७७-५१", "content_sanskrit": "त्रिगुणादिप्रपंचोऽयं वृंदावनविहारिणः ।\nऊर्म्मीवाब्धेस्तरंगस्य यथाब्धिर्नैव जायते॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000618051, "chapter_id": 20618, "verse_number": "५-७७-५२", "content_sanskrit": "न राधिका समा नारी न कृष्णसदृशः पुमान् ।\nवयः परं न कैशोरात्स्वभावः प्रकृतेः परः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000618052, "chapter_id": 20618, "verse_number": "५-७७-५३", "content_sanskrit": "ध्येयं कैशोरकं ध्येयं वनं वृंदावनं वनम् ।\nश्याममेव परं रूपमादिदेवं परो रसः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000618053, "chapter_id": 20618, "verse_number": "५-७७-५४", "content_sanskrit": "बाल्यं पंचमवर्षांतं पौगंडं दशमावधि ।\nअष्टपंचककैशोरं सीमा पंचदशावधि॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000618054, "chapter_id": 20618, "verse_number": "५-७७-५५", "content_sanskrit": "यौवनोद्भिन्नकैशोरं नवयौवनमुच्यते ।\nतद्वयस्तस्य सर्वस्वं प्रपंचमितरद्वयः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000618055, "chapter_id": 20618, "verse_number": "५-७७-५६", "content_sanskrit": "बाल्यपौगंडकैशोरं वयो वंदे मनोहरम् ।\nबालगोपालगोपालं स्मरगोपालरूपिणम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000618056, "chapter_id": 20618, "verse_number": "५-७७-५७", "content_sanskrit": "वंदे मदनगोपालं कैशोराकारमद्भुतम् ।\nयमाहुर्यौवनोद्भिन्न श्रीमन्मदनमोहनम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000618057, "chapter_id": 20618, "verse_number": "५-७७-५८", "content_sanskrit": "अखंडातुलपीयूष रसानंदमहार्णवम् ।\nजयति श्रीपतेर्गूढं वपुः कैशोररूपिणः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000618058, "chapter_id": 20618, "verse_number": "५-७७-५९", "content_sanskrit": "एकमप्यव्ययं पूर्वं बल्लवीवृंदमध्यगम् ।\nध्यानगम्यं प्रपश्यंति रुचिभेदात्पृथग्धियः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000618059, "chapter_id": 20618, "verse_number": "५-७७-६०", "content_sanskrit": "यन्नखेंदुरुचिर्ब्रह्म ध्येयं ब्रह्मादिभिः सुरैः ।\nगुणत्रयमतीतं तं वंदे वृंदावनेश्वरम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000618060, "chapter_id": 20618, "verse_number": "५-७७-६१", "content_sanskrit": "वृंदावनपरित्यागो गोविंदस्य न विद्यते ।\nअन्यत्र यद्वपुस्तत्तु कृत्रिमं तन्न संशयः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000618061, "chapter_id": 20618, "verse_number": "५-७७-६२", "content_sanskrit": "सुलभं व्रजनारीणां दुर्ल्लभं तन्मुमुक्षुणाम् ।\nतं भजे नंदसूनुं यन्नखतेजः परं मनुः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000618062, "chapter_id": 20618, "verse_number": "५-७७-६३", "content_sanskrit": "पार्वत्युवाच ।\nभुक्तिमुक्तिस्पृहा यावत्पिशाची हृदि वर्त्तते ।\nतावत्प्रेमसुखस्यात्र कथमभ्युदयो भवेत्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000618063, "chapter_id": 20618, "verse_number": "५-७७-६४", "content_sanskrit": "ईश्वर उवाच ।\nसाधुपृष्टं त्वया भद्रे यन्मे मनसि वर्त्तते ।\nतत्सर्वं कथयिष्यामि सावधाना निशामय॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000618064, "chapter_id": 20618, "verse_number": "५-७७-६५", "content_sanskrit": "स्मृत्वा गुणान्स्मरन्नाम गानं वा मनरंजनम् ।\nबोधयत्यात्मनात्मानं सततं प्रेम्णि लीयते॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]