[{"id": 7000609000, "chapter_id": 20609, "verse_number": "५-६८-१", "content_sanskrit": "शेष उवाच ।\nपरिस्वादन्क्रतौ तृप्तिं न प्राप सुरसंयुतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000609001, "chapter_id": 20609, "verse_number": "५-६८-२", "content_sanskrit": "नारायणो महादेवो ब्रह्मा तत्र चतुर्मुखः ।\nवरुणश्च कुबेरश्च तथान्ये लोकपालकाः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000609002, "chapter_id": 20609, "verse_number": "५-६८-३", "content_sanskrit": "तत्रास्वाद्य हविः स्निग्धं वसिष्ठेन परिष्कृतम् ।\nतत्र पुनर्हि विप्रेंद्राः क्षुधार्ताइव भोजनात्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000609003, "chapter_id": 20609, "verse_number": "५-६८-४", "content_sanskrit": "सर्वान्देवांश्च संतर्प्य हविषा करुणानिधिः ।\nवसिष्ठप्रेरितः सर्वमिति कर्तव्यमाचरत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000609004, "chapter_id": 20609, "verse_number": "५-६८-५", "content_sanskrit": "ब्राह्मणादानसंतुष्टा हविस्तुष्टाः सुरावराः ।\nतृप्ताः सर्वे स्वकं भागं गृहीत्वा स्वालयं ययुः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000609005, "chapter_id": 20609, "verse_number": "५-६८-६", "content_sanskrit": "ऋषिभ्यो होतृमुख्येभ्यः प्रादाद्राज्यं चतुर्दिशम् ।\nसंतुष्टास्ते द्विजाराममाशीर्भिरददुः शुभम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000609006, "chapter_id": 20609, "verse_number": "५-६८-७", "content_sanskrit": "पूर्णाहुतिं ततः कृत्वा वसिष्ठः प्राह सुस्त्रियः ।\nवर्धापयंतु भूमीशं यागपूर्तिकरं परम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000609007, "chapter_id": 20609, "verse_number": "५-६८-८", "content_sanskrit": "तद्वाक्यं ताः स्त्रियः श्रुत्वा लाजैरवाकिरन्मुदा ।\nलावण्यजितकंदर्पं महामणिविभूषितम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000609008, "chapter_id": 20609, "verse_number": "५-६८-९", "content_sanskrit": "ततोऽवभृथस्नानार्थं प्रेरयामास भूमिपम् ।\nययौ रामः सहस्वीयैः सरयूतीरमुत्तमम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000609009, "chapter_id": 20609, "verse_number": "५-६८-१०", "content_sanskrit": "अनेकराजकोटीभिः परीतः पादचारिभिः ।\nजगाम स सरिच्छ्रेष्ठां पक्षिवृंदसमाकुलाम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000609010, "chapter_id": 20609, "verse_number": "५-६८-११", "content_sanskrit": "तारापतिरिव स्वाभिर्भार्याभिर्वृत उत्प्रभः ।\nविरोचते तथा तद्वद्रामो राजगणैर्वृतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000609011, "chapter_id": 20609, "verse_number": "५-६८-१२", "content_sanskrit": "तदुत्सवं समाज्ञाय ययुर्लोकास्त्वरायुताः ।\nसीतापतिमुखालोकनिश्चलीभूतलोचनाः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000609012, "chapter_id": 20609, "verse_number": "५-६८-१३", "content_sanskrit": "राजेंद्रं सीतया साकं गच्छंतं सरितं प्रति ।\nविलोक्य मुदिता लोकाश्चिरं दर्शनलालसाः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000609013, "chapter_id": 20609, "verse_number": "५-६८-१४", "content_sanskrit": "अनेक नटगंधर्वा गायंतो यश उज्ज्वलम् ।\nअनुजग्मुर्महीशानं सर्वलोकनमस्कृतम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000609014, "chapter_id": 20609, "verse_number": "५-६८-१५", "content_sanskrit": "नर्तक्यस्तत्र नृत्यंत्यः क्षोभयंत्यः पतेर्मनः ।\nजलयंत्रैश्च सिंचंत्यो ययुः श्रीरामसेवनम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000609015, "chapter_id": 20609, "verse_number": "५-६८-१६", "content_sanskrit": "महाराजं विलिपंत्यो हरिद्रा कुंकुमादिभिः ।\nपरस्परं प्रलिपंत्यो मुदं प्रापुर्महत्तराम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000609016, "chapter_id": 20609, "verse_number": "५-६८-१७", "content_sanskrit": "कुचयुग्मोपरिन्यस्तमुक्ताहारसुशोभिताः ।\nश्रवणद्वंद्वसंमृष्टस्वर्णकुंडललक्षिताः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000609017, "chapter_id": 20609, "verse_number": "५-६८-१८", "content_sanskrit": "अनेकनरनारीभिः संकीर्णं मार्गमाचरन् ।\nयथावत्सरितं प्राप शिवपुण्यजलाप्लुताम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000609018, "chapter_id": 20609, "verse_number": "५-६८-१९", "content_sanskrit": "तत्र गत्वा स वैदेह्या रामः कमललोचनः ।\nप्रविवेश जलं पुण्यं वसिष्ठादिभिरन्वितः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000609019, "chapter_id": 20609, "verse_number": "५-६८-२०", "content_sanskrit": "अनुप्रविविशुः सर्वे राजानो जनतास्तथा ।\nतत्पादरजसा पूतजलं लोकैकवंदितम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000609020, "chapter_id": 20609, "verse_number": "५-६८-२१", "content_sanskrit": "परस्परं प्रसिंचंतो जलयंत्रैर्मनोरमैः ।\nसुशोणनयनाः सर्वे हर्षं प्रापुर्मनोधिकम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000609021, "chapter_id": 20609, "verse_number": "५-६८-२२", "content_sanskrit": "स रामः सीतया सार्धं चिरं पुण्यजलप्लवे ।\nक्रीडित्वा जलकल्लोलैर्निरगाद्धर्मसंयुतः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000609022, "chapter_id": 20609, "verse_number": "५-६८-२३", "content_sanskrit": "दुकूलवासाः सकिरीटकुंडलः केयूरशोभावरकंकणान्वितः ।\nकंदर्पकोटिश्रियमुद्वहन्नृपो राजाग्र्यवर्यैरुपसंस्तुतो बभौ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000609023, "chapter_id": 20609, "verse_number": "५-६८-२४", "content_sanskrit": "सयागयूपं वरवर्णशोभितं कृत्वा सरित्तीरवरे महामनाः ।\nत्रैलोक्यलोकश्रियमाप ह्यद्भुतामन्यैर्दुरापां नृपतिर्भुजैर्निजैः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000609024, "chapter_id": 20609, "verse_number": "५-६८-२५", "content_sanskrit": "एवं जनकपुत्र्यासौ हयमेधत्रयं चरन् ।\nत्रैलोक्ये कीर्तिमतुलां प्राप देवैः सुदुर्लभाम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000609025, "chapter_id": 20609, "verse_number": "५-६८-२६", "content_sanskrit": "एवं ते वर्णितं तात यत्पृष्टो रामसत्कथाम् ।\nविस्तृतः कथितो मेधो भूयः किं पृच्छसे द्विज॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000609026, "chapter_id": 20609, "verse_number": "५-६८-२७", "content_sanskrit": "यः शृणोति हरेर्भक्त्या रामचंद्रस्य सन्मखम् ।\nब्रह्महत्यां क्षणात्तीर्त्वा ब्रह्मशाश्वतमाप्नुयात्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000609027, "chapter_id": 20609, "verse_number": "५-६८-२८", "content_sanskrit": "अपुत्रो लभते पुत्रान्निर्धनो धनमाप्नुयात् ।\nरोगार्तो मुच्यते रोगाद्बद्धो मुच्येत बंधनात्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000609028, "chapter_id": 20609, "verse_number": "५-६८-२९", "content_sanskrit": "यत्कथाश्रवणाद्दुष्टः श्वपचोऽपि परं पदम् ।\nप्राप्नोति किमु विप्राग्र्यो रामभक्तिपरायणः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000609029, "chapter_id": 20609, "verse_number": "५-६८-३०", "content_sanskrit": "रामं स्मृत्वा महाभागं पापिनः परमं पदम् ।\nप्राप्नुयुः परमं स्वर्गं शक्रदेवादिदुर्लभम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000609030, "chapter_id": 20609, "verse_number": "५-६८-३१", "content_sanskrit": "ते धन्या मानवा लोके ये स्मरंति रघूत्तमम् ।\nते क्षणात्संसृतिं तीर्त्वा गच्छंति सुखमव्ययम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000609031, "chapter_id": 20609, "verse_number": "५-६८-३२", "content_sanskrit": "प्रत्येकमक्षरं ब्रह्महत्यावंशदवानलः ।\nतं यः श्रावयते धीमांस्तं गुरुं संप्रपूजयेत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000609032, "chapter_id": 20609, "verse_number": "५-६८-३३", "content_sanskrit": "श्रुत्वा कथां वाचकाय गवां द्वंद्वं प्रदापयेत् ।\nसपत्नीकाय संपूज्य वस्त्रालंकारभोजनैः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000609033, "chapter_id": 20609, "verse_number": "५-६८-३४", "content_sanskrit": "कुंडलाभ्यां विराजंत्यौ मुद्रिकाभिरलंकृते ।\nरामसीते स्वर्णमय्यौ प्रतिमे शोभने वरे॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000609034, "chapter_id": 20609, "verse_number": "५-६८-३५", "content_sanskrit": "कृत्वा तु वाचकायैव दीयते भो द्विजोत्तम ।\nतस्य देवाश्च पितरो वैकुंठं प्राप्नुयुस्तदा॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000609035, "chapter_id": 20609, "verse_number": "५-६८-३६", "content_sanskrit": "त्वया पृष्टा रामकथा मया ते कथिता पुरा ।\nकिमन्यत्कथ्यतां ब्रह्मन्पुरतस्तव धीमतः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000609036, "chapter_id": 20609, "verse_number": "५-६८-३७", "content_sanskrit": "शृण्वंति ये कथामेतां ब्रह्महत्यौघनाशिनीम् ।\nते यांति परमं स्थानं यच्च देवैः सुदुर्लभम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000609037, "chapter_id": 20609, "verse_number": "५-६८-३८", "content_sanskrit": "गोघ्नश्चापि सुतघ्नश्च सुरापो गुरुतल्पगः ।\nक्षणात्पूतो भवत्येव नात्र संशयितुं क्षमम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]