[{"id": 5000336000, "chapter_id": 9336, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे चतुःषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000336001, "chapter_id": 9336, "verse_number": "४-६४-१", "content_sanskrit": "आख्याता गृध्रराजेन समुत्प्लुत्य प्लवङ्गमाः।\nसंगताः प्रीतिसंयुक्ता विनेदुः सिंहविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000336002, "chapter_id": 9336, "verse_number": "४-६४-२", "content_sanskrit": "सम्पातेर्वचनं श्रुत्वा हरयो रावणक्षयम्।\nहृष्टाः सागरमाजग्मुः सीतादर्शनकांक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000336003, "chapter_id": 9336, "verse_number": "४-६४-३", "content_sanskrit": "अभिगम्य तु तं देशं ददृशुर्भीमविक्रमाः।\nकृत्स्नं लोकस्य महतः प्रतिबिम्बमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000336004, "chapter_id": 9336, "verse_number": "४-६४-४", "content_sanskrit": "दक्षिणस्य समुद्रस्य समासाद्योत्तरां दिशम्।\nसंनिवेशं ततश्चक्रुर्हरिवीरा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000336005, "chapter_id": 9336, "verse_number": "४-६४-५", "content_sanskrit": "प्रसुप्तमिव चान्यत्र क्रीडन्तमिव चान्यतः।\nक्वचित् पर्वतमात्रैश्च जलराशिभिरावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000336006, "chapter_id": 9336, "verse_number": "४-६४-६", "content_sanskrit": "संकुलं दानवेन्द्रैश्च पातालतलवासिभिः।\nरोमहर्षकरं दृष्ट्वा विषेदुः कपिकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000336007, "chapter_id": 9336, "verse_number": "४-६४-७", "content_sanskrit": "आकाशमिव दुष्पारं सागरं प्रेक्ष्य वानराः।\nविषेदुः सहिताः सर्वे कथं कार्यमिति ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000336008, "chapter_id": 9336, "verse_number": "४-६४-८", "content_sanskrit": "विषण्णां वाहिनीं दृष्ट्वा सागरस्य निरीक्षणात्।\nआश्वासयामास हरीन् भयार्तान् हरिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000336009, "chapter_id": 9336, "verse_number": "४-६४-९", "content_sanskrit": "न विषादे मनः कार्यं विषादो दोषवत्तरः।\nविषादो हन्ति पुरुषं बालं क्रुद्ध इवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000336010, "chapter_id": 9336, "verse_number": "४-६४-१०", "content_sanskrit": "यो विषादं प्रसहते विक्रमे समुपस्थिते।\nतेजसा तस्य हीनस्य पुरुषार्थो न सिद्ध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000336011, "chapter_id": 9336, "verse_number": "४-६४-११", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायामङ्गदो वानरैः सह।\nहरिवृद्धैः समागम्य पुनर्मन्त्रममन्त्रयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000336012, "chapter_id": 9336, "verse_number": "४-६४-१२", "content_sanskrit": "सा वानराणां ध्वजिनी परिवार्याङ्गदं बभौ।\nवासवं परिवार्येव मरुतां वाहिनी स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000336013, "chapter_id": 9336, "verse_number": "४-६४-१३", "content_sanskrit": "कोऽन्यस्तां वानरीं सेनां शक्तः स्तम्भयितुं भवेत् ।\nअन्यत्र वालितनयादन्यत्र च हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000336014, "chapter_id": 9336, "verse_number": "४-६४-१४", "content_sanskrit": "ततस्तान् हरिवृद्धांश्च तच्च सैन्यमरिंदमः।\nअनुमान्याङ्गदः श्रीमान् वाक्यमर्थवदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000336015, "chapter_id": 9336, "verse_number": "४-६४-१५", "content_sanskrit": "क इदानीं महातेजा लङ्घयिष्यति सागरम्।\nकः करिष्यति सुग्रीवं सत्यसंधमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000336016, "chapter_id": 9336, "verse_number": "४-६४-१६", "content_sanskrit": "को वीरो योजनशतं लङ्घयेत प्लवङ्गमः।\nइमांश्च यूथपान् सर्वान् मोचयेत् को महाभयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000336017, "chapter_id": 9336, "verse_number": "४-६४-१७", "content_sanskrit": "कस्य प्रसादाद् दारांश्च पुत्रांश्चैव गृहाणि च।\nइतो निवृत्ताः पश्येम सिद्धार्थाः सुखिनो वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000336018, "chapter_id": 9336, "verse_number": "४-६४-१८", "content_sanskrit": "कस्य प्रसादाद् रामं च लक्ष्मणं च महाबलम्।\nअभिगच्छेम संहृष्टाः सुग्रीवं च वनौकसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000336019, "chapter_id": 9336, "verse_number": "४-६४-१९", "content_sanskrit": "यदि कश्चित् समर्थो वः सागरप्लवने हरिः।\nस ददात्विह नः शीघ्रं पुण्यामभयदक्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000336020, "chapter_id": 9336, "verse_number": "४-६४-२०", "content_sanskrit": "अङ्गदस्य वचः श्रुत्वा न कश्चित् किंचिदब्रवीत्।\nस्तिमितेवाभवत् सर्वा सा तत्र हरिवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000336021, "chapter_id": 9336, "verse_number": "४-६४-२१", "content_sanskrit": "पुनरेवाङ्गदः प्राह तान् हरीन् हरिसत्तमः।\nसर्वे बलवतां श्रेष्ठा भवन्तो दृढविक्रमाः।\nव्यपदेशकुले जाताः पूजिताश्चाप्यभीक्ष्णशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000336022, "chapter_id": 9336, "verse_number": "४-६४-२२", "content_sanskrit": "नहि वो गमने भङ्गः कदाचित् कस्यचिद् भवेत्।\nब्रुवध्वं यस्य या शक्तिः प्लवने प्लवगर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000336023, "chapter_id": 9336, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चतुःषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]