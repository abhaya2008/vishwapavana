[{"id": 40020521, "chapter_id": 9336, "verse_number": "1", "content_sanskrit": "अथ राजन्महाबाहुर्विचरन्स महीतले । हिमवद्वनमासाद्य परिचक्राम रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020522, "chapter_id": 9336, "verse_number": "2", "content_sanskrit": "तत्रापश्यत्स वै कन्यां कृष्णाजिनजटाधराम् । आर्षेण विधिना युक्तां दीप्यन्तीं देवतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020523, "chapter_id": 9336, "verse_number": "3", "content_sanskrit": "स दृष्ट्वा रूपसम्पन्नां कन्यां तां सुमहाव्रताम् । काममोहपरीतात्मा पप्रच्छ प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020524, "chapter_id": 9336, "verse_number": "4", "content_sanskrit": "किमिदं वर्तसे भद्रे विरुद्धं यौवनस्य ते । नहि युक्ता तवैतस्य रूपस्यैव प्रतिक्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020525, "chapter_id": 9336, "verse_number": "5", "content_sanskrit": "रूपं ते ऽनुपमं भीरु कामोन्मादकरं नृणाम् । न युक्तं तपसि स्थातुं निर्गतो ह्येष निर्णयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020526, "chapter_id": 9336, "verse_number": "6", "content_sanskrit": "कस्यासि किमिदं भद्रे कश्च भर्ता वरानने । येन सम्भुज्यसे भीरु स नरः पुण्यभाग्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020527, "chapter_id": 9336, "verse_number": "7", "content_sanskrit": "पृच्छतः शंस मे सर्वं कस्य हेतोः परिश्रमः । एवमुक्ता तु सा कन्या रावणेन यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020528, "chapter_id": 9336, "verse_number": "8", "content_sanskrit": "कुशध्वजो मम पिता ब्रह्मर्षिरमितप्रभः । बृहस्पतिसुतः श्रीमान्बुद्ध्या तुल्यो बृहस्पतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020529, "chapter_id": 9336, "verse_number": "9", "content_sanskrit": "तस्याहं कुर्वतो नित्यं वेदाभ्यासं महात्मनः । सम्भूय वाङ्मयी कन्या नाम्ना वेदवती स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020530, "chapter_id": 9336, "verse_number": "10", "content_sanskrit": "ततो देवाः सगन्धर्वा यक्षराक्षसपन्नगाः । ते ऽपि गत्वा हि पितरं वरणं रोचयन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020531, "chapter_id": 9336, "verse_number": "11", "content_sanskrit": "न च मां स पिता तेभ्यो दत्तवान्राक्षसर्षभ । कारणं तद्वदिष्यामि निशाचर निशामय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020532, "chapter_id": 9336, "verse_number": "12", "content_sanskrit": "पितुस्तु मम जामाता विष्णुः किल सुरेश्वरः । अभिप्रेतस्त्रिलोकेशस्तस्मान्नान्यस्य मे पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020533, "chapter_id": 9336, "verse_number": "13", "content_sanskrit": "दातुमिच्छति तस्मै तु तच्छ्रुत्वा बलदर्पितः । दम्भुर्नाम ततो राजा दैत्यानां कुपितो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020534, "chapter_id": 9336, "verse_number": "14", "content_sanskrit": "तेन रात्रौ शयानो मे पिता पापेन हिंसितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020535, "chapter_id": 9336, "verse_number": "15", "content_sanskrit": "ततो मे जननी दीना तच्छरीरं पितुर्मम । परिष्वज्य महाभागा प्रविष्टा हव्यवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020536, "chapter_id": 9336, "verse_number": "16", "content_sanskrit": "ततो मनोरथं सत्यं पितुर्नारायणं प्रति । करोमीति तमेवाहं हृदयेन समुद्वहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020537, "chapter_id": 9336, "verse_number": "17", "content_sanskrit": "इति प्रतिज्ञामारुह्य चरामि विपुलं तपः । एतत्ते सर्वमाख्यातं मया राक्षसपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020538, "chapter_id": 9336, "verse_number": "18", "content_sanskrit": "नारायणो मम पतिर्न त्वन्यः पुरुषोत्तमात् । आश्रये नियमं घोरं नारायणपरीप्सया । विज्ञातस्त्वं हि मे राजन्गच्छ पौलस्त्यनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020539, "chapter_id": 9336, "verse_number": "19", "content_sanskrit": "जानामि तपसा सर्वं त्रैलोक्ये यद्धि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020540, "chapter_id": 9336, "verse_number": "20", "content_sanskrit": "सो ऽब्रवीद्रावणो भूयस्तां कन्यां सुमहाव्रताम् । अवरुह्य विमानाग्रात्कन्दर्पशरपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020541, "chapter_id": 9336, "verse_number": "21", "content_sanskrit": "अवलिप्ता ऽसि सुश्रोणि यस्यास्ते मतिरीदृशी । वृद्धानां मृगशावाक्षि भ्राजते पुण्यसञ्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020542, "chapter_id": 9336, "verse_number": "22", "content_sanskrit": "त्वं सर्वंगुणसम्पन्ना नार्हसे वक्तुमीदृशम् । त्रैलोक्यसुन्दरी भीरु यौवनं ते निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020543, "chapter_id": 9336, "verse_number": "23", "content_sanskrit": "अहं लङ्कापतिर्भद्रे दशग्रीव इति श्रुतः । तस्य मे भव भार्या त्वं भुङ्क्ष्व भोगान्यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020544, "chapter_id": 9336, "verse_number": "24", "content_sanskrit": "कश्च तावदसौ यं त्वं विष्णुरित्यभिभाषसे । वीर्येण तपसा चैव भोगेन च बलेन च ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020545, "chapter_id": 9336, "verse_number": "25", "content_sanskrit": "न मया स समो भद्रे यं त्वं कामयसे ऽङ्गने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020546, "chapter_id": 9336, "verse_number": "26", "content_sanskrit": "इत्युक्तवति तस्मिंस्तु वेदवत्यथ सा ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020547, "chapter_id": 9336, "verse_number": "27", "content_sanskrit": "वै भोगेन च बलेन च ।। मा मैवमिति सा कन्या तमुवाच निशाचरम् । त्रैलोक्याधिपति विष्णुं सर्वलोकनमस्कृतम् । त्वदृते राक्षसेन्द्रान्यः को ऽवमन्येत बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020548, "chapter_id": 9336, "verse_number": "28", "content_sanskrit": "एवमुक्तस्तया तत्र वेदवत्या निशाचरः । मूर्धजेषु तदा कन्यां कराग्रेण परामृशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020549, "chapter_id": 9336, "verse_number": "29", "content_sanskrit": "ततो वेदवती क्रुद्धा केशान्हस्तेन सा ऽच्छिनत् । असिर्भूत्वा करस्तस्याः केशांश्छिन्नांस्तदा ऽकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020550, "chapter_id": 9336, "verse_number": "30", "content_sanskrit": "सा ज्वलन्तीव रोषेण दहन्तीव निशाचरम् । उवाचाग्निं समाधाय मरणाय कृतत्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020551, "chapter_id": 9336, "verse_number": "31", "content_sanskrit": "धर्षितायास्त्वयानार्य न मे जीवितमिष्यते । रक्षस्तस्मात्प्रवेक्ष्यामि पश्यतस्ते हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020552, "chapter_id": 9336, "verse_number": "32", "content_sanskrit": "यस्मात्तु धर्षिता चाहं त्वया पापात्मना वने । तस्मात्तव वधार्थं हि समुत्पत्स्ये ह्यहं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020553, "chapter_id": 9336, "verse_number": "33", "content_sanskrit": "न हि शक्यं स्त्रिया हन्तुं पुरुषः पापनिश्चः । शापे त्वयि मयोत्सृष्टे तपसश्च व्ययो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020554, "chapter_id": 9336, "verse_number": "34", "content_sanskrit": "यदि त्वस्ति मया किञ्चित्कृतं दत्तं हुतं तथा । तस्मात्त्वयोनिजा साध्वी भवेयं धर्मिणः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020555, "chapter_id": 9336, "verse_number": "35", "content_sanskrit": "एवमुक्त्वा प्रविष्टा सा ज्वलितं जातवेदसम् । पपात च दिवो दिव्या पुष्पवृष्टिः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020556, "chapter_id": 9336, "verse_number": "36", "content_sanskrit": "पुनरेव समुद्भूता पद्मे पद्मसमप्रभा । तस्मादपि पुनः प्राप्ता पूर्ववत्तेन रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020557, "chapter_id": 9336, "verse_number": "37", "content_sanskrit": "कन्यां कमलगर्भाभां प्रगृह्य स्वगृहं ययौ । प्रगृह्य रावणस्त्वेतां दर्शयामास मन्त्रिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020558, "chapter_id": 9336, "verse_number": "38", "content_sanskrit": "लक्षणज्ञो निरीक्ष्यैव रावणं चैवमब्रवीत् । गृहस्थैषां हि सुश्रोणी त्वद्वधायैव दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020559, "chapter_id": 9336, "verse_number": "39", "content_sanskrit": "एतच्छ्रुत्वा ऽर्णवे राम तां प्रचिक्षेप रावणः । सा चैव क्षितिमासाद्य यज्ञायतनमध्यगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020560, "chapter_id": 9336, "verse_number": "40", "content_sanskrit": "राज्ञो हलमुखोत्कृष्टा पुनरप्युत्थिता सती । सैषा जनकराजस्य प्रसूता तनया प्रभो । तव भार्या महाबाहो विष्णुस्त्वं हि सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020561, "chapter_id": 9336, "verse_number": "41", "content_sanskrit": "पूर्वं क्रोधाहितः शत्रुर्यया ऽसौ निहतस्तथा । उपाश्रयित्वा शैलभस्तव वीर्यममानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020562, "chapter_id": 9336, "verse_number": "42", "content_sanskrit": "एवमेषा महाभागा मर्त्येषूत्पत्स्यते पुनः । क्षेत्रे हलमुखोत्कृष्टे वेद्यामग्निशिखोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020563, "chapter_id": 9336, "verse_number": "43", "content_sanskrit": "एषा वेदवती नाम पूर्वमासीत्कृते युगे । त्रेतायुगमनुप्राप्य वधार्थं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020564, "chapter_id": 9336, "verse_number": "44", "content_sanskrit": "उत्पन्ना मैथिलकुले जनकस्य महात्मनः । सीतोत्पन्ना तु सीतेति मानुषैः पुनरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]