[{"id": 2083243, "chapter_id": 2774, "verse_number": "१२-२७९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083244, "chapter_id": 2774, "verse_number": "१२-२७९-१", "content_sanskrit": "कथं भवति पापात्मा कथं धर्मं करोति वा।\nकेन निर्वेदमादत्ते मोक्षं वा केन गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083245, "chapter_id": 2774, "verse_number": "१२-२७९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083246, "chapter_id": 2774, "verse_number": "१२-२७९-२", "content_sanskrit": "विदिताः सर्वधर्मास्ते स्थित्यर्थमनुपृच्छसि।\nशृणु मोक्षं सनिर्वेदं पापं धर्मं च मूलतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083247, "chapter_id": 2774, "verse_number": "१२-२७९-३", "content_sanskrit": "विज्ञानार्थं हि पञ्चानामिच्छापूर्वं प्रवर्तते।\nप्राप्यतां वर्तते कामो द्वेषो वा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083248, "chapter_id": 2774, "verse_number": "१२-२७९-४", "content_sanskrit": "ततस्तदर्थं यतते कर्म चारभते महत्।\nइष्टानां रूपगन्धानामभ्यासं च चिकीर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083249, "chapter_id": 2774, "verse_number": "१२-२७९-५", "content_sanskrit": "ततो रागः प्रभवति द्वेषश्च तदनन्तरम्।\nततो लोभः प्रभवति मोहश्च तदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083250, "chapter_id": 2774, "verse_number": "१२-२७९-६", "content_sanskrit": "लोभमोहाभिभूतस्य रागद्वेषान्वितस्य च।\nन धर्मे जायते बुद्धिर्व्याजाद्धर्मं करोति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083251, "chapter_id": 2774, "verse_number": "१२-२७९-७", "content_sanskrit": "व्याजेन चरते धर्ममर्थं व्याजेन रोचते।\nव्याजेन सिद्ध्यमानेषु धर्मेषु कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083252, "chapter_id": 2774, "verse_number": "१२-२७९-८", "content_sanskrit": "तत्रैव कुरुते बुद्धिं ततः पापं चिकीर्षति।\nसुहृद्भिर्वार्यमाणोऽपि पण़्डितैश्चापि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083253, "chapter_id": 2774, "verse_number": "१२-२७९-९", "content_sanskrit": "उत्तरं न्यायसंबद्धं ब्रवीति विधिचोदितम्।\nअधर्मस्त्रिविधस्तस्य वर्धते रागमोहजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083254, "chapter_id": 2774, "verse_number": "१२-२७९-१०", "content_sanskrit": "पापं चिन्तयते कर्म प्रब्रवीति करोति च।\nतस्याधर्मप्रवृत्तस्य दोषान्पश्यन्ति साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083255, "chapter_id": 2774, "verse_number": "१२-२७९-११", "content_sanskrit": "एकशीलाश्च मित्रत्वं भजन्ते पापकर्मिणः।\nस नेह सुखमाप्नोति कुत एव परत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083256, "chapter_id": 2774, "verse_number": "१२-२७९-१२", "content_sanskrit": "एवं भवति पापात्मा धर्मात्मानं तु मे शृणु।\nयथा कुशलधर्मा स कुशलं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083257, "chapter_id": 2774, "verse_number": "१२-२७९-१३", "content_sanskrit": "कुशलेनैव धर्मेण गतिमिष्टां प्रपद्यते।\nय एतान्प्रज्ञया दोषान्पूर्वमेवानुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083258, "chapter_id": 2774, "verse_number": "१२-२७९-१४", "content_sanskrit": "कुशलस्तु सुखार्थाय साधूंश्चाप्युपसेवते।\nतस्य साधुसमाचारादभ्यासाच्चैव वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083259, "chapter_id": 2774, "verse_number": "१२-२७९-१५", "content_sanskrit": "प्राज्ञो धर्मे च रमते धर्मं चैवोपजीवति।\nसोऽथ धर्मादवाप्तेषु धनेषु कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083260, "chapter_id": 2774, "verse_number": "१२-२७९-१६", "content_sanskrit": "तस्यैव सिञ्चते मूलं गुणान्पश्यति यत्र वै।\nधर्मात्मा भवति ह्येवं मित्रं च लभते शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083261, "chapter_id": 2774, "verse_number": "१२-२७९-१७", "content_sanskrit": "स मित्रधनलाभात्तु प्रेत्य चेह च नन्दति।\nशब्दे स्पर्शे रसे रूपे तथा गन्धे च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083262, "chapter_id": 2774, "verse_number": "१२-२७९-१८", "content_sanskrit": "प्रभुत्वं लभते जन्तुर्धर्मस्यैतत्फलं विदुः।\nस तु धर्मफलं लब्ध्वा न तृष्यति युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083263, "chapter_id": 2774, "verse_number": "१२-२७९-१९", "content_sanskrit": "धर्मे स्थितानां कौन्तेय सर्वभोगक्रियासु च।\nअतृप्यमाणो निर्वेदमादत्ते ज्ञानचक्षुषा।\nप्रज्ञाचक्षुर्यदा कामे दोषमेवानुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083264, "chapter_id": 2774, "verse_number": "१२-२७९-२०", "content_sanskrit": "शब्दे स्पर्शे तथा रूपे न च भावयते मनः।\nविमुच्यते तदा कामान्न च धर्मं विमुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083265, "chapter_id": 2774, "verse_number": "१२-२७९-२१", "content_sanskrit": "सर्वत्यागे च यतते दृष्ट्वा लोकं क्षयात्मकम्।\nततो मोक्षाय यतते नानुपायादुपायतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083266, "chapter_id": 2774, "verse_number": "१२-२७९-२२", "content_sanskrit": "शनैर्निर्वेदमादत्ते पापं कर्म जहाति च।\nधर्मात्मा चैव भवति मोक्षं च लभते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083267, "chapter_id": 2774, "verse_number": "१२-२७९-२३", "content_sanskrit": "एतत्ते कथितं तात यन्मां त्वं परिपृच्छसि।\nपापं धर्मस्तथा मोक्षो निर्वेदश्चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083268, "chapter_id": 2774, "verse_number": "१२-२७९-२४", "content_sanskrit": "तस्माद्धर्मे प्रवर्तेथाः सर्वावस्थं युधिष्ठिर।\nधर्मे स्थितानां कौन्तेय सिद्धिर्भवति शाश्वती॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083269, "chapter_id": 2774, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनाशीत्यधिकद्विशततमोऽध्यायः॥ २७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]