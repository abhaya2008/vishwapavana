[{"id": 7000384000, "chapter_id": 20384, "verse_number": "२-५६-१", "content_sanskrit": "विष्णुरुवाच ।\nतस्याः सत्यविनाशाय मन्मथः ससुराधिपः ।\nप्रस्थितः सुकलां तर्हि सत्यो धर्ममथाब्रवीत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000384001, "chapter_id": 20384, "verse_number": "२-५६-२", "content_sanskrit": "पश्य धर्म महाप्राज्ञ मन्मथस्य विचेष्टितम् ।\nतवार्थमात्मनश्चैव पुण्यस्यापि महात्मनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000384002, "chapter_id": 20384, "verse_number": "२-५६-३", "content_sanskrit": "विसृजामि महास्थानं वास्तुरूपं सुखोदयम् ।\nसत्याख्यं च सुप्रियाख्यं सुदेवाख्यं गृहोत्तमम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000384003, "chapter_id": 20384, "verse_number": "२-५६-४", "content_sanskrit": "तमेव नाशयेद्गत्वा काम एष प्रमत्तधीः ।\nरिपुरूपः सुदुष्टात्मा अस्माकं हि न संशयः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000384004, "chapter_id": 20384, "verse_number": "२-५६-५", "content_sanskrit": "पतिस्तपोधनो विप्रः सुसती या पतिव्रता ।\nसुसत्यो भूपतिर्धर्मममगेहानसंशयः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000384005, "chapter_id": 20384, "verse_number": "२-५६-६", "content_sanskrit": "यत्राहं वृद्धिसंपुष्टस्तत्र वासो हि ते भवेत् ।\nतत्र पुण्यं समायाति श्रद्धया सह क्रीडते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000384006, "chapter_id": 20384, "verse_number": "२-५६-७", "content_sanskrit": "क्षमा शांत्या समायुक्ता आयाति मम मंदिरम् ।\nयथा सत्यो दमश्चैव दया सौहृदमेव च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000384007, "chapter_id": 20384, "verse_number": "२-५६-८", "content_sanskrit": "प्रज्ञायुक्तः स निर्लोभो यत्राहं तत्र संस्थितः ।\nशुचिः स्वभावस्तत्रैव अमी च मम बांधवाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000384008, "chapter_id": 20384, "verse_number": "२-५६-९", "content_sanskrit": "अस्तेयमप्यहिंसा च तितिक्षा वृद्धिरेव च ।\nमम गेहे समायाता धन्यतां शृणु धर्मराट्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000384009, "chapter_id": 20384, "verse_number": "२-५६-१०", "content_sanskrit": "गुरूणां चापि शुश्रूषा विष्णुर्लक्ष्म्या समावृतः ।\nमद्गेहं तु समायांति देवाश्चाग्निपुरोगमाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000384010, "chapter_id": 20384, "verse_number": "२-५६-११", "content_sanskrit": "मोक्षमार्गं प्रकाशेद्यो ज्ञानोदीप्त्या समन्वितः ।\nएतैः सार्धं वसाम्येव सतीषु धर्मवत्सु च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000384011, "chapter_id": 20384, "verse_number": "२-५६-१२", "content_sanskrit": "साधुष्वेतेषु सर्वेषु गृहरूपेषु मे सदा ।\nउक्तेनापि कुटुंबेन वसाम्येव त्वया सह॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000384012, "chapter_id": 20384, "verse_number": "२-५६-१३", "content_sanskrit": "ससत्वाः साधुरूपास्ते वेधसा मे गृहीकृताः ।\nसंचरामि महाभाग स्वच्छंदेन च लीलया॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000384013, "chapter_id": 20384, "verse_number": "२-५६-१४", "content_sanskrit": "ईश्वरश्च जगत्स्वामी त्रिनेत्रो वृषवाहनः ।\nमम गेहे स्वरूपेण वर्तते शिवया युतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000384014, "chapter_id": 20384, "verse_number": "२-५६-१५", "content_sanskrit": "तदिदं संसृतेः सारं गृहरूपं महेश्वरम् ।\nसदनं शंकरेत्याख्यं नाशितं मन्मथेन वै॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000384015, "chapter_id": 20384, "verse_number": "२-५६-१६", "content_sanskrit": "विश्वामित्रं महात्मानं तपंतं तप उत्तमम् ।\nमेनकां हि समाश्रित्य कामोयं जितवान्पुरा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000384016, "chapter_id": 20384, "verse_number": "२-५६-१७", "content_sanskrit": "सती पतिव्रताहल्या गौतमस्य प्रिया शुभा ।\nसुसत्याच्चालिता तेन मन्मथेन दुरात्मना॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000384017, "chapter_id": 20384, "verse_number": "२-५६-१८", "content_sanskrit": "मुनयः सत्यधर्मज्ञा नानास्त्रियः पतिव्रताः ।\nमद्गृहास्ता इमाः सर्वा दीपिताः कामवह्निना॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000384018, "chapter_id": 20384, "verse_number": "२-५६-१९", "content_sanskrit": "दुर्धरो दुःसहो व्यापी योतिसत्येषु निष्ठुरः ।\nमामेवं पश्यते नित्यं क्व सत्यः परितिष्ठति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000384019, "chapter_id": 20384, "verse_number": "२-५६-२०", "content_sanskrit": "समां ज्ञात्वा समायाति बाणपाणिर्धनुर्धरः ।\nनाशयेन्मद्गृहं पापो वीतिहोत्रैश्च नामकैः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000384020, "chapter_id": 20384, "verse_number": "२-५६-२१", "content_sanskrit": "पापलेशाश्च ये क्रूरा अन्ये पाखंडसंश्रयाः ।\nते तु बुद्ध्याऽहिताः सर्वे सत्यगेहं विशंति हि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000384021, "chapter_id": 20384, "verse_number": "२-५६-२२", "content_sanskrit": "सेनाध्यक्षैरसत्यैस्तु छद्मना तेन साधितः ।\nपातयेदर्दयेद्गेहं पापः शस्त्रैर्दुरात्मभिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000384022, "chapter_id": 20384, "verse_number": "२-५६-२३", "content_sanskrit": "मामेवं ताडयेत्पापो महाबल मनोभवः ।\nअस्य धाम्ना प्रदग्धोहं शून्यतां हि व्रजामि वै॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000384023, "chapter_id": 20384, "verse_number": "२-५६-२४", "content_sanskrit": "नूतनं गृहमिच्छामि स्त्रियाख्यं पतिभूपतिम् ।\nकृकलस्यापि पुण्यस्य प्रियेयं शिवमंगला॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000384024, "chapter_id": 20384, "verse_number": "२-५६-२५", "content_sanskrit": "तद्गृहं सुकलाख्यं मे दग्धुं पापः समुद्यतः ।\nअयमेष सहस्राक्षः कामेन सहितो बली॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000384025, "chapter_id": 20384, "verse_number": "२-५६-२६", "content_sanskrit": "कामस्य कारणात्कस्मात्पूर्ववृत्तं न विंदति ।\nअहल्यायाः प्रसंगेन मेषोपस्थो व्यजायत॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000384026, "chapter_id": 20384, "verse_number": "२-५६-२७", "content_sanskrit": "पौरुषं हि मुनेर्दृष्ट्वा सत्याश्चैव प्रधषर्णात् ।\nनष्टः कामस्य दोषेण सुरराट्तत्र संस्थितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000384027, "chapter_id": 20384, "verse_number": "२-५६-२८", "content_sanskrit": "भुक्तवान्दारुणं शापं दुःखेन महतान्वितः ।\nकृकलस्य प्रियामेनां सुकलां पुण्यचारिणीम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000384028, "chapter_id": 20384, "verse_number": "२-५६-२९", "content_sanskrit": "एष हंतुं सहस्राक्ष उद्यतः कामसंयुतः ।\nयथा चेंद्रेण नायाति काम एष तथा कुरु॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000384029, "chapter_id": 20384, "verse_number": "२-५६-३०", "content_sanskrit": "धर्मराज महाप्राज्ञ भवान्मतिमतां वरः ।\nधर्मराज उवाच ।\nऊनं तेजः करिष्यामि कामस्य मरणं तथा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000384030, "chapter_id": 20384, "verse_number": "२-५६-३१", "content_sanskrit": "एकोपायो मया दृष्टस्तमिहैव प्रपश्यतु ।\nप्रज्ञा चैषा महाप्राज्ञा शकुनीरूपचारिणी॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000384031, "chapter_id": 20384, "verse_number": "२-५६-३२", "content_sanskrit": "भर्तुरागमनं पुण्यं शब्देनाख्यातु खे यतः ।\nशकुनस्य प्रभावेण भर्तुश्चागमनेन च॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000384032, "chapter_id": 20384, "verse_number": "२-५६-३३", "content_sanskrit": "दुष्टैर्नष्टा न भूयेत स्वस्थचित्ता न संशयः ।\nप्रज्ञा संप्रेषिता तेन गता सा सुकलागृहम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000384033, "chapter_id": 20384, "verse_number": "२-५६-३४", "content_sanskrit": "प्रकुर्वती महच्छब्दं दृष्टदेवेव सा बभौ ।\nपूजिता मानिता प्रज्ञा धूपदीपादिभिस्तदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000384034, "chapter_id": 20384, "verse_number": "२-५६-३५", "content_sanskrit": "ब्राह्मणं सुकलापृच्छत्किमेषा च वदेन्मम ।\nब्राह्मण उवाच ।\nभर्तुश्चागमनं ब्रूते तवैव सुभगे स्थिरा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000384035, "chapter_id": 20384, "verse_number": "२-५६-३६", "content_sanskrit": "दिनसप्तकमध्ये स आगमिष्यति नान्यथा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000384036, "chapter_id": 20384, "verse_number": "२-५६-३७", "content_sanskrit": "इत्येवमाकर्ण्यसुमंगलं वचः प्रहर्षयुक्ता सहसा बभूव ।\nधर्मज्ञमेकं सगुणं हि कांतं शकुनात्प्रदिष्टं हि समागतं तम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]