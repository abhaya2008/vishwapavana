[{"id": 7005920000, "chapter_id": 25920, "verse_number": "१-१०३-१", "content_sanskrit": "याज्ञवल्क्य उवाच ।\nभिक्षोर्धर्मं प्रवक्ष्यामितिनिबोधत सत्तमाः ।\nवनाद्गृहाद्वा कृत्वेष्टिं सर्ववेदसदक्षिणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005920001, "chapter_id": 25920, "verse_number": "१-१०३-२", "content_sanskrit": "प्राजापत्यन्तदन्तेऽपि अग्निमारोप्य चात्मन।\nसर्वभूतहितः शान्तस्त्रिदण्डी सकमण्डलुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005920002, "chapter_id": 25920, "verse_number": "१-१०३-३", "content_sanskrit": "सर्वारामं परिव्रज्य भिक्षार्थो ग्राममाश्रयेत्।\nअप्रमत्तश्चरेद्भैक्ष्यं सायाह्ने नाभिलक्षितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005920003, "chapter_id": 25920, "verse_number": "१-१०३-४", "content_sanskrit": "रोहिते भिक्षुकैर्ग्रामे यात्रामात्र मलोलपः।\nभवेत्परमहंसो वा एकदण्डी यमादितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005920004, "chapter_id": 25920, "verse_number": "१-१०३-५", "content_sanskrit": "सिद्धयोगस्त्यजन्देहममृतत्वमिहाप्नुयात् ।\nदाताऽतिथिप्रियो ज्ञानी गृही श्राद्धेऽपिमुच्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]