[{"id": 6000065000, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000065001, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "topics": [{"text": "अनसूयायां दत्तात्रेयावतारः", "range": "१५"}]}, {"id": 6000065002, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.001.m4a", "display_order": 3}, {"id": 6000065003, "chapter_id": 10065, "verse_number": "४-१-१", "content_sanskrit": "मनोस्तु शतरूपायां तिस्रः कन्याश्च जज्ञिरे।\nआकूतिर्देवहूतिश्च प्रसूतिरिति विश्रुताः॥ ४/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.002.m4a", "display_order": 4}, {"id": 6000065004, "chapter_id": 10065, "verse_number": "४-१-२", "content_sanskrit": "आकूतिं रुचये प्रादादपि भ्रातृमतीं नृपः।\nपुत्रिकाधर्ममाश्रित्य शतरूपानुमोदितः॥ ४/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.003.m4a", "display_order": 5}, {"id": 6000065005, "chapter_id": 10065, "verse_number": "४-१-३", "content_sanskrit": "प्रजापतिः स भगवान् रुचिस्तस्यामजीजनत्।\nमिथुनं ब्रह्मवर्चस्वी परमेण समाधिना॥ ४/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.004.m4a", "display_order": 6}, {"id": 6000065006, "chapter_id": 10065, "verse_number": "४-१-४", "content_sanskrit": "यस्तयोः पुरुषः साक्षाद् विष्णुर्यज्ञः स्वरूपधृक्।\nया स्‍त्री सा दक्षिणा भूतेरंशभूताऽनपायिनी॥ ४/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.005.m4a", "display_order": 7, "topics": [{"text": "स्वायंभुवमनुपुत्र्याम् आकूत्यां यज्ञनामकभगवदवतारः", "range": "४"}]}, {"id": 6000065007, "chapter_id": 10065, "verse_number": "४-१-५", "content_sanskrit": "आनिन्ये स्वगृहं पुत्र्याः पुत्रं विततरोचिषम्।\nस्वायंभुवो मुदा युक्तो रुचिर्जग्राह दक्षिणाम्॥ ४/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.006.m4a", "display_order": 8}, {"id": 6000065008, "chapter_id": 10065, "verse_number": "४-१-६", "content_sanskrit": "तां कामयानां भगवानुवाह यजुषां पतिः।\nतुष्टायां तोषमापन्नोऽजनयद् द्वादशात्मजान्॥ ४/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.007.m4a", "display_order": 9}, {"id": 6000065009, "chapter_id": 10065, "verse_number": "४-१-७", "content_sanskrit": "तोषः प्रतोषः सन्तोषो भद्रः शान्तिरिडस्पतिः।\nइन्द्रः कविर्भुवः स्वाहस्सुदेवो रोचनो द्विषट्॥ ४/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.008.m4a", "display_order": 10}, {"id": 6000065010, "chapter_id": 10065, "verse_number": "४-१-८", "content_sanskrit": "तुषिता नाम ते देवा आसन् स्वायम्भुवान्तरे।\nमरीचिमिश्रा ऋषयो यज्ञः सुरगणेश्वरः॥ ४/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.009.m4a", "display_order": 11}, {"id": 6000065011, "chapter_id": 10065, "verse_number": "४-१-९", "content_sanskrit": "प्रियव्रतोत्तानपादौ मनुपुत्रौ महौजसौ।\nतत्पुत्रपौत्रनप्‍तॄणामनुवृत्तं तदन्तरम्॥ ४/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.010.m4a", "display_order": 12}, {"id": 6000065012, "chapter_id": 10065, "verse_number": "४-१-१०", "content_sanskrit": "देवहूतिमदात् तात कर्दमायात्मजां मनुः।\nतत्सम्बन्धि श्रुतप्रायं भवता गदतो मम॥ ४/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.011.m4a", "display_order": 13}, {"id": 6000065013, "chapter_id": 10065, "verse_number": "४-१-११", "content_sanskrit": "दक्षाय ब्रह्मपुत्राय प्रसूतिं भगवान् मनुः।\nप्रायच्छद् यत्कृतः सर्गस्‍त्रिलोक्यां विततो महान्॥ ४/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.012.m4a", "display_order": 14}, {"id": 6000065014, "chapter_id": 10065, "verse_number": "४-१-१२", "content_sanskrit": "याः कर्दमसुताः प्रोक्ता नव ब्रह्मर्षिपत्नयः।\nतासां प्रसूतिप्रसरं प्रोच्यमानं निबोध मे॥ ४/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.013.m4a", "display_order": 15, "topics": [{"text": "देवहूतिपुत्रीणां नवानां वंशकथनम्", "range": "१२–४६"}]}, {"id": 6000065015, "chapter_id": 10065, "verse_number": "४-१-१३", "content_sanskrit": "पत्नी मरीचेस्तु कला सुषुवे कर्दमात्मजा।\nकश्यपं पूर्णिमानं च ययोरापूरितं जगत्॥ ४/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.014.m4a", "display_order": 16}, {"id": 6000065016, "chapter_id": 10065, "verse_number": "४-१-१४", "content_sanskrit": "पूर्णिमाऽसूत विरजं विश्वगां च परंतप।\nदेवकुल्या हरेः पादशौचाद् याऽभूत् सरिद् दिवः॥ ४/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.015.m4a", "display_order": 17}, {"id": 6000065017, "chapter_id": 10065, "verse_number": "४-१-१५", "content_sanskrit": "अनसूया तथैवात्रेर्जज्ञे पुत्रानकल्मशान्।\nदत्तं दुर्वाससं सोममात्मेशब्रह्मसम्भवान्॥ ४/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.016.m4a", "display_order": 18}, {"id": 6000065018, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.017.m4a", "display_order": 19}, {"id": 6000065019, "chapter_id": 10065, "verse_number": "४-१-१६", "content_sanskrit": "अत्रेर्गृहे सुरश्रेष्ठाः स्थित्यन्तोत्पत्तिहेतवः।\nकिंस्विच्चिकीर्षवो जाता एतदाख्याहि मे गुरो॥ ४/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.018.m4a", "display_order": 20}, {"id": 6000065020, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.019.m4a", "display_order": 21}, {"id": 6000065021, "chapter_id": 10065, "verse_number": "४-१-१७", "content_sanskrit": "ब्रह्मणा चोदितः सृष्टावत्रिर्ब्रह्मविदां वरः।\nसह पत्न्या ययौ ऋक्षं कुलाद्रिं तपसि स्थितः॥ ४/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.020.m4a", "display_order": 22}, {"id": 6000065022, "chapter_id": 10065, "verse_number": "४-१-१८", "content_sanskrit": "तस्मिन् प्रसूनस्तबकपलाशाशोककानने।\nवार्भिः स्रवद्भिरुद्घुष्टे निर्विन्ध्यायाः समन्ततः॥ ४/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.021.m4a", "display_order": 23}, {"id": 6000065023, "chapter_id": 10065, "verse_number": "४-१-१९", "content_sanskrit": "प्राणायामेन संयम्य मनोर्वर्षशतं मुनिः।\nअतिष्ठदेकपादेन निर्द्वन्द्वोऽनिलभोजनः॥ ४/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.022.m4a", "display_order": 24}, {"id": 6000065024, "chapter_id": 10065, "verse_number": "४-१-२०", "content_sanskrit": "शरणं तं प्रपद्येऽहं य एव जगदीश्वरः।\nप्रजामात्मसमां मह्यं प्रयच्छत्विति चिन्तयन्॥ ४/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.023.m4a", "display_order": 25}, {"id": 6000065025, "chapter_id": 10065, "verse_number": "४-१-२१", "content_sanskrit": "तप्यमानं त्रिभुवनं प्राणायामैधिताग्निना।\nनिर्गतेन मुनेर्मूर्ध्नः समीक्ष्य प्रभवस्‍त्रयः॥ ४/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.024.m4a", "display_order": 26}, {"id": 6000065026, "chapter_id": 10065, "verse_number": "४-१-२२", "content_sanskrit": "अप्सरोमुनिगन्धर्वसिद्धविद्याधरोरगैः।\nवितायमानयशसो मुदाऽऽश्रमपदं ययुः॥ ४/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.025.m4a", "display_order": 27}, {"id": 6000065027, "chapter_id": 10065, "verse_number": "४-१-२३", "content_sanskrit": "तत्प्रादुर्भावसंयोगविद्योतितमना मुनिः।\nउत्तिष्ठन्नेकपादेन ददृशे विबुधर्षभान्॥ ४/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.026.m4a", "display_order": 28}, {"id": 6000065028, "chapter_id": 10065, "verse_number": "४-१-२४", "content_sanskrit": "प्रणम्य दण्डवद् भूमावुपतस्थेऽर्हणाञ्जलिः।\nवृषहंससुपर्णस्थान् स्वैः स्वैश्चिह्नैश्च चिह्नितान्॥ ४/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.027.m4a", "display_order": 29}, {"id": 6000065029, "chapter_id": 10065, "verse_number": "४-१-२५", "content_sanskrit": "कृपावलोकेन लसद्वदनेनोपलम्भितान्।\nतच्छोचिषा प्रतिहते निमील्य मुनिरक्षिणी॥ ४/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.028.m4a", "display_order": 30}, {"id": 6000065030, "chapter_id": 10065, "verse_number": "४-१-२६", "content_sanskrit": "चेतस्तत्प्रवणं युञ्जन्नस्तावीत् संहताञ्जलिः।\nश्लक्ष्णया सूक्तया वाचा सर्वलोकगरीयसः॥ ४/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.029.m4a", "display_order": 31}, {"id": 6000065031, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "अत्रिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.030.m4a", "display_order": 32}, {"id": 6000065032, "chapter_id": 10065, "verse_number": "४-१-२७", "content_sanskrit": "विश्वोद्भवस्थितिलयेषु विभज्यमानैर्मायागुणैरनुगुणं प्रगृहीतदेहाः।\nहे ब्रह्मविष्णुगिरिशाः प्रणतोऽस्म्यहं वस्तेभ्यः क एव भवतां म इहोपहूतः॥ ४/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.031.m4a", "display_order": 33}, {"id": 6000065033, "chapter_id": 10065, "verse_number": "४-१-२८", "content_sanskrit": "एको मयेह भगवान् विबुधप्रधानश्चित्तीकृतः प्रजननाय कथं नु यूयम्।\nअत्रागतास्तनुभृतां मनसोऽपि दूरा ब्रूत प्रसीदत महानतिविस्मयो मे॥ ४/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.032.m4a", "display_order": 34}, {"id": 6000065034, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.033.m4a", "display_order": 35}, {"id": 6000065035, "chapter_id": 10065, "verse_number": "४-१-२९", "content_sanskrit": "इति तस्य वचः श्रुत्वा त्रयस्ते विबुधर्षभाः।\nप्रत्यूचुः श्लक्ष्णया वाचा प्रहसन्तो मुनिं प्रभो॥ ४/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.034.m4a", "display_order": 36}, {"id": 6000065036, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.035.m4a", "display_order": 37}, {"id": 6000065037, "chapter_id": 10065, "verse_number": "४-१-३०", "content_sanskrit": "यथा कृतस्ते सङ्कल्पो भाव्यं तेनैव नान्यथा।\nतत्सङ्कल्पस्य ते ब्रह्मन् यद् वै ध्यायसि ते वयम्॥ ४/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.036.m4a", "display_order": 38}, {"id": 6000065038, "chapter_id": 10065, "verse_number": "४-१-३१", "content_sanskrit": "अथास्मदंशभूतास्ते आत्मजा लोकविश्रुताः।\nभवितारोऽङ्ग भद्रं ते वितरिष्यन्ति ते यशः॥ ४/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.037.m4a", "display_order": 39}, {"id": 6000065039, "chapter_id": 10065, "verse_number": "४-१-३२", "content_sanskrit": "एवं कामवरं दत्त्वा प्रतिजग्मुः सुरेश्वराः।\nसभाजितास्तयोः सम्यग् दम्पत्योर्मिषतोस्ततः॥ ४/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.038.m4a", "display_order": 40}, {"id": 6000065040, "chapter_id": 10065, "verse_number": "४-१-३३", "content_sanskrit": "सोमोऽभूद् ब्रह्मणोंऽशेन दत्तो विष्णोस्तु योगवित्।\nदुर्वासाः शङ्करस्यांशः, निबोधाङ्गिरसः प्रजाः॥ ४/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.039.m4a", "display_order": 41}, {"id": 6000065041, "chapter_id": 10065, "verse_number": "४-१-३४", "content_sanskrit": "श्रद्धा त्वङ्गिरसः पत्नी चतस्रोऽसूत कन्यकाः।\nसिनीवाली कुहू राका चतुर्थ्यनुमतिस्तथा॥ ४/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.040.m4a", "display_order": 42}, {"id": 6000065042, "chapter_id": 10065, "verse_number": "४-१-३५", "content_sanskrit": "तत्पुत्रावपरावास्तां ख्यातौ स्वारोचिषान्तरे।\nउचथ्यो भगवान् साक्षाद् ब्रह्मिष्ठश्च बृहस्पतिः॥ ४/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.041.m4a", "display_order": 43}, {"id": 6000065043, "chapter_id": 10065, "verse_number": "४-१-३६", "content_sanskrit": "पुलस्त्योऽजनयत् पत्न्यामगस्त्यं च हविर्भुजि।\nसोऽन्यजन्मनि दभ्रोऽग्निः, विश्रवाश्च महातपाः॥ ४/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.042.m4a", "display_order": 44}, {"id": 6000065044, "chapter_id": 10065, "verse_number": "४-१-३७", "content_sanskrit": "तस्य यक्षपतिर्देवः कुबेरस्त्विडिबिलासुतः।\nरावणः कुम्भकर्णश्च तथाऽन्यस्यां विभीषणः॥ ४/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.043.m4a", "display_order": 45}, {"id": 6000065045, "chapter_id": 10065, "verse_number": "४-१-३८", "content_sanskrit": "पुलहस्य गतिर्भार्या त्रीनसूत सती सुतान्।\nकर्मश्रेष्ठं वरीयांसं सहिष्णुं च महामते॥ ४/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.044.m4a", "display_order": 46}, {"id": 6000065046, "chapter_id": 10065, "verse_number": "४-१-३९", "content_sanskrit": "क्रतोरपि क्रिया भार्या वालखिल्यानसूयत।\nऋषीन् षष्टिसहस्राणि ज्वलतो ब्रह्मतेजसा॥ ४/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.045.m4a", "display_order": 47}, {"id": 6000065047, "chapter_id": 10065, "verse_number": "४-१-४०", "content_sanskrit": "ऊर्जायां जज्ञिरे पुत्रा वसिष्ठस्य परन्तप।\nचित्रकेतुप्रधानास्ते सप्त ब्रह्मर्षयोऽमलाः॥ ४/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.046.m4a", "display_order": 48}, {"id": 6000065048, "chapter_id": 10065, "verse_number": "४-१-४१", "content_sanskrit": "चित्रकेतुः सुरोचिश्च विरजो मित्र एव च।\nउल्बणो वसुभृद्यानो द्युमान् शक्त्यादयोऽपरे॥ ४/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.047.m4a", "display_order": 49}, {"id": 6000065049, "chapter_id": 10065, "verse_number": "४-१-४२", "content_sanskrit": "शान्तिस्त्वथर्वणः पत्नी लेभे पुत्रं धृतव्रतम्।\nदध्यञ्चमश्वशिरसं, भृगोर्वंशं निबोध मे॥ ४/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.048.m4a", "display_order": 50}, {"id": 6000065050, "chapter_id": 10065, "verse_number": "४-१-४३", "content_sanskrit": "भृगुः ख्यात्यां महाभागः पत्न्यां पुत्रानजीजनत्।\nधातारं च विधातारं श्रियं च भगवत्प्रियाम्॥ ४/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.049.m4a", "display_order": 51}, {"id": 6000065051, "chapter_id": 10065, "verse_number": "४-१-४४", "content_sanskrit": "आयतिं नियतिं चैव सुते मेरुस्तयोरदात्।\nताभ्यां तयोरभवतां मृकण्डुः प्राण एव च॥ ४/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.050.m4a", "display_order": 52}, {"id": 6000065052, "chapter_id": 10065, "verse_number": "४-१-४५", "content_sanskrit": "मार्कण्डेयो मृकण्डोस्तु प्राणाद् वेदशिरा मुनिः।\nकविश्च भार्गवो यस्य भगवानुशनाः सुतः॥ ४/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.051.m4a", "display_order": 53}, {"id": 6000065053, "chapter_id": 10065, "verse_number": "४-१-४६", "content_sanskrit": "सर्वे ते मुनयः क्षत्तर्लोकान् सर्गैरभावयन्।\nएष कर्दमदौहित्रसंतानः कथितस्तव॥ ४/१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.052.m4a", "display_order": 54}, {"id": 6000065054, "chapter_id": 10065, "verse_number": "४-१-४७", "content_sanskrit": "शृृण्वतः श्रद्धधानस्य सद्यः पापहरः परः।\nप्रसूतिं मानवीं दक्ष उपयेमे ह्यजात्मजः॥ ४/१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.053.m4a", "display_order": 55, "topics": [{"text": "तृतीयाया मनुपुत्र्याः प्रसूत्या वंशकथनम्", "range": "४७"}]}, {"id": 6000065055, "chapter_id": 10065, "verse_number": "४-१-४८", "content_sanskrit": "तस्यां ससर्ज दुहितॄः षोडशामललोचनाः।\nत्रयोदशादाद् धर्माय तथैकामग्नये विभुः॥ ४/१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.054.m4a", "display_order": 56}, {"id": 6000065056, "chapter_id": 10065, "verse_number": "४-१-४९", "content_sanskrit": "पितृभ्य एकां युक्तेभ्यो भवायैकां भवच्छिदे।\nश्रद्धा मैत्री दया शान्तिस्तुष्टिः पुष्टिः क्रियोन्नतिः॥ ४/१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.055.m4a", "display_order": 57}, {"id": 6000065057, "chapter_id": 10065, "verse_number": "४-१-५०", "content_sanskrit": "बुद्धिर्मेधा तितिक्षा ह्रीर्मूर्तिर्धर्मस्य पत्नयः।\nश्रद्धाऽसूत शुभं, मैत्री प्रसादम्, अभयं दया॥ ४/१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.056.m4a", "display_order": 58}, {"id": 6000065058, "chapter_id": 10065, "verse_number": "४-१-५१", "content_sanskrit": "शान्तिः सुखं, मुदं तुष्टिः, स्मयं पुष्टिरसूयत।\nयोगं क्रिया, उन्नतिर्दर्पम्, अर्थं बुद्धिरसूयत॥ ४/१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.057.m4a", "display_order": 59}, {"id": 6000065059, "chapter_id": 10065, "verse_number": "४-१-५२", "content_sanskrit": "मेधा स्मृतिं, तितिक्षा तु क्षेमं, ह्रीः प्रश्रयं सुतम्।\nमूर्तिः सर्वगुणोत्पत्ती नरनारायणावृषी॥ ४/१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.058.m4a", "display_order": 60, "topics": [{"text": "मूर्तिनाम्न्यां नरनारायणोत्पत्तिः", "range": "५२–५९"}]}, {"id": 6000065060, "chapter_id": 10065, "verse_number": "४-१-५३", "content_sanskrit": "ययोर्जन्मन्यदो विश्वमभ्यनन्दत् सुनिर्वृतम्।\nमनांसि ककुभो वाताः प्रसेदुः सरितोऽग्नयः॥ ४/१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.059.m4a", "display_order": 61}, {"id": 6000065061, "chapter_id": 10065, "verse_number": "४-१-५४", "content_sanskrit": "दिव्यवाद्यन्त तूर्याणि पेतुः कुसुमवृष्टयः।\nमुनयस्तुष्टुवुस्तुष्टा जगुर्गन्धर्वकिन्नराः॥ ४/१/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.060.m4a", "display_order": 62}, {"id": 6000065062, "chapter_id": 10065, "verse_number": "४-१-५५", "content_sanskrit": "नृत्यन्ति स्म स्‍त्रियो देव्य आसीत् परममङ्गलम्।\nदेवा ब्रह्मादयः सर्वे उपतस्थुरभिष्टवैः॥ ४/१/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.061.m4a", "display_order": 63}, {"id": 6000065063, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.062.m4a", "display_order": 64}, {"id": 6000065064, "chapter_id": 10065, "verse_number": "४-१-५६", "content_sanskrit": "यो मायया विरचितं निजयात्मनीदं खे रूपभेदमिव तत्प्रतिचक्षणाय।\nएतेन धर्मसदने ऋषिमूर्तिनाऽऽद्य प्रादुश्चकार पुरुषाय नमः परस्मै॥ ४/१/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.063.m4a", "display_order": 65}, {"id": 6000065065, "chapter_id": 10065, "verse_number": "४-१-५७", "content_sanskrit": "सोऽयं स्थितिव्यतिकरोपशमाय सृष्टान् सत्त्वेन नः सुरगणाननुमेयतत्त्वः।\nदृश्याददभ्रकरुणेन विलोकनेन यच्छ्रीनिकेतममलं क्षिपताऽरविन्दम्॥ ४/१/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.064.m4a", "display_order": 66}, {"id": 6000065066, "chapter_id": 10065, "verse_number": "४-१-५८", "content_sanskrit": "एवं सुरगणैस्तात भगवन्तावभिष्टुतौ।\nलब्धावलोकैर्ययतुरर्चितौ गन्धमादनम्॥ ४/१/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.065.m4a", "display_order": 67}, {"id": 6000065067, "chapter_id": 10065, "verse_number": "४-१-५९", "content_sanskrit": "ताविमौ वै भगवतो हरेरंशाविहागतौ।\nभारव्ययाय च भुवः कृष्णौ यदुकुरूद्वहौ॥ ४/१/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.066.m4a", "display_order": 68}, {"id": 6000065068, "chapter_id": 10065, "verse_number": "४-१-६०", "content_sanskrit": "स्वाहाऽभिमानिनश्चाग्नेरात्मजांस्‍त्रीनजीजनत्।\nपावकं पवमानं च, शुचिं च, हुतभोजनम्॥ ४/१/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.067.m4a", "display_order": 69}, {"id": 6000065069, "chapter_id": 10065, "verse_number": "४-१-६१", "content_sanskrit": "तेभ्योऽग्नयः समभवंश्चत्वारिंशच्च पञ्च च।\nत एवैकोनपञ्चाशत् साकं पितृपितामहैः॥ ४/१/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.068.m4a", "display_order": 70}, {"id": 6000065070, "chapter_id": 10065, "verse_number": "४-१-६२", "content_sanskrit": "वैतानिके कर्मणि यन्नामभिर्ब्रह्मवादिभिः।\nआग्नेय्या इष्टयो यज्ञे निरूप्यन्तेऽग्नयस्तु ते॥ ४/१/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.069.m4a", "display_order": 71}, {"id": 6000065071, "chapter_id": 10065, "verse_number": "४-१-६३", "content_sanskrit": "अग्निष्वात्ता बर्हिषदः सोम्याः पितर आज्यपाः।\nसाग्नयोऽनग्नयस्तेषां पत्नी दाक्षायणी स्वधा॥ ४/१/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.070.m4a", "display_order": 72}, {"id": 6000065072, "chapter_id": 10065, "verse_number": "४-१-६४", "content_sanskrit": "तेभ्यो दधार कन्ये द्वे मेनां वैतरणीं स्वधा।\nउभे ते ब्रह्मवादिन्यौ ज्ञानविज्ञानपारगे॥ ४/१/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.071.m4a", "display_order": 73}, {"id": 6000065073, "chapter_id": 10065, "verse_number": "४-१-६५", "content_sanskrit": "भवस्य पत्नी तु सती भवं देवमनुव्रता।\nआत्मनः सदृशं पुत्रं न लेभे गुणशालिनम्॥ ४/१/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.072.m4a", "display_order": 74, "topics": [{"text": "सतीनाम्न्या रुद्रभार्यायाः स्वभर्तृद्विषि पितरि दक्षे कोपेन योगमार्गेण देहत्यागः", "range": "६५–६६"}]}, {"id": 6000065074, "chapter_id": 10065, "verse_number": "४-१-६६", "content_sanskrit": "पितर्यप्रतिरूपे स्वे भवायानागसे रुषा।\nअप्रौढेवात्मनाऽऽत्मानमजहाद् योगसंयुता॥ ४/१/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_001/BhP_04.001.073.m4a", "display_order": 75}, {"id": 6000065075, "chapter_id": 10065, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]