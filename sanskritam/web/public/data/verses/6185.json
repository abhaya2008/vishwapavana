[
  {
    "id": 16785001,
    "chapter_id": 6185,
    "verse_number": "2.1",
    "content_sanskrit": "पराञ्चि खानि व्यतृणत्स्वयम्भूस्तस्मात्पराङ् पश्यति नान्तरात्मन् ।\nकश्चिद्धीरः प्रत्यगात्मानमैक्षदावृत्तचक्षुरमृतत्वमिच्छन् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "Ka_C02_S01_V01"
  },
  {
    "id": 16785002,
    "chapter_id": 6185,
    "verse_number": "2.2",
    "content_sanskrit": "पराचः कामाननुयन्ति बालास्ते मृत्योर्यन्ति विततस्य पाशम् ।\nअथ धीरा अमृतत्वं विदित्वा ध्रुवमध्रुवेष्विह न प्रार्थयन्ते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "Ka_C02_S01_V02"
  },
  {
    "id": 16785003,
    "chapter_id": 6185,
    "verse_number": "2.3",
    "content_sanskrit": "येन रूपं रसं गन्धं शब्दान्स्पर्शांश्च मैथुनान् ।\nएतेनैव विजानाति किमत्र परिशिष्यते । एतद्वै तत् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "Ka_C02_S01_V03"
  },
  {
    "id": 16785004,
    "chapter_id": 6185,
    "verse_number": "2.4",
    "content_sanskrit": "स्वप्नान्तं जागरितान्तं चोभौ येनानुपश्यति ।\nमहान्तं विभुमात्मानं मत्वा धीरो न शोचति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "Ka_C02_S01_V04"
  },
  {
    "id": 16785005,
    "chapter_id": 6185,
    "verse_number": "2.5",
    "content_sanskrit": "य इमं मध्वदं वेद आत्मानं जीवमन्तिकात् ।\nईशानं भूतभव्यस्य न ततो विजुगुप्सते । एतद्वै तत् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "Ka_C02_S01_V05"
  },
  {
    "id": 16785006,
    "chapter_id": 6185,
    "verse_number": "2.6",
    "content_sanskrit": "यः पूर्वं तपसो जातमद्भ्यः पूर्वमजायत ।\nगुहां प्रविश्य तिष्ठन्तं यो भूतेभिर्व्यपश्यत । एतद्वै तत् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "Ka_C02_S01_V06"
  },
  {
    "id": 16785007,
    "chapter_id": 6185,
    "verse_number": "2.7",
    "content_sanskrit": "या प्राणेन सम्भवति अदितिर्देवतामयी ।\nगुहां प्रविश्य तिष्ठन्तीं या भूतेभिर्व्यजायत । एतद्वै तत् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "Ka_C02_S01_V07"
  },
  {
    "id": 16785008,
    "chapter_id": 6185,
    "verse_number": "2.8",
    "content_sanskrit": "अरण्योर्निर्हितो जातवेदा गर्भ इव सुभृतो गर्भिणीभिः ।\nदिवे दिव ईड्यो जागृवद्भिर्हविष्मद्भिर्मनुष्येभिरग्निः । एतद्वै तत् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "Ka_C02_S01_V08"
  },
  {
    "id": 16785009,
    "chapter_id": 6185,
    "verse_number": "2.9",
    "content_sanskrit": "यतश्चोदेति सूर्यः अस्तं यत्र च गच्छति ।\nतं देवाः सर्वे अर्पितास्तदु नात्येति कश्चन । एतद्वै तत् ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "Ka_C02_S01_V09"
  },
  {
    "id": 16785010,
    "chapter_id": 6185,
    "verse_number": "2.10",
    "content_sanskrit": "यदेवेह तदमुत्र यदमुत्र तदन्विह ।\nमृत्योः स मृत्युमाप्नोति य इह नानेव पश्यति ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "Ka_C02_S01_V10"
  },
  {
    "id": 16785011,
    "chapter_id": 6185,
    "verse_number": "2.11",
    "content_sanskrit": "मनसैवेदमाप्तव्यं नेह नानास्ति किञ्चन ।\nमृत्योः स मृत्युं गच्छति य इह नानेव पश्यति ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "Ka_C02_S01_V11"
  },
  {
    "id": 16785012,
    "chapter_id": 6185,
    "verse_number": "2.12",
    "content_sanskrit": "अङ्गुष्ठमात्रः पुरुषो मध्य आत्मनि तिष्ठति ।\nईशानं भूतभव्यस्य न ततो विजुगुप्सते । एतद्वै तत् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "Ka_C02_S01_V12"
  },
  {
    "id": 16785013,
    "chapter_id": 6185,
    "verse_number": "2.13",
    "content_sanskrit": "अङ्गुष्ठमात्रः पुरुषो ज्योतिरिवाधूमकः ।\nईशानो भूतभव्यस्य स एवाद्य स उ श्वः । एतद्वै तत् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "Ka_C02_S01_V13"
  },
  {
    "id": 16785014,
    "chapter_id": 6185,
    "verse_number": "2.14",
    "content_sanskrit": "यथोदकं दुर्गे वृष्टं पर्वतेषु विधावति ।\nएवं धर्मान्पृथक्पश्यंस्तानेवानुविधावति ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "Ka_C02_S01_V14"
  },
  {
    "id": 16785015,
    "chapter_id": 6185,
    "verse_number": "2.15",
    "content_sanskrit": "यथोदकं शुद्धे शुद्धमासिक्तं तादृगेव भवति । एवं मुनेर्विजानत आत्मा भवति गौतम ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "Ka_C02_S01_V15"
  },
  {
    "id": 16785016,
    "chapter_id": 6185,
    "verse_number": "2.16",
    "content_sanskrit": "पुरमेकादशद्वारमजस्यावक्रचेतसः ।\nअनुष्ठाय न शोचति विमुक्तश्च विमुच्यते । एतद्वै तत् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "Ka_C02_S02_V01"
  },
  {
    "id": 16785017,
    "chapter_id": 6185,
    "verse_number": "2.17",
    "content_sanskrit": "हंसः शुचिषद्वसुरन्तरिक्षसद्धोता वेदिषदतिथिर्दुरोणसत् ।\nनृषद्वरसदृतसद्व्योमसदब्जा गोजा ऋतजा अद्रिजा ऋतं बृहत् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "Ka_C02_S02_V02"
  },
  {
    "id": 16785018,
    "chapter_id": 6185,
    "verse_number": "2.18",
    "content_sanskrit": "ऊर्ध्वं प्राणमुन्नयति अपानं प्रत्यगस्यति ।\nमध्ये वामनमासीनं विश्वे देवा उपासते ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "Ka_C02_S02_V03"
  },
  {
    "id": 16785019,
    "chapter_id": 6185,
    "verse_number": "2.19",
    "content_sanskrit": "अस्य विस्रंसमानस्य शरीरस्थस्य देहिनः ।\nदेहाद्विमुच्यमानस्य किमत्र परिशिष्यते । एतद्वै तत् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "Ka_C02_S02_V04"
  },
  {
    "id": 16785020,
    "chapter_id": 6185,
    "verse_number": "2.20",
    "content_sanskrit": "न प्राणेन नापानेन मर्त्यो जीवति कश्चन ।\nइतरेण तु जीवन्ति यस्मिन्नेतावुपाश्रितौ ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "Ka_C02_S02_V05"
  },
  {
    "id": 16785021,
    "chapter_id": 6185,
    "verse_number": "2.21",
    "content_sanskrit": "हन्त त इदं प्रवक्ष्यामि गुह्यं ब्रह्म सनातनम् ।\nयथा च मरणं प्राप्य आत्मा भवति गौतम ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "Ka_C02_S02_V06"
  },
  {
    "id": 16785022,
    "chapter_id": 6185,
    "verse_number": "2.22",
    "content_sanskrit": "योनिमन्ये प्रपद्यन्ते शरीरत्वाय देहिनः ।\nस्थाणुमन्येऽनुसंयन्ति यथाकर्म यथाश्रुतम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "Ka_C02_S02_V07"
  },
  {
    "id": 16785023,
    "chapter_id": 6185,
    "verse_number": "2.23",
    "content_sanskrit": "य एष सुप्तेषु जागर्ति कामं कामं पुरुषो निर्मिमाणः । तदेव शुक्रं तद्ब्रह्म तदेवामृतमुच्यते ।\nतस्मिंल्लोकाः श्रिताः सर्वे तदु नात्येति कश्चन । एतद्वै तत् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "Ka_C02_S02_V08"
  },
  {
    "id": 16785024,
    "chapter_id": 6185,
    "verse_number": "2.24",
    "content_sanskrit": "अग्निर्यथैको भुवनं प्रविष्टो रूपं रूपं प्रतिरूपो बभूव ।\nएकस्तथा सर्वभूतान्तरात्मा रूपं रूपं प्रतिरूपो बहिश्च ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "Ka_C02_S02_V09"
  },
  {
    "id": 16785025,
    "chapter_id": 6185,
    "verse_number": "2.25",
    "content_sanskrit": "वायुर्यथैको भुवनं प्रविष्टो रूपं रूपं प्रतिरूपो बभूव ।\nएकस्तथा सर्वभूतान्तरात्मा रूपं रूपं प्रतिरूपो बहिश्च ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "Ka_C02_S02_V10"
  },
  {
    "id": 16785026,
    "chapter_id": 6185,
    "verse_number": "2.26",
    "content_sanskrit": "सूर्यो यथा सर्वलोकस्य चक्षुर्न लिप्यते चाक्षुषैर्बाह्यदोषैः ।\nएकस्तथा सर्वभूतान्तरात्मा न लिप्यते लोकदुःखेन बाह्यः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "Ka_C02_S02_V11"
  },
  {
    "id": 16785027,
    "chapter_id": 6185,
    "verse_number": "2.27",
    "content_sanskrit": "एको वशी सर्वभूतान्तरात्मा एकं रूपं बहुधा यः करोति ।\nतमात्मस्थं येऽनुपश्यन्ति धीरास्तेषां सुखं शाश्वतं नेतरेषाम् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "Ka_C02_S02_V12"
  },
  {
    "id": 16785028,
    "chapter_id": 6185,
    "verse_number": "2.28",
    "content_sanskrit": "नित्यो नित्यानां चेतनश्चेतनानामेको बहूनां यो विदधाति कामान् ।\nतमात्मस्थं येऽनुपश्यन्ति धीरास्तेषां शान्तिः शाश्वती नेतरेषाम् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "Ka_C02_S02_V13"
  },
  {
    "id": 16785029,
    "chapter_id": 6185,
    "verse_number": "2.29",
    "content_sanskrit": "तदेतदिति मन्यन्तेऽनिर्देश्यं परमं सुखम् ।\nकथं नु तद्विजानीयां किमु भाति विभाति वा ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "Ka_C02_S02_V14"
  },
  {
    "id": 16785030,
    "chapter_id": 6185,
    "verse_number": "2.30",
    "content_sanskrit": "न तत्र सूर्यो भाति न चन्द्रतारकं नेमा विद्युतो भान्ति कुतोऽयमग्निः ।\nतमेव भान्तमनुभाति सर्वं तस्य भासा सर्वमिदं विभाति ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "Ka_C02_S02_V15"
  },
  {
    "id": 16785031,
    "chapter_id": 6185,
    "verse_number": "2.31",
    "content_sanskrit": "ऊर्ध्वमूलोऽवाक्शाख एषोऽश्वत्थः सनातनः ।\nतदेव शुक्रं तद्ब्रह्म तदेवामृतमुच्यते ।\nतस्मिंल्लोकाः श्रिताः सर्वे तदु नात्येति कश्चन । एतद्वै तत् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "Ka_C02_S03_V01"
  },
  {
    "id": 16785032,
    "chapter_id": 6185,
    "verse_number": "2.32",
    "content_sanskrit": "यदिदं किञ्च जगत्सर्वं प्राण एजति निःसृतम् ।\nमहद्भयं वज्रमुद्यतं य एतद्विदुरमृतास्ते भवन्ति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "Ka_C02_S03_V02"
  },
  {
    "id": 16785033,
    "chapter_id": 6185,
    "verse_number": "2.33",
    "content_sanskrit": "भयादस्याग्निस्तपति भयात्तपति सूर्यः ।\nभयादिन्द्रश्च वायुश्च मृत्युर्धावति पञ्चमः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "Ka_C02_S03_V03"
  },
  {
    "id": 16785034,
    "chapter_id": 6185,
    "verse_number": "2.34",
    "content_sanskrit": "इह चेदशकद्बोद्धुं प्राक्शरीरस्य विस्रसः ।\nततः सर्गेषु लोकेषु शरीरत्वाय कल्पते ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "Ka_C02_S03_V04"
  },
  {
    "id": 16785035,
    "chapter_id": 6185,
    "verse_number": "2.35",
    "content_sanskrit": "यथादर्शे तथात्मनि यथा स्वप्ने तथा पितृलोके ।\nयथाप्सु परीव ददृशे तथा गन्धर्वलोके च्छायातपयोरिव ब्रह्मलोके ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "Ka_C02_S03_V05"
  },
  {
    "id": 16785036,
    "chapter_id": 6185,
    "verse_number": "2.36",
    "content_sanskrit": "इन्द्रियाणां पृथग्भावमुदयास्तमयौ च यत् ।\nपृथगुत्पद्यमानानां मत्वा धीरो न शोचति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "Ka_C02_S03_V06"
  },
  {
    "id": 16785037,
    "chapter_id": 6185,
    "verse_number": "2.37",
    "content_sanskrit": "इन्द्रियेभ्यः परं मनो मनसः सत्त्वमुत्तमम् ।\nसत्त्वादधि महानात्मा महतोऽव्यक्तमुत्तमम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "Ka_C02_S03_V07"
  },
  {
    "id": 16785038,
    "chapter_id": 6185,
    "verse_number": "2.38",
    "content_sanskrit": "अव्यक्तात्तु परः पुरुषो व्यापकोऽलिङ्ग एव च ।\nयं ज्ञात्वा मुच्यते जन्तुरमृतत्वं च गच्छति ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "Ka_C02_S03_V08"
  },
  {
    "id": 16785039,
    "chapter_id": 6185,
    "verse_number": "2.39",
    "content_sanskrit": "न सन्दृशे तिष्ठति रूपमस्य न चक्षुषा पश्यति कश्चनैनम् ।\nहृदा मनीषा मनसाभिक्लृप्तो य एतद्विदुरमृतास्ते भवन्ति ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "Ka_C02_S03_V09"
  },
  {
    "id": 16785040,
    "chapter_id": 6185,
    "verse_number": "2.40",
    "content_sanskrit": "यदा पञ्चावतिष्ठन्ते ज्ञानानि मनसा सह ।\nबुद्धिश्च न विचेष्टति तामाहुः परमां गतिम् ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "Ka_C02_S03_V10"
  },
  {
    "id": 16785041,
    "chapter_id": 6185,
    "verse_number": "2.41",
    "content_sanskrit": "तां योगमिति मन्यन्ते स्थिरामिन्द्रियधारणाम् ।\nअप्रमत्तस्तदा भवति योगो हि प्रभवाप्ययौ ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "Ka_C02_S03_V11"
  },
  {
    "id": 16785042,
    "chapter_id": 6185,
    "verse_number": "2.42",
    "content_sanskrit": "नैव वाचा न मनसा प्राप्तुं शक्यो न चक्षुषा ।\nअस्तीति ब्रुवतोऽन्यत्र कथं तदुपलभ्यते ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "Ka_C02_S03_V12"
  },
  {
    "id": 16785043,
    "chapter_id": 6185,
    "verse_number": "2.43",
    "content_sanskrit": "अस्तीत्येवोपलब्धव्यस्तत्त्वभावेन चोभयोः ।\nअस्तीत्येवोपलब्धस्य तत्त्वभावः प्रसीदति ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "Ka_C02_S03_V13"
  },
  {
    "id": 16785044,
    "chapter_id": 6185,
    "verse_number": "2.44",
    "content_sanskrit": "यदा सर्वे प्रमुच्यन्ते कामा येऽस्य हृदि श्रिताः ।\nअथ मर्त्योऽमृतो भवत्यत्र ब्रह्म समश्नुते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "Ka_C02_S03_V14"
  },
  {
    "id": 16785045,
    "chapter_id": 6185,
    "verse_number": "2.45",
    "content_sanskrit": "यदा सर्वे प्रभिद्यन्ते हृदयस्येह ग्रन्थयः ।\nअथ मर्त्योऽमृतो भवत्येतावद्ध्यनुशासनम् ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "Ka_C02_S03_V15"
  },
  {
    "id": 16785046,
    "chapter_id": 6185,
    "verse_number": "2.46",
    "content_sanskrit": "शतं चैका च हृदयस्य नाड्यस्तासां मूर्धानमभिनिःसृतैका ।\nतयोर्ध्वमायन्नमृतत्वमेति विष्वङ्ङन्या उत्क्रमणे भवन्ति ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "Ka_C02_S03_V16"
  },
  {
    "id": 16785047,
    "chapter_id": 6185,
    "verse_number": "2.47",
    "content_sanskrit": "अङ्गुष्ठमात्रः पुरुषोऽन्तरात्मा सदा जनानां हृदये संनिविष्टः । तं स्वाच्छरीरात्प्रवृहेन्मुञ्जादिवेषीकां धैर्येण ।\nतं विद्याच्छुक्रममृतं तं विद्याच्छुक्रममृतमिति ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "Ka_C02_S03_V17"
  },
  {
    "id": 16785048,
    "chapter_id": 6185,
    "verse_number": "2.48",
    "content_sanskrit": "मृत्युप्रोक्तां नचिकेतोऽथ लब्ध्वा विद्यामेतां योगविधिं च कृत्स्नम् ।\nब्रह्म प्राप्तो विरजोऽभूद्विमृत्युरन्योऽप्येवं यो विदध्यात्ममेव ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "Ka_C02_S03_V18"
  },
  {
    "id": 16785049,
    "chapter_id": 6185,
    "verse_number": "2.49",
    "content_sanskrit": "सह नाववतु । सह नौ भुनक्तु । सह वीर्यं करवावहै । तेजस्विनावधीतमस्तु मा विद्विषावहै ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "base_unit_id": "Ka_C02_S03_V19"
  }
]