[{"id": 7004335000, "chapter_id": 24335, "verse_number": "५-३-२९-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nकावेरीति च विख्याता त्रिषु लोकेषु सत्तम ।\nमाहात्म्यं श्रोतुमिच्छामि तस्या मार्कण्ड तत्त्वतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004335001, "chapter_id": 24335, "verse_number": "५-३-२९-२", "content_sanskrit": "कीदृशं दर्शनं तस्याः फलं स्पर्शेऽथवा विभो ।\nस्नाने जाप्येऽथवा दान उपवासे तथा मुने॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004335002, "chapter_id": 24335, "verse_number": "५-३-२९-३", "content_sanskrit": "कथयस्व महाभाग कावेरीसङ्गमे फलम् ।\nधर्मः श्रुतोऽथ दृष्टो वा कथितो वा कृतोऽपि वा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004335003, "chapter_id": 24335, "verse_number": "५-३-२९-४", "content_sanskrit": "अनुमोदितो वा विप्रेन्द्र पुनातीति श्रुतं मया ।\nयथा धर्मप्रसङ्गे तु मुने धर्मोऽपि जायते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004335004, "chapter_id": 24335, "verse_number": "५-३-२९-५", "content_sanskrit": "स्वर्गश्च नरकश्चैव इत्येवं वैदिकी श्रुतिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004335005, "chapter_id": 24335, "verse_number": "५-३-२९-६", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nसाधु साधु महाभाग यत्पृष्टोऽहं त्वयाधुना ।\nशृणुष्वैकमना भूत्वा कावेरीफलमुत्तमम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004335006, "chapter_id": 24335, "verse_number": "५-३-२९-७", "content_sanskrit": "अस्ति यक्षो महासत्त्वः कुबेरोनाम विश्रुतः ।\nसोऽपि तीर्थप्रभावेन राजन्यक्षाधिपोऽभवत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004335007, "chapter_id": 24335, "verse_number": "५-३-२९-८", "content_sanskrit": "तच्छृणुष्व विधानेन भक्त्या परमया नृप ।\nसिद्धिं प्राप्तो महाभाग कावेरीसङ्गमेन तु॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004335008, "chapter_id": 24335, "verse_number": "५-३-२९-९", "content_sanskrit": "कावेर्या नर्मदायास्तु सङ्गमे लोकविश्रुते ।\nतत्र स्नात्वा शुचिर्भूत्वा कुबेरः सत्यविक्रमः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004335009, "chapter_id": 24335, "verse_number": "५-३-२९-१०", "content_sanskrit": "विधिवन्नियमं कृत्वा शास्त्रयुक्त्या नरोत्तम ।\nआराधयन्महादेवमेकचित्तः सनातनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004335010, "chapter_id": 24335, "verse_number": "५-३-२९-११", "content_sanskrit": "एकाहारो वसन्मासं तथा षष्ठाह्नकालिकः ।\nपक्षोपवासी न्यवसत्कंचित्कालं नृपोत्तम॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004335011, "chapter_id": 24335, "verse_number": "५-३-२९-१२", "content_sanskrit": "मूलशाकफलैश्चान्यं कालं नयति बुद्धिमान् ।\nकिंचित्कालं वसंस्तत्र तीर्थे शैवालभोजनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004335012, "chapter_id": 24335, "verse_number": "५-३-२९-१३", "content_sanskrit": "पराकेणानयत्कालं कृच्छ्रेणापि च मानद ।\nचान्द्रायणेन चाप्यन्यमन्यं वाय्वम्बुभोजनः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004335013, "chapter_id": 24335, "verse_number": "५-३-२९-१४", "content_sanskrit": "एवं तत्र नरश्रेष्ठ कामरागविवर्जितः ।\nस्थितो वर्षशतं साग्रं कर्षयन्स्वं तथा वपुः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004335014, "chapter_id": 24335, "verse_number": "५-३-२९-१५", "content_sanskrit": "ततो वर्षशतस्यान्ते देवदेवो महेश्वरः ।\nतुष्टस्तु परया भक्त्या तमुवाच हसन्निव॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004335015, "chapter_id": 24335, "verse_number": "५-३-२९-१६", "content_sanskrit": "भोभो यक्ष महासत्त्व वरं वरय सुव्रत ।\nपरितुष्टोऽस्मि ते भक्त्या तव दास्ये यथेप्सितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004335016, "chapter_id": 24335, "verse_number": "५-३-२९-१७", "content_sanskrit": "यक्ष उवाच ।\nयदि तुष्टोऽसि देवेश उमया सह शङ्कर ।\nअद्यप्रभृति सर्वेषां यक्षाणामधिपो भवे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004335017, "chapter_id": 24335, "verse_number": "५-३-२९-१८", "content_sanskrit": "अक्षयश्चाव्ययश्चैव तव भक्तिपुरःसरः ।\nधर्मे मतिं च मे नित्यं ददस्व परमेश्वर॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004335018, "chapter_id": 24335, "verse_number": "५-३-२९-१९", "content_sanskrit": "ईश्वर उवाच ।\nयत्त्वया प्रार्थितं सर्वं फलं धर्मस्य तत्तथा ।\nइत्येवमुक्त्वा तं तत्र जगामादर्शनं हरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004335019, "chapter_id": 24335, "verse_number": "५-३-२९-२०", "content_sanskrit": "सोऽपि स्नात्वा विधानेन संतर्प्य पितृदेवताः ।\nआमन्त्रयित्वा तत्तीर्थं कृतार्थश्च गृहं ययौ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004335020, "chapter_id": 24335, "verse_number": "५-३-२९-२१", "content_sanskrit": "पूजितस्तत्र यक्षैस्तु सोऽभिषिक्तो विधानतः ।\nचकार विपुलं तत्र राज्यमीप्सितमुत्तमम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004335021, "chapter_id": 24335, "verse_number": "५-३-२९-२२", "content_sanskrit": "तत्र चान्ये सुराः सिद्धा यक्षगन्धर्वकिंनराः ।\nगणाश्चाप्सरसां तत्र ऋषयश्च तथानघ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004335022, "chapter_id": 24335, "verse_number": "५-३-२९-२३", "content_sanskrit": "कावेरीसङ्गमं तेन सर्वपापहरं विदुः ।\nस्वर्गाणामपि सर्वेषां द्वारमेतद्युधिष्ठिर॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004335023, "chapter_id": 24335, "verse_number": "५-३-२९-२४", "content_sanskrit": "ते धन्यास्ते महात्मानस्तेषां जन्म सुजीवितम् ।\nकावेरीसङ्गमे स्नात्वा यैर्दत्तं हि तिलोदकम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004335024, "chapter_id": 24335, "verse_number": "५-३-२९-२५", "content_sanskrit": "दश पूर्वे परे तात मातृतः पितृतस्तथा ।\nपितरः पितामहास्तेन उद्धृता नरकार्णवात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004335025, "chapter_id": 24335, "verse_number": "५-३-२९-२६", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन तत्र स्नायीत मानवः ।\nअर्चयेदीश्वरं देवं यदीच्छेच्छाश्वतीं गतिम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004335026, "chapter_id": 24335, "verse_number": "५-३-२९-२७", "content_sanskrit": "कावेरीसङ्गमे राजन्स्नानदानार्चनं नरैः ।\nकृतं भक्त्या नरश्रेष्ठ अश्वमेधाधिकं फलम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004335027, "chapter_id": 24335, "verse_number": "५-३-२९-२८", "content_sanskrit": "होमेन चाक्षयः स्वर्गो जपादायुर्विवर्धते ।\nध्यानतो नित्यमायाति पदं शिवकलात्मकम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004335028, "chapter_id": 24335, "verse_number": "५-३-२९-२९", "content_sanskrit": "अग्निप्रवेशं यः कुर्यात्तस्मिंस्तीर्थे नरेश्वर ।\nअग्निलोके वसेत्तावद्यावदाभूतसम्प्लवम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004335029, "chapter_id": 24335, "verse_number": "५-३-२९-३०", "content_sanskrit": "अनाशकं तु यः कुर्यात्तस्मिंस्तीर्थे नराधिप ।\nतस्य पुण्यफलं यद्वै तच्छृणुष्व नरोत्तम॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004335030, "chapter_id": 24335, "verse_number": "५-३-२९-३१", "content_sanskrit": "गन्धर्वाप्सरःसंकीर्णे विमाने सूर्यसन्निभे ।\nवीज्यमानो वरस्त्रीभिर्दैवतैः सह मोदते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004335031, "chapter_id": 24335, "verse_number": "५-३-२९-३२", "content_sanskrit": "षष्टिवर्षसहस्राणि षष्टिवर्षशतानि च ।\nक्रीडते रुद्रलोकस्थस्तदन्ते भुवि चागतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004335032, "chapter_id": 24335, "verse_number": "५-३-२९-३३", "content_sanskrit": "भोगवान्दानशीलश्च जायते पृथिवीपतिः ।\nआधिशोकविनिर्मुक्तो जीवेच्च शरदां शतम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004335033, "chapter_id": 24335, "verse_number": "५-३-२९-३४", "content_sanskrit": "एवं गुणगणाकीर्णा कावेरी सा सरिन्नृप ।\nत्रिषु लोकेषु विख्याता नर्मदासङ्गमे सदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004335034, "chapter_id": 24335, "verse_number": "५-३-२९-३५", "content_sanskrit": "जितवाक्कायचित्ताश्च ध्येयध्यानरतास्तथा ।\nकावेरीसङ्गमे तात तेऽपि मोक्षमवाप्नुयुः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004335035, "chapter_id": 24335, "verse_number": "५-३-२९-३६", "content_sanskrit": "शृणु तेऽन्यत्प्रवक्ष्यामि आश्चर्यं नृपसत्तम ।\nत्रिषु लोकेषु का त्वन्या दृश्यते सरिता समा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004335036, "chapter_id": 24335, "verse_number": "५-३-२९-३७", "content_sanskrit": "लब्धं यैर्नर्मदातोयं ये च कुर्युः प्रदक्षिणम् ।\nये पिबन्ति जलं तत्र ते पुण्या नात्र संशयः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004335037, "chapter_id": 24335, "verse_number": "५-३-२९-३८", "content_sanskrit": "न तेषां सन्ततिच्छेदो दश जन्मानि पञ्च च ।\nतेषां पापं विलीयेत हिमं सूर्योदये यथा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004335038, "chapter_id": 24335, "verse_number": "५-३-२९-३९", "content_sanskrit": "गङ्गायमुनसङ्गे वै यत्फलं लभते नरः ।\nतत्फलं लभते मर्त्यः कावेरीस्नानमाचरन्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004335039, "chapter_id": 24335, "verse_number": "५-३-२९-४०", "content_sanskrit": "भौमे तु भूतजायोगे व्यतीपाते च संक्रमे ।\nराहुसोमसमायोगे तदेवाष्टगुणं स्मृतम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004335040, "chapter_id": 24335, "verse_number": "५-३-२९-४१", "content_sanskrit": "अशीतिश्च यवाः प्रोक्ता गङ्गायामुनसङ्गमे ।\nकावेरीनर्मदायोगे तदेवाष्टगुणं स्मृतम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004335041, "chapter_id": 24335, "verse_number": "५-३-२९-४२", "content_sanskrit": "गङ्गा षष्टिसहस्रैस्तु क्षेत्रपालैः प्रपूज्यते ।\nतदर्धैरन्यतीर्थानि रक्षन्ते नात्र संशयः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004335042, "chapter_id": 24335, "verse_number": "५-३-२९-४३", "content_sanskrit": "अमरेश्वरे तु सरितां ये योगाः परिकीर्तिताः ।\nते त्वशीतिसहस्रैस्तु क्षेत्रपालैस्तु रक्षिताः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004335043, "chapter_id": 24335, "verse_number": "५-३-२९-४४", "content_sanskrit": "तथामरेश्वरे याम्ये लिङ्गं वै चपलेश्वरम् ।\nद्वितीयं चण्डहस्ताख्यं द्वे लिङ्गे तीर्थरक्षके॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004335044, "chapter_id": 24335, "verse_number": "५-३-२९-४५", "content_sanskrit": "शिवेन स्थापिते पूर्वं कावेर्याद्यभिरक्षके ।\nलक्षेण रक्षिता देवी नर्मदा बहुकल्पगा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004335045, "chapter_id": 24335, "verse_number": "५-३-२९-४६", "content_sanskrit": "धनुषां षष्ट्यभियुतैः पुरुषैरीशयोजितैः ।\nॐ कारशतसाहस्रैः पर्वतश्चाभिरक्षितः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004335046, "chapter_id": 24335, "verse_number": "५-३-२९-४७", "content_sanskrit": "अन्यदेशकृतं पापमस्मिन् क्षेत्रे विनश्यति ।\nअस्मिंस्तीर्थे कृतं पापं वज्रलेपो भविष्यति॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004335047, "chapter_id": 24335, "verse_number": "५-३-२९-४८", "content_sanskrit": "एषा ते कथिता तात कावेरी सरितां वरा ।\nरुद्रदेहसमुत्पन्ना तेन पुण्या सरिद्वरा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]