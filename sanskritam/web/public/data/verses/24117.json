[{"id": 7004117000, "chapter_id": 24117, "verse_number": "४-६६-१", "content_sanskrit": "स्कन्द उवाच ।\nज्येष्ठेश्वरस्य परितो लिंगान्यन्यानि यानि तु ।\nतानि ते कथयिष्यामि शृणु वातापितापन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004117001, "chapter_id": 24117, "verse_number": "४-६६-२", "content_sanskrit": "ज्येष्ठेशाद्दक्षिणे भागे लिंगमप्सरसां शुभम् ।\nतत्रैवाप्सरसः कूपः सौभाग्योदकसंज्ञकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004117002, "chapter_id": 24117, "verse_number": "४-६६-३", "content_sanskrit": "तत्कूपजलसुस्नातो विलोक्याप्सरसेश्वरम् ।\nन दौर्भाग्यमवाप्नोति नारी वा पुरुषोथवा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004117003, "chapter_id": 24117, "verse_number": "४-६६-४", "content_sanskrit": "तत्रैव कुक्कुटेशाख्यं लिंगं वापीसमीपगम् ।\nतस्य पूजनतः पुंसां कुटुंबं परिवर्धते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004117004, "chapter_id": 24117, "verse_number": "४-६६-५", "content_sanskrit": "पितामहेश्वरं लिंगं ज्येष्ठवापीतटे शुभम् ।\nतत्र श्राद्धं नरः कृत्वा पितॄणां मुदमर्पयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004117005, "chapter_id": 24117, "verse_number": "४-६६-६", "content_sanskrit": "पितामहेशान्नैरृत्यां पूजनीयं प्रयत्नतः ।\nगदाधरेश्वरं लिंगं पितॄणां परितृप्तिदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004117006, "chapter_id": 24117, "verse_number": "४-६६-७", "content_sanskrit": "दिशि पुण्यजनाख्यायां लिंगाज्ज्येष्ठेश्वरान्मुने ।\nवासुकीश्वरसंज्ञं च लिंगमर्च्यं समंततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004117007, "chapter_id": 24117, "verse_number": "४-६६-८", "content_sanskrit": "तत्र वासुकिकुंडे च स्नानदानादिकाः क्रियाः ।\nसर्पभीतिहराः पुंसां वासुकीशप्रभावतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004117008, "chapter_id": 24117, "verse_number": "४-६६-९", "content_sanskrit": "यः स्नातो नागपंचम्यां कुंडे वासुकिसंज्ञिते ।\nन तस्य विषसंसर्गो भवेत्सर्पसमुद्भवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004117009, "chapter_id": 24117, "verse_number": "४-६६-१०", "content_sanskrit": "कर्तव्या नागपञ्चम्यां यात्रा वर्षासु तत्र वै ।\nनागाः प्रसन्ना जायंते कुले तस्यापि सर्वदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004117010, "chapter_id": 24117, "verse_number": "४-६६-११", "content_sanskrit": "तत्कुण्डात्पश्चिमे भागे लिंगं वै तक्षकेश्वरम् ।\nपूजनीयं प्रयत्नेन भक्तानां सर्वसिद्धिदम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004117011, "chapter_id": 24117, "verse_number": "४-६६-१२", "content_sanskrit": "मुनेस्तस्योत्तरे भागे कुण्डं तक्षकसंज्ञितम् ।\nकृतोदकक्रियस्तत्र न सर्पैरभिभूयते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004117012, "chapter_id": 24117, "verse_number": "४-६६-१३", "content_sanskrit": "तत्कुण्डादुत्तरे भागे क्षेत्रं क्षेमकरः सदा ।\nभक्तानां साध्वसध्वंसी कपाली नाम भैरवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004117013, "chapter_id": 24117, "verse_number": "४-६६-१४", "content_sanskrit": "भैरवस्य महाक्षेत्रं तद्वै साधकसिद्धिदम् ।\nतत्र संसाधिता विद्याः षण्मासातत्सिद्धिमाप्नुयुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004117014, "chapter_id": 24117, "verse_number": "४-६६-१५", "content_sanskrit": "तत्र चण्डी महामुण्डा भक्तविघ्नोपशांतिदा ।\nबलिपूजोपहाराद्यैः पूज्या स्वाभीष्टसिद्धये ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004117015, "chapter_id": 24117, "verse_number": "४-६६-१६", "content_sanskrit": "तस्या यात्रां तु यः कुर्यान्महाष्टम्यां नरोत्तमः ।\nयशस्वी पुत्रपौत्राढ्यो लक्ष्मीवांश्चापि जायते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004117016, "chapter_id": 24117, "verse_number": "४-६६-१७", "content_sanskrit": "महामुण्डा प्रतीच्यां तु चतुःसागरवापिका ।\nतस्यां स्नातो भवेत्स्नातः सागरेषु चतुर्ष्वपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004117017, "chapter_id": 24117, "verse_number": "४-६६-१८", "content_sanskrit": "महाप्रसिद्धं तत्स्थानं चतुःसागरसंज्ञितम् ।\nचत्वारि तत्र लिंगानि सागरैः स्थापितानि च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004117018, "chapter_id": 24117, "verse_number": "४-६६-१९", "content_sanskrit": "तस्या वाप्याश्चतुर्दिक्षु पूजितानि दहंत्यघम् ।\nतदुत्तरे महालिंगं वृषभेश्वरसंज्ञितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004117019, "chapter_id": 24117, "verse_number": "४-६६-२०", "content_sanskrit": "हरस्य वृषभेणैव स्थापितं तत्स्वभक्तितः ।\nतस्य दर्शनतः पुंसां षण्मासान्मुक्तिरुद्भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004117020, "chapter_id": 24117, "verse_number": "४-६६-२१", "content_sanskrit": "वृषेश्वरादुदीच्यां तु गंधर्वेश्वरसंज्ञितम् ।\nगंधर्वकुण्डं तत्प्राच्यां तत्र स्नात्वा नरोत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004117021, "chapter_id": 24117, "verse_number": "४-६६-२२", "content_sanskrit": "गंधर्वेश्वरमभ्यर्च्य दत्त्वा दानानि शक्तितः ।\nसन्तर्प्य पितॄदेवांश्च गंधर्वैः सह मोदते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004117022, "chapter_id": 24117, "verse_number": "४-६६-२३", "content_sanskrit": "कर्कोटनामा नागोस्ति गन्धर्वेश्वरपूर्वतः ।\nतत्र कर्कोटवापी च लिंगं कर्कोटकेश्वरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004117023, "chapter_id": 24117, "verse_number": "४-६६-२४", "content_sanskrit": "तस्यां वाप्यां नरः स्नात्वा कर्कोटेशं समर्च्य च ।\nकर्कोटनागमाराध्य नागलोके महीयते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004117024, "chapter_id": 24117, "verse_number": "४-६६-२५", "content_sanskrit": "कर्कोट नागो यैर्दृष्टस्तद्वाप्यां विहितोदकैः ।\nक्रमते न विषं तेषां देहे स्थावरजंगमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004117025, "chapter_id": 24117, "verse_number": "४-६६-२६", "content_sanskrit": "कर्कोटेशात्प्रतीच्यां तु धुंधुमारीश्वराभिधम् ।\nतल्लिंगाभ्यर्चनात्पुंसां न भवेद्वैरिजं भयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004117026, "chapter_id": 24117, "verse_number": "४-६६-२७", "content_sanskrit": "पुरूरवेश्वरं लिंगं तदुदीच्यां व्यवस्थितम् ।\nद्रष्टव्यं तत्प्रयत्नेन चतुर्वर्गफलप्रदम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004117027, "chapter_id": 24117, "verse_number": "४-६६-२८", "content_sanskrit": "दिग्गजेनार्चितं लिंगं सुप्रतीकेन तत्पुरः ।\nसुप्रतीकेश्वरं नाम्ना यशोबलविवर्धनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004117028, "chapter_id": 24117, "verse_number": "४-६६-२९", "content_sanskrit": "सरश्च सुप्रतीकाख्यं तत्पुरो भासते महत् ।\nतत्र स्नात्वा च तल्लिंगं दृष्ट्वा दिक्पतितां लभेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004117029, "chapter_id": 24117, "verse_number": "४-६६-३०", "content_sanskrit": "तत्रास्त्येका महागौरी नाम्ना विजयभैरवी ।\nरक्षार्थमुत्तराद्वारि स्थिता पूज्येष्टसिद्धये ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004117030, "chapter_id": 24117, "verse_number": "४-६६-३१", "content_sanskrit": "वरणायास्तटे रम्ये गणौ हुंडनमुंडनौ ।\nक्षेत्ररक्षां विधत्तस्तौ विघ्नस्तंभन कारकौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004117031, "chapter_id": 24117, "verse_number": "४-६६-३२", "content_sanskrit": "तौ द्रष्टव्यौ प्रयत्नेन क्षेत्रनिर्विघ्न हेतवे ।\nहुंडनेशं मुंडनेशं तत्र दृष्ट्वा सुखी भवेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004117032, "chapter_id": 24117, "verse_number": "४-६६-३३", "content_sanskrit": "स्कंद उवाच ।\nइल्वलारे कथामेकां शृणुष्वावहितो भव ।\nवरणायास्तटे रम्ये यद्वृत्त पूर्वमुत्तमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004117033, "chapter_id": 24117, "verse_number": "४-६६-३४", "content_sanskrit": "एकदाद्रींद्रमालोक्य मेना संहृष्टमानसम् ।\nउमां संस्मृत्य निःश्वस्य प्रोवाचेति पतिव्रता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004117034, "chapter_id": 24117, "verse_number": "४-६६-३५", "content_sanskrit": "मेनोवाच ।\nआर्यपुत्र न जानामि प्रवृत्तिमपि कांचन ।\nविवाहसमयादूर्ध्वं तस्या गौर्या गिरीश्वर ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004117035, "chapter_id": 24117, "verse_number": "४-६६-३६", "content_sanskrit": "स वृषेंद्रगतिर्देवो भस्मोरग विभूषणः ।\nमहापितृवनावासो दिग्वासाः क्वास्ति संप्रति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004117036, "chapter_id": 24117, "verse_number": "४-६६-३७", "content_sanskrit": "अष्टौ या मातरो दृष्टा ब्राह्मी प्रभृतयः प्रिय ।\nस्वस्वरूपास्ता मन्येऽहं बालिकाः कष्टहेतवः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004117037, "chapter_id": 24117, "verse_number": "४-६६-३८", "content_sanskrit": "तस्यैकस्य न कोप्यन्योस्त्यद्वितीयस्य शूलिनः ।\nतदुदंतप्रवृत्त्यै च क्रियतामुद्यमो विभो ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004117038, "chapter_id": 24117, "verse_number": "४-६६-३९", "content_sanskrit": "तस्याः प्रियाया वाक्येन तदपत्यप्रियो गिरिः ।\nउवाच वचनं सास्रमुमा वात्सल्यसन्नगीः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004117039, "chapter_id": 24117, "verse_number": "४-६६-४०", "content_sanskrit": "गिरिराज उवाच ।\nअहमेव गमिष्यामि तस्या मेने गवेषणे ।\nनितरां बाधते प्रेम तददृष्ट्यग्निदूषितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004117040, "chapter_id": 24117, "verse_number": "४-६६-४१", "content_sanskrit": "यदा प्रभृति सा गौरी निर्गता मम सद्मतः ।\nमन्ये मेने तदारभ्य पद्मसद्मा विनिर्ययौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004117041, "chapter_id": 24117, "verse_number": "४-६६-४२", "content_sanskrit": "तदालापामृतधयौ न मे शब्दग्रहौ प्रिये ।\nप्राणेश्वरि तदारभ्य स्यातां शब्दांतरग्रहौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004117042, "chapter_id": 24117, "verse_number": "४-६६-४३", "content_sanskrit": "जैवातृकी यतोह्नः स्याद्दूरीभूता दृशोर्मम ।\nअहो जैवातृकी ज्योत्स्ना ततोह्नोति दुनोति माम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004117043, "chapter_id": 24117, "verse_number": "४-६६-४४", "content_sanskrit": "इत्युक्त्वादाय रत्नानि वासांसि विविधानि च ।\nधराधरेंद्रो निर्यातः शुभलग्नबलोदये ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004117044, "chapter_id": 24117, "verse_number": "४-६६-४५", "content_sanskrit": "अगस्त्य उवाच ।\nकानि कानि च रत्नानि कियंत्यपि च षण्मुख ।\nयान्यादाय प्रतस्थे स तानि मे ब्रूहि पृच्छतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004117045, "chapter_id": 24117, "verse_number": "४-६६-४६", "content_sanskrit": "स्कंद उवाच ।\nतुला मुक्ताफलानां तु कोटिद्वय परीमिताः ।\nतथा वारितराणां च हीरकाणां तुला शतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004117046, "chapter_id": 24117, "verse_number": "४-६६-४७", "content_sanskrit": "नवलक्षाधिकं विप्र षडस्राणां सुतेजसाम् ।\nलक्षद्वयं विदूराणां तुलाविमलवर्चसाम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004117047, "chapter_id": 24117, "verse_number": "४-६६-४८", "content_sanskrit": "कोटयः पद्मरागाणां पंचावैहि तुला मुने ।\nपुष्पराग तुलालक्षं गुणितं नवसंख्यया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004117048, "chapter_id": 24117, "verse_number": "४-६६-४९", "content_sanskrit": "तथा गोमेद रत्नानां तुलालक्षमिता मुनै ।\nइंद्रनीलमणीनां च तुलाः कोट्यर्ध संमिताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004117049, "chapter_id": 24117, "verse_number": "४-६६-५०", "content_sanskrit": "गरुडोद्गाररत्नानां तुलाः प्रयुतसंमिताः ।\nशुद्धविद्रुमरत्नानां तुलाश्च नवकोटयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004117050, "chapter_id": 24117, "verse_number": "४-६६-५१", "content_sanskrit": "अष्टांगाभरणानां च संख्या कर्तुं न शक्यते ।\nवाससां च विचित्राणां कोमलानां तथा मुने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004117051, "chapter_id": 24117, "verse_number": "४-६६-५२", "content_sanskrit": "चामराणि च भूयांसि द्रव्याण्यामोदवंति च ।\nसुवर्णदासदास्यादीन्यसंख्यातानि वै मुने ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004117052, "chapter_id": 24117, "verse_number": "४-६६-५३", "content_sanskrit": "सर्वाण्यपि समादाय प्रतस्थे भूधरेश्वरः ।\nआगत्य वरणातीरं दूरात्काशीमलोकयत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004117053, "chapter_id": 24117, "verse_number": "४-६६-५४", "content_sanskrit": "अनेकरत्ननिचयैः खचिताऽखिलभूमिकाम् ।\nनानाप्रासादमाणिक्यज्योतिस्ततततांबराम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004117054, "chapter_id": 24117, "verse_number": "४-६६-५५", "content_sanskrit": "सौधाग्रविविधस्वर्णकलशोज्वलदिङ्मुखाम् ।\nजयंतीवैजयंतीनां निकरैस्त्रिदिवस्थलीम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004117055, "chapter_id": 24117, "verse_number": "४-६६-५६", "content_sanskrit": "महासिद्ध्यष्टकस्यापि क्रीडाभवनमद्भुतम् ।\nजितकल्पदुमवनां वनैः सर्वफलावनैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004117056, "chapter_id": 24117, "verse_number": "४-६६-५७", "content_sanskrit": "इति काशीसमृद्धिं स विलोक्याभूद्विलज्जितः ।\nउवाच च मनस्येव भूधरेंद्र इदं वचः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004117057, "chapter_id": 24117, "verse_number": "४-६६-५८", "content_sanskrit": "प्रासादेषु प्रतोलीषु प्राकारेषु गृहेषु च ।\nगोपुरेषु विचित्रेषु कपाटेषु तटेष्वपि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004117058, "chapter_id": 24117, "verse_number": "४-६६-५९", "content_sanskrit": "मणिमाणिक्यरत्नानामुच्छलच्चारुरोचिषाम् ।\nज्योतिर्जालैर्जटिलितं ययेदमवलोक्यते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004117059, "chapter_id": 24117, "verse_number": "४-६६-६०", "content_sanskrit": "द्यावाभूम्योरंतरालं तथेति समवैम्यहम् ।\nईदृक्संपत्तिसंभारः कुवेरस्यापि नो गृहे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004117060, "chapter_id": 24117, "verse_number": "४-६६-६१", "content_sanskrit": "अपि वैकुंठभुवने नेतरस्येह का कथा ।\nइति यावद्गिरींद्रोसौ संभावयति चेतसि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004117061, "chapter_id": 24117, "verse_number": "४-६६-६२", "content_sanskrit": "तावत्कार्पटिकः कश्चित्तल्लोचनपथं गतः ।\nआहूय बहुमानं तमपृच्छच्चाचलेश्वरः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004117062, "chapter_id": 24117, "verse_number": "४-६६-६३", "content_sanskrit": "हिमवानुवाच ।\nहंहो कार्पटिक श्रेष्ठ अध्यास्वैतदिहासनम् ।\nस्वपुरोदंतमाख्याहि किमपूर्वमिहाध्वग ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004117063, "chapter_id": 24117, "verse_number": "४-६६-६४", "content_sanskrit": "कोत्र संप्रत्यधिष्ठाता किमधिष्ठातृ चेष्टितम् ।\nयदि जानासि तत्सर्वमिहाचक्ष्व ममाग्रतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004117064, "chapter_id": 24117, "verse_number": "४-६६-६५", "content_sanskrit": "सोपि कार्पटिकस्तस्य गिरिराजस्य भाषितम् ।\nसमाकर्ण्य समाचष्टुं मुने समुपचक्रमे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004117065, "chapter_id": 24117, "verse_number": "४-६६-६६", "content_sanskrit": "कार्पटिक उवाच ।\nआचक्षे शृणु राजेंद्र यत्पृष्टोस्मि त्वयाखिलम् ।\nअहानि पंचषाण्येव व्यतिक्रांतानि मानद ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004117066, "chapter_id": 24117, "verse_number": "४-६६-६७", "content_sanskrit": "समायाते जगन्नाथे पर्वतेंद्र सुतापतौ ।\nसुंदरान्मंदरादद्रेर्दिवोदासे गते दिवि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004117067, "chapter_id": 24117, "verse_number": "४-६६-६८", "content_sanskrit": "यो वै जगदधिष्ठाता सोधिष्ठातात्र सर्वगः ।\nसर्वदृक्सर्वदः शर्वः कथं न ज्ञायते विभो ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004117068, "chapter_id": 24117, "verse_number": "४-६६-६९", "content_sanskrit": "मन्ये दृषत्स्वरूपोसि दृषदोपि कठोरधीः ।\nयतो विश्वेश्वरं काश्यां न वेत्सि गिरिजापतिम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004117069, "chapter_id": 24117, "verse_number": "४-६६-७०", "content_sanskrit": "स्वभावकठिनात्मापि स वरं हिमवान्गिरिः ।\nप्राणाधिक सुता दानाद्यो धिनोद्विश्वनायकम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004117070, "chapter_id": 24117, "verse_number": "४-६६-७१", "content_sanskrit": "बिभ्रत्सहज काठिन्यं जातो गौरीगुरुर्गुरुः ।\nशंभुं प्रपूज्य सुतया स्रजा विश्वगुरोरपि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004117071, "chapter_id": 24117, "verse_number": "४-६६-७२", "content_sanskrit": "चेष्टितं तस्य को वेद वेदवेद्यस्य चेशितुः ।\nमनागिति च जानेहं तच्चेष्टितमिदं जगत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004117072, "chapter_id": 24117, "verse_number": "४-६६-७३", "content_sanskrit": "अधिष्ठाता मया ख्यातस्तथाधिष्ठातृ चेष्टितम् ।\nअपूर्वं यत्त्वयापृष्टं तदाख्यामि च तच्छृणु ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004117073, "chapter_id": 24117, "verse_number": "४-६६-७४", "content_sanskrit": "शुभे ज्येष्ठेश्वरस्थाने सांप्रतं स उमापतिः ।\nकाशीं प्राप्य मुदा तिष्ठेद्गिरिराजांगजा सखः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004117074, "chapter_id": 24117, "verse_number": "४-६६-७५", "content_sanskrit": "स्कंद उवाच ।\nयदा यदा स गिरिजा मृदुनामाक्षरामृतम् ।\nआविष्करोति पथिकोऽद्रींद्रो हृष्येत्तदातदा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004117075, "chapter_id": 24117, "verse_number": "४-६६-७६", "content_sanskrit": "उमानामामृतं पीतं येनेह जगतीतले ।\nन जातु जननीस्तन्यं स पिबेत्कुंभसंभव ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004117076, "chapter_id": 24117, "verse_number": "४-६६-७७", "content_sanskrit": "उमेतिद्व्यक्षरं मंत्रं योऽहर्निशमनुस्मरेत् ।\nन स्मरेच्चित्रगुप्तस्तं कृतपापमपि द्विज ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004117077, "chapter_id": 24117, "verse_number": "४-६६-७८", "content_sanskrit": "पुनः शुश्राव हिमवान्हृष्टः कार्पटिकोदितम् ।\nकार्पटिक उवाच ।\nराजन्विश्वेश्वरार्थेयः प्रासादो विश्वकर्मणा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004117078, "chapter_id": 24117, "verse_number": "४-६६-७९", "content_sanskrit": "निर्मीयते सुनिर्माणो जन्मि निर्वाणदायिनः ।\nतदपूर्वं न कर्णाभ्यामप्याकर्णितवानहम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004117079, "chapter_id": 24117, "verse_number": "४-६६-८०", "content_sanskrit": "यत्रातिमित्रतेजोभिः शलाकाभिः समंततः ।\nमणिमाणिक्यरत्नानां प्रासादेभित्तयः कृताः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004117080, "chapter_id": 24117, "verse_number": "४-६६-८१", "content_sanskrit": "यत्र संति शतं स्तंभा भास्वंतो द्वादशोत्तराः ।\nएकैकं भुवनं धर्तुमष्टाष्टाविति कल्पिताः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004117081, "chapter_id": 24117, "verse_number": "४-६६-८२", "content_sanskrit": "चतुर्दशसु या शोभा विष्टपेषु समंततः ।\nतस्मिन्विमाने सास्तीह शतकोटिगुणोत्तरा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004117082, "chapter_id": 24117, "verse_number": "४-६६-८३", "content_sanskrit": "चंद्रकांतमणीनां च स्तंभाधार शिलाश्च याः ।\nचित्ररत्नमयैस्तंभैः स्तंभितास्तत्प्रभाभराः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004117083, "chapter_id": 24117, "verse_number": "४-६६-८४", "content_sanskrit": "पद्मरागेंद्रनीलानां शालीनाः शालभंजिकाः ।\nनीराजयंत्यहोरात्रं यत्र रजप्रदीपकैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004117084, "chapter_id": 24117, "verse_number": "४-६६-८५", "content_sanskrit": "स्फुरत्स्फटिकनिर्माण श्लक्ष्ण पद्मशिलातले ।\nअनेकरत्नरूपाणि विचित्राणि समंततः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004117085, "chapter_id": 24117, "verse_number": "४-६६-८६", "content_sanskrit": "आरक्तपीतमंजिष्ठ नीलकिर्मीरवर्णकैः ।\nविन्यस्तानीव भासंते चित्रे चित्रकृतायतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004117086, "chapter_id": 24117, "verse_number": "४-६६-८७", "content_sanskrit": "दृक्पिच्छिला विलोक्यंते माणिक्यस्तंभराजयः ।\nयतोऽविमुक्ते स्वक्षेत्रे मोक्षलक्ष्म्यंकुरा इव ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004117087, "chapter_id": 24117, "verse_number": "४-६६-८८", "content_sanskrit": "रत्नाकरेभ्यः सर्वेभ्यो गणा रत्नोच्चयान्बहून् ।\nराशींश्चक्रुः समानीय यत्राद्रिशिखरोपमान् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004117088, "chapter_id": 24117, "verse_number": "४-६६-८९", "content_sanskrit": "यत्र पातालतलतो नागानां कोशवेश्मतः ।\nगणैर्मणिगणाः सर्वे समाहृत्य गिरीकृताः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004117089, "chapter_id": 24117, "verse_number": "४-६६-९०", "content_sanskrit": "शिवभक्तः स्वयं यत्र पौलस्त्यः स्वद्रिकूटतः ।\nकोटिहाटककूटानि आनयामास राक्षसैः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004117090, "chapter_id": 24117, "verse_number": "४-६६-९१", "content_sanskrit": "प्रासादनिर्मितिं श्रुत्वा भक्ता द्वीपांतरस्थिताः ।\nमाणिक्यानि समाजह्रुर्यथासंख्यान्यहो नृप ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004117091, "chapter_id": 24117, "verse_number": "४-६६-९२", "content_sanskrit": "चिंतामणिः स्वयं यत्र कमर्णे विश्वकर्मणे ।\nविश्राणयेदहोरात्रं विचित्रांश्चिं तितान्मणीन् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004117092, "chapter_id": 24117, "verse_number": "४-६६-९३", "content_sanskrit": "नानावर्णपताकाश्च यत्र कल्पमहीरुहः ।\nअनल्पाः कल्पयंत्येव नित्यभक्तिसमन्विताः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004117093, "chapter_id": 24117, "verse_number": "४-६६-९४", "content_sanskrit": "अब्धयो यत्र सततं दधिक्षीरेक्षुसर्पिषाम् ।\nपंचामृतानां कलशैः स्नपयंति दिनेदिने ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004117094, "chapter_id": 24117, "verse_number": "४-६६-९५", "content_sanskrit": "यत्र कामदुघा नित्यं स्नपयेन्मधुधारया ।\nस्वदुग्धया स्वयं भक्त्या विश्वेशं लिंगरूपिणम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004117095, "chapter_id": 24117, "verse_number": "४-६६-९६", "content_sanskrit": "गंधसाररसैर्यं च सेवते मलयाचलः ।\nकर्पूररंभा कर्पूरपूरैर्भक्त्या निषेवते ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004117096, "chapter_id": 24117, "verse_number": "४-६६-९७", "content_sanskrit": "इत्याद्य पूर्वं यत्रास्ति प्रत्यहं शंकरालये ।\nकथं तं त्वमुमाकातं न वेत्सि कठिनाशय ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004117097, "chapter_id": 24117, "verse_number": "४-६६-९८", "content_sanskrit": "इति तस्य समृद्धिं तां दृष्ट्वा जामातुरद्रिराट ।\nत्रपया परिभूतोभून्नितरां कुंभसंभव ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004117098, "chapter_id": 24117, "verse_number": "४-६६-९९", "content_sanskrit": "तस्मै कार्पटिकायाथ स दत्त्वा पारितोषिकम् ।\nपुनश्चिंतापरोजातोऽद्रिराट्कार्पटिके गते ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004117099, "chapter_id": 24117, "verse_number": "४-६६-१००", "content_sanskrit": "उवाचेति मनस्येव विस्मयोत्फुल्ललोचनः ।\nअहो भद्रमिदं जातं यत्त्वया श्रावि शर्मभाक् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004117100, "chapter_id": 24117, "verse_number": "४-६६-१०१", "content_sanskrit": "यावत्संपत्तिसंभारः श्रूयते दृश्यतेत्र वै ।\nजामातुरत्र सदने लीला त्रिजगतीपतेः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004117101, "chapter_id": 24117, "verse_number": "४-६६-१०२", "content_sanskrit": "ततः प्राभृतकस्तुच्छो नितरां प्रतिभाति मे ।\nकन्यार्थं यो मया नीतो जामातुः परितोषकृत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004117102, "chapter_id": 24117, "verse_number": "४-६६-१०३", "content_sanskrit": "अहं मन्ये तथैवासौ यथादर्शि मया पुरा ।\nवृद्धोक्षमात्रसंपत्तिः सर्वकर्मपराङ्मुखः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004117103, "chapter_id": 24117, "verse_number": "४-६६-१०४", "content_sanskrit": "नैनं कोपि विजानीयान्नान्वयोस्य कदाऽचन ।\nनामापि यस्य नैकं च किंदेशीयश्च नोह्यते ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004117104, "chapter_id": 24117, "verse_number": "४-६६-१०५", "content_sanskrit": "किंवृत्तश्च किमाचारो नाममात्रेण चेश्वरः ।\nऐश्वर्यसूचकं वस्तु यस्य किंचिन्न लक्ष्यते ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004117105, "chapter_id": 24117, "verse_number": "४-६६-१०६", "content_sanskrit": "सोसौ निर्वाणसंपत्तिं रंकायापि ददात्यहो ।\nसुमुखः सर्वकर्माणि फलवंति करोति सः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004117106, "chapter_id": 24117, "verse_number": "४-६६-१०७", "content_sanskrit": "वेदवेद्यो हि सर्वज्ञो यत्संतानोऽखिलं जगत् ।\nयं न कोपि हि वेदादौ वेदवेद्यः स एष वै ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004117107, "chapter_id": 24117, "verse_number": "४-६६-१०८", "content_sanskrit": "योनभिज्ञः सदाज्ञातः स सर्वज्ञोयमेव हि ।\nयस्यैकमपि नो नाम पुंसा ज्ञेयं न केनचित् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004117108, "chapter_id": 24117, "verse_number": "४-६६-१०९", "content_sanskrit": "सर्वेषां सर्वनामानि यस्य नामानि निश्चितम् ।\nसोसौ हि सर्वदेशीयः सर्वेभ्यः सर्वसिद्धिदः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004117109, "chapter_id": 24117, "verse_number": "४-६६-११०", "content_sanskrit": "यस्य देशो न विदितो यस्तु वृत्तिपराङ्मुखः ।\nआचारहीनमिव यं पुराऽपश्यं कठोरधीः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004117110, "chapter_id": 24117, "verse_number": "४-६६-१११", "content_sanskrit": "श्रुतिस्मृती यतः सर्वमाचारं वित्त एव हि ।\nनाममात्रेण नियतं यमज्ञासिषमीश्वरम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004117111, "chapter_id": 24117, "verse_number": "४-६६-११२", "content_sanskrit": "साक्षादीश्वर एवैष सोन्येष्वैश्वर्यसूचकः ।\nअपि सर्वगुणाधारो गुणातीतः परापरः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004117112, "chapter_id": 24117, "verse_number": "४-६६-११३", "content_sanskrit": "अर्वाचीन इहाप्येष पराचीनः परात्परः ।\nभूधराणामहं नाथो विश्वनाथ उमापतिः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004117113, "chapter_id": 24117, "verse_number": "४-६६-११४", "content_sanskrit": "अहं प्रमितसंपत्तिरप्रमेय धनोह्यसौ ।\nतुच्छप्राभृत कस्तस्मान्नेदानीमस्य दर्शनम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004117114, "chapter_id": 24117, "verse_number": "४-६६-११५", "content_sanskrit": "करिष्येथ करिष्यामि व्यावृत्त्यागत्य कर्हिचित् ।\nसंप्रधार्येति मनसि सायं स च गिरीश्वरः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004117115, "chapter_id": 24117, "verse_number": "४-६६-११६", "content_sanskrit": "आहूय सर्वाननुगान्पार्वतीयान्महाबलान् ।\nआदिष्टवानिदं वाक्यं सर्वे यूयं बलाधिकाः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004117116, "chapter_id": 24117, "verse_number": "४-६६-११७", "content_sanskrit": "कुर्वंत्वेकं ममादेशं यावन्नोद्यति भानुमान् ।\nतावच्छिवालयं चैकं विदधत्वत्र सत्वरम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004117117, "chapter_id": 24117, "verse_number": "४-६६-११८", "content_sanskrit": "यस्मिन्कृते कृतार्थः स्यामिह लोके परत्र च ।\nसमागत्येह काश्यां यः कुर्यादेकं शिवालयम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004117118, "chapter_id": 24117, "verse_number": "४-६६-११९", "content_sanskrit": "तेन त्रैलोक्यमखिलं सालयं कृतमेव हि ।\nतेन दत्तानि दानानि महांति विधिपूर्वकम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004117119, "chapter_id": 24117, "verse_number": "४-६६-१२०", "content_sanskrit": "सुपर्वणि सुपात्राय सुताथ श्रद्धयाधिकम् ।\nयेन स्ववित्तमानेन धर्मोपार्जित वित्ततः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004117120, "chapter_id": 24117, "verse_number": "४-६६-१२१", "content_sanskrit": "कृतं शंभोर्महासद्म न तं पद्मा त्यजेत्क्वचित् ।\nतपांसि तेन तप्तानि शीर्णपर्णाशनान्यपि ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004117121, "chapter_id": 24117, "verse_number": "४-६६-१२२", "content_sanskrit": "वाराणसीं समासाद्य येनाकारि शिवालयः ।\nअशेषाः सुविशेषाढ्या इष्टांस्तेन महामखाः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004117122, "chapter_id": 24117, "verse_number": "४-६६-१२३", "content_sanskrit": "आनंदकानने येन देवदेवालयः कृतः ।\nइति तस्य समादेशं समाकर्ण्यानुगास्ततः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004117123, "chapter_id": 24117, "verse_number": "४-६६-१२४", "content_sanskrit": "चक्रुर्देवालयं श्रेष्ठं यावद्व्युष्टा न यामिनी ।\nतावच्छैलेश्वरं लिंगं शैलेशेन प्रतिष्ठितम् ।\nचंद्रकांतमणेश्चंचत्कांतिश्चेतितमंडपम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004117124, "chapter_id": 24117, "verse_number": "४-६६-१२५", "content_sanskrit": "अलेखयत्प्रशस्तिं च प्रशस्ताक्षरमालिनीम् ।\nव्याचक्षाणां निजां सर्वं गोत्रेभ्योप्यधिकोन्नतिम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004117125, "chapter_id": 24117, "verse_number": "४-६६-१२६", "content_sanskrit": "ततोऽरुणोदये जाते स्नात्वा पंचनदे ह्रदे ।\nशैलराजः कालराजं नमस्कृत्य समर्च्य च ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004117126, "chapter_id": 24117, "verse_number": "४-६६-१२७", "content_sanskrit": "तत्र राशिं समुत्सृज्य परितस्तवरितो ययौ ।\nपार्वतीयैरनुगतः सर्वैरपि निजालयम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004117127, "chapter_id": 24117, "verse_number": "४-६६-१२८", "content_sanskrit": "ततः प्रातः समालोक्य गणौ हुंडनमुंडनो ।\nहृष्टौ देवालयं रम्यं वरणायास्तटे शुभे ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004117128, "chapter_id": 24117, "verse_number": "४-६६-१२९", "content_sanskrit": "अदृष्टपूर्वदेवाय निवेदयितुमागतौ ।\nतौ तु दृष्ट्वा महादेवमुमादर्शितदर्पणम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004117129, "chapter_id": 24117, "verse_number": "४-६६-१३०", "content_sanskrit": "प्रणम्य दंडवद्भूमौ कृतांजलिपुटौ गणौ ।\nकृताभ्यनुज्ञो भ्रूक्षेपाद्विज्ञप्तिमथ चक्रतुः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004117130, "chapter_id": 24117, "verse_number": "४-६६-१३१", "content_sanskrit": "देवदेव न जानीवः केनचिद्दृढभक्तिना ।\nअतीव रम्यः प्रासादो निर्मितो वरणातटे ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004117131, "chapter_id": 24117, "verse_number": "४-६६-१३२", "content_sanskrit": "आसायं नैक्षिचावाभ्यां दृष्टोद्यैव प्रगे विभो ।\nगणोदितमितीशानो निशम्याह गिरींद्रजाम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004117132, "chapter_id": 24117, "verse_number": "४-६६-१३३", "content_sanskrit": "विज्ञातसर्ववृत्तांतः सर्वज्ञोप्यनभिज्ञवत् ।\nअचलेंद्रागजेयावस्तत्प्रासादविलोकने ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004117133, "chapter_id": 24117, "verse_number": "४-६६-१३४", "content_sanskrit": "इत्युक्त्वेशः सगिरिजो निरगात्सगणो मुने ।\nमहास्यंदनमारुह्य प्रासादं द्रष्टुमुत्सुकः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004117134, "chapter_id": 24117, "verse_number": "४-६६-१३५", "content_sanskrit": "अथालुलोके गिरिशः प्रासादं वरणातटे ।\nअतीव रम्यरचनं यामिनीमात्रनिर्मितम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004117135, "chapter_id": 24117, "verse_number": "४-६६-१३६", "content_sanskrit": "स्यंदनादवरुह्याथ गर्भागारमवीविशत् ।\nददर्श च महालिंगं चंद्रकांतशिलामयम् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004117136, "chapter_id": 24117, "verse_number": "४-६६-१३७", "content_sanskrit": "देदीप्यमानं महसा मोक्षलक्ष्म्यंकुराकृति ।\nदृष्टिप्रसादजननं पुनर्जननशातनम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004117137, "chapter_id": 24117, "verse_number": "४-६६-१३८", "content_sanskrit": "केनेदं स्थापितं लिंगं यावज्जिज्ञासतीश्वरः ।\nतावद्दर्श पुरतः प्रशस्तिं कर्तृसूचिकाम् ।\nवाचयित्वेव च मनाङ्मनस्येव मनोजहृत् ।\nउवाच देवो दिष्ट्येति प्रेक्षस्वात्मपितुः कृतिम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004117138, "chapter_id": 24117, "verse_number": "४-६६-१३९", "content_sanskrit": "उमा श्रुत्येति संहृष्टा कदंबकुसुमश्रियम् ।\nआनंदांकुरलक्ष्मीवदंगेषु परिबिभ्रती ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004117139, "chapter_id": 24117, "verse_number": "४-६६-१४०", "content_sanskrit": "ततो व्यजिज्ञपद्देवं देवी पादौ प्रणम्य च ।\nअस्मिंल्लिंगवरे नाथ त्वया स्थेयमहर्निशम् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004117140, "chapter_id": 24117, "verse_number": "४-६६-१४१", "content_sanskrit": "अस्य लिंगस्य ये भक्ता शैलेशस्य महेशितुः ।\nतेभ्यस्त्वं महतीमृद्धिं दास्यसीह परत्र च ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004117141, "chapter_id": 24117, "verse_number": "४-६६-१४२", "content_sanskrit": "तथेति देव उक्त्वा तां पार्वतीं पुनरब्रवीत् ।\nवरणायां कृतस्नानैः शैलेशो यैः समर्चितः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004117142, "chapter_id": 24117, "verse_number": "४-६६-१४३", "content_sanskrit": "पितॄन्संतर्प्य च मुदा दत्त्वा दानानि शक्तितः ।\nन तेषां पुनरावृत्तिरत्र संसारवर्त्मनि ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004117143, "chapter_id": 24117, "verse_number": "४-६६-१४४", "content_sanskrit": "शैलैश्वरे महालिंगे नित्यं स्थास्याम्यहं शुभे ।\nप्रदास्यामि परां मुक्तिमेतल्लिंगार्चके जने ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004117144, "chapter_id": 24117, "verse_number": "४-६६-१४५", "content_sanskrit": "शैलेश्वरं ये द्रक्ष्यंति वरणायाः सुरोधसि ।\nतेषां काश्यां निवसतां दुःखं नाभिभविष्यति ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004117145, "chapter_id": 24117, "verse_number": "४-६६-१४६", "content_sanskrit": "उमयापि वरो दत्तस्तत्र लिंगे घटोद्भव ।\nशैलेश्वरस्य ये भक्तास्ते मे पुत्रा न संशयः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004117146, "chapter_id": 24117, "verse_number": "४-६६-१४७", "content_sanskrit": "स्कंद उवाव॥  ।\nइति शैलेश्वरं लिंगं कथितं ते महामुने ।\nइदानीं कथयिष्यामि रत्नेश्वरसमुद्भवम् ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004117147, "chapter_id": 24117, "verse_number": "४-६६-१४८", "content_sanskrit": "श्रुत्वा शैलेश माहात्म्यं श्रद्धया परया नरः ।\nपापकंचुकमुत्सृज्य शिवलोकमवाप्नुयात् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004117148, "chapter_id": 24117, "verse_number": "४-६६-१४९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशाखंडे उत्तरार्धे शैलेशादि लिंगनिर्णयोनाम षट्षष्टितमोऽध्यायः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}]