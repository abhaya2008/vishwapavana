[{"id": 2060198, "chapter_id": 2288, "verse_number": "८-९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060199, "chapter_id": 2288, "verse_number": "८-९-१", "content_sanskrit": "ते सेनेऽन्योन्यमासाद्य प्रहृष्टाश्वनरद्विपे।\nबृहत्यौ सम्प्रजहाते देवासुरचमूसमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060200, "chapter_id": 2288, "verse_number": "८-९-२", "content_sanskrit": "ततो नानारथाश्वेभाः पत्तयश्चोग्रविक्रमाः।\nसम्प्रहारान्भृशं चक्रुर्देहपाप्मविनाशनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060201, "chapter_id": 2288, "verse_number": "८-९-३", "content_sanskrit": "पूर्णचन्द्रार्कपद्मानां कान्तित्विङ्गन्धतः समैः।\nउत्तमाङ्गैर्नृसिंहानां नृसिंहास्तस्तरुर्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060202, "chapter_id": 2288, "verse_number": "८-९-४", "content_sanskrit": "अर्धचन्द्रैस्तथा भल्लैः क्षुरप्रैरसिपट्टसैः।\nपरश्वथैश्चापहृतान्युत्तमाङ्गानि युध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060203, "chapter_id": 2288, "verse_number": "८-९-५", "content_sanskrit": "व्यायतायतबाहूनां व्यायतायतबाहुभिः।\nवाहवः पातिता रेजुर्धरण्यां सायुधाङ्गदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060204, "chapter_id": 2288, "verse_number": "८-९-६", "content_sanskrit": "तैः स्फुरद्भिर्मही भाति रक्ताङ्गुलितलैस्तथा।\nगरुडप्रहितैरुग्रैः पञ्चास्यैरुरगैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060205, "chapter_id": 2288, "verse_number": "८-९-७", "content_sanskrit": "द्विरदस्यन्दनाश्वेभ्यः पेतुर्वीरा द्विषद्धताः।\nविमानेभ्यो यथा क्षीणे पुण्ये स्वर्गदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060206, "chapter_id": 2288, "verse_number": "८-९-८", "content_sanskrit": "गदाभिरन्ये गुर्वीभिः परिधैर्मुसलैरपि।\nपोथिताः शतशः पेतुर्वीरा वीरतरै रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060207, "chapter_id": 2288, "verse_number": "८-९-९", "content_sanskrit": "रथा रथैर्विमथिता मत्ता मत्तैर्द्विपा द्विपैः।\nसादिनः सादिभिश्चैव तस्मिन्परमसङ्कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060208, "chapter_id": 2288, "verse_number": "८-९-१०", "content_sanskrit": "रथैर्नरा रथा नागैरश्वारोहाश्च पत्तिभिः।\nअश्वारोहैः पदाताश्च निहता युधि शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060209, "chapter_id": 2288, "verse_number": "८-९-११", "content_sanskrit": "रथाश्वपत्तयो नागै रथाश्वेभाश्च पत्तिभिः।\nरथपत्तिद्विपाश्चाश्चै रथैश्चापि नरद्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060210, "chapter_id": 2288, "verse_number": "८-९-१२", "content_sanskrit": "रथाश्वेभनराणां तु नराश्वेभरथैः कृतम्।\nपाणिपादैश्च शस्त्रैश्च रथैश्च कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060211, "chapter_id": 2288, "verse_number": "८-९-१३", "content_sanskrit": "तथा तस्मिन्बले शूरैर्वध्यमाने हतेऽपि च।\nअस्मानभ्याययुः पार्था वृकोदरपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060212, "chapter_id": 2288, "verse_number": "८-९-१४", "content_sanskrit": "वृष्टद्युम्नः शिखण्डी च द्रौपदेयाः प्रभद्रकाः।\nसात्यकिश्चेकितानश्च द्राविडैः सैनिकैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060213, "chapter_id": 2288, "verse_number": "८-९-१५", "content_sanskrit": "वृता व्यूहेन महता पाण्ड्याश्चोलाः सकेरलाः।\nव्यूढोरस्का दीर्घभुजाः प्रांशवः पृथुलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060214, "chapter_id": 2288, "verse_number": "८-९-१६", "content_sanskrit": "आपीडिनो रक्तदन्ता मत्तमातङ्गविक्रमाः।\nनानाविरागवसाना गन्धचूर्णावचूर्णिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060215, "chapter_id": 2288, "verse_number": "८-९-१७", "content_sanskrit": "बद्धासयः पाशहस्ता वारणप्रतिवारणाः।\nसमानमृत्यवो राजन्नात्यजन्त परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060216, "chapter_id": 2288, "verse_number": "८-९-१८", "content_sanskrit": "कलापिनश्चापहस्ता दीर्घकेशाः प्रियंवदाः।\nपत्तयः सायकैर्विद्धा घोररूपपराक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060217, "chapter_id": 2288, "verse_number": "८-९-१९", "content_sanskrit": "अथापरे पुनः शूराश्चेदिपाञ्चालकेकयाः।\nकारूशाः कोसलाः काञ्च्या मागधाश्चापि दुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060218, "chapter_id": 2288, "verse_number": "८-९-२०", "content_sanskrit": "तेषां रथाश्वनागाश्च प्रवराश्चोग्रपत्तयः।\nनानाबाणरवैर्हृष्टा नृत्यन्ति च हसन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060219, "chapter_id": 2288, "verse_number": "८-९-२१", "content_sanskrit": "तस्य सैन्यस्य महतो महामात्रवरैर्वृतः।\nमध्ये वृकोदरोऽभ्यायात्त्वदीयान्नागधूर्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060220, "chapter_id": 2288, "verse_number": "८-९-२२", "content_sanskrit": "स नागप्रवरोऽत्युग्रो विधिवत्कल्पितो बभौ।\nउदयाग्राद्रिभवनं यथाऽभ्युदितभास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060221, "chapter_id": 2288, "verse_number": "८-९-२३", "content_sanskrit": "तस्यायसं वर्मवरं वररत्नविभूषितम्।\nताराव्याप्तस्य नभसः शारदस्य समं त्विषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060222, "chapter_id": 2288, "verse_number": "८-९-२४", "content_sanskrit": "स तोमरव्यग्रकरश्चारुमौलिः स्वलङ्कृतः।\nशरन्मध्यन्दिनार्काभस्तेजया प्रदाहद्रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060223, "chapter_id": 2288, "verse_number": "८-९-२५", "content_sanskrit": "तं दृष्ट्वा द्विरदं दूरात्क्षेमधूर्तिर्द्विपस्थित।\nआह्वयन्नभिदुद्राव प्रहसन्पृतनामुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060224, "chapter_id": 2288, "verse_number": "८-९-२६", "content_sanskrit": "तयोः समभवद्युद्धं द्विपयोरुग्ररूपयोः।\nयदृच्छया द्रुतवतोर्महापर्वतयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060225, "chapter_id": 2288, "verse_number": "८-९-२७", "content_sanskrit": "संसक्तनागौ तौ वीरौ तोमरैरितरेतरम्।\nबलवत्सूर्यरश्म्याभैर्भित्त्वाऽन्योन्यं विनेदतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060226, "chapter_id": 2288, "verse_number": "८-९-२८", "content_sanskrit": "व्यपसृत्य तु नागाभ्यां मण्डलानि विचेरतुः।\nप्रगृह्य चोभौ धनुषी जघ्नतुर्वै परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060227, "chapter_id": 2288, "verse_number": "८-९-२९", "content_sanskrit": "क्ष्वेडितास्फोटितरवैर्बाणशब्दैस्तु सर्वतः।\nतौ जनं हर्षयन्तौ च सिंहनादं प्रचक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060228, "chapter_id": 2288, "verse_number": "८-९-३०", "content_sanskrit": "समुद्यतकराभ्यां तौ द्विपाभ्यां कृतिनावुभौ।\nवातोद्वूतपताकाभ्यां युयुधाते महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060229, "chapter_id": 2288, "verse_number": "८-९-३१", "content_sanskrit": "तावन्योन्यस्य धनुषी छित्त्वाऽन्योन्यं विनेदतुः।\nशक्तितोमरवर्षेण प्रावृण्मेघाविवाम्बुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060230, "chapter_id": 2288, "verse_number": "८-९-३२", "content_sanskrit": "क्षेमधूर्तिस्तदा भीमं तोमरेण स्तनान्तरे।\nनिर्बिभेदातिवेगेन षड्भिश्चाप्यपरैर्नदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060231, "chapter_id": 2288, "verse_number": "८-९-३३", "content_sanskrit": "स भीमसेनः शुशुभे तोमरैरङ्गमाश्रितैः।\nक्रोधदीप्तवपुर्मेधैः सप्तसप्तिरिवांशमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060232, "chapter_id": 2288, "verse_number": "८-९-३४", "content_sanskrit": "ततो भास्करवर्णाभमञ्चोगतिमयस्मायम्।\nससर्ज तोमरं भीमः प्रत्यमित्राय यत्नवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060233, "chapter_id": 2288, "verse_number": "८-९-३५", "content_sanskrit": "ततः करूशाधिपतिश्चापमानम्य सायकैः।\nदशभिस्तोमरं भित्त्वा षष्ट्या विव्याध पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060234, "chapter_id": 2288, "verse_number": "८-९-३६", "content_sanskrit": "अथ कार्मुकमादाय भीमो जलदनिः स्वनम्।\nरिपोरभ्यर्दयन्नागमुन्नदन्पाण्डवाः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060235, "chapter_id": 2288, "verse_number": "८-९-३७", "content_sanskrit": "स शरौघार्दितो नागो भीमसेनेन संयुगे।\nगृह्यमाणोऽपि नातिष्ठद्वातोद्धूत इवाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060236, "chapter_id": 2288, "verse_number": "८-९-३८", "content_sanskrit": "तमभ्यधावद्द्विरदं भीमो भीमस्य नागराट्।\nमहावातेरितं मेघं वातोद्धूत इवाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060237, "chapter_id": 2288, "verse_number": "८-९-३९", "content_sanskrit": "सन्निवार्यात्मनो नागं क्षेमधूर्तिः प्रतापवान्।\nविव्याधाभिद्रुतं बाणैर्भीमसेनस्य कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060238, "chapter_id": 2288, "verse_number": "८-९-४०", "content_sanskrit": "ततः साधुविसृष्टेन क्षुरेणानतपर्वणा।\nछित्त्वा शरासनं शत्रोर्नागं चापि प्रमार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060239, "chapter_id": 2288, "verse_number": "८-९-४१", "content_sanskrit": "ततः क्रुद्धो रणे भीमं क्षेमधूर्तिः पराभिनत्।\nजघान चास्य द्विरदं नाराचैः सर्वमर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060240, "chapter_id": 2288, "verse_number": "८-९-४२", "content_sanskrit": "स पपात महानागो भीमसेनस्य भारत।\nपुरा नागस्य पतनादवप्लुत्य स्थितो महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060241, "chapter_id": 2288, "verse_number": "८-९-४३", "content_sanskrit": "भीमसेनोऽपि तन्नागं गदया समपोथयत्।\nतस्मात्प्रमथितान्नागात्क्षेमधूर्तिरवप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060242, "chapter_id": 2288, "verse_number": "८-९-४४", "content_sanskrit": "`उद्धृत्य स्वङ्गं निशितमभ्यधावत्स पाण्डवम्।\nउद्यतायुधमायान्तं सदयाऽहन्वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060243, "chapter_id": 2288, "verse_number": "८-९-४५", "content_sanskrit": "स पपात हतः सासिर्व्यसुस्तमभितो द्विपम्।\nवज्रप्रभग्नमचलं सिंहो वज्रहतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060244, "chapter_id": 2288, "verse_number": "८-९-४६", "content_sanskrit": "तं हतं नृपतिं दृष्ट्वा करूशानां यशस्करम्।\nप्राद्रावद्व्यथिता सेना त्वदीया भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060245, "chapter_id": 2288, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे नवमोऽध्यायः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]