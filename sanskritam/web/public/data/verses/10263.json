[{"id": 6000263000, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "अथ सप्तषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000263001, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.001.m4a", "display_order": 2}, {"id": 6000263002, "chapter_id": 10263, "verse_number": "१०-६७-१", "content_sanskrit": "ततः स्वयं देवपतिस्तुङ्गमारुह्य वारणम्।\nकिरीटी बद्धतूणीरः प्रगृहीतशरासनः॥ १०/६७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेन महेन्द्रपराजयः", "range": "१–१६"}]}, {"id": 6000263003, "chapter_id": 10263, "verse_number": "१०-६७-२", "content_sanskrit": "अभ्यद्रवद् रणे कृष्णं गजः केसरिणं यथा।\nपारिजातकृते राजन् पौलोम्या वचनं स्मरन्॥ १०/६७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.003.m4a", "display_order": 4}, {"id": 6000263004, "chapter_id": 10263, "verse_number": "१०-६७-३", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य हरिः पुरपुरञ्जयः।\nशङ्खं दध्मौ महानादं दिशः समभिपूरयन्॥ १०/६७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.004.m4a", "display_order": 5}, {"id": 6000263005, "chapter_id": 10263, "verse_number": "१०-६७-४", "content_sanskrit": "तमभिद्रुत्य देवेन्द्रो महद् विष्फारयन् धनुः।\nक्षुरप्रेण सुतीक्ष्णेन कृष्णं विव्याध सङ्गरे॥ १०/६७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.005.m4a", "display_order": 6}, {"id": 6000263006, "chapter_id": 10263, "verse_number": "१०-६७-५", "content_sanskrit": "हरिर्विद्धः क्षुरप्रेण देवराजेन वक्षसि।\nप्रहस्य साधु शक्रोऽसि युक्तं त इति चाब्रवीत्॥ १०/६७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.006.m4a", "display_order": 7}, {"id": 6000263007, "chapter_id": 10263, "verse_number": "१०-६७-६", "content_sanskrit": "भूयोऽपि बाणान् दश देवराजः सन्धाय चापे भुजगेन्द्रकल्पे।\nआकर्णपूर्णं विनिकृष्य कृष्णे मुमोच चक्रेऽसहसिंहनादम्॥ १०/६७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.007.m4a", "display_order": 8}, {"id": 6000263008, "chapter_id": 10263, "verse_number": "१०-६७-७", "content_sanskrit": "तानन्तरे कंसरिपुर्महात्मा छित्त्वा त्रिधैकेन शरेण बाणान्।\nविव्याध बाणैर्दशभिः सुधौतैः पुरन्दरं भारत लीलयैव॥ १०/६७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.008.m4a", "display_order": 9}, {"id": 6000263009, "chapter_id": 10263, "verse_number": "१०-६७-८", "content_sanskrit": "ते शरा देवराजस्य गात्रं निर्भिद्य सावृति।\nशोणिताक्ताः प्रदृश्यन्ते भूयो वेगेन निर्गताः॥ १०/६७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.009.m4a", "display_order": 10}, {"id": 6000263010, "chapter_id": 10263, "verse_number": "१०-६७-९", "content_sanskrit": "पुनश्च शक्रः कोदण्डे शरान् सन्धाय षोडश।\nमुमोचाकृष्य गोविन्दस्तांश्चकर्त शरैस्‍त्रिभिः॥ १०/६७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.010.m4a", "display_order": 11}, {"id": 6000263011, "chapter_id": 10263, "verse_number": "१०-६७-१०", "content_sanskrit": "भूयोऽपि बाणैस्‍त्रिंशद्भिः सुरराजानमाहवे।\nअयोधयद्धरिस्ते च ममज्जुः शक्रवक्षसि॥ १०/६७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.011.m4a", "display_order": 12}, {"id": 6000263012, "chapter_id": 10263, "verse_number": "१०-६७-११", "content_sanskrit": "ततश्चुकोप देवेन्द्रो दण्डाहत इवोरगः।\nप्रेषयामास तोत्रेण तार्क्ष्यं प्रति महागजम्॥ १०/६७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.012.m4a", "display_order": 13}, {"id": 6000263013, "chapter_id": 10263, "verse_number": "१०-६७-१२", "content_sanskrit": "स गजः प्राप्य गरुडं पाकशासनचोदितः।\nचतुभिर्घट्टयामास दन्तैर्बाहुयुगान्तरे॥ १०/६७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.013.m4a", "display_order": 14}, {"id": 6000263014, "chapter_id": 10263, "verse_number": "१०-६७-१३", "content_sanskrit": "ततस्तुण्डेन गरुडः पक्षाभ्यां च तथा नखैः।\nमर्दयामास कौरव्य गजमैरावताह्वयम्॥ १०/६७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.014.m4a", "display_order": 15}, {"id": 6000263015, "chapter_id": 10263, "verse_number": "१०-६७-१४", "content_sanskrit": "शक्रस्तु वज्रमुद्यम्य घोरं दानवभीषणम्।\nपश्यतां सर्वभूतानां प्रजहार वृषाकपिम्॥ १०/६७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.015.m4a", "display_order": 16}, {"id": 6000263016, "chapter_id": 10263, "verse_number": "१०-६७-१५", "content_sanskrit": "तमागतं मधुरिपुर्वज्रं दुश्च्यवनायुधम्।\nवामेन पाणिना विष्णुर्जग्राह प्रजहास च॥ १०/६७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.016.m4a", "display_order": 17}, {"id": 6000263017, "chapter_id": 10263, "verse_number": "१०-६७-१६", "content_sanskrit": "निरायुधः सुरपतिर्गरुडार्दितवाहनः।\nव्यावर्तत रणाद् राजन् व्रीडावनतकन्धरः॥ १०/६७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.017.m4a", "display_order": 18}, {"id": 6000263018, "chapter_id": 10263, "verse_number": "१०-६७-१७", "content_sanskrit": "तं दृष्ट्वा भ्रष्टसङ्कल्पं पलायनपरायणम्।\nसत्यभामा सुरपतिं प्रहसन्तीदमब्रवीत्॥ १०/६७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.018.m4a", "display_order": 19}, {"id": 6000263019, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "सत्यभामोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.019.m4a", "display_order": 20}, {"id": 6000263020, "chapter_id": 10263, "verse_number": "१०-६७-१८", "content_sanskrit": "एहि शक्र निवर्तस्व मा याहि कुलिशायुध।\nपलायनमयुक्तं हि पौलोम्या वल्लभस्य ते॥ १०/६७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.020.m4a", "display_order": 21}, {"id": 6000263021, "chapter_id": 10263, "verse_number": "१०-६७-१९", "content_sanskrit": "ऐश्वर्यमत्ता पौलोमी भर्तृपौरुषगर्विता।\nअवमंस्यति सद्यस्त्वां भार्या रणपराजितम्॥ १०/६७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.021.m4a", "display_order": 22}, {"id": 6000263022, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.022.m4a", "display_order": 23}, {"id": 6000263023, "chapter_id": 10263, "verse_number": "१०-६७-२०", "content_sanskrit": "इत्थं देव्या गिरं शक्रः सोपालम्भमुदीरिताम्।\nनिशम्याभिमुखो भूत्वा प्राह देवीं शुचिस्मिताम्॥ १०/६७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.023.m4a", "display_order": 24}, {"id": 6000263024, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.024.m4a", "display_order": 25}, {"id": 6000263025, "chapter_id": 10263, "verse_number": "१०-६७-२१", "content_sanskrit": "येनामरासुरमहोरगयक्षसिद्धगन्धर्वकिन्नरपिशाचनिशाचराद्याः।\nसृष्टास्‍त्रिलोकगुरुणा रणमूर्ध्नि तेन को वा न याति परिभूतिमलं विरुद्ध्य॥ १०/६७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.025.m4a", "display_order": 26}, {"id": 6000263026, "chapter_id": 10263, "verse_number": "१०-६७-२२", "content_sanskrit": "वत्से यथा तनुबलः सकृदेत्य मातर्यूधस्यपानसमये कुरुते विरोधम्।\nतद्वद् वयं च निजशैशवमप्रमेये नाथे विरुद्ध्य पिशिताशनि दर्शयामः॥ १०/६७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.026.m4a", "display_order": 27}, {"id": 6000263027, "chapter_id": 10263, "verse_number": "१०-६७-२३", "content_sanskrit": "इति सत्राजितः पुत्रीमुक्त्वा भारतसत्तम।\nकृताञ्जलिः प्रणम्याह वासुदेवं पुरन्दरः॥ १०/६७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.027.m4a", "display_order": 28}, {"id": 6000263028, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.028.m4a", "display_order": 29}, {"id": 6000263029, "chapter_id": 10263, "verse_number": "१०-६७-२४", "content_sanskrit": "नमस्ते देवदेवेश पुण्डरीकाक्ष माधव।\nक्षमस्व मत्कृतं विश्वमपराधं जगत्पते॥ १०/६७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.029.m4a", "display_order": 30, "topics": [{"text": "इन्द्रेण श्रीकृष्णसत्यभामयोः क्षमापणम्", "range": "२४–३०"}]}, {"id": 6000263030, "chapter_id": 10263, "verse_number": "१०-६७-२५", "content_sanskrit": "न मां त्वदेकशरणं शरणागतवत्सल।\nभूरिबालिशमक्षान्तं परित्यक्तुं त्वमर्हसि॥ १०/६७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.030.m4a", "display_order": 31}, {"id": 6000263031, "chapter_id": 10263, "verse_number": "१०-६७-२६", "content_sanskrit": "ऐरावतश्च कुलिशं पारिजातश्च पादपः।\nदेवराज्यं च भगवन्नियं चाप्यमरावती॥ १०/६७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.031.m4a", "display_order": 32}, {"id": 6000263032, "chapter_id": 10263, "verse_number": "१०-६७-२७", "content_sanskrit": "त्वदधीनमिदं विश्वमहमाज्ञाकरस्तव।\nअत्र यद् रोचते नेतुं नीयतां तद् यथेच्छया॥ १०/६७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.032.m4a", "display_order": 33}, {"id": 6000263033, "chapter_id": 10263, "verse_number": "१०-६७-२८", "content_sanskrit": "किन्तु वक्ष्यामि गोविन्द मूलं त्वयि विरुद्ध्यतः।\nरमसे मानुषे लोके भगवंस्त्वमनन्यधीः॥ १०/६७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.033.m4a", "display_order": 34}, {"id": 6000263034, "chapter_id": 10263, "verse_number": "१०-६७-२९", "content_sanskrit": "तत्र नीते पारिजाते भवता कल्पपादपे।\nतेन सा जायते स्वर्गान्निर्विशेषा वसुन्धरा॥ १०/६७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.034.m4a", "display_order": 35}, {"id": 6000263035, "chapter_id": 10263, "verse_number": "१०-६७-३०", "content_sanskrit": "तेनाहं यदुशार्दूल विरोधं कृतवांस्त्वयि।\nतत् क्षन्तव्यं त्वया देव कार्याकार्यं विजानता॥ १०/६७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.035.m4a", "display_order": 36}, {"id": 6000263036, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.036.m4a", "display_order": 37}, {"id": 6000263037, "chapter_id": 10263, "verse_number": "१०-६७-३१", "content_sanskrit": "इत्युक्तो देवराजेन देवदेवो जनार्दनः।\nपुरन्दरं कुरुश्रेष्ठ प्राह प्रहसिताननः॥ १०/६७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.037.m4a", "display_order": 38}, {"id": 6000263038, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.038.m4a", "display_order": 39}, {"id": 6000263039, "chapter_id": 10263, "verse_number": "१०-६७-३२", "content_sanskrit": "अपराधस्त्वया शक्र न कश्चिदपि चेष्टितः।\nयत् कृतं तन्ममैवागस्त्वभेदादावयोः परम्॥ १०/६७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.039.m4a", "display_order": 40}, {"id": 6000263040, "chapter_id": 10263, "verse_number": "१०-६७-३३", "content_sanskrit": "यत् त्वयाऽद्य सहस्राक्ष चेष्टितं साध्वसाधु वा।\nमयैव तत् कृतं सर्वं नात्र कार्या विचारणा॥ १०/६७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.040.m4a", "display_order": 41}, {"id": 6000263041, "chapter_id": 10263, "verse_number": "१०-६७-३४", "content_sanskrit": "पारिजातस्तरुश्रेष्ठो मय्यारूढे तरुर्दिवम्।\nमन्निर्देशात् सहस्राक्ष स्वयमेष्यति नन्दनम्॥ १०/६७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.041.m4a", "display_order": 42}, {"id": 6000263042, "chapter_id": 10263, "verse_number": "१०-६७-३५", "content_sanskrit": "इत्युक्त्वा वासुदेवेन देवराजः कुरूद्वह।\nगोविन्दं सत्यभामां च प्रसाद्य गरुडं तथा॥ १०/६७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.042.m4a", "display_order": 43}, {"id": 6000263043, "chapter_id": 10263, "verse_number": "१०-६७-३६", "content_sanskrit": "पुत्रो मे रक्षितव्यस्ते स्यालो बीभत्सुरित्यपि।\nभूयोभूयः प्रार्थयित्वा कृतानुज्ञः पुरन्दरः॥ १०/६७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.043.m4a", "display_order": 44}, {"id": 6000263044, "chapter_id": 10263, "verse_number": "१०-६७-३७", "content_sanskrit": "सार्धं सकलदिक्पालैर्लब्धवज्रः पुरं ययौ।\nपुरन्दरं सदिक्पालं विसृज्य यदुनन्दनः॥ १०/६७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.044.m4a", "display_order": 45}, {"id": 6000263045, "chapter_id": 10263, "verse_number": "१०-६७-३८", "content_sanskrit": "गरुडं प्राह कौरव्य यास्यामो द्वारकामिति।\nगोविन्दं सत्यभामां च पारिजातं च पादपम्॥ १०/६७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.045.m4a", "display_order": 46, "topics": [{"text": "श्रीकृष्णस्य द्वारकागमनम्", "range": "३८–३९"}]}, {"id": 6000263046, "chapter_id": 10263, "verse_number": "१०-६७-३९", "content_sanskrit": "गरुडः पन्नगरिपुर्लीलयैव वहन् ययौ।\nसम्प्रविश्य पुरीं रम्यां द्वारतोरणभूषिताम्॥ १०/६७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.046.m4a", "display_order": 47}, {"id": 6000263047, "chapter_id": 10263, "verse_number": "१०-६७-४०", "content_sanskrit": "पताकामालिनीं दिव्यां सिक्तसंमृष्टभूतलाम्।\nऊढोपायनताम्बूलस्रग्गन्धकलशाक्षतैः॥ १०/६७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.047.m4a", "display_order": 48}, {"id": 6000263048, "chapter_id": 10263, "verse_number": "१०-६७-४१", "content_sanskrit": "उपस्थितैर्यदुश्रेष्ठैः पूजितश्चाभिवन्दितः।\nतूर्यमङ्गलनिर्घोषैर्वेदस्वाध्यायनिःस्वनैः॥ १०/६७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.048.m4a", "display_order": 49}, {"id": 6000263049, "chapter_id": 10263, "verse_number": "१०-६७-४२", "content_sanskrit": "प्रविवेश सभां दिव्यां सुधर्मां वृद्धसेविताम्।\nआहुकं वसुदेवं च बलभद्रं तथाऽग्रजम्॥ १०/६७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.049.m4a", "display_order": 50}, {"id": 6000263050, "chapter_id": 10263, "verse_number": "१०-६७-४३", "content_sanskrit": "अभिवाद्य यथान्यायं पूजितस्तैर्यथोचितम्।\nउपविष्टः सभामध्ये काञ्चने परमासने॥ १०/६७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.050.m4a", "display_order": 51}, {"id": 6000263051, "chapter_id": 10263, "verse_number": "१०-६७-४४", "content_sanskrit": "रराज राजशार्दूल बृहस्पतिपुरोगमैः।\nलोकपालैरुपासीनैर्दिवि वज्रधरो यथा॥ १०/६७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.051.m4a", "display_order": 52}, {"id": 6000263052, "chapter_id": 10263, "verse_number": "१०-६७-४५", "content_sanskrit": "प्राङ्गणे सत्यभामायाः पारिजातं महाद्रुमम्।\nस्थापयामास गोविन्दः सर्वतो मणिकुट्टिमे॥ १०/६७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.052.m4a", "display_order": 53, "topics": [{"text": "सत्यभामायाः गृहप्राङ्गणे पारिजाततरुस्थापनम्", "range": "४५"}]}, {"id": 6000263053, "chapter_id": 10263, "verse_number": "१०-६७-४६", "content_sanskrit": "आयान्तं देवकीपुत्रं योषित्सार्थेन भूरिणा।\nश्रुत्वा द्रष्टुमुपाजग्मुः सकला यादवस्‍त्रियः॥ १०/६७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.053.m4a", "display_order": 54, "topics": [{"text": "कृष्णदर्शनोत्सुकाः सर्वाः यादवस्त्रियः उपाजग्मुः", "range": "४६–५३"}]}, {"id": 6000263054, "chapter_id": 10263, "verse_number": "१०-६७-४७", "content_sanskrit": "वसुदेवस्य कौरव्य रोहिण्याद्याः स्‍त्रियोऽखिलाः।\nआजग्मुः केशवं द्रष्टुं जितशत्रुमनामयम्॥ १०/६७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.054.m4a", "display_order": 55}, {"id": 6000263055, "chapter_id": 10263, "verse_number": "१०-६७-४८", "content_sanskrit": "स दृष्ट्वा मातरो विष्णुर्देवक्या सह सङ्गताः।\nचक्रे प्रणाममाशीर्भिस्ताश्च तं प्रत्यपूजयन्॥ १०/६७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.055.m4a", "display_order": 56}, {"id": 6000263056, "chapter_id": 10263, "verse_number": "१०-६७-४९", "content_sanskrit": "रुग्मिण्याद्यास्तथा सप्त महिष्यः कृष्णवल्लभाः।\nप्रणेमुर्देवमभ्येत्य दिव्यरूपाः स्वलङ्कृताः॥ १०/६७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.056.m4a", "display_order": 57}, {"id": 6000263057, "chapter_id": 10263, "verse_number": "१०-६७-५०", "content_sanskrit": "रेवती रामदयिता त्रिवक्रा च यशस्विनी।\nएकानङ्गा च तन्वङ्गी चित्रा च वरवर्णिनी॥ १०/६७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.057.m4a", "display_order": 58}, {"id": 6000263058, "chapter_id": 10263, "verse_number": "१०-६७-५१", "content_sanskrit": "अन्याश्च कुरुशार्दूल भोजवृष्ण्यन्धकस्‍त्रियः।\nआनीतप्रमदासार्थं जितशत्रुमनामयम्॥ १०/६७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.058.m4a", "display_order": 59}, {"id": 6000263059, "chapter_id": 10263, "verse_number": "१०-६७-५२", "content_sanskrit": "गोविन्दं सत्यभामां चाप्यानीतममरद्रुमम्।\nप्रीत्युत्फुल्लमुखाः सर्वे कौतुकाद् द्रष्टुमाययुः॥ १०/६७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.059.m4a", "display_order": 60}, {"id": 6000263060, "chapter_id": 10263, "verse_number": "१०-६७-५३", "content_sanskrit": "ताः समेता यथाजोषं लाजप्रसवतण्डुलैः।\nस्पृष्ट्वा मूर्ध्नि मुकुन्दस्य जग्मुः स्वं स्वं निवेशनम्॥ १०/६७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_067/BhP_10.067.060.m4a", "display_order": 61}, {"id": 6000263061, "chapter_id": 10263, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे सप्तषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]