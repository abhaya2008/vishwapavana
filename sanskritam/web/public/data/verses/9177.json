[{"id": 5000177000, "chapter_id": 9177, "verse_number": "२-१००-१", "content_sanskrit": "जटिलं चीरवसनं प्राञ्जलिं पतितं भुवि ।\nददर्श रामो दुर्दर्शं युगान्ते भास्करं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000177001, "chapter_id": 9177, "verse_number": "२-१००-२", "content_sanskrit": "कथञ्चिदभिविज्ञाय विवर्णवदनं कृशम् ।\nभ्रातरं भरतं राम: परिजग्राह बाहुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000177002, "chapter_id": 9177, "verse_number": "२-१००-३", "content_sanskrit": "आघ्राय रामस्तं मूर्ध्नि परिष्वज्य च राघव: ।\nअङ्के भरतमारोप्य पर्यपृच्छत् समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000177003, "chapter_id": 9177, "verse_number": "२-१००-४", "content_sanskrit": "क्व नु ते ऽभूत् पिता तात यदरण्यं त्वमागत: ।\nन हि त्वं जीवतस्तस्य वनमागन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000177004, "chapter_id": 9177, "verse_number": "२-१००-५", "content_sanskrit": "चिरस्य बत पश्यामि दूराद्भरतमागतम् ।\nदुष्प्रतीकमरण्ये ऽस्मिन् किं तात वनमागत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000177005, "chapter_id": 9177, "verse_number": "२-१००-६", "content_sanskrit": "कच्चिद्धारयते तात राजा यत्त्वमिहागत: ।\nकच्चिन्न दीन: सहसा राजा लोकान्तरं गत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000177006, "chapter_id": 9177, "verse_number": "२-१००-७", "content_sanskrit": "कच्चित् सौम्य न ते राज्यं भ्रष्टं बालस्य शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000177007, "chapter_id": 9177, "verse_number": "२-१००-८", "content_sanskrit": "कच्चिच्छुश्रूषसे तात पितरं सत्यविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000177008, "chapter_id": 9177, "verse_number": "२-१००-९", "content_sanskrit": "कच्चिद्दशरथो राजा कुशली सत्यसङ्गर: ।\nराजसूयाश्वमेधानामाहर्त्ता धर्मनिश्चय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000177009, "chapter_id": 9177, "verse_number": "२-१००-१०", "content_sanskrit": "स कच्चिद् ब्राह्मणो विद्वान् धर्मनित्यो महाद्युति: ।\nइक्ष्वाकूणामुपाध्यायो यथावत्तात पूज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000177010, "chapter_id": 9177, "verse_number": "२-१००-११", "content_sanskrit": "सा तात कच्चित्कौसल्या सुमित्रा च प्रजावती ।\nसुखिनी कच्चिदार्य्या च देवी नन्दति कैकयी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000177011, "chapter_id": 9177, "verse_number": "२-१००-१२", "content_sanskrit": "कच्चिद्विनयसम्पन्न: कुलपुत्रो बहुश्रुत: ।\nअनसूयुरनुद्रष्टा सत्कृतस्ते पुरोहित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000177012, "chapter_id": 9177, "verse_number": "२-१००-१३", "content_sanskrit": "कच्चिदग्निषु ते युक्तो विधिज्ञो मतिमानृजु: ।\nहुतं च होष्यमाणं च काले वेदयते सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000177013, "chapter_id": 9177, "verse_number": "२-१००-१४", "content_sanskrit": "कच्चिद्देवान् पितऽन् मातऽर्गुरून् पितृसमानपि ।\nवृद्धांश्च तत वैद्यांश्च ब्राह्मणांश्चाभिमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000177014, "chapter_id": 9177, "verse_number": "२-१००-१५", "content_sanskrit": "इष्वस्त्रवरसम्पन्नमर्थशास्त्रविशारदम् ।\nसुधन्वानमुपाध्यायं कच्चित्त्वं तात मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000177015, "chapter_id": 9177, "verse_number": "२-१००-१६", "content_sanskrit": "कच्चिदात्मसमा: शूरा: श्रुतवन्तो जितेन्द्रिया: ।\nकुलीनाश्चेङ्गितज्ञाश्च कृतास्ते तात मन्त्रिण: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000177016, "chapter_id": 9177, "verse_number": "२-१००-१७", "content_sanskrit": "मन्त्रो विजयमूलं हि राज्ञां भवति राघव ।\nसुसंवृतो मन्त्रधरैरमात्यै: शास्त्रकोविदै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000177017, "chapter_id": 9177, "verse_number": "२-१००-१८", "content_sanskrit": "कच्चिन्निद्रावशं नैषी: कच्चित्काले प्रबुध्यसे ।\nकच्चिच्चापररात्रेषु चिन्तयस्यर्थनैपुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000177018, "chapter_id": 9177, "verse_number": "२-१००-१९", "content_sanskrit": "कच्चिन्मन्त्रयसे नैक: कच्चिन्न बहुभि: सह ।\nकच्चित्ते मन्त्रितो मन्त्रो राष्ट्रं न परिधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000177019, "chapter_id": 9177, "verse_number": "२-१००-२०", "content_sanskrit": "कच्चिदर्थं विनिश्चित्य लघुमूलं महोदयम् ।\nक्षिप्रमारभसे कर्त्तुं न दीर्घयसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000177020, "chapter_id": 9177, "verse_number": "२-१००-२१", "content_sanskrit": "कच्चित्ते सुकृतान्येव कृतरूपाणि वा पुन: ।\nविदुस्ते सर्वकार्याणि न कर्त्तव्यानि पार्थिवा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000177021, "chapter_id": 9177, "verse_number": "२-१००-२२", "content_sanskrit": "कच्चिन्न तर्कैर्युक्त्या वा ये चाप्यपरिकीर्तिता: ।\nत्वया वा वा ऽमात्यैर्बुध्यते तात मन्त्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000177022, "chapter_id": 9177, "verse_number": "२-१००-२३", "content_sanskrit": "कच्चित् सहस्रान् मूर्खाणामेकमिच्छसि पण्डितम् ।\nपण्डितो ह्यर्थकृच्छ्रेषु कुर्य्यान्नि:श्रेयसं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000177023, "chapter_id": 9177, "verse_number": "२-१००-२४", "content_sanskrit": "सहस्राण्यपि मूर्खाणां यद्युपास्ते महीपति: ।\nअथवाप्ययुतान्येव नास्ति तेषु सहायता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000177024, "chapter_id": 9177, "verse_number": "२-१००-२५", "content_sanskrit": "एकोप्यमात्यो मेधावी शूरो दक्षो विचक्षण: ।\nराजानं राजमात्रं वा प्रापयेन्महतीं श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000177025, "chapter_id": 9177, "verse_number": "२-१००-२६", "content_sanskrit": "कच्चिन्मुख्या महत्स्वेव मध्यमेषु च मध्यमा: ।\nजघन्यास्तु जघन्येषु भृत्या: कर्मसु योजिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000177026, "chapter_id": 9177, "verse_number": "२-१००-२७", "content_sanskrit": "अमात्यानुपधातीतान् पितृपैतामहाञ्छुचीन् ।\nश्रेष्ठान् श्रेष्ठेषु कच्चित्त्वं नियोजयसि कर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000177027, "chapter_id": 9177, "verse_number": "२-१००-२८", "content_sanskrit": "कच्चिन्नोग्रेण दण्डेन भृशमुद्वेजितप्रजम् ।\nराष्ट्रं तवानुजानन्ति मन्त्रिण: कैकयीसुत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000177028, "chapter_id": 9177, "verse_number": "२-१००-२९", "content_sanskrit": "कच्चित्त्वां नावजानन्ति याजका: पतितं यथा ।\nउग्रप्रतिग्रहीतारं कामयानमिव स्त्रिय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000177029, "chapter_id": 9177, "verse_number": "२-१००-३०", "content_sanskrit": "उपायकुशलं वैद्यं भृत्यसन्दूषणे रतम् ।\nशूरमैश्वर्यकामं च यो न हन्ति स वध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000177030, "chapter_id": 9177, "verse_number": "२-१००-३१", "content_sanskrit": "कच्चिद्धृष्टश्च शूरश्च मतिमान् धृतिमाञ्छुचि: ।\nकुलीनश्चानुरक्तश्च दक्ष: सेनापति: कृत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000177031, "chapter_id": 9177, "verse_number": "२-१००-३२", "content_sanskrit": "बलवन्तश्च कच्चित्ते मुख्या युद्धविशारदा: ।\nदृष्टापदाना विक्रान्तास्त्वया सत्कृत्य मानिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000177032, "chapter_id": 9177, "verse_number": "२-१००-३३", "content_sanskrit": "कच्चिद्बलस्य भक्तं च वेतनं च यथोचितम् ।\nसम्प्राप्तकालं दातव्यं ददासि न विलम्बसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000177033, "chapter_id": 9177, "verse_number": "२-१००-३४", "content_sanskrit": "कालातिक्रमणाच्चैव भक्तवेतनयोर्भृता: ।\nभर्त्तु: कुप्यन्ति दुष्यन्ति सो ऽनर्थ: सुमहान् स्मृत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000177034, "chapter_id": 9177, "verse_number": "२-१००-३५", "content_sanskrit": "कच्चित् सर्वे ऽनुरक्तास्त्वां कुलपुत्रा: प्रधानत: ।\nकच्चित्प्राणांस्तवार्थेषु सन्त्यजन्ति समाहिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000177035, "chapter_id": 9177, "verse_number": "२-१००-३६", "content_sanskrit": "कच्चिज्जानपदो विद्वान् दक्षिण: प्रतिभानवान् ।\nयथोक्तवादी दूतस्ते कृतो भरत पण्डित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000177036, "chapter_id": 9177, "verse_number": "२-१००-३७", "content_sanskrit": "कच्चिदष्टादशान्येषु स्वपक्षे दश पञ्च च ।\nत्रिभिस्त्रिभिरविज्ञातैर्वेत्सि तीर्थानि चारकै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000177037, "chapter_id": 9177, "verse_number": "२-१००-३८", "content_sanskrit": "कच्चिद्व्यपास्तानहितान् प्रतियातांश्च सर्वदा ।\nदुर्बलाननवज्ञाय वर्त्तसे रिपुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000177038, "chapter_id": 9177, "verse_number": "२-१००-३९", "content_sanskrit": "कच्चिन्न लोकायतिकान् ब्राह्मणांस्तात सेवसे ।\nअनर्थकुशला ह्येते बाला: पण्डितमानिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000177039, "chapter_id": 9177, "verse_number": "२-१००-४०", "content_sanskrit": "धर्मशास्त्रेषु मुख्येषु विद्यमानेषु दुर्बुधा: ।\nबुद्धिमान्वीक्षिकीं प्राप्य निरर्थं प्रवदन्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000177040, "chapter_id": 9177, "verse_number": "२-१००-४१", "content_sanskrit": "वीरैरध्युषितां पूर्वमस्माकं तात पूर्वकै: ।\nसत्यनामां दृढद्वारां हस्त्यश्वरथसङ्कुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000177041, "chapter_id": 9177, "verse_number": "२-१००-४२", "content_sanskrit": "ब्राह्मणै: क्षत्ऺित्रयैर्वैश्यै: स्वकर्मनिरतै: सदा ।\nजितेन्द्रियैर्महोत्साहैर्वृतामार्यै: सहस्रश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000177042, "chapter_id": 9177, "verse_number": "२-१००-४३", "content_sanskrit": "प्रासादैर्विविधाकारैर्वृतां वैद्यजनाकुलाम् ।\nकच्चित्सुमुदितां स्फीतामयोध्यां परिरक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000177043, "chapter_id": 9177, "verse_number": "२-१००-४४", "content_sanskrit": "कच्चिच्चित्यशतैर्जुष्ट: सुनिविष्टजनाकुल: ।\nदेवस्थानै: प्रपाभिश्च तटाकैश्चोपशोभित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000177044, "chapter_id": 9177, "verse_number": "२-१००-४५", "content_sanskrit": "प्रहृष्टनरनारीक: समाजोत्सवशोभित: ।\nसुकृष्टसीमा पशुमान् हिंसाभि: परिवर्जित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000177045, "chapter_id": 9177, "verse_number": "२-१००-४६", "content_sanskrit": "अदेवमातृको रम्य: श्वापदै: परिवर्जित: ।\nपरित्यक्तो भयै: सर्वै: खनिभिश्चोपशोभित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000177046, "chapter_id": 9177, "verse_number": "२-१००-४७", "content_sanskrit": "विवर्जितो नरै: पापैर्मम पूर्वै: सुरक्षित: ।\nकच्चिज्जनपद: स्फीत: सुखं वसति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000177047, "chapter_id": 9177, "verse_number": "२-१००-४८", "content_sanskrit": "कच्चित्ते दयिता: सर्वे कृषिगोरक्षजीविन: ।\nवार्त्तायां संश्रितस्तात लोको हि सुखमेधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000177048, "chapter_id": 9177, "verse_number": "२-१००-४९", "content_sanskrit": "तेषां गुप्तिपरीहारै: कच्चित्ते भरणं कृतम् ।\nरक्ष्या हि राज्ञा धर्मेण सर्वे विषयवासिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000177049, "chapter_id": 9177, "verse_number": "२-१००-५०", "content_sanskrit": "कच्चित् स्त्रिय: सान्त्वयसि कच्चित्ताश्च सुरक्षिता: ।\nकच्चिन्न श्रद्दधास्यासां कच्चिद् गुह्यं न भाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000177050, "chapter_id": 9177, "verse_number": "२-१००-५१", "content_sanskrit": "कच्चिन्नागवनं गुप्तं कच्चित्ते सन्ति धेनुका: ।\nकच्चिन्न गणिकाश्वानां कुञ्जराणां च तृप्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000177051, "chapter_id": 9177, "verse_number": "२-१००-५२", "content_sanskrit": "कच्चिद्दर्शयसे नित्यं मनुष्याणां विभूषितम् ।\nउत्थायोत्थाय पूर्वाह्णे राजपुत्र महापथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000177052, "chapter_id": 9177, "verse_number": "२-१००-५३", "content_sanskrit": "कच्चिन्न सर्वे कर्मान्ता: प्रत्यक्षास्ते ऽविशङ्कया ।\nसर्वे वा पुनरुत्सृष्टा मध्यमेवात्र कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000177053, "chapter_id": 9177, "verse_number": "२-१००-५४", "content_sanskrit": "कच्चित् सर्वाणि दुर्गाणि धनधान्यायुधोदकै: ।\nयन्त्रैश्च परिपूर्णानि तथा शिल्पिधनुर्द्धरै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000177054, "chapter_id": 9177, "verse_number": "२-१००-५५", "content_sanskrit": "आयस्ते विपुल: कच्चित् कच्चिदल्पतरो व्यय: ।\nअपात्रेषु न ते कच्चित्कोशो गच्छति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000177055, "chapter_id": 9177, "verse_number": "२-१००-५६", "content_sanskrit": "देवतार्थे च पित्रर्थे ब्राह्मणाभ्यागतेषु च ।\nयोधेषु मित्रवर्गेषु कच्चिद्गच्छति ते व्यय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000177056, "chapter_id": 9177, "verse_number": "२-१००-५७", "content_sanskrit": "कच्चिदार्य्यो विशुद्धात्मा ऽ ऽक्षारितश्चोरकर्मणा ।\nअपृष्ट: शास्त्रकुशलैर्न लोभाद्वध्यते शुचि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000177057, "chapter_id": 9177, "verse_number": "२-१००-५८", "content_sanskrit": "गृहीतश्चैव पृष्टश्च काले दृष्ट: सकारण: ।\nकच्चिन्न मुच्यते चोरो धनलोभान्नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000177058, "chapter_id": 9177, "verse_number": "२-१००-५९", "content_sanskrit": "व्यसने कच्चिदाढ्यस्य दुर्गतस्य च राघव ।\nअर्थं विरागा: पश्यन्ति तवामात्या बहुश्रुता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000177059, "chapter_id": 9177, "verse_number": "२-१००-६०", "content_sanskrit": "यानि मिथ्याभिशस्तानां पतन्त्यस्राणि राघव ।\nतानि पुत्रपशून् घ्नन्ति प्रीत्यर्थमनुशासत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000177060, "chapter_id": 9177, "verse_number": "२-१००-६१", "content_sanskrit": "कच्चिद् वृद्धांश्च बालांश्च वैद्यमुख्यांश्च राघव ।\nदानेन मनसा वाचा त्रिभिरेतैर्बुभूषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000177061, "chapter_id": 9177, "verse_number": "२-१००-६२", "content_sanskrit": "कच्चिद्गुरूंश्च वृद्धांश्च तापसान् देवतातिथीन् ।\nचैत्यांश्च सर्वान् सिद्धार्थान् ब्राह्मणांश्च नमस्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000177062, "chapter_id": 9177, "verse_number": "२-१००-६३", "content_sanskrit": "कच्चिदर्थेन वा धर्ममर्थं धर्मेण वा पुन: ।\nउभौ वा प्रीतिलोभेन कामेन च न बाधसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000177063, "chapter_id": 9177, "verse_number": "२-१००-६४", "content_sanskrit": "कच्चिदर्थं च धर्मं च कामं च जयतां वर ।\nविभज्य काले कालज्ञ सर्वान् वरद सेवसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000177064, "chapter_id": 9177, "verse_number": "२-१००-६५", "content_sanskrit": "कच्चित्ते ब्राह्मणा: शर्म सर्वशास्त्रार्थकोविदा: ।\nआशंसन्ते महाप्राज्ञ पौरजानपदै: सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000177065, "chapter_id": 9177, "verse_number": "२-१००-६६", "content_sanskrit": "नास्तिक्यमनृतं क्रोधं प्रमादं दीर्घसूत्रताम् ।\nअदर्शनं ज्ञानवतामालस्यं पञ्चवृत्तिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000177066, "chapter_id": 9177, "verse_number": "२-१००-६७", "content_sanskrit": "एकचिन्तनमर्थानामनर्थज्ञैश्च मन्त्रणम् ।\nनिश्चितानामनारम्भं मन्त्रस्यापरिरक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000177067, "chapter_id": 9177, "verse_number": "२-१००-६८", "content_sanskrit": "मङ्गलस्याप्रयोगं च प्रत्युत्थानं च सर्वत: ।\nकच्चित्त्वं वर्जयस्येतान् राजदोषांश्चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000177068, "chapter_id": 9177, "verse_number": "२-१००-६९", "content_sanskrit": "दश पञ्च चतुर्वर्गान् सप्तवर्गं च तत्त्वत: ।\nअष्टवर्गं त्रिवर्गं च विद्यास्तिस्रश्च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000177069, "chapter_id": 9177, "verse_number": "२-१००-७०", "content_sanskrit": "इन्द्रियाणां जयं बुद्ध्वा षाङ्गुण्यं दैवमानुषम् ।\nकृत्यं विंशतिवर्गञ्च तथा प्रकृतिमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000177070, "chapter_id": 9177, "verse_number": "२-१००-७१", "content_sanskrit": "यात्रादण्डविधानञ्च द्वियोनी सन्धिविग्रहौ ।\nकच्चिदेतान् महाप्राज्ञ यथावदनुमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000177071, "chapter_id": 9177, "verse_number": "२-१००-७२", "content_sanskrit": "मन्त्रिभिस्त्वं यथोद्दिष्टैश्चतुर्भिस्त्रिभिरेव वा ।\nकच्चित् समस्तैर्व्यस्तैश्च मन्त्र मन्त्रयसे मिथ: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000177072, "chapter_id": 9177, "verse_number": "२-१००-७३", "content_sanskrit": "कच्चित्ते सफला वेदा: कच्चित्ते सफला: क्रिया: ।\nकच्चित्ते सफला दारा: कच्चित्ते सफलं श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000177073, "chapter_id": 9177, "verse_number": "२-१००-७४", "content_sanskrit": "कच्चिदेषैव ते बुद्धिर्यथोक्ता मम राघव ।\nआयुष्या च यशस्या च धर्मकामार्थसंहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000177074, "chapter_id": 9177, "verse_number": "२-१००-७५", "content_sanskrit": "यां वृत्तिं वर्त्तते तातो यां च न: प्रपितामहा: ।\nतां वृत्तिं वर्त्तसे कच्चिद्या च सत्पथगा शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000177075, "chapter_id": 9177, "verse_number": "२-१००-७६", "content_sanskrit": "कच्चित् स्वादु कृतं भोज्यमेको नाश्नासि राघव ।\nकच्चिदाशंसमानेभ्यो मित्रेभ्य: सम्प्रयच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000177076, "chapter_id": 9177, "verse_number": "२-१००-७७", "content_sanskrit": "राजा तु धर्मेण हि पालयित्वा महामतिर्दण्डधर: प्रजानाम् ।\nअवाप्य कृत्स्नां वसुधां यथावदितश्च्युत: स्वर्गमुपैति विद्वान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000177077, "chapter_id": 9177, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे शततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]