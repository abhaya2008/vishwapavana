[{"id": 2131957, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131958, "chapter_id": 3853, "verse_number": "१", "content_sanskrit": "श्रुत्वा स राजा राजर्षिरिन्द्रद्युम्नस्य तत् तदा ।\nमार्कण्डेयात् महाभागात् स्वर्गस्य प्रतिपादनम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131959, "chapter_id": 3853, "verse_number": "२", "content_sanskrit": "युधिष्ठिरो महाराज पुनः पप्रच्छ तं मुनिम् ।\nकीदृशीषु ह्यवस्थासु दत्त्वा दानं महामुने ।\nइन्द्रलोकं त्वनुभवेत् पुरुषस्तद् ब्रवीहि मे \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131960, "chapter_id": 3853, "verse_number": "३", "content_sanskrit": "गार्हस्थ्येऽप्यथवा बाल्ये यौवने स्थाविरेऽपि वा ।\nयथा फलं समश्नाति तथा त्वं कथयस्व मे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131961, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131962, "chapter_id": 3853, "verse_number": "४", "content_sanskrit": "वृथा जन्मानि चत्वारि वृथा दानानि षोडश ।\nवृथा जन्म ह्यपुत्रस्य ये च धर्मबहिष्कृताः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131963, "chapter_id": 3853, "verse_number": "५", "content_sanskrit": "परपाकं च येऽश्नन्ति आत्मार्थं च पचेत् तु यः ।\nपर्यश्नन्ति वृथा यत्र तदसत्यं प्रकीर्त्यते \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131964, "chapter_id": 3853, "verse_number": "६", "content_sanskrit": "आरूढपतिते दत्तमन्यायोपहृतं च यत् ।\nव्यर्थं तु पतिते दानं ब्राह्मणे तस्करे तथा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131965, "chapter_id": 3853, "verse_number": "७", "content_sanskrit": "गुरौ चानृतिके पापे कृतघ्ने ग्रामयाजके ।\nवेदविक्रयिणे दत्तं तथा वृषलयाजके \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131966, "chapter_id": 3853, "verse_number": "८", "content_sanskrit": "ब्रह्मबन्धुषु यद् दत्तं यद् दत्तं वृषलीपतौ ।\nस्त्रीजितेषु च यद् दत्तं व्यालग्राहे तथैव च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131967, "chapter_id": 3853, "verse_number": "९", "content_sanskrit": "परिचारिकेषु यद् दत्तं वृथा दानानि षोडश ।\nतमोवृतस्तु यो दद्याद् भयात् क्रोधात् तथैव च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131968, "chapter_id": 3853, "verse_number": "१०", "content_sanskrit": "भुङ्क्ते च दानं तत्सर्वं गर्भस्थस्तु नरः सदा ।\nददद् दानं द्विजातिभ्यो वृद्धभावेन मानवः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131969, "chapter_id": 3853, "verse_number": "११", "content_sanskrit": "तस्मात् सर्वास्ववस्थासु सर्वदानानि पार्थिव ।\nदातव्यानि द्विजातिभ्यः स्वर्गमार्गजिगीषया \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131970, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131971, "chapter_id": 3853, "verse_number": "१२", "content_sanskrit": "चातुर्वर्ण्यस्य सर्वस्य वर्तमानाः प्रतिग्रहे ।\nकेन विप्रा विशेषेण तारयन्ति तरन्ति च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131972, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131973, "chapter_id": 3853, "verse_number": "१३", "content_sanskrit": "जपैर्मन्त्रैश्च होमैश्च स्वाध्यायाध्यायनेन च ।\nनावं वेदमयीं कृत्वा तारयन्ति तरन्ति च \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131974, "chapter_id": 3853, "verse_number": "१४", "content_sanskrit": "ब्राह्मणांस्तोषयेद् यस्तु तुष्यन्ते तस्य देवताः ।\nवचनाच्चापि विप्राणां स्वर्गलोकमवाप्नुयात्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131975, "chapter_id": 3853, "verse_number": "१५", "content_sanskrit": "पितृदैवतपूजाभिर्ब्राह्मणाभ्यर्चनेन च ।\nअनन्तं पुण्यलोकं तु गन्ताऽसौ तु न संशयः ।\nश्लेष्मादिभिर्व्याप्ततनुर्म्रियमाणोऽविचेतनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131976, "chapter_id": 3853, "verse_number": "१६", "content_sanskrit": "ब्राह्मणा एव सम्पूज्याः पुण्यं स्वर्गमभीप्सया ।\nश्राद्धकाले तु यत्नेन भोक्तव्या ह्यजुगुप्सिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131977, "chapter_id": 3853, "verse_number": "१७", "content_sanskrit": "दुर्बलः कुनखी कुष्ठी मायावी कुण्डगोलकौ ।\nवर्जनीयाः प्रयत्नेन काण्डपृष्ठाश्च देहिनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131978, "chapter_id": 3853, "verse_number": "१८", "content_sanskrit": "जुगुप्सितं हि यच्छ्राद्धं दहत्यग्निरिवेन्धनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131979, "chapter_id": 3853, "verse_number": "१९", "content_sanskrit": "ये ये श्राद्धे न पूज्यन्ते मूकान्धबधिरादयः ।\nतेऽपि सर्वे नियोक्तव्या मिश्रिता वेदपारगैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131980, "chapter_id": 3853, "verse_number": "२०", "content_sanskrit": "प्रतिग्रहश्च वै देयः शृणु यस्य युधिष्ठिर ।\nप्रदातारं तथाऽऽत्मानं यस्तारयति शक्तिमान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131981, "chapter_id": 3853, "verse_number": "२१", "content_sanskrit": "तस्मिन् देयं द्विजे दानं सर्वागमविजानता ।\nप्रदातारं तथाऽऽत्मानं तारयेद् यः स शक्तिमान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131982, "chapter_id": 3853, "verse_number": "२२", "content_sanskrit": "न यथा हविषो होमैर्न पुष्पैर्नानुलेपनैः ।\nअग्नयः पार्थ तुष्यन्ति यथा ह्यतिथिभोजने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131983, "chapter_id": 3853, "verse_number": "२३", "content_sanskrit": "तस्मात् त्वं सर्वयत्नेन यतस्वातिथिभोजने\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131984, "chapter_id": 3853, "verse_number": "२४", "content_sanskrit": "पादोदकं पादघृतं दीपमन्नं प्रतिश्रयम् ।\nप्रयच्छन्ति तु ये राजन् नोपसर्पन्ति ते यमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131985, "chapter_id": 3853, "verse_number": "२५", "content_sanskrit": "देवमाल्यापनयनं द्विजोच्छिष्टावमार्जनम् ।\nआकल्पपरिचर्या च गात्रसंवहनानि च ।\nअत्रैकैकं नृपश्रेष्ठ गोदानाद् व्यतिरिच्यते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131986, "chapter_id": 3853, "verse_number": "२६", "content_sanskrit": "कपिलायाः प्रदानात् तु मुच्यते नात्र संशयः ।\nतस्मादलङ्कृतां दद्यात् कपिलां तु द्विजातये\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131987, "chapter_id": 3853, "verse_number": "२७", "content_sanskrit": "श्रोत्रियाय दरिद्राय गृहस्थायाग्निहोत्रिणे ।\nपुत्रदाराभिभूताय तथा ह्यनुपकारिणे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131988, "chapter_id": 3853, "verse_number": "२८", "content_sanskrit": "एवंविधेषु दातव्या न समृद्धेषु भारत ।\nको गुणो भरतश्रेष्ठ समृद्धेष्वभिवर्जितम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131989, "chapter_id": 3853, "verse_number": "२९", "content_sanskrit": "एकस्यैका प्रदातव्या न बहूनां कदाचन ।\nसा गौर्विक्रयमापन्ना हन्यात् त्रिपुरुषं कुलम् ।\nन तारयति दातारं ब्राह्मणं नैव नैव तु\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131990, "chapter_id": 3853, "verse_number": "३०", "content_sanskrit": "ब्राह्मणस्य विशुद्धस्य सुवर्णं यः प्रयच्छति ।\nसुवर्णानां शतं तेन दत्तं भवति शाश्वतम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131991, "chapter_id": 3853, "verse_number": "३१", "content_sanskrit": "अनड्वाहं तु यो दद्याद् बलवन्तं धुरन्धरम् ।\nस निस्तरति दुर्गाणि स्वर्गलोकं च गच्छति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131992, "chapter_id": 3853, "verse_number": "३२", "content_sanskrit": "वसुन्धरां तु यो दद्याद् द्विजाय विदुषात्मने ।\nदातारं ह्यनुगच्छन्ति सर्वे कामाभिवाञ्छिताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131993, "chapter_id": 3853, "verse_number": "३३", "content_sanskrit": "पृच्छन्ति चान्नदातारं वदन्ति पुरुषा भुवि ।\nअध्वनि क्षीणगात्राश्च पांसुना चावकुण्ठिताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131994, "chapter_id": 3853, "verse_number": "३४", "content_sanskrit": "तेषामेव श्रमार्तानां यो ह्यन्नं कथयेद् बुधः ।\nअन्नदातृसमः सोऽपि कीर्त्यते नात्र संशयः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131995, "chapter_id": 3853, "verse_number": "३५", "content_sanskrit": "तस्मात् त्वं सर्वदानानि हित्वाऽन्नं सम्प्रयच्छ ह ।\nन हीदृशं पुण्यफलं विचित्रमिह विद्यते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131996, "chapter_id": 3853, "verse_number": "३६", "content_sanskrit": "यथाशक्ति च यो दद्यादन्नं विप्रेषु संस्कृतम् ।\nस तेन कर्मणाऽऽप्नोति प्रजापतिसलोकताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131997, "chapter_id": 3853, "verse_number": "३७", "content_sanskrit": "अन्नमेव विशिष्टं हि तस्मात् परतरं न च ।\nअन्नं प्रजापतिश्चोक्तः स च संवत्सरो मतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131998, "chapter_id": 3853, "verse_number": "३८", "content_sanskrit": "संवत्सरस्तु यज्ञोऽसौ सर्वं यज्ञे प्रतिष्ठितम् ।\nतस्मात् सर्वाणि भूतानि स्थावराणि चराणि च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131999, "chapter_id": 3853, "verse_number": "३९", "content_sanskrit": "तस्मादन्नं विशिष्टं हि सर्वेभ्य इति विश्रुतम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2132000, "chapter_id": 3853, "verse_number": "४०", "content_sanskrit": "येषां तटाकानि महोदकानि\nवाप्यश्च कूपाश्च प्रतिश्रयाच्च ।\nअन्नस्य दानं मधुरा च वाणी\nयमस्य ते निर्वचना भवन्ति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2132001, "chapter_id": 3853, "verse_number": "४१", "content_sanskrit": "धान्यं श्रमेणार्जितवित्तसञ्चितं\nविप्रे सुशीले प्रतियच्छते यः ।\nवसुन्धरा तस्य भवेत् सुतुष्टा\nधारां वसूनां प्रतिमुञ्चतीव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2132002, "chapter_id": 3853, "verse_number": "४२", "content_sanskrit": "अन्नदाः प्रथमं यान्ति सत्यवाक् तदनन्तरम् ।\nअयाचितप्रदाता च समं यान्ति त्रयो जनाः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2132003, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2132004, "chapter_id": 3853, "verse_number": "४३", "content_sanskrit": "कौतूहलसमुत्पन्नः पर्यपृच्छद् युधिष्ठिरः ।\nमार्कण्डेयं महात्मानं पुनरेव सहानुजः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2132005, "chapter_id": 3853, "verse_number": "४४", "content_sanskrit": "यमलोकस्य चाध्वानमन्तरं मानुषस्य च ।\nकीदृशं किं प्रमाणं वा कथं वा तन्महामुने ।\nतरन्ति पुरुषाश्चैव केनोपायेन शंस मे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2132006, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2132007, "chapter_id": 3853, "verse_number": "४५", "content_sanskrit": "सर्वगुह्यतमं प्रश्नं पवित्रमृषिसंस्तुतम् ।\nकथयिष्यामि ते राजन् धर्मं धर्मभृतांवर\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2132008, "chapter_id": 3853, "verse_number": "४६", "content_sanskrit": "षडशीतिसहस्राणि योजनानां नराधिप ।\nयमलोकस्य चाध्वानमन्तरं मानुषस्य च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2132009, "chapter_id": 3853, "verse_number": "४७", "content_sanskrit": "आकाशं तदपानीयं घोरं कान्तारदर्शनम् ।\nन तत्र वृक्षच्छाया वा पानीनं केतनानि च\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2132010, "chapter_id": 3853, "verse_number": "४८", "content_sanskrit": "विश्रमेद् यत्र वै श्रान्तः पुरुषोऽध्वनि कर्शितः ।\nनीयते यमदूतैस्तु यमस्याज्ञाकरैर्बलात्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2132011, "chapter_id": 3853, "verse_number": "४९", "content_sanskrit": "नराः स्त्रियस्तथैवान्ये पृथिव्यां जीवसञ्ज्ञिताः ।\nब्राह्मणेभ्यः प्रदानानि नानारूपाणि पार्थिव\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2132012, "chapter_id": 3853, "verse_number": "५०", "content_sanskrit": "हयादीनां प्रकृष्टानि तेऽध्वानं यान्ति वै नराः ।\nसन्निवार्यातपं यान्ति च्छत्रेणैव हि च्छत्रदाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2132013, "chapter_id": 3853, "verse_number": "५१", "content_sanskrit": "तृप्ताश्चैवान्नदातारो ह्यतृप्ताश्चाप्यनन्नदाः ।\nवस्त्रिणो वस्त्रदा यान्ति अवस्त्रा यान्त्यवस्त्रदाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2132014, "chapter_id": 3853, "verse_number": "५२", "content_sanskrit": "हिरण्यदाः सुखं यान्ति पुरुषास्त्वभ्यलङ्कृताः ।\nभूमिदास्तु सुखं यान्ति सर्वैः कामैः सुतर्पिताः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2132015, "chapter_id": 3853, "verse_number": "५३", "content_sanskrit": "यान्ति चैवापरिक्लिष्टा नराः सस्यप्रदायकाः ।\nनराः सुखतरं यान्ति विमानेषु गृहप्रदाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2132016, "chapter_id": 3853, "verse_number": "५४", "content_sanskrit": "पानीयदा ह्यतृषिताः प्रहृष्टमनसो नराः ।\nपन्थानं द्योतयन्तश्च यान्ति दीपप्रदाः सुखम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2132017, "chapter_id": 3853, "verse_number": "५५", "content_sanskrit": "गोप्रदास्तु सुखं यान्ति निर्मुक्ताः सर्वपातकैः ।\nविमानैर्हंससंयुक्तैर्यान्ति मासोपवासिनः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2132018, "chapter_id": 3853, "verse_number": "५६", "content_sanskrit": "तथा बर्हिप्रयुक्तैश्च षष्ठरात्रोपवासिनः ।\nत्रिरात्रं क्षपते यस्तु एकभ(भु)क्तेन पाण्डव\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2132019, "chapter_id": 3853, "verse_number": "५७", "content_sanskrit": "अन्तरा चैव नाश्नाति तस्य लोका ह्यनामयाः ।\nपानीयस्य गुणा दिव्याः प्रेतलोकसुखावहाः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2132020, "chapter_id": 3853, "verse_number": "५८", "content_sanskrit": "तत्र पुष्पोदका नाम नदी तेषां विधीयते ।\nशीतलं सलिलं तत्र पिबन्ति ह्यमृतोपमम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2132021, "chapter_id": 3853, "verse_number": "५९", "content_sanskrit": "ये च दुष्कृतकर्माणः पूयं तेषां विधीयते ।\nएवं नदी महाराज सर्वकामप्रदा हि सा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2132022, "chapter_id": 3853, "verse_number": "६०", "content_sanskrit": "तस्मात् त्वमपि राजेन्द्र पूजयैनान्यथाविधि ।\nअध्वनि क्षीणगात्रश्च पथि पांसुसमन्वितः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2132023, "chapter_id": 3853, "verse_number": "६१", "content_sanskrit": "पृच्छते ह्यन्नदातारं गृहमायाति चाशया ।\nतं पूजयाथ यत्नेन सोऽतिथिर्ब्राह्मणश्च सः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2132024, "chapter_id": 3853, "verse_number": "६२", "content_sanskrit": "तं यान्तमनुगच्छन्ति देवाः सर्वे सवासवाः ।\nतस्मिन् सम्पूजिते प्रीता निराशा यान्त्यपूजिते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2132025, "chapter_id": 3853, "verse_number": "६३", "content_sanskrit": "तस्मात् त्वमपि राजेन्द्र पूजयैनं यथाविधि ।\nएतत् ते शतशः प्रोक्तं किं भूयः श्रोतुमिच्छसि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2132026, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2132027, "chapter_id": 3853, "verse_number": "६४", "content_sanskrit": "पुनः पुनरहं श्रोतुं कथां धर्मसमाश्रयाम् ।\nपुण्यामिच्छामि धर्मज्ञ कथ्यमानां त्वया विभो\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2132028, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2132029, "chapter_id": 3853, "verse_number": "६५", "content_sanskrit": "धर्मान्तरं प्रति कथां कथ्यमानां मया नृप ।\nसर्वपापहरां नित्यं शृणुष्वावहितो मम\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2132030, "chapter_id": 3853, "verse_number": "६६", "content_sanskrit": "कपिलायां तु दत्तायां यत्फलं ज्येष्ठपुष्करे ।\nतत्फलं भरतश्रेष्ठ विप्राणां पादधावने\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2132031, "chapter_id": 3853, "verse_number": "६७", "content_sanskrit": "द्विजपादोदकक्लिन्ना यावत् तिष्ठति मेदिनी ।\nतावत् पुष्करपर्णेन पिबन्ति पितरो जलम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2132032, "chapter_id": 3853, "verse_number": "६८", "content_sanskrit": "स्वागतेनाग्नयस्तृप्ता आसनेन शतक्रतुः ।\nपितरः पादशौचेन अन्नाद्येन प्रजापतिः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2132033, "chapter_id": 3853, "verse_number": "६९", "content_sanskrit": "यावद् वत्सस्य पादौ द्वौ शिरश्चैव प्रदृश्यते ।\nतस्मिन् काले प्रदातव्या प्रयतेनान्तरात्मना\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2132034, "chapter_id": 3853, "verse_number": "७०", "content_sanskrit": "अन्तरिक्षगतो वत्सो यावद् योन्यां प्रदृश्यते ।\nतावद् गौः पृथिवी ज्ञेया यावद् गर्भं न मुञ्चति \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2132035, "chapter_id": 3853, "verse_number": "७१", "content_sanskrit": "यावन्ति तस्यां रोमाणि वत्सस्य च युधिष्ठिर ।\nतावद् युगसहस्राणि स्वर्गलोके महीयते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2132036, "chapter_id": 3853, "verse_number": "७२", "content_sanskrit": "सुवर्णनासां यः कृत्वा सखुरां कृष्णधेनुकाम् ।\nतिलैः प्रच्छादितां दद्यात् सर्वरत्नैरलङ्कृताम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2132037, "chapter_id": 3853, "verse_number": "७३", "content_sanskrit": "प्रतिग्रहं गृहीत्वा यः पुनर्ददाति साधवे ।\nफलानां फलमश्नाति तदा दत्त्वा च भारत\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2132038, "chapter_id": 3853, "verse_number": "७४", "content_sanskrit": "ससमुद्रगुहा तेन सशैलवनकानना ।\nचतुरन्ता भवेद् दत्ता पृथिवी नात्र संशयः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2132039, "chapter_id": 3853, "verse_number": "७५", "content_sanskrit": "अन्तर्जानुशयो यस्तु भुञ्जते सक्तभाजनः ।\nयो द्विजः शब्दरहितं संयन्तुस्तारणाय वै\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2132040, "chapter_id": 3853, "verse_number": "७६", "content_sanskrit": "ये पानीयानि ददति तथाऽन्ये ये द्विजातयः ।\nजपन्ति सहितां सम्यक् ते नित्यं तारणक्षमाः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2132041, "chapter_id": 3853, "verse_number": "७७", "content_sanskrit": "हव्यं कव्यं च यत् किञ्चित्सर्वं तच्छ्रोत्रियोऽर्हति ।\nदत्तं हि श्रोत्रिये साधौ ज्वलितेऽग्नौ यथा हुतम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2132042, "chapter_id": 3853, "verse_number": "७८", "content_sanskrit": "मन्युप्रहरणा विप्रा न विप्राः शस्त्रयोधिनः ।\nनिहन्युर्मन्युना विप्रा वज्रपाणिरिवासुरान्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2132043, "chapter_id": 3853, "verse_number": "७९", "content_sanskrit": "धर्माश्रितेयं तु कथा कथिता हि तवानघ ।\nयां श्रुत्वा मुनयः प्रीता नैमिशारण्यवासिनः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2132044, "chapter_id": 3853, "verse_number": "८०", "content_sanskrit": "वीतशोकभयक्रोधा विपाप्मानस्तथैव च ।\nश्रुत्वेमां तु कथां राजन् भवन्तीह तु मानवाः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2132045, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2132046, "chapter_id": 3853, "verse_number": "८१", "content_sanskrit": "किं तच्छौचं भवेद् येन विप्रः शुद्धः सदा भवेत् ।\nतदिच्छामि महाप्राज्ञ श्रोतुं धर्मभृतांवर\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2132047, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2132048, "chapter_id": 3853, "verse_number": "८२", "content_sanskrit": "वाक्शौचं कर्मशौचं च यच्च शौचं जलात्मकम् ।\nत्रिभिः शौचैरुपेतो यः स स्वर्गी नात्र संशयः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2132049, "chapter_id": 3853, "verse_number": "८३", "content_sanskrit": "सायं प्रातश्च सन्ध्यां यो ब्राह्मणोऽभ्युपसेवते ।\nप्रजपन् पावनीं देवीं गायत्रीं वेदमातरम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2132050, "chapter_id": 3853, "verse_number": "८४", "content_sanskrit": "स तया पावितो देव्या ब्राह्मणो नष्टकिल्बिषः ।\nन सीदेत् प्रतिगृह्णानो महीमपि ससागराम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2132051, "chapter_id": 3853, "verse_number": "८५", "content_sanskrit": "ये चास्य दारुणाः केचिद् ग्रहाः सूर्यादयो दिवि ।\nते चास्य सौम्या जायन्ते शिवाः शिवतराः सदा\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2132052, "chapter_id": 3853, "verse_number": "८६", "content_sanskrit": "सर्वे नानुगतं चैनं दारुणाः पिशिताशनाः ।\nघोररूपा महाकाया धर्षयन्ति द्विजोत्तमम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2132053, "chapter_id": 3853, "verse_number": "८७", "content_sanskrit": "नाध्यापनाद् याजनाद् वा अन्यायाद् वा प्रतिग्रहात् ।\nदोषो भवति विप्राणां ज्वलिताग्निसमा द्विजाः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2132054, "chapter_id": 3853, "verse_number": "८८", "content_sanskrit": "दुर्वेदा वा सुवेदा वा प्राकृताः संस्कृतास्तथा ।\nब्राह्मणा नावमन्तव्या भस्मच्छन्ना इवाग्नयः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2132055, "chapter_id": 3853, "verse_number": "८९", "content_sanskrit": "यथा श्मशाने दीप्तौजाः पावको नैव दुष्यति ।\nएवं विद्वानविद्वान् वा ब्राह्मणो दैवतं महत्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2132056, "chapter_id": 3853, "verse_number": "९०", "content_sanskrit": "प्राकारैश्च पुरद्वारैः प्रासादैश्च पृथग्विधैः ।\nनगराणि न शोभन्ते हीनानि ब्राह्मणोत्तमैः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2132057, "chapter_id": 3853, "verse_number": "९१", "content_sanskrit": "वेदाढ्या वृत्तसम्पन्ना ज्ञानवन्तस्तपस्विनः ।\nयत्र तिष्ठन्ति वै विप्रास्तन्नाम नगरं नृप\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2132058, "chapter_id": 3853, "verse_number": "९२", "content_sanskrit": "व्रजे वाऽप्यथवाऽरण्ये यत्र सन्ति बहुश्रुताः ।\nतत्तन्नगरमित्याहुः पार्थ तीर्थं च तद्भवेत्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2132059, "chapter_id": 3853, "verse_number": "९३", "content_sanskrit": "रक्षितारं च राजानं ब्राह्मणं च तपस्विनम् ।\nअभिगम्याभिपूज्याथ सद्यः पापात् प्रमुच्यते\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2132060, "chapter_id": 3853, "verse_number": "९४", "content_sanskrit": "पुण्यतीर्थाभिषेकं च पवित्राणां च कीर्तनम् ।\nसद्भिः सम्भाषणं चैव प्रशस्तं कीर्त्यते बुधैः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2132061, "chapter_id": 3853, "verse_number": "९५", "content_sanskrit": "साधुसङ्गमपूतेन वाक्सुभाषितवारिणा ।\nपवित्रीकृतमात्मानं सन्तो मन्यन्ति नित्यशः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2132062, "chapter_id": 3853, "verse_number": "९६", "content_sanskrit": "त्रिदण्डधारणं मौनं जटाभारोऽथ मुण्डनम् ।\nवल्कलाजिनसंवेष्टं व्रतचर्याऽभिषेचनम्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2132063, "chapter_id": 3853, "verse_number": "९७", "content_sanskrit": "अग्निहोत्रं वने वासः शरीरपरिशोषणम् ।\nसर्वाण्येतानि मिथ्या स्युर्यदि भावो न निर्मलः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2132064, "chapter_id": 3853, "verse_number": "९८", "content_sanskrit": "न दुष्करमनाशित्वं सुकरं ह्यशनं विना ।\nविशुद्धिं चक्षुरादीनां षण्णामिन्द्रियगामिनाम् ।\nविकारि तेषां राजेन्द्र सुदुष्करतरं मनः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2132065, "chapter_id": 3853, "verse_number": "९९", "content_sanskrit": "ये पापानि न कुर्वन्ति मनोवाक्कर्मबुद्धिभिः ।\nते तपन्ति महात्मानो न शरीरस्य शोषणम्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2132066, "chapter_id": 3853, "verse_number": "१००", "content_sanskrit": "न ज्ञातिभ्यो दया यस्य शुक्लदेहोऽविकल्मषः ।\nहिंसा सा तपसस्तस्य नानाशित्वं तपः स्मृतम्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2132067, "chapter_id": 3853, "verse_number": "१०१", "content_sanskrit": "तिष्ठन् गृहे चैव मुनिर्नित्यं शुचिरलङ्कृतः ।\nयावज्जीवं दयावांश्च सर्वपापैः प्रमुच्यते\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2132068, "chapter_id": 3853, "verse_number": "१०२", "content_sanskrit": "न हि पापानि कर्माणि शुद्ध्यन्त्यनशनादिभिः ।\nसीदत्यनशनादेव मांसशोणितलेपनः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2132069, "chapter_id": 3853, "verse_number": "१०३", "content_sanskrit": "अज्ञातं कर्म कृत्वा च क्लेशो नान्यत् प्रहीयते ।\nनाग्निर्दहति कर्माणि भावशून्यस्य देहिनः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2132070, "chapter_id": 3853, "verse_number": "१०४", "content_sanskrit": "पुण्यादेव प्रव्रजन्ति शुद्ध्यन्त्यनशनानि च ।\nन मूलफलभक्षित्वान्न मौनान्नानिलाशनात्\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2132071, "chapter_id": 3853, "verse_number": "१०५", "content_sanskrit": "शिरसो मुण्डनाद्वाऽपि न स्थानकुटिकासनात् ।\nन जटाधारणाद्वाऽपि न तु स्थण्डिलशय्यया\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2132072, "chapter_id": 3853, "verse_number": "१०६", "content_sanskrit": "नित्यं ह्यनशनाद्वाऽपि नाग्निशुश्रूषणादपि ।\nन चोदकप्रवेशेन न च क्ष्माशयनादपि\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2132073, "chapter_id": 3853, "verse_number": "१०७", "content_sanskrit": "ज्ञानेन कर्मणा वापि जरामरणमेव च ।\nव्याधयश्च प्रहीयन्ते प्राप्यते चोत्तमं पदम्\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2132074, "chapter_id": 3853, "verse_number": "१०८", "content_sanskrit": "बीजानि ह्यग्निदग्धानि न रोहन्ति पुनर्यथा ।\nज्ञानदग्धैस्तथा क्लेशैर्नात्मा संयुज्यते पुनः\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2132075, "chapter_id": 3853, "verse_number": "१०९", "content_sanskrit": "आत्मना विप्रहीणानि काष्ठकुड्योपमानि च ।\nविनश्यन्ति न सन्देहः फेनानीव महार्णवे\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2132076, "chapter_id": 3853, "verse_number": "११०", "content_sanskrit": "आत्मानं विन्दते येन सर्वभूतगुहाशयम् ।\nश्लोकेन यदि वाऽर्धेन क्षीणं तस्य प्रयोजनम्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2132077, "chapter_id": 3853, "verse_number": "१११", "content_sanskrit": "द्व्यक्षरादभिसन्धाय केचिच्छ्लोकपदाङ्कितैः ।\nशतैरन्यैः सहस्रैश्च प्रत्ययो मोक्षलक्षणम्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2132078, "chapter_id": 3853, "verse_number": "११२", "content_sanskrit": "नायं लोकोस्ति न परो न सुखं संशयात्मनः ।\nऊचुर्ज्ञानविदो वृद्धाः प्रत्ययो मोक्षलक्षणम्\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2132079, "chapter_id": 3853, "verse_number": "११३", "content_sanskrit": "विदितार्थस्तु वेदानां परिवेद प्रयोजनम् ।\nउद्विजेत् स तु देवेभ्यो दावाग्नेरिव मानवः\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2132080, "chapter_id": 3853, "verse_number": "११४", "content_sanskrit": "शुष्कं तर्कं परित्यज्य आश्रयस्व श्रुतिं स्मृतिम् ।\nएकाक्षराभिसम्बद्धं तत्त्वं हेतुभिरिच्छसि ।\nबुद्धिर्न तस्य सिद्ध्येत साधनस्य विपर्ययात्\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2132081, "chapter_id": 3853, "verse_number": "११५", "content_sanskrit": "वेद्यं पूर्वं वेदितव्यं प्रयत्नात्\nतद्धीर्वेदस्तस्य वेदः शरीरम् ।\nवेदतत्त्वं तत्समासोपलब्धिः\nक्लीबस्त्वात्मा न स वेद्यं न वेदः\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2132082, "chapter_id": 3853, "verse_number": "११६", "content_sanskrit": "वेदोक्तमायुर्देवानामाशिषश्चैव कर्मणाम् ।\nफलत्यनुयुगं लोके प्रभावश्च शरीरिणाम्\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2132083, "chapter_id": 3853, "verse_number": "११७", "content_sanskrit": "इन्द्रियाणां प्रसादेन तदेतत् परिवर्जयेत् ।\nतस्मादनशनं दिव्यं निरुद्धेन्द्रियगोचरम्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2132084, "chapter_id": 3853, "verse_number": "११८", "content_sanskrit": "तपसा स्वर्गगमनं भोगो दानेन जायते ।\nज्ञानेन मोक्षो विज्ञेयस्तीर्थस्नानादघक्षयः\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2132085, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2132086, "chapter_id": 3853, "verse_number": "११९", "content_sanskrit": "एवमुक्तस्तु राजेन्द्र प्रत्युवाच महायशाः ।\nभगवन् श्रोतुमिच्छामि प्रदानविधिमुत्तमम्\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2132087, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2132088, "chapter_id": 3853, "verse_number": "१२०", "content_sanskrit": "यत् तत्पृच्छसि राजेन्द्र दानधर्मं युधिष्ठिरः ।\nइष्टं चेदं सदा मह्यं राजन् गौरवतस्तथा\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2132089, "chapter_id": 3853, "verse_number": "१२१", "content_sanskrit": "शृणु दानरहस्यानि श्रुतिस्मृत्युदितानि च ।\nछायायां करिणः श्राद्धं तत्कर्म परिवीजितम् ।\nदशकल्पायुतानीह न क्षीयेत युधिष्ठिर\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2132090, "chapter_id": 3853, "verse_number": "१२२", "content_sanskrit": "जीवनाय समाक्लिन्नं वसु दत्त्वा महीपते ।\nविप्रं तु वासयेद् यस्तु सर्वयज्ञैः स इष्टवान्\t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2132091, "chapter_id": 3853, "verse_number": "१२३", "content_sanskrit": "प्रतिस्रोतश्चित्रवाहाः पर्जन्योऽन्नानुसञ्चरन् ।\nमहाधुरि यथा नावा महापापैः प्रमुच्यते ।\nविषुवे विप्रदत्तानि दधिमध्वक्षयाणि च\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2132092, "chapter_id": 3853, "verse_number": "१२४", "content_sanskrit": "पर्वसु द्विगुणं दानमृतौ दशगुणं भवेत् ।\nअब्दे दशगुणं प्रोक्तमनन्तं विषुवे भवेत्\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2132093, "chapter_id": 3853, "verse_number": "१२५", "content_sanskrit": "अयने विषुवे चैव षडशीतिमुखेषु च ।\nचन्द्रसूर्योपरागे च दत्तमक्षयमुच्यते\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2132094, "chapter_id": 3853, "verse_number": "१२६", "content_sanskrit": "ऋतुषु दशगुणं वदन्ति दत्तं\nशतगुणमृत्वयनादिषु ध्रुवम् ।\nभवति सहस्रगुणं दिनस्य राहो-\nर्विषुवति चाक्षयमश्नुते फलम्\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2132095, "chapter_id": 3853, "verse_number": "१२७", "content_sanskrit": "नाभूमिदो भूमिमश्नाति राजन्\nनायानदो यानमारुह्य याति\nयान्यान् कामान् ब्राह्मणेभ्यो ददाति\nतांस्तान् कामान् जायमानः स भुङ्क्ते\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2132096, "chapter_id": 3853, "verse_number": "१२८", "content_sanskrit": "अग्नेरपत्यं प्रथमं सुवर्णं\nभूर्वैष्णवी सूर्यसुताश्च गावः ।\nलोकास्त्रयस्तेन भवन्ति दत्ता\nयः काञ्चनं गाश्च महीं च दद्यात्\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2132097, "chapter_id": 3853, "verse_number": "१२९", "content_sanskrit": "परं हि दानान्न बभूव शाश्वतं\nभव्यं त्रिलोके भवते कुतः पुनः ।\nतस्मात् प्रधानं परमं हि दानं\nवदन्ति लोकेषु विशिष्टबुद्धयः\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2132098, "chapter_id": 3853, "verse_number": "२०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि पञ्चनवत्यधिकशततमोऽध्यायः ॥१९५॥\n॥ इति मार्कण्डेयसमास्यापर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2132099, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2132100, "chapter_id": 3853, "verse_number": "", "content_sanskrit": "॥ इति वनपर्वणि द्वितीयो भागः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}]