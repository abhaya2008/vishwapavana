[{"id": 7004315000, "chapter_id": 24315, "verse_number": "५-३-९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nपुनर्युगान्तं ते चान्यं सम्प्रवक्ष्यामि तच्छृणु ।\nसूर्यैरादीपिते लोके जङ्गमे स्थावरे पुरा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004315001, "chapter_id": 24315, "verse_number": "५-३-९-२", "content_sanskrit": "सरित्सरःसमुद्रेषु क्षयं यातेषु सर्वशः ।\nनिर्मानुषवषट्कारे ह्यमर्यादगतिं गते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004315002, "chapter_id": 24315, "verse_number": "५-३-९-३", "content_sanskrit": "नानारूपैस्ततो मेघैः शक्रायुधविराजितैः ।\nसर्वमापूरितं व्योम वार्यौघैः पूरिते तदा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004315003, "chapter_id": 24315, "verse_number": "५-३-९-४", "content_sanskrit": "ततस्त्वेकार्णवीभूते सर्वतः सलिलावृते ।\nजगत्कृत्वोदरे सर्वं सुष्वाप भगवान्हरः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004315004, "chapter_id": 24315, "verse_number": "५-३-९-५", "content_sanskrit": "प्रकृतिं स्वामवष्टभ्य योगात्मा स प्रजापतिः ।\nशेते युगसहस्रान्तं कालमाविश्य सार्णवम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004315005, "chapter_id": 24315, "verse_number": "५-३-९-६", "content_sanskrit": "तत्र सुप्तं महात्मानं ब्रह्मलोकनिवासिनः ।\nभृग्वादिऋषयः सर्वे ये चान्ये सनकादयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004315006, "chapter_id": 24315, "verse_number": "५-३-९-७", "content_sanskrit": "पर्यङ्के विमले शुभ्रे नानास्तरणसंस्तृते ।\nशयानं ददृशुर्देवं सपत्नीकं वृषध्वजम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004315007, "chapter_id": 24315, "verse_number": "५-३-९-८", "content_sanskrit": "विश्वरूपा तु सा नारी विश्वरूपो महेश्वरः ।\nगाढमालिङ्ग्य सुप्तस्तां ददृशे चाहमव्ययम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004315008, "chapter_id": 24315, "verse_number": "५-३-९-९", "content_sanskrit": "पादमूले ततस्तस्य श्यामां तां पद्मलक्षणाम् ।\nकन्यां पश्यामि सुश्रोणीं चरणौ तस्य मृद्गतीम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004315009, "chapter_id": 24315, "verse_number": "५-३-९-१०", "content_sanskrit": "विमलाम्बरसंवीतां व्यालयज्ञोपवीतिनीम् ।\nश्यामां कमलपत्राक्षीं सर्वाभरणभूषिताम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004315010, "chapter_id": 24315, "verse_number": "५-३-९-११", "content_sanskrit": "सकलं युगसाहस्रं नर्मदेयं विजानती ।\nप्रसुप्तं देवदेवेशमुपास्ते वरवर्णिनी॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004315011, "chapter_id": 24315, "verse_number": "५-३-९-१२", "content_sanskrit": "हृतैर्वेदैश्चतुर्भिश्च ब्रह्माप्येवं महेश्वरः ।\nभृग्वाद्यैर्मानसैः पुत्रैः स्तौति शङ्करमव्ययम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004315012, "chapter_id": 24315, "verse_number": "५-३-९-१३", "content_sanskrit": "भक्त्या परमया राजंस्तत्र शम्भुमनामयम् ।\nस्तुवन्तस्तत्र देवेशं मन्त्रैरीश्वरसम्भवैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004315013, "chapter_id": 24315, "verse_number": "५-३-९-१४", "content_sanskrit": "प्रसुप्तं देवमीशानं बोधयन्समुपस्थितः ।\nउत्तिष्ठ हर पिङ्गाक्ष महादेव महेश्वर॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004315014, "chapter_id": 24315, "verse_number": "५-३-९-१५", "content_sanskrit": "मम वेदा हृताः सर्वे अतोऽहं स्तोतुमुद्यतः ।\nवेदैर्व्याप्तं जगत्सर्वं दिव्यादिव्यं चराचरम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004315015, "chapter_id": 24315, "verse_number": "५-३-९-१६", "content_sanskrit": "अतीतं वर्तमानं च स्मरामि च सृजाम्यहम् ।\nतैर्विना चाहमेकस्तु मूकोऽधो जडवत्सदा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004315016, "chapter_id": 24315, "verse_number": "५-३-९-१७", "content_sanskrit": "गतिर्वीर्यं बलोत्साहौ तैर्विना न प्रजायते ।\nतैर्विना देवदेवेश नाहं किंचित्स्मरामि वै॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004315017, "chapter_id": 24315, "verse_number": "५-३-९-१८", "content_sanskrit": "तान्वेदान्देवदेवेश शीघ्रं मे दातुमर्हसि ।\nजडान्धबधिरं सर्वं जगत्स्थावरजङ्गमम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004315018, "chapter_id": 24315, "verse_number": "५-३-९-१९", "content_sanskrit": "स्थानादि दश चत्वारि न शोभन्ते सुरेश्वर ।\nप्रणमाम्यल्पवीर्यत्वाद्वेदहीनः सुरेश्वर॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004315019, "chapter_id": 24315, "verse_number": "५-३-९-२०", "content_sanskrit": "वेदेभ्यः सकलं जातं यत्किंचित्सचराचरम् ।\nतावच्छोभन्ति शास्त्राणि समस्तानि जगद्गुरो॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004315020, "chapter_id": 24315, "verse_number": "५-३-९-२१", "content_sanskrit": "यावद्वेदनिधिरयं नोपतिष्ठेत्सनातनः ।\nयथोदितेन सूर्येण तमो याति विनाशताम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004315021, "chapter_id": 24315, "verse_number": "५-३-९-२२", "content_sanskrit": "एवं समस्तपापानि यान्ति वेदस्य धारणात् ।\nवेदे रहसि यत्सूक्ष्मं यत्तद्ब्रह्म सनातनम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004315022, "chapter_id": 24315, "verse_number": "५-३-९-२३", "content_sanskrit": "हृदिस्थं देव जानामि गतं तद्वेदगर्जनात् ।\nवेदानुच्चरतो मेऽद्य तव शङ्कर चाग्रतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004315023, "chapter_id": 24315, "verse_number": "५-३-९-२४", "content_sanskrit": "अकस्मात्ते गता वेदा न सृजेयं विभो भुवम् ।\nतेऽपि सर्वे महादेव प्रविष्टाः सम्मुखार्णवम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004315024, "chapter_id": 24315, "verse_number": "५-३-९-२५", "content_sanskrit": "ते याच्यमाना देवेश तिष्ठन्तु स्मरणे मम ।\nदुहितेयं विशालाक्षी सर्वः सर्वं विजानते॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004315025, "chapter_id": 24315, "verse_number": "५-३-९-२६", "content_sanskrit": "जायती युगसाहस्रं नान्या काचिद्भवेदृशी ।\nऋषिश्चायं महाभागो मार्कण्डो धीमतां वरः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004315026, "chapter_id": 24315, "verse_number": "५-३-९-२७", "content_sanskrit": "कल्पे कल्पे महादेव त्वामयं पर्युपासते ।\nजगत्त्रयहितार्थाय चरते व्रतमुत्तमम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004315027, "chapter_id": 24315, "verse_number": "५-३-९-२८", "content_sanskrit": "एवमुक्तस्तु देवेशो ब्रह्मणा परमेष्ठिना ।\nउवाच श्लक्ष्णया वाचा नर्मदां सरितां वराम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004315028, "chapter_id": 24315, "verse_number": "५-३-९-२९", "content_sanskrit": "कथयस्व महाभागे ब्रह्मणस्त्वं तु पृच्छतः ।\nकेन वेदा हृताः सर्वे वेधसो जगतीगुरोः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004315029, "chapter_id": 24315, "verse_number": "५-३-९-३०", "content_sanskrit": "एवमुक्ता तु रुद्रेण उवाच मृगलोचना ।\nब्रह्मणो जपतो वेदांस्त्वयि सुप्ते महेश्वर॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004315030, "chapter_id": 24315, "verse_number": "५-३-९-३१", "content_sanskrit": "भवतश्छिद्रमासाद्य घोरेऽस्मिन्सलिलावृते ।\nपूर्वकल्पसमुद्भूतावसुरौ सुरदुर्जयौ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004315031, "chapter_id": 24315, "verse_number": "५-३-९-३२", "content_sanskrit": "श्रियावृत्तौ महादेव त्वया चोत्पादितौ पुरा ।\nसुरासुरसुदुर्जेयौ दानवौ मधुकैटभौ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004315032, "chapter_id": 24315, "verse_number": "५-३-९-३३", "content_sanskrit": "तौ वायुभूतौ सूक्ष्मौ च पठतोऽस्मात्पितामहात् ।\nतावाशु हृत्वा वेदांश्च प्रविष्टौ च महार्णवम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004315033, "chapter_id": 24315, "verse_number": "५-३-९-३४", "content_sanskrit": "एतच्छ्रुत्वा महातेजा ह्यमृतायास्ततो वचः ।\nसस्मार स च देवेशं शङ्खचक्रगदाधरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004315034, "chapter_id": 24315, "verse_number": "५-३-९-३५", "content_sanskrit": "स विवेश महाराज भूतलं ससुरोत्तमः ।\nदानवान्तकरो देवः सर्वदैवतपूजितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004315035, "chapter_id": 24315, "verse_number": "५-३-९-३६", "content_sanskrit": "मीनरूपधरो देवो लोडयामास चार्वणम् ।\nवेदांश्च ददृशे तत्र पाताले निहितान्प्रभुः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004315036, "chapter_id": 24315, "verse_number": "५-३-९-३७", "content_sanskrit": "तौ च दैत्यौ महावीर्यौ दृष्टवान्मधुसूदनः ।\nमहावेगौ महाबाहू सूदयामास तेजसा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004315037, "chapter_id": 24315, "verse_number": "५-३-९-३८", "content_sanskrit": "वेदांस्तत्रापि तोयस्थानानिनाय जगद्गुरुः ।\nचतुर्वक्त्राय देवायाददाच्चक्रविभूषितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004315038, "chapter_id": 24315, "verse_number": "५-३-९-३९", "content_sanskrit": "ततः प्रहृष्टो भगवान् वेदांल्लब्ध्वा पितामहः ।\nजनयामास निखिलं जगद्भूयश्चराचरम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004315039, "chapter_id": 24315, "verse_number": "५-३-९-४०", "content_sanskrit": "सा च देवी नदी पुण्या रुद्रस्य परिचारिका ।\nपावनी सर्वभूतानां प्रोवाह सलिलं तदा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004315040, "chapter_id": 24315, "verse_number": "५-३-९-४१", "content_sanskrit": "तस्यास्तीरे ततो देवा ऋषयश्च तपोधनाः ।\nयजन्ति त्र्यम्बकं देवं प्रहृष्टेनान्तरात्मना॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004315041, "chapter_id": 24315, "verse_number": "५-३-९-४२", "content_sanskrit": "एका मूर्तिर्महेशस्य कारणान्तरमागता ।\nत्रैगुण्या कुरुते कर्म ब्रह्मचक्रीशरूपतः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004315042, "chapter_id": 24315, "verse_number": "५-३-९-४३", "content_sanskrit": "एतेषां तु पृथग्भावं ये कुर्वन्ति सुमोहिताः ।\nतेषां धर्मः कुतः सिद्धिर्जायते पापकर्मिणाम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004315043, "chapter_id": 24315, "verse_number": "५-३-९-४४", "content_sanskrit": "एवमेता महानद्यस्तिस्रो रुद्रसमुद्भवाः ।\nएका एव त्रिधा भूता गङ्गा रेवा सरस्वती॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004315044, "chapter_id": 24315, "verse_number": "५-३-९-४५", "content_sanskrit": "गङ्गा तु वैष्णवी मूर्तिः सर्वपापप्रणाशिनी ।\nरुद्रदेहसमुद्भूता नर्मदा चैवमेव तु॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004315045, "chapter_id": 24315, "verse_number": "५-३-९-४६", "content_sanskrit": "ब्राह्मी सरस्वती मूर्तिस्त्रिषु लोकेषु विश्रुता ।\nदिव्या कामगमा देवी वाग्विभूत्यै तु संस्थिता॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004315046, "chapter_id": 24315, "verse_number": "५-३-९-४७", "content_sanskrit": "नर्मदा परमा काचिन्मर्त्यमूर्तिकला शिवा ।\nदिव्या कामगमा देवी सर्वत्र सुरपूजिता॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004315047, "chapter_id": 24315, "verse_number": "५-३-९-४८", "content_sanskrit": "व्यापिनी सर्वभूतानां सूक्ष्मात्सूक्ष्मतरा स्मृता ।\nअक्षया ह्यमृता ह्येषा स्वर्गसोपानमुत्तमा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004315048, "chapter_id": 24315, "verse_number": "५-३-९-४९", "content_sanskrit": "सृष्टा रुद्रेण लोकानां संसारार्णवतारिणी॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004315049, "chapter_id": 24315, "verse_number": "५-३-९-५०", "content_sanskrit": "सीरजलं येऽपि पिबन्ति लोके मुच्यन्ति ते पापविशेषसङ्घैः ।\nव्रजन्ति संसारमनादिभावं त्यक्त्वा चिरं मोक्षपदं विशुद्धम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004315050, "chapter_id": 24315, "verse_number": "५-३-९-५१", "content_sanskrit": "यथा गङ्गा तथा रेवा तथा चैव सरस्वती ।\nसमं पुण्यफलं प्रोक्तं स्नानदर्शनचिन्तनैः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004315051, "chapter_id": 24315, "verse_number": "५-३-९-५२", "content_sanskrit": "वरदानान्महाभागा ह्यधिका चोच्यते बुधैः ।\nकारुण्यान्तरभावेन न मृता समुपागता॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004315052, "chapter_id": 24315, "verse_number": "५-३-९-५३", "content_sanskrit": "मुच्यन्ते दर्शनात्तेन पातकैः स्नानमङ्गलैः ।\nनर्मदायां नृपश्रेष्ठ ये नमन्ति त्रिलोचनम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004315053, "chapter_id": 24315, "verse_number": "५-३-९-५४", "content_sanskrit": "उमारुद्राङ्गसम्भूता येन चैषा महानदी ।\nलोकान्प्रापयते स्वर्गं तेन पुण्यत्वमागता॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004315054, "chapter_id": 24315, "verse_number": "५-३-९-५५", "content_sanskrit": "य एवमीशानवरस्य देहं विभज्य देवीमिह संशृणोति ।\nस याति रुद्रं महतारवेण गन्धर्वयक्षैरिव गीयमानः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]