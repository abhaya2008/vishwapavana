[{"id": 2027627, "chapter_id": 1593, "verse_number": "३-२३१-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027628, "chapter_id": 1593, "verse_number": "३-२३१-१", "content_sanskrit": "यदा स्कन्देन मातृणामेवमेतत्प्रियं कृतम्।\nअथनैमब्रवीत्स्वाहा मम पुत्रस्त्वमौरसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027629, "chapter_id": 1593, "verse_number": "३-२३१-२", "content_sanskrit": "इच्छाम्यहं त्वया दत्तां प्रीतिं परमदुर्लभाम्।\nतामब्रवीत्ततः स्कन्दः प्रीतिमिच्छसि कीदृशीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027630, "chapter_id": 1593, "verse_number": "३-२३१-३x", "content_sanskrit": "स्वाहोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027631, "chapter_id": 1593, "verse_number": "३-२३१-३", "content_sanskrit": "दक्षस्याहं प्रिया कन्या स्वाहा नाम महाभुज।\nबाल्यात्प्रभृति नित्यं च जातकामा हुताशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027632, "chapter_id": 1593, "verse_number": "३-२३१-४", "content_sanskrit": "न स मां कामिनीं पुत्र सम्यग्जनाति पावकः।\nइच्छामि शाश्वतं वासं वस्तु पुत्र सहाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027633, "chapter_id": 1593, "verse_number": "३-२३१-५x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027634, "chapter_id": 1593, "verse_number": "३-२३१-५", "content_sanskrit": "हव्यं कव्यंच यत्किंचिद्द्विजा मन्त्रसुसंस्तुतम्।\nहोष्यन्त्यग्नौ सदा देवि स्वाहेत्युक्त्वासमुद्धृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027635, "chapter_id": 1593, "verse_number": "३-२३१-६", "content_sanskrit": "अद्यप्रभृति दास्यन्ति सुवृत्ताः सत्पथे स्थिताः।\nएवमग्निसत्वया सार्धं सदा वत्स्यति शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027636, "chapter_id": 1593, "verse_number": "३-२३१-७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027637, "chapter_id": 1593, "verse_number": "३-२३१-७", "content_sanskrit": "एवमुक्ता ततः स्वाहा तुष्टास्कन्देन पूजिता।\nपावकेन समायुक्ता भर्त्रा स्कन्दमपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027638, "chapter_id": 1593, "verse_number": "३-२३१-८", "content_sanskrit": "ततो ब्रह्मा महासेनं प्रजापतिरथाब्रवीत्।\nअभिगच्छ महादेवं पितरं त्रिपुरार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027639, "chapter_id": 1593, "verse_number": "३-२३१-९", "content_sanskrit": "रुद्रेणाग्निं समाविश्य स्वाहामाविश्य चोमया।\nहितर्थं सर्वलोकानां जातस्त्वमपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027640, "chapter_id": 1593, "verse_number": "३-२३१-१०", "content_sanskrit": "उमायोन्यां च रुद्रेण शुक्रं सिक्तं महात्मना।\nअस्मिन्गिरौ निपतितं मिञ्जिकमिञ्जिकं यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027641, "chapter_id": 1593, "verse_number": "३-२३१-११", "content_sanskrit": "`मिथुनं वै महाभाग तत्र तद्रुद्रसंभवम्।\nसंभूतं लोहितोदे तु शुक्रशेषमवापतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027642, "chapter_id": 1593, "verse_number": "३-२३१-१२", "content_sanskrit": "सूर्यरश्मिषु चाप्यनयदन्यच्चैवापतद्भुवि।\nआसक्तमन्यद्वृक्षेषु तदेवं प्चधाऽपतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027643, "chapter_id": 1593, "verse_number": "३-२३१-१३", "content_sanskrit": "तत्र ते विविधाकारा गणा ज्ञेया मनीषिभिः।\nतव पारिषदा घोरा य एते पिशिताशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027644, "chapter_id": 1593, "verse_number": "३-२३१-१४", "content_sanskrit": "एवमस्त्विति चाप्युक्त्वा महासेनो महेश्वरम्।\nअपूजयदमेयात्मा पितरं पितृवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027645, "chapter_id": 1593, "verse_number": "३-२३१-१५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027646, "chapter_id": 1593, "verse_number": "३-२३१-१५", "content_sanskrit": "अर्कपुष्पैस्तु ते पञ् गणाः पूज्या धनार्थिभिः।\nव्यादिप्रशमनार्थं चतेषां पूजां समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027647, "chapter_id": 1593, "verse_number": "३-२३१-१६", "content_sanskrit": "मिञ्जिकामिञ्जिकं चैव मिथुनं रुद्रसंभवम्।\nनमस्कार्यं सदैवेह बालानां हितमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027648, "chapter_id": 1593, "verse_number": "३-२३१-१७", "content_sanskrit": "स्त्रियो मानुषमांसादा वृक्षका नाम नामतः।\nवृक्षेषु जातास्ता देव्यो नमस्कार्याः प्रजार्थिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027649, "chapter_id": 1593, "verse_number": "३-२३१-१८", "content_sanskrit": "एषामेव पिशाचानामसङ्ख्येयगणाः स्मृताः।\nघण्टायाः सपताकायाः शृणु मे संभवं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027650, "chapter_id": 1593, "verse_number": "३-२३१-१९", "content_sanskrit": "ऐरावतस्य घण्टे द्वे वैजयन्त्याविति श्रुते।\nगुहस्य ते स्वयं दत्ते क्रमेणानाय्य धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027651, "chapter_id": 1593, "verse_number": "३-२३१-२०", "content_sanskrit": "एका तत्रविशाखस्य घण्टा स्कन्दस्य चापरा।\nपताका कार्तिकेयस् विशाखस्य च लोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027652, "chapter_id": 1593, "verse_number": "३-२३१-२१", "content_sanskrit": "यानि क्रीडनकान्यस्य देवैर्दत्तानि वै तदा।\nतैरेव रमते देवो महासेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027653, "chapter_id": 1593, "verse_number": "३-२३१-२२", "content_sanskrit": "स संवृतः पिशाचानां गणैर्देवगणैस्तथा।\nशुशुभे काञ्चने शैले दीप्यमानः श्रिया वृत्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027654, "chapter_id": 1593, "verse_number": "३-२३१-२३", "content_sanskrit": "तेन वीरेण शुशुभे स शैलः शुभकाननः।\nआदित्येनेवांशुमता मन्दरश्चारुकन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027655, "chapter_id": 1593, "verse_number": "३-२३१-२४", "content_sanskrit": "संतानकवनैः फुल्लैः करवीरवनैरपि।\nपारिजातवनैश्चैव जपाशोकवनैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027656, "chapter_id": 1593, "verse_number": "३-२३१-२५", "content_sanskrit": "कदम्बतरुषण्डैश्च दिव्यैर्मृगगणैरपि।\nदिव्यैः पक्षिगणैश्चैव शुशुभे श्वेतपर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027657, "chapter_id": 1593, "verse_number": "३-२३१-२६", "content_sanskrit": "तत्रदेवगणाः सर्वेसर्वे देवर्षयस्तथा।\nमेघतूर्यरवाश्चैव क्षुब्धोदधिसमस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027658, "chapter_id": 1593, "verse_number": "३-२३१-२७", "content_sanskrit": "तत्रदेवाश्च गन्धर्वा नृत्यन्तेऽप्सरसस्तथा।\nहृष्टानां तत्रभूतानां श्रूयते निनदो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027659, "chapter_id": 1593, "verse_number": "३-२३१-२८", "content_sanskrit": "एवं सेन्द्रं जगत्सर्वं श्वेतपर्वतसंस्थितम्।\nप्रहृष्टं प्रेक्षते स्कन्दं न च ग्लायति दर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027660, "chapter_id": 1593, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि एकत्रिंशदधिकद्विशततमोऽध्यायः ॥ २३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]