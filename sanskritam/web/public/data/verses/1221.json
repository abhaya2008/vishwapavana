[{"id": 2010879, "chapter_id": 1221, "verse_number": "१-२२२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010880, "chapter_id": 1221, "verse_number": "१-२२२-१", "content_sanskrit": "न रोचते विग्रहो मे पाण्डुपुत्रैः कथंचन।\nयथैव धृतराष्ट्रो मे तथा पाण्डुरसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010881, "chapter_id": 1221, "verse_number": "१-२२२-२", "content_sanskrit": "गान्धार्याश्च यथा पुत्रास्तथा कुन्तीसुता मम।\nयथा च मम ते रक्ष्या धृतराष्ट्र तथा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010882, "chapter_id": 1221, "verse_number": "१-२२२-३", "content_sanskrit": "यथा च मम राज्ञश्च तथा दुर्योधनस्य ते।\nतथा कुरूणां सर्वेषामन्येषामपि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010883, "chapter_id": 1221, "verse_number": "१-२२२-४", "content_sanskrit": "एवं गते विग्रहं तैर्न रोचे\nसन्धाय वीरैर्दीयतामर्धभूमिः।\nतेषामपीदं प्रपितामहानां\nराज्यं पितुश्चैव कुरूत्तमानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010884, "chapter_id": 1221, "verse_number": "१-२२२-५", "content_sanskrit": "दुर्योधन यथा र्जायं त्वमिदं तात पश्यसि।\nमम पैतृकमित्येवं तेऽपि पश्यन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010885, "chapter_id": 1221, "verse_number": "१-२२२-६", "content_sanskrit": "यदि राज्यं न ते प्राप्ताः पाण्डवेया यशस्विनः।\nकुत एव तवापीदं भारतस्यापि कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010886, "chapter_id": 1221, "verse_number": "१-२२२-७", "content_sanskrit": "अधर्मेण च राज्यं त्वं प्राप्तवान्भरतर्षभ।\nतेऽपि राज्यमनुप्राप्ताः पूर्वमेवेति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010887, "chapter_id": 1221, "verse_number": "१-२२२-८", "content_sanskrit": "मधुरेणैव राज्यस्य तेषामर्धं प्रदीयताम्।\nएतद्धि पुरुषव्याघ्र हितं सर्वजनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010888, "chapter_id": 1221, "verse_number": "१-२२२-९", "content_sanskrit": "अतोऽन्यथा चेत्क्रियते न हितं नो भविष्यति।\nतवाप्यकीर्तिः सकला भविष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010889, "chapter_id": 1221, "verse_number": "१-२२२-१०", "content_sanskrit": "कीर्तिरक्षणमातिष्ठ कीर्तिर्हि परमं बलम्।\nनष्टकीर्तेर्मनुष्यस्य जीवितं ह्यफळं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010890, "chapter_id": 1221, "verse_number": "१-२२२-११", "content_sanskrit": "यावत्कीर्तिर्मनुष्यस्य न प्रणश्यति कौरव।\nतावज्जीवति गान्धरे नष्टकीर्तिस्तु नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010891, "chapter_id": 1221, "verse_number": "१-२२२-१२", "content_sanskrit": "तमिमं समुपातिष्ठ धर्मं कुरुकुलोचितम्।\nअनुरूपं महाबाहो पूर्वेषामात्मनः कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010892, "chapter_id": 1221, "verse_number": "१-२२२-१३", "content_sanskrit": "दिष्ट्या ध्रियन्ते पार्था हि दिष्ट्या जीवति सा पृथा।\nदिष्ट्या पुरोचनः पापो न सकामोऽत्ययं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010893, "chapter_id": 1221, "verse_number": "१-२२२-१४", "content_sanskrit": "यदाप्रभृति दग्धास्ते कुन्तिभोजसुतासुताः।\nतदाप्रभृति गान्धारे न शक्नोम्यभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010894, "chapter_id": 1221, "verse_number": "१-२२२-१५", "content_sanskrit": "लोके प्राणभृतां किंचिच्छ्रुत्वा कुन्तीं तथागताम्।\nन चापि दोषेण तथा लोको मन्येत्पुरोचनम्।\nयथा त्वां पुरुषव्याघ्र लोको दोषेण गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010895, "chapter_id": 1221, "verse_number": "१-२२२-१६", "content_sanskrit": "तदिदं जीवितं तेषां तव किल्बिषनाशनम्।\nसंमन्तव्यं महाराज पाण्डवानां च दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010896, "chapter_id": 1221, "verse_number": "१-२२२-१७", "content_sanskrit": "न चापि तेषां वीराणां जीवतां कुरुनन्दन।\nपित्र्योंशः शक्य आदातुमपि वज्रभृता स्वयं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010897, "chapter_id": 1221, "verse_number": "१-२२२-१८", "content_sanskrit": "ते सर्वेऽवस्थिता धर्मे सर्वे चैवैकचेतसः।\nअधर्मेण निरस्ताश्च तुल्ये राज्ये विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010898, "chapter_id": 1221, "verse_number": "१-२२२-१९", "content_sanskrit": "यदि धर्मस्त्वया कार्यो यदि कार्यं प्रियं च मे।\nक्षेमं च यदि कर्तव्यं तेषामर्धं प्रदीयताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010899, "chapter_id": 1221, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि द्वाविंशत्यधिकद्विशततमोऽध्यायः॥ २२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]