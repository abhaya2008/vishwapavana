[{"id": 2032983, "chapter_id": 1712, "verse_number": "४-३५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032984, "chapter_id": 1712, "verse_number": "४-३५-१", "content_sanskrit": "तमसाऽभिप्लुते लोके रजसा चैव भारत।\nव्यतिष्ठन्त मुहूर्तं ते व्यूढानीकाः प्रहारिणम् ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032985, "chapter_id": 1712, "verse_number": "४-३५-२", "content_sanskrit": "ततोऽन्धकारं प्रणुदन्नुदतिष्ठन्निशाकरः।\nकुर्वाणो विमलां रात्रिं दर्शयन्क्षत्रियान्रणे ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032986, "chapter_id": 1712, "verse_number": "४-३५-३", "content_sanskrit": "ततः प्रकाशमासाद्य पुनर्युद्धमवर्तत।\nघोररूपं तदा तेषामवेक्ष्य तु परस्परम् ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032987, "chapter_id": 1712, "verse_number": "४-३५-४", "content_sanskrit": "तथैव तेषां तुमुलानि तानि क्रुद्धानि चान्योन्यमभिद्रवन्ति।\nगदासिपट्टैश्च परश्वथैश्च प्रासैश्च तीक्ष्णाग्रसुधौतधारैः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032988, "chapter_id": 1712, "verse_number": "४-३५-५", "content_sanskrit": "बलं तु मात्स्यस्य बलेन राजा सर्वं त्रिगर्ताधिपतिः सुशर्मा।\nप्रमथ्य जित्वा च निपीड्य मत्स्यान्विराटमोजस्विनमभ्यधावत् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032989, "chapter_id": 1712, "verse_number": "४-३५-६", "content_sanskrit": "मत्ताविव वृषौ तौ तु गजाविव मदोद्धतौ ।\nसिंहाविव गजग्राहौ शक्रवृत्राविवोद्धतौ ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032990, "chapter_id": 1712, "verse_number": "४-३५-७", "content_sanskrit": "उभौ तुल्यबलोत्साहावुभौ तुल्यपराक्रमौ।\nउभौ तुल्यास्रविक्षेपावुभौ युद्धविशारदौ ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032991, "chapter_id": 1712, "verse_number": "४-३५-८", "content_sanskrit": "तौ निहत्य पृथग्धुर्यानुभयोः पार्ष्णिसारथी ।\nआस्तां तुल्यधनुर्ग्राहौ कृष्णकंसाविवोद्धतौ ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032992, "chapter_id": 1712, "verse_number": "४-३५-९", "content_sanskrit": "ततः सुशर्मा त्रैगर्तः सह भ्रात्रा सुवर्मणा।\nअभ्यद्रवन्मत्स्यराजं रथव्रातेन सर्वशः ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032993, "chapter_id": 1712, "verse_number": "४-३५-१०", "content_sanskrit": "ततो रथाभ्यां प्रस्कन्द्य भ्रातरौ क्षत्रियर्षभौ।\nगदापाणी सुसंरब्धौ समभ्यद्रवतां जवात् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032994, "chapter_id": 1712, "verse_number": "४-३५-११", "content_sanskrit": "सुशर्मा परवीरघ्नो बलवान्वीर्यवान्गदी।\nविरथं मत्स्यराजानं जीवग्राहमथाग्रहीत् ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032995, "chapter_id": 1712, "verse_number": "४-३५-१२", "content_sanskrit": "तमुन्मथ्य सुशर्मा तु युवतीमिव कामुकः।\nस्यन्दनं स्वं समारोप्य प्रययौ भीमविक्रमः ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032996, "chapter_id": 1712, "verse_number": "४-३५-१३", "content_sanskrit": "तस्मिन्गृहीते विरथे विराटे बलवत्तरे।\nबलं सर्वं विभग्नं तन्निरुत्साहं निराशकम् ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032997, "chapter_id": 1712, "verse_number": "४-३५-१४", "content_sanskrit": "प्राद्रवन्त भयान्मात्स्यास्त्रिगर्तैरर्दिता रणे ।\nविदिक्षुः दिक्षु सर्वासु पलायन्ति च यान्ति च ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032998, "chapter_id": 1712, "verse_number": "४-३५-१५", "content_sanskrit": "तेषु विद्रांव्यमाणेषु कुन्तीपुत्रो युधिष्ठिरः।\nअभ्यभाषत धर्मात्मा भिमसेनमरिन्दमम् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032999, "chapter_id": 1712, "verse_number": "४-३५-१६", "content_sanskrit": "मात्स्यराजस्त्रिगर्तेन परामृष्टः सुशर्मणा।\nतं मोक्षय महाबाही मा गमद्द्विषतां वशम् ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033000, "chapter_id": 1712, "verse_number": "४-३५-१७", "content_sanskrit": "भीमसेनः महाबाहो गृहीतं तु सुशर्मणा।\nत्रायस्व मोचय क्षिप्रमस्मत्प्रीतिकरं नृपम् ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033001, "chapter_id": 1712, "verse_number": "४-३५-१८", "content_sanskrit": "उषिताः स्म सुखं सर्वे सर्वकामैः सुपूजिताः।\nभीमसेन त्वया कार्या तस्य वातस्य निष्कृतिः ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033002, "chapter_id": 1712, "verse_number": "४-३५-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033003, "chapter_id": 1712, "verse_number": "४-३५-१९", "content_sanskrit": "तं तथावादिनं तत्र भीमसेनो महाबलः।\nअभ्यभाषत दुर्धर्षो रणमध्ये युधिष्ठिरम् ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033004, "chapter_id": 1712, "verse_number": "४-३५-२०", "content_sanskrit": "अहमेनं परित्रास्ये शासनात्तव पार्थिव।\nपश्येदं सुमहत्कर्म युध्यतो मम शत्रुभिः ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033005, "chapter_id": 1712, "verse_number": "४-३५-२१", "content_sanskrit": "स्वबाहुबलमाश्रित्य परेषामसमं रणे।\nएकान्तमाश्रितो राजंस्तिष्ठ त्वं भ्रातृभिः सह ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033006, "chapter_id": 1712, "verse_number": "४-३५-२२", "content_sanskrit": "अयं वृक्षो महाशाखो गिरिमात्रो वनस्पतिः।\nअहमेनं समारुज्य पोथयिष्यामि शात्रवान् ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033007, "chapter_id": 1712, "verse_number": "४-३५-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033008, "chapter_id": 1712, "verse_number": "४-३५-२३", "content_sanskrit": "तं मत्तमिव मातङ्गं वीक्षमाणं वनस्पतिम्।\nअब्रवीद्भ्रातरं वीरं धर्मराजो युधिष्ठिरः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033009, "chapter_id": 1712, "verse_number": "४-३५-२४", "content_sanskrit": "भीम मा साहसं कार्षीस्तिष्ठत्वेष वनस्पतिः ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033010, "chapter_id": 1712, "verse_number": "४-३५-२५", "content_sanskrit": "मा त्वां वृक्षेण कर्माणि कुर्वन्तमतिमानुषम् ।\nजनाः समवबुध्येरन्भीमोऽयमिति भारत ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033011, "chapter_id": 1712, "verse_number": "४-३५-२६", "content_sanskrit": "मा ग्रहीस्त्वमिमं वृक्षं सिंहनादं च मा नद।\nकर्मणा सिंहनादेन विज्ञास्यन्ति जना ध्रुवम् ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033012, "chapter_id": 1712, "verse_number": "४-३५-२७", "content_sanskrit": "इमं वृक्षं गृहीत्वा त्वं नेमां सेनामभिद्रव ।\nवृक्षं च त्वां रुजन्तं वै विज्ञास्यति जनो ध्रुवं ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033013, "chapter_id": 1712, "verse_number": "४-३५-२८", "content_sanskrit": "अन्यदेवायुधं गृह्य प्रतिपद्यस्व मानुषम्।\nचापं वा यदि वा शक्तिं निस्त्रिंशं वा परश्वथम् ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033014, "chapter_id": 1712, "verse_number": "४-३५-२९", "content_sanskrit": "यदेव मानुषं भीम भवेदन्यैरलक्षितम् ।\nतदेवायुधमादाय मोचयाशु महीतिम् ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033015, "chapter_id": 1712, "verse_number": "४-३५-३०", "content_sanskrit": "यमौ च चक्ररक्षौ ते भवितारौ महाबलौ।\nव्यायच्छतस्ते समरे मत्स्यराजं परीप्स्रतः ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033016, "chapter_id": 1712, "verse_number": "४-३५-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033017, "chapter_id": 1712, "verse_number": "४-३५-३१", "content_sanskrit": "भ्रातुर्वचनमादाय भीमो वृक्षं विसृज्य च।\nचापमादाय संप्राप्तो रथमास्थाय पाण्डवः ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033018, "chapter_id": 1712, "verse_number": "४-३५-३२", "content_sanskrit": "व्यमुञ्चच्छरवर्षाणि सतोय इव तोयदः ।\nतं भीमो भीमकर्माणं शुशर्माणमथाऽऽद्रवत् ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033019, "chapter_id": 1712, "verse_number": "४-३५-३३", "content_sanskrit": "विराटमभिवीक्ष्यैनं तिष्ठितिष्ठेति चावदत् ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033020, "chapter_id": 1712, "verse_number": "४-३५-३४", "content_sanskrit": "सुशर्मा चिन्तयामास कालान्तकयमोपमम् ।\nतिष्ठतिष्ठेति भाषन्तं पृष्ठतो रथपुङ्गवः ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033021, "chapter_id": 1712, "verse_number": "४-३५-३५", "content_sanskrit": "पश्यतां सुमहत्कर्म महद्युद्धमुपस्थितम् ।\nपरावृत्तो धनुर्गृह्य सुशर्मा भ्रातृभिः सह ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033022, "chapter_id": 1712, "verse_number": "४-३५-३६", "content_sanskrit": "निमेषान्तरमात्रेण भीमसेनेन ते रथाः ।\nरथानां च गजानां च वाजिनां च ससादिनां ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033023, "chapter_id": 1712, "verse_number": "४-३५-३७", "content_sanskrit": "सहस्रशतसंघाताः शूराणामुग्रधन्विनाम् ।\nपातिता भीमसेनेन विराटस्य समीपतः ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033024, "chapter_id": 1712, "verse_number": "४-३५-३८", "content_sanskrit": "पत्तयो निहतास्तेषां गदां गृह्य महात्मना ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033025, "chapter_id": 1712, "verse_number": "४-३५-३९", "content_sanskrit": "तद्दृष्ट्वा तादृशं युद्धं सुशर्मा युद्धदुर्मदः।\nचिन्तयामास मनसा किं शेषं हि बलस्य मे ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033026, "chapter_id": 1712, "verse_number": "४-३५-४०", "content_sanskrit": "अपरो दृश्यते सैन्ये पुरा मग्नो महाबले।\nआकर्णपूर्णेन तदा धनुषा प्रत्यदृश्यत ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033027, "chapter_id": 1712, "verse_number": "४-३५-४१", "content_sanskrit": "सुशर्मा सायकांस्तीक्ष्णान्क्षिपते च पुनःपुनः ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2033028, "chapter_id": 1712, "verse_number": "४-३५-४२", "content_sanskrit": "ततः समस्तास्ते सर्वे तुरगानभ्यचोदयन्।\nदिव्यमस्त्रं विकुर्वाणास्त्रिगर्तान्प्रत्यमर्षणाः ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2033029, "chapter_id": 1712, "verse_number": "४-३५-४३", "content_sanskrit": "तान्निवृत्तरथान्दृष्ट्वा पाण्डवास्तां महाचमूम् ।\nवैराटिः परमक्रुद्धो युयुधे परमाद्भुतम् ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2033030, "chapter_id": 1712, "verse_number": "४-३५-४४", "content_sanskrit": "त्रिगर्ताः समभिक्रम्य अयुध्यन्त जयैषिणः।\nतान्भीमसेनः संक्रुद्धः सर्वशस्त्रभृतांवरः ।\nवैराटिः परमक्रुद्धो युयुधे परमाद्भुतम् ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2033031, "chapter_id": 1712, "verse_number": "४-३५-४५", "content_sanskrit": "सहस्रं प्राहिणीद्राजा कुन्तीपुत्रो युधिष्ठिरः।\nनकुलश्चापि सप्तैव शतानि प्राहिणोच्छरैः ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2033032, "chapter_id": 1712, "verse_number": "४-३५-४६", "content_sanskrit": "शतानि त्रीणि शूराणां सहदेवः प्रतापवान् ।\nयुधिष्ठिरसमादिष्टो निजघ्ने पुरुषर्षभः ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2033033, "chapter_id": 1712, "verse_number": "४-३५-४७", "content_sanskrit": "प्रविश्य महतीं सेनां त्रिगर्तानां महाबलः ।\nक्षोभयन्सर्वभूतानि सिंहः क्षुद्रमृगानिव ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2033034, "chapter_id": 1712, "verse_number": "४-३५-४८", "content_sanskrit": "ततो युधिष्ठिरो राजा त्वरमाणो महाबलः।\nअभिद्रुत्य सुशर्माणं शरैरभ्यहनद्धृशम् ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2033035, "chapter_id": 1712, "verse_number": "४-३५-४९", "content_sanskrit": "सुशर्माऽपि सुसंक्रुद्धस्त्वराणो युधिष्ठिरम् ।\nअविध्यद्दशभिर्बाणैश्चतुर्भिश्चतुरो हयान् ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2033036, "chapter_id": 1712, "verse_number": "४-३५-५०", "content_sanskrit": "ततो राजन्क्षिप्रकारी कुन्तीऽपुत्रो वृकोदरः।\nसमासाद्य सुशर्माणमश्वांस्तस्य न्यपातयत् ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2033037, "chapter_id": 1712, "verse_number": "४-३५-५१", "content_sanskrit": "पृष्ठगोषौ च तस्याथ हत्वा परमसायकैः।\nअथास्य सारथिं क्रुद्धो रथोपस्थादपतयत् ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2033038, "chapter_id": 1712, "verse_number": "४-३५-५२", "content_sanskrit": "चक्ररक्षस्तु शूरश्च शोणाश्वो नाम नामतः।\nस भयाद्विरथं दृष्ट्वा त्रैगर्तं व्याजहात्तदा ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2033039, "chapter_id": 1712, "verse_number": "४-३५-५३", "content_sanskrit": "ततो विराटः प्रस्कन्द्य रथादथ सुशर्मणः।\nगदामस्य परामृश्य तमेवाभ्यहनद्बली ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2033040, "chapter_id": 1712, "verse_number": "४-३५-५४", "content_sanskrit": "स चचार गदापाणिर्वृद्धोऽपि तरुणो यथा ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2033041, "chapter_id": 1712, "verse_number": "४-३५-५५", "content_sanskrit": "भीमस्तु भीमसंकाशो रथात्प्रस्कन्द्य वीर्यवान् ।\nउत्प्लुत्य गत्वा वेगेन तद्रथे विनिपत्य च।\nसुशर्मणः शिरोऽगुह्णात्पुनराश्वास्य युध्यतः ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2033042, "chapter_id": 1712, "verse_number": "४-३५-५६", "content_sanskrit": "अग्राद्गिरेर्विनिक्षिप्य सिंहः क्षुद्रमृगं यथा।\nऊर्ध्वमुत्प्लृत्य मार्जार आखोर्यद्वच्छिरो रुषा ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2033043, "chapter_id": 1712, "verse_number": "४-३५-५७", "content_sanskrit": "समुद्यम्य तु रोषात्तं निष्पिपेष महीतले।\nयदा मूर्ध्नि महाबाहुः प्राहरद्विलपिष्यतः ॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2033044, "chapter_id": 1712, "verse_number": "४-३५-५८", "content_sanskrit": "तस्य जानु ददौ भीमो जघ्ने चैनमरत्निना ।\nस मोहमगमद्राजा प्रहारवरपीडितः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2033045, "chapter_id": 1712, "verse_number": "४-३५-५९", "content_sanskrit": "तस्मिन्वीरे गृहीते तु त्रिगर्तानां महारथे।\nअभज्यत बलं सर्वं त्रिगर्तानां भयातुरम् ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2033046, "chapter_id": 1712, "verse_number": "४-३५-६०", "content_sanskrit": "निवृत्य गास्ततः सर्वाः पाण्डुपुत्रा महारथाः।\nअवजित्य सुशर्माणं धनं चादाय सर्वशः ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2033047, "chapter_id": 1712, "verse_number": "४-३५-६१", "content_sanskrit": "स्वबाहुबलसंपन्ना ह्रीनिषेवा यतव्रताः।\nविराटस्य महात्मानः परिक्लेशविनाशनाः।\nस्थिताः समक्षं ते सर्वे त्वथ भीमोऽभ्यभाषत ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2033048, "chapter_id": 1712, "verse_number": "४-३५-६२", "content_sanskrit": "नायं पापसमाचारो मत्तो जीवितुमर्हति।\nकिंनु शक्यं मया कर्तुं यद्राजा सततं घृणी ।\nगले गृहीत्वा राजानमानीय विवशं वशम् ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2033049, "chapter_id": 1712, "verse_number": "४-३५-६३", "content_sanskrit": "तत एनं विचेष्टन्तं बद्ध्वा पार्थो वृकोदरः।\nरथमारोपयामास विसंज्ञं पांसुगुण्ठितम् ॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2033050, "chapter_id": 1712, "verse_number": "४-३५-६४", "content_sanskrit": "अभ्येत्य रणमध्यस्थमभ्यगच्छद्युधिष्ठिरम् ।\nदर्शयामास भीमस्तु सुशर्माणं नराधिपम् ॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2033051, "chapter_id": 1712, "verse_number": "४-३५-६५", "content_sanskrit": "प्रोवाच पुरुषव्याघ्रो भीममाहवशोभिनम् ।\nतं राजा प्राहसद्दृष्ट्वा मुच्यतां वै नराधमः ॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2033052, "chapter_id": 1712, "verse_number": "४-३५-६६", "content_sanskrit": "एवमुक्तोऽब्रवीद्भीमः सुशर्माणं महाबलम् ।\nजीवितुं चेच्छसे मूढ हेतुं मे गदतः शृणु ॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2033053, "chapter_id": 1712, "verse_number": "४-३५-६७", "content_sanskrit": "दासोस्मीति त्वया वाच्यं संसत्सु च सभासु च ।\nएवं ते जीवितं दद्यामेष युद्धजितो विधिः ॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2033054, "chapter_id": 1712, "verse_number": "४-३५-६८", "content_sanskrit": "तमुवाच ततो ज्येष्ठो भ्राता सप्रणयं वचः।\nमुञ्चमुञ्चाधमाचारं प्रमाणं यदि ते वयम् ॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2033055, "chapter_id": 1712, "verse_number": "४-३५-६९", "content_sanskrit": "दासभावं गतो ह्येष विराटस्य महीपतेः।\nअदासो गच्छ मुक्तोसि मैवं कार्षीः कदाचन ॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2033056, "chapter_id": 1712, "verse_number": "४-३५-७०", "content_sanskrit": "एवमुक्ते तु सव्रीडः सुशर्माऽसीदधोमुखः ।\nस मुक्तोऽभ्येत्य राजानमभिवाद्य प्रतस्थिवान् ॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2033057, "chapter_id": 1712, "verse_number": "४-३५-७१", "content_sanskrit": "विसृज्य तु सुशर्माणं पाण्डवास्ते हतद्विषः ।\nस्वबाहुबलसंपन्ना हीनिषेवा यतव्रताः ।\nसंग्रामशिरसो मध्ये तां रात्रिं सुखिनोऽवसन् ॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2033058, "chapter_id": 1712, "verse_number": "", "content_sanskrit": "॥ श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि पञ्चत्रिंशोऽध्यायः ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]