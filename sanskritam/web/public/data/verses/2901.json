[{"id": 2088850, "chapter_id": 2901, "verse_number": "१३-३१-१", "content_sanskrit": "युधिष्ठिर उवाच।\nमित्रसौहार्दयोगेन उपदेशं करोति यः।\nजात्याऽधरस्य राजर्षे दोषस्तस्य भवेन्न वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088851, "chapter_id": 2901, "verse_number": "१३-३१-२", "content_sanskrit": "एतदिच्छामि तत्त्वेन व्याख्यातुं वै पितामह।\nसूक्ष्मा गतिर्हि धर्मस्यि यत्र मुह्यन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088852, "chapter_id": 2901, "verse_number": "१३-३१-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088853, "chapter_id": 2901, "verse_number": "१३-३१-३", "content_sanskrit": "अत्र ते वर्तयिष्यामि शृणु राजन्यथाक्रमम्।\n`मदुक्तं वचनं राजन्यथान्यायं यथागमम्।\nऋषीणां वदतां पूर्वं श्रुतमासीद्यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088854, "chapter_id": 2901, "verse_number": "१३-३१-४", "content_sanskrit": "उपदेशो न कर्तव्यो जातिहीनस्य कस्य चित्।\nउपदेशे महान्दोष उपाध्यायस्य भाष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088855, "chapter_id": 2901, "verse_number": "१३-३१-५", "content_sanskrit": "`नाध्यापयेच्छूद्रमिह तथा नैव च याजयेत्।\nनिदर्शनमिदं राजञ्शृणु मे भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088856, "chapter_id": 2901, "verse_number": "१३-३१-६", "content_sanskrit": "दुरुक्तवचने राजन्यथापूर्वं युधिष्ठिर।\nब्रह्माश्रमपदे वृत्तं पार्श्वे हिमवतः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088857, "chapter_id": 2901, "verse_number": "१३-३१-७", "content_sanskrit": "तत्राश्रमपदं पुण्यं नानावृक्षगणायुतम्।\nनानागुल्मलताकीर्णं मृगद्विजनिषेवितम्।\nसिद्धचारणसंघुष्टं रम्यं पुष्पितकाननम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088858, "chapter_id": 2901, "verse_number": "१३-३१-८", "content_sanskrit": "व्रतिभिर्बहुभिः कीर्णं तापसैरुपशोभितम्।\nब्राह्मणैश्च महाभागैः सूर्यज्वलनसन्निभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088859, "chapter_id": 2901, "verse_number": "१३-३१-९", "content_sanskrit": "नियमव्रतसम्पन्नैः समाकीर्णं तपस्विभिः।\nदीक्षितैर्भरतश्रेष्ठ यताहारैः कृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088860, "chapter_id": 2901, "verse_number": "१३-३१-१०", "content_sanskrit": "वेदाध्ययनघोषैश्च नादितं भरतर्षभ।\nवालखिल्यैश्च बहुभिर्यतिभिश्च निषेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088861, "chapter_id": 2901, "verse_number": "१३-३१-११", "content_sanskrit": "तत्र कश्चित्समुत्साहं कृत्वा शूद्रो दयान्वितः।\nआगतो ह्याश्रमपदं पूजितश्च तपस्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088862, "chapter_id": 2901, "verse_number": "१३-३१-१२", "content_sanskrit": "तांस्तु दृष्ट्वा मुनिगणान्देवकल्पान्महौजसः।\nविविधां वहतो दीक्षां सम्प्राहृष्यत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088863, "chapter_id": 2901, "verse_number": "१३-३१-१३", "content_sanskrit": "अथास्य बुद्धिरभावत्तापस्ये भरतर्षभ।\nततोऽब्रवीत्कुलपतिं पादौ सङ्गृह्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088864, "chapter_id": 2901, "verse_number": "१३-३१-१४", "content_sanskrit": "भवत्प्रसादादिच्छामि धर्मं चर्तुं द्विजर्षभ।\nतस्मादभिगतं त्वं मां प्रव्राजयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088865, "chapter_id": 2901, "verse_number": "१३-३१-१५", "content_sanskrit": "वर्णावरोऽहं भगवञ्शूद्रो जात्याऽस्मि सत्तम।\nशुश्रूषां कर्तुमिच्छामि प्रपन्नाय प्रसीद मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088866, "chapter_id": 2901, "verse_number": "१३-३१-१६x", "content_sanskrit": "कुलपतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088867, "chapter_id": 2901, "verse_number": "१३-३१-१६", "content_sanskrit": "न शक्यमिह शूद्रेण लिङ्गमाश्रित्य वर्तितुम्।\nआस्यतां यदि ते बुद्धिः शुश्रूषानिरतो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088868, "chapter_id": 2901, "verse_number": "१३-३१-१७", "content_sanskrit": "शुश्रूषया पराँल्लोकानवाप्स्यसि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088869, "chapter_id": 2901, "verse_number": "१३-३१-१८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088870, "chapter_id": 2901, "verse_number": "१३-३१-१८", "content_sanskrit": "एवमुक्तस्तु मुनिना स शूद्रोऽचिन्तयन्नृप।\nकथमत्र मया कार्यं श्रुद्धा धर्मपरा च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088871, "chapter_id": 2901, "verse_number": "१३-३१-१९", "content_sanskrit": "विज्ञातमेवं भवतु करिष्ये प्रियमात्मनः।\nगत्वाऽऽश्रमपदाद्दूरमुटजं कृतवांस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088872, "chapter_id": 2901, "verse_number": "१३-३१-२०", "content_sanskrit": "तत्र वेदीं च भूमिं च देवतायतनानि च।\nनिवेश्य भरतश्रेष्ठ नियमस्थोऽभवन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088873, "chapter_id": 2901, "verse_number": "१३-३१-२१", "content_sanskrit": "अभिषेकांश्च नियमान्देवतायतनेषु च।\nबलिं च कृत्वा हुत्वा च देवतां चाप्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088874, "chapter_id": 2901, "verse_number": "१३-३१-२२", "content_sanskrit": "सङ्कल्पनियमोपेतः फलाहारो जितेन्द्रियः।\nनित्यं सन्निहिताभिस्तु ओषधीभिः फलैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088875, "chapter_id": 2901, "verse_number": "१३-३१-२३", "content_sanskrit": "अतिथीन्पूजयामास यथावत्समुपागतान्।\nएवं हि सुमहान्कालो व्यत्यक्रामत तस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088876, "chapter_id": 2901, "verse_number": "१३-३१-२४", "content_sanskrit": "अथास्य मुनिरागच्चत्सङ्गत्या वै तमाश्रमम्।\nसम्पूज्य स्वागतेनर्षिं विधिवत्समतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088877, "chapter_id": 2901, "verse_number": "१३-३१-२५", "content_sanskrit": "अनूकूलाः कथाः कृत्वा यथागतमपृच्छत।\nऋषिः परमतेजस्वी धर्मात्मा संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088878, "chapter_id": 2901, "verse_number": "१३-३१-२६", "content_sanskrit": "एवं सुबहुशस्तस्य शूद्रस्य भरतर्षभ।\nसोऽगच्छदाश्रममृषिः शूद्रं द्रष्टुं नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088879, "chapter_id": 2901, "verse_number": "१३-३१-२७", "content_sanskrit": "अथ तं तापसं शूद्रः सोऽब्रवीद्भरतर्षभ।\nपितृकार्यं करिष्यामि तत्र मेऽनुग्रहं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088880, "chapter_id": 2901, "verse_number": "१३-३१-२८", "content_sanskrit": "बाढमित्येव तं विप्र उवाच भरतर्षभ।\nशुचिर्भूत्वा स शूद्रस्तु तस्यर्षेः पाद्यमानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088881, "chapter_id": 2901, "verse_number": "१३-३१-२९", "content_sanskrit": "अथ दर्भाश्च वन्यांश्च ओषधीर्भरतर्षभ।\nपवित्रमासनं चैव बृसीं चि समुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088882, "chapter_id": 2901, "verse_number": "१३-३१-३०", "content_sanskrit": "अथ दक्षिणमावृत्य बृसीं चरमशैर्षिकीम्।\nकृतामन्यायतो दृष्ट्वा तं शूद्रमृषिरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088883, "chapter_id": 2901, "verse_number": "१३-३१-३१", "content_sanskrit": "कुरुष्वैतां पूर्वशीर्षां भवांश्चोदङ्मुखः शुचिः।\nस च तत्कृतवाञ्शूद्रः सर्वं यदृषिरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088884, "chapter_id": 2901, "verse_number": "१३-३१-३२", "content_sanskrit": "यथोपदिष्टं मेधावी दर्भार्घादि यथातथम्।\nहव्यकव्यविधिं कृत्स्नमुक्तं तेन तपस्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2088885, "chapter_id": 2901, "verse_number": "१३-३१-३३", "content_sanskrit": "ऋषिणा पितृकार्येषु सदा धर्मपथे स्थितः।\nपितृकार्ये कृते चापि विसृष्टः स जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2088886, "chapter_id": 2901, "verse_number": "१३-३१-३४", "content_sanskrit": "अथ दीर्घस्य कालस्य स तप्यञ्शूद्रतापसः।\nवने पञ्चत्वमगमत्सुकृतेन च तेन वै।\nअजायत महाराज वंशे स च महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2088887, "chapter_id": 2901, "verse_number": "१३-३१-३५", "content_sanskrit": "तथैव स ऋषिस्तात कालधर्ममवाप ह।\nपुरोहितकुले विप्रः स जातोऽस्य वशानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2088888, "chapter_id": 2901, "verse_number": "१३-३१-३६", "content_sanskrit": "एवं तौ तत्र सम्भूतावुभौ शूद्रमुनी तदा।\nक्रमेण वर्धितौ चापि विद्यासु कुशलावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2088889, "chapter_id": 2901, "verse_number": "१३-३१-३७", "content_sanskrit": "अथर्ववेदे वेदे च बभूवर्षिः सुनिष्ठितः।\nकल्पप्रयोगे चोत्पन्ने ज्योतिषे च परं गतः।\nसाङ्ख्ये चैव परा प्रीतिस्तस्य चैवं व्यवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2088890, "chapter_id": 2901, "verse_number": "१३-३१-३८", "content_sanskrit": "पितर्युपरते चापि कृतशौचस्तु पार्थिवः।\nअभिषिक्तः प्रकृतिभी राजपुत्रः स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2088891, "chapter_id": 2901, "verse_number": "१३-३१-३९", "content_sanskrit": "अभिषिक्तेन स ऋषिरभिषिक्तः पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2088892, "chapter_id": 2901, "verse_number": "१३-३१-४०", "content_sanskrit": "स तं पुरोधाय सुखमवसद्भरतर्षभः।\nराज्यं शशास धर्मेण प्रजाश्च परिपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2088893, "chapter_id": 2901, "verse_number": "१३-३१-४१", "content_sanskrit": "पुण्याहवाचने नित्यं धर्मकार्येषु चासकृत्।\nउत्स्मयन्प्राहसच्चापि दृष्ट्वा राजा पुरोहितम्।\nएवं स बहुशो राजन्पुरोधसमुपाहसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2088894, "chapter_id": 2901, "verse_number": "१३-३१-४२", "content_sanskrit": "लक्षयित्वा पुरोधास्तु बहुशस्तं नराधिपम्।\nउत्स्मयन्तं च सततं दृष्ट्वा तं मन्युमानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2088895, "chapter_id": 2901, "verse_number": "१३-३१-४३", "content_sanskrit": "अथ शून्ये पुरोधास्तु सह राज्ञा समागतः।\nकथाभिरनुकूलाभी राजानं चाभ्योरचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2088896, "chapter_id": 2901, "verse_number": "१३-३१-४४", "content_sanskrit": "ततोऽब्रवीन्नरेन्द्रं स पुरोधा भरतर्षभ।\nवरमिच्छाम्यहं त्वेकं त्वया दत्तं महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2088897, "chapter_id": 2901, "verse_number": "१३-३१-४५x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2088898, "chapter_id": 2901, "verse_number": "१३-३१-४५", "content_sanskrit": "वराणां ते शतं दद्यां किं बतैकं द्विजोत्तम।\nस्नेहाच्च बहुमानाच्च नास्त्यदेयं हि मे तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2088899, "chapter_id": 2901, "verse_number": "१३-३१-४६x", "content_sanskrit": "पुरोहित उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2088900, "chapter_id": 2901, "verse_number": "१३-३१-४६", "content_sanskrit": "एकं वै वरमिच्छामि यदि तुष्टिसि पार्थिव।\nप्रतिजानीहि तावत्त्वं सत्यं यद्वद नानृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2088901, "chapter_id": 2901, "verse_number": "१३-३१-४७x", "content_sanskrit": "भीष्म उवाचि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2088902, "chapter_id": 2901, "verse_number": "१३-३१-४७", "content_sanskrit": "बाढमित्येव तं राजा प्रत्युवाच युधिष्ठिर।\nयदि ज्ञास्यामि वक्ष्यामि अजानन्न तु संवदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2088903, "chapter_id": 2901, "verse_number": "१३-३१-४८x", "content_sanskrit": "पुरोहित उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2088904, "chapter_id": 2901, "verse_number": "१३-३१-४८", "content_sanskrit": "पुण्याहवाचने नित्यं धर्मकृत्येषु चासकृत्।\nशान्तिहोमेषु च सदा किं त्वं हससि वीक्ष्य मां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2088905, "chapter_id": 2901, "verse_number": "१३-३१-४९", "content_sanskrit": "सव्रीडं वै भवति हि मनो मे हसता त्वया।\nकामया शापितो राजन्नान्यथावक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2088906, "chapter_id": 2901, "verse_number": "१३-३१-५०", "content_sanskrit": "भाव्यं हि कारणेनात्र न ते हास्यमकारणम्।\nकौतूहलं मे सुभृशं तत्त्वेन कथमस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2088907, "chapter_id": 2901, "verse_number": "१३-३१-५१x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2088908, "chapter_id": 2901, "verse_number": "१३-३१-५१", "content_sanskrit": "एवमुक्ते त्वया विप्र यदवाच्यं भवेदपि।\nअवश्यमेव वक्तव्यं शृणुष्वैकमना द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2088909, "chapter_id": 2901, "verse_number": "१३-३१-५२", "content_sanskrit": "पूर्वदेहे यथा वृत्तं तन्निबोध द्विजोत्तम।\nजातिं स्मराम्यहं ब्रह्मन्नवधानेन मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2088910, "chapter_id": 2901, "verse_number": "१३-३१-५३", "content_sanskrit": "शुद्रोऽहमभवं पूर्वं तपसे कृतनिश्चयः।\nऋषिरुग्रतपास्त्वं च तदाऽभूर्द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2088911, "chapter_id": 2901, "verse_number": "१३-३१-५४", "content_sanskrit": "प्रीयता हि तदा ब्रह्मन्ममानुग्रहबुद्धिना।\nपितृकार्ये त्वया पूर्वमुपदेशः कृतोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2088912, "chapter_id": 2901, "verse_number": "१३-३१-५५", "content_sanskrit": "वृस्यां दर्भेषु हव्ये च कव्ये च मुनिसत्तम।\nएतेन कर्मदोषेण पुरोधास्त्वमजायथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2088913, "chapter_id": 2901, "verse_number": "१३-३१-५६", "content_sanskrit": "अहं राजा च विप्रेन्द्र पश्य कालस्य पर्ययम्।\nमत्कृतस्योपदेशस्य त्वयाऽवाप्तमिदं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2088914, "chapter_id": 2901, "verse_number": "१३-३१-५७", "content_sanskrit": "एतस्मात्कारणाद्ब्रह्मन्प्रहसे त्वां द्विजोत्तम।\nन त्वां परिभवन्ब्रह्मनप्रहसामि गुरुर्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2088915, "chapter_id": 2901, "verse_number": "१३-३१-५८", "content_sanskrit": "विपर्ययेण मे मन्युस्तेन सन्तप्यते मनः।\nजातिं स्मराम्यहं तुभ्यमतस्त्वां प्रहसामि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2088916, "chapter_id": 2901, "verse_number": "१३-३१-५९", "content_sanskrit": "एवं तवोग्रं हि तप उपदेशेन नाशितम्।\nपुरोहितत्वमुत्सृज्य यतस्व त्वं पुनर्भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2088917, "chapter_id": 2901, "verse_number": "१३-३१-६०", "content_sanskrit": "इतस्त्वमधमामन्यां मा योनिं प्राप्स्यसे द्विज।\nगृह्यतां द्रविणं विप्र पूतात्मा भव सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2088918, "chapter_id": 2901, "verse_number": "१३-३१-६१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2088919, "chapter_id": 2901, "verse_number": "१३-३१-६१", "content_sanskrit": "ततो विसृष्टो राज्ञा तु विप्रो दानान्यनेकशः।\nब्राह्मणेभ्यो ददौ वित्तं भूमिं ग्रामांश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2088920, "chapter_id": 2901, "verse_number": "१३-३१-६२", "content_sanskrit": "कृच्छ्राणि चीर्त्वा च ततो यथोक्तानि द्विजोत्तमैः।\nतीर्थानि चापि गत्वा वै दानानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2088921, "chapter_id": 2901, "verse_number": "१३-३१-६३", "content_sanskrit": "दत्त्वा गाश्चैव विप्रेभ्यः पूतात्माऽभवदात्मवान्।\nतमेव चाश्रमं गत्वा चचार विपुलं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2088922, "chapter_id": 2901, "verse_number": "१३-३१-६४", "content_sanskrit": "ततः सिद्धिं परां प्राप्तो ब्राह्मणो राजसत्तम।\nसम्मतस्चाभवत्तेषामाश्रमे तन्निवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2088923, "chapter_id": 2901, "verse_number": "१३-३१-६५", "content_sanskrit": "एवं प्राप्तो महत्कृच्छ्रमृषिः सन्नृपसत्तम।\nब्राह्मणेन न वक्तव्यं तस्माद्वर्णावरे जने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2088924, "chapter_id": 2901, "verse_number": "१३-३१-६६", "content_sanskrit": "`वर्जयेदुपदेशं च सदैव ब्राह्मणो नृप।\nउपदेशं हि कुर्वाणो द्विजः कृच्छ्रमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2088925, "chapter_id": 2901, "verse_number": "१३-३१-६७", "content_sanskrit": "नेषितव्यं सदा वाचा द्विजेन नृपसत्तम।\nन च प्रवक्तव्यमिह किञ्चिद्वर्णावरे नरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2088926, "chapter_id": 2901, "verse_number": "१३-३१-६८", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्यास्त्रयो वर्णा द्विजातयः।\nएतेषु कथयन्राजन्ब्राह्मणो न प्रदुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2088927, "chapter_id": 2901, "verse_number": "१३-३१-६९", "content_sanskrit": "तस्मात्सद्भिर्न वक्तव्यं कस्यचित्किंचिदग्रतः।\nसूक्ष्मा गतिर्हि धर्मस्य दुर्ज्ञेया ह्यकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2088928, "chapter_id": 2901, "verse_number": "१३-३१-७०", "content_sanskrit": "तस्मान्मौनेन मुनयो दीक्षां कुर्वन्ति चादृताः।\nदुरुक्तस्य भयाद्राजन्नाभाषन्ते च किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2088929, "chapter_id": 2901, "verse_number": "१३-३१-७१", "content_sanskrit": "धार्मिका गुणसम्पन्नाः सत्यार्जवसमन्विताः।\nदुरुक्तवाचाभिहितैः प्राप्नुवन्तीह दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2088930, "chapter_id": 2901, "verse_number": "१३-३१-७२", "content_sanskrit": "उपदेशो न कर्तव्यो ह्यज्ञात्वा यस्यकस्य चित्।\nउपदेशाद्धि तत्पापं ब्राह्मणः समवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2088931, "chapter_id": 2901, "verse_number": "१३-३१-७३", "content_sanskrit": "विमृश्य तस्मात्प्राज्ञेन वक्तव्यं धर्ममिच्छता।\nसत्यानृतेन हि कृत उपदेशो हिनस्ति हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2088932, "chapter_id": 2901, "verse_number": "१३-३१-७४", "content_sanskrit": "वक्तव्यमिह पृष्टेन विनिश्चयविपर्ययम्।\nस चोपदेशः कर्तव्यो येन धर्ममवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2088933, "chapter_id": 2901, "verse_number": "१३-३१-७५", "content_sanskrit": "एतत्ते सर्वमाख्यातमुपदेशकृते मया।\nमहान्क्लेशो हि भवति तस्मान्नोपदिशेदिह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2088934, "chapter_id": 2901, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकविंशोऽध्यायः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]