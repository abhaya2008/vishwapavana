[{"id": 2159238, "chapter_id": 4453, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159239, "chapter_id": 4453, "verse_number": "१", "content_sanskrit": "दिलीपं चापि राजेन्द्र मृतं सृञ्जय शुश्रुम ।\nयस्य यज्ञशतेष्वासन् प्रयुतायुतशो द्विजाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159240, "chapter_id": 4453, "verse_number": "२", "content_sanskrit": "वेदवेदाङ्गतत्त्वज्ञा यज्वानः पुत्रपौत्रिणः ।\nस्वच्छन्दाः पुण्यगन्धाश्च सुभक्षा हेममालिनः\nयस्य कर्माणि भूरीणि कथयन्ति मनीषिणः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159241, "chapter_id": 4453, "verse_number": "३", "content_sanskrit": "य इमां पृथिवीं पूर्णां वसुधां वसुधाधिपः ।\nईजानो वितते यज्ञे ब्राह्मणेभ्योऽभ्युपाहरत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159242, "chapter_id": 4453, "verse_number": "४", "content_sanskrit": "यस्य वै यजमानस्य यज्ञे यज्ञे पुरोहितः ।\nसहस्रं वारणान् हैमं दक्षिणा अत्यकालयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159243, "chapter_id": 4453, "verse_number": "५", "content_sanskrit": "दिलीपस्य च यज्ञेषु कृतः पन्था हिरण्मयः ।\nसौवर्णं चाभवत् सर्वं सदा परमभास्वरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159244, "chapter_id": 4453, "verse_number": "६", "content_sanskrit": "रसानां चाभवन् कुल्याः कण्ठदघ्नाः समन्ततः ।\nसहस्रायामका यूपाः तस्य चासन् हिरण्मयाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159245, "chapter_id": 4453, "verse_number": "७", "content_sanskrit": "तत् कर्म बहु कुर्वाणाः सेन्द्रा देवाः समुच्छ्रयन् ।\nचषालप्रचषालौ च यस्य यूपे हिरण्मयौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159246, "chapter_id": 4453, "verse_number": "८", "content_sanskrit": "नृत्यन्त्यप्सरसो यत्र षट्सहस्राणि सप्त च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159247, "chapter_id": 4453, "verse_number": "९", "content_sanskrit": "अवादयच्च तत्रास्य प्रीत्या विश्वावसुः स्वयम् ।\nसर्वभूतान्यमोदन्त मम वादयतीति तम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159248, "chapter_id": 4453, "verse_number": "१०", "content_sanskrit": "इत्थं दिलीपस्य नृपा यज्ञान् नान्येऽनुचक्रिरे ।\nयद्दोषा हेमसञ्छन्ना मर्त्याः पथिषु शेरते\nतदेव चाद्भुतं मन्ये अन्यैरसदृशं नृपैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159249, "chapter_id": 4453, "verse_number": "११", "content_sanskrit": "यस्याप्सु युद्ध्यमानस्य चक्रे न परिपेततुः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159250, "chapter_id": 4453, "verse_number": "१२", "content_sanskrit": "राजानं चोग्रधन्वानं दिलीपं सत्यवादिनम् ।\nयेऽपश्यन् भूरिदक्षिण्यं तेऽपि स्वर्गमितो गताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159251, "chapter_id": 4453, "verse_number": "१३", "content_sanskrit": "इमे शब्दा न जीर्यन्ते दिलीपस्य निवेशने ।\nस्वाध्यायशब्दो ज्याशब्दः पिबताश्नीत खादत\nस चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159252, "chapter_id": 4453, "verse_number": "१४", "content_sanskrit": "पुत्रात् पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159253, "chapter_id": 4453, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि अष्टपञ्चाशोऽध्यायः ॥ ५८ ॥\nअभिमन्युवधपर्वणि सप्तविंशोऽध्यायः ॥ २७ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]