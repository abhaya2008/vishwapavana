[{"id": 2076018, "chapter_id": 2611, "verse_number": "१२-११६-०x", "content_sanskrit": "`युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076019, "chapter_id": 2611, "verse_number": "१२-११६-१", "content_sanskrit": "न सन्ति कुलजा यत्र सहायाः पार्थिवस्य तु।\nअकुलीनाश्च कर्तव्या न वा भरतसत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076020, "chapter_id": 2611, "verse_number": "१२-११६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076021, "chapter_id": 2611, "verse_number": "१२-११६-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनिदर्शनं परं लोके सज्जनाचरितं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076022, "chapter_id": 2611, "verse_number": "१२-११६-३", "content_sanskrit": "अस्यैवार्थस्य सदृशं यच्छ्रुतं मे तपोवने।\nजामदग्न्यस्य रामस्य यदुक्तमृषिसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076023, "chapter_id": 2611, "verse_number": "१२-११६-४", "content_sanskrit": "वने महति कस्मिंश्चिदमनुष्यनिषेविते।\nऋषिर्मूलफलाहारो नियतो नियतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076024, "chapter_id": 2611, "verse_number": "१२-११६-५", "content_sanskrit": "दीक्षादमपरिश्रान्तः स्वाध्यायपरमः शुचिः।\nउपवासविशुद्धात्मा सततं सत्पथे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076025, "chapter_id": 2611, "verse_number": "१२-११६-६", "content_sanskrit": "तस्य संदृश्य सद्भावमुपविष्टस्य धीमतः।\nसर्वे सत्वाः समीपस्था भवन्ति वनचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076026, "chapter_id": 2611, "verse_number": "१२-११६-७", "content_sanskrit": "सिंहा व्याघ्राः सशरभा मत्ताश्चैव महागजाः।\nद्वीपिनः खङ्गभल्लूका ये चान्ये भीमदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076027, "chapter_id": 2611, "verse_number": "१२-११६-८", "content_sanskrit": "ते सुखप्रश्नदाः सर्वे भवन्ति क्षतजाशनाः।\nतस्यर्षेः शिष्यवच्चैव चित्तज्ञाः प्रियकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076028, "chapter_id": 2611, "verse_number": "१२-११६-९", "content_sanskrit": "उक्त्वा च ते सुखप्रश्नं सर्वे यान्ति यथासुखम्।\nग्राम्यस्त्वेकः पशुस्तत्र नाजहात्स महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076029, "chapter_id": 2611, "verse_number": "१२-११६-१०", "content_sanskrit": "भक्तोऽनुरक्तः सततमुपवासकृशोऽबलः।\nफलमूलोत्तराहारः शान्तः शिष्टाकृतिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076030, "chapter_id": 2611, "verse_number": "१२-११६-११", "content_sanskrit": "तस्यर्षेरुपविष्टस्य पादमूले महामतेः।\nमनुष्यवद्गतो भावं स्नेहबद्धोऽभवद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076031, "chapter_id": 2611, "verse_number": "१२-११६-१२", "content_sanskrit": "ततोऽभ्ययान्महारौद्रो द्वीपी क्षतजभोजनः।\nश्वार्थमत्यर्थमुद्धुष्टः क्रूरः कालइवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076032, "chapter_id": 2611, "verse_number": "१२-११६-१३", "content_sanskrit": "लेलिह्यमानस्तृषितः पुच्छास्फोटनतत्परः।\nव्यादितास्यः क्षुधाः भुग्नः प्रार्थयानस्तदामिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076033, "chapter_id": 2611, "verse_number": "१२-११६-१४", "content_sanskrit": "दृष्ट्वा तं क्रूरमायान्तं जीवितार्थी नराधिप।\nप्रोवाच श्वा मुनिं तत्र तच्छृणुष्व विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076034, "chapter_id": 2611, "verse_number": "१२-११६-१५", "content_sanskrit": "श्वशत्रुर्भगवन्नेष द्वीपी मां हन्तुमिच्छति।\nत्वत्प्रसादाद्भयं न स्यादस्मान्मम महामुने।\n[तथा कुरु महाबाहो सर्वज्ञस्त्वं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076035, "chapter_id": 2611, "verse_number": "१२-११६-१६", "content_sanskrit": "स मुनिस्तस्य विज्ञाय भावज्ञो भयकारणम्।\nरुतज्ञः सर्वसत्वानां तमैश्वर्यसमन्वितः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076036, "chapter_id": 2611, "verse_number": "१२-११६-१७x", "content_sanskrit": "मुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076037, "chapter_id": 2611, "verse_number": "१२-११६-१७", "content_sanskrit": "न भयं द्वीपिनः कार्यं मृत्युतस्ते कथंचन।\nएष श्वरूपरहितो द्वीपी भवसि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076038, "chapter_id": 2611, "verse_number": "१२-११६-१८", "content_sanskrit": "ततः श्वा द्वीपितां नीतो जाम्बूनदनिभाकृति।\nचित्राङ्गो विस्फुरद्दंष्ट्रो वने वसति निर्भयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076039, "chapter_id": 2611, "verse_number": "१२-११६-१९", "content_sanskrit": "तं दृष्ट्वा संमुखे द्वीपी आत्मनः सदृशं पशुम्।\nअविरुद्धस्ततस्तस्य क्षणेन समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076040, "chapter_id": 2611, "verse_number": "१२-११६-२०", "content_sanskrit": "ततोऽभ्ययान्महारौद्रो व्यादितास्यः क्षुधान्विः।\nद्वीपिनं लेलिहन्वक्रं व्याघ्रो रुधिरलालसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076041, "chapter_id": 2611, "verse_number": "१२-११६-२१", "content_sanskrit": "व्याघ्रं दृष्ट्वा क्षुधा भुग्नं दंष्ट्रिणं वनचारिणम्।\nद्वीपि जीवितरक्षार्थमृषिं शरणमेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076042, "chapter_id": 2611, "verse_number": "१२-११६-२२", "content_sanskrit": "ततः संवासजं स्नेहमृषिणा कुर्वता तदा।\nस द्वीपी व्याघ्रतां नीतो रिपुभ्यो बलवत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076043, "chapter_id": 2611, "verse_number": "१२-११६-२३", "content_sanskrit": "ततोऽदृष्ट्वा स शार्दूलो नाभ्यघ्नत्तं विशांपते।\nस तु श्चा व्याघ्रतां प्राप्य बलवान्पिशिताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076044, "chapter_id": 2611, "verse_number": "१२-११६-२४", "content_sanskrit": "न मूलफलभोगेषु स्पृहामप्यकरोत्तदा।\nयथा मृगपतिर्नित्यं प्रकाङ्क्षति वनौकसः।\nतथैव स महाराज व्याघ्रः समभवत्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076045, "chapter_id": 2611, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षोडशाधिकशततमोऽध्यायः॥ ११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]