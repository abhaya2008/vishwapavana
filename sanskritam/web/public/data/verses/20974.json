[{"id": 7000974000, "chapter_id": 20974, "verse_number": "२-१४-१", "content_sanskrit": "श्रीपराशर उवाच ।\nनिशम्य तस्येति वचः परमार्थसमन्वितम् ।\nप्रश्रयावनतो भूत्वा तमाह नृपतिर्द्विजम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000974001, "chapter_id": 20974, "verse_number": "२-१४-२", "content_sanskrit": "राजोवाच ।\nभगवन्यत्त्वया प्रोक्तं परमार्थमयं वचः ।\nश्रुते तस्मिन्भ्रमन्तीव मनसो मम वृत्तयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000974002, "chapter_id": 20974, "verse_number": "२-१४-३", "content_sanskrit": "एतद्विवेकविज्ञानं यदशेषेषु जन्तुषु ।\nभवता दर्शितं विप्र तत्परं प्रकृतेर्महत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000974003, "chapter_id": 20974, "verse_number": "२-१४-४", "content_sanskrit": "नाहं वहामि शिबिकां शिबिका न मयि स्थिता ।\nशरीरमन्यदस्मत्तो येनेयं शिबिका धृता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000974004, "chapter_id": 20974, "verse_number": "२-१४-५", "content_sanskrit": "गुणप्रवृत्त्या भूतानां प्रवृत्तिः कर्मचोदिता ।\nप्रवर्तन्ते गुणा ह्येते किं ममेति त्वयोदितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000974005, "chapter_id": 20974, "verse_number": "२-१४-६", "content_sanskrit": "एतस्मिन्परमार्थज्ञ मम श्रोत्रपथं गते ।\nमनो विह्वलतामेति परमार्थार्थितां गतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000974006, "chapter_id": 20974, "verse_number": "२-१४-७", "content_sanskrit": "पूर्वमेव महाभागं कपिलर्षिमहं द्विज ।\nप्रष्टुमभ्युद्यतो गत्वा श्रेयः किं त्वत्र शंस मे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000974007, "chapter_id": 20974, "verse_number": "२-१४-८", "content_sanskrit": "तदन्तरे च भवता यदेतद्वाक्यमीरितम् ।\nतेनैव परमार्थार्थं त्वयि चेतः प्रधावति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000974008, "chapter_id": 20974, "verse_number": "२-१४-९", "content_sanskrit": "कपिलर्षिर्भगवतः सर्वभूतस्य वै द्विज ।\nविष्णोरंशो जगन्मोहनाशायोर्वीमुपागतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000974009, "chapter_id": 20974, "verse_number": "२-१४-१०", "content_sanskrit": "स एव  भगवान्नूनमस्माकं हितकाम्यया ।\nप्रत्यक्षतामत्र गतो यथैतद्भावतोच्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000974010, "chapter_id": 20974, "verse_number": "२-१४-११", "content_sanskrit": "तन्मह्यं प्रणताय त्वं यच्छ्रेयः परमं द्विजः ।\nतद्वदाखिल विज्ञानजलवीच्युदधिर्भवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000974011, "chapter_id": 20974, "verse_number": "२-१४-१२", "content_sanskrit": "ब्राह्मण उवाच ।\nभूप पृच्छसि किं श्रेयः परमार्थं नु पृच्छसि ।\nश्रेयांस्यपरमार्थानि अशेषाणि च भूपते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000974012, "chapter_id": 20974, "verse_number": "२-१४-१३", "content_sanskrit": "देवताराधनं कृत्वा धनसम्पदमिच्छति ।\nपुत्रानिच्छति राज्यं च श्रेयस्तस्यैव तन्नृप ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000974013, "chapter_id": 20974, "verse_number": "२-१४-१४", "content_sanskrit": "कर्म यज्ञात्मकं श्रेयः फलं तत्प्राप्तिलक्षणम् ।\nश्रेयः प्रधानं च फले तदेवानभिसंहिते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000974014, "chapter_id": 20974, "verse_number": "२-१४-१५", "content_sanskrit": "आत्मा ध्येयः सदा भूप योगयुक्तैस्तथा परम् ।\nश्रेयस्तस्यैव संयोगः श्रेयो यः परमात्मनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000974015, "chapter_id": 20974, "verse_number": "२-१४-१६", "content_sanskrit": "श्रेयांस्येवमनेकानि शतशोय सहस्रसः ।\nसन्त्यत्र परमार्थस्तु न त्वेते श्रूयतां च मे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000974016, "chapter_id": 20974, "verse_number": "२-१४-१७", "content_sanskrit": "धर्माय त्यज्यते किन्तु परमार्थो धनं यदि ।\nव्ययश्च क्रियते कस्मात्कामप्राप्त्युपलक्षणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000974017, "chapter_id": 20974, "verse_number": "२-१४-१८", "content_sanskrit": "पुत्रश्चेत्परमार्थः स्यात्सोऽप्यन्यस्य नरेश्वर ।\nपरमार्थभूतः सोन्यस्य परमार्थो हि तत्पिता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000974018, "chapter_id": 20974, "verse_number": "२-१४-१९", "content_sanskrit": "एवं न परमार्थोस्ति जगत्यस्मिञ्चराचरे ।\nपरमार्थो हि कार्याणि कारणानामशेषतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000974019, "chapter_id": 20974, "verse_number": "२-१४-२०", "content_sanskrit": "राज्यादिप्राप्तिरत्रोक्ता परमार्थतया यदि ।\nपरमार्था भवन्त्यत्र न भवन्ति च वै ततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000974020, "chapter_id": 20974, "verse_number": "२-१४-२१", "content_sanskrit": "ऋग्यजुःसामनिष्पाद्यं यज्ञकर्म मतं तव ।\nपरमार्थभूतं तत्रापि श्रूयतां गदतो मम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000974021, "chapter_id": 20974, "verse_number": "२-१४-२२", "content_sanskrit": "यत्तु निष्पाद्यते कार्यं मृदा कारणभूतया ।\nतत्कारणानुगमनाज्ज्ञायते नृप मृण्मयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000974022, "chapter_id": 20974, "verse_number": "२-१४-२३", "content_sanskrit": "एवं विनाशिभिर्द्रव्यैः समिदाज्यकुशादिभिः ।\nनिष्पाद्यते क्रिया या तु सा भवित्री विनाशिनी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000974023, "chapter_id": 20974, "verse_number": "२-१४-२४", "content_sanskrit": "अनाशो परमार्थश्च प्राज्ञौरभ्युपगम्यते ।\nतत्तु नाशि न सन्देहो नाशिद्रव्योपपादितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000974024, "chapter_id": 20974, "verse_number": "२-१४-२५", "content_sanskrit": "तदेवाफलदं कर्म परमार्थो मतस्तव ।\nमुक्तिसाधनभूतत्वात्परमार्थो न साधनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000974025, "chapter_id": 20974, "verse_number": "२-१४-२६", "content_sanskrit": "ध्यानं चैवात्मनो भूपु परमार्थार्थशब्दितम् ।\nभेदकारि परेभ्यस्तु परमार्थो न भेदवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000974026, "chapter_id": 20974, "verse_number": "२-१४-२७", "content_sanskrit": "परमात्मात्मनोर्योगः परमार्थ इतीष्यते ।\nमिथ्यैतदन्यद्रव्यं हि नैति तद्द्रव्यतां यतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000974027, "chapter_id": 20974, "verse_number": "२-१४-२८", "content_sanskrit": "तस्माच्छ्रेयांस्यशेषाणि नृवैतानि न संशयः ।\nपरमार्थस्तु भूपाल संक्षेपाच्छ्रूयतां मम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000974028, "chapter_id": 20974, "verse_number": "२-१४-२९", "content_sanskrit": "एको व्यापी समः शुद्धो निर्गुणः प्रकृतेः परः ।\nजन्मवृद्ध्यादिरहित आत्मा सर्वगतोव्ययः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000974029, "chapter_id": 20974, "verse_number": "२-१४-३०", "content_sanskrit": "परज्ञानमयो सद्भिर्नामजात्यादिभिर्विभुः ।\nन योगवान्न युक्तोभून्नैव पार्थिव योक्ष्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000974030, "chapter_id": 20974, "verse_number": "२-१४-३१", "content_sanskrit": "तस्यात्मपरदेहेषु सतोप्येकमयं हि यत् ।\nविज्ञानं परमार्थोऽसौ द्वैतिनोऽतथ्यर्शिनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000974031, "chapter_id": 20974, "verse_number": "२-१४-३२", "content_sanskrit": "वेणुरन्ध्रप्रभेदेन भेदः षङ्जादिसंज्ञितः ।\nअभेदव्यापिनोवायोस्तथास्य परमात्मनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000974032, "chapter_id": 20974, "verse_number": "२-१४-३३", "content_sanskrit": "एकस्वरूपभेदश्च ब्राह्मकर्मावृतिप्रजः ।\nदेवादिभेदेऽपध्वस्ते नास्त्येवावरणे हि सः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]