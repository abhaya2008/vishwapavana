[{"id": 2195888, "chapter_id": 5175, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195889, "chapter_id": 5175, "verse_number": "१", "content_sanskrit": "ब्राह्मणानां तु ये लोके प्रतिश्रुत्य पितामह ।\nन प्रयच्छन्ति मोहात् ते के भवन्ति महामते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195890, "chapter_id": 5175, "verse_number": "२", "content_sanskrit": "एतन्मे तत्त्वतो ब्रूहि धर्मं धर्मभृतांवर ।\nप्रतिश्रुत्य दुरात्मानो न प्रयच्छन्ति ये नराः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195891, "chapter_id": 5175, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195892, "chapter_id": 5175, "verse_number": "३", "content_sanskrit": "यो न दद्यात् प्रतिश्रुत्य स्वल्पं वा यदि वा बहु ।\nआशास्तस्य हताः सर्वाः क्लीबस्येव प्रजाफलम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195893, "chapter_id": 5175, "verse_number": "४", "content_sanskrit": "यां रात्रिं जायते पापो यां च रात्रिं विनश्यति ।\nएतस्मिन्नन्तरे यद्यत्सुकृतं तस्य भारत ।\nयच्च तस्य हुतं किञ्चित् सर्वं तस्योपहन्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195894, "chapter_id": 5175, "verse_number": "५", "content_sanskrit": "तपस्तप्तमथो वापि प्राहुर्धर्मशास्त्रविदो जनाः ।\nनिशम्य भरतश्रेष्ठ बुद्ध्या परमयुक्तया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195895, "chapter_id": 5175, "verse_number": "६", "content_sanskrit": "अपि चोदाहरन्तीमं धर्मशास्त्रविदो जनाः ।\nअश्वानां श्यामकर्णानां सहस्रेण स मुच्यते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195896, "chapter_id": 5175, "verse_number": "७", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम् ।\nसृगालस्य च संवादं वानरस्य च भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195897, "chapter_id": 5175, "verse_number": "८", "content_sanskrit": "तौ सखायौ पुरा ह्यास्तां मानुषत्वे परन्तप ।\nअन्यां योनिं समापन्नौ सार्गालीं वानरीं तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195898, "chapter_id": 5175, "verse_number": "९", "content_sanskrit": "पुरासखायं खादन्तं सृगालं वानरोऽब्रवीत् ।\nस्मशानमध्ये सम्प्रेक्ष्य पूर्वजातिमनुस्मरन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195899, "chapter_id": 5175, "verse_number": "१०", "content_sanskrit": "किं त्वया पापकं कर्म कृतं पूर्वं सुदारुणम् ।\nयस्त्वं स्मशाने मृतकान् पूतिकानत्सि कुत्सितान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195900, "chapter_id": 5175, "verse_number": "११", "content_sanskrit": "एवमुक्तः प्रत्युवाच सृगालो वानरं तदा ।\nब्राह्मणस्य प्रतिश्रुत्य न मया तदुपाकृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195901, "chapter_id": 5175, "verse_number": "१२", "content_sanskrit": "तत्कृते पापिकां योनिमापन्नोऽस्मि प्लवङ्गम ।\nतस्मादेवंविधं भक्ष्यं भक्षयामि बुभुक्षितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195902, "chapter_id": 5175, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195903, "chapter_id": 5175, "verse_number": "१३", "content_sanskrit": "सृगालो वानरं प्राह पुनरेव नृपोत्तम ।\nकिं त्वया पातकं कर्म कृतं येनासि वानरः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195904, "chapter_id": 5175, "verse_number": "१४", "content_sanskrit": "स चाप्याह ब्राह्मणानां फलाहारः प्लवङ्गमः ।\nतस्मान्न ब्राह्मणस्वं तु हर्तव्यं विदुषा सदा ।\nसीमाविवादे मोक्तव्यं दातव्यं च प्रतिश्रुतम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195905, "chapter_id": 5175, "verse_number": "१५", "content_sanskrit": "इत्येतद् ब्रुवतो राजन् ब्राह्मणस्य मया श्रुतम् ।\nकथां कथयतः पुण्यां धर्मज्ञस्य पुरातनीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195906, "chapter_id": 5175, "verse_number": "१६", "content_sanskrit": "श्रुतं चापि मया भूयः कृष्णस्यापि विशाम्पते ।\nकथां कथयतः पूर्वं ब्राह्मणं प्रति पाण्डव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195907, "chapter_id": 5175, "verse_number": "१७", "content_sanskrit": "एवमेव च मां नित्यं ब्राह्मणाः सन्दिशन्ति वै ।\nप्रतिश्रुत्य भवेद् देयं नाशा कार्या हि ब्राह्मणैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195908, "chapter_id": 5175, "verse_number": "१८", "content_sanskrit": "ब्राह्मणो ह्याशया पूर्वं कृतया पृथिवीपते ।\nसुसमिद्धो यथा दीप्तः पावकस्तद्विधः स्मृतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195909, "chapter_id": 5175, "verse_number": "१९", "content_sanskrit": "यं निरीक्षेत सङ्क्रुद्ध आशया पूर्वजातया ।\nप्रदहेत हि तं राजन् कक्षमक्षय्यभुग् यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195910, "chapter_id": 5175, "verse_number": "२०", "content_sanskrit": "स एव हि यदा तुष्टो वचसा प्रतिनन्दति ।\nभवत्यगदसङ्काशो विषये तस्य भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195911, "chapter_id": 5175, "verse_number": "२१", "content_sanskrit": "पुत्रान् पौत्रान् पशूंश्चैव बान्धवान् सचिवांस्तथा ।\nपुरं जनपदं चैव शान्तिरिष्टेव पुष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195912, "chapter_id": 5175, "verse_number": "२२", "content_sanskrit": "एतद्धि परमं तेजो ब्राह्मणस्येह दृश्यते ।\nसहस्रकिरणस्येव सवितुर्धरणीतळे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195913, "chapter_id": 5175, "verse_number": "२३", "content_sanskrit": "तस्माद् दातव्यमेवेह प्रतिश्रुत्य युधिष्ठिर ।\nयदीच्छेच्छोभनां जातिं प्राप्तुं भरतसत्तम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195914, "chapter_id": 5175, "verse_number": "२४", "content_sanskrit": "ब्राह्मणस्य हि दत्तेन ध्रुवं स्वर्गो ह्यनुत्तमः ।\nशक्यं प्राप्तुं विशेषेण दानं हि महती क्रिया\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195915, "chapter_id": 5175, "verse_number": "२५", "content_sanskrit": "इतो दत्तेन जीवन्ति देवताः पितरस्तथा ।\nतस्माद् दानानि देयानि ब्राह्मणेभ्यो विजानता\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195916, "chapter_id": 5175, "verse_number": "२६", "content_sanskrit": "महद्धि भरतश्रेष्ठ ब्राह्मणस्तीर्थमुच्यते ।\nवेलायां न तु कस्याञ्चिद् गच्छेद् विप्रो ह्यपूजितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195917, "chapter_id": 5175, "verse_number": "२६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे वानरसृगालसंवादो नाम षड्विंशतितमोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195918, "chapter_id": 5175, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]