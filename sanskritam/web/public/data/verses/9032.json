[{"id": 5000032000, "chapter_id": 9032, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000032001, "chapter_id": 9032, "verse_number": "१-३२-१", "content_sanskrit": "ब्रह्मयोनिर्महानासीत् कुशो नाम महातपाः ।\nअक्लिष्टव्रतधर्मज्ञः सज्जनप्रतिपूजकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000032002, "chapter_id": 9032, "verse_number": "१-३२-२", "content_sanskrit": "स महात्मा कुलीनायां युक्तायां सुमहाबलान् ।\nवैदर्भ्यां जनयामास चतुरः सदृशान् सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000032003, "chapter_id": 9032, "verse_number": "१-३२-३", "content_sanskrit": "कुशाम्बं कुशनाभं च असूर्तरजसं वसुम् ।\nदीप्तियुक्तान् महोत्साहान् क्षत्रधर्मचिकीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000032004, "chapter_id": 9032, "verse_number": "१-३२-४", "content_sanskrit": "तानुवाच कुशः पुत्रान् धर्मिष्ठान् सत्यवादिनः ।\nक्रियतां पालनं पुत्रा धर्मं प्राप्स्यथ पुष्कलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000032005, "chapter_id": 9032, "verse_number": "१-३२-५", "content_sanskrit": "कुशस्य वचनं श्रुत्वा चत्वारो लोकसत्तमाः ।\nनिवेशं चक्रिरे सर्वे पुराणां नृवरास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000032006, "chapter_id": 9032, "verse_number": "१-३२-६", "content_sanskrit": "कुशाम्बस्तु महातेजाः कौशाम्बीमकरोत् पुरीम् ।\nकुशनाभस्तु धर्मात्मा पुरं चक्रे महोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000032007, "chapter_id": 9032, "verse_number": "१-३२-७", "content_sanskrit": "असूर्तरजसो नाम धर्मारण्यं महीपतिः ।\nचक्रे पुरवरं राजा वसुनाम गिरिव्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000032008, "chapter_id": 9032, "verse_number": "१-३२-८", "content_sanskrit": "एषा वसुमती राम वसोस्तस्य महात्मनः ।\nएते शैलवराः पञ्च प्रकाशन्ते समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000032009, "chapter_id": 9032, "verse_number": "१-३२-९", "content_sanskrit": "सुमागधी नदी रम्या मागधान् विश्रुताऽऽययौ ।\nपञ्चानां शैलमुख्यानां मध्ये मालेव शोभते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000032010, "chapter_id": 9032, "verse_number": "१-३२-१०", "content_sanskrit": "सैषा हि मागधी राम वसोस्तस्य महात्मनः ।\nपूर्वाभिचरिता राम सुक्षेत्रा सस्यमालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000032011, "chapter_id": 9032, "verse_number": "१-३२-११", "content_sanskrit": "कुशनाभस्तु राजर्षिः कन्याशतमनुत्तमम् ।\nजनयामास धर्मात्मा घृताच्यां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000032012, "chapter_id": 9032, "verse_number": "१-३२-१२", "content_sanskrit": "तास्तु यौवनशालिन्यो रूपवत्यः स्वलङ्कृताः ।\nउद्यानभूमिमागम्य प्रावृषीव शतह्रदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000032013, "chapter_id": 9032, "verse_number": "१-३२-१३", "content_sanskrit": "गायन्त्यो नृत्यमानाश्च वादयन्त्यस्तु राघव ।\nआमोदं परमं जग्मुर्वराभरणभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000032014, "chapter_id": 9032, "verse_number": "१-३२-१४", "content_sanskrit": "अथ ताश्चारुसर्वाङ्ग्यो रूपेणाप्रतिमा भुवि ।\nउद्यानभूमिमागम्य तारा इव घनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000032015, "chapter_id": 9032, "verse_number": "१-३२-१५", "content_sanskrit": "ताः सर्वा गुणसम्पन्ना रूपयौवनसंयुताः ।\nदृष्ट्वा सर्वात्मको वायुरिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000032016, "chapter_id": 9032, "verse_number": "१-३२-१६", "content_sanskrit": "अहं वः कामये सर्वा भार्या मम भविष्यथ ।\nमानुषस्त्यज्यतां भावो दीर्घमायुरवाप्स्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000032017, "chapter_id": 9032, "verse_number": "१-३२-१७", "content_sanskrit": "चलं हि यौवनं नित्यं मानुषेषु विशेषतः ।\nअक्षयं यौवनं प्राप्ता अमर्यश्च भविष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000032018, "chapter_id": 9032, "verse_number": "१-३२-१८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा वायोरक्लिष्टकर्मणः ।\nअपहास्य ततो वाक्यं कन्याशतमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000032019, "chapter_id": 9032, "verse_number": "१-३२-१९", "content_sanskrit": "अन्तश्चरसि भूतानां सर्वेषां सुरसत्तम ।\nप्रभावज्ञाश्च ते सर्वाः किमर्थमवमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000032020, "chapter_id": 9032, "verse_number": "१-३२-२०", "content_sanskrit": "कुशनाभसुता देव सर्वाः समस्ताः सुरसत्तम ।\nस्थानाच्च्यावयितुं देवं रक्षामस्तु तपो वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000032021, "chapter_id": 9032, "verse_number": "१-३२-२१", "content_sanskrit": "मा भूत् स कालो दुर्मेधः पितरं सत्यवादिनम् ।\nअवमन्य स्वधर्मेण स्वयं वरमुपास्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000032022, "chapter_id": 9032, "verse_number": "१-३२-२२", "content_sanskrit": "पिता हि प्रभुरस्माकं दैवतं परमं च सः ।\nयस्य नो दास्यति पिता स नो भर्ता भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000032023, "chapter_id": 9032, "verse_number": "१-३२-२३", "content_sanskrit": "तासां तु वचनं श्रुत्वा हरिः परमकोपनः ।\nप्रविश्य सर्वगात्राणि बभञ्ज भगवान् प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000032024, "chapter_id": 9032, "verse_number": "१-३२-२४", "content_sanskrit": "अरत्निमात्राकृतयो भग्नगात्रा भयार्दिताः ।\nताः कन्या वायुना भग्ना विविशुर्नृपतेर्गृहम् ।\nप्रविश्य च सुसम्भ्रान्ताः सलज्जाः सास्रलोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000032025, "chapter_id": 9032, "verse_number": "१-३२-२५", "content_sanskrit": "स च ता दयिता भग्नाः कन्याः परमशोभनाः ।\nदृष्ट्वा दीनास्तदा राजा सम्भ्रान्त इदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000032026, "chapter_id": 9032, "verse_number": "१-३२-२६", "content_sanskrit": "किमिदं कथ्यतां पुत्र्यः को धर्ममवमन्यते ।\nकुब्जाः केन कृताः सर्वाश्चेष्टन्त्यो नाभिभाषथ ।\nएवं राजा विनिःश्वस्य समाधिं संदधे ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000032027, "chapter_id": 9032, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]