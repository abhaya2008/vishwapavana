[{"id": 5000644000, "chapter_id": 9644, "verse_number": "७-१०९-१", "content_sanskrit": "प्रभातायां तु शर्वर्यां पृथुवक्षा महायशाः ।\nरामः कमलपत्राक्षः पुरोधसमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000644001, "chapter_id": 9644, "verse_number": "७-१०९-२", "content_sanskrit": "अग्निहोत्रं व्रजत्वग्रे दीप्यमानं सह द्विजैः ।\nवाजपेयातपत्रं च शोभमानं महापथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000644002, "chapter_id": 9644, "verse_number": "७-१०९-३", "content_sanskrit": "ततो वसिष्ठस्तेजस्वी सर्वं निरवशेषतः ।\nचकार विधिवद्धर्मं महाप्रास्थानिकं विधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000644003, "chapter_id": 9644, "verse_number": "७-१०९-४", "content_sanskrit": "ततः सूक्ष्माम्बरधरो ब्रह्ममावर्तयन्परम् ।\nकुशान्गृहीत्वा पाणिभ्यां प्रसज्य प्रययावथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000644004, "chapter_id": 9644, "verse_number": "७-१०९-५", "content_sanskrit": "अव्याहरन्क्वचित्किञ्चिन्निश्चेष्टो निःसुखः पथि ।\nनिर्जगाम गृहात्तस्माद्दीप्यमान इवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000644005, "chapter_id": 9644, "verse_number": "७-१०९-६", "content_sanskrit": "रामस्य दक्षिणे पार्श्वे सपद्मा श्रीरपाश्रिता ।\nसव्ये तु ह्रीर्महादेवी व्यवसायस्तथाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000644006, "chapter_id": 9644, "verse_number": "७-१०९-७", "content_sanskrit": "शरा नानाविधाश्चापि धनुरायतमुत्तमम् ।\nतथा ऽ ऽयुधानि ते सर्वे ययुः पुरुषविग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000644007, "chapter_id": 9644, "verse_number": "७-१०९-८", "content_sanskrit": "वेदा ब्राह्मणरूपेण गायत्री सर्वरक्षिणी ।\nओङ्कारो ऽथ वषट्कारः सर्वे राममनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000644008, "chapter_id": 9644, "verse_number": "७-१०९-९", "content_sanskrit": "ऋषयश्च महात्मानः सर्व एव महीसुराः ।\nअन्वगच्छन्महात्मानं स्वर्गद्वारमपावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000644009, "chapter_id": 9644, "verse_number": "७-१०९-१०", "content_sanskrit": "तं यान्तमनुगच्छन्ति ह्यन्तःपुरचराः स्त्रियः ।\nसवृद्धबालदासीकाः सवर्षवरकिङ्कराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000644010, "chapter_id": 9644, "verse_number": "७-१०९-११", "content_sanskrit": "सान्तःपुरश्च भरतः शत्रुघ्नसहितो ययौ ।\nरामं गतिमुपागम्य साग्निहोत्रमनुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000644011, "chapter_id": 9644, "verse_number": "७-१०९-१२", "content_sanskrit": "ते च सर्वे महात्मानः साग्निहोत्राः समागताः ।\nसपुत्रदाराः काकुत्स्थमनुजग्मुर्महामतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000644012, "chapter_id": 9644, "verse_number": "७-१०९-१३", "content_sanskrit": "मन्त्रिणो भृत्यवर्गाश्च सपुत्रपशुबान्धवाः ।\nसर्वे सहानुगा राममन्वगच्छन्प्रहृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000644013, "chapter_id": 9644, "verse_number": "७-१०९-१४", "content_sanskrit": "ततः सर्वाः प्रकृतयो हृष्टपुष्टजनावृताः ।\nगच्छन्तमन्वगछंस्तं राघवं गुणरञ्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000644014, "chapter_id": 9644, "verse_number": "७-१०९-१५", "content_sanskrit": "ततः सस्त्रीपुमांसस्ते सपक्षिपशुवाहनाः ।\nराघवस्यानुगाः सर्वे हृष्टा विगतकल्मषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000644015, "chapter_id": 9644, "verse_number": "७-१०९-१६", "content_sanskrit": "स्नाताः प्रमुदिताः सर्वे हृष्टाः पुष्टाश्च वानराः ।\nदृढं किलकिलाशब्दैः सर्वं राममनुव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000644016, "chapter_id": 9644, "verse_number": "७-१०९-१७", "content_sanskrit": "न तत्र कश्चिद्दीनो वा व्रीडितो वा ऽपि दुःखितः ।\nहृष्टं समुदितं सर्वं बभूव परमाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000644017, "chapter_id": 9644, "verse_number": "७-१०९-१८", "content_sanskrit": "द्रष्टुकामो ऽथ निर्यान्तं रामं जानपदो जनः ।\nयः प्राप्तः सो ऽपि दृष्ट्वैव स्वर्गायानुगतो मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000644018, "chapter_id": 9644, "verse_number": "७-१०९-१९", "content_sanskrit": "ऋक्षवानररक्षांसि जनाश्च पुरवासिनः ।\nआगच्छन्परया भक्त्या पृष्ठतः सुसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000644019, "chapter_id": 9644, "verse_number": "७-१०९-२०", "content_sanskrit": "यानि भूतानि नगरे ऽप्यन्तर्धानगतानि च ।\nराघवं तान्यनुययुः स्वर्गाय समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000644020, "chapter_id": 9644, "verse_number": "७-१०९-२१", "content_sanskrit": "यानि पश्यन्ति काकुत्स्थं स्थावराणि चराणि च ।\nसर्वाणि रामगमने ह्यनुजग्मुर्हि तान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000644021, "chapter_id": 9644, "verse_number": "७-१०९-२२", "content_sanskrit": "नोच्छ्वसत्तदयोध्यायां सुसूक्ष्ममपि दृश्यते ।\nतिर्यग्योनिगताश्चापि सर्वे राममनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000644022, "chapter_id": 9644, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे नवाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]