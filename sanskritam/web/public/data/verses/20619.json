[{"id": 7000619000, "chapter_id": 20619, "verse_number": "५-७८-१", "content_sanskrit": "पार्वत्युवाच ।\nवैष्णवानां च यद्धर्मं सर्वं तथ्यं च मे वद ।\nयत्कृत्वा मानवाः सर्वे भवांभोधिं तरंति हि॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000619001, "chapter_id": 20619, "verse_number": "५-७८-२", "content_sanskrit": "ईश्वर उवाच ।\nअथ द्वादशधा शुद्धिर्वैष्णवानामिहोच्यते ।\nगृहोपलेपनं चैव तथानुगमनं हरेः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000619002, "chapter_id": 20619, "verse_number": "५-७८-३", "content_sanskrit": "भक्त्या प्रदक्षिणा चैव पादयोः शोधनं पुनः ।\nपूजार्थं पत्रपुष्पाणां भक्त्यैवोत्तोलनं हरेः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000619003, "chapter_id": 20619, "verse_number": "५-७८-४", "content_sanskrit": "करयोः सर्वशुद्धीनामियं शुद्धिर्विशिष्यते ।\nतन्नामकीर्तनं चैव गुणानामपि कीर्त्तनम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000619004, "chapter_id": 20619, "verse_number": "५-७८-५", "content_sanskrit": "भक्त्या श्रीकृष्णदेवस्य वचसः शुद्धिरिष्यते ।\nतत्कथाश्रवणं चैव तस्योत्सवनिरीक्षणम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000619005, "chapter_id": 20619, "verse_number": "५-७८-६", "content_sanskrit": "श्रोत्रयोर्नेत्रयोश्चैव शुद्धिः सम्यगिहोच्यते ।\nपादोदकं च निर्माल्यं मालानामपि धारणम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000619006, "chapter_id": 20619, "verse_number": "५-७८-७", "content_sanskrit": "उच्यते शिरसः शुद्धिः प्रणतस्य हरेः पुरः ।\nआघ्राणं तस्य पुष्पादेर्निर्माल्यस्य तथा प्रिये॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000619007, "chapter_id": 20619, "verse_number": "५-७८-८", "content_sanskrit": "विशुद्धिः स्यादंतरस्य घ्राणस्यापि विधीयते ।\nयत्र पुष्पादिकं यच्च कृष्णपादयुगार्पितम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000619008, "chapter_id": 20619, "verse_number": "५-७८-९", "content_sanskrit": "तदेकं पावनं लोके तद्धि सर्वं विशोधयेत् ।\nपूजा च पंचधा प्रोक्ता तासां भेदं शृणुष्व मे॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000619009, "chapter_id": 20619, "verse_number": "५-७८-१०", "content_sanskrit": "अभिगमनमुपादानं योगः स्वाध्याय एव च ।\nइज्या पंचप्रकारार्चा क्रमेण कथयामि ते॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000619010, "chapter_id": 20619, "verse_number": "५-७८-११", "content_sanskrit": "तत्वाभिगमनं नाम देवतास्थानमार्जनम् ।\nउपलेपं च निर्माल्यदूरीकरणमेव च॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000619011, "chapter_id": 20619, "verse_number": "५-७८-१२", "content_sanskrit": "उपादानं नाम गंध पुष्पादिचयनं तथा ।\nयोगो नाम स्वदेवस्य स्वात्मनैवात्मभावना॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000619012, "chapter_id": 20619, "verse_number": "५-७८-१३", "content_sanskrit": "स्वाध्यायो नाम मंत्रार्थानुसंधापूर्वको जपः ।\nसूक्तस्तोत्रादिपाठश्च हरेः संकीर्त्तनं तथा॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000619013, "chapter_id": 20619, "verse_number": "५-७८-१४", "content_sanskrit": "तत्त्वादिशास्त्राभ्यासश्च स्वाध्यायः परिकीर्तितः ।\nइज्या नाम स्वदेवस्य पूजनं च यथार्थतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000619014, "chapter_id": 20619, "verse_number": "५-७८-१५", "content_sanskrit": "इति पंचप्रकारार्चा कथिता तव सुव्रते ।\nसार्ष्टि सामीप्य सालोक्य सायुज्य सारूप्यदा क्रमात्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000619015, "chapter_id": 20619, "verse_number": "५-७८-१६", "content_sanskrit": "प्रसंगात्कथयिष्यामि शालग्रामशिलार्चनम् ।\nकेशवादेश्चतुर्बाहोर्दक्षिणोर्ध्वकरक्रमात्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000619016, "chapter_id": 20619, "verse_number": "५-७८-१७", "content_sanskrit": "शंखचक्रगदापद्मी केशवाख्यो गदाधरः ।\nनारायणः पद्मगदाचक्रशंखायुधैः क्रमात्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000619017, "chapter_id": 20619, "verse_number": "५-७८-१८", "content_sanskrit": "माधवश्चक्रशंखाभ्यां पद्मेन गदया भवेत् ।\nगदाब्जशंखचक्री च गोविंदाख्यो गदाधरः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000619018, "chapter_id": 20619, "verse_number": "५-७८-१९", "content_sanskrit": "पद्मशंखारि गदिने विष्णुरूपाय ते नमः ।\nसशंखाब्ज गदाचक्र मधुसूदन मूर्तये॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000619019, "chapter_id": 20619, "verse_number": "५-७८-२०", "content_sanskrit": "नमो गदारिशंखाब्जयुक्तत्रिविक्रमाय च ।\nसारिकौमोदकी पद्मशंख वामन मूर्त्तये॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000619020, "chapter_id": 20619, "verse_number": "५-७८-२१", "content_sanskrit": "चक्राब्जशंखगदिने नमः श्रीधरमूर्त्तये ।\nहृषीकेशसारिगदाशंखपद्मिन्नमोस्तु ते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000619021, "chapter_id": 20619, "verse_number": "५-७८-२२", "content_sanskrit": "साब्जशंखगदाचक्रपद्मनाभ स्वमूर्त्तये ।\nदामोदरशंखगदाचक्रपद्मिन्नमोस्तु ते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000619022, "chapter_id": 20619, "verse_number": "५-७८-२३", "content_sanskrit": "शंखाब्जचक्रगदिने नमः संकर्षणाय च ।\nसारिशंखगदाब्जाय वासुदेव नमोस्तुते॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000619023, "chapter_id": 20619, "verse_number": "५-७८-२४", "content_sanskrit": "शंखचक्रगदाब्जाय धृत प्रद्युम्नमूर्त्तये ।\nनमोऽनिरुद्धाय गदाशंखाब्जारिविधारिणे॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000619024, "chapter_id": 20619, "verse_number": "५-७८-२५", "content_sanskrit": "साब्जशंखगदाचक्रपुरुषोत्तममूर्त्तये ।\nनमोऽधोक्षजरूपाय गदाशंखारि पद्मिने॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000619025, "chapter_id": 20619, "verse_number": "५-७८-२६", "content_sanskrit": "नृसिंहमूर्त्तये पद्मगदाशंखारिधारिणे ।\nपद्मारिशंखगदिने नमोस्त्वच्युतमूर्त्तये॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000619026, "chapter_id": 20619, "verse_number": "५-७८-२७", "content_sanskrit": "सगदाब्जारिशंखाय नमः श्रीकृष्णमूर्त्तये ।\nशालग्रामशिलाद्वारगतलग्नद्विचक्रधृक्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000619027, "chapter_id": 20619, "verse_number": "५-७८-२८", "content_sanskrit": "शुक्लाभरेखः शोभाढ्यः सदेवः श्रीगदाधरः ।\nलग्नद्विचक्रो रक्ताभः पूर्वभागस्तु पुष्कलः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000619028, "chapter_id": 20619, "verse_number": "५-७८-२९", "content_sanskrit": "संकर्षणोऽथ प्रद्युम्नः सूक्ष्मचक्रस्तु पीतकः ।\nसुदीर्घसुषिरच्छिद्रो ह्यनिरुद्धस्तु वर्त्तुलः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000619029, "chapter_id": 20619, "verse_number": "५-७८-३०", "content_sanskrit": "नीलो द्वारे त्रिरेखश्च अथ नारायणोऽसितः ।\nमध्ये गदाकृती रेखा नाभिपद्मं महोन्नतम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000619030, "chapter_id": 20619, "verse_number": "५-७८-३१", "content_sanskrit": "पृथुचक्रो नृसिंहो यः कपिलो यस्त्रिबिंदुकः ।\nअथवा पंचबिंदोस्तु पूजनं ब्रह्मचारिणः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000619031, "chapter_id": 20619, "verse_number": "५-७८-३२", "content_sanskrit": "वराहः स त्रिलिंगो यो विषमद्वयचक्रकः ।\nनीलस्त्रिरेखः स्थूलोऽथ कूर्ममूर्तिः सबिंदुकः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000619032, "chapter_id": 20619, "verse_number": "५-७८-३३", "content_sanskrit": "कृष्णः सवर्तुलावर्त्त पांडुरो धृतपृष्ठकः ।\nश्रीधरः पंचरेखश्च वनमाली गदांकितः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000619033, "chapter_id": 20619, "verse_number": "५-७८-३४", "content_sanskrit": "वामनो वर्तुलो नाम मध्यचक्रः सनीलकः ।\nनानावर्णानेकमूर्ति नागभोगी त्वनंतकः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000619034, "chapter_id": 20619, "verse_number": "५-७८-३५", "content_sanskrit": "स्थूलो दामोदरो नीलो मध्ये चक्रः सनीलकः ।\nसंकर्षणद्वारकोव्यादथ ब्रह्मा सुलोहितः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000619035, "chapter_id": 20619, "verse_number": "५-७८-३६", "content_sanskrit": "सुदीर्घरेखासुषिर एकचक्रांबुजः पृथुः ।\nपृथुचक्रः स्थूलछिद्रः कृष्णो बिंदुश्च बिंदुमान्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000619036, "chapter_id": 20619, "verse_number": "५-७८-३७", "content_sanskrit": "ह्यग्रीवोंऽकुशाकारः पंचरेखः सकौस्तुभः ।\nवैकुंठो मल्लवद्भाति एकचक्रमयोसितः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000619037, "chapter_id": 20619, "verse_number": "५-७८-३८", "content_sanskrit": "मत्स्यो दीर्घांबुजाकारो दीर्घरेखश्च पांडुरः ।\nरामचक्रो दक्षरेखो यः श्यामः स त्रिविक्रमः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000619038, "chapter_id": 20619, "verse_number": "५-७८-३९", "content_sanskrit": "शालग्रामद्वारकायां स्थिताय गदिने नमः ।\nएकेन लक्षितो योव्याद्गदाधारी सुदर्शनः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000619039, "chapter_id": 20619, "verse_number": "५-७८-४०", "content_sanskrit": "लक्ष्मीनारायणो द्वाभ्यां त्रिभिश्चैव त्रिविक्रमः ।\nचतुर्भिश्च चतुर्व्यूहो वासुदेवश्च पंचभिः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000619040, "chapter_id": 20619, "verse_number": "५-७८-४१", "content_sanskrit": "प्रद्युम्नः षड्भिरेवाव्यात्संकर्षणश्च सप्तभिः ।\nपुरुषोत्तमोऽष्टभिश्च स्यान्नवव्यूहो नवो हितः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000619041, "chapter_id": 20619, "verse_number": "५-७८-४२", "content_sanskrit": "दशावतारो दशभिरनिरुद्धोऽवतादथ ।\nद्वादशात्मा द्वादशभिरतऊर्द्ध्वमनंतकः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000619042, "chapter_id": 20619, "verse_number": "५-७८-४३", "content_sanskrit": "ब्रह्मा चतुर्मुखो दंडी कमंडलुस्रगुन्नतः ।\nमहेश्वरः पंचवक्त्रो दशबाहुर्वृषध्वजः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000619043, "chapter_id": 20619, "verse_number": "५-७८-४४", "content_sanskrit": "यथायुधस्तथागौरी चंडिका च सरस्वती ।\nमहालक्ष्मीर्मातरश्च पद्महस्तो दिवाकरः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000619044, "chapter_id": 20619, "verse_number": "५-७८-४५", "content_sanskrit": "गजास्यश्च गजस्कंधः षण्मुखोनेकधा गणाः ।\nएते स्थिताः स्थापिता स्युः प्रसादेवाथ पूजिताः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000619045, "chapter_id": 20619, "verse_number": "५-७८-४६", "content_sanskrit": "धर्मार्थकाममोक्षा हि प्राप्यंते पुरुषेण च॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]