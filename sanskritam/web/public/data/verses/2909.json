[{"id": 2089211, "chapter_id": 2909, "verse_number": "१३-३९-१", "content_sanskrit": "`सनत्कुमार उवाच।\nअधःस्रोतसि सर्गे च तिर्यक्स्रोतसि चैव हि।\nएताभ्यामीश्वरं विन्द्यादूर्ध्वस्रोतस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089212, "chapter_id": 2909, "verse_number": "१३-३९-२", "content_sanskrit": "कर्मेन्द्रियाणां पञ्चानामीश्वरो बुद्धिगोचरः।\nबुद्धीन्द्रियाणामपि तु ईश्वरो मन उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089213, "chapter_id": 2909, "verse_number": "१३-३९-३", "content_sanskrit": "मनसः पञ्चभूतानि सगुणान्याहुरीश्वरम्।\nभूतानामीश्वरं विद्याद्ब्रह्माणं परमेष्ठिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089214, "chapter_id": 2909, "verse_number": "१३-३९-४", "content_sanskrit": "भवान्हि कुशलश्चैव धर्मेष्वेषु परेषु वै।\nकालाग्निरह्नः कल्पान्ते जगद्दहति चांशुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089215, "chapter_id": 2909, "verse_number": "१३-३९-५", "content_sanskrit": "ततः सर्वाणि भूतानि स्थावराणि चराणि च।\nमहाभूतानि दग्धानि स्वां योनिं गमितानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089216, "chapter_id": 2909, "verse_number": "१३-३९-६", "content_sanskrit": "कूर्मपृष्ठनिभा भूमिर्निर्दग्धकुशकण्टका।\nनिर्वृक्षा निस्तृणा चैव दग्धा कालाग्निना तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089217, "chapter_id": 2909, "verse_number": "१३-३९-७", "content_sanskrit": "जगत्प्रलीनं जगति जगच्चापि प्रलीयते।\nनष्टिगन्धा तदा सूक्ष्मा जलमेवाभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089218, "chapter_id": 2909, "verse_number": "१३-३९-८", "content_sanskrit": "ततो मयूखजालेन सूर्यस्त्वापीयते जलम्।\nरसात्मा लीयते चार्के तथा ब्राह्मणसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089219, "chapter_id": 2909, "verse_number": "१३-३९-९", "content_sanskrit": "अन्तरिक्षगतान्भूतान्प्रदहत्यनलस्तदा।\nअग्निभूतं तदा व्योम भवतीत्यभिचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089220, "chapter_id": 2909, "verse_number": "१३-३९-१०", "content_sanskrit": "तं तथा विस्फुरद्वह्निं वायुर्जरयते महान्।\nमहता बलवेगेन आदत्ते तं हि भानुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089221, "chapter_id": 2909, "verse_number": "१३-३९-११", "content_sanskrit": "वायोरपि गुणं स्पर्शमाकाशं ग्रसते यदा।\nप्रशाम्यति तदा वायुः खं तु तिष्ठति नानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089222, "chapter_id": 2909, "verse_number": "१३-३९-१२", "content_sanskrit": "तस्य तं निनदं शब्दमादत्ते वै मनस्तदा।\nस शब्दगुणहीनात्मा तिष्ठते मूर्तिमांस्तु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089223, "chapter_id": 2909, "verse_number": "१३-३९-१३", "content_sanskrit": "भुङ्क्ते च स तदा व्योम मनस्तात दिगात्मकम्।\nव्योमात्मनि विनष्टे तु सङ्कल्पात्मा विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089224, "chapter_id": 2909, "verse_number": "१३-३९-१४", "content_sanskrit": "सङ्कल्पात्मानमादत्ते चित्तं वै स्वेन तेजसा।\nचित्तं ग्रसत्यहङ्कारस्तदा वै मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089225, "chapter_id": 2909, "verse_number": "१३-३९-१५", "content_sanskrit": "विनष्टे च तदा चित्ते अहङ्कारोऽभवन्महान्।\nअहङ्कारं तदादत्ते महान्ब्रह्मा प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089226, "chapter_id": 2909, "verse_number": "१३-३९-१६", "content_sanskrit": "अभिमाने विनष्टे तु महान्ब्रह्मा विराजते।\nतं तदा त्रिषु लोकेषु मूर्तिष्वेवाग्रमूर्तिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089227, "chapter_id": 2909, "verse_number": "१३-३९-१७", "content_sanskrit": "येन विश्वमिदं कृत्स्नं निर्मितं वै गुणार्थिना।\nमूर्तं जलेचरमपि व्यवसायगुणात्मकम्।\nग्रसिष्णुर्भगवान्ब्रह्मा व्यक्ताव्यक्तमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089228, "chapter_id": 2909, "verse_number": "१३-३९-१८", "content_sanskrit": "एषोऽव्ययस्य प्रलयो मया ते परिकीर्तितः।\nअध्यात्ममधिभूतं च अधिदैवं च श्रूयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089229, "chapter_id": 2909, "verse_number": "१३-३९-१९", "content_sanskrit": "आकाशं प्रथमं भूतं श्रोत्रमध्यात्मं शब्दोधिभूतं दिशोधिदैवतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089230, "chapter_id": 2909, "verse_number": "१३-३९-२०", "content_sanskrit": "वायुर्द्वितीयं भूतं त्वगध्यात्मं स्पर्शोधिभूतं विद्युदधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089231, "chapter_id": 2909, "verse_number": "१३-३९-२१", "content_sanskrit": "ज्योतिस्तृतीयं भूतं चक्षुरध्यात्मं रूपमधिभूतं सूर्योधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089232, "chapter_id": 2909, "verse_number": "१३-३९-२२", "content_sanskrit": "आपश्चतुर्थं भूतं जिह्वाध्यात्मं रसोधिभूतं वरुणोधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089233, "chapter_id": 2909, "verse_number": "१३-३९-२३", "content_sanskrit": "पृथिवी पञ्चमं भूतं ध्राणमध्यात्मं गन्धोधिभूतं वायुरधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089234, "chapter_id": 2909, "verse_number": "१३-३९-२४", "content_sanskrit": "पाञ्चभौतिकमेतच्चतुष्टयं वर्णितम्। अत ऊर्ध्वमिन्द्रियमनुवर्णयिष्यामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089235, "chapter_id": 2909, "verse_number": "१३-३९-२५", "content_sanskrit": "पादावध्यात्मं गन्तव्यमधिभूतं विष्णुरधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089236, "chapter_id": 2909, "verse_number": "१३-३९-२६", "content_sanskrit": "हस्तावध्यात्मं कर्तव्यमधिभूतमिन्द्रोऽधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089237, "chapter_id": 2909, "verse_number": "१३-३९-२७", "content_sanskrit": "पायुरध्यात्मं विसर्गोऽधिभूतं मित्रोऽधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089238, "chapter_id": 2909, "verse_number": "१३-३९-२८", "content_sanskrit": "उपस्थोऽध्यात्ममानन्दोऽधिभूतं प्रजापतिरवधिदैवतं स्यात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089239, "chapter_id": 2909, "verse_number": "१३-३९-२९", "content_sanskrit": "वागध्यात्मं वक्तव्यमधिभूतमग्निरधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089240, "chapter_id": 2909, "verse_number": "१३-३९-३०", "content_sanskrit": "मनोऽध्यात्मं मन्तव्यमधिभूतं चन्द्रमा अधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089241, "chapter_id": 2909, "verse_number": "१३-३९-३१", "content_sanskrit": "अहङ्कारोऽध्यात्ममभिमानोऽधिभूतं विरिञ्चोऽधिदैवतं स्यात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089242, "chapter_id": 2909, "verse_number": "१३-३९-३२", "content_sanskrit": "बुद्धिरध्यात्मं व्यवसायोऽधिभूतं ब्रह्माधिदैवतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089243, "chapter_id": 2909, "verse_number": "१३-३९-३३", "content_sanskrit": "एवमव्यक्तो भगवान्सकृत्कृत्स्नान्कुरुते सम्हरते च। कस्मात्क्रीडार्थम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089244, "chapter_id": 2909, "verse_number": "१३-३९-३४", "content_sanskrit": "यथाऽऽदित्योंऽशुजालं क्षिपति सम्हरते च एवमव्यक्तो गुणान्सृजति सम्हरते च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089245, "chapter_id": 2909, "verse_number": "१३-३९-३५", "content_sanskrit": "यथाऽर्णवादूर्मिमालानिच यश्चोर्ध्वमुत्तिष्ठते सम्हरते च।\nयथा चान्तरिक्षादभ्रमाकाशमुत्तिष्ठति स्तनितगर्जितोन्मिश्रं तद्वत्तत्रैव प्राणशत्।\nएवमव्यक्तो गुणान्सृजति सम्हरति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089246, "chapter_id": 2909, "verse_number": "१३-३९-३६", "content_sanskrit": "यथा कूर्मोऽङ्गानि कामात्प्रसारयते पुनश्च प्रवेशयति एवमव्यक्तो भगवान्लोकान्प्रकाशयति प्रवेशयते च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089247, "chapter_id": 2909, "verse_number": "१३-३९-३७", "content_sanskrit": "एवं चेतनश्च भगवान्पञ्चविंशः शुचिस्तेनाधिष्ठिता प्रकृतिश्चेतयति नित्यं सहधर्मा च। भगवतोऽव्यक्तस्य क्रियावतोक्रियावतश्च प्रकृतिः क्रियावानजरामरः क्षेत्रज्ञो नारायणाख्यः पुरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089248, "chapter_id": 2909, "verse_number": "१३-३९-३८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089249, "chapter_id": 2909, "verse_number": "१३-३९-३८", "content_sanskrit": "इत्येतन्नारदायोक्तं कुमारेण च धीमता।\nएतच्छ्रुत्वा द्विजो राजन्सर्वयज्ञफलं लभेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089250, "chapter_id": 2909, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनचत्वारिंशोऽध्यायः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]