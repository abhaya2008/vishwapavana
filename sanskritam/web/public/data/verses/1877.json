[{"id": 2039686, "chapter_id": 1877, "verse_number": "५-१२२-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039687, "chapter_id": 1877, "verse_number": "५-१२२-१", "content_sanskrit": "प्रत्यभिज्ञातमात्रोऽथ सद्भिस्तैर्नरपुङ्गवः।\nसमारुरोह नृपतिरस्पृशन्वसुधातलम् ।\nययातिर्दिव्यसंस्थानो बभूव विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039688, "chapter_id": 1877, "verse_number": "५-१२२-२", "content_sanskrit": "दिव्यमाल्याम्बरधरो दिव्याभरणभूषितः।\nदिव्यगन्धगुणोपेतो न पृथ्वीमस्पृशत्पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039689, "chapter_id": 1877, "verse_number": "५-१२२-३", "content_sanskrit": "ततो वसुमनाः पूर्वमुच्चैरुच्चारयन्वचः ॥\nख्यातो दानपतिर्लोके व्याजहार नृपं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039690, "chapter_id": 1877, "verse_number": "५-१२२-४", "content_sanskrit": "प्राप्तवानस्मि यल्लोके सर्ववर्णेष्वगर्हया ।\nतदप्यथ च दास्यामि तेन संयुज्यतां भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039691, "chapter_id": 1877, "verse_number": "५-१२२-५", "content_sanskrit": "यत्फलं दानशीलस्य क्षमाशीलस्य यत्फलम् ।\nयच्च मे फलमाधाने तेन संयुज्यतां भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039692, "chapter_id": 1877, "verse_number": "५-१२२-६", "content_sanskrit": "ततः प्रतर्दनोऽप्याह वाक्यं क्षत्रियपुङ्गवः ।\nयथा धर्मरतिर्नित्यं नित्यं युद्धपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039693, "chapter_id": 1877, "verse_number": "५-१२२-७", "content_sanskrit": "प्राप्तवानस्मि यल्लोके क्षत्रवंशोद्भवं यशः ।\nवीरशब्दफलं चैव तेन संयुज्यतां भवान् ।\nयथा धर्मे रतिर्नित्यं तेन सत्येन खं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039694, "chapter_id": 1877, "verse_number": "५-१२२-८", "content_sanskrit": "शिबिरौशीनरो धीमानुवाच मधुरां गिरम्।\nयथा बालेषु नारीषु वैवाह्येषु तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039695, "chapter_id": 1877, "verse_number": "५-१२२-९", "content_sanskrit": "सङ्गरेषु निपातेषु तथा तद्व्यसनेषु च ।\nअनृतं नोक्तपूर्वं मे तेन सत्येन खं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039696, "chapter_id": 1877, "verse_number": "५-१२२-१०", "content_sanskrit": "यथा प्राणांश्च राज्यं च राजन्कामसुखानि च।\nत्यजेयं न पुनः सत्यं तेन सत्येन खं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039697, "chapter_id": 1877, "verse_number": "५-१२२-११", "content_sanskrit": "यथा सत्येन मे धर्मो यथा सत्येन पावकः ।\nप्रीतः शतक्रतुश्चैव तेन सत्येन खं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039698, "chapter_id": 1877, "verse_number": "५-१२२-१२", "content_sanskrit": "अष्टकस्त्वथ राजर्षिः कौशिको माधवीसुतः।\nअनेकशतयज्वानं नाहुषं प्राह धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039699, "chapter_id": 1877, "verse_number": "५-१२२-१३", "content_sanskrit": "शतशः पुण्डरीका मे गोसवाश्चरिताः प्रभो ।\nक्रतवो वाजपेयाश्च तेषां फलमवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039700, "chapter_id": 1877, "verse_number": "५-१२२-१४", "content_sanskrit": "न मे रत्नानि न धनं न तथाऽन्ये परिच्छदा ।\nक्रतुष्वनुपयुक्तानि तेन सत्येन खं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039701, "chapter_id": 1877, "verse_number": "५-१२२-१५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039702, "chapter_id": 1877, "verse_number": "५-१२२-१५", "content_sanskrit": "यथायथा हि जल्पन्ति दौहित्रास्तं नराधिपम् ।\nतथतथा वसुमतीं त्यक्त्वा राजा दिवं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039703, "chapter_id": 1877, "verse_number": "५-१२२-१६", "content_sanskrit": "एवं सर्वे समस्तैस्ते राजानः सुकृतैस्तदा ।\nययातिं स्वर्गतो भ्रष्टं तारयामासुरञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039704, "chapter_id": 1877, "verse_number": "५-१२२-१७", "content_sanskrit": "दौहित्राः स्वेन धर्मेण यज्ञदानकृतेन वै ।\nचतुर्षु राजवंशेषु संभूताः कुलवर्धनाः।\nमातामहं महाप्राज्ञं दिवमारोपयन्त ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039705, "chapter_id": 1877, "verse_number": "५-१२२-१८x", "content_sanskrit": "राजान ऊचुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039706, "chapter_id": 1877, "verse_number": "५-१२२-१८", "content_sanskrit": "राजधर्मगुणोपेताः सर्वधर्मगुणान्विताः ।\nदौहित्रास्ते वयं राजन्दिवमारोह पार्थिव ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039707, "chapter_id": 1877, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि द्वाविंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]