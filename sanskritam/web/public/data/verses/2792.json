[{"id": 2084235, "chapter_id": 2792, "verse_number": "१२-२९७-०x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084236, "chapter_id": 2792, "verse_number": "१२-२९७-१", "content_sanskrit": "मनोरथरथं प्राप्य इन्द्रियार्थहयं नरः।\nरश्मिभिर्ज्ञानसंभूतैर्यो गच्छति स बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084237, "chapter_id": 2792, "verse_number": "१२-२९७-२", "content_sanskrit": "सेवाश्रितेन मनसा वृत्तिहीनस्य शस्यते।\nद्विजातिहस्तान्निर्वृत्ता न तु तुल्यात्परस्परात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084238, "chapter_id": 2792, "verse_number": "१२-२९७-३", "content_sanskrit": "आयुर्नसुलभं लब्ध्वा नावकर्षेद्विशांपते।\nउत्कर्षार्थं प्रयतते नरः पुण्येन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084239, "chapter_id": 2792, "verse_number": "१२-२९७-४", "content_sanskrit": "वर्णेभ्यो हि परिभ्रष्टो न वै संमानमर्हति।\nन तु यः सत्क्रियां प्राप्य राजसं कर्म सेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084240, "chapter_id": 2792, "verse_number": "१२-२९७-५", "content_sanskrit": "वर्णोत्कर्षमवाप्नोति नरः पुण्येन कर्मणा।\nदुर्लभं तमलब्धा हि हन्यात्पापेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084241, "chapter_id": 2792, "verse_number": "१२-२९७-६", "content_sanskrit": "अज्ञानाद्धि कृतं पापं तपसैवाभिनिर्णुदेत्।\nपापं हि कर्म फलति पापमेव स्वयंकृतम्।\nतस्मात्पापं न सेवेत कर्म दुःखफलोदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084242, "chapter_id": 2792, "verse_number": "१२-२९७-७", "content_sanskrit": "पापानुबन्धं यत्कर्म यद्यपि स्यान्महाफलम्।\nतन्न सेवेत मेधावी शुचिः कुशलिनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084243, "chapter_id": 2792, "verse_number": "१२-२९७-८", "content_sanskrit": "किंकष्टमनुपश्यामि फलं पापस्य कर्मणः।\nप्रत्यापन्नस्य हि ततो नात्मा तावद्विरोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084244, "chapter_id": 2792, "verse_number": "१२-२९७-९", "content_sanskrit": "प्रत्यापत्तिश्च यस्येह बालिशस्य न जायते।\nतस्यापि सुमहांस्तापः प्रस्थितस्योपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084245, "chapter_id": 2792, "verse_number": "१२-२९७-१०", "content_sanskrit": "विरक्तं शोध्यते वस्त्रं न तु कृष्णोपसंहितम्।\nप्रयत्नेन मनुष्येन्द्र पापमेवं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084246, "chapter_id": 2792, "verse_number": "१२-२९७-११", "content_sanskrit": "स्वयं कृत्वा तु यः पापं शुभमेवानुतिष्ठति।\nप्रायश्चित्तं नरः कर्तुमुभयं सोऽश्नुते पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084247, "chapter_id": 2792, "verse_number": "१२-२९७-१२", "content_sanskrit": "अज्ञानात्तु कृतां हिंसामहिंसा व्यपकर्षति।\nब्राह्मणाः शास्त्रनिर्देशादित्याहुर्ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084248, "chapter_id": 2792, "verse_number": "१२-२९७-१३", "content_sanskrit": "तथा कामकृतं नास्य विहिंसैवानुकर्षति।\nइत्याहुर्ब्रह्मशास्त्रज्ञा ब्राह्मणा ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084249, "chapter_id": 2792, "verse_number": "१२-२९७-१४", "content_sanskrit": "अहं तु तावत्पश्यामि कर्म यद्धर्तते कृतम्।\nगुणयुक्तं प्रकाशं वा पापेनानुपसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084250, "chapter_id": 2792, "verse_number": "१२-२९७-१५", "content_sanskrit": "यथा सूक्ष्माणि कर्माणि फलन्तीह यथातथम्।\nबुद्धियुक्तानि तानीह कृतानि मनसा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084251, "chapter_id": 2792, "verse_number": "१२-२९७-१६", "content_sanskrit": "भवत्यल्पफलं कर्म सेवितं नित्यमुल्वणम्।\nअबुद्धिपूर्वं धर्मज्ञ कृतमुग्रेण कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084252, "chapter_id": 2792, "verse_number": "१२-२९७-१७", "content_sanskrit": "कृतानि यानि कर्माणि दैवतैर्मुनिभिस्तथा।\nन चरेत्तानि धर्मात्मा श्रुत्वा चापि न कुत्सयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084253, "chapter_id": 2792, "verse_number": "१२-२९७-१८", "content_sanskrit": "संचिन्त्य मनसा राजन्विदित्वा शक्तिमात्मनः।\nकरोति यः शुभं कर्म स वै भद्राणि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084254, "chapter_id": 2792, "verse_number": "१२-२९७-१९", "content_sanskrit": "नवे कपाले सलिलं संन्यस्तं हीयते यथा।\nनवेतरे तथा भावं प्राप्नोति सुखभावितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084255, "chapter_id": 2792, "verse_number": "१२-२९७-२०", "content_sanskrit": "सतोयेऽन्यत्तु यत्तोयं तस्मिन्नेव प्रसिच्यते।\nतद्धि वृद्धिमवाप्नोति सलिले सलिलं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084256, "chapter_id": 2792, "verse_number": "१२-२९७-२१", "content_sanskrit": "एवं कर्माणि यानीह बुद्धियुक्तानि पार्थिव।\nसमानि चैव यानीह तानि पुण्यतमान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084257, "chapter_id": 2792, "verse_number": "१२-२९७-२२", "content_sanskrit": "राज्ञा जेतव्याः शत्रवश्चोन्नताश्च\nसम्यक्कर्तव्यं पालनं च प्रजानाम्।\nअग्निश्चेयो बहुभिश्चापि यज्ञै\nरन्त्ये मध्ये वा वनमाश्रित्य स्थेयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084258, "chapter_id": 2792, "verse_number": "१२-२९७-२३", "content_sanskrit": "दमान्वितः पुरुषो धर्मशीलो\nभूतानि चात्मानमिवानुपश्येत्।\nगरीयसः पूजयेदात्मशक्त्या\nसत्येन शीलेन सुखं नरेन्द्र॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084259, "chapter_id": 2792, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तनवत्यधिकद्विशततमोऽध्यायः॥ २९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]