[{"id": 6000309000, "chapter_id": 10309, "verse_number": null, "content_sanskrit": "अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000309001, "chapter_id": 10309, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.001.m4a", "display_order": 2}, {"id": 6000309002, "chapter_id": 10309, "verse_number": "११-८-१", "content_sanskrit": "सुखमैन्द्रियकं राजन् स्वर्गे नरक एव च।\nदेहिनां यद् यथा दुःखं तस्मान्नेच्छेत तद् बुधः॥ ११/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.002.m4a", "display_order": 3, "topics": [{"text": "अवधूतस्य अजगरादिभ्यो नवभ्यो गुरुभ्यः शिक्षितबुद्धिकथनम्", "range": "१–४३"}]}, {"id": 6000309003, "chapter_id": 10309, "verse_number": "११-८-२", "content_sanskrit": "ग्रासं विसृष्टं दिष्टेन महान्तं स्तोकमेव च।\nयदृच्छयैवापतितं ग्रसेदजगरोऽक्रियः॥ ११/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.003.m4a", "display_order": 4}, {"id": 6000309004, "chapter_id": 10309, "verse_number": "११-८-३", "content_sanskrit": "शयीताहानि भूरीणि निराहारोऽनुपक्रमः।\nयदि नोपनमेद् ग्रासो महाहिरिव दिष्टभुक्॥ ११/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.004.m4a", "display_order": 5}, {"id": 6000309005, "chapter_id": 10309, "verse_number": "११-८-४", "content_sanskrit": "ओजः सहोबलयुतं बिभ्रद् देहमकर्मकम्।\nशयानो वीतनिद्रश्च नेहेतेन्द्रियवानपि॥ ११/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.005.m4a", "display_order": 6}, {"id": 6000309006, "chapter_id": 10309, "verse_number": "११-८-५", "content_sanskrit": "मुनिः प्रसन्नगम्भीरो दुर्विगाह्यो दुरत्ययः।\nअनन्तपारो ह्यक्षोभ्यः स्तिमितोद इवार्णवः॥ ११/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.006.m4a", "display_order": 7}, {"id": 6000309007, "chapter_id": 10309, "verse_number": "११-८-६", "content_sanskrit": "समृद्धकामो हीनो वा नारायणपरो मुनिः।\nनोत्सर्पेत न शुष्येत सरिद्भिरिव सागरः॥ ११/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.007.m4a", "display_order": 8}, {"id": 6000309008, "chapter_id": 10309, "verse_number": "११-८-७", "content_sanskrit": "दृष्ट्वा स्‍त्रियं देवमायां तद्भावैरजितेन्द्रियः।\nप्रलोभितः पतन्त्यन्धे तमस्यग्नौ पतङ्गवत्॥ ११/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.008.m4a", "display_order": 9}, {"id": 6000309009, "chapter_id": 10309, "verse_number": "११-८-८", "content_sanskrit": "योषित्सु तल्पाभरणाम्बरादिद्रव्येषु मायारचितेषु मूढः।\nप्रलोभितात्मा ह्युपभोगबुद्ध्या पतङ्गवन्नश्यति नष्टदृष्टिः॥ ११/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.009.m4a", "display_order": 10}, {"id": 6000309010, "chapter_id": 10309, "verse_number": "११-८-९", "content_sanskrit": "स्तोकं स्तोकं ग्रसेद् ग्रासं देहो वर्तेत यावता।\nगृहाद् व्रजेत् समातिष्ठन् वृत्तिं माधुकरीं मुनिः॥ ११/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.010.m4a", "display_order": 11}, {"id": 6000309011, "chapter_id": 10309, "verse_number": "११-८-१०", "content_sanskrit": "अणुभ्यश्च महद्भ्यश्च शास्‍त्रेभ्यः कुशलो नरः।\nसर्वतः सारमादद्यात् पुष्पेभ्य इव षट्पदः॥ ११/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.011.m4a", "display_order": 12}, {"id": 6000309012, "chapter_id": 10309, "verse_number": "११-८-११", "content_sanskrit": "सायन्तनं श्वस्तनं वा न सङ्गृह्णीत भिक्षितम्। पाणिपात्रोदरामत्रो मक्षिकेव न सङ्ग्रही।\nमक्षिका इव सङ्गृह्णन् सह तेन विनश्यति॥ ११/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.012.m4a", "display_order": 13}, {"id": 6000309013, "chapter_id": 10309, "verse_number": "११-८-१२", "content_sanskrit": "पदापि युवतीं भिक्षुर्न स्पृशेद् दारवीमपि।\nस्पृशन् करीव बध्येत करिण्या अङ्गसङ्गतः॥ ११/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.013.m4a", "display_order": 14}, {"id": 6000309014, "chapter_id": 10309, "verse_number": "११-८-१३", "content_sanskrit": "नाधिगच्छेत् स्‍त्रियं प्राज्ञः कर्हिचिन्मृत्युमात्मनः।\nबलाधिकैः स हन्येत गजैरन्यैर्गजो यथा॥ ११/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.014.m4a", "display_order": 15}, {"id": 6000309015, "chapter_id": 10309, "verse_number": "११-८-१४", "content_sanskrit": "न देयं नोपभोग्यं च लुब्धैर्यद् दुःखसञ्चितम्।\nभुङ्क्ते स्वमपि तच्चान्यो मधुहेवार्थविन्मधु॥ ११/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.015.m4a", "display_order": 16}, {"id": 6000309016, "chapter_id": 10309, "verse_number": "११-८-१५", "content_sanskrit": "सुदुःखोपार्जितैर्वित्तैराशासानां गृहाशिषः।\nमधुहेवाग्रतो भुङ्क्ते यतिर्वै गृहमेधिनाम्॥ ११/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.016.m4a", "display_order": 17}, {"id": 6000309017, "chapter_id": 10309, "verse_number": "११-८-१६", "content_sanskrit": "ग्राम्यगीतं न शृणुयाद् यतिर्वनचरः क्‍वचित्।\nशिक्षेऽहं हरिणाद् बद्धान्मृगयोर्गीतमोहितात्॥ ११/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.017.m4a", "display_order": 18}, {"id": 6000309018, "chapter_id": 10309, "verse_number": "११-८-१७", "content_sanskrit": "नृत्यवादित्रगीतानि जुषन् ग्राम्याणि योषिताम्।\nआसां क्रीडनकान्धः स्याद् ऋष्यशृङ्गो मुनिर्यथा॥ ११/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.018.m4a", "display_order": 19}, {"id": 6000309019, "chapter_id": 10309, "verse_number": "११-८-१८", "content_sanskrit": "जिह्वयाऽथ प्रमाथिन्या जनो रसविमोहितः।\nमृत्युमृच्छत्यतद्बुद्धिर्मीनस्तु बडिशैर्यथा॥ ११/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.019.m4a", "display_order": 20}, {"id": 6000309020, "chapter_id": 10309, "verse_number": "११-८-१९", "content_sanskrit": "इन्द्रियाणि जयन्त्याशु निराहारा मनीषिणः।\nवर्जयित्वा तु रसनामसौ रस्ये तु वर्धते॥ ११/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.020.m4a", "display_order": 21}, {"id": 6000309021, "chapter_id": 10309, "verse_number": "११-८-२०", "content_sanskrit": "तावज्जितेन्द्रियो न स्याद् विजितान्येन्द्रियः पुमान्।\nन जयेद् रसनं यावज्जितं सर्वं जिते रसे॥ ११/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.021.m4a", "display_order": 22}, {"id": 6000309022, "chapter_id": 10309, "verse_number": "११-८-२१", "content_sanskrit": "पिङ्गला नाम वेश्याऽऽसीद् विदेहनगरे पुरा।\nतस्या मे शिक्षितं किञ्चिन्निबोध नृपसत्तम॥ ११/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.022.m4a", "display_order": 23}, {"id": 6000309023, "chapter_id": 10309, "verse_number": "११-८-२२", "content_sanskrit": "सा स्वैरिण्येकदा कान्तं सङ्केत उपनेष्यती।\nअभूत् काले गृहद्वारि बिभ्रती रूपमुत्तमम्॥ ११/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.023.m4a", "display_order": 24}, {"id": 6000309024, "chapter_id": 10309, "verse_number": "११-८-२३", "content_sanskrit": "मार्ग आगच्छतो वीक्ष्य पुरुषान् पुरुषर्षभ।\nतान् शुल्कदान् वित्तवतः कान्तान् मेनेऽर्थकामुका॥ ११/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.024.m4a", "display_order": 25}, {"id": 6000309025, "chapter_id": 10309, "verse_number": "११-८-२४", "content_sanskrit": "आगतेष्वपयातेषु सा सङ्केतोपजीविनी।\nअथान्यो वित्तवान् कोऽपि मामुपेष्यति भूरिदः॥ ११/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.025.m4a", "display_order": 26}, {"id": 6000309026, "chapter_id": 10309, "verse_number": "११-८-२५", "content_sanskrit": "एवं दुराशयध्वस्तनिद्रा द्वार्यवलम्बिनी।\nनिर्गच्छन्ती प्रविशती निशीथं प्रत्यपद्यत॥ ११/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.026.m4a", "display_order": 27}, {"id": 6000309027, "chapter_id": 10309, "verse_number": "११-८-२६", "content_sanskrit": "तस्या वित्ताशया शुष्यद्वक्त्राया दीनचेतसः।\nनिर्वेदः परमो जज्ञे चिन्ताहेतिः सुखावहः॥ ११/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.027.m4a", "display_order": 28}, {"id": 6000309028, "chapter_id": 10309, "verse_number": "११-८-२७", "content_sanskrit": "तथा निर्विण्णचित्ताया गीतं शृणु यथा मम॥ ११/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.028.m4a", "display_order": 29}, {"id": 6000309029, "chapter_id": 10309, "verse_number": "११-८-२८", "content_sanskrit": "निर्वेद आशापाशानां पुरुषस्य यथा ह्यसिः।\nनह्यङ्गाजातनिर्वेदो देहबन्धं जिहासति॥ ११/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.029.m4a", "display_order": 30}, {"id": 6000309030, "chapter_id": 10309, "verse_number": null, "content_sanskrit": "पिङ्गलोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.030.m4a", "display_order": 31}, {"id": 6000309031, "chapter_id": 10309, "verse_number": "११-८-२९", "content_sanskrit": "अहो मे मोहविततिं पश्यताविजितात्मनः।\nया कान्तादसतः कामं कामये येन बालिशा॥ ११/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.031.m4a", "display_order": 32}, {"id": 6000309032, "chapter_id": 10309, "verse_number": "११-८-३०", "content_sanskrit": "सन्तं समीपे रमणं रतिप्रदं वित्तप्रदं नित्यमिमं विहाय।\nअकामदं दुःखभयादिशोकमोहप्रदं तुच्छमहं भजेऽज्ञा॥ ११/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.032.m4a", "display_order": 33}, {"id": 6000309033, "chapter_id": 10309, "verse_number": "११-८-३१", "content_sanskrit": "अहो मयाऽऽत्मा परितापितो वृथा सांकेत्यवृत्त्याऽतिविगर्ह्यवार्तया।\nस्‍त्रैणान् नरांश्चार्थतृषाऽनुशोच्यान् क्रीत्वा हि वित्तं रतिमात्मनेच्छती॥ ११/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.033.m4a", "display_order": 34}, {"id": 6000309034, "chapter_id": 10309, "verse_number": "११-८-३२", "content_sanskrit": "यदस्थिभिर्निर्मितवंशवंश्यस्थूणं त्वचारोमनखैः पिनद्धम्।\nक्षरन्नवद्वारमगारमेतद् विण्मूत्रपूर्णं मदुपैति काऽन्या॥ ११/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.034.m4a", "display_order": 35}, {"id": 6000309035, "chapter_id": 10309, "verse_number": "११-८-३३", "content_sanskrit": "विदेहानां पुरे ह्यस्मिन् अहमैकैव मूढधीः।\nयाऽन्यमिच्छन्त्यतः स्वस्मादन्यस्मात् कान्तमच्युतात्॥ ११/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.035.m4a", "display_order": 36}, {"id": 6000309036, "chapter_id": 10309, "verse_number": "११-८-३४", "content_sanskrit": "सुहृत् प्रेष्ठतमो नाथ आत्मा चायं शरीरिणाम्।\nतं विक्रीयात्मनैवाहं रमेऽनेन यथा रमा॥ ११/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.036.m4a", "display_order": 37}, {"id": 6000309037, "chapter_id": 10309, "verse_number": "११-८-३५", "content_sanskrit": "कियत् प्रियं ते व्यभजन् कान्ता मे कामदा नराः।\nआद्यन्तवन्तो भार्याया देवा वा कालविद्रुताः॥ ११/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.037.m4a", "display_order": 38}, {"id": 6000309038, "chapter_id": 10309, "verse_number": "११-८-३६", "content_sanskrit": "नूनं मे भगवान् प्रीतो विष्णुः केनापि कर्मणा।\nनिर्वेदोऽयं दुराशाया यन्मे जातः सुखावहः॥ ११/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.038.m4a", "display_order": 39}, {"id": 6000309039, "chapter_id": 10309, "verse_number": "११-८-३७", "content_sanskrit": "मैवं स्युर्मन्दभाग्यायाः क्लेशा निर्वेदहेतवः।\nयेनानुबन्धं निर्हृत्य पुरुषः शममृच्छति॥ ११/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.039.m4a", "display_order": 40}, {"id": 6000309040, "chapter_id": 10309, "verse_number": "११-८-३८", "content_sanskrit": "तेनोपकृतमादाय शिरसा ग्राम्यसङ्गताः।\nत्यक्त्वा दुराशाः शरणं व्रजामि तमधीश्वरम्॥ ११/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.040.m4a", "display_order": 41}, {"id": 6000309041, "chapter_id": 10309, "verse_number": "११-८-३९", "content_sanskrit": "सन्तुष्टा श्रद्दधत्येतं यथालाभेन जीवती।\nविहराम्यमुनैवाहमात्मना रमणेन वै॥ ११/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.041.m4a", "display_order": 42}, {"id": 6000309042, "chapter_id": 10309, "verse_number": "११-८-४०", "content_sanskrit": "संसारकूपे पतितं विषयैर्मुषितेक्षणम्।\nग्रस्तं कालाहिनाऽऽत्मानं कोऽन्योऽस्मात् त्रातुमीश्वरः॥ ११/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.042.m4a", "display_order": 43}, {"id": 6000309043, "chapter_id": 10309, "verse_number": "११-८-४१", "content_sanskrit": "आत्मैव ह्यात्मनो गोप्ता निर्विद्येत यदाऽखिलम्।\nअप्रमत्त इदं पश्येद् ग्रस्तं कालाहिना जगत्॥ ११/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.043.m4a", "display_order": 44}, {"id": 6000309044, "chapter_id": 10309, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.044.m4a", "display_order": 45}, {"id": 6000309045, "chapter_id": 10309, "verse_number": "११-८-४२", "content_sanskrit": "एवं व्यवसितमतिर्दुराशाः कान्ततर्षजाः।\nछित्वोपशममास्थाय शय्यामुपविवेश सा॥ ११/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.045.m4a", "display_order": 46}, {"id": 6000309046, "chapter_id": 10309, "verse_number": "११-८-४३", "content_sanskrit": "आशा हि परमं दुःखं नैराश्यं परमं सुखम्।\nयथा सञ्छिद्य कान्ताशां सुखं सुष्वाप पिङ्गला॥ ११/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_008/BhP_11.008.046.m4a", "display_order": 47}, {"id": 6000309047, "chapter_id": 10309, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे अष्टमाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]