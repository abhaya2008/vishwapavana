[{"id": 7000441000, "chapter_id": 20441, "verse_number": "२-११३-१", "content_sanskrit": "रंभोवाच ।\nतप एतत्परित्यज्य किंवा लोकयसे शुभे ।\nतपसः क्षरणं स्याद्वै पुरुषस्यापि चिंतनात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000441001, "chapter_id": 20441, "verse_number": "२-११३-२", "content_sanskrit": "अशोकसुंदर्युवाच ।\nतपसि मे मनो लीनं नहुषस्यापि काम्यया ।\nन मां चालयितुं शक्ता देवासुरमहोरगाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000441002, "chapter_id": 20441, "verse_number": "२-११३-३", "content_sanskrit": "एनं दृष्ट्वा महाभागे मे मनश्चलते भृशम् ।\nरंतुमिच्छाम्यहं गत्वा एवमुत्सुकतां गतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000441003, "chapter_id": 20441, "verse_number": "२-११३-४", "content_sanskrit": "एवं विपर्ययश्चासीन्मनसो मे वरावने ।\nतन्मे त्वं कारणं ब्रूहि यद्यस्ति ज्ञानमुत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000441004, "chapter_id": 20441, "verse_number": "२-११३-५", "content_sanskrit": "आयुपुत्रस्य भार्याहं देवैः सृष्टा महात्मभिः ।\nकस्मान्मे धावते चेत उत्सुकं रंतुमेव च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000441005, "chapter_id": 20441, "verse_number": "२-११३-६", "content_sanskrit": "रंभोवाच ।\nसर्वेष्वेव महाभागे देहरूपेषु भामिनि ।\nवसत्यात्मा स्वयं ब्रह्मज्ञानरूपः सनातनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000441006, "chapter_id": 20441, "verse_number": "२-११३-७", "content_sanskrit": "यद्यपि प्रक्रियाबद्धैरिंद्रियैरुपकारिभिः ।\nमोहपाशमयैर्बद्धस्तथा सिद्धस्तु सर्वदा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000441007, "chapter_id": 20441, "verse_number": "२-११३-८", "content_sanskrit": "प्रकृतिं नैव जानाति ज्ञानविज्ञानकीं कलाम् ।\nअयं शुद्धश्च धर्मज्ञ आत्मा वेत्ति च सुंदरि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000441008, "chapter_id": 20441, "verse_number": "२-११३-९", "content_sanskrit": "गच्छंत्यपि मनस्तापमेनं दृष्ट्वा महामतिम् ।\nपापमेवं परित्यज्य सत्यमेवं प्रधावति॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000441009, "chapter_id": 20441, "verse_number": "२-११३-१०", "content_sanskrit": "भर्तायमायुपुत्रस्ते एतत्सत्यं न संशयः ।\nअन्यं दृष्ट्वा विशंकेत पुरुषं पापलक्षणम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000441010, "chapter_id": 20441, "verse_number": "२-११३-११", "content_sanskrit": "एवं विधिः कृतो देवैः सत्यपाशेन बंधितः ।\nयदस्या आयुपुत्रोपि भर्तृत्वमुपयास्यति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000441011, "chapter_id": 20441, "verse_number": "२-११३-१२", "content_sanskrit": "एवमाकर्णितं भद्रे आत्मना तं च सुंदरि ।\nतद्भावसत्यसंबंधं परिगृह्य स्थितः स्वयम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000441012, "chapter_id": 20441, "verse_number": "२-११३-१३", "content_sanskrit": "अन्यं भावं न जानाति आयुपुत्रं च विंदति ।\nप्रकृतिर्नैव ते देवि पतिं जानाति चागतम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000441013, "chapter_id": 20441, "verse_number": "२-११३-१४", "content_sanskrit": "एवं ज्ञात्वा प्रधानात्मा तवाद्यैव प्रधावति ।\nआत्मा सर्वं प्रजानाति आत्मा देवः सनातनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000441014, "chapter_id": 20441, "verse_number": "२-११३-१५", "content_sanskrit": "अयमेष स वीरेंद्रो नहुषो नाम वीर्यवान् ।\nतस्माद्गच्छति चेतस्ते सत्यं संबंधमिच्छते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000441015, "chapter_id": 20441, "verse_number": "२-११३-१६", "content_sanskrit": "ज्ञात्वा चायोः सुतं भद्रे अन्यं चैव न गच्छति ।\nएतत्ते सर्वमाख्यातं शाश्वतं त्वन्मनोगतम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000441016, "chapter_id": 20441, "verse_number": "२-११३-१७", "content_sanskrit": "हुंडं हत्वा महाघोरं समरे दानवाधमम् ।\nत्वां नयिष्यति स्वस्थानमायोश्च गृहमुत्तमम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000441017, "chapter_id": 20441, "verse_number": "२-११३-१८", "content_sanskrit": "हृतो दैत्येन वीरेंद्रो निजपुण्येन शेषितः ।\nबाल्यात्प्रभृति वीरेंद्रो वियुक्तः स्वजनेन वै॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000441018, "chapter_id": 20441, "verse_number": "२-११३-१९", "content_sanskrit": "पितृमातृविहीनस्तु गतो वृद्धिं महावने ।\nयास्यत्येव पितुर्गेहं त्वयैव सह सांप्रतम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000441019, "chapter_id": 20441, "verse_number": "२-११३-२०", "content_sanskrit": "एवमाभाषितं श्रुत्वा रंभायाः शिवनंदिनी ।\nहर्षेण महताविष्टा तामुवाच समुद्रजाम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000441020, "chapter_id": 20441, "verse_number": "२-११३-२१", "content_sanskrit": "अयमेव स सत्यात्मा मम भर्ता सुवीर्यवान् ।\nमनो मे धावतेऽत्यर्थं शोकाकुलितविह्वलम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000441021, "chapter_id": 20441, "verse_number": "२-११३-२२", "content_sanskrit": "नास्ति चित्तसमो देवो जानाति सुविनिश्चितम् ।\nसत्यमेतन्मया दृष्टं सुचित्रं चारुहासिनि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000441022, "chapter_id": 20441, "verse_number": "२-११३-२३", "content_sanskrit": "मनोभवसमानं तु पुरुषं दिव्यलक्षणम् ।\nन धावति महाचेत एनं दृष्ट्वा यथा सखि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000441023, "chapter_id": 20441, "verse_number": "२-११३-२४", "content_sanskrit": "तथा न धावते भद्रे पुंसमन्यं न मन्यते ।\nएनं गंतव्यमावाभ्यां सखीभिर्गृहमेव हि॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000441024, "chapter_id": 20441, "verse_number": "२-११३-२५", "content_sanskrit": "एवमाभाष्य सा रंभा गमनायोपचक्रमे ।\nगमनायोत्सुकां ज्ञात्वा नहुषस्यांतिकं प्रति॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000441025, "chapter_id": 20441, "verse_number": "२-११३-२६", "content_sanskrit": "तामुवाच ततो रंभा कस्माद्देवि न गम्यते ।\nसूत उवाच ।\nसख्या च रंभया सार्द्धं नहुषं वीरलक्षणम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000441026, "chapter_id": 20441, "verse_number": "२-११३-२७", "content_sanskrit": "तस्यांतिकं सुसंप्राप्य प्रेषयामास तां सखीम् ।\nएनं गच्छ महाभागे नहुषं देवरूपिणम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000441027, "chapter_id": 20441, "verse_number": "२-११३-२८", "content_sanskrit": "कथयस्व कथामेतां तवार्थे आगता यतः ।\nरंभोवाच ।\nएवं सखि करिष्यामि सुप्रियं तव सुव्रते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000441028, "chapter_id": 20441, "verse_number": "२-११३-२९", "content_sanskrit": "एवमुक्त्वा गता रंभा नहुषं राजनंदनम् ।\nचापबाणधरं वीरं द्वितीयमिव वासवम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000441029, "chapter_id": 20441, "verse_number": "२-११३-३०", "content_sanskrit": "प्रत्युवाच गता रंभा सख्या वचनमुत्तमम् ।\nआयुपुत्र महाभाग रंभाहंसमुपागता॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000441030, "chapter_id": 20441, "verse_number": "२-११३-३१", "content_sanskrit": "शिवस्य कन्यया वीर तयाहं परिप्रेषिता ।\nतवार्थं देवदेवेन देव्या देवेन वै पुरा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000441031, "chapter_id": 20441, "verse_number": "२-११३-३२", "content_sanskrit": "भार्यारूपं वरं श्रेष्ठं सृष्टं लोकेषु दुर्लभम् ।\nदुष्प्राप्यं तु नरश्रेष्ठैर्देवै सेंद्रैस्तपोधनैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000441032, "chapter_id": 20441, "verse_number": "२-११३-३३", "content_sanskrit": "गंधर्वैः पन्नगैः सिद्धैश्चारणैः पुण्यलक्षणैः ।\nस्वयमेव समायातं तवार्थे शृणु सांप्रतम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000441033, "chapter_id": 20441, "verse_number": "२-११३-३४", "content_sanskrit": "स्त्रीरत्नं तन्महाप्राज्ञ संपूर्णं पुण्यनिर्मितम् ।\nअशोकसुंदरी नाम तवार्थं तपसि स्थिता॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000441034, "chapter_id": 20441, "verse_number": "२-११३-३५", "content_sanskrit": "अत्यर्थं तु तपस्तप्तं भवंतमिच्छते सदा ।\nएवं ज्ञात्वा महाभाग भजमानां भजस्व हि॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000441035, "chapter_id": 20441, "verse_number": "२-११३-३६", "content_sanskrit": "त्वामृते सा वरारोहा पुरुषं नैव याचते ।\nनहुषेण तयोक्तं तु श्रुत्वावधारितं वचः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000441036, "chapter_id": 20441, "verse_number": "२-११३-३७", "content_sanskrit": "प्रत्युत्तरं ददौ चाथ रंभे मे श्रूयतां वचः ।\nतत्तु सर्वं विजानामि यत्त्वयोक्तं ममाग्रतः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000441037, "chapter_id": 20441, "verse_number": "२-११३-३८", "content_sanskrit": "ममाग्रे कथितं पूर्वं वशिष्ठेन महात्मना ।\nसर्वमेव विजानामि अस्यास्तु तप उत्तमम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000441038, "chapter_id": 20441, "verse_number": "२-११३-३९", "content_sanskrit": "श्रूयतां कारणं भद्रे यथासौख्यं भविष्यति ।\nअहत्वा दानवं हुंडं न गच्छामि वरांगनाम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000441039, "chapter_id": 20441, "verse_number": "२-११३-४०", "content_sanskrit": "सर्वमेतत्सुवृत्तांतमहं जाने तथैव हि ।\nममार्थे तव संभूतिस्तपश्च चरितं त्वया॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000441040, "chapter_id": 20441, "verse_number": "२-११३-४१", "content_sanskrit": "मम भार्या न संदेहो भवती विधिना कृता ।\nममार्थे निश्चयं कृत्वा तप आचरितं त्वया॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000441041, "chapter_id": 20441, "verse_number": "२-११३-४२", "content_sanskrit": "हृता तस्मात्सुपापेन भवती नियमान्विता ।\nसूतिगृहादहं तेन दानवेनाधमेन वै॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000441042, "chapter_id": 20441, "verse_number": "२-११३-४३", "content_sanskrit": "बालभावस्थितो देवि पितृमातृविना कृतः ।\nतस्मात्तं तु हनिष्यामि हुंडं वै दानवाधमम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000441043, "chapter_id": 20441, "verse_number": "२-११३-४४", "content_sanskrit": "पश्चात्त्वामुपनेष्येऽहं वशिष्ठस्याश्रमं प्रति ।\nएवं कथय भद्रं ते रंभे मत्प्रियकारिणीम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000441044, "chapter_id": 20441, "verse_number": "२-११३-४५", "content_sanskrit": "एवं विसर्जिता तेन सत्वरं सा गता पुनः ।\nअशोकसुंदरीं देवीं कथयामास तस्य च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000441045, "chapter_id": 20441, "verse_number": "२-११३-४६", "content_sanskrit": "समासेन तथा सर्वं रंभा सा द्विजसत्तम ।\nअशोकसुंदरी सा तु अवधार्य सुभाषितम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000441046, "chapter_id": 20441, "verse_number": "२-११३-४७", "content_sanskrit": "नहुषस्य सुवीरस्य हर्षेण च समन्विता ।\nतस्थौ तत्र तया सार्द्धं सुसख्या रंभया तदा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000441047, "chapter_id": 20441, "verse_number": "२-११३-४८", "content_sanskrit": "भर्तुश्च कीदृशं वीर्यमिति पश्यामि वै सदा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]