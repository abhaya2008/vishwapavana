[{"id": 5000242000, "chapter_id": 9242, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000242001, "chapter_id": 9242, "verse_number": "३-४६-१", "content_sanskrit": "तया परुषमुक्तस्तु कुपितो राघवानुजः।\nस विकांक्षन् भृशं रामं प्रतस्थे नचिरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000242002, "chapter_id": 9242, "verse_number": "३-४६-२", "content_sanskrit": "तदासाद्य दशग्रीवः क्षिप्रमन्तरमास्थितः।\nअभिचक्राम वैदेहीं परिव्राजकरूपधृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000242003, "chapter_id": 9242, "verse_number": "३-४६-३", "content_sanskrit": "श्लक्ष्णकाषायसंवीतः शिखी छत्री उपानही।\nवामे चांसेऽवसज्याथ शुभे यष्टिकमण्डलू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000242004, "chapter_id": 9242, "verse_number": "३-४६-४", "content_sanskrit": "परिव्राजकरूपेण वैदेहीमन्ववर्तत।\nतामाससादातिबलो भ्रातृभ्यां रहितां वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000242005, "chapter_id": 9242, "verse_number": "३-४६-५", "content_sanskrit": "रहितां सूर्यचन्द्राभ्यां संध्यामिव महत्तमः।\nतामपश्यत् ततो बालां राजपुत्रीं यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000242006, "chapter_id": 9242, "verse_number": "३-४६-६", "content_sanskrit": "रोहिणीं शशिना हीनां ग्रहवद् भृशदारुणः।\nतमुग्रं पापकर्माणं जनस्थानगता द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000242007, "chapter_id": 9242, "verse_number": "३-४६-७", "content_sanskrit": "संदृश्य न प्रकम्पन्ते न प्रवाति च मारुतः।\nशीघ्रस्रोताश्च तं दृष्ट्वा वीक्षन्तं रक्तलोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000242008, "chapter_id": 9242, "verse_number": "३-४६-८", "content_sanskrit": "स्तिमितं गन्तुमारेभे भयाद् गोदावरी नदी।\nरामस्य त्वन्तरं प्रेप्सुर्दशग्रीवस्तदन्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000242009, "chapter_id": 9242, "verse_number": "३-४६-९", "content_sanskrit": "उपतस्थे च वैदेहीं भिक्षुरूपेण रावणः।\nअभव्यो भव्यरूपेण भर्तारमनुशोचतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000242010, "chapter_id": 9242, "verse_number": "३-४६-१०", "content_sanskrit": "अभ्यवर्तत वैदेहीं चित्रामिव शनैश्चरः।\nसहसा भव्यरूपेण तृणैः कूप इवावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000242011, "chapter_id": 9242, "verse_number": "३-४६-११", "content_sanskrit": "अतिष्ठत् प्रेक्ष्य वैदेहीं रामपत्नीं यशस्विनीम्।\nतिष्ठन् सम्प्रेक्ष्य च तदा पत्नीं रामस्य रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000242012, "chapter_id": 9242, "verse_number": "३-४६-१२", "content_sanskrit": "शुभां रुचिरदन्तोष्ठीं पूर्णचन्द्रनिभाननाम्।\nआसीनां पर्णशालायां बाष्पशोकाभिपीडिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000242013, "chapter_id": 9242, "verse_number": "३-४६-१३", "content_sanskrit": "स तां पद्मपलाशाक्षीं पीतकौशेयवासिनीम्।\nअभ्यगच्छत वैदेहीं हृष्टचेता निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000242014, "chapter_id": 9242, "verse_number": "३-४६-१४", "content_sanskrit": "दृष्ट्वा कामशराविद्धो ब्रह्मघोषमुदीरयन्।\nअब्रवीत् प्रश्रितं वाक्यं रहिते राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000242015, "chapter_id": 9242, "verse_number": "३-४६-१५", "content_sanskrit": "तामुत्तमां त्रिलोकानां पद्महीनामिव श्रियम्।\nविभ्राजमानां वपुषा रावणः प्रशशंस ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000242016, "chapter_id": 9242, "verse_number": "३-४६-१६", "content_sanskrit": "रौप्यकाञ्चनवर्णाभे पीतकौशेयवासिनि।\nकमलानां शुभां मालां पद्मिनीव च बिभ्रती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000242017, "chapter_id": 9242, "verse_number": "३-४६-१७", "content_sanskrit": "ह्रीः श्रीः कीर्तिः शुभा लक्ष्मीरप्सरा वा शुभानने।\nभूतिर्वा त्वं वरारोहे रतिर्वा स्वैरचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000242018, "chapter_id": 9242, "verse_number": "३-४६-१८", "content_sanskrit": "समाः शिखरिणः स्निग्धाः पाण्डुरा दशनास्तव।\nविशाले विमले नेत्रे रक्तान्ते कृष्णतारके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000242019, "chapter_id": 9242, "verse_number": "३-४६-१९", "content_sanskrit": "विशालं जघनं पीनमूरू करिकरोपमौ।\nएतावुपचितौ वृत्तौ संहतौ सम्प्रगल्भितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000242020, "chapter_id": 9242, "verse_number": "३-४६-२०", "content_sanskrit": "पीनोन्नतमुखौ कान्तौ स्निग्धतालफलोपमौ।\nमणिप्रवेकाभरणौ रुचिरौ ते पयोधरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000242021, "chapter_id": 9242, "verse_number": "३-४६-२१", "content_sanskrit": "चारुस्मिते चारुदति चारुनेत्रे विलासिनि।\nमनो हरसि मे रामे नदीकूलमिवाम्भसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000242022, "chapter_id": 9242, "verse_number": "३-४६-२२", "content_sanskrit": "करान्तमितमध्यासि सुकेशे संहतस्तनि।\nनैव देवी न गन्धर्वी न यक्षी न च किंनरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000242023, "chapter_id": 9242, "verse_number": "३-४६-२३", "content_sanskrit": "नैवंरूपा मया नारी दृष्टपूर्वा महीतले।\nरूपमग्र्यं च लोकेषु सौकुमार्यं वयश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000242024, "chapter_id": 9242, "verse_number": "३-४६-२४", "content_sanskrit": "इह वासश्च कान्तारे चित्तमुन्माथयन्ति मे।\nसा प्रतिक्राम भद्रं ते न त्वं वस्तुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000242025, "chapter_id": 9242, "verse_number": "३-४६-२५", "content_sanskrit": "राक्षसानामयं वासो घोराणां कामरूपिणाम्।\nप्रासादाग्राणि रम्याणि नगरोपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000242026, "chapter_id": 9242, "verse_number": "३-४६-२६", "content_sanskrit": "सम्पन्नानि सुगन्धीनि युक्तान्याचरितुं त्वया।\nवरं माल्यं वरं गन्धं वरं वस्त्रं च शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000242027, "chapter_id": 9242, "verse_number": "३-४६-२७", "content_sanskrit": "भर्तारं च वरं मन्ये त्वद्युक्तमसितेक्षणे।\nका त्वं भवसि रुद्राणां मरुतां वा शुचिस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000242028, "chapter_id": 9242, "verse_number": "३-४६-२८", "content_sanskrit": "वसूनां वा वरारोहे देवता प्रतिभासि मे।\nनेह गच्छन्ति गन्धर्वा न देवा न च किन्नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000242029, "chapter_id": 9242, "verse_number": "३-४६-२९", "content_sanskrit": "राक्षसानामयं वासः कथं तु त्वमिहागता।\nइह शाखामृगाः सिंहा द्वीपिव्याघ्रमृगा वृकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000242030, "chapter_id": 9242, "verse_number": "३-४६-३०", "content_sanskrit": "ऋक्षास्तरक्षवः कङ्काः कथं तेभ्यो न बिभ्यसे।\nमदान्वितानां घोराणां कुञ्जराणां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000242031, "chapter_id": 9242, "verse_number": "३-४६-३१", "content_sanskrit": "कथमेका महारण्ये न बिभेषि वरानने।\nकासि कस्य कुतश्च त्वं किं निमित्तं च दण्डकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000242032, "chapter_id": 9242, "verse_number": "३-४६-३२", "content_sanskrit": "एका चरसि कल्याणि घोरान् राक्षससेवितान्।\nइति प्रशस्ता वैदेही रावणेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000242033, "chapter_id": 9242, "verse_number": "३-४६-३३", "content_sanskrit": "द्विजातिवेषेण हि तं दृष्ट्वा रावणमागतम्।\nसर्वैरतिथिसत्कारैः पूजयामास मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000242034, "chapter_id": 9242, "verse_number": "३-४६-३४", "content_sanskrit": "उपानीयासनं पूर्वं पाद्येनाभिनिमन्त्र्य च।\nअब्रवीत् सिद्धमित्येव तदा तं सौम्यदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000242035, "chapter_id": 9242, "verse_number": "३-४६-३५", "content_sanskrit": "द्विजातिवेषेण समीक्ष्य मैथिली\nसमागतं पात्रकुसुम्भधारिणम्।\nअशक्यमुद‍्द्वेष्टुमुपायदर्शना-\nन्न्यमन्त्रयद् ब्राह्मणवत् तथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000242036, "chapter_id": 9242, "verse_number": "३-४६-३६", "content_sanskrit": "इयं बृसी ब्राह्मण काममास्यता-\nमिदं च पाद्यं प्रतिगृह्यतामिति।\nइदं च सिद्धं वनजातमुत्तमं\nत्वदर्थमव्यग्रमिहोपभुज्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000242037, "chapter_id": 9242, "verse_number": "३-४६-३७", "content_sanskrit": "निमन्त्र्यमाणः प्रतिपूर्णभाषिणीं\nनरेन्द्रपत्नीं प्रसमीक्ष्य मैथिलीम्।\nप्रसह्य तस्या हरणे दृढं मनः\nसमर्पयामास वधाय रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000242038, "chapter_id": 9242, "verse_number": "३-४६-३८", "content_sanskrit": "ततः सुवेषं मृगयागतं पतिं\nप्रतीक्षमाणा सहलक्ष्मणं तदा।\nनिरीक्षमाणा हरितं ददर्श त-\nन्महद् वनं नैव तु रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000242039, "chapter_id": 9242, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]