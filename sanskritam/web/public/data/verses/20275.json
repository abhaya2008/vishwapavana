[{"id": 7000275000, "chapter_id": 20275, "verse_number": "१-२९-१", "content_sanskrit": "एकोनत्रिंशोऽध्यायः ।\nपुलस्त्यौवाच ।\nतथैवान्यत्प्रवक्ष्यामि सर्वकामफलप्रदम् ।\nसौभाग्यशयनंनाम यत्पुराणविदो विदुः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000275001, "chapter_id": 20275, "verse_number": "१-२९-२", "content_sanskrit": "पुरा दग्धेषु लोकेषु भूर्भुवः स्वर्महादिषु ।\nसौभाग्यं सर्वभूतानामेकस्थमभवत्तदा॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000275002, "chapter_id": 20275, "verse_number": "१-२९-३", "content_sanskrit": "वैकुंठं सर्वमासाद्य विष्णोर्वक्षस्थले स्थितम् ।\nततः कालेन कियता पुनः सर्गविधौ नृपः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000275003, "chapter_id": 20275, "verse_number": "१-२९-४", "content_sanskrit": "अहंकारवृतेलोके प्रधानपुरुषान्विते ।\nस्पर्द्धायां च प्रवृद्धायां कमलासनकृष्णयोः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000275004, "chapter_id": 20275, "verse_number": "१-२९-५", "content_sanskrit": "पिंगाकारा समुद्भूता वह्निज्वालातिभीषणा ।\nतयाभितप्तस्य हरेर्वक्षसस्तद्विनिःसृतम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000275005, "chapter_id": 20275, "verse_number": "१-२९-६", "content_sanskrit": "यद्वक्षःस्थलमाश्रित्य विष्णोः सौभाग्यमास्थितम् ।\nरसरूपं न तद्यावदाप्नोति वसुधातले॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000275006, "chapter_id": 20275, "verse_number": "१-२९-७", "content_sanskrit": "उत्क्षिप्तमंतरिक्षात्तु ब्रह्मपुत्रेण धीमता ।\nदक्षेण पीतमात्रं तद्रूपलावण्यकारकम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000275007, "chapter_id": 20275, "verse_number": "१-२९-८", "content_sanskrit": "बलंतेजोमहज्जातं दक्षस्य परमेष्ठिनः ।\nशेषं यदपतद्भूमावष्टधा तद्व्यजायत॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000275008, "chapter_id": 20275, "verse_number": "१-२९-९", "content_sanskrit": "ततस्त्वोषधयो जाताः सप्त सौभाग्यदायिकाः ।\nइक्षवस्तरुराजश्च निष्पवावश्शालिधान्यकम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000275009, "chapter_id": 20275, "verse_number": "१-२९-१०", "content_sanskrit": "विकारवच्च गोक्षीरं कुसुंभं कुसुमं तथा ।\nलवणं चाष्टमं तद्वत्सौभाग्याष्टकमुच्यते॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000275010, "chapter_id": 20275, "verse_number": "१-२९-११", "content_sanskrit": "पीतं यद्ब्रह्मपुत्रेण योगज्ञानविदा पुरा ।\nदुहिता साभवत्तस्माद्या सतीत्यभिधीयते॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000275011, "chapter_id": 20275, "verse_number": "१-२९-१२", "content_sanskrit": "लोकानतीत्य लालित्याल्ललिता तेन चोच्यते ।\nत्रैलोक्यसुंदरीं देवीमुपयेमे पिनाकधृत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000275012, "chapter_id": 20275, "verse_number": "१-२९-१३", "content_sanskrit": "त्रिविश्वसौभाग्यमयीं भुक्तिमुक्तिफलप्रदाम् ।\nतामाराध्य पुमान्भक्त्या नारी वा किं न विंदति॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000275013, "chapter_id": 20275, "verse_number": "१-२९-१४", "content_sanskrit": "भीष्म उवाच ।\nकथमाराधनं तस्या ललिताया मुने वद ।\nयद्विधानं च जगतः शांतये तद्वदस्व मे॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000275014, "chapter_id": 20275, "verse_number": "१-२९-१५", "content_sanskrit": "पुलस्त्य उवाच ।\nवसंतमासमासाद्य तृतीयायां जनप्रियः ।\nशुक्लपक्षस्य पूर्वाह्णे तिलैः स्नानं समाचरेत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000275015, "chapter_id": 20275, "verse_number": "१-२९-१६", "content_sanskrit": "तस्मिन्नहनि सा देवी किल विश्वात्मना सती ।\nपाणिग्रहणिकैर्मंत्रैरुदूढा वरवर्णिनी॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000275016, "chapter_id": 20275, "verse_number": "१-२९-१७", "content_sanskrit": "तया सहैव विश्वेशं तृतीयायामथार्चयेत् ।\nफलैर्नानाविधैर्दीपैर्धूपैर्नैवेद्यसंयुतैः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000275017, "chapter_id": 20275, "verse_number": "१-२९-१८", "content_sanskrit": "प्रतिमां पंचगव्येन तथा गंधोदकेन च ।\nस्नापयित्वार्चयेद्गौरीमिंदुशेखरसंयुताम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000275018, "chapter_id": 20275, "verse_number": "१-२९-१९", "content_sanskrit": "नमोस्तु पाटलायै तु पादौ देव्याः शिवस्य च ।\nशिवायेति च संकीर्त्य जयायै गुल्फयोर्द्वयोः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000275019, "chapter_id": 20275, "verse_number": "१-२९-२०", "content_sanskrit": "त्र्यंबकायेति रुद्रस्य भवान्यै जंघयोर्युगम् ।\nशिरो रुद्रेश्वरायेति विजयायै च जानुनी॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000275020, "chapter_id": 20275, "verse_number": "१-२९-२१", "content_sanskrit": "संकीर्त्य हरिकेशाय तथोरुवरदे नमः ।\nईशायेति कटिं रत्यै शंकरायेति शंकरम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000275021, "chapter_id": 20275, "verse_number": "१-२९-२२", "content_sanskrit": "कुक्षिद्वयं च कोटव्यै शूलिनं शूलपाणये ।\nमंगलायै नमस्तुभ्यमुदरं चाभिभूजयेत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000275022, "chapter_id": 20275, "verse_number": "१-२९-२३", "content_sanskrit": "सर्वात्मने नमो रुद्रमीशान्यै च कुचद्वयम् ।\nशिवं वेदात्मने तद्वद्रुद्राण्यै कंठमर्चयेत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000275023, "chapter_id": 20275, "verse_number": "१-२९-२४", "content_sanskrit": "त्रिपुरघ्नाय विश्वेशमनंतायै करद्वयम् ।\nत्रिलोचनायेति हरं बाहू कालानलप्रिये॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000275024, "chapter_id": 20275, "verse_number": "१-२९-२५", "content_sanskrit": "सौभाग्यभवनायेति भूषणानि सदार्चयेत् ।\nस्वाहास्वधायै च मुखमीश्वरायेति शूलिनम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000275025, "chapter_id": 20275, "verse_number": "१-२९-२६", "content_sanskrit": "अशोकवनवासिन्यै पूज्यावोष्ठौ च भूतिदौ ।\nस्थाणवे च हरं तद्वदास्यं चंद्रमुखप्रिये॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000275026, "chapter_id": 20275, "verse_number": "१-२९-२७", "content_sanskrit": "नमोर्धनारीशहरमसितांगीति नासिकाम् ।\nनम उग्राय लोकेशं ललितेति पुनर्भ्रुवौ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000275027, "chapter_id": 20275, "verse_number": "१-२९-२८", "content_sanskrit": "शर्वाय पुरहर्त्तारं वासुदेव्यै तथालकम् ।\nनमः श्रीकंठनाथाय शिवकेशांस्तथार्चयेत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000275028, "chapter_id": 20275, "verse_number": "१-२९-२९", "content_sanskrit": "भीमोग्रभीमरूपिण्यै शिरः सर्वात्मने नमः ।\nहरमभ्यर्च्य विधिवत्सौभाग्याष्टकमग्रतः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000275029, "chapter_id": 20275, "verse_number": "१-२९-३०", "content_sanskrit": "स्थापयेत्स्निग्धनिष्पावान्कुसुंभक्षीरजीरकम् ।\nतरुराजेक्षुलवणं कुस्तुंबुरुमथाष्टमम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000275030, "chapter_id": 20275, "verse_number": "१-२९-३१", "content_sanskrit": "दद्यात्सौभाग्यकृद्यस्मात्सौभाग्याष्टकमित्युत ।\nएवंनिवेद्य तत्सर्वमग्रतः शिवयोः पुनः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000275031, "chapter_id": 20275, "verse_number": "१-२९-३२", "content_sanskrit": "चैत्रे शृंगाटकान्प्राश्य स्वपेद्भूमावरिंदम ।\nपुनः प्रभाते च तथा कृतस्नानजपः शुचिः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000275032, "chapter_id": 20275, "verse_number": "१-२९-३३", "content_sanskrit": "संपूज्य द्विजदांपत्यं माल्यवस्त्रं विभूषणैः ।\nसौभाग्याष्टकसंयुक्त सौवर्णं प्रतिमाद्वयम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000275033, "chapter_id": 20275, "verse_number": "१-२९-३४", "content_sanskrit": "प्रीयतां मेत्र ललिता ब्राह्मणाय निवेदयेत् ।\nएवं संवत्सरं यावत्तृतीयायां सदा नृप॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000275034, "chapter_id": 20275, "verse_number": "१-२९-३५", "content_sanskrit": "प्राशने दानमंत्रे च विशेषोयं निबोध मे ।\nगोशृंगांबु मधौ प्रोक्तं वैशाखे गोमयं पुनः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000275035, "chapter_id": 20275, "verse_number": "१-२९-३६", "content_sanskrit": "ज्येष्ठे मंदारकुसुमं बिल्वपत्रं शुचौ स्मृतम् ।\nश्रावणे दधिसंप्राश्यं नभस्ये तु कुशोदकम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000275036, "chapter_id": 20275, "verse_number": "१-२९-३७", "content_sanskrit": "क्षीरं चाश्वयुजे मासि कार्त्तिके पृषदाज्यकम् ।\nमार्गशीर्षे तु गोमूत्रं पौषे संप्राशयेद्घृतम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000275037, "chapter_id": 20275, "verse_number": "१-२९-३८", "content_sanskrit": "माघे कृष्णतिलांस्तद्वत्पंचगव्यं च फाल्गुने ।\nललिता विजया भद्रा भवानी कुमुदा शिवा॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000275038, "chapter_id": 20275, "verse_number": "१-२९-३९", "content_sanskrit": "वासुदेवी तथा गौरी मंगला कमला सती ।\nउमा च दानकाले तु प्रीयतामिति कीर्त्तयेत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000275039, "chapter_id": 20275, "verse_number": "१-२९-४०", "content_sanskrit": "तस्मिंस्तु द्वादशे मासि द्वादश्यां कृष्णमर्चयेत् ।\nतथा लक्ष्मीं च तत्रैव भर्त्रा सार्धमथार्चयेत्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000275040, "chapter_id": 20275, "verse_number": "१-२९-४१", "content_sanskrit": "पौर्णमास्यामतस्तद्वत्सपत्नीकः पितामहः ।\nउपासनीयो विदुषा परत्रा भीतिमिच्छता॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000275041, "chapter_id": 20275, "verse_number": "१-२९-४२", "content_sanskrit": "सौभाग्याष्टकं तद्वच्च दातव्यं भूतिमिच्छता ।\nमल्लिकाशोककमलं कदंबोत्पलचंपकम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000275042, "chapter_id": 20275, "verse_number": "१-२९-४३", "content_sanskrit": "कुब्जकं करवीरं च बाणमम्लानपंकजम् ।\nसिंदुवारं च सर्वेषु मासेषु कुसुमं स्मृतम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000275043, "chapter_id": 20275, "verse_number": "१-२९-४४", "content_sanskrit": "जपाकुसुंभकुसुमं मालती शतपत्रिका ।\nयथालाभं प्रशस्तानि करवीरं च सर्वदा॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000275044, "chapter_id": 20275, "verse_number": "१-२९-४५", "content_sanskrit": "एवं संवत्सरं यावदुपोष्य विधिवन्नरः ।\nस्त्री च नक्तं कुमारी च शिवमभ्यर्च्य भक्तितः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000275045, "chapter_id": 20275, "verse_number": "१-२९-४६", "content_sanskrit": "व्रतांते शयनं दद्यात्सर्वोपस्करसंयुतम् ।\nउमामहेश्वरौ हैमौ वृषभं च गवा सह॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000275046, "chapter_id": 20275, "verse_number": "१-२९-४७", "content_sanskrit": "स्थापयित्वा च शयनं ब्राह्मणाय निवेदयेत् ।\nद्वादश्यां वत्सरं त्वेकं महालक्ष्म्या च केशवम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000275047, "chapter_id": 20275, "verse_number": "१-२९-४८", "content_sanskrit": "ब्रह्माणं सह सावित्र्या पूजयित्वा नरस्त्विह ।\nसर्वान्कामानवाप्नोति मनसा समभीप्सितान्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000275048, "chapter_id": 20275, "verse_number": "१-२९-४९", "content_sanskrit": "अन्यान्यपि यथाशक्ति मिथुनान्यंबरादिभिः ।\nधान्यालङ्कारगोदानैरन्यैश्च धनसञ्चयैः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000275049, "chapter_id": 20275, "verse_number": "१-२९-५०", "content_sanskrit": "वित्तशाठयेन रहितः पूजयेद्गतविस्मयः ।\nएवं करोति यः सम्यक्सौभाग्यशयनव्रतम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000275050, "chapter_id": 20275, "verse_number": "१-२९-५१", "content_sanskrit": "सर्वान्कामानवाप्नोति पदं वा नित्यमश्नुते ।\nफलस्यैकस्य च त्यागमेतत्कुर्वन्समाचरेत्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000275051, "chapter_id": 20275, "verse_number": "१-२९-५२", "content_sanskrit": "यशः कीर्तिमवाप्नोति प्रतिमासं नराधिप ।\nसौभाग्यारोग्यरूपैश्च वस्त्रालंकारभूषणैः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000275052, "chapter_id": 20275, "verse_number": "१-२९-५३", "content_sanskrit": "न वियुक्तो भवेद्राजन्सौभाग्यशयनप्रदः ।\nयस्तु द्वादशवर्षाणि सौभाग्यशयनव्रतम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000275053, "chapter_id": 20275, "verse_number": "१-२९-५४", "content_sanskrit": "करोति सप्त चाष्टौ वा ब्रह्मलोके महीयते ।\nपूज्यमानो वसेत्सम्यक्यावत्कल्पायुतं नरः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000275054, "chapter_id": 20275, "verse_number": "१-२९-५५", "content_sanskrit": "विष्णोर्लोकमथासाद्य शिवलोकगतस्तथा ।\nनारी वा कुरुते या तु कुमारी वा नरेश्वर॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000275055, "chapter_id": 20275, "verse_number": "१-२९-५६", "content_sanskrit": "सापि तत्फलमाप्नोति देव्यनुग्रहलालिता ।\nशृणुयादपि यश्चैव प्रदद्यादथवा मतिम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000275056, "chapter_id": 20275, "verse_number": "१-२९-५७", "content_sanskrit": "सोपि विद्याधरो भूत्वा स्वर्गलोके चिरं वसेत् ।\nइदमिह मदनेन पूर्वसृष्टं शतधनुषा च कृतं नरेण तद्वत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000275057, "chapter_id": 20275, "verse_number": "१-२९-५८", "content_sanskrit": "कृतमथ पवनेन नंदिना च किमु जननाथमहाद्भुतं न वा स्यात्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]