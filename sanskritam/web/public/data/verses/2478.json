[{"id": 2070436, "chapter_id": 2478, "verse_number": "११-१०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070437, "chapter_id": 2478, "verse_number": "११-१०-१", "content_sanskrit": "क्रोशमात्रं ततो गत्वा ददृशुस्तान्महारथान्।\nशारद्वतं कृपं द्रौणिं कृतवर्माणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070438, "chapter_id": 2478, "verse_number": "११-१०-२", "content_sanskrit": "ते तु दृष्ट्वैव राजानं प्रज्ञाचक्षुषमीश्वरम्।\nअश्रुकण्ठा विनिःश्वस्य रुदन्तमिदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070439, "chapter_id": 2478, "verse_number": "११-१०-३", "content_sanskrit": "पुत्रस्तव महाराज कृत्वा कर्म सुदुष्करम्।\nगतः सानुचरो राजञ्शक्रलोकं महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070440, "chapter_id": 2478, "verse_number": "११-१०-४", "content_sanskrit": "दुर्योधनबलान्मुक्ता वयमेव त्रयो रथाः।\nसर्वमन्यत्परिक्षीणं सैन्यं ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070441, "chapter_id": 2478, "verse_number": "११-१०-५", "content_sanskrit": "इत्येवमुक्त्वा राजानं कृपः शारद्वतस्ततः।\nगान्धारीं पुत्रशोकार्तामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070442, "chapter_id": 2478, "verse_number": "११-१०-६", "content_sanskrit": "अभीता युध्यमानास्ते घ्नन्तः शत्रुगणान्बहून्।\nवीरकर्माणि कुर्वाणाः पुत्रास्ते निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070443, "chapter_id": 2478, "verse_number": "११-१०-७", "content_sanskrit": "ध्रवं सम्प्राप्य लोकांस्ते निर्मलाञ्शस्त्रनिर्जितान्।\nभास्वरं देहमास्थाय विहरन्त्यमरा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070444, "chapter_id": 2478, "verse_number": "११-१०-८", "content_sanskrit": "सर्वे ह्यभिमुखा राज्ञि युध्यमाना हता युधि।\nन हि कश्चिद्धि शूराणां युध्यमानः पराङ्मुखः।\nशस्त्रेण निधनं प्राप्तो न च कश्चित्कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070445, "chapter_id": 2478, "verse_number": "११-१०-९", "content_sanskrit": "एतां तां क्षत्रियस्याहुः पुराणाः परमां गतिम्।\nशस्त्रेण निधनं सङ्ख्ये तान्न शोचितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070446, "chapter_id": 2478, "verse_number": "११-१०-१०", "content_sanskrit": "न चापि शत्रवस्तेषां मुच्यन्ते राज्ञि पाण्डवाः।\nशृणु यत्कृतमस्माभिरश्वत्थामपुरोगमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070447, "chapter_id": 2478, "verse_number": "११-१०-११", "content_sanskrit": "अधर्मेण हतं श्रुत्वा भीमसेनेन ते सुतम्।\nसुप्तं शिबिरमासाद्य पाण्डूनां कदनं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070448, "chapter_id": 2478, "verse_number": "११-१०-१२", "content_sanskrit": "पाञ्चाला निहताः सर्वे धृष्टद्युम्नपुरोगमाः।\nद्रुपदस्यात्मजाश्चैव द्रौपदेयाश्च पातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070449, "chapter_id": 2478, "verse_number": "११-१०-१३", "content_sanskrit": "तथा विशसनं कृत्वा पुत्रशत्रुगणस्य ते।\nप्राद्रवाम रणे स्थातुं न हि शक्ष्यामहे त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070450, "chapter_id": 2478, "verse_number": "११-१०-१४", "content_sanskrit": "ते हि शूरा महेष्वासाः क्षिप्रमेष्यन्ति पाण्डवाः।\nअमर्षवशमापन्ना वैरं प्रतिजिहीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070451, "chapter_id": 2478, "verse_number": "११-१०-१५", "content_sanskrit": "ते हतानात्मजाञ्श्रुत्वा प्रमत्ताः पुरुषर्षभाः।\nअन्विष्यन्तः पदं शूराः क्षिप्रमेष्यन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070452, "chapter_id": 2478, "verse_number": "११-१०-१६", "content_sanskrit": "तेषां तु किल्बिषं कृत्वा संस्थातुं नोत्सहामहे।\nअनुजानीहि नो राज्ञि मा च शोके मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070453, "chapter_id": 2478, "verse_number": "११-१०-१७", "content_sanskrit": "राजंस्त्वमनुजानीहि धैर्यमातिष्ठ चोत्तमम्।\nदिष्टान्तं पश्य चापि त्वं क्षात्रं धर्मं च केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070454, "chapter_id": 2478, "verse_number": "११-१०-१८", "content_sanskrit": "इत्येवमुक्त्वा राजानं कृत्वा चाभिप्रदक्षिणम्।\nकृपश्च कृतवर्मा च द्रोमपुत्रश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070455, "chapter_id": 2478, "verse_number": "११-१०-१९", "content_sanskrit": "अवेक्षमाणा राजानं धृतराष्ट्रं मनीषिणम्।\nगङ्गामनु महाराज तूर्णमश्वानचोदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070456, "chapter_id": 2478, "verse_number": "११-१०-२०", "content_sanskrit": "अपक्रम्य तु ते राजन्सर्व एव महारथाः।\nआमन्त्र्यान्योन्यमुद्विग्नास्त्रिधा ते प्रययुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070457, "chapter_id": 2478, "verse_number": "११-१०-२१", "content_sanskrit": "जगाम हास्तिनपुरं कृपः शारद्वतस्तदा।\nस्वमेव राष्ट्रं हार्दिक्यो द्रौणिर्व्यासाश्रमं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070458, "chapter_id": 2478, "verse_number": "११-१०-२२", "content_sanskrit": "एवं ते प्रययुर्वीरा वीक्षमाणाः परस्परम्।\nभयार्ताः पाण्डुपुत्राणामागस्कृत्वा महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070459, "chapter_id": 2478, "verse_number": "११-१०-२३", "content_sanskrit": "समेत्य वीरा राजानं तदा त्वनुदिते रषौ।\nविप्रजग्मुर्महात्मानो यथेष्टकमरिन्दमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070460, "chapter_id": 2478, "verse_number": "११-१०-२४", "content_sanskrit": "[समासाद्याथ वै द्रौणिं पाण्डुपुत्रा महारथाः।\nव्यजयंस्ते रणे राजन्विक्रम्य तदनन्तरम्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070461, "chapter_id": 2478, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि दशमोऽध्यायः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]