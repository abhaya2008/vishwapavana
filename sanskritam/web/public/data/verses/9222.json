[{"id": 5000222000, "chapter_id": 9222, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000222001, "chapter_id": 9222, "verse_number": "३-२६-१", "content_sanskrit": "दूषणस्तु स्वकं सैन्यं हन्यमानं विलोक्य च।\nसंदिदेश महाबाहुर्भीमवेगान् दुरासदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000222002, "chapter_id": 9222, "verse_number": "३-२६-२", "content_sanskrit": "राक्षसान् पञ्चसाहस्रान् समरेष्वनिवर्तिनः।\nते शूलैः पट्टिशैः खड्गैः शिलावर्षैर्द्रुमैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000222003, "chapter_id": 9222, "verse_number": "३-२६-३", "content_sanskrit": "शरवर्षैरविच्छिन्नं ववर्षुस्तं समन्ततः।\nतद् द्रुमाणां शिलानां च वर्षं प्राणहरं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000222004, "chapter_id": 9222, "verse_number": "३-२६-४", "content_sanskrit": "प्रतिजग्राह धर्मात्मा राघवस्तीक्ष्णसायकैः।\nप्रतिगृह्य च तद् वर्षं निमीलित इवर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000222005, "chapter_id": 9222, "verse_number": "३-२६-५", "content_sanskrit": "रामः क्रोधं परं लेभे वधार्थं सर्वरक्षसाम्।\nततः क्रोधसमाविष्टः प्रदीप्त इव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000222006, "chapter_id": 9222, "verse_number": "३-२६-६", "content_sanskrit": "शरैरभ्यकिरत् सैन्यं सर्वतः सहदूषणम्।\nततः सेनापतिः क्रुद्धो दूषणः शत्रुदूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000222007, "chapter_id": 9222, "verse_number": "३-२६-७", "content_sanskrit": "शरैरशनिकल्पैस्तं राघवं समवारयत्।\nततो रामः सुसंक्रुद्धः क्षुरेणास्य महद् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000222008, "chapter_id": 9222, "verse_number": "३-२६-८", "content_sanskrit": "चिच्छेद समरे वीरश्चर्तुभिश्चतुरो हयान्।\nहत्वा चाश्वान् शरैस्तीक्ष्णैरर्धचन्द्रेण सारथेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000222009, "chapter_id": 9222, "verse_number": "३-२६-९", "content_sanskrit": "शिरो जहार तद्रक्षस्त्रिभिर्विव्याध वक्षसि।\nस च्छिन्नधन्वा विरथो हताश्वो हतसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000222010, "chapter_id": 9222, "verse_number": "३-२६-१०", "content_sanskrit": "जग्राह गिरिशृङ्गाभं परिघं रोमहर्षणम्।\nवेष्टितं काञ्चनैः पट्टैर्देवसैन्याभिमर्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000222011, "chapter_id": 9222, "verse_number": "३-२६-११", "content_sanskrit": "आयसैः शङ्कुभिस्तीक्ष्णैः कीर्णं परवसोक्षितम्।\nवज्राशनिसमस्पर्शं परगोपुरदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000222012, "chapter_id": 9222, "verse_number": "३-२६-१२", "content_sanskrit": "तं महोरगसंकाशं प्रगृह्य परिघं रणे।\nदूषणोऽभ्यपतद् रामं क्रूरकर्मा निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000222013, "chapter_id": 9222, "verse_number": "३-२६-१३", "content_sanskrit": "तस्याभिपतमानस्य दूषणस्य च राघवः।\nद्वाभ्यां शराभ्यां चिच्छेद सहस्ताभरणौ भुजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000222014, "chapter_id": 9222, "verse_number": "३-२६-१४", "content_sanskrit": "भ्रष्टस्तस्य महाकायः पपात रणमूर्धनि।\nपरिघश्छिन्नहस्तस्य शक्रध्वज इवाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000222015, "chapter_id": 9222, "verse_number": "३-२६-१५", "content_sanskrit": "कराभ्यां च विकीर्णाभ्यां पपात भुवि दूषणः।\nविषाणाभ्यां विशीर्णाभ्यां मनस्वीव महागजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000222016, "chapter_id": 9222, "verse_number": "३-२६-१६", "content_sanskrit": "दृष्ट्वा तं पतितं भूमौ दूषणं निहतं रणे।\nसाधु साध्विति काकुत्स्थं सर्वभूतान्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000222017, "chapter_id": 9222, "verse_number": "३-२६-१७", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धास्त्रयः सेनाग्रयायिनः।\nसंहत्याभ्यद्रवन् रामं मृत्युपाशावपाशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000222018, "chapter_id": 9222, "verse_number": "३-२६-१८", "content_sanskrit": "महाकपालः स्थूलाक्षः प्रमाथी च महाबलः।\nमहाकपालो विपुलं शूलमुद्यम्य राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000222019, "chapter_id": 9222, "verse_number": "३-२६-१९", "content_sanskrit": "स्थूलाक्षः पट्टिशं गृह्य प्रमाथी च परश्वधम्।\nदृष्ट्वैवापततस्तांस्तु राघवः सायकैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000222020, "chapter_id": 9222, "verse_number": "३-२६-२०", "content_sanskrit": "तीक्ष्णाग्रैः प्रतिजग्राह सम्प्राप्तानतिथीनिव।\nमहाकपालस्य शिरश्चिच्छेद रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000222021, "chapter_id": 9222, "verse_number": "३-२६-२१", "content_sanskrit": "असंख्येयैस्तु बाणौघैः प्रममाथ प्रमाथिनम्।\nस्थूलाक्षस्याक्षिणी स्थूले पूरयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000222022, "chapter_id": 9222, "verse_number": "३-२६-२२", "content_sanskrit": "स पपात हतो भूमौ विटपीव महाद्रुमः।\nदूषणस्यानुगान् पञ्चसाहस्रान् कुपितः क्षणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000222023, "chapter_id": 9222, "verse_number": "३-२६-२३", "content_sanskrit": "हत्वा तु पञ्चसाहस्रैरनयद् यमसादनम्।\nदूषणं निहतं श्रुत्वा तस्य चैव पदानुगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000222024, "chapter_id": 9222, "verse_number": "३-२६-२४", "content_sanskrit": "व्यादिदेश खरः क्रुद्धः सेनाध्यक्षान् महाबलान्।\nअयं विनिहतः संख्ये दूषणः सपदानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000222025, "chapter_id": 9222, "verse_number": "३-२६-२५", "content_sanskrit": "महत्या सेनया सार्धं युद‍्ध्वा रामं कुमानुषम्।\nशस्त्रैर्नानाविधाकारैर्हनध्वं सर्वराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000222026, "chapter_id": 9222, "verse_number": "३-२६-२६", "content_sanskrit": "एवमुक्त्वा खरः क्रुद्धो राममेवाभिदुद्रुवे।\nश्येनगामी पृथुग्रीवो यज्ञशत्रुर्विहंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000222027, "chapter_id": 9222, "verse_number": "३-२६-२७", "content_sanskrit": "दुर्जयः करवीराक्षः परुषः कालकार्मुकः।\nहेममाली महामाली सर्पास्यो रुधिराशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000222028, "chapter_id": 9222, "verse_number": "३-२६-२८", "content_sanskrit": "द्वादशैते महावीर्या बलाध्यक्षाः ससैनिकाः।\nराममेवाभ्यधावन्त विसृजन्तः शरोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000222029, "chapter_id": 9222, "verse_number": "३-२६-२९", "content_sanskrit": "ततः पावकसंकाशैर्हेमवज्रविभूषितैः।\nजघान शेषं तेजस्वी तस्य सैन्यस्य सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000222030, "chapter_id": 9222, "verse_number": "३-२६-३०", "content_sanskrit": "ते रुक्मपुङ्खा विशिखाः सधूमा इव पावकाः।\nनिजघ्नुस्तानि रक्षांसि वज्रा इव महाद्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000222031, "chapter_id": 9222, "verse_number": "३-२६-३१", "content_sanskrit": "रक्षसां तु शतं रामः शतेनैकेन ‍किर्णना।\nसहस्रं तु सहस्रेण जघान रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000222032, "chapter_id": 9222, "verse_number": "३-२६-३२", "content_sanskrit": "तैर्भिन्नवर्माभरणाश्छिन्नभिन्नशरासनाः।\nनिपेतुः शोणितादिग्धा धरण्यां रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000222033, "chapter_id": 9222, "verse_number": "३-२६-३३", "content_sanskrit": "तैर्मुक्तकेशैः समरे पतितैः शोणितोक्षितैः।\nविस्तीर्णा वसुधा कृत्स्ना महावेदिः कुशैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000222034, "chapter_id": 9222, "verse_number": "३-२६-३४", "content_sanskrit": "तत्क्षणे तु महाघोरं वनं निहतराक्षसम्।\nबभूव निरयप्रख्यं मांसशोणितकर्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000222035, "chapter_id": 9222, "verse_number": "३-२६-३५", "content_sanskrit": "चतुर्दशसहस्राणि रक्षसां भीमकर्मणाम्।\nहतान्येकेन रामेण मानुषेण पदातिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000222036, "chapter_id": 9222, "verse_number": "३-२६-३६", "content_sanskrit": "तस्य सैन्यस्य सर्वस्य खरः शेषो महारथः।\nराक्षसस्त्रिशिराश्चैव रामश्च रिपुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000222037, "chapter_id": 9222, "verse_number": "३-२६-३७", "content_sanskrit": "शेषा हता महावीर्या राक्षसा रणमूर्धनि।\nघोरा दुर्विषहाः सर्वे लक्ष्मणस्याग्रजेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000222038, "chapter_id": 9222, "verse_number": "३-२६-३८", "content_sanskrit": "ततस्तु तद्भीमबलं महाहवे\nसमीक्ष्य रामेण हतं बलीयसा।\nरथेन रामं महता खरस्ततः\nसमाससादेन्द्र इवोद्यताशनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000222039, "chapter_id": 9222, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]