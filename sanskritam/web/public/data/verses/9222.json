[{"id": 40015360, "chapter_id": 9222, "verse_number": "1", "content_sanskrit": "अथतांजातन्तापांतेनवाक्येनमोहिताम् । सरमाह्लादयामासमहींघौरीमिवाम्भसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015361, "chapter_id": 9222, "verse_number": "2", "content_sanskrit": "ततस्तस्याहितंसख्याश्चिकीर्षन्तीसखीवचः । उवाचकालेकालज्ञास्मितपूर्वाभिभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015362, "chapter_id": 9222, "verse_number": "3", "content_sanskrit": "उत्सहेयमहंगत्वात्वद्वाक्यमसितेक्षणे: । निवेद्यकुशलंरामेप्रतिच्छन्नानिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015363, "chapter_id": 9222, "verse_number": "4", "content_sanskrit": "नहिमेक्रममाणायानिरालम्बेविहायसि । समर्थोगतिमन्वेतुंपवनोगरुडोऽपिवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015364, "chapter_id": 9222, "verse_number": "5", "content_sanskrit": "एवंब्रुवाणांतांसीतासरमांपुनरब्रवीत् । मधुरंश्लक्क्षणयावाचापूर्वशोकाभिपन्नया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015365, "chapter_id": 9222, "verse_number": "6", "content_sanskrit": "समर्थागगनंगन्तुमपिवात्वंरसातलम् । अवगच्छाम्यकर्तव्यंकर्तव्यंतेमदन्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015366, "chapter_id": 9222, "verse_number": "7", "content_sanskrit": "मत्प्रियंयदिकर्तव्यंयदिबुद्धि: स्थिरातव । ज्ञातुमिच्छामितंगत्वाकिंकरोतीतिरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015367, "chapter_id": 9222, "verse_number": "8", "content_sanskrit": "सहिमायाबलःक्रूरोरावणश्शत्रुरावणः । मांमोहयतिदुष्टात्मापीतामात्रेववारुणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015368, "chapter_id": 9222, "verse_number": "9", "content_sanskrit": "तर्जापयतिमांनित्यंभर्त्सापयतिचासकृत् । राक्षसीभिस्सुघूराभिर्यामांरक्षन्तिनित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015369, "chapter_id": 9222, "verse_number": "10", "content_sanskrit": "उद्विग्नाशङ्किताचास्मिनस्वस्थंचमनोमम । तद्भयाच्चाहमुद्विग्नाअशोकवनिकांगता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015370, "chapter_id": 9222, "verse_number": "11", "content_sanskrit": "यदिनामकथातस्यनिश्चितंवापियद्भवेत् । निवेदयेथास्सर्वंतत्परोमेस्यादमनुग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015371, "chapter_id": 9222, "verse_number": "12", "content_sanskrit": "सात्वेवंब्रुवतींसीतांसरमावल्गुभाषिणी । उवाचवदनंतस्यास्स्पृशन्तीबाष्पविक्लबम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015372, "chapter_id": 9222, "verse_number": "13", "content_sanskrit": "एषतेयद्यभिप्रायस्तदागच्छामिजानकी: । गृह्यशत्रोरभिप्रायमुपावृत्तांचपश्यमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015373, "chapter_id": 9222, "verse_number": "14", "content_sanskrit": "एवमुक्त्वाततोगत्वासमीपंतस्यरक्षसः । शुश्रावकथितंतस्यरावणस्यसमन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015374, "chapter_id": 9222, "verse_number": "15", "content_sanskrit": "साश्रुत्वानिश्चयंतस्यनिश्चयज्ञादुरात्मनः । पुनरेवागमत्क्षिप्रमशोकवनिकांशुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015375, "chapter_id": 9222, "verse_number": "16", "content_sanskrit": "साप्रविष्टाततस्तत्रददर्शजनकात्मजाम् । प्रतीक्षमाणांस्वामेवभ्रष्टपद्मामिवश्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015376, "chapter_id": 9222, "verse_number": "17", "content_sanskrit": "तांतुसीतापुनःप्राप्तांसरमांवल्गुभाषिणीम् । परिष्वज्यचसुस्निग्धंददौचस्वयमासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015377, "chapter_id": 9222, "verse_number": "18", "content_sanskrit": "इहासीनासुखंसर्वमाख्याहिममतत्त्वतः । क्रूरस्यनिश्चयंतस्यरावणस्यदुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015378, "chapter_id": 9222, "verse_number": "19", "content_sanskrit": "एवमुक्तातुसरमासीतयावेपमानया । कथितंसर्वमाचष्टेरावणस्यसमन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015379, "chapter_id": 9222, "verse_number": "20", "content_sanskrit": "जनन्याराक्षसेन्द्रोवैत्वन्मोक्षार्थंबृहद्वचः । अविद्धेनचवैदेहिमन्त्रिवृद्धेनबोधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015380, "chapter_id": 9222, "verse_number": "21", "content_sanskrit": "दीयतामभिसत्कृत्यमनुजेन्द्रायमैथिली । निदर्शनंतेपर्याप्तंजनस्थानेयदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40015381, "chapter_id": 9222, "verse_number": "22", "content_sanskrit": "लङ्घनंचसमुद्रस्यदर्शनंचहनूमतः । वधंचरक्षसांयुद्धेकःकुर्यान्मानुषोभुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40015382, "chapter_id": 9222, "verse_number": "23", "content_sanskrit": "एवंसमन्त्रिवृद्धैश्चाविद्धेनबहुभाषितः । नत्वामुत्पनिहतेमोक्तुमर्थमर्थपरोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40015383, "chapter_id": 9222, "verse_number": "24", "content_sanskrit": "नोत्सहत्यमृतोमोक्तुंयुद्धेत्वामितिमैथिली: । सामात्यस्यनृशंसस्यनिश्चयोह्येषवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40015384, "chapter_id": 9222, "verse_number": "25", "content_sanskrit": "तदेषासुस्थिराबुद्धिर्मृत्युलोभादुपस्थिता । भयान्नशक्तस्त्वांमोक्तुमनिरस्तस्संयुगे ॥ रक्षसानांचसर्वेषामात्मनश्चवधेनहि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40015385, "chapter_id": 9222, "verse_number": "26", "content_sanskrit": "निहत्यरावणंसङ् ख्येसर्वथानिशितैश्शरैः ॥ प्रतिनेष्यतिरामस्त्वामयोध्यामसितेक्षणे: ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40015386, "chapter_id": 9222, "verse_number": "27", "content_sanskrit": "एतस्मिन्नन्तरेशब्दोभेरीशङ्खसमाकुलः ॥ श्रुतोवानरसैन्यानांकम्पयन् धरणीतलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40015387, "chapter_id": 9222, "verse_number": "28", "content_sanskrit": "श्रुत्वातुतद्वानरसैन्यशब्दंलङ्कागताराक्षसराजभृत्याः । नष्टौजसोदैन्यरीतचेष्टाःश्रेयोनपश्यन्तिनृपस्यदोषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]