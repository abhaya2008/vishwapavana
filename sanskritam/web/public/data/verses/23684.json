[{"id": 7003684000, "chapter_id": 23684, "verse_number": "१-३-५-१", "content_sanskrit": "ब्रह्मोवाच ।\nअरण्याद्गौतमं शांतमुटजद्वार आगतम् ।\nप्रत्याधातुं प्रववृते शिवभक्तिर्जगन्मयी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003684001, "chapter_id": 23684, "verse_number": "१-३-५-२", "content_sanskrit": "आलुलोके समायातं गौतमं शिष्यसेवितम् ।\nलंबमानशिरःश्मश्रुसम्पूर्णमुखमण्डलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003684002, "chapter_id": 23684, "verse_number": "१-३-५-३", "content_sanskrit": "जटाभिरतिताम्राभिस्तीर्थस्नानविशुद्धिभिः ।\nन्यस्तरुद्राक्षमणिभिर्ज्वालाभिरिव पावकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003684003, "chapter_id": 23684, "verse_number": "१-३-५-४", "content_sanskrit": "भस्मत्रिपुण्ड्रकोपेतविशालनिटिलोज्वलम् ।\nशुक्लयज्ञोपवीतेन पूर्णं रुद्राक्षदामभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003684004, "chapter_id": 23684, "verse_number": "१-३-५-५", "content_sanskrit": "दधानं वल्कले रक्ते तपः कृशितविग्रहम् ।\nजपंतं वैदिकान्मंत्रान्रुद्रप्रीतिकरान्बहून् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003684005, "chapter_id": 23684, "verse_number": "१-३-५-६", "content_sanskrit": "शम्भुनावसितोदात्तसारूप्यमिव भाषितम् ।\nतेजोनिधिं दयापूर्णं प्रत्यक्षमिव भास्करम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003684006, "chapter_id": 23684, "verse_number": "१-३-५-७", "content_sanskrit": "आलोक्य तं महात्मानं वृद्धं शंभुपदाश्रयम् ।\nकृतांजलिपुटा गौरी प्रणन्तुमुपचक्रमे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003684007, "chapter_id": 23684, "verse_number": "१-३-५-८", "content_sanskrit": "कृतांजलिं मुनिर्वीक्ष्य समस्तजगदम्बिकाम् ।\nकिमेतदिति साश्चर्यं वारयन्प्रणनाम सः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003684008, "chapter_id": 23684, "verse_number": "१-३-५-९", "content_sanskrit": "स्वागतं गौरि सुभगे लोकमातर्दयानिधे ।\nव्याजेन भक्तसंरक्षां कर्तुमत्रागतास्यहो ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003684009, "chapter_id": 23684, "verse_number": "१-३-५-१०", "content_sanskrit": "अहो मान्ये मान्यमर्थं विज्ञायैव पुरा वयम् ।\nपृथग्भावमिवालंब्य शिष्यादिभिः समागताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003684010, "chapter_id": 23684, "verse_number": "१-३-५-११", "content_sanskrit": "यद्देवि ते न चेत्किंचिन्मायाविलसितन्निजम् ।\nततः प्रपंचसंसिद्धिः कथमेव भविष्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003684011, "chapter_id": 23684, "verse_number": "१-३-५-१२", "content_sanskrit": "तिष्ठत्वशेषं मे वक्तुं मायाविलसितं तव ।\nन शक्यते यन्निर्णेतुं त्वदीयैश्च कदाचन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003684012, "chapter_id": 23684, "verse_number": "१-३-५-१३", "content_sanskrit": "आस्यतां पावने शुद्धं आसने कुशनिर्मिते ।\nगृह्यतां पाद्यमर्घं च दत्तं च विधिवन्मया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003684013, "chapter_id": 23684, "verse_number": "१-३-५-१४", "content_sanskrit": "इति शिष्यैः समानीते दर्भांके परमासने ।\nआसीनामंबिकां वृद्धो मुनिरानर्च भक्तिमान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003684014, "chapter_id": 23684, "verse_number": "१-३-५-१५", "content_sanskrit": "निवेद्य सकलां पूजां भक्तिभावसमन्वितः ।\nगौर्या समभ्यनुज्ञातः स्वयमप्यासने स्थितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003684015, "chapter_id": 23684, "verse_number": "१-३-५-१६", "content_sanskrit": "उवाच दशनज्योत्स्नापरिधौतदिशामुखः ।\nपुलकांचितसर्वांगः सानंदाश्रु सगद्गदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003684016, "chapter_id": 23684, "verse_number": "१-३-५-१७", "content_sanskrit": "अहो देवस्य माहात्म्यं शम्भोरमिततेजसः ।\nसद्भक्त रक्षणाय त्वामादिशद्भक्तवत्सलः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003684017, "chapter_id": 23684, "verse_number": "१-३-५-१८", "content_sanskrit": "असिद्धमन्यल्लब्धव्यं किं वान्यत्तव विद्यते ।\nअम्बैतद्भक्तिमाहात्म्यं संदर्शयितुमीश्वरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003684018, "chapter_id": 23684, "verse_number": "१-३-५-१९", "content_sanskrit": "कैलासशैलवृत्तांतः कंपातटतपःस्थितः ।\nअरुणाद्रिसमादेशः सर्वं ज्ञातमिदं मया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003684019, "chapter_id": 23684, "verse_number": "१-३-५-२०", "content_sanskrit": "आगतासि महाभागे भक्ताश्रममिमं स्वयम् ।\nस्नेहेन करुणामूर्ते कर्त्तव्यमुपदिश्यताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003684020, "chapter_id": 23684, "verse_number": "१-३-५-२१", "content_sanskrit": "इति तस्य वचः श्रुत्वा महर्षेः सर्ववेदिनः ।\nअंबिका प्राह कुतुकात्स्तुवन्ती तं महामुनिम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003684021, "chapter_id": 23684, "verse_number": "१-३-५-२२", "content_sanskrit": "महावैभवमेतत्ते देवदेवः स्वयं शिवः ।\nमध्ये तपस्विनां त्वं तु द्रष्टव्य इति चादिशत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003684022, "chapter_id": 23684, "verse_number": "१-३-५-२३", "content_sanskrit": "आगमानां शिवोक्तानां वेदानामपि पारगः ।\nतपसा शंभुभक्तानां त्वमेव शिवसंमतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003684023, "chapter_id": 23684, "verse_number": "१-३-५-२४", "content_sanskrit": "अरुणाचल नाम्नाहं तिष्ठामीत्यब्रवीच्छिवः॥  ।\nअस्याचलस्य माहात्म्यं श्रोतव्यं च भवन्मुखात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003684024, "chapter_id": 23684, "verse_number": "१-३-५-२५", "content_sanskrit": "प्राप्तास्म्यहं तपः कर्तुमरुणाचलसन्निधौ ।\nभवतां दर्शनादेव स्वयमीशः प्रसीदति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003684025, "chapter_id": 23684, "verse_number": "१-३-५-२६", "content_sanskrit": "शिवभक्तेन संभाषा शिवसंकीर्त्तनश्रवः ।\nशिवलिंगार्चनं लोके वपुर्ग्रहफलोदयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003684026, "chapter_id": 23684, "verse_number": "१-३-५-२७", "content_sanskrit": "तस्मान्ममैतन्माहात्म्यं श्रोतव्यं भवतो मुखात् ।\nसुव्यक्तमुपदेशेन ज्ञानतोऽसि पिता मम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003684027, "chapter_id": 23684, "verse_number": "१-३-५-२८", "content_sanskrit": "इति तस्या वचः श्रुत्वा गौतमस्तपसां निधिः ।\nआचख्यौ गिरिशं ध्यायन्नरुणाचलवैभवम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003684028, "chapter_id": 23684, "verse_number": "१-३-५-२९", "content_sanskrit": "अज्ञातमिव यत्किंचित्पृच्छ्यते च पुनस्त्वया ।\nअवैमि सर्वविद्यानां माया शैवी त्वमेव सा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003684029, "chapter_id": 23684, "verse_number": "१-३-५-३०", "content_sanskrit": "अथवा भक्तवक्त्रेण शिववैभवसंश्रवः ।\nशिक्षणं शांभवं तेषां तव तुष्टेश्च कारणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003684030, "chapter_id": 23684, "verse_number": "१-३-५-३१", "content_sanskrit": "पठितानां च वेदानां यदावृत्तफलावहम् ।\nवदतां शृण्वतां लोके शिवसंकीर्त्तनं तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003684031, "chapter_id": 23684, "verse_number": "१-३-५-३२", "content_sanskrit": "सफलान्यद्य सर्वाणि तपांसि चरितानि मे ।\nयदहं शंभुनादिष्टं माहात्म्यं कीर्त्तये श्रुतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003684032, "chapter_id": 23684, "verse_number": "१-३-५-३३", "content_sanskrit": "शिवाशिवप्रसादेन माहात्म्यमिदमद्भुतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003684033, "chapter_id": 23684, "verse_number": "१-३-५-३४", "content_sanskrit": "अरुणाचलमाहात्म्यं दुरितक्षयकारणम् ।\nश्रूयतामनवद्यांगि पुरावृत्तमिदं महत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003684034, "chapter_id": 23684, "verse_number": "१-३-५-३५", "content_sanskrit": "अरुणाद्रिमयं लिंगमाविर्भूतं यथा पुरा ।\nन शक्यते पुनर्वक्तुमशेषं वक्त्रकोटिभिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003684035, "chapter_id": 23684, "verse_number": "१-३-५-३६", "content_sanskrit": "अरुणाचलमाहात्म्यं ब्रह्मणामपि कोटिभिः ।\nब्रह्मणा विष्णुना पूर्वं सोमभास्करवह्निभिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003684036, "chapter_id": 23684, "verse_number": "१-३-५-३७", "content_sanskrit": "इन्द्रादिभिश्च दिक्पालैः पूजितश्चाष्टसिद्धये ।\nसिद्धचारणगंधर्व यक्षविद्याधरोरगैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003684037, "chapter_id": 23684, "verse_number": "१-३-५-३८", "content_sanskrit": "खगैश्च मुनिभिर्दिव्यैः सिद्धयोगिभिरर्चितः ।\nतत्तत्पापनिवृत्त्यर्थं तत्तदीप्सितसिद्धये ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003684038, "chapter_id": 23684, "verse_number": "१-३-५-३९", "content_sanskrit": "आराधितोऽयं भगवानरुणाद्रिपतिः शिवः ।\nदृष्टो हरति पापानि सेवितो वांछितप्रदः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003684039, "chapter_id": 23684, "verse_number": "१-३-५-४०", "content_sanskrit": "कीर्तितोपि जनैर्दूरैः शोणाद्रिरिति मुक्तिदः ।\nतेजःस्तंभमयं रूपमरुणाद्रिरिति श्रुतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003684040, "chapter_id": 23684, "verse_number": "१-३-५-४१", "content_sanskrit": "ध्यायन्तो योगिनश्चित्ते शिवसायुज्यमाप्नुयुः ।\nदत्तं हुतं च यत्किंचिज्जप्तं चान्यत्तपः कृतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003684041, "chapter_id": 23684, "verse_number": "१-३-५-४२", "content_sanskrit": "अक्षय्यं भवति प्राप्तमरुणाचलसंनिधौ ।\nपुरा ब्रह्मा च विष्णुश्च शिवतेजोंशसंभवौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003684042, "chapter_id": 23684, "verse_number": "१-३-५-४३", "content_sanskrit": "साहंकारौ युयुधतुः परस्परजिगीषया ।\nतथा तयोर्गर्वशांत्यै योगिध्येयः सदाशिवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003684043, "chapter_id": 23684, "verse_number": "१-३-५-४४", "content_sanskrit": "अग्नितेजोमयं रूपमादिमध्यांतवर्जितम् ।\nसंप्राप्य तस्थौ तन्मध्ये दिशो दश विभासयन् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003684044, "chapter_id": 23684, "verse_number": "१-३-५-४५", "content_sanskrit": "तेजःस्तंभस्य तस्याथ द्रष्टुमाद्यंतभागयोः ।\nहंसक्रोडतनू कृत्वा जग्मतुर्द्यां रसातलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003684045, "chapter_id": 23684, "verse_number": "१-३-५-४६", "content_sanskrit": "तौ विषण्णमुखौ दृष्ट्वा भगवान्करुणानिधिः ।\nआविर्बभूव च तयोर्वरं प्रादादभीप्सितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003684046, "chapter_id": 23684, "verse_number": "१-३-५-४७", "content_sanskrit": "तत्प्रार्थितश्च देवेशो यातः स्थावरलिंगताम् ।\nअरुणाद्रिरिति ख्यातः प्रशांतः संप्रकाशते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003684047, "chapter_id": 23684, "verse_number": "१-३-५-४८", "content_sanskrit": "दिव्यदुन्दुभिनिर्घोषैरप्सरोगीतनर्त्तनैः ।\nपूज्यते तैजसं लिंगं पुष्पवृष्टिशतैः सदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003684048, "chapter_id": 23684, "verse_number": "१-३-५-४९", "content_sanskrit": "ब्रह्मणामप्यतीतानां पुरा षण्णवतेः प्रभुः ।\nविष्णुनाभिसमुद्भूतो ब्रह्मा लोकान्ससर्ज हि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003684049, "chapter_id": 23684, "verse_number": "१-३-५-५०", "content_sanskrit": "स कदाचित्तपोविघ्नं कर्तुकामेन योगिनाम् ।\nइंद्रेण प्रार्थितो ब्रह्मा ससर्ज ललितां स्त्रियम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003684050, "chapter_id": 23684, "verse_number": "१-३-५-५१", "content_sanskrit": "लावण्यगुणसंपूर्णामालोक्य कमलेक्षणाम् ।\nमुमोह कंदर्पशरैः स विद्धहृदयो विधिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003684051, "chapter_id": 23684, "verse_number": "१-३-५-५२", "content_sanskrit": "स्प्रष्टुकामं तमालोक्य ब्रह्माणं कमलासनम् ।\nनत्वा प्रदक्षिणव्याजाद्गंतुमैच्छद्वराप्सराः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003684052, "chapter_id": 23684, "verse_number": "१-३-५-५३", "content_sanskrit": "अस्यां प्रदक्षिणां भक्त्या कुर्वाणायां प्रजापतेः ।\nचतसृभ्योऽपि दिग्भ्योऽस्य मुखान्युदभवन्क्षणात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003684053, "chapter_id": 23684, "verse_number": "१-३-५-५४", "content_sanskrit": "सा बाला पक्षिणी भूत्वा गगनं समगाहत ।\nपुनश्च खगरूपेण समायांतं समीक्ष्य सा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003684054, "chapter_id": 23684, "verse_number": "१-३-५-५५", "content_sanskrit": "शरणं याचमाना सा शोणाद्रिमिममाश्रयत् ।\nब्रह्मणा विष्णुना च त्वमदृष्टपदशेखरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003684055, "chapter_id": 23684, "verse_number": "१-३-५-५६", "content_sanskrit": "रक्ष मामरुणाद्रीश शरण्य शरणागताम् ।\nइति तस्यां भयार्त्तायां क्रोशंत्यामरुणाचलात् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003684056, "chapter_id": 23684, "verse_number": "१-३-५-५७", "content_sanskrit": "उदभूत्स्थावराल्लिंगाद्व्याधः कश्चिद्धनुर्द्धरः ।\nसंधाय सायकं चापे समेघगगनद्युतिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003684057, "chapter_id": 23684, "verse_number": "१-३-५-५८", "content_sanskrit": "निषादे पुरतो दृष्टे मोहस्तस्य ननाश हि ।\nततः प्रसन्नहृदयोतिनम्रः कमलोद्भवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003684058, "chapter_id": 23684, "verse_number": "१-३-५-५९", "content_sanskrit": "नमश्चक्रे शरण्याय शोणाद्रिपतये तदा ।\nसर्वपापक्षयकृते नमस्तुभ्यं पिनाकिने ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003684059, "chapter_id": 23684, "verse_number": "१-३-५-६०", "content_sanskrit": "अरुणाचलरूपाय भक्ववश्याय शंभवे ।\nअजानतां स्वभक्तानामकर्मविनिवर्त्तने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003684060, "chapter_id": 23684, "verse_number": "१-३-५-६१", "content_sanskrit": "त्वदन्यः कः प्रभुः कर्तुमशक्यं चापि देहिनाम् ।\nउपसंहर मे देहं तेजसा पापनिश्चयम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003684061, "chapter_id": 23684, "verse_number": "१-३-५-६२", "content_sanskrit": "अन्यं वा सृज विश्वात्मन्ब्रह्माणं लोकसृष्टये ।\nअथ तस्य वचः श्रुत्वा शिवो दीनस्य वेधसः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003684062, "chapter_id": 23684, "verse_number": "१-३-५-६३", "content_sanskrit": "उवाच करुणामूर्तिर्भूत्वा चंद्रार्द्धशेखरः ।\nदत्तः कालस्तव मया पुरैव न निवर्त्यते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003684063, "chapter_id": 23684, "verse_number": "१-३-५-६४", "content_sanskrit": "कं वा रागादयो दोषा न बाधेरन्प्रभुस्थितम् ।\nतस्माद्दूरस्थितोऽप्येतदरुणाचलसंज्ञितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003684064, "chapter_id": 23684, "verse_number": "१-३-५-६५", "content_sanskrit": "भजस्व तैजसं लिंगं सर्वदोषनिवृत्तये ।\nवाचिकं मानसं पापं कायिकं वा च यद्भवेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003684065, "chapter_id": 23684, "verse_number": "१-३-५-६६", "content_sanskrit": "विनश्यति क्षणात्सर्वमरुणाचलदर्शनात् ।\nप्रदक्षिणा नमस्कारैः स्मरणैरर्चनैः स्तवैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003684066, "chapter_id": 23684, "verse_number": "१-३-५-६७", "content_sanskrit": "अरुणाद्रिरयं नृणां सर्वकल्मषनाशनः ।\nकैलासे मेरुशृंगे वा स्वस्थानेषु कलाद्रिषु ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003684067, "chapter_id": 23684, "verse_number": "१-३-५-६८", "content_sanskrit": "संदृश्यः कश्चिदेवाहमरुणाद्रिरयं स्वयम् ।\nयच्छृंगदर्शनान्नॄणां चक्षुर्लाभेन केवलम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003684068, "chapter_id": 23684, "verse_number": "१-३-५-६९", "content_sanskrit": "भवेत्सर्वाघनाशश्च लाभश्च ज्ञानचक्षुषः ।\nमदंशसंभवो ब्रह्मा स्वनाम्ना ब्रह्मपुष्करे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003684069, "chapter_id": 23684, "verse_number": "१-३-५-७०", "content_sanskrit": "अत्र स्नातः पुरा ब्रह्मन्मोहोऽगाज्जगतीपतेः ।\nस्नात्वा त्वं ब्रह्मतीर्थे मां समभ्यर्च्य कृतांजलिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003684070, "chapter_id": 23684, "verse_number": "१-३-५-७१", "content_sanskrit": "मौनी प्रदक्षिणं कृत्वा विश्वात्मन्भव विज्वरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003684071, "chapter_id": 23684, "verse_number": "१-३-५-७२", "content_sanskrit": "इति वचनमुदीर्य विश्वनाथं स्थितमरुणाचलरूपतो महेशम् ।\nअथ सरसि निमज्य पद्मजन्मा दुरितहरं समपूजयत्क्रमेण ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003684072, "chapter_id": 23684, "verse_number": "१-३-५-७३", "content_sanskrit": "इममरुणगिरीशमेष वेधा यमनियमादिविशुद्धचित्तयोगः ।\nस्फुटतरमभिपूज्य सोपचारं गतदुरितोऽथ जगाम चाधिपत्यम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003684073, "chapter_id": 23684, "verse_number": "१-३-५-७४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धे ब्रह्मपुष्करमाहात्म्यवर्णनंनाम पञ्चमोऽध्यायः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]