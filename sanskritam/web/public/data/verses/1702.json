[{"id": 2032449, "chapter_id": 1702, "verse_number": "४-२५-०x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032450, "chapter_id": 1702, "verse_number": "४-२५-१", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु भाषसे।\nअद्यैनं सूदयिष्यामि कीचकं सह बान्धवैः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032451, "chapter_id": 1702, "verse_number": "४-२५-२", "content_sanskrit": "अस्याः प्रदोषे शर्वर्याः कुरुष्वानेन संविदम् ।\nदुःखं शोकं च निर्धूय याज्ञसेनि शुचिस्मिते ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032452, "chapter_id": 1702, "verse_number": "४-२५-३", "content_sanskrit": "यैषा नर्तनशालेह मत्स्यराजेन कारिता।\nदिवात्र कन्या नृत्यन्ति रात्रौ यान्ति तथा गृहं ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032453, "chapter_id": 1702, "verse_number": "४-२५-४", "content_sanskrit": "तत्रास्ति शयनं भीरु दृढाङ्गं सुप्रतिष्ठितम्।\nतत्रैनं दर्शयिष्यामि पूर्वप्रेतान्पितामहान् ।\nत्वद्दर्शनसमुत्थेन कामेनाकुलितेन्द्रियम् ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032454, "chapter_id": 1702, "verse_number": "४-२५-५", "content_sanskrit": "संकेतं सूतपुत्रस्य कारयस्व शुभानने।\nयथा परे न पश्येयुः कुर्वन्तीं तेन संविदम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032455, "chapter_id": 1702, "verse_number": "४-२५-६", "content_sanskrit": "तथा कुरुष्व कल्याणि यथा सन्निहितो भवेत्।\nतथा कुर्याश्च संकेतं सूतपुत्रस्य संवृतम् ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032456, "chapter_id": 1702, "verse_number": "४-२५-७", "content_sanskrit": "आवयोः संगमं भीरु यथा मार्त्यो न बुध्यति ।\nकीचकस्य विनाशाय तथा कुरु नृपात्मजे ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032457, "chapter_id": 1702, "verse_number": "४-२५-८x", "content_sanskrit": "वैशम्पायन उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032458, "chapter_id": 1702, "verse_number": "४-२५-८", "content_sanskrit": "तत्र तौ कथयित्वा तु बाष्पमुत्सृज्य दुःखितौ।\nरात्रिशेषं तमत्युग्रं धारयामासतुर्हृदि ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032459, "chapter_id": 1702, "verse_number": "४-२५-९", "content_sanskrit": "भीमेन च प्रतिज्ञाते कीचकस्य वधे तदा।\nद्रौपदी च सुदेष्णायाः प्रविवेश पुनर्गृहम् ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032460, "chapter_id": 1702, "verse_number": "४-२५-१०", "content_sanskrit": "तस्यां रजन्यां व्युष्टायां प्रातरुत्थाय कीचकः।\nगत्वा राजकुलायैव द्रौपदीमिदमब्रवीत् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032461, "chapter_id": 1702, "verse_number": "४-२५-११", "content_sanskrit": "यत्त्वाऽहं पश्यतो राज्ञः पातयित्वा पदाऽहनम् ।\nन कंचिल्लभसे नाथमभिपन्ना बलीयसा ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032462, "chapter_id": 1702, "verse_number": "४-२५-१२", "content_sanskrit": "प्रवादेन तु मात्स्यानामयं राजेति चोच्यते।\nअहमेव हि राजा वै मात्स्यानां वाहिनीपतिः ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032463, "chapter_id": 1702, "verse_number": "४-२५-१३", "content_sanskrit": "सा सुखं प्रतिपद्यस्व दासो भीरु भवामि ते।\nन ह्यहं त्वामृते भीरु चिरं जीवितुमुत्सहे ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032464, "chapter_id": 1702, "verse_number": "४-२५-१४", "content_sanskrit": "अहन्यहनि सुश्रोणि शतनिष्कं ददामि ते।\nदासीशतं च ते दद्यां दासानामपि चापरम् ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032465, "chapter_id": 1702, "verse_number": "४-२५-१५", "content_sanskrit": "रथांश्चाश्वतरीयुक्तानस्तु नौ भीरु संगमः ।\nसुदासानां सहस्रं च महिषाणां सहस्रकम् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032466, "chapter_id": 1702, "verse_number": "४-२५-१६", "content_sanskrit": "अन्तःपुरसहस्रं च हेमकूटसहस्रकम्।\nतुभ्यं दास्यामि सर्वाणि राजार्हाण्यम्बराणि च ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032467, "chapter_id": 1702, "verse_number": "४-२५-१७x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032468, "chapter_id": 1702, "verse_number": "४-२५-१७", "content_sanskrit": "एतन्मे वचनं सत्यं प्रतिपद्यस्व कीचक।\nन ते सखा वा भ्राता वा जानीयात्संगमं मया ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032469, "chapter_id": 1702, "verse_number": "४-२५-१८", "content_sanskrit": "अनुप्रवादाद्भीताऽस्मि गन्धर्वाणां यशस्विनाम् ।\nअनुबोधाद्गनर्थः स्यादयशश्च महद्भवेत।\nएतन्मे प्रतिजानीहि ततोऽहं वशगा तव ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032470, "chapter_id": 1702, "verse_number": "४-२५-१९x", "content_sanskrit": "कीचक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032471, "chapter_id": 1702, "verse_number": "४-२५-१९", "content_sanskrit": "एवमेतत्करिष्यामि यथा सुश्रोणि भाषसे।\nएकोऽहमागमिष्यामि शून्यमावसथं तव ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032472, "chapter_id": 1702, "verse_number": "४-२५-२०", "content_sanskrit": "समागमार्थं रम्भोरु त्वया मदनदर्पितः।\nयथा त्वां नैव पश्येयुर्गन्धर्वाः सूर्यवर्चसः ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032473, "chapter_id": 1702, "verse_number": "४-२५-२१x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032474, "chapter_id": 1702, "verse_number": "४-२५-२१", "content_sanskrit": "यदेतन्नर्तनागारं मात्स्यराजेन कारितम्।\nदिवात्र कन्या नृत्यन्ति रात्रौ यान्ति स्वकं गृहं ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032475, "chapter_id": 1702, "verse_number": "४-२५-२२", "content_sanskrit": "निशायां तत्र गच्छेथा गन्धर्वास्तन्न जानते।\nतत्र दोषः परिहृतो भविष्यति न संशयः ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032476, "chapter_id": 1702, "verse_number": "४-२५-२३", "content_sanskrit": "एकस्त्वं नर्तनागारं रात्रौ संकेतमाव्रज ।\nतत्राहं भविता तुभ्यं वशगा नात्र संशयः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032477, "chapter_id": 1702, "verse_number": "४-२५-२४x", "content_sanskrit": "कीचक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032478, "chapter_id": 1702, "verse_number": "४-२५-२४", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु वक्ष्यसि।\nएकः सन्नर्तनागारमागमिष्यामि भामिनि।\nसमागमार्थं सुश्रोणि शपे च सुकृतेन मे ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032479, "chapter_id": 1702, "verse_number": "४-२५-२५", "content_sanskrit": "यथा त्वां नावबुध्यन्ति गन्धर्वा वरवर्णिनि।\nसत्यं ते प्रतिजानामि गन्धर्वेभ्यो न ते भयम्।\nअलंकरिष्याम्यद्याहं त्वत्समागमनाय वै ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032480, "chapter_id": 1702, "verse_number": "४-२५-२६", "content_sanskrit": "वासांसि च विचित्राणि मनोज्ञानि तवापि च।\nयथा मां न त्यजेथास्त्वं तथ रंस्ये त्वया सह ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032481, "chapter_id": 1702, "verse_number": "४-२५-२७x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032482, "chapter_id": 1702, "verse_number": "४-२५-२७", "content_sanskrit": "तथा चेदप्यहं सूत दर्शयिष्यामि ते सुखम्।\nयन्नानुभूतं भवता जन्मप्रभृति कीचक ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032483, "chapter_id": 1702, "verse_number": "४-२५-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032484, "chapter_id": 1702, "verse_number": "४-२५-२८", "content_sanskrit": "तमर्थमपि जल्पन्त्या द्रौपद्याः कीचकस्य ह।\nक्षणमात्रं तदभवन्मासेनैव समं नृप ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032485, "chapter_id": 1702, "verse_number": "४-२५-२९", "content_sanskrit": "कीचकोऽथ गृहं गत्वा भृशं हर्षपरिप्लुतः।\nसैरन्ध्रीरूपिणीं मूढो मृत्युं तां नावबुद्धवान् ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032486, "chapter_id": 1702, "verse_number": "४-२५-३०", "content_sanskrit": "गन्धाभरणमाल्येषु व्यासक्तः स विशेषतः।\nअलंचक्रे तदाऽऽत्मानं सत्वरः काममोहितः ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032487, "chapter_id": 1702, "verse_number": "४-२५-३१", "content_sanskrit": "तस्य तत्कुर्वतः कर्म कालो दीर्घ इवाभवत्।\nअनुचिन्तयतश्चापि तामेवायतलोचनाम् ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032488, "chapter_id": 1702, "verse_number": "४-२५-३२", "content_sanskrit": "आसीदभ्यधिका चापि श्रीः श्रियं प्रमुमुक्षतः ।\nनिर्वाणकाले दीपस्य वर्तीमिव दिधक्षतः ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032489, "chapter_id": 1702, "verse_number": "४-२५-३३", "content_sanskrit": "कृतसंप्रत्ययस्तस्याः कीचकः काममोहितः।\nनाजानात्पतनं स्वस्य चिन्तयंस्तां शुभाननाम् ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2032490, "chapter_id": 1702, "verse_number": "४-२५-३४", "content_sanskrit": "ततस्तु द्रौपदी गत्वा भीमसेनं महानसे।\nउपातिष्ठत कल्याणी कौरव्यं पतिमन्तिकात् ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2032491, "chapter_id": 1702, "verse_number": "४-२५-३५", "content_sanskrit": "तमुवाच सुकेशान्ता कीचकस्य कृतो मया।\nसङ्गमो नर्तनागारे यथाऽवोचः परन्तप ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2032492, "chapter_id": 1702, "verse_number": "४-२५-३६", "content_sanskrit": "कालेन नियतं बद्धः कामेन च बलात्कृतः।\nशून्यं स नर्तनागारमागमिष्यति कीचकः।\nएको निशि महाबाहो कीचकं तं निषूदय ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2032493, "chapter_id": 1702, "verse_number": "४-२५-३७", "content_sanskrit": "तं मूतपुत्रं कौन्तेय कीचकं मददर्पितम्।\nगत्वा त्वं नर्तनागारं निर्जीवं कुरु पाण्डव ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2032494, "chapter_id": 1702, "verse_number": "४-२५-३८", "content_sanskrit": "गर्वितः मूतपुत्रोऽसौ गन्धर्वानवमन्यते।\nस त्वं प्रहरतांश्रेष्ठ नालं नाग इवोद्धर ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2032495, "chapter_id": 1702, "verse_number": "४-२५-३९", "content_sanskrit": "अस्रं दुःखाभिभूताया मम मार्जस्व भारत।\nबाहुवीर्यानुरूपं च दर्शयाद्य पराक्रमम्।\nआत्मनश्चैव भद्रं ते कुरु मानं कुलस्य च ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2032496, "chapter_id": 1702, "verse_number": "४-२५-४०x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2032497, "chapter_id": 1702, "verse_number": "४-२५-४०", "content_sanskrit": "स्वागतं ते वरारोहे यन्मां वेदयसे प्रियम्।\nनह्यस्य कंचिदिच्छामि सहायं वरवर्णिनि ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2032498, "chapter_id": 1702, "verse_number": "४-२५-४१", "content_sanskrit": "सा मे प्रीतिस्त्वयाऽऽख्याता कीचकस्य समागमे।\nहत्वा हिडिम्बं या प्रीतिर्ममासीत्सा शुचिस्मिते ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2032499, "chapter_id": 1702, "verse_number": "४-२५-४२", "content_sanskrit": "सत्यं भ्रातॄंश्च पुत्रांश्च पुरस्कृत्य शपामि ते।\nकीचकं निहनिष्यामि वृत्रं देवपतिर्यथा ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2032500, "chapter_id": 1702, "verse_number": "४-२५-४३", "content_sanskrit": "प्रसह्य निहनिष्यामि केशवः केशिनं यथा।\nरहस्यं वा प्रकाशं वा सूदयिष्यामि कीचकम् ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2032501, "chapter_id": 1702, "verse_number": "४-२५-४४", "content_sanskrit": "अहं भद्रे हनिष्यामि कीचकं मदनान्वितम्।\nयस्त्वां कामाभिभूतात्मा दुर्लभामभिमन्यते ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2032502, "chapter_id": 1702, "verse_number": "४-२५-४५", "content_sanskrit": "अथ चेदवबुध्यन्ति सूतपुत्रं मया हतम्।\nनिर्मनुष्यं करिष्यामि मत्स्यानामिदमालयम् ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2032503, "chapter_id": 1702, "verse_number": "४-२५-४६", "content_sanskrit": "मया हतांश्चेन्मात्स्यांस्तु धार्तराष्ट्रो विबुध्यति।\nदुर्योधनं ततो हत्वा सानुबन्धं सबान्धवम्।\nकुरुणामखिलं राज्यं प्रतिपत्स्यामि भामिनि ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2032504, "chapter_id": 1702, "verse_number": "४-२५-४७", "content_sanskrit": "नाहं शक्तोऽनुनयितुं कुन्तीपुत्रं युधिष्ठिरम्।\nकामं सत्यमुपासीत कुन्तीपुत्रो युधिष्ठिरः ।\nकाममन्ये ह्युपासन्तु विनीता धर्मचारिणः ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2032505, "chapter_id": 1702, "verse_number": "४-२५-४८", "content_sanskrit": "त्वां तु दुःखमिदं प्राप्तां नाहं शक्नोम्युपेक्षितुम्।\nनिर्वृता भव पाञ्चालि कीचकस्य वधात्पुनः ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2032506, "chapter_id": 1702, "verse_number": "४-२५-४९x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2032507, "chapter_id": 1702, "verse_number": "४-२५-४९", "content_sanskrit": "कीचकस्य वधं भीम यदि जानन्ति नागराः।\nत्वया कृतं महाबाहो नाहं जीवितुमुत्सहे ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2032508, "chapter_id": 1702, "verse_number": "४-२५-५०", "content_sanskrit": "कथं सत्याच्च नापेयाद्राजाऽयं मत्कृते प्रभो।\nनिशि गूढं तथा भीम कीचकं तं निपातय ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2032509, "chapter_id": 1702, "verse_number": "४-२५-५१", "content_sanskrit": "अनुबुद्धे हि कौन्तेयो धर्मराजो युधिष्ठिरः।\nपुनर्वनं व्रजेद्धीमाननुजैः परिवारितः ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2032510, "chapter_id": 1702, "verse_number": "४-२५-५२", "content_sanskrit": "कश्च धर्मपरं ज्येष्ठमतिवर्तेत भारत।\nभीम भीताऽस्मि संबोधात्साधु मा चापलं कृथाः ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2032511, "chapter_id": 1702, "verse_number": "४-२५-५३", "content_sanskrit": "यथा न कश्चिञ्जानीते सूतपुत्रं त्वया हतम्।\nतथा कुरुष्व कौरव्य बलवन्नरिमर्दन ।\nअदृश्यमानस्त्वंतस्य भिन्धि प्राणानरिन्दम ॥ ५३ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2032512, "chapter_id": 1702, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि पञ्चविंशोऽध्यायः ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]