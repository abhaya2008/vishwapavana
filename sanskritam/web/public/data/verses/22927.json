[{"id": 7002927000, "chapter_id": 22927, "verse_number": "१-४-१", "content_sanskrit": "सौतिरुवाच ।\nआविर्बभूव तत्पश्चात्कृष्णस्य रसनाग्रतः ।\nशुद्धस्फटिकसंकाशा देवी चैका मनोहरा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002927001, "chapter_id": 22927, "verse_number": "१-४-२", "content_sanskrit": "शुक्लवस्त्रपरीधाना सर्वालङ्कारभूषिता ।\nबिभ्रती जपमालां च सा सावित्री प्रकीर्तिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002927002, "chapter_id": 22927, "verse_number": "१-४-३", "content_sanskrit": "सा तुष्टाव पुरः स्थित्वा परं ब्रह्म सनातनम् ।\nपुटांजलिपरा साध्वी भक्तिनम्रात्मकन्धरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002927003, "chapter_id": 22927, "verse_number": "१-४-४", "content_sanskrit": "सावित्र्युवाच ।\nनमामि सर्वबीजं त्वां ब्रह्मज्योतिः सनातनम् ।\nपरात्परतरं श्यामं निर्विकारं निरञ्जनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002927004, "chapter_id": 22927, "verse_number": "१-४-५", "content_sanskrit": "इत्युक्त्वा सस्मिता देवी रत्नसिंहासने वरे ।\nउवास श्रीहरिं नत्वा पुनरेव श्रुतिप्रसूः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002927005, "chapter_id": 22927, "verse_number": "१-४-६", "content_sanskrit": "आविर्बभूव तत्पश्चात्कृष्णस्य परमात्मनः ।\nमानसाच्च पुमानेकस्तप्तकांचनसन्निभः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002927006, "chapter_id": 22927, "verse_number": "१-४-७", "content_sanskrit": "मनो मथ्नाति सर्वेषां पञ्चबाणेन कामिनाम् ।\nतन्नाम मन्मथं तेन प्रवदन्ति मनीषिणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002927007, "chapter_id": 22927, "verse_number": "१-४-८", "content_sanskrit": "तस्य पुंसो वामपार्श्वात्कामस्य कामिनी वरा ।\nबभूवातीव ललिता सर्वेषां मोहकारिणी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002927008, "chapter_id": 22927, "verse_number": "१-४-९", "content_sanskrit": "रतिर्बभूव सर्वेषां तां दृष्ट्वा सस्मितां सतीम् ।\nरतीति तेन तन्नाम प्रवदंति मनीषिणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002927009, "chapter_id": 22927, "verse_number": "१-४-१०", "content_sanskrit": "हरिं स्तुत्वा तया सार्द्धं स उवास हरेः पुरः ।\nरत्नसिंहासने चास्य पञ्चबाणो धनुर्द्धरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002927010, "chapter_id": 22927, "verse_number": "१-४-११", "content_sanskrit": "मारणं स्तम्भनं चैव जृम्भणं शोषणं तथा ।\nउन्मादनं पञ्चबाणन्पञ्चबाणो बिभर्ति सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002927011, "chapter_id": 22927, "verse_number": "१-४-१२", "content_sanskrit": "बाणांश्चिक्षेप सर्वांश्च कामो बाणपरीक्षया ।\nसद्यः सर्वे सकामाश्च बभूवुरीश्वरेच्छया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002927012, "chapter_id": 22927, "verse_number": "१-४-१३", "content_sanskrit": "रतिं दृष्ट्वा ब्रह्मणश्च रेतः पातो वभूव ह ।\nतत्र तस्थौ महायोगी वस्त्रेणाच्छाद्य लज्जया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002927013, "chapter_id": 22927, "verse_number": "१-४-१४", "content_sanskrit": "वस्त्रं दग्ध्वा समुत्तस्थौ ज्वलदग्निः सुरेश्वरः ।\nकोटितालप्रमाणश्च सशिखश्च समुज्ज्वलन् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002927014, "chapter_id": 22927, "verse_number": "१-४-१५", "content_sanskrit": "कृष्णस्तद्वर्द्धनं दृष्ट्वा ससर्जापः स्वलीलया ।\nनिःश्वासवायुना सार्द्धं मुखबिन्दुं समुद्गिरन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002927015, "chapter_id": 22927, "verse_number": "१-४-१६", "content_sanskrit": "विश्वौघं प्लावयामास मुखबिंदुजलं द्विज ।\nतत्र किञ्चिज्जलकणं वह्निं शान्तं चकार ह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002927016, "chapter_id": 22927, "verse_number": "१-४-१७", "content_sanskrit": "ततःप्रभृति तेनाग्निस्तोयान्निर्वाणतां व्रजेत् ।\nआविर्भूतः पुमानेकस्ततस्तदधिदेवता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002927017, "chapter_id": 22927, "verse_number": "१-४-१८", "content_sanskrit": "उत्तस्थौ तज्जलादेकः पुमान्स वरुणः स्मृतः ।\nजलाधिष्ठातृदेवोऽसौ सर्वेषां यादसाम्पतिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002927018, "chapter_id": 22927, "verse_number": "१-४-१९", "content_sanskrit": "आविर्बभूव कन्यैका तद्वह्नेर्वामपार्श्वतः ।\nसा स्वाहा वह्निपत्नी तां प्रवदन्ति मनीषिणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002927019, "chapter_id": 22927, "verse_number": "१-४-२०", "content_sanskrit": "जलेशस्य वामपार्श्वात्कन्या चैका बभूव सा ।\nवरुणानीति विख्याता वरुणस्य प्रिया सती ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002927020, "chapter_id": 22927, "verse_number": "१-४-२१", "content_sanskrit": "बभूव पवनः श्रीमान्विभोर्निश्वासवायुतः ।\nस च प्राणाश्च सर्वेषां निःश्वासस्तत्फलोद्भवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002927021, "chapter_id": 22927, "verse_number": "१-४-२२", "content_sanskrit": "तस्य वायोर्वामपार्श्वात्कन्या चैका बभूव ह ।\nवायोः पत्नी सा च देवी वायवी परिकीर्तिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002927022, "chapter_id": 22927, "verse_number": "१-४-२३", "content_sanskrit": "कृष्णस्य कामबाणेन रेतःपातो बभूव ह ।\nजले तद्रेचनं चक्रे लज्जया सुर संसदि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002927023, "chapter_id": 22927, "verse_number": "१-४-२४", "content_sanskrit": "सहस्रवत्सरान्ते तड्डिम्भरूपं बभूव ह ।\nततो महान्विराड् जज्ञे विश्वौघाधार एव सः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002927024, "chapter_id": 22927, "verse_number": "१-४-२५", "content_sanskrit": "यस्यैक लोमविवरे विश्वैकस्य व्यवस्थितिः ।\nस्थूलात्स्थूलतरः सोऽपि महान्नान्यस्ततः परः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002927025, "chapter_id": 22927, "verse_number": "१-४-२६", "content_sanskrit": "स एव षोडशांशोऽपि कृष्णस्य परमात्मनः ।\nमहाविष्णुः स विज्ञेयः सर्वाधारः सनातनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002927026, "chapter_id": 22927, "verse_number": "१-४-२७", "content_sanskrit": "महार्णवे शयानः स पद्मपत्रं यथा जले ।\nबभूवतुस्तौ द्वौ दैत्यौ तस्य कर्णमलोद्भवौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002927027, "chapter_id": 22927, "verse_number": "१-४-२८", "content_sanskrit": "तौ जलाच्च समुत्थाय ब्रह्माणं हन्तुमुद्यतौ ।\nनारायणश्च भगवाञ्जघने तौ जघान ह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002927028, "chapter_id": 22927, "verse_number": "१-४-२९", "content_sanskrit": "बभूव मेदिनी कृत्स्ना कार्त्स्न्येन मेदसा तया ।\nतत्रैव सन्ति विश्वानि सा च देवी वसुन्धरा ॥२९॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]