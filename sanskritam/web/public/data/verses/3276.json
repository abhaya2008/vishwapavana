[{"id": 2105495, "chapter_id": 3276, "verse_number": "१६-५-१", "content_sanskrit": "व्यास उवाच।\nयुधिष्ठिर महाबाहो ********** कुरुनन्दनः।\nधृतराष्ट्रो महातेजास्तत्कुरुष्वाविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105496, "chapter_id": 3276, "verse_number": "१६-५-२", "content_sanskrit": "अयं हि वृद्धो नृपतिर्हतपुत्रो विशेषतः।\nनेदं कृच्छ्रं चिरतरं सहेदिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105497, "chapter_id": 3276, "verse_number": "१६-५-३", "content_sanskrit": "गान्धारी च महाभागा प्राज्ञा करुणवेदिनी।\nपुत्रशोकं महाराज धैर्येणोद्वहते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105498, "chapter_id": 3276, "verse_number": "१६-५-४", "content_sanskrit": "अहमप्येतदेव त्वां ब्रवीमि कुरु मे वचः।\nअनुज्ञां लभतां राजा मां वृथेह मरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105499, "chapter_id": 3276, "verse_number": "१६-५-५", "content_sanskrit": "`स्वस्थो भवत्वयं धीमान्वनेषु मधुगन्धिषु।\nराजर्षीणां पुराणानामनुयातु गतिं नृपः। राजर्षीणां हि सर्वेषामन्ते वनमुपाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105500, "chapter_id": 3276, "verse_number": "१६-५-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105501, "chapter_id": 3276, "verse_number": "१६-५-६", "content_sanskrit": "इत्युक्तः स तदा राजा व्यासेनाद्भुतकर्मणा।\nप्रत्युवाच महातेजा धर्मराजो महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105502, "chapter_id": 3276, "verse_number": "१६-५-७", "content_sanskrit": "भगवानेव नो मान्यो भगवानेव नो गुरुः।\nभगवानस्य राज्यस्य कुलस्य च परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105503, "chapter_id": 3276, "verse_number": "१६-५-८", "content_sanskrit": "अहं तु पुत्रो भगवन्पिता राजा गुरुश्च मे।\nनिदेशवती च पितुः पुत्रो भवति धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105504, "chapter_id": 3276, "verse_number": "१६-५-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105505, "chapter_id": 3276, "verse_number": "१६-५-९", "content_sanskrit": "इत्युक्तः स तु तं प्राह व्यासो वेदविदांवरः।\nयुधिष्ठिरं महातेजाः पुनरेव महाकविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105506, "chapter_id": 3276, "verse_number": "१६-५-१०", "content_sanskrit": "एवमेतन्महाभाग यथा वदसिं भारत।\nराजाऽयं वृद्धतां प्राप्तः प्रमाणे परमे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105507, "chapter_id": 3276, "verse_number": "१६-५-११", "content_sanskrit": "सोयं मयाऽभ्यनुज्ञातस्त्वथा च पृथिवीपतिः।\nकरोतु स्वमभिप्रायं मा स्म विघ्नकरो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105508, "chapter_id": 3276, "verse_number": "१६-५-१२", "content_sanskrit": "एष एव परो धर्मो राजर्षीणां युधिष्ठिर।\nसमरे वा भवेन्मृत्युर्वने वा विधिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105509, "chapter_id": 3276, "verse_number": "१६-५-१३", "content_sanskrit": "पित्रा तु तव राजेन्द्र पाण्डुना पृथिवीक्षिता।\nशिष्यभूतेन राजाऽयं गुरुवत्पर्युपासितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105510, "chapter_id": 3276, "verse_number": "१६-५-१४", "content_sanskrit": "क्रतुभिर्दक्षिणावद्भी रत्नपर्वतशोभितैः।\nमहद्भिरिष्टं गौर्भुक्ता प्रजाश्च परिपालिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105511, "chapter_id": 3276, "verse_number": "१६-५-१५", "content_sanskrit": "पुत्रसंस्यं च विपुलं राज्यं विप्रोषिते त्वयि।\nत्रयोदशसमा भुक्तं दत्तं च विविधं वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105512, "chapter_id": 3276, "verse_number": "१६-५-१६", "content_sanskrit": "त्वया चायं नरव्याघ्र गुरुशुश्रूषयाऽनघ।\nआराधितः स भृत्येन गान्धारी च यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105513, "chapter_id": 3276, "verse_number": "१६-५-१७", "content_sanskrit": "अनुजानीहि पितरं समयोऽस्म तपोविधौ।\nन मन्युर्विद्यते चास्य सुसूक्ष्मोऽपि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105514, "chapter_id": 3276, "verse_number": "१६-५-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105515, "chapter_id": 3276, "verse_number": "१६-५-१८", "content_sanskrit": "एतावदुक्त्वा वचनमनुमान्य च पार्थिवम्।\nतथाऽस्त्विति च तेनोक्तः कौतेयेन ययौ वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105516, "chapter_id": 3276, "verse_number": "१६-५-१९", "content_sanskrit": "गते भगवति व्यासे राजा पाण्डुसुतस्तदा।\nप्रोवाच पितरं वृद्धं मन्दंमन्दमिवानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105517, "chapter_id": 3276, "verse_number": "१६-५-२०", "content_sanskrit": "यदाह भगवान्व्यासो यच्चापि भवतो मतम्।\nयथाऽऽह च महेष्वासः कृपो विदुर एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105518, "chapter_id": 3276, "verse_number": "१६-५-२१", "content_sanskrit": "युयुत्सुः संजयश्चैव तत्कर्तास्म्यहमञ्जसा।\nसर्व एव हि मान्या मे कुलस्य हि हितैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105519, "chapter_id": 3276, "verse_number": "१६-५-२२", "content_sanskrit": "इदं तु याचे नृपते त्वामहं शिरसा नतः।\nक्रियतां तावदाहारस्ततो गच्छाश्रमं प्रति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105520, "chapter_id": 3276, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि पञ्चमोऽध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]