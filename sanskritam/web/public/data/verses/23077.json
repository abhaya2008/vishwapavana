[{"id": 7003077000, "chapter_id": 23077, "verse_number": "४-१२-१", "content_sanskrit": "श्रीनारायण उवाच ।\nएकदा मंदिरे नन्दपत्नी साऽऽनंदपूर्वकम् ।\nकृत्वा वक्षसि गोविंदं क्षुधितं च स्तनं ददौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003077001, "chapter_id": 23077, "verse_number": "४-१२-२", "content_sanskrit": "एतस्मिन्नंतरे गोप्य आजग्मुर्नंदमंदिरम् ।\nस्थविराश्च वयस्याश्च बालिका बालकान्विताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003077002, "chapter_id": 23077, "verse_number": "४-१२-३", "content_sanskrit": "अतृप्तं बालकं शीघ्रं संन्यस्य शयने सती ।\nप्रणनाम समुत्थाय कर्मण्यौत्थानिके मुदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003077003, "chapter_id": 23077, "verse_number": "४-१२-४", "content_sanskrit": "तैलसिंदूरतांबूलं ददौ ताभ्यो मुदाऽन्विता।\nमिष्टवस्तूनि वस्त्राणि भूषणानि च गोपिका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003077004, "chapter_id": 23077, "verse_number": "४-१२-५", "content_sanskrit": "एतस्मिन्नन्तरे कृष्णो रुरोद क्षुधितस्तदा ।\nप्रेरयित्वा स चरणं मायेशो मायया विभुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003077005, "chapter_id": 23077, "verse_number": "४-१२-६", "content_sanskrit": "पपात चरणं तस्य प्रवीणे शकटे मुने ।\nविश्वंभरपदाघातात्तच्च चूर्णं बभूव ह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003077006, "chapter_id": 23077, "verse_number": "४-१२-७", "content_sanskrit": "बभंज शकटं पेतुर्भग्नकाष्ठानि तत्र वै ।\nपपात दधि दुग्धं च नवनीतं घृतं मधु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003077007, "chapter_id": 23077, "verse_number": "४-१२-८", "content_sanskrit": "दृष्ट्वाऽऽश्चर्यं गोपिकाश्च दुद्रुवुर्बालकं भयात्। ।\nददृशुर्भग्नशकटमिंधनाभ्यंतरे शिशुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003077008, "chapter_id": 23077, "verse_number": "४-१२-९", "content_sanskrit": "भग्नभांडसमूहं च पतितं बहुगोरसम् ।\nप्रेरयित्वा तु काष्ठानि जग्राह बालकं भिया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003077009, "chapter_id": 23077, "verse_number": "४-१२-१०", "content_sanskrit": "मायारक्षितसर्वांगं रुदितं क्षुधितं क्षुधा।\nस्तनं ददौ यशोदा तं रुरोद च भृशं शुचा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003077010, "chapter_id": 23077, "verse_number": "४-१२-११", "content_sanskrit": "पप्रच्छुर्बालकान्गोपा बभंज शकटं कथम् ।\nकिंचिद्धेतुं न पश्यामः सहसेति किमद्भुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003077011, "chapter_id": 23077, "verse_number": "४-१२-१२", "content_sanskrit": "इत्यूचुर्बालकाः सर्वे गोपाः शृणुत मद्वचः ।\nश्रीकृष्णस्य पदाघाताद्बभंज शकटं ध्रुवम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003077012, "chapter_id": 23077, "verse_number": "४-१२-१३", "content_sanskrit": "श्रुत्वा तद्वचनं गोपा गोप्यश्च जहसुर्मुदा ।\nन हि जग्मुः प्रतीतिं च मिथ्येत्यूचुर्व्रजे प्रजाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003077013, "chapter_id": 23077, "verse_number": "४-१२-१४", "content_sanskrit": "शिशोः स्वस्त्ययनं कार्यं चक्रुर्ब्राह्मणपुंगवाः ।\nहस्तं दत्त्वा शिशोर्गात्रे पपाठ कवचं द्विजः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003077014, "chapter_id": 23077, "verse_number": "४-१२-१५", "content_sanskrit": "वदामि तत्ते विप्रेन्द्र कवचं सर्वरक्षणम् ।\nयद्दत्तं मायया पूर्वं ब्रह्मणे नाभिपंकजे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003077015, "chapter_id": 23077, "verse_number": "४-१२-१६", "content_sanskrit": "निद्रिते जगतीनाथे जले च जलशायिनि ।\nभीताय स्तुतिकर्त्रे च मधुकैटभयोर्भयात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003077016, "chapter_id": 23077, "verse_number": "४-१२-१७", "content_sanskrit": "योगनिद्रोवाच ।\nदूरीभूतं कुरु भयं भयं किं ते हरौ स्थिते ।\nस्थितायां मयि च ब्रह्मन्सुखी तिष्ठ जगत्पते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003077017, "chapter_id": 23077, "verse_number": "४-१२-१८", "content_sanskrit": "श्रीहरिः पातु ते वक्त्रं मस्तकं मधुसूदनः ।\nश्रीकृष्णश्चक्षुषी पातु नासिकां राधिकापतिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003077018, "chapter_id": 23077, "verse_number": "४-१२-१९", "content_sanskrit": "कर्णयुग्मं च कण्ठं च कपालं पातु माधवः ।\nकपोलं पातु गोविन्दः केशांश्च केशवः स्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003077019, "chapter_id": 23077, "verse_number": "४-१२-२०", "content_sanskrit": "अधरोष्ठं हृषीकेशो दंतपंक्तिं गदाग्रजः ।\nरासेश्वरश्च रसनां तालुकं वामनो विभुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003077020, "chapter_id": 23077, "verse_number": "४-१२-२१", "content_sanskrit": "वक्षः पातु मुकुन्दश्च जठरं पातु दैत्यहा ।\nजनार्दनः पातु नाभिं पातु विष्णुश्च मेहनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003077021, "chapter_id": 23077, "verse_number": "४-१२-२२", "content_sanskrit": "नितंबयुग्मं गुह्यं च पातु ते पुरुषोत्तमः ।\nजानुयुग्मे जानकीशः पातु ते सर्वदा विभुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003077022, "chapter_id": 23077, "verse_number": "४-१२-२३", "content_sanskrit": "हस्तयुग्मं नृसिंहश्च पातु सर्वत्र संकटे ।\nपादयुग्मं वराहश्च पातु ते कमलोद्भवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003077023, "chapter_id": 23077, "verse_number": "४-१२-२४", "content_sanskrit": "ऊर्ध्वं नारायणः पातु ह्यधस्तात्कमलापतिः ।\nपूर्वस्यां पातु गोपालः पातु वह्नौ दशास्यहा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003077024, "chapter_id": 23077, "verse_number": "४-१२-२५", "content_sanskrit": "वनमाली पातु याम्यां वैकुंठः पातु नैर्ऋतौ ।\nवारुण्यां वासुदेवश्च सतो रक्षाकरः स्वयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003077025, "chapter_id": 23077, "verse_number": "४-१२-२६", "content_sanskrit": "पातु ते संततमजो वायव्यां विष्टरश्रवाः ।\nउत्तरे च सदा पातु तेजसा जलजासनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003077026, "chapter_id": 23077, "verse_number": "४-१२-२७", "content_sanskrit": "ऐशान्यामीश्वरः पातु पातु सर्वत्र शत्रुजित् ।\nजले स्थले चांतरिक्षे निद्रायां पातु राघवः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003077027, "chapter_id": 23077, "verse_number": "४-१२-२८", "content_sanskrit": "इत्येवं कथितं ब्रह्मन्कवचं परमाद्भुतम् ।\nकृष्णेन कृपया दत्तं स्मृतेनैव पुरा मया ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003077028, "chapter_id": 23077, "verse_number": "४-१२-२९", "content_sanskrit": "शुंभेन सह संग्रामे निर्लक्ष्ये घोरदारुणे ।\nगगने स्थितया सद्यः प्राप्तिमात्रेण सो जितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003077029, "chapter_id": 23077, "verse_number": "४-१२-३०", "content_sanskrit": "कवचस्य प्रभावेण धरण्यां पतितो मृतः।\nपूर्वं वर्षशतं खे च कृत्वा युद्धं भयावहम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003077030, "chapter_id": 23077, "verse_number": "४-१२-३१", "content_sanskrit": "मृते शुंभे च गोविन्दः कृपालुर्गगनस्थितः ।\nमालां च कवचं दत्त्वा गोलोकं स जगाम ह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003077031, "chapter_id": 23077, "verse_number": "४-१२-३२", "content_sanskrit": "कल्पांतरस्य वृत्तांतं कृपया कथितं मुने ।\nअभ्यंतरभयं नास्ति कवचस्य प्रभावतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003077032, "chapter_id": 23077, "verse_number": "४-१२-३३", "content_sanskrit": "कोटिशः कोटिशो नष्टा मया दृष्टाश्च वेधसः ।\nअहं च हरिणा सार्द्धं कल्पेकल्पे स्थिरा सदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003077033, "chapter_id": 23077, "verse_number": "४-१२-३४", "content_sanskrit": "इत्युक्त्वा कवचं दत्त्वा साऽन्तर्धानं चकार ह ।\nनिःशङ्को नाभिकमले तस्थौ स कमलोद्भवः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003077034, "chapter_id": 23077, "verse_number": "४-१२-३५", "content_sanskrit": "सुवर्णगुटिकायां च कृत्वेदं कवचं परम् ।\nकण्ठे वा दक्षिणे बाहौ बध्नीयाद्यः सुधीः सदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003077035, "chapter_id": 23077, "verse_number": "४-१२-३६", "content_sanskrit": "विषाग्निजलशत्रुभ्यो भयं तस्य न जायते ।\nजले स्थले चांतरिक्षे निद्रायां रक्षतीश्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003077036, "chapter_id": 23077, "verse_number": "४-१२-३७", "content_sanskrit": "संग्रामे वज्रपाते च विपत्तौ प्राणसंकटे ।\nकवचस्मरणादेव सद्यो निःशङ्कतां व्रजेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003077037, "chapter_id": 23077, "verse_number": "४-१२-३८", "content_sanskrit": "बद्ध्वेदं कवचं कण्ठे शंकरस्त्रिपुरं पुरा ।\nजघान लीलामात्रेण दुरंतमसुरेश्वरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003077038, "chapter_id": 23077, "verse_number": "४-१२-३९", "content_sanskrit": "बद्ध्वेदं कवचं काली रक्तबीजं चखाद सा ।\nसहस्रशीर्षा धृत्वेदं विश्वं धत्ते तिलं यथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003077039, "chapter_id": 23077, "verse_number": "४-१२-४०", "content_sanskrit": "आवां सनत्कुमारश्च धर्मसाक्षी च कर्मणाम् ।\nकवचस्य प्रभावेण सर्वत्र जयिनो वयम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003077040, "chapter_id": 23077, "verse_number": "४-१२-४१", "content_sanskrit": "तस्य नन्दशिशोः कण्ठे चकार कवचं द्विजः ।\nआत्मनः कवचं कण्ठे दधार च स्वयं हरिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003077041, "chapter_id": 23077, "verse_number": "४-१२-४२", "content_sanskrit": "प्रभावः कथितः सर्वः कवचस्य हरेस्तथा ।\nअनन्तस्याच्युतस्यैव प्रभावमतुलं मुने ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]