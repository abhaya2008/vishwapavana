[{"id": 7000362000, "chapter_id": 20362, "verse_number": "२-३४-१", "content_sanskrit": "सूत उवाच ।\nयथा शप्ता वने पूर्वं सुशंखेन महात्मना ।\nतासु सर्वं समाख्यातं सखीष्वेव विचेष्टितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000362001, "chapter_id": 20362, "verse_number": "२-३४-२", "content_sanskrit": "आत्मनश्च महाभागा दुःखेनातिप्रपीडिता ।\nसुनीथोवाच ।\nअन्यच्चैव प्रवक्ष्यामि सख्यः शृण्वंतु सांप्रतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000362002, "chapter_id": 20362, "verse_number": "२-३४-३", "content_sanskrit": "मदीयरूपसंपत्ति वयः सगुणसंपदः ।\nविलोक्य तातश्चिंतात्मा संजातो मम कारणात्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000362003, "chapter_id": 20362, "verse_number": "२-३४-४", "content_sanskrit": "देवेभ्यो दातुकामोऽसौ मुनिभ्यस्तु महायशाः ।\nमां च हस्ते विगृह्यैव सर्वान्वाक्यमुदाहरत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000362004, "chapter_id": 20362, "verse_number": "२-३४-५", "content_sanskrit": "गुणयुक्ता सुता बाला ममेयं चारुलोचना ।\nदातुकामोस्मि भद्रं वो गुणिने सुमहात्मने॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000362005, "chapter_id": 20362, "verse_number": "२-३४-६", "content_sanskrit": "मृत्योर्वाक्यं ततो देवा ऋषयः शुश्रुवुस्तदा ।\nतमूचुर्भाषमाणं ते देवा इंद्र पुरोगमाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000362006, "chapter_id": 20362, "verse_number": "२-३४-७", "content_sanskrit": "तव कन्या गुणाढ्येयं शीलानां परमो निधिः ।\nदोषेणैकेन संदुष्टा ऋषिशापेन तेन वै॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000362007, "chapter_id": 20362, "verse_number": "२-३४-८", "content_sanskrit": "अस्यामुत्पत्स्यते पुत्रो यस्य वीर्यात्पुमान्किल ।\nभविता स महापापी पुण्यवंशविनाशकः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000362008, "chapter_id": 20362, "verse_number": "२-३४-९", "content_sanskrit": "गंगातोयेन संपूर्णः कुंभ एव प्रदृश्यते ।\nसुरायाबिन्दुनालिप्तो मद्यकुम्भः प्रजायते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000362009, "chapter_id": 20362, "verse_number": "२-३४-१०", "content_sanskrit": "पापस्य पापसंसर्गात्कुलं पापि प्रजायते ।\nआरनालस्य वै बिंदुः क्षीरमध्ये प्रयाति चेत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000362010, "chapter_id": 20362, "verse_number": "२-३४-११", "content_sanskrit": "पश्चान्नाशयते क्षीरमात्मरूपं प्रकाशयेत् ।\nतद्वद्विनाशयेद्वंशं पापः पुत्रो न संशयः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000362011, "chapter_id": 20362, "verse_number": "२-३४-१२", "content_sanskrit": "अनेनापि हि दोषेण तवेयं पापभागिनी ।\nअन्यस्मै दीयतां गच्छ देवैरुक्तः पिता मम॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000362012, "chapter_id": 20362, "verse_number": "२-३४-१३", "content_sanskrit": "देवैश्चापि सगंधर्वैरृषिभिश्च महात्मभिः ।\nतैश्चापि संपरित्यक्तः पिता मे दुःखपीडितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000362013, "chapter_id": 20362, "verse_number": "२-३४-१४", "content_sanskrit": "ममान्ये चापि स्वीकारं न कुर्वंति हि सज्जनाः ।\nएवं पापमयं कर्म मया चैव पुरा कृतम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000362014, "chapter_id": 20362, "verse_number": "२-३४-१५", "content_sanskrit": "संतप्ता दुःखशोकेन वनमेव समाश्रिता ।\nतप एव चरिष्यामि करिष्ये कायशोषणम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000362015, "chapter_id": 20362, "verse_number": "२-३४-१६", "content_sanskrit": "भवतीभिः सुपृष्टाहं कार्यकारणमेव हि ।\nमम चिंतानुगं कर्म मया तद्वः प्रकाशितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000362016, "chapter_id": 20362, "verse_number": "२-३४-१७", "content_sanskrit": "एवमुक्त्वा सुनीथा सा मृत्योः कन्या यशस्विनी ।\nविरराम च दुःखार्ता किंचिन्नोवाच वै पुनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000362017, "chapter_id": 20362, "verse_number": "२-३४-१८", "content_sanskrit": "सख्य ऊचुः ।\nदुःखमेव महाभागे त्यज कायविनाशनम् ।\nनास्ति कस्य कुले दोषो देवैः पापं समाश्रितम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000362018, "chapter_id": 20362, "verse_number": "२-३४-१९", "content_sanskrit": "जिह्ममुक्तं पुरा तेन ब्रह्मणा हरसंनिधौ ।\nदेवैश्चापि स हि त्यक्तो ब्रह्माऽपूज्यतमोऽभवत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000362019, "chapter_id": 20362, "verse_number": "२-३४-२०", "content_sanskrit": "ब्रह्महत्या प्रयुक्तोऽसौ देवराजोपि पश्य भोः ।\nदेवैः सार्धं महाभागस्त्रैलोक्यं परिभुंजति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000362020, "chapter_id": 20362, "verse_number": "२-३४-२१", "content_sanskrit": "गौतमस्य प्रियां भार्यामहल्यां गतवान्पुरा ।\nपरदाराभिगामी स देवत्वे परिवर्त्तते॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000362021, "chapter_id": 20362, "verse_number": "२-३४-२२", "content_sanskrit": "ब्रह्महत्योपमं कर्म दारुणं कृतवान्हरः ।\nब्रह्मणस्तु कपालेन चाद्यापि परिवर्तते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000362022, "chapter_id": 20362, "verse_number": "२-३४-२३", "content_sanskrit": "देवानमंतितं देवमृषयो वेदपारगाः ।\nआदित्यः कुष्ठसंयुक्तस्त्रैलोक्यं च प्रकाशयेत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000362023, "chapter_id": 20362, "verse_number": "२-३४-२४", "content_sanskrit": "लोकानमंतितं देवं देवाद्याः सचराचराः ।\nकृष्णो भुंक्ते महाशापं भार्गवेण कृतं पुरा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000362024, "chapter_id": 20362, "verse_number": "२-३४-२५", "content_sanskrit": "गुरुभार्यांगतश्चंद्रः क्षयी तेन प्रजायते ।\nभविष्यति महातेजा राजराजः प्रतापवान्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000362025, "chapter_id": 20362, "verse_number": "२-३४-२६", "content_sanskrit": "पांडुपुत्रो महाप्राज्ञो धर्मात्मा स युधिष्ठिरः ।\nगुरोश्चैव वधार्थाय अनृतं स वदिष्यति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000362026, "chapter_id": 20362, "verse_number": "२-३४-२७", "content_sanskrit": "एतेष्वेव महत्पापं वर्तते च महत्सु च ।\nवैगुण्यं कस्य वै नास्ति कस्य नास्ति च लांछनम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000362027, "chapter_id": 20362, "verse_number": "२-३४-२८", "content_sanskrit": "भवती स्वल्पदोषेण विलिप्तासि वरानने ।\nउपकारं करिष्यामस्तवैव वरवर्णिनि॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000362028, "chapter_id": 20362, "verse_number": "२-३४-२९", "content_sanskrit": "तवांगे ये गुणाः संति सत्यस्त्रीणां यथा शुभे ।\nअन्यत्रापि न पश्यामस्तान्गुणांश्चारुलोचने॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000362029, "chapter_id": 20362, "verse_number": "२-३४-३०", "content_sanskrit": "रूपमेव गुणः स्त्रीणां प्रथमं भूषणं शुभे ।\nशीलमेव द्वितीयं च तृतीयं सत्यमेव च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000362030, "chapter_id": 20362, "verse_number": "२-३४-३१", "content_sanskrit": "आर्जवत्वं चतुर्थं च पंचमं धर्ममेव हि ।\nमधुरत्वं ततः प्रोक्तं षष्ठमेव वरानने॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000362031, "chapter_id": 20362, "verse_number": "२-३४-३२", "content_sanskrit": "शुद्धत्वं सप्तमं बाले अंतर्बाह्येषु योषितम् ।\nअष्टमं हि पितुर्भावः शुश्रूषा नवमं किल॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000362032, "chapter_id": 20362, "verse_number": "२-३४-३३", "content_sanskrit": "सहिष्णुर्दशमं प्रोक्तं रतिश्चैकादशं तथा ।\nपातिव्रत्यं ततः प्रोक्तं द्वादशं वरवर्णिनि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000362033, "chapter_id": 20362, "verse_number": "२-३४-३४", "content_sanskrit": "तैस्त्वं संभूषिता बाले मा बिभेषि वरानने ।\nयेनोपायेन ते भर्ता भविष्यति सुधर्मधृक्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000362034, "chapter_id": 20362, "verse_number": "२-३४-३५", "content_sanskrit": "तमुपायं प्रपश्यामस्तवार्थं वयमेव हि ।\nतामूचुस्ता वराः सख्यो मा त्वं वै साहसं कुरु॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000362035, "chapter_id": 20362, "verse_number": "२-३४-३६", "content_sanskrit": "सूत उवाच ।\nएवमुक्ता सुनीथा सा पुनरूचे सखीस्तु ताः ।\nकथयध्वं ममोपायं येन भर्ता भविष्यति॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000362036, "chapter_id": 20362, "verse_number": "२-३४-३७", "content_sanskrit": "तामूचुस्ता वरा नार्यो रंभाद्याश्चारुलोचनाः ।\nरूपमाधुर्यसंयुक्ता भवती भूतिवर्द्धनी॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000362037, "chapter_id": 20362, "verse_number": "२-३४-३८", "content_sanskrit": "ब्रह्मशापेन संभीता वयमत्र समागताः ।\nतां प्रोचुश्च विशालाक्षीं मृत्योः कन्यां सुलोचनाम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000362038, "chapter_id": 20362, "verse_number": "२-३४-३९", "content_sanskrit": "विद्यामेकां प्रदास्यामः पुरुषाणां प्रमोहिनीम् ।\nसर्वमायाविदां भद्रे सर्वभद्रप्रदायिनीम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000362039, "chapter_id": 20362, "verse_number": "२-३४-४०", "content_sanskrit": "विद्याबलं ततो दद्युस्तस्यैताः सुखदायकम् ।\nयं यं मोहयितुं भद्रे इच्छस्येवं सुरादिकम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000362040, "chapter_id": 20362, "verse_number": "२-३४-४१", "content_sanskrit": "तं तं सद्यो मोहय वा इत्युक्ता सा तथाऽकरोत् ।\nविद्यायां हि सुसिद्धायां सा सुनीथा सुनंदिता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000362041, "chapter_id": 20362, "verse_number": "२-३४-४२", "content_sanskrit": "भ्रमत्येवं सखीभिस्तु पुरुषान्सा विपश्यति ।\nअटमानागता पुण्यं नंदनं वनमुत्तमम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000362042, "chapter_id": 20362, "verse_number": "२-३४-४३", "content_sanskrit": "गंगातीरे ततो दृष्ट्वा ब्राह्मणं रूपसंयुतम् ।\nसर्वलक्षणसंपन्नं सूर्यतेजः समप्रभम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000362043, "chapter_id": 20362, "verse_number": "२-३४-४४", "content_sanskrit": "रूपेणाप्रतिमं लोके द्वितीयमिव मन्मथम् ।\nदेवरूपं महाभागं भाग्यवंतं सुभाग्यदम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000362044, "chapter_id": 20362, "verse_number": "२-३४-४५", "content_sanskrit": "अनौपम्यं महात्मानं विष्णुतेजः समप्रभम् ।\nवैष्णवं सर्वपापघ्नं विष्णुतुल्यपराक्रमम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000362045, "chapter_id": 20362, "verse_number": "२-३४-४६", "content_sanskrit": "कामक्रोधविहीनं तमत्रिवंशविभूषणम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000362046, "chapter_id": 20362, "verse_number": "२-३४-४७", "content_sanskrit": "दृष्ट्वा सुरूपं तपसां स्वरूपं दिव्यप्रभावं परितप्यमानम् ।\nपप्रच्छ रंभां सुसखीं सरागा कोयं दिविष्ठः प्रवरो महात्मा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]