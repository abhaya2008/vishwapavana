[{"id": 5000542000, "chapter_id": 9542, "verse_number": "७-७-१", "content_sanskrit": "नारायणगिरिं ते तु गर्जन्तो राक्षसाम्बुदाः ।\nववर्षुः शरवर्षेण वर्षेणेवाद्रिमम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000542001, "chapter_id": 9542, "verse_number": "७-७-२", "content_sanskrit": "श्यामावदातस्तैर्विष्णुर्नीलैर्नक्तञ्चरोत्तमैः ।\nवृतो ऽञ्जनगिरीवासीत् वर्षमाणैः पयोधरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000542002, "chapter_id": 9542, "verse_number": "७-७-३", "content_sanskrit": "शलभा इव केदारं मशका इव पर्वतम् ।\nयथामृतघटं दंशा मकरा इव चार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000542003, "chapter_id": 9542, "verse_number": "७-७-४", "content_sanskrit": "तथा रक्षोधनुर्मुक्ता वज्रानिलमनोजवाः ।\nहरिं विशन्ति स्म शरा लोका इव विपर्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000542004, "chapter_id": 9542, "verse_number": "७-७-५", "content_sanskrit": "स्यन्दनैः स्यन्दनगता गजैश्च गजपृष्ठगाः ।\nअश्वारोहास्तथाश्वैश्च पादाताश्चाम्बरे स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000542005, "chapter_id": 9542, "verse_number": "७-७-६", "content_sanskrit": "राक्षसेन्द्रा गिरिनिभाः शरैः शक्त्यृष्टितोमरैः ।\nनिरुछ्वासं हरिं चक्रुः प्राणायामा इव द्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000542006, "chapter_id": 9542, "verse_number": "७-७-७", "content_sanskrit": "निशाचरैस्ताड्यमानो मीनैरिव महोदधिः ।\nशार्ङ्गमायम्य दुर्धर्षो राक्षसेभ्यो ऽसृजच्छरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000542007, "chapter_id": 9542, "verse_number": "७-७-८", "content_sanskrit": "शरैः पूर्णायतोत्सृष्टैर्वज्रवक्त्रैर्मनोजवैः ।\nचिच्छेद विष्णुर्निशितैः शतशो ऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000542008, "chapter_id": 9542, "verse_number": "७-७-९", "content_sanskrit": "विद्राव्य शरवर्षेण वर्षा वायुरिवोत्थितम् ।\nपाञ्चजन्यं महाशङ्खं प्रदध्मौ पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000542009, "chapter_id": 9542, "verse_number": "७-७-१०", "content_sanskrit": "सो ऽम्बुजो हरिणा ध्मातः सर्वप्राणेन शङ्खराट् ।\nररास भीमनिर्हादस्त्रैलोक्यं व्यथयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000542010, "chapter_id": 9542, "verse_number": "७-७-११", "content_sanskrit": "शङ्खराजरवः सो ऽथ त्रासयामास राक्षसान् ।\nमृगराज इवारण्ये समदानिव कुञ्जरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000542011, "chapter_id": 9542, "verse_number": "७-७-१२", "content_sanskrit": "न शेकुरश्वाः संस्थातुं विमदाः कुञ्जराभवन् ।\nस्यन्दनेभ्यश्च्युता वीराः शङ्खरावितदुर्बलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000542012, "chapter_id": 9542, "verse_number": "७-७-१३", "content_sanskrit": "शार्ङ्गचापविनिर्मुक्ता वज्रतुल्याननाः शराः ।\nविदार्य तानि रक्षांसि सुपुङ्खा विविशुः क्षितिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000542013, "chapter_id": 9542, "verse_number": "७-७-१४", "content_sanskrit": "भिद्यमानाः शरैः सङ्ख्ये नारायणकरच्युतैः ।\nनिपेतू राक्षसा भूमौ शैला वज्रहता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000542014, "chapter_id": 9542, "verse_number": "७-७-१५", "content_sanskrit": "व्रणानि परगात्रेभ्यो विष्णुचक्रकृतानि वै ।\nअसृक्क्षरन्ति धाराभिः स्वर्णधारा इवाचलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000542015, "chapter_id": 9542, "verse_number": "७-७-१६", "content_sanskrit": "शङ्खराजरवश्चापि शार्ङ्गचापरस्वस्तथा ।\nराक्षसानां रवांश्चापि ग्रसते वैष्णवो रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000542016, "chapter_id": 9542, "verse_number": "७-७-१७", "content_sanskrit": "तेषां शिरोधरान्धूताञ्छरध्वजधनूंषि च ।\nरथान्पताकास्तूणीरांश्चिच्छेद स हरिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000542017, "chapter_id": 9542, "verse_number": "७-७-१८", "content_sanskrit": "सूर्यादिव करा घोरा ऊर्मयः सागरादिव ।\nपर्वतादिव नागेन्द्रा धारौघा इव चाम्बुदात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000542018, "chapter_id": 9542, "verse_number": "७-७-१९", "content_sanskrit": "तथा शार्ङ्गविनिर्मुक्ताः शरा नारायणेरिताः ।\nनिर्धावन्तीषवस्तूर्णं शतशोथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000542019, "chapter_id": 9542, "verse_number": "७-७-२०", "content_sanskrit": "शरभेण यथा सिंहाः सिंहेन द्विरदा यथा ।\nद्विरदेन यथा व्याघ्रा व्याघ्रेण द्वीपिनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000542020, "chapter_id": 9542, "verse_number": "७-७-२१", "content_sanskrit": "द्वीपिनेव यथा श्वानः शुना मार्जारका यथा ।\nमार्जारेण यथा सर्पाः सर्पेण च यथा ऽ ऽखवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000542021, "chapter_id": 9542, "verse_number": "७-७-२२", "content_sanskrit": "तथा ते राक्षसाः सर्वे विष्णुना प्रभविष्णुना ।\nद्रवन्ति द्राविताश्चन्ये शायिताश्च महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000542022, "chapter_id": 9542, "verse_number": "७-७-२३", "content_sanskrit": "राक्षसानां सहस्राणि निहत्य मधुसूदनः ।\nवारिजं पूरयामास तोयदं सुरराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000542023, "chapter_id": 9542, "verse_number": "७-७-२४", "content_sanskrit": "नारायणशरत्रस्तं शङ्खनादसुविह्वलम् ।\nययौ लङ्कामभिमुखं प्रभग्नं राक्षसं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000542024, "chapter_id": 9542, "verse_number": "७-७-२५", "content_sanskrit": "प्रभग्ने राक्षसबले नारायणशराहते ।\nसुमाली शरवर्षेण निववार रणे हरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000542025, "chapter_id": 9542, "verse_number": "७-७-२६", "content_sanskrit": "स तु तं छादयामास नीहार इव भास्करम् ।\nराक्षसाः सत्त्वसम्पन्नाः पुनर्धैर्यं समादधुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000542026, "chapter_id": 9542, "verse_number": "७-७-२७", "content_sanskrit": "अथ सो ऽभ्यपतद्रोषाद्राक्षसो बलदर्पितः ।\nमहानादं प्रकुर्वाणो राक्षसाञ्जीवयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000542027, "chapter_id": 9542, "verse_number": "७-७-२८", "content_sanskrit": "उत्क्षिप्य लम्बाभरणं धुन्वन्करमिव द्विपः ।\nररास राक्षसो हर्षात्सतडित्तोयदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000542028, "chapter_id": 9542, "verse_number": "७-७-२९", "content_sanskrit": "सुमालेर्नर्दतस्तस्य शिरो ज्वलितकुण्डलम् ।\nचिच्छेद यन्तुरश्वाश्च भ्रान्तास्तस्य तु रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000542029, "chapter_id": 9542, "verse_number": "७-७-३०", "content_sanskrit": "तैरश्वैर्भ्राम्यते भ्रान्तैः सुमाली राक्षसेश्वरः ।\nइन्द्रियाश्वैः परिभ्रान्तैर्धृतिहीनो यथा नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000542030, "chapter_id": 9542, "verse_number": "७-७-३१", "content_sanskrit": "ततो विष्णुं महाबाहुं प्रपतन्तं रणाजिरे ।\nहृते सुमालेरश्वैश्च रथे विष्णुरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000542031, "chapter_id": 9542, "verse_number": "७-७-३२", "content_sanskrit": "माली चाभ्यद्रवद्युक्तः प्रगृह्य सशरं धनुः ।\nमालेर्धनुश्च्युता बाणाः कार्तस्वरविभूषिताः ।\nविविशुर्हरिमासाद्य क्रौञ्चं पत्ररथा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000542032, "chapter_id": 9542, "verse_number": "७-७-३३", "content_sanskrit": "अर्द्यमानः शरैः सो ऽथ मालिमुक्तैः सहस्रशः ।\nचुक्षुभे न रणे विष्णुर्जितेन्द्रिय इवाधिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000542033, "chapter_id": 9542, "verse_number": "७-७-३४", "content_sanskrit": "अथ मौर्वीस्वनं कृत्वा भगवान्भूतभावनः ।\nमालिनं प्रति बाणौघान्ससर्जारिनिषूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000542034, "chapter_id": 9542, "verse_number": "७-७-३५", "content_sanskrit": "ते मालिदेहमासाद्य वज्रविद्युत्प्रभाः शराः ।\nपिबन्ति रुधिरं तस्य नागा इव सुधारसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000542035, "chapter_id": 9542, "verse_number": "७-७-३६", "content_sanskrit": "मालिनं विमुखं कृत्वा शङ्खचक्रगदाधरः ।\nमालिमौलिं ध्वजं चापं वाजिनश्चाप्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000542036, "chapter_id": 9542, "verse_number": "७-७-३७", "content_sanskrit": "विरथस्तु गदां गृह्य माली नक्तञ्चरोत्तमः ।\nआपुप्लुवे गदापाणिर्गिर्यग्रादिव केसरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000542037, "chapter_id": 9542, "verse_number": "७-७-३८", "content_sanskrit": "गदया गरुडेशानमीशानमिव चान्तकः ।\nललाटदेशे ऽभ्यहनद्वज्रेणेन्द्रो यथा ऽचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000542038, "chapter_id": 9542, "verse_number": "७-७-३९", "content_sanskrit": "गदयाभिहतस्तेन मालिना गरुडो भृशम् ।\nरणात्पराङ्मुखं देवं कृतवान्वेदनातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000542039, "chapter_id": 9542, "verse_number": "७-७-४०", "content_sanskrit": "पराङ्मुखे कृते देवे मालिना गरुडेन वै ।\nउदतिष्ठन्महाञ्छब्दो रक्षसामभिनर्दताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000542040, "chapter_id": 9542, "verse_number": "७-७-४१", "content_sanskrit": "रक्षसां रवतां रावं श्रुत्वा हरिहयानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000542041, "chapter_id": 9542, "verse_number": "७-७-४२", "content_sanskrit": "तिर्यगास्थाय सङ्क्रुद्धः पक्षीशे भगवान्हरिः ।\nपराङ्मुखो ऽप्युत्ससर्ज मालेश्चक्रं जिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000542042, "chapter_id": 9542, "verse_number": "७-७-४३", "content_sanskrit": "तत्सूर्यमण्डलाभासं स्वभासा भासयन्नभः ।\nकालचक्रनिभं चक्रं मालेः शीर्षमपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000542043, "chapter_id": 9542, "verse_number": "७-७-४४", "content_sanskrit": "तच्छिरो राक्षसेन्द्रस्य चक्रोत्कृत्तं बिभीषणम् ।\nपपात रुधिरोद्गारि पुरा राहुशिरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000542044, "chapter_id": 9542, "verse_number": "७-७-४५", "content_sanskrit": "ततः सुरैः संसहृष्टैः सर्वप्राणसमीरितः ।\nसिंहनादरवोन्मुक्तः साधु देवेतिवादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000542045, "chapter_id": 9542, "verse_number": "७-७-४६", "content_sanskrit": "मालिनं निहतं दृष्ट्वा सुमाली माल्यवानपि ।\nसबलौ शोकसन्तप्तौ लङ्कामेव प्रधावितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000542046, "chapter_id": 9542, "verse_number": "७-७-४७", "content_sanskrit": "गरुडस्तु समाश्वस्तः सन्निवृत्य यथा पुरा ।\nराक्षसान्द्रावयामास पक्षवातेन कोपितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000542047, "chapter_id": 9542, "verse_number": "७-७-४८", "content_sanskrit": "चक्रकृत्तास्यकमला गदासञ्चूर्णितोरसः ।\nलाङ्गलग्लपितग्रीवा मुसलैर्भिन्नमस्तकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000542048, "chapter_id": 9542, "verse_number": "७-७-४९", "content_sanskrit": "केचिच्चैवासिना छिन्नास्तथान्ये शरपीडिताः ।\nनिपेतुरम्बरात्तूर्णं राक्षसाः सागराम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000542049, "chapter_id": 9542, "verse_number": "७-७-५०", "content_sanskrit": "नारायणो बाणवराशनीभिर्विदारयामास धनुर्विमुक्तैः ।\nनक्तञ्चरान्मुक्तविधूतकेशान्यथा ऽशनीभिः सतडिन्महाभ्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000542050, "chapter_id": 9542, "verse_number": "७-७-५१", "content_sanskrit": "भिन्नातपत्रं पतमानमस्त्रं शरैरपध्वस्तविनीतवेषम् ।\nविनिस्सृतान्त्रं भयलोलनेत्रं बलं तदुन्मत्ततरं बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000542051, "chapter_id": 9542, "verse_number": "७-७-५२", "content_sanskrit": "सिंहार्दितानामिव कुञ्जराणां निशाचराणां सह कुञ्जराणाम् ।\nरवाश्च वेगाश्च समं बभूवुः पुराणसिंहेन विमर्दितानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000542052, "chapter_id": 9542, "verse_number": "७-७-५३", "content_sanskrit": "ते वार्यमाणा हरिबाणजालैः सबाणजालानि समुत्सृजन्तः ।\nधावन्ति नक्तञ्चरकालमेघा वायुप्रभिन्ना इव कालमेघाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000542053, "chapter_id": 9542, "verse_number": "७-७-५४", "content_sanskrit": "चक्रपहारैर्विनिकृत्तशीर्षाः सञ्चूर्णिताङ्गाश्च गदाप्रहारैः ।\nअभिप्रहारैर्द्विविधा विभिन्नाः पतन्ति शैला इव राक्षसेन्द्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000542054, "chapter_id": 9542, "verse_number": "७-७-५५", "content_sanskrit": "विलम्बमानैर्मणिहारकुण्डलैर्निशाचरैर्नीलबलाहकोपमैः ।\nनिपात्यमानैर्ददृशे निरन्तरं निपात्यमानैरिव नीलपर्वतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000542055, "chapter_id": 9542, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]