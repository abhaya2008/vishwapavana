[{"id": 2188597, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "भीष्मेण युधिष्ठिरं प्रति तपःशब्दस्य मतभेदेन नानार्थकत्वकथनपूर्वकं\nस्वमते तस्य ज्ञानार्थकत्वाभिधानम् । ज्ञानस्य मोक्षसाधनत्वे दृष्टान्ततया सुवर्चलाचरित्रकथनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188598, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188599, "chapter_id": 5008, "verse_number": "१", "content_sanskrit": "यदिदं तप इत्याहुः किं तपः सम्प्रकीर्तितम् ।\nउपवासमथान्यत् तु वेदाचारमथो नु किम् ।\nशास्त्रं तपो महाप्राज्ञ तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188600, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188601, "chapter_id": 5008, "verse_number": "२", "content_sanskrit": "पक्षमासोपवासादीन् मन्यन्ते वै तपोधनाः ।\nवेदव्रतादीनि तप अपरे वेदपारगाः ।\nवेदपारायणं चान्ये चाहुस्तत्वमथापरे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188602, "chapter_id": 5008, "verse_number": "३", "content_sanskrit": "यथाविहितमाचारस्तपः सर्वं व्रतं गताः ।\nआत्मविद्याविधानं यत् तत् तपः परिकीर्तितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188603, "chapter_id": 5008, "verse_number": "४", "content_sanskrit": "त्यागस्तपस्तथा शान्तिस्तप इन्द्रियनिग्रहः ।\nब्रह्मचर्यं तपः प्रोक्तमाहुरेवं द्विजातयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188604, "chapter_id": 5008, "verse_number": "५", "content_sanskrit": "सदोपवासो यो विद्वान् ब्रह्मचारी सदा भवेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188605, "chapter_id": 5008, "verse_number": "६", "content_sanskrit": "यो मुनिश्च सदा धीमान् विघसाशी विमत्सरः ।\nततस्त्वनन्तमप्याहुर्यो नित्यमतिथिप्रियः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188606, "chapter_id": 5008, "verse_number": "७", "content_sanskrit": "नान्तराशीस्ततो नित्यमुपवासी महाव्रतः ।\nऋतुगामी तथा प्रोक्तो विघसाशी स्मृतो बुधैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188607, "chapter_id": 5008, "verse_number": "८", "content_sanskrit": "भृत्यशेषं तु यो भुङ्क्ते यज्ञशेषं तथाऽमृतम् ।\nएवं नानार्थसंयोगं तपः शश्वदुदाहृतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188608, "chapter_id": 5008, "verse_number": "९", "content_sanskrit": "येऽपि कर्ममयं प्राहुस्ते द्विजा ब्राह्मणाः स्मृताः ।\nरमन्ते दिव्यभोगैश्च पूजिता ह्यप्सरोगणैः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188609, "chapter_id": 5008, "verse_number": "१०", "content_sanskrit": "ज्ञानात्मकं तपश्शब्दं ये वदन्ति विनिश्चिताः ।\nते ह्यन्तराऽऽत्मसद्भावं प्रपन्ना नृपसत्तम \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188610, "chapter_id": 5008, "verse_number": "११", "content_sanskrit": "एतत्ते नृपशार्दूल प्रोक्तं यत् पृष्टवानसि ।\nयथावस्तूनि सञ्ज्ञानि विविधानि भवन्त्युत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188611, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188612, "chapter_id": 5008, "verse_number": "१२", "content_sanskrit": "पितामह महाप्राज्ञ राजाधीना नृपाः पुनः ।\nअन्यानि च सहस्राणि नामानि विविधानि च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188613, "chapter_id": 5008, "verse_number": "१३", "content_sanskrit": "प्रतियोगीनि वै तेषां छन्नान्यस्तमितानि च ।\nदृढं सर्वं प्राकृतकमिदं सर्वत्र पश्य वै \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188614, "chapter_id": 5008, "verse_number": "१४", "content_sanskrit": "तस्माद् यथागतं राजन् यथारुचि नृणां भवेत् ।\nअस्मिन्नर्थे पुरावृत्तं शृणु राजन् युधिष्ठिर\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188615, "chapter_id": 5008, "verse_number": "१५", "content_sanskrit": "ब्राह्मणानां समूहे तु यदुवाच सुवर्चला ।\nदेवलस्य सुता विद्वन् सर्वलक्षणशोभिता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188616, "chapter_id": 5008, "verse_number": "१६", "content_sanskrit": "कन्या सुवर्चला नाम योगभावितचेतना ।\nहेतुना केन जाता सा निर्द्वन्द्वा नष्टसंशया \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188617, "chapter_id": 5008, "verse_number": "१७", "content_sanskrit": "साऽब्रवीत् पितरं विप्रं वरान्वेषणतत्परा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188618, "chapter_id": 5008, "verse_number": "१८", "content_sanskrit": "अन्धाय मां महाप्राज्ञ देहि वीक्ष्य सुलोचनम् ।\nएवं स्म च पितः शश्वन्मयेदं प्रार्थितं मुने\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188619, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "पिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2188620, "chapter_id": 5008, "verse_number": "१९", "content_sanskrit": "न शक्यं प्रार्थितुं वत्से त्वयाऽद्य प्रतिभाति मे ।\nअन्धताऽनन्धता चेति विचारो मम जायते ।\nउन्मत्तेव सुते वाक्यं भाषसे पृथुलोचने\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2188621, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "कन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2188622, "chapter_id": 5008, "verse_number": "२०", "content_sanskrit": "नाहमुन्मत्तभूताऽद्य बुद्धिपूर्वं ब्रवीमि ते ।\nविद्धि वैतादृशं लोके स मां भजति वेदवित्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2188623, "chapter_id": 5008, "verse_number": "२१", "content_sanskrit": "यान्यांस्त्वं मन्यसे दातुं मां द्विजोत्तम तानिह ।\nआनयान्यान् महाभाग ह्यहं द्रक्ष्यामि तेषु तम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2188624, "chapter_id": 5008, "verse_number": "२२", "content_sanskrit": "तथेति चोक्त्वा तां विप्रः प्रेषयामास शिष्यकान् ।\nऋषेः प्रभावं दृष्ट्वा ते कन्यायाश्च द्विजोत्तमाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2188625, "chapter_id": 5008, "verse_number": "२३", "content_sanskrit": "तानागतानथाभ्यर्च्य कन्यामाह पिता महान् ।\nयदीच्छसि वरं भद्रे तं विप्रं वरय स्वयम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2188626, "chapter_id": 5008, "verse_number": "२४", "content_sanskrit": "तथेति चोक्त्वा कल्याणी तप्तहेमनिभानना ।\nकरसम्मितमध्याङ्गी वाक्यमाह तपोधनाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2188627, "chapter_id": 5008, "verse_number": "२५", "content_sanskrit": "यद्यस्ति सम्मतो विप्रो ह्यन्धोऽनन्धः स मे वरः ।\nनोचुर्विप्रा महाभागां प्रतिवाक्यं ययुश्च ते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2188628, "chapter_id": 5008, "verse_number": "२६", "content_sanskrit": "कन्या च तिष्ठतामत्र पितुर्वेश्मनि भारत \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2188629, "chapter_id": 5008, "verse_number": "२७", "content_sanskrit": "श्वेतकेतुः कहोलस्य श्यालः परमधर्मवित् ।\nश्रुत्वा ब्रह्मा तदागम्य कन्यामाह महीपते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2188630, "chapter_id": 5008, "verse_number": "२८", "content_sanskrit": "सोहं भद्रे समावृत्तस्त्वयोक्तो यः पुरा द्विजः ।\nविशालनयनं विद्धि मामन्धोऽहं वृणीष्व माम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2188631, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2188632, "chapter_id": 5008, "verse_number": "२९", "content_sanskrit": "कथं विशालनेत्रोऽसि कथं वा त्वमलोचनः ।\nब्रूहि पश्चादहं विद्वन् परीक्षे त्वां द्विजोत्तम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2188633, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "द्विजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2188634, "chapter_id": 5008, "verse_number": "३०", "content_sanskrit": "शब्दे स्पर्शे तथा रूपे रसे गन्धे सहेतुकम् ।\nन मे प्रवर्तते चेतो न प्रत्यक्षं हि तेषु मे ।\nअलोचनोऽहं तस्माद्धि न गतिर्विद्यते यतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2188635, "chapter_id": 5008, "verse_number": "३१", "content_sanskrit": "येन पश्यति सुश्रोणि भाषते स्पृशते पुनः ।\nभुज्यते घ्रायते नित्यं शृणोति मनुते यथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2188636, "chapter_id": 5008, "verse_number": "३२", "content_sanskrit": "तच्चक्षुर्विद्यते मह्यं येन पश्यति वै स्फुटम् ।\nसुलोचनोऽहं भद्रे वै पृच्छ वा किं वदामि ते ।\nसर्वमस्मिन्न मेऽविद्या विद्वान् हि परमार्थतः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2188637, "chapter_id": 5008, "verse_number": "३३", "content_sanskrit": "सा विशुद्धा ततो भूत्वा श्वेतकेतुं महामुनिम् ।\nप्रणम्य पूजयामास तां भार्यां स च लब्धवान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2188638, "chapter_id": 5008, "verse_number": "३४", "content_sanskrit": "वैराग्यसंयुता कन्या तादृशं पतिमुत्तमम् ।\nप्राप्ता राजन् महाप्राज्ञ तस्मादर्थः पृथक्पृथक्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2188639, "chapter_id": 5008, "verse_number": "३५", "content_sanskrit": "एतत् ते कथितं राजन् किं भूयः श्रोतुमिच्छसि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2188640, "chapter_id": 5008, "verse_number": "", "content_sanskrit": "॥ इति इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे सप्तपञ्चाशोऽध्यायः ॥५७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]