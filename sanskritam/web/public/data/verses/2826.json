[{"id": 2085826, "chapter_id": 2826, "verse_number": "१२-३३१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085827, "chapter_id": 2826, "verse_number": "१२-३३१-१", "content_sanskrit": "कथं व्यासस्य धर्मात्मा शुको जज्ञे महातपाः।\nसिद्धिं च परमां प्राप्तस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085828, "chapter_id": 2826, "verse_number": "१२-३३१-२", "content_sanskrit": "कस्यां चोत्पादयामास शुकं व्यासस्तपोधनः।\nन ह्यस्य जननीं विद्मो जन्म चाग्र्यं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085829, "chapter_id": 2826, "verse_number": "१२-३३१-३", "content_sanskrit": "कथं च बालस्य सतः सूक्ष्मज्ञाने रता मतिः।\nयथा नान्यस्य लोकेऽस्मिन्द्वितीयस्येह कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085830, "chapter_id": 2826, "verse_number": "१२-३३१-४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण महामते।\nन हि मे तृप्तिरस्तीह शृण्वतोऽमृतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085831, "chapter_id": 2826, "verse_number": "१२-३३१-५", "content_sanskrit": "माहात्म्यमात्मयोगं च विज्ञानं च शुकस्य ह।\nयथावदानुपूर्व्येण तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085832, "chapter_id": 2826, "verse_number": "१२-३३१-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085833, "chapter_id": 2826, "verse_number": "१२-३३१-६", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तैर्न च बन्धुभिः।\nऋषयश्चक्रिरे धर्मं योऽनूचानः स नो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085834, "chapter_id": 2826, "verse_number": "१२-३३१-७", "content_sanskrit": "तपोमूलमिदं सर्वं यन्मां पृच्छसि पाण्डव।\nतदिन्द्रियाणि संयम्य तपो भवति नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085835, "chapter_id": 2826, "verse_number": "१२-३३१-८", "content_sanskrit": "इन्द्रियाणां प्रसङ्गेन दोषमृच्छत्यसंशयम्।\nसंनियम्य तु तान्येव सिद्धिमाप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085836, "chapter_id": 2826, "verse_number": "१२-३३१-९", "content_sanskrit": "अश्वमेधसहस्रस्य वाजपेयशतस्य च।\nयोगस्य कलया तात न तुल्यं विद्यते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085837, "chapter_id": 2826, "verse_number": "१२-३३१-१०", "content_sanskrit": "अत्र ते वर्तयिष्यामि जन्मयोगफलं तथा।\nशुकस्याग्र्यां गतिं चैव दुर्विदामकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085838, "chapter_id": 2826, "verse_number": "१२-३३१-११", "content_sanskrit": "मेरुशृङ्गे किल पुरा कर्णिकारवनायुते।\nविजहार महादेवो भीमैर्भूतगणैर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085839, "chapter_id": 2826, "verse_number": "१२-३३१-१२", "content_sanskrit": "शैलराजसुता चैव देवी तत्राभवत्पुरा।\nतत्र दिव्यं तपस्तेषे कृष्णद्वैपायनः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085840, "chapter_id": 2826, "verse_number": "१२-३३१-१३", "content_sanskrit": "योगेनात्मानमाविश्य योगधर्मपरायणः।\nधारयन्स तपस्तेपे पुत्रार्थं कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085841, "chapter_id": 2826, "verse_number": "१२-३३१-१४", "content_sanskrit": "अग्नेर्भूमेरपां वायोरन्तरिक्षस्य वा विभो।\nवीर्येण संमितः पुत्रो मम भूयादिति स्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085842, "chapter_id": 2826, "verse_number": "१२-३३१-१५", "content_sanskrit": "संकल्पेनाथ मौनेन दुष्प्रापमकृतात्मभिः।\nवरयामास देवेशमास्थितस्तप उत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085843, "chapter_id": 2826, "verse_number": "१२-३३१-१६", "content_sanskrit": "अतिष्ठन्मारुताहारः शतं किल समाः प्रभुः\nआराधयन्महादेवं बहुरूपमुमापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085844, "chapter_id": 2826, "verse_number": "१२-३३१-१७", "content_sanskrit": "तत्र ब्रह्मर्षयश्चैव सर्वे देवर्षयस्तथा।\nलोकपालाश्च लोकेशं साध्याश्च वसुभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085845, "chapter_id": 2826, "verse_number": "१२-३३१-१८", "content_sanskrit": "आदित्याश्चैव रुद्राश्च दिवाकरनिशाकरौ।\nमारुतो मरुतश्चैव सागराः सरितस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085846, "chapter_id": 2826, "verse_number": "१२-३३१-१९", "content_sanskrit": "अश्विनौ देवगन्धर्वास्तथा नारदपर्वतौ।\nविश्वावसुश्च गन्धर्वः सिद्धाश्चाप्सरसां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085847, "chapter_id": 2826, "verse_number": "१२-३३१-२०", "content_sanskrit": "तत्र रुद्रो महादेवः कर्णिकारमयीं शुभाम्।\nधारयाणः स्रजं भाति ज्योत्स्नामिव निशाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085848, "chapter_id": 2826, "verse_number": "१२-३३१-२१", "content_sanskrit": "तस्मिन्दिव्ये वने रम्ये देवदेवर्षिसंकुले।\nआस्थितः परमं योगमृषिः पुत्रार्थमच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085849, "chapter_id": 2826, "verse_number": "१२-३३१-२२", "content_sanskrit": "न चास्य हीयते प्राणो न ग्लानिरुपजायते।\nत्रयाणामपि लोकानां तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085850, "chapter_id": 2826, "verse_number": "१२-३३१-२३", "content_sanskrit": "जटाश्च तेजसा तस्य वैश्वानरशिखोपमाः।\nप्रज्वलन्त्यः स्म दृश्यन्ते युक्तस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085851, "chapter_id": 2826, "verse_number": "१२-३३१-२४", "content_sanskrit": "मार्कण्डेयो हि भगवानेतदाख्यातवान्मम।\nस देवचरितानीह कथयामास मे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085852, "chapter_id": 2826, "verse_number": "१२-३३१-२५", "content_sanskrit": "एता अद्यापि कृष्णस्य तपसा तेन दीपिताः।\nअग्निवर्णा जटास्तात प्रकाशन्ते महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085853, "chapter_id": 2826, "verse_number": "१२-३३१-२६", "content_sanskrit": "एवंविधेन तपसा तस्य भक्त्या च भारत।\nमहेश्वरः प्रसन्नात्मा चकार मनसा मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085854, "chapter_id": 2826, "verse_number": "१२-३३१-२७", "content_sanskrit": "`ततस्तस्य महादेवो दर्शयामास साम्बिकः।\nउवाच चैवं भगवांख्यम्बकः प्रहसन्निव।\nएवंविधस्ते तनयो द्वैपायन भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085855, "chapter_id": 2826, "verse_number": "१२-३३१-२८", "content_sanskrit": "यथा ह्यग्निर्यथा वायुर्यथा भूमिर्यथा जलम्।\nयथाऽऽकारास्तथा शुद्धो भविता ते सुतो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085856, "chapter_id": 2826, "verse_number": "१२-३३१-२९", "content_sanskrit": "तद्भावभावी तद्बुद्धिस्तदाऽऽत्मा तदपाश्रयः।\nतेजसाऽऽवृत्य लोकांस्त्रीन्यशः प्राप्स्यति ते सुतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2085857, "chapter_id": 2826, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकत्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]