[{"id": 2046865, "chapter_id": 2040, "verse_number": "६-८९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046866, "chapter_id": 2040, "verse_number": "६-८९-१", "content_sanskrit": "दृष्ट्वा मे निहतान्पुत्रान्बहूनेकेन सञ्जय ।\nभीष्मो द्रोणः कृपश्चैव किमकुर्वत संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046867, "chapter_id": 2040, "verse_number": "६-८९-२", "content_sanskrit": "अहन्यहनि मे पुत्राः क्षयं गच्छन्ति सञ्जय ।\nमन्येऽहं सर्वथा पुत्रान्दैवेनोपहतान्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046868, "chapter_id": 2040, "verse_number": "६-८९-३", "content_sanskrit": "यत्र मे तनयाः सर्वे जीयन्ते न जयन्त्युत ।\nयत्र भीष्मस्य द्रोणस्य कृपस्य च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046869, "chapter_id": 2040, "verse_number": "६-८९-४", "content_sanskrit": "सौमदत्तेश्च वीरस्य भगदत्तस्य चोभयोः ।\nअश्वत्थाम्नस्तथा तात शूराणामनिवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046870, "chapter_id": 2040, "verse_number": "६-८९-५", "content_sanskrit": "अन्येषां चैव शूराणां मध्यगास्तनया मम ।\nयदहन्यन्त संग्रामे किमन्यद्भागधेयतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046871, "chapter_id": 2040, "verse_number": "६-८९-६", "content_sanskrit": "न हि दुर्योधनो मन्दः पुरा प्रोक्तमबुध्यत ।\nवार्यमाणो मया तात भीष्मेण विदुरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046872, "chapter_id": 2040, "verse_number": "६-८९-७", "content_sanskrit": "गन्धार्या चैव दुर्मेधाः सततं हितकाम्यया ।\nनाबुध्यत पुरा मोहात्तस्य प्राप्तमिदं फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046873, "chapter_id": 2040, "verse_number": "६-८९-८", "content_sanskrit": "यद्भीमसेनः समरे पुत्रान्मम विचेतसः ।\nअहन्यहनि संक्रुद्धो नयते यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046874, "chapter_id": 2040, "verse_number": "६-८९-९", "content_sanskrit": "इदं तत्समनुप्राप्तं क्षत्तुर्वचनमुत्तमम् ।\nन बुद्धवानस्मि विभो प्रोच्यमानमिदं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046875, "chapter_id": 2040, "verse_number": "६-८९-१०", "content_sanskrit": "निवारय सुतं द्यूतात्पाण्डवान्मा द्रुहेति च ।\nसुहृदां हितकामानां ब्रुवतां तत्तदेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046876, "chapter_id": 2040, "verse_number": "६-८९-११", "content_sanskrit": "न शृणोमि पुरा वाक्यं मर्त्यः पथ्यमिवौषधम् ।\nतदिदं समनुप्राप्तं वचनं साधु भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046877, "chapter_id": 2040, "verse_number": "६-८९-१२", "content_sanskrit": "विदुरद्रोणभीष्माणां तथाऽन्येषां हितैषिणाम् ।\nअकृत्वा वचनं पथ्यं क्षयं गच्छन्ति कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046878, "chapter_id": 2040, "verse_number": "६-८९-१३", "content_sanskrit": "तदेतत्समतिक्रान्तं पूर्वमेव हि सञ्जय।\nतस्मान्मे वद तत्त्वेन यथा युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046879, "chapter_id": 2040, "verse_number": "६-८९-१४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046880, "chapter_id": 2040, "verse_number": "६-८९-१४", "content_sanskrit": "मध्याह्ने मुमहारौद्रः संग्रामः समुपद्यत।\nलकक्षयकरो राजंस्तन्मे निगदतः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046881, "chapter_id": 2040, "verse_number": "६-८९-१५", "content_sanskrit": "ततः सर्वाणि सैन्यानि धर्मपुत्रस्य शासनात्।\nसंरब्धान्यभ्यवर्तन्त भीष्ममेव जिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046882, "chapter_id": 2040, "verse_number": "६-८९-१६", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च सात्यकिश्च महारथः ।\nयुक्तानीका महाराज भीष्ममेव समभ्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046883, "chapter_id": 2040, "verse_number": "६-८९-१७", "content_sanskrit": "विराटो द्रुपदश्चैव सहिताः सर्वसोमकैः ।\nअभ्यद्रवन्त संग्रामे भीष्ममेव महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046884, "chapter_id": 2040, "verse_number": "६-८९-१८", "content_sanskrit": "केकया धृष्टकेतुश्च कुन्तिभोजश्च दंशितः ।\nशुक्तानीका महाराज भीष्ममेव समभ्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046885, "chapter_id": 2040, "verse_number": "६-८९-१९", "content_sanskrit": "अर्जुनो द्रौपदश्चैव कुन्तिभोजश्च दंशितः ।\nदुर्योधनसमादिष्टान्राज्ञः सर्वान्समभ्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046886, "chapter_id": 2040, "verse_number": "६-८९-२०", "content_sanskrit": "अभिमन्युस्तथा शूरो हैडिम्बश्च महारथः ।\nभीमसेनश्च संक्रुद्धस्तेऽभ्यधावन्त कौरवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046887, "chapter_id": 2040, "verse_number": "६-८९-२१", "content_sanskrit": "त्रिधाभूतैरवध्यन्त पाण्डवैः कौरवा युधि।\nतथैव कौरवै राजन्नवध्यन्त परे रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046888, "chapter_id": 2040, "verse_number": "६-८९-२२", "content_sanskrit": "द्रोणस्तु रथिनां श्रेष्ठः सोमकान्सृञ्जयैः सह ।\nअभ्यधावत संक्रुद्धः प्रेषयिष्यन्यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046889, "chapter_id": 2040, "verse_number": "६-८९-२३", "content_sanskrit": "तत्राक्रन्दो महानासीत्सृञ्जयानां महात्मानाम् ।\nवध्यतां समरे राजन्भारद्वाजेन धन्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046890, "chapter_id": 2040, "verse_number": "६-८९-२४", "content_sanskrit": "द्रोणेन निहतास्तत्र क्षत्रिया बहवो रणे।\nविचेष्टन्तो हृदृश्यन्त व्याधिक्लिष्टा वरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046891, "chapter_id": 2040, "verse_number": "६-८९-२५", "content_sanskrit": "कूजतां क्रन्दतां चैव स्तनतां चैव भारत।\nअनिशं शुश्रुवे शब्दः क्षुत्क्लिष्टानां नृणामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046892, "chapter_id": 2040, "verse_number": "६-८९-२६", "content_sanskrit": "तथैव कौरवेयाणां भीमसेनो महाबलः ।\nचकार कदनं घोरं क्रुद्धः काल इवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046893, "chapter_id": 2040, "verse_number": "६-८९-२७", "content_sanskrit": "वध्यतां तत्र सैन्यानामन्योन्येन महारणे ।\nप्रावर्तत नदी घोरा रुधिरौघपरवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046894, "chapter_id": 2040, "verse_number": "६-८९-२८", "content_sanskrit": "स संग्रामो महाराज घोररूपोऽभवन्महान् ।\nकुरूणां पाणडवानां च यमराष्ट्रविवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046895, "chapter_id": 2040, "verse_number": "६-८९-२९", "content_sanskrit": "ततो भीमो रणे क्रुद्धो रभसश्च विशेषतः।\nगजानीकं समासाद्य प्रेषयामास मृत्यवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046896, "chapter_id": 2040, "verse_number": "६-८९-३०", "content_sanskrit": "तत्र भारत भीमेन नाराचाभिहता गजाः ।\nपेतुर्नेदुश्च सेदुश्च दिशश्च परिबभ्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046897, "chapter_id": 2040, "verse_number": "६-८९-३१", "content_sanskrit": "छिन्नहस्ता महानागाश्छिन्नगात्राश्च मारिष ।\nक्रौञ्चवद्व्यनदन्भीताः पृथिवीमधिशेरते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046898, "chapter_id": 2040, "verse_number": "६-८९-३२", "content_sanskrit": "नकुलः सहदेवश्च हयानीकमभिद्रुतौ।\nते हयाः काञ्चनापीडा रुक्मभाण्डपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046899, "chapter_id": 2040, "verse_number": "६-८९-३३", "content_sanskrit": "वध्यमाना व्यदृश्यन्त शतशोऽथ सहस्रशः।\nपतिद्भिस्तुरगै राजन्समास्तीर्यत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046900, "chapter_id": 2040, "verse_number": "६-८९-३४", "content_sanskrit": "निर्जिह्वैश्च श्वसद्भिश्च कूजद्भिश्च गतासुभिः ।\nहयैर्बभौ नरश्रेष्ठ नानारूपधरैर्धरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046901, "chapter_id": 2040, "verse_number": "६-८९-३५", "content_sanskrit": "अर्जुनेन हतैः सङ्ख्ये तथा भारत राजभिः ।\nप्रबभौ वसुधा घोरा तत्रतत्र विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046902, "chapter_id": 2040, "verse_number": "६-८९-३६", "content_sanskrit": "रथैर्भग्नैर्ध्वजैश्छिन्नैर्निकृत्तैश्च महायुधैः ।\nचामरैर्व्यजनैश्चैव च्छत्रैश्च सुमहाप्रभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046903, "chapter_id": 2040, "verse_number": "६-८९-३७", "content_sanskrit": "हरैर्निष्कैः सकेयूरैः शिरोभिश्च सकुण्डलैः ।\nउष्णीषैरपविद्धैश्च पताकाभिश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046904, "chapter_id": 2040, "verse_number": "६-८९-३८", "content_sanskrit": "अनुकर्षैः शुभै राजन्योक्रैश्चैव सरश्मिभिः ।\nसंकीर्णा वसुधा भाति वसन्ते कुसुमैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046905, "chapter_id": 2040, "verse_number": "६-८९-३९", "content_sanskrit": "एवमेष क्षयो वृत्तः पाण्डूनामपि भारत।\nक्रुद्धे शान्तनवे भीष्मे द्रोणे च रथसत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046906, "chapter_id": 2040, "verse_number": "६-८९-४०", "content_sanskrit": "अश्वत्थाम्नि कृपे चैव तथैव कृतवर्मणि।\nतथेतरेषु क्रुद्धेषु तावकानामपि क्षयः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046907, "chapter_id": 2040, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभरते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे एकोननवतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-८९-२५ कूजतां अव्यक्तं ध्वनताम्। स्तनतां उच्चैः शब्दायमानानाम् ॥ ६-८९-३७ निष्कैरुरोभूषणैः ॥ ६-८९-३८ योक्रैरीषायोजनरज्जुभिः रश्मिभिरश्वबन्धनरज्जुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]