[{"id": 7004530000, "chapter_id": 24530, "verse_number": "५-३-२२४-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nततः क्रोशान्तरे पार्थ तीर्थं कोटीश्वरं परम् ।\nयत्र स्नानं च दानं च जपहोमार्चनादिकम् ।\nभक्त्या कृतं नरैस्तत्र सर्वं कोटिगुणं भवेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004530001, "chapter_id": 24530, "verse_number": "५-३-२२४-२", "content_sanskrit": "तत्र देवाः सगन्धर्वा ऋषयः सिद्धचारणाः ।\nजलधिं प्रतिगच्छन्ति नर्मदां वीक्षितुं किल॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004530002, "chapter_id": 24530, "verse_number": "५-३-२२४-३", "content_sanskrit": "मिलिताः कोटिशो राजन्रेवासागरसङ्गमे ।\nविनोदमतुलं दृष्ट्वा रेवार्णवसमागमे॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004530003, "chapter_id": 24530, "verse_number": "५-३-२२४-४", "content_sanskrit": "स्नात्वा शिवं च संस्थाप्य पूजयित्वा महेश्वरम् ।\nकोटीश्वराभिधानं तु स्वस्वभक्त्या विधानतः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004530004, "chapter_id": 24530, "verse_number": "५-३-२२४-५", "content_sanskrit": "कोटीतीर्थे परां सिद्धिं सम्प्राप्ताः सर्वतोषणात् ।\nतेन तत्पुण्यमतुलं सर्वतीर्थेषु चोत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004530005, "chapter_id": 24530, "verse_number": "५-३-२२४-६", "content_sanskrit": "तत्र तीर्थे तु यत्किंचिच्छुभं वा यदि वाशुभम् ।\nक्रियते नृपशार्दूल सर्वं कोटिगुणं भवेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004530006, "chapter_id": 24530, "verse_number": "५-३-२२४-७", "content_sanskrit": "तत्र तीर्थे तु मार्गस्था ये केचिदृषिसत्तमाः ।\nसिद्धामृतपदं यान्ति पितृलोकं तथोत्तमम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004530007, "chapter_id": 24530, "verse_number": "५-३-२२४-८", "content_sanskrit": "उत्तरे नर्मदातीरे दक्षिणे चाश्रिताश्च ये ।\nदेवलोकं गतास्तत्र इति मे निश्चिता मतिः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004530008, "chapter_id": 24530, "verse_number": "५-३-२२४-९", "content_sanskrit": "बिल्वार्कपुष्पैर्धत्तूरकुशकाशप्रसूनकैः ।\nऋतूद्भवैस्तथान्यैश्च पूजयित्वा महेश्वरम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004530009, "chapter_id": 24530, "verse_number": "५-३-२२४-१०", "content_sanskrit": "नानोपचारैर्विधिवन्मन्त्रपूर्वं युधिष्ठिर ।\nधूपदीपार्धनैवेद्यैस्तोषयित्वा च धूर्जटिम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004530010, "chapter_id": 24530, "verse_number": "५-३-२२४-११", "content_sanskrit": "शिवलोकमवाप्नोति यावदिन्द्राश्चतुर्दश ।\nपौषकृष्णाष्टमीयोगे विशेषः पूजने स्मृतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004530011, "chapter_id": 24530, "verse_number": "५-३-२२४-१२", "content_sanskrit": "नित्यं च नृपतिश्रेष्ठ चतुर्दश्यष्टमीषु च ।\nशिवमभ्यर्च्य विप्रांश्च भोजयेद्भक्तितो वरान्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]