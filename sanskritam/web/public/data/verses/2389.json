[{"id": 2065675, "chapter_id": 2389, "verse_number": "९-७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065676, "chapter_id": 2389, "verse_number": "९-७-१", "content_sanskrit": "व्यतीतायां रजन्यां तु राजा दुर्योधनस्तदा।\nअब्रवीत्तावकान्सर्वान्सन्नह्यन्तां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065677, "chapter_id": 2389, "verse_number": "९-७-२", "content_sanskrit": "राज्ञश्च मतमाज्ञाय समनह्यत सा चमूः।\nअयोजयन्रथांस्तूर्णं पर्यधावंस्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065678, "chapter_id": 2389, "verse_number": "९-७-३", "content_sanskrit": "अकल्प्यन्त च मातङ्गाः समनह्यन्त पत्तयः।\nहयानास्तरणोपेतांश्चक्रुरन्ये सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065679, "chapter_id": 2389, "verse_number": "९-७-४", "content_sanskrit": "वादित्राणां च निनदः प्रादुरासीद्विशाम्पते।\nयोधानां सैन्यमुख्यानामन्योन्यं प्रतिगर्जताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065680, "chapter_id": 2389, "verse_number": "९-७-५", "content_sanskrit": "ततो बलानि सर्वाणि हतशिष्टानि भारत।\nसन्नद्धानि व्यदृश्यन्त मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065681, "chapter_id": 2389, "verse_number": "९-७-६", "content_sanskrit": "शल्यं सेनापतिं कृत्वा मद्रराजं महारथाः।\nप्रविभज्य बलं सर्वमनीकेषु व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065682, "chapter_id": 2389, "verse_number": "९-७-७", "content_sanskrit": "ततः सर्वे समागम्य पुत्रेण तव सैनिकाः।\nकृपश्च कृतवर्मा च द्रौणिः शल्योऽथ सौबलः।\nअन्ये च पार्थिवाः शेषाः समयं चक्रुरादृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065683, "chapter_id": 2389, "verse_number": "९-७-८", "content_sanskrit": "`अद्याचार्यसुतो द्रौणिर्नैको युध्येत शत्रुभिः।\nन न एकेन योद्धव्यं कथञ्चिदपि पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065684, "chapter_id": 2389, "verse_number": "९-७-९", "content_sanskrit": "यो ह्येकः पाण्डवैर्युध्येद्यो वा युध्यन्तमुत्सृजेत्।\nस पञ्चभिर्भवेद्युक्तः पातकैश्चोपपातकैः।\nअन्योन्यं परिरक्षद्भिर्योद्धव्यं सहितैश्च नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065685, "chapter_id": 2389, "verse_number": "९-७-१०", "content_sanskrit": "एवं ते समयं कृत्वा सर्वे तत्र महारथाः।\nमद्रराजं पुरस्कृत्य तूर्णमभ्यद्रवन्परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065686, "chapter_id": 2389, "verse_number": "९-७-११", "content_sanskrit": "तथैव पाण्डवा राजन्व्यूह्य सैन्यं महारणे।\nअभ्ययुः कौरवान्युद्धे योत्स्यमानाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065687, "chapter_id": 2389, "verse_number": "९-७-१२", "content_sanskrit": "ततो बलं समभवत्क्षुब्धार्णवसमस्वनम्।\nसमुद्भूतार्णवाकारमुदीर्णरथकुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065688, "chapter_id": 2389, "verse_number": "९-७-१३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065689, "chapter_id": 2389, "verse_number": "९-७-१३", "content_sanskrit": "द्रोणस्य चैव भीष्मस्य राधेयस्य च मे श्रुतम्।\nपातनं शंस मे भूयः शल्यस्याथ सुतस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065690, "chapter_id": 2389, "verse_number": "९-७-१४", "content_sanskrit": "कथं रणे हतः शल्यो धर्मराजेन सञ्जय।\nभीमेन च महाबाहुः पुत्रो दुर्योधनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065691, "chapter_id": 2389, "verse_number": "९-७-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065692, "chapter_id": 2389, "verse_number": "९-७-१५", "content_sanskrit": "क्षयं मनुष्यदेहानां तथा नागाश्वसङ्क्षयम्।\nशृणु राजन्स्थिरो भूत्वा सङ्ग्रामं शंसतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065693, "chapter_id": 2389, "verse_number": "९-७-१६", "content_sanskrit": "आशा बलवती राजन्पुत्राणां तेऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065694, "chapter_id": 2389, "verse_number": "९-७-१७", "content_sanskrit": "हते द्रोणे च भीष्मे च सूतपुत्रे च पातिते।\nशल्यः पार्थान्रणे सर्वान्निहनिष्यति मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065695, "chapter_id": 2389, "verse_number": "९-७-१८", "content_sanskrit": "तामाशां हृदये कृत्वा समाश्वस्य च भारत।\nमद्रराजं च समरे समाश्रित्य महारथम्।\nनाथवन्तं तदाऽऽत्मानममन्यत सुतस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065696, "chapter_id": 2389, "verse_number": "९-७-१९", "content_sanskrit": "यदा कर्णे हते पार्थाः सिंहनादं प्रचक्रिरे।\nतदा राजन्धार्तराष्ट्रान्प्रविवेश महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065697, "chapter_id": 2389, "verse_number": "९-७-२०", "content_sanskrit": "तान्समाश्वास्य तु तदा मद्रराजः प्रतापवान्।\nव्यूह्य व्यूहं महाराज सर्वतोभद्रमृद्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065698, "chapter_id": 2389, "verse_number": "९-७-२१", "content_sanskrit": "प्रत्युद्ययौ रणे पार्थान्मद्रराजः प्रतापवान्।\nविधून्वन्कार्मुकं चित्रं भारघ्नं वेगवत्तरम्।\nरथप्रवरमास्थाय सैन्धवाश्वं महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065699, "chapter_id": 2389, "verse_number": "९-७-२२", "content_sanskrit": "तस्य सूतो महाराज रथस्थोऽशोभयद्रथम्।\nस तेन संवृतो वीरो रथेनामित्रकर्शनः।\nतस्थौ शूरो महाराज पुत्राणां ते भयप्रणुत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065700, "chapter_id": 2389, "verse_number": "९-७-२३", "content_sanskrit": "प्रयाणे मद्रराजोऽभून्मुखं व्यूहस्य दंशितः।\nमद्रकैः सहितो वीरैः कर्णपुत्रैश्च दुर्जयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065701, "chapter_id": 2389, "verse_number": "९-७-२४", "content_sanskrit": "सव्येऽभूत्कृतवर्मा च त्रिगर्तैः परिवारितः।\nगौतमो दक्षिणे पार्श्वे शकैश्च यवनैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065702, "chapter_id": 2389, "verse_number": "९-७-२५", "content_sanskrit": "अश्वत्थामा पृष्ठतोऽभूत्काम्भोजैः परिवारितः।\nदुर्योधनोऽभवन्मध्ये रक्षितः कुरुपुङ्गवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065703, "chapter_id": 2389, "verse_number": "९-७-२६", "content_sanskrit": "हयानीकेन महता सौबलश्चापि संवृतः।\nप्रययौ सर्वसैन्येन कैतव्यश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065704, "chapter_id": 2389, "verse_number": "९-७-२७", "content_sanskrit": "पाण्डवाश्च महेष्वासा व्यूह्य सैन्यमरिन्दमाः।\nत्रिधाभूता महाराज तव सैन्यमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065705, "chapter_id": 2389, "verse_number": "९-७-२८", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च सात्यकिस्च महारथः।\nशल्यस्य वाहिनीं हन्तुमभिदुद्रुवुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065706, "chapter_id": 2389, "verse_number": "९-७-२९", "content_sanskrit": "ततो युधिष्ठिरो राजा स्वेनानीकेन संवृतः।\nशल्यमेवाभिदुद्राव जिघांसुर्भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065707, "chapter_id": 2389, "verse_number": "९-७-३०", "content_sanskrit": "हार्दिक्यं च महेष्वासमर्जुनः शत्रुपूगहा।\nसंशप्तकगणांश्चैव वेगितोऽभिविदुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065708, "chapter_id": 2389, "verse_number": "९-७-३१", "content_sanskrit": "गौतमं भीमसेनो वै सोमकाश्च महारथाः।\nअभ्यद्रवन्त राजेनद्र जिघांसन्तः परान्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065709, "chapter_id": 2389, "verse_number": "९-७-३२", "content_sanskrit": "माद्रीपुत्रौ तु शकुनिमुलूकं च महारथम्।\nससैन्यौ सहसैन्यौ तावुपतस्थतुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065710, "chapter_id": 2389, "verse_number": "९-७-३३", "content_sanskrit": "तथैवायुतशो योधास्तावकाः पाण्डवान्रणे।\nअभ्यवर्तन्त सङ्क्रुद्धा विविधायुधपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065711, "chapter_id": 2389, "verse_number": "९-७-३४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065712, "chapter_id": 2389, "verse_number": "९-७-३४", "content_sanskrit": "हते भीष्मे हमेष्वासे द्रोणे कर्णे जयद्रथे।\nकुरुष्वल्पावशिष्टेषु पाण्डवेषु च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065713, "chapter_id": 2389, "verse_number": "९-७-३५", "content_sanskrit": "संरब्धेषु च पार्थेषु पराक्रान्तेषु सञ्जय।\nमामकानां परेषां च किं शिष्टमभवद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065714, "chapter_id": 2389, "verse_number": "९-७-३६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065715, "chapter_id": 2389, "verse_number": "९-७-३६", "content_sanskrit": "यथा वयं परे राजन्युद्धाय समुपस्थिताः।\nयावच्चासीद्बलं शिष्टं सङ्ग्रामे तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065716, "chapter_id": 2389, "verse_number": "९-७-३७", "content_sanskrit": "एकादश सहस्राणि रथानां भरतर्षभ।\nदश दन्तिसहस्राणि सप्त चैव शतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065717, "chapter_id": 2389, "verse_number": "९-७-३८", "content_sanskrit": "पूर्णे शतसहस्रे द्वे हयानां तत्र भारत।\nपत्तिकोट्यस्तथा तिस्रो बलमेतत्तवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065718, "chapter_id": 2389, "verse_number": "९-७-३९", "content_sanskrit": "रथानां षट्सहस्राणि षट्सहस्राश्च कुञ्जराः।\nदश चाश्वसहस्राणि पत्तिकोटी च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065719, "chapter_id": 2389, "verse_number": "९-७-४०", "content_sanskrit": "एतद्बलं पाण्डवानामभवच्छेषमाहवे।\nएत एव समाजग्मुर्युद्वाय भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065720, "chapter_id": 2389, "verse_number": "९-७-४१", "content_sanskrit": "एवं विभज्य राजेन्द्र मद्रराजमते स्थिताः।\nपाण्डवान्प्रत्युदीयाम जयगृद्धाः प्रमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065721, "chapter_id": 2389, "verse_number": "९-७-४२", "content_sanskrit": "तथैव पाण़्डवाः शूराः समरे जितकाशिनः।\nउपयाता नरव्याघ्राः पाञ्चालाश्च यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065722, "chapter_id": 2389, "verse_number": "९-७-४३", "content_sanskrit": "एवमेते बलौघेन परस्परवधैषिणः।\nउपयाता नरव्याघ्राः पूर्वां सन्ध्यां प्रति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065723, "chapter_id": 2389, "verse_number": "९-७-४४", "content_sanskrit": "ततः प्रववृते युद्धं घोररूपं भयानकम्।\nतावकानां परेषां च निघ्नतामितरेतरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065724, "chapter_id": 2389, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि सप्तमोऽध्यायः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]