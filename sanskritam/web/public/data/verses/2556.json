[{"id": 2073738, "chapter_id": 2556, "verse_number": "१२-६१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073739, "chapter_id": 2556, "verse_number": "१२-६१-१", "content_sanskrit": "पुनः शिवान्महोदर्कानहिंस्रांल्लोकसंमतान्।\nब्रूहि धर्मान्सुखोपायान्मद्विधानां सुखावहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073740, "chapter_id": 2556, "verse_number": "१२-६१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073741, "chapter_id": 2556, "verse_number": "१२-६१-२", "content_sanskrit": "ब्राह्मणस्य तु चत्वारस्त्वाश्रमा विहिताः प्रभो।\nवर्णास्तान्नानुवर्तन्ते त्रयो भारतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073742, "chapter_id": 2556, "verse_number": "१२-६१-३", "content_sanskrit": "उक्तानि कर्माणि बहूनि राज\nन्स्वर्ग्याणि राजन्यपरायणानि।\nशास्त्रस्य सर्वस्य विधौ स्मृतानि\nक्षात्रे हि सर्वं विहितं यथावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073743, "chapter_id": 2556, "verse_number": "१२-६१-४", "content_sanskrit": "क्षात्राणि वैश्यानि च सेवमानः\nशौद्राणि कर्माणि च ब्राह्मणः सत्।\nअस्मिँल्लोके निन्दितो मन्दचेताः।\nपरे च लोके निरयं प्रयाति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073744, "chapter_id": 2556, "verse_number": "१२-६१-५", "content_sanskrit": "या संज्ञा विहिता लोके दासे शुनि वृके पशौ।\nविकर्मणि स्थिते विप्रे तां संज्ञां कुरु पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073745, "chapter_id": 2556, "verse_number": "१२-६१-६", "content_sanskrit": "षट्कर्मसंप्रवृत्तस्य आश्रमेषु चतुर्ष्वपि।\nसर्वधर्मोपपन्नस्य तद्भूतस्य कृतात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073746, "chapter_id": 2556, "verse_number": "१२-६१-७", "content_sanskrit": "ब्राह्मणस्य विशुद्धस्य तपस्यभिरतस्य च।\nनिराशिषो वदान्यस्य लोका ह्यक्षरसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073747, "chapter_id": 2556, "verse_number": "१२-६१-८", "content_sanskrit": "यो यस्मिन्कुरुते कर्म यादृशं येन यत्र च।\nतादृशं तादृशेनैव सगुणं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073748, "chapter_id": 2556, "verse_number": "१२-६१-९", "content_sanskrit": "वृद्ध्या कृषिवणिक्त्वेन जीवसंजीवनेन च।\nवेत्तुमर्हसि राजेन्द्र स्वाध्यात्मगुणितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073749, "chapter_id": 2556, "verse_number": "१२-६१-१०", "content_sanskrit": "कालसंचोदितः काले कालपर्यायनिश्चितः।\nउत्तमाधममध्यानि कर्माणि कुरुतेऽवशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073750, "chapter_id": 2556, "verse_number": "१२-६१-११", "content_sanskrit": "अन्तवन्ति प्रदानानि परं श्रेयस्कराणि च।\nस्वकर्मविहितो लोको ह्यक्षरः सर्वतोमुखः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073751, "chapter_id": 2556, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकषष्टितमोऽध्यायः॥ ६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]