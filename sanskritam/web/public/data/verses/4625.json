[{"id": 2169437, "chapter_id": 4625, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169438, "chapter_id": 4625, "verse_number": "१", "content_sanskrit": "तथा व्यूढेष्वनीकेषु संसक्तेषु च सञ्जय ।\nसंशप्तकान् कथं पार्थो गतः कर्णश्च पाण्डवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169439, "chapter_id": 4625, "verse_number": "२", "content_sanskrit": "एतद् विस्तरतो युद्धं प्रब्रूहि कुशलो ह्यसि ।\nन हि तृप्यामि वीराणां शृण्वानो विक्रमान् रणे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169440, "chapter_id": 4625, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169441, "chapter_id": 4625, "verse_number": "३", "content_sanskrit": "तदास्थितमवज्ञाय प्रत्यमित्रबलं महत्  ।\nअव्यूहतार्जुनो व्यूहं पुत्रस्य तव दुर्नये\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169442, "chapter_id": 4625, "verse_number": "४", "content_sanskrit": "तत्सादिनागकलिलं पदातिरथसङ्कुलम् ।\nधृष्टद्युम्नमुखैर्व्यूढमशोभत महद् बलम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169443, "chapter_id": 4625, "verse_number": "५", "content_sanskrit": "पारावतसवर्णाश्वश्चन्द्रादित्यसमद्युतिः ।\nपार्षतः प्रबभौ धन्वी कालो विग्रहवानिव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169444, "chapter_id": 4625, "verse_number": "६", "content_sanskrit": "पार्षतं त्वभि सन्तस्थुर्द्रौपदेया युयुत्सवः ।\nदिव्यवर्मायुधभृतः शार्दूलसमविक्रमाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169445, "chapter_id": 4625, "verse_number": "७", "content_sanskrit": "सानुगा भीमवपुषश्चन्द्रं तारागणा इव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169446, "chapter_id": 4625, "verse_number": "८", "content_sanskrit": "अथ व्यूढेष्वनीकेषु प्रेक्ष्य संशप्तकान् रणे ।\nक्रुद्धोऽर्जुनोऽभिदुद्राव व्याक्षिपन् गाण्डिवं धनुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169447, "chapter_id": 4625, "verse_number": "९", "content_sanskrit": "अथ संशप्तकाः पार्थमभ्यधावन् वधैषिणः ।\nविजये कृतसङ्कल्पा मृत्युं कृत्वा निवर्तनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169448, "chapter_id": 4625, "verse_number": "१०", "content_sanskrit": "तदश्वसङ्घबहुलं मत्तनागरथाकुलम् ।\nपत्तिमच्छूरवीरौघैर्द्रुतमर्जुनमाद्रवत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169449, "chapter_id": 4625, "verse_number": "११", "content_sanskrit": "स सम्प्रहारस्तुमुलस्तेषामासीत् किरीटिना ।\nतस्यैव नः श्रुतो यादृङ्निवातकवचैः सह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169450, "chapter_id": 4625, "verse_number": "१२", "content_sanskrit": "रथानश्वान् ध्वजान् नागान् पत्तीन् रथपतीनपि ।\nइषून् धनूंषि खड्गांश्च चक्राणि च परश्वधान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169451, "chapter_id": 4625, "verse_number": "१३", "content_sanskrit": "सायुधानुद्यतान् बाहूनुद्यतान्यायुधानि च ।\nचिच्छेद द्विषतां पार्थः शिरांसि च सहस्रशः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169452, "chapter_id": 4625, "verse_number": "१४", "content_sanskrit": "तस्मिन् सैन्ये महावर्ते पातालावर्तसन्निभे ।\nनिमग्नं तं रथं मत्वा नेदुः संशप्तका मुदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169453, "chapter_id": 4625, "verse_number": "१५", "content_sanskrit": "स पुरस्तादरीन् हत्वा पुनरुत्तरतोवधीत् ।\nपश्चाद् दक्षिणतश्चैव क्रुद्धो रुद्रः पशूनिव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169454, "chapter_id": 4625, "verse_number": "१६", "content_sanskrit": "अथ पाञ्चालचेदीनां सृञ्जयानां च मारिष ।\nत्वदीयैः सह सङ्ग्राम आसीत्परमदारुणः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169455, "chapter_id": 4625, "verse_number": "१७", "content_sanskrit": "कृपश्च कृतवर्मा च शकुनिश्चापि सौबलः ।\nहृष्टसेनाः सुसंरब्धा रथानीकप्रहारिणः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169456, "chapter_id": 4625, "verse_number": "१८", "content_sanskrit": "कोसलैः काशिमत्स्यैश्च कारूषैः केकयैरपि ।\nशूरसेनैः शूरवीरैर्युयुधुर्युद्धदुर्मदाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169457, "chapter_id": 4625, "verse_number": "१९", "content_sanskrit": "तेषां तदभवत् युद्धं देहपाप्मासुनाशनम् ।\nशूद्रविट्क्षत्रविप्राणां धर्म्यं स्वर्ग्यं यशस्करम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169458, "chapter_id": 4625, "verse_number": "२०", "content_sanskrit": "दुर्योधनोऽपि सहितो भ्रातृभिर्भरतर्षभ ।\nगुप्तः कुरुप्रवीरैश्च मद्राणां च महारथैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169459, "chapter_id": 4625, "verse_number": "२१", "content_sanskrit": "पाण्डवैः सहपाञ्चालैश्चेदिभिः सात्यकेन च ।\nयुध्यमानं रणे कर्णं कुरुवीरोऽभ्यपालयत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169460, "chapter_id": 4625, "verse_number": "२२", "content_sanskrit": "कर्णोऽपि निशितैर्बाणैर्विनिहत्य महाचमूम् ।\nप्रमृद्य च रथश्रेष्ठान् युधिष्ठिरमपीडयत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169461, "chapter_id": 4625, "verse_number": "२३", "content_sanskrit": "विपत्रायुधदेहासून् कृत्वा शत्रून् सहस्रशः ।\nयुक्त्वा स्वर्गयशोभ्यां च स्वेभ्यो मुदमुदावहत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169462, "chapter_id": 4625, "verse_number": "२४", "content_sanskrit": "एवं मारिष सङ्ग्रामो नरवाजिगजक्षयः ।\nकुरूणां सृञ्जयानां च देवासुरसमोऽभवत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169463, "chapter_id": 4625, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169464, "chapter_id": 4625, "verse_number": "२५", "content_sanskrit": "यत्तत्प्रविश्य पार्थानां सेनां कुर्वन् जनक्षयम् ।\nकर्णो राजानमभ्यर्च्छत्तन्ममाचक्ष्व सञ्जय\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169465, "chapter_id": 4625, "verse_number": "२६", "content_sanskrit": "के च प्रवीराः पार्थानां युधि कर्णमवारयन् ।\nकांश्च प्रमथ्याधिरथिर्युधिष्ठिरमपीडयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169466, "chapter_id": 4625, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169467, "chapter_id": 4625, "verse_number": "२७", "content_sanskrit": "धृष्टद्युम्नमुखान् पार्थान् दृष्ट्वा कर्णो व्यवस्थितान् ।\nसमभ्यधावत् त्वरितः पाञ्चालान् शत्रुकर्शनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169468, "chapter_id": 4625, "verse_number": "२८", "content_sanskrit": "तं तूर्णमभिधावन्तं पाञ्चाला जितकाशिनः ।\nप्रत्युद्ययुर्महाराज हंसा इव महार्णवम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169469, "chapter_id": 4625, "verse_number": "२९", "content_sanskrit": "ततः शङ्खसहस्राणां निस्वनो हृदयङ्गमः ।\nप्रादुरासीदुभयतो भेरीशब्दश्च दारुणः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169470, "chapter_id": 4625, "verse_number": "३०", "content_sanskrit": "नानावादित्रनादश्च द्विपाश्वरथनिस्वनः ।\nसिंहनादश्च वीराणामभवद् दारुणस्तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169471, "chapter_id": 4625, "verse_number": "३१", "content_sanskrit": "साद्रिद्रुमार्णवा भूमिः सवाताम्बुदमम्बरम् ।\nसार्केन्दुग्रहनक्षत्रा द्यौश्च व्यक्तं व्यघूर्णत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169472, "chapter_id": 4625, "verse_number": "३२", "content_sanskrit": "अति भूतानि तं शब्दं मेनिरेऽति च विव्यथुः ।\nयानि चाप्यल्पसत्त्वानि प्रायस्तानि मृतानि च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169473, "chapter_id": 4625, "verse_number": "३३", "content_sanskrit": "अथ कर्णो भृशं क्रुद्धः शीघ्रमस्त्रमुदीरयन् ।\nजघान पाण्डवीं सेनामासुरीं मघवानिव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169474, "chapter_id": 4625, "verse_number": "३४", "content_sanskrit": "स पाण्डवचमूं कर्णः प्रविश्य विसृजान् शरान् ।\nप्रभद्रकाणां प्रवरानहनत् सप्तविंशतिम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169475, "chapter_id": 4625, "verse_number": "३५", "content_sanskrit": "ततः सुपुङ्खैर्निशितै रथश्रेष्ठोऽप्यथेषुभिः ।\nअवधीत् पञ्चविंशत्या पाञ्चालान् पञ्चविंशतिम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169476, "chapter_id": 4625, "verse_number": "३६", "content_sanskrit": "सुवर्णपुङ्खैर्नाराचैः परकायविदारणैः ।\nचेदिकानवधीद् वीरः शतशोऽथ सहस्रशः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169477, "chapter_id": 4625, "verse_number": "३७", "content_sanskrit": "तं तथा समरे कर्म कुर्वाणमतिमानुषम् ।\nपरिवव्रुर्महाराज पाञ्चालानां रथव्रजाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169478, "chapter_id": 4625, "verse_number": "३८", "content_sanskrit": "ततः सन्धाय विशिखान् पञ्च भारत दुःसहान् ।\nपाञ्चालानवधीत् पञ्च कर्णो वैकर्तनो वृषा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169479, "chapter_id": 4625, "verse_number": "३९", "content_sanskrit": "भानुदेवं चित्रसेनं सेनाबिन्दुं च भारत ।\nतपनं शूरसेनं च पाञ्चालानहनत् रणे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169480, "chapter_id": 4625, "verse_number": "४०", "content_sanskrit": "पाञ्चालेषु च शूरेषु वध्यमानेषु सायकैः ।\nहाहाकारो महानासीत् पाञ्चालानां महाहवे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169481, "chapter_id": 4625, "verse_number": "४१", "content_sanskrit": "तेषां सङ्कीर्यमाणानां परिवव्रू रथा दश ।\nपुनरेव च तान् कर्णो जघानाशु पतत्रिभिः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169482, "chapter_id": 4625, "verse_number": "४२", "content_sanskrit": "चक्ररक्षौ तु कर्णस्य पुत्रौ मारिषदुर्जयौ ।\nसुषेणः सत्यसेनश्च त्यक्त्वा प्राणानयुध्यताम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169483, "chapter_id": 4625, "verse_number": "४३", "content_sanskrit": "पृष्ठगोपस्तु कर्णस्य ज्येष्ठः पुत्रो महारथः ।\nवृषसेनः स्वयं कर्णं पृष्ठतः पर्यपालयत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2169484, "chapter_id": 4625, "verse_number": "४४", "content_sanskrit": "धृष्टद्युम्नः सात्यकिश्च द्रौपदेया वृकोदरः ।\nजनमेजयः शिखण्डी च प्रवीराश्च प्रभद्रकाः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2169485, "chapter_id": 4625, "verse_number": "४५", "content_sanskrit": "चेदिकेकयपाञ्चाला यमौ मत्स्याश्च दंसिताः ।\nसमभ्यधावन् राधेयं जिघांसन्तः प्रहारिणः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2169486, "chapter_id": 4625, "verse_number": "४६", "content_sanskrit": "त एनं विविधैः शस्त्रैः शरधाराभिरेव च ।\nअभ्यवर्षन् विमृद्नन्तः प्रावृषीवाम्बुदा गिरिम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2169487, "chapter_id": 4625, "verse_number": "४७", "content_sanskrit": "पितरं तु परीप्सन्तः कर्णपुत्राः प्रहारिणः ।\nत्वदीयाश्चापरे राजन् वीरा वीरानवारयन्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2169488, "chapter_id": 4625, "verse_number": "४८", "content_sanskrit": "सुषेणो भीमसेनस्य छित्त्वा भल्लेन कार्मुकम् ।\nनाराचैः सप्तभिर्विद्ध्वा हृदि भीमं ननाद ह\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2169489, "chapter_id": 4625, "verse_number": "४९", "content_sanskrit": "अथान्यद्धनुरादाय सुदृढं भीमविक्रमः ।\nसज्यं वृकोदरः कृत्वा सुषेणस्याच्छिनद्धनुः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2169490, "chapter_id": 4625, "verse_number": "५०", "content_sanskrit": "विव्याध चैनं नवभिः क्रुद्धो नृत्यन्निवेषुभिः ।\nकर्णं च तूर्णं विव्याध त्रिसप्तत्या शितैः शरैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2169491, "chapter_id": 4625, "verse_number": "५१", "content_sanskrit": "सत्यसेनं च दशभिः साश्वसूतायुधध्वजम् ।\nपश्यतां सुहृदां मध्ये कर्णपुत्रमपातयत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2169492, "chapter_id": 4625, "verse_number": "५२", "content_sanskrit": "क्षुरप्रणुन्नं तत्तस्य शिरश्चन्द्रनिभाननम् ।\nशुभदर्शनमेवासीन्नालभ्रष्टमिवाम्बुजम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2169493, "chapter_id": 4625, "verse_number": "५३", "content_sanskrit": "हत्वा कर्णसुतं भीमस्तावकान् पुनरार्दयत् ।\nकृपहार्दिक्ययोश्छित्त्वा चापे तावप्यथार्दयत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2169494, "chapter_id": 4625, "verse_number": "५४", "content_sanskrit": "दुःशासनं त्रिभिर्विद्ध्वा शकुनिं षड्भिरायसैः ।\nउलूकं च पतत्रिं च चकार विरथावुभौ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2169495, "chapter_id": 4625, "verse_number": "५५", "content_sanskrit": "हे सुषेण हतोऽसीति ब्रुवन्नादत्त सायकम् ।\nतमस्य कर्णश्चिच्छेद त्रिभिश्चैनमताडयत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2169496, "chapter_id": 4625, "verse_number": "५६", "content_sanskrit": "अथान्यमपि जग्राह सुपर्वाणं सुतेजनम् ।\nसुषेणायासृजद्भीमस्तमप्यस्याच्छिनद् वृषः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2169497, "chapter_id": 4625, "verse_number": "५७", "content_sanskrit": "पुनः कर्णस्त्रिसप्तत्या भीमसेनं रथेषुभिः ।\nपुत्रं परीप्सन् विव्याध क्रूरं क्रूरैर्जिघांसया\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2169498, "chapter_id": 4625, "verse_number": "५८", "content_sanskrit": "सुषेणस्तु धनुर्गृह्य भारसाधनमुत्तमम् ।\nनकुलं पञ्चभिर्बाणैर्बाह्वोरुरसि चार्दयत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2169499, "chapter_id": 4625, "verse_number": "५९", "content_sanskrit": "नकुलस्तं तु विंशत्या विद्ध्वा भारसहैर्दृढैः ।\nननाद बलवन्नादं कर्णस्य भयमादधत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2169500, "chapter_id": 4625, "verse_number": "६०", "content_sanskrit": "तं सुषेणो महाराज विद्ध्वा दशभिराशुगैः ।\nचिच्छेद च धनुः शीघ्रं क्षुरप्रेण महारथः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2169501, "chapter_id": 4625, "verse_number": "६१", "content_sanskrit": "अथान्यद्धनुरादाय नकुलः क्रोधमूर्च्छितः ।\nसुषेणं बहुभिर्बाणैर्वारयामास संयुगे\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2169502, "chapter_id": 4625, "verse_number": "६२", "content_sanskrit": "स तु बाणैर्दिशो राजन्नाच्छाद्य परवीरहा ।\nआजघ्ने सारथिं चास्य सुषेणं च ततस्त्रिभिः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2169503, "chapter_id": 4625, "verse_number": "६३", "content_sanskrit": "चिच्छेद चास्य सुदृढं धनुर्भल्लैस्त्रिभिस्त्रिधा\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2169504, "chapter_id": 4625, "verse_number": "६४", "content_sanskrit": "अथान्यद्धनुरादाय सुषेणः क्रोधमूर्च्छितः ।\nअविध्यन्नकुलं षष्ट्या सहदेवं च सप्तभिः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2169505, "chapter_id": 4625, "verse_number": "६५", "content_sanskrit": "तद्युद्धं सुमहद्घोरमासीद् देवासुरोपमम् ।\nनिघ्नतां सायकैस्तूर्णमन्योन्यस्य वधं प्रति\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2169506, "chapter_id": 4625, "verse_number": "६६", "content_sanskrit": "सात्यकिर्वृषसेनस्य हत्वा सूतं त्रिभिः शरैः ।\nधनुश्चिच्छेद भल्लेन जघानाश्वांश्च सप्तभिः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2169507, "chapter_id": 4625, "verse_number": "६७", "content_sanskrit": "ध्वजमेकेषुणोन्मथ्य त्रिभिस्तं हृद्यताडयत्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2169508, "chapter_id": 4625, "verse_number": "६८", "content_sanskrit": "अथावसन्नः स्वरथे मुहूर्तात्पुनरुत्थितः ।\nस रणे युयुधानेन विसूताश्वरथध्वजः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2169509, "chapter_id": 4625, "verse_number": "६९", "content_sanskrit": "अथो जिघांसुः शैनेयं खड्गचर्मभृदभ्ययात्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2169510, "chapter_id": 4625, "verse_number": "७०", "content_sanskrit": "तस्य चाप्लवतः शीघ्रं वृषसेनस्य सात्यकिः ।\nवराहकर्णैर्दशभिरविध्यदसिचर्मणी\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2169511, "chapter_id": 4625, "verse_number": "७१", "content_sanskrit": "दुःशासनस्तु तं दृष्ट्वा विरथं व्यायुधं कृतम् ।\nआरोप्य स्वरथे तूर्णमपोवाह रणातुरम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2169512, "chapter_id": 4625, "verse_number": "७२", "content_sanskrit": "अथान्यं रथमास्थाय वृषसेनो महारथः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2169513, "chapter_id": 4625, "verse_number": "७३", "content_sanskrit": "द्रौपदेयांस्त्रिसप्तत्या युयुधानं च पञ्चभिः ।\nभीमसेनं चतुःषष्ट्या सहदेवं च पञ्चभिः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2169514, "chapter_id": 4625, "verse_number": "७४", "content_sanskrit": "नकुलं त्रिंशता बाणैः शतानीकं च सप्तभिः ।\nशिखण्डिनं च दशभिर्धर्मराजं शतेन च\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2169515, "chapter_id": 4625, "verse_number": "७५", "content_sanskrit": "एतांश्चान्यांश्च राजेन्द्र प्रवीरान् जयगृद्धिनः ।\nअभ्यर्दयन् महेष्वासः कर्णपुत्रो विशाम्पते\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2169516, "chapter_id": 4625, "verse_number": "७६", "content_sanskrit": "कर्णस्य युधि दुर्धर्षः पुनः पृष्ठमपालयत्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2169517, "chapter_id": 4625, "verse_number": "७७", "content_sanskrit": "दुःशासनं तु शैनेयो नवैर्नवभिरायसैः ।\nविसूताश्वरथं कृत्वा ललाटे त्रिभिरार्पयत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2169518, "chapter_id": 4625, "verse_number": "७८", "content_sanskrit": "स त्वन्यं रथमास्थाय विधिवत्कल्पितं पुनः ।\nयुयुधे पाण्डुभिः सार्धं कर्णस्याप्याययन्बलम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2169519, "chapter_id": 4625, "verse_number": "७९", "content_sanskrit": "धृष्टद्युम्नस्ततः कर्णमविध्यद् दशभिः शरैः ।\nद्रौपदेयास्त्रिसप्तत्या युयुधानस्तु पञ्चभिः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2169520, "chapter_id": 4625, "verse_number": "८०", "content_sanskrit": "भीमसेनश्चतुःषष्ट्या सहदेवश्च पञ्चभिः ।\nनकुलस्त्रिंशता बाणैः शतानीकश्च सप्तभिः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2169521, "chapter_id": 4625, "verse_number": "८१", "content_sanskrit": "शिखण्डी दशभिर्वीरो धर्मराजः शतेन तु\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2169522, "chapter_id": 4625, "verse_number": "८२", "content_sanskrit": "एते चान्ये च राजेन्द्र प्रवीरा जयगृद्धिनः ।\nअभ्यर्दयन् महेष्वासं सूतपुत्रं महामृधे\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2169523, "chapter_id": 4625, "verse_number": "८३", "content_sanskrit": "तान् सूतपुत्रो विशिखैर्दशभिर्दशभिः शितैः ।\nरथे चारु चरन् वीरः प्रत्यविध्यदरिन्दमः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2169524, "chapter_id": 4625, "verse_number": "८४", "content_sanskrit": "तत्रास्त्रवीर्यं कर्णस्य लाघवं च महात्मनः ।\nअपश्याम महाराज तदद्भुतमिवाभवत्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2169525, "chapter_id": 4625, "verse_number": "८५", "content_sanskrit": "न ह्याददानं ददृशुः सन्दधानं च सायकान् ।\nविमुञ्चन्तं च संरम्भाद् ददृशुस्ते महारथम्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2169526, "chapter_id": 4625, "verse_number": "८६", "content_sanskrit": "द्यौर्वियद्भूर्दिशश्चाशु प्रपूर्णा निशितैः शरैः ।\nअरुणाभ्रावृताकारं तस्मिन् देशेऽभवद्वियत्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2169527, "chapter_id": 4625, "verse_number": "८७", "content_sanskrit": "नृत्यन्निव हि राधेयश्चापहस्तः प्रतापवान् ।\nयैर्विद्धः प्रत्यविध्यत् तानेकैकं त्रिगुणैः शरैः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2169528, "chapter_id": 4625, "verse_number": "८८", "content_sanskrit": "दशभिर्दशभिश्चैनान् पुनर्विद्ध्वा ननाद ह ।\nसाश्वसूतध्वजच्छत्रांस्ततस्ते विवरं ददुः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2169529, "chapter_id": 4625, "verse_number": "८९", "content_sanskrit": "तान् प्रमृद्नन् महेष्वासान् राधेयः शरवृष्टिभिः ।\nराजानीकमसम्बाधं प्राविशच्छत्रुकर्शनः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2169530, "chapter_id": 4625, "verse_number": "९०", "content_sanskrit": "स रथान् त्रिशतान् हत्वा चेदीनामनिवर्तिनाम् ।\nराधेयो निशितैर्बाणैस्ततोऽभ्यार्च्छद् युधिष्ठिरम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2169531, "chapter_id": 4625, "verse_number": "९१", "content_sanskrit": "ततस्ते पाण्डवा राजन् शिखण्डी च ससात्यकिः ।\nराधेयात् परिरक्षन्तो राजानं पर्यवारयन्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2169532, "chapter_id": 4625, "verse_number": "९२", "content_sanskrit": "तथैव तावकाः सर्वे कर्णं दुर्वारणं रणे ।\nयत्ताः शूरा महेष्वासाः पर्यरक्षन्त सर्वशः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2169533, "chapter_id": 4625, "verse_number": "९३", "content_sanskrit": "नानावादित्रघोषाश्च प्रादुरासन्विशाम्पते ।\nसिंहनादश्च सञ्जज्ञे शूराणामनिवर्तिनाम्\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2169534, "chapter_id": 4625, "verse_number": "९४", "content_sanskrit": "ततः पुनः समाजग्मुरभीताः कुरुपाण्डवाः ।\nयुधिष्ठिरमुखाः पार्थाः सूतपुत्रमुखा वयम्\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2169535, "chapter_id": 4625, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nपञ्चचत्वारिंशोऽध्यायः ॥४५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]