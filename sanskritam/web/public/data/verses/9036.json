[{"id": 5000036000, "chapter_id": 9036, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000036001, "chapter_id": 9036, "verse_number": "१-३६-१", "content_sanskrit": "उक्तवाक्ये मुनौ तस्मिन्नुभौ राघवलक्ष्मणौ ।\nप्रतिनन्द्य कथां वीरावूचतुर्मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000036002, "chapter_id": 9036, "verse_number": "१-३६-२", "content_sanskrit": "धर्मयुक्तमिदं ब्रह्मन् कथितं परमं त्वया ।\nदुहितुः शैलराजस्य ज्येष्ठाया वक्तुमर्हसि ।\nविस्तरं विस्तरज्ञोऽसि दिव्यमानुषसम्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000036003, "chapter_id": 9036, "verse_number": "१-३६-३", "content_sanskrit": "त्रीन् पथो हेतुना केन प्लावयेल्लोकपावनी ।\nकथं गङ्गां त्रिपथगा विश्रुता सरिदुत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000036004, "chapter_id": 9036, "verse_number": "१-३६-४", "content_sanskrit": "त्रिषु लोकेषु धर्मज्ञ कर्मभिः कैः समन्विता ।\nतथा ब्रुवति काकुत्स्थे विश्वामित्रस्तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000036005, "chapter_id": 9036, "verse_number": "१-३६-५", "content_sanskrit": "निखिलेन कथां सर्वामृषिमध्ये न्यवेदयत् ।\nपुरा राम कृतोद्वाहः शितिकण्ठो महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000036006, "chapter_id": 9036, "verse_number": "१-३६-६", "content_sanskrit": "दृष्ट्वा च भगवान् देवीं मैथुनायोपचक्रमे ।\nतस्य संक्रीडमानस्य महादेवस्य धीमतः ।\nशितिकण्ठस्य देवस्य दिव्यं वर्षशतं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000036007, "chapter_id": 9036, "verse_number": "१-३६-७", "content_sanskrit": "न चापि तनयो राम तस्यामासीत् परंतप ।\nसर्वे देवाः समुद्युक्ताः पितामहपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000036008, "chapter_id": 9036, "verse_number": "१-३६-८", "content_sanskrit": "यदिहोत्पद्यते भूतं कस्तत् प्रतिसहिष्यति ।\nअभिगम्य सुराः सर्वे प्रणिपत्येदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000036009, "chapter_id": 9036, "verse_number": "१-३६-९", "content_sanskrit": "देवदेव महादेव लोकस्यास्य हिते रत ।\nसुराणां प्रणिपातेन प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000036010, "chapter_id": 9036, "verse_number": "१-३६-१०", "content_sanskrit": "न लोका धारयिष्यन्ति तव तेजः सुरोत्तम ।\nब्राह्मेण तपसा युक्तो देव्या सह तपश्चर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000036011, "chapter_id": 9036, "verse_number": "१-३६-११", "content_sanskrit": "त्रैलोक्यहितकामार्थं तेजस्तेजसि धारय ।\nरक्ष सर्वानिमाँल्लोकान् नालोकं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000036012, "chapter_id": 9036, "verse_number": "१-३६-१२", "content_sanskrit": "देवतानां वचः श्रुत्वा सर्वलोकमहेश्वरः ।\nबाढमित्यब्रवीत् सर्वान् पुनश्चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000036013, "chapter_id": 9036, "verse_number": "१-३६-१३", "content_sanskrit": "धारयिष्याम्यहं तेजस्तेजसैव सहोमया ।\nत्रिदशाः पृथिवी चैव निर्वाणमधिगच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000036014, "chapter_id": 9036, "verse_number": "१-३६-१४", "content_sanskrit": "यदिदं क्षुभितं स्थानान्मम तेजो ह्यनुत्तमम् ।\nधारयिष्यति कस्तन्मे ब्रुवन्तु सुरसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000036015, "chapter_id": 9036, "verse_number": "१-३६-१५", "content_sanskrit": "एवमुक्तास्ततो देवाः प्रत्यूचुर्वृषभध्वजम् ।\nयत्तेजः क्षुभितं ह्यद्य तद्धरा धारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000036016, "chapter_id": 9036, "verse_number": "१-३६-१६", "content_sanskrit": "एवमुक्तः सुरपतिः प्रमुमोच महाबलः ।\nतेजसा पृथिवी येन व्याप्ता सगिरिकानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000036017, "chapter_id": 9036, "verse_number": "१-३६-१७", "content_sanskrit": "ततो देवाः पुनरिदमूचुश्चापि हुताशनम् ।\nआविश त्वं महातेजो रौद्रं वायुसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000036018, "chapter_id": 9036, "verse_number": "१-३६-१८", "content_sanskrit": "तदग्निना पुनर्व्याप्तं संजातं श्वेतपर्वतम् ।\nदिव्यं शरवणं चैव पावकादित्यसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000036019, "chapter_id": 9036, "verse_number": "१-३६-१९", "content_sanskrit": "यत्र जातो महातेजाः कार्तिकेयोऽग्निसम्भवः ।\nअथोमां च शिवं चैव देवाः सर्षिगणास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000036020, "chapter_id": 9036, "verse_number": "१-३६-२०", "content_sanskrit": "पूजयामासुरत्यर्थं सुप्रीतमनसस्तदा ।\nअथ शैलसुता राम त्रिदशानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000036021, "chapter_id": 9036, "verse_number": "१-३६-२१", "content_sanskrit": "समन्युरशपत् सर्वान् क्रोधसंरक्तलोचना ।\nयस्मान्निवारिता चाहं संगता पुत्रकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000036022, "chapter_id": 9036, "verse_number": "१-३६-२२", "content_sanskrit": "अपत्यं स्वेषु दारेषु नोत्पादयितुमर्हथ ।\nअद्यप्रभृति युष्माकमप्रजाः सन्तु पत्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000036023, "chapter_id": 9036, "verse_number": "१-३६-२३", "content_sanskrit": "एवमुक्त्वा सुरान् सर्वाञ्शशाप पृथिवीमपि ।\nअवने नैकरूपा त्वं बहुभार्या भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000036024, "chapter_id": 9036, "verse_number": "१-३६-२४", "content_sanskrit": "न च पुत्रकृतां प्रीतिं मत्क्रोधकलुषीकृता ।\nप्राप्स्यसि त्वं सुदुर्मेधो मम पुत्रमनिच्छती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000036025, "chapter_id": 9036, "verse_number": "१-३६-२५", "content_sanskrit": "तान् सर्वान् पीडितान् दृष्ट्वा सुरान् सुरपतिस्तदा ।\nगमनायोपचक्राम दिशं वरुणपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000036026, "chapter_id": 9036, "verse_number": "१-३६-२६", "content_sanskrit": "स गत्वा तप आतिष्ठत् पार्श्वे तस्योत्तरे गिरेः ।\nहिमवत्प्रभवे शृङ्गे सह देव्या महेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000036027, "chapter_id": 9036, "verse_number": "१-३६-२७", "content_sanskrit": "एष ते विस्तरो राम शैलपुत्र्या निवेदितः\nगङ्गायाः प्रभवं चैव शृणु मे सहलक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000036028, "chapter_id": 9036, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]