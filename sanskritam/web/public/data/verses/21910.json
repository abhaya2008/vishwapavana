[{"id": 7001910000, "chapter_id": 21910, "verse_number": "८९-१", "content_sanskrit": "राजोवाच ।\nविचित्रमिदमाख्यातं भगवन् भवता मम ।\nदेव्याश्चरितमाहात्म्यं रक्तबीजवधाश्रितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001910001, "chapter_id": 21910, "verse_number": "८९-२", "content_sanskrit": "भूयश्चेच्छाम्यहं श्रोतुं रक्तबीजे निपातिते ।\nचकार शुम्भो यत्कर्म निशुम्भश्चातिकोपनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001910002, "chapter_id": 21910, "verse_number": "८९-३", "content_sanskrit": "ऋषिरुवाच ।\nचकार कोपमतुलं रक्तबीजे निपातिते ।\nशुम्भासुरो निशुम्भश्च हतेष्वन्येषु चाहवे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001910003, "chapter_id": 21910, "verse_number": "८९-४", "content_sanskrit": "हन्यमानं महासैन्यं विलोक्यामर्षमुद्वहन् ।\nअभ्यधावन्निशुम्भोऽथ मुख्ययासुरसेनया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001910004, "chapter_id": 21910, "verse_number": "८९-५", "content_sanskrit": "तस्याग्रतस्तथा पृष्ठे पार्श्वयोश्च महासुराः ।\nसंदष्टौष्ठपुटाः क्रुद्धा हन्तुं देवीमुपाययुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001910005, "chapter_id": 21910, "verse_number": "८९-६", "content_sanskrit": "आजगाम महावीर्यः शुम्भोऽपि स्वबलैर्वृतः ।\nनिहन्तुं चण्डिकां कोपात्कृताव युद्धं तु मातृभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001910006, "chapter_id": 21910, "verse_number": "८९-७", "content_sanskrit": "ततो युद्धमतीवासीद्देव्या शुम्भनिशुम्भयोः ।\nशरवर्षमतीवोग्रं मेघयोरिव वर्षतोः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001910007, "chapter_id": 21910, "verse_number": "८९-८", "content_sanskrit": "चिच्छेदास्ताञ्छरांस्ताभ्यां चण्डिका स्वशरोत्करैः ।\nताडयामास चाङ्गेषु शस्त्रौघैरसुरेश्वरौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001910008, "chapter_id": 21910, "verse_number": "८९-९", "content_sanskrit": "निशुम्भो निशितं खड्गं चर्म चादाय सुप्रभम् ।\nअताडयन्मूर्ध्नि सिंहं देव्या वाहनमुत्तमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001910009, "chapter_id": 21910, "verse_number": "८९-१०", "content_sanskrit": "निशुम्भो निशितं खड्गं चर्म चादाय सुप्रभम् ।\nअताडयन्मूर्ध्नि सिंहं देव्या वाहनमुत्तमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001910010, "chapter_id": 21910, "verse_number": "८९-११", "content_sanskrit": "छिन्ने चर्मणि खड्गे च शक्तिं चिक्षेप सोऽसुरः ।\nतामप्यस्य द्विधा चक्रे चक्रेणाभिमुखागताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001910011, "chapter_id": 21910, "verse_number": "८९-१२", "content_sanskrit": "कोपाध्मातो निशुम्भोऽथ शूलं जग्राह दानवः ।\nआयातं मुष्टिपातेन देवी तच्चाप्यचूर्णयत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001910012, "chapter_id": 21910, "verse_number": "८९-१३", "content_sanskrit": "अथादाय गदां सोऽपि चिक्षेप चण्डिकां प्रति ।\nसापि देव्या त्रिशूलेन भिन्ना भस्मत्वमागता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001910013, "chapter_id": 21910, "verse_number": "८९-१४", "content_sanskrit": "ततः परशुहस्तं तमायान्त दैत्यपुङ्गवम् ।\nआहत्य देवी बाणौघैरपातयत भूतले ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001910014, "chapter_id": 21910, "verse_number": "८९-१५", "content_sanskrit": "तस्मिन्निपतिते भूमौ निशुम्भे भीमविक्रमे ।\nभ्रातर्यतीव संक्रुद्धः प्रययौ हन्तुमम्बिकाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001910015, "chapter_id": 21910, "verse_number": "८९-१६", "content_sanskrit": "स रथस्थस्तथात्युच्चैर्गृहीतपरमायुधैः ।\nभुजैरष्टाभिरतुलैर्व्याप्याशेषं बभौ नभः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001910016, "chapter_id": 21910, "verse_number": "८९-१७", "content_sanskrit": "तमायान्तं समालोक्य देवी शङ्घमवादयत् ।\nज्याशब्दं चापि धनुषश्चकारातीव दुः सहम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001910017, "chapter_id": 21910, "verse_number": "८९-१८", "content_sanskrit": "पूरयामास ककुभो निजघण्टास्वनेन च ।\nसमस्तदैत्यसैन्यानां तेजोवधविधायिना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001910018, "chapter_id": 21910, "verse_number": "८९-१९", "content_sanskrit": "ततः सिंहो महानादैस्त्याजितेभमहामदैः ।\nपूरयामास गगनं गां तथैव दिशो दश ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001910019, "chapter_id": 21910, "verse_number": "८९-२०", "content_sanskrit": "ततः काली समुत्पत्य गगनं क्ष्मामताडयत् ।\nकराभ्यां तन्निनादेन प्राक्स्वनास्ते तिरोहिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001910020, "chapter_id": 21910, "verse_number": "८९-२१", "content_sanskrit": "अट्टाट्टहासमशिवं शिवदूती चकार ह ।\nतैः शब्दैरसुरास्त्रेसुः शुम्भः कोपं परं ययौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001910021, "chapter_id": 21910, "verse_number": "८९-२२", "content_sanskrit": "दुरात्मंस्तिष्ठ तिष्ठेति व्याजहाराम्बिका यदा ।\nतदा जयेत्यभिहितं देवैराकाशसंस्थितैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001910022, "chapter_id": 21910, "verse_number": "८९-२३", "content_sanskrit": "शुम्भेनागत्य या शक्तिर्मुक्ता ज्वालातिभीषणा ।\nआयान्ती वह्निकूटाभा सा निरस्ता महोल्कया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001910023, "chapter_id": 21910, "verse_number": "८९-२४", "content_sanskrit": "सिंहनादेन शुम्भस्य व्याप्तं लोकत्रयान्तरम् ।\nनिर्घातनिः स्वनो घोरो जितवानवनीपते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001910024, "chapter_id": 21910, "verse_number": "८९-२५", "content_sanskrit": "शुम्भमुक्ताञ्छरान्देवी शुम्भस्तत्प्रहिताञ्छरान् ।\nचिच्छेद स्वशरैरुग्रैः शतशोऽथ सहस्रशः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001910025, "chapter_id": 21910, "verse_number": "८९-२६", "content_sanskrit": "ततः सा चण्डिका क्रुद्धा शूलेनाभिजघान तम् ।\nस तदाभिहतो भूमौ मूर्च्छितो निपपात ह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001910026, "chapter_id": 21910, "verse_number": "८९-२७", "content_sanskrit": "ततो निशुम्भः सम्प्राप्य चेतनामात्तकार्मुकः ।\nआजघान शरैर्देवीं कालीं केसरिणं तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001910027, "chapter_id": 21910, "verse_number": "८९-२८", "content_sanskrit": "पुनश्च कृत्वा बाहूनामयुतं दनुजेश्वरः ।\nचक्रायुधेन दितिजश्छादयामास चण्डिकाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001910028, "chapter_id": 21910, "verse_number": "८९-२९", "content_sanskrit": "ततो भगवती क्रुद्धा दुर्गा दुर्गार्तिनाशिनी ।\nचिच्छेद तानि चक्राणि स्वशरैः सायकांश्च तान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001910029, "chapter_id": 21910, "verse_number": "८९-३०", "content_sanskrit": "ततो निशुम्भो वेगेन गदामादाय चण्डिकाम् ।\nअभ्यधावत वै हन्तुं दैत्यसेनासमावृतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001910030, "chapter_id": 21910, "verse_number": "८९-३१", "content_sanskrit": "तस्यापतत एवाशु गदां चिच्छेद चण्डिका ।\nखड्गेन शितधारेण स च शूलं समाददे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001910031, "chapter_id": 21910, "verse_number": "८९-३२", "content_sanskrit": "शूलहस्तं समायान्तं निशुम्भममरार्दनम् ।\nहृदि विव्याध शूलेन वेगाविद्धेन चण्डिका ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001910032, "chapter_id": 21910, "verse_number": "८९-३३", "content_sanskrit": "भिन्नस्य तस्य शूलेन हृदयान्निः सृतोऽपरः ।\nमहाबलो महावीर्यस्तिष्ठेति पुरुषो वदन् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001910033, "chapter_id": 21910, "verse_number": "८९-३४", "content_sanskrit": "तस्य निष्क्रामतो देवी प्रहस्य स्वनवत्ततः ।\nशिरश्चिच्छेद खड्गेन ततोऽसावपतद् भुवि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001910034, "chapter_id": 21910, "verse_number": "८९-३५", "content_sanskrit": "ततः सिंहश्चखादोग्रं दंष्ट्राक्षुण्णशिरोधरान् ।\nअसुरांस्तांस्तथा काली शिवदूती तथापरान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001910035, "chapter_id": 21910, "verse_number": "८९-३६", "content_sanskrit": "कौमारीशक्तिनिर्भिन्नाः केचिन्नेशुर्महासुराः ।\nब्रह्माणीमन्त्रपूतेन तोयेनान्ये निराकृताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001910036, "chapter_id": 21910, "verse_number": "८९-३७", "content_sanskrit": "माहेश्वरीत्रिशूलेन भिन्नाः पेतुस्तथापरे ।\nवाराहीतुण्डघातेन केचिच्चूर्णोकृता भुवि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001910037, "chapter_id": 21910, "verse_number": "८९-३८", "content_sanskrit": "खण्डं खण्डं च चक्रेण वैष्णव्या दानवाः कृताः ।\nवज्रेण चैन्द्रीहस्ताग्रविमुक्तेन तथापरे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001910038, "chapter_id": 21910, "verse_number": "८९-३९", "content_sanskrit": "केचिद्विनेशुरसुराः केचिन्नष्टा महाहवात् ।\nभक्षिताश्चापरे कालीशिवदूतीमृगाधिपैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]