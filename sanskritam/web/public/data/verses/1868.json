[{"id": 2039438, "chapter_id": 1868, "verse_number": "५-११३-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039439, "chapter_id": 1868, "verse_number": "५-११३-१", "content_sanskrit": "ऋषभस्य ततः शृङ्गं निपत्य द्विजपक्षिणौ।\nशाण्डिलीं ब्राह्मणीं तत्र ददृशो तपोन्विताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039440, "chapter_id": 1868, "verse_number": "५-११३-२", "content_sanskrit": "अभिवाद्य सुपर्णस्तु गालवश्चाभिपूज्य ताम्।\nतया च स्वागतेनोक्तौ विष्टरे सन्निषीदतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039441, "chapter_id": 1868, "verse_number": "५-११३-३", "content_sanskrit": "सिद्धमन्नं तया दत्तं बलिमन्त्रोपबृंहितम् ।\nभुक्त्वा तृप्तावुभौ भूमौ सुप्तौ तावनुमोहितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039442, "chapter_id": 1868, "verse_number": "५-११३-४", "content_sanskrit": "मुहूर्तात्प्रतिबुद्धस्तु सुपर्णो गमनेप्सया ।\n` तां दृष्ट्वा चारुसर्वाङ्गी तापसीं ब्रह्मचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039443, "chapter_id": 1868, "verse_number": "५-११३-५", "content_sanskrit": "ग्रहीतुं हि मनश्चक्रे रूपात्साक्षादिव श्रियम् ।\nअथ भ्रष्टतनूजाङ्गमात्मानं ददृशे खगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039444, "chapter_id": 1868, "verse_number": "५-११३-६", "content_sanskrit": "मांसपिण्डोपमोऽभूत्स मुखपादान्वितः खगः।\nगालवस्तं तथा दृष्ट्वा विमनाः पर्यपृच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039445, "chapter_id": 1868, "verse_number": "५-११३-७", "content_sanskrit": "किमिदं भवता प्राप्तमिहागमनजं फलम्।\nवासोऽयमिह कालं तु कियन्तं नौ भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039446, "chapter_id": 1868, "verse_number": "५-११३-८", "content_sanskrit": "किं नु ते मनसा ध्यातमशुभं धर्मदूषणम् ।\nन ह्ययं भवतः स्वल्पो व्यभिचारो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039447, "chapter_id": 1868, "verse_number": "५-११३-९", "content_sanskrit": "सुपर्णोऽथाब्रवीद्विप्रं प्रध्यातं वै मया द्विज ।\nइमां सिद्धामितो नेतुं तत्र यत्र प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039448, "chapter_id": 1868, "verse_number": "५-११३-१०", "content_sanskrit": "यत्र देवो महादेवो यत्र विष्णुः सनातनः ।\nयत्र धर्मश्च यज्ञश्च तत्रेयं निवसेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039449, "chapter_id": 1868, "verse_number": "५-११३-११", "content_sanskrit": "सोऽहं भगवतीं याचे प्रणतः प्रियकाम्यया।\nमयैतन्नाम प्रध्यातं मनसा शोचसा किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039450, "chapter_id": 1868, "verse_number": "५-११३-१२", "content_sanskrit": "तदेवं बहुमानात्ते मयेहानीप्सितं कृतम् ।\nसुकृतं दुष्कृतं वा त्वं माहात्म्यात्क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039451, "chapter_id": 1868, "verse_number": "५-११३-१३", "content_sanskrit": "सा तौ तदाऽब्रवीत्तुष्टा पतगेन्द्रद्विजर्षभौ।\nन भेतव्यं सुपर्णोऽसि सुपर्ण त्यज संभ्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039452, "chapter_id": 1868, "verse_number": "५-११३-१४", "content_sanskrit": "निन्दितास्मि त्वया वत्स न च निन्दां क्षमाम्यहम् ।\nलोकेभ्यः सपदि भ्रश्येद्यो मां निन्देत पापकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039453, "chapter_id": 1868, "verse_number": "५-११३-१५", "content_sanskrit": "हीनयाऽलक्षणैः सर्वैस्तथाऽनिन्दितया मया।\nआचारं प्रतिगृह्णन्त्या सिद्धिः प्राप्तेयमुत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039454, "chapter_id": 1868, "verse_number": "५-११३-१६", "content_sanskrit": "आचारः फलते धर्ममाचारः फलते धनम् ।\nआचाराच्छ्रियमाप्नोति आचारो हन्त्यलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039455, "chapter_id": 1868, "verse_number": "५-११३-१७", "content_sanskrit": "तदायुष्मन्खगपते यथेष्टं गम्यतामितः ।\nन च ते गर्हणीयाऽहं गर्हितव्याः स्त्रियः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039456, "chapter_id": 1868, "verse_number": "५-११३-१८", "content_sanskrit": "` यदि त्वमात्मनो ह्यर्थे मां चैवादातुमिच्छसि।\nतदेव नष्टदेहस्तु स्या वै त्वं पन्नगाशन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039457, "chapter_id": 1868, "verse_number": "५-११३-१९", "content_sanskrit": "तस्यैव हि प्रसादेन देवदेवस्य चिन्तनात् ।\nत्वं तु साङ्गस्तु सञ्जातः पुनरेव भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039458, "chapter_id": 1868, "verse_number": "५-११३-२०", "content_sanskrit": "भवितासि यथापूर्वं बलवीर्यसमन्वितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039459, "chapter_id": 1868, "verse_number": "५-११३-२०x", "content_sanskrit": "नारद उवाच।\nबभूवतुस्ततस्तस्य पक्षौ द्रविणवत्तरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039460, "chapter_id": 1868, "verse_number": "५-११३-२१", "content_sanskrit": "अनुज्ञातस्तु शाण्डिल्या यथागतमुपागमत् ।\nनैव चासादयामास तथारूपांस्तुरङ्गमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039461, "chapter_id": 1868, "verse_number": "५-११३-२२", "content_sanskrit": "विश्वामित्रोऽथ तं दृष्ट्वा गालवं चाध्वनि स्थितः ।\nउवाच वदतां श्रेष्ठो वैनतेयस्य सन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039462, "chapter_id": 1868, "verse_number": "५-११३-२३", "content_sanskrit": "यस्त्वया स्वयमेवार्थः प्रतिज्ञातो मम द्विज।\nतस्य कालोऽपवर्गस्य यथा वा मन्यते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039463, "chapter_id": 1868, "verse_number": "५-११३-२४", "content_sanskrit": "प्रतीक्षिष्याम्यहं कालमेतावन्तं तथा परम् ।\nयथासंसिध्यते विप्र स मार्गस्तु निशाम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039464, "chapter_id": 1868, "verse_number": "५-११३-२५", "content_sanskrit": "सुपर्णोऽथाब्रवीद्दीनं गालवं भृशदुःखितम् ।\nप्रत्यक्षं खल्विदानीं मे विश्वामित्रो यदुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039465, "chapter_id": 1868, "verse_number": "५-११३-२६", "content_sanskrit": "तदागच्छ द्विजश्रेष्ठ मन्त्रयिष्याव गालव ।\nनादत्त्वा गुरवे शक्यं कृत्स्नमर्थं त्वयाऽऽसितुम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039466, "chapter_id": 1868, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि त्रयोदशाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]