[{"id": 7003753000, "chapter_id": 23753, "verse_number": "२-१-३७-१", "content_sanskrit": "अथ शंखाभिधाननृपवृत्तान्तः ।\nभारद्वाज उवाच ।\nशृणु पार्थ प्रवक्ष्यामि कथामाश्चर्यकारिणीम् ।\nयथाऽसौ भगवानस्मिञ्छैले प्राप प्रकाशताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003753001, "chapter_id": 23753, "verse_number": "२-१-३७-२", "content_sanskrit": "श्रुताभिधानो नृपतिरस्ति हैहयवंशजः ।\nयः प्रजाः स्वा इव चिरं शशास धरणीं शुभाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003753002, "chapter_id": 23753, "verse_number": "२-१-३७-३", "content_sanskrit": "तस्य पुत्रो गुणनिधिः शंखो नाम महीपतिः ।\nपालयामास वसुधां सर्वशास्त्रविशारदः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003753003, "chapter_id": 23753, "verse_number": "२-१-३७-४", "content_sanskrit": "तस्य विष्णौ जगन्नाथे पुण्डरीकायतेक्षणे ।\nबभूव निश्चला भक्तिः परित्यक्तान्यसंश्रया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003753004, "chapter_id": 23753, "verse_number": "२-१-३७-५", "content_sanskrit": "देवदेवं जगन्नाथमनन्तं पुरुषोत्तमम् ।\nप्रगाढनिश्चयो नित्यं ध्यायन्नद्भुतवैभवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003753005, "chapter_id": 23753, "verse_number": "२-१-३७-६", "content_sanskrit": "चक्रे व्रतानि दानानि पुण्यानि विविधानि च ।\nवेदवेद्यस्य नियतं प्रीत्यर्थं मधुविद्विषः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003753006, "chapter_id": 23753, "verse_number": "२-१-३७-७", "content_sanskrit": "तमुद्दिश्यैव विदधे वाजिमेधादिकान्क्रतून् ।\nयथोक्तदक्षिणायोगात्प्रीणिताशेषभूसुरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003753007, "chapter_id": 23753, "verse_number": "२-१-३७-८", "content_sanskrit": "इष्टापूर्त्तात्मकं चक्रे कर्मजातमतन्द्रितः ।\nविन्यस्तहृदयो नित्यं केशवे भक्तवत्सले ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003753008, "chapter_id": 23753, "verse_number": "२-१-३७-९", "content_sanskrit": "स्मरत्यजस्रं गोविन्दं जपत्यच्युतमव्ययम् ।\nपूजयत्यब्जनयनं संकीर्तयति शार्ङ्गिणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003753009, "chapter_id": 23753, "verse_number": "२-१-३७-१०", "content_sanskrit": "शृणोति सततं राजा संसारार्णवतारिणीः ।\nपौराणिकैः समाख्याताः पवित्रा वैष्णवी कथाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003753010, "chapter_id": 23753, "verse_number": "२-१-३७-११", "content_sanskrit": "ब्राह्मणानर्चति स्मायं हरिप्रीत्यर्थमेव च ।\nइत्थं सर्वात्मना युक्तोऽप्यश्रान्तः पृथिवीपतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003753011, "chapter_id": 23753, "verse_number": "२-१-३७-१२", "content_sanskrit": "नापश्यच्छाश्वतैश्वर्यं स्वतन्त्रं पुरुषोत्तमम् ।\nअप्राप्य दर्शनं विष्णोः सर्वयज्ञमयात्मनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003753012, "chapter_id": 23753, "verse_number": "२-१-३७-१३", "content_sanskrit": "सशोकाक्रान्तहृदयः परां चिन्तामुपागमत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003753013, "chapter_id": 23753, "verse_number": "२-१-३७-१४", "content_sanskrit": "शंख उवाच ।\nपरः सहस्रैर्जनैरतीतदुष्कृतं बहु ।\nकृतं मया यदप्राप्तं हृषीकेशस्य दर्शनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003753014, "chapter_id": 23753, "verse_number": "२-१-३७-१५", "content_sanskrit": "उपार्जितानां तमसामनेकैः पूर्वजन्मभिः ।\nअखण्डं हि फलं विष्णोर्दर्शनं मधुघातिनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003753015, "chapter_id": 23753, "verse_number": "२-१-३७-१६", "content_sanskrit": "कथं नु यायाद्भगवान्विषयं मम नेत्रयोः ।\nकदा वा लभ्यते श्रेयस्तद्वाक्याकर्णनात्मकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003753016, "chapter_id": 23753, "verse_number": "२-१-३७-१७", "content_sanskrit": "हा धिङ्मां विहितागस्कं क्रियासाफल्यवर्जितम् ।\nनारायणकृपादूरं संसारक्लेशगोचरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003753017, "chapter_id": 23753, "verse_number": "२-१-३७-१८", "content_sanskrit": "भरद्वाज उवाच ।\nइति चिन्ताकुले तस्मिन्राज्ञि जीवितनिःस्पृहे ।\nअदृश्यमूर्तिः सर्वेषां शृण्वतामाह केशवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003753018, "chapter_id": 23753, "verse_number": "२-१-३७-१९", "content_sanskrit": "श्रीभगवानुवाच ।\nमा शोकस्य वशं यायाः शृणु वक्ष्याभि ते हितम् ।\nमदेकशरणं साधुं त्वां त्यक्ष्यामि कथं नृप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003753019, "chapter_id": 23753, "verse_number": "२-१-३७-२०", "content_sanskrit": "अयं वेंकटनामाद्रिस्त्रिषु लोकेषु विश्रुतः ।\nवैकुण्ठादपि मे राजन्नावासोऽतिप्रियावहः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003753020, "chapter_id": 23753, "verse_number": "२-१-३७-२१", "content_sanskrit": "तं गत्वा भूधरवरं तव भक्त्या तपस्यतः ।\nगते सहस्रे वर्षाणां यास्याम्यालोकनीयताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003753021, "chapter_id": 23753, "verse_number": "२-१-३७-२२", "content_sanskrit": "भवानिवोद्यतोऽगस्त्यो मम दर्शनमञ्जसा ।\nक्व वा संदृश्यते विष्णुरेवमाह चतुर्मुखम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003753022, "chapter_id": 23753, "verse_number": "२-१-३७-२३", "content_sanskrit": "वृषभाद्रौ हरिर्द्रष्टुं लभ्यते नियतात्मभिः ।\nगच्छ तत्रेति मुनये कथयामास पद्मभूः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003753023, "chapter_id": 23753, "verse_number": "२-१-३७-२४", "content_sanskrit": "अम्भोजसंभवेनेत्थमादिष्टः कुम्भसम्भवः ।\nअञ्जनाद्रौ महावासे तपस्तप्तुं समेष्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003753024, "chapter_id": 23753, "verse_number": "२-१-३७-२५", "content_sanskrit": "तस्मिन्महीधरे पुण्ये कृतवासो भवानपि ।\nआराध्य मां तपोनिष्ठो मम दर्शनमाप्स्यसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003753025, "chapter_id": 23753, "verse_number": "२-१-३७-२६", "content_sanskrit": "अथ भगवदुक्त्या शंखनृपस्य श्रीवेंकटाचलागमनम् ।\nभरद्वाज उवाच ।\nइत्याज्ञप्तो भगवता शंखो दानववैरिणा ।\nजगाम प्रीतिमतुलां धन्योस्मीति स्वचेतसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003753026, "chapter_id": 23753, "verse_number": "२-१-३७-२७", "content_sanskrit": "विन्यस्य तनयं वज्रं प्रजापालनकर्मणि ।\nगोविन्ददर्शनापेक्षी नारायणगिरिं ययौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003753027, "chapter_id": 23753, "verse_number": "२-१-३७-२८", "content_sanskrit": "तस्य शृंगे समुत्तुंगे स्वामिपुष्करिणीं शुभाम् ।\nदिव्यैः पयोभिरापूर्णामपश्यदमृतोपमैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003753028, "chapter_id": 23753, "verse_number": "२-१-३७-२९", "content_sanskrit": "अनेकसिद्धगन्धर्वदेवर्षिगणसेविताम् ।\nभवतापप्रशमनी सर्वतीर्थसमाश्रयाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003753029, "chapter_id": 23753, "verse_number": "२-१-३७-३०", "content_sanskrit": "जलकाकबकक्रौञ्चहंसकारण्डवाकुलाम् ।\nकुमुदोत्पलराजीवसौगन्धिकमनोहराम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003753030, "chapter_id": 23753, "verse_number": "२-१-३७-३१", "content_sanskrit": "तां दृष्ट्वा पद्मिनीं दिव्यां तत्तीरे विहितोटजः ।\nतोषितः स्नानपानाद्यैर्निर्विकल्पमनोगतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003753031, "chapter_id": 23753, "verse_number": "२-१-३७-३२", "content_sanskrit": "सर्वकर्माणि विन्यस्य जगदीशे जनार्दने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003753032, "chapter_id": 23753, "verse_number": "२-१-३७-३३", "content_sanskrit": "अथ भगवद्दर्शनार्थमगस्त्यस्य वेंकटाचलागमनम् ।\nजपध्यानपरो नित्यं तपस्तेपे सुदारुणम् ।\nतस्मिन्नेव मुनिः काले शासनात्परमेष्ठिनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003753033, "chapter_id": 23753, "verse_number": "२-१-३७-३४", "content_sanskrit": "अगस्त्योऽप्याससादाद्यं शैलं मुनिशतावृतः ।\nप्रतीचीं दिशमारभ्य कृतयत्नः प्रदक्षिणे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003753034, "chapter_id": 23753, "verse_number": "२-१-३७-३५", "content_sanskrit": "पश्यंस्तीर्थानि पुण्यानि बभ्राम सुचिरं गिरौ ।\nतत्र तत्र ददर्शासौ हरिदर्शनलालसान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003753035, "chapter_id": 23753, "verse_number": "२-१-३७-३६", "content_sanskrit": "विरिंचिगुहशक्रेशविष्वक्सेनादिकान्क्रमात् ।\nसनकाद्यांश्च योगीन्द्रान्नारदप्रमुखानृषीन् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003753036, "chapter_id": 23753, "verse_number": "२-१-३७-३७", "content_sanskrit": "सिद्धगन्धर्वदैतेययक्षराक्षसपन्नगान् ।\nतैस्तैः संमान्यमानोऽसौ प्रश्रयप्रियभाषणैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003753037, "chapter_id": 23753, "verse_number": "२-१-३७-३८", "content_sanskrit": "पश्यन्नाश्चर्यभूतानि सर्वाणि विचचार ह ।\nस्नात्वा तीर्थेषु सर्वेषु स्कन्दधारादिकेषु च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003753038, "chapter_id": 23753, "verse_number": "२-१-३७-३९", "content_sanskrit": "तत्र तत्रार्चयामास गोविन्दं जगतां पतिम् ।\nएवं भ्रान्त्वा गतेऽब्दानां सहस्रे मुनिसत्तमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003753039, "chapter_id": 23753, "verse_number": "२-१-३७-४०", "content_sanskrit": "नापश्यत्पुण्डरीकाक्षं चिन्ताशोकपरोऽभवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003753040, "chapter_id": 23753, "verse_number": "२-१-३७-४१", "content_sanskrit": "अथागस्त्यं प्रति गुरुवस्वाद्युक्तिः ।\nतस्मिन्काले समाजग्मुर्धिषणोशनसौ पुनः ।\nराजोपरिचरो नाम वसुश्च तमृषीश्वरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003753041, "chapter_id": 23753, "verse_number": "२-१-३७-४२", "content_sanskrit": "अस्माकं सफलं जातं जीवितं मुनिसत्तम ।\nदृष्टो भवान्यदस्माभिर्नारायण इवापरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003753042, "chapter_id": 23753, "verse_number": "२-१-३७-४३", "content_sanskrit": "ब्रह्मणा लोकनाथेन यदादिष्टा वयं मुने ।\nअच्युतालोकनपरास्तदिदं कथ्यते तव ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003753043, "chapter_id": 23753, "verse_number": "२-१-३७-४४", "content_sanskrit": "अस्ति दक्षिणदिग्भागे वेंकटोनाम भूधरः ।\nश्वेतद्वीपादपि हरेरावासोऽयमभीप्सितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003753044, "chapter_id": 23753, "verse_number": "२-१-३७-४५", "content_sanskrit": "तस्मिन्गिरावगस्त्यस्य शंखस्य च महीपतेः ।\nदर्शयिष्यति गोविन्दो निजरूपं जगद्गुरुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003753045, "chapter_id": 23753, "verse_number": "२-१-३७-४६", "content_sanskrit": "तदानीं सर्वदेवानामृषीणां यक्षरक्षसाम् ।\nअस्माकं देवदेवस्य दर्शनं संभविष्यति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003753046, "chapter_id": 23753, "verse_number": "२-१-३७-४७", "content_sanskrit": "अचिरेणैव तद्भावि ततः संत्यक्तकल्मषाः ।\nअन्वेष्टुं गच्छतागस्त्यं तस्मिन्नारायणाचले ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003753047, "chapter_id": 23753, "verse_number": "२-१-३७-४८", "content_sanskrit": "इत्याज्ञप्ता वयं धात्रा समागम्यात्र भाग्यतः ।\nदृष्टवन्तो महाभागं भवंतं भूरितेजसम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003753048, "chapter_id": 23753, "verse_number": "२-१-३७-४९", "content_sanskrit": "भवता सहिता गत्वा स्वामिपुष्करिणीतटे ।\nतमप्यालोकयिष्यामः शंखं भागवतोत्तमम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003753049, "chapter_id": 23753, "verse_number": "२-१-३७-५०", "content_sanskrit": "अथागस्त्यादिकृतश्रीवेंकटाचलस्थरम्यवस्तुदर्शनम् ।\nभरद्वाज उवाच ।\nगीष्पतिप्रमुखैरित्थमादिष्टः कुम्भसंभवः ।\nशोकजालं परित्यज्य ययौ तैः सहितो द्रुतम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003753050, "chapter_id": 23753, "verse_number": "२-१-३७-५१", "content_sanskrit": "स ददर्श महावृक्षान्फलपुष्पभरानतात् ।\nप्ररूढशाखानिकरच्छायाच्छादितदिक्तटान् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003753051, "chapter_id": 23753, "verse_number": "२-१-३७-५२", "content_sanskrit": "सिंहदंतावलव्याघ्रवराहमहिषादिकान् ।\nमृगानालोकयामास पंथानं चांतरांतरा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003753052, "chapter_id": 23753, "verse_number": "२-१-३७-५३", "content_sanskrit": "तैस्तदानीं ददृशिरे सानवोऽप्यम्बुभृद्भृतः ।\nसुवर्णरौप्यताम्रादिशोभितास्तत्र तत्र तु ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003753053, "chapter_id": 23753, "verse_number": "२-१-३७-५४", "content_sanskrit": "उच्चलच्छीकरासारनिर्वाहितदिवौकसः ।\nवेगोद्धृतशिला दृष्टाः शतशो गिरिनिर्झराः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003753054, "chapter_id": 23753, "verse_number": "२-१-३७-५५", "content_sanskrit": "तेषामापादयामास प्रमोदं मंदमारुतः ।\nकमलामोदसंवाही विचरन्गिरिसानुषु ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003753055, "chapter_id": 23753, "verse_number": "२-१-३७-५६", "content_sanskrit": "शुकानां कोकिलानां च तदा शुश्रुविरे गिरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003753056, "chapter_id": 23753, "verse_number": "२-१-३७-५७", "content_sanskrit": "तत्र तत्र समासीनान्विस्तीर्णासु दृषत्सु ते ।\nसिद्धानपश्यन्कृष्णस्य गायतो गुणवैभवम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003753057, "chapter_id": 23753, "verse_number": "२-१-३७-५८", "content_sanskrit": "अगस्त्यप्रमुखाः सर्वे परिक्रम्य मुनीश्वराः ।\nस्वामिपुष्करिणीं दिव्यां ददृशुर्विमलोदकाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003753058, "chapter_id": 23753, "verse_number": "२-१-३७-५९", "content_sanskrit": "तत्तीरे विहितावासमपश्यच्छङ्खभूपतिम् ।\nवाङ्मनःकायजं कर्म सन्निवेश्य स्थितं हरौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003753059, "chapter_id": 23753, "verse_number": "२-१-३७-६०", "content_sanskrit": "स तानालोक्य सहसा मुनीन्द्रान्संशितव्रतान् ।\nयथोक्तमकरोत्पूजां प्रणामस्तुतिपूर्विकाम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003753060, "chapter_id": 23753, "verse_number": "२-१-३७-६१", "content_sanskrit": "आसीनास्तत्र ते सर्वे संभाव्यान्योऽन्यमुत्सुकाः ।\nगोविन्दकीर्तनपराः कृतार्थत्वं प्रपेदिरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003753061, "chapter_id": 23753, "verse_number": "२-१-३७-६२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवेंकटाचलमाहात्म्ये सुवर्णमुखरीमाहात्म्यप्रशंसायां श्रीवेंकटाचलं प्रति शंखागस्त्याद्यागमनवर्णनंनाम सप्तत्रिंशोऽध्यायः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]