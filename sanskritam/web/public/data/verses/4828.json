[{"id": 2180634, "chapter_id": 4828, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180635, "chapter_id": 4828, "verse_number": "१", "content_sanskrit": "प्राप्य राज्यं महातेजा धर्मराजो युधिष्ठिरः ।\nयदन्यदकरोद् विप्र तन्मे वक्तुमिहार्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180636, "chapter_id": 4828, "verse_number": "२", "content_sanskrit": "भगवान् वा हृषीकेशस्त्रैलोक्यस्य परो गुरुः ।\nऋषे यदकरोद् वीरस्तच्च व्याख्यातुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180637, "chapter_id": 4828, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180638, "chapter_id": 4828, "verse_number": "३", "content_sanskrit": "शृणु राजेन्द्र तत्त्वेन कीर्त्यमानं मयाऽनघ ।\nवासुदेवं पुरस्कृत्य यदकुर्वत पाण्डवाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180639, "chapter_id": 4828, "verse_number": "४", "content_sanskrit": "प्राप्य राज्यं महातेजा धर्मराजो युधिष्ठिरः ।\nचातुर्वर्ण्यं यथायोगं स्वे स्वे धर्मे न्यवेशयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180640, "chapter_id": 4828, "verse_number": "५", "content_sanskrit": "ब्राह्मणानां सहस्रं च स्नातकानां महात्मनाम् ।\nसहस्रनिष्कमेकैकं वाचयामास पाण्डवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180641, "chapter_id": 4828, "verse_number": "६", "content_sanskrit": "तथानुजीविनो भृत्यान् संश्रितानतिथीनपि ।\nकामैः सन्तर्पयामास कृपणान् याचकानपि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180642, "chapter_id": 4828, "verse_number": "७", "content_sanskrit": "पुरोहिताय धौम्याय प्रादादयुतशः स गाः ।\nधनं सुवर्णं रजतं वासांसि विविधानि च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180643, "chapter_id": 4828, "verse_number": "८", "content_sanskrit": "कृपाय च महाराज गुरुवृत्तिमवर्तत ।\nविदुराय च धर्मात्मा पूजां चक्रे यतव्रतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180644, "chapter_id": 4828, "verse_number": "९", "content_sanskrit": "भक्षान्नपानैर्विविधैर्वासोभिः शयनासनैः ।\nसर्वान् सन्तोषयामास संश्रितान् ददतांवरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180645, "chapter_id": 4828, "verse_number": "१०", "content_sanskrit": "लब्धप्रशमनं कृत्वा स राजा राजसत्तम ।\nयुयुत्सोर्धार्तराष्ट्रस्य पूजां चक्रे महायशाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180646, "chapter_id": 4828, "verse_number": "११", "content_sanskrit": "धृतराष्ट्राय तद् राज्यं गान्धार्यै विदुराय च ।\nनिवेद्य स्वस्थवद् राजन्नास्ते राजा युधिष्ठिरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180647, "chapter_id": 4828, "verse_number": "१२", "content_sanskrit": "तथा सर्वं स नगरं प्रसाद्य जनमेजय ।\nवासुदेवं महात्मानमभ्यगच्छत् कृताञ्जलिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180648, "chapter_id": 4828, "verse_number": "१३", "content_sanskrit": "ततो महति पर्यङ्के मणिकाञ्चनभूषिते ।\nददर्श कृष्णमासीनं नीलं मेराविवाम्बुदम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180649, "chapter_id": 4828, "verse_number": "१४", "content_sanskrit": "जाज्वल्यमानं वपुषा दिव्याभरणभूषितम् ।\nपीतकौशेयसंवीतं हेम्नीवोपहितं मणिम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180650, "chapter_id": 4828, "verse_number": "१५", "content_sanskrit": "कौस्तुभेन उरःस्थेन मणिनाऽभिविराजितम् ।\nउद्यतेवोदयं शैलं सूर्येणाप्तकिरीटिनम् ।\nनौपम्यं विद्यते यस्य त्रिषु लोकेषु किञ्चन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180651, "chapter_id": 4828, "verse_number": "१६", "content_sanskrit": "सोऽभिगम्य महात्मानं विष्णुं पुरुषविग्रहम् ।\nउवाच मधुराभाषः स्मितपूर्वमिदं तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2180652, "chapter_id": 4828, "verse_number": "१७", "content_sanskrit": "सुखेन ते निशा कच्चिद् व्युष्टा बुद्धिमतांवर ।\nकच्चिज् ज्ञानानि सर्वाणि प्रसन्नानि तवाच्युत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2180653, "chapter_id": 4828, "verse_number": "१८", "content_sanskrit": "तव ह्याश्रित्य तां दैवीं बुद्धिं बुद्धिमतांवर ।\nवयं राज्यमनुप्राप्ताः पृथिवी च वशे स्थिता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2180654, "chapter_id": 4828, "verse_number": "१९", "content_sanskrit": "भवत्प्रसादाद् भगवंस्त्रिलोकगतिविक्रम ।\nजयः प्राप्तो यशश्चाग्र्यं नच धर्माच्च्युता वयम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2180655, "chapter_id": 4828, "verse_number": "२०", "content_sanskrit": "तं तथा भाषमाणं तु धर्मराजं युधिष्ठिरम् ।\nनोवाच भगवान् किञ्चिद् ध्यानमेवान्वपद्यत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2180656, "chapter_id": 4828, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे पञ्चचत्वारिंशोऽध्यायः ॥ ४५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]