[{"id": 6000282000, "chapter_id": 10282, "verse_number": null, "content_sanskrit": "अथ षडशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "श्रीशुक उवाच—", "range": null}]}, {"id": 6000282001, "chapter_id": 10282, "verse_number": "१०-८६-१", "content_sanskrit": "तत्र दुर्योधनो मानी परीतो भ्रातृभिः प्रियैः।\nकिरीटमाली न्यविशदसिहस्तः क्षिपन् रुषा॥ १०/८६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.001.m4a", "display_order": 2, "topics": [{"text": "सभायां दुर्योधनप्रवेशः, तस्य विभ्रमः", "range": "१–३"}]}, {"id": 6000282002, "chapter_id": 10282, "verse_number": "१०-८६-२", "content_sanskrit": "स्थलेऽप्यगृह्णाद् वस्‍त्रान्तं हरिनीलोपलाचिते।\nस्थलं पुष्करिणीं मत्वा सर्वे तं जहसुर्जनाः॥ १०/८६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.002.m4a", "display_order": 3}, {"id": 6000282003, "chapter_id": 10282, "verse_number": "१०-८६-३", "content_sanskrit": "आगच्छन्नेवमुर्वीशः पुरः पुष्करिणीं क्‍वचित्।\nविलोक्य स्फाटिकां भूमिं मन्वानो न्यपतज्जले॥ १०/८६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.003.m4a", "display_order": 4}, {"id": 6000282004, "chapter_id": 10282, "verse_number": "१०-८६-४", "content_sanskrit": "जहास भीमस्तं दृष्ट्वा स्‍त्रियो भूपाश्च केचन।\nनिवार्यमाणा अप्यङ्ग राज्ञा कृष्णानुमोदिताः॥ १०/८६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.004.m4a", "display_order": 5, "topics": [{"text": "द्रौपद्यादीनां हासः", "range": "४"}]}, {"id": 6000282005, "chapter_id": 10282, "verse_number": "१०-८६-५", "content_sanskrit": "अजातशत्रुराकर्ण्य वस्‍त्रस्रग्भूषणादिकम्।\nसम्प्रेष्याह्वापयामास साम्ना याेगेश्वरेण च॥ १०/८६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.005.m4a", "display_order": 6, "topics": [{"text": "धर्मराजसान्त्वनमविगणय्य दुर्योधनस्य निर्गमनम्", "range": "५–१७"}]}, {"id": 6000282006, "chapter_id": 10282, "verse_number": "१०-८६-६", "content_sanskrit": "तदनादृत्य सत्कारं व्रीडावनतकन्धरः।\nजाज्वल्यमानहृदयो न जगाम तदन्तिकम्॥ १०/८६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.006.m4a", "display_order": 7}, {"id": 6000282007, "chapter_id": 10282, "verse_number": "१०-८६-७", "content_sanskrit": "स व्रीडितोऽवाग्वदनो रुषा ज्वलन् निष्क्रम्य तूष्णीं प्रययौ गजाह्वयम्।\nहाहेति शब्दः सुमहानभूत् सतामजातशत्रुर्विमना इवाभवत्॥ १०/८६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.007.m4a", "display_order": 8}, {"id": 6000282008, "chapter_id": 10282, "verse_number": "१०-८६-८", "content_sanskrit": "बभूव तूष्णीं भगवान् भुवो भरं जिहीर्षुरात्मेहितमात्मनि स्मरन्।\nतदाऽऽविरासीज्जगदीशसन्निधौ मुनिः सुराराधितपादपङ्कजः॥ १०/८६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.008.m4a", "display_order": 9}, {"id": 6000282009, "chapter_id": 10282, "verse_number": "१०-८६-९", "content_sanskrit": "उपेत्य नारदः सर्वैः सदस्यैः परिपूजितः।\nकृष्णेनाभ्यर्चितः सम्यगुपविष्टो नृपान्तिके॥ १०/८६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.009.m4a", "display_order": 10}, {"id": 6000282010, "chapter_id": 10282, "verse_number": "१०-८६-१०", "content_sanskrit": "उवाच धर्मराजस्तं प्रणिपत्य यथाविधि।\nभवान् सर्वत्रगो ब्रह्मन् सर्वकालेष्वसङ्गतः॥ १०/८६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.010.m4a", "display_order": 11}, {"id": 6000282011, "chapter_id": 10282, "verse_number": "१०-८६-११", "content_sanskrit": "नृपाणां शौर्ययुक्तानां सर्वमण्डलवासिनाम्।\nइदानीं कतमः शूरो नित्योद्योगेन वर्तते॥ १०/८६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.011.m4a", "display_order": 12}, {"id": 6000282012, "chapter_id": 10282, "verse_number": "१०-८६-१२", "content_sanskrit": "इति तेनोदितां वाणीमाकर्ण्य मुनिरब्रवत्॥ १०/८६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.012.m4a", "display_order": 13}, {"id": 6000282013, "chapter_id": 10282, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.013.m4a", "display_order": 14}, {"id": 6000282014, "chapter_id": 10282, "verse_number": "१०-८६-१३", "content_sanskrit": "भग्नदर्पा नृपाः सर्वे कृष्णेनाप्रतिमौजसा।\nवसन्ति विषये स्वे स्वे नष्टचेष्टा गतश्रियः॥ १०/८६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.014.m4a", "display_order": 15}, {"id": 6000282015, "chapter_id": 10282, "verse_number": "१०-८६-१४", "content_sanskrit": "एक एव महोत्साहः क्षत्रियाणां दुराग्रही।\nजातः साल्वेषु नृपतिर्बहुपादातिवाहनः॥ १०/८६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.015.m4a", "display_order": 16}, {"id": 6000282016, "chapter_id": 10282, "verse_number": "१०-८६-१५", "content_sanskrit": "भ्रातर्युपरते युद्धे विष्णुना लोकजिष्णुना।\nब्रह्मदत्तसुते हंसे यमुनायां महात्मना॥ १०/८६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.016.m4a", "display_order": 17}, {"id": 6000282017, "chapter_id": 10282, "verse_number": "१०-८६-१६", "content_sanskrit": "कृष्णद्विडेत्य राज्ञोऽसौ रुग्म्यादीन् कुण्डिने पुरे।\nसमाजं कारयामास भ्रातुरानृण्यकाङ्क्षया॥ १०/८६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.017.m4a", "display_order": 18}, {"id": 6000282018, "chapter_id": 10282, "verse_number": "१०-८६-१७", "content_sanskrit": "शिशुपालद्रुममुखैर्दन्तवक्रपुरःसरैः।\nपराजितेषु सङ्ग्रामे जरासन्धादिषु प्रभो॥ १०/८६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.018.m4a", "display_order": 19}, {"id": 6000282019, "chapter_id": 10282, "verse_number": "१०-८६-१८", "content_sanskrit": "साल्वः प्रतिज्ञामकरोच्छृण्वतां सर्वभूभुजाम्।\nअयादवीं क्ष्मां करिष्ये पश्यन्तु मम पौरुषम्॥ १०/८६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.019.m4a", "display_order": 20, "topics": [{"text": "तत्र नारदस्य साल्वोद्योगोक्तिः", "range": "१८–३०"}]}, {"id": 6000282020, "chapter_id": 10282, "verse_number": "१०-८६-१९", "content_sanskrit": "इति मूढः प्रतिज्ञाय तपसे प्राविशद् वनम्।\nगते तस्मिन् बहून् वर्षान् प्रतीक्ष्य तदुपागमम्॥ १०/८६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.020.m4a", "display_order": 21}, {"id": 6000282021, "chapter_id": 10282, "verse_number": "१०-८६-२०", "content_sanskrit": "तदनन्तरजोऽमात्यैरभिषिक्तो नृपार्थिभिः।\nतपस्तप्त्वा स नृपतिर्देवं पशुपतिं प्रभुम्॥ १०/८६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.021.m4a", "display_order": 22}, {"id": 6000282022, "chapter_id": 10282, "verse_number": "१०-८६-२१", "content_sanskrit": "आराधयामास वने पांसुमुष्टिं सकृद् ग्रसन्।\nसंवत्सरान्ते भगवान् सन्तुष्टः स उमापतिः॥ १०/८६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.022.m4a", "display_order": 23}, {"id": 6000282023, "chapter_id": 10282, "verse_number": "१०-८६-२२", "content_sanskrit": "वरेण छन्दयामास साल्वं शरणमागतम्।\nदेवासुरमनुष्याणां गन्धर्वोरगक्षसाम्॥ १०/८६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.023.m4a", "display_order": 24}, {"id": 6000282024, "chapter_id": 10282, "verse_number": "१०-८६-२३", "content_sanskrit": "अभेद्यं कामगं वव्रे स यानं वृष्णिभीषणम्।\nतथेति गिरिशादिष्टो मयः परपुरञ्जयः॥ १०/८६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.024.m4a", "display_order": 25}, {"id": 6000282025, "chapter_id": 10282, "verse_number": "१०-८६-२४", "content_sanskrit": "पुरं निर्माय साल्वाय प्रादात् सौभमयस्मयम्।\nस लब्ध्वा कामगं यानं तमोधाम दुरासदम्॥ १०/८६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.025.m4a", "display_order": 26}, {"id": 6000282026, "chapter_id": 10282, "verse_number": "१०-८६-२५", "content_sanskrit": "आययौ स्वं जनपदं समग्रबलवाहनम्।\nइदानीं राजपुत्राणां स एवोद्योगवान् नृप॥ १०/८६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.026.m4a", "display_order": 27}, {"id": 6000282027, "chapter_id": 10282, "verse_number": "१०-८६-२६", "content_sanskrit": "इति धर्मसुतः श्रीमान् श्रुत्वा तन्नारदोदितम्।\nपार्श्वे भगवतः शौरेः शनैर्मुखमवैक्षत॥ १०/८६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.027.m4a", "display_order": 28}, {"id": 6000282028, "chapter_id": 10282, "verse_number": "१०-८६-२७", "content_sanskrit": "निशम्य तद् वासुदेवो धैर्यसारो निराकुलः।\nकिञ्चित् प्रहस्यास्तु नामेत्याह सा हि महात्मता॥ १०/८६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.028.m4a", "display_order": 29}, {"id": 6000282029, "chapter_id": 10282, "verse_number": "१०-८६-२८", "content_sanskrit": "पूजयित्वा ऋषिं सक्यक् सूनृतैर्गीर्भिरच्युतः।\nचिराभिलषितः सोऽपि प्राप्तः साध्वित्यचिन्तयत्॥ १०/८६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.029.m4a", "display_order": 30}, {"id": 6000282030, "chapter_id": 10282, "verse_number": "१०-८६-२९", "content_sanskrit": "उग्रसेनं यदुपतिं युयुधानं च माधवः।\nअक्रूरं कृतवर्माणमन्यांश्च यदुपुङ्गवान्॥ १०/८६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.030.m4a", "display_order": 31}, {"id": 6000282031, "chapter_id": 10282, "verse_number": "१०-८६-३०", "content_sanskrit": "प्रेषयामास रक्षायै द्वारवत्याः स्वसैनिकान्॥ १०/८६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_086/BhP_10.086.031.m4a", "display_order": 32}, {"id": 6000282032, "chapter_id": 10282, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे षडशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]