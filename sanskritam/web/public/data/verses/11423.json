[{"id": 50009465, "chapter_id": 11423, "verse_number": "1", "content_sanskrit": "विदुर उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50009466, "chapter_id": 11423, "verse_number": "2", "content_sanskrit": "भवे शीलवतां श्रेष्ठे दक्षो दुहितृवत्सलः विद्वेषमकरोत्कस्मादनादृत्यात्मजां सतीम्॥ ४/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50009467, "chapter_id": 11423, "verse_number": "3", "content_sanskrit": "कस्तं चराचरगुरुं निर्वैरं शान्तविग्रहम् आत्मारामं कथं द्वेष्टि जगतो दैवतं महत्॥ ४/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50009468, "chapter_id": 11423, "verse_number": "4", "content_sanskrit": "एतदाख्याहि मे ब्रह्मन्जामातुः श्वशुरस्य च विद्वेषस्तु यतः प्राणांस्तत्यजे दुस्त्यजान्सती॥ ४/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50009469, "chapter_id": 11423, "verse_number": "5", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50009470, "chapter_id": 11423, "verse_number": "6", "content_sanskrit": "पुरा विश्वसृजां सत्रे समेताः परमर्षयः तथामरगणाः सर्वे सानुगा मुनयोऽग्नयः॥ ४/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50009471, "chapter_id": 11423, "verse_number": "7", "content_sanskrit": "तत्र प्रविष्टमृषयो दृष्ट्वार्कमिव रोचिषा भ्राजमानं वितिमिरं कुर्वन्तं तन्महत्सदः॥ ४/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50009472, "chapter_id": 11423, "verse_number": "8", "content_sanskrit": "उदतिष्ठन्सदस्यास्ते स्वधिष्ण्येभ्यः सहाग्नयः ऋते विरिञ्चां शर्वं च तद्भासाक्षिप्तचेतसः॥ ४/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50009473, "chapter_id": 11423, "verse_number": "9", "content_sanskrit": "सदसस्पतिभिर्दक्षो भगवान्साधु सत्कृतः अजं लोकगुरुं नत्वा निषसाद तदाज्ञया॥ ४/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50009474, "chapter_id": 11423, "verse_number": "10", "content_sanskrit": "प्राङ्निषण्णं मृडं दृष्ट्वा नामृष्यत्तदनादृतः उवाच । वामं चक्षुर्भ्यामभिवीक्ष्य दहन्निव॥ ४/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50009475, "chapter_id": 11423, "verse_number": "11", "content_sanskrit": "दक्ष उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50009476, "chapter_id": 11423, "verse_number": "12", "content_sanskrit": "श्रूयतां ब्रह्मर्षयो मे सहदेवाः सहाग्नयः साधूनां ब्रुवतो वृत्तं नाज्ञानान्न च मत्सरात्॥ ४/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50009477, "chapter_id": 11423, "verse_number": "13", "content_sanskrit": "अयं तु लोकपालानां यशोघ्नो निरपत्रपः सद्भिराचरितः पन्था येन स्तब्धेन दूषितः॥ ४/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50009478, "chapter_id": 11423, "verse_number": "14", "content_sanskrit": "एष मे शिष्यतां प्राप्तो यन्मे दुहितुरग्रहीत् पाणिं विप्राग्निमुखतः सावित्र्या इव साधुवत्॥ ४/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50009479, "chapter_id": 11423, "verse_number": "15", "content_sanskrit": "गृहीत्वा मृगशावाक्ष्याः पाणिं मर्कटलोचनः प्रत्युत्थानाभिवादार्हे वाचाप्यकृत नोचितम्॥ ४/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50009480, "chapter_id": 11423, "verse_number": "16", "content_sanskrit": "लुप्तक्रियायाशुचये मानिने भिन्नसेतवे अनिच्छन्नप्यदां बालां शूद्रायेवोशतीं गिरम्॥ ४/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50009481, "chapter_id": 11423, "verse_number": "17", "content_sanskrit": "प्रेतावासेषु घोरेषु प्रेतैर्भूतगणैर्वृतः अटत्युन्मत्तवन्नग्नो व्युप्तकेशो हसन्रुदन्॥ ४/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50009482, "chapter_id": 11423, "verse_number": "18", "content_sanskrit": "चिताभस्मकृतस्नानः प्रेतस्रङ्न्रस्थिभूषणः शिवापदेशो ह्यशिवो मत्तो मत्तजनप्रियः॥ ४/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50009483, "chapter_id": 11423, "verse_number": "19", "content_sanskrit": "पतिः प्रमथनाथानां तमोमात्रात्मकात्मनाम् तस्मा उन्मादनाथाय नष्टशौचाय दुर्हृदे ॥ ४/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50009484, "chapter_id": 11423, "verse_number": "20", "content_sanskrit": "दत्ता बत मया साध्वी चोदिते परमेष्ठिना॥ ४/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50009485, "chapter_id": 11423, "verse_number": "21", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50009486, "chapter_id": 11423, "verse_number": "22", "content_sanskrit": "विनिन्द्यैवं स गिरिशमप्रतीपमवस्थितम् दक्षोऽथाप उपस्पृश्य क्रुद्धः शप्तुं प्रचक्रमे॥ ४/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50009487, "chapter_id": 11423, "verse_number": "23", "content_sanskrit": "अयं तु देवयजन इन्द्रोपेन्द्रादिभिर्भवः सह भागं न लभतां देवैर्देवगणाधमः॥ ४/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50009488, "chapter_id": 11423, "verse_number": "24", "content_sanskrit": "निषिध्यमानः स सदस्यमुख्यैर्दक्षो गिरित्राय विसृज्य शापम् तस्माद्विनिष्क्रम्य विवृद्धमन्युर्जगाम कौरव्य निजं निकेतनम्॥ ४/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50009489, "chapter_id": 11423, "verse_number": "25", "content_sanskrit": "विज्ञाय शापं गिरिशानुगाग्रणीर्नन्दीश्वरो रोषकषायदूषितः दक्षाय शापं विससर्ज दारुणं ये चान्वमोदंस्तदवाच्यतां द्विजाः॥ ४/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50009490, "chapter_id": 11423, "verse_number": "26", "content_sanskrit": "य एतन्मर्त्यमुद्दिश्य भगवत्यप्रतिद्रुहि द्रुह्यत्यज्ञः पृथग्दृष्टिस्तत्त्वतो विमुखो भवेत्॥ ४/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50009491, "chapter_id": 11423, "verse_number": "27", "content_sanskrit": "गृहेषु कूटधर्मेषु सक्तो ग्राम्यसुखेच्छया कर्मतन्त्रं वितनुते वेदवादविपन्नधीः॥ ४/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50009492, "chapter_id": 11423, "verse_number": "28", "content_sanskrit": "बुद्ध्या पराभिध्यायिन्या विस्मृतात्मगतिः पशुः स्त्रीकामः सोऽस्त्वतितरां दक्षो बस्तमुखोऽचिरात्॥ ४/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50009493, "chapter_id": 11423, "verse_number": "29", "content_sanskrit": "विद्याबुद्धिरविद्यायां कर्ममय्यामसौ जडः संसरन्त्विह ये चामुमनु शर्वावमानिनम्॥ ४/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50009494, "chapter_id": 11423, "verse_number": "30", "content_sanskrit": "गिरः श्रुतायाः पुष्पिण्या मधुगन्धेन भूरिणा मथ्ना चोन्मथितात्मानः सम्मुह्यन्तु हरद्विषः॥ ४/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50009495, "chapter_id": 11423, "verse_number": "31", "content_sanskrit": "सर्वभक्षा द्विजा वृत्त्यै धृतविद्यातपोव्रताः वित्तदेहेन्द्रियारामा याचका विचरन्त्विह॥ ४/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50009496, "chapter_id": 11423, "verse_number": "32", "content_sanskrit": "तस्यैवं वदतः शापं श्रुत्वा द्विजकुलाय वै भृगुः प्रत्यसृजच्छापं ब्रह्मदण्डं दुरत्ययम्॥ ४/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50009497, "chapter_id": 11423, "verse_number": "33", "content_sanskrit": "भवव्रतधरा ये च ये च तान्समनुव्रताः पाषण्डिनस्ते भवन्तु सच्छास्त्रपरिपन्थिनः॥ ४/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50009498, "chapter_id": 11423, "verse_number": "34", "content_sanskrit": "नष्टशौचा मूढधियो जटाभस्मास्थिधारिणः विशन्तु शिवदीक्षायां यत्र दैवं सुरासवम्॥ ४/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50009499, "chapter_id": 11423, "verse_number": "35", "content_sanskrit": "ब्रह्म च ब्राह्मणांश्चैव यद्यूयं परिनिन्दथ सेतुं विधारणं पुंसामतः पाषण्डमाश्रिताः॥ ४/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50009500, "chapter_id": 11423, "verse_number": "36", "content_sanskrit": "एष एव हि लोकानां शिवः पन्थाः सनातनः यं पूर्वे चानुसन्तस्थुर्यत्प्रमाणं जनार्दनः॥ ४/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50009501, "chapter_id": 11423, "verse_number": "37", "content_sanskrit": "तद्ब्रह्म परमं शुद्धं सतां वर्त्म सनातनम् विगर्ह्य यात पाषण्डं दैवं वो यत्र भूतराट्॥ ४/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50009502, "chapter_id": 11423, "verse_number": "38", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50009503, "chapter_id": 11423, "verse_number": "39", "content_sanskrit": "तस्यैवं वदतः शापं भृगोः स भगवान्भवः निश्चक्राम ततः किञ्चिद्विमना इव सानुगः॥ ४/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50009504, "chapter_id": 11423, "verse_number": "40", "content_sanskrit": "तेऽपि विश्वसृजः सत्रं सहस्रपरिवत्सरान् संविधाय महेष्वास यत्रेज्य ऋषभो हरिः॥ ४/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50009505, "chapter_id": 11423, "verse_number": "41", "content_sanskrit": "आप्लुत्यावभृथं यत्र गङ्गा यमुनयान्विता विरजेनात्मना सर्वे स्वं स्वं धाम ययुस्ततः॥ ४/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50009506, "chapter_id": 11423, "verse_number": "42", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे द्वितीयोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]