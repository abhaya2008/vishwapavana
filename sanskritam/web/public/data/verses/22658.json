[{"id": 7002658000, "chapter_id": 22658, "verse_number": "७-१-१", "content_sanskrit": "ऋषयः ऊचुः ।\nभगवन्विक्रमाख्यानकालोऽयं भवतोदितः ।\nशतद्वादशमर्यादो द्वापरस्य समो भुवि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002658001, "chapter_id": 22658, "verse_number": "७-१-२", "content_sanskrit": "अस्मिन्काले महाभाग लीला भगवता कृता ।\nतामेतां कथयास्मान्वै सर्वज्ञोऽस्ति भवान्सदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002658002, "chapter_id": 22658, "verse_number": "७-१-३", "content_sanskrit": "सूत उवाच ।\nनारायणं नमस्कृत्य नरं चैव नरोत्तमम् ।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002658003, "chapter_id": 22658, "verse_number": "७-१-४", "content_sanskrit": "भविष्याख्ये महाकल्पे प्राप्ते वैवस्वतेन्तरे ।\nअष्टाविंशद्द्वापरान्ते कुरुक्षेत्रे रणोऽभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002658004, "chapter_id": 22658, "verse_number": "७-१-५", "content_sanskrit": "पांडवैर्निर्जिताः सर्वे कौरवाः युद्धदुर्मदाः ।\nअष्टादशे च दिवसे पांडवानां जयोऽभवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002658005, "chapter_id": 22658, "verse_number": "७-१-६", "content_sanskrit": "दिनान्ते भग वान्कृष्णो ज्ञात्वा कालस्य दुर्गतिम् ।\nशिवं तुष्टाव मनसा योगरूपं सनातनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002658006, "chapter_id": 22658, "verse_number": "७-१-७", "content_sanskrit": "कृष्ण उवाच ।\nनमः शांताय रुद्राय भूते शाय कपर्दिने ।\nकालकर्त्रे जगद्भर्त्रे पापहर्त्रे नमोनमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002658007, "chapter_id": 22658, "verse_number": "७-१-८", "content_sanskrit": "पांडवान्रक्ष भगवन्मद्भक्तान्भूतभीरुकान् ।\nइति श्रुत्वा स्तवं रुद्रो नंदियानोपरिस्थितः ।\nरक्षार्थं शिबिराणां च प्राप्तवाञ्छूलहस्तधृक् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002658008, "chapter_id": 22658, "verse_number": "७-१-९", "content_sanskrit": "तदा नृपाज्ञया कृष्णः स गतो गजसाह्वयम् ।\nपांडवाः पंच निर्गत्य सरस्वत्या स्तटेऽवसन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002658009, "chapter_id": 22658, "verse_number": "७-१-१०", "content_sanskrit": "निशीथे द्रौणिभोजौ च कृपस्तत्र समाययुः ।\nतुष्टुवुर्मनसा रुद्रं तेभ्यो मार्गं शिवोददात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002658010, "chapter_id": 22658, "verse_number": "७-१-११", "content_sanskrit": "अश्वत्थामा तु बलवाञ्छिवदत्तमसिं तदा ।\nगृहीत्वा स जघानाशु धृष्टद्युम्नपुरःसरान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002658011, "chapter_id": 22658, "verse_number": "७-१-१२", "content_sanskrit": "हत्वा यथेष्टमगमद्द्रौणिस्ताभ्यां समन्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002658012, "chapter_id": 22658, "verse_number": "७-१-१३", "content_sanskrit": "पार्षतस्यैव सूतश्च हतशेषो भयातुरः ।\nपांडवान्वर्णयामास यथा जातो जनक्षयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002658013, "chapter_id": 22658, "verse_number": "७-१-१४", "content_sanskrit": "आगस्कृतं शिवं ज्ञात्वा भीमाद्याः क्रोधमूर्च्छिताः ।\nस्वायुधैस्ता डयामास देवदेवं पिनाकिनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002658014, "chapter_id": 22658, "verse_number": "७-१-१५", "content_sanskrit": "अस्त्रशस्त्राणि तेषां तु शिवदेहे समाविशन् ।\nदृष्ट्वा ते विस्मिताः सर्वे प्रजघ्नुस्तलमुष्टिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002658015, "chapter_id": 22658, "verse_number": "७-१-१६", "content_sanskrit": "ताञ्छशाप तदा रुद्रो यूयं कृष्णप्रपूजकाः ।\nअतोऽस्माभी रक्षिणीया वधयोग्याश्च वै भुवि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002658016, "chapter_id": 22658, "verse_number": "७-१-१७", "content_sanskrit": "पुनर्जन्म कलौ प्राप्य भोक्ष्यते चापराधकम् ।\nइत्युक्त्वान्तर्दधे देवः पांडवा दुःखितास्तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002658017, "chapter_id": 22658, "verse_number": "७-१-१८", "content_sanskrit": "हरिं शरणमाजग्मुरपराधनिवृत्तये ।\nतदा कृष्णयुताः सर्वे पांडवाः शस्त्रवर्जिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002658018, "chapter_id": 22658, "verse_number": "७-१-१९", "content_sanskrit": "तुष्टुवुर्मनसा रुद्रं तदा प्रादुरभूच्छिवः ।\nवरं वरयत प्राह कृष्णः श्रुत्वाब्रवीदिदम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002658019, "chapter_id": 22658, "verse_number": "७-१-२०", "content_sanskrit": "शस्त्राण्यस्त्राणि यान्येव त्वदंगे क्षपितानि वै ।\nपांडवेभ्यश्च देहि त्वं शापस्यानुग्रहं कुरु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002658020, "chapter_id": 22658, "verse_number": "७-१-२१", "content_sanskrit": "इति श्रुत्वा शिवः प्राह कृष्णदेव नमोऽस्तु ते ।\nअपराधो न मे स्वामिन्मोहितोऽहं तवाज्ञया ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002658021, "chapter_id": 22658, "verse_number": "७-१-२२", "content_sanskrit": "तद्वशेन मया स्वामिन्दत्तः शापो भयंकरः ।\nनान्यथा वचनं मे स्यादंशावतरणं भवेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002658022, "chapter_id": 22658, "verse_number": "७-१-२३", "content_sanskrit": "वत्सराजस्य पुत्रत्वं गमिष्यति युधिष्ठिरः ।\nबलखानिरिति ख्यातः शिरीषाख्यपुराधिपः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002658023, "chapter_id": 22658, "verse_number": "७-१-२४", "content_sanskrit": "भीमो दुर्वचनाद्दुष्टो म्लेच्छयोनौ भविष्यति ।\nवीरणो नाम विख्यातः स वै वनरसाधिपः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002658024, "chapter_id": 22658, "verse_number": "७-१-२५", "content_sanskrit": "अर्जुनांशश्च मद्भक्तो जनिष्यति महामतिः ।\nपुत्रः परिमलस्यैव ब्रह्मानन्द इति स्मृतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002658025, "chapter_id": 22658, "verse_number": "७-१-२६", "content_sanskrit": "कान्यकुब्जे हि नकुलो भविष्यति महाबलः ।\nरत्नभानुसुतो सौ वै लक्ष्मणो नाम विश्रुतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002658026, "chapter_id": 22658, "verse_number": "७-१-२७", "content_sanskrit": "सहदेवस्तु वलवाञ्जनिष्यति महामतिः ।\nभीष्मसिंह सुतो जातो देवसिंह इति स्मृतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002658027, "chapter_id": 22658, "verse_number": "७-१-२८", "content_sanskrit": "धृतराष्ट्रांश एवासौ जनिष्यत्यजमेरके ।\nपृथिवीराज इति स द्रोपदी तत्सुता स्मृता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002658028, "chapter_id": 22658, "verse_number": "७-१-२९", "content_sanskrit": "वेला नाम्ना च विख्याता तारकः कर्ण एव हि ।\nरक्तबीजस्तथा रुद्रो भविष्यति महीतले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002658029, "chapter_id": 22658, "verse_number": "७-१-३०", "content_sanskrit": "कौरवाश्च भविष्यन्ति मायायुद्धविशारदाः ।\nपांडुपक्षाश्च ते सर्वे धर्मिणो बलशालिनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002658030, "chapter_id": 22658, "verse_number": "७-१-३१", "content_sanskrit": "सूत उवाच ।\nइति श्रुत्वा हरिः प्राह विहस्य परमेश्वरम् ।\nमया शक्त्यवतारेण रक्षणीया हि पांडवाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002658031, "chapter_id": 22658, "verse_number": "७-१-३२", "content_sanskrit": "महावती पुरी रम्या मायादेवीविनिर्मिता ।\nदेशराजसुतस्तत्र ममांशो हि जनिष्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002658032, "chapter_id": 22658, "verse_number": "७-१-३३", "content_sanskrit": "देवकीजठरे जन्मोदयसिंह इति स्मृतः ।\nआह्लादो मम धामांशो जनिष्यति गुरुर्मम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002658033, "chapter_id": 22658, "verse_number": "७-१-३४", "content_sanskrit": "हत्वाग्निवंशजान्भूपान्स्थापयिष्यामि वै कलिम् ।\nइति श्रुत्वा शिवो देवस्तत्रैवांतरधीयत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]