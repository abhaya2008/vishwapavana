[{"id": 7003100000, "chapter_id": 23100, "verse_number": "४-३६-१", "content_sanskrit": "श्रीराधिकोवाच ।\nएतेन नियमेनैव ब्रह्मा तत्याज मोहिनीम् ।\nकथं स कुलटाशापादपूज्यः संबभूव ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003100001, "chapter_id": 23100, "verse_number": "४-३६-२", "content_sanskrit": "कथं तस्य दर्पभङ्गं चकार कमलापतिः ।\nकथयस्व सर्वबीजं सर्वेषामीश्वरः स्वयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003100002, "chapter_id": 23100, "verse_number": "४-३६-३", "content_sanskrit": "श्रीनारायण उवाच ।\nरासेश्वरीवचः श्रुत्वा प्रहस्य रसिकेश्वरः ।\nनिगूढमितिहासं च तां वक्तुमुपचक्रमे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003100003, "chapter_id": 23100, "verse_number": "४-३६-४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nब्रह्मा चिरं तपस्तप्त्वा मत्तो लब्ध्वा वरं वरम् ।\nसृष्टिं नानाविधां कृत्वा विधाता स बभूव ह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003100004, "chapter_id": 23100, "verse_number": "४-३६-५", "content_sanskrit": "तपसां फलदाता च सर्वेषां शास्तिकृत्प्रभुः ।\nआत्मानमीश्वरं ज्ञात्वा महागर्वो बभूव ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003100005, "chapter_id": 23100, "verse_number": "४-३६-६", "content_sanskrit": "ब्रह्माण्डेषु च सर्वेषु गर्वपर्यन्तमुन्नतिः ।\nइति मत्वा ब्रह्मणश्च दर्पभङ्गः कृतो मया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003100006, "chapter_id": 23100, "verse_number": "४-३६-७", "content_sanskrit": "येषां येषां भवेद्दर्पो ब्रह्माण्डेषु परात्परः ।\nविज्ञाय सर्वं सर्वात्मा तेषां शास्ताऽहमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003100007, "chapter_id": 23100, "verse_number": "४-३६-८", "content_sanskrit": "प्रथमे ब्रह्मणो गर्वो मया चूर्णीकृतः श्रुतः ।\nशङ्करस्य च पार्वत्याश्चन्द्रस्य च रवेस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003100008, "chapter_id": 23100, "verse_number": "४-३६-९", "content_sanskrit": "वह्नेर्दुर्वाससश्चैव तथा धन्वन्तरेः प्रिये। ।\nक्रमेण दर्पभङ्गं च कथयामि निशामय ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003100009, "chapter_id": 23100, "verse_number": "४-३६-१०", "content_sanskrit": "क्षुद्राणां महतां चैव येषां गर्वो भवेत्प्रिये ।\nएवंविधमहं तेषां चूर्णीभूतं करोमि च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003100010, "chapter_id": 23100, "verse_number": "४-३६-११", "content_sanskrit": "श्रीनारायण उवाच ।\nश्रीकृष्णस्य वचः श्रुत्वा शुष्ककण्ठोष्ठतालुका ।\nपप्रच्छ राधा यत्नेन संत्रस्ता भयविह्वला ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003100011, "chapter_id": 23100, "verse_number": "४-३६-१२", "content_sanskrit": "श्रीराधिकोवाच ।\nकस्य केन प्रभावेण महादर्पो बभूव ह ।\nत्वया केन प्रभावेण तस्य भङ्गः कृतः पुरा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003100012, "chapter_id": 23100, "verse_number": "४-३६-१३", "content_sanskrit": "कथयस्व प्राणनाथ सर्वेषां दर्पभञ्जन ।\nदर्पदो भयदः प्राणदानैककारणेश्वर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003100013, "chapter_id": 23100, "verse_number": "४-३६-१४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nयेन भूतं गर्वचूर्णं श्रुतं त्रिजगतां विधेः ।\nअन्येषां श्रूयतां राधे व्यासेन कथयामि ते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003100014, "chapter_id": 23100, "verse_number": "४-३६-१५", "content_sanskrit": "स्वयं शिवो मदंशश्च संहर्ता जगतां च यः ।\nतेजसा मत्समः पूर्णो ज्ञानेन च गुणेन च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003100015, "chapter_id": 23100, "verse_number": "४-३६-१६", "content_sanskrit": "ध्यायन्ति योगिनो यं स योगीन्द्राणां गुरोर्गुरुः ।\nज्ञानानन्दस्वरूपोऽयं तस्याख्यानं शृणु प्रिये ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003100016, "chapter_id": 23100, "verse_number": "४-३६-१७", "content_sanskrit": "युगषष्टिसहस्राणि तपस्तप्त्वा दिवानिशम् ।\nभूत्वा च मत्कलापूर्णो बभूव मत्समो विभुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003100017, "chapter_id": 23100, "verse_number": "४-३६-१८", "content_sanskrit": "तपसा तेजसा शश्वत्तेजोराशिर्बभूव ह ।\nसूर्यकोटिप्रभावश्च भक्तानां कल्पपादपः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003100018, "chapter_id": 23100, "verse_number": "४-३६-१९", "content_sanskrit": "ध्यायंध्यायं च योगीन्द्रास्तत्तेजो बहुकालतः ।\nतदन्तरे च पश्यन्ति स्वरूपमतिसुन्दरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003100019, "chapter_id": 23100, "verse_number": "४-३६-२०", "content_sanskrit": "शुद्धस्फटिकसंकाशं पञ्चवक्त्रं त्रिलोचनम् ।\nत्रिशूलपट्टिशकरं व्याघ्रचर्माम्बरं वरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003100020, "chapter_id": 23100, "verse_number": "४-३६-२१", "content_sanskrit": "जपन्तं स्वात्मनाऽऽत्मानं श्वेताब्जबीजमालया ।\nईषद्धास्यप्रसन्नास्यं चन्द्रचूडं परात्परम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003100021, "chapter_id": 23100, "verse_number": "४-३६-२२", "content_sanskrit": "स्वर्णाकारं जटाभारं दधतं शिरसा मुदा।\nशान्तं कान्तं त्रिजगतां भक्तानुऽग्रहकातरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003100022, "chapter_id": 23100, "verse_number": "४-३६-२३", "content_sanskrit": "अथ स्वमीश्वरं मत्वा प्रदाता सर्वसंपदाम्। ।\nददाति सर्वं सर्वेभ्यो वाञ्छितं कल्पपादपः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003100023, "chapter_id": 23100, "verse_number": "४-३६-२४", "content_sanskrit": "यो यं वाञ्छति तं तस्मै वरं दत्त्वा वरेश्वरः ।\nबभूव गर्वसंयुक्तः स्वात्मारामः स्वलीलया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003100024, "chapter_id": 23100, "verse_number": "४-३६-२५", "content_sanskrit": "एकदा च वृको दैत्यस्तपस्तेपे शिवस्य च ।\nकेदारे च कठोरेण वर्षमेकं दिवानिशम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003100025, "chapter_id": 23100, "verse_number": "४-३६-२६", "content_sanskrit": "नित्यं याति तत्समीपं कृपया च कृपानिधिः ।\nवरं दातुं यथाऽभीष्टं न जग्राहासुरो वरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003100026, "chapter_id": 23100, "verse_number": "४-३६-२७", "content_sanskrit": "वर्षान्ते शङ्करः शश्वत्तस्थौ तत्पुरतः स्वयम् ।\nवरदो भक्तिपाशेन क्षणं गन्तुं न स क्षमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003100027, "chapter_id": 23100, "verse_number": "४-३६-२८", "content_sanskrit": "सर्वैश्वर्यं सर्वसिद्धिं भुक्तिं मुक्तिं हरः पदम् ।\nदैत्यः किंचिन्न गृह्णाति परितः शूलपाणिनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003100028, "chapter_id": 23100, "verse_number": "४-३६-२९", "content_sanskrit": "ध्यायमानं तत्पदाब्जं दृष्ट्वा त्रस्तो महेश्वरः ।\nअयाचितारं निश्चेष्टं रुरोद प्रेमविह्वलः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003100029, "chapter_id": 23100, "verse_number": "४-३६-३०", "content_sanskrit": "अतीव रोदनात्तस्य ध्यानभङ्गो बभूव ह ।\nददर्श पुरतः साक्षाद्दातारं सर्वसंपदाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003100030, "chapter_id": 23100, "verse_number": "४-३६-३१", "content_sanskrit": "यन्मायया वरं वव्रे दैत्येन्द्रो भक्तिपूर्वकम् ।\nहस्तं दधे च यन्मूर्ध्नि स भस्म भवितेति च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003100031, "chapter_id": 23100, "verse_number": "४-३६-३२", "content_sanskrit": "ओमित्युक्त्वा प्रयान्तं तं दुद्राव दैत्यपुंगवः।\nमृत्युञ्जयो मृत्युभयाद्दुद्राव त्रासविह्वलः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003100032, "chapter_id": 23100, "verse_number": "४-३६-३३", "content_sanskrit": "पपात डमरुस्तस्य व्याघ्रचर्म मनोहरम् ।\nदिगम्बरो दशदिशो भेजे दानवभीतये ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003100033, "chapter_id": 23100, "verse_number": "४-३६-३४", "content_sanskrit": "न हन्ति तं च कृपया भक्तं च भक्तवत्सलः ।\nदुष्टानुसारं साधुश्च न करोति कदाचन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003100034, "chapter_id": 23100, "verse_number": "४-३६-३५", "content_sanskrit": "साधवो घ्नन्ति घ्नन्तं च भृत्यं पुत्रं प्रियां विना ।\nप्रबोधितुं न शक्तश्च स्वात्मानं कृपया समम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003100035, "chapter_id": 23100, "verse_number": "४-३६-३६", "content_sanskrit": "शिवः स्वमृत्युं मत्वा च भीतश्च निरहंकृतः ।\nस्मारंस्मारं च मां भद्रे मामेव शरणं ययौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003100036, "chapter_id": 23100, "verse_number": "४-३६-३७", "content_sanskrit": "दृष्ट्वा स्वाश्रममायान्तं शुष्ककण्ठोष्ठतालुकम् ।\nहे हरे रक्ष रक्षेति जपन्तं भयविह्वलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003100037, "chapter_id": 23100, "verse_number": "४-३६-३८", "content_sanskrit": "संस्थाप्य तत्समीपे च स दैत्यो बोधितो मया ।\nपृष्टश्च सर्ववृत्तान्तमुवाच मां क्रमेण च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003100038, "chapter_id": 23100, "verse_number": "४-३६-३९", "content_sanskrit": "तदा ममाज्ञया तूर्णं वञ्चितो माययाऽसुरः ।\nदत्त्वा स्वमूर्ध्नि हस्तं च सद्यो भस्म बभूव ह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003100039, "chapter_id": 23100, "verse_number": "४-३६-४०", "content_sanskrit": "तदा सिद्धाः सुरेन्द्राश्च मुनीन्द्रा मनवो मुदा ।\nतुष्टुवुर्मां सुभक्त्या च लज्जया लज्जितः शिवः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003100040, "chapter_id": 23100, "verse_number": "४-३६-४१", "content_sanskrit": "बभूव चूर्णस्तद्गर्वो जगाम बोधितो मया ।\nवरं ददाति वरदस्ततो बोध्यो ह्यहं शिवः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003100041, "chapter_id": 23100, "verse_number": "४-३६-४२", "content_sanskrit": "अथ गर्वान्वितो रुद्रो हन्तुं त्रिपुरमुल्बणम् ।\nमत्वा मनसि संहर्ता सर्वेषां जगतामिति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003100042, "chapter_id": 23100, "verse_number": "४-३६-४३", "content_sanskrit": "कोऽयं पतङ्गवद्दैत्य इति मत्वा ययौ रणम् ।\nविहाय शूलं मद्दत्तं मदीयकवचं परम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003100043, "chapter_id": 23100, "verse_number": "४-३६-४४", "content_sanskrit": "चिरं बभूव समरं वर्षमेकं दिवानिशम् ।\nन कोऽपि जेतुं कं शक्तो द्वौ समौ समरे तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003100044, "chapter_id": 23100, "verse_number": "४-३६-४५", "content_sanskrit": "पृथिव्यां चरणं कृत्वा दैत्येन्द्रो मायया प्रिये ।\nअत्यूर्ध्वं च समुत्तस्थौ पञ्चाशत्कोटियोजनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003100045, "chapter_id": 23100, "verse_number": "४-३६-४६", "content_sanskrit": "उत्तस्थौ शंकरस्तूर्णं हन्तुं दैत्यं जगत्प्रभुः ।\nबभूव तत्र युद्धं च मासमेकं निराश्रये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003100046, "chapter_id": 23100, "verse_number": "४-३६-४७", "content_sanskrit": "अस्त्राणि चापं चिच्छेद शङ्करस्यासुरो बली ।\nरथं बभञ्ज दैत्येन्द्रश्चापमस्त्राणि शङ्करात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003100047, "chapter_id": 23100, "verse_number": "४-३६-४८", "content_sanskrit": "जघान मुष्टिना रुद्रो दानवेन्द्रं प्रकोपतः ।\nवज्रमुष्टिप्रहारेण सद्यो मूर्च्छामवाप सः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003100048, "chapter_id": 23100, "verse_number": "४-३६-४९", "content_sanskrit": "क्षणेन चेतनां प्राप्य कोपाद्दानवपुंगवः ।\nशिवं शयानमुत्तोल्य पातयामास भूतले ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003100049, "chapter_id": 23100, "verse_number": "४-३६-५०", "content_sanskrit": "सरथे पातिते रुद्रे देवा देवर्षयो भिया ।\nतुष्टुवुर्मां परित्राहि कृष्णेत्युक्त्वा पुनःपुनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003100050, "chapter_id": 23100, "verse_number": "४-३६-५१", "content_sanskrit": "हरः सस्मार मामेव निर्भयो भयकारणम् ।\nतुष्टाव भक्त्या स्तोत्रेण मया दत्तेन संकटे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003100051, "chapter_id": 23100, "verse_number": "४-३६-५२", "content_sanskrit": "तदाऽहं कलया शीघ्रं वृषरूपं विधाय च ।\nशयानं शंकरं धृत्वा विषाणाभ्यामुरुक्रमम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003100052, "chapter_id": 23100, "verse_number": "४-३६-५३", "content_sanskrit": "ददौ तस्मै स्वकवचं स्वशूलमरिमर्दनम् ।\nप्राप्य तद्दानवस्थानमत्यूर्ध्वं च निराश्रयम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003100053, "chapter_id": 23100, "verse_number": "४-३६-५४", "content_sanskrit": "मया दत्तेन शूलेन जघान त्रिपुरं हरः ।\nमामेव दर्पहन्तारं तुष्टाव व्रीडितः पुनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003100054, "chapter_id": 23100, "verse_number": "४-३६-५५", "content_sanskrit": "सद्यः पपात दैत्येन्द्रश्चूर्णीभूतश्च भूतले ।\nदेवता मुनयः सर्वे तुष्टुवुः शङ्करं मुदा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003100055, "chapter_id": 23100, "verse_number": "४-३६-५६", "content_sanskrit": "तत्याज शङकरो दर्पं विघ्नबीजं ततो विभुः ।\nज्ञानानन्दस्वरूपश्च निर्लिप्तः सर्वकर्मसु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003100056, "chapter_id": 23100, "verse_number": "४-३६-५७", "content_sanskrit": "ततोऽहं वृषरूपेण वहामि तेन तं प्रियम् ।\nमम प्रियतमो नास्ति त्रैलोक्येषु शिवात्परः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003100057, "chapter_id": 23100, "verse_number": "४-३६-५८", "content_sanskrit": "मनःस्वरूपो ब्रह्मा मे ज्ञानरूपो महेश्वरः ।\nबुद्धिर्भगवती दुर्गा मूलप्रकृतिरीश्वरी ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003100058, "chapter_id": 23100, "verse_number": "४-३६-५९", "content_sanskrit": "निद्रादयः शक्तयो यास्ताः सर्वाः प्रकृतेः कलाः ।\nवागधिष्ठातृदेवी या सा स्वयं च सरस्वती ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003100059, "chapter_id": 23100, "verse_number": "४-३६-६०", "content_sanskrit": "मम कल्याणाधिदेवो हर्षरूपो गणेश्वरः ।\nपरमार्थः स्वयं धर्मो मम भक्तो हुताशनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003100060, "chapter_id": 23100, "verse_number": "४-३६-६१", "content_sanskrit": "सर्वैश्वर्याधिदेवी मे सर्वगोलोकवासिनः ।\nप्राणाधिष्ठातृदेवी त्वं सदा प्राणाघिका मम ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003100061, "chapter_id": 23100, "verse_number": "४-३६-६२", "content_sanskrit": "गोपाङ्गनास्तव कला अत एव मम प्रियाः ।\nमल्लोमकूपजा गोपाः सर्वे गोलोकवासिनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003100062, "chapter_id": 23100, "verse_number": "४-३६-६३", "content_sanskrit": "तेजःस्वरूपः सूर्यश्च प्राणा मे वायवः स्मृताः ।\nजलाधिदेवो वरुणः पृथिवी मे मलोद्भवा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003100063, "chapter_id": 23100, "verse_number": "४-३६-६४", "content_sanskrit": "मम शून्यो महाकाशो मदनो मानसोद्भवः ।\nइन्द्रादयः सुराः सर्वे मत्कलांशांशसंभवाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003100064, "chapter_id": 23100, "verse_number": "४-३६-६५", "content_sanskrit": "एतानि सृष्टिबीजानि महदादीनि चैव हि ।\nसर्वेषां बीजरूपोऽहं स्वयमात्मा निराश्रयः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003100065, "chapter_id": 23100, "verse_number": "४-३६-६६", "content_sanskrit": "जीवो मे प्रतिबिम्बश्च कर्मभोगाधिकारकः ।\nअहं साक्षी निरीहश्च न भोगी सर्वकर्मसु ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003100066, "chapter_id": 23100, "verse_number": "४-३६-६७", "content_sanskrit": "भक्तध्यानार्थदेहोऽयं मम स्वेच्छामयस्य च ।\nप्रकृतिः पुरुषोऽहं च एक एव परात्परः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003100067, "chapter_id": 23100, "verse_number": "४-३६-६८", "content_sanskrit": "इत्येवं कथितं राधे शिवदर्पविमोचनम् ।\nसृष्टिबीजं च शृणु मे पार्वतीदर्पमोचनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003100068, "chapter_id": 23100, "verse_number": "४-३६-६९", "content_sanskrit": "श्रीनारायण उवाच ।\nइत्युक्तवन्तं श्रीकृष्णं परमात्मानमीश्वरम् ।\nपप्रच्छ राधिका देवी निगूढमभिवाञ्छितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003100069, "chapter_id": 23100, "verse_number": "४-३६-७०", "content_sanskrit": "श्रीराधिकोवाच ।\nभगवन्सर्वतत्त्वज्ञ सर्वबीज सनातन ।\nवद मे वाञ्छितं प्रश्नं सर्वसंदेहभञ्जनम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003100070, "chapter_id": 23100, "verse_number": "४-३६-७१", "content_sanskrit": "सर्वज्ञानाधिदेवश्च शंकरः सर्वतत्त्ववित् ।\nमृत्युंजयः कालकालो भगवांस्त्वत्समो महान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003100071, "chapter_id": 23100, "verse_number": "४-३६-७२", "content_sanskrit": "कथं विभूतिगात्रश्च पञ्चवक्त्रस्त्रिलोचनः ।\nदिगम्बरो जटाधारी नागसंघातभूषणः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003100072, "chapter_id": 23100, "verse_number": "४-३६-७३", "content_sanskrit": "वृषेणाटति देवेन्द्रो विहाय वरवाहनम् ।\nन बिभर्ति कथं रत्नसारनिर्माणभूषणम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003100073, "chapter_id": 23100, "verse_number": "४-३६-७४", "content_sanskrit": "वह्निशुद्धांशुकं त्यक्त्वा धत्ते शार्दूलचर्मकम् ।\nधत्ते धत्तूरकुसुमं पारिजातं विहाय च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003100074, "chapter_id": 23100, "verse_number": "४-३६-७५", "content_sanskrit": "नास्ति रत्नकिरीटेच्छा जटायां प्रीतिरुत्तमा ।\nदिव्यलोकं परित्यज्य श्मशानेषु स्पृहा विभोः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003100075, "chapter_id": 23100, "verse_number": "४-३६-७६", "content_sanskrit": "चन्दनागुरुकस्तूरीसुगंधिकुसुमानि च ।\nत्यक्त्वा स्पृहा बिल्वपत्रे बिल्वकाष्ठानुलेपने ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003100076, "chapter_id": 23100, "verse_number": "४-३६-७७", "content_sanskrit": "एतद्वेदितुमिच्छामि व्यासेन कथय प्रभो ।\nश्रोतुं कौतूहलं नाथ वर्द्धते मे मनःस्पृहा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003100077, "chapter_id": 23100, "verse_number": "४-३६-७८", "content_sanskrit": "राधिकावचनं श्रुत्वा प्रहस्य मधुसूदनः।\nकथां कथितुमारेभे कृत्वा राधां स्ववक्षसि ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003100078, "chapter_id": 23100, "verse_number": "४-३६-७९", "content_sanskrit": "श्रीकृष्ण उवाच ।\nयुगषष्टिसहस्राणि तपः कृत्वा महेश्वरः ।\nविरराम पूर्णतमो ध्यात्वा मां मनसा मुदा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003100079, "chapter_id": 23100, "verse_number": "४-३६-८०", "content_sanskrit": "एतस्मिन्नन्तरे मां च ददर्श पुरतः स्थितम् ।\nअतीव कमनीयाङ्गं किशोरं श्यामसुन्दरम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003100080, "chapter_id": 23100, "verse_number": "४-३६-८१", "content_sanskrit": "अहोनिर्वचनीयं च दृष्ट्वा रूपमनुत्तमम् ।\nन बभूव वितृष्णश्च लोचनाभ्यां त्रिलोचनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003100081, "chapter_id": 23100, "verse_number": "४-३६-८२", "content_sanskrit": "पश्यन्निमेषरहित इति मत्वा स्वमानसे ।\nभक्त्युद्रेकान्महाभक्तो रुरोद प्रेमविह्वलः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003100082, "chapter_id": 23100, "verse_number": "४-३६-८३", "content_sanskrit": "सहस्रवदनोऽनन्तो भाग्यवांश्च चतुर्मुखः ।\nबहुभिर्लोचनैर्दृष्ट्वा तुष्टाव बहुभिर्मुखैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003100083, "chapter_id": 23100, "verse_number": "४-३६-८४", "content_sanskrit": "पश्यामि किं वा किं स्तौमि संप्राप्य नाथमीदृशम् ।\nआस्यैकेन लोचनाभ्यां चतुर्द्धा स पुनः पुनः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003100084, "chapter_id": 23100, "verse_number": "४-३६-८५", "content_sanskrit": "स्व मानसे कुर्वतीदं शंकरे च तपस्विनि ।\nतद्बभूव चतुर्वक्त्रं पूर्वेण सह पञ्चमम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003100085, "chapter_id": 23100, "verse_number": "४-३६-८६", "content_sanskrit": "एकैकवक्त्रं शुशुभे लोचनैश्च त्रिभिस्त्रिभिः। ।\nबभूव तेन तन्नाम पञ्चवक्त्रस्त्रिलोचनः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003100086, "chapter_id": 23100, "verse_number": "४-३६-८७", "content_sanskrit": "स्तवनादधिकप्रीतिः शिवस्य दर्शने मम ।\nतेनाधिकानि तस्यैवं बभूवुर्लोचनानि च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003100087, "chapter_id": 23100, "verse_number": "४-३६-८८", "content_sanskrit": "चक्षूंषि गुणरूपाणि तस्य ब्रह्मस्वरूपिणः ।\nसत्त्वं रजस्तम इति तस्य हेतुं निशामय ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003100088, "chapter_id": 23100, "verse_number": "४-३६-८९", "content_sanskrit": "सत्त्वांशेन दृशा शंभुः पश्यन्पाति च सात्त्विकान् ।\nराजसेन राजसिकांस्तामसेन च तामसान् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003100089, "chapter_id": 23100, "verse_number": "४-३६-९०", "content_sanskrit": "चक्षुषस्तामसात्पश्चाल्ललाटस्थाद्धरस्य च ।\nसंहारकाले संहर्तुरग्निराविर्भवेत्क्रुधा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003100090, "chapter_id": 23100, "verse_number": "४-३६-९१", "content_sanskrit": "कोटितालप्रमाणश्च सूर्यकोटिसमप्रभः ।\nलेलिहानो दीर्घशिखस्त्रैलोक्यं दग्धुमीश्वरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003100091, "chapter_id": 23100, "verse_number": "४-३६-९२", "content_sanskrit": "विभूतिगात्रः स विभुः सतीसंस्कारभस्मना ।\nधत्ते तस्या अस्थिमालां प्रेमभावेन भस्म च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003100092, "chapter_id": 23100, "verse_number": "४-३६-९३", "content_sanskrit": "स्वात्मारामो यद्यपीशस्तथाऽपि पूर्णमब्दकम् ।\nसतीशवं गृहीत्वा च भ्रामंभ्रामं रुरोद ह ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003100093, "chapter_id": 23100, "verse_number": "४-३६-९४", "content_sanskrit": "प्रत्यङ्गं चापि तस्याश्च पपात यत्र यत्र ह ।\nसिद्धपीठस्तत्र तत्र बभूव मन्त्रसिद्धिकृत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003100094, "chapter_id": 23100, "verse_number": "४-३६-९५", "content_sanskrit": "तदा शवावशेषं च कृत्वा वक्षसि शंकरः ।\nपपात मूर्च्छितो भूत्वा सिद्धिक्षेत्रे च राधिके ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003100095, "chapter_id": 23100, "verse_number": "४-३६-९६", "content_sanskrit": "तदा गत्वा महेशं तं कृत्वा क्रोडे प्रबोध्य च ।\nअददां दिव्यतत्त्वं च तस्मै शोकहरं परम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003100096, "chapter_id": 23100, "verse_number": "४-३६-९७", "content_sanskrit": "तदा शिवश्च संतुष्टः स्वं लोकं च जगाम ह ।\nमूर्त्यन्तरेण कालेन तां संप्राप प्रियां सतीम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003100097, "chapter_id": 23100, "verse_number": "४-३६-९८", "content_sanskrit": "दिव्यस्रग्धारियोगेन नेच्छा नित्ये परे विभोः ।\nजटां तपस्याकालीनां धत्तेऽद्यापि विवेकतः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003100098, "chapter_id": 23100, "verse_number": "४-३६-९९", "content_sanskrit": "न चेच्छा केशसंस्कारे स्वाङ्गवेषेण योगिनः ।\nसमता चन्दने पङ्के लोष्टे रत्ने मणीश्वरे ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003100099, "chapter_id": 23100, "verse_number": "४-३६-१००", "content_sanskrit": "गरुडद्वेषिणो नागाः शंकरं शरणं ययुः ।\nबिभर्ति कृपया स्वाङ्गे तानेव शरणागतान् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003100100, "chapter_id": 23100, "verse_number": "४-३६-१०१", "content_sanskrit": "वाहनं वृषरूपोऽहमन्यस्तं वोढुमक्षमः ।\nत्रिपुरस्य वधे पूर्वं मत्कलांशसमुद्भवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003100101, "chapter_id": 23100, "verse_number": "४-३६-१०२", "content_sanskrit": "पारिजातादिकं पुष्पसुगन्धि चन्दनादिकम्। ।\nमयि संन्यस्य तेष्वेवं प्रीतिर्नास्ति कदाचन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003100102, "chapter_id": 23100, "verse_number": "४-३६-१०३", "content_sanskrit": "धत्तूरे तत्सदा प्रीतिर्बिल्वपत्रानुलेपने ।\nगन्धहीने सुगन्धे च योगीष्टे व्याघ्रचर्मणि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003100103, "chapter_id": 23100, "verse_number": "४-३६-१०४", "content_sanskrit": "दिव्यलोके दिव्यतल्पे जनतायां न तन्मनः।\nश्मशानेऽतीवरहसि ध्यायते मामहर्निशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003100104, "chapter_id": 23100, "verse_number": "४-३६-१०५", "content_sanskrit": "आब्रह्मस्तम्बपर्यन्तं समं च मन्यते शिवः। ।\nममानिर्वचनीयेऽत्र रूपे तन्मग्नमानसम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003100105, "chapter_id": 23100, "verse_number": "४-३६-१०६", "content_sanskrit": "ब्रह्मणः पतनेनापि शूलपाणेः क्षणो भवेत् ।\nतस्यायुषः प्रमाणं च नाहं जानामि का श्रुतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003100106, "chapter_id": 23100, "verse_number": "४-३६-१०७", "content_sanskrit": "ज्ञानं मृत्युंजयः शूलं धत्ते मत्तेजसा समम् ।\nविना मया न कश्चित्तं शंकरं जेतुमीश्वरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003100107, "chapter_id": 23100, "verse_number": "४-३६-१०८", "content_sanskrit": "शंकरः परमात्मा मे प्राणेभ्योऽपि परः शिवः।\nत्र्यम्बके मन्मनः शश्वन्न प्रियो मे भवात्परः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003100108, "chapter_id": 23100, "verse_number": "४-३६-१०९", "content_sanskrit": "ब्रह्माण्डनिकरं छन्नं मया मन्मायया सदा ।\nस कम्पति हरं शश्वन्न च तं मोहितुं क्षमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003100109, "chapter_id": 23100, "verse_number": "४-३६-११०", "content_sanskrit": "न संवसामि गोलोके वैकुण्ठे तव वक्षसि ।\nसदा शिवस्य हृदये निबद्धः प्रेमपाशतः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003100110, "chapter_id": 23100, "verse_number": "४-३६-१११", "content_sanskrit": "स्वरसिद्धं सुतानेन पञ्चवक्त्रेण शंकरः ।\nशश्वद्गायति मद्गाथां तेनाहं तत्समीपतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003100111, "chapter_id": 23100, "verse_number": "४-३६-११२", "content_sanskrit": "स्रष्टुं शक्तो हि नष्टुं च भ्रूभङ्गलीलयाऽपि यः।\nब्रह्माण्डनिकरं योगान्न योगी शंकरात्परः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003100112, "chapter_id": 23100, "verse_number": "४-३६-११३", "content_sanskrit": "दिव्यज्ञानेन यः स्रष्टुं नष्टुं भ्रूभङ्गलीलया ।\nमृत्युं कालादिकं भक्तो न ज्ञानी शंकरात्परः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003100113, "chapter_id": 23100, "verse_number": "४-३६-११४", "content_sanskrit": "मम भक्तिं च दास्यं च मुक्तिं च सर्वसंपदः।\nसर्वसिद्धिं दातुमीशो न दाता शंकरात्परः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003100114, "chapter_id": 23100, "verse_number": "४-३६-११५", "content_sanskrit": "पञ्चवक्त्रेण मन्नाम यो हि गायत्यहर्निशम् ।\nमद्रूपं ध्यायते शश्वन्न भक्तः शंकरात्परः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003100115, "chapter_id": 23100, "verse_number": "४-३६-११६", "content_sanskrit": "अहं सुदर्शनं शंभुस्तेजसा च वयं समाः ।\nब्रह्मा स्रष्टा च योगेन नास्माभिस्तेजसा समः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003100116, "chapter_id": 23100, "verse_number": "४-३६-११७", "content_sanskrit": "इत्येवं कथितं सर्वे शंकरस्य यशोऽमलम् ।\nतथाऽप्यस्य दर्पभङ्गं किं भूयः श्रोतुमिच्छसि ॥११७।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]