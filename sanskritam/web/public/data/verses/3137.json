[{"id": 2099848, "chapter_id": 3137, "verse_number": "१३-२६७-१", "content_sanskrit": "वैशम्पायन उवाच।\nइत्युक्तवति तद्वाक्यं कृष्णे देवकिनन्दने।\nभीष्मं शान्तनवं भूयः पर्यपृच्छद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099849, "chapter_id": 3137, "verse_number": "१३-२६७-२", "content_sanskrit": "निर्णये वा महाबुद्धे सर्वधर्मविदांवर।\nप्रत्यक्षमागमो वेति किं तयोः कारणं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099850, "chapter_id": 3137, "verse_number": "१३-२६७-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099851, "chapter_id": 3137, "verse_number": "१३-२६७-३", "content_sanskrit": "नास्त्यत्रि संशयः कश्चिदिति मे वर्तते मतिः।\nशृणु वक्ष्यामि ते प्राज्ञ सम्यक्त्वं मेऽनुपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099852, "chapter_id": 3137, "verse_number": "१३-२६७-४", "content_sanskrit": "संशयः सुगमस्तत्र दुर्गमस्तस्य निर्णयः।\nदृष्टं श्रुतमनन्तं हि यत्र संशयदर्शन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099853, "chapter_id": 3137, "verse_number": "१३-२६७-५", "content_sanskrit": "प्रत्यक्षं कारणं दृष्टं हैतुकं प्राज्ञमानिनः।\nनास्तीत्येवं व्यवस्यन्ति सत्यमागममेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099854, "chapter_id": 3137, "verse_number": "१३-२६७-६", "content_sanskrit": "तदयुक्तं व्यवस्यन्ति बालाः पण्डितमानिनः।\nअथ सञ्चिन्त्यमेवैकं कारणं किं भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099855, "chapter_id": 3137, "verse_number": "१३-२६७-७", "content_sanskrit": "शक्यं दीर्घेण कालेन युक्तेनामन्त्रितेन च।\nप्राणयात्रामनेकां च कल्पयानेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099856, "chapter_id": 3137, "verse_number": "१३-२६७-८", "content_sanskrit": "तत्परेणैव नान्येन शक्यते तत्तु कारणम्।\nहेतूनामन्तमासाद्य विपुलं ज्ञानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099857, "chapter_id": 3137, "verse_number": "१३-२६७-९", "content_sanskrit": "ज्योतिः सर्वस्य लोकस्य विपुलं प्रतिपद्यते।\nन त्वेव गमनं राजन्हेतुतो गमनं तथा।\nअग्राह्यमनिबद्धं च वाचा सम्परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099858, "chapter_id": 3137, "verse_number": "१३-२६७-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099859, "chapter_id": 3137, "verse_number": "१३-२६७-१०", "content_sanskrit": "प्रत्यिक्षं लोकतः सिद्धिर्लोकश्चागमपूर्वकः।\nशिष्टाचारो बहुविधस्तन्मे ब्रूहि पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099860, "chapter_id": 3137, "verse_number": "१३-२६७-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099861, "chapter_id": 3137, "verse_number": "१३-२६७-११", "content_sanskrit": "धर्मस्य ह्रियमाणस्य बलवद्भिर्दुरात्मभिः।\nसंस्था यत्नैरपि कृता कालेन प्रतिभिद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099862, "chapter_id": 3137, "verse_number": "१३-२६७-१२", "content_sanskrit": "अधर्मो धर्मरूपेण तृणैः कूप इवावृतः।\nततस्तैर्भिद्यते वृत्तं शृणु चैव युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099863, "chapter_id": 3137, "verse_number": "१३-२६७-१३", "content_sanskrit": "अवृत्त्या ये तु निन्दनि श्रुतत्यागपरायणाः।\nधर्मविद्वेषिणो मन्दा इत्युक्तस्तेषु संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099864, "chapter_id": 3137, "verse_number": "१३-२६७-१४", "content_sanskrit": "अतृप्यन्तस्तु साधूनां यावदागमबुद्धयः।\nपरमित्येव सन्तुष्टास्तानुपास्स्व च पृच्छ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099865, "chapter_id": 3137, "verse_number": "१३-२६७-१५", "content_sanskrit": "कामार्थौ पृष्ठतः कृत्वा लोभमोहानुसारिणौ।\nधर्म इत्येव सम्बुद्धस्तानुपास्स्व च पृच्छ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099866, "chapter_id": 3137, "verse_number": "१३-२६७-१६", "content_sanskrit": "न तेषां भिद्यते वृत्तं यज्ञाः स्वाध्यायकर्म च।\nआचारः कारणं चैव धर्मश्चैकस्त्रयं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099867, "chapter_id": 3137, "verse_number": "१३-२६७-१७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099868, "chapter_id": 3137, "verse_number": "१३-२६७-१७", "content_sanskrit": "पुनरेव हि मे बुद्धि संशये परिमुह्यति।\nअपरो मज्जमानस्य परं तीरमपश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099869, "chapter_id": 3137, "verse_number": "१३-२६७-१८", "content_sanskrit": "वेदः प्रत्यक्षमाचारः प्रमाणं तत्त्रयं यदि।\nपृथक्त्वं लभ्यते चैषां धर्मश्चैतत्त्रयं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099870, "chapter_id": 3137, "verse_number": "१३-२६७-१९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099871, "chapter_id": 3137, "verse_number": "१३-२६७-१९", "content_sanskrit": "धर्मस्य ह्रियमाणस्य बलवद्भिर्दुरात्मभिः।\nयद्येवं मन्यसे राजंस्त्रिधा धर्मविचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099872, "chapter_id": 3137, "verse_number": "१३-२६७-२०", "content_sanskrit": "एक एवेति जानीहि त्रिधा धर्मस्य दर्शनम्।\nपृथक्त्वे च न मे बुद्धिस्त्रयाणामपि वै तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099873, "chapter_id": 3137, "verse_number": "१३-२६७-२१", "content_sanskrit": "[उक्तो मार्गस्त्रयाणां च तत्तथैव समाचर।\nजिज्ञासा न तु कर्तव्या धर्मस्य परितर्कणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099874, "chapter_id": 3137, "verse_number": "१३-२६७-२२", "content_sanskrit": "सदैव भरतश्रेष्ठ मा ते भूदत्र संशयः।\nअन्धो जड इवाशङ्की यद्ब्रवीमि तदाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099875, "chapter_id": 3137, "verse_number": "१३-२६७-२३", "content_sanskrit": "अहिंसा सत्यमक्रोधो दानमेतच्चतुष्टयम्।\nअजातशत्रो सेवस्य धर्म एष सनातनः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099876, "chapter_id": 3137, "verse_number": "१३-२६७-२४", "content_sanskrit": "ब्राह्मणेषु च वृत्तिर्या पितृपैतामहोचिता।\nतामन्वेहि महाबाहो धर्मस्यैते हि देशिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099877, "chapter_id": 3137, "verse_number": "१३-२६७-२५", "content_sanskrit": "प्रमाणमप्रमाणं वै यः कुर्यादबुधो जनः।\nन स प्रमाणतामर्हो विषादजननो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099878, "chapter_id": 3137, "verse_number": "१३-२६७-२६", "content_sanskrit": "ब्राह्मणानेव सेवस्व सत्कृत्य बहुमान्य च।\nएतेष्वेव त्विमे लोकाः कृत्स्ना इति निबोध तान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099879, "chapter_id": 3137, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तषष्ट्यधिकद्विशततमोऽध्यायः॥ २६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]