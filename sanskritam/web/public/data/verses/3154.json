[{"id": 2100469, "chapter_id": 3154, "verse_number": "१४-१०-१", "content_sanskrit": "इन्द्र उवाच।\nएवमेतद्ब्रह्मबलं गरीयो\nन ब्राह्मणात्किञ्चिदन्यद्ररीयः।\nआविक्षितस्य तु बलं न मृष्ये\nवज्रमस्मै प्रहरिष्यामि घोरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100470, "chapter_id": 3154, "verse_number": "१४-१०-२", "content_sanskrit": "धृतराष्ट्र गच्छ प्रहितो मरुत्तं\nसंवर्तेन सङ्गतं तं वदस्व\nबृहस्पतिं त्वमुपशिक्षस्व राज-\nन्वज्रं वा ते प्रहरिष्यामि घोरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100471, "chapter_id": 3154, "verse_number": "१४-१०-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100472, "chapter_id": 3154, "verse_number": "१४-१०-३", "content_sanskrit": "ततो गत्वा धृतराष्ट्रो नरेन्द्रं\nप्रोवाचेदं वचनं वासवस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100473, "chapter_id": 3154, "verse_number": "१४-१०-४", "content_sanskrit": "गन्धर्वं मां धृतराष्ट्रं निबोध\nत्वामागतं वक्तुकामं नरेन्द्र।\nऐन्द्रं वाक्यं शृणु मे राजसिंह\nयत्प्राह लोकाधिपतिर्महात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100474, "chapter_id": 3154, "verse_number": "१४-१०-५", "content_sanskrit": "बृहस्पतिं याजकं त्वं वृणीष्व\nवज्रं वा ते प्रहरिष्यामि घोरम्।\nवचश्चेदेतन्न करिष्यसे मे\nप्राहैतदेतावदचिन्त्यकर्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100475, "chapter_id": 3154, "verse_number": "१४-१०-६x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100476, "chapter_id": 3154, "verse_number": "१४-१०-६", "content_sanskrit": "त्वं चैवैतद्वेत्थ पुरन्दरश्च\nविश्वेदेवा वसवश्चाश्विनौ च।\nमित्रद्रोहे निष्कृतिर्नास्ति लोके\nमहत्पापं ब्रह्महत्यासमं तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100477, "chapter_id": 3154, "verse_number": "१४-१०-७", "content_sanskrit": "बृहस्पतिर्याजयतां महेन्द्रं\nदेवश्रेष्ठं वज्रभृतां वरिष्ठम्।\nसंवर्तो मां याजयिताऽद्य राज-\nन्न ते वाक्यं तस्य वा रोचयामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100478, "chapter_id": 3154, "verse_number": "१४-१०-८x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100479, "chapter_id": 3154, "verse_number": "१४-१०-८", "content_sanskrit": "घोरो नादः श्रूयतां वासवस्य\nनभस्तले गर्जतो राजसिंह।\nव्यक्तं वज्रं मोक्ष्यते ते महेन्द्रः\nक्षेमं राजंश्चिन्त्यतामेष कालः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100480, "chapter_id": 3154, "verse_number": "१४-१०-९x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100481, "chapter_id": 3154, "verse_number": "१४-१०-९", "content_sanskrit": "इत्येवमुक्तो धृतराष्ट्रेण राज-\nञ्श्रुत्वा नादं नदतो वासवस्य।\nतपोनित्यं धर्मविदां वरिष्ठं\nसंवर्तं तं ज्ञापयामास कार्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100482, "chapter_id": 3154, "verse_number": "१४-१०-१०x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100483, "chapter_id": 3154, "verse_number": "१४-१०-१०", "content_sanskrit": "पश्यात्मानं प्लवमानं त्वमारा-\nदध्वा दूरं तेन न दृश्यतेऽद्य।\nप्रपद्येऽहं शर्म विप्रेन्द्र त्वत्तः\nप्रयच्छ तस्मादभयं विप्रमुख्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100484, "chapter_id": 3154, "verse_number": "१४-१०-११", "content_sanskrit": "अयमायाति वे वज्री दिशो विद्योतयन्दस।\nअमानुषेण घोरेणि सदस्यास्त्रासिता हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100485, "chapter_id": 3154, "verse_number": "१४-१०-१२x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100486, "chapter_id": 3154, "verse_number": "१४-१०-१२", "content_sanskrit": "भयं शक्राद्व्येतु ते राजसिंह\nप्रणोत्स्येऽहं भयमेतत्सुघोरम्।\nसंस्तम्भिन्या विद्यया क्षिप्रमेव\nमा भैस्त्वमस्याभिभवात्प्रतीतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100487, "chapter_id": 3154, "verse_number": "१४-१०-१३", "content_sanskrit": "अहं संस्तम्भयिष्यामि मा भैस्त्वं शक्रतो नृप।\nयर्वेषामेव देवानां क्षयितान्यायुधानि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100488, "chapter_id": 3154, "verse_number": "१४-१०-१४", "content_sanskrit": "दिशो वज्रं व्रजतां वायुरेतु\nवर्षं भूत्वा वर्षतां काननेषु।\nआपः प्लवन्त्वन्तरिक्षे वृथा च\nसौदामनी दृश्यते माऽपि भैस्त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100489, "chapter_id": 3154, "verse_number": "१४-१०-१५", "content_sanskrit": "वह्निर्देवस्त्रातु वा सर्वतस्ते\nकामान्सर्वान्वर्षतु वासवो वा।\nवज्रं तथा स्थापयतां वधाय\nमहाघोरं पुवमानं जलौघैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100490, "chapter_id": 3154, "verse_number": "१४-१०-१६x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100491, "chapter_id": 3154, "verse_number": "१४-१०-१६", "content_sanskrit": "घोरः शब्दः श्रूयते वै महास्वनो\nवज्रस्यैष सहितो मारुतेन।\nआत्मा हि मे प्रव्यथते मुहुर्मुहु-\nर्न मे स्वास्थ्यं जायते चाद्य विप्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100492, "chapter_id": 3154, "verse_number": "१४-१०-१७x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100493, "chapter_id": 3154, "verse_number": "१४-१०-१७", "content_sanskrit": "वज्रादुग्राद्व्येतु भयं तवाद्य\nवातो भूत्वा व्रजतु नरेन्द्र वज्रम्।\nभयं त्वक्त्वा वरमन्यं वृणीष्व\nकं ते कामं तपसा साधयामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100494, "chapter_id": 3154, "verse_number": "१४-१०-१८x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100495, "chapter_id": 3154, "verse_number": "१४-१०-१८", "content_sanskrit": "इन्द्रः साक्षात्सहसाऽभ्येतु विप्र\nहविर्यज्ञे प्रतिगृह्णातु चैव।\nस्वंस्वं हविश्चैव जुषन्तु देवा\nहुतं सोमं प्रतिगृह्णन्तु चैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100496, "chapter_id": 3154, "verse_number": "१४-१०-१९x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100497, "chapter_id": 3154, "verse_number": "१४-१०-१९", "content_sanskrit": "अयमिन्द्रो हरिभिरायाति राज-\nन्देवैः सर्वैस्त्वरितैः स्तूयमानः।\nमन्त्राहूतो यज्ञमिमं मयाऽद्य\nपश्यश्वैनं मन्त्रविस्रस्तकायम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100498, "chapter_id": 3154, "verse_number": "१४-१०-२०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100499, "chapter_id": 3154, "verse_number": "१४-१०-२०", "content_sanskrit": "ततो देवैः सहितो देवराजो\nरथे युङ्क्त्वा तान्हरीन्वाजिमुख्यान्।\nआयाद्यज्ञमथ राज्ञः पिपासु-\nराविक्षितस्याप्रमेयस्य सोमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100500, "chapter_id": 3154, "verse_number": "१४-१०-२१", "content_sanskrit": "तमायान्तं सहितं देवसङ्घैः\nप्रत्युद्ययौ सपुरोधा मरुत्तः।\nचक्रे पूजां देवराजाय चाग्र्यां\nयथाशास्त्रं विधिवत्प्रीयमाणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100501, "chapter_id": 3154, "verse_number": "१४-१०-२२x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100502, "chapter_id": 3154, "verse_number": "१४-१०-२२", "content_sanskrit": "सुस्वागतं ते पुरुहूतेह विद्व-\nन्यज्ञोऽप्ययं सन्निहिते त्वयीन्द्र।\nशोशुभ्यते बलवृत्रघ्न भूयः\nपिबस्व सोमं सुतमुद्यतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100503, "chapter_id": 3154, "verse_number": "१४-१०-२३x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100504, "chapter_id": 3154, "verse_number": "१४-१०-२३", "content_sanskrit": "शिवेन मां पश्य नमश्च तेऽस्तु\nप्राप्तो यज्ञः सफलं जीवितं मे।\nअयं यज्ञं कुरुते मे सुरेन्द्र\nबृहस्पतेरवरो जन्मना च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100505, "chapter_id": 3154, "verse_number": "१४-१०-२४x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100506, "chapter_id": 3154, "verse_number": "१४-१०-२४", "content_sanskrit": "जानामि ते गुरुमेनं तपोधनं\nबृहस्पतेरनुजं तिग्मतेजसम्\nयस्याह्वानादागतोऽहं नरेन्द्र\nप्रीतिर्मेऽद्य त्वयि मन्युः प्रनष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100507, "chapter_id": 3154, "verse_number": "१४-१०-२५x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100508, "chapter_id": 3154, "verse_number": "१४-१०-२५", "content_sanskrit": "यदि प्रीतस्त्वमसि वै देवराज\nतस्मात्स्वयं शाधि यज्ञे विधानम्।\nस्वयं सर्वान्कुरु भागान्सुरेन्द्र\nजानात्वयं सर्वलोकश्च देव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100509, "chapter_id": 3154, "verse_number": "१४-१०-२६x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100510, "chapter_id": 3154, "verse_number": "१४-१०-२६", "content_sanskrit": "एवमुक्तस्त्वाङ्गिरसेन शक्रः\nसमादिदेश स्वयमेव देवान्।\nसभाः क्रियन्तामावसथाश्च मुख्याः\nसहस्रशश्चित्रभूताः समृद्धाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100511, "chapter_id": 3154, "verse_number": "१४-१०-२७", "content_sanskrit": "क्लृप्ताः स्थूणाः कुरुतारोहणानि\nगन्धर्वाणामप्सरसां च शीघ्रम्।\nयत्र नृत्येरन्नप्सरसः समस्ताः\nस्वर्गोपमः क्रियतां यज्ञवाटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100512, "chapter_id": 3154, "verse_number": "१४-१०-२८", "content_sanskrit": "इत्युक्तास्ते चक्रुराशु प्रतीता\nदिवौकसः शक्रवाक्यान्नरेन्द्र।\nततो वाक्यं प्राह राजानमिन्द्रः\nप्रीतो राजन्पूज्यमानो मरुत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100513, "chapter_id": 3154, "verse_number": "१४-१०-२९", "content_sanskrit": "एष त्वयाऽहमिह राजन्समेत्य\nये चाप्यन्ते तव पूर्वे नरेन्द्र।\nसर्वाश्चान्या देवताः प्रीयमाणा\nहविस्तुभ्यं प्रतिगृह्णन्तु राजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2100514, "chapter_id": 3154, "verse_number": "१४-१०-३०", "content_sanskrit": "आग्नेयं वै लोहितमालभन्तां\nवैश्वदेवं बहुरूपं हि राजन्।\nनिलं चोक्षाणं मेद्यमप्यालभन्तां\nचलच्छिश्नं सम्प्रदिष्टं द्विजाग्र्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2100515, "chapter_id": 3154, "verse_number": "१४-१०-३१", "content_sanskrit": "ततो यज्ञो ववृधे तस्य राज-\nन्यत्र देवाः स्वयमन्नानि जह्रुः।\nयस्मिञ्शक्रो ब्राह्मणैः पूज्यमानः\nसदस्योऽभूद्धरिमान्देवराजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2100516, "chapter_id": 3154, "verse_number": "१४-१०-३२", "content_sanskrit": "ततः संवर्तश्चैत्यगतो माहात्मा\nयथा वह्निः प्रज्वलितो द्वितीयः।\nहवींष्युच्चैराह्वयन्देवसङ्घा-\nञ्जुहावाग्नौ मन्त्रवत्सुप्रतीतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2100517, "chapter_id": 3154, "verse_number": "१४-१०-३३", "content_sanskrit": "ततः पीत्वा बलभित्सोममग्र्यं\nये चाप्यन्ते सोमपा देवसङ्घाः।\nसर्वेऽनुज्ञाताः प्रययुः पार्थिवेन\nयथाजोषं तर्पिताः प्रीतिमन्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2100518, "chapter_id": 3154, "verse_number": "१४-१०-३४", "content_sanskrit": "ततो राजा जातरूपस्य राशी-\nन्पदेपदे कारयामास हृष्टः।\nद्विजातिभ्यो विसृजन्भूरि वित्तं\nरराज वित्तेश इवारिहन्ता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2100519, "chapter_id": 3154, "verse_number": "१४-१०-३५", "content_sanskrit": "ततो वित्तं विविधं सन्निधाय\nयथोत्साहं कारयित्वा च कोशम्।\nअनुज्ञातो गुरुणां संनिवृत्त्य\nशशास गामखिलां सागरान्ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2100520, "chapter_id": 3154, "verse_number": "१४-१०-३६", "content_sanskrit": "एवंगुणः सम्बभूवेह राजा\nयस्य क्रतौ तत्सुवर्णं प्रभूतम्।\nतत्त्वं समादाय नरेन्द्र वित्तं\nयजस्व देवांस्तपनीयैर्विधानैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2100521, "chapter_id": 3154, "verse_number": "१४-१०-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2100522, "chapter_id": 3154, "verse_number": "१४-१०-३७", "content_sanskrit": "ततो राजा पाण्डवो हृष्टरूपः\nश्रुत्वा वाक्यं सत्यवत्याः सुतस्य।\nमनश्चक्रे तेन वित्तेन यष्टुं\nततोऽमात्यैर्मन्त्रयामास भूयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2100523, "chapter_id": 3154, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि दशमोऽध्यायः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]