[{"id": 2211581, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2211582, "chapter_id": 5512, "verse_number": "१", "content_sanskrit": "एवं श्रुत्वा परं पुण्यं कपिलादानमुत्तमम् ।\nधर्मपुत्रः प्रहृष्टात्मा केशवं पुनरब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2211583, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2211584, "chapter_id": 5512, "verse_number": "२", "content_sanskrit": "देवदेवेश कपिला यदा विप्राय दीयते ।\nकथं सर्वेषु चाङ्गेषु तस्यास्तिष्ठन्ति देवताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2211585, "chapter_id": 5512, "verse_number": "३", "content_sanskrit": "याश्चैताः कपिलाः प्रोक्ता दश चैव त्वया मम ।\nतासां कति सुरश्रेष्ठ कपिलाः पुण्यलक्षणाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2211586, "chapter_id": 5512, "verse_number": "४", "content_sanskrit": "कथं वाऽनुगृहीतास्ताः सुरैः पितृगणैरपि ।\nकेन युक्ताश्च वर्णेन श्रोतुं कौतूहलं हि मे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2211587, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2211588, "chapter_id": 5512, "verse_number": "५", "content_sanskrit": "युधिष्ठिरेणैवमुक्तः केशवः सत्यवाक् तदा ।\nगुह्यानां परमं गुह्यं वक्तुमेवोपचक्रमे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2211589, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2211590, "chapter_id": 5512, "verse_number": "६", "content_sanskrit": "शृणु राजन् पवित्रं वै रहस्यं धर्ममुत्तमम् ।\nग्रहणीयं सत्यमिदं न श्राव्यं हेतुवादिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2211591, "chapter_id": 5512, "verse_number": "७", "content_sanskrit": "यदा वत्सस्य पादौ द्वौ प्रसवे शिरसा सह ।\nदृश्येते दानकालं तमाहुः कालविदो जनाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2211592, "chapter_id": 5512, "verse_number": "८", "content_sanskrit": "अन्तरिक्षगतो वत्सो यावद्भूमिं न यास्यति ।\nगौस्तावत् पृथिवी ज्ञेया तस्माद् देया तु तादृशी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2211593, "chapter_id": 5512, "verse_number": "९", "content_sanskrit": "यावन्ति धेनो रोमाणि सवत्साया युधिष्ठिर ।\nतावन्त्यः सिकताश्चापि गर्भोदकपरिप्लुताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2211594, "chapter_id": 5512, "verse_number": "१०", "content_sanskrit": "तावद् वर्षसहस्राणि दाता स्वर्गे महीयते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2211595, "chapter_id": 5512, "verse_number": "११", "content_sanskrit": "सुवर्णाभरणां कृत्वा सवत्सां कपिलां तिलैः ।\nप्रच्छाद्य तां तु दद्याद् वै सर्वरत्नैरलङ्कृताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2211596, "chapter_id": 5512, "verse_number": "१२", "content_sanskrit": "ससमुद्रनदी तेन सशैलवनकानना ।\nचतुरन्ता भवेद् दत्ता नात्र कार्या विचारणा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2211597, "chapter_id": 5512, "verse_number": "१३", "content_sanskrit": "पृथिवीदानतुल्येन तेन दानेन मानवः ।\nसंसारसागरात् तीर्णो याति लोकं प्रजापतेः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2211598, "chapter_id": 5512, "verse_number": "१४", "content_sanskrit": "ब्रह्महा यदि वा गोघ्नो भ्रूणहा गुरुतल्पगः ।\nमहापातकयुक्तोऽपि दानेनानेन शुद्ध्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2211599, "chapter_id": 5512, "verse_number": "१५", "content_sanskrit": "इदं पठति यः पुण्यं कपिलादानमुत्तमम् ।\nप्रातरुत्थाय मद्भक्त्या तस्य पुण्यफलं शृणु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2211600, "chapter_id": 5512, "verse_number": "१६", "content_sanskrit": "मनसा कर्मणा वाचा मतिपूर्वं युधिष्ठिर ।\nपापं रात्रिकृतं हन्याद् अस्याध्यायस्य पाठकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2211601, "chapter_id": 5512, "verse_number": "१७", "content_sanskrit": "इदमावर्तमानस्तु श्राद्धे यस्तर्पयेद् द्विजान् ।\nतस्याप्यमृतमश्नन्ति पितरोऽत्यन्तहर्षिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2211602, "chapter_id": 5512, "verse_number": "१८", "content_sanskrit": "यश्चेदं शृणुयाद् भक्त्या मद्गतेनान्तरात्मना ।\nतस्य रात्रिकृतं सर्वं पापमाशु प्रणश्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2211603, "chapter_id": 5512, "verse_number": "१९", "content_sanskrit": "अतः परं विशेषं तु कपिलानां ब्रवीमि ते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2211604, "chapter_id": 5512, "verse_number": "२०", "content_sanskrit": "याश्चैताः कपिलाः प्रोक्ता दश राजन् मया तव ।\nतासां चतस्रः प्रवराः पुण्याः पापप्रनाशनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2211605, "chapter_id": 5512, "verse_number": "२१", "content_sanskrit": "सुवर्णकपिला पुण्या तथा रक्ताक्षिपिङ्गला ।\nपिङ्गलाक्षी च या गौश्च या स्यात् पिङ्गलपिङ्गला ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2211606, "chapter_id": 5512, "verse_number": "२२", "content_sanskrit": "एताश्चतस्रः प्रवराः पवित्राः पापनाशनाः ।\nनमस्कृता वा स्पृष्टा वा घ्नन्ति पापं नरस्य तु ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2211607, "chapter_id": 5512, "verse_number": "२३", "content_sanskrit": "यस्यैताः कपिलाः सन्ति गृहे पापप्रणाशनाः ।\nतत्र श्रीर्विजयः कीर्तिः स्थिरा नित्यं युधिष्ठिर ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2211608, "chapter_id": 5512, "verse_number": "२४", "content_sanskrit": "एतासां प्रीतिमायाति क्षीरेण तु वृषध्वजः ।\nदध्ना च त्रिदशाः सर्वे घृतेन च हुताशनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2211609, "chapter_id": 5512, "verse_number": "२५", "content_sanskrit": "पिता पितामहाश्चैव तथैव प्रपितामहाः ।\nसकृद्दत्तेन तुष्यन्ति वर्षकोटिं युधिष्ठिर ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2211610, "chapter_id": 5512, "verse_number": "२६", "content_sanskrit": "कपिलानां घृतं क्षीरं दधि पायसमेव वा ।\nश्रोत्रियेभ्यः सकृद्दत्ता नरः पापैः प्रमुच्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2211611, "chapter_id": 5512, "verse_number": "२७", "content_sanskrit": "उपवासं तु यः कृत्वाऽप्यहोरात्रं जितेन्द्रियः ।\nकपिलापञ्चगव्यं तु पीत्वा चान्द्रायणात् परम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2211612, "chapter_id": 5512, "verse_number": "२८", "content_sanskrit": "सौम्ये मुहूर्ते तत् प्राश्य शुद्धात्मा शुद्धमानसः ।\nक्रोधानृतविनिर्मुक्तो मद्गतेनान्तरात्मना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2211613, "chapter_id": 5512, "verse_number": "२९", "content_sanskrit": "कपिलापञ्चगव्येन समन्त्रेण पृथक् पृथक् ।\nयो मत्प्रतिकृतिं वाऽपि शङ्कराकृतिमेव वा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2211614, "chapter_id": 5512, "verse_number": "३०", "content_sanskrit": "स्नापयेद् विषुवे यस्तु सोऽश्वमेधफलं लभेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2211615, "chapter_id": 5512, "verse_number": "३१", "content_sanskrit": "स मुक्तपापः पूतात्मा यानेनाम्बरशोभिना ।\nमम लोकं व्रजेन्मुक्तो रुद्रलोकमथापि वा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2211616, "chapter_id": 5512, "verse_number": "३२", "content_sanskrit": "ब्रह्मणा तु पुरा सृष्टा कपिला काञ्चनप्रभा ।\nअग्निकुण्डात् परैर्मन्त्रैर्होमधेनुर्महाप्रभा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2211617, "chapter_id": 5512, "verse_number": "३३", "content_sanskrit": "सृष्टमात्रां तु तां दृष्ट्वा देवा रुद्रादयो दिवि ।\nसिद्धा ब्रह्मर्षयश्चैव वेदाः साङ्गाः सहाध्वराः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2211618, "chapter_id": 5512, "verse_number": "३४", "content_sanskrit": "सागराः सरितश्चैव पर्वताः सबलाहकाः ।\nगन्धर्वाप्सरसो यक्षाः पन्नगाश्चाप्युपस्थिताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2211619, "chapter_id": 5512, "verse_number": "३५", "content_sanskrit": "सर्वे विस्मयमापन्नाः शिखिमध्ये महाप्रभाम् ।\nमन्त्रैश्च विविधैः सर्वास्तुष्टुवुस्तामनेकशः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2211620, "chapter_id": 5512, "verse_number": "३६", "content_sanskrit": "कृताञ्जलिपुटाः सर्वे ताम्रशृङ्गीं त्रिलोचनाम् ।\nशिरोभिः पतिता भूमौ सवत्साममृतारणिम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2211621, "chapter_id": 5512, "verse_number": "३७", "content_sanskrit": "ऊचुः प्राञ्जलयः सर्वे चतुर्वक्त्रं पितामहम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2211622, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "देवताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2211623, "chapter_id": 5512, "verse_number": "३८", "content_sanskrit": "आज्ञापय महादेव किं ते कर्म प्रियं विभो ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2211624, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2211625, "chapter_id": 5512, "verse_number": "३९", "content_sanskrit": "एवमुक्तः सुरैः सर्वैर्ब्रह्मा वचनमब्रवीत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2211626, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2211627, "chapter_id": 5512, "verse_number": "४०", "content_sanskrit": "भवन्तोऽप्यनुगृह्णन्तु दोग्ध्रीमेनां पयस्विनीम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2211628, "chapter_id": 5512, "verse_number": "४१", "content_sanskrit": "होमधेनुरियं यज्ञे ह्यग्नीन् सन्तर्पयिष्यति ।\nअतोऽग्निस्तर्पितः सर्वान् भवतस्तर्पयिष्यति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2211629, "chapter_id": 5512, "verse_number": "४२", "content_sanskrit": "प्रीताः क्षीरामृतेनास्या जातवीर्यपराक्रमाः ।\nजयिष्यथ यथाकामं दानवान् सर्व एव तु ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2211630, "chapter_id": 5512, "verse_number": "४३", "content_sanskrit": "जातवीर्यबलैश्वर्याः सत्त्ववन्तो जितारयः ।\nसदेवमातृकाः सर्वाः पालयिष्यथ वै प्रजाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2211631, "chapter_id": 5512, "verse_number": "४४", "content_sanskrit": "पालिताश्च प्रजाः सर्वा भवद्भिरिह धर्मतः ।\nपूजयिष्यन्ति वो नित्यं यज्ञैर्विविधदक्षिणैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2211632, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2211633, "chapter_id": 5512, "verse_number": "४५", "content_sanskrit": "एवमुक्ताः सुराः सर्वे ब्रह्मणा परमेष्ठिना ।\nततः संहृष्टमनसः कपिलायै वरं ददुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2211634, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "देवताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2211635, "chapter_id": 5512, "verse_number": "४६", "content_sanskrit": "यस्माल्लोकहितायाद्य ब्रह्मणा त्वं विनिर्मिता ।\nतस्मात् पूता पवित्रा च भव पापव्यपोहनी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2211636, "chapter_id": 5512, "verse_number": "४७", "content_sanskrit": "ये त्वां दृष्ट्वा नमस्यन्ति स्पृशन्ति च करैर्नराः ।\nतेषां वर्षकृतं पापं त्वद्भक्तानां प्रणश्यति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2211637, "chapter_id": 5512, "verse_number": "४८", "content_sanskrit": "अकामकृतमज्ञातमदृष्टं यत्तु पातकम् ।\nत्वां दृष्ट्वा ये नमस्यन्ति नराः सर्वंसहेति च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2211638, "chapter_id": 5512, "verse_number": "४९", "content_sanskrit": "तेषां तद्विलयं याति तमः सूर्योदये यथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2211639, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2211640, "chapter_id": 5512, "verse_number": "५०", "content_sanskrit": "इत्युक्त्वाऽस्यै वरं दत्त्वा प्रययुस्ते यथागतम् ।\nलोकनिस्तरणार्थाय सा च लोकांश्चचार ह ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2211641, "chapter_id": 5512, "verse_number": "५१", "content_sanskrit": "तस्यामेव समुद्भूताः शेषाश्च कपिला नव ।\nविचरन्ति महीमेनां लोकानुग्रहकारणात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2211642, "chapter_id": 5512, "verse_number": "५४", "content_sanskrit": "तस्मात्तु कपिला देया परत्र हितमिच्छता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2211643, "chapter_id": 5512, "verse_number": "५३", "content_sanskrit": "यदा च दीयते राजन् कपिला ह्यग्निहोत्रिणे ।\nतदाऽग्रशृङ्गयोस्तस्या विष्णुरिन्द्रश्च तिष्ठतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2211644, "chapter_id": 5512, "verse_number": "५४", "content_sanskrit": "चन्द्रवज्रधरौ चापि तिष्ठतः शृङ्गमूलयोः ।\nशृङ्गमध्ये तथा ब्रह्मा ललाटे गोवृषध्वजः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2211645, "chapter_id": 5512, "verse_number": "५५", "content_sanskrit": "कर्णयोरश्विनौ देवौ चक्षुषोः शशिभास्करौ ।\nदन्तेषु मरुतो देवा जिह्वायां च सरस्वती ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2211646, "chapter_id": 5512, "verse_number": "५६", "content_sanskrit": "रोमान्ते मुनयः सर्वे चर्मण्येव प्रजापतिः ।\nनिःश्वासेषु स्थिता वेदाः सषडङ्गपदक्रमाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2211647, "chapter_id": 5512, "verse_number": "५७", "content_sanskrit": "नासापुटे स्थिता गन्धाः पुष्पाणि सुरभीणि च ।\nअधरे वसवः सर्वे मुखे चाग्निः प्रतिष्ठितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2211648, "chapter_id": 5512, "verse_number": "५८", "content_sanskrit": "साध्या देवाः स्थिताः कक्षे ग्रीवायां पार्वती स्थिता ।\nपृष्ठे च नक्षत्रगणाः ककुद्देशे नभः स्थितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2211649, "chapter_id": 5512, "verse_number": "५९", "content_sanskrit": "अपाने सर्वतीर्थानि गोमूत्रे जाह्नवी स्वयम् ।\nअष्टैश्वर्यमयी लक्ष्मीर्गोमये वसते तदा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2211650, "chapter_id": 5512, "verse_number": "६०", "content_sanskrit": "नासिकायां सदा देवी ज्येष्ठा वसति भामिनी ।\nश्रोणीतटस्थाः पितरो रमालाङ्गूलमाश्रिताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2211651, "chapter_id": 5512, "verse_number": "६१", "content_sanskrit": "पार्श्वयोरुभयोः सर्वे विश्वे देवाः प्रतिष्ठिताः ।\nतिष्ठत्युरसि तासां तु प्रीतः शक्तिधरो गुहः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2211652, "chapter_id": 5512, "verse_number": "६२", "content_sanskrit": "जानुजङ्घोरुदेशेषु पञ्च तिष्ठन्ति वायवः ।\nखुरमध्येषु गन्धर्वाः खुराग्रेषु च पन्नगाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2211653, "chapter_id": 5512, "verse_number": "६३", "content_sanskrit": "चत्वारः सागराः पूर्णास्तस्या एव पयोधराः ।\nरतिर्मेधा क्षमा स्वाहा श्रद्धा शान्तिर्धृतिः स्मृतिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2211654, "chapter_id": 5512, "verse_number": "६४", "content_sanskrit": "कीर्तिर्दीप्तिः क्रिया कान्तिस्तुष्टिः पुष्टिश्च सन्ततिः ।\nदिशश्च विदिशश्चैव सेवन्ते कपिलां सदा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2211655, "chapter_id": 5512, "verse_number": "६५", "content_sanskrit": "देवाः पितृगणाश्चापि गन्धर्वाप्सरसां गणाः ।\nलोका द्विपार्णवाश्चैव गङ्गाद्याः सरितस्तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2211656, "chapter_id": 5512, "verse_number": "६६", "content_sanskrit": "ग्रहाः पितृगणाश्चापि वेदाः साङ्गाः सहाध्वरैः ।\nवेदोक्तैर्विविधैर्मन्त्रैः स्तुवन्ति हृषितास्तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2211657, "chapter_id": 5512, "verse_number": "६७", "content_sanskrit": "विद्याधराश्च ये सिद्धा भूतास्तारागणास्तथा ।\nपुष्पवृष्टिं च वर्षन्ति प्रनृत्यन्ति च हर्षिताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2211658, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2211659, "chapter_id": 5512, "verse_number": "६८", "content_sanskrit": "ब्रह्मणोत्पादिता देवी वह्निकुण्डात् महाप्रभा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2211660, "chapter_id": 5512, "verse_number": "६९", "content_sanskrit": "नमस्ते कपिले पुण्ये सर्वदेवैर्नमस्कृते ।\nकपिलेऽथ महासत्वे सर्वतीर्थमये शुभे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2211661, "chapter_id": 5512, "verse_number": "७०", "content_sanskrit": "दातारं स्वजनोपेतं ब्रह्मलोकं नय स्वयम् ।\nअहो रत्नमिदं पुण्यं सर्वदुःखघ्नमुत्तमम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2211662, "chapter_id": 5512, "verse_number": "७१", "content_sanskrit": "अहो धर्मार्जितं शुद्धमिदमग्र्यं महद्धनम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2211663, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2211664, "chapter_id": 5512, "verse_number": "७२", "content_sanskrit": "इत्याकाशस्थितास्ते तु जल्पन्ति च रमन्ति च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2211665, "chapter_id": 5512, "verse_number": "७३", "content_sanskrit": "तस्याः प्रतिग्रहीता च भुङ्क्ते यावद् द्विजोत्तमः ।\nतावद् देवगणाः सर्वे कपिलामर्चयन्ति वै ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2211666, "chapter_id": 5512, "verse_number": "७४", "content_sanskrit": "स्वर्णशृङ्गीं रूप्यखुरां गन्धैः पुष्पैः सुपूजिताम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2211667, "chapter_id": 5512, "verse_number": "७५", "content_sanskrit": "वस्त्राभ्यामहताभ्यां तु यावत् तिष्ठत्यलङ्कृता ।\nतावद् यदिच्छेत् कपिला मन्त्रपूता सुसंस्कृता ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2211668, "chapter_id": 5512, "verse_number": "७६", "content_sanskrit": "भूलोकवासिनः सर्वान् ब्रह्मलोकं नयेत् स्वयम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2211669, "chapter_id": 5512, "verse_number": "७७", "content_sanskrit": "भूरश्वः कनकं गावो रूप्यमन्नं तिला यवाः ।\nदीयमानानि विप्राय प्रहृष्यन्ति दिने दिने ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2211670, "chapter_id": 5512, "verse_number": "७८", "content_sanskrit": "अथ त्वश्रोत्रियेभ्यो वै तानि दत्तानि पाण्डव ।\nतथा निन्दन्त्यथात्मानमशुभं किं नु नः कृतम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2211671, "chapter_id": 5512, "verse_number": "७९", "content_sanskrit": "अहो रक्षः पिशाचैश्च लुप्यमानाः समन्ततः ।\nयास्यामो निरयं शीघ्रमिति शोचन्ति तानि वै ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2211672, "chapter_id": 5512, "verse_number": "८०", "content_sanskrit": "एतान्यपि द्विजेभ्यो वै श्रोत्रियेभ्यो विशेषतः ।\nदीयमानानि हृष्यन्ति दातारं तारयन्ति च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2211673, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2211674, "chapter_id": 5512, "verse_number": "८१", "content_sanskrit": "देवदेवेश दैत्यघ्न कालः को हव्यकव्ययोः ।\nके तत्र पूजामर्हन्ति वर्जनीयाश्च के द्विजाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2211675, "chapter_id": 5512, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2211676, "chapter_id": 5512, "verse_number": "८२", "content_sanskrit": "दैवं पूर्वाह्णिकं ज्ञेयं पैतकं चापराह्णिकम् ।\nकालहीनं च यद्दानं तद्दानं राजसं विदुः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2211677, "chapter_id": 5512, "verse_number": "८३", "content_sanskrit": "खादितं च अवलीडं च कालात्पूर्वं च यत्कृतम् ।\nरजस्वलाभिमृष्टं च तद्भागं राक्षसं विदुः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2211678, "chapter_id": 5512, "verse_number": "८४", "content_sanskrit": "अवशिष्टेन यद्भुक्तं अव्रतेन च भारत ।\nपरामृष्टं शुना वाऽपि तद्भागं राक्षसं विदुः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2211679, "chapter_id": 5512, "verse_number": "८५", "content_sanskrit": "यावन्तः पतिता विप्रा जडोन्मत्तादयोऽपि च ।\nदैवे च पित्र्ये ते विप्रा राजन् नार्हन्ति सत्क्रियाम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2211680, "chapter_id": 5512, "verse_number": "८६", "content_sanskrit": "क्लीबः प्लीही च कुष्ठी च राजयक्ष्मान्वितश्च यः ।\nअपस्मारी च यश्चापि पित्र्ये नार्हति सत्क्रियाम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2211681, "chapter_id": 5512, "verse_number": "८७", "content_sanskrit": "चिकित्सका देवलका वृथा नियमधारिणः ।\nसोमविक्रयिणश्चापि श्राद्धे नार्हन्ति सत्कृतिम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2211682, "chapter_id": 5512, "verse_number": "८८", "content_sanskrit": "एकोद्दिष्टे च ये चान्नं भुञ्जते विधिवद् द्विजाः ।\nचान्द्रायणमकृत्वा ते पुनर्नार्हन्ति सत्कृतिम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2211683, "chapter_id": 5512, "verse_number": "८९", "content_sanskrit": "गायका नर्तकाश्चैव प्लवका वादकास्तथा ।\nकथका यौधिकाश्चैव श्राद्धे नार्हन्ति सत्क्रियाम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2211684, "chapter_id": 5512, "verse_number": "९०", "content_sanskrit": "अनग्नयश्च ये विप्राः प्रेतनिर्यातकाश्च ये ।\nस्तेनाश्चापि विकर्मस्था राजन् नार्हन्ति सत्कृतिम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2211685, "chapter_id": 5512, "verse_number": "९१", "content_sanskrit": "अपरिज्ञातपूर्वाश्च गणपुत्रश्च यो द्विजः ।\nपुत्रिकापुत्रकाश्चापि श्राद्धे नार्हन्ति सत्क्रियाम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2211686, "chapter_id": 5512, "verse_number": "९२", "content_sanskrit": "रणकर्ता च यो विप्रो यश्च वाणिज्यको द्विजः ।\nप्राणिविक्रयवृत्तिश्च श्राद्धे नार्हन्ति सत्कृतिम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2211687, "chapter_id": 5512, "verse_number": "९३", "content_sanskrit": "चीर्णव्रतगुणैर्युक्ता नित्यं स्वाध्यायतत्पराः ।\nसावित्रीज्ञाः क्रियावन्तस्ते श्राद्धे सत्कृतिक्षमाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2211688, "chapter_id": 5512, "verse_number": "९४", "content_sanskrit": "श्राद्धस्य ब्राह्मणः कालप्राप्तो दधि घृतं तथा ।\nदर्भाः सुमनसः क्षेत्रं तत्काले श्राद्धदो भवेत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2211689, "chapter_id": 5512, "verse_number": "९५", "content_sanskrit": "चारित्रनियता राजन् कृशा ये कृशवृत्तयः ।\nअर्थिनश्चोपगच्छन्ति तेभ्यो दत्तं महत् फलम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2211690, "chapter_id": 5512, "verse_number": "९६", "content_sanskrit": "तपस्विनश्च ये विप्रास्तथा भैक्षचराश्च ये ।\nअर्थिनः केचिदिच्छन्ति तेषां दत्तं महत्फलम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2211691, "chapter_id": 5512, "verse_number": "९७", "content_sanskrit": "एवं धर्मविदां श्रेष्ठ ज्ञात्वा सर्वात्मना सदा ।\nश्रोत्रियाय दरिद्राय प्रयच्छानुपकारिणे ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2211692, "chapter_id": 5512, "verse_number": "९८", "content_sanskrit": "दानं यत् ते प्रियं किञ्चिच्छ्रोत्रियाणां च यत् प्रियम् ।\nतत् प्रयच्छस्व धर्मज्ञ यदीच्छसि तदक्षयम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2211693, "chapter_id": 5512, "verse_number": "९९", "content_sanskrit": "निरयं ये च गच्छन्ति तच्छृणुष्व युधिष्ठिर ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2211694, "chapter_id": 5512, "verse_number": "१००", "content_sanskrit": "गुर्वर्थं वा गवार्थं वा नो चेदन्यत्र पाण्डव ।\nवदन्ति येऽनृतं विप्रास्ते वै निरयगामिनः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2211695, "chapter_id": 5512, "verse_number": "१०१", "content_sanskrit": "परदारापहर्तारः परदाराभिमर्शकाः ।\nपरदारप्रयोक्तारस्ते वै निरयगामिनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2211696, "chapter_id": 5512, "verse_number": "१०२", "content_sanskrit": "सूचकाः सन्धिभेत्तारः परद्रव्योपजीविनः ।\nअकृतज्ञाश्च विप्राणां ते वै निरयगामिनः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2211697, "chapter_id": 5512, "verse_number": "१०३", "content_sanskrit": "वर्णाश्रमाणां ये बाह्याः पाषण्डस्थाश्च पाण्डव ।\nउपासते च तानेव ते सर्वे निरयालयाः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2211698, "chapter_id": 5512, "verse_number": "१०४", "content_sanskrit": "वेदविक्रयिणश्चैव वेदानां चैव दूषकाः ।\nवेदानां लेखकाश्चैव ते वै निरयगामिनः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2211699, "chapter_id": 5512, "verse_number": "१०५", "content_sanskrit": "रसविक्रयिणो राजन् विषविक्रयिणश्च ये ।\nक्षीरविक्रयिणश्चापि ते वै निरयगामिनः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2211700, "chapter_id": 5512, "verse_number": "१०६", "content_sanskrit": "चण्डालेभ्यश्च ये क्षीरं प्रयच्छन्ति नराधमाः ।\nअथार्थमथवा स्नेहात् ते वै निरयगामिनः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2211701, "chapter_id": 5512, "verse_number": "१०७", "content_sanskrit": "पशूनां दमकाश्चैव तथा नासानुवेधकाः ।\nपुंस्त्वहिंसाकराश्चैव ते वै निरयगामिनः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2211702, "chapter_id": 5512, "verse_number": "१०८", "content_sanskrit": "अदातारः समर्था ये द्रव्याणां लोभकारणात् ।\nदीनानन्धान् न पश्यन्ति ते वै निरयगामिनः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2211703, "chapter_id": 5512, "verse_number": "१०९", "content_sanskrit": "क्षान्तान् दान्तान् कृशान् प्राज्ञान् दीर्घकालसहोषितान् ।\nत्यजन्ति कृतकृत्या ये ते वै निरयगामिनः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2211704, "chapter_id": 5512, "verse_number": "११०", "content_sanskrit": "बालानामपि वृद्धानां श्रान्तानां चापि ये नराः ।\nअदत्त्वाऽश्नन्ति ये मृष्टं ते वै निरयगामिनः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2211705, "chapter_id": 5512, "verse_number": "१११", "content_sanskrit": "एते पूर्वर्षिभिः प्रोक्ता नरा निरयगामिनः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2211706, "chapter_id": 5512, "verse_number": "११२", "content_sanskrit": "ये स्वर्गं समनुप्राप्तास्तान् शृणुष्व युधिष्ठिर ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2211707, "chapter_id": 5512, "verse_number": "११३", "content_sanskrit": "दानेन तपसा चैव सत्येन च दमेन च ।\nये धर्ममनुवर्तन्ते ते नराः स्वर्गगामिनः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2211708, "chapter_id": 5512, "verse_number": "११४", "content_sanskrit": "शुश्रूषयाऽप्युपाध्यायात् श्रुतमादाय पाण्डव ।\nये प्रतिग्रहनिःस्नेहाः ते नराः स्वर्गगामिनः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2211709, "chapter_id": 5512, "verse_number": "११५", "content_sanskrit": "मधुमांसासवेभ्यस्तु निवृत्ता वृत्तवत्तु ये ।\nपरदारनिवृत्ताश्च ते नराः स्वर्गगामिनः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2211710, "chapter_id": 5512, "verse_number": "११६", "content_sanskrit": "मातरं पितरं चैव शुश्रूषन्ति च ये नराः ।\nभ्रातॄणामपि सस्नेहास्ते नराः स्वर्गगामिनः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2211711, "chapter_id": 5512, "verse_number": "११७", "content_sanskrit": "ये च भोजनकाले तु निर्याताश्चातिथिप्रियाः ।\nद्वाररोधं न कुर्वन्ति ते नराः स्वर्गगामिनः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2211712, "chapter_id": 5512, "verse_number": "११८", "content_sanskrit": "वैवाहिकं तु कन्यानां दरिद्राणां च ये नराः ।\nकारयन्ति च कुर्वन्ति ते नराः स्वर्गगामिनः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2211713, "chapter_id": 5512, "verse_number": "११९", "content_sanskrit": "रसानामथ बीजानामोषधीनां तथैव च ।\nदातारः श्रद्धयोपेतास्ते नराः स्वर्गगामिनः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2211714, "chapter_id": 5512, "verse_number": "१२०", "content_sanskrit": "क्षेमाक्षेमं च मार्गेषु समानि विषमानि च ।\nअर्थिनां ये च वक्ष्यन्ति ते नराः स्वर्गगामिनः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2211715, "chapter_id": 5512, "verse_number": "१२१", "content_sanskrit": "पर्वद्वये चतुर्दश्यामष्टम्यां सन्ध्ययोर्द्वयोः ।\nआर्द्रायां जन्मनक्षत्रे विषुवे श्रवणेऽथवा ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2211716, "chapter_id": 5512, "verse_number": "१२२", "content_sanskrit": "ये ग्राम्यधर्मविरतास्ते नराः स्वर्गगामिनः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2211717, "chapter_id": 5512, "verse_number": "१२३", "content_sanskrit": "हव्यकव्यविधानं च नरकस्वर्गगामिनौ ।\nधर्माधर्मौ च कथितौ किं भूयः श्रोतुमिच्छसि ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2211718, "chapter_id": 5512, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे स्वर्गनरकगमनकथनं नाम षडधिकशततमोऽध्यायः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}]