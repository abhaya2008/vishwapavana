[{"id": 7002248000, "chapter_id": 22248, "verse_number": "२९३-१", "content_sanskrit": "अग्निरुवाच ।\nमन्त्रविद्याहरिं वक्ष्ये भुक्तिमुक्तिप्रदं शृणु ।\nविंशत्यर्णाधिका मन्त्रा मालामन्त्राः स्मृता द्विज ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002248001, "chapter_id": 22248, "verse_number": "२९३-२", "content_sanskrit": "दशाक्षराधिका मन्त्रास्तदर्वाग्बीजसंज्ञिताः ।\nवार्धक्ये सिद्धिदा ह्येते मालामन्त्रास्तु यौवने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002248002, "chapter_id": 22248, "verse_number": "२९३-३", "content_sanskrit": "पञ्चाक्षराधिका मन्त्राः सिद्धिदाः सर्वदापरे ।\nस्त्रीपुंनपुंसकत्वेन त्रिधाः स्युर्मन्त्रजातयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002248003, "chapter_id": 22248, "verse_number": "२९३-४", "content_sanskrit": "स्त्रीमन्त्रा वह्निजायन्ता नमोन्ताश्च नपुंसकाः ।\nशेषाः पुमांसस्ते शस्ता वक्ष्योच्चाटविषेषु च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002248004, "chapter_id": 22248, "verse_number": "२९३-५", "content_sanskrit": "क्षुद्रक्रियामयध्वंसे स्त्रियोऽन्यत्र नपुंसकाः ।\nमन्त्रावाग्नेयसौम्याख्यौ ताराद्यन्तार्द्वयोर्जपेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002248005, "chapter_id": 22248, "verse_number": "२९३-६", "content_sanskrit": "तारान्त्याग्निवियत्प्रायो मन्त्र आग्नेय इष्यते ।\nशिष्टः सौम्यः प्रशस्तौ तौ कर्मणोः क्रूरसौम्ययोः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002248006, "chapter_id": 22248, "verse_number": "२९३-७", "content_sanskrit": "आग्नेयमन्त्रः सौम्यः स्यात्प्रायशोऽन्ते नमोऽन्वितः ।\nसौम्यमन्त्रस्तथाग्नेयः फट्कारेणान्ततो युतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002248007, "chapter_id": 22248, "verse_number": "२९३-८", "content_sanskrit": "सुप्तः प्रबुद्धमात्रो वा मन्त्रः सिद्धिं न यच्छति ।\nस्वापकालो महाबाहो जागरो दक्षिणावहः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002248008, "chapter_id": 22248, "verse_number": "२९३-९", "content_sanskrit": "आग्नेयस्य मनोः सौम्यमन्त्रस्यैतद्विपर्ययात् ।\nप्रबोधकालं जानीयादुभयोरुभयोरहः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002248009, "chapter_id": 22248, "verse_number": "२९३-१०", "content_sanskrit": "दुष्टर्क्षराशिविद्वेषिवर्णादीन् वर्जयेन्मनून् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]