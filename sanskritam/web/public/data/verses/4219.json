[{"id": 2148682, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148683, "chapter_id": 4219, "verse_number": "१", "content_sanskrit": "जनार्दनवचः श्रुत्वा कुन्तीपुत्रो युधिष्ठिरः ।\nभ्रातॄनुवाच धर्मात्मा समक्षं केशवस्य ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148684, "chapter_id": 4219, "verse_number": "२", "content_sanskrit": "श्रुतं भवद्भिर्यद् वृत्तं सभायां कुरुसंसदि ।\nकेशवस्यापि यद् वाक्यं तत् सर्वमवधारितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148685, "chapter_id": 4219, "verse_number": "३", "content_sanskrit": "तस्मात् सेनाविभागं मे कुरुध्वं नरसत्तमाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148686, "chapter_id": 4219, "verse_number": "४", "content_sanskrit": "अक्षोहिण्यश्च सप्तैताः समेता विजयाय वै ।\nतासां ये पतयः सप्त विख्यातास्तान् निबोधत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148687, "chapter_id": 4219, "verse_number": "५", "content_sanskrit": "द्रुपदश्च विराटश्च धृष्टद्युम्नशिखण्डिनौ ।\nसात्यकिश्चेकितानश्च भीमसेनश्च वीर्यवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148688, "chapter_id": 4219, "verse_number": "६", "content_sanskrit": "एते सेनाप्रणेतारो वीराः सर्वे तनुत्यजः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148689, "chapter_id": 4219, "verse_number": "७", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे सुचरितव्रताः ।\nह्रीमन्तो नीतिमन्तश्च सर्वे युद्धविशारदाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148690, "chapter_id": 4219, "verse_number": "८", "content_sanskrit": "इष्वस्त्रकुशलाश्चैव तथा सर्वास्त्रयोधिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148691, "chapter_id": 4219, "verse_number": "९", "content_sanskrit": "सप्तानामपि यो नेता सेनानां प्रविभागवित् ।\nयः सहेत रणे भीष्मं शरार्चिःपावकोपमम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148692, "chapter_id": 4219, "verse_number": "१०", "content_sanskrit": "तं तावत् सहदेवात्र प्रब्रूहि कुरुनन्दन ।\nस्वमतं पुरुषव्याघ्र को नः सेनापतिः क्षमः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148693, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148694, "chapter_id": 4219, "verse_number": "११", "content_sanskrit": "संयुक्त एव पुत्रैश्च कोशवांश्च महीपतिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148695, "chapter_id": 4219, "verse_number": "१२", "content_sanskrit": "यं समाश्रित्य धर्मज्ञं स्वमंशमनुयुञ्ज्महे ।\nमात्स्यो विराटो बलवान् कृतास्त्री युद्धदुर्मदः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148696, "chapter_id": 4219, "verse_number": "१३", "content_sanskrit": "प्रसहिष्यति सङ्ग्रामे भीष्मं तांश्च महारथान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148697, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148698, "chapter_id": 4219, "verse_number": "१४", "content_sanskrit": "तथोक्ते सहदेवेन वाक्ये वाक्यविशारदः ।\nनकुलोऽनन्तरं तस्मादिदं वचनमाददे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148699, "chapter_id": 4219, "verse_number": "१५", "content_sanskrit": "वयसा शास्त्रतो धैर्यात् कुलेनाभिजनेन च ।\nह्रीमान् बलान्वितः श्रीमान् सर्वशस्त्रभृतां वरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148700, "chapter_id": 4219, "verse_number": "१६", "content_sanskrit": "वेद चास्त्रं भरद्वाजाद् दुर्धर्षः सत्यसङ्गरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148701, "chapter_id": 4219, "verse_number": "१७", "content_sanskrit": "यो नित्यं स्पर्धते द्रोणं भीष्मं चैव महाबलः ।\nश्लाघ्यः पार्थिवसङ्घस्य प्रमुखे वाहिनीपतिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148702, "chapter_id": 4219, "verse_number": "१८", "content_sanskrit": "पुत्रपौत्रैः परिवृतः शतशाख इव द्रुमः ।\nयस्तताप तपो घोरं सदारः पृथिवीपतिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148703, "chapter_id": 4219, "verse_number": "१९", "content_sanskrit": "रोषाद् द्रोणविनाशाय वीरः समितिशोभनः ।\nपितेवास्मान् समाधत्त यः सदा पार्थिवर्षभः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148704, "chapter_id": 4219, "verse_number": "२०", "content_sanskrit": "श्वशुरो द्रुपदोऽस्माकं सेनामग्रे प्रकर्षतु ।\nस द्रोणभीष्मावायातौ सहेदिति मतिर्मम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148705, "chapter_id": 4219, "verse_number": "२१", "content_sanskrit": "स हि दिव्यास्त्रविद् राजा सखा चाङ्गिरसो नृप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148706, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148707, "chapter_id": 4219, "verse_number": "२२", "content_sanskrit": "माद्रीसुताभ्यामुक्ते तु स्वमते कुरुनन्दनः ।\nवासविर्वासवसमः सव्यसाच्यब्रवीदिदम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148708, "chapter_id": 4219, "verse_number": "२३", "content_sanskrit": "योऽयं तपःप्रभावेण ऋषिसन्तोषणेन च ।\nदिव्यः पुरुष उत्पन्नो ज्वालावर्णो महाबलः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148709, "chapter_id": 4219, "verse_number": "२४", "content_sanskrit": "धनुष्मान् कवची खड्गी रथमारुह्य दंसितः ।\nदिव्यैर्हयवरैर्युक्तमग्निकुण्डात् समुत्थितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148710, "chapter_id": 4219, "verse_number": "२५", "content_sanskrit": "गर्जन्निव महामेघो रथघोषेण वीर्यवान् ।\nसिंहसंहननो वीरः सिंहविक्रान्तविक्रमः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148711, "chapter_id": 4219, "verse_number": "२६", "content_sanskrit": "सिंहोरस्को महाबाहुः सिंहवक्षा महाबलः ।\nसिंहवद्गर्जितो वीरः सिंहस्कन्धो महाद्युतिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148712, "chapter_id": 4219, "verse_number": "२७", "content_sanskrit": "सुभ्रूः सुदंष्ट्रः सुतनुः सुनसः सुमुखोऽकृशः ।\nसुजत्रुः सुविशालाक्षः सुपादः सुप्रतिष्ठितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148713, "chapter_id": 4219, "verse_number": "२८", "content_sanskrit": "अभेद्यः सर्वशस्त्राणां प्रभिन्न इव वारणः ।\nजज्ञे द्रोणविनाशाय सत्यवादी जितेन्द्रियः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148714, "chapter_id": 4219, "verse_number": "२९", "content_sanskrit": "धृष्टद्युम्नमहं मन्ये सहेद् भीष्मस्य सायकान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148715, "chapter_id": 4219, "verse_number": "३०", "content_sanskrit": "वज्राशनिसमस्पर्शान् दीप्तास्यानुरगानिव ।\nयमदूतसमान् वेगे निपाते पावकोपमान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148716, "chapter_id": 4219, "verse_number": "३१", "content_sanskrit": "रामेणाजौ विषहितान् वज्रनिष्पेषदारुणान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148717, "chapter_id": 4219, "verse_number": "३२", "content_sanskrit": "पुरुषं तं न पश्यामि यः सहेत महाव्रतम् ।\nधृष्टद्युम्नमृते राजन्निति मे धीयते मतिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148718, "chapter_id": 4219, "verse_number": "३३", "content_sanskrit": "क्षिप्रहस्तः क्षिप्रयोधी मतः सेनापतिर्मम ।\nअभेद्यकवचः श्रीमान् मातङ्ग इव यूथपः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148719, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148720, "chapter_id": 4219, "verse_number": "३४", "content_sanskrit": "अर्जुनेनैवमुक्ते तु भीमो वाक्यं समाददे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148721, "chapter_id": 4219, "verse_number": "३५", "content_sanskrit": "वधार्थं यः समुत्पन्नः शिखण्डी द्रुपदात्मजः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148722, "chapter_id": 4219, "verse_number": "३६", "content_sanskrit": "वदन्ति सिद्धा राजेन्द्र ऋषयश्च समागताः ।\nयस्य सङ्ग्राममध्येषु दिव्यमस्त्रं प्रकुर्वतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148723, "chapter_id": 4219, "verse_number": "३७", "content_sanskrit": "रूपं द्रक्ष्यन्ति पुरुषा रामस्येव महात्मनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2148724, "chapter_id": 4219, "verse_number": "३८", "content_sanskrit": "न तं युद्धे प्रपश्यामि यो युद्ध्येत्तु शिखण्डिना\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2148725, "chapter_id": 4219, "verse_number": "३९", "content_sanskrit": "शस्त्रेण समरे राजन् सन्नद्धं स्यन्दने स्थितम् ।\nद्वैरथे विषहेतासौ भीष्मं राजन् महाव्रतम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2148726, "chapter_id": 4219, "verse_number": "४०", "content_sanskrit": "शिखण्डिनमृते राजन् न मे सेनापतिर्मतः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2148727, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2148728, "chapter_id": 4219, "verse_number": "४१", "content_sanskrit": "सर्वस्य जगतस्तात सारासारं बलाबलम् ।\nसर्वं जानाति धर्मात्मा गतमेष्यच्च केशवः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2148729, "chapter_id": 4219, "verse_number": "४२", "content_sanskrit": "यमाह कृष्णो दाशार्हः सोऽस्तु सेनापतिर्मम ।\nकृतास्त्रोऽप्यकृतास्त्रो वा वृद्धो वा यदि वा युवा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2148730, "chapter_id": 4219, "verse_number": "४३", "content_sanskrit": "एष मे विजये मूलमेष तात विपर्यये ।\nअत्र प्राणाश्च राज्यं च लाभालाभौ सुखासुखे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2148731, "chapter_id": 4219, "verse_number": "४४", "content_sanskrit": "एष धाता विधाता च सिद्धिरत्र प्रतिष्ठिता\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2148732, "chapter_id": 4219, "verse_number": "४५", "content_sanskrit": "यमाह कृष्णो दाशार्हः स नः सेनापतिः क्षमः ।\nब्रवीतु वदतां श्रेष्ठो निशा समभिवर्तते\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2148733, "chapter_id": 4219, "verse_number": "४६", "content_sanskrit": "ततः सेनापतिं कृत्वा कृष्णस्य वशवर्तिनः ।\nरात्रिशेषे व्यतिक्रान्ते प्रयास्यामो रणाजिरम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2148734, "chapter_id": 4219, "verse_number": "४७", "content_sanskrit": "अधिवासितशस्त्राश्च कृतकौतुकमङ्गलाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2148735, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2148736, "chapter_id": 4219, "verse_number": "४८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा धर्मराजस्य धीमतः ।\nअब्रवीत् पुण्डरीकाक्षो धनञ्जयमवेक्ष्य ह\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2148737, "chapter_id": 4219, "verse_number": "४९", "content_sanskrit": "ममाप्येते महाराज भवद्भिर्य उदाहृताः ।\nनेतारस्तव सेनायाः शूरा विक्रान्तयोधिनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2148738, "chapter_id": 4219, "verse_number": "५०", "content_sanskrit": "सर्व एते समर्था हि तव शत्रून् विमर्दितुम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2148739, "chapter_id": 4219, "verse_number": "५१", "content_sanskrit": "इन्द्रस्यापि भयं ह्येते जनयेयुर्महाहवे ।\nकिं पुनर्धार्तराष्ट्राणां क्रुद्धानां पापचेतसाम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2148740, "chapter_id": 4219, "verse_number": "५२", "content_sanskrit": "मयाऽपि हि महाबाहो त्वत्प्रियार्थमरिन्दम ।\nकृतो यत्नो महांस्तत्र शमः स्यादिति भारत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2148741, "chapter_id": 4219, "verse_number": "५३", "content_sanskrit": "धर्मस्य गतमानृण्यं न स्म वाच्यो विवक्षताम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2148742, "chapter_id": 4219, "verse_number": "५४", "content_sanskrit": "कृतार्थं मन्यते बालः सोत्मानमविचक्षणः ।\nधार्तराष्ट्रो बलस्थं च पश्यत्यात्मानमातुरः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2148743, "chapter_id": 4219, "verse_number": "५५", "content_sanskrit": "युज्यतां वाहिनी साधु वधसाध्या हि मे मताः ।\nन धार्तराष्ट्राः शक्ष्यन्ति स्थातुं दृष्ट्वा धनञ्जयम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2148744, "chapter_id": 4219, "verse_number": "५६", "content_sanskrit": "भीमसेनं च सङ्क्रुद्धं यमौ चापि यमोपमौ ।\nयुयुधानद्वितीयं च धृष्टद्युम्नममर्षणम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2148745, "chapter_id": 4219, "verse_number": "५७", "content_sanskrit": "अभिमन्युं द्रौपदेयान् विराटद्रुपदावपि ।\nअक्षोहिणीपतींश्चान्यान् नरेन्द्रान् दृढविक्रमान्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2148746, "chapter_id": 4219, "verse_number": "५८", "content_sanskrit": "सारवद् बलमस्माकं दुष्प्रधर्षं दुरासदम् ।\nधार्तराष्ट्रबलं सङ्खे हनिष्यति न संशयः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2148747, "chapter_id": 4219, "verse_number": "५९", "content_sanskrit": "धृष्टद्युम्नमहं मन्ये सेनापतिमरिन्दम\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2148748, "chapter_id": 4219, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2148749, "chapter_id": 4219, "verse_number": "६०", "content_sanskrit": "एवमुक्ते तु कृष्णेन सम्प्राहृष्यन् नरोत्तमाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2148750, "chapter_id": 4219, "verse_number": "६१", "content_sanskrit": "तेषां प्रहृष्टमनसां नादः समभवन्महान् ।\nयोजयित्वाऽथ सैन्यानां त्वरतां सम्प्रधावताम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2148751, "chapter_id": 4219, "verse_number": "६२", "content_sanskrit": "हयवारणशब्दाश्च नेमिघोषाश्च सर्वशः ।\nशङ्खदुन्दुभिघोषाश्च तुमुलाः सर्वतोऽभवन्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2148752, "chapter_id": 4219, "verse_number": "६३", "content_sanskrit": "प्रयास्यतां पाण्डवानां ससैन्यानां समन्ततः ।\nगङ्गेव पूर्णा दुर्धर्षा समदृश्यत वाहिनी\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2148753, "chapter_id": 4219, "verse_number": "६४", "content_sanskrit": "अग्रानीके भीमसेनो माद्रीपुत्रौ च दंसितौ ।\nसौभद्रो द्रौपदेयाश्च धृष्टद्युम्नश्च पार्षतः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2148754, "chapter_id": 4219, "verse_number": "६५", "content_sanskrit": "प्रभद्रकाश्च पाञ्चाला भीमसेनमुखा ययुः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2148755, "chapter_id": 4219, "verse_number": "६६", "content_sanskrit": "ततः शब्दः समभवत् समुद्रस्येव पर्वणि ।\nहृष्टानां सम्प्रयातानां घोषो दिवमिवास्पृशत्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2148756, "chapter_id": 4219, "verse_number": "६७", "content_sanskrit": "प्रहृष्टा दंसिता योधाः परानीकविदारणाः ।\nतेषां मध्ये ययौ राजा कुन्तीपुत्रो युधिष्ठिरः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2148757, "chapter_id": 4219, "verse_number": "६८", "content_sanskrit": "शकटापणवेशाश्च यानयुग्यं च सर्वशः ।\nकोशं यन्त्रायुधं चैव ये च वैद्याश्चिकित्सकाः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2148758, "chapter_id": 4219, "verse_number": "६९", "content_sanskrit": "फल्गु यच्च बलं किञ्चित् तथैव कृशदुर्बलम् ।\nतत् सङ्गृह्य ययौ राजा ये चापि परिचारकाः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2148759, "chapter_id": 4219, "verse_number": "७०", "content_sanskrit": "उपप्लाव्ये तु पाञ्चाली द्रौपदी सत्यवादिनी ।\nसह स्त्रीभिर्निववृते दासीदाससमावृता\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2148760, "chapter_id": 4219, "verse_number": "७१", "content_sanskrit": "कृत्वा मूलप्रतीकारं गुल्मैः स्थावरजङ्गमैः ।\nस्कन्धावारेण महता प्रययुः पाण्डुनन्दनाः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2148761, "chapter_id": 4219, "verse_number": "७२", "content_sanskrit": "ददतो गां हिरण्यं च ब्राह्मणैरभिसंवृताः ।\nस्तूयमाना ययू राजन् रथैर्मणिविभूषणैः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2148762, "chapter_id": 4219, "verse_number": "७३", "content_sanskrit": "केकया धृष्टकेतुश्च पुत्रः काश्यस्य चाभिभूः ।\nश्रेणिमान् वसुदानश्च शिखण्डी चापराजितः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2148763, "chapter_id": 4219, "verse_number": "७४", "content_sanskrit": "हृष्टास्तुष्टाः कवचिनः सशस्त्राः समलङ्कृताः ।\nराजानमन्वयुः सर्वे परिवार्य युधिष्ठिरम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2148764, "chapter_id": 4219, "verse_number": "७५", "content_sanskrit": "जघनार्धे विराटश्च याज्ञसेनश्च सौमकिः ।\nसुशर्मा कुन्तिभोजश्च धृष्टद्युम्नस्य चात्मजाः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2148765, "chapter_id": 4219, "verse_number": "७६", "content_sanskrit": "रथायुतानि चत्वारि हयाः पञ्चगुणास्तथा ।\nपत्तिसैन्यं दशगुणं सादिनामयुतानि षट्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2148766, "chapter_id": 4219, "verse_number": "७७", "content_sanskrit": "अनाधृष्टिश्चेकितानो धृष्टकेतुश्च सात्यकिः ।\nपरिवार्य ययुः सर्वे वासुदेवधनञ्जयौ\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2148767, "chapter_id": 4219, "verse_number": "७८", "content_sanskrit": "आसाद्य तु कुरुक्षेत्रं व्यूढानीकाः प्रहारिणः ।\nपाण्डवाः समदृश्यन्त नर्दन्तो वृषभा इव\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2148768, "chapter_id": 4219, "verse_number": "७९", "content_sanskrit": "ते विगाह्य कुरुक्षेत्रं शङ्खान् दध्मुररिन्दमाः ।\nतथैव दध्मतुः शङ्खौ वासुदेवधनञ्जयौ\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2148769, "chapter_id": 4219, "verse_number": "८०", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं विस्फूर्जितमिवाशनेः ।\nनिशम्य सर्वसैन्यानि समहृष्यन्त सर्वशः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2148770, "chapter_id": 4219, "verse_number": "८१", "content_sanskrit": "शङ्खदुन्दुभिसंसृष्टः सिंहनादस्तरस्विनाम् ।\nपृथिवीं चान्तरिक्षं च सागरांश्चान्वनादयत्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2148771, "chapter_id": 4219, "verse_number": "८२", "content_sanskrit": "ततो देशे समे स्निग्धे प्रभूतयवसेन्धने ।\nनिवेशयामास ततः सेनां राजा युधिष्ठिरः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2148772, "chapter_id": 4219, "verse_number": "८३", "content_sanskrit": "परिहृत्य श्मशानानि देवतायतनानि च ।\nआश्रमांश्च महर्षीणां तीर्थान्यायतनानि च\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2148773, "chapter_id": 4219, "verse_number": "८४", "content_sanskrit": "मधुरेऽनूषरे देशे शिवे पुण्ये महीपतिः ।\nनिवेशं कारयामास कुन्तीपुत्रो युधिष्ठिरः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2148774, "chapter_id": 4219, "verse_number": "८५", "content_sanskrit": "ततश्च पुनरुत्थाय सुखी विश्रान्तवाहनः ।\nप्रययौ पृथिवीपालैः वृतः शतसहस्रशः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2148775, "chapter_id": 4219, "verse_number": "८६", "content_sanskrit": "विद्राव्य शतशो गुल्मान् धार्तराष्ट्रस्य सैनिकान् ।\nपर्यक्रामत् समन्ताच्च पार्थेन सह केशवः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2148776, "chapter_id": 4219, "verse_number": "८७", "content_sanskrit": "शिबिरं मापयामास धृष्टद्युम्नश्च पार्षतः ।\nसात्यकिश्च रथोदारो युयुधानः प्रतापवान्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2148777, "chapter_id": 4219, "verse_number": "८८", "content_sanskrit": "आसाद्य सरितं पुण्यां कुरुक्षेत्रे हिरण्वतीम् ।\nसूपतीर्थां शुचिजलां शर्करापङ्कवर्जिताम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2148778, "chapter_id": 4219, "verse_number": "८९", "content_sanskrit": "खानयामास परिखां केशवस्तत्र भारत ।\nगुप्त्यर्थमपि चादिश्य बलं तत्र न्यवेशयत्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2148779, "chapter_id": 4219, "verse_number": "९०", "content_sanskrit": "विधिर्यः शिबिरस्यासीत् पाण्डवानां महात्मनाम् ।\nतद्विधानं नरेन्द्राणां कारयामास केशवः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2148780, "chapter_id": 4219, "verse_number": "९१", "content_sanskrit": "प्रभूतजलकाष्ठानि सुदुर्धर्षतराणि च ।\nभक्ष्यभोज्यान्नपानानि शतशोऽथ सहस्रशः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2148781, "chapter_id": 4219, "verse_number": "९२", "content_sanskrit": "शिबिराणि महार्हाणि राज्ञां तत्र पृथक् पृथक् ।\nविमानानीव राजेन्द्र निविष्टानि महीतळे\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2148782, "chapter_id": 4219, "verse_number": "९३", "content_sanskrit": "तत्रासन् शिल्पिनः प्राज्ञा बहुशो दत्तवेतनाः ।\nसर्वोपकरणैर्युक्ता वैद्याः शास्त्रविशारदाः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2148783, "chapter_id": 4219, "verse_number": "९४", "content_sanskrit": "ज्याधनुर्वर्मशस्त्राणां तथैव मधुसर्पिषोः ।\nससर्जरसपांसूनां राशयः पर्वतोपमाः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2148784, "chapter_id": 4219, "verse_number": "९५", "content_sanskrit": "बहूदकं सुयवसं तुषाङ्गारसमन्वितम् ।\nशिबिरे शिबिरे राजा सञ्चकार युधिष्ठिरः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2148785, "chapter_id": 4219, "verse_number": "९६", "content_sanskrit": "महायन्त्राणि नाराचाः तोमराणि परश्वधाः ।\nधनूंषि कवचादीनि सम्बभूवुर्नृणां तदा\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2148786, "chapter_id": 4219, "verse_number": "९७", "content_sanskrit": "गजाः कण्टकसन्नाहा लोहवर्मोत्तरच्छदाः ।\nदृश्यन्ते तत्र गिर्याभाः शतशोऽथ सहस्रशः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2148787, "chapter_id": 4219, "verse_number": "९८", "content_sanskrit": "निविष्टान् पाण्डवांस्तत्र ज्ञात्वा मित्राणि भारत ।\nअभिजग्मुर्यथोद्देशं सबलाः सपदानुगाः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2148788, "chapter_id": 4219, "verse_number": "९९", "content_sanskrit": "चरितब्रह्मचर्यास्ते सोमपा भूरिदक्षिणाः ।\nजयाय पाण्डुपुत्राणां समाजग्मुर्महीक्षितः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2148789, "chapter_id": 4219, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् उद्योगपर्वणि पञ्चाशोत्तरशततमोऽध्यायः ॥१५०॥\nसैन्यनिर्याणपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]