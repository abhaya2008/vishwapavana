[{"id": 7006381000, "chapter_id": 26381, "verse_number": "२-३८-१", "content_sanskrit": "वैशम्पायन उवाच\nस तासु नागकन्यासु कालेन महता नृपः ।\nजनयामास विक्रान्तान् पञ्च पुत्रान् कुलोद्वहान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006381001, "chapter_id": 26381, "verse_number": "२-३८-२", "content_sanskrit": "मुचुकुन्दं महाबाहुं पद्मवर्णं तथैव च ।\nमाधवं सारसं चैव हरितं चैव पार्थिवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006381002, "chapter_id": 26381, "verse_number": "२-३८-३", "content_sanskrit": "एतान् पञ्चसुतान्राजा पञ्चभूतोपमान् भुवि ।\nईक्षमाणो नृपः प्रीतिं जगामातुलविक्रमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006381003, "chapter_id": 26381, "verse_number": "२-३८-४", "content_sanskrit": "ते प्राप्तवयसः सर्वे स्थिताः पञ्च यथाद्रयः ।\nतेजिता बलदर्पाभ्यामूचुः पितरमग्रतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006381004, "chapter_id": 26381, "verse_number": "२-३८-५", "content_sanskrit": "तात युक्ताः स्म वयसा बले महति संस्थिताः ।\nक्षिप्रमाज्ञप्तुमिच्छामः किं कुर्मस्तव शासनात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006381005, "chapter_id": 26381, "verse_number": "२-३८-६", "content_sanskrit": "स तान् नृपतिशार्दूलः शार्दूलानिव वैगितान् ।\nप्रीत्या परमया प्राह सुतान् वीर्यकुतूहलात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006381006, "chapter_id": 26381, "verse_number": "२-३८-७", "content_sanskrit": "विन्ध्यर्क्षवन्तावभितो द्वे पुर्यौ पर्वताश्रये ।\nनिवेशयतु यत्नेन मुचुकुन्दः सुतो मम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006381007, "chapter_id": 26381, "verse_number": "२-३८-८", "content_sanskrit": "सह्यस्य चोपरिष्टात्तु दक्षिणां दिशमाश्रितः ।\nपद्मवर्णोऽपि मे पुत्रो निवेशयतु मा चिरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006381008, "chapter_id": 26381, "verse_number": "२-३८-९", "content_sanskrit": "तत्रैव परतः कान्ते देशे चम्पकभूषिते ।\nसारसो मे पुरं रम्यं निवेशयतु पुत्रकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006381009, "chapter_id": 26381, "verse_number": "२-३८-१०", "content_sanskrit": "हरितोऽयं महाबाहुः सागरे हरितोदके ।\nदीपं पन्नगराजस्य सुतो मे पालयिष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006381010, "chapter_id": 26381, "verse_number": "२-३८-११", "content_sanskrit": "माधवो मे महाबाहुर्ज्येष्ठपुत्रश्च धर्मवित् ।\nयौवराज्येन संयुक्तः स्वपुरं पालयिष्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006381011, "chapter_id": 26381, "verse_number": "२-३८-१२", "content_sanskrit": "सर्वे नृपश्रियं प्राप्ता अभिषिक्ताः सचामराः ।\nपित्रानुशिष्टाश्चत्वारो लोकपालोपमा नृपाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006381012, "chapter_id": 26381, "verse_number": "२-३८-१३", "content_sanskrit": "स्वं स्वं निवेशनं सर्वे भेजिरे नृपसत्तमाः ।\nपुरस्थानानि रम्याणि मृगयन्तो यथाक्रमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006381013, "chapter_id": 26381, "verse_number": "२-३८-१४", "content_sanskrit": "मुचुकुन्दश्च राजर्षिर्विन्ध्यमध्यमरोचयत् ।\nस्वस्थानं नर्मदातीरे दारुणोपलसंकटे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006381014, "chapter_id": 26381, "verse_number": "२-३८-१५", "content_sanskrit": "स च तं शोधयामास विविक्तं च चकार ह ।\nसेतुं चैव समं चक्रे परिखाश्चामितोदकाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006381015, "chapter_id": 26381, "verse_number": "२-३८-१६", "content_sanskrit": "स्थापयामास भागेषु देवतायतनान्यपि ।\nरथ्या वीथीर्नृणां मार्गाश्चत्वराणि वनानि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006381016, "chapter_id": 26381, "verse_number": "२-३८-१७", "content_sanskrit": "स तां पुरीं धनवतीं पुरुहूतपुरीप्रभाम् ।\nनातिदीर्घेण कालेन चकार नृपसत्तमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006381017, "chapter_id": 26381, "verse_number": "२-३८-१८", "content_sanskrit": "नाम चास्याः शुभं चक्रे निर्मितं स्वेन तेजसा ।\nतस्याः पुर्या नृपश्रेष्ठो देवश्रेष्ठपराक्रमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006381018, "chapter_id": 26381, "verse_number": "२-३८-१९", "content_sanskrit": "महाश्मसंघातवती यथेयं विन्ध्यसानुगा ।\nमाहिष्मती नाम पुरी प्रकाशमुपयास्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006381019, "chapter_id": 26381, "verse_number": "२-३८-२०", "content_sanskrit": "उभयोर्विन्ध्ययोः पादे नगयोस्तां महापुरीम् ।\nमध्ये निवेशयामास श्रिया परमया वृताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006381020, "chapter_id": 26381, "verse_number": "२-३८-२१", "content_sanskrit": "पुरिकां नाम धर्मात्मा पुरीं देवपुरीप्रभाम् ।\nउद्यानशतसम्बाधां समृद्धापणचत्वराम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006381021, "chapter_id": 26381, "verse_number": "२-३८-२२", "content_sanskrit": "ऋक्षवन्तं समभितस्तीरे तत्र निरामये ।\nनिर्मिता सा पुरी राज्ञा पुरिका नाम नामतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006381022, "chapter_id": 26381, "verse_number": "२-३८-२३", "content_sanskrit": "स ते द्वे विपुले पुर्यौ देवभोग्योपमे शुभे ।\nपालयामास धर्मात्मा राजा धर्मे व्यवस्थितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006381023, "chapter_id": 26381, "verse_number": "२-३८-२४", "content_sanskrit": "पद्मवर्णोऽपि राजर्षिः सह्यपृष्ठे पुरोत्तमम् ।\nचकार नद्या वेणायास्तीरे तरुलताकुले ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006381024, "chapter_id": 26381, "verse_number": "२-३८-२५", "content_sanskrit": "विषयस्याल्पतां ज्ञात्वा सम्पूर्णं राष्ट्रमेव च ।\nनिवेशयामास नृपः स वप्रप्रायमुत्तमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006381025, "chapter_id": 26381, "verse_number": "२-३८-२६", "content_sanskrit": "पद्मावतं जनपदं करवीरं च तत्पुरम् ।\nनिर्मितं पद्मवर्णेन प्राजापत्येन कर्मणा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006381026, "chapter_id": 26381, "verse_number": "२-३८-२७", "content_sanskrit": "सारसेनापि विहितं रम्यं क्रौञ्चपुरं महत् ।\nचम्पकाशोकबहुलं विपुलं ताम्रमृत्तिकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006381027, "chapter_id": 26381, "verse_number": "२-३८-२८", "content_sanskrit": "वनवासीति विख्यातः स्फीतो जनपदो महान् ।\nपुरस्य तस्य तु श्रीमान् द्रुमैः सार्वर्तुकैर्वृतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006381028, "chapter_id": 26381, "verse_number": "२-३८-२९", "content_sanskrit": "हरितोऽपि समुद्रस्य द्वीपं समभिपालयत् ।\nरत्नसंचयसम्पूर्णं नारीजनमनोहरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006381029, "chapter_id": 26381, "verse_number": "२-३८-३०", "content_sanskrit": "तस्य दाशा जले मग्ना मद्गुरा नाम विश्रुताः ।\nये हरन्ति सदा शङ्खान् समुद्रोदरचारिणः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006381030, "chapter_id": 26381, "verse_number": "२-३८-३१", "content_sanskrit": "तस्यापरे दाशजनाः प्रवालाञ्जलसम्भवान् ।\nसंचिन्वन्ति सदा युक्ता जातरूपं च मौक्तिकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006381031, "chapter_id": 26381, "verse_number": "२-३८-३२", "content_sanskrit": "जलजानि च रत्नानि निषादास्तस्य मानवाः ।\nप्रचिन्वन्तोऽर्णवे युक्ता नौभिः संयानगामिनः ॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006381032, "chapter_id": 26381, "verse_number": "२-३८-३३", "content_sanskrit": "मत्स्यमांसेन तै सर्वे वर्तन्ते स्म सदा नराः ।\nगृहणन्तः सर्वरत्नानि  रत्नद्वीपनिवासिनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006381033, "chapter_id": 26381, "verse_number": "२-३८-३४", "content_sanskrit": "तैः संयानगतैर्द्रव्यैर्वणिजो दूरगामिनः ।\nहरितं तर्पयन्त्येकं यथैव धनदं तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006381034, "chapter_id": 26381, "verse_number": "२-३८-३५", "content_sanskrit": "एवमिक्ष्वाकुवंशात् तु यदुवंशो विनिःसृतः ।\nचतुर्धा यदुपुत्रैस्तु चतुर्भिभिद्यते पुनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006381035, "chapter_id": 26381, "verse_number": "२-३८-३६", "content_sanskrit": "स यदुर्माधवे राज्यं विसृज्य यदुपुङ्गवे ।\nत्रिविष्टपं गतो राजा देहं त्यक्त्वा महीतले ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006381036, "chapter_id": 26381, "verse_number": "२-३८-३७", "content_sanskrit": "बभूव माधवसुतः सत्त्वतो नाम वीर्यवान् ।\nसत्त्ववृत्तिर्गुणोपेतो राजा राजगुणे स्थितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006381037, "chapter_id": 26381, "verse_number": "२-३८-३८", "content_sanskrit": "सत्त्वतस्य सुतो राजा भीमो नाम महानभूत् ।\nयेन भैमाः सुसंवृत्ताः सत्त्वतात् सात्त्वताः स्मृताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006381038, "chapter_id": 26381, "verse_number": "२-३८-३९", "content_sanskrit": "राज्ये स्थिते नृपे तस्मिन् रामे राज्यं प्रशासति ।\nशत्रुघ्नो लवणं हत्वा चिच्छेद स मधोर्वनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006381039, "chapter_id": 26381, "verse_number": "२-३८-४०", "content_sanskrit": "तस्मिन् मधुवने स्थाने पुरीं च मथुरामिमाम् ।\nनिवेशयामास विभुः सुमित्रानन्दवर्धनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006381040, "chapter_id": 26381, "verse_number": "२-३८-४१", "content_sanskrit": "पर्यये चैव रामस्य भरतस्य तथैव च ।\nसुमित्रासुतयोश्चैव स्थानं प्राप्तं च वैष्णवम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006381041, "chapter_id": 26381, "verse_number": "२-३८-४२", "content_sanskrit": "भीमेनेयं पुरी तेन राज्यसम्बन्धकारणात् ।\nस्ववशे स्थापिता पूर्वं स्वयमध्यासिता तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006381042, "chapter_id": 26381, "verse_number": "२-३८-४३", "content_sanskrit": "ततः कुशे स्थिते राज्ये लवे तु युवराजनि ।\nअन्धको नाम भीमस्य सुतो राज्यमकारयत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006381043, "chapter_id": 26381, "verse_number": "२-३८-४४", "content_sanskrit": "अन्धकस्य सुतो जज्ञे रेवतो नाम पार्थिवः ।\nऋक्षोऽपि रेवताज्जज्ञे रम्ये पर्वतमूर्धनि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006381044, "chapter_id": 26381, "verse_number": "२-३८-४५", "content_sanskrit": "ततो रैवत उत्पन्नः पर्वतः सागरान्तिके ।\nनाम्ना रैवतको नाम भूमौ भूमिधरः स्मृतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006381045, "chapter_id": 26381, "verse_number": "२-३८-४६", "content_sanskrit": "रैवतस्यात्मजो राजा विश्वगर्भो महायशाः ।\nबभूव पृथिवीपालः पृथिव्यां प्रथितः प्रभुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006381046, "chapter_id": 26381, "verse_number": "२-३८-४७", "content_sanskrit": "तस्य तिसृषु भार्यासु दिव्यरूपासु केशव ।\nचत्वारो जज्ञिरे पुत्रा लोकपालोपमाः शुभाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006381047, "chapter_id": 26381, "verse_number": "२-३८-४८", "content_sanskrit": "वसुर्बभ्रुः सुषेणश्च सभाक्षश्चैव वीर्यवान् ।\nयदुप्रवीराः प्रख्याता लोकपाला इवापरे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006381048, "chapter_id": 26381, "verse_number": "२-३८-४९", "content_sanskrit": "तैरयं यादवो वंशः पार्थिवैर्बहुलीकृतः ।\nयैः साकं कृष्णलोकेऽस्मिन् प्रजावन्तः प्रजेश्वराः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006381049, "chapter_id": 26381, "verse_number": "२-३८-५०", "content_sanskrit": "वसोस्तु कुन्तिविषये वसुदेवः सुतो विभुः ।\nततः स जनयामास सुप्रभे द्वे च दारिके ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006381050, "chapter_id": 26381, "verse_number": "२-३८-५१", "content_sanskrit": "कुन्तीं च पाण्डोर्महिषीं देवतामिव भूचरीम् ।\nभार्यां च दमघोषस्य चेदिराजस्य सुप्रभाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006381051, "chapter_id": 26381, "verse_number": "२-३८-५२", "content_sanskrit": "एष ते स्वस्य वंशस्य प्रभवः सम्प्रकीर्तितः ।\nश्रुतो मया पुरा कृष्ण कृष्णद्वैपायनान्तिकात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006381052, "chapter_id": 26381, "verse_number": "२-३८-५३", "content_sanskrit": "त्वं त्विदानीं प्रणष्टेऽस्मिन् वंशे वंशभृतां वर ।\nस्वयम्भूरिव सम्प्राप्तो भवायास्मज्जयाय च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006381053, "chapter_id": 26381, "verse_number": "२-३८-५४", "content_sanskrit": "न तु त्वां पौरमात्रेण शक्ता गूहयितुं वयम् ।\nदेवगुह्येष्वपि भवान् सर्वज्ञः सर्वभावनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006381054, "chapter_id": 26381, "verse_number": "२-३८-५५", "content_sanskrit": "शक्तश्चापि जरासंधं नृपं योधयितुं विभो ।\nत्वद्बुद्धिवशगाः सर्वे वयं योधव्रते स्थिताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006381055, "chapter_id": 26381, "verse_number": "२-३८-५६", "content_sanskrit": "जरासंधस्तु बलवान् नृपाणां मूर्ध्नि तिष्ठति ।\nअप्रमेयबलश्चैव वयं च कृशसाधनाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006381056, "chapter_id": 26381, "verse_number": "२-३८-५७", "content_sanskrit": "न चेयमेकाहमपि पुरी रोधं सहिष्यति ।\nकृशभक्तेन्धनक्षामा दुर्गैरपरिवेष्टिता ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006381057, "chapter_id": 26381, "verse_number": "२-३८-५८", "content_sanskrit": "असंस्कृताम्बुपरिखा द्वारयन्त्रविवर्जिता ।\nवप्रप्राकारनिचया कर्तव्या बहुविस्तरा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006381058, "chapter_id": 26381, "verse_number": "२-३८-५९", "content_sanskrit": "संस्कर्तव्यायुधागारा योक्तव्या चेष्टिकाचयैः ।\nकंसस्य बलभोग्यत्वान्नातिगुप्ता पुरा जनैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006381059, "chapter_id": 26381, "verse_number": "२-३८-६०", "content_sanskrit": "सद्यो निपतिते कंसे राज्येऽस्माकं नवोदये ।\nपुरी प्रत्यग्ररोधेव न रोधं विसहिष्यति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006381060, "chapter_id": 26381, "verse_number": "२-३८-६१", "content_sanskrit": "बलं सम्मर्दभग्नं च कृष्यमाणं परेण ह ।\nअसंशयमिदं राष्ट्रं जनैः सह विनङ्क्ष्यति ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006381061, "chapter_id": 26381, "verse_number": "२-३८-६२", "content_sanskrit": "यादवानां विरोधेन ये जिता राज्यकामुकैः ।\nते सर्वे द्वैधमिच्छन्ति यत्क्षमं तद्विधीयताम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006381062, "chapter_id": 26381, "verse_number": "२-३८-६३", "content_sanskrit": "वञ्चनीया भविष्यामो नृपाणां नृपकारणात् ।\nजरासंधभयार्तानां द्रवतां राज्यसम्भ्रमे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006381063, "chapter_id": 26381, "verse_number": "२-३८-६४", "content_sanskrit": "आर्ता वक्ष्यन्ति नः सर्वे रुध्यमानाः पुरे जनाः ।\nयादवानां विरोधेन विनष्टाः स्मेति केशव ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006381064, "chapter_id": 26381, "verse_number": "२-३८-६५", "content_sanskrit": "एतन्मम मतं कृष्ण विस्रम्भात्समुदाहृतम् ।\nत्वं तु विज्ञापितः पूर्वं न पुनः सम्प्रबोधितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006381065, "chapter_id": 26381, "verse_number": "२-३८-६६", "content_sanskrit": "यदत्र वः क्षमं कृष्ण तच्च वै संविधीयताम् ।\nत्वमस्य नेता सैन्यस्य वयं त्वच्छासने स्थिताः ।\nत्वन्मूलश्च विरोधोऽयं रक्षास्मानात्मना सह ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]