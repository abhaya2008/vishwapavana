[{"id": 7006346000, "chapter_id": 26346, "verse_number": "२-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम् ।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006346001, "chapter_id": 26346, "verse_number": "२-१-२", "content_sanskrit": "वैशम्पायन उवाच\nज्ञात्वा विष्णुं क्षितिगतं भागांश्च त्रिदिवौकसाम् ।\nविनाशशंसी कंसस्य नारदो मथुरां ययौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006346002, "chapter_id": 26346, "verse_number": "२-१-३", "content_sanskrit": "त्रिविष्टपादापतितो मथुरोपवने स्थितः ।\nप्रेषयामास कंसस्य दूतं स मुनिपुङ्गवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006346003, "chapter_id": 26346, "verse_number": "२-१-४", "content_sanskrit": "स दूतः कथयामास मुनेरागमनं वने ।\nस नारदस्यागमनं श्रुत्वा त्वरितविक्रमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006346004, "chapter_id": 26346, "verse_number": "२-१-५", "content_sanskrit": "निर्जगामासुरः कंसः स्वपुर्याः पद्मलोचनः ।\nस ददर्शातिथिं श्लाघ्यं देवर्षिं वीतकल्मषम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006346005, "chapter_id": 26346, "verse_number": "२-१-६", "content_sanskrit": "तेजसा ज्वलनाकारं वपुषा सूर्यवर्चसम् ।\nसोऽभिवाद्यर्षये तस्मै पूजां चक्रे यथाविधि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006346006, "chapter_id": 26346, "verse_number": "२-१-७", "content_sanskrit": "आसनं चाग्निवर्णाभं विसृज्योपजहार सः ।\nनिषसादासने तस्मिन् स वै शक्रसखो मुनिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006346007, "chapter_id": 26346, "verse_number": "२-१-८", "content_sanskrit": "उवाच चोग्रसेनस्य सुतं परमकोपनम् ।\nपूजितोऽहं त्वया वीर विधिदृष्टेन कर्मणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006346008, "chapter_id": 26346, "verse_number": "२-१-९", "content_sanskrit": "यते त्वेवं मम वचः श्रूयतां गृह्यतां त्वया ।\nअनुसृत्य दिवोलोकानहं ब्रह्मपुरोगमान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006346009, "chapter_id": 26346, "verse_number": "२-१-१०", "content_sanskrit": "गतः सूर्यसखं तात विपुलं मेरुपर्वतम्।\nसनन्दनवनं चैव दृष्ट्वा चैत्ररथं वनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006346010, "chapter_id": 26346, "verse_number": "२-१-११", "content_sanskrit": "आप्लुतं सर्वतीर्थेषु सरित्सु सह दैवतैः ।\nदिव्या त्रिधारा दृष्टा मे पुण्या त्रिपथगा नदी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006346011, "chapter_id": 26346, "verse_number": "२-१-१२", "content_sanskrit": "स्मरणादेव सर्वेषामंहसा या विभेदिनी ।\nउपस्पृष्टं च तीर्थेषु दिव्येषु च यथाक्रमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006346012, "chapter_id": 26346, "verse_number": "२-१-१३", "content_sanskrit": "दृष्टं मे ब्रह्मसदनं ब्रह्मर्षिगणसेवितम्।\nदेवगन्धर्वनिर्घोषैरप्सरोभिश्च नादितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006346013, "chapter_id": 26346, "verse_number": "२-१-१४", "content_sanskrit": "सोऽहं कदाचिद् देवानां समाजे मेरुमूर्धनि ।\nसंगृह्य वीणां संसक्तामगच्छं ब्रह्मणः सभाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006346014, "chapter_id": 26346, "verse_number": "२-१-१५", "content_sanskrit": "सोऽहं तत्र सितोष्णीषान् नानारत्नविभूषितान् ।\nदिव्यासनगतान् देवानपश्यं सपितामहान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006346015, "chapter_id": 26346, "verse_number": "२-१-१६", "content_sanskrit": "तत्र मन्त्रयतामेवं देवतानां मया श्रुतः ।\nभवतः सानुगस्यैव वधोपायः सुदारुणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006346016, "chapter_id": 26346, "verse_number": "२-१-१७", "content_sanskrit": "तत्रैषा देवकी या ते मथुरायां लघुस्वसा ।\nयोऽस्यां गर्भोऽष्टमः कंस स ते मृत्युर्भविष्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006346017, "chapter_id": 26346, "verse_number": "२-१-१८", "content_sanskrit": "देवानां स तु सर्वस्वं त्रिदिवस्य गतिश्च सः ।\nपरं रहस्यं देवानां स ते मृत्युर्भविष्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006346018, "chapter_id": 26346, "verse_number": "२-१-१९", "content_sanskrit": "परश्चैवापरस्तेषां स्वयम्भूश्च दिवौकसाम्।\nततस्ते तन्महद्भूतं दिव्यं च कथयाभ्यहम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006346019, "chapter_id": 26346, "verse_number": "२-१-२०", "content_sanskrit": "श्लाघ्यश्च स हि ते मृत्युर्भूतपूर्वश्च तं स्मर ।\nयत्नश्च क्रियतां कंस देवक्या गर्भकृन्तने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006346020, "chapter_id": 26346, "verse_number": "२-१-२१", "content_sanskrit": "एषा मे त्वद्गता प्रीतिर्यदर्थं चाहमागतः ।\nभुज्यन्तां सर्वकामार्थाः स्वस्ति तेऽस्तु व्रजाम्यहम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006346021, "chapter_id": 26346, "verse_number": "२-१-२२", "content_sanskrit": "इत्युक्त्वा नारदे याते तस्य वाक्यं विचिन्तयन् ।\nजहासोच्चैस्ततः कंसः प्रकाशदशनश्चिरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006346022, "chapter_id": 26346, "verse_number": "२-१-२३", "content_sanskrit": "प्रोवाच सस्मितं चैव भृत्यानामग्रतः स्थितः ।\nहास्यः खलु स सर्वेषु नारदो न विशारदः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006346023, "chapter_id": 26346, "verse_number": "२-१-२४", "content_sanskrit": "नाहं भीषयितुं शक्यो देवैरपि सवासवैः ।\nआसनस्थः शयानो वा प्रमत्तो मत्त एव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006346024, "chapter_id": 26346, "verse_number": "२-१-२५", "content_sanskrit": "योऽहं दोर्भ्यामुदाराभ्यां क्षोभयेयं धरामिमाम् ।\nकोऽस्ति मां मानुषे लोके यः क्षोभयितुमुत्सहेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006346025, "chapter_id": 26346, "verse_number": "२-१-२६", "content_sanskrit": "अद्यप्रभृति देवानामेवं देवानुवर्तिनाम् ।\nनृपक्षिपशुसंघानां करोमि कदनं महत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006346026, "chapter_id": 26346, "verse_number": "२-१-२७", "content_sanskrit": "आज्ञाप्यतां  हयः केशी प्रलम्बो धेनुकस्तथा ।\nअरिष्टो वृषभश्चैव पूतना कालियस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006346027, "chapter_id": 26346, "verse_number": "२-१-२८", "content_sanskrit": "अटध्वं पृथिवीं कृत्स्नां यथेष्टं कामरूपिणः ।\nप्रहरध्वं च सर्वेषु येऽस्माकं पक्षदूषकाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006346028, "chapter_id": 26346, "verse_number": "२-१-२९", "content_sanskrit": "गर्भस्थानामपि गतिर्विज्ञेया चैव देहिनाम् ।\nनारदेन हि गर्भेभ्यो भयं नः समुदाहृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006346029, "chapter_id": 26346, "verse_number": "२-१-३०", "content_sanskrit": "भवन्तो हि यथाकामं मोदन्तां विगतज्वराः ।\nमां च वो नाथमाश्रित्य नास्ति देवकृतं भयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006346030, "chapter_id": 26346, "verse_number": "२-१-३१", "content_sanskrit": "स तु केलिकिलो विप्रो भेदशीलश्च नारदः ।\nसुश्लिष्टानपि लोकेऽस्मिन् भेदयँल्लभते रतिम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006346031, "chapter_id": 26346, "verse_number": "२-१-३२", "content_sanskrit": "कण्डूयमानः सततं लोकानटति चञ्चलः ।\nघटमानो नरेन्द्राणां तन्त्रैवराणि चैव हि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006346032, "chapter_id": 26346, "verse_number": "२-१-३३", "content_sanskrit": "एवं स विलपन्नेव वाङ्मात्रेणैव केवलम् ।\nविवेश कंसो भवनं दह्यमानेन चेतसा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]