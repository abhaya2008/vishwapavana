[{"id": 2005300, "chapter_id": 1105, "verse_number": "१-१०६-०x", "content_sanskrit": "शान्तनुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005301, "chapter_id": 1105, "verse_number": "१-१०६-१", "content_sanskrit": "आपवो नाम कोन्वेष वसूनां किं च दुष्कृतम्।\nशशाप यस्मात्कल्याणि स वसूंश्चारुदर्शने।\nयस्याभिशापात्ते सर्वे मानुषीं योनिमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005302, "chapter_id": 1105, "verse_number": "१-१०६-२", "content_sanskrit": "अनेन च कुमारेण त्वया दत्तेन किं कृतम्।\nयस्य चैव कृतेनायं मानुषेषु निवत्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005303, "chapter_id": 1105, "verse_number": "१-१०६-३", "content_sanskrit": "ईशा वै सर्वलोकस्य वसवस्ते च वै कथम्।\nमानुषेषूदपद्यन्त तन्ममाचक्ष्व जाह्नवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005304, "chapter_id": 1105, "verse_number": "१-१०६-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005305, "chapter_id": 1105, "verse_number": "१-१०६-४", "content_sanskrit": "एवमुक्ता तदा गङ्गा राजानमिदमब्रवीत्।\nभर्तारं जाह्नवी देवी शान्तनुं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005306, "chapter_id": 1105, "verse_number": "१-१०६-५x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005307, "chapter_id": 1105, "verse_number": "१-१०६-५", "content_sanskrit": "यं लेभे वरुणः पुत्रं पुरा भरतसत्तम।\nवसिष्ठनामा स मुनिः ख्यात आपव इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005308, "chapter_id": 1105, "verse_number": "१-१०६-६", "content_sanskrit": "तस्याश्रमपदं पुण्यं मृगपक्षिसमन्वितम्।\nमेरोः पार्श्वे नगेन्द्रस्य सर्वर्तुकुसुमावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005309, "chapter_id": 1105, "verse_number": "१-१०६-७", "content_sanskrit": "स वारुणिस्तपस्तेपे तस्मिन्भरतसत्तम।\nवने पुण्यकृतां श्रेष्ठः स्वादुमूलफलोदके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005310, "chapter_id": 1105, "verse_number": "१-१०६-८", "content_sanskrit": "दक्षस्य दुहिता या तु सुरभीत्यभिशब्दिता।\nगां प्रजाता तु सा देवी कश्यपाद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005311, "chapter_id": 1105, "verse_number": "१-१०६-९", "content_sanskrit": "अनुग्रहार्थं जगतः सर्वकामदुहां वराम्।\nतां लेभे गां तु धर्मात्मा होमधेनुं स वारुणिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005312, "chapter_id": 1105, "verse_number": "१-१०६-१०", "content_sanskrit": "सा तस्मिंस्तापसारण्ये वसन्ती मुनिसेविते।\nचचार पुण्ये रम्ये च गौरपेतभया तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005313, "chapter_id": 1105, "verse_number": "१-१०६-११", "content_sanskrit": "अथ तद्वनमाजग्मुः कदाचिद्भरतर्षभ।\nपृथ्वाद्या वसवः सर्वे देवा देवर्षिसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005314, "chapter_id": 1105, "verse_number": "१-१०६-१२", "content_sanskrit": "ते सदारा वनं तच्च व्यचरन्त समन्ततः।\nरेमिरे रमणीयेषु पर्वतेषु वनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005315, "chapter_id": 1105, "verse_number": "१-१०६-१३", "content_sanskrit": "तत्रैकस्याथ भार्या तु वसोर्वासवविक्रम।\nसंचरन्ती वने तस्मिन्गां ददर्श सुमध्यमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005316, "chapter_id": 1105, "verse_number": "१-१०६-१४", "content_sanskrit": "नन्दिनीं नाम राजेन्द्र सर्वकामधुगुत्तमाम्।\nसा विस्मयसमाविष्टा शीलद्रविणसंपदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005317, "chapter_id": 1105, "verse_number": "१-१०६-१५", "content_sanskrit": "द्यवे वै दर्शयामास तां गां गोवृषभेक्षण।\nआपीनां च सुदोग्ध्रीं च सुवालधिखुरां शुभां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005318, "chapter_id": 1105, "verse_number": "१-१०६-१६", "content_sanskrit": "उपपन्नां गुणैः सर्वैः शीलेनानुत्तमेन च।\nएवंगुणसमायुक्तां वसवे वसुनन्दिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005319, "chapter_id": 1105, "verse_number": "१-१०६-१७", "content_sanskrit": "दर्शयामास राजेन्द्र पुरा पौरवनन्दन।\nद्यौस्तदा तां तु दृष्ट्वैव गां गजेन्द्रेन्द्रविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005320, "chapter_id": 1105, "verse_number": "१-१०६-१८", "content_sanskrit": "उवाच राजंस्तां देवीं तस्या रूपगुणान्वदन्।\nएषा गौरुत्तमा देवी वारुणेरसितेक्षणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005321, "chapter_id": 1105, "verse_number": "१-१०६-१९", "content_sanskrit": "ऋषेस्तस्य वरारोहे यस्येदं वनमुत्तमम्।\nअस्याः क्षीरं पिबेन्मर्त्यः स्वादु यो वै सुमध्यमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005322, "chapter_id": 1105, "verse_number": "१-१०६-२०", "content_sanskrit": "दशवर्षसहस्राणि स जीवेत्स्थिरयौवनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005323, "chapter_id": 1105, "verse_number": "१-१०६-२०x", "content_sanskrit": "वैशम्पायन उवाच।\nएतच्छ्रुत्वा तु सा देवी नृपोत्तम सुमध्यमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005324, "chapter_id": 1105, "verse_number": "१-१०६-२१", "content_sanskrit": "तमुवाचानवद्याङ्गी भर्तारं दीप्ततेजसम्।\nअस्ति मे मानुषे लोके नरदेवात्मजा सखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005325, "chapter_id": 1105, "verse_number": "१-१०६-२२", "content_sanskrit": "नाम्नाजितवती नाम रूपयौवनशालिनी।\nउशीनरस्य राजर्षेः सत्यसन्धस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005326, "chapter_id": 1105, "verse_number": "१-१०६-२३", "content_sanskrit": "दुहिता प्रथिता लोके मानुषे रूपसंपदा।\nतस्या हेतोर्महाभाग सवत्सां गां ममेप्सिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005327, "chapter_id": 1105, "verse_number": "१-१०६-२४", "content_sanskrit": "आनयस्वामरश्रेष्ठ त्वरितं पुण्यवर्धन।\nयावदस्याः पयः पीत्वा सा सखी मम मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005328, "chapter_id": 1105, "verse_number": "१-१०६-२५", "content_sanskrit": "मानुषेषु भवत्वेका जरारोगविवर्जिता।\nएतन्मम महाभाग कर्तुमर्हस्यनिन्दित॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005329, "chapter_id": 1105, "verse_number": "१-१०६-२६", "content_sanskrit": "प्रियात्प्रियतरं ह्यस्मान्नास्ति मेऽन्यत्कथंचन।\nएतच्छ्रुत्वा वचस्तस्या देव्याः प्रियचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005330, "chapter_id": 1105, "verse_number": "१-१०६-२७", "content_sanskrit": "पृथ्वाद्यैर्भ्रातृभिः सार्धं द्यौस्तदा तां जहार गाम्।\nतया कमलपत्राक्ष्या नियुक्तो द्यौस्तदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005331, "chapter_id": 1105, "verse_number": "१-१०६-२८", "content_sanskrit": "ऋषेस्तस्य तपस्वीव्रं न शशाक निरीक्षितुम्।\nहृता गौः सा तदा तेन प्रपातस्तु न तर्कितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005332, "chapter_id": 1105, "verse_number": "१-१०६-२९", "content_sanskrit": "अथाश्रमपदं प्राप्तः फलान्यादाय वारुणिः।\nन चापश्यत्स गां तत्र सवत्सां काननोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005333, "chapter_id": 1105, "verse_number": "१-१०६-३०", "content_sanskrit": "ततः स मृगयामास वने तस्मिंस्तपोधनः।\nनाध्यागमच्च मृगयंस्तां गां मुनिरुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005334, "chapter_id": 1105, "verse_number": "१-१०६-३१", "content_sanskrit": "ज्ञात्वा तथाऽपनीतां तां वसुभिर्दिव्यदर्शनः।\nययौ क्रोधवशं सद्यः शशाप च वसूंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005335, "chapter_id": 1105, "verse_number": "१-१०६-३२", "content_sanskrit": "यस्मान्मे वसवो जह्रुर्गां वै दोग्ध्रीं सुवालधिम्।\nतस्मात्सर्वे जनिष्यन्ति मानुषेषु न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005336, "chapter_id": 1105, "verse_number": "१-१०६-३३", "content_sanskrit": "एवं शशाप भगवान्वसूंस्तान्भरतर्षभ।\nवशं क्रोधस्य संप्राप्त आपवो मुनिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005337, "chapter_id": 1105, "verse_number": "१-१०६-३४", "content_sanskrit": "शप्त्वा च तान्महाभागस्तपस्येव मनो दधे।\nएवं स शप्तवान्राजन्वसूनष्टौ तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005338, "chapter_id": 1105, "verse_number": "१-१०६-३५", "content_sanskrit": "महाप्रभावो ब्रह्मर्षिर्देवान्क्रोधसमन्वितः।\nएवं शप्तास्ततस्तेन मुनिना यामुनेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005339, "chapter_id": 1105, "verse_number": "१-१०६-३६", "content_sanskrit": "अष्टौ समस्ता वंसवो दिवो दोषेण सत्तम।\nअथाश्रमपदं प्राप्तास्ते वै भूयो महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005340, "chapter_id": 1105, "verse_number": "१-१०६-३७", "content_sanskrit": "शप्ताः स्म इति जानन्त ऋषिं तमुपचक्रमुः।\nप्रसादयन्तस्तमृषिं वसवः पार्थिवर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005341, "chapter_id": 1105, "verse_number": "१-१०६-३८", "content_sanskrit": "लेभिरे न च तस्मात्ते प्रसादमृषिसत्तमात्।\nआपवात्पुरुषव्याघ्र सर्वधर्मविशारदात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005342, "chapter_id": 1105, "verse_number": "१-१०६-३९", "content_sanskrit": "उवाच च स धर्मात्मा शप्ता यूयं धरादयः।\nअनुसंवत्सरात्सर्वे शापमोक्षमवाप्स्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005343, "chapter_id": 1105, "verse_number": "१-१०६-४०", "content_sanskrit": "अयं तु यत्कृते यूयं मया शप्ताः स वत्स्यति।\nद्यौस्तदा मानुषे लोके दीर्घकालं स्वकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005344, "chapter_id": 1105, "verse_number": "१-१०६-४१", "content_sanskrit": "नानृतं तच्चिकीर्षामि क्रुद्धो युष्मान्यदब्रुवम्।\nन प्रजास्यति चाप्येष मानुषेषु महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005345, "chapter_id": 1105, "verse_number": "१-१०६-४२", "content_sanskrit": "भविष्यति च धर्मात्मा सर्वशास्त्रविशारदः।\nपितुः प्रियहिते युक्तः स्त्रीभोगान्वर्जयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005346, "chapter_id": 1105, "verse_number": "१-१०६-४३", "content_sanskrit": "एवमुक्त्वा वसून्सर्वान्सजगाम महानृषिः।\nततो मामुपजग्मुस्ते समेता वसवस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005347, "chapter_id": 1105, "verse_number": "१-१०६-४४", "content_sanskrit": "अयाचन्त च मां राजन्वरं तच्च मया कृतम्।\nजाताञ्जातान्प्रक्षिपास्मान्स्वयं गङ्गे त्वमम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005348, "chapter_id": 1105, "verse_number": "१-१०६-४५", "content_sanskrit": "एवं तेषामहं सम्यक् शप्तानां राजसत्तम।\nमोक्षार्थं मानुषाल्लोकाद्यथावत्कृतवत्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005349, "chapter_id": 1105, "verse_number": "१-१०६-४६", "content_sanskrit": "अयं शापादृषेस्तस्य एक एव नृपोत्तम।\nद्यौ राजन्मानुषे लोके चिरं वत्स्यति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2005350, "chapter_id": 1105, "verse_number": "१-१०६-४७", "content_sanskrit": "अयं कुमारः पुत्रस्ते विवृद्धः पुनरेष्यति।\nअहं च ते भविष्यामि आह्वानोपगता नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2005351, "chapter_id": 1105, "verse_number": "१-१०६-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2005352, "chapter_id": 1105, "verse_number": "१-१०६-४८", "content_sanskrit": "एतदाख्याय सा देवी तत्रैवान्तरधीयत।\nआदाय च कुमारं तं जगामाथ यथेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2005353, "chapter_id": 1105, "verse_number": "१-१०६-४९", "content_sanskrit": "स तु देवव्रतो नाम गाङ्गेय इति चाभवत्।\nद्युनामा शान्तनोः पुत्रः शान्तनोरधिको गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2005354, "chapter_id": 1105, "verse_number": "१-१०६-५०", "content_sanskrit": "शान्तनुश्चापि शोकार्तो जगाम स्वपुरं ततः।\nतस्याहं कीर्तयिष्यामि शान्तनोरधिकान्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2005355, "chapter_id": 1105, "verse_number": "१-१०६-५१", "content_sanskrit": "महाभाग्यं च नृपतेर्भारतस्य महात्मनः।\nयस्येतिहासो द्युतिमान्महाभारतमुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2005356, "chapter_id": 1105, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षडधिकशततमोऽध्यायः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]