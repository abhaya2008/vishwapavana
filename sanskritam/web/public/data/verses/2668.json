[{"id": 2078515, "chapter_id": 2668, "verse_number": "१२-१७३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078516, "chapter_id": 2668, "verse_number": "१२-१७३-१", "content_sanskrit": "धर्माः पितामहेनोक्ता राजधर्माश्रिताः शुभाः।\nधर्ममाश्रमिणां श्रेष्ठं वक्तुमर्हसि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078517, "chapter_id": 2668, "verse_number": "१२-१७३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078518, "chapter_id": 2668, "verse_number": "१२-१७३-२", "content_sanskrit": "सर्वत्र विहितो धर्मः स्वर्ग्यः सत्यफलोदयः।\nबहुद्वारस्य धर्मस्य नेहास्ति विफला क्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078519, "chapter_id": 2668, "verse_number": "१२-१७३-३", "content_sanskrit": "यस्मिन्यस्मिंस्तु विषये योयो याति विनिश्चयम्।\nस तमेवाभिजानाति नान्यं भरतसत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078520, "chapter_id": 2668, "verse_number": "१२-१७३-४", "content_sanskrit": "यथायथा च पर्येति लोकतन्त्रमसारवत्।\nतथातथा विरागोऽत्र जायते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078521, "chapter_id": 2668, "verse_number": "१२-१७३-५", "content_sanskrit": "एवं व्यवसिते लोके बहुदोषे युधिष्ठिर।\nआत्ममोक्षनिमित्तं वै यतेत मतिमान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078522, "chapter_id": 2668, "verse_number": "१२-१७३-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078523, "chapter_id": 2668, "verse_number": "१२-१७३-६", "content_sanskrit": "नष्टे धने वा दारे वा पुत्रे पितरि वा मृते।\nयया बुद्ध्या नुदेच्छोक तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078524, "chapter_id": 2668, "verse_number": "१२-१७३-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078525, "chapter_id": 2668, "verse_number": "१२-१७३-७", "content_sanskrit": "नष्टे धने वा दारे वा पुत्रे पितरि वा मृते।\nअहोदुःखमिति ध्यायञ्शोकस्यापचितिं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078526, "chapter_id": 2668, "verse_number": "१२-१७३-८", "content_sanskrit": "अत्राप्युदाहरन्तीममिहासं पुरातनम्।\nयथा सेनजितं विप्रः कश्चिदेत्याब्रवीत्सुहृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078527, "chapter_id": 2668, "verse_number": "१२-१७३-९", "content_sanskrit": "पुत्रशोकाभिसंतप्तं राजानं शोकविह्वलम्।\nविषण्णमनसं दृष्ट्वा विप्रो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078528, "chapter_id": 2668, "verse_number": "१२-१७३-१०", "content_sanskrit": "किंनु मुह्यसि मूढस्त्वं शोच्यः किमनु शोचसि।\nयदा त्वामपि शोचंतः शोच्या यास्यन्ति तां गातिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078529, "chapter_id": 2668, "verse_number": "१२-१७३-११", "content_sanskrit": "त्वं चैवाहं च ये चान्ये त्वां राजन्पर्युपासते।\nसर्वे तत्र गमिष्यामो यत एवागता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078530, "chapter_id": 2668, "verse_number": "१२-१७३-१२x", "content_sanskrit": "सेनजिदुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078531, "chapter_id": 2668, "verse_number": "१२-१७३-१२", "content_sanskrit": "का बुद्धिः किं तपो विप्र कः समाधिस्तपोधन।\nकिं ज्ञानं किं श्रुतं वा ते यत्प्राप्य न विषीदसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078532, "chapter_id": 2668, "verse_number": "१२-१७३-१३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078533, "chapter_id": 2668, "verse_number": "१२-१७३-१३", "content_sanskrit": "हृष्यन्तमवसीदन्तं सुखदुःखविपर्यये।\nआत्मानमनुशोचामि यो ममैष हृदि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078534, "chapter_id": 2668, "verse_number": "१२-१७३-१४", "content_sanskrit": "पश्य भूतानि दुःखेन व्यतिषिक्तानि सर्वशः।\nउत्तमाधममध्यानि तेषु तेष्विह कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078535, "chapter_id": 2668, "verse_number": "१२-१७३-१५", "content_sanskrit": "आत्माऽपि चायं न मम सर्वा वा पृथिवी मम।\nयथा मम तथाऽन्येषामिति मत्वा न मे व्यथा।\nएतां बुद्धिमहं प्राप्य न प्रहृष्ये न च व्यथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078536, "chapter_id": 2668, "verse_number": "१२-१७३-१६", "content_sanskrit": "यथा काष्ठं च काष्ठं च समेयातां महोदधौ।\nसमेत्य च व्यपेयातां तद्वद्भूतसमागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078537, "chapter_id": 2668, "verse_number": "१२-१७३-१७", "content_sanskrit": "एवं पुत्राश्च पौत्राश्च ज्ञातयो बान्धवास्तथा।\nतेषु स्नेहो न कर्तव्यो विप्रयोगो ध्रुवो हि तैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078538, "chapter_id": 2668, "verse_number": "१२-१७३-१८", "content_sanskrit": "अदर्शनादापतितः पुनश्चादर्शनं गतः।\nन त्वाऽसौ वेद न त्वंतं कस्मात्त्वमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078539, "chapter_id": 2668, "verse_number": "१२-१७३-१९", "content_sanskrit": "सुखान्तप्रभवं दुःखं दुःखान्तप्रभवं सुखम्।\nसुखात्संजायते दुःखं दुःखात्संजायते सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078540, "chapter_id": 2668, "verse_number": "१२-१७३-२०", "content_sanskrit": "सुखस्यानन्तरं दुःखं दुःखस्यानन्तरं सुखम्।\nसुखदुःखे मनुष्याणां चक्रवत्परिवर्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078541, "chapter_id": 2668, "verse_number": "१२-१७३-२१", "content_sanskrit": "सुखात्त्वं दुःखमापन्नः पुनरापत्स्यसे सुखम्।\nन नित्यं लभते दुःखं न नित्यं लभते सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078542, "chapter_id": 2668, "verse_number": "१२-१७३-२२", "content_sanskrit": "[शरीरमेवायतनं सुखस्य\nदुःखस्य चाप्यायतनं शरीरम्।\nयद्यच्छरीरेण करोति कर्म\nतेनैव देही समुपाश्नुते तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078543, "chapter_id": 2668, "verse_number": "१२-१७३-२३", "content_sanskrit": "जीवितं च शरीरेण तेनैव सह जायते।\nउभे सह विवर्तेते उभे सह विनश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078544, "chapter_id": 2668, "verse_number": "१२-१७३-२४", "content_sanskrit": "स्नेहपाशैर्बहुविधैराविष्टविषया जनाः।\nअकृतार्थाश्च सीदन्ते जलैः सैकतसेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078545, "chapter_id": 2668, "verse_number": "१२-१७३-२५", "content_sanskrit": "स्नेहेन तैलवत्सर्वं सर्गचक्रे निपीड्यते।\nतिलपीडैरिवाक्रम्य क्लेशैरज्ञानसंभवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078546, "chapter_id": 2668, "verse_number": "१२-१७३-२६", "content_sanskrit": "संचिनोत्यशुभं कर्म कलत्रापेक्षया नरः।\nएकः क्लेशानवाप्नोति परत्रेह च मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078547, "chapter_id": 2668, "verse_number": "१२-१७३-२७", "content_sanskrit": "पुत्रदारकुटुम्बेषु प्रसक्ताः सर्वमानवाः।\nशोकपङ्कार्णवे मग्ना जीर्णा वनगजा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078548, "chapter_id": 2668, "verse_number": "१२-१७३-२८", "content_sanskrit": "पुत्रनाशे वित्तनाशे ज्ञातिसंबन्धिनामपि।\nप्राप्यते सुमहद्दुःखं दावाग्निप्रतिमं विभो।\nदैवायत्तमिदं सर्वं सुखदुःखे भवाभवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078549, "chapter_id": 2668, "verse_number": "१२-१७३-२९", "content_sanskrit": "असुहृत्ससुहृच्चापि सशत्रुर्मित्रवानपि।\nसप्रज्ञः प्रज्ञया हीनो दैवेन लभते सुखम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078550, "chapter_id": 2668, "verse_number": "१२-१७३-३०", "content_sanskrit": "नालं सुखाय सुहृदो नालं दुःखाय दुर्हृदः।\nन च प्रज्ञाऽलमर्थानां न सुखानामलं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078551, "chapter_id": 2668, "verse_number": "१२-१७३-३१", "content_sanskrit": "न बुद्धिर्धनलाभाय न मौढ्यमसमृद्ध्ये।\nलोकपर्यायवृत्तान्तं प्राज्ञो जानाति नेतरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078552, "chapter_id": 2668, "verse_number": "१२-१७३-३२", "content_sanskrit": "बुद्धिमन्तं च शूरं च मूढं भीरुं जडं कविम्।\nदुर्बलं बलवन्तं च भागिनं भजते सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078553, "chapter_id": 2668, "verse_number": "१२-१७३-३३", "content_sanskrit": "धेनुर्वत्सस्य गोपस्य स्वामिनस्तस्करस्य च।\nपयः पिबति यस्तस्या धेनुस्तस्येति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078554, "chapter_id": 2668, "verse_number": "१२-१७३-३४", "content_sanskrit": "ये च मूढतमा लोके ये च बुद्धेः परं गताः।\nते नराः सुखमेधन्ते क्लिश्यत्यन्तरितो जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078555, "chapter_id": 2668, "verse_number": "१२-१७३-३५", "content_sanskrit": "अन्तेषु रेमिरे धीरा न ते मध्येषु रेमिरे।\nअन्तप्राप्तिं सुखं प्राहुर्दुःखमन्तरमन्तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078556, "chapter_id": 2668, "verse_number": "१२-१७३-३६", "content_sanskrit": "सुखं स्वपिति दुर्मेधाः स्वानि कर्माण्यचिन्तयन्।\nअविज्ञानेन महता कम्बलेनेव संवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078557, "chapter_id": 2668, "verse_number": "१२-१७३-३७", "content_sanskrit": "ये च बुद्धिं परां प्राप्ता द्वन्द्वातीता विमत्सराः।\nतान्नैवार्था न चानर्था व्यथयन्ति कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078558, "chapter_id": 2668, "verse_number": "१२-१७३-३८", "content_sanskrit": "अथ ये बुद्धिमप्राप्ता व्यतिक्रान्ताश्च मूढताम्।\nतेऽतिवेलं प्रहृष्यन्ति संतापमुपयान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078559, "chapter_id": 2668, "verse_number": "१२-१७३-३९", "content_sanskrit": "नित्यं प्रमुदिता मूढा दिवि देवगणा इव।\nअवलेपेन महता परितृप्ता विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078560, "chapter_id": 2668, "verse_number": "१२-१७३-४०", "content_sanskrit": "सुखं दुःखान्तमालस्यं दुःखं दाक्ष्यं सुखोदयम्।\nभूतिश्चैव श्रिया सार्धं दक्षे वसति नालसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078561, "chapter_id": 2668, "verse_number": "१२-१७३-४१", "content_sanskrit": "सुखं वा यदि वा दुःखं प्रियं वा यदि वाऽप्रियम्।\nप्राप्तं प्राप्तमुपासीत हृदयेनापराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2078562, "chapter_id": 2668, "verse_number": "१२-१७३-४२", "content_sanskrit": "शोकस्थानसहस्राणि भयस्थानशतानि च।\nदिवसेदिवसे मूढमाविशन्ति न पण्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2078563, "chapter_id": 2668, "verse_number": "१२-१७३-४३", "content_sanskrit": "बुद्धिमन्तं कृतप्रज्ञं शुश्रूषुमनहंकृतम्।\nशान्तं जितेन्द्रियं चापि शोको न स्पृशते नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2078564, "chapter_id": 2668, "verse_number": "१२-१७३-४४", "content_sanskrit": "एतां बुद्धिं समास्थाय शुद्धचित्तश्चरेद्बुधः।\n`शुक्लकृष्णगतिज्ञं तं देवासुरविनिर्गमम्।\nउदयास्तमयज्ञं हि न शोकः स्प्रष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2078565, "chapter_id": 2668, "verse_number": "१२-१७३-४५", "content_sanskrit": "यन्निमत्तो भवेच्छोकस्रासो वा क्रोध एव वा।\nआयासो वा यतो मूलं तदेकाङ्गमपि त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2078566, "chapter_id": 2668, "verse_number": "१२-१७३-४६", "content_sanskrit": "यद्यत्त्यजति कामनां तत्सुखस्याभिपूर्यते।\nकामानुसारी पुरुषः कामाननुविनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2078567, "chapter_id": 2668, "verse_number": "१२-१७३-४७", "content_sanskrit": "यच्च कामसुखं लोके यच्च दिव्यं महत्सुखम्।\nतृष्णाक्षयसुखस्यैते नार्हतः षोडशीं कलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2078568, "chapter_id": 2668, "verse_number": "१२-१७३-४८", "content_sanskrit": "पूर्वदेहकृतं कर्म शुभं वा यदि वाऽशुभम्।\nप्राज्ञं मूढं तथा शूरं भजते तादृशं नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2078569, "chapter_id": 2668, "verse_number": "१२-१७३-४९", "content_sanskrit": "एवमव किलैतानि प्रियाण्येवाप्रियाणि च।\nजीवेषु परिवर्तन्ते दुःखानि च सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2078570, "chapter_id": 2668, "verse_number": "१२-१७३-५०", "content_sanskrit": "एतां बुद्धिं समास्थाय नावसीदेद्गुणान्वितः।\nसर्वान्कामाञ्जुगुप्सेन कोपं कुर्वीत पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2078571, "chapter_id": 2668, "verse_number": "१२-१७३-५१", "content_sanskrit": "वृत्त एव हृदि प्रौढो मृत्युरेप मनोभवः।\nक्रोधो नाम शरीरस्थो देहिनां प्रोच्यते बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2078572, "chapter_id": 2668, "verse_number": "१२-१७३-५२", "content_sanskrit": "यदा संहरते कामान्कूर्मोऽङ्गानीव सर्वशः।\nतदात्मज्योतिरात्मश्रीरात्मन्येव प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2078573, "chapter_id": 2668, "verse_number": "१२-१७३-५३", "content_sanskrit": "किंचिदेव ममत्वेन यदा भवति कल्पितम्।\nतदेव परितापाय नाशे संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2078574, "chapter_id": 2668, "verse_number": "१२-१७३-५४", "content_sanskrit": "न बिभेति यदा चायं यदा चास्मान्न विभ्यति।\nयदा नेच्छति न द्वेष्टि ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2078575, "chapter_id": 2668, "verse_number": "१२-१७३-५५", "content_sanskrit": "उभे सत्यानृते त्यक्त्वा शोकानन्दौ भयाभये।\nप्रियाप्रिये परित्यज्य प्रशान्तात्मा भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2078576, "chapter_id": 2668, "verse_number": "१२-१७३-५६", "content_sanskrit": "यदा न कुरुते धीरः सर्वभूतेषु पापकम्।\nकर्मणा मनसा वाचा ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2078577, "chapter_id": 2668, "verse_number": "१२-१७३-५७", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः।\nयोसौ प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2078578, "chapter_id": 2668, "verse_number": "१२-१७३-५८", "content_sanskrit": "अत्र पिङ्गलया गीता गाथा शृणु नराधिप।\nयथा सा कृच्छ्रकालेऽपि लेभे शर्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2078579, "chapter_id": 2668, "verse_number": "१२-१७३-५९", "content_sanskrit": "संकेते पिङ्गला वेश्या कान्तेनासीद्विनाकृता।\nअथ कृच्छ्रगता शान्तां बुद्धिमास्थापयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2078580, "chapter_id": 2668, "verse_number": "१२-१७३-६०x", "content_sanskrit": "पिङ्गलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2078581, "chapter_id": 2668, "verse_number": "१२-१७३-६०", "content_sanskrit": "उन्मत्ताऽहमनुन्मत्तं कान्तमन्ववसं चिरम्।\nअन्तिके रमणं सन्तं नैनमध्यगमं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2078582, "chapter_id": 2668, "verse_number": "१२-१७३-६१", "content_sanskrit": "एकस्थूणं नवद्वारमपिधास्याम्यगारकम्।\nका ह्यकान्तमिहायान्तं कान्त इत्यभिमंस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2078583, "chapter_id": 2668, "verse_number": "१२-१७३-६२", "content_sanskrit": "अकामाः कामरूपेण धूर्ताश्च नररूपिणः।\nन पुनर्वञ्चयिष्यन्ति प्रतिबुद्धाऽस्मि जागृमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2078584, "chapter_id": 2668, "verse_number": "१२-१७३-६३", "content_sanskrit": "अनर्थोऽपि भवत्यर्थो दैवात्पूर्वकृतेन वा।\nसंबुद्धाऽहं निराकारा नाहमद्याजितेन्द्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2078585, "chapter_id": 2668, "verse_number": "१२-१७३-६४", "content_sanskrit": "सुखं निराशः स्वपिति नैराश्यं परमं सुखम्।\nआशामनाशां कृत्वा हि सुखं स्वपिति पिङ्गला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2078586, "chapter_id": 2668, "verse_number": "१२-१७३-६५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2078587, "chapter_id": 2668, "verse_number": "१२-१७३-६५", "content_sanskrit": "एतैश्चान्यैश्च विप्रस्य हेतुमद्भिः प्रभाषितैः।\nपर्यवस्थापितो राजा सेनजिन्मुमुदे सुखम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2078588, "chapter_id": 2668, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि त्रिसप्तत्यधिकशततमोऽध्यायः॥ १७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]