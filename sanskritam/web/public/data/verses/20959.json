[{"id": 7000959000, "chapter_id": 20959, "verse_number": "१-२१-१", "content_sanskrit": "प्रह्लादपुत्र आयुष्माञ्छिबिर्बाष्कल एव च ।\nविरोचनस्तु प्राह्लादिर्बलिर्जज्ञे विरोचनात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000959001, "chapter_id": 20959, "verse_number": "१-२१-२", "content_sanskrit": "बलेः पुत्रशतं त्वासीद्बाणज्येष्ठं महामुने  ।\nहिरण्याक्षसुताश्चासन्सर्व एव महा बलाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000959002, "chapter_id": 20959, "verse_number": "१-२१-३", "content_sanskrit": "झर्झरः शकुनिश्चैव भूतसन्तापनस्तथा  ।\nमहानाभो महाबाहुः कालनाभस्तथापरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000959003, "chapter_id": 20959, "verse_number": "१-२१-४", "content_sanskrit": "अभवन्दनुपूत्राश्च द्विमूर्द्धा शंबरस्तथा ।\nअयोमुखः शंकुशिराः कपिलः शंकरस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000959004, "chapter_id": 20959, "verse_number": "१-२१-५", "content_sanskrit": "एकचक्रो महाबाहुस्तारकश्च महाबलः  ।\nस्वर्भानुर्वृषपर्वा च पुलोम च महाबलः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000959005, "chapter_id": 20959, "verse_number": "१-२१-६", "content_sanskrit": "एते दनोः सुताः ख्याता विप्रचित्तिश्च वीर्यवान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000959006, "chapter_id": 20959, "verse_number": "१-२१-७", "content_sanskrit": "स्वर्भानोस्तु प्रभा कन्या शर्मिष्ठा वार्षपर्वणी ।\nउपदानी हयशिराः प्रख्याता वरकन्यकाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000959007, "chapter_id": 20959, "verse_number": "१-२१-८", "content_sanskrit": "वैश्वानरसुते चोभे पुलोमा कालका तथा ।\nउभे सुते महाभागे मारीचेस्तु परिग्रहः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000959008, "chapter_id": 20959, "verse_number": "१-२१-९", "content_sanskrit": "ताभ्यां पुत्रसहस्राणि षष्टिर्दानवसत्तमाः ।\nपौलोमाः कालकेयाश्च मारीचतनयाः स्मृताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000959009, "chapter_id": 20959, "verse_number": "१-२१-१०", "content_sanskrit": "ततोऽपरेमहावीर्या दारुणास्त्वतिनिर्घृणाः ।\nसिंहिकायामथोत्पन्ना विप्रचित्तेः सुतास्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000959010, "chapter_id": 20959, "verse_number": "१-२१-११", "content_sanskrit": "त्र्! यंशः शल्यश्च बलवान् नभश्चैव महाबलः ।\nवातापी नमुचिश्चैव इल्वलः खसृमस्तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000959011, "chapter_id": 20959, "verse_number": "१-२१-१२", "content_sanskrit": "आन्धको नरकश्चैव कालनाभस्तथैव च ।\nस्वर्भानुश्च महावीर्यो वक्त्रयोधी महासुरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000959012, "chapter_id": 20959, "verse_number": "१-२१-१३", "content_sanskrit": "एते वै दानवाः श्रेष्ठा दनुवंशविवर्द्धनाः  ।\nएतेषां पुत्रपौत्राश्च शतशोऽथ सहस्रशः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000959013, "chapter_id": 20959, "verse_number": "१-२१-१४", "content_sanskrit": "प्रह्लादस्य तु दैत्यस्य निवातकवचाः कुले ।\nसमुत्पन्नाः सुमहता तपसा भावितात्मनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000959014, "chapter_id": 20959, "verse_number": "१-२१-१५", "content_sanskrit": "षट् सुताः सुमहासत्त्वास्ताम्रायाः परिकीर्त्तिताः  ।\nशुकी श्येनी च भासी च सुग्रीवी शुचिगृद्ध्रका ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000959015, "chapter_id": 20959, "verse_number": "१-२१-१६", "content_sanskrit": "शुकी शुकानजनयदुलूकप्रत्युलूकिकान्  ।\nश्येनी श्येनांस्तथा भासी भासान्गृद्धांश्च गृद्ध्र्यपि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000959016, "chapter_id": 20959, "verse_number": "१-२१-१७", "content_sanskrit": "शुच्यौदकान्पक्षिगणान्सुग्रीवी तु व्यजायत ।\nअश्वानुष्ट्रान्गर्दभांश्च ताम्रावंशः प्रकीर्त्तितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000959017, "chapter_id": 20959, "verse_number": "१-२१-१८", "content_sanskrit": "विनतायास्तु द्वौ पुत्रौ विरतौ गरुडारुणौ  ।\nसुपर्णः पततां श्रेष्ठो दारुणः पन्नगाशनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000959018, "chapter_id": 20959, "verse_number": "१-२१-१९", "content_sanskrit": "सुरसायां सहस्रं तु सर्पाणाममितौजसाम्  ।\nअनेकशिरसां ब्रह्मन् खेचराणां महात्मनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000959019, "chapter_id": 20959, "verse_number": "१-२१-२०", "content_sanskrit": "काद्र वेयास्तु बलिनः सहस्रममितौजसः  ।\nसुपर्णवशगा ब्रह्मन् जज्ञिरे नैकमस्तकाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000959020, "chapter_id": 20959, "verse_number": "१-२१-२१", "content_sanskrit": "तेषां प्रधानभूतास्तु श्षोवासुकितक्षकाः ।\nशंखश्वेतो महापद्मः कम्बलाश्वतरौ तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000959021, "chapter_id": 20959, "verse_number": "१-२१-२२", "content_sanskrit": "एलापुत्रस्तथा नागः कर्कोटकधनञ्जयौ ।\nएते चान्ये च बहवो दन्दशूका विषोल्बणाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000959022, "chapter_id": 20959, "verse_number": "१-२१-२३", "content_sanskrit": "गणं क्रोधवशं विद्धि तस्याः सर्वे च दंष्ट्रिणः ।\nस्थलजाः पक्षिणोब्जाश्च दारुणाः पिशिताशनाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000959023, "chapter_id": 20959, "verse_number": "१-२१-२४", "content_sanskrit": "क्रोधात्तु पिशाचांश्च जनयामास महाबलान्\nगास्तु वै जनयामास सुरभीर्महिषीस्तथा ।\nइरावृक्षलतावल्लीस्तृणजातीश्च सर्वशः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000959024, "chapter_id": 20959, "verse_number": "१-२१-२५", "content_sanskrit": "स्वसा तु यक्षरक्षांसि मुनिरप्सरसस्तथा  ।\nअरिष्टा तु महासत्त्वान् गन्धर्वान्समजीजनत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000959025, "chapter_id": 20959, "verse_number": "१-२१-२६", "content_sanskrit": "एते कश्यपदायादाः कीर्त्तिताः स्थाणुजङ्गमाः  ।\nतेषां पुत्राश्च पौत्राश्च शतशोथ सहस्रशः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000959026, "chapter_id": 20959, "verse_number": "१-२१-२७", "content_sanskrit": "एष मन्वन्तरे सर्गो ब्रह्मन्स्वारोचिषे स्मृतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000959027, "chapter_id": 20959, "verse_number": "१-२१-२८", "content_sanskrit": "वैवस्वते च महति वारुणे वितते कृतौ  ।\nजुह्वानस्य ब्रह्मणो वै प्रजासर्ग इहोच्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000959028, "chapter_id": 20959, "verse_number": "१-२१-२९", "content_sanskrit": "पूर्वं यत्र तु सप्तर्षिनुत्पन्नान्सप्तमानसान्  ।\nपुत्रत्वे कल्पयामास स्वयमेव पितामहः  ।\nगन्धर्वभोगिदेवानां दानवानां च सत्तम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000959029, "chapter_id": 20959, "verse_number": "१-२१-३०", "content_sanskrit": "दितिर्विनष्टपुत्रा वै तोषयामास काश्यपम्  ।\nतया चाराधितः सम्यक्काश्यपस्तपतां वरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000959030, "chapter_id": 20959, "verse_number": "१-२१-३१", "content_sanskrit": "वरेण च्छन्दयामास सा च वव्रे ततो वरम्  ।\nपुत्रमिन्द्र वधार्थाय समर्थममितौजसम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000959031, "chapter_id": 20959, "verse_number": "१-२१-३२", "content_sanskrit": "स च तस्मै वरं प्रादाद्भार्यायै मुनिसत्तमः  ।\nदत्त्वा च वरमत्युग्रं कश्यपस्तामुवाच ह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000959032, "chapter_id": 20959, "verse_number": "१-२१-३३", "content_sanskrit": "शक्रं पुत्रो निहन्ता ते यदि गर्भं शरच्छतम्  ।\nसमाहितातिप्रयता शौचिनी धारयिष्यसि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000959033, "chapter_id": 20959, "verse_number": "१-२१-३४", "content_sanskrit": "इत्येवमुक्त्वा तां देवीं संगतः कश्यपो मुनिः  ।\nदधार सा च तं गर्भं सम्यक्छोचसमन्विता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000959034, "chapter_id": 20959, "verse_number": "१-२१-३५", "content_sanskrit": "गर्भमात्मवधार्थाय ज्ञात्वा तं मघवानपि ।\nशुश्रूषुस्तामथागच्छद्विनयादमराधिपः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000959035, "chapter_id": 20959, "verse_number": "१-२१-३६", "content_sanskrit": "तस्याश्चैवान्तरप्रेप्सुरतिष्ठत्पाकशासनः ।\nऊने वर्षशते चास्या ददर्शान्तरमात्मना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000959036, "chapter_id": 20959, "verse_number": "१-२१-३७", "content_sanskrit": "अकृत्वा पादयोः शौचं दितिः शयनमाविशत्  ।\nनिद्रा ं! चाहारयामास तस्याः कुक्षिं प्रविश्य सः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000959037, "chapter_id": 20959, "verse_number": "१-२१-३८", "content_sanskrit": "वज्रपाणिर्महागर्भं चिच्छेदाथ स सप्तधा ।\nसम्पीड्यमानो वज्रेण स रुरोदातिदारुणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000959038, "chapter_id": 20959, "verse_number": "१-२१-३९", "content_sanskrit": "मा रोदीरिति तं शक्रः पुनःपुनरभाषत  ।\nसोऽभवत्सप्तधा गर्भस्तमिंद्र ः! कुपितः पुनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000959039, "chapter_id": 20959, "verse_number": "१-२१-४०", "content_sanskrit": "एकैकं सप्तधा चक्रे वज्रेणारिविदारिणा ।\nमरुतो नाम देवास्ते बभूवुरतिवेगिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000959040, "chapter_id": 20959, "verse_number": "१-२१-४१", "content_sanskrit": "यदुक्तं वै भगवता तेनैव मरुतोऽभवन्  ।\nदेवा एकोनपञ्चाशत्सहाया वज्रपाणिनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]