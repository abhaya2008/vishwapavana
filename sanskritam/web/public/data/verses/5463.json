[{"id": 2208927, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208928, "chapter_id": 5463, "verse_number": "१", "content_sanskrit": "स तं दृष्ट्वा तथाभूतं राजानं घोरदर्शनम् ।\nदीर्घश्मश्रुधरं नॄणां शोणितेन समुक्षितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208929, "chapter_id": 5463, "verse_number": "२", "content_sanskrit": "चकार न व्यथां विप्रो राजा त्वेनमथाब्रवीत् ।\nप्रत्युत्थाय महातेजा भयकर्ता यमोपमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208930, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208931, "chapter_id": 5463, "verse_number": "३", "content_sanskrit": "दिष्ट्या त्वमसि कल्याण षष्ठे काले ममान्तिकम् ।\nभक्ष्यं मृगयमाणस्य सम्प्राप्तो द्विजसत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208932, "chapter_id": 5463, "verse_number": "४", "content_sanskrit": "न च शक्यस्त्वमुत्स्रष्टुं क्षुधितस्य ममाद्य वै ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208933, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208934, "chapter_id": 5463, "verse_number": "५", "content_sanskrit": "राजन् गुर्वर्थिनं विद्धि चरन्तं मामिहागतम् ।\nन च गुर्वर्थमुद्युक्तं हिंस्यमाहुर्मनीषिणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208935, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208936, "chapter_id": 5463, "verse_number": "६", "content_sanskrit": "षष्ठे काले ममाहारो विहितो द्विजसत्तम ।\nन शक्यस्त्वं समुत्स्रष्टुं क्षुधितेन मयाऽद्य वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208937, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208938, "chapter_id": 5463, "verse_number": "७", "content_sanskrit": "एवमस्तु महाराज समयः क्रियतां तु वै ।\nगुर्वर्थमभिनिर्वर्त्य पुनरेष्यामि ते वशम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208939, "chapter_id": 5463, "verse_number": "८", "content_sanskrit": "संश्रुतश्च मया योऽर्थो गुरवे राजसत्तम ।\nत्वदधीनः स राजेन्द्र तं त्वा भिक्षे नरेश्वर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208940, "chapter_id": 5463, "verse_number": "९", "content_sanskrit": "ददासि विप्रमुख्येभ्यः त्वं हि रत्नानि नित्यदा ।\nदाता च त्वं नरव्याघ्र पात्रभूतः क्षितावहम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208941, "chapter_id": 5463, "verse_number": "१०", "content_sanskrit": "पात्रं प्रतिग्रहे चापि विद्धि मां नृपसत्तम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208942, "chapter_id": 5463, "verse_number": "११", "content_sanskrit": "उपाहृत्य गुरोरर्थं त्वदायत्तमरिन्दम ।\nसमयेनेह राजेन्द्र पुनरेष्यामि ते वशम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208943, "chapter_id": 5463, "verse_number": "१२", "content_sanskrit": "सत्यं ते प्रतिजानामि नात्र मिथ्या कथञ्चन ।\nअनृतं नोक्तपूर्वं मे स्वैरेष्वपि कुतोऽन्यथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208944, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208945, "chapter_id": 5463, "verse_number": "१३", "content_sanskrit": "यद्यस्मासु तवायत्तो गुर्वर्थः कृत एव सः ।\nयदि चास्ति प्रतिग्राह्यं साम्प्रतं तद् ब्रवीहि मे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208946, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208947, "chapter_id": 5463, "verse_number": "१४", "content_sanskrit": "प्रतिग्राह्यो वरो मे त्वं सदैव पुरुषर्षभ ।\nसोऽहं त्वामनु सम्प्राप्तो भिक्षितुं मणिकुण्डले ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208948, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208949, "chapter_id": 5463, "verse_number": "१५", "content_sanskrit": "पत्न्यास्त्वमपि विप्रर्षे रुचिरे मणिकुण्डले ।\nवरयार्थं त्वमन्यं मे तं ते दास्यामि सुव्रत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208950, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208951, "chapter_id": 5463, "verse_number": "१६", "content_sanskrit": "अलं ते व्यपदेशेन प्रमाणं यदि ते वयम् ।\nप्रयच्छ कुण्डले मे त्वं सत्यवाग् भव वै विभो ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208952, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208953, "chapter_id": 5463, "verse_number": "१७", "content_sanskrit": "इत्युक्तस्त्वब्रवीद् राजा तमुदङ्कं वचस्तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208954, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208955, "chapter_id": 5463, "verse_number": "१८", "content_sanskrit": "गच्छ मद्वचनाद् देवीं ब्रूहि देहीति सत्तम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208956, "chapter_id": 5463, "verse_number": "१९", "content_sanskrit": "सैवमुक्ता त्वया नूनं मद्वाक्येन शुचिव्रता ।\nप्रदास्यति द्विजश्रेष्ठ कुण्डले ते न संशयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208957, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208958, "chapter_id": 5463, "verse_number": "२०", "content_sanskrit": "क्व पत्नी भवतः शक्या मया द्रष्टुं नरेश्वर ।\nस्वयं वाऽपि भवान् पत्नीं किमर्थं नोपसर्पति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208959, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208960, "chapter_id": 5463, "verse_number": "२१", "content_sanskrit": "द्रक्ष्यते भवता साऽद्य कस्मिंश्चिद् वननिर्झरे ।\nषष्ठे काले न हि मया सा शक्या द्रष्टुमद्य वै ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208961, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208962, "chapter_id": 5463, "verse_number": "२२", "content_sanskrit": "उदङ्कस्तु तथेत्युक्त्वा जगाम भरतर्षभ ।\nमदयन्तीं च तां दृष्ट्वा ज्ञापयत् स्वं प्रयोजनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208963, "chapter_id": 5463, "verse_number": "२३", "content_sanskrit": "सौदासवचनं श्रुत्वा ततः सा पृथुलोचना ।\nप्रत्युवाच महाबुद्धिमुदङ्कं जनमेजय ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208964, "chapter_id": 5463, "verse_number": "", "content_sanskrit": "मदयन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208965, "chapter_id": 5463, "verse_number": "२४", "content_sanskrit": "एवमेतन्महाब्रह्मन् नानृतं भाषसेऽनघ ।\nअभिज्ञानं तु किञ्चिन्मे(त्वं) समानयितुमर्हसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208966, "chapter_id": 5463, "verse_number": "२५", "content_sanskrit": "इमे हि दिव्ये मणिकुण्डले शुभे\nदेवाश्च यक्षाश्च महोरगाश्च ।\nतैस्तैरुपायैरपहर्तुकामाः\nछिद्रेषु नित्यं परितर्कयन्ते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208967, "chapter_id": 5463, "verse_number": "२६", "content_sanskrit": "निक्षिप्तमेतद् भुवि पन्नगास्तु\nरत्नं समासाद्य परामृशेयुः ।\nयक्षास्तथोच्छिष्टधृतं सुराश्च\nनिद्रावशं त्वां परिधर्षयेयुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2208968, "chapter_id": 5463, "verse_number": "२७", "content_sanskrit": "छिद्रेष्वेतेषु च सदा धृष्यसे च द्विजर्षभ ।\nदैवराक्षसयक्षाणामप्रमत्तेन धार्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2208969, "chapter_id": 5463, "verse_number": "२८", "content_sanskrit": "एते दिवाऽपि भासेते रात्रौ च द्विजसत्तम ।\nनक्तं नक्षत्रताराणां प्रभामाक्षिप्य वर्ततः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2208970, "chapter_id": 5463, "verse_number": "२९", "content_sanskrit": "एते ह्यामुच्य भगवन् क्षुत्पिपासाभयं कुतः ।\nविषाग्निश्वापदेभ्यश्च भयं जातु न विद्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2208971, "chapter_id": 5463, "verse_number": "३०", "content_sanskrit": "ह्रस्वेन चैते आमुक्ते भवतो ह्रस्वके सदा ।\nअनुरूपेण चामुक्ते तत्प्रमाणे तथैव ते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2208972, "chapter_id": 5463, "verse_number": "३१", "content_sanskrit": "एवंविधे ममाप्येते कुण्डले परमार्चिते ।\nत्रिषु लोकेषु विख्याते तदभिज्ञानमानय ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2208973, "chapter_id": 5463, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि कुण्डलमाहात्म्यकथनं नाम सप्तपञ्चाशोऽध्यायः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]