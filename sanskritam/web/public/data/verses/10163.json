[{"id": 6000163000, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000163001, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.001.m4a", "display_order": 2}, {"id": 6000163002, "chapter_id": 10163, "verse_number": "८-१०-१", "content_sanskrit": "अथो सुराः प्रत्युपलब्धचेतसः परस्य पुंसः परयाऽनुकम्पया।\nजघ्नुर्भृशं शक्रसमीरणादयस्तांस्तान् रणे यैरभिसंहताः पुरा॥ ८/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.002.m4a", "display_order": 3, "topics": [{"text": "इन्द्रेण जम्भबलपाकनमुचिप्रभृतीनां वधः", "range": "१–४३"}]}, {"id": 6000163003, "chapter_id": 10163, "verse_number": "८-१०-२", "content_sanskrit": "वैरोचनाय संरब्धो भगवान् पाकशासनः।\nउदयच्छद् यदा वज्रं प्रजा हाहेति चुक्रुशुः॥ ८/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.003.m4a", "display_order": 4}, {"id": 6000163004, "chapter_id": 10163, "verse_number": "८-१०-३", "content_sanskrit": "वज्रपाणिस्तमाहेदं तिरस्कृत्य पुरः स्थितम्।\nमनस्विनं सुसम्पन्नं विचरन्तं महामृधे॥ ८/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.004.m4a", "display_order": 5}, {"id": 6000163005, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.005.m4a", "display_order": 6}, {"id": 6000163006, "chapter_id": 10163, "verse_number": "८-१०-४", "content_sanskrit": "नटवन्मूढ मायाभिर्मायेशान् नो जिगीषसि।\nजित्वा बालान् निबद्धाक्षान् यथा हरति तद्धनम्॥ ८/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.006.m4a", "display_order": 7}, {"id": 6000163007, "chapter_id": 10163, "verse_number": "८-१०-५", "content_sanskrit": "आरुरुक्षन्ति मायाभिरुत्सिसृप्सन्ति ये दिवम्।\nतान् दस्यून् विधुनोम्यज्ञान् पूर्वस्माच्च पदादधः॥ ८/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.007.m4a", "display_order": 8}, {"id": 6000163008, "chapter_id": 10163, "verse_number": "८-१०-६", "content_sanskrit": "सोऽहं दुर्मायिनस्तेऽद्य वज्रेण शतपर्वणा।\nशिरो हरिष्ये मन्दात्मन् घटस्व ज्ञातिभिः सह॥ ८/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.008.m4a", "display_order": 9}, {"id": 6000163009, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "बलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.009.m4a", "display_order": 10}, {"id": 6000163010, "chapter_id": 10163, "verse_number": "८-१०-७", "content_sanskrit": "सङ्ग्रामे वर्तमानानां कालेनोदितकर्मणाम्।\nकीर्तिर्जयोऽजयो मृत्युः सर्वेषां स्युरनुक्रमात्॥ ८/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.010.m4a", "display_order": 11}, {"id": 6000163011, "chapter_id": 10163, "verse_number": "८-१०-८", "content_sanskrit": "तमिमं कालरशनं जनाः पश्यन्ति सूरयः।\nन हृष्यन्ति न शोचन्ति तत्र यूयमपण्डिताः॥ ८/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.011.m4a", "display_order": 12}, {"id": 6000163012, "chapter_id": 10163, "verse_number": "८-१०-९", "content_sanskrit": "न वयं मन्यमानानामात्मानं तत्र कारणम्।\nगिरो वः साधु शोच्यानां गृह्णीमो मर्मताडनाः॥ ८/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.012.m4a", "display_order": 13}, {"id": 6000163013, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.013.m4a", "display_order": 14}, {"id": 6000163014, "chapter_id": 10163, "verse_number": "८-१०-१०", "content_sanskrit": "प्रत्याक्षिप्य विभुं वीरो नाराचैर्वीरमर्दनः।\nआकर्णपूर्णैरहनदाक्षेपैराहतं पुनः॥ ८/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.014.m4a", "display_order": 15}, {"id": 6000163015, "chapter_id": 10163, "verse_number": "८-१०-११", "content_sanskrit": "एवं निराकृतो देवो वैरिणा तथ्यवादिना।\nनामृष्यत् तदधिक्षेपं तोत्राहत इव द्विपः॥ ८/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.015.m4a", "display_order": 16}, {"id": 6000163016, "chapter_id": 10163, "verse_number": "८-१०-१२", "content_sanskrit": "प्राहरत् कुलिशं तस्मा अमोघं परमर्दनम्।\nसयानो न्यपतद् भूमौ छिन्नपक्ष इवाचलः॥ ८/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.016.m4a", "display_order": 17}, {"id": 6000163017, "chapter_id": 10163, "verse_number": "८-१०-१३", "content_sanskrit": "सखायं पतितं दृष्ट्वा जम्भो बलिसखः सुहृत्।\nअभ्ययात् सौहृदं सख्युर्हतस्यापि समाचरन्॥ ८/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.017.m4a", "display_order": 18}, {"id": 6000163018, "chapter_id": 10163, "verse_number": "८-१०-१४", "content_sanskrit": "स सिंहवाह आसाद्य गदामुद्यम्य रंहसा।\nजत्रावताडयच्छक्रं गजं च सुमहाबलः॥ ८/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.018.m4a", "display_order": 19}, {"id": 6000163019, "chapter_id": 10163, "verse_number": "८-१०-१५", "content_sanskrit": "गदाप्रहारव्यथितो भृशं विह्वलितो गजः।\nजानुभ्यां धरणीं स्पृष्ट्वा कश्मलं परमं ययौ॥ ८/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.019.m4a", "display_order": 20}, {"id": 6000163020, "chapter_id": 10163, "verse_number": "८-१०-१६", "content_sanskrit": "ततो रथो मातलिना हरिभिर्दशशतैर्वृतः।\nआनीतो द्विपमुत्सृज्य रथमारुरुहे विभुः॥ ८/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.020.m4a", "display_order": 21}, {"id": 6000163021, "chapter_id": 10163, "verse_number": "८-१०-१७", "content_sanskrit": "तस्य तत् पूजयन् कर्म यन्तुर्दानवसत्तमः।\nशूलेन ज्वलता तं तु स्मयमानोऽहनन्मृधे॥ ८/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.021.m4a", "display_order": 22}, {"id": 6000163022, "chapter_id": 10163, "verse_number": "८-१०-१८", "content_sanskrit": "सेहे रुजं सुदुर्मर्षं सत्त्वमालम्ब्य मातलिः।\nइन्द्रो जम्भस्य संक्रुद्धो वज्रेणापाहरच्छिरः॥ ८/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.022.m4a", "display_order": 23}, {"id": 6000163023, "chapter_id": 10163, "verse_number": "८-१०-१९", "content_sanskrit": "जम्भं श्रुत्वा हतं तस्य ज्ञातयो नारदादृषेः।\nनमुचिश्च बलः पाकस्‍त्रयोऽपेयुस्त्वराऽन्विताः॥ ८/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.023.m4a", "display_order": 24}, {"id": 6000163024, "chapter_id": 10163, "verse_number": "८-१०-२०", "content_sanskrit": "वचोभिः परुषैरिन्द्रं मर्दयन्तोऽस्य मर्मसु।\nशरैरवाकिरन् मेघा धाराभिरिव पर्वतम्॥ ८/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.024.m4a", "display_order": 25}, {"id": 6000163025, "chapter_id": 10163, "verse_number": "८-१०-२१", "content_sanskrit": "हरीन् दशशतानाजौ हर्यश्वस्य बलः शरैः।\nतावद्भिरर्दयामास युगपल्‍लघुहस्तवान्॥ ८/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.025.m4a", "display_order": 26}, {"id": 6000163026, "chapter_id": 10163, "verse_number": "८-१०-२२", "content_sanskrit": "शताभ्यां मातलिं पाको रथं सावयवं पृथक्।\nसकृत्सन्धानमोक्षेण तदद्भुतमभूद् रणे॥ ८/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.026.m4a", "display_order": 27}, {"id": 6000163027, "chapter_id": 10163, "verse_number": "८-१०-२३", "content_sanskrit": "नमुचिः पञ्चदशभिः स्वर्णपुङ्खैर्महेषुभिः।\nआहत्य व्यनदत् सङ्ख्ये सतोय इव तोयदः॥ ८/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.027.m4a", "display_order": 28}, {"id": 6000163028, "chapter_id": 10163, "verse_number": "८-१०-२४", "content_sanskrit": "सर्वतः शरकूटेन शक्रं सरथसारथिम्।\nछादयामासुरसुराः प्रावृट्‌सूर्यमिवाम्बुदाः॥ ८/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.028.m4a", "display_order": 29}, {"id": 6000163029, "chapter_id": 10163, "verse_number": "८-१०-२५", "content_sanskrit": "अलक्षयन्तस्तमतीव विह्वला विचुक्रुशुर्देवगणाः सहानुगाः।\nअनायकाः शत्रुबलेन निर्जिता वणिक्पथा भिन्ननवो यथाऽर्णवे॥ ८/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.029.m4a", "display_order": 30}, {"id": 6000163030, "chapter_id": 10163, "verse_number": "८-१०-२६", "content_sanskrit": "ततस्तुराषाडिषुबद्धपञ्जराद् विनिर्गतः साश्वरथध्वजाग्रणीः।\nबभौ दिशः खं पृथिवीं च रोचयन् स्वतेजसा सूर्य इव क्षपात्यये॥ ८/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.030.m4a", "display_order": 31}, {"id": 6000163031, "chapter_id": 10163, "verse_number": "८-१०-२७", "content_sanskrit": "निरीक्ष्य पृतनां देवः परैरभ्यर्दितां रणे।\nउदयच्छद् रिपून् हन्तुं वज्रं वज्रधरो रुषा॥ ८/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.031.m4a", "display_order": 32}, {"id": 6000163032, "chapter_id": 10163, "verse_number": "८-१०-२८", "content_sanskrit": "स तेनैवाष्टधारेण शिरसी बलपाकयोः।\nज्ञातीनां पश्यतां राजन् जहार जनयन् भयम्॥ ८/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.032.m4a", "display_order": 33}, {"id": 6000163033, "chapter_id": 10163, "verse_number": "८-१०-२९", "content_sanskrit": "नमुचिस्तद्वधं दृष्ट्वा शोकामर्षरुषान्वितः।\nजिघांसुरिन्द्रं नृपते चकार परमोद्यमम्॥ ८/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.033.m4a", "display_order": 34}, {"id": 6000163034, "chapter_id": 10163, "verse_number": "८-१०-३०", "content_sanskrit": "अश्मसारमयं शूलं घण्टावद्धेमभूषणम्।\nप्रगृह्याभ्यद्रवत् क्रुद्धो नमुचिर्दानवोत्तमः॥ ८/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.034.m4a", "display_order": 35}, {"id": 6000163035, "chapter_id": 10163, "verse_number": "८-१०-३१", "content_sanskrit": "तदाविध्य महावीर्यो हतोऽसीति वितर्जयन्।\nप्राहिणोद् देवराजाय निनदन् मृगराडिव॥ ८/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.035.m4a", "display_order": 36}, {"id": 6000163036, "chapter_id": 10163, "verse_number": "८-१०-३२", "content_sanskrit": "तदापतद् गगनतले महाजवं निचिच्छिदे हरिरिषुभिः सहस्रधा।\nतमाहनन् नृप कुलिशेन कन्धरे रुषाऽन्वितस्‍त्रिदशपतिः शिरो हरन्॥ ८/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.036.m4a", "display_order": 37}, {"id": 6000163037, "chapter_id": 10163, "verse_number": "८-१०-३३", "content_sanskrit": "ततोऽस्य न त्वचमपि वज्र ऊर्जितो बिभेद यः सुरपतिनौजसेरितः।\nतदद्भुतं परमतिवीर्यवृत्रभित् तिरस्कृतो नमुचिशिरोधरत्वचा॥ ८/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.037.m4a", "display_order": 38}, {"id": 6000163038, "chapter_id": 10163, "verse_number": "८-१०-३४", "content_sanskrit": "तस्मादिन्द्रोऽबिभेच्छत्रोर्वज्रः प्रतिहतो यतः।\nकिमिदं दैवयोगेन भूतं लोकविमोहनम्॥ ८/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.038.m4a", "display_order": 39}, {"id": 6000163039, "chapter_id": 10163, "verse_number": "८-१०-३५", "content_sanskrit": "येन मे पूर्वमद्रीणां पक्षच्छेदः प्रजात्यये।\nकृतो निविशतां भारैः पतत्त्रैः पततां भुवि॥ ८/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.039.m4a", "display_order": 40}, {"id": 6000163040, "chapter_id": 10163, "verse_number": "८-१०-३६", "content_sanskrit": "तपःसारमयं त्वाष्ट्रं वृत्रो येन विपाटितः।\nअन्ये चातिबलोपेताः सर्वास्‍त्रैरक्षतत्वचः॥ ८/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.040.m4a", "display_order": 41}, {"id": 6000163041, "chapter_id": 10163, "verse_number": "८-१०-३७", "content_sanskrit": "सोऽयं प्रतिहतो वज्रो मया मुक्तोऽऽसुरेऽल्पके।\nनाहं तदाददे वज्रं ब्रह्मतेजोऽप्यकारणम्॥ ८/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.041.m4a", "display_order": 42}, {"id": 6000163042, "chapter_id": 10163, "verse_number": "८-१०-३८", "content_sanskrit": "इति शक्रं विषीदन्तमाह वागशरीरिणी।\nनायं शुष्कैरथो नार्द्रैर्वधमर्हति दानवः॥ ८/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.042.m4a", "display_order": 43}, {"id": 6000163043, "chapter_id": 10163, "verse_number": "८-१०-३९", "content_sanskrit": "मयाऽस्मै यद् वरो दत्तो मृत्युर्नैवार्द्रशुष्कयोः।\nअतोऽन्यश्चिन्तनीयस्ते उपायो मघवन् रिपोः॥ ८/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.043.m4a", "display_order": 44}, {"id": 6000163044, "chapter_id": 10163, "verse_number": "८-१०-४०", "content_sanskrit": "तां दैवीं गिरमाकर्ण्य मघवान् सुसमाहितः।\nध्यायन् फेनमथापश्यदुपायमुभयात्मकम्॥ ८/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.044.m4a", "display_order": 45}, {"id": 6000163045, "chapter_id": 10163, "verse_number": "८-१०-४१", "content_sanskrit": "न शुष्केण न चार्द्रेण जहार नमुचेः शिरः।\nतं तुष्टुवुर्मुनिगणा माल्यैश्चावाकिरन् विभुम्॥ ८/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.045.m4a", "display_order": 46}, {"id": 6000163046, "chapter_id": 10163, "verse_number": "८-१०-४२", "content_sanskrit": "गन्धर्वमुख्यौ जगतुर्विश्वावसुपरावसू।\nदेवदुन्दुभयो नेदुर्नर्तक्यो ननृतुर्मुदा॥ ८/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.046.m4a", "display_order": 47}, {"id": 6000163047, "chapter_id": 10163, "verse_number": "८-१०-४३", "content_sanskrit": "अन्येऽप्येवं प्रतिद्वन्द्वान् वाय्वग्निवरुणादयः।\nसूदयामासुरस्‍त्रौघैर्मृगान् केसरिणो यथा॥ ८/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.047.m4a", "display_order": 48}, {"id": 6000163048, "chapter_id": 10163, "verse_number": "८-१०-४४", "content_sanskrit": "ब्रह्मणा प्रेषितो देवान् देवर्षिर्नारदो नृप।\nवारयामास विबुधान् दृष्ट्वा दानवसङ्क्षयम्॥ ८/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.048.m4a", "display_order": 49, "topics": [{"text": "नारदेन युद्धनिवारणम्", "range": "४४–४७"}]}, {"id": 6000163049, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.049.m4a", "display_order": 50}, {"id": 6000163050, "chapter_id": 10163, "verse_number": "८-१०-४५", "content_sanskrit": "भवद्भिरमृतं प्राप्तं नारायणभुजाश्रयैः।\nश्रिया समेधिताः सर्वे उपारमत विग्रहात्॥ ८/१०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.050.m4a", "display_order": 51}, {"id": 6000163051, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.051.m4a", "display_order": 52}, {"id": 6000163052, "chapter_id": 10163, "verse_number": "८-१०-४६", "content_sanskrit": "संयम्य मन्युसंरम्भं मानयन्तो मुनेर्वचः।\nसंगीयमानानुचरैर्ययुः सर्वे त्रिविष्टपम्॥ ८/१०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.052.m4a", "display_order": 53}, {"id": 6000163053, "chapter_id": 10163, "verse_number": "८-१०-४७", "content_sanskrit": "येऽवशिष्टा रणे तस्मिन् नारदानुमतेन ते।\nबलिं विपन्नमादाय अस्तंगिरिमुपागमन्॥ ८/१०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.053.m4a", "display_order": 54}, {"id": 6000163054, "chapter_id": 10163, "verse_number": "८-१०-४८", "content_sanskrit": "तत्राविनष्टावयवान् विद्यमानशिरोधरान्।\nउशना जीवयामास सञ्जीविन्या स्वविद्यया॥ ८/१०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.054.m4a", "display_order": 55, "topics": [{"text": "शुक्राचार्येण मृतानाम् अविनष्टावयवानां दैत्यानामुज्जीवनम्", "range": "४८–४९"}]}, {"id": 6000163055, "chapter_id": 10163, "verse_number": "८-१०-४९", "content_sanskrit": "बलिश्चोशनसा स्पृष्टः प्रत्यापन्नेन्द्रियस्मृतिः।\nपराजितोऽपि नाखिद्यल्‍लोकतत्त्वविचक्षणः॥ ८/१०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_010/BhP_08.010.055.m4a", "display_order": 56}, {"id": 6000163056, "chapter_id": 10163, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम्ऽष्टमस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]