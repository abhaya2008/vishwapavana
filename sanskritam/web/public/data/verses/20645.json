[{"id": 7000645000, "chapter_id": 20645, "verse_number": "५-१०४-१", "content_sanskrit": "ऋषय ऊचुः ।\nभूयो वद महाभाग रामचारित्रमद्भुतम् ।\nराममाहात्म्यसर्वस्वं भक्तानां प्रीतिदायकम् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000645001, "chapter_id": 20645, "verse_number": "५-१०४-२", "content_sanskrit": "सूत उवाच ।\nअश्वमेधं क्रतुवरं कृत्वा दाशरथिर्यथा ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000645002, "chapter_id": 20645, "verse_number": "५-१०४-३", "content_sanskrit": "प्रवृत्तो लोककृत्येषु शास्त्रकृत्येषु कोविदः ।\nअयोध्यां गंतुकामेन शंकरेण महात्मना ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000645003, "chapter_id": 20645, "verse_number": "५-१०४-४", "content_sanskrit": "पार्वत्या सह देवेन उषितः सरयूतटे ।\nमुनयस्तं समभ्येत्य शंकरं विश्वरूपिणम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000645004, "chapter_id": 20645, "verse_number": "५-१०४-५", "content_sanskrit": "कश्यपाद्या महात्मानः पप्रच्छुरमितौजसम् ।\nस्वागतं ते मुनिश्रेष्ठ सभार्यः कुत आगतः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000645005, "chapter_id": 20645, "verse_number": "५-१०४-६", "content_sanskrit": "किमागमनकृत्यं ते कं देशं गंतुमुद्यतः ।\nशंकर उवाच ।\nअहं शंभुरिति ख्यातो विप्रो हिमगिरिस्थितः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000645006, "chapter_id": 20645, "verse_number": "५-१०४-७", "content_sanskrit": "द्रष्टुं च राघवं गच्छे मम कार्यं महत्ततः ।\nमामाह्वयति राजासौ पुराणश्रवणे रतः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000645007, "chapter_id": 20645, "verse_number": "५-१०४-८", "content_sanskrit": "आगच्छंतु भवंतोऽपि राघवः परितुष्यति ।\nततस्ते मुनयः शंभुर्ययू रामदिदृक्षया ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000645008, "chapter_id": 20645, "verse_number": "५-१०४-९", "content_sanskrit": "तानागतान्वसिष्ठस्तु ज्ञात्वा रामाय चोक्तवान् ।\nततः सत्वरमुत्थाय निर्ययौ स पुरोहितः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000645009, "chapter_id": 20645, "verse_number": "५-१०४-१०", "content_sanskrit": "अर्घ्यपाद्यादिकैस्सर्वान्पूजयामास तानृषीन् ।\nगृहराजं ततः सर्वान्प्रावेशयदरिंदमः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000645010, "chapter_id": 20645, "verse_number": "५-१०४-११", "content_sanskrit": "प्रत्येकमासनं दत्वा स्वागतोक्त्यासनस्थितान् ।\nक्रमेण रघुशार्दूलः पूजयामास तानृषीन् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000645011, "chapter_id": 20645, "verse_number": "५-१०४-१२", "content_sanskrit": "वाचा मधुरया प्रीणन्निदमाहासनस्थितान् ।\nश्रीराम उवाच ।\nअद्य मे सफलं जन्म प्राप्तमद्य तपः फलम् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000645012, "chapter_id": 20645, "verse_number": "५-१०४-१३", "content_sanskrit": "अद्याभ्यासस्य विद्यानां फलकालोऽयमागतः ।\nअद्य मे पितरस्तुष्टा राज्यं च सफलं मम ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000645013, "chapter_id": 20645, "verse_number": "५-१०४-१४", "content_sanskrit": "अद्य मे सफलं वृत्तमद्य मे सफलं श्रुतम् ।\nएवं वदंतं राजानं ब्राह्मणाः कश्यपादयः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000645014, "chapter_id": 20645, "verse_number": "५-१०४-१५", "content_sanskrit": "ऊचुः प्रियतरं वाक्यं रामं राजीवलोचनम् ।\nऋषय ऊचुः ।\nअयं शंभुर्द्विजः प्राप्तः सर्वशास्त्रविशारदः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000645015, "chapter_id": 20645, "verse_number": "५-१०४-१६", "content_sanskrit": "वेदवेदांगतत्त्वज्ञः सर्वभूतहिते रतः ।\nकैलासवासी सततं तपसे कृतनिश्चयः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000645016, "chapter_id": 20645, "verse_number": "५-१०४-१७", "content_sanskrit": "ब्रह्मणा ब्रह्मवर्चस्के तुल्यो ब्रह्मविदां वरः ।\nहरिणा ब्रह्मवात्सल्ये प्रसादे शंकरोपमः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000645017, "chapter_id": 20645, "verse_number": "५-१०४-१८", "content_sanskrit": "एवंविधो महातेजाः शंभुर्ब्राह्मणपुंगवः ।\nअष्टादशपुराणज्ञो मीमांसा न्यायकोविदः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000645018, "chapter_id": 20645, "verse_number": "५-१०४-१९", "content_sanskrit": "त्वद्भाग्यगौरवादेव प्राप्तोऽयं मुनिसत्तमः ।\nत्वयाहूतो मुनिवरः कैलासादागतः प्रभो ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000645019, "chapter_id": 20645, "verse_number": "५-१०४-२०", "content_sanskrit": "अतः पृच्छ महाभाग पुराणाख्यानमुत्तमम् ।\nश्रोतुकामा वयं प्राप्तास्त्वामद्य रघुनंदन ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000645020, "chapter_id": 20645, "verse_number": "५-१०४-२१", "content_sanskrit": "अंतं गतस्य वेदानां सर्वशास्त्रार्थवेदिनः ।\nपुंसोऽश्रुतपुराणस्य न सम्यग्याति दर्शनम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000645021, "chapter_id": 20645, "verse_number": "५-१०४-२२", "content_sanskrit": "सूत उवाच ।\nएवमुक्तो रघुश्रेष्ठो मुनिभिस्तत्त्वदर्शिभिः ।\nप्रहर्षमतुलं लेभे पुराणश्रवणोत्सुकः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000645022, "chapter_id": 20645, "verse_number": "५-१०४-२३", "content_sanskrit": "श्रीराम उवाच ।\nलिगार्चनप्रकारं च लिंगमाहात्म्यमेव च ।\nमहेशनाममाहात्म्यं पूजामाहात्म्यमेव च ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000645023, "chapter_id": 20645, "verse_number": "५-१०४-२४", "content_sanskrit": "नमस्कारस्य माहात्म्यं दृष्टिमाहात्म्यमेव च ।\nजलदानस्य माहात्म्यं धूपदानस्य सत्तम ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000645024, "chapter_id": 20645, "verse_number": "५-१०४-२५", "content_sanskrit": "दीपगंधादिदानस्य पुष्पमाहात्म्यमेव च ।\nनानाख्यानेतिहासानां कथां पापप्रणाशिनीम् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000645025, "chapter_id": 20645, "verse_number": "५-१०४-२६", "content_sanskrit": "धर्मार्थकाममोक्षांश्च तदुपायांश्च सुव्रत ।\nतत्सर्वं श्रोतुमिच्छामि त्वत्तो मुनिवरोत्तम ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000645026, "chapter_id": 20645, "verse_number": "५-१०४-२७", "content_sanskrit": "शंभुरुवाच ।\nरामराम महाबाहो पुण्यवानसि राघव ।\nराज्यासक्तस्य ते जाता पुराणश्रवणे रतिः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000645027, "chapter_id": 20645, "verse_number": "५-१०४-२८", "content_sanskrit": "स्यान्महत्सेवया राम पुण्यतीर्थनिषेवणात् ।\nसा जिह्वा या शिवं गायेत्तच्चित्तं यत्तदर्प्पितम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000645028, "chapter_id": 20645, "verse_number": "५-१०४-२९", "content_sanskrit": "तावेव केवलौ श्लाघ्यौ यौ तत्पूजाकरौ करौ ।\nसुजन्मदेहमत्यर्थं तदेवाशेषजन्मसु ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000645029, "chapter_id": 20645, "verse_number": "५-१०४-३०", "content_sanskrit": "यदेवोत्पुलकोभासि हर नामानुकीर्तनात् ।\nकृतार्थोऽसि महाराज तत्प्रश्नानुगता मतिः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000645030, "chapter_id": 20645, "verse_number": "५-१०४-३१", "content_sanskrit": "अनंतरं समाजग्मुर्जांघिकाः सत्वरश्रमाः ।\nतत्करात्पत्रिकां गृह्य पपाठ रघुसत्तमः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000645031, "chapter_id": 20645, "verse_number": "५-१०४-३२", "content_sanskrit": "मनसाऽचिंतयद्रामः कथमेतदभूदिति ।\nरामं शंभुस्तदा प्राह देव्या ब्राह्मणवेषवान् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000645032, "chapter_id": 20645, "verse_number": "५-१०४-३३", "content_sanskrit": "किं चिंतयसि काकुत्स्थ मुनिष्वग्रे वसत्स्वपि ।\nतद्वाक्यं राघवः श्रुत्वा पप्रच्छ मुनिपुंगवान् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000645033, "chapter_id": 20645, "verse_number": "५-१०४-३४", "content_sanskrit": "श्रीरामौवाच ।\nविभीषणः कथमसौ बद्धः शृंखलया नृभिः ।\nमत्स्थापितं शिवं लिगं दृष्ट्वा रामेश्वरं त्वहो ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000645034, "chapter_id": 20645, "verse_number": "५-१०४-३५", "content_sanskrit": "द्राविडैः कुटिलैर्दुष्टैरात्मना तद्विचार्यताम् ।\nविचार्य मुनिवर्यास्ते नेशास्तज्ज्ञातुमल्पतः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000645035, "chapter_id": 20645, "verse_number": "५-१०४-३६", "content_sanskrit": "न जानीम इति प्राहू रामं रामस्तदाब्रवीत् ।\nपुराणं वीक्ष्य विधिना तत्सर्वं ब्रूत सत्तमाः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000645036, "chapter_id": 20645, "verse_number": "५-१०४-३७", "content_sanskrit": "भवदज्ञानहेतुश्च विचार्यस्तदनंतरम् ।\nकिं किं पुराणं प्रेक्ष्यं स्याद्वर्जनीयं तथैव किम् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000645037, "chapter_id": 20645, "verse_number": "५-१०४-३८", "content_sanskrit": "प्रशस्तः कीदृशः श्लोकस्तदन्यः कीदृशो भवेत् ।\nकीदृशेषु च कार्येषु कीदृशः पूजकस्तथा ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000645038, "chapter_id": 20645, "verse_number": "५-१०४-३९", "content_sanskrit": "पूजा च कीदृशैर्भक्तैः कार्या निर्णयदर्शने ।\nइति रामस्य वचनं श्रुत्वा ते द्विजसत्तमाः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000645039, "chapter_id": 20645, "verse_number": "५-१०४-४०", "content_sanskrit": "प्रत्यूचुस्तं रघुश्रेष्ठं चिंताव्याकुलमानसम् ।\nन वक्तारो वरं राम वीक्षतां तु पुराणवित् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000645040, "chapter_id": 20645, "verse_number": "५-१०४-४१", "content_sanskrit": "तच्छ्रुत्वा राघवः शंभुं पप्रच्छ विनयान्वितः ।\nसोपि तद्वाक्यमाकर्ण्य प्रत्युवाच महामतिः ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000645041, "chapter_id": 20645, "verse_number": "५-१०४-४२", "content_sanskrit": "शंभुरुवाच ।\nपुराणजीवी पूजार्हः स्वशाखाध्ययनः शुचिः ।\nमीमांसातत्त्वविज्ञानः श्रोत्रियोऽनृतदूषकः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000645042, "chapter_id": 20645, "verse_number": "५-१०४-४३", "content_sanskrit": "देवेषु च समस्तेषु समदृष्टिः शिवे रतः ।\nशतरुद्रियजापी च साग्निकश्चातिवाचकः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000645043, "chapter_id": 20645, "verse_number": "५-१०४-४४", "content_sanskrit": "यजुर्वेदी विशेषेण पूजयेत्पुस्तकं सुधीः ।\nश्रीतालपत्रलिखितं देवलिप्यन्वितं शुभम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000645044, "chapter_id": 20645, "verse_number": "५-१०४-४५", "content_sanskrit": "बंधाद्यतिप्रपंचं यद्युगपत्प्रणवाक्षरम् ।\nप्रागूर्द्ध्वंरेखयोः प्रांते प्रणवस्याग्रयोजिका ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000645045, "chapter_id": 20645, "verse_number": "५-१०४-४६", "content_sanskrit": "रेखा भवेदेवमेका अकारस्तस्यपार्श्वतः ।\nशिरोभागमुपक्रम्य सकोणाधः प्रलंबिनी ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000645046, "chapter_id": 20645, "verse_number": "५-१०४-४७", "content_sanskrit": "आकारः स हि विज्ञेयः पट्टिकादक्षरेखया ।\nवामे षड्वक्रबिंदूद्वा विकार इति कीर्तितः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000645047, "chapter_id": 20645, "verse_number": "५-१०४-४८", "content_sanskrit": "तस्य वामशिरोरेखा लंबिन्या ई उदाहृतः ।\nसर्वाक्षरे शिरोरेखा अवक्रा प्रणवं विना ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000645048, "chapter_id": 20645, "verse_number": "५-१०४-४९", "content_sanskrit": "तस्यां तु लंबरेखान्या तदंते चलवित्रवत् ।\nउकारः स हि विख्यातो लवित्रद्वयतस्तदू ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000645049, "chapter_id": 20645, "verse_number": "५-१०४-५०", "content_sanskrit": "एवमन्यानि सर्वाणि अक्षराण्याह भारती ।\nलिप्यानयैव लिखितं पुराणं तु प्रशस्यस्ते ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000645050, "chapter_id": 20645, "verse_number": "५-१०४-५१", "content_sanskrit": "ब्राह्मं पाद्मं वैष्णवं च मार्तंडं नारदेरितम् ।\nमार्कंडेयमथाग्नेयं कौर्मं वामनमेव च ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000645051, "chapter_id": 20645, "verse_number": "५-१०४-५२", "content_sanskrit": "गारुडं लैंगमाख्यातं स्कांदं मात्स्यं नृसिंहकम् ।\nतथैव गदितं राम पुराणं कापिलं तथा ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000645052, "chapter_id": 20645, "verse_number": "५-१०४-५३", "content_sanskrit": "वाराहं ब्रह्मवैवर्तं शकुनेषु प्रशस्यते ।\nशैवं भागवतं दौर्गं भविष्योत्तरमेव च ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000645053, "chapter_id": 20645, "verse_number": "५-१०४-५४", "content_sanskrit": "भविष्यं चोपसंज्ञानि त्वन्यानि च विवर्जयेत् ।\nविमुच्य पुस्तकं रत्नपीठे निक्षिप्य संस्कृतम् ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000645054, "chapter_id": 20645, "verse_number": "५-१०४-५५", "content_sanskrit": "धौतवस्त्रधरः स्नात्वा शुचिरक्रोधनोऽज्वरः ।\nआदावात्मानमभ्यर्च्य कृत्वा संकल्पमेव च ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000645055, "chapter_id": 20645, "verse_number": "५-१०४-५६", "content_sanskrit": "अंकुशं चाक्षसूत्रं च पाशं पुस्तकमेव च ।\nधारयंतीं सितां ध्यायेत्प्रसन्नास्यां सरस्वतीम् ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000645056, "chapter_id": 20645, "verse_number": "५-१०४-५७", "content_sanskrit": "गोक्षीरसदृशाकारं त्रिनेत्रं वृषवाहनम् ।\nसहासवदनं शांतं शुक्लांबरधरं शिवम् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000645057, "chapter_id": 20645, "verse_number": "५-१०४-५८", "content_sanskrit": "हरिणं चाभयं चोर्द्ध्वबाहुयुग्मं किरीटिनम् ।\nव्याख्यामुद्रा चं दक्षेधो वामहस्ते वरप्रदम् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000645058, "chapter_id": 20645, "verse_number": "५-१०४-५९", "content_sanskrit": "नानारत्नविभूषाढ्यं गिरिजार्द्धांबुजासनम् ।\nबहुभिर्मुनिमुख्यैस्तु ध्यायमान पदांबुजम् ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000645059, "chapter_id": 20645, "verse_number": "५-१०४-६०", "content_sanskrit": "मूर्तिमद्भिस्तथा वेदैः स्तूयमानं पुराणकैः ।\nअन्यैः समस्तलोकैश्च संसेवितपदांबुजम् ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000645060, "chapter_id": 20645, "verse_number": "५-१०४-६१", "content_sanskrit": "ध्यात्वैवं पूजकः सम्यगादौ पूजां समारभेत् ।\nआपो वा इदमित्येतत्कलशस्याभिमंत्रणम् ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000645061, "chapter_id": 20645, "verse_number": "५-१०४-६२", "content_sanskrit": "तज्जलं च गृहीत्वा च पात्रस्थमभिमंत्रयेत् ।\nतत्सद्ब्रह्मेति मंत्रेण प्रशस्य प्रणवेन तु ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000645062, "chapter_id": 20645, "verse_number": "५-१०४-६३", "content_sanskrit": "आत्मानं सर्वपात्राणि तत आवाहयेदिति ।\nयद्वागिति तृ चेनैव भारती षोडशार्चनम् ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000645063, "chapter_id": 20645, "verse_number": "५-१०४-६४", "content_sanskrit": "पुरुषसूक्तेन वा कुर्याद्गायत्र्या वा समर्चयेत् ।\nॐ नमो भगवते अमुक पुराणेति पुराणमर्चयेत् ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000645064, "chapter_id": 20645, "verse_number": "५-१०४-६५", "content_sanskrit": "कांडादिति हि मंत्रेण दूर्वामानीय पूजयेत् ।\nॐ नमो भगवत्यै दूर्वायै इति ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000645065, "chapter_id": 20645, "verse_number": "५-१०४-६६", "content_sanskrit": "सलोकपाल पूजा स्यादथ कन्या समर्चनम् ।\nवत्सरात्पंचकादूर्द्ध्वं दशवर्षादधः शुभाः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000645066, "chapter_id": 20645, "verse_number": "५-१०४-६७", "content_sanskrit": "अनुत्पन्नऋतुर्वापि तां प्रयत्नेन पूजयेत् ।\nगंधपुष्पाक्षतैर्धूपैर्दीपतांबूलभूषणैः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000645067, "chapter_id": 20645, "verse_number": "५-१०४-६८", "content_sanskrit": "पाठयेदप्यमुं मंत्रं पूजकः कन्यकामिमाम् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000645068, "chapter_id": 20645, "verse_number": "५-१०४-६९", "content_sanskrit": "सत्यं ब्रूहि प्रियं ब्रूहि भगवति सरस्वति नमस्ते नमस्त इति ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000645069, "chapter_id": 20645, "verse_number": "५-१०४-७०", "content_sanskrit": "गायत्र्यानुक्रमार्थात्तु दूर्वायुग्मं तु कारयेत् ।\nसन्निधौ पुस्तकस्याधः सहस्रपरमेत्यृचा ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000645070, "chapter_id": 20645, "verse_number": "५-१०४-७१", "content_sanskrit": "दूर्वायुग्मत्रयं दद्यात्तस्या हस्ते विचक्षणः ।\nसा प्रक्षिपेत्पुस्तसंधौ शलाकात्रयमन्वनु ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000645071, "chapter_id": 20645, "verse_number": "५-१०४-७२", "content_sanskrit": "विसृज्यतां पुनर्दद्याच्छिवाभ्यां नम इत्यथ ।\nपत्रयोर्मध्यमः श्लोकः कार्यसिद्धेर्हि सूचकः ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000645072, "chapter_id": 20645, "verse_number": "५-१०४-७३", "content_sanskrit": "पूर्वपत्रे समाप्तिः स्याच्छ्लोकस्य यदि राघव ।\nपरपत्रे पठेच्छ्लोकं विविच्यार्थमुदीरयेत् ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000645073, "chapter_id": 20645, "verse_number": "५-१०४-७४", "content_sanskrit": "शनैःशनैः पठेत्प्राज्ञो व्याख्यासेच्च शनैःशनैः ।\nत्वरेह न हि कर्तव्या कुप्यति त्वरया तु गीः ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000645074, "chapter_id": 20645, "verse_number": "५-१०४-७५", "content_sanskrit": "घटिकायास्तु पादः स्यादत्वरास्यात्ततोधिका ।\nत्वरयेन्न च वक्तारं ज्ञातव्यांशमनुद्विजम् ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000645075, "chapter_id": 20645, "verse_number": "५-१०४-७६", "content_sanskrit": "विविच्य पाठं श्लोकस्य निश्चित्यार्थं च मानसे ।\nप्रतीपं तन्न वक्तव्यं विविच्य रघुनंदन ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000645076, "chapter_id": 20645, "verse_number": "५-१०४-७७", "content_sanskrit": "यदि युक्तमयुक्तं वा श्लोकमन्यं पठेदसौ ।\nपुस्तकस्थं च हित्वैव पूजकः स द्विजो यदि ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000645077, "chapter_id": 20645, "verse_number": "५-१०४-७८", "content_sanskrit": "तत्तथैव हि विज्ञेयं विसंवादो न शस्यते ।\nदैवागतो हि स श्लोको दैवं हि बलवत्तरम् ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000645078, "chapter_id": 20645, "verse_number": "५-१०४-७९", "content_sanskrit": "उपश्रुतिषु यद्वच्च नापराधो द्विजस्य तु ।\nविस्मयो न च कर्तव्यो दैवस्य कुटिला गतिः ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000645079, "chapter_id": 20645, "verse_number": "५-१०४-८०", "content_sanskrit": "यत्तत्पदविपर्यासे पत्रे चोपरिवारिणि ।\nतमादेशं तिरस्कृत्य द्वितीयं तु पठेदतः ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000645080, "chapter_id": 20645, "verse_number": "५-१०४-८१", "content_sanskrit": "ततस्तृतीयं पाठ्यं स्यात्ततः कार्यं विवेचनम् ।\nअविसर्गांतपूर्वास्ते पवर्गेतरपंचमाः ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000645081, "chapter_id": 20645, "verse_number": "५-१०४-८२", "content_sanskrit": "स्तुतिलिड्वर्जितः श्लोकः शकुनेषु प्रशस्यते ।\nअध्यायादिः समाप्तिश्च वृथा पत्रं वृथा लिपिः ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000645082, "chapter_id": 20645, "verse_number": "५-१०४-८३", "content_sanskrit": "उक्तानुवचनं चैव द्व्युपस्तुतमथैव च ।\nदग्धपत्रं नष्टलिपिः संदिग्धाक्षरमेव च ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000645083, "chapter_id": 20645, "verse_number": "५-१०४-८४", "content_sanskrit": "एतानि शकुने नित्यं वर्जनीयानि पंडितैः ।\nप्रश्नो हि द्विविधो ज्ञेयो दीप्तशांत प्रभेदतः ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000645084, "chapter_id": 20645, "verse_number": "५-१०४-८५", "content_sanskrit": "शांतं च द्विविधं ज्ञेयमुत्पत्तिस्थितिवृद्धितः ।\nतत्र शांतं प्रशस्तं स्याल्लक्षितं पूर्वलक्षणैः ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000645085, "chapter_id": 20645, "verse_number": "५-१०४-८६", "content_sanskrit": "कार्यभेदास्तु वर्ण्यंते केचिन्मर्त्योपयोगिनः ।\nकस्यचित्कार्यमादाय कश्चित्प्रष्टा भवत्यपि ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000645086, "chapter_id": 20645, "verse_number": "५-१०४-८७", "content_sanskrit": "स करोति तदा प्रश्नं समेत्य स्मरतेऽत्र किम् ।\nस पुनर्धार्य पत्रं तत्तस्मिन्पत्रं प्रशस्यते ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000645087, "chapter_id": 20645, "verse_number": "५-१०४-८८", "content_sanskrit": "अथवा तत्क्षमोपेतं वैराग्यं परमेव च ।\nयतः कुतश्चिद्दृष्टस्तु स्तुतिपादकमेव च ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000645088, "chapter_id": 20645, "verse_number": "५-१०४-८९", "content_sanskrit": "परिहृत्य परं चापि तस्मिन्नर्थे शुभावहम् ।\nमृतो गृह्णाति वागर्थमिति प्रश्नोऽशुभप्रदः ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000645089, "chapter_id": 20645, "verse_number": "५-१०४-९०", "content_sanskrit": "विवादे विजयप्रश्ने जयद्योतकमिष्यते ।\nसृष्टिरप्यत्र शस्ता स्यात्क्रूरायां क्लेशतो जयः ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000645090, "chapter_id": 20645, "verse_number": "५-१०४-९१", "content_sanskrit": "प्रशांतायामुपायैस्तु मिश्रायां विड्वरो भवेत् ।\nपुरादिवर्णनं यत्तु मध्यमं यदि चोत्तमम् ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000645091, "chapter_id": 20645, "verse_number": "५-१०४-९२", "content_sanskrit": "कलिसंभावनायास्तु शृंगारस्योपवर्णने ।\nराज्यनिर्वाहचिंतायां राज्यलिंगंशुभावहम् ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000645092, "chapter_id": 20645, "verse_number": "५-१०४-९३", "content_sanskrit": "यस्यापि यादृशं योग्यं विचार्य तादृशं बुधैः ।\nस्तुतिवैराग्ययोः कार्यं विलयः परिकीर्तितः ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000645093, "chapter_id": 20645, "verse_number": "५-१०४-९४", "content_sanskrit": "कार्याल्पसिद्धिः स्खलितेन च निर्वाहमृच्छति ।\nतस्यान्यार्थस्यान्यभावो राम शांतिविचारणे ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000645094, "chapter_id": 20645, "verse_number": "५-१०४-९५", "content_sanskrit": "विसर्गांतश्च पूर्वार्द्ध विपर्यासो भविष्यतः ।\nसंकल्पितान्यथाभावो ह्यध्यायस्य समापने ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000645095, "chapter_id": 20645, "verse_number": "५-१०४-९६", "content_sanskrit": "कांडादेस्तु समाप्तौ तु स्यात्तत्कार्यविनाशनम् ।\nतस्मादेतादृशे दोषे शकुनस्य विपर्ययः ॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000645096, "chapter_id": 20645, "verse_number": "५-१०४-९७", "content_sanskrit": "क्षुते पुस्तकपाते च त्वाहते मस्तकादिषु ।\nवक्ता वैमाननं याति ततः शकुननाशनम् ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000645097, "chapter_id": 20645, "verse_number": "५-१०४-९८", "content_sanskrit": "तस्मादेतादृशे दोषे शकुनं परिवर्जयेत् ।\nउपमायां भवेद्राम कार्याभासो न वस्तुतः ॥९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000645098, "chapter_id": 20645, "verse_number": "५-१०४-९९", "content_sanskrit": "संतानं भोन्यत्र चोक्ता सृष्टिर्मध्यफलप्रदा ।\nस्तुतिः प्रशस्ता कुत्रापि गुणवत्कार्यनिर्णये ॥९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000645099, "chapter_id": 20645, "verse_number": "५-१०४-१००", "content_sanskrit": "विवाहे चौषधे दाने व्यवहारे कृषौ तथा ।\nयथार्था च स्तुती राम निर्वाहेऽपि न दूषणम् ॥१०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]