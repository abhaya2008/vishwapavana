[{"id": 2054453, "chapter_id": 2195, "verse_number": "७-१२२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054454, "chapter_id": 2195, "verse_number": "७-१२२-१", "content_sanskrit": "दुःशासनरथं दृष्ट्वा समीपे पर्यवस्थितम्।\nभारद्वाजस्ततो वाक्यं दुःशासनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054455, "chapter_id": 2195, "verse_number": "७-१२२-२", "content_sanskrit": "दुःशासन रथाः सर्वे कस्माच्चैते प्रविद्रुताः।\nकच्चित्क्षेमं तु नृपतेः कच्चिज्जीवति सैन्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054456, "chapter_id": 2195, "verse_number": "७-१२२-३", "content_sanskrit": "राजपुत्रो भवानत्र राजभ्राता महारथः।\nकिमर्थं द्रवते युद्धे यौवराज्यमवाप्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054457, "chapter_id": 2195, "verse_number": "७-१२२-४", "content_sanskrit": "दासी जिताऽसि द्यूते त्वं यथा कामचरी भव।\nवाससां वाहिका राज्ञो भ्रातुर्ज्येष्ठस्य मे भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054458, "chapter_id": 2195, "verse_number": "७-१२२-५", "content_sanskrit": "न सन्ति पतयः सर्वे तेऽद्य षण्ढतिलैः समाः।\nदुःशासनैवं कस्मात्त्वं पूर्वमुक्त्वा पलायसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054459, "chapter_id": 2195, "verse_number": "७-१२२-६", "content_sanskrit": "स्वयं वैरं महत्कृत्वा पाञ्चालैः पाण्डवैः सह।\nएकं सात्यकिमासाद्य कथं भीतोऽसि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054460, "chapter_id": 2195, "verse_number": "७-१२२-७", "content_sanskrit": "न जानीषे पुरा त्वं तु गृह्णन्नक्षान्दुरोदरे।\nशरा ह्येते भविष्यन्ति दारुणाशीविषोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054461, "chapter_id": 2195, "verse_number": "७-१२२-८", "content_sanskrit": "अप्रियाणां हि वचनं पाण्डवस्य विशेषतः।\nद्रौपद्याश्च परिक्लेशस्त्वन्मूलो ह्यभवत्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054462, "chapter_id": 2195, "verse_number": "७-१२२-९", "content_sanskrit": "क्व ते मानश्च दर्पश्च क्व ते वीर्यं क्व गर्जितम्।\nआशीविषसमान्पार्थान्कोपयित्वा क्व यास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054463, "chapter_id": 2195, "verse_number": "७-१२२-१०", "content_sanskrit": "शोच्येयं भारती सेना राज्यं चैव सुयोधनः।\nयस्य त्वं कर्कशो भ्राता पलायनपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054464, "chapter_id": 2195, "verse_number": "७-१२२-११", "content_sanskrit": "ननु नाम त्वया वीर दार्यमाणा भयार्दिता।\nस्वबाहुबलमास्थाय रक्षितव्या ह्यनीकिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054465, "chapter_id": 2195, "verse_number": "७-१२२-१२", "content_sanskrit": "स त्वमद्य रणं हित्वा भीतो हर्षयसे परान्।\nविद्रुते त्वयि सैन्यस्य नायके शत्रुमूदन।\nकोऽन्यः स्थास्यति सङ्ग्रामे भीतो भीते व्यपाश्रये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054466, "chapter_id": 2195, "verse_number": "७-१२२-१३", "content_sanskrit": "एकेन सात्वतेनाद्य युध्यमानस्य तेन वै।\nपलायने तव मतिः सङ्ग्रामाद्धि प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054467, "chapter_id": 2195, "verse_number": "७-१२२-१४", "content_sanskrit": "यदा गाण्डीवधन्वानं भीमसेनं च कौरव।\nयमौ च द्रक्ष्यसि रणे तदा वै किं करिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054468, "chapter_id": 2195, "verse_number": "७-१२२-१५", "content_sanskrit": "युधि फल्गुनबाणानां मूर्याग्निसमवर्चसाम्।\nन तुल्याः सात्यकिशरा येभ्यो भीतः पलायसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054469, "chapter_id": 2195, "verse_number": "७-१२२-१६", "content_sanskrit": "त्वरितो वीर गच्छ त्वं गान्धार्युदरमाविश।\nपृथिव्यां धावमानस्य नान्यत्पश्यामि जीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054470, "chapter_id": 2195, "verse_number": "७-१२२-१७", "content_sanskrit": "यदि तावत्कृता बुद्धिः पलायनपरायणा।\nपृथिवी धर्मराजाय शमेनैव प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054471, "chapter_id": 2195, "verse_number": "७-१२२-१८", "content_sanskrit": "यावत्फल्गुननाराचा निर्मुक्तोरगसन्निभाः।\nनाविशन्ति शरीरं ते तावत्संशाम्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054472, "chapter_id": 2195, "verse_number": "७-१२२-१९", "content_sanskrit": "यावत्ते पृथिवीं पार्था हत्वा भ्रातृशतं रणे।\nनाक्षिपन्ति महात्मानस्तावत्संशाम्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054473, "chapter_id": 2195, "verse_number": "७-१२२-२०", "content_sanskrit": "यावन्न क्रुध्यते राजा धर्मपुत्रो युधिष्ठिरः।\nकृष्णश्च समरश्लाघी तावत्संशाम्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054474, "chapter_id": 2195, "verse_number": "७-१२२-२१", "content_sanskrit": "यावद्भीमो महाबाहुर्विगाह्य महतीं चमूम्।\nसोदरांस्ते न मृद्राति तावत्संशाम्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054475, "chapter_id": 2195, "verse_number": "७-१२२-२२", "content_sanskrit": "पूर्वमुक्तश्च ते भ्राता भीष्मेणासौ सुयोधनः।\nअजेयाः पाण्डवाः सङ्ख्ये सौम्य संशाम्य तैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054476, "chapter_id": 2195, "verse_number": "७-१२२-२३", "content_sanskrit": "`मया शमवता चोक्तो रक्ष शेषं सुयोधन।\nसंशाम्य पार्थैस्त्वं रक्ष वीर सर्वान्महीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054477, "chapter_id": 2195, "verse_number": "७-१२२-२४", "content_sanskrit": "न च तत्कृतवान्मन्दस्तव भ्रातां सुयोधनः।\nस युद्धे धृतिमास्थाय यत्तो युध्यस्व पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054478, "chapter_id": 2195, "verse_number": "७-१२२-२५", "content_sanskrit": "तवापि शोणितं भीमः पास्यतीति मया श्रुतम्।\nतच्चाप्यवितथं तस्य तत्तथैव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054479, "chapter_id": 2195, "verse_number": "७-१२२-२६", "content_sanskrit": "किं भीमस्य न जानासि विक्रमं त्वं सुबालिश।\nयत्त्वया वैरमारब्धं संयुगे प्रपलायिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054480, "chapter_id": 2195, "verse_number": "७-१२२-२७", "content_sanskrit": "गच्छ तूर्णं रथेनैव यत्र तिष्ठति सात्यकिः।\nत्वया हीनं बलं ह्येतद्विद्रविष्यति भारत॥\nआत्मार्थं योधय रणे सात्यकिं सत्यविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054481, "chapter_id": 2195, "verse_number": "७-१२२-२८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054482, "chapter_id": 2195, "verse_number": "७-१२२-२८", "content_sanskrit": "एवमुक्तस्तव सुतो नाब्रवीत्किञ्चिदप्यसौ।\nश्रुतं चाश्रुतवत्कृत्वा प्रायाद्येन स सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054483, "chapter_id": 2195, "verse_number": "७-१२२-२९", "content_sanskrit": "सैन्येन महता युक्तो म्लेच्छानामनिवर्तिनाम्।\nआसाद्य च रणे यत्तो युयुधानमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054484, "chapter_id": 2195, "verse_number": "७-१२२-३०", "content_sanskrit": "द्रोणोऽपि रथिनां श्रेष्ठः पाञ्चालान्पाण्डवांस्तथा।\nअभ्यद्रवत सङ्क्रुद्धौ जवमास्थाय मध्यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054485, "chapter_id": 2195, "verse_number": "७-१२२-३१", "content_sanskrit": "प्रविश्य च रणे द्रोणः पाण्डवानां वरूथिनीम्।\nद्रावयामास योधान्वै शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054486, "chapter_id": 2195, "verse_number": "७-१२२-३२", "content_sanskrit": "ततो द्रोणो महाराज नाम विश्राव्य संयुगे।\nपाण्डुपाञ्चालमत्स्यानां प्रचक्रे कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054487, "chapter_id": 2195, "verse_number": "७-१२२-३३", "content_sanskrit": "तं जयन्तमनीकानि भारद्वाजं ततस्ततः।\nपाञ्चालपुत्रो द्युतिमान्वीरकेतुः समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054488, "chapter_id": 2195, "verse_number": "७-१२२-३४", "content_sanskrit": "स द्रोणं पञ्चभिर्विद्व्वा शरैः सन्नतपर्वभिः।\nध्वजमेकेन विव्याध सारथिं चास्य सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054489, "chapter_id": 2195, "verse_number": "७-१२२-३५", "content_sanskrit": "तत्राद्भुतं महाराज दृष्ट्वानस्मि संयुगे।\nयद्द्रोणो रभसं युद्धे पाञ्चाल्यं नात्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054490, "chapter_id": 2195, "verse_number": "७-१२२-३६", "content_sanskrit": "सन्निरुद्धं रमे द्रोणं पाञ्चला वीक्ष्य मारिष।\nआवव्रुः सर्वतो राजन्धर्मपुत्रजयैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054491, "chapter_id": 2195, "verse_number": "७-१२२-३७", "content_sanskrit": "ते शरैरग्निसंकाशैस्तोमरैश्च महाधनैः।\nशस्त्रैश्च विविधै राजन्द्रोणमेकमवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054492, "chapter_id": 2195, "verse_number": "७-१२२-३८", "content_sanskrit": "निवार्य तान्बाणगणान्द्रोणो राजन्समन्ततः।\nमहाजलधरान्व्योम्नि मातरिश्वेव चाबभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054493, "chapter_id": 2195, "verse_number": "७-१२२-३९", "content_sanskrit": "ततः शरं महाघोरं मूर्यपावकसन्निभम्।\nसन्दधे परवीरघ्नो वीरकेतो रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054494, "chapter_id": 2195, "verse_number": "७-१२२-४०", "content_sanskrit": "स भित्त्वा तु शरो राजन्पाञ्चालकुलनन्दनम्।\nअभ्यगाद्धरणीं तूर्णं लोहितार्द्रो ज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054495, "chapter_id": 2195, "verse_number": "७-१२२-४१", "content_sanskrit": "ततोऽपतद्रथात्तूर्णं पाञ्चालकुलनन्दनः।\nपर्वताग्रादिव महांश्चम्पको वायुपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054496, "chapter_id": 2195, "verse_number": "७-१२२-४२", "content_sanskrit": "तस्मिन्हते महेष्वासे राजपुत्रे महाबले।\nपाञ्चालास्त्वरिता द्रोणं समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054497, "chapter_id": 2195, "verse_number": "७-१२२-४३", "content_sanskrit": "चित्रकेतुः सुधन्वा च चित्रवर्मा च भारत।\nतथा चित्ररथश्चैव भ्रातृव्यसनकर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054498, "chapter_id": 2195, "verse_number": "७-१२२-४४", "content_sanskrit": "अभ्यद्रवन्त सहिता भारद्वाजं युयुत्सवः।\nमुञ्चन्तः शरवर्षाणि तपान्ते जलदा इव॥\n`अदृश्यं समरे चक्रुर्भारद्वाजं सुधन्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054499, "chapter_id": 2195, "verse_number": "७-१२२-४५", "content_sanskrit": "स वध्यमानो बहुधा राजपुत्रैर्महारथैः।\nक्रोधमाहारयत्तेषामभावाय द्विजर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054500, "chapter_id": 2195, "verse_number": "७-१२२-४६", "content_sanskrit": "ततः शरमयं जालं द्रोणस्तेषामवासृजत्।\nते हन्यमाना द्रोणस्य शरैराकर्णचोदितैः।\nकर्तव्यं नाभ्यजानन्वै कुमारा राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054501, "chapter_id": 2195, "verse_number": "७-१२२-४७", "content_sanskrit": "तान्विमूढान्रणे द्रोणः प्रहसन्निव भारत।\nव्यश्वसूतरथांश्चक्रे कुमारान्कुपितो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054502, "chapter_id": 2195, "verse_number": "७-१२२-४८", "content_sanskrit": "अथापरैः सुनिशितैर्भल्लैस्तेषां महायशाः।\nपुष्पाणीव विवान्वायुः सोत्तमाङ्गान्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054503, "chapter_id": 2195, "verse_number": "७-१२२-४९", "content_sanskrit": "ते रथेभ्यो हताः पेतुः क्षितौ राजन्सुवर्चसः।\nदेवासुरे पुरा युद्धे यथा दैतेयदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054504, "chapter_id": 2195, "verse_number": "७-१२२-५०", "content_sanskrit": "तान्निहत्य रणे राजन्भारद्वाजः प्रतापवान्।\nकार्मुकं भ्रामयामास हेमपृष्ठं दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054505, "chapter_id": 2195, "verse_number": "७-१२२-५१", "content_sanskrit": "`तदस्य भ्राजते राजन्मेघमध्ये तडिद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054506, "chapter_id": 2195, "verse_number": "७-१२२-५२", "content_sanskrit": "पाञ्चालान्निहतान्दृष्ट्वा देवकल्पान्महारथान्।\nधृष्टद्युम्नो भृशोद्विग्नो नेत्राभ्यां पातयञ्जलम्।\nअभ्यवर्तत सङ्गारमे क्रुद्धो द्रोणरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054507, "chapter_id": 2195, "verse_number": "७-१२२-५३", "content_sanskrit": "ततो हाहेति सहसा नादः समभवन्नृप।\nपाञ्चाल्येन रणे दृष्ट्वा द्रोणमावारितं शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054508, "chapter_id": 2195, "verse_number": "७-१२२-५४", "content_sanskrit": "से च्छाद्यमानो बहुधा पार्षतेन महात्मना।\nन विव्यथे ततो द्रोणः स्मयन्नेवान्वयुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054509, "chapter_id": 2195, "verse_number": "७-१२२-५५", "content_sanskrit": "ततो द्रोणं महाराज पाञ्चाल्यः क्रोधमूर्च्छितः।\nआजघानोरसि क्रुद्धो नवत्या नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054510, "chapter_id": 2195, "verse_number": "७-१२२-५६", "content_sanskrit": "स गाढविद्धो बलिना भारद्वाजो महायशाः।\nनिषसाद रथोपस्थे कश्मलं च जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054511, "chapter_id": 2195, "verse_number": "७-१२२-५७", "content_sanskrit": "तं वै तथागतं दृष्ट्वा धृष्टद्युम्नः पराक्रमी।\nचापमुत्सृज्य शीघ्रं तु असिं जग्राह वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2054512, "chapter_id": 2195, "verse_number": "७-१२२-५८", "content_sanskrit": "अवप्लुत्य रथाच्चापि त्वरितः स महारथः।\nआरुरोह रथं तूर्णं भारद्वाजस्य मारिष।\nहर्तुमिच्छञ्शिरः कायात्क्रोधसंरक्रलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2054513, "chapter_id": 2195, "verse_number": "७-१२२-५९", "content_sanskrit": "प्रत्याश्वस्तस्ततो द्रोणो धनुर्गृह्य महारवम्।\nआसन्नमागतं दृष्ट्वा धृष्टद्युम्नं जिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2054514, "chapter_id": 2195, "verse_number": "७-१२२-६०", "content_sanskrit": "शरैर्वैतस्तिकै राजन्विव्याधासन्नवेधिभिः।\nयोधयामास समरे धृष्टद्युम्नं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2054515, "chapter_id": 2195, "verse_number": "७-१२२-६१", "content_sanskrit": "ते हि वैतस्तिका नाम शरा आमन्नयोधिनः।\nद्रोणस्य विहिता राजन्यैर्धृष्टद्युम्नमाक्षिणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2054516, "chapter_id": 2195, "verse_number": "७-१२२-६२", "content_sanskrit": "स वध्यमानो बहुभिः सायकैस्तैर्महाबलः।\nअवप्लुत्य रथात्तूर्णं भग्नवेगः पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2054517, "chapter_id": 2195, "verse_number": "७-१२२-६३", "content_sanskrit": "आरुह्य स्वरथं वीरः प्रगृह्य च महद्धनुः।\nविव्याध समरे द्रोणं धृष्टद्युम्नो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2054518, "chapter_id": 2195, "verse_number": "७-१२२-६४", "content_sanskrit": "द्रोणश्चापि महाराज शरैर्विव्याध पार्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2054519, "chapter_id": 2195, "verse_number": "७-१२२-६५", "content_sanskrit": "तदद्भुतमभूद्युद्धं द्रोणपाञ्चालयोस्तदा।\nत्रैलोक्यकाङ्क्षिणोरासीच्छक्रप्रह्लादयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2054520, "chapter_id": 2195, "verse_number": "७-१२२-६६", "content_sanskrit": "मण्डलानि विचित्राणि यमकानीतराणि च।\nचरन्तौ युद्धमार्गज्ञौ ततक्षतुरथेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2054521, "chapter_id": 2195, "verse_number": "७-१२२-६७", "content_sanskrit": "मोहयन्तौ मनांस्याजौ योधानां द्रोणपार्षतौ।\nसृजन्तौ शरवर्षाणि वर्षास्विव बलाहकौ।\nछादयन्तौ महात्मानौ शरैर्व्योम दिशो महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2054522, "chapter_id": 2195, "verse_number": "७-१२२-६८", "content_sanskrit": "तदद्भुतं तयोर्युद्धं भूतसङ्घा ह्यपूजयन्।\nक्षत्रियाश्च महाराज ये चान्ये तव सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2054523, "chapter_id": 2195, "verse_number": "७-१२२-६९", "content_sanskrit": "अवश्यं समरे द्रोणो दृष्टद्युम्नेन सङ्गतः।\nवशमेष्यति नो राजन्पाञ्चाला इति चुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2054524, "chapter_id": 2195, "verse_number": "७-१२२-७०", "content_sanskrit": "द्रोणस्तु त्वरितो युद्धे धृष्टद्युम्नस्य सारथेः।\nशिरः प्रच्यावयामास फलं पक्वं तरोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2054525, "chapter_id": 2195, "verse_number": "७-१२२-७१", "content_sanskrit": "ततस्तु प्रद्रुता वाहा राजंस्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2054526, "chapter_id": 2195, "verse_number": "७-१२२-७२", "content_sanskrit": "तेषु प्रद्रवमाणेषु पाञ्चालान्सृञ्जयांस्तथा।\nअयोधयद्रणे द्रोणस्तत्रतत्र पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2054527, "chapter_id": 2195, "verse_number": "७-१२२-७३", "content_sanskrit": "विजित्य पाण्डुपाञ्चालान्भारद्वाजः प्रतापवान्।\nस्वं व्यूहं पुनरास्थाय स्थितोऽभवदरिन्दमः।\nन चैनं पाण़्डवा युद्धे जेतुमुत्सेहिरे प्रभो॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2054528, "chapter_id": 2195, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे द्वाविंशत्यधिकशततमोऽध्यायः॥ १२२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२२-४८ विशेषेण वातीति विवान्। पुष्पाणीव वनाद्वायुः इति ट.पाठः। पुष्पाणीव विचन्वन्हि इति झ.ञ. पाठः॥ ५-१२२-६१ द्रोणस्य विविधा राजन् इति ट. पाठः। द्रोणस्य विदिता इति क. पाठः॥ ५-१२२-१२२ द्वाविंशत्यधिकशततमोऽध्यायः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]