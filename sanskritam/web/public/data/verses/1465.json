[{"id": 2022247, "chapter_id": 1465, "verse_number": "३-१०३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022248, "chapter_id": 1465, "verse_number": "३-१०३-१", "content_sanskrit": "किमर्थं सहसा विन्ध्यः प्रवृद्धः क्रोधमूर्च्छितः।\nएतदिच्छाम्यहं श्रोतुं विस्तरेण महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022249, "chapter_id": 1465, "verse_number": "३-१०३-२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022250, "chapter_id": 1465, "verse_number": "३-१०३-२", "content_sanskrit": "अद्रिराजं महाघोरं रमेरुं कनकपर्वतम्।\nउदयास्तमने भानुः प्रदक्षिणमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022251, "chapter_id": 1465, "verse_number": "३-१०३-३", "content_sanskrit": "तं तु दृष्ट्वा तथा विन्ध्य शैलः सूर्यमथाब्रवीत्।\nयथा हि मेरुर्भवता नित्यशः परिगम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022252, "chapter_id": 1465, "verse_number": "३-१०३-४", "content_sanskrit": "प्रदक्षिणश्च क्रियते मामेवं करु भास्कर।\nएवमुक्तस्ततः सूर्यः शैलेन्द्रं प्रत्यभापत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022253, "chapter_id": 1465, "verse_number": "३-१०३-५", "content_sanskrit": "नाहमात्मेच्छया शैल करोम्येनं प्रदक्षिणम्।\nएष मार्गः प्रदिष्टो मे येनेदं निर्मितं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022254, "chapter_id": 1465, "verse_number": "३-१०३-६", "content_sanskrit": "एवमुक्तस्ततः क्रोधात्प्रवृद्धः सहसाऽचलः।\nसूर्याचन्द्रमसोर्मार्गं रोद्धुमिच्छन्परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022255, "chapter_id": 1465, "verse_number": "३-१०३-७", "content_sanskrit": "ततो देवाः सहिताः सर्व एव।\nसेन्द्राः समागम्य महाद्रिराजम्।\nनिवारयामासुरुपायतस्तं\nन च स्म तेषां वचनं चकार ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022256, "chapter_id": 1465, "verse_number": "३-१०३-८", "content_sanskrit": "अथाभिजग्मुर्मुनिमाश्रमस्थं\nतपस्विनं धर्मभृतां वरिष्ठम्।\nअगस्त्यमत्यद्भुतवीर्यदीप्तं\nतं चार्थमूचुः सहिताः सुरास्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022257, "chapter_id": 1465, "verse_number": "३-१०३-९", "content_sanskrit": "सूर्याचन्दर्मसोर्मार्गं नक्षत्राणां गतिं तथा।\nशैलराजो वृणोत्येप विन्ध्यः क्रोधवशानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022258, "chapter_id": 1465, "verse_number": "३-१०३-१०", "content_sanskrit": "तं निवारयितुं शक्तो नान्यः कश्चिद्द्विजोत्तम।\nऋते त्वां हि महाभाग तस्मादेनं निवारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022259, "chapter_id": 1465, "verse_number": "३-१०३-११", "content_sanskrit": "तच्छ्रुत्वा वचनं विप्रः सुराणां शैलमभ्यगात्।\nसोभिगम्याब्रवीद्विन्ध्यं सदारः समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022260, "chapter_id": 1465, "verse_number": "३-१०३-१२", "content_sanskrit": "मार्गमिच्छाम्यहं दत्तं भवता पर्वतोत्तम।\nदक्षिणामभिगन्तास्मि दिशे कार्येण केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022261, "chapter_id": 1465, "verse_number": "३-१०३-१३", "content_sanskrit": "यावदागमनं मह्यं तावत्त्वं प्रतिपालय।\nनिवृत्ते मयि शैलेन्द्र ततो वर्धस्व कामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022262, "chapter_id": 1465, "verse_number": "३-१०३-१४", "content_sanskrit": "एवं स समयं कृत्वाविन्ध्येनामित्रकर्शन।\nअद्यापि दक्षिणाद्देशाद्वारुणिर्न निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022263, "chapter_id": 1465, "verse_number": "३-१०३-१५", "content_sanskrit": "विन्ध्योऽपितद्भयाद्राजन्कुञ्चिताङ्गो न वर्धते।\nअगस्त्यस्य प्रभावेण यन्मां त्वं परिपृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022264, "chapter_id": 1465, "verse_number": "३-१०३-१६", "content_sanskrit": "कालेयास्तु यथा राजन्सुरैः सर्वैर्निषूदिताः।\nअगस्त्याद्वरमासाद्य तन्मे निगदतः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022265, "chapter_id": 1465, "verse_number": "३-१०३-१७", "content_sanskrit": "त्रिदशानां वचः श्रुत्वा मैत्रावरुणिरब्रवीत्।\nकिमर्थमभियाता स्थ वरं मत्तः कमिच्छथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022266, "chapter_id": 1465, "verse_number": "३-१०३-१८", "content_sanskrit": "एवमुक्तास्ततस्तेन देवता मुनिमब्रुवन्।\n`सर्वे प्राञ्जलयो भूत्वा पुरन्दरपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022267, "chapter_id": 1465, "verse_number": "३-१०३-१९", "content_sanskrit": "एवं त्वयोच्छाम कृतं हि कार्यं\nमहार्णवं पीयमानं महात्मन्।\nततो वधिष्याम सहानुबन्धा-\nन्कालोपसृष्टान्सुरविद्विषस्तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022268, "chapter_id": 1465, "verse_number": "३-१०३-२०", "content_sanskrit": "त्रिदशानां वचः श्रुत्वा तथेति मुनिरब्रवीत्।\nकरिष्ये भवतां कामं लोकानां च महत्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022269, "chapter_id": 1465, "verse_number": "३-१०३-२१", "content_sanskrit": "एवमुक्त्वा ततोऽगच्छत्समुद्रं सरितांपतिम्।\nऋषिभिश्च तपःसिद्धै सार्धं देवैश्च सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022270, "chapter_id": 1465, "verse_number": "३-१०३-२२", "content_sanskrit": "मनुष्योरगगन्धर्वयक्षकिंपुरुषास्तथा।\nअनुजग्मुर्महात्मानं द्रष्टुकानास्तदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022271, "chapter_id": 1465, "verse_number": "३-१०३-२३", "content_sanskrit": "ततोऽभ्यगच्छन्सहिताः समुद्रं भीमनिःखनम्।\nनृत्यन्तमिव चोर्मीभिर्वल्गन्तमिव वायुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022272, "chapter_id": 1465, "verse_number": "३-१०३-२४", "content_sanskrit": "हसन्तमिव फेनौघैः स्खलन्तं कन्दरेषु च।\nतानाग्राहसमाकीर्णं नानाद्विजगणान्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022273, "chapter_id": 1465, "verse_number": "३-१०३-२५", "content_sanskrit": "अगस्त्यसहिता देवाः सगन्धर्वमहारगाः।\nऋषयश्च महाभागाः समासेदुर्महोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022274, "chapter_id": 1465, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्तयात्रापर्वणि त्र्यधिकशततमोऽध्यायः ॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]