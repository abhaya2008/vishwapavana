[{"id": 2107930, "chapter_id": 3331, "verse_number": "", "content_sanskrit": "रुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107931, "chapter_id": 3331, "verse_number": "१", "content_sanskrit": "मम प्राणसमा भार्या दष्टासीद् भुजगेन वै ।\nतत्र मे समयो घोर आत्मनोरग वै कृतः\t ॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107932, "chapter_id": 3331, "verse_number": "२", "content_sanskrit": "भुजङ्गमान् सदा हन्यां यं यं पश्येयमित्युत ।\nततोऽहं त्वां जिघांसामि जीवितेन विमोक्ष्यसे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107933, "chapter_id": 3331, "verse_number": "", "content_sanskrit": "डुण्डुभः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107934, "chapter_id": 3331, "verse_number": "३", "content_sanskrit": "अन्ये ते भुजगा विप्र ये दशन्तीह मानवान् ।\nडुण्डुभा नहि शब्देन न त्वं हिंसितुमर्हसि\t ॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107935, "chapter_id": 3331, "verse_number": "४", "content_sanskrit": "एकार्थान् पृथगर्थान् वा एकदुःखान् पृथक् सुखान् ।\nडुण्डुभान् धर्मविद् भूत्वा न त्वं हिंसितुमर्हसि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107936, "chapter_id": 3331, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107937, "chapter_id": 3331, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वा वचस्तस्य भुजगस्य रुरुस्तदा ।\nनावधीद् भृशसंविग्नं ऋषिं मत्वाऽथ डुण्डुभम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107938, "chapter_id": 3331, "verse_number": "६", "content_sanskrit": "उवाच चैनं भगवान् रुरुः संशयवान् गिरा ।\nकेन त्वं भुजग ब्रूहि कोऽसीमां विक्रियां गतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107939, "chapter_id": 3331, "verse_number": "", "content_sanskrit": "डुण्डुभः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107940, "chapter_id": 3331, "verse_number": "७", "content_sanskrit": "अहं पुरा रुरो नाम्ना ऋषिरासं सहस्रपात् ।\nसोऽहं शापेन विप्रस्य भुजगत्वमुपागतः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107941, "chapter_id": 3331, "verse_number": "", "content_sanskrit": "रुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107942, "chapter_id": 3331, "verse_number": "८", "content_sanskrit": "किमर्थं शप्तवान् क्रुद्धो द्विजस्त्वां भुजगोत्तम ।\nकियन्तं चैव कालं ते वपुरेतद् भविष्यति \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107943, "chapter_id": 3331, "verse_number": "१०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107944, "chapter_id": 3331, "verse_number": "७", "content_sanskrit": "॥ पौलोमपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]