[{"id": 7001749000, "chapter_id": 21749, "verse_number": "२-१०-१", "content_sanskrit": "वसिष्ठ उवाच ।\nततः प्राह विशालाक्षी भर्तुर्वाक्यं निशम्य सा ।\nसत्यमुक्तं त्वया राजन्पुत्रसौख्यात्परं सुखम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001749001, "chapter_id": 21749, "verse_number": "२-१०-२", "content_sanskrit": "न भवेदिह राजेंद्र मुनीनां भाषितं यथा ।\nतुल्यं भवति लोकेऽस्मिन् विष्ण्वाख्यस्य परस्य हि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001749002, "chapter_id": 21749, "verse_number": "२-१०-३", "content_sanskrit": "पुत्रे भारस्त्वया न्यस्तः सप्तद्वीपसमुद्भवः ।\nमार्गी हिंसां परित्यज्य यज्ञैरिष्ट्वा जनार्दनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001749003, "chapter_id": 21749, "verse_number": "२-१०-४", "content_sanskrit": "भोगस्पृहां परित्यज्य सेवस्व सुरनिम्नगाम् ।\nएतन्न्याय्यं भवति भो न न्याय्यो मृगनिग्रहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001749004, "chapter_id": 21749, "verse_number": "२-१०-५", "content_sanskrit": "हृदये नखपातो हि वृद्धाया भूपते यथा ।\nतथा विषयसेवा हि पितॄणां पुत्रिणां विदुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001749005, "chapter_id": 21749, "verse_number": "२-१०-६", "content_sanskrit": "गृहे वापि हृषीकेशं पूजयस्व महीपते ।\nनिर्दोषमृगयूथानां न युक्तं सूदनं तव ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001749006, "chapter_id": 21749, "verse_number": "२-१०-७", "content_sanskrit": "अहिंसा परमो धर्मः पुराणे परिकीर्तितः ।\nहिंसया वर्तमानस्य व्यर्थो धर्म्मोभवेदिति ।\nकुर्वन्नपि वृथा धर्मान्यो हिंसामनुवर्तते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001749007, "chapter_id": 21749, "verse_number": "२-१०-८", "content_sanskrit": "परैरुपहतां भूप नोपभुंजंति साधवः ।\nषड्विधं नृप ते प्रोक्तं विद्वद्भिर्जीवघातनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001749008, "chapter_id": 21749, "verse_number": "२-१०-९", "content_sanskrit": "अनुमोदयिता पूर्वं द्वितीयो घातकः स्मृतः ।\nविश्वासकस्तृतीयोऽपि चतुर्थो भक्षकस्तथा ।\nपंचमः पाचकः प्रोक्तः षष्ठो भूपात्र विग्रही ।\nहिं सया संयुतं धर्ममधर्मं च विदुर्बुधाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001749009, "chapter_id": 21749, "verse_number": "२-१०-१०", "content_sanskrit": "न पापं कुरुते भूप पुत्रे भारं निवेश्य वै ।\nधर्मं समाश्रयमन्सम्यक्संजातपलितः पिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001749010, "chapter_id": 21749, "verse_number": "२-१०-११", "content_sanskrit": "परित्यज्य इमं भावं मृगहिंसासमुद्भवम् ।\nमृगशीला हि राजानो विनष्टाः शतशो नृप ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001749011, "chapter_id": 21749, "verse_number": "२-१०-१२", "content_sanskrit": "तस्माद्दुष्टं हि तन्मन्ये यत्र मृगपातनम् ।\nदया वरा मृगेराज्ञां धर्मिणामपि दृश्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001749012, "chapter_id": 21749, "verse_number": "२-१०-१३", "content_sanskrit": "निवारितो मया हि त्वं हितबुद्ध्या पुनः पुनः ।\nएवं ब्रुवाणां तां भार्यां नृपो वचनमब्रवीत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001749013, "chapter_id": 21749, "verse_number": "२-१०-१४", "content_sanskrit": "नहिहिंसे मृगान्देवि मृगव्याजेन कानने ।\nपर्य्यटिष्ये धनुष्पाणिः कुर्वन्कंटकशोधनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001749014, "chapter_id": 21749, "verse_number": "२-१०-१५", "content_sanskrit": "जनमध्ये सुतो मेऽस्तु काननेऽहं वरानने ।\nश्वापदेभ्यश्च दस्युभ्यः प्रजा रक्ष्या महीभृता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001749015, "chapter_id": 21749, "verse_number": "२-१०-१६", "content_sanskrit": "आत्मनावाथ पुत्रेण गोपनीयाः प्रजा शुभे ।\nप्रजा अरक्षन्नृपतिः सधर्म्मोऽपि व्रजत्यधः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001749016, "chapter_id": 21749, "verse_number": "२-१०-१७", "content_sanskrit": "सोऽहं रक्षणमुद्दिश्यगमिष्यामि वनं प्रिये ।\nविमुक्तभावोऽहमिति मेरुश्रृंगे रविर्यथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001749017, "chapter_id": 21749, "verse_number": "२-१०-१८", "content_sanskrit": "एवमुद्दिश्य तां राजा आरुरोह हयोत्तमम् ।\nदोषापतिसमप्रख्यं निर्दोषं क्षितिभूषणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001749018, "chapter_id": 21749, "verse_number": "२-१०-१९", "content_sanskrit": "देववाहसमं रूपे प्रभंजनसमं जवे ।\nधरामादृत्य भूपालो दत्वा तं दक्षिणं करम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001749019, "chapter_id": 21749, "verse_number": "२-१०-२०", "content_sanskrit": "सहस्रकोटिदातारं कामिनीकुचपीडनम् ।\nअशोकपल्लवाकारं वज्रांकुशविरोहणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001749020, "chapter_id": 21749, "verse_number": "२-१०-२१", "content_sanskrit": "संप्रतस्थे महीपालश्चालयानो महीतलम् ।\nसाधयानो ययौ देशान्काननं स नृपोत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001749021, "chapter_id": 21749, "verse_number": "२-१०-२२", "content_sanskrit": "वाजिवेगेन निर्द्धूता वारणाः स्यंदना हयाः ।\nपदातयो निपेतुस्ते मूर्च्छिताः क्षितिमण्डले ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001749022, "chapter_id": 21749, "verse_number": "२-१०-२३", "content_sanskrit": "स राजा सहसा प्राप्तो मुनीनामाश्रमं परम् ।\nयोजनानां समुत्तीर्य शतमष्टोत्तरं नृप ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001749023, "chapter_id": 21749, "verse_number": "२-१०-२४", "content_sanskrit": "प्रविवेशाश्रमं रम्यं कदलीखण्डमण्डितम् ।\nअशोकबकुलोपेतं पुन्नागसरलावृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001749024, "chapter_id": 21749, "verse_number": "२-१०-२५", "content_sanskrit": "मातुलिंगैः कपित्थैश्च खर्जूरैः पनसादिभिः ।\nनारिकेलैस्तथा तालैः केतकैः सिंदुवारकैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001749025, "chapter_id": 21749, "verse_number": "२-१०-२६", "content_sanskrit": "चन्दनैः सतमालैश्च सालैः पिप्पलचंपकैः ।\nक्रमुकैर्दाडिमैश्चैव धात्रीवृक्षैः सहस्रशः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001749026, "chapter_id": 21749, "verse_number": "२-१०-२७", "content_sanskrit": "निम्बवृक्षैश्च बहुशस्तथाम्रैर्लोध्रपादपैः ।\nपरिपक्वफलैर्नम्रैः खगारूढैः समावृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001749027, "chapter_id": 21749, "verse_number": "२-१०-२८", "content_sanskrit": "ह्यद्येन वायुना युक्तं पुष्पगन्धावृतेन हि ।\nपश्यमानो मुनिं राजा ददर्श हुतभुक्प्रभम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001749028, "chapter_id": 21749, "verse_number": "२-१०-२९", "content_sanskrit": "वामदेवं द्विजवरं बहुशिष्यसमावृतम् ।\nअवरुह्य हयाद्दृष्ट्वा प्रणनाम च सादरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001749029, "chapter_id": 21749, "verse_number": "२-१०-३०", "content_sanskrit": "तेनापि मुनिना राजा ह्यर्घाद्यैरभिपूजितः ।\nउपविश्यासने कौशे प्राह संहृष्टया गिरा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001749030, "chapter_id": 21749, "verse_number": "२-१०-३१", "content_sanskrit": "अद्य मे पातकं क्षीणं संप्राप्तं कर्मणः फलम् ।\nदृष्ट्वा तव पदांभोजं सम्यग्ध्यानपरस्य च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001749031, "chapter_id": 21749, "verse_number": "२-१०-३२", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य रुक्मांगदमहीपतेः ।\nसंपृष्ट्वा कुशलं प्राह वामदेवो मुदान्वितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001749032, "chapter_id": 21749, "verse_number": "२-१०-३३", "content_sanskrit": "राजंस्त्वयातिपुण्येन विष्णुभक्तेन वीक्षितः ।\nममाश्रमो महाभाग पुण्यो जातो धरातले ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001749033, "chapter_id": 21749, "verse_number": "२-१०-३४", "content_sanskrit": "कस्तेऽन्यस्तुल्यतामेति पार्थिवो धरणीतले ।\nयेन वैवस्वतो माग्रो भग्नो निर्जित्य वै यमम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001749034, "chapter_id": 21749, "verse_number": "२-१०-३५", "content_sanskrit": "प्रापितः सकलो लोको वैकुंठं पदमव्ययम् ।\nउपोषयित्वा नृपतेद्वादशीं पापनाशिनीम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001749035, "chapter_id": 21749, "verse_number": "२-१०-३६", "content_sanskrit": "चतुर्भिः शोभनोपायैः प्रजाः सयम्य भूतले ।\nस्वकर्मस्था विकर्मस्था नीता मधुभिदः पदम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001749036, "chapter_id": 21749, "verse_number": "२-१०-३७", "content_sanskrit": "सोऽस्माकं द्रष्टुकामानां संप्राप्तो दर्शनं नृप ।\nश्वपचोऽपि महीपाल विष्णुभक्तो द्विजाधिकः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001749037, "chapter_id": 21749, "verse_number": "२-१०-३८", "content_sanskrit": "विष्णुभक्तिविहीनस्तु द्विजोऽपि श्वपचाधिकः ।\nदुर्लभा भूप राजानो विष्णुभक्ता महीतले ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001749038, "chapter_id": 21749, "verse_number": "२-१०-३९", "content_sanskrit": "नावैष्णवो भवेद्राजा क्षितिलक्ष्मीप्रसाधकः ।\nयो न राजा हरेर्भक्तो देवेष्वन्येषु भक्तिमान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001749039, "chapter_id": 21749, "verse_number": "२-१०-४०", "content_sanskrit": "यथा जारे पतिं त्यक्त्वा रता स्त्री स तथा नृपः ।\nएवं व्यतिक्रमस्तस्य नृपतेर्भवति ध्रुवम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001749040, "chapter_id": 21749, "verse_number": "२-१०-४१", "content_sanskrit": "धर्मस्यार्थस्य कामस्य प्रज्ञायाश्च गतेरपि ।\nतत्त्वया न्यायविहितं कृतं विष्णोः प्रपूजनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001749041, "chapter_id": 21749, "verse_number": "२-१०-४२", "content_sanskrit": "तेन धन्योऽसि नृपते वयं धन्यास्तवेक्षणात् ।\nइत्येवं भाषमाणं तु वामदेवं नृपोत्तमः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001749042, "chapter_id": 21749, "verse_number": "२-१०-४३", "content_sanskrit": "उवाचावनतो भूत्वा प्रकृत्या विनयान्वितः ।\nक्षामये त्वा द्विजश्रेष्ठ नाहमेतादृशो विभो ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001749043, "chapter_id": 21749, "verse_number": "२-१०-४४", "content_sanskrit": "त्वत्पादपांसुना तुल्यो नाहं विप्र भवामि हि ।\nन विप्रेभ्योऽधिका देवा भवंतीह कदाचन ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001749044, "chapter_id": 21749, "verse_number": "२-१०-४५", "content_sanskrit": "परितुष्टैर्द्विजैर्भक्तिर्जंतोर्भवति माधवे ।\nद्वेष्यो भवति तै रुष्टैः सत्यमेतन्मयेरितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001749045, "chapter_id": 21749, "verse_number": "२-१०-४६", "content_sanskrit": "तमाह वामदेवस्तु ब्रूहि किं ते ददाम्यहम् ।\nनादेयं विद्यते राजन्गृहायातस्य तेऽधुना ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001749046, "chapter_id": 21749, "verse_number": "२-१०-४७", "content_sanskrit": "अभीष्टं हि महीपाल यो ददाति महीतले ।\nपटहं वासरे विष्णोः प्रजाभोजनवारणम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001749047, "chapter_id": 21749, "verse_number": "२-१०-४८", "content_sanskrit": "तमाह नृपतिर्विप्रं कृतांजलिपुटस्तदा ।\nप्राप्तमेव मया सर्वं त्वदंघ्रियुगलेक्षणात् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001749048, "chapter_id": 21749, "verse_number": "२-१०-४९", "content_sanskrit": "ममैकः संशयो ब्रह्मन् वर्तते बहुकालतः ।\nतं पृच्छामि द्विजाग्र्यं त्वां सर्वसंदेहभञ्जनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001749049, "chapter_id": 21749, "verse_number": "२-१०-५०", "content_sanskrit": "त्रैलोक्यसुन्दरी भार्या मम केन सुकर्मणा ।\nया विलोकयते दृष्ट्या मां सदा मन्मथाधिकम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001749050, "chapter_id": 21749, "verse_number": "२-१०-५१", "content_sanskrit": "यत्र यत्र पदं देवी ददाति वरवर्णिनी ।\nतत्र तत्र निधानानि प्रकाशयति मेदिनी ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001749051, "chapter_id": 21749, "verse_number": "२-१०-५२", "content_sanskrit": "यस्याश्चांगं जराहीनं वलीपलितवर्जितम् ।\nसदा भाति मुनिश्रेष्ठ शारदेंदुप्रभा यथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001749052, "chapter_id": 21749, "verse_number": "२-१०-५३", "content_sanskrit": "विनाग्निनापि सा विप्र साधयत्येव षड्रसम् ।\nअन्नं पचति यत्स्वल्पं तस्मिन्भुञ्जंति कोटयः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001749053, "chapter_id": 21749, "verse_number": "२-१०-५४", "content_sanskrit": "पतव्रता दानशीला सर्वभूतसुखावहा ।\nनावज्ञा क्रियते ब्रह्मन् वाक्येनापि प्रसूप्तया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001749054, "chapter_id": 21749, "verse_number": "२-१०-५५", "content_sanskrit": "यस्यां जातस्तु तनयो ममाज्ञायां स्थितः सदा ।\nअहमेव धरापृष्ठे पुत्री द्विजवरोत्तम ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001749055, "chapter_id": 21749, "verse_number": "२-१०-५६", "content_sanskrit": "यस्य पुत्रः पितुर्भक्तो ह्यधिको गुणसंचयैः ।\nएकद्वीपपतिश्चाहं विदितो धरणीतले ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001749056, "chapter_id": 21749, "verse_number": "२-१०-५७", "content_sanskrit": "पुत्रो ममाधिको जातः सप्तद्वीपप्रपालकः ।\nमदर्थे येन विप्रेंद्र समानीता नृपात्मजा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001749057, "chapter_id": 21749, "verse_number": "२-१०-५८", "content_sanskrit": "विद्युल्लेखेति विख्याता रणे जित्वा महीभुजः ।\nअथ तेनाधिपतिना रूपद्रविणशालिना ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001749058, "chapter_id": 21749, "verse_number": "२-१०-५९", "content_sanskrit": "षण्मासेन रणे जित्वा कृत्वा सर्वान्निरायुधान् ।\nयो गत्वा प्रमदाराज्यं जित्वा ताः प्रमदा रणे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001749059, "chapter_id": 21749, "verse_number": "२-१०-६०", "content_sanskrit": "आजहार शुभास्तासां मध्यादष्टौ वरांगनाः ।\nप्रददौ मयि ताः सर्वाः प्रणम्य च पुनः पुनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001749060, "chapter_id": 21749, "verse_number": "२-१०-६१", "content_sanskrit": "यानि वासांसि दिव्यानि यानि रत्नानि भूतले ।\nतानि मे प्रददौ पुत्रो जनन्या तूपवर्णितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001749061, "chapter_id": 21749, "verse_number": "२-१०-६२", "content_sanskrit": "एकाह्ना पृथिवीं सर्वामतीत्य बहुयोजनाम् ।\nपुनरायाति शर्वर्यां मत्पादाभ्यंगकारणात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001749062, "chapter_id": 21749, "verse_number": "२-१०-६३", "content_sanskrit": "निशीथेंऽगानि संवाह्य द्वारि तिष्ठति दंशितः ।\nप्रबोधयन्प्रेष्यजनान्निद्रया संकुलेंद्रियान् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001749063, "chapter_id": 21749, "verse_number": "२-१०-६४", "content_sanskrit": "तथायं मे मुनिश्रेष्ठ देहो रोगविवर्जितः, ।\nअप्रमेयं मम सुखं वशगा हि प्रिया गृहे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001749064, "chapter_id": 21749, "verse_number": "२-१०-६५", "content_sanskrit": "वाजिनो वारणाश्चैव धनधान्यमनंतकम् ।\nवर्तते हि जनः सर्वो ममाज्ञापालकः क्षितौ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001749065, "chapter_id": 21749, "verse_number": "२-१०-६६", "content_sanskrit": "केन कर्मप्रभावेण ममेदं सांप्रतं सुखम् ।\nइह जन्मकृतं वापि परजन्मकृतं तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001749066, "chapter_id": 21749, "verse_number": "२-१०-६७", "content_sanskrit": "मम पुण्यं वद ब्रह्मन् विचार्य स्वमनीषया ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001749067, "chapter_id": 21749, "verse_number": "२-१०-६८", "content_sanskrit": "देहे न रोगो वशगाप्रिया च गृहे विभूतिर्नृहरौ च भक्तिः ।\nविद्वत्सु पूजा द्विजदानशक्तिर्मन्येऽहमेतत्सुकृतप्रसूतम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]