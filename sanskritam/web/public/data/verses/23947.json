[{"id": 7003947000, "chapter_id": 23947, "verse_number": "३-१-१०-१", "content_sanskrit": "श्रीसूत उवाच ।\nवेतालवरदे तीर्थे नरः स्नात्वा द्विजोत्तमाः ।\nततः शनैःशनैर्गच्छेद्गन्धमादनपर्वतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003947001, "chapter_id": 23947, "verse_number": "३-१-१०-२", "content_sanskrit": "योंऽबुधौ सेतुरूपेण वर्तते गन्धमादनः ।\nस मार्गो ब्रह्मलोकस्य विश्वकर्त्रा विनिर्मितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003947002, "chapter_id": 23947, "verse_number": "३-१-१०-३", "content_sanskrit": "लक्षकोटिसहस्राणि सरांसि सरितस्तथा ।\nसमुद्राश्च महापुण्या वनान्यप्याश्रमाणि च॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003947003, "chapter_id": 23947, "verse_number": "३-१-१०-४", "content_sanskrit": "पुण्यानि क्षेत्रजातानि वेदारण्या दिकानि च ।\nमुनयश्च वसिष्ठाद्या सिद्धचारणकिन्नराः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003947004, "chapter_id": 23947, "verse_number": "३-१-१०-५", "content_sanskrit": "लक्ष्म्या सह धरण्या च भगवान्मधुसूदनः ।\nसावित्र्या च सरस्वत्या सहैव चतु राननः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003947005, "chapter_id": 23947, "verse_number": "३-१-१०-६", "content_sanskrit": "हेरंबः षण्मुखश्चैव देवाश्चेंद्रपुरोगमाः ।\nआदित्यादिग्रहाश्चैव तथाष्टौ वसवो द्विजाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003947006, "chapter_id": 23947, "verse_number": "३-१-१०-७", "content_sanskrit": "पितरोलोकपालाश्च तथान्ये देवता गणाः ।\nमहापातकसंघानां नाशने लोकपावने॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003947007, "chapter_id": 23947, "verse_number": "३-१-१०-८", "content_sanskrit": "दिवानिशं वसंत्यत्र पर्वते गंधमादने ।\nअत्र गौरी सदा तुष्टा हरेण सह वर्तते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003947008, "chapter_id": 23947, "verse_number": "३-१-१०-९", "content_sanskrit": "अत्र किन्नरकांतानां क्रीडा जागर्ति नित्यशः ।\nतस्य दर्शनमात्रेण बुद्धिसौख्यं नृणां भवेत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003947009, "chapter_id": 23947, "verse_number": "३-१-१०-१०", "content_sanskrit": "तन्मूर्धनि कृतावासाः सिद्धचारणयोषितः ।\nपूजयंति सदा कालं शंकरं गिरिजापतिम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003947010, "chapter_id": 23947, "verse_number": "३-१-१०-११", "content_sanskrit": "कोटयो ब्रह्महत्यानामगम्यागमकोटयः ।\nअंगलग्नैर्विनश्यंति गन्धमादनमारुतैः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003947011, "chapter_id": 23947, "verse_number": "३-१-१०-१२", "content_sanskrit": "असावुल्लोलकल्लोले तिष्ठन्मध्ये महांबुधौ ।\nआसीन्मुनिगणैः सेव्यः पुरा वै गन्धमादनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003947012, "chapter_id": 23947, "verse_number": "३-१-१०-१३", "content_sanskrit": "ततो नलेन सेतौ तु बद्धे तन्मध्यगोचरः ।\nरामाज्ञयाखिलैः सेव्यो बभूव मनुजैरपि॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003947013, "chapter_id": 23947, "verse_number": "३-१-१०-१४", "content_sanskrit": "सेतुरूपं गिरिं तं तु प्रार्थयेद्गंधमादनम् ।\nक्षमाधर महापुण्य सर्वदेवनमस्कृत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003947014, "chapter_id": 23947, "verse_number": "३-१-१०-१५", "content_sanskrit": "विष्ण्वा दयोऽपि ये देवास्सेवंते श्रद्धया सह ।\nतं भवंतमहं पद्भ्यामाक्रमामि नगोत्तम॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003947015, "chapter_id": 23947, "verse_number": "३-१-१०-१६", "content_sanskrit": "क्षमस्व पादघातं मे दयया पापचेतसः ।\nत्वन्मूर्द्धनि कृतावासं शंकरं दर्शयस्व मे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003947016, "chapter_id": 23947, "verse_number": "३-१-१०-१७", "content_sanskrit": "प्रार्थयित्वा नरस्त्वेवं सेतुरूपं नगोत्तमम् ।\nततो मृदुपदं गच्छेत्पावनं गन्धमादनम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003947017, "chapter_id": 23947, "verse_number": "३-१-१०-१८", "content_sanskrit": "अब्धौ तत्र नरः स्नात्वा पर्वते गन्धमादने ।\nपिंडदानं ततः कुर्यादपि सर्षपमात्रकम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003947018, "chapter_id": 23947, "verse_number": "३-१-१०-१९", "content_sanskrit": "तृप्तिं प्रयांति पितरस्तस्य यावद्युगक्षयः ।\nशमीदलसमानान्वा दद्यात्पिंडान्पितॄन्प्रति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003947019, "chapter_id": 23947, "verse_number": "३-१-१०-२०", "content_sanskrit": "स्वर्गस्था मोक्षमायांति स्वर्गं नरकवासिनः ।\nततस्तस्योपरि महातीर्थं लोकेषु विश्रुतम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003947020, "chapter_id": 23947, "verse_number": "३-१-१०-२१", "content_sanskrit": "सर्वतीर्थोत्तमं पुण्यं नाम्ना पापविनाशनम् ।\nअस्ति पुण्यतमं विप्राः पवित्रे गन्धमादने॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003947021, "chapter_id": 23947, "verse_number": "३-१-१०-२२", "content_sanskrit": "यस्य संस्मरणादेव गर्भवासो न विद्यते ।\nतत्प्राप्य तु नरः स्नायात्स्वदे हमलनाशनम् ।\nतत्र स्नानान्नरो याति वैकुण्ठं नात्र संशयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003947022, "chapter_id": 23947, "verse_number": "३-१-१०-२३", "content_sanskrit": "ऋषय ऊचुः ।\nसूत पापविनाशाख्य तीर्थस्य ब्रूहि वैभवम् ।\nव्यासेन बोधितस्त्वं हि वेत्सि सर्वं महामुने॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003947023, "chapter_id": 23947, "verse_number": "३-१-१०-२४", "content_sanskrit": "श्रीसूत उवाच ।\nब्रह्माश्रमपदे वृत्तां पार्श्वे हिमवतः शुभे ।\nवक्ष्यामि ब्राह्मणश्रेष्ठा युष्माकं तु कथां शुभाम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003947024, "chapter_id": 23947, "verse_number": "३-१-१०-२५", "content_sanskrit": "अस्याश्रमपदं पुण्यं ब्रह्माश्रमपदे शुभे ।\nनानावृक्षगणाकीर्णं पार्श्वे हिमवतः शुभे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003947025, "chapter_id": 23947, "verse_number": "३-१-१०-२६", "content_sanskrit": "वहुगुल्मलताकीर्णं मृगद्विपनिषेवितम् ।\nसिद्धचारणसंघुष्टं रम्यं पुष्पितकाननम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003947026, "chapter_id": 23947, "verse_number": "३-१-१०-२७", "content_sanskrit": "वृतिभिर्बहुभिः कीर्णं तापसैरुशोभितम् ।\nब्राह्मणैश्च महाभागैः सूर्यज्वलनसंनिभैः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003947027, "chapter_id": 23947, "verse_number": "३-१-१०-२८", "content_sanskrit": "नियमव्रतसं पन्नैः समाकीर्णं तपस्विभिः ।\nदीक्षितैर्यागहेतोश्च यताहारैः कृतात्मभिः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003947028, "chapter_id": 23947, "verse_number": "३-१-१०-२९", "content_sanskrit": "वेदाध्ययनसंपन्नैर्वैदिकैः परिवेष्टितम् ।\nवर्णिभिश्च गृहस्थैश्च वानप्रस्थैश्च भिक्षुभिः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003947029, "chapter_id": 23947, "verse_number": "३-१-१०-३०", "content_sanskrit": "स्वाश्रमाचारनिरतैः स्ववर्णोक्तविधायिभिः ।\nवालखिल्यैश्च मुनिभिः संप्राप्तैश्च मरीचिभिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003947030, "chapter_id": 23947, "verse_number": "३-१-१०-३१", "content_sanskrit": "तत्राश्रमे पुरा कश्चिच्छूद्रो दृढमतिर्द्विजाः ।\nसाहसी ब्राह्मणाभ्याशमाजगाम मुदान्वितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003947031, "chapter_id": 23947, "verse_number": "३-१-१०-३२", "content_sanskrit": "आगतो ह्याश्रमपदं पूजितश्च तपस्विभिः ।\nनाम्ना दृढमतिः शूद्रः साष्टांगं प्रणनाम वै॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003947032, "chapter_id": 23947, "verse_number": "३-१-१०-३३", "content_sanskrit": "तान्स दृष्ट्वा मुनिगणान्देवकल्पान्महौजसः ।\nकुर्वतो विविधान्यज्ञान्संप्रहृष्य स शूद्रकः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003947033, "chapter_id": 23947, "verse_number": "३-१-१०-३४", "content_sanskrit": "अथास्य बुद्धिरभवत्तपःकर्तुमनुत्तमम् ।\nततोऽब्रवीत्कुलपतिं मुनिमागत्य तापसम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003947034, "chapter_id": 23947, "verse_number": "३-१-१०-३५", "content_sanskrit": "दृढमतिरुवाच ।\nतपोधन नमस्तेऽस्तु रक्ष मां करुणानिधे ।\nतव प्रसादादिच्छामि धर्मं चर्तुं द्विजर्षभ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003947035, "chapter_id": 23947, "verse_number": "३-१-१०-३६", "content_sanskrit": "तस्मादभिगतं मां त्वं यागे दीक्षय सुव्रत ।\nब्रह्मन्नवरवर्णोऽहं शूद्रो जात्यास्मि सत्तम॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003947036, "chapter_id": 23947, "verse_number": "३-१-१०-३७", "content_sanskrit": "शुश्रूषां कर्तुमिच्छामि प्रपन्नाय प्रसीद मे ।\nएवमुक्ते तु शूद्रेण तमाह ब्राह्मणस्तदा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003947037, "chapter_id": 23947, "verse_number": "३-१-१०-३८", "content_sanskrit": "कुलपतिरुवाच ।\nयागे दीक्षयितुं शक्यो न शूद्रो हीनजन्मभाक् ।\nश्रूयतां यदि ते बुद्धिः शुश्रूषानिरतो भव॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003947038, "chapter_id": 23947, "verse_number": "३-१-१०-३९", "content_sanskrit": "उपदेशो न कर्तव्यो जातिहीनस्य कर्हिचित् ।\nउपदेशे महान्दोष उपाध्यायस्य विद्यते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003947039, "chapter_id": 23947, "verse_number": "३-१-१०-४०", "content_sanskrit": "नाध्यापयेद्बुधः शूद्रं तथा नैव च याजयेत् ।\nन पाठयेत्तथा शूद्रं शास्त्रं व्याकरणादिकम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003947040, "chapter_id": 23947, "verse_number": "३-१-१०-४१", "content_sanskrit": "काव्यं वा नाटकं वापि तथालंकारमेव च ।\nपुराणमितिहासं च शूद्रं नैव तु पाठयेत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003947041, "chapter_id": 23947, "verse_number": "३-१-१०-४२", "content_sanskrit": "यदि चोपदिशेद्विप्रः शूद्रं चैतानि कर्हिचित् ।\nत्यजेयुर्ब्राह्मणा विप्रं तं ग्रामाद्ब्रह्मसंकुलात्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003947042, "chapter_id": 23947, "verse_number": "३-१-१०-४३", "content_sanskrit": "शूद्राय चोपदेष्टारं द्विजं चंडालवत्त्यजेत् ।\nशूद्रं चाक्षरसंयुक्तं दूरतः परिवर्जयेत्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003947043, "chapter_id": 23947, "verse_number": "३-१-१०-४४", "content_sanskrit": "अतः शुश्रूष भद्रं ते ब्राह्मणाञ्छ्रद्धया सह ।\nशूद्रस्य द्विजशुश्रूषा मन्वादिभिरुदीरिता॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003947044, "chapter_id": 23947, "verse_number": "३-१-१०-४५", "content_sanskrit": "नहि नैसर्गिकं कर्म परित्यक्तुं त्वमर्हसि ।\nएवमुक्तस्तु मुनिना स शूद्रोऽचिंतयत्तदा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003947045, "chapter_id": 23947, "verse_number": "३-१-१०-४६", "content_sanskrit": "किं कर्तव्यं मया त्वद्य व्रते श्रद्धा हि मे पुरा ।\nयथा स्यान्मम विज्ञानं यतिष्येऽहं तथाद्य वै॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003947046, "chapter_id": 23947, "verse_number": "३-१-१०-४७", "content_sanskrit": "इति निश्चित्य मनसा शूद्रो दृढमतिस्तदा ।\nगत्वाश्रमपदाद्दूरं कृतवानुटजं शुभम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003947047, "chapter_id": 23947, "verse_number": "३-१-१०-४८", "content_sanskrit": "तत्र वै देवतागारं पुण्यान्यायतनानिच ।\nपुष्पारामादिकं चापि तटाकखननादिकम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003947048, "chapter_id": 23947, "verse_number": "३-१-१०-४९", "content_sanskrit": "श्रद्धया कारयामास तपःसिद्ध्यर्थमात्मनः ।\nअभिषेकांश्च नियमानुपवासादिकानपि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003947049, "chapter_id": 23947, "verse_number": "३-१-१०-५०", "content_sanskrit": "बलिं च कृत्वा हुत्वा च दैवतान्यभ्यपूजयत् ।\nसंकल्पनियमोपेतः फलाहारो जितेंद्रियः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003947050, "chapter_id": 23947, "verse_number": "३-१-१०-५१", "content_sanskrit": "नित्यं कंदैश्च मूलैश्च पुष्पैरपि तथा फलैः ।\nअतिथीन्पूजयामास यथावत्समुपागतान्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003947051, "chapter_id": 23947, "verse_number": "३-१-१०-५२", "content_sanskrit": "एवं हि सुमहान्कालो व्यतिचक्राम तस्य वै ।\nअथाश्रममगात्तस्य सुमतिर्नाम नामतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003947052, "chapter_id": 23947, "verse_number": "३-१-१०-५३", "content_sanskrit": "द्विजो गर्गकुलोद्भूतः सत्यवादी जितेंद्रियः ।\nस्वागतेन मुनिं पूज्य तोषयित्वा फलादिकैः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003947053, "chapter_id": 23947, "verse_number": "३-१-१०-५४", "content_sanskrit": "कथयन्वै कथाः पुण्याः कुशलं पर्यपृच्छत ।\nइत्थं सप्रणिपाताद्यैरुपचारैस्तु पूजितः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003947054, "chapter_id": 23947, "verse_number": "३-१-१०-५५", "content_sanskrit": "आशीर्भिरभिनंद्यैनं प्रतिगृह्य च सत्क्रियाम् ।\nतमापृछ्य प्रहृष्टाप्मा स्वाश्रमं पुनराययौ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003947055, "chapter_id": 23947, "verse_number": "३-१-१०-५६", "content_sanskrit": "एवं दिनेदिने विप्रः शूद्रेस्मिन्पक्षपातवान् ।\nआगच्छदाश्रमं तस्य द्रष्टुं तं शूद्रयोनिजम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003947056, "chapter_id": 23947, "verse_number": "३-१-१०-५७", "content_sanskrit": "बहुकालं द्विजस्याभूत्संसर्गः शूद्रयोनिना ।\nस्नेहस्य वशमापन्नः शूद्रोक्तं नातिचक्रमे॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003947057, "chapter_id": 23947, "verse_number": "३-१-१०-५८", "content_sanskrit": "अथागतं द्विजं शूद्रः प्राह स्नेहवशीकृतम् ।\nहव्यकव्यविधानं मे कृत्स्नं ब्रूहि मुनीश्वर॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003947058, "chapter_id": 23947, "verse_number": "३-१-१०-५९", "content_sanskrit": "पितृकार्यविधानार्थं देवकार्यार्थमेव च ।\nमंत्रानुपदिश त्वं मे महालयविधिं तथा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003947059, "chapter_id": 23947, "verse_number": "३-१-१०-६०", "content_sanskrit": "अष्टकाश्राद्धकृत्यं च वैदिकं यच्च किंचन ।\nसर्वमेतद्रहस्यं मे ब्रूहि त्वं वै गुरुर्मतः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003947060, "chapter_id": 23947, "verse_number": "३-१-१०-६१", "content_sanskrit": "एवमुक्तः स शूद्रेण सर्वमेतदुपादिशत् ।\nकारयामास तस्यायं पितृकार्यादिकं तथा॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003947061, "chapter_id": 23947, "verse_number": "३-१-१०-६२", "content_sanskrit": "पितृकार्ये कृते तेन विसृष्टः स द्विजो गतः ।\nअथ दीर्घेण कालेन पोषितः शूद्रयोनिना॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003947062, "chapter_id": 23947, "verse_number": "३-१-१०-६३", "content_sanskrit": "त्यक्तो विप्रगणैः सोऽयं पंचत्वमगमद्द्विजः ।\nवैवस्वतभटैर्नीत्वा पातितो नरकेष्वपि॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003947063, "chapter_id": 23947, "verse_number": "३-१-१०-६४", "content_sanskrit": "कल्पकोटिसहस्राणि कल्पकोटिशतानि च ।\nभुक्त्वा क्रमेण नरकांस्तदंते स्था वरोऽभवत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003947064, "chapter_id": 23947, "verse_number": "३-१-१०-६५", "content_sanskrit": "गर्दभस्तु ततो जज्ञे विड्वराहस्ततः परम् ।\nजज्ञेऽथ सारमेयोऽसौ पश्चाद्वायसतां गतः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003947065, "chapter_id": 23947, "verse_number": "३-१-१०-६६", "content_sanskrit": "अथ चंडालतां प्राप शूद्रयोनिमगात्ततः ।\nगतवान्वैश्यतां पश्चात्क्षत्रियस्तदनंतरम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003947066, "chapter_id": 23947, "verse_number": "३-१-१०-६७", "content_sanskrit": "प्रबलैर्बाध्यमानोऽसौ ब्राह्मणो वै तदाऽभवत् ।\nउपनीतः स पित्रा तु वर्षे गर्भाष्टमे द्विजः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003947067, "chapter_id": 23947, "verse_number": "३-१-१०-६८", "content_sanskrit": "वर्तमानः पितुर्गेहे स्वाचाराभ्यासतत्परः ।\nगच्छन्कदाचिद्गहने गृहीतो ब्रह्मरक्षसा॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003947068, "chapter_id": 23947, "verse_number": "३-१-१०-६९", "content_sanskrit": "रुदन्भ्रमन्स्खल न्मूढः प्रहसन्विलपन्नसौ ।\nशश्वद्धाहेति च वदन्वैदिकं कर्म सोऽत्यजत्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003947069, "chapter_id": 23947, "verse_number": "३-१-१०-७०", "content_sanskrit": "दृष्ट्वा सुतं तथाभूतं पिता दुःखेन पीडितः ।\nसुतमादाय च स्नेहा दगस्त्यं शरणं ययौ॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003947070, "chapter_id": 23947, "verse_number": "३-१-१०-७१", "content_sanskrit": "भक्त्या मुनिं प्रणम्यासौ पिता तस्य सुतस्य वै ।\nतस्मै निवेदयामास स्वपुत्रस्य विचेष्टितम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003947071, "chapter_id": 23947, "verse_number": "३-१-१०-७२", "content_sanskrit": "अब्रवीच्च तदा विप्रः कुम्भजं मुनिपुंगवम् ।\nएष मे तनयो ब्रह्मन्गृहीतो ब्रह्मरक्षसा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003947072, "chapter_id": 23947, "verse_number": "३-१-१०-७३", "content_sanskrit": "सुखं न भजते ब्रह्मन्रक्ष तं करुणादृशा ।\nनास्ति मे तनयोऽ प्यन्यः पितॄणामृणमुक्तये॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003947073, "chapter_id": 23947, "verse_number": "३-१-१०-७४", "content_sanskrit": "अस्य पीडाविनाशार्थमुपायं ब्रूहि कुम्भज ।\nत्वत्समस्त्रिषु लोकेषु तपःशीलो न विद्यते॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003947074, "chapter_id": 23947, "verse_number": "३-१-१०-७५", "content_sanskrit": "अग्रणीः शिवभक्तानामुक्तस्त्वं हि महर्षिभिः ।\nत्वां विनास्य परित्राणं न मेपुत्रस्य विद्यते॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003947075, "chapter_id": 23947, "verse_number": "३-१-१०-७६", "content_sanskrit": "पित्रे कृपां कुरुष्व त्वं दयाशीला हि साधवः ।\nश्रीसूत उवाच ।\nएवमुक्तस्तदा तेन कुम्भजो ध्यानमास्थितः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003947076, "chapter_id": 23947, "verse_number": "३-१-१०-७७", "content_sanskrit": "ध्यात्वा तु सुचिरं कालमब्रवीद्ब्राह्मणं ततः ।\nअगस्त्य उवाच ।\nपूर्वजन्मनि ते पुत्रो ब्राह्मणोऽयं महामते॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003947077, "chapter_id": 23947, "verse_number": "३-१-१०-७८", "content_sanskrit": "सुमतिर्नाम विप्रोऽयं मतिं शूद्राय वै ददौ ।\nकर्माणि वैदिकान्येष सर्वाण्युपदि देश वै॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003947078, "chapter_id": 23947, "verse_number": "३-१-१०-७९", "content_sanskrit": "अतोऽयं नरकान्भुक्त्वा कल्पकोटिसहस्रकम् ।\nजातो भुवि तदंतेषु स्थावरादिषु योनिषु॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003947079, "chapter_id": 23947, "verse_number": "३-१-१०-८०", "content_sanskrit": "इदानीं ब्राह्मणो जातः कर्मशेषेण ते सुतः ।\nयमेन प्रेषितेनात्र गृहीतो ब्रह्मरक्षसा॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003947080, "chapter_id": 23947, "verse_number": "३-१-१०-८१", "content_sanskrit": "क्रूरेण पातकेनाद्धा पूवजन्मकृतेन वै ।\nउपायं ते प्रवक्ष्यामि ब्रह्मरक्षोविनाशने॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003947081, "chapter_id": 23947, "verse_number": "३-१-१०-८२", "content_sanskrit": "शृणुष्व श्रद्धया युक्तः समाधाय च मानसम् ।\nदक्षिणांभोनिधौ विप्र सेतुरूपो महागिरिः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003947082, "chapter_id": 23947, "verse_number": "३-१-१०-८३", "content_sanskrit": "वर्तते दैवतैः सेव्यः पावनो गन्धमादनः ।\nतस्योपरि महातीर्थं नाम्ना पापविनाशनम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003947083, "chapter_id": 23947, "verse_number": "३-१-१०-८४", "content_sanskrit": "अस्ति पुण्यं प्रसिद्धं च महापातकनाशनम् ।\nभूतप्रेतपिशाचानां वेतालब्रह्म रक्षसाम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003947084, "chapter_id": 23947, "verse_number": "३-१-१०-८५", "content_sanskrit": "महतां चैव रोगाणां तीर्थं तन्नाशकं स्मृतम् ।\nसुतमादाय गच्छ त्वं तत्तीर्थं सेतुमध्यगम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003947085, "chapter_id": 23947, "verse_number": "३-१-१०-८६", "content_sanskrit": "प्रयतः स्नापय सुतं तीर्थे पापविनाशने ।\nस्नानेन त्रिदिनं तत्र ब्रह्मरक्षो विनश्यति॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003947086, "chapter_id": 23947, "verse_number": "३-१-१०-८७", "content_sanskrit": "नैवोपायांतरं तस्य विनाशे विद्यते भुवि ।\nतस्माच्छीघ्रं प्रयाहि त्वं रामसेतुं विमुक्तिदम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003947087, "chapter_id": 23947, "verse_number": "३-१-१०-८८", "content_sanskrit": "तत्र पापविनाशाख्यतीर्थे स्नापय ते सुतम् ।\nमा विलंबं कुरुष्वात्र त्वरया याहि वै द्विज॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003947088, "chapter_id": 23947, "verse_number": "३-१-१०-८९", "content_sanskrit": "इत्युक्तः स द्विजोऽगस्त्यं प्रणम्य भुवि दण्डवत् ।\nअनुज्ञातश्च तेनासौ प्रययौ गंधमादनम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003947089, "chapter_id": 23947, "verse_number": "३-१-१०-९०", "content_sanskrit": "सुतेन साकं विप्रेंद्रो गत्वा पापविनाशनम् ।\nसंकल्पपूर्वं संस्नाप्य दिनत्रयमसौसुतम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003947090, "chapter_id": 23947, "verse_number": "३-१-१०-९१", "content_sanskrit": "सस्नौ स्वयं च विप्रेंद्राः पिता पापविनाशने ।\nअथ तस्य सुतस्तत्र विमुक्तो ब्रह्मरक्षसा॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003947091, "chapter_id": 23947, "verse_number": "३-१-१०-९२", "content_sanskrit": "समजायत नीरोगः स्वस्थः सुन्दररूपधृक् ।\nसर्वसंपत्समृद्धोऽसौ भुक्त्वा भोगाननेकशः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003947092, "chapter_id": 23947, "verse_number": "३-१-१०-९३", "content_sanskrit": "देहांते प्रययौ मुक्तिं स्नानात्पापविनाशने ।\nपितापि तत्र स्नानेन देहांते मुक्तिमाप्तवान्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003947093, "chapter_id": 23947, "verse_number": "३-१-१०-९४", "content_sanskrit": "तेनोपदिष्टो यः शूद्रः स भुक्त्वा नरकान्क्रमात् ।\nअनेकासु जनित्वा च कुत्सितास्वपियोनिषु॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003947094, "chapter_id": 23947, "verse_number": "३-१-१०-९५", "content_sanskrit": "गृध्रजन्मा भवत्पश्चाद्गंधमादनपर्वते ।\nस कदाचिज्जलं पातुं तीर्थे पापविनाशने॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003947095, "chapter_id": 23947, "verse_number": "३-१-१०-९६", "content_sanskrit": "समागतः पपौ तोयं सिषिचे चात्मनस्तनुम् ।\nतदैव दिव्यदेहः सन्सर्वाभरणभूषितः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003947096, "chapter_id": 23947, "verse_number": "३-१-१०-९७", "content_sanskrit": "दिव्यमाल्यांबरधरो रक्तचंदनरूषितः ।\nदिव्यं विमानमारुह्य शोभितश्छत्रचामरैः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003947097, "chapter_id": 23947, "verse_number": "३-१-१०-९८", "content_sanskrit": "उत्तमस्त्रीपरिवृतः प्रययावमरालयम्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003947098, "chapter_id": 23947, "verse_number": "३-१-१०-९९", "content_sanskrit": "श्रीसूत उवाच ।\nएवं प्रभावमेतद्वै तीर्थं पापविनाशनम् ।\nस्वर्गदं मोक्षदं पुण्यं प्रायश्चित्तकरं तथा ।\nब्रह्मविष्णुमहे शानैः सेवितं सुरसेवितम्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003947099, "chapter_id": 23947, "verse_number": "३-१-१०-१००", "content_sanskrit": "पापानां नाशनाद्विप्राः पापनाशाभिधं हि तत् ।\nश्रेयोर्थी पुरुषस्तस्मात्स्नायात्पापविनाशने॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003947100, "chapter_id": 23947, "verse_number": "३-१-१०-१०१", "content_sanskrit": "इत्थं रहस्यं कथितं मुनींद्रास्तद्वैभवं पापविनाशनस्य ।\nयत्राभिषेकात्सहसा विमुक्तौ द्विजश्च शूद्रश्च विनिंद्यकृत्यौ॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]