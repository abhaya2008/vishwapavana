[{"id": 7001285000, "chapter_id": 21285, "verse_number": "३-१७-१", "content_sanskrit": "शृण्वथो गिरिशस्याद्यावतारान् दशसंख्यकान् ।\nमहाकलमुखान् भक्त्योपासनाकाण्डसेवितान्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001285001, "chapter_id": 21285, "verse_number": "३-१७-२", "content_sanskrit": "तत्राद्यो हि महाकालो भुक्तिमुक्तिप्रदस्सताम् ।\nशक्तिस्तत्र महाकाली भक्तेप्सितफलप्रदा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001285002, "chapter_id": 21285, "verse_number": "३-१७-३", "content_sanskrit": "तारनामा द्वितीयश्च तारा शक्तिस्तथैव सा ।\nभुक्तिमुक्तिप्रदौ चोभौ स्वसेवकसुखप्रदौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001285003, "chapter_id": 21285, "verse_number": "३-१७-४", "content_sanskrit": "भुवनेशो हि बालाह्वस्तृतीयः परिकीर्तितः ।\nभुवनेशी शिवा तत्र बालाह्वा सुखदा सताम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001285004, "chapter_id": 21285, "verse_number": "३-१७-५", "content_sanskrit": "श्रीविद्येशः षोडशाह्वः श्रीर्विद्या षोडशी शिवा ।\nचतुर्थो भक्त सुखदो भुक्तिमुक्तिफलप्रदः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001285005, "chapter_id": 21285, "verse_number": "३-१७-६", "content_sanskrit": "पञ्चमो भैरवः ख्यातः सर्वदा भक्तकामदः ।\nभैरवी गिरिजा तत्र सदुपासककामदा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001285006, "chapter_id": 21285, "verse_number": "३-१७-७", "content_sanskrit": "छिन्नमस्तकनामासौ शिवः षष्ठः प्रकीर्तितः ।\nभक्तकामप्रदा चैव गिरिजा छिन्नमस्तका॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001285007, "chapter_id": 21285, "verse_number": "३-१७-८", "content_sanskrit": "धूमवान् सप्तमः शम्भुस्सर्वकामफलप्रदः ।\nधूमवती शिवा तत्र सदुपासककामदा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001285008, "chapter_id": 21285, "verse_number": "३-१७-९", "content_sanskrit": "शिवावतारः सुखदो ह्यष्टमो बगलामुखः ।\nशक्तिस्तत्र महानन्दा विख्याता बगलामुखी॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001285009, "chapter_id": 21285, "verse_number": "३-१७-१०", "content_sanskrit": "शिवावतारो मातङ्गो नवमः परिकीर्तितः ।\nमातंगी तत्र शर्वाणी सर्वकामफलप्रदा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001285010, "chapter_id": 21285, "verse_number": "३-१७-११", "content_sanskrit": "दशमः कमलः शम्भुर्भुक्तिमुक्तिफलप्रदः ।\nकमला गिरिजा तत्र स्वभक्तपरिपालिनी॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001285011, "chapter_id": 21285, "verse_number": "३-१७-१२", "content_sanskrit": "एते दशमिताः शैवा अवतारास्सुखप्रदाः ।\nभुक्तिमुक्तिप्रदाश्चैव भक्तानां सर्वदास्सताम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001285012, "chapter_id": 21285, "verse_number": "३-१७-१३", "content_sanskrit": "एते दशावतारा हि शंकरस्य महात्मनः ।\nनानासुखप्रदा नित्यं सेवतां निर्विकारतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001285013, "chapter_id": 21285, "verse_number": "३-१७-१४", "content_sanskrit": "एतद्दशावताराणां माहात्म्यं वर्णितं मुने ।\nसर्वकामप्रदं ज्ञेयं तंत्रशास्त्रादिगर्भितम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001285014, "chapter_id": 21285, "verse_number": "३-१७-१५", "content_sanskrit": "एतासामादिशक्तीनामद्भुतो महिमा मुने ।\nसर्वकामप्रदो ज्ञेयस्तत्रंशास्त्रादिगर्भितः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001285015, "chapter_id": 21285, "verse_number": "३-१७-१६", "content_sanskrit": "शत्रुमारणकार्य्यादौ तत्तच्छक्तिः परा मता ।\nखल दण्डकरी नित्यम्ब्रह्मतेजोविवर्द्धिनी॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001285016, "chapter_id": 21285, "verse_number": "३-१७-१७", "content_sanskrit": "इत्युक्तास्ते मया ब्रह्मन्नवतारा महेशितुः ।\nसशक्तिका दशमिता महाकालमुखाश्शुभाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001285017, "chapter_id": 21285, "verse_number": "३-१७-१८", "content_sanskrit": "शैवपर्वसु सर्वेषु योऽधीते भक्तितत्परः ।\nएतदाख्यानममलं सोतिशम्भुप्रियो भवेत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001285018, "chapter_id": 21285, "verse_number": "३-१७-१९", "content_sanskrit": "ब्रह्मणो ब्रह्मवर्चस्वी क्षत्रियो विजयी भवेत ।\nधनाधिपो हि वैश्यः स्याच्छूद्रः सुखमवाप्नुयात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001285019, "chapter_id": 21285, "verse_number": "३-१७-२०", "content_sanskrit": "शांकरा निजधर्मस्थाः शृण्वन्तश्चरितन्त्विदम् ।\nसुखिनः स्युर्विशेषेण शिवभक्ता भवन्तु च॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]