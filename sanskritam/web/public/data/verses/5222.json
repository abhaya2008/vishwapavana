[{"id": 2198502, "chapter_id": 5222, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198503, "chapter_id": 5222, "verse_number": "१", "content_sanskrit": "तमागतमभिप्रेक्ष्य शिष्यं वाक्यमथाब्रवीत् ।\nदेवशर्मा महातेजा यत्तच्छृणु नराधिप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198504, "chapter_id": 5222, "verse_number": "", "content_sanskrit": "देवशर्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198505, "chapter_id": 5222, "verse_number": "२", "content_sanskrit": "किं ते विपुल दृष्टं वै तस्मिन्नद्य महावने ।\nते त्वां जानन्ति निपुणं आत्मा च रुचिरेव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198506, "chapter_id": 5222, "verse_number": "", "content_sanskrit": "विपुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198507, "chapter_id": 5222, "verse_number": "३", "content_sanskrit": "ब्रह्मर्षे मिथुनं किं तत् के च ते पुरुषा विभो ।\nये मां जानन्ति तत्त्वेन तांश्च मे वक्तुमर्हसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198508, "chapter_id": 5222, "verse_number": "", "content_sanskrit": "देवशर्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198509, "chapter_id": 5222, "verse_number": "४", "content_sanskrit": "यद्वै तन्मिथुनं ब्रह्मन्नहोरात्रं हि विद्धि तत् ।\nचक्रवत् परिवर्तेत तत् ते जानाति दुष्कृतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198510, "chapter_id": 5222, "verse_number": "५", "content_sanskrit": "ये च ते पुरुषा विप्र अक्षैर्दीव्यन्ति हृष्टवत् ।\nऋतूंस्तानभिजानीहि ते ते जानन्ति दुष्कृतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198511, "chapter_id": 5222, "verse_number": "६", "content_sanskrit": "न मां कश्चिद् विजानीत इति कृत्वा न विश्वसेत् ।\nनरो रहसि पापात्मा पापकं कर्म वै द्विज\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198512, "chapter_id": 5222, "verse_number": "७", "content_sanskrit": "कुर्वाणं हि नरं कर्म पापं रहसि सर्वदा ।\nपश्यन्ति ऋतवश्चापि तथा दिननिशेऽप्युत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198513, "chapter_id": 5222, "verse_number": "८", "content_sanskrit": "ते त्वां हर्षस्मितं दृष्ट्वा गुरोः कर्मानिवेदकम् ।\nस्मारयन्तस्तथा प्राहुस्ते यथा श्रुतवान् भवान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198514, "chapter_id": 5222, "verse_number": "९", "content_sanskrit": "अहोरात्रं विजानाति ऋतवश्चापि नित्यशः ।\nपुरुषे पापकं कर्म शुभं वा शुभकर्मणः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198515, "chapter_id": 5222, "verse_number": "१०", "content_sanskrit": "तत् त्वया वै तथा कर्ममभिचारभयात्मकम् ।\nनाख्यातमिति जानन्तस्ते त्वामाहुस्तथा द्विज\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198516, "chapter_id": 5222, "verse_number": "११", "content_sanskrit": "ते चैव हि भवेयुस्ते लोकाः पापकृतो यथा ।\nकृत्वा नाचक्षतः कर्म मम यच्च त्वया कृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198517, "chapter_id": 5222, "verse_number": "१२", "content_sanskrit": "तथाऽशक्या च दुर्वृत्ता रक्षितुं प्रमदा द्विज ।\nन च त्वं कृतवान् किञ्चिदागः प्रीतोऽस्मि तेन ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198518, "chapter_id": 5222, "verse_number": "१३", "content_sanskrit": "मनोदोषविहीनानां न दोषः स्यात् तथा तव ।\nअन्यथाऽऽलिङ्ग्यते कान्ता स्नेहेन दुहिताऽन्यथा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198519, "chapter_id": 5222, "verse_number": "१४", "content_sanskrit": "यतेश्च कामुकानां च योषिद्रूपेऽन्यथा मतिः ।\nअशिक्षयैव मनसः प्रायो लोकस्तु वञ्च्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198520, "chapter_id": 5222, "verse_number": "१५", "content_sanskrit": "लालेत्युद्विजते लोको वक्त्रासव इति स्पृहा ।\nअबन्धायोग्यमनसामिति मन्त्रात्मदैवकम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198521, "chapter_id": 5222, "verse_number": "१६", "content_sanskrit": "न रागस्नेहलोभान्धं कर्मिणां तन्महाफलम् ।\nनिष्कषायो विशुद्धस्त्वं रुच्यावेशान्न दूषितः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198522, "chapter_id": 5222, "verse_number": "१७", "content_sanskrit": "यदि त्वहं त्वां दुर्वृत्तमद्राक्षं द्विजसत्तम ।\nशपेयं त्वामहं क्रोधान्न मेऽत्रास्ति विचारणा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198523, "chapter_id": 5222, "verse_number": "१८", "content_sanskrit": "सज्जन्ति पुरुषे नार्यः पुंसां सोऽर्थश्च पुष्कळः ।\nअन्यथा रक्षतः शापोऽभविष्यत् ते गतिश्च सा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198524, "chapter_id": 5222, "verse_number": "१९", "content_sanskrit": "रक्षिता सा त्वया पुत्र मम चापि निवेदिता ।\nअहं ते प्रीतिमांस्तात स्वस्ति स्वर्गं गमिष्यसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198525, "chapter_id": 5222, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198526, "chapter_id": 5222, "verse_number": "२०", "content_sanskrit": "इत्युक्त्वा विपुलं प्रीतो देवशर्मा महानृषिः ।\nमुमोद स्वर्गमास्थाय सहभार्यः सशिष्यकः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198527, "chapter_id": 5222, "verse_number": "२१", "content_sanskrit": "इदमाख्यातवांश्चापि ममाख्यानं महामुनिः ।\nमार्कण्डेयः पुरा राजन् गङ्गाकूले कथान्तरे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198528, "chapter_id": 5222, "verse_number": "२२", "content_sanskrit": "तस्माद् ब्रवीमि पार्थ त्वां स्त्रियः सर्वाः सदैव च ।\nउभयं दृश्यते तासु सततं साध्वसाधु च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198529, "chapter_id": 5222, "verse_number": "२३", "content_sanskrit": "स्त्रियः साध्व्यो महाभागाः सम्मता लोकमातरः ।\nधारयन्ति महीं राजन्निमां सवनकाननाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198530, "chapter_id": 5222, "verse_number": "२४", "content_sanskrit": "असाध्व्यश्चापि दुर्वृत्ताः कुलघ्न्यः पापनिश्चयाः ।\nविज्ञेया लक्षणैर्दुष्टैः स्वगात्रसहजैर्नृप\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198531, "chapter_id": 5222, "verse_number": "२५", "content_sanskrit": "एवमेतासु रक्षा वै शक्या कर्तुं महात्मभिः ।\nअन्यथा राजशार्दूल न शक्या रक्षितुं स्त्रियः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198532, "chapter_id": 5222, "verse_number": "२६", "content_sanskrit": "एता हि मनुजव्याघ्र तीक्ष्णास्तीक्ष्णपराक्रमाः ।\nनासामस्ति प्रियो नाम मैथुने सङ्गमे नृभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198533, "chapter_id": 5222, "verse_number": "२७", "content_sanskrit": "एताः कृत्याश्च कार्याश्च कृताश्च भरतर्षभ ।\nन चैकस्मिन् रमन्त्येताः पुरुषे पाण्डुनन्दन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198534, "chapter_id": 5222, "verse_number": "२८", "content_sanskrit": "नासु स्नेहो नृभिः कार्यस्तथैवेर्ष्या जनेश्वर ।\nखेदमास्थाय भुञ्जीत धर्ममास्थाय चैव हि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198535, "chapter_id": 5222, "verse_number": "२९", "content_sanskrit": "विहन्येतान्यथा कुर्वन् नरः कौरवनन्दन ।\nसर्वथा राजशार्दूल युक्तिः सर्वत्र पूज्यते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2198536, "chapter_id": 5222, "verse_number": "३०", "content_sanskrit": "तेनैकेन तु रक्षा वै विपुलेन कृता स्त्रियाः ।\nनान्यः शक्तो नृलोकेऽस्मिन् रक्षितुं नृप योषितः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2198537, "chapter_id": 5222, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे विपुलोपाख्यानसमाप्तिर्नाम त्रिसप्ततितमोऽध्यायः ॥७३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]