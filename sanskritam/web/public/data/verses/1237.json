[{"id": 2011553, "chapter_id": 1237, "verse_number": "१-२३८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011554, "chapter_id": 1237, "verse_number": "१-२३८-१", "content_sanskrit": "सोऽपरान्तेषु तीर्थानि पुण्यान्यायतनानि च।\nसर्वाण्येवानुपूर्व्येण जगामामितविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011555, "chapter_id": 1237, "verse_number": "१-२३८-२", "content_sanskrit": "समुद्रे पश्चिमे यानि तीर्थान्यायतनानि च।\nतानि सर्वाणि गत्वा स प्रभासमुपजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011556, "chapter_id": 1237, "verse_number": "१-२३८-३", "content_sanskrit": "चिन्तयामास रात्रौ तु गदेन कथितं पुरा।\nसुभद्रायाश्च माधुर्यरूपसंपद्गुणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011557, "chapter_id": 1237, "verse_number": "१-२३८-४", "content_sanskrit": "प्राप्तुमं तां चिन्तयामास कोऽत्रोपायो भवेदिति।\nवेषवैकृत्यमापन्नः परिव्राजकरूपधृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011558, "chapter_id": 1237, "verse_number": "१-२३८-५", "content_sanskrit": "कुकुरान्धकवृष्णीनामज्ञातो वेषधारणात्।\nभ्रममाणश्चरन्भैक्षं परिव्राजकवेषवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011559, "chapter_id": 1237, "verse_number": "१-२३८-६", "content_sanskrit": "येनकेनाप्युपायेन प्रविश्य च गृहं महत्।\nदृष्ट्वा सुभद्रां कृष्णस्य भगिनीमेकसुन्दरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011560, "chapter_id": 1237, "verse_number": "१-२३८-७", "content_sanskrit": "वासुदेवमतं ज्ञात्वा करिष्यामि हितं शुभम्।\nएवं विनिश्चयं कृत्वा दीक्षितो वै तदाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011561, "chapter_id": 1237, "verse_number": "१-२३८-८", "content_sanskrit": "त्रिदण्डी मुण्डितः कुण्डी अक्षमालाङ्गुलीयकः।\nयोगभारं वहन्पार्थो वटवृक्षस्य कोटरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011562, "chapter_id": 1237, "verse_number": "१-२३८-९", "content_sanskrit": "प्रविशंश्चैव बीभत्सुर्वृष्टिं वर्षति वासवे।\nचिन्तयामास देवेशं केशवं क्लेशनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011563, "chapter_id": 1237, "verse_number": "१-२३८-१०", "content_sanskrit": "केशवश्चिन्तितं ज्ञात्वा दिव्यज्ञानेन दृष्टवान्।\nशयानः शयने दिव्ये सत्यभामासहायवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011564, "chapter_id": 1237, "verse_number": "१-२३८-११", "content_sanskrit": "केशवः सहसा राजञ्जहाय च ननन्द च।\nपुनः पुनः सत्यभामा चाब्रवीत्पुरुषोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011565, "chapter_id": 1237, "verse_number": "१-२३८-१२", "content_sanskrit": "भगवंश्चिन्तयाविष्टः शयने शयितः सुखम्।\nभवान्बहुप्रकारेण जहास च पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011566, "chapter_id": 1237, "verse_number": "१-२३८-१३", "content_sanskrit": "श्रोतव्यं यदि वा कृष्ण प्रसादो यदि ते मयि।\nवक्तुमर्हसि देवेश तच्छ्रोतुं कामयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011567, "chapter_id": 1237, "verse_number": "१-२३८-१४x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011568, "chapter_id": 1237, "verse_number": "१-२३८-१४", "content_sanskrit": "पितृष्वसुर्यः पुत्रो मे भीमसेनानुजोऽर्जुनः।\nतीर्थयात्रां गतः पार्थः कारणात्समयात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011569, "chapter_id": 1237, "verse_number": "१-२३८-१५", "content_sanskrit": "तीर्थयात्रासमाप्तौ तु निवृत्तो निशि भारतः।\nसुभध्रां चिन्तयामास रूपेणाप्रतिमां भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011570, "chapter_id": 1237, "verse_number": "१-२३८-१६", "content_sanskrit": "चिन्तयेन्नेव तां भद्रां यतिरूपधरोऽर्जुनः।\nयतिरूपप्रतिच्छन्नो द्वारकां प्राप्य माधवीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011571, "chapter_id": 1237, "verse_number": "१-२३८-१७", "content_sanskrit": "येनकेनाप्युपायेन दृष्ट्वा तु वरवर्णिनीम्।\nवासुदेवमतं ज्ञात्वा प्रयतिष्ये मनोरथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011572, "chapter_id": 1237, "verse_number": "१-२३८-१८", "content_sanskrit": "एवं व्यवसितः पार्थो यतिलिङ्गेन पाण्डवः।\nछायायां वटवृक्षस्य वृष्टिं वर्षति वासवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011573, "chapter_id": 1237, "verse_number": "१-२३८-१९", "content_sanskrit": "योगभारं वहन्नेव मानसं दुःखमाप्तवान्।\nएतदर्थं विजानीहि हसन्तं मां मुदा प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011574, "chapter_id": 1237, "verse_number": "१-२३८-२०", "content_sanskrit": "भ्रातरं तव पश्येति सत्यभामां व्यसर्जयत्।\nतत उत्थाय शयनात्प्रस्थितो मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011575, "chapter_id": 1237, "verse_number": "१-२३८-२१", "content_sanskrit": "प्रभासदेशं संप्राप्तं बीभत्सुमपराजितम्।\nतीर्थान्यनुचरन्तं तं शुश्राव मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011576, "chapter_id": 1237, "verse_number": "१-२३८-२२", "content_sanskrit": "चाराणां चैव वचनादेकाकी स जनार्दनः।\nतत्राभ्यगच्छत्कौन्तेयं महात्मातं स माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011577, "chapter_id": 1237, "verse_number": "१-२३८-२३", "content_sanskrit": "ददृशाते तदान्योन्यं प्रभासे कृष्णपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011578, "chapter_id": 1237, "verse_number": "१-२३८-२४", "content_sanskrit": "तावन्योन्यं समाश्लिष्य पृष्ट्वा च कुशलं वने।\nआस्तां प्रियसखायौ तौ नरनारायणावृषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011579, "chapter_id": 1237, "verse_number": "१-२३८-२५", "content_sanskrit": "ततोऽर्जुनं वासुदेवस्तां चर्यां पर्यपृच्छत।\nकिमर्थं पाण्डवैतानि तीर्थान्यनुचरस्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011580, "chapter_id": 1237, "verse_number": "१-२३८-२६", "content_sanskrit": "ततोऽर्जनो यथावृत्तं सर्वमाख्यातवांस्तदा।\nश्रुत्वोवाच च वार्ष्णेय एवमेतदिति प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011581, "chapter_id": 1237, "verse_number": "१-२३८-२७", "content_sanskrit": "तौ विहृत्य यथाकामं प्रभासे कृष्णपाण्डवौ।\nमहीधरं रैवतकं वासायैवाभिजग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011582, "chapter_id": 1237, "verse_number": "१-२३८-२८", "content_sanskrit": "पूर्वमेव तु कृष्णस्य वचनात्तं महीधरम्।\nपुरुषा मण्डयाञ्चक्रुरुपजह्रश्च भोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011583, "chapter_id": 1237, "verse_number": "१-२३८-२९", "content_sanskrit": "प्रतिगृह्यार्जुनः सर्वमुपभुज्य च पाण्डवः।\nसहैव वासुदेवेन दृष्टवान्नटनर्तकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011584, "chapter_id": 1237, "verse_number": "१-२३८-३०", "content_sanskrit": "अभ्यनुज्ञाय तान्सर्वानर्चयित्वा च पाण्डवः।\nसत्कृतं शनं दिव्यमभ्यगच्छन्महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011585, "chapter_id": 1237, "verse_number": "१-२३८-३१", "content_sanskrit": "ततस्तत्र महाबाहुः शयानः शयने शुभे।\nतीर्थानां पल्वलानां च पर्वतानां च दर्शनम्।\nआपगानां वनानां च कथयामास सात्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011586, "chapter_id": 1237, "verse_number": "१-२३८-३२", "content_sanskrit": "एवं स कथयन्नेव निद्रया जनमेजय।\nकौन्तेयोऽपि हृतस्तस्मिञ्शयने स्वर्गसन्निभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011587, "chapter_id": 1237, "verse_number": "१-२३८-३३", "content_sanskrit": "मधुरेणैव गीतेन वीणाशब्देन चैव ह।\nप्रबोध्यमानो बुबुधे स्तुतिभिर्मङ्गलैस्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011588, "chapter_id": 1237, "verse_number": "१-२३८-३४", "content_sanskrit": "स कृत्वाऽवश्यकार्याणि वार्ष्णेयेनाभिनन्दितः।\nवार्ष्णेयं समनुज्ञाप्य तत्र वासमरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011589, "chapter_id": 1237, "verse_number": "१-२३८-३५", "content_sanskrit": "तथेत्युक्त्वा वासुदेवो भोजनं वै शशास ह।\nयतिरूपधरं पार्थं विसृज्य सहसा हरिः।\nरथेन काञ्चनाङ्गेन द्वारकामभिजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011590, "chapter_id": 1237, "verse_number": "१-२३८-३६", "content_sanskrit": "अलङ्कृता द्वारका तु बभूव जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011591, "chapter_id": 1237, "verse_number": "१-२३८-३७", "content_sanskrit": "दिदृक्षन्तश्च गोविन्दं द्वारकावासिनो जनाः।\nनरेन्द्रमार्गमाजग्मुस्तूर्णं शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011592, "chapter_id": 1237, "verse_number": "१-२३८-३८", "content_sanskrit": "क्षणार्धमपि वार्ष्णेया गोविन्दविरहाक्षमाः।\nकौतूहलसमाविष्टा भृशमुत्प्रेक्ष्य संस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011593, "chapter_id": 1237, "verse_number": "१-२३८-३९", "content_sanskrit": "अवलोकेषु नारीणां सहस्राणि शतानि च।\nभोजवृष्ण्यन्धकानां च समवायो महानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011594, "chapter_id": 1237, "verse_number": "१-२३८-४०", "content_sanskrit": "स तथा सत्कृतः सर्वैर्भोजवृष्ण्यन्धकात्मजैः।\nअभिवाद्याभिवाद्यांश्च सर्वैश्च प्रतिनन्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011595, "chapter_id": 1237, "verse_number": "१-२३८-४१", "content_sanskrit": "कुमारैः सर्वशो वीरः सत्कारेणाभिचोदितः।\nसमानवयसः सर्वानाश्लिष्य स पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011596, "chapter_id": 1237, "verse_number": "१-२३८-४२", "content_sanskrit": "कृष्णः स्वभवनं रम्यं प्रविवेश महाबलः।\nप्रभासादागतं देव्यः सर्वाः कृष्णमपूजयन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2011597, "chapter_id": 1237, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अर्जुनवनवासपर्वणि अष्टत्रिंशदधिकद्विशततमोऽध्यायः॥ २३८ ॥ ॥ समाप्तं चार्जुनवनवासपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]