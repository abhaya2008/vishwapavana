[{"id": 2051155, "chapter_id": 2125, "verse_number": "७-५२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051156, "chapter_id": 2125, "verse_number": "७-५२-१", "content_sanskrit": "एवं विलपमाने तु कुन्तीपुत्रे युधिष्ठिरे।\nकृष्णद्वैपायनस्तत्र आजगाम महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051157, "chapter_id": 2125, "verse_number": "७-५२-२", "content_sanskrit": "अथ दृष्ट्वा महात्मानं पाण्डुपुत्रो युधिष्ठिरः।\nयुक्तासनो दीनमनाः पूजां चक्रे महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051158, "chapter_id": 2125, "verse_number": "७-५२-३", "content_sanskrit": "अर्चयित्वा यथान्यायमुपविष्टं युधिष्ठिरः।\nअब्रवीच्छोकसन्तप्तो भ्रातुः पुत्रवधेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051159, "chapter_id": 2125, "verse_number": "७-५२-४", "content_sanskrit": "अधर्मयुक्तैर्बहुभिः परिवार्य महारथैः।\nयुध्यमानो महेष्वासैः सौभद्रो निहतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051160, "chapter_id": 2125, "verse_number": "७-५२-५", "content_sanskrit": "बालश्च बालबुद्धिश्च वीरश्च परवीरहा।\nअनुपायेन सङ्ग्रामे युध्यमानो विनाशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051161, "chapter_id": 2125, "verse_number": "७-५२-६", "content_sanskrit": "मया प्रोक्तः स सङ्ग्रामे द्वारं सञ्जनयस्व नः।\nप्रविष्टेऽभ्यन्तरे तस्मिन्सैन्धवेन निवारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051162, "chapter_id": 2125, "verse_number": "७-५२-७", "content_sanskrit": "ननु नाम समं युद्धमेष्टव्यं युद्धजीविभिः।\nइदं चैवासमं युद्धमीदृशं यत्कृतं परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051163, "chapter_id": 2125, "verse_number": "७-५२-८", "content_sanskrit": "तेनास्मि भृशसन्तप्तः शोकबाष्पसमाकुलः।\nशमं नैवाधिगच्छामि चिन्तयानः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051164, "chapter_id": 2125, "verse_number": "७-५२-९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051165, "chapter_id": 2125, "verse_number": "७-५२-९", "content_sanskrit": "तं तथा विलपन्तं वै शोकव्याकुलमानसम्।\nउवाच सान्त्वयन्व्यासो युधिष्ठिरमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051166, "chapter_id": 2125, "verse_number": "७-५२-१०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051167, "chapter_id": 2125, "verse_number": "७-५२-१०", "content_sanskrit": "युधिष्ठिर महाप्राज्ञ सर्वशास्त्रविशारद।\nव्यसनेषु न मुह्यन्ति त्वादृशा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051168, "chapter_id": 2125, "verse_number": "७-५२-११", "content_sanskrit": "स्वर्गमेष गतः शूरः शत्रून्हत्वा बहून्रणे।\nअबालसदृशं कर्म कृत्वा वै पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051169, "chapter_id": 2125, "verse_number": "७-५२-१२", "content_sanskrit": "अनतिक्रमणीयो वै विधिरेष युधिष्ठिर।\nदेवदानवगन्धर्वान्मूत्युर्हरति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2051170, "chapter_id": 2125, "verse_number": "७-५२-१३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2051171, "chapter_id": 2125, "verse_number": "७-५२-१३", "content_sanskrit": "इमे वै पृथिवीपालाः शेरते पृथिवीतले।\nनिहताः पृतनामध्ये मृतसंज्ञा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2051172, "chapter_id": 2125, "verse_number": "७-५२-१४", "content_sanskrit": "नागायुतबलाश्चान्ये वायुवेगबलास्तथा।\nत एते निहताः सङ्ख्ये तुल्यरूपा नरैर्नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2051173, "chapter_id": 2125, "verse_number": "७-५२-१५", "content_sanskrit": "नैषां पश्यामि हन्तारं प्राणिनां संयुगे क्वचित्।\nविक्रमेणोपसम्पन्नास्तपोबलसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2051174, "chapter_id": 2125, "verse_number": "७-५२-१६", "content_sanskrit": "जेतव्यमिति चान्योन्यं येषां नित्यं हृदि स्थितम्।\nअथ चेमे हताः प्राज्ञाः शेरते विगतायुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2051175, "chapter_id": 2125, "verse_number": "७-५२-१७", "content_sanskrit": "मृता इति च शब्दोयं वर्तते च ततोऽर्थवत्।\nइमे मृता महीपालाः प्रायशो भीमविक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2051176, "chapter_id": 2125, "verse_number": "७-५२-१८", "content_sanskrit": "निश्चेष्टा निरभीमानाः शूराः शत्रुवशंगताः।\nराजपुत्राश्च संरब्धा वैश्वानरमुखं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2051177, "chapter_id": 2125, "verse_number": "७-५२-१९", "content_sanskrit": "अत्र मे संशयः प्राप्तः कुतः संज्ञा मृता इति।\nकस्य मृत्युः कुतो मृत्युः केन मृत्युरिमाः प्रजाः।\nहरत्यमरसङ्काश तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2051178, "chapter_id": 2125, "verse_number": "७-५२-२०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2051179, "chapter_id": 2125, "verse_number": "७-५२-२०", "content_sanskrit": "तं तथा परिपृच्छन्तं कुन्तीपुत्रं युधिष्ठिरम्।\nआश्वासनमिदं वाक्यमुवाच भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2051180, "chapter_id": 2125, "verse_number": "७-५२-२१x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2051181, "chapter_id": 2125, "verse_number": "७-५२-२१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअकम्पनस्य कथितं नारदेन पुरा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2051182, "chapter_id": 2125, "verse_number": "७-५२-२२", "content_sanskrit": "स चापि राजा राजेन्द्र पुत्रव्यसनमुत्तमम्।\nअप्रसह्यतमं लोके प्राप्तवानिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2051183, "chapter_id": 2125, "verse_number": "७-५२-२३", "content_sanskrit": "तदहं सम्प्रवक्ष्यामि मृत्योः प्रभवमुत्तमम्।\nततस्त्वं मोक्ष्यसे दुःखात्स्नेहबन्धनसंश्रयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2051184, "chapter_id": 2125, "verse_number": "७-५२-२४", "content_sanskrit": "समस्तपापराशिघ्नं शृणु कीर्तयतो मम।\nधन्यमाख्यानमायुष्यं शोकघ्नं पुष्टिवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2051185, "chapter_id": 2125, "verse_number": "७-५२-२५", "content_sanskrit": "पवित्रमरिसङ्घघ्नं पङ्गलानां च मङ्गलम्।\nयथैव वेदाध्ययनमुपाख्यानमिदं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2051186, "chapter_id": 2125, "verse_number": "७-५२-२६", "content_sanskrit": "श्रवणीयं महाराज प्रातर्नित्यं नृपोत्तमैः।\nपुत्रानायुष्मतो राज्यमीहमानैः श्रियं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2051187, "chapter_id": 2125, "verse_number": "७-५२-२७", "content_sanskrit": "पुरा कृतयुगे तात आसीद्राजा ह्यकम्पनः।\nस शत्रुवशमापन्नो मध्ये सङ्ग्राममूर्धनि।\n`योधयामास बलवान्बद्धश्चासीदकम्पनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2051188, "chapter_id": 2125, "verse_number": "७-५२-२८", "content_sanskrit": "तस्य पुत्रो हरिर्नाम नारायणसमो बले।\nश्रीमान्कृतास्त्रो मेधावी युधि शक्रोपमो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2051189, "chapter_id": 2125, "verse_number": "७-५२-२९", "content_sanskrit": "`स दृष्ट्वा पितरं युद्धे तदवस्थं महाद्युतिः।\nअचिन्तयित्वा मरणं शत्रुमध्यं ततोऽविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2051190, "chapter_id": 2125, "verse_number": "७-५२-३०", "content_sanskrit": "स शत्रुभिः परिवृतो बहुधा रणमूर्धनि।\nयोधयामास तान्सर्वान्सर्वास्त्रकुशलो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2051191, "chapter_id": 2125, "verse_number": "७-५२-३१", "content_sanskrit": "वर्षन्बाणसहस्राणि शत्रुष्वमितविक्रमः।\nपदातिरथनागाश्वान्प्रममाथ महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2051192, "chapter_id": 2125, "verse_number": "७-५२-३२", "content_sanskrit": "स शरैराचितश्चक्रैर्गदाभिर्मुसलैरपि।\nमृद्गन्रथसहस्राणि पदातीन्वाजिवारणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2051193, "chapter_id": 2125, "verse_number": "७-५२-३३", "content_sanskrit": "परानीकं विभिद्याजौ मोक्षयित्वा च तं नृपम्।\nपुनरेवाकरोद्युद्धं शत्रुमध्यगतो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2051194, "chapter_id": 2125, "verse_number": "७-५२-३४", "content_sanskrit": "ततस्ते रथिनः सर्वे समेत्य पुनराहवे।\nजघ्नुस्तं परिवार्यैकं तोमरैरिव कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2051195, "chapter_id": 2125, "verse_number": "७-५२-३५", "content_sanskrit": "स कर्म दुष्करं कृत्वा सङ्ग्रामे शत्रुतापनः।\nशत्रुभिर्निहतः सङ्ख्ये पृतानायां युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2051196, "chapter_id": 2125, "verse_number": "७-५२-३६", "content_sanskrit": "द्विषद्भिर्निहतं दृष्ट्वा प्रियं पुत्रमकम्पनः।\nअमर्षजनितक्रोध आहवात्सहसाऽऽगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2051197, "chapter_id": 2125, "verse_number": "७-५२-३७", "content_sanskrit": "स राजा प्रेतकृत्यानि तस्य कृत्वा शुचान्वितः।\nशोचन्नहनि रात्रौ च नालभत्सुखमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2051198, "chapter_id": 2125, "verse_number": "७-५२-३८", "content_sanskrit": "तस्य शोकं विदित्वा तु पुत्रव्यसनसम्भवम्।\nआजगामाथ देवर्षिर्नारदोऽस्य समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2051199, "chapter_id": 2125, "verse_number": "७-५२-३९", "content_sanskrit": "स तु राजा महाभागो दृष्ट्वा देवर्षिसत्तमम्।\nपूजयित्वा यथान्यायं कथामकथयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2051200, "chapter_id": 2125, "verse_number": "७-५२-४०", "content_sanskrit": "तस्य सर्वं समाचष्ट यथावृत्तं युधिष्ठिर।\nशत्रुभिर्विजयं सङ्ख्ये पुत्रस्य च वधं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2051201, "chapter_id": 2125, "verse_number": "७-५२-४१x", "content_sanskrit": "अकम्पन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2051202, "chapter_id": 2125, "verse_number": "७-५२-४१", "content_sanskrit": "मम पुत्रो महावीर्य इन्द्रविष्णुसमद्युतिः।\nशत्रुभिर्बहुभिः सङ्ख्ये पराक्रम्य हतो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2051203, "chapter_id": 2125, "verse_number": "७-५२-४२", "content_sanskrit": "शृणु मे प्राणिनां चापि मृत्युः प्रभवते किल।\nक एष मृत्युर्भगवन्किंवीर्यबलपौरुषः।\nएतदिच्छामि तत्त्वेन श्रोतुं मतिमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2051204, "chapter_id": 2125, "verse_number": "७-५२-४३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2051205, "chapter_id": 2125, "verse_number": "७-५२-४३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा नारदो वरदः प्रभुः।\nआख्यानमिदमाचष्ट पुत्रशोकापहं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2051206, "chapter_id": 2125, "verse_number": "७-५२-४४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2051207, "chapter_id": 2125, "verse_number": "७-५२-४४", "content_sanskrit": "शृणु राजन्महाबाहो आख्यानं बहुविस्तरम्।\nयथावृत्तं श्रुतं चैव मयाऽपि वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2051208, "chapter_id": 2125, "verse_number": "७-५२-४५", "content_sanskrit": "प्रजाः सृष्टा तदा ब्रह्मा आदिसर्गे पितामहः।\nअसंहृतं महातेजा दृष्ट्वा जगदिदं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2051209, "chapter_id": 2125, "verse_number": "७-५२-४६", "content_sanskrit": "तस्य चिन्ता समुत्पन्ना संहारं प्रति पार्थिव।\nचिन्तयन्न ह्यसौ देव संहारं वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2051210, "chapter_id": 2125, "verse_number": "७-५२-४७", "content_sanskrit": "तस्य रोषान्महाराज मुखेभ्योऽग्निरजायत।\nतेन सर्वा दिशो व्याप्ताः सान्तर्देशा दिधक्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2051211, "chapter_id": 2125, "verse_number": "७-५२-४८", "content_sanskrit": "ततो दिवं भुवं चैव ज्वालामालासमाकुलम्।\nचारचरं जगत्सर्वं ददाह भगवान्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2051212, "chapter_id": 2125, "verse_number": "७-५२-४९", "content_sanskrit": "ततो हतानि भूतानि चराणि स्थावराणि च।\nमहता क्रोधवेगेन त्रासयन्निव वीर्यवान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2051213, "chapter_id": 2125, "verse_number": "७-५२-५०", "content_sanskrit": "ततो रुद्रो जटी स्याणुर्निशाचरपतिर्हरः।\nजगाम शरणं देवं ब्रह्माणं परमेष्ठिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2051214, "chapter_id": 2125, "verse_number": "७-५२-५१", "content_sanskrit": "तस्मिन्नापतिते स्थाणौ प्रजानां हितकाम्यया।\nअब्रवीत्परमो देवो ज्वलन्निव महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2051215, "chapter_id": 2125, "verse_number": "७-५२-५२", "content_sanskrit": "किं कर्म कामं कामार्ह कामाज्जातोऽसि पुत्रक।\nकरिष्यामि प्रियं सर्वं ब्रूहि स्थाणो यदिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2051216, "chapter_id": 2125, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि द्विपञ्चाशत्तमोऽध्यायः॥ ५२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-५२-६ द्वारं सञ्जनयस्वेति मया उक्त इति सम्बन्धः। निवारितः तमनुप्रविशन्त इति शेषः॥ ५-५२-१९ कस्य मृत्युः क इति शेषः॥ ५-५२-४७ खेभ्य इति पाठे श्रोत्रादिच्छिद्रेभ्यः॥ ५-५२-५२ द्विपञ्चाशत्तमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]