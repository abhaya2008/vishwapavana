[{"id": 40018788, "chapter_id": 9295, "verse_number": "1", "content_sanskrit": "ततोयुद्धपरिश्रान्तंसमरेचिन्तयास्थितम् । रावणंचाग्रतोदृष्टवायुद्धायसमुपस्थितम् ॥ दैवतैश्चसमागम्यद्रष्टुमभ्यागतोरणम् । उपागम्याब्रवीद्राममगस्त्योभगवान् ऋषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018789, "chapter_id": 9295, "verse_number": "2", "content_sanskrit": "ततोयुद्धपरिश्रान्तंसमरेचिन्तयास्थितम् । रावणंचाग्रतोदृष्टवायुद्धायसमुपस्थितम् ॥ दैवतैश्चसमागम्यद्रष्टुमभ्यागतोरणम् । उपागम्याब्रवीद्राममगस्त्योभगवान् ऋषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018790, "chapter_id": 9295, "verse_number": "3", "content_sanskrit": "राम राम महाबाहो शृणुगुह्यंसनातनम् । येनसर्वानरीस्वत्ससमरेविजयिष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018791, "chapter_id": 9295, "verse_number": "4", "content_sanskrit": "आदित्यहृदयंपुण्यंसर्वशत्रुविनाशनम् । जयावहंजपेन्नित्यमक्षय्यंपरमंशिवम् ॥ सर्वमङ्गलमङ्गल्यंसर्वपापप्रणाशनम् । चिन्ताशोकप्रशमनमायुर्वर्धनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018792, "chapter_id": 9295, "verse_number": "5", "content_sanskrit": "आदित्यहृदयंपुण्यंसर्वशत्रुविनाशनम् । जयावहंजपेन्नित्यमक्षय्यंपरमंशिवम् ॥ सर्वमङ्गलमङ्गल्यंसर्वपापप्रणाशनम् । चिन्ताशोकप्रशमनमायुर्वर्धनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018793, "chapter_id": 9295, "verse_number": "6", "content_sanskrit": "रस्मीमन्तंसमुद्यन्तंदेवासुरनमस्कृतम् । पूजयस्वविवस्त्वन्तंभास्करंभुवनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018794, "chapter_id": 9295, "verse_number": "7", "content_sanskrit": "सर्वदेवात्मकोह्येषतेजस्वीरस्मीभावनः । एषदेवासुरगणान्लोकान्पातिगभस्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018795, "chapter_id": 9295, "verse_number": "8", "content_sanskrit": "एषब्रह्मा च विष्णुश्चशिवःस्कन्धःप्रजापतिः । महेन्द्रोधनदःकालोयमःसोमोह्यपांपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018796, "chapter_id": 9295, "verse_number": "9", "content_sanskrit": "पितरोवसवस्साध्याअश्विनौमरुतोमनुः । वायुर्वह्निःप्रजाःप्राणऋतुकर्ताप्रभाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018797, "chapter_id": 9295, "verse_number": "10", "content_sanskrit": "आदित्यःसवितासूर्यःखगःपूषागभस्तिमान् । सुवर्णसदृशोभानुर्हिरण्यरेतादिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018798, "chapter_id": 9295, "verse_number": "11", "content_sanskrit": "हरिदश्वस्सहस्रार्चिस्सप्तसप्तिर्मरीचिमान् । तिमिरोन्मथनश्शम्भुस्त्वष्टामार्तण्डकोऽंशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018799, "chapter_id": 9295, "verse_number": "12", "content_sanskrit": "हिरण्यगर्भश्शिशिरस्तपनोभास्करोरविः । अग्निगर्भोऽदितेःपुत्रःशङ्घश्शिशिरनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018800, "chapter_id": 9295, "verse_number": "13", "content_sanskrit": "व्योमनाथस्तमोभेदीऋग्यजुस्सामपारगः । घनवृष्टिरपांमित्रोविन्ध्यवीथीप्लवङ्गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018801, "chapter_id": 9295, "verse_number": "14", "content_sanskrit": "आतपीमण्डलेमृत्युःपिङ्गलस्सर्वतापनः । कविर्विश्वोमहातेजारक्तस्सर्वभवोद्भव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018802, "chapter_id": 9295, "verse_number": "15", "content_sanskrit": "नक्षत्रग्रहताराणामधिपोविश्वभावनः । तेजसामपितेजस्वीद्वादशात्मन्नमोऽस्तुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018803, "chapter_id": 9295, "verse_number": "16", "content_sanskrit": "नमःपूर्वायगिरयेपश्चिमायाद्रयेनमः । ज्योतिर्गणानांपतयेदिनाधिपतयेनमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018804, "chapter_id": 9295, "verse_number": "17", "content_sanskrit": "जयायजयभद्रायहर्यश्वायनमोनमः । नमोनमस्सहस्रांशोआदित्यायनमोनमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018805, "chapter_id": 9295, "verse_number": "18", "content_sanskrit": "नमउग्रायवीरायसारङ्गायनमोनमः । नमःपद्मप्रबोधायमार्ताण्डायनमोऽस्तुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018806, "chapter_id": 9295, "verse_number": "19", "content_sanskrit": "ब्रह्मेशानाच्युतेशायसूर्यायादित्यवर्चसे । भास्वतेसर्वभक्षायरौद्रायवपुषेनमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018807, "chapter_id": 9295, "verse_number": "20", "content_sanskrit": "तमोघ्नायहिमघ्नायशत्रुघ्नायामितात्मने । कृतघ्नघ्नायदेवायज्योतिषांपतयेनमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018808, "chapter_id": 9295, "verse_number": "21", "content_sanskrit": "तप्तचामीकराभायहरयेविश्मकर्मणे । नमस्तमोभिनिघ्नायरुचयेलोकसाक्षिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018809, "chapter_id": 9295, "verse_number": "22", "content_sanskrit": "नाशयत्येषवैभूतंतदेवसृजतिप्रभुः । पायत्येषतपत्येषवर्षत्येष गभस्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018810, "chapter_id": 9295, "verse_number": "23", "content_sanskrit": "एषसुप्तेषुजागर्तिभूतेषुपरिनिष्ठितः । एषचैवाग्निहोत्रं च फलंचैवाग्निहोत्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018811, "chapter_id": 9295, "verse_number": "24", "content_sanskrit": "वेदश्चक्रतवश्चैवक्रतूनांफलमेव च । यानिकृत्यानिलोकेषुसर्वेषुपरमप्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018812, "chapter_id": 9295, "verse_number": "25", "content_sanskrit": "एनमापत्सुकृच्छ्रेषुकान्तारेषुभयेषु च । कीर्तयन्पुरुषःकश्चिनावसीदतिराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018813, "chapter_id": 9295, "verse_number": "26", "content_sanskrit": "पूजयस्वैनमेकाग्रोदेवदेवंजगत्पतिम् । एतत्त्रिगुणितंजप्त्वायुद्धेषुविजयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018814, "chapter_id": 9295, "verse_number": "27", "content_sanskrit": "अस्मिन् क्षणेमहाबाहोरावणंत्वंवधिष्यसि । एवमुक्त्वाततोऽगस्त्योजगाम स यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018815, "chapter_id": 9295, "verse_number": "28", "content_sanskrit": "एतच्छ्रुत्वामहातेजानष्टशोकोऽभवत्तदा । धारयामाससुप्रीतोराघवःप्रयतात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018816, "chapter_id": 9295, "verse_number": "29", "content_sanskrit": "आदित्यंप्रेक्ष्यजप्त्वातुपरंहर्षमवाप्तवान् । त्रिराचम्यशुचिर्भूत्वाधनुरादायवीर्यवान् ॥ रावणंप्रेक्ष्यहृष्टात्मायुद्धार्थंसमुपागमत् । सर्वयत्नेनमहतावधेतस्यधृतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018817, "chapter_id": 9295, "verse_number": "30", "content_sanskrit": "आदित्यंप्रेक्ष्यजप्त्वातुपरंहर्षमवाप्तवान् । त्रिराचम्यशुचिर्भूत्वाधनुरादायवीर्यवान् ॥ रावणंप्रेक्ष्यहृष्टात्मायुद्धार्थंसमुपागमत् । सर्वयत्नेनमहतावधेतस्यधृतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]