[{"id": 5000295000, "chapter_id": 9295, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000295001, "chapter_id": 9295, "verse_number": "४-२३-१", "content_sanskrit": "ततः समुपजिघ्रन्ती कपिराजस्य तन्मुखम्।\nपतिं लोकश्रुता तारा मृतं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000295002, "chapter_id": 9295, "verse_number": "४-२३-२", "content_sanskrit": "शेषे त्वं विषमे दुःखमकृत्वा वचनं मम।\nउपलोपचिते वीर सुदुःखे वसुधातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000295003, "chapter_id": 9295, "verse_number": "४-२३-३", "content_sanskrit": "मत्तः प्रियतरा नूनं वानरेन्द्र मही तव।\nशेषे हि तां परिष्वज्य मां च न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000295004, "chapter_id": 9295, "verse_number": "४-२३-४", "content_sanskrit": "सुग्रीवस्य वशं प्राप्तो विधिरेष भवत्यहो।\nसुग्रीव एव विक्रान्तो वीर साहसिकप्रिय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000295005, "chapter_id": 9295, "verse_number": "४-२३-५", "content_sanskrit": "ऋक्षवानरमुख्यास्त्वां बलिनं पर्युपासते।\nतेषां विलपितं कृच्छ्रमङ्गदस्य च शोचतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000295006, "chapter_id": 9295, "verse_number": "४-२३-६", "content_sanskrit": "मम चेमा गिरः श्रुत्वा किं त्वं न प्रतिबुध्यसे।\nइदं तद् वीरशयनं तत्र शेषे हतो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000295007, "chapter_id": 9295, "verse_number": "४-२३-७", "content_sanskrit": "शायिता निहता यत्र त्वयैव रिपवः पुरा।\nविशुद्धसत्त्वाभिजन प्रिययुद्ध मम प्रिय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000295008, "chapter_id": 9295, "verse_number": "४-२३-८", "content_sanskrit": "मामनाथां विहायैकां गतस्त्वमसि मानद।\nशूराय न प्रदातव्या कन्या खलु विपश्चिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000295009, "chapter_id": 9295, "verse_number": "४-२३-९", "content_sanskrit": "शूरभार्यां हतां पश्य सद्यो मां विधवां कृताम्।\nअवभग्नश्च मे मानो भग्ना मे शाश्वती गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000295010, "chapter_id": 9295, "verse_number": "४-२३-१०", "content_sanskrit": "अगाधे च निमग्नास्मि विपुले शोकसागरे।\nअश्मसारमयं नूनमिदं मे हृदयं दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000295011, "chapter_id": 9295, "verse_number": "४-२३-११", "content_sanskrit": "भर्तारं निहतं दृष्ट्वा यन्नाद्य शतधा कृतम्।\nसुहृच्चैव च भर्ता च प्रकृत्या च मम प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000295012, "chapter_id": 9295, "verse_number": "४-२३-१२", "content_sanskrit": "प्रहारे च पराक्रान्तः शूरः पञ्चत्वमागतः।\nपतिहीना तु या नारी कामं भवतु पुत्रिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000295013, "chapter_id": 9295, "verse_number": "४-२३-१३", "content_sanskrit": "धनधान्यसमृद्धापि विधवेत्युच्यते जनैः।\nस्वगात्रप्रभवे वीर शेषे रुधिरमण्डले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000295014, "chapter_id": 9295, "verse_number": "४-२३-१४", "content_sanskrit": "कृमिरागपरिस्तोमे स्वकीये शयने यथा।\nरेणुशोणितसंवीतं गात्रं तव समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000295015, "chapter_id": 9295, "verse_number": "४-२३-१५", "content_sanskrit": "परिरब्धुं न शक्नोमि भुजाभ्यां प्लवगर्षभ।\nकृतकृत्योऽद्य सुग्रीवो वैरेऽस्मिन्नतिदारुणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000295016, "chapter_id": 9295, "verse_number": "४-२३-१६", "content_sanskrit": "यस्य रामविमुक्तेन हृतमेकेषुणा भयम्।\nशरेण हृदि लग्नेन गात्रसंस्पर्शने तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000295017, "chapter_id": 9295, "verse_number": "४-२३-१७", "content_sanskrit": "वार्यामि त्वां निरीक्षन्ती त्वयि पञ्चत्वमागते।\nउद्बबर्ह शरं नीलस्तस्य गात्रगतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000295018, "chapter_id": 9295, "verse_number": "४-२३-१८", "content_sanskrit": "गिरिगह्वरसंलीनं दीप्तमाशीविषं यथा।\nतस्य निष्कृष्यमाणस्य बाणस्यापि बभौ द्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000295019, "chapter_id": 9295, "verse_number": "४-२३-१९", "content_sanskrit": "अस्तमस्तकसंरुद्धरश्मेर्दिनकरादिव।\nपेतुः क्षतजधारास्तु व्रणेभ्यस्तस्य सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000295020, "chapter_id": 9295, "verse_number": "४-२३-२०", "content_sanskrit": "ताम्रगैरिकसम्पृक्ता धारा इव धराधरात्।\nअवकीर्णं विमार्जन्ती भर्तारं रणरेणुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000295021, "chapter_id": 9295, "verse_number": "४-२३-२१", "content_sanskrit": "अस्रैर्नयनजैः शूरं सिषेचास्त्रसमाहतम्।\nरुधिरोक्षितसर्वाङ्गं दृष्ट्वा विनिहतं पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000295022, "chapter_id": 9295, "verse_number": "४-२३-२२", "content_sanskrit": "उवाच तारा पिङ्गाक्षं पुत्रमङ्गदमङ्गना।\nअवस्थां पश्चिमां पश्य पितुः पुत्र सुदारुणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000295023, "chapter_id": 9295, "verse_number": "४-२३-२३", "content_sanskrit": "सम्प्रसक्तस्य वैरस्य गतोऽन्तः पापकर्मणा।\nबालसूर्योज्ज्वलतनुं प्रयातं यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000295024, "chapter_id": 9295, "verse_number": "४-२३-२४", "content_sanskrit": "अभिवादय राजानं पितरं पुत्र मानदम्।\nएवमुक्तः समुत्थाय जग्राह चरणौ पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000295025, "chapter_id": 9295, "verse_number": "४-२३-२५", "content_sanskrit": "भुजाभ्यां पीनवृत्ताभ्यामङ्गदोऽहमिति ब्रुवन्।\nअभिवादयमानं त्वामङ्गदं त्वं यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000295026, "chapter_id": 9295, "verse_number": "४-२३-२६", "content_sanskrit": "दीर्घायुर्भव पुत्रेति किमर्थं नाभिभाषसे।\nअहं पुत्रसहाया त्वामुपासे गतचेतनम्।\nसिंहेन पातितं सद्यो गौः सवत्सेव गोवृषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000295027, "chapter_id": 9295, "verse_number": "४-२३-२७", "content_sanskrit": "इष्ट्वा संग्रामयज्ञेन रामप्रहरणाम्भसा।\nतस्मन्नवभृथे स्नातः कथं पत्न्या मया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000295028, "chapter_id": 9295, "verse_number": "४-२३-२८", "content_sanskrit": "या दत्ता देवराजेन तव तुष्टेन संयुगे।\nशातकौम्भीं प्रियां मालां तां ते पश्यामि नेह किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000295029, "chapter_id": 9295, "verse_number": "४-२३-२९", "content_sanskrit": "राज्यश्रीर्न जहाति त्वां गतासुमपि मानद।\nसूर्यस्यावर्तमानस्य शैलराजमिव प्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000295030, "chapter_id": 9295, "verse_number": "४-२३-३०", "content_sanskrit": "न मे वचः पथ्यमिदं त्वया कृतं\nन चास्मि शक्ता हि निवारणे तव।\nहता सपुत्रास्मि हतेन संयुगे\nसह त्वया श्रीर्विजहाति मामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000295031, "chapter_id": 9295, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]