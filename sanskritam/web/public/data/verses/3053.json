[{"id": 2096115, "chapter_id": 3053, "verse_number": "१३-१८३-१", "content_sanskrit": "भीष्म उवाच।\nएवमुक्तः प्रत्युवाच मैत्रेयः कर्मपूर्वकः।\nअत्यन्तं श्रीमति कुले जातः प्राज्ञो बहुश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096116, "chapter_id": 3053, "verse_number": "१३-१८३-२", "content_sanskrit": "असंशयं महाप्राज्ञ यथैवात्थ तथैव तत्।\nअनुज्ञातश्च भवता किञ्चिद्ब्रूयामहं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096117, "chapter_id": 3053, "verse_number": "१३-१८३-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096118, "chapter_id": 3053, "verse_number": "१३-१८३-३", "content_sanskrit": "यद्यदिच्छसि मैत्रेय यावद्यावद्यथायथा।\nब्रूहि तत्वं महाप्राज्ञ शुश्रुषे वचनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096119, "chapter_id": 3053, "verse_number": "१३-१८३-४x", "content_sanskrit": "मैत्रेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096120, "chapter_id": 3053, "verse_number": "१३-१८३-४", "content_sanskrit": "निर्दोषं निर्मलं चैव वचनं सत्यसंहितम्।\nविद्यातपोभ्यां हि भवान्भावितात्मा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096121, "chapter_id": 3053, "verse_number": "१३-१८३-५", "content_sanskrit": "भवतो भावितात्मत्वाल्लाभोऽयं सुमहान्मम।\nभूयो बुद्ध्याऽनुपश्यामि सुसमृद्धतपा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096122, "chapter_id": 3053, "verse_number": "१३-१८३-६", "content_sanskrit": "अपि मे दर्शनादेव भवतोऽभ्युदयो महान्।\nमन्ये भवत्प्रसादोऽयं बुद्धिकर्मस्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096123, "chapter_id": 3053, "verse_number": "१३-१८३-७", "content_sanskrit": "तपः श्रुतं च योनिश्चाप्येतद्ब्राह्मण्यकारणम्।\nत्रिभिर्गुणैः समुदितः स्नातो भवति वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096124, "chapter_id": 3053, "verse_number": "१३-१८३-८", "content_sanskrit": "अस्मिंस्तृप्ते च तृप्यन्ति पितरो दैवतानि च।\nन हि श्रुतवतां किञ्चिदधिकं ब्राह्मणादृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096125, "chapter_id": 3053, "verse_number": "१३-१८३-९", "content_sanskrit": "`असंस्कारात्क्षत्रवैश्यौ नश्येते ब्राह्मणादृते।\nशूद्रो नश्यत्यशुश्रूषुराश्रमाणां यथार्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096126, "chapter_id": 3053, "verse_number": "१३-१८३-१०", "content_sanskrit": "[अन्धं स्यात्तम एवेदं न प्रज्ञायेत किञ्चन।\nचातुर्वर्ण्यं न वर्तेत धर्माधर्मावृतानृते॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096127, "chapter_id": 3053, "verse_number": "१३-१८३-११", "content_sanskrit": "यथाहि सुकृते क्षेत्रे फलं विन्दति मानवः।\nएवं दत्त्वा श्रुतवते फलं दाता समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096128, "chapter_id": 3053, "verse_number": "१३-१८३-१२", "content_sanskrit": "ब्राह्मणश्चेन्न विन्देत श्रुतवृत्तोपसंहितः।\nप्रतिग्रहीता दानस्य मोघं स्याद्धनिनां धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096129, "chapter_id": 3053, "verse_number": "१३-१८३-१३", "content_sanskrit": "अन्नं ह्यविद्वान्हन्त्येवमविद्वांसं च हन्ति तत्।\nतच्चान्यं हन्ति यच्चान्यत्स भुक्त्वा हन्यतेऽबुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096130, "chapter_id": 3053, "verse_number": "१३-१८३-१४", "content_sanskrit": "प्राहुर्ह्यन्नमदन्विद्वान्पुनर्जनयतीश्वरः।\nस चान्नाज्जायते तस्मात्सूक्ष्म एष व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096131, "chapter_id": 3053, "verse_number": "१३-१८३-१५", "content_sanskrit": "`ब्राह्मं ह्यनुपयोगी यो ददंश्चान्नमसंशयम्।\nयस्तारयति वै विद्वान्पितॄन्देवान्सदाऽमृतान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096132, "chapter_id": 3053, "verse_number": "१३-१८३-१६", "content_sanskrit": "यदेव ददतः पुण्यं तदेव प्रतिगृह्णतः।\nन ह्येकचक्रं वर्तेत इत्येवमृषयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096133, "chapter_id": 3053, "verse_number": "१३-१८३-१७", "content_sanskrit": "यत्र वै ब्राह्मणाः सन्ति श्रुतवृत्तोपसंहिताः।\nतत्र दानफलं पुण्यमिह चामुत्र चाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096134, "chapter_id": 3053, "verse_number": "१३-१८३-१८", "content_sanskrit": "ये योनिशुद्धाः सततं तपस्यभिरता भृशम्।\nदानाध्ययनसम्पन्नास्ते वै पूज्यतमाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096135, "chapter_id": 3053, "verse_number": "१३-१८३-१९", "content_sanskrit": "तैर्हि सद्भिः कृतः पन्था देवयानो न मुह्यते।\nते हि स्वर्गस्य नेतारो यज्ञवाहाः सनातनाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096136, "chapter_id": 3053, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्र्यशीत्यधिकशततमोऽध्यायः॥ १८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]