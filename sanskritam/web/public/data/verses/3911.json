[{"id": 2134719, "chapter_id": 3911, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134720, "chapter_id": 3911, "verse_number": "१", "content_sanskrit": "ततस्ते सहिताः सर्वे दुर्योधनमुपागमन् ।\nअब्रुवंश्च महाराज यदूचुः कौरवं प्रति \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134721, "chapter_id": 3911, "verse_number": "२", "content_sanskrit": "गन्धर्वैर्वारिते सैन्ये धार्तराष्ट्रः प्रतापवान् ।\nअमर्षपूर्णः सैन्यानि प्रत्यभाषत भारत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134722, "chapter_id": 3911, "verse_number": "३", "content_sanskrit": "शासतैनानधर्मज्ञान् मम विप्रियकारिणः ।\nयदि प्रक्रीडते सर्वैर्देवैः सह शतक्रतुः ।\nवयमत्र यथाप्रीताः क्रीडिष्यामो निरन्तरम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134723, "chapter_id": 3911, "verse_number": "४", "content_sanskrit": "दुर्योधनवचः श्रुत्वा धार्तराष्ट्रा महाबलाः ।\nसर्व एवाभिसन्नद्धा योधाश्चापि सहस्रशः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134724, "chapter_id": 3911, "verse_number": "५", "content_sanskrit": "ततः प्रमथ्य सर्वांस्तांस्तद्वनं विविशुर्बलात् ।\nसिंहनादेन महता पूरयन्तो दिशो दश \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134725, "chapter_id": 3911, "verse_number": "६", "content_sanskrit": "ततोऽपरैरवार्यन्त गन्धर्वैः कुरुसैनिकाः ।\nसाम्नैव तत्र विक्रान्ता मा साहसमिति प्रभो \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134726, "chapter_id": 3911, "verse_number": "७", "content_sanskrit": "ते वार्यमाणा गन्धर्वैः साम्नैव वसुधाधिप ।\nताननादृत्य गन्धर्वांस्तद्वनं विविशुर्महत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134727, "chapter_id": 3911, "verse_number": "८", "content_sanskrit": "यदा वाचा न तिष्ठन्ति धार्तराष्ट्राः सराजकाः ।\nततस्ते खेचराः सर्वे चित्रसेने न्यवेदयन् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134728, "chapter_id": 3911, "verse_number": "९", "content_sanskrit": "गन्धर्वराजस्तान् सर्वानब्रवीत् कौरवान् प्रति ।\nअनार्याञ्छासतेत्येतांश्चित्रसेनोऽत्यमर्षणः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134729, "chapter_id": 3911, "verse_number": "१०", "content_sanskrit": "अनुज्ञातास्तु गन्धर्वाश्चित्रसेनेन भारत ।\nप्रगृहीतायुधाः सर्वे धार्तराष्ट्रानुपाद्रवन् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134730, "chapter_id": 3911, "verse_number": "११", "content_sanskrit": "तान् दृष्ट्वा पततः शीघ्रान् गन्धर्वानुद्यतायुधान् ।\nप्राद्रवंस्ते दिशः सर्वे धार्तराष्ट्रस्य पश्यतः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134731, "chapter_id": 3911, "verse_number": "१२", "content_sanskrit": "तान् दृष्ट्वा द्रवतः सर्वान् धार्तराष्ट्रान् पराङ्मुखान् ।\nराधेयस्तु तदा वीरो नासीत् तत्र पराङ्मुखः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134732, "chapter_id": 3911, "verse_number": "१३", "content_sanskrit": "आपतन्तीं तु सम्प्रेक्ष्य गन्धर्वाणां महाचमूम् ।\nमहता शरवर्षेण राधेयः समवारयत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134733, "chapter_id": 3911, "verse_number": "१४", "content_sanskrit": "क्षुरप्रैर्निशितैर्भल्लैर्वत्सदन्तैस्तदाऽऽयसैः ।\nगन्धर्वाञ्छतशोऽभ्यघ्नँल्लघुत्वात् सूतनन्दनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134734, "chapter_id": 3911, "verse_number": "१५", "content_sanskrit": "पातयन्नुत्तमाङ्गानि गन्धर्वाणां महारथः ।\nक्षणेन व्यधमत् सर्वां चित्रसेनस्य वाहिनीम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134735, "chapter_id": 3911, "verse_number": "१६", "content_sanskrit": "ते वध्यमाना गन्धर्वाः सूतपुत्रेण धीमता ।\nभूय एवाभिवर्तन्त शतशोऽथ सहस्रशः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134736, "chapter_id": 3911, "verse_number": "१७", "content_sanskrit": "गन्धर्वभूता पृथिवी क्षणेन समपद्यत।\nआपतद्भिर्महावेगैश्चित्रसेनस्य सैनिकैः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134737, "chapter_id": 3911, "verse_number": "१८", "content_sanskrit": "अथ दुर्योधनो राजा शकुनिश्चापि सौबलः ।\nदुःशासनो विकर्णश्च ये चान्ये धृतराष्ट्रजाः ।\nन्यहनंस्तत् तदा सैन्यं रथैर्गरुडनिस्वनैः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134738, "chapter_id": 3911, "verse_number": "१९", "content_sanskrit": "भूयश्च योधयामासुः कृत्वा कर्णमथाग्रतः ।\nमहता रथसङ्घेन हयचारेण चाप्युत \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134739, "chapter_id": 3911, "verse_number": "२०", "content_sanskrit": "वैकर्तनं परीप्सन्तो गन्धर्वान् समवाकिरन् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134740, "chapter_id": 3911, "verse_number": "२१", "content_sanskrit": "ततः सन्न्यपतन् सर्वे गन्धर्वाः कौरवैः सह ।\nतदा सुतुमुलं युद्धमुभयोर्लोमहर्षणम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134741, "chapter_id": 3911, "verse_number": "२२", "content_sanskrit": "ततस्ते मृदवोऽभूवन् गन्धर्वाः शरपीडिताः ।\nउच्चुक्रुशुश्च कौरव्या गन्धर्वान् प्रेक्ष्य पीडितान् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134742, "chapter_id": 3911, "verse_number": "२३", "content_sanskrit": "गन्धर्वांस्त्रासितान् दृष्ट्वा चित्रसेनो ह्यमर्षणः ।\nउत्पपातासनात् क्रुद्धो वधे तेषां समाहितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134743, "chapter_id": 3911, "verse_number": "२४", "content_sanskrit": "ततो मायास्त्रमास्थाय युयुधे चित्रमार्गवित् ।\nवियत् सञ्छादयामास न ववौ तत्र मारुतः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134744, "chapter_id": 3911, "verse_number": "२५", "content_sanskrit": "तया मुह्यन्त कौरव्याश्चित्रसेनस्य मायया \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134745, "chapter_id": 3911, "verse_number": "२६", "content_sanskrit": "हस्त्यारोहा हताः पेतुर्हस्तिभिः सह भारत ।\nहयारोहाश्च सहयै रथैश्च रथिनस्तथा ।\nपत्तयश्च यथा पेतुर्विशस्ताः शरवृष्टिभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134746, "chapter_id": 3911, "verse_number": "२७", "content_sanskrit": "एकैकोऽपि तदा योधो धार्तराष्ट्रस्य भारत ।\nपर्यवर्तत गन्धर्वैर्दशभिर्दशभिः सह \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134747, "chapter_id": 3911, "verse_number": "२८", "content_sanskrit": "ततः सम्पीड्यमानास्ते बलेन महता तदा ।\nप्राद्रवन्त रणे भीता ये च राजन् जिजी(गी)षवः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134748, "chapter_id": 3911, "verse_number": "२९", "content_sanskrit": "भज्यमानेष्वनीकेषु धार्तराष्ट्रेषु सर्वशः ।\nकर्णो वैकर्तनो राजंस्तस्थौ गिरिरिवाचलः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134749, "chapter_id": 3911, "verse_number": "३०", "content_sanskrit": "दुर्योधनश्च कर्णश्च शकुनिश्चापि सौबलः ।\nगन्धर्वान् योधयामासुः समरे भृशविक्षताः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134750, "chapter_id": 3911, "verse_number": "३१", "content_sanskrit": "सर्व एव तु गन्धर्वाः शतशोऽथ सहस्रशः ।\nजिघांसमानाः सहिताः कर्णमभ्यद्रवन् रणे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134751, "chapter_id": 3911, "verse_number": "३२", "content_sanskrit": "सूतपुत्रं जिघांसन्तः समन्तात् पर्यवाकिरन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134752, "chapter_id": 3911, "verse_number": "३३", "content_sanskrit": "अन्येऽस्य युगमच्छिन्दन्ध्वजमन्ये न्यपातयन् ।\nईषामन्ये हयानन्ये सूतमन्ये न्यपातयन्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134753, "chapter_id": 3911, "verse_number": "३४", "content_sanskrit": "अन्ये च्छत्रं वरूथं च बन्दुरं च तथा परे।\nअन्ये सञ्चूर्णयामासुर्नल्वं चाक्षौ तथा परे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134754, "chapter_id": 3911, "verse_number": "३५", "content_sanskrit": "गन्धर्वा बहुसाहस्रास्तिलशो व्यधमन् रथम् ।\nप्रगृहीतायुधा वीराश्चित्रसेनपुरोगमाः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2134755, "chapter_id": 3911, "verse_number": "३६", "content_sanskrit": "ततो रथादवप्लुत्य सूतपुत्रोऽसिचर्मभृत् ।\nअंसावलम्बितधनुर्धावमानो महाबलः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2134756, "chapter_id": 3911, "verse_number": "३७", "content_sanskrit": "विकर्णरथमास्थाय मोक्षायाश्वानचोदयत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2134757, "chapter_id": 3911, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि कर्णपराभवे त्रिंशदधिकद्विशततमोऽध्यायः ॥२३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2134758, "chapter_id": 3911, "verse_number": "", "content_sanskrit": "घोषयात्रापर्वणि षष्ठोध्यायः ॥६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]