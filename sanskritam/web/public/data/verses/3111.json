[{"id": 2098658, "chapter_id": 3111, "verse_number": "१३-२४१-१", "content_sanskrit": "उमोवाच।\nमानुषेष्वेव जीवत्सु गतिर्विज्ञायते न वा।\nयथा शुभगतिर्जीवो नासौ त्वशुभभागिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098659, "chapter_id": 3111, "verse_number": "१३-२४१-२", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098660, "chapter_id": 3111, "verse_number": "१३-२४१-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098661, "chapter_id": 3111, "verse_number": "१३-२४१-३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि जीवितं विद्यते यथा।\nद्विविधाः प्राणिनो लोके दैवमासुरमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098662, "chapter_id": 3111, "verse_number": "१३-२४१-४", "content_sanskrit": "मनसा कर्मणा वाचा प्रतिकला भवन्ति ये।\nतादृशानासुरान्विद्धि मर्त्यास्ते नरकालयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098663, "chapter_id": 3111, "verse_number": "१३-२४१-५", "content_sanskrit": "हिंस्राश्चोराश्च धूर्ताश्च परदाराभिमर्शकाः।\nनीचकर्मरता ये च शौचमङ्गलवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098664, "chapter_id": 3111, "verse_number": "१३-२४१-६", "content_sanskrit": "शुचिविद्वेषिणः पापा लोकचारित्रदूषकाः।\nएवं युक्तसमाचारा जीवन्तो नरकालयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098665, "chapter_id": 3111, "verse_number": "१३-२४१-७", "content_sanskrit": "लोकोद्वेगकराश्चान्ये पशवश्च सरीसृपाः।\nवृक्षाः कण्टकिनो रूक्षास्तादृशान्विद्धि चासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098666, "chapter_id": 3111, "verse_number": "१३-२४१-८", "content_sanskrit": "अपरान्देवपक्षांस्तु शृणु देवि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098667, "chapter_id": 3111, "verse_number": "१३-२४१-९", "content_sanskrit": "मनोवाक्कर्मभिर्नित्यमनुकूला भवन्ति ये।\nतादृशानमरान्विद्धि ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098668, "chapter_id": 3111, "verse_number": "१३-२४१-१०", "content_sanskrit": "शौचार्जवपरा धीराः परार्थं नाहरन्ति ये।\nये समाः सर्वभूतेषु ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098669, "chapter_id": 3111, "verse_number": "१३-२४१-११", "content_sanskrit": "भयाद्वा वृत्तिहेतोर्वा अनृतं न वदन्ति ये।\nसत्यं वदन्ति सततं ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098670, "chapter_id": 3111, "verse_number": "१३-२४१-१२", "content_sanskrit": "धार्मिकाः शौचसम्पन्नाः शुक्ला मधुरवादिनः।\nनाकार्यं मनसेच्छन्ति ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098671, "chapter_id": 3111, "verse_number": "१३-२४१-१३", "content_sanskrit": "स्वदुःखमिव मन्यन्ते परेषां दुःखवेदनम्।\nदरिद्रा अपि ये केचिद्याचिताः प्रीतिपूर्वकम्।\nददत्येव च यत्किञ्चित्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098672, "chapter_id": 3111, "verse_number": "१३-२४१-१४", "content_sanskrit": "आस्तिका मङ्गलपराः सततं वृद्धसेविनः।\nपुण्यकर्मपरा नित्यं ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098673, "chapter_id": 3111, "verse_number": "१३-२४१-१५", "content_sanskrit": "व्रतिनो दानशीलाश्च धर्मशीलाश्च मानवाः॥\nऋजवो मृदवो नित्यं ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098674, "chapter_id": 3111, "verse_number": "१३-२४१-१६", "content_sanskrit": "गुरुशुश्रूषणपरा देवब्राह्मणपूजकाः।\nकृजज्ञाः कृतविद्याश्च ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098675, "chapter_id": 3111, "verse_number": "१३-२४१-१७", "content_sanskrit": "जितेन्द्रिया जितक्रोधा जितमानमदाः स्मृताः।\nलोभमात्सर्यहीना ये ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098676, "chapter_id": 3111, "verse_number": "१३-२४१-१८", "content_sanskrit": "निर्मा निरहङ्कारः सानुक्रोशाः स्वबन्धुषु।\nदीनानुकम्पिनो नित्यं ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098677, "chapter_id": 3111, "verse_number": "१३-२४१-१९", "content_sanskrit": "ऐहिकेन तु वृत्तेन पारत्रमनुमीयते।\nएवंविधा नरा लोके जीवन्तः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098678, "chapter_id": 3111, "verse_number": "१३-२४१-२०", "content_sanskrit": "यदन्यच्च शुभं लोके प्रजानुग्रहकारि च।\nपशवश्चैव वृक्षाश्च प्रजानां हितकारिणः।\nतादृशान्देवपक्षस्थानिति विद्धि शुभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098679, "chapter_id": 3111, "verse_number": "१३-२४१-२१", "content_sanskrit": "शुभाशुभप्रयं लोके सर्वं स्थावरजङ्गमम्।\nदैवं शुभमिति प्राहुरासुरं चाशुभं प्रिये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098680, "chapter_id": 3111, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्यहाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]