[{"id": 2098899, "chapter_id": 3116, "verse_number": "१३-२४६-१", "content_sanskrit": "महेश्वर उवाच।\nसाङ्ख्यज्ञाने नियुक्तानां यथावत्कीर्तितं मया।\nयोगधर्मं पुनः कृत्स्नं कीर्तयिष्यामि ते शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098900, "chapter_id": 3116, "verse_number": "१३-२४६-२", "content_sanskrit": "स च योगो द्विधा भिन्नो ब्रह्मिदेवर्षिसम्मतः।\nसमानमुभयत्रापि वृत्तं शास्त्रप्रचोदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098901, "chapter_id": 3116, "verse_number": "१३-२४६-३", "content_sanskrit": "च चाष्टगुणमैश्वर्यमधिकृत्य विधीयते।\nसायुज्यं सर्वदेवानां योगधर्मं परं श्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098902, "chapter_id": 3116, "verse_number": "१३-२४६-४", "content_sanskrit": "ज्ञानं सर्वस्य योगस्य मूलमित्यवधारय।\nव्रतोपवासनियमैस्तत्सर्वं चापि बृंहयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098903, "chapter_id": 3116, "verse_number": "१३-२४६-५", "content_sanskrit": "ऐकात्म्यं बुद्धिमनसोरिन्द्रियाणां च सर्वशः।\nआत्मनो वेदितं प्राज्ञे ज्ञानमेतत्तु योगिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098904, "chapter_id": 3116, "verse_number": "१३-२४६-६", "content_sanskrit": "अर्चयेद्ब्राह्मणानग्निं देवतायतनानि च।\nवर्जयेदशिवं भावं सर्वसत्त्वमुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098905, "chapter_id": 3116, "verse_number": "१३-२४६-७", "content_sanskrit": "दानमध्ययनं श्रुद्धा व्रतानि नियमास्तथा।\nसत्यमाहारशुद्धिश्च शौचमिन्द्रियनिग्रहः।\nएतैश्च वर्धते तेजः पापं चाप्यवधूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098906, "chapter_id": 3116, "verse_number": "१३-२४६-८", "content_sanskrit": "निर्धूतपापस्तेजस्वी लघ्वाहारो जितेन्द्रियः।\nअमोधो निर्मलो दान्तः पश्चाद्योगं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098907, "chapter_id": 3116, "verse_number": "१३-२४६-९", "content_sanskrit": "अवरुध्यात्मनः पूर्वं मत्स्यघात इवामिषम्।\nएकान्ते विजने देशे सर्वतः संवृते शुचौ।\nकल्पयेदासनं तत्र स्वास्तीर्णं मृदुभिः कुशैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098908, "chapter_id": 3116, "verse_number": "१३-२४६-१०", "content_sanskrit": "उपविश्यासने तस्मिन्नृजुकायशिरोधरः।\nअव्यग्रः सुखमासीनः स्वाङ्गानि न विकम्पयेत्।\nसम्प्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098909, "chapter_id": 3116, "verse_number": "१३-२४६-११", "content_sanskrit": "मनोऽवस्थापनं देवि योगस्योपनिषद्भवेत्।\nतस्मात्सर्वप्रयत्नेन मनोऽवस्थापयेत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098910, "chapter_id": 3116, "verse_number": "१३-२४६-१२", "content_sanskrit": "त्वक्छ्रोत्रं च ततो जिह्वा घ्राणं चक्षुश्च संहरेत्।\nपञ्चेन्द्रियाणि सन्धाय मनसि स्थापयेद्बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098911, "chapter_id": 3116, "verse_number": "१३-२४६-१३", "content_sanskrit": "सर्वं चापोह्य सङ्कल्पमात्मनि स्थापयेन्मनः।\nयदैतान्यवतिष्ठन्ते मनःषष्ठानि चात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098912, "chapter_id": 3116, "verse_number": "१३-२४६-१४", "content_sanskrit": "प्राणापानौ तदा तस्य युगपत्तिष्ठतो वशे।\nप्राणे हि वशमापन्ने योगसिद्धिर्ध्रुवा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098913, "chapter_id": 3116, "verse_number": "१३-२४६-१५", "content_sanskrit": "शरीरं चिन्तयेत्सर्वं विपाट्य च समीपतः।\nअन्तर्देहगतिं चापि प्राणानां परिचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098914, "chapter_id": 3116, "verse_number": "१३-२४६-१६", "content_sanskrit": "ततो मूर्धानमग्निं च शरीरं परिपालयेत्।\nप्राणो मूर्धनि च श्वासो वर्तमाने विचेष्टते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098915, "chapter_id": 3116, "verse_number": "१३-२४६-१७", "content_sanskrit": "सज्जस्तु सर्वभूतात्मा पुरुषः स सनातनः।\nमनो बुद्धिरहङ्कारो भूतानि विषयांश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098916, "chapter_id": 3116, "verse_number": "१३-२४६-१८", "content_sanskrit": "बस्तिर्मूलं गुदं चैव पावकं च समाश्रितः।\nवहन्मूत्रं पुरीषं च सदाऽपानः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098917, "chapter_id": 3116, "verse_number": "१३-२४६-१९", "content_sanskrit": "अतः प्रवृत्तिर्देहषु कर्म चापानसंयुतम्।\nउदीरयन्सर्वधातूनन्त ऊर्ध्वं प्रवर्तते।\nउदान इति तं विद्युरध्यात्मकुशला जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098918, "chapter_id": 3116, "verse_number": "१३-२४६-२०", "content_sanskrit": "सन्धौसन्धौ स निर्विष्टः सर्वचेष्टाप्रवर्तकः।\nशरीरेषु मनुष्याणां व्यान इत्युपदिश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098919, "chapter_id": 3116, "verse_number": "१३-२४६-२१", "content_sanskrit": "धातुष्वग्नौ च विततः समानोऽग्निः समीरणः।\nस एव सर्वचेष्टानामन्तकाले निवर्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098920, "chapter_id": 3116, "verse_number": "१३-२४६-२२", "content_sanskrit": "प्राणानां सन्निपातेषु संसर्गाद्यः प्रजायते।\nऊष्मा सोग्निरिति ज्ञेयः सोन्नं पचति देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098921, "chapter_id": 3116, "verse_number": "१३-२४६-२३", "content_sanskrit": "अपानप्राणयोर्मध्ये व्यानोदानावुपाश्रितौ।\nसमन्वितः समानेन सम्यक्पचति पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098922, "chapter_id": 3116, "verse_number": "१३-२४६-२४", "content_sanskrit": "शरीरमध्ये नाभिः स्यान्नाभ्यामग्निः प्रतिष्ठितः।\nअग्नौ प्राणाश्च संयुक्ताः प्राणेष्वात्मा व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098923, "chapter_id": 3116, "verse_number": "१३-२४६-२५", "content_sanskrit": "पक्वाशयस्त्वधो नाभेरूर्ध्वमामाशयस्तथा।\nनाभिर्मध्ये शरीरस्य सर्वप्राणाश्च संश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098924, "chapter_id": 3116, "verse_number": "१३-२४६-२६", "content_sanskrit": "स्थिताः प्राणादयः सर्वे तिर्यगूर्ध्वमधश्वराः।\nवहन्त्यन्नरसान्नाड्यो दशप्राणाग्निचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098925, "chapter_id": 3116, "verse_number": "१३-२४६-२७", "content_sanskrit": "योगिनामेष मार्गस्तु पञ्चस्वेतेषु तिष्ठति।\nजितश्रमः समासीनो मूर्धन्यात्मानमादधेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098926, "chapter_id": 3116, "verse_number": "१३-२४६-२८", "content_sanskrit": "मूर्धन्यात्मानमाधाय भ्रुवोर्मध्ये मनस्तथा।\nसन्निरुध्य ततः प्राणानात्मानं चिन्तयेत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098927, "chapter_id": 3116, "verse_number": "१३-२४६-२९", "content_sanskrit": "प्राणे त्वपानं युञ्जीत प्राणांश्चापानकर्मणि।\nप्राणापानगती रुद्ध्वा प्राणायामपरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098928, "chapter_id": 3116, "verse_number": "१३-२४६-३०", "content_sanskrit": "एवमन्तः प्रयुञ्जीत पञ्च प्राणान्परस्परम्।\nविजने सम्मिताहारो मुनस्तूष्णीं निरुच्छ्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098929, "chapter_id": 3116, "verse_number": "१३-२४६-३१", "content_sanskrit": "अश्रान्तश्चिन्तयेद्योगी उत्थाय च पुनःपुनः।\nतिष्ठन्गच्छन्स्वपंस्चापि युञ्जीतैवमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098930, "chapter_id": 3116, "verse_number": "१३-२४६-३२", "content_sanskrit": "एवं नियुञ्जतस्तस्य योगिनो युक्तचेतसः।\nप्रसीदति मनः क्षिप्रं प्रसन्ने दृश्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098931, "chapter_id": 3116, "verse_number": "१३-२४६-३३", "content_sanskrit": "विधूम इव दीप्तोऽग्निरादित्य इव रश्मिवान्।\nवैद्युतोऽग्निरिवाकाशे पुरुषो दृश्यतेऽव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098932, "chapter_id": 3116, "verse_number": "१३-२४६-३४", "content_sanskrit": "दृष्ट्वा तदात्मनो ज्योतिरैश्वर्याष्टगुणैर्युतः।\nप्राप्नोति परमं स्थानं स्पृहणीयं सुरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098933, "chapter_id": 3116, "verse_number": "१३-२४६-३५", "content_sanskrit": "इमान्योगस्य दोषांश्च दशैव परिचक्षते।\nदोषैर्विघ्ने वरारोहे योगिनां कविभिः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098934, "chapter_id": 3116, "verse_number": "१३-२४६-३६", "content_sanskrit": "कामः क्रोधो भयं स्वप्नः स्नेहमत्यशनं तथा।\nवैचित्यं व्याधिरालस्यं लोभं च दशमं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098935, "chapter_id": 3116, "verse_number": "१३-२४६-३७", "content_sanskrit": "एतैस्तेषां भवेद्विघ्नो दशभिर्देवकारितैः।\nतस्मादेतानपास्यादौ युञ्जीत च परं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098936, "chapter_id": 3116, "verse_number": "१३-२४६-३८", "content_sanskrit": "इमानपि गुणानष्टौ योगस्य परिचक्षते।\nगुणैस्तैरष्टभिर्द्रव्यमैश्वर्यमधिगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098937, "chapter_id": 3116, "verse_number": "१३-२४६-३९", "content_sanskrit": "अणिमा महिमा चैव प्राप्तिः प्राकाम्यमेव हि।\nईशित्वं च वशित्वं च यत्र कामावसायिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098938, "chapter_id": 3116, "verse_number": "१३-२४६-४०", "content_sanskrit": "एतानष्टौ गुणान्प्राप्य कथञ्चिद्योगिनां वराः।\nईशाः सर्वस्य लोकस्य देवानप्यतिशेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098939, "chapter_id": 3116, "verse_number": "१३-२४६-४१", "content_sanskrit": "योगोस्ति नैवात्यशिनो न चैकान्तमनश्नतः।\nन चातिस्वप्नशीलस्य नातिजागतरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098940, "chapter_id": 3116, "verse_number": "१३-२४६-४२", "content_sanskrit": "युक्ताहारविहारस्य युक्तचेष्टस्य कर्मसु।\nयुक्तस्वप्नावबोधस्य योगो भवति दुःखहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098941, "chapter_id": 3116, "verse_number": "१३-२४६-४३", "content_sanskrit": "अनेनैव विधानेन सायुज्यं तत्प्रकल्प्यते।\nसायुज्यं देवसात्कृत्वा प्रयुञ्जीतात्मभक्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098942, "chapter_id": 3116, "verse_number": "१३-२४६-४४", "content_sanskrit": "अनन्यमनसा देवि नित्यं तद्गतचेतसा।\nसायुज्यं प्राप्यते देवैर्यत्नेन महता चिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098943, "chapter_id": 3116, "verse_number": "१३-२४६-४५", "content_sanskrit": "हविर्भिरर्चनैर्होमैः प्रणामैर्नित्यचिन्तया।\nअर्चयित्वा यथाशक्ति स्वकं देशं विशन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098944, "chapter_id": 3116, "verse_number": "१३-२४६-४६", "content_sanskrit": "सायुज्यानां विशिष्टं च मामकं वैष्णवं तथा।\nमां प्राप्य न निवर्तन्ते विष्णु वा शुभलोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098945, "chapter_id": 3116, "verse_number": "१३-२४६-४७", "content_sanskrit": "इति ते कथितो देवि योगधर्मः सनातनः।\nन शक्यः प्रष्टुमन्येन योगधर्मस्त्वया विना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098946, "chapter_id": 3116, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]