[{"id": 2182185, "chapter_id": 4861, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182186, "chapter_id": 4861, "verse_number": "१", "content_sanskrit": "स्वकर्मण्यपरे युक्तास्तथैवान्ये विकर्मणि ।\nतेषां विशेषमाचक्ष्व ब्राह्मणानां पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182187, "chapter_id": 4861, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182188, "chapter_id": 4861, "verse_number": "२", "content_sanskrit": "विद्यालक्षणसम्पन्नाः सर्वत्राम्नायदर्शिनः ।\nएते ब्रह्मसमा राजन् ब्राह्मणाः परिकीर्तिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182189, "chapter_id": 4861, "verse_number": "३", "content_sanskrit": "ऋग्यजुःसामसम्पन्नाः स्वेषु कर्मस्ववस्थिताः ।\nएते देवसमा राजन् ब्राह्मणानां भवन्त्युत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182190, "chapter_id": 4861, "verse_number": "४", "content_sanskrit": "ऋत्विक् पुरोहितो मन्त्री दूतोऽथार्थानुशासकः ।\nएते क्षत्रसमा राजन् ब्राह्मणानां भवन्त्युत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182191, "chapter_id": 4861, "verse_number": "५", "content_sanskrit": "अश्वारोहा गजारोहा रथिनोऽथ पदातयः ।\nएते वैश्यसमा राजन् ब्राह्मणानां भवन्त्युत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182192, "chapter_id": 4861, "verse_number": "६", "content_sanskrit": "जन्मकर्मविहीना ये कदर्या ब्रह्मबन्धवः ।\nएते शूद्रसमा राजन् ब्राह्मणानां भवन्त्युत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182193, "chapter_id": 4861, "verse_number": "७", "content_sanskrit": "अश्रोत्रियाः सर्व एव सर्वे चानाहिताग्नयः ।\nतान् सर्वान् धार्मिको राजा बलिं विष्टिं च कारयेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182194, "chapter_id": 4861, "verse_number": "८", "content_sanskrit": "आह्वायका देवलका नाक्षत्रा ग्रामयाजकाः ।\nएते ब्राह्मणचण्डाला महापथिकपञ्चमाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182195, "chapter_id": 4861, "verse_number": "९", "content_sanskrit": "एतेभ्यो बलिमादद्याद् हीनकोशो महीपतिः ।\nऋते ब्रह्मसमेभ्यश्च देवकल्पेभ्य एव च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182196, "chapter_id": 4861, "verse_number": "१०", "content_sanskrit": "अब्राह्मणानां वित्तस्य स्वामी राजेति वैदिकम् ।\nब्राह्मणानां च ये केचिद् विकर्मस्था भवन्त्युत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182197, "chapter_id": 4861, "verse_number": "११", "content_sanskrit": "विकर्मस्थास्तु नोपेक्ष्या जातु राज्ञा कथञ्चन ।\nपथिकः संविभज्यश्च धर्मानुग्रहकारणात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182198, "chapter_id": 4861, "verse_number": "१२", "content_sanskrit": "यस्य स्म विषये राज्ञः स्तेनो भवति वै द्विजः ।\nराज्ञ एवापराधं तं मन्यन्ते तद्विदो जनाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182199, "chapter_id": 4861, "verse_number": "१३", "content_sanskrit": "अवृत्त्या यो भवेत् स्तेनो वेदवित् स्नातकस्तथा ।\nराजन् स राज्ञा भर्तव्य इति धर्मविदो विदुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182200, "chapter_id": 4861, "verse_number": "१४", "content_sanskrit": "स चेन्नोपरिवर्तेत कृतवृत्तिः परन्तप ।\nततो निर्वासनीयः स्यात् तस्माद् देशात् सबान्धवः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182201, "chapter_id": 4861, "verse_number": "१५", "content_sanskrit": "यज्ञः श्रुतमपैशुन्यमहिंसातिथिपूजनम् ।\nदमः सत्यं तपो दानमेतद् ब्राह्मणलक्षणम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182202, "chapter_id": 4861, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टसप्ततितमोऽध्यायः ॥ ७८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]