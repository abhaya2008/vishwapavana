[
  {
    "id": 20203614,
    "chapter_id": 7777,
    "verse_number": "८.१.१",
    "content_sanskrit": "सर्वस्य द्वे",
    "padaccheda": "सर्वस्य । द्वे",
    "anvaya": "सर्वस्य द्वे",
    "meaning_sanskrit": "इतः परम् <<पदस्य>> [[8.1.16]] अस्मात् प्राक् यद् किमपि वक्ष्यते, तत् सर्वम् द्विरुक्तम् भवति ।",
    "meaning_english": "In the contexts that will henceforth be told till the sutra <<पदस्य>> [[8.1.16]], the participating words will get duplicated. ",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20203615,
    "chapter_id": 7777,
    "verse_number": "८.१.२",
    "content_sanskrit": "तस्य परमाम्रेडितम्",
    "padaccheda": "तस्य । परम् । आम्रेडितम्",
    "anvaya": "सर्वस्य द्वे, तस्य परमाम्रेडितम् ",
    "meaning_sanskrit": "<<सर्वस्य द्वे>> [[8.1.1]] अस्मिन् अधिकारे द्वित्वे कृते, द्विरुक्तस्य यत् द्वितीयम् तस्य आम्रेडितम् इति संज्ञा भवति ।",
    "meaning_english": "When a word gets replicated in the 'सर्वस्य द्वे' अधिकार, the second occurrence is known as आम्रेडित.",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
