[{"id": 7005874000, "chapter_id": 25874, "verse_number": "१-५७-१", "content_sanskrit": "हरिरुवाच ।\nसप्ततिस्तु सहस्त्राणि भूम्युच्छ्रायोऽप कथ्यते।\nदशसाहस्त्रमेकैकं पातालं वृषभध्वज ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005874001, "chapter_id": 25874, "verse_number": "१-५७-२", "content_sanskrit": "अतलं वितलं चैव नितलं च गभस्तिमत् ।\nमहाख्यं सुतलं चाग्रयं पातालं चापि सप्तमम् ॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005874002, "chapter_id": 25874, "verse_number": "१-५७-३", "content_sanskrit": "> कृष्णा शुक्लारुणा पीता शर्करा शैलकाञ्चना।\nभूयस्तत्र दैतेया वसन्ति च भुजङ्गमाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005874003, "chapter_id": 25874, "verse_number": "१-५७-४", "content_sanskrit": "रौद्रे तु पुष्करद्वीपे नरकाः सन्ति तञ्छृणु।\nरौरवः सूकरो रोधस्तालो विनशनस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005874004, "chapter_id": 25874, "verse_number": "१-५७-५", "content_sanskrit": "महाज्वालस्तप्तकुम्भो लवणोऽथि विमोहित।\nरुधिराख्यो वैतरणी कृमिशः कृमिभो जनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005874005, "chapter_id": 25874, "verse_number": "१-५७-६", "content_sanskrit": "असिपत्रवनः कृष्णो नानाभक्षश्च दारुणः ।\nतथा पूयवहः पापो वह्निज्वालस्त्वधः शिराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005874006, "chapter_id": 25874, "verse_number": "१-५७-७", "content_sanskrit": "संदंशः कृष्णसूत्रश्च तमश्चावीचिरेव च ।\nश्वभोजनोऽथाप्रतिष्ठोष्णवीचिर्नरकाः स्मृताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005874007, "chapter_id": 25874, "verse_number": "१-५७-८", "content_sanskrit": "पापिनस्तेषु पच्यन्ते विषशस्त्राग्निदायिनः ।\nउपर्य्युपरि वै लोका रुद्र ! भूतादयः स्थिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005874008, "chapter_id": 25874, "verse_number": "१-५७-९", "content_sanskrit": "वारिवह्न्यनिलाकाशैर्वृतं भूतादिना च तत् ।\nतदण्डं महता रुद्र ! प्रधानेन च वेष्टितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005874009, "chapter_id": 25874, "verse_number": "१-५७-१०", "content_sanskrit": "अण्डं दशगुणं व्याप्तं नारायणः स्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]