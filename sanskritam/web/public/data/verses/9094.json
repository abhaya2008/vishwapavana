[{"id": 5000094000, "chapter_id": 9094, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000094001, "chapter_id": 9094, "verse_number": "२-१७-१", "content_sanskrit": "स रामो रथमास्थाय सम्प्रहृष्टसुहृज्जनः।\nपताकाध्वजसम्पन्नं महार्हागुरुधूपितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000094002, "chapter_id": 9094, "verse_number": "२-१७-२", "content_sanskrit": "अपश्यन्नगरं श्रीमान् नानाजनसमन्वितम्।\nस गृहैरभ्रसंकाशैः पाण्डुरैरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000094003, "chapter_id": 9094, "verse_number": "२-१७-३", "content_sanskrit": "राजमार्गं ययौ रामो मध्येनागुरुधूपितम्।\nचन्दनानां च मुख्यानामगुरूणां च संचयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000094004, "chapter_id": 9094, "verse_number": "२-१७-४", "content_sanskrit": "उत्तमानां च गन्धानां क्षौमकौशाम्बरस्य च।\nअविद्धाभिश्च मुक्ताभिरुत्तमैः स्फाटिकैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000094005, "chapter_id": 9094, "verse_number": "२-१७-५", "content_sanskrit": "शोभमानमसम्बाधं तं राजपथमुत्तमम्।\nसंवृतं विविधैः पुष्पैर्भक्ष्यैरुच्चावचैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000094006, "chapter_id": 9094, "verse_number": "२-१७-६", "content_sanskrit": "ददर्श तं राजपथं दिवि देवपतिर्यथा।\nदध्यक्षतहविर्लाजैर्धूपैरगुरुचन्दनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000094007, "chapter_id": 9094, "verse_number": "२-१७-७", "content_sanskrit": "नानामाल्योपगन्धैश्च सदाभ्यर्चितचत्वरम्।\nआशीर्वादान् बहून् शृण्वन् सुहृद्भिः समुदीरितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000094008, "chapter_id": 9094, "verse_number": "२-१७-८", "content_sanskrit": "यथार्हं चापि सम्पूज्य सर्वानेव नरान् ययौ।\nपितामहैराचरितं तथैव प्रपितामहैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000094009, "chapter_id": 9094, "verse_number": "२-१७-९", "content_sanskrit": "अद्योपादाय तं मार्गमभिषिक्तोऽनुपालय।\nयथा स्म पोषिताः पित्रा यथा सर्वैः पितामहैः।\nततः सुखतरं सर्वे रामे वत्स्याम राजनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000094010, "chapter_id": 9094, "verse_number": "२-१७-१०", "content_sanskrit": "अलमद्य हि भुक्तेन परमार्थैरलं च नः।\nयदि पश्याम निर्यान्तं रामं राज्ये प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000094011, "chapter_id": 9094, "verse_number": "२-१७-११", "content_sanskrit": "ततो हि नः प्रियतरं नान्यत् किंचिद् भविष्यति।\nयथाभिषेको रामस्य राज्येनामिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000094012, "chapter_id": 9094, "verse_number": "२-१७-१२", "content_sanskrit": "एताश्चान्याश्च सुहृदामुदासीनः शुभाः कथाः।\nआत्मसम्पूजनीः शृण्वन् ययौ रामो महापथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000094013, "chapter_id": 9094, "verse_number": "२-१७-१३", "content_sanskrit": "न हि तस्मान्मनः कश्चिच्चक्षुषी वा नरोत्तमात्।\nनरः शक्नोत्यपाक्रष्टुमतिक्रान्तेऽपि राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000094014, "chapter_id": 9094, "verse_number": "२-१७-१४", "content_sanskrit": "यश्च रामं न पश्येत्तु यं च रामो न पश्यति।\nनिन्दितः सर्वलोकेषु स्वात्माप्येनं विगर्हते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000094015, "chapter_id": 9094, "verse_number": "२-१७-१५", "content_sanskrit": "सर्वेषु स हि धर्मात्मा वर्णानां कुरुते दयाम्।\nचतुर्णां हि वयःस्थानां तेन ते तमनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000094016, "chapter_id": 9094, "verse_number": "२-१७-१६", "content_sanskrit": "चतुष्पथान् देवपथांश्चैत्यांश्चायतनानि च।\nप्रदक्षिणं परिहरज्जगाम नृपतेः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000094017, "chapter_id": 9094, "verse_number": "२-१७-१७", "content_sanskrit": "स राजकुलमासाद्य मेघसङ्घोपमैः शुभैः।\nप्रासादशृङ्गैर्विविधैः कैलासशिखरोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000094018, "chapter_id": 9094, "verse_number": "२-१७-१८", "content_sanskrit": "आवारयद्भिर्गगनं विमानैरिव पाण्डुरैः।\nवर्धमानगृहैश्चापि रत्नजालपरिष्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000094019, "chapter_id": 9094, "verse_number": "२-१७-१९", "content_sanskrit": "तत् पृथिव्यां गृहवरं महेन्द्रसदनोपमम्।\nराजपुत्रः पितुर्वेश्म प्रविवेश श्रिया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000094020, "chapter_id": 9094, "verse_number": "२-१७-२०", "content_sanskrit": "स कक्ष्या धन्विभिर्गुप्तास्तिस्रोऽतिक्रम्य वाजिभिः।\nपदातिरपरे कक्ष्ये द्वे जगाम नरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000094021, "chapter_id": 9094, "verse_number": "२-१७-२१", "content_sanskrit": "स सर्वाः समतिक्रम्य कक्ष्या दशरथात्मजः।\nसंनिवर्त्य जनं सर्वं शुद्धान्तःपुरमत्यगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000094022, "chapter_id": 9094, "verse_number": "२-१७-२२", "content_sanskrit": "तस्मिन् प्रविष्टे पितुरन्तिकं तदा\nजनः स सर्वो मुदितो नृपात्मजे।\nप्रतीक्षते तस्य पुनः स्म निर्गमं\nयथोदयं चन्द्रमसः सरित्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000094023, "chapter_id": 9094, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]