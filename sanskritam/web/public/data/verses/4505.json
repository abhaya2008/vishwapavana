[{"id": 2162286, "chapter_id": 4505, "verse_number": "", "content_sanskrit": "सङ्कुलयुद्धवर्णनम् । सात्यकिनाऽर्जुनदर्शनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2162287, "chapter_id": 4505, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2162288, "chapter_id": 4505, "verse_number": "१", "content_sanskrit": "किं तस्यां मम सेनायां नासन् केचिन्महारथाः ।\nये तथा सात्यकिं यान्तं नैवाघ्नन् नाप्यवारयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2162289, "chapter_id": 4505, "verse_number": "२", "content_sanskrit": "एको हि समरे कर्म कृतवान् सत्यविक्रमः ।\nशक्रतुल्यबलो युद्धे महेन्द्रो दानवेष्विव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2162290, "chapter_id": 4505, "verse_number": "३", "content_sanskrit": "अथ वा शून्यमासीत् तद् येन यातः स सात्यकिः ।\nएको वै बहुलाः सेनाः प्रमृद्नन् पुरुषर्षभः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2162291, "chapter_id": 4505, "verse_number": "४", "content_sanskrit": "यत् कृतं वृष्णिवीरेण कर्म शंससि मे रणे ।\nनैतदुत्सहते कर्म कर्तुं शक्रोऽपि सञ्जय\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2162292, "chapter_id": 4505, "verse_number": "५", "content_sanskrit": "अश्रद्धेयमचिन्त्यं च कर्म तस्य महात्मनः ।\nवृष्ण्यन्धकप्रवीरस्य श्रुत्वा मे व्यथितं मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2162293, "chapter_id": 4505, "verse_number": "६", "content_sanskrit": "कथं च युद्ध्यमानानामपक्रान्तो महात्मनाम् ।\nएको बहूनां शैनेयस्तन्ममाचक्ष्व सञ्जय\nन सन्ति तस्मात् पुत्रा मे यथा सञ्जय भाषसे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2162294, "chapter_id": 4505, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2162295, "chapter_id": 4505, "verse_number": "७", "content_sanskrit": "राजन् सेनासमुद्योगो रथनागाश्वपत्तिमान् ।\nअतुल्यस्तव सैन्यानां युगान्तसदृशोऽभवत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2162296, "chapter_id": 4505, "verse_number": "८", "content_sanskrit": "आहिकेषु समूहेषु तव सैन्यस्य मानद ।\nनास्ति लोके समः कश्चित् समूह इति मे मतिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2162297, "chapter_id": 4505, "verse_number": "९", "content_sanskrit": "तत्र देवाः स्म भाषन्ते चारणाश्च समागताः ।\nएतदन्ताः समूहा वै भविष्यन्ति महीतळे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2162298, "chapter_id": 4505, "verse_number": "१०", "content_sanskrit": "न चैव तादृशः कश्चिद् व्यूह आसीद् विशांपते ।\nयादृग् जयद्रथवधे द्रोणेन विहितोऽभवत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2162299, "chapter_id": 4505, "verse_number": "११", "content_sanskrit": "चण्डवाताभिपन्नानां समुद्राणामिव स्वनः ।\nरणेऽभवद् बलौघानामन्योन्यमभिधावताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2162300, "chapter_id": 4505, "verse_number": "१२", "content_sanskrit": "पार्थिवानां समेतानां बहून्यासन् नरोत्तम ।\nत्वद्बले पाण्डवानां च सहस्राणि शतानि च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2162301, "chapter_id": 4505, "verse_number": "१३", "content_sanskrit": "संरब्धानां प्रवीराणां समरे दृढकर्मणाम् ।\nतत्रासीत् सुमहान् शब्दस्तुमुलो लोमहर्षणः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2162302, "chapter_id": 4505, "verse_number": "१५", "content_sanskrit": "अथाक्रन्दद् भीमसेनो धृष्टद्युम्नश्च मारिष ।\nनकुलः सहदेवश्च धर्मराजश्च पाण्डवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2162303, "chapter_id": 4505, "verse_number": "१६", "content_sanskrit": "आगच्छत प्रहरत बलवत् परिधावत ।\nप्रविष्टावरिसेनां हि वीरौ माधवपाण्डवौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2162304, "chapter_id": 4505, "verse_number": "१७", "content_sanskrit": "यथा सुखेन गच्छेतां जयद्रथवधं प्रति ।\nतथा प्रकुरुत क्षिप्रमिति सैन्यान्यचोदयत् ।\nतयोरभावे कुरवः कृतार्थाः स्युर्वयं जिताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2162305, "chapter_id": 4505, "verse_number": "१८", "content_sanskrit": "ते यूयं सहिता भूत्वा तूर्णमेव बलार्णवम् ।\nक्षोभयध्वं महावेगाः पवनाः सागरं यथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2162306, "chapter_id": 4505, "verse_number": "", "content_sanskrit": "भीमसेनेन ते राजन् पाञ्चाल्येन च चोदिताः ।\nआजघ्नुः कौरवान् सङ्खे त्यक्त्वासूनात्मनः प्रियान्\t॥२०।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2162307, "chapter_id": 4505, "verse_number": "२१", "content_sanskrit": "इच्छन्तो निधनं युद्धे शस्त्रैरुत्तमतेजसः ।\nस्वर्गार्थं मित्रकार्यार्थं नाभ्यरक्षन्त जीवितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2162308, "chapter_id": 4505, "verse_number": "२२", "content_sanskrit": "तथैव तावका राजन् प्रार्थयन्तो महद्यशः ।\nआर्यां युद्धे मतिं कृत्वा युद्धायैवोपतस्थिरे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2162309, "chapter_id": 4505, "verse_number": "२३", "content_sanskrit": "तस्मिंस्तु तुमुले युद्धे वर्तमाने महाभये ।\nहत्वा सर्वाणि सैन्यानि प्रायात् सात्यकिरर्जुनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2162310, "chapter_id": 4505, "verse_number": "२४", "content_sanskrit": "कवचानां प्रभास्तत्र सूर्यरश्मिविचित्रिताः ।\nदृष्टीः सङ्खे सैनिकानां प्रतिजघ्नुः समन्ततः\nध्वजशस्त्रप्रतिहता लोकान् समवदीपयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2162311, "chapter_id": 4505, "verse_number": "२५", "content_sanskrit": "तथा प्रयतमानेषु पाण्डवेयेषु निर्भयः ।\nदुर्योधनो महाराज व्यगाहत महद्बलम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2162312, "chapter_id": 4505, "verse_number": "२६", "content_sanskrit": "स सन्निपातस्तुमुलस्तेषां तस्य च भारत ।\nअभवत् सर्वसैन्यानामभावकरणो महान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2162313, "chapter_id": 4505, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2162314, "chapter_id": 4505, "verse_number": "२७", "content_sanskrit": "तथा गतेषु सैन्येषु तथा कृच्छ्रगतः स्वयम् ।\nकच्चिद्दुर्योधनः सूत नाकार्षीत्पृष्ठतो रणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2162315, "chapter_id": 4505, "verse_number": "२८", "content_sanskrit": "एकस्य च बहूनां च सन्निपातो महाहवे ।\nविशेषतो नृपतिना विषमः प्रतिभाति मे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2162316, "chapter_id": 4505, "verse_number": "२९", "content_sanskrit": "सोऽत्यन्तसुखसंवृद्धो लक्ष्म्या लोकस्य चेश्वरः ।\nएको बहून् समासाद्य कच्चिन्नासीत् पराङ्मुखः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2162317, "chapter_id": 4505, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2162318, "chapter_id": 4505, "verse_number": "३०", "content_sanskrit": "राजन् सङ्ग्राममाश्चर्यं तव पुत्रस्य भारत ।\nएकस्य च बहूनां च शृणुष्व गदतोऽद्भुतम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2162319, "chapter_id": 4505, "verse_number": "३१", "content_sanskrit": "दुर्योधनेन सहसा पाण्डवी पृतना रणे ।\nनळिनी द्विरदेनेव समन्ताद् विप्रलोडिता\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2162320, "chapter_id": 4505, "verse_number": "३२", "content_sanskrit": "तथा सेनां कृतां दृष्ट्वा तव पुत्रेण कौरव ।\nभीमसेनपुरोगास्तं पाञ्चालाः समुपाद्रवन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2162321, "chapter_id": 4505, "verse_number": "३३", "content_sanskrit": "स भीमसेनं दशभिर्माद्रीपुत्रौ त्रिभिस्त्रिभिः ।\nविराटद्रुपदौ षड्भिः शतेन च शिखण्डिनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2162322, "chapter_id": 4505, "verse_number": "३४", "content_sanskrit": "धृष्टद्युम्नं च विंशत्या धर्मपुत्रं च सप्तभिः ।\nकेकयान् दशभिर्विद्ध्वा द्रौपदेयांस्त्रिभिस्त्रिभिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2162323, "chapter_id": 4505, "verse_number": "३५", "content_sanskrit": "शतशश्चापरान् योधान् सद्विपांश्च रथान् रणे ।\nशरैरवचकर्तोग्रैः क्रुद्धोऽन्तक इव प्रजाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2162324, "chapter_id": 4505, "verse_number": "३६", "content_sanskrit": "न सन्दधन् विमुञ्चन् वा मण्डलीकृतकार्मुकः ।\nअदृश्यत रिपून् निघ्नन् शिक्षयाऽस्त्रबलेन च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2162325, "chapter_id": 4505, "verse_number": "३७", "content_sanskrit": "तस्य तान् निघ्नतः शत्रून् हेमपृष्ठं महद्धनुः ।\nभल्लाभ्यां पाण्डवो ज्येष्ठस्त्रिधा चिच्छेद मारिष\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2162326, "chapter_id": 4505, "verse_number": "३८", "content_sanskrit": "विव्याध चैनं बहुभिः सम्यगस्तैः शितैः शरैः ।\nमर्माण्याशु समासाद्य ते भित्त्वा क्षितिमाविशन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2162327, "chapter_id": 4505, "verse_number": "३९", "content_sanskrit": "ततः प्रमुदिताः पार्थाः परिवव्रुर्युधिष्ठिरम् ।\nयथा वृत्रवधे देवा मुदा शक्रं महर्षिभिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2162328, "chapter_id": 4505, "verse_number": "४०", "content_sanskrit": "अथ दुर्योधनो राजा दृढमादाय कार्मुकम् ।\nतिष्ठ तिष्ठेति राजानं ब्रुवन् पाण्डवमभ्ययात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2162329, "chapter_id": 4505, "verse_number": "४१", "content_sanskrit": "तं तथावादिनं राजंस्तव पुत्रं महारथम् ।\nप्रत्युद्ययुः प्रमुदिताः पाञ्चाला जयगृद्धिनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2162330, "chapter_id": 4505, "verse_number": "४२", "content_sanskrit": "तान् द्रोणः प्रतिजग्राह परीप्सन् युधि पाण्डवम् ।\nचण्डवातोद्धुतान् मेघान् सजलानचलो यथा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2162331, "chapter_id": 4505, "verse_number": "४३", "content_sanskrit": "तत्र राजन् महानासीत् सङ्ग्रामो भीतिवर्धनः ।\nपाण्डवानां महाराज तावकानां च संयुगे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2162332, "chapter_id": 4505, "verse_number": "४४", "content_sanskrit": "ततः शब्दो महानासीद् यातो येन धनञ्जयः ।\nअतीव सर्वशब्देभ्यो रोमहर्षकरः प्रभो \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2162333, "chapter_id": 4505, "verse_number": "४५", "content_sanskrit": "रुद्रस्याक्रीडसङ्काशः संहारः सर्वदेहिनाम्\nअर्जुनस्य महाबाहो तावकानां च धन्विनाम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2162334, "chapter_id": 4505, "verse_number": "४६", "content_sanskrit": "मध्ये भारतसैन्यस्य माधवस्य महारणे ।\nद्रोणस्यापि परैः सार्धं व्यूहद्वारे महारणे\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2162335, "chapter_id": 4505, "verse_number": "४७", "content_sanskrit": "एवमेव क्षयो वृत्तः पृथिव्यां पृथिवीपते ।\nक्रुद्धेऽर्जुने तथा द्रोणे सात्वते च महारथे\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2162336, "chapter_id": 4505, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि दशाधिकशततमोऽध्यायः ॥११०॥\nजयद्रथवधपर्वणि चतुस्त्रिंशोऽध्यायः ॥३४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]