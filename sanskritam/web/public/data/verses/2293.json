[{"id": 2060395, "chapter_id": 2293, "verse_number": "८-१४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060396, "chapter_id": 2293, "verse_number": "८-१४-१", "content_sanskrit": "सहदेवं तथा क्रुद्धं निघ्नन्तं तव वाहिनीम्।\nदुःशासनो महाराज भ्राता भ्रातरमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060397, "chapter_id": 2293, "verse_number": "८-१४-२", "content_sanskrit": "तौ समेतौ महाराज दृष्ट्वा तत्र महारथाः।\nसिंहनादरवांश्चक्रुर्वासांस्यादुधुवुश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060398, "chapter_id": 2293, "verse_number": "८-१४-३", "content_sanskrit": "ततो भारत रुष्टेन तव पुत्रेण धन्विना।\nपाण्डुपुत्रस्त्रिभिर्बाणैर्वक्षस्यभिहतो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060399, "chapter_id": 2293, "verse_number": "८-१४-४", "content_sanskrit": "सहदेवस्ततो राजन्नाराचेन तवात्मजम्।\nविद्व्वा विव्याध सप्तत्या सारथिं च त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060400, "chapter_id": 2293, "verse_number": "८-१४-५", "content_sanskrit": "दुःशासनस्ततश्चापं छित्त्वा राजन्महाहवे।\nसहदेवं त्रिसप्तत्या बाहोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060401, "chapter_id": 2293, "verse_number": "८-१४-६", "content_sanskrit": "सहदेवस्तु सङ्क्रुद्धः खङ्गं गृह्य महाहवे।\nआविध्य प्रासृजत्तूर्णं तव पुत्रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060402, "chapter_id": 2293, "verse_number": "८-१४-७", "content_sanskrit": "समार्गणगुणं चापं छित्त्वा तस्य महानसिः।\nनिपपात ततो भूमौ च्युतः सर्प इवाम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060403, "chapter_id": 2293, "verse_number": "८-१४-८", "content_sanskrit": "अथान्यद्धनुरादाय सहदेवः प्रतापवान्।\nदुःशासनाय चिक्षेप बाणमन्तकरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060404, "chapter_id": 2293, "verse_number": "८-१४-९", "content_sanskrit": "तमापतन्तं विशिखं यमदण्डोपमत्विषम्।\nखङ्गेन शितधारेण द्विधा चिच्छेद कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060405, "chapter_id": 2293, "verse_number": "८-१४-१०", "content_sanskrit": "ततस्तं निशितं खङ्गमाविध्य युधि सत्वरः।\nधनुश्चान्यत्समादाय शरं जग्राह वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060406, "chapter_id": 2293, "verse_number": "८-१४-११", "content_sanskrit": "तमापतन्तं सहसा निस्त्रिंशं निशितैः शरैः।\nपातयामास समरे सहदेवो हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060407, "chapter_id": 2293, "verse_number": "८-१४-१२", "content_sanskrit": "ततो बाणांश्चतुः षष्टिं तव पुत्रो महारणे।\nसहदेवरथं तूर्णं प्रेषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060408, "chapter_id": 2293, "verse_number": "८-१४-१३", "content_sanskrit": "ताच्छरान्समरे राजन्वेगेनापपतो बहून्।\nएकैकं पञ्चभिर्बाणैः सहदेवो न्यकृतन्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060409, "chapter_id": 2293, "verse_number": "८-१४-१४", "content_sanskrit": "सन्निवार्य महाबाणान्सहदेवः प्रतापवान्।\nअथास्मै सुबहून्बाणान्प्रेषयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060410, "chapter_id": 2293, "verse_number": "८-१४-१५", "content_sanskrit": "तान्वाणांस्तव पुत्रोऽपि छित्त्वैकैकं त्रिभिः शरैः।\nननाद सुमहानादं नादयानो वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060411, "chapter_id": 2293, "verse_number": "८-१४-१६", "content_sanskrit": "ततो दुःशासनो राजन्द्वाभ्यां पाण्डुसुतं रणे।\nसारथिं नवभिर्बाणैर्माद्रोयस्य समाचिनोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060412, "chapter_id": 2293, "verse_number": "८-१४-१७", "content_sanskrit": "ततः क्रुद्धो महाराज सदहेवः प्रतापवान्।\nसमाधत्त शरं घोरं मृत्युकालान्तकोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060413, "chapter_id": 2293, "verse_number": "८-१४-१८", "content_sanskrit": "विकृष्य बलवच्चापं तव पुत्राय सोऽसृजत्।\nस तं निर्भिद्य वेगेन भित्त्वा च कवचं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060414, "chapter_id": 2293, "verse_number": "८-१४-१९", "content_sanskrit": "प्राविशद्वरणीं राजन्वल्मीकमिव पन्नगः।\nततः सम्मुमुहे राजंस्तव पुत्रो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060415, "chapter_id": 2293, "verse_number": "८-१४-२०", "content_sanskrit": "मूढं चैनं समालोक्य सारथिस्त्वरितो रथम्।\nअपोवाह भृशं त्रस्तो वध्यमानं शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060416, "chapter_id": 2293, "verse_number": "८-१४-२१", "content_sanskrit": "पराजित्य रणे तं तु कौरव्यं पाण्डुनन्दनः।\nदुर्योधनबलं दृष्ट्वा प्रममाथ समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060417, "chapter_id": 2293, "verse_number": "८-१४-२२", "content_sanskrit": "पिपीलिकपुटं राजन्यथा मृद्गन्नरो रुषा।\nतथा सा कौरवी सेना मृदिता तेन भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060418, "chapter_id": 2293, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]