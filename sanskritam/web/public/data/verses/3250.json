[{"id": 2104216, "chapter_id": 3250, "verse_number": "१४-१०६-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवं श्रुत्वा परं पुण्यं कपिलादानमुत्तमम्।\nधर्मपुत्रः प्रहृष्टात्मा केशवं पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104217, "chapter_id": 3250, "verse_number": "१४-१०६-२", "content_sanskrit": "देवदेवश कपिला यदा विप्राय दीयते।\nकथं सर्वेषु चाङ्गेषु तस्यास्तिष्ठन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104218, "chapter_id": 3250, "verse_number": "१४-१०६-३", "content_sanskrit": "याश्चैताः कपिलाः प्रोक्ता दश चैव त्वया मम।\nतासां कति सुरश्रेष्ठ् कपिलाः पुण्यलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104219, "chapter_id": 3250, "verse_number": "१४-१०६-४", "content_sanskrit": "कथं वाऽनुगृहीतास्ताः सुरैः पितृगणैरपि।\nकेन युक्ताश्च वर्णेन श्रोतुं कौतूहलं मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104220, "chapter_id": 3250, "verse_number": "१४-१०६-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104221, "chapter_id": 3250, "verse_number": "१४-१०६-५", "content_sanskrit": "युधिष्ठिरेणैवमुक्तः केशवः सत्यवाक्तदा।\nगुह्यानां परमं गुह्यं वक्तुमेवोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104222, "chapter_id": 3250, "verse_number": "१४-१०६-६", "content_sanskrit": "शृणु राजन्पवित्रं वै रहस्यं धर्ममुत्तमम्॥\nग्रहणीयं सत्यमिदं न श्राव्यं हेतुवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104223, "chapter_id": 3250, "verse_number": "१४-१०६-७", "content_sanskrit": "यदा वत्सस्य पादौ द्वौ प्रसवे शिरसा सह।\nदृश्येते दानकालं तत्तमाहुर्मुनिसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104224, "chapter_id": 3250, "verse_number": "१४-१०६-८", "content_sanskrit": "अन्तरिक्षगतो वत्सो यावद्भूमिं न यास्यति।\nगौस्तावत्पृथिवी ज्ञेया तस्माद्देया तु तादृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104225, "chapter_id": 3250, "verse_number": "१४-१०६-९", "content_sanskrit": "यावन्ति धेन्वा रोमाणि सवत्साया युधिष्ठिर।\nयावत्यः सिकताश्चापि गर्भोदकपरिप्लुताः।\nतावद्वर्षसहस्राणि दाता स्वर्गे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104226, "chapter_id": 3250, "verse_number": "१४-१०६-१०", "content_sanskrit": "सुवर्णाभरणां कृत्वा सव्तसां कपिलां तिलैः।\nप्रच्छाद्य तां तु दद्याद्वै सर्वरत्नैरलङ्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104227, "chapter_id": 3250, "verse_number": "१४-१०६-११", "content_sanskrit": "ससमुद्रा नदी तेन सशैलवनकानना।\nचतुरन्ता भवेद्दत्ता नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104228, "chapter_id": 3250, "verse_number": "१४-१०६-१२", "content_sanskrit": "पृथिवीदानतुल्येन तेन दानेन मानवः।\nसंसारसागरात्तीर्णो याति लोकं प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104229, "chapter_id": 3250, "verse_number": "१४-१०६-१३", "content_sanskrit": "ब्रह्महा भ्रूणहा गोघ्नो यदि वा गुरुतल्पगः।\nमहापातकयुक्तोपि एतद्दानेन शुद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104230, "chapter_id": 3250, "verse_number": "१४-१०६-१४", "content_sanskrit": "इदं पठति यः पुण्यं कपिलादानमुत्तमम्।\nप्रातरुत्थाय मद्भक्त्या तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104231, "chapter_id": 3250, "verse_number": "१४-१०६-१५", "content_sanskrit": "मनसा कर्मणा वाचा मतिपूर्वं युधिष्ठिर।\nपापं रात्रिकृतं हन्यादस्याध्यायस्य पाठकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104232, "chapter_id": 3250, "verse_number": "१४-१०६-१६", "content_sanskrit": "इदमावर्तमानस्तु श्राद्धे यस्तर्पयेद्द्विजान्।\nतस्याप्यमृतमश्नन्ति पितरोऽत्यन्तहर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104233, "chapter_id": 3250, "verse_number": "१४-१०६-१७", "content_sanskrit": "यश्चेदं शृणुयाद्भक्त्या मद्गतेनान्तरात्मना।\nतस्य रात्रिकृतं सर्वुं पापमाशु प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104234, "chapter_id": 3250, "verse_number": "१४-१०६-१८", "content_sanskrit": "अतः परं विशेषं तु कपिलानां ब्रवीमि ते।\nयाश्चैताः कपिलाः प्रोक्ता दश राजन्मया तव।\nतासां चतस्रः प्रवराः पुण्याः पापप्रणाशनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104235, "chapter_id": 3250, "verse_number": "१४-१०६-१९", "content_sanskrit": "सुवर्णकपिला पुण्या तथा रक्ताक्षिपिङ्गला।\nपिङ्गलाक्षी च या गौश्च या स्यात्पिङ्गलपिङ्गला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104236, "chapter_id": 3250, "verse_number": "१४-१०६-२०", "content_sanskrit": "एताश्चतस्रः प्रवराः पवित्राः पापनाशनाः।\nनमस्कृता वा दृष्टा वा घ्नन्ति पापं नरस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104237, "chapter_id": 3250, "verse_number": "१४-१०६-२१", "content_sanskrit": "यस्यैताः कपिलाः सन्ति गृहे पापप्रणाशनाः।\nतत्र श्रीर्विजयः कीर्तिः स्फीता नित्यं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104238, "chapter_id": 3250, "verse_number": "१४-१०६-२२", "content_sanskrit": "एतासां प्रीतिमायाति क्षीरेण तु वृषध्वजः।\nदध्ना च त्रिदशाः सर्वे घृतेन तु हुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104239, "chapter_id": 3250, "verse_number": "१४-१०६-२३", "content_sanskrit": "पितरः पितामहाश्चैव तथैव प्रपितामहाः।\nसकृद्देत्तेन तुष्यन्ति वर्षकोटिं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104240, "chapter_id": 3250, "verse_number": "१४-१०६-२४", "content_sanskrit": "कपिलाया घृतं क्षीरं दधि पायसमेव वा।\nश्रोत्रियेभ्यः सकृद्दत्वा नरः पापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104241, "chapter_id": 3250, "verse_number": "१४-१०६-२५", "content_sanskrit": "उपवासं तु यः कृत्वाऽप्यहोरात्रं जितेन्द्रियः।\nकपिलापञ्चगव्यं तु पीत्वा चान्द्रायणात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104242, "chapter_id": 3250, "verse_number": "१४-१०६-२६", "content_sanskrit": "सौम्ये मुहूर्ते तत्प्रशय शुद्धात्मा शुद्धमानसः।\nक्रोधानृतविनिर्मुक्तो मद्गतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104243, "chapter_id": 3250, "verse_number": "१४-१०६-२७", "content_sanskrit": "कपिलापञ्चगव्येन सुमन्त्रेण पृथक्पथक्।\nयो मत्प्रतिकृतिं वाऽपि शङ्कराकृतिमेव वा।\nस्नापयेद्विषुवे यस्तु सोऽश्वमेधफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104244, "chapter_id": 3250, "verse_number": "१४-१०६-२८", "content_sanskrit": "स मुक्तपापः शुद्धात्मा यानेनांबरशोभिना।\nमम लोकं व्रजेन्मुक्तो रुद्रलोकमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104245, "chapter_id": 3250, "verse_number": "१४-१०६-२९", "content_sanskrit": "ब्रह्मणा तु पुरा सृष्टा कपिला काञ्चनप्रभा।\nअग्निकुण्डात्परैर्मन्त्रैर्होमधेनुर्महाप्रभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104246, "chapter_id": 3250, "verse_number": "१४-१०६-३०", "content_sanskrit": "सृष्टमात्रां तु तां दृष्ट्वा देवा रुद्रादयो दिवि।\nसिद्धा ब्रह्मर्षयश्चैव वेदाः साङ्गाः सहाध्वरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104247, "chapter_id": 3250, "verse_number": "१४-१०६-३१", "content_sanskrit": "सागराः सरितश्चैव पर्वताः सबलाहकाः।\nगन्धर्वाप्सरसो यक्षाः पन्नगाश्चाप्युपस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104248, "chapter_id": 3250, "verse_number": "१४-१०६-३२", "content_sanskrit": "सर्वे विस्मयमापन्नाः शिखिमध्ये महाप्रभाम्।\nमन्त्रैशअच विविधैस्तां तु तुष्टुवुस्तामनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104249, "chapter_id": 3250, "verse_number": "१४-१०६-३३", "content_sanskrit": "कृताञ्जलिपुटाः सर्वे नातिशृङ्गीं त्रिलोचनाम्।\nमूर्ध्ना प्रणम्य तां भूमौ सवत्साममृतारणिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104250, "chapter_id": 3250, "verse_number": "१४-१०६-३४", "content_sanskrit": "ऊचुः प्राञ्जलयः सर्वे चतुर्वक्त्रं पितामहम्।\nआज्ञापय महादेव किं ते कुर्मः कथं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104251, "chapter_id": 3250, "verse_number": "१४-१०६-३५", "content_sanskrit": "एवमुक्तः सुरैः सर्वैर्ब्रह्मा वचनमब्रवीत्।\nभवन्तोप्यनुगृह्णन्तु दोग्ध्रीमेनां पयस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104252, "chapter_id": 3250, "verse_number": "१४-१०६-३६", "content_sanskrit": "होमधेनुरियं ज्ञेया ह्यग्नीन्संतर्पयिष्यति।\nअतोऽग्निस्तर्पितः सर्वान्भवतस्तर्पयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104253, "chapter_id": 3250, "verse_number": "१४-१०६-३७", "content_sanskrit": "प्रीताः क्षीरामृतेनास्या जातवीर्यपराक्रमाः।\nजयिष्यथ यथाकामं दानवान्सर्व एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104254, "chapter_id": 3250, "verse_number": "१४-१०६-३८", "content_sanskrit": "जातवीर्यबलैर्युक्ताः सत्ववन्तो जितेन्द्रियाः।\nअसङ्ख्येयबलाः सर्वे पालयिष्यथ वै प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104255, "chapter_id": 3250, "verse_number": "१४-१०६-३९", "content_sanskrit": "पालिताश्च प्रजाः सर्वा भवद्भिरिह धर्मतः।\nपूजयिष्यन्ति वा नित्यं यज्ञैर्विविधदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104256, "chapter_id": 3250, "verse_number": "१४-१०६-४०", "content_sanskrit": "एवमुक्ताः सुराः सर्वे ब्रह्मणा परमेष्ठिना।\nततः संहृष्टवदनाः कपिलायै वरं ददुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104257, "chapter_id": 3250, "verse_number": "१४-१०६-४१x", "content_sanskrit": "देवता ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104258, "chapter_id": 3250, "verse_number": "१४-१०६-४१", "content_sanskrit": "यस्माल्लोकहितायाद्य ब्रह्मणा त्वं विनिर्मिता।\nतस्मात्पूता पवित्रा च भव पापव्यपोहिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104259, "chapter_id": 3250, "verse_number": "१४-१०६-४२", "content_sanskrit": "ये त्वां दृष्ट्वा नमस्यन्ति स्पृष्ट्वा चापि करैर्नराः।\nतेषां वर्षकृतं पापं त्वद्भक्तानां प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104260, "chapter_id": 3250, "verse_number": "१४-१०६-४३", "content_sanskrit": "अकामकृतमज्ञानमदृष्टं यच्च पातकम्।\nत्वां दृष्ट्वा ये नमस्यन्ति नराः सर्वसहेति च।\nतेषां तद्विलयं याति तमः सूर्योदये यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104261, "chapter_id": 3250, "verse_number": "१४-१०६-४४x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104262, "chapter_id": 3250, "verse_number": "१४-१०६-४४", "content_sanskrit": "इत्युक्त्वाऽस्यै वरं दत्त्वा प्रययुस्ते यथागतम्।\nलोकनिस्तरणार्थाय सा च लोकांश्चचार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104263, "chapter_id": 3250, "verse_number": "१४-१०६-४५", "content_sanskrit": "तस्यामेव समुद्भूता ह्येताश्च कपिला नव।\nविचरन्ति महीमेनां लोकानुग्रहकारणात्।\nतस्मात्तु कपिला देया परत्र हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104264, "chapter_id": 3250, "verse_number": "१४-१०६-४६", "content_sanskrit": "यदा च दीयते राजन्कपिला ह्यग्निहोत्रिणे।\nतदा च शृङ्गयोस्तस्या विष्णुरिन्द्रश्च तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104265, "chapter_id": 3250, "verse_number": "१४-१०६-४७", "content_sanskrit": "चन्द्रवज्रधरौ चापि तिष्ठतः शृङ्गमूलयोः।\nशृङ्गमध्ये तथा ब्रह्मा ललाटे गोवृषध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104266, "chapter_id": 3250, "verse_number": "१४-१०६-४८", "content_sanskrit": "कर्णयोरश्विनौ देवौ चक्षुषी शशिभास्करौ।\nदन्तेषु मरुतो देवा जिह्वायां वाक्सरलस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104267, "chapter_id": 3250, "verse_number": "१४-१०६-४९", "content_sanskrit": "रोमकूपेषु मुनयश्चर्मण्येव प्रजापतिः।\nनिश्श्वासेषु स्थिता वेदाः सषडङ्गपदक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104268, "chapter_id": 3250, "verse_number": "१४-१०६-५०", "content_sanskrit": "नासापुटे स्थिता गन्धाः पुष्पाणि सुरभीणि च।\nअधरे वसवः सर्वे मुखे चाग्निः प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104269, "chapter_id": 3250, "verse_number": "१४-१०६-५१", "content_sanskrit": "साध्या देवाः स्थिताः कक्षे ग्रीवायां पार्वती स्थिता।\nपृष्ठे च नक्षत्रगणाः ककुद्देशे नभस्स्थलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104270, "chapter_id": 3250, "verse_number": "१४-१०६-५२", "content_sanskrit": "अपाने सर्वतीर्थानि गोमूत्रे जाह्नवी स्वयम्।\nइष्टतुष्टमया लक्ष्मीर्गोमये वसती तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2104271, "chapter_id": 3250, "verse_number": "१४-१०६-५३", "content_sanskrit": "नासिकायां सदा देवी ज्येष्ठा वसति भामिनी।\nश्रोणीतटस्थाः पितरो रमा लाङ्गूलमाश्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2104272, "chapter_id": 3250, "verse_number": "१४-१०६-५४", "content_sanskrit": "पार्श्वयोरुभयोः सर्वे विश्वेदेवाः प्रतिष्ठिताः।\nतिष्ठत्युरसि तासां तु प्रीतः शक्तिधरो गुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2104273, "chapter_id": 3250, "verse_number": "१४-१०६-५५", "content_sanskrit": "जानजङ्घोरुदेशेषु पञ्च तिष्ठन्ति वायवः।\nखुरमध्येषु गन्धर्वाः खुराग्रेषु च पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2104274, "chapter_id": 3250, "verse_number": "१४-१०६-५६", "content_sanskrit": "चत्वारः सागराः पूर्णास्तस्या एव पयोधराः।\nरतिर्मेधा क्षमा स्वाहा श्रद्धा शान्तिर्धृतिः स्मृतिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2104275, "chapter_id": 3250, "verse_number": "१४-१०६-५७", "content_sanskrit": "कीर्तिर्दीप्तिः क्रिया कान्तिस्तुष्टिः पुष्टिस्च सन्ततिः।\nदिशश्च प्रदिशश्चैव सेवन्ते कपिलां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2104276, "chapter_id": 3250, "verse_number": "१४-१०६-५८", "content_sanskrit": "देवा पितृगणाश्चापि गन्धर्वाप्सरसां गणाः।\nलोका द्वीपार्णवाश्चैव गङ्गाद्याः सरितस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2104277, "chapter_id": 3250, "verse_number": "१४-१०६-५९", "content_sanskrit": "देवाः पितृगणाश्चापि वेदाः साङ्गाः सहाध्वरैः।\nवेदोक्तैर्विविधैर्मन्त्रैः स्तुवन्ति हृषितास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2104278, "chapter_id": 3250, "verse_number": "१४-१०६-६०", "content_sanskrit": "विद्याधराश्च ये सिद्धा भूतास्तारागणास्तथा।\nपुष्पवृष्टिं च वर्षन्ति प्रनृत्यन्ति च हर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2104279, "chapter_id": 3250, "verse_number": "१४-१०६-६१", "content_sanskrit": "ब्रह्मणोत्पादिता देवी वह्निकुण्डान्महाप्रभा।\nनमस्ते कपिले पुण्ये सर्वदेवैर्नमस्कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2104280, "chapter_id": 3250, "verse_number": "१४-१०६-६२", "content_sanskrit": "कपिलेऽथ महासत्वे सर्वतीर्थमये शुभे।\nदातारं स्वजनोपेतं ब्रह्मलोकं नय स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2104281, "chapter_id": 3250, "verse_number": "१४-१०६-६३", "content_sanskrit": "अहो रत्नमिदं पुण्यं सर्वदुःखघ्नमुत्तमम्।\nअहो धर्मार्जितं शुद्धमिदमग्र्यं महाधनम्।\nइत्याकाशस्थितस्ते तु सर्वदेवा जपन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2104282, "chapter_id": 3250, "verse_number": "१४-१०६-६४", "content_sanskrit": "तस्याः प्रतिग्रहीता च भुङ्क्ते यावद्द्विजोत्तमः।\nतावद्देवगणाः सर्वे कपिलामर्चयन्ति च।\nस्वर्णशृङ्गीं रूप्यखुरां गन्धैः पुष्पैः सुपूजिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2104283, "chapter_id": 3250, "verse_number": "१४-१०६-६५", "content_sanskrit": "वस्त्राभ्यामहताभ्यां तु यावत्तिष्ठत्यलङ्कृता।\nतावद्यदिच्छेत्कपिला मन्त्रपूता सुसंस्कृता।\nभूलोकवासिनः सर्वान्ब्रह्मलोकं नयेत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2104284, "chapter_id": 3250, "verse_number": "१४-१०६-६६", "content_sanskrit": "भूरश्वः कनकं गावो रूप्यमश्वं तिला यवाः।\nदीयमानानि विप्राय प्रहृष्यन्ति दिनेदिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2104285, "chapter_id": 3250, "verse_number": "१४-१०६-६७", "content_sanskrit": "अथ त्वश्रोत्रियेभ्यो वै तानि दत्तानि पाण्डव।\nतथा निन्दन्त्यथात्मानमशुभं किंनु नः कृतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2104286, "chapter_id": 3250, "verse_number": "१४-१०६-६८", "content_sanskrit": "अहो रक्षःपिशाचैश्च लुप्यमानाः समन्ततः।\nयास्यामो निरयं शीघ्रमिति शोचन्ति तानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2104287, "chapter_id": 3250, "verse_number": "१४-१०६-६९", "content_sanskrit": "एतान्यपि द्विजेभ्यो वै श्रोत्रियेभ्यो विशेषतः।\nदीयमानानि वर्धन्ते दातारं तारयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2104288, "chapter_id": 3250, "verse_number": "१४-१०६-७०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2104289, "chapter_id": 3250, "verse_number": "१४-१०६-७०", "content_sanskrit": "देवदेवेश दैत्यघ्न कालः को हव्यकव्ययोः।\nके तत्रि पूजामर्हन्ति वर्जनीयाश्च के द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2104290, "chapter_id": 3250, "verse_number": "१४-१०६-७१x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2104291, "chapter_id": 3250, "verse_number": "१४-१०६-७१", "content_sanskrit": "दैवं पूर्वाह्णिकं ज्ञेयं पैतृकं चापराह्णिकम्।\nकालहीनं च यद्दानं तद्दानं राजसं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2104292, "chapter_id": 3250, "verse_number": "१४-१०६-७२", "content_sanskrit": "अवघुष्टं च यद्भुक्तमनृतेन च भारत।\nपरामृष्टं शुना वाऽपि तद्भागं राक्षसं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2104293, "chapter_id": 3250, "verse_number": "१४-१०६-७३", "content_sanskrit": "यावन्तः पतिता विप्रा जडोन्मत्तादयोपि च।\nदैवे च पित्र्ये ते विप्रा राजन्नार्हन्ति सत्क्रियां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2104294, "chapter_id": 3250, "verse_number": "१४-१०६-७४", "content_sanskrit": "क्लीबः प्लङ्गी च कृष्ठी च राजयक्ष्मान्वितश्च यः।\nअपस्मारी च यश्चापि पित्र्ये नार्हति सत्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2104295, "chapter_id": 3250, "verse_number": "१४-१०६-७५", "content_sanskrit": "चिकित्सका देवलका मिथ्यानियमधारिणः।\nसोमविक्रयिणश्चापि श्राद्धे नार्हन्ति सत्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2104296, "chapter_id": 3250, "verse_number": "१४-१०६-७६", "content_sanskrit": "एकोद्दिष्टे च ये चान्नं भुञ्जते विधिवद्द्बिजाः।\nचान्द्रायणमकृत्वा ते पुनर्नार्हन्ति सत्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2104297, "chapter_id": 3250, "verse_number": "१४-१०६-७७", "content_sanskrit": "गायका नर्तकाश्चैव प्लवका वादकास्तथा।\nकथका यौधिकाश्चैव श्राद्धे नार्हन्ति सत्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2104298, "chapter_id": 3250, "verse_number": "१४-१०६-७८", "content_sanskrit": "अनग्नयश्च ये विप्राः शवनिर्यातकाश्च ये।\nस्तेनाश्चापि विकर्मस्था राजन्नार्हन्ति सत्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2104299, "chapter_id": 3250, "verse_number": "१४-१०६-७९", "content_sanskrit": "अपरिज्ञातपूर्वाश्च गणपुत्राश्च ये द्विजाः।\nपुत्रिकापुत्रकाश्चापि श्राद्धे नार्हन्ति सत्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2104300, "chapter_id": 3250, "verse_number": "१४-१०६-८०", "content_sanskrit": "रणकर्ता च यो विप्रो यश्च वाणिज्यको द्विजः।\nप्राणिविक्रयवृत्तिश्च श्राद्धे नार्हन्ति सत्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2104301, "chapter_id": 3250, "verse_number": "१४-१०६-८१", "content_sanskrit": "चीर्णव्रतगुणैर्युक्ता नित्यं स्वाध्यायतत्पराः।\nसावित्रीज्ञाः क्रियावन्तस्ते श्राद्धे सत्कृतिक्षमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2104302, "chapter_id": 3250, "verse_number": "१४-१०६-८२", "content_sanskrit": "श्राद्धस्य ब्राह्मणः कालः प्राप्तं दघि घृतं तथा।\nदर्भाः सुमनसः क्षेत्रं तत्काले श्राद्धदो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2104303, "chapter_id": 3250, "verse_number": "१४-१०६-८३", "content_sanskrit": "चारित्रनिरता राजन्कृशा ये कृशवृत्तयः।\nअर्थिनश्चोपगच्छन्ति तेभ्यो दत्तं महत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2104304, "chapter_id": 3250, "verse_number": "१४-१०६-८४", "content_sanskrit": "तपस्विनश्च ये विप्रास्तथा भैक्षचराश्च ये।\nअर्थिनः केचिदिच्छन्ति तेषां दत्तं महत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2104305, "chapter_id": 3250, "verse_number": "१४-१०६-८५", "content_sanskrit": "एवं धर्मभूतां श्रेष्ठ ज्ञात्वा सर्वात्मना तदा।\nर्श्रोत्रियाय दरिद्राय प्रयच्छानुपकारिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2104306, "chapter_id": 3250, "verse_number": "१४-१०६-८६", "content_sanskrit": "दानं यत्ते प्रियं किंचिच्छ्रोत्रियाणां च यत्प्रियम्।\nतत्प्रयच्छस्व धर्मज्ञ यदीच्छसि तदक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2104307, "chapter_id": 3250, "verse_number": "१४-१०६-८७", "content_sanskrit": "निरयं ये च गच्छन्ति तच्छृणुष्व युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2104308, "chapter_id": 3250, "verse_number": "१४-१०६-८८", "content_sanskrit": "गुर्वर्थं वा भयार्थं वा नोचेदन्यत्र पाण्डव।\nवदन्ति येऽनृतं विप्रास्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2104309, "chapter_id": 3250, "verse_number": "१४-१०६-८९", "content_sanskrit": "परदारापहर्तारः परदारामिमर्शकाः।\nपरारप्रयोक्तारस्तें वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2104310, "chapter_id": 3250, "verse_number": "१४-१०६-९०", "content_sanskrit": "सूचकाः संधिभेत्तारः परद्रव्योपजीविनः।\nअकृतज्ञाश्च मित्राणां ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2104311, "chapter_id": 3250, "verse_number": "१४-१०६-९१", "content_sanskrit": "वर्णाश्रमाणां ये बाह्याः पाषण्डाश्चैव पापिनः।\nउपासते च तानेव ते सर्वे नरकालयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2104312, "chapter_id": 3250, "verse_number": "१४-१०६-९२", "content_sanskrit": "वेदविक्रयिणश्चैव वेदानां चैव दूषकाः।\nवेदानां लेखकाश्चैव ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2104313, "chapter_id": 3250, "verse_number": "१४-१०६-९३", "content_sanskrit": "रसविक्रयिणो राजन्विषविक्रयिणश्च ये।\nक्षीरविक्रयिणश्चापि ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2104314, "chapter_id": 3250, "verse_number": "१४-१०६-९४", "content_sanskrit": "चण्डालेभ्यश्च ये क्षीरं प्रयच्छन्ति नराधमाः।\nअर्थार्थमथवा स्नेहात्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2104315, "chapter_id": 3250, "verse_number": "१४-१०६-९५", "content_sanskrit": "पशूनां दमक**यैव तथा नासानुवेधकाः\nपुंस्त्वहिंसाकरस्चैव ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2104316, "chapter_id": 3250, "verse_number": "१४-१०६-९६", "content_sanskrit": "अदातारः समर्था ये द्रव्याणां लोभकारणात्।\nदीनानन्धान्न पश्यन्ति ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2104317, "chapter_id": 3250, "verse_number": "१४-१०६-९७", "content_sanskrit": "क्षान्तान्दान्तान्कृशान्प्राज्ञान्दीर्घकालं सहोषितान्।\nत्यजन्ति कृतकृत्या ये ते वा निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2104318, "chapter_id": 3250, "verse_number": "१४-१०६-९८", "content_sanskrit": "बालानामपि वृद्धानां श्रान्तानां चापि ये नराः।\nअदत्त्वाऽश्नान्ति मृष्टान्नं ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2104319, "chapter_id": 3250, "verse_number": "१४-१०६-९९", "content_sanskrit": "एते पूर्वर्षिभिः प्रोक्ता नरा निरयगामिनः।\nये स्वर्गं समनुप्राप्तास्ताञ्शृणुष्व युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2104320, "chapter_id": 3250, "verse_number": "१४-१०६-१००", "content_sanskrit": "दानेन तपसा चैव सत्येन च दमेन च।\nये धर्ममनुवर्तन्ते ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2104321, "chapter_id": 3250, "verse_number": "१४-१०६-१०१", "content_sanskrit": "शुश्रूषयाऽप्युपाध्यायाच्छ्रुतमादाय पाण्डव।\nये प्रतिग्रहनिस्स्नेहास्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2104322, "chapter_id": 3250, "verse_number": "१४-१०६-१०२", "content_sanskrit": "मधुमांसासवेभ्यस्तु निवृत्ता व्रतवत्तु ये।\nपरदारनिवृत्ता ये ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2104323, "chapter_id": 3250, "verse_number": "१४-१०६-१०३", "content_sanskrit": "मातरं पितरं चैव शुश्रूषन्ति च ये नराः।\nभ्रहातॄणामपि सस्नेहास्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2104324, "chapter_id": 3250, "verse_number": "१४-१०६-१०४", "content_sanskrit": "ये तु भोजनकाले तु निर्याताश्चातिथिप्रियाः।\nद्वाररोधं न कुर्वन्ति ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2104325, "chapter_id": 3250, "verse_number": "१४-१०६-१०५", "content_sanskrit": "वैवाहिकं तु कन्यानां दरिद्राणां च ये नराः।\nकारयन्ति च कुर्वन्ति ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2104326, "chapter_id": 3250, "verse_number": "१४-१०६-१०६", "content_sanskrit": "रसानामथ बीजानामोषधीनां तथैव च।\nदातारः श्रद्धयोपेतास्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2104327, "chapter_id": 3250, "verse_number": "१४-१०६-१०७", "content_sanskrit": "क्षेमाक्षेमं च मार्गेषु समानि विषमाणि च।\nअर्थिनां ये च वक्ष्यन्ति ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2104328, "chapter_id": 3250, "verse_number": "१४-१०६-१०८", "content_sanskrit": "पर्वद्वये चतुर्दश्यामष्टम्यां संध्ययोर्द्वयोः।\nआर्द्रायां जन्मनक्षत्रे विषुवे श्रवणेऽथवा।\nये ग्राम्यधर्मविरतास्ते नराः स्वर्गगाप्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2104329, "chapter_id": 3250, "verse_number": "१४-१०६-१०९", "content_sanskrit": "हव्यकव्यविधानं च नरकस्वर्गगामिनौ।\nधर्माधर्मौ च कथितौ किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2104330, "chapter_id": 3250, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि षडधिकशततमोऽध्यायः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}]