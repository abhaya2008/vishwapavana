[{"id": 2003932, "chapter_id": 1076, "verse_number": "१-७७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003933, "chapter_id": 1076, "verse_number": "१-७७-१", "content_sanskrit": "तस्मिन्नक्षत्रसंयोगे शुक्ले पुण्यर्क्षगेन्दुना।\nस राजा मुमुदे सम्राट् तया शर्मिष्ठया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003934, "chapter_id": 1076, "verse_number": "१-७७-२", "content_sanskrit": "प्रजानां श्रीरिवाभ्याशे शर्मिष्ठा ह्यभवद्वधूः।\nपन्नगीवोग्ररूपा वै देवयानी ममाप्यभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003935, "chapter_id": 1076, "verse_number": "१-७७-३", "content_sanskrit": "पर्जन्य इव सस्यानां देवानाममृतं यथा।\nतद्वन्ममापि संभूता शर्मिष्ठा वार्षपर्वणी।\nइत्येवं मनसा ज्ञात्वा देवयानीमवर्जयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003936, "chapter_id": 1076, "verse_number": "१-७७-४", "content_sanskrit": "श्रुत्वा कुमारं जातं तु देवयानी शुचिस्मिता।\nचिन्तयामास दुःखार्ता शर्मिष्ठां प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003937, "chapter_id": 1076, "verse_number": "१-७७-५", "content_sanskrit": "अभिगम्य च शर्मिष्ठां देवयान्यब्रवीदिदम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003938, "chapter_id": 1076, "verse_number": "१-७७-५x", "content_sanskrit": "देवयान्वुवाच।\nकिमिदं वृजिनं सुभ्रु कृतं वै कामलुब्धया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003939, "chapter_id": 1076, "verse_number": "१-७७-६x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003940, "chapter_id": 1076, "verse_number": "१-७७-६", "content_sanskrit": "ऋषिरभ्यागतः कश्चिद्धर्मात्मा वेदपारगः।\nस मया वरदः कामं याचितो धर्मसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003941, "chapter_id": 1076, "verse_number": "१-७७-७", "content_sanskrit": "अपत्यार्थे स तु मया वृतो वै चारुहासिनि।\nनाहमन्यायतः काममाचरामि शुचिस्मिते।\nतस्मादृषेर्ममापत्यमिति सत्यं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003942, "chapter_id": 1076, "verse_number": "१-७७-८x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003943, "chapter_id": 1076, "verse_number": "१-७७-८", "content_sanskrit": "शोभनं भीरु यद्येवमथ स ज्ञायते द्विजः।\nगोत्रनामाभिजनतो वेत्तुमिच्छामि तं द्विजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003944, "chapter_id": 1076, "verse_number": "१-७७-९x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003945, "chapter_id": 1076, "verse_number": "१-७७-९", "content_sanskrit": "तपसा तेजसा चैव दीप्यमानं यथा रविम्।\nतं दृष्ट्वा मम संप्रष्टुं शक्तिर्नासीच्छुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003946, "chapter_id": 1076, "verse_number": "१-७७-१०x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003947, "chapter_id": 1076, "verse_number": "१-७७-१०", "content_sanskrit": "यद्येतदेवं शर्मिष्ठे न मन्युर्विद्यते मम।\nअपत्यं यदि ते लब्धं ज्येष्ठाच्छ्रेष्ठाच्च वै द्विजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003948, "chapter_id": 1076, "verse_number": "१-७७-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003949, "chapter_id": 1076, "verse_number": "१-७७-११", "content_sanskrit": "अन्योन्यमेवमुक्त्वा तु संप्रहस्य च ते मिथः।\nजगाम भार्गवी वेश्म तथ्यमित्यवजग्मुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003950, "chapter_id": 1076, "verse_number": "१-७७-१२", "content_sanskrit": "ययातिर्देवयान्यां तु पुत्रावजनयन्नृपः।\nयदुं च तुर्वसुं चैव शक्रविष्णू इवापरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003951, "chapter_id": 1076, "verse_number": "१-७७-१३", "content_sanskrit": "तस्मिन्काले तु राजर्षिर्ययातिः पृथिवीपतिः।\nमाध्वीकरससंयुक्तां मदिरां मदवर्धनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003952, "chapter_id": 1076, "verse_number": "१-७७-१४", "content_sanskrit": "पाययामास शुक्रस्य तनयां रक्तपिङ्गलाम्।\nपीत्वा पीत्वा च मदिरां देवयानी मुमोह सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003953, "chapter_id": 1076, "verse_number": "१-७७-१५", "content_sanskrit": "रुदती गायमाना च नृत्यन्ती च मुहुर्मुहुः।\nबहु प्रलपती देवी राजानमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003954, "chapter_id": 1076, "verse_number": "१-७७-१६", "content_sanskrit": "राजवद्रूपवेषौ ते किमर्थं त्वमिहागतः।\nकेन कार्येण संप्राप्तो निर्जनं गहनं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003955, "chapter_id": 1076, "verse_number": "१-७७-१७", "content_sanskrit": "द्विजश्रेष्ठ नृपश्रेष्ठो ययातिश्चोग्रदर्शनः।\nतस्मादितः पलायस्व हितमिच्छसि चेद्द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003956, "chapter_id": 1076, "verse_number": "१-७७-१८", "content_sanskrit": "इत्येवं प्रलपन्तीं तां देवयानीं तु नाहुषः।\nभर्त्सयामास वचनैरनर्हां पापवर्धनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003957, "chapter_id": 1076, "verse_number": "१-७७-१९", "content_sanskrit": "ततो वर्षवरान्मूकान्व्यङ्गान्वृद्धांश्च पङ्गुकान्।\nरक्षणे देवयान्याः स पोषणे च शशास तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003958, "chapter_id": 1076, "verse_number": "१-७७-२०", "content_sanskrit": "ततस्तु नाहुषो राजा शर्मिष्ठां प्राप्य बुद्धिमान्।\nरेमे च सुचिरं कालं तया शर्मिष्ठया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003959, "chapter_id": 1076, "verse_number": "१-७७-२१", "content_sanskrit": "तस्मादेव तु राजर्षेः शर्मिष्ठा वार्षपर्वणी।\nद्रुह्युं चानुं च पूरुं च त्रीन्कुमारानजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003960, "chapter_id": 1076, "verse_number": "१-७७-२२", "content_sanskrit": "ततः काले तु कस्मिंश्चिद्देवयानी शुचिस्मिता।\nययातिसहिता राजञ्जगाम रहितं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003961, "chapter_id": 1076, "verse_number": "१-७७-२३", "content_sanskrit": "ददर्श च तदा तत्र कुमारान्देवरूपिणः।\nक्रीडमानान्सुविश्रब्धान्विस्मिता चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003962, "chapter_id": 1076, "verse_number": "१-७७-२४x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003963, "chapter_id": 1076, "verse_number": "१-७७-२४", "content_sanskrit": "कस्यैते दारका राजन्देवपुत्रोपमाः शुभाः।\nवर्चसा रूपतश्चैव सदृशा मे मतास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003964, "chapter_id": 1076, "verse_number": "१-७७-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003965, "chapter_id": 1076, "verse_number": "१-७७-२५", "content_sanskrit": "एवं पृष्ट्वा तु राजानं कुमारान्पर्यपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003966, "chapter_id": 1076, "verse_number": "१-७७-२६", "content_sanskrit": "तस्मिन्काले तु तच्छ्रुत्वा धात्री तेषां वचोऽब्रवीत्।\nकिं न ब्रूत कुमारा वः पितरं वै द्विजर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003967, "chapter_id": 1076, "verse_number": "१-७७-२७x", "content_sanskrit": "कुमारा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003968, "chapter_id": 1076, "verse_number": "१-७७-२७", "content_sanskrit": "ऋषिश्च ब्राह्मणश्चैव द्विजातिश्चैव नः पिता।\nशर्मिष्ठा नानृतं ब्रूते देवयानि क्षमस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003969, "chapter_id": 1076, "verse_number": "१-७७-२८x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003970, "chapter_id": 1076, "verse_number": "१-७७-२८", "content_sanskrit": "किंनामधेयगोत्रो वः पुत्रका ब्राह्मणः पिता।\nप्रब्रूत तत्त्वतः क्षिप्रं कश्चासौ क्व च वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003971, "chapter_id": 1076, "verse_number": "१-७७-२९", "content_sanskrit": "प्रब्रूत मे यथा तथ्यं श्रोतुमिच्छामि तं ह्यहम्।\nएवमुक्ताः कुमारस्ते देवयान्या सुमध्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003972, "chapter_id": 1076, "verse_number": "१-७७-३०", "content_sanskrit": "तेऽदर्शयन्प्रदेशिन्या तमेव नृपसत्तमम्।\nशर्मिष्ठां मातरं चैव तथाऽऽचख्युश्च दारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003973, "chapter_id": 1076, "verse_number": "१-७७-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003974, "chapter_id": 1076, "verse_number": "१-७७-३१", "content_sanskrit": "इत्युक्त्वा सहितास्ते तु राजानमुपचक्रमुः।\nनाभ्यनन्दत तान्राजा देवयान्यास्तदान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003975, "chapter_id": 1076, "verse_number": "१-७७-३२", "content_sanskrit": "रुदन्तस्तेऽथ शर्मिष्ठामभ्ययुर्बालकास्ततः।\nअविब्रुवन्ती किंचिच्च राजानं चारुलोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003976, "chapter_id": 1076, "verse_number": "१-७७-३३", "content_sanskrit": "नातिदूराच्च राजानं सा चातिष्ठदवाङ्मुखी।\nश्रुत्वा तेषां तु बालानां सव्रीड इव पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003977, "chapter_id": 1076, "verse_number": "१-७७-३४", "content_sanskrit": "प्रतिवक्तुमशक्तोऽभूत्तूष्णींभूतोऽभवन्नृपः।\nदृष्ट्वा तु तेषां बालानां प्रणयं पार्थिवं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003978, "chapter_id": 1076, "verse_number": "१-७७-३५", "content_sanskrit": "बुद्ध्वा तु तत्त्वतो देवी शर्मिष्ठापिदमब्रवीत्।\nअभ्यागच्छति मां कश्चिदृषिरित्येवमब्रवीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003979, "chapter_id": 1076, "verse_number": "१-७७-३६", "content_sanskrit": "ययातिमेवं राजानं त्वं गोपायसि भामिनि।\nपूर्वमेव मया प्रोक्तं त्वया तु वृजिनं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003980, "chapter_id": 1076, "verse_number": "१-७७-३७", "content_sanskrit": "मदधीना सती कस्मादकार्षीर्विप्रियं मम।\nतमेवाऽऽसुरधर्मं त्वमास्थिता न बिभेषि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003981, "chapter_id": 1076, "verse_number": "१-७७-३८x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003982, "chapter_id": 1076, "verse_number": "१-७७-३८", "content_sanskrit": "यदुक्तमृषिरित्येव तत्सत्यं चारुहासिनि।\nन्यायतो धर्मतश्चैव चरन्ती न बिभेमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003983, "chapter_id": 1076, "verse_number": "१-७७-३९", "content_sanskrit": "यदा त्वया वृतो भर्ता वृत एव तदा मया।\nसखीभर्ता हि धर्मेण भर्ता भवति शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003984, "chapter_id": 1076, "verse_number": "१-७७-४०", "content_sanskrit": "पूज्यासि मम मान्या च ज्येष्ठा च ब्राह्मणी ह्यसि।\nत्वत्तोपि मे पूज्यतमो राजर्षिः किं न वेत्थ तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003985, "chapter_id": 1076, "verse_number": "१-७७-४१", "content_sanskrit": "त्वत्पित्रा मम गुरुणा सह दत्ते उभे शुभे।\nततो भर्ता च पूज्यश्च पोष्यां पोषयतीह माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003986, "chapter_id": 1076, "verse_number": "१-७७-४२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003987, "chapter_id": 1076, "verse_number": "१-७७-४२", "content_sanskrit": "श्रुत्वा तस्यास्ततो वाक्यं देवयान्यब्रवीदिदम्।\nरमस्वेह यथाकामं देव्या शर्मिष्ठया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003988, "chapter_id": 1076, "verse_number": "१-७७-४३", "content_sanskrit": "राजन्नाद्येह वत्स्यामि विप्रियं मे कृतं त्वया।\nइति जज्वाल कोपेन देवयानी ततो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003989, "chapter_id": 1076, "verse_number": "१-७७-४४", "content_sanskrit": "निर्दहन्तीव सव्रीडां शर्मिष्ठां समुदीक्ष्य च।\nअपविध्य च सर्वाणि भूषणान्यसितेक्षणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003990, "chapter_id": 1076, "verse_number": "१-७७-४५", "content_sanskrit": "सहसोत्पतितां श्यामां दृष्ट्वा तां साश्रुलोचनाम्।\nतूर्णं सकाशं काव्यस्य प्रस्थितां व्यथितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003991, "chapter_id": 1076, "verse_number": "१-७७-४६", "content_sanskrit": "अनुवव्राज संभ्रान्तः पृष्ठतः सान्त्वयन्नृपः।\nन्यवर्तत नचैव स्म क्रोधसंरक्तलोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003992, "chapter_id": 1076, "verse_number": "१-७७-४७", "content_sanskrit": "अविब्रुवन्ती किंचित्सा राजानं साश्रुलोचना।\nअचिरादेव संप्राप्ता काव्यस्योशनसोऽन्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2003993, "chapter_id": 1076, "verse_number": "१-७७-४८", "content_sanskrit": "सा तु दृष्ट्वै पितरमभिवाद्याग्रतः स्थिता।\nअनन्तरं यायातिस्तु पूजयामास भार्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2003994, "chapter_id": 1076, "verse_number": "१-७७-४९x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2003995, "chapter_id": 1076, "verse_number": "१-७७-४९", "content_sanskrit": "अधर्मेण जितो धर्मः प्रवृत्तमधरोत्तरम्।\nशर्मिष्ठयाऽतिवृत्ताऽस्मि दुहित्रा वृषपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2003996, "chapter_id": 1076, "verse_number": "१-७७-५०", "content_sanskrit": "त्रयोऽस्यां जनिताः पुत्रा राज्ञाऽनेन ययातिना।\nदुर्भगाया मम द्वौ तु पुत्रौ तात ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2003997, "chapter_id": 1076, "verse_number": "१-७७-५१", "content_sanskrit": "धर्मज्ञ इति विख्यात एष राजा भृगूद्वह।\nअतिक्रान्तश्च मर्यादां काव्यैतत्कथयामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2003998, "chapter_id": 1076, "verse_number": "१-७७-५२x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2003999, "chapter_id": 1076, "verse_number": "१-७७-५२", "content_sanskrit": "धर्मज्ञः सन्महाराज योऽधर्ममकृथाः प्रियम्।\nतस्माज्जरा त्वामचिराद्धर्षयिष्यति दुर्जया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2004000, "chapter_id": 1076, "verse_number": "१-७७-५३x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2004001, "chapter_id": 1076, "verse_number": "१-७७-५३", "content_sanskrit": "ऋतुं वै याचमानाया भगवन्नान्यचेतसा।\nदुहितुर्दानवेन्द्रस्य धर्म्यमेतत्कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2004002, "chapter_id": 1076, "verse_number": "१-७७-५४", "content_sanskrit": "ऋतुं वै याचमानाया न ददाति पुमानृतुम्।\nभ्रूणहेत्युच्यते ब्रह्मन् स इह ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2004003, "chapter_id": 1076, "verse_number": "१-७७-५५", "content_sanskrit": "अभिकामां स्त्रियं यश्च गम्यां रहसि याचितः।\nनोपैति स च धर्मेषु भ्रूणहेत्युच्यते बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2004004, "chapter_id": 1076, "verse_number": "१-७७-५६", "content_sanskrit": "यद्यद्वृणोति मां कश्चित्तत्तद्देयमिति व्रतम्।\nत्वया च सापि दत्ता मे नान्यं नाथमिहेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2004005, "chapter_id": 1076, "verse_number": "१-७७-५७", "content_sanskrit": "इत्येतानि समीक्ष्याहं कारणानि भृगूद्वह।\nअधर्मभयसंविग्नः शर्मिष्ठामुपजग्मिवान्।\nमत्वैतन्मे धर्म इति कृतं ब्रह्मन्क्षमस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2004006, "chapter_id": 1076, "verse_number": "१-७७-५८x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2004007, "chapter_id": 1076, "verse_number": "१-७७-५८", "content_sanskrit": "नन्वहं प्रत्यवेक्ष्यस्ते मदधीनोऽसि पार्थिव।\nमिथ्याचारस्य धर्मेषु चौर्यं भवति नाहुष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2004008, "chapter_id": 1076, "verse_number": "१-७७-५९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2004009, "chapter_id": 1076, "verse_number": "१-७७-५९", "content_sanskrit": "क्रुद्धेनोशनसा शप्तो ययातिर्नाहुषस्तदा।\nपूर्वं वयः परित्यज्य जरां सद्योऽन्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2004010, "chapter_id": 1076, "verse_number": "१-७७-६०x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2004011, "chapter_id": 1076, "verse_number": "१-७७-६०", "content_sanskrit": "अतृप्तो यौवनस्याहं देवयान्यां भृगूद्वह।\nप्रसादं कुरु मे ब्रह्मञ्जरेयं न विशेच्च माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2004012, "chapter_id": 1076, "verse_number": "१-७७-६१x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2004013, "chapter_id": 1076, "verse_number": "१-७७-६१", "content_sanskrit": "नाहं मृषा ब्रवीम्येतज्जरां प्राप्तोऽसि भूमिप।\nजरां त्वेतां त्वमन्यस्मिन्संक्रामय यदीच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2004014, "chapter_id": 1076, "verse_number": "१-७७-६२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2004015, "chapter_id": 1076, "verse_number": "१-७७-६२", "content_sanskrit": "राज्यभाक्स भवेद्ब्रह्मन्पुण्यभाक्कीर्तिभाक्तथा।\nयो मे दद्याद्वयः पुत्रस्तद्भवाननुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2004016, "chapter_id": 1076, "verse_number": "१-७७-६३x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2004017, "chapter_id": 1076, "verse_number": "१-७७-६३", "content_sanskrit": "संक्रामयिष्यसि जरां येथेष्टं नहुषात्मज।\nमामनुध्याय भावेन न च पापमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2004018, "chapter_id": 1076, "verse_number": "१-७७-६४", "content_sanskrit": "वयो दास्यति ते पुत्रो यः स राजा भविष्यति।\nआयुष्मान्कीर्तिमांश्चैव बह्वपत्यस्तथैव च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2004019, "chapter_id": 1076, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि सप्तसप्ततितमोऽध्यायः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]