[{"id": 7006322000, "chapter_id": 26322, "verse_number": "१-३२-१", "content_sanskrit": "वैशम्पायन उवाच अनाधृष्यस्तु राजर्षिर्ऋचेयुश्चैकराट् स्मृतः ।\nऋचेयोर्ज्वलना नाम भार्या वै तक्षकात्मजा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006322001, "chapter_id": 26322, "verse_number": "१-३२-२", "content_sanskrit": "तस्यां स देव्यां राजर्षिर्मतिनारो महीपतिः ।\nमतिनारसुताश्चासंस्त्रयः परमधार्मिकाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006322002, "chapter_id": 26322, "verse_number": "१-३२-३", "content_sanskrit": "तंसुराद्यः प्रतिरथः सुबाहुश्चैव धार्मिकः ।\nगौरी कन्या च विख्याता मान्धातृजननी शुभा॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006322003, "chapter_id": 26322, "verse_number": "१-३२-४", "content_sanskrit": "सर्वे वेदविदस्तत्र ब्रह्मण्याः सत्यवादिनः ।\nसर्वे कृतास्त्रा बलिनः सर्वे युद्धविशारदाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006322004, "chapter_id": 26322, "verse_number": "१-३२-५", "content_sanskrit": "पुत्रः प्रतिरथस्यासीत् कण्वः समभवन्नृपः ।\nमेधातिथिः सुतस्तस्य यस्मात्काण्वायना द्विजाः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006322005, "chapter_id": 26322, "verse_number": "१-३२-६", "content_sanskrit": "ईलिनी भूप यस्यासीत् कन्या वै जनमेजय ।\nब्रह्मवादिन्यधि स्त्रीं च तंसुस्तामभ्यगच्छत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006322006, "chapter_id": 26322, "verse_number": "१-३२-७", "content_sanskrit": "तंसोः सुरोधो राजर्षिर्धर्मनेत्रो महायशाः ।\nब्रह्मवादी पराक्रान्तस्तस्य भार्योपदानवी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006322007, "chapter_id": 26322, "verse_number": "१-३२-८", "content_sanskrit": "उपदानवी सुताँल्लेभे चतुरस्त्वैलिकात्मजान् ।\nदुष्यन्तमथ सुष्मन्तं प्रवीरमनघं तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006322008, "chapter_id": 26322, "verse_number": "१-३२-९", "content_sanskrit": "दुष्यन्तस्य तु दायादो भरतो नाम वीर्यवान् ।\nस सर्वदमनो नाम नागायुतबलो महान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006322009, "chapter_id": 26322, "verse_number": "१-३२-१०", "content_sanskrit": "चक्रवर्ती सुतो जज्ञे दुष्यन्तस्य महात्मनः ।\nशकुन्तलायां भरतो यस्य नाम्ना स्थ भारताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006322010, "chapter_id": 26322, "verse_number": "१-३२-११", "content_sanskrit": "दुष्यन्तं प्रति राजानं वागुवाचाशरीरिणी ।\nमाता भस्त्रा पितुः पुत्रो येन जातः स एव सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006322011, "chapter_id": 26322, "verse_number": "१-३२-१२", "content_sanskrit": "भरस्व पुत्रं दुष्यन्त मावमंस्थाः शकुन्तलाम् ।\nरेतोधाः पुत्र उन्नयति नरदेव यमक्षयात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006322012, "chapter_id": 26322, "verse_number": "१-३२-१३", "content_sanskrit": "त्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तला ।\nभरतस्य विनष्टेषु तनयेषु महीपतेः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006322013, "chapter_id": 26322, "verse_number": "१-३२-१४", "content_sanskrit": "मातॄणां तात कोपेन मया ते कथितं पुरा ।\nबृहस्पतेराङ्गिरसः पुत्रो राजन् महामुनिः ।\nसंक्रामितो भरद्वाजो मरुद्भिः क्रतुभिर्विभुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006322014, "chapter_id": 26322, "verse_number": "१-३२-१५", "content_sanskrit": "अत्रैवोदाहरन्तीमं भरद्वाजस्य धीमतः ।\nधर्मसंक्रमणं चापि मरुद्भिर्भरताय वै ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006322015, "chapter_id": 26322, "verse_number": "१-३२-१६", "content_sanskrit": "अयाजयद् भरद्वाजो मरुद्भिः क्रतुभिर्हि तम् ।\nपूर्वं तु वितथे तस्य कृते वै पुत्रजन्मनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006322016, "chapter_id": 26322, "verse_number": "१-३२-१७", "content_sanskrit": "ततोऽथ वितथो नाम भरद्वाजसुतोऽभवत् ।\nततोऽथ वितथे जाते भरतस्तु दिवं ययौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006322017, "chapter_id": 26322, "verse_number": "१-३२-१८", "content_sanskrit": "वितथं चाभिषिच्याथ भरद्वाजो वनं ययौ ।\nस राजा वितथः पुत्राञ्जनयामास पञ्च वै ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006322018, "chapter_id": 26322, "verse_number": "१-३२-१९", "content_sanskrit": "सुहोत्रं च सुहोतारं गयं गर्गं तथैव च ।\nकपिलं च महात्मानं सुहोत्रस्य सुतद्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006322019, "chapter_id": 26322, "verse_number": "१-३२-२०", "content_sanskrit": "काशिकश्च महासत्त्वस्तथा गृत्समतिर्नृपः ।\nतथा गृत्समतेः पुत्रा ब्राह्मणाः क्षत्रिया विशः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006322020, "chapter_id": 26322, "verse_number": "१-३२-२१", "content_sanskrit": "काशिकस्य तु काशेयः पुत्रो दीर्घतपास्तथा ।\nआजमीढोऽपरो वंशः श्रूयतां पुरुषर्षभ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006322021, "chapter_id": 26322, "verse_number": "१-३२-२२", "content_sanskrit": "सुहोत्रस्य बृहत् पुत्रो बृहतस्तनयास्त्रयः ।\nअजमीढो द्विमीढश्च पुरुमीढश्च वीर्यवान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006322022, "chapter_id": 26322, "verse_number": "१-३२-२३", "content_sanskrit": "अजमीढस्य पत्न्यस्तु तिस्रो वै यशसान्विताः ।\nनीलिनी केशिनी चैव धूमिनी च वराङ्गना ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006322023, "chapter_id": 26322, "verse_number": "१-३२-२४", "content_sanskrit": "अजमीढस्य नीलिन्यां सुशान्तिरुदपद्यत ।\nपुरुजातिः सुशान्तेस्तु वाह्याश्वः पुरुजातितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006322024, "chapter_id": 26322, "verse_number": "१-३२-२५", "content_sanskrit": "वाह्याश्वतनयाः पञ्च बभूवुरमरोपमाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006322025, "chapter_id": 26322, "verse_number": "१-३२-२६", "content_sanskrit": "मुद्गलः सृञ्जयश्चैव राजा बृहदिषुः स्मृतः ।\nयवीनरश्च विक्रान्तः कृमिलाश्वश्च पञ्चमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006322026, "chapter_id": 26322, "verse_number": "१-३२-२७", "content_sanskrit": "पञ्चैते रक्षणायालं देशानामिति विश्रुताः ।\nपञ्चानां विद्धि पञ्चालान्स्फीतैर्जनपदैर्वृतान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006322027, "chapter_id": 26322, "verse_number": "१-३२-२८", "content_sanskrit": "अलं संरक्षणे तेषां पञ्चाला इति विश्रुताः ।\nमुद्गलस्य तु दायादो मौद्गल्यः सुमहायशाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006322028, "chapter_id": 26322, "verse_number": "१-३२-२९", "content_sanskrit": "सर्व एते महात्मानः क्षत्रोपेता द्विजातयः ।\nएते ह्यङ्गिरसः पक्षं संश्रिताः कण्वमौद्गलाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006322029, "chapter_id": 26322, "verse_number": "१-३२-३०", "content_sanskrit": "मौद्गलस्य सुतो ज्येष्ठो ब्रह्मर्षिः सुमहायशाः ।\nइन्द्रसेनो यतो गर्भं वध्र्यश्वं   प्रत्यपद्यत ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006322030, "chapter_id": 26322, "verse_number": "१-३२-३१", "content_sanskrit": "वध्र्यश्वान्मिथुनं जज्ञे मेनकायामिति श्रुतिः ।\nदिवोदासश्च राजर्षिरहल्या च यशस्विनी ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006322031, "chapter_id": 26322, "verse_number": "१-३२-३२", "content_sanskrit": "शरद्वतस्तु दायादमहल्या समसूयत ।\nशतानन्दमृषिश्रेष्ठं तस्यापि सुमहायशाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006322032, "chapter_id": 26322, "verse_number": "१-३२-३३", "content_sanskrit": "पुत्रः सत्यधृतिर्नाम धनुर्वेदस्य पारगः ।\nतस्य सत्यधृते रेतो दृष्ट्वाप्सरसमग्रतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006322033, "chapter_id": 26322, "verse_number": "१-३२-३४", "content_sanskrit": "अवस्कन्नं शरस्तम्बे मिथुनं समपद्यत ।\nकृपया तच्च जग्राह शन्तनुर्मृगयां गतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006322034, "chapter_id": 26322, "verse_number": "१-३२-३५", "content_sanskrit": "कृपः स्मृतः स वै तस्माद् गौतमी च कृपी तथा ।\nएते शारद्वताः प्रोक्ता एते ते गौतमाः स्मृताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006322035, "chapter_id": 26322, "verse_number": "१-३२-३६", "content_sanskrit": "अत ऊर्ध्वं प्रवक्ष्यामि दिवोदासस्य संततिम् ।\nदिवोदासस्य दायादो ब्रह्मर्षिर्मित्रयुर्नृप ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006322036, "chapter_id": 26322, "verse_number": "१-३२-३७", "content_sanskrit": "मैत्रायणस्ततः सोमो मैत्रेयास्तु ततः स्मृताः ।\nएते हि संश्रिताः पक्षं क्षत्रोपेतास्तु भार्गवाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006322037, "chapter_id": 26322, "verse_number": "१-३२-३८", "content_sanskrit": "आसीत् पञ्चजनः पुत्रः सृञ्जयस्य महात्मनः ।\nसुतः पञ्चजनस्यापि सोमदत्तो महीपतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006322038, "chapter_id": 26322, "verse_number": "१-३२-३९", "content_sanskrit": "सोमदत्तस्य दायादः सहदेवो महायशाः ।\nसहदेवसुतश्चापि सोमको नाम पार्थिवः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006322039, "chapter_id": 26322, "verse_number": "१-३२-४०", "content_sanskrit": "अजमीढात् पुनर्जातः क्षीणवंशे तु सोमकः ।\nसोमकस्य सुतो जन्तुर्यस्य पुत्रशतं बभौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006322040, "chapter_id": 26322, "verse_number": "१-३२-४१", "content_sanskrit": "तेषां यवीयान् पृषतो द्रुपदस्य पिता प्रभुः ।\nधृष्टद्युम्नस्तु द्रुपदाद् धृष्टकेतुश्च तत्सुतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006322041, "chapter_id": 26322, "verse_number": "१-३२-४२", "content_sanskrit": "अजमीढाः स्मृता ह्येते महात्मानस्तु सोमकाः ।\nपुत्राणामजमीढस्य सोमकत्वं महात्मनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006322042, "chapter_id": 26322, "verse_number": "१-३२-४३", "content_sanskrit": "महिषी त्वजमीढस्य धूमिनी पुत्रगृद्धिनी ।\nतृतीया तव पूर्वेषां जननी पृथिवीपते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006322043, "chapter_id": 26322, "verse_number": "१-३२-४४", "content_sanskrit": "सा तु पुत्रार्थिनी देवी व्रतचर्यासमन्विता ।\nततो वर्षायुतं तप्त्वा तपः परमदुश्चरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006322044, "chapter_id": 26322, "verse_number": "१-३२-४५", "content_sanskrit": "हुत्वाग्निं विधिवत् सा तु पवित्रमितभोजना ।\nअग्निहोत्रकुशेष्वेव सुष्वाप जनमेजय ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006322045, "chapter_id": 26322, "verse_number": "१-३२-४६", "content_sanskrit": "धूमिन्या स तया देव्या त्वजमीढः समेयिवान् ।\nऋक्षं संजनयामास धूमवर्णं सुदर्शनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006322046, "chapter_id": 26322, "verse_number": "१-३२-४७", "content_sanskrit": "ऋक्षात् संवरणो जज्ञे कुरुः संवरणात् तथा ।\nयः प्रयागादतिक्रम्य कुरुक्षेत्रं चकार ह ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006322047, "chapter_id": 26322, "verse_number": "१-३२-४८", "content_sanskrit": "तद्वै तत्स महाभागो वर्षाणि सुबहून्यथ ।\nतप्यमाने तदा शक्रो यत्रास्य वरदो बभौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006322048, "chapter_id": 26322, "verse_number": "१-३२-४९", "content_sanskrit": "पुण्यं च रमणीयं च पुण्यकृद्भिर्निषेवितम् ।\nतस्यान्ववायःसुमहांस्तस्य नाम्ना स्थ कौरवाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006322049, "chapter_id": 26322, "verse_number": "१-३२-५०", "content_sanskrit": "कुरोश्च पुत्राश्चत्वारः सुधन्वा सुधनुस्तथा ।\nपरीक्षिच्च भहाबाहुः प्रवरश्चारिमेजयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006322050, "chapter_id": 26322, "verse_number": "१-३२-५१", "content_sanskrit": "सुधन्वनस्तु दायादः सुहोत्रो मतिमांस्ततः ।\nच्यवनस्तस्य पुत्रस्तु राजा धर्मार्थकोविदः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006322051, "chapter_id": 26322, "verse_number": "१-३२-५२", "content_sanskrit": "च्यवनात् कृतयज्ञस्तु इष्ट्वा यत्रैः स धर्मवित् ।\nविश्रुतं जनयामास पुत्रमिन्द्रसमं नृपः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006322052, "chapter_id": 26322, "verse_number": "१-३२-५३", "content_sanskrit": "चैद्योपरिचरं वीरं वसुं नामान्तरिक्षगम् ।\nचैद्योपरिचराज्जज्ञे गिरिका सप्त मानवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006322053, "chapter_id": 26322, "verse_number": "१-३२-५४", "content_sanskrit": "महारथो मगधराड् विश्रुतो यो बृहद्रथः ।\nप्रत्यग्रहः कुशश्चैव यमाहुर्मणिवाहनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006322054, "chapter_id": 26322, "verse_number": "१-३२-५५", "content_sanskrit": "मारुतश्च यदुश्चैव मत्स्यः काली च सत्तमः ।\nबृहद्रथस्य दायादः कुशाग्रो नाम विश्रुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006322055, "chapter_id": 26322, "verse_number": "१-३२-५६", "content_sanskrit": "कुशाग्रस्यात्मजो विद्वान् वृषभो नाम वीर्यवान् ।\nवृषभस्य तु दायादः पुष्पवान्नाम धार्मिकः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006322056, "chapter_id": 26322, "verse_number": "१-३२-५७", "content_sanskrit": "दायादस्तस्य विक्रान्तो राजा सत्यहितः स्मृतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006322057, "chapter_id": 26322, "verse_number": "१-३२-५८", "content_sanskrit": "तस्य पुत्रोऽथ धर्मात्मा नाम्ना ऊर्जस्तु जज्ञिवान् ।\nऊर्जस्य सम्भवः पुत्रो यस्य जज्ञे स वीर्यवान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006322058, "chapter_id": 26322, "verse_number": "१-३२-५९", "content_sanskrit": "शकले द्वे स वै जातो जरया संधितः स तु ।\nजरया संधितो यस्माज्जरासंधस्ततः स्मृतः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006322059, "chapter_id": 26322, "verse_number": "१-३२-६०", "content_sanskrit": "सर्वक्षत्रस्य जेतासौ जरासंधो महाबलः ।\nजरासंधस्य पुत्रो वै सहदेवः प्रतापवान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006322060, "chapter_id": 26322, "verse_number": "१-३२-६१", "content_sanskrit": "सहदेवात्मजः श्रीमानुदायुः स महायशाः ।\nउदायुर्जनयामास पुत्रं परमधार्मिकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006322061, "chapter_id": 26322, "verse_number": "१-३२-६२", "content_sanskrit": "श्रुतधर्मेति नामानं मगधान् योऽवसद् विभुः ।\nपरीक्षितस्तु दायादो धार्मिको जनमेजयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006322062, "chapter_id": 26322, "verse_number": "१-३२-६३", "content_sanskrit": "जनमेजयस्य दायादास्त्रय एव महा रथाः ।\nश्रुतसेनोग्रसेनौ च भीमसेनश्च नामतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006322063, "chapter_id": 26322, "verse_number": "१-३२-६४", "content_sanskrit": "एते सर्वे महाभागा विक्रान्ता बलशालिनः ।\nजनमेजयस्य पुत्रौ तु सुरथो मतिमांस्तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006322064, "chapter_id": 26322, "verse_number": "१-३२-६५", "content_sanskrit": "सुरथस्य तु विक्रान्तः पुत्रो जज्ञे विदूरथः ।\nविदूरथस्य दायाद ऋक्ष एव महारथः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006322065, "chapter_id": 26322, "verse_number": "१-३२-६६", "content_sanskrit": "द्वितीयः स बभौ राजा नाम्ना तेनैव संज्ञितः ।\nद्वावृक्षौ तव वंशेऽस्मिन्द्वावेव तु परीक्षितौ ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006322066, "chapter_id": 26322, "verse_number": "१-३२-६७", "content_sanskrit": "भीमसेनास्त्रयो राजन् द्वावेव जनमेजयौ ।\nऋक्षस्य तु द्वितीयस्य भीमसेनोऽभवत्सुतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006322067, "chapter_id": 26322, "verse_number": "१-३२-६८", "content_sanskrit": "प्रतीपो भीमसेनस्य प्रतीपस्य तु शन्तनुः ।\nदेवापिर्बाह्लिकश्चैव त्रय एव महारथाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006322068, "chapter_id": 26322, "verse_number": "१-३२-६९", "content_sanskrit": "शन्तनोः प्रसवस्त्वेष यत्र जातोऽसि पार्थिव ।\nबाह्लिकस्य तु राज्यं वै सप्तवाह्यं नरेश्वर ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006322069, "chapter_id": 26322, "verse_number": "१-३२-७०", "content_sanskrit": "बाह्लिकस्य सुतश्चैव सोमदत्तो महायशाः ।\nजज्ञिरे सोमदत्तात्तु भूरिर्भूरिश्रवाः शलः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006322070, "chapter_id": 26322, "verse_number": "१-३२-७१", "content_sanskrit": "उपाध्यायस्तु देवानां देवापिरभवन्मुनिः ।\nच्यवनस्य कृतः पुत्र इष्टश्चासीन्महात्मनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006322071, "chapter_id": 26322, "verse_number": "१-३२-७२", "content_sanskrit": "शन्तनुस्त्वभवद् राजा कौरवाणां धुरन्धरः ।\nशान्तनोः सम्प्रवक्ष्यामि यत्र जातोऽसि पार्थिव ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006322072, "chapter_id": 26322, "verse_number": "१-३२-७३", "content_sanskrit": "गाङ्गं देवव्रतं नाम पुत्रं सोऽजनयत् प्रभुः ।\nस तु भीष्म इति ख्यातः पाण्डवानां पितामहः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006322073, "chapter_id": 26322, "verse_number": "१-३२-७४", "content_sanskrit": "काली विचित्रवीर्यं तु जनयामास भारत ।\nशन्तनोर्दयितं पुत्रं धर्मात्मानमकल्मषम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006322074, "chapter_id": 26322, "verse_number": "१-३२-७५", "content_sanskrit": "कृष्णद्वैपायनश्चैव क्षेत्रे वैचित्रवीर्यके ।\nधृतराष्ट्रं च पाण्डुं च विदुरं चाप्यजीजनत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006322075, "chapter_id": 26322, "verse_number": "१-३२-७६", "content_sanskrit": "धृतराष्ट्रश्च गान्धार्यां पुत्रानुत्पादयच्छतम् ।\nतेषां दुर्योधनः श्रेष्ठः सर्वेषामेव स प्रभुः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006322076, "chapter_id": 26322, "verse_number": "१-३२-७७", "content_sanskrit": "पाण्डोर्धनंजयः पुत्रः सौभद्रस्तस्य चात्मजः ।\nअभिमन्योः परीक्षित् तु पिता तव जनेश्वर ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006322077, "chapter_id": 26322, "verse_number": "१-३२-७८", "content_sanskrit": "एष ते पौरवो वंशो यत्र जातोऽसि पार्थिव ।\nतुर्वसोस्तु प्रवक्ष्यामि द्रुह्योश्चानोर्यदोस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006322078, "chapter_id": 26322, "verse_number": "१-३२-७९", "content_sanskrit": "सुतस्तु तुर्वसोर्वह्निर्वह्नेर्गोभानुरात्मजः ।\nगोभानोस्तु सुतो राजा त्रैसानुरपराजितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006322079, "chapter_id": 26322, "verse_number": "१-३२-८०", "content_sanskrit": "करन्धमस्तु त्रैसानोर्मरुत्तस्तस्य चात्मजः ।\nअन्यस्त्वावीक्षितो राजा मरुत्तः कथितस्तव ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006322080, "chapter_id": 26322, "verse_number": "१-३२-८१", "content_sanskrit": "अनपत्योऽभवद् राजा यज्वा विपुलदक्षिणः ।\nदुहिता सम्मता नाम तस्यासीत् पृथिवीपते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006322081, "chapter_id": 26322, "verse_number": "१-३२-८२", "content_sanskrit": "दक्षिणार्थं स्म वै दत्ता संवर्ताय महात्मने ।\nदुष्यन्तं पौरवं चापि लेभे पुत्रमकल्मषम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006322082, "chapter_id": 26322, "verse_number": "१-३२-८३", "content_sanskrit": "एवं ययातेः शापेन जरासंक्रमणे तदा ।\nपौरवं तुर्वसोर्वंशं प्रविवेश नृपोत्तम ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006322083, "chapter_id": 26322, "verse_number": "१-३२-८४", "content_sanskrit": "दुष्यन्तस्य तु दायादः करुत्थामः प्रजेश्वरः ।\nकरुत्थामात्तथाऽऽक्रीडश्चत्वारस्तस्य चात्मजाः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006322084, "chapter_id": 26322, "verse_number": "१-३२-८५", "content_sanskrit": "पाण्ड्यश्च केरलश्चैव कोलश्चोलश्च पार्थिवः ।\nतेषां जनपदाः स्फीताः पाण्ड्याश्चोलाः सकेरलाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006322085, "chapter_id": 26322, "verse_number": "१-३२-८६", "content_sanskrit": "द्रुह्योश्च तनयो राजन् बभ्रुः सेतुश्च पार्थिवः ।\nअङ्गारसेतुस्तत्पुत्रो मरुतां पतिरुच्यते ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006322086, "chapter_id": 26322, "verse_number": "१-३२-८७", "content_sanskrit": "यौवनाश्वेन समरे कृच्छ्रेण निहतो बली ।\nयुद्धं सुमहदस्यासीन्मासान्परि चतुर्दश ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006322087, "chapter_id": 26322, "verse_number": "१-३२-८८", "content_sanskrit": "अङ्गारस्य तु दायादो गान्धारो नाम भारत ।\nख्यायते तस्य नाम्ना वै गान्धारविषयो महान् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006322088, "chapter_id": 26322, "verse_number": "१-३२-८९", "content_sanskrit": "गान्धारदेशजाश्चैव तुरगा वाजिनां वराः ।\nअनोस्तु पुत्रो धर्मोऽभूद् धृतस्तस्यात्मजोऽभवत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006322089, "chapter_id": 26322, "verse_number": "१-३२-९०", "content_sanskrit": "धृतात् तु दुदुहो जज्ञे प्रचेतास्तस्य चात्मजः ।\nप्रचेतसः सुचेतास्तु कीर्तितो ह्यानवो मया ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006322090, "chapter_id": 26322, "verse_number": "१-३२-९१", "content_sanskrit": "यदोर्वंशं प्रवक्ष्यामि ज्येष्ठस्योत्तमतेजसः ।\nविस्तरेणानुपूर्व्यात्तु गदतो मे निशामय ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]