[{"id": 5000266000, "chapter_id": 9266, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकोनसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000266001, "chapter_id": 9266, "verse_number": "३-६९-१", "content_sanskrit": "कृत्वैवमुदकं तस्मै प्रस्थितौ राघवौ तदा।\nअवेक्षन्तौ वने सीतां जग्मतुः पश्चिमां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000266002, "chapter_id": 9266, "verse_number": "३-६९-२", "content_sanskrit": "तां दिशं दक्षिणां गत्वा शरचापासिधारिणौ।\nअविप्रहतमैक्ष्वाकौ पन्थानं प्रतिपेदतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000266003, "chapter_id": 9266, "verse_number": "३-६९-३", "content_sanskrit": "गुल्मैर्वृक्षैश्च बहुभिर्लताभिश्च प्रवेष्टितम्।\nआवृतं सर्वतो दुर्गं गहनं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000266004, "chapter_id": 9266, "verse_number": "३-६९-४", "content_sanskrit": "व्यतिक्रम्य तु वेगेन गृहीत्वा दक्षिणां दिशम्।\nसुभीमं तन्महारण्यं व्यतियातौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000266005, "chapter_id": 9266, "verse_number": "३-६९-५", "content_sanskrit": "ततः परं जनस्थानात् त्रिकोशं गम्य राघवौ।\nक्रौञ्चारण्यं विविशतुर्गहनं तौ महौजसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000266006, "chapter_id": 9266, "verse_number": "३-६९-६", "content_sanskrit": "नानामेघघनप्रख्यं प्रहृष्टमिव सर्वतः।\nनानावर्णैः शुभैः पुष्पैर्मृगपक्षिगणैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000266007, "chapter_id": 9266, "verse_number": "३-६९-७", "content_sanskrit": "दिदृक्षमाणौ वैदेहीं तद् वनं तौ विचिक्यतुः।\nतत्र तत्रावतिष्ठन्तौ सीताहरणदुःखितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000266008, "chapter_id": 9266, "verse_number": "३-६९-८", "content_sanskrit": "ततः पूर्वेण तौ गत्वा त्रिक्रोशं भ्रातरौ तदा।\nक्रौञ्चारण्यमतिक्रम्य मतङ्गाश्रममन्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000266009, "chapter_id": 9266, "verse_number": "३-६९-९", "content_sanskrit": "दृष्ट्वा तु तद् वनं घोरं बहुभीममृगद्विजम्।\nनानावृक्षसमाकीर्णं सर्वं गहनपादपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000266010, "chapter_id": 9266, "verse_number": "३-६९-१०", "content_sanskrit": "ददृशाते गिरौ तत्र दरीं दशरथात्मजौ।\nपातालसमगम्भीरां तमसा नित्यसंवृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000266011, "chapter_id": 9266, "verse_number": "३-६९-११", "content_sanskrit": "आसाद्य च नरव्याघ्रौ दर्यास्तस्याविदूरतः।\nददर्शतुर्महारूपां राक्षसीं विकृताननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000266012, "chapter_id": 9266, "verse_number": "३-६९-१२", "content_sanskrit": "भयदामल्पसत्त्वानां बीभत्सां रौद्रदर्शनाम्।\nलम्बोदरीं तीक्ष्णदंष्ट्रां करालीं परुषत्वचम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000266013, "chapter_id": 9266, "verse_number": "३-६९-१३", "content_sanskrit": "भक्षयन्तीं मृगान् भीमान् विकटां मुक्तमूर्धजाम्।\nअवैक्षतां तु तौ तत्र भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000266014, "chapter_id": 9266, "verse_number": "३-६९-१४", "content_sanskrit": "सा समासाद्य तौ वीरौ व्रजन्तं भ्रातुरग्रतः।\nएहि रंस्यावहेत्युक्त्वा समालम्भत लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000266015, "chapter_id": 9266, "verse_number": "३-६९-१५", "content_sanskrit": "उवाच चैनं वचनं सौमित्रिमुपगुह्य च।\nअहं त्वयोमुखी नाम लाभस्ते त्वमसि प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000266016, "chapter_id": 9266, "verse_number": "३-६९-१६", "content_sanskrit": "नाथ पर्वतदुर्गेषु नदीनां पुलिनेषु च।\nआयुश्चिरमिदं वीर त्वं मया सह रंस्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000266017, "chapter_id": 9266, "verse_number": "३-६९-१७", "content_sanskrit": "एवमुक्तस्तु कुपितः खड्गमुद‍्धृत्य लक्ष्मणः।\nकर्णनासस्तनं तस्या निचकर्तारिसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000266018, "chapter_id": 9266, "verse_number": "३-६९-१८", "content_sanskrit": "कर्णनासे निकृत्ते तु विस्वरं विननाद सा।\nयथागतं प्रदुद्राव राक्षसी घोरदर्शना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000266019, "chapter_id": 9266, "verse_number": "३-६९-१९", "content_sanskrit": "तस्यां गतायां गहनं व्रजन्तौ वनमोजसा।\nआसेदतुरमित्रघ्नौ भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000266020, "chapter_id": 9266, "verse_number": "३-६९-२०", "content_sanskrit": "लक्ष्मणस्तु महातेजाः सत्त्ववाञ्छीलवाञ्छुचिः।\nअब्रवीत् प्राञ्जलिर्वाक्यं भ्रातरं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000266021, "chapter_id": 9266, "verse_number": "३-६९-२१", "content_sanskrit": "स्पन्दते मे दृढं बाहुरुद्विग्नमिव मे मनः।\nप्रायशश्चाप्यनिष्टानि निमित्तान्युपलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000266022, "chapter_id": 9266, "verse_number": "३-६९-२२", "content_sanskrit": "तस्मात् सज्जीभवार्य त्वं कुरुष्व वचनं मम।\nममैव हि निमित्तानि सद्यः शंसन्ति सम्भ्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000266023, "chapter_id": 9266, "verse_number": "३-६९-२३", "content_sanskrit": "एष वञ्जुलको नाम पक्षी परमदारुणः।\nआवयोर्विजयं युद्धे शंसन्निव विनर्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000266024, "chapter_id": 9266, "verse_number": "३-६९-२४", "content_sanskrit": "तयोरन्वेषतोरेवं सर्वं तद् वनमोजसा।\nसंजज्ञे विपुलः शब्दः प्रभञ्जन्निव तद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000266025, "chapter_id": 9266, "verse_number": "३-६९-२५", "content_sanskrit": "संवेष्टितमिवात्यर्थं गहनं मातरिश्वना।\nवनस्य तस्य शब्दोऽभूद् वनमापूरयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000266026, "chapter_id": 9266, "verse_number": "३-६९-२६", "content_sanskrit": "तं शब्दं कांक्षमाणस्तु रामः खड्गी सहानुजः।\nददर्श सुमहाकायं राक्षसं विपुलोरसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000266027, "chapter_id": 9266, "verse_number": "३-६९-२७", "content_sanskrit": "आसेदतुश्च तद्रक्षस्तावुभौ प्रमुखे स्थितम्।\nविवृद्धमशिरोग्रीवं कबन्धमुदरेमुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000266028, "chapter_id": 9266, "verse_number": "३-६९-२८", "content_sanskrit": "रोमभिर्निशितैस्तीक्ष्णैर्महागिरिमिवोच्छ्रितम्।\nनीलमेघनिभं रौद्रं मेघस्तनितनिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000266029, "chapter_id": 9266, "verse_number": "३-६९-२९", "content_sanskrit": "अग्निज्वालानिकाशेन ललाटस्थेन दीप्यता।\nमहापक्षेण पिङ्गेन विपुलेनायतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000266030, "chapter_id": 9266, "verse_number": "३-६९-३०", "content_sanskrit": "एकेनोरसि घोरेण नयनेन सुदर्शिना।\nमहादंष्ट्रोपपन्नं तं लेलिहानं महामुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000266031, "chapter_id": 9266, "verse_number": "३-६९-३१", "content_sanskrit": "भक्षयन्तं महाघोरानृक्षसिंहमृगद्विजान्।\nघोरौ भुजौ विकुर्वाणमुभौ योजनमायतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000266032, "chapter_id": 9266, "verse_number": "३-६९-३२", "content_sanskrit": "कराभ्यां विविधान् गृह्य ऋक्षान् पक्षिगणान् मृगान्।\nआकर्षन्तं विकर्षन्तमनेकान् मृगयूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000266033, "chapter_id": 9266, "verse_number": "३-६९-३३", "content_sanskrit": "स्थितमावृत्य पन्थानं तयोर्भ्रात्रोः प्रपन्नयोः।\nअथ तं समतिक्रम्य क्रोशमात्रं ददर्शतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000266034, "chapter_id": 9266, "verse_number": "३-६९-३४", "content_sanskrit": "महान्तं दारुणं भीमं कबन्धं भुजसंवृतम्।\nकबन्धमिव संस्थानादतिघोरप्रदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000266035, "chapter_id": 9266, "verse_number": "३-६९-३५", "content_sanskrit": "स महाबाहुरत्यर्थं प्रसार्य विपुलौ भुजौ।\nजग्राह सहितावेव राघवौ पीडयन् बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000266036, "chapter_id": 9266, "verse_number": "३-६९-३६", "content_sanskrit": "खड‍‍्गिनौ दृढधन्वानौ तिग्मतेजौ महाभुजौ।\nभ्रातरौ विवशं प्राप्तौ कृष्यमाणौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000266037, "chapter_id": 9266, "verse_number": "३-६९-३७", "content_sanskrit": "तत्र धैर्याच्च शूरस्तु राघवो नैव विव्यथे।\nबाल्यादनाश्रयाच्चैव लक्ष्मणस्त्वभिविव्यथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000266038, "chapter_id": 9266, "verse_number": "३-६९-३८", "content_sanskrit": "उवाच च विषण्णः सन् राघवं राघवानुजः।\nपश्य मां विवशं वीर राक्षसस्य वशंगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000266039, "chapter_id": 9266, "verse_number": "३-६९-३९", "content_sanskrit": "मयैकेन तु निर्युक्तः परिमुच्यस्व राघव।\nमां हि भूतबलिं दत्त्वा पलायस्व यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000266040, "chapter_id": 9266, "verse_number": "३-६९-४०", "content_sanskrit": "अधिगन्तासि वैदेहीमचिरेणेति मे मतिः।\nप्रतिलभ्य च काकुत्स्थ पितृपैतामहीं महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000266041, "chapter_id": 9266, "verse_number": "३-६९-४१", "content_sanskrit": "तत्र मां राम राज्यस्थः स्मर्तुमर्हसि सर्वदा।\nलक्ष्मणेनैवमुक्तस्तु रामः सौमित्रिमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000266042, "chapter_id": 9266, "verse_number": "३-६९-४२", "content_sanskrit": "मा स्म त्रासं वृथा वीर नहि त्वादृग् विषीदति।\nएतस्मिन्नन्तरे क्रूरो भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000266043, "chapter_id": 9266, "verse_number": "३-६९-४३", "content_sanskrit": "तावुवाच महाबाहुः कबन्धो दानवोत्तमः।\nकौ युवां वृषभस्कन्धौ महाखड्गधनुर्धरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000266044, "chapter_id": 9266, "verse_number": "३-६९-४४", "content_sanskrit": "घोरं देशमिमं प्राप्तौ दैवेन मम चाक्षुषौ।\nवदतं कार्यमिह वां किमर्थं चागतौ युवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000266045, "chapter_id": 9266, "verse_number": "३-६९-४५", "content_sanskrit": "इमं देशमनुप्राप्तौ क्षुधार्तस्येह तिष्ठतः।\nसबाणचापखड्गौ च तीक्ष्णशृङ्गाविवर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000266046, "chapter_id": 9266, "verse_number": "३-६९-४६", "content_sanskrit": "मां तूर्णमनुसम्प्राप्तौ दुर्लभं जीवितं हि वाम्।\nतस्य तद् वचनं श्रुत्वा कबन्धस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000266047, "chapter_id": 9266, "verse_number": "३-६९-४७", "content_sanskrit": "उवाच लक्ष्मणं रामो मुखेन परिशुष्यता।\nकृच्छ्रात् कृच्छ्रतरं प्राप्य दारुणं सत्यविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000266048, "chapter_id": 9266, "verse_number": "३-६९-४८", "content_sanskrit": "व्यसनं जीवितान्ताय प्राप्तमप्राप्य तां प्रियाम्।\nकालस्य सुमहद् वीर्यं सर्वभूतेषु लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000266049, "chapter_id": 9266, "verse_number": "३-६९-४९", "content_sanskrit": "त्वां च मां च नरव्याघ्र व्यसनैः पश्य मोहितौ।\nनहि भारोऽस्ति दैवस्य सर्वभूतेषु लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000266050, "chapter_id": 9266, "verse_number": "३-६९-५०", "content_sanskrit": "शूराश्च बलवन्तश्च कृतास्त्राश्च रणाजिरे।\nकालाभिपन्नाः सीदन्ति यथा वालुकसेतवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000266051, "chapter_id": 9266, "verse_number": "३-६९-५१", "content_sanskrit": "इति ब्रुवाणो दृढसत्यविक्रमो\nमहायशा दाशरथिः प्रतापवान्।\nअवेक्ष्य सौमित्रिमुदग्रविक्रमः\nस्थिरां तदा स्वां मतिमात्मनाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000266052, "chapter_id": 9266, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकोनसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]