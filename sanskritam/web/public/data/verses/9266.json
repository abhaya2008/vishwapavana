[{"id": 40017667, "chapter_id": 9266, "verse_number": "1", "content_sanskrit": "निकुम्भंनिहतंश्रुत्वाकुम्भं च विनिपातितम् । रावणःपरमामर्षीप्रजज्वालानलोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017668, "chapter_id": 9266, "verse_number": "2", "content_sanskrit": "नैरृतःक्रोधशोकाभ्यांद्वाभ्यांतुपरिमूर्छितः । खरपुत्रंविशालाक्षंमकराक्षमचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017669, "chapter_id": 9266, "verse_number": "3", "content_sanskrit": "गच्छपुत्रऽमयाऽजाज्ञप्तोबलेनाभिसमवनितः । राघवंलक्ष्मणंचैवजहितांश्चवनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017670, "chapter_id": 9266, "verse_number": "4", "content_sanskrit": "रावणस्यवचश्श्रुत्वाशूरमानीखरात्मजः । बाढमित्यब्रवीद्धृष्टोमकराक्षोनिशाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017671, "chapter_id": 9266, "verse_number": "5", "content_sanskrit": "सोऽभिवाद्यदशग्रीवंकृत्वाचापिप्रदक्षिणम् । निर्जगामगृहाच्छुभ्राद्रावणस्याज्ञयाबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017672, "chapter_id": 9266, "verse_number": "6", "content_sanskrit": "समीपस्थंबलाध्यक्षंखरपुत्रोऽब्रवीदिदम् । रथश्चानीयतांशीघ्रंसैन्यंत्वानीयतांत्वरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017673, "chapter_id": 9266, "verse_number": "7", "content_sanskrit": "तस्यतद्वचनंश्रुत्वाबलाध्यक्षोनिशाचरः । स्यन्दनं च बलंचैवसमीपंप्रत्यपादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017674, "chapter_id": 9266, "verse_number": "8", "content_sanskrit": "प्रदक्षिणंरथंकृत्वाआरुरोहनिशाचरः । सूतंसञ्चोदयामासशीघ्रंमेरथमावह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017675, "chapter_id": 9266, "verse_number": "9", "content_sanskrit": "अथतान्राक्षसान्सर्वान्मकराक्षोऽब्रवीदिदम् । यूयंसर्वेप्रयुध्यध्वंपुरस्तान्ममराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017676, "chapter_id": 9266, "verse_number": "10", "content_sanskrit": "अहंराक्षसराजेनरावणेनमहात्मना । आज्ञप्तःसमरेहन्तुंतावुभौरामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017677, "chapter_id": 9266, "verse_number": "11", "content_sanskrit": "अद्यरामंवधिष्यामिलक्ष्मणं च निशाचराः । शाखामृगं च सुग्रीवंवानरांश्चशरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017678, "chapter_id": 9266, "verse_number": "12", "content_sanskrit": "अद्यशूलनिपातैश्चवानराणांमहाचमूम् । प्रदहिष्यामिसम्प्राप्तांशुष्केन्धनमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017679, "chapter_id": 9266, "verse_number": "13", "content_sanskrit": "मकराक्षस्यतच्छ्रुत्वावचनंतेनिशाचराः । सर्वेनानायुधोपेताबलवन्तःसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017680, "chapter_id": 9266, "verse_number": "14", "content_sanskrit": "तेकामरूपिणस्सरेदंष्ट्रिणःपिङ्गलेक्षणा । मातङ्गाइवनर्दन्तोध्वस्तकेशाभयावहाः ॥ परिवार्यमहाकायामहाकायंखरात्मजम् । अभिजघ्नुस्ततोहृष्टाश्चालयन्तोवसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017681, "chapter_id": 9266, "verse_number": "15", "content_sanskrit": "तेकामरूपिणस्सरेदंष्ट्रिणःपिङ्गलेक्षणा । मातङ्गाइवनर्दन्तोध्वस्तकेशाभयावहाः ॥ परिवार्यमहाकायामहाकायंखरात्मजम् । अभिजघ्नुस्ततोहृष्टाश्चालयन्तोवसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017682, "chapter_id": 9266, "verse_number": "16", "content_sanskrit": "शङ्खभेरीसहस्राणामाहतानांसमन्ततः । क्ष्येळितास्फोटितानां च तत्रशब्दोमहानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017683, "chapter_id": 9266, "verse_number": "17", "content_sanskrit": "प्रभ्रष्टोऽथकरात्तस्यप्रतोदस्सारथेस्तदा । पपातसहसादैवाद्ध्वजस्तस्यतुरक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017684, "chapter_id": 9266, "verse_number": "18", "content_sanskrit": "तस्यतेरथसंयुक्ताहयाविक्रमवर्जिताः । चरणैराकुलैर्गत्वादीनाःसास्रमुखाययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017685, "chapter_id": 9266, "verse_number": "19", "content_sanskrit": "प्रवातिपवनस्तस्मिन् सपांसुःखरदारुणः । निर्याणेतस्यरौद्रस्यमकराक्षस्यदुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017686, "chapter_id": 9266, "verse_number": "20", "content_sanskrit": "तानिदृष्टवानिमित्तानिराक्षसावीर्यवत्तमाः । अचिन्त्यनिर्गतास्सर्वेयत्रतौरामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]