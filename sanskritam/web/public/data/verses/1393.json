[{"id": 2018778, "chapter_id": 1393, "verse_number": "३-३१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018779, "chapter_id": 1393, "verse_number": "३-३१-१", "content_sanskrit": "वल्गु चित्रपदं श्लक्ष्णं याज्ञसेनि त्वया वचः।\nउक्तं तच्छ्रुतमस्माभिर्नास्तिक्यं तु प्रभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018780, "chapter_id": 1393, "verse_number": "३-३१-२", "content_sanskrit": "नाहं धर्मफलाकाङ्क्षी राजपुत्रि चराम्भुत।\nददामि देयमित्येव यजे यष्टव्यमित्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018781, "chapter_id": 1393, "verse_number": "३-३१-३", "content_sanskrit": "अस्तु वाऽत्र फलं मा वा कर्तव्यं पुरुषेण यत्।\nगृहे निवसता कृष्णे यथाशक्ति करोमि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018782, "chapter_id": 1393, "verse_number": "३-३१-४", "content_sanskrit": "धर्मं चरामि सुश्रोणि न धर्मफलकारणात्।\nआगमाननतिक्रम्य सतां वृत्तमवेक्ष्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018783, "chapter_id": 1393, "verse_number": "३-३१-५", "content_sanskrit": "धर्म एव मनः कृष्णे स्वभावाच्चैव मे धृतम्।\n[धर्मवाणिज्यको हीनो जघन्यो धर्मवादिनाम्]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018784, "chapter_id": 1393, "verse_number": "३-३१-६", "content_sanskrit": "न धर्मफलमाप्नोति यो धर्मं दोग्धुमिच्छति।\nयश्चैनं शङ्कते कृत्वा नास्तिक्यात्पापचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018785, "chapter_id": 1393, "verse_number": "३-३१-७", "content_sanskrit": "अतिवादान्मदाच्चैव मा धर्ममभिशङ्कथाः।\nधर्मातिशङ्की पुरुषस्तिर्यग्गतिपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018786, "chapter_id": 1393, "verse_number": "३-३१-८", "content_sanskrit": "धर्मो यस्यातिशङ्क्यः स्यादार्षं वा दुर्बलात्मनः।\nवेदाच्छूद्र इवापेयात्स लोकादजरामरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018787, "chapter_id": 1393, "verse_number": "३-३१-९", "content_sanskrit": "वेदाध्यायी धर्मपरः कुले जातो मनस्विनि।\nस्थविरेषु स योक्तव्यो राजभिर्धर्मचारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018788, "chapter_id": 1393, "verse_number": "३-३१-१०", "content_sanskrit": "पापीयान्स हि शूद्रेभ्यस्तस्करेभ्यो विशिष्यते।\nशास्त्रातिगो मन्दबुद्धिर्यो धर्ममतिशङ्कते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018789, "chapter_id": 1393, "verse_number": "३-३१-११", "content_sanskrit": "प्रत्यक्षं हि त्वया दृष्ट ऋषिर्गच्छन्महातपाः।\nमार्कण्डेयोऽप्रमेयात्मा धर्मेण चिरजीविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018790, "chapter_id": 1393, "verse_number": "३-३१-१२", "content_sanskrit": "व्यासो वसिष्ठो मैत्रेयो नारदो लोमशः शुकः।\nअन्ये च ऋषयः सर्वे धर्मेणैव सुचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018791, "chapter_id": 1393, "verse_number": "३-३१-१३", "content_sanskrit": "प्रत्यक्षं पश्यसि ह्येतान्दिव्ययोगसमन्वितान्।\nशापानुग्रहणे शक्तान्देवेभ्योऽपि गरीयसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018792, "chapter_id": 1393, "verse_number": "३-३१-१४", "content_sanskrit": "एते हि धर्ममेवादौ वर्णयन्ति सदाऽनधे।\nकर्तव्यममरप्रख्याः प्रत्यक्षागमबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018793, "chapter_id": 1393, "verse_number": "३-३१-१५", "content_sanskrit": "अतो नार्हसि कल्याणि धातारं धर्ममेव च।\nरजोमूढेन मनसा क्षेप्तुं शङ्कितुमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018794, "chapter_id": 1393, "verse_number": "३-३१-१६", "content_sanskrit": "उन्मत्तान्मन्यते बालः सर्वानागतनिश्चयान्।\nधर्मातिशङ्की नान्यस्मिन्प्रमाणमधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018795, "chapter_id": 1393, "verse_number": "३-३१-१७", "content_sanskrit": "इन्द्रियप्रीतिसंबद्धं यदिदं लोकसाक्षिकम्।\nएतावन्मन्यते बालो मोहमन्यत्र गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018796, "chapter_id": 1393, "verse_number": "३-३१-१८", "content_sanskrit": "प्रायश्चित्तं न तस्यास्ति यो धर्ममतिशङ्कते।\nध्यायन्स कृपणः पापो न लोकान्प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018797, "chapter_id": 1393, "verse_number": "३-३१-१९", "content_sanskrit": "प्रमाणाद्धि निवृत्तो हि वेदशास्त्रार्थनिन्दकः।\nकामलोभानुगो मूढो नरकं प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018798, "chapter_id": 1393, "verse_number": "३-३१-२०", "content_sanskrit": "आर्षं प्रमाणमुत्क्राम्य धर्मं न प्रतिपालयन्।\nसर्वशास्त्रातिगो मूढः शं जन्मसु न विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018799, "chapter_id": 1393, "verse_number": "३-३१-२१", "content_sanskrit": "यस्तु नित्यं कृतमतिर्धर्ममेवाभिपद्यते।\nअशङ्कमानः कल्याणि सोऽमुत्रानन्त्यमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018800, "chapter_id": 1393, "verse_number": "३-३१-२२", "content_sanskrit": "यस्य नार्षं प्रमाणं स्याच्छिष्टाचारश्च भामिनि।\nन वै तस्य परो लोको नायमस्तीति निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018801, "chapter_id": 1393, "verse_number": "३-३१-२३", "content_sanskrit": "शिष्टैराचरितं धर्मं कृष्णे मास्मातिशङ्कथाः।\nपुराणमृषिभिः प्रोक्तं सर्वज्ञैः सर्वदर्शिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018802, "chapter_id": 1393, "verse_number": "३-३१-२४", "content_sanskrit": "धर्म एव प्लवो नान्यः स्वर्गं द्रौपदि गच्छताम्।\nसैवः नौः सागरस्येव वणिजः पारमिच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018803, "chapter_id": 1393, "verse_number": "३-३१-२५", "content_sanskrit": "अफलो यदि धर्मः स्याच्चरितो धर्मचारिभिः।\nअप्रतिष्ठे तमस्येतज्जगन्मज्जेदनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018804, "chapter_id": 1393, "verse_number": "३-३१-२६", "content_sanskrit": "निर्वाणं नाधिगच्छेयुर्जीवेयुः पशुजीविकाम्।\nविघातेनैव युज्येयुर्न चार्थं कंचिदाप्नुयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018805, "chapter_id": 1393, "verse_number": "३-३१-२७", "content_sanskrit": "तपश्च ब्रह्मचर्यं च यज्ञः स्वाध्याय एव च।\nदानमार्जवमेतानि यदि स्युरफलानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018806, "chapter_id": 1393, "verse_number": "३-३१-२८", "content_sanskrit": "नाचरिष्यन्परे धर्मं परे परतरेऽपि च।\nदानमार्जवमेतानि यदि स्युरफलानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018807, "chapter_id": 1393, "verse_number": "३-३१-२९", "content_sanskrit": "ऋषयस्चैव देवाश्च गन्धर्वासुरराक्षसाः।\nईश्वराः कस्य हेतोस्ते चरेयुर्धर्ममादृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018808, "chapter_id": 1393, "verse_number": "३-३१-३०", "content_sanskrit": "फलदं त्विह विज्ञाय धातारं श्रेयसि स्थितम्।\nधर्मं तेऽव्यचरन्कृष्णे स हि धर्म सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018809, "chapter_id": 1393, "verse_number": "३-३१-३१", "content_sanskrit": "स चायं सफलो धर्मो न धर्मोऽफल उच्यते।\nदृश्यन्तेऽपि हि विद्यानां फलानि तपसां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018810, "chapter_id": 1393, "verse_number": "३-३१-३२", "content_sanskrit": "त्वय्येतद्वै विजानीहि जन्म कृष्णे यथाश्रुतम्।\nवेत्थ चापि यथा जातो धृष्टद्युम्नः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018811, "chapter_id": 1393, "verse_number": "३-३१-३३", "content_sanskrit": "एतावदेव पर्याप्तमुपमानं शुचिस्मिते।\nकर्मणां फलमस्तीति धीरोऽल्पेनापि तुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018812, "chapter_id": 1393, "verse_number": "३-३१-३४", "content_sanskrit": "बहुनाऽपि ह्यविद्वांसो नैव तुष्यन्त्यबुद्धयः।\nतेषां न ध्मजं किंचित्प्रेत्य कर्मास्ति शर्म वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018813, "chapter_id": 1393, "verse_number": "३-३१-३५", "content_sanskrit": "कर्मणामुत पुण्यानां पापानां च फलोदयः।\nप्रभवश्चाप्ययश्चैव देवगुह्यानि भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018814, "chapter_id": 1393, "verse_number": "३-३१-३६", "content_sanskrit": "नैतानि वेद यः कश्चिन्मुह्यन्त्यत्र प्रजा इमाः।\n[अपि कल्पसहस्रेण न च श्रेयोऽधिगच्छति ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018815, "chapter_id": 1393, "verse_number": "३-३१-३७", "content_sanskrit": "रक्ष्याण्येतानि देवानां गूढमाया हि देवताः।\nकृशाङ्गाः सुब्रताश्चैव तपसा दग्धकिल्विषाः।\nप्रसन्नैर्मानसैर्युक्ताः पश्यन्त्येतानि वै द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018816, "chapter_id": 1393, "verse_number": "३-३१-३८", "content_sanskrit": "न फलादर्सनाद्धर्मः शङ्कितव्यो न देवताः।\nयष्टव्यं च प्रयत्नेन दातव्यं चानमूयता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018817, "chapter_id": 1393, "verse_number": "३-३१-३९", "content_sanskrit": "कर्मणां फलमस्तीह तथैतद्धर्मशासनम्।\nब्रह्मा प्रोवाच पुत्राणां यदृषिर्वेद काश्यपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018818, "chapter_id": 1393, "verse_number": "३-३१-४०", "content_sanskrit": "तस्मात्ते संशयः कृष्णे नीहार इव नश्यतु।\nविमृश्य सर्वमस्तीति नास्तिक्यं भावमुत्सृज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018819, "chapter_id": 1393, "verse_number": "३-३१-४१", "content_sanskrit": "ईश्वरं चापि भूतानां धातारं मा च वै क्षिप।\nशिक्षस्वैनं नमस्वैनं मा तेऽभूद्बुद्धिरीदृशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018820, "chapter_id": 1393, "verse_number": "३-३१-४२", "content_sanskrit": "यस्य प्रसादात्तद्भक्तो मर्त्यो गच्छत्यमर्त्यताम्।\nउत्तमां देवतां कृष्णे मातिवोचः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018821, "chapter_id": 1393, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि एकत्रिंशोऽध्यायः ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]