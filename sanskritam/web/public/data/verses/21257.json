[{"id": 7001257000, "chapter_id": 21257, "verse_number": "२-५-३०-१", "content_sanskrit": "तत्रादौ शिवयोः पार्श्वे दक्षिणे वामतः क्रमात् ।\nगंधाद्यैरर्चयेत्पूर्वं देवौ हेरंबषण्मुखौ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001257001, "chapter_id": 21257, "verse_number": "२-५-३०-२", "content_sanskrit": "ततो ब्रह्माणि परित ईशानादि यथाक्रमम् ।\nसशक्तिकानि सद्यांतं प्रथमावरणे यजेत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001257002, "chapter_id": 21257, "verse_number": "२-५-३०-३", "content_sanskrit": "षडंगान्यपि तत्रैव हृदयादीन्यनुक्रमात् ।\nशिवस्य च शिवायाश्च वाह्नेयादि समर्चयेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001257003, "chapter_id": 21257, "verse_number": "२-५-३०-४", "content_sanskrit": "तत्र वामादिकान्रुद्रानष्टौ वामादिशक्तिभिः ।\nअर्चयेद्वा न वा पश्चात्पूर्वादिपरितः क्रमात्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001257004, "chapter_id": 21257, "verse_number": "२-५-३०-५", "content_sanskrit": "प्रथमावरणं प्रोक्तं मया ते यदुनंदन ।\nद्वितीयावरणं प्रीत्या प्रोच्यते श्रद्धया शृणु॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001257005, "chapter_id": 21257, "verse_number": "२-५-३०-६", "content_sanskrit": "अनंतं पूर्वादिक्पत्रे तच्छक्तिं तस्य वामतः ।\nसूक्ष्मं दक्षिणदिक्पत्रे सह शक्त्या समर्चयेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001257006, "chapter_id": 21257, "verse_number": "२-५-३०-७", "content_sanskrit": "ततः पश्चिमदिक्पत्रे सह शक्त्या शिवोत्तमम् ।\nतथैवोत्तरदिक्पत्रे चैकनेत्रं समर्चयेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001257007, "chapter_id": 21257, "verse_number": "२-५-३०-८", "content_sanskrit": "एकरुद्रं च तच्छक्तिं पश्चादीशदले ऽर्चयेत् ।\nत्रिमूर्तिं तस्य शक्तिं च पूजयेदग्निदिग्दले॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001257008, "chapter_id": 21257, "verse_number": "२-५-३०-९", "content_sanskrit": "श्रीकण्ठं नैरृते पत्रे तच्छक्तिं तस्य वामतः ।\nतथैव मारुते पत्रे शिखंडीशं समर्चयेत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001257009, "chapter_id": 21257, "verse_number": "२-५-३०-१०", "content_sanskrit": "द्वितीयावरणे चेज्यास्सर्वर्तश्चक्रवर्तिनः ।\nतृतीयावरणे पूज्याः शक्तिभिश्चाष्टमूर्तयः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001257010, "chapter_id": 21257, "verse_number": "२-५-३०-११", "content_sanskrit": "अष्टसु क्रमशो दिक्षु पूर्वादिपरितः क्रमात् ।\nभवः शर्वस्तथेशानो रुद्रः पशुपतिस्ततः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001257011, "chapter_id": 21257, "verse_number": "२-५-३०-१२", "content_sanskrit": "उग्रो भीमो महादेव इत्यष्टौ मूर्तयः क्रमात् ।\nअनंतरं ततश्चैव महादेवादयः क्रमात्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001257012, "chapter_id": 21257, "verse_number": "२-५-३०-१३", "content_sanskrit": "शक्तिभिस्सह संपूज्यास्तत्रैकादशमूर्तयः ।\nमहादेवः शिवो रुद्रः शंकरो नीललोहितः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001257013, "chapter_id": 21257, "verse_number": "२-५-३०-१४", "content_sanskrit": "ईशानो विजयो भीमो देवदेवो भवोद्भवः ।\nकपर्दीशश्च कथ्यंते तथैकादशशक्तयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001257014, "chapter_id": 21257, "verse_number": "२-५-३०-१५", "content_sanskrit": "तत्राष्टौ प्रथमं पूज्याः वाह्नेयादि यथाक्रमम् ।\nदेवदेवः पूर्वपत्रे ईशानं चाग्निगोचरे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001257015, "chapter_id": 21257, "verse_number": "२-५-३०-१६", "content_sanskrit": "भवोद्भवस्तयोर्मध्ये कपालीशस्ततः परम् ।\nतस्मिन्नावरणे भूयो वृषेन्द्रं पुरतो यजेत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001257016, "chapter_id": 21257, "verse_number": "२-५-३०-१७", "content_sanskrit": "नंदिनं दक्षिणे तस्य महाकालं तथोत्तरे ।\nशास्तारं वह्निदिक्पत्रे मात्ःर्दक्षिणदिग्दले॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001257017, "chapter_id": 21257, "verse_number": "२-५-३०-१८", "content_sanskrit": "गजास्यं नैरृते पत्रे षण्मुखं वारुणे पुनः ।\nज्येष्ठां वायुदले गौरीमुत्तरे चंडमैश्वरे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001257018, "chapter_id": 21257, "verse_number": "२-५-३०-१९", "content_sanskrit": "शास्तृनन्दीशयोर्मध्ये मुनीन्द्रं वृषभं यजेत् ।\nमहाकालस्योत्तरतः पिंगलं तु समर्चयेत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001257019, "chapter_id": 21257, "verse_number": "२-५-३०-२०", "content_sanskrit": "शास्तृमातृसमूहस्य मध्ये भृंगीश्वरं ततः ।\nमातृविघ्नेशमध्ये तु वीरभद्रं समर्चयेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001257020, "chapter_id": 21257, "verse_number": "२-५-३०-२१", "content_sanskrit": "स्कन्दविघ्नेशयोर्मध्ये यजेद्देवीं सरस्वतीम् ।\nज्येष्ठाकुमारयोर्मध्ये श्रियं शिवपदार्चिताम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001257021, "chapter_id": 21257, "verse_number": "२-५-३०-२२", "content_sanskrit": "ज्येष्ठागणाम्बयोर्मध्ये महामोटीं समर्चयेत् ।\nगणाम्बाचण्डयोर्मध्ये देवीं दुर्गां प्रपूजयेत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001257022, "chapter_id": 21257, "verse_number": "२-५-३०-२३", "content_sanskrit": "अत्रैवावरणे भूयः शिवानुचरसंहतिम् ।\nरुद्रप्रथमभूताख्यां विविधां च सशक्तिकाम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001257023, "chapter_id": 21257, "verse_number": "२-५-३०-२४", "content_sanskrit": "शिवायाश्च सखीवर्गं जपेद्ध्यात्वा समाहितः ।\nएवं तृतीयावरणे वितते पूजिते सति॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001257024, "chapter_id": 21257, "verse_number": "२-५-३०-२५", "content_sanskrit": "चतुर्थावरणं ध्यात्वा बहिस्तस्य समर्चयेत् ।\nभानुः पूर्वदले पूज्यो दक्षिणे चतुराननः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001257025, "chapter_id": 21257, "verse_number": "२-५-३०-२६", "content_sanskrit": "रुद्रो वरुणदिक्पत्रे विष्णुरुत्तरदिग्दले ।\nचतुर्णामपि देवानां पृथगावरणान्यथ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001257026, "chapter_id": 21257, "verse_number": "२-५-३०-२७", "content_sanskrit": "तस्यांगानि षडेवादौ दीप्ताद्याभिश्च शक्तिभिः ।\nदीप्ता सूक्ष्मा जया भद्रा विभूतिर्विमला क्रमात्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001257027, "chapter_id": 21257, "verse_number": "२-५-३०-२८", "content_sanskrit": "अमोघा विद्युता चैव पूर्वादि परितः स्थिताः ।\nद्वितीयावरणे पूज्याश्चतस्रो मूर्तयः क्रमात्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001257028, "chapter_id": 21257, "verse_number": "२-५-३०-२९", "content_sanskrit": "पूर्वाद्युत्तरपर्यंताः शक्तयश्च ततः परम् ।\nआदित्यो भास्करो भानू रविश्चेत्यनुपूर्वशः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001257029, "chapter_id": 21257, "verse_number": "२-५-३०-३०", "content_sanskrit": "अर्को ब्रह्मा तथा रुद्रो विष्णुश्चैते विवस्वतः ।\nविस्तारा पूर्वदिग्भागे सुतरां दक्षिणे स्थिताः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001257030, "chapter_id": 21257, "verse_number": "२-५-३०-३१", "content_sanskrit": "बोधनी पश्चिमे भागे आप्यायिन्युत्तरे पुनः ।\nउषां प्रभां तथा प्राज्ञां सन्ध्यामपि ततः परम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001257031, "chapter_id": 21257, "verse_number": "२-५-३०-३२", "content_sanskrit": "ऐशानादिषु विन्यस्य द्वितीयावरणे यजेत् ।\nसोममंगारकं चैव बुधं बुद्धिमतां वरम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001257032, "chapter_id": 21257, "verse_number": "२-५-३०-३३", "content_sanskrit": "बृहस्पतिं बृहद्बुद्धिं भार्गवं तेजसां निधिम् ।\nशनैश्चरं तथा राहुं केतुं धूम्रं भयंकरम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001257033, "chapter_id": 21257, "verse_number": "२-५-३०-३४", "content_sanskrit": "समंततो यजेदेतांस्तृतीयावरणे क्रमात् ।\nअथवा द्वादशादित्या द्वितीयावरणे यजेत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001257034, "chapter_id": 21257, "verse_number": "२-५-३०-३५", "content_sanskrit": "तृतीयावरणे चैव राशीन्द्वादश पूजयेत् ।\nसप्तसप्त गणांश्चैव बहिस्तस्य समंततः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001257035, "chapter_id": 21257, "verse_number": "२-५-३०-३६", "content_sanskrit": "ऋषीन्देवांश्च गंधर्वान्पन्नगानप्सरोगणान् ।\nग्रामण्यश्च तथा यक्षान्यातुधानांस्तथा हयान्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001257036, "chapter_id": 21257, "verse_number": "२-५-३०-३७", "content_sanskrit": "सप्तच्छंदोमयांश्चैव वालखिल्यांश्च पूजयेत् ।\nएवं तृतीयावरणे समभ्यर्च्य दिवाकरम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001257037, "chapter_id": 21257, "verse_number": "२-५-३०-३८", "content_sanskrit": "ब्रह्माणमर्चयेत्पश्चात्त्रिभिरावरणैः सहः ।\nहिरण्यगर्भं पूर्वस्यां विराजं दक्षिणे ततः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001257038, "chapter_id": 21257, "verse_number": "२-५-३०-३९", "content_sanskrit": "कालं पश्चिमदिग्भागे पुरुषं चोत्तरे यजेत् ।\nहिरण्यगर्भः प्रथमो ब्रह्मा कमलसन्निभः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001257039, "chapter_id": 21257, "verse_number": "२-५-३०-४०", "content_sanskrit": "कालो जात्यंजनप्रख्यः पुरुषः स्फटिकोपमः ।\nत्रिगुणो राजसश्चैव तामसः सात्त्विकस्तथा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001257040, "chapter_id": 21257, "verse_number": "२-५-३०-४१", "content_sanskrit": "चत्वार एते क्रमशः प्रथमावरणे स्थिताः ।\nद्वितीयावरणे पूज्याः पूर्वादिपरितः क्रमात्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001257041, "chapter_id": 21257, "verse_number": "२-५-३०-४२", "content_sanskrit": "सनत्कुमारः सनकः सनंदश्च सनातनः ।\nतृतीयावरणे पश्चादर्चयेच्च प्रजापतीन्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001257042, "chapter_id": 21257, "verse_number": "२-५-३०-४३", "content_sanskrit": "अष्टौ पूर्वांश्च पूर्वादौ त्रीन्प्राक्पश्चादनुक्रमात् ।\nदक्षो रुचिर्भृगुश्चैव मरीचिश्च तथांगिराः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001257043, "chapter_id": 21257, "verse_number": "२-५-३०-४४", "content_sanskrit": "पुलस्त्यः पुलहश्चैव क्रतुरत्रिश्च कश्यपः ।\nवसिष्ठश्चेति विख्याताः प्रजानां पतयस्त्विमे॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001257044, "chapter_id": 21257, "verse_number": "२-५-३०-४५", "content_sanskrit": "तेषां भार्याश्च तैस्सार्धं पूजनीया यथाक्रमम् ।\nप्रसूतिश्च तथाकूतिः ख्यातिः सम्भूतिरेव च॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001257045, "chapter_id": 21257, "verse_number": "२-५-३०-४६", "content_sanskrit": "धृतिः स्मृतिः क्षमा चैव सन्नतिश्चानसूयका ।\nदेवमातारुन्धती च सर्वाः खलु पतिव्रताः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001257046, "chapter_id": 21257, "verse_number": "२-५-३०-४७", "content_sanskrit": "शिवार्चनरतो नित्यं श्रीमत्यः प्रियदर्शनाः ।\nप्रथमावरणे वेदांश्चतुरो वा प्रपूजयेत्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001257047, "chapter_id": 21257, "verse_number": "२-५-३०-४८", "content_sanskrit": "इतिहासपुराणानि द्वितीयावरणे पुनः ।\nतृतीयावरणे पश्चाद्धर्मशास्त्रपुरस्सराः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001257048, "chapter_id": 21257, "verse_number": "२-५-३०-४९", "content_sanskrit": "वैदिक्यो निखिला विद्याः पूज्या एव समंततः ।\nपूर्वादिपुरतो वेदास्तदन्ये तु यथारुचि॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001257049, "chapter_id": 21257, "verse_number": "२-५-३०-५०", "content_sanskrit": "अष्टधा वा चतुर्धा वा कृत्वा पूजां समंततः ।\nएवं ब्रह्माणमभ्यर्च्य त्रिभिरावरणैर्युतम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001257050, "chapter_id": 21257, "verse_number": "२-५-३०-५१", "content_sanskrit": "दक्षिणे पश्चिमे पश्चाद्रुद्रं सावरणं यजेत् ।\nतस्य ब्रह्मषडंगानि प्रथमावरणं स्मृतम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001257051, "chapter_id": 21257, "verse_number": "२-५-३०-५२", "content_sanskrit": "द्वितीयावरणे चैव विद्येश्वरमयं तथा ।\nतृतीयावरणे भेदो विद्यते स तु कथ्यते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001257052, "chapter_id": 21257, "verse_number": "२-५-३०-५३", "content_sanskrit": "चतस्रो मूर्तयस्तस्य पूज्याः पूर्वादितः क्रमात् ।\nत्रिगुणास्सकलो देवः पुरस्ताच्छिवसंज्ञकः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001257053, "chapter_id": 21257, "verse_number": "२-५-३०-५४", "content_sanskrit": "राजसो दक्षिणे ब्रह्मा सृष्टिकृत्पूज्यते भवः ।\nतामसः पश्चिमे चाग्निः पूज्यस्संहारको हरः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001257054, "chapter_id": 21257, "verse_number": "२-५-३०-५५", "content_sanskrit": "सात्त्विकस्सुखकृत्सौम्ये विष्णुर्विश्वपतिर्मृडः ।\nएवं पश्चिमदिग्भागे शम्भोः षड्विंशकं शिवम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001257055, "chapter_id": 21257, "verse_number": "२-५-३०-५६", "content_sanskrit": "समभ्यर्च्योत्तरे पार्श्वे ततो वैकुंठमर्चयेत् ।\nवासुदेवं पुरस्कृत्वा प्रथमावरणे यजेत्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001257056, "chapter_id": 21257, "verse_number": "२-५-३०-५७", "content_sanskrit": "अनिरुद्धं दक्षिणतः प्रद्युम्नं पश्चिमे ततः ।\nसौम्ये संकर्षणं पश्चाद्व्यत्यस्तौ वा यजेदिमौ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001257057, "chapter_id": 21257, "verse_number": "२-५-३०-५८", "content_sanskrit": "प्रथमावरणं प्रोक्तं द्वितीयावरणं शुभम् ।\nमत्स्यः कूर्मो वराहश्च नरसिंहोथ वामनः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001257058, "chapter_id": 21257, "verse_number": "२-५-३०-५९", "content_sanskrit": "रामश्चान्यतमः कृष्णो भवानश्वमुखोपि च ।\nतृतीयावरणे चक्रुः पूर्वभागे समर्चयेत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001257059, "chapter_id": 21257, "verse_number": "२-५-३०-६०", "content_sanskrit": "नारायणाख्यां याम्येस्त्रं क्वचिदव्याहतं यजेत् ।\nपश्चिमे पांचजन्यं च शार्ङ्गंधनुरथोत्तरे॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001257060, "chapter_id": 21257, "verse_number": "२-५-३०-६१", "content_sanskrit": "एवं त्र्यावरणैः साक्षाद्विश्वाख्यां परमं हरिम् ।\nमहाविष्णुं सदाविष्णुं मूर्तीकृत्य समर्चयेत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001257061, "chapter_id": 21257, "verse_number": "२-५-३०-६२", "content_sanskrit": "इत्थं विष्णोश्चतुर्व्यूहक्रमान्मूर्तिचतुष्टयम् ।\nपूजयित्वा च तच्छक्तीश्चतस्रः पुजयेत्क्रमात्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001257062, "chapter_id": 21257, "verse_number": "२-५-३०-६३", "content_sanskrit": "प्रभामाग्नेयदिग्भागे नैरृते तु सरस्वतीम् ।\nगणांबिका च वायव्ये लक्ष्मीं रौद्रे समर्चयेत्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001257063, "chapter_id": 21257, "verse_number": "२-५-३०-६४", "content_sanskrit": "एवं भान्वादिमूर्तीनां तच्छक्तीनामनंतरम् ।\nपूजां विधाय लोकेशांस्तत्रैवावरणे यजेत्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001257064, "chapter_id": 21257, "verse_number": "२-५-३०-६५", "content_sanskrit": "इन्द्रमग्निं यमं चैव निरृतिं वरुणं तथा ।\nवायुं सोमं कुबेरं च पश्चादीशानमर्चयेत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001257065, "chapter_id": 21257, "verse_number": "२-५-३०-६६", "content_sanskrit": "एवं चतुर्थावरणं पूजयित्वा विधानतः ।\nआयुधानि महेशस्य पश्चाद्बांह्यं समर्चयेत्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001257066, "chapter_id": 21257, "verse_number": "२-५-३०-६७", "content_sanskrit": "श्रीमन्त्रिशूलमैशाने वज्रं माहेन्द्रदिङ्मुखे ।\nपरशुं वह्निदिग्भागे याम्ये सायकमर्चयेत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001257067, "chapter_id": 21257, "verse_number": "२-५-३०-६८", "content_sanskrit": "नैरृते तु यजेत्खड्गं पाशं वारुणगोचरे ।\nअंकुशं मारुते भागे पिनाकं चोत्तरे यजेत्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001257068, "chapter_id": 21257, "verse_number": "२-५-३०-६९", "content_sanskrit": "पश्चिमाभिमुखं रौद्रं क्षेत्रपालं समर्चयेत् ।\nपञ्चमावरणं चैव सम्पूज्यानन्तरं बहिः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001257069, "chapter_id": 21257, "verse_number": "२-५-३०-७०", "content_sanskrit": "सर्वावरणदेवानां बहिर्वा पञ्चमे ऽथवा ।\nपञ्चमे मातृभिस्सार्धं महोक्ष पुरतो यजेत्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001257070, "chapter_id": 21257, "verse_number": "२-५-३०-७१", "content_sanskrit": "ततः समंततः पूज्यास्सर्वा वै देवयोनयः ।\nखेचरा ऋषयस्सिद्धा दैत्या यक्षाश्च राक्षसाः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001257071, "chapter_id": 21257, "verse_number": "२-५-३०-७२", "content_sanskrit": "अनंताद्याश्च नागेंद्रा नागैस्तत्तत्कुलोद्भवैः ।\nडाकिनीभूतवेतालप्रेतभैरवनायकाः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001257072, "chapter_id": 21257, "verse_number": "२-५-३०-७३", "content_sanskrit": "पातालवासिनश्चान्ये नानायोनिसमुद्भवाः ।\nनद्यस्समुद्रा गिरयः काननानि सरांसि च॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001257073, "chapter_id": 21257, "verse_number": "२-५-३०-७४", "content_sanskrit": "पशवः पक्षिणो वृक्षाः कीटाद्याः क्षुद्रयोनयः ।\nनराश्च विविधाकारा मृगाश्च क्षुद्रयोनयः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001257074, "chapter_id": 21257, "verse_number": "२-५-३०-७५", "content_sanskrit": "भुवनान्यन्तरण्डस्य ततो ब्रह्माण्डकोटयः ।\nबहिरंडान्यसंख्यानि भुवनानि सहाधिपैः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001257075, "chapter_id": 21257, "verse_number": "२-५-३०-७६", "content_sanskrit": "ब्रह्मांडाधारका रुद्रा दशदिक्षु व्यवस्थिताः ।\nयद्गौड यच्च मामेयं यद्वा शाक्तं ततः परम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001257076, "chapter_id": 21257, "verse_number": "२-५-३०-७७", "content_sanskrit": "यत्किञ्चिदस्ति शब्दस्य वाच्यं चिदचिदात्मकम् ।\nतत्सर्वं शिवयोः पार्श्वे बुद्ध्वा सामान्यतो यजेत्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001257077, "chapter_id": 21257, "verse_number": "२-५-३०-७८", "content_sanskrit": "कृतांजलिपुटाः सर्वे ऽचिंत्याः स्मितमुखास्तथा ।\nप्रीत्या संप्रेक्षमाणाश्च देवं देवीं च सर्वदा॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001257078, "chapter_id": 21257, "verse_number": "२-५-३०-७९", "content_sanskrit": "इत्थमावरणाभ्यर्चां कृत्वाविक्षेपशांतये ।\nपुनरभ्यर्च्य देवेशं पक्त्वाक्षरमुदीरयेत्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001257079, "chapter_id": 21257, "verse_number": "२-५-३०-८०", "content_sanskrit": "निवेदयेत्ततः पश्चाच्छिवयोरमृतोपमम् ।\nसुव्यञ्जनसमायुक्तं शुद्धं चारु महाचरुम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001257080, "chapter_id": 21257, "verse_number": "२-५-३०-८१", "content_sanskrit": "द्वात्रिंशदाढकैर्मुख्यमधमं त्वाढकावरम् ।\nसाधयित्वा यथासंपच्छ्रद्धया विनिवेदयेत्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001257081, "chapter_id": 21257, "verse_number": "२-५-३०-८२", "content_sanskrit": "ततो निवेद्य पानीयं तांबूलं चोपदंशकैः ।\nनीराजनादिकं कृत्वा पूजाशेषं समापयेत्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001257082, "chapter_id": 21257, "verse_number": "२-५-३०-८३", "content_sanskrit": "भोगोपयोग्यद्रव्याणि विशिष्टान्येव साधयेत् ।\nवित्तशाठ्यं न कुर्वीत भक्तिमान्विभवे सति॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001257083, "chapter_id": 21257, "verse_number": "२-५-३०-८४", "content_sanskrit": "शठस्योपेक्षकस्यापि व्यंग्यं चैवानुतिष्ठतः ।\nन फलंत्येव कर्माणि काम्यानीति सतां कथा॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001257084, "chapter_id": 21257, "verse_number": "२-५-३०-८५", "content_sanskrit": "तस्मात्सम्यगुपेक्षां च त्यक्त्वा सर्वांगयोगतः ।\nकुर्यात्काम्यानि कर्माणि फलसिद्धिं यदीच्छति॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001257085, "chapter_id": 21257, "verse_number": "२-५-३०-८६", "content_sanskrit": "इत्थं पूजां समाप्याथ देवं देवीं प्रणम्य च ।\nभक्त्या मनस्समाधाय पश्चात्स्तोत्रमुदीरयेत्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001257086, "chapter_id": 21257, "verse_number": "२-५-३०-८७", "content_sanskrit": "ततः स्तोत्रमुपास्यान्ते त्वष्टोत्तरशतावराम् ।\nजपेत्पञ्चाक्षरीं विद्यां सहस्रोत्तरमुत्सुकः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001257087, "chapter_id": 21257, "verse_number": "२-५-३०-८८", "content_sanskrit": "विद्यापूजां गुरोः पूजां कृत्वा पश्चाद्यथाक्रमम् ।\nयथोदयं यथाश्राद्धं सदस्यानपि पूजयेत्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001257088, "chapter_id": 21257, "verse_number": "२-५-३०-८९", "content_sanskrit": "ततः उद्वास्य देवेशं सर्वैरावरणैः सह ।\nमण्डलं गुरवे दद्याद्यागोपकरणैस्सह॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001257089, "chapter_id": 21257, "verse_number": "२-५-३०-९०", "content_sanskrit": "शिवाश्रितेभ्यो वा दद्यात्सर्वमेवानुपूर्वशः ।\nअथवा तच्छिवायैव शिवक्षेत्रे समर्पयेत्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001257090, "chapter_id": 21257, "verse_number": "२-५-३०-९१", "content_sanskrit": "शिवाग्नौ वा यजेद्देवं होमद्रव्यैश्च सप्तभिः ।\nसमभ्यर्च्य यथान्यायं सर्वावरणदेवताः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001257091, "chapter_id": 21257, "verse_number": "२-५-३०-९२", "content_sanskrit": "एष योगेश्वरो नाम त्रिषु लोकेषु विश्रुतः ।\nन तस्मादधिकः कश्चिद्यागो ऽस्ति भुवने क्वचित्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001257092, "chapter_id": 21257, "verse_number": "२-५-३०-९३", "content_sanskrit": "न तदस्ति जगत्यस्मिन्नसध्यं यदनेन तु ।\nऐहिकं वा फलं किंचिदामुष्मिकफलं तु वा॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001257093, "chapter_id": 21257, "verse_number": "२-५-३०-९४", "content_sanskrit": "इदमस्य फलं नेदमिति नैव नियम्यते ।\nश्रेयोरूपस्य कृत्स्नस्य तदिदं श्रेष्टसाधनम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001257094, "chapter_id": 21257, "verse_number": "२-५-३०-९५", "content_sanskrit": "इदं न शक्यते वक्तुं पुरुषेण यदर्च्यते ।\nचिंतामणेरिवैतस्मात्तत्तेन प्राप्यते फलम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001257095, "chapter_id": 21257, "verse_number": "२-५-३०-९६", "content_sanskrit": "तथापि क्षुद्रमुद्दिश्य फलं नैतत्प्रयोजयेत् ।\nलघ्वर्थी महतो यस्मात्स्वयं लघुतरो भवेत्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001257096, "chapter_id": 21257, "verse_number": "२-५-३०-९७", "content_sanskrit": "महद्वा फलमल्पं वा कृतं चेत्कर्म सिध्यति ।\nमहादेवं समुद्दिश्य कृतं कर्म प्रयुज्यताम्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001257097, "chapter_id": 21257, "verse_number": "२-५-३०-९८", "content_sanskrit": "तस्मादनन्यलभ्येषु शत्रुमृत्युंजयादिषु ।\nफलेषु दृष्टादृष्टेषु कुर्यादेतद्विचक्षणः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001257098, "chapter_id": 21257, "verse_number": "२-५-३०-९९", "content_sanskrit": "महत्स्वपि च पातेषु महारागभयादिषु ।\nदुर्भिक्षादिषु शांत्यर्थं शांतिं कुर्यादनेन तु॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001257099, "chapter_id": 21257, "verse_number": "२-५-३०-१००", "content_sanskrit": "बहुना किं प्रलापेन महाव्यापन्निवारकम् ।\nआत्मीयमस्त्रं शैवानामिदमाह महेश्वरः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001257100, "chapter_id": 21257, "verse_number": "२-५-३०-१०१", "content_sanskrit": "तस्मादितः परं नास्ति परित्राणमिहात्मनः ।\nइति मत्वा प्रयुंजानः कर्मेदं शुभमश्नुते॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001257101, "chapter_id": 21257, "verse_number": "२-५-३०-१०२", "content_sanskrit": "स्तोत्रमात्रं शुचिर्भूत्वा यः पठेत्सुसमाहितः ।\nसोप्यभीष्टतमादर्थादष्टांशफलमाप्नुयात्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001257102, "chapter_id": 21257, "verse_number": "२-५-३०-१०३", "content_sanskrit": "अर्थं तस्यानुसन्धाय पर्वण्यनशनः पठेत् ।\nअष्टाभ्यां वा चतुर्दश्यां फलमर्धं समाप्नुयात्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001257103, "chapter_id": 21257, "verse_number": "२-५-३०-१०४", "content_sanskrit": "यस्त्वर्थमनुसंधाय पर्वादिषु तथा व्रती ।\nमासमेकं जपेत्स्तोत्रं स कृत्स्नं फलमाप्नुयात्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]