[{"id": 7006439000, "chapter_id": 26439, "verse_number": "२-९९-१", "content_sanskrit": "वैशम्पायन उवाच\nएवमालोकयानः स द्वारकां वृषभेक्षणः ।\nअपश्यत्स्वगृहं कृष्णः प्रासादशतशोभितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006439001, "chapter_id": 26439, "verse_number": "२-९९-२", "content_sanskrit": "मणिस्तम्भसहस्राणामयुतैर्विवृतं शतैः ।\nतोरणैर्ज्वलनप्रख्यैर्मणिविद्रुमराजतैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006439002, "chapter_id": 26439, "verse_number": "२-९९-३", "content_sanskrit": "तत्र तत्र प्रभासद्भिश्चित्रकाञ्चनवेदिकैः ।\nप्रासादस्तत्र सुमहान् कृष्णोपस्थानिकोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006439003, "chapter_id": 26439, "verse_number": "२-९९-४", "content_sanskrit": "स्फाटिकस्तम्भविवृतो विस्तीर्णः सर्वकाञ्चनः ।\nपद्माकुलजलोपेता रक्तसौगन्धिकोत्पलाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006439004, "chapter_id": 26439, "verse_number": "२-९९-५", "content_sanskrit": "मणिहेमनिभाश्चित्रा रत्नसोपानभूषिताः ।\nमत्तबर्हिणजुष्टाश्च कोकिलैश्च सदामदैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006439005, "chapter_id": 26439, "verse_number": "२-९९-६", "content_sanskrit": "बभूवुः परमोपेता वाप्यश्च विकचोत्पलाः ।\nविश्वकर्मकृतः शैलः प्राकारस्तस्य वेश्मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006439006, "chapter_id": 26439, "verse_number": "२-९९-७", "content_sanskrit": "व्यक्तकिष्कुशतोत्सेधः परिखापरिवेष्टितः ।\nतद् गृहं वृष्णिसिंहस्य निर्मितं विश्वकर्मणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006439007, "chapter_id": 26439, "verse_number": "२-९९-८", "content_sanskrit": "महेन्द्रसदृशं वेश्म समन्तादर्धयोजनम् ।\nततस्तं पाण्डुरं शौरिर्मूर्ध्नि तिष्ठन् गरुत्मतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006439008, "chapter_id": 26439, "verse_number": "२-९९-९", "content_sanskrit": "प्रीतः शङ्खमुपाध्मासीद् द्विषतां रोमहर्षणम् ।\nतस्य शङ्खस्य शब्देन सागरश्चुक्षुभे भृशम्।\nररास च नभः कृत्स्नं तच्चित्रमभवत् तदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006439009, "chapter_id": 26439, "verse_number": "२-९९-१०", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं संश्रुत्य कुकुरान्धकाः ।\nविशोकाः समपद्यन्त गरुडस्य च दर्शनात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006439010, "chapter_id": 26439, "verse_number": "२-९९-११", "content_sanskrit": "शङ्खचक्रगदापाणिं गरुडस्योपरि स्थितम् ।\nदृष्ट्वा जहृषिरे पौरा भास्करोपमतेजसम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006439011, "chapter_id": 26439, "verse_number": "२-९९-१२", "content_sanskrit": "ततस्तूर्यप्रणादश्च भेरीणां च महास्वनाः ।\nजज्ञिरे सिंहनादाश्च सर्वेषां पुरवासिनाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006439012, "chapter_id": 26439, "verse_number": "२-९९-१३", "content_sanskrit": "ततस्ते सर्वदाशार्हाः सर्वे च कुकुरान्धकाः ।\nप्रीयमाणाः समाजग्मुरालोक्य मधुसूदनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006439013, "chapter_id": 26439, "verse_number": "२-९९-१४", "content_sanskrit": "वासुदेवं पुरस्कृत्य शङ्खतूर्यरवैः  सह ।\nउग्रसेनो ययौ राजा वसुदेवनिवेशनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006439014, "chapter_id": 26439, "verse_number": "२-९९-१५", "content_sanskrit": "आनन्दिनी पर्यचरत् स्वेषु वेष्मसु देवकी ।\nरोहिणी च यशोदा च आहुकस्य च याः स्त्रियः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006439015, "chapter_id": 26439, "verse_number": "२-९९-१६", "content_sanskrit": "ततः कृष्णः सुपर्णेन स्वं निवेशनमभ्यगात् ।\nचचार च यथोद्देशमीश्वरानुचरो हरिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006439016, "chapter_id": 26439, "verse_number": "२-९९-१७", "content_sanskrit": "अवतीर्य गृहद्वारि कृष्णस्तु यदुनन्दनः ।\nयथार्हं पूजयामास यादवान् यादवर्षभः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006439017, "chapter_id": 26439, "verse_number": "२-९९-१८", "content_sanskrit": "रामाहुकगदाक्रूरप्रद्युम्नादिभिरर्चितः ।\nप्रविवेश गृहं शौरिरादाय मणिपर्वतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006439018, "chapter_id": 26439, "verse_number": "२-९९-१९", "content_sanskrit": "तं च शक्रस्य दयितं पारिजातं महाद्रुमम् ।\nप्रवेशयामास गृहं प्रद्युम्नो रुक्मिणीसुतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006439019, "chapter_id": 26439, "verse_number": "२-९९-२०", "content_sanskrit": "तेऽन्योन्यं ददृशुर्वीरा देहबन्धानमानुषान् ।\nपारिजातप्रभावेण ततो मुमुदिरे जनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006439020, "chapter_id": 26439, "verse_number": "२-९९-२१", "content_sanskrit": "तैः स्तूयमानो गोविन्दः प्रहृष्टैर्यादवर्षभैः ।\nप्रविवेश गृहं श्रीमान् विहितं विश्वकर्मणा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006439021, "chapter_id": 26439, "verse_number": "२-९९-२२", "content_sanskrit": "ततोऽन्तःपुरमध्ये तं सशृङ्गमणिपर्वतम् ।\nन्यवेशयदमेयात्मा वृष्णिभिः सहितोऽच्युतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006439022, "chapter_id": 26439, "verse_number": "२-९९-२३", "content_sanskrit": "तं च दिव्यं द्रुमश्रेष्ठं पारिजातममित्रजित् ।\nअर्च्यमर्चितमव्यग्रमिष्टे देशे न्यवेशयत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006439023, "chapter_id": 26439, "verse_number": "२-९९-२४", "content_sanskrit": "अनुज्ञाप्य ततो ज्ञातीन् केशवः परवीरहा ।\nताः स्त्रियः पूजयामास संहृता नरकेण याः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006439024, "chapter_id": 26439, "verse_number": "२-९९-२५", "content_sanskrit": "वस्त्रैराभरणैर्दिव्यैर्दासीभिर्धनसंचयैः ।\nहारैश्चन्द्राशुसंकाशैर्मणिभिश्च महाप्रभैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006439025, "chapter_id": 26439, "verse_number": "२-९९-२६", "content_sanskrit": "पूर्वमभ्यर्चिताश्चैव वसुदेवेन ताः स्त्रियः ।\nदेवक्या सह रोहिण्यां रेवत्या चाहुकेन च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006439026, "chapter_id": 26439, "verse_number": "२-९९-२७", "content_sanskrit": "सत्यभामोत्तमा स्त्रीणां सौभाग्येनाभवत्तदा ।\nकुटुम्बस्येश्वरी त्वासीद्रुक्मिणी भीष्मकात्मजा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006439027, "chapter_id": 26439, "verse_number": "२-९९-२८", "content_sanskrit": "तासां यथार्हहर्म्याणि प्रासादशिखराणि च ।\nआदिदेश गृहान्कृष्णः पारिबर्हांश्च पुष्कलान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]