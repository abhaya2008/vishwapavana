[{"id": 2039854, "chapter_id": 1882, "verse_number": "५-१२७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039855, "chapter_id": 1882, "verse_number": "५-१२७-१", "content_sanskrit": "श्रुत्वा दुर्योधनो वाक्यमप्रियं कुरुसंसदि।\nप्रत्युवाच महाबाहुं वासुदेवं यशस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039856, "chapter_id": 1882, "verse_number": "५-१२७-२", "content_sanskrit": "प्रसमीक्ष्य भवानेतद्वक्तुमर्हति केशव।\nमामेव हि विशेषेण विभाष्य परिगर्हसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039857, "chapter_id": 1882, "verse_number": "५-१२७-३", "content_sanskrit": "भक्तिवादेन पार्थानामकस्मान्मधुसूदन।\nभवान्गर्हयति नित्यं किं समीक्ष्य बलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039858, "chapter_id": 1882, "verse_number": "५-१२७-४", "content_sanskrit": "भवान्क्षत्ता च राजा वाऽप्याचार्यो वा पितामहः ।\nमामेव परिगर्हन्ते नान्यं कंचन पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039859, "chapter_id": 1882, "verse_number": "५-१२७-५", "content_sanskrit": "न चाहं लक्षये कंचिद्व्यभिचारमिहात्मनः ।\nअथ सर्वे भवन्तो मां विद्विषन्ति सराजकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039860, "chapter_id": 1882, "verse_number": "५-१२७-६", "content_sanskrit": "न चाहं कंचिदत्यर्थमपराधमरिन्दम ।\nविचिन्तयन्प्रपश्यामि सुसूक्ष्ममपि केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039861, "chapter_id": 1882, "verse_number": "५-१२७-७", "content_sanskrit": "प्रियाभ्युपगते द्यूते पाण्डवा मधूसूदन।\nजिताः शकुनिना राज्यं तत्र किं मम दुष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039862, "chapter_id": 1882, "verse_number": "५-१२७-८", "content_sanskrit": "यत्पुनर्द्रविणं किंचित्तत्राजीयन्त पाण्डवाः ।\nतेभ्य एवाभ्यनुज्ञातं तत्तद मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039863, "chapter_id": 1882, "verse_number": "५-१२७-९", "content_sanskrit": "अपराधो न चास्माकं यत्ते ह्यक्षैः पराजिताः।\nअजेया जयतां श्रेष्ठ पार्थाः प्रव्राजिता वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039864, "chapter_id": 1882, "verse_number": "५-१२७-१०", "content_sanskrit": "केन वाऽप्यपवादेन विरुद्ध्यन्त्यरिभिः सह।\nअशक्ताः पाण्डवाः कृष्ण प्रहृष्टाः प्रत्यमित्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039865, "chapter_id": 1882, "verse_number": "५-१२७-११", "content_sanskrit": "किमस्माभिः कृतं तेषां कस्मिन्वा पुनरागसि।\nधार्तराष्ट्राञ्जिघांसन्ति पाण्डवाः सृञ्जयैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039866, "chapter_id": 1882, "verse_number": "५-१२७-१२", "content_sanskrit": "न चापि वयमुग्रेण कर्मणा वचनेन वा।\nप्रभ्रष्टाः प्रणमामेह भयादपि शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039867, "chapter_id": 1882, "verse_number": "५-१२७-१३", "content_sanskrit": "न च तं कृष्ण पश्यामि क्षत्रधर्ममनुष्ठितम् ।\nउत्सहेत युधा जेतुं यो नः शत्रुनिबर्हण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039868, "chapter_id": 1882, "verse_number": "५-१२७-१४", "content_sanskrit": "न हि भीष्मकृपद्रोणाः सकर्णा मधुसूदन।\nदेवैरपि युधा जेतुं शक्याः किमुत पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039869, "chapter_id": 1882, "verse_number": "५-१२७-१५", "content_sanskrit": "स्वधर्ममनुपश्यन्तो यदि माधव संयुगे।\nअस्त्रेण निधनं काले प्राप्स्यामः स्वर्ग्यमेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039870, "chapter_id": 1882, "verse_number": "५-१२७-१६", "content_sanskrit": "मुख्यश्चैवैष नो धर्मः क्षत्रियाणां जनार्दन ।\nयच्छयीमहि सङ्ग्रामे शरतल्पगता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039871, "chapter_id": 1882, "verse_number": "५-१२७-१७", "content_sanskrit": "ते वयं वीरशयनं प्राप्स्यामो यदि संयुगे।\nअप्रणम्यैव शत्रूणां न नस्तप्स्यन्ति माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039872, "chapter_id": 1882, "verse_number": "५-१२७-१८", "content_sanskrit": "कश्च जातु कुले जातः क्षत्रधर्मेण वर्तयन् ।\nभयाद्वृत्तिं समीक्ष्यैवं प्रणमेदिह कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039873, "chapter_id": 1882, "verse_number": "५-१२७-१९", "content_sanskrit": "उद्यच्छेदेव न नमेदुद्यमो ह्येव पौरुषम् ।\nअप्यपर्वणि भज्येत न नमेदिह कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039874, "chapter_id": 1882, "verse_number": "५-१२७-२०", "content_sanskrit": "इति मातङ्गवचनं परिप्सन्ति हितेप्सवः ।\nधर्माय चैव प्रणमेद्ब्राह्मणेभ्यश्च मद्विधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039875, "chapter_id": 1882, "verse_number": "५-१२७-२१", "content_sanskrit": "अचिन्तयन्कंचिदन्यं यावज्जीवं तथा चरेत्।\nएष धर्मः क्षत्रियाणां मतमेतच्च मे सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039876, "chapter_id": 1882, "verse_number": "५-१२७-२२", "content_sanskrit": "राज्यांशश्चाभ्यनुज्ञातो यो मे पित्रा पुराऽभवत्।\nन स लभ्यः पुनर्जातु मयि जीवति केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039877, "chapter_id": 1882, "verse_number": "५-१२७-२३", "content_sanskrit": "यावच्च राजा ध्रियते धृतराष्ट्रो जनार्दन ।\nन्यस्तशस्त्रा वयं ते वाऽप्युपजीवाम माधव ।\nअप्रदेयं पुरा दत्तं राज्यं परवतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039878, "chapter_id": 1882, "verse_number": "५-१२७-२४", "content_sanskrit": "अज्ञानाद्वा भयाद्वाऽपि मयि बाले जनार्दन ।\nन तदद्य पुनर्लभ्यं पाण्डवैर्वृष्णिनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039879, "chapter_id": 1882, "verse_number": "५-१२७-२५", "content_sanskrit": "ध्रियमाणे महाबाहौ मयि संप्रति केशव ।\nयावद्धि तीक्ष्णया सूच्या विद्ध्येदग्रेण केशव ।\nतावदप्यपरित्याज्यं भूमेर्नः पाण्डवान्प्रति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039880, "chapter_id": 1882, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि सप्तविंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]