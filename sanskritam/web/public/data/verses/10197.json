[{"id": 6000197000, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000197001, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000197002, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 6000197003, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.001.m4a", "display_order": 4}, {"id": 6000197004, "chapter_id": 10197, "verse_number": "१०-१-१", "content_sanskrit": "कथितो वंशविस्तारो भवता सोमसूर्ययोः।\nराज्ञां चोभयवंश्यानां चरितं परमाद्भुतम्॥ १०/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.002.m4a", "display_order": 5, "topics": [{"text": "श्रीकृष्णावतारस्य पूर्वपीठिका", "range": "१–२८"}]}, {"id": 6000197005, "chapter_id": 10197, "verse_number": "१०-१-२", "content_sanskrit": "यदोश्च धर्मशीलस्य नितरां मुनिसत्तम।\nतत्रांशेनावतीर्णस्य विष्णोर्वीर्याणि शंस नः॥ १०/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.003.m4a", "display_order": 6}, {"id": 6000197006, "chapter_id": 10197, "verse_number": "१०-१-३", "content_sanskrit": "अवतीर्य यदोर्वंशे भगवान् भूतभावनः।\nकृतवान् यानि विश्वात्मा तानि नो वद विस्तरात्॥ १०/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.004.m4a", "display_order": 7}, {"id": 6000197007, "chapter_id": 10197, "verse_number": "१०-१-४", "content_sanskrit": "निवृत्ततर्षैरुपगीयमानाद् भवौषधाच्छ्रोत्रमनोभिरामात्।\nक उत्तमश्लोकगुणानुवादात् पुमान् विरज्येत विना विनाऽतिमुग्धान्॥ १०/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.005.m4a", "display_order": 8}, {"id": 6000197008, "chapter_id": 10197, "verse_number": "१०-१-५", "content_sanskrit": "पितामहा मे समरेऽमरञ्जयैर्देवव्रताद्यातिरथैस्तिमिङ्गिलैः।\nदुरत्ययं कौरवसैन्यसागरं कृत्वाऽतरन् वत्सपदं स्म यत्प्लवाः॥ १०/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.006.m4a", "display_order": 9}, {"id": 6000197009, "chapter_id": 10197, "verse_number": "१०-१-६", "content_sanskrit": "द्रौण्यस्‍त्रविप्लुष्टमिदं मदङ्गं सन्तानबीजं कुरुपाण्डवानाम्।\nजुगोप कुक्षिङ्गत आत्तचक्रो मातुश्च मे यः शरणं गतायाः॥ १०/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.007.m4a", "display_order": 10}, {"id": 6000197010, "chapter_id": 10197, "verse_number": "१०-१-७", "content_sanskrit": "वीर्याणि तस्याखिलदेहभाजामन्तर्बहिः पूरुषकालरूपैः।\nप्रयच्छतो मृत्युमनामयं च मायामनुष्यस्य वदस्व विद्वन्॥ १०/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.008.m4a", "display_order": 11}, {"id": 6000197011, "chapter_id": 10197, "verse_number": "१०-१-८", "content_sanskrit": "रोहिण्यास्तनयः प्रोक्तो रामः सङ्कर्षणस्त्वया।\nदेवक्या गर्भसम्बन्धः कुतो देहान्तरं विना॥ १०/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.009.m4a", "display_order": 12}, {"id": 6000197012, "chapter_id": 10197, "verse_number": "१०-१-९", "content_sanskrit": "कस्मान्मुकुन्दो भगवान् पितुर्गेहाद् व्रजं गतः।\nक्‍व वासं ज्ञातिभिः सार्धं कृतवान् सात्त्वतां पतिः॥ १०/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.010.m4a", "display_order": 13}, {"id": 6000197013, "chapter_id": 10197, "verse_number": "१०-१-१०", "content_sanskrit": "व्रजे वसन् किमकरोन्मधुपुर्यां च केशवः।\nभ्रातरं चावधीत् कंसं मातुरद्धाऽतदर्हणम्॥ १०/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.011.m4a", "display_order": 14}, {"id": 6000197014, "chapter_id": 10197, "verse_number": "१०-१-११", "content_sanskrit": "देहं मानुषमाश्रित्य कति वर्षाणि वृष्णिभिः।\nयदुपुर्यां सहावात्सीत् पत्न्यः कत्यभवन् विभोः॥ १०/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.012.m4a", "display_order": 15}, {"id": 6000197015, "chapter_id": 10197, "verse_number": "१०-१-१२", "content_sanskrit": "एतदन्यच्च सर्वं मे मुने कृष्णविचेष्टितम्।\nवक्तुमर्हसि सर्वज्ञ श्रद्दधानाय विस्तृतम्॥ १०/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.013.m4a", "display_order": 16}, {"id": 6000197016, "chapter_id": 10197, "verse_number": "१०-१-१३", "content_sanskrit": "नैषाऽतिदुस्सहा क्षुन्मां त्यक्तोदमपि बाधते।\nपिबन्तं त्वन्मुखाम्भोजसृतं हरिकथामृतम्॥ १०/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.014.m4a", "display_order": 17}, {"id": 6000197017, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.015.m4a", "display_order": 18}, {"id": 6000197018, "chapter_id": 10197, "verse_number": "१०-१-१४", "content_sanskrit": "एवं निशम्य भृगुनन्दन साधुवादं वैयासकिः स भगवानथ विष्णुरातम्।\nप्रत्यर्च्य कृष्णचरितं कलिकल्मषघ्नं व्याहर्तुमारभत भागवतप्रधानः॥ १०/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.016.m4a", "display_order": 19}, {"id": 6000197019, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.017.m4a", "display_order": 20}, {"id": 6000197020, "chapter_id": 10197, "verse_number": "१०-१-१५", "content_sanskrit": "सम्यग् व्यवसिता बुद्धिस्तव राजर्षिसत्तम।\nवासुदेवकथायां ते यज्जाता नैष्ठिकी रतिः॥ १०/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.018.m4a", "display_order": 21}, {"id": 6000197021, "chapter_id": 10197, "verse_number": "१०-१-१६", "content_sanskrit": "वासुदेवकथाप्रश्नः पुरुषांस्‍त्रीन् पुनाति हि।\nवक्तारं पुच्छकं श्रोतॄंस्तत्पादसलिलं यथा॥ १०/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.019.m4a", "display_order": 22}, {"id": 6000197022, "chapter_id": 10197, "verse_number": "१०-१-१७", "content_sanskrit": "भूमिर्दृप्तनृपव्याजदैत्यानीकशतायुतैः।\nआक्रान्ता भूरिभारेण ब्रह्माणं शरणं ययौ॥ १०/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.020.m4a", "display_order": 23}, {"id": 6000197023, "chapter_id": 10197, "verse_number": "१०-१-१८", "content_sanskrit": "गौर्भूत्वाऽश्रुमुखी खिन्ना रुदन्ती करुणं यथा।\nउपस्थिताऽन्तिके तस्मै व्यसनं समवोचत॥ १०/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.021.m4a", "display_order": 24}, {"id": 6000197024, "chapter_id": 10197, "verse_number": "१०-१-१९", "content_sanskrit": "ब्रह्मा तदुपधार्याथ सह देवैस्तया सह।\nजगाम सत्रिनयनस्तीरं क्षीरपयोनिधेः॥ १०/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.022.m4a", "display_order": 25}, {"id": 6000197025, "chapter_id": 10197, "verse_number": "१०-१-२०", "content_sanskrit": "तत्र गत्वा जगन्नाथं देवदेवं वृषाकपिम्।\nपुरुषं पुरुषसूक्तेन उपतस्थे समाहितः॥ १०/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.023.m4a", "display_order": 26}, {"id": 6000197026, "chapter_id": 10197, "verse_number": "१०-१-२१", "content_sanskrit": "गिरं समाधौ गगने समीरितां निशम्य वेधास्‍त्रिदशानुवाच ह।\nगां पौरुषीं मे शृणुतामराः पुनर्विधीयतामाशु तथैव मा चिरम्॥ १०/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.024.m4a", "display_order": 27}, {"id": 6000197027, "chapter_id": 10197, "verse_number": "१०-१-२२", "content_sanskrit": "पुरैव पुंसाऽवधृतो धराज्वरो भवद्भिरंशैर्यदुषूपजन्यताम्।\nस यावदुर्व्या भरमीश्वरेश्वरः स्वकालशक्त्या क्षपयंश्चरेद् भुवि॥ १०/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.025.m4a", "display_order": 28}, {"id": 6000197028, "chapter_id": 10197, "verse_number": "१०-१-२३", "content_sanskrit": "वसुदेवगृहे साक्षाद् भगवान् पुरुषः परः।\nजनिष्यते तत्प्रियार्थं सम्भवन्तु सुरस्‍त्रियः॥ १०/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.026.m4a", "display_order": 29}, {"id": 6000197029, "chapter_id": 10197, "verse_number": "१०-१-२४", "content_sanskrit": "वासुदेवकलानन्तः सहस्रवदनः स्वराट्।\nअग्रतो भविता देवो हरेः प्रियचिकीर्षया॥ १०/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.027.m4a", "display_order": 30}, {"id": 6000197030, "chapter_id": 10197, "verse_number": "१०-१-२५", "content_sanskrit": "योगमाया भगवती यया सम्मोहितं जगत्।\nआदिष्टा प्रभुणांऽशेन कार्यार्थे सम्भविष्यति॥ १०/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.028.m4a", "display_order": 31}, {"id": 6000197031, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.029.m4a", "display_order": 32}, {"id": 6000197032, "chapter_id": 10197, "verse_number": "१०-१-२६", "content_sanskrit": "इत्यादिश्यामरगणान् प्रजापतिपतिर्विभुः।\nआश्वास्य च महीं गीर्भिः स्वधाम परमं ययौ॥ १०/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.030.m4a", "display_order": 33}, {"id": 6000197033, "chapter_id": 10197, "verse_number": "१०-१-२७", "content_sanskrit": "शूरसेनो यदुपतिर्मधुरामावसत् पुरीम्।\nमाधुरान् शूरसेनांश्च विषयान् बुभुजे स्वराट्॥ १०/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.031.m4a", "display_order": 34}, {"id": 6000197034, "chapter_id": 10197, "verse_number": "१०-१-२८", "content_sanskrit": "राजधानी ततः साऽभूत्सर्वयादवभूभुजाम्।\nमधुरा भगवान् यत्र नित्यं सन्निहितो हरिः॥ १०/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.032.m4a", "display_order": 35}, {"id": 6000197035, "chapter_id": 10197, "verse_number": "१०-१-२९", "content_sanskrit": "तस्यां तु कर्हिचिच्छौरिर्वसुदेवः कृतोद्वहः।\nदेवक्या भार्यया सार्धं प्रयाणे रथमारुहत्॥ १०/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.033.m4a", "display_order": 36, "topics": [{"text": "देवकीवसुदेवयोर्विवाहः", "range": "२९–३३"}]}, {"id": 6000197036, "chapter_id": 10197, "verse_number": "१०-१-३०", "content_sanskrit": "उग्रसेनसुतः कंसः स्वसुः प्रियचिकीर्षया।\nरश्मीन् हयानां जगृहे रौक्मै रथशतैर्वृतः॥ १०/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.034.m4a", "display_order": 37}, {"id": 6000197037, "chapter_id": 10197, "verse_number": "१०-१-३१", "content_sanskrit": "चतुश्शतं पारिबर्हं गजानां हेममालिनाम्।\nअश्वानामयुतं सार्धं रथानां च त्रिषट्शतम्॥ १०/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.035.m4a", "display_order": 38}, {"id": 6000197038, "chapter_id": 10197, "verse_number": "१०-१-३२", "content_sanskrit": "दासीनां सुकुमारीणां द्वे शते समलङ्कृते।\nदुहित्रे देवकः प्रादाद् याने दुहितृवत्सलः॥ १०/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.036.m4a", "display_order": 39}, {"id": 6000197039, "chapter_id": 10197, "verse_number": "१०-१-३३", "content_sanskrit": "शङ्खतूर्यमृदङ्गानि नेदुर्दुन्दुभयः समम्।\nप्रयाणप्रक्रमे तात वरवध्वोः सुमङ्गलम्॥ १०/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.037.m4a", "display_order": 40}, {"id": 6000197040, "chapter_id": 10197, "verse_number": "१०-१-३४", "content_sanskrit": "पथि प्रग्रहिणं कंसमाभाष्याहाशरीरवाक्।\nअस्यास्त्वामष्टमो गर्भो हन्ता यां नयसेऽबुध॥ १०/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.038.m4a", "display_order": 41}, {"id": 6000197041, "chapter_id": 10197, "verse_number": "१०-१-३५", "content_sanskrit": "इत्युक्तः स खलः पापो भोजानां कुलपांसनः।\nभगिनीं हन्तुमारब्धः खड्गपाणिः कचेऽग्रहीत्॥ १०/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.039.m4a", "display_order": 42}, {"id": 6000197042, "chapter_id": 10197, "verse_number": "१०-१-३६", "content_sanskrit": "तं जुगुप्सितकर्माणं नृशंसं निरपत्रपम्।\nवसुदेवो महाभाग उवाच परिसान्त्वयन्॥ १०/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.040.m4a", "display_order": 43}, {"id": 6000197043, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "वसुदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.041.m4a", "display_order": 44}, {"id": 6000197044, "chapter_id": 10197, "verse_number": "१०-१-३७", "content_sanskrit": "श्लाघनीयगुणः शूरैर्भवान् भोजयशस्करः।\nस कथं भगिनीं हन्याः स्‍त्रियमुद्वाहपर्वणि॥ १०/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.042.m4a", "display_order": 45, "topics": [{"text": "देवकीहननोद्युक्तस्य कंसस्य वसुदेवेन सामपूर्वकं निवर्तनम्", "range": "३७–५४"}]}, {"id": 6000197045, "chapter_id": 10197, "verse_number": "१०-१-३८", "content_sanskrit": "मृत्युर्जन्मवतां वीर देहेन सह जायते।\nअद्य वाऽब्दशतान्ते वा मृत्युर्वै प्राणिनां ध्रुवः॥ १०/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.043.m4a", "display_order": 46}, {"id": 6000197046, "chapter_id": 10197, "verse_number": "१०-१-३९", "content_sanskrit": "देहे पञ्चत्वमापन्ने देही कर्मानुगोऽवशः।\nदेहान्तरमनुप्राप्य प्राक्तनं त्यजते वपुः॥ १०/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.044.m4a", "display_order": 47}, {"id": 6000197047, "chapter_id": 10197, "verse_number": "१०-१-४०", "content_sanskrit": "व्रजंस्तिष्ठन् पदैकेन यथैवेकेन गच्छति।\nयथा तृणजलूकैवं देही कर्मगतिं गतः॥ १०/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.045.m4a", "display_order": 48}, {"id": 6000197048, "chapter_id": 10197, "verse_number": "१०-१-४१", "content_sanskrit": "स्वप्ने यथा पश्यति देहमीदृशं मनोरथेनाभिनिविष्टचेतनः।\nदृष्टश्रुताभ्यां मनसाऽनुचिन्तयन् प्रपद्यते तत् किमपि ह्यपस्मृतिः॥ १०/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.046.m4a", "display_order": 49}, {"id": 6000197049, "chapter_id": 10197, "verse_number": "१०-१-४२", "content_sanskrit": "यतो यतो धावति दैवचोदितं मनो विकारात्मकमात्मपञ्चसु।\nगुणेषु मायारचितेषु देह्यसौ प्रपद्यमानः सह तेन जायते॥ १०/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.047.m4a", "display_order": 50}, {"id": 6000197050, "chapter_id": 10197, "verse_number": "१०-१-४३", "content_sanskrit": "ज्योतिर्यथैवोदकपार्थिवेष्वदः समीरवेगानुगतं विभाव्यते।\nएवं स्वमायारचितेष्वसौ पुमान् गुणेषु रागानुगतो विमुह्यति॥ १०/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.048.m4a", "display_order": 51}, {"id": 6000197051, "chapter_id": 10197, "verse_number": "१०-१-४४", "content_sanskrit": "तस्मान्न कस्यचिद् द्रोहमाचरेत् स तथाविधः।\nआत्मनः क्षेममन्विच्छन् द्रोग्धुर्वै परतो भयम्॥ १०/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.049.m4a", "display_order": 52}, {"id": 6000197052, "chapter_id": 10197, "verse_number": "१०-१-४५", "content_sanskrit": "एषा तवानुजा बाला कृपणा पुत्रिकोपमा।\nहन्तुं नार्हसि कल्याणीमिमां त्वं दीनवत्सल॥ १०/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.050.m4a", "display_order": 53}, {"id": 6000197053, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.051.m4a", "display_order": 54}, {"id": 6000197054, "chapter_id": 10197, "verse_number": "१०-१-४६", "content_sanskrit": "एवं स सामभिर्भेदैर्बोध्यमानोऽपि दारुणः।\nन न्यवर्तत कौरव्य पुरुषादाननुव्रतः॥ १०/१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.052.m4a", "display_order": 55}, {"id": 6000197055, "chapter_id": 10197, "verse_number": "१०-१-४७", "content_sanskrit": "निर्बन्धं तस्य तं ज्ञात्वा विचिन्त्यानकदुन्दुभिः।\nप्राप्तकालं प्रतिव्योढुमिदं तत्रान्वपद्यत॥ १०/१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.053.m4a", "display_order": 56}, {"id": 6000197056, "chapter_id": 10197, "verse_number": "१०-१-४८", "content_sanskrit": "मृत्युर्बुद्धिमताऽपोह्यो यावद्बुद्धिबलोदयम्।\nयद्यसौ न निवर्तेत नापराधोऽस्ति देहिनः॥ १०/१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.054.m4a", "display_order": 57}, {"id": 6000197057, "chapter_id": 10197, "verse_number": "१०-१-४९", "content_sanskrit": "प्रत्यर्प्य मृत्यवे पुत्रान् मोचये कृपणामिमाम्।\nसुता मे यदि जायेरन् मृत्युर्वा न म्रियेत चेत्॥ १०/१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.055.m4a", "display_order": 58}, {"id": 6000197058, "chapter_id": 10197, "verse_number": "१०-१-५०", "content_sanskrit": "विपर्ययो वा किं न स्याद् गतिर्धातुर्दुरत्यया।\nउपस्थितो निवर्तेत निवृत्तः पुनरापतेत्॥ १०/१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.056.m4a", "display_order": 59}, {"id": 6000197059, "chapter_id": 10197, "verse_number": "१०-१-५१", "content_sanskrit": "अग्नेर्यथा दारुवियोगयोगयोरदृष्टतोऽन्यन्न निमित्तमस्ति।\nएवं हि जन्तोरपि दुर्विभाव्यः शरीरसंयोगवियोगहेतुः॥ १०/१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.057.m4a", "display_order": 60}, {"id": 6000197060, "chapter_id": 10197, "verse_number": "१०-१-५२", "content_sanskrit": "एवं विमृश्य तं पापं यावदात्मनि दर्शनम्।\nसान्त्वयामास वै शौरिर्बहुमानपुरस्सरम्॥ १०/१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.058.m4a", "display_order": 61}, {"id": 6000197061, "chapter_id": 10197, "verse_number": "१०-१-५३", "content_sanskrit": "प्रसन्नवदनाम्भोजो नृशंसं निरपत्रपम्।\nमनसा दूयमानेन प्रहसन्निदमब्रवीत्॥ १०/१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.059.m4a", "display_order": 62}, {"id": 6000197062, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "वसुदेव उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.060.m4a", "display_order": 63}, {"id": 6000197063, "chapter_id": 10197, "verse_number": "१०-१-५४", "content_sanskrit": "न ह्यस्यास्ते भयं सौम्य यद् वागाहाशरीरिणी।\nपुत्रान्समर्पयिष्येऽस्या यतस्ते भयमुत्थितम्॥ १०/१/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_001/BhP_10.001.061.m4a", "display_order": 64}, {"id": 6000197064, "chapter_id": 10197, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]