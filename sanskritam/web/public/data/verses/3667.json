[{"id": 2124405, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124406, "chapter_id": 3667, "verse_number": "१", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथा वदसि नो मुने ।\nअहं चैव विजानामि सर्वे चेमे नराधिपाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124407, "chapter_id": 3667, "verse_number": "२", "content_sanskrit": "भवांस्तु मन्यते साधु यत् कुरूणां सुखोदयम् ।\nतदेव विदुरोऽप्याह भीष्मो द्रोणश्च मां मुने\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124408, "chapter_id": 3667, "verse_number": "३", "content_sanskrit": "यदि त्वहमनुग्राह्यः कौरवेषु दया यदि ।\nअनुशाधि दुरात्मानं पुत्रं दुर्योधनं मम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124409, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124410, "chapter_id": 3667, "verse_number": "४", "content_sanskrit": "अयमायाति वै राजन् मैत्रेयो भगवानृषिः ।\nअन्वीक्ष्य पाण्डवान् भ्रातॄन् इहैवाऽस्मद्दिदृक्षया \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124411, "chapter_id": 3667, "verse_number": "५", "content_sanskrit": "एष दुर्योधनं पुत्रं तव राजन् महानृषिः ।\nअनुशास्तु यथान्यायं शमायास्य कुलस्य ते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124412, "chapter_id": 3667, "verse_number": "६", "content_sanskrit": "ब्रूयाद् यदेष राजेन्द्र तत् कार्यमविशङ्कया ।\nअक्रियायां हि कार्यस्य पुत्रं ते शप्स्यते रुषा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124413, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124414, "chapter_id": 3667, "verse_number": "७", "content_sanskrit": "एवमुक्त्वा ययौ व्यासो मैत्रेयः प्रत्यदृश्यत ।\nपूजया प्रतिजग्राह ससुतस्तं नराधिपः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124415, "chapter_id": 3667, "verse_number": "८", "content_sanskrit": "कृत्वाऽर्घ्याद्याः क्रियाः सर्वा विश्रान्तं मुनिपुङ्गवम् ।\nप्रश्रयेणाब्रवीद् राजा धृतराष्ट्रोऽम्बिकासुतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124416, "chapter_id": 3667, "verse_number": "९", "content_sanskrit": "सुखेनागमनं कच्चिद् भगवन् कुरुजाङ्गलान् ।\nकच्चित् कुशलिनो वीरा भ्रातरः पञ्च पाण्डवाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124417, "chapter_id": 3667, "verse_number": "१०", "content_sanskrit": "समये स्थातुमिच्छन्ति कच्चिच्च पुरुषर्षभाः ।\nकच्चित् कुरूणां सौभ्रात्रमविच्छिन्नं भविष्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124418, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "मैत्रेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124419, "chapter_id": 3667, "verse_number": "११", "content_sanskrit": "तीर्थयात्रा परिक्रमान् प्राप्तो वै कुरुजाङ्गलम् ।\nयदृच्छया धर्मराजं दृष्टवान् काम्यके वने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124420, "chapter_id": 3667, "verse_number": "१२", "content_sanskrit": "तं जटाजिनसंवीतं तपोवननिवासिनः ।\nसमाजग्मुर्महात्मानं द्रष्टुं मुनिगणाः प्रभो\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124421, "chapter_id": 3667, "verse_number": "१३", "content_sanskrit": "तत्राश्रौषमहं राजन् पुत्राणां तव विग्रहम् ।\nअनयं द्यूतरूपेण महापायमुपस्थितम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124422, "chapter_id": 3667, "verse_number": "१४", "content_sanskrit": "ततोऽहं त्वामनुप्राप्तः कौरवाणामवेक्षया ।\nसदा ह्यभ्यधिकः स्नेहः प्रीतिश्च त्वयि मे विभो\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124423, "chapter_id": 3667, "verse_number": "१५", "content_sanskrit": "नैतदौपयिकं राजन् त्वयि भीष्मे च जीवति ।\nयदन्योन्येन ते पुत्रा विरुध्यन्ते नराधिप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124424, "chapter_id": 3667, "verse_number": "१६", "content_sanskrit": "मेढीभूतः स्वयं राजन् निग्रहे प्रग्रहे भवान् ।\nकिमर्थमनयं घोरमुत्पतन्तमुपेक्षसे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124425, "chapter_id": 3667, "verse_number": "१७", "content_sanskrit": "दस्यूनामिव यद् वृत्तं सभायां कुरुनन्दन ।\nतेन न भ्राजसे राजन् तापसानां समागमे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124426, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124427, "chapter_id": 3667, "verse_number": "१८", "content_sanskrit": "ततो व्यावृत्य राजानं दुर्योधनममर्षणम् ।\nउवाच श्लक्ष्णया वाचा मैत्रेयो भगवानृषिः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124428, "chapter_id": 3667, "verse_number": "१९", "content_sanskrit": "दुर्योधन महाबाहो निबोध वदतांवर ।\nवचनं मे महाप्राज्ञ ब्रुवतो यद्धितं तव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124429, "chapter_id": 3667, "verse_number": "२०", "content_sanskrit": "मा द्रुहः पाण्डवान् राजन् कुरुष्व हितमात्मनः ।\nकुरूणां पाडवानां च लोकस्य च नरर्षभ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124430, "chapter_id": 3667, "verse_number": "२१", "content_sanskrit": "पाण्डवान् प्राप्य तान् रात्रौ किर्म्मीरो नाम राक्षसः ।\nआवृत्य मार्गं रौद्रात्मा तस्थौ गिरिरिवाचलः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124431, "chapter_id": 3667, "verse_number": "२२", "content_sanskrit": "तं भीमः समरश्लाघी बलेन बलिनां वरः ।\nजघान पशुमारेण व्याघ्रः क्षुद्रमृगं यथा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124432, "chapter_id": 3667, "verse_number": "२३", "content_sanskrit": "पश्य दिग्विजये राजन् यथा भीमेन पातितः ।\nजरासन्धो महेष्वासो नागायुतबलो युधि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124433, "chapter_id": 3667, "verse_number": "२४", "content_sanskrit": "सम्बन्धी यस्य श्रीकृष्णो येषां स्यालश्च पार्षतः ।\nते ते सर्वे नरव्याघ्राः शूरा विक्रान्तयोधिनः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124434, "chapter_id": 3667, "verse_number": "२५", "content_sanskrit": "सर्वे नागायुतप्राणा वज्रसंहनना दृढाः ।\nराजन् प्रीतिकराः सर्वे सर्वे पुरुषमानिनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124435, "chapter_id": 3667, "verse_number": "२६", "content_sanskrit": "हन्तारो देवशत्रूणां रक्षसां कामरूपिणाम् ।\nहिडिम्बबकमुख्यानां किर्म्मीरस्य च रक्षसः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124436, "chapter_id": 3667, "verse_number": "२७", "content_sanskrit": "कस्तान् युधि समासीत जरामरणवान् नरः ।\nतस्य ते शम एवास्तु पाण्डवैर्भरतर्षभ ।\nकुरुष्व वचनं राजन् मा मृत्युवशमन्वगाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124437, "chapter_id": 3667, "verse_number": "२८", "content_sanskrit": "एवं तु ब्रुवतस्तस्य मैत्रेयस्य विशाम्पते ।\nऊरुं गजकराकारं मैत्रेयाय जघान सः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124438, "chapter_id": 3667, "verse_number": "२९", "content_sanskrit": "दुर्योधनः स्मितं कृत्वा चरणेनोल्लिखन् महीम् ।\nन किञ्चिदुक्त्वा दुर्मेधास्तस्थौ किञ्चिदवाङ्मुखः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124439, "chapter_id": 3667, "verse_number": "३०", "content_sanskrit": "तमशुश्रूषमाणं तु विलिखन्तं वसुन्धराम् ।\nदृष्ट्वा दुर्योधनं राजन् मैत्रेयं कोप आविशत् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124440, "chapter_id": 3667, "verse_number": "३१", "content_sanskrit": "स कोपवशमापन्नो मैत्रेयो भगवानृषिः ।\nविधिना सम्प्रयुक्तश्च शापायास्य मनो दधे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124441, "chapter_id": 3667, "verse_number": "३२", "content_sanskrit": "ततः स वार्युपस्पृश्य कोपसंरक्तलोचनः ।\nमैत्रेयो धार्तराष्ट्रं तमशपद् दुष्टचेतसाम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124442, "chapter_id": 3667, "verse_number": "३३", "content_sanskrit": "यस्मात् त्वं मामनादृत्य न मे वाचं चिकीर्षसि ।\nतस्मादस्यातिमानस्य सद्यः फलमवाप्स्यसि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124443, "chapter_id": 3667, "verse_number": "३४", "content_sanskrit": "त्वदभिद्रोहसंयुक्तं युद्धमुत्पत्स्यते महत् ।\nयत्र भीमो गदाघातैस्तवोरुं भेत्स्यते बलात् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124444, "chapter_id": 3667, "verse_number": "३५", "content_sanskrit": "इत्येवमुक्ते वचने धृतराष्ट्रो महीपतिः ।\nप्रसादयामास मुनिं नैतदेवं भवेदिति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124445, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "मैत्रेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124446, "chapter_id": 3667, "verse_number": "३६", "content_sanskrit": "शमं यास्यति चेत् पुत्रस्तव राजन् यथा तथा ।\nशापो न भविता तात विपरीते भविष्यति \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124447, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124448, "chapter_id": 3667, "verse_number": "३७", "content_sanskrit": "स विलक्षस्तु राजेन्द्र दुर्योधनपिता तदा ।\nमैत्रेयं प्राह किर्म्मीरः कथं भीमेन पातितः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2124449, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "मैत्रेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2124450, "chapter_id": 3667, "verse_number": "३८", "content_sanskrit": "नाहं वक्ष्याम्यसूया मे न ते शुश्रूषते सुतः ।\nएष ते विदुरः सर्वमाख्यास्यति गते मयि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2124451, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2124452, "chapter_id": 3667, "verse_number": "३९", "content_sanskrit": "इत्येवमुक्त्वा मैत्रेयः स प्रातिष्ठद् यथागतम् ।\nकिर्म्मीरवधसंविग्नो भयं दुर्योधनोऽगमत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2124453, "chapter_id": 3667, "verse_number": "९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वनपर्वणि\nनवमोऽध्यायः ॥९॥\n॥ आरण्यकपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2124454, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "॥ समाप्तम् आरण्यकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2124455, "chapter_id": 3667, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]