[{"id": 40007050, "chapter_id": 8996, "verse_number": "1", "content_sanskrit": "ततश्शूर्पणखां रामः कामपाशावपाशिताम्। स्वच्छया श्लक्ष्णया वाचा स्मितपूर्वमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40007051, "chapter_id": 8996, "verse_number": "2", "content_sanskrit": "कृतदारोऽस्मि भवति भार्येयं दयिता मम। त्वद्विधानां तु नारीणां सुदुःखा ससपत्नता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40007052, "chapter_id": 8996, "verse_number": "3", "content_sanskrit": "अनुजस्त्वेष मे भ्राता शीलवान्प्रियदर्शनः। श्रीमानकृतदारश्च लक्ष्मणो नाम वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40007053, "chapter_id": 8996, "verse_number": "4", "content_sanskrit": "अपूर्वी भार्यया चार्थी तरुणः प्रियदर्शनः। अनुरूपश्च ते भर्ता रूपस्यास्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40007054, "chapter_id": 8996, "verse_number": "5", "content_sanskrit": "एनं भज विशालाक्षि भर्तारं भ्रातरं मम। असपत्ना वरारोहे मेरुमर्कप्रभा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40007055, "chapter_id": 8996, "verse_number": "6", "content_sanskrit": "इति रामेण सा प्रोक्ता राक्षसी काममोहिता। विसृज्य रामं सहसा ततो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40007056, "chapter_id": 8996, "verse_number": "7", "content_sanskrit": "अस्य रूपस्य ते युक्ता भार्याहं वरवर्णिनी। मया सह सुखं सर्वान्दण्डकान्विचरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40007057, "chapter_id": 8996, "verse_number": "8", "content_sanskrit": "एवमुक्तस्तु सौमित्री राक्षस्या वाक्यकोविदः। ततश्शूर्पणखीं स्मित्वा लक्ष्मणो युक्तमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40007058, "chapter_id": 8996, "verse_number": "9", "content_sanskrit": "कथं दासस्य मे दासी भार्या भवितुमिच्छसि। सोऽहमार्येण परवान्भ्रात्रा कमलवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40007059, "chapter_id": 8996, "verse_number": "10", "content_sanskrit": "समृद्धार्थस्य सिद्धार्था मुदितामलवर्णिनी। आर्यस्य त्वं विशालाक्षि भार्या भव यवीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40007060, "chapter_id": 8996, "verse_number": "11", "content_sanskrit": "एनां विरूपामसतीं करालां निर्णतोदरीम्। भार्यां वृद्धां परित्यज्य त्वामेवैष भजिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40007061, "chapter_id": 8996, "verse_number": "12", "content_sanskrit": "को हि रूपमिदं श्रेष्ठं संत्यज्य वरवर्णिनि। मानुषीषु वरारोहे कुर्याद्भावं विचक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40007062, "chapter_id": 8996, "verse_number": "13", "content_sanskrit": "इति सा लक्ष्मणेनोक्ता कराला निर्णतोदरी। मन्यते तद्वचस्तथ्यं परिहासाविचक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40007063, "chapter_id": 8996, "verse_number": "14", "content_sanskrit": "सा रामं पर्णशालायामुपविष्टं परन्तपम्। सीतया सह दुर्दर्षमब्रवीत्काममोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40007064, "chapter_id": 8996, "verse_number": "15", "content_sanskrit": "एनां विरूपामसतीं करालां निर्णतोदरीम्। वृद्धां भार्यामवष्टभ्य मां न त्वं बहुमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40007065, "chapter_id": 8996, "verse_number": "16", "content_sanskrit": "अद्येमां भक्षयिष्यामि पश्यतस्तव मानुषीम्। त्वया सह चरिष्यामि निस्सपत्ना यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40007066, "chapter_id": 8996, "verse_number": "17", "content_sanskrit": "इत्युक्त्वा मृगशाबाक्षीमलातसदृशेक्षणा। अभ्यधावत्सुसङ्कृद्धा महोल्कां रोहिणीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40007067, "chapter_id": 8996, "verse_number": "18", "content_sanskrit": "तां मृत्युपाशप्रतिमामापतन्तीं महाबलः। निगृह्य रामः कुपित स्ततो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40007068, "chapter_id": 8996, "verse_number": "19", "content_sanskrit": "क्रूरैरनार्यै स्सौमित्रे परिहासः कथञ्चन। न कार्यः पश्यवैदेहीं कथञ्चित्सौम्य जीवतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40007069, "chapter_id": 8996, "verse_number": "20", "content_sanskrit": "इमां विरूपामसतीमतिमत्तां महोदरीम्। राक्षसीं पुरुषव्याघ्र विरूपयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40007070, "chapter_id": 8996, "verse_number": "21", "content_sanskrit": "इत्युक्तो लक्ष्मणस्तस्याः क्रुद्धो रामस्य पार्श्वतः। उद्धृत्य खङ्गं चिच्छेद कर्णनासं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40007071, "chapter_id": 8996, "verse_number": "22", "content_sanskrit": "निकृत्तकर्णनासा तु विस्वरं सा विनद्य च। यथागतं प्रदुद्राव घोरा शूर्पणखा वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40007072, "chapter_id": 8996, "verse_number": "23", "content_sanskrit": "सा विरूपा महाघोरा राक्षसी शोणितोक्षिता। ननाद विविधान्नादान्यथा प्रावृषि तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40007073, "chapter_id": 8996, "verse_number": "24", "content_sanskrit": "सा विक्षरन्ती रुधिरं बहुधा घोरदर्शना। प्रगृह्य बाहू गर्जन्ती प्रविवेश महावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40007074, "chapter_id": 8996, "verse_number": "25", "content_sanskrit": "ततस्तु सा राक्षससङ्घसंवृतं खरं जनस्थानगतं विरूपिता। उपेत्य तं भ्रातरमुग्रदर्शनं पपात भूमौ गगनाद्यथाऽशनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40007075, "chapter_id": 8996, "verse_number": "26", "content_sanskrit": "ततस्सभार्यं भयमोहमूर्छिता सलक्ष्मणं राघवमागतं वनम्। विरूपणं चात्मनि शोणितोक्षिता शशंस सर्वं भगिनी खरस्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]