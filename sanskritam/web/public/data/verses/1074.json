[{"id": 2003804, "chapter_id": 1074, "verse_number": "१-७५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003805, "chapter_id": 1074, "verse_number": "१-७५-१", "content_sanskrit": "अथ दीर्घस्य कालस्य देवयानी नृपोत्तम।\nवनं तदेव निर्याता क्रीडार्थं वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003806, "chapter_id": 1074, "verse_number": "१-७५-२", "content_sanskrit": "तेन दासीसहस्रेण सार्धं शर्मिष्ठया तदा।\nतमेव देशं संप्राप्ता यथाकामं चचार सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003807, "chapter_id": 1074, "verse_number": "१-७५-३", "content_sanskrit": "ताभिः सखीभिः सहिता सर्वाभिर्मुदिता भृशम्।\nक्रीडन्त्योऽभिरताः सर्वाः पिबन्त्यो मधुमाधवीं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003808, "chapter_id": 1074, "verse_number": "१-७५-४", "content_sanskrit": "खादन्त्यो विविधान्भक्ष्यान्विदशन्त्यः फलानि च।\nपुनश्च नाडुषो राजा मृगलिप्सुर्यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003809, "chapter_id": 1074, "verse_number": "१-७५-५", "content_sanskrit": "तमेव देशं संप्राप्तो जलार्थी श्रमकर्शितः।\nददर्श देवयानीं स शर्मिष्ठां ताश्च योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003810, "chapter_id": 1074, "verse_number": "१-७५-६", "content_sanskrit": "पिबन्तीर्ललमानाश्च दिव्याभरणभूषिताः।\nआसनप्रवरे दिव्ये सर्वरत्नविभूषिते।\nउपविष्टां च ददृशे देवयानीं शुचिस्मिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003811, "chapter_id": 1074, "verse_number": "१-७५-७", "content_sanskrit": "रूपेणाप्रतिमां तासां स्त्रीणां मध्ये वराङ्गनम्।\nआसनाच्च ततः किंचिद्विहीनां हेमभीषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003812, "chapter_id": 1074, "verse_number": "१-७५-८", "content_sanskrit": "असुरेन्द्रसुतां चापि निषण्णां चारुहासिनीम्।\nददर्श पादौ विप्रायाः संवहन्तीमनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003813, "chapter_id": 1074, "verse_number": "१-७५-९", "content_sanskrit": "गायन्त्योऽथ प्रनृत्यन्त्यो वादयन्त्योऽथ भारत।\nदृष्ट्वा ययातिमतुलं लज्जयाऽवनताः स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003814, "chapter_id": 1074, "verse_number": "१-७५-१०x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003815, "chapter_id": 1074, "verse_number": "१-७५-१०", "content_sanskrit": "द्वाभ्यां कन्यासहस्राभ्यां द्वे कन्ये परिवारिते।\nगोत्रे च नामनी चैव द्वयोः पृच्छाम्यहं शुभे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003816, "chapter_id": 1074, "verse_number": "१-७५-११x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003817, "chapter_id": 1074, "verse_number": "१-७५-११", "content_sanskrit": "आख्यास्याम्यहमादत्स्व वचनं मे नराधिप।\nशुक्रो नामासुरगुरुः सुतां जानीहि तस्य माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003818, "chapter_id": 1074, "verse_number": "१-७५-१२", "content_sanskrit": "इयं च मे सखी दासी यत्राहं तत्र गामिनी।\nदुहिता दानवेन्द्रस्य शर्मिष्ठा वृषपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003819, "chapter_id": 1074, "verse_number": "१-७५-१३x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003820, "chapter_id": 1074, "verse_number": "१-७५-१३", "content_sanskrit": "कथं तु ते सखी दासी कन्येयं वरवर्णिनी।\nअसुरेन्द्रसुता सुभ्रूः परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003821, "chapter_id": 1074, "verse_number": "१-७५-१४", "content_sanskrit": "नैव देवी न गन्धर्वी न यक्षी न च किन्नरी।\nनैवंरूपा मया नारी दृष्टपूर्वा महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003822, "chapter_id": 1074, "verse_number": "१-७५-१५", "content_sanskrit": "श्रीरिवायतपद्माक्षी सर्वलक्षणशोभना।\nअसुरेन्द्रसुता कन्या सर्वालङ्कारभूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003823, "chapter_id": 1074, "verse_number": "१-७५-१६", "content_sanskrit": "दैवेनोपहता सुभ्रूरुताहो तपसापि वा।\nअन्यथैषाऽनवद्याङ्गी दासी नेह भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003824, "chapter_id": 1074, "verse_number": "१-७५-१७", "content_sanskrit": "अस्या रूपेण ते रूपं न किंचित्सदृशं भवेत्।\nपुरा दुश्चरितेनेयं तव दासी भवत्यहो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003825, "chapter_id": 1074, "verse_number": "१-७५-१८x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003826, "chapter_id": 1074, "verse_number": "१-७५-१८", "content_sanskrit": "सर्व एव नरश्रेष्ठ विधानमनुवर्तते।\nविधानविहितं मत्वा मा विचित्राः कथाःकृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003827, "chapter_id": 1074, "verse_number": "१-७५-१९", "content_sanskrit": "राजवद्रूपवेषौ ते ब्राह्मीं वाचं बिभर्षि च।\nको नाम त्वं कुतश्चासि कस्य पुत्रश्च शस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003828, "chapter_id": 1074, "verse_number": "१-७५-२०x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003829, "chapter_id": 1074, "verse_number": "१-७५-२०", "content_sanskrit": "ब्रहमचर्येण वेदो मे कृत्स्रः श्रुतिपथं गतः।\nराजाहं राजपुत्रश्च ययातिरिति विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003830, "chapter_id": 1074, "verse_number": "१-७५-२१x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003831, "chapter_id": 1074, "verse_number": "१-७५-२१", "content_sanskrit": "केनास्यर्थेन नृपते इमं देशमुपागतः।\nजिघृक्षुर्वारिजं किंचिदथवा मृगलिप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003832, "chapter_id": 1074, "verse_number": "१-७५-२२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003833, "chapter_id": 1074, "verse_number": "१-७५-२२", "content_sanskrit": "मृगलिप्सुरहं भद्रे पानीयार्थमुपागतः।\nबहुधाऽप्यनुयुक्तोऽस्मि तदनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003834, "chapter_id": 1074, "verse_number": "१-७५-२३x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003835, "chapter_id": 1074, "verse_number": "१-७५-२३", "content_sanskrit": "द्वाभ्यां कन्यासहस्राभ्यां दास्या शर्मिष्ठया सह।\nत्वदधीनाऽस्मि भद्रं ते सखा भर्ता च मे भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003836, "chapter_id": 1074, "verse_number": "१-७५-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003837, "chapter_id": 1074, "verse_number": "१-७५-२४", "content_sanskrit": "असुरेन्द्रसुतामीक्ष्य तस्यां सक्तेन चेतसा।\nशर्मिष्ठा महिषी मह्यमिति मत्वा वचोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003838, "chapter_id": 1074, "verse_number": "१-७५-२५x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003839, "chapter_id": 1074, "verse_number": "१-७५-२५", "content_sanskrit": "विद्ध्यौशनसि भद्रं ते न त्वामर्होऽस्मि भामिनि।\nअविवाह्या हि राजानो देवयानि पितुस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003840, "chapter_id": 1074, "verse_number": "१-७५-२६", "content_sanskrit": "परभार्या स्वसा श्रेष्ठा सगोत्रा पतिता स्नुषा।\nअवरा भिक्षुकाऽस्वस्था अगम्याः कीर्तिता बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003841, "chapter_id": 1074, "verse_number": "१-७५-२७x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003842, "chapter_id": 1074, "verse_number": "१-७५-२७", "content_sanskrit": "संसृष्टं ब्रह्मणा क्षत्रं क्षत्रेण ब्रह्म संहितम्।\nअन्यत्वमस्ति न तयोरेकान्ततरमास्थिते।\nऋषिश्चाप्यृषिपुत्रश्च नाहुषाङ्ग वहस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003843, "chapter_id": 1074, "verse_number": "१-७५-२८x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003844, "chapter_id": 1074, "verse_number": "१-७५-२८", "content_sanskrit": "एकदेहोद्भवा वर्णाश्चत्वारोऽपि वराङ्गने।\nपृथग्धर्माः पृथक्शौचास्तेषां तु ब्राह्मणो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003845, "chapter_id": 1074, "verse_number": "१-७५-२९x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003846, "chapter_id": 1074, "verse_number": "१-७५-२९", "content_sanskrit": "पाणि धर्मो नाहुषाऽयं न पुंभिः सेवितः पुरा।\nतं मे त्वमग्रहीरग्रे वृणोमि त्वामहं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003847, "chapter_id": 1074, "verse_number": "१-७५-३०", "content_sanskrit": "कथं नु मे मनस्विन्याः पाणिमन्यः पुमान्स्पृशेत्।\nगृहीतमृषिपुत्रेण स्वयं वाप्यृषिणा त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003848, "chapter_id": 1074, "verse_number": "१-७५-३१x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003849, "chapter_id": 1074, "verse_number": "१-७५-३१", "content_sanskrit": "क्रुद्धादाशीविषात्सर्पाज्ज्वलनात्सर्वतोमुखात्।\nदुराधर्षतरो विप्रो ज्ञेयः पुंसा विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003850, "chapter_id": 1074, "verse_number": "१-७५-३२x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003851, "chapter_id": 1074, "verse_number": "१-७५-३२", "content_sanskrit": "कथमाशीविषात्सर्पाज्ज्वलनात्सर्वतोमुखात्।\nदुराधर्षतरो विप्र इत्यात्थ पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003852, "chapter_id": 1074, "verse_number": "१-७५-३३x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003853, "chapter_id": 1074, "verse_number": "१-७५-३३", "content_sanskrit": "एकमाशीविषो हन्ति शस्त्रेणैकश्च वध्यते।\nहन्ति विप्रः सराष्ट्राणि पुराण्यपि हि कोपितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003854, "chapter_id": 1074, "verse_number": "१-७५-३४", "content_sanskrit": "दुराधर्षतरो विप्रस्तस्माद्भीरु मतो मम।\nअतोऽदत्तां च पित्रा त्वां भद्रे न विवहाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003855, "chapter_id": 1074, "verse_number": "१-७५-३५x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003856, "chapter_id": 1074, "verse_number": "१-७५-३५", "content_sanskrit": "दत्तां वहस्व तन्मा त्वं पित्रा राजन्वृतो मया।\nआयचतो भयं नास्ति दत्तां च प्रतिगृह्णतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003857, "chapter_id": 1074, "verse_number": "१-७५-३६", "content_sanskrit": "तिष्ठ राजन्मुहूर्तं च प्रेषयिष्याम्यहं पितुः।\nगच्छ त्वं धात्रिके शीघ्रं ब्रह्मकल्पमिहानय।\nस्वयंवरे वृतं शीघ्रं निवेदय च नाहुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003858, "chapter_id": 1074, "verse_number": "१-७५-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003859, "chapter_id": 1074, "verse_number": "१-७५-३७", "content_sanskrit": "त्वरितं देवयान्याथ संदिष्टं पितुरात्मनः।\nसर्वं निवेदयामास धात्री तस्मै यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003860, "chapter_id": 1074, "verse_number": "१-७५-३८", "content_sanskrit": "श्रुत्वैव च स राजानं दर्शयामास भार्गवः।\nदृष्ट्वैव चागतं शुक्रं ययातिः पृथिवीपतिः।\nववन्दे ब्राह्मणं काव्यं प्राञ्जलिः प्रणतः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003861, "chapter_id": 1074, "verse_number": "१-७५-३९x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003862, "chapter_id": 1074, "verse_number": "१-७५-३९", "content_sanskrit": "राजायं नाहुषस्तात दुर्गमे पाणिमग्रहीत्।\nनान्यपूर्वगृहीतं मे तेनाहमभया कृता।\nनमस्ते देहि मामस्मै लोके नान्यं पतिं वृणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003863, "chapter_id": 1074, "verse_number": "१-७५-४०x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003864, "chapter_id": 1074, "verse_number": "१-७५-४०", "content_sanskrit": "अन्यो धर्मः प्रियस्त्वन्यो वृतस्ते नाहुषः पतिः।\nकचशापात्त्वया पूर्वं नान्यद्भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2003865, "chapter_id": 1074, "verse_number": "१-७५-४१", "content_sanskrit": "वृतोऽनया पतिर्वीर सुतया त्वं ममेष्टया।\nस्वयं ग्रहे महान्दोषो ब्राह्मण्या वर्णसंकरात्।\nगृहाणेमां मया दत्तां महिषीं नहुषात्मज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2003866, "chapter_id": 1074, "verse_number": "१-७५-४२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2003867, "chapter_id": 1074, "verse_number": "१-७५-४२", "content_sanskrit": "अधर्मो न स्पृशेदेष महान्मामिह भार्गव।\nवर्णसंकरजो ब्रह्मन्निति त्वां प्रवृणोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2003868, "chapter_id": 1074, "verse_number": "१-७५-४३x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2003869, "chapter_id": 1074, "verse_number": "१-७५-४३", "content_sanskrit": "अधर्मात्त्वां विमुञ्चामि शृणु त्वं वरमीप्सितम्।\nअस्मिन्विवाहे मा म्लासीरहं पापं नुदामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2003870, "chapter_id": 1074, "verse_number": "१-७५-४४", "content_sanskrit": "वहस्व भार्यां धर्मेण देवयानीं सुमध्यमाम्।\nअनया सह संप्रीतिमतुलां समवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2003871, "chapter_id": 1074, "verse_number": "१-७५-४५", "content_sanskrit": "इयं चापि कुमारी ते शर्मिष्ठा वार्षपर्वणी।\nसंपूज्या सततं राजन्मा चैनां शयने ह्वयेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2003872, "chapter_id": 1074, "verse_number": "१-७५-४६", "content_sanskrit": "रहस्येनां समाहूय न वदेर्न च संस्पृशेः।\nवहस्व भार्यां भद्रं ते यथा काममवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2003873, "chapter_id": 1074, "verse_number": "१-७५-४७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2003874, "chapter_id": 1074, "verse_number": "१-७५-४७", "content_sanskrit": "एवमुक्तो ययातिस्तु शुक्रं कृत्वा प्रदक्षिणम्।\nशास्त्रोक्तविधिना राजा विवाहमकरोच्छुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2003875, "chapter_id": 1074, "verse_number": "१-७५-४८", "content_sanskrit": "लब्ध्वा शुक्रान्महद्वित्तं देवयानीं तदोत्तमाम्।\nद्विसहस्रेण कन्यानां तथा शर्मिष्ठया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2003876, "chapter_id": 1074, "verse_number": "१-७५-४९", "content_sanskrit": "संपूजितश्च शुक्रेण दैत्यैश्च नृपसत्तमः।\nजगाम स्वपुरं हृष्टोऽनुज्ञातोऽथ महात्मना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2003877, "chapter_id": 1074, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चसप्ततितमोऽध्यायः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]