[{"id": 7003682000, "chapter_id": 23682, "verse_number": "१-३-३-१", "content_sanskrit": "सनक उवाच ।\nभगवन्नरुणाद्रीश माहात्म्यमिदमद्भुतम् ।\nश्रुतं शिवप्रसादेन दयया ते जगद्गुरोः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003682001, "chapter_id": 23682, "verse_number": "१-३-३-२", "content_sanskrit": "आश्चर्यमेतन्माहात्म्यं सर्वपापविनाशनम् ।\nआराधयन्पुनः के वा वरदं शोणपर्वतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003682002, "chapter_id": 23682, "verse_number": "१-३-३-३", "content_sanskrit": "अनादिरंतरहितः शिवः शोणचलाकृतिः ।\nयुवयोस्तपसा देव वरदानाय संस्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003682003, "chapter_id": 23682, "verse_number": "१-३-३-४", "content_sanskrit": "सकृत्संकीर्तिते नाम्नि शोणाद्रिरिति मुक्तिदे ।\nसन्निधिः सर्वकामानां जायते चाघनाशनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003682004, "chapter_id": 23682, "verse_number": "१-३-३-५", "content_sanskrit": "शिवशब्दामृतास्वादः शिवार्चनकथाक्रमः ।\nइति तद्वचनं श्रुत्वा देवदेवः पितामहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003682005, "chapter_id": 23682, "verse_number": "१-३-३-६", "content_sanskrit": "उवाच करुणामूर्तिररुणाद्रीशमानमन् ।\nब्रह्मोवाच ।\nश्रूयतां वत्स पार्वत्याश्चरितं यत्पुरातनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003682006, "chapter_id": 23682, "verse_number": "१-३-३-७", "content_sanskrit": "अरुणाद्रीशमाश्रित्य यथा सा निर्वृताभवत् ।\nआससाद महादेवः कदाचित्पार्वतीपतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003682007, "chapter_id": 23682, "verse_number": "१-३-३-८", "content_sanskrit": "रत्नसिंहासनं दिव्यं रत्नतोरणसंयुतम् ।\nरत्नपुष्पफलोपेत कल्पद्रुममनोहरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003682008, "chapter_id": 23682, "verse_number": "१-३-३-९", "content_sanskrit": "परार्ध्य दृषदास्तीर्णं बद्धमुक्तावितानकम् ।\nविमुक्तपुष्पप्रकरदिव्यधूपोरुसौरभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003682009, "chapter_id": 23682, "verse_number": "१-३-३-१०", "content_sanskrit": "प्रलंबमालिकाजालनिनदद्भृंगसंकुलम् ।\nदिव्यतूर्यघनारावप्रनृत्यद्गुहवाहनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003682010, "chapter_id": 23682, "verse_number": "१-३-३-११", "content_sanskrit": "पार्वतीसिंहसंचारपरित्रस्तमहागजम् ।\nअप्सरोभिः प्रनर्त्ताभिर्गायंतीभिश्च केवलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003682011, "chapter_id": 23682, "verse_number": "१-३-३-१२", "content_sanskrit": "आसेवितपुरोरंगं दिक्पालकनिषेवितम् ।\nऋग्यजुःसामजैर्मंत्रैः स्तुवद्भिर्मुनिपुंगवैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003682012, "chapter_id": 23682, "verse_number": "१-३-३-१३", "content_sanskrit": "ब्रह्मर्षिभिस्तथा देवैः सिद्धै राजर्षिभिवृतम् ।\nगणैश्च विविधाकारैर्भस्मालंकृतविग्रहैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003682013, "chapter_id": 23682, "verse_number": "१-३-३-१४", "content_sanskrit": "रुद्राक्षधारसुभगैरापूर्णं शिवतत्परैः ।\nवीणावेणुमृदंगादितौर्यत्रिकजनिस्वनैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003682014, "chapter_id": 23682, "verse_number": "१-३-३-१५", "content_sanskrit": "घंटाटंकारसुभगैर्वेदध्वनिविमिश्रितैः ।\nमनोहरं महादिव्यमासनं पार्वतीसखः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003682015, "chapter_id": 23682, "verse_number": "१-३-३-१६", "content_sanskrit": "अलंचकार भगवन्भक्तानुग्रहकाम्यया ।\nआस्थाय विमलं रूपं सर्वतेजोमयं शिवम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003682016, "chapter_id": 23682, "verse_number": "१-३-३-१७", "content_sanskrit": "अंबिकासहितः श्रीमान्विजहार दयानिधिः ।\nसंगीतेन कथाभेदैर्द्यूतक्रीडाविकल्पनैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003682017, "chapter_id": 23682, "verse_number": "१-३-३-१८", "content_sanskrit": "गणानां विकटैर्नृत्यै रमयामास पार्वतीम् ।\nविसृज्य सकलान्देवानृषींश्चापि सभासदः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003682018, "chapter_id": 23682, "verse_number": "१-३-३-१९", "content_sanskrit": "वरान्प्रदाय विविधान्भक्तलोकाय वाञ्छितान् ।\nआगमेषु विचित्रेषु सर्वर्तुकुसुमेषु च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003682019, "chapter_id": 23682, "verse_number": "१-३-३-२०", "content_sanskrit": "विजहारोमया सार्द्धं रत्नप्रासादपंक्तिषु ।\nवापिकासु मनोज्ञासु रत्नसोपानपंक्तिषु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003682020, "chapter_id": 23682, "verse_number": "१-३-३-२१", "content_sanskrit": "केलिपर्वतशृंगेषु हेमरंभावनांतरे ।\nगंगातरंगशीतेन फुल्लपंकजगंधिना ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003682021, "chapter_id": 23682, "verse_number": "१-३-३-२२", "content_sanskrit": "वातेन मंदगतिना विहारविहतश्रमः ।\nस्वकामतः स्वयं देवः प्रेयसीमभ्यनन्दयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003682022, "chapter_id": 23682, "verse_number": "१-३-३-२३", "content_sanskrit": "रतिरूपां शिवां देवीं सर्वसौभाग्यसुन्दरीम् ।\nकदाचिद्रहसि प्रीता निजाज्ञावशवर्त्तिनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003682023, "chapter_id": 23682, "verse_number": "१-३-३-२४", "content_sanskrit": "रमणं जानती मुग्धा पश्चादभ्येत्य सादरम् ।\nकराभ्यां कमलाभाभ्यां त्रिणेत्राणि जगद्गुरोः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003682024, "chapter_id": 23682, "verse_number": "१-३-३-२५", "content_sanskrit": "पिदधे लीलया शंभोः किमेतदिति कौतुकात् ।\nचन्द्रादित्याग्निरूपेण पिहितेष्वक्षिषु क्रमात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003682025, "chapter_id": 23682, "verse_number": "१-३-३-२६", "content_sanskrit": "अन्धकारोऽभवत्तत्र चिरकालं भयंकरः ।\nनिमिषार्द्धेन देवस्य जग्मुर्वत्सरकोटयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003682026, "chapter_id": 23682, "verse_number": "१-३-३-२७", "content_sanskrit": "देवीलीलासमुत्थेन तमसाभूज्जगत्क्षयः ।\nतमसा पूरितं विश्वमपारेण समन्ततः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003682027, "chapter_id": 23682, "verse_number": "१-३-३-२८", "content_sanskrit": "शून्यं ज्योतिः प्रचारेण विनाशं प्रत्यपद्यत ।\nन व्यजृंभत विबुधा न च वेदाश्चकाशिरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003682028, "chapter_id": 23682, "verse_number": "१-३-३-२९", "content_sanskrit": "नापि जीवाः समभवन्नव्यक्तं केवलं स्थितम् ।\nजगतामपि सर्वेषामकाले वीक्ष्य संक्षयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003682029, "chapter_id": 23682, "verse_number": "१-३-३-३०", "content_sanskrit": "तपसा लब्धस्फूर्तीनां विचारः समपद्यत ।\nकिमेतत्तमसो जन्म भुवनक्षयकारणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003682030, "chapter_id": 23682, "verse_number": "१-३-३-३१", "content_sanskrit": "भगवानपि सर्वात्मा न नूनं कालमाक्षिपत् ।\nदेवी विनोदरूपेण पिधत्ते पुरजिद्दृशः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003682031, "chapter_id": 23682, "verse_number": "१-३-३-३२", "content_sanskrit": "तेनेदमखिलं जातं निस्तेजो भुवनत्रयम् ।\nअकालतमसा व्याप्ते सकले भुवनत्रये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003682032, "chapter_id": 23682, "verse_number": "१-३-३-३३", "content_sanskrit": "का गतिर्लब्धराज्यानां तपसो देवजन्मनाम् ।\nन यज्ञाः संप्रवर्तंते न पूज्यन्ते सुरा भुवि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003682033, "chapter_id": 23682, "verse_number": "१-३-३-३४", "content_sanskrit": "इति निश्चित्य मनसा वीक्ष्य ते ज्ञानचक्षुषा ।\nनित्यास्ते सूरयो भक्त्या शंभुमागम्य तुष्टुवुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003682034, "chapter_id": 23682, "verse_number": "१-३-३-३५", "content_sanskrit": "नमः सर्वजगत्कर्त्रे शिवाय परमात्मने ।\nमायया शक्तिरूपेण पृथग्भावमुपेयुषे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003682035, "chapter_id": 23682, "verse_number": "१-३-३-३६", "content_sanskrit": "अविनाभाविनी शक्तिराद्यैका शिवरूपिणी ।\nलीलया जगदुत्पत्तिरक्षासंहृतिकारिणी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003682036, "chapter_id": 23682, "verse_number": "१-३-३-३७", "content_sanskrit": "अर्धांगी सा तव देव शिवशक्त्यात्मकं वपुः ।\nएक एव महादेवो न परे त्वद्विना विभो ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003682037, "chapter_id": 23682, "verse_number": "१-३-३-३८", "content_sanskrit": "लीलया तव लोकोयमकाले प्रलयं गतः ।\nकरुणा तव निर्व्याजा वर्द्धतां लोकवर्द्धनी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003682038, "chapter_id": 23682, "verse_number": "१-३-३-३९", "content_sanskrit": "भवतो निमिषार्द्धेन तेजसामुपसंहृतेः ।\nगतान्यनेकवर्षाणि जगतां नाशहेतवे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003682039, "chapter_id": 23682, "verse_number": "१-३-३-४०", "content_sanskrit": "ततः प्रसीद करुणामूर्त्ते काल सदाशिव ।\nविरम प्रणयारब्धादमुष्माल्लोकसंक्षयात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003682040, "chapter_id": 23682, "verse_number": "१-३-३-४१", "content_sanskrit": "इति तेषां वचः श्रुत्वा भक्तानां सिद्धिशालिनाम् ।\nविसृजाक्षोणि गौरीति करुणामूर्त्तिरब्रवीत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003682041, "chapter_id": 23682, "verse_number": "१-३-३-४२", "content_sanskrit": "विससर्ज च सा देवी पिधानं हरचक्षुषाम् ।\nसोमसूर्याग्निरूपाणां प्रकाशमभवज्जगत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003682042, "chapter_id": 23682, "verse_number": "१-३-३-४३", "content_sanskrit": "कियान्कालो गतश्चेति पृष्टैः सिद्धैश्च वै नतैः ।\nउक्तं त्वन्निमिषार्द्धेन जग्मुर्वत्सरकोटयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003682043, "chapter_id": 23682, "verse_number": "१-३-३-४४", "content_sanskrit": "अथ देवः कृपामूर्त्तिरालोक्य विहसन्प्रियाम् ।\nअब्रवीत्परमोदारः परं धर्मार्थसंग्रहम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003682044, "chapter_id": 23682, "verse_number": "१-३-३-४५", "content_sanskrit": "अविचार्य कृतं मुग्धे भुवनक्षयकारणात् ।\nअयुक्तमिह पश्यामि जगन्मातुस्तवैव हि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003682045, "chapter_id": 23682, "verse_number": "१-३-३-४६", "content_sanskrit": "अहमप्यखिलांल्लोकान्संहरिष्यामि संक्षये ।\nप्राप्ते काले त्वया मौग्ध्यादकाले प्रलयं गताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003682046, "chapter_id": 23682, "verse_number": "१-३-३-४७", "content_sanskrit": "केयं वा त्वादृशी कुर्यादीदृशं सद्विगर्हितम् ।\nकर्म नर्मण्यपि सदा कृपामूर्तिर्न बाधते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003682047, "chapter_id": 23682, "verse_number": "१-३-३-४८", "content_sanskrit": "इति शम्भोर्वचः श्रुत्वा धर्मलोपभयाकुला ।\nकिं करिष्यामि तच्छांत्या इत्यपृच्छत्स्म तं प्रिया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003682048, "chapter_id": 23682, "verse_number": "१-३-३-४९", "content_sanskrit": "अथ देवः प्रसन्नात्मा व्याजहार दयानिधिः ।\nदेव्यास्तेनानुतापेन भक्त्या च तोषितः शिवः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003682049, "chapter_id": 23682, "verse_number": "१-३-३-५०", "content_sanskrit": "मन्मूर्तेस्तव केयं वा प्रायश्चित्तिरिहोच्यते ।\nअथापि धर्ममार्गोयं त्वयैव परिपाल्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003682050, "chapter_id": 23682, "verse_number": "१-३-३-५१", "content_sanskrit": "श्रुतिस्मृतिक्रियाकल्पा विद्याश्च विबुधादयः ।\nत्वद्रूपमेतदखिलं महदर्थोस्मि तन्मयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003682051, "chapter_id": 23682, "verse_number": "१-३-३-५२", "content_sanskrit": "मान्ययाभिन्नया देव्या भाव्यं लोकसिसृक्षया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003682052, "chapter_id": 23682, "verse_number": "१-३-३-५३", "content_sanskrit": "तस्माल्लोकानुरूपं ते प्रायश्चित्तं विधीयते ।\nषड्विधो गदितो धर्मः श्रुतिस्मृतिविचारतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003682053, "chapter_id": 23682, "verse_number": "१-३-३-५४", "content_sanskrit": "स्वामिना नानुपाल्येत यदि त्याज्योऽनुजीविभिः ।\nन त्वां विहाय शक्नोमि क्षणमप्यासितुं क्वचित् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003682054, "chapter_id": 23682, "verse_number": "१-३-३-५५", "content_sanskrit": "अहमेव तपः सर्वं करिष्याम्यात्मनि स्थितः ।\nपृध्वी च सकला भूयात्तपसा सफला तव ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003682055, "chapter_id": 23682, "verse_number": "१-३-३-५६", "content_sanskrit": "त्वत्पादपद्मसंस्पर्शात्त्वत्तपोदर्शनादपि ।\nनिरस्यंति स्वसान्निध्याद्दुष्टजातमुपद्रवम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003682056, "chapter_id": 23682, "verse_number": "१-३-३-५७", "content_sanskrit": "कर्मभूमेस्त्वमाधिक्यहेतवे पुण्यमाचर ।\nत्वत्तपश्चरणं लोके वीक्ष्य सर्वोपि संततम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003682057, "chapter_id": 23682, "verse_number": "१-३-३-५८", "content_sanskrit": "धर्मे दृढतरा बुद्धिं निबध्नीयान्न संशयः ।\nकृतार्थयिष्यति महीं दया ते धर्मपालनैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003682058, "chapter_id": 23682, "verse_number": "१-३-३-५९", "content_sanskrit": "त्वमेवैतत्सकलं प्रोक्ता वेदैर्देवि सनातनैः ।\nअस्ति कांचीपुरी ख्याता सर्वभूतिसमन्विता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003682059, "chapter_id": 23682, "verse_number": "१-३-३-६०", "content_sanskrit": "या दिवं देवसंपूर्णा प्रत्यक्षयति भूतले ।\nयत्र कृतं तपः किंचिदनंतफलमुच्यते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003682060, "chapter_id": 23682, "verse_number": "१-३-३-६१", "content_sanskrit": "देवाश्च मुनयः सर्वे वासं वांछंति संततम् ।\nतत्र कंपेति विख्याता महापातकनाशिनी ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003682061, "chapter_id": 23682, "verse_number": "१-३-३-६२", "content_sanskrit": "यत्र स्थितानां मर्त्यानां कम्पन्ते पापकोटयः ।\nतत्र चूतद्रुमश्चैको राजते नित्यपल्लवः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003682062, "chapter_id": 23682, "verse_number": "१-३-३-६३", "content_sanskrit": "संपूर्णशीतलच्छायः प्रसूनफलपल्लवैः ।\nतत्र जप्तं हुतं दत्तमनन्तफलदं भवेत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003682063, "chapter_id": 23682, "verse_number": "१-३-३-६४", "content_sanskrit": "गणाश्च विविधाकारा डाकिन्यो योगिनीगणाः ।\nपरितस्त्वां निषेवंतां विष्णुमुख्यास्तथा पराः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003682064, "chapter_id": 23682, "verse_number": "१-३-३-६५", "content_sanskrit": "अहं च निष्कलो भूत्वा तव मानसपंकजे ।\nसन्निधास्यामि मा भूस्त्वं देवि मद्विरहाकुला ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003682065, "chapter_id": 23682, "verse_number": "१-३-३-६६", "content_sanskrit": "इत्युक्ता देवदेवेन देवी कंपांतिकं ययौ ।\nतपः कर्तुं सखीयुक्ता विस्मयाक्रान्तलोचना ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003682066, "chapter_id": 23682, "verse_number": "१-३-३-६७", "content_sanskrit": "कंपां च विमलां सिन्धुं मुनिसमघनिषेविताम् ।\nआलोक्य कोमलदलमेकाम्रं दृष्टिवारणम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003682067, "chapter_id": 23682, "verse_number": "१-३-३-६८", "content_sanskrit": "फलपुष्पसमाकीर्णं कोकिलालापसंकुलम् ।\nप्रससाद पुनर्देवं सस्मार च महेश्वरम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003682068, "chapter_id": 23682, "verse_number": "१-३-३-६९", "content_sanskrit": "कामाग्निपरिवीतांगी तपःक्षामेव साऽभवत् ।\nअभ्यभाषत सा गौरी विजयां पार्श्ववर्त्तिनीम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003682069, "chapter_id": 23682, "verse_number": "१-३-३-७०", "content_sanskrit": "कामशोकपरीतांगी पुरारिविरहाकुला ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003682070, "chapter_id": 23682, "verse_number": "१-३-३-७१", "content_sanskrit": "इममघहरमागतानिशं स्वयमपि पूजयितुं तपोभिरीशम् ।\nअयमभिनवपल्लवप्रसूनः स्मरयति मां स्मरबन्धुरेकचूतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003682071, "chapter_id": 23682, "verse_number": "१-३-३-७२", "content_sanskrit": "कथमिव विरहः शिवस्य सह्यः क्षुभितधियात्र भृशं मनोभवेन ।\nतदपि च तरुणेंदुचूडपादस्मरणमहौषधमेकमेव दृष्टम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]