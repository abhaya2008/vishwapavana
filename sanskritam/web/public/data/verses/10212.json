[{"id": 6000212000, "chapter_id": 10212, "verse_number": null, "content_sanskrit": "अथ षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000212001, "chapter_id": 10212, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.001.m4a", "display_order": 2}, {"id": 6000212002, "chapter_id": 10212, "verse_number": "१०-१६-१", "content_sanskrit": "व्रजे विक्रीडतोरेवं गोपालच्छद्मरूपिणोः।\nग्रीष्मो नामर्तुरभवन्नातिप्रेयान् शरीरिणाम्॥ १०/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.002.m4a", "display_order": 3, "topics": [{"text": "ग्रीष्मर्तुवर्णनम्, श्रीरामकृष्णयोः लीला", "range": "१–१५"}]}, {"id": 6000212003, "chapter_id": 10212, "verse_number": "१०-१६-२", "content_sanskrit": "स च वृन्दावनगुणैर्वसन्त इव लक्षितः।\nयत्रास्ते भगवान् साक्षाद् रामेण सह केशवः॥ १०/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.003.m4a", "display_order": 4}, {"id": 6000212004, "chapter_id": 10212, "verse_number": "१०-१६-३", "content_sanskrit": "यत्र निर्झरनिर्ह्रादनिवृत्तस्वनझिल्लिकम्।\nशश्वत् तच्छीकरैर्जुष्टं द्रुमपिप्पलमण्डितम्॥ १०/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.004.m4a", "display_order": 5}, {"id": 6000212005, "chapter_id": 10212, "verse_number": "१०-१६-४", "content_sanskrit": "सरित्सरःप्रस्रवणोर्मिवायुना कह्लारकञ्जोत्पलरेणुहारिणा।\nन विद्यते यत्र वनौकसां दवो निदाघवह्न्यर्कभवोऽतिशाद्वले॥ १०/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.005.m4a", "display_order": 6}, {"id": 6000212006, "chapter_id": 10212, "verse_number": "१०-१६-५", "content_sanskrit": "अगाधतोयह्रदिनीतटेरुहैर्द्रवत्पुलिन्याः पुलिनैः समन्ततः।\nन यत्र चण्डांशुकरा विषोल्बणा भुवो रसं शाद्वलितं निगृह्णते॥ १०/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.006.m4a", "display_order": 7}, {"id": 6000212007, "chapter_id": 10212, "verse_number": "१०-१६-६", "content_sanskrit": "श्रीमद्वनं कुसुमितं नदच्चित्रमृगद्विजम्।\nगायन्मयूरभ्रमरं कूजत्कोकिलसारसम्॥ १०/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.007.m4a", "display_order": 8}, {"id": 6000212008, "chapter_id": 10212, "verse_number": "१०-१६-७", "content_sanskrit": "क्रीडिष्यमाणस्तत् कृष्णो भगवान् बलसंयुतः।\nवेणुं विरणयन् गोपैर्गोधनैः संवृतोऽविशत्॥ १०/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.008.m4a", "display_order": 9}, {"id": 6000212009, "chapter_id": 10212, "verse_number": "१०-१६-८", "content_sanskrit": "प्रवालबर्हस्तबकस्रग्धातुकृतभूषणाः।\nरामकृष्णादयो गोपा ननृतुर्युयुधुर्जगुः॥ १०/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.009.m4a", "display_order": 10}, {"id": 6000212010, "chapter_id": 10212, "verse_number": "१०-१६-९", "content_sanskrit": "कृष्णस्य नृत्यतः केचिज्जगुः केचिदवादयन्।\nवेणुं पाणितलैः शृङ्गैः प्रशशंसुरथापरे॥ १०/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.010.m4a", "display_order": 11}, {"id": 6000212011, "chapter_id": 10212, "verse_number": "१०-१६-१०", "content_sanskrit": "गोपजातिप्रतिच्छन्ना देवा गोपालरूपिणः।\nईडिरे कृष्णरामौ च नटा इव नटं नृप॥ १०/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.011.m4a", "display_order": 12}, {"id": 6000212012, "chapter_id": 10212, "verse_number": "१०-१६-११", "content_sanskrit": "भ्रामणैर्लङ्घनैः क्षेपैरास्फोटनविकर्षणैः।\nचिक्रीडतुर्नियुद्धेन काकपक्षधरावुभौ॥ १०/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.012.m4a", "display_order": 13}, {"id": 6000212013, "chapter_id": 10212, "verse_number": "१०-१६-१२", "content_sanskrit": "क्‍वचिन्नृत्यत्सु चान्येषु गायकौ वादकौ स्वयम्।\nशशंसतुर्महाराज साधु साध्विति वादिनौ॥ १०/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.013.m4a", "display_order": 14}, {"id": 6000212014, "chapter_id": 10212, "verse_number": "१०-१६-१३", "content_sanskrit": "क्‍वचिद् बिल्वैः क्‍वचित् कुम्भैः क्‍व चामलकमुष्टिभिः।\nअस्पृश्यनेत्रबन्धाद्यैः क्‍वचिन्मृगखगेहया॥ १०/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.014.m4a", "display_order": 15}, {"id": 6000212015, "chapter_id": 10212, "verse_number": "१०-१६-१४", "content_sanskrit": "क्‍वचिच्च दर्दुरप्लावैर्विविधैरुपहासकैः।\nक्‍वचित् तथाऽऽन्दोलिकया कर्हिचिन्नृपचेष्टया॥ १०/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.015.m4a", "display_order": 16}, {"id": 6000212016, "chapter_id": 10212, "verse_number": "१०-१६-१५", "content_sanskrit": "एवं तौ लोकसिद्धाभिः क्रीडाभिश्चेरतुर्वने।\nनद्यद्रिद्रोणिकुञ्जेषु पुलिनेषु सरस्सु च॥ १०/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.016.m4a", "display_order": 17}, {"id": 6000212017, "chapter_id": 10212, "verse_number": "१०-१६-१६", "content_sanskrit": "पशूंश्चारयतो गोपैस्तद्वने रामकृष्णयोः।\nगोपरूपी प्रलम्बोऽगादसुरस्तज्जिघांसया॥ १०/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.017.m4a", "display_order": 18, "topics": [{"text": "बलरामेण प्रलम्बासुरवधः", "range": "१६–२८"}]}, {"id": 6000212018, "chapter_id": 10212, "verse_number": "१०-१६-१७", "content_sanskrit": "तं विद्वानपि दाशार्हो भगवान् सर्वदर्शनः।\nअन्वमोदत तत्सख्यं वधं तस्य विचिन्तयन्॥ १०/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.018.m4a", "display_order": 19}, {"id": 6000212019, "chapter_id": 10212, "verse_number": "१०-१६-१८", "content_sanskrit": "तत्रोपाहूय गोपालान् कृष्णः प्राह विहारवित्।\nहे गोपा विहरिष्यामो द्वन्द्वीभूय यथायथम्॥ १०/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.019.m4a", "display_order": 20}, {"id": 6000212020, "chapter_id": 10212, "verse_number": "१०-१६-१९", "content_sanskrit": "तत्र चक्रुः परिवृढौ गोपा रामजनार्दनौ।\nकृष्णसङ्घट्टिनः केचिद् गोपा रामस्य चापरे॥ १०/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.020.m4a", "display_order": 21}, {"id": 6000212021, "chapter_id": 10212, "verse_number": "१०-१६-२०", "content_sanskrit": "आचेरुर्विविधाः क्रीडा वाह्यवाहकलक्षणाः।\nतत्रारोहन्ति जेतारो वहन्ति च पराजिताः॥ १०/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.021.m4a", "display_order": 22}, {"id": 6000212022, "chapter_id": 10212, "verse_number": "१०-१६-२१", "content_sanskrit": "वहन्तो वाह्यमानाश्च चारयन्तश्च गोधनम्।\nभाण्डीरकं नाम वटं जग्मुः कृष्णपुरोगमाः॥ १०/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.022.m4a", "display_order": 23}, {"id": 6000212023, "chapter_id": 10212, "verse_number": "१०-१६-२२", "content_sanskrit": "रामसङ्घट्टिनो ये तु श्रीदामवृषभादयः।\nक्रीडायां जयिनस्तांस्तानूहुः कृष्णादयो नृप॥ १०/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.023.m4a", "display_order": 24}, {"id": 6000212024, "chapter_id": 10212, "verse_number": "१०-१६-२३", "content_sanskrit": "उवाह कृष्णो भगवान् श्रीदामानं पराजितः।\nवृषभं भद्रसेनस्तु प्रलम्बो रोहिणीसुतम्॥ १०/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.024.m4a", "display_order": 25}, {"id": 6000212025, "chapter_id": 10212, "verse_number": "१०-१६-२४", "content_sanskrit": "अविषह्यं मन्यमानः कृष्णं दानवपुङ्गवः।\nवहन् द्रुततरं प्रागादवरोहणतः परम्॥ १०/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.025.m4a", "display_order": 26}, {"id": 6000212026, "chapter_id": 10212, "verse_number": "१०-१६-२५", "content_sanskrit": "तमुद्वहन् धरणिधरेन्द्रगौरवं महासुरो विगतरयो निजं वपुः।\nस आस्थितः पुरटपरिच्छदो बभौ तटिद्‍द्युमानुडुपतिवाडिवाम्बुदः॥ १०/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.026.m4a", "display_order": 27}, {"id": 6000212027, "chapter_id": 10212, "verse_number": "१०-१६-२६", "content_sanskrit": "निरीक्ष्य तद्वपुरम्बरेचरं प्रदीप्तदृग् भृकुटितटोग्रदंष्ट्रकम्।\nज्वलच्छिखं कटककिरीटकुण्डलत्विषाऽद्भुतं हलधर ईषदत्रसत्॥ १०/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.027.m4a", "display_order": 28}, {"id": 6000212028, "chapter_id": 10212, "verse_number": "१०-१६-२७", "content_sanskrit": "अथागतस्मृतिरभयो रिपुं बलो विहायसोर्ध्वं च हरन्तमात्मनः।\nरुषाऽहनच्छिरसि दृढेन मुष्टिना सुराधिपो गिरिमिव वज्ररंहसा॥ १०/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.028.m4a", "display_order": 29}, {"id": 6000212029, "chapter_id": 10212, "verse_number": "१०-१६-२८", "content_sanskrit": "स आहतः सपदि विशीर्णशीर्षको मुखाद् वमन् रुधिरमपस्मृतोऽसुरः।\nमहारवं व्यसुरपतत् समीरयन् गिरिर्यथा मघवत आयुधाहतः॥ १०/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.029.m4a", "display_order": 30}, {"id": 6000212030, "chapter_id": 10212, "verse_number": "१०-१६-२९", "content_sanskrit": "दृष्ट्वा प्रलम्बं निहतं बलेन बलशालिना।\nगोपाः सुविस्मिता आसन् साधु साध्विति राविणः॥ १०/१६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.030.m4a", "display_order": 31}, {"id": 6000212031, "chapter_id": 10212, "verse_number": "१०-१६-३०", "content_sanskrit": "आशिषोऽभिगृणन्तस्ते प्रशशंसुस्तदर्हणम्।\nप्रेत्यागतमिवालिङ्ग्य प्रेमविह्वलचेतसः॥ १०/१६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.031.m4a", "display_order": 32}, {"id": 6000212032, "chapter_id": 10212, "verse_number": "१०-१६-३१", "content_sanskrit": "पापे प्रलम्बे निहते देवाः परमनिर्वृताः।\nअभ्यवर्षन् बलं माल्यैः शशंसुः साधु साध्विति॥ १०/१६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_016/BhP_10.016.032.m4a", "display_order": 33}, {"id": 6000212033, "chapter_id": 10212, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे षोडशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]