[{"id": 2100808, "chapter_id": 3164, "verse_number": "१४-२०-१", "content_sanskrit": "ब्राह्मण उवाच।\nयः स्यादेकान्त आसीनस्तूष्णीं किञ्चिदचिन्तयन्।\nपूर्वंपूर्वं परित्यज्य स निरारम्भको भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100809, "chapter_id": 3164, "verse_number": "१४-२०-२", "content_sanskrit": "सर्वमित्रः सर्वसहः शमे रक्तो जितेन्द्रियः।\nव्यपेतभयमन्युश्च कामहा मुच्यते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100810, "chapter_id": 3164, "verse_number": "१४-२०-३", "content_sanskrit": "आत्मवत्सर्वभूतेषु यश्चरेन्नियतः शुचिः।\n`नित्यमेव यथान्यायं यश्चरेन्नियतेन्द्रियः।\nअमानी निरभीमानः सर्वतो मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100811, "chapter_id": 3164, "verse_number": "१४-२०-४", "content_sanskrit": "जीवितं मरणं चोभे सुखदुःखे तथैव च।\nलाभालाभे प्रियद्वेष्ये यः समः स च मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100812, "chapter_id": 3164, "verse_number": "१४-२०-५", "content_sanskrit": "न कस्यचित्स्पृहयते नावजानाति किचन।\nनिर्द्वन्द्वो वीतरागात्मा सर्वथा मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100813, "chapter_id": 3164, "verse_number": "१४-२०-६", "content_sanskrit": "अनमित्रश्च निर्बन्धुरनपत्यश्च यः क्वचित्।\nत्यक्तधर्मार्थकामश्च निराराङ्क्षी च मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100814, "chapter_id": 3164, "verse_number": "१४-२०-७", "content_sanskrit": "नैव धर्मी न चाधर्मी पूर्वोपचितहा च यः।\nक्षीणधातुः प्रशान्तात्मा निर्द्वंद्वः स विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100815, "chapter_id": 3164, "verse_number": "१४-२०-८", "content_sanskrit": "अकर्मा चाविकाङ्क्षश्च पश्येज्जगदशाश्वतम्।\nअस्वस्तमवशं नित्यं जन्ममृत्युजरायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100816, "chapter_id": 3164, "verse_number": "१४-२०-९", "content_sanskrit": "वैराग्यबुद्धिः सततं तावद्दोषव्यपेक्षकः।\nआत्मबन्धविनिर्मोक्षं स करोत्यचिरादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100817, "chapter_id": 3164, "verse_number": "१४-२०-१०", "content_sanskrit": "अगन्धमरसस्पर्शमशब्दमपरिग्रहम्।\nअरूपमनभिज्ञेयं दृष्ट्वाऽऽत्मानं विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100818, "chapter_id": 3164, "verse_number": "१४-२०-११", "content_sanskrit": "पञ्चभूतगुणैर्हीनममूर्तिमदलेपकम्।\nअगुणं गुणभोक्तारं यः पश्यति स मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100819, "chapter_id": 3164, "verse_number": "१४-२०-१२", "content_sanskrit": "विहाय सर्वसङ्कल्पान्बुद्ध्या शारीरमानसान्।\nशनैर्निर्वाणमाप्नोति निरिन्धन इवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100820, "chapter_id": 3164, "verse_number": "१४-२०-१३", "content_sanskrit": "सर्वसंस्कारनिर्मुक्तो निर्द्वन्द्वो निष्परिग्रहः।\nतपसा इन्द्रियग्रामं यश्चरेन्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100821, "chapter_id": 3164, "verse_number": "१४-२०-१४", "content_sanskrit": "विमुक्तः सर्वसंस्कारैस्ततो ब्रह्मि सनातनम्।\nपरमाप्नोति संशान्तमचलं नित्यमक्षरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100822, "chapter_id": 3164, "verse_number": "१४-२०-१५", "content_sanskrit": "अतः परं प्रवक्ष्यामि योगशास्त्रमनुत्तमम्।\nयज्ज्ञात्वा सिद्धमात्मानं लोके पश्यन्ति योगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100823, "chapter_id": 3164, "verse_number": "१४-२०-१६", "content_sanskrit": "तस्योपदेशं वक्ष्यामि यथावत्तन्निबोध मे।\nयैर्योगैर्भावयन्नित्यं पश्यत्यात्मानमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100824, "chapter_id": 3164, "verse_number": "१४-२०-१७", "content_sanskrit": "इन्द्रियाणि तु संहृत्य मन आत्मनि धारयेत्।\nतीव्रं तप्त्वा तपः पूर्वं मोक्षयोगं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100825, "chapter_id": 3164, "verse_number": "१४-२०-१८", "content_sanskrit": "तपस्वी नित्यसङ्कल्पो दम्भाहङ्कारवर्जितः।\nमनीषी मनसा विप्रः पश्यत्यात्मानमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100826, "chapter_id": 3164, "verse_number": "१४-२०-१९", "content_sanskrit": "स चेच्छक्रोत्ययं साधुर्योक्तुमात्मानमात्मनि।\nतत एकान्तशीलः स पश्यत्यात्मानमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100827, "chapter_id": 3164, "verse_number": "१४-२०-२०", "content_sanskrit": "संयतः सततं युक्त आत्मवान्विजितेन्द्रियः।\nयथा य आत्मनाऽऽत्मानं सम्प्रयुक्तः प्रपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100828, "chapter_id": 3164, "verse_number": "१४-२०-२१", "content_sanskrit": "यथाहि पुरुषः स्वप्ने दृष्ट्वा पश्यत्यसाविति।\nतथारूपमिवात्मानं साधुयुक्तः प्रपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100829, "chapter_id": 3164, "verse_number": "१४-२०-२२", "content_sanskrit": "इषीकां च यथा मुञ्जात्कश्चिन्निष्कृष्य दर्शयेत्।\nयोगी निष्कृष्य चात्मानं तथा पश्यति देहतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100830, "chapter_id": 3164, "verse_number": "१४-२०-२३", "content_sanskrit": "मुञ्जं शरीरमित्याहुरिषीकामात्मनि श्रिताम्।\nएतन्निदर्शनं प्रोक्तं योगविद्भिरनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100831, "chapter_id": 3164, "verse_number": "१४-२०-२४", "content_sanskrit": "यदा हि युक्तमात्मानं सम्यक् पश्यति देहभूत्।\nन तस्येहेश्वरः कश्चित्त्रैलोक्यस्यापि यः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100832, "chapter_id": 3164, "verse_number": "१४-२०-२५", "content_sanskrit": "अन्यान्याश्चैव तनवो यथेष्टं प्रतिपद्यते।\nविनिर्भिद्य जरां मृत्युं न शोचति न हृष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100833, "chapter_id": 3164, "verse_number": "१४-२०-२६", "content_sanskrit": "देवानामपि देवत्वं युक्तः कारयते वशी।\nब्रह्म चाव्ययमाप्नोति हित्वा देहमशाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100834, "chapter_id": 3164, "verse_number": "१४-२०-२७", "content_sanskrit": "विनश्यत्सु च लोकेषु न भयं तस्य जायते।\nक्लिश्यमानेषु भूतेषु न स क्लिश्यति केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100835, "chapter_id": 3164, "verse_number": "१४-२०-२८", "content_sanskrit": "दुःखशोकमलैर्घोरैः सङ्गस्नेहसमुद्भवैः।\nन विचाल्यति युक्तात्मा निस्पृहः शान्तमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100836, "chapter_id": 3164, "verse_number": "१४-२०-२९", "content_sanskrit": "नैनं शस्त्राणि विध्यन्ते न मृत्युश्चास्य विद्यते।\nनातः सुखतरं किञ्चिल्लोके क्वचन दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100837, "chapter_id": 3164, "verse_number": "१४-२०-३०", "content_sanskrit": "सम्यग्युक्त्वा स आत्मानमात्मन्येव प्रतिष्ठिते।\nविनिवृत्तजरादुःखः सुखं स्वपिति चापि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100838, "chapter_id": 3164, "verse_number": "१४-२०-३१", "content_sanskrit": "देहान्यथेष्टमभ्येति हित्वेमां मानुषीं तनुम्।\nनिर्वेदस्तु न कर्तव्यो भुञ्जानेन कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100839, "chapter_id": 3164, "verse_number": "१४-२०-३२", "content_sanskrit": "सम्यग्युक्तो यदात्मानमात्मन्येव प्रपश्यति।\nतदैव न स्पृहयते साक्षादपि शतक्रतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100840, "chapter_id": 3164, "verse_number": "१४-२०-३३", "content_sanskrit": "योगमेकान्तशीलस्तु यथा विन्दति तच्छृणु।\nदृष्टपूर्वां दिशं चिन्त्य यस्मिन्संनिवसेत्परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100841, "chapter_id": 3164, "verse_number": "१४-२०-३४", "content_sanskrit": "पुरस्याभ्यन्तरे तस्य मनः स्थाप्यं न बाह्यतः।\nपुरस्याभ्यन्तरे तिष्ठन्यस्मिन्नावसथे वसेत।\nतस्मिन्नावसथे धार्यं सबाद्याभ्यन्तरं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100842, "chapter_id": 3164, "verse_number": "१४-२०-३५", "content_sanskrit": "प्रचिन्त्यावसथे कृत्स्नं यस्मिन्काये स पश्यति।\nतस्मिन्काये मनश्चास्य न च किञ्चन बाह्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100843, "chapter_id": 3164, "verse_number": "१४-२०-३६", "content_sanskrit": "सन्नियम्येन्द्रियग्रामं निर्घोषं निर्जने वने।\nकायमभ्यन्तरं कृत्स्नमेकाग्रः परिचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100844, "chapter_id": 3164, "verse_number": "१४-२०-३७", "content_sanskrit": "इन्तांस्तालु च जिह्वां च गलं ग्रीवां तथैव च।\nहृदयं चिन्तयेच्चापि तथा हृदयबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100845, "chapter_id": 3164, "verse_number": "१४-२०-३८", "content_sanskrit": "इत्युक्तः स मया शिष्यो मेधावी मधुसूदन।\nपप्रच्छ पुनरेवेमं मोक्षधर्मं सुदुर्वचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100846, "chapter_id": 3164, "verse_number": "१४-२०-३९", "content_sanskrit": "भुक्तं भुक्तमिदं कोष्ठे कथमन्नं विपच्यते।\nकथं रसत्वं व्रजति शोणितत्वं कथं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100847, "chapter_id": 3164, "verse_number": "१४-२०-४०", "content_sanskrit": "तथा मांसं च मेदश्च स्नाय्वस्थीनि च पोषयेत्।\nकथमेतानि सर्वाणि शरीराणि शरीरिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100848, "chapter_id": 3164, "verse_number": "१४-२०-४१", "content_sanskrit": "वर्धन्ते वर्धमानस्य वर्धते च कथं बलम्।\nनिरासनं निष्कसनं मलानां च पृथक् पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100849, "chapter_id": 3164, "verse_number": "१४-२०-४२", "content_sanskrit": "कुतो वाऽयं प्रश्वसिति उच्छ्वसित्यपि वा पुनः।\nकं च देशमधिष्ठाय तिष्ठत्यात्माऽयमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100850, "chapter_id": 3164, "verse_number": "१४-२०-४३", "content_sanskrit": "जीवः कथं वहति च चेष्टमानः कलेवरम्।\nकिंवर्णं कीदृशं चैव निवेशयति वै मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100851, "chapter_id": 3164, "verse_number": "१४-२०-४४", "content_sanskrit": "याथातथ्येन भगवन्वक्तुमर्हसि मेऽनघ।\nइति सम्परिपृष्टोऽहं तेन विप्रेणि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100852, "chapter_id": 3164, "verse_number": "१४-२०-४५", "content_sanskrit": "प्रत्यब्रवं महाबाहो यथाश्रुतमरिंदम।\nयथा स्वकोष्ठे प्रक्षिप्य भाण्डं भाण्डमना भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2100853, "chapter_id": 3164, "verse_number": "१४-२०-४६", "content_sanskrit": "तथा स्वकाये प्रक्षिप्य मनोद्वारैरनिश्चलैः।\nआत्मानं तत्र मार्गेत प्रमादं परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2100854, "chapter_id": 3164, "verse_number": "१४-२०-४७", "content_sanskrit": "एवं सततमुद्युक्तः प्रीतात्मा नचिरादिव।\nआसादयति तद्ब्रह्म यद्दृष्ट्वा स्यात्प्रधानवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2100855, "chapter_id": 3164, "verse_number": "१४-२०-४८", "content_sanskrit": "न त्वसौ चक्षुषा ग्राह्यो न च सर्वैरपीन्द्रियैः।\nमनसैव प्रदीपेन महानात्मा प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2100856, "chapter_id": 3164, "verse_number": "१४-२०-४९", "content_sanskrit": "सर्वतः पाणिपादान्तः सर्वतोक्षिशिरोमुखः।\nसर्वतः श्रुतिमाँल्लोके सर्वमावृत्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2100857, "chapter_id": 3164, "verse_number": "१४-२०-५०", "content_sanskrit": "जीवो निष्क्रान्तमात्मानं शरीरात्सम्प्रपश्यति।\nस तमुत्सृज्य देहं स्वं पारयेद्ब्रह्म केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2100858, "chapter_id": 3164, "verse_number": "१४-२०-५१", "content_sanskrit": "आत्मानमालोकयति मनसा प्रहसन्निव।\nतदेवमाश्रयं कृत्वा मोक्षं याति ततो मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2100859, "chapter_id": 3164, "verse_number": "१४-२०-५२", "content_sanskrit": "इदं सर्वरहस्यं ते मया प्रोक्तं द्विजोत्तम।\nआपृच्छे साधयिष्यामि गच्छ विप्र यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2100860, "chapter_id": 3164, "verse_number": "१४-२०-५३", "content_sanskrit": "इत्युक्तः स तदा कृष्ण मया शिष्यो महातपाः।\nअगच्छत यथाकामं ब्राह्मणश्छिन्नसंशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2100861, "chapter_id": 3164, "verse_number": "१४-२०-५४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2100862, "chapter_id": 3164, "verse_number": "१४-२०-५४", "content_sanskrit": "इत्युक्त्वा स तदा वाक्यं मां पार्थ द्विजसत्तमः।\nमोक्षधर्माश्रितं सम्यक् तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2100863, "chapter_id": 3164, "verse_number": "१४-२०-५५", "content_sanskrit": "कच्चिदेतत्त्वया पार्थ श्रुत्मेकाग्रचेतसा।\nतदापि हि रथस्थस्त्वं श्रुतवानेतदेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2100864, "chapter_id": 3164, "verse_number": "१४-२०-५६", "content_sanskrit": "नैतत्पार्थ सुविज्ञेयं व्यामिश्रेणेति मे मतिः।\nनरेणाकृतसङ्गेन विशुद्धेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2100865, "chapter_id": 3164, "verse_number": "१४-२०-५७", "content_sanskrit": "सुरहस्यमिदं प्रोक्तं देवानां भरतर्षभ।\nकच्चित्त्विदं श्रुतं पार्थ मनुष्येणेह कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2100866, "chapter_id": 3164, "verse_number": "१४-२०-५८", "content_sanskrit": "न ह्येतच्छ्रोतुमर्होऽन्यो मनुष्यस्त्वामृतेऽनघ।\nनैतदन्येनि विज्ञेयं व्यामिश्रेणान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2100867, "chapter_id": 3164, "verse_number": "१४-२०-५९", "content_sanskrit": "क्रियावद्भिर्हि कौन्तेय देवलोकः समावृतः।\nन चैतदिष्टं देवानां मर्त्यैरुपरि वर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2100868, "chapter_id": 3164, "verse_number": "१४-२०-६०", "content_sanskrit": "परा हि सा गतिः पार्थ यत्तद्ब्रह्म सनातनम्।\nयत्रामृतत्वं प्राप्नोति त्यक्त्वा दुःखं सदा सुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2100869, "chapter_id": 3164, "verse_number": "१४-२०-६१", "content_sanskrit": "इमं धर्मं समास्थाय येऽपि स्युः पापयोनयः।\nस्त्रियो वैश्यास्तथा शूद्रास्तेऽपि यान्ति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2100870, "chapter_id": 3164, "verse_number": "१४-२०-६२", "content_sanskrit": "किं पुनर्ब्रह्मणाः पार्थ क्षत्रिया वा बहुश्रुताः।\nस्वधर्मरतयो नित्यं ब्रह्मलोकपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2100871, "chapter_id": 3164, "verse_number": "१४-२०-६३", "content_sanskrit": "हेतुमच्चैतदुद्दिष्टमुपायाश्चास्य साधने।\nसिद्धिं फलं च मोक्षश्च दुःखस्य च विनिर्णियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2100872, "chapter_id": 3164, "verse_number": "१४-२०-६४", "content_sanskrit": "नातः परं सुखं त्वन्यत्किंचित्स्याद्भरतर्षभ।\nश्रुतवाञ्श्रद्दधानश्च पराक्रान्तश्च पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2100873, "chapter_id": 3164, "verse_number": "१४-२०-६५", "content_sanskrit": "यः परित्यज्यते मर्त्यो लोकसारमसरवत्।\nएतैरुपायैः स क्षिप्रं परां गतिमवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2100874, "chapter_id": 3164, "verse_number": "१४-२०-६६", "content_sanskrit": "एतावदेव वक्तव्यं नान्तो भूयोस्ति किञ्चन।\nषण्मासान्नित्ययुक्तस्य योगः पार्थ प्रवर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2100875, "chapter_id": 3164, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि विंशोऽध्यायः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]