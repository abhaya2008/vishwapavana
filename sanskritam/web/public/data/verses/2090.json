[{"id": 2049657, "chapter_id": 2090, "verse_number": "७-१७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049658, "chapter_id": 2090, "verse_number": "७-१७-१", "content_sanskrit": "ते सेने शिबिरं गत्वा न्यविशेतां विशाम्पते।\nयथाभागं यथान्यायं यथागुल्मं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049659, "chapter_id": 2090, "verse_number": "७-१७-२", "content_sanskrit": "कृत्वाऽवहारं सैन्यानां द्रोणः परमदुर्मनाः।\nदुर्योधनमभिप्रेक्ष्य सव्रीडमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049660, "chapter_id": 2090, "verse_number": "७-१७-३", "content_sanskrit": "उक्तमेतन्मया पूर्वं न तिष्ठति धन्जये।\nशक्यो ग्रहीतुं सङ्ग्रामे देवैरपि युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049661, "chapter_id": 2090, "verse_number": "७-१७-४", "content_sanskrit": "इति तद्वः प्रयततां कृतं पार्थेन संयुगे।\nमा विशङ्कीर्वचो मह्यमजेयौ कृष्णपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049662, "chapter_id": 2090, "verse_number": "७-१७-५", "content_sanskrit": "अपनीते तु योगेन केनचिच्छ्वेतवाहने।\nतत एष्यति ते राजन्वशमेष युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049663, "chapter_id": 2090, "verse_number": "७-१७-६", "content_sanskrit": "कश्चिदाहूय तं सङ्ख्ये देशमन्यं प्रकर्षतु।\nतमजित्वा न कौन्तेयो निवर्तेत कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049664, "chapter_id": 2090, "verse_number": "७-१७-७", "content_sanskrit": "एतस्मिन्नन्तरे शून्येधर्मराजमहं नृप।\nग्रहीष्यामि चमूं भित्त्वा धृष्टद्युम्नस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049665, "chapter_id": 2090, "verse_number": "७-१७-८", "content_sanskrit": "अर्जुनेन परित्यक्तो न चेत्त्रासात्पलायते।\nमामुपायान्तमालोक्य गृहीतं विद्धि पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049666, "chapter_id": 2090, "verse_number": "७-१७-९", "content_sanskrit": "एवं तेऽहं महाराज धर्मपुत्रं युधिष्ठिरम्।\nसमानेष्यामि सगणं वशमद्य न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049667, "chapter_id": 2090, "verse_number": "७-१७-१०", "content_sanskrit": "यदि तिष्ठति सङ्ग्रामे मुहूर्तमपि पाण्डवः।\nअथापयाति सङ्ग्रामाद्विजयात्तद्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049668, "chapter_id": 2090, "verse_number": "७-१७-११x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049669, "chapter_id": 2090, "verse_number": "७-१७-११", "content_sanskrit": "द्रोणस्य तद्वचः श्रुत्वा त्रिगर्ताधिपतिस्तदा।\nभ्रातृभिः सहितो राजन्निदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049670, "chapter_id": 2090, "verse_number": "७-१७-१२", "content_sanskrit": "वयं विनिकृता राजन्सदा गाण्डीवधन्वना।\nअनागःस्वपि चागस्तत्कृतमस्मासु तेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049671, "chapter_id": 2090, "verse_number": "७-१७-१३", "content_sanskrit": "ते वयं स्मरमाणास्तान्विनिकारान्पृथग्विधान्।\nक्रोधाग्निना दह्यमाना ह्यशेमहि सदा निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049672, "chapter_id": 2090, "verse_number": "७-१७-१४", "content_sanskrit": "स नो दिष्ट्याऽस्त्रसम्पन्नश्चक्षुर्विषयमागतः।\nकर्तारः स्मरयं कर्म यच्चिकीर्षाम हृद्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049673, "chapter_id": 2090, "verse_number": "७-१७-१५", "content_sanskrit": "भवतश्च प्रियं यत्स्यादस्माकं च यशस्करम्।\nवयमेनं हनिष्यामो निकृष्यायोधनाद्बहिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049674, "chapter_id": 2090, "verse_number": "७-१७-१६", "content_sanskrit": "अद्यास्त्वनर्जुना भूमिरत्रिगर्ताऽवा पुनः।\nसत्यं ते प्रतिजानीमो नैतन्मिथ्या भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049675, "chapter_id": 2090, "verse_number": "७-१७-१७", "content_sanskrit": "एवं सत्यरथश्चोक्त्वा सत्यवर्मा च भारत।\nसत्यव्रतश्च सत्येषुः सत्यकर्मा तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049676, "chapter_id": 2090, "verse_number": "७-१७-१८", "content_sanskrit": "सहिता भ्रातरः पञ्च रथानामयुतेन च।\nन्यवर्तन्त महाराज कृत्वा शपथमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049677, "chapter_id": 2090, "verse_number": "७-१७-१९", "content_sanskrit": "मालवास्तुण्डिकेराश्च रथानामयुतैस्त्रिभिः।\nसुशर्मा च नरव्याघ्रस्त्रिगर्तः प्रस्थलाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049678, "chapter_id": 2090, "verse_number": "७-१७-२०", "content_sanskrit": "मावेल्लकैर्ललित्थैश्च सहितो मद्रकैरपि।\nरथानामयुतेनैव सोऽगमद्धातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049679, "chapter_id": 2090, "verse_number": "७-१७-२१", "content_sanskrit": "नानाजनपदेभ्यश्च रथानामयुतं पुनः।\nसमुत्थितं विशिष्टानां शपथार्थमुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049680, "chapter_id": 2090, "verse_number": "७-१७-२२", "content_sanskrit": "ततो ज्वलनमानर्च्य हुत्वा सर्वे पृथक्पृथक्।\nजगृहुः कुशचीराणि चित्राणि कवचानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049681, "chapter_id": 2090, "verse_number": "७-१७-२३", "content_sanskrit": "ते च बद्धतनुत्राणा घृताक्ताः कुशचीरिणः।\nमौर्वीमेखलिनो वीराः सहस्रशतदक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049682, "chapter_id": 2090, "verse_number": "७-१७-२४", "content_sanskrit": "यज्वानः पुत्रिणो लोक्याः कृतकृत्यास्तनुत्यजः।\nयोक्ष्यमाणास्तदाऽऽत्मानं यशसा विजयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049683, "chapter_id": 2090, "verse_number": "७-१७-२५", "content_sanskrit": "ब्रह्मचर्युश्रुतिमुखैः क्रतुभिश्चाप्तदक्षिणैः।\nप्राप्याँल्लोकान्सुयुद्धेन क्षिप्रमेव यियासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049684, "chapter_id": 2090, "verse_number": "७-१७-२६", "content_sanskrit": "ब्राह्ममांस्तर्पयित्वा च निष्कान्दत्वा पृथक्पृथक्।\nगाश्च वासांसि च पुनः समाभाष्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049685, "chapter_id": 2090, "verse_number": "७-१७-२७", "content_sanskrit": "`द्विजमुख्यैः समुदितैः कृतस्वस्त्ययनाशिषः।\nमुदिताश्च प्रहृष्टाश्च जलं संस्पृश्य निर्मलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049686, "chapter_id": 2090, "verse_number": "७-१७-२८", "content_sanskrit": "प्रज्वाल्य कृष्णवर्त्मानमुपागम्य रणव्रतम्।\nतस्मिन्नग्नौ तदा चक्रुः प्रतिज्ञां दृढनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049687, "chapter_id": 2090, "verse_number": "७-१७-२९", "content_sanskrit": "शृण्वतां सर्वभूतानामुच्चैर्वाचो बभाषिरे।\nसर्वे धनञ्जयवधे प्रतिज्ञां चापि चक्रिरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049688, "chapter_id": 2090, "verse_number": "७-१७-३०", "content_sanskrit": "ये वै लोकाश्चाव्रतिनां ये चैव ब्रह्मघातिनाम्।\nमद्यपस्य च ये लोका गुरुदाररतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049689, "chapter_id": 2090, "verse_number": "७-१७-३१", "content_sanskrit": "ब्रह्मस्वहारिणश्चैव राजपिण्डापहारिणः।\nशरणागतं च त्यजतो याचमानं तथा घ्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049690, "chapter_id": 2090, "verse_number": "७-१७-३२", "content_sanskrit": "अगारदाहिनां चैव ये च गां निघ्नतामपि।\nअपकारिणां च ये लोका ये च ब्रह्मद्विषामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049691, "chapter_id": 2090, "verse_number": "७-१७-३३", "content_sanskrit": "स्वभार्यामृतुकालेषु मोहाद्वै नाभिगच्छताम्।\nश्राद्धमैथुनिकानां च ये चाप्यात्मापहारिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049692, "chapter_id": 2090, "verse_number": "७-१७-३४", "content_sanskrit": "न्यासापहारिणां ये च श्रुतं नाशयतां च ये।\nक्लीबने युध्यमानानां ये च नीचानुसारिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049693, "chapter_id": 2090, "verse_number": "७-१७-३५", "content_sanskrit": "नास्तिकानां च ये लोका येऽग्निमातृपितृत्यजाम्।\nतानाप्नुयामहे लोकान्ये च पापकृतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049694, "chapter_id": 2090, "verse_number": "७-१७-३६", "content_sanskrit": "यद्यहत्वा वयं युद्धे निवर्तेम धनञ्जयम्।\nतेन चाभ्यर्दितास्त्रासाद्भवेमहि पराङ्मुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049695, "chapter_id": 2090, "verse_number": "७-१७-३७", "content_sanskrit": "यदि त्वसुकरं लोके कर्म कुर्याम संयुगे।\nइष्टाँल्लोकान्प्राप्नुयामो वयमद्य न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049696, "chapter_id": 2090, "verse_number": "७-१७-३८", "content_sanskrit": "एवमुक्त्वा तदा राजंस्तेऽभ्यवर्तन्त संयुगे।\nआह्वयन्तोऽर्जुनं वीराः पितृजुष्टां दिशं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049697, "chapter_id": 2090, "verse_number": "७-१७-३९", "content_sanskrit": "आहूतस्तैर्नरव्याघ्रैः पार्थः परपुरञ्चयः।\nधर्मराजमिदं वाक्यमपदान्तरमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049698, "chapter_id": 2090, "verse_number": "७-१७-४०", "content_sanskrit": "आहूतो न निवर्तेयमिति मे व्रतमाहितम्।\nसंशप्तकाश्च मां राजन्नाह्वयन्ति महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049699, "chapter_id": 2090, "verse_number": "७-१७-४१", "content_sanskrit": "एष च भ्रातृभिः सार्धं सुशर्माऽऽह्वयते रणे।\nवधाय सगणस्यास्य मामनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049700, "chapter_id": 2090, "verse_number": "७-१७-४२", "content_sanskrit": "नैतच्छक्नोमि संसोढुमाह्वानं पुरुषर्षभ।\nसत्यं ते प्रतिजानामि हतान्विद्धि परान्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049701, "chapter_id": 2090, "verse_number": "७-१७-४२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049702, "chapter_id": 2090, "verse_number": "७-१७-४३", "content_sanskrit": "श्रुतं ते तत्त्वतस्तात यद्द्रोणस्य चिकीर्षितम्।\nयथा तदनृतं तस्य भवेतत्त्वं समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049703, "chapter_id": 2090, "verse_number": "७-१७-४४", "content_sanskrit": "द्रोणो हि बलवाञ्शूरः कृतास्त्रश्च जितश्रमः।\nप्रतिज्ञातं च तेनैतद्ग्रहणं मे महारथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049704, "chapter_id": 2090, "verse_number": "७-१७-४५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049705, "chapter_id": 2090, "verse_number": "७-१७-४५", "content_sanskrit": "अयं वै सत्यजिद्राजन्नद्य त्वां रक्षिता युधि।\nध्रियमाणे च पाञ्चाल्ये नाचार्यः काममाप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049706, "chapter_id": 2090, "verse_number": "७-१७-४६", "content_sanskrit": "हते तु पुरुषव्याघ्रे रणे सत्यजिति प्रभो।\nसर्वैरपि समेतैर्वा न स्थातव्यं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049707, "chapter_id": 2090, "verse_number": "७-१७-४७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049708, "chapter_id": 2090, "verse_number": "७-१७-४७", "content_sanskrit": "अनुज्ञातस्ततो राज्ञा परिष्वक्तश्च फल्गुनः।\nप्रेम्णा दृष्टश्च बहुधा ह्याशिषश्चास्य योजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049709, "chapter_id": 2090, "verse_number": "७-१७-४८", "content_sanskrit": "विहायैनं ततः पार्थस्त्रिगर्तान्प्रत्ययाद्बली।\nक्षुधितः क्षुद्विघातार्थं सिंहो मृगगणानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2049710, "chapter_id": 2090, "verse_number": "७-१७-४९", "content_sanskrit": "ततो दौर्योधनं सैन्यं मुदा परमया युतम्।\nऋतेऽर्जुनं भृशं क्रुद्धं धर्मराजस्य निग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2049711, "chapter_id": 2090, "verse_number": "७-१७-५०", "content_sanskrit": "ततोऽन्योन्येन ते सैन्ये समाजग्मतुरोजसा।\nगङ्गासरय्वौ वेगेन प्रावृषीवोल्बणोदके॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2049712, "chapter_id": 2090, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि सप्तदशोऽध्यायः॥ १७ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१७-५ योगेन उपायेन॥ ५-१७-२४ लोक्याः पुण्यलोकार्हाः॥ ५-१७-२५ ब्रह्मचर्यं वेदव्रताचरणम्। श्रुतिर्वेदाध्ययनं ते एव मुखं प्रधानं येषु तैः। कर्मभिरिति शेषः॥ ५-१७-३३ आत्मापहारिणां स्वजातिगोपकानाम्॥ ५-१७-३४ श्रुतं प्रतिज्ञातम्॥ ५-१७-३९ अपदान्तरमव्यवहितम्॥ ५-१७-१७ सप्तदशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]