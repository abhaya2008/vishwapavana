[{"id": 2031447, "chapter_id": 1684, "verse_number": "४-७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031448, "chapter_id": 1684, "verse_number": "४-७-१", "content_sanskrit": "स राजधानीं संप्राप्य पार्थिवोऽर्जुनमब्रवीत्।\nइमानि पुरुषव्याघ्र आयुधानि परंतप।\nकस्मिन्न्यासयितव्यानि गुप्तिश्चैषां कथं भवेत् ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031449, "chapter_id": 1684, "verse_number": "४-७-२", "content_sanskrit": "सायुधा हि वयं तात प्रवेक्ष्यामः पुरं यदि।\nसमुद्वेगं जनस्यास्य करिष्यामो न संशयः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031450, "chapter_id": 1684, "verse_number": "४-७-३", "content_sanskrit": "गाण्डीवं हि नरव्याघ्र त्रिषु लोकेषु विश्रुतम्।\nकथं नाविष्कृताः स्यामो धार्तराष्ट्रस्य मारिष ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031451, "chapter_id": 1684, "verse_number": "४-७-४", "content_sanskrit": "यदीद.. धनुरादाय चरेम सजने पुरे।\nक्षिप्र नः प्रतिजानीयुर्मनुष्या नात्र संशयः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031452, "chapter_id": 1684, "verse_number": "४-७-५", "content_sanskrit": "एकस्मिन्नपि विज्ञाते समयं नो व्यतीत्य च ।\nभूयो द्वादशवर्षाणि प्रविशेम वनं वयम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031453, "chapter_id": 1684, "verse_number": "४-७-६", "content_sanskrit": "तस्मात्सर्वाणि शस्त्राणि प्रच्छाद्यान्यत्र यत्र वा ।\nप्रविशेम पुरश्रेष्ठं तथा सम्यक्कृतं भवेत् ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031454, "chapter_id": 1684, "verse_number": "४-७-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031455, "chapter_id": 1684, "verse_number": "४-७-७", "content_sanskrit": "अजातशत्रोर्वचनं श्रुत्वा चैव महायशाः।\nउवाच धर्मपुत्रं तमर्जुनः परवीरहा ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031456, "chapter_id": 1684, "verse_number": "४-७-८", "content_sanskrit": "इयं वने मनुष्येन्द्र महती दृश्यते शमी।\nभीमशाखा दुरारोहा श्मशानस्य समीपतः ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031457, "chapter_id": 1684, "verse_number": "४-७-९", "content_sanskrit": "उत्पथे चापि जातेयं मनुष्यैर्न निषेव्यते ।\nविपुलाऽऽकीर्णशाखा च वायसैरुपसेविता ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031458, "chapter_id": 1684, "verse_number": "४-७-१०", "content_sanskrit": "स्नेहानुबद्धां पश्यामि दुरारोहामिमां शमीम् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031459, "chapter_id": 1684, "verse_number": "४-७-११", "content_sanskrit": "समीपे च श्मशानस्य गृहं नास्य विशेषतः।\nसमासज्यायुधान्यस्यां गच्छामो नगरं नृप ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031460, "chapter_id": 1684, "verse_number": "४-७-१२", "content_sanskrit": "न चास्यां चारयिष्यन्ति मनुष्याः पार्थ केचन ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031461, "chapter_id": 1684, "verse_number": "४-७-१३", "content_sanskrit": "धनुर्भिः पुरुषं कृत्वा चर्मकेशास्थिसंवृतम्।\nउद्बन्धमिव कृत्वा च धनुर्ज्यापाशसंवृतम् ।\nअस्यामायुधमासज्य गच्छाम नगरं वयम् ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031462, "chapter_id": 1684, "verse_number": "४-७-१४", "content_sanskrit": "एवं परिहरिष्यन्ति मनुष्या वनचारिणः ।\nअत्रैवं नावबुध्यन्ते मनुष्याः केचिदायुधम् ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031463, "chapter_id": 1684, "verse_number": "४-७-१५x", "content_sanskrit": "वैशम्पायन उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031464, "chapter_id": 1684, "verse_number": "४-७-१५", "content_sanskrit": "एवमुक्त्वा स राजानं धर्मात्मानं धनञ्जयः।\nप्रचक्रमे निधानाय शश्त्राणां भरतर्षभ ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031465, "chapter_id": 1684, "verse_number": "४-७-१६", "content_sanskrit": "तानि सर्वाणि संनह्य पञ्च पञ्चाचलोपमाः ।\nआयुधानि कलापांश्च निस्त्रिंशानतुलप्रभान् ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031466, "chapter_id": 1684, "verse_number": "४-७-१७", "content_sanskrit": "ततो युधिष्ठिरो राजा सहदेवमुवाच ह।\nआरुह्येमां शमीं वीर निधत्स्वेहायुधानि नः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031467, "chapter_id": 1684, "verse_number": "४-७-१८", "content_sanskrit": "इति संदिश्य तं पार्थः पुनरेव धनञ्जयम् ।\nअब्रवीदायुधानीह निधातुं भरतर्षभः ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031468, "chapter_id": 1684, "verse_number": "४-७-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031469, "chapter_id": 1684, "verse_number": "४-७-१९", "content_sanskrit": "येन देवान्मनुष्यांश्च पिशाचोरगराक्षसान् ।\nनिवातकवचांश्चापि पौलोमांश्च परंतपः ।\nकालकेयांश्च दुर्धाषान्सर्वांश्चैकरथोऽजयत् ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031470, "chapter_id": 1684, "verse_number": "४-७-२०", "content_sanskrit": "स्फीताञ्जनपदांश्चान्यानजयत्कुरुनन्दनः।\nतदुदग्रं महाघोरं सपत्नगणमूदनम्।\nअपज्यमकरोत्पार्थो गाण्डीवं च भयंकरम् ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031471, "chapter_id": 1684, "verse_number": "४-७-२१", "content_sanskrit": "येन वीरः कुरुक्षेत्रमभ्यरक्षत्परंतपः ।\nजृम्भिते च धनुःश्रेष्ठे न्यासार्थं नृपसत्तमः ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031472, "chapter_id": 1684, "verse_number": "४-७-२२", "content_sanskrit": "धर्मपुत्रो महातेजाः सर्वलोकवशंकरम्।\nभुजङ्गभोगसदृशं मणिकाञ्चनभूषितम् ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031473, "chapter_id": 1684, "verse_number": "४-७-२३", "content_sanskrit": "वित्रासनं दानवानां राक्षसानां च नित्यशः ।\nधनूरत्नं महातेजा जृम्भयामास पाण्डवः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031474, "chapter_id": 1684, "verse_number": "४-७-२४", "content_sanskrit": "पाञ्चालान्येन संग्रामे भीमसेनोऽजयत्पुरा ।\nप्रत्यषेधद्बहूनेकः सपत्नांश्चापि दिग्जये ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031475, "chapter_id": 1684, "verse_number": "४-७-२५", "content_sanskrit": "निशम्य यस्य विष्कारं विद्रवन्ति रणे परे ।\nपर्वतस्येव दीर्णस्य विस्फोटमशनेरिव ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031476, "chapter_id": 1684, "verse_number": "४-७-२६", "content_sanskrit": "सैन्धवं येन राजानं जित्वा क्रुद्धः परामृशत् ।\nयेन क्रोधवशाञ्जघ्ने पर्वते गन्धमादने ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031477, "chapter_id": 1684, "verse_number": "४-७-२७", "content_sanskrit": "दिव्यं सौगन्धिकं पुष्पं येनाजैषीत्स पाण्डवः।\nत्रिगर्तान्येन संग्रामे जित्वा त्रैगर्तमानयत् ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031478, "chapter_id": 1684, "verse_number": "४-७-२८", "content_sanskrit": "इन्द्राशनिसमस्पर्शं वज्रहाटकभूषितम् ।\nज्यापाशं धनुषस्तस्य भीमसेनोऽवतारयत् ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031479, "chapter_id": 1684, "verse_number": "४-७-२९", "content_sanskrit": "नकुलं पुनराहूय धर्मराजो युधिष्ठिरः।\nउवाच येन संग्रामे सर्वशत्रूञ्जिघांससि ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031480, "chapter_id": 1684, "verse_number": "४-७-३०", "content_sanskrit": "सुराष्ट्राञ्जितवान्येन शार्ङ्गगाण्डीवसन्निभम् ।\nसुवर्णविकृतं सारमिन्द्रायुधनिभं वरम् ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031481, "chapter_id": 1684, "verse_number": "४-७-३१", "content_sanskrit": "तवानुरूपं सुकृतं चापमेतदलङ्कृतम्।\nतद्व्यंसयित्वा ज्यापाशं निधातुं धनुराहर ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031482, "chapter_id": 1684, "verse_number": "४-७-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031483, "chapter_id": 1684, "verse_number": "४-७-३२", "content_sanskrit": "अजयत्पश्चिमामाशां धनुषा येन पाण्डवः।\nमाद्रीपुत्रो महाबाहुस्ताम्रास्यो मितभाषिता ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031484, "chapter_id": 1684, "verse_number": "४-७-३३", "content_sanskrit": "तस्य मौर्वीमपाकर्षच्छूरः संक्रन्दनो युधि ।\nकुले नास्ति समो रूपे यस्येति नकुलः स्मृतः ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2031485, "chapter_id": 1684, "verse_number": "४-७-३४", "content_sanskrit": "सहदेवं च संप्रेक्ष्य पुनर्धर्मसुतोऽब्रवीत्।\nकलिङ्गान्द्राक्षिणात्यांश्च मागधांश्चाजिशोभनः ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2031486, "chapter_id": 1684, "verse_number": "४-७-३५", "content_sanskrit": "येनैव शत्रून्समरे अधाक्षीररिमर्दन।\nतत्स्रंसयित्वा ज्यापाशं निधातुं धनुराहर ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2031487, "chapter_id": 1684, "verse_number": "४-७-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2031488, "chapter_id": 1684, "verse_number": "४-७-३६", "content_sanskrit": "दक्षिणां दक्षिणाचारो दिशं येनाजयत्प्रभुः ।\nअपज्यमकरोद्वीरः सहदेवस्तदायुधम् ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2031489, "chapter_id": 1684, "verse_number": "४-७-३७", "content_sanskrit": "दीप्तान्खण्डांश्च सुदृढान्सुतीक्ष्णान्कनकत्सरून् ।\nविविधान्क्षुरनाराचान्निस्त्रिंशांश्च शरानपि ।\nआयुधानि कलापांश्च गदाश्च निदधुः सह ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2031490, "chapter_id": 1684, "verse_number": "४-७-३८", "content_sanskrit": "अथाब्रवीद्धर्मराजः सहदेवं परन्तपः।\nआरुह्येमां शमीं वीर निधत्स्वेहायुधानि नः ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2031491, "chapter_id": 1684, "verse_number": "४-७-३९", "content_sanskrit": "इदं गोमृगमभ्याशे गतसत्वमचेतनम् ।\nएतदुत्कृत्य वै वीर धनूंपि परिवेष्टय ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2031492, "chapter_id": 1684, "verse_number": "४-७-४०", "content_sanskrit": "एवमुक्तो महाबाहुः सहदेवो यथोक्तवत् ।\nशमीमारुह्य त्वरितो धनूंपि परिवेष्टयत् ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2031493, "chapter_id": 1684, "verse_number": "४-७-४१", "content_sanskrit": "शीतवातातपभयाद्वर्पत्राणाय दुर्जयः।\nतानि वीरो यथा जानन्निरावाधानि सर्वशः ।\nपुनः पुनः सुसंवेष्ट्य कृत्वा सुकृतमावरम् ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2031494, "chapter_id": 1684, "verse_number": "४-७-४२", "content_sanskrit": "यत्र चापश्यत स वै तिरोवर्पाणि वर्पति।\nतत्र तानि दृढैः पाशैः सुगाढं पर्यवन्धत ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2031495, "chapter_id": 1684, "verse_number": "४-७-४३", "content_sanskrit": "ततः परमदूरस्थमुञ्छवृत्तिकलेवरम्।\nप्रायोपवेशनाच्छुष्कं स्नायुचर्मास्थिसंयुतम् ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2031496, "chapter_id": 1684, "verse_number": "४-७-४४", "content_sanskrit": "तच्चानीय धनुर्मध्ये निबबन्धु पाण्डवाः ।\nउपायकुशलाः सर्वे प्रणदन्तः समब्रुवन् ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2031497, "chapter_id": 1684, "verse_number": "४-७-४५", "content_sanskrit": "अस्य बद्धस्य दौर्गन्ध्यान्मनुष्या वनचारिणः।\nदूरात्परिहरिष्यन्ति सशवेयं शमी इति ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2031498, "chapter_id": 1684, "verse_number": "४-७-४६", "content_sanskrit": "अथाब्रवीन्महाराजो धर्मात्मा स युधिष्ठिरः।\nरञ्जुभिः सुकृतं प्राज्ञ विनिर्वध्नीहि पाण्डव ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2031499, "chapter_id": 1684, "verse_number": "४-७-४७", "content_sanskrit": "यानि चात्र विशालानि रूढमूलानि मन्यसे।\nतेपामुपरि बध्नीहि इदं विप्रकलवरम् ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2031500, "chapter_id": 1684, "verse_number": "४-७-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2031501, "chapter_id": 1684, "verse_number": "४-७-४८", "content_sanskrit": "तच्छ्रुत्वा सहदेवस्तु पर्यबध्नत तच्छवम् ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2031502, "chapter_id": 1684, "verse_number": "४-७-४९", "content_sanskrit": "युधिष्ठिरः शुचिर्भूत्वा मनसाऽभिप्रणम्य च।\nब्रह्माणामिन्द्रं वरदं कुबेरं वरुणानिलौ ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2031503, "chapter_id": 1684, "verse_number": "४-७-५०", "content_sanskrit": "रुद्रं यमं च विष्णुं च सोमार्कौ धर्ममेव च ।\nपृथिवीमन्तरिक्षं च दिशश्चोपदिशस्तथा ।\nवसूश्चं मरुतश्चैव ज्वलनं चातितेजसम् ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2031504, "chapter_id": 1684, "verse_number": "४-७-५१", "content_sanskrit": "दिवाचरा रात्रिचराणि वाऽपि यानीह भूतान्यनुकीर्तितानि ।\nतेभ्यो नमस्कृत्य च सुव्रतेभ्यः प्रणम्य तेपां शरणं गतोऽहम् ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2031505, "chapter_id": 1684, "verse_number": "४-७-५२", "content_sanskrit": "सर्वायुधानीह महाबलानि न्यासं महादेवसमीपतो वै।\nन्यस्याम्यहं वायुसमीपतश्च वनस्पतीनां च सपर्वतानाम् ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2031506, "chapter_id": 1684, "verse_number": "४-७-५३", "content_sanskrit": "एष न्यासो मया दत्तः सोममूर्यानिलान्तिके।\nमम पार्थस्य वा देयं पूर्णे वर्षे त्रयोदशे ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2031507, "chapter_id": 1684, "verse_number": "४-७-५४", "content_sanskrit": "नेदं भीमे प्रदातव्यमयं क्रुद्धो वृकोदरः।\nआमर्षान्नित्यसंक्रुद्धो धृतराष्ट्रसुतान्प्रति।\nअपूर्णकाले प्रहरेत्क्रोधसंजातमत्सरः ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2031508, "chapter_id": 1684, "verse_number": "४-७-५५", "content_sanskrit": "पुनः प्रवेशो नः स्यात्तु वनवासाय सर्वदा ।\nसमये परिपूर्णे तु धार्तराष्ट्रान्निहन्महे ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2031509, "chapter_id": 1684, "verse_number": "४-७-५६", "content_sanskrit": "एष चार्थश्च धर्मश्च कामः कीर्तिरलं यशः।\nमदायत्तमिदं सर्वं जीवितं च न संशयः ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2031510, "chapter_id": 1684, "verse_number": "४-७-५७", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2031511, "chapter_id": 1684, "verse_number": "४-७-५७", "content_sanskrit": "दैवतेभ्यो नमस्कृत्य शमीं कृत्वा प्रदक्षिणम्।\nनगरं गन्तुमायाताः सर्वे ते भ्रातरः सह ॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2031512, "chapter_id": 1684, "verse_number": "४-७-५८", "content_sanskrit": "आगोपालाविपालेभ्यः कर्षकेभ्यः परंतप।\nआजग्मुर्नगराभ्याशं दर्शयन्तः पुनः पुनः ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2031513, "chapter_id": 1684, "verse_number": "४-७-५९", "content_sanskrit": "अशीतिशतवर्पेयं माताऽस्माकमिहान्तिके ।\nबहुकालपरीणामा मृत्योस्तु वशमेयुपी ।\nन चाग्निसंस्कारमियं प्रापिता कुलधर्मतः ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2031514, "chapter_id": 1684, "verse_number": "४-७-६०", "content_sanskrit": "यः समासाद्यते कश्चित्तस्मिन्देशे यदृच्छया।\nतमेवमृचुर्धर्मज्ञाः कुलधर्मो न ईदृशः ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2031515, "chapter_id": 1684, "verse_number": "४-७-६१", "content_sanskrit": "विश्रावयन्तस्ते हृष्टा दिशः सर्वा व्यनादयन् ।\nस्वर्गतेयमिहास्माकं जननी शोकविह्वला ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2031516, "chapter_id": 1684, "verse_number": "४-७-६२", "content_sanskrit": "वने विचरमाणानां लुब्धानां वनचारिणाम्।\nकुलधर्मोऽयमस्माकं पूर्वैराचरितः पुरा ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2031517, "chapter_id": 1684, "verse_number": "४-७-६३", "content_sanskrit": "एवं ते सुकृतं कृत्वा समन्तादवघुष्य च।\nभीमसेनोऽर्जुनश्चैव माद्रीपुत्रावुभावपि ॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2031518, "chapter_id": 1684, "verse_number": "४-७-६४", "content_sanskrit": "युधिष्ठिरश्च कृष्णा च राजपत्नी सुमध्यमा।\nततो यथासमाज्ञप्तं नगरं प्राविशंस्तदा ॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2031519, "chapter_id": 1684, "verse_number": "४-७-६५", "content_sanskrit": "मत्स्यराज्ञो विराटस्य समीपं वस्तुमञ्जसा।\nअज्ञातचर्यां चरितुं वर्षं राष्ट्रे त्रयोदशम् ॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2031520, "chapter_id": 1684, "verse_number": "४-७-६६", "content_sanskrit": "अतश्छन्नानि नामानि चकारैषां युधिष्ठिरः ।\nजयो जयेशो विजयो जयत्सेनो जयद्बलः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2031521, "chapter_id": 1684, "verse_number": "४-७-६७", "content_sanskrit": "आपत्सु नामभिस्त्वेतैः समाह्वामः परस्परम् ॥ ६६ ॥\nततो यथाप्रतिज्ञाभिः प्राविशन्नगरं महत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2031522, "chapter_id": 1684, "verse_number": "४-७-६८", "content_sanskrit": "अज्ञातचर्यां वत्स्यन्तो राष्ट्रे वर्षं त्रयोदशम् ॥ ६७ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2031523, "chapter_id": 1684, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि पाण्डवप्रवेशपर्वणि सप्तमोऽध्यायः ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]