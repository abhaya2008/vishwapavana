[{"id": 2149943, "chapter_id": 4249, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149944, "chapter_id": 4249, "verse_number": "१", "content_sanskrit": "ततो मामब्रवीद् रामः प्रहसन्निव भारत ।\nदिष्ट्या भीष्म मया सार्धं योद्धुमिच्छसि सङ्गरे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149945, "chapter_id": 4249, "verse_number": "२", "content_sanskrit": "अहं गच्छामि कौरव्य कुरुक्षेत्रं त्वया सह ।\nभाषितं ते करिष्यामि तत्रागच्छेः परन्तप\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149946, "chapter_id": 4249, "verse_number": "३", "content_sanskrit": "तत्र त्वां निहतं माता मया शरशताचितम् ।\nजाह्नवी पश्यतां भीष्म गृध्रकङ्कबलाशनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149947, "chapter_id": 4249, "verse_number": "४", "content_sanskrit": "कृपणं त्वामभिप्रेक्ष्य सिद्धचारणसेविता ।\nमया विनिहतं वीर रुदतामद्य पार्थिव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149948, "chapter_id": 4249, "verse_number": "५", "content_sanskrit": "अतदर्हा महाभाग भगीरथसुता नदी ।\nया त्वामजीजनन्मन्दं युद्धकामुकमातुरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149949, "chapter_id": 4249, "verse_number": "६", "content_sanskrit": "एहि गच्छ मया भीष्म युद्धमद्यैव वर्तताम् ।\nगृहाण सर्वं कौरव्य रथादि भरतर्षभ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149950, "chapter_id": 4249, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149951, "chapter_id": 4249, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवाणं तमहं रामं परपुरञ्जयम् ।\nप्रणम्य शिरसा पादावेवमस्त्वित्यथाब्रवम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149952, "chapter_id": 4249, "verse_number": "८", "content_sanskrit": "एवमुक्तो ययौ रामः कुरुक्षेत्रं युयुत्सया ।\nप्रविश्य नगरं चाहं सत्यवत्यै न्यवेदयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149953, "chapter_id": 4249, "verse_number": "९", "content_sanskrit": "ततः कृतस्वस्त्ययनो मात्रा च प्रतिनन्दितः ।\nद्विजातीन् वाच्य पुण्याहं स्वस्ति चैव महाद्युते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149954, "chapter_id": 4249, "verse_number": "१०", "content_sanskrit": "रथमास्थाय रुचिरं राजितं पाण्डरैर्हयैः ।\nसूपस्करं स्वधिष्ठानं वैयाघ्रपरिवारणम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149955, "chapter_id": 4249, "verse_number": "११", "content_sanskrit": "उपपन्नं महाशस्त्रैः सर्वोपकरणान्वितम् ।\nतत्कुलीनेन वीरेण हयशास्त्रविदा नृप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149956, "chapter_id": 4249, "verse_number": "१२", "content_sanskrit": "यत्तं सूतेन शिष्टेन बहुशो दृष्टकर्मणा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149957, "chapter_id": 4249, "verse_number": "१३", "content_sanskrit": "दंसितः पाण्डरेणाहं कवचेन वपुष्मता ।\nपाण्डरं कार्मुकं गृह्य प्रायां भरतसत्तम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149958, "chapter_id": 4249, "verse_number": "१४", "content_sanskrit": "पाण्डरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nव्यजनैः पाण्डरैश्चापि वीज्यमानो नराधिप\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149959, "chapter_id": 4249, "verse_number": "१५", "content_sanskrit": "शुक्लवासाः सितोष्णीषः सर्वशुक्लविभूषणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149960, "chapter_id": 4249, "verse_number": "१६", "content_sanskrit": "स्तूयमानो जयाशीर्भिर्निष्क्रम्य गजसाह्वयात् ।\nकुरुक्षेत्रं रणक्षेत्रमुपायां भरतर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149961, "chapter_id": 4249, "verse_number": "१७", "content_sanskrit": "ते हयाश्चोदितास्तेन सूतेन परमाहवे ।\nअवहन् मां भृशं राजन् मनोमारुतरंहसः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149962, "chapter_id": 4249, "verse_number": "१८", "content_sanskrit": "गत्वाऽहं तत् कुरुक्षेत्रं स च रामः प्रतापवान् ।\nयुद्धाय सहसा राजन् पराक्रान्तौ परस्परम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149963, "chapter_id": 4249, "verse_number": "१९", "content_sanskrit": "ततः सन्दर्शने तिष्ठन् रामस्यातितपस्विनः ।\nप्रगृह्य शङ्खप्रवरं ततः प्राधममुत्तमम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149964, "chapter_id": 4249, "verse_number": "२०", "content_sanskrit": "ततस्तत्र द्विजा राजन् तापसाश्च वनौकसः ।\nअपश्यन्त रणं दिव्यं देवाः सेन्द्रपुरोगमाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149965, "chapter_id": 4249, "verse_number": "२१", "content_sanskrit": "ततो दिव्यानि माल्यानि प्रादुरासन् मुहुर्मुहुः ।\nवादित्राणि च दिव्यानि मेघवृन्दानि चैव ह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149966, "chapter_id": 4249, "verse_number": "२२", "content_sanskrit": "ततस्ते तापसाः सर्वे भार्गवस्यानुयायिनः ।\nप्रेक्षकाः समपद्यन्त परिवार्य रणाजिरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149967, "chapter_id": 4249, "verse_number": "२३", "content_sanskrit": "ततो मामब्रवीद् देवी सर्वभूतहितैषिणी ।\nमाता स्वरूपिणी राजन् किमिदं ते चिकीर्षितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149968, "chapter_id": 4249, "verse_number": "२४", "content_sanskrit": "गत्वाऽहं जामदग्न्यं तु प्रयाचिष्ये कुरूद्वह ।\nभीष्मेण सह मा योत्सीः शिष्येणेति पुनः पुनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149969, "chapter_id": 4249, "verse_number": "२५", "content_sanskrit": "मा मैवं पुत्र निर्बन्धं कुरु विप्रेण पार्थिव ।\nजामदग्न्येन समरे योद्धुमित्यवभत्सयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149970, "chapter_id": 4249, "verse_number": "२६", "content_sanskrit": "किं न वै क्षत्रियहणो हरतुल्यपराक्रमः ।\nविदितः पुत्र रामस्ते यतस्त्वं योद्धुमिच्छसि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149971, "chapter_id": 4249, "verse_number": "२७", "content_sanskrit": "ततोऽहमब्रवं देवीमभिवाद्य कृताञ्जलिः ।\nसर्व तद् भरतश्रेष्ठ यथावृत्तं स्वयंवरे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149972, "chapter_id": 4249, "verse_number": "२८", "content_sanskrit": "यथा च रामो राजेन्द्र मया पूर्वं प्रचोदितः ।\nकाशिराजसुतायाश्च यथा कामः पुरातनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149973, "chapter_id": 4249, "verse_number": "२९", "content_sanskrit": "ततः सा राममभ्येत्य जननी मे महानदी ।\nमदर्थं तमृषिं देवी क्षमयामास भार्गवम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149974, "chapter_id": 4249, "verse_number": "३०", "content_sanskrit": "भीष्मेण सह मा योत्सीः शिष्येणेति वचोऽब्रवीत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149975, "chapter_id": 4249, "verse_number": "३१", "content_sanskrit": "स च तामाह याचन्तीं भीष्ममेव निवर्तय ।\nन हि मे कुरुते कर्म इत्युक्त्वा मामुपागमत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149976, "chapter_id": 4249, "verse_number": "३२", "content_sanskrit": "ततो गङ्गा सुतस्नेहान्मां सा पुनरुपागमत् ।\nनास्या अकरवं वाक्यं क्रोधपर्याकुलेक्षणः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149977, "chapter_id": 4249, "verse_number": "३३", "content_sanskrit": "अथादृश्यत धर्मात्मा भृगुश्रेष्ठो महातपाः ।\nआह्वयामास च तदा युद्धाय द्विजसत्तमः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149978, "chapter_id": 4249, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अशीत्युत्तरशततमोऽध्यायः ॥१८०॥\nअम्बोपाख्यानपर्वणि दशमोऽध्यायः ॥१०॥\n––०–––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]