[{"id": 2006195, "chapter_id": 1123, "verse_number": "१-१२४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006196, "chapter_id": 1123, "verse_number": "१-१२४-१", "content_sanskrit": "तं व्यतीतमुपक्रम्य राजा स्वमिव बान्धवम्।\nसभार्यः शोकदुःखार्तः पर्यदेवयदातुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006197, "chapter_id": 1123, "verse_number": "१-१२४-२x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006198, "chapter_id": 1123, "verse_number": "१-१२४-२", "content_sanskrit": "सतामपि कुले जाताः कर्मणा बत दुर्गतिम्।\nप्राप्नुवन्त्यकृतात्मानः कामजालविमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006199, "chapter_id": 1123, "verse_number": "१-१२४-३", "content_sanskrit": "शश्वद्धर्मात्मना जातो बाल एव पिता मम।\nजीवितान्तमनुप्राप्तः कामात्मैवेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006200, "chapter_id": 1123, "verse_number": "१-१२४-४", "content_sanskrit": "तस्य कामात्मनः क्षेत्रे राज्ञः संयतवागृषिः।\nकृष्णद्वैपायनः साक्षाद्भगवान्मामजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006201, "chapter_id": 1123, "verse_number": "१-१२४-५", "content_sanskrit": "तस्याद्य व्यसने बुद्धिः संजातेयं ममाधमा।\nत्यक्तस्य देवैरनयान्मृगयां परिधावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006202, "chapter_id": 1123, "verse_number": "१-१२४-६", "content_sanskrit": "मोक्षमेव व्यवस्यामि बन्धो हि व्यसनं महत्।\nसुवृत्तिमनुवर्तिष्ये तामहं पितुरव्ययाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006203, "chapter_id": 1123, "verse_number": "१-१२४-७", "content_sanskrit": "अतीव तपसात्मानं योजयिष्याम्यसंशयम्।\nतस्मादेकाहमेकाहमेकैकस्मिन्वनस्पतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006204, "chapter_id": 1123, "verse_number": "१-१२४-८", "content_sanskrit": "चरन्भैक्षं मुनिर्मुण्डश्चरिष्याम्याश्रमानिमान्।\nपांसुना समवच्छन्नः शून्यागारकृतालयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006205, "chapter_id": 1123, "verse_number": "१-१२४-९", "content_sanskrit": "वृक्षमूलनिकेतो वा त्यक्तसर्वप्रियाप्रियः।\nन शोचन्न प्रहृष्यंश्च तुल्यनिन्दात्मसंस्तुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006206, "chapter_id": 1123, "verse_number": "१-१२४-१०", "content_sanskrit": "निराशीर्निर्नमस्कारो निर्द्वन्द्वो निष्परिग्रहः।\nन चाप्यवहसन्कंचिन्न कुर्वन्भ्रुकुटीं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006207, "chapter_id": 1123, "verse_number": "१-१२४-११", "content_sanskrit": "प्रसन्नवदनो नित्यं सर्वभूतहिते रतः।\nजङ्गमाजङ्गमं सर्वमविहिंसंश्चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006208, "chapter_id": 1123, "verse_number": "१-१२४-१२", "content_sanskrit": "स्वासु प्रजास्विव सदा समः प्राणभृतः प्रति।\nएककालं चरन्भैक्षं कुलानि दश पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006209, "chapter_id": 1123, "verse_number": "१-१२४-१३", "content_sanskrit": "असंभवे वा भैक्षस्य चरन्ननशनान्यपि।\nअल्पमल्पं च भुञ्जानः पूर्वालाभे न जातुचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006210, "chapter_id": 1123, "verse_number": "१-१२४-१४", "content_sanskrit": "अन्यान्यपि चरँल्लोभादलाभे सप्त पूरयन्।\nअलाभे यदि वा लाभे समदर्शी महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006211, "chapter_id": 1123, "verse_number": "१-१२४-१५", "content_sanskrit": "वास्यैकं तक्षतो बाहुं चन्दनेनैकमुक्षतः।\nनाकल्याणं न कल्याणं चिन्तयन्नुभयोस्तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006212, "chapter_id": 1123, "verse_number": "१-१२४-१६", "content_sanskrit": "न जिजीविषुवत्किंचिन्न मुमूर्षुवदाचरन्।\nजीवितं मरणं चैव नाभिन्दन्न च द्विषन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006213, "chapter_id": 1123, "verse_number": "१-१२४-१७", "content_sanskrit": "याः काश्चिज्जीवता शक्याः कर्तुमभ्युदयक्रियाः।\nताः सर्वाः समतिक्रम्य निमेषादिव्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006214, "chapter_id": 1123, "verse_number": "१-१२४-१८", "content_sanskrit": "तासु चाप्यनवस्थासु त्यक्तसर्वेन्द्रियक्रियः।\nसंपरित्यक्तधर्मार्थः सुनिर्णिक्तात्मकल्मषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006215, "chapter_id": 1123, "verse_number": "१-१२४-१९", "content_sanskrit": "निर्मुक्तः सर्वपापेभ्यो व्यतीतः सर्ववागुराः।\nन वशे कस्यचित्तिष्ठन्सधर्मा मातरिश्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006216, "chapter_id": 1123, "verse_number": "१-१२४-२०", "content_sanskrit": "एतया सततं वृत्त्या चरन्नेवंप्रकारया।\nदेहं संस्थापयिष्यामि निर्भयं मार्गमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006217, "chapter_id": 1123, "verse_number": "१-१२४-२१", "content_sanskrit": "नाहं सुकृपणे मार्गे स्ववीर्यक्षयशोचिते।\nस्वधर्मात्सततापेते चरेयं वीर्यवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006218, "chapter_id": 1123, "verse_number": "१-१२४-२२", "content_sanskrit": "सत्कृतोऽसत्कृतो वाऽपि योऽन्यां कृपणचक्षुषा।\nउपैति वृत्तिं कामात्मा स शुनां वर्तते पथि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006219, "chapter_id": 1123, "verse_number": "१-१२४-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006220, "chapter_id": 1123, "verse_number": "१-१२४-२३", "content_sanskrit": "एवमुक्त्वा सुदुःखार्तो निःश्वासपरमो नृपः।\nअवेक्षमाणः कुन्तीं च मान्द्रीं च समभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006221, "chapter_id": 1123, "verse_number": "१-१२४-२४", "content_sanskrit": "कौसल्या विदुरः क्षत्ता राजा च सह बन्धुभिः।\nआर्या सत्यवती भीष्मस्ते च राजपुरोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006222, "chapter_id": 1123, "verse_number": "१-१२४-२५", "content_sanskrit": "ब्राह्मणाश्च महात्मानः सोमपाः संशितव्रताः।\nपौरवृद्धाश्च ये तत्र निवसन्त्यस्मदाश्रयाः।\nप्रसाद्य सर्वे वक्तव्याः पाण्डुः प्रव्राजितो वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006223, "chapter_id": 1123, "verse_number": "१-१२४-२६", "content_sanskrit": "निशम्य वचनं भर्तुस्त्यागधर्मकृतात्मनः।\nतत्समं वचनं कुन्ती माद्री च समभाषताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006224, "chapter_id": 1123, "verse_number": "१-१२४-२७", "content_sanskrit": "अन्येऽपि ह्याश्रमाः सन्ति ये शक्या भरतर्षभ।\nआवाभ्यां सह वस्तुं वै धर्ममाश्रित्य चिन्त्यताम्।\nआवाभ्यां धर्मपत्नीभ्यां सह तप्तुं तपो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006225, "chapter_id": 1123, "verse_number": "१-१२४-२८", "content_sanskrit": "शरीरस्यापि मोक्षाय धर्मं प्राप्य महाफलम्।\nत्वमेव भविता भर्ता स्वर्गस्यापि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006226, "chapter_id": 1123, "verse_number": "१-१२४-२९", "content_sanskrit": "प्रणिधायेन्द्रियग्रामं भर्तृलोकपरायणे।\nत्यक्त्वा कामसुखे ह्यावां तप्स्यवो विपुलं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006227, "chapter_id": 1123, "verse_number": "१-१२४-३०", "content_sanskrit": "यदि चावां महाप्राज्ञ त्यक्ष्यसि त्वं विशांपते।\nअद्यैवावां प्रहास्यावो जीवितं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006228, "chapter_id": 1123, "verse_number": "१-१२४-३१x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006229, "chapter_id": 1123, "verse_number": "१-१२४-३१", "content_sanskrit": "यदि व्यवसितं ह्येतद्युवयोर्धर्मसंहितम्।\nस्ववृत्तिमनुवर्तिष्ये तामहं पितुरव्ययाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006230, "chapter_id": 1123, "verse_number": "१-१२४-३२", "content_sanskrit": "त्यक्त्वा ग्राम्यसुखाहारं तप्यमानो महत्तपः।\nवल्कली फलमूलाशी चरिष्यामि महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006231, "chapter_id": 1123, "verse_number": "१-१२४-३३", "content_sanskrit": "अग्नौ जुह्वन्नुभौ कालावुभौ कालावुपस्पृशन्।\nकृशः परिमिताहारश्चीरचर्मजटाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006232, "chapter_id": 1123, "verse_number": "१-१२४-३४", "content_sanskrit": "शीतवातातपसहः क्षुत्पिपासानवेक्षकः।\nतपसा दुश्चरेणेदं शरीरमुपशोषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006233, "chapter_id": 1123, "verse_number": "१-१२४-३५", "content_sanskrit": "एकान्तशीली विमृशन्पक्वापक्वेन वर्तयन्।\nपितृन्देवांश्च वन्येन वाग्भिरद्भिश्च तर्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006234, "chapter_id": 1123, "verse_number": "१-१२४-३६", "content_sanskrit": "वानप्रस्थजनस्यापि दर्शनं कुलवासिनः।\nनाप्रियाण्याचरिष्यामि किं पुनर्ग्रामवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006235, "chapter_id": 1123, "verse_number": "१-१२४-३७", "content_sanskrit": "एवमारण्यशास्त्राणामुग्रमुग्रतरं विधिम्।\nकाङ्क्षमाणोऽहमास्थास्ये देहस्यास्याऽऽसमापनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006236, "chapter_id": 1123, "verse_number": "१-१२४-३८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006237, "chapter_id": 1123, "verse_number": "१-१२४-३८", "content_sanskrit": "इत्येवमुक्त्वा भार्ये ते राजा कौरवनन्दनः।\nततश्चूडामणिं निष्कमङ्गदे कुण्डलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006238, "chapter_id": 1123, "verse_number": "१-१२४-३९", "content_sanskrit": "वासांसि च महार्हाणि स्त्रीणामाभरणानि च।\nवाहनानि च मुख्यानि शस्त्राणि कवचानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006239, "chapter_id": 1123, "verse_number": "१-१२४-४०", "content_sanskrit": "हेमभाण्डानि दिव्यानि पर्यङ्कास्तरणानि च।\nमणिमुक्ताप्रवालानि रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006240, "chapter_id": 1123, "verse_number": "१-१२४-४१", "content_sanskrit": "प्रदाय सर्वं विप्रेभ्यः पाण्डुर्भृत्यानभाषत।\nगत्वा नागपुरं वाच्यं पाण्डुः प्रव्राजितो वने।\nअर्थं कामं सुखं चैव रतिं च परमात्मिकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006241, "chapter_id": 1123, "verse_number": "१-१२४-४२", "content_sanskrit": "प्रतस्थे सर्वमुत्सृज्य सभार्यः कुरुनन्दनः।\nततस्तस्यानुयातारस्ते चैव परिचारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006242, "chapter_id": 1123, "verse_number": "१-१२४-४३", "content_sanskrit": "श्रुत्वा भरतसिंहस्य विधिधाः करुणा गिरः।\nभममार्तस्वरं कृत्वा हाहेति परिचुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006243, "chapter_id": 1123, "verse_number": "१-१२४-४४", "content_sanskrit": "उष्णमश्रु विमुञ्चन्तस्तं विहाय महीपतिम्।\nययुर्नागपुरं तूर्णं सर्वमादाय तद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006244, "chapter_id": 1123, "verse_number": "१-१२४-४५", "content_sanskrit": "ते गत्वा नगरं राज्ञो यथावृत्तं महात्मनः।\nकथयांचक्रिरे राज्ञस्तद्धनं विविधं ददुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006245, "chapter_id": 1123, "verse_number": "१-१२४-४६", "content_sanskrit": "श्रुत्वा तेभ्यस्ततः सर्वं यथावृत्तं महावने।\nधृतराष्ट्रो नरश्रेष्ठः पाण्डुमेवान्वशोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006246, "chapter_id": 1123, "verse_number": "१-१२४-४७", "content_sanskrit": "न शय्यासनभोगेषु रतिं विन्दति कर्हिचित्।\nभ्रातृशोकसमाविष्टस्तमेवार्थं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006247, "chapter_id": 1123, "verse_number": "१-१२४-४८", "content_sanskrit": "राजपुत्रस्तु कौरव्य पाण्डुर्मूलफलाशनः।\nजगाम सह पत्नीभ्यां ततो नागशतं गिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2006248, "chapter_id": 1123, "verse_number": "१-१२४-४९", "content_sanskrit": "स चैत्ररथमासाद्य कालकूटमतीत्य च।\nहिमवन्तमतिक्रम्य प्रययौ गन्धमादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2006249, "chapter_id": 1123, "verse_number": "१-१२४-५०", "content_sanskrit": "रक्ष्यमाणो महाभूतैः सिद्धैश्च परमर्षिभिः।\nउवास स महाराज समेषु विषमेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2006250, "chapter_id": 1123, "verse_number": "१-१२४-५१", "content_sanskrit": "इन्द्रद्युम्नसरः प्राप्य हंसकूटमतीत्य च।\nशतशृङ्गे महाराज तापसः समतप्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2006251, "chapter_id": 1123, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुर्विंशत्यधिकशततमोऽध्यायः॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]