[{"id": 6000126000, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "बृहस्पत्याचार्येण परित्यक्तैः सुरैः विश्वरूपाचार्यस्य पौरोहित्ये वरणम्", "range": null}]}, {"id": 6000126001, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.001.m4a", "display_order": 2}, {"id": 6000126002, "chapter_id": 10126, "verse_number": "६-७-१", "content_sanskrit": "यस्य हेतोः परित्यक्ता आचार्येणात्मनः सुराः।\nएतदाचक्ष्व भगवन् शिष्याणामक्रमं गुरौ॥ ६/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.002.m4a", "display_order": 3}, {"id": 6000126003, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.003.m4a", "display_order": 4}, {"id": 6000126004, "chapter_id": 10126, "verse_number": "६-७-२", "content_sanskrit": "इन्द्रस्‍त्रिभुवनैश्वर्यमदोल्लङ्घितसत्पथः।\nमरुद्भिर्वसुभी रुद्रैरादित्यैर्ऋभुभिर्नृप॥ ६/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.004.m4a", "display_order": 5}, {"id": 6000126005, "chapter_id": 10126, "verse_number": "६-७-३", "content_sanskrit": "विश्वेदेवैश्च साध्यैश्च नासत्याभ्यां परिश्रितः।\nसिद्धचारणगन्धर्वैर्मुनिभिर्ब्रह्मवादिभिः॥ ६/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.005.m4a", "display_order": 6}, {"id": 6000126006, "chapter_id": 10126, "verse_number": "६-७-४", "content_sanskrit": "विद्याधराप्सरोभिश्च किन्नरैः पतगोरगैः।\nनिषेव्यमाणो भगवान् स्तूयमानश्च भारत॥ ६/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.006.m4a", "display_order": 7}, {"id": 6000126007, "chapter_id": 10126, "verse_number": "६-७-५", "content_sanskrit": "उपगीयमानो ललितमास्थानाध्यासनाश्रितः।\nपाण्डुरेणातपत्रेण चन्द्रमण्डलचारुणा॥ ६/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.007.m4a", "display_order": 8}, {"id": 6000126008, "chapter_id": 10126, "verse_number": "६-७-६", "content_sanskrit": "युक्तश्चान्यैः पारमेष्ठ्यैश्चामरव्यजनादिभिः।\nविराजमानः पौलोम्या सहार्धासनया भृशम्॥ ६/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.008.m4a", "display_order": 9}, {"id": 6000126009, "chapter_id": 10126, "verse_number": "६-७-७", "content_sanskrit": "स यदा परमाचार्यं देवानामात्मनश्च ह।\nनाभ्यनन्दत सम्प्राप्तं प्रत्युत्थानासनादिभिः॥ ६/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.009.m4a", "display_order": 10}, {"id": 6000126010, "chapter_id": 10126, "verse_number": "६-७-८", "content_sanskrit": "वाचस्पतिं मुनिवरं सुरासुरनमस्कृतम्।\nनोच्चचालासनादिन्द्रः पश्यन्नपि समागतम्॥ ६/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.010.m4a", "display_order": 11}, {"id": 6000126011, "chapter_id": 10126, "verse_number": "६-७-९", "content_sanskrit": "ततो निर्गत्य सहसा कविराङ्गिरसः प्रभुः।\nआययौ स्वगृहं तूष्णीं विद्वाञ् श्रीमदविक्रियाम्॥ ६/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.011.m4a", "display_order": 12}, {"id": 6000126012, "chapter_id": 10126, "verse_number": "६-७-१०", "content_sanskrit": "तर्ह्येव प्रतिबुध्येन्द्रो गुरुहेलनमात्मनः।\nगर्हयामास सदसि स्वयमात्मानमात्मना॥ ६/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.012.m4a", "display_order": 13}, {"id": 6000126013, "chapter_id": 10126, "verse_number": "६-७-११", "content_sanskrit": "अहो बत मयाऽसाधु कृतं वै दभ्रबुद्धिना।\nयन्मयैश्वर्यमत्तेन गुरुः सदसि कात्कृतः॥ ६/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.013.m4a", "display_order": 14}, {"id": 6000126014, "chapter_id": 10126, "verse_number": "६-७-१२", "content_sanskrit": "को गृध्द्येत् पण्डितो लक्ष्मीं त्रिविष्टपपतेरपि।\nययाऽहमासुरं भावं नीतोऽद्य विबुधेश्वरः॥ ६/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.014.m4a", "display_order": 15}, {"id": 6000126015, "chapter_id": 10126, "verse_number": "६-७-१३", "content_sanskrit": "ये पारमेष्ठ्यधिषणमधितिष्ठन् न कञ्चन।\nप्रत्युत्तिष्ठेदिति ब्रूयुर्धर्मं ते न परं विदुः॥ ६/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.015.m4a", "display_order": 16}, {"id": 6000126016, "chapter_id": 10126, "verse_number": "६-७-१४", "content_sanskrit": "तेषां कुपथद्रष्टॄणां पततां तमसि ह्यधः।\nये श्रद्धधुर्वचस्ते वै मज्जन्त्यश्मप्लवा इव॥ ६/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.016.m4a", "display_order": 17}, {"id": 6000126017, "chapter_id": 10126, "verse_number": "६-७-१५", "content_sanskrit": "अथाहममराचार्यमगाधधिषणं द्विजम्।\nप्रसादयिष्येऽतिशठः शीर्ष्णा तच्चरणं स्पृशन्॥ ६/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.017.m4a", "display_order": 18}, {"id": 6000126018, "chapter_id": 10126, "verse_number": "६-७-१६", "content_sanskrit": "एवं चिन्तयतस्तस्य मघोनो भगवान् गृहात्।\nबृहस्पतिर्गतोऽदृष्टां गतिमध्यात्ममायया॥ ६/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.018.m4a", "display_order": 19}, {"id": 6000126019, "chapter_id": 10126, "verse_number": "६-७-१७", "content_sanskrit": "गुरोर्नाधिगतः संज्ञां परीक्षन् भगवान् स्वराट्।\nध्यायन् धिया सुरैर्युक्तः शर्म नालभतात्मनः॥ ६/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.019.m4a", "display_order": 20}, {"id": 6000126020, "chapter_id": 10126, "verse_number": "६-७-१८", "content_sanskrit": "तच्छ्रुत्वैवासुराः सर्व आश्रित्यौशनसं मतम्।\nदेवान् प्रत्युद्यमं चक्रुर्दुर्मदा आततायिनः॥ ६/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.020.m4a", "display_order": 21}, {"id": 6000126021, "chapter_id": 10126, "verse_number": "६-७-१९", "content_sanskrit": "तैर्विसृष्टेषुभिस्तीक्ष्णैर्निर्भिण्णाङ्गोरुबाहवः।\nब्रह्माणं शरणं जग्मुः सहेन्द्रा नतकन्धराः॥ ६/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.021.m4a", "display_order": 22}, {"id": 6000126022, "chapter_id": 10126, "verse_number": "६-७-२०", "content_sanskrit": "तांस्तथाऽभ्यर्दितान् वीक्ष्य भगवानात्मभूरजः।\nकृपया परया देव उवाच परिसान्त्वयन्॥ ६/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.022.m4a", "display_order": 23}, {"id": 6000126023, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.023.m4a", "display_order": 24}, {"id": 6000126024, "chapter_id": 10126, "verse_number": "६-७-२१", "content_sanskrit": "अहो बत सुरश्रेष्ठा ह्यभद्रं वः कृतं महत्।\nब्रह्मिष्ठं ब्राह्मणं दान्तमैश्वर्यान्नाभ्यनन्दत॥ ६/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.024.m4a", "display_order": 25}, {"id": 6000126025, "chapter_id": 10126, "verse_number": "६-७-२२", "content_sanskrit": "तस्यायमनयस्यासीत् परेभ्यो वः पराभवः।\nप्रक्षीणेभ्यः स्ववैरिभ्यः समृद्धानां च यत् सुराः॥ ६/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.025.m4a", "display_order": 26}, {"id": 6000126026, "chapter_id": 10126, "verse_number": "६-७-२३", "content_sanskrit": "मघवन् द्विषतः पश्य प्रक्षीणान् गुर्वतिक्रमात्। सम्प्रत्युपचितान् भूयः काव्यमाराध्य भक्तितः।\nआददीरन् निलयनं ममापि भृगुदेवताः॥ ६/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.026.m4a", "display_order": 27}, {"id": 6000126027, "chapter_id": 10126, "verse_number": "६-७-२४", "content_sanskrit": "त्रिविष्टपं किं गणयन्त्यभेद्यं मन्त्रा भृगूणामनुशिक्षितार्थाः।\nन विप्रगोविन्दगवीश्वराणां भवन्त्यभद्राणि नरेश्वराणाम्॥ ६/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.027.m4a", "display_order": 28}, {"id": 6000126028, "chapter_id": 10126, "verse_number": "६-७-२५", "content_sanskrit": "तद् विश्वरूपं भजताशु विप्रं तपस्विनं त्वाष्ट्रमथात्मवन्तम्।\nसभाजितोऽर्थान् स विधास्यते वो यदि क्षमिष्यध्वमुतास्य कर्म॥ ६/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.028.m4a", "display_order": 29}, {"id": 6000126029, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.029.m4a", "display_order": 30}, {"id": 6000126030, "chapter_id": 10126, "verse_number": "६-७-२६", "content_sanskrit": "त एवमुदिता राजन् ब्रह्मणा विगतज्वराः।\nऋषिं त्वाष्ट्रमुपव्रज्य परिष्वज्येदमब्रुवन्॥ ६/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.030.m4a", "display_order": 31}, {"id": 6000126031, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.031.m4a", "display_order": 32}, {"id": 6000126032, "chapter_id": 10126, "verse_number": "६-७-२७", "content_sanskrit": "वयं तेऽतिथयः प्राप्ता आश्रमं भद्रमस्तु ते।\nकामः सम्पाद्यतां तात पितॄणां समयोचितः॥ ६/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.032.m4a", "display_order": 33}, {"id": 6000126033, "chapter_id": 10126, "verse_number": "६-७-२८", "content_sanskrit": "पुत्राणां हि परो धर्मः पितृशुश्रूषणं सताम्।\nअपि पुत्रवतां ब्रह्मन् किमुत ब्रह्मचारिणाम्॥ ६/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.033.m4a", "display_order": 34}, {"id": 6000126034, "chapter_id": 10126, "verse_number": "६-७-२९", "content_sanskrit": "आचार्यो ब्रह्मणो मूर्तिः पिता मूर्तिः प्रजापतेः।\nभ्राता मरुत्पतेर्मूर्तिर्माता साक्षात् क्षितेस्तनुः॥ ६/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.034.m4a", "display_order": 35}, {"id": 6000126035, "chapter_id": 10126, "verse_number": "६-७-३०", "content_sanskrit": "दयाया भगिनी मूर्तिर्धर्मस्यात्माऽतिथिः स्वयम्।\nअग्नेरभ्यागतो मूर्तिः सर्वभूतानि चात्मनः॥ ६/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.035.m4a", "display_order": 36}, {"id": 6000126036, "chapter_id": 10126, "verse_number": "६-७-३१", "content_sanskrit": "तस्मात् पितॄणामार्तानाम् आर्तिं परपराभवाम्।\nतपसाऽपनयन् तात सन्देशं कर्तुमर्हसि॥ ६/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.036.m4a", "display_order": 37}, {"id": 6000126037, "chapter_id": 10126, "verse_number": "६-७-३२", "content_sanskrit": "वृणीमहे त्वोपाध्यायं ब्रह्मिष्ठं ब्राह्मणं गुरुम्।\nयथाऽञ्जसा विजेष्यामः सपत्नांस्तव तेजसा॥ ६/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.037.m4a", "display_order": 38}, {"id": 6000126038, "chapter_id": 10126, "verse_number": "६-७-३३", "content_sanskrit": "नो गर्हयन्ति ह्यर्थेषु यविष्ठाङ्घ्रभिवादनम्।\nछन्दोभ्योऽन्यत्र न ब्रह्मन् वयो ज्यैष्ठ्यस्य कारणम्॥ ६/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.038.m4a", "display_order": 39}, {"id": 6000126039, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.039.m4a", "display_order": 40}, {"id": 6000126040, "chapter_id": 10126, "verse_number": "६-७-३४", "content_sanskrit": "अभ्यर्थितः सुरगणैः पौरोहित्ये महातपाः।\nस विश्वरूपस्तानाह प्रसन्नः श्लक्ष्णया गिरा॥ ६/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.040.m4a", "display_order": 41}, {"id": 6000126041, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "विश्वरूप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.041.m4a", "display_order": 42}, {"id": 6000126042, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "विगर्हितं धर्मशीलैर्ब्रह्मवर्चउपव्ययम्।\nकथं नु मद्विधो नाथा लोकेशैरभियाचितः॥ ६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.042.m4a", "display_order": 43}, {"id": 6000126043, "chapter_id": 10126, "verse_number": "६-७-३५", "content_sanskrit": "प्रत्याख्यास्यति तच्छिष्यः स एव स्वार्थ उच्यते॥ ६/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.043.m4a", "display_order": 44}, {"id": 6000126044, "chapter_id": 10126, "verse_number": "६-७-३६", "content_sanskrit": "अकिञ्चनानां हि धनं शिलोञ्छनं स तेन निर्वर्तितसाधुसत्क्रियः।\nकथं विगर्ह्यं तु करोम्यधीश्वराः पौरोधसं हृष्यति येन दुर्मतिः॥ ६/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.044.m4a", "display_order": 45}, {"id": 6000126045, "chapter_id": 10126, "verse_number": "६-७-३७", "content_sanskrit": "तथाऽपि न प्रतिब्रूयां गुरुभिः प्रार्थितं कियत्।\nभवतां प्रार्थितं सर्वं प्राणैरर्थैश्च साधये॥ ६/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.045.m4a", "display_order": 46}, {"id": 6000126046, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.046.m4a", "display_order": 47}, {"id": 6000126047, "chapter_id": 10126, "verse_number": "६-७-३८", "content_sanskrit": "तेभ्य एवं प्रतिश्रुत्य विश्वरूपो महातपाः।\nपौरोहित्यं ततश्चक्रे परमेण समाधिना॥ ६/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.047.m4a", "display_order": 48}, {"id": 6000126048, "chapter_id": 10126, "verse_number": "६-७-३९", "content_sanskrit": "सुरद्विषां श्रियं गुप्ताम् औशनस्याऽपि विद्यया।\nआच्छिद्यादान्महेन्द्राय वैष्णव्या विद्यया विभुः॥ ६/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.048.m4a", "display_order": 49}, {"id": 6000126049, "chapter_id": 10126, "verse_number": "६-७-४०", "content_sanskrit": "यया गुप्तः सहस्राक्षो जिग्येऽसुरचमूर्विभुः।\nतां प्राह स महेन्द्राय विश्वरूप उदारधीः॥ ६/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.049.m4a", "display_order": 50}, {"id": 6000126050, "chapter_id": 10126, "verse_number": "६-७-४१", "content_sanskrit": "यां प्रविश्यासुराञ्छश्वत् कक्ष्यां नारायणात्मिकाम्।\nअजैषीद् वृषभस्तात सिंहः क्षुद्रमृगानिव॥ ६/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_007/BhP_06.007.050.m4a", "display_order": 51}, {"id": 6000126051, "chapter_id": 10126, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]