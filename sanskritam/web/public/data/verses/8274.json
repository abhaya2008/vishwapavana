[{"id": 900002964, "chapter_id": 8274, "verse_number": "8.1", "content_sanskrit": "किं तद् ब्रह्म किमध्यात्मं किं कर्म पुरुषोत्तम । अधिभूतं च किं प्रोक्तमधिदैवं किमुच्यते ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002965, "chapter_id": 8274, "verse_number": "8.2", "content_sanskrit": "अधियज्ञः कथं कोऽत्र देहेऽस्मिन् मधुसूदन । प्रयाणकाले च कथं ज्ञेयोऽसि नियतात्मभिः ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002966, "chapter_id": 8274, "verse_number": "8.3", "content_sanskrit": "अक्षरं ब्रह्म परमं स्वभावोऽध्यात्ममुच्यते । भूतभावोद्भवकरो विसर्गः कर्मसञ्ज्ञितः ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002967, "chapter_id": 8274, "verse_number": "8.4", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002968, "chapter_id": 8274, "verse_number": "8.5", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002969, "chapter_id": 8274, "verse_number": "8.6", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002970, "chapter_id": 8274, "verse_number": "8.7", "content_sanskrit": "अधिभूतं क्षरो भावः पुरुषश्चाधिदैवतम् । अधियज्ञोऽहमेवात्र देहे देहभृतां वर ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002971, "chapter_id": 8274, "verse_number": "8.8", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002972, "chapter_id": 8274, "verse_number": "8.9", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002973, "chapter_id": 8274, "verse_number": "8.10", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002974, "chapter_id": 8274, "verse_number": "8.11", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002975, "chapter_id": 8274, "verse_number": "8.12", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002976, "chapter_id": 8274, "verse_number": "8.13", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002977, "chapter_id": 8274, "verse_number": "8.14", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002978, "chapter_id": 8274, "verse_number": "8.15", "content_sanskrit": "अन्तकाले च मामेव स्मरन् मुक्त्वा कलेवरम् । यः प्रयाति स मद्भावं याति नास्त्यत्र संशयः ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002979, "chapter_id": 8274, "verse_number": "8.16", "content_sanskrit": "यं यं वाऽपि स्मरन् भावं त्यजत्यन्ते कलेवरम् । तं तमैवैति कौन्तेय सदा तद्भावभावितः ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002980, "chapter_id": 8274, "verse_number": "8.17", "content_sanskrit": "तस्मात् सर्वेषु कालेषु मामनुस्मर युध्य च । मय्यर्पितमनोबुद्धिर्मामेवैष्यस्यसंशयः ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002981, "chapter_id": 8274, "verse_number": "8.18", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002982, "chapter_id": 8274, "verse_number": "8.19", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002983, "chapter_id": 8274, "verse_number": "8.20", "content_sanskrit": "अभ्यासयोगयुक्तेन चेतसाऽनन्यगामिना । परमं पुरुषं दिव्यं याति पार्थानुचिन्तयन् ।। ८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002984, "chapter_id": 8274, "verse_number": "8.21", "content_sanskrit": "कविं पुराणमनुशासितारमणोरणीयांसमनुस्मरेद्यः । सर्वस्य धातारमचिन्त्यरूपमादित्यवर्णं तमसः परस्तात् ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002985, "chapter_id": 8274, "verse_number": "8.22", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002986, "chapter_id": 8274, "verse_number": "8.23", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002987, "chapter_id": 8274, "verse_number": "8.24", "content_sanskrit": "प्रयाणकाले मनसाऽचलेन भक्त्या युक्तो योगबलेन चैव । भ्रुवोर्मध्ये प्राणमावेश्य सम्यक् स तं परं पुरुषमुपैति दिव्यम् ।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002988, "chapter_id": 8274, "verse_number": "8.25", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002989, "chapter_id": 8274, "verse_number": "8.26", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002990, "chapter_id": 8274, "verse_number": "8.27", "content_sanskrit": "यदक्षरं वेदविदो वदन्ति विशन्ति यद्यतयो वीतरागाः । यदिच्छन्तो ब्रह्मचर्यं चरन्ति तत्ते पदं सङ्ग्रहेण प्रवक्ष्ये ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002991, "chapter_id": 8274, "verse_number": "8.28", "content_sanskrit": "सर्वद्वाराणि संयम्य मनो हृदि निरुध्य च । मूध्नर्याधायाऽऽत्मनः प्राणमास्थितो योगधारणाम् ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002992, "chapter_id": 8274, "verse_number": "8.29", "content_sanskrit": "ओ३म् इत्येकाक्षरं ब्रह्म व्याहरन् मामनुस्मरन् । यः प्रयाति त्यजन् देहं स याति परमां गतिम् ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002993, "chapter_id": 8274, "verse_number": "8.30", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002994, "chapter_id": 8274, "verse_number": "8.31", "content_sanskrit": "अनन्यचेताः सततं यो मां स्मरति नित्यशः । तस्याहं सुलभः पार्थ नित्ययुक्तस्य योगिनः ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002995, "chapter_id": 8274, "verse_number": "8.32", "content_sanskrit": "मामुपेत्य पुनर्जन्म दुःखालयमशाश्वतम् । नाऽप्नुवन्ति महात्मानः संसिद्धिं परमां गताः ।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002996, "chapter_id": 8274, "verse_number": "8.33", "content_sanskrit": "आब्रह्मभवनाल्लोेकाः पुनरावर्तिनोऽर्जुन । मामुपेत्य तु कौन्तेय पुनर्जन्म न विद्यते ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900002997, "chapter_id": 8274, "verse_number": "8.34", "content_sanskrit": "सहस्रयुगपर्यन्तमहर्यद् ब्रह्मणो विदुः । रात्रिं युगसहस्रान्तां तेऽहोरात्रविदो जनाः ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900002998, "chapter_id": 8274, "verse_number": "8.35", "content_sanskrit": "अव्यक्ताद् व्यक्तयः सर्वाः प्रभवन्त्यहरागमे । रात्र्यागमे प्रलीयन्ते तत्रैवाव्यक्तसञ्ज्ञके ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900002999, "chapter_id": 8274, "verse_number": "8.36", "content_sanskrit": "भूतग्रामः स एवायं भूत्वा भूत्वा प्रलीयते । रात्र्यागमेऽवशः पार्थ प्रभवत्यहरागमे ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900003000, "chapter_id": 8274, "verse_number": "8.37", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900003001, "chapter_id": 8274, "verse_number": "8.38", "content_sanskrit": "परस्तस्मात्तु भावोऽन्योऽव्यक्तो व्यक्तात्सनातनः । यः स सर्वेषु भूतेषु नश्यत्सु न विनश्यति ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900003002, "chapter_id": 8274, "verse_number": "8.39", "content_sanskrit": "अव्यक्तोऽक्षर इत्युक्तस्तमाहुः परमां गतिम् । यं प्राप्य न निवर्तन्ते तद्धाम परमं मम ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900003003, "chapter_id": 8274, "verse_number": "8.40", "content_sanskrit": "पुरुषः स परः पार्थ भक्त्या लभ्यस्त्वनन्यया । यस्यान्तस्थानि भूतानि येन सर्वमिदं ततम् ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900003004, "chapter_id": 8274, "verse_number": "8.41", "content_sanskrit": "यत्र काले त्वनावृत्तिमावृत्तिं चैव योगिनः । प्रयाता यान्ति तं कालं वक्ष्यामि भरतर्षभ ।। २३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900003005, "chapter_id": 8274, "verse_number": "8.42", "content_sanskrit": "अग्निर्ज्योतिरहः शुक्लः षण्मासा उत्तरायणम् । तत्र प्रयाता गच्छन्ति ब्रह्म ब्रह्मविदो जनाः ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900003006, "chapter_id": 8274, "verse_number": "8.43", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900003007, "chapter_id": 8274, "verse_number": "8.44", "content_sanskrit": "धूमो रात्रिस्तथा कृष्णः षण्मासा दक्षिणायनम् । तत्र चान्द्रमसं ज्योतिर्योगी प्राप्य निवर्तते ।। २५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900003008, "chapter_id": 8274, "verse_number": "8.45", "content_sanskrit": "शुक्लकृष्णे गती ह्येते जगतः शाश्वते मते । एकया यात्यनावृत्तिमन्ययाऽऽवर्तते पुनः ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900003009, "chapter_id": 8274, "verse_number": "8.46", "content_sanskrit": "नैते सृती पार्थ जानन् योगी मुह्यति कश्चन । तस्मात् सर्वेषु कालेषु योगयुक्तो भवार्जुन ।। २७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900003010, "chapter_id": 8274, "verse_number": "8.47", "content_sanskrit": "वेदेषु यज्ञेषु तपस्सु चैव दानेषु यत् पुण्यफलं प्रदिष्टम् । अत्येति तत्सर्वमिदं विदित्वा योगी परं स्थानमुपैति चाद्यम् ।।२८।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]