[{"id": 7000355000, "chapter_id": 20355, "verse_number": "२-२७-१", "content_sanskrit": "सूत उवाच ।\nस प्रभुः सर्वलोकेशो ह्यभिषिच्य ततो नृपम् ।\nपृथुं वेनस्य तनयं सर्वराज्ये महाप्रभुम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000355001, "chapter_id": 20355, "verse_number": "२-२७-२", "content_sanskrit": "महाबाहुं महाकायं यथेंद्रं च सुरेश्वरम् ।\nक्रमेणापि ततो ब्रह्मा राज्यानि च विचार्य वै॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000355002, "chapter_id": 20355, "verse_number": "२-२७-३", "content_sanskrit": "यद्यस्यापि भवेद्योग्यं दातुं तदुपचक्रमे ।\nवृक्षाणां ब्राह्मणानां च ग्रहर्क्षाणां तथैव च॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000355003, "chapter_id": 20355, "verse_number": "२-२७-४", "content_sanskrit": "सोमं राज्ये सोभ्यषिंचत्तपसां च महामतिः ।\nधर्माणां धर्मयज्ञानां पुण्यानां पुण्यतेजसाम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000355004, "chapter_id": 20355, "verse_number": "२-२७-५", "content_sanskrit": "अपां मध्ये तथा देवं तीर्थानां हि तथैव च ।\nवरुणं सोभिषिच्यैव रत्नानां च द्विजोत्तम॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000355005, "chapter_id": 20355, "verse_number": "२-२७-६", "content_sanskrit": "अन्येषां सर्वयक्षाणां राज्ये वैश्रवणं पुनः ।\nविष्णुमेव महाप्राज्ञमादित्यानां पितामहः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000355006, "chapter_id": 20355, "verse_number": "२-२७-७", "content_sanskrit": "राज्ये संस्थापयामास जनता हितहेतवे ।\nसर्वेषामेव पुण्यानां दक्षमेव प्रजापतिम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000355007, "chapter_id": 20355, "verse_number": "२-२७-८", "content_sanskrit": "समर्थं सर्वधर्मज्ञं प्रजापतिगणेश्वरम् ।\nप्रह्रादं सर्वधर्मज्ञं स हि राज्ये न्यरूपयत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000355008, "chapter_id": 20355, "verse_number": "२-२७-९", "content_sanskrit": "दैत्यानां दानवानां च विष्णुतेजः समन्वितम् ।\nयमं वैवस्वतं धर्मं पैत्र्ये राज्येभिषिच्य च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000355009, "chapter_id": 20355, "verse_number": "२-२७-१०", "content_sanskrit": "यक्षराक्षसभूतानां पिशाचोरगसर्पिणाम् ।\nयोगिनीनां च सर्वासां वैतालानां महात्मनाम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000355010, "chapter_id": 20355, "verse_number": "२-२७-११", "content_sanskrit": "कंकालानां हि सर्वेषां कूष्मांडानां तथैव च ।\nपार्थिवानां च सर्वेषां गिरिशं शूलपाणिनम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000355011, "chapter_id": 20355, "verse_number": "२-२७-१२", "content_sanskrit": "पर्वतानां हि सर्वेषां हिमवंतं महागिरिम् ।\nनदीनां च तडागानां वापिकानां तथैव च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000355012, "chapter_id": 20355, "verse_number": "२-२७-१३", "content_sanskrit": "कुंडानां कूपराज्ये हि दिव्येषु च सुरेश्वरः ।\nसागरं स्थापितं पुण्यं सर्वतीर्थमनुत्तमम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000355013, "chapter_id": 20355, "verse_number": "२-२७-१४", "content_sanskrit": "गंधर्वाणां तु सर्वेषां राज्ये पुण्ये तथैव च ।\nचित्ररथं ततो ब्रह्मा अभिषिच्य सुरेश्वरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000355014, "chapter_id": 20355, "verse_number": "२-२७-१५", "content_sanskrit": "नागानां पुण्यवीर्याणां वासुकिं च चतुर्मुखः ।\nसर्पाणां तु तथा राज्ये अभिषिच्य स तक्षकम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000355015, "chapter_id": 20355, "verse_number": "२-२७-१६", "content_sanskrit": "वारणानां ततो राज्ये ऐरावणमसिंचत ।\nअश्वानां चैव सर्वेषामुच्चैःश्रवसमेव च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000355016, "chapter_id": 20355, "verse_number": "२-२७-१७", "content_sanskrit": "पक्षिणां चैव सर्वेषां वैनतेयमथापि सः ।\nमृगाणां च ततो राज्ये ब्रह्मा सिंहमथादिशत्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000355017, "chapter_id": 20355, "verse_number": "२-२७-१८", "content_sanskrit": "गोवृषं तु गवां मध्ये अभिषिच्य प्रजापतिः ।\nवनस्पतीनां सर्वेषां प्लक्षमेव पितामहः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000355018, "chapter_id": 20355, "verse_number": "२-२७-१९", "content_sanskrit": "एवं राज्यानि सर्वाणि संस्थाप्य च पितामहः ।\nदिशापालांस्ततो ब्रह्मा स्थापयामास सत्तमः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000355019, "chapter_id": 20355, "verse_number": "२-२७-२०", "content_sanskrit": "वैराजस्य तथा पुत्रं पूर्वस्यां दिशि सत्तमः ।\nसुधन्वानं दिशःपालं राजानं सोभ्यषिंचत॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000355020, "chapter_id": 20355, "verse_number": "२-२७-२१", "content_sanskrit": "दक्षिणस्यां महात्मानं कर्दमस्य प्रजापतेः ।\nपुत्रं शंखपदं नाम राजानं सोभ्यषिंचत॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000355021, "chapter_id": 20355, "verse_number": "२-२७-२२", "content_sanskrit": "पश्चिमायां तथा ब्रह्मा वरुणस्य प्रजापतेः ।\nपुत्रं च पुष्करं नाम सोऽभ्यषिंचत्प्रजापतिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000355022, "chapter_id": 20355, "verse_number": "२-२७-२३", "content_sanskrit": "उत्तरस्यां दिशि ब्रह्म नलकूबरमेव च ।\nएवं चैवाभ्यषिंचच्च दिक्पालान्समहौजसः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000355023, "chapter_id": 20355, "verse_number": "२-२७-२४", "content_sanskrit": "यैरियं पृथिवी सर्वा सप्तद्वीपा सपत्तना ।\nयथाप्रदेशमद्यापि धर्मेण प्रतिपाल्यते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000355024, "chapter_id": 20355, "verse_number": "२-२७-२५", "content_sanskrit": "पृथुश्चैवं महाभागः सोभिषिक्तो नराधिपः ।\nराजसूयादिभिः सर्वैरभिषिक्तो महामखैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000355025, "chapter_id": 20355, "verse_number": "२-२७-२६", "content_sanskrit": "विधिना वेददृष्टेन राजराज्ये महीपतिः ।\nचाक्षुषे नाम्नि संपुण्ये अतीते च महौजसि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000355026, "chapter_id": 20355, "verse_number": "२-२७-२७", "content_sanskrit": "मन्वंतरे महाभाग देवपुण्यहितैषिणि ।\nततो वैवस्वतायैव मनवे राज्यमादिशत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000355027, "chapter_id": 20355, "verse_number": "२-२७-२८", "content_sanskrit": "विस्तरं चापि व्याख्यास्ये पृथोश्चैव महात्मनः ।\nयदि मामेव विप्रेन्द्र शुश्रूषसि अतंद्रितः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000355028, "chapter_id": 20355, "verse_number": "२-२७-२९", "content_sanskrit": "एतदेवमधिष्ठानं महत्पुण्यं प्रकीर्तितम् ।\nसर्वेष्वेव पुराणेषु एतद्धि निश्चितं सदा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000355029, "chapter_id": 20355, "verse_number": "२-२७-३०", "content_sanskrit": "पुण्यं यशस्यमायुष्यं स्वर्गवासकरं शुभम् ।\nधन्यं पवित्रमायुष्यं पुत्रदं वृद्धिदायकम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000355030, "chapter_id": 20355, "verse_number": "२-२७-३१", "content_sanskrit": "यः शृणोति नरो भक्त्या भावध्यानसमन्वितः ।\nअश्वमेधफलं तस्य जायते नात्र संशयः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]