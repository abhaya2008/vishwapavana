[{"id": 2070214, "chapter_id": 2471, "verse_number": "११-५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070215, "chapter_id": 2471, "verse_number": "११-५-१", "content_sanskrit": "यदिदं धर्मगहनं बुद्ध्या समनुबुध्यते।\nएतद्विस्तरतः सर्वं बुद्धिमार्गं प्रशंस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070216, "chapter_id": 2471, "verse_number": "११-५-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070217, "chapter_id": 2471, "verse_number": "११-५-२", "content_sanskrit": "अत्र ते सर्वयिष्यामि नमस्कृत्वा स्वयम्भुवे।\nयथा संसारगहनं वदन्ति परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070218, "chapter_id": 2471, "verse_number": "११-५-३", "content_sanskrit": "कश्चिन्महति कान्तारे वर्तमानो द्विजः किल॥\nमहद्दुर्गमनुप्राप्तो वनं क्रव्यादसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070219, "chapter_id": 2471, "verse_number": "११-५-४", "content_sanskrit": "सिंहव्याघ्रगजर्क्षौघैरतिघोरमहास्वनैः।\nपिशितादैरतिभयैर्महोग्राकृतिभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070220, "chapter_id": 2471, "verse_number": "११-५-५", "content_sanskrit": "समन्तात्सम्परिक्षिप्तं यस्माद्द्रष्टुर्महद्भयम्।\nतदस्य दृष्ट्वा हृदयमुद्वेगमगमत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070221, "chapter_id": 2471, "verse_number": "११-५-६", "content_sanskrit": "अभ्युच्छ्रयन्ति रमाणि विक्रियाश्च परन्तप।\nस तद्वनं व्यनुसरन्सम्प्रधावन्नितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070222, "chapter_id": 2471, "verse_number": "११-५-७", "content_sanskrit": "वीक्षमाणो दिशः सर्वाः शरणं क्व भवेदिति।\nस तेषां नाशमन्विच्छन्प्रद्रुतो भयपीडितः।\nन च निर्याति वै दूरं न वा तैर्विप्रयुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070223, "chapter_id": 2471, "verse_number": "११-५-८", "content_sanskrit": "अथापश्यद्वनं गूढं समन्ताद्वागुरावृतम्।\nबाहुभ्यां सम्परिष्वक्तः स्त्रिया परमघोरया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070224, "chapter_id": 2471, "verse_number": "११-५-९", "content_sanskrit": "पञ्चशीर्षधरैर्नागैः शैलैरिव समुन्नतैः।\nनभःस्पृशैर्महावृक्षैः परिक्षिप्तं महावनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070225, "chapter_id": 2471, "verse_number": "११-५-१०", "content_sanskrit": "वनमध्ये च तत्राभूदुदपानः समावृतः।\nवल्लीभिस्तृणनद्धाभिर्गूढाभिरभिसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070226, "chapter_id": 2471, "verse_number": "११-५-११", "content_sanskrit": "पपात स द्विजस्तत्र निगूढे सलिलाशये।\nविलग्नश्चाभवत्तस्मिँल्लतासन्तानसङ्कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070227, "chapter_id": 2471, "verse_number": "११-५-१२", "content_sanskrit": "पनसस्य यथा जातं वृन्तबद्धं महाफलम्।\nस तथा लम्बते तत्र ह्यूर्ध्वपादो ह्यधः शिराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070228, "chapter_id": 2471, "verse_number": "११-५-१३", "content_sanskrit": "अथ तत्रापि चान्योऽस्य भूयो जात उपद्रवः।\nकूपमध्ये महानागमपश्यत महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070229, "chapter_id": 2471, "verse_number": "११-५-१४", "content_sanskrit": "कूपपीनाहवेलायामपश्यत् महागजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070230, "chapter_id": 2471, "verse_number": "११-५-१५", "content_sanskrit": "षड्वक्त्रं कृष्णशबलं द्विषट्कपदचारिणम्।\nक्रमेण परिसर्पन्तं वल्लीवृक्षसमावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070231, "chapter_id": 2471, "verse_number": "११-५-१६", "content_sanskrit": "तस्य शाखाप्रशाखासु वृक्षशाखावलम्बिनः।\nनानारूपा मधुकरा घोररूपा भयावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070232, "chapter_id": 2471, "verse_number": "११-५-१७", "content_sanskrit": "आसते मधु संवृत्य पूर्वमेव निकेतजाः।\nभूयोभूयः समीहन्ते मधूनि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070233, "chapter_id": 2471, "verse_number": "११-५-१८", "content_sanskrit": "स्वादनीयानि भूतानां यैर्बालो न वितृप्यते।\nतेषां मधूनां बहुधा धारा प्रस्रवते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070234, "chapter_id": 2471, "verse_number": "११-५-१९", "content_sanskrit": "आलम्बमानः स पुमान्धारां पिबति सर्वदा।\nन चास्य तृष्णा विरता पिबमानस्य सङ्कटे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070235, "chapter_id": 2471, "verse_number": "११-५-२०", "content_sanskrit": "अभीप्सति च तां नित्यमतृप्तः स पुनः पुनः।\nन चास्य जीविते राजन्निर्वेदः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070236, "chapter_id": 2471, "verse_number": "११-५-२१", "content_sanskrit": "तत्रैव च मनुष्यस्य जीविताशा प्रतिष्ठिता।\nकृष्णाः श्वेताश्च तं वृक्षं निकृन्तन्ति स्म मूषिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070237, "chapter_id": 2471, "verse_number": "११-५-२२", "content_sanskrit": "व्यालैश्च तद्वनं दुर्गं स्त्रिया च परमोग्रया।\nकूपाधस्ताच्च नागेन पीनाहे कुञ्जरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070238, "chapter_id": 2471, "verse_number": "११-५-२३", "content_sanskrit": "वृक्षप्रपाताच्च भयं मूषिकेभ्यश्च पञ्चमम्।\nमधुलोभान्मधुकरैः षष्ठमाहुर्महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070239, "chapter_id": 2471, "verse_number": "११-५-२४", "content_sanskrit": "एवं स वसते तत्र क्षिप्तः संसारसागरे।\nन चैव जीविताशायां निर्वेदमुपगच्छति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070240, "chapter_id": 2471, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि पञ्चमोऽध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]