[{"id": 7002001000, "chapter_id": 22001, "verse_number": "४६-१", "content_sanskrit": "भगवानुवाच ।\nशालग्रामादिमूर्त्तिश्च वक्षयेहं भुक्तिमुक्तिदाः ।\nवासुदेवोऽसितो द्वारे शिलालग्नद्विचक्रकः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002001001, "chapter_id": 22001, "verse_number": "४६-२", "content_sanskrit": "ज्ञेयः सङ्कर्षणो लग्नद्विचक्रो रक्त उत्तमः ।\nसूक्ष्मचक्रो बहुच्छिद्रः प्रद्युम्नो नीलदीर्घकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002001002, "chapter_id": 22001, "verse_number": "४६-३", "content_sanskrit": "पीतोनिरुद्धः पद्माङ्को वर्त्तुलो द्वित्रिरेखवान् ।\nकृष्णो नारायणो नाभ्युन्नतः शुषिरदीर्घवान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002001003, "chapter_id": 22001, "verse_number": "४६-४", "content_sanskrit": "परमेष्ठी साब्जचक्रः पृष्ठच्छिद्रश्च विन्दुमान् ।\nस्थूलचक्रोऽसितो विष्णुर्मध्ये रेखा गदाकृतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002001004, "chapter_id": 22001, "verse_number": "४६-५", "content_sanskrit": "नृसिंहः कपिलः स्थूलचक्रः स्यात् पञ्चविन्दुकः ।\nवराहः शक्तिलिङ्गः स्यात् तच्चक्रौ विषमौ मृतौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002001005, "chapter_id": 22001, "verse_number": "४६-६", "content_sanskrit": "इन्द्रनीलनिभः स्थूलस्त्रिरेखालाञ्छितः शुभः ।\nकूर्मस्तथोन्नतः पृष्ठे वर्त्तलावर्त्तकोऽसितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002001006, "chapter_id": 22001, "verse_number": "४६-७", "content_sanskrit": "हयग्रीवोङ्कुशाकाररेखो नीलः सविन्दुकः ।\nवैकुण्ठः एकचक्रोऽब्जी मणिभः पुच्छरेखकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002001007, "chapter_id": 22001, "verse_number": "४६-८", "content_sanskrit": "मत्स्यो दीर्घस्त्रिविन्दुः स्यात् काचवर्णस्तु पूरितः ।\nश्यामस्त्रिविक्रमो दक्षरेखस्तु वर्त्तुलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002001008, "chapter_id": 22001, "verse_number": "४६-९", "content_sanskrit": "वामनो वर्त्तुलश्चातिह्रस्वो नीलः सविन्दुकः ।\nश्यामस्त्रिविक्रमो दक्षरेखो वामेन विन्दुकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002001009, "chapter_id": 22001, "verse_number": "४६-१०", "content_sanskrit": "अनन्तो नागभोगाङ्गो नैकाभो नैकमूर्त्तिमान् ।\nस्थूलो दामोदरो मध्यचक्रो द्वाः सूक्ष्मविन्दुकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002001010, "chapter_id": 22001, "verse_number": "४६-११", "content_sanskrit": "सुदर्शनस्त्वेकचक्रो लक्ष्मीनारायणो द्वयात् ।\nचित्रक्रश्चाच्युतो देवस्त्रिचक्रो वा त्रिविक्रमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002001011, "chapter_id": 22001, "verse_number": "४६-१२", "content_sanskrit": "जनार्द्दनश्चतुस्चक्रो वासुदेवस्च पञ्चभिः ।\nषट्रचक्रस्चौव प्रद्युम्नः सङ्कर्षणश्च सप्तभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002001012, "chapter_id": 22001, "verse_number": "४६-१३", "content_sanskrit": "पुरुषोत्तमोष्टचक्रो नवव्यूहो नवाङ्कितः ।\nदशावतारो दशभिर्द्दशैकेनानिरुद्धकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002001013, "chapter_id": 22001, "verse_number": "४६-१४", "content_sanskrit": "द्वाधशात्मा द्वादशभिरत ऊद्र्ध्वमनन्तकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]