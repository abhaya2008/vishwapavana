[{"id": 7003056000, "chapter_id": 23056, "verse_number": "३-३६-१", "content_sanskrit": "नारायण उवाच ।\nमत्स्यराजे निपतिते राजा युद्धविशारदः ।\nराजेन्द्रान्प्रेषयामास युद्धे शस्त्रविशारदान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003056001, "chapter_id": 23056, "verse_number": "३-३६-२", "content_sanskrit": "बृहद्बलं सोमदत्तं विदर्भं मिथिलेश्वरम् ।\nनिषधाधिपतिं चैव मगधाधिपतिं तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003056002, "chapter_id": 23056, "verse_number": "३-३६-३", "content_sanskrit": "आययुः समरे योद्धुं जामदग्न्यं महारथाः ।\nत्रितयाक्षौहिणीभिश्च सेनाभिः सह नारद ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003056003, "chapter_id": 23056, "verse_number": "३-३६-४", "content_sanskrit": "रामस्य भ्रातरः सर्वे वीरास्तीक्ष्णास्त्रपाणयः  ।\nवारयामासुरस्त्रैश्च तानेव रणमूर्द्धनि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003056004, "chapter_id": 23056, "verse_number": "३-३६-५", "content_sanskrit": "ते वीराः शरजालेन दिव्यास्त्रेण प्रयत्नतः ।\nवारयामासुरेकैकं भ्रातृवर्गान्भृगोस्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003056005, "chapter_id": 23056, "verse_number": "३-३६-६", "content_sanskrit": "आययौ समरे शीघ्रं दृष्ट्वा तांश्च पराजितान् ।\nपिनाकहस्तः स भृगुर्ज्वलदग्निशिखोपमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003056006, "chapter_id": 23056, "verse_number": "३-३६-७", "content_sanskrit": "चिक्षेप नागपाशं च जामदग्न्यो महाबलः ।\nचिच्छेद तं गारुडेन सोमदत्तो महाबलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003056007, "chapter_id": 23056, "verse_number": "३-३६-८", "content_sanskrit": "भृगुः शङ्करशूलेन सोमदत्तं जघान ह ।\nबृहद्बलं च गदया विदर्भं मुष्टिभिस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003056008, "chapter_id": 23056, "verse_number": "३-३६-९", "content_sanskrit": "मैथिलं मुद्गरेणैव शक्त्या वै नैषधं तथा ।\nमागधं चरणोद्घातैरस्त्रजालेन सैनिकान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003056009, "chapter_id": 23056, "verse_number": "३-३६-१०", "content_sanskrit": "निहत्य निखिलान्भूपान्संहाराग्निसमो रणे ।\nदुद्राव कार्त्तवीर्यं च जामदग्न्यो महाबलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003056010, "chapter_id": 23056, "verse_number": "३-३६-११", "content_sanskrit": "दृष्ट्वा तं योद्धुमायान्तं राजानश्च महारथा ।\nआययुः  समरं कर्त्तुं कार्त्तवीर्य्यं निवार्य्य च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003056011, "chapter_id": 23056, "verse_number": "३-३६-१२", "content_sanskrit": "कान्यकुब्जाश्च शतशः सौराष्ट्राः शतशस्तथा ।\nराष्ट्रीयाः शतशश्चैव वीरेन्द्राः शतशस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003056012, "chapter_id": 23056, "verse_number": "३-३६-१३", "content_sanskrit": "&nbsp;सौम्या वाङ्गाश्च शतशो महाराष्ट्रास्तथा दश ।\nतथा गुर्जरजातीयाः कलिङ्गाः शतशस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003056013, "chapter_id": 23056, "verse_number": "३-३६-१४", "content_sanskrit": "कृत्वा तु शरजालं च भृगुश्चिच्छेद तत्क्षणम् ।\nतं छित्त्वाऽभ्युत्थितो रामो नीहारमिव भास्करः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003056014, "chapter_id": 23056, "verse_number": "३-३६-१५", "content_sanskrit": "त्रिरात्रं युयुधे रामस्तैः सार्द्धं समराजिरे ।\nद्वादशाक्षौहिणीं सेनां तथा चिच्छेद पर्शुना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003056015, "chapter_id": 23056, "verse_number": "३-३६-१६", "content_sanskrit": "रम्भास्तम्भसमूह च यथा खड्गेन लीलया ।\nछित्त्वा सेनां भूपवर्गं जघान शिवशूलतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003056016, "chapter_id": 23056, "verse_number": "३-३६-१७", "content_sanskrit": "सर्वांस्तान्निहतान्दृष्ट्वा सूर्य्यवंशसमुद्भवः ।\nआजगाम सुचन्द्रश्च लक्ष राजेन्द्रसंयुतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003056017, "chapter_id": 23056, "verse_number": "३-३६-१८", "content_sanskrit": "द्वादशाक्षौहिणीभिश्च सेनाभिः सह संयुगे ।\nकोपेन युयुधे रामं सिंहं सिंहो यथा रणे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003056018, "chapter_id": 23056, "verse_number": "३-३६-१९", "content_sanskrit": "भृगुः शङ्करशूलेन नृपलक्षं निहत्य च ।\nद्वादशाक्षौहिणीं सेनामहन्वै पर्शुना बली ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003056019, "chapter_id": 23056, "verse_number": "३-३६-२०", "content_sanskrit": "निहत्य सर्वाः सेनाश्च सुचन्द्रं युयुधे बली ।\nनागास्त्रं प्रेरयामास निहृतं तं भृगुः स्वयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003056020, "chapter_id": 23056, "verse_number": "३-३६-२१", "content_sanskrit": "नागपाशं च चिच्छेद गारुडेन नृपेश्वरः ।\nजहास च भृगुं राजा समरे च पुनः पुनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003056021, "chapter_id": 23056, "verse_number": "३-३६-२२", "content_sanskrit": "भृगुर्नारायणास्त्रं च चिक्षेप रणमूर्धनि ।\nअस्तं ययौ तं निहन्तुं शतसूर्यसमप्रभम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003056022, "chapter_id": 23056, "verse_number": "३-३६-२३", "content_sanskrit": "दृष्ट्वाऽस्त्रं नृपशार्दूलश्चावरुह्य रथात्क्षणात् ।\nन्यस्तशस्त्रः प्राणमच्च स्तुत्वा नारायणं शिवम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003056023, "chapter_id": 23056, "verse_number": "३-३६-२४", "content_sanskrit": "तमेव प्रणतं त्यक्त्वा ययौ नारायणान्तिकम् ।\nअस्त्रराजो भगवतो रामः संप्राप विस्मयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003056024, "chapter_id": 23056, "verse_number": "३-३६-२५", "content_sanskrit": "भृगुः शक्तिं च मुसलं तोमरं पट्टिशं तथा ।\nगदां पर्शुं च कोपेन चिक्षिपे तज्जिघांसया ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003056025, "chapter_id": 23056, "verse_number": "३-३६-२६", "content_sanskrit": "जग्राह काली तान्सर्वान्सुचन्द्रस्यन्दनस्थिता ।\nचिक्षेप शिवशूलं स नृपमाल्यं बभूव तत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003056026, "chapter_id": 23056, "verse_number": "३-३६-२७", "content_sanskrit": "ददर्श पुरतो रामो भद्रकालीं जगत्प्रसूम् ।\nवहन्तीं मुण्डमालां च विकटास्यां भयंकरीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003056027, "chapter_id": 23056, "verse_number": "३-३६-२८", "content_sanskrit": "विहाय शस्त्रमस्त्रं च पिनाकं च भृगुस्तदा ।\nतुष्टाव तां महामायां भक्तिनम्रात्मकन्धरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003056028, "chapter_id": 23056, "verse_number": "३-३६-२९", "content_sanskrit": "परशुराम उवाच ।\nनमः शङ्करकान्तायै सारायै ते नमो नमः ।\nनमो दुर्गतिनाशिन्यै मायायै ते नमो नमः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003056029, "chapter_id": 23056, "verse_number": "३-३६-३०", "content_sanskrit": "नमो नमो जगद्धात्र्यै जगत्कर्त्र्यै नमोनमः ।\nनमोऽस्तु ते जगन्मात्रे कारणायै नमो नमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003056030, "chapter_id": 23056, "verse_number": "३-३६-३१", "content_sanskrit": "प्रसीद जगतां मातः सृष्टिसंहारकारिणि ।\nत्वत्पादौ शरणं यामि प्रतिज्ञां सार्थिकां कुरु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003056031, "chapter_id": 23056, "verse_number": "३-३६-३२", "content_sanskrit": "त्वयि मे विमुखायां च को मां रक्षितुमीश्वरः ।\nत्वं प्रसन्ना भव शुभे मां भक्तं भक्तवत्सले ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003056032, "chapter_id": 23056, "verse_number": "३-३६-३३", "content_sanskrit": "युष्माभिः शिवलोके च मह्यं दत्तो वरः पुरा ।\nतं वरं सफलं कर्तुं त्वमर्हसि वरानने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003056033, "chapter_id": 23056, "verse_number": "३-३६-३४", "content_sanskrit": "रेणुकेयस्तवं श्रुत्वा प्रसन्नाऽभवदम्बिका ।\nमा भैरित्येवमुक्त्वा तु तत्रैवान्तरधीयत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003056034, "chapter_id": 23056, "verse_number": "३-३६-३५", "content_sanskrit": "एतद्भृगुकृतं स्तोत्रं भक्तियुक्तश्च यः पठेत् ।\nमहाभयात्समुत्तीर्णः स भवेदेव लीलया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003056035, "chapter_id": 23056, "verse_number": "३-३६-३६", "content_sanskrit": "स पूजितश्च त्रैलोक्ये तत्रैव विजयी भवेत् ।\nज्ञानिश्रेष्ठो भवेच्चैव वैरिपक्षविमर्दकः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003056036, "chapter_id": 23056, "verse_number": "३-३६-३७", "content_sanskrit": "एतस्मिन्नन्तरे ब्रह्मा भृगुं धर्मभृतां वरम् ।\nआगत्य कथयामास रहस्यं राममेव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003056037, "chapter_id": 23056, "verse_number": "३-३६-३८", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु राम महाभाग रहस्यं पूर्वमेव च ।\nसुचन्द्रजयहेतुं च प्रतिज्ञाफलमेव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003056038, "chapter_id": 23056, "verse_number": "३-३६-३९", "content_sanskrit": "दशाक्षरी महाविद्या दत्ता दुर्वाससा पुरा ।\nसुचन्द्रायैव कवचं भद्रकाल्याः सुदुर्लभम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003056039, "chapter_id": 23056, "verse_number": "३-३६-४०", "content_sanskrit": "कवचं भद्रकाल्याश्च देवानां च सुदुर्लभम् ।\nकवचं तद्गले यस्य सर्वशत्रुविमर्दकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003056040, "chapter_id": 23056, "verse_number": "३-३६-४१", "content_sanskrit": "अतीव पूज्यं शस्तं च त्रैलोक्यजयकारणम ।\nतस्मिन्स्थिते च कवचे कस्त्वं जेतुमलं भुवि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003056041, "chapter_id": 23056, "verse_number": "३-३६-४२", "content_sanskrit": "भृगो गच्छतु भिक्षार्थं करोतु प्रार्थनां नृपम् ।\nसूर्य्यवंशोद्भवो राजा दाता परमधार्मिकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003056042, "chapter_id": 23056, "verse_number": "३-३६-४३", "content_sanskrit": "प्राणांश्च कवचं मन्त्रं सर्वं दास्यति निश्चितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003056043, "chapter_id": 23056, "verse_number": "३-३६-४४", "content_sanskrit": "भृगुः संन्यासिवेषेण गत्वा राजान्तिकं मुने ।\nभिक्षां चकार मन्त्रं च कवचं परमाद्भुतम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003056044, "chapter_id": 23056, "verse_number": "३-३६-४५", "content_sanskrit": "राजा ददौ च तन्मन्त्रं कवचं परमादरात् ।\nततः शङ्करशूलेन तं जघान नृपं भृगुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]