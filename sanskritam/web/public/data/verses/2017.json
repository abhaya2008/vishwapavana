[{"id": 2045830, "chapter_id": 2017, "verse_number": "६-६६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045831, "chapter_id": 2017, "verse_number": "६-६६-१", "content_sanskrit": "ततः स भगवान्देवो लोकानामीश्वरेश्वरः।\nब्रह्माणं प्रत्युवाचेदं स्रिग्धगम्भीरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045832, "chapter_id": 2017, "verse_number": "६-६६-२", "content_sanskrit": "विदितं तात योगान्मे सर्वमेतत्तवेप्सितम् ।\nतथा तद्भवितेत्युक्त्वा तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045833, "chapter_id": 2017, "verse_number": "६-६६-३", "content_sanskrit": "ततो देवर्षिगन्धर्वा विस्मयं परमं गताः ।\nकौतूहलपराः सर्वे पितामहमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045834, "chapter_id": 2017, "verse_number": "६-६६-४", "content_sanskrit": "कोन्वयं यो भगवता प्रणम्य विनयाद्विभो ।\nवाग्भिः स्तुतो वरिष्ठाभिः श्रोतुमिच्छाम तं वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045835, "chapter_id": 2017, "verse_number": "६-६६-५", "content_sanskrit": "एवमुक्तस्तु भगवान्प्रत्युवाच पितामहः ।\nदेवब्रह्मर्षिगन्धर्वान्सर्वान्मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045836, "chapter_id": 2017, "verse_number": "६-६६-६", "content_sanskrit": "यत्तत्परं भविष्यं च भवितव्यं च यत्परम् ।\nभूतात्मा च प्रभुश्चैव ब्रह्म यच्च परं पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045837, "chapter_id": 2017, "verse_number": "६-६६-७", "content_sanskrit": "तेनास्मि कृतसंवादः प्रसन्नेन सुरर्षभाः ।\nजगतोऽनुग्रहार्थाय याचितो मे जगत्पतिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045838, "chapter_id": 2017, "verse_number": "६-६६-८", "content_sanskrit": "मानुषं लोकमातिष्ठ वासुदेव इति श्रुतः ।\nअस्रुराणां वधार्थाय संभवस्व महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045839, "chapter_id": 2017, "verse_number": "६-६६-९", "content_sanskrit": "संग्रामे निहता ये ते दैत्यदानवराक्षसाः ।\nत इमे नृषु संभूता घोररूपा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045840, "chapter_id": 2017, "verse_number": "६-६६-१०", "content_sanskrit": "तेषां वधार्थं भगवान्नरेण सहितो वशी ।\nमानुषीं योनिमास्थाय चरिष्यति महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045841, "chapter_id": 2017, "verse_number": "६-६६-११", "content_sanskrit": "नरनारायणौ यौ तौ पुराणावृषिसत्तमौ ।\nसहितो मानुषे लोके संभूतावमितद्युती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045842, "chapter_id": 2017, "verse_number": "६-६६-१२", "content_sanskrit": "अजेयौ समरे यत्तौ सहितैरमरैरपि ।\nमूढास्त्वेतौ न जानन्ति नरनारायणावृषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045843, "chapter_id": 2017, "verse_number": "६-६६-१३", "content_sanskrit": "तस्याहमग्रजः पुत्रः सर्वस्य जगतः प्रभुः ।\nवासुदेवोऽर्चनीयो वः सर्वलोकमहेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045844, "chapter_id": 2017, "verse_number": "६-६६-१४", "content_sanskrit": "तथा मनुष्योऽयमिति कदाचित्सुरसत्तमाः ।\nनावज्ञेयो महावीर्यः शङ्खचक्रगदाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045845, "chapter_id": 2017, "verse_number": "६-६६-१५", "content_sanskrit": "एतत्परमकं गुह्यमेतत्परमकं पदम् ।\nएतत्परमकं ब्रह्म एतत्परमकं यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045846, "chapter_id": 2017, "verse_number": "६-६६-१६", "content_sanskrit": "एतदक्षरमव्यक्तमेतद्वै शाश्वतं महः ।\nयत्तत्पुरुषसंज्ञं वै गीयते ज्ञायते न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045847, "chapter_id": 2017, "verse_number": "६-६६-१७", "content_sanskrit": "एतत्परमकं तेज एतत्परमकं सुखम्।\nएतत्परमकं सत्यं कीर्तितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045848, "chapter_id": 2017, "verse_number": "६-६६-१८", "content_sanskrit": "तस्मात्सेन्द्रैः सुरैः सर्वैर्लोकैश्चामितविक्रमःक ।\nनावज्ञेयो वासुदेवो मानुषोऽयमिति प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045849, "chapter_id": 2017, "verse_number": "६-६६-१९", "content_sanskrit": "यश्च मानुषमात्रोऽयमिति ब्रूयात्स मन्दधीः ।\nहृषीकेशमवज्ञानात्तमाहुः पुरुषाधमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045850, "chapter_id": 2017, "verse_number": "६-६६-२०", "content_sanskrit": "योगिनं तं महात्मानं प्रविष्टं मानुषीं तनुम् ।\nअवमन्येद्वासुदेवं तमाहुस्तमसं जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045851, "chapter_id": 2017, "verse_number": "६-६६-२१", "content_sanskrit": "देवं चराचरात्मानं श्रीवत्साङ्कं सुवर्चसम्।\nपद्मनाभं न जानाति तमाहुस्तामसं बुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045852, "chapter_id": 2017, "verse_number": "६-६६-२२", "content_sanskrit": "किरीटकौस्तुभधरं मित्राणामभयंकरम्।\nअवजानन्महात्मानं घोरे तमसि मञ्जति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045853, "chapter_id": 2017, "verse_number": "६-६६-२३", "content_sanskrit": "एवं विदित्वा तत्त्वार्थं लोकानामीश्वरेश्वरः ।\nवासुदेवो नमस्कार्यः सर्वलोकैः सुरोत्तमाः ।\nतस्यामहात्माजो ब्रह्मा सर्वस्य जगतः पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045854, "chapter_id": 2017, "verse_number": "६-६६-२४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045855, "chapter_id": 2017, "verse_number": "६-६६-२४", "content_sanskrit": "एवमुक्त्वा स भगवान्देवान्सर्षिगकणान्पुरा।\nविसृज्य सर्वभूतानि जगाम भवनं स्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045856, "chapter_id": 2017, "verse_number": "६-६६-२५", "content_sanskrit": "ततो देवाः सगन्धर्वा मुनयोऽप्सरसोऽपि च।\nकथां तां ब्रह्मणा गीतां श्रुत्वा प्रीता दिवं ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045857, "chapter_id": 2017, "verse_number": "६-६६-२६", "content_sanskrit": "एतच्छ्रुतं मया तात ऋषीणां भावितात्मनाम्।\nवासुदेवं कथयतां समवाये पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045858, "chapter_id": 2017, "verse_number": "६-६६-२७", "content_sanskrit": "रामस्य जामदग्न्यस्य मार्कण्डेयस्य धीमतः ।\nव्यासनारदयोश्चापि सकाशाद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045859, "chapter_id": 2017, "verse_number": "६-६६-२८", "content_sanskrit": "एतमर्थं च विज्ञाय श्रुत्वा च प्रभुमव्ययम् ।\nवासुदेवं महात्मानं लोकानामीश्वरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045860, "chapter_id": 2017, "verse_number": "६-६६-२९", "content_sanskrit": "यस्य चैवात्मजो ब्रह्मा सर्वस्य जगतः पिता ।\nकथं न वासुदेवोऽयमर्च्यश्चेज्यश्च मानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045861, "chapter_id": 2017, "verse_number": "६-६६-३०", "content_sanskrit": "वारितोऽसि मया तात मुनिर्भिर्वेदपारगैः ।\nमा गच्छ संयुगं तेन वासुदेवेन धन्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045862, "chapter_id": 2017, "verse_number": "६-६६-३१", "content_sanskrit": "मा पाण्डवैः सार्धमिति तत्त्वं मोहान्न बुध्यसे।\nमन्ये त्वां राक्षसं क्रूरं तथा चासि तमोवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045863, "chapter_id": 2017, "verse_number": "६-६६-३२", "content_sanskrit": "यस्माद्द्विषसि गोविन्दं पाण्डवं तं धनञ्जयम् ।\nनरनारायणौ देवी कोऽन्यो द्विष्याद्धि मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045864, "chapter_id": 2017, "verse_number": "६-६६-३३", "content_sanskrit": "तस्माद्ब्रवीमि ते राजन्नेष वै शाश्वतोऽव्ययः ।\nसर्कवलोकमयो नित्यः शास्ता धाता धरो ध्रुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045865, "chapter_id": 2017, "verse_number": "६-६६-३४", "content_sanskrit": "यो धारयति लोकांस्त्रींश्चराचरगुरुः प्रभुः ।\nयोद्धा जयश्च जेता च सर्वप्रकृतिरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045866, "chapter_id": 2017, "verse_number": "६-६६-३५", "content_sanskrit": "राजन्सर्वमयो ह्येष तमोरागविवर्जितः ।\nयतः कृष्णस्ततो धर्मो यतो धर्मस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045867, "chapter_id": 2017, "verse_number": "६-६६-३६", "content_sanskrit": "तस्य माहात्म्ययोगेन योगेनात्ममयेन च ।\nधृताः पाण्डुसुता राजञ्जयश्चैषां भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045868, "chapter_id": 2017, "verse_number": "६-६६-३७", "content_sanskrit": "श्रेयोयुक्तां सदा बुद्धिं पाण़्डवानां दधाति यः।\nबलं चैव रणे नित्यं भयेभ्यश्चैव रक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045869, "chapter_id": 2017, "verse_number": "६-६६-३८", "content_sanskrit": "स एष शाश्वतो देवाः सर्वगुह्यमयः शिवः ।\nवासुदेव इति ज्ञेयो यन्मां पृच्छसि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045870, "chapter_id": 2017, "verse_number": "६-६६-३९", "content_sanskrit": "ब्राह्मणैः क्षत्रिकयैर्वैश्यैः शूद्रैश्च कृतलक्षणैः ।\nसेव्यतेऽभ्यर्च्यते चैव नित्ययुक्तैः स्वकर्मभिःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045871, "chapter_id": 2017, "verse_number": "६-६६-४०", "content_sanskrit": "द्वापरस्य युगस्यान्ते आदौ कलियुगस्य च।\nसात्वतं विधिमास्थाय गीतः संकर्षणेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045872, "chapter_id": 2017, "verse_number": "६-६६-४१", "content_sanskrit": "स एष सर्वं सुरमर्त्यलोकं\nसमुद्रकक्ष्यान्तरितां पुरीं च।\nयुगेयुगे मानुषं चैव वासं\nपुनःपुनः सृजते वासुदेवाःक ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045873, "chapter_id": 2017, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि षट्षष्टितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-६६-३९ कृतलक्षणैः स्वस्वगुणप्रख्यातैः ॥ ६-६६-४० सात्वताः पञ्चरात्रागमविधिना पूजकास्तदीयं सात्वतम् ॥ ६-६६-४१ कक्ष्या काञ्ची। पुरीं द्वारकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]