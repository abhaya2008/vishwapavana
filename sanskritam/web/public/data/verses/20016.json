[{"id": 7000016000, "chapter_id": 20016, "verse_number": "१६-१", "content_sanskrit": "तत्रादौ सत्राजिदुपाख्यानवर्णनम् लोमहर्षण उवाच भजमानस्य पुत्रोऽथ रथमुख्यो विदूरथः ।\nराजाधिदेवः शूरस्तु विदूरथसुतोऽभवत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000016001, "chapter_id": 20016, "verse_number": "१६-२", "content_sanskrit": "राजाधिदेवस्य सुता जज्ञिरे वीर्य्यवत्तराः ।\nदत्तातिदत्तौ बलिनौ शोणाश्वः श्वेतवाहनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000016002, "chapter_id": 20016, "verse_number": "१६-३", "content_sanskrit": "शमी च दण्डशर्म्मा च दन्तशत्रुश्च शत्रुजित् ।\nश्रवणा च श्रविष्ठा च स्वसारौ सम्बभूवतुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000016003, "chapter_id": 20016, "verse_number": "१६-४", "content_sanskrit": "शमिपुत्रः प्रतिक्षत्रः प्रतिक्षत्रस्य चात्मजः ।\nस्वयम्भोजः स्वयम्भोजाद्भदिकः सम्बभूव ह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000016004, "chapter_id": 20016, "verse_number": "१६-५", "content_sanskrit": "तस्य पुत्रा बभूवुर्हि सर्व्वे भीमपराक्रमाः ।\nकृतवर्म्माग्रजस्तेषां शतधन्वा तु मध्यमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000016005, "chapter_id": 20016, "verse_number": "१६-६", "content_sanskrit": "देवान्तश्च नरान्तश्च भिषग्वैतरणश्च यः ।\nसुदान्तश्चादिदान्तश्च निकाश्यः कामदम्भकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000016006, "chapter_id": 20016, "verse_number": "१६-७", "content_sanskrit": "देवान्तस्याभवत् पुत्रो विद्वान् कम्बलबर्हिषः ।\nअसमौजाः सुतस्तस्य नासमौजाश्च तावुभौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000016007, "chapter_id": 20016, "verse_number": "१६-८", "content_sanskrit": "अजातपुत्राय चसुतान् प्रददावसमौजसे ।\nसुदंष्ट्रश्च शुचारुश्च कृष्ण इत्यन्धकाः स्मृता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000016008, "chapter_id": 20016, "verse_number": "१६-९", "content_sanskrit": "गान्धारी चैव माद्री च क्रोष्टुभार्य्ये बभूवतुः ।\nगान्धारी जनयामास अनमित्रं महाबलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000016009, "chapter_id": 20016, "verse_number": "१६-१०", "content_sanskrit": "माद्री युधाजितं पुत्रं ततो वै देवमीढुषम् ।\nअनमित्रममित्राणां जेतारमपराजितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000016010, "chapter_id": 20016, "verse_number": "१६-११", "content_sanskrit": "अनमित्रसुतो निघ्नो निघ्नतो द्वौ बभूवतुः ।\nप्रसेनश्चाथ सत्राजिच्छत्रुसेनाजितावुभौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000016011, "chapter_id": 20016, "verse_number": "१६-१२", "content_sanskrit": "प्रसेनो द्वारवत्यां तु निवसन् यो महामणिम् ।\nदिव्यं स्यमन्तकं नाम स सूर्यादुपलब्धवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000016012, "chapter_id": 20016, "verse_number": "१६-१३", "content_sanskrit": "तस्य यत्राजितः सूर्य्यः यथा प्राणसमोऽभवत् ।\nस कदाचिन्निशापाये रथेन रथिनां वरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000016013, "chapter_id": 20016, "verse_number": "१६-१४", "content_sanskrit": "तोयकूलमपः स्प्रष्टुमुपस्थानुं ययौ रविम् ।\nतस्योपतिष्ठतः सूर्य्यं विवस्वानग्रतः स्थितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000016014, "chapter_id": 20016, "verse_number": "१६-१५", "content_sanskrit": "विस्पष्टमूर्त्तिर्भगवांस्तेजोमण्डलवान् विभुः ।\nअथ राजा विवस्वन्तमुवाच स्थितमग्रतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000016015, "chapter_id": 20016, "verse_number": "१६-१६", "content_sanskrit": "यथैव व्योम्नि पश्यामि सदा त्वां ज्योतिषां पते ।\nतेजोमण्डलिनं देवं तथैव पुरतः स्थितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000016016, "chapter_id": 20016, "verse_number": "१६-१७", "content_sanskrit": "को विशेषोऽस्ति मे त्वत्तः सख्येनोपगतस्य वै ।\nएतच्छ्रुत्वा तु भगवान्मणिरत्नं स्यमन्तकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000016017, "chapter_id": 20016, "verse_number": "१६-१८", "content_sanskrit": "स्वकण्ठादवमुच्याथ एकान्ते न्यस्तवान् विभुः ।\nततो विग्रहवन्तं तं ददर्श नृपतिस्तदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000016018, "chapter_id": 20016, "verse_number": "१६-१९", "content_sanskrit": "प्रीतिमानथ तं दृष्ट्वा मुहूर्त्तं कृतवान् कथाम् ।\nतमभिप्रस्थितं भूयो विवस्वन्तं स सत्रजित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000016019, "chapter_id": 20016, "verse_number": "१६-२०", "content_sanskrit": "लोकान् भासयसे सर्व्वान् भास्करस्तदा ।\nतदेतन्मणिरत्नं मे भगवन् दातुमर्हसि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000016020, "chapter_id": 20016, "verse_number": "१६-२१", "content_sanskrit": "ततः स्यमन्तकमणिं दत्तवात् भास्करस्तदा ।\nस तमाबध्य नगरीं प्रवीवेश महीपतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000016021, "chapter_id": 20016, "verse_number": "१६-२२", "content_sanskrit": "तं जनाः पर्य्यधावन्तः सूर्य्योऽयं गच्छतीति ह ।\nस्वां पुरीं स विसिष्माय राजा त्वन्तःपुरं तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000016022, "chapter_id": 20016, "verse_number": "१६-२३", "content_sanskrit": "तं प्रसेनजितं दिव्यं मणिरत्नं स्यमन्तक्रम् ।\nददौ भ्रात्रे नरपतिः प्रेम्णा सत्राजिदुत्तमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000016023, "chapter_id": 20016, "verse_number": "१६-२४", "content_sanskrit": "स मणिः स्यन्दते रुक्मं वृष्ण्यन्धकनिवेशने ।\nकालवर्षीच पर्जन्यो न च व्याधिभयं ह्मभूत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000016024, "chapter_id": 20016, "verse_number": "१६-२५", "content_sanskrit": "लिप्सां चक्रे प्रसेनस्य मणिरत्ने स्यमन्तके ।\nगोविन्दो न च तं लेभे भक्तोऽपि न जहार सः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000016025, "chapter_id": 20016, "verse_number": "१६-२६", "content_sanskrit": "कदचिन्मृगयां यातःच प्रसेनस्तेन भूषितः ।\nस्यमन्तककृते सिंहाद्वधं प्राप वनेचरात्  ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000016026, "chapter_id": 20016, "verse_number": "१६-२७", "content_sanskrit": "अथ सिंहं प्रधावन्तमृक्षराजो महाबलः ।\nनिहत्य मणिरत्नं तदादाय प्राविशद्गुहाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000016027, "chapter_id": 20016, "verse_number": "१६-२८", "content_sanskrit": "ततो वृष्ण्यन्धकाऋ कृष्णं प्रसेनवधकारणात् ।\nप्रार्थनां तां मणेर्बद्ध्वा सर्व्व एव शशङ्किरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000016028, "chapter_id": 20016, "verse_number": "१६-२९", "content_sanskrit": "स शङ्क्यमानो धर्म्मातमा अकारी तस्य कर्म्मणः ।\nआहरिष्ये मणिमिति प्रतिज्ञाय वनं ययौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000016029, "chapter_id": 20016, "verse_number": "१६-३०", "content_sanskrit": "यत्र प्रसेनो मृगयां व्याचरत्तत्र चाप्यथ ।\nप्रसेनस्य पदं गृह्य पुरुषैराप्तकारिभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000016030, "chapter_id": 20016, "verse_number": "१६-३१", "content_sanskrit": "ऋक्षवन्तं गिरिवरं विन्ध्यं च गिरिमुत्तम् ।\nअन्वेषयन् परिश्रान्तः स ददर्श महामनाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000016031, "chapter_id": 20016, "verse_number": "१६-३२", "content_sanskrit": "साश्वं हतं प्रसेनं तु नाविन्दत च तन्मणिम् ।\nअथ सिंहः प्रसेनस्य शरीरस्याविदूरतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000016032, "chapter_id": 20016, "verse_number": "१६-३३", "content_sanskrit": "ऋक्षेण निहतो दृष्टः पदैर्ऋक्षस्तु सूचितः ।\nपदैस्तैरन्वियायाथ गुहामृक्षस्य माधवः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000016033, "chapter_id": 20016, "verse_number": "१६-३४", "content_sanskrit": "स हि ऋक्षविले वाणीं शुश्राव प्रमदेरिताम् ।\nधात्र्या कुमारमादाय सुतं जाम्बवतो द्विजाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000016034, "chapter_id": 20016, "verse_number": "१६-३५", "content_sanskrit": "क्रीडयन्त्या च मणिना मा रोदीरित्यथेरिताम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000016035, "chapter_id": 20016, "verse_number": "१६-३६", "content_sanskrit": "धात्र्युवाच सिंहः प्रसेनमधीत् सिंहो जाम्बवता हतः ।\nसुकुमारक मा रोदीस्तव ह्येष स्यमन्तकः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000016036, "chapter_id": 20016, "verse_number": "१६-३७", "content_sanskrit": "व्यक्तितस्तस्य शब्दस्य तूर्णमेव बिलं ययौ ।\nप्रविश्य तत्र चभगवांस्तदुक्षबिलमञ्जसा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000016037, "chapter_id": 20016, "verse_number": "१६-३८", "content_sanskrit": "स्यापयित्वा बिलद्वारे बिले जाम्बवता सह ।\nशार्ङ्गधन्वा बिलस्थं तु जाम्बवन्तं ददर्श सः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000016038, "chapter_id": 20016, "verse_number": "१६-३९", "content_sanskrit": "युयुधे वासूदेवस्तु बिले जाम्बवता सह ।\nबाहुभ्यामेव गोविन्दो दिवसानेकविंशतिम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000016039, "chapter_id": 20016, "verse_number": "१६-४०", "content_sanskrit": "प्रविष्टेऽथ बिले कृष्णे बलदेवपुरः सराः ।\nपुरीं द्वारवतीमेत्य हतं कृष्णं न्यवेदयन् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000016040, "chapter_id": 20016, "verse_number": "१६-४१", "content_sanskrit": "वासुदेवोऽपि निर्जित्य जाम्बवन्तं महाबलम् ।\nलेभे जाम्बवतीं कन्यामृक्षराजस्य सम्मताम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000016041, "chapter_id": 20016, "verse_number": "१६-४२", "content_sanskrit": "मणिं स्यमन्तकं चैव जग्राहात्मविशुद्धये ।\nअनुनीयर्क्षराजं तु निर्ययौ च ततो बिलात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000016042, "chapter_id": 20016, "verse_number": "१६-४३", "content_sanskrit": "उपायाद्द्वारकां कृष्णः सविनीतैः पुः सरैः ।\nएवं स मणिराहृत्य विशोध्यात्मानमच्युतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000016043, "chapter_id": 20016, "verse_number": "१६-४४", "content_sanskrit": "ददौ सत्राजिते तं वै सर्वसात्त्वतसंसदि ।\nएवं मिथ्याभिशस्तेन कृष्णेनामित्रघातिना ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000016044, "chapter_id": 20016, "verse_number": "१६-४५", "content_sanskrit": "आत्मा विशोधितः पापाद्विनिर्जित्य स्यमन्तकम् ।\nसत्राजितो दशत्वासन् भार्य्यास्तासां शतं सुताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000016045, "chapter_id": 20016, "verse_number": "१६-४६", "content_sanskrit": "ख्यातिमन्तस्त्रस्तेषां भङ्गकारस्तु पूर्व्वजः ।\nवीरो वातपतिश्चैव वसुमेधस्तथेव च  ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000016046, "chapter_id": 20016, "verse_number": "१६-४७", "content_sanskrit": "कुमार्य्यस्चापि तिस्रो वै दिक्षु ख्याता द्विजोत्तमाः ।\nसत्यभामोत्तमा तासां व्रतिनी च च दृढव्रता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000016047, "chapter_id": 20016, "verse_number": "१६-४८", "content_sanskrit": "तथा प्रस्वापिनी चैव भार्य्याः कृष्णाय ता ददौ ।\nसभाक्षो भङ्गकारिस्तु नावेयश्च नरोत्तमौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000016048, "chapter_id": 20016, "verse_number": "१६-४९", "content_sanskrit": "जज्ञाते गुणसम्पन्नौ विश्रुतौ रूपसम्पदा ।\nमाद्रयाः पुत्रोषऽथ जज्ञेऽथ वृष्णिपुत्रो यधाजितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000016049, "chapter_id": 20016, "verse_number": "१६-५०", "content_sanskrit": "जज्ञाते तनयौ वृष्णेः श्वफल्कश्चित्रकस्तथा ।\nश्वफल्कः काशिराजस्य सुतां भार्य्यामविन्दत ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000016050, "chapter_id": 20016, "verse_number": "१६-५१", "content_sanskrit": "गान्दिनीं नाम तस्याश्च गाः सदा प्रददौ पिता ।\nतस्यां जज्ञे महाबाहुः श्रुतवानतिथिप्रियः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000016051, "chapter_id": 20016, "verse_number": "१६-५२", "content_sanskrit": "अक्रूरोऽथ महाभागो जज्ञे विपुलदक्षिणः ।\nउपमद्गुस्तता मद्गुर्म्मुदरश्चारिमर्दनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000016052, "chapter_id": 20016, "verse_number": "१६-५३", "content_sanskrit": "अरिक्षेपस्तथोपेक्षःच शत्रुहा चारिमेजयः ।\nधर्म्मभृच्चापि धर्म्मा च गृध्रभोजान्धकस्तथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000016053, "chapter_id": 20016, "verse_number": "१६-५४", "content_sanskrit": "आवाहप्रतिवाहौ च सुन्दरी च वराङ्गना ।\nविश्रुताश्वस्य महिषी कन्या चास्य वसुन्धरा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000016054, "chapter_id": 20016, "verse_number": "१६-५५", "content_sanskrit": "रुपयौवनसम्पन्ना सर्व्वसत्त्वमनोहरा ।\nअक्रुरेणोग्रसेनायां सुतौ वै कुलनन्दनौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000016055, "chapter_id": 20016, "verse_number": "१६-५६", "content_sanskrit": "वसुदेवश्चोपदेवश्च जज्ञाते देववर्च्चसौ ।\nचित्रकस्याभवन् पुत्राः पृथुर्व्विपृथुरेव च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000016056, "chapter_id": 20016, "verse_number": "१६-५७", "content_sanskrit": "अश्वग्रीवोऽस्वबाहुश्च सुपार्श्वकगवेशषणौ ।\nअरिष्टनेमिस्च सुता धर्म्मो धर्म्मभृदेव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000016057, "chapter_id": 20016, "verse_number": "१६-५८", "content_sanskrit": "सुबाहुर्बहुबाहुश्च श्रविष्ठाश्रवणे स्त्रियौ ।\nइमां मित्याभिशस्तिं यः कृष्णस्य समुदाहृताम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000016058, "chapter_id": 20016, "verse_number": "१६-५९", "content_sanskrit": "वेद मिथ्याभिशापास्तं न स्पृशन्ति कदाचन ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]