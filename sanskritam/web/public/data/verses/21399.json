[{"id": 7001399000, "chapter_id": 21399, "verse_number": "५-४६-१", "content_sanskrit": "ऋषिरुवाच ।\nआसीद्रंभासुरो नाम दैत्यवंशशिरोमणिः ।\nतस्माज्जातो महातेजा महिषो नाम दानवः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001399001, "chapter_id": 21399, "verse_number": "५-४६-२", "content_sanskrit": "स संग्रामे सुरान्सर्वान्निर्जित्य दनुजाधिपः ।\nचकार राज्यं स्वर्लोके महेन्द्रासनसंस्थितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001399002, "chapter_id": 21399, "verse_number": "५-४६-३", "content_sanskrit": "पराजितास्ततो देवा ब्रह्माणं शरणं ययुः ।\nब्रह्मापि तान्समादाय ययौ यत्र वृषाकपी॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001399003, "chapter_id": 21399, "verse_number": "५-४६-४", "content_sanskrit": "तत्र गत्वा सुरास्सर्वे नत्वा शंकरकेशवौ ।\nस्ववृत्तं कथायामासुर्यथावदनुपूर्वशः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001399004, "chapter_id": 21399, "verse_number": "५-४६-५", "content_sanskrit": "भगवन्तौ वयं सर्वे महिषेण दुरात्मना ।\nउज्जासिताश्च स्वर्लोकान्निर्जित्य समरांगणे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001399005, "chapter_id": 21399, "verse_number": "५-४६-६", "content_sanskrit": "भ्रमामो मर्त्यलोकेऽस्मिन्न लभेमहि शं क्वचित् ।\nकां कां न दुर्दशां नीता देवा इन्द्रपुरोगमाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001399006, "chapter_id": 21399, "verse_number": "५-४६-७", "content_sanskrit": "सूर्याचन्द्रमसौ पाशी कुबेरो यम एव च ।\nइन्द्राग्निवातगन्धर्वा विद्याधरसुचारणाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001399007, "chapter_id": 21399, "verse_number": "५-४६-८", "content_sanskrit": "एतेषामपरेषां च विधेयं कर्म सोसुरः ।\nस्वयं करोति पापात्मा दैत्यपक्ष भयंकर॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001399008, "chapter_id": 21399, "verse_number": "५-४६-९", "content_sanskrit": "तस्माच्छरणमापन्नान्देवान्नस्त्रातुमर्हथः ।\nवधोपायं च तस्याशु चिन्तयेथां युवां प्रभू॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001399009, "chapter_id": 21399, "verse_number": "५-४६-१०", "content_sanskrit": "इति देववचः श्रुत्वा दामोदरसतीश्वरौ ।\nचक्रतुः परमं कोपं रोषाघूर्णितलोचनौ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001399010, "chapter_id": 21399, "verse_number": "५-४६-११", "content_sanskrit": "ततोतिकोपपूर्णस्य विष्णोश्शंभोश्च वक्त्रतः ।\nतथान्येषां च देवानां शरीरान्निर्गतं महः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001399011, "chapter_id": 21399, "verse_number": "५-४६-१२", "content_sanskrit": "अतीव महसः पुंजं ज्वलन्तं दशदिक्षु च ।\nअपश्यंस्त्रिदशास्सर्वे दुर्गा ध्यानपरायणाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001399012, "chapter_id": 21399, "verse_number": "५-४६-१३", "content_sanskrit": "सर्वदेवशरीरोत्थं तेजस्तदतिभीषणम् ।\nसंघीभूयाभवन्नारी साक्षान्महिषमर्दिनी॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001399013, "chapter_id": 21399, "verse_number": "५-४६-१४", "content_sanskrit": "शंभुतेजस उत्पन्नं मुखमस्याः सुभास्वरम् ।\nयाम्येन बाला अभवन्वैष्णवेन च बाहवः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001399014, "chapter_id": 21399, "verse_number": "५-४६-१५", "content_sanskrit": "चन्द्रमस्तेजसा तस्याः स्तनयुग्मं व्यजायत ।\nमध्यमे न्द्रेण जंघोरू वारुणेन बभूवतुः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001399015, "chapter_id": 21399, "verse_number": "५-४६-१६", "content_sanskrit": "भूतेजसा नितंबोभूद्ब्राह्मेण चरणद्वयम् ।\nआर्केण चरणांगुल्यः करांगुल्यश्च वासवात्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001399016, "chapter_id": 21399, "verse_number": "५-४६-१७", "content_sanskrit": "कुबेरतेजसा नासा रदनाश्च प्रजापतेः ।\nपावकीयेन नयनत्रयं सान्ध्येन भ्रूद्वयम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001399017, "chapter_id": 21399, "verse_number": "५-४६-१८", "content_sanskrit": "आनिलेन श्रवोद्वन्द्वं तथान्येषां स्वरोकसाम् ।\nतेजसां संभवः पद्मालया सा परमेश्वरी॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001399018, "chapter_id": 21399, "verse_number": "५-४६-१९", "content_sanskrit": "ततो निखिलदेवानां तेजोराशिसमुद्भवाम् ।\nतामालोक्य सुरास्सर्वे परं हर्षं प्रपेदिरे॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001399019, "chapter_id": 21399, "verse_number": "५-४६-२०", "content_sanskrit": "निरायुधां च तां दृष्ट्वा ब्रह्माद्यास्त्रिदिवेश्वराः ।\nसायुधान्तां शिवां कर्तुं मनः सन्दधिरे सुराः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001399020, "chapter_id": 21399, "verse_number": "५-४६-२१", "content_sanskrit": "ततः शूलं महेशानो महेशान्यै समर्पयत ।\nचक्रं च कृष्णो भगवाञ्च्छंखं पाशं च पाशभृत॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001399021, "chapter_id": 21399, "verse_number": "५-४६-२२", "content_sanskrit": "शक्तिं हुताशनोऽयच्छन्मारुतश्चापमेव च॥  ।\nबाणपूर्णेषुधी चैव वज्रघण्टे शचीपतिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001399022, "chapter_id": 21399, "verse_number": "५-४६-२३", "content_sanskrit": "यमो ददौ कालदण्डमक्षमालां प्रजापतिः ।\nब्रह्मा कमण्डलुं प्रादाद्रोमरश्मीन्दिवाकरः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001399023, "chapter_id": 21399, "verse_number": "५-४६-२४", "content_sanskrit": "कालः खड्गन्ददौ तस्यै फलकं च समुज्वलम् ।\nक्षीराब्धी रुचिरं हारमजरे च तथाम्बरे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001399024, "chapter_id": 21399, "verse_number": "५-४६-२५", "content_sanskrit": "चूडामणिं कुण्डले च कटकानि तथैव च ।\nअर्द्धचन्द्रं च केयूरान्नूपुरौ च मनोहरो॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001399025, "chapter_id": 21399, "verse_number": "५-४६-२६", "content_sanskrit": "ग्रैवेयकमंगुलीषु समस्तास्वंगुलीयकम् ।\nविश्वकर्मा च परशुं ददौ तस्यै मनोहरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001399026, "chapter_id": 21399, "verse_number": "५-४६-२७", "content_sanskrit": "अस्त्राण्यनेकानि तथाभेद्यं चैव तनुच्छदम् ।\nसुरम्यसरसां मालां पङ्कजं चाम्बुधिर्ददौ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001399027, "chapter_id": 21399, "verse_number": "५-४६-२८", "content_sanskrit": "ददौ सिंहं च हिमवान्रत्नानि विविधानि च ।\nसुरया पूरितं पात्रं कुबेरोऽस्यै समर्पयत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001399028, "chapter_id": 21399, "verse_number": "५-४६-२९", "content_sanskrit": "शेषश्च भोगिनां नेता विचित्रर चनाञ्चितम् ।\nददौ तस्यै नागहारं नानास्त्रमणिगुंफितम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001399029, "chapter_id": 21399, "verse_number": "५-४६-३०", "content_sanskrit": "एतैश्चान्यैस्सुरैर्देवी भूषणैरायुधैस्तथा ।\nसत्कृतोच्चैर्ननादासौ साट्टहासं पुनःपुनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001399030, "chapter_id": 21399, "verse_number": "५-४६-३१", "content_sanskrit": "तस्या भीषणनादेन पूरिता च नभःस्थली ।\nप्रतिशब्दो महानासीच्चुक्षुभे भुवनत्रयम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001399031, "chapter_id": 21399, "verse_number": "५-४६-३२", "content_sanskrit": "चेलुः समुद्राश्चत्वारो वसुधा च चचाल ह ।\nजयशब्दस्ततो देवैरकारि महिषार्दितैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001399032, "chapter_id": 21399, "verse_number": "५-४६-३३", "content_sanskrit": "ततोऽम्बिकां परां शक्तिं महालक्ष्मीस्वरूपिणीम् ।\nतुष्टुवुस्ते सुरास्सर्वे भक्तिगद्गदया गिरा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001399033, "chapter_id": 21399, "verse_number": "५-४६-३४", "content_sanskrit": "लोकं संक्षुब्धमालोक्य देवतापरिपन्थिनः ।\nसन्नद्धसैनिकास्ते च समुत्तस्थुरुदायुधाः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001399034, "chapter_id": 21399, "verse_number": "५-४६-३५", "content_sanskrit": "महिषोऽपि च तं शब्दमभ्यधावद्रुषान्वितः ।\nस ददर्श ततो देवीं व्याप्तलोकत्रयां रुचा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001399035, "chapter_id": 21399, "verse_number": "५-४६-३६", "content_sanskrit": "एतस्मिन्नन्तरे तत्र महिषासुरपालिताः ।\nसमाजग्मुर्महावीराः कोटिशो धृतहेतयः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001399036, "chapter_id": 21399, "verse_number": "५-४६-३७", "content_sanskrit": "चिक्षुरश्चामरोदग्रौ करालोद्धतबाष्कलाः ।\nताम्रोग्रास्योग्रवीर्याश्च बिडालोऽन्धक एव च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001399037, "chapter_id": 21399, "verse_number": "५-४६-३८", "content_sanskrit": "दुर्धरो दुर्मुखश्चैव त्रिनेत्रश्च महाहनुः ।\nएते चान्ये च बहवः शूरा युद्धविशा रदाः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001399038, "chapter_id": 21399, "verse_number": "५-४६-३९", "content_sanskrit": "युयुधुः समरे देव्या सह शस्त्रास्त्रपारगाः ।\nइत्थं कालो व्यतीयाय युध्यतोर्भीषणस्तयोः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001399039, "chapter_id": 21399, "verse_number": "५-४६-४०", "content_sanskrit": "अरिवर्गकरक्षिप्ता नानाशस्त्रास्त्रराशयः ।\nमहामायाप्रभावेण विफला अभवन् क्षणात्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001399040, "chapter_id": 21399, "verse_number": "५-४६-४१", "content_sanskrit": "ततो जघान सा देवी चिक्षुरप्रमुखानरीन् ।\nसगणान्गदया बाणैः शूलशक्तिपरश्वधैः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001399041, "chapter_id": 21399, "verse_number": "५-४६-४२", "content_sanskrit": "एवं स्वीयेषु सैन्येषु हतेषु महिषासुरः ।\nदेवीनिःश्वाससंभूतान्भावयामास तान्गणान्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001399042, "chapter_id": 21399, "verse_number": "५-४६-४३", "content_sanskrit": "अताडयत्सरैः काश्चित्काश्चिच्छृङ्गद्वयेन च ।\nलांगूलेन च तुण्डेन भिनत्ति स्म मुहुर्मुहुः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001399043, "chapter_id": 21399, "verse_number": "५-४६-४४", "content_sanskrit": "इत्थं देवीगणा न्हत्वाभ्यधावत्सोऽसुराधिपः ।\nसिंहं मारयितुन्देव्यास्ततोऽसौ कुपिताऽभवत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001399044, "chapter_id": 21399, "verse_number": "५-४६-४५", "content_sanskrit": "कोपात्सोपि महावीर्यः खुरकुट्टितभूतलः ।\nशृङ्गाभ्यां शैलमुत्पाट्य चिक्षेप प्रणनाद च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001399045, "chapter_id": 21399, "verse_number": "५-४६-४६", "content_sanskrit": "वेगेन विष्वग् भ्रमता प्रक्षिप्ता गुरवोऽद्रयः ।\nआकाशतो महीमध्ये निपेतुर्नृपसत्तम॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001399046, "chapter_id": 21399, "verse_number": "५-४६-४७", "content_sanskrit": "शृंगभिन्नाः पयोवाहाः खण्डं खण्डमयासिषुः ।\nलांगूलेनाहतश्चाब्धिर्विष्वगुद्वेलमस्पदत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001399047, "chapter_id": 21399, "verse_number": "५-४६-४८", "content_sanskrit": "एवं क्रुद्धं समालोक्य महिषासुरमम्बिका ।\nविदधे तद्वधोपायं देवानामभयंकरी॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001399048, "chapter_id": 21399, "verse_number": "५-४६-४९", "content_sanskrit": "ततः पाशं समुत्थाय क्षिप्त्वा तस्योपरी श्वरी ।\nबबन्ध महिषं सोऽपि रूपन्तत्याज माहिषम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001399049, "chapter_id": 21399, "verse_number": "५-४६-५०", "content_sanskrit": "ततः सिंहो बभूवाशु मायावी तच्छिरोम्बिका ।\nयावद्भिनत्ति तावत्स खङ्गपाणिर्बभूव ह॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001399050, "chapter_id": 21399, "verse_number": "५-४६-५१", "content_sanskrit": "सचर्म्मासिकरं तं च देवी बाणैरताडयत् ।\nततो गजवपुर्भूत्वा सिंहं चिच्छेद शुण्डया॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001399051, "chapter_id": 21399, "verse_number": "५-४६-५२", "content_sanskrit": "ततोऽस्य च करं देवी चकर्त स्वमहासिना ।\nअधारि च पुना रूपं स्वकीयं तेन रक्षसा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001399052, "chapter_id": 21399, "verse_number": "५-४६-५३", "content_sanskrit": "तदैव क्षोभयामास त्रैलोक्यं सचराचरम् ।\nततः क्रुद्धा महामाया चण्डिका मानविक्रमा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001399053, "chapter_id": 21399, "verse_number": "५-४६-५४", "content_sanskrit": "पपौ पुनःपुनः पानं जहासोद्भ्रान्तलोचना ।\nजगर्ज चासुरः सोऽपि बलवीर्यमदो द्धतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001399054, "chapter_id": 21399, "verse_number": "५-४६-५५", "content_sanskrit": "तस्या उपरि चिक्षेप शैलानुत्पाट्य सोऽसुरः ।\nसा च बाणावलीघातैश्चूर्णयामास सत्वरम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001399055, "chapter_id": 21399, "verse_number": "५-४६-५६", "content_sanskrit": "वारुणीमद्रसं जातमुखरागाऽऽकुलेन्द्रिया ।\nप्रोवाच परमेशानी मेघगंभीरया गिरा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001399056, "chapter_id": 21399, "verse_number": "५-४६-५७", "content_sanskrit": "॥ देव्युवाच  ।\nरे मूढ रे हतप्रज्ञ व्यर्थ किं कुरुषे हठम् ।\nन मदग्रेऽसुराः केपि स्थास्नवो जगतीत्रये॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001399057, "chapter_id": 21399, "verse_number": "५-४६-५८", "content_sanskrit": "ऋषि रुवाच ।\nएकमाभाष्य कूर्दित्वा देवी सर्वकलामयी ।\nपदाक्रम्यासुरं कण्ठे शूलेनोग्रेण साऽभिनत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001399058, "chapter_id": 21399, "verse_number": "५-४६-५९", "content_sanskrit": "ततस्तच्चरणाक्रान्तस्स स्वकीयमुखात्ततः ।\nअर्द्धनिष्क्रान्त एवासीद्देव्या वीर्येण संवृतः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001399059, "chapter_id": 21399, "verse_number": "५-४६-६०", "content_sanskrit": "अर्द्धनिष्क्रान्त एवासौ युध्यमानो महाधमः ।\nमहासिना शिरो भित्त्वा न्यपाति धरणीतले॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001399060, "chapter_id": 21399, "verse_number": "५-४६-६१", "content_sanskrit": "हाहाशब्दं समुच्चार्य्यावाङ्मुखास्तद्गणास्ततः ।\nपलायन्त रणाद्भीतास्त्राहित्राहीति वादिनः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001399061, "chapter_id": 21399, "verse_number": "५-४६-६२", "content_sanskrit": "तुष्टुवुश्च तदा देवीमिन्द्राद्याः सकलाः सुराः ।\nगन्धर्वा गीतमुच्चेरुर्ननृतुर्नर्तकीजनाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001399062, "chapter_id": 21399, "verse_number": "५-४६-६३", "content_sanskrit": "एवन्ते कथितो राजन्महालक्ष्म्याः समुद्भवः ।\nसरस्वत्यास्तथोत्पत्तिं शृणु सुस्थेन चेतसा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]