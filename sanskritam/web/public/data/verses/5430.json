[{"id": 2207702, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207703, "chapter_id": 5430, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nसुभगे पञ्चहोतॄणां विधानमिह यादृशम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207704, "chapter_id": 5430, "verse_number": "२", "content_sanskrit": "प्राणापानावुदानश्च समानो व्यान एव च ।\nपञ्चहोतॄनथैतान् वै परं भावं विदुर्बुधाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207705, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207706, "chapter_id": 5430, "verse_number": "३", "content_sanskrit": "स्वभावात् सप्त होतार इति ते पूर्विका मतिः ।\nयथा वै पञ्च होतारः परो भावस्तथोच्यताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207707, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207708, "chapter_id": 5430, "verse_number": "४", "content_sanskrit": "प्राणेन सम्भृतो वायुरपाने जायते ततः ।\nअपाने सम्भृतो वायुस्ततो व्यानः प्रवर्तते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207709, "chapter_id": 5430, "verse_number": "५", "content_sanskrit": "तेऽपृच्छन्त पुरो गत्वा पूर्वजातं प्रजापतिम् ।\nयो नो ज्येष्ठस्तदाचक्ष्व स नः श्रेष्ठो भविष्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207710, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207711, "chapter_id": 5430, "verse_number": "६", "content_sanskrit": "यस्मिन् प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे ।\nयस्मिन् प्रवृत्ते च पुनश्चरन्ति\nस वः श्रेयान् गच्छत यत्र कामः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207712, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "प्राणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207713, "chapter_id": 5430, "verse_number": "७", "content_sanskrit": "मयि प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे ।\nमयि प्रवृत्ते च पुनश्चरन्ति\nश्रेष्ठो ह्यहं पश्यत मा प्रलीनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207714, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207715, "chapter_id": 5430, "verse_number": "८", "content_sanskrit": "प्राणः प्रालीयत ततः पुनश्च प्रचचार सः ।\nसमानश्चाप्युदानश्च वचोऽब्रूतां पुनः शुभे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207716, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "समानोदानौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207717, "chapter_id": 5430, "verse_number": "९", "content_sanskrit": "न त्वं सर्वमिदं प्राप्य तिष्ठस्युत यथा वयम् ।\nन त्वं श्रेष्ठो हि नः प्राण अपानो हि वशे तव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207718, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207719, "chapter_id": 5430, "verse_number": "१०", "content_sanskrit": "प्रचचार ततः प्राणः ततोऽपानोऽभ्यभाषत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207720, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "अपानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207721, "chapter_id": 5430, "verse_number": "११", "content_sanskrit": "मयि प्रलीने प्रलयं व्रजन्ति\nसर्वे प्राणाः प्राणभृतां शरीरे ।\nमयि प्रवृत्ते च पुनश्चरन्ति\nश्रेष्ठो ह्यहं पश्यत मा प्रलीनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207722, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207723, "chapter_id": 5430, "verse_number": "१२", "content_sanskrit": "व्यानश्च तमुदानश्च भाषमाणमथोचतुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207724, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "व्यानोदानौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207725, "chapter_id": 5430, "verse_number": "१३", "content_sanskrit": "अपान न त्वं श्रेष्ठो नः प्राणो हि वशगस्तव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_