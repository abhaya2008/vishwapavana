ning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2207759, "chapter_id": 5430, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2207760, "chapter_id": 5430, "verse_number": "३२", "content_sanskrit": "एकः स्थिरश्चराश्चान्ये विशेषात् पञ्च वायवः ।\nएक एव ममैवात्मा बहुधाऽप्युपचीयते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2207761, "chapter_id": 5430, "verse_number": "३३", "content_sanskrit": "परस्परस्य सुहृदो भावयन्तः परस्परम् ।\nस्वस्ति व्रजत भद्रं वो धारयध्वं परस्परम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2207762, "chapter_id": 5430, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु इन्द्रियाणां परस्परसंवादो नाम चतुर्विंशोऽध्यायः ॥२४॥\nअनुगीतापर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]