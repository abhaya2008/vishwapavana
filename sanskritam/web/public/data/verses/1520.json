[{"id": 2024215, "chapter_id": 1520, "verse_number": "३-१५८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024216, "chapter_id": 1520, "verse_number": "३-१५८-१", "content_sanskrit": "ततस्तान्परिविश्वस्तान्वसतस्तत्र पाण्डवान्।\n[पर्वतेन्द्रे द्विजैः सार्धं पार्तागमनकाङ्क्षया ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024217, "chapter_id": 1520, "verse_number": "३-१५८-२", "content_sanskrit": "गतेषु तेषु रक्षःसु भीमसेनात्मजेऽपि च।\nरहितान्मीमसेनेन कदाचित्तान्यदृच्छया।\nजहार धर्मराजं वै यमौ कृष्णां च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024218, "chapter_id": 1520, "verse_number": "३-१५८-३x", "content_sanskrit": "`जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024219, "chapter_id": 1520, "verse_number": "३-१५८-३", "content_sanskrit": "ब्रह्मन्कथं धर्मराजं यमौ कृष्णां च राक्षसः।\nजहार चित्रं भीमश्च गतो राक्षसकण्टकः।\nवक्तुमर्हसि विप्राग्र्य व्यक्तमेतन्ममाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024220, "chapter_id": 1520, "verse_number": "३-१५८-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024221, "chapter_id": 1520, "verse_number": "३-१५८-४", "content_sanskrit": "ब्राह्मणो मन्त्रकुशलः सर्वास्त्रेष्वस्त्रवित्तमः।\nइति ब्रुवन्पाण्डवेयान्पर्युपास्ते स्म नित्यदा ।\nपरीप्समानः पार्थानां कलापांश्च धनूंषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024222, "chapter_id": 1520, "verse_number": "३-१५८-५", "content_sanskrit": "अन्तरं संपरिप्रेप्सुर्द्रौपद्या हरणं प्रति।\nदुष्टात्मा पापबुद्धिः स नाम्ना ख्यातो जटासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024223, "chapter_id": 1520, "verse_number": "३-१५८-६", "content_sanskrit": "[पोषणं तस् राजेनद्र चक्रे पाण्डवनन्दनः।\nबुबुधे न च तं पापं भस्मच्छन्नमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024224, "chapter_id": 1520, "verse_number": "३-१५८-७", "content_sanskrit": "स भीमसेने निष्क्रान्ते मृगयार्थमरिंदमे।\n[घटोत्कचं सानुचरं दृष्ट्वा विप्रद्रुतं दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024225, "chapter_id": 1520, "verse_number": "३-१५८-८", "content_sanskrit": "लोमशप्रभृतींस्तांस्तु महर्षीश्च समाहितान्।\nस्नातुं विनिर्गतान्दृष्ट्वा पुष्पार्थं च तपोधनान्] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024226, "chapter_id": 1520, "verse_number": "३-१५८-९", "content_sanskrit": "रूपमन्यत्समास्थाय विकृतं भैरवं महत्।\nगृहीत्वा सर्वशस्त्राणि द्रौपदीं परिगृह्य च।\nप्रातिष्ठत सुदुष्टात्मा त्रीन्गृहीत्वा च पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024227, "chapter_id": 1520, "verse_number": "३-१५८-१०", "content_sanskrit": "[विक्रम्य कौशिकं खङ्गं मोक्षयित्वा ग्रहं रिपोः।]\nआक्रन्दद्भीमसेन वै येन यातो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024228, "chapter_id": 1520, "verse_number": "३-१५८-११", "content_sanskrit": "तमब्रवीद्धर्मराजो ह्रियमाणो युधिष्ठिरः।\nधर्मस्ते हीयते मूढ न चैनं समवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024229, "chapter_id": 1520, "verse_number": "३-१५८-१२", "content_sanskrit": "येऽन्ये क्वचिन्मनुष्येषु तिर्यग्योनिगताश्च ये।\nधर्मं ते समवेक्षन्ते रक्षांसि च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024230, "chapter_id": 1520, "verse_number": "३-१५८-१३", "content_sanskrit": "धर्मस्यराक्षसा मूलं धर्मं ते विदुरुत्तमम्।\nएतत्परीक्ष्यसर्वं त्वं समीपे स्थातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024231, "chapter_id": 1520, "verse_number": "३-१५८-१४", "content_sanskrit": "देवाश्च ऋषयः सिद्धाः पितरश्चापि राक्षस।\nगन्धर्वोरगरक्षांसि वयांसि पशवस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024232, "chapter_id": 1520, "verse_number": "३-१५८-१५", "content_sanskrit": "तिर्यग्योनिगताश्चैव अपि कीटपिपीलिकाः।\nमनुष्यानुपजीवन्ति ततस्त्वमपि जीवसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024233, "chapter_id": 1520, "verse_number": "३-१५८-१६", "content_sanskrit": "समृद्ध्या यस्य लोकस्य लोको युष्माकमृध्यति।\nइमं च लोकं शोचन्तमनुशोचन्ति देवताः।\nपूज्यमानाश्च वर्धन्ते हव्यकव्यैर्यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024234, "chapter_id": 1520, "verse_number": "३-१५८-१७", "content_sanskrit": "वयं राष्ट्रस्य गोप्तारो रक्षितारश्च राक्षस।\nराष्ट्रस्यारक्ष्यमाणस्य कुतो भूतिः कुतः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024235, "chapter_id": 1520, "verse_number": "३-१५८-१८", "content_sanskrit": "न च राजाऽवमन्तव्यो रक्षसा जात्वनागसि।\nअनुरप्यपचारश्च नास्त्यस्माकं नराशन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024236, "chapter_id": 1520, "verse_number": "३-१५८-१९", "content_sanskrit": "विघसाशान्यथाशक्त्या कुर्महे देवतादिषु।\nगुरूंश्च ब्राह्मणांश्चैव प्रमाणप्रवणाः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024237, "chapter_id": 1520, "verse_number": "३-१५८-२०", "content_sanskrit": "द्रोग्धव्यं न च मित्रेषु न विश्वस्तेषु कर्हिचित्।\nयेषां चान्नानि भुञ्जीत यत्रच स्यात्प्रतिश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024238, "chapter_id": 1520, "verse_number": "३-१५८-२१", "content_sanskrit": "स त्वं प्रतिश्रयेऽस्माकं पूज्यमानः सुखोषितः।\nभुक्त्वा चान्नानि दुष्प्रज्ञ कथमस्माञ्जिहीर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024239, "chapter_id": 1520, "verse_number": "३-१५८-२२", "content_sanskrit": "एवमेव वृथाचारो वृथा वृद्धो वृथामतिः।\nवृथामरणमर्हस्त्वं वृथाऽद्य नमविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024240, "chapter_id": 1520, "verse_number": "३-१५८-२३", "content_sanskrit": "अथ चेद्दुष्टबुद्धिस्त्वं सर्वैर्धर्मैर्विवर्जितः।\nप्रदाय शस्त्राण्यस्माकं युद्धेन द्रौपदीं हर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024241, "chapter_id": 1520, "verse_number": "३-१५८-२४", "content_sanskrit": "अथ चेत्त्वमविज्ञाय इदं कर्म करिष्यसि।\nअधर्मं चाप्यकीर्तिं च लोके प्राप्स्यसि केवलं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024242, "chapter_id": 1520, "verse_number": "३-१५८-२५", "content_sanskrit": "एतामद्य परामृश्य स्त्रियं राक्षस मानुषीम्।\nविषमेतत्समालोड्य कुम्भेन प्राशितं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024243, "chapter_id": 1520, "verse_number": "३-१५८-२६", "content_sanskrit": "ततो युधिष्ठिरस्तस्य भारिकः समपद्यत।\nस तु भाराभिभूतात्मा न तथा शीघ्रगोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024244, "chapter_id": 1520, "verse_number": "३-१५८-२७", "content_sanskrit": "अथाब्रवीद्द्रौपदीं च नकुलं च युधिष्ठिरः।\nमा भैष्टं राक्षसान्मूढाद्गतिरस्य मया हृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024245, "chapter_id": 1520, "verse_number": "३-१५८-२८", "content_sanskrit": "नातिदूरे महबाहुर्भविता पवनात्मजः।\nअस्मिन्मुहूर्ते संप्राप्ते नभविष्यति राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024246, "chapter_id": 1520, "verse_number": "३-१५८-२९", "content_sanskrit": "सहदेवस्तु तं दृष्ट्वा राक्षसं मूढचेतसम्।\nउवाच वचनं राजन्कुन्तीपुत्रं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024247, "chapter_id": 1520, "verse_number": "३-१५८-३०", "content_sanskrit": "राजन्किं नाम सत्कृत्यं क्षत्रियस्यास्त्यतोऽधिकम्।\nयद्युद्धेऽभिमुखः प्राणांस्त्यजेच्छत्रुं जयेत वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024248, "chapter_id": 1520, "verse_number": "३-१५८-३१", "content_sanskrit": "एष वास्मान्वयं वैनं युध्यमानाः परंतप।\nसूदयेम महाबाहो देशः कालो ह्ययं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024249, "chapter_id": 1520, "verse_number": "३-१५८-३२", "content_sanskrit": "क्षत्रधर्मस्य संप्राप्तः कालः सत्यपराक्रम।\nजयन्तो हन्यमाना वा प्राप्तुमर्हाम सद्गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024250, "chapter_id": 1520, "verse_number": "३-१५८-३३", "content_sanskrit": "राक्षसे जीवमानेऽद्य रविरस्तमियाद्यदि।\nनाहं ब्रूयां पुनर्जातु क्षत्रियोस्मीति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024251, "chapter_id": 1520, "verse_number": "३-१५८-३४", "content_sanskrit": "भोभो राक्षस तिष्ठस्व सहदेवोस्मि पाण्डवः।\nहत्वा रवा मां नयस्वैनां हतो वा स्वप्स्यसीह वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024252, "chapter_id": 1520, "verse_number": "३-१५८-३५", "content_sanskrit": "तदा ब्रुवति माद्रेये भीमसेनो यदृच्छया।\nप्रादृश्यत महाबाहुः सवज्र इव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024253, "chapter_id": 1520, "verse_number": "३-१५८-३६", "content_sanskrit": "सोऽपश्यद्धातरौ तत्र द्रौपदीं च यशस्विनीम्।\nक्षितिस्थं सहदेवं च क्षिपन्तं राक्षसं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024254, "chapter_id": 1520, "verse_number": "३-१५८-३७", "content_sanskrit": "मार्गाच्च राक्षसं मूढं कालोपहतचेतसम्।\nभ्रमन्तं तत्रतत्रैव दैवेन परिमोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024255, "chapter_id": 1520, "verse_number": "३-१५८-३८", "content_sanskrit": "हृतान्संदृश्य तान्भ्रातृन्द्रौपदीं च महाबलः।\nक्रोधमाहारयद्भीमो राक्षसंचेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024256, "chapter_id": 1520, "verse_number": "३-१५८-३९", "content_sanskrit": "विज्ञातोऽसि मया पूर्वं चेष्टञ्शस्त्रपरीक्षणे।\nआस्था तु त्वयि मे नास्ति यतोसि न हतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024257, "chapter_id": 1520, "verse_number": "३-१५८-४०", "content_sanskrit": "ब्रह्मरूपप्रतिच्छन्नो न नो वदसि चाप्रियम्।\nप्रियेषु रममाणं त्वां न चैवाप्रियकारिणम्।\nब्रह्मरूपेण विहितं नैव हन्यामनागसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024258, "chapter_id": 1520, "verse_number": "३-१५८-४१", "content_sanskrit": "राक्षसं जानमानोऽपि यो हन्यान्नरकं व्रजेत्।\nअपक्वस्य च कालेन वधस्तव न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024259, "chapter_id": 1520, "verse_number": "३-१५८-४२", "content_sanskrit": "नूनमद्यासि संपक्वो यथा ते मतिरीदृशी।\nदत्ता कृष्णापहरणे कालेनाद्भुतकर्मणा।\n`सोपि कालं समासाद्य तथाऽद्य नभविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2024260, "chapter_id": 1520, "verse_number": "३-१५८-४३", "content_sanskrit": "बडिशोऽयंत्वया ग्रस्तः कालसूत्रेण लम्बितः।\nमत्स्योऽम्भसीव स्यूतास्यः कथमद्य गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2024261, "chapter_id": 1520, "verse_number": "३-१५८-४४", "content_sanskrit": "यं चासि प्रस्थितो देशं मनः पूर्वं गतं च ते।\nन तं गन्तासि गन्तासि मार्गं बकहिडिम्बयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2024262, "chapter_id": 1520, "verse_number": "३-१५८-४५", "content_sanskrit": "एवमुक्तस्तु भीमेन राक्षसः कालचोदितः।\nभीत उत्सृज्य तान्सर्वान्युद्धाय समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2024263, "chapter_id": 1520, "verse_number": "३-१५८-४६", "content_sanskrit": "अब्रवीच्च पुनर्भीमं रोषात्प्रस्फुरिताधरः।\nन मे मूढा दिशः पाप त्वदर्थं मे विलम्बनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2024264, "chapter_id": 1520, "verse_number": "३-१५८-४७", "content_sanskrit": "श्रुता मे राक्षसा ये ये त्वया विनिहता रणे।\nतेषामद्यकरिष्यामि तवास्रेणोदकक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2024265, "chapter_id": 1520, "verse_number": "३-१५८-४८", "content_sanskrit": "`एवमुक्त्वातदा भीमं राक्षसो योद्धुमाययौ।\nकरालवदनः क्रोधात्कालसर्प इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2024266, "chapter_id": 1520, "verse_number": "३-१५८-४९", "content_sanskrit": "एवमुक्तस्ततो भीमः सृक्विणी परिलेलिहन्।\nस्मयमान इव क्रोधात्साक्षात्कालान्तकोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2024267, "chapter_id": 1520, "verse_number": "३-१५८-५०", "content_sanskrit": "`ब्रुवन्वै तिष्ठतिष्ठेति क्रोधसंरक्तलोचनः।\nबाहुसंरम्भमेवेच्छन्नभिदुद्राव राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2024268, "chapter_id": 1520, "verse_number": "३-१५८-५१", "content_sanskrit": "मुहुर्मुहुर्व्याददानः सृक्विणी परिसंलिहन्।]\nअभिदुद्राव संरब्धो बलो वज्रधरं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2024269, "chapter_id": 1520, "verse_number": "३-१५८-५२", "content_sanskrit": "भीमसेनोऽप्यवष्टब्धो नियुद्धायाभवत्स्थितः।\nराक्षसोऽपि च विस्रब्धो बाहुयुद्धमकाङ्क्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2024270, "chapter_id": 1520, "verse_number": "३-१५८-५३", "content_sanskrit": "वर्तमाने तयो राजन्बाहुयुद्धे सुदारुणे।\nमाद्रीपुत्रावतिक्रुद्धावुभावप्यभ्यधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2024271, "chapter_id": 1520, "verse_number": "३-१५८-५४", "content_sanskrit": "न्यवारयत्तौ प्रहसन्कुन्तीपुत्रो वृकोदरः।\nशक्तोऽहं राक्षसस्येति प्रेक्षध्वमिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2024272, "chapter_id": 1520, "verse_number": "३-१५८-५५", "content_sanskrit": "आत्मना भ्रातृभिश्चैव धर्मेण सुकृतेन च।\nइष्टेन च शपे राजन्सूदयिष्यामि राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2024273, "chapter_id": 1520, "verse_number": "३-१५८-५६", "content_sanskrit": "इत्येवमुक्त्वा तौ वीरौ स्पर्धमानौ परस्परम्।\nबाहुभिः समसज्जेतामुभौ रक्षोवृकोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2024274, "chapter_id": 1520, "verse_number": "३-१५८-५७", "content_sanskrit": "तयोरासीत्संप्रहारः क्रुद्धयोर्भीमरक्षसोः।\nअमृष्यमाणयोः सङ्ख्ये शक्रशम्बरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2024275, "chapter_id": 1520, "verse_number": "३-१५८-५८", "content_sanskrit": "तौ वीरौ समभिक्रुद्धावन्योन्यं पर्यधावताम्।\nआरुज्यारुज्यतौ वृक्षानन्योन्यमभिजघ्नतुः।\nजीमूताविव धर्मान्ते विनदन्तौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2024276, "chapter_id": 1520, "verse_number": "३-१५८-५९", "content_sanskrit": "बभञ्जतुर्महावृक्षानूरुभिर्बलिनां वरौ।\nअन्योन्येनाभिसंरब्धौ परस्परवधैषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2024277, "chapter_id": 1520, "verse_number": "३-१५८-६०", "content_sanskrit": "तद्वृक्षयुद्धमभवनमहीरुहविनाशनम्।\nवालिसुग्रीवयोर्भ्रात्रोः पुरेव कपिसिंहयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2024278, "chapter_id": 1520, "verse_number": "३-१५८-६१", "content_sanskrit": "आविध्याविध्य तौ वृक्षान्मुहूर्तमितरेतरम्।\nताडयामासतुरुभौ विनदन्तौ मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2024279, "chapter_id": 1520, "verse_number": "३-१५८-६२", "content_sanskrit": "तस्मिन्देशे यदा वृक्षाः सर्व एव निपातिताः।\nपुगीकृताश्च शतशः परस्परवधेप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2024280, "chapter_id": 1520, "verse_number": "३-१५८-६३", "content_sanskrit": "ततः शिलाः समादाय मुहूर्तमिव भारत।\nमहाभ्रैरिव शैलेन्द्रौ युयुधाते महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2024281, "chapter_id": 1520, "verse_number": "३-१५८-६४", "content_sanskrit": "शिलाभिरुग्ररूपाभिर्बृहतीभिः परस्परम्।\nवज्रैरिव महावेगैराजघ्नतुरमर्षणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2024282, "chapter_id": 1520, "verse_number": "३-१५८-६५", "content_sanskrit": "अभिद्रुत्य च भूयस्तावन्योन्यबलदर्पितौ।\nभुजाभ्यां परिगृह्याथ चकर्षाते गजाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2024283, "chapter_id": 1520, "verse_number": "३-१५८-६६", "content_sanskrit": "मुष्टिभिश् महाघोरैरन्योन्यमभिपेततुः।\nततः कटकटाशब्दो बभूव शुमहात्मनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2024284, "chapter_id": 1520, "verse_number": "३-१५८-६७", "content_sanskrit": "ततः संहृत्यमुष्टिं तु पञ्चशीर्षमिवोरगम्।\nवेगेनाभ्यहनद्भीमो राक्षसस्य शिरोधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2024285, "chapter_id": 1520, "verse_number": "३-१५८-६८", "content_sanskrit": "ततः श्रान्तं तु तद्रक्षो भीमसेनभुजाहतम्।\nसुपरिभ्रान्तमालक्ष्य भीमसेनोऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2024286, "chapter_id": 1520, "verse_number": "३-१५८-६९", "content_sanskrit": "तत एनं महाबाहुर्बाहुभ्याममरोपमः।\nसमुत्क्षिप्य बलाद्भीमो निष्पिपेष महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2024287, "chapter_id": 1520, "verse_number": "३-१५८-७०", "content_sanskrit": "`ततः संपीड्य बलवद्भुजाभ्यां क्रोधमूर्च्छितः।\nतस्य गात्राणि सर्वाणि चूर्णयामास पाण्डवः।\nअरत्निना चाभिहत्य शिरः कायादपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2024288, "chapter_id": 1520, "verse_number": "३-१५८-७१", "content_sanskrit": "संदष्टौष्ठं विवृत्ताक्षं फलं वृक्षादिव च्युतम्।\nजटासुरस्य तु शिरो भीमसेनबलाद्धृतम्।\nपपात रुधिरादिग्धं संदष्टदशनच्छदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2024289, "chapter_id": 1520, "verse_number": "३-१५८-७२", "content_sanskrit": "तं निहत्यमहेष्वासो युधिष्ठिरमुपागमत्।\nस्तूयमानो द्विजाग्र्यैस्तु मरुद्भिरिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2024290, "chapter_id": 1520, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि जटासुरवधपर्वणि अष्टपञ्चाशदधिकशततमोऽध्यायः ॥ १५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]