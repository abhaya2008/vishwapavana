[{"id": 6000160000, "chapter_id": 10160, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000160001, "chapter_id": 10160, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.001.m4a", "display_order": 2}, {"id": 6000160002, "chapter_id": 10160, "verse_number": "८-७-१", "content_sanskrit": "ते नागराजमामन्त्र्य फलभागेन वासुकिम्।\nपरिधाय गिरौ तस्मिन् नेत्रमब्धिं मुदाऽन्विताः॥ ८/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.002.m4a", "display_order": 3, "topics": [{"text": "अमृतमथनारम्भः", "range": "१–१७"}]}, {"id": 6000160003, "chapter_id": 10160, "verse_number": "८-७-२", "content_sanskrit": "आरेभिरे सुरा यत्ता अमृतार्थे कुरूद्वह।\nहरिः पुरस्ताज्जगृहे पूर्वं देवास्ततोऽभवन्॥ ८/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.003.m4a", "display_order": 4}, {"id": 6000160004, "chapter_id": 10160, "verse_number": "८-७-३", "content_sanskrit": "तन्नैच्छन् दैत्यपतयो महापुरुषचेष्टितम्।\nन गृह्णीमो वयं पुच्छमहेरङ्गममङ्गलम्॥ ८/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.004.m4a", "display_order": 5}, {"id": 6000160005, "chapter_id": 10160, "verse_number": "८-७-४", "content_sanskrit": "स्वाध्यायश्रुतसम्पन्नाः प्रख्याता जन्मकर्मभिः।\nइति तूष्णीं स्थितान् दैत्यान् विलोक्य पुरुषोत्तमः॥ ८/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.005.m4a", "display_order": 6}, {"id": 6000160006, "chapter_id": 10160, "verse_number": "८-७-५", "content_sanskrit": "स्मयमानो विसृज्याग्रं पुच्छं जग्राह सामरः।\nकृतस्थानविभागास्ते एवं कश्यपनन्दनाः॥ ८/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.006.m4a", "display_order": 7}, {"id": 6000160007, "chapter_id": 10160, "verse_number": "८-७-६", "content_sanskrit": "ममन्थुः परमायत्ता अमृतार्थे पयोनिधिम्।\nमथ्यमानेऽर्णवे सोऽद्रिरनाधारो ह्यपोऽविशत्॥ ८/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.007.m4a", "display_order": 8}, {"id": 6000160008, "chapter_id": 10160, "verse_number": "८-७-७", "content_sanskrit": "ध्रियमाणोऽपि बलिभिर्गौरवात् पाण्डुनन्दन। ते सुनिर्विण्णमनसः परिम्लानमुखश्रियः।\nआसन् स्वपौरुषे नष्टे दैवेनातिबलीयसा॥ ८/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.008.m4a", "display_order": 9}, {"id": 6000160009, "chapter_id": 10160, "verse_number": "८-७-८", "content_sanskrit": "विलोक्य विघ्नेशगतिं तदेश्वरो दुरन्तवीर्योऽवितथाभिसन्धिः।\nकृत्वा वपुः काच्छपमद्भुतं महत् प्रविश्य तोयं गिरिमुज्जहार॥ ८/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.009.m4a", "display_order": 10}, {"id": 6000160010, "chapter_id": 10160, "verse_number": "८-७-९", "content_sanskrit": "तमुत्थितं वीक्ष्य कुलाचलं पुनः समुत्थिता निर्मथितुं सुरासुराः।\nदधार पृष्ठेन स लक्षयोजनप्रस्तारिणा द्वीप इवापरो महान्॥ ८/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.010.m4a", "display_order": 11}, {"id": 6000160011, "chapter_id": 10160, "verse_number": "८-७-१०", "content_sanskrit": "सुरासुरेन्द्रैर्भुजवीर्यवेपितं परिभ्रमन्तं गिरिमङ्ग पृष्ठतः।\nबिभ्रत् तदावर्तनमादिकच्छपो मेनेऽङ्गकण्डूयनमप्रमेयः॥ ८/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.011.m4a", "display_order": 12}, {"id": 6000160012, "chapter_id": 10160, "verse_number": "८-७-११", "content_sanskrit": "तथाऽसुरानाविशदासुरेण रूपेण तेषां बलवीर्यमीरयन्।\nउद्दीपयन् देवगणांश्च विष्णुर्दैवेन नागेन्द्रमबोधरूपः॥ ८/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.012.m4a", "display_order": 13}, {"id": 6000160013, "chapter_id": 10160, "verse_number": "८-७-१२", "content_sanskrit": "उपर्यगेन्द्रं गिरिराडिवान्य आक्रम्य हस्तेन सहस्रबाहुः।\nतस्थौ दिवि ब्रह्मभवेन्द्रमुख्यैरभिष्टुवद्भिः सुमनोऽभिवृष्टः॥ ८/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.013.m4a", "display_order": 14}, {"id": 6000160014, "chapter_id": 10160, "verse_number": "८-७-१३", "content_sanskrit": "उपर्यधश्चात्मनि गोत्रनेत्रयोः परेण ते प्राविशता समेधिताः।\nममन्थुरब्धिं तरसा मदोत्कटा महाद्रिणा क्षोभितनक्रचक्रम्॥ ८/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.014.m4a", "display_order": 15}, {"id": 6000160015, "chapter_id": 10160, "verse_number": "८-७-१४", "content_sanskrit": "अहीन्द्रसाहस्रकरालदिङ्मुखश्वासाग्निधूमाहतवर्चसोऽसुराः।\nपौलोमकालेयबलील्वलादयो दवाग्निदग्धाः सरला इवाभवन्॥ ८/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.015.m4a", "display_order": 16}, {"id": 6000160016, "chapter_id": 10160, "verse_number": "८-७-१५", "content_sanskrit": "देवांश्च तच्छ्वासशिखाहतप्रभान् धूम्राम्बरस्रग्वरकञ्चुकाननान्।\nसमभ्यवर्षन् भगवद्वशा घना ववुः समुद्रोर्म्युपगूढवायवः॥ ८/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.016.m4a", "display_order": 17}, {"id": 6000160017, "chapter_id": 10160, "verse_number": "८-७-१६", "content_sanskrit": "मथ्यमानात् तथा सिन्धोर्देवासुरवरूथपैः।\nयदा सुधा न जायेत निर्ममन्थाजितः स्वयम्॥ ८/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.017.m4a", "display_order": 18}, {"id": 6000160018, "chapter_id": 10160, "verse_number": "८-७-१७", "content_sanskrit": "मेघश्यामः कनकपरिधिः कर्णविद्योतविद्युन् मूर्ध्नि भ्राजद्विलुलितवनस्रग्धरो रक्तनेत्रः।\nजैत्रैर्दोर्भिर्जगदभयदैर्दन्दशूकं गृहीत्वा मथ्नन् मथ्ना प्रतिगिरिरिवाशोभताथो धृताद्रिः॥ ८/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.018.m4a", "display_order": 19}, {"id": 6000160019, "chapter_id": 10160, "verse_number": "८-७-१८", "content_sanskrit": "निर्मथ्यमानादुदधेरभूद् विषं महोल्बणं हालहलाह्वमग्रतः।\nसंभ्रान्तमीनोन्मकराहिकच्छपोत्तिमिद्विपग्राहतिमिङ्गिलाकुलात्॥ ८/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.019.m4a", "display_order": 20, "topics": [{"text": "रुद्रेण विषपानम्", "range": "१८–४६"}]}, {"id": 6000160020, "chapter_id": 10160, "verse_number": "८-७-१९", "content_sanskrit": "तदुग्रवेगं दिशि दिश्युपर्यधो विसर्पदुत्सर्पदसह्यवीर्यम्।\nभीताः प्रजा दुद्रुवुरङ्ग सेश्वरा अरक्ष्यमाणाः शरणं सदाशिवम्॥ ८/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.020.m4a", "display_order": 21}, {"id": 6000160021, "chapter_id": 10160, "verse_number": "८-७-२०", "content_sanskrit": "विलोक्य तं देववरं त्रिलोक्या भवाय देव्याऽभियुतं मुनीनाम्।\nआसीनमद्रावपवर्गहेतोस्तपो जुषाणं स्तुतिभिः प्रणेमुः॥ ८/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.021.m4a", "display_order": 22}, {"id": 6000160022, "chapter_id": 10160, "verse_number": null, "content_sanskrit": "प्रजा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.022.m4a", "display_order": 23}, {"id": 6000160023, "chapter_id": 10160, "verse_number": "८-७-२१", "content_sanskrit": "देवदेव महादेव भूतात्मन् भूतभावन।\nत्राहि नः शरणापन्नान् त्रैलोक्यदहनाद् विषात्॥ ८/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.023.m4a", "display_order": 24}, {"id": 6000160024, "chapter_id": 10160, "verse_number": "८-७-२२", "content_sanskrit": "त्वमेकः सर्वजगत ईश्वरो बन्धमोक्षयोः।\nतं त्वामर्चन्ति कुशलाः प्रपन्नार्तिहरं गुरुम्॥ ८/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.024.m4a", "display_order": 25}, {"id": 6000160025, "chapter_id": 10160, "verse_number": "८-७-२३", "content_sanskrit": "गुणमय्या स्वशक्त्याऽस्य सर्गस्थित्यप्ययान् विभो।\nधत्से यदा स्वदृग् भूमन् ब्रह्मविष्णुशिवाभिधाम्॥ ८/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.025.m4a", "display_order": 26}, {"id": 6000160026, "chapter_id": 10160, "verse_number": "८-७-२४", "content_sanskrit": "त्वं ब्रह्म परमं गुह्यं सदसद्भावभावनम्।\nनानाशक्तिभिराभासस्त्वमात्मा जगदीश्वरः॥ ८/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.026.m4a", "display_order": 27}, {"id": 6000160027, "chapter_id": 10160, "verse_number": "८-७-२५", "content_sanskrit": "त्वं शब्दयोनिर्जगदादिरात्मा प्राणेन्द्रियद्रव्यगुणस्वभावः।\nकालः क्रतुः सत्यमृतं च धर्मस्त्वय्यक्षरं यत् त्रिवृदामनन्ति॥ ८/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.027.m4a", "display_order": 28}, {"id": 6000160028, "chapter_id": 10160, "verse_number": "८-७-२६", "content_sanskrit": "अग्निर्मुखं तेऽखिलदेवतात्मा क्षितिं विदुर्लोकभवाङ्घ्रिपङ्कजम्।\nकालो गतिस्तेऽखिलदेवतात्मनो दिशश्च कर्णौ रसनं जलेशः॥ ८/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.028.m4a", "display_order": 29}, {"id": 6000160029, "chapter_id": 10160, "verse_number": "८-७-२७", "content_sanskrit": "नाभिर्नभस्ते श्वसनं नभस्वान् सूर्यश्च चक्षूंषि जलं स्म रेतः।\nपरावरात्मा द्रुहिणस्तवात्मा सोमो मनो द्यौर्भगवंच्छिरस्ते॥ ८/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.029.m4a", "display_order": 30}, {"id": 6000160030, "chapter_id": 10160, "verse_number": "८-७-२८", "content_sanskrit": "कुक्षिः समुद्रा गिरयोऽस्थिसङ्घा रोमाणि सर्वौषधिवीरुधस्ते।\nछन्दांसि साक्षात् तव सप्तधातवस्‍त्रयीमयात्मन् हृदयं स धर्मः॥ ८/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.030.m4a", "display_order": 31}, {"id": 6000160031, "chapter_id": 10160, "verse_number": "८-७-२९", "content_sanskrit": "मुखानि पञ्चोपनिषत् तवेश यैस्‍त्रिंशदष्टोत्तरमन्त्रवर्गः।\nयत् तच्छिवाख्यं परमात्मतत्त्वं देव स्वयंज्योतिरवस्थितिस्ते॥ ८/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.031.m4a", "display_order": 32}, {"id": 6000160032, "chapter_id": 10160, "verse_number": "८-७-३०", "content_sanskrit": "छाया त्वधर्मो मृड यैर्विसर्गो नेत्रत्रयं सत्त्वरजस्तमांसि।\nसाक्षान्मनुः शास्‍त्रकृतस्तवेक्षा छन्दोमयो देवऋषिः पुराणः॥ ८/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.032.m4a", "display_order": 33}, {"id": 6000160033, "chapter_id": 10160, "verse_number": "८-७-३१", "content_sanskrit": "न ते गिरित्राखिललोकपाल विरिञ्चवैकुण्ठसुरेन्द्रगम्यम्।\nज्योतिः परं यत्र रजस्तमश्च सत्त्वं न यद् ब्रह्म निरस्तभेदम्॥ ८/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.033.m4a", "display_order": 34}, {"id": 6000160034, "chapter_id": 10160, "verse_number": "८-७-३२", "content_sanskrit": "कामाध्वरत्रिपुरकालहराद्यनेकभूतद्रुहः क्षपयतः स्तुतये न तत् ते।\nयत्त्वन्तकाल इदमात्मकृतं स्वनेत्रवह्निस्फुलिङ्गशिखया भसितं तवेश॥ ८/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.034.m4a", "display_order": 35}, {"id": 6000160035, "chapter_id": 10160, "verse_number": "८-७-३३", "content_sanskrit": "ये त्वात्मरामगुरुभिर्हृदि चिन्तिताङ्घ्रिद्वन्द्वं चरन्तमुमया तपसेऽभितप्तम्।\nकत्थन्त उग्रवपुषं निरतं श्मशाने ते भूतभूतिमविदस्तव हीनलज्जाः॥ ८/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.035.m4a", "display_order": 36}, {"id": 6000160036, "chapter_id": 10160, "verse_number": "८-७-३४", "content_sanskrit": "तत् तस्य ते सदसतोः परतः परस्य नाञ्जः स्वरूपगमने प्रभवन्ति भूम्नः।\nब्रह्मादयः किमुत संस्तवने वयं तु तत्सर्गसर्गविषया अपि भक्तिमात्रम्॥ ८/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.036.m4a", "display_order": 37}, {"id": 6000160037, "chapter_id": 10160, "verse_number": "८-७-३५", "content_sanskrit": "एतत्परं प्रपश्यामो न परं ते महेश्वर।\nमृडनाय हि लोकस्य व्यक्तिस्तेऽव्यक्तकर्मणः॥ ८/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.037.m4a", "display_order": 38}, {"id": 6000160038, "chapter_id": 10160, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.038.m4a", "display_order": 39}, {"id": 6000160039, "chapter_id": 10160, "verse_number": "८-७-३६", "content_sanskrit": "तद् वीक्ष्य व्यसनं तासां कृपया भृशपीडितः।\nसर्वभूतसुहृद् देव इदमाह सतीं प्रियाम्॥ ८/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.039.m4a", "display_order": 40}, {"id": 6000160040, "chapter_id": 10160, "verse_number": null, "content_sanskrit": "शिव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.040.m4a", "display_order": 41}, {"id": 6000160041, "chapter_id": 10160, "verse_number": "८-७-३७", "content_sanskrit": "अहो बत भवान्येतत् प्रजानां पश्य वैशसम्।\nक्षीरोदमथनोद्भूतात् कालकूटादुपस्थितम्॥ ८/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.041.m4a", "display_order": 42}, {"id": 6000160042, "chapter_id": 10160, "verse_number": "८-७-३८", "content_sanskrit": "आसां प्राणपरीप्सूनां विधेयमभयं हि मे।\nएतावान् हि प्रभोरर्थो यद् दीनपरिपालनम्॥ ८/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.042.m4a", "display_order": 43}, {"id": 6000160043, "chapter_id": 10160, "verse_number": "८-७-३९", "content_sanskrit": "प्राणैः स्वैः प्राणिनः पान्ति साधवः क्षणभङ्गुरैः।\nबद्धवैरेषु भूतेषु मोहितेष्वात्ममायया॥ ८/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.043.m4a", "display_order": 44}, {"id": 6000160044, "chapter_id": 10160, "verse_number": "८-७-४०", "content_sanskrit": "पुंसः कृपयतो भद्रे सर्वात्मा प्रीयते हरिः। प्रीते हरौ भगवति प्रीयेऽहं सचराचरः।\nतस्मादिदं गरं भुञ्जे प्रजानां स्वस्तिरस्तु मे॥ ८/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.044.m4a", "display_order": 45}, {"id": 6000160045, "chapter_id": 10160, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.045.m4a", "display_order": 46}, {"id": 6000160046, "chapter_id": 10160, "verse_number": "८-७-४१", "content_sanskrit": "एवमामन्त्र्य भगवान् भवानीं विश्वभावनः।\nतद् विषं जग्धुमारेभे प्रभावज्ञाऽन्वमोदत॥ ८/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.046.m4a", "display_order": 47}, {"id": 6000160047, "chapter_id": 10160, "verse_number": "८-७-४२", "content_sanskrit": "ततः करतलीकृत्य व्यापि हालाहलं विषम्।\nअभक्षयन्महादेवः कृपया भूतभावनः॥ ८/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.047.m4a", "display_order": 48}, {"id": 6000160048, "chapter_id": 10160, "verse_number": "८-७-४३", "content_sanskrit": "तस्यापि दर्शयामास स्ववीर्यं गलकल्मषः।\nयच्चकार गले नीलं तच्च साधोर्विभूषणम्॥ ८/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.048.m4a", "display_order": 49}, {"id": 6000160049, "chapter_id": 10160, "verse_number": "८-७-४४", "content_sanskrit": "तप्यन्ते लोकतापेन साधवः प्रायशो जनाः।\nपरमाराधनं तद्धि पुरुषस्याखिलात्मनः॥ ८/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.049.m4a", "display_order": 50}, {"id": 6000160050, "chapter_id": 10160, "verse_number": "८-७-४५", "content_sanskrit": "निशाम्य कर्म तच्छम्भोर्देवदेवस्य मीढुषः।\nप्रजा दाक्षायणी ब्रह्मा वैकुण्ठश्च शशंसिरे॥ ८/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.050.m4a", "display_order": 51}, {"id": 6000160051, "chapter_id": 10160, "verse_number": "८-७-४६", "content_sanskrit": "प्रस्कन्नं पिबतः पाणेर्यत् किञ्चिज्जगृहुः स्म तत्।\nवृश्चिकाहिविषौषध्यो दन्दशूकाश्च ये परे॥ ८/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_007/BhP_08.007.051.m4a", "display_order": 52}, {"id": 6000160052, "chapter_id": 10160, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]