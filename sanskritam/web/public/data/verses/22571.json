[{"id": 7002571000, "chapter_id": 22571, "verse_number": "२-१७-१", "content_sanskrit": "सूत उवाच ।\nयज्ञभेदं त्रिभेदं च वक्ष्ये शास्त्रमतं यथा ।\nयथावेदानुसारेण यथाग्रहण योजनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002571001, "chapter_id": 22571, "verse_number": "२-१७-२", "content_sanskrit": "शतार्धे वह्निरुद्दिष्टः शतार्धे काश्यपः स्मृतः ।\nघृतप्रदीपके विष्णुस्तिलयागे वनस्पतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002571002, "chapter_id": 22571, "verse_number": "२-१७-३", "content_sanskrit": "सहस्रे ब्राह्मणो नाम अयुते हरिरुच्यते ।\nलक्षहोमे तु वह्निः स्यात्कोटिहोमे हुताशनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002571003, "chapter_id": 22571, "verse_number": "२-१७-४", "content_sanskrit": "वरुणः शांतिके ज्ञेयो मारणे ह्यरुणः स्मृतः ।\nनित्यहोमेऽनलो नाम प्रायश्चित्ते हुताशनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002571004, "chapter_id": 22571, "verse_number": "२-१७-५", "content_sanskrit": "लोहितश्चान्नयज्ञे यो ग्रहाणां प्रत्यनुक्रमात् ।\nदेवप्रतिष्ठायागे तु लोहितः परिकीर्तितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002571005, "chapter_id": 22571, "verse_number": "२-१७-६", "content_sanskrit": "प्रजापतिर्वास्तुयागे मंडपे चापि पद्मके ।\nप्रपायां चैव नागाख्यो महादाने हविर्भुजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002571006, "chapter_id": 22571, "verse_number": "२-१७-७", "content_sanskrit": "गोदाने च भवेद्रुद्रः कन्यादाने तु गोऽजकः ।\nतुलापुरुषदाने च धाताग्निः परिकीर्तितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002571007, "chapter_id": 22571, "verse_number": "२-१७-८", "content_sanskrit": "वृषोत्सर्गे भवेत्सूर्योऽवसानांते रविः स्मृतः ।\nपावको वैश्वदेवे च दीक्षापक्षे जनार्दनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002571008, "chapter_id": 22571, "verse_number": "२-१७-९", "content_sanskrit": "त्रासने च भवेत्कालः क्रव्यादः शरदाहने ।\nपर्णदाहे यमो नाम ह्यस्थिदाहे शिखंडिकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002571009, "chapter_id": 22571, "verse_number": "२-१७-१०", "content_sanskrit": "गर्भाधाने च मरुतः सीमंते पिंगलः स्मृतः ।\nपुंसवे त्विंद्र आख्यातः प्रशस्तो यागकर्मणि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002571010, "chapter_id": 22571, "verse_number": "२-१७-११", "content_sanskrit": "नामसंस्थापने चैवमुपन्यस्ते च पार्थिवः ।\nनिष्क्रमे हाटकश्चैव प्राशने च शुचिस्तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002571011, "chapter_id": 22571, "verse_number": "२-१७-१२", "content_sanskrit": "षडाननश्च चूडायां व्रतादेशे समुद्भवः ।\nवीतिहोत्रश्चोपनये समावर्ते धनंजयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002571012, "chapter_id": 22571, "verse_number": "२-१७-१३", "content_sanskrit": "उदरे जठराग्निश्च समुद्रे वडवानलः ।\nशिखायां च विभुर्ज्ञेयः स्वरस्याग्निः सरीसृपः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002571013, "chapter_id": 22571, "verse_number": "२-१७-१४", "content_sanskrit": "अश्वाग्निर्मंथरो नाम रथाग्निर्जातवेदसः ।\nगजाग्निर्मंदरश्चैव सूर्याग्निर्विंध्यसंज्ञकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002571014, "chapter_id": 22571, "verse_number": "२-१७-१५", "content_sanskrit": "तोयाग्निर्वरुणोनाम ब्राह्मणाग्निर्हविर्भुजः ।\nपर्वताग्निः क्रतुभुजो दावाग्निः सूर्य उच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002571015, "chapter_id": 22571, "verse_number": "२-१७-१६", "content_sanskrit": "दीपाग्निः पावको नाम गृह्याग्निर्धरणीपतिः ।\nघृताग्निश्च नलो वायुः सूतिकाग्निश्च राक्षसः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]