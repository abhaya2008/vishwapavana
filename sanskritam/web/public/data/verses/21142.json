[{"id": 7001142000, "chapter_id": 21142, "verse_number": "२-२-३३-१", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्तं श्रीमहेशस्य श्रुत्वा वचनमादरात् ।\nवीरभद्रोतिसंतुष्टः प्रणनाम महेश्वरम॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001142001, "chapter_id": 21142, "verse_number": "२-२-३३-२", "content_sanskrit": "शासनं शिरसा धृत्वा देवदेवस्य शूलिनः ।\nप्रचचाल ततः शीघ्रं वीरभद्रो मखं प्रति॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001142002, "chapter_id": 21142, "verse_number": "२-२-३३-३", "content_sanskrit": "शिवोथ प्रेषयामास शोभार्थं कोटिशो गणान् ।\nतेन सार्द्धं महावीरान्मलयानलसन्निभान्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001142003, "chapter_id": 21142, "verse_number": "२-२-३३-४", "content_sanskrit": "अथ ते वीरभद्रस्य पुरतः प्रबला गणाः ।\nपश्चादपि ययुर्वीराः कुतूहलकरा गणाः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001142004, "chapter_id": 21142, "verse_number": "२-२-३३-५", "content_sanskrit": "वीरभद्रसमेता येगणाश्शतसहस्रशः ।\nपार्षदाः कालकालस्य सर्वे रुद्रस्वरूपिणः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001142005, "chapter_id": 21142, "verse_number": "२-२-३३-६", "content_sanskrit": "गणैस्समेतः किलतैर्महात्मा स वीरभद्रो हरवेषभूषणः ।\nसहस्रबाहुर्भुजगाधिपाढ्यो ययौ रथस्थः प्रबलोतिभीकरः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001142006, "chapter_id": 21142, "verse_number": "२-२-३३-७", "content_sanskrit": "नल्वानं च सहस्रे द्वे प्रमाणं स्यंदनस्य हि ।\nअयुतेनैव सिंहानां वाहनानां प्रयत्नतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001142007, "chapter_id": 21142, "verse_number": "२-२-३३-८", "content_sanskrit": "तथैव प्रबलाः सिंहा बहवः पार्श्वरक्षकाः ।\nशार्दूला मकरा मत्स्या गजास्तत्र सहस्रशः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001142008, "chapter_id": 21142, "verse_number": "२-२-३३-९", "content_sanskrit": "वीरभद्रे प्रचलिते दक्षनाशाय सत्वरम् ।\nकल्पवृक्षसमुत्सृष्टा पुष्पवृष्टिरभूत्तदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001142009, "chapter_id": 21142, "verse_number": "२-२-३३-१०", "content_sanskrit": "तुष्टुवुश्च गणा वीर शिपिविष्टे प्रचेष्टितम् ।\nचक्रुः कुतूहलं सर्वे तस्मिंश्च गमनोत्सवैः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001142010, "chapter_id": 21142, "verse_number": "२-२-३३-११", "content_sanskrit": "काली कात्यायिनीशानी चामुंडा मुंडमर्दिनी ।\nभद्रकाली तथा भद्रा त्वरिता वैष्णवी तथा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001142011, "chapter_id": 21142, "verse_number": "२-२-३३-१२", "content_sanskrit": "एताभिर्नवदुर्गाभिर्महाकाली समन्विता ।\nययौ दक्षविनाशाय सर्वभूतगणैस्सह॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001142012, "chapter_id": 21142, "verse_number": "२-२-३३-१३", "content_sanskrit": "डाकिनी शाकिनी चैव भूतप्रमथगुह्यकाः ।\nकूष्मांडाः पर्पटा श्चैव चटका ब्रह्मराक्षसाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001142013, "chapter_id": 21142, "verse_number": "२-२-३३-१४", "content_sanskrit": "भैरवाः क्षेत्रपालाश्च दक्षयज्ञविनाशकाः ।\nनिर्ययुस्त्वरितं वीराश्शिवाज्ञाप्रतिपालकाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001142014, "chapter_id": 21142, "verse_number": "२-२-३३-१५", "content_sanskrit": "तथैव योगिनीचक्रं चतुःषष्टिगणान्वितम् ।\nनिर्ययौ सहसा क्रुद्धं दक्षयज्ञं विनाशितुम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001142015, "chapter_id": 21142, "verse_number": "२-२-३३-१६", "content_sanskrit": "तेषां गणानां सर्वेषां संख्यानं शृणु नारद ।\nमहाबलवतां संघोमुख्यानां धैर्यशालिनाम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001142016, "chapter_id": 21142, "verse_number": "२-२-३३-१७", "content_sanskrit": "अभ्ययाच्छंकुकर्णश्च दशकोट्या गणेश्वरः ।\nदशभिः केकराक्षश्च विकृतो ष्टाभिरेव॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001142017, "chapter_id": 21142, "verse_number": "२-२-३३-१८", "content_sanskrit": "चतुःषष्ट्या विशाखश्च नवभिः पारियात्रिकः ।\nषड्भिस्सर्वाङ्गको वीरस्तथैव विकृताननः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001142018, "chapter_id": 21142, "verse_number": "२-२-३३-१९", "content_sanskrit": "ज्वालकेशो द्वादशभिः कोटिभिर्गणपुंगवः ।\nसप्तभिः समदज्जीमान् दुद्रभोष्टाभिरेव च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001142019, "chapter_id": 21142, "verse_number": "२-२-३३-२०", "content_sanskrit": "पंचभिश्च कपालीशः षड्भिस्संदारको गणः ।\nकोटिकोटिभिरेवेह कोटिकुण्डस्तथैव च॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001142020, "chapter_id": 21142, "verse_number": "२-२-३३-२१", "content_sanskrit": "विष्टंभोऽष्टाभिर्वीरैः कोटिभिर्गणसप्तमः ।\nसहस्रकोटिभिस्तात संनादः पिप्पलस्तथा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001142021, "chapter_id": 21142, "verse_number": "२-२-३३-२२", "content_sanskrit": "आवेशनस्तथाष्टाभिरष्टाभिश्चंद्रतापनः ।\nमहावेशः सहस्रेण कोटिना गणपो वृतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001142022, "chapter_id": 21142, "verse_number": "२-२-३३-२३", "content_sanskrit": "कुण्डी द्वादशकोटीभिस्तथा पर्वतको मुने ।\nविनाशितुं दक्षयज्ञं निर्ययौ गणसत्तम॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001142023, "chapter_id": 21142, "verse_number": "२-२-३३-२४", "content_sanskrit": "कालश्च कालकश्चैव महाकालस्तथैव च ।\nकोटीनां शतकेनैव दक्षयज्ञं ययौ प्रति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001142024, "chapter_id": 21142, "verse_number": "२-२-३३-२५", "content_sanskrit": "अग्निकृच्छतकोट्या च कोट्याग्निमुख एव च ।\nआदित्यमूर्द्धा कोट्या च तथा चैव घनावहः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001142025, "chapter_id": 21142, "verse_number": "२-२-३३-२६", "content_sanskrit": "सन्नाहश्शतकोट्या च कोट्या च कुमुदो गणः ।\nअमोघः कोकिलश्चैव कोटिकोट्या गणाधिपः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001142026, "chapter_id": 21142, "verse_number": "२-२-३३-२७", "content_sanskrit": "काष्ठागूढश्चतुःषष्ट्या सुकेशी वृषभस्तथा ।\nसुमन्त्रको गणाधीशस्तथा तात सुनिर्ययौ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001142027, "chapter_id": 21142, "verse_number": "२-२-३३-२८", "content_sanskrit": "काकपादोदरः षष्टिकोटिभिर्गणसत्तमः ।\nतथा सन्तानकः षष्टिकोटिभिर्गणपुंगवः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001142028, "chapter_id": 21142, "verse_number": "२-२-३३-२९", "content_sanskrit": "महाबलश्च नवभिः कोटिभिः पुंगवस्तथा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001142029, "chapter_id": 21142, "verse_number": "२-२-३३-३०", "content_sanskrit": "मधुपिंगस्तथा तात गणाधीशो हि निर्ययौ ।\nनीलो नवत्या कोटीनां पूर्णभद्रस्तथैव च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001142030, "chapter_id": 21142, "verse_number": "२-२-३३-३१", "content_sanskrit": "निर्ययौ शतकोटीभिश्चतुर्वक्त्रो गणाधिपः ।\nकाष्ठागूढेश्चतुष्षष्ट्या सुकेशो वृषभस्तथा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001142031, "chapter_id": 21142, "verse_number": "२-२-३३-३२", "content_sanskrit": "विरूपाक्षश्च कोटीनां चतुःषष्ट्या गणेश्वरः ।\nतालकेतुः षडास्यश्च पंचास्यश्च गणाधिपः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001142032, "chapter_id": 21142, "verse_number": "२-२-३३-३३", "content_sanskrit": "संवर्तकस्तथा चैव कुलीशश्च स्वयं प्रभुः ।\nलोकांतकश्च दीप्तात्मा तथा दैत्यान्तको मुने॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001142033, "chapter_id": 21142, "verse_number": "२-२-३३-३४", "content_sanskrit": "गणो भृंगीरिटिः श्रीमान् देवदेवप्रियस्तथा ।\nअशनिर्भालकश्चैव चतुःषष्ट्या सह्स्रकः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001142034, "chapter_id": 21142, "verse_number": "२-२-३३-३५", "content_sanskrit": "कोटिकोटिसहस्राणां शतैर्विंश तिभिर्वृतः ।\nवीरेशो ह्यभ्ययाद्वीरः वीरभद्र शिवाज्ञया॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001142035, "chapter_id": 21142, "verse_number": "२-२-३३-३६", "content_sanskrit": "भूतकोटिसहस्रैस्तु प्रययौ कोटिभिस्त्रिभिः ।\nरोमजैः श्वगणै श्चैव तथा वीरो ययौ द्रुतम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001142036, "chapter_id": 21142, "verse_number": "२-२-३३-३७", "content_sanskrit": "तदा भेरीमहानादः शंखाश्च विविधस्वनाः ।\nजटाहरोमुखाश्चैव शृंगाणि विविधानि च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001142037, "chapter_id": 21142, "verse_number": "२-२-३३-३८", "content_sanskrit": "ते तानि विततान्येव बंधनानि सुखानि च ।\nवादित्राणि विनेदुश्च विविधानि महोत्सवे॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001142038, "chapter_id": 21142, "verse_number": "२-२-३३-३९", "content_sanskrit": "वीरभद्रस्य यात्रायां सबलस्य महामुने ।\nशकुनान्यभवंस्तत्र भूरीणि सुखदानि च॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]