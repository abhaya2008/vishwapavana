[{"id": 2123079, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123080, "chapter_id": 3643, "verse_number": "१", "content_sanskrit": "बहु वित्तं पराजैषीः पाण्डवानां युधिष्ठिर ।\nआचक्ष्व वित्तं कौन्तेय यदि तेऽस्त्यपराजितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123081, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123082, "chapter_id": 3643, "verse_number": "२", "content_sanskrit": "मम वित्तमसङ्ख्येयं यदहं वेद्मि सौबल ।\nअथ त्वं शकुने कस्माद् वित्तं समनुपृच्छसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123083, "chapter_id": 3643, "verse_number": "३", "content_sanskrit": "अयुतं प्रयुतं चैव निखर्वं खर्वमर्बुदम् ।\nप्रखर्वं च निखर्वं च समुद्रं चात्र सौबल ।\nएतन्मम धनं राजन् तेन दीव्याम्यहं त्वया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123084, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123085, "chapter_id": 3643, "verse_number": "४", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123086, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123087, "chapter_id": 3643, "verse_number": "५", "content_sanskrit": "गवाश्वं बहुधेनूकमसङ्ख्येयमजाविकम् ।\nयत्किञ्चिदनुवर्णं च प्राक् सिद्धमपि सौबल ।\nएतन्मम धनं राजन् तेन दीव्याम्यहं त्वया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123088, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123089, "chapter_id": 3643, "verse_number": "६", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123090, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123091, "chapter_id": 3643, "verse_number": "७", "content_sanskrit": "पुरं जनपदो भूमिरब्राह्मणधनैः सह ।\nअब्राह्मणाश्च पुरुषा राजन् शिष्टं धनं मम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123092, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123093, "chapter_id": 3643, "verse_number": "८", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपास्थितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123094, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123095, "chapter_id": 3643, "verse_number": "९", "content_sanskrit": "राजपुत्रा इमे राजन् शोभन्ते यैर्विभूषिताः ।\nकुण्डलानि च निष्काश्च सर्वशश्चाङ्गभूषणाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123096, "chapter_id": 3643, "verse_number": "१०", "content_sanskrit": "वासांसि च विचित्राणि सर्वमन्यद् विनाऽऽयुधैः ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123097, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123098, "chapter_id": 3643, "verse_number": "११", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123099, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123100, "chapter_id": 3643, "verse_number": "१२", "content_sanskrit": "श्यामो युवा लोहिताक्षः सिंहस्कन्धो महाभुजः ।\nनकुलो ग्लह एवैक एतद्वै मद्गतं धनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123101, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123102, "chapter_id": 3643, "verse_number": "१३", "content_sanskrit": "प्रियस्ते नकुलो राजन् राजपुत्रो युधिष्ठिर ।\nअस्माकं धनतां प्राप्तो भूयस्त्वं केन दीव्यसे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123103, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123104, "chapter_id": 3643, "verse_number": "१४", "content_sanskrit": "एवमुक्त्वाऽथ शकुनिस्तानक्षान् प्रत्यपद्यत ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123105, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123106, "chapter_id": 3643, "verse_number": "१५", "content_sanskrit": "अयं धर्मान् सहदेवोऽनुशास्ति\nलोके ह्यस्मिन् पण्डिताख्यां गतश्च ।\nअनर्हता राजपुत्रेण तेन\nत्वया दीव्याम्यप्रियवत् प्रियेण ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123107, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123108, "chapter_id": 3643, "verse_number": "१६", "content_sanskrit": "माद्रीपुत्रौ प्रियौ राजन् तवेमौ विजितौ मया ।\nबलीयांसौ तु तौ मन्ये भीमसेनधनञ्जयौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123109, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123110, "chapter_id": 3643, "verse_number": "१६", "content_sanskrit": "अधर्मं चरसे मूढ यो नावेक्षसि वै नयम् ।\nयो नः सुमनसां त्वं च भेदं कर्तुमिहेच्छसि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123111, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123112, "chapter_id": 3643, "verse_number": "१८", "content_sanskrit": "गर्ते मत्तः प्रपतति प्रमत्तः स्थाणुमृच्छति ।\nज्येष्ठो राजन् वरिष्ठोऽसि नमस्ते भरतर्षभ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123113, "chapter_id": 3643, "verse_number": "१९", "content_sanskrit": "स्वप्नेऽपि तानि पश्यन्ति जाग्रतोऽपि युधिष्ठिर ।\nकितवाश्चापि दीव्यन्तः प्रलपन्त्युत्कटा इव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123114, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123115, "chapter_id": 3643, "verse_number": "२०", "content_sanskrit": "यो नः सङ्घे नौरिव पारनेता\nजेताऽरीणां राजपुत्रस्तरस्वी ।\nअनर्हता लोकवीरेण तेन\nदीव्याम्यहं शकुने फल्गुनेन ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123116, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123117, "chapter_id": 3643, "verse_number": "२१", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपास्थितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123118, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123119, "chapter_id": 3643, "verse_number": "२२", "content_sanskrit": "अयं मया पाण्डवानां धनुर्धरः\nपराजितः पाण्डवः सव्यसाची ।\nभीमेन राजन् दयितेन दीव्य\nयो जेतव्यः पाण्डव तेऽवशिष्टः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123120, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123121, "chapter_id": 3643, "verse_number": "२३", "content_sanskrit": "सेनां नेता संयुगार्थं प्रणेता\nयथा वज्री दानवशत्रुरेकः ।\nतिर्यक्प्रेक्षी सङ्गतभ्रूर्महात्मा\nसिंहस्कन्धो यश्च सदाऽत्यमर्षी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2123122, "chapter_id": 3643, "verse_number": "२४", "content_sanskrit": "बलेन तुल्यो यस्य पुमान् न विद्यते\nगदाभृतामग्र्य इहारिमर्दनः ।\nअनर्हता राजपुत्रेण तेन\nदीव्याम्यहं भीमसेनेन राजन् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2123123, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2123124, "chapter_id": 3643, "verse_number": "२५", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2123125, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2123126, "chapter_id": 3643, "verse_number": "२६", "content_sanskrit": "बहु वित्तं पराजैषीर्भ्रातॄंश्च सहयद्विपान् ।\nआचक्ष्व वित्तं कौन्तेय यदि तेऽस्त्यपराजितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2123127, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2123128, "chapter_id": 3643, "verse_number": "२७", "content_sanskrit": "अहं विशिष्टः सर्वेषां भ्रातॄणां दयितस्तथा ।\nकुर्यामस्ते जिताः कर्म स्वयमात्मन्युपग्रहे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2123129, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2123130, "chapter_id": 3643, "verse_number": "२८", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपास्थितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2123131, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2123132, "chapter_id": 3643, "verse_number": "२९", "content_sanskrit": "एतत् पापिष्ठमकरोर्यदात्मानं पराजयः ।\nशिष्टे सति धने राजन् पाप आत्मपराजयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2123133, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2123134, "chapter_id": 3643, "verse_number": "३०", "content_sanskrit": "एवमुक्त्वा मताक्षस्तान् ग्लहे सर्वानवस्थितान् ।\nअपाजयल्लोकवीरान् महाराज पृथक् पृथक् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2123135, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2123136, "chapter_id": 3643, "verse_number": "३१", "content_sanskrit": "अतीव ते प्रिया देवी ग्लह एकोऽपराजितः ।\nपणस्व कृष्णां पाञ्चालीं तथा(या)ऽऽत्मानं पुनर्जय ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2123137, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2123138, "chapter_id": 3643, "verse_number": "३२", "content_sanskrit": "नैव ह्रस्वा न महती न कृशा नच रोहिणी ।\nसा रागरक्तवसना तया दीव्याम्यहं त्वया ।\nशारदोत्पलपत्नाक्ष्या शारदोत्पलगन्धया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2123139, "chapter_id": 3643, "verse_number": "३३", "content_sanskrit": "तथैव स्यादानृशंस्यं तथा स्यू रूपसम्पदः ।\nतथा स्यात् पुण्यसम्पत्त्या यामिच्छेत् पुरुषः स्त्रियम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2123140, "chapter_id": 3643, "verse_number": "३४", "content_sanskrit": "यादृशीं धर्म्मकामार्थसिद्धिमिच्छेन्नरः स्त्रियम् ।\nचरमं संस्वपति या प्रथमं प्रतिबुध्यते ।\nआगोपालाविपालेभ्यः सर्वं वेद कृताकृतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2123141, "chapter_id": 3643, "verse_number": "३५", "content_sanskrit": "आभाति पद्मवद् वक्त्रंसस्मिता मल्लिकेव च ।\nवेदीमध्या दीर्घकेशी ताम्राक्षी नातिरोमशा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2123142, "chapter_id": 3643, "verse_number": "३६", "content_sanskrit": "तथैवंविधया राजन् पाञ्चाल्याऽहं सुमध्यया ।\nग्लहं दीव्यामि चार्वङ्ग्या द्रौपद्या हन्त सौबल ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2123143, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2123144, "chapter_id": 3643, "verse_number": "३७", "content_sanskrit": "एवमुक्ते तु वचने धर्मराजेन भारत ।\nधिग्धिगित्येव वुद्धानां सभ्यानां निस्सृता गिरः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2123145, "chapter_id": 3643, "verse_number": "३८", "content_sanskrit": "चुक्षुभे सा सभा राजन् राज्ञां सञ्जज्ञिरे कथाः ।\nभीष्मद्रोणकृपादीनां खेदश्च समजायत ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2123146, "chapter_id": 3643, "verse_number": "३९", "content_sanskrit": "शिरो गृहीत्वा विदुरो गतसत्व इवाभवत् ।\nआस्ते ध्यायन्नधोवक्त्रो निश्श्वसन्निव पन्नगः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2123147, "chapter_id": 3643, "verse_number": "४०", "content_sanskrit": "धृतराष्ट्रस्तु संहृष्टः पर्यपृच्छत् पुनः पुनः ।\nकिं जितं किं जितमिति व्याकारं नाभ्यरक्षत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2123148, "chapter_id": 3643, "verse_number": "४१", "content_sanskrit": "जहर्ष कर्णोऽतिभृशं सह दुश्शासनादिभिः ।\nइतरेषां तु सभ्यानां नेत्रेभ्यः प्रापतज्जलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2123149, "chapter_id": 3643, "verse_number": "४२", "content_sanskrit": "सौबलस्त्वविचार्यैव जितकाशी मदोत्कटः ।\nजितमित्येव तानक्षान् पुनरेवान्वपद्यत ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2123150, "chapter_id": 3643, "verse_number": "१७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वणि\nपञ्चाशीतितमोऽध्यायः ॥८५॥\n॥ द्यूतपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2123151, "chapter_id": 3643, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]