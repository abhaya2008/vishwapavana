[{"id": 6000328000, "chapter_id": 10328, "verse_number": null, "content_sanskrit": "अथ सप्तविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000328001, "chapter_id": 10328, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.001.m4a", "display_order": 2}, {"id": 6000328002, "chapter_id": 10328, "verse_number": "११-२७-१", "content_sanskrit": "क्रियायोगं समाचक्ष्व भवदाराधनं प्रभो।\nयेन त्वां ये यथाऽर्चन्ति सात्वताः सात्वतर्षभ॥ ११/२७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेनोद्धवाय क्रियायोगे अर्चाप्रभेदस्य पूजाविधानस्य च कथनम्", "range": "१–५४"}]}, {"id": 6000328003, "chapter_id": 10328, "verse_number": "११-२७-२", "content_sanskrit": "एतद् वदन्ति मुनयो मुहुर्निःश्रेयसं नृणाम्।\nनारदो भगवान् व्यास आचार्योऽङ्गिरसःसुतः॥ ११/२७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.003.m4a", "display_order": 4}, {"id": 6000328004, "chapter_id": 10328, "verse_number": "११-२७-३", "content_sanskrit": "निःसृतं ते मुखाम्भोजाद् यदाह भगवानजः।\nपुत्रेभ्यो भृगुमुख्येभ्यो देव्यै च भगवान् भवः॥ ११/२७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.004.m4a", "display_order": 5}, {"id": 6000328005, "chapter_id": 10328, "verse_number": "११-२७-४", "content_sanskrit": "एतद् वै सर्ववर्णानामाश्रमाणां च सम्मतम्।\nश्रेयसामुत्तमं मन्ये स्त्रीशूद्राणां च मानद॥ ११/२७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.005.m4a", "display_order": 6}, {"id": 6000328006, "chapter_id": 10328, "verse_number": "११-२७-५", "content_sanskrit": "एतत्कमलपत्राक्ष कर्मबन्धविमोचनम्।\nभक्ताय चानुरक्ताय ब्रूहि विश्वेश्वरेश्वर॥ ११/२७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.006.m4a", "display_order": 7}, {"id": 6000328007, "chapter_id": 10328, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.007.m4a", "display_order": 8}, {"id": 6000328008, "chapter_id": 10328, "verse_number": "११-२७-६", "content_sanskrit": "न ह्यन्तोऽनन्तपारस्य कर्मकाण्डस्य चोद्धव।\nसंक्षिप्तं वर्णयिष्यामि यथावदनुपूर्वशः॥ ११/२७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.008.m4a", "display_order": 9}, {"id": 6000328009, "chapter_id": 10328, "verse_number": "११-२७-७", "content_sanskrit": "वैदिकस्तान्त्रिको मिश्र इति मे त्रिविधो मखः।\nत्रयाणामीप्सितेनैव विधिना मां समाचरेत्॥ ११/२७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.009.m4a", "display_order": 10}, {"id": 6000328010, "chapter_id": 10328, "verse_number": "११-२७-८", "content_sanskrit": "यथा स्वनिगमेनोक्तं द्विजत्वं प्राप्य पूरुषः।\nयथा यजेत मां भक्त्या श्रद्धया तं निबोध मे॥ ११/२७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.010.m4a", "display_order": 11}, {"id": 6000328011, "chapter_id": 10328, "verse_number": "११-२७-९", "content_sanskrit": "अर्चायां स्थण्डिलेऽग्नौ वा सूर्येऽप्सु हृदि वा द्विजे।\nद्रव्येण भक्तियुक्तोऽर्चेत् स्वगुरुं माममायया॥ ११/२७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.011.m4a", "display_order": 12}, {"id": 6000328012, "chapter_id": 10328, "verse_number": "११-२७-१०", "content_sanskrit": "पूर्वं स्नानं प्रकुर्वीत धौतदन्तोऽङ्गशुद्धये।\nउभयैरपि च स्नानं मन्त्रैर्मृद्ग्रहणादिभिः॥ ११/२७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.012.m4a", "display_order": 13}, {"id": 6000328013, "chapter_id": 10328, "verse_number": "११-२७-११", "content_sanskrit": "सन्ध्योपास्त्यादिकर्माणि वेदतन्त्रोदितानि मे।\nपूजां तैः कल्पयेत्सम्यक् सङ्कल्पः कर्मपावनः॥ ११/२७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.013.m4a", "display_order": 14}, {"id": 6000328014, "chapter_id": 10328, "verse_number": "११-२७-१२", "content_sanskrit": "शैली दारुमयी लौही लेप्या लेख्या च सैकती।\nमनोमयी मणिमयी प्रतिमाऽष्टविधा स्मृता॥ ११/२७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.014.m4a", "display_order": 15}, {"id": 6000328015, "chapter_id": 10328, "verse_number": "११-२७-१३", "content_sanskrit": "चलाचलेति द्विविधा प्रतिमा जीवमन्दिरम्।\nउद्वासावाहने न स्तः स्थिरायामुद्धवार्चने॥ ११/२७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.015.m4a", "display_order": 16}, {"id": 6000328016, "chapter_id": 10328, "verse_number": "११-२७-१४", "content_sanskrit": "अस्थिरायां विकल्पः स्यात् स्थण्डिले तु भवेद् द्वयम्।\nस्नपनं तु विलेप्यायामन्यत्र परिमार्जनम्॥ ११/२७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.016.m4a", "display_order": 17}, {"id": 6000328017, "chapter_id": 10328, "verse_number": "११-२७-१५", "content_sanskrit": "द्रव्यैः प्रसिद्धैर्मद्यागः प्रतिमादिष्वमायिनः।\nभक्त्या चैव यथालब्धैर्हृदि भावेन चैव हि॥ ११/२७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.017.m4a", "display_order": 18}, {"id": 6000328018, "chapter_id": 10328, "verse_number": "११-२७-१६", "content_sanskrit": "स्नानालङ्करणं प्रेष्ठमर्चायामेव तूद्धव।\nस्थण्डिले तत्वविन्यासो वह्नावाज्यप्लुतं हविः॥ ११/२७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.018.m4a", "display_order": 19}, {"id": 6000328019, "chapter_id": 10328, "verse_number": "११-२७-१७", "content_sanskrit": "सूर्ये चाभ्यर्हणंप्रेष्ठं सलिले सलिलादिभिः। श्रद्धयोपहृतं श्रेष्ठं भक्तेन मम वार्यपि।\nगन्धो धूपः सुमनसो दीपोऽन्नाद्यं च किं पुनः॥ ११/२७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.019.m4a", "display_order": 20}, {"id": 6000328020, "chapter_id": 10328, "verse_number": "११-२७-१८", "content_sanskrit": "शुचिः सम्भृतसम्भारः प्राग्दर्भैः कल्पितासनः।\nआसीनः प्रागुदग्वाऽर्चेदर्चायां त्वथ सम्मुखः॥ ११/२७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.020.m4a", "display_order": 21}, {"id": 6000328021, "chapter_id": 10328, "verse_number": "११-२७-१९", "content_sanskrit": "कृतन्यासो मदर्चां च पाणिनाऽभिमृजेद् बुधः।\nकलशं प्रोक्षणीयं च यथावदुपसादयेद्॥ ११/२७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.021.m4a", "display_order": 22}, {"id": 6000328022, "chapter_id": 10328, "verse_number": "११-२७-२०", "content_sanskrit": "तदद्भिर्देवयजनं द्रव्याण्यात्मानमेव च।\nप्रोक्ष्य पात्राणि त्रीण्यद्भिस्तैस्तैर्द्रव्यैश्च सादयेत्॥ ११/२७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.022.m4a", "display_order": 23}, {"id": 6000328023, "chapter_id": 10328, "verse_number": "११-२७-२१", "content_sanskrit": "पाद्यार्घ्याचमनीयार्थं त्रीणि पात्राणि देशिकः।\nहृदा शीर्ष्णाऽथशिखया गायत्र्या वाऽभिमन्त्रयेत्॥ ११/२७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.023.m4a", "display_order": 24}, {"id": 6000328024, "chapter_id": 10328, "verse_number": "११-२७-२२", "content_sanskrit": "पिण्डे वाय्वग्निसंशुद्धे हृत्पद्मस्थां परां मम।\nअण्वीं जीवकलां ध्यायेन्नादान्ते सिद्धभाविताम्॥ ११/२७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.024.m4a", "display_order": 25}, {"id": 6000328025, "chapter_id": 10328, "verse_number": "११-२७-२३", "content_sanskrit": "तयाऽऽत्मभूतया पिण्डे व्याप्ते सम्पद्य तन्मयः।\nआवाह्यार्चादिषु स्थाप्य न्यस्ताङ्गं मां प्रपूजयेत्॥ ११/२७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.025.m4a", "display_order": 26}, {"id": 6000328026, "chapter_id": 10328, "verse_number": "११-२७-२४", "content_sanskrit": "पाद्योपस्पर्शनार्घ्यादीनुपचारान् प्रकल्पयेत्।\nधर्मादिभिश्च नवभिः कल्पयित्वाऽऽसनं मम॥ ११/२७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.026.m4a", "display_order": 27}, {"id": 6000328027, "chapter_id": 10328, "verse_number": "११-२७-२५", "content_sanskrit": "पद्ममष्टदलं तत्र कर्णिकाकेसरोज्ज्वलम्।\nउभाभ्यां वेदतन्त्राभ्यां मह्यं तूभयसिद्धये॥ ११/२७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.027.m4a", "display_order": 28}, {"id": 6000328028, "chapter_id": 10328, "verse_number": "११-२७-२६", "content_sanskrit": "सुदर्शनं पाञ्चजन्यं गदासीषुधनुर्हलान्।\nमुसलं कौस्तुभं मालां श्रीवत्सं चानुपूजयेत्॥ ११/२७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.028.m4a", "display_order": 29}, {"id": 6000328029, "chapter_id": 10328, "verse_number": "११-२७-२७", "content_sanskrit": "नन्दं सुनन्दं गरुडं प्रचण्डं चण्डमेव च।\nमहाबलं बलं चैव कुमुदं कुमुदेक्षणम्॥ ११/२७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.029.m4a", "display_order": 30}, {"id": 6000328030, "chapter_id": 10328, "verse_number": "११-२७-२८", "content_sanskrit": "दुर्गां विनायकं व्यासं विष्वक्सेनं गुरून्सुरान्।\nस्वेस्वे स्थाने त्वभिमुखान्पूजयेत् प्रोक्षणादिभिः॥ ११/२७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.030.m4a", "display_order": 31}, {"id": 6000328031, "chapter_id": 10328, "verse_number": "११-२७-२९", "content_sanskrit": "चन्दनोशीरकर्पूरकुङ्कुमागुरुवासितैः।\nसलिलैः स्नापयेन्मन्त्रैर्नित्यदा विभवे सति॥ ११/२७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.031.m4a", "display_order": 32}, {"id": 6000328032, "chapter_id": 10328, "verse_number": "११-२७-३०", "content_sanskrit": "स्वस्य घर्मानुवाकेन महापुरुषविद्यया।\nपौरुषेणापि सूक्तेन धामनीरजनादिभिः॥ ११/२७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.032.m4a", "display_order": 33}, {"id": 6000328033, "chapter_id": 10328, "verse_number": "११-२७-३१", "content_sanskrit": "वस्त्रोपवीताभरणपत्रस्रग्गन्धलेपनैः।\nअलङ्कुर्वीत सप्रेम मद्भक्तो मां यथोचितैः॥ ११/२७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.033.m4a", "display_order": 34}, {"id": 6000328034, "chapter_id": 10328, "verse_number": "११-२७-३२", "content_sanskrit": "पाद्यमाचमनीयं च गन्धं सुमनसोज्वलम्।\nधूपदीपोपहार्याणि दद्यान्मे श्रद्धयाऽर्चकः॥ ११/२७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.034.m4a", "display_order": 35}, {"id": 6000328035, "chapter_id": 10328, "verse_number": "११-२७-३३", "content_sanskrit": "गुडपायससर्पींषि शश्कुल्यापूपमोदकान्।\nसंयावं दधिसूपांश्च नैवेद्यं सति कल्पयेत्॥ ११/२७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.035.m4a", "display_order": 36}, {"id": 6000328036, "chapter_id": 10328, "verse_number": "११-२७-३४", "content_sanskrit": "अभ्यङ्गोन्मर्दनादर्शदन्तधावाभिषेचनम्।\nअन्नादि नृत्यगीतादि पर्वणि स्युस्तथाऽन्वहम्॥ ११/२७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.036.m4a", "display_order": 37}, {"id": 6000328037, "chapter_id": 10328, "verse_number": "११-२७-३५", "content_sanskrit": "विधिना विहिते कुण्डे मेखलावर्तवेदिभिः।\nअग्निमाधाय परितः समूहेत् पाणिनोदितम्॥ ११/२७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.037.m4a", "display_order": 38}, {"id": 6000328038, "chapter_id": 10328, "verse_number": "११-२७-३६", "content_sanskrit": "परिस्तीर्याथ पर्युक्षेदन्वाधाय यथाविधि।\nप्रोक्षणीयानि द्रव्याणि प्रोक्ष्याग्नावावहेत माम्॥ ११/२७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.038.m4a", "display_order": 39}, {"id": 6000328039, "chapter_id": 10328, "verse_number": "११-२७-३७", "content_sanskrit": "तप्तजाम्बूनदप्रख्यं शङ्खचक्रगदाम्बुजैः।\nलसच्चतुर्भुजं शान्तं पद्मकिञ्जल्कवाससम्॥ ११/२७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.039.m4a", "display_order": 40}, {"id": 6000328040, "chapter_id": 10328, "verse_number": "११-२७-३८", "content_sanskrit": "स्फुरत्किरीटकटककटिसूत्रवराङ्गदम्।\nश्रीवत्सवक्षसं भ्राजत्कौस्तुभं वनमालिनम्॥ ११/२७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.040.m4a", "display_order": 41}, {"id": 6000328041, "chapter_id": 10328, "verse_number": "११-२७-३९", "content_sanskrit": "ध्यायन्नभ्यर्च्य दारूणि हविषाऽभियुतानि च।\nप्रास्याज्यभागावाघार्य दत्वा चाज्यप्लुतं हविः॥ ११/२७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.041.m4a", "display_order": 42}, {"id": 6000328042, "chapter_id": 10328, "verse_number": "११-२७-४०", "content_sanskrit": "जुहुयान्मूलमन्त्रेण षोडषार्चाविधानतः।\nधर्मादिभ्यो यथान्यायं मन्त्रैः स्विष्टकृतं बुधः॥ ११/२७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.042.m4a", "display_order": 43}, {"id": 6000328043, "chapter_id": 10328, "verse_number": "११-२७-४१", "content_sanskrit": "अभ्यर्च्याग्निं नमस्कृत्य पार्षदेभ्यो बलिं हरेत्।\nमूलमन्त्रं जपेद् ब्रह्म स्मरन् नारायणात्मकम्॥ ११/२७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.043.m4a", "display_order": 44}, {"id": 6000328044, "chapter_id": 10328, "verse_number": "११-२७-४२", "content_sanskrit": "दत्वाऽऽचमनमुच्छेषं विष्वक्सेनाय कल्पयेत्।\nमुखवासं सुरभिमत् ताम्बूलाद्यमथार्हयेत्॥ ११/२७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.044.m4a", "display_order": 45}, {"id": 6000328045, "chapter_id": 10328, "verse_number": "११-२७-४३", "content_sanskrit": "उपगायन् गृणन्नृत्यन् कर्माण्यभिनयन् मम।\nमत्कथाः श्रावयन् शृण्वन् मुहूर्तक्षणिको भवेत्॥ ११/२७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.045.m4a", "display_order": 46}, {"id": 6000328046, "chapter_id": 10328, "verse_number": "११-२७-४४", "content_sanskrit": "स्तवैरुच्चावचैः श्रौतैः पौराणैः प्राकृतैरपि।\nस्तुत्वा प्रसीद भगवन्निति वन्देत दण्डवत्॥ ११/२७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.046.m4a", "display_order": 47}, {"id": 6000328047, "chapter_id": 10328, "verse_number": "११-२७-४५", "content_sanskrit": "शिरो मत्पादयोः कृत्वा बाहुभ्यां च परस्परम्।\nप्रपन्नं पाहि मामीश भीतं मृत्युग्रहार्णवात्॥ ११/२७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.047.m4a", "display_order": 48}, {"id": 6000328048, "chapter_id": 10328, "verse_number": "११-२७-४६", "content_sanskrit": "ततः शेषां मया दत्तां शिरस्याधाय सादरम्।\nउद्वासयेच्चेदुद्वास्यं ज्योतिर्ज्योतिषि तत् पुनः॥ ११/२७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.048.m4a", "display_order": 49}, {"id": 6000328049, "chapter_id": 10328, "verse_number": "११-२७-४७", "content_sanskrit": "अर्चादिषु यथा यत्र श्रद्धा मां तत्र चार्चयेत्।\nसर्वभूतेष्वात्मनि च सर्वात्माऽहमवस्थितः॥ ११/२७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.049.m4a", "display_order": 50}, {"id": 6000328050, "chapter_id": 10328, "verse_number": "११-२७-४८", "content_sanskrit": "एवं क्रियायोगपथैः पुमान् वैदिकतान्त्रिकैः।\nअर्चानुभावतः सिद्धिं मत्तो विन्दत्यभिप्सिताम्॥ ११/२७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.050.m4a", "display_order": 51}, {"id": 6000328051, "chapter_id": 10328, "verse_number": "११-२७-४९", "content_sanskrit": "मदर्चां सम्प्रतिष्ठाप्य मन्दिरं कारयेद् दृढम्।\nपुष्पोद्यानानि रम्याणि पूजां तत्रोत्सवाश्रिताम्॥ ११/२७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.051.m4a", "display_order": 52}, {"id": 6000328052, "chapter_id": 10328, "verse_number": "११-२७-५०", "content_sanskrit": "पूजादीनां प्रवाहार्थे महापर्वसु चान्वहम्।\nक्षेत्रापणपुरग्रामान् दत्वा मत्सार्ष्टितामियात्॥ ११/२७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.052.m4a", "display_order": 53}, {"id": 6000328053, "chapter_id": 10328, "verse_number": "११-२७-५१", "content_sanskrit": "प्रतिष्ठया सार्वभौमं सद्मना भुवनत्रयम्।\nपूजादिना ब्रह्मलोकं त्रिभिर्मत्साम्यतामियात्॥ ११/२७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.053.m4a", "display_order": 54}, {"id": 6000328054, "chapter_id": 10328, "verse_number": "११-२७-५२", "content_sanskrit": "मामेव नैरपेक्ष्येण भक्तियोगेन विन्दति।\nस भक्तियोगं लभते एवं यः पूजयेत माम्॥ ११/२७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.054.m4a", "display_order": 55}, {"id": 6000328055, "chapter_id": 10328, "verse_number": "११-२७-५३", "content_sanskrit": "यः स्वदत्तां परैर्दत्तां हरेत सुरविप्रयोः।\nवृत्तिं स जायते विड्भुग् वर्षाणामयुतायुतम्॥ ११/२७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.055.m4a", "display_order": 56}, {"id": 6000328056, "chapter_id": 10328, "verse_number": "११-२७-५४", "content_sanskrit": "कर्तुश्च सारथेर्हेतोरनुमोदितुरेव च।\nकर्मणां भागिनः प्रेत्य भूयो भूयसि तत् फलम्॥ ११/२७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_027/BhP_11.027.056.m4a", "display_order": 57}, {"id": 6000328057, "chapter_id": 10328, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे सप्तविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]