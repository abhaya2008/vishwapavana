[{"id": 5000429000, "chapter_id": 9429, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000429001, "chapter_id": 9429, "verse_number": "६-२२-१", "content_sanskrit": "अथोवाच रघुश्रेष्ठः सागरं दारुणं वचः।\nअद्य त्वां शोषयिष्यामि सपातालं महार्णव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000429002, "chapter_id": 9429, "verse_number": "६-२२-२", "content_sanskrit": "शरनिर्दग्धतोयस्य परिशुष्कस्य सागर।\nमया निहतसत्त्वस्य पांसुरुत्पद्यते महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000429003, "chapter_id": 9429, "verse_number": "६-२२-३", "content_sanskrit": "मत्कार्मुकविसृष्टेन शरवर्षेण सागर।\nपरं तीरं गमिष्यन्ति पद्भिरेव प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000429004, "chapter_id": 9429, "verse_number": "६-२२-४", "content_sanskrit": "विचिन्वन्नाभिजानासि पौरुषं नापि विक्रमम्।\nदानवालय संतापं मत्तो नाम गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000429005, "chapter_id": 9429, "verse_number": "६-२२-५", "content_sanskrit": "ब्राह्मेणास्त्रेण संयोज्य ब्रह्मदण्डनिभं शरम्।\nसंयोज्य धनुषि श्रेष्ठे विचकर्ष महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000429006, "chapter_id": 9429, "verse_number": "६-२२-६", "content_sanskrit": "तस्मिन् विकृष्टे सहसा राघवेण शरासने।\nरोदसी सम्पफालेव पर्वताश्च चकम्पिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000429007, "chapter_id": 9429, "verse_number": "६-२२-७", "content_sanskrit": "तमश्च लोकमावव्रे दिशश्च न चकाशिरे।\nप्रतिचुक्षुभिरे चाशु सरांसि सरितस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000429008, "chapter_id": 9429, "verse_number": "६-२२-८", "content_sanskrit": "तिर्यक् च सह नक्षत्रैः संगतौ चन्द्रभास्करौ।\nभास्करांशुभिरादीप्तं तमसा च समावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000429009, "chapter_id": 9429, "verse_number": "६-२२-९", "content_sanskrit": "प्रचकाशे तदाऽऽकाशमुल्काशतविदीपितम्।\nअन्तरिक्षाच्च निर्घाता निर्जग्मुरतुलस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000429010, "chapter_id": 9429, "verse_number": "६-२२-१०", "content_sanskrit": "वपुःप्रकर्षेण ववुर्दिव्यमारुतपङ्‍क्तयः।\nबभञ्ज च तदा वृक्षाञ्जलदानुद्वहन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000429011, "chapter_id": 9429, "verse_number": "६-२२-११", "content_sanskrit": "आरुजंश्चैव शैलाग्रान् शिखराणि बभञ्ज च।\nदिवि च स्म महामेघाः संहताः समहास्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000429012, "chapter_id": 9429, "verse_number": "६-२२-१२", "content_sanskrit": "मुमुचुर्वैद्युतानग्नींस्ते महाशनयस्तदा।\nयानि भूतानि दृश्यानि चुक्रुशुश्चाशनेः समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000429013, "chapter_id": 9429, "verse_number": "६-२२-१३", "content_sanskrit": "अदृश्यानि च भूतानि मुमुचुर्भैरवस्वनम्।\nशिश्यिरे चाभिभूतानि संत्रस्तान्युद्विजन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000429014, "chapter_id": 9429, "verse_number": "६-२२-१४", "content_sanskrit": "सम्प्रविव्यथिरे चापि न च पस्पन्दिरे भयात्।\nसह भूतैः सतोयोर्मिः सनागः सहराक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000429015, "chapter_id": 9429, "verse_number": "६-२२-१५", "content_sanskrit": "सहसाभूत् ततो वेगाद् भीमवेगो महोदधिः।\nयोजनं व्यतिचक्राम वेलामन्यत्र सम्प्लवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000429016, "chapter_id": 9429, "verse_number": "६-२२-१६", "content_sanskrit": "तं तथा समतिक्रान्तं नातिचक्राम राघवः।\nसमुद्धतममित्रघ्नो रामो नदनदीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000429017, "chapter_id": 9429, "verse_number": "६-२२-१७", "content_sanskrit": "ततो मध्यात् समुद्रस्य सागरः स्वयमुत्थितः।\nउदयाद्रिमहाशैलान्मेरोरिव दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000429018, "chapter_id": 9429, "verse_number": "६-२२-१८", "content_sanskrit": "पन्नगैः सह दीप्तास्यैः समुद्रः प्रत्यदृश्यत।\nस्निग्धवैदूर्यसंकाशो जाम्बूनदविभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000429019, "chapter_id": 9429, "verse_number": "६-२२-१९", "content_sanskrit": "रक्तमाल्याम्बरधरः पद्मपत्रनिभेक्षणः।\nसर्वपुष्पमयीं दिव्यां शिरसा धारयन् स्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000429020, "chapter_id": 9429, "verse_number": "६-२२-२०", "content_sanskrit": "जातरूपमयैश्चैव तपनीयविभूषणैः।\nआत्मजानां च रत्नानां भूषितो भूषणोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000429021, "chapter_id": 9429, "verse_number": "६-२२-२१", "content_sanskrit": "धातुभिर्मण्डितः शैलो विविधैर्हिमवानिव।\nएकावलीमध्यगतं तरलं पाण्डरप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000429022, "chapter_id": 9429, "verse_number": "६-२२-२२", "content_sanskrit": "विपुलेनोरसा बिभ्रत्कौस्तुभस्य सहोदरम्।\nआघूर्णिततरङ्गौघः कालिकानिलसंकुलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000429023, "chapter_id": 9429, "verse_number": "६-२२-२३", "content_sanskrit": "गङ्गासिन्धुप्रधानाभिरापगाभिः समावृतः।\nउद्वर्तितमहाग्राहः सम्भ्रान्तोरगराक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000429024, "chapter_id": 9429, "verse_number": "६-२२-२४", "content_sanskrit": "देवतानां सुरूपाभिर्नानारूपाभिरीश्वरः।\nसागरः समुपक्रम्य पूर्वमामन्त्र्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000429025, "chapter_id": 9429, "verse_number": "६-२२-२५", "content_sanskrit": "अब्रवीत् प्राञ्जलिर्वाक्यं राघवं शरपाणिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000429026, "chapter_id": 9429, "verse_number": "६-२२-२६", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च राघव।\nस्वभावे सौम्य तिष्ठन्ति शाश्वतं मार्गमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000429027, "chapter_id": 9429, "verse_number": "६-२२-२७", "content_sanskrit": "तत्स्वभावो ममाप्येष यदगाधोऽहमप्लवः।\nविकारस्तु भवेद् गाध एतत् ते प्रवदाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000429028, "chapter_id": 9429, "verse_number": "६-२२-२८", "content_sanskrit": "न कामान्न च लोभाद् वा न भयात् पार्थिवात्मज।\nग्राहनक्राकुलजलं स्तम्भयेयं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000429029, "chapter_id": 9429, "verse_number": "६-२२-२९", "content_sanskrit": "विधास्ये येन गन्तासि विषहिष्येऽप्यहं तथा।\nन ग्राहा विधमिष्यन्ति यावत्सेना तरिष्यति।\nहरीणां तरणे राम करिष्यामि यथा स्थलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000429030, "chapter_id": 9429, "verse_number": "६-२२-३०", "content_sanskrit": "तमब्रवीत् तदा रामः शृणु मे वरुणालय।\nअमोघोऽयं महाबाणः कस्मिन् देशे निपात्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000429031, "chapter_id": 9429, "verse_number": "६-२२-३१", "content_sanskrit": "रामस्य वचनं श्रुत्वा तं च दृष्ट्वा महाशरम्।\nमहोदधिर्महातेजा राघवं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000429032, "chapter_id": 9429, "verse_number": "६-२२-३२", "content_sanskrit": "उत्तरेणावकाशोऽस्ति कश्चित् पुण्यतरो मम।\nद्रुमकुल्य इति ख्यातो लोके ख्यातो यथा भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000429033, "chapter_id": 9429, "verse_number": "६-२२-३३", "content_sanskrit": "उग्रदर्शनकर्माणो बहवस्तत्र दस्यवः।\nआभीरप्रमुखाः पापाः पिबन्ति सलिलं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000429034, "chapter_id": 9429, "verse_number": "६-२२-३४", "content_sanskrit": "तैर्न तत्स्पर्शनं पापं सहेयं पापकर्मभिः।\nअमोघः क्रियतां राम अयं तत्र शरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000429035, "chapter_id": 9429, "verse_number": "६-२२-३५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा सागरस्य महात्मनः।\nमुमोच तं शरं दीप्तं परं सागरदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000429036, "chapter_id": 9429, "verse_number": "६-२२-३६", "content_sanskrit": "तेन तन्मरुकान्तारं पृथिव्यां किल विश्रुतम्।\nनिपातितः शरो यत्र वज्राशनिसमप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000429037, "chapter_id": 9429, "verse_number": "६-२२-३७", "content_sanskrit": "ननाद च तदा तत्र वसुधा शल्यपीडिता।\nतस्माद् व्रणमुखात् तोयमुत्पपात रसातलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000429038, "chapter_id": 9429, "verse_number": "६-२२-३८", "content_sanskrit": "स बभूव तदा कूपो व्रण इत्येव विश्रुतः।\nसततं चोत्थितं तोयं समुद्रस्येव दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000429039, "chapter_id": 9429, "verse_number": "६-२२-३९", "content_sanskrit": "अवदारणशब्दश्च दारुणः समपद्यत।\nतस्मात् तद् बाणपातेन अपः कुक्षिष्वशोषयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000429040, "chapter_id": 9429, "verse_number": "६-२२-४०", "content_sanskrit": "विख्यातं त्रिषु लोकेषु मरुकान्तारमेव च।\nशोषयित्वा तु तं कुक्षिं रामो दशरथात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000429041, "chapter_id": 9429, "verse_number": "६-२२-४१", "content_sanskrit": "वरं तस्मै ददौ विद्वान् मरवेऽमरविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000429042, "chapter_id": 9429, "verse_number": "६-२२-४२", "content_sanskrit": "पशव्यश्चाल्परोगश्च फलमूलरसायुतः।\nबहुस्नेहो बहुक्षीरः सुगन्धिर्विविधौषधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000429043, "chapter_id": 9429, "verse_number": "६-२२-४३", "content_sanskrit": "एवमेतैश्च संयुक्तो बहुभिः संयुतो मरुः।\nरामस्य वरदानाच्च शिवः पन्था बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000429044, "chapter_id": 9429, "verse_number": "६-२२-४४", "content_sanskrit": "तस्मिन् दग्धे तदा कुक्षौ समुद्रः सरितां पतिः।\nराघवं सर्वशास्त्रज्ञमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000429045, "chapter_id": 9429, "verse_number": "६-२२-४५", "content_sanskrit": "अयं सौम्य नलो नाम तनयो विश्वकर्मणः।\nपित्रा दत्तवरः श्रीमान् प्रीतिमान् विश्वकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000429046, "chapter_id": 9429, "verse_number": "६-२२-४६", "content_sanskrit": "एष सेतुं महोत्साहः करोतु मयि वानरः।\nतमहं धारयिष्यामि यथा ह्येष पिता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000429047, "chapter_id": 9429, "verse_number": "६-२२-४७", "content_sanskrit": "एवमुक्त्वोदधिर्नष्टः समुत्थाय नलस्ततः।\nअब्रवीद् वानरश्रेष्ठो वाक्यं रामं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000429048, "chapter_id": 9429, "verse_number": "६-२२-४८", "content_sanskrit": "अहं सेतुं करिष्यामि विस्तीर्णे मकरालये।\nपितुः सामर्थ्यमासाद्य तत्त्वमाह महोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000429049, "chapter_id": 9429, "verse_number": "६-२२-४९", "content_sanskrit": "दण्ड एव वरो लोके पुरुषस्येति मे मतिः।\nधिक् क्षमामकृतज्ञेषु सान्त्वं दानमथापि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000429050, "chapter_id": 9429, "verse_number": "६-२२-५०", "content_sanskrit": "अयं हि सागरो भीमः सेतुकर्मदिदृक्षया।\nददौ दण्डभयाद् गाधं राघवाय महोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000429051, "chapter_id": 9429, "verse_number": "६-२२-५१", "content_sanskrit": "मम मातुर्वरो दत्तो मन्दरे विश्वकर्मणा।\nमया तु सदृशः पुत्रस्तव देवि भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000429052, "chapter_id": 9429, "verse_number": "६-२२-५२", "content_sanskrit": "औरसस्तस्य पुत्रोऽहं सदृशो विश्वकर्मणा।\nस्मारितोऽस्म्यहमेतेन तत्त्वमाह महोदधिः।\nन चाप्यहमनुक्तो वः प्रब्रूयामात्मनो गुणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000429053, "chapter_id": 9429, "verse_number": "६-२२-५३", "content_sanskrit": "समर्थश्चाप्यहं सेतुं कर्तुं वै वरुणालये।\nतस्मादद्यैव बध्नन्तु सेतुं वानरपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000429054, "chapter_id": 9429, "verse_number": "६-२२-५४", "content_sanskrit": "ततो विसृष्टा रामेण सर्वतो हरिपुङ्गवाः।\nउत्पेततुर्महारण्यं हृष्टाः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000429055, "chapter_id": 9429, "verse_number": "६-२२-५५", "content_sanskrit": "ते नगान् नगसंकाशाः शाखामृगगणर्षभाः।\nबभञ्जुः पादपांस्तत्र प्रचकर्षुश्च सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000429056, "chapter_id": 9429, "verse_number": "६-२२-५६", "content_sanskrit": "ते सालैश्चाश्वकर्णैश्च धवैर्वंशैश्च वानराः।\nकुटजैरर्जुनैस्तालैस्तिलकैस्तिनिशैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000429057, "chapter_id": 9429, "verse_number": "६-२२-५७", "content_sanskrit": "बिल्वकैः सप्तपर्णैश्च कर्णिकारैश्च पुष्पितैः।\nचूतैश्चाशोकवृक्षैश्च सागरं समपूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000429058, "chapter_id": 9429, "verse_number": "६-२२-५८", "content_sanskrit": "समूलांश्च विमूलांश्च पादपान् हरिसत्तमाः।\nइन्द्रकेतूनिवोद्यम्य प्रजह्रुर्वानरास्तरून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000429059, "chapter_id": 9429, "verse_number": "६-२२-५९", "content_sanskrit": "तालान् दाडिमगुल्मांश्च नारिकेलविभीतकान्।\nकरीरान् बकुलान् निम्बान् समाजह्रुरितस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000429060, "chapter_id": 9429, "verse_number": "६-२२-६०", "content_sanskrit": "हस्तिमात्रान् महाकायाः पाषाणांश्च महाबलाः।\nपर्वतांश्च समुत्पाट्य यन्त्रैः परिवहन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000429061, "chapter_id": 9429, "verse_number": "६-२२-६१", "content_sanskrit": "प्रक्षिप्यमाणैरचलैः सहसा जलमुद्‍धृतम्।\nसमुत्ससर्प चाकाशमवासर्पत् ततः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000429062, "chapter_id": 9429, "verse_number": "६-२२-६२", "content_sanskrit": "समुद्रं क्षोभयामासुर्निपतन्तः समन्ततः।\nसूत्राण्यन्ये प्रगृह्णन्ति ह्यायतं शतयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000429063, "chapter_id": 9429, "verse_number": "६-२२-६३", "content_sanskrit": "नलश्चक्रे महासेतुं मध्ये नदनदीपतेः।\nस तदा क्रियते सेतुर्वानरैर्घोरकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000429064, "chapter_id": 9429, "verse_number": "६-२२-६४", "content_sanskrit": "दण्डानन्ये प्रगृह्णन्ति विचिन्वन्ति तथापरे।\nवानरैः शतशस्तत्र रामस्याज्ञापुरःसरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000429065, "chapter_id": 9429, "verse_number": "६-२२-६५", "content_sanskrit": "मेघाभैः पर्वताभैश्च तृणैः काष्ठैर्बबन्धिरे।\nपुष्पिताग्रैश्च तरुभिः सेतुं बघ्नन्ति वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000429066, "chapter_id": 9429, "verse_number": "६-२२-६६", "content_sanskrit": "पाषाणांश्च गिरिप्रख्यान् गिरीणां शिखराणि च।\nदृश्यन्ते परिधावन्तो गृह्य दानवसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000429067, "chapter_id": 9429, "verse_number": "६-२२-६७", "content_sanskrit": "शिलानां क्षिप्यमाणानां शैलानां तत्र पात्यताम्।\nबभूव तुमुलः शब्दस्तदा तस्मिन् महोदधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000429068, "chapter_id": 9429, "verse_number": "६-२२-६८", "content_sanskrit": "कृतानि प्रथमेनाह्ना योजनानि चतुर्दश।\nप्रहृष्टैर्गजसंकाशैस्त्वरमाणैः प्लवङ्गमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000429069, "chapter_id": 9429, "verse_number": "६-२२-६९", "content_sanskrit": "द्वितीयेन तथैवाह्ना योजनानि तु विंशतिः।\nकृतानि प्लवगैस्तूर्णं भीमकायैर्महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000429070, "chapter_id": 9429, "verse_number": "६-२२-७०", "content_sanskrit": "अह्ना तृतीयेन तथा योजनानि तु सागरे।\nत्वरमाणैर्महाकायैरेकविंशतिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000429071, "chapter_id": 9429, "verse_number": "६-२२-७१", "content_sanskrit": "चतुर्थेन तथा चाह्ना द्वाविंशतिरथापि वा।\nयोजनानि महावेगैः कृतानि त्वरितैस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000429072, "chapter_id": 9429, "verse_number": "६-२२-७२", "content_sanskrit": "पञ्चमेन तथा चाह्ना प्लवगैः क्षिप्रकारिभिः।\nयोजनानि त्रयोविंशत् सुवेलमधिकृत्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000429073, "chapter_id": 9429, "verse_number": "६-२२-७३", "content_sanskrit": "स वानरवरः श्रीमान् विश्वकर्मात्मजो बली।\nबबन्ध सागरे सेतुं यथा चास्य पिता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000429074, "chapter_id": 9429, "verse_number": "६-२२-७४", "content_sanskrit": "स नलेन कृतः सेतुः सागरे मकरालये।\nशुशुभे सुभगः श्रीमान् स्वातीपथ इवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000429075, "chapter_id": 9429, "verse_number": "६-२२-७५", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः।\nआगम्य गगने तस्थुर्द्रष्टुकामास्तदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000429076, "chapter_id": 9429, "verse_number": "६-२२-७६", "content_sanskrit": "दशयोजनविस्तीर्णं शतयोजनमायतम्।\nददृशुर्देवगन्धर्वा नलसेतुं सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000429077, "chapter_id": 9429, "verse_number": "६-२२-७७", "content_sanskrit": "आप्लवन्तः प्लवन्तश्च गर्जन्तश्च प्लवंगमाः।\nतमचिन्त्यमसह्यं च ह्यद्भुतं लोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000429078, "chapter_id": 9429, "verse_number": "६-२२-७८", "content_sanskrit": "ददृशुः सर्वभूतानि सागरे सेतुबन्धनम्।\nतानि कोटिसहस्राणि वानराणां महौजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000429079, "chapter_id": 9429, "verse_number": "६-२२-७९", "content_sanskrit": "बध्नन्तः सागरे सेतुं जग्मुः पारं महोदधेः।\nविशालः सुकृतः श्रीमान् सुभूमिः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000429080, "chapter_id": 9429, "verse_number": "६-२२-८०", "content_sanskrit": "अशोभत महान् सेतुः सीमन्त इव सागरे।\nततः पारे समुद्रस्य गदापाणिर्विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000429081, "chapter_id": 9429, "verse_number": "६-२२-८१", "content_sanskrit": "परेषामभिघातार्थमतिष्ठत् सचिवैः सह।\nसुग्रीवस्तु ततः प्राह रामं सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000429082, "chapter_id": 9429, "verse_number": "६-२२-८२", "content_sanskrit": "हनूमन्तं त्वमारोह अङ्गदं त्वथ लक्ष्मणः।\nअयं हि विपुलो वीर सागरो मकरालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000429083, "chapter_id": 9429, "verse_number": "६-२२-८३", "content_sanskrit": "वैहायसौ युवामेतौ वानरौ धारयिष्यतः।\nअग्रतस्तस्य सैन्यस्य श्रीमान् रामः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000429084, "chapter_id": 9429, "verse_number": "६-२२-८४", "content_sanskrit": "जगाम धन्वी धर्मात्मा सुग्रीवेण समन्वितः।\nअन्ये मध्येन गच्छन्ति पार्श्वतोऽन्ये प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000429085, "chapter_id": 9429, "verse_number": "६-२२-८५", "content_sanskrit": "सलिलं प्रपतन्त्यन्ये मार्गमन्ये प्रपेदिरे।\nकेचिद् वैहायसगताः सुपर्णा इव पुप्लुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000429086, "chapter_id": 9429, "verse_number": "६-२२-८६", "content_sanskrit": "घोषेण महता घोषं सागरस्य समुच्छ्रितम्।\nभीममन्तर्दधे भीमा तरन्ती हरिवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000429087, "chapter_id": 9429, "verse_number": "६-२२-८७", "content_sanskrit": "वानराणां हि सा तीर्णा वाहिनी नलसेतुना।\nतीरे निविविशे राज्ञो बहुमूलफलोदके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000429088, "chapter_id": 9429, "verse_number": "६-२२-८८", "content_sanskrit": "तदद्भुतं राघवकर्म दुष्करं\nसमीक्ष्य देवाः सह सिद्धचारणैः।\nउपेत्य रामं सहसा महर्षिभि-\nस्तमभ्यषिञ्चन् सुशुभैर्जलैः पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000429089, "chapter_id": 9429, "verse_number": "६-२२-८९", "content_sanskrit": "जयस्व शत्रून् नरदेव मेदिनीं\nससागरां पालय शाश्वतीः समाः।\nइतीव रामं नरदेवसत्कृतं\nशुभैर्वचोभिर्विविधैरपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000429090, "chapter_id": 9429, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]