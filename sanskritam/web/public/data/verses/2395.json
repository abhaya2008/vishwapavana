[{"id": 2066026, "chapter_id": 2395, "verse_number": "९-१३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066027, "chapter_id": 2395, "verse_number": "९-१३-१", "content_sanskrit": "अर्जुनो द्रौणिना विद्धो युद्धे बहुभिरायसैः।\nतस्य चानुचरैः शूरैस्त्रिगर्तानां महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066028, "chapter_id": 2395, "verse_number": "९-१३-२", "content_sanskrit": "द्रौणिं विव्याध समरे त्रिभिरेव शिलीमुखैः।\nतथेतरान्महेष्वासान्द्वाभ्यां द्वाभ्यां धनञ्जयः।\nभूयश्चैव महाराज शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066029, "chapter_id": 2395, "verse_number": "९-१३-३", "content_sanskrit": "शरकण्टकितास्ते तु तावका भरतर्षभ।\nन जहुः पार्थमासाद्य ताड्यमानाः शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066030, "chapter_id": 2395, "verse_number": "९-१३-४", "content_sanskrit": "अर्जुनं रथवंशेन द्रोणपुत्रपुरोगमाः।\nपरिवार्य मुदा युक्ता योधयन्तश्चकाशिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066031, "chapter_id": 2395, "verse_number": "९-१३-५", "content_sanskrit": "तैस्तु क्षिप्ताः शरा राजन्कार्तस्वरविभूषिताः।\nअर्जुनस्य रथोपस्थं पूरयामासुरञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066032, "chapter_id": 2395, "verse_number": "९-१३-६", "content_sanskrit": "तथा कृष्णौ महेष्वासौ वृषभौ सर्वधन्विनाम्।\nविव्यधुश्च शरैर्घोरैः प्रहृष्टा युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066033, "chapter_id": 2395, "verse_number": "९-१३-७", "content_sanskrit": "कूबरं रथचक्राणि ईषा योक्त्राणि वा विभो।\nयुगं चैवानुकर्षं च शरभूतमभूत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066034, "chapter_id": 2395, "verse_number": "९-१३-८", "content_sanskrit": "नैतादृशं दृष्टपूर्वं राजन्नेव च नः श्रुतम्।\nयादृशं तत्र पार्थस्य तावकाः सम्प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066035, "chapter_id": 2395, "verse_number": "९-१३-९", "content_sanskrit": "स रथः सर्वतो भाति चित्रपुङ्खैः शितैः शरैः।\nउल्काशतैः सम्प्रदीप्तं विमानमिव भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066036, "chapter_id": 2395, "verse_number": "९-१३-१०", "content_sanskrit": "ततोऽर्जुनो महाराज शरैः सन्नतपर्वभिः।\nअवाकिरत्तां पृतनां मेघो धृष्ट्येव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066037, "chapter_id": 2395, "verse_number": "९-१३-११", "content_sanskrit": "ते वध्यमानाः समरे पार्थनामाङ्कितैः शरैः।\nपार्थभूतममन्यन्त प्रेक्षमाणास्तथाविधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066038, "chapter_id": 2395, "verse_number": "९-१३-१२", "content_sanskrit": "कोपोद्धूतशरज्वालो धनुःशब्दानिलो महान्।\nसैन्येन्धनं ददाहाशु तावकं पार्थपावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066039, "chapter_id": 2395, "verse_number": "९-१३-१३", "content_sanskrit": "चक्राणां पततां चापि युगानां च धरातले।\nतूणीराणां पताकानां ध्वजानां च रथैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066040, "chapter_id": 2395, "verse_number": "९-१३-१४", "content_sanskrit": "ईषाणामनुकर्षाणां त्रिवेणूनां च भारत।\nअक्षाणामथ योक्त्राणां प्रतोदानां च राशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066041, "chapter_id": 2395, "verse_number": "९-१३-१५", "content_sanskrit": "शिरसां पततां चापि कुण्डलोष्णीषधारिणाम्।\nभुजानां च महाभाग स्कन्धानां च समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066042, "chapter_id": 2395, "verse_number": "९-१३-१६", "content_sanskrit": "छत्राणां व्यजनैः सार्धं मकुटानां च राशयः।\nसमदृश्यन्त पार्थस्य रथमार्गेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066043, "chapter_id": 2395, "verse_number": "९-१३-१७", "content_sanskrit": "अगम्यरूपा पृथिवी मांसशोणितकर्दमा।\nभीरूणां त्रासजननी शूराणां हर्षवर्धिनी।\nबभूव भरतश्रेष्ठ रुद्रस्याक्रीडनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066044, "chapter_id": 2395, "verse_number": "९-१३-१८", "content_sanskrit": "हत्वा तु समरे पार्थः सहस्रे द्वे परन्तपः।\nरथानां सवरूथानं विधूमोऽग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066045, "chapter_id": 2395, "verse_number": "९-१३-१९", "content_sanskrit": "यथा हि भगवानग्निर्जगद्दग्ध्वा चराचरम्।\nविधूमो दृश्यते राजंस्तथा पार्थो धऩञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066046, "chapter_id": 2395, "verse_number": "९-१३-२०", "content_sanskrit": "द्रौणिस्तु समरे दृष्ट्वा पाण्डवस्य पराक्रमम्।\nरथेनातिपताकेन पाण्डवं प्रत्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066047, "chapter_id": 2395, "verse_number": "९-१३-२१", "content_sanskrit": "तावुभौ पुरुषव्याघ्रौ श्वेताश्वौ धन्विनां वरौ।\nसमीयतुस्तदाऽन्योन्यं परस्परवधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066048, "chapter_id": 2395, "verse_number": "९-१३-२२", "content_sanskrit": "तयोरासीन्महाराज बाणवर्षं सुदारुणम्।\nजीमूतयोर्यथा वृष्टिस्तपान्ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066049, "chapter_id": 2395, "verse_number": "९-१३-२३", "content_sanskrit": "अन्योन्यस्पर्धिनौ तौ तु शरैः सन्नतपर्वभिः।\nततक्षतुस्तदाऽन्योन्यं शृङ्गाभ्यां वृषभाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066050, "chapter_id": 2395, "verse_number": "९-१३-२४", "content_sanskrit": "तयोर्युद्धं महाराज चिरं सममिवाभवत्।\nशस्त्राणां सङ्गमश्चैव घोरस्तत्राभवत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066051, "chapter_id": 2395, "verse_number": "९-१३-२५", "content_sanskrit": "ततोऽर्जुनं द्वादशभी रुक्मपुङ्खैः सुतेजनैः।\nवासुदेवं च दशभिर्द्रौणिर्विव्याध भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066052, "chapter_id": 2395, "verse_number": "९-१३-२६", "content_sanskrit": "ततः प्रहस्य बीभत्सुर्व्याक्षिपद्गाण्डिवं धनुः।\nमानयित्वा मुहूर्तं तु गुरुपुत्रं महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066053, "chapter_id": 2395, "verse_number": "९-१३-२७", "content_sanskrit": "व्यश्वसूतरथं चक्रे सव्यसाची परन्तपः।\nमृदुपूर्वं ततश्चैनं पुनःपुनरताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066054, "chapter_id": 2395, "verse_number": "९-१३-२८", "content_sanskrit": "हताश्वे तु रथे तिष्ठन्द्रोणपुत्रस्त्वयस्मयम्।\nमुसलं पाण्डुपुत्राय चिक्षेप परिघोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066055, "chapter_id": 2395, "verse_number": "९-१३-२९", "content_sanskrit": "तमापतन्तं सहसा हेमपट्टविभूषितम्।\nचिच्छेद सप्तधा वीरः पार्थः शत्रुनिबर्हणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066056, "chapter_id": 2395, "verse_number": "९-१३-३०", "content_sanskrit": "स च्छिन्नं मुसलं दृष्ट्वा द्रौणिः परमकोपनः।\nआददे परिघं घोरं नगेन्द्रशिखरोपमम्।\nचिक्षेप चैव पार्थाय द्रौणिर्युद्धविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066057, "chapter_id": 2395, "verse_number": "९-१३-३१", "content_sanskrit": "तमन्तकमिव क्रुद्दं परिघं प्रेक्ष्य पाण्डवः।\nअर्जुनस्त्वरितो जघ्ने पञ्चभिः सायकोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066058, "chapter_id": 2395, "verse_number": "९-१३-३२", "content_sanskrit": "स च्छिन्नः पतितो भूमौ पार्थबाणैर्महाहवे।\nदारयन्पृथिवीन्द्राणां मनः सब्देन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066059, "chapter_id": 2395, "verse_number": "९-१३-३३", "content_sanskrit": "ततोऽपरैस्त्रिभिर्भल्लैर्द्रौणिं विव्याध पाण़्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066060, "chapter_id": 2395, "verse_number": "९-१३-३४", "content_sanskrit": "सोऽतिविद्धो बलवता पार्थेन सुमहात्मना।\nनाकम्पत तदा द्रौणिः पौरुषेषु व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066061, "chapter_id": 2395, "verse_number": "९-१३-३५", "content_sanskrit": "सुरथं च ततो राजन्भारद्वाजो महारथम्।\nअवाकिरच्छरव्रातैः सर्वक्षत्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066062, "chapter_id": 2395, "verse_number": "९-१३-३६", "content_sanskrit": "ततस्तु सुरथोऽप्याजौ पाञ्चालानां महारथः।\nरथेन मेघघोषेण द्रौणिमेवाभ्यधावत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066063, "chapter_id": 2395, "verse_number": "९-१३-३७", "content_sanskrit": "विकर्षन्वै धनुःश्रेष्ठं सर्वभारसहं दृढम्।\nज्वलनाशीविषनिभैः शरैश्चैनमवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066064, "chapter_id": 2395, "verse_number": "९-१३-३८", "content_sanskrit": "सुरथं तं ततः क्रुद्धमापतन्तं महारथम्।\nचुकोप समरे द्रौणिर्दण्डाहत इवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066065, "chapter_id": 2395, "verse_number": "९-१३-३९", "content_sanskrit": "त्रिशिखां भ्रुकुटीं कृत्वा सृक्विणी परिसंलिहन्।\nउद्वीक्ष्य सुरथं रोषाद्धनुर्ज्यामवमृज्य च।\nमुमोच तीक्ष्णं नाराचं यमदण्डोपमद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066066, "chapter_id": 2395, "verse_number": "९-१३-४०", "content_sanskrit": "स तस्य हृदयं भित्त्वा प्रविवेशातिवेगितः।\nशक्ताशनिरिवोत्सृष्टो विदार्य धरणीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066067, "chapter_id": 2395, "verse_number": "९-१३-४१", "content_sanskrit": "ततः स पतितो भूमौ नाराचेन समाहतः।\nवज्रेण च यथा शृङ्गं पर्वतस्येव दीर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066068, "chapter_id": 2395, "verse_number": "९-१३-४२", "content_sanskrit": "तस्मिन्विनिहते वीरे द्रोणपुत्रः प्रतापवान्।\nआरुरोह रथं तूर्णं तमेव रथिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066069, "chapter_id": 2395, "verse_number": "९-१३-४३", "content_sanskrit": "ततः सज्जो महाराज द्रौणिराहवदुर्मदः।\nअर्जुनं योधयामास संशप्तकवृतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066070, "chapter_id": 2395, "verse_number": "९-१३-४४", "content_sanskrit": "तत्र युद्धं महच्चासीदर्जुनस्य परैः सह।\nमध्यन्दिनगते सूर्ये यमराष्ट्रविवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066071, "chapter_id": 2395, "verse_number": "९-१३-४५", "content_sanskrit": "तत्राश्चर्यमपश्याम दृष्ट्वा तेषां पराक्रमम्।\nयदेको युगपद्वीरान्समयोधयदर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066072, "chapter_id": 2395, "verse_number": "९-१३-४६", "content_sanskrit": "विमर्दः सुमहानासीदर्जुनस्य परैः सह।\nशतक्रतोर्यथापूर्वं महत्या दैत्यसेनया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066073, "chapter_id": 2395, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे त्रयोदशोऽध्यायः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]