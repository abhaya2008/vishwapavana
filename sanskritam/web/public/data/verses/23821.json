[{"id": 7003821000, "chapter_id": 23821, "verse_number": "२-४-८-१", "content_sanskrit": "नारद उवाच ।\nभूयः कथय तृप्तिर्हि नास्ति मे कमलासन ।\nत्वद्वागमृतपानेन तृषा भूयः प्रवर्धते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003821001, "chapter_id": 23821, "verse_number": "२-४-८-२", "content_sanskrit": "ब्रह्मोवाच ।\nप्रातः स्नात्वा शुचिर्भूत्वा कार्तिके विष्णुतत्परः ।\nदेवं दामोदरं पूज्य कोमलैस्तुलसीदलैः ।\nस तु मोक्षमवाप्नोति नाऽत्र कार्या विचारणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003821002, "chapter_id": 23821, "verse_number": "२-४-८-३", "content_sanskrit": "भक्त्या विरहितो यस्तु सुवर्णादिभिरर्चयेत् ।\nतस्य पूजां न गृह्णाति नाऽत्र कार्या विचारणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003821003, "chapter_id": 23821, "verse_number": "२-४-८-४", "content_sanskrit": "सर्वेषामपि वर्णानां भक्तिरेषा परा स्मृता ।\nभक्त्या विरहितं कर्म न विष्णोः प्रियकारणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003821004, "chapter_id": 23821, "verse_number": "२-४-८-५", "content_sanskrit": "भक्त्या संपूजितो नित्यं तुलस्यास्तु दलार्धतः ।\nस्वयं प्रत्यक्षमायाति भगवान्हरिरीश्वरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003821005, "chapter_id": 23821, "verse_number": "२-४-८-६", "content_sanskrit": "विष्णुदासः पुरा भक्त्या तुलसीपूजनेन च ।\nविष्णुलोकं गतः शीघ्रं चोलो गौणत्वमागतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003821006, "chapter_id": 23821, "verse_number": "२-४-८-७", "content_sanskrit": "तुलस्याः शृणु माहात्म्यं पापघ्नं पुण्यवर्द्धनम् ।\nयत्पुरा विष्णुना प्रोक्तं रमायै तद्वदाम्यहम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003821007, "chapter_id": 23821, "verse_number": "२-४-८-८", "content_sanskrit": "संप्राप्ते कार्तिके मासि तुलस्याः पूजनं हरेः ।\nये कुर्वंति नरा भक्त्या ते यांति परमं पदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003821008, "chapter_id": 23821, "verse_number": "२-४-८-९", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन तुलस्याः कोमलैर्दलैः ।\nपूजनीयो महाभक्त्या सर्वक्लेशविनाशनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003821009, "chapter_id": 23821, "verse_number": "२-४-८-१०", "content_sanskrit": "रोपिता तुलसी यावत्कुरुते मूलविस्तरम् ।\nतावद्युगसहस्राणि ब्रह्मलोके महीयते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003821010, "chapter_id": 23821, "verse_number": "२-४-८-११", "content_sanskrit": "तुलसीपत्रसंयुक्तजले स्नानं चरेद्यदि ।\nसर्वपापविनिर्मुक्तो मोदते विष्णुमंदिरे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003821011, "chapter_id": 23821, "verse_number": "२-४-८-१२", "content_sanskrit": "वृन्दावनं च कुरुते रोपणार्थं महामुने ।\nतावतैव विमुक्ताऽघो ब्रह्मभूयाय कल्पते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003821012, "chapter_id": 23821, "verse_number": "२-४-८-१३", "content_sanskrit": "तुलसीकाननं ब्रह्मन्गृहे यस्याऽवतिष्ठते ।\nतद्गृहं तीर्थभूतं तु न यांति यमकिंकराः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003821013, "chapter_id": 23821, "verse_number": "२-४-८-१४", "content_sanskrit": "सर्वपापहरं पुण्यं कामदं तुलसीवनम् ।\nरोपयंति नराः श्रेष्ठास्ते न पश्यंति भास्करिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003821014, "chapter_id": 23821, "verse_number": "२-४-८-१५", "content_sanskrit": "तुलसीकाष्ठसंयुक्तं गन्धं यो धारयेन्नरः ।\nतद्देहं न स्पृशेत्पापं क्रियमाणं तथैव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003821015, "chapter_id": 23821, "verse_number": "२-४-८-१६", "content_sanskrit": "तुलसीविपिनच्छाया यत्र चैव भवेद्द्विज ।\nतत्र श्राद्धं प्रकर्तव्यं पितॄणां तृप्तिहेतवे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003821016, "chapter_id": 23821, "verse_number": "२-४-८-१७", "content_sanskrit": "यत्कृते तुलसीपत्रं कर्णे शिरसि दृश्यते ।\nयमस्तं नेक्षितुं शक्तः किमु दूता भयंकराः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003821017, "chapter_id": 23821, "verse_number": "२-४-८-१८", "content_sanskrit": "तुलस्या महिमां यस्तु शृणुयान्नित्यमादृतः ।\nसवपापविमुक्तात्मा ब्रह्मलोकं स गच्छति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003821018, "chapter_id": 23821, "verse_number": "२-४-८-१९", "content_sanskrit": "अत्रैवोदाहरंतीममितिहासं पुरातनम् ।\nतुलस्या विषये ब्रह्मञ्च्छ्रवणात्पापनाशनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003821019, "chapter_id": 23821, "verse_number": "२-४-८-२०", "content_sanskrit": "पुरा काश्मीरदेशे तु ब्राह्मणौ संबभूवतुः ।\nहरिमेधःसुमेधाख्यौ विष्णुभक्तिपरायणौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003821020, "chapter_id": 23821, "verse_number": "२-४-८-२१", "content_sanskrit": "सर्वभूतदयायुक्तौ सर्वतत्त्वार्थवेदिनौ ।\nकदाचित्तौ द्विजवरौ तीर्थयात्रापरायणौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003821021, "chapter_id": 23821, "verse_number": "२-४-८-२२", "content_sanskrit": "गच्छतावेकतो विप्रौ कांतारे श्रमविह्वलौ ।\nतुलसीकाननं तत्र ददर्शतुररिंदमौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003821022, "chapter_id": 23821, "verse_number": "२-४-८-२३", "content_sanskrit": "तयोः सुमेधास्तद्दृष्ट्वा तुलसीकाननं महत् ।\nप्रदक्षिणीकृत्य तदा ववंदे भक्तिसंयुतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003821023, "chapter_id": 23821, "verse_number": "२-४-८-२४", "content_sanskrit": "दृष्ट्वैतद्धरिमेधास्तु उवाच परया मुदा ।\nज्ञातुं तुलस्या माहात्म्यं तत्फलं च पुनःपुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003821024, "chapter_id": 23821, "verse_number": "२-४-८-२५", "content_sanskrit": "हरिमेधा उवाच ।\nकिमर्थं विप्र देवेषु तीर्थेषु च व्रतेषु च ।\nस्थितेषु विप्रमुख्येषु प्रणामं कृतवानसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003821025, "chapter_id": 23821, "verse_number": "२-४-८-२६", "content_sanskrit": "सुमेधा उवाच ।\nशृणु विप्र महाभाग साधु वाक्यमुदीरितम् ।\nआतपो बाधते ह्यावां गत्वैतद्वटसन्निधौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003821026, "chapter_id": 23821, "verse_number": "२-४-८-२७", "content_sanskrit": "तस्यच्छायां समाश्रित्य वक्ष्यामि ते यथार्थतः ।\nएवमुक्तः सुमेधास्तु हरिमेधेन संयुतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003821027, "chapter_id": 23821, "verse_number": "२-४-८-२८", "content_sanskrit": "वटं जगाम धर्मज्ञो महत्कोटरसंयुतम् ।\nतत्र विश्राम्य विप्रोसौ हरिमेधमुवाच ह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003821028, "chapter_id": 23821, "verse_number": "२-४-८-२९", "content_sanskrit": "श्रूयतां विप्रशार्दूल तुलस्यास्तूत्तमां कथाम् ।\nपरमेशप्रसादेन संजाता या पयोनिधौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003821029, "chapter_id": 23821, "verse_number": "२-४-८-३०", "content_sanskrit": "पुरा दुर्वाससः शापाद्गतैश्वर्ये पुरंदरे ।\nममंथुः क्षीरजलधिं ब्रह्माद्याः ससुराऽसुराः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003821030, "chapter_id": 23821, "verse_number": "२-४-८-३१", "content_sanskrit": "ऐरावतः कल्पतरुश्चन्द्रमाः कमला तथा ।\nउच्चैःश्रवा कौस्तुभश्च तथा धन्वन्तरिर्हरिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003821031, "chapter_id": 23821, "verse_number": "२-४-८-३२", "content_sanskrit": "हरीतक्यादयश्चाऽपि दिव्या ओषधयस्तथा ।\nअजायन्त द्विजश्रेष्ठ लोकश्रेयोविधायकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003821032, "chapter_id": 23821, "verse_number": "२-४-८-३३", "content_sanskrit": "ततः पीयूषकलशमजरामरदायकम् ।\nकराभ्यां कलशं विष्णुर्धारयन्सुतलं परम् ।\nअवेक्ष्य मनसा सद्यः परां निर्वृतिमाप ह ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003821033, "chapter_id": 23821, "verse_number": "२-४-८-३४", "content_sanskrit": "तस्मिन्पीयूषकलश आनन्दास्रोदबिन्दवः ।\nव्यपतंस्तुलसी सद्यः समजायत मण्डला ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003821034, "chapter_id": 23821, "verse_number": "२-४-८-३५", "content_sanskrit": "सर्व लक्षणसंपन्ना सर्वाभरणभूषिता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003821035, "chapter_id": 23821, "verse_number": "२-४-८-३६", "content_sanskrit": "तत्रोत्पन्नां तथा लक्ष्मीं तुलसीं च ददुर्हरेः ।\nदेवा ब्रह्मादयस्ते हि जगृहे भगवान्हरिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003821036, "chapter_id": 23821, "verse_number": "२-४-८-३७", "content_sanskrit": "ततोऽतीव प्रियकरा तुलसी जगतां पतेः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003821037, "chapter_id": 23821, "verse_number": "२-४-८-३८", "content_sanskrit": "सा तु देवगणैः सर्वैर्विष्णुवत्पूज्यते प्रिया ।\nनारायणो जगत्त्राता तुलसी तस्य वल्लभा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003821038, "chapter_id": 23821, "verse_number": "२-४-८-३९", "content_sanskrit": "तस्मात्तस्या नमस्कारो मया विप्र कृतस्ततः ।\nइत्येवं वदतस्तस्य सुमेधस्य महात्मनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003821039, "chapter_id": 23821, "verse_number": "२-४-८-४०", "content_sanskrit": "आराददृश्यत महद्विमानं सूर्यवर्चसम् ।\nतदानीं वटवृक्षस्तु पपात पुरतो मुने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003821040, "chapter_id": 23821, "verse_number": "२-४-८-४१", "content_sanskrit": "तथैव तस्माद्वृक्षाच्च पुरुषौ द्वौ विनिर्गतौ ।\nद्योतयंतौ दिशः सर्वास्तेजसा सूर्यसन्निभौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003821041, "chapter_id": 23821, "verse_number": "२-४-८-४२", "content_sanskrit": "प्रणामं चक्रतुस्तौ हि हरिमेधसुमेधयोः ।\nहरिमेधसुमेधौ तौ तौ दृष्ट्वा भयविह्वलौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003821042, "chapter_id": 23821, "verse_number": "२-४-८-४३", "content_sanskrit": "ऊचतुर्विस्मयाविष्टौ तावुभौ देवसन्निभौ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003821043, "chapter_id": 23821, "verse_number": "२-४-८-४४", "content_sanskrit": "हरिमेधसुमेधसावूचतुः ।\nयुवां कौ देवसंकाशौ भवंतौ सर्वमंगलौ ।\nमंदारमालां तरुणां धारयंतौ तथाऽमरौ ।\nनमस्कार्यौ तथाऽवाभ्यां पूज्यौ च सुररूपिणौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003821044, "chapter_id": 23821, "verse_number": "२-४-८-४५", "content_sanskrit": "इत्युक्तौ ब्राह्मणाभ्यां तावूचतुर्वृक्षनिर्गतौ ।\nयुवामेव पिता माता आवयोश्च तथा गुरुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003821045, "chapter_id": 23821, "verse_number": "२-४-८-४६", "content_sanskrit": "बंध्वादयस्तथा चैव युवामेव न संशयः ।\nज्येष्ठ उवाच ।\nअहं तु देवलोकस्य आस्तीकोनाम नामतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003821046, "chapter_id": 23821, "verse_number": "२-४-८-४७", "content_sanskrit": "अप्सरोगणसंवीतः कदाचिन्नंदन वनम् ।\nक्रीडार्थमगमं चाद्रौ विषयासक्त चेतनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003821047, "chapter_id": 23821, "verse_number": "२-४-८-४८", "content_sanskrit": "रेमिरे देववनिता यथाकामं मया सह ।\nमुक्तामल्लिकमाल्यानि निपेतुस्तानि योषिताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003821048, "chapter_id": 23821, "verse_number": "२-४-८-४९", "content_sanskrit": "तपतो रोमशस्यैव तद्दृष्ट्वा कुपितो मुनिः ।\nयोषितां नाऽपराधोयं यासां वै परतंत्रता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003821049, "chapter_id": 23821, "verse_number": "२-४-८-५०", "content_sanskrit": "अयमेव दुराचारः शापार्ह इति चाऽब्रवीत् ।\nत्वं ब्रह्मराक्षसो भूत्वा वटवृक्षे चरेति माम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003821050, "chapter_id": 23821, "verse_number": "२-४-८-५१", "content_sanskrit": "प्रसादितो मया सोऽथ विशापमपि दत्तवान् ।\nतुलसीपत्रमाहात्म्यं विष्णोर्नाम तथा द्विजात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003821051, "chapter_id": 23821, "verse_number": "२-४-८-५२", "content_sanskrit": "यदा शृणोषि सद्यस्त्वं विमुक्तिं यास्यसे पराम् ।\nइति शप्तस्तु मुनिना चिरकालं सुदुःखितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003821052, "chapter_id": 23821, "verse_number": "२-४-८-५३", "content_sanskrit": "वसाम्यत्र वटे दैवाद्भवद्दर्शनतो ध्रुवम् ।\nमुक्तिर्जाता विप्रशापाद्द्वितीयस्य कथां शृणु ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003821053, "chapter_id": 23821, "verse_number": "२-४-८-५४", "content_sanskrit": "अयं मुनिवरः पूर्वं गुरुशुश्रूषणे रतः ।\nगुरोराज्ञामनादृत्य ब्रह्मराक्षसतां गतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003821054, "chapter_id": 23821, "verse_number": "२-४-८-५५", "content_sanskrit": "युष्मत्प्रसादादधुना ब्रह्मशापाद्विमोचितः ।\nतीर्थयात्राफलं चैव युवाभ्यामिह साधितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003821055, "chapter_id": 23821, "verse_number": "२-४-८-५६", "content_sanskrit": "उत्तरोत्तरपुण्यानि वर्धंते च दिनेदिने ।\nइत्युक्त्वा तौ मुनिवरौ प्रणम्य च पुनःपुनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003821056, "chapter_id": 23821, "verse_number": "२-४-८-५७", "content_sanskrit": "तावनुज्ञाप्य तौ धाम जग्मतुः परया मुदा ।\nततस्तौ तीर्थयात्रार्थं परमौ मुनिपुंगवौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003821057, "chapter_id": 23821, "verse_number": "२-४-८-५८", "content_sanskrit": "शंसंतौ तुलसीं पुण्यां जग्मतुर्मुनिपुंगव ।\nएवं नारद माहात्म्यं तुलस्याः को नु वर्णयेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003821058, "chapter_id": 23821, "verse_number": "२-४-८-५९", "content_sanskrit": "तस्मान्नारद मासेऽस्मिन्कार्तिके हरितुष्टिदे ।\nकर्तव्या तुलसीपूजा नाऽत्र कार्या विचारणा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003821059, "chapter_id": 23821, "verse_number": "२-४-८-६०", "content_sanskrit": "एवमंग व्रतान्येव प्रोक्तानि मुनिसत्तम ।\nउपांगानि प्रवक्ष्यामि वालखिल्योदितानि च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003821060, "chapter_id": 23821, "verse_number": "२-४-८-६१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे कार्तिकमासमाहात्म्ये तुलसीमाहात्म्यवर्णनं नामाऽष्टमोऽध्यायः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]