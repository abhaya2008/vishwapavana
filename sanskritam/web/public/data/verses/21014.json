, "display_order": 37}, {"id": 7001014037, "chapter_id": 21014, "verse_number": "४-२०-३८", "content_sanskrit": "सत्यवतीनियोगाच्च मत्पुत्रः कृष्णद्वैपायनो मातुर्वचनमनतिक्रमणीयमिति कृत्वा विचित्रवीर्यक्षेत्रे धृतराष्ट्रपाण्डुतत्प्रहितभुजिष्यायां विदुरं चोत्पादयामास  ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001014038, "chapter_id": 21014, "verse_number": "४-२०-३९", "content_sanskrit": "धतराष्ट्रोपि गान्धार्यां दुर्योधनदुः शासनप्रधानं पुत्रशतमुत्पादयामास  ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001014039, "chapter_id": 21014, "verse_number": "४-२०-४०", "content_sanskrit": "पाण्ढोरप्यरण्ये मृगयायामृषिशापोपहतप्रजाजननसामर्थ्यस्य धर्मवायुशक्रैर्युधिष्ठिरभीमसेनार्जुनाः कुन्त्यां नकुलसहदेवौ चाश्विभ्यां माद्रयां पञ्चपुत्राःसमुत्पादिताः  ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001014040, "chapter_id": 21014, "verse_number": "४-२०-४१", "content_sanskrit": "तेषां च द्रौपद्यां पञ्चैव बभूवुः  ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001014041, "chapter_id": 21014, "verse_number": "४-२०-४२", "content_sanskrit": "युधिष्ठिरात्प्रतिविन्ध्यः भीमसेनाच्छुतसेनः श्रुतकीर्तिरर्जुनाच्छुतानीको नकुलाच्छुतकर्मा सहदेवात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001014042, "chapter_id": 21014, "verse_number": "४-२०-४३", "content_sanskrit": "काशी च भीमसेनादेव सर्वगं सुतमवाप  ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001014043, "chapter_id": 21014, "verse_number": "४-२०-४४", "content_sanskrit": "यौधेयी युधिष्छिराद्देवकं पुत्रमवाप  ॥४४॥", "padacc