4, "verse_number": "४-२०-५२", "content_sanskrit": "अभिमन्योरुत्तरायां परिक्षीणेषु कुरुष्वश्वत्थामप्रयुक्तब्रह्मस्त्रेण गर्भ एव भस्मीकृतो भगवतःसकलसुरासुरवन्दितचरणयुगलस्यात्मेच्छया कारममानुषरूपधारीणोनुभावात्पुनर्जीवितमवाप्य परीक्षिज्जज्ञे  ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001014052, "chapter_id": 21014, "verse_number": "४-२०-५३", "content_sanskrit": "योऽयं सांप्रतमेदद्भूमण्डलमखण्डितायतिधर्मेण पालयतीति  ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]