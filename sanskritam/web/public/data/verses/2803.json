[{"id": 2084781, "chapter_id": 2803, "verse_number": "१२-३०८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084782, "chapter_id": 2803, "verse_number": "१२-३०८-१", "content_sanskrit": "किं तदक्षरमित्युक्तं यस्मान्नावर्तते पुनः।\nकिंच तत्क्षरमित्युक्तं यस्मादावर्तते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084783, "chapter_id": 2803, "verse_number": "१२-३०८-२", "content_sanskrit": "अक्षरधरयोर्व्यक्तिं पृच्छाम्यरिनिषूदन।\nउपलब्धुं महाबाहो तत्त्वेन कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084784, "chapter_id": 2803, "verse_number": "१२-३०८-३", "content_sanskrit": "त्वं हि ज्ञाननिधिर्विप्रैरुच्यसे वेदपारगैः।\nऋषिभिश्च महाभागैर्यतिभिश्च महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084785, "chapter_id": 2803, "verse_number": "१२-३०८-४", "content_sanskrit": "शेषमत्यं दिनानां ते दक्षिणायनभास्करे।\nआवृत्ते भगवत्यर्के गन्तासि परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084786, "chapter_id": 2803, "verse_number": "१२-३०८-५", "content_sanskrit": "त्वयि प्रतिगते श्रेयः कुतः श्रोष्यामहे वयम्।\nकुरुवंशप्रदीपस्त्वं ज्ञानदीपेन दीप्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084787, "chapter_id": 2803, "verse_number": "१२-३०८-६", "content_sanskrit": "तदेतच्छ्रोतुमिच्छामि त्वत्तः कुरुकुलोद्वह।\nन तृष्यामीह राजेन्द्र शृण्वन्नमृतमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084788, "chapter_id": 2803, "verse_number": "१२-३०८-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084789, "chapter_id": 2803, "verse_number": "१२-३०८-७", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम्।\nवसिष्ठस्य च संवादं करालजनकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084790, "chapter_id": 2803, "verse_number": "१२-३०८-८", "content_sanskrit": "वसिष्ठं श्रेष्ठमासीनमृषीणां भास्करद्युतिम्।\nपप्रच्छ जनको राजा ज्ञानं नैःश्रेयसं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084791, "chapter_id": 2803, "verse_number": "१२-३०८-९", "content_sanskrit": "परमध्यात्मकुशलमध्यात्मगतिनिश्चयम्।\nमैत्रावरुणिमासीनमभिवाद्य कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084792, "chapter_id": 2803, "verse_number": "१२-३०८-१०", "content_sanskrit": "स्वक्षरं प्रश्रितं वाक्यं मधुरं चाप्यनुल्वणम्।\nपप्रच्छर्षिवरं राजा करालजनकः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084793, "chapter_id": 2803, "verse_number": "१२-३०८-११", "content_sanskrit": "भगवञ्श्रोतुमिच्छामि परं ब्रह्म सनातनम्।\nयस्मान्न पुनरावृत्तिमाप्नुवन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084794, "chapter_id": 2803, "verse_number": "१२-३०८-१२", "content_sanskrit": "यच्च तत्क्षरमित्युक्तं यत्रेदं क्षरते जगत्।\nयच्चाक्षरमिति प्रोक्तं शिवं क्षेम्यमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084795, "chapter_id": 2803, "verse_number": "१२-३०८-१३x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084796, "chapter_id": 2803, "verse_number": "१२-३०८-१३", "content_sanskrit": "श्रूयतां पृथिवीपाल क्षरतीदं यथा जगत्।\nयन्न क्षरति पूर्वेण यावत्कालेन चाप्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084797, "chapter_id": 2803, "verse_number": "१२-३०८-१४", "content_sanskrit": "युगं द्वादशसाहस्रं कल्पं विद्धि चतुर्युगम्।\nदशकल्पशतावृत्तमहस्तद्ब्राह्ममुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084798, "chapter_id": 2803, "verse_number": "१२-३०८-१५", "content_sanskrit": "रात्रिश्चैतावती राजन्यस्यान्ते प्रतिबुध्यते।\nसृजत्यनन्तकर्माणं महान्तं भूतमग्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084799, "chapter_id": 2803, "verse_number": "१२-३०८-१६", "content_sanskrit": "मूर्तिमन्तममूर्तात्मा विश्वं शंभुः स्वयंभुवम्।\nअणिमा लघिमा प्राप्तिरीशानं ज्योतिरव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084800, "chapter_id": 2803, "verse_number": "१२-३०८-१७", "content_sanskrit": "सर्वतः पाणिपादं तत्सर्वतोक्षिशिरोमुखम्।\nसर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084801, "chapter_id": 2803, "verse_number": "१२-३०८-१८", "content_sanskrit": "हिरण्यगर्भो भगवानेष बुद्धिरिति स्मृतः।\nमहानिति च योगेषु विरिञ्चिरिति चाप्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084802, "chapter_id": 2803, "verse_number": "१२-३०८-१९", "content_sanskrit": "साङ्ख्ये च पठ्यते शास्त्रे नामभिर्बहुधात्मकः।\nविचित्ररूपो विश्वात्मा एकाक्षर इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084803, "chapter_id": 2803, "verse_number": "१२-३०८-२०", "content_sanskrit": "वृतं नैकात्मकं येन कृतं त्रैलोक्यमात्मना।\nतथैव बहुरूपत्वाद्विश्वरूप इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084804, "chapter_id": 2803, "verse_number": "१२-३०८-२१", "content_sanskrit": "एष वै विक्रियापन्नः सृजत्यात्मानमात्मना।\nअहंकारं महातेजाः प्रजापतिरंकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084805, "chapter_id": 2803, "verse_number": "१२-३०८-२२", "content_sanskrit": "अव्यक्ताद्व्यक्तमापन्नं विद्यासर्गं वदन्ति तम्।\nमहान्तं चाप्यहंकारमविद्यासर्गमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084806, "chapter_id": 2803, "verse_number": "१२-३०८-२३", "content_sanskrit": "अपरश्च परश्चैव समुत्पन्नौ तथैकतः।\nविद्याविद्येति विख्याते श्रुतिशास्त्रार्थचिन्तकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084807, "chapter_id": 2803, "verse_number": "१२-३०८-२४", "content_sanskrit": "भूतसर्गमहंकारात्तृतीयं विद्धि पार्थिव।\nअहंकारेषु सर्वेषु चतुर्थं विद्धि वैकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084808, "chapter_id": 2803, "verse_number": "१२-३०८-२५", "content_sanskrit": "वायुर्ज्योतिरथाकाशमापोऽथ पृथिवी तथा।\nशब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084809, "chapter_id": 2803, "verse_number": "१२-३०८-२६", "content_sanskrit": "एवं युगपदुत्पन्नं दशवर्गमसंशयम्।\nपञ्चमं विद्धि राजेन्द्र भौतिकं सर्गमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084810, "chapter_id": 2803, "verse_number": "१२-३०८-२७", "content_sanskrit": "श्रोत्रं त्वक्चक्षुषी जिह्वा घ्राणमेव च पञ्चमम्।\nवाक्च हस्तौ च पादौ च पायुर्मेढ्रं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084811, "chapter_id": 2803, "verse_number": "१२-३०८-२८", "content_sanskrit": "बुद्धीन्द्रियाणि चैतानि तथा कर्मेन्द्रियाणि च।\nसंभूतानीह युगपन्मनसा सह पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084812, "chapter_id": 2803, "verse_number": "१२-३०८-२९", "content_sanskrit": "एषा तत्त्वचतुर्विशत्सर्वाकृतिषु वर्तते।\nयां ज्ञात्वा नाभिशोचन्ति ब्राह्मणास्तत्त्वदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084813, "chapter_id": 2803, "verse_number": "१२-३०८-३०", "content_sanskrit": "एतद्देहं समाख्यानं त्रैलोक्ये सर्वदेहिषु।\nवेदितव्यं नरश्रेष्ठ सदेवनरदानवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084814, "chapter_id": 2803, "verse_number": "१२-३०८-३१", "content_sanskrit": "सयक्षभूतगन्धर्वे सकिन्नरमहोरगे।\nसचारणपिशाचे वै सदेवर्षिनिशाचरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084815, "chapter_id": 2803, "verse_number": "१२-३०८-३२", "content_sanskrit": "सदंशकीटमशक्रे सपूतिकृमिमूषिके।\nशुनि श्वपाके चैणेये सचाण्डाले सपुल्कसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084816, "chapter_id": 2803, "verse_number": "१२-३०८-३३", "content_sanskrit": "हस्त्यश्वखरशार्दूले सवृके गवि चैव ह।\nयच्च मूर्तिमयं किचित्सर्वत्रैतन्निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084817, "chapter_id": 2803, "verse_number": "१२-३०८-३४", "content_sanskrit": "जले भुवि तथाऽऽकाशे नान्यत्रेति विनिश्चयः।\nस्थानं देहवतामस्ति इत्येवमनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084818, "chapter_id": 2803, "verse_number": "१२-३०८-३५", "content_sanskrit": "कृत्स्नमेतावतस्तात क्षरते व्यक्तसंज्ञितम्।\nअहन्यहनि भूतात्मा ततः क्षर इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084819, "chapter_id": 2803, "verse_number": "१२-३०८-३६", "content_sanskrit": "एतद्धि क्षरमित्युक्तं क्षरतीदं यथा जगत्।\nजगन्मोहात्मकं प्राहुरव्यक्तं व्यक्तसंज्ञकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084820, "chapter_id": 2803, "verse_number": "१२-३०८-३७", "content_sanskrit": "महांश्चैवाग्रजो नित्यमेतत्क्षरनिदर्शनम्।\nकथितं ते महाराजन्यस्मान्नावर्तते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084821, "chapter_id": 2803, "verse_number": "१२-३०८-३८", "content_sanskrit": "पञ्चर्विशतिमो विष्णुर्निस्तत्त्वस्तत्त्वसंज्ञितः।\nतत्त्वसंश्रयणादेतत्तत्वमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084822, "chapter_id": 2803, "verse_number": "१२-३०८-३९", "content_sanskrit": "यन्मर्त्यमसृजद्व्यक्तं तत्तन्मूर्त्यधितिष्ठति।\nचतुर्विशतिमोऽव्यक्तो ह्यमूर्तः पञ्चविंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084823, "chapter_id": 2803, "verse_number": "१२-३०८-४०", "content_sanskrit": "स एव हृदि सर्वासु मूर्तिष्वात्मावतिष्ठते।\nचेतयंश्चेतनान्नित्यं सर्वमूर्तिरमूर्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084824, "chapter_id": 2803, "verse_number": "१२-३०८-४१", "content_sanskrit": "सर्वप्रत्ययधर्मिण्यां स सर्गः प्रत्ययात्मकः।\nगोचरे वर्तते नित्यं निर्गुणो गुणसंज्ञिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084825, "chapter_id": 2803, "verse_number": "१२-३०८-४२", "content_sanskrit": "एवमेष महानात्मा सर्गप्रलयकोविदः।\nविकुर्वाणः प्रकृतिमानभिमन्यत्यबुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084826, "chapter_id": 2803, "verse_number": "१२-३०८-४३", "content_sanskrit": "तमः सत्वरजोयुक्तस्तासु तास्विह योनिषु।\nलीयते प्रतिबुद्धत्वादबुद्धजनसेवनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084827, "chapter_id": 2803, "verse_number": "१२-३०८-४४", "content_sanskrit": "सहवासनिवासात्मा नान्योऽहमिति मन्यते।\nयोऽहं सोहमिति ह्युक्त्वा गुणानेवानुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084828, "chapter_id": 2803, "verse_number": "१२-३०८-४५", "content_sanskrit": "तमसा तामसान्भावान्विविधान्प्रतिपद्यते।\nरजसा राजसांश्चैव सात्विकान्सत्वसंश्रयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084829, "chapter_id": 2803, "verse_number": "१२-३०८-४६", "content_sanskrit": "शुक्ललोहितकृष्णानि रूपाण्येतानि त्रीणि तु।\nसर्वाण्येतानि रूपाणि यानीह प्राकृतानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084830, "chapter_id": 2803, "verse_number": "१२-३०८-४७", "content_sanskrit": "तामसा निरयं यान्ति राजसा मानुपानथ।\nसात्विका देवलोकाय गच्छन्ति सुखभागिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084831, "chapter_id": 2803, "verse_number": "१२-३०८-४८", "content_sanskrit": "निष्कैवल्येन पापेन तिर्यग्योनिमवाप्नुयात्।\nपुण्यपापेन मानुष्यं पुण्येनैकेन देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084832, "chapter_id": 2803, "verse_number": "१२-३०८-४९", "content_sanskrit": "एवमव्यक्तविषयं क्षरमाहुर्मनीषिणः।\nपञ्चविंशतिमो योऽयं ज्ञानादेव प्रवर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084833, "chapter_id": 2803, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टाधिकत्रिशततमोऽध्यायः॥ ३०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]