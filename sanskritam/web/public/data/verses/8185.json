[{"id": 900000844, "chapter_id": 8185, "verse_number": "1.1", "content_sanskrit": "केनेषितं पतति प्रेषितं मनः केन प्राणः प्रथमः प्रैति युक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000845, "chapter_id": 8185, "verse_number": "1.2", "content_sanskrit": "यदि मन्यसे सुवेदेति दहरमेवापि नूनं त्वं वेत्थ ब्रह्मणो रूपम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000846, "chapter_id": 8185, "verse_number": "1.3", "content_sanskrit": "ब्रह्म ह देवेभ्यो विजिग्ये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000847, "chapter_id": 8185, "verse_number": "1.4", "content_sanskrit": "ब्रह्मेति होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]