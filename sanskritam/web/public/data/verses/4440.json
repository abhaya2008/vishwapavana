[{"id": 2158718, "chapter_id": 4440, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158719, "chapter_id": 4440, "verse_number": "१", "content_sanskrit": "यथा वदसि मे सूत एकस्य बहुभिः सह ।\nसङ्ग्रामं तुमुलं घोरं जयं चैव महात्मनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158720, "chapter_id": 4440, "verse_number": "२", "content_sanskrit": "अश्रद्धेयमिवाश्चर्यं सौभद्रस्याथ विक्रमम् ।\nकिन्तु नात्यद्भुतं तेषां धर्मो येषां व्यपाश्रयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158721, "chapter_id": 4440, "verse_number": "३", "content_sanskrit": "दुर्योधने तु विमुखे राजपुत्रशते हते ।\nसौभद्रे प्रतिपत्तिं कां प्रत्यपद्यन्त मामकाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158722, "chapter_id": 4440, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158723, "chapter_id": 4440, "verse_number": "४", "content_sanskrit": "संशुष्कास्याश्चलन्नेत्राः प्रस्विन्ना रोमहर्षिणः ।\nपलायनकृतोत्साहा निरुत्साहा द्विषज्जये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158724, "chapter_id": 4440, "verse_number": "५", "content_sanskrit": "हतान् भ्रातॄन् पितॄन् पुत्रान् सम्बन्धीन् बान्धवानपि ।\nउत्सृज्योत्सृज्य गच्छन्ति त्वरयन्तो हयद्विपान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158725, "chapter_id": 4440, "verse_number": "६", "content_sanskrit": "तां प्रभग्नां चमूं दृष्ट्वा द्रोणो द्रौणिर्बृहद्बलः ।\nकृपो दुर्योधनः कर्णः कृतवर्माऽथ सौबलिः ।\nअभिद्रुताः सुसङ्क्रुद्धाः सौभद्रमपराजितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158726, "chapter_id": 4440, "verse_number": "७", "content_sanskrit": "तेऽपि पौत्रेण ते राजन् प्रायशो विमुखीकृताः ।\nसौभद्रेण महाराज शक्रप्रतिमतेजसा\t॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158727, "chapter_id": 4440, "verse_number": "८", "content_sanskrit": "एकस्तु सुखसंवृद्धो बाल्याद् दर्पाच्च निर्भयः ।\nइष्वस्त्रकुशलः शूरो लक्षणोऽर्जुनिमभ्ययात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158728, "chapter_id": 4440, "verse_number": "९", "content_sanskrit": "तमन्वगेवास्य पिता पुत्रगर्ध्यन्ववर्तत ।\nअनुदुर्योधनं चान्ये सन्निवृत्ता महारथाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158729, "chapter_id": 4440, "verse_number": "११", "content_sanskrit": "तं तेऽभिषिषिचुः मेघा गिरिमिवाम्बुभिः ।\nस च तान् प्रममाथैको विष्वग्वातो यथाऽम्बुदान्\t॥१०॥\nपौत्रं तु तव दुर्धर्षं लक्षणं प्रियदर्शनम् ।\nपितुः समीपे तिष्ठन्तं शूरमुद्यतकार्मुकम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158730, "chapter_id": 4440, "verse_number": "१२", "content_sanskrit": "अत्यन्तसुखसंवृद्धं धनेश्वरसुतोपमम् ।\nआससाद रणे कार्ष्णिर्मत्तो मत्तमिव द्विपम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158731, "chapter_id": 4440, "verse_number": "१३", "content_sanskrit": "सिंहशावो वने यद्वत् पुण्डरीकशिशुं यथा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158732, "chapter_id": 4440, "verse_number": "१४", "content_sanskrit": "लक्षणेन तु सङ्गम्य सौभद्रः परवीरहा ।\nशरैः स निशितैस्तीक्ष्णैः बाह्वोरुरसि चार्पयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158733, "chapter_id": 4440, "verse_number": "१५", "content_sanskrit": "समक्रुद्ध्यन्महाबाहुर्दण्डाहत इवोरगः ।\nपौत्रस्तव महाबाहुस्तव पौत्रमभाषत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158734, "chapter_id": 4440, "verse_number": "", "content_sanskrit": "अभिमन्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158735, "chapter_id": 4440, "verse_number": "१६", "content_sanskrit": "सुदृष्टः क्रियतां लोको यमलोकं गमिष्यसि ।\nपश्यतां बान्धवानां त्वां नयामि यमसादनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158736, "chapter_id": 4440, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158737, "chapter_id": 4440, "verse_number": "१७", "content_sanskrit": "एवमुक्त्वा ततो भल्लं सौभद्रः परवीरहा ।\nउद्बबर्ह महाबाहुर्निर्मुक्तोरगसन्निभम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158738, "chapter_id": 4440, "verse_number": "१८", "content_sanskrit": "स तस्य भुजनिर्मुक्तो लक्षणस्य सुदर्शनम् ।\nसुनासं सुभ्रु केशान्तं शिरोऽहार्षीत् सकुण्डलम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158739, "chapter_id": 4440, "verse_number": "१९", "content_sanskrit": "पौत्रस्तु तव दुर्धर्षं लक्षणं प्रियदर्शनम् ।\nपितुः समीपे तिष्ठन्तं प्राहिणोद् यमसादनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158740, "chapter_id": 4440, "verse_number": "२०", "content_sanskrit": "अत्यन्तसुखसंवृद्धं धनेश्वरसुतोपमम् ।\nलक्षणं निहतं दृष्ट्वा हाहेत्युच्चुक्रुशुर्जनाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158741, "chapter_id": 4440, "verse_number": "२१", "content_sanskrit": "ततो दुर्योधनः क्रुद्धः प्रिये पुत्रे निपातिते ।\nघ्नतैनमिति चुक्रोश क्षत्रियान् क्षत्रियर्षभः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158742, "chapter_id": 4440, "verse_number": "२२", "content_sanskrit": "ततो द्रोणः कृपः कर्णो द्रोणपुत्रो बृहद्बलः ।\nकृतवर्मा च हार्दिक्यः षड्रथाः पर्यवारयन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158743, "chapter_id": 4440, "verse_number": "२३", "content_sanskrit": "स तान् विद्ध्वा शितैर्बाणैर्विमुखीकृत्य चार्जुनिः ।\nवेगेनाभ्यद्रवत् क्रुद्धः सैन्धवं च महाबलम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158744, "chapter_id": 4440, "verse_number": "२४", "content_sanskrit": "आवव्रुस्तस्य पन्थानं गजानीकेन दंसिताः ।\nकळिङ्गाश्च निषादाश्च क्राथपुत्रश्च वीर्यवान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158745, "chapter_id": 4440, "verse_number": "२५", "content_sanskrit": "तैर्नदद्भिर्यथाऽऽदित्यो घनाच्छन्नो विशांपते॥\nतत् प्रतप्तमिवात्यर्थं युद्धमासीद् विशाम्पते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158746, "chapter_id": 4440, "verse_number": "२६", "content_sanskrit": "ततस्तत् कुञ्जरानीकं व्यधमद् धृष्टमार्जुनिः ।\nयथाऽखिलान् नित्यगतिर्जलदान् शतशोऽम्बरे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2158747, "chapter_id": 4440, "verse_number": "२७", "content_sanskrit": "ततः क्राथं शरव्रातैरार्जुनिः समवारयत् ।\nअथेतरे सन्निवृत्ताः पुनर्द्रोणमुखा रथाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2158748, "chapter_id": 4440, "verse_number": "२८", "content_sanskrit": "परमास्त्राणि धुन्वानाः सौभद्रमभिदुद्रुवुः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2158749, "chapter_id": 4440, "verse_number": "२९", "content_sanskrit": "तान् निवार्यार्जुनिर्बाणैः क्राथपुत्रमथार्दयत् ।\nशरौघेणाप्रमेयेण त्वरमाणो जिघांसया\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2158750, "chapter_id": 4440, "verse_number": "३०", "content_sanskrit": "सधनुर्बाणकेयूरौ बाहू समकुटं शिरः ।\nछत्रं ध्वजं नियन्तारमश्वांश्चास्य न्यपातयत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2158751, "chapter_id": 4440, "verse_number": "३१", "content_sanskrit": "कुलशीलश्रुतधनैः कीर्त्या चास्त्रबलेन च ।\nयुक्ते तस्मिन् हते वीराः प्रायशो विमुखाऽभवन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2158752, "chapter_id": 4440, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि पञ्चचत्वारिंशोऽध्यायः ॥ ४५ ॥\nअभिमन्युवधपर्वणि चतुर्दशोऽध्यायः ॥ १४ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]