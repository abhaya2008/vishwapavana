[{"id": 7004868000, "chapter_id": 24868, "verse_number": "७-१-५१-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि केतुलिंगं महाप्रभम् ।\nराह्वीशानादुत्तरे च मंगलायाश्च दक्षिणे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004868001, "chapter_id": 24868, "verse_number": "७-१-५१-२", "content_sanskrit": "धनुषोंतरमानेन नातिदूरे व्यवस्थितम् ।\nलिंगं महाप्रभावं हि सर्वपातकनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004868002, "chapter_id": 24868, "verse_number": "७-१-५१-३", "content_sanskrit": "केतुर्नाम ग्रहोत्युग्रः शिवसद्भावभावितः ।\nवर्तुलोऽतीव विस्तीर्णो लोचनाभ्यां सुभीषणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004868003, "chapter_id": 24868, "verse_number": "७-१-५१-४", "content_sanskrit": "पलालधूमसंकाशो ग्रहपीडापहारकः ।\nतत्राकरोत्तपश्चोग्रं दिव्याब्दानां शतं प्रिये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004868004, "chapter_id": 24868, "verse_number": "७-१-५१-५", "content_sanskrit": "तस्य तुष्टो महादेवो ग्रह त्वं प्रददौ प्रिये ।\nएकादशशतानां च ग्रहाणामाधिपत्यताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004868005, "chapter_id": 24868, "verse_number": "७-१-५१-६", "content_sanskrit": "तत्रस्थं पूजयेद्भक्त्या केतुलिंगं महाप्रभम् ।\nकेतूदये महाघोरे तस्मिन्दृष्टे विशेषतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004868006, "chapter_id": 24868, "verse_number": "७-१-५१-७", "content_sanskrit": "ग्रहपीडासु चोग्रासु पूजयेत्तं विधानतः ।\nपुष्पैर्गंधैस्तथा धूपैर्नैवेद्यैर्विविधैः शुभैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004868007, "chapter_id": 24868, "verse_number": "७-१-५१-८", "content_sanskrit": "तोषयेद्विधिवद्देवं केतुं कल्मषनाशनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004868008, "chapter_id": 24868, "verse_number": "७-१-५१-९", "content_sanskrit": "इति संक्षेपतः प्रोक्तं केतुलिंगं महोदयम् ।\nग्रहपीडोपशमनं सर्वपातकनाशनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004868009, "chapter_id": 24868, "verse_number": "७-१-५१-१०", "content_sanskrit": "एतानि नव लिंगानि ग्रहाणां कथितानि ते ।\nयः पश्यति नरो नित्यं तस्य पीडाभयं कुतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004868010, "chapter_id": 24868, "verse_number": "७-१-५१-११", "content_sanskrit": "न दौर्भाग्यं कुले तस्य न रोगी नैव दुःखितः ।\nजायते पुत्रवद्देवि तं रक्षंति महाग्रहाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004868011, "chapter_id": 24868, "verse_number": "७-१-५१-१२", "content_sanskrit": "इति ते कथितं सम्यक्चतुर्दशायतनं प्रिये ।\nविघ्नेश्वरं समारभ्य यावत्केतुप्रतिष्ठितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004868012, "chapter_id": 24868, "verse_number": "७-१-५१-१३", "content_sanskrit": "नवग्रहेश्वराणां तु माहात्म्यं पापनाशनम् ।\nतथैव पंचलिंगानां श्रुत्वा पापैः प्रमुच्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004868013, "chapter_id": 24868, "verse_number": "७-१-५१-१४", "content_sanskrit": "कपर्द्दिनं समारभ्य चंडनाथांतकानि च ।\nपंचैव मुद्रालिंगानि नापुण्यो वेद मानवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004868014, "chapter_id": 24868, "verse_number": "७-१-५१-१५", "content_sanskrit": "सूर्येश्वरं समारभ्य केतुलिंगांतकानि वै ।\nनवग्रहाणां लिंगानि नान्यो जानाति कश्चन ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004868015, "chapter_id": 24868, "verse_number": "७-१-५१-१६", "content_sanskrit": "चतुर्दशविधा त्वेवं प्रोक्ताऽयतनसंगतिः ।\nयश्चैनां वेद भावेन स क्षेत्रफलमश्नुते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004868016, "chapter_id": 24868, "verse_number": "७-१-५१-१७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये केत्वीश्वरमाहात्म्यवर्णननामैकपंचाशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]