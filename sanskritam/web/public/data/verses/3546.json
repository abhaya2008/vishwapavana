[{"id": 2118362, "chapter_id": 3546, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118363, "chapter_id": 3546, "verse_number": "१", "content_sanskrit": "उक्तवन्तो यदा वाक्यमसकृत् सर्ववृष्णयः ।\nततोऽब्रवीद् वासुदेवो वाक्यं धर्मार्थसंहितम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118364, "chapter_id": 3546, "verse_number": "२", "content_sanskrit": "मयोक्तं न श्रुतं पूर्वं सहितैः सर्वयादवैः ।\nअतिक्रान्तमतिक्रान्तं न निवर्तति कर्हि चित् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118365, "chapter_id": 3546, "verse_number": "३", "content_sanskrit": "शृणुध्वं सहिताः सर्वे मम वाक्यं सहेतुकम् ।\nनावमानं कुलस्यास्य गुडाकेशः प्रयुक्तवान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118366, "chapter_id": 3546, "verse_number": "४", "content_sanskrit": "सम्मानोऽभ्यधिकस्तेन प्रयुक्तोऽयं न संशयः ।\nअर्थलुब्धान् न वः पार्थो मन्यते सात्वतान् सदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118367, "chapter_id": 3546, "verse_number": "५", "content_sanskrit": "स्वयंवरमनाधृष्यं मन्यते चापि पाण्डवः ।\nप्रदानमपि कन्यायाः पशुवत् को नु मंस्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118368, "chapter_id": 3546, "verse_number": "६", "content_sanskrit": "विक्रयं चाप्यपत्यस्य कः कुर्यात् पुरुषो भुवि ।\nएतान् दोषांस्तु कौन्तेयो दृष्टवानिति मे मतिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118369, "chapter_id": 3546, "verse_number": "७", "content_sanskrit": "क्षत्रियाणां तु वीर्येण प्रशस्तं हरणं बलात् ।\nअतः प्रसह्य हृतवान् कन्यां धर्मेण पाण्डवः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118370, "chapter_id": 3546, "verse_number": "८", "content_sanskrit": "उचितश्चैव सम्बन्धः सुभद्रा च यशस्विनी ।\nएतस्याः सदृशः पार्थः प्रसह्य हृतवानुत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118371, "chapter_id": 3546, "verse_number": "९", "content_sanskrit": "भरतस्यान्वये जातं शन्तनोः पौत्रमद्य वै ।\nकुन्तिभोजात्मजापुत्रं को बुभूषेन्नचार्जुनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118372, "chapter_id": 3546, "verse_number": "१०", "content_sanskrit": "न च पश्यामि यः पार्थं विक्रमेण पराजयेत् ।\nअपि सर्वेषु लोकेषु सदेवमनुजेष्वपि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118373, "chapter_id": 3546, "verse_number": "११", "content_sanskrit": "स च नाम रथस्तादृङ् मदीयास्ते च वाजिनः ।\nमम शस्त्रा विशेषेण तूणी चाक्षयसायकौ \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118374, "chapter_id": 3546, "verse_number": "१२", "content_sanskrit": "योद्धा पार्थश्च शीघ्रास्त्रः को नु तेन समो भवेत् ।\nतमनुद्रुत्य सान्त्वेन परमेण धनञ्जयम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118375, "chapter_id": 3546, "verse_number": "१३", "content_sanskrit": "हृष्टाः सर्वे निवर्तध्वं ममैषा परमा मतिः ।\nयदि निर्जित्य वः पार्थो बलाद् गच्छेत् स्वकं पुरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118376, "chapter_id": 3546, "verse_number": "१४", "content_sanskrit": "विनश्येद् वो यशः सद्यो न तु सान्त्वे पराजयः ।\nपितृष्वसायाः पुत्रो मे सम्बन्धं नार्हति द्विषाम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118377, "chapter_id": 3546, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118378, "chapter_id": 3546, "verse_number": "१५", "content_sanskrit": "तच्छ्रुत्वा वासुदेवस्य तथा कर्तुं जनाधिप ।\nउद्योगं कृतवन्तस्ते भेरीं सन्नाद्य यादवाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118379, "chapter_id": 3546, "verse_number": "१६", "content_sanskrit": "अर्जुनस्तु तदा श्रुत्वा भेरीसन्नादनं महत् ।\nकौन्तेयस्त्वरमाणस्तु सुभद्रामभ्यभाषत \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118380, "chapter_id": 3546, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118381, "chapter_id": 3546, "verse_number": "१७", "content_sanskrit": "आयान्ति वृष्णयः सर्वे ससुहृज्जनबान्धवाः  ।\nत्वदर्थं योद्धुकामास्ते मदरक्तान्तलोचनाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118382, "chapter_id": 3546, "verse_number": "१८", "content_sanskrit": "प्रमदानशुचीन् मूढान् सुरामत्तान् नराधमान् ।\nवमनं पानशाटींस्तान् करिष्यामि शरोत्तमैः ।\nउताहो वा मदोन्मत्तान् नयिष्यामि यमक्षयम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118383, "chapter_id": 3546, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118384, "chapter_id": 3546, "verse_number": "१९", "content_sanskrit": "एवमुक्त्वा प्रियां पार्थो न्यवर्तत महाबलः ।\nनिवर्तमानं दृष्ट्वैव सुभद्रा त्रस्ततां गता ।\nएवं मा वद पार्थेति पादयोः पतिता तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118385, "chapter_id": 3546, "verse_number": "", "content_sanskrit": "सुभद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118386, "chapter_id": 3546, "verse_number": "२०", "content_sanskrit": "सुभद्रा तु कलिर्जाता वृष्णीनां निधनाय च ।\nएवं ब्रुवन्तः पौरास्ते जनवादं जनाः प्रभो \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118387, "chapter_id": 3546, "verse_number": "२१", "content_sanskrit": "मम शोकं विवर्धन्ते तस्मात् पापं न चिन्तय ।\nपरिवादभयान्मुक्ता त्वत्प्रसादाद् भवाम्यहम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118388, "chapter_id": 3546, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118389, "chapter_id": 3546, "verse_number": "२२", "content_sanskrit": "एवमुक्तस्ततः पार्थः प्रियया भद्रया तदा ।\nगमनाय मतिं चक्रे पार्थः सत्यपराक्रमः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118390, "chapter_id": 3546, "verse_number": "२३", "content_sanskrit": "स्मितपूर्वं तदाऽऽभाष्य परिष्वज्य प्रियां तदा ।\nउत्थाप्य च ततः पार्थो याहि याहीति सोऽब्रवीत् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118391, "chapter_id": 3546, "verse_number": "२४", "content_sanskrit": "ततः सुभद्रा त्वरिता रश्मीन् सङ्गृह्य पाणिना ।\nचोदयामास जवनान् शीघ्रमश्वान् कृतत्वरा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118392, "chapter_id": 3546, "verse_number": "२५", "content_sanskrit": "ततस्तु कृतसन्नाहा वृष्णिवीराः समाहिताः ।\nप्रत्यानयार्थं पार्थस्य जवनैस्तुरगोत्तमैः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118393, "chapter_id": 3546, "verse_number": "२६", "content_sanskrit": "राजमार्गमनुप्राप्ता दृष्ट्वा पार्थस्य विक्रमम् ।\nप्रासादपङ्क्तिस्तम्भेषु वेदिकासु ध्वजेषु च \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118394, "chapter_id": 3546, "verse_number": "२७", "content_sanskrit": "अर्जुनस्य शरान् दृष्ट्वा विस्मयं परमं गताः ।\nकेशवस्य वचस्तथ्यं मन्यमानास्तु यादवाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118395, "chapter_id": 3546, "verse_number": "२८", "content_sanskrit": "अतीत्य शैलं रैवतकं श्रुत्वा तु विपृथोर्वचः ।\nअर्जुनेन कृतं श्रुत्वा गन्तुकामास्तु वृष्णयः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118396, "chapter_id": 3546, "verse_number": "२९", "content_sanskrit": "श्रुत्वा दीर्घगतं पार्थं न्यवर्तन्त नराधिपाः ।\nपुरोद्यानमतिक्रम्य विशालं च गिरिव्रजम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118397, "chapter_id": 3546, "verse_number": "३०", "content_sanskrit": "सानून्युज्जायिनीं चैव वनान्युपवनानि च ।\nपुण्येष्वानर्तराष्ट्रेषु वापीपद्मसरांसि च \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118398, "chapter_id": 3546, "verse_number": "३१", "content_sanskrit": "प्राप्य धेनुमतीतीर्थमश्वरोधसरः प्रति ।\nप्रेक्ष्यवृत्तस्ततः शैलमम्बुदं च नगोत्तमम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118399, "chapter_id": 3546, "verse_number": "३२", "content_sanskrit": "आराच्छृङ्गमथास्थाय तीर्त्वा कारवतीं नदीम् ।\nप्राप्य साल्वेयराष्ट्राणि निषधानप्यतीत्य च \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118400, "chapter_id": 3546, "verse_number": "३३", "content_sanskrit": "देवापृथुपुरं पश्यन् सर्वतः सुसमाहितः ।\nतमतीत्य महाबाहुर्देवारण्यमपश्यत \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118401, "chapter_id": 3546, "verse_number": "३४", "content_sanskrit": "पूजयामासुरायान्तं देवारण्ये महर्षयः ।\nस वनानि नदीः शैलान् गिरिप्रस्रवणानि च \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118402, "chapter_id": 3546, "verse_number": "३५", "content_sanskrit": "अतीत्य च तदा पार्थः सुभद्रासारथिस्तथा ।\nकौरवं विषयं प्राप्य विशोकः समपद्यत \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118403, "chapter_id": 3546, "verse_number": "३६", "content_sanskrit": "सोदर्याणां महाबाहुः सिंहाश्रयमिवाशयम् ।\nआरादुपवनोपेतां ददर्शाप्रतिमं पुरम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118404, "chapter_id": 3546, "verse_number": "२२५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चविंशत्यधिकद्विशततमोऽध्यायः ॥२२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118405, "chapter_id": 3546, "verse_number": "१", "content_sanskrit": "॥ इति हरणहारिकपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118406, "chapter_id": 3546, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]