[{"id": 6000087000, "chapter_id": 10087, "verse_number": null, "content_sanskrit": "अथ त्रयोविंशध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000087001, "chapter_id": 10087, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.001.m4a", "display_order": 2}, {"id": 6000087002, "chapter_id": 10087, "verse_number": "४-२३-१", "content_sanskrit": "दृष्ट्वाऽऽत्मानं प्रवयसमेकदा वैन्य आत्मवान्।\nआत्मना वर्धिताशेषसानुसर्गः प्रजापतिः॥ ४/२३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.002.m4a", "display_order": 3, "topics": [{"text": "सभार्येण पृथुना वने तपश्चरणम्", "range": "१–१८"}]}, {"id": 6000087003, "chapter_id": 10087, "verse_number": "४-२३-२", "content_sanskrit": "जगतस्तस्थुषश्चापि वृत्तिदो धर्मभृत् सताम्।\nनिष्पादितेश्वरादेशो यदर्थमिह जग्मिवान्॥ ४/२३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.003.m4a", "display_order": 4}, {"id": 6000087004, "chapter_id": 10087, "verse_number": "४-२३-३", "content_sanskrit": "आत्मजेष्वात्मजां न्यस्य विरहाद् रुदतीमिव।\nप्रजासु विमनास्वेकः सदारोऽगात् तपोवनम्॥ ४/२३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.004.m4a", "display_order": 5}, {"id": 6000087005, "chapter_id": 10087, "verse_number": "४-२३-४", "content_sanskrit": "तत्रापाद्यात्मनियमो वैखानससुसम्मते।\nआरब्ध उग्रतपसि यथा स्वविषये पुरा॥ ४/२३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.005.m4a", "display_order": 6}, {"id": 6000087006, "chapter_id": 10087, "verse_number": "४-२३-५", "content_sanskrit": "कन्दमूलफलाहारः शुष्कपर्णाशनःक्‍वचित्।\nअब्भक्षः कतिचित्पक्षान् वायुभक्षस्ततः परम्॥ ४/२३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.006.m4a", "display_order": 7}, {"id": 6000087007, "chapter_id": 10087, "verse_number": "४-२३-६", "content_sanskrit": "ग्रीष्मे पञ्चतपा वीरो वर्षास्वासारषाण्मुनिः।\nआकण्ठमग्नः शिशिर उदके स्थण्डिलेशयः॥ ४/२३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.007.m4a", "display_order": 8}, {"id": 6000087008, "chapter_id": 10087, "verse_number": "४-२३-७", "content_sanskrit": "तितिक्षुर्यतवाग् दान्त ऊर्ध्वरेता जितानिलः।\nआरिराधयिषुः कृष्णमाचरत् तप उत्तमम्॥ ४/२३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.008.m4a", "display_order": 9}, {"id": 6000087009, "chapter_id": 10087, "verse_number": "४-२३-८", "content_sanskrit": "तेन क्रमानुसिद्धेन ध्वस्तकर्मामलाशयः।\nप्राणायामैः सन्निरुद्धषड्वर्गच्छिन्नबन्धनः॥ ४/२३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.009.m4a", "display_order": 10}, {"id": 6000087010, "chapter_id": 10087, "verse_number": "४-२३-९", "content_sanskrit": "सनत्कुमारो भगवान् यदाहाध्यात्मिकं परम्।\nयोगं तेनैव पुरुषमभजत् पुरुषर्षभः॥ ४/२३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.010.m4a", "display_order": 11}, {"id": 6000087011, "chapter_id": 10087, "verse_number": "४-२३-१०", "content_sanskrit": "भगवद्धर्मिणः साधो श्रद्धया यततः सदा।\nभक्तिर्भगवति ब्रह्मण्यनन्यविषयाऽभवत्॥ ४/२३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.011.m4a", "display_order": 12}, {"id": 6000087012, "chapter_id": 10087, "verse_number": "४-२३-११", "content_sanskrit": "तस्यानया भगवतः परिशुद्धकर्मसत्त्वात्मनस्तदनुसंस्मरणानुपूर्व्या।\nज्ञानं विरक्तिमदभून्निशितेन येन चिच्छेद संशयपदं निजजीवकोशम्॥ ४/२३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.012.m4a", "display_order": 13}, {"id": 6000087013, "chapter_id": 10087, "verse_number": "४-२३-१२", "content_sanskrit": "छिन्नान्यधीरधिगतात्मगतिर्निरीहस्तत् तत्यजेऽच्छिनदिदं वयुनेन येन।\nतावन्न योगगतिभिर्यतिरप्रयत्नो यावद् गदाग्रजकथासु रतिं न कुर्यात्॥ ४/२३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.013.m4a", "display_order": 14}, {"id": 6000087014, "chapter_id": 10087, "verse_number": "४-२३-१३", "content_sanskrit": "एवं स वीरप्रवरः संयोज्यात्मानमात्मनि।\nब्रह्मभूतो दृढं काले तत्याज स्वकलेवरम्॥ ४/२३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.014.m4a", "display_order": 15}, {"id": 6000087015, "chapter_id": 10087, "verse_number": "४-२३-१४", "content_sanskrit": "संपीड्य पायुं पार्ष्णिभ्यां वायुमुत्सर्पयन् शनैः।\nनाभ्यां कोष्ठेष्ववस्थाप्य हृदुरःकण्ठशीर्षणि॥ ४/२३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.015.m4a", "display_order": 16}, {"id": 6000087016, "chapter_id": 10087, "verse_number": "४-२३-१५", "content_sanskrit": "उत्सर्पयन्नसून् मूर्ध्नि क्रमेणावेश्य निस्स्पृहः।\nवायुं वायौ क्षितौ कायं तेजस्तेजस्ययूयुजत्॥ ४/२३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.016.m4a", "display_order": 17}, {"id": 6000087017, "chapter_id": 10087, "verse_number": "४-२३-१६", "content_sanskrit": "खान्याकाशे द्रवं तोये यथास्थानं विभागशः।\nक्षितिमम्भसि तत् तेजस्यदो वायौ नभस्यमुम्॥ ४/२३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.017.m4a", "display_order": 18}, {"id": 6000087018, "chapter_id": 10087, "verse_number": "४-२३-१७", "content_sanskrit": "इन्द्रियाणि समस्तानि तन्मात्राणि यथोद्भवम्।\nभूतादिस्तान् समुत्क्षिप्य महत्यात्मनि सन्दधे॥ ४/२३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.018.m4a", "display_order": 19}, {"id": 6000087019, "chapter_id": 10087, "verse_number": "४-२३-१८", "content_sanskrit": "तं सर्वगुणविन्यासं जीवे मायामये न्यधात्। तं चानुशयमात्मस्थमसावनुशयी पुमान्।\nज्ञानवैराग्यवीर्येण स्वरूपस्थो व्यधात् प्रभुः॥ ४/२३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.019.m4a", "display_order": 20}, {"id": 6000087020, "chapter_id": 10087, "verse_number": "४-२३-१९", "content_sanskrit": "अर्चिर्नाम महाराज्ञी तत्पत्न्यनुगता वनम्।\nसुकुमार्यतदर्हा च यत् पद्भ्यां स्पर्शनं भुवः॥ ४/२३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.020.m4a", "display_order": 21, "topics": [{"text": "मृतस्य भर्तुः अग्निप्रदानपूर्वकं पत्न्याः सहगमनम्", "range": "१९–२६"}]}, {"id": 6000087021, "chapter_id": 10087, "verse_number": "४-२३-२०", "content_sanskrit": "अतीव भर्तुर्व्रतधर्मनिष्ठया शुश्रूषया चार्षदेहयात्रया।\nनाविन्दतार्तिं व्रतकर्शिताऽपि सा प्रेयस्करस्पर्शनमाननिर्वृता॥ ४/२३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.021.m4a", "display_order": 22}, {"id": 6000087022, "chapter_id": 10087, "verse_number": "४-२३-२१", "content_sanskrit": "देहं विपन्नाखिलचेतनादिकं पत्युः पृथिव्या दयितस्य चात्मनः।\nआलक्ष्य किञ्चिच्च विलप्य सा सती चितामथारोपयदद्रिसानुनि॥ ४/२३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.022.m4a", "display_order": 23}, {"id": 6000087023, "chapter_id": 10087, "verse_number": "४-२३-२२", "content_sanskrit": "विधाय कृत्यं ह्रदिनीजलाप्लुता दत्त्वोदकं भर्तुरुदारकर्मणः।\nनत्वा दिविस्थांस्‍त्रिदशांस्‍त्रिः परीत्य विवेश वह्निं ध्यायती भर्तृपादम्॥ ४/२३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.023.m4a", "display_order": 24}, {"id": 6000087024, "chapter_id": 10087, "verse_number": "४-२३-२३", "content_sanskrit": "विलोक्यानुगतां साध्वीं पृथुं वीरवरं पतिम्।\nतुष्टुवुर्वरदा देवैर्देवपत्न्यः सहस्रशः॥ ४/२३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.024.m4a", "display_order": 25}, {"id": 6000087025, "chapter_id": 10087, "verse_number": "४-२३-२४", "content_sanskrit": "कुर्वन्त्यः कुसुमासारं तस्मिन् मन्दरसानुनि।\nनदत्स्वमरतूर्येषु गृणन्ति स्म परस्परम्॥ ४/२३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.025.m4a", "display_order": 26}, {"id": 6000087026, "chapter_id": 10087, "verse_number": null, "content_sanskrit": "देव्य ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.026.m4a", "display_order": 27}, {"id": 6000087027, "chapter_id": 10087, "verse_number": "४-२३-२५", "content_sanskrit": "अहो इयं वधूर्धन्या या चैवं भूभुजां पतिम्।\nसर्वात्मना पतिं भेजे यज्ञेशं श्रीवधूरिव॥ ४/२३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.027.m4a", "display_order": 28}, {"id": 6000087028, "chapter_id": 10087, "verse_number": "४-२३-२६", "content_sanskrit": "सैषा नूनं व्रजत्यूर्ध्वमनु वैन्यं पतिं सती।\nपश्यतोऽस्मानतीत्यार्चिर्दुर्विभाव्येन कर्मणा॥ ४/२३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.028.m4a", "display_order": 29}, {"id": 6000087029, "chapter_id": 10087, "verse_number": "४-२३-२७", "content_sanskrit": "तेषां दुरापं किन्त्वन्यन्मर्त्यानां भगवत्पदम्।\nविद्युल्लोलायुषो ये वै नैष्कर्म्यं साधयन्त्युत॥ ४/२३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.029.m4a", "display_order": 30, "topics": [{"text": "तयोविमानमधिरुह्य वैकुण्ठगमनम्", "range": "२७–२९"}]}, {"id": 6000087030, "chapter_id": 10087, "verse_number": "४-२३-२८", "content_sanskrit": "स वञ्चितो बतात्मध्रुक् कृच्छ्रेण महता भुवि।\nलब्ध्वाऽऽपवर्ग्यं मानुष्यं विषयेषु विषज्जते॥ ४/२३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.030.m4a", "display_order": 31}, {"id": 6000087031, "chapter_id": 10087, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.031.m4a", "display_order": 32}, {"id": 6000087032, "chapter_id": 10087, "verse_number": "४-२३-२९", "content_sanskrit": "स्तुवन्तीष्वमरस्‍त्रीषु पतिलोकं गता वधूः।\nयं वा आत्मविदां धुर्यो वैन्यः प्रापाच्युताशयः॥ ४/२३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.032.m4a", "display_order": 33}, {"id": 6000087033, "chapter_id": 10087, "verse_number": "४-२३-३०", "content_sanskrit": "इत्थंभूतानुभावोऽसौ पृथुः स भगवत्तमः।\nकीर्तितं तस्य चरितमुद्दामचरितस्य ते॥ ४/२३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.033.m4a", "display_order": 34, "topics": [{"text": "पृथुकथाश्रवणफलम्", "range": "३०–३९"}]}, {"id": 6000087034, "chapter_id": 10087, "verse_number": "४-२३-३१", "content_sanskrit": "य इदं सुमहत्पुण्यं श्रद्धयाऽवहितः पठेत्।\nश्रावयेत् शृणुयाद् वाऽपि स पृथोः पदवीमियात्॥ ४/२३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.034.m4a", "display_order": 35}, {"id": 6000087035, "chapter_id": 10087, "verse_number": "४-२३-३२", "content_sanskrit": "ब्राह्मणो ब्रह्मवर्चस्वी राजन्यो जगतीपतिः।\nवैश्यः पठन् विश्पतिः स्याच्छूद्र उत्तमतामियात्॥ ४/२३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.035.m4a", "display_order": 36}, {"id": 6000087036, "chapter_id": 10087, "verse_number": "४-२३-३३", "content_sanskrit": "त्रिः कृत्व इदमाकर्ण्य नरो नार्यथवाऽऽदृतः।\nअप्रजः सुप्रजतमो निर्धनो धनवत्तमः॥ ४/२३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.036.m4a", "display_order": 37}, {"id": 6000087037, "chapter_id": 10087, "verse_number": "४-२३-३४", "content_sanskrit": "इदं स्वस्त्ययनं पुंसाममङ्गल्यनिवारणम्।\nधन्यं यशस्यमायुष्यं स्वर्ग्यं कलिमलापहम्॥ ४/२३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.037.m4a", "display_order": 38}, {"id": 6000087038, "chapter_id": 10087, "verse_number": "४-२३-३५", "content_sanskrit": "धर्मार्थकाममोक्षाणां सम्यक् सिद्धिमभीप्सुभिः।\nश्रद्धयैतदनुश्राव्यं चतुर्णां कारणं परम्॥ ४/२३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.038.m4a", "display_order": 39}, {"id": 6000087039, "chapter_id": 10087, "verse_number": "४-२३-३६", "content_sanskrit": "सङ्ग्रामाभिमुखो राजा श्रुत्वैतदनुयाति यान्।\nबलिं तस्मै हरन्त्यग्रे राजानः पृथवे यथा॥ ४/२३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.039.m4a", "display_order": 40}, {"id": 6000087040, "chapter_id": 10087, "verse_number": "४-२३-३७", "content_sanskrit": "मुक्तान्यसङ्गो भगवत्यचलां भक्तिमुद्वहन्।\nवैन्यस्य चरितं पुण्यं शृणुयाच्छ्रावयेत् पठेत्॥ ४/२३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.040.m4a", "display_order": 41}, {"id": 6000087041, "chapter_id": 10087, "verse_number": "४-२३-३८", "content_sanskrit": "वैचित्रवीर्याभिहितं महन्माहात्म्यसूचकम्।\nअस्मिन् कृतमतिर्मर्त्यः पार्थवीं गतिमाप्नुयात्॥ ४/२३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.041.m4a", "display_order": 42}, {"id": 6000087042, "chapter_id": 10087, "verse_number": "४-२३-३९", "content_sanskrit": "अनुदिनमिदमादरेण शृृण्वन् पृथुचरितं प्रथयन् विमुक्तसङ्गः।\nभगवति भवसिन्धुपारभूते स च निपुणां लभते रतिं मनुष्यः॥ ४/२३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_023/BhP_04.023.042.m4a", "display_order": 43}, {"id": 6000087043, "chapter_id": 10087, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे त्रयोविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]