[{"id": 2057819, "chapter_id": 2250, "verse_number": "७-१७७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057820, "chapter_id": 2250, "verse_number": "७-१७७-१", "content_sanskrit": "तस्मिंस्तथा वर्तमाने कर्णराक्षसयोर्मृधे।\nअलायुधो राक्षसेन्द्रो वीर्यवानभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057821, "chapter_id": 2250, "verse_number": "७-१७७-२", "content_sanskrit": "महत्या सेनया युक्तो दुर्योधनमुपागमत्।\nराक्षसानां विरूपाणां सहस्रैः परिवारितः।\nनानारूपधरैर्वीरैः पूर्ववैरमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057822, "chapter_id": 2250, "verse_number": "७-१७७-३", "content_sanskrit": "तस्य ज्ञातिर्हि विक्रान्तो ब्राह्मणादो बको हतः।\nकिर्णीरश्च महातेजा हिडिम्बश्च सखा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057823, "chapter_id": 2250, "verse_number": "७-१७७-४", "content_sanskrit": "स दीर्घकालाध्युपितं पूर्ववैरमनुस्मरन्।\nविज्ञायैतन्निशायुद्धं जिघांसुर्भीममाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057824, "chapter_id": 2250, "verse_number": "७-१७७-५", "content_sanskrit": "स मत्त इव मातङ्गः सङ्क्रुद्व इव चोरगः।\nदुर्योधनमिदं वाक्यमब्रवीद्युद्वलालसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057825, "chapter_id": 2250, "verse_number": "७-१७७-६", "content_sanskrit": "विदितं ते महाराज यथा भीमेन राक्षसाः।\nहिडिम्बबककिर्मीरा निहता मम बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057826, "chapter_id": 2250, "verse_number": "७-१७७-७", "content_sanskrit": "परामर्शश्च कन्याया हिडिम्बायाः कृतः पुरा।\nकिमन्यद्राक्षसानन्यानस्मांश्च परिभूय ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057827, "chapter_id": 2250, "verse_number": "७-१७७-८", "content_sanskrit": "तमहं सगणं राजन्सवाजिरथकुञ्जरम्।\nहैडिम्बिं च सहामात्यं हन्तुमभ्यागतः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057828, "chapter_id": 2250, "verse_number": "७-१७७-९", "content_sanskrit": "अद्य कुन्तीसुतान्सर्वान्वासुदेवपुरोगमान्।\nहत्वा सम्भक्षयिष्यामि सर्वैरनुचरैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057829, "chapter_id": 2250, "verse_number": "७-१७७-१०", "content_sanskrit": "निवारय बलं सर्वं वयं योत्स्याम पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057830, "chapter_id": 2250, "verse_number": "७-१७७-११", "content_sanskrit": "तस्यैतद्वचनं श्रुत्वा हृष्टो दुर्योधनस्तदा।\nप्रतिपूज्याब्रवीद्वाक्यं भ्रातृभिः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057831, "chapter_id": 2250, "verse_number": "७-१७७-१२", "content_sanskrit": "त्वां पुरस्कृत्य सगणं वयं योत्स्यामहे परान्।\nन हि वैरान्तमनसः स्थास्यन्ति मम सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057832, "chapter_id": 2250, "verse_number": "७-१७७-१३", "content_sanskrit": "एवमस्त्विति राजानमुक्त्वा राक्षसपुङ्गवः।\nअभ्ययात्त्वरितो भैमिं सहितः पुरुषादकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057833, "chapter_id": 2250, "verse_number": "७-१७७-१४", "content_sanskrit": "दीप्यमानेन वपुषा रथेनादित्यवर्चसा।\nतादृशेनैव राजेन्द्र यादृशेन घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057834, "chapter_id": 2250, "verse_number": "७-१७७-१५", "content_sanskrit": "तस्याप्यतुलनिर्घोपो बहुतोरणचित्रितः।\nऋक्षचर्मावनद्वाङ्गो नल्वमात्रो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057835, "chapter_id": 2250, "verse_number": "७-१७७-१६", "content_sanskrit": "तस्यापि तुरगाः शीघ्रा हस्तिकायाः खरस्वनाः।\nशतं युक्ता महाकाया मांसशोणितभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057836, "chapter_id": 2250, "verse_number": "७-१७७-१७", "content_sanskrit": "तस्यापि रथनिर्घोपो महामेघरवोपमः।\nस्यापि सुमहच्चापं दृढज्यं कनकोज्ज्वलम्॥\nतस्याप्यक्षसमा बाणा रुक्म पुङ्खाः शिलाशिताः।\nसोऽपि वीरो महाबाहुर्यथैव स घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057837, "chapter_id": 2250, "verse_number": "७-१७७-१९", "content_sanskrit": "तस्यापि गोमायुबलाभिगुप्तो\nबभूव केतुर्ज्वलनार्कतुल्यः।\nस चापि रूपेण घटोत्कचस्य\nश्रीमत्तमो ह्यन्तकसन्निकाशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057838, "chapter_id": 2250, "verse_number": "७-१७७-२०", "content_sanskrit": "दीप्ताङ्गदो दीप्तकिरीटमाली\nबद्धस्रगुष्णीषनिबद्धखङ्गः।\nगदी भुशुण्डी मुसली हली च\nशरासनी वारणतुल्यवर्ष्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057839, "chapter_id": 2250, "verse_number": "७-१७७-२१", "content_sanskrit": "रथेन तेनानलवर्चसा तदा\nविद्रावयन्पाण्डववाहिनीं ताम्।\nरराज सह्ख्ये परिवर्तमानो\nविद्युन्माली मेघ इवान्तरिक्षे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057840, "chapter_id": 2250, "verse_number": "७-१७७-२२", "content_sanskrit": "ते चापि सर्वप्रवरा नरेन्द्रा\nमहाबला वर्मिमश्चर्मिणश्च।\nहर्षान्विता युयुधुस्तस्य राजन्\nसमन्ततः पाण्डवयोधवीराः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057841, "chapter_id": 2250, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे सप्तसप्तत्यधिकशततमोऽध्यायः॥ १७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]