[{"id": 2149204, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149205, "chapter_id": 4229, "verse_number": "१", "content_sanskrit": "उलूकस्त्वर्जुनं भूयो यथोक्तं वाक्यमब्रवीत् ।\nआशीविषमिव क्रुद्धं तुदन् वाक्यशलाकया\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149206, "chapter_id": 4229, "verse_number": "२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा रुषिताः पाण्डवा भृशम् ।\nप्रागेव भृशसङ्क्रुद्धाः कैतव्येनापि धर्षिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149207, "chapter_id": 4229, "verse_number": "३", "content_sanskrit": "आसनेषूदतिष्ठन्त बाहूंश्चैव प्रचिक्षिपुः ।\nआशीविषा इव क्रुद्धा वीक्षाञ्चक्रुः परस्परम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149208, "chapter_id": 4229, "verse_number": "४", "content_sanskrit": "अवाक्छिरा भीमसेनः समुदैक्षत कैतवम् ।\nनेत्राभ्यां लोहितान्ताभ्यामाशीविष इव श्वसन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149209, "chapter_id": 4229, "verse_number": "५", "content_sanskrit": "दन्तान् दन्तेषु निष्पिष्य सृक्विणीः परिलेलिहन् ।\nतेषामाकारभावज्ञः कुन्तीपुत्रो वृकोदरः ।\nउदतिष्ठत् सवेगेन क्रोधेन प्रज्वलन्निव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149210, "chapter_id": 4229, "verse_number": "६", "content_sanskrit": "उद्धृत्य सहसा नेत्रे दन्तान् कटकटाप्य च ।\nहस्तान् हस्तेषु निष्पिष्य उलूकं वाक्यमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149211, "chapter_id": 4229, "verse_number": "७", "content_sanskrit": "अशक्तानामिवास्माकं प्रोत्साहननिमित्तजम् ।\nश्रुतं ते वचनं मूर्ख यत् त्वां दुर्योधनोऽब्रवीत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149212, "chapter_id": 4229, "verse_number": "८", "content_sanskrit": "तन्मे कथयतो मन्द शृणु वाक्यं दुरासदम् ।\nसर्वक्षत्रस्य मध्ये त्वं यद् वक्ष्यसि सुयोधनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149213, "chapter_id": 4229, "verse_number": "९", "content_sanskrit": "शृण्वतः सूतपुत्रस्य शकुनेस्त्वं दुरात्मनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149214, "chapter_id": 4229, "verse_number": "१०", "content_sanskrit": "अस्माभिः प्रीतिकामैस्तु भ्रातुर्ज्येष्ठस्य शासनात् ।\nमर्षितं ते दुराचार स त्वं न बहुमन्यसे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149215, "chapter_id": 4229, "verse_number": "११", "content_sanskrit": "प्रेषितश्च हृषीकेशः शमाकाङ्क्षी कुरून् प्रति ।\nकुलस्य हितकामेन धर्मराजेन धीमता\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149216, "chapter_id": 4229, "verse_number": "१२", "content_sanskrit": "त्वं कालचोदितो नूनं गन्तुकामो यमक्षयम् ।\nगच्छस्वाहवमस्माभिस्तच्च श्वो भविता ध्रुवम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149217, "chapter_id": 4229, "verse_number": "१३", "content_sanskrit": "मयाऽपि च प्रतिज्ञातो वधः सभ्रातृकस्य ते ।\nस तथा भविता पाप नात्र कार्या विचारणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149218, "chapter_id": 4229, "verse_number": "१४", "content_sanskrit": "वेलामतिक्रमेत् सद्यः सागरो वरुणालयः ।\nपर्वताश्च विशीर्येयुर्मयोक्तं न मृषा भवेत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149219, "chapter_id": 4229, "verse_number": "१५", "content_sanskrit": "सहायस्ते यदि यमः कुबेरो रुद्र एव वा ।\nयथाप्रतिज्ञं दुर्बुद्धे प्रकरिष्यन्ति पाण्डवाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149220, "chapter_id": 4229, "verse_number": "१६", "content_sanskrit": "दुःशासनस्य रुधिरं पाता चास्मि यथेप्सितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149221, "chapter_id": 4229, "verse_number": "१७", "content_sanskrit": "यश्चेह प्रतिसंरोद्धुं क्षत्रियो माऽभियास्यति ।\nअपि भीष्मं पुरस्कृत्य तं नेष्यामि यमक्षयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149222, "chapter_id": 4229, "verse_number": "१८", "content_sanskrit": "यच्चैतदुक्तं वचनं मया क्षत्रस्य संसदि ।\nयथैतद् भविता सत्यं तथैवात्मानमालभे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149223, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149224, "chapter_id": 4229, "verse_number": "१९", "content_sanskrit": "भीमसेनवचः श्रुत्वा सहदेवोऽत्यमर्षणः ।\nक्रोधसंरक्तनयनस्ततो वाक्यमुवाच ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149225, "chapter_id": 4229, "verse_number": "२०", "content_sanskrit": "शृणु पाप वचो मह्यं यद्वाच्यो हि पिता त्वया ।\nनास्माकं भविता भेदः कदाचित् कुरुभिः सह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149226, "chapter_id": 4229, "verse_number": "२१", "content_sanskrit": "धृतराष्ट्रस्य सम्बन्धो यदि न स्यात् त्वया सह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149227, "chapter_id": 4229, "verse_number": "२२", "content_sanskrit": "त्वं तु लोकविनाशाय धृतराष्ट्रकुलस्य च ।\nउत्पन्नो वैरपुरुषः स्वकुलघ्नश्च पापकृत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149228, "chapter_id": 4229, "verse_number": "२३", "content_sanskrit": "जन्मप्रभृति चास्माकं पिता ते पापपूरुषः ।\nअहितानि नृशंसानि नित्यशः कर्तुमिच्छति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149229, "chapter_id": 4229, "verse_number": "२४", "content_sanskrit": "तस्य वैरानुषङ्गस्य गन्तास्म्यन्तं सुदुर्गमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149230, "chapter_id": 4229, "verse_number": "२५", "content_sanskrit": "अहमादौ निहत्य त्वां शकुनेः सम्प्रपश्यतः ।\nततोऽस्मि शकुनिं हन्ता मिषतां सर्वधन्विनाम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149231, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149232, "chapter_id": 4229, "verse_number": "२६", "content_sanskrit": "भीमस्य वचनं श्रुत्वा सहदेवस्य चोभयोः ।\nउवाच फल्गुनो वाक्यं भीमसेनं स्मयन्निव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149233, "chapter_id": 4229, "verse_number": "२७", "content_sanskrit": "भीमसेन न ते सन्ति येषां वैरं त्वया सह ।\nमन्दा गृहेषु सुखिनो मृत्युपाशवशं गताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149234, "chapter_id": 4229, "verse_number": "२८", "content_sanskrit": "उलूकश्च न ते वाच्यः परुषं पुरुषोत्तम ।\nदूताः किमपराध्यन्ते यथोक्तस्यानुभाषिणः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149235, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149236, "chapter_id": 4229, "verse_number": "२९", "content_sanskrit": "आर्तं वातात्मजं दृष्ट्वा क्रोधेनाभिहतं भृशम् ।\nउत्स्मयन्निव दाशार्हः कैतवं प्रत्यभाषत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149237, "chapter_id": 4229, "verse_number": "३०", "content_sanskrit": "प्रयाहि शीघ्रं कैतव्य ब्रूयाश्चैव सुयोधनम् ।\nश्रुतं वाक्यं गृहीतोऽर्थो मतं यत् ते तथाऽस्तु तत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149238, "chapter_id": 4229, "verse_number": "३१", "content_sanskrit": "मद्वचश्चापि भूयस्ते वक्तव्यः स सुयोधनः ।\nश्व इदानीं प्रपश्येथाः पुरुषो भव दुर्मते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149239, "chapter_id": 4229, "verse_number": "३२", "content_sanskrit": "मन्यसे यच्च मूढ त्वं न योत्स्यति जनार्दनः ।\nसारथ्येन वृतः पार्थैरिति त्वं न बिभेषि च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149240, "chapter_id": 4229, "verse_number": "३३", "content_sanskrit": "जघन्यकालमप्येतन्न भवेत् सर्वपार्थिवान् ।\nनिर्दहेयमहं क्रोधात् तृणानीव हुताशनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149241, "chapter_id": 4229, "verse_number": "३४", "content_sanskrit": "युधिष्ठिरनियोगाच्च फल्गुनस्य महात्मनः ।\nकरिष्ये युद्ध्यमानस्य सारथ्यं विजितात्मनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149242, "chapter_id": 4229, "verse_number": "३५", "content_sanskrit": "यद्युत्पतसि लोकांस्त्रीन् यद्याविशसि भूतळम् ।\nतत्र तत्रार्जुनरथं प्रभाते द्रक्ष्यसेऽग्रतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149243, "chapter_id": 4229, "verse_number": "३६", "content_sanskrit": "यच्चापि भीमसेनस्य मन्यसे मोघगर्जितम् ।\nदुःशासनस्य रुधिरं पीतमित्यवधार्यताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149244, "chapter_id": 4229, "verse_number": "३७", "content_sanskrit": "न त्वां समीक्षते पार्थो नापि राजा युधिष्ठिरः ।\nन भीमसेनो न यमौ प्रतिकूलप्रभाषिणम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149245, "chapter_id": 4229, "verse_number": "३८", "content_sanskrit": "एवमुक्त्वा महाबाहुः केशवो राजसत्तम ।\nपुनरेव महाप्राज्ञं युधिष्ठिरमुदैक्षत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149246, "chapter_id": 4229, "verse_number": "३९", "content_sanskrit": "सृञ्जयानां च सर्वेषां कृष्णस्य च यशस्विनः ।\nद्रुपदस्य सपुत्रस्य विराटस्य च सन्निधौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149247, "chapter_id": 4229, "verse_number": "४०", "content_sanskrit": "भूमिपानां च सर्वेषां मध्ये वाक्यं जगाद ह\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149248, "chapter_id": 4229, "verse_number": "४१", "content_sanskrit": "उलूकोऽप्यर्जुनं भूयो यथोक्तं वाक्यमब्रवीत् ।\nआशीविषमिव क्रुद्धं तुदन् वाक्यशलाकया\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149249, "chapter_id": 4229, "verse_number": "४२", "content_sanskrit": "कृष्णादींश्चैव तान् सर्वान् यथोक्तं वाक्यमब्रवीत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149250, "chapter_id": 4229, "verse_number": "४३", "content_sanskrit": "उलूकस्य तु तद्वाक्यं पापं दारुणमीरितम् ।\nश्रुत्वा विचुक्षुभे पार्थो ललाटं चाप्यमार्जयत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2149251, "chapter_id": 4229, "verse_number": "४४", "content_sanskrit": "तदवस्थं तदा दृष्ट्वा पार्थं सा समितिर्नृप ।\nनामृष्यन्त महाराज पाण्डवानां महारथाः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2149252, "chapter_id": 4229, "verse_number": "४५", "content_sanskrit": "अधिक्षेपेण कृष्णस्य पार्थस्य च महात्मनः ।\nश्रुत्वा ते पुरुषव्याघ्राः क्रोधाज्जज्वलुरच्युताः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2149253, "chapter_id": 4229, "verse_number": "४६", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च सात्यकिश्च महारथः ।\nकेकया भ्रातरः पञ्च राक्षसश्च घटोत्कचः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2149254, "chapter_id": 4229, "verse_number": "४७", "content_sanskrit": "द्रौपदेयाभिमन्युश्च धृष्टकेतुश्च पार्थिवः ।\nभीमसेनश्च विक्रान्तो यमजौ च महारथौ\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2149255, "chapter_id": 4229, "verse_number": "४८", "content_sanskrit": "उत्पेतुर्धार्तराष्ट्रस्य श्रुत्वा पापस्य भाषितम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2149256, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2149257, "chapter_id": 4229, "verse_number": "४९", "content_sanskrit": "कुत्सनां वासुदेवस्य मम चैव विशेषतः ।\nश्रुत्वा भवन्तः संरब्धा अस्माकं हितकाम्यया\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2149258, "chapter_id": 4229, "verse_number": "५०", "content_sanskrit": "प्रभावाद् वासुदेवस्य भवतां च प्रयत्नतः ।\nसमस्तं पार्थिवं क्षत्रं सर्वं न गणयाम्यहम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2149259, "chapter_id": 4229, "verse_number": "५१", "content_sanskrit": "भवद्भिः समनुज्ञातो वाक्यमस्य यदुत्तरम् ।\nउलूके प्रापयिष्यामि यद् वक्ष्यामि सुयोधनम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2149260, "chapter_id": 4229, "verse_number": "५२", "content_sanskrit": "श्वो भूते कथितस्यास्य प्रतिवाक्यं चमूमुखे ।\nगाण्डीवेनाभिधास्यामि क्लीबा हि वचनोत्तराः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2149261, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2149262, "chapter_id": 4229, "verse_number": "५३", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे प्रशशंसुर्धनञ्जयम् ।\nतेन वाक्योपचारेण विस्मिता राजसत्तमाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2149263, "chapter_id": 4229, "verse_number": "५४", "content_sanskrit": "अनुनीय च तान् सर्वान् यथायोग्यं यथावयः ।\nधर्मराजं तदा वाक्यं तत्प्राप्तं प्रत्यभाषत\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2149264, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2149265, "chapter_id": 4229, "verse_number": "५५", "content_sanskrit": "आत्मानमवमन्वानो नहि स्यात् पार्थिवोत्तमः ।\nतत्रोत्तरं प्रवक्ष्यामि तव शुश्रूषणे रतः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2149266, "chapter_id": 4229, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2149267, "chapter_id": 4229, "verse_number": "५६", "content_sanskrit": "दुर्योधनस्य तद्वाक्यं निशम्य भरतर्षभः ।\nअतिलोहितनेत्राभ्याम् आशीविष इव श्वसन्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2149268, "chapter_id": 4229, "verse_number": "५७", "content_sanskrit": "स्मयमान इव क्रोधात् सृक्विणी परिलेलिहन् ।\nजनार्दनमभिप्रेक्ष्य गुडाकेशो महायशाः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2149269, "chapter_id": 4229, "verse_number": "५८", "content_sanskrit": "अभ्यभाषत कैतव्यं प्रगृह्य विपुलौ भुजौ ।\nउलूकं भरतश्रेष्ठ सामपूर्वमथोर्जितम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2149270, "chapter_id": 4229, "verse_number": "५९", "content_sanskrit": "उलूक गच्छ कैतव्य ब्रूहि तात सुयोधनम् ।\nकृतघ्नं वैरपुरुषं दुर्मतिं कुलपांसनम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2149271, "chapter_id": 4229, "verse_number": "६०", "content_sanskrit": "पाण्डवेषु यथा पाप नित्यं जिह्मं प्रवर्तसे\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2149272, "chapter_id": 4229, "verse_number": "६१", "content_sanskrit": "स्ववीर्यं सम्यगाश्रित्य यः समाह्वयते परान् ।\nअभीतः पूरयन् वाक्यम् एष वै क्षत्रियः पुमान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2149273, "chapter_id": 4229, "verse_number": "६२", "content_sanskrit": "परवीर्यं समाश्रित्य यः समाह्वयते परान् ।\nक्षत्रबन्धुरशक्तत्वात् लोके स पुरुषाधमः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2149274, "chapter_id": 4229, "verse_number": "६३", "content_sanskrit": "स पापः क्षत्रियो भूत्वा अस्मानाहूय संयुगे ।\nमान्यामान्यान् पुरस्कृत्य युद्धं माऽगाः कुलाधम\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2149275, "chapter_id": 4229, "verse_number": "६४", "content_sanskrit": "आत्मवीर्यं समाश्रित्य भृत्यवीर्यं च कौरव ।\nआह्वयस्व रणे पार्थान् सर्वथा क्षत्रियो भव\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2149276, "chapter_id": 4229, "verse_number": "६५", "content_sanskrit": "परवीर्यं समाश्रित्य यः समाह्वयते परान् ।\nअशक्तः स्वयमादातुमेतदेव नपुंसकम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2149277, "chapter_id": 4229, "verse_number": "६६", "content_sanskrit": "यस्त्वं परेषां वीर्येण आत्मानं बहुमन्यसे ।\nकथमेवमशक्तस्त्वमस्मान् समभिगर्जसि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2149278, "chapter_id": 4229, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षष्टोत्तरशततमोऽध्यायः ॥१६०॥\nउलूकदूतागमनपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]