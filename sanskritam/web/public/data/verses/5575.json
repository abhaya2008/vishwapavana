[{"id": 2214030, "chapter_id": 5575, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214031, "chapter_id": 5575, "verse_number": "१", "content_sanskrit": "एवमुक्तः स बीभत्सुर्मातुलेन परन्तप ।\nदुर्मना दीनवदनो वसुदेवमुवाच ह\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214032, "chapter_id": 5575, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214033, "chapter_id": 5575, "verse_number": "२", "content_sanskrit": "नाहं वृष्णिप्रवीरेण बन्धुभिश्चैव मातुल ।\nविहीनां पृथिवीं द्रष्टुं शक्तश्चिरमिह प्रभो\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214034, "chapter_id": 5575, "verse_number": "३", "content_sanskrit": "राजा च भीमसेनश्च सहदेवश्च पाण्डवः ।\nनकुलो याज्ञसेनी च षडेकमनसो वयम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214035, "chapter_id": 5575, "verse_number": "४", "content_sanskrit": "राज्ञः सङ्क्रमणे चापि कालोऽयं नित्यमेव हि ।\nतमिमं विद्धि सम्प्राप्तं कालं कालविदांवर\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214036, "chapter_id": 5575, "verse_number": "५", "content_sanskrit": "सर्वथा वृष्णिदारांस्तु बालं वृद्धं तथैव च ।\nनयिष्ये परिगृह्याहमिन्द्रप्रस्थमरिन्दम\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214037, "chapter_id": 5575, "verse_number": "६", "content_sanskrit": "इत्युक्त्वा दारुकमिदं वाक्यमाह धनञ्जयः ।\nअमात्यान् वृष्णिवीराणां द्रष्टुमिच्छामि माचिरम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214038, "chapter_id": 5575, "verse_number": "७", "content_sanskrit": "इत्येवमुक्त्वा वचनं सुधर्मां यादवीं सभाम् ।\nप्रविवेशार्जुनः शूरः शोचमानो महाभुजः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214039, "chapter_id": 5575, "verse_number": "८", "content_sanskrit": "तमासनगतं तत्र सर्वाः प्रकृतयस्तथा ।\nब्राह्मणा नागरास्तत्र परिवार्योपतस्थिरे\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214040, "chapter_id": 5575, "verse_number": "९", "content_sanskrit": "तान् दीनमनसः सर्वान् विमूढान् गतचेतसः ।\nउवाचेदं वचः काले पार्थो दीनतरस्तथा\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214041, "chapter_id": 5575, "verse_number": "१०", "content_sanskrit": "शक्रप्रस्थमहं नेष्ये वृष्ण्यन्धकजनं स्वयम् ।\nइदं तु नगरं सर्वं समुद्रः प्लावयिष्यति\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214042, "chapter_id": 5575, "verse_number": "११", "content_sanskrit": "सज्जीकुरुत यानानि रत्नानि विविधानि च ।\nवज्रोऽयं भवतां राजा शक्रप्रस्थे भविष्यति\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214043, "chapter_id": 5575, "verse_number": "१२", "content_sanskrit": "सप्तमे दिवसे चैव रवौ विमल उद्गते ।\nबहिर्वत्स्यामहे सर्वे सज्जीभवत माचिरम्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214044, "chapter_id": 5575, "verse_number": "१३", "content_sanskrit": "इत्युक्तास्तेन ते सर्वे पार्थेनाक्लिष्टकर्मणा ।\nसज्जमाशु ततश्चक्रुः स्वसिद्ध्यर्थं समुत्सुकाः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214045, "chapter_id": 5575, "verse_number": "१४", "content_sanskrit": "तां रात्रिमवसत्पार्थः केशवस्य निवेशने ।\nमहता शोकमोहेन सहसाऽभिपरिप्लुतः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214046, "chapter_id": 5575, "verse_number": "१५", "content_sanskrit": "श्वोभूतेऽथ ततः शौरिर्वसुदेवः प्रतापवान् ।\nयुक्त्वाऽऽत्मानं महातेजा जगाम गतिमुत्तमाम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214047, "chapter_id": 5575, "verse_number": "१६", "content_sanskrit": "ततः शब्दो महानासीद् वसुदेवनिवेशने ।\nदारुणः क्रोशतीनां च रुदतीनां च योषिताम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214048, "chapter_id": 5575, "verse_number": "१७", "content_sanskrit": "प्रकीर्णमूर्धजाः सर्वा विमुक्ताभरणस्रजः ।\nउरांसि पाणिभिर्घ्नन्त्यो व्यलपन् करुणं स्त्रियः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214049, "chapter_id": 5575, "verse_number": "१८", "content_sanskrit": "तं देवकी च भद्रा च रोहिणी मदिरा तथा ।\nअन्वारोढुं व्यवसिता भर्तारं योषितां वराः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214050, "chapter_id": 5575, "verse_number": "१९", "content_sanskrit": "ततः शौरिं नृयुक्तेन बहुमूल्येन भारत ।\nयानेन महता पार्थो बहिर्निष्क्रामयत् तदा\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214051, "chapter_id": 5575, "verse_number": "२०", "content_sanskrit": "तमन्वयुस्तत्रतत्र दुःखशोकसमन्विताः ।\nद्वारकावासिनः सर्वे पौरजानपदा हिताः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214052, "chapter_id": 5575, "verse_number": "२१", "content_sanskrit": "तस्याश्वमेधिकं छत्रं दीप्यमानाश्च पावकाः ।\nपुरस्तात् तस्य यानस्य याजकाश्च ततो ययुः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214053, "chapter_id": 5575, "verse_number": "२२", "content_sanskrit": "अनुजग्मुश्च तं वीरं देव्यस्ता वै स्वलङ्कृताः ।\nस्त्रीसहस्रैः परिवृता वधूभिश्च सहस्रशः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214054, "chapter_id": 5575, "verse_number": "२३", "content_sanskrit": "यस्तु देशः प्रियस्तस्य जीवतोऽभून्महात्मनः ।\nतत्रैनमुपसङ्कल्प्य पितृमेधं प्रचक्रिरे\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214055, "chapter_id": 5575, "verse_number": "२४", "content_sanskrit": "तं चिताग्निगतं वीरं शूरपुत्रं वराङ्गनाः ।\nततोन्वारुरुहुः पत्न्यश्चतस्रः पतिलोकगाः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214056, "chapter_id": 5575, "verse_number": "२५", "content_sanskrit": "तं वै चतसृभिः स्त्रीभिरन्वितं पाण्डुनन्दनः ।\nअदाहयच्चन्दनैश्च गन्धैरुच्चावचैरपि\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214057, "chapter_id": 5575, "verse_number": "२६", "content_sanskrit": "ततः प्रादुरभूच्छब्दः समिद्धस्य विभावसोः ।\nसामगानां च निर्घोषो नराणां रुदतां तथा\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214058, "chapter_id": 5575, "verse_number": "२७", "content_sanskrit": "ततो वज्रप्रधानास्ते वृष्ण्यन्धककुमारकाः ।\nसर्वे चैवोदकं चक्रुः स्त्रियश्चैव महात्मनः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214059, "chapter_id": 5575, "verse_number": "२८", "content_sanskrit": "अलुप्तधर्मस्तं धर्मं कारयित्वा स फल्गुनः ।\nजगाम वृष्णयो यत्र विनष्टा भरतर्षभ\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214060, "chapter_id": 5575, "verse_number": "२९", "content_sanskrit": "स तान् दृष्ट्वा निपतितान् कदने भृशदुःखितः ।\nबभूवातीव कौरव्यः प्राप्तकालं चकार ह\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214061, "chapter_id": 5575, "verse_number": "३०", "content_sanskrit": "यथाप्रधानतश्चैव चक्रे सर्वास्तथा क्रियाः ।\nये हता ब्रह्मशापेन मुसलैरेरकोद्भवैः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214062, "chapter_id": 5575, "verse_number": "३१", "content_sanskrit": "ततः शरीरं रामस्य वासुदेवस्य चोभयोः ।\nअन्वीक्ष्य दाहयामास पुरुषैराप्तकारिभिः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2214063, "chapter_id": 5575, "verse_number": "", "content_sanskrit": "(ततो भगवतो देहं दृष्ट्वा शिष्यः प्रलप्य च ।\nस्मृत्वा तद्वचनं सर्वं मोहशोकोपबृंहितः\t ॥३२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2214064, "chapter_id": 5575, "verse_number": "३३", "content_sanskrit": "स तेषां विधिवत्कृत्वा प्रेतकार्याणि पाण्डवः ।\nसप्तमे दिवसे प्रायाद् रथमारुह्य सत्वरः \t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2214065, "chapter_id": 5575, "verse_number": "३४", "content_sanskrit": "अश्वयुक्तै रथैश्चापि गोखरोष्ट्रयुतैरपि ।\nस्त्रियस्ता वृष्णिवीराणां रुदन्त्यः शोककर्शिताः\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2214066, "chapter_id": 5575, "verse_number": "३५", "content_sanskrit": "अनुजग्मुर्महात्मानं पाण्डुपुत्रं धनञ्जयम् ।\nभृत्याश्चान्धकवृष्णीनां सादिनो रथिनश्च ये\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2214067, "chapter_id": 5575, "verse_number": "३६", "content_sanskrit": "वीरहीना वृद्धबालाः पौरजानपदास्तथा ।\nययुस्ते परिवार्याथ कलत्रं पार्थशासनात्\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2214068, "chapter_id": 5575, "verse_number": "३७", "content_sanskrit": "कुञ्जरैश्च गजारोहा ययुः शैलनिभैस्तथा ।\nसपादरक्षैः संयुक्ताः सोत्तरायुधिका ययुः\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2214069, "chapter_id": 5575, "verse_number": "३८", "content_sanskrit": "पुत्राश्चान्धकवृष्णीनां सर्वे पार्थमनुव्रताः ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव महाधनाः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2214070, "chapter_id": 5575, "verse_number": "३९", "content_sanskrit": "दश षट् च सहस्राणि वासुदेवावरोधनम् ।\nपुरस्कृत्य ययुर्वज्रं पौत्रं कृष्णस्य धीमतः\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2214071, "chapter_id": 5575, "verse_number": "४०", "content_sanskrit": "बहूनि च सहस्राणि प्रयुतान्यर्बुदानि च ।\nभोजवृष्ण्यन्धकस्त्रीणां हतनाथानि निर्ययुः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2214072, "chapter_id": 5575, "verse_number": "४१", "content_sanskrit": "तत्सागरसमप्रख्यं वृष्णिचक्रं महर्द्धिमत् ।\nउवाह रथिनांश्रेष्ठः पार्थः परपुरञ्जयः\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2214073, "chapter_id": 5575, "verse_number": "४२", "content_sanskrit": "निर्याते तु जने तस्मिन् सागरो मकरालयः ।\nद्वारकां रत्नसम्पूर्णां जलेनाप्लावयत् तदा\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2214074, "chapter_id": 5575, "verse_number": "", "content_sanskrit": "पुनर्यत्रावतारोऽस्य भविष्यति कृते युगे ।\nकोशधारो ह्यहन्तस्य नश्येदण्वपि नो धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2214075, "chapter_id": 5575, "verse_number": "४३", "content_sanskrit": "यद्यद्धि पुरुषव्याघ्रो भूमेस्तस्या व्यमुञ्चत ।\nतत्तत्सम्प्लावयामास सलिलेन स सागरः\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2214076, "chapter_id": 5575, "verse_number": "४४", "content_sanskrit": "तदद्भुतमभिप्रेक्ष्य द्वारकावासिनो जनाः ।\nतूर्णात् तूर्णतरं जग्मुरहो दैवमिति ब्रुवन्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2214077, "chapter_id": 5575, "verse_number": "४५", "content_sanskrit": "काननेषु च रम्येषु पर्वतेषु नदीषु च ।\nनिवसन्नानयामास वृष्णिदारान् धनञ्जयः\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2214078, "chapter_id": 5575, "verse_number": "४६", "content_sanskrit": "स पञ्चनदमासाद्य धीमानतिसमृद्धिमत् ।\nदेशे गोपशुधान्याढ्ये निवासमकरोत् प्रभुः\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2214079, "chapter_id": 5575, "verse_number": "४७", "content_sanskrit": "ततो लोभः समभवद् दस्यूनां निहतेश्वराः ।\nदृष्ट्वा स्त्रियो नीयमानाः पार्थेनैकेन भारत\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2214080, "chapter_id": 5575, "verse_number": "४८", "content_sanskrit": "सुरूपा भर्तृरहिताः हेमरत्नादिसंयुताः\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2214081, "chapter_id": 5575, "verse_number": "४९", "content_sanskrit": "ततस्ते पापकर्माणो लोभोपहतचेतसः ।\nआभीरा मन्त्रयामासुः समेत्याशुभदर्शनाः\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2214082, "chapter_id": 5575, "verse_number": "५०", "content_sanskrit": "अयमेकोऽर्जुनो धन्वी वृद्धबालं हतेश्वरम् ।\nनयत्यस्मानतिक्रम्य योधाश्चेमे हतौजसः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2214083, "chapter_id": 5575, "verse_number": "५१", "content_sanskrit": "ततो यष्टिप्रहरणा दस्यवस्ते सहस्रशः ।\nअभ्यधावन्त वृष्णीनां तं जनं लोप्त्रहारिणः\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2214084, "chapter_id": 5575, "verse_number": "५२", "content_sanskrit": "महता सिंहनादेन त्रासयन्तः पृथग्जनम् ।\nअभिपेतुर्धनार्थं ते कालपर्यायचोदिताः\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2214085, "chapter_id": 5575, "verse_number": "५३", "content_sanskrit": "ततो निवृत्तः कौन्तेयः सहसा सपदानुगः ।\nउवाच तान् महाबाहुरर्जुनः प्रहसन्निव\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2214086, "chapter_id": 5575, "verse_number": "५४", "content_sanskrit": "निवर्तध्वमधर्मज्ञा यदि स्थानं मुमूर्षवः ।\nइदानीं शरनिर्भिन्नाः शोचध्वं निहता मया\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2214087, "chapter_id": 5575, "verse_number": "५५", "content_sanskrit": "तथोक्तास्तेन वीरेण कदर्थीकृत्य तद्वचः ।\nअभिपेतुर्जनं मूढा वार्यमाणाः पुनःपुनः\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2214088, "chapter_id": 5575, "verse_number": "५६", "content_sanskrit": "ततोऽर्जुनो धनुर्दिव्यं गाण्डीवमजरं महत् ।\nआरोपयितुमारेभे यत्नादिव कथञ्चन\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2214089, "chapter_id": 5575, "verse_number": "५७", "content_sanskrit": "चकार सज्यं कृच्छ्रेण सम्भ्रमे तुमुले सति ।\nचिन्तयामास शस्त्राणि न च सस्मार तान्यपि\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2214090, "chapter_id": 5575, "verse_number": "५८", "content_sanskrit": "वैकृतं तन्महद् दृष्ट्वा भुजवीर्यं तथा युधि ।\nदिव्यानां च महास्त्राणां विनाशाद् व्रीडितोऽभवत्\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2214091, "chapter_id": 5575, "verse_number": "५९", "content_sanskrit": "वृष्णियोधाश्च ते सर्वे गजाश्वरथयोधिनः ।\nन शेकुरावर्तयितुं ह्रियमाणं स्वकं धनम्\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2214092, "chapter_id": 5575, "verse_number": "६०", "content_sanskrit": "कलत्रस्य बहुत्वाद्धि सम्पतत्सु ततस्ततः ।\nप्रयत्नमकरोत् पार्थो जनस्य परिरक्षणे\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2214093, "chapter_id": 5575, "verse_number": "६१", "content_sanskrit": "मिषतां सर्वयोधानां ततस्ताः प्रमदोत्तमाः ।\nसमन्ततोवकृष्यन्त कामाच्चान्याः प्रवव्रजुः\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2214094, "chapter_id": 5575, "verse_number": "६२", "content_sanskrit": "ततो गाण्डीवनिर्मुक्तैः शरैः पार्थो धनञ्जयः ।\nजघान दस्यून् सोद्वेगो वृष्णिभृत्यैः सहस्रशः\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2214095, "chapter_id": 5575, "verse_number": "६३", "content_sanskrit": "क्षणेन तस्य ते राजन् क्षयं जग्मुरजिह्मगाः ।\nअक्षया हि पुरा भूत्वा क्षीणाः क्षतजभोजनाः\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2214096, "chapter_id": 5575, "verse_number": "६४", "content_sanskrit": "स शरक्षयमासाद्य दुःखशोकसमाहतः ।\nधनुष्कोट्या तदा दस्यूनवधीत् पाकशासनिः\t ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2214097, "chapter_id": 5575, "verse_number": "६५", "content_sanskrit": "प्रेक्षतस्त्वेव पार्थस्य वृष्ण्यन्धकवरस्त्रियः ।\nजग्मुरादाय ते म्लेच्छाः समन्ताज्जनमेजय\t ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2214098, "chapter_id": 5575, "verse_number": "६६", "content_sanskrit": "धनञ्जयस्तु दैवं तन्मनसाऽचिन्तयत्प्रभुः ।\nदुःखशोकसमाविष्टो निःश्वासपरमोऽभवत्\t ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2214099, "chapter_id": 5575, "verse_number": "६७", "content_sanskrit": "अस्त्राणां च प्रणाशेन बाहुवीर्यस्य च क्षयात् ।\nधनुषश्चाविधेयत्वात् शराणां सङ्क्षयेन च\t ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2214100, "chapter_id": 5575, "verse_number": "६८", "content_sanskrit": "बभूव विमनाः पार्थो दैवमित्यनुचिन्तयन् ।\nन्यवर्तत ततो राजन् नेदमस्तीति चिन्तयन्\t ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2214101, "chapter_id": 5575, "verse_number": "६९", "content_sanskrit": "ततः शेषं समादाय कलत्रस्य महामतिः ।\nहृतभूयिष्ठरत्नस्य कुरुक्षेत्रमवातरत्\t ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2214102, "chapter_id": 5575, "verse_number": "७०", "content_sanskrit": "युधिष्ठिरस्यानुमते वंशकर्तॄन् कुमारकान् ।\nन्यवेशयत कौरव्यस्तत्र तत्र धनञ्जयः\t ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2214103, "chapter_id": 5575, "verse_number": "", "content_sanskrit": "हार्दिक्यतनयं पार्थो नगरे मृत्तिकावने ।\n(अश्वपतिं खाण्डवारण्ये राज्ये तत्र न्यवेशयत्\t ॥७१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2214104, "chapter_id": 5575, "verse_number": "७२", "content_sanskrit": "भोजराजकलत्रं च हृतशेषं नरोत्तमः\t ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2214105, "chapter_id": 5575, "verse_number": "७३", "content_sanskrit": "तथा वृद्धांश्च बालांश्च स्त्रियश्चादाय पाण्डवः ।\nवीरैर्विहीनान् सर्वांस्तान् शक्रप्रस्थे न्यवेशयत्\t ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2214106, "chapter_id": 5575, "verse_number": "७४", "content_sanskrit": "यौयुधानिं सरस्वत्याः पुत्रं सात्यकिनः प्रियम् ।\nन्यवेशयत धर्मात्मा वृद्धबालपुरस्कृतम्\t ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2214107, "chapter_id": 5575, "verse_number": "७५", "content_sanskrit": "इन्द्रप्रस्थे ददौ राज्यं वज्राय परवीरहा ।\nवज्रेणाक्रूरदारास्तु वार्यमाणाः प्रवव्रजुः\t ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2214108, "chapter_id": 5575, "verse_number": "७६", "content_sanskrit": "सरस्वतीं प्रविविशुः तथान्याः शुद्धचेतसः\t ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2214109, "chapter_id": 5575, "verse_number": "७७", "content_sanskrit": "रुग्मिणी त्वथ गान्धारी शैब्या हैमवतीत्यपि ।\nदेवी जाम्बवती चैव विविशुर्जातवेदसम्\t ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2214110, "chapter_id": 5575, "verse_number": "७८", "content_sanskrit": "सत्यभामा तथैवान्या देव्यः कृष्णस्य सम्मताः ।\nवनं प्रविविशू राजंस्तापसे कृतनिश्चयाः\t ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2214111, "chapter_id": 5575, "verse_number": "७९", "content_sanskrit": "वने मूलादिभोजिन्यो हविर्दानैकतत्पराः ।\nहिमवन्तमतिक्रम्य कलापग्राममाविशन्\t ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2214112, "chapter_id": 5575, "verse_number": "८०", "content_sanskrit": "द्वारकावासिनो ये तु पुरुषाः पार्थमभ्ययुः ।\nयथार्हं संविभज्यैनान् वज्रे पर्यददज्जयः\t ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2214113, "chapter_id": 5575, "verse_number": "८१", "content_sanskrit": "स तत्कृत्वा प्राप्तकालं बाष्पेणापिहितोऽर्जुनः ।\nकृष्णद्वैपायनं व्यासं ददर्शासीनमाश्रमे\t ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2214114, "chapter_id": 5575, "verse_number": "८२", "content_sanskrit": "साक्षान्नारायणं देवं निजरूपधरं विभुम्\t ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2214115, "chapter_id": 5575, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् मौसलपर्वणि\nव्यासार्जुनसमागमो नाम अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]