[{"id": 7002596000, "chapter_id": 22596, "verse_number": "४-१-१", "content_sanskrit": "सूत उवाच ।\nआरामादौ विशेषो यो वक्ष्यतेऽत्र मयाधुना ।\nमंडलं कारयित्वा तु चतुरस्रं समं शुभम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002596001, "chapter_id": 22596, "verse_number": "४-१-२", "content_sanskrit": "ऐशान्यां कलशे देवं तत्र नाथं प्रपूजयेत् ।\nमध्यमे कलशे पूजा ग्रहाणां च ततः परम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002596002, "chapter_id": 22596, "verse_number": "४-१-३", "content_sanskrit": "स्वदिक्षु द्वारदेशे तु पश्चिमद्वारदेशयोः ।\nब्रह्माणं चाप्यनन्तं च मध्यतो वरुणं यजेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002596003, "chapter_id": 22596, "verse_number": "४-१-४", "content_sanskrit": "वरुणं चोदकुम्भस्थं भूतशाखासु शोभनम् ।\nतेन चावाहयामि त्वां विभो स्वर्गाय वै भव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002596004, "chapter_id": 22596, "verse_number": "४-१-५", "content_sanskrit": "पूर्वगं मन्दरं स्थाप्य तोरणोपरि सत्तमाः ।\nविष्वक्सेनं समभ्यर्च्य अर्चनं स्वर्गसंयुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002596005, "chapter_id": 22596, "verse_number": "४-१-६", "content_sanskrit": "कर्णिकायां वासुदेवं शुद्धस्फटिकसन्निभम् ।\nचतुर्भुजं शङ्खचक्रगदापद्मविभूषितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002596006, "chapter_id": 22596, "verse_number": "४-१-७", "content_sanskrit": "श्रीवत्सकौस्तुभोरस्कं मुकुटाद्यैरलंकृतम् ।\nदक्षिणे कमला तस्य वामे पुष्टिव्यवस्थितिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002596007, "chapter_id": 22596, "verse_number": "४-१-८", "content_sanskrit": "सिद्धकिन्नरयक्षाद्यैः स्तूयमानं सुरासुरैः ।\nसंपूज्य विधिवद्भक्त्या विष्णोरराट इत्यृचा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002596008, "chapter_id": 22596, "verse_number": "४-१-९", "content_sanskrit": "दले संकर्षणादींश्च विमलाद्याश्च नायिकाः ।\nसंपूज्य धूपदीपाद्यैरुपहारैरनुत्तमैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002596009, "chapter_id": 22596, "verse_number": "४-१-१०", "content_sanskrit": "घृतप्रदीपो देवस्य गुग्गुलुः सरलस्तथा ।\nधूपो देवबलिः क्षीरं परमान्नं घृतप्लुतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002596010, "chapter_id": 22596, "verse_number": "४-१-११", "content_sanskrit": "ध्यायेत्सोमं कर्णिकायां दक्षिणे पद्मसंस्थितम् ।\nशुक्लाभं द्विभुजं शान्तं केयूराद्युपशोभितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002596011, "chapter_id": 22596, "verse_number": "४-१-१२", "content_sanskrit": "प्रशस्यं देवयक्षाणां वरदाभयहस्तकम् ।\nइमं देवा इति ऋचा उपचारैः पृथग्विधैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002596012, "chapter_id": 22596, "verse_number": "४-१-१३", "content_sanskrit": "पूजयेच्च निशानाथं घृतभक्तं निवेदयेत् ।\nइन्द्रं जयन्तमाकाशं वरुणं चाग्निमेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002596013, "chapter_id": 22596, "verse_number": "४-१-१४", "content_sanskrit": "ईशानं तत्पुरुषं चैव वायुं पूर्वादिदिक्ष्वपि ।\nकर्णिकाया वामभागे वरदाभयहस्तकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002596014, "chapter_id": 22596, "verse_number": "४-१-१५", "content_sanskrit": "द्विभुजं शुक्लवर्णं च महादेवं प्रपूजयेत् ।\nत्र्यंबकेण च मंत्रेण दद्याच्च घृतपिष्टकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002596015, "chapter_id": 22596, "verse_number": "४-१-१६", "content_sanskrit": "वासुदेवाय देवाय जुहुयादष्ट आहुतीः ।\nपरमान्नेन सौम्यस्य जुहुयादष्टविंशतिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002596016, "chapter_id": 22596, "verse_number": "४-१-१७", "content_sanskrit": "शिवाय परमान्नेन जुहुयादाहुतिद्वयम् ।\nगणेशस्य तथाज्येन ददेदेकाहुतिं बुधः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002596017, "chapter_id": 22596, "verse_number": "४-१-१८", "content_sanskrit": "ब्रह्मणो वरुणस्याथ एकैकामाहुतिं तथा ।\nग्रहाणां स्वोक्तसमिधा दिगीशानां पृथक्पृथक् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002596018, "chapter_id": 22596, "verse_number": "४-१-१९", "content_sanskrit": "एकैकामाहुतिं दद्यादाज्येन च यथाक्रम् ।\nकराली धूमली श्वेता लोहिता कनकप्रभा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002596019, "chapter_id": 22596, "verse_number": "४-१-२०", "content_sanskrit": "अतिरक्ता पद्मरागा वह्निजिह्वा प्रकीर्तिताः ।\nतासां मंत्राः क्रमेणैव सादिवासांत बिन्दवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002596020, "chapter_id": 22596, "verse_number": "४-१-२१", "content_sanskrit": "यकारस्थाश्च विज्ञेया अष्टस्वरविभूषिताः ।\nघृतमध्वाज्यसिक्ताभिर्होमयेच्च पृथक्पृथक् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002596021, "chapter_id": 22596, "verse_number": "४-१-२२", "content_sanskrit": "एकैकामाहुतिं दद्याद्दत्त्वा चैव समाहितः ।\nअग्नीषोमं तथेन्द्रं च पृथिवीमन्तरिक्षकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002596022, "chapter_id": 22596, "verse_number": "४-१-२३", "content_sanskrit": "स्थालीपाकेन जुहुयान्मधुक्षीरयवान्वितम् ।\nएकैकामाहुतिं तेषां समुद्दिश्य पृथक्पृथक् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002596023, "chapter_id": 22596, "verse_number": "४-१-२४", "content_sanskrit": "यावकैर्गंधपुष्पाद्यैरर्चित्वा सपरावकम् ।\nजपस्व त्वं महाभाग श्रद्धया चैव वाग्यतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002596024, "chapter_id": 22596, "verse_number": "४-१-२५", "content_sanskrit": "जापको विधिनानेन प्रजपेत्तत्र रुद्धकम् ।\nमङ्गलं परमान्नं च सौरसूक्तं तथा जपेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002596025, "chapter_id": 22596, "verse_number": "४-१-२६", "content_sanskrit": "ततः संमृज्य विधिना स्नापयित्वा यथाविधि ।\nयूपं गर्भे विनिक्षिप्य तत्र कुर्याद्विचक्षणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002596026, "chapter_id": 22596, "verse_number": "४-१-२७", "content_sanskrit": "ध्वजानारोप्य प्रांतेषु दद्यात्सोमं वनस्पतिम् ।\nकोऽदादिति पठित्वा च वृक्षाणां कर्णवेधनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002596027, "chapter_id": 22596, "verse_number": "४-१-२८", "content_sanskrit": "सूच्या सुतीक्ष्णया कार्यं द्विपात्रे वामदक्षिणे ।\nनवग्रहाणां तृप्त्यर्थं यावकं लड्डुकं तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002596028, "chapter_id": 22596, "verse_number": "४-१-२९", "content_sanskrit": "पिष्टकं च पृथग्दद्यात्कुमारीबालकेषु च ।\nनिशारंजितसूत्रेण संवेष्ट्य च सचूर्णकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002596029, "chapter_id": 22596, "verse_number": "४-१-३०", "content_sanskrit": "प्रदद्याद्दोहकं चैव वृक्षाणां विधिपूर्वकम् ।\nप्राशयेच्चैव तान्वृक्षानिमं मन्त्रमुदाहरेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002596030, "chapter_id": 22596, "verse_number": "४-१-३१", "content_sanskrit": "वृक्षाग्रात्पतितस्यापि आरोहात्पतितस्य च ।\nमरणे वास्थिभङ्गे वा कर्ता पापैर्न लिप्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002596031, "chapter_id": 22596, "verse_number": "४-१-३२", "content_sanskrit": "धेनुं सुवर्णं धान्यं च आचार्याय प्रदक्षिणम् ।\nदत्त्वा च ऋत्विजे दद्यात्सुवर्णं रजतं तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002596032, "chapter_id": 22596, "verse_number": "४-१-३३", "content_sanskrit": "धान्यं च ब्रह्मणे दद्याद्घृतभोज्यं सशर्करम् ।\nइष्टां च दक्षिणां दद्यात्सदस्याय तथैव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002596033, "chapter_id": 22596, "verse_number": "४-१-३४", "content_sanskrit": "अधिकलशं समानीय स्नानं कुर्याद्विधानतः ।\nकृत्वा चैवानिशं कुर्याद्दद्यात्पूर्णाहुतिं तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002596034, "chapter_id": 22596, "verse_number": "४-१-३५", "content_sanskrit": "सर्वौषध्युदकं प्रोक्ष्य त्रिवारं क्षीरधारया ।\nसंवेष्ट्य त्रिश्चतुर्वारं ब्रह्मघोषपुरःसरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002596035, "chapter_id": 22596, "verse_number": "४-१-३६", "content_sanskrit": "गृहं व्रजेत्ततो विप्रैः कुर्याच्चैव गृहार्चनम् ।\nतंतौ विशेषं वक्ष्यामि वरा एवेदमित्यृचा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002596036, "chapter_id": 22596, "verse_number": "४-१-३७", "content_sanskrit": "बलं कामं हयग्रीवं माधवं पुरुषोत्तमम् ।\nवासुदेवं धनाध्यक्षं ततो नारायणं यजेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002596037, "chapter_id": 22596, "verse_number": "४-१-३८", "content_sanskrit": "दधिभक्तं बलिं दद्यात्पञ्चगव्यसमुद्भवम् ।\nएवं संपूज्य विधिना दक्षिणे पृथिवीं यजेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002596038, "chapter_id": 22596, "verse_number": "४-१-३९", "content_sanskrit": "शुद्धकांञ्चनवर्णाभां वराभयकरां शुभाम् ।\nमंडूकस्थां च द्विभुजां सर्वालङ्कारसुन्दरीम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002596039, "chapter_id": 22596, "verse_number": "४-१-४०", "content_sanskrit": "स्योना पृथिवीति मन्त्रेण पूजयित्वा यथाविधि ।\nपायसं मधुसंयुक्तं बलिं दद्यात्सशर्करम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002596040, "chapter_id": 22596, "verse_number": "४-१-४१", "content_sanskrit": "वामतो विश्वकर्माणं शुद्धस्फटिकसंनिभम् ।\nशूलटंकधरं शांतं संयजेदुपचारकैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002596041, "chapter_id": 22596, "verse_number": "४-१-४२", "content_sanskrit": "विश्वन्निति ऋचा तं च बलिं च मधु पिष्टकम् ।\nदद्याज्जपेच्च कौष्माण्डं सूक्तं पौरुषमेव च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002596042, "chapter_id": 22596, "verse_number": "४-१-४३", "content_sanskrit": "मधुपायसयुक्तेन होमानष्टौ विधाय च ।\nएकैकं होमयेत्पश्चा त्पृथिवीहोमकर्मणि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002596043, "chapter_id": 22596, "verse_number": "४-१-४४", "content_sanskrit": "समुत्सृज्य ततः सेतुमिमं मन्त्रं पठेत्ततः ।\nपिच्छिले पतितानां च उच्छ्रितेनांगसंगतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002596044, "chapter_id": 22596, "verse_number": "४-१-४५", "content_sanskrit": "प्रतिष्ठिते धर्मसेतौ धर्मो मे स्यान्न पातकम् ।\nसेतोरस्य प्रबन्धस्य श्रद्धया परया तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002596045, "chapter_id": 22596, "verse_number": "४-१-४६", "content_sanskrit": "ये चात्र प्राणिनः संति रक्षां कुर्वति सेतवः ।\nवेदागमेन यत्पुण्यं यथैव हि समर्पितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002596046, "chapter_id": 22596, "verse_number": "४-१-४७", "content_sanskrit": "गर्तं कृत्वा पञ्चरत्नं संस्थाप्यं तदनन्तरम् ।\nसंस्थाप्य च ततो यूपं संपूज्य च यथाविधि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002596047, "chapter_id": 22596, "verse_number": "४-१-४८", "content_sanskrit": "आचार्याय ततो दद्यादिष्टां च वरदक्षिणाम् ।\nपूजयेद्द्विजदांपत्यं लाजाभिः परिपूजितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002596048, "chapter_id": 22596, "verse_number": "४-१-४९", "content_sanskrit": "पोटिकां च ततः शय्यां दद्यादिष्टार्थसिद्धये ।\nसेतौ वृक्ष स्थिता ये स्यू रोपयेत्कदलीं शुभाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002596049, "chapter_id": 22596, "verse_number": "४-१-५०", "content_sanskrit": "तेषां पार्श्वद्वयेप्येवमारामे च पृथक्पृथक् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]