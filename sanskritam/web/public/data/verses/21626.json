[{"id": 7001626000, "chapter_id": 21626, "verse_number": "१-१२-१", "content_sanskrit": "नातद उवाच ।\nश्रुतं तु गङ्गामाहात्म्यं वाञ्छितं पापनाशनम्   ।\nअधुना लक्षणं ब्रूहि भ्रातर्मे दानपात्रघयोः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001626001, "chapter_id": 21626, "verse_number": "१-१२-२", "content_sanskrit": "सनक उवाच ।\nसर्वेषामेव वर्णानां ब्रह्मणः परमो गुरुः ।\nतस्मै दानानि देयानि दत्तस्यानन्त्यमिच्छता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001626002, "chapter_id": 21626, "verse_number": "१-१२-३", "content_sanskrit": "ब्राह्मणः प्रतिगृह्णीयात्सर्वतो भयवर्जितः ।\nन कदापि क्षत्रविशो गृह्णीयातां प्रतिग्रहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001626003, "chapter_id": 21626, "verse_number": "१-१२-४", "content_sanskrit": "चण्डस्य पुत्रहीनस्य दम्भाचाररतस्य च ।\nस्वकर्मत्यागिनश्चापि दत्तं भवति निष्फलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001626004, "chapter_id": 21626, "verse_number": "१-१२-५", "content_sanskrit": "परदाररतस्यापि परद्रव्याभिलिषिणः ।\nनक्षत्रसूचकस्यापि दत्तं भवति निष्फलम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001626005, "chapter_id": 21626, "verse_number": "१-१२-६", "content_sanskrit": "असूयाविष्टमनसः कृतन्घस्य च मायिनः ।\nअयाज्ययाजकस्यापि दत्तं भवति निष्फलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001626006, "chapter_id": 21626, "verse_number": "१-१२-७", "content_sanskrit": "नित्यं याच्ञापरस्यापि हिंसकस्य खलस्य च ।\nरसविक्रयिणश्वैव दत्तं भवति निष्फलम् ॥७ ॥ नामैका द", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001626007, "chapter_id": 21626, "verse_number": "१-१२-८", "content_sanskrit": "वेदविक्रयिणश्चापि स्मृतिविक्रयिणस्तथा ।\nधर्मविक्रयिणो विप्र दत्तं भवति निष्फलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001626008, "chapter_id": 21626, "verse_number": "१-१२-९", "content_sanskrit": "गानेन जीविका यस्य यस्य भार्या च पुश्चली ।\nपरोपतापिनश्चापि दत्तं भवति निष्फलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001626009, "chapter_id": 21626, "verse_number": "१-१२-१०", "content_sanskrit": "असिजीवी मषीजीवी देवलो ग्रामयाजकः ।\nधावको वा भवेत्तेषां दत्तं भवति निष्फलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001626010, "chapter_id": 21626, "verse_number": "१-१२-११", "content_sanskrit": "पाककर्तुः परस्यार्थे कवये गदहारिणे ।\nअभक्ष्य भक्षकस्यापि दत्तं भवति निष्फलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001626011, "chapter_id": 21626, "verse_number": "१-१२-१२", "content_sanskrit": "शूद्रान्नभोजिनश्चैव शूद्राणां शवदाहिनः ।\nपौंश्वलान्नभुजश्चापि दत्तं भवति निष्फलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001626012, "chapter_id": 21626, "verse_number": "१-१२-१३", "content_sanskrit": "नामविक्रयिणो विष्णोः संध्याकर्म्मोर्ज्झितस्य च ।\nदुष्प्रतिग्रहदग्धस्य दत्तं भवति निष्फलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001626013, "chapter_id": 21626, "verse_number": "१-१२-१४", "content_sanskrit": "दिवाशयनशीलस्य तथा मैथुनकारिणः ।\nसध्याभोजिन एवापिदत्तं भवति निष्फलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001626014, "chapter_id": 21626, "verse_number": "१-१२-१५", "content_sanskrit": "महापातकयुक्तस्य त्यक्तस्य ज्ञातिबान्धवैः ।\nकुण्डस्य चापि गोलस्य दत्तं भवति निष्फलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001626015, "chapter_id": 21626, "verse_number": "१-१२-१६", "content_sanskrit": "परिवित्तेः शठस्यापि परिवत्तुः प्रमादिनः ।\nस्त्रीजितस्यातिदुष्टस्य दत्तं भवित निष्फलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001626016, "chapter_id": 21626, "verse_number": "१-१२-१७", "content_sanskrit": "मद्यमांसाशिनश्चापि स्त्रीविटस्यातिलोभिनः ।\nचौरस्य पिशुनस्यापि दत्तं भवति निष्फलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001626017, "chapter_id": 21626, "verse_number": "१-१२-१८", "content_sanskrit": "ये केचित्पापनिरता निन्दिताः सुजनैः सदा ।\nन तेभ्यः प्रतिगृह्णीयान्न च वद्याद्दिजोत्तम ।\nसत्कर्मनिरतायापि देयं यत्नेन नारद ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001626018, "chapter_id": 21626, "verse_number": "१-१२-१९", "content_sanskrit": "यद्दानं श्रद्धया दत्तं तथा विष्णुसमर्पणम् ।\nयाचितं वापि पात्रेण भवेत्तद्दानमुत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001626019, "chapter_id": 21626, "verse_number": "१-१२-२०", "content_sanskrit": "परलोकं समुद्दश्य ह्यैहिकं वापि नारद ।\nयद्दानं दीयते पात्रे तत्काम्यं मध्यमं स्मृतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001626020, "chapter_id": 21626, "verse_number": "१-१२-२१", "content_sanskrit": "दग्भेन चापि हिंसार्थं परस्याविधिनापि च ।\nक्रुद्धेनाश्रद्धयापात्रे तद्दानं मध्यमं स्मृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001626021, "chapter_id": 21626, "verse_number": "१-१२-२२", "content_sanskrit": "अधमं बलितोषायमध्यमं स्वार्थसिद्धये ।\nउत्तमं हरिप्रीत्यर्थं प्राहुर्वेदविदां वराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001626022, "chapter_id": 21626, "verse_number": "१-१२-२३", "content_sanskrit": "दानभोगविनाशाश्च रायः स्युर्गतयस्त्रिधा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001626023, "chapter_id": 21626, "verse_number": "१-१२-२४", "content_sanskrit": "यो ददाति च नोभुक्ते तद्धनं नाशकारणम् ।\nधनं धर्मफलं विप्र धर्मो माधवतुष्टिकृत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001626024, "chapter_id": 21626, "verse_number": "१-१२-२५", "content_sanskrit": "तरवः किं न जीवन्ति तेऽपि लोके परार्थकाः ।\nयत्र मूलफलैर्वृक्षाः परकार्यं प्रकुर्वते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001626025, "chapter_id": 21626, "verse_number": "१-१२-२६", "content_sanskrit": "मनुष्या यदि विप्राग्थ्र न परार्थास्तदा मृताः ।\nपरकार्यं न ये मर्त्याः कायेनापि धनेन वा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001626026, "chapter_id": 21626, "verse_number": "१-१२-२७", "content_sanskrit": "मनसा वचसा वापि ते ज्ञेयाः पापकृत्तमाः ।\nअत्रेतिहासं वक्ष्यामि श्रृणु नारद तत्त्वतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001626027, "chapter_id": 21626, "verse_number": "१-१२-२८", "content_sanskrit": "यत्र दानादिकानां तु लक्षणं परिकीर्तितम् ।\nगङ्गामाहात्म्यसहितं सर्वपापप्रणाशनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001626028, "chapter_id": 21626, "verse_number": "१-१२-२९", "content_sanskrit": "भगीरथस्य धर्मस्य संवादं पुण्यकारणम् ।\nआसीद्भगीरथो राजा सगरान्वयसंभवः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001626029, "chapter_id": 21626, "verse_number": "१-१२-३०", "content_sanskrit": "शशास पृथिवीं मेतां सत्पद्वीपां ससागराम् ।\nसर्वधर्मरतो नित्यं सत्यसंधः प्रतापवान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001626030, "chapter_id": 21626, "verse_number": "१-१२-३१", "content_sanskrit": "कन्दर्पसद्दशो रुपे यायजृको विचक्षणः ।\nप्रालेयाद्रिसमो धैर्ये धर्मे धर्मसमो नृपः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001626031, "chapter_id": 21626, "verse_number": "१-१२-३२", "content_sanskrit": "सर्वलक्षणसंपन्नः सर्वशास्त्रार्थपारगः ।\nसर्वसंपत्समायुक्तः सर्वानन्दकरो मुने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001626032, "chapter_id": 21626, "verse_number": "१-१२-३३", "content_sanskrit": "आतिथ्यप्रयतो नित्यं वासुदेवार्चनेरतः ।\nपराक्रमी गुणनिधिर्मैत्रः कारुणिकः सधीः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001626033, "chapter_id": 21626, "verse_number": "१-१२-३४", "content_sanskrit": "एतादृशं तं राजानं ज्ञात्वा हृष्टो भगीरथम् ।\nधर्मराजो द्विजश्रेष्ठ कदाचिद्द्रष्टुमागतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001626034, "chapter_id": 21626, "verse_number": "१-१२-३५", "content_sanskrit": "समागतं धर्मराजमर्हयामास भूपतिः ।\nशास्त्रदृष्टेन विधिना धर्मः प्री उवाच तम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001626035, "chapter_id": 21626, "verse_number": "१-१२-३६", "content_sanskrit": "धर्मराज उवाच ।\nराजन्धर्मविदां श्रेष्टप्रसिद्धोऽसि जगत्र्रये ।\nधर्मराजोऽथ कीर्तिं ते श्रुत्वा त्वां द्रष्टुमागतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001626036, "chapter_id": 21626, "verse_number": "१-१२-३७", "content_sanskrit": "सन्मार्गनिरतं सत्यं सर्वभूतहिते रतम् ।\nद्रष्टुमिच्छन्ति विबुधारतवोत्कुष्टगुणप्रियाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001626037, "chapter_id": 21626, "verse_number": "१-१२-३८", "content_sanskrit": "कीर्तिर्नीतिश्च संपत्तिर्वर्तते यत्र भूपते ।\nवसन्ति तत्र नियतं गुणास्सन्तश्च देवताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001626038, "chapter_id": 21626, "verse_number": "१-१२-३९", "content_sanskrit": "अहो राजन्महाभाग शोभनीचरितं तव ।\nसर्वभूतहितत्वादि मादृशामपि दुर्लभम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001626039, "chapter_id": 21626, "verse_number": "१-१२-४०", "content_sanskrit": "इत्युक्तवन्तं तं धर्मं प्रणिपत्य भगीरथः ।\nप्रोवाच विनयाविष्टः संहृष्टः श्लक्ष्णया गिरा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001626040, "chapter_id": 21626, "verse_number": "१-१२-४१", "content_sanskrit": "भगीरथ उवाच ।\nभगवन्सर्वधर्मज्ञ समदर्शित् सुरेश्वर ।\nकृपया परयाविष्टो यत्पृच्छामि वदस्व तत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001626041, "chapter_id": 21626, "verse_number": "१-१२-४२", "content_sanskrit": "धर्मा कीदृग्विधाः प्रोक्ताः के लोका धर्मशालिनाम् ।\nकियत्यो यातनाः प्रोक्ताः केषां ताः परिकीर्तिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001626042, "chapter_id": 21626, "verse_number": "१-१२-४३", "content_sanskrit": "त्वया संमाननीया ये शासनीयाश्च ये यथा ।\nतत्सर्वं मे महाभाग विस्तराद्वक्तुमर्हसि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001626043, "chapter_id": 21626, "verse_number": "१-१२-४४", "content_sanskrit": "धर्मराज उवाच ।\nसाधु साधु महाबुद्धे मतिस्ते विमलोर्जिता ।\nधर्माधर्मान्प्रवक्ष्यामितत्त्वतः श्रृणु भक्तितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001626044, "chapter_id": 21626, "verse_number": "१-१२-४५", "content_sanskrit": "धर्मा बहुविधाः प्रोक्ताः पुण्यलोकप्रदायकाः ।\nतथैव यातनाः प्रोक्ता असंख्या घोरदर्शताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001626045, "chapter_id": 21626, "verse_number": "१-१२-४६", "content_sanskrit": "विस्तराद्गदितुं नालमपि वर्षशतायुतैः ।\nतस्मातंसमासतो वक्ष्ये धर्माधर्मनिदर्शनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001626046, "chapter_id": 21626, "verse_number": "१-१२-४७", "content_sanskrit": "वृत्तिदानं द्विजानां वै महापुण्यं प्रकीर्ततम् ।\nतथैवाध्यात्मविदुषो दत्तं भवति चाक्षयम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001626047, "chapter_id": 21626, "verse_number": "१-१२-४८", "content_sanskrit": "कुटुम्बिनं या शास्त्रज्ञं श्रोत्रियं वा गुणान्वितम् ।\nयो दत्त्वा स्यापयेदृतिं तस्य पुण्यफलं श्रृणु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001626048, "chapter_id": 21626, "verse_number": "१-१२-४९", "content_sanskrit": "मातृताः पितृतश्चैव द्विजः कोटिकुलन्वितः ।\nनिर्विश्य विष्णुभवनं कल्पं तत्रैव मोदते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001626049, "chapter_id": 21626, "verse_number": "१-१२-५०", "content_sanskrit": "गण्यन्ते पांसवो भूमेर्गण्यन्ते वृष्टिविन्दवः ।\nन गण्यन्ते विधात्रापि ब्रहह्मवृत्तिफलानि वै ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001626050, "chapter_id": 21626, "verse_number": "१-१२-५१", "content_sanskrit": "समस्तदेवतारुपो ब्राह्मणः परिकीर्तितः ।\nजीवनं ददतस्तस्य कः पुण्यं गदितुं क्षमः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001626051, "chapter_id": 21626, "verse_number": "१-१२-५२", "content_sanskrit": "यो विप्रहितकृन्नित्यं स सर्वान्कृतवान्मखान् ।\nस स्नातः सर्वतीर्थेषु तप्तं तेनाखिलं तपः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001626052, "chapter_id": 21626, "verse_number": "१-१२-५३", "content_sanskrit": "यो ददस्वेति विप्राणां जीवनं प्रेरयेत्परम् ।\nसोऽपि तत्फलमाप्नोति किमन्यैर्बहुभाषितैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001626053, "chapter_id": 21626, "verse_number": "१-१२-५४", "content_sanskrit": "तडागं कारयेद्यस्तु स्वयमेवापरेण वा ।\nवक्तुं तत्पुण्यसंख्यानं नालं वर्षशतायुषा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001626054, "chapter_id": 21626, "verse_number": "१-१२-५५", "content_sanskrit": "एकश्चेदध्वगो राजंस्तडागस्य जलं पिबेत् ।\nकत्कर्तुः सर्वपापानि नश्यन्त्येव न संशयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001626055, "chapter_id": 21626, "verse_number": "१-१२-५६", "content_sanskrit": "एकाहमपि यत्कुर्याद्भूमिस्थमुदकं नरः ।\nस मुक्तः सर्वपापेभ्यः शतवर्षं वसेद्दिवि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001626056, "chapter_id": 21626, "verse_number": "१-१२-५७", "content_sanskrit": "कर्तुं तडागं यो मर्त्यः साह्यकः शक्तितो भवेत् ।\nसोऽपि तत्फलमाप्नोति तुष्टः प्रेरक एव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001626057, "chapter_id": 21626, "verse_number": "१-१२-५८", "content_sanskrit": "मृदं सिद्धार्थमात्रां वा तडागाद्यो वहिः क्षिपेत् ।\nतिष्टत्यब्दशतं स्वर्गे विमुक्तः पापकोटिभिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001626058, "chapter_id": 21626, "verse_number": "१-१२-५९", "content_sanskrit": "देवता यस्य तुष्यन्ति गुरवो वा नृपोत्तम ।\nतडागपुण्यभाक्स स्यादित्येषा शाश्वती श्रुतिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001626059, "chapter_id": 21626, "verse_number": "१-१२-६०", "content_sanskrit": "इतिहासं प्रवक्ष्यामि तवात्र नृपसत्तम ।\nयं श्रृत्वा सर्वपापेभ्यो मुच्यते नात्र संशयः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001626060, "chapter_id": 21626, "verse_number": "१-१२-६१", "content_sanskrit": "गौडदेशेऽतिविख्यातो राजासीद्वीरभद्रकः ।\nमहाप्रतापी विद्यावान्सदा विप्रप्रपूजकः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001626061, "chapter_id": 21626, "verse_number": "१-१२-६२", "content_sanskrit": "वेदशास्त्रकुलाचारयुक्तो मित्रक्विर्धनः ।\nतस्य राज्ञी महाभागा नान्मा चम्पकमञ्जरी ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001626062, "chapter_id": 21626, "verse_number": "१-१२-६३", "content_sanskrit": "तस्य राज्ञो महामात्याः कृत्माकृस्यविचारणाः ।\nधर्माणां धर्मशास्त्रेस्तु सदा कुर्वन्ति निश्चयम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001626063, "chapter_id": 21626, "verse_number": "१-१२-६४", "content_sanskrit": "प्रायश्चित्तं चिकित्त्सां च ज्योतिषे धर्मनिर्णयम् ।\nविनाशास्त्रेण यो ब्रूयात्तमाहुर्ब्रह्यघातकम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001626064, "chapter_id": 21626, "verse_number": "१-१२-६५", "content_sanskrit": "इति निश्चित्य मनसा मन्वादीरितधर्मकान् ।\nआचार्येभ्यः सदा भूपः श्रृणोति विधिपूर्वकम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001626065, "chapter_id": 21626, "verse_number": "१-१२-६६", "content_sanskrit": "न कोऽप्यन्यायवर्ती तस्य राज्येऽवरोऽपि च ।\nधर्मेण पाल्यमानस्य तस्य देशस्य भूपतेः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001626066, "chapter_id": 21626, "verse_number": "१-१२-६७", "content_sanskrit": "जातं समत्वं स्वर्गस्य सौराज्यस्य शुभावहम् ।\nस चैकदा तु नृपतिर्मृगयायां महावने ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001626067, "chapter_id": 21626, "verse_number": "१-१२-६८", "content_sanskrit": "मन्त्र्यादिभिः परिवृतो बभ्राम मध्यभास्करम् ।\nदैवादाखेटशून्यस्य ह्यतिश्रान्तस्य तत्र वै ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001626068, "chapter_id": 21626, "verse_number": "१-१२-६९", "content_sanskrit": "नृपरीतस्य संजातं सरसो दर्शनं नृप ।\nततः शुष्कां तु सरसीं दृष्ट्वा तत्र व्यचिन्तयत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001626069, "chapter_id": 21626, "verse_number": "१-१२-७०", "content_sanskrit": "किमयं सरसीश्रृङ्गेभुवः केन  विनिर्मिता ।\nकथं जलं भवेदत्र येन जीवेदयं नृपः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001626070, "chapter_id": 21626, "verse_number": "१-१२-७१", "content_sanskrit": "ततो बुद्धिः समभवत्खाते तस्या नृपोत्तम ।\nहस्तमात्रं ततो गर्त्तं खात्वा तोयमवाप्तवान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001626071, "chapter_id": 21626, "verse_number": "१-१२-७२", "content_sanskrit": "तेन तोयेन पीतेन राज्ञस्तृत्पिरजायत ।\nमन्त्रिणश्चापि भूमिश बुद्धिसागरसंज्ञिनः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001626072, "chapter_id": 21626, "verse_number": "१-१२-७३", "content_sanskrit": "स बुद्धिसागरो भूपं प्राह धर्मार्थकोविदः ।\nराजन्नियं पुष्करिणी वर्षाजलवती पुरा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001626073, "chapter_id": 21626, "verse_number": "१-१२-७४", "content_sanskrit": "अद्यैनां बद्धवप्रां च कर्त्तुं जाता मतिर्मम ।\nतद्भवान्मोदतां देव दत्तादाज्ञां च मेऽनघ ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001626074, "chapter_id": 21626, "verse_number": "१-१२-७५", "content_sanskrit": "इति श्रुत्वा वचस्तस्य मन्त्रिणो नृपसत्तमः ।\nमुमुदेऽतितरां भूपः स्वयं कर्तुं समुद्यतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001626075, "chapter_id": 21626, "verse_number": "१-१२-७६", "content_sanskrit": "तमेव मन्त्रिणां तत्र युयोज शुभकर्मणि ।\nततो राजाज्ञया सोऽपि बुद्धिसागरको मुदा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001626076, "chapter_id": 21626, "verse_number": "१-१२-७७", "content_sanskrit": "सरसीं सागरं कर्त्तुमुद्यतः पुण्यकृत्तमः ।\nधनुषां चैव पञ्चाशत्सर्वतो विस्तृतायताम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001626077, "chapter_id": 21626, "verse_number": "१-१२-७८", "content_sanskrit": "सरसीं बद्धसु शिलां चकारागाधशम्बराम् ।\nतां विनिर्माय सरसीं राज्ञे सर्वं न्यवेदयत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001626078, "chapter_id": 21626, "verse_number": "१-१२-७९", "content_sanskrit": "तस्यां ततः प्रभृति वै सर्वेऽपि वनचारिणः ।\nपान्थाः पिपासिता भूप लभन्ते स्म जलं शुभम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001626079, "chapter_id": 21626, "verse_number": "१-१२-८०", "content_sanskrit": "कदाचित्स्वायुषश्चान्ते स मन्त्री बुद्धिसागरः ।\nप्रमृतो गतवाँल्लोकं लोकशास्तुर्मम प्रभो ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001626080, "chapter_id": 21626, "verse_number": "१-१२-८१", "content_sanskrit": "तदर्थं तु मया पृष्टो धर्मो धर्मलिपिंकरः ।\nचित्रगुत्पस्तु तत्कर्म मह्यं सर्वं न्यवेदयत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001626081, "chapter_id": 21626, "verse_number": "१-१२-८२", "content_sanskrit": "उपदेष्टा स्वयं चासौ धर्मकार्यस्य भूपतेः ।\nतस्माद्धर्मविमानं तु समारोढुमिहार्हति ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001626082, "chapter_id": 21626, "verse_number": "१-१२-८३", "content_sanskrit": "इत्युक्ते चित्रगुप्तेन समाज्ञप्तो मया नृप ।\nविमानं धर्मसंज्ञं तु आरोढुं बुद्धिसागरः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001626083, "chapter_id": 21626, "verse_number": "१-१२-८४", "content_sanskrit": "अथ कालान्तरे राजन्सराजा वीरभद्रकः ।\nमृतो गतो मम स्थानं नमश्चक्रे मुदान्वितः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001626084, "chapter_id": 21626, "verse_number": "१-१२-८५", "content_sanskrit": "मया तु तत्र तस्यापि पृष्टं कर्माखिलं नृप ।\nकथितं चित्रगुत्पेन धर्मं सरसिसंभवम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001626085, "chapter_id": 21626, "verse_number": "१-१२-८६", "content_sanskrit": "तदा सम्यङ्मया राजा बोधितोऽभूद्यथाश्रृणु ।\nअधित्यकायां भूपाल सैकतस्य गिरेः परा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001626086, "chapter_id": 21626, "verse_number": "१-१२-८७", "content_sanskrit": "लावकेनामुनाचञ्च्वा खातं द्व्यंङ्गुप्रलमबुनि ।\nततः कालान्तरे तेन वाराहेण नृपोत्तम ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001626087, "chapter_id": 21626, "verse_number": "१-१२-८८", "content_sanskrit": "खनितं हस्तमात्रं तु जलं तुण्डेन चात्मनः ।\nततोऽन्यदाऽमुया काल्याहस्त युग्ममितः कृतः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001626088, "chapter_id": 21626, "verse_number": "१-१२-८९", "content_sanskrit": "खातो जले महाराज तोयं मासद्वयं स्थितम् ।\nपीतं क्षुद्रैर्वनचरैः सत्त्वैस्तृष्णासमाकुलैः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001626089, "chapter_id": 21626, "verse_number": "१-१२-९०", "content_sanskrit": "ततो वर्षत्रायान्ते तु गजतानेन सुव्रत ।\nहस्तत्रयमितः खातः कृतस्तत्राधिकं जलम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001626090, "chapter_id": 21626, "verse_number": "१-१२-९१", "content_sanskrit": "मासत्रये स्थितं तच्च पयो जीवैर्वनेचरैः ।\nभवांस्तत्र समायातो जलशोषादनन्तरम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001626091, "chapter_id": 21626, "verse_number": "१-१२-९२", "content_sanskrit": "मासे तत्र तु संप्रात्पं हस्तं खात्वा जलं नृप ।\nततस्तस्योपदेशेन मन्त्रिणो नृपते त्वया ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001626092, "chapter_id": 21626, "verse_number": "१-१२-९३", "content_sanskrit": "पञ्चाशद्धनुरुत्खातं जातं तत्र महाजलम् ।\nपुनः शिलाभिः सुदृढं बद्धं जातं महत्सरः ।\nवृक्षाश्च रोपितास्तत्र सर्वलोकोपकारिणः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001626093, "chapter_id": 21626, "verse_number": "१-१२-९४", "content_sanskrit": "तेन स्वस्वेन पुण्येन पञ्चैते जगतीपते ।\nविमानं धर्म्यमारुढास्त्वमाण्येनं समारुह ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001626094, "chapter_id": 21626, "verse_number": "१-१२-९५", "content_sanskrit": "इति वाक्यं समाकर्ण्य मम राजा स भूमिप ।\nआरुरोह विमानं तत्षष्ठो राजा समांशभाक् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001626095, "chapter_id": 21626, "verse_number": "१-१२-९६", "content_sanskrit": "इति ते सर्वमाख्यातं तडागजनितं फलम् ।\nश्रुत्वैतन्मुच्यते पापादाजन्ममरणान्तिकात् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001626096, "chapter_id": 21626, "verse_number": "१-१२-९७", "content_sanskrit": "यो नरः श्रद्धयो युक्तो व्याख्यातं श्रुणुयात्पठेत् ।\nसोऽप्याप्नोत्यखिलं पुण्यं सरोनिर्माणसंभवम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]