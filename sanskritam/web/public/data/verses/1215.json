[{"id": 2010632, "chapter_id": 1215, "verse_number": "१-२१६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010633, "chapter_id": 1215, "verse_number": "१-२१६-१", "content_sanskrit": "पाण्डवैः सह संयोगं गतस्य द्रुपदस्य ह।\nन बभूव भयं किंचिद्देवेभ्योऽपि कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010634, "chapter_id": 1215, "verse_number": "१-२१६-२", "content_sanskrit": "कुन्तीमासाद्य ता नार्यो द्रुपदस्य महात्मनः।\nनाम संकीर्तयन्त्योऽस्या जग्मुः पादौ स्वमूर्धभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010635, "chapter_id": 1215, "verse_number": "१-२१६-३", "content_sanskrit": "कृष्णा च क्षौमसंवीता कृतकौतुकमङ्गला।\nकृताभिवादना श्वश्र्वास्तस्थौ प्रह्वा कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010636, "chapter_id": 1215, "verse_number": "१-२१६-४", "content_sanskrit": "रूपलक्षणसंपन्नां शीलाचारसमन्विताम्।\nद्रौपदीमवदत्प्रेम्णा पृथाशीर्वचनं स्नुषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010637, "chapter_id": 1215, "verse_number": "१-२१६-५", "content_sanskrit": "यथेन्द्राणी हरिहये स्वाहा चैव विभावसौ।\nरोहिणी च यथा सोमे दमयन्ती यथा नले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010638, "chapter_id": 1215, "verse_number": "१-२१६-६", "content_sanskrit": "यथा वैश्रवणे भद्रा वसिष्ठे चाप्यरुन्धती।\nयथा नारायणे लक्ष्मीस्तथा त्वं भव भर्तृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010639, "chapter_id": 1215, "verse_number": "१-२१६-७", "content_sanskrit": "जीवसूर्वीरसूर्भद्रे बहुसौख्यसमन्विता।\nसुभगा भोगसंपन्ना यज्ञपत्नी पतिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010640, "chapter_id": 1215, "verse_number": "१-२१६-८", "content_sanskrit": "अतिथीनागतान्साधून्वृद्दान्बालांस्तथा गुरून्।\nपूजयन्त्या यथान्यायं शश्वद्गच्छन्तु ते समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010641, "chapter_id": 1215, "verse_number": "१-२१६-९", "content_sanskrit": "कुरुजाङ्गलमुख्येषु राष्ट्रेषु नगरेषु च।\nअनु त्वमभिषिच्यस्व नृपतिं धर्मवत्सला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010642, "chapter_id": 1215, "verse_number": "१-२१६-१०", "content_sanskrit": "पतिभिर्निर्जितामुर्वीं विक्रमेण महाबलैः।\nकुरु ब्राह्मणसात्सर्वामश्वमेधे महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010643, "chapter_id": 1215, "verse_number": "१-२१६-११", "content_sanskrit": "पृथिव्यां यानि रत्नानि गुणवन्ति गुणान्विते।\nतान्याप्नुहि त्वं कल्याणि सुखिनी शरदां शतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010644, "chapter_id": 1215, "verse_number": "१-२१६-१२", "content_sanskrit": "यथा च त्वाऽभिनन्दामि वध्वद्य क्षौमसंवृताम्।\nतथा भूयोऽभिनन्दिष्ये जातपुत्रां गुणान्वितां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010645, "chapter_id": 1215, "verse_number": "१-२१६-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010646, "chapter_id": 1215, "verse_number": "१-२१६-१३", "content_sanskrit": "ततस्तु कृतदारेभ्यः पाण्डुभ्यः प्राहिणोद्धरिः।\nवैदूर्यमणिचित्राणि हैमान्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010647, "chapter_id": 1215, "verse_number": "१-२१६-१४", "content_sanskrit": "वासांसि च महार्हाणि नानादेश्यानि माधवः।\nकम्बलाजिनरत्नानि स्पर्शवन्ति शुभानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010648, "chapter_id": 1215, "verse_number": "१-२१६-१५", "content_sanskrit": "शयनासनयानानि विविधानि महान्ति च।\nवैदूर्यवज्रचित्राणि शतशो भाजनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010649, "chapter_id": 1215, "verse_number": "१-२१६-१६", "content_sanskrit": "रूपयौवनदाक्षिण्यैरुपेताश्च स्वलङ्कृताः।\nप्रेष्याः संप्रददौ कृष्णो नानादेश्याः स्वलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010650, "chapter_id": 1215, "verse_number": "१-२१६-१७", "content_sanskrit": "गजान्विनीतान्भद्रांश्च सदश्वांश्च स्वलङ्कृतान्।\nरथांश्च दान्तान्सौवर्णैः शुभ्रैः पट्टैरलङ्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010651, "chapter_id": 1215, "verse_number": "१-२१६-१८", "content_sanskrit": "कोटिशश्च सुवर्णं च तेषामकृतकं तथा।\nवीथीकृतममेयात्मा प्राहिणोन्मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010652, "chapter_id": 1215, "verse_number": "१-२१६-१९", "content_sanskrit": "तत्सर्वं प्रतिजग्राह धर्मराजो युधिष्ठिरः।\nमुदा परमया युक्तो गोविन्दप्रियकाम्यया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010653, "chapter_id": 1215, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि वैवाहिकपर्वणि षोडशाधिकद्विशततमोऽध्यायः॥ २१६ ॥ ॥ समाप्तं वैवाहिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]