[{"id": 7005764000, "chapter_id": 25764, "verse_number": "२३७-१", "content_sanskrit": "शान्तिविधानवर्णनम् ।\nगर्ग उवाच ।\nप्रविशन्ति यदा ग्राममारण्या मृगपक्षिणः ।\nअरण्यं यान्ति वा ग्राम्याः स्थलं यान्ति जलोद्भवाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005764001, "chapter_id": 25764, "verse_number": "२३७-२", "content_sanskrit": "स्थलजाश्च जलं यान्ति घोरं वाशन्ति निर्भयाः ।\nराजद्वारे पुरद्वारे शिवा चाप्यशिवप्रदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005764002, "chapter_id": 25764, "verse_number": "२३७-३", "content_sanskrit": "दिवारात्रिञ्चरावापि रात्रावपि दिवाचराः ।\nग्राम्यास्त्यजन्ति ग्रामञ्च शून्यतां तस्य निर्दिशेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005764003, "chapter_id": 25764, "verse_number": "२३७-४", "content_sanskrit": "दीप्तावाशन्ति सन्ध्यासु मण्डलानि च कुर्वते ।\nवाशन्ति विस्वरं यत्र तदाप्येतत् फलं लभेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005764004, "chapter_id": 25764, "verse_number": "२३७-५", "content_sanskrit": "प्रदोषे कुक्कुटो वाशेद् धेमन्ते वापि कोकिलः ।\nअर्कोदये त्वभिमुखी शिवा रौति भयं वदेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005764005, "chapter_id": 25764, "verse_number": "२३७-६", "content_sanskrit": "गृहं कपोतः प्रविशेत् क्रव्यादो मूर्ध्नि लीयते ।\nमधुवा मक्षिकाः कुर्युर्मृत्युर्गृहपतेर्भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005764006, "chapter_id": 25764, "verse_number": "२३७-७", "content_sanskrit": "प्राकारद्वारगेहेषु तोरणापणवीथिषु ।\nकेतुच्छत्रायुधाद्येषु क्रव्यादं प्रपतेद्यदि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005764007, "chapter_id": 25764, "verse_number": "२३७-८", "content_sanskrit": "जायन्ते वाथ वल्मीका मधु वा स्यन्दते यदि ।\nसदेशो नाशमायाति राजा च म्रियते तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005764008, "chapter_id": 25764, "verse_number": "२३७-९", "content_sanskrit": "मूषकान् शलभान् दृष्ट्वा प्रभूतं क्षुद् भयं भवेत् ।\nकाष्ठोल्मुकास्थिश्रृङ्गाढ्याः श्वानो मर्कटवेदनाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005764009, "chapter_id": 25764, "verse_number": "२३७-१०", "content_sanskrit": "दुर्भिक्षवेदना ज्ञेया काकाधान्यमुखा यदि ।\nजनानभिभवन्तीह निर्भया रणवेदिनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005764010, "chapter_id": 25764, "verse_number": "२३७-११", "content_sanskrit": "काको मैथुनसक्तश्च श्वेतस्तु यदि दृश्यते ।\nराजा वा म्रियते तत्र स च देशो विनश्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005764011, "chapter_id": 25764, "verse_number": "२३७-१२", "content_sanskrit": "उलूको दृश्यते यत्र नृपद्वारे तथा गृहे  ।\nज्ञेयो गृहपतेर्मृत्युर्धननाशस्तथैव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005764012, "chapter_id": 25764, "verse_number": "२३७-१३", "content_sanskrit": "मृगपक्षिविकारेषु कुर्याद्धोमं सदक्षिणम् ।\nदेवा कपोता इति वा जप्तव्याः पञ्चभिर्द्विजैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005764013, "chapter_id": 25764, "verse_number": "२३७-१४", "content_sanskrit": "गावश्च देया विधिवद् द्विजानां सकाञ्चना वस्त्रयुगोत्तरीयाः ।\nएवं कृते शान्तिमुपैति पापं मृगैर्द्विजैर्वा विनिवेदितं यत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]