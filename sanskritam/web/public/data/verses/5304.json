[{"id": 2201912, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201913, "chapter_id": 5304, "verse_number": "१", "content_sanskrit": "एको लोकः सुकृतिनां सर्वे त्वाहो पितामह ।\nउत तत्रापि नानात्वं तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201914, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201915, "chapter_id": 5304, "verse_number": "२", "content_sanskrit": "कर्मभिः पार्थ नानात्वं लोकानां यान्ति मानवाः ।\nपुण्यान् पुण्यकृतो यान्ति पापान् पापकृतो जनाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201916, "chapter_id": 5304, "verse_number": "३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nगौतमस्य मुनेस्तात संवादं वासवस्य च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201917, "chapter_id": 5304, "verse_number": "४", "content_sanskrit": "ब्राह्मणो गौतमः कश्चिन्मृदुर्दान्तो जितेन्द्रियः ।\nमहावने हस्तिशिशुं परिद्यूनममातृकम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201918, "chapter_id": 5304, "verse_number": "५", "content_sanskrit": "तं दृष्ट्वा जीवयामास सानुक्रोशो धृतव्रतः ।\nस तु दीर्घेण कालेन बभूवातिबलो महान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201919, "chapter_id": 5304, "verse_number": "६", "content_sanskrit": "तं प्रभिन्नं महानागं प्रस्रुतं सर्वतो मदम् ।\nधृतराष्ट्रस्वरूपेण शक्रो जग्राह हस्तिनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201920, "chapter_id": 5304, "verse_number": "७", "content_sanskrit": "ह्रियमाणं तु तं दृष्ट्वा गौतमः संशितव्रतः ।\nअभ्यभाषत राजानं धृतराष्ट्रं महातपाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201921, "chapter_id": 5304, "verse_number": "८", "content_sanskrit": "मा मे हार्षीर्हस्तिनं पुत्रमेनं\nदुःखात् पुष्टं धृतराष्ट्राकृतज्ञ ।\nमित्रं सतां सप्तपदं वदन्ति\nमित्रद्रोहो नैव राजन् स्पृशेत् त्वाम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201922, "chapter_id": 5304, "verse_number": "९", "content_sanskrit": "इध्मोदकप्रदातारं शून्यपालकमाश्रमे ।\nविनीतमाचार्यकुले सुयुक्तं गुरुकर्मणि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201923, "chapter_id": 5304, "verse_number": "१०", "content_sanskrit": "शिष्टं दान्तं कृतज्ञं च प्रियं च सततं मम ।\nन मे विक्रोशतो राजन् हर्तुमर्हसि कुञ्जरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201924, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201925, "chapter_id": 5304, "verse_number": "११", "content_sanskrit": "गवां सहस्रं भवते ददामि\nदासीशतं निष्कशतानि पञ्च ।\nअन्यच्च वित्तं विविधं महर्षे\nकिं ब्राह्मणस्येह गजेन कृत्यम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201926, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201927, "chapter_id": 5304, "verse_number": "१२", "content_sanskrit": "त्वामेव गावो विविधा भजन्तु\nदास्यः सनिष्का विविधं च रत्नम् ।\nअन्यच्च वित्तं विविधं नरेन्द्र\nकिं ब्राह्मणस्येह धनेन कृत्यम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201928, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201929, "chapter_id": 5304, "verse_number": "१३", "content_sanskrit": "ब्राह्मणानां हस्तिभिर्नास्ति कृत्यं\nराजन्यानां नागकुलानि विप्र ।\nस्वं वाहनं नयतो नास्त्यधर्मो\nनागश्रेष्ठाद् गौतमास्मान्निवर्त \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201930, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201931, "chapter_id": 5304, "verse_number": "१४", "content_sanskrit": "यत्र प्रेतो नन्दति पुण्यकर्मा\nयत्र प्रेतः शोचति पापकर्मा ।\nवैवस्वतस्य सदने महात्मनः\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201932, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201933, "chapter_id": 5304, "verse_number": "१५", "content_sanskrit": "ये निष्क्रिया नास्तिका श्रद्दधानाः\nपापात्मान इन्द्रियार्थे निविष्टाः ।\nयमस्य ते यातनां प्राप्नुवन्ति\nपरं गन्ता धृतराष्ट्रो न तत्र \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201934, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201935, "chapter_id": 5304, "verse_number": "१६", "content_sanskrit": "वैवस्वती संयमनी जनानां\nयत्रानृतं नोच्यते यत्र सत्यम् ।\nयत्राबला बलिनं यातयन्ति\nतत्र त्वाहं हस्तिनं यातयिष्ये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201936, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201937, "chapter_id": 5304, "verse_number": "१७", "content_sanskrit": "ज्येष्ठां स्वसारं पितरं मातरं च\nगुरुं यथाऽमानयन्तश्चरन्ति ।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201938, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201939, "chapter_id": 5304, "verse_number": "१८", "content_sanskrit": "मन्दाकिनी वैश्रवणस्य राज्ञो\nमहाभोगा भोगिजनप्रवेश्या ।\nगन्धर्वयक्षैरप्सरोभिश्च जुष्टा\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201940, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201941, "chapter_id": 5304, "verse_number": "१९", "content_sanskrit": "अतिथिव्रताः सुव्रता ये जना वै\nप्रतिश्रयं ददते ब्राह्मणेभ्यः ।\nशिष्टाशिनः संविभज्याश्रितांश्च\nमन्दाकिनीं तेऽपि विभूषयन्ति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201942, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201943, "chapter_id": 5304, "verse_number": "२०", "content_sanskrit": "मेरोरग्रे यद्वनं भाति रम्यं\nसुपुष्पितं किन्नरगीतजुष्टम् ।\nसुदर्शना यत्र जम्बूर्विशाला\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201944, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201945, "chapter_id": 5304, "verse_number": "२१", "content_sanskrit": "ये ब्राह्मणा मृदवः सत्यशीला\nबहुश्रुताः सर्वभूताभिरामाः ।\nयेऽधीयन्ते सेतिहासं पुराणं\nमध्वाहुत्या जुह्वति च द्विजेन्द्राः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2201946, "chapter_id": 5304, "verse_number": "२२", "content_sanskrit": "तथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र ।\nयद् विद्यते विदितं स्थानमस्ति\nतद् ब्रूहि त्वं त्वरितो ह्येष यामि \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2201947, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2201948, "chapter_id": 5304, "verse_number": "२३", "content_sanskrit": "सुपुष्पितं किन्नरराजजुष्टं\nप्रियं वनं नन्दनं नारदस्य ।\nगन्धर्वाणामप्सरसां च सद्म\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2201949, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2201950, "chapter_id": 5304, "verse_number": "२४", "content_sanskrit": "ये नृत्तगीते कुशला जनाः सदा\nह्ययाचमानाः सहिताश्चरन्ति ।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2201951, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2201952, "chapter_id": 5304, "verse_number": "२५", "content_sanskrit": "यत्रोत्तराः कुरवो भान्ति रम्या\nदेवैः सार्धं मोदमाना नरेन्द्र ।\nयत्राग्नियौनाश्च वसन्ति विप्रा\nह्ययोनयः पर्वतयोनयश्च \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2201953, "chapter_id": 5304, "verse_number": "२६", "content_sanskrit": "यत्र शक्रो वर्षति सर्वकामान्\nयत्र स्त्रियः कामचाराश्चरन्ति ।\nयत्र चेर्ष्या नास्ति नारीषु पुंसां\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2201954, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2201955, "chapter_id": 5304, "verse_number": "२७", "content_sanskrit": "ये सर्वभूतेषु निवृत्तकामा\nअमांसादा न्यस्तदण्डाश्चरन्ति ।\nन हिंसन्ति स्थावरं जङ्गमं च\nये भूतानां सर्वभूतात्मभूताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2201956, "chapter_id": 5304, "verse_number": "२८", "content_sanskrit": "निराशिषो निर्ममा वीतरागा\nलाभालाभे ये समा सत्यसन्धाः ।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2201957, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2201958, "chapter_id": 5304, "verse_number": "२९", "content_sanskrit": "ततः परं भान्ति लोकाः सनातनाः\nसुपुण्यगन्धा निर्मला वीतशोकाः ।\nसोमस्य राज्ञः सदने महात्मनः\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2201959, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2201960, "chapter_id": 5304, "verse_number": "३०", "content_sanskrit": "ये दानशीला न प्रतिगृह्णते सदा\nन चाप्यर्थानाददते परेभ्यः ।\nयेषामदेयमर्हते नास्ति किञ्चित्\nसर्वातिथ्याः सुप्रसादा जनाश्च \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2201961, "chapter_id": 5304, "verse_number": "३१", "content_sanskrit": "ये क्षन्तारो नाभिजल्पन्ति चान्यान्\nशक्ता भूत्वा सततं पुण्यशीलाः ।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2201962, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2201963, "chapter_id": 5304, "verse_number": "३२", "content_sanskrit": "ततः परं भान्ति लोकाः सनातना\nविरजसो वितमस्का विशोकाः ।\nआदित्यस्य सुमहान्तः सुवृत्ताः\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2201964, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2201965, "chapter_id": 5304, "verse_number": "३३", "content_sanskrit": "स्वाध्यायशीला गुरुशुश्रूषणे रताः\nतपस्विनः सुव्रताः सत्यसन्धाः ।\nआचार्याणामप्रतिकूलभाषिणो\nनित्योत्थिता गुरुकर्मस्वचोद्याः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2201966, "chapter_id": 5304, "verse_number": "३४", "content_sanskrit": "तथाविधानामेष लोको महर्षे\nविशुद्धानां भावितवाङ्मतीनाम् ।\nसत्ये स्थितानां वेदविदां महात्मनां\nपरं गन्ता धृतराष्ट्रो न तत्र \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2201967, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2201968, "chapter_id": 5304, "verse_number": "३५", "content_sanskrit": "ततः परे भान्ति लोकाः सनातनाः\nसुपुण्यगन्धा विरजा विशोकाः ।\nवरुणस्य राज्ञः सदने महात्मनः\nतत्र त्वाहं हस्तिनं यातयिष्ये \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2201969, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2201970, "chapter_id": 5304, "verse_number": "३६", "content_sanskrit": "चातुर्मास्ये ये यजन्ते जनाः सदा\nतथेष्टीनां दशशतं प्राप्नुवन्ति ।\nये चाग्निहोत्रं जुह्वति श्रद्दधाना\nयथान्यायं त्रीणि वर्षाणि विप्राः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2201971, "chapter_id": 5304, "verse_number": "३७", "content_sanskrit": "स्वदारिणां धर्मधुरे महात्मनां\nयथोचिते वर्त्मनि सुस्थितानाम् ।\nधर्मात्मनामुद्वहतां गतिं तां\nपरं गन्ता धृतराष्ट्रो न तत्र\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2201972, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2201973, "chapter_id": 5304, "verse_number": "३८", "content_sanskrit": "इन्द्रस्य लोका विरजा विशोका\nदुरन्वयाः काङ्क्षिता मानवानाम् ।\nतस्याहं ते भवने भूरितेजसो\nराजन्निमं हस्तिनं यातयिष्ये\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2201974, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2201975, "chapter_id": 5304, "verse_number": "३९", "content_sanskrit": "शतवर्षजीवी यश्च शूरो मनुष्यो\nवेदाध्यायी यश्च यज्वाऽप्रमत्तः ।\nएते सर्वे शक्रलोकं व्रजन्ति\nपरं गन्ता धृतराष्ट्रो न तत्र\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2201976, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2201977, "chapter_id": 5304, "verse_number": "४०", "content_sanskrit": "प्राजापत्याः सन्ति लोका महान्तो\nनाकस्य पृष्ठे पुष्कळा वीतशोकाः ।\nमनीषिताः सर्वलोकोद्भवानां\nतत्र त्वाहं हस्तिनं याचयिष्ये\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2201978, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2201979, "chapter_id": 5304, "verse_number": "४१", "content_sanskrit": "ये राजानो राजसूयाभिषिक्ता\nधर्मात्मानो रक्षितारः प्रजानाम् ।\nये चाश्वमेधावभृथाप्लुताङ्गाः\nतेषां लोका धृतराष्ट्रो न तत्र\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2201980, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2201981, "chapter_id": 5304, "verse_number": "४२", "content_sanskrit": "ततः परं भान्ति लोकाः सनातनाः\nसुपुण्यगन्धा विरजा वीतशोकाः ।\nतस्मिन्नहं दुर्लभे त्वप्रधृष्ये\nगवां लोके हस्तिनं याचयिष्ये\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2201982, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2201983, "chapter_id": 5304, "verse_number": "४३", "content_sanskrit": "यो गोसहस्री शतदः समां समां\nयो गोशती दश दद्यात् स्वशक्त्या ।\nतथा दशभ्यो यश्च दद्यादिहैकां\nपञ्चभ्यो वा दानशीलस्तथैकाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2201984, "chapter_id": 5304, "verse_number": "४४", "content_sanskrit": "ये जीर्यन्ते ब्रह्मचर्येण विप्रा\nब्राह्मीं वाचं परिरक्षन्ति चैव ।\nमनस्विनस्तीर्थयात्रापरायणाः\nते तत्र मोदन्ति गवां विमाने\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2201985, "chapter_id": 5304, "verse_number": "४५", "content_sanskrit": "प्रभासं मानसं पुण्यं पुष्कराणि महत्सरः ।\nपुण्यं च नैमिशं तीर्थं बाहुदां नर्मदां तदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2201986, "chapter_id": 5304, "verse_number": "४६", "content_sanskrit": "गयां गयशिरश्चैव विपाशां स्थूलवालुकाम् ।\nकृष्णां गङ्गां वृद्धगङ्गां महाह्रदमथापि च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2201987, "chapter_id": 5304, "verse_number": "४७", "content_sanskrit": "गौतमीं कौशिकीं पाकां महात्मानो धृतव्रताः ।\nसरस्वतीदृषद्वत्यौ यमुनां ये प्रयान्ति च\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2201988, "chapter_id": 5304, "verse_number": "४८", "content_sanskrit": "तत्र ते दिव्यसंस्थाना दिव्यमाल्यधराः शिवाः ।\nप्रयान्ति पुण्यगन्धाढ्या धृतराष्ट्रो न तत्र वै\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2201989, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2201990, "chapter_id": 5304, "verse_number": "४९", "content_sanskrit": "यत्र शीतभयं नास्ति न चोष्णभयमण्वपि ।\nन क्षुत्पिपासे न ग्लानिर्न दुःखं न सुखं तथा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2201991, "chapter_id": 5304, "verse_number": "५०", "content_sanskrit": "न द्वेष्यो न प्रियः कश्चिन्न बन्धुर्न रिपुस्तथा ।\nन जरामरणे वापि न पुण्यं न च पातकम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2201992, "chapter_id": 5304, "verse_number": "५१", "content_sanskrit": "तस्मिन् विरजसि स्फीते प्रज्ञासत्त्वव्यवस्थिते ।\nस्वयम्भुभवने पुण्ये हस्तिनं मे यतिष्यति\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2201993, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2201994, "chapter_id": 5304, "verse_number": "५२", "content_sanskrit": "निर्मुक्ताः सर्वसङ्गेभ्यो कृतात्मानो यतव्रताः ।\nअध्यात्मयोगसंस्थाने युक्ताः स्वर्गगतिं गताः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2201995, "chapter_id": 5304, "verse_number": "५३", "content_sanskrit": "ते ब्रह्मभवनं पुण्यं प्राप्नुवन्तीह सात्त्विकाः ।\nन तत्र धृतराष्ट्रस्ते शक्यो द्रष्टुं महामुने\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2201996, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2201997, "chapter_id": 5304, "verse_number": "५४", "content_sanskrit": "रथन्तरं यत्र बृहच्च गीयते\nयत्र वेदी पुण्डरीकैः स्तृणोति ।\nयत्रोपयाति हरिभिः सोमपीथी\nतत्र त्वाहं हस्तिनं यातयिष्ये\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2201998, "chapter_id": 5304, "verse_number": "५५", "content_sanskrit": "बुध्यामि त्वां वृत्रहणं शतक्रतुं\nव्यतिक्रमन्तं भुवनानि विश्वा ।\nकच्चिन्न वाचा वृजिनं कदाचित्\nन चाप्यकार्षं मनसोभिषङ्गात्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2201999, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2202000, "chapter_id": 5304, "verse_number": "५६", "content_sanskrit": "यस्मादिदं लोकपदं प्रजानाम्\nअन्वागमं परिपादे गजस्य ।\nतस्माद् भवान् प्रणतं माऽनुशास्तु\nब्रवीषि यत् करवाणीह सर्वम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2202001, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2202002, "chapter_id": 5304, "verse_number": "५७", "content_sanskrit": "श्वेतं करेणुं मम पुत्रनागं\nयं मेऽहार्षीर्दशवर्षाणि बालम् ।\nयो मे वने वसतोऽभूद् द्वितीयः\nतमेव मे देहि सुरेन्द्र नागम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2202003, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2202004, "chapter_id": 5304, "verse_number": "५८", "content_sanskrit": "अयं सुतस्ते द्विजमुख्य नाग-\nश्चाघ्रायते त्वामभिवीक्ष्यमाणः ।\nपादौ च ते नासिकयोपजिघ्रते\nश्रेयो मम ध्याहि नमश्च तेऽस्तु\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2202005, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2202006, "chapter_id": 5304, "verse_number": "५९", "content_sanskrit": "शिवं सदैवेह सुरेन्द्र तुभ्यं\nध्यायामि पूजां च सदा प्रयुञ्जे ।\nममापि त्वं शक्र शिवं ददस्व\nत्वया दत्तं प्रतिगृह्णामि नागम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2202007, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2202008, "chapter_id": 5304, "verse_number": "६०", "content_sanskrit": "येषां वेदा निहिता वै गुहायां\nमनीषिणां सत्त्ववतां महात्मनाम् ।\nतेषां त्वयैकेन महात्मनास्मि\nबुद्धस्तस्मात् प्रीतिमांस्तेऽहमद्य \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2202009, "chapter_id": 5304, "verse_number": "६१", "content_sanskrit": "हन्तैहि ब्राह्मण क्षिप्रं सह पुत्रेण हस्तिना ।\nप्राप्नुहि त्वं शुभाँल्लोकानह्नाय च चिराय च\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2202010, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2202011, "chapter_id": 5304, "verse_number": "६२", "content_sanskrit": "स गौतमं पुरस्कृत्य सह पुत्रेण हस्तिना ।\nदिवमाचक्रमे वज्री सद्भिः सह दुरासदम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2202012, "chapter_id": 5304, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे शक्रगौतमसंवादो नाम पञ्चपञ्चाशदुत्तरशततमोऽध्यायः ॥१५५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]