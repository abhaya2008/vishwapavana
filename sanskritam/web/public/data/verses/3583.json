[{"id": 2120344, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120345, "chapter_id": 3583, "verse_number": "१", "content_sanskrit": "ऋषेस्तद्वचनं चिन्त्य निशश्वास युधिष्ठिरः ।\nधर्मं धर्मभृतां श्रेष्ठः कर्तुमिच्छन् परन्तपः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120346, "chapter_id": 3583, "verse_number": "२", "content_sanskrit": "तस्येङ्गितज्ञो बीभत्सुः सर्वशस्त्रभृतां वरः ।\nसंविवर्तयिषुः कामं पावकात् पाकशासनिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120347, "chapter_id": 3583, "verse_number": "३", "content_sanskrit": "पार्थः प्राप्य धनुःश्रेष्ठमक्षय्यौ च महेषुधी ।\nरथं ध्वजं सभां चैव युधिष्ठिरमभाषत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120348, "chapter_id": 3583, "verse_number": "४", "content_sanskrit": "धनुरस्त्रं शरा वीर्यं पक्षो भूमिर्यशो बलम् ।\nप्राप्तमेतन्मया राजन् दुष्प्रापं यदभीप्सितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120349, "chapter_id": 3583, "verse_number": "५", "content_sanskrit": "तस्य कृत्यमहं मन्ये कोशस्याद्य विवर्धनम् ।\nकरमाहारयिष्यामि राजभ्यो नृपसत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120350, "chapter_id": 3583, "verse_number": "६", "content_sanskrit": "एतच्छ्रुत्वा कुरुश्रेष्ठो धर्मराजः सहानुजः ।\nप्रहृष्टो मन्त्रिभिश्चैव व्यासधौम्यादिभिः सह \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120351, "chapter_id": 3583, "verse_number": "७", "content_sanskrit": "ततो व्यासो महाबुद्धिरुवाचेदं वचोऽर्जुनम् ।\nसाधु साध्विति कौन्तेय दिष्ट्या ते बुद्धिरीदृशी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120352, "chapter_id": 3583, "verse_number": "८", "content_sanskrit": "पृथिवीमखिलां जेतुम् एकोऽप्यभिमतो भवान् ।\nधन्यः पाण्डुर्महीपालो यस्य पुत्रस्त्वमीदृशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120353, "chapter_id": 3583, "verse_number": "९", "content_sanskrit": "सर्वं प्राप्स्यति राजेन्द्रो धर्मपुत्रो युधिष्ठिरः ।\nत्वद्वीर्येण स धर्मात्मा सार्वभौमत्वमेष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120354, "chapter_id": 3583, "verse_number": "१०", "content_sanskrit": "त्वद्बाहुबलमाश्रित्य राजसूयमवाप्स्यति ।\nसुनयाद् वासुदेवस्य भीमार्जुनबलेन च ।\nयमयोश्चैव वीर्येण सर्वं प्राप्स्यति धर्मराट्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120355, "chapter_id": 3583, "verse_number": "११", "content_sanskrit": "तस्माद् दिशं देवगुप्तामुदीचीं गच्छ फल्गुन ।\nशक्तो भवान् सुरान् जित्वा रत्नान्याहर्तुमोजसा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120356, "chapter_id": 3583, "verse_number": "१२", "content_sanskrit": "प्राचीं भीमो बलश्लाघ्यः प्रयातु भरतर्षभः ।\nयाम्यां तत्र दिशं यातु सहदेवो महारथः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120357, "chapter_id": 3583, "verse_number": "१३", "content_sanskrit": "प्रतीचीं नकुलो गन्ता वरुणेनाभिपालिताम् ।\nएषा मे नैष्ठिकी बुद्धिः क्रियतां भरतर्षभाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120358, "chapter_id": 3583, "verse_number": "१४", "content_sanskrit": "श्रुत्वा व्यासवचो हृष्टास्तमूचुः पाण्डुनन्दनाः ।\nएवमस्तु मुनिश्रेष्ठ यथाऽऽज्ञापयसि प्रभो\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120359, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120360, "chapter_id": 3583, "verse_number": "१५", "content_sanskrit": "तेऽप्यनुज्ञाप्य राजानं सैन्येन महता वृताः ।\nविजयाय प्रयातास्तु दिशः सर्वा नरोत्तमाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120361, "chapter_id": 3583, "verse_number": "१६", "content_sanskrit": "तिथावहनि नक्षत्रे मुहूर्ते च तथा शिवे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120362, "chapter_id": 3583, "verse_number": "१७", "content_sanskrit": "प्रहृष्टो मुदितश्चापि धर्मराजो युधिष्ठिरः ।\nस्निग्धगम्भीरनादिन्या तं गिरा प्रत्यभाषत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120363, "chapter_id": 3583, "verse_number": "१८", "content_sanskrit": "स्वस्ति वाच्यार्हतो विप्रान् प्रयाहि भरतर्षभ ।\nदुर्हृदामप्रहर्षाय सुहृदां नन्दनाय च ।\nविजयस्ते ध्रुवः पार्थ प्रियं काममवाप्स्यसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120364, "chapter_id": 3583, "verse_number": "१९", "content_sanskrit": "इत्युक्तः प्रययौ पार्थः सैन्येन महता वृतः ।\nअग्निदत्तेन दिव्येन रथेनाद्भुतकर्मणा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120365, "chapter_id": 3583, "verse_number": "२०", "content_sanskrit": "तथैव भीमसेनोऽपि यमौ च पुरुषर्षभौ ।\nससैन्याः प्रययुः सर्वे धर्मराजाभिपूजिताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120366, "chapter_id": 3583, "verse_number": "२१", "content_sanskrit": "दिशं धनपतेरिष्टां व्यजयत् पाकशासनिः ।\nभीमसेनस्तथा प्राचीं सहदेवश्च दक्षिणाम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120367, "chapter_id": 3583, "verse_number": "२२", "content_sanskrit": "प्रतीचीं नकुलो राजन् दिशं व्यजयदस्त्रवित् ।\nखाण्डवप्रस्थमध्यास्ते धर्मराजो युधिष्ठिरः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120368, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120369, "chapter_id": 3583, "verse_number": "२३", "content_sanskrit": "दिशामपि जयं ब्रह्मन् विस्तरेण वदस्व मे ।\nनहि तृप्यामि भगवन् पूर्वेषां चरितं महत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120370, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120371, "chapter_id": 3583, "verse_number": "२४", "content_sanskrit": "धनञ्जयस्य वक्ष्यामि विजयं पूर्वमेव ते ।\nयुगपत् कुरुवीरैस्तु विजितेयं वसुन्धरा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120372, "chapter_id": 3583, "verse_number": "२५", "content_sanskrit": "अवाप्य राजा राज्यार्धं कुन्तीपुत्रो युधिष्ठिरः ।\nमहत्त्वे राजशब्दस्य मनश्चक्रे महामनाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120373, "chapter_id": 3583, "verse_number": "२६", "content_sanskrit": "तदा क्षात्रं विदित्वाऽस्य पृथिवीविजयं प्रति ।\nअमर्षात् पार्थिवेन्द्रास्ते तं समीयुर्युयुत्सवः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120374, "chapter_id": 3583, "verse_number": "२७", "content_sanskrit": "तत् समेत्य भुवः क्षत्रं रथनागाश्वपत्तिमत् ।\nअभ्ययात् पाण्डवं जिष्णुं मोघीकर्तुं जनाधिप\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120375, "chapter_id": 3583, "verse_number": "२८", "content_sanskrit": "तत् पार्थः पार्थिवं क्षत्रं युयुत्सुः परमाहवे ।\nप्रत्युद्ययौ महाबाहुः तरसा पाकशासनिः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120376, "chapter_id": 3583, "verse_number": "२९", "content_sanskrit": "तद् भग्नं पार्थिवं क्षत्रं पार्थेनाक्लिष्टकर्मणा ।\nवायुनेव घनानीकं मोघीभूतं ययौ दिशः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120377, "chapter_id": 3583, "verse_number": "३०", "content_sanskrit": "तज्जित्वा पार्थिवं क्षत्रं समरे परवीरहा ।\nययौ तदा वशीकर्तुमुदीचीं पाण्डुनन्दनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120378, "chapter_id": 3583, "verse_number": "३१", "content_sanskrit": "पूर्वं कुणिन्दविषये वशे चक्रे महीपतिम् ।\nधनञ्जयो महाबाहुर्नातितीव्रेण कर्मणा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120379, "chapter_id": 3583, "verse_number": "३२", "content_sanskrit": "तेनैव सहितः प्रायाज्जिष्णुः साल्वपुरं प्रति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120380, "chapter_id": 3583, "verse_number": "३३", "content_sanskrit": "स साल्वपुरमासाद्य साल्वराजं धनञ्जयः ।\nविक्रमेणोग्रधन्वानं वशे चक्रे महामनाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120381, "chapter_id": 3583, "verse_number": "३४", "content_sanskrit": "तं पार्थः सहसा जित्वा द्युमत्सेनं धनेश्वरम् ।\nकृत्वाऽनुसैनिकं प्रायात् कटदेशमरिन्दमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120382, "chapter_id": 3583, "verse_number": "३५", "content_sanskrit": "तत्रापराजितं जिष्णुः सुनाभं वसुधाधिपम् ।\nविक्रमेण वशे कृत्वा कृतवाननुसैनिकम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120383, "chapter_id": 3583, "verse_number": "३६", "content_sanskrit": "स तेन सहितो राजन् सव्यसाची परन्तपः ।\nअनन्तकालकुटिकान् कुणिन्दांश्च विजित्य सः ।\nसुमण्डलं पापजितं कृतवाननुसैनिकम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120384, "chapter_id": 3583, "verse_number": "३७", "content_sanskrit": "विजित्य शाकलद्वीपं प्रतिविन्ध्यं च पार्थिवम् ।\nशाकलद्वीपवासांश्च सप्तद्वीपे च ये नृपाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120385, "chapter_id": 3583, "verse_number": "३८", "content_sanskrit": "तान् सर्वानजयत् पार्थो धर्मराजप्रियेप्सया\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120386, "chapter_id": 3583, "verse_number": "३९", "content_sanskrit": "स तानाजौ महेष्वासो निर्जित्य पुरुषर्षभ ।\nतैरेव सहितः सर्वैः प्राग्ज्योतिषमुपाद्रवत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120387, "chapter_id": 3583, "verse_number": "४०", "content_sanskrit": "तत्र राजा महानासीद् भगदत्तो विशाम्पते ।\nतेनैव सुमहद् युद्धं पाण्डवस्य महात्मनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120388, "chapter_id": 3583, "verse_number": "४१", "content_sanskrit": "स किरातैश्च चीनैश्च वृतः प्राग्ज्योतिषोऽभवत् ।\nअन्यैश्च विविधैर्योधैः सागरानूपवासिभिः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120389, "chapter_id": 3583, "verse_number": "४२", "content_sanskrit": "ततः स दिवसानष्टौ योधयित्वा धनञ्जयम् ।\nप्रहसन्नब्रवीद् राजन् सङ्ग्रामे विगतज्वरः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120390, "chapter_id": 3583, "verse_number": "४३", "content_sanskrit": "उपपन्नं महाबाहो त्वय्येतत् पाण्डुनन्दन ।\nपाकशासनदायादे वीर्यमाहवशोभिनि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120391, "chapter_id": 3583, "verse_number": "४४", "content_sanskrit": "अहं सखा सुरेन्द्रस्य शक्रादनवमो रणे ।\nनहि शक्नोमि ते तात स्थातुं प्रमुखतो युधि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120392, "chapter_id": 3583, "verse_number": "४५", "content_sanskrit": "तुष्टोऽस्मि तव शौर्येण ब्रूहि किं करवाणि ते ।\nयद्वक्ष्यसि महाबाहो तत् करिष्यामि पाण्डव\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2120393, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2120394, "chapter_id": 3583, "verse_number": "४६", "content_sanskrit": "कुरूणां प्रवरो राजा धर्मनित्यो युधिष्ठिरः ।\nतस्य पार्थिवतामीप्सोः करस्तस्मै प्रदीयताम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2120395, "chapter_id": 3583, "verse_number": "४७", "content_sanskrit": "भवान् पितृसखा चैव प्रीयमाणो मया युधि ।\nअतो नाज्ञापयामि त्वां प्रीतिपूर्वं प्रदीयताम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2120396, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "भगदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2120397, "chapter_id": 3583, "verse_number": "४८", "content_sanskrit": "कुन्तीसुत यथा मे त्वं तथा राजा युधिष्ठिरः ।\nसर्वमेतत् करिष्यामि किं चान्यत् करवाणि ते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2120398, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2120399, "chapter_id": 3583, "verse_number": "४९", "content_sanskrit": "स तत्र सत्कृतस्तेन मासमुष्य धनञ्जयः ।\nउदक्प्राच्यां विनिर्जित्य प्रायाद् रामगिरिं प्रति\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2120400, "chapter_id": 3583, "verse_number": "५०", "content_sanskrit": "ततो रामगिरिं जित्वा तथा भुवनपर्वतम् ।\nअन्यानपि वशे चक्रे तरसा पाकशासनिः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2120401, "chapter_id": 3583, "verse_number": "५१", "content_sanskrit": "स विजित्य महाबाहुः कुन्तीपुत्रो धनञ्जयः ।\nप्रययावुत्तरां तस्माद् दिशं धनदपालिताम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2120402, "chapter_id": 3583, "verse_number": "५२", "content_sanskrit": "अभ्यन्तरं च कौन्तेयस्तथैव च बहिर्गिरिम् ।\nतथोपरिगिरिं चापि विजिग्ये पुरुषर्षभः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2120403, "chapter_id": 3583, "verse_number": "५३", "content_sanskrit": "विजित्य यवनान् सर्वान् ये च तत्र नराधिपाः ।\nतान् वशे स्थापयित्वा स रत्नान्यादाय सर्वशः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2120404, "chapter_id": 3583, "verse_number": "५४", "content_sanskrit": "तैरेव सहितः सर्वैरनुसङ्गम्य तान् नृपान् ।\nकुलूतवासिनं राजन् बृहन्तमुपजग्मिवान्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2120405, "chapter_id": 3583, "verse_number": "५५", "content_sanskrit": "वादित्ररथनादेन हयहेषास्वनेन च ।\nकुञ्जराणां च शब्देन कम्पयन्निव मेदिनीम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2120406, "chapter_id": 3583, "verse_number": "५६", "content_sanskrit": "ततो बृहन्तस्तरुणो बलेन चतुरङ्गिणा ।\nनिष्क्रम्य नगराद् राजन्नुपतस्थे धनञ्जयम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2120407, "chapter_id": 3583, "verse_number": "५७", "content_sanskrit": "सुमहान् सन्निपातोऽभूद् धनञ्जयबृहन्तयोः ।\nन शशाक बृहन्तस्तु सोढुं पार्थस्य विक्रमम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2120408, "chapter_id": 3583, "verse_number": "५८", "content_sanskrit": "सोऽविषह्यतमं ज्ञात्वा कौन्तेयं पर्वतेश्वरः ।\nउपावर्तत दुर्मेधा धनान्यादाय सर्वशः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2120409, "chapter_id": 3583, "verse_number": "५९", "content_sanskrit": "स तद्राज्यमवस्थाप्य कौलूतसहितो युवा ।\nसेनाबिन्दुमथो राजन् राज्यादाशु समाक्षिपत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2120410, "chapter_id": 3583, "verse_number": "६०", "content_sanskrit": "मोदापुरे वामदेवं सुनामानमनामिनम् ।\nकुलूतानुत्तरांश्चैव तांश्च राज्ञः समानयत्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2120411, "chapter_id": 3583, "verse_number": "६१", "content_sanskrit": "तत्रस्थैः पुरुषैरेव धर्मराजस्य शासनात् ।\nव्यजयद् धनञ्जयो राजन् देशान् पञ्च प्रधानतः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2120412, "chapter_id": 3583, "verse_number": "६२", "content_sanskrit": "समीपस्थं समासाद्य सेनाबिन्दोः पुरं महत् ।\nबलेन चतुरङ्गेण निवेशनमथाकरोत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2120413, "chapter_id": 3583, "verse_number": "६३", "content_sanskrit": "स तैः परिवृतः सर्वैर्विष्वगश्वं नराधिपम् ।\nअभ्यगच्छन्महाबाहुः पौरवं पुरुषर्षभः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2120414, "chapter_id": 3583, "verse_number": "६४", "content_sanskrit": "तं विजित्याहवे शूरं पार्वतीयं महारथः ।\nध्वजिन्याऽप्यजयद् राजन् पुरं पौरवरक्षितम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2120415, "chapter_id": 3583, "verse_number": "६५", "content_sanskrit": "पौरवं च विनिर्जित्य सेनाबिन्दुं च तत्पुरे ।\nन्यधापयदमेयात्मा दस्यूनां पतिमर्जुनः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2120416, "chapter_id": 3583, "verse_number": "६६", "content_sanskrit": "ततः काश्मीरकान् वीरान् क्षत्रियान् क्षत्रियर्षभः ।\nव्यजयल्लोहितं चैव मण्डलैर्दशभिः सह\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2120417, "chapter_id": 3583, "verse_number": "६७", "content_sanskrit": "ततस्त्रिगर्तान् कौन्तेयो दार्विकानथ तङ्कणान् ।\nक्षत्रियान् सुबहून् राजन्नुपावर्तत सर्वशः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2120418, "chapter_id": 3583, "verse_number": "६८", "content_sanskrit": "अभिसारं तथा रम्यं विजिग्ये कुरुसत्तमः ।\nकरूशवासिनं चैव रोचमानं रणेऽजयत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2120419, "chapter_id": 3583, "verse_number": "६९", "content_sanskrit": "ततः सिंहपुरं रम्यं चित्रायुधसुरक्षितम् ।\nप्रामथद् बलमास्थाय पाकशासनिराहवे\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2120420, "chapter_id": 3583, "verse_number": "७०", "content_sanskrit": "ततो वङ्गांश्च चोळांश्च किरीटी पाण्डवर्षभः ।\nसहितः सर्वसैन्येन प्रामथत् पृथुविक्रमः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2120421, "chapter_id": 3583, "verse_number": "७१", "content_sanskrit": "ततः परमसंहृष्टो बाह्लीकान् समितिञ्जयः ।\nमहता परिमर्देन वशे चक्रे दुरासदान्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2120422, "chapter_id": 3583, "verse_number": "७२", "content_sanskrit": "ततः सारबलं गृह्य फल्गुनोऽन्यान् विसृज्य सः ।\nदरदान् सह काम्भोजैरजयत् पाकशासनिः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2120423, "chapter_id": 3583, "verse_number": "७३", "content_sanskrit": "यवनांश्च महाराज शकांश्च व्यजयद् युधि\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2120424, "chapter_id": 3583, "verse_number": "७४", "content_sanskrit": "किरातान् सहयान् सर्वान् खरान् काचान् सबभ्रिकान् ।\nभीरानुत्पासिकांश्चैव म्लेच्छांश्चान्यान् सहस्रशः ।\nतान् सर्वानजयत् पार्थो धर्मराजप्रियेप्सया\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2120425, "chapter_id": 3583, "verse_number": "७५", "content_sanskrit": "प्रागुत्तरां दिशं ये च वसन्त्याश्रित्य दस्यवः ।\nनिवसन्ति वने ये च तान् सर्वानजयद् युधि\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2120426, "chapter_id": 3583, "verse_number": "७६", "content_sanskrit": "ततः परमकाम्भोजानिषीकानुत्तरानपि ।\nसहितांस्तान् महाराज व्यजयत् पाकशासनिः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2120427, "chapter_id": 3583, "verse_number": "७७", "content_sanskrit": "इषीकेषु तु सङ्ग्रामो बभूव सुभयङ्करः ।\nतारकामयसङ्काशः परमैषीकपार्थयोः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2120428, "chapter_id": 3583, "verse_number": "७८", "content_sanskrit": "स विजित्य तथा राजन्निषीकान् रणमूर्धनि ।\nशुकोदरसमप्रख्यान् हयानष्टौ समानयत्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2120429, "chapter_id": 3583, "verse_number": "७९", "content_sanskrit": "मयूरसदृशानन्यान् उभयानेव चापरान्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2120430, "chapter_id": 3583, "verse_number": "८०", "content_sanskrit": "ततः स जित्वा बीभत्सुर्भारतं वर्षमुत्तमम् ।\nअन्यान् वै दिव्यवर्षांश्च जितवान् कुलपर्वतान्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2120431, "chapter_id": 3583, "verse_number": "८१", "content_sanskrit": "तथा निर्जित्य सङ्ग्रामे हिमवन्तं सनिष्कुटम् ।\nश्वेतं पर्वतमासाद्य न्यवसत् पुरुषर्षभः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2120432, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2120433, "chapter_id": 3583, "verse_number": "८२", "content_sanskrit": "कथं स जितवान् पार्थो दिव्यान् वर्षान् सपर्वतान् ।\nआनुपूर्वीं च मे शंस नामभिः सह वै द्विज\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2120434, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2120435, "chapter_id": 3583, "verse_number": "८३", "content_sanskrit": "स जित्वा भारतं वर्षं बलाद् राजन् धनञ्जयः ।\nदस्यूंश्चाप्यजयत् सर्वान् कुक्षौ हिमवतो बलात्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2120436, "chapter_id": 3583, "verse_number": "८४", "content_sanskrit": "स विनिर्जित्य सङ्ग्रामे हिमवन्तं च निष्क्रमन् ।\nश्वेतपर्वतमासाद्य न्यवसद् भरतर्षभः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2120437, "chapter_id": 3583, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि पञ्चविंशोऽध्यायः ॥ २५ ॥ दिग्विजयपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2120438, "chapter_id": 3583, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]