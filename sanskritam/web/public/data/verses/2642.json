[{"id": 2077531, "chapter_id": 2642, "verse_number": "१२-१४७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077532, "chapter_id": 2642, "verse_number": "१२-१४७-१", "content_sanskrit": "ततो गतो शाकुनिके कपोती प्राह दुःखिता।\nसंस्मृत्य सा च भर्तारं रुदती शोककर्शिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077533, "chapter_id": 2642, "verse_number": "१२-१४७-२", "content_sanskrit": "नाहं ते विप्रियं कान्त कदाचिदपि संस्मरे।\nसर्वाऽपि विधवा नारी बहुपुत्राऽपि शोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077534, "chapter_id": 2642, "verse_number": "१२-१४७-३", "content_sanskrit": "शोच्या भवति बन्धूनां पतिहीना तपस्विनी।\nलालिताऽहं त्वया नित्यं बहुमानाच्च पूजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077535, "chapter_id": 2642, "verse_number": "१२-१४७-४", "content_sanskrit": "वचनैर्मधुरैः स्निग्धैरसंक्लिष्टमनोहरैः।\nकन्दरेषु च शैलानां नदीनां निर्झरेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077536, "chapter_id": 2642, "verse_number": "१२-१४७-५", "content_sanskrit": "द्रुमाग्रेषु च रम्येषु रमिताऽहं त्वया सह।\nआकाशगमने चैव विहृताऽहं त्वया सुखम्।\nरमामि स्म पुरा कान्त तन्मे नास्त्यद्य मे प्रिय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077537, "chapter_id": 2642, "verse_number": "१२-१४७-६", "content_sanskrit": "मितं ददाति हि पिता मितं भ्राता मितं सुतः।\nअमितस्य हि दातारं भर्तारं का न पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077538, "chapter_id": 2642, "verse_number": "१२-१४७-७", "content_sanskrit": "नास्ति भर्तृसमो नाथो नास्ति भर्तृसमं सुखम्।\nविसृज्य धनसर्वस्वं भर्ता वै शरणं स्त्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077539, "chapter_id": 2642, "verse_number": "१२-१४७-८", "content_sanskrit": "न कार्यमिह मे नाथ जीवितेन त्वया विना।\nपतिहीना तु का नारी सती जीवितुमुत्सहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077540, "chapter_id": 2642, "verse_number": "१२-१४७-९", "content_sanskrit": "एवं विलप्य बहुधा करुणं सा सुदुःखिता।\nपतिव्रता संप्रदीप्तं प्रविवेश हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077541, "chapter_id": 2642, "verse_number": "१२-१४७-१०", "content_sanskrit": "ततश्चित्राङ्गदधरं भर्तारं साऽन्वपद्यत।\nविमानस्थं सुकृतिभिः पूज्यमानं महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077542, "chapter_id": 2642, "verse_number": "१२-१४७-११", "content_sanskrit": "चित्रमाल्याम्बरधरं सर्वाभरणभूषितम्॥\nविमानशतकोटीभिरावृतं पुण्यकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077543, "chapter_id": 2642, "verse_number": "१२-१४७-१२", "content_sanskrit": "ततः स्वर्गं गतः पक्षी विमानवरमास्थितः।\nकर्मणा पूजितस्तत्र रेमे स सह भार्यया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077544, "chapter_id": 2642, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि सप्तचत्वारिंशदधिकशततमोऽध्यायः॥ १४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]