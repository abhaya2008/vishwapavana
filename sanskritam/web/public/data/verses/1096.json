[{"id": 2004860, "chapter_id": 1096, "verse_number": "१-९७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004861, "chapter_id": 1096, "verse_number": "१-९७-१", "content_sanskrit": "गतान्मुनिगणान्दृष्ट्वा पुत्रं संगृह्य पाणिना।\nमातापितृभ्यां रहिता यथा शोचन्ति दारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004862, "chapter_id": 1096, "verse_number": "१-९७-२", "content_sanskrit": "तथा शोकपरीताङ्गी धृतिमालम्ब्य दुःखिता।\nगतेषु तेषु विप्रेषु राजमार्गेण भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004863, "chapter_id": 1096, "verse_number": "१-९७-३", "content_sanskrit": "पुत्रेणैव सहायेन सा जगाम शनैः शनैः।\nअदृष्टपूर्वान्पश्यन्वै राजमार्गेण पौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004864, "chapter_id": 1096, "verse_number": "१-९७-४", "content_sanskrit": "हर्म्यप्रसादचैत्यांश्च सभा दिव्या विचित्रिताः।\nकौतूहलसमाविष्टो दृष्ट्वा विस्मयमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004865, "chapter_id": 1096, "verse_number": "१-९७-५", "content_sanskrit": "सर्वे ब्रुवन्ति तां दृष्ट्वा पद्महीनामिव श्रियम्।\nगत्या च संहीसदृशीं कोकिलेन स्वरे समाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004866, "chapter_id": 1096, "verse_number": "१-९७-६", "content_sanskrit": "मुखेन चन्द्रसदृशीं श्रिया पद्मालयासमाम्।\nस्मितेन कुन्दसदृशीं पद्मगर्भसमत्वचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004867, "chapter_id": 1096, "verse_number": "१-९७-७", "content_sanskrit": "पद्मपत्रविशालाक्षीं तप्तजाम्बूनदप्रभाम्।\nकरान्तमितमध्यैषा सुकेशी संहतस्तनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004868, "chapter_id": 1096, "verse_number": "१-९७-८", "content_sanskrit": "जघनं सुविशालं वै ऊरू करिकरोपमौ।\nरक्ततुङ्गतलौ पादौ धरण्यां सुप्रतिष्ठितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004869, "chapter_id": 1096, "verse_number": "१-९७-९", "content_sanskrit": "एवं रूपसमायुक्ता स्वर्गलोकादिवागता।\nइति स्म सर्वेऽमन्यन्त दुष्यन्तनगरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004870, "chapter_id": 1096, "verse_number": "१-९७-१०", "content_sanskrit": "पुनः पुनरवोचंस्ते शाकुन्तलगुणानपि।\nसिंहेक्षणः सिंहदंष्ट्रः सिंहस्कन्धो महाभुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004871, "chapter_id": 1096, "verse_number": "१-९७-११", "content_sanskrit": "सिंहोरस्कः सिंहबलः सिंहविक्रान्तगाम्ययम्।\nपृथ्वंसः पृथुवक्षाश्च छत्राकारशिरा महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004872, "chapter_id": 1096, "verse_number": "१-९७-१२", "content_sanskrit": "पाणिपादतले रक्तो रक्तास्यो दुन्दुभिस्वनः।\nराजलक्षणयुक्तश्च राजश्रीश्चास्य लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004873, "chapter_id": 1096, "verse_number": "१-९७-१३", "content_sanskrit": "आकारेण च रूपेण शरीरेणापि तेजसा।\nदुष्यन्तेन समो ह्येष कस्य पुत्रो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004874, "chapter_id": 1096, "verse_number": "१-९७-१४", "content_sanskrit": "एवं ब्रुवन्तस्ते सर्वे प्रशशंसुः सहस्रशः।\nयुक्तिवादानवोचन्त सर्वाः प्राणभृतः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004875, "chapter_id": 1096, "verse_number": "१-९७-१५", "content_sanskrit": "बान्धवा इव सस्नेहा अनुजग्मुः शकुन्तलाम्।\nपौराणां तद्वचः श्रुत्वा तूष्णींभूता शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004876, "chapter_id": 1096, "verse_number": "१-९७-१६", "content_sanskrit": "वेश्मद्वारं समासाद्य विह्वला सा नृपात्मजा।\nचिन्तयामास सहसा कार्यगौरवकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004877, "chapter_id": 1096, "verse_number": "१-९७-१७", "content_sanskrit": "लज्जया च परीताङ्गी राजन्राजसमक्षतः।\nअघृणा किं नु वक्ष्यामि दुष्यन्तं मम कारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004878, "chapter_id": 1096, "verse_number": "१-९७-१८", "content_sanskrit": "एवमुक्त्वा तु कृपणा चिन्तयन्ती शकुन्तला।\nअभिसृत्य च राजानं वेदिता सा प्रवेशिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004879, "chapter_id": 1096, "verse_number": "१-९७-१९", "content_sanskrit": "सह तेन कुमारेण तरुणादित्यवर्चसा।\nसिंहासनस्थं राजानं महेन्द्रसदृशद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004880, "chapter_id": 1096, "verse_number": "१-९७-२०", "content_sanskrit": "शकुन्तला नतशिराः परं हर्षमवाप्य च।\nपूजयित्वा यथान्यायमब्रवीत्तं शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004881, "chapter_id": 1096, "verse_number": "१-९७-२१", "content_sanskrit": "अभिवादय राजानं पितरं ते दृढव्रतम्।\nएवमुक्त्वा सुतं तत्र लज्जानतमुखी स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004882, "chapter_id": 1096, "verse_number": "१-९७-२२", "content_sanskrit": "स्तम्भमालिङ्ग्य राजानं प्रसीदस्वेत्युवाच सा।\nशाकुन्तलोपि राजानमभिवाद्य कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004883, "chapter_id": 1096, "verse_number": "१-९७-२३", "content_sanskrit": "हर्षेणोत्फुल्लनयनो राजानं चान्ववैक्षत।\nदुष्यन्तो धर्मबुद्ध्या तु चिन्तयन्नेव सोब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004884, "chapter_id": 1096, "verse_number": "१-९७-२४", "content_sanskrit": "किमागमनकार्यं ते ब्रूहि त्वं वरवर्णिनि।\nकरिष्यामि न संदेहः सपुत्राया विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004885, "chapter_id": 1096, "verse_number": "१-९७-२५x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004886, "chapter_id": 1096, "verse_number": "१-९७-२५", "content_sanskrit": "प्रसीदस्व महाराज वक्ष्यामि पुरुषोत्तम।\nएष पुत्रो हि ते राजन्मय्युत्पन्नः परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004887, "chapter_id": 1096, "verse_number": "१-९७-२६", "content_sanskrit": "तस्मात्पुत्रस्त्वया राजन्यौवराज्येऽभिषिच्यताम्।\nयथोक्तमाश्रमे तस्मिन्वर्तस्व पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004888, "chapter_id": 1096, "verse_number": "१-९७-२७", "content_sanskrit": "मया समागमे पूर्वं कृतः स समयस्त्वया।\nतत्त्वं स्मर महाबाहो कण्वाश्रमपदं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004889, "chapter_id": 1096, "verse_number": "१-९७-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004890, "chapter_id": 1096, "verse_number": "१-९७-२८", "content_sanskrit": "तस्योपभोगसक्तस्य स्त्रीषु चान्यासु भारत।\nशकुन्तला सपुत्रा च मनस्यन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004891, "chapter_id": 1096, "verse_number": "१-९७-२९", "content_sanskrit": "स धारयन्मनस्येनां सपुत्रां सस्मितां तदा।\nतदोपगृह्य मनसा चिरं सुखमवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004892, "chapter_id": 1096, "verse_number": "१-९७-३०", "content_sanskrit": "सोऽथ श्रुत्वापि तद्वाक्यं तस्या राजा स्मरन्नपि।\nअब्रवीन्न स्मरामीति त्वया भद्रे समागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004893, "chapter_id": 1096, "verse_number": "१-९७-३१", "content_sanskrit": "मैथुनं च वृथा नाहं गच्छेयमिति मे मतिः।\nनाभिजानामि कल्याणि त्वया सह समागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004894, "chapter_id": 1096, "verse_number": "१-९७-३२", "content_sanskrit": "धर्मार्थकामसंबन्धं न स्मरामि त्वया सह।\nगच्छ वा तिष्ठ वा कामं यद्वापीच्छसि तत्कुरु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004895, "chapter_id": 1096, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि सप्तनवतितमोऽध्यायः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]