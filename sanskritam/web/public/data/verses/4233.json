[{"id": 2149411, "chapter_id": 4233, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149412, "chapter_id": 4233, "verse_number": "१", "content_sanskrit": "सुदक्षिणस्तु काम्भोजो रथ एकगुणो मतः ।\nतवार्थसिद्धिमाकाङ्क्षन् योत्स्यते समरे परैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149413, "chapter_id": 4233, "verse_number": "२", "content_sanskrit": "एतस्य रथसिंहस्य तवार्थे राजसत्तम ।\nपराक्रमं यथेन्द्रस्य द्रक्ष्यन्ति कुरवो युधि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149414, "chapter_id": 4233, "verse_number": "३", "content_sanskrit": "एतस्य रथवंशे हि तिग्मवेगप्रहारिणः ।\nकाम्भोजानां महाराज शलभानामिवाततिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149415, "chapter_id": 4233, "verse_number": "४", "content_sanskrit": "नीलो माहिष्मतीवासी नीलवर्मा रथस्तव ।\nरथवंशेन कदनं शत्रूणां वै करिष्यति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149416, "chapter_id": 4233, "verse_number": "५", "content_sanskrit": "कृतवैरः सदा चैव सहदेवेन पार्थिव ।\nयोत्स्यते सततं राजन् तवार्थे कुरुनन्दन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149417, "chapter_id": 4233, "verse_number": "६", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ समेतौ रथसत्तमौ ।\nकृतिनौ समरे तात दृढवीर्यपराक्रमौ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149418, "chapter_id": 4233, "verse_number": "७", "content_sanskrit": "एतौ तौ पुरुषव्याघ्रौ रिपुसैन्यं प्रधक्ष्यतः ।\nगदाप्रासासिनाराचैः तोमरैश्च करच्युतैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149419, "chapter_id": 4233, "verse_number": "८", "content_sanskrit": "युद्धाभिकामौ समरे क्रीडन्ताविव यूथपौ ।\nयूथमध्ये महाराज विचरन्तौ कृतान्तवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149420, "chapter_id": 4233, "verse_number": "९", "content_sanskrit": "त्रिगर्ता भ्रातरः पञ्च रथोदारा मता मम ।\nकृतवैराश्च पार्थेन विराटनगरे तदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149421, "chapter_id": 4233, "verse_number": "१०", "content_sanskrit": "मकरा इव राजेन्द्र समुद्धूततरङ्गिणीम् ।\nगङ्गामिव क्षोभयन्ति पार्थानां युधि वाहिनीम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149422, "chapter_id": 4233, "verse_number": "११", "content_sanskrit": "ते रथाः पञ्च राजेन्द्र तेषां सत्यरथो मुखम् ।\nएते योत्स्यन्ति सङ्ग्रामे संस्मरन्तः पुराकृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149423, "chapter_id": 4233, "verse_number": "१२", "content_sanskrit": "व्यलीकं पाण्डवेयेन भीमसेनानुजेन ह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149424, "chapter_id": 4233, "verse_number": "१३", "content_sanskrit": "दिशो विजयता राजन् श्वेतवाहेन भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149425, "chapter_id": 4233, "verse_number": "१४", "content_sanskrit": "ते हनिष्यन्ति सेनां तां समासाद्य महारथान् ।\nपरान् वरान् महेष्वासान् क्षत्रियाणां धुरन्धरान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149426, "chapter_id": 4233, "verse_number": "१५", "content_sanskrit": "लक्षणस्तव पुत्रस्तु तथा दुःशासनस्य च ।\nउभौ तौ पुरुषव्याघ्रौ समरेष्वनिवर्तिनौ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149427, "chapter_id": 4233, "verse_number": "१६", "content_sanskrit": "तरुणौ सुकुमारौ च राजपुत्रौ यशस्विनौ ।\nयुद्धानां च विशेषज्ञौ प्रणेतारौ च सर्वशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149428, "chapter_id": 4233, "verse_number": "१७", "content_sanskrit": "रथिनौ रथशार्दूल मतौ मे रथसत्तमौ ।\nक्षत्रधर्मरतौ वीरौ महत् कर्म करिष्यतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149429, "chapter_id": 4233, "verse_number": "१८", "content_sanskrit": "दण्डधारो महाराज रथ एको नरर्षभ ।\nयोत्स्यते तव सङ्ग्रामे स्वेन सैन्येन पालितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149430, "chapter_id": 4233, "verse_number": "१९", "content_sanskrit": "बृहद्बलस्तथा राजा कौसल्यो रथसत्तमः ।\nरथो मम मतस्तात महावेगपराक्रमः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149431, "chapter_id": 4233, "verse_number": "२०", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे स्वां चमूं सम्प्रहर्षयन् ।\nउग्रायुधो महेष्वासो धार्तराष्ट्रहिते रतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149432, "chapter_id": 4233, "verse_number": "२१", "content_sanskrit": "कृपः शारद्वतो राजन् रथयूथपयूथपः ।\nप्रियान् प्राणान् परित्यज्य प्रधक्ष्यति रिपूंस्तव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149433, "chapter_id": 4233, "verse_number": "२२", "content_sanskrit": "गौतमस्य महर्षेस्तु आचार्यस्य शरद्वतः ।\nकार्तिकेय इवाजेयः शरस्तम्बात् सुतो बभौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149434, "chapter_id": 4233, "verse_number": "२३", "content_sanskrit": "एष(?) सेना बहुविधा विविधायुधकार्मुकाः(?) ।\nअग्निवत् समरे राजन् चरिष्यति विमर्दयन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149435, "chapter_id": 4233, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुःषष्ट्युत्तरशततमोऽध्यायः ॥१६४॥\nरथातिरथसङ्ख्यानपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]