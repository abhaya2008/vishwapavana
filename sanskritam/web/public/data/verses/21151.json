[{"id": 7001151000, "chapter_id": 21151, "verse_number": "२-२-४२-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nश्रीब्रह्मेशप्रजेशेन सदैव मुनिना च वै ।\nअनुनीतश्शंभुरासीत्प्रसन्नः परमेश्वरः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001151001, "chapter_id": 21151, "verse_number": "२-२-४२-२", "content_sanskrit": "आश्वास्य देवान् विष्ण्वादीन्विहस्य करुणानिधिः ।\nउवाच परमेशानः कुर्वन् परमनुग्रहम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001151002, "chapter_id": 21151, "verse_number": "२-२-४२-३", "content_sanskrit": "श्रीमहादेव उवाच ।\nशृणुतं सावधानेन मम वाक्यं सुरोत्तमौ ।\nयथार्थं वच्मि वां तात वां क्रोधं सर्वदासहम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001151003, "chapter_id": 21151, "verse_number": "२-२-४२-४", "content_sanskrit": "नाघं तनौ तु बालानां वर्णमेवानुचिंतये ।\nमम मायाभिभूतानां दंडस्तत्र धृतो मया॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001151004, "chapter_id": 21151, "verse_number": "२-२-४२-५", "content_sanskrit": "दक्षस्य यज्ञभंगोयं न कृतश्च मया क्वचित् ।\nपरं द्वेष्टि परेषां यदात्मनस्तद्भविष्यति॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001151005, "chapter_id": 21151, "verse_number": "२-२-४२-६", "content_sanskrit": "परेषां क्लेदनं कर्म न कार्यं तत्कदाचन ।\nपरं द्वेष्टि परेषां यदात्मनस्तद्भविष्यति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001151006, "chapter_id": 21151, "verse_number": "२-२-४२-७", "content_sanskrit": "दक्षस्य यज्ञशीर्ष्णो हि भवत्वजमुखं शिरः ।\nमित्रनेत्रेण संपश्येद्यज्ञभागं भगस्सुरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001151007, "chapter_id": 21151, "verse_number": "२-२-४२-८", "content_sanskrit": "पूषाभिधस्सुरस्तातौ दद्भिर्यज्ञसुपिष्टभुक् ।\nयाजमानैर्भग्नदंतस्सत्यमेतन्मयोदितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001151008, "chapter_id": 21151, "verse_number": "२-२-४२-९", "content_sanskrit": "बस्तश्मश्रुर्भवेदेव भृगुर्मम विरोध कृत् ।\nदेवाः प्रकृतिसर्वांगा ये म उच्छेदनं ददुः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001151009, "chapter_id": 21151, "verse_number": "२-२-४२-१०", "content_sanskrit": "बाहुभ्यामश्विनौ पूष्णो हस्ताभ्यां कृतवाहकौ ।\nभवंत्वध्वर्यवश्चान्ये भवत्प्रीत्या मयोदितम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001151010, "chapter_id": 21151, "verse_number": "२-२-४२-११", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्त्वा परमेशानो विरराम दयान्वितः ।\nचराचरपतिर्देवः सम्राट् वेदानुसारकृत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001151011, "chapter_id": 21151, "verse_number": "२-२-४२-१२", "content_sanskrit": "तदा सर्व सुराद्यास्ते श्रुत्वा शंकरभाषितम् ।\nसाधुसाध्विति संप्रोचुः परितुष्टाः सविष्ण्वजाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001151012, "chapter_id": 21151, "verse_number": "२-२-४२-१३", "content_sanskrit": "ततश्शंभुं समामंत्र्य मया विष्णुस्सुरर्षिभिः ।\nभूयस्तद्देवयजनं ययौ च परया मुदा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001151013, "chapter_id": 21151, "verse_number": "२-२-४२-१४", "content_sanskrit": "एवं तेषां प्रार्थनया विष्णुप्रभृतिभिस्सुरैः ।\nययौ कनखलं शंभुर्यज्ञवाटं प्रजापतेः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001151014, "chapter_id": 21151, "verse_number": "२-२-४२-१५", "content_sanskrit": "रुद्रस्तदा ददर्शाथ वीरभद्रेण यत्कृतम् ।\nप्रध्वंसं तं क्रतोस्तत्र देवर्षीणां विशेषतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001151015, "chapter_id": 21151, "verse_number": "२-२-४२-१६", "content_sanskrit": "स्वाहा स्वधा तथा पूषा तुष्टिर्धृतिः सरस्वती ।\nतथान्ये ऋषयस्सर्वे पितरश्चाग्नयस्तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001151016, "chapter_id": 21151, "verse_number": "२-२-४२-१७", "content_sanskrit": "येऽन्ये च बहवस्तत्र यक्षगंधवर्राक्षसाः ।\nत्रोटिता लुंचिताश्चैव मृताः केचिद्रणाजिरे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001151017, "chapter_id": 21151, "verse_number": "२-२-४२-१८", "content_sanskrit": "यज्ञं तथाविधं दृष्ट्वा समाहूय गणाधिपम् ।\nवीरभद्रं महावीरमुवाच प्रहसन् प्रभुः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001151018, "chapter_id": 21151, "verse_number": "२-२-४२-१९", "content_sanskrit": "वीरभद्र महाबाहो किं कृतं कर्म ते त्विदम् ।\nमहान्दंडो धृतस्तात देवर्ष्यादिषु सत्वरम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001151019, "chapter_id": 21151, "verse_number": "२-२-४२-२०", "content_sanskrit": "दक्षमानय शीघ्रं त्वं येनेदं कृतमीदृशम् ।\nयज्ञो विलक्षणस्तात यस्येदं फलमीदृशम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001151020, "chapter_id": 21151, "verse_number": "२-२-४२-२१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nएवमुक्तश्शंकरेण वीरभद्रस्त्वरान्वितः ।\nकबंधमानयित्वाग्रे तस्य शंभोरथाक्षिपत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001151021, "chapter_id": 21151, "verse_number": "२-२-४२-२२", "content_sanskrit": "विशिरस्कं च तं दृष्ट्वा शंकरो लोकशंकरः ।\nवीरभद्रमुवाचाग्रे विहसन्मुनिसत्तम॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001151022, "chapter_id": 21151, "verse_number": "२-२-४२-२३", "content_sanskrit": "शिरः कुत्रेति तेनोक्ते वीरभद्रोऽब्रवीत्प्रभुः ।\nमया शिरो हुतं चाग्नौ तदानीमेव शंकर॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001151023, "chapter_id": 21151, "verse_number": "२-२-४२-२४", "content_sanskrit": "इति श्रुत्वा वचस्तस्य वीरभद्रस्य शंकरः ।\nदेवान् तथाज्ञपत्प्रीत्या यदुक्तं तत्पुरा प्रभुः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001151024, "chapter_id": 21151, "verse_number": "२-२-४२-२५", "content_sanskrit": "विधाय कार्त्स्न्येन च तद्यदाह भगवान् भवः ।\nमया विष्ण्वादयः सर्वे भृग्वादीनथ सत्वरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001151025, "chapter_id": 21151, "verse_number": "२-२-४२-२६", "content_sanskrit": "अथ प्रजापतेस्तस्य सवनीयपशोश्शिरः ।\nबस्तस्य संदधुश्शंभोः कायेनारं सुशासनात्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001151026, "chapter_id": 21151, "verse_number": "२-२-४२-२७", "content_sanskrit": "संधीयमाने शिरसि शंभुसद्दृष्टिवीक्षितः ।\nसद्यस्सुप्त इवोत्तस्थौ लब्धप्राणः प्रजापतिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001151027, "chapter_id": 21151, "verse_number": "२-२-४२-२८", "content_sanskrit": "उत्थितश्चाग्रतश्शंभुं ददर्श करुणानिधिम् ।\nदक्षः प्रीतमतिः प्रीत्या संस्थितः सुप्रसन्नधीः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001151028, "chapter_id": 21151, "verse_number": "२-२-४२-२९", "content_sanskrit": "पुरा हर महाद्वेषकलिलात्माभवद्धि सः ।\nशिवावलोकनात्सद्यश्शरच्चन्द्र इवामलः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001151029, "chapter_id": 21151, "verse_number": "२-२-४२-३०", "content_sanskrit": "भवं स्तोतुमना सोथ नाशक्नोदनुरागतः ।\nउत्कंठाविकलत्वाच्च संपरेतां सुतां स्मरन्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001151030, "chapter_id": 21151, "verse_number": "२-२-४२-३१", "content_sanskrit": "अथ दक्षः प्रसन्नात्मा शिवं लज्जासमन्वितः ।\nतुष्टाव प्रणतो भूत्वा शंकरं लोकशंकरम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001151031, "chapter_id": 21151, "verse_number": "२-२-४२-३२", "content_sanskrit": "दक्ष उवाच ।\nनमामि देव वरदं वरेण्यं महेश्वरं ज्ञाननिधिं सनातनम् ।\nनमामि देवाधिपतीश्वरं हरं सदासुखाढ्यं जगदेकबांधवम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001151032, "chapter_id": 21151, "verse_number": "२-२-४२-३३", "content_sanskrit": "नमामि विश्वेश्वर विश्वरूपं पुरातनं ब्रह्मनिजात्मरूपम् ।\nनमामि शर्वं भव भावभावं परात्परं शंकरमानतोमि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001151033, "chapter_id": 21151, "verse_number": "२-२-४२-३४", "content_sanskrit": "देवदेव महादेव कृपां कुरु नमोस्तु ते ।\nअपराधं क्षमस्वाद्य मम शंभो कृपानिधे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001151034, "chapter_id": 21151, "verse_number": "२-२-४२-३५", "content_sanskrit": "अनुग्रहः कृतस्ते हि दंडव्याजेन शंकर ।\nखलोहं मूढधीर्देव ज्ञातं तत्त्वं मया न ते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001151035, "chapter_id": 21151, "verse_number": "२-२-४२-३६", "content_sanskrit": "अद्य ज्ञातं मया तत्त्वं सर्वोपरि भवान्मतः ।\nविष्णुब्रह्मादिभिस्सेव्यो वेदवेद्यो महेश्वरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001151036, "chapter_id": 21151, "verse_number": "२-२-४२-३७", "content_sanskrit": "साधूनां कल्पवृक्षस्त्वं दुष्टानां दंडधृक्सदा ।\nस्वतंत्रः परमात्मा हि भक्ताभीष्टवरप्रदः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001151037, "chapter_id": 21151, "verse_number": "२-२-४२-३८", "content_sanskrit": "विद्यातपोव्रतधरानसृजः प्रथमं द्विजा ।\nआत्मतत्त्वं समावेत्तुं मुखतः परमेश्वरः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001151038, "chapter_id": 21151, "verse_number": "२-२-४२-३९", "content_sanskrit": "सर्वापद्भ्यः पालयिता गोपतिस्तु पशूनिव ।\nगृहीतदंडो दुष्टांस्तान् मर्यादापरिपालकः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001151039, "chapter_id": 21151, "verse_number": "२-२-४२-४०", "content_sanskrit": "मया दुरुक्तविशिखैः प्रविद्धः परमेश्वरः ।\nअमरानतिदीनाशान् मदनुग्रहकारकः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001151040, "chapter_id": 21151, "verse_number": "२-२-४२-४१", "content_sanskrit": "स भवान् भगवान् शंभो दीनबंधो परात्परः ।\nस्वकृतेन महार्हेण संतुष्टो भक्तवत्सल॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001151041, "chapter_id": 21151, "verse_number": "२-२-४२-४२", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइति स्तुत्वा महेशानं शंकरं लोकशंकरम् ।\nप्रजापतिर्विनीतात्मा विरराम महाप्रभुम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001151042, "chapter_id": 21151, "verse_number": "२-२-४२-४३", "content_sanskrit": "अथ विष्णुः प्रसन्नात्मा तुष्टाव वृषभध्वजम् ।\nबाष्पगद्गदया वाण्या सुप्रणम्य कृतांजलिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001151043, "chapter_id": 21151, "verse_number": "२-२-४२-४४", "content_sanskrit": "विष्णुवाच ।\nमहादेव महेशान लोकानुग्रहकारक ।\nपरब्रह्म परात्मा त्वं दीनबंधो दयानिधे॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001151044, "chapter_id": 21151, "verse_number": "२-२-४२-४५", "content_sanskrit": "सर्वव्यापी स्वैरवर्ती वेदवेद्ययशाः प्रभोः ।\nअनुग्रहः कृतस्तेन कृताश्चासुकृता वयम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001151045, "chapter_id": 21151, "verse_number": "२-२-४२-४६", "content_sanskrit": "दक्षोयं मम भक्तस्त्वां यन्निनिंद खलः पुरा ।\nतत् क्षंतव्यं महेशाद्य निर्विकारो यतो भवान्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001151046, "chapter_id": 21151, "verse_number": "२-२-४२-४७", "content_sanskrit": "कृतो मयापराधोपि तव शंकर मूढतः ।\nत्वद्गणेन कृतं युद्धं वीरभद्रेण पक्षतः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001151047, "chapter_id": 21151, "verse_number": "२-२-४२-४८", "content_sanskrit": "त्वं मे स्वामी परब्रह्म दासोहं ते सदाशिव ।\nपोष्यश्चापि सदा ते हि सर्वेषां त्वं पिता यतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001151048, "chapter_id": 21151, "verse_number": "२-२-४२-४९", "content_sanskrit": "ब्रह्मोवाच ।\nदेवदेव महादेव करुणासागर प्रभो ।\nस्वतंत्रः परमात्मा त्वं परमेशो द्वयोव्ययः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001151049, "chapter_id": 21151, "verse_number": "२-२-४२-५०", "content_sanskrit": "मम पुत्रोपरि कृतो देवानुग्रह ईश्वर ।\nस्वापमानमगणयन् दक्षयज्ञं समुद्धर॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001151050, "chapter_id": 21151, "verse_number": "२-२-४२-५१", "content_sanskrit": "प्रसन्नो भव देवेश सर्वशापान्निराकुरु ।\nसबोधः प्रेरकस्त्वं मे त्वमेवं विनिवारकः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001151051, "chapter_id": 21151, "verse_number": "२-२-४२-५२", "content_sanskrit": "इति स्तुत्वा महेशानं परमं च महामुने ।\nकृतांजलिपुटो भूत्वा विनम्रीकृतमस्तकः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001151052, "chapter_id": 21151, "verse_number": "२-२-४२-५३", "content_sanskrit": "अथ शक्रादयो देवा लोकपालास्सुचेतसः ।\nतुष्टुवुः शंकरं देवं प्रसन्नमुखपंकजम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001151053, "chapter_id": 21151, "verse_number": "२-२-४२-५४", "content_sanskrit": "ततः प्रसन्नमनसः सर्वे देवास्तथा परे ।\nसिद्धर्षयः प्रजेशाश्च तुष्टुवुः शंकरं मुदा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001151054, "chapter_id": 21151, "verse_number": "२-२-४२-५५", "content_sanskrit": "तथोपदेवनागाश्च सदस्या ब्राह्मणास्तथा ।\nप्रणम्य परया भक्त्या तुष्टुवुश्च पृथक् पृथक्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]