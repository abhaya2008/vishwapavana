[{"id": 2054384, "chapter_id": 2194, "verse_number": "७-१२१-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054385, "chapter_id": 2194, "verse_number": "७-१२१-१", "content_sanskrit": "सम्प्रद्य महत्सैन्यं यान्तं शैनेयमर्जुनम्।\nनिर्हीका मम ते पुत्राः किमकुर्वत सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054386, "chapter_id": 2194, "verse_number": "७-१२१-२", "content_sanskrit": "कथं वैषां तदा युद्धे धृतिरासीन्मुमूर्षताम्।\nशैनेयचरितं दृष्ट्वा यादृशं सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054387, "chapter_id": 2194, "verse_number": "७-१२१-३", "content_sanskrit": "किं नु वक्ष्यन्ति ते क्षात्रं सैन्यमध्ये पराजिताः।\nकथं नु सात्यकिर्युद्धे व्यतिक्रान्तो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054388, "chapter_id": 2194, "verse_number": "७-१२१-४", "content_sanskrit": "कथं च मम पुत्राणां जीवतां तत्र सञ्जय।\nशैनेयोऽभिययौ युद्धे तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054389, "chapter_id": 2194, "verse_number": "७-१२१-५", "content_sanskrit": "अत्यद्भुतमिदं तात त्वत्सकाशाच्छृणोम्यहम्।\nएकस्य बहुभिः सार्धं शत्रुभिस्तैर्महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054390, "chapter_id": 2194, "verse_number": "७-१२१-६", "content_sanskrit": "विपरीतमहं मन्ये मन्दभाग्यं सुतं प्रति।\nयत्रावध्यन्त समरे सात्वतेन महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054391, "chapter_id": 2194, "verse_number": "७-१२१-७", "content_sanskrit": "एकस्य हि न पर्याप्तं यत्सैन्यं तस्य सञ्जय।\nक्रुद्धस्य युयुधानस्य सर्वे तिष्ठन्तु पाण़्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054392, "chapter_id": 2194, "verse_number": "७-१२१-८", "content_sanskrit": "निर्जित्य समरे द्रोणं कृतिनं चित्रयोधिनम्।\nयथा पशुगणान्सिंहस्तद्वद्धन्ता सुतान्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054393, "chapter_id": 2194, "verse_number": "७-१२१-९", "content_sanskrit": "कृतवर्मादिभिः शूरैर्यत्तैर्बहुभिराहवे।\nयुयुधानो न शकितो हन्तुं यत्पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054394, "chapter_id": 2194, "verse_number": "७-१२१-१०", "content_sanskrit": "नैतदीदृशकं युद्धं कृतवांस्तत्र फल्गुनः।\nयादृशं कृतवान्युद्धं शिनेर्नप्ता महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054395, "chapter_id": 2194, "verse_number": "७-१२१-११x", "content_sanskrit": "स़ञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054396, "chapter_id": 2194, "verse_number": "७-१२१-११", "content_sanskrit": "तव दुर्मन्त्रिते राजन्दुर्योधनकृतेन च।\nशृणुष्वावहितो भूत्वा यत्ते वक्ष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054397, "chapter_id": 2194, "verse_number": "७-१२१-१२", "content_sanskrit": "ते पुनः सन्न्यवर्तन्त कृत्वा संशपथान्मिथः।\nपरां युद्धे मतिं क्रूरां तव पुत्रस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054398, "chapter_id": 2194, "verse_number": "७-१२१-१३", "content_sanskrit": "त्रीणि सादिसहस्राणि दुर्योधनपुरोगमाः।\nशककाम्भोजबालह्लीका यवनाः पारदास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054399, "chapter_id": 2194, "verse_number": "७-१२१-१४", "content_sanskrit": "कुलिन्दास्तङ्कणाम्बष्ठाः पैशाचाश्च सबर्बराः।\nपार्वतीयाश्च राजेन्द्र क्रुद्धाः पाषाणपाणयः।\nअभ्यद्रवन्त शैनेयं शलभाः पावकं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054400, "chapter_id": 2194, "verse_number": "७-१२१-१५", "content_sanskrit": "युक्ताश्च पार्वतीयानां रथाः पाषाणयोधिनाम्।\nशूराः पञ्चशतं राजञ्शैनेयं समुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054401, "chapter_id": 2194, "verse_number": "७-१२१-१६", "content_sanskrit": "ततो रथसहस्रेण महारथशतेन च।\nद्विरदानां सहस्रेण द्विसाहस्रैश्च वाजिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054402, "chapter_id": 2194, "verse_number": "७-१२१-१७", "content_sanskrit": "शरवर्षाणि मुञ्चन्तो विविधानि महारथाः।\nअभ्यद्रवन्त शैनेयमसङ्ख्येयाश्च पत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054403, "chapter_id": 2194, "verse_number": "७-१२१-१८", "content_sanskrit": "तांश्च सञ्चोदयन्सर्वान्घ्नतैनमिति भारत।\nदुःशासनो महाराज सात्यकिं पर्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054404, "chapter_id": 2194, "verse_number": "७-१२१-१९", "content_sanskrit": "तत्राद्भुतमपश्याम शैनेयचरितं महत्।\nयदेको बहुभिः सार्धमसम्भ्रान्तमयुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054405, "chapter_id": 2194, "verse_number": "७-१२१-२०", "content_sanskrit": "अवधीच्च रथानीकं द्विरदानां च तद्बलम्।\nसादिनश्चैव तान्सर्वान्दस्यूनपि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054406, "chapter_id": 2194, "verse_number": "७-१२१-२१", "content_sanskrit": "तत्र चक्रैर्विमथितैर्भग्नैश्च परमायुधैः।\nअक्षैश्च बहुधा भग्नैरीषादण्डकबन्धुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054407, "chapter_id": 2194, "verse_number": "७-१२१-२२", "content_sanskrit": "कुञ्जरैर्मथितैश्चापि ध्वजैश्च विनिपातितैः।\nवर्मभिश्च तथाऽनीकैर्व्यवकीर्णा वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054408, "chapter_id": 2194, "verse_number": "७-१२१-२३", "content_sanskrit": "स्रग्भिराभरणैर्वस्त्रैरनुकर्षैश्च मारिष।\nसञ्छन्ना वसुधा तत्र द्यौर्ग्रहैरिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054409, "chapter_id": 2194, "verse_number": "७-१२१-२४", "content_sanskrit": "गिरिरूपधरैश्चापि पतितैश्च महागजैः।\n`म्लेच्छस्थितैर्महाराज भिन्नाञ्जनचयोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054410, "chapter_id": 2194, "verse_number": "७-१२१-२५", "content_sanskrit": "मृगैर्मन्द्रैश्च भद्रैश्च मृगमन्द्रैस्तथाऽपरैः।\nभद्रैर्मन्द्रमृगैश्चैव मृगभद्रैस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054411, "chapter_id": 2194, "verse_number": "७-१२१-२६", "content_sanskrit": "भद्रमन्द्रैश्चैव तथा तथा भद्रमृगैरपि।\nतत्रतत्र धरा कीर्णा शयानैः पर्वतोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054412, "chapter_id": 2194, "verse_number": "७-१२१-२७", "content_sanskrit": "अञ्जनस्य कुले जाता वामनस्य च भारत।\nसुप्रतीककुले जाता महापद्मकुले तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054413, "chapter_id": 2194, "verse_number": "७-१२१-२८", "content_sanskrit": "ऐरावतकुले चैव तथाऽन्येषु कुलेषु च।\nजाता दन्तिवरा राजञ्शेरते बहवो हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054414, "chapter_id": 2194, "verse_number": "७-१२१-२९", "content_sanskrit": "वनायुजान्पार्वतीयान्काम्भोजान्बाह्लिकानपि।\nतथा हयवरान्राजन्निजघ्ने तत्र सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054415, "chapter_id": 2194, "verse_number": "७-१२१-३०", "content_sanskrit": "नानादेशसमुत्थांश्च नानाजातींश्च दन्तिनः।\nनिजघ्ने तत्र शैनेयः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054416, "chapter_id": 2194, "verse_number": "७-१२१-३१", "content_sanskrit": "तेषु प्रकाल्यमानेषु दस्यून्दुःशासनोऽब्रवीत्।\nनिवर्तध्वमधर्मज्ञा युध्यध्वं किं सृतेन वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054417, "chapter_id": 2194, "verse_number": "७-१२१-३२", "content_sanskrit": "तांश्चातिभग्नासन्सम्प्रेक्ष्य पुत्रो दुःशासनस्तव।\nपाषाणयोधिनः शूरान्पार्वतीयानचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054418, "chapter_id": 2194, "verse_number": "७-१२१-३३", "content_sanskrit": "अश्मयुद्धेषु कुशला नैतञ्जानापि सात्यकिः।\nअश्मयुद्धमजानन्तं हतैनं युद्धकामुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054419, "chapter_id": 2194, "verse_number": "७-१२१-३४", "content_sanskrit": "तथैव कुरवः सर्वे नाश्मयुद्धविशारदाः।\nअभिद्रवत माभैष्ट न वः प्राप्स्यति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054420, "chapter_id": 2194, "verse_number": "७-१२१-३५", "content_sanskrit": "ते पार्वतीया राजानः सर्वे पाषाणयोधिनः।\nअभ्यद्रवन्त शैनेयं राजानमिव मन्त्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054421, "chapter_id": 2194, "verse_number": "७-१२१-३६", "content_sanskrit": "ततो गजशिरःप्रख्यैरुपलैः शैलवासिनः।\nउद्यतैर्युयुधानस्य पुरतस्तस्थुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054422, "chapter_id": 2194, "verse_number": "७-१२१-३७", "content_sanskrit": "क्षेरणीयैस्तथाप्यन्ये सात्वतस्य वधैषिणः।\nचोदितास्तव पुत्रेण सर्वतो रुरुधुर्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054423, "chapter_id": 2194, "verse_number": "७-१२१-३८", "content_sanskrit": "तेषामापततामेव शिलायुद्धं चिकीर्षताम्।\nसात्यकिः प्रतिसन्धाय निशितान्प्राहिणोच्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054424, "chapter_id": 2194, "verse_number": "७-१२१-३९", "content_sanskrit": "तामश्मवृष्टिं तुमुलां पार्वतीयैः समीरिताम्।\nचिच्छेदोरगसंकाशैर्नाराचैः शिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054425, "chapter_id": 2194, "verse_number": "७-१२१-४०", "content_sanskrit": "तैरश्मचूर्णैर्दीप्यद्भिः खद्योतानामिव व्रजैः।\nप्रायः सैन्यान्यहन्यन्त हाहाभूतानि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054426, "chapter_id": 2194, "verse_number": "७-१२१-४१", "content_sanskrit": "ततः पञ्चशतं शूराः समुद्यतमहाशिलाः।\nनिकृत्तबाहवो राजन्निपेतुर्धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054427, "chapter_id": 2194, "verse_number": "७-१२१-४२", "content_sanskrit": "सात्वतस्य च भल्लेन निष्पिष्टैस्तैस्तथाऽद्रिभिः।\nन्यपतन्निहता म्लेच्छास्तत्रतत्र गतासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054428, "chapter_id": 2194, "verse_number": "७-१२१-४३", "content_sanskrit": "ते हन्यमानाः समरे सात्वतेन महात्मना।\nअश्मवृष्टिं महाघोरां पातयन्ति स्म सात्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054429, "chapter_id": 2194, "verse_number": "७-१२१-४४", "content_sanskrit": "पाषाणयोधिनः शूरान्यतमानानवस्थितान्।\nन्यवधीद्बहुसाहस्रांस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054430, "chapter_id": 2194, "verse_number": "७-१२१-४५", "content_sanskrit": "ततः पुनर्बस्तमुखैरश्मवृष्टीः समन्ततः।\nअधोबस्तैः स्थूलबस्तैर्दरदैः खसतङ्कणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054431, "chapter_id": 2194, "verse_number": "७-१२१-४६", "content_sanskrit": "लम्बकैश्च कुणिन्दैश्च क्षिप्ताः क्षिप्ताश्च सात्यकिः।\nनाराचैः प्रतिचिच्छेद प्रतिपत्तिविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054432, "chapter_id": 2194, "verse_number": "७-१२१-४७", "content_sanskrit": "अद्रीणां भिद्यमानानामन्तरिक्षे शितैः शरैः।\nशब्देन प्राद्रवन्सङ्ख्ये रथाश्वगजपत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054433, "chapter_id": 2194, "verse_number": "७-१२१-४८", "content_sanskrit": "अश्मचूर्णैरवाकीर्णा मनुष्यगजवाजिनः।\nनाशक्नुवन्नवस्थातुं भ्रमरैरिव दंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054434, "chapter_id": 2194, "verse_number": "७-१२१-४९", "content_sanskrit": "हतशिष्टाः सरुधिरा भिन्नमस्तकपिण़्डिकाः।\n`विभिन्नशिरसो राजन्दन्तैश्छिन्नैश्च दन्तिनः।\nनिर्धूतैश्च करैर्नागा व्यङ्गाश्च शतशः कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054435, "chapter_id": 2194, "verse_number": "७-१२१-५०", "content_sanskrit": "हत्वा पञ्चशतं योधांस्तत्क्षणेनैव मारिष।\nव्यचरत्पृतनामध्ये शैनेयः कृतहस्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054436, "chapter_id": 2194, "verse_number": "७-१२१-५१", "content_sanskrit": "कुञ्जराः सन्न्यवर्तन्त युयुधानेन मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054437, "chapter_id": 2194, "verse_number": "७-१२१-५२", "content_sanskrit": "अश्मनां भिद्यमानानां सायकैः श्रूयते ध्वनिः।\nपद्मपत्रेषुधाराणां पतन्तीनामिव ध्वनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054438, "chapter_id": 2194, "verse_number": "७-१२१-५३", "content_sanskrit": "ततः शब्दः समभवत्तव सैन्यस्य मारिष।\nमाधवेनार्द्यमानस्य सागरस्येव पर्वणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054439, "chapter_id": 2194, "verse_number": "७-१२१-५४", "content_sanskrit": "तं शब्दं तुमुलं श्रुत्वा द्रोणो यन्तारमब्रवीत्।\nएष सूत रणे क्रुद्धः सात्वतानां महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054440, "chapter_id": 2194, "verse_number": "७-१२१-५५", "content_sanskrit": "दारयन्बहुधा सैन्यं रणे चरति कालवत्।\nयत्रैष शब्दस्तुमुलस्तत्र सूत रथं नय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054441, "chapter_id": 2194, "verse_number": "७-१२१-५६", "content_sanskrit": "पाषाणयोधिभिर्नूनं युयुधानः समागतः।\nतथाहि रथिनः सर्वे हियन्ते विद्रुतैर्हयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054442, "chapter_id": 2194, "verse_number": "७-१२१-५७", "content_sanskrit": "विशस्त्रकवचा रुग्णास्तत्रतत्र पतन्ति च।\nन शक्नुवन्ति यन्तारः संयन्तुं तुमुले हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2054443, "chapter_id": 2194, "verse_number": "७-१२१-५८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2054444, "chapter_id": 2194, "verse_number": "७-१२१-५८", "content_sanskrit": "इत्येतद्वचनं श्रुत्वा भारद्वाजस्य सारथिः।\nप्रत्युवाच ततो द्रोणं सर्वशस्त्रभृतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2054445, "chapter_id": 2194, "verse_number": "७-१२१-५९", "content_sanskrit": "सैन्यं द्रवति चायुष्मन्कौरवेयं समन्ततः।\nपश्य योधान्रणे भग्नान्धावतो वै ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2054446, "chapter_id": 2194, "verse_number": "७-१२१-६०", "content_sanskrit": "इमे च संहताः शूराः पाञ्चालाः पाण्डवैः सह।\nत्वामेव हि जिघांसन्त आद्रवन्ति समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2054447, "chapter_id": 2194, "verse_number": "७-१२१-६१", "content_sanskrit": "अत्र कार्यं समाधत्स्व प्राप्तकालमरिन्दम।\nस्वाने वा गमने वापि दूरं यातश्च सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2054448, "chapter_id": 2194, "verse_number": "७-१२१-६२x", "content_sanskrit": "सञ्चय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2054449, "chapter_id": 2194, "verse_number": "७-१२१-६२", "content_sanskrit": "तथैवं वदतस्तस्य भारद्वाजस्य सारथेः।\nप्रत्यदृश्यत शैनेयो निघ्नन्बहुविधान्रथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2054450, "chapter_id": 2194, "verse_number": "७-१२१-६३", "content_sanskrit": "ते वध्यमानाः समरे युयुधानेन तावकाः।\nयुयुधानरथं त्यक्त्वा द्रोणानीकाय दुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2054451, "chapter_id": 2194, "verse_number": "७-१२१-६४", "content_sanskrit": "यैस्तु दुःशासनः सार्धं रथैः पूर्वं न्यवर्तत।\nते भीतास्त्वभ्यधावन्त सर्वे द्रोणरथं प्रति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2054452, "chapter_id": 2194, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकविंशत्यधिकशततमोऽध्यायः॥ १२१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२१-११ दुर्योधनस्य कृतेन कर्मणा॥ ५-१२१-१२ मतिं कृत्वेत्यन्वयः॥ ५-१२१-२५ मृगमन्द्रादयो गजविशेषाः॥ ५-१२१-२७ वामनस्य यमोपवाह्यस्य। सुप्रतीकस्य ईशोपवाह्यस्य। महापद्मस्य कुमुदस्य कुले॥ ५-१२१-२८ अन्येषु कुलेषु पुण्डरीकपुष्पदन्तसार्वभौमीयेषु॥ ५-१२१-३७ क्षेपणीयैः शस्त्रैः॥ ५-१२१-४५ ततः पुनर्व्यात्तमुखास्तेऽश्मवृष्टीः समन्ततः। अयोहस्ताः शूलहस्ता दरदास्तङ्कणाः खसाः। लम्पकाश्च कुलिन्दाश्च चिक्षिपुस्तांश्च सात्यकिः। इति झ.ञ.घ.पाठः॥ ५-१२१-४७ अद्रीणां प्रस्तराणाम्॥ ५-१२१-१२१ एकविंशत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]