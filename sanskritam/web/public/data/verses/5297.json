[{"id": 2201642, "chapter_id": 5297, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201643, "chapter_id": 5297, "verse_number": "१", "content_sanskrit": "केषां देवा महाभागाः सन्नमन्ते महात्मनाम् ।\nलोकेऽस्मिन् तानृषीन् सर्वान् श्रोतुमिच्छामि सत्तम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201644, "chapter_id": 5297, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201645, "chapter_id": 5297, "verse_number": "समाप्तिः", "content_sanskrit": "इतिहासमिमं विप्राः कीर्तयन्ति पुराविदः ।\nअस्मिन्नर्थे महाप्राज्ञास्तं निबोध युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201646, "chapter_id": 5297, "verse_number": "३", "content_sanskrit": "वृत्रं हत्वाऽप्युपावृत्तं त्रिदशानां पुरस्कृतम् ।\nमहेन्द्रमनुसम्प्राप्तं स्तूयमानं महर्षिभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201647, "chapter_id": 5297, "verse_number": "४", "content_sanskrit": "श्रिया परमया युक्तं रथस्थं हरिवाहनम् ।\nमातलिः प्राञ्जलिर्भूत्वा देवमिन्द्रमुवाच ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201648, "chapter_id": 5297, "verse_number": "५", "content_sanskrit": "नमस्कृतानां सर्वेषां भगवंस्त्वं पुरस्कृतः ।\nयेषां लोके नमस्कुर्यात् तान् ब्रवीतु भवान् मम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201649, "chapter_id": 5297, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201650, "chapter_id": 5297, "verse_number": "६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा देवराजः शचीपतिः ।\nयन्तारं परिपृच्छन्तं तमिन्द्रः प्रत्युवाच सः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201651, "chapter_id": 5297, "verse_number": "७", "content_sanskrit": "धर्मं चार्थं च कामं च येषां चिन्तयतां मतिः ।\nनाधर्मे वर्तते नित्यं तान् नमस्यामि मातले\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201652, "chapter_id": 5297, "verse_number": "८", "content_sanskrit": "ये रूपगुणसम्पन्नाः प्रमदाहृदयंगमाः ।\nनिवृत्ताः कामभोगेषु तान् नमस्यामि मातले\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201653, "chapter_id": 5297, "verse_number": "९", "content_sanskrit": "स्वेषु भोगेषु सन्तुष्टाः सुवाचो वचनक्षमाः ।\nअमानकामाश्चार्घार्हाः तान् नमस्यामि मातले\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201654, "chapter_id": 5297, "verse_number": "१०", "content_sanskrit": "धनं विद्यास्तथैश्वर्यं येषां न चलयेन्मतिम् ।\nचलितां ये निगृह्णन्ति तान् नित्यं पूजयाम्यहम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201655, "chapter_id": 5297, "verse_number": "११", "content_sanskrit": "इष्टैर्दारैरुपेतानां शुचीनामग्निहोत्रिणाम् ।\nचतुष्पादकुटुम्बानां मातले प्रणमाम्यहम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201656, "chapter_id": 5297, "verse_number": "१२", "content_sanskrit": "महतस्तपसा प्राप्तौ धनस्य विपुलस्य च ।\nत्यागस्तस्य न वै कार्यो योत्मानं नावबुध्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201657, "chapter_id": 5297, "verse_number": "१३", "content_sanskrit": "येषामर्थस्तथा कामो धर्ममूलविवर्धितः ।\nधर्मार्थौ तस्य नियतौ तान् नमस्यामि मातले \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201658, "chapter_id": 5297, "verse_number": "१४", "content_sanskrit": "धर्ममूलार्थकामानां ब्राह्मणानां गवामपि ।\nपतिव्रतानां नारीणां प्रणामं प्रकरोम्यहम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201659, "chapter_id": 5297, "verse_number": "१५", "content_sanskrit": "ये भुक्त्वा मानुषान् भोगान् पूर्वे वयसि मातले ।\nतपसा स्वर्गमायान्ति शश्वत् तान् पूजयाम्यहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201660, "chapter_id": 5297, "verse_number": "१६", "content_sanskrit": "असम्भोगान्न चासक्तान् धर्मनित्यान् जितेन्द्रियान्। सन्न्यस्तानचलप्रख्यान् मनसा पूजयामि तान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201661, "chapter_id": 5297, "verse_number": "", "content_sanskrit": "ज्ञानप्रसन्नविद्यानां निरूढं धर्ममीप्सितम् ।\nपरैः कीर्तितशौचानां मातले तान् नमाम्यहम्\t।१७॥।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201662, "chapter_id": 5297, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे अष्टचत्वारिंशोत्तरशततमोऽध्यायः ॥१४८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]