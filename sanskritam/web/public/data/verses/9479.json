[{"id": 5000479000, "chapter_id": 9479, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्विसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000479001, "chapter_id": 9479, "verse_number": "६-७२-१", "content_sanskrit": "अतिकायं हतं श्रुत्वा लक्ष्मणेन महात्मना।\nउद्वेगमगमद् राजा वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000479002, "chapter_id": 9479, "verse_number": "६-७२-२", "content_sanskrit": "धूम्राक्षः परमामर्षी सर्वशस्त्रभृतां वरः।\nअकम्पनः प्रहस्तश्च कुम्भकर्णस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000479003, "chapter_id": 9479, "verse_number": "६-७२-३", "content_sanskrit": "एते महाबला वीरा राक्षसा युद्धकाङ्क्षिणः।\nजेतारः परसैन्यानां परैर्नित्यापराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000479004, "chapter_id": 9479, "verse_number": "६-७२-४", "content_sanskrit": "ससैन्यास्ते हता वीरा रामेणाक्लिष्टकर्मणा।\nराक्षसाः सुमहाकाया नानाशस्त्रविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000479005, "chapter_id": 9479, "verse_number": "६-७२-५", "content_sanskrit": "अन्ये च बहवः शूरा महात्मानो निपातिताः।\nप्रख्यातबलवीर्येण पुत्रेणेन्द्रजिता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000479006, "chapter_id": 9479, "verse_number": "६-७२-६", "content_sanskrit": "तौ भ्रातरौ तदा बद्धौ घोरैर्दत्तवरैः शरैः।\nयन्न शक्यं सुरैः सर्वैरसुरैर्वा महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000479007, "chapter_id": 9479, "verse_number": "६-७२-७", "content_sanskrit": "मोक्तुं तद‍्बन्धनं घोरं यक्षगन्धर्वपन्नगैः।\nतन्न जाने प्रभावैर्वा मायया मोहनेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000479008, "chapter_id": 9479, "verse_number": "६-७२-८", "content_sanskrit": "शरबन्धाद् विमुक्तौ तौ भ्रातरौ रामलक्ष्मणौ।\nये योधा निर्गताः शूरा राक्षसा मम शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000479009, "chapter_id": 9479, "verse_number": "६-७२-९", "content_sanskrit": "ते सर्वे निहता युद्धे वानरैः सुमहाबलैः।\nतं न पश्याम्यहं युद्धे योऽद्य रामं सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000479010, "chapter_id": 9479, "verse_number": "६-७२-१०", "content_sanskrit": "नाशयेत् सबलं वीरं ससुग्रीवं विभीषणम्।\nअहो सुबलवान् रामो महदस्त्रबलं च वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000479011, "chapter_id": 9479, "verse_number": "६-७२-११", "content_sanskrit": "यस्य विक्रममासाद्य राक्षसा निधनं गताः।\nतं मन्ये राघवं वीरं नारायणमनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000479012, "chapter_id": 9479, "verse_number": "६-७२-१२", "content_sanskrit": "तद्भयाद्धि पुरी लङ्का पिहितद्वारतोरणा।\nअप्रमत्तैश्च सर्वत्र गुल्मे रक्ष्या पुरी त्वियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000479013, "chapter_id": 9479, "verse_number": "६-७२-१३", "content_sanskrit": "अशोकवनिका चैव यत्र सीताभिरक्ष्यते।\nनिष्क्रमो वा प्रवेशो वा ज्ञातव्यः सर्वदैव नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000479014, "chapter_id": 9479, "verse_number": "६-७२-१४", "content_sanskrit": "यत्र यत्र भवेद् गुल्मस्तत्र तत्र पुनः पुनः।\nसर्वतश्चापि तिष्ठध्वं स्वैः स्वैः परिवृता बलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000479015, "chapter_id": 9479, "verse_number": "६-७२-१५", "content_sanskrit": "द्रष्टव्यं च पदं तेषां वानराणां निशाचराः।\nप्रदोषे वार्धरात्रे वा प्रत्यूषे वापि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000479016, "chapter_id": 9479, "verse_number": "६-७२-१६", "content_sanskrit": "नावज्ञा तत्र कर्तव्या वानरेषु कदाचन।\nद्विषतां बलमुद्युक्तमापतत् किं स्थितं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000479017, "chapter_id": 9479, "verse_number": "६-७२-१७", "content_sanskrit": "ततस्ते राक्षसाः सर्वे श्रुत्वा लङ्काधिपस्य तत्।\nवचनं सर्वमातिष्ठन् यथावत् तु महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000479018, "chapter_id": 9479, "verse_number": "६-७२-१८", "content_sanskrit": "तान् सर्वान् हि समादिश्य रावणो राक्षसाधिपः।\nमन्युशल्यं वहन् दीनः प्रविवेश स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000479019, "chapter_id": 9479, "verse_number": "६-७२-१९", "content_sanskrit": "ततः स संदीपितकोपवह्नि-\nर्निशाचराणामधिपो महाबलः।\nतदेव पुत्रव्यसनं विचिन्तयन्\nमुहुर्मुहुश्चैव तदा विनिःश्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000479020, "chapter_id": 9479, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्विसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]