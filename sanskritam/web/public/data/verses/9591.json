[{"id": 5000591000, "chapter_id": 9591, "verse_number": "७-५६-१", "content_sanskrit": "रामस्य भाषितं श्रुत्वा लक्ष्मणः परवीरहा ।\nउवाच प्राञ्जलिर्वाक्यं राघवं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000591001, "chapter_id": 9591, "verse_number": "७-५६-२", "content_sanskrit": "निक्षिप्तदेहौ काकुत्स्य कथं तौ द्विजपार्थिवौ ।\nपुनर्देहेन संयोगं जग्मतुर्देवसम्मतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000591002, "chapter_id": 9591, "verse_number": "७-५६-३", "content_sanskrit": "लक्ष्मणेनैवमुक्तस्तु रामश्चेक्ष्वाकुनन्दनः ।\nप्रत्युवाच महातेजा लक्ष्मणं पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000591003, "chapter_id": 9591, "verse_number": "७-५६-४", "content_sanskrit": "तौ परस्परशापेन देहावुत्सृज्य धार्मिकौ ।\nअभूतां नृपविप्रर्षी वायुभूतौ तपोधनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000591004, "chapter_id": 9591, "verse_number": "७-५६-५", "content_sanskrit": "अशरीरः शरीरस्य कृते ऽन्यस्य महामुनिः ।\nवसिष्ठः सुमहातेजा जगाम पितुरन्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000591005, "chapter_id": 9591, "verse_number": "७-५६-६", "content_sanskrit": "सो ऽभिवाद्य ततः पादौ देवदेवस्य धर्मवित् ।\nपितामहमथोवाच वायुभूत इदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000591006, "chapter_id": 9591, "verse_number": "७-५६-७", "content_sanskrit": "भगवन्निमिशापेन विदेहत्वमुपागमम् ।\nलोकनाथ महादेव अण्डजो ऽपि त्वमब्जजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000591007, "chapter_id": 9591, "verse_number": "७-५६-८", "content_sanskrit": "सर्वेषां देहहीनानां महद्दुःखं भविष्यति ।\nलुप्यन्ते सर्वकार्यणि हीनदेहस्य वै प्रभो ।\nदेहस्यान्यस्य सद्भावे प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000591008, "chapter_id": 9591, "verse_number": "७-५६-९", "content_sanskrit": "तमुवाच ततो ब्रह्मा स्वयम्भूरमितप्रभः ।\nमित्रावरुणजं तेज प्रविश त्वं महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000591009, "chapter_id": 9591, "verse_number": "७-५६-१०", "content_sanskrit": "अयोनिजस्त्वं भविता तत्रापि द्विजसत्तम ।\nधर्मेण महता युक्तः पुनरेष्यसि मे वशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000591010, "chapter_id": 9591, "verse_number": "७-५६-११", "content_sanskrit": "एवमुक्तस्तु देवेन चाभिवाद्य प्रदक्षिणम् ।\nकृत्वा पितामहं तूर्णं प्रययौ वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000591011, "chapter_id": 9591, "verse_number": "७-५६-१२", "content_sanskrit": "तमेव कालं मित्रो ऽपि वरुणत्वमकारयत् ।\nक्षीरोदेन सहोपेतः पूज्यमानः सुरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000591012, "chapter_id": 9591, "verse_number": "७-५६-१३", "content_sanskrit": "एतस्मिन्नेव काले तु उर्वशी परमाप्सराः ।\nयदृच्छया तमुद्देशमाययौ सखिभिर्वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000591013, "chapter_id": 9591, "verse_number": "७-५६-१४", "content_sanskrit": "तां दृष्ट्वा रूपसम्पन्नां क्रीडन्तीं वरुणालये ।\nआविशत्परमो हर्षो वरुणं चोर्वशीकृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000591014, "chapter_id": 9591, "verse_number": "७-५६-१५", "content_sanskrit": "स तां पद्मपलाशाक्षीं पूर्णचन्द्रनिभाननाम् ।\nवरुणो वरयामास मैथुनायाप्सरोवराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000591015, "chapter_id": 9591, "verse_number": "७-५६-१६", "content_sanskrit": "प्रत्युवाच ततः सा तु वरुणं प्राञ्जलिः स्थिता ।\nमित्रेणाहं वृता साक्षात्पूर्वमेव सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000591016, "chapter_id": 9591, "verse_number": "७-५६-१७", "content_sanskrit": "वरुणस्त्वब्रवीद्वाक्यं कन्दर्पशरपीडितः ।\nइदं तेजः समुत्स्रक्ष्ये कुम्भे ऽस्मिन्देवनिर्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000591017, "chapter_id": 9591, "verse_number": "७-५६-१८", "content_sanskrit": "एवमुत्सृज्य सुश्रोणि त्वय्यहं वरवर्णिनि ।\nकृतकामो भविष्यामि यदि नेच्छसि सङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000591018, "chapter_id": 9591, "verse_number": "७-५६-१९", "content_sanskrit": "तस्य तल्लोकपालस्य वरुणस्य सुभाषितम् ।\nउर्वशी परमप्रीता श्रुत्वा वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000591019, "chapter_id": 9591, "verse_number": "७-५६-२०", "content_sanskrit": "काममेतद्भवत्वेवं हृदयं मे त्वयि स्थितम् ।\nभावश्चाप्यधिकस्तुभ्यं देहो मित्रस्य तु प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000591020, "chapter_id": 9591, "verse_number": "७-५६-२१", "content_sanskrit": "उर्वश्या एवमुक्तस्तु रेतस्तन्महदद्भुतम् ।\nज्वलदग्निशिखाप्रख्यं तस्मिन्कुम्भे ह्यपासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000591021, "chapter_id": 9591, "verse_number": "७-५६-२२", "content_sanskrit": "उर्वशी त्वगमत्तत्र मित्रो वै यत्र देवता ।\nतां तु मित्रः सुसङ्क्रम्य उर्वशीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000591022, "chapter_id": 9591, "verse_number": "७-५६-२३", "content_sanskrit": "मया निमन्त्रिता पूर्वं कस्मात्त्वमवसर्जिता ।\nपतिमन्यं वृतवती तस्मात्त्वं दुष्टचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000591023, "chapter_id": 9591, "verse_number": "७-५६-२४", "content_sanskrit": "अनेन दुष्कृतेन त्वं मत्क्रोधकलुषीकृता ।\nमनुष्यलोकमास्थाय कञ्चित्कालं निवत्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000591024, "chapter_id": 9591, "verse_number": "७-५६-२५", "content_sanskrit": "बुधस्य पुत्रो राजर्षिः काशीराजः पुरूरवाः ।\nतमद्य गच्छ दुर्बुद्धे स ते भर्ता भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000591025, "chapter_id": 9591, "verse_number": "७-५६-२६", "content_sanskrit": "ततः सा शापदोषेण पुरूरवसमभ्यगात् ।\nप्रतियाते पुरूरवं बुधस्यात्मजमौरसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000591026, "chapter_id": 9591, "verse_number": "७-५६-२७", "content_sanskrit": "तस्य जज्ञे ततः श्रीमानायुः पुत्रो महाबलः ।\nनहुषो यस्य पुत्रस्तु बभूवेन्द्रसमद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000591027, "chapter_id": 9591, "verse_number": "७-५६-२८", "content_sanskrit": "वज्रमुत्सृज्य वृत्राय भ्रान्ते ऽथ त्रिदिवेश्वरे ।\nशतं वर्षसहस्राणि येनेन्द्रत्वं प्रशासितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000591028, "chapter_id": 9591, "verse_number": "७-५६-२९", "content_sanskrit": "सा तेन शापेन जगाम भूमिं तदोर्वशी चारुदती सुनेत्रा ।\nबहूनि वर्षाण्यवसच्च सुभ्रूः शापक्षयादिन्द्रसदो ययौ च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000591029, "chapter_id": 9591, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]