[{"id": 6000243000, "chapter_id": 10243, "verse_number": null, "content_sanskrit": "अथ सप्तचत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000243001, "chapter_id": 10243, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.001.m4a", "display_order": 2}, {"id": 6000243002, "chapter_id": 10243, "verse_number": "१०-४७-१", "content_sanskrit": "अथ विज्ञाय भगवान् सर्वात्मा सर्वदर्शनः।\nसैरन्ध्य्राः कामतप्तायाः प्रितिं यच्छन् गृहं ययौ॥ १०/४७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेन त्रिवक्राया गृहगमनम्", "range": "१–११"}]}, {"id": 6000243003, "chapter_id": 10243, "verse_number": "१०-४७-२", "content_sanskrit": "महार्होपस्करोपेतं कामोपायोपबृंहितम्।\nमुक्तादामपताकाभिर्वितानशयनासनैः॥ १०/४७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.003.m4a", "display_order": 4}, {"id": 6000243004, "chapter_id": 10243, "verse_number": "१०-४७-३", "content_sanskrit": "धूपैः सुरभिभिर्दीपैः स्‍त्रग्गन्धैरपि मण्डितम्॥ १०/४७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.004.m4a", "display_order": 5}, {"id": 6000243005, "chapter_id": 10243, "verse_number": "१०-४७-४", "content_sanskrit": "गृहं तमायान्तमवेक्ष्य साऽऽसनात् सद्यः समुत्थाय हि जातसम्भ्रमा।\nयथोपसङ्गम्य सखीभिरच्युतं सभाजयामास सदासनादिभिः॥ १०/४७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.005.m4a", "display_order": 6}, {"id": 6000243006, "chapter_id": 10243, "verse_number": "१०-४७-५", "content_sanskrit": "तथोद्धवः साधु तयाऽभिपूजितो न्यषीददुर्व्यामभिमृश्य चासनम्।\nकृष्णोऽपि दान्तं शयनं महाधनं विवेश लोकाचरितान्यनुव्रतः॥ १०/४७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.006.m4a", "display_order": 7}, {"id": 6000243007, "chapter_id": 10243, "verse_number": "१०-४७-६", "content_sanskrit": "सा मज्जनालेपदुकूलभूषणस्‍त्रग्गन्धताम्बूलसुधासवादिभिः।\nप्रसाधितात्मोपससार माधवं सव्रीडलीलोत्स्मितविभ्रमेक्षितैः॥ १०/४७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.007.m4a", "display_order": 8}, {"id": 6000243008, "chapter_id": 10243, "verse_number": "१०-४७-७", "content_sanskrit": "आहूय कान्तां नवसङ्गमह्रिया विशङ्कितां कङ्कणभूषिते करे।\nप्रगृह्य शय्यामधिवेश्य रामया रेमेऽनुलेपार्पणपुण्यलेशया॥ १०/४७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.008.m4a", "display_order": 9}, {"id": 6000243009, "chapter_id": 10243, "verse_number": "१०-४७-८", "content_sanskrit": "साऽनङ्गतप्तकुचयोरुरसस्तथाऽक्ष्णोर्जिघ्रन्त्यनन्तचरणे न रुजो मृजन्ती।\nदोर्भ्यां स्तनान्तरगतं परिरभ्य कान्तमानन्दमूर्तिमजहादतिदीर्घतापम्॥ १०/४७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.009.m4a", "display_order": 10}, {"id": 6000243010, "chapter_id": 10243, "verse_number": "१०-४७-९", "content_sanskrit": "सैवं कैवल्यनाथं तं प्राप्य दुष्प्रापमीश्वरम्।\nअङ्गरागार्पणेनाहो दुर्भगेदमयाचत॥ १०/४७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.010.m4a", "display_order": 11}, {"id": 6000243011, "chapter_id": 10243, "verse_number": "१०-४७-१०", "content_sanskrit": "आहोष्यतामिह प्रेष्ठ दिनानि कतिचिन्मया।\nरमस्व नोत्सहो त्यक्तुं सङ्गं तेऽम्बुरुहेक्षण॥ १०/४७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.011.m4a", "display_order": 12}, {"id": 6000243012, "chapter_id": 10243, "verse_number": "१०-४७-११", "content_sanskrit": "तस्यै कामवरं दत्वा मानयित्वा च मानदः।\nसहोद्धवेन सर्वेशः स्वधामागमदृद्धिमत्॥ १०/४७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.012.m4a", "display_order": 13}, {"id": 6000243013, "chapter_id": 10243, "verse_number": "१०-४७-१२", "content_sanskrit": "दुराराध्यं समाराध्य विष्णुं सर्वेश्वरेश्वरम्।\nयो वृणीते मनोग्राह्यमसत्त्वात् कुमनीष्यसौ॥ १०/४७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.013.m4a", "display_order": 14, "topics": [{"text": "अक्रूरगृहगमनम्", "range": "१२–१६"}]}, {"id": 6000243014, "chapter_id": 10243, "verse_number": "१०-४७-१३", "content_sanskrit": "अक्रूरभवनं कृष्णः सहरामोद्धवः प्रभुः।\nकिञ्चिच्चिकीर्षन् स प्रागादक्रूरप्रियकाम्यया॥ १०/४७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.014.m4a", "display_order": 15}, {"id": 6000243015, "chapter_id": 10243, "verse_number": "१०-४७-१४", "content_sanskrit": "स तान् नरवरश्रेष्ठानाराद् वीक्ष्य स्वबान्धवान्।\nप्रत्युत्थाय प्रमुदितः परिष्वज्याभ्यनन्दत॥ १०/४७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.015.m4a", "display_order": 16}, {"id": 6000243016, "chapter_id": 10243, "verse_number": "१०-४७-१५", "content_sanskrit": "ननाम कृष्णं रामं च स तैरप्यभिवादितः।\nपूजयामास विधिवत्कृतासनपरिग्रहान्॥ १०/४७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.016.m4a", "display_order": 17}, {"id": 6000243017, "chapter_id": 10243, "verse_number": "१०-४७-१६", "content_sanskrit": "पादावनेजनीरापो धारयन् शिरसा नृप।\nअर्हणेनाम्बरैर्दिव्यैर्गन्धस्रग्भूषणोत्तमैः॥ १०/४७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.017.m4a", "display_order": 18}, {"id": 6000243018, "chapter_id": 10243, "verse_number": "१०-४७-१७", "content_sanskrit": "अर्चित्वा शिरसाऽऽनम्य पादावङ्कगतौ मृजन्।\nप्रश्रयावनतोऽक्रूरः कृष्णरामावभाषत॥ १०/४७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.018.m4a", "display_order": 19}, {"id": 6000243019, "chapter_id": 10243, "verse_number": "१०-४७-१८", "content_sanskrit": "दिष्ट्या पापो हतः कंसः सानुगः पावितं कुलम्।\nभवद्भ्यामुद्धृतं कृच्छ्राद् दुरन्ताच्च समेधितम्॥ १०/४७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.019.m4a", "display_order": 20, "topics": [{"text": "अक्रूरकृतबलरामकृष्णस्तुतिः", "range": "१८–२८"}]}, {"id": 6000243020, "chapter_id": 10243, "verse_number": "१०-४७-१९", "content_sanskrit": "युवां प्रधानपुरुषौ जगद्धेतू जगन्मयौ।\nभवद्भ्यां न विना किञ्चित् परमस्ति न चापरम्॥ १०/४७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.020.m4a", "display_order": 21}, {"id": 6000243021, "chapter_id": 10243, "verse_number": "१०-४७-२०", "content_sanskrit": "आत्मसृष्टमिदं विश्वमन्वावेश्य स्वशक्तिभिः।\nईयते बहुधा ब्रह्मन् श्रुतिप्रत्यक्षगोचरः॥ १०/४७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.021.m4a", "display_order": 22}, {"id": 6000243022, "chapter_id": 10243, "verse_number": "१०-४७-२१", "content_sanskrit": "यथा हि भूतेषु चराचरेषु मह्यादयो योनिषु भान्ति नाना।\nएवं भवान् केवल आत्मयोनिष्वात्माऽऽत्मतन्त्रो बहुधा विभाति॥ १०/४७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.022.m4a", "display_order": 23}, {"id": 6000243023, "chapter_id": 10243, "verse_number": "१०-४७-२२", "content_sanskrit": "सृजस्यथो लुम्पसि पासि विश्वं रजस्तमस्सत्त्वगुणैः स्वशक्तिभिः।\nन बध्यसे त्वं गुणकर्मभिर्वा ज्ञानात्मनस्ते क्‍व च नैव हेतुः॥ १०/४७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.023.m4a", "display_order": 24}, {"id": 6000243024, "chapter_id": 10243, "verse_number": "१०-४७-२३", "content_sanskrit": "देहाद्युपाधेरनिरूपितत्वाद् भवो हि साक्षान्न चिदात्मनः स्यात्।\nअतो न बन्धस्तव नैव मोक्षः स्यातां निकामस्त्वयि नो विवेकः॥ १०/४७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.024.m4a", "display_order": 25}, {"id": 6000243025, "chapter_id": 10243, "verse_number": "१०-४७-२४", "content_sanskrit": "त्वयोदितोऽयं जगतो हिताय यदा यदा वेदपथः पुराणः।\nबाध्येत पाखण्डपथैरसद्भिस्तदा भवान् सत्त्वगुणं बिभर्ति॥ १०/४७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.025.m4a", "display_order": 26}, {"id": 6000243026, "chapter_id": 10243, "verse_number": "१०-४७-२५", "content_sanskrit": "स त्वं प्रभोऽद्य वसुदेवगृहेऽवतीर्णः स्वांशेन भारमपनेतुमिहासि भूमेः।\nअक्षौहिणीशतवधेन सुरेतराणां राज्ञाममुष्य च कुलस्य यशो वितन्वन्॥ १०/४७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.026.m4a", "display_order": 27}, {"id": 6000243027, "chapter_id": 10243, "verse_number": "१०-४७-२६", "content_sanskrit": "अद्येश नो वसतयः खलु भूरिभागा यत् सर्वदेवपितृभूतनृदेवमूर्तिः।\nयत्पादशौचसलिलं त्रिजगत् पुनाति स त्वं जगद्गुरुरधोक्षज याः प्रविष्टः॥ १०/४७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.027.m4a", "display_order": 28}, {"id": 6000243028, "chapter_id": 10243, "verse_number": "१०-४७-२७", "content_sanskrit": "कः पण्डितस्त्वदपरं शरणं समीयात् भक्तप्रियादृतगिरः सुहृदः कृतज्ञात्।\nसर्वान् ददाति सुहृदो भजतोऽभिकामानात्मानमप्युपचयापचयौ न यस्य॥ १०/४७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.028.m4a", "display_order": 29}, {"id": 6000243029, "chapter_id": 10243, "verse_number": "१०-४७-२८", "content_sanskrit": "दिष्ट्या जनार्दन भवानिह नः प्रतीतो योगेश्वरैरपि दुरापगतिः सुरेशैः।\nछिन्ध्याशु नः सुतकलत्रधनाप्तगेहदेहाभिमोहरशनां भवदीयमायाम्॥ १०/४७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.029.m4a", "display_order": 30}, {"id": 6000243030, "chapter_id": 10243, "verse_number": "१०-४७-२९", "content_sanskrit": "इत्यर्थितः संस्तुतश्च भक्तेन भगवान् हरिः।\nअक्रूरं सस्मितं प्राह गीर्भिः सम्मोहयन्निव॥ १०/४७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.030.m4a", "display_order": 31, "topics": [{"text": "तस्य हास्तिनपुरीप्रेषणम्", "range": "२९–३७"}]}, {"id": 6000243031, "chapter_id": 10243, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.031.m4a", "display_order": 32}, {"id": 6000243032, "chapter_id": 10243, "verse_number": "१०-४७-३०", "content_sanskrit": "त्वं नो गुरुः पितृव्यश्च श्लाघ्यो बन्धुश्च नित्यदा।\nवयं तु रक्ष्याः पोष्याश्च अनुकम्प्याः प्रजा हि वः॥ १०/४७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.032.m4a", "display_order": 33}, {"id": 6000243033, "chapter_id": 10243, "verse_number": "१०-४७-३१", "content_sanskrit": "भवद्विधा महाभागा निषेव्या अर्हसत्तमाः।\nश्रेयस्कामैर्नृभिर्नित्यं देवाः स्वार्था न साधवः॥ १०/४७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.033.m4a", "display_order": 34}, {"id": 6000243034, "chapter_id": 10243, "verse_number": "१०-४७-३२", "content_sanskrit": "न ह्यम्मयानि तीर्थानि न देवा मृच्छिलामयाः।\nते पुनन्त्युरुकालेन दर्शनादेव साधवः॥ १०/४७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.034.m4a", "display_order": 35}, {"id": 6000243035, "chapter_id": 10243, "verse_number": "१०-४७-३३", "content_sanskrit": "स भवान् सुहृदां वै नः श्रेयान् श्रेयश्चिकीर्षया।\nजिज्ञासार्थं पाण्डवानां गच्छ स्व गजसाह्वयम्॥ १०/४७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.035.m4a", "display_order": 36}, {"id": 6000243036, "chapter_id": 10243, "verse_number": "१०-४७-३४", "content_sanskrit": "पितर्युपरते बालाः सह मात्रा सुदुःखिताः।\nआनीताः स्वपुरं राज्ञा वसन्त इति शुश्रुम॥ १०/४७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.036.m4a", "display_order": 37}, {"id": 6000243037, "chapter_id": 10243, "verse_number": "१०-४७-३५", "content_sanskrit": "तेषु राजाम्बिकापुत्रो भ्रातृपुत्रेषु दीनधीः।\nसमो न वर्तते नूनं दुष्पुत्रवशगोऽन्धदृक्॥ १०/४७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.037.m4a", "display_order": 38}, {"id": 6000243038, "chapter_id": 10243, "verse_number": "१०-४७-३६", "content_sanskrit": "गच्छ जानीहि तद्वृत्तमधुना साध्वसाधु वा।\nविज्ञाय तद् विधास्यामो यथा शं सुहृदां भवेत्॥ १०/४७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.038.m4a", "display_order": 39}, {"id": 6000243039, "chapter_id": 10243, "verse_number": "१०-४७-३७", "content_sanskrit": "इत्यक्रूरं समादिश्य भगवान् हरिरीश्वरः।\nसङ्कर्षणोद्धवाभ्यां वै ततः स्वभवनं ययौ॥ १०/४७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_047/BhP_10.047.039.m4a", "display_order": 40}, {"id": 6000243040, "chapter_id": 10243, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे सप्तचत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]