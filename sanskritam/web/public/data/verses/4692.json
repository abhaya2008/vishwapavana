[{"id": 2173526, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173527, "chapter_id": 4692, "verse_number": "१", "content_sanskrit": "पातिते युधि दुर्धर्षे मद्रराजे महारथे ।\nहतप्रवीरा विध्वस्ता निकृत्ता निशितैः शरैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173528, "chapter_id": 4692, "verse_number": "२", "content_sanskrit": "तावकास्तव पुत्राश्च प्रायशो विमुखा भवन् ।\nवणिजो नावि भिन्नायां यथाऽगाधे महार्णवे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173529, "chapter_id": 4692, "verse_number": "३", "content_sanskrit": "अपारे पारमिच्छन्तो हते शूरे महात्मनि ।\nमद्रराजे महाराज वित्रेसुः शरविक्षताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173530, "chapter_id": 4692, "verse_number": "४", "content_sanskrit": "अनाथा नाथमिच्छन्तो मृगाः सिंहार्दिता इव ।\nवृषा यथा भग्नशृङ्गाः शीर्णदन्ता गजा इव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173531, "chapter_id": 4692, "verse_number": "५", "content_sanskrit": "मध्याह्ने प्रत्यपायाता निर्जिता धर्मसूनुना ।\nन सन्धातुमनीकानि न च राजन् पराक्रमे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173532, "chapter_id": 4692, "verse_number": "६", "content_sanskrit": "आसीद् बुद्धिर्हते शल्ये तव योधस्य कस्यचित् ।\nभीष्मे द्रोणे च निहते सूतपुत्रे च भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173533, "chapter_id": 4692, "verse_number": "७", "content_sanskrit": "यद्दुःखं तव योधानां भयं चासीद् विशाम्पते ।\nतद्भयं स च नः शोको भूय एवाभ्यवर्धत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173534, "chapter_id": 4692, "verse_number": "८", "content_sanskrit": "निराशाश्च जये तस्मिन् हते शल्ये महारथे ।\nहतप्रवीरा विध्वस्ता निकृत्ता निहितैः शरैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173535, "chapter_id": 4692, "verse_number": "९", "content_sanskrit": "मद्रराजे हते राजन् योधास्ते प्राद्रवन् भयात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173536, "chapter_id": 4692, "verse_number": "१०", "content_sanskrit": "अश्वानन्ये गजानन्ये रथानन्ये महारथाः ।\nआरुह्य जवसम्पन्नाः पादाताः प्राद्रवन् भयात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173537, "chapter_id": 4692, "verse_number": "११", "content_sanskrit": "द्विसाहस्रं च मातङ्गा गिरिरूपाः प्रहारिणः ।\nसम्प्राद्रवन् हते शल्ये अङ्कुशाङ्गुष्ठचोदिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173538, "chapter_id": 4692, "verse_number": "१२", "content_sanskrit": "ते रणाद् भरतश्रेष्ठ तावकाः प्राद्रवन् दिशः ।\nधावन्तश्चाप्यदृश्यन्त श्वसमानाः शरातुराः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173539, "chapter_id": 4692, "verse_number": "१३", "content_sanskrit": "तान् प्रभग्नान् द्रुतान् दृष्ट्वा हतोत्साहान् पराजितान् ।\nअभ्यद्रवन्त पाञ्चालाः पाण्डवाश्च जयैषिणः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173540, "chapter_id": 4692, "verse_number": "१४", "content_sanskrit": "बाणशब्दरवश्चापि सिंहनादश्च पुष्कलः ।\nशङ्खशब्दश्च शूराणां दारुणः समपद्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173541, "chapter_id": 4692, "verse_number": "१५", "content_sanskrit": "दृष्ट्वा तु तावकं सैन्यं भयत्रस्तं प्रविद्रुतम् ।\nअन्योन्यं समभाषन्त पाञ्चालाः पाण्डवैः सह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173542, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "पाञ्चालाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173543, "chapter_id": 4692, "verse_number": "१६", "content_sanskrit": "अद्य राजा सत्यधृतिर्हतामित्रो युधिष्ठिरः ।\nअद्य दुर्योधनो हीनो दीप्तया नृपतिश्रिया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173544, "chapter_id": 4692, "verse_number": "१७", "content_sanskrit": "अद्य श्रुत्वा हतं पुत्रं धृतराष्ट्रो जनेश्वरः ।\nनिःसञ्ज्ञः पतितो भूमौ कश्मलं प्रतिपत्स्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173545, "chapter_id": 4692, "verse_number": "१८", "content_sanskrit": "अद्य जानाति कौन्तेयं समर्थं सर्वधन्विनाम् ।\nअद्यात्मानं च दुर्मेधा गर्हयिष्यति पापकृत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173546, "chapter_id": 4692, "verse_number": "१९", "content_sanskrit": "अद्य क्षत्तुर्वचः सत्यं स्मरतां ब्रुवतो हितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173547, "chapter_id": 4692, "verse_number": "२०", "content_sanskrit": "अद्यप्रभृति पार्थस्य प्रेष्यभूतो ह्युपाचरन् ।\nविजानातु नृपो दुःखं यत् प्राप्तं पाण्डुनन्दनैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173548, "chapter_id": 4692, "verse_number": "२१", "content_sanskrit": "अद्य कृष्णस्य माहात्म्यं जानातु स महीपतिः ।\nअद्यार्जुनधनुर्घोषं घोरं जानातु संयुगे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173549, "chapter_id": 4692, "verse_number": "२२", "content_sanskrit": "अस्त्राणां च बलं सर्वं बाह्वोश्च बलमाहवे ।\nपुत्राणां च वधं घोरं भीमेन श्रोष्यते नृपः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173550, "chapter_id": 4692, "verse_number": "२३", "content_sanskrit": "अद्य ज्ञास्यति भीमस्य बलं घोरं महात्मनः ।\nहते दुर्योधने युद्धे शक्रेणेव तु शम्बरे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173551, "chapter_id": 4692, "verse_number": "२४", "content_sanskrit": "यत् कृतं भीमसेनेन दुःशासनवधे तदा ।\nकोऽन्यः कर्ताऽस्ति तल्लोके ऋते भीमं महाबलम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173552, "chapter_id": 4692, "verse_number": "२५", "content_sanskrit": "जानीतामद्य ज्येष्ठस्य पाण्डवस्य पराक्रमम् ।\nमद्रराजं हतं श्रुत्वा दैवैरपि सुदुःसहम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173553, "chapter_id": 4692, "verse_number": "२६", "content_sanskrit": "अद्य ज्ञास्यति सङ्ग्रामे माद्रीपुत्रौ महाबलौ ।\nनिहते सौबले वीरे गान्धारेषु च सर्वशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173554, "chapter_id": 4692, "verse_number": "२७", "content_sanskrit": "कथं तेषां जयो न स्याद् येषां योद्धा धनञ्जयः ।\nसात्यकिर्भीमसेनश्च धृष्टद्युम्नश्च पार्षतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173555, "chapter_id": 4692, "verse_number": "२८", "content_sanskrit": "द्रौपद्यास्तनयाः पञ्च माद्रीपुत्रौ च पाण्डवौ ।\nशिखण्डी च महेष्वासो राजा चैव युधिष्ठिरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173556, "chapter_id": 4692, "verse_number": "२९", "content_sanskrit": "येषां च जगतां नाथो नाथः कृष्णो जनार्दनः ।\nकथं तेषां जयो न स्याद् येषां धर्मो व्यपाश्रयः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173557, "chapter_id": 4692, "verse_number": "३०", "content_sanskrit": "लाभस्तेषां जयस्तेषां कुतस्तेषां पराभवः ।\nयेषां नाथो हृषीकेशः सर्वलोकविभुर्हरिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173558, "chapter_id": 4692, "verse_number": "३१", "content_sanskrit": "भीष्मं द्रोणं च कर्णं च मद्रराजानमेव च ।\nतथाऽन्यान् नृपतीन् वीरान् शतशोऽथ सहस्रशः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173559, "chapter_id": 4692, "verse_number": "३२", "content_sanskrit": "कोऽन्यः शक्तो रणे जेतुम् ऋते पार्थं युधिष्ठिरम् ।\nयस्य नाथो हृषीकेशः सदा सत्ययशोनिधिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173560, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173561, "chapter_id": 4692, "verse_number": "३३", "content_sanskrit": "इत्येवं वदमानास्ते हर्षेण महता युताः ।\nप्रभिन्नांस्तावकान् राजन् सृञ्जयाः पृष्ठतोऽन्वयुः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173562, "chapter_id": 4692, "verse_number": "३४", "content_sanskrit": "धनञ्जयो रथानीकमभ्यवर्तत वीर्यवान् ।\nमाद्रीपुत्रौ च शकुनिं सात्यकिश्च महारथः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173563, "chapter_id": 4692, "verse_number": "३५", "content_sanskrit": "तान् प्रेक्ष्य द्रवतः सर्वान् भीमसेनभयार्दितान् ।\nदुर्योधनस्तदा सूतमब्रवीद् विस्मयन्निव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173564, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173565, "chapter_id": 4692, "verse_number": "३६", "content_sanskrit": "न माऽतिक्रमते पार्थो धनुष्पाणिमवस्थितम् ।\nजघने सर्वसैन्यानां शनैरश्वान् प्रचोदय\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173566, "chapter_id": 4692, "verse_number": "३७", "content_sanskrit": "जघने युध्यमानं हि कौन्तेयो मां धनञ्जयः ।\nनोत्सहेत व्यतिक्रान्तुं वेलामिव महोदधिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173567, "chapter_id": 4692, "verse_number": "३८", "content_sanskrit": "पश्य सैन्यं महत्सूत पाण्डवैः समभिद्रुतम् ।\nसैन्यरेणुं समुद्धूतं पश्य चैनं समन्ततः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173568, "chapter_id": 4692, "verse_number": "३९", "content_sanskrit": "सिंहनादांश्च बहुशः शृणु घोरान् भयानकान् ।\nतस्माद् याहि शनैः सूत जघनं परिपालय\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173569, "chapter_id": 4692, "verse_number": "४०", "content_sanskrit": "मयि स्थिते च समरे निरुद्धेषु च पाण्डुषु ।\nपुनरावर्तते तूर्णं मामकं बलमोजसा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173570, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173571, "chapter_id": 4692, "verse_number": "४१", "content_sanskrit": "तच्छ्रुत्वा तव पुत्रस्य भाषतो मधुरं वचः ।\nसारथिर्हेमसञ्छन्नान् शनैरश्वानचोदयत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173572, "chapter_id": 4692, "verse_number": "४२", "content_sanskrit": "गजाश्वरथिभिर्भिन्नाः त्यक्तात्मानः पदातयः ।\nएकविंशतिसाहस्राः संयुगायावतस्थिरे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173573, "chapter_id": 4692, "verse_number": "४३", "content_sanskrit": "नानादेशसमुद्भूता नानारञ्जितवाससः ।\nअवस्थितास्तदा योधाः प्रार्थयन्तो महद्यशः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173574, "chapter_id": 4692, "verse_number": "४४", "content_sanskrit": "तेषामापततां तत्र संसृष्टानां परस्परम् ।\nसम्मर्दस्तु महान् जज्ञे घोररूपो भयङ्करः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173575, "chapter_id": 4692, "verse_number": "४५", "content_sanskrit": "भीमसेनं तदा राजन् धृष्टद्युम्नं च पार्षतम् ।\nबलेन चतुरङ्गेण नानादेश्या न्यवारयन्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173576, "chapter_id": 4692, "verse_number": "४६", "content_sanskrit": "भीममेवाभ्यवर्तन्त रणेऽन्ये तु पदातयः ।\nप्रक्ष्वेल्यास्फोट्य संहृष्टा वीरलोकमियासवः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173577, "chapter_id": 4692, "verse_number": "४७", "content_sanskrit": "आसाद्य भीमसेनं तु सङ्क्रुद्धा युद्धदुर्मदाः ।\nधार्तराष्ट्रास्तदा नेदुर्नान्यामकथयन् कथाम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173578, "chapter_id": 4692, "verse_number": "४८", "content_sanskrit": "परिवार्य रणे भीमं निजघ्नुस्ते समन्ततः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173579, "chapter_id": 4692, "verse_number": "४९", "content_sanskrit": "स वध्यमानः समरे पदातिगणसंवृतः ।\nन चचाल रथोपस्थे मैनाक इव पर्वतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173580, "chapter_id": 4692, "verse_number": "५०", "content_sanskrit": "ते तु क्रुद्धा महाराज पाण्डवस्य महारथाः ।\nनिगृहीतुं प्रचक्रुर्हि योधाश्चान्ये न्यवारयन्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173581, "chapter_id": 4692, "verse_number": "५१", "content_sanskrit": "अक्रुध्यत रणे भीमः तैस्तदा पर्यवस्थितैः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173582, "chapter_id": 4692, "verse_number": "५२", "content_sanskrit": "सोऽवतीर्य रथात् तूर्णं पदातिः समवस्थितः ।\nजातरूपपरिच्छन्नां प्रगृह्य महतीं गदाम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173583, "chapter_id": 4692, "verse_number": "५३", "content_sanskrit": "अवधीत् तावकान् योधान् दण्डपाणिरिवान्तकः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2173584, "chapter_id": 4692, "verse_number": "५४", "content_sanskrit": "विप्रहीणरथाश्वांस्तान् नरान् स पुरुषर्षभः ।\nरथाश्च द्विपहीनास्तु तान् भीमो गदया बली\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2173585, "chapter_id": 4692, "verse_number": "५५", "content_sanskrit": "एकविंशतिसाहस्रान् पदातीनवपोथयत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2173586, "chapter_id": 4692, "verse_number": "५६", "content_sanskrit": "हत्वा तत् पुरुषानीकं भीमः सत्यपराक्रमः ।\nधृष्टद्युम्नं पुरस्कृत्य नचिरात् प्रत्यदृश्यत\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2173587, "chapter_id": 4692, "verse_number": "५७", "content_sanskrit": "पादाता निहता भूमौ शिश्यिरे रुधिरोक्षिताः ।\nप्रभग्ना इव वातेन कर्णिकाराः सुपुष्पिताः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2173588, "chapter_id": 4692, "verse_number": "५८", "content_sanskrit": "नानाशस्त्रसमायुक्ता नानाकुण्डलधारिणः ।\nनानाजात्या हतास्तत्र नानादेशसमागताः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2173589, "chapter_id": 4692, "verse_number": "५९", "content_sanskrit": "पताकाध्वजसम्पन्नं पदातीनां महद्बलम् ।\nनिकृत्तं विबभौ तत्र छिन्नं तालवनं यथा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2173590, "chapter_id": 4692, "verse_number": "६०", "content_sanskrit": "युधिष्ठिरपुरोगास्तु सहसैन्या महारथाः ।\nअभ्यधावन् महात्मानः पुत्रं दुर्योधनं तव\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2173591, "chapter_id": 4692, "verse_number": "६१", "content_sanskrit": "ते सर्वे तावकान् दृष्ट्वा महेष्वासान् पराङ्मुखान् ।\nनात्यवर्तन्त ते पुत्रं वेलामिव महोर्मयः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2173592, "chapter_id": 4692, "verse_number": "६२", "content_sanskrit": "तदद्भुतमपश्याम तव पुत्रस्य विक्रमम् ।\nयदेकं सहिताः पार्था न शेकुरतिवर्तितुम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2173593, "chapter_id": 4692, "verse_number": "६३", "content_sanskrit": "नातिदूरेऽपयातं तं कृतबुद्धिं पलायने ।\nदुर्योधनः स्वकं सैन्यमब्रवीद् भृशविक्षतम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2173594, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2173595, "chapter_id": 4692, "verse_number": "६४", "content_sanskrit": "न तं देशं प्रपश्यामि पृथिव्यां पर्वतेषु वा ।\nयत्र यातान् न वो हन्युः पाण्डवाः किं द्रुतेन वः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2173596, "chapter_id": 4692, "verse_number": "६५", "content_sanskrit": "अल्पं च बलमेतेषां कृष्णौ च भृशदुःखितौ ।\nयदि सर्वे प्रतिष्ठामो ध्रुवं नो विजयो भवेत्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2173597, "chapter_id": 4692, "verse_number": "६६", "content_sanskrit": "विप्रयातांस्तु नो भिन्नान् पाण्डवाः कृतकिल्बिषान् ।\nअनुव्रज्य हनिष्यन्ति श्रेयो नः समरे स्थितिः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2173598, "chapter_id": 4692, "verse_number": "६७", "content_sanskrit": "शृण्वन्तु क्षत्रियाः सर्वे यावन्तः स्थ समागताः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2173599, "chapter_id": 4692, "verse_number": "६८", "content_sanskrit": "यदि शूरं च भीमं च मानयत्यन्तकः सदा ।\nको नु मूढो न युध्येत पुरुषः क्षत्रियर्षभः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2173600, "chapter_id": 4692, "verse_number": "६९", "content_sanskrit": "श्रेयो नो भीमसेनस्य क्रुद्धस्य प्रमुखे स्थितिः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2173601, "chapter_id": 4692, "verse_number": "७०", "content_sanskrit": "मुख्यः साङ्ग्रामिको मृत्युर्दुःखो व्याधिजरादिभिः ।\nमर्त्येनावश्यं मर्तव्यं गृहेष्वपि कदाचन\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2173602, "chapter_id": 4692, "verse_number": "७१", "content_sanskrit": "युध्यतः क्षत्रधर्मेण मृत्युरेष सनातनः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2173603, "chapter_id": 4692, "verse_number": "७२", "content_sanskrit": "जित्वा वा सुखमाप्नोति हतः प्रेत्य महद्यशः ।\nन युद्धधर्माच्छ्रेयान् वै पन्थाः स्वर्गस्य कौरवाः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2173604, "chapter_id": 4692, "verse_number": "७३", "content_sanskrit": "अचिरेण जिताँल्लोकान् हतो युधि समश्नुते\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2173605, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2173606, "chapter_id": 4692, "verse_number": "७४", "content_sanskrit": "श्रुत्वा तु वचनं तस्य पूजयित्वा तु पार्थिवाः ।\nपुनरेवाभ्यवर्तन्त पाण्डवानाततायिनः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2173607, "chapter_id": 4692, "verse_number": "७५", "content_sanskrit": "तानापतत एवाशु व्यूढानीकाः प्रहारिणः ।\nप्रत्युद्ययुस्तदा पार्था जयगृद्ध्राः प्रमन्यवः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2173608, "chapter_id": 4692, "verse_number": "७६", "content_sanskrit": "धनञ्जयो रथेनाजावभ्यवर्तत वीर्यवान् ।\nविश्रुतं त्रिषु लोकेषु गाण्डीवं विक्षिपन् धनुः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2173609, "chapter_id": 4692, "verse_number": "७७", "content_sanskrit": "माद्रीपुत्रौ च शकुनिं सात्यकिश्च महाबलः ।\nजवेनाभ्यपतन् हृष्टा यत्ता वै तावकं बलम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2173610, "chapter_id": 4692, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2173611, "chapter_id": 4692, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि एकोनविंशोऽध्यायः ॥१९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]