[{"id": 2178673, "chapter_id": 4780, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178674, "chapter_id": 4780, "verse_number": "१", "content_sanskrit": "सौमदत्तिं च पश्यैनं युयुधानेन पातितम् ।\nवितुद्यमानं बहुभिर्विहगैर्माधवान्तिके\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178675, "chapter_id": 4780, "verse_number": "२", "content_sanskrit": "पुत्रशोकाभिसन्तप्तः सोमदत्तो जनार्दन ।\nयुयुधानं महेष्वासं गर्हयन्निव दृश्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178676, "chapter_id": 4780, "verse_number": "३", "content_sanskrit": "असौ तु भूरिश्रवसो माता शोकपरिप्लुता ।\nआश्वासयति भर्तारं सोमदत्तमनिन्दिता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178677, "chapter_id": 4780, "verse_number": "४", "content_sanskrit": "दिष्ट्या त्वियं महाराज दारुणं भरतक्षयम् ।\nकुरूणां कदनं घोरं युगान्तं नानुपश्यसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178678, "chapter_id": 4780, "verse_number": "५", "content_sanskrit": "दिष्ट्या यूपध्वजं वीरं पुत्रं भूरिसहस्रदम् ।\nअनेकक्रतुयज्वानं निहतं नाद्य पश्यसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178679, "chapter_id": 4780, "verse_number": "६", "content_sanskrit": "दिष्ट्या स्नुषाणामाक्रन्दे घोरं विलपितं बहु ।\nन शृणोषि महाराज सारसीनामिवार्णवे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178680, "chapter_id": 4780, "verse_number": "७", "content_sanskrit": "एकवस्त्रानुसंवीताः प्रकीर्णासितमूर्धजाः ।\nस्नुषास्ते परिधावन्ति हतापत्या हतेश्वराः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178681, "chapter_id": 4780, "verse_number": "८", "content_sanskrit": "श्वापदैर्भक्ष्यमाणं त्वमहो दिष्ट्या न पश्यसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178682, "chapter_id": 4780, "verse_number": "९", "content_sanskrit": "छिन्नबाहुं नरव्याघ्रमर्जुनेन निपातितम् ।\nशलं विनिहतं सङ्खे भूरिश्रवसमेव च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178683, "chapter_id": 4780, "verse_number": "१०", "content_sanskrit": "स्नुषाश्च विधवाः सर्वा दिष्ट्या नाद्येह पश्यसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178684, "chapter_id": 4780, "verse_number": "११", "content_sanskrit": "दिष्ट्या तत् काञ्चनं छत्रं यूपकेतोर्महात्मनः ।\nविनिकीर्णं रथोपस्थे सौमदत्तेर्न पश्यसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178685, "chapter_id": 4780, "verse_number": "१२", "content_sanskrit": "अमूस्तु भूरिश्रवसो भार्याः सात्यकिना हतम् ।\nपरिवार्यानुशोचन्ति भर्तारमसितेक्षणाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178686, "chapter_id": 4780, "verse_number": "१३", "content_sanskrit": "एता विलप्य बहुलं भर्तुः शोकेन कर्शिताः ।\nपतन्त्यभिमुखा भूमौ कृपणं बत केशव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178687, "chapter_id": 4780, "verse_number": "१४", "content_sanskrit": "बीभत्सुरतिबीभत्सं कर्मेदमकरोत् कथम् ।\nप्रमत्तस्य यदच्छैत्सीत् बाहुं शूरस्य यज्वनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178688, "chapter_id": 4780, "verse_number": "१५", "content_sanskrit": "ततः पापतरं कर्म कृतवानिह सात्यकिः ।\nयस्य प्रायोपविष्टस्य प्राहार्षीत् संशितात्मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178689, "chapter_id": 4780, "verse_number": "१६", "content_sanskrit": "एको द्वाभ्यां हतः शेषे त्वमधर्मेण धार्मिकः ।\nइति यूपध्वजस्यैता भार्याः क्रोशन्ति माधव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178690, "chapter_id": 4780, "verse_number": "१७", "content_sanskrit": "भार्या यूपध्वजस्यैषा करसम्मितमध्यमा ।\nकृत्वोत्सङ्गे भुजं भर्तुः कृपणं पर्यदेवयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178691, "chapter_id": 4780, "verse_number": "", "content_sanskrit": "सौमदत्तिप्रिया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178692, "chapter_id": 4780, "verse_number": "१८", "content_sanskrit": "अयं स रशनोत्कर्षी पीनस्तनविमर्दनः ।\nनाभ्यूरुजघनस्पर्शी नीवीविस्रंसनः करः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178693, "chapter_id": 4780, "verse_number": "१९", "content_sanskrit": "अयं स हन्ता शत्रूणां मित्राणामभयङ्करः ।\nप्रदाता गोसहस्राणां क्षत्रियान्तकरः करः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178694, "chapter_id": 4780, "verse_number": "२०", "content_sanskrit": "वासुदेवस्य सान्निध्ये पार्थेनाक्लिष्टकर्मणा ।\nयुध्यतः समरेऽन्येन प्रमत्तस्य निपातितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178695, "chapter_id": 4780, "verse_number": "२१", "content_sanskrit": "किं नु वक्ष्यति संसत्सु कथासु च जनार्दनः ।\nअर्जुनस्य तु तत्कर्म स्वयं चापि किरीटवान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178696, "chapter_id": 4780, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178697, "chapter_id": 4780, "verse_number": "२२", "content_sanskrit": "इत्येवं गर्हयित्वैषा तूष्णीमास्ते वराङ्गना ।\nतामेतामनुशोचन्ति सपत्न्यः स्वामिनः स्नुषाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178698, "chapter_id": 4780, "verse_number": "२३", "content_sanskrit": "गान्धारराजः शकुनिर्बलवान् सत्यविक्रमः ।\nनिहतः सहदेवेन भागिनेयेन मातुलः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178699, "chapter_id": 4780, "verse_number": "२४", "content_sanskrit": "यः पुरा हेमदण्डाभ्यां व्यजनाभ्यां च वीज्यते ।\nस एष पक्षिभिः पक्षैः शयान उपवीज्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178700, "chapter_id": 4780, "verse_number": "२५", "content_sanskrit": "यश्च रूपाणि कुरुते शतशोऽथ सहस्रशः ।\nतस्य मायाविनो माया दग्धाः पाण्डवतेजसा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178701, "chapter_id": 4780, "verse_number": "२६", "content_sanskrit": "मायया निकृतिप्रज्ञो यो जिगाय युधिष्ठिरम् ।\nसभायां विपुलं राज्यं स कथं जीवितं जहौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178702, "chapter_id": 4780, "verse_number": "२७", "content_sanskrit": "शकुन्ताः शकुनिं कृष्ण समन्तात् पर्युपासते ।\nकितवं मम पुत्राणां विनाशायोपशिक्षितम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178703, "chapter_id": 4780, "verse_number": "२८", "content_sanskrit": "एतेनैतन्महद् वैरमाहितं पाण्डवैः सह ।\nवधाय मम पुत्राणामात्मनः सगणस्य च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178704, "chapter_id": 4780, "verse_number": "२९", "content_sanskrit": "यथैव मम पुत्राणां लोकाः शस्त्रजिताः प्रभो ।\nएवमस्यापि दुर्बुद्धेर्लोकाः शस्त्रेण निर्जिताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178705, "chapter_id": 4780, "verse_number": "३०", "content_sanskrit": "कथं च नायं तत्रापि पुत्रान् मे भ्रातृभिः सह ।\nविरोधयेद् ऋजुप्रज्ञान् अनृजुर्मधुसूदन\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178706, "chapter_id": 4780, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nसोमदत्तशकुनिदर्शनं नाम चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178707, "chapter_id": 4780, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि नवमोऽध्यायः ॥९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]