[{"id": 7003344000, "chapter_id": 23344, "verse_number": "२-३९-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nहिरण्याश्वप्रदानं च वदामी विजयावहम् ।\nअश्वमेधात्पुनः श्रेष्ठं वदामी श्रृणु सुव्रत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003344001, "chapter_id": 23344, "verse_number": "२-३९-२", "content_sanskrit": "अष्टोत्तरसहस्रेण अष्टोत्तरशतेन वा ।\nकृत्वाश्वं लक्षणैर्युक्तं सर्वालंकारसंयुतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003344002, "chapter_id": 23344, "verse_number": "२-३९-३", "content_sanskrit": "पंचकल्याणसंपन्नं दिव्याकारं तु कारयेत् ।\nसर्वलक्षणसंयुक्तं सर्वांगैश्च समन्वितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003344003, "chapter_id": 23344, "verse_number": "२-३९-४", "content_sanskrit": "सर्वायुधसमोपेतमिंद्रवाहनमुत्तमम् ।\nतन्मध्यदेशे संस्थाप्य तुरंगं स्वगुणान्वितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003344004, "chapter_id": 23344, "verse_number": "२-३९-५", "content_sanskrit": "उच्चैः श्रवसकं मत्वा भक्त्या चैव समर्चयेत् ।\nतस्य पूर्वादिशाभागे ब्राह्मणं वेदपारगम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003344005, "chapter_id": 23344, "verse_number": "२-३९-६", "content_sanskrit": "सुरेंद्रबुद्ध्या संपूज्य पंचनिष्कं प्रदापयेत् ।\nस चाश्वः शिवभक्ताय दातव्यो विधिनैव तु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003344006, "chapter_id": 23344, "verse_number": "२-३९-७", "content_sanskrit": "सुवर्णाश्वं प्रदत्त्वा तु आचार्यमपि पूजयेत् ।\nयथाविभवविस्तारं पंचनिष्कमथापिवा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003344007, "chapter_id": 23344, "verse_number": "२-३९-८", "content_sanskrit": "दीनांधकृपणानाथबालवृद्धकृशातुरान् ।\nतोषयेदन्नदानेन ब्राह्मणांश्च विशेषतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003344008, "chapter_id": 23344, "verse_number": "२-३९-९", "content_sanskrit": "एतद्यः कुरुते भक्त्या दानमश्वस्य मानवः ।\nऐंद्रान्भोगांश्चिरं भुक्त्वा रुचिरैश्वर्यवान्भवेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]