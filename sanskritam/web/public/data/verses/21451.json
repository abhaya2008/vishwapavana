[{"id": 7001451000, "chapter_id": 21451, "verse_number": "७-१-२४-१", "content_sanskrit": "ऋषय ऊचुः ।\nअन्तर्धानगतो देव्या सह सानुचरो हरः ।\nक्व यातः कुत्र वासः किं कृत्वा विरराम ह॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001451001, "chapter_id": 21451, "verse_number": "७-१-२४-२", "content_sanskrit": "वायुरुवाच ।\nमहीधरवरः श्रीमान्मंदरश्चित्रकंदरः ।\nदयितो देवदेवस्य निवासस्तपसो ऽभवत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001451002, "chapter_id": 21451, "verse_number": "७-१-२४-३", "content_sanskrit": "तपो महत्कृतं तेन वोढुं स्वशिरसा शिवौ ।\nचिरेण लब्धं तत्पादपंकजस्पर्शजं सुखम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001451003, "chapter_id": 21451, "verse_number": "७-१-२४-४", "content_sanskrit": "तस्य शैलस्य सौन्दर्यं सहस्रवदनैरपि ।\nन शक्यं विस्तराद्वक्तुं वर्षकोटिशतैरपि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001451004, "chapter_id": 21451, "verse_number": "७-१-२४-५", "content_sanskrit": "शक्यमप्यस्य सौन्दर्यं न वर्णयितुमुत्सहे ।\nपर्वतान्तरसौन्दर्यं साधारणविधारणात्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001451005, "chapter_id": 21451, "verse_number": "७-१-२४-६", "content_sanskrit": "इदन्तु शक्यते वक्तुमस्मिन्पर्वतसुन्दरे ।\nऋद्ध्या कयापि सौन्दर्यमीश्वरावासयोग्यता॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001451006, "chapter_id": 21451, "verse_number": "७-१-२४-७", "content_sanskrit": "अत एव हि देवेन देव्याः प्रियचिकीर्षया ।\nअतीव रमणीयोयं गिरिरन्तःपुरीकृतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001451007, "chapter_id": 21451, "verse_number": "७-१-२४-८", "content_sanskrit": "मेखलाभूमयस्तस्य विमलोपलपादपाः ।\nशिवयोर्नित्यसान्निध्यान्न्यक्कुर्वंत्यखिलंजगत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001451008, "chapter_id": 21451, "verse_number": "७-१-२४-९", "content_sanskrit": "पितृभ्यां जगतो नित्यं स्नानपानोपयोगतः ।\nअवाप्तपुण्यसंस्कारः प्रसरद्भिरितस्ततः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001451009, "chapter_id": 21451, "verse_number": "७-१-२४-१०", "content_sanskrit": "लघुशीतलसंस्पर्शैरच्छाच्छैर्निर्झराम्बुभिः ।\nअधिराज्येन चाद्रीणामद्रीरेषो ऽभिषिच्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001451010, "chapter_id": 21451, "verse_number": "७-१-२४-११", "content_sanskrit": "निशासु शिखरप्रान्तर्वर्तिना स शिलोच्चयः ।\nचंद्रेणाचल साम्राज्यच्छत्रेणेव विराजते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001451011, "chapter_id": 21451, "verse_number": "७-१-२४-१२", "content_sanskrit": "स शैलश्चंचलीभूतैर्बालैश्चामरयोषिताम् ।\nसर्वपर्वतसाम्राज्यचामरैरिव वीज्यते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001451012, "chapter_id": 21451, "verse_number": "७-१-२४-१३", "content_sanskrit": "प्रातरभ्युदिते भानौ भूधरो रत्नभूषितः ।\nदर्पणे देहसौभाग्यं द्रष्टुकाम इव स्थितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001451013, "chapter_id": 21451, "verse_number": "७-१-२४-१४", "content_sanskrit": "कूजद्विहंगवाचालैर्वातोद्धृतलताभुजैः ।\nविमुक्तपुष्पैः सततं व्यालम्बिमृदुपल्लवैः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001451014, "chapter_id": 21451, "verse_number": "७-१-२४-१५", "content_sanskrit": "लताप्रतानजटिलैस्तरुभिस्तपसैरिव ।\nजयाशिषा सहाभ्यर्च्य निषेव्यत इवाद्रिराट्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001451015, "chapter_id": 21451, "verse_number": "७-१-२४-१६", "content_sanskrit": "अधोमुखैरूर्ध्वमुखैश्शृंगैस्तिर्यङ्मुखैस्तथा ।\nप्रपतन्निव पाताले भूपृष्ठादुत्पतन्निव॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001451016, "chapter_id": 21451, "verse_number": "७-१-२४-१७", "content_sanskrit": "परीतः सर्वतो दिक्षु भ्रमन्निव विहायसि ।\nपश्यन्निव जगत्सर्वं नृत्यन्निव निरन्तरम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001451017, "chapter_id": 21451, "verse_number": "७-१-२४-१८", "content_sanskrit": "गुहामुखैः प्रतिदिनं व्यात्तास्यो विपुलोदरैः ।\nअजीर्णलावण्यतया जृंभमाण इवाचलः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001451018, "chapter_id": 21451, "verse_number": "७-१-२४-१९", "content_sanskrit": "ग्रसन्निव जगत्सर्वं पिबन्निव पयोनिधिम् ।\nवमन्निव तमोन्तस्थं माद्यन्निव खमम्बुदैः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001451019, "chapter_id": 21451, "verse_number": "७-१-२४-२०", "content_sanskrit": "निवास भूमयस्तास्ता दर्पणप्रतिमोदराः ।\nतिरस्कृतातपास्स्निग्धाश्रमच्छायामहीरुहाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001451020, "chapter_id": 21451, "verse_number": "७-१-२४-२१", "content_sanskrit": "सरित्सरस्तडागादिसंपर्कशिशिरानिलाः ।\nतत्र तत्र निषण्णाभ्यां शिवाभ्यां सफलीकृताः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001451021, "chapter_id": 21451, "verse_number": "७-१-२४-२२", "content_sanskrit": "तमिमं सर्वतः श्रेष्ठं स्मृत्वा साम्बस्त्रियम्बकः ।\nरैभ्याश्रमसमीपस्थश्चान्तर्धानं गतो ययौ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001451022, "chapter_id": 21451, "verse_number": "७-१-२४-२३", "content_sanskrit": "तत्रोद्यानमनुप्राप्य देव्या सह महेश्वरः ।\nरराम रमणीयासु देव्यान्तःपुरभूमिषु॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001451023, "chapter_id": 21451, "verse_number": "७-१-२४-२४", "content_sanskrit": "तथा गतेषु कालेषु प्रवृद्धासु प्रजासु च ।\nदैत्यौ शुंभनिशुंभाख्यौ भ्रातरौ संबभूवतुः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001451024, "chapter_id": 21451, "verse_number": "७-१-२४-२५", "content_sanskrit": "ताभ्यां तपो बलाद्दत्तं ब्रह्मणा परमेष्टिना ।\nअवध्यत्वं जगत्यस्मिन्पुरुषैरखिलैरपि॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001451025, "chapter_id": 21451, "verse_number": "७-१-२४-२६", "content_sanskrit": "अयोनिजा तु या कन्या ह्यंबिकांशसमुद्भवा ।\nअजातपुंस्पर्शरतिरविलंघ्यपराक्रमा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001451026, "chapter_id": 21451, "verse_number": "७-१-२४-२७", "content_sanskrit": "तया तु नौ वधः संख्ये तस्यां कामाभिभूतयोः ।\nइति चाभ्यर्थितो ब्रह्मा ताभ्याम्प्राह तथास्त्विति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001451027, "chapter_id": 21451, "verse_number": "७-१-२४-२८", "content_sanskrit": "ततः प्रभृति शक्रादीन्विजित्य समरे सुरान् ।\nनिःस्वाध्यायवषट्कारं जगच्चक्रतुरक्रमात्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001451028, "chapter_id": 21451, "verse_number": "७-१-२४-२९", "content_sanskrit": "तयोर्वधाय देवेशं ब्रह्माभ्यर्थितवान्पुनः ।\nविनिंद्यापि रहस्यं वां क्रोधयित्वा यथा तथा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001451029, "chapter_id": 21451, "verse_number": "७-१-२४-३०", "content_sanskrit": "तद्वर्णकोशजां शक्तिमकामां कन्यकात्मिकाम् ।\nनिशुम्भशुंभयोर्हंत्रीं सुरेभ्यो दातुमर्हसि॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001451030, "chapter_id": 21451, "verse_number": "७-१-२४-३१", "content_sanskrit": "एवमभ्यर्थितो धात्रा भगवान्नीललोहितः ।\nकालीत्याह रहस्यं वां निन्दयन्निव सस्मितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001451031, "chapter_id": 21451, "verse_number": "७-१-२४-३२", "content_sanskrit": "ततः क्रुद्धा तदा देवी सुवर्णा वर्णकारणात् ।\nस्मयन्ती चाह भर्तारमसमाधेयया गिरा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001451032, "chapter_id": 21451, "verse_number": "७-१-२४-३३", "content_sanskrit": "देव्युवाच ।\nईदृशो मम वर्णेस्मिन्न रतिर्भवतो ऽस्ति चेत् ।\nएवावन्तं चिरं कालं कथमेषा नियम्यते॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001451033, "chapter_id": 21451, "verse_number": "७-१-२४-३४", "content_sanskrit": "अरत्या वर्तमानो ऽपि कथं च रमसे मया ।\nन ह्यशक्यं जगत्यस्मिन्नीश्वरस्य जगत्प्रभोः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001451034, "chapter_id": 21451, "verse_number": "७-१-२४-३५", "content_sanskrit": "स्वात्मारामस्य भवतो रतिर्न सुखसाधनम् ।\nइति हेतोः स्मरो यस्मात्प्रसभं भस्मसात्कृतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001451035, "chapter_id": 21451, "verse_number": "७-१-२४-३६", "content_sanskrit": "या च नाभिमता भर्तुरपि सर्वांगसुन्दरी ।\nसा वृथैव हि जायेत सर्वैरपि गुणान्तरैः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001451036, "chapter_id": 21451, "verse_number": "७-१-२४-३७", "content_sanskrit": "भर्तुर्भोगैकशेषो हि सर्ग एवैष योषिताम् ।\nतथासत्यन्यथाभूता नारी कुत्रोपयुज्यते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001451037, "chapter_id": 21451, "verse_number": "७-१-२४-३८", "content_sanskrit": "तस्माद्वर्णमिमं त्यक्त्वा त्वया रहसि निन्दितम् ।\nवर्णान्तरं भजिष्ये वा न भजिष्यामि वा स्वयम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001451038, "chapter_id": 21451, "verse_number": "७-१-२४-३९", "content_sanskrit": "इत्युक्त्वोत्थाय शयनाद्देवी साचष्ट गद्गदम् ।\nययाचे ऽनुमतिं भर्तुस्तपसे कृतनिश्चया॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001451039, "chapter_id": 21451, "verse_number": "७-१-२४-४०", "content_sanskrit": "तथा प्रणयभंगेन भीतो भूतपतिः स्वयम् ।\nपादयोः प्रणमन्नेव भवानीं प्रत्यभाषत॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001451040, "chapter_id": 21451, "verse_number": "७-१-२४-४१", "content_sanskrit": "ईश्वर उवाच ।\nअजानती च क्रीडोक्तिं प्रिये किं कुपितासि मे ।\nरतिः कुतो वा जायेत त्वत्तश्चेदरतिर्मम॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001451041, "chapter_id": 21451, "verse_number": "७-१-२४-४२", "content_sanskrit": "माता त्वमस्य जगतः पिताहमधिपस्तथा ।\nकथं तदुत्पपद्येत त्वत्तो नाभिरतिर्मम॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001451042, "chapter_id": 21451, "verse_number": "७-१-२४-४३", "content_sanskrit": "आवयोरभिकामो ऽपि किमसौ कामकारितः ।\nयतः कामसमुत्पत्तिः प्रागेव जगदुद्भवः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001451043, "chapter_id": 21451, "verse_number": "७-१-२४-४४", "content_sanskrit": "पृथग्जनानां रतये कामात्मा कल्पितो मया ।\nततः कथमुपालब्धः कामदाहादहं त्वया॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001451044, "chapter_id": 21451, "verse_number": "७-१-२४-४५", "content_sanskrit": "मां वै त्रिदशसामान्यं मन्यमानो मनोभवः ।\nमनाक्परिभवं कुर्वन्मया वै भस्मसात्कृतः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001451045, "chapter_id": 21451, "verse_number": "७-१-२४-४६", "content_sanskrit": "विहारोप्यावयोरस्य जगतस्त्राणकारणात् ।\nततस्तदर्थं त्वय्यद्य क्रीडोक्तिं कृतवाहनम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001451046, "chapter_id": 21451, "verse_number": "७-१-२४-४७", "content_sanskrit": "स चायमचिरादर्थस्तवैवाविष्करिष्यते ।\nक्रोधस्य जनकं वाक्यं हृदि कृत्वेदमब्रवीत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001451047, "chapter_id": 21451, "verse_number": "७-१-२४-४८", "content_sanskrit": "देव्युवाच ।\nश्रुतपूर्वं हि भगवंस्तव चाटु वचो मया ।\nयेनैवमतिधीराहमपि प्रागभिवंचिता॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001451048, "chapter_id": 21451, "verse_number": "७-१-२४-४९", "content_sanskrit": "प्राणानप्यप्रिया भर्तुर्नारी या न परित्यजेत् ।\nकुलांगना शुभा सद्भिः कुत्सितैव हि गम्यते॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001451049, "chapter_id": 21451, "verse_number": "७-१-२४-५०", "content_sanskrit": "भूयसी च तवाप्रीतिरगौरमिति मे वपुः ।\nक्रीडोक्तिरपि कालीति घटते कथमन्यथा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001451050, "chapter_id": 21451, "verse_number": "७-१-२४-५१", "content_sanskrit": "सद्भिर्विगर्हितं तस्मात्तव कार्ष्ण्यमसंमतम् ।\nअनुत्सृज्य तपोयोगात्स्थातुमेवेह नोत्सहे॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001451051, "chapter_id": 21451, "verse_number": "७-१-२४-५२", "content_sanskrit": "शिव उवाच ।\nस यद्येवंविधतापस्ते तपसा किं प्रयोजनम् ।\nममेच्छया स्वेच्छया वा वर्णान्तरवती भव॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001451052, "chapter_id": 21451, "verse_number": "७-१-२४-५३", "content_sanskrit": "देव्युवाच ।\nनेच्छामि भवतो वर्णं स्वयं वा कर्तुमन्यथा ।\nब्रह्माणं तपसाराध्य क्षिप्रं गौरी भवाम्यहम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001451053, "chapter_id": 21451, "verse_number": "७-१-२४-५४", "content_sanskrit": "ईश्वर उवाच ।\nमत्प्रसादात्पुरा ब्रह्मा ब्रह्मत्वं प्राप्तवान्पुरा ।\nतमाहूय महादेवि तपसा किं करिष्यसि॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001451054, "chapter_id": 21451, "verse_number": "७-१-२४-५५", "content_sanskrit": "देव्युवाच ।\nत्वत्तो लब्धपदा एव सर्वे ब्रह्मादयः सुराः ।\nतथाप्याराध्य तपसा ब्रह्माणं त्वन्नियोगतः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001451055, "chapter_id": 21451, "verse_number": "७-१-२४-५६", "content_sanskrit": "पुरा किल सती नाम्ना दक्षस्य दुहिता ऽभवम् ।\nजगतां पतिमेवं त्वां पतिं प्राप्तवती तथा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001451056, "chapter_id": 21451, "verse_number": "७-१-२४-५७", "content_sanskrit": "एवमद्यापि तपसा तोषयित्वा द्विजं विधिम् ।\nगौरी भवितुमिच्छामि को दोषः कथ्यतामिह॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001451057, "chapter_id": 21451, "verse_number": "७-१-२४-५८", "content_sanskrit": "एवमुक्तो महादेव्या वामदेवः स्मयन्निव ।\nन तां निर्बंधयामास देवकार्यचिकीर्षया॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]