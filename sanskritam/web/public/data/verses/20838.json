[{"id": 7000838000, "chapter_id": 20838, "verse_number": "६-१८१-१", "content_sanskrit": "श्रीभगवानुवाच ।\nअथ ते वर्णयिष्यामि सप्तमाध्यायगौरवम् ।\nयदाकर्ण्य सुधापूर पूर्तिर्भवति कर्णयोः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000838001, "chapter_id": 20838, "verse_number": "६-१८१-२", "content_sanskrit": "अस्ति पाटलिपुत्राख्यं दुर्गमुत्तुङ्गगोपुरम् ।\nतत्राभूद्ब्राह्मणो नाम शंकुकर्णो दयार्णवः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000838002, "chapter_id": 20838, "verse_number": "६-१८१-३", "content_sanskrit": "वैश्यवृत्तिं समासाद्य धनमर्जितवान्बहु ।\nपितॄन्नतर्पयामास पूजयामास नो सुरान्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000838003, "chapter_id": 20838, "verse_number": "६-१८१-४", "content_sanskrit": "पार्थिवान्भोजयांश्चक्रे धनार्जनपरायणः ।\nतुरीयपाणिग्रहणं मंगलार्थं गृहांतरे॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000838004, "chapter_id": 20838, "verse_number": "६-१८१-५", "content_sanskrit": "तनुजैर्बंधुभिः सार्धं संप्रतस्थे कदाचन ।\nरजन्यां धर्मकल्पायां निद्रालोस्तस्य दोस्तले॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000838005, "chapter_id": 20838, "verse_number": "६-१८१-६", "content_sanskrit": "दशति स्म समागत्य दंदशूकः कुतश्चन ।\nस दष्टमात्रोऽसाध्यात्मा मणिमंत्रौषधादिभिः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000838006, "chapter_id": 20838, "verse_number": "६-१८१-७", "content_sanskrit": "क्षणैः कतिपयैरेव गतासुरभवत्ततः ।\nपिचुमंददलैर्नालैरवगुंठितविग्रहम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000838007, "chapter_id": 20838, "verse_number": "६-१८१-८", "content_sanskrit": "तमारोप्य तरुस्कंधे सूनवो गृहमाययुः ।\nततः कालेन बहुना ततो जातः सरीसृपः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000838008, "chapter_id": 20838, "verse_number": "६-१८१-९", "content_sanskrit": "तद्वासनानिबद्धात्मा जन्मपूर्वमनुस्मरन् ।\nवंचयित्वा सुतानेतान्पूरयामि गृहाद्बहिः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000838009, "chapter_id": 20838, "verse_number": "६-१८१-१०", "content_sanskrit": "आत्मनः कोटिसंख्याकं यत्रास्ते स्थापितं वसु ।\nततो नारायणबलिश्रद्धया परयान्विताः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000838010, "chapter_id": 20838, "verse_number": "६-१८१-११", "content_sanskrit": "कृतवंतः परे तस्य सूनवो हि द्विजन्मनः ।\nएकदा स्वप्नमागत्य पीडितः सर्पजन्मना॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000838011, "chapter_id": 20838, "verse_number": "६-१८१-१२", "content_sanskrit": "अभाषयन्मनोवृत्तं पुत्राणामग्रतः पिता ।\nततस्ते प्रातरुत्थाय परं विस्मयमोहिताः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000838012, "chapter_id": 20838, "verse_number": "६-१८१-१३", "content_sanskrit": "इतरेतरमाख्याय पर्यंतस्ते निरंकुशाः ।\nएकस्तत्रपितृस्नेहादुद्धर्तुमपि वांछति॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000838013, "chapter_id": 20838, "verse_number": "६-१८१-१४", "content_sanskrit": "अन्यो द्रविणलोभेन निहंतुं सर्पमीहते ।\nइतरस्तु पितृस्नेहरसमोहितमानसः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000838014, "chapter_id": 20838, "verse_number": "६-१८१-१५", "content_sanskrit": "किंवा अहिमयो न स्याच्छोचन्रोदिति केवलम् ।\nमध्यमस्तु ततः पुत्रो वंचयित्वा सहोदरौ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000838015, "chapter_id": 20838, "verse_number": "६-१८१-१६", "content_sanskrit": "केनापि छद्मनोत्थाय जगाम निजमालयम् ।\nततः शनैः समाहूय गृहिणीं गुणशालिनीम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000838016, "chapter_id": 20838, "verse_number": "६-१८१-१७", "content_sanskrit": "कुद्दालहस्तो निरगाद्यत्रास्ते पन्नगः पिता ।\nतेनाविदितवित्तेन चिह्नैर्निश्चित्य तत्वतः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000838017, "chapter_id": 20838, "verse_number": "६-१८१-१८", "content_sanskrit": "स्थानमागत्य तं हंतुं वल्मीकं लोभबुद्धितः ।\nभार्ययोत्सार्य ते मृत्स्ना स्वयं तेन च खन्यते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000838018, "chapter_id": 20838, "verse_number": "६-१८१-१९", "content_sanskrit": "निखन्यमानादत्युग्रो वल्मीकादहिरुत्थितः ।\nततो गरलगंडूषैर्निर्गतैरतिदुःसहैः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000838019, "chapter_id": 20838, "verse_number": "६-१८१-२०", "content_sanskrit": "गिरः स कथयांचक्रे फणी फूत्कारमारुतैः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000838020, "chapter_id": 20838, "verse_number": "६-१८१-२१", "content_sanskrit": "अहिरुवाच ।\nकस्त्वं किमर्थमायातः कथं वा खन्यते बिलम् ।\nकेन वा प्रहितो मूढ तदाख्याहि ममाग्रतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000838021, "chapter_id": 20838, "verse_number": "६-१८१-२२", "content_sanskrit": "पुत्र उवाच ।\nपुत्रस्तेऽहं शिवो नाम हेमग्रहणकौतुकी ।\nआगतो रात्रलब्धस्य स्वप्नस्य तु सुविस्मितः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000838022, "chapter_id": 20838, "verse_number": "६-१८१-२३", "content_sanskrit": "शिव उवाच ।\nइत्थमाकर्ण्य पुत्रस्य गिरं लोकविगर्हिताम् ।\nवक्तुमारभत स्पष्टं हसन्नुच्चैः फणी तदा॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000838023, "chapter_id": 20838, "verse_number": "६-१८१-२४", "content_sanskrit": "सर्प उवाच ।\nयदिपुत्रोऽसि मे तूर्णं मामुन्मोचय बंधनात् ।\nनिक्षेपार्थाय संजातं पन्नगं पूर्वजन्मनः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000838024, "chapter_id": 20838, "verse_number": "६-१८१-२५", "content_sanskrit": "पुत्र उवाच ।\nपितः कथं ते मुक्तिः स्यादित्याचक्ष्व ममाग्रतः ।\nपरित्यक्त्वाखिलं लोकमागतोस्मि यथा निशि॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000838025, "chapter_id": 20838, "verse_number": "६-१८१-२६", "content_sanskrit": "पितोवाच ।\nन तीर्थानि न दानानि न तपांसि न चाध्वराः ।\nमामुन्मोचयितुं पुत्र प्रभवंति च सर्वथा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000838026, "chapter_id": 20838, "verse_number": "६-१८१-२७", "content_sanskrit": "गीतानां सप्तमाध्यायमंतरेण सुधामयम् ।\nजंतोर्जरामृत्युदुःखनिराकरणकारणम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000838027, "chapter_id": 20838, "verse_number": "६-१८१-२८", "content_sanskrit": "सप्तमाध्यायिनं विप्रं मदीये श्राद्धवासरे ।\nभोजय श्रद्धया पुत्र तेन मुक्तिर्न संशयः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000838028, "chapter_id": 20838, "verse_number": "६-१८१-२९", "content_sanskrit": "अन्यानपि द्विजान्वत्स वेदविद्याविशारदान् ।\nसंभोजय यथाशक्ति परमश्रद्धयान्वितः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000838029, "chapter_id": 20838, "verse_number": "६-१८१-३०", "content_sanskrit": "इत्याकर्ण्य पितुर्वाक्यमुरगत्वमुपेयुषः ।\nते सर्वे सूनवो कुर्वन्यथादिष्टं ततोऽधिकम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000838030, "chapter_id": 20838, "verse_number": "६-१८१-३१", "content_sanskrit": "शंकुकर्णस्ततः श्रीमानुत्सृज्य तनुमौरगीम् ।\nकृत्वा विभागं पुत्राणां दिव्यंदेहमुपाददे॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000838031, "chapter_id": 20838, "verse_number": "६-१८१-३२", "content_sanskrit": "विभज्य दत्तं पित्राय द्रव्यं तत्कोटिसंख्यया ।\nतेन ते सूनवः सर्वे मुमुदुः साधुवृतयः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000838032, "chapter_id": 20838, "verse_number": "६-१८१-३३", "content_sanskrit": "वापीकूपसरोयज्ञदेवप्रासादहेतवे ।\nअन्नशालां ततः कुर्वन्पुत्रास्ते धर्मबुद्धयः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000838033, "chapter_id": 20838, "verse_number": "६-१८१-३४", "content_sanskrit": "सप्तमाध्याय जपतो मुक्तिभाजोभवंस्ततः ।\nषष्ठमिष्टतमं ज्ञात्वा निर्वाणार्पितदृष्टयः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]