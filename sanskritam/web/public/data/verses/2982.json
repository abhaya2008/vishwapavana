[{"id": 2093034, "chapter_id": 2982, "verse_number": "१३-११२-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो युधिष्ठिरे राजा भूयः शान्तनवं नृपम्।\nगोदानविस्तरं धीमान्पप्रच्छ विनयान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093035, "chapter_id": 2982, "verse_number": "१३-११२-२", "content_sanskrit": "गोप्रदानगुणान्सम्यक् पुनर्मे ब्रूहि भारत।\nन हि तृप्याम्यहं वीर शृण्वानोऽमृतमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093036, "chapter_id": 2982, "verse_number": "१३-११२-३", "content_sanskrit": "इत्युक्तो धर्मराजेन तदा शान्तनवो नृपः।\nसम्यगाह गुणांस्तस्मै गोप्रदानस्य केवलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093037, "chapter_id": 2982, "verse_number": "१३-११२-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093038, "chapter_id": 2982, "verse_number": "१३-११२-४", "content_sanskrit": "वत्सलां गुणसम्प्रन्ना तरुणीं वस्त्रसंयुताम्।\nदत्त्वेदृशीं गां विप्राय सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093039, "chapter_id": 2982, "verse_number": "१३-११२-५", "content_sanskrit": "असुर्या नाम ते लोका गां दत्त्वा तान्न गच्छति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093040, "chapter_id": 2982, "verse_number": "१३-११२-६", "content_sanskrit": "पीतोदकां जग्धतृणां नष्टक्षीरां निरिन्द्रियाम्।\nजरारोगोपसम्पन्नां जीर्णां वापीमिवाजलाम्।\nदत्त्वा तमः प्रविशति द्विजं क्लेशेन योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093041, "chapter_id": 2982, "verse_number": "१३-११२-७", "content_sanskrit": "रुष्टा दुष्टा व्याधिता दुर्बला वा\nनो दातव्या याश्च मूल्यैरदत्तैः।\nक्लेशैर्विप्रं योऽफलैः संयुनक्ति\nतस्याऽवीर्याश्चाफलाश्चैव लोकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093042, "chapter_id": 2982, "verse_number": "१३-११२-८", "content_sanskrit": "बलान्विताः शीलवीर्योपपन्नाः\nसर्वे प्रशंसन्ति सुगन्धवत्यः।\nयथा हि गङ्गा सरितां वरिष्ठा\nतथाऽर्जुनीनां कपिला वरिष्ठा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093043, "chapter_id": 2982, "verse_number": "१३-११२-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093044, "chapter_id": 2982, "verse_number": "१३-११२-९", "content_sanskrit": "कस्मात्समाने बहुलाप्रदाने\nसद्भिः प्रशस्तं कपिलाप्रदानम्।\nविशेषमिच्छामि महाप्रभावं\nश्रोतुं समर्थोस्मि भवान्प्रवक्तुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093045, "chapter_id": 2982, "verse_number": "१३-११२-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093046, "chapter_id": 2982, "verse_number": "१३-११२-१०", "content_sanskrit": "वृद्धानां ब्रुवतां श्रुत्वा कपिलानामथोद्भवम्।\nवक्ष्यामि तदशेषेण रोहिण्यो निर्मिता यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093047, "chapter_id": 2982, "verse_number": "१३-११२-११", "content_sanskrit": "प्रजाः सृजेति चादिष्टः पूर्वं दक्षः स्वयंभुवा।\nनासृजद्वृत्तिमेवाग्रे प्रजानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093048, "chapter_id": 2982, "verse_number": "१३-११२-१२", "content_sanskrit": "यथा ह्यमृतमाश्रित्य वर्तयन्ति दिवौकसः।\nतथा वृत्तिं समाश्रित्य वर्तयन्ति प्रजा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093049, "chapter_id": 2982, "verse_number": "१३-११२-१३", "content_sanskrit": "अचरेभ्यश्च भूतेभ्यश्चराः श्रेष्ठास्ततो नराः।\nब्राह्मणाश्च ततः श्रेष्ठास्तषु यज्ञाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093050, "chapter_id": 2982, "verse_number": "१३-११२-१४", "content_sanskrit": "यज्ञैराप्यायते सोमः स च गोषु प्रतिष्ठितः।\nताभ्यो देवाः प्रमोदन्ते प्रजानां वृत्तिरासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093051, "chapter_id": 2982, "verse_number": "१३-११२-१५", "content_sanskrit": "ततः प्रजासु सृष्टासु दक्षाद्यैः क्षुधिताः प्रजाः।\nप्रजापतिमुपाधावन्विनिश्चित्य चतुर्मखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093052, "chapter_id": 2982, "verse_number": "१३-११२-१६", "content_sanskrit": "प्रजातान्येव भूतानि प्राक्रोशन्वृत्तिकाङ्क्षया।\nवृत्तिदं चान्वपद्यन्त तृषिताः पितृमातृवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093053, "chapter_id": 2982, "verse_number": "१३-११२-१७", "content_sanskrit": "इतीदं मनसा गत्वा प्रजासर्गार्थमात्मनः।\nप्रजापतिर्बलाधानममृतं प्रापिबत्तदा।\nशंसतस्तस्य तृप्तिं तु गन्धात्सुरभिरुत्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093054, "chapter_id": 2982, "verse_number": "१३-११२-१८", "content_sanskrit": "मुखजा साऽसृजद्धातुः सुरभिर्लोकमातरम्।\nदर्शनीयरसं वृत्तिं सुरभिं मुखजां सुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093055, "chapter_id": 2982, "verse_number": "१३-११२-१९", "content_sanskrit": "साऽसृजत्सौरभेयीस्तु सुरभिर्लोकमातृकाः।\nसुवर्णवर्णाः कपिलाः प्रजानां वृत्तिधेनवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093056, "chapter_id": 2982, "verse_number": "१३-११२-२०", "content_sanskrit": "तासाममृतवृत्तीनां क्षरन्तीनां समन्ततः।\nबभूवामृतजः फेनः स्रवन्तीनामिवोर्मिजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093057, "chapter_id": 2982, "verse_number": "१३-११२-२१", "content_sanskrit": "स वत्समुखविभ्रष्टो भवस्य भुवि तिष्ठतः।\nशिरस्यवापतत्क्रुद्धः स तदैक्षत च प्रभुः।\nललाटप्रभवेणाक्ष्णा रोहिणीं प्रदहन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093058, "chapter_id": 2982, "verse_number": "१३-११२-२२", "content_sanskrit": "तत्तेजस्तु ततो रौद्रं कपिलां गां विशाम्पते।\nनानावर्णत्वमनयन्मेघानिव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093059, "chapter_id": 2982, "verse_number": "१३-११२-२३", "content_sanskrit": "यास्तु तस्मादपक्रम्य सोममेवाभिसंश्रिताः।\nयथोत्पन्नाः स्ववर्णस्था न नीताश्चान्यवर्णतां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093060, "chapter_id": 2982, "verse_number": "१३-११२-२४", "content_sanskrit": "अथ क्रुद्धं महादेवं प्रजापतिरभाषत।\nअमृतेनावसिक्तस्त्वं नोच्छिष्टं विद्यते गवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093061, "chapter_id": 2982, "verse_number": "१३-११२-२५", "content_sanskrit": "यथा ह्यमृतमादाय सोमो विष्यन्दते पुनः।\nतथा क्षीरं क्षरन्त्येता रोहिण्योऽमृतसम्भवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093062, "chapter_id": 2982, "verse_number": "१३-११२-२६", "content_sanskrit": "न दुष्यत्यनिलो नाग्निर्न सुवर्णं न चोदधिः।\nनामृतेनामृतं पीतं न वत्सैर्दुष्यते पयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093063, "chapter_id": 2982, "verse_number": "१३-११२-२७", "content_sanskrit": "इमाँल्लोकान्भरिष्यन्ति हविषा प्रस्रवेण च।\nआसामैश्वर्यमिच्छन्ति सर्वेऽमृतमयं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093064, "chapter_id": 2982, "verse_number": "१३-११२-२८", "content_sanskrit": "वृषभं च ददौ तस्मै भगवाँल्लोकभावनः।\nप्रसादयामास मनस्तेन रुद्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093065, "chapter_id": 2982, "verse_number": "१३-११२-२९", "content_sanskrit": "प्रीतश्चापि महादेवश्चकार वृषभं तदा।\nध्वजं च वाहनं चैव तस्मात्स वृषभध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093066, "chapter_id": 2982, "verse_number": "१३-११२-३०", "content_sanskrit": "ततो देवैर्महादेवस्तदा पशुपतिः कृतः।\nईश्वरः स गवां मध्ये वृषभाङ्कः प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093067, "chapter_id": 2982, "verse_number": "१३-११२-३१", "content_sanskrit": "एवमव्यग्रवर्णानां कपिलानां महौजसाम्।\nप्रदाने प्रथमः कल्पः सर्वासामेव कीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093068, "chapter_id": 2982, "verse_number": "१३-११२-३२", "content_sanskrit": "लोकज्येष्ठा लोकवृत्तिप्रवृत्ता\nरुद्रोद्भूताः सोमविष्यन्दभूताः।\nसौम्याः पुण्याः कामदाः प्राणदाश्च\nगा वै दत्त्वा सर्वकामप्रदः स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093069, "chapter_id": 2982, "verse_number": "१३-११२-३३", "content_sanskrit": "इदं गवां प्रभवविधानमुत्तमं\nपठन्सदा शुचिरपि मङ्गलप्रियः।\nविमुच्यते कलिकलुषेण मानवः\nप्रियान्सुतान्धनपशुमाप्नुयात्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093070, "chapter_id": 2982, "verse_number": "१३-११२-३४", "content_sanskrit": "हव्यं कव्यं तर्पणं शान्तिकर्म\nयानं वासो वृद्धबालस्य तुष्टिः।\nएतान्सर्वान्गोप्रदाने गुणान्वै\nदाता राजन्नाप्नुयाद्वै सदैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2093071, "chapter_id": 2982, "verse_number": "१३-११२-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2093072, "chapter_id": 2982, "verse_number": "१३-११२-३५", "content_sanskrit": "पितामहस्याथ निशम्य वाक्यं\nराजा सह भ्रातृभिराजमीढः।\nसुवर्णवर्णानडुहस्तथा गाः\nपार्थो ददौ ब्राह्मणसत्तमेभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2093073, "chapter_id": 2982, "verse_number": "१३-११२-३६", "content_sanskrit": "तथैव तेभ्योपि ददौ द्विजेभ्यो\nगवां सहस्राणि शतानि चैव।\nयज्ञान्समुद्धिश्य च दक्षिणार्थे\nलोकान्विजेतुं परमां च कीर्तिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2093074, "chapter_id": 2982, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वादशाधिकशततमोऽध्यायः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]