[{"id": 2071007, "chapter_id": 2495, "verse_number": "११-२७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071008, "chapter_id": 2495, "verse_number": "११-२७-१", "content_sanskrit": "ते समासाद्य गङ्गां तु शिवां पुण्यजलान्विताम्।\nह्लादिनीं च प्रसन्नां च महारूपां महावनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071009, "chapter_id": 2495, "verse_number": "११-२७-२", "content_sanskrit": "भूषणान्युत्तरीयाणि वेष्टनान्यवमुच्य च।\n`कवचानि विचित्राणि गङ्गामवजगाहिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071010, "chapter_id": 2495, "verse_number": "११-२७-३", "content_sanskrit": "ततः पितॄणां भ्रातॄणां पौत्राणां स्वजनस्य च।\nपुत्राणामार्यकाणां च पतीनां च कुरुस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071011, "chapter_id": 2495, "verse_number": "११-२७-४", "content_sanskrit": "उदकं चक्रिरे सर्वा रुदन्त्यो भृशदुःखिताः।\nसुहृदां चापि धर्मज्ञाः प्रचक्रुः सलिलक्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071012, "chapter_id": 2495, "verse_number": "११-२७-५", "content_sanskrit": "उदके क्रियमाणे तु वीराणां विरपत्निभिः।\nसूपतीर्थाऽभवद्गङ्गा भूयो विप्रससार च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071013, "chapter_id": 2495, "verse_number": "११-२७-६", "content_sanskrit": "तन्महोदधिसङ्काशं निरानन्दमनुत्सवम्।\nवीरपत्नीभिराकीर्णं गङ्गातीरमशोभत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071014, "chapter_id": 2495, "verse_number": "११-२७-७", "content_sanskrit": "ततः कुन्ती महाराज रुदन्ती शोककर्शिता।\nव्रीडया मन्दया वाचा पुत्रान्वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071015, "chapter_id": 2495, "verse_number": "११-२७-८", "content_sanskrit": "यः स वीरो महेष्वासो रथयूथपयूथपः।\nअर्जुनेन हतः सङ्ख्ये वीरलक्षणलक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071016, "chapter_id": 2495, "verse_number": "११-२७-९", "content_sanskrit": "यं सूतपुत्रं मन्यध्वं राधेयमिति पाण्डवाः।\nयो व्यराजच्चमूमध्ये दिवाकर इव प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071017, "chapter_id": 2495, "verse_number": "११-२७-१०", "content_sanskrit": "प्रत्ययुध्यत वः सर्वान्पुरा यः सपदानुगान्।\nदुर्योधनबलं सर्वं यः प्रकर्षन्व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071018, "chapter_id": 2495, "verse_number": "११-२७-११", "content_sanskrit": "यस्य नास्ति समो वीर्ये पृथिव्यामपि कश्चन।\nयो वृणीत यशः शूरः प्राणैरपि सदा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071019, "chapter_id": 2495, "verse_number": "११-२७-१२", "content_sanskrit": "कर्णस्य सत्यसन्धस्य सङ्ग्रामेष्वपलायिनः।\nकुरुध्वमुदकं तस्य भ्रातुरक्लिष्टकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071020, "chapter_id": 2495, "verse_number": "११-२७-१३", "content_sanskrit": "स हि वः पूर्वजो भ्राता भास्करान्मय्यजायत।\nकुण्डली कवची शूरो दिवाकरसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071021, "chapter_id": 2495, "verse_number": "११-२७-१४", "content_sanskrit": "श्रुत्वा तु पाण्डवाः सर्वे मातुर्वचनमप्रियम्।\nकर्णमेवानुशोचन्तो भूयश्चात्यातुरा भवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071022, "chapter_id": 2495, "verse_number": "११-२७-१५", "content_sanskrit": "ततः स पुरुषव्याघ्रः रुन्तीपुत्रो युधिष्ठिरः।\nउवाच मातरं वीरो निःश्वसन्निव पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071023, "chapter_id": 2495, "verse_number": "११-२७-१६", "content_sanskrit": "यः शरोर्मिर्ध्वजावर्तो महाभुजमहाग्रहः।\nतलशब्दप्रणुदितो महारथमहाग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071024, "chapter_id": 2495, "verse_number": "११-२७-१७", "content_sanskrit": "यस्येषुपातमासाद्य कोऽन्यस्तिष्ठेद्धनञ्जयात्।\nकथं पुत्रो भवत्याः स देवगर्भः पुराऽभवत्।\n`कुण्डली कवची शूरो दिवाकरसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071025, "chapter_id": 2495, "verse_number": "११-२७-१८", "content_sanskrit": "यस्य बाहुप्रतापेन तापिताः सर्वतो वयम्।\nतमग्निमिव वस्त्रेण कथं छादितवत्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071026, "chapter_id": 2495, "verse_number": "११-२७-१९", "content_sanskrit": "यस्य बाहुप्रभावेन वैरमस्मास्वरोचयत्।\nसुयोधनस्तु तं ज्येष्ठं कथं नोदितवत्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071027, "chapter_id": 2495, "verse_number": "११-२७-२०", "content_sanskrit": "तथा कर्णं महेष्वासं धार्तराष्ट्रैरुपासितम्।\nउपासितं यथाऽस्माभिर्बलं गाण्डीवधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071028, "chapter_id": 2495, "verse_number": "११-२७-२१", "content_sanskrit": "भूमिपानां च सर्वेषां बलं बलवतां वरः।\nनान्यः कुन्तीसुतात्कर्णादगृह्णाद्रथिनो रथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071029, "chapter_id": 2495, "verse_number": "११-२७-२२", "content_sanskrit": "स नः प्रथमजो भ्राता सर्वशस्त्रभृतां वरः।\nअसूत तं भवत्यग्रे कथमद्भुतविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071030, "chapter_id": 2495, "verse_number": "११-२७-२३", "content_sanskrit": "अहो भवत्या मन्त्रस्य गूहनेन वयं हताः।\nनिधनेन हि कर्णस्य पीडितास्तु सबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071031, "chapter_id": 2495, "verse_number": "११-२७-२४", "content_sanskrit": "अभिमन्योर्विनाशेन द्रौपदेयवधेन च।\nपाञ्चालानां विनाशेन, कुरूणां घातनादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071032, "chapter_id": 2495, "verse_number": "११-२७-२५", "content_sanskrit": "ततः शतगुणं दुःखमिदमापतितं महत्।\nकर्णमेवानुशोचापि दह्याम्यग्नाविवाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071033, "chapter_id": 2495, "verse_number": "११-२७-२६", "content_sanskrit": "नेह स्म किञ्चिदप्राप्य भवेदपि दिवि स्थितम्।\nन चेदं वैशसं घोरकं कौरवान्तकरं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071034, "chapter_id": 2495, "verse_number": "११-२७-२७", "content_sanskrit": "एवं विलप्य बहुलं धर्मराजो युधिष्ठिरः।\nव्यरुदच्छनकैः राजंश्चकारास्योदकं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071035, "chapter_id": 2495, "verse_number": "११-२७-२८", "content_sanskrit": "ततो विनेदुः सहसा स्त्रियस्ताः खलु सर्वशः।\nअभितो याः स्थितास्तत्र तस्मिन्नुदककर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071036, "chapter_id": 2495, "verse_number": "११-२७-२९", "content_sanskrit": "तत आनाययामास कर्णस्य सपरिच्छदाः।\nस्त्रियः कुरुपतिर्धीमान्भ्रातुः प्रेम्णा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071037, "chapter_id": 2495, "verse_number": "११-२७-३०", "content_sanskrit": "स ताभिः सह धर्मात्मा प्रेतकृत्यमनन्तरम्।\n`सर्वं चकार कर्णस्य विधिवद्भूरिदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071038, "chapter_id": 2495, "verse_number": "११-२७-३१", "content_sanskrit": "स राजा धृतराष्ट्रश्च कृत्वा जलमतन्द्रितः।\nसमुत्ततार गङ्गाया भार्यया सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071039, "chapter_id": 2495, "verse_number": "११-२७-३२", "content_sanskrit": "[पापेनासौ मया श्रेष्ठो भ्राता ज्ञातिर्निपातितः।\nअतो मनसि यद्गुह्यं स्त्रीणां तन्न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071040, "chapter_id": 2495, "verse_number": "११-२७-३३", "content_sanskrit": "इत्युक्त्वा स तु गङ्गाया उत्तताराकुलेन्द्रियः।\nभ्रातृभिः सहितः सर्वैर्गङ्गातीरमुपेयिवान्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071041, "chapter_id": 2495, "verse_number": "११-२७-१", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि श्राद्धपर्वणि सप्तविंशोऽध्यायः॥ २७ ॥\nअतः परंशान्तिपर्व भविष्यति तस्यायमाद्यः श्लोकः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071042, "chapter_id": 2495, "verse_number": "", "content_sanskrit": "वैशम्पायन उवाच।\nकृत्वोदकं ते सुहृदां सर्वेषां पाण्डुनन्दनाः।\nविदुरे धृतराष्ट्रश्च सर्वाश्च भरतस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]