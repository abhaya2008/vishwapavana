[{"id": 2099217, "chapter_id": 3124, "verse_number": "१३-२५४-१", "content_sanskrit": "वैशम्पायन उवाच।\nश्रुत्वा धर्मानशेषेण पावनानि च सर्वशः।\nयुधिष्ठिरः शान्तनवं पुनरेवाभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099218, "chapter_id": 3124, "verse_number": "१३-२५४-२", "content_sanskrit": "किमेकं दैवतं लोके किं वाऽप्येकं परायणम्।\nस्तुवन्तः कं कर्मर्चन्तः प्राप्नुयुर्मानवाः शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099219, "chapter_id": 3124, "verse_number": "१३-२५४-३", "content_sanskrit": "को धर्मः सर्वधर्माणां भवतः परमो मतः।\nकिं जपन्मुच्यते जन्तुर्जन्मसंसारबन्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099220, "chapter_id": 3124, "verse_number": "१३-२५४-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099221, "chapter_id": 3124, "verse_number": "१३-२५४-४", "content_sanskrit": "जगत्प्रभुं देवदेवमनन्तं पुरुषोत्तमम्।\nस्तुवन्नामसहस्रेण पुरुषः सततोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099222, "chapter_id": 3124, "verse_number": "१३-२५४-५", "content_sanskrit": "तमेव चार्चयन्नित्यं भक्त्या पुरुषमव्ययम्।\nध्यायन्स्तुवन्नमस्यंश्च यजमानस्तमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099223, "chapter_id": 3124, "verse_number": "१३-२५४-६", "content_sanskrit": "अनादिनिधनं विष्णुं सर्वलोकमहेश्वरम्।\nलोकाध्यक्षं स्तुवन्नित्यं सर्वदुःकातिगो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099224, "chapter_id": 3124, "verse_number": "१३-२५४-७", "content_sanskrit": "ब्रह्मण्यं सर्वधर्मज्ञं लोकानां कीर्तिवर्धनम्।\nलोकनाथं महद्भूतं सर्वबूतभवोद्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099225, "chapter_id": 3124, "verse_number": "१३-२५४-८", "content_sanskrit": "एष मे सर्वधर्माणां धर्मोऽधिकतमो मतः।\nयद्भक्त्या पुण्डरीकाक्षं स्तवैरर्चेन्नरः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099226, "chapter_id": 3124, "verse_number": "१३-२५४-९", "content_sanskrit": "परमं यो महत्तेजः परमं यो महत्तपः।\nपरमं यो महद्ब्रह्म परमं यः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099227, "chapter_id": 3124, "verse_number": "१३-२५४-१०", "content_sanskrit": "पवित्राणां पवित्रं यो मङ्गलानां च मङ्गलम्।\nदैवतं देवतानां च भूतानां योऽव्ययः पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099228, "chapter_id": 3124, "verse_number": "१३-२५४-११", "content_sanskrit": "यतः सर्वाणि भूतानि भवन्त्यादियुगागमे।\nयस्मिंश्च प्रलयं यान्ति पुनरेव युगक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099229, "chapter_id": 3124, "verse_number": "१३-२५४-१२", "content_sanskrit": "तस्य लोकप्रधानस्य जगन्नाथस्य भूपते।\nविष्णोर्नामसहस्रं मे शृणु पापभयापहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099230, "chapter_id": 3124, "verse_number": "१३-२५४-१३", "content_sanskrit": "यानि नामानि गौणानि विख्यातानि महात्मनः।\nऋषिभिः परिगीतानि तानि वक्ष्यामि भूतये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099231, "chapter_id": 3124, "verse_number": "१३-२५४-१४", "content_sanskrit": "`ऋषिर्नाम्नां सहस्रस्य देवव्यासो महामुनिः।\nछन्दोनुष्टुप्तथा देवो भगवान्देवकीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099232, "chapter_id": 3124, "verse_number": "१३-२५४-१५", "content_sanskrit": "अमुतांशूद्भवो बीजं शक्तिर्देवकिनन्दनः।\nत्रिसाम हृदयं तस्य शान्त्यर्थे विनियुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099233, "chapter_id": 3124, "verse_number": "१३-२५४-१६", "content_sanskrit": "ओं विश्वं विष्णुर्वषट्कारो भूतभव्यभवत्प्रभुः।\nभूतकृद्भूतभृद्भावो भूतात्मा भूतभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099234, "chapter_id": 3124, "verse_number": "१३-२५४-१७", "content_sanskrit": "पूतात्मा परमात्मा च मुक्तानां परमा गतिः।\nअव्ययः पुरुषः साक्षी क्षेत्रज्ञोऽक्षर एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099235, "chapter_id": 3124, "verse_number": "१३-२५४-१८", "content_sanskrit": "योगो योगविदांनेता प्रधानपुरुषेश्वरः।\nनरसिंहवपुः श्रीमान्केशवः पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099236, "chapter_id": 3124, "verse_number": "१३-२५४-१९", "content_sanskrit": "सर्वः शर्वः शिवः स्थाणुर्भूतादिर्निधिरव्ययः।\nसम्भवो भावनो भर्ता प्रभवः प्रभुरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099237, "chapter_id": 3124, "verse_number": "१३-२५४-२०", "content_sanskrit": "स्वयंभूः शंभुरादित्यः पुष्कराक्षो महास्वनः।\nअनादिनिधनो धाता विधाता धातुरुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099238, "chapter_id": 3124, "verse_number": "१३-२५४-२१", "content_sanskrit": "अप्रमेयो हृषीकेशः पद्मनाभोऽमरप्रभुः।\nविश्वकर्मा मनुस्त्वष्टा स्थविष्ठः स्थविरो ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099239, "chapter_id": 3124, "verse_number": "१३-२५४-२२", "content_sanskrit": "अग्राह्यः शाश्वतः कृष्णो लोहिताक्षः प्रतर्दनः।\nप्रभूतस्त्रिककुद्धाम पवित्रं मङ्गलं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099240, "chapter_id": 3124, "verse_number": "१३-२५४-२३", "content_sanskrit": "ईशानः प्राणदः प्राणो ज्येष्ठः श्रेष्ठः प्रजापतिः।\nहिरण्यगर्भो भूगर्भो माघवो मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099241, "chapter_id": 3124, "verse_number": "१३-२५४-२४", "content_sanskrit": "ईश्वरो विक्रमी धन्वी मेधावी विक्रमः क्रमः।\nअनुत्तमो दुराधर्षः कृतज्ञः कृतिरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099242, "chapter_id": 3124, "verse_number": "१३-२५४-२५", "content_sanskrit": "सुरेशः शरणं शर्म विश्वरेताः प्रजाभवः।\nअहः संवत्सरो व्यालः प्रत्ययः सर्वदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099243, "chapter_id": 3124, "verse_number": "१३-२५४-२६", "content_sanskrit": "अजः सर्वेश्वरः सिद्धः सिद्धिः सर्वादिरच्युतः।\nवृषाकपिरमेयात्मा सर्वयोगविनिःसृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099244, "chapter_id": 3124, "verse_number": "१३-२५४-२७", "content_sanskrit": "वसुर्वसुमनाः सत्यः समात्मा सम्मितः समः।\nअमोघः पुण्डरीकाक्षो वृषकर्मा वृषाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099245, "chapter_id": 3124, "verse_number": "१३-२५४-२८", "content_sanskrit": "रुद्रो बहुशिरा बभ्रुर्विश्वयोनिः शुचिश्रवाः।\nअमृतः शाश्वतः स्थापुर्वरारोहो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099246, "chapter_id": 3124, "verse_number": "१३-२५४-२९", "content_sanskrit": "सर्वगः सर्वविद्भानुर्विष्वक्सेनो जनार्दनः।\nवेदो वेदविदव्यङ्गो वेदाङ्गो वेदवित्कविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099247, "chapter_id": 3124, "verse_number": "१३-२५४-३०", "content_sanskrit": "लोकाध्यक्षः सुराध्यक्षो धर्माध्यक्षः कृताकृतः।\nचतुरात्मा चतुर्व्यूहश्चतुर्दंष्ट्रश्चतुर्भुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099248, "chapter_id": 3124, "verse_number": "१३-२५४-३१", "content_sanskrit": "भ्राजिष्णुर्भोजनं भोक्ता सहिष्णुर्जगदादिजः।\nअनघो विजयो जेता विश्वयोनिः पुनर्वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099249, "chapter_id": 3124, "verse_number": "१३-२५४-३२", "content_sanskrit": "उपेन्द्रो वामनः प्रांशुरमोघः शुचिरूर्जितः।\nअतीन्द्रः सङ्ग्रहः सर्गो धृतात्मा नियमोयमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099250, "chapter_id": 3124, "verse_number": "१३-२५४-३३", "content_sanskrit": "वेद्यो वैद्यः सदायोगी वीरहा माधवो मधुः।\nअतीन्द्रियो महामायो महोत्साहो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099251, "chapter_id": 3124, "verse_number": "१३-२५४-३४", "content_sanskrit": "महाबुद्धिर्महावीर्यो महाशक्तिर्महाद्युतिः।\nअनिर्देश्यवपुः श्रीमानमेयात्मा महाद्रिधृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099252, "chapter_id": 3124, "verse_number": "१३-२५४-३५", "content_sanskrit": "महेष्वासो महीभर्ता श्रीनिवासः सताङ्गतिः।\nअनिरुद्धः सुरानन्दो गोविन्दो गोविदाम्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099253, "chapter_id": 3124, "verse_number": "१३-२५४-३६", "content_sanskrit": "मरीचिर्दमनो हंसः सुपर्णो भुजगोत्तमः।\nहिरण्यनाभः सुतपाः पद्मनाभः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099254, "chapter_id": 3124, "verse_number": "१३-२५४-३७", "content_sanskrit": "अमृत्युः सर्वदृक्सिंहः सन्धाता सन्धिमान्स्थिरः।\nअजो दुर्मर्षणः शास्ता विश्रुतात्मा सुरारिहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099255, "chapter_id": 3124, "verse_number": "१३-२५४-३८", "content_sanskrit": "गुरुर्गरुतमो धाम सत्यः सत्यपराक्रमः।\nनिमिषोऽनिमिषः स्रग्वी वाचस्पतिरुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099256, "chapter_id": 3124, "verse_number": "१३-२५४-३९", "content_sanskrit": "अग्रणीर्ग्रामणीः श्रीमान्न्यायो नेता समीरणः।\nसहस्रमूर्धा विश्वात्मा सहस्राक्षः सहस्रपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099257, "chapter_id": 3124, "verse_number": "१३-२५४-४०", "content_sanskrit": "आवर्तनो निवृत्तात्मा संवृतः सम्प्रमर्दनः।\nअहः संवर्तको वह्निरनिलो धरणीधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099258, "chapter_id": 3124, "verse_number": "१३-२५४-४१", "content_sanskrit": "सुप्रसादः प्रसन्नात्मा विश्वदृग्विश्वभुग्विभुः।\nसत्कर्ता सत्कृतिः साधुर्जह्नुर्नारायणो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099259, "chapter_id": 3124, "verse_number": "१३-२५४-४२", "content_sanskrit": "असंख्येयोप्रमेयात्मा विशिष्टः शिष्टकृच्छुचिः।\nसिद्धार्थः सिद्धसङ्कल्पः सिद्धिदः सिद्धिसाधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099260, "chapter_id": 3124, "verse_number": "१३-२५४-४३", "content_sanskrit": "वृषाहिर्वृषभो विष्णुर्वृषपर्वा वृषोदरः।\nवर्धनो वर्धमानश्च विविक्तः श्रुतिसागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2099261, "chapter_id": 3124, "verse_number": "१३-२५४-४४", "content_sanskrit": "सुभुजो दुर्धरो वाग्मी महेन्द्रो वसुदो वसुः।\nनैकरूपो बृहद्रूपः शिपिविष्टः प्रकाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2099262, "chapter_id": 3124, "verse_number": "१३-२५४-४५", "content_sanskrit": "ओजस्तेजोद्युतिधरः प्रकाशात्मा प्रतापनः।\nऋद्धः स्पृष्टाक्षरो मन्त्रश्चन्द्रांशुर्भास्करद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2099263, "chapter_id": 3124, "verse_number": "१३-२५४-४६", "content_sanskrit": "अमृतांशूद्भवो भानुः शशबिन्दुः सुरेश्वरः।\nऔषधं जगतः सेतुः सत्यधर्मपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2099264, "chapter_id": 3124, "verse_number": "१३-२५४-४७", "content_sanskrit": "भूतभव्यभवन्नाथः पवनः पावनोऽनलः।\nकामहा कामकृत्कान्तः कामः कामप्रदः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2099265, "chapter_id": 3124, "verse_number": "१३-२५४-४८", "content_sanskrit": "युगादिकृद्युगावर्तो नैकमायो महाशनः।\nअदृश्यो व्यक्तरूपश्च सहस्रजिदनन्तजित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2099266, "chapter_id": 3124, "verse_number": "१३-२५४-४९", "content_sanskrit": "इष्टो विशिष्टः शिष्टेष्ट शिखण्डी नहुषो वृषः।\nक्रोधहा क्रोधकृत्कर्ता विश्वबाहुर्महीधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2099267, "chapter_id": 3124, "verse_number": "१३-२५४-५०", "content_sanskrit": "अच्युतः प्रथितः प्राणः प्राणदो वासवानुजः।\nअपांनिधिरधिष्ठानमप्रमत्तः प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2099268, "chapter_id": 3124, "verse_number": "१३-२५४-५१", "content_sanskrit": "स्कन्दः स्कन्दधरो धुर्यो वरदो वायुवाहनः।\nवासुदेवो बृहद्भानुरादिदेवः पुरंदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2099269, "chapter_id": 3124, "verse_number": "१३-२५४-५२", "content_sanskrit": "अशोकस्तारणस्तारः शूरः शौरिर्जनेश्वरः।\nअनुकूलः शतावर्तः पद्मी पद्मनिभेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2099270, "chapter_id": 3124, "verse_number": "१३-२५४-५३", "content_sanskrit": "पद्मनाबोऽरविन्दाक्षः पद्मगर्भः शरीरभृत्।\nमहर्द्धिर्ऋद्धो वृद्धात्मा महाक्षो गरुडध्वक्षः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2099271, "chapter_id": 3124, "verse_number": "१३-२५४-५४", "content_sanskrit": "अतुलः शरभो भीमः समयज्ञो हविर्हरिः।\nसर्वलक्षणलक्षण्यो लक्ष्मीवान्समितिंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2099272, "chapter_id": 3124, "verse_number": "१३-२५४-५५", "content_sanskrit": "विक्षरो रोहितो मार्गो हेतुर्दामोदरः सहः।\nमहीधरो महाभागो वेगवानमिताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2099273, "chapter_id": 3124, "verse_number": "१३-२५४-५६", "content_sanskrit": "उद्भवः क्षोभणो देवः श्रीगर्भः परमेश्वरः।\nकरणं कारणं कर्ता विकर्ता गहनो गुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2099274, "chapter_id": 3124, "verse_number": "१३-२५४-५७", "content_sanskrit": "व्यवसायो व्यवस्थानः संस्थानः स्थानदो ध्रुवः।\nपरर्द्धिः परमस्पष्टस्तुष्टः पुष्टः शुभेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2099275, "chapter_id": 3124, "verse_number": "१३-२५४-५८", "content_sanskrit": "रामो विरामो विरजो मार्गो नेयो नयोऽनयः।\nवीरः शक्तिमतांश्रेष्ठो धर्मो धर्मविदुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2099276, "chapter_id": 3124, "verse_number": "१३-२५४-५९", "content_sanskrit": "वैकुण्ठः पुरुषः प्राणः प्राणदः प्रणवः पृथुः।\nहिरण्यगर्भः शत्रुघ्नो व्याप्तो वायुरधोक्षजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2099277, "chapter_id": 3124, "verse_number": "१३-२५४-६०", "content_sanskrit": "ऋतुः सुदर्शनः कालः परमेष्ठी परिग्रहः।\nउग्रः संवत्सरो दक्षो विश्रामो विश्वदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2099278, "chapter_id": 3124, "verse_number": "१३-२५४-६१", "content_sanskrit": "विस्तारः स्थावरः स्थाणुः प्रमाणं बीजमव्ययम्।\nअर्थोऽनर्थो महाकोशो महाभोगो महाधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2099279, "chapter_id": 3124, "verse_number": "१३-२५४-६२", "content_sanskrit": "अनिर्विण्णः स्थविष्ठो भूर्धर्मयूपो महामखः।\nनक्षत्रनेमिर्नक्षत्री क्षमः क्षामः समीहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2099280, "chapter_id": 3124, "verse_number": "१३-२५४-६३", "content_sanskrit": "यज्ञ इज्यो महेज्यश्च क्रतुः सत्रं सताङ्गतिः।\nसर्वदर्शी वमुक्तात्मा सर्वज्ञो ज्ञानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2099281, "chapter_id": 3124, "verse_number": "१३-२५४-६४", "content_sanskrit": "सुव्रतः सुमुखः सूक्ष्मः सुघोषः सुखदः सुहृत्।\nमनोहरो जितक्रोधो वीरबाहुर्विदारणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2099282, "chapter_id": 3124, "verse_number": "१३-२५४-६५", "content_sanskrit": "स्वापनः स्ववशो व्यापी नैकात्मा नैककर्मकृत्।\nवत्सरो वत्सलो वत्सी रत्नगर्भो धनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2099283, "chapter_id": 3124, "verse_number": "१३-२५४-६६", "content_sanskrit": "धर्मगुब्धर्मकृद्धर्मी सदसत्क्षरमक्षरम्।\nअविज्ञाता सहस्रांशुर्विधाता कृतलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2099284, "chapter_id": 3124, "verse_number": "१३-२५४-६७", "content_sanskrit": "गभस्तिनेमिः सत्वस्थः सिंहो भूतमहेश्वरः।\nआदिदेवो महादेवो देवेशो देवभृद्गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2099285, "chapter_id": 3124, "verse_number": "१३-२५४-६८", "content_sanskrit": "उत्तरो गोपतिर्गोप्ता ज्ञानगम्यः पुरातनः।\nशरीरी भूतभृद्भोक्ता कपीन्द्रो भूरिदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2099286, "chapter_id": 3124, "verse_number": "१३-२५४-६९", "content_sanskrit": "सोमपोऽमृतपः सोमः पुरुजित्पुरुसत्तमः।\nविनयोज्यः सत्यसन्धो दाशार्हः सात्वतांपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2099287, "chapter_id": 3124, "verse_number": "१३-२५४-७०", "content_sanskrit": "जीवो विनयिता साक्षी मुकुन्दोऽमितविक्रमः।\nअम्भोनिधिरनन्तात्मा महोदधिशयोऽन्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2099288, "chapter_id": 3124, "verse_number": "१३-२५४-७१", "content_sanskrit": "अजो महार्हः स्वाभाव्यो जितामित्रः प्रमोदनः।\nआनन्दो नन्दनो नन्दः सत्यधर्मा त्रिविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2099289, "chapter_id": 3124, "verse_number": "१३-२५४-७२", "content_sanskrit": "महर्षिः कपिलाचार्य कृतज्ञो मेदिनीपतिः।\nत्रिपदस्त्रिदशाध्यक्षो महाशृङ्गः कृतान्तकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2099290, "chapter_id": 3124, "verse_number": "१३-२५४-७३", "content_sanskrit": "महावराहो गोविन्दः सुषेणः कनकाङ्गदी।\nगुह्यो गभीरो गहनो गुप्तश्चक्रगदाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2099291, "chapter_id": 3124, "verse_number": "१३-२५४-७४", "content_sanskrit": "वेधाः स्वाङ्गोऽजितः कृष्णो दृढः सङ्कर्षणोच्युतः।\nवरुणो वारुणो वृक्षः पुष्कराक्षो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2099292, "chapter_id": 3124, "verse_number": "१३-२५४-७५", "content_sanskrit": "भगवान्भगहा नन्दी वनमाली हलायुधः।\nआदित्यो ज्योतिरादित्यः सहिष्णुर्गतिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2099293, "chapter_id": 3124, "verse_number": "१३-२५४-७६", "content_sanskrit": "सुधन्वा खण्डपरशुर्दारुणो द्रविणप्रदः।\nदिवस्पृक्सर्वदृग्व्यासो वाचस्पतिरयोनिजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2099294, "chapter_id": 3124, "verse_number": "१३-२५४-७७", "content_sanskrit": "त्रिसामा सामगः साम निर्वाणं भेषजं भिषक्।\nसंन्यासकृच्छमः शान्तो निष्ठा शान्तिः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2099295, "chapter_id": 3124, "verse_number": "१३-२५४-७८", "content_sanskrit": "शुभाङ्गः शान्तिदः स्रष्टा कुमुदः कुवलेशयः।\nगोहितो गोपतिर्गोप्ता वृषभाक्षो वृषप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2099296, "chapter_id": 3124, "verse_number": "१३-२५४-७९", "content_sanskrit": "अनिवर्ती निवृत्तात्मा संक्षेप्ता क्षेमकृच्छिवः।\nश्रीवत्सवक्षाः श्रीवासः श्रीपतिः श्रीमतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2099297, "chapter_id": 3124, "verse_number": "१३-२५४-८०", "content_sanskrit": "श्रीदः श्रीशः श्रीनिवासः श्रीनिधिः श्रीविभावनः।\nश्रीधरः श्रीकरः श्रेयः श्रीमाँल्लोकत्रयाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2099298, "chapter_id": 3124, "verse_number": "१३-२५४-८१", "content_sanskrit": "स्वक्षः स्वङ्गः शतानन्दो नन्दिर्ज्योतिर्गणेश्वरः।\nविजितात्मा विधेयात्मा सत्कीर्तिश्छिन्नसंशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2099299, "chapter_id": 3124, "verse_number": "१३-२५४-८२", "content_sanskrit": "उदीर्णः सर्वतश्चक्षुरनीशः शाश्वतः स्थिरः।\nभूशयो भूषणो भूतिर्विशोकः शोकनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2099300, "chapter_id": 3124, "verse_number": "१३-२५४-८३", "content_sanskrit": "अर्चिष्मानर्चितः कुम्भो विशुद्धात्मा विशोधनः।\nअनिरुद्धोऽप्रतिरथः प्रद्युम्नोऽमितविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2099301, "chapter_id": 3124, "verse_number": "१३-२५४-८४", "content_sanskrit": "कालनेमिनिहा वीरः शौरिः सूरजनेश्वरः।\nत्रिलोकात्मा त्रिलोकेशः केशवः केशिहा हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2099302, "chapter_id": 3124, "verse_number": "१३-२५४-८५", "content_sanskrit": "कामदेवः कामपालः कामी कान्तः कृतागमः।\nअनिर्देश्यवपुर्विष्णुर्वीरोऽनन्तो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2099303, "chapter_id": 3124, "verse_number": "१३-२५४-८६", "content_sanskrit": "ब्रह्मण्यो ब्रह्मकृद्ब्रह्मा ब्रह्म ब्रह्मविवर्धनः।\nब्रह्मविद्ब्राह्मणो ब्रह्मी ब्रह्मज्ञो ब्राह्मणप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2099304, "chapter_id": 3124, "verse_number": "१३-२५४-८७", "content_sanskrit": "महाक्रमो महाकर्मा महातेजा महोरगः।\nमहाक्रतुर्महायज्वा महायज्ञो महाहविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2099305, "chapter_id": 3124, "verse_number": "१३-२५४-८८", "content_sanskrit": "स्तव्यः स्तवप्रियः स्तोत्रं स्तुतिःस्तोता रणप्रियः।\nपूर्णः पूरयिता पुण्यः पुण्यकीर्तिरनामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2099306, "chapter_id": 3124, "verse_number": "१३-२५४-८९", "content_sanskrit": "मनोजवस्तीर्थकरो वसुरेता वसुप्रदः।\nवसुप्रदो वासुदेवो वसुर्वसुमना हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2099307, "chapter_id": 3124, "verse_number": "१३-२५४-९०", "content_sanskrit": "सद्गतिः सत्कृतिः सत्ता सद्भूतिः सत्परायणः।\nशूरसेनो यदुश्रेष्ठः सन्निवासः सुयामुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2099308, "chapter_id": 3124, "verse_number": "१३-२५४-९१", "content_sanskrit": "भूतावासो वासुदेवः सर्वासुनिलयोऽनलः।\nदर्पहा दर्पहो दृप्तो दुर्धरोऽद्धाऽपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2099309, "chapter_id": 3124, "verse_number": "१३-२५४-९२", "content_sanskrit": "विश्वमूर्तिर्महमूर्तिर्दीप्तमूर्तिरमूर्तिमान्।\nअनेकमूर्तिरव्यक्तः शतमूर्तिः शताननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2099310, "chapter_id": 3124, "verse_number": "१३-२५४-९३", "content_sanskrit": "एको नैकः सवः कः किं यत्तत्पदमनुत्तमम्।\nलोकबन्धुर्लोकनाथो माधवो भक्तवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2099311, "chapter_id": 3124, "verse_number": "१३-२५४-९४", "content_sanskrit": "सुवर्णवर्णो हेमाङ्गो वराङ्गश्चन्दनाङ्गदी।\nवीरहा विषमः शून्यो घृताशीरचलश्चलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2099312, "chapter_id": 3124, "verse_number": "१३-२५४-९५", "content_sanskrit": "अमानी मानदो मान्यो लोकस्वामी त्रिलोकधृत्।\nसुमेधा मेघजो धन्यः सत्यमेधा धराधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2099313, "chapter_id": 3124, "verse_number": "१३-२५४-९६", "content_sanskrit": "तेजो वृषो द्युतिधरः सर्वशस्त्रभृतांवरः।\nप्रग्रहो निग्रहो व्यग्रो नैकशृङ्गो गदाग्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2099314, "chapter_id": 3124, "verse_number": "१३-२५४-९७", "content_sanskrit": "चतुर्मूर्तिश्चतुर्बाहुश्चतुर्व्यूहश्चतुर्गतिः।\nचतुरात्मा चतुर्भावश्चतुर्वदविदेकपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2099315, "chapter_id": 3124, "verse_number": "१३-२५४-९८", "content_sanskrit": "समावर्तो निवृत्तात्मा दुर्जयो दुरतिक्रमः।\nदुर्लभो दुर्गमो दुर्गो दुरावासो दुरारिहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2099316, "chapter_id": 3124, "verse_number": "१३-२५४-९९", "content_sanskrit": "शुभाङ्गो लोकसारङ्गः सुतन्तुस्तन्तुवर्धनः।\nइन्द्रकर्मा महाकर्मा कृतकर्मा कृतागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2099317, "chapter_id": 3124, "verse_number": "१३-२५४-१००", "content_sanskrit": "उद्भवः सुन्दरः सुन्दो रत्ननाभः सुलोचनः।\nअर्को वाजसनः शृङ्गी जयन्तः सर्वविज्जयी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2099318, "chapter_id": 3124, "verse_number": "१३-२५४-१०१", "content_sanskrit": "सुवर्णिबिन्दुरक्षोभ्यः सर्ववागीश्वरेश्वरः।\nमहाह्रदो महागर्तो महाभूतो महानिधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2099319, "chapter_id": 3124, "verse_number": "१३-२५४-१०२", "content_sanskrit": "कुमुदः कुन्दरः कुन्दः पर्जन्यः पवनोऽनिलः।\nअमृतांशोऽमृतवपुः सर्वज्ञः सर्वतोमुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2099320, "chapter_id": 3124, "verse_number": "१३-२५४-१०३", "content_sanskrit": "सुलभः सुव्रतः सिद्धः शत्रुजिच्छत्रुतापनः।\nन्यग्रोधोदुम्बरोश्वत्थश्चापूरान्ध्रनिषूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2099321, "chapter_id": 3124, "verse_number": "१३-२५४-१०४", "content_sanskrit": "सहस्रार्चिः सप्तजिह्वः सप्तैधाः सप्तवाहनः।\nअमूर्तिरनघोऽचिन्त्यो भयकृद्भयनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2099322, "chapter_id": 3124, "verse_number": "१३-२५४-१०५", "content_sanskrit": "अणुर्बृहत्कृशः स्थूलो गुणभृन्नर्गुणो महान्।\nअधृतः स्वधृतः स्वास्थ्यः प्राग्वंशो वंशवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2099323, "chapter_id": 3124, "verse_number": "१३-२५४-१०६", "content_sanskrit": "भारभृत्कथितो योगी योगीशः सर्वकामदः।\nआश्रमः श्रमणः क्षामः सुपर्णो वायुवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2099324, "chapter_id": 3124, "verse_number": "१३-२५४-१०७", "content_sanskrit": "धनुर्धरो धनुर्वेदो दण्डो दमयिता दमः।\nअपराजितः सर्वसहो नियन्ता नियमो यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2099325, "chapter_id": 3124, "verse_number": "१३-२५४-१०८", "content_sanskrit": "सत्ववान्सात्विकः सत्यः सत्यधर्मपरायणः।\nअभिप्रायः प्रियार्होऽर्हःऋ प्रियकृत्प्रीतिवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2099326, "chapter_id": 3124, "verse_number": "१३-२५४-१०९", "content_sanskrit": "विहायसगतिर्ज्योतिः सुरुचिर्हुतभुग्विभुः।\nरविर्विरोचनः सूर्यः सविता रविलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2099327, "chapter_id": 3124, "verse_number": "१३-२५४-११०", "content_sanskrit": "अन्तो हुतभुग्भोक्ता सुखदो नैकदोऽग्रजः।\nअनिर्विण्णः सदामर्षी लोकाधिष्ठानमद्भुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2099328, "chapter_id": 3124, "verse_number": "१३-२५४-१११", "content_sanskrit": "सनात्सनातनतमः कपिलः कपिरप्ययः।\nस्वस्तिदः स्वस्तिकृत्स्वस्ति स्वस्तिभुक् स्वस्तिदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2099329, "chapter_id": 3124, "verse_number": "१३-२५४-११२", "content_sanskrit": "अरौद्रः कुण्डली चक्री विक्रम्यूर्जितशासनः।\nशब्दातिगः शब्दसहः शिशिरः शर्वरीकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2099330, "chapter_id": 3124, "verse_number": "१३-२५४-११३", "content_sanskrit": "अक्रूरः पेशलो दक्षो दक्षिणः क्षमिणांवरः।\nविद्वत्तमो वीतभयः पुण्यश्रवणकीर्तनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2099331, "chapter_id": 3124, "verse_number": "१३-२५४-११४", "content_sanskrit": "उत्तारणो दुष्कृतिहा पुण्यो दुःखप्ननाशनः।\nवीरहा रक्षणः सन्तो जीवनः पर्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2099332, "chapter_id": 3124, "verse_number": "१३-२५४-११५", "content_sanskrit": "अनन्तरूपोऽनन्तश्रीर्जितमन्युर्भयापहः।\nचतुरस्रो गभीरात्मा विदिशो व्यादिशो दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2099333, "chapter_id": 3124, "verse_number": "१३-२५४-११६", "content_sanskrit": "अनादिर्भूर्भुवो लक्ष्मीः सुवीरो रुचिराङ्गदः।\nजननो जनजन्मादिर्भीमो भीमपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2099334, "chapter_id": 3124, "verse_number": "१३-२५४-११७", "content_sanskrit": "आधारनिलयो धाता पुष्पहासः प्रजागरः।\nऊर्ध्वगः सत्पथाचारः प्राणदः प्रणवः पणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2099335, "chapter_id": 3124, "verse_number": "१३-२५४-११८", "content_sanskrit": "प्रमाणं प्राणनिलयः प्राणभृत्प्राणजीवनः।\nतत्त्वं तत्त्वविदेकात्मा जन्ममृत्युजरातिगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2099336, "chapter_id": 3124, "verse_number": "१३-२५४-११९", "content_sanskrit": "भूर्भुवःस्वस्तरुस्तारः सविता प्रपितामहः।\nयज्ञो यज्ञपतिर्यज्वा यज्ञाङ्गो यज्ञवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2099337, "chapter_id": 3124, "verse_number": "१३-२५४-१२०", "content_sanskrit": "यज्ञभृद्यज्ञकृद्यज्ञी यज्ञभुग्यज्ञसाधनः।\nयज्ञान्तकृद्यज्ञगुह्यमन्नमन्नाद एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2099338, "chapter_id": 3124, "verse_number": "१३-२५४-१२१", "content_sanskrit": "आत्मयोनिः स्वयंजातो वैखानः सामगायनः।\nदेवकीनन्दनः स्रष्टा क्षितीशः पापनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2099339, "chapter_id": 3124, "verse_number": "१३-२५४-१२२", "content_sanskrit": "शङ्खभृन्नन्दकी चक्री शार्ङ्गधन्वा गदाधरः।\nरथाङ्गपाणिरक्षोभ्यः सर्वप्रहरणायुधः।\nसर्वप्रहारणायुध ओंनम इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2099340, "chapter_id": 3124, "verse_number": "१३-२५४-१२३", "content_sanskrit": "इतीदं कीर्तनीयस्यि केशवस्य महात्मनः।\nनाम्नां सहस्रं दिव्यानामशेषेण प्रकीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2099341, "chapter_id": 3124, "verse_number": "१३-२५४-१२४", "content_sanskrit": "य इदं शृणुयान्नित्यं यश्चापि परिकीर्तयेत्।\nनाशुभं प्राप्नुयात्किञ्चित्सोमुत्रेह च मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2099342, "chapter_id": 3124, "verse_number": "१३-२५४-१२५", "content_sanskrit": "वेदान्तो ब्राह्मणः स्यात्क्षत्रियो विजयी भवेत्।\nवैश्यो धनसमृद्धः स्याच्छूद्रः सुखमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2099343, "chapter_id": 3124, "verse_number": "१३-२५४-१२६", "content_sanskrit": "धर्मार्थी प्राप्नुयाद्धर्ममर्थार्थी चार्थमाप्नुयात्।\nकामानवाप्नुयात्कामी प्रजार्थी प्राप्नुयात्प्रजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2099344, "chapter_id": 3124, "verse_number": "१३-२५४-१२७", "content_sanskrit": "भक्तिमान्यः सदोत्थाय शुचिस्तद्गतमानसः।\nसहस्रं वासुदेवस्य नाम्नातेमत्प्रकीर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2099345, "chapter_id": 3124, "verse_number": "१३-२५४-१२८", "content_sanskrit": "यशः प्राप्नोति विपुलं ज्ञातिप्राधान्यमेव च।\nअचलां श्रियमाप्नोति श्रेयः प्राप्नोत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2099346, "chapter_id": 3124, "verse_number": "१३-२५४-१२९", "content_sanskrit": "न भयं क्वचिदाप्नोति वीर्यं तेजश्च विन्दति।\nभवत्ययोगो द्युतिमान्बलरूपगुणान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2099347, "chapter_id": 3124, "verse_number": "१३-२५४-१३०", "content_sanskrit": "रोगार्तो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात्।\nभयान्मुच्येत भीतस्तु मुच्येदापन्न आपदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2099348, "chapter_id": 3124, "verse_number": "१३-२५४-१३१", "content_sanskrit": "दुर्गाण्यतितरत्याशु पुरुषः पुरुषोत्तमम्।\nस्तुवन्नामसहस्रेण नित्यं भक्तिसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2099349, "chapter_id": 3124, "verse_number": "१३-२५४-१३२", "content_sanskrit": "वासुदेवाश्रयो मर्त्यो वासुदेवपरायणः।\nसर्वपापविशुद्धात्मा याति ब्रह्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2099350, "chapter_id": 3124, "verse_number": "१३-२५४-१३३", "content_sanskrit": "न वासुदेवभक्तानामशुभं विद्यते क्वचित्।\nजन्ममृत्युजराव्याधिभयं नैवोपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2099351, "chapter_id": 3124, "verse_number": "१३-२५४-१३४", "content_sanskrit": "इमं स्तवमधीयानः श्रद्धाभक्तिसमन्वितः।\nयुज्येतात्मसुखक्षान्तिश्रीधृतिस्मृतिकीर्तिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2099352, "chapter_id": 3124, "verse_number": "१३-२५४-१३५", "content_sanskrit": "न क्रोधो न च मात्सर्यं न लोभो नाशुभा मतिः।\nभन्ति कृतपुण्यानां भक्तानां पुरुषोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2099353, "chapter_id": 3124, "verse_number": "१३-२५४-१३६", "content_sanskrit": "द्यौः सचन्द्रार्कनक्षत्रा खं दिशो भूर्महोदधिः।\nवासुदेवस्य वीर्येण विधृतानि महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2099354, "chapter_id": 3124, "verse_number": "१३-२५४-१३७", "content_sanskrit": "ससुरासुरगन्धर्वं सयक्षोरगराक्षसम्।\nजगद्वशे वर्ततेदं कृष्णस्य सचराचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2099355, "chapter_id": 3124, "verse_number": "१३-२५४-१३८", "content_sanskrit": "इन्द्रियाणि मनो बुद्धिः सत्वं तेजो बलं धृतिः।\nवासुदेवात्मकान्याहुः क्षेत्रं क्षेत्रज्ञ एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2099356, "chapter_id": 3124, "verse_number": "१३-२५४-१३९", "content_sanskrit": "सर्वागमानामाचारः प्रथमं परिकल्प्यते।\nआचारप्रभवो धर्मो धर्मस्य प्रभुरच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2099357, "chapter_id": 3124, "verse_number": "१३-२५४-१४०", "content_sanskrit": "ऋषयः पितरो देवा महाभूतानि धातवः।\nजङ्गमाजङ्गमं चेदं जगन्नारयणोद्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2099358, "chapter_id": 3124, "verse_number": "१३-२५४-१४१", "content_sanskrit": "योगो ज्ञानं तथा साङ्ख्यं विद्याः शिल्पादिकर्म च।\nवेदाः सास्त्राणि विज्ञानमेतत्सर्वं जनार्दनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2099359, "chapter_id": 3124, "verse_number": "१३-२५४-१४२", "content_sanskrit": "एको विष्णुर्महद्भूतं पृथग्भूतान्यनेकशः।\nत्रींल्लोकान्व्याप्य भूतात्मा भुङ्क्ते विश्वभुगव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2099360, "chapter_id": 3124, "verse_number": "१३-२५४-१४३", "content_sanskrit": "इमं स्तवं भगवतो विष्णोर्व्यासेन कीर्तितम्।\nपठेद्य इच्छेत्पुरुषः श्रेयः प्राप्तुं सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2099361, "chapter_id": 3124, "verse_number": "१३-२५४-१४४", "content_sanskrit": "विश्वेश्वरमजं देवं जगतः प्रभवाप्ययम्।\nभजन्ति ये पुष्कराक्षं न ते यान्ति पराभवम्।\n`न ते यान्ति पराभवम् ओं नम इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2099362, "chapter_id": 3124, "verse_number": "१३-२५४-१४५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2099363, "chapter_id": 3124, "verse_number": "१३-२५४-१४५", "content_sanskrit": "पद्मपत्रविशालक्ष पद्मनाभ सुरोत्तम।\nभक्तानामनुरक्तानां त्राता भव जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2099364, "chapter_id": 3124, "verse_number": "१३-२५४-१४६x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2099365, "chapter_id": 3124, "verse_number": "१३-२५४-१४६", "content_sanskrit": "यो मां नामसहस्रेण स्तोतुमिच्छति पाण्डव।\nसोहमेकेन श्लोकेन स्तुत एव न संशयः।\nस्तुत एव न संशय ओं नम इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2099366, "chapter_id": 3124, "verse_number": "१३-२५४-१४७", "content_sanskrit": "वासनाद्वासुदेवः स्या वासितं ते जगत्त्रयम्।\nसर्वभूतनिवासोसि वासुदेव् नमोस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2099367, "chapter_id": 3124, "verse_number": "", "content_sanskrit": "नमोस्त्वनन्ताय सहस्रमूर्तये\nसहस्रपादाक्षिशिरोरुबाहवे।\nसहस्रनाम्ने पुरुषाय शाश्वते\nसहस्रकोटियुगधारिणे नमः।\nश्रीसहस्रकोटियुगधारिणे नम इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}]