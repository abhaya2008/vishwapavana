[{"id": 50006184, "chapter_id": 11327, "verse_number": "1", "content_sanskrit": "॥ पूर्वपक्षयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006185, "chapter_id": 11327, "verse_number": "2", "content_sanskrit": "औदार्यमुच्चावचशक्तिरात्मस्वरूपदार्ढ्यं च निजस्वभावः। स्वातन्त्र्यमापूर्णविशेषयोग्यता विरोधहानिश्च चतुर्थपादे॥ १२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006186, "chapter_id": 11327, "verse_number": "3", "content_sanskrit": "॥ सिद्धान्तयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006187, "chapter_id": 11327, "verse_number": "4", "content_sanskrit": "व्यवस्थितिस्त्वविशेषः स्थितिश्च निषेधसामान्यविधिक्रियाणाम्। विभक्तता चात्वरयैव सिद्धिर्विपक्षसम्प्राप्तिविरोधहेतवः 【पाठभेदः: BG—सिद्धिर्विपक्षसम्प्राप्तिविरुद्धहेतवः】 ॥ १२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]