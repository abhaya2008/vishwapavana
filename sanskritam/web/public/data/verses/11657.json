[{"id": 50020208, "chapter_id": 11657, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50020209, "chapter_id": 11657, "verse_number": "2", "content_sanskrit": "अष्टादशाक्षौहिणीनां तावद्भिर्मायया दिनैः। व्यापादनं येन कृतं तस्मै विश्वात्मने नमः॥ १०/९६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50020210, "chapter_id": 11657, "verse_number": "3", "content_sanskrit": "शृण्वतो मे कथास्तस्य चरितानि च सङ्घशः। वैक्ल्ब्यं विस्मयो भीतिर्वर्धते मे पुनःपुनः॥ १०/९६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50020211, "chapter_id": 11657, "verse_number": "4", "content_sanskrit": "मन्ये प्रायेण पाप्मानं क्षीणं मम दुरत्ययम्। इन्द्रियाणि प्रबुद्धानि प्रसन्नं च मनो भृशम्॥ १०/९६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50020212, "chapter_id": 11657, "verse_number": "5", "content_sanskrit": "क्षुत्तृष्णे च प्रशान्ते मे आत्मा चानन्दनिर्भरः। प्रसादात् तव धर्मज्ञ कृतार्थोऽहमिहाभवम्॥ १०/९६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50020213, "chapter_id": 11657, "verse_number": "6", "content_sanskrit": "अपि च श्रोतुमिच्छामि किञ्चिदर्थं तपोधन। युध्यतः सुहृदो दृष्ट्वा निवारितुमशक्नुवन्॥ १०/९६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50020214, "chapter_id": 11657, "verse_number": "7", "content_sanskrit": "तीर्थं स्नातुं गतो रामः किं चकार तपोधन॥ १०/९६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50020215, "chapter_id": 11657, "verse_number": "8", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50020216, "chapter_id": 11657, "verse_number": "9", "content_sanskrit": "तीर्थाभिषेकव्याजेन मध्यस्थः प्रययौ किल। स्नात्वा प्रभासं सर्न्तप्य देवर्षिपितृमानवान्॥ १०/९६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50020217, "chapter_id": 11657, "verse_number": "10", "content_sanskrit": "सरस्वतीं प्रतिस्रोतं ययौ ब्राह्मणसंवृतः। पृथूदकं बिन्दुसरस्त्रितकूपं सुदर्शनम्॥ १०/९६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50020218, "chapter_id": 11657, "verse_number": "11", "content_sanskrit": "विशालं ब्रह्मतीर्थं च चक्रं प्राचीसरस्वतीम्। यमुनामनु यात्येष गङ्गामनु च भारत॥ १०/९६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50020219, "chapter_id": 11657, "verse_number": "12", "content_sanskrit": "जगाम नैमिशं यत्र ऋषयः सत्रमासते। तमागतमभिप्रेत्य मुनयो दीर्घसत्रिणः। अभिवन्द्य यथान्यायं प्रणम्योत्थाय चार्चयन्॥ १०/९६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50020220, "chapter_id": 11657, "verse_number": "13", "content_sanskrit": "सोऽर्चितः सपरीवारः कृतासनपरिग्रहः। रोमहर्षणमासीनं शिष्यमैक्षन्महामुनेः॥ १०/९६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50020221, "chapter_id": 11657, "verse_number": "14", "content_sanskrit": "प्रत्यवस्थायिनं सूतमकृतप्रह्वणाञ्जलिम्। अध्यासीनं च तान् विप्रांश्चुकोपोद्वीक्ष्य माधवः॥ १०/९६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50020222, "chapter_id": 11657, "verse_number": "15", "content_sanskrit": "कस्मादसाविमान् विप्रानध्यास्ते प्रतिलोमजः। धर्मपालांस्तथैवास्मान् वधमर्हति दुर्मदः॥ १०/९६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50020223, "chapter_id": 11657, "verse_number": "16", "content_sanskrit": "ऋषेर्भगवतो भूत्वा शिष्योऽधीत्य बहूनि च। सेतिहासपुराणानि धर्मशास्त्राणि सर्वशः॥ १०/९६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50020224, "chapter_id": 11657, "verse_number": "17", "content_sanskrit": "अदान्तस्याविनीतस्य वृथा पण्डितमानिनः। न गुणाय भवन्त्यस्य नटस्येवाजितात्मनः॥ १०/९६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50020225, "chapter_id": 11657, "verse_number": "18", "content_sanskrit": "एतदर्थो हि लोकेस्मिन्नवतारो मया कृतः। वध्या मे धर्मध्वजिनस्ते हि पातकिनोऽधिकाः॥ १०/९६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50020226, "chapter_id": 11657, "verse_number": "19", "content_sanskrit": "एतावदुक्त्वा भगवान्निवृत्तोऽसद्वधादपि। भावित्वात् तं कुशाग्रेण करस्थेनाहनत् प्रभुः॥ १०/९६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50020227, "chapter_id": 11657, "verse_number": "20", "content_sanskrit": "हाहेति वादिनः सर्वे ऋषयः खिन्नमानसाः। ऊचुः सङ्कर्षणं देवमधर्मस्ते कृतः प्रभो॥ १०/९६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50020228, "chapter_id": 11657, "verse_number": "21", "content_sanskrit": "अस्य ब्रह्मासनं दत्तमस्माभिर्यदुनन्दन। आयुश्चास्याक्षयं तावद् यावत् सत्रं समाप्यते॥ १०/९६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50020229, "chapter_id": 11657, "verse_number": "22", "content_sanskrit": "अजानतेवाचरितं त्वया ब्रह्मवधो यथा। योगेश्वरस्य भवतो नाम्नायो विनियामकः॥ १०/९६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50020230, "chapter_id": 11657, "verse_number": "23", "content_sanskrit": "यद्येतद् ब्रह्महत्याया पावनं लोकपावन। चरिष्यति भवान् लोकसङ्ग्रहं नान्यचोदितः॥ १०/९६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50020231, "chapter_id": 11657, "verse_number": "24", "content_sanskrit": "बलभद्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50020232, "chapter_id": 11657, "verse_number": "25", "content_sanskrit": "चरिष्ये वधनिर्वेशं लोकानुग्रहकाम्यया। नियमः प्रथमे कल्पे यावान् स तु विधीयताम्॥ १०/९६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50020233, "chapter_id": 11657, "verse_number": "26", "content_sanskrit": "दीर्घमायुर्व्रतं तस्य सत्वमिन्द्रियमेव च। आशासितं यद्यदुत साधये योगमायया॥ १०/९६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50020234, "chapter_id": 11657, "verse_number": "27", "content_sanskrit": "ऋषय ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50020235, "chapter_id": 11657, "verse_number": "28", "content_sanskrit": "अस्त्रस्य तव वीर्यस्य मृत्योरस्माकमेव च। यथा भवेद् वचः सत्यं तथा राम विधीयताम्॥ १०/९६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50020236, "chapter_id": 11657, "verse_number": "29", "content_sanskrit": "बलभद्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50020237, "chapter_id": 11657, "verse_number": "30", "content_sanskrit": "आत्मा वै पुत्र उत्पन्न इति वेदानुशासनम्। तस्मादस्य भवेद् वक्ता आयुरिन्द्रियवीर्यवान्॥ १०/९६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50020238, "chapter_id": 11657, "verse_number": "31", "content_sanskrit": "किं वः कामो मुनिश्रेष्ठा ब्रूताहं करवाणि तत्। अजानतश्चापचितिं यथा मे बुध्यतां बुधाः॥ १०/९६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50020239, "chapter_id": 11657, "verse_number": "32", "content_sanskrit": "ऋषय उचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50020240, "chapter_id": 11657, "verse_number": "33", "content_sanskrit": "इल्वलस्य सुतो घोरो बल्वलो नाम दानवः। स दूषयति नः सर्वान् सत्रमेत्य च पर्वणि॥ १०/९६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50020241, "chapter_id": 11657, "verse_number": "34", "content_sanskrit": "तं पापं जहि दाशार्ह तन्नः शुश्रूषणं परम्। पूयशोणितविण्मूत्रसुरामांसाभिवर्षिणम्॥ १०/९६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50020242, "chapter_id": 11657, "verse_number": "35", "content_sanskrit": "ततश्च भारतं वर्षं परीत्य सुसमाहितः। चरित्वा द्वादशान् मासान् तीर्थस्नायी विशुध्यसे॥ १०/९६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50020243, "chapter_id": 11657, "verse_number": "36", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे षण्णवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]