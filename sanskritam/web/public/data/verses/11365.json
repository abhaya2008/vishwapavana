[{"id": 50006959, "chapter_id": 11365, "verse_number": "1", "content_sanskrit": "शौनक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006960, "chapter_id": 11365, "verse_number": "2", "content_sanskrit": "अश्वत्थाम्ना विसृष्टेन ब्रह्मशीर्ष्णोरुतेजसा। उत्तराया हतो गर्भ ईशेनोज्जीवितः पुनः॥ १/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006961, "chapter_id": 11365, "verse_number": "3", "content_sanskrit": "तस्य जन्म महाबुद्धेः कर्माणि च गृणीहि नः। निधनं च यथैवासीत् स प्रेत्य गतवान् यथा॥ १/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006962, "chapter_id": 11365, "verse_number": "4", "content_sanskrit": "तदिदं श्रोतुमिच्छामि वक्तुं वा यदि मन्यसे। ब्रूहि नः श्रद्दधानानां यस्य ज्ञानमदाच्छुकः॥ १/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006963, "chapter_id": 11365, "verse_number": "5", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006964, "chapter_id": 11365, "verse_number": "6", "content_sanskrit": "अपीपलद्धर्मराजः पितृवद्रञ्जयन् प्रजाः। निःस्पृहः सर्वकामेभ्यः कृष्णपादानुसेवया॥ १/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006965, "chapter_id": 11365, "verse_number": "7", "content_sanskrit": "सम्पदः क्रतवो विप्रा महिषी भ्रातरो मही। जम्बुद्वीपाधिपत्यं च यशश्च त्रिदिवं गतम्॥ १/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006966, "chapter_id": 11365, "verse_number": "8", "content_sanskrit": "किं ते कामातुरस्यार्था मुकुन्दमनसो द्विजाः। नाधिजह्रुर्मुदं राज्ञः क्षुधितस्य यथेतरे॥ १/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50006967, "chapter_id": 11365, "verse_number": "9", "content_sanskrit": "मातुर्गर्भगतो वीरः स तदा भृगुनन्दन। ददर्श पुरुषं कञ्चिद्दह्यमानोऽस्त्रतेजसा॥ १/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50006968, "chapter_id": 11365, "verse_number": "10", "content_sanskrit": "अङ्गुष्ठमात्रममलं स्फुरत्पुरटमौळिनम्। आवीच्यदर्शनं श्यामं तटिद्वाससमद्भुतम्॥ १/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50006969, "chapter_id": 11365, "verse_number": "11", "content_sanskrit": "श्रीमद्दीर्घचतुर्बाहुं तप्तकाञ्चनकुण्डलम्। क्षतजाक्षं गदापाणिमात्मनः सर्वतोदिशम्॥ १/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50006970, "chapter_id": 11365, "verse_number": "12", "content_sanskrit": "परिभ्रमन्तमुल्काभां भ्रामयन्तं गदां मुहुः। अस्त्रतेजः स्वगदया नीहारमिव गोपतिः। विधमन्तं सन्निकर्षे पर्यैक्षत क इत्यसौ॥ १/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50006971, "chapter_id": 11365, "verse_number": "13", "content_sanskrit": "विधूय तदमेयात्मा भगवान् धर्मगुब्विभुः। पश्यतो दशमास्यस्य तत्रैवान्तर्दधे हरिः॥ १/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50006972, "chapter_id": 11365, "verse_number": "14", "content_sanskrit": "ततः सर्वगुणोदर्के सानुकूलग्रहोदये। जज्ञे वंशधरः पाण्डोर्भूयः पाण्डुरिवौजसा॥ १/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50006973, "chapter_id": 11365, "verse_number": "15", "content_sanskrit": "तस्य प्रीतमना राजा विप्रैर्धौम्यकृपादिभिः। जातकं कारयामास वाचयित्वा च मङ्गळम्॥ १/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50006974, "chapter_id": 11365, "verse_number": "16", "content_sanskrit": "हिरण्यं गां महीं ग्रामान् हस्त्यश्वान्नृपतिर्वरान्। प्रादात् स्वन्नं च विप्रेभ्यः प्रजातीर्थे स तीर्थवित्॥ १/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50006975, "chapter_id": 11365, "verse_number": "17", "content_sanskrit": "तमूचुर्ब्राह्मणास्तुष्टा राजानं प्रश्रयानतम्। एष ह्यस्मिन् प्रजातन्तौ कुरूणां पौरवर्षभ॥ १/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50006976, "chapter_id": 11365, "verse_number": "18", "content_sanskrit": "दैवेनाप्रतिघातेन कुले संस्थामुपेयुषि। रातो वोऽनुग्रहार्थाय विष्णुना प्रभविष्णुना॥ १/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50006977, "chapter_id": 11365, "verse_number": "19", "content_sanskrit": "तस्मान्नाम्ना विष्णुरात इति लोके बृहच्छ्रवाः। भविष्यति न सन्देहो महाभागवतो महान्॥ १/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50006978, "chapter_id": 11365, "verse_number": "20", "content_sanskrit": "राजोवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50006979, "chapter_id": 11365, "verse_number": "21", "content_sanskrit": "अप्येष वंश्यान् राजर्षीन् पुण्यश्लोकान् महात्मनः। अनुवर्तिता स्विद्यशसा साधुवादेन सत्तमाः॥ १/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50006980, "chapter_id": 11365, "verse_number": "22", "content_sanskrit": "ब्राह्मणा ऊचुः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50006981, "chapter_id": 11365, "verse_number": "23", "content_sanskrit": "पार्थ प्रजाविता साक्षादिक्ष्वाकुरिव मानवः। ब्रह्मण्यः सत्यसन्धश्च रामो दाशरथिर्यथा॥ १/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50006982, "chapter_id": 11365, "verse_number": "24", "content_sanskrit": "एष दाता शरण्यश्च यथा ह्यौशीनरः शिबिः। यशो वितनिता स्वानां दौष्यन्तिरिव यज्वनाम्॥ १/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50006983, "chapter_id": 11365, "verse_number": "25", "content_sanskrit": "धन्विनामग्रणीरेषस्तुल्यश्चार्जुनयोर्द्वयोः। हुताश इव दुर्धर्षः समुद्र इव दुस्तरः॥ १/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50006984, "chapter_id": 11365, "verse_number": "26", "content_sanskrit": "मृगेन्द्र इव विक्रान्तो निषेव्यो हिमवानिव। तितिक्षुर्वसुधेवासौ सहिष्णुः पितराविव॥ १/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50006985, "chapter_id": 11365, "verse_number": "27", "content_sanskrit": "पितामहसमः साम्ये प्रसादे गिरिशोपमः। आश्रयः सर्वभूतानां यथा देवो रमाश्रयः॥ १/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50006986, "chapter_id": 11365, "verse_number": "28", "content_sanskrit": "सर्वसद्गुणमाहात्म्य एष कृष्णमनुव्रतः। रन्तिदेव इवोदारो ययातिरिव धार्मिकः॥ १/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50006987, "chapter_id": 11365, "verse_number": "29", "content_sanskrit": "धृत्यां बलिसमः कृष्णे प्रह्लाद इव सद्ग्रहः। आहर्तैषोऽश्वमेधानां वृद्धानां पर्युपासकः॥ १/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50006988, "chapter_id": 11365, "verse_number": "30", "content_sanskrit": "राजर्षीणां जनयिता शास्ता चोत्पथगामिनाम्। निग्रहीता कलेरेष भुवो धर्मस्य कारणात्॥ १/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50006989, "chapter_id": 11365, "verse_number": "31", "content_sanskrit": "तक्षकादात्मनो मृत्युं द्विजपुत्रोपसर्जितात्। प्रपत्स्यत उपश्रुत्य मुक्तसङ्गः पदं हरेः॥ १/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50006990, "chapter_id": 11365, "verse_number": "32", "content_sanskrit": "जिज्ञासितात्मयाथात्म्यो मुनेर्व्याससुतादसौ। हित्वेदं नृप गङ्गायां यास्यत्यद्धाऽकुतोभयम्॥ १/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50006991, "chapter_id": 11365, "verse_number": "33", "content_sanskrit": "इति राज्ञ उपादिश्य विप्रा जातककोविदाः। लब्धापचितयः सर्वे प्रतिजग्मुः स्वकान् गृहान्॥ १/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50006992, "chapter_id": 11365, "verse_number": "34", "content_sanskrit": "स एष लोके विख्यातः परीक्षिदिति यः प्रभुः। सर्पदृष्टिमनुध्यायन् परीक्षेत नरेष्विह॥ १/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50006993, "chapter_id": 11365, "verse_number": "35", "content_sanskrit": "स राजपुत्रो ववृध आशु शुक्ल इवोडुपः। आपूर्यमाणः पितृभिः काष्ठाभिरिव सोऽन्वहम्॥ १/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50006994, "chapter_id": 11365, "verse_number": "36", "content_sanskrit": "यक्ष्यमाणोऽश्वमेधेन ज्ञातिद्रोहजिहासया। राजाऽलब्धधनो दध्यावन्यत्र करदण्डयोः॥ १/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50006995, "chapter_id": 11365, "verse_number": "37", "content_sanskrit": "तदभिप्रेतमालक्ष्य भ्रातरोऽस्याच्युतेरिताः। धनं प्रहीणमाजह्रुरुदीच्या भूरिशो दिशः॥ १/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50006996, "chapter_id": 11365, "verse_number": "38", "content_sanskrit": "तेन सम्भृतसम्भारो लब्धकामो युधिष्ठिरः। वाजिमेधैस्त्रिभी राजा यज्ञेशमयजधरिम्॥ १/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50006997, "chapter_id": 11365, "verse_number": "39", "content_sanskrit": "आहूतो भगवान् राज्ञा याजयित्वा द्विजैर्नृपम्। उवास कतिचिन्मासान् सुहृदः प्रियकाम्यया॥ १/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50006998, "chapter_id": 11365, "verse_number": "40", "content_sanskrit": "ततो राज्ञाऽभ्यनुज्ञातः कृष्णया सह बन्धुभिः। ययौ द्वारवतीं ब्रह्मन् सार्जुनो यदुभिर्वृतः॥ १/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50006999, "chapter_id": 11365, "verse_number": "41", "content_sanskrit": "॥ इति श्रीमद्भागवते प्रथमस्कन्धे एकादशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]