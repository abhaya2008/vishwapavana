[{"id": 2073497, "chapter_id": 2553, "verse_number": "१२-५८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073498, "chapter_id": 2553, "verse_number": "१२-५८-१", "content_sanskrit": "ततः कल्यं समुत्थाय कृतपूर्वाह्णिकक्रियाः।\nययुस्ते नगराकारैः रथैः पाण्डवयादवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073499, "chapter_id": 2553, "verse_number": "१२-५८-२", "content_sanskrit": "प्रतिपद्य कुरुक्षेत्रं भीष्ममासाद्य चानघम्।\nसुखां च रजनीं पृष्ट्वा गाङ्गेयं रथिनां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073500, "chapter_id": 2553, "verse_number": "१२-५८-३", "content_sanskrit": "व्यासादीनभिवाद्यर्षीन्सर्वैस्तैश्चाभिनन्दिताः।\nनिषेदुरभितो भीष्मं परिवार्य समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073501, "chapter_id": 2553, "verse_number": "१२-५८-४", "content_sanskrit": "ततो राजा महातेजा धर्मपुत्रो युधिष्ठिरः।\nअब्रवीत्प्राञ्जलिर्भीष्मं प्रतिपूज्य यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073502, "chapter_id": 2553, "verse_number": "१२-५८-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073503, "chapter_id": 2553, "verse_number": "१२-५८-५", "content_sanskrit": "य एष राजन्राजेति शब्दश्चरति भारत।\nकथमेष समुत्पन्नस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073504, "chapter_id": 2553, "verse_number": "१२-५८-६", "content_sanskrit": "तुल्यपाणिभुजग्रीवस्तुल्यबुद्धीन्द्रियात्मकः।\nतुल्यदुःखसुखात्मा च तुल्यपृष्ठमुखोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073505, "chapter_id": 2553, "verse_number": "१२-५८-७", "content_sanskrit": "तुल्यशुक्रास्थिमज्जा च तुल्यमांसासृगेव च।\nनेःश्वासोच्छ्वासतुल्यश्च तुल्यप्राणशरीरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073506, "chapter_id": 2553, "verse_number": "१२-५८-८", "content_sanskrit": "समानजन्ममरणः समः सर्वैर्गुणैर्नृणाम्।\nविशिष्टबुद्धीञ्शूरांश्च कथमेकोऽधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073507, "chapter_id": 2553, "verse_number": "१२-५८-९", "content_sanskrit": "कथमेको महीं कृत्स्नां शूरवीरार्यसंकुलम्।\nरक्षत्यपि च लोकस्य प्रसादमभिवाञ्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073508, "chapter_id": 2553, "verse_number": "१२-५८-१०", "content_sanskrit": "एकस्य तु प्रसादेन कृत्स्नो लोकः प्रसीदति।\nव्याकुले चाकुलः सर्वो भवतीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073509, "chapter_id": 2553, "verse_number": "१२-५८-११", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं त्वत्तो हि भरतर्षभ।\nकृत्स्नं तन्मे यथातत्त्वं प्रब्रूहि वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073510, "chapter_id": 2553, "verse_number": "१२-५८-१२", "content_sanskrit": "नैतत्कारणमत्यल्पं भविष्यति विशांपते।\nयदेकस्मिञ्जगत्सर्वं देववद्याति सन्नतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073511, "chapter_id": 2553, "verse_number": "१२-५८-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073512, "chapter_id": 2553, "verse_number": "१२-५८-१३", "content_sanskrit": "नियतस्त्वं नरव्याघ्र शृणु सर्वमशेषतः।\nयथा राज्यं समुत्पन्नमादौ कृतयुगेऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073513, "chapter_id": 2553, "verse_number": "१२-५८-१४", "content_sanskrit": "नैव राज्यं न राजाऽऽसीन्न च दण्डो न दाण्डिकः।\nधर्मेणैव प्रजाः सर्वा रक्षन्ति स्म परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073514, "chapter_id": 2553, "verse_number": "१२-५८-१५", "content_sanskrit": "पाल्यमानास्तथाऽन्योन्यं नरा धर्मेण भारत।\nदैन्यं परमुपाजग्मुस्ततस्तान्मोह आविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073515, "chapter_id": 2553, "verse_number": "१२-५८-१६", "content_sanskrit": "ते मोहवशमापन्ना मनुजा मनुजर्षभ।\nप्रतिपत्तिविमोहाच्च धर्मस्तेषामनीनशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073516, "chapter_id": 2553, "verse_number": "१२-५८-१७", "content_sanskrit": "नष्टायां प्रतिपत्तौ च मोहवश्या नरास्तदा।\nलोभस्य वशमापन्नाः सर्वे भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073517, "chapter_id": 2553, "verse_number": "१२-५८-१८", "content_sanskrit": "अप्राप्तस्याभिमर्शं तु कुर्वन्तो मनुजास्ततः।\nकामो नामापरस्तत्र प्रत्यपद्यत वै प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073518, "chapter_id": 2553, "verse_number": "१२-५८-१९", "content_sanskrit": "तांस्तु कामवशं प्राप्तान्रागो नामाभिसंस्पृशत्।\nरक्ताश्च नाभ्यजानन्त कार्याकार्ये युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073519, "chapter_id": 2553, "verse_number": "१२-५८-२०", "content_sanskrit": "अगम्यागमनं चैव वाच्यावाच्यं तथैव च।\nभक्ष्याभक्ष्यं चराजेन्द्र दोषादोषं च नात्यजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073520, "chapter_id": 2553, "verse_number": "१२-५८-२१", "content_sanskrit": "विप्लुते नरलोकेऽस्मिंस्ततो ब्रह्म ननाश ह।\nनाशाच्च ब्रह्मणो राजन्धर्मो नाशमथागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073521, "chapter_id": 2553, "verse_number": "१२-५८-२२", "content_sanskrit": "नष्टे ब्रह्मणि धर्मे च देवास्त्रासमथागमन्।\nते त्रस्ता नरशार्दूल ब्रह्माणं शरणं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073522, "chapter_id": 2553, "verse_number": "१२-५८-२३", "content_sanskrit": "प्रपद्य भगवन्तं ते देवं लोकपितामहम्।\nऊचुः प्राञ्जलयः सर्वे दुःखवेगसमाहताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073523, "chapter_id": 2553, "verse_number": "१२-५८-२४", "content_sanskrit": "भगवन्नरलोकस्थं ग्रस्तं ब्रह्म सनातनम्।\nलोभमोहादिभिर्भावैस्ततो नो भयमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073524, "chapter_id": 2553, "verse_number": "१२-५८-२५", "content_sanskrit": "ब्रह्मणश्च प्रणाशेन धर्मो व्यनशदीश्चर।\nततस्तु समतां याता मर्त्यैस्त्रिभुवनेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073525, "chapter_id": 2553, "verse_number": "१२-५८-२६", "content_sanskrit": "अधोर्भिवर्षास्तु वयं भौमास्तूर्ध्वप्रवर्षिणः।\nक्रियाव्युपरमात्तेषां ततोऽगच्छाम संशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073526, "chapter_id": 2553, "verse_number": "१२-५८-२७", "content_sanskrit": "अत्र निःश्रेयसं यन्नस्तद्ध्यायस्व पितामह।\nत्वत्प्रसादात्समुत्थोसौ प्रभावो नो भवत्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073527, "chapter_id": 2553, "verse_number": "१२-५८-२८", "content_sanskrit": "तानुवाच सुरान्सर्वान्स्वयंभूर्भगवांस्ततः।\nश्रेयोऽहं चिन्तयिष्यामिव्येतु वो भीः सुरोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073528, "chapter_id": 2553, "verse_number": "१२-५८-२९", "content_sanskrit": "ततोऽध्यायसहस्राणां शतं चक्रे स्वबुद्धिजम्।\nयत्र धर्मस्तथैवार्थः कामश्चैवानुवर्णितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073529, "chapter_id": 2553, "verse_number": "१२-५८-३०", "content_sanskrit": "त्रिवर्ग इति विख्यातो गण एव स्वयंभुवा।\nचतुर्थो मोक्ष इत्येव पृथगर्थः पृथग्गुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073530, "chapter_id": 2553, "verse_number": "१२-५८-३१", "content_sanskrit": "मोक्षस्यास्ति त्रिवर्गोऽन्यः प्रोक्तः सत्वं रजस्तमः।\nस्थानं वृद्धिः क्षयश्चैव त्रिवर्गश्चैव दण्डजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073531, "chapter_id": 2553, "verse_number": "१२-५८-३२", "content_sanskrit": "आत्मादेशश्च कालश्चाप्युपायाः कृत्यमेव च।\nसहायाः कारणं चैव षड्वर्गो नीतिजः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073532, "chapter_id": 2553, "verse_number": "१२-५८-३३", "content_sanskrit": "त्रयी चान्वीक्षिकी चैव वार्ता च भरतर्षभ।\nदण्डनीतिश्च विपुला विद्यास्तत्र निदर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073533, "chapter_id": 2553, "verse_number": "१२-५८-३४", "content_sanskrit": "अमात्यलिप्सा प्रणिधी राजपुत्रस्य लक्षणम्।\nचारश्च विविधोपायः प्रणिधिश्च पृथग्विधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073534, "chapter_id": 2553, "verse_number": "१२-५८-३५", "content_sanskrit": "सामभेदः प्रदानं च ततो दण्डश्च पार्थिव।\nउपेक्षा पञ्चमी चात्र कार्त्स्न्येन समुदाहृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073535, "chapter_id": 2553, "verse_number": "१२-५८-३६", "content_sanskrit": "मन्त्रश्च वर्णितः कृत्स्नो मन्त्रभेदार्थ एव च।\nविभ्रमश्चैव मन्त्रस्य सिद्ध्यसिद्ध्योश्च यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073536, "chapter_id": 2553, "verse_number": "१२-५८-३७", "content_sanskrit": "संधिश्च त्रिविधाभिख्यो हीनो मध्यस्तथोत्तमः।\nभयसत्कारवित्ताख्यं कार्त्स्न्येन परिवर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073537, "chapter_id": 2553, "verse_number": "१२-५८-३८", "content_sanskrit": "यात्राकालाश्च चत्वारस्त्रिवर्गस्य च विस्तरः।\nविजयो धर्मयुक्तश्च तथार्थविजयश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073538, "chapter_id": 2553, "verse_number": "१२-५८-३९", "content_sanskrit": "आसुरश्चैव विजयः कार्त्स्न्येन परिवर्णितः।\nलक्षणं पञ्चवर्गस्य त्रिविधं चात्र वर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073539, "chapter_id": 2553, "verse_number": "१२-५८-४०", "content_sanskrit": "प्रकाशश्चाप्रकाशश्च दण़्डोऽथ परिशब्दितः।\nप्रकाशोऽष्टविधस्तत्र गुह्यश्च बहुविस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073540, "chapter_id": 2553, "verse_number": "१२-५८-४१", "content_sanskrit": "रथा नागा हयाश्चैव पादाताश्चैव पाण्डव।\nविष्टिर्नावश्चराश्चैव देशिका इति चाष्टमः।\nअङ्गान्येतानि कौरव्य प्रकाशानि बलस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073541, "chapter_id": 2553, "verse_number": "१२-५८-४२", "content_sanskrit": "जङ्गमाजङ्गमाश्चोक्ताश्चूर्णयोगा विषादयः।\nस्पर्शे चाभ्यवहार्ये चाप्युपांशुर्विविधः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2073542, "chapter_id": 2553, "verse_number": "१२-५८-४३", "content_sanskrit": "`क्रीडापूर्वे रणे द्यूते विस्रम्भणसमन्वितम्।\nउक्तं कैतव्यमित्येतदुपायो नवमो बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2073543, "chapter_id": 2553, "verse_number": "१२-५८-४४", "content_sanskrit": "उपेक्षा सर्वकार्येषु कर्मणां करणेषु च।\nअनिष्टानां समुत्थाने त्रिवर्गो नश्यते यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2073544, "chapter_id": 2553, "verse_number": "१२-५८-४५", "content_sanskrit": "इन्द्रजालादिका माया वाजीवनकुशीलवैः।\nसुनिमित्तैदुर्निमित्तैरुत्पातैश्च समन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2073545, "chapter_id": 2553, "verse_number": "१२-५८-४६", "content_sanskrit": "डम्भो लिङ्गं समाश्रित्य शत्रुवर्गे प्रयुज्यते।\nशाठ्यं निश्चेष्टता प्रोक्ता चित्तदोषप्रदूषिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2073546, "chapter_id": 2553, "verse_number": "१२-५८-४७", "content_sanskrit": "अरिर्मित्र उदासीन इत्येतेऽप्यनुवर्णिताः।\nकृत्स्ना मार्गगुणाश्चैव तथा भूमिगुणाश्च ह।\nआत्मरक्षणमाश्वासः स्पर्शानां चान्ववेक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2073547, "chapter_id": 2553, "verse_number": "१२-५८-४८", "content_sanskrit": "कल्पना विविधाश्चापि नृनागरथवाजिनाम्।\nव्यूहाश्च विविधाभिख्या विचित्रं युद्धकौशलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2073548, "chapter_id": 2553, "verse_number": "१२-५८-४९", "content_sanskrit": "उत्पाताश्च निपाताश्च सुयुद्धं सुपलायितम्।\nशस्त्राणां पालनं ज्ञानं तथैव भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2073549, "chapter_id": 2553, "verse_number": "१२-५८-५०", "content_sanskrit": "बलव्यसनयुक्तं च तथैव बलहर्षणम्।\nपीडा चापदकालश्च भयकालश्च पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2073550, "chapter_id": 2553, "verse_number": "१२-५८-५१", "content_sanskrit": "तथाख्यातविधानं च योगः संचार एव च।\nचोरैराटविकैश्चोग्रैः परराष्ट्रस्य पीडनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2073551, "chapter_id": 2553, "verse_number": "१२-५८-५२", "content_sanskrit": "अग्निदैर्गरदैश्चेव प्रतिरूपककारकैः।\nश्रेणिमुख्योपजापेन वीरुधश्छेदनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2073552, "chapter_id": 2553, "verse_number": "१२-५८-५३", "content_sanskrit": "दूषणेन च नागानामातङ्कजननेन च।\nआराधनेन भक्तस्य पत्युश्चोपग्रहेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2073553, "chapter_id": 2553, "verse_number": "१२-५८-५४", "content_sanskrit": "सप्ताङ्गस्य च राज्यस्य ह्रासवृद्धिसमीक्षणम्।\nदूतसामर्थ्ययोगश्च राष्ट्रस्य च विवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2073554, "chapter_id": 2553, "verse_number": "१२-५८-५५", "content_sanskrit": "अरिमध्यस्थमित्राणां सम्यक्चोक्तं प्रपञ्चनम्।\nअवमर्दः प्रतीघातस्तथैव च बलीयसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2073555, "chapter_id": 2553, "verse_number": "१२-५८-५६", "content_sanskrit": "व्यवहारः सुसूक्ष्मश्च तथा कण्टकशोधनम्।\nश्रमो व्यायामयोगश्च योगद्रव्यस्य सञ्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2073556, "chapter_id": 2553, "verse_number": "१२-५८-५७", "content_sanskrit": "अभृतानां च भरणं भृतानां चान्ववेक्षणम्।\nअन्तकाले प्रदानं च व्यसने चाप्रसङ्गिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2073557, "chapter_id": 2553, "verse_number": "१२-५८-५८", "content_sanskrit": "तथा राजगुणाश्चैव सेनापतिगुणाश्च ह।\nकरणस्य च कर्तुश्च गुणदोषास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2073558, "chapter_id": 2553, "verse_number": "१२-५८-५९", "content_sanskrit": "दुष्टेङ्गितं च विविधं वृत्तिश्चैवानुवर्तिनाम्।\nशङ्कितत्वं च सर्वस्य प्रमादस्य च वर्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2073559, "chapter_id": 2553, "verse_number": "१२-५८-६०", "content_sanskrit": "अलब्धलिप्सा लब्धस्य तथैव च विवर्धनम्।\nप्रदानं च विवृद्धस्य पात्रेभ्यो विधिवत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2073560, "chapter_id": 2553, "verse_number": "१२-५८-६१", "content_sanskrit": "विसर्गोऽर्थस्य धर्मार्थमर्थार्थं कामहेतुकम्।\nचतुर्थं व्यसनाघाते तथैवात्रानुवर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2073561, "chapter_id": 2553, "verse_number": "१२-५८-६२", "content_sanskrit": "क्रोधजानि ततोग्राणि कामजानि तथैव च।\nदशोक्तानि कुरुश्रेष्ठ व्यसनान्यत्र चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2073562, "chapter_id": 2553, "verse_number": "१२-५८-६३", "content_sanskrit": "मृगयाक्षास्तथा पानं स्त्रियश्च भरतर्षभ।\nकामजान्याहुराचार्याः प्रोक्तानीह स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2073563, "chapter_id": 2553, "verse_number": "१२-५८-६४", "content_sanskrit": "वाक्पारुष्यं तथोग्रत्व दण्डपारुष्यमेव च।\nआत्मनो निग्रहस्त्यागो ह्यर्थदूषणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2073564, "chapter_id": 2553, "verse_number": "१२-५८-६५", "content_sanskrit": "यन्त्राणि विविधान्येव क्रियास्तेषां च वर्णिताः।\nअवमर्दः प्रतीघातः केतनानां च भञ्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2073565, "chapter_id": 2553, "verse_number": "१२-५८-६६", "content_sanskrit": "चैत्यद्रुमावमर्दश्च रोधः कर्मान्तनाशनम्।\nअपस्करोऽथ वमनं तथोपास्या च वर्णिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2073566, "chapter_id": 2553, "verse_number": "१२-५८-६७", "content_sanskrit": "पणवानकशङ्खानां भेरीणां च युधिष्ठिर।\nउपार्जनं च द्रव्याणां परमर्म च तानि षट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2073567, "chapter_id": 2553, "verse_number": "१२-५८-६८", "content_sanskrit": "लब्धस्य च प्रशमनं सतां चैवाभिपूजनम्।\nविद्वद्भिरेकीभावश्च जपहोमविधिज्ञता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2073568, "chapter_id": 2553, "verse_number": "१२-५८-६९", "content_sanskrit": "मङ्गलालम्भनं चैव शरीरस्य प्रतिक्रिया।\nआहारयोजनं चैव नित्यमास्तिक्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2073569, "chapter_id": 2553, "verse_number": "१२-५८-७०", "content_sanskrit": "एकेन च यथोत्थेयं सत्यत्वं मधुरा गिरः।\nउत्तमानां समाजानां क्रियाः केतनजास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2073570, "chapter_id": 2553, "verse_number": "१२-५८-७१", "content_sanskrit": "प्रत्यक्षाश्च परोक्षाश्च सर्वाधिकरणेष्वथ।\nवृत्तेर्भरतशार्दूल नित्यं चैवान्ववेक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2073571, "chapter_id": 2553, "verse_number": "१२-५८-७२", "content_sanskrit": "अदण्ड्यत्वं च विप्राणां युक्त्या दण़्डनिपातनम्।\nअनुजीवि स्वजातिभ्यो गुणेभ्यश्च समुद्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2073572, "chapter_id": 2553, "verse_number": "१२-५८-७३", "content_sanskrit": "रक्षणं चैव पौराणां राष्ट्रस्य च विवर्धनम्।\nमण्डलस्था च या चिन्ता राजन्द्वादशराजिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2073573, "chapter_id": 2553, "verse_number": "१२-५८-७४", "content_sanskrit": "द्विसप्ततिमतिश्चैव प्रोक्ता या च स्वयंभुवा।\nदेशजातिकुलानां च धर्माः समनुवर्णिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2073574, "chapter_id": 2553, "verse_number": "१२-५८-७५", "content_sanskrit": "धर्मश्चार्थश्च कामश्च मोक्षश्चात्रानुवर्णिताः।\nउपायाश्चार्थलिप्सा च विविधा भूरिदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2073575, "chapter_id": 2553, "verse_number": "१२-५८-७६", "content_sanskrit": "मूलकर्मक्रिया चात्र मायायोगश्च वर्णितः।\nदूषणं स्रोतसां चैव वर्णितं च स्थिराम्भसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2073576, "chapter_id": 2553, "verse_number": "१२-५८-७७", "content_sanskrit": "यैर्यैरुपायैर्लोकस्तु न चलेदार्यवर्त्मनः।\nतत्सर्वं राजशार्दूल नीतिशास्त्रेऽभिवर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2073577, "chapter_id": 2553, "verse_number": "१२-५८-७८", "content_sanskrit": "एतत्कृत्वा सुभं शास्त्रं ततः स भगवान्प्रभुः।\nदेवानुवाच संहृष्टः सर्वाञ्छक्रपुरोगमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2073578, "chapter_id": 2553, "verse_number": "१२-५८-७९", "content_sanskrit": "उपकाराय लोकस्य त्रिवर्गस्थापनाय च।\nनवनीतं सरस्वत्या बुद्धिरेषा प्रभाषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2073579, "chapter_id": 2553, "verse_number": "१२-५८-८०", "content_sanskrit": "दण्डेन सहिता ह्येषा लोकरक्षणकारिका।\nनिग्रहानुग्रहरता लोकाननुचरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2073580, "chapter_id": 2553, "verse_number": "१२-५८-८१", "content_sanskrit": "दण्डेन नीयते चेदं दण्डं नयति वा पुनः।\nदण्डनीतिरितिख्याता त्रीँल्लोकानवपत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2073581, "chapter_id": 2553, "verse_number": "१२-५८-८२", "content_sanskrit": "पाङ्गुण्यगुणसारैषा स्थास्यत्यग्रे महात्मसु।\nधर्मार्थकाममोक्षाश्च सकला ह्यत्र शब्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2073582, "chapter_id": 2553, "verse_number": "१२-५८-८३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2073583, "chapter_id": 2553, "verse_number": "१२-५८-८३", "content_sanskrit": "ततस्तां भगवान्नीतिं पूर्वं जग्राह शंकरः।\nबहुरूपो विशालाक्षः शिवः स्थाणुरुमापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2073584, "chapter_id": 2553, "verse_number": "१२-५८-८४", "content_sanskrit": "अनादिनिधनो देवश्चैतन्यादिसमन्वितः।\nज्ञानानि च वशे यस्य तारकादीन्यशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2073585, "chapter_id": 2553, "verse_number": "१२-५८-८५", "content_sanskrit": "अणिमादिगुणोपेतमैश्वर्यं न च कृत्रिमम्।\nतुष्ट्यर्थं ब्रह्मणः पुत्रो ललाटादुत्थितः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2073586, "chapter_id": 2553, "verse_number": "१२-५८-८६", "content_sanskrit": "अरुदत्सस्वनं घोरं जगतः प्रभुरव्ययः।\nजायमानः पिता पुत्रे पुत्रः पितरि चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2073587, "chapter_id": 2553, "verse_number": "१२-५८-८७", "content_sanskrit": "बुद्धिं विश्वसृजे दत्त्वा ब्रह्माण्डं येन निर्मितम्।\nयस्मिन्हिरण्मयो हंसः शकुनिः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2073588, "chapter_id": 2553, "verse_number": "१२-५८-८८", "content_sanskrit": "कर्ता सर्वस्य लोकस्य ब्रह्मा लोकपितामहः।\nस देवः सर्वभूतानां महादेवः सनातनः।\nअसंख्यातसहस्राणां रुद्राणां स्थानमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2073589, "chapter_id": 2553, "verse_number": "१२-५८-८९", "content_sanskrit": "युगानामायुषो ह्रासं विज्ञाय भगवाञ्शिवः।\nसंचिक्षेप ततः शास्त्रं महास्त्रं ब्रह्मणा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2073590, "chapter_id": 2553, "verse_number": "१२-५८-९०", "content_sanskrit": "वैशालाक्षमिति प्रोक्तं तदिन्द्रः प्रत्यपद्यत।\nदशाध्यायसहस्राणि सुब्रह्मण्यो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2073591, "chapter_id": 2553, "verse_number": "१२-५८-९१", "content_sanskrit": "मघवानपि तच्छास्त्रं देवात्प्राप्य महेश्वरात्।\nप्रजानां हितमन्विच्छन्संचिक्षेप पुरंदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2073592, "chapter_id": 2553, "verse_number": "१२-५८-९२", "content_sanskrit": "सहस्त्रैः पञ्चभिस्तात यदुक्तं बाहुदन्तकम्।\nअध्यायानां सहस्त्रैस्तु त्रिभिरेव बृहस्पतिः।\nसंचिक्षेपेश्वरो बुद्ध्या बार्हस्पत्यं यदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2073593, "chapter_id": 2553, "verse_number": "१२-५८-९३", "content_sanskrit": "अध्यायानां सहस्रेण काव्यः संक्षेपमब्रवीत्।\nतच्छास्त्रममितप्रज्ञो योगाचार्यो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2073594, "chapter_id": 2553, "verse_number": "१२-५८-९४", "content_sanskrit": "एवं लोकानुरोधेन शास्त्रमेतन्महर्षिभिः।\nसंक्षिप्तमायुर्विज्ञाय लोकानां ह्रासि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2073595, "chapter_id": 2553, "verse_number": "१२-५८-९५", "content_sanskrit": "अथ देवाः समागम्य विष्णुमूचुः प्रजापतिम्।\nएको योऽर्हति मर्त्येभ्यः श्रैष्ठ्य वै तं समादिश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2073596, "chapter_id": 2553, "verse_number": "१२-५८-९६", "content_sanskrit": "ततः संचिन्त्य भगवान्देवो नारायणः प्रभुः।\nतैजसं वै विरजसं सोऽसृजन्मानसं सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2073597, "chapter_id": 2553, "verse_number": "१२-५८-९७", "content_sanskrit": "विरजास्तु महाभागः प्रभुत्वं भुवि नैच्छत।\nन्यासायैवाभवद्वुद्धिः प्रणीता तस्य पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2073598, "chapter_id": 2553, "verse_number": "१२-५८-९८", "content_sanskrit": "कीर्तिमांस्तस्य पुत्रोऽभूत्सोऽपि मर्त्याधिकोऽभवत्।\nकर्दमस्तस्य तु सुतः सोऽप्यतप्यन्महत्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2073599, "chapter_id": 2553, "verse_number": "१२-५८-९९", "content_sanskrit": "प्रजापतेः कर्दमस्य त्वनङ्गो नाम वीर्यवान्।\nप्रजा रक्षयिता साधुर्दण्डनीतिविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2073600, "chapter_id": 2553, "verse_number": "१२-५८-१००", "content_sanskrit": "अनङ्गपुत्रोऽतिबलो नीतिमानभिगम्य वै।\nप्रतिपेदे महाराज्यमथेन्द्रियवशोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2073601, "chapter_id": 2553, "verse_number": "१२-५८-१०१", "content_sanskrit": "`प्राप्य नारीं महाभागां रूपिणीं काममोहितः।\nसौभाग्येन च संपन्नां गुणैश्चानुत्तमां सतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2073602, "chapter_id": 2553, "verse_number": "१२-५८-१०२", "content_sanskrit": "मृत्योस्तु दुहिता राजन्सुनीथा नाम नामतः।\nप्रख्याता त्रिषु लोकेषु या सा वेनमजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2073603, "chapter_id": 2553, "verse_number": "१२-५८-१०३", "content_sanskrit": "तं प्रजासु विधर्माणं रागद्वेषवशानुगम्।\nमन्त्रपूतैः कुशैर्जघ्नुर्ऋषयो ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2073604, "chapter_id": 2553, "verse_number": "१२-५८-१०४", "content_sanskrit": "ममन्थुर्दक्षिणं चोरुमृषयस्तस्य भारत।\nततोऽस्य विकृतो जज्ञे ह्रस्वकः पुरुषोऽशुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2073605, "chapter_id": 2553, "verse_number": "१२-५८-१०५", "content_sanskrit": "दग्धस्थूणाप्रतीकाशो रक्ताक्षः कृष्णमूर्धजः।\nनिषीदेत्येवमूचुस्तमृषयो ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2073606, "chapter_id": 2553, "verse_number": "१२-५८-१०६", "content_sanskrit": "तस्मान्निषादाः संभूताः क्रूराः शैलवनाश्रयाः।\nये चान्ये विन्ध्यनिलया म्लेच्छाः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2073607, "chapter_id": 2553, "verse_number": "१२-५८-१०७", "content_sanskrit": "भूयोऽस्य दक्षिणं पाणिं ममन्थुस्ते महर्षयः।\nततः पुरुष उत्पन्नो रुपेणेन्द्र इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2073608, "chapter_id": 2553, "verse_number": "१२-५८-१०८", "content_sanskrit": "कवची बद्धनिस्त्रिंशः सशरः सशरासनः।\nवेदवेदाङ्गविच्चैव धनुर्वेदे च पारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2073609, "chapter_id": 2553, "verse_number": "१२-५८-१०९", "content_sanskrit": "तं दण्डनीतिः सकला श्रिता राजन्नरोत्तमम्।\nततस्तु प्राञ्जलिर्वैन्यो महर्षीस्तानुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2073610, "chapter_id": 2553, "verse_number": "१२-५८-११०", "content_sanskrit": "सुसूक्ष्मा मे समुत्पन्ना बुद्धिर्धरर्मार्थदर्शिनी।\nअनया किं मया कार्यं तन्मे तत्त्वेन शंसत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2073611, "chapter_id": 2553, "verse_number": "१२-५८-१११", "content_sanskrit": "यन्मां भवन्तो वक्ष्यन्ति कार्यमर्थसमन्वितम्।\nतदहं वः करिष्यामि नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2073612, "chapter_id": 2553, "verse_number": "१२-५८-११२", "content_sanskrit": "तमूचुस्तत्र देवास्ते ते चैव परमर्षयः।\nनियतो यत्र धर्मो वै तमशङ्कः समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2073613, "chapter_id": 2553, "verse_number": "१२-५८-११३", "content_sanskrit": "प्रियाप्रिये परित्यज्य समः सर्वेषु जन्तुषु।\nकामं क्रोधं च लोभं च मानं चोत्सृज्य दूरतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2073614, "chapter_id": 2553, "verse_number": "१२-५८-११४", "content_sanskrit": "यश्च धर्मात्प्रविचलेल्लोके कश्चन मानवः।\nनिग्राह्यस्ते स्वबाहुभ्यां शश्वद्धर्ममवेक्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2073615, "chapter_id": 2553, "verse_number": "१२-५८-११५", "content_sanskrit": "प्रतिज्ञां चाधिरोहस्व मनसा कर्मणा गिरा।\nपालयिष्याम्यहं भौमं ब्रह्म इत्येव चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2073616, "chapter_id": 2553, "verse_number": "१२-५८-११६", "content_sanskrit": "यश्चात्र धर्म इत्युक्तो दण्डनीतिव्यपाश्रयः।\nतमशङ्कः करिष्यामि स्ववशो न कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2073617, "chapter_id": 2553, "verse_number": "१२-५८-११७", "content_sanskrit": "अदण्ड्या मे द्विजाश्चेति प्रतिजानीष्व चाभिभो।\nलोकं च संकरात्कृत्स्नं त्राताऽस्मीति परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2073618, "chapter_id": 2553, "verse_number": "१२-५८-११८", "content_sanskrit": "वैन्यस्ततस्तानुवाच देवानृषिपुरोगमान्।\nब्राह्मणा मे सहायाश्चेदेवमस्तु सुरर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2073619, "chapter_id": 2553, "verse_number": "१२-५८-११९", "content_sanskrit": "एवमस्त्विति वैन्यस्तु तैरुक्तो ब्रह्मवादिभिः।\nपुरोधाश्चाभवत्तस्य शुक्रो ब्रह्ममयो निधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2073620, "chapter_id": 2553, "verse_number": "१२-५८-१२०", "content_sanskrit": "मन्त्रिणो वालखिल्याश्च सारस्वत्यो गणस्तथा।\nमहर्षिर्भगवान्गर्गस्तस्य सांवत्सरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2073621, "chapter_id": 2553, "verse_number": "१२-५८-१२१", "content_sanskrit": "आत्मनाऽष्टम इत्येव श्रुतिरेषां परा नृषु।\nउत्पन्नौ बन्दिनौ चास्य तत्पूर्वौ सूतमागधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2073622, "chapter_id": 2553, "verse_number": "१२-५८-१२२", "content_sanskrit": "तयो प्रीतो ददौ राजा पृथुर्वैन्यः प्रतापवान्।\nअनूपदेशं सूताय मगधं मागधाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2073623, "chapter_id": 2553, "verse_number": "१२-५८-१२३", "content_sanskrit": "समतां वसुधायाश्च स सम्यगुदपादयत्।\nवैषम्यं हि परं भूमेरिति नः परमा श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2073624, "chapter_id": 2553, "verse_number": "१२-५८-१२४", "content_sanskrit": "मन्वन्तरेषु सर्वेषु विषमा जायते मही।\nउज्जहार ततो वैन्यः शिलाजालान्समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2073625, "chapter_id": 2553, "verse_number": "१२-५८-१२५", "content_sanskrit": "धनुष्कोट्या महाराज तेन शैला विमर्दिताः।\nस विष्णुना च देवेन शक्रेण विबुधैः सह।\nऋषिभिश्च प्रजापाल्ये ब्रह्मणा चाभिषेचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2073626, "chapter_id": 2553, "verse_number": "१२-५८-१२६", "content_sanskrit": "तं साक्षात्पृथिवी भेजे रत्नान्यादाय पाण़्डव।\nसागरः सरितां भर्ता हिमवांश्चाचलोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2073627, "chapter_id": 2553, "verse_number": "१२-५८-१२७", "content_sanskrit": "शक्रश्च धनमक्षय्यं प्रादात्तस्मै युधिष्ठिर।\nरुक्मं चापि महामेरुः स्वयं कनकपर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2073628, "chapter_id": 2553, "verse_number": "१२-५८-१२८", "content_sanskrit": "यक्षराक्षसभर्ता च भगवान्नरवाहनः।\nधर्मे चार्थे च कामे च समर्थं प्रददौ धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2073629, "chapter_id": 2553, "verse_number": "१२-५८-१२९", "content_sanskrit": "हया रथाश्च नागाश्च कोटिशः पुरुषास्तथा।\nप्रादुर्बभूवुर्वैन्यस्य चिन्तयानस्य पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2073630, "chapter_id": 2553, "verse_number": "१२-५८-१३०", "content_sanskrit": "न जरा न च दुर्भिक्षं नाधयो व्याधयः कुतः।\nसरीसृपेभ्यः स्तेनेभ्यो न चान्येभ्यः कदाचन।\nभयमासीत्ततस्तस्य पृथिवी सस्यमालिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2073631, "chapter_id": 2553, "verse_number": "१२-५८-१३१", "content_sanskrit": "आपस्तस्तम्भिरे चास्य समुद्रमभियास्यतः।\nपर्वताश्च ददुर्मार्गं ध्वजभङ्गश्च नाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2073632, "chapter_id": 2553, "verse_number": "१२-५८-१३२", "content_sanskrit": "तेनेयं पृथिवी दुग्धा सस्यानि दश सप्त च।\nयक्षराक्षसनागानामीप्सितं यस्य यस्य यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2073633, "chapter_id": 2553, "verse_number": "१२-५८-१३३", "content_sanskrit": "तेन धर्मोत्तरश्चायं कृतो लोको महात्मना।\nरञ्जिताश्च प्रजाः सर्वास्तेन राजेति शब्द्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2073634, "chapter_id": 2553, "verse_number": "१२-५८-१३४", "content_sanskrit": "ब्राह्मणानां क्षतत्राणात्ततः क्षत्रिय उच्यते।\nप्रथिता धर्मतश्चेयं पृथिवी साधुभिः स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2073635, "chapter_id": 2553, "verse_number": "१२-५८-१३५", "content_sanskrit": "स्थापनं चाकरोद्विष्णुः स्वयमेव सनातनः।\nनातिवर्तिष्यते कश्चिद्राजंस्त्वामिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2073636, "chapter_id": 2553, "verse_number": "१२-५८-१३६", "content_sanskrit": "ततः स भगवान्विष्णुराविवेश च पार्थिवम्।\nदेववन्नरदेवानां नमतीदं जगत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2073637, "chapter_id": 2553, "verse_number": "१२-५८-१३७", "content_sanskrit": "दण्डनीत्या च सततं रक्षितारं नरेश्वरम्।\nनाधर्षयेत्तथा कश्चिच्चारनिष्पन्ददर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2073638, "chapter_id": 2553, "verse_number": "१२-५८-१३८", "content_sanskrit": "शुभं हि कर्म राजेन्द्र शुभत्वायोपकल्पते।\nआत्मना करणैश्चैव समस्येह महीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2073639, "chapter_id": 2553, "verse_number": "१२-५८-१३९", "content_sanskrit": "को हेतुर्यद्वशे तिष्ठेल्लोको दैवादृते गुणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2073640, "chapter_id": 2553, "verse_number": "१२-५८-१४१", "content_sanskrit": "विष्णोर्ललाटात्कमलं सौवर्णमभवत्तदा।\nश्रियः सकाशादर्थश्च जातो धर्मस्य पाण्डव।\nअथ धर्मस्तथैवार्थः श्रीश्च राज्ये प्रतिष्ठिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2073641, "chapter_id": 2553, "verse_number": "१२-५८-१४२", "content_sanskrit": "सुकृतस्य क्षयाच्चैव स्वर्लोकादेत्य मेदिनीम्।\nपार्थिवो जायते तात दण्डनीतिविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2073642, "chapter_id": 2553, "verse_number": "१२-५८-१४३", "content_sanskrit": "माहात्म्येन च संयुक्तो वैष्णवेन नरो भुवि।\nबुद्ध्या भवति संयुक्तो माहात्म्यं चाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2073643, "chapter_id": 2553, "verse_number": "१२-५८-१४४", "content_sanskrit": "स्थापितं च ततो देवैर्न कश्चिदतिवर्तते।\nतिष्ठत्येकस्य च वशे तं चैवानुविधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2073644, "chapter_id": 2553, "verse_number": "१२-५८-१४५", "content_sanskrit": "शुभं हि कर्म राजेन्द्र शुभत्वायोपकल्पते।\nतुल्यस्यैकस्य येनायं लोको वचसि तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2073645, "chapter_id": 2553, "verse_number": "१२-५८-१४६", "content_sanskrit": "योऽस्य वै मुखमद्राक्षीत्सोऽस्य सर्वो वशानुगः।\nसुभगं चार्थवन्तं च रूपवन्तं च पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2073646, "chapter_id": 2553, "verse_number": "१२-५८-१४७", "content_sanskrit": "महत्त्वात्तस्य दण्डस्य नीतिर्विस्पष्टलक्षणा।\nनयश्चारश्च विपुलो येन सर्वमिदं ततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2073647, "chapter_id": 2553, "verse_number": "१२-५८-१४८", "content_sanskrit": "आगमश्च पुराणानां महर्षीणां च संभवः।\nतीर्थवंशश्च वंशश्च क्षत्रियाणां युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2073648, "chapter_id": 2553, "verse_number": "१२-५८-१४९", "content_sanskrit": "सकलं चातुराश्रम्यं चातुर्होत्रं तथैव च।\nचातुर्वर्ण्यं तथैवात्र चातुर्विद्यं च कीर्तिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2073649, "chapter_id": 2553, "verse_number": "१२-५८-१५०", "content_sanskrit": "इतिहासोपवेदाश्च न्यायः कृत्स्नश्च वर्णितः।\nतपो ज्ञानमर्हिसा च सत्यं दानममत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2073650, "chapter_id": 2553, "verse_number": "१२-५८-१५१", "content_sanskrit": "वृद्धोपसेवा दानं च शौचमुत्थानमेव च।\nसर्वभूतानुकम्पा च सर्वमत्रोपवर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2073651, "chapter_id": 2553, "verse_number": "१२-५८-१५२", "content_sanskrit": "भुवि वाचोगतं यच्च तच्च सर्वं समर्पितम्।\nतस्मिन्पैतामहे शास्त्रे पाण्डवेय न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2073652, "chapter_id": 2553, "verse_number": "१२-५८-१५३", "content_sanskrit": "ततो जगति राजेन्द्र सततं शब्दितं बुधैः।\nदेवाश्च नरदेवाश्च तुल्या इति विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2073653, "chapter_id": 2553, "verse_number": "१२-५८-१५४", "content_sanskrit": "एतत्ते सर्वमाख्यातं महत्त्वं प्रति राजसु।\nकार्त्स्न्येन भरतश्रेष्ठ किमन्यदिह वर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2073654, "chapter_id": 2553, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टपञ्चाशोऽध्यायः॥ ५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}]