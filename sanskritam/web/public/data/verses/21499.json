[{"id": 7001499000, "chapter_id": 21499, "verse_number": "७-२-३७-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nज्ञाने क्रियायां चर्यायां सारमुद्धृत्य संग्रहात् ।\nउक्तं भगवता सर्वं श्रुतं श्रुतिसमं मया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001499001, "chapter_id": 21499, "verse_number": "७-२-३७-२", "content_sanskrit": "इदानीं श्रोतुमिच्छामि योगं परमदुर्लभम् ।\nसाधिकारं च सांगं च सविधिं सप्रयोजनम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001499002, "chapter_id": 21499, "verse_number": "७-२-३७-३", "content_sanskrit": "यद्यस्ति मरणं पूर्वं योगाद्यनुपमर्दतः ।\nसद्यः साधयितुं शक्यं येन स्यान्नात्महा नरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001499003, "chapter_id": 21499, "verse_number": "७-२-३७-४", "content_sanskrit": "तच्च तत्कारणं चैव तत्कालकरणानि च ।\nतद्भेदतारतम्यं च वक्तुमर्हसि तत्त्वतः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001499004, "chapter_id": 21499, "verse_number": "७-२-३७-५", "content_sanskrit": "उपमन्युरुवाच ।\nस्थाने पृष्टं त्वया कृष्ण सर्वप्रश्नार्थवेदिना ।\nततः क्रमेण तत्सर्वं वक्ष्ये शृणु समाहितः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001499005, "chapter_id": 21499, "verse_number": "७-२-३७-६", "content_sanskrit": "निरुद्धवृत्त्यंतरस्यं शिवे चित्तस्य निश्चला ।\nया वृत्तिः स समासेन योगः स खलु पञ्चधा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001499006, "chapter_id": 21499, "verse_number": "७-२-३७-७", "content_sanskrit": "मंत्रयोगःस्पर्शयोगो भावयोगस्तथापरः ।\nअभावयोगस्सर्वेभ्यो महायोगः परो मतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001499007, "chapter_id": 21499, "verse_number": "७-२-३७-८", "content_sanskrit": "मंत्राभ्यासवशेनैव मंत्रवाच्यार्थगोचरः ।\nअव्याक्षेपा मनोवृत्तिर्मंत्रयोग उदाहृतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001499008, "chapter_id": 21499, "verse_number": "७-२-३७-९", "content_sanskrit": "प्राणायाममुखा सैव स्पर्शे योगोभिधीयते ।\nस मंत्रस्पर्शनिर्मुक्तो भावयोगः प्रकीर्तितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001499009, "chapter_id": 21499, "verse_number": "७-२-३७-१०", "content_sanskrit": "विलीनावयवं विश्वं रूपं संभाव्यते यतः ।\nअभावयोगः संप्रोक्तो ऽनाभासाद्वस्तुनः सतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001499010, "chapter_id": 21499, "verse_number": "७-२-३७-११", "content_sanskrit": "शिवस्वभाव एवैकश्चिंत्यते निरुपाधिकः ।\nयथा शैवमनोवृत्तिर्महायोग इहोच्यते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001499011, "chapter_id": 21499, "verse_number": "७-२-३७-१२", "content_sanskrit": "दृष्टे तथानुश्रविके विरक्तं विषये मनः ।\nयस्य तस्याधिकारोस्ति योगे नान्यस्य कस्यचित्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001499012, "chapter_id": 21499, "verse_number": "७-२-३७-१३", "content_sanskrit": "विषयद्वयदोषाणां गुणानामीश्वरस्य च ।\nदर्शनादेव सततं विरक्तं जायते मनः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001499013, "chapter_id": 21499, "verse_number": "७-२-३७-१४", "content_sanskrit": "अष्टांगो वा षडंगो वा सर्वयोगः समासतः ।\nयमश्च नियमश्चैव स्वस्तिकाद्यं तथासनम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001499014, "chapter_id": 21499, "verse_number": "७-२-३७-१५", "content_sanskrit": "प्राणायामः प्रत्याहारो धारणा ध्यानमेव च ।\nसमाधिरिति योगांगान्यष्टावुक्तानि सूरिभिः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001499015, "chapter_id": 21499, "verse_number": "७-२-३७-१६", "content_sanskrit": "आसनं प्राणसंरोधः प्रत्याहारोथ धारणा ।\nध्यानं समाधिर्योगस्य षडंगानि समासतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001499016, "chapter_id": 21499, "verse_number": "७-२-३७-१७", "content_sanskrit": "पृथग्लक्षणमेतेषां शिवशास्त्रे समीरितम् ।\nशिवागमेषु चान्येषु विशेषात्कामिकादिषु॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001499017, "chapter_id": 21499, "verse_number": "७-२-३७-१८", "content_sanskrit": "योगशास्त्रेष्वपि तथा पुराणेष्वपि केषु च ।\nअहिंसा सत्यमस्तेयं ब्रह्मचर्यापरिग्रहः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001499018, "chapter_id": 21499, "verse_number": "७-२-३७-१९", "content_sanskrit": "यम इत्युच्यते सद्भिः पञ्चावयवयोगतः ।\nशौचं तुष्टिस्तपश्चैव जपः प्रणिधिरेव च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001499019, "chapter_id": 21499, "verse_number": "७-२-३७-२०", "content_sanskrit": "इति पञ्चप्रभेदस्स्यान्नियमः स्वांशभेदतः ।\nस्वस्तिकं पद्ममध्येंदुं वीरं योगं प्रसाधितम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001499020, "chapter_id": 21499, "verse_number": "७-२-३७-२१", "content_sanskrit": "पर्यंकं च यथेष्टं च प्रोक्तमासनमष्टधा ।\nप्राणः स्वदेहजो वायुस्तस्यायामो निरोधनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001499021, "chapter_id": 21499, "verse_number": "७-२-३७-२२", "content_sanskrit": "तद्रोचकं पूरकं च कुंभकं च त्रिधोच्यते ।\nनासिकापुटमंगुल्या पीड्यैकमपरेण तु॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001499022, "chapter_id": 21499, "verse_number": "७-२-३७-२३", "content_sanskrit": "औदरं रेचयेद्वायुं तथायं रेचकः स्मृतः ।\nबाह्येन मरुता देहं दृतिवत्परिपूरयेत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001499023, "chapter_id": 21499, "verse_number": "७-२-३७-२४", "content_sanskrit": "नासापुटेनापरेण पूरणात्पूरकं मतम् ।\nन मुंचति न गृह्णाति वायुमंतर्बहिः स्थितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001499024, "chapter_id": 21499, "verse_number": "७-२-३७-२५", "content_sanskrit": "संपूर्णं कुंभवत्तिष्ठेदचलः स तु कुंभक ।\nरेचकाद्यं त्रयमिदं न द्रुतं न विलंबितम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001499025, "chapter_id": 21499, "verse_number": "७-२-३७-२६", "content_sanskrit": "तद्यतः क्रमयोगेन त्वभ्यसेद्योगसाधकः ।\nरेचकादिषु योभ्यासो नाडीशोधनपूर्वकः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001499026, "chapter_id": 21499, "verse_number": "७-२-३७-२७", "content_sanskrit": "स्वेच्छोत्क्रमणपर्यंतः प्रोक्तो योगानुशासने ।\nकन्यकादिक्रमवशात्प्राणायामनिरोधनम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001499027, "chapter_id": 21499, "verse_number": "७-२-३७-२८", "content_sanskrit": "तच्चतुर्धोपदिष्टं स्यान्मात्रागुणविभागतः ।\nकन्यकस्तु चतुर्धा स्यात्स च द्वादशमात्रकः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001499028, "chapter_id": 21499, "verse_number": "७-२-३७-२९", "content_sanskrit": "मध्यमस्तु द्विरुद्धातश्चतुर्विंशतिमात्रकः ।\nउत्तमस्तु त्रिरुद्धातः षड्विंशन्मात्रकः परः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001499029, "chapter_id": 21499, "verse_number": "७-२-३७-३०", "content_sanskrit": "स्वेदकंपादिजनकः प्राणायामस्तदुत्तरः ।\nआनंदोद्भवरोमांचनेत्राश्रूणां विमोचनम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001499030, "chapter_id": 21499, "verse_number": "७-२-३७-३१", "content_sanskrit": "जल्पभ्रमणमूर्छाद्यं जायते योगिनः परम् ।\nजानुं प्रदक्षिणीकृत्य न द्रुतं न विलंबितम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001499031, "chapter_id": 21499, "verse_number": "७-२-३७-३२", "content_sanskrit": "अंगुलीस्फोटनं कुर्यात्सा मात्रेति प्रकीर्तिता ।\nमात्राक्रमेण विज्ञेयाश्चोद्वातक्रमयोगतः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001499032, "chapter_id": 21499, "verse_number": "७-२-३७-३३", "content_sanskrit": "नाडीविशुद्धिपूर्वं तु प्राणायामं समाचरेत् ।\nअगर्भश्च सगर्भश्च प्राणायामो द्विधा स्मृतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001499033, "chapter_id": 21499, "verse_number": "७-२-३७-३४", "content_sanskrit": "जपं ध्यानं विनागर्भः सगर्भस्तत्समन्वयात् ।\nअगर्भाद्गर्भसंयुक्तः प्राणायामःशताधिकः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001499034, "chapter_id": 21499, "verse_number": "७-२-३७-३५", "content_sanskrit": "तस्मात्सगर्भं कुर्वन्ति योगिनः प्राणसंयमम् ।\nप्राणस्य विजयादेव जीयंते देह १ आयवः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001499035, "chapter_id": 21499, "verse_number": "७-२-३७-३६", "content_sanskrit": "प्राणो ऽपानः समानश्च ह्युदानो व्यान एव च ।\nनागः कूर्मश्च कृकलो देवदत्तो धनंजयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001499036, "chapter_id": 21499, "verse_number": "७-२-३७-३७", "content_sanskrit": "प्रयाणं कुरुते यस्मात्तस्मात्प्राणो ऽभिधीयते ।\nअवाङ्नयत्यपानाख्यो यदाहारादि भुज्यते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001499037, "chapter_id": 21499, "verse_number": "७-२-३७-३८", "content_sanskrit": "व्यानो व्यानशयत्यंगान्यशेषाणि विवर्धयन् ।\nउद्वेजयति मर्माणीत्युदानो वायुरीरितः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001499038, "chapter_id": 21499, "verse_number": "७-२-३७-३९", "content_sanskrit": "समं नयति सर्वांगं समानस्तेन गीयते ।\nउद्गारे नाग आख्यातः कूर्म उन्मीलने स्थितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001499039, "chapter_id": 21499, "verse_number": "७-२-३७-४०", "content_sanskrit": "कृकलः क्षवथौ ज्ञेयो देवदत्तो विजृंभणे ।\nन जहाति मृतं चापि सर्वव्यापी धनंजयः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001499040, "chapter_id": 21499, "verse_number": "७-२-३७-४१", "content_sanskrit": "क्रमेणाभ्यस्यमानोयं प्राणायामप्रमाणवान् ।\nनिर्दहत्यखिलं दोषं कर्तुर्देहं च रक्षति॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001499041, "chapter_id": 21499, "verse_number": "७-२-३७-४२", "content_sanskrit": "प्राणे तु विजिते सम्यक्तच्चिह्नान्युपलक्षयेत् ।\nविण्मूत्रश्लेष्मणां तावदल्पभावः प्रजायते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001499042, "chapter_id": 21499, "verse_number": "७-२-३७-४३", "content_sanskrit": "बहुभोजनसामर्थ्यं चिरादुच्छ्वासनं तथा ।\nलघुत्वं शीघ्रगामित्वमुत्साहः स्वरसौष्ठवम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001499043, "chapter_id": 21499, "verse_number": "७-२-३७-४४", "content_sanskrit": "सर्वरोगक्षयश्चैव बलं तेजः सुरूपता ।\nधृतिर्मेधा युवत्वं च स्थिरता च प्रसन्नता॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001499044, "chapter_id": 21499, "verse_number": "७-२-३७-४५", "content_sanskrit": "तपांसि पापक्षयता यज्ञदानव्रतादयः ।\nप्राणायामस्य तस्यैते कलां नार्हन्ति षोडशीम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001499045, "chapter_id": 21499, "verse_number": "७-२-३७-४६", "content_sanskrit": "इन्द्रियाणि प्रसक्तानि यथास्वं विषयेष्विह ।\nआहत्य यन्निगृह्णाति स प्रत्याहार उच्यते॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001499046, "chapter_id": 21499, "verse_number": "७-२-३७-४७", "content_sanskrit": "नमःपूर्वाणींद्रियाणि स्वर्गं नरकमेव च ।\nनिगृहीतनिसृष्टानि स्वर्गाय नरकाय च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001499047, "chapter_id": 21499, "verse_number": "७-२-३७-४८", "content_sanskrit": "तस्मात्सुखार्थी मतिमाञ्ज्ञानवैराग्यमास्थितः ।\nइंद्रियाश्वान्निगृह्याशु स्वात्मनात्मानमुद्धरेत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001499048, "chapter_id": 21499, "verse_number": "७-२-३७-४९", "content_sanskrit": "धारणा नाम चित्तस्य स्थानबन्धस्समासतः ।\nस्थानं च शिव एवैको नान्यद्दोषत्रयं यतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001499049, "chapter_id": 21499, "verse_number": "७-२-३७-५०", "content_sanskrit": "कालं कंचावधीकृत्य स्थाने ऽवस्थापितं मनः ।\nन तु प्रच्यवते लक्ष्याद्धारणा स्यान्न चान्यथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001499050, "chapter_id": 21499, "verse_number": "७-२-३७-५१", "content_sanskrit": "मनसः प्रथमं स्थैर्यं धारणातः प्रजायते ।\nतस्माद्धीरं मनः कुर्याद्धारणाभ्यासयोगतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001499051, "chapter_id": 21499, "verse_number": "७-२-३७-५२", "content_sanskrit": "ध्यै चिंतायां स्मृतो धातुः शिवचिंता मुहुर्मुहुः ।\nअव्याक्षिप्तेन मनसा ध्यानं नाम तदुच्यते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001499052, "chapter_id": 21499, "verse_number": "७-२-३७-५३", "content_sanskrit": "ध्येयावस्थितचित्तस्य सदृशः प्रत्ययश्च यः ।\nप्रत्ययान्तरनिर्मुक्तः प्रवाहो ध्यानमुच्यते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001499053, "chapter_id": 21499, "verse_number": "७-२-३७-५४", "content_sanskrit": "सर्वमन्यत्परित्यज्य शिव एव शिवंकरः ।\nपरो ध्येयो ऽधिदेवेशः समाप्ताथर्वणी श्रुतिः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001499054, "chapter_id": 21499, "verse_number": "७-२-३७-५५", "content_sanskrit": "तथा शिवा परा ध्येया सर्वभूतगतौ शिवौ ।\nतौ श्रुतौ स्मृतिशास्त्रेभ्यः सर्वगौ सर्वदोदितौ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001499055, "chapter_id": 21499, "verse_number": "७-२-३७-५६", "content_sanskrit": "सर्वज्ञौ सततं ध्येयौ नानारूपविभेदतः ।\nविमुक्तिः प्रत्ययः पूर्वः प्रत्ययश्चाणिमादिकम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001499056, "chapter_id": 21499, "verse_number": "७-२-३७-५७", "content_sanskrit": "इत्येतद्द्विविधं ज्ञेयं ध्यानस्यास्य प्रयोजनम् ।\nध्याता ध्यानं तथा ध्येयं यच्च ध्यानप्रयोजनम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001499057, "chapter_id": 21499, "verse_number": "७-२-३७-५८", "content_sanskrit": "एतच्चतुष्टयं ज्ञात्वा योगं युञ्जीत योगवित् ।\nज्ञानवैराग्यसंपन्नः श्रद्दधानः क्षमान्वितः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001499058, "chapter_id": 21499, "verse_number": "७-२-३७-५९", "content_sanskrit": "निर्ममश्च सदोत्साही ध्यातेत्थं पुरुषः स्मृतः ।\nजपाच्छ्रांतः पुनर्ध्यायेद्ध्यानाच्छ्रांतः पुनर्जपेत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001499059, "chapter_id": 21499, "verse_number": "७-२-३७-६०", "content_sanskrit": "जपध्यनाभियुक्तस्य क्षिप्रं योगः प्रसिद्ध्यति ।\nधारणा द्वादशायामा ध्यानं द्वादशधारणम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001499060, "chapter_id": 21499, "verse_number": "७-२-३७-६१", "content_sanskrit": "ध्यानद्वादशकं यावत्समाधिरभिधीयते ।\nसमाधिर्न्नाम योगांगमन्तिमं परिकीर्तितम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001499061, "chapter_id": 21499, "verse_number": "७-२-३७-६२", "content_sanskrit": "समाधिना च सर्वत्र प्रज्ञालोकः प्रवर्तते ।\nयदर्थमात्रनिर्भासं स्तिमितो दधिवत्स्थितम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001499062, "chapter_id": 21499, "verse_number": "७-२-३७-६३", "content_sanskrit": "स्वरूपशून्यवद्भानं समाधिरभिधीयते ।\nध्येये मनः समावेश्य पश्येदपि च सुस्थिरम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001499063, "chapter_id": 21499, "verse_number": "७-२-३७-६४", "content_sanskrit": "निर्वाणानलवद्योगी समाधिस्थः प्रगीयते ।\nन शृणोति न चाघ्राति न जल्पति न पश्यति॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001499064, "chapter_id": 21499, "verse_number": "७-२-३७-६५", "content_sanskrit": "न च स्पर्शं विजानाति न संकल्पयते मनः ।\nनवाभिमन्यते किंचिद्बध्यते न च काष्टवत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001499065, "chapter_id": 21499, "verse_number": "७-२-३७-६६", "content_sanskrit": "एवं शिवे विलीनात्मा समाधिस्थ इहोच्यते ।\nयथा दीपो निवातस्थः स्पन्दते न कदाचन॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001499066, "chapter_id": 21499, "verse_number": "७-२-३७-६७", "content_sanskrit": "तथा समाधिनिष्ठो ऽपि तस्मान्न विचलेत्सुधीः ।\nएवमभ्यसतश्चारं योगिनो योगमुत्तमम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001499067, "chapter_id": 21499, "verse_number": "७-२-३७-६८", "content_sanskrit": "तदन्तराया नश्यंति विघ्नाः सर्वे शनैःशनैः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]