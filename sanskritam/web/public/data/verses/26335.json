[{"id": 7006335000, "chapter_id": 26335, "verse_number": "१-४५-१", "content_sanskrit": "वैशम्पायन उवाच ताभ्यां बलाभ्यां संजज्ञे तुमुलो विग्रहस्तदा ।\nसुराणामसुराणां च परस्परजयैषिणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006335001, "chapter_id": 26335, "verse_number": "१-४५-२", "content_sanskrit": "दानवा दैवतैः सार्द्धं नानाप्रहरणोद्यताः ।\nसमीयुर्युध्यमाना वै पर्वताः पर्वतैरिव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006335002, "chapter_id": 26335, "verse_number": "१-४५-३", "content_sanskrit": "तत् सुरासुरसंयुक्तं युद्धमत्यद्भुतं बभौ ।\nधर्माधर्मसमायुक्तं दर्पेण विनयेन च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006335003, "chapter_id": 26335, "verse_number": "१-४५-४", "content_sanskrit": "ततो रथैः प्रजविभिर्वाहनैश्च प्रचोदितैः ।\nउत्पतद्भिश्च गगनं सासिहस्तैः समन्ततः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006335004, "chapter_id": 26335, "verse_number": "१-४५-५", "content_sanskrit": "विक्षिप्यमाणैर्मुसलैः सम्प्रेष्यद्भिश्च सायकैः ।\nचापैर्विस्फार्यमाणैश्च पात्यमानैश्च मुद्गरैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006335005, "chapter_id": 26335, "verse_number": "१-४५-६", "content_sanskrit": "तद् युद्धमभवद् घोरं देवदानवसंकुलम्।\nजगतस्त्रासजननं युगसंवर्तकोपमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006335006, "chapter_id": 26335, "verse_number": "१-४५-७", "content_sanskrit": "स्वहस्तमुक्तैः परिघैः क्षिप्यमाणैश्च पर्वतैः ।\nदानवाः समरे जघ्नुर्देवानिन्द्रपुरोगमान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006335007, "chapter_id": 26335, "verse_number": "१-४५-८", "content_sanskrit": "ते वध्यमाना बलिभिर्दानवैर्जितकाशिभिः ।\nविषण्णमनसो देवा जग्मुरार्तिं परां मृधे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006335008, "chapter_id": 26335, "verse_number": "१-४५-९", "content_sanskrit": "तेऽस्त्रजालैः प्रमथिताः परिघैर्भिन्नमस्तकाः ।\nभिन्नोरस्का दितिसुतैर्वेमू रक्तं व्रणैर्बहु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006335009, "chapter_id": 26335, "verse_number": "१-४५-१०", "content_sanskrit": "स्पन्दिताः पाशजालैश्च निर्यत्नाश्च शरैः कृताः ।\nप्रविष्टा दानवी माया न शेकुस्ते विचेष्टितुम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006335010, "chapter_id": 26335, "verse_number": "१-४५-११", "content_sanskrit": "संस्तम्भितमिवाभाति निष्प्राणसदृशाकृति ।\nबलं सुराणामसुरैर्निष्प्रयत्नायुधं कृतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006335011, "chapter_id": 26335, "verse_number": "१-४५-१२", "content_sanskrit": "मायापाशान् विकर्षंश्च भिन्दन् वज्रेण ताञ्शरान् ।\nशक्रो दैत्यबलं घोरं विवेश बहुलोचनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006335012, "chapter_id": 26335, "verse_number": "१-४५-१३", "content_sanskrit": "स दैत्यान् प्रमुखे हत्वा तद् दानवबलं महत् ।\nतामसेनास्त्रजालेन तमोभूतमथाकरोत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006335013, "chapter_id": 26335, "verse_number": "१-४५-१४", "content_sanskrit": "तेऽन्योन्यं नावबुध्यन्त देवान् वा दानवानपि ।\nघोरेण तमसाऽऽविष्टाः पुरुहूतस्य तेजसा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006335014, "chapter_id": 26335, "verse_number": "१-४५-१५", "content_sanskrit": "मायापाशैर्विमुक्ताश्च यत्नवन्तः सुरोत्तमाः ।\nवपूंषि दैत्यसंघानां तमोभूतान्यपातयन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006335015, "chapter_id": 26335, "verse_number": "१-४५-१६", "content_sanskrit": "अपध्वस्ता विसंज्ञाश्च तमसा नीलवर्चसः ।\nपेतुस्ते दानवगणाश्छिन्नपक्षा इवाचलाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006335016, "chapter_id": 26335, "verse_number": "१-४५-१७", "content_sanskrit": "दैत्यानां तद्घनीभूतमन्धकारमहार्णवम् ।\nप्रविष्टं बलमुत्त्रस्तं तमोभूतमिवाबभौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006335017, "chapter_id": 26335, "verse_number": "१-४५-१८", "content_sanskrit": "तदासृजन्महामायां मयस्तां तामसीं दहन् ।\nयुगान्ताग्निमिवात्युग्रां सृष्टामौर्वेण वह्निना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006335018, "chapter_id": 26335, "verse_number": "१-४५-१९", "content_sanskrit": "सा ददाह तमः सर्वं माया मयविकल्पिता ।\nदैत्याश्च दीप्तवपुषः सद्य उत्तस्थुराहवे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006335019, "chapter_id": 26335, "verse_number": "१-४५-२०", "content_sanskrit": "मायामौर्वीं समासाद्य दह्यमाना दिवौकसः ।\nभेजिरे चन्द्रविषयं शीतांशुसलिले शयात्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006335020, "chapter_id": 26335, "verse_number": "१-४५-२१", "content_sanskrit": "ते दह्यमाना ह्यौर्वेण तेजसा भ्रष्टतेजसः ।\nशशंसुर्वज्रिणे देवाः संतप्ताः शरणैषिणः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006335021, "chapter_id": 26335, "verse_number": "१-४५-२२", "content_sanskrit": "संतप्ते मायया सैन्ये दह्यमाने च दानवैः ।\nचोदितो देवराजेन वरुणो वाक्यमब्रवीत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006335022, "chapter_id": 26335, "verse_number": "१-४५-२३", "content_sanskrit": "वरुण उवाच पुरा ब्रह्मर्षिजः शक्र तपस्तेपेऽतिदारुणम् ।\nऊर्वो मुनिः स तेजस्वी सदृशो ब्रह्मणो गुणैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006335023, "chapter_id": 26335, "verse_number": "१-४५-२४", "content_sanskrit": "तं तपन्तमिवादित्यं तपसा जगदव्ययम्।\nउपतस्थुर्मुनिगणा देवा ब्रह्मर्षिभिः सह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006335024, "chapter_id": 26335, "verse_number": "१-४५-२५", "content_sanskrit": "हिरण्यकशिपुश्चैव दानवो दानवेश्वरः ।\nऋषिं विज्ञापयामास पुरा परमतेजसम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006335025, "chapter_id": 26335, "verse_number": "१-४५-२६", "content_sanskrit": "तमूचुर्ब्रह्मऋषयो वचनं ब्रह्मसम्मितम्।\nऋषिवंशेषु भगवञ्छिन्नमूलमिदं कुलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006335026, "chapter_id": 26335, "verse_number": "१-४५-२७", "content_sanskrit": "एकस्त्वमनपत्यश्च गोत्रं यन्नानुवर्तसे ।\nकौमारं व्रतमास्थाय क्लेशमेवानुवर्तसे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006335027, "chapter_id": 26335, "verse_number": "१-४५-२८", "content_sanskrit": "बहूनि विप्र गोत्राणि मुनीनां भावितात्मनाम् ।\nएकदेहानि तिष्ठन्ति विभक्तानि विना प्रजाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006335028, "chapter_id": 26335, "verse_number": "१-४५-२९", "content_sanskrit": "कुलेषूच्छिन्नमूलेषु तेषु नो नास्ति कारणम् ।\nभवांस्तु तपसा श्रेष्ठः प्रजापतिसमद्युतिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006335029, "chapter_id": 26335, "verse_number": "१-४५-३०", "content_sanskrit": "तत् प्रवर्तस्व वंशाय वर्द्धयात्मानमात्मना ।\nत्वमाधत्स्वोर्जितं तेजो द्वितीयां वै तनुं कुरु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006335030, "chapter_id": 26335, "verse_number": "१-४५-३१", "content_sanskrit": "स एवमुक्तो मुनिभिमुनिर्मनसि ताडितः ।\nजगर्हे तानृषिगणान् वचनं चेदमब्रवीत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006335031, "chapter_id": 26335, "verse_number": "१-४५-३२", "content_sanskrit": "यथायं शाश्वतो धर्मो मुनीनां विहितः पुरा ।\nसदाऽऽर्षं सेवतां कर्म वन्यमूलफलाशिनाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006335032, "chapter_id": 26335, "verse_number": "१-४५-३३", "content_sanskrit": "ब्रह्मयोनौ प्रसूतस्य ब्राह्मणस्यानुवर्तिनः ।\nब्रह्मचर्यं सुचरितं ब्रह्माणमपि चालयेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006335033, "chapter_id": 26335, "verse_number": "१-४५-३४", "content_sanskrit": "द्विजानां वृत्तयस्तिस्रो ये गृहाश्रमवासिनः ।\nअस्माकं तु वनं वृत्तिर्वनाश्रमनिवासिनाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006335034, "chapter_id": 26335, "verse_number": "१-४५-३५", "content_sanskrit": "अम्बुभक्षा वायुभक्षा दन्तोलूखलिकास्तथा ।\nअश्मकुट्टा दशनपाः पञ्चातपतपाश्च  ये ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006335035, "chapter_id": 26335, "verse_number": "१-४५-३६", "content_sanskrit": "एते तपसि तिष्ठन्तो व्रतैरपि सुदुष्करैः ।\nब्रह्मचर्यं पुरस्कृत्य प्रार्थयन्ते परां गतिम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006335036, "chapter_id": 26335, "verse_number": "१-४५-३७", "content_sanskrit": "ब्रह्मचर्याद् ब्राह्मणस्य ब्राह्मणत्वं विधीयते ।\nएवमाहुः परे लोके ब्रह्म ब्रह्मविदो जनाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006335037, "chapter_id": 26335, "verse_number": "१-४५-३८", "content_sanskrit": "ब्रह्मचर्ये स्थितं धैर्यं ब्रह्मचर्ये स्थितं तपः ।\nये स्थिता ब्रह्मचर्येषु ब्राह्मणास्ते दिवि स्थिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006335038, "chapter_id": 26335, "verse_number": "१-४५-३९", "content_sanskrit": "नास्ति योगं विना सिद्धिर्नास्ति सिद्धिं विना यशः ।\nनास्ति लोके यशोमूलं ब्रह्मचर्यात् परं तपः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006335039, "chapter_id": 26335, "verse_number": "१-४५-४०", "content_sanskrit": "तन्निगृह्येन्द्रियग्रामं भूतग्रामं च पञ्चमम् ।\nब्रह्मचर्येण वर्तेत किमतः परमं तपः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006335040, "chapter_id": 26335, "verse_number": "१-४५-४१", "content_sanskrit": "अयोगे केशहरणमसंकल्पे व्रतक्रिया ।\nअब्रह्मचर्ये चर्या च त्रयं स्याद् दम्भसंज्ञितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006335041, "chapter_id": 26335, "verse_number": "१-४५-४२", "content_sanskrit": "क्व दाराः क्व च संयोगः क्व च भावविपर्ययः ।\nयदेयं ब्रह्मणा सृष्टा मनसा मानसी प्रजा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006335042, "chapter_id": 26335, "verse_number": "१-४५-४३", "content_sanskrit": "यद्यस्ति तपसो वीर्यं युष्माकममितात्मनाम् ।\nसृजध्वं मानसान् पुत्रान् प्राजापत्येन कर्मणा ॥४३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006335043, "chapter_id": 26335, "verse_number": "१-४५-४४", "content_sanskrit": "मनसा निर्मिता योनिराधातव्या तपस्विना ।\nन दारयोगं बीजं वा व्रतमुक्तं तपस्विनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006335044, "chapter_id": 26335, "verse_number": "१-४५-४५", "content_sanskrit": "यदिदं लुप्तधर्मार्थं युष्माभिरिह निर्भयैः ।\nव्याहृतं सद्भिरत्यर्थमसद्भिरिव मे मतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006335045, "chapter_id": 26335, "verse_number": "१-४५-४६", "content_sanskrit": "वपुर्दीप्तान्तरात्मानमेष कृत्वा मनोमयम्।\nदारयोगं विना स्रक्ष्ये पुत्रमात्मतनूरुहम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006335046, "chapter_id": 26335, "verse_number": "१-४५-४७", "content_sanskrit": "एवमात्मानमात्मा मे द्वितीयं जनयिष्यति ।\nवन्येनानेन विधिना दिधक्षन्तमिव प्रजाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006335047, "chapter_id": 26335, "verse_number": "१-४५-४८", "content_sanskrit": "ऊर्वस्तु तपसाऽऽविष्टो निवेश्योरुं हुताशने ।\nममन्थैकेन दर्भेण पुत्रस्य प्रभवारणिम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006335048, "chapter_id": 26335, "verse_number": "१-४५-४९", "content_sanskrit": "तस्योरुं सहसा भित्त्वा ज्वालामाली निरिन्धनः ।\nजगतो निधनाकाङ्क्षी पुत्रोऽग्निः समपद्यत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006335049, "chapter_id": 26335, "verse_number": "१-४५-५०", "content_sanskrit": "ऊर्वस्योरुं विनिर्भिद्य और्वो नामान्तकोऽनलः ।\nदिधक्षन्निव लोकांस्त्रीञ्जज्ञे परमकोपनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006335050, "chapter_id": 26335, "verse_number": "१-४५-५१", "content_sanskrit": "उत्पन्नमात्रश्चोवाच पितरं दीप्तया गिरा ।\nक्षुधा मे बाधते तात जगद् भक्षे त्यजस्व माम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006335051, "chapter_id": 26335, "verse_number": "१-४५-५२", "content_sanskrit": "त्रिदिवारोहिभिर्ज्वालैर्जृम्भमाणो दिशो दश ।\nनिर्दहन्निव भूतानि ववृधे सोऽन्तकोऽनलः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006335052, "chapter_id": 26335, "verse_number": "१-४५-५३", "content_sanskrit": "एतस्मिन्नन्तरे ब्रह्मा सर्वलोकपतिः प्रभुः ।\nआजगाम मुनिर्यत्र व्यसृजत् पुत्रमुत्तमम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006335053, "chapter_id": 26335, "verse_number": "१-४५-५४", "content_sanskrit": "स ददर्शोरुमूर्वस्य दीप्यमानं सुताग्निना ।\nऔर्वकोपाग्निसंतप्ताँल्लोकांश्च ऋषिभिः सह ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006335054, "chapter_id": 26335, "verse_number": "१-४५-५५", "content_sanskrit": "तमुवाच ततो ब्रह्मा मुनिमूर्वं सभाजयन् ।\nधार्यतां पुत्रजं तेजो लोकानां हितकाम्यया ।\nअस्यापत्यस्य ते विप्र करिष्ये साह्यमुत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006335055, "chapter_id": 26335, "verse_number": "१-४५-५६", "content_sanskrit": "वासं चास्य प्रदास्यामि प्राशनं चामृतोपमम् ।\nतथ्यमेतन्मम वचः शृणु त्वं वदतां वर ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006335056, "chapter_id": 26335, "verse_number": "१-४५-५७", "content_sanskrit": "ऊर्व उवाच धन्योऽस्म्यनुगृहीतोऽस्मि यन्ममाद्य भवाञ्छिशोः ।\nमतिमेतां ददातीह परमानुग्रहाय वै ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006335057, "chapter_id": 26335, "verse_number": "१-४५-५८", "content_sanskrit": "प्रभावकाले सम्प्राप्ते काङ्क्षितव्ये समागमे ।\nभगवंस्तर्पितः पुत्रः कैर्हव्यैः प्राप्स्यते सुखम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006335058, "chapter_id": 26335, "verse_number": "१-४५-५९", "content_sanskrit": "कुत्र चास्य निवासो वै भोजनं च किमात्मकम् ।\nविधास्यति भवानस्य वीर्यतुल्यं महौजसः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006335059, "chapter_id": 26335, "verse_number": "१-४५-६०", "content_sanskrit": "ब्रह्मोवाच वडवामुखेऽस्य वसतिः समुद्रास्ये भविष्यति ।\nमम योनिर्जलं विप्र तच्च तोयमयं वपुः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006335060, "chapter_id": 26335, "verse_number": "१-४५-६१", "content_sanskrit": "तद्धविस्तव पुत्रस्य विसृजाम्यालयं तु तत् ।\nतत्रायमास्तां नियतः पिबन् वारिमयं हविः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006335061, "chapter_id": 26335, "verse_number": "१-४५-६२", "content_sanskrit": "ततो युगान्ते भूतानामेव चाहं च सुव्रत ।\nसहितौ विचरिष्यावो लोकानिति पुनः पुनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006335062, "chapter_id": 26335, "verse_number": "१-४५-६३", "content_sanskrit": "एषोऽग्निरन्तकाले तु सलिलाशी मया कृतः ।\nदहनः सर्वभूतानां सदेवासुररक्षसाम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006335063, "chapter_id": 26335, "verse_number": "१-४५-६४", "content_sanskrit": "एवमस्त्विति सोऽप्यग्निः संवृतज्वालमण्डलः ।\nप्रविवेशार्णवमुखं निक्षिप्य पितरि प्रभाम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006335064, "chapter_id": 26335, "verse_number": "१-४५-६५", "content_sanskrit": "प्रतियातस्ततो ब्रह्मा ते च सर्वे महर्षयः ।\nऔर्वस्याग्नेः प्रभावज्ञाः स्वां स्वां गतिमुपाश्रिताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006335065, "chapter_id": 26335, "verse_number": "१-४५-६६", "content_sanskrit": "हिरण्यकशिपुर्दृष्ट्वा तदद्भुतमपूजयत् ।\nऊर्वं प्रणतसर्वाङ्गो वाक्यं चेदमुवाच ह ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006335066, "chapter_id": 26335, "verse_number": "१-४५-६७", "content_sanskrit": "भगवन्नद्भुतमिदं निर्वृत्तं लोकसाक्षिकम् ।\nतपसा ते मुनिश्रेष्ठ परितुष्टः पितामहः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006335067, "chapter_id": 26335, "verse_number": "१-४५-६८", "content_sanskrit": "अहं तु तव पुत्रस्य तव चैव महाव्रत ।\nभृत्य इत्यवगन्तव्यः श्लाघ्योऽस्मि यदि कर्मणा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006335068, "chapter_id": 26335, "verse_number": "१-४५-६९", "content_sanskrit": "तन्मां पश्य समापन्नं तवैवाराधने रतम् ।\nयदि सीदे मुनिश्रेष्ठ तवैव स्यात् पराजयः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006335069, "chapter_id": 26335, "verse_number": "१-४५-७०", "content_sanskrit": "ऊर्व उवाच धन्योऽस्म्यनुगृहीतोऽस्मि यस्य तेऽहं गुरुर्मतः ।\nनास्ति ते तपसानेन भयमद्येह सुव्रत ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006335070, "chapter_id": 26335, "verse_number": "१-४५-७१", "content_sanskrit": "इमां च मायां गृह्णीष्व मम पुत्रेण निर्मिताम् ।\nनिरिन्धनामग्निमयीं दुःस्पर्शां पावकैरपि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006335071, "chapter_id": 26335, "verse_number": "१-४५-७२", "content_sanskrit": "एषा ते स्वस्य वंशस्य वशगारिविनिग्रहे ।\nरक्षिष्यत्यात्मपक्षं सा परांश्च प्रहरिष्यति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006335072, "chapter_id": 26335, "verse_number": "१-४५-७३", "content_sanskrit": "एवमस्त्विति तां गृह्य प्रणम्य मुनिपुंगवम् ।\nजगाम त्रिदिवं हृष्टः कृतार्थो दानवेश्वरः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006335073, "chapter_id": 26335, "verse_number": "१-४५-७४", "content_sanskrit": "वरुण उवाच सैषा दुर्विषहा माया देवैरपि दुरासदा ।\nऔर्वेण निर्मिता पूर्वं पावकेनोर्वसूनुना ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006335074, "chapter_id": 26335, "verse_number": "१-४५-७५", "content_sanskrit": "तस्मिंस्तु व्युत्थिते दैत्ये निर्वीयैषा न संशयः ।\nशापो ह्यस्याः पुरा दत्तः सृष्टा येनैव तेजसा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006335075, "chapter_id": 26335, "verse_number": "१-४५-७६", "content_sanskrit": "यद्येषा प्रतिहन्तव्या कर्तव्यो भगवान् सुखी ।\nदीयतां मे सखा शक्र तोययोनिर्निशाकरः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006335076, "chapter_id": 26335, "verse_number": "१-४५-७७", "content_sanskrit": "तेनाहं सह संगम्य यादोभिश्च समावृतः ।\nमायामेतां हनिष्यामि त्वत्प्रसादान्न संशयः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]