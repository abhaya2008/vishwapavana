[{"id": 2213133, "chapter_id": 5548, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213134, "chapter_id": 5548, "verse_number": "१", "content_sanskrit": "ततो भागीरथीतीरे मध्ये पुण्यजनोचिते ।\nनिवासमकरोद् राजा विदुरस्य मते स्थितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213135, "chapter_id": 5548, "verse_number": "२", "content_sanskrit": "तत्रैनं पर्युपातिष्ठन् ब्राह्मणा राष्ट्रवासिनः ।\nक्षत्रविट्शूद्रसङ्घाश्च बहवो भरतर्षभ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213136, "chapter_id": 5548, "verse_number": "३", "content_sanskrit": "स तैः परिवृतो राजा कथाभिरभिनन्द्य तान् ।\nअनुजज्ञे सशिष्यान् वै विधिवत् प्रतिपूज्य च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213137, "chapter_id": 5548, "verse_number": "४", "content_sanskrit": "सायाह्ने स महीपालस्ततो गङ्गामुपेत्य च ।\nचकार विधिवच्छौचं गान्धारी च यशस्विनी\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213138, "chapter_id": 5548, "verse_number": "५", "content_sanskrit": "तथैवान्ये पृथक् सर्वे तीर्थेष्वाप्लुत्य भारत ।\nचक्रुः सर्वाः क्रियास्तत्र पुरुषा विदुरादयः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213139, "chapter_id": 5548, "verse_number": "६", "content_sanskrit": "कृतशौचं ततो वृद्धं श्वशुरं कुन्तिभोजजा ।\nगान्धारीं च पृथा राजन् गङ्गातीरमुपानयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213140, "chapter_id": 5548, "verse_number": "७", "content_sanskrit": "राज्ञस्तु याजकैस्तत्र कृतो वेदीपरिस्तरः ।\nजुहाव तत्र वह्नीन् स नृपतिः सत्यसङ्गरः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213141, "chapter_id": 5548, "verse_number": "८", "content_sanskrit": "ततो भागीरथीतीरात् कुरुक्षेत्रं जगाम सः ।\nसानुगो नृपतिर्विद्वान् नियतः संयतेन्द्रियः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213142, "chapter_id": 5548, "verse_number": "९", "content_sanskrit": "तत्राश्रमपदं श्रीमान् अभिगम्य स पार्थिवः ।\nआससादाथ राजर्षिं शतयूपं मनीषिणम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213143, "chapter_id": 5548, "verse_number": "१०", "content_sanskrit": "स हि राजा महानासीत् केकयेषु परन्तपः ।\nस्वपुत्रं मनुजैश्वर्ये निवेश्य वनमाविशत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213144, "chapter_id": 5548, "verse_number": "११", "content_sanskrit": "तेनासौ सहितो राजा ययौ व्यासाश्रमं तदा ।\nतत्रैव विधिवद् राजन् प्रत्यगृह्णात् कुरूद्वहम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213145, "chapter_id": 5548, "verse_number": "१२", "content_sanskrit": "स दीक्षां तत्र सम्प्राप्य राजा कौरवनन्दनः ।\nशतयूपाश्रमे तस्मिन् निवासमकरोत् तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213146, "chapter_id": 5548, "verse_number": "१३", "content_sanskrit": "तस्मै सर्वं विधिं राजन्नाचख्यौ स नृपस्तदा ।\nआरण्यकं महाराज व्यासस्यानुमते तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213147, "chapter_id": 5548, "verse_number": "१४", "content_sanskrit": "एवं स तपसा राजा धृतराष्ट्रो महामनाः ।\nयोजयामास चात्मानं तांश्चाप्यनुचरांस्तदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213148, "chapter_id": 5548, "verse_number": "१५", "content_sanskrit": "तथैव देवी गान्धारी वल्कलाजिनवासिनी ।\nकुन्त्या सह महाराज समानव्रतचारिणी\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213149, "chapter_id": 5548, "verse_number": "१६", "content_sanskrit": "कर्मणा मनसा वाचा चक्षुषा चापि ते नृप ।\nसन्नियम्येन्द्रियग्राममास्थिताः परमं तपः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213150, "chapter_id": 5548, "verse_number": "१७", "content_sanskrit": "त्वगस्थिशेषः परिशुष्कमांसो\nजटाजिनी वल्कलसंवृताङ्गः ।\nस पार्थिवस्तत्र तपश्चचार\nराजर्षिवत् तीव्रमपेतमोहः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213151, "chapter_id": 5548, "verse_number": "१८", "content_sanskrit": "क्षत्ता च धर्मार्थविदग्र्यबुद्धिः\nससञ्जयस्तं नृपतिं सदारम् ।\nउपाचरद् घोरतपा महात्मा\nतदा कृशो वल्कलचीरवासाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213152, "chapter_id": 5548, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि धृतराष्ट्रतपश्चर्यो नाम चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213153, "chapter_id": 5548, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि चतुर्विंशोऽध्यायः ॥२४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]