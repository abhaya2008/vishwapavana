[{"id": 2180852, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180853, "chapter_id": 4832, "verse_number": "१", "content_sanskrit": "शृणु कौन्तेय रामस्य मया यावत् परिश्रुतम् ।\nमहर्षीणां कथयतां कारणं तस्य जन्म च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180854, "chapter_id": 4832, "verse_number": "२", "content_sanskrit": "यथा जामदग्न्येन कोटिशः क्षत्रिया हताः ।\nउद्भूता राजवंशेषु ये भूयो भारते हताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180855, "chapter_id": 4832, "verse_number": "३", "content_sanskrit": "जह्नोरजह्नुस्तनयो बल्लवस्तस्य चात्मजः ।\nकुशिको नाम धर्मज्ञस्तस्य पुत्रो महीपतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180856, "chapter_id": 4832, "verse_number": "४", "content_sanskrit": "उग्रं तपः समातिष्ठत् सहस्राक्षसमो भुवि ।\nपुत्रं लभेयमजितं त्रिलोकेश्वरमित्युत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180857, "chapter_id": 4832, "verse_number": "५", "content_sanskrit": "तमुग्रतपसं दृष्ट्वा सहस्राक्षः पुरन्दरः ।\nसमर्थं पुत्रजनने स्वयमेवैत्य भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180858, "chapter_id": 4832, "verse_number": "६", "content_sanskrit": "पुत्रत्वमगमद् राजंस्तस्य लोकेश्वरेश्वरः ।\nगाधिर्नामाभवत् पुत्रः कौशिकः पाकशासनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180859, "chapter_id": 4832, "verse_number": "७", "content_sanskrit": "तस्य कन्याऽभवद् राजन् नाम्ना सत्यवती प्रभो ।\nतां गाधिः कविपुत्राय सोऽर्चीकाय ददौ प्रभुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180860, "chapter_id": 4832, "verse_number": "८", "content_sanskrit": "ततः प्रीतस्तु कौन्तेय भार्गवः कुरुनन्दन ।\nपुत्रार्थे श्रपयामास चरुं गाधेस्तथैव च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180861, "chapter_id": 4832, "verse_number": "९", "content_sanskrit": "आहूय चाह तां भार्यामृचीको भार्गवस्तदा ।\nउपयोज्यश्चरुरयं त्वया मात्राप्ययं तव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180862, "chapter_id": 4832, "verse_number": "१०", "content_sanskrit": "तस्या जनिष्यते पुत्रो दीप्तिमान् क्षत्रियर्षभः ।\nअजय्यः क्षत्रियैर्लोके क्षत्रियर्षभसूदनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180863, "chapter_id": 4832, "verse_number": "११", "content_sanskrit": "तवापि पुत्रं कल्याणि धृतिमन्तं तपोन्वितम् ।\nशमात्मकं द्विजश्रेष्ठं चरुरेष विधास्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180864, "chapter_id": 4832, "verse_number": "१२", "content_sanskrit": "इत्येवमुक्त्वा तां भार्यामृचीको भृगुनन्दनः ।\nतपस्यभिरतो धीमान् जगामारण्यमेव ह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180865, "chapter_id": 4832, "verse_number": "१३", "content_sanskrit": "एतस्मिन्नेव काले तु तीर्थयात्रापरो नृपः ।\nगाधिः सदारः सम्प्राप्त ऋचीकस्याश्रमं प्रति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180866, "chapter_id": 4832, "verse_number": "१४", "content_sanskrit": "चरुद्वयं गृहीत्वा तु राजन् सत्यवती तदा ।\nभर्तर्ुवाक्यादथाव्यग्रा मात्रे हृष्टा न्यवेदयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180867, "chapter_id": 4832, "verse_number": "१५", "content_sanskrit": "माता तु तस्याः कौन्तेय दुहित्रे स्वं चरुं ददौ ।\nतस्याश्चरुमथाज्ञातमात्मसंस्थं चकार ह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180868, "chapter_id": 4832, "verse_number": "१६", "content_sanskrit": "अथ सत्यवती गर्भं क्षत्रियान्तकरं तदा ।\nधारयामास दीप्तेन वपुषा घोरदर्शन्अम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180869, "chapter_id": 4832, "verse_number": "१७", "content_sanskrit": "तामृचीकस्तदा दृष्ट्वा ध्यानयोगेन वै ततः ।\nअब्रवीद् राजशार्दूल स्वां भार्यां वरवर्णिनीम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2180870, "chapter_id": 4832, "verse_number": "१८", "content_sanskrit": "मात्राऽसि व्यंसिता भद्रे चरुव्यत्यासहेतुना ।\nजनिष्यते हि ते पुत्रः क्रूरकर्मा महाबलः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2180871, "chapter_id": 4832, "verse_number": "१९", "content_sanskrit": "जनिष्यते हि ते भ्राता ब्रह्मभूतस्तपोधनः ।\nविश्वं हि ब्रह्म तपसा मया तत्र समर्पितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2180872, "chapter_id": 4832, "verse_number": "२०", "content_sanskrit": "क्षत्रवीर्यं च सकलं तव मात्रे समर्पितम् ।\nविपर्ययेण ते भद्रे नैतदेवं भविष्यति ।\nमातुस्ते ब्राह्मणो भूयात् तव च क्षत्रियः सुतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2180873, "chapter_id": 4832, "verse_number": "२१", "content_sanskrit": "सैवमुक्ता महाभागा भर्त्रा सत्यवती तदा ।\nपपात शिरसा तस्मै वेपन्ती चाब्रवीदिदम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2180874, "chapter_id": 4832, "verse_number": "२२", "content_sanskrit": "नार्होऽसि भगवन्नद्य वक्तुमेवंविधं वचः ।\nब्राह्मणापशदं पुत्रं प्राप्स्यसीति महामुने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2180875, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "ऋचीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2180876, "chapter_id": 4832, "verse_number": "२३", "content_sanskrit": "नैष सङ्कल्पितः कामो मया भद्रे तथा त्वयि ।\nउग्रकर्मा भवेत् पुत्रश्चरुर्माता च कारणम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2180877, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2180878, "chapter_id": 4832, "verse_number": "२४", "content_sanskrit": "इच्छँल्लोकानपि मुने सृजेथाः किं पुनर्मम ।\nशमात्मकमृजुं पुत्रं लभेयं जपतांवर\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2180879, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "ऋचीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2180880, "chapter_id": 4832, "verse_number": "२५", "content_sanskrit": "नोक्तपूर्वं मया भद्रे स्वैरेष्वप्यनृतं वचः ।\nकिमुताग्निं समाधाय मन्त्रवच्चरुसाधने\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2180881, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2180882, "chapter_id": 4832, "verse_number": "२६", "content_sanskrit": "काममेवं भवेत् पौत्रो ममेह तव चैव ह ।\nशमात्मकमृजुं पुत्रं लभेयं जपतांवर\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2180883, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "ऋचीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2180884, "chapter_id": 4832, "verse_number": "२७", "content_sanskrit": "पुत्रे नास्ति विशेषो मे पौत्रे वा वरवर्णिनि्अ ।\nयथा त्वयोक्तं तु वचस्तथा भद्रे भविष्यति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2180885, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2180886, "chapter_id": 4832, "verse_number": "२८", "content_sanskrit": "ततः सत्यवती पुत्रं जनयामास भार्गवम् ।\nतपस्यभिरतं शान्तं जमदग्निं शमात्मकम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2180887, "chapter_id": 4832, "verse_number": "२९", "content_sanskrit": "विश्वामित्रं च दायादं गाधिः कुशिकनन्दनः ।\nप्राप ब्रह्मर्षिसमितं विश्वेन ब्रह्मणा युतम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2180888, "chapter_id": 4832, "verse_number": "३०", "content_sanskrit": "आर्चीको जनयामास जमदग्निः सुदारुणम् ।\nसर्वविद्यान्तगं श्रेष्ठं धनुर्वेदे च पारगम् ।\nरामं क्षत्रियहन्तारं प्रदीप्तमिव पावकम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2180889, "chapter_id": 4832, "verse_number": "३१", "content_sanskrit": "तोषयित्वा महादेवं पर्वते गन्धमादने ।\nअस्त्राणि वरयामास परशुं चातितेजसम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2180890, "chapter_id": 4832, "verse_number": "३२", "content_sanskrit": "स तेनाकुण्ठधारेण ज्वलितानलवर्चसा ।\nकुठारेणाप्रमेयेण लोकेऽप्यप्रतिमोऽभवत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2180891, "chapter_id": 4832, "verse_number": "३३", "content_sanskrit": "एतस्मिन्नेव काले तु कृतवीर्यात्मजो बली ।\nअर्जुनो नाम तेजस्वी क्षत्रियो हैहयान्वयः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2180892, "chapter_id": 4832, "verse_number": "३४", "content_sanskrit": "अजयत् पृथिवीं सर्वां सप्तद्वीपां सपत्तनाम् ।\nस्वबाह्वस्त्रबलेनाजौ धर्मेण परमेण च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2180893, "chapter_id": 4832, "verse_number": "३५", "content_sanskrit": "तृषितेन स कौरव्य भिक्षितश्चित्रभानुना ।\nसहस्रबाहुर्विक्रान्तः प्रादाद् भिक्षामथाग्नये\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2180894, "chapter_id": 4832, "verse_number": "३६", "content_sanskrit": "ग्रामान् पुराणि घोषांश्च पत्तनानि च वीर्यवान् ।\nजज्वाल तस्य बाणैस्तु चित्रभानुर्दिधक्षया\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2180895, "chapter_id": 4832, "verse_number": "३७", "content_sanskrit": "स तस्य पुरुषेन्द्रस्य प्रभावेन महातपाः ।\nददाह कार्तवीर्यस्य शैलानथ वनानि च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2180896, "chapter_id": 4832, "verse_number": "३८", "content_sanskrit": "स शून्यमाश्रमारण्यम् आपवस्य महात्मनः ।\nददाह पवनेनेद्धश्चित्रभानुः सहैहयः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2180897, "chapter_id": 4832, "verse_number": "३९", "content_sanskrit": "आपवस्तं ततो रोषाच्छशापार्जुनमच्युत ।\nदग्धे श्रमे महाराज कार्तवीर्येण वीर्यवान्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2180898, "chapter_id": 4832, "verse_number": "४०", "content_sanskrit": "त्वया न वर्जितं मोहाद् यस्माद् वनमिदं मम ।\nदग्धं तस्माद् रणे रामो बाहूंस्ते छेत्स्यतेऽर्जुन\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2180899, "chapter_id": 4832, "verse_number": "४१", "content_sanskrit": "अर्जुनस्तु महाराज बली नित्यं शमात्मकः ।\nब्रह्मण्यश्च शरण्यश्च दाता शूरश्च भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2180900, "chapter_id": 4832, "verse_number": "४२", "content_sanskrit": "तस्य पुत्राः सुबलिनः शापेनासन् पितुर्वधे ।\nनिमित्तमवलिप्ता वै नृशंसाश्चैव नित्यदा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2180901, "chapter_id": 4832, "verse_number": "४३", "content_sanskrit": "जमदग्निधेन्वास्ते वत्समानिन्युर्भरतर्षभ ।\nअज्ञातं कार्तवीर्यस्य हैहयेन्द्रस्य धीमतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2180902, "chapter_id": 4832, "verse_number": "४४", "content_sanskrit": "ततोऽर्जुनस्य बाहूंस्तु छित्त्वा वै पौरुषान्वितः ।\nतं रुवन्तं ततो वत्सं जामदग्न्यः स्वमाश्रमम् ।\nप्रत्यानयत राजेन्द्र तेषामन्तःपुरात् प्रभुः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2180903, "chapter_id": 4832, "verse_number": "४५", "content_sanskrit": "अर्जुनस्य सुतास्ते तु सम्भूयाबुद्धयस्तदा ।\nगत्वाऽऽश्रममसम्बुद्धं जमदग्नेर्महात्मनः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2180904, "chapter_id": 4832, "verse_number": "४६", "content_sanskrit": "अपातयन्त भल्लाग्रैः शिरः कायान्नराधिप ।\nसमित्कुशार्थं रामस्य निर्गतस्य महात्मनः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2180905, "chapter_id": 4832, "verse_number": "४७", "content_sanskrit": "प्रत्यक्षं राममातुश्च तथैवाश्रमवासिनाम् ।\nश्रुत्वा रामस्तमर्थं च क्रुद्धः कालानलोपमः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2180906, "chapter_id": 4832, "verse_number": "४८", "content_sanskrit": "धनुर्वेदेऽद्वितीयो हि दिव्यास्त्रैः समलङ्कृतः ।\nचन्द्रबिम्बार्धसङ्काशं परशुं गृह्य भार्गवः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2180907, "chapter_id": 4832, "verse_number": "४९", "content_sanskrit": "ततः पितृवधामर्षाद् रामः परममन्युमान् ।\nनिःक्षत्रियां प्रतिश्रुत्य महीं शस्त्रमगृह्णत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2180908, "chapter_id": 4832, "verse_number": "५०", "content_sanskrit": "ततः स भृगुशार्दूलः कार्तवीर्यस्य वीर्यवान् ।\nविक्रम्य निजघानाशु पुत्रान् पौत्रांश्च सर्वशः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2180909, "chapter_id": 4832, "verse_number": "५१", "content_sanskrit": "स हैहयसहस्राणि हत्वा परममन्युमान् ।\nचकार भार्गवो राजन् महीं शोणितकर्दमाम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2180910, "chapter_id": 4832, "verse_number": "५२", "content_sanskrit": "स तथा सुमहातेजाः कृत्वा निःक्षत्रियां महीम् ।\nकृपया परयाविष्टो वनमेव जगाम ह\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2180911, "chapter_id": 4832, "verse_number": "५३", "content_sanskrit": "ततो वर्षसहस्रेषु समतीतेषु केषुचित् ।\nक्षेपं सम्प्राप्तवांस्तीव्रं प्रकृत्या कोपनः प्रभुः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2180912, "chapter_id": 4832, "verse_number": "५४", "content_sanskrit": "विश्वामित्रस्य पौत्रस्तु रैभ्यपुत्रो महातपाः ।\nपरावसुर्महाराज क्षिप्त्वाह जनसंसदि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2180913, "chapter_id": 4832, "verse_number": "५५", "content_sanskrit": "ये ते ययातिपतने यज्ञे सन्तः समागताः ।\nप्रतर्दनप्रभृतयो राम किं क्षत्रिया न ते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2180914, "chapter_id": 4832, "verse_number": "५६", "content_sanskrit": "मिथ्याप्रतिज्ञो राम त्वं कत्थसे जनसंसदि ।\nभयात् क्षत्रियवीराणां पर्वतं समुपाश्रितः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2180915, "chapter_id": 4832, "verse_number": "५७", "content_sanskrit": "स पुनः क्षत्रियशतैः पृथिवीमनुसन्तताम् ।\nपरावसोस्तदा श्रुत्वा शस्त्रं जग्राह भार्गवः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2180916, "chapter_id": 4832, "verse_number": "५८", "content_sanskrit": "ततो ये क्षत्रिया राजन् शतशस्तेन जीविताः ।\nते विवृद्धा महावीर्याः पृथिवीपतयोऽभवन्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2180917, "chapter_id": 4832, "verse_number": "५९", "content_sanskrit": "स पुनस्तान् जघानाशु बालानपि नराधिप ।\nगर्भस्थैस्तु मही व्याप्ता पुनरेवाभवत् तदा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2180918, "chapter_id": 4832, "verse_number": "६०", "content_sanskrit": "जातं जातं स गर्भं तु पुनरेव जघान ह ।\nअरक्षंश्च सुतान् काश्चित् तदा क्षत्रिययोषितः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2180919, "chapter_id": 4832, "verse_number": "६१", "content_sanskrit": "त्रिःसप्तकृत्वः पृथिवीं कृत्वा निःक्षत्रियां प्रभुः ।\nदक्षिणामश्वमेधान्ते कश्यपायाददत् ततः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2180920, "chapter_id": 4832, "verse_number": "६२", "content_sanskrit": "क्षत्रियाणां तु शेषार्थं करेणोद्दिश्य कश्यपः ।\nसुक्प्रग्रहवता राजन् श्रीमान् वाक्यमथाब्रवीत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2180921, "chapter_id": 4832, "verse_number": "६३", "content_sanskrit": "गच्छ पारं समुद्रस्य दक्षिणस्य महामुने ।\nन ते मद्विषये राम वस्तव्यमिह कर्हिचित्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2180922, "chapter_id": 4832, "verse_number": "६४", "content_sanskrit": "ततः शूर्पाकरोद्देशं सागरस्तस्य निर्ममे ।\nसन्त्रासाज्जामदग्न्यस्य सोऽपरान्तमहीतळम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2180923, "chapter_id": 4832, "verse_number": "६५", "content_sanskrit": "कश्यपस्तु महाराज प्रतिगृह्य महीमिमाम् ।\nकृत्वा ब्राह्मणसंस्थां वै प्रविवेश महावनम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2180924, "chapter_id": 4832, "verse_number": "६६", "content_sanskrit": "ततः शूद्राश्च वैश्याश्च यथास्वैरप्रचारिणः ।\nअवर्तन्त द्विजाग्र्याणां दारेषु भरतर्षभ\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2180925, "chapter_id": 4832, "verse_number": "६७", "content_sanskrit": "अराजके जीवलोके दुर्बला बलवत्तरैः ।\nबाध्यन्ते नच वित्तेषु प्रभुत्वमिह कस्यचित्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2180926, "chapter_id": 4832, "verse_number": "६८", "content_sanskrit": "ब्राह्मणा मद्यपा केचिन्मूर्खाः पण्डितमानिनः ।\nब्राह्मणाः क्षत्रिया वैश्या शूद्राश्चोत्पथगामिनः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2180927, "chapter_id": 4832, "verse_number": "६९", "content_sanskrit": "परस्परं समाश्रित्य घातयन्त्यपथि स्थिताः ।\nस्वधर्मं ब्राह्मणास्त्यक्त्वा पाषण्डांश्च समाश्रिताः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2180928, "chapter_id": 4832, "verse_number": "७०", "content_sanskrit": "चौरिकानृतमायाश्च सर्वे चैव प्रकुर्वते ।\nस्वधर्मस्थान् द्विजान् हत्वा तथाश्रमनिवासिनः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2180929, "chapter_id": 4832, "verse_number": "७१", "content_sanskrit": "वैश्या सत्पथसंस्थाश्च शूद्रा ये चैव धार्मिकाः ।\nतान् सर्वान् घातयन्ति स्म दुराचारा सुनिर्भयाः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2180930, "chapter_id": 4832, "verse_number": "७२", "content_sanskrit": "यज्ञाध्ययनशीलांश्च आश्रमस्थांस्तपस्विनः ।\nगोबालवृद्धनारीणां नाशं कुर्वन्ति चापरे\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2180931, "chapter_id": 4832, "verse_number": "७३", "content_sanskrit": "आन्वीक्षकी त्रयी वार्ता नच नीतिः प्रवर्तते ।\nव्रात्यतां समनुप्राप्ता बहवो हि द्विजातयः ।\nअधरोत्तरापचारेण म्लेच्छभूताश्च सर्वशः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2180932, "chapter_id": 4832, "verse_number": "७४", "content_sanskrit": "ततः कालेन पृथिवी प्रविवेश रसातळम् ।\nअरक्ष्यमाणा विधिवत् क्षत्रियैर्धर्मरक्षिभिः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2180933, "chapter_id": 4832, "verse_number": "७५", "content_sanskrit": "ऊरुणा धारयामास कश्यपः पृथिवीं ततः ।\nनिमज्जन्तीं तदा राजंस्तेनोर्वीति मही स्मृता\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2180934, "chapter_id": 4832, "verse_number": "७६", "content_sanskrit": "रक्षिणश्च समुद्दिश्य प्रायाचत् पृथिवी तदा ।\nप्रसाद्य कश्यपं देवी क्षत्रियान् बाहुशालिनः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2180935, "chapter_id": 4832, "verse_number": "७७", "content_sanskrit": "सन्ति ब्रह्मन् मया गुप्ता नृषु क्षत्रियपुङ्गवाः ।\nहैहयानां कुले जातास्ते संरक्षन्तु मां मुने\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2180936, "chapter_id": 4832, "verse_number": "७८", "content_sanskrit": "अस्ति पौरवदायादो विदूरथसुतः प्रभो ।\nऋक्षैः संवर्धितो विप्र ऋक्षवत्येव पर्वते\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2180937, "chapter_id": 4832, "verse_number": "७९", "content_sanskrit": "तथाऽनुकम्पमानेन यज्वनाऽथामितौजसा ।\nपराशरेण दायादः सौदासस्याभिरक्षितः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2180938, "chapter_id": 4832, "verse_number": "८०", "content_sanskrit": "सर्वकर्माणि कुरुते तस्यर्षेः शूद्रवद्धि सः ।\nसर्वकर्मेत्यभिख्यातः स मां रक्षतु पार्थिवः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2180939, "chapter_id": 4832, "verse_number": "८१", "content_sanskrit": "शिबेः पुत्रो महातेजा गोपतिर्नाम नामतः ।\nवने संरक्षितो गोभिः सोऽभिरक्षतु मां मुने\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2180940, "chapter_id": 4832, "verse_number": "८२", "content_sanskrit": "प्रतर्दनस्य पुत्रस्तु वत्सो नाम महायशाः ।\nवत्सैः संवर्धितो गोष्ठे स मां रक्षतु पार्थिवः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2180941, "chapter_id": 4832, "verse_number": "८३", "content_sanskrit": "दधिवाहनपौत्रस्तु पुत्रो दिविरथस्य ह ।\nअङ्गः स गौतमेनापि गङ्गाकूलेऽभिरक्षितः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2180942, "chapter_id": 4832, "verse_number": "८४", "content_sanskrit": "बृहद्रथो महाबाहुर्भुवि भूतिपुरस्कृतः ।\nगोलाङ्गूलैर्महाभागो गृध्रकूटेऽभिरक्षितः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2180943, "chapter_id": 4832, "verse_number": "८५", "content_sanskrit": "मरुत्तस्यान्ववाये तु क्षत्रियास्तुर्वसोस्त्रयः ।\nमरुत्पतिसमा वीर्ये समुद्रेणाभिरक्षिताः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2180944, "chapter_id": 4832, "verse_number": "८६", "content_sanskrit": "एते क्षत्रियदायादास्तत्र तत्र परिश्रुताः ।\nव्योकारहेमकारादिजातीः नित्यं समाश्रिताः ।\nयदि मामभिरक्षन्ति ततः स्थास्यामि निश्चला\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2180945, "chapter_id": 4832, "verse_number": "८७", "content_sanskrit": "एतेषां पितरश्चैव तथैव च पितामहाः ।\nमदर्थं निहता युद्धे रामेणाक्लिष्टकर्मणा\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2180946, "chapter_id": 4832, "verse_number": "८८", "content_sanskrit": "तेषामपचितिश्चैव मया कार्या न संशयः ।\nनह्यहं कामये नित्यमविक्रान्तेन रक्षणम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2180947, "chapter_id": 4832, "verse_number": "८९", "content_sanskrit": "ततः पृथिव्या निर्दिष्टांस्तान् समानीय कश्यपः ।\nअभ्यषिञ्चत् महीपालान् क्षत्रियान् वीर्यसम्मतान्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2180948, "chapter_id": 4832, "verse_number": "९०", "content_sanskrit": "तेषां पुत्राश्च पौत्राश्च येषां वंशाः प्रतिष्ठिताः ।\nएवमेतत् पुरा वृत्तं यन्मां पृच्छसि पाण्डव\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2180949, "chapter_id": 4832, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2180950, "chapter_id": 4832, "verse_number": "९१", "content_sanskrit": "एवं ब्रुवन्नेव यदुप्रवीरो\nयुधिष्ठिरं धर्मभृतां वरिष्ठम् ।\nरथेन तेनाशु ययौ यथार्को\nविशन् प्रभाभिर्भगवांस्त्रिलोकम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2180951, "chapter_id": 4832, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे एकोनपञ्चाशोऽध्यायः ॥ ४९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]