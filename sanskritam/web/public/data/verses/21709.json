[{"id": 7001709000, "chapter_id": 21709, "verse_number": "१-९५-१", "content_sanskrit": "ब्रह्मोवाच ।\nश्रृणु विप्र प्रवक्ष्यामि पुराणं वायवीयकम् ।\nयस्मिञ्च्छ्रुते लभद्धाम रुद्रस्य परमात्मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001709001, "chapter_id": 21709, "verse_number": "१-९५-२", "content_sanskrit": "चतुर्विंशतिसाहस्रं तत्पुराणं प्रकीर्तितम् ।\nश्वेतकल्पप्रसंगेन धर्मानत्राह मारुतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001709002, "chapter_id": 21709, "verse_number": "१-९५-३", "content_sanskrit": "तद्बायवीयनुदितं भागद्वयसमन्वितम् ।\nसर्गादिलक्षणं यत्र प्रोक्तं विप्र सविस्तरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001709003, "chapter_id": 21709, "verse_number": "१-९५-४", "content_sanskrit": "मन्वंतरेषु वंशाश्च राज्ञां ये यत्र कीर्तिताः ।\nगयासुरस्य हननं विस्तराद्यत्र कीर्तितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001709004, "chapter_id": 21709, "verse_number": "१-९५-५", "content_sanskrit": "मासानां चैव माहात्म्यं माघस्योक्तं फलाधिकम् ।\nदानधर्मा राजधर्मा विस्तरेणोदिता स्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001709005, "chapter_id": 21709, "verse_number": "१-९५-६", "content_sanskrit": "भूपातालककुब्व्योमचारिणां यत्र निर्णयः ।\nव्रतादीनां च पूर्वोऽयं विभागः समुदाहृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001709006, "chapter_id": 21709, "verse_number": "१-९५-७", "content_sanskrit": "उत्तरे तस्य भागेतु नर्मदातीर्थवर्णनम् ।\nशिवस्य संहितोक्ता वै विस्तरेण मुनीश्वर ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001709007, "chapter_id": 21709, "verse_number": "१-९५-८", "content_sanskrit": "यो देवः सर्वदेवानां दुर्विज्ञेयः सनातनः ।\nस तु सर्वात्मना यस्यास्तीरे तिष्ठति संततम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001709008, "chapter_id": 21709, "verse_number": "१-९५-९", "content_sanskrit": "इदं ब्रह्मा हारीरिदं साक्षाच्चेदं परो हरः ।\nइदं ब्रह्म निराकारं कैवल्यं नर्मदाजलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001709009, "chapter_id": 21709, "verse_number": "१-९५-१०", "content_sanskrit": "ध्रुवं लोकहितार्थाय शिवेन स्वशरीरतः ।\nशक्तिः कापि सरिदृपा रेवेयमवतारिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001709010, "chapter_id": 21709, "verse_number": "१-९५-११", "content_sanskrit": "ये वसंत्युत्तरे कूले रुद्रस्यानुचरा हि ते ।\nवसंति याम्यतीरे ये लोकं ते यांति वैष्णवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001709011, "chapter_id": 21709, "verse_number": "१-९५-१२", "content_sanskrit": "ॐकारेश्वरमारभ्ययावत्पश्चिमसागरः ।\nसंगमाः पंच च त्रिंशन्नदीनां पापनाशनी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001709012, "chapter_id": 21709, "verse_number": "१-९५-१३", "content_sanskrit": "दशैकमुत्तरे तीरे त्रयोविंशतिर्दक्षिणे ।\nपंचत्रिंशत्तमः प्रोक्तो रेवासागरसगमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001709013, "chapter_id": 21709, "verse_number": "१-९५-१४", "content_sanskrit": "संगमैः सहितान्येव रेवातीरद्वयेऽपि च ।\nचतुःशतानि तीर्थानि प्रसिद्धानि च संति हि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001709014, "chapter_id": 21709, "verse_number": "१-९५-१५", "content_sanskrit": "षष्टितीर्थसहस्राणि षष्टिकोट्यो मुनीश्वर ।\nसंति चान्यानि रेवायास्तीरयुग्मे पदे पदे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001709015, "chapter_id": 21709, "verse_number": "१-९५-१६", "content_sanskrit": "संहितेयं महापुण्या शिवस्य परमात्मनः ।\nनर्मदाचरितं यत्र वायुना परिकीर्तितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001709016, "chapter_id": 21709, "verse_number": "१-९५-१७", "content_sanskrit": "लिखित्वेदं पुराणं तु गुडधेनुसमन्वितम् ।\nश्रावण्यां यो ददेद्भक्त्या ब्राह्मणाय कुटुंबिने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001709017, "chapter_id": 21709, "verse_number": "१-९५-१८", "content_sanskrit": "रुद्रलोके वसेत्सोऽपि यावदिंद्राश्चतुर्द्दश ।\nयः श्रावयेद्वा श्रृणुयाद्वायवीयमिदं नरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001709018, "chapter_id": 21709, "verse_number": "१-९५-१९", "content_sanskrit": "नियमेन हविष्याशी स रुद्रो नात्र संशयः ।\nयश्चानुक्रमणीमेतां श्रृणोति श्रावयेत्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001709019, "chapter_id": 21709, "verse_number": "१-९५-२०", "content_sanskrit": "सोऽपि सर्वपुराणस्य फलं श्रवणजं लभेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]