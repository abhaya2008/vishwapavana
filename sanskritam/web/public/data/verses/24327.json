[{"id": 7004327000, "chapter_id": 24327, "verse_number": "५-३-२१-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nश्रुतं मे विविधाश्चर्यं त्वत्प्रसादाद्द्विजोत्तम ।\nभूयश्च श्रोतुमिच्छामि तन्मे कथय सुव्रत॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004327001, "chapter_id": 24327, "verse_number": "५-३-२१-२", "content_sanskrit": "कथमेषा नदी पुण्या सर्वनदीषु चोत्तमा ।\nनर्मदा नाम विख्याता भूयो मे कथयानघ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004327002, "chapter_id": 24327, "verse_number": "५-३-२१-३", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nनर्मदा सरितां श्रेष्ठा सर्वपापप्रणाशिनी ।\nतारयेत्सर्वभूतानि स्थावराणि चराणि च॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004327003, "chapter_id": 24327, "verse_number": "५-३-२१-४", "content_sanskrit": "नर्मदायास्तु माहात्म्यं यत्पूर्वेण मया श्रुतम् ।\nतत्तेऽहं सम्प्रवक्ष्यामि शृणुष्वैकमना नृप॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004327004, "chapter_id": 24327, "verse_number": "५-३-२१-५", "content_sanskrit": "गङ्गा कनखले पुण्या कुरुक्षेत्रे सरस्वती ।\nग्रामे वा यदि वारण्ये पुण्या सर्वत्र नर्मदा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004327005, "chapter_id": 24327, "verse_number": "५-३-२१-६", "content_sanskrit": "त्रिभिः सारस्वतं तोयं सप्ताहेन तु यामुनम् ।\nसद्यः पुनाति गाङ्गेयं दर्शनादेव नार्मदम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004327006, "chapter_id": 24327, "verse_number": "५-३-२१-७", "content_sanskrit": "कलिङ्गदेशात्पश्चार्धे पर्वतेऽमरकण्टके ।\nपुण्या च त्रिषु लोकेषु रमणीया पदे पदे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004327007, "chapter_id": 24327, "verse_number": "५-३-२१-८", "content_sanskrit": "तत्र देवाश्च गन्धर्वा ऋषयश्च तपोधनाः ।\nतपस्तप्त्वा महाराज सिद्धिं परमिकां गताः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004327008, "chapter_id": 24327, "verse_number": "५-३-२१-९", "content_sanskrit": "तत्र स्नात्वा नरो राजन्नियमस्थो जितेन्द्रियः ।\nउपोष्य रजनीमेकां कुलानां तारयेच्छतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004327009, "chapter_id": 24327, "verse_number": "५-३-२१-१०", "content_sanskrit": "सिद्धिक्षेत्रं परं तात पर्वतो ह्यमरंकटः ।\nसर्वदेवाश्रितो यस्मादृषिभिः परिसेवितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004327010, "chapter_id": 24327, "verse_number": "५-३-२१-११", "content_sanskrit": "सिद्धविद्याधरा भूतगन्धर्वाः स्थानमुत्तमम् ।\nदृश्यादृश्याश्च राजेन्द्र सेवन्ते सिद्धिकाङ्क्षिणः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004327011, "chapter_id": 24327, "verse_number": "५-३-२१-१२", "content_sanskrit": "अहं च परमं स्थानं ततः प्रभृति संश्रितः ।\nअत्र प्रणवरूपो वै स्थाने तिष्ठत्युमापतिः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004327012, "chapter_id": 24327, "verse_number": "५-३-२१-१३", "content_sanskrit": "श्रीकण्ठः सगणः सर्वभूतसङ्घैर्निषेवितः ।\nअस्माद्गिरिवराद्भूप वक्ष्ये तीर्थस्य विस्तरम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004327013, "chapter_id": 24327, "verse_number": "५-३-२१-१४", "content_sanskrit": "यानि सन्तीह तीर्थानि पुण्यानि नृपसत्तम ।\nयानि यानीह तीर्थानि नर्मदायास्तटद्वये॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004327014, "chapter_id": 24327, "verse_number": "५-३-२१-१५", "content_sanskrit": "न तेषां विस्तरं वक्तुं शक्तो ब्रह्मापि भूपते ।\nयोजनानां शतं साग्रं श्रूयते सरिदुत्तमा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004327015, "chapter_id": 24327, "verse_number": "५-३-२१-१६", "content_sanskrit": "विस्तरेण तु राजेन्द्र अर्धयोजनमायता ।\nषष्टितीर्थसहस्राणि षष्टिकोट्यस्तथैव च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004327016, "chapter_id": 24327, "verse_number": "५-३-२१-१७", "content_sanskrit": "पर्वतादुदधिं यावदुभे कूले न संशयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004327017, "chapter_id": 24327, "verse_number": "५-३-२१-१८", "content_sanskrit": "सप्तषष्टिसहस्राणि सप्तषष्टिशतानि च ।\nसप्तषष्टिस्तथा कोट्यो वायुस्तीर्थानि चाब्रवीत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004327018, "chapter_id": 24327, "verse_number": "५-३-२१-१९", "content_sanskrit": "परं कृतयुगे तानि यान्ति प्रत्यक्षतां नृप ।\nपश्यन्ति मानवाः सर्वे सततं धर्मबुद्धयः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004327019, "chapter_id": 24327, "verse_number": "५-३-२१-२०", "content_sanskrit": "यथायथा कलिर्घोरो वर्तते दारुणो नृप ।\nतथातथाल्पतां यान्ति हीनसत्त्वा यतो नराः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004327020, "chapter_id": 24327, "verse_number": "५-३-२१-२१", "content_sanskrit": "जालेश्वरादितीर्थानि पर्वतेऽस्मिन्नराधिप ।\nपितृतृप्तिप्रदान्याहुः स्वर्गमोक्षप्रदानि च॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004327021, "chapter_id": 24327, "verse_number": "५-३-२१-२२", "content_sanskrit": "श्रेष्ठं दारुवनं तत्र चरुकासंगमः शुभः ।\nउत्तरे नर्मदायास्तु चरुकेश्वरमुत्तमम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004327022, "chapter_id": 24327, "verse_number": "५-३-२१-२३", "content_sanskrit": "दारुकेश्वरतीर्थं च व्यतीपातेश्वरं तथा ।\nपातालेश्वरतीर्थं च कोटियज्ञं तथैव च॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004327023, "chapter_id": 24327, "verse_number": "५-३-२१-२४", "content_sanskrit": "इति चैवोत्तरे कूले रेवाया नृपसत्तम ।\nअमरेश्वरपार्श्वे च लिङ्गान्यष्टोत्तरं शतम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004327024, "chapter_id": 24327, "verse_number": "५-३-२१-२५", "content_sanskrit": "वरुणेश्वरमुख्यानि सर्वपापहराणि च॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004327025, "chapter_id": 24327, "verse_number": "५-३-२१-२६", "content_sanskrit": "मान्धातृपुरपार्श्वे च सिद्धेश्वरयमेश्वरौ ।\nओङ्कारात्पूर्वभागे च केदारं तीर्थमुत्तमम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004327026, "chapter_id": 24327, "verse_number": "५-३-२१-२७", "content_sanskrit": "तत्समीपे महाराज स्वर्गद्वारमघापहम् ।\nनाम्ना ब्रह्मेश्वरं पुण्यं सप्तसारस्वतं पुरः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004327027, "chapter_id": 24327, "verse_number": "५-३-२१-२८", "content_sanskrit": "रुद्राष्टकं च सावित्रं सोमतीर्थं तथैव च ।\nएतानि दक्षिणे तीरे रेवाया भरतर्षभ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004327028, "chapter_id": 24327, "verse_number": "५-३-२१-२९", "content_sanskrit": "अस्मिंस्तु पर्वते तात रुद्राणां कोटयः स्थिताः ।\nस्नानैस्तुष्टिर्भवेत्तेषां गन्धमाल्यानुलेपनैः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004327029, "chapter_id": 24327, "verse_number": "५-३-२१-३०", "content_sanskrit": "प्रीतास्तेऽपि भवन्त्यत्र रुद्रा राजन्न संशयः ।\nजपेन पापसंशुद्धिर्ध्यानेनानन्त्यमश्नुते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004327030, "chapter_id": 24327, "verse_number": "५-३-२१-३१", "content_sanskrit": "दानेन भोगानाप्नोति इत्येवं शङ्करोऽब्रवीत् ।\nपर्वतात्पश्चिमे देशे स्वयं देवो महेश्वरः ।\nस्थितः प्रणवरूपोऽसौ जगदादिः सनातनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004327031, "chapter_id": 24327, "verse_number": "५-३-२१-३२", "content_sanskrit": "तत्र स्नात्वा शुचिर्भूत्वा ब्रह्मचारी जितेन्द्रियः ।\nपितृकार्यं प्रकुर्वीत विधिदृष्टेन कर्मणा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004327032, "chapter_id": 24327, "verse_number": "५-३-२१-३३", "content_sanskrit": "तिलोदकेन तत्रैव तर्पयेत्पितृदेवताः ।\nआ सप्तमं कुलं तस्य स्वर्गे मोदति पाण्डव॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004327033, "chapter_id": 24327, "verse_number": "५-३-२१-३४", "content_sanskrit": "आत्मना सह भोगांश्च विविधान् लभते सुखी ।\nषष्टिवर्षसहस्राणि क्रीडते सुरपूजितः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004327034, "chapter_id": 24327, "verse_number": "५-३-२१-३५", "content_sanskrit": "मोदते सुचिरं कालं पितृपूजाफलधितः ।\nततः स्वर्गात्परिभ्रष्टो जायते विमले कुले॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004327035, "chapter_id": 24327, "verse_number": "५-३-२१-३६", "content_sanskrit": "धनवान्दानशीलश्च नीरोगो लोकपूजितः ।\nपुनः स्मरति तत्तीर्थं गमनं कुरुते पुनः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004327036, "chapter_id": 24327, "verse_number": "५-३-२१-३७", "content_sanskrit": "द्वितीये जन्मनि भवेद्ध्रदस्यानुचरोत्कटः ।\nतथैव ब्रह्मचर्येण सोपवासो जितेन्द्रियः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004327037, "chapter_id": 24327, "verse_number": "५-३-२१-३८", "content_sanskrit": "सर्वहिंसानिवृत्तस्तु लभते फलमुत्तमम् ।\nएवं धर्मसमाचारो यस्तु प्राणान्परित्यजेत्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004327038, "chapter_id": 24327, "verse_number": "५-३-२१-३९", "content_sanskrit": "तस्य पुण्यफलं यद्वै तन्निबोध नराधिप ।\nशतं वर्षसहस्राणि स्वर्गे मोदति पाण्डव॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004327039, "chapter_id": 24327, "verse_number": "५-३-२१-४०", "content_sanskrit": "अप्सरोगणसंकीर्णे दिव्यशब्दानुनादिते ।\nदिव्यगन्धानुलिप्ताङ्गो दिव्यालङ्कारभूषितः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004327040, "chapter_id": 24327, "verse_number": "५-३-२१-४१", "content_sanskrit": "क्रीडते दैवतैः सार्द्धं सिद्धगन्धर्वसंस्तुतः ।\nततः स्वर्गात्परिभ्रष्टो राजा भवति वीर्यवान्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004327041, "chapter_id": 24327, "verse_number": "५-३-२१-४२", "content_sanskrit": "हस्त्यश्वरथयानैश्च धर्मज्ञः शास्त्रतत्परः ।\nगृहे स्तम्भशताकीर्णे सौवर्णे रजतान्विते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004327042, "chapter_id": 24327, "verse_number": "५-३-२१-४३", "content_sanskrit": "सप्ताष्टभूमिसुद्वारे दासीदाससमाकुले ।\nमत्तमातङ्गनिःश्वासैर्वाजिहेषितनादितैः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004327043, "chapter_id": 24327, "verse_number": "५-३-२१-४४", "content_sanskrit": "क्षुभ्यते तस्य तद्द्वारमिन्द्रस्य भुवनं यथा ।\nराजराजेश्वरः श्रीमान्सर्वस्त्रीजनवल्लभः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004327044, "chapter_id": 24327, "verse_number": "५-३-२१-४५", "content_sanskrit": "तस्मिन्गृहे वसित्वा तु क्रीडाभोगसमन्वितः ।\nजीवेद्वर्षशतं साग्रं सर्वव्याधिविवर्जितः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004327045, "chapter_id": 24327, "verse_number": "५-३-२१-४६", "content_sanskrit": "एवं तेषां भवेत्सर्वं ये मृता ह्यमरेश्वरे ।\nअग्निप्रवेशं यः कुर्याद्भक्त्या ह्यमरकण्टके॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004327046, "chapter_id": 24327, "verse_number": "५-३-२१-४७", "content_sanskrit": "स मृतः स्वर्गमाप्नोति यास्यते परमां गतिम् ।\nस्नानं दानं जपो होमः शुभं वा यदि वाशुभम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004327047, "chapter_id": 24327, "verse_number": "५-३-२१-४८", "content_sanskrit": "पुराणे श्रूयते राजन्सर्वं कोटिगुणं भवेत् ।\nतस्यास्तीरे तु ये वृक्षाः पतिताः कालपर्यये॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004327048, "chapter_id": 24327, "verse_number": "५-३-२१-४९", "content_sanskrit": "नर्मदातोयसंस्पृष्टास्ते यान्ति परमां गतिम् ।\nअनिवृत्तिका गतिस्तस्य पवनस्याम्बरे यथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004327049, "chapter_id": 24327, "verse_number": "५-३-२१-५०", "content_sanskrit": "पतनं कुरुते यस्तु तस्मिंस्तीर्थे नराधिप ।\nकन्यास्त्रीणि सहस्राणि पाताले भोगभागिनः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004327050, "chapter_id": 24327, "verse_number": "५-३-२१-५१", "content_sanskrit": "तिष्ठन्ति भवने तस्य प्रेषणे प्रार्थयन्ति च ।\nदिव्यभोगैः सुसम्पन्नः क्रीडते कालम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004327051, "chapter_id": 24327, "verse_number": "५-३-२१-५२", "content_sanskrit": "पृथिव्यां ह्यासमुद्रायां तादृशो नैव जायते ।\nयादृशोऽयं नरश्रेष्ठ पर्वतोऽमरकण्टकः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004327052, "chapter_id": 24327, "verse_number": "५-३-२१-५३", "content_sanskrit": "तत्र तीर्थं तु विज्ञेयं पर्वतस्यानु पश्चिमे ।\nह्रदो जालेश्वरो नाम त्रिषु लोकेषु विश्रुतः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004327053, "chapter_id": 24327, "verse_number": "५-३-२१-५४", "content_sanskrit": "तत्र पिण्डप्रदानेन सन्ध्योपासनकेन तु ।\nपितरो द्वादशाब्दानि तर्पितास्तु भवन्ति वै॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004327054, "chapter_id": 24327, "verse_number": "५-३-२१-५५", "content_sanskrit": "दक्षिणे नर्मदातीरे कपिला तु महानदी ।\nसरलार्जुनसंछन्ना खदिरैरुपशोभिता॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004327055, "chapter_id": 24327, "verse_number": "५-३-२१-५६", "content_sanskrit": "माधवीसल्लकीभिश्च वल्लीभिश्चाप्यलंकृता ।\nश्वापदैर्गर्जमानैश्च गोमायुवानरादिभिः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004327056, "chapter_id": 24327, "verse_number": "५-३-२१-५७", "content_sanskrit": "पक्षिजातिविशेषैश्च नित्यं प्रमुदिता नृप ।\nसाग्रं कोटिशतं तत्र ऋषीणामिति शुश्रुम॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004327057, "chapter_id": 24327, "verse_number": "५-३-२१-५८", "content_sanskrit": "तपस्तप्त्वा गतं मोक्षं येषां जन्म न चागमः ।\nयेन तत्र तपस्तप्तं कपिलेन महात्मना॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004327058, "chapter_id": 24327, "verse_number": "५-३-२१-५९", "content_sanskrit": "तत्र तच्चाभवत्तीर्थं पुण्यं सिद्धनिषेवितम् ।\nयेन सा कापिलैस्तात सेविता ऋषिभिः पुरा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004327059, "chapter_id": 24327, "verse_number": "५-३-२१-६०", "content_sanskrit": "तेन सा कपिला नाम गीता पापक्षयंकरी ।\nतत्र कोटिशतं साग्रं तीर्थानाममरेश्वरे॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004327060, "chapter_id": 24327, "verse_number": "५-३-२१-६१", "content_sanskrit": "अहोरात्रोषितो भूत्वा मुच्यते सर्वकिल्बिषैः ।\nदानं च विधिवद्दत्त्वा यथाशक्त्या द्विजोत्तमे॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004327061, "chapter_id": 24327, "verse_number": "५-३-२१-६२", "content_sanskrit": "ईश्वरानुग्रहात्सर्वं तत्र कोटिगुणं भवेत् ।\nयस्मादनक्षरं रूपं प्रणवस्येह भारत॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004327062, "chapter_id": 24327, "verse_number": "५-३-२१-६३", "content_sanskrit": "शिवस्वरूपस्य ततः कृतमात्राक्षरं भवेत् ।\nतिर्यञ्चः पशवश्चैव वृक्षा गुल्मलतादयः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004327063, "chapter_id": 24327, "verse_number": "५-३-२१-६४", "content_sanskrit": "तेऽपि तत्र क्षयं याताः स्वर्गं यान्ति न संशयः ।\nविशल्या तत्र या प्रोक्ता तत्रैव तु महानदी॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004327064, "chapter_id": 24327, "verse_number": "५-३-२१-६५", "content_sanskrit": "स्नात्वा दत्त्वा यथान्यायं तत्रापि सुकृती भवेत् ।\nतत्र देवगणाः सर्वे सकिन्नरमहोरगाः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004327065, "chapter_id": 24327, "verse_number": "५-३-२१-६६", "content_sanskrit": "यक्षराक्षसगन्धर्वा ऋषयश्च तपोधनाः ।\nसर्वे समागतास्तां वै पश्यन्ति ह्यमरेश्वरे॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004327066, "chapter_id": 24327, "verse_number": "५-३-२१-६७", "content_sanskrit": "तैश्च सर्वैः समागम्य वन्दितौ तौ शुभौ कटौ ।\nपुरा युगे महाघोरे सर्वलोकभयंकरे॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004327067, "chapter_id": 24327, "verse_number": "५-३-२१-६८", "content_sanskrit": "नर्मदायाः सुतस्तत्र सशल्यो विशलीकृतः ।\nसर्वदेवैश्च ऋषिभिर्विशल्या तेन सा स्मृता॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004327068, "chapter_id": 24327, "verse_number": "५-३-२१-६९", "content_sanskrit": "युधिष्ठिर उवाच ।\nउत्पन्ना तु कथं तात विशल्या कपिला कथम् ।\nकथं वा नर्मदापुत्रः शल्ययुक्तोऽभवन्मुने॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004327069, "chapter_id": 24327, "verse_number": "५-३-२१-७०", "content_sanskrit": "आश्चर्यभूतं लोकस्य श्रोतुमिच्छामि सुव्रत॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004327070, "chapter_id": 24327, "verse_number": "५-३-२१-७१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nपुरा दाक्षायणी नाम सहिता शूलपाणिना ।\nक्रीडित्वा नर्मदातोये परया च मुदा नृप॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004327071, "chapter_id": 24327, "verse_number": "५-३-२१-७२", "content_sanskrit": "जलादुत्तीर्य सहसा वस्त्रमन्यत्समाहरत् ।\nदेव्यास्तु स्नानवस्त्रं तत्पीडितं लीलया नृप॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004327072, "chapter_id": 24327, "verse_number": "५-३-२१-७३", "content_sanskrit": "सहितानुचरीभिस्तु इन्द्रायुधनिभं भृशम् ।\nतस्मिन्निष्पीड्यमाने तु वारि यन्निःसृतं तदा॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004327073, "chapter_id": 24327, "verse_number": "५-३-२१-७४", "content_sanskrit": "तस्मादियं सरिज्जज्ञे कपिलाख्या महानदी ।\nसंयोगादङ्गरागस्य वस्त्रोद्यत्कपिलं जलम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004327074, "chapter_id": 24327, "verse_number": "५-३-२१-७५", "content_sanskrit": "गलितं तेन कपिला वर्णतो नामतोऽभवत् ।\nतथा गन्धरसैर्युक्तं नानापुष्पैस्तु वासितम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004327075, "chapter_id": 24327, "verse_number": "५-३-२१-७६", "content_sanskrit": "नानावर्णारुणं शुभ्रं वस्त्राद्यद्वारि निःसृतम् ।\nपीड्यमानं करैः शुभ्रैस्तैस्तु पल्लवकोमलैः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004327076, "chapter_id": 24327, "verse_number": "५-३-२१-७७", "content_sanskrit": "कपिलं जलमिश्रैस्तु तस्मादेषा सरिद्वरा ।\nकपिला चोच्यते तज्ज्ञैः पुराणार्थविशारदैः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004327077, "chapter_id": 24327, "verse_number": "५-३-२१-७८", "content_sanskrit": "एषा वै वस्त्रसम्भूता नर्मदातोयसम्भवा ।\nमहापुण्यतमा ज्ञेया कपिला सरिदुत्तमा॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]