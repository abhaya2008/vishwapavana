[{"id": 7005914000, "chapter_id": 25914, "verse_number": "१-९७-१", "content_sanskrit": "याज्ञवल्क्य उवाच ।\nद्रव्यशुद्धिंप्रवक्ष्यामि तन्निबोधत सत्तमा।\nसौवर्णराजताब्जानां शङ्खरज्ज्वादिचर्मणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005914001, "chapter_id": 25914, "verse_number": "१-९७-२", "content_sanskrit": "पात्राणां चासनानां च वारिणा शुद्धिरिष्यते ।\nउष्णवाभः स्रुक्स्रुवयोर्धान्यादेः प्रोक्षणेन च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005914002, "chapter_id": 25914, "verse_number": "१-९७-३", "content_sanskrit": "तक्षणाद्दारुश्रृङ्गादेर्यज्ञपात्रस्य मारजनात्।\nसोष्णैरुदकगोमूत्रैः शुध्यत्याविककौशिकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005914003, "chapter_id": 25914, "verse_number": "१-९७-४", "content_sanskrit": "भैक्ष्यं योषिन्मुखं पश्यन्पुनः पाकान्महीयम्।\nगोघ्नातेऽन्ने तथा केशमक्षिकाकीटदूषिते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005914004, "chapter_id": 25914, "verse_number": "१-९७-५", "content_sanskrit": "भस्मक्षेपाद्विशुद्धिः स्याद्भूशुद्धिर्माजनदिना।\nत्रपुसीसकताम्राणां क्षाराम्लोदकवारिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005914005, "chapter_id": 25914, "verse_number": "१-९७-६", "content_sanskrit": "भस्माद्भिर्लोहकांस्यानामज्ञातं च सदा शुचि ।\nअमेध्याक्तस्य मृत्तोयैर्गन्धलेपापकर्षणात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005914006, "chapter_id": 25914, "verse_number": "१-९७-७", "content_sanskrit": "शुचि गोतृप्तिदं तोयं प्रकृतिस्थं महीगतम्।\nतथा मांसं श्वचाण्डालक्रव्यादादिनिपातितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005914007, "chapter_id": 25914, "verse_number": "१-९७-८", "content_sanskrit": "रश्मिरग्नी रजश्छाया गौरश्वो वसुधानिलाः ।\nअश्वाजविप्रुषो मेध्या स्तथाचमनबिन्दवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005914008, "chapter_id": 25914, "verse_number": "१-९७-९", "content_sanskrit": "स्नात्वा पीत्वा क्षुते सुप्ते भुक्त्वा रथ्यप्रसर्पणे।\nआचान्तः पुनराचामेद्वासोऽन्यत्परिधाय च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005914009, "chapter_id": 25914, "verse_number": "१-९७-१०", "content_sanskrit": "क्षुते निष्ठीविते स्वापे परिधानेऽश्रुपातने ।\nपञ्चस्वेतेषु नाचामेद्दक्षिणं श्रवणं स्पृशेत् ।\nतिष्ठन्त्यग्न्यादयो देवा विप्रकर्णे तु दक्षिणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]