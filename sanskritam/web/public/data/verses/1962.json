[{"id": 2043041, "chapter_id": 1962, "verse_number": "६-११-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043042, "chapter_id": 1962, "verse_number": "६-११-१", "content_sanskrit": "जम्बूखण्डस्त्वया प्रोक्तो यथावदिह सञ्जय।\nविष्कम्भमस्य प्रब्रूहि परिमाणं तु तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043043, "chapter_id": 1962, "verse_number": "६-११-२", "content_sanskrit": "समुद्रस्य प्रमाणं च सम्यगच्छिद्रदर्शनम् ।\nशाकद्वीपं च मे ब्रूहि कुशद्वीपं च सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043044, "chapter_id": 1962, "verse_number": "६-११-३", "content_sanskrit": "शाल्मलिं चैव तत्त्वेन क्रौञ्चद्वीपं तथैव च।\nब्रूहि गावल्गणे सर्वं राहोः सोमार्कयोस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043045, "chapter_id": 1962, "verse_number": "६-११-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043046, "chapter_id": 1962, "verse_number": "६-११-४", "content_sanskrit": "राजन्सुबहवो द्वीपा यैरिदं सन्ततं जगत्।\nसप्त द्वीपान्प्रवक्ष्यामि चन्द्रादित्यौ ग्रहं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043047, "chapter_id": 1962, "verse_number": "६-११-५", "content_sanskrit": "अष्टादश सहस्राणि योजनानि विशांपते।\nषट् शतानि च पूर्णानि विष्कम्भो जम्बुपर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043048, "chapter_id": 1962, "verse_number": "६-११-६", "content_sanskrit": "लावणस्य समुद्रस्य विष्कम्भो द्विगुणः स्मृतः ।\nनानाजनपदाकीर्णो मणिविद्रुमचित्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043049, "chapter_id": 1962, "verse_number": "६-११-७", "content_sanskrit": "नैकधातुविचित्रैश्च पर्वतैरुपशोभितः।\nसिद्धचारणसंकीर्णः सागरः परिमण्डलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043050, "chapter_id": 1962, "verse_number": "६-११-८", "content_sanskrit": "शाकद्वीपं च वक्ष्यामि यथावदिह पार्थिव ।\nशृणु मे त्वं यथान्यायं ब्रुवतः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043051, "chapter_id": 1962, "verse_number": "६-११-९", "content_sanskrit": "जम्बूद्वीपपरमाणेन द्विगुणः स नराधिप ।\nविष्कम्भेण महाराज सागरोऽपि विभागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043052, "chapter_id": 1962, "verse_number": "६-११-१०", "content_sanskrit": "क्षीरोदो भरतश्रेष्ठ येन संपरिवारिताः ।\nतत्र पुण्या जनपदास्तत्र न म्रियते जनः।\nकुत एव हि दुर्भिक्षं क्षमातेजोयुता हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043053, "chapter_id": 1962, "verse_number": "६-११-११", "content_sanskrit": "शाकद्वीपस्य संक्षेपो यथावद्भरतर्षभ।\nउक्त एष महाराज किमन्यत्कथयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043054, "chapter_id": 1962, "verse_number": "६-११-१२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043055, "chapter_id": 1962, "verse_number": "६-११-१२", "content_sanskrit": "शाकद्वीपस्य संक्षेपो यथावदिह सञ्जय ।\nउक्तस्त्वया महाप्राज्ञ विस्तरं ब्रूहि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043056, "chapter_id": 1962, "verse_number": "६-११-१३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043057, "chapter_id": 1962, "verse_number": "६-११-१३", "content_sanskrit": "तथैव पर्वता राजन्सप्तात्र मणिभूषिताः।\nरत्नाकरास्तथा नद्यस्तेषां नामानि मे शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043058, "chapter_id": 1962, "verse_number": "६-११-१४", "content_sanskrit": "अतीव गुणवत्सर्वं तत्र पुण्यं जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043059, "chapter_id": 1962, "verse_number": "६-११-१५", "content_sanskrit": "देवर्षिगन्धर्वयुतः प्रथमो मेरुरुच्यते।\nप्रागायतो महाराज मलयो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043060, "chapter_id": 1962, "verse_number": "६-११-१६", "content_sanskrit": "ततो मेघाः प्रवर्तन्ते प्रभवन्ति च सर्वशः ।\nततः परेण कौरव्य जलधारो महागिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043061, "chapter_id": 1962, "verse_number": "६-११-१७", "content_sanskrit": "ततो नित्युमुपादत्ते वासवः परमं जलम्।\nततो वर्षं प्रभवति वर्षकाले जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043062, "chapter_id": 1962, "verse_number": "६-११-१८", "content_sanskrit": "उच्चैर्गिरी रैवतको यत्र नित्यं प्रतिष्ठिता।\nरेवती दिवि नक्षत्रं पितामहकृतो विधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043063, "chapter_id": 1962, "verse_number": "६-११-१९", "content_sanskrit": "उत्तरेण तु राजेन्द्र श्यामो नाम महागिरिः ।\nनवमेघप्रभः प्रांशुः श्रीमानुज्ज्वलविग्रहः ।\nयतः श्यामत्वमापन्नाः प्रजा जनपदेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043064, "chapter_id": 1962, "verse_number": "६-११-२०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043065, "chapter_id": 1962, "verse_number": "६-११-२०", "content_sanskrit": "सुमहान्संशयो मेऽद्य प्रोक्तोऽयं सञ्जय त्वया।\nप्रजाः कथं सूतपुत्र संप्राप्ताः श्यामतामिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043066, "chapter_id": 1962, "verse_number": "६-११-२१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043067, "chapter_id": 1962, "verse_number": "६-११-२१", "content_sanskrit": "सर्वेष्वेव महाराज द्वीपेषु कुरुनन्दन।\nगौरः कृष्णश्च पतगस्तयोर्वर्णान्तरे नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043068, "chapter_id": 1962, "verse_number": "६-११-२२", "content_sanskrit": "श्यामो यस्मात्प्रवृत्तो वै तस्माच्छ्यामो गिरिःस्मृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043069, "chapter_id": 1962, "verse_number": "६-११-२३", "content_sanskrit": "ततः परं कौरवेन्द्र दुर्गशैलो महोदयः ।\nकेसरः केसरयुतो यतो वातः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2043070, "chapter_id": 1962, "verse_number": "६-११-२४", "content_sanskrit": "तेषां योजनविष्कम्भो द्विगुणः प्रविभागशः।\nवर्षाणि तेषु कौरव्य सप्तोक्तानि मनीषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2043071, "chapter_id": 1962, "verse_number": "६-११-२५", "content_sanskrit": "महामेरुर्महाकाशो जलदः कुमुदोत्तरः ।\nजलधारो महाराज सुकुमार इति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2043072, "chapter_id": 1962, "verse_number": "६-११-२६", "content_sanskrit": "रेवतस्य तु कौमारः श्यामस्य मणिकाञ्चनः ।\nकेसरस्याथ मौदाकी परेण तु महापुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2043073, "chapter_id": 1962, "verse_number": "६-११-२७", "content_sanskrit": "परिवार्य तु कौरव्य दैर्घ्यं ह्रस्वत्वमेव च।\nजम्बूद्वीपेन संक्यातस्तस्य मध्ये महाद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2043074, "chapter_id": 1962, "verse_number": "६-११-२८", "content_sanskrit": "शाको नाम महाराज प्रजा तस्य सदानुगा।\nतत्र पुण्या जनपदाः पूज्यते तत्र शंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2043075, "chapter_id": 1962, "verse_number": "६-११-२९", "content_sanskrit": "तत्र गच्छन्ति सिद्धाश्च चारणा दैवतानि च।\nधार्मिकाश्च प्रजा राजंश्चत्वारोऽतीव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2043076, "chapter_id": 1962, "verse_number": "६-११-३०", "content_sanskrit": "वर्णाः स्वकर्मनिरता न च स्तेनोऽत्र दृश्यते ।\nदीर्घायुषो महाराज जरामृत्युविवर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2043077, "chapter_id": 1962, "verse_number": "६-११-३१", "content_sanskrit": "प्रजास्तत्र विवर्धन्ते वर्षास्विव समुद्रगाः।\nनद्यः पुण्यजलास्तत्र गङ्गा च बहुधा गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2043078, "chapter_id": 1962, "verse_number": "६-११-३२", "content_sanskrit": "सुकुमारी कुमारी च शीताशी वेणिका तथा।\nमहानदी च कौरव्य तथा मणिजला नदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2043079, "chapter_id": 1962, "verse_number": "६-११-३३", "content_sanskrit": "चक्षुर्वर्धनिका चैव नदी भरतसत्तम ।\nतत्र प्रवृत्ताः पुण्योदा नद्यः कुरुकुलोद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2043080, "chapter_id": 1962, "verse_number": "६-११-३४", "content_sanskrit": "सहस्राणां शतान्येव यतो वर्षति वासवः ।\nन तासां नामधेयानि परिमाणं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2043081, "chapter_id": 1962, "verse_number": "६-११-३५", "content_sanskrit": "शक्यन्ते परिसंख्यातुं पुण्यास्ता हि सरिद्वराः ।\nतत्र पुण्या जनपदाश्चत्वारो लोकसंमताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2043082, "chapter_id": 1962, "verse_number": "६-११-३६", "content_sanskrit": "मङ्गाश्च मशकाश्चैव मानसा मन्दगास्तथा ।\nमङ्गा ब्राह्मणभूयिष्ठाः स्वकर्मनिरता नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2043083, "chapter_id": 1962, "verse_number": "६-११-३७", "content_sanskrit": "मशकेषु च राजन्या धार्मिकाः सर्वकामदाः ।\nमानसाश्च महाराज वैश्यधर्मोपजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2043084, "chapter_id": 1962, "verse_number": "६-११-३८", "content_sanskrit": "सर्वकामसमायुक्ताः शूरा धर्मार्थनिश्चिताः ।\nशूद्रास्तु मन्दगा नित्यं पुरुषा धर्मशीलिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2043085, "chapter_id": 1962, "verse_number": "६-११-३९", "content_sanskrit": "न तत्र राजा राजेन्द्र न दण्डो न च दण्डिकाः।\nस्वधर्मेणैव धर्मज्ञास्ते रक्षन्ति परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2043086, "chapter_id": 1962, "verse_number": "६-११-४०", "content_sanskrit": "एतावदेव शक्यं तु तत्र द्वीपे प्रभाषितुम्।\nएतदेव च श्रोतव्यं शाकद्वीपे महौजसि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2043087, "chapter_id": 1962, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भूमिपर्वणि एकादशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]