[{"id": 50002371, "chapter_id": 10571, "verse_number": "1", "content_sanskrit": "अव्यक्तोऽयमचिन्त्योऽयमविकार्योऽयमुच्यते। तस्मादेवं विदित्वैनं नानुशोचितुमर्हसि॥ २/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002372, "chapter_id": 10571, "verse_number": "2", "content_sanskrit": "॥ देहनाशप्रयुक्तशोकनिरासप्रकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002373, "chapter_id": 10571, "verse_number": "3", "content_sanskrit": "अथ चैनं नित्यजातं नित्यं वा मन्यसे मृतम्। तथाऽपि त्वं महाबाहो नैनं शोचितुमर्हसि॥ २/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002374, "chapter_id": 10571, "verse_number": "4", "content_sanskrit": "जातस्य हि ध्रुवो मृत्युर्ध्रुवं जन्म मृतस्य च। तस्मादपरिहार्येऽर्थे न त्वं शोचितुमर्हसि॥ २/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002375, "chapter_id": 10571, "verse_number": "5", "content_sanskrit": "अव्यक्तादीनि भूतानि व्यक्तमध्यानि भारत। अव्यक्तनिधनान्येव तत्र का परिदेवना॥ २/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002376, "chapter_id": 10571, "verse_number": "6", "content_sanskrit": "॥ ईश्वरसामर्थ्योपदर्शनपूर्वकमुपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50002377, "chapter_id": 10571, "verse_number": "7", "content_sanskrit": "आश्चर्यवत् पश्यति कश्चिदेनमाश्चर्यवद् वदति तथैव चान्यः। आश्चर्यवच्चैनमन्यः शृणोति श्रुत्वाऽप्येनं वेद नचैव कश्चित्॥ २/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50002378, "chapter_id": 10571, "verse_number": "8", "content_sanskrit": "देही नित्यमवध्योऽयं देहे सर्वस्य भारत। तस्मात् सर्वाणि भूतानि न त्वं शोचितुमर्हसि॥ २/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50002379, "chapter_id": 10571, "verse_number": "9", "content_sanskrit": "॥ स्वधर्मविधानप्रकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50002380, "chapter_id": 10571, "verse_number": "10", "content_sanskrit": "स्वधर्ममपि चावेक्ष्य न विकम्पितुमर्हसि। धर्म्याद्धि युद्धाच्छ्रेयोऽन्यत् क्षत्रियस्य न विद्यते॥ २/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50002381, "chapter_id": 10571, "verse_number": "11", "content_sanskrit": "यदृच्छया चोपपन्नं स्वर्गद्वारमपावृतम्। सुखिनः क्षत्रियाः पार्थ लभन्ते युद्धमीदृशम्॥ २/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50002382, "chapter_id": 10571, "verse_number": "12", "content_sanskrit": "अथ चेत् त्वं धर्म्यमिमं सङ्ग्रामं न करिष्यसि। ततः स्वधर्मं कीर्तिं च हित्वा पापमवाप्स्यसि॥ २/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50002383, "chapter_id": 10571, "verse_number": "13", "content_sanskrit": "अकीर्तिं चापि भूतानि कथयिष्यन्ति तेऽव्ययाम्। सम्भावितस्य चाकीर्तिर्मरणादतिरिच्यते॥ २/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50002384, "chapter_id": 10571, "verse_number": "14", "content_sanskrit": "भयाद् रणादुपरतं मंस्यन्ते त्वां महारथाः। येषां च त्वं बहुमतो भूत्वा यास्यसि लाघवम्॥ २/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50002385, "chapter_id": 10571, "verse_number": "15", "content_sanskrit": "अवाच्यवादांश्च बहून् वदिष्यन्ति तवाहिताः। निन्दन्तस्तव सामर्थ्यं ततो दुःखतरं नु किम्॥ २/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50002386, "chapter_id": 10571, "verse_number": "16", "content_sanskrit": "हतो वा प्राप्स्यसि स्वर्गं जित्वा वा भोक्ष्यसे महीम्। तस्मादुत्तिष्ठ कौन्तेय युद्धाय कृतनिश्चयः॥ २/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50002387, "chapter_id": 10571, "verse_number": "17", "content_sanskrit": "सुखदुःखे समे कृत्वा लाभालाभौ जयाजयौ। ततो युद्धाय युज्यस्व नैवं पापमवाप्स्यसि॥ २/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50002388, "chapter_id": 10571, "verse_number": "18", "content_sanskrit": "॥ योगकथनप्रतिज्ञा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50002389, "chapter_id": 10571, "verse_number": "19", "content_sanskrit": "एषा तेऽभिहिता साङ्ख्ये बुद्धिर्योगे त्विमां शृणु। बुद्ध्या युक्तो यया पार्थ कर्मबन्धं प्रहास्यसि॥ २/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50002390, "chapter_id": 10571, "verse_number": "20", "content_sanskrit": "॥ योगस्तुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50002391, "chapter_id": 10571, "verse_number": "21", "content_sanskrit": "नेहाभिक्रमनाशोऽस्ति प्रत्यवायो न विद्यते। स्वल्पमप्यस्य धर्मस्य त्रायते महतो भयात्॥ २/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]