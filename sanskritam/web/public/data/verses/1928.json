[{"id": 2041713, "chapter_id": 1928, "verse_number": "५-१७३-०x", "content_sanskrit": "दुर्योधनं उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041714, "chapter_id": 1928, "verse_number": "५-१७३-१", "content_sanskrit": "किमर्थं भरतश्रेष्ठ नैव हन्याः शिखण्डिनम् ।\nउद्यतेषुमथो दृष्ट्वा समरेष्वाततायिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041715, "chapter_id": 1928, "verse_number": "५-१७३-२", "content_sanskrit": "पूर्वमुक्त्वा महाबाहो पाञ्चालान्सह सोमकैः ।\nहनिष्यामीति गाङ्गेय तन्मे ब्रूहि पितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041716, "chapter_id": 1928, "verse_number": "५-१७३-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041717, "chapter_id": 1928, "verse_number": "५-१७३-३", "content_sanskrit": "श्रृणु दुर्योधन कथां सहैभिर्वसुधाधिपैः ।\nयदर्थं युधि संप्रेक्ष्य नाहं हन्यां शिखण्डिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041718, "chapter_id": 1928, "verse_number": "५-१७३-४", "content_sanskrit": "महाराजो मम पिता शान्तनुर्लोकविश्रुतः ।\nदिष्टान्तमाप धर्मात्मा समये भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041719, "chapter_id": 1928, "verse_number": "५-१७३-५", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ प्रतिज्ञां परिपालयन् ।\nचित्राङ्गदं भ्रातरं वै महाराज्येऽभ्यपेचयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041720, "chapter_id": 1928, "verse_number": "५-१७३-६", "content_sanskrit": "तस्मिंश्च निधनं प्राप्ते सत्यवत्या मते स्थितः ।\nविचित्रवीर्यं राजानमभ्यषिञ्चं यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041721, "chapter_id": 1928, "verse_number": "५-१७३-७", "content_sanskrit": "मयाऽभिषिक्तो राजेन्द्र यवीयानपि धर्मतः ।\nविचित्रवीर्यो धर्मात्मा मामेव समुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041722, "chapter_id": 1928, "verse_number": "५-१७३-८", "content_sanskrit": "तस्य दारक्रियां तात चिकीर्षुरहमप्युत ।\nअनुरूपादिव कुलादित्येव च मनो दधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041723, "chapter_id": 1928, "verse_number": "५-१७३-९", "content_sanskrit": "तथाऽश्रौषं महाबाहो तिस्रः कन्याः स्वयंवरे ।\nरूपेणाप्रतिमाः सर्वाः काशिराजसुतास्तदा ।\nअम्बां चैवाम्बिकां चैव तथैवाम्बालिकामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041724, "chapter_id": 1928, "verse_number": "५-१७३-१०", "content_sanskrit": "राजानश्च समाहूताः पृथिव्यां भरतर्षभ।\nअम्बा ज्येष्ठाभवत्तासामम्बिका त्वथ मध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041725, "chapter_id": 1928, "verse_number": "५-१७३-११", "content_sanskrit": "अम्बालिका च राजेन्द्र राजकन्या यवीयसी ।\nसोऽहमेकरथेनैव गतः काशिपतेः पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041726, "chapter_id": 1928, "verse_number": "५-१७३-१२", "content_sanskrit": "अपश्यं ता महाबाहो तिस्रः कन्याः स्वलङ्कृताः।\nराज्ञश्चैव समाहूतान्पार्थिवान्पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041727, "chapter_id": 1928, "verse_number": "५-१७३-१३", "content_sanskrit": "ततोऽहं तान्नृपान्सर्वानाहूय समरे स्थितान्।\nरथमारोपयाञ्चक्रे कन्यास्ता भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041728, "chapter_id": 1928, "verse_number": "५-१७३-१४", "content_sanskrit": "वीर्यशुल्काश्च ता ज्ञात्वा समारोप्य रथं तदा।\nअवोचं पार्थिवान्सर्वानहं तत्र समागतान्।\nभीष्मः शान्तनवः कन्या हरतीति पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041729, "chapter_id": 1928, "verse_number": "५-१७३-१५", "content_sanskrit": "ते यतध्वं परं शक्त्या सर्वे मोक्षाय पार्थिवाः ।\nप्रसह्य हि हराम्येष मिषतां वो नरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041730, "chapter_id": 1928, "verse_number": "५-१७३-१६", "content_sanskrit": "ततस्ते पृथिवीपालाः समुत्पतुरुदायुधाः ।\nयोगो योग इति क्रुद्धाः सारथीनभ्यचोदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041731, "chapter_id": 1928, "verse_number": "५-१७३-१७", "content_sanskrit": "ते रथैर्गसङ्काशैर्गजैश्च गजयोधिनः।\nपुष्टैश्वाश्वैर्महीपालाः समुत्पेतुरुदायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041732, "chapter_id": 1928, "verse_number": "५-१७३-१८", "content_sanskrit": "ततस्ते मां महीपालाः सर्व एव विशां पते।\nरथव्रातेन महता सर्वतः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041733, "chapter_id": 1928, "verse_number": "५-१७३-१९", "content_sanskrit": "तानहं शरवर्षेण समन्तात्पर्यवारयम् ।\nसर्वान्नृपांश्चाप्यजयं देवराडिव दानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041734, "chapter_id": 1928, "verse_number": "५-१७३-२०", "content_sanskrit": "अपातयं शरैर्दीप्तैः प्रहसन्भरतर्षभ ।\nतेषामापततां चित्रान्ध्वजान्हेमपरिष्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041735, "chapter_id": 1928, "verse_number": "५-१७३-२१", "content_sanskrit": "एकैकेन हि बाणेन भूमौ पातितवानहम् ।\nहयांस्तेषां गजांश्चैव सारथींश्चाप्यहं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041736, "chapter_id": 1928, "verse_number": "५-१७३-२२", "content_sanskrit": "ते निवृत्ताश्च भग्नाश्च दृष्ट्वा तल्लाघवं मम। ५-१७३-२२b`प्रणिपेतुश्च सर्वे वै प्रशशंसुश्च पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041737, "chapter_id": 1928, "verse_number": "५-१७३-२३", "content_sanskrit": "तत आदाय ताः कन्या नृपतींश्च विसृज्य तान्।\nअथाऽहं हास्तिनपुरमायां जित्वा महीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041738, "chapter_id": 1928, "verse_number": "५-१७३-२४", "content_sanskrit": "ततोऽहं ताश्च कन्या वै भ्रातुरर्थाय भारत।\nतच्च कर्म महाबाहो सत्यवत्यै न्यवेदयम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041739, "chapter_id": 1928, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि त्रिसप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]