[{"id": 2037832, "chapter_id": 1819, "verse_number": "५-६४-०x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037833, "chapter_id": 1819, "verse_number": "५-६४-१", "content_sanskrit": "शकुनीनामिहार्थाय पाशं भूमावयोजयत्।\nकश्चिच्छाकुनिकस्तात पूर्वेषामिति शुश्रुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037834, "chapter_id": 1819, "verse_number": "५-६४-२", "content_sanskrit": "तस्मिंस्तौ शकुनौ बद्धौ युगपत्सहचारिणौ।\nतावुपादाय तं पाशं जग्मतुः खचरावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037835, "chapter_id": 1819, "verse_number": "५-६४-३", "content_sanskrit": "तौ विहायसमाक्रान्तौ दृष्ट्वा शाकुनिकस्तदा ।\nअन्वधावदनिर्विण्णो येन येन स्म गच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037836, "chapter_id": 1819, "verse_number": "५-६४-४", "content_sanskrit": "तथा तमनुधावन्तमृगयुं शकुनार्थिनम् ।\nआश्रमस्थो मुनिः कश्चिद्ददर्शाथ कृताह्निकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037837, "chapter_id": 1819, "verse_number": "५-६४-५", "content_sanskrit": "तावन्तरिक्षगौ शीघ्रमनुयान्तं महीचरम्।\nश्लोकेनानेन कौरव्य पप्च्छ स मुनिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037838, "chapter_id": 1819, "verse_number": "५-६४-६", "content_sanskrit": "विचित्रमिदमाश्चर्यं मृगहन्प्रतिभाति मे।\nप्लवमानौ हि खचरौ पदातिरनुधावसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037839, "chapter_id": 1819, "verse_number": "५-६४-७x", "content_sanskrit": "शाकुनिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037840, "chapter_id": 1819, "verse_number": "५-६४-७", "content_sanskrit": "पाशमेकमुभावेतौ सहितौ हरतो मम।\nयत्र वै विवदिष्येते तत्र मे वशमेष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037841, "chapter_id": 1819, "verse_number": "५-६४-८x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037842, "chapter_id": 1819, "verse_number": "५-६४-८", "content_sanskrit": "तौ विवादमनुप्राप्तौ शकुनौ मृत्युसन्धितौ।\nविगृह्य च स्रुदुर्बुद्धी पृथिव्यां संनिपेततुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037843, "chapter_id": 1819, "verse_number": "५-६४-९", "content_sanskrit": "तौ युध्यमानौ संरब्धौ मृत्युपाशवशानुगौ ।\nउपसृत्य प्रमत्तौ तौ जग्राह मृगहा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037844, "chapter_id": 1819, "verse_number": "५-६४-१०", "content_sanskrit": "एवं ये ज्ञातयोऽर्थेषु मिथो गच्छन्ति विग्रहम्।\nते मृत्युवशमायान्ति शकुनाविव विग्रहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037845, "chapter_id": 1819, "verse_number": "५-६४-११", "content_sanskrit": "संभोजनं संकथनं संप्रश्नोऽथ समागमः ।\nएतानि ज्ञातिकार्याणि न विरोधः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037846, "chapter_id": 1819, "verse_number": "५-६४-१२", "content_sanskrit": "ये स्म काले सुमनसः सर्वे वृद्धानुपासते।\nसिंहगुप्तमिवारण्यमप्रधृष्या भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037847, "chapter_id": 1819, "verse_number": "५-६४-१३", "content_sanskrit": "येऽर्थं सन्ततमासाद्य दीना इव समासते।\nश्रियं ते संप्रयच्छन्ति द्विषद्भ्यो भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037848, "chapter_id": 1819, "verse_number": "५-६४-१४", "content_sanskrit": "धूमायन्ते व्यपेतानि ज्वलन्ति सहितानि च।\nधृतराष्ट्रोल्मुकानीव ज्ञातयो भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037849, "chapter_id": 1819, "verse_number": "५-६४-१५", "content_sanskrit": "इदमन्यत्प्रवक्ष्यामि यथा दृष्टं गिरौ मया।\nश्रुत्वा तदपि कौरव्य यथा श्रेयस्तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037850, "chapter_id": 1819, "verse_number": "५-६४-१६", "content_sanskrit": "वयं किरातैः सहिता गच्छामो गिरिमुत्तरम् ।\nब्राह्मणैर्देवकल्पैश्च विद्याजम्भकवार्तिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037851, "chapter_id": 1819, "verse_number": "५-६४-१७", "content_sanskrit": "कुञ्चभूतं गिरिं सर्वमभितो गन्धमादनम्।\nदीप्यमानौषधिगणं सिद्धगन्धर्वसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037852, "chapter_id": 1819, "verse_number": "५-६४-१८", "content_sanskrit": "तत्रापश्याम वै सर्वे मधु पीतकमाक्षिकम्।\nमरुप्रपाते विषमे निविष्टं कुम्भसंमितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037853, "chapter_id": 1819, "verse_number": "५-६४-१९", "content_sanskrit": "आशीविषै रक्ष्यमाणं कुबेरदयितं भृशम्।\nयत्प्राप्य पुरुषो मर्त्योऽप्यमरत्वं नियच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037854, "chapter_id": 1819, "verse_number": "५-६४-२०", "content_sanskrit": "अचक्षुर्लभते चक्षुर्वृद्धो भवति वै युवा।\nइति ते कथयन्तिस्म ब्राह्मणा जम्भसाधकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037855, "chapter_id": 1819, "verse_number": "५-६४-२१", "content_sanskrit": "ततः किरातास्तद्दृष्ट्वा प्रार्थयन्तो महीपते।\nविनेशुर्विषमे तस्मिन्ससर्पे गिरिगह्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037856, "chapter_id": 1819, "verse_number": "५-६४-२२", "content_sanskrit": "तथैव तव पुत्रोऽयं पृथिवीमेक इच्छति।\nमधु पश्यति संमोहात्प्रपातं नानुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037857, "chapter_id": 1819, "verse_number": "५-६४-२३", "content_sanskrit": "दुर्योधनो योद्धुमनाः समरे सव्यसाचिना।\nन च पश्यामि तेजोस्य विक्रमं वा तथाविधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037858, "chapter_id": 1819, "verse_number": "५-६४-२४", "content_sanskrit": "एकेन रथमास्थाय पृथिवी येन निर्जिता ।\nभीष्मद्रोणप्रभृतयः सन्त्रस्ताः साधुयायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037859, "chapter_id": 1819, "verse_number": "५-६४-२५", "content_sanskrit": "विराटनगरे भग्नाः किं तत्र तव दृश्यताम् ।\nप्रतीक्षमाणो यो वीरः क्षमते वीक्षितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037860, "chapter_id": 1819, "verse_number": "५-६४-२६", "content_sanskrit": "द्रुपदो मत्स्यराजश्च सङ्कुद्धश्च धनञ्जयः ।\nन शेषयेयुः समरे वायुयुक्ता इवाग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037861, "chapter_id": 1819, "verse_number": "५-६४-२७", "content_sanskrit": "अङ्के कुरुष्व राजानं धृतराष्ट्र युधिष्ठिरम्।\nयुध्यतोर्हि द्वयोर्युद्धे नैकान्तेन भवेञ्जयः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037862, "chapter_id": 1819, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि चतुःषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]