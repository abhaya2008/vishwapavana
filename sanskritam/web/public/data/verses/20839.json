[{"id": 7000839000, "chapter_id": 20839, "verse_number": "६-१८२-१", "content_sanskrit": "शिव उवाच ।\nअष्टमाध्यायमाहात्म्यं शृणु वक्ष्यामि पार्वति ।\nयस्य श्रवणमात्रेण परां मुदमवाप्स्यसि॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000839001, "chapter_id": 20839, "verse_number": "६-१८२-२", "content_sanskrit": "आमर्दकं पुरं नाम्ना विश्रुतं दक्षिणापथि ।\nद्विजन्मा भावशर्मेति तत्रासीद्गणिकापतिः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000839002, "chapter_id": 20839, "verse_number": "६-१८२-३", "content_sanskrit": "खादन्मांसं पिबन्मद्यं चोरयन्साधुसंपदः ।\nरममाणः परस्त्रीभिराखेटक कुतूहली॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000839003, "chapter_id": 20839, "verse_number": "६-१८२-४", "content_sanskrit": "अत्यवाहयदत्युग्रो गरीयांसं मनोरथम् ।\nसुहृदां विटगोष्ठ्यां च तालीफलसुधारसम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000839004, "chapter_id": 20839, "verse_number": "६-१८२-५", "content_sanskrit": "निपीय कंठपर्यंतमजीर्णेनातिपीडितः ।\nमृतः कालेन पापात्मा जातस्तालीतरुर्महान्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000839005, "chapter_id": 20839, "verse_number": "६-१८२-६", "content_sanskrit": "तस्यच्छायामुपाश्रित्य निबिडामतिशीतलाम् ।\nअभूतां दंपती कौचिद्ब्रह्मराक्षसतां गतौ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000839006, "chapter_id": 20839, "verse_number": "६-१८२-७", "content_sanskrit": "देव्युवाच ।\nकिं जातीयौ किमात्मानौ किंवृत्तावित्युदीरय ।\nकर्मणा केन वा देव ब्रह्मराक्षसता तयोः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000839007, "chapter_id": 20839, "verse_number": "६-१८२-८", "content_sanskrit": "शिव उवाच ।\nवेदवेदांगतत्वज्ञः सर्वशास्त्रार्थकोविदः ।\nसदाचारोऽभवत्कश्चिद्दिवजो नाम कुशीवलः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000839008, "chapter_id": 20839, "verse_number": "६-१८२-९", "content_sanskrit": "जाया च तस्य कुमति नामधेया दुराशया ।\nस सभार्यो महादानान्याददानोऽतिलोभवान्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000839009, "chapter_id": 20839, "verse_number": "६-१८२-१०", "content_sanskrit": "महिषीं कालपुरुषं हयादीननुवासरम् ।\nअप्रयच्छन्द्विजातिभ्यो दानलब्धां वराटिकाम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000839010, "chapter_id": 20839, "verse_number": "६-१८२-११", "content_sanskrit": "कालेन दंपती प्रेतौ ब्रह्मराक्षसरूपिणौ ।\nपर्यटंतौ महीमेतां क्षुत्तृषाकुलविग्रहौ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000839011, "chapter_id": 20839, "verse_number": "६-१८२-१२", "content_sanskrit": "विशश्रमतुरागत्य मूलं तालीतरोस्ततः ।\nकथमेतन्महादुःखमावयोरपगच्छति॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000839012, "chapter_id": 20839, "verse_number": "६-१८२-१३", "content_sanskrit": "कथं वा जायते मुक्तिर्ब्रह्मराक्षसयोनितः ।\nइति पृष्टो गृहिण्याऽसौ ब्राह्मणः समभाषत॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000839013, "chapter_id": 20839, "verse_number": "६-१८२-१४", "content_sanskrit": "ब्रह्मविद्योपदेशेन विनाध्यात्मविचारणात् ।\nविनाकर्मविधिज्ञानात्कथं मुच्येत संकटात्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000839014, "chapter_id": 20839, "verse_number": "६-१८२-१५", "content_sanskrit": "भार्योवाच ।\nकिं तद् ब्रह्म किमध्यात्मं किं कर्म पुरुषोत्तम ।\nएतावदुक्ते तत्पत्न्या यदाश्चर्यमभूच्छृणु॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000839015, "chapter_id": 20839, "verse_number": "६-१८२-१६", "content_sanskrit": "अष्टमाध्यायश्लोकार्द्धश्रवणात्स तरुस्तदा ।\nविहाय तालीरूपं तद्बभूव द्विजसत्तमः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000839016, "chapter_id": 20839, "verse_number": "६-१८२-१७", "content_sanskrit": "सद्योज्ञानविधूतात्मा विमुक्तः पापकंचुकात् ।\nतन्माहात्म्याद्विनिर्मुक्तौ दंपती तौ बभूवतुः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000839017, "chapter_id": 20839, "verse_number": "६-१८२-१८", "content_sanskrit": "एतावदेव मुक्तं च दैवान्निर्गत्य तन्मुखात् ।\nततोंतरिक्षादायांतं क्वणत्किंकिणिकं शुभम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000839018, "chapter_id": 20839, "verse_number": "६-१८२-१९", "content_sanskrit": "दिवि दिव्यांगनावक्त्रचंद्रमंडलमंडितम् ।\nअप्सरोवदनांभोज भ्राम्यद्भ्रमरसंकुलम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000839019, "chapter_id": 20839, "verse_number": "६-१८२-२०", "content_sanskrit": "निर्मथ्यमानदुग्धाब्धि वेलाडिंडिरपांडुरैः ।\nगंगातरंगसुभगैश्चामरैरुपशोभितम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000839020, "chapter_id": 20839, "verse_number": "६-१८२-२१", "content_sanskrit": "गायद्गंधर्वसुभगं नृत्यत्सुरवधूशतम् ।\nदिव्यं विमानमारूढौ दंपती जग्मतुर्दिवम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000839021, "chapter_id": 20839, "verse_number": "६-१८२-२२", "content_sanskrit": "अत्रत्यं वृत्तमखिलमेतद्विस्मयकारकम् ।\nततो लिलेख मेधावी श्लोकार्द्धमिदमादरात्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000839022, "chapter_id": 20839, "verse_number": "६-१८२-२३", "content_sanskrit": "ययौ वाराणसीं नाम नगरीं मुक्तिदायिनीम् ।\nआराधयितुमन्विच्छन्देवदेवं जनार्दनम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000839023, "chapter_id": 20839, "verse_number": "६-१८२-२४", "content_sanskrit": "स तत्र कर्तुमारेभे तपः परमुदारधीः ।\nअत्रांतरे जगन्नाथो देवदेवो जनार्दनः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000839024, "chapter_id": 20839, "verse_number": "६-१८२-२५", "content_sanskrit": "पृष्टो दुग्धाब्धिसुतया संयोज्य करसंपुटम् ।\nनिद्रापथं विहायैव स्थीयते कथ्यतामिति॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000839025, "chapter_id": 20839, "verse_number": "६-१८२-२६", "content_sanskrit": "श्रीभगवानुवाच ।\nकाश्यां भागीरथी तीरे तपस्यतितरां द्विजः ।\nभावशर्माति मेधावी मद्भक्तिरसपूरितः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000839026, "chapter_id": 20839, "verse_number": "६-१८२-२७", "content_sanskrit": "जपन्गीताष्टमाध्यायश्लोकार्द्धं नियतेंद्रियः ।\nसंतुष्टवानहं देवि तदीयतपसा भृशम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000839027, "chapter_id": 20839, "verse_number": "६-१८२-२८", "content_sanskrit": "चिरं विचारयन्नेव तत्तपः सदृशं फलम् ।\nदातुमुत्कंठितमना वर्तेयं सांप्रतं प्रिये॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000839028, "chapter_id": 20839, "verse_number": "६-१८२-२९", "content_sanskrit": "पार्वत्युवाच ।\nहरिः प्रसन्नभूतोऽपि चिंतां प्राप यदि प्रभो ।\nभावशर्मा हरेर्भक्तः प्राप्तः किं तत्फलं पुनः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000839029, "chapter_id": 20839, "verse_number": "६-१८२-३०", "content_sanskrit": "श्रीमहादेव उवाच ।\nततः प्रसादमासाद्य प्रसन्नस्य मुरद्विषः ।\nसुखमात्यंतिकं प्राप भावशर्मा द्विजोत्तमः ।\nलेभिरे पदवीं सर्वे तदीया अपि वंशजाः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000839030, "chapter_id": 20839, "verse_number": "६-१८२-३१", "content_sanskrit": "तत्कर्मवशतो ये वै संप्राप्ता यातनां पुरा ।\nएतदेवाष्टमाध्यायमाहात्म्यं किंचिदेव ते॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000839031, "chapter_id": 20839, "verse_number": "६-१८२-३२", "content_sanskrit": "कथितं मृगशावाक्षि द्रष्टव्यं तु सदैव च॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]