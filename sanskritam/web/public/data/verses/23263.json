[{"id": 7003263000, "chapter_id": 23263, "verse_number": "१-६६-१", "content_sanskrit": "सूत उवाच  ।\nत्रिधन्वा देवदेवस्य प्रसादात्तंडिनस्तथा  ।\nअश्वमेधसहस्रस्य फलं प्राप्य प्रयत्नतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003263001, "chapter_id": 23263, "verse_number": "१-६६-२", "content_sanskrit": "गाणपत्यं दृढं प्राप्तः सर्वदेवनमस्कृतः  ।\nआसीत्त्रिधन्वनश्चापि विद्वांस्त्रय्यारुणो नृपः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003263002, "chapter_id": 23263, "verse_number": "१-६६-३", "content_sanskrit": "तस्य सत्यव्रतो नाम कुमारोऽभून्महाबलः  ।\nतेन भार्या विदर्भस्य हृता हत्वामितौजसम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003263003, "chapter_id": 23263, "verse_number": "१-६६-४", "content_sanskrit": "पाणिग्रहणमंत्रेषु निष्ठामप्रापितेष्विह  ।\nतेनाधर्मेण संयुक्तं राजा त्रय्यारुणोत्यजत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003263004, "chapter_id": 23263, "verse_number": "१-६६-५", "content_sanskrit": "पितरं सोब्रवीत्त्यक्तः क्व गच्छामीति वै द्विजाः  ।\nपिता त्वेनमथोवाच श्वपाकैः सह वर्तय ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003263005, "chapter_id": 23263, "verse_number": "१-६६-६", "content_sanskrit": "इत्युक्तः स विचक्राम नगराद्वचनात् पितुः  ।\nस तु सत्यव्रतो धीमाञ्छ्वपाकावसथान्तिके ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003263006, "chapter_id": 23263, "verse_number": "१-६६-७", "content_sanskrit": "पित्रा त्यक्तोऽवसद्वीरः पिता चास्य वनं ययौ  ।\nसर्वलोकेषु विख्यातस्त्रिशंकुरिति वीर्यवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003263007, "chapter_id": 23263, "verse_number": "१-६६-८", "content_sanskrit": "वसिष्ठकोपात्पुण्यात्मा राजा सत्यव्रतः पुरा  ।\nविश्वामित्रो महातेजा वरं दत्त्वा त्रिशंकवे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003263008, "chapter_id": 23263, "verse_number": "१-६६-९", "content_sanskrit": "राज्येऽभिषिच्य तं पित्र्ये याजयामास तं मुनिः  ।\nमिषतां देवतानां च वसिष्ठस्य च कौशिकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003263009, "chapter_id": 23263, "verse_number": "१-६६-१०", "content_sanskrit": "सशरीरं तदा तं वै दिवमारोपयद्विभुः  ।\nतस्य सत्य व्रता नाम भार्या कैकयवंशजा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003263010, "chapter_id": 23263, "verse_number": "१-६६-११", "content_sanskrit": "कुमारं जनयामास हरिश्चंद्रमकल्मषम्  ।\nहरिश्चंद्रस्य च सुतो रोहितो नाम वीर्यवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003263011, "chapter_id": 23263, "verse_number": "१-६६-१२", "content_sanskrit": "हरितो रोहितस्याथ धुंधुर्हारित उच्यते  ।\nविजयश्च सुतेजाश्च धुंधुपुत्रौ बभुवतुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003263012, "chapter_id": 23263, "verse_number": "१-६६-१३", "content_sanskrit": "जेता क्षत्त्रस्य सर्वत्र विजयस्तेन स स्मृतः  ।\nरुचकस्तस्य तनयो राजा परमाधार्मिकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003263013, "chapter_id": 23263, "verse_number": "१-६६-१४", "content_sanskrit": "रुचकस्य वृकः पुत्रस्तस्माद्बाहुश्च जज्ञिवान्  ।\nसगरस्तस्य पुत्रोभूद्राजा परमधार्मिकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003263014, "chapter_id": 23263, "verse_number": "१-६६-१५", "content_sanskrit": "द्वे भार्ये सगरस्यापि प्रभा भानुमती तथा  ।\nताभ्यामाराधितः पूर्वमौर्वोग्निः पुत्रकाम्यया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003263015, "chapter_id": 23263, "verse_number": "१-६६-१६", "content_sanskrit": "और्वस्तुष्टस्तयोः प्रादाद्यथेष्टं वरमुत्तमम्  ।\nएका षष्टिसहस्राणि सुतमेकं परा तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003263016, "chapter_id": 23263, "verse_number": "१-६६-१७", "content_sanskrit": "अगृह्णाद्वंशकर्तारं प्रभागृह्णात्सुतान्बहून्  ।\nएकं भानुमतिः पुत्रमगृह्णादसमंजसम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003263017, "chapter_id": 23263, "verse_number": "१-६६-१८", "content_sanskrit": "ततः षष्टिसहस्राणि सुषुवे सा तु वै प्रभा  ।\nखनंतः पृथिवीं दग्धा विष्णुहुंकारमार्गणैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003263018, "chapter_id": 23263, "verse_number": "१-६६-१९", "content_sanskrit": "असमंजस्य तनयः सोंशुमान्नाम विश्रुतः  ।\nतस्य पुत्रो दिलीपस्तु दिलीपात्तु भगीरथः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003263019, "chapter_id": 23263, "verse_number": "१-६६-२०", "content_sanskrit": "येन भागीरथी गंगा तपः कृत्वाऽवतारिता  ।\nभगीरथ सुतश्चापि श्रुतो नाम बभूव ह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003263020, "chapter_id": 23263, "verse_number": "१-६६-२१", "content_sanskrit": "नाभागस्तस्य दायादो भवभक्तः प्रतापवान्  ।\nअंबरीषः सुतस्तस्य सिंधुद्वीपस्ततोभवत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003263021, "chapter_id": 23263, "verse_number": "१-६६-२२", "content_sanskrit": "नाभागेनांबरीषेण भुजाभ्यां परिपालिता  ।\nबभूव वसुधात्यर्थं तापत्रयविवर्जिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003263022, "chapter_id": 23263, "verse_number": "१-६६-२३", "content_sanskrit": "अयुतायुः सुतस्तस्य सिन्धुद्वीपस्य वीर्यवान्  ।\nपुत्रोऽयुतायुषो धीमानृतुपर्णो महायशाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003263023, "chapter_id": 23263, "verse_number": "१-६६-२४", "content_sanskrit": "दिव्याक्षहृदयज्ञो वै राजा नलसखो बली  ।\nनलौ द्वावेव विख्यातौ पुराणेषु दृढव्रतौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003263024, "chapter_id": 23263, "verse_number": "१-६६-२५", "content_sanskrit": "वीरसेनसुतश्चान्यो यश्चेक्ष्वाकुकुलोद्भवः  ।\nऋतुपर्णस्य पुत्रोभूत्सार्वभौमः प्रजेश्वरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003263025, "chapter_id": 23263, "verse_number": "१-६६-२६", "content_sanskrit": "सुदासस्तस्य तनयो राजा त्विन्द्रसमोभवत्  ।\nसुदासस्य सुतः प्रोक्तः सौदासो नाम पार्थिवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003263026, "chapter_id": 23263, "verse_number": "१-६६-२७", "content_sanskrit": "ख्यातः कल्माषपादो वै नाम्ना मित्रसहश्च सः  ।\nवसिष्ठस्तु महा तेजाः क्षेत्रे कल्माषपादके ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003263027, "chapter_id": 23263, "verse_number": "१-६६-२८", "content_sanskrit": "अश्मकं जनयामास इक्ष्वाकुकुलवर्धनम्  ।\nअश्मकस्योत्तरायां तु मूलकस्तु सुतोभवत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003263028, "chapter_id": 23263, "verse_number": "१-६६-२९", "content_sanskrit": "स हि रामभयाद्राजा स्त्रीभिः परिवृतो वने  ।\nबिभर्ति त्राणमिच्छन्वै नारीकवचमुत्तमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003263029, "chapter_id": 23263, "verse_number": "१-६६-३०", "content_sanskrit": "मूलकस्यापि धर्मात्मा राजा शतरथः सुतः  ।\nतस्माच्छतरथाज्जज्ञे राजा त्विलविलो बली ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003263030, "chapter_id": 23263, "verse_number": "१-६६-३१", "content_sanskrit": "आसीत्त्वैलविलिः श्रीमान्वृद्धशर्मा प्रतापवान्  ।\nपुत्रो विश्वसहस्तस्य पितृकन्या व्यजीजनत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003263031, "chapter_id": 23263, "verse_number": "१-६६-३२", "content_sanskrit": "दिलीपस्तस्य पुत्रोभूत्खट्वांग इति विश्रुतः  ।\nयेन स्वर्गादिहागत्य मुहूर्तं प्राप्य जीवितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003263032, "chapter_id": 23263, "verse_number": "१-६६-३३", "content_sanskrit": "त्रयोऽग्नयस्त्रयो लोका बुद्ध्या सत्येन वै जिताः  ।\nदीर्घबाहुः सुतस्तस्य रघुस्तस्मादजायत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003263033, "chapter_id": 23263, "verse_number": "१-६६-३४", "content_sanskrit": "अजः पुत्रो रघोश्चापि तस्माज्जज्ञे च वीर्यवान्  ।\nराजा दशरथस्तस्माच्छ्रीमानिक्ष्वाकुवंशकृत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003263034, "chapter_id": 23263, "verse_number": "१-६६-३५", "content_sanskrit": "रामो दशरथाद्वीरो धर्मज्ञो लोकविश्रुतः  ।\nभरतो लक्ष्मणश्चैव शत्रुघ्नस्च महाबलः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003263035, "chapter_id": 23263, "verse_number": "१-६६-३६", "content_sanskrit": "तेषां श्रेष्ठो महातेजा रामः परमवीर्यवान्  ।\nरावणं समरे हत्वा यज्ञैरिष्ट्वा च धर्मवित् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003263036, "chapter_id": 23263, "verse_number": "१-६६-३७", "content_sanskrit": "दशवर्षसहस्राणि रामो राज्यं चकार सः  ।\nरामस्य तनयो जज्ञे कुश इत्यभिविश्रुतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003263037, "chapter_id": 23263, "verse_number": "१-६६-३८", "content_sanskrit": "लवश्च सुमहाभागः सत्यवानभवत्सुधीः  ।\nअतिथिस्तु कुशाज्जज्ञे निषधस्तस्य चात्मजः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003263038, "chapter_id": 23263, "verse_number": "१-६६-३९", "content_sanskrit": "नलस्तु निषधाज्जातो नभस्तस्मादजायत  ।\nनभसः पुंडरीकाख्यः क्षेमधन्वा ततः स्मृतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003263039, "chapter_id": 23263, "verse_number": "१-६६-४०", "content_sanskrit": "तस्य पुत्रोभवद्वीरो देवानीकः प्रतापवान्  ।\nअहीनरः सुतस्तस्य सहस्राश्वस्ततः परः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003263040, "chapter_id": 23263, "verse_number": "१-६६-४१", "content_sanskrit": "शुभश्चंद्रावलोकश्च तारापीडस्ततोभवत्  ।\nतस्यात्मजश्चन्द्रगिरिर्भानुचन्द्रस्ततोभवत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003263041, "chapter_id": 23263, "verse_number": "१-६६-४२", "content_sanskrit": "श्रुतायुरभवत्तस्माद्बृहद्बल इति स्मृतः  ।\nभारते यो महातेजाः सौभद्रेण निपातितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003263042, "chapter_id": 23263, "verse_number": "१-६६-४३", "content_sanskrit": "एते इक्ष्वाकुदायादा राजानः प्रायशः स्मृताः  ।\nवंशे प्रधाना एतस्मिन्प्रादान्येन प्रकीर्तिताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003263043, "chapter_id": 23263, "verse_number": "१-६६-४४", "content_sanskrit": "सर्वे पाशुपते ज्ञानमधीत्य परमेश्वरम्  ।\nसमभ्यर्च्य यथाज्ञानमिष्ट्वा यज्ञैर्यथाविधि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003263044, "chapter_id": 23263, "verse_number": "१-६६-४५", "content_sanskrit": "दिवं गता महात्मानः केचिन्मुक्तात्मयोगिनः  ।\nनृगो ब्राह्मणशापेन कृकलासत्वमागतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003263045, "chapter_id": 23263, "verse_number": "१-६६-४६", "content_sanskrit": "धृष्टश्च धृष्टकेतुश्च यमबालश्च वीर्यवान्।\nरणधृष्टश्च ते पुत्रास्त्रयः परमधार्मिकाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003263046, "chapter_id": 23263, "verse_number": "१-६६-४७", "content_sanskrit": "आनर्तो नाम शर्यातेः सुकन्या नाम दारिका  ।\nआनर्तस्याभवत् पुत्रो रोचमानः प्रतापवान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003263047, "chapter_id": 23263, "verse_number": "१-६६-४८", "content_sanskrit": "रोचमानस्य रेवोभूद्रेवाद्रैवत एव च  ।\nककुद्मी चापरो ज्येष्ठपुत्रः पुत्रशतस्य तु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003263048, "chapter_id": 23263, "verse_number": "१-६६-४९", "content_sanskrit": "रेवती यस्य सा कन्या पत्नी रामस्य विश्रुता  ।\nनरिष्यन्तस्य पुत्रोभूज्जितात्मा तु महाबली ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003263049, "chapter_id": 23263, "verse_number": "१-६६-५०", "content_sanskrit": "नाभागादंबरीषस्तु विष्णुभक्तः प्रतापवान्  ।\nऋतस्तस्य सुतः श्रीमान्सर्वधर्मविदांवरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003263050, "chapter_id": 23263, "verse_number": "१-६६-५१", "content_sanskrit": "कृतस्तस्य सुधर्माभूत्पृषितो नाम विश्रुतः  ।\nकरूषस्य तु कारूषाः सर्वे प्रख्यातकीर्तयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003263051, "chapter_id": 23263, "verse_number": "१-६६-५२", "content_sanskrit": "पृषितो हिंसयित्वा गां गुरोः प्राप सुकल्मषम्  ।\nशापाच्छूद्रत्वमापन्नश्चयवनस्योति विश्रुतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003263052, "chapter_id": 23263, "verse_number": "१-६६-५३", "content_sanskrit": "दिष्टपुत्रास्तु नाभागस्तस्मादपि भलंदनः  ।\nभलंदनस्य विक्रांतो राजासीदजवाहनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003263053, "chapter_id": 23263, "verse_number": "१-६६-५४", "content_sanskrit": "एते समासतः प्रोक्ता मनुपुत्रा महाभुजाः  ।\nइक्ष्वाकोः पुत्रपौत्राद्य एलस्याथ वदामि वः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003263054, "chapter_id": 23263, "verse_number": "१-६६-५५", "content_sanskrit": "सूत उवाच  ।\nऐलः पुरूरवा नाम रुद्रभक्तः प्रतापवान्  ।\nचक्रे त्वकण्टकं राज्यं देशे पुण्यतमे द्विजाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003263055, "chapter_id": 23263, "verse_number": "१-६६-५६", "content_sanskrit": "उत्तरे यमुनातीरे प्रयागे मुनिसेविते  ।\nप्रतिष्ठानाधिपः श्रीमान्प्रतिष्ठाने प्रतिष्ठितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003263056, "chapter_id": 23263, "verse_number": "१-६६-५७", "content_sanskrit": "तस्य पुत्राः सप्त भवन्सर्वे वितततेजसः  ।\nगंधर्वलोकविदिता भवभक्ता महाबलाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003263057, "chapter_id": 23263, "verse_number": "१-६६-५८", "content_sanskrit": "आयुर्मायुरमायुश्च विश्वायुश्चैव वीर्यवान्  ।\nश्रुतायुश्च शतायुश्च दिव्याश्चैवोर्वशीसुताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003263058, "chapter_id": 23263, "verse_number": "१-६६-५९", "content_sanskrit": "आयुषस्तनया वीराः पंचैवासन्महौजसः  ।\nस्वर्भानुतनयायां ते प्रभायां जज्ञिरे नृपाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003263059, "chapter_id": 23263, "verse_number": "१-६६-६०", "content_sanskrit": "नहुषः प्रथमस्तेषां धर्मज्ञो लोकविश्रुतः  ।\nनहुषस्य तु दायादाः षडिन्द्रोपमतेजसः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003263060, "chapter_id": 23263, "verse_number": "१-६६-६१", "content_sanskrit": "उत्पन्नाः पितृकन्यायं विरजायां महौजसः  ।\nयतिर्ययातिः संयातिरायातिः पंचमोऽन्धकः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003263061, "chapter_id": 23263, "verse_number": "१-६६-६२", "content_sanskrit": "विजातिश्चेति षडिमे सर्वे प्रख्यातकीर्तयः  ।\nयतिर्ज्येष्ठश्च तेषां वै ययातिस्तु ततोऽवरः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003263062, "chapter_id": 23263, "verse_number": "१-६६-६३", "content_sanskrit": "ज्येष्ठस्तु यतिर्मोक्षार्थो ब्रह्मभूतोऽभवत्प्रभुः  ।\nतेषां ययातिः पंचानां महाबलपराक्रमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003263063, "chapter_id": 23263, "verse_number": "१-६६-६४", "content_sanskrit": "देवयानीमुशनसः सुतां भार्यामवाप सः  ।\nशर्मिष्ठामासुरीं चैव तनयां वृषपर्वणः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003263064, "chapter_id": 23263, "verse_number": "१-६६-६५", "content_sanskrit": "यदुं च तुर्वसुं चैव देवयानी व्यजायत  ।\nतावुभौ शुभकर्माणौ स्तुतौ विद्याविशारदौ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003263065, "chapter_id": 23263, "verse_number": "१-६६-६६", "content_sanskrit": "द्रुह्यं चानुं च पूरुं च शर्मिष्ठा वार्षपर्वणी  ।\nययातये रथं तस्मै ददौ शुक्रः प्रतापवान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003263066, "chapter_id": 23263, "verse_number": "१-६६-६७", "content_sanskrit": "तोषितस्तेन विप्रेन्द्रः प्रीतः परमभास्वरम्  ।\nसुसंगं कांचनं दिव्यमक्षये च महेषुधी ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003263067, "chapter_id": 23263, "verse_number": "१-६६-६८", "content_sanskrit": "युक्तं मनोजवैरश्वैयेंन कन्यां समुद्वहन्  ।\nस तेन रथमुख्येन षण्मासेनाजयन्महीम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003263068, "chapter_id": 23263, "verse_number": "१-६६-६९", "content_sanskrit": "ययातिर्युधि दुर्धर्षो देवदानवमानुषैः  ।\nभवभक्तस्तु पुण्यात्मा धर्म निष्ठः समंजसः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003263069, "chapter_id": 23263, "verse_number": "१-६६-७०", "content_sanskrit": "यज्ञयाजी जितक्रोधः सर्वभूतानुकंपनः  ।\nकौरवाणां च सर्वेषां स भवद्रथ उत्तमः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003263070, "chapter_id": 23263, "verse_number": "१-६६-७१", "content_sanskrit": "यावन्नरेन्द्रप्रवरः कौरवो जनमेजयः  ।\nपूरोर्वंशस्य राज्ञस्तु राज्ञः पारिक्षितस्य तु ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003263071, "chapter_id": 23263, "verse_number": "१-६६-७२", "content_sanskrit": "जगाम स रथो नाशं शापाद्गर्गस्य धीमतः  ।\nगर्गस्य हि सुतं बालं स राजा जनमेजयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003263072, "chapter_id": 23263, "verse_number": "१-६६-७३", "content_sanskrit": "अक्रूरं हिंसयामास ब्रह्महत्यामवाप सः  ।\nस लोहगंधी राजर्षिः परिधावन्नितस्ततः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003263073, "chapter_id": 23263, "verse_number": "१-६६-७४", "content_sanskrit": "पौरजानपदौस्त्यक्तो न लेभे शर्म कर्हिचित्  ।\nततः स दुःखसंतप्तो न लेभे संविदं क्वचित् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003263074, "chapter_id": 23263, "verse_number": "१-६६-७५", "content_sanskrit": "जगाम शौनकमृषिं शरण्यं व्यथितस्तदा  ।\nइन्द्रेतिर्नाम विख्यातो योऽसौ मुनिरुदारधीः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003263075, "chapter_id": 23263, "verse_number": "१-६६-७६", "content_sanskrit": "याजयामास चेंद्रेतिस्तं नृपं जनमेजयम्  ।\nअश्वमेधेन राजानं पावनार्थं द्विजोत्तमाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003263076, "chapter_id": 23263, "verse_number": "१-६६-७७", "content_sanskrit": "स लोहगंधान्निर्मुक्त एनसा च महायशाः  ।\nयज्ञस्यावभृथे मध्ये यातो दिव्यो रथः शुभः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003263077, "chapter_id": 23263, "verse_number": "१-६६-७८", "content_sanskrit": "तस्माद्वंशात्परिभ्रष्टो वसोश्चेदिपतेः पुनः  ।\nदत्तः शक्रेण तुष्टेन लेभे तस्माद्बृहद्रथः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003263078, "chapter_id": 23263, "verse_number": "१-६६-७९", "content_sanskrit": "ततो हत्वा जरासंधं भीमस्तं रथमुत्तमम्  ।\nप्रददौ वासुदेवाय प्रीत्या कौरवनंदनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003263079, "chapter_id": 23263, "verse_number": "१-६६-८०", "content_sanskrit": "सूत उवाच  ।\nअभ्यषिंचत्पुरुं पुत्रं ययातिर्नाहुषः प्रभुः  ।\nकृतोपकारस्तेनैव पुरुणा द्विजसत्तमाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003263080, "chapter_id": 23263, "verse_number": "१-६६-८१", "content_sanskrit": "अभिषेक्तुकामं च नृपं पुरुं पुत्रं कनीयसम्  ।\nब्राह्मणप्रमुखा वर्णा इदं वचनमब्रुवन् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003263081, "chapter_id": 23263, "verse_number": "१-६६-८२", "content_sanskrit": "कथं शुक्रस्य नप्तारं देवयान्याः सुतं प्रभो  ।\nज्येष्ठं यदुमतिक्रम्य कनीयान्राज्यमर्हति ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003263082, "chapter_id": 23263, "verse_number": "१-६६-८३", "content_sanskrit": "एते संबोधयामस्त्वां धर्मं च अनुपालय ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]