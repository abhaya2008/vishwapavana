[{"id": 2167229, "chapter_id": 4591, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167230, "chapter_id": 4591, "verse_number": "१", "content_sanskrit": "सैनापत्यं तु सम्प्राप्य कर्णो वैकर्तनस्तदा ।\nतथोक्तश्च स्वयं राज्ञा स्निग्धं भ्रातृसमं वचः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167231, "chapter_id": 4591, "verse_number": "२", "content_sanskrit": "योगमाज्ञापयामास आदित्याभ्युदयं प्रति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167232, "chapter_id": 4591, "verse_number": "३", "content_sanskrit": "(हितश्च प्रियकामश्च मम पुत्रस्य नित्यशः ।)\nकिमकार्षीन्महाप्राज्ञस्तन्ममाचक्ष्व सञ्जय\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167233, "chapter_id": 4591, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167234, "chapter_id": 4591, "verse_number": "४", "content_sanskrit": "कर्णस्य मतमाज्ञाय पुत्रस्ते भरतर्षभ ।\nयोगमाज्ञापयामास नान्दीतूर्यपुरस्सरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167235, "chapter_id": 4591, "verse_number": "५", "content_sanskrit": "महत्यपररात्रे च तव सैन्यस्य मारिष ।\nयोगो योग इति ह्याशु प्रादुरासीन्महास्वनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167236, "chapter_id": 4591, "verse_number": "६", "content_sanskrit": "कल्प्यतां नागमुख्यानां रथानां च वरूथिनाम् ।\nसन्नह्यतां पदातीनां वाजिनां च विशाम्पते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167237, "chapter_id": 4591, "verse_number": "७", "content_sanskrit": "क्रोशतां चापि योधानां त्वरितानां परस्परम् ।\nबभूव तुमुलःशब्दो दिवस्पृक् सुमहांस्ततः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167238, "chapter_id": 4591, "verse_number": "८", "content_sanskrit": "ततः श्वेतपताकेन बलाकावर्णवाजिना ।\nहेमपृष्ठेन धनुषा हस्तिकक्ष्येण केतुना\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167239, "chapter_id": 4591, "verse_number": "९", "content_sanskrit": "तूणीरशतपूर्णेन सगदेन वरूथिना ।\nशतघ्नीकिङ्किणीशक्तिशूलतोमरधारिणा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167240, "chapter_id": 4591, "verse_number": "१०", "content_sanskrit": "कार्मुकैरुपपन्नेन विमलादित्यवर्चसा ।\nरथेनाधिपताकेन सूतपुत्रो व्यदृश्यत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167241, "chapter_id": 4591, "verse_number": "११", "content_sanskrit": "ध्मापयित्वा रणे शङ्खं हेमजालविभूषितम् ।\nविधून्वानं महच्चापं हेमपृष्ठं दृढं नृप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167242, "chapter_id": 4591, "verse_number": "१२", "content_sanskrit": "दृष्ट्वा कर्णं महेष्वासं रथस्थं रथिनां वरम् ।\nभानुमन्तमिवोद्यन्तं तमो घ्नन्तं दुरासदम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167243, "chapter_id": 4591, "verse_number": "१३", "content_sanskrit": "न भीष्मव्यसनं केचिन्नापि द्रोणस्य मारिष ।\nनान्येषां पुरुषव्याघ्र मेनिरे तत्र कौरवाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167244, "chapter_id": 4591, "verse_number": "१४", "content_sanskrit": "ततस्तु त्वरयन् योधान् शङ्खशब्देन मारिष ।\nकर्णो निष्क्रामयामास कौरवाणां महद्बलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167245, "chapter_id": 4591, "verse_number": "१५", "content_sanskrit": "व्यूहं व्यूह्य महेष्वासो मकरं शत्रुतापनः ।\nप्रत्युद्ययौ तदा कर्णः पाण्डवान् विजिगीषया\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167246, "chapter_id": 4591, "verse_number": "१६", "content_sanskrit": "(मकरव्यूहमास्थाय दंसितो रविनन्दनः ।)\nमकरस्याथ तुण्डे तु कर्णो राजन् व्यवस्थितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167247, "chapter_id": 4591, "verse_number": "१७", "content_sanskrit": "नेत्रयोः शकुनिः शूर उलूकश्च महारथः ।\nद्रोणपुत्रस्तु शिरसि ग्रीवायां सर्वसोदराः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167248, "chapter_id": 4591, "verse_number": "१८", "content_sanskrit": "मध्ये दुर्योधनो राजा बलेन महता वृतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167249, "chapter_id": 4591, "verse_number": "१९", "content_sanskrit": "वामपादे तु राजेन्द्र कृतवर्मा व्यवस्थितः ।\nनारायणबलैर्गुप्तो गोपालैर्युद्धदुर्मदैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167250, "chapter_id": 4591, "verse_number": "२०", "content_sanskrit": "पादे तु दक्षिणे राजन् गौतमः सत्यविक्रमः ।\nत्रिगर्तैश्च महेष्वासैर्दाक्षिणात्यैश्च संवृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167251, "chapter_id": 4591, "verse_number": "२१", "content_sanskrit": "अनुपादे तु यो वामस्तत्र शल्यो व्यवस्थितः ।\nमहत्या सेनया सार्धं मद्रदेशसमुत्थया\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167252, "chapter_id": 4591, "verse_number": "२२", "content_sanskrit": "दक्षिणे तु महाराज सुषेणः सत्यसङ्गरः ।\nवृतो रथसहस्रैश्च दन्तिनां च शतैस्तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167253, "chapter_id": 4591, "verse_number": "२३", "content_sanskrit": "पुच्छे ह्यास्तां महावीर्यौ भ्रातरौ पार्थिवात्मजौ ।\nविचित्रश्चित्रसेनश्च महत्या सेनया वृतौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167254, "chapter_id": 4591, "verse_number": "२४", "content_sanskrit": "ततः प्रयाते राजेन्द्र कर्णे रथवरोत्तमे ।\nधनञ्जयमभिप्रेक्ष्य धर्मराजोऽब्रवीदिदम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167255, "chapter_id": 4591, "verse_number": "२५", "content_sanskrit": "पश्य पार्थ महासेनां धार्तराष्ट्रीं तु संयुगे ।\nकर्णेन निर्मितां वीर गुप्तां वीरैर्महारथैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167256, "chapter_id": 4591, "verse_number": "२६", "content_sanskrit": "हतवीरतमा ह्येषा धार्तराष्ट्री महाचमूः ।\nफल्गुशेषा महाबाहो तृणैस्तुल्यतमा मता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167257, "chapter_id": 4591, "verse_number": "२७", "content_sanskrit": "एको ह्यत्र महेष्वासः सूतपुत्रो व्यरोचत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167258, "chapter_id": 4591, "verse_number": "२८", "content_sanskrit": "सदेवासुरगन्धर्वैः सकिन्नरमहोरगैः ।\nचराचरैस्त्रिभिर्लोकैरजेयो यो महारथः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167259, "chapter_id": 4591, "verse_number": "२९", "content_sanskrit": "तं हत्वाऽद्य महाबाहो विजयस्तव फल्गुन ।\nउद्धृतश्च भवेच्छल्यो मम द्वादशवार्षिकः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167260, "chapter_id": 4591, "verse_number": "३०", "content_sanskrit": "एतज्ज्ञात्वा महाबाहो व्यूहं व्यूह यथेच्छसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167261, "chapter_id": 4591, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167262, "chapter_id": 4591, "verse_number": "३१", "content_sanskrit": "श्रुत्वा तद्वचनं भ्रातुः कौन्तेयः श्वेतवाहनः ।\nअर्धचन्द्रेण व्यूहेन प्रत्यव्यूहत तां चमूम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167263, "chapter_id": 4591, "verse_number": "३२", "content_sanskrit": "वामशृङ्गे तु राजेन्द्र भीमसेनो व्यवस्थितः ।\nदक्षिणे तु महाबाहुर्धृष्टद्युम्नो व्यवस्थितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167264, "chapter_id": 4591, "verse_number": "३३", "content_sanskrit": "मध्ये व्यूहस्य राजेन्द्र पाण्डवश्च धनञ्जयः ।\nनकुलः सहदेवश्च धर्मराजश्च पृष्ठतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167265, "chapter_id": 4591, "verse_number": "३४", "content_sanskrit": "चक्ररक्षौ तु पाञ्चाल्यौ युधामन्यूत्तमौजसौ ।\nपार्थं न जहतुर्युद्धे पाल्यमानौ किरीटिना\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167266, "chapter_id": 4591, "verse_number": "३५", "content_sanskrit": "शेषा नृपतयो वीराः स्थिता व्यूहस्य दंसिताः ।\nयथाभागं यथोत्साहं यथायत्नं च भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167267, "chapter_id": 4591, "verse_number": "३६", "content_sanskrit": "एवमेतन्महाव्यूहं व्यूह्य भारत पाण्डवाः ।\nतावकाश्च महेष्वासा युद्धायैवावतस्थिरे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167268, "chapter_id": 4591, "verse_number": "३७", "content_sanskrit": "दृष्ट्वा व्यूहं तव चमूं सूतपुत्रेण संयुगे ।\nनिहतान् पाण्डवान् मेने सकृष्णान् वै जनाधिपः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167269, "chapter_id": 4591, "verse_number": "३८", "content_sanskrit": "तथैव पाण्डवीं सेनां दृष्ट्वा व्यूढां युधिष्ठिरः ।\nधार्तराष्ट्रान् हतान् मेने सकर्णान् ससुयोधनान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167270, "chapter_id": 4591, "verse_number": "३९", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः ।\nपटहाश्चाभ्यहन्यन्त झर्झर्यश्च समन्ततः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167271, "chapter_id": 4591, "verse_number": "४०", "content_sanskrit": "सेनयोरुभयो राजन् डिण्डिमाश्च महास्वनाः ।\nसिंहनादश्च सञ्जज्ञे शूराणां जयगृद्धिनाम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167272, "chapter_id": 4591, "verse_number": "४१", "content_sanskrit": "हयहेषितशब्दाश्च वारणानां च बृंहिताः ।\nरथनेमिस्वनाश्चोग्राः सम्बभूवुर्जनाधिप\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167273, "chapter_id": 4591, "verse_number": "४२", "content_sanskrit": "न द्रोणव्यसनं केचिद् विजग्मुस्तत्र भारत ।\nदृष्ट्वा कर्णं महेष्वासं मुखे व्यूहस्य दंसितम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167274, "chapter_id": 4591, "verse_number": "४३", "content_sanskrit": "उभे सेने महाराज प्रहृष्टनरकुञ्जरे ।\nयोद्धुकामे स्थिते यत्ते हन्तुमन्योन्यमञ्जसा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167275, "chapter_id": 4591, "verse_number": "४४", "content_sanskrit": "विजये जातसंरम्भे दृष्ट्वाऽन्योन्यमवस्थिते ।\nअनीकमध्ये राजेन्द्र रेजतुः कर्णपाण्डवौ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167276, "chapter_id": 4591, "verse_number": "४५", "content_sanskrit": "नृत्यन्ताविव ते सेने प्रजग्मतुरभीतवत् ।\nतयोः पक्षप्रपक्षेभ्यो निर्ययुश्च युयुत्सवः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167277, "chapter_id": 4591, "verse_number": "४६", "content_sanskrit": "ततः प्रववृते युद्धं नरवारणवाजिनाम् ।\nरथिनां च महाराज त्वन्योन्यं निघ्नतां भृशम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167278, "chapter_id": 4591, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nएकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2167279, "chapter_id": 4591, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]