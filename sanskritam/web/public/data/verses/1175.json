[{"id": 2008973, "chapter_id": 1175, "verse_number": "१-१७६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008974, "chapter_id": 1175, "verse_number": "१-१७६-१", "content_sanskrit": "करिष्य इति भीमेन प्रतिज्ञातेऽथ भारत।\nआजग्मुस्ते ततः सर्वे भैक्षमादाय पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008975, "chapter_id": 1175, "verse_number": "१-१७६-२", "content_sanskrit": "भीमसेनं ततो दृष्ट्वा आपूर्णवदनं तथा।\nबुबोध धर्मराजस्तु हृषितं भीममच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008976, "chapter_id": 1175, "verse_number": "१-१७६-३", "content_sanskrit": "तोषस्य कारणं यत्तु मनसाऽचिन्तयद्गुरुः।\nस समीक्ष्य तदा राजन्योद्धुकामं युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008977, "chapter_id": 1175, "verse_number": "१-१७६-४", "content_sanskrit": "आकारेणैव तं ज्ञात्वा पाण्डुपुत्रो युधिष्ठिरः।\nरहः समुपविश्यैकस्ततः पप्रच्छ मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008978, "chapter_id": 1175, "verse_number": "१-१७६-५", "content_sanskrit": "किं चिकीर्षत्ययं कर्म भीमो भमपराक्रमः।\nभवत्यनुमते कच्चित्स्वयं वा कर्तुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008979, "chapter_id": 1175, "verse_number": "१-१७६-६x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008980, "chapter_id": 1175, "verse_number": "१-१७६-६", "content_sanskrit": "ममैव वचनादेष करिष्यति परन्तपः।\nब्राह्मणार्थे महत्कृत्यं मोक्षाय नगरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008981, "chapter_id": 1175, "verse_number": "१-१७६-७", "content_sanskrit": "बकाय कल्पितं पुत्र महान्तं बलिमुत्तमम्।\nभीमो भुनक्तु सुस्पष्टमप्येकाहं तपःसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008982, "chapter_id": 1175, "verse_number": "१-१७६-८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008983, "chapter_id": 1175, "verse_number": "१-१७६-८", "content_sanskrit": "किमिदं साहसं तीक्ष्णं भवत्या दुष्करं कृतम्।\nपरित्यागं हि पुत्रस्य न प्रशंसन्ति साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008984, "chapter_id": 1175, "verse_number": "१-१७६-९", "content_sanskrit": "कथं परसुतस्यार्थे स्वसुतं त्यक्तुमिच्छसि।\nलोकवेदविरुद्धं हि पुत्रत्यागात्कृतं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008985, "chapter_id": 1175, "verse_number": "१-१७६-१०", "content_sanskrit": "यस्य बाहू समाश्रित्य सुखं सर्वे शयामहे।\nराज्यं चापहृतं क्षुद्रैराजिहीर्षामहे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008986, "chapter_id": 1175, "verse_number": "१-१७६-११", "content_sanskrit": "यस्य दुर्योधनो वीर्यं चिन्तयन्नमितौजसः।\nन शेते रजनीः सर्वा दुःखाच्छकुनिना सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008987, "chapter_id": 1175, "verse_number": "१-१७६-१२", "content_sanskrit": "यस्य वीरस्य वीर्येण मुक्ता जतुगृहाद्वयम्।\nअन्येभ्यश्चैव पापेभ्यो निहतश्च पुरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008988, "chapter_id": 1175, "verse_number": "१-१७६-१३", "content_sanskrit": "यस्य वीर्यं समाश्रित्य वसुपूर्णां वसुन्धराम्।\nइमां मन्यामहे प्राप्तां निहत्य धृतराष्ट्रजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008989, "chapter_id": 1175, "verse_number": "१-१७६-१४", "content_sanskrit": "तस्य व्यवसितस्त्यागो बुद्धिमास्थाय कां त्वया।\nकच्चिन्नु दुःखैर्बुद्धिस्ते विलुप्ता गतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008990, "chapter_id": 1175, "verse_number": "१-१७६-१५x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008991, "chapter_id": 1175, "verse_number": "१-१७६-१५", "content_sanskrit": "युधिष्ठिर न संतापस्त्वया कार्यो वृकोदरे।\nन चायं बुद्धिदौर्बल्याद्व्यवसायः कृतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008992, "chapter_id": 1175, "verse_number": "१-१७६-१६", "content_sanskrit": "न च शोकेन बुद्धिः सा विलुप्ता गतचेकसः।\nइह विप्रस्य भवने वयं पुत्र सुखोषिताः।\nअज्ञाता धार्तराष्ट्राणां सत्कृता वीतमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008993, "chapter_id": 1175, "verse_number": "१-१७६-१७", "content_sanskrit": "तस्य प्रतिक्रिया पार्थ मयेयं प्रसमीक्षिता।\nएतावानेव पुरुषः कृतं यस्मिन्न नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008994, "chapter_id": 1175, "verse_number": "१-१७६-१८", "content_sanskrit": "यावच्च कुर्यादन्योऽस्य कुर्याद्बहुगुमं ततः।\nब्राह्मणार्थे महान्धर्मो जानामीत्थं वृकोदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008995, "chapter_id": 1175, "verse_number": "१-१७६-१९", "content_sanskrit": "दृष्ट्वा भीमस्य विक्रान्तं तदा जतुगृहे महत्।\nहिडिम्बस्य वधाच्चैवं विश्वासो मे वृकोदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008996, "chapter_id": 1175, "verse_number": "१-१७६-२०", "content_sanskrit": "बाह्वोर्बलं हि भीमस्य नागायुतसमं महत्।\nयेन यूयं गजप्रख्या निर्व्यूढा वारणावतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008997, "chapter_id": 1175, "verse_number": "१-१७६-२१", "content_sanskrit": "वृकोदरेण सदृशो बलेनान्यो न विद्यते।\nयो व्यतीयाद्युधि श्रेष्ठमपि वज्रधरं स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008998, "chapter_id": 1175, "verse_number": "१-१७६-२२", "content_sanskrit": "जातमात्रः पुरा चैव ममाङ्कात्पतितो गिरौ।\nशरीरगौरवादस्य शिला गात्रैर्विचूर्णिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008999, "chapter_id": 1175, "verse_number": "१-१७६-२३", "content_sanskrit": "तदहं प्रज्ञया ज्ञात्वा बलं भीमस्य पाण्डव।\nप्रतिकार्ये च विप्रस्य ततः कृतवती मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009000, "chapter_id": 1175, "verse_number": "१-१७६-२४", "content_sanskrit": "नेदं लोभान्न चाज्ञानान्न च मोहाद्विनिश्चितम्।\nबुद्धिपूर्वं तु धर्मस्य व्यवसायः कृतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009001, "chapter_id": 1175, "verse_number": "१-१७६-२५", "content_sanskrit": "अर्थौ द्वावपि निष्पन्नौ युधिष्ठिर भविष्यतः।\nप्रतीकारश्च वासस्य धर्मश्च चरितो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009002, "chapter_id": 1175, "verse_number": "१-१७६-२६", "content_sanskrit": "यो ब्राह्मणस्य साहाय्यं कुर्यादर्थेषु कर्हिचित्।\nक्षत्रियः स शुभाँल्लोकानाप्नुयादिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009003, "chapter_id": 1175, "verse_number": "१-१७६-२७", "content_sanskrit": "क्षत्रियस्यैव कुर्वाणः क्षत्रियो वधमोक्षणम्।\nविपुलां कीर्तिमाप्नोति लोकेऽस्मिंश्च परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009004, "chapter_id": 1175, "verse_number": "१-१७६-२८", "content_sanskrit": "वैश्यस्यार्थे च साहाय्यं कुर्वाणः क्षत्रियो भुवि।\nस सर्वेष्वपि लोकेषु प्रजा रञ्जयते ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009005, "chapter_id": 1175, "verse_number": "१-१७६-२९", "content_sanskrit": "शूद्रं तु मोचयेद्राजा शरणार्थिनमागतम्।\nप्राप्नोतीह कुले जन्म सद्द्रव्ये राजपूजिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009006, "chapter_id": 1175, "verse_number": "१-१७६-३०", "content_sanskrit": "एवं मां भगवान्व्यासः पुरा पौरवनन्दन।\nप्रोवाचासुकरप्रज्ञस्तस्मादेवं चिकीर्षितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009007, "chapter_id": 1175, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि बकवधपर्वणि षट्सप्तत्यधिकशततमोऽध्यायः॥ १७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]