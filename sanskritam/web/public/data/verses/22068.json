[{"id": 7002068000, "chapter_id": 22068, "verse_number": "११३-१", "content_sanskrit": "अग्निरुवाच ।\nनर्मदादिकमाहात्म्यं वक्ष्येहं नर्मदां परां ।\nसद्यः पुनाति गाङ्गेयं दर्शनाद्वारि नार्मदं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002068001, "chapter_id": 22068, "verse_number": "११३-२", "content_sanskrit": "विस्तराद्योजनशतं योजनद्वयमायता ।\nषष्टिस्तीर्थसहस्राणि षष्टिकोट्यस्तथापराः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002068002, "chapter_id": 22068, "verse_number": "११३-३", "content_sanskrit": "पर्वतस्य समन्तात्तु तिष्ठन्त्यमरकण्टके ।\nकावेरीसङ्गमं पुण्यं श्रीपर्वतमतः शृणु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002068003, "chapter_id": 22068, "verse_number": "११३-४", "content_sanskrit": "गौरी श्रीरूपिणी तेपे तपस्तामब्रवीद्धरिः ।\nअवाप्स्यसि त्वमध्यात्म्यं नाम्ना श्रीपर्वतस्तव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002068004, "chapter_id": 22068, "verse_number": "११३-५", "content_sanskrit": "समन्ताद्योजनशतं महापुण्यं भविष्यति ।\nअत्र दानन्तपो जप्यं श्राद्धं सर्वमथाक्षयं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002068005, "chapter_id": 22068, "verse_number": "११३-६", "content_sanskrit": "मरणं शिवलोकाय सर्वदं तीर्थमुत्तमं ।\nहरोऽत्र क्रीडते देव्या हिरण्यकशिपुस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]