[{"id": 5000636000, "chapter_id": 9636, "verse_number": "७-१०१-१", "content_sanskrit": "श्रुत्वा सेनापतिं प्राप्तं भरतं केकयाधिपः ।\nयुधाजिद्गार्ग्यसहितं परां प्रीतिमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000636001, "chapter_id": 9636, "verse_number": "७-१०१-२", "content_sanskrit": "स निर्ययौ जनौघेन महता केकयाधिपः ।\nत्वरमाणो ऽभिचक्राम गन्धर्वान्कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000636002, "chapter_id": 9636, "verse_number": "७-१०१-३", "content_sanskrit": "भरतश्च युधाजिच्च समेतौ लघुविक्रमैः ।\nगन्धर्वनगरं प्राप्तौ सबलौ सपदानुगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000636003, "chapter_id": 9636, "verse_number": "७-१०१-४", "content_sanskrit": "श्रुत्वा तु भरतं प्राप्तं गन्धर्वास्ते समागताः ।\nयोद्धुकामा महावीर्या व्यनदन् वै समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000636004, "chapter_id": 9636, "verse_number": "७-१०१-५", "content_sanskrit": "ततः समभवद्युद्धं तुमुलं रोमहर्षणम् ।\nसप्तरात्रं महाभीमं न चान्यतरयोर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000636005, "chapter_id": 9636, "verse_number": "७-१०१-६", "content_sanskrit": "खड्गशक्तिधनुर्ग्राहा नद्यः शोणितसंस्रवाः ।\nनृकलेवरवाहिन्यः प्रवृत्ताः सर्वतोदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000636006, "chapter_id": 9636, "verse_number": "७-१०१-७", "content_sanskrit": "ततो रामानुजः क्रुद्धः कालस्यास्त्रं सुदारुणम् ।\nसंवर्तं नाम भरतो गन्धर्वेष्वभ्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000636007, "chapter_id": 9636, "verse_number": "७-१०१-८", "content_sanskrit": "ते बद्धाः कालपाशेन संवर्तेन विदारिताः ।\nक्षणेनाभिहतास्तेन तिस्रः कोट्यो महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000636008, "chapter_id": 9636, "verse_number": "७-१०१-९", "content_sanskrit": "तं घातं घोरसङ्काशं न स्मरन्ति दिवौकसः ।\nनिमेषान्तरमात्रेण तादृशानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000636009, "chapter_id": 9636, "verse_number": "७-१०१-१०", "content_sanskrit": "हतेषु तेषु सर्वेषु भरतः केकयीसुतः ।\nनिवेशयामास तदा समृद्धे द्वे पुरोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000636010, "chapter_id": 9636, "verse_number": "७-१०१-११", "content_sanskrit": "तक्षं तक्षशिलायां तु पुष्कलं पुष्कलावते । [http://puranastudy.freeoda.com/pur_index18/pushkal.htm तक्ष-पुष्कलोपरि टिप्पणी]\nगन्धर्वदेशे रुचिरे गान्धारविषये च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000636011, "chapter_id": 9636, "verse_number": "७-१०१-१२", "content_sanskrit": "धनरत्नौघसङ्कीर्णे काननैरुपशोभिते ।\nअन्योन्यसङ्घर्षकृते स्पर्धया गुणविस्तरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000636012, "chapter_id": 9636, "verse_number": "७-१०१-१३", "content_sanskrit": "उभे सुरुचिरप्रख्ये व्यवहारैरकिल्बिषैः ।\nउद्यानयानसम्पूर्णे सुविभक्तान्तरापणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000636013, "chapter_id": 9636, "verse_number": "७-१०१-१४", "content_sanskrit": "उभे पुरवरे रम्ये विस्तरैरुपशोभिते ।\nगृहमुख्यैः सुरुचिरैर्विमानसमवर्णिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000636014, "chapter_id": 9636, "verse_number": "७-१०१-१५", "content_sanskrit": "शोभिते शोभनीयैश्च देवायतनविस्तरैः ।\nतालैस्तमालैस्तिलकैर्वकुलैरुपशोभिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000636015, "chapter_id": 9636, "verse_number": "७-१०१-१६", "content_sanskrit": "निवेश्य पञ्चभिर्वर्षैर्भरतो राघवानुजः ।\nपुनरायान्महाबाहुरयोध्यां केकयीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000636016, "chapter_id": 9636, "verse_number": "७-१०१-१७", "content_sanskrit": "सो ऽभिवाद्य महात्मानं साक्षाद्धर्ममिवापरम् ।\nराघवं भरतः श्रीमान्ब्रह्माणमिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000636017, "chapter_id": 9636, "verse_number": "७-१०१-१८", "content_sanskrit": "शशंस च यथावृत्तं गन्धर्ववधमुत्तमम् ।\nनिवेशनं च देशस्य श्रुत्वा प्रीतो ऽस्य राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000636018, "chapter_id": 9636, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोत्तरशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]