[
  {
    "id": 20131641,
    "chapter_id": 7008,
    "verse_number": "26.1",
    "content_sanskrit": "षड्विंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20131642,
    "chapter_id": 7008,
    "verse_number": "26.2",
    "content_sanskrit": "अनुरूपा विरूपा च तथा रूपानुरूपिणी । त्रिप्रकारेह पात्राणां प्रकृतिश्च विभाविता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20131643,
    "chapter_id": 7008,
    "verse_number": "26.3",
    "content_sanskrit": "नानावस्थाक्रियोपेता भूमिका प्रकृतिस्तथा । भृशमुद्योतयेन्नाट्यं स्वभावकरणाश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20131644,
    "chapter_id": 7008,
    "verse_number": "26.4",
    "content_sanskrit": "बहुबाहूबहुमुखास्तथा च विकृताननाः । पशुश्वापदवक्त्राश्च खरोष्ट्राश्च गजाननाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20131645,
    "chapter_id": 7008,
    "verse_number": "26.5",
    "content_sanskrit": "एते चान्ये च बहवो नानारूपा भवन्ति ये । आचार्येण तु ते कार्या मृत्काष्ठजतुचर्मभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20131646,
    "chapter_id": 7008,
    "verse_number": "26.6",
    "content_sanskrit": "स्वाभाविकेन रूपेन प्रविशेद्रङ्गमण्डलम् । आत्मरूपमवच्छाद्य वर्णकैर्भूषणैरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20131647,
    "chapter_id": 7008,
    "verse_number": "26.7",
    "content_sanskrit": "यादृशं यस्य यद्रूपं प्रकृत्या तत्र तादृशम् । वयोवेषानुरूपेण प्रयोज्यं नाट्यकर्मणि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20131648,
    "chapter_id": 7008,
    "verse_number": "26.8",
    "content_sanskrit": "यथा जीवत्स्वभावं हि परित्यज्यान्यदेहिकम् । परभावं प्रकुरुते परभावं समाश्रितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20131649,
    "chapter_id": 7008,
    "verse_number": "26.9",
    "content_sanskrit": "एवं बुधः परंभावं सो ऽस्मीति मनसा स्मरन् । येषां वागङ्गलीलाभिश्चेष्टाभिस्तु समाचरेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20131650,
    "chapter_id": 7008,
    "verse_number": "26.10",
    "content_sanskrit": "सुकुमारप्रयोगो यो राज्ञामामोदसंभवः । शृङ्गाररसमासाद्य तन्नारीषु प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20131651,
    "chapter_id": 7008,
    "verse_number": "26.11",
    "content_sanskrit": "युद्धोद्धताविद्धकृता संरंभारभटाश्च ये । न ते स्त्रीभिः प्रयोक्तव्याः योक्तव्याः पुरुषेषु ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20131652,
    "chapter_id": 7008,
    "verse_number": "26.12",
    "content_sanskrit": "अनुद्भटमसंभ्रान्तमनाविद्धाङ्गचेष्टितम् । लयतालकलापातप्रमाणनियताक्षरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20131653,
    "chapter_id": 7008,
    "verse_number": "26.13",
    "content_sanskrit": "सुविभक्तपदालापमनिष्ठुरमकाहलम् । ईदृशं यद्भवेन्नाट्यं नारीभिश्च प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20131654,
    "chapter_id": 7008,
    "verse_number": "26.14",
    "content_sanskrit": "एवं कार्यं प्रयोगज्ञैर्भूमिकाविनिवेशनम् । स्त्रियो हि स्त्रीगतो भावः पौरुषः पुरुषस्यच ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20131655,
    "chapter_id": 7008,
    "verse_number": "26.15",
    "content_sanskrit": "यथा वयो यथावस्थमनुरूपेति सा स्मृता । पुरुषः स्त्रीकृतं भावं रूपात्प्रकुरुते तु यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20131656,
    "chapter_id": 7008,
    "verse_number": "26.16",
    "content_sanskrit": "रूपानुरूपा सा ज्ञेया प्रयोगे प्रकृतिर्बुधः । छन्दतः पौरुषीं भूमिं स्त्री कुर्यादनुरूपतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20131657,
    "chapter_id": 7008,
    "verse_number": "26.17",
    "content_sanskrit": "न परस्परचेष्टासु कार्यौ स्थविरबालिशौ । पाठ्यप्रयोगे पुरुषाः प्रयोक्तव्या हि संस्कृते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20131658,
    "chapter_id": 7008,
    "verse_number": "26.18",
    "content_sanskrit": "स्त्रीणां स्वभावमधुराः कण्ठाः पुंसां तु बलवन्तः । यद्यपि पुरुषो विद्यात् गीतविधानं च लक्षणोपेतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20131659,
    "chapter_id": 7008,
    "verse_number": "26.19",
    "content_sanskrit": "माधुर्यगुणविहीनं शोभां जनयेन्न तद्गीतम् । यत्र स्त्रीणां पाठ्याद्गुणैर्नराणां च कण्ठमाधुर्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20131660,
    "chapter_id": 7008,
    "verse_number": "26.20",
    "content_sanskrit": "प्रकृतिविपर्ययजनितौ विज्ञेयौ तावलङ्कारौ । प्रायेण देवपार्थिवसेनापतिमुख्यपुरुषभवनेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20131661,
    "chapter_id": 7008,
    "verse_number": "26.21",
    "content_sanskrit": "स्त्रीजनकृताः प्रयोगा भवन्ति पुरुषस्वभावेन । रम्भोर्वशीप्रभृतिषु स्वर्गे नाट्यं प्रतिष्ठितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20131662,
    "chapter_id": 7008,
    "verse_number": "26.22",
    "content_sanskrit": "तथैव मानुषे लोके राज्ञामन्तःपुरेष्विह । उपदेष्टव्यमाचार्यैः प्रयत्नेनाङ्गनाजने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20131663,
    "chapter_id": 7008,
    "verse_number": "26.23",
    "content_sanskrit": "न स्वयं भूमिकाभ्यासो बुधैः कार्यस्तु नाटके । स्त्रीषु योज्यः प्रयत्नेन प्रयोगः पुरुषाश्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20131664,
    "chapter_id": 7008,
    "verse_number": "26.24",
    "content_sanskrit": "यस्मात्स्वभावोपगतो विलासः स्त्रीषु विद्यते । तस्मात्स्वभावमधुरमङ्गं सुलभसौष्ठवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20131665,
    "chapter_id": 7008,
    "verse_number": "26.25",
    "content_sanskrit": "ललितं सौष्ठवं यच्च सो ऽलङ्कारः परो मतः । प्रयोगो द्विविधश्चैव विज्ञेयो नाटकाश्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20131666,
    "chapter_id": 7008,
    "verse_number": "26.26",
    "content_sanskrit": "सुकुमारस्तथाविद्धो नानाभावरसाश्रयः । नाटकं सप्रकरणं भाणो वीथ्यङ्क एव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20131667,
    "chapter_id": 7008,
    "verse_number": "26.27",
    "content_sanskrit": "ज्ञेयानि सुकुमाराणि मानुषैराश्रितानि तु । सुकुमारप्रयोगो ऽयं राज्ञामामोदकारकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20131668,
    "chapter_id": 7008,
    "verse_number": "26.28",
    "content_sanskrit": "शृङ्गारसमासाद्य स्त्रीणां तत्तु प्रयोजयेत् । युद्धोद्धताविद्धकृतासंरंभारभटाश्च ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20131669,
    "chapter_id": 7008,
    "verse_number": "26.29",
    "content_sanskrit": "न ते स्त्रीणां प्रकर्तव्याः कर्तव्याः पुरुषैर्हि ते । यथाविद्धाङ्गहारं तु भेद्यभेद्याहवात्मकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20131670,
    "chapter_id": 7008,
    "verse_number": "26.30",
    "content_sanskrit": "मायेन्द्रजालबहुलं पुस्तनैपथ्यदीपितम् । पुरुषप्रायसंचारमल्पस्त्रीकमथोद्धतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20131671,
    "chapter_id": 7008,
    "verse_number": "26.31",
    "content_sanskrit": "सात्वत्यारभटीयुक्तं नाट्यमाविद्धसंज्ञितम् । डिमः समवकारश्च व्यायोगेहामृगौ तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20131672,
    "chapter_id": 7008,
    "verse_number": "26.32",
    "content_sanskrit": "एतान्याविद्धसंज्ञानि विज्ञेयानि प्रयोक्तृभिः । एषां प्रयोगः कर्तव्यो देवदानवराक्षसैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20131673,
    "chapter_id": 7008,
    "verse_number": "26.33",
    "content_sanskrit": "उद्धता ये च पुरुषाः शौर्यवीर्यसमन्विताः । योग्यः स च प्रयत्नः कर्तव्यः सततप्रमादेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20131674,
    "chapter_id": 7008,
    "verse_number": "26.34",
    "content_sanskrit": "न हि योग्यया विना भवति च भावरससौष्ठवं किंचित् । संगीतपरिक्लेशो नित्यं प्रमदाजनस्य गुण एव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20131675,
    "chapter_id": 7008,
    "verse_number": "26.35",
    "content_sanskrit": "यन्मधुरकर्कशत्वं लभते नाट्यप्रयोगेण प्रमदाः नाट्यविलासैर्लभते यत् कुसुमैर्विचित्रलावण्यम् । कामोपचारकुशला भवन्ति च काम्या विशेषेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20131676,
    "chapter_id": 7008,
    "verse_number": "26.36",
    "content_sanskrit": "गीतं वृत्तं तथा वाद्यं प्रस्तारगमनक्रिया । शिष्यनिष्पादनं चैव षडाचार्यगुणाः स्मृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20131677,
    "chapter_id": 7008,
    "verse_number": "26.37",
    "content_sanskrit": "एतानि पञ्च यो वेत्ति स आचार्यः प्रकीर्तितः । ऊहापोहौ मतिश्चैव स्मृतिर्मेधा तथैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20131678,
    "chapter_id": 7008,
    "verse_number": "26.38",
    "content_sanskrit": "मेधास्मृतिर्गुणश्लाघारागः संघर्ष एव च । उत्साहश्च षडेवैतान् शिष्यस्यापि गुणान् विदुः ॥",
    "padaccheda": "",
