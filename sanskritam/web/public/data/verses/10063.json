[{"id": 6000063000, "chapter_id": 10063, "verse_number": null, "content_sanskrit": "अथ त्रयस्‍त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000063001, "chapter_id": 10063, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.001.m4a", "display_order": 2}, {"id": 6000063002, "chapter_id": 10063, "verse_number": "३-३३-१", "content_sanskrit": "अथ यो गृहमेधीयान् धर्मानेवावसन् गृहे।\nकाममर्थं च धर्मं च दोग्धि भूयः पिपर्ति तान्॥ ३/३३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.002.m4a", "display_order": 3, "topics": [{"text": "कपिलेन देवहूतिं प्रति काम्याकाम्यकर्मणोः फलकथनपूर्वकं भगवद्भजनचोदना", "range": "१–३१"}]}, {"id": 6000063003, "chapter_id": 10063, "verse_number": "३-३३-२", "content_sanskrit": "स चापि भगवद्धर्मात् काममूढः पराङ्मुखः।\nयजते क्रतुभिर्देवान् पितॄंश्च श्रद्धयाऽन्वितः॥ ३/३३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.003.m4a", "display_order": 4}, {"id": 6000063004, "chapter_id": 10063, "verse_number": "३-३३-३", "content_sanskrit": "तच्छ्रद्धयाऽऽक्रान्तमतिः पितृदेवव्रतः पुमान्।\nगत्वा चान्द्रमसं लोकं सोमपाः पुनरेष्यति॥ ३/३३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.004.m4a", "display_order": 5}, {"id": 6000063005, "chapter_id": 10063, "verse_number": "३-३३-४", "content_sanskrit": "यदा चाहीन्द्रशय्यायां शेतेऽनन्तासनो हरिः।\nतदा लोका लयं यान्ति त एते गृहमेधिनाम्॥ ३/३३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.005.m4a", "display_order": 6}, {"id": 6000063006, "chapter_id": 10063, "verse_number": "३-३३-५", "content_sanskrit": "ये च धर्मं न दुह्यन्ति धीराः कामार्थहेतवे।\nनिःसङ्गा न्यस्तकर्माणः प्रशान्ताः शुद्धचेतसः॥ ३/३३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.006.m4a", "display_order": 7}, {"id": 6000063007, "chapter_id": 10063, "verse_number": "३-३३-६", "content_sanskrit": "निवृत्तिधर्मनिरता निर्ममा निरहङ्कृताः।\nस्वधर्माख्येन सत्त्वेन परिशुद्धेन चेतसा॥ ३/३३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.007.m4a", "display_order": 8}, {"id": 6000063008, "chapter_id": 10063, "verse_number": "३-३३-७", "content_sanskrit": "सूर्यद्वारेण ते यान्ति पुरुषं विश्वतोमुखम्।\nपरावरेशं प्रकृतिमस्योत्पत्त्यन्तभावनम्॥ ३/३३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.008.m4a", "display_order": 9}, {"id": 6000063009, "chapter_id": 10063, "verse_number": "३-३३-८", "content_sanskrit": "द्विपरार्धावसाने यः प्रलयो ब्रह्मणस्तु ते।\nतावदध्यासते लोके परस्य परिचिन्तकाः॥ ३/३३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.009.m4a", "display_order": 10}, {"id": 6000063010, "chapter_id": 10063, "verse_number": "३-३३-९", "content_sanskrit": "क्ष्माम्भोनलानिलवियन्मनइन्द्रियार्थभूतादिभिः परिवृतः प्रतिसञ्जिहीर्षुः।\nअव्याकृतं विशति यर्हि गुणत्रयात्मा कालं परं स्वमनुभूय परः स्वयम्भूः॥ ३/३३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.010.m4a", "display_order": 11}, {"id": 6000063011, "chapter_id": 10063, "verse_number": "३-३३-१०", "content_sanskrit": "एवं परेत्य भगवन्तमनुप्रविष्टा ये योगिनो जितमरुन्मनसो विरागाः।\nतेनैव साकममृतं पुरुषं पुराणं ब्रह्म प्रधानमुपयान्त्यगताभिमानाः॥ ३/३३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.011.m4a", "display_order": 12}, {"id": 6000063012, "chapter_id": 10063, "verse_number": "३-३३-११", "content_sanskrit": "आद्यः स्थिरचराणां यो वेदगर्भः सहर्षिभिः।\nयोगेश्वरैः कुमाराद्यैः सिद्धैर्योगप्रवर्तकैः॥ ३/३३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.012.m4a", "display_order": 13}, {"id": 6000063013, "chapter_id": 10063, "verse_number": "३-३३-१२", "content_sanskrit": "भेददृष्ट्याऽऽभिमानेन निःसङ्गेनापि कर्मणा।\nकर्तृत्वात् सगुणं ब्रह्म पुरुषं पुरुषर्षभम्॥ ३/३३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.013.m4a", "display_order": 14}, {"id": 6000063014, "chapter_id": 10063, "verse_number": "३-३३-१३", "content_sanskrit": "स सङ्गत्य पुनः काले कालेनेश्वरमूर्तिना।\nजातेऽगुणव्यतिकरे यथापूर्वं प्रजायते॥ ३/३३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.014.m4a", "display_order": 15}, {"id": 6000063015, "chapter_id": 10063, "verse_number": "३-३३-१४", "content_sanskrit": "ऐश्वर्यं पारमेष्ठ्यं यत् तेऽपि धर्मविनिर्मितम्।\nनिषेव्य पुनरायान्ति गुणव्यतिकरेऽसति॥ ३/३३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.015.m4a", "display_order": 16}, {"id": 6000063016, "chapter_id": 10063, "verse_number": "३-३३-१५", "content_sanskrit": "अथ तं सर्वभूतानां हृत्पद्मेषु कृतालयम्।\nश्रुतानुभावं शरणं व्रज भावेन भामिनि॥ ३/३३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.016.m4a", "display_order": 17}, {"id": 6000063017, "chapter_id": 10063, "verse_number": "३-३३-१६", "content_sanskrit": "ये त्विहासक्तमनसः कर्मसु श्रद्धयाऽन्विताः।\nकुर्वन्त्यप्रतिषिद्धानि नित्यान्यपि च कृत्स्नशः॥ ३/३३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.017.m4a", "display_order": 18}, {"id": 6000063018, "chapter_id": 10063, "verse_number": "३-३३-१७", "content_sanskrit": "रजसा कुण्ठमनसः कामात्मानोऽजितेन्द्रियाः।\nपितॄन् यजन्त्यनुदिनं गृहेष्वभिरताशयाः॥ ३/३३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.018.m4a", "display_order": 19}, {"id": 6000063019, "chapter_id": 10063, "verse_number": "३-३३-१८", "content_sanskrit": "त्रैवर्गिकास्ते पुरुषा विमुखा हरिमेधसः।\nकथायां कथनीयोरुविक्रमस्य मधुद्विषः॥ ३/३३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.019.m4a", "display_order": 20}, {"id": 6000063020, "chapter_id": 10063, "verse_number": "३-३३-१९", "content_sanskrit": "नूनं दैवेन विहता ये त्वच्युतकथासुधाम्।\nहित्वा शृृण्वन्त्यसद्गाथाः पुरीषमिव विड्भुजः॥ ३/३३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.020.m4a", "display_order": 21}, {"id": 6000063021, "chapter_id": 10063, "verse_number": "३-३३-२०", "content_sanskrit": "दक्षिणेन पथाऽर्यम्णः पितृलोकं व्रजन्ति ते।\nप्रजायां तु प्रजायन्ते श्मशानान्तक्रियाकृतः॥ ३/३३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.021.m4a", "display_order": 22}, {"id": 6000063022, "chapter_id": 10063, "verse_number": "३-३३-२१", "content_sanskrit": "ततस्ते क्षीणसुकृताः पुनर्लोकमिमं सति।\nपतन्ति विवशा देवैः सद्यो विभ्रंशितोदयाः॥ ३/३३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.022.m4a", "display_order": 23}, {"id": 6000063023, "chapter_id": 10063, "verse_number": "३-३३-२२", "content_sanskrit": "तस्मात् त्वं सर्वभावेन भजस्व परमेष्ठिनम्।\nतद्गुणाश्रयया भक्त्या भजनीयपदाम्बुजम्॥ ३/३३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.023.m4a", "display_order": 24}, {"id": 6000063024, "chapter_id": 10063, "verse_number": "३-३३-२३", "content_sanskrit": "वासुदेवे भगवति भक्तियोगः प्रचोदितः।\nजनयत्याशु वैराग्यं ज्ञानं यद् ब्रह्मदर्शनम्॥ ३/३३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.024.m4a", "display_order": 25}, {"id": 6000063025, "chapter_id": 10063, "verse_number": "३-३३-२४", "content_sanskrit": "यदाऽस्य चित्तमर्थेषु समेष्विन्द्रियवृत्तिभिः।\nन विगृह्णाति वैषम्यं प्रियमप्रियमप्युत॥ ३/३३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.025.m4a", "display_order": 26}, {"id": 6000063026, "chapter_id": 10063, "verse_number": "३-३३-२५", "content_sanskrit": "स तदैवात्मनाऽऽत्मानं निःसङ्गं समदर्शिनम्।\nहेयोपादेयरहितमारूढपदमीक्षते॥ ३/३३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.026.m4a", "display_order": 27}, {"id": 6000063027, "chapter_id": 10063, "verse_number": "३-३३-२६", "content_sanskrit": "ज्ञानमात्रं परं ब्रह्म परमात्मेश्वरः पुमान्।\nदृश्यादिभिः पृथग्भावैर्भगवानेक ईयते॥ ३/३३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.027.m4a", "display_order": 28}, {"id": 6000063028, "chapter_id": 10063, "verse_number": "३-३३-२७", "content_sanskrit": "एतावानेव योगेन समग्रेणेह योगिनः।\nयुज्यतेऽभिमतो ह्यर्थो यदसङ्गस्तु कृत्स्नशः॥ ३/३३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.028.m4a", "display_order": 29}, {"id": 6000063029, "chapter_id": 10063, "verse_number": "३-३३-२८", "content_sanskrit": "ज्ञानमेकं पराचीनैरिन्द्रियैर्ब्रह्म निर्गुणम्।\nअवभात्यर्थरूपेण भ्रान्त्या शब्दादिधर्मिणाम्॥ ३/३३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.029.m4a", "display_order": 30}, {"id": 6000063030, "chapter_id": 10063, "verse_number": "३-३३-२९", "content_sanskrit": "यथा महानहङ्कारस्‍त्रिवृत् पञ्चविधः स्वराट्।\nएकादशविधस्तस्य वपुरण्डं जगद् यतः॥ ३/३३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.030.m4a", "display_order": 31}, {"id": 6000063031, "chapter_id": 10063, "verse_number": "३-३३-३०", "content_sanskrit": "एतद् वै श्रद्धया भक्त्या योगाभ्यासेन नित्यशः।\nसमाहितात्मा निःसङ्गो विरक्तः परिपश्यति॥ ३/३३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.031.m4a", "display_order": 32}, {"id": 6000063032, "chapter_id": 10063, "verse_number": "३-३३-३१", "content_sanskrit": "इत्येतत् कथितं गुर्वि ज्ञानं तद् ब्रह्मदर्शनम्।\nयेनैव बुध्यते तत्त्वं प्रकृतेः पुरुषस्य च॥ ३/३३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.032.m4a", "display_order": 33}, {"id": 6000063033, "chapter_id": 10063, "verse_number": "३-३३-३२", "content_sanskrit": "ज्ञानं योगश्च मन्निष्ठो नैर्गुण्यो भक्तिलक्षणः।\nद्वयोरप्येक एवार्थो भगवच्छब्दलक्षणः॥ ३/३३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.033.m4a", "display_order": 34, "topics": [{"text": "तथा ज्ञानभक्तिवैराग्यादीनां भगवत्प्राप्त्युपायत्वोक्तिः", "range": "३२–३८"}]}, {"id": 6000063034, "chapter_id": 10063, "verse_number": "३-३३-३३", "content_sanskrit": "यथेन्द्रियैः पृथक्चारैरर्थो बहुगुणाश्रयः।\nएको नानेयते तद्वद् भगवाञ्छास्‍त्रवर्त्मभिः॥ ३/३३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.034.m4a", "display_order": 35}, {"id": 6000063035, "chapter_id": 10063, "verse_number": "३-३३-३४", "content_sanskrit": "क्रियया क्रतुभिर्दानैस्तपःस्वाध्यायदर्शनैः।\nआत्मेन्द्रियजयेनापि संन्यासेन च कर्मणाम्॥ ३/३३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.035.m4a", "display_order": 36}, {"id": 6000063036, "chapter_id": 10063, "verse_number": "३-३३-३५", "content_sanskrit": "योगेन विविधांशेन भक्तियोगेन चैव हि।\nधर्मेणोभयचिह्नेन यः प्रवृत्तिनिवृत्तिमान्॥ ३/३३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.036.m4a", "display_order": 37}, {"id": 6000063037, "chapter_id": 10063, "verse_number": "३-३३-३६", "content_sanskrit": "आत्मतत्त्वावबोधेन वैराग्येण दृढेन च।\nईयते भगवानेभिः सगुणो निर्गुणः स्वदृक्॥ ३/३३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.037.m4a", "display_order": 38}, {"id": 6000063038, "chapter_id": 10063, "verse_number": "३-३३-३७", "content_sanskrit": "प्रावोचं भक्तियोगस्य स्वरूपं ते चतुर्विधम्।\nकालस्य चाव्यक्तगतेर्योऽन्तर्धावति जन्तुषु॥ ३/३३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.038.m4a", "display_order": 39}, {"id": 6000063039, "chapter_id": 10063, "verse_number": "३-३३-३८", "content_sanskrit": "जीवस्य संसृतीर्बह्वीरविद्याकर्मनिर्मिताः।\nयाः स्वयं प्रविशन्नात्मा न वेद गतिमात्मनः॥ ३/३३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.039.m4a", "display_order": 40}, {"id": 6000063040, "chapter_id": 10063, "verse_number": "३-३३-३९", "content_sanskrit": "नैतत् खलायोपदिशेन्नाविनीताय कर्हिचित्।\nन स्तब्धाय न भिन्नाय नैव धर्मध्वजाय च॥ ३/३३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.040.m4a", "display_order": 41, "topics": [{"text": "तत्त्वोपदेशयोग्यायोग्यलक्षणप्रतिपादनम्", "range": "३९–४३"}]}, {"id": 6000063041, "chapter_id": 10063, "verse_number": "३-३३-४०", "content_sanskrit": "न लोलुपायोपदिशेन्न गृहारूढचेतसे।\nनाभक्ताय च मे जातु न मद्भक्तद्विषामपि॥ ३/३३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.041.m4a", "display_order": 42}, {"id": 6000063042, "chapter_id": 10063, "verse_number": "३-३३-४१", "content_sanskrit": "श्रद्दधानाय भक्ताय विनीतायानसूयवे।\nभूतेषु कृतमैत्राय शुश्रूषाभिरताय च॥ ३/३३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.042.m4a", "display_order": 43}, {"id": 6000063043, "chapter_id": 10063, "verse_number": "३-३३-४२", "content_sanskrit": "बहिर्जातविरागाय शान्तचित्ताय दीयते।\nनिर्मत्सराय शुचये यस्याहं प्रेयसां प्रियः॥ ३/३३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.043.m4a", "display_order": 44}, {"id": 6000063044, "chapter_id": 10063, "verse_number": "३-३३-४३", "content_sanskrit": "य इदं शृणुयादम्ब श्रद्धया पुरुषः सुकृत्।\nयो वाऽभिधत्ते मच्चित्तः स ह्येति पदवीं च मे॥ ३/३३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_033/BhP_03.033.044.m4a", "display_order": 45}, {"id": 6000063045, "chapter_id": 10063, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे त्रयस्‍त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]