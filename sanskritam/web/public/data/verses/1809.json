[{"id": 2037482, "chapter_id": 1809, "verse_number": "५-५४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037483, "chapter_id": 1809, "verse_number": "५-५४-१", "content_sanskrit": "एवमेतन्महाराज यथावदसि भारत।\nयुद्धे विनाशः क्षत्रस्य गाण्डीवेन प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037484, "chapter_id": 1809, "verse_number": "५-५४-२", "content_sanskrit": "इदं तु नाभिजानामि तव धीरस्य नित्यशः।\nयत्पुत्रवशमागच्छेस्तत्त्वज्ञः सव्यसाचिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037485, "chapter_id": 1809, "verse_number": "५-५४-३", "content_sanskrit": "नैष कालो महाराज तव शश्वत्कृतागसः।\nत्वया ह्येवादितः पार्था निकृता भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037486, "chapter_id": 1809, "verse_number": "५-५४-४", "content_sanskrit": "पिता श्रेष्ठः सुहृद्यश्च सम्यक्प्रणिहितात्मवान्।\nआस्थेयं हि हितं तेन न द्रोग्धा गुरुरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037487, "chapter_id": 1809, "verse_number": "५-५४-५", "content_sanskrit": "इदं जितमिदं लब्धमिति श्रुत्वा पराजितान्।\nद्यूतकाले महाराज स्मरसे स्म कुमारवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037488, "chapter_id": 1809, "verse_number": "५-५४-६", "content_sanskrit": "परुषाण्युच्यमानांश्च पुरा पार्थानुपेक्षसे।\nकृत्स्नं राज्यं जयन्तीति प्रपातं नानुपश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037489, "chapter_id": 1809, "verse_number": "५-५४-७", "content_sanskrit": "पित्र्यं राज्यं महाराज कुरवस्ते सजाङ्गलाः।\nअथ वीरैर्जितामुर्वीमखिलां प्रत्यपद्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037490, "chapter_id": 1809, "verse_number": "५-५४-८", "content_sanskrit": "बाहुवीर्यार्जिता भूमिस्तव पार्थैर्निवेदिता।\nमयेदं कृतमित्येव मन्यसे राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037491, "chapter_id": 1809, "verse_number": "५-५४-९", "content_sanskrit": "ग्रस्तान्गन्धर्वराजेन मज्जतो ह्यप्लवेऽम्भसि।\nआनिनाय पुनः पार्थः पुत्रांस्ते राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037492, "chapter_id": 1809, "verse_number": "५-५४-१०", "content_sanskrit": "कुमारवच्च स्मयसे द्यूते विनिकृतेषु यत्।\nपाण्डवेषु वने राजन्प्रव्रजत्सु पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037493, "chapter_id": 1809, "verse_number": "५-५४-११", "content_sanskrit": "प्रवर्षतः शरव्रातानर्जुनस्य शितान्बहून्।\nअप्यर्णवा विशुष्येयुः किं पुनर्मासयोनयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037494, "chapter_id": 1809, "verse_number": "५-५४-१२", "content_sanskrit": "अस्यतां फाल्गुनः श्रेष्ठो गाण्डीवं धनुषां वरम्।\nकेशवः सर्वभूतानामायुधानां सुदर्शनम् ।\nवानरो रोचमानश्च केतुः केतुमतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037495, "chapter_id": 1809, "verse_number": "५-५४-१३", "content_sanskrit": "एवमेतानि स रथो वहते सह यो रणे।\nक्षपयिष्यति नो राजन्कालचक्रमिवोद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037496, "chapter_id": 1809, "verse_number": "५-५४-१४", "content_sanskrit": "तस्याद्य वसुधा राजन्निखिला भरतर्षभ।\nयस्य भीमार्जिनौ योधौ स राजा राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037497, "chapter_id": 1809, "verse_number": "५-५४-१५", "content_sanskrit": "तथा भीमहतप्रायां मञ्जन्तीं तव वाहिनीम् ।\nदुर्योधनमुखा दृष्ट्वा क्षयं यास्यन्ति कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037498, "chapter_id": 1809, "verse_number": "५-५४-१६", "content_sanskrit": "न भीमार्जुनयोर्भीता लप्स्यन्ते विजयं विभो।\nतव पुत्रा महाराज राजानश्चानुसारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037499, "chapter_id": 1809, "verse_number": "५-५४-१७", "content_sanskrit": "मत्स्यास्त्वामद्य नार्चन्ति पञ्चालाश्च सकेकयाः।\nसाल्वेयाः शूरसेनाश्च सर्वे त्वामवजानते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037500, "chapter_id": 1809, "verse_number": "५-५४-१८", "content_sanskrit": "पार्थं ह्येते गताः सर्वे वीर्यज्ञास्तस्य धीमतः।\nभक्त्या ह्यस्य विरुध्यन्ते तव पुत्रैः सदैव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037501, "chapter_id": 1809, "verse_number": "५-५४-१९", "content_sanskrit": "अनर्हानेव तु वधे धर्मयुक्तान्विकर्मणा।\nयोऽक्लेशयत्पाण्डुपुत्रान्यो विद्वेष्ट्यधुनापि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037502, "chapter_id": 1809, "verse_number": "५-५४-२०", "content_sanskrit": "सर्वोपायैर्नियन्तव्यः सानुगः पापपुरुषः।\nतव पुत्रो महाराज नानुशोचितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037503, "chapter_id": 1809, "verse_number": "५-५४-२१", "content_sanskrit": "अपरोहं महाराज साक्षाच्चैनं ब्रवीम्यहम्।\nद्यूतकाले मया चोक्तं विदुरेण च धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037504, "chapter_id": 1809, "verse_number": "५-५४-२२", "content_sanskrit": "यदिदं ते विलपितं पाण्डवान्प्रति भारत।\nअनीशेनैव राजेन्द्र सर्वमेतन्निरर्थकम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037505, "chapter_id": 1809, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि चतुःपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]