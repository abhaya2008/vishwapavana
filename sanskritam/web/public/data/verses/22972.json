[{"id": 7002972000, "chapter_id": 22972, "verse_number": "२-१९-१", "content_sanskrit": "नारायण उवाच ।\nशिवं प्रणम्य शिरसा दानवेन्द्रः प्रतापवान् ।\nसमारुरोह यानं च स्वामात्यैः सह सत्वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002972001, "chapter_id": 22972, "verse_number": "२-१९-२", "content_sanskrit": "बभूवुस्ते च संक्षुब्धाः स्कन्दशक्त्याऽर्दितास्तदा ।\nनेदुर्दुन्दुभयः स्वर्गे पुष्पवृष्टिर्बभूव ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002972002, "chapter_id": 22972, "verse_number": "२-१९-३", "content_sanskrit": "स्कन्दस्योपरि तत्रैव समरे च भयङ्करे ।\nस्कन्दस्य समरं दृष्ट्वा महदद्भुतमुल्बणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002972003, "chapter_id": 22972, "verse_number": "२-१९-४", "content_sanskrit": "दानवानां क्षयकरं यथा प्राकृतिकं लयम् ।\nराजा विमानमारुह्य शरवर्षं चकार ह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002972004, "chapter_id": 22972, "verse_number": "२-१९-५", "content_sanskrit": "नृपस्य शरवृष्टिश्च घनवृष्टिर्यथा तथा ।\nमहान्घोरान्धकारश्च वह्न्युत्थानं बभूव ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002972005, "chapter_id": 22972, "verse_number": "२-१९-६", "content_sanskrit": "देवाः प्रदुद्रुवुश्चान्ये सर्वे नन्दीश्वरादयः ।\nएकाकी कार्त्तिकेयस्तु तस्थौ समरमूर्द्धनि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002972006, "chapter_id": 22972, "verse_number": "२-१९-७", "content_sanskrit": "पर्वतानां च सर्पाणां शिलानां शाखिनां तथा ।\nशश्वच्चकार वृष्टिं च दुर्वाह्यां च भयङ्करीम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002972007, "chapter_id": 22972, "verse_number": "२-१९-८", "content_sanskrit": "नृपस्य शरवृष्ट्या च प्रच्छन्नः शिवनन्दनः ।\nनीरदेन च सान्द्रेण संच्छन्नो भास्करो यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002972008, "chapter_id": 22972, "verse_number": "२-१९-९", "content_sanskrit": "धनुस्स्कन्दस्य चिच्छेद दुर्वहं च भयङ्करम् ।\nबभञ्ज च रथं दिव्यं चिच्छेद रथघोटकान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002972009, "chapter_id": 22972, "verse_number": "२-१९-१०", "content_sanskrit": "मयूरं जर्ज्जरीभूतं दिव्यास्त्रेण चकार सः ।\nशक्तिं चिक्षेप सूर्य्याभां तस्य वक्षोविभेदिनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002972010, "chapter_id": 22972, "verse_number": "२-१९-११", "content_sanskrit": "क्षणं मूर्छां च संप्राप्य चेतनामुपलभ्य सः ।\nगृहीत्वाऽन्यद्धनुर्दिव्यं यद्दत्तं विष्णुना पुरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002972011, "chapter_id": 22972, "verse_number": "२-१९-१२", "content_sanskrit": "रत्नेन्द्रसारखचितं यानमारुह्य चाग्निभूः ।\nशस्त्रमस्त्रं गृहीत्वा च चकार रणमुल्बणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002972012, "chapter_id": 22972, "verse_number": "२-१९-१३", "content_sanskrit": "सर्पांश्च पर्वतांश्चैव वृक्षांश्च प्रस्तरांस्तथा ।\nसर्वांश्चिच्छेद कोपेन दिव्यास्त्रेण शिवात्मजः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002972013, "chapter_id": 22972, "verse_number": "२-१९-१४", "content_sanskrit": "आग्नेयं वारुणास्त्रेण वारयामास वै गुहः ।\nरथं धनुश्च चिच्छेद शंखचूडस्य लीलया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002972014, "chapter_id": 22972, "verse_number": "२-१९-१५", "content_sanskrit": "सवाहं सारथिं चैव किरीटं मुकुटोज्ज्वलम् ।\nचिक्षेप शक्तिमुल्काभां दानवेन्द्रस्य वक्षसि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002972015, "chapter_id": 22972, "verse_number": "२-१९-१६", "content_sanskrit": "मूर्च्छां संप्राप्य राजोपलभ्य वै चेतनां पुनः ।\nआरुह्य वै यानमन्यं धनुर्जग्राह सत्वरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002972016, "chapter_id": 22972, "verse_number": "२-१९-१७", "content_sanskrit": "चकार शरजालं च मायया मायिनां वरः ।\nगुहं चाच्छाद्य समरे शरजालेन नारद ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002972017, "chapter_id": 22972, "verse_number": "२-१९-१८", "content_sanskrit": "जग्राह शक्तिमव्यर्थां शतसूर्य्यसमप्रभाम् ।\nप्रलयाग्निशिखारूपां विष्णोर्वै तेजसा वृताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002972018, "chapter_id": 22972, "verse_number": "२-१९-१९", "content_sanskrit": "चिक्षेप तां च कोपेन महावेगेन कार्त्तिके ।\nपपात शक्तिस्तद्गात्रे वह्निराशिरिवोज्ज्वला ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002972019, "chapter_id": 22972, "verse_number": "२-१९-२०", "content_sanskrit": "मूर्च्छां संप्राप शक्त्या च कार्त्तिकेयो महाबलः ।\nकाली गृहीत्वा तं क्रोडे निनाय शिवसन्निधौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002972020, "chapter_id": 22972, "verse_number": "२-१९-२१", "content_sanskrit": "शिवस्तं दर्शनादेव जीवयामास लीलया ।\nददौ बलमनन्तं च स चोत्तस्थौ प्रतापवान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002972021, "chapter_id": 22972, "verse_number": "२-१९-२२", "content_sanskrit": "शिवः स्वसैन्यं देवांश्च प्रेरयामास सत्वरः ।\nदानवेन्द्रैः ससैन्यैश्च युद्धारम्भो बभूव ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002972022, "chapter_id": 22972, "verse_number": "२-१९-२३", "content_sanskrit": "स्वयं महेन्द्रो युयुधे सार्द्धं च वृषपर्वणा ।\nभास्करो युयुधे विप्रचित्तिना सह सत्वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002972023, "chapter_id": 22972, "verse_number": "२-१९-२४", "content_sanskrit": "दम्भेन सह चन्द्रश्च चकार समरं परम् ।\nकालेश्वरेण कालश्च गोकर्णेन हुताशनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002972024, "chapter_id": 22972, "verse_number": "२-१९-२५", "content_sanskrit": "कुबेरः कालकेयेन विश्वकर्मा मयेन च ।\nभयङ्करेण मृत्युश्च संहारेण यमस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002972025, "chapter_id": 22972, "verse_number": "२-१९-२६", "content_sanskrit": "कलविङ्केन वरुणश्चञ्चलेन समीरणः ।\nबुधश्च धृतपुष्टेन रक्ताक्षेण शनैश्चरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002972026, "chapter_id": 22972, "verse_number": "२-१९-२७", "content_sanskrit": "जयन्तो रत्नसारेण वसवो वर्चसां गणैः ।\nअश्विनौ वै दीप्तिमता धूम्रेण नलकूबरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002972027, "chapter_id": 22972, "verse_number": "२-१९-२८", "content_sanskrit": "धनुर्द्धरेण धर्मश्च मण्डूकाक्षेण मङ्गलः ।\nशोभाकरेणैवेशानः पिठरेण च मन्मथः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002972028, "chapter_id": 22972, "verse_number": "२-१९-२९", "content_sanskrit": "उल्कामुखेन धूम्रेण खङ्गेनापि ध्वजेन च ।\nकांचीमुखेन पिण्डेन धूम्रेण सह नन्दिना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002972029, "chapter_id": 22972, "verse_number": "२-१९-३०", "content_sanskrit": "विश्वेन च पलाशेन चादित्या युयुधुः परम् ।\nएकादश महारुद्राश्चैकादश भयङ्करैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002972030, "chapter_id": 22972, "verse_number": "२-१९-३१", "content_sanskrit": "महामारी च युयुधे चोग्रदण्डादिभिः सह ।\nनन्दीश्वरादयः सर्वे दानवानां गणैः सह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002972031, "chapter_id": 22972, "verse_number": "२-१९-३२", "content_sanskrit": "युयुधुश्च महद्युद्धे प्रलये च भयङ्करे ।\nवटमूले च शम्भुश्च तस्थौ काल्या सुतेन च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002972032, "chapter_id": 22972, "verse_number": "२-१९-३३", "content_sanskrit": "सर्वे च युयुधुः सैन्यसमूहाः सततं मुने ।\nरत्नसिंहासने रम्ये कोटिभिर्दानवैः सह ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002972033, "chapter_id": 22972, "verse_number": "२-१९-३४", "content_sanskrit": "उवास शंखचूडश्च रत्नभूषणभूषितः ।\nशङ्करस्य च योधाश्च युद्धे सर्वे पराजिताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002972034, "chapter_id": 22972, "verse_number": "२-१९-३५", "content_sanskrit": "देवाश्च दुद्रुवुः सर्वे भीताश्च क्षतविक्षताः ।\nचकार कोपं स्कन्दश्च देवेभ्यश्चाभयं ददौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002972035, "chapter_id": 22972, "verse_number": "२-१९-३६", "content_sanskrit": "बलं च स्वगणानां वै वर्द्धयामास तेजसा ।\nस्वयमेकश्च युयुधे दानवानां गणैः सह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002972036, "chapter_id": 22972, "verse_number": "२-१९-३७", "content_sanskrit": "अक्षौहिणीनां शतकं समरे स जघान ह ।\nखर्परं पातयामास काली कमललोचना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002972037, "chapter_id": 22972, "verse_number": "२-१९-३८", "content_sanskrit": "पपौ रक्तं दानवानां क्रुद्धा सा शतखर्परम् ।\nदशलक्षं गजेन्द्राणां शतलक्षं च वाजिनाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002972038, "chapter_id": 22972, "verse_number": "२-१९-३९", "content_sanskrit": "समादायैकहस्तेन मुखे चिक्षेप लीलया ।\nकबन्धानां सहस्रं च ननर्त्त समरे मुने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002972039, "chapter_id": 22972, "verse_number": "२-१९-४०", "content_sanskrit": "स्कन्दस्य शरजालेन दानवाः क्षतविक्षताः ।\nभीताश्च दुद्रुवुः सर्वे महाबलपराक्रमाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002972040, "chapter_id": 22972, "verse_number": "२-१९-४१", "content_sanskrit": "वृषपर्वा विप्रचित्तिर्दम्भश्चापि विकङ्कनः ।\nस्कन्देन सार्द्धं युयुधुस्ते च सर्वे क्रमेण च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002972041, "chapter_id": 22972, "verse_number": "२-१९-४२", "content_sanskrit": "काली जगाम समरमरक्षत्कार्त्तिकं शिवः ।\nवीरास्तामनुजग्मुश्च ते च नन्दीश्वरादयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002972042, "chapter_id": 22972, "verse_number": "२-१९-४३", "content_sanskrit": "सर्वे देवाश्च गन्धर्वा यक्षराक्षसकिन्नराः ।\nराज्यभाण्डाश्च बहुशः शतकोटिर्बलाहकाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002972043, "chapter_id": 22972, "verse_number": "२-१९-४४", "content_sanskrit": "सा च गत्वा च संग्रामं सिंहनादं चकार ह ।\nदेव्या वै सिंहनादेन प्रापुर्मूर्च्छां च दानवाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002972044, "chapter_id": 22972, "verse_number": "२-१९-४५", "content_sanskrit": "अट्टाट्टहासमशिवं चकार च पुनः पुनः ।\nहृष्टा पपौ च माध्वीकं ननर्त्त रणमूर्द्धनि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002972045, "chapter_id": 22972, "verse_number": "२-१९-४६", "content_sanskrit": "उग्रदंष्ट्रा चोग्रचण्डा कौट्टरी च पपौ मधु ।\nयोगिनीनां डाकिनीनां गणाः सुरगणादयः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002972046, "chapter_id": 22972, "verse_number": "२-१९-४७", "content_sanskrit": "दृष्ट्वा कालीं शङ्खचूडः शीघ्रमाजिं समाययौ ।\nदानवाश्च भयं प्रापू राजा तेभ्योऽभयं ददौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002972047, "chapter_id": 22972, "verse_number": "२-१९-४८", "content_sanskrit": "काली चिक्षेप चाग्नेयं प्रलयाग्निशिखोपमम् ।\nराजा निर्वापयामास वारुणेन स लीलया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002972048, "chapter_id": 22972, "verse_number": "२-१९-४९", "content_sanskrit": "चिक्षेप वारुणं सा च तत्तीव्रं महदद्भुतम् ।\nगान्धर्वेण च चिच्छेद दानवेन्द्रश्च लीलया ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002972049, "chapter_id": 22972, "verse_number": "२-१९-५०", "content_sanskrit": "माहेश्वरं प्रचिक्षेप काली वह्निशिखोपमम् ।\nराजा जघान तच्छीघ्रं वैष्णवेन च लीलया ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002972050, "chapter_id": 22972, "verse_number": "२-१९-५१", "content_sanskrit": "नारायणास्त्रं सा देवी चिक्षिपे मन्त्रपूर्वकम् ।\nराजा ननाम तं दृष्ट्वा चावरुह्य रथादहो ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002972051, "chapter_id": 22972, "verse_number": "२-१९-५२", "content_sanskrit": "ऊर्ध्वं जगाम तच्छस्त्रं प्रलयाग्निशिखोपमम् ।\nपपात शङ्खचूडश्च भक्त्या वै दण्डवद्भुवि ।\nब्रह्मास्त्रं सा च चिक्षेप यत्नतो मन्त्रपूर्वकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002972052, "chapter_id": 22972, "verse_number": "२-१९-५३", "content_sanskrit": "ब्रह्मास्त्रेण महाराज निर्वाणं च चकार ह ।\nचिक्षेपातीव दिव्यास्त्रं सा देवी मन्त्रपूर्वकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002972053, "chapter_id": 22972, "verse_number": "२-१९-५४", "content_sanskrit": "राजा दिव्यास्त्रजालेन निर्वाणं च चकार ह ।\nदेवी चिक्षेप शक्तिं च यत्नतो योजनायताम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002972054, "chapter_id": 22972, "verse_number": "२-१९-५५", "content_sanskrit": "राजा तीक्ष्णास्त्रजालेन शतखण्डं चकार ह ।\nजग्राह मन्त्रपूर्वं च देवी पाशुपतं रुषा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002972055, "chapter_id": 22972, "verse_number": "२-१९-५६", "content_sanskrit": "निक्षेप्तुं सा निषिद्धा च वाग्बभूवाशरीरिणी ।\nमृत्युः पाशुपते नास्ति नृपस्य च महात्मनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002972056, "chapter_id": 22972, "verse_number": "२-१९-५७", "content_sanskrit": "यावदस्त्येव कण्ठेऽस्य कवचं हि हरेरिति ।\nयावत्सतीत्वमस्तीह सत्याश्च नृपयोषितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002972057, "chapter_id": 22972, "verse_number": "२-१९-५८", "content_sanskrit": "तावदस्य जरा मृत्युर्नास्तीति ब्रह्मणो वरः ।\nइत्याकर्ण्य महाकाली न तच्चिक्षेप सा सती ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002972058, "chapter_id": 22972, "verse_number": "२-१९-५९", "content_sanskrit": "शतलक्षं दानवानामग्रहील्लीलया क्रुधा ।\nअत्तुं जगाम वेगेन शंखचूडं भयंकरी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002972059, "chapter_id": 22972, "verse_number": "२-१९-६०", "content_sanskrit": "दिव्यास्त्रेण सुतीक्ष्णेन वारयामास दानवः ।\nखङ्गं चिक्षेप सा देवी ग्रीष्मसूर्योपमं परम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002972060, "chapter_id": 22972, "verse_number": "२-१९-६१", "content_sanskrit": "दिव्यास्त्रैर्दानवेन्द्रोऽयं शतखण्डं चकार सः ।\nपुनरत्तुं महादेवी वेगेन च जगाम तम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002972061, "chapter_id": 22972, "verse_number": "२-१९-६२", "content_sanskrit": "सर्वसिद्धेश्वरः श्रीमान्ववृधे दानवेश्वरः ।\nनिवारयामास च तां सर्वसिद्धेश्वरो वरः ।\nवेगेन मुष्टिना काली कोपयुक्ता भयंकरी ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002972062, "chapter_id": 22972, "verse_number": "२-१९-६३", "content_sanskrit": "बभञ्जाथ रथं तस्य चाहनत्सारथिं सती ।\nसा च शूलं च चिक्षेप प्रलयाग्निशिखोपमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002972063, "chapter_id": 22972, "verse_number": "२-१९-६४", "content_sanskrit": "वामहस्तेन जग्राह शंखचूडश्च लीलया ।\nमुष्ट्या जघान तं देवी महाकोपेन वेगतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002972064, "chapter_id": 22972, "verse_number": "२-१९-६५", "content_sanskrit": "बभ्राम व्यथया दैत्यः क्षणं मूर्च्छामवाप ह ।\nक्षणेन चेतनां प्राप्य समुत्तस्थौ प्रतापवान् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002972065, "chapter_id": 22972, "verse_number": "२-१९-६६", "content_sanskrit": "न चक्रे बाहुयुद्धं स देव्या सह ननाम ताम् ।\nदेव्याश्चास्त्रं च चिच्छेद चाग्रहीत्स्वेन तेजसा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002972066, "chapter_id": 22972, "verse_number": "२-१९-६७", "content_sanskrit": "नास्त्रं चिक्षेप तां भक्त्या मातृबुद्ध्या च वैष्णवः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002972067, "chapter_id": 22972, "verse_number": "२-१९-६८", "content_sanskrit": "गृहीत्वा दानवं देवी भ्रामयित्वा पुनः पुनः ।\nऊर्ध्वं च प्रेरयामास महावेगेन कोपतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002972068, "chapter_id": 22972, "verse_number": "२-१९-६९", "content_sanskrit": "ऊर्ध्वात्पपात वेगेन शंखचूडः प्रतापवान् ।\nनिपत्य च समुत्तस्थौ स नत्वा भद्रकालिकाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002972069, "chapter_id": 22972, "verse_number": "२-१९-७०", "content_sanskrit": "रत्नेन्द्रसारखचितं विमानाग्र्यं मनोहरम् ।\nआरुरोह रथं हृष्टो न विश्रान्तो महारणे॥ ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002972070, "chapter_id": 22972, "verse_number": "२-१९-७१", "content_sanskrit": "क्षतजं दानवानां च मांसं च विपुलं क्षुधा ।\nपीत्वा भुक्त्वा भद्रकाली ययौ सा शंकरान्तिकम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002972071, "chapter_id": 22972, "verse_number": "२-१९-७२", "content_sanskrit": "उवाच रणवृत्तान्तं पौर्वापर्य्यं यथाक्रमम् ।\nश्रुत्वा जहास शम्भुश्च दानवानां विनाशनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002972072, "chapter_id": 22972, "verse_number": "२-१९-७३", "content_sanskrit": "लक्षं च दानवेन्द्राणामवशिष्टं रणेऽधुना ।\nउद्वृत्तं भूभृता सार्द्धं तदन्यं भुक्तमीश्वर ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002972073, "chapter_id": 22972, "verse_number": "२-१९-७४", "content_sanskrit": "संग्रामे दानवेन्द्रं च हन्तुं पाशुपतेन वै ।\nअवध्यस्तव राजेति वाग्बभूवाशरीरिणी॥ ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002972074, "chapter_id": 22972, "verse_number": "२-१९-७५", "content_sanskrit": "राजेन्द्रश्च महाज्ञानी महाबलपराक्रमः ।\nन च चिक्षेप मय्यस्त्रं चिच्छेद मम सायकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]