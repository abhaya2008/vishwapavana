[{"id": 7003172000, "chapter_id": 23172, "verse_number": "४-१०८-१", "content_sanskrit": "अथाष्टाधिकशततमोऽध्यायः ।\nनारायाण उवाच ।\nएतस्मिन्नन्तरे देवी महालक्ष्मीश्च रुक्मिणी ।\nआजगाम सभामध्ये मुनिदेवादिभिर्युते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003172001, "chapter_id": 23172, "verse_number": "४-१०८-२", "content_sanskrit": "रत्नसिंहासनस्था च रत्नालंकारभूषिता ।\nवह्निशुद्धाशुकाधाना कबरीभारभूषिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003172002, "chapter_id": 23172, "verse_number": "४-१०८-३", "content_sanskrit": "पश्यन्ती सस्मिता साध्वीह्यमूल्यरत्नदर्पणम् ।\nकस्तूरीबिन्दुभिर्युक्ता स्निग्धचन्दनचर्चिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003172003, "chapter_id": 23172, "verse_number": "४-१०८-४", "content_sanskrit": "सिधूरबिदुना शश्वद्भालमध्यस्थलोज्ज्वला ।\nतप्तकाञ्चनवर्णभा शतचन्द्रसमप्रभा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003172004, "chapter_id": 23172, "verse_number": "४-१०८-५", "content_sanskrit": "चन्दनोक्षितमर्वाङ्गा मालतीमाल्यशोभिता ।\nसप्तभिर्नृपपुत्रैश्चसमानीता च बालकैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003172005, "chapter_id": 23172, "verse_number": "४-१०८-६", "content_sanskrit": "देवेन्द्राश्च मुनीन्द्राश्च सिद्धेन्द्रा नृपपुंगवाः ।\nददृशू रुक्मिणीं देवीं महालक्ष्मीं पतिव्रताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003172006, "chapter_id": 23172, "verse_number": "४-१०८-७", "content_sanskrit": "सप्तप्रदक्षिणाःकृत्वा प्रणम्य स्वपतिंसती ।\nसिषेच शीततोयेन स्निग्धचन्दनपल्लवैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003172007, "chapter_id": 23172, "verse_number": "४-१०८-८", "content_sanskrit": "तां सिषेच जगत्कान्तः कान्ता शान्तां च सस्मिताम् ।\nददर्श कान्तः कान्तां च कान्तं कान्ता शुभे क्षणे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003172008, "chapter_id": 23172, "verse_number": "४-१०८-९", "content_sanskrit": "अथ देवी पितुः क्रोडे समुवास शुभानना ।\nलज्जया नम्रवदना ज्वलन्ती च स्वतेजसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003172009, "chapter_id": 23172, "verse_number": "४-१०८-१०", "content_sanskrit": "राजा देवेश्वरीं तस्मै परिबूर्णतमाय च ।\nप्रददौ संप्रदानेन वेदमन्त्रेण नारद ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003172010, "chapter_id": 23172, "verse_number": "४-१०८-११", "content_sanskrit": "वसुदेवाज्ञया कृष्णः स्वस्तीत्युक्त्वा स्थितो मुदा ।\nजग्राह देवीं देवश्च भवानीं च भवो यथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003172011, "chapter_id": 23172, "verse_number": "४-१०८-१२", "content_sanskrit": "सुवर्णानां पञ्चलक्षं कृष्णाय परमात्मने ।\nदक्षिणां तां ददौ राजा परिपूर्णतमाय च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003172012, "chapter_id": 23172, "verse_number": "४-१०८-१३", "content_sanskrit": "शुभकर्मणि निष्पन्ने कृत्वा कन्यां च वक्षसि ।\nरुरोद राजा मोहेन मुनिदेवेन्द्रसंसदि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003172013, "chapter_id": 23172, "verse_number": "४-१०८-१४", "content_sanskrit": "परिहारेण वचसा कुत्वा तस्मै समर्पणम् ।\nसिषेच कन्यां धन्यां च नेत्रयुग्मजलेन च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]