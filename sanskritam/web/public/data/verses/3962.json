[{"id": 2136618, "chapter_id": 3962, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136619, "chapter_id": 3962, "verse_number": "१", "content_sanskrit": "तावुभौ परितौ दृष्ट्वा भ्रातरौ रामलक्ष्मणौ ।\nबबन्ध रावणिर्भूयः शरैर्दत्तवरैस्तदा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136620, "chapter_id": 3962, "verse_number": "२", "content_sanskrit": "तौ वीरौ शरबन्धेन बद्धाविन्द्रजिता रणे ।\nरेजतुः पुरुषव्याघ्रौ शकुन्ताविव पञ्जरे\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136621, "chapter_id": 3962, "verse_number": "३", "content_sanskrit": "तौ दृष्ट्वा पतितौ भूमौ शतशः सायकैश्चितौ।\nसुग्रीवः कपिभिः सार्धं परिवार्य ततः स्थितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136622, "chapter_id": 3962, "verse_number": "४", "content_sanskrit": "सुषेणमैन्दद्विविदैः कुमुदेनाङ्गदेन च ।\nहनुमन्नीलतारैश्च नलेन च कपीश्वरः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136623, "chapter_id": 3962, "verse_number": "५", "content_sanskrit": "ततस्तं देशमागम्य कृतकर्मा विभीषणः ।\nबोधयामास तौ वीरौ प्रज्ञास्त्रेण प्रबोधितौ \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136624, "chapter_id": 3962, "verse_number": "६", "content_sanskrit": "विशल्यौ चापि सुग्रीवः क्षणेनैतौ चकार ह ।\nविशल्यया महौषध्या दिव्यमन्त्रप्रयुक्तया \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136625, "chapter_id": 3962, "verse_number": "७", "content_sanskrit": "तौ लब्धसञ्ज्ञौ नृवरौ विशल्यावुदतिष्ठताम् ।\nउभौगतक्लमौ चापि क्षणेनैतौ महारथौ \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136626, "chapter_id": 3962, "verse_number": "८", "content_sanskrit": "ततो विभीषणः पार्थ राममिक्ष्वाकुनन्दनम् ।\nउवाच विज्वरं दृष्ट्वा कृताञ्जलिरिदं वचः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136627, "chapter_id": 3962, "verse_number": "", "content_sanskrit": "विभीषणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136628, "chapter_id": 3962, "verse_number": "९", "content_sanskrit": "इदमम्भो गृहीत्वा तु राजराजस्य शासनात् ।\nगुह्यकोऽभ्यागतः श्वेतात्त्वत्सकाशमरिन्दम \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136629, "chapter_id": 3962, "verse_number": "१०", "content_sanskrit": "इदमम्भः कुबेरस्ते महाराजः प्रयच्छति ।\nअन्तर्हितानां भूतानां दर्शनार्थं परन्तपः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136630, "chapter_id": 3962, "verse_number": "११", "content_sanskrit": "अनेन मृष्टनयनो भूतान्यन्तर्हितान्युत ।\nभवान् द्रक्ष्यति यस्मै च प्रदास्यति नरः स तु \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136631, "chapter_id": 3962, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136632, "chapter_id": 3962, "verse_number": "१२", "content_sanskrit": "तथेति रामस्तद्वारि प्रतिगृह्याभिसंस्कृतम् ।\nचकार नेत्रयोः शौचं लक्ष्मणश्च महामनाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136633, "chapter_id": 3962, "verse_number": "१३", "content_sanskrit": "सुग्रीवजाम्बवन्तौ च हनुमानङ्गदस्तथा ।\nमैन्दद्विविदनीलाश्च प्रायः प्लवगसत्तमाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136634, "chapter_id": 3962, "verse_number": "१४", "content_sanskrit": "तथा समभवच्चापि यदुवाच विभीषणः ।\nक्षणेनातीन्द्रियाण्येषां चक्षूंष्यासन्युधिष्ठिर \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136635, "chapter_id": 3962, "verse_number": "१५", "content_sanskrit": "इन्द्रजित् कृतकर्मा च पित्रे कर्म तदाऽऽत्मनः ।\nनिवेद्य पुनरागच्छत् त्वरयाऽजिशिरः प्रति \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136636, "chapter_id": 3962, "verse_number": "१६", "content_sanskrit": "तमापतन्तं सङ्क्रुद्धं पुनरेव युयुत्सया ।\nअभिदुद्राव सौमित्रिर्विभीषणमते स्थितः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136637, "chapter_id": 3962, "verse_number": "१७", "content_sanskrit": "अकृताह्निकमेवैनं जिघांसुर्जितकाशिनम् ।\nशरैर्जघान सङ्क्रुद्धः कृतसञ्ज्ञोऽथ लक्ष्मणः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136638, "chapter_id": 3962, "verse_number": "१८", "content_sanskrit": "तयोः समभवद् युद्धं तदान्योन्यं जिगीषतोः ।\nअतीव चित्रमाश्चर्यं शक्रप्रह्लादयोरिव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136639, "chapter_id": 3962, "verse_number": "१९", "content_sanskrit": "अविध्यदिन्द्रजिद्तीक्ष्णैः सौमित्रिं मर्मभेदिभिः ।\nसौमित्रिश्चानलस्पर्शैरविध्यद् रावणिं शरैः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136640, "chapter_id": 3962, "verse_number": "२०", "content_sanskrit": "सौमित्रिशरसंस्पर्शाद् रावणिः क्रोधमूर्च्छ्रितः ।\nव्यसृजल्लक्ष्मणायाष्टौ शरानाशीविषोपमान् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136641, "chapter_id": 3962, "verse_number": "२१", "content_sanskrit": "तांश्चिच्छेद सौमित्रिः शरानष्टावनागतान् । तानप्राप्ताशितैर्बाणैश्चिच्छेद रघुनन्दनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136642, "chapter_id": 3962, "verse_number": "२२", "content_sanskrit": "तस्यासून् पावकस्पर्शैः सौमित्रिः पत्त्रिभिस्त्रिभिः ।\nवारयामास नाराचैः सौमित्रिर्मित्रनन्दनः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136643, "chapter_id": 3962, "verse_number": "२३", "content_sanskrit": "असृजल्लक्ष्मणश्चाष्टौ राक्षसाय शरान् पुनः ।\nतं तथा न्यहनद् वीरस्तन्मे निगदतः शृणु \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136644, "chapter_id": 3962, "verse_number": "२४", "content_sanskrit": "एकेनास्य धनुष्मन्तं बाहुं देहादपातयत् ।\nद्वितीयेन सनाराचं भुजं भूमौ न्यपातयत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136645, "chapter_id": 3962, "verse_number": "२५", "content_sanskrit": "तृतीयेन तु बाणेन पृथुधारेण भास्वता ।\nजहार सुनसं चापि शिरो भ्राजिष्णुकुण्डलम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136646, "chapter_id": 3962, "verse_number": "२६", "content_sanskrit": "विनिकृत्तभुजस्कन्धं कबन्धं भीमदर्शनम् ।\nपपात वसुधायां तु भिन्नमूल इव द्रुमः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136647, "chapter_id": 3962, "verse_number": "२७", "content_sanskrit": "तं हत्वा सुतमप्यस्त्रैर्जघान बलिनां वरः ।\nलङ्कां प्रवेशयामासुस्तं रथं वाजिनस्तदा ।\nददर्श रावणस्तं च रथं पुत्रविनाकृतम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136648, "chapter_id": 3962, "verse_number": "२८", "content_sanskrit": "स पुत्रं निहतं ज्ञात्वा त्रासान् सम्भ्रान्तमानसः ।\nरावणः शोकमोहार्तो वैदेहीं हन्तुमुद्यतः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136649, "chapter_id": 3962, "verse_number": "२९", "content_sanskrit": "अशोकवनिकास्थां तां रामदर्शनलालसाम् ।\nखड्गमादाय दुष्टात्मा जवेनाभिपपात ह \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136650, "chapter_id": 3962, "verse_number": "३०", "content_sanskrit": "तं दृष्ट्वा तस्य दुर्बुद्धेरविन्ध्यः पापनिश्चयम् ।\nशमयामास सङ्क्रुद्धं श्रूयतां येन हेतुना \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136651, "chapter_id": 3962, "verse_number": "", "content_sanskrit": "अवध्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136652, "chapter_id": 3962, "verse_number": "३१", "content_sanskrit": "महाराज्ये स्थितो दीप्ते न स्त्रियं हन्तुमर्हसि ।\nहतैवैषा यदा स्त्री च बन्धनस्था च ते वशे \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136653, "chapter_id": 3962, "verse_number": "३२", "content_sanskrit": "न चैषा देहभेदेन हता स्यादिति मे मतिः ।\nजहि भर्तारमेवास्या हते तस्मिन् हता भवेत् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136654, "chapter_id": 3962, "verse_number": "३३", "content_sanskrit": "न हि ते विक्रमे तुल्यः साक्षादपि शतक्रतुः।\nअसकृद्धि त्वया सेन्द्रास्त्रासितास्त्रिदशा युधि \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136655, "chapter_id": 3962, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136656, "chapter_id": 3962, "verse_number": "३४", "content_sanskrit": "एवं बहुविधैर्वाक्यैरविन्ध्यो रावणं तदा ।\nक्रुद्धं संशमयामास जगृहे च स तद्वचः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136657, "chapter_id": 3962, "verse_number": "३५", "content_sanskrit": "निर्याणे स मतिं कृत्वा निधायासिं क्षपाचरः।\nआज्ञापयामास तदा रथो मे कल्प्यतामिति \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136658, "chapter_id": 3962, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि श्रीरामोपाख्यानपर्वणि इन्द्रजिद्वधे अष्टसप्तत्यधिकद्विशततमोऽध्यायः ॥२७८॥\nरामोपाख्यानपर्वणि अष्टादशोऽध्यायः ॥१८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]