[{"id": 2032572, "chapter_id": 1704, "verse_number": "४-२७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032573, "chapter_id": 1704, "verse_number": "४-२७-१", "content_sanskrit": "तत्काले तु समागम्य सर्वे तत्रास्य बान्धवाः ।\nरुरुदुः कीचकं दृष्ट्वा परिवार्योपतस्थिरे ॥ १ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032574, "chapter_id": 1704, "verse_number": "४-२७-२", "content_sanskrit": "सर्वे संहृष्टरोमाणः संत्रस्ताः प्रेक्ष्य कीचकम्।\nतथा संभुग्नसर्वाङ्गं कूर्मं स्थल इवोद्धृतम् ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032575, "chapter_id": 1704, "verse_number": "४-२७-३", "content_sanskrit": "पोथितं भीमसेनेन महेन्द्रेणेव दानवम्।\nकीचकं बलसंमत्तं दुर्धर्षं येन केन चित् ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032576, "chapter_id": 1704, "verse_number": "४-२७-४", "content_sanskrit": "गन्धर्वेण हतं श्रुत्वा कीचकं पुरुषर्षभम्।\nसंस्कारयितुमिच्छन्तो बहिर्नेतुं प्रचक्रमुः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032577, "chapter_id": 1704, "verse_number": "४-२७-५", "content_sanskrit": "अपश्यन्नथ ते कृष्णां मूतपुत्राः समागताः।\nअदूरादनवद्याङ्गीं स्तम्भमालिङ्ग्य तिष्ठतीम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032578, "chapter_id": 1704, "verse_number": "४-२७-६", "content_sanskrit": "समागतेषु सूतेषु तानुवाचोपकीचकः।\nहसन्निव पदाऽमर्षान्निर्दहन्निव चक्षुषा ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032579, "chapter_id": 1704, "verse_number": "४-२७-७", "content_sanskrit": "हन्यतां शीघ्रमसती यत्कृते कीचको हतः।\nअथवा नैव हन्तव्या दह्यतां कामिना सह ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032580, "chapter_id": 1704, "verse_number": "४-२७-८", "content_sanskrit": "मृतस्यापि प्रियं कार्यं सूतपुत्रस्य सर्वथा ।\nइयं हि दुष्टचरिता मम भ्रातुरमित्रिणी ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032581, "chapter_id": 1704, "verse_number": "४-२७-९", "content_sanskrit": "यत्कृते मरणं प्राप्तो नेयं जीवितुमर्हति।\nसहेयं दह्यतां सूता आमन्त्र्य च जनाधिपम् ।\nहतस्यापि हि गन्धर्वैः कीचकस्य प्रियं भवेत् ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032582, "chapter_id": 1704, "verse_number": "४-२७-१०x", "content_sanskrit": "वैशम्पायन उवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032583, "chapter_id": 1704, "verse_number": "४-२७-१०", "content_sanskrit": "ततो विराटमासाद्य सूताः प्राञ्जलयोऽब्रुवन्।\nकीचकोऽयं हतः शेते गन्धर्वैः कामरूपिभिः ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032584, "chapter_id": 1704, "verse_number": "४-२७-११", "content_sanskrit": "सैरन्ध्र्या घातितो रात्रौ तं दहेम सहानया ।\nमानिताः स्मस्त्वया वीर तदनुज्ञातुमर्हसि ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032585, "chapter_id": 1704, "verse_number": "४-२७-१२", "content_sanskrit": "पराक्रमं तु सूतानां ज्ञात्वा राजाऽन्वमन्यत ।\nसैरन्ध्र्याः सूतपुत्रेण सह दाहं नराधिपः ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032586, "chapter_id": 1704, "verse_number": "४-२७-१३", "content_sanskrit": "ततस्ते समनुज्ञाताः सर्वे तत्रास्य बान्धवाः।\nरुरुदुः कीचकं दृष्ट्वा परिवार्याभितः स्थिताः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032587, "chapter_id": 1704, "verse_number": "४-२७-१४", "content_sanskrit": "आरोप्य कृष्णां सह कीचकेन निबध्य केशेषु च पादयोश्च।\nते चापि सूता वचनैरवोचन्नुद्दिश्य चैनामभिवीक्ष्य कृष्णाम् ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032588, "chapter_id": 1704, "verse_number": "४-२७-१५", "content_sanskrit": "यस्याः कृतेऽयं निहतो महात्मा तस्माद्धि सा कीचकमार्गमेतु ।\nअवार्यसत्वेन च कीचकेन गतासुना सुन्दरी स्वर्गलोकम् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032589, "chapter_id": 1704, "verse_number": "४-२७-१६", "content_sanskrit": "सा तेन कृष्णा शयने निबद्धा यशस्विनी चैव मनस्विनी च।\nअनार्यसत्त्वेन महार्यसत्त्वा गतासुना सा प्ररुरोद कृष्णा ।\nविलम्बमाना विवशा हि दुष्टैस्तत्रैव पर्यङ्कवरे शुभाङ्गी ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032590, "chapter_id": 1704, "verse_number": "४-२७-१७", "content_sanskrit": "ह्रियमाणाऽथ सुश्रोणी सूतपुत्रैरनिन्दिता।\nप्राक्रोशन्नाथमिच्छन्ती कृष्णा नाथवती सती ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032591, "chapter_id": 1704, "verse_number": "४-२७-१८", "content_sanskrit": "मृतेन सह बद्धाङ्गी निराशा जीविते तदा।\nश्मशानाभिमुखं नीता करेणुरिव रौति सा ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032592, "chapter_id": 1704, "verse_number": "४-२७-१९x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032593, "chapter_id": 1704, "verse_number": "४-२७-१९", "content_sanskrit": "जयो जयेशो विजयो जयत्सेनो जयद्बलः।\nत मे वाचं विजानन्तु सूतपुत्रा नयन्ति माम् ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032594, "chapter_id": 1704, "verse_number": "४-२७-२०", "content_sanskrit": "येषां दुन्दुभिनिर्घोषो ज्याघोषः श्रूयते महान्।\nते मे वाचं विजानन्तु सूतपुत्रा नयन्ति माम् ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032595, "chapter_id": 1704, "verse_number": "४-२७-२१", "content_sanskrit": "येषां ज्यातलनिर्घोषो विस्फूर्जितमिवाशनेः।\nअश्रूयत महान्युद्धे भीमघोपस्तरस्विनाम् ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032596, "chapter_id": 1704, "verse_number": "४-२७-२२", "content_sanskrit": "रथघोपश्च बलवान्गन्धर्वाणां तरस्विनाम् ।\nते मे वाचं बिजानन्तु सूतपुत्रा नयन्ति माम् ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032597, "chapter_id": 1704, "verse_number": "४-२७-२३", "content_sanskrit": "येषां वीर्यमतुल्यं तु शक्रस्येव बलं यशः।\nराजसिंहा इवाग्र्यास्ते मां जानन्तु सुदुःखितां ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032598, "chapter_id": 1704, "verse_number": "४-२७-२४", "content_sanskrit": "इत्यस्याः कृपणा वाचः कृष्णायाः परिदेविताः।\nश्रुत्वैवाभ्युत्थितो भीमः शयनादविचारयन् ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032599, "chapter_id": 1704, "verse_number": "४-२७-२५x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032600, "chapter_id": 1704, "verse_number": "४-२७-२५", "content_sanskrit": "अहं सैरन्ध्रि ते वाचः शृणोमि तव भाषिताः।\nतस्मात्ते सूतपुत्रेभ्यो न भयं जातु विद्यते ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032601, "chapter_id": 1704, "verse_number": "४-२७-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032602, "chapter_id": 1704, "verse_number": "४-२७-२६", "content_sanskrit": "इत्युक्त्वा स महाबाहुर्विजजृम्भे जिघांसया ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032603, "chapter_id": 1704, "verse_number": "४-२७-२७", "content_sanskrit": "ततः स व्यायतं बद्ध्वा वस्त्रं विपरिवेष्ट्य च।\nअद्वारेणाभ्यवस्कन्द्य निर्जगाम बहिस्तदा ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032604, "chapter_id": 1704, "verse_number": "४-२७-२८", "content_sanskrit": "स लङ्घयित्वा प्राकारमारुह्य तरसा द्रुमम् ।\nश्मशानाभिमुखः प्रायाद्यत्र ते कीचका गताः ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032605, "chapter_id": 1704, "verse_number": "४-२७-२९", "content_sanskrit": "स लङ्घयित्वा प्राकारं निःसृत्य च पुरोत्तमात् ।\nजवेनोत्पतितो भीमः सूतानामग्रतस्तदा ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032606, "chapter_id": 1704, "verse_number": "४-२७-३०", "content_sanskrit": "चितासमीपं गत्वा स तत्रापश्यन्महाबलः ।\nतालमात्रं महास्कन्धमूर्ध्वशुष्कं वनस्पतिम् ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032607, "chapter_id": 1704, "verse_number": "४-२७-३१", "content_sanskrit": "तं नागवदुपक्रम्य बाहुभ्यां परिरभ्य च।\nवृक्षमुत्पाटयामास भीमो भीमपराक्रमः ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032608, "chapter_id": 1704, "verse_number": "४-२७-३२", "content_sanskrit": "ततो वृक्षं दशव्यामं निष्पत्रमकरोत्तदा ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032609, "chapter_id": 1704, "verse_number": "४-२७-३३", "content_sanskrit": "तं महाकायमुद्यम्य भ्रामयित्वा च वेगितः।\nप्रगृह्याभ्यपतत्सूतान्दण्डपाणिरिवान्तकः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032610, "chapter_id": 1704, "verse_number": "४-२७-३४", "content_sanskrit": "ऊरुवेगेन तस्याथ न्यग्रोधाश्वत्थकिंशुकाः।\nभूमौ निपतिता वृक्षाः संभग्नास्तत्र शेरते ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032611, "chapter_id": 1704, "verse_number": "४-२७-३५", "content_sanskrit": "तं सिंहमिव संक्रुद्धं दृष्ट्वा गन्धर्वमागतम्।\nवित्रेसुश्च तदा सूता विपादभयपीडिताः ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032612, "chapter_id": 1704, "verse_number": "४-२७-३६", "content_sanskrit": "तमन्तकमिव क्रुद्धं गन्धर्वभयशङ्किताः।\nदिधक्षन्तस्तथा ज्येष्ठं भ्रातरं चोपकीचकाः।\nपरस्परमथोचुस्ते विषादभयमोहिताः ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2032613, "chapter_id": 1704, "verse_number": "४-२७-३७", "content_sanskrit": "गन्धर्वो बलवानेति क्रुद्ध उद्यम्य पादपम्।\nप्रबुद्धाः सुमहाभागा गन्धर्वाः सूर्यवर्चसः।\nसैरन्ध्री मुच्यतां शीघ्रं भयं नो महदागतम् ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2032614, "chapter_id": 1704, "verse_number": "४-२७-३८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2032615, "chapter_id": 1704, "verse_number": "४-२७-३८", "content_sanskrit": "ते दृष्ट्वाऽथ समाविद्धं भीमसेनेन पादपम् ।\nविमुच्य द्रौपदीं त्रस्ताः प्राद्रवन्नगरं प्रति ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2032616, "chapter_id": 1704, "verse_number": "४-२७-३९", "content_sanskrit": "द्रवतस्तांश्च संप्रेक्ष्य स वज्री दानवानिव ।\nअथ भीमः समुत्पत्य द्रवतां पुरतोऽभवत् ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2032617, "chapter_id": 1704, "verse_number": "४-२७-४०", "content_sanskrit": "ते तं दृष्ट्वा भयोद्विग्ना निश्चेष्टाः समवस्थिताः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2032618, "chapter_id": 1704, "verse_number": "४-२७-४१", "content_sanskrit": "दृष्ट्वा ताञ्शतसङ्ख्यकान्स वज्री दानवानिव।\nएकेनैव प्रहारेण दश सप्त च विंशतिम्।\nअष्टादश च पञ्चाशञ्जघान स वृकोदरः ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2032619, "chapter_id": 1704, "verse_number": "४-२७-४२", "content_sanskrit": "शतं पञ्चाधिकं भीमः प्राहिणोद्यमसादनम्।\nवृक्षेणैकेन राजेन्द्र प्रभञ्जनसुतो बली।\nवायुवेगसमः श्रीमान्सर्वान्सूतानशेषतः ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2032620, "chapter_id": 1704, "verse_number": "४-२७-४३", "content_sanskrit": "तान्निहत्य महाबाहुर्भीमसेनो महाबलः।\nआश्वासयत्तदा कृष्णां प्रतिमुच्य च बन्धनात् ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2032621, "chapter_id": 1704, "verse_number": "४-२७-४४", "content_sanskrit": "उवाच श्लक्ष्णया वाचा पाञ्चालीं भरतर्षभः ।\nअश्रुपूर्णमुखीं भीतामुद्धरन्स वृकोदरः ॥ ४४ ॥ ४-२७-४५a[ मा खिदस्त्वं(*) याज्ञसेनि पातिव्रत्यव्रते स्थिता।\nपातिव्रत्ये स्थिता नारी व्रतं रक्षेत्सदाऽत्मनः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2032622, "chapter_id": 1704, "verse_number": "४-२७-४६", "content_sanskrit": "पुरा स्त्री देवरातस्य पतिप्रीता शिरोमणिः।\nकदाचिद्भर्तृरूपेण रक्षसाऽपहृता सती ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2032623, "chapter_id": 1704, "verse_number": "४-२७-४७", "content_sanskrit": "कस्यचित्सरसस्तीरे तां निवेश्य स राक्षसः।\nतद्भर्तृरूपं संत्यज्य रक्षो भूत्वा सुदारुणम् ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2032624, "chapter_id": 1704, "verse_number": "४-२७-४८", "content_sanskrit": "साम्ना दानेन भेदेन सा यदा नान्वमन्यत।\nतदा तां पातयित्वा स मैथुनायोपचक्रमे ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2032625, "chapter_id": 1704, "verse_number": "४-२७-४९", "content_sanskrit": "ततः सा धैर्यमास्थाय विवरं त ददौ तदा।\nततः स खङ्गमुत्कृष्य भीषयामास तां सतीम् ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2032626, "chapter_id": 1704, "verse_number": "४-२७-५०", "content_sanskrit": "साऽपि त्यक्तभया साध्वी प्राणत्यागे सुनिश्चिता।\nप्रतिज्ञामकरोत्कृष्णे पातिव्रत्यपरायणा ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2032627, "chapter_id": 1704, "verse_number": "४-२७-५१", "content_sanskrit": "आराधितो यदि मया भर्ता मे दैवतं महत्।\nकर्मणा मनसा वाचा गुरवस्तोषिता मया।\nतेन सत्येन योनिर्मे भवत्वद्य शिला दृढा ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2032628, "chapter_id": 1704, "verse_number": "४-२७-५२", "content_sanskrit": "एवं तया प्रतिज्ञाते तद्योनिः सा शिलाऽभवत्।\nअन्तरा नाभिजान्वोर्यत्तत्सर्वं च शिलाऽभवत् ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2032629, "chapter_id": 1704, "verse_number": "४-२७-५३", "content_sanskrit": "ततः स खङ्गमुद्धृत्य वेगेनास्याः शिरोऽहरत् ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2032630, "chapter_id": 1704, "verse_number": "४-२७-५४", "content_sanskrit": "जया नाम सखी साऽभूत्पार्वत्या नखमांसवत्।\nतस्मात्पतिव्रतायाश्च दुःखमल्पं सुखं बहु ॥ ] ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2032631, "chapter_id": 1704, "verse_number": "४-२७-५५", "content_sanskrit": "एवं ते भीरु वध्यन्ते ये त्वां हिंसन्ति मानवाः।\nगच्छ त्वं नगरं कृष्णे न भयं विद्यते तव ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2032632, "chapter_id": 1704, "verse_number": "४-२७-५६", "content_sanskrit": "अन्येन त्वं पथा शीघ्रं सुदेष्णाया निवेशनम्।\nअन्येनाहं गमिष्यामि विराटस्य महानसम् ।\nयथा नौ नावबुध्येरन्रात्रावेवं व्यवस्थितौ ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2032633, "chapter_id": 1704, "verse_number": "४-२७-५७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2032634, "chapter_id": 1704, "verse_number": "४-२७-५७", "content_sanskrit": "साऽगच्छन्नगरं कृष्णा भीमेनाश्वासिता सती ॥ ५७ ॥\nकृतकृत्या सुदेष्णाया भवनं शुभलक्षणा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2032635, "chapter_id": 1704, "verse_number": "४-२७-५८", "content_sanskrit": "शचीव नहुषे शप्ते प्रविवेश त्रिविष्टपम् ॥ ५८ ॥\nभीमोऽप्यमितवीर्यस्तु बलवानरिमर्दनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2032636, "chapter_id": 1704, "verse_number": "४-२७-५९", "content_sanskrit": "सर्वांस्तान्कीचकांस्तत्र हत्वा धर्मात्मजानुजः ॥ ५९ ॥\nनिःशेषं कीचकान्हत्वा रामो रात्रिचरानिव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2032637, "chapter_id": 1704, "verse_number": "४-२७-६०", "content_sanskrit": "जितशत्रुरदीनात्मा प्रविवेश पुरं ततः ॥ ६० ॥\nपञ्चाधिकं शतं तत्र निहतं तेन भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2032638, "chapter_id": 1704, "verse_number": "४-२७-६१", "content_sanskrit": "महावनमिव छिन्नं शिश्ये विगलितद्रुमम् ॥ ६१ ॥\nएवं ते निहता राजञ्शतं पञ्चोपकीचकाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2032639, "chapter_id": 1704, "verse_number": "४-२७-६२", "content_sanskrit": "स च सेनापतिः सूत इत्येतत्सूतषट्शतम् ॥ ६२ ॥\nन गन्धर्वभयाकिंचिद्वक्तुं कीचकबान्धवाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2032640, "chapter_id": 1704, "verse_number": "४-२७-६३", "content_sanskrit": "अशक्नुवन्तस्तां तत्र भयादप्यभिवीक्षितुम् ॥ ६३ ॥\nविराटनगरे चापि सर्वे मात्स्याः समागताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2032641, "chapter_id": 1704, "verse_number": "४-२७-६४", "content_sanskrit": "काल्यं पञ्चशतं चैतानपश्यन्सारथीन्हतान् ॥ ६४ ॥\nतद्दृष्ट्वा महदाश्चर्यं नरा नार्यश्च नागराः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2032642, "chapter_id": 1704, "verse_number": "४-२७-६५", "content_sanskrit": "विस्मयं परमं गत्वा नोचुः किंचन भारत ॥ ६५ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2032643, "chapter_id": 1704, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि सप्तविंशोऽध्यायाः ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]