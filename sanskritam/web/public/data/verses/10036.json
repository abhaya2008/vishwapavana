[{"id": 6000036000, "chapter_id": 10036, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "अयं पुराणस्य दशलक्षण्यन्तर्भूतः सर्गः", "range": null}]}, {"id": 6000036001, "chapter_id": 10036, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.001.m4a", "display_order": 2}, {"id": 6000036002, "chapter_id": 10036, "verse_number": "३-६-१", "content_sanskrit": "भगवानेक आसेदमग्र आत्माऽऽत्मनां विभुः।\nआत्मेच्छानुगतो ह्यात्मा नानाशक्त्युपलक्षितः॥ ३/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.002.m4a", "display_order": 3, "topics": [{"text": "भगवतः सर्वतन्त्रस्वतन्त्रत्वम्", "range": "१–२"}]}, {"id": 6000036003, "chapter_id": 10036, "verse_number": "३-६-२", "content_sanskrit": "स वा एष तदा द्रष्टा नापश्यद् विश्वमेकराट्।\nमेनेऽसन्तमिवाऽऽत्मानं सुप्तशक्तिरसुप्तदृक्॥ ३/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.003.m4a", "display_order": 4}, {"id": 6000036004, "chapter_id": 10036, "verse_number": "३-६-३", "content_sanskrit": "सा वा एतस्य सन्द्रष्टुः शक्तिः सदसदात्मिका।\nमाया नाम महाभाग ययेदं निर्ममे विभुः॥ ३/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.004.m4a", "display_order": 5, "topics": [{"text": "भगवता ब्रह्माण्डाद्बहिः वटपत्रे शयानेन महदादितत्त्वानां तदभिमानिदेवानां च सृष्टिकथनम्", "range": "३–१६"}]}, {"id": 6000036005, "chapter_id": 10036, "verse_number": "३-६-४", "content_sanskrit": "कालवृत्त्यां तु मायायां गुणमय्यामधोक्षजः।\nपुरुषेणात्मभूतेन वीर्यमाधत्त वीर्यवान्॥ ३/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.005.m4a", "display_order": 6}, {"id": 6000036006, "chapter_id": 10036, "verse_number": "३-६-५", "content_sanskrit": "ततोऽभवन्महत्तत्त्वमव्यक्तात् कालचोदितात्।\nविज्ञानात्माऽऽत्मदेहस्थं विश्वं व्यञ्जंस्तमो नुदन्॥ ३/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.006.m4a", "display_order": 7}, {"id": 6000036007, "chapter_id": 10036, "verse_number": "३-६-६", "content_sanskrit": "सोऽप्यंशगुणकालात्मा भगवद्दृष्टिगोचरः।\nआत्मानं व्यकरोदात्मा विश्वस्यास्य सिसृक्षया॥ ३/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.007.m4a", "display_order": 8}, {"id": 6000036008, "chapter_id": 10036, "verse_number": "३-६-७", "content_sanskrit": "महत्तत्त्वाद् विकुर्वाणाद् अहन्तत्त्वमजायत।\nकार्यकारणकर्त्रात्मा भूतेन्द्रियमनोभवः॥ ३/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.008.m4a", "display_order": 9}, {"id": 6000036009, "chapter_id": 10036, "verse_number": "३-६-८", "content_sanskrit": "वैकारिकस्तैजसश्च तामसश्चेत्यहं त्रिधा।\nअहंतत्त्वाद् विकुर्वाणान्मनो वैकारिकादभूत्॥ ३/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.009.m4a", "display_order": 10}, {"id": 6000036010, "chapter_id": 10036, "verse_number": "३-६-९", "content_sanskrit": "वैकारिकाश्च ये देवा अर्थाभिव्यञ्जनं यतः।\nतैजसानीन्द्रियाण्येव ज्ञानकर्ममयानि च॥ ३/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.010.m4a", "display_order": 11}, {"id": 6000036011, "chapter_id": 10036, "verse_number": "३-६-१०", "content_sanskrit": "तामसो भूतसूक्ष्मादिर्यतः खं लिङ्गमात्मनः॥ ३/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.011.m4a", "display_order": 12}, {"id": 6000036012, "chapter_id": 10036, "verse_number": "३-६-११", "content_sanskrit": "कालमायांशयोगेन भगवद्वीक्षितं नभः।\nतामसानुसृतं स्पर्शं विकुर्वन् निर्ममेऽनिलम्॥ ३/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.012.m4a", "display_order": 13}, {"id": 6000036013, "chapter_id": 10036, "verse_number": "३-६-१२", "content_sanskrit": "अनिलोऽपि विकुर्वाणो नभसोरुबलान्वितः।\nससर्ज रूपतन्मात्रां ज्योतिर्लोकस्य लोचनम्॥ ३/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.013.m4a", "display_order": 14}, {"id": 6000036014, "chapter_id": 10036, "verse_number": "३-६-१३", "content_sanskrit": "अनिलेनान्वितं ज्योतिर्विकुर्वत् परवीक्षितम्।\nआधत्ताम्भो रसमयं कालमायांशयोगतः॥ ३/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.014.m4a", "display_order": 15}, {"id": 6000036015, "chapter_id": 10036, "verse_number": "३-६-१४", "content_sanskrit": "ज्योतिषाऽम्भोऽनुसंसृष्टं विकुर्वत् परवीक्षितम्।\nमहीं गन्धगुणामाधात् कालमायांशयोगतः॥ ३/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.015.m4a", "display_order": 16}, {"id": 6000036016, "chapter_id": 10036, "verse_number": "३-६-१५", "content_sanskrit": "भूतानां नभआदीनां यद्यद् भाव्यं परात् परम्।\nतेषां परानुसंसर्गाद् यथासङ्ख्यं गुणान् विदुः॥ ३/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.016.m4a", "display_order": 17}, {"id": 6000036017, "chapter_id": 10036, "verse_number": "३-६-१६", "content_sanskrit": "एते देवाः कला विष्णोः कालमायांशलिङ्गिनः।\nनानात्वात् स्वक्रियानीशाः प्रोचुः प्राञ्जलयो विभुम्॥ ३/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.017.m4a", "display_order": 18}, {"id": 6000036018, "chapter_id": 10036, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.018.m4a", "display_order": 19}, {"id": 6000036019, "chapter_id": 10036, "verse_number": "३-६-१७", "content_sanskrit": "नताः स्म ते देव पदारविन्दं प्रपन्नतापोपशमातपत्रम्।\nयन्मूलकेता यतयोऽञ्जसोरुसंसारदुःखं बहिरुत्क्षिपन्ति॥ ३/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.019.m4a", "display_order": 20, "topics": [{"text": "तैर्देवैरण्डसृष्टावसामर्थ्याद् भगवन्तं प्रति स्तवनपूर्वकम् अण्डसृष्टिप्रार्थना", "range": "१७–२९"}]}, {"id": 6000036020, "chapter_id": 10036, "verse_number": "३-६-१८", "content_sanskrit": "ऋते यदस्मिन् भव ईश जीवास्तापत्रयेणाभिहता न शर्म।\nआत्मन् लभन्ते भगवंस्तवाङ्घ्रिच्छायांशविद्यामत आश्रयेम॥ ३/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.020.m4a", "display_order": 21}, {"id": 6000036021, "chapter_id": 10036, "verse_number": "३-६-१९", "content_sanskrit": "मार्गन्ति यत् ते मुखपद्मनीडैश्छन्दःसुपर्णैर्ऋषयो विविक्ते।\nयच्चाघमर्षो द्युसरिद्धरायाः परं पदं तीर्थपदः प्रपन्नाः॥ ३/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.021.m4a", "display_order": 22}, {"id": 6000036022, "chapter_id": 10036, "verse_number": "३-६-२०", "content_sanskrit": "यच्छ्रद्धया श्रुतवत्या च भक्त्या संमृज्यमाने हृदयेऽवधार्य।\nज्ञानेन वैराग्यबलेन धीरा व्रजन्ति यत् तेऽङ्घ्रिसरोजपीठम्॥ ३/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.022.m4a", "display_order": 23}, {"id": 6000036023, "chapter_id": 10036, "verse_number": "३-६-२१", "content_sanskrit": "विश्वस्य जन्मस्थितिसंयमार्थे कृतावतारस्य पदाम्बुजं ते।\nव्रजेम सर्वे शरणं यदीश स्मृतं प्रयच्छत्यभयं स्वपुंसाम्॥ ३/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.023.m4a", "display_order": 24}, {"id": 6000036024, "chapter_id": 10036, "verse_number": "३-६-२२", "content_sanskrit": "यत् सानुबन्धेऽसति देहगेहे ममाहमित्यूढदुराग्रहाणाम्।\nपुंसां सुदूरं वसतोऽपि पुर्यां भजेम तत् ते भगवन् पदाब्जम्॥ ३/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.024.m4a", "display_order": 25}, {"id": 6000036025, "chapter_id": 10036, "verse_number": "३-६-२३", "content_sanskrit": "तं त्वामसद्वृत्तिभिरक्षिभिर्ये पराहृतान्तर्मनसः परेश।\nअथो न पश्यन्त्युरुगाय नूनं यत् ते पदं न्यासविलासलक्ष्म्याः॥ ३/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.025.m4a", "display_order": 26}, {"id": 6000036026, "chapter_id": 10036, "verse_number": "३-६-२४", "content_sanskrit": "पानेन ते देव कथासुधायाः प्रवृद्धभक्त्या विशदाशया ये।\nवैराग्यसारं प्रतिलभ्य बोधं यथाऽञ्जसा त्वापुरकुण्ठधिष्ण्यम्॥ ३/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.026.m4a", "display_order": 27}, {"id": 6000036027, "chapter_id": 10036, "verse_number": "३-६-२५", "content_sanskrit": "तथाऽपरे त्वात्मसमाधियोगबलेन जित्वा प्रकृतिं बलिष्ठाम्।\nत्वामेव धीराः पुरुषं विशन्ति तेषां श्रमः स्यान्न तु सेवया ते॥ ३/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.027.m4a", "display_order": 28}, {"id": 6000036028, "chapter_id": 10036, "verse_number": "३-६-२६", "content_sanskrit": "तत् ते वयं लोकसिसृक्षयाऽद्य त्वया विसृष्टास्‍त्रिभिरात्मभिर्ये।\nसर्वे वियुक्ताः स्वविहारतन्त्रं न शक्नुमस्तत् प्रतिकर्तवे ते॥ ३/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.028.m4a", "display_order": 29}, {"id": 6000036029, "chapter_id": 10036, "verse_number": "३-६-२७", "content_sanskrit": "यावद् बलिं तेऽज हराम काले यथा वयं चान्नमदाम यत्र।\nतथोभयेषां त इमे ह लोका बलिं हरन्तोऽन्नमदन्त्यमूढाः॥ ३/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.029.m4a", "display_order": 30}, {"id": 6000036030, "chapter_id": 10036, "verse_number": "३-६-२८", "content_sanskrit": "त्वं नः सुराणामसि सान्वयानां कूटस्थ आद्यः पुरुषः पुराणः।\nत्वं देव शक्त्यां गुणकर्मयोनौ रेतस्त्वजायां कविरादधेऽजः॥ ३/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.030.m4a", "display_order": 31}, {"id": 6000036031, "chapter_id": 10036, "verse_number": "३-६-२९", "content_sanskrit": "ततो वयं सत्प्रमुखा यदर्थे बभूविमात्मन् करवाम किं ते।\nत्वं नः स चक्षुः परिदेहि शक्ता देव क्रियार्थे यदनुग्रहेण॥ ३/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_006/BhP_03.006.031.m4a", "display_order": 32}, {"id": 6000036032, "chapter_id": 10036, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]