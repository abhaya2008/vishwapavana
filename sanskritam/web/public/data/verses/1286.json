[{"id": 2013887, "chapter_id": 1286, "verse_number": "२-२७-१", "content_sanskrit": "जनमेजय उवाच॥\nदिशामभिजयं ब्रह्मन्विस्तरेणानुकीर्तय।\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013888, "chapter_id": 1286, "verse_number": "२-२७-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013889, "chapter_id": 1286, "verse_number": "२-२७-२", "content_sanskrit": "धनञ्जयस्य वक्ष्यामि विजयं पूर्वमेव ते।\nयौगपद्येन पार्थैर्हि निर्जितेयं वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013890, "chapter_id": 1286, "verse_number": "२-२७-३", "content_sanskrit": "अवाप्य राजा राज्यार्धं कुन्तीपुत्रो युधिष्ठिरः।\nमहत्त्वे राजशब्दस्य मनश्चक्रे महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013891, "chapter_id": 1286, "verse_number": "२-२७-४", "content_sanskrit": "तदा क्षात्रं विदित्वाऽस्य पृथिवीविजयं प्रति।\nअमर्षात्पार्थिवेन्द्राणां तं समेयाय वारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013892, "chapter_id": 1286, "verse_number": "२-२७-५", "content_sanskrit": "तत्समेत्य भुवः क्षात्रं रथनागाश्वपत्तिमत्।\nअभ्ययात्पार्थिवं जिष्णुं मोघं कर्तुं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013893, "chapter_id": 1286, "verse_number": "२-२७-६", "content_sanskrit": "तत्पार्थः पार्थिवं क्षात्रं युयुत्सुं परमाहवे।\nप्रत्युद्ययौ महाबाहुस्तरसा पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013894, "chapter_id": 1286, "verse_number": "२-२७-७", "content_sanskrit": "तद्भग्रं पार्थिवं क्षात्रं पार्थेनाक्लिष्टकर्मणा।\nवायुनेव घनानीकं तूलीभूतं ययौ दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013895, "chapter_id": 1286, "verse_number": "२-२७-८", "content_sanskrit": "तज्जित्वा पार्थिवं क्षात्रं समरे परवीरहा।\nययौ तदा वशे कर्तुमुदीचीं पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013896, "chapter_id": 1286, "verse_number": "२-२७-९", "content_sanskrit": "पूर्वं कुलिङ्गविषये वशे चक्रे महीपतिम्।\nधनञ्जयो महाबाहुर्नातितीव्रेण कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013897, "chapter_id": 1286, "verse_number": "२-२७-१०", "content_sanskrit": "तेनैव सहितः प्रायाज्जिष्णुः साल्वपुरं प्रति।\nस साल्वपुरमासाद्य साल्वराजं धनञ्जयटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013898, "chapter_id": 1286, "verse_number": "२-२७-११", "content_sanskrit": "विक्रमेणोग्रधन्वानं वशे चक्रे महामनाः।\nतं पार्थः सहसा जित्वा द्युमत्सेनं महीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013899, "chapter_id": 1286, "verse_number": "२-२७-१२", "content_sanskrit": "कृत्वा स सैनिकं प्रायात्कटदेशमरिन्दमः।\nतत्र पार्थो रणे जिष्णुः सुनाभं वसुधाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013900, "chapter_id": 1286, "verse_number": "२-२७-१३", "content_sanskrit": "विक्रमेण वशे कृत्वा कृतवाननुसैनिकम्।\nएतेन सहितो राजन्सव्यसाची परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013901, "chapter_id": 1286, "verse_number": "२-२७-१४", "content_sanskrit": "विजिग्ये शाकलद्वीपे प्रतिविन्ध्यं च पार्थिवम्।\nशाकलद्वीपवासाश्च सप्तद्वीपेषु ये नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013902, "chapter_id": 1286, "verse_number": "२-२७-१५", "content_sanskrit": "अर्जुनस्य च सैन्यस्थैर्विग्रहस्तुमुलोऽभवत्।\nतान्सर्वानजयत्पार्तो धर्मराजप्रियेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013903, "chapter_id": 1286, "verse_number": "२-२७-१६", "content_sanskrit": "तैरेव सहितः सर्वैः प्रग्ज्योतिषमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013904, "chapter_id": 1286, "verse_number": "२-२७-१७", "content_sanskrit": "तत्र राजा महानासीद्भगदत्तो विशाम्पते।\nतेनासीत्सुमहद्युद्धं पाण्डवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013905, "chapter_id": 1286, "verse_number": "२-२७-१८", "content_sanskrit": "स किरातैश्च चीनैश्च वृतः प्राग्ज्योतिषोऽभवत्।\nअन्यैश्च बहुभिर्योधैः सागरानुपवासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013906, "chapter_id": 1286, "verse_number": "२-२७-१९", "content_sanskrit": "ततः स दिवसानष्टौ योधयित्वा धनञ्जयम्।\nप्रहसन्नब्रवीद्राजा सङ्ग्रामविगतक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013907, "chapter_id": 1286, "verse_number": "२-२७-२०", "content_sanskrit": "उपपन्नं महाबाहो त्वयि कौरवनन्दन।\nपाकशासनदायादे वीर्यमाहवशोभिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013908, "chapter_id": 1286, "verse_number": "२-२७-२१", "content_sanskrit": "अहं सखा महेन्द्रस्य शक्रादनवरो रणे।\nन शक्ष्यामि च ते तात स्थातुं प्रमुखतो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013909, "chapter_id": 1286, "verse_number": "२-२७-२२", "content_sanskrit": "त्वमीप्सितं पाण्डवेयं ब्रूहि किं करवाणि ते।\nयद्वक्ष्यसि महाबाहो तत्करिष्यामि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013910, "chapter_id": 1286, "verse_number": "२-२७-२३x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013911, "chapter_id": 1286, "verse_number": "२-२७-२३", "content_sanskrit": "कुरूणामृषभो राजा धर्मपुत्रो युधिष्ठिरः।\nधर्मज्ञः सत्यसन्धश्च यज्वा विपुलदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013912, "chapter_id": 1286, "verse_number": "२-२७-२४", "content_sanskrit": "तस्य पार्थिवतामीप्से करस्तस्मै प्रदीयताम्।\nभवान्पितृसखश्चैव प्रीयमाणो मयापि च।\nततो नाज्ञापयामि त्वां प्रीतिपूर्वं प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013913, "chapter_id": 1286, "verse_number": "२-२७-२५x", "content_sanskrit": "भगदत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013914, "chapter_id": 1286, "verse_number": "२-२७-२५", "content_sanskrit": "कुन्तीमातर्यथा मे त्वं तथा राजा युधिष्ठिरः।\nसर्वमेतत्करिष्यामि किं चान्यत्करवाणि ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013915, "chapter_id": 1286, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि सप्तविंशोऽध्यायः॥ २७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]