[{"id": 7001711000, "chapter_id": 21711, "verse_number": "१-९७-१", "content_sanskrit": "श्रीब्रह्मोवाच ।\nश्रृणु विप्र प्रवक्ष्यामि पुराणं नारदीयकम् ।\nपंचविंशतिसाहस्रं बृहत्कल्पकथाश्रयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001711001, "chapter_id": 21711, "verse_number": "१-९७-२", "content_sanskrit": "सूतशौनकसंवादः सृष्टिसंक्षेपवर्णनम् ।\nनानाधर्मकथाः पुण्याः प्रवृत्ते समुदाहृताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001711002, "chapter_id": 21711, "verse_number": "१-९७-३", "content_sanskrit": "प्राग्भागे प्रथमे पादे सनकेन महात्मना ।\nद्वितीये मोक्षधर्माख्ये मोक्षोपायनिरूपणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001711003, "chapter_id": 21711, "verse_number": "१-९७-४", "content_sanskrit": "वेदांगानां च कथनं शुकोत्पत्तिश्च विस्तरात् ।\nसनंदनेन गदिता नारदाय महात्मने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001711004, "chapter_id": 21711, "verse_number": "१-९७-५", "content_sanskrit": "महातंत्रे समुद्दिष्टं पशुपाशविमोक्षणम् ।\nमंत्राणां शोधनं दीक्षामंत्रोद्धारश्च पूजनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001711005, "chapter_id": 21711, "verse_number": "१-९७-६", "content_sanskrit": "प्रयोगाः कवचं नामसहस्रं स्तोत्रमेव च ।\nगणेशसूर्यविष्णूनां शिवशक्त्योरनुक्रमात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001711006, "chapter_id": 21711, "verse_number": "१-९७-७", "content_sanskrit": "सनत्कुमारमुनिना नारदाय तृतीयके ।\nपुराणलक्षणं चैव प्रमाणं दानमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001711007, "chapter_id": 21711, "verse_number": "१-९७-८", "content_sanskrit": "पृथक्पृथक् समुद्दिष्टं दानकालपुरःसरम् ।\nचैत्रादिसर्वमासेषु तिथीनांचपृथक्पृथक् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001711008, "chapter_id": 21711, "verse_number": "१-९७-९", "content_sanskrit": "प्रोक्तं प्रतिपदादीनां व्रतं सर्वाघनाशनम् ।\nसनातनेन मुनिना नारदाय चतुर्थके ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001711009, "chapter_id": 21711, "verse_number": "१-९७-१०", "content_sanskrit": "पूर्वभागोऽयमुदितो बृहदाख्यानसंज्ञितः ।\nअस्योत्तरे विभागे तु प्रश्न एकादशीव्रते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001711010, "chapter_id": 21711, "verse_number": "१-९७-११", "content_sanskrit": "वसिष्ठेनाथ संवादो मांधातुः परिकीर्तितः ।\nरुक्मांगदकथा पुण्यामोहिन्युत्पत्तिकर्म च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001711011, "chapter_id": 21711, "verse_number": "१-९७-१२", "content_sanskrit": "वसुशापश्च मोहिन्यै पश्चादुद्धरणक्रिया ।\nगंगाकथा पुण्यतमा गयायात्रानुकीर्तनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001711012, "chapter_id": 21711, "verse_number": "१-९७-१३", "content_sanskrit": "काश्या माहात्म्यमतुलं पुरुषोत्तमवर्णनम् ।\nयात्राविधानं क्षेत्रस्य बह्वाख्यानसमन्वितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001711013, "chapter_id": 21711, "verse_number": "१-९७-१४", "content_sanskrit": "प्रयागस्याथ माहात्म्यं कुरुक्षेत्रस्य तत्परम् ।\nहरिद्वारस्य चाख्यानं कामोदाख्यानकं तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001711014, "chapter_id": 21711, "verse_number": "१-९७-१५", "content_sanskrit": "बदरीतीर्थमाहात्म्यं कामाक्षायास्तथैव च ।\nप्रभासस्य च माहात्म्यं पुष्कराख्यानकं ततः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001711015, "chapter_id": 21711, "verse_number": "१-९७-१६", "content_sanskrit": "गौतमाख्यानकं पश्चाद्वेदपादस्तवस्ततः ।\nगोकर्णक्षेत्रमाहात्म्यं लक्ष्मणाख्यानकं तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001711016, "chapter_id": 21711, "verse_number": "१-९७-१७", "content_sanskrit": "सेतुमाहात्म्यकथनं नर्मदातीर्थवर्णनम् ।\nअवंत्याश्चैव माहात्म्यं मधुरायास्ततः परम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001711017, "chapter_id": 21711, "verse_number": "१-९७-१८", "content_sanskrit": "बृन्दावनस्य महिमा पशोर्ब्रह्मांतिके गतिः ।\nमोहिनीचरितं पश्चादेवं पश्चादेवं वै नारदीयकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001711018, "chapter_id": 21711, "verse_number": "१-९७-१९", "content_sanskrit": "यः शृणोति नरो भक्त्याश्रावयेद्वा समाहितः ।\nस याति ब्रह्मणो धाम नात्र कार्या विचारणा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001711019, "chapter_id": 21711, "verse_number": "१-९७-२०", "content_sanskrit": "यस्त्वेतदिषुपूर्णायां धेनूनां सप्तकान्वितम् ।\nप्रदद्याद्दिजंर्याय संलभेन्मोक्षमेव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001711020, "chapter_id": 21711, "verse_number": "१-९७-२१", "content_sanskrit": "यश्चानुक्रमणीमेतां नारदीयस्य वर्णयेत् ।\nश्रृणुयद्वैकचित्तेन सोऽपि स्वर्गगतिं लभेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]