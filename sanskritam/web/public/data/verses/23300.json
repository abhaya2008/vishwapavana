[{"id": 7003300000, "chapter_id": 23300, "verse_number": "१-१०३-१", "content_sanskrit": "सूत उवाच  ।\nअथ ब्रह्मा महादेवमभिवंद्य कृतांजलिः  ।\nउद्वाहः क्रियतां देव इत्युवाच महेश्वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003300001, "chapter_id": 23300, "verse_number": "१-१०३-२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा ब्रह्मणः परमेष्ठिनः  ।\nयथेष्टमिति लोकेशं प्राह भूतपतिः प्रभुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003300002, "chapter_id": 23300, "verse_number": "१-१०३-३", "content_sanskrit": "उद्वाहार्थं महेशस्य तत्क्षणादेव सुव्रताः  ।\nब्रह्मणा कल्पितं दिव्यं पुरं रत्नमयं शुभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003300003, "chapter_id": 23300, "verse_number": "१-१०३-४", "content_sanskrit": "अथादितिर्दितिः साक्षाद्दनुः कद्रुः सुकालिका  ।\nपुलोमा सुरसा चैव सिंहिका विनता तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003300004, "chapter_id": 23300, "verse_number": "१-१०३-५", "content_sanskrit": "सिद्धिर्माया क्रिया दुर्गा देवी साक्षात्सुधा स्वधा  ।\nसावित्री वेदमाता च रजनी दक्षिणा द्युतिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003300005, "chapter_id": 23300, "verse_number": "१-१०३-६", "content_sanskrit": "स्वाहा स्वधा मतिर्बुद्धिर्ऋद्धिर्वृद्धिः सरस्वती  ।\nराका कुहूः सिनीवाली देवी अनुमति तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003300006, "chapter_id": 23300, "verse_number": "१-१०३-७", "content_sanskrit": "धरणी धारणी चेला शची नारायणी तथा  ।\nएताश्चान्याश्च देवानां मातरः पत्नयस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003300007, "chapter_id": 23300, "verse_number": "१-१०३-८", "content_sanskrit": "उद्वाहः शंकरस्येति जग्मुः सर्वा मुदान्विताः  ।\nउरगा गरुडा यक्षा गंधर्वाः किन्नरा गणाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003300008, "chapter_id": 23300, "verse_number": "१-१०३-९", "content_sanskrit": "सागरा गिरयो मेघा मासाः संवत्सरा स्तथा  ।\nवेदा मंत्रास्तथा यज्ञाः स्तोमा धर्माश्च सर्वशः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003300009, "chapter_id": 23300, "verse_number": "१-१०३-१०", "content_sanskrit": "हुंकारः प्रणवश्चैव प्रतिहाराः सहस्रशः  ।\nकोटिरप्सरसो दिव्यास्तासां च परिचारिकाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003300010, "chapter_id": 23300, "verse_number": "१-१०३-११", "content_sanskrit": "याश्च सर्वेषु द्वीपेषु देवलोकेषु निम्नगाः  ।\nताश्च स्त्रीविग्रहाः सर्वाः संजग्मुर्हृष्टमानसाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003300011, "chapter_id": 23300, "verse_number": "१-१०३-१२", "content_sanskrit": "गणपाश्च महा भागाः सर्वलोकनमस्कृताः  ।\nउद्वाहः शंकरस्येति तत्राजग्मुर्मुदान्विताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003300012, "chapter_id": 23300, "verse_number": "१-१०३-१३", "content_sanskrit": "अभ्ययुः शंखवर्णाश्च गणकोट्यो गणेश्वराः  ।\nदशभिः केकराक्षश्च विद्युतोष्टाभिरेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003300013, "chapter_id": 23300, "verse_number": "१-१०३-१४", "content_sanskrit": "चतुःषष्ट्या विशाखाश्च नवभिः पारयात्रिकः  ।\nषड्भिः सर्वातकः श्रीमान् तथैव विकृताननः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003300014, "chapter_id": 23300, "verse_number": "१-१०३-१५", "content_sanskrit": "ज्वालाकेशो द्वादशभिः कोटिभिर्गणपुंगवः  ।\nसप्तभिः समदः श्रीमान्दुंदुभोष्टाभिरेव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003300015, "chapter_id": 23300, "verse_number": "१-१०३-१६", "content_sanskrit": "पंचभिश्च कपालीशः षड्भिः संदारकः शुभः  ।\nकोटिकोटिभिरेवेह गंडकः कुंभकस्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003300016, "chapter_id": 23300, "verse_number": "१-१०३-१७", "content_sanskrit": "विष्टंभोष्टाभिरेवेह गणपः सर्वसत्तमः  ।\nपिप्लश्च सहस्रेण सन्नादश्च तथा द्विजाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003300017, "chapter_id": 23300, "verse_number": "१-१०३-१८", "content_sanskrit": "आवेष्टनस्तथाष्टाभिः सप्तभिश्चंद्रतापनः  ।\nमहाकेशः सहस्रेण कोटीनां गणपो वृतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003300018, "chapter_id": 23300, "verse_number": "१-१०३-१९", "content_sanskrit": "कुंडी द्वादशभिर्वीरस्तथा पर्वतकः शुभः  ।\nकालश्च कालकश्चैव महाकालः शतेन वै ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003300019, "chapter_id": 23300, "verse_number": "१-१०३-२०", "content_sanskrit": "आग्निकः शतकोट्या वै कोट्याग्निमुख एव च  ।\nआदित्य मूर्धा कोट्या च तथा चैव धनावहः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003300020, "chapter_id": 23300, "verse_number": "१-१०३-२१", "content_sanskrit": "सन्नामश्च शतेनैव कुमुदः कोटिभिस्तथा  ।\nअमोघः कोकिलश्चैव कोटिकोट्या सुमंत्रकः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003300021, "chapter_id": 23300, "verse_number": "१-१०३-२२", "content_sanskrit": "काकपाटोऽपरः षष्ट्या षष्ट्या संतानकः प्रभुः  ।\nमहाबलश्च नवभिर्मधुपिंगश्च पिंगलः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003300022, "chapter_id": 23300, "verse_number": "१-१०३-२३", "content_sanskrit": "निलो नवत्या देवेशः पूर्णभद्रस्तथैव च  ।\nकोटीनां चैव सप्तत्या चतुर्वक्त्रो महाबलः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003300023, "chapter_id": 23300, "verse_number": "१-१०३-२४", "content_sanskrit": "कोटिकोटिसहस्राणां शतैर्विशातिभिर्वृताः  ।\nतत्राजग्मुस्तथा देवास्ते सर्वे शंकरं भवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003300024, "chapter_id": 23300, "verse_number": "१-१०३-२५", "content_sanskrit": "भूतकोटिसहस्रेण प्रमथः कोटिभिस्त्रिभिः  ।\nवीरभद्रश्चतुःषष्ट्या रोमजाश्चैव कोटिभिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003300025, "chapter_id": 23300, "verse_number": "१-१०३-२६", "content_sanskrit": "करणश्चैव विंशत्या नवत्या केवलः शुभः  ।\nपंचाक्षः शतमन्युश्च मेघमन्युस्तथैव च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003300026, "chapter_id": 23300, "verse_number": "१-१०३-२७", "content_sanskrit": "काष्ठकूटश्चतुः षष्ट्या सुकेशो वृषभस्तथा  ।\nविरुपाक्षश्च भगवान् चतुःषष्ट्या सनातनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003300027, "chapter_id": 23300, "verse_number": "१-१०३-२८", "content_sanskrit": "तालुकेतुः षडास्यश्च पंचास्यश्च सनातनः  ।\nसंवर्त्तकस्तथा चैत्रो लकुलीशः स्वयं प्रभुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003300028, "chapter_id": 23300, "verse_number": "१-१०३-२९", "content_sanskrit": "लोकांतकश्च दिप्तास्यो तथा दैत्यांतकः प्रभुः  ।\nमृत्युहृत्कालहा कालो मृत्युंजयकरस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003300029, "chapter_id": 23300, "verse_number": "१-१०३-३०", "content_sanskrit": "विषादो विषदश्चैव विद्युतः कांतकः प्रभुः  ।\nदेवो भृंगी रिटिः श्रीमान् देवदेवप्रियस्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003300030, "chapter_id": 23300, "verse_number": "१-१०३-३१", "content_sanskrit": "अशनीर्भासकश्चैव चतुःषष्ट्या सहस्रपात्  ।\nएते चान्ये च गणपा असंख्याता महाबलाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003300031, "chapter_id": 23300, "verse_number": "१-१०३-३२", "content_sanskrit": "सर्वे सहस्रहस्ताश्च जटामुकुटधारिणः  ।\nचंद्ररेखावतंसाश्च नीलकंठास्त्रिलोचनाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003300032, "chapter_id": 23300, "verse_number": "१-१०३-३३", "content_sanskrit": "हारकुंडलकेयूरमुकुटाद्यैरलंकृताः  ।\nब्रह्मेंद्रविष्णुसंकाशा अणिमादिगुणैर्वृताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003300033, "chapter_id": 23300, "verse_number": "१-१०३-३४", "content_sanskrit": "सूर्यकोटिप्रतीकाशास्तत्राजग्मुर्गणेश्वराः  ।\nपातालचारिणश्चैव सर्वलोकनिवासिनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003300034, "chapter_id": 23300, "verse_number": "१-१०३-३५", "content_sanskrit": "तुंबरुर्नारदो हाहा हूहूश्चैव तु सामगाः  ।\nरत्नान्यादाय वाद्यांश्च तत्राजग्मुस्तदा पुरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003300035, "chapter_id": 23300, "verse_number": "१-१०३-३६", "content_sanskrit": "ऋषयः कृत्स्नशस्तत्र देवगीतास्तपोधनाः  ।\nपुण्यान्वैवाहिकान्मंत्रानजपुर्हृष्टमानसाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003300036, "chapter_id": 23300, "verse_number": "१-१०३-३७", "content_sanskrit": "तत एवं प्रवृत्ते तु सर्वतश्च समागमे  ।\nगिरिजां तामलंकृत्य स्वयमेव शुचिस्मिताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003300037, "chapter_id": 23300, "verse_number": "१-१०३-३८", "content_sanskrit": "पुरं प्रवेशयामास स्वयमादायकेशवः  ।\nसदस्याह च देवेशं नारायणमजो हरिम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003300038, "chapter_id": 23300, "verse_number": "१-१०३-३९", "content_sanskrit": "भवानग्रे समुत्पन्नो भवान्या सह दैवतैः  ।\nवामांगादस्य रुद्रस्य दक्षिणांगादहं प्रभो ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003300039, "chapter_id": 23300, "verse_number": "१-१०३-४०", "content_sanskrit": "मन्मूर्तिस्तुहिनाद्रीशो यज्ञार्थं सृष्ट एव हि  ।\nएषा हैमवती जज्ञे मायया परमेष्ठिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003300040, "chapter_id": 23300, "verse_number": "१-१०३-४१", "content_sanskrit": "श्रौतस्मार्तप्रवृत्त्यर्थमुद्वाहार्थमिहागतः  ।\nअतोसौ जगतां धात्री धाता तव ममापि च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003300041, "chapter_id": 23300, "verse_number": "१-१०३-४२", "content_sanskrit": "अस्य देवस्य रुद्रस्य मूर्तिभिर्विहितं जगत्  ।\nक्ष्माबग्निखेंदुसूर्यात्मपवनात्मा यतो भवः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003300042, "chapter_id": 23300, "verse_number": "१-१०३-४३", "content_sanskrit": "तथापि तस्मै दातव्या वचनाच्च गिरेर्मम  ।\nएषा ह्यजा शुक्लकृष्णा लोहिता प्रकृतिर्भवान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003300043, "chapter_id": 23300, "verse_number": "१-१०३-४४", "content_sanskrit": "श्रेयोपि शैलराजेन संबंधोऽयं तवापि च  ।\nतव पाद्मे समुद्भूतः कल्पे नाभ्यंबुजादहम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003300044, "chapter_id": 23300, "verse_number": "१-१०३-४५", "content_sanskrit": "मदंशस्यास्य शैलस्य ममापि च गुरुर्भवान्  ।\nसूत उवाच  ।\nबाढमित्यजमाहासौ देवदेवो जनार्दनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003300045, "chapter_id": 23300, "verse_number": "१-१०३-४६", "content_sanskrit": "देवाश्च मुनयः सर्वे देवदेवश्च शंकरः  ।\nततश्चोत्थाय विद्वान्सः पद्मनाभः प्रणम्य ताम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003300046, "chapter_id": 23300, "verse_number": "१-१०३-४७", "content_sanskrit": "पादौ प्रक्षाल्य देवस्य कराभ्यां कमलेक्षणः  ।\nअभ्युक्षदात्मनो मूर्ध्नि ब्रह्मणश्च गिरेस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003300047, "chapter_id": 23300, "verse_number": "१-१०३-४८", "content_sanskrit": "त्वदीयैषा विवाहार्थं मेनजा ह्यनुजा मम  ।\nइत्युक्त्वा सोदकं दत्वा देवीं देवेश्वराय ताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003300048, "chapter_id": 23300, "verse_number": "१-१०३-४९", "content_sanskrit": "स्वात्मानमपि देवाय सोदकं प्रददौ हरिः  ।\nअथ सर्वे मुनिश्रेष्ठाः सर्ववेदार्थपारगाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003300049, "chapter_id": 23300, "verse_number": "१-१०३-५०", "content_sanskrit": "ऊचुर्दाता गृहीता च फलं द्रव्यं विचारतः  ।\nएष देवो हरो नूनं मायया हि ततो जगत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003300050, "chapter_id": 23300, "verse_number": "१-१०३-५१", "content_sanskrit": "इत्युक्त्वा तं प्रणेमुश्च प्रीतिकंटाकितत्वचः  ।\nससृजुः पुष्पवर्षाणि खेचराः सिद्धचारणाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003300051, "chapter_id": 23300, "verse_number": "१-१०३-५२", "content_sanskrit": "देवदुंदुभयो नेदुर्ननृतुश्चाप्सरोगणाः  ।\nवेदाश्च मूर्तिमंतस्ते प्रणेमुस्तं महेश्वरम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003300052, "chapter_id": 23300, "verse_number": "१-१०३-५३", "content_sanskrit": "ब्रह्मणा मुनिभिः सार्धं देवदेवमुमापतिम्  ।\nदेवोपि देवीमालोक्य सलज्जां हिमशैलजाम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003300053, "chapter_id": 23300, "verse_number": "१-१०३-५४", "content_sanskrit": "न तृप्यत्यनवद्यांगी सा च देवं वृषध्वजम्  ।\nवरदोस्मीति तं प्राह हरिं सोप्याह शंकरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003300054, "chapter_id": 23300, "verse_number": "१-१०३-५५", "content_sanskrit": "त्वयि भक्तिः प्रसीदेति ब्रह्माख्यां च ददौ तु सः  ।\nततस्तु पुनरेवाह ब्रह्मा विज्ञापयन्प्रभुम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003300055, "chapter_id": 23300, "verse_number": "१-१०३-५६", "content_sanskrit": "हविर्जुहोमि वह्नौ तु उपाध्यायपदे स्थितः  ।\nददासि मम यद्याज्ञां कर्त्तव्यो ह्यकृतो विधिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003300056, "chapter_id": 23300, "verse_number": "१-१०३-५७", "content_sanskrit": "तमाह शंकरो देवं देवदेवो जगत्पतिः  ।\nयद्यदिष्टं सुरश्रेष्ठ तत्कुरुष्व यथेप्सितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003300057, "chapter_id": 23300, "verse_number": "१-१०३-५८", "content_sanskrit": "कर्त्तास्मि वचनं सर्वं देवदेव पितामह  ।\nततः प्रणम्य हृष्टामा ब्रह्मा लोकपितामहः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003300058, "chapter_id": 23300, "verse_number": "१-१०३-५९", "content_sanskrit": "हस्तं देवस्य देव्याश्च युयोज परमं प्रभुः  ।\nज्वलनश्च स्वयं तत्र कृतांजलिरुपस्थितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003300059, "chapter_id": 23300, "verse_number": "१-१०३-६०", "content_sanskrit": "श्रौतैरेतैर्महामंत्रैर्मूर्तिमद्भिरुपस्थितैः  ।\nयथोक्तविधिना हुत्वा लाजानपि यताक्रमम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003300060, "chapter_id": 23300, "verse_number": "१-१०३-६१", "content_sanskrit": "आनीतान्विष्णुना विप्रासंपूज्य विविधैर्वरैः  ।\nत्रिश्च तं ज्वलनं देवं कारयित्वा प्रदक्षिणम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003300061, "chapter_id": 23300, "verse_number": "१-१०३-६२", "content_sanskrit": "मुक्त्वा हस्तसमायोगं सहितैः सर्वदैवतैः  ।\nसुरैश्च मानवैः सर्वैः प्रहृष्टेनांतरात्मना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003300062, "chapter_id": 23300, "verse_number": "१-१०३-६३", "content_sanskrit": "ननाम भगवान्ब्रह्मा देवदेवमुमापतिम्  ।\nततः पाद्यं तयोर्दत्वा शंभोराचमनं तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003300063, "chapter_id": 23300, "verse_number": "१-१०३-६४", "content_sanskrit": "मधुपर्कं तथा गां च प्रणम्य च पुनः शिवम्  ।\nअतिष्ठद्भगवान्ब्रह्मा देवैरिन्द्रपुरोगमैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003300064, "chapter_id": 23300, "verse_number": "१-१०३-६५", "content_sanskrit": "भृग्वाद्य मुनयः सर्वे चाक्षतैस्तिलतंडुलैः  ।\nसूर्यादयः समभ्यर्च्य तुष्टुवुर्वृषभध्वजम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003300065, "chapter_id": 23300, "verse_number": "१-१०३-६६", "content_sanskrit": "शिवः समाप्य देवोक्तं वह्निमारोप्य चात्मनि  ।\nतया समागतो रुद्रः सर्वलोकहिताय वै ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003300066, "chapter_id": 23300, "verse_number": "१-१०३-६७", "content_sanskrit": "यः पठेच्छृणुयाद्वापि भवोद्वाहं शुचिस्मितः  ।\nश्रावयेद्वा द्विजाञ्छुद्धान्वेदवेदांगपारगान् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003300067, "chapter_id": 23300, "verse_number": "१-१०३-६८", "content_sanskrit": "स लब्ध्वा गाणपत्यं च भवेन सह मोदते  ।\nयत्रायं कीर्त्यते विप्रैस्तावदास्ते तदा भवः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003300068, "chapter_id": 23300, "verse_number": "१-१०३-६९", "content_sanskrit": "तस्मात्संपूज्य विधिवत्कीर्तयेन्नायथा द्विजाः  ।\nउद्वाहे च द्विजेंद्राणां क्षत्रियाणां द्विजोत्तमाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003300069, "chapter_id": 23300, "verse_number": "१-१०३-७०", "content_sanskrit": "कीर्तनीयमिदं सर्वं भवोद्वाहमनुत्तमम्  ।\nकृतोद्वाहस्तदा देव्या हैमवत्या वृषध्वजः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003300070, "chapter_id": 23300, "verse_number": "१-१०३-७१", "content_sanskrit": "सगणो नंदिना सार्धं सर्वदेवगणैर्वृतः  ।\nपुरीं वाराणसीं दिव्यामाजगाम महाद्युतिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003300071, "chapter_id": 23300, "verse_number": "१-१०३-७२", "content_sanskrit": "अविमुक्ते सुखासीनं प्रणम्य वृषभध्वजम्  ।\nअपृच्छत्क्षेत्रमाहात्म्यं भवानी हर्षितानना ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003300072, "chapter_id": 23300, "verse_number": "१-१०३-७३", "content_sanskrit": "अथाहार्धेन्दुतिलकः क्षेत्रमाहात्म्यमुत्तमम्  ।\nअविमुक्तस्य माहात्म्यं विस्तराच्छक्यते नहि ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003300073, "chapter_id": 23300, "verse_number": "१-१०३-७४", "content_sanskrit": "वक्तुं मया सुरेशानि ऋषिसंघाभिपूजितम्  ।\nकिं मया वर्ण्यते देवी ह्यविमुक्तफलोदयः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003300074, "chapter_id": 23300, "verse_number": "१-१०३-७५", "content_sanskrit": "पापिनां यत्र मुक्तिः स्यान्मृतानामेकजन्मना  ।\nअन्यत्र तु कृतं पापं वाराणस्यां व्यपोहति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003300075, "chapter_id": 23300, "verse_number": "१-१०३-७६", "content_sanskrit": "वाराणस्यां कृतं पापं पैशाच्यनरकावहम्  ।\nकृत्वा पापसहस्राणि पिशाचत्वं वरं नृणाम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003300076, "chapter_id": 23300, "verse_number": "१-१०३-७७", "content_sanskrit": "न तु शक्रसहस्रत्वं स्वर्गे काशीपुरीं विना  ।\nयत्र त्रिविष्टपो देवो यत्र विश्वेश्वरो विभुः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003300077, "chapter_id": 23300, "verse_number": "१-१०३-७८", "content_sanskrit": "ओंकारेशः कृत्तिवासा मृतानां न पुनर्भवः  ।\nउक्त्वा क्षेत्रस्य माहात्म्यं संक्षेपाच्छशिशेखरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003300078, "chapter_id": 23300, "verse_number": "१-१०३-७९", "content_sanskrit": "दर्शयामास चोद्यानं परित्यज्य गणेश्वरान्  ।\nतत्रैव भगवान् जातो गजवक्त्रो विनायकः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003300079, "chapter_id": 23300, "verse_number": "१-१०३-८०", "content_sanskrit": "दैत्यानां विघ्नरूपार्थमविघ्नाय दिवौकसाम्  ।\nएतद्वः कथितं सर्वं कथासर्वस्वमुत्तमम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003300080, "chapter_id": 23300, "verse_number": "१-१०३-८१", "content_sanskrit": "यथाश्रुतं मया सर्वं प्रसादाद्वः सुशोभनम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]