[{"id": 2203505, "chapter_id": 5340, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203506, "chapter_id": 5340, "verse_number": "१", "content_sanskrit": "भवतां दर्शनादेव प्रीतिरभ्यधिका मम ।\nभवन्तस्तु तपःसिद्धा भवन्तो देवदर्शनाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203507, "chapter_id": 5340, "verse_number": "२", "content_sanskrit": "सर्वत्र गतिमन्तश्च ज्ञानविज्ञानभाविताः ।\nगत्यागतज्ञा लोकानां सर्वे निर्धूतकल्मषाः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203508, "chapter_id": 5340, "verse_number": "३", "content_sanskrit": "तस्माद् भवद्भिर्यत् किञ्चिद् दृष्टं वाऽप्यथवा श्रुतम् ।\nआश्चर्यभूतं लोकेषु तद् भवन्तो ब्रुवन्तु मे\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203509, "chapter_id": 5340, "verse_number": "४", "content_sanskrit": "युष्माभिः कथितं यत् स्यात् तपसा भावितात्मभिः ।\nतत् स्यादमृतसङ्काशं वाङ्मधुश्रवणे स्पृहा\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203510, "chapter_id": 5340, "verse_number": "५", "content_sanskrit": "रागद्वेषवियुक्तानां सततं सत्यवादिनाम् ।\nश्रद्धेयं श्रवणीयं च वचनं हि सतां भवेत्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203511, "chapter_id": 5340, "verse_number": "६", "content_sanskrit": "तत्संयोगं हि तन्मेऽस्तु न वृथा कर्तुमर्हथ ।\nभवतां दर्शनं तस्मात् सफलं तु भवेन्मम\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203512, "chapter_id": 5340, "verse_number": "७", "content_sanskrit": "तदहं सज्जनमुखान्निःसृतं जनसंसदि ।\nकथयिष्याम्यहरहो बुद्धिदीपकरं नृणाम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203513, "chapter_id": 5340, "verse_number": "८", "content_sanskrit": "तदन्ये वर्धयिष्यन्ति पूजयिष्यन्ति वापरे ।\nवाक्शल्यविगताश्चान्ये प्रशंसन्ति पुरातनाः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203514, "chapter_id": 5340, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203515, "chapter_id": 5340, "verse_number": "९", "content_sanskrit": "एवं ब्रुवति गोविन्दे श्रवणार्थं महर्षयः ।\nवाग्भिः साञ्जलिमालाभिरिदमूचुर्जनार्दनम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203516, "chapter_id": 5340, "verse_number": "१०", "content_sanskrit": "अयुक्तमस्मानेवं त्वं वाचा वरद भाषितुम् ।\nत्वच्छासनमुखाः सर्वे त्वदधीनपरिश्रमाः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203517, "chapter_id": 5340, "verse_number": "११", "content_sanskrit": "एवं पूजयितुं चास्मान् न चैवार्हसि केशव ।\nतद्वस्त्वन्यन्न पश्यामो यल्लोके ते न विद्यते ।\nदिवि वा भुवि वा किञ्चित् तत्सर्वं हि त्वया ततम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203518, "chapter_id": 5340, "verse_number": "१२", "content_sanskrit": "न विद्महे वयं देव कथ्यमानं तवान्तिके ।\nएवमुक्तो हृषीकेशः सस्मितं चेदमब्रवीत्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203519, "chapter_id": 5340, "verse_number": "१३", "content_sanskrit": "अहं मानुषयोनिस्थः साम्प्रतं मुनिपुङ्गवाः ।\nतस्मान्मानुषवद् वीर्यं मम जानीत सुव्रताः ।\nभवद्भिः कथ्यमानं च अपूर्वमिव तद् भवेत्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203520, "chapter_id": 5340, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203521, "chapter_id": 5340, "verse_number": "१४", "content_sanskrit": "एवं सञ्चोदिताः सर्वे केशवेन महात्मना ।\nऋषयश्चानुवर्तन्ते वासुदेवस्य शासनम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203522, "chapter_id": 5340, "verse_number": "१५", "content_sanskrit": "ततस्त्वृषिगणाः सर्वे नारदं देवदर्शनम् ।\nअमन्यन्त बुधा बुद्ध्या समर्थं तन्निबोधने\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203523, "chapter_id": 5340, "verse_number": "१६", "content_sanskrit": "ऋषिरुग्रतपाश्चायं केशवस्य प्रियोऽधिकम् ।\nपुराणज्ञश्च वाग्मी च कारणैस्तं च मेनिरे\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203524, "chapter_id": 5340, "verse_number": "१७", "content_sanskrit": "सर्वे तदर्हणं कृत्वा नारदं वाक्यमब्रुवन्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203525, "chapter_id": 5340, "verse_number": "१८", "content_sanskrit": "भवता तीर्थयात्रार्थं चरता हिमवद्गिरौ ।\nदृष्टं वै यत् तदाश्चर्यं श्रोतॄणां परमं प्रियम्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203526, "chapter_id": 5340, "verse_number": "१९", "content_sanskrit": "तत्त्वं त्वमविशेषेण हितार्थं सर्वमादितः ।\nप्रियार्थं केशवस्यास्य स भवान् वक्तुमर्हति\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203527, "chapter_id": 5340, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203528, "chapter_id": 5340, "verse_number": "२०", "content_sanskrit": "तदा सञ्चोदितः सर्वैर्ऋषिभिर्नारदस्तदा ।\nप्रणम्य शिरसा विष्णुं सर्वलोकहिते रतम् ।\nसमुद्वीक्ष्य हृषीकेशं वक्तुमेवोपचक्रमे\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203529, "chapter_id": 5340, "verse_number": "२१", "content_sanskrit": "ततो नारायणसुहृन्नारदो वदतांवरः ।\nशङ्करस्योमया सार्धं संवादमनुभाषत\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203530, "chapter_id": 5340, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे ऋषिकेशवसंवादो नाम एकनवत्युत्तरशततमोऽध्यायः ॥१९१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]