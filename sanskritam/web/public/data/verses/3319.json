[{"id": 2106794, "chapter_id": 3319, "verse_number": "१८-४-१", "content_sanskrit": "वैशम्पायन उवाच\nततो युधिष्ठिरो राजा देवैः सर्षिमरुद्गणैः।\nस्तूयमानो ययौ तत्र यत्र ते कुरुपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106795, "chapter_id": 3319, "verse_number": "१८-४-२", "content_sanskrit": "ददर्श तत्र गोविन्दं ब्राह्मेण वपुषाऽन्वितम्।\nतेनैव दृष्टपूर्वेण सादृश्येनैव सूचितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106796, "chapter_id": 3319, "verse_number": "१८-४-३", "content_sanskrit": "दीप्यमानं स्ववपुषा दिव्यैरस्त्रैरुपस्थितम्।\nचक्रप्रभृतिभिर्घोरैर्दिव्यैः पुरुषविग्रहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106797, "chapter_id": 3319, "verse_number": "१८-४-४", "content_sanskrit": "उपास्यमानं वीरेण फल्गुनेन सुवर्चसा।\nतथास्वरूपं कौन्तेयो ददर्श मधुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106798, "chapter_id": 3319, "verse_number": "१८-४-५", "content_sanskrit": "तावुभौ पुरुषव्याघ्रौ समुद्वीक्ष्य युधिष्ठिरम्।\nयथावत्प्रतिपेदाते पूजया देवपूजितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106799, "chapter_id": 3319, "verse_number": "१८-४-६", "content_sanskrit": "अपरस्मिन्नथोद्देशे कर्णं शस्त्रभृतां वरम्।\nद्वादशादित्यसहितं ददर्श कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106800, "chapter_id": 3319, "verse_number": "१८-४-७", "content_sanskrit": "अथापरस्मिन्नुद्देशे मरुद्गणवृतं विभुम्।\nभीमसेनमथापश्यत्तेनैव वपुषाऽन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106801, "chapter_id": 3319, "verse_number": "१८-४-८", "content_sanskrit": "वायोर्मूर्तिमतः पार्श्वे दिव्यमूर्तिसमन्वितम्।\nश्रिया परमया युक्तं सिद्धिं परमिकां गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106802, "chapter_id": 3319, "verse_number": "१८-४-९", "content_sanskrit": "अश्विनोस्तु तथा स्थाने दीप्यमानौ स्वतेजसा।\nनकुलं सहदेवं च ददर्श कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106803, "chapter_id": 3319, "verse_number": "१८-४-१०", "content_sanskrit": "तथा ददर्श पाञ्चालीं कमलोत्पलमालिनीम्।\nवपुषा स्वर्गमाक्रम्य तिष्ठन्तीमर्कवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106804, "chapter_id": 3319, "verse_number": "१८-४-११", "content_sanskrit": "तत्रैनां सहसा राजा स्प्रष्टुमैच्छद्युधिष्ठिरः।\nततोऽस्य भगवानिन्द्रः कथयामास देवराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106805, "chapter_id": 3319, "verse_number": "१८-४-१२", "content_sanskrit": "श्रीरेषा द्रौपदीरूपा त्वदर्थे मानुषं गता।\nअयोनिजा लोककान्ता पुण्यगन्धा युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106806, "chapter_id": 3319, "verse_number": "१८-४-१३", "content_sanskrit": "रत्यर्थं भवतां ह्येषा निर्मिता शूलपाणिना।\nद्रुपदस्य कुले जाता भवद्भिश्चोपजीविता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106807, "chapter_id": 3319, "verse_number": "१८-४-१४", "content_sanskrit": "एते पञ्च महाभागा गन्धर्वाः पावकप्रभाः।\nद्रौपद्यास्तनया राजन्युष्माकममितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106808, "chapter_id": 3319, "verse_number": "१८-४-१५", "content_sanskrit": "पश्य गन्धर्वराजानं धृतराष्ट्रं मनीषिणम्।\nएनं च त्वं विजानीहि भ्रातरं पूर्वजं पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106809, "chapter_id": 3319, "verse_number": "१८-४-१६", "content_sanskrit": "अयं ते पूर्वजो भ्राता कौन्तेयः पावकद्युतिः।\nसूर्यपुत्रो रथिश्रेष्ठो राधेय इति विश्रुतः।\nआदित्यसहितो भाति पश्यैनं पुरुषर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106810, "chapter_id": 3319, "verse_number": "१८-४-१७", "content_sanskrit": "साध्यानामथ देवानां विश्वेषां मरुतामपि।\nगणेषु पश्य राजेन्द्र वृष्णन्धकमहारथान्।\nसात्यकिप्रमुखान्वीरान्भोजांश्चैव महाबलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106811, "chapter_id": 3319, "verse_number": "१८-४-१८", "content_sanskrit": "सोमेन सहितं पश्य सौभद्रमपराजितम्।\nअभिमन्युं महेष्वासं निशाकरसमद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106812, "chapter_id": 3319, "verse_number": "१८-४-१९", "content_sanskrit": "एष पाण्डुर्महेष्वासः कुन्त्या माद्र्या च सङ्गतः।\nविमानेन सदाऽभ्येति पिता तव ममान्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106813, "chapter_id": 3319, "verse_number": "१८-४-२०", "content_sanskrit": "वसुभिः सहितं पश्य भीष्मं शान्तनवं नृपम्।\nद्रोणं बृहस्पतेः पार्श्वे गुरुमेनं निशामय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106814, "chapter_id": 3319, "verse_number": "१८-४-२१", "content_sanskrit": "एते चान्ये महीपाला योधास्तव च पाण्डव।\nगन्धर्वसहिता यान्ति यक्षपुण्यजनैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106815, "chapter_id": 3319, "verse_number": "१८-४-२२", "content_sanskrit": "गुह्यकानां गतिं चापि केचित्प्राप्ता नराधिपाः।\nत्यक्त्वा देहं जितः स्वर्गः पुण्यवाग्बुद्धिकर्मभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106816, "chapter_id": 3319, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्वार्गारोहणपर्वणि चतुर्थोऽध्यायः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]