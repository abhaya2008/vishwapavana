[{"id": 5000496000, "chapter_id": 9496, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोननवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000496001, "chapter_id": 9496, "verse_number": "६-८९-१", "content_sanskrit": "युध्यमानौ ततो दृष्ट्वा प्रसक्तौ नरराक्षसौ।\nप्रभिन्नाविव मातङ्गौ परस्परजयैषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000496002, "chapter_id": 9496, "verse_number": "६-८९-२", "content_sanskrit": "तयोर्युद्धं द्रष्टुकामो वरचापधरो बली।\nशूरः स रावणभ्राता तस्थौ संग्राममूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000496003, "chapter_id": 9496, "verse_number": "६-८९-३", "content_sanskrit": "ततो विस्फारयामास महद् धनुरवस्थितः।\nउत्ससर्ज च तीक्ष्णाग्रान् राक्षसेषु महाशरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000496004, "chapter_id": 9496, "verse_number": "६-८९-४", "content_sanskrit": "ते शराः शिखिसंस्पर्शा निपतन्तः समाहिताः।\nराक्षसान् द्रावयामासुर्वज्राणीव महागिरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000496005, "chapter_id": 9496, "verse_number": "६-८९-५", "content_sanskrit": "विभीषणस्यानुचरास्तेऽपि शूलासिपट्टिशैः।\nचिच्छिदुः समरे वीरान् राक्षसान् राक्षसोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000496006, "chapter_id": 9496, "verse_number": "६-८९-६", "content_sanskrit": "राक्षसैस्तैः परिवृतः स तदा तु विभीषणः।\nबभौ मध्ये प्रधृष्टानां कलभानामिव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000496007, "chapter_id": 9496, "verse_number": "६-८९-७", "content_sanskrit": "ततः संचोदमानो वै हरीन् रक्षोवधप्रियान्।\nउवाच वचनं काले कालज्ञो रक्षसां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000496008, "chapter_id": 9496, "verse_number": "६-८९-८", "content_sanskrit": "एकोऽयं राक्षसेन्द्रस्य परायणमवस्थितः।\nएतच्छेषं बलं तस्य किं तिष्ठत हरीश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000496009, "chapter_id": 9496, "verse_number": "६-८९-९", "content_sanskrit": "अस्मिंश्च निहते पापे राक्षसे रणमूर्धनि।\nरावणं वर्जयित्वा तु शेषमस्य बलं हतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000496010, "chapter_id": 9496, "verse_number": "६-८९-१०", "content_sanskrit": "प्रहस्तो निहतो वीरो निकुम्भश्च महाबलः।\nकुम्भकर्णश्च कुम्भश्च धूम्राक्षश्च निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000496011, "chapter_id": 9496, "verse_number": "६-८९-११", "content_sanskrit": "जम्बुमाली महामाली तीक्ष्णवेगोऽशनिप्रभः।\nसुप्तघ्नो यज्ञकोपश्च वज्रदंष्ट्रश्च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000496012, "chapter_id": 9496, "verse_number": "६-८९-१२", "content_sanskrit": "संह्रादी विकटोऽरिघ्नस्तपनो मन्द एव च।\nप्रघासः प्रघसश्चैव प्रजङ्घो जङ्घ एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000496013, "chapter_id": 9496, "verse_number": "६-८९-१३", "content_sanskrit": "अग्निकेतुश्च दुर्धर्षो रश्मिकेतुश्च वीर्यवान्।\nविद्युज्जिह्वो द्विजिह्वश्च सूर्यशत्रुश्च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000496014, "chapter_id": 9496, "verse_number": "६-८९-१४", "content_sanskrit": "अकम्पनः सुपार्श्वश्च चक्रमाली च राक्षसः।\nकम्पनः सत्त्ववन्तौ तौ देवान्तकनरान्तकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000496015, "chapter_id": 9496, "verse_number": "६-८९-१५", "content_sanskrit": "एतान् निहत्यातिबलान् बहून् राक्षससत्तमान्।\nबाहुभ्यां सागरं तीर्त्वा लङ्‍घ्यतां गोष्पदं लघु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000496016, "chapter_id": 9496, "verse_number": "६-८९-१६", "content_sanskrit": "एतावदेव शेषं वो जेतव्यमिति वानराः।\nहताः सर्वे समागम्य राक्षसा बलदर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000496017, "chapter_id": 9496, "verse_number": "६-८९-१७", "content_sanskrit": "अयुक्तं निधनं कर्तुं पुत्रस्य जनितुर्मम।\nघृणामपास्य रामार्थे निहन्यां भ्रातुरात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000496018, "chapter_id": 9496, "verse_number": "६-८९-१८", "content_sanskrit": "हन्तुकामस्य मे बाष्पं चक्षुश्चैव निरुध्यति।\nतमेवैष महाबाहुर्लक्ष्मणः शमयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000496019, "chapter_id": 9496, "verse_number": "६-८९-१९", "content_sanskrit": "वानरा घ्नत सम्भूय भृत्यानस्य समीपगान्।\nइति तेनातियशसा राक्षसेनाभिचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000496020, "chapter_id": 9496, "verse_number": "६-८९-२०", "content_sanskrit": "वानरेन्द्रा जहृषिरे लाङ्गूलानि च विव्यधुः।\nततस्तु कपिशार्दूलाः क्ष्वेडन्तश्च पुनः पुनः।\nमुमुचुर्विविधान् नादान् मेघान् दृष्ट्वेव बर्हिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000496021, "chapter_id": 9496, "verse_number": "६-८९-२१", "content_sanskrit": "जाम्बवानपि तैः सर्वैः स्वयूथ्यैरभिसंवृतः।\nतेऽश्मभिस्ताडयामासुर्नखैर्दन्तैश्च राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000496022, "chapter_id": 9496, "verse_number": "६-८९-२२", "content_sanskrit": "निघ्नन्तमृक्षाधिपतिं राक्षसास्ते महाबलाः।\nपरिवव्रुर्भयं त्यक्त्वा तमनेकविधायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000496023, "chapter_id": 9496, "verse_number": "६-८९-२३", "content_sanskrit": "शरैः परशुभिस्तीक्ष्णैः पट्टिशैर्यष्टितोमरैः।\nजाम्बवन्तं मृधे जघ्नुर्निघ्नन्तं राक्षसीं चमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000496024, "chapter_id": 9496, "verse_number": "६-८९-२४", "content_sanskrit": "स सम्प्रहारस्तुमुलः संजज्ञे कपिरक्षसाम्।\nदेवासुराणां क्रुद्धानां यथा भीमो महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000496025, "chapter_id": 9496, "verse_number": "६-८९-२५", "content_sanskrit": "हनूमानपि संक्रुद्धः सालमुत्पाट्य पर्वतात्।\nस लक्ष्मणं स्वयं पृष्ठादवरोप्य महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000496026, "chapter_id": 9496, "verse_number": "६-८९-२६", "content_sanskrit": "रक्षसां कदनं चक्रे दुरासादः सहस्रशः।\nस दत्त्वा तुमुलं युद्धं पितृव्यस्येन्द्रजिद् बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000496027, "chapter_id": 9496, "verse_number": "६-८९-२७", "content_sanskrit": "लक्ष्मणं परवीरघ्नः पुनरेवाभ्यधावत।\nतौ प्रयुद्धौ तदा वीरौ मृधे लक्ष्मणराक्षसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000496028, "chapter_id": 9496, "verse_number": "६-८९-२८", "content_sanskrit": "शरौघानभिवर्षन्तौ जघ्नतुस्तौ परस्परम्।\nअभीक्ष्णमन्तर्दधतुः शरजालैर्महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000496029, "chapter_id": 9496, "verse_number": "६-८९-२९", "content_sanskrit": "चन्द्रादित्याविवोष्णान्ते यथा मेघैस्तरस्विनौ।\nनह्यादानं न संधानं धनुषो वा परिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000496030, "chapter_id": 9496, "verse_number": "६-८९-३०", "content_sanskrit": "न विप्रमोक्षो बाणानां न विकर्षो न विग्रहः।\nन मुष्टिप्रतिसंधानं न लक्ष्यप्रतिपादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000496031, "chapter_id": 9496, "verse_number": "६-८९-३१", "content_sanskrit": "अदृश्यत तयोस्तत्र युध्यतोः पाणिलाघवात्।\nचापवेगप्रयुक्तैश्च बाणजालैः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000496032, "chapter_id": 9496, "verse_number": "६-८९-३२", "content_sanskrit": "अन्तरिक्षेऽभिसम्पन्ने न रूपाणि चकाशिरे।\nलक्ष्मणो रावणिं प्राप्य रावणिश्चापि लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000496033, "chapter_id": 9496, "verse_number": "६-८९-३३", "content_sanskrit": "अव्यवस्था भवत्युग्रा ताभ्यामन्योन्यविग्रहे।\nताभ्यामुभाभ्यां तरसा प्रसृष्टैर्विशिखैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000496034, "chapter_id": 9496, "verse_number": "६-८९-३४", "content_sanskrit": "निरन्तरमिवाकाशं बभूव तमसा वृतम्।\nतैः पतद्भिश्च बहुभिस्तयोः शरशतैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000496035, "chapter_id": 9496, "verse_number": "६-८९-३५", "content_sanskrit": "दिशश्च प्रदिशश्चैव बभूवुः शरसंकुलाः।\nतमसा पिहितं सर्वमासीत् प्रतिभयं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000496036, "chapter_id": 9496, "verse_number": "६-८९-३६", "content_sanskrit": "अस्तं गते सहस्रांशौ संवृते तमसा च वै।\nरुधिरौघा महानद्यः प्रावर्तन्त सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000496037, "chapter_id": 9496, "verse_number": "६-८९-३७", "content_sanskrit": "क्रव्यादा दारुणा वाग्भिश्चिक्षिपुर्भीमनिःस्वनान्।\nन तदानीं ववौ वायुर्न च जज्वाल पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000496038, "chapter_id": 9496, "verse_number": "६-८९-३८", "content_sanskrit": "स्वस्त्यस्तु लोकेभ्य इति जजल्पुस्ते महर्षयः।\nसम्पेतुश्चात्र संतप्ता गन्धर्वाः सह चारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000496039, "chapter_id": 9496, "verse_number": "६-८९-३९", "content_sanskrit": "अथ राक्षससिंहस्य कृष्णान् कनकभूषणान्।\nशरैश्चतुर्भिः सौमित्रिर्विव्याध चतुरो हयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000496040, "chapter_id": 9496, "verse_number": "६-८९-४०", "content_sanskrit": "ततोऽपरेण भल्लेन पीतेन निशितेन च।\nसम्पूर्णायतमुक्तेन सुपत्रेण सुवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000496041, "chapter_id": 9496, "verse_number": "६-८९-४१", "content_sanskrit": "महेन्द्राशनिकल्पेन सूतस्य विचरिष्यतः।\nस तेन बाणाशनिना तलशब्दानुनादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000496042, "chapter_id": 9496, "verse_number": "६-८९-४२", "content_sanskrit": "लाघवाद् राघवः श्रीमान् शिरः कायादपाहरत्।\nस यन्तरि महातेजा हते मन्दोदरीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000496043, "chapter_id": 9496, "verse_number": "६-८९-४३", "content_sanskrit": "स्वयं सारथ्यमकरोत् पुनश्च धनुरस्पृशत्।\nतदद्भुतमभूत् तत्र सारथ्यं पश्यतां युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000496044, "chapter_id": 9496, "verse_number": "६-८९-४४", "content_sanskrit": "हयेषु व्यग्रहस्तं तं विव्याध निशितैः शरैः।\nधनुष्यथ पुनर्व्यग्रं हयेषु मुमुचे शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000496045, "chapter_id": 9496, "verse_number": "६-८९-४५", "content_sanskrit": "छिद्रेषु तेषु बाणौघैर्विचरन्तमभीतवत्।\nअर्दयामास समरे सौमित्रिः शीघ्रकृत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000496046, "chapter_id": 9496, "verse_number": "६-८९-४६", "content_sanskrit": "निहतं सारथिं दृष्ट्वा समरे रावणात्मजः।\nप्रजहौ समरोद्धर्षं विषण्णः स बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000496047, "chapter_id": 9496, "verse_number": "६-८९-४७", "content_sanskrit": "विषण्णवदनं दृष्ट्वा राक्षसं हरियूथपाः।\nततः परमसंहृष्टा लक्ष्मणं चाभ्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000496048, "chapter_id": 9496, "verse_number": "६-८९-४८", "content_sanskrit": "ततः प्रमाथी रभसः शरभो गन्धमादनः।\nअमृष्यमाणाश्चत्वारश्चक्रुर्वेगं हरीश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000496049, "chapter_id": 9496, "verse_number": "६-८९-४९", "content_sanskrit": "ते चास्य हयमुख्येषु तूर्णमुत्पत्य वानराः।\nचतुर्षु सुमहावीर्या निपेतुर्भीमविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000496050, "chapter_id": 9496, "verse_number": "६-८९-५०", "content_sanskrit": "तेषामधिष्ठितानां तैर्वानरैः पर्वतोपमैः।\nमुखेभ्यो रुधिरं व्यक्तं हयानां समवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000496051, "chapter_id": 9496, "verse_number": "६-८९-५१", "content_sanskrit": "ते हया मथिता भग्ना व्यसवो धरणीं गताः।\nते निहत्य हयांस्तस्य प्रमथ्य च महारथम्।\nपुनरुत्पत्य वेगेन तस्थुर्लक्ष्मणपार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000496052, "chapter_id": 9496, "verse_number": "६-८९-५२", "content_sanskrit": "स हताश्वादवप्लुत्य रथान्मथितसारथिः।\nशरवर्षेण सौमित्रिमभ्यधावत रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000496053, "chapter_id": 9496, "verse_number": "६-८९-५३", "content_sanskrit": "ततो महेन्द्रप्रतिमः स लक्ष्मणः\nपदातिनं तं निहतैर्हयोत्तमैः।\nसृजन्तमाजौ निशितान् शरोत्तमान्\nभृशं तदा बाणगणैर्व्यदारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000496054, "chapter_id": 9496, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोननवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]