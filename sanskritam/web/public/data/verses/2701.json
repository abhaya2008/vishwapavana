[{"id": 2079893, "chapter_id": 2701, "verse_number": "१२-२०६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079894, "chapter_id": 2701, "verse_number": "१२-२०६-१", "content_sanskrit": "पितामह महाप्राज्ञ पुण़्डरीकाक्षमच्युतम्।\nकर्तारमकृतं विष्णुं भूतानां प्रभवाप्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079895, "chapter_id": 2701, "verse_number": "१२-२०६-२", "content_sanskrit": "नारायणं हृषीकेशं गोविन्दमपराजितम्।\nतत्त्वेन भरतश्रेष्ठ श्रोतुमिच्छामि केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079896, "chapter_id": 2701, "verse_number": "१२-२०६-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079897, "chapter_id": 2701, "verse_number": "१२-२०६-३", "content_sanskrit": "श्रुतोऽयमर्थो रामस्य जामदग्न्यस्य जल्पतः।\nनारदस्य च देवर्षेः कृष्णद्वैपायनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079898, "chapter_id": 2701, "verse_number": "१२-२०६-४", "content_sanskrit": "असितो देवलस्तात वाल्मीकिश्च महातपाः।\nमार्कण्डेयश्च गोविन्दे कथयन्त्यद्भुतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079899, "chapter_id": 2701, "verse_number": "१२-२०६-५", "content_sanskrit": "`केशवस्य मया राजन्न शक्या वर्णितुं गुणाः।\nईदृशोऽसौ हृषीकेशो वासुदेवः परात्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079900, "chapter_id": 2701, "verse_number": "१२-२०६-६", "content_sanskrit": "केशवो भरतश्रेष्ठ भगवानीश्वरः प्रभुः।\nपुरुषः सर्वमित्येव श्रूयते बहुधा विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079901, "chapter_id": 2701, "verse_number": "१२-२०६-७", "content_sanskrit": "किंतु यानि विदुर्लोके ब्राह्मणाः शार्ङ्गधन्वनि।\nमहात्मनि महाबाहो शृणु तानि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079902, "chapter_id": 2701, "verse_number": "१२-२०६-८", "content_sanskrit": "यानि चाहुर्मनुष्येन्द्र ये पुराणविदो जनाः।\nश्रुत्वा सर्वाणि गोविन्दो कीर्तयिष्यामि तान्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079903, "chapter_id": 2701, "verse_number": "१२-२०६-९", "content_sanskrit": "महाभूतानि भूतात्मा महात्मा पुरुषोत्तमः।\nवायुर्ज्योतिस्तथा चापः खं च गां चान्वकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079904, "chapter_id": 2701, "verse_number": "१२-२०६-१०", "content_sanskrit": "स सृष्ट्वा पृथिवीं चैव सर्वभूतेश्वरः प्रभुः।\nअप्स्वेव शयनं चक्रे महात्मा पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079905, "chapter_id": 2701, "verse_number": "१२-२०६-११", "content_sanskrit": "सर्वतेजोमयस्तस्मिञ्शयानः शयने शुभे।\nसोऽग्रजं सर्वभूतानां संकर्षणमचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079906, "chapter_id": 2701, "verse_number": "१२-२०६-१२", "content_sanskrit": "आश्रयं सर्वभूतानां मनसेतीह शुश्रुम्।\nस धारयति भूतानि उभे भूतभविष्यती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079907, "chapter_id": 2701, "verse_number": "१२-२०६-१३", "content_sanskrit": "`प्रद्युम्नमसृजत्तस्मात्सर्वतेजः प्रकाशकम्।\nअनिरुद्धस्ततो जज्ञे सर्वशक्तिर्महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079908, "chapter_id": 2701, "verse_number": "१२-२०६-१४", "content_sanskrit": "अप्सु व्योमगतः श्रीमान्योगनिद्रामुपेयिवान्।\nतस्मात्संजज्ञिरे देवा ब्रह्मविष्णुमहेश्वराः।\nलयस्थित्यन्तकर्माणस्रयस्ते सुमहौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079909, "chapter_id": 2701, "verse_number": "१२-२०६-१५", "content_sanskrit": "ततस्तस्मिन्महाबाहौ प्रादुर्भूते महात्मनि।\nभास्करप्रतिमं दिव्यं नाभ्यां पद्ममजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079910, "chapter_id": 2701, "verse_number": "१२-२०६-१६", "content_sanskrit": "स तत्र भगवान्देवः पुष्करे भ्राजयन्दिशः।\nब्रह्मा समभवत्तात सर्वभूतपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079911, "chapter_id": 2701, "verse_number": "१२-२०६-१७", "content_sanskrit": "तस्मिन्नपि महाबाहौ प्रादुर्भूते महात्मनि।\nतमसः पूर्वजो जज्ञे मधुर्नाम महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079912, "chapter_id": 2701, "verse_number": "१२-२०६-१८", "content_sanskrit": "तमुग्रमुग्रकर्माणमुग्रां बुद्धिं समास्थितम्।\nब्रह्मणोपचितिं कुर्वञ्जघान पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079913, "chapter_id": 2701, "verse_number": "१२-२०६-१९", "content_sanskrit": "तस्य तात वधात्सर्वे देवदानवमानवाः।\nमधुसूदनमित्याहुर्ऋषभं सर्वसात्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079914, "chapter_id": 2701, "verse_number": "१२-२०६-२०", "content_sanskrit": "ब्रह्माऽनुससृजे पुत्रान्मानसान्दक्षसप्तमान्।\nमरीचिमत्र्यङ्गिरसौ पुलस्त्यं पुलहं क्रतुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079915, "chapter_id": 2701, "verse_number": "१२-२०६-२१", "content_sanskrit": "मरीचिः कश्यपं तात पुत्रमग्रजमग्रजः।\nमानसं जनयामास तैजसं ब्रह्मवित्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079916, "chapter_id": 2701, "verse_number": "१२-२०६-२२", "content_sanskrit": "अङ्गुष्ठात्ससृजे ब्रह्मा मरीचेरपि पूर्वजम्।\nसोऽभवद्भरतश्रेष्ठ दक्षो नाम प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079917, "chapter_id": 2701, "verse_number": "१२-२०६-२३", "content_sanskrit": "तस्य पूर्वमजायन्त दश तिस्रश्च भारत॥\nप्रजापतेर्दुहितरस्तासां ज्येष्ठाऽभवद्दितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079918, "chapter_id": 2701, "verse_number": "१२-२०६-२४", "content_sanskrit": "सर्वधर्मविशेषज्ञः पुण्यकीर्तिर्महायशाः।\nमारीचः कश्यपस्तात सर्वासामभवत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079919, "chapter_id": 2701, "verse_number": "१२-२०६-२५", "content_sanskrit": "उत्पाद्य तु महाभागस्तासामवरजा दश।\nददौ धर्माय धर्मज्ञो दक्ष एव प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079920, "chapter_id": 2701, "verse_number": "१२-२०६-२६", "content_sanskrit": "धर्मस्य वसवः पुत्रा रुद्राश्चामिततेजसः।\nविश्वेदेवाश्च साध्याश्च मरुत्वन्तश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079921, "chapter_id": 2701, "verse_number": "१२-२०६-२७", "content_sanskrit": "अपराश्च यवीयस्यस्ताभ्योऽन्याः सप्तविंशतिः।\nसोमस्तासां महाभागः सर्वासामभवत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079922, "chapter_id": 2701, "verse_number": "१२-२०६-२८", "content_sanskrit": "इतरास्तु व्यजायन्त गन्धवोस्तुरगान्द्विजान्।\nगाश्च किंपुरुषान्मत्स्यानुद्भिज्जांश्च वनस्पतीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079923, "chapter_id": 2701, "verse_number": "१२-२०६-२९", "content_sanskrit": "आदित्यानदितिर्जज्ञे देवश्रेष्ठान्महाबलान्।\nतेषां विष्णुर्वामनोऽभूद्गोविन्दश्चाभवत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2079924, "chapter_id": 2701, "verse_number": "१२-२०६-३०", "content_sanskrit": "तस्य विक्रमणाच्चापि देवानां श्रीर्व्यवर्धत।\nदानवाश्च पराभूता दैतेयाश्चासुरी प्रजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2079925, "chapter_id": 2701, "verse_number": "१२-२०६-३१", "content_sanskrit": "विप्रचित्तिप्रधानांश्च दानवानसृजद्दनुः।\nदितिस्तु सर्वानसुरान्महासत्वानजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2079926, "chapter_id": 2701, "verse_number": "१२-२०६-३२", "content_sanskrit": "`ततः ससर्ज भगवान्मृत्युं लोकभयंकरम्।\nहर्तारं सर्व भूतानां ससर्ज च जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2079927, "chapter_id": 2701, "verse_number": "१२-२०६-३३", "content_sanskrit": "अहोरात्रं च कालं च यथर्तु मधुसूदनः।\nपूर्वाह्णं चापराह्णं च सर्वमेवान्वकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2079928, "chapter_id": 2701, "verse_number": "१२-२०६-३४", "content_sanskrit": "लब्ध्वापः सोऽसृजन्मेघांस्तथा स्थावरजङ्गमान्।\nपृथिवीं सोऽसृजद्विश्वां सहीतां भूरितेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2079929, "chapter_id": 2701, "verse_number": "१२-२०६-३५", "content_sanskrit": "ततः कृष्णो महाभागः पुनरेव युधिष्ठिर।\nब्राह्मणानां शतं श्रेष्ठं मुखादेवासृजत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2079930, "chapter_id": 2701, "verse_number": "१२-२०६-३६", "content_sanskrit": "बाहुभ्यां क्षत्रियशतं वैश्यानामूरुतः शतम्।\nपद्भ्यां शूत्रशतं चैव कशेवो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2079931, "chapter_id": 2701, "verse_number": "१२-२०६-३७", "content_sanskrit": "स एवं चतुरो वर्णान्समुत्पाद्य महातपाः।\nअध्यक्षं सर्व भूतानां धातारमकरोत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2079932, "chapter_id": 2701, "verse_number": "१२-२०६-३८", "content_sanskrit": "वेदविद्याविधातारं ब्रह्माणमतितद्युतिम्।\nभूतमातृगणाध्यक्षं विरूपाक्षं च सोऽसृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2079933, "chapter_id": 2701, "verse_number": "१२-२०६-३९", "content_sanskrit": "शासितारं च पापानां पितृणां समवर्तिनम्।\nअसृजत्सर्वभूतात्मा निधिपं च धनेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2079934, "chapter_id": 2701, "verse_number": "१२-२०६-४०", "content_sanskrit": "यादसामसृजन्नाथं वरुणं च जलेश्वरम्।\nवासवं सर्वदेवानामध्यक्षमकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2079935, "chapter_id": 2701, "verse_number": "१२-२०६-४१", "content_sanskrit": "यावद्यावदभूच्छ्रद्धा देहं धारयितुं नृणाम्।\nतावत्तावदजीवंस्ते नासीद्यमकृतं भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2079936, "chapter_id": 2701, "verse_number": "१२-२०६-४२", "content_sanskrit": "न चैषां मैथुनो धर्मो बभूव भरतर्षभ।\nसंकल्पादेव चैतेषां गर्भः समुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2079937, "chapter_id": 2701, "verse_number": "१२-२०६-४३", "content_sanskrit": "ततस्रेतायुगे काले संस्पर्शाज्जायते प्रजा।\nन ह्यभून्मैथुनो धर्मस्तेषामपि जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2079938, "chapter_id": 2701, "verse_number": "१२-२०६-४४", "content_sanskrit": "द्वापरे मैथुनो धर्मः प्रजानामभवन्नृप।\nतथा कलियुगे राजन्द्वन्द्वमापेदिरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2079939, "chapter_id": 2701, "verse_number": "१२-२०६-४५", "content_sanskrit": "एष भूतपतिस्तात स्वध्यक्षश्च तथोच्यते।\nनिरपेक्षांश्च कौन्तेय कीर्तयिष्यामि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2079940, "chapter_id": 2701, "verse_number": "१२-२०६-४६", "content_sanskrit": "दक्षिणापथजन्मानः सर्वे करभृतस्तव।\nआन्ध्राः पुलिन्दाः शवराश्चूचुपा मद्रकैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2079941, "chapter_id": 2701, "verse_number": "१२-२०६-४७", "content_sanskrit": "उत्तरापथजन्मानः कीर्तयिष्यामि तानपि।\nये तु काम्भोजगान्धाराः किराता बर्वरैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2079942, "chapter_id": 2701, "verse_number": "१२-२०६-४८", "content_sanskrit": "एते पापकृतस्तात चरन्ति पृथिवीमिमाम्।\nबकश्वपाकगृध्राणां सधर्माणो नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2079943, "chapter_id": 2701, "verse_number": "१२-२०६-४९", "content_sanskrit": "नैते कृतयुगे तात चरन्ति पृथिवीमिमाम्।\nत्रेताप्रभुति वर्धन्ते ते जना भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2079944, "chapter_id": 2701, "verse_number": "१२-२०६-५०", "content_sanskrit": "ततस्तस्मिन्महाघोरे संन्ध्याकाले युगान्तिके।\nराजानः समसज्जन्त समासाद्येतरेतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2079945, "chapter_id": 2701, "verse_number": "१२-२०६-५१", "content_sanskrit": "`ऐन्द्रं रूपं समास्थाय ह्यसुरेभ्यो चरन्महीम्।\nस एव भगवान्देवो वेदित्वं च गता मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2079946, "chapter_id": 2701, "verse_number": "१२-२०६-५२", "content_sanskrit": "एवंभूते सृष्टिर्नारसिंहादयः क्रमात्।\nप्रादुर्भावाः स्मृता विष्णोर्जगतीरक्षणाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2079947, "chapter_id": 2701, "verse_number": "१२-२०६-५३", "content_sanskrit": "एष कृष्णो महायोगी तत्तत्कार्यानुरूपणम्।\nहिरण्यकशिपुं दैत्यं हिरण्याक्षं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2079948, "chapter_id": 2701, "verse_number": "१२-२०६-५४", "content_sanskrit": "रावणं च महादैत्यं हत्वासौ पुरुषोत्तमः।\nभूमेर्दुःखोपनाशार्थं ब्रह्मशक्रादिभिः स्तुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2079949, "chapter_id": 2701, "verse_number": "१२-२०६-५५", "content_sanskrit": "आत्मनोऽङ्गान्महातेजा उद्वबर्ह जनार्दनः।\nसितकृष्णौ महाराज केशौ हरिरुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2079950, "chapter_id": 2701, "verse_number": "१२-२०६-५६", "content_sanskrit": "वसुदेवस्य देवक्यामेष जात इहोत्तमः।\nदेहवानिह विश्वात्मा संबन्धी ते जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2079951, "chapter_id": 2701, "verse_number": "१२-२०६-५७", "content_sanskrit": "आविर्वभूव योगीन्द्रो मनोतीतो जगत्पतिः।\nअचिन्त्यः पुरुषव्याघ्र नैव केवलमानुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2079952, "chapter_id": 2701, "verse_number": "१२-२०६-५८", "content_sanskrit": "अव्यक्तादिविशेषान्तं परिमाणार्थसंयुतम्।\nक्रीडा हरेरिदं सर्वं क्षरमित्येव धार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2079953, "chapter_id": 2701, "verse_number": "१२-२०६-५९", "content_sanskrit": "अक्षरं तत्परं नित्यं वैरूप्यं जगतो हरेः।\nतद्विद्धि रूपमतुलममृतत्वं भवज्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2079954, "chapter_id": 2701, "verse_number": "१२-२०६-६०", "content_sanskrit": "तदेव कृष्णो दाशार्हः श्रीमाञ्श्रीवत्सलक्षणः।\nन भूतसृष्टिसंस्थानं देहोऽस्य परमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2079955, "chapter_id": 2701, "verse_number": "१२-२०६-६१", "content_sanskrit": "देहवानिह यो विष्णुरसौ मायामयो हरिः।\nआत्मनो लोकरक्षार्थं ध्याहि नित्यं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2079956, "chapter_id": 2701, "verse_number": "१२-२०६-६२", "content_sanskrit": "अङ्गानि चतुरे वेदा मीमांसा न्यायविस्तरः।\nइतिहासपुराणानि धर्माः स्वायंभुवादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2079957, "chapter_id": 2701, "verse_number": "१२-२०६-६३", "content_sanskrit": "य एनं प्रतिवर्तन्ते वेदान्तानि च सर्वशः।\nभक्तिहीना न तैर्यान्ति नित्यमेनं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2079958, "chapter_id": 2701, "verse_number": "१२-२०६-६४", "content_sanskrit": "सर्वभूतेषु भूतात्मा तत्तद्बुद्धिं समास्थितः।\nतस्माद्बुद्धस्त्वमेवैनं ध्याहि नित्यमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2079959, "chapter_id": 2701, "verse_number": "१२-२०६-६५", "content_sanskrit": "एवमेष कुरुश्रेष्ठ प्रादुर्भावो महात्मनः।\nएवं देवर्षिराचष्ट नारदः सर्वलोकदृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2079960, "chapter_id": 2701, "verse_number": "१२-२०६-६६", "content_sanskrit": "नारदोऽप्यथ कृष्णस्य परं मेने नराधिप।\nशाश्वतत्वं महाबाहो यथावद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2079961, "chapter_id": 2701, "verse_number": "१२-२०६-६७", "content_sanskrit": "एवमेव महाबाहुः केशवः सत्यविक्रमः।\nअचिन्त्यः पुण्डरीकाक्षो नैष केवलमानुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2079962, "chapter_id": 2701, "verse_number": "१२-२०६-६८", "content_sanskrit": "`एवंविधोऽसौ पुरुषः को वैनं वेत्ति सर्वदा।\nएतत्ते कथितं राजन्भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2079963, "chapter_id": 2701, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षडधिकद्विशततमोऽध्यायः॥ २०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]