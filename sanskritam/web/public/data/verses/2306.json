[{"id": 2061087, "chapter_id": 2306, "verse_number": "८-२७-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061088, "chapter_id": 2306, "verse_number": "८-२७-१", "content_sanskrit": "तमब्रुवन्देवगणा यं भवान्सन्नियोक्ष्यते।\nस भविष्यति देवेश सारथिस्ते न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061089, "chapter_id": 2306, "verse_number": "८-२७-२", "content_sanskrit": "तानब्रवीन्महादेवो मत्तः श्रेष्ठतरो हि यः।\nतं सारथिं कुरुध्वं वै स्वयं सञ्चिन्त्य मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061090, "chapter_id": 2306, "verse_number": "८-२७-३", "content_sanskrit": "एतच्छ्रुत्वा वचो देवाः सर्वे गत्वा पितामहम्।\nप्रणिपत्योचुरेकाग्राः प्रसाद्यैनं महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061091, "chapter_id": 2306, "verse_number": "८-२७-४", "content_sanskrit": "त्वया यत्कथितं देव त्रिदशारिनिबर्हणे।\nतथा तत्कृतमस्माभिः प्रसन्नश्च वृषध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061092, "chapter_id": 2306, "verse_number": "८-२७-५", "content_sanskrit": "रथश्च विहितोऽस्माभिर्विचित्रायुधसंवृतः।\nसारथिं च न जानीमः कः स्यात्तस्मिन्रथोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061093, "chapter_id": 2306, "verse_number": "८-२७-६", "content_sanskrit": "तस्माद्विधीयतां कश्चित्सारथिर्देवसत्तम।\nसफलां तां गिरं देव कर्तुमर्हसि नो विभो।\nएवमस्मासु हि पुरा भगवन्नुक्तवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061094, "chapter_id": 2306, "verse_number": "८-२७-७", "content_sanskrit": "सदैव युक्तो रथसत्तमो वै\nदुराधर्षो द्रावणः शात्रवाणाम्।\nपिनाकधन्वा विहितोऽत्र योद्धा\nविभीषयन्दानवानुद्यतोऽसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061095, "chapter_id": 2306, "verse_number": "८-२७-८", "content_sanskrit": "तथैव वेदाश्च हया रथाग्र्य\nधरा सशैला च रथो महात्मनः।\nनक्षत्रवंशानुगतो वरूथी\nयस्मिन्योद्धा सारथिनाऽभिरक्ष्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061096, "chapter_id": 2306, "verse_number": "८-२७-९", "content_sanskrit": "तत्र सारथिरेष्टव्यः सर्वैरेतैर्विशेषवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061097, "chapter_id": 2306, "verse_number": "८-२७-१०", "content_sanskrit": "तं प्रविष्टा रथं देवा रथयोद्वारमेव च।\nकवचानि च शस्त्राणि कार्मुकं च पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061098, "chapter_id": 2306, "verse_number": "८-२७-११", "content_sanskrit": "त्वामृते सारथिं तत्र नान्यं पश्यामहे वयम्।\nत्वं हि सर्वैर्गणैर्युक्तोदेवताभ्योऽधिकः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061099, "chapter_id": 2306, "verse_number": "८-२७-१२", "content_sanskrit": "त्वं देव शक्तो लोकेश नियन्तुं प्रद्रुतानिमान्।\nवेदांश्च सोपनिषदः सारथिर्भव नः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061100, "chapter_id": 2306, "verse_number": "८-२७-१३", "content_sanskrit": "योद्वुं बलेन वीर्येण सत्वेन विनयेन च।\nअधिकःसारथिःकार्यो नास्ति चान्योऽधिको भवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061101, "chapter_id": 2306, "verse_number": "८-२७-१४", "content_sanskrit": "स भवांस्तारयत्वस्मान्कुरु सारथ्यमव्यय।\nभवानभ्यधिकस्त्वत्तो नान्योस्ति भविता त्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061102, "chapter_id": 2306, "verse_number": "८-२७-१५", "content_sanskrit": "त्वं हि देवेश सर्वैस्तु विशिष्टो वदतां वर।\nतं रथं त्वं समारुह्य संयच्छ परमान्हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061103, "chapter_id": 2306, "verse_number": "८-२७-१६", "content_sanskrit": "तव प्रसादाद्वध्येयुर्देव दैवतकण्टकाः।\nस नो रक्ष महाबाहो दैत्येभ्यो महतो भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061104, "chapter_id": 2306, "verse_number": "८-२७-१७", "content_sanskrit": "त्वं हि नो गतिरव्यग्र तवं न्त्रे गोप्ता महाव्रत।\nत्वत्प्रसादात्सुराः सर्वे पूज्यन्ते त्रिदिवे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061105, "chapter_id": 2306, "verse_number": "८-२७-१८", "content_sanskrit": "इति ते शिरसाऽगच्छंस्त्रिलोकेशं पितामहम्।\nदेवाः प्रसादयामासुः सारथ्यायेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061106, "chapter_id": 2306, "verse_number": "८-२७-१९x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061107, "chapter_id": 2306, "verse_number": "८-२७-१९", "content_sanskrit": "एवमेतत्सुरास्तथ्यं नान्यस्त्वभ्यधिको भवात्।\nसारथित्वं करिष्यामि शङ्करस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061108, "chapter_id": 2306, "verse_number": "८-२७-२०", "content_sanskrit": "सर्वथा रथिनः श्रेयान्कर्तव्यो रथसारथिः।\nतस्मादेतद्यथातत्त्वं ज्ञात्वा युष्मांश्च सङ्गतान्।\nसंयच्छामि हयानेष विबुधाय कपर्दिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061109, "chapter_id": 2306, "verse_number": "८-२७-२१x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061110, "chapter_id": 2306, "verse_number": "८-२७-२१", "content_sanskrit": "एवमुक्त्वा जटाभारं संयम्य प्रपितामहः।\nपरिधायाजिनं गाढं सन्न्यस्य च कमण्डलुम्।\nप्रतोदपाणिर्भगवानारुरोह रथं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061111, "chapter_id": 2306, "verse_number": "८-२७-२२", "content_sanskrit": "सारथौ कल्पिते देवैरीशानस्य महात्मनः।\nतस्मिन्नारोहति रथं कल्पितं लोकसम्भृतम्।\nशिरोभिः पतिता भूमौ तुरगा वेदसम्भृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061112, "chapter_id": 2306, "verse_number": "८-२७-२३", "content_sanskrit": "उभाभ्यां लोकनाथाभ्यामास्थितं रथसत्तमम्।\nओढुं न शक्ता वेदाश्वा जानुभ्यामपतन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061113, "chapter_id": 2306, "verse_number": "८-२७-२४", "content_sanskrit": "अभीशुभिस्तु भगवानुद्यम्य च हयान्विभुः।\nअस्तु वीर्यं च शौर्यं च वेदाश्वानामिति प्रभुः।\nरथं सञ्चोदयामास देवानां प्रभुरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061114, "chapter_id": 2306, "verse_number": "८-२७-२५", "content_sanskrit": "ततोऽधिरूढे वरदे रथं पशुपतिस्तदा।\nसाधुसाध्विति देवेशं स्मयमानोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061115, "chapter_id": 2306, "verse_number": "८-२७-२६", "content_sanskrit": "याहि देव यतो दैत्याश्चोदयाश्वानरिन्दम।\nपश्य बाह्वोर्बलं मेऽद्य निघ्नतः शात्रवान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061116, "chapter_id": 2306, "verse_number": "८-२७-२७", "content_sanskrit": "ततोऽश्वांश्चोदयामास मनोमारुतरंहसः।\nपुराण्युद्दिश्य खस्थानि दानवानां तरस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061117, "chapter_id": 2306, "verse_number": "८-२७-२८", "content_sanskrit": "ततस्ते सहसोत्पत्य वेदाख्या रथवाजिनः।\nक्षणेन तेन दैत्यानां पुराणि प्रापयन्हरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061118, "chapter_id": 2306, "verse_number": "८-२७-२९", "content_sanskrit": "अथर्वाङ्गिरसौ चास्तां चक्ररक्षौ महात्मनः।\nअथाधिज्यं धनुः कृत्वा शर्वः सन्धाय तं शरम्।\nयुक्त्वा पाशुपतास्त्रेण त्रिपुरं समचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061119, "chapter_id": 2306, "verse_number": "८-२७-३०", "content_sanskrit": "तस्मिन्स्थिते ततो राजन्रुद्रे सज्जितकार्मुके।\nपुराणि तेन कालेन जग्मुरेकत्वमाशु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061120, "chapter_id": 2306, "verse_number": "८-२७-३१", "content_sanskrit": "एकीभावं गते चैव त्रिपुरत्वमुपागते।\nबभूव तुमुलो हर्षो देवतानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061121, "chapter_id": 2306, "verse_number": "८-२७-३२", "content_sanskrit": "ततो देवगुणाः सर्वे सिद्धाश्च परमर्षयः।\nजयेति वाचो मुमुचुः संस्तुवन्तो महेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061122, "chapter_id": 2306, "verse_number": "८-२७-३३", "content_sanskrit": "ततोऽग्रतः प्रादुरभूत्त्रिपुरं जघ्नुषोऽसुरान्।\nअनिर्देश्याग्र्यवपुषो देवस्यासह्यतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061123, "chapter_id": 2306, "verse_number": "८-२७-३४", "content_sanskrit": "त्रीणि दृष्ट्वैव संस्थानि पुराण्यथ पिनाकधृत्।\nस तद्विकृष्य भगवान्दिव्यं लोकेश्वरो धनुः।\nत्रैलोक्यसारं तमिषुं मुमोच त्रिपुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061124, "chapter_id": 2306, "verse_number": "८-२७-३५", "content_sanskrit": "एकबाणेन तं देवस्त्रिपुरं परमेश्वरः।\nनिजघ्ने सासुरगणं देवदेवो महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061125, "chapter_id": 2306, "verse_number": "८-२७-३६", "content_sanskrit": "बाणतेजोग्निदग्धं तद्विप्रकीर्णं सहस्रधा।\nमहदार्तस्वरं कृत्वा नावशेषमुपागतम्।\nमद्रेश सासुरगणं प्रापतत्पश्चिमार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061126, "chapter_id": 2306, "verse_number": "८-२७-३७", "content_sanskrit": "एवं हि त्रिपुरं दग्धं दानवाश्चाप्यशेषतः।\nमहेश्वरेण क्रुद्धेन त्रैलोक्यस्य हितैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061127, "chapter_id": 2306, "verse_number": "८-२७-३८", "content_sanskrit": "स चात्मक्रोधजो विह्निर्दहेत्युक्तो निवारितः।\nत्रैलोक्यमविशेषेण पुनर्दग्धुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061128, "chapter_id": 2306, "verse_number": "८-२७-३९", "content_sanskrit": "कालाग्निमिव निर्दग्धुमुत्थितं तं पुनः पुनः।\nमाकार्षीर्भस्मासाल्लोकानिति त्र्यक्षोऽब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061129, "chapter_id": 2306, "verse_number": "८-२७-४०", "content_sanskrit": "ततः प्रकृतिमापन्ना देलोकास्तथर्षयः।\nतुष्टुवुर्वाग्भिरग्र्याभिः स्थाणुं त्रिपुरवैरिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061130, "chapter_id": 2306, "verse_number": "८-२७-४१", "content_sanskrit": "तेऽनुज्ञाता भगवता सर्वे जग्मुर्यथागतम्।\nकृतकामाः प्रसन्नेन प्रजापतिमुखाः सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061131, "chapter_id": 2306, "verse_number": "८-२७-४२", "content_sanskrit": "एवं रुद्रस्य कृतवान्सारथ्यं तु पितामहः।\nसंयच्छ तुरगानस्य राधेयस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061132, "chapter_id": 2306, "verse_number": "८-२७-४३", "content_sanskrit": "त्वं हि कृष्णाच्च कर्णाच्च फल्गुनाच्च गुणाधिकः।\nबलतो रूपतो योगादस्त्रसम्पद एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061133, "chapter_id": 2306, "verse_number": "८-२७-४४", "content_sanskrit": "समासक्तं महीपाल कुरु मे हितमीप्सितम्।\nयुद्वे ह्ययं रुद्रकल्पस्त्वं च ब्रह्मसमोऽनघ।\nतस्माच्छक्तौ युवां जेतुं मच्छत्रून्दिवि वा सुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061134, "chapter_id": 2306, "verse_number": "८-२७-४५", "content_sanskrit": "स यथा शल्य कर्णोऽयं श्वंताश्वं कृष्णसारथिम्।\nप्रमथ्य हन्यात्कौन्तेयं तथा नीतिर्विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061135, "chapter_id": 2306, "verse_number": "८-२७-४६", "content_sanskrit": "त्वयि राज्यं सुखं चैव जीवितं जयमेव च।\nसमासक्तं महीपाल कुरु मे हितमीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061136, "chapter_id": 2306, "verse_number": "८-२७-४७", "content_sanskrit": "संयच्छास्य हयान्त्राजन्मत्प्रियार्थं परन्तप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2061137, "chapter_id": 2306, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तविंशोऽध्यायः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]