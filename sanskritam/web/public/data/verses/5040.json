[{"id": 2189979, "chapter_id": 5040, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189980, "chapter_id": 5040, "verse_number": "१", "content_sanskrit": "हृदि कामद्रुमश्चित्रो मोहसञ्चयसम्भवः ।\nक्रोधमानमहास्कन्धो विवित्सापरिमोचनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189981, "chapter_id": 5040, "verse_number": "२", "content_sanskrit": "तस्य चाज्ञानमाधारः प्रमादः परिषेचनम् ।\nसोऽभ्यसूयापलाशो हि पुरादुष्कृतसारवान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189982, "chapter_id": 5040, "verse_number": "३", "content_sanskrit": "सम्मोहचिन्ताविटपः शोकशाखो भयङ्करः ।\nमोहनीभिः पिपासाभिर्लताभिः परिवेष्टितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2189983, "chapter_id": 5040, "verse_number": "४", "content_sanskrit": "उपासते महावृक्षं सुलुब्धास्तं फलेप्सवः ।\nआयासैः संयतः पाशैः फलानि परिवेष्टयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2189984, "chapter_id": 5040, "verse_number": "५", "content_sanskrit": "यस्तान् पाशान्वशे कृत्वा तं वृक्षमपकर्षति ।\nगतः स दुःखयोरन्तं यतमानस्तयोर्द्वयोः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2189985, "chapter_id": 5040, "verse_number": "६", "content_sanskrit": "संरोहत्यकृतप्रज्ञः सन्तापेन हि पादपम् ।\nस तमेव ततो हन्ति विषं ग्रस्तमिवातुरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2189986, "chapter_id": 5040, "verse_number": "७", "content_sanskrit": "तस्यानुशयमूलस्य मूलमुद्ध्रियते बलात् ।\nत्यागाप्रमादाकृतिना साम्येन परमासिना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2189987, "chapter_id": 5040, "verse_number": "८", "content_sanskrit": "एवं यो वेद कामस्य केवलं परिकर्षणम् ।\nवधं वै कामशास्त्रस्य स दुःखान्यतिवर्तते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2189988, "chapter_id": 5040, "verse_number": "९", "content_sanskrit": "शरीरं पुरमित्याहुः स्वामिनी बुद्धिरिष्यते ।\nतत्र बुद्धेः शरीरस्थं मनो नामार्थचिन्तकम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2189989, "chapter_id": 5040, "verse_number": "१०", "content_sanskrit": "इन्द्रियाणि जनाः पौरास्तदर्थं तु परा कृतिः ।\nतत्र द्वौ दारुणौ दोषौ तमो नाम रजस्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2189990, "chapter_id": 5040, "verse_number": "११", "content_sanskrit": "यदर्थमुपजीवन्ति पौराः सहपुरेश्वराः ।\nअद्वारेण तमेवार्थं द्वौ दोषावुपजीवतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2189991, "chapter_id": 5040, "verse_number": "१२", "content_sanskrit": "तत्र बुद्धिर्हि दुर्धर्षा मनः साधर्म्यमुच्यते ।\nपौराश्चापि मनस्त्रस्तास्तेषामपि चला स्थितिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2189992, "chapter_id": 5040, "verse_number": "१३", "content_sanskrit": "यदर्थं बुद्धिरध्यास्ते न सोऽर्थः परिषीदति ।\nयदर्थं पृथगध्यास्ते मनस्तत् परिषीदति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2189993, "chapter_id": 5040, "verse_number": "१४", "content_sanskrit": "पृथग्भूतं यदा बुद्ध्या मनो भवति केवलम् ।\nतत्रैनं विवृतं शून्यं रजः पर्यवतिष्ठते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2189994, "chapter_id": 5040, "verse_number": "१५", "content_sanskrit": "तन्मनः कुरुते सख्यं रजसा सह सङ्गतम् ।\nतं चादाय जनं पौरं रजसे सम्प्रयच्छति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2189995, "chapter_id": 5040, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां शान्तिपर्वणि मोक्षधर्मे कामत्यागोपायकथनं नाम एकोननवतितमोऽध्यायः ॥८९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]