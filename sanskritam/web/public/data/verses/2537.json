[{"id": 2072770, "chapter_id": 2537, "verse_number": "१२-४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072771, "chapter_id": 2537, "verse_number": "१२-४२-१", "content_sanskrit": "अभिषिक्तो महाप्राज्ञो राज्यं प्राप्य युधिष्ठिरः।\nदाशार्हं पुण्डरीकाक्षमुवाच प्राञ्जलिः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072772, "chapter_id": 2537, "verse_number": "१२-४२-२", "content_sanskrit": "तव कृष्ण प्रसादेन नयेन न बलेन च।\nबुद्ध्या च यदुशार्दूल तथा विक्रमणेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072773, "chapter_id": 2537, "verse_number": "१२-४२-३", "content_sanskrit": "पुनः प्राप्तमिदं राज्यं पितृपैतामहं मया।\nनमस्ते पुण्डरीकाक्ष पुनः पुनररिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072774, "chapter_id": 2537, "verse_number": "१२-४२-४", "content_sanskrit": "त्वामेकमाहुः पुरुषं त्वामाहुः सात्वतां पतिम्।\nनामभिस्त्वां बहुविधैः स्तुवन्ति प्रयता द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072775, "chapter_id": 2537, "verse_number": "१२-४२-५", "content_sanskrit": "विश्वकर्मन्नमस्तेऽस्तु विश्वात्मन्विश्वसंभव।\nविष्णो जिष्णो हरे कृष्ण वैकुण्ठ पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072776, "chapter_id": 2537, "verse_number": "१२-४२-६", "content_sanskrit": "अदित्याः सप्तधा त्वं तु पुराणो गर्भतां गतः।\nपृश्निगर्भस्त्वमेवैकस्त्रियुगं त्वां वदन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072777, "chapter_id": 2537, "verse_number": "१२-४२-७", "content_sanskrit": "शुचिश्रवा हृषीकेशो घृतार्चिर्हंस उच्यते।\nत्रिचक्षुः शंभुरेकस्त्वं विभुर्दामोदरोऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072778, "chapter_id": 2537, "verse_number": "१२-४२-८", "content_sanskrit": "वराहोऽग्निर्बृहद्भानुर्वृषभस्तार्क्ष्यलक्षणः।\nअनीकसाहः पुरुषः शिपिविष्ट उरुक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072779, "chapter_id": 2537, "verse_number": "१२-४२-९", "content_sanskrit": "वरिष्ठ उग्रसेनानीः सत्यो वाजसनिर्गुहः।\nअच्युतश्च्यावनोऽरीणां संस्कृतो विकृतिर्वृषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072780, "chapter_id": 2537, "verse_number": "१२-४२-१०", "content_sanskrit": "कृष्णधर्मस्त्वमेवादिर्वृषदर्भो वृषाकपिः।\nसिन्धुर्विधूर्मिस्त्रिककुप् त्रिधामा त्रिवृदच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072781, "chapter_id": 2537, "verse_number": "१२-४२-११", "content_sanskrit": "सम्राड् विराट् स्वराट् चैव स्वराड्भूतमयो भवः।\nविभूर्भूरतिभूः कृष्णः कृष्णवर्त्मा त्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072782, "chapter_id": 2537, "verse_number": "१२-४२-१२", "content_sanskrit": "स्विष्टकृद्भिषजावर्तः कपिलस्त्वं च वामनः।\nयज्ञो ध्रुवः पतङ्गश्च जयत्सेनस्त्वमुच्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072783, "chapter_id": 2537, "verse_number": "१२-४२-१३", "content_sanskrit": "शिखण्डी नहुषो बभ्रुर्दिविस्पृक् त्वं पुनर्वसुः।\nसुबभ्रू रुक्मयज्ञश्च सुषेणो दुन्दुभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072784, "chapter_id": 2537, "verse_number": "१२-४२-१४", "content_sanskrit": "गभस्तिनेमिः श्रीपझः पुष्करः शुष्मधारणः।\nऋभुर्विभुः सर्वसूक्ष्मस्त्व धरित्री च पठ्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072785, "chapter_id": 2537, "verse_number": "१२-४२-१५", "content_sanskrit": "अम्भोनिधिस्त्वं ब्रह्मा त्वं पवित्रं धाम धामवित्।\nहिरण्यगर्भः पुरुषः स्वधा स्वाहा च केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072786, "chapter_id": 2537, "verse_number": "१२-४२-१६", "content_sanskrit": "योनिस्त्वमस्य प्रलयश्च कृष्ण\nत्वमेवेदं सृजसि विश्वमग्रे।\nविश्वं चेदं त्वद्वशे विश्वयोने\nनमोस्तु ते शार्ङ्गचक्रासिपाणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072787, "chapter_id": 2537, "verse_number": "१२-४२-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072788, "chapter_id": 2537, "verse_number": "१२-४२-१७", "content_sanskrit": "एवं स्तुतो धर्मराजेन कृष्णः\nसभामध्ये प्रीतिमान्पुष्कराक्षः।\nतमभ्यनन्दद्भारतं पुष्कलाभि\nर्वाग्भिर्ज्येष्ठं पाण्डवं यादवाग्र्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072789, "chapter_id": 2537, "verse_number": "१२-४२-१८", "content_sanskrit": "`एतन्नामशतं विष्णोर्धर्मराजेन कीर्तितम्।\nयः पठेच्छृणुयाद्वापि सर्वपापैः प्रमुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072790, "chapter_id": 2537, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्विचत्वारिंशोऽध्यायः॥ ४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]