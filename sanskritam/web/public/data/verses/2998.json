[{"id": 2093491, "chapter_id": 2998, "verse_number": "१३-१२८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nमया गवां पुरीषं वै श्रिया जुष्टमिति श्रुतम्।\nएतदिच्छाम्यहं श्रोतुं संशयोऽत्र हि मे महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093492, "chapter_id": 2998, "verse_number": "१३-१२८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093493, "chapter_id": 2998, "verse_number": "१३-१२८-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nगोभिर्नृपेहं संवादं श्रिया भारतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093494, "chapter_id": 2998, "verse_number": "१३-१२८-३", "content_sanskrit": "गावोऽथ विस्मितास्तस्या दृष्ट्वा रूपस्य सम्पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093495, "chapter_id": 2998, "verse_number": "१३-१२८-४x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093496, "chapter_id": 2998, "verse_number": "१३-१२८-४", "content_sanskrit": "काऽसि देवि कुतो वा त्वं रूपेणाप्रतिमा भुवि।\nविस्मिताः स्म महाभागे तव रूपस्य सम्पदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093497, "chapter_id": 2998, "verse_number": "१३-१२८-५", "content_sanskrit": "इच्छामस्त्वां वयं ज्ञातुं का त्वं क्व च गमिष्यसि।\nतत्त्वेन हि सुवर्णाभे सर्वमेतद्ब्रवीहि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093498, "chapter_id": 2998, "verse_number": "१३-१२८-६x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093499, "chapter_id": 2998, "verse_number": "१३-१२८-६", "content_sanskrit": "लोकस्य कान्तिर्भद्रं वः श्रीर्नामाहं परिश्रुता।\nमया दैत्याः परित्यक्ता विनष्टाः शाश्वतीः समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093500, "chapter_id": 2998, "verse_number": "१३-१२८-७", "content_sanskrit": "मयाऽभिपन्ना देवाश्च मोदन्ते शाश्वतीः समाः।\nइन्द्रो विवस्वान्सोमश्च विष्णुरापोऽग्निरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093501, "chapter_id": 2998, "verse_number": "१३-१२८-८", "content_sanskrit": "मयाऽभिपन्ना दीप्यन्ते ऋषयो देवतास्तथा।\nयान्नाविशाम्यहं गावस्ते विनश्यन्ति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093502, "chapter_id": 2998, "verse_number": "१३-१२८-९", "content_sanskrit": "धर्मश्चार्थश्च कामश्च मया जुष्टाः सुखान्विताः।\nएवंप्रभावां मां गावो विजानीत सुखप्रदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093503, "chapter_id": 2998, "verse_number": "१३-१२८-१०", "content_sanskrit": "इच्छामि चापि युष्मासु वस्तुं सर्वासु नित्यदा।\nआगत्य प्रार्थये युष्माञ्श्रीजुष्टा भवताऽनघाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093504, "chapter_id": 2998, "verse_number": "१३-१२८-११x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093505, "chapter_id": 2998, "verse_number": "१३-१२८-११", "content_sanskrit": "अध्रुवा चपला च त्वं सामान्या बहुभिः सह।\nन त्वामिच्छाम भद्रं ते गम्यतां यत्र रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093506, "chapter_id": 2998, "verse_number": "१३-१२८-१२", "content_sanskrit": "वपुष्मन्त्यो वयं सर्वाः किमस्माकं त्वयाऽद्य वै।\nयथेष्टं गम्यतां तत्र कृतकार्या वयं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093507, "chapter_id": 2998, "verse_number": "१३-१२८-१३x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093508, "chapter_id": 2998, "verse_number": "१३-१२८-१३", "content_sanskrit": "किमेतद्वः क्षमं गावो यन्मां नेहाभिनन्दथ।\nन मां सम्प्रतिगृह्णीध्वं कस्माद्वै दुर्लभां सतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093509, "chapter_id": 2998, "verse_number": "१३-१२८-१४", "content_sanskrit": "सत्यश्च लोकवादोऽयं लोके चरति सुव्रताः।\nस्वयं प्राप्ते परिभवो भवतीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093510, "chapter_id": 2998, "verse_number": "१३-१२८-१५", "content_sanskrit": "महदुग्रं तपः कृत्वा मां निषेवन्ति मानवाः।\nदेवदानवगन्धर्वाः पिशाचोरगराक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093511, "chapter_id": 2998, "verse_number": "१३-१२८-१६", "content_sanskrit": "क्षममेतद्धि वो गावः प्रतिगृह्णीत मामिह।\nनावमन्या ह्यहं सौम्यास्त्रैलोक्ये सचराचरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093512, "chapter_id": 2998, "verse_number": "१३-१२८-१७x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093513, "chapter_id": 2998, "verse_number": "१३-१२८-१७", "content_sanskrit": "नावमान्यामहे देवि न त्वां परिभवामहे।\nअध्रुवा चलचित्तासि ततस्त्वां वर्जयामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093514, "chapter_id": 2998, "verse_number": "१३-१२८-१८", "content_sanskrit": "बहुना च किमुक्तेन गम्यतां यत्र वाञ्छसि।\nवपुष्मन्त्यो वयं सर्वाः किमस्माकं त्वयाऽनघे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093515, "chapter_id": 2998, "verse_number": "१३-१२८-१९x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093516, "chapter_id": 2998, "verse_number": "१३-१२८-१९", "content_sanskrit": "अवज्ञाता भविष्यामि सर्वलोकेषु मानवैः।\nप्रत्याख्यातेति युष्माभिः प्रसादः क्रियतां मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093517, "chapter_id": 2998, "verse_number": "१३-१२८-२०", "content_sanskrit": "महाभागा भवत्यो वै शरण्याः शरणागताम्।\nपरित्रायन्तु मां नित्यं भजमानामनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093518, "chapter_id": 2998, "verse_number": "१३-१२८-२१", "content_sanskrit": "माननामहमिच्छामि भवत्यः सततं शिवाः।\nअप्येकाङ्गेष्वधो वस्तुमिच्छामि च सुकुत्सिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093519, "chapter_id": 2998, "verse_number": "१३-१२८-२२", "content_sanskrit": "न वोऽस्ति कुत्सितं किञ्चिदङ्गेष्वालक्ष्यतेऽनघाः।\nपुण्याः पवित्राः सुभगा अवाग्देशं प्रयच्छथ।\nवसेयं यत्र वो देहे तन्मे व्याख्यातुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093520, "chapter_id": 2998, "verse_number": "१३-१२८-२३", "content_sanskrit": "एवमुक्तास्तु ता गावः शुभाः करुणवत्सलाः।\nसम्मान्य सहिताः सर्वाः श्रियमुचुर्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093521, "chapter_id": 2998, "verse_number": "१३-१२८-२४", "content_sanskrit": "अवश्यं मानना कार्या तवास्माभिर्यशस्विनि।\nशकृन्मूत्रे निवसतां पुण्यमेतद्धि नः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093522, "chapter_id": 2998, "verse_number": "१३-१२८-२५x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093523, "chapter_id": 2998, "verse_number": "१३-१२८-२५", "content_sanskrit": "दिष्ट्या प्रसादो युष्माभिः कृतो मेऽनुग्रहात्मकः।\nएवं भवतु भद्रं वः पूजिताऽस्मि सुखप्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093524, "chapter_id": 2998, "verse_number": "१३-१२८-२६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093525, "chapter_id": 2998, "verse_number": "१३-१२८-२६", "content_sanskrit": "एवं कृत्वा तु समयं श्रीर्गोभिः सह भारत।\nपश्यन्तीनां ततस्तासां तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093526, "chapter_id": 2998, "verse_number": "१३-१२८-२७", "content_sanskrit": "एवं गोशकृतः पुत्र माहात्म्यं तेऽनुवर्णितम्।\nमाहात्म्यं च गवां भूयः श्रूयतां गदतो मम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093527, "chapter_id": 2998, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टविंशत्यधिकशततमोऽध्यायः॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]