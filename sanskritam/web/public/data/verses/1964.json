[{"id": 2043144, "chapter_id": 1964, "verse_number": "६-१३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043145, "chapter_id": 1964, "verse_number": "६-१३-१", "content_sanskrit": "अथ गावल्गणिर्विद्वान्संयुगादेत्य भारत।\nप्रत्यक्षदर्शी सर्वस्य भूतभव्यभविष्यवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043146, "chapter_id": 1964, "verse_number": "६-१३-२", "content_sanskrit": "ध्यायते धृतराष्ट्राय सहसोत्पत्य दुःखितः ।\nआचष्ट निहतं भीष्मं भरतानां पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043147, "chapter_id": 1964, "verse_number": "६-१३-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043148, "chapter_id": 1964, "verse_number": "६-१३-३", "content_sanskrit": "सञ्जयोऽहं महाराज नमस्ते भरतर्षभ।\nहतो भीष्मः शान्तनवो भरतानां पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043149, "chapter_id": 1964, "verse_number": "६-१३-४", "content_sanskrit": "ककुदं सर्वयोधानां धाम सर्वधनुष्मताम्।\nशरतल्पगतः सोऽद्य शेते कुरुपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043150, "chapter_id": 1964, "verse_number": "६-१३-५", "content_sanskrit": "यस्य वीर्यं समाश्रित्य द्यूतं पुत्रस्तवाकरोत्।\nस शेते निहतो राजन्संख्ये भीष्मः शिखण्डिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043151, "chapter_id": 1964, "verse_number": "६-१३-६", "content_sanskrit": "यः सर्वान्पृथिवीपालान्समवेतान्महामृधे ।\nजिगायैकरथेनैव काशिपुर्यां महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043152, "chapter_id": 1964, "verse_number": "६-१३-७", "content_sanskrit": "जामदग्न्यं रणे रामं योऽयुध्यदपसंभ्रमः ।\nन हतो जामदग्न्येन स हतोऽद्य शिखण्डिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043153, "chapter_id": 1964, "verse_number": "६-१३-८", "content_sanskrit": "महेन्द्रसदृशः शौर्ये स्थैर्ये च हिमवानिव ।\nसमुद्र इव गाम्भीर्यो सहिष्णुत्वे धरासमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043154, "chapter_id": 1964, "verse_number": "६-१३-९", "content_sanskrit": "शरदंष्ट्रो धनुर्वक्रः खङ्गिजिह्वो दुरासदः।\nनरसिंहः पिता तेऽद्य पाञ्चाल्येन निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043155, "chapter_id": 1964, "verse_number": "६-१३-१०", "content_sanskrit": "पाण्डवानां महासैन्यं यं दृष्ट्वोद्यतमाहवे।\nप्रावेपत भयोद्विग्नं सिंह दृष्ट्वेव गोगणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043156, "chapter_id": 1964, "verse_number": "६-१३-११", "content_sanskrit": "परिरक्ष्य स सेनां ते दशरात्रमनीकहा ।\nजगामास्तमिवादित्यः कृत्वा कर्म सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043157, "chapter_id": 1964, "verse_number": "६-१३-१२", "content_sanskrit": "यः स शक्र इवाक्षोभ्यो वर्षन्बाणान्सहस्रशः।\nजघान युधि योधानामर्बुदं दशभिर्दिनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043158, "chapter_id": 1964, "verse_number": "६-१३-१३", "content_sanskrit": "स शेते निहतो भूमौ वातभग्न इव द्रुमः।\nतव दुर्मन्त्रिते राजन्यथा नार्हः स भारत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043159, "chapter_id": 1964, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि त्रयोदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]