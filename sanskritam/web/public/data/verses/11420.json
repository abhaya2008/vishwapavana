[{"id": 50009346, "chapter_id": 11420, "verse_number": "1", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50009347, "chapter_id": 11420, "verse_number": "2", "content_sanskrit": "एवं निशम्य कपिलस्य वचो जनित्री सा कर्दमस्य दयिता किल देवहूतिः। विस्रस्तमोहपटला तमभिप्रणम्य तुष्टाव तत्त्वविषयाखिलसिद्धभूमिम्॥ ३/३४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50009348, "chapter_id": 11420, "verse_number": "3", "content_sanskrit": "देवहूतिरुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50009349, "chapter_id": 11420, "verse_number": "4", "content_sanskrit": "अथाप्ययान्ते सलिले शयानं भूतेन्द्रियार्थात्ममयं वपुस्ते। गुणप्रवाहं सदशेषबीजं दध्यौ स्वयं यज्जठराब्जजातः॥ ३/३४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50009350, "chapter_id": 11420, "verse_number": "5", "content_sanskrit": "स एव विश्वस्य भवान् विधत्ते गुणप्रवाहेषु विभक्तवीर्यः। सर्गाद्यनीहोऽवितथाभिसन्धिरात्मेश्वरोऽतर्क्यसहस्रशक्तिः॥ ३/३४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50009351, "chapter_id": 11420, "verse_number": "6", "content_sanskrit": "स त्वं भृतो मे जठरेण नाथ कथं नु यस्योदर एतदासीत्। विश्वं युगान्ते वटपत्र एकः शेते स्म मायाशिशुरङ्घ्रिपानः॥ ३/३४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50009352, "chapter_id": 11420, "verse_number": "7", "content_sanskrit": "त्वं देहतन्त्रः प्रशमाय पाप्मनां निदेशभाजां च विभो विभूतये। यथावतारास्तव सूकरादयस्तथाऽयमप्यात्मपथोलब्धये॥ ३/३४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50009353, "chapter_id": 11420, "verse_number": "8", "content_sanskrit": "यन्नामधेयश्रवणानुकार्तनाद् यत्प्रह्वणाद् यत्स्मरणादपि क्वचित्। श्वादोऽपि सद्यः सवनाय कल्पते कुतः पुनस्ते भगवन् नु दर्शनात्॥ ३/३४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50009354, "chapter_id": 11420, "verse_number": "9", "content_sanskrit": "अहो बत श्वपचोऽतो गरीयान् यज्जिह्वाग्रे वर्तते नाम तुभ्यम्। तेपुस्तपस्ते जुहुवुः सुराद्यान् ब्रह्मानूचुर्नाम गृणन्ति ये ते॥ ३/३४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50009355, "chapter_id": 11420, "verse_number": "10", "content_sanskrit": "तं त्वाऽद्धाऽहं ब्रह्म परं पुमांसं प्रत्यक्स्रोतस्यात्मनि संविभाव्यम्। स्वतेजसा ध्वस्तगुणप्रवाहं वन्दे विष्णुं कपिलं वेदगर्भम्॥ ३/३४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50009356, "chapter_id": 11420, "verse_number": "11", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50009357, "chapter_id": 11420, "verse_number": "12", "content_sanskrit": "ईडितो भगवानेवं कपिलाख्यः परः पुमान्। वाचाऽविक्ल्बयेत्याह मातरं मातृवत्सलः॥ ३/३४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50009358, "chapter_id": 11420, "verse_number": "13", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50009359, "chapter_id": 11420, "verse_number": "14", "content_sanskrit": "मार्गेणानेन मातस्ते सुसेव्येनोदितेन मे। आस्थितेन परां काष्ठामचिरादवरोत्स्यसि॥ ३/३४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50009360, "chapter_id": 11420, "verse_number": "15", "content_sanskrit": "श्रद्धत्स्वैतन्मतं मह्यं जुष्टं यद् ब्रह्मवादिभिः। येन मामभयं यायान्मृत्युमृच्छन्त्यतद्विदः॥ ३/३४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50009361, "chapter_id": 11420, "verse_number": "16", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50009362, "chapter_id": 11420, "verse_number": "17", "content_sanskrit": "इति प्रदर्श्य भगवानुशतीमात्मनो गतिम्। स्वमात्रा ब्रह्मवादिन्या कपिलोऽनुमतो ययौ॥ ३/३४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50009363, "chapter_id": 11420, "verse_number": "18", "content_sanskrit": "सा चापि तनयोक्तेन योगादेशेन योगयुक्। तस्मिन्नाश्रम आसीना सरस्वत्याः समाहिता॥ ३/३४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50009364, "chapter_id": 11420, "verse_number": "19", "content_sanskrit": "अभीक्ष्णावगाहकपिशान् जटिलान् कुटिलाळकान्। आत्मानं चोग्रतपसा बिभ्रती चीरिणं कृशम्॥ ३/३४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50009365, "chapter_id": 11420, "verse_number": "20", "content_sanskrit": "प्रजापतेः कर्दमस्य तपोयोगविजृम्भितम्। स्वगार्हस्थ्यमनौपम्यं प्रार्थ्यं वैमानिकैरपि॥ ३/३४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50009366, "chapter_id": 11420, "verse_number": "21", "content_sanskrit": "पयःफेननिभाः शय्या दान्ता रुग्मपरिच्छदाः। आसनानि च हैमानि सुस्पर्शास्तरणानि च॥ ३/३४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50009367, "chapter_id": 11420, "verse_number": "22", "content_sanskrit": "स्वच्छस्फटिककुड्येषु महामारतकेषु च। रत्नादीपार्चिषो भान्ति ललनारत्नासंयुताः॥ ३/३४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50009368, "chapter_id": 11420, "verse_number": "23", "content_sanskrit": "गृहोद्यानं कुसुमितै रम्यं बह्वमरद्रुमैः। कूजद्विहङ्गमिथुनं गायन्मत्तमधुव्रतम्॥ ३/३४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50009369, "chapter_id": 11420, "verse_number": "24", "content_sanskrit": "यत्र प्रविष्टमात्मानं विबुधानुचरा जगुः। वाप्यामुत्पलगन्धिन्यां कर्दमेनोपलाळितम्॥ ३/३४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50009370, "chapter_id": 11420, "verse_number": "25", "content_sanskrit": "हित्वा तदीप्सिततमप्याखण्डलयोषिताम्। किञ्चिच्चकार वदनं पुत्रविश्लेषणातुरा॥ ३/३४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50009371, "chapter_id": 11420, "verse_number": "26", "content_sanskrit": "वनं प्रव्रजिते पत्यावपत्यविरहातुरा। ज्ञाततत्त्वाऽप्यभून्नष्टवत्सा गौरिव वत्सला॥ ३/३४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50009372, "chapter_id": 11420, "verse_number": "27", "content_sanskrit": "तमेव ध्यायती देवमपत्यं कपिलं हरिम्। बभूवाविरतोत्साहा निःस्पृहा तादृशे गृहे॥ ३/३४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50009373, "chapter_id": 11420, "verse_number": "28", "content_sanskrit": "ध्यायती भगवद्रूपं यदाह ध्यानगोचरम्। सुतं प्रसन्नवदनं समस्तव्यस्तचिन्तया॥ ३/३४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50009374, "chapter_id": 11420, "verse_number": "29", "content_sanskrit": "भक्तिप्रवाहयोगेन वैराग्येण बलीयसा। युक्तानुष्ठानजातेन ज्ञानेन ब्रह्महेतुना॥ ३/३४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50009375, "chapter_id": 11420, "verse_number": "30", "content_sanskrit": "विशुद्धेन तदाऽत्मानमात्मना विश्वतोमुखम्। स्वानुभूत्या तिरोभूतमायागुणविशेषणम्॥ ३/३४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50009376, "chapter_id": 11420, "verse_number": "31", "content_sanskrit": "ब्रह्मण्यवस्थितमतिर्भगवत्यात्मसंश्रये। निवृत्तजीवभावत्वात् क्षीणक्लेशाऽऽप्तनिर्वृतिः॥ ३/३४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50009377, "chapter_id": 11420, "verse_number": "32", "content_sanskrit": "नित्यारूढसमाधित्वात् परावृत्तगुणभ्रमा। न सस्मार तदाऽऽत्मानं स्वप्नदृष्टमिवोत्थितः॥ ३/३४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50009378, "chapter_id": 11420, "verse_number": "33", "content_sanskrit": "तद्देहोपगतः पोषोऽप्यकृशश्चाध्यसम्भवात्। बभौ मलैरवच्छन्नः सधूम इव पावकः॥ ३/३४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50009379, "chapter_id": 11420, "verse_number": "34", "content_sanskrit": "स्वाङ्गं तपोयोगमयं मुक्तकेशं गताम्बरम्। दैवगुप्तं न बुबुधे वासुदेवप्रविष्टधीः॥ ३/३४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50009380, "chapter_id": 11420, "verse_number": "35", "content_sanskrit": "एवं सा कपिलोक्तेन मार्गेणाविरहं परम्। आत्मानं ब्रह्म निर्वाणं भगवन्तमवाप ह॥ ३/३४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50009381, "chapter_id": 11420, "verse_number": "36", "content_sanskrit": "तद् वीरासीत् पुण्यतमं क्षेत्रं त्रैलोक्यविश्रुतम्। नाम्ना सिद्धपदं यत्र सा संसिद्धिमुपेयुषी॥ ३/३४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50009382, "chapter_id": 11420, "verse_number": "37", "content_sanskrit": "तस्यास्तद् योगविधुतमाशु मर्त्यमभूत् सरित्। स्रोतसां प्रवरा सौम्य सिद्धिदा सिद्धसेविता॥ ३/३४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50009383, "chapter_id": 11420, "verse_number": "38", "content_sanskrit": "कपिलोऽपि महायोगी भगवान् पितुराश्रमात्। मातरं समनुज्ञाप्य प्रागुदीचीं दिशं ययौ॥ ३/३४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50009384, "chapter_id": 11420, "verse_number": "39", "content_sanskrit": "सिद्धचारणगन्धर्वैर्मुनिभिश्चाप्सरोगणैः। स्तूयमानः समुद्रेण दत्तार्हणनिकेतनः॥ ३/३४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50009385, "chapter_id": 11420, "verse_number": "40", "content_sanskrit": "आस्ते योगं समास्थाय साङ्ख्याचार्यैरभिष्टुतः। त्रयाणामपि लोकानामुपशान्त्यै समाहितः॥ ३/३४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50009386, "chapter_id": 11420, "verse_number": "41", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50009387, "chapter_id": 11420, "verse_number": "42", "content_sanskrit": "एतन्निगदितं तात यत् पृष्टोऽहं त्वयाऽनघ। कपिलस्य च संवादो देवहूत्याश्च पावनः॥ ३/३४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50009388, "chapter_id": 11420, "verse_number": "43", "content_sanskrit": "य इदमनुशृणोति योऽभिधत्ते कपिलमुनेर्मतमात्मयोगगुह्यम्। भगवति कृतधीः सुपर्णकेता- वुपलभते भगवत्पदारविन्दम्॥ ३/३४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50009389, "chapter_id": 11420, "verse_number": "44", "content_sanskrit": "॥ इति श्रीमद्भागवते महापुराणे पारमहंस्यामष्टादशसाहस्र्यां संहितायां वैयासिक्यां तृतीयस्कन्धे चतुस्त्रिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50009390, "chapter_id": 11420, "verse_number": "45", "content_sanskrit": "॥ समाप्तश्च तृतीयस्कन्धः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]