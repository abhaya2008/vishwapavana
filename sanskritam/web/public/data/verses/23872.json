[{"id": 7003872000, "chapter_id": 23872, "verse_number": "२-७-२-१", "content_sanskrit": "नारद उवाच ।\nन माधवसमो मासो न कृतेन युगं समम् ।\nन च वेदसमं शास्त्रं न तीर्थं गंगया समम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003872001, "chapter_id": 23872, "verse_number": "२-७-२-२", "content_sanskrit": "न जलेन समं दानं न सुखं भार्यया समम् ।\nन कृषेस्तु समं वित्तं न लाभो जीवितात्परः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003872002, "chapter_id": 23872, "verse_number": "२-७-२-३", "content_sanskrit": "न तपोऽनशनात्तुल्यं न दानात्परमं सुखम् ।\nन धर्मस्तु दयातुल्यो न ज्योतिश्चक्षुषा समम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003872003, "chapter_id": 23872, "verse_number": "२-७-२-४", "content_sanskrit": "न तृप्तिरशनात्तुल्या न वाणिज्यं कृषेः समम् ।\nन धर्मेण समं मित्रं न सत्येन समं यशः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003872004, "chapter_id": 23872, "verse_number": "२-७-२-५", "content_sanskrit": "नारोग्यसममुत्थानं न त्राता केशवात्परः ।\nन माधवसमं लोके पवित्रं कवयो विदुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003872005, "chapter_id": 23872, "verse_number": "२-७-२-६", "content_sanskrit": "माधवः परमो मासः शेषशायिप्रियः सदा ।\nअव्रतेन क्षिपेद्यस्तु मासं माधववल्लभम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003872006, "chapter_id": 23872, "verse_number": "२-७-२-७", "content_sanskrit": "तिर्यग्योनिं स यात्याशु सर्वधर्मबहिष्कृतः ।\nअव्रतेन गतो येषां माधवो मर्त्यधर्मिणाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003872007, "chapter_id": 23872, "verse_number": "२-७-२-८", "content_sanskrit": "इष्टापूर्ते वृथा तेषां धर्मोधर्मभृतां वरः ।\nप्रवृत्तानां तु भक्ष्याणां माधवेऽनियमे कृते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003872008, "chapter_id": 23872, "verse_number": "२-७-२-९", "content_sanskrit": "अवश्यं विष्णुसायुज्यं प्राप्नोत्येव न संशयः ।\nसंतीह बहुवित्तानि व्रतानि विविधानि च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003872009, "chapter_id": 23872, "verse_number": "२-७-२-१०", "content_sanskrit": "देहाऽयासकराण्येव पुनर्जन्मप्रदानि च ।\nवैशाखस्नानमात्रेण न पुनर्जायते भुवि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003872010, "chapter_id": 23872, "verse_number": "२-७-२-११", "content_sanskrit": "सर्व दानेषु यत्पुण्यं सर्वतीर्थेषु यत्फलम् ।\nतत्फलं समवाप्नोति माधवे जलदानतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003872011, "chapter_id": 23872, "verse_number": "२-७-२-१२", "content_sanskrit": "जलदानासमर्थेन परस्यापि प्रबोधनम् ।\nकर्तव्यं भूतिकामेन सर्वदानाधिकं हितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003872012, "chapter_id": 23872, "verse_number": "२-७-२-१३", "content_sanskrit": "एकतः सर्वदानानि जलदानं हि चैकतः ।\nतुलामारोपितं पूर्वं जलदानं विशिष्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003872013, "chapter_id": 23872, "verse_number": "२-७-२-१४", "content_sanskrit": "मार्गेऽध्वगानां यो मर्त्यः प्रपादानं करोति हि ।\nस कोटिकुलमुद्धृत्य विष्णुलोके महीयते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003872014, "chapter_id": 23872, "verse_number": "२-७-२-१५", "content_sanskrit": "देवानां च पितॄणां च ऋषीणां राजसत्तम ।\nअत्यंत प्रीतिदं सत्यं प्रपादानं न संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003872015, "chapter_id": 23872, "verse_number": "२-७-२-१६", "content_sanskrit": "प्रपादानेन संतुष्टा येनाऽध्वश्रमकर्षिताः ।\nतोषितास्तेन देवाश्च ब्रह्मविष्णुशिवादय ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003872016, "chapter_id": 23872, "verse_number": "२-७-२-१७", "content_sanskrit": "सलिलं सलिलेच्छूनां छत्रं छायामपीच्छताम् ।\nव्यजनं व्यजनेच्छूना वैशाखे मासि भूमिप ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003872017, "chapter_id": 23872, "verse_number": "२-७-२-१८", "content_sanskrit": "जलं छत्रं च व्यजनं दानं येषां विशिष्यते ।\nमाधवे मासि संप्राप्ते ब्राह्मणाय कुटुम्बिने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003872018, "chapter_id": 23872, "verse_number": "२-७-२-१९", "content_sanskrit": "अदत्त्वोदककुम्भं च चातको जायते भुवि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003872019, "chapter_id": 23872, "verse_number": "२-७-२-२०", "content_sanskrit": "यो दद्याच्छीतलं तोयं तृषार्ताय महात्मने ।\nतावन्मात्रेण राजेंद्र राजसूयायुतं लभेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003872020, "chapter_id": 23872, "verse_number": "२-७-२-२१", "content_sanskrit": "घर्मश्रमार्तविप्राय वीजयेद्व्यजनेन यः ।\nतावन्मात्रेण निष्पापो विहगाधिपतिर्भवेत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003872021, "chapter_id": 23872, "verse_number": "२-७-२-२२", "content_sanskrit": "अदत्त्वा व्यजनं भूप वैशाखे तु द्विजातये ।\nवातरोगशताकीर्णो नरकानेव विंदति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003872022, "chapter_id": 23872, "verse_number": "२-७-२-२३", "content_sanskrit": "यो वीजयेत्पटेनाऽपि पथि श्रांतं द्विजोत्तमम् ।\nतावताथ विमुक्तोऽसौ विष्णुसायुज्यमाप्नुयात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003872023, "chapter_id": 23872, "verse_number": "२-७-२-२४", "content_sanskrit": "यास्तालव्यजनं वाऽपि दत्त्वा शुद्धेन चेतसा ।\nविधूय सर्वपापानि ब्रह्मलोकं स गच्छति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003872024, "chapter_id": 23872, "verse_number": "२-७-२-२५", "content_sanskrit": "सद्यः श्रमहरं पुण्यं न दद्याद्व्यजनं नरः ।\nनारकीं यातनां भुक्त्वा कश्मलो जायते भुवि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003872025, "chapter_id": 23872, "verse_number": "२-७-२-२६", "content_sanskrit": "आध्यात्मिकादिदुःखानां शांतये मनुजेश्वर ।\nछत्रं दद्यात्प्रयत्नेन वैशाखे मासि वासकृत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003872026, "chapter_id": 23872, "verse_number": "२-७-२-२७", "content_sanskrit": "अच्छत्रदो नरो यस्तु वैशाखे माधवप्रिये ।\nछायाहीनो महाक्रूरः पिशाचो भुवि जायते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003872027, "chapter_id": 23872, "verse_number": "२-७-२-२८", "content_sanskrit": "यो दद्यात्पादुके दिव्ये माधवे माधवप्रिये ।\nयमदूतौ तिरस्कृत्य विष्णुलोकं स गच्छति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003872028, "chapter_id": 23872, "verse_number": "२-७-२-२९", "content_sanskrit": "पादत्राणं तु यो दद्याद्वैशाखे माधवागमे ।\nन तस्य नारको लोको न क्लेशा ऐहिकाश्च ये ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003872029, "chapter_id": 23872, "verse_number": "२-७-२-३०", "content_sanskrit": "पादुके याचमानाय यो दद्याद्ब्राह्मणाय च ।\nस भूपालो भवेद्भूमौ कोटिजन्मस्वसंशयम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003872030, "chapter_id": 23872, "verse_number": "२-७-२-३१", "content_sanskrit": "अनाथमंडपं मार्गे श्रमहारि करोति यः ।\nतस्य पुण्यफलं वक्तुं ब्रह्मणाऽपि न शक्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003872031, "chapter_id": 23872, "verse_number": "२-७-२-३२", "content_sanskrit": "मध्याह्ने ब्राह्मणं प्राप्तमतिथिं भोजयेद्यदि ।\nन तस्य फलविश्रांतिर्ब्रह्मणाऽपि निरूपिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003872032, "chapter_id": 23872, "verse_number": "२-७-२-३३", "content_sanskrit": "सद्यः स्वाप्यायनं नृणामन्नदानं नराधिप ।\nतस्मान्नान्नेन सदृशं दानं लोकेषु विद्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003872033, "chapter_id": 23872, "verse_number": "२-७-२-३४", "content_sanskrit": "मार्गश्रांताय विप्राय प्रश्रयं प्रददाति यः ।\nतस्य पुण्यफलं वक्तुं ब्रह्मणाऽपि न शक्यते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003872034, "chapter_id": 23872, "verse_number": "२-७-२-३५", "content_sanskrit": "दारापत्यगृहादीनि वासोऽलंकारभूषणम् ।\nअसह्यं नाश्नतः पुंसः सह्यं भुक्तवतो ध्रुवम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003872035, "chapter_id": 23872, "verse_number": "२-७-२-३६", "content_sanskrit": "तस्मादन्नसमं दानं न भूतं न भविष्यति ।\nवैशाखे येन चादत्तं मार्गश्रांते च भूसुरे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003872036, "chapter_id": 23872, "verse_number": "२-७-२-३७", "content_sanskrit": "स पिशाचो भवेद्भूमौ स्वमांसान्येव खादति ।\nयथाविभूति दातव्यं तस्मादन्नं द्विजातये ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003872037, "chapter_id": 23872, "verse_number": "२-७-२-३८", "content_sanskrit": "अन्नदो मातृपित्रादीन्विस्मारयति भूमिप ।\nतस्मादन्नं प्रशंसंति लोकास्त्रैलोक्यवर्तिनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003872038, "chapter_id": 23872, "verse_number": "२-७-२-३९", "content_sanskrit": "मातरः पितरश्चापि केवलं जन्महेतवः ।\nअन्नदं पितरं लोके वदन्ति च मनीषिणः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003872039, "chapter_id": 23872, "verse_number": "२-७-२-४०", "content_sanskrit": "अन्नदे सर्वतीर्थानि अन्नदे सर्वदेवताः ।\nअन्नदे सर्वधर्माश्च तिष्ठंत्यरिधराजय ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003872040, "chapter_id": 23872, "verse_number": "२-७-२-४१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे वैशाखमासमाहात्म्ये नारदाम्बरीषसंवादे दाननिरूपणंनाम द्वितीयोऽध्यायः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]