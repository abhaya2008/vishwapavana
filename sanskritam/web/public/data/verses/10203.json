[{"id": 6000203000, "chapter_id": 10203, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000203001, "chapter_id": 10203, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.001.m4a", "display_order": 2}, {"id": 6000203002, "chapter_id": 10203, "verse_number": "१०-७-१", "content_sanskrit": "नन्दः पथि वचः शौरेर्न मृषेति विचिन्तयन्।\nहरिं जगाम शरणमुत्पातागमशङ्कितः॥ १०/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.002.m4a", "display_order": 3, "topics": [{"text": "कंसप्रेरणया श्रीकृष्णं हन्तुमागतायाः पूतनायाः भगवता हननम्", "range": "१–८"}]}, {"id": 6000203003, "chapter_id": 10203, "verse_number": "१०-७-२", "content_sanskrit": "कंसेन प्रहिता घोरा पूतना बालघातिनी।\nशिशूंश्चचार निघ्नन्ती पुरग्रामव्रजादिषु॥ १०/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.003.m4a", "display_order": 4}, {"id": 6000203004, "chapter_id": 10203, "verse_number": "१०-७-३", "content_sanskrit": "न यत्र श्रवणादीनि रक्षोघ्नानि स्वकर्मसु।\nकुर्वन्ति सात्त्वतां भर्तुर्यातुधान्यश्च तत्र हि॥ १०/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.004.m4a", "display_order": 5}, {"id": 6000203005, "chapter_id": 10203, "verse_number": "१०-७-४", "content_sanskrit": "सा खेचर्येकदोपेत्य पूतना नन्दगोकुलम्।\nगोपित्वा माययाऽऽत्मानं प्राविशत् कामचारिणी॥ १०/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.005.m4a", "display_order": 6}, {"id": 6000203006, "chapter_id": 10203, "verse_number": "१०-७-५", "content_sanskrit": "तां केशपाशव्यतिषक्तमल्लिकां बृहन्नितम्बस्तनकृच्छ्रमध्यमाम्।\nसुवाससं कम्पितकर्णभूषणत्विषोल्लसत्कुन्तलमण्डिताननाम्॥ १०/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.006.m4a", "display_order": 7}, {"id": 6000203007, "chapter_id": 10203, "verse_number": "१०-७-६", "content_sanskrit": "वल्गुस्मितापाङ्गविसर्गवीक्षितैर्मनो हरन्तीं वनितां व्रजौकसः।\nअमंसताम्भोजकरेण रूपिणीं गोप्यः श्रियं द्रष्टुमिहागतां पतिम्॥ १०/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.007.m4a", "display_order": 8}, {"id": 6000203008, "chapter_id": 10203, "verse_number": "१०-७-७", "content_sanskrit": "बालग्रही तत्र विचिन्वती शिशून् यदृच्छया नन्दगृहेऽसदन्तकम्।\nबालं प्रतिच्छन्ननिजोरुतेजसं ददर्श तल्पेऽग्निमिवाहितं भसि॥ १०/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.008.m4a", "display_order": 9}, {"id": 6000203009, "chapter_id": 10203, "verse_number": "१०-७-८", "content_sanskrit": "विबुध्य तां बालकमारिकाग्रहं चराचरात्मा स निमीलितेक्षणः।\nमहीसुरत्वेऽपि च बालभावं विभावयन् किञ्चिदुवाच न प्रभुः॥ १०/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.009.m4a", "display_order": 10}, {"id": 6000203010, "chapter_id": 10203, "verse_number": "१०-७-९", "content_sanskrit": "अजानमानाऽथ निशाचरी हरिं निसर्गविज्ञातजगद्विचेष्टितम्।\nअनन्तमारोपयदङ्कमन्तकं यथोरगं सुप्तमबुद्धिरज्जुधीः॥ १०/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.010.m4a", "display_order": 11, "topics": [{"text": "भयेन वृद्धस्त्रीभिः कृतं रक्षाबन्धनम्", "range": "९–३१"}]}, {"id": 6000203011, "chapter_id": 10203, "verse_number": "१०-७-१०", "content_sanskrit": "तां तीक्ष्णचित्तामतिवामचेष्टितां वीक्ष्यान्तराकोशपरिच्छदासिवत्।\nवरस्‍त्रियं तत्प्रभया च धर्षिते निरीक्षमाणे जननी अतिष्ठत्॥ १०/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.011.m4a", "display_order": 12}, {"id": 6000203012, "chapter_id": 10203, "verse_number": "१०-७-११", "content_sanskrit": "तस्मिन् स्तनं दुर्जरवीर्यमुल्बणं घोराऽङ्कमादाय शिशोर्ददावथ।\nगाढं कराभ्यां भगवान् प्रपीड्य तत् प्राणैः समं रोषसमन्वितोऽपिबत्॥ १०/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.012.m4a", "display_order": 13}, {"id": 6000203013, "chapter_id": 10203, "verse_number": "१०-७-१२", "content_sanskrit": "सा मुञ्च मुञ्चेति गिरा प्रभाषिणी निष्पीड्यमानाऽखिलजीवमर्षिणी।\nविवृत्य नेत्रे चरणौ भुजौ मुहुर्विक्लिन्नगात्रा क्षिपती रुराव ह॥ १०/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.013.m4a", "display_order": 14}, {"id": 6000203014, "chapter_id": 10203, "verse_number": "१०-७-१३", "content_sanskrit": "तस्याः स्वनेनातिगभीररंहसा साद्रिर्मही द्यौश्च चचाल सग्रहा।\nरसा दिशः खं प्रतिनेदिरे जनाः पेतुः क्षितौ वज्रनिपातशङ्कया॥ १०/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.014.m4a", "display_order": 15}, {"id": 6000203015, "chapter_id": 10203, "verse_number": "१०-७-१४", "content_sanskrit": "निशाचरीत्थं व्यथिता व्यसुः क्षितौ विकीर्य केशांश्चरणौ भुजावपि।\nप्रसार्य गोष्ठे निजरूपमास्थिता वज्राहतो वृत्र इवापतन्नृप॥ १०/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.015.m4a", "display_order": 16}, {"id": 6000203016, "chapter_id": 10203, "verse_number": "१०-७-१५", "content_sanskrit": "पतमानोऽपि तद्देहस्‍त्रिगव्यूत्यन्तरे द्रुमान्।\nचूर्णयामास राजेन्द्र महदासीत् तदद्भुतम्॥ १०/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.016.m4a", "display_order": 17}, {"id": 6000203017, "chapter_id": 10203, "verse_number": "१०-७-१६", "content_sanskrit": "ईषामात्रोग्रदंष्ट्रास्यं गिरिकन्दरनासिकम्।\nगण्डशैलस्तनं रौद्रं प्रकीर्णारुणमूर्धजम्॥ १०/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.017.m4a", "display_order": 18}, {"id": 6000203018, "chapter_id": 10203, "verse_number": "१०-७-१७", "content_sanskrit": "अन्धकूपगभीराक्षं पुलिनारोहभीषणम्।\nबद्धसेतुभुजोर्वङ्घ्रि शून्यतोयह्रदोदरम्॥ १०/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.018.m4a", "display_order": 19}, {"id": 6000203019, "chapter_id": 10203, "verse_number": "१०-७-१८", "content_sanskrit": "सन्तत्रसुः स्म तद्वीक्ष्य गोपा गोप्यः कलेवरम्।\nपूर्वं तु तन्निःस्वनितभिन्नहृत्कर्णमस्तकाः॥ १०/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.019.m4a", "display_order": 20}, {"id": 6000203020, "chapter_id": 10203, "verse_number": "१०-७-१९", "content_sanskrit": "बालं च तस्या उरसि क्रीडन्तमकुतोभयम्।\nगोप्यस्तूर्णं समभ्येत्य जगृहुर्जातसम्भ्रमाः॥ १०/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.020.m4a", "display_order": 21}, {"id": 6000203021, "chapter_id": 10203, "verse_number": "१०-७-२०", "content_sanskrit": "यशोदारोहिणीभ्यां ताः समं बालस्य सर्वशः।\nरक्षां विदधिरे सम्यग् गोपुच्छभ्रमणादिभिः॥ १०/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.021.m4a", "display_order": 22}, {"id": 6000203022, "chapter_id": 10203, "verse_number": "१०-७-२१", "content_sanskrit": "गोमूत्रेण स्नापयित्वा पुनर्गोरजसाऽर्भकम्।\nरक्षां चक्रुर्गोशकृता द्वादशाङ्गेषु नामभिः॥ १०/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.022.m4a", "display_order": 23}, {"id": 6000203023, "chapter_id": 10203, "verse_number": "१०-७-२२", "content_sanskrit": "गोप्यः संस्पृष्टसलिला अङ्गेषु करयोः पृथक्।\nन्यस्यात्मन्यथ बालस्य बीजन्यासमकुर्वत॥ १०/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.023.m4a", "display_order": 24}, {"id": 6000203024, "chapter_id": 10203, "verse_number": "१०-७-२३", "content_sanskrit": "अव्यादजोऽङ्घ्रिमणिमांस्तव जान्वथोरू यज्ञोऽच्युतः कटितटं जठरं हयास्यः।\nहृत् केशवस्त्वदुर ईश इनस्तु कण्ठं विष्णुर्भुजं मुखमुरुक्रम ईश्वरः कम्॥ १०/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.024.m4a", "display_order": 25}, {"id": 6000203025, "chapter_id": 10203, "verse_number": "१०-७-२४", "content_sanskrit": "चक्य्रग्रतः सहगदो हरिरस्तु पश्चात् त्वत्पार्श्वयोर्धनुरसी मधुहाऽजनश्च।\nकोणेषु शङ्ख उरुगाय उपर्युपेन्द्रस्तार्क्ष्यः क्षितौ हलधरः पुरुषः समन्तात्॥ १०/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.025.m4a", "display_order": 26}, {"id": 6000203026, "chapter_id": 10203, "verse_number": "१०-७-२५", "content_sanskrit": "इन्द्रियाणि हृषीकेशः प्राणान् नारायणोऽवतु।\nश्वेतद्वीपपतिश्चित्तं मनो योगेश्वरोऽवतु॥ १०/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.026.m4a", "display_order": 27}, {"id": 6000203027, "chapter_id": 10203, "verse_number": "१०-७-२६", "content_sanskrit": "पृश्निगर्भस्तु ते बुद्धिमात्मानं भगवान् परः।\nक्रीडन्तं पातु गोविन्दः शयानं पातु माधवः॥ १०/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.027.m4a", "display_order": 28}, {"id": 6000203028, "chapter_id": 10203, "verse_number": "१०-७-२७", "content_sanskrit": "व्रजन्तमव्याद् वैकुण्ठ आसीनं त्वां श्रियः पतिः।\nभुञ्जानं यज्ञभुक् पातु सर्वग्रहभयङ्करः॥ १०/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.028.m4a", "display_order": 29}, {"id": 6000203029, "chapter_id": 10203, "verse_number": "१०-७-२८", "content_sanskrit": "डाकिन्यो यातुधान्यश्च कूष्माण्डा येऽर्भकग्रहाः।\nभूतप्रेतपिशाचाश्च यक्षरक्षोविनायकाः॥ १०/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.029.m4a", "display_order": 30}, {"id": 6000203030, "chapter_id": 10203, "verse_number": "१०-७-२९", "content_sanskrit": "कोटरारेवतीज्येष्ठापूतनामातृकादयः।\nउन्मादा ये ह्यपस्मारा देहप्राणेन्द्रियद्रुहः॥ १०/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.030.m4a", "display_order": 31}, {"id": 6000203031, "chapter_id": 10203, "verse_number": "१०-७-३०", "content_sanskrit": "स्वप्नदृष्टा महोत्पाता बृहद्बालग्रहाश्च ये।\nसर्वे नश्यन्तु ते विष्णोर्नामग्रहणभीरवः॥ १०/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.031.m4a", "display_order": 32}, {"id": 6000203032, "chapter_id": 10203, "verse_number": "१०-७-३१", "content_sanskrit": "इति प्रणयबद्धाभिर्गोपीभिः कृतरक्षणम्।\nपाययित्वा स्तनं माता सन्न्यवीविशदात्मजम्॥ १०/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.032.m4a", "display_order": 33}, {"id": 6000203033, "chapter_id": 10203, "verse_number": "१०-७-३२", "content_sanskrit": "तावन्नन्दादयो गोपा मधुराया व्रजं गताः।\nविलोक्य पूतनादेहं बभूवुरतिविस्मिताः॥ १०/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.033.m4a", "display_order": 34, "topics": [{"text": "भगवद्भक्तिमाहात्म्यवर्णनम्", "range": "३२–४५"}]}, {"id": 6000203034, "chapter_id": 10203, "verse_number": "१०-७-३३", "content_sanskrit": "नूनं बतर्षिः सञ्जातो योगेशो वा समासतः।\nस एव दृष्टो ह्युत्पातो यथाऽऽहानकदुन्दुभिः॥ १०/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.034.m4a", "display_order": 35}, {"id": 6000203035, "chapter_id": 10203, "verse_number": "१०-७-३४", "content_sanskrit": "कलेवरं परशुभिश्छित्त्वा तत् ते व्रजौकसः।\nदूरे क्षिप्त्वाऽवयवशो ददहुः काष्ठवेष्टितम्॥ १०/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.035.m4a", "display_order": 36}, {"id": 6000203036, "chapter_id": 10203, "verse_number": "१०-७-३५", "content_sanskrit": "दह्यमानस्य देहस्य धूमश्चागरुसौरभः।\nउत्थितः कृष्णनिर्भुक्तसपद्याहतपाप्मनः॥ १०/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.036.m4a", "display_order": 37}, {"id": 6000203037, "chapter_id": 10203, "verse_number": "१०-७-३६", "content_sanskrit": "पूतना लोकबालघ्नी राक्षसी रुधिराशना।\nजिघांसयाऽपि हरये स्तनं दत्वाऽऽप सद्गतिम्॥ १०/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.037.m4a", "display_order": 38}, {"id": 6000203038, "chapter_id": 10203, "verse_number": "१०-७-३७", "content_sanskrit": "किं पुनः श्रद्धया भक्त्या कृष्णाय परमात्मने।\nयच्छन् प्रियतमं किञ्चिद् रक्तास्तन्मातरो यथा॥ १०/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.038.m4a", "display_order": 39}, {"id": 6000203039, "chapter_id": 10203, "verse_number": "१०-७-३८", "content_sanskrit": "पद्भ्यां भक्तहृदिस्थाभ्यां वन्द्याभ्यां लोकवन्दितः।\nअङ्गं यस्याः समाक्रम्य भगवानपिबत् स्तनम्॥ १०/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.039.m4a", "display_order": 40}, {"id": 6000203040, "chapter_id": 10203, "verse_number": "१०-७-३९", "content_sanskrit": "यातुधान्यपि सा स्वर्गमवाप जननीगतिम्।\nकृष्णभुक्तस्तनक्षीराः किमु गावो नु मातरः॥ १०/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.040.m4a", "display_order": 41}, {"id": 6000203041, "chapter_id": 10203, "verse_number": "१०-७-४०", "content_sanskrit": "पयांसि यासामपिबत् पुत्रस्नेहस्रुतान्यलम्।\nभगवान् देवकीपुत्रः कैवल्याद्यखिलार्थदः॥ १०/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.041.m4a", "display_order": 42}, {"id": 6000203042, "chapter_id": 10203, "verse_number": "१०-७-४१", "content_sanskrit": "तासामविरतं कृष्णे कुर्वन्तीनां सुतेक्षणम्।\nन पुनः कल्पते राजन् संसारोऽज्ञानसम्भवः॥ १०/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.042.m4a", "display_order": 43}, {"id": 6000203043, "chapter_id": 10203, "verse_number": "१०-७-४२", "content_sanskrit": "कटधूमस्य सौरभ्यमवघ्राय व्रजौकसः।\nकिमिदं कुत एवेति वदन्तो व्रजमाययुः॥ १०/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.043.m4a", "display_order": 44}, {"id": 6000203044, "chapter_id": 10203, "verse_number": "१०-७-४३", "content_sanskrit": "ते तत्र वर्णितं गोपैः पूतनागमनादिकम्।\nश्रुत्वा तन्निधनं स्वस्ति शिशोरासन् सुविस्मिताः॥ १०/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.044.m4a", "display_order": 45}, {"id": 6000203045, "chapter_id": 10203, "verse_number": "१०-७-४४", "content_sanskrit": "नन्दः स्वपुत्रमादाय प्रोष्यागत उदारधीः।\nमूर्ध्न्युपाघ्राय परमां मुदं लेभे कुरूद्वह॥ १०/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.045.m4a", "display_order": 46}, {"id": 6000203046, "chapter_id": 10203, "verse_number": "१०-७-४५", "content_sanskrit": "य एतत् पूतनामोक्षं कृष्णस्यार्भकचेष्टितम्।\nनिशम्य श्रद्धया मर्त्यो गोविन्दे लभते रतिम्॥ १०/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_007/BhP_10.007.046.m4a", "display_order": 47}, {"id": 6000203047, "chapter_id": 10203, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]