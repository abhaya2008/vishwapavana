[{"id": 7004452000, "chapter_id": 24452, "verse_number": "५-३-१४६-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nअस्माहकं ततो गच्छेत्पितृतीर्थमनुत्तमम् ।\nप्रेतत्वाद्यत्र मुच्यन्ते पिण्डेनैकेन पूर्वजाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004452001, "chapter_id": 24452, "verse_number": "५-३-१४६-२", "content_sanskrit": "युधिष्ठिर उवाच ।\nअस्माहकस्य माहात्म्यं कथयस्व ममानघ ।\nस्नानदानेन यत्पुण्यं तथा पिण्डोदकेन च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004452002, "chapter_id": 24452, "verse_number": "५-३-१४६-३", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nपुरा कल्पे नृपश्रेष्ठ ऋषिदेवसमागमे ।\nप्रश्नः पृष्टो मया तात यथा त्वमनुपृच्छसि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004452003, "chapter_id": 24452, "verse_number": "५-३-१४६-४", "content_sanskrit": "एकत्र सागराः सप्त सप्रयागाः सपुष्कराः ।\nनास्य साम्यं लभन्ते ते नात्र कार्या विचारणा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004452004, "chapter_id": 24452, "verse_number": "५-३-१४६-५", "content_sanskrit": "सोमनाथं तु विख्यातं यत्सोमेन प्रतिष्ठितम् ।\nतत्र सोमग्रहे पुण्यं तत्पुण्यं लभते नरः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004452005, "chapter_id": 24452, "verse_number": "५-३-१४६-६", "content_sanskrit": "मासान्ते पितरो नृणां वीक्षन्ते सन्ततिं स्वकाम् ।\nकश्चिदस्मत्कुलेऽस्माकं पिण्डमत्र प्रदास्यति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004452006, "chapter_id": 24452, "verse_number": "५-३-१४६-७", "content_sanskrit": "प्रपितामहास्तथादित्याः श्रुतिरेषा सनातनी ।\nएवं ब्रुवन्ति देवाश्च ऋषयः सतपोधनाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004452007, "chapter_id": 24452, "verse_number": "५-३-१४६-८", "content_sanskrit": "सकृत्पिण्डोदकेनैव शृणु पार्थिव यत्फलम् ।\nद्वादशाब्दानि राजेन्द्र योगं भुक्त्वा सुशोभनम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004452008, "chapter_id": 24452, "verse_number": "५-३-१४६-९", "content_sanskrit": "युगे युगे महाराज अस्माहके पितामहाः ।\nसर्वदा ह्यवलोकन्त आगच्छन्तं स्वगोत्रजम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004452009, "chapter_id": 24452, "verse_number": "५-३-१४६-१०", "content_sanskrit": "भविष्यति किमस्माकममावास्याप्यमाहके ।\nस्नानं दानं च ये कुर्युः पितॄणां तिलतर्पणम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004452010, "chapter_id": 24452, "verse_number": "५-३-१४६-११", "content_sanskrit": "ते सर्वपापनिर्मुक्ताः सर्वान्कामांल्लभति वै ।\nजलमध्येऽत्र भूपाल अग्नितीर्थं च तिष्ठति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004452011, "chapter_id": 24452, "verse_number": "५-३-१४६-१२", "content_sanskrit": "दर्शनात्तस्य तीर्थस्य पापराशिर्विलीयते ।\nस्नानमात्रेण राजेन्द्र ब्रह्महत्यां व्यपोहति॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004452012, "chapter_id": 24452, "verse_number": "५-३-१४६-१३", "content_sanskrit": "शुक्लाम्बरधरो नित्यं नियतः स जितेन्द्रियः ।\nएककालं तु भुञ्जानो मासं तीर्थस्य सन्निधौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004452013, "chapter_id": 24452, "verse_number": "५-३-१४६-१४", "content_sanskrit": "सुवर्णालंकृतानां तु कन्यानां शतदानजम् ।\nफलमाप्नोति सम्पूर्णं पितृलोके महीयते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004452014, "chapter_id": 24452, "verse_number": "५-३-१४६-१५", "content_sanskrit": "पृथिव्यामासमुद्रायां महाभोगपतिर्भवेत् ।\nधनधान्यसमायुक्तो दाता भवति धार्मिकः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004452015, "chapter_id": 24452, "verse_number": "५-३-१४६-१६", "content_sanskrit": "उपवासी शुचिर्भूत्वा ब्रह्मलोकमवाप्नुयात् ।\nअस्माहकं समासाद्य यस्तु प्राणान् परित्यजेत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004452016, "chapter_id": 24452, "verse_number": "५-३-१४६-१७", "content_sanskrit": "कोटिवर्षसहस्राणि रुद्रलोके महीयते ।\nततः स्वर्गात्परिभ्रष्टः क्षीणकर्मा दिवश्च्युतः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004452017, "chapter_id": 24452, "verse_number": "५-३-१४६-१८", "content_sanskrit": "सुवर्णमणिमुक्ताढ्ये कुले जायेत रूपवान् ।\nकृत्वाभिषेकविधिना हयमेधफलं लभेत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004452018, "chapter_id": 24452, "verse_number": "५-३-१४६-१९", "content_sanskrit": "धनाढ्यो रूपवान्दक्षो दाता भवति धार्मिकः ।\nचतुर्वेदेषु यत्पुण्यं सत्यवादिषु यत्फलम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004452019, "chapter_id": 24452, "verse_number": "५-३-१४६-२०", "content_sanskrit": "तत्फलं लभते नूनं तत्र तीर्थेऽभिषेचनात् ।\nतीर्थानां परमं तीर्थं निर्मितं शम्भुना पुरा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004452020, "chapter_id": 24452, "verse_number": "५-३-१४६-२१", "content_sanskrit": "हृदयेशः स्वयं विष्णुर्जपेद्देवं महेश्वरम् ।\nगन्धर्वाप्सरसश्चैव मरुतो मारुतास्तथा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004452021, "chapter_id": 24452, "verse_number": "५-३-१४६-२२", "content_sanskrit": "विश्वेदेवाश्च पितरः सचन्द्राः सदिवाकराः ।\nमरीचिरत्र्यङ्गिरसौ पुलस्त्यः पुलहः क्रतुः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004452022, "chapter_id": 24452, "verse_number": "५-३-१४६-२३", "content_sanskrit": "प्रचेताश्च वसिष्ठश्च भृगुर्नारद एव च ।\nच्यवनो गालवश्चैव वामदेवो महामुनिः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004452023, "chapter_id": 24452, "verse_number": "५-३-१४६-२४", "content_sanskrit": "वालखिल्याश्च गन्धारास्तृणबिन्दुश्च जाजलिः ।\nउद्दालकश्चर्ष्यशृङ्गो वसिष्ठश्च सनन्दनः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004452024, "chapter_id": 24452, "verse_number": "५-३-१४६-२५", "content_sanskrit": "शुक्रश्चैव भरद्वाजो वात्स्यो वात्स्यायनस्तथा ।\nअगस्तिर्मित्रावरुणौ विश्वामित्रो मुनीश्वरः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004452025, "chapter_id": 24452, "verse_number": "५-३-१४६-२६", "content_sanskrit": "गौतमश्च पुलस्त्यश्च पौलस्त्यः पुलहः क्रतुः ।\nसनातनस्तु कपिलो वाह्निः पञ्चशिखस्तथा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004452026, "chapter_id": 24452, "verse_number": "५-३-१४६-२७", "content_sanskrit": "अन्येऽपि बहवस्तत्र मुनयः शंसितव्रताः ।\nक्रीडन्ति देवताः सर्व ऋषयः सतपोधनाः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004452027, "chapter_id": 24452, "verse_number": "५-३-१४६-२८", "content_sanskrit": "मनुष्याश्चैव योगीन्द्राः पितरः सपितामहाः ।\nअस्माहकेऽत्र तिष्ठन्ति सर्व एव न संशयः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004452028, "chapter_id": 24452, "verse_number": "५-३-१४६-२९", "content_sanskrit": "पितरः पितामहाश्चैव तथैव प्रपितामहाः ।\nयेषां दत्तमुपस्थायि सुकृतं वापि दुष्कृतम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004452029, "chapter_id": 24452, "verse_number": "५-३-१४६-३०", "content_sanskrit": "अक्षयं तत्र तत्सर्वं यत्कृतं योधनीपुरे ।\nमातरं पितरं त्यक्त्वा सर्वबन्धुसुहृज्जनान्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004452030, "chapter_id": 24452, "verse_number": "५-३-१४६-३१", "content_sanskrit": "धनं धान्यं प्रियान्पुत्रांस्तथा देहं नृपोत्तम ।\nगच्छते वायुभूतस्तु शुभाशुभसमन्वितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004452031, "chapter_id": 24452, "verse_number": "५-३-१४६-३२", "content_sanskrit": "अदृश्यः सर्वभूतानां परमात्मा महत्तरः ।\nशुभाशुभगतिं प्राप्तः कर्मणा स्वेन पार्थिव॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004452032, "chapter_id": 24452, "verse_number": "५-३-१४६-३३", "content_sanskrit": "युधिष्ठिर उवाच ।\nशुभाशुभं न बन्धूनां जायते केन हेतुना ।\nएकः प्रसूयते जन्तुरेक एव प्रलीयते॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004452033, "chapter_id": 24452, "verse_number": "५-३-१४६-३४", "content_sanskrit": "एको हि भुङ्क्ते सुकृतमेक एव हि दुष्कृतम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004452034, "chapter_id": 24452, "verse_number": "५-३-१४६-३५", "content_sanskrit": "मार्कण्डेय उवाच ।\nएष त्वयोक्तो नृपते महाप्रश्नः स्मृतो मया॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004452035, "chapter_id": 24452, "verse_number": "५-३-१४६-३६", "content_sanskrit": "पितामहमुखोद्गीतं श्रुतं ते कथयाम्यहम् ।\nयन्मे पितामहात्पूर्वं विज्ञातमृषिसंसदि॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004452036, "chapter_id": 24452, "verse_number": "५-३-१४६-३७", "content_sanskrit": "न माता न पिता बन्धुः कस्यचिन्न सुहृत्क्वचित् ।\nकस्य न ज्ञायते रूपं वायुभूतस्य देहिनः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004452037, "chapter_id": 24452, "verse_number": "५-३-१४६-३८", "content_sanskrit": "यद्येवं न भवेत्तात लोकस्य तु नरेश्वर ।\nअमर्यादं भवेन्नूनं विनश्यति चराचरम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004452038, "chapter_id": 24452, "verse_number": "५-३-१४६-३९", "content_sanskrit": "एवं ज्ञात्वा पूरा राजन्समस्तैर्लोककर्तृभिः ।\nमर्यादा स्थापिता लोके यथा धर्मो न नश्यति॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004452039, "chapter_id": 24452, "verse_number": "५-३-१४६-४०", "content_sanskrit": "धर्मे नष्टे मनुष्याणामधर्मोऽभिभवेत्पुनः ।\nततः स्वधर्मचलनान्नरके गमनं ध्रुवम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004452040, "chapter_id": 24452, "verse_number": "५-३-१४६-४१", "content_sanskrit": "लोको निरङ्कुशः सर्वो मर्यादालङ्घने रतः ।\nमर्यादा स्थापिता तेन शास्त्रं वीक्ष्य महर्षिभिः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004452041, "chapter_id": 24452, "verse_number": "५-३-१४६-४२", "content_sanskrit": "स्नानं दानं जपो होमः स्वाध्यायो देवतार्चनम् ।\nपिण्डोदकप्रदानं च तथैवातिथिपूजनम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004452042, "chapter_id": 24452, "verse_number": "५-३-१४६-४३", "content_sanskrit": "पितरः पितामहाश्चैव तथैव प्रपितामहाः ।\nत्रयो देवाः स्मृतास्तात ब्रह्मविष्णुमहेश्वराः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004452043, "chapter_id": 24452, "verse_number": "५-३-१४६-४४", "content_sanskrit": "पूजितैः पूजिताः सर्वे तथा मातामहास्त्रयः ।\nतस्मात्सर्वप्रयत्नेन श्रुतिस्मृत्यर्थनोदितान्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004452044, "chapter_id": 24452, "verse_number": "५-३-१४६-४५", "content_sanskrit": "धर्मं समाचरन्नित्यं पापांशेन न लिप्यते ।\nश्रुतिस्मृत्युदितं धर्मं मनसापि न लङ्घयेत्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004452045, "chapter_id": 24452, "verse_number": "५-३-१४६-४६", "content_sanskrit": "इह लोके परे चैव यदीच्छेच्छ्रेय आत्मनः ।\nपितापुत्रौ सदाप्येकौ बिम्बाद्बिम्बमिवोद्धृतौ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004452046, "chapter_id": 24452, "verse_number": "५-३-१४६-४७", "content_sanskrit": "विभक्तौ वाविभक्तौ वा श्रुतिस्मृत्यर्थतस्तथा ।\nउद्धरेदात्मनात्मानमात्मानमवसादयेत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004452047, "chapter_id": 24452, "verse_number": "५-३-१४६-४८", "content_sanskrit": "पिण्डोदकप्रदानाभ्यामृते पार्थ न संशयः ।\nएवं ज्ञात्वा प्रयत्नेन पिण्डोदकप्रदो भवेत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004452048, "chapter_id": 24452, "verse_number": "५-३-१४६-४९", "content_sanskrit": "आयुर्धर्मो यशस्तेजः सन्ततिश्चैव वर्धते ।\nपृथिव्यां सागरान्तायां पितृक्षेत्राणि यानि च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004452049, "chapter_id": 24452, "verse_number": "५-३-१४६-५०", "content_sanskrit": "तानि ते सम्प्रवक्ष्यामि येषु दत्तं महाफलम् ।\nगयायां पुष्करे ज्येष्ठे प्रयागे नैमिषे तथा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004452050, "chapter_id": 24452, "verse_number": "५-३-१४६-५१", "content_sanskrit": "संनिहत्यां कुरुक्षेत्रे प्रभासे कुरुनन्दन ।\nपिण्डोदकप्रदानेन यत्फलं कथितं बुधैः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004452051, "chapter_id": 24452, "verse_number": "५-३-१४६-५२", "content_sanskrit": "अस्माहके तदाप्नोति नर्मदायां न संशयः ।\nतत्र ब्रह्मा मुरारिश्च रुद्रश्च उमया सह॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004452052, "chapter_id": 24452, "verse_number": "५-३-१४६-५३", "content_sanskrit": "इन्द्राद्या देवताः सर्वे पितरो मुनयस्तथा ।\nसागराः सरितश्चैव पर्वताश्च बलाहकाः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004452053, "chapter_id": 24452, "verse_number": "५-३-१४६-५४", "content_sanskrit": "तिष्ठन्ति पितरः सर्वे सर्वतीर्थाधिकं ततः ।\nस्थिता ब्रह्मशिला तत्र गजकुम्भनिभा नृप॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004452054, "chapter_id": 24452, "verse_number": "५-३-१४६-५५", "content_sanskrit": "कलौ न दृश्या भवति प्रधानं यद्गयाशिरः ।\nवैशाखे मासि सम्प्राप्तेऽमावास्यां नृपोत्तम॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004452055, "chapter_id": 24452, "verse_number": "५-३-१४६-५६", "content_sanskrit": "व्याप्य सा तिष्ठते तीर्थं गजकुम्भनिभा शिला ।\nतच्च गव्यूतिमात्रं हि तीर्थं ततः प्रवक्षते॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004452056, "chapter_id": 24452, "verse_number": "५-३-१४६-५७", "content_sanskrit": "तस्मिन्दिने तत्र गत्वा यस्तु श्राद्धप्रदो भवेत् ।\nपितॄणामक्षया तृप्तिर्जायते शतवार्षिकी॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004452057, "chapter_id": 24452, "verse_number": "५-३-१४६-५८", "content_sanskrit": "अन्यस्यामप्यमावास्यां यः स्नात्वा विजितेन्द्रियः ।\nकरोति मनुजः श्राद्धं विधिवन्मन्त्रसंयुतम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004452058, "chapter_id": 24452, "verse_number": "५-३-१४६-५९", "content_sanskrit": "तस्य पुण्यफलं यत्स्यात्तच्छृणुष्व नराधिप ।\nअग्निष्टोमाश्वमेधाभ्यां वाजपेयस्य यत्फलम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004452059, "chapter_id": 24452, "verse_number": "५-३-१४६-६०", "content_sanskrit": "तत्फलं समवाप्नोति यथा मे शङ्करोऽब्रवीत् ।\nरौरवादिषु सर्वेषु नरकेषु व्यवस्थिताः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004452060, "chapter_id": 24452, "verse_number": "५-३-१४६-६१", "content_sanskrit": "पिता पितामहाद्याश्च पितृके मातृके तथा ।\nपिण्डोदकेन चैकेन तर्पणेन विशेषतः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004452061, "chapter_id": 24452, "verse_number": "५-३-१४६-६२", "content_sanskrit": "क्रीडन्ति पितृलोकस्था यावदाभूतसम्प्लवम् ।\nये कर्मस्था विकर्मस्था ये जाताः प्रेतकल्मषाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004452062, "chapter_id": 24452, "verse_number": "५-३-१४६-६३", "content_sanskrit": "पिण्डेनैकेन मुच्यन्ते तेऽपि तत्र न संशयः ।\nअस्माहके शिला दिव्या तिष्ठते गजसन्निभा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004452063, "chapter_id": 24452, "verse_number": "५-३-१४६-६४", "content_sanskrit": "ब्रह्मणा निर्मिता पूर्वं सर्वपापक्षयंकरी ।\nउपर्यस्या यथान्यायं पितॄनुद्दिश्य भारत॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004452064, "chapter_id": 24452, "verse_number": "५-३-१४६-६५", "content_sanskrit": "दक्षिणाग्रेषु दर्भेषु दद्यात्पिण्डान्विचक्षणः ।\nभूमौ चान्नेन सिद्धेन श्राद्धं कृत्वा यथाविधि॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004452065, "chapter_id": 24452, "verse_number": "५-३-१४६-६६", "content_sanskrit": "श्राद्धिभ्यो वस्त्रयुग्मानि छत्रोपानत्कमण्डलु ।\nदक्षिणा विविधा देया पितॄनुद्दिश्य भारत॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004452066, "chapter_id": 24452, "verse_number": "५-३-१४६-६७", "content_sanskrit": "यो ददाति द्विजश्रेष्ठ तस्य पुण्यफलं शृणु ।\nतस्य ते द्वादशाब्दानि तृप्तिं यान्ति न संशयः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004452067, "chapter_id": 24452, "verse_number": "५-३-१४६-६८", "content_sanskrit": "अस्माहके महाराज पितरश्च पितामहाः ।\nवायुभूता निरीक्षन्ते आगच्छन्तं स्वगोत्रजम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004452068, "chapter_id": 24452, "verse_number": "५-३-१४६-६९", "content_sanskrit": "अत्र तीर्थे सुतोऽभ्येत्य स्नात्वा तोयं प्रदास्यति ।\nश्राद्धं वा पिण्डदानं वा तेन यास्याम सद्गतिम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004452069, "chapter_id": 24452, "verse_number": "५-३-१४६-७०", "content_sanskrit": "स्नाने कृते तु ये केचिज्जायन्ते वस्त्रविप्लुषः ।\nप्रीणयेन्नरकस्थांस्तु तैः पितॄन्नात्र संशयः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004452070, "chapter_id": 24452, "verse_number": "५-३-१४६-७१", "content_sanskrit": "केशोदबिन्दवस्तस्य ये चान्ये लेपभाजिनः ।\nतृप्यन्त्यनग्निनसंस्कारा यं मृताः स्युः स्वगोत्रजाः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004452071, "chapter_id": 24452, "verse_number": "५-३-१४६-७२", "content_sanskrit": "तत्र तीर्थे तु ये केचिच्छ्राद्धं कृत्वा विधानतः ।\nनरकादुद्धरन्त्याशु जपन्तः पितृसंहिताम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004452072, "chapter_id": 24452, "verse_number": "५-३-१४६-७३", "content_sanskrit": "वनस्पतिगते सोमे यदा सोमदिनं भवेत् ।\nअक्षयाल्लभते लोकान्पिण्डेनैकेन मानवः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004452073, "chapter_id": 24452, "verse_number": "५-३-१४६-७४", "content_sanskrit": "अक्षयं तत्र वै सर्वं जायते नात्र संशयः ।\nनरकादुद्धरन्त्याशु जपन्ते पितृसंहिताम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004452074, "chapter_id": 24452, "verse_number": "५-३-१४६-७५", "content_sanskrit": "तस्मिंस्तीर्थे त्वमावास्यां पितॄनुद्दिश्य भारत ।\nनीलं सर्वाङ्गसम्पूर्णं योऽभिषिच्य समुत्सृजेत्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004452075, "chapter_id": 24452, "verse_number": "५-३-१४६-७६", "content_sanskrit": "तस्य पुण्यफलं वक्तुं न तु वाचस्पतिः क्षमः ।\nअस्माहके वृषोत्सर्गाद्यत्पुण्यं समवाप्यते॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004452076, "chapter_id": 24452, "verse_number": "५-३-१४६-७७", "content_sanskrit": "तव शुश्रूषणात्सर्वं तत्प्रवक्ष्यामि भारत ।\nरौरवादिषु ये किंचित्पच्यन्ते तस्य पूर्वजाः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004452077, "chapter_id": 24452, "verse_number": "५-३-१४६-७८", "content_sanskrit": "वृषोत्सर्गेण तान्सर्वांस्तारयेदेकविंशतिम् ।\nलोहितो यस्तु वर्णेन मुखे पुच्छे च पाण्डुरः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004452078, "chapter_id": 24452, "verse_number": "५-३-१४६-७९", "content_sanskrit": "पिङ्गः खुरविषाणाभ्यां स नीलो वृष उच्यते ।\nयस्तु सर्वाङ्गपिङ्गश्च श्वेतः पुच्छखुरेषु च॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004452079, "chapter_id": 24452, "verse_number": "५-३-१४६-८०", "content_sanskrit": "स पिङ्गो वृष इत्याहुः पितॄणां प्रीतिवर्धनः ।\nपारावतसवर्णश्च ललाटे तिलको भवेत्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004452080, "chapter_id": 24452, "verse_number": "५-३-१४६-८१", "content_sanskrit": "तं वृषं बभ्रुमित्याहुः पूर्णं सर्वाङ्गशोभनम् ।\nसर्वाङ्गेष्वेकवर्णो यः पिङ्गः पुच्छखुरेषु च॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004452081, "chapter_id": 24452, "verse_number": "५-३-१४६-८२", "content_sanskrit": "खुरपिङ्गं तमित्याहुः पितॄणां सद्गतिप्रदम् ।\nनीलं सर्वशरीरेण स्वारक्तनयनं दृढम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004452082, "chapter_id": 24452, "verse_number": "५-३-१४६-८३", "content_sanskrit": "तमेव नीलमित्याहुर्नीलः पञ्चविधः स्मृतः ।\nयस्तु वैश्यगृहे जातः स वै नीलो विशिष्यते॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004452083, "chapter_id": 24452, "verse_number": "५-३-१४६-८४", "content_sanskrit": "न वाहयेद्गृहे जातं वत्सकं तु कदाचन ।\nतेनैव च वृषोत्सर्गे पितॄणामनृणो भवेत्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004452084, "chapter_id": 24452, "verse_number": "५-३-१४६-८५", "content_sanskrit": "जातं तु स्वगृहे वत्सं द्विजन्मा यस्तु वाहयेत् ।\nपतन्ति पितरस्तस्य ब्रह्मकोकगता अपि॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004452085, "chapter_id": 24452, "verse_number": "५-३-१४६-८६", "content_sanskrit": "यथायथा हि पिबति पीत्वा धूनाति मस्तकम् ।\nपिबन्पितॄन् प्रीणयति नरकादुद्धरेद्धुनन्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004452086, "chapter_id": 24452, "verse_number": "५-३-१४६-८७", "content_sanskrit": "यथा पुच्छाभिघातेन स्कन्धं गच्छन्ति बिन्दवः ।\nनरकादुद्धरन्त्याशु पतितान् गोत्रिणस्तथा॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004452087, "chapter_id": 24452, "verse_number": "५-३-१४६-८८", "content_sanskrit": "गर्जन्प्रावृषि काले तु विषाणाभ्यां भुवं लिखन् ।\nखुरेभ्यो या मृदुद्भूता तया संप्रीणयेदृषीन्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004452088, "chapter_id": 24452, "verse_number": "५-३-१४६-८९", "content_sanskrit": "पिबन्पितॄन् प्रीणयते खादनोल्लेखने सुरान् ।\nगर्जन्नृषिमनुष्यांश्च धर्मरूपो हि धर्मज॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004452089, "chapter_id": 24452, "verse_number": "५-३-१४६-९०", "content_sanskrit": "भूतैर्वापि पिशाचैर्वा चातुर्थिकज्वरेण वा ।\nगृहीतोऽस्माहकं गच्छेत्सर्वेषामाधिनाशनम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004452090, "chapter_id": 24452, "verse_number": "५-३-१४६-९१", "content_sanskrit": "स्नात्वा तु विमले तोये दर्भग्रन्थिं निबन्धयेत् ।\nमस्तके बाहुमूले वा नाभ्यां वा गलकेऽपि वा॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004452091, "chapter_id": 24452, "verse_number": "५-३-१४६-९२", "content_sanskrit": "गत्वा देवसमीपं च प्रादक्षिण्येन केशवम् ।\nततः समुच्चरन्मन्त्रं गायत्र्या वाथ वैष्णवम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004452092, "chapter_id": 24452, "verse_number": "५-३-१४६-९३", "content_sanskrit": "नारायणं शरण्येशं सर्वदेवनमस्कृतम् ।\nनमो यज्ञाङ्गसम्भूत सर्वव्यापिन्नमोऽस्तु ते॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004452093, "chapter_id": 24452, "verse_number": "५-३-१४६-९४", "content_sanskrit": "नमो नमस्ते देवेश पद्मगर्भ सनातन ।\nदामोदर जयानन्त रक्ष मां शरणागतम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004452094, "chapter_id": 24452, "verse_number": "५-३-१४६-९५", "content_sanskrit": "त्वं कर्ता त्वं च हर्ता च जगत्यस्मिंश्चराचरे ।\nत्वं पालयसि भूतानि भुवनं त्वं बिभर्षि च॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004452095, "chapter_id": 24452, "verse_number": "५-३-१४६-९६", "content_sanskrit": "प्रसीद देवदेवेश सुप्तमङ्गं प्रबोधय ।\nत्वद्ध्याननिरतो नित्यं त्वद्भक्तिपरमो हरे॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004452096, "chapter_id": 24452, "verse_number": "५-३-१४६-९७", "content_sanskrit": "इति स्तुतो मया देव प्रसादं कुरु मेऽच्युत ।\nमां रक्ष रक्ष पापेभ्यस्त्रायस्व शरणागतम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004452097, "chapter_id": 24452, "verse_number": "५-३-१४६-९८", "content_sanskrit": "एवं स्तुत्वा च देवेशं दानवान्तकरं हरिम् ।\nपुनरुक्तेन वै स्नात्वा ततो विप्रांस्तु भोजयेत्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004452098, "chapter_id": 24452, "verse_number": "५-३-१४६-९९", "content_sanskrit": "वेदोक्तेन विधानेन स्नानं कृत्वा यथाविधि ।\nपिण्डनिर्वपणं कृत्वा वाचयेत्स्वस्तिकं ततः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004452099, "chapter_id": 24452, "verse_number": "५-३-१४६-१००", "content_sanskrit": "एवं स्तुत्वा च देवेशं दानवान्तकरं हरिम् ।\nपुनरुक्तेन वै स्नात्वा ततो विप्रांस्तु भोजयेत्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004452100, "chapter_id": 24452, "verse_number": "५-३-१४६-१०१", "content_sanskrit": "वेदोक्तेन विधानेन स्नानं कृत्वा यथाविधि ।\nएवं तान्वाचयित्वा तु ततो विप्रान्विसर्जयेत्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004452101, "chapter_id": 24452, "verse_number": "५-३-१४६-१०२", "content_sanskrit": "यत्तत्रोच्चरितं किंचित्तद्विप्रेभ्यो निवेदयेत् ।\nतत्र तीर्थे नरः स्नात्वा नारी वा भक्तितत्परा ।\nशक्तितो दक्षिणां दद्यात्कृत्वा श्राद्धं यथाविधि॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004452102, "chapter_id": 24452, "verse_number": "५-३-१४६-१०३", "content_sanskrit": "तत्र तीर्थे नरो यावत्स्नापयेद्विधिपूर्वकम् ।\nक्षीरेण मधुना वापि दध्ना वा शीतवारिणा॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004452103, "chapter_id": 24452, "verse_number": "५-३-१४६-१०४", "content_sanskrit": "तावत्पुष्करपात्रेषु पिबन्ति पितरो जलम् ।\nअयने विषुवे चैव युगादौ सूर्यसंक्रमे॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004452104, "chapter_id": 24452, "verse_number": "५-३-१४६-१०५", "content_sanskrit": "पुष्पैः सम्पूज्य देवेशं नैवेद्यं यः प्रदापयेत् ।\nसोऽश्वमेधस्य यज्ञस्य फलं प्राप्नोति पुष्कलम्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004452105, "chapter_id": 24452, "verse_number": "५-३-१४६-१०६", "content_sanskrit": "तत्र तीर्थे तु यो राजन् सूर्यग्रहणमाचरेत् ।\nसूर्यतेजोनिभैर्यानैर्विष्णुलोके महीयते॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004452106, "chapter_id": 24452, "verse_number": "५-३-१४६-१०७", "content_sanskrit": "तत्र तीर्थे तु यः श्राद्धं पितृभ्यः सम्प्रयच्छति ।\nसत्पुत्रेण च तेनैव सम्प्राप्तं जन्मनः फलम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004452107, "chapter_id": 24452, "verse_number": "५-३-१४६-१०८", "content_sanskrit": "इति श्रुत्वा ततो देवाः सर्वे शक्रपुरोगमाः ।\nब्रह्मविष्णुमहेशाश्च स्थापयांचक्रुरीश्वरम्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004452108, "chapter_id": 24452, "verse_number": "५-३-१४६-१०९", "content_sanskrit": "सर्वरोगोपशमनं सर्वपातकनाशनम् ।\nयस्तु संवत्सरं पूर्णममावास्यां तु भावितः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004452109, "chapter_id": 24452, "verse_number": "५-३-१४६-११०", "content_sanskrit": "पितृभ्यः पिण्डदानं च कुर्यादस्माहके नृप ।\nत्रिपुष्करे गयायां च प्रभासे नैमिषे तथा॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004452110, "chapter_id": 24452, "verse_number": "५-३-१४६-१११", "content_sanskrit": "यत्पुण्यं श्राद्धकर्तॄणां तदिहैव भवेद्ध्रुवम् ।\nतिलोदकं कुशैर्मिश्रं यो दद्याद्दक्षिणामुखः॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004452111, "chapter_id": 24452, "verse_number": "५-३-१४६-११२", "content_sanskrit": "मन्वादौ च युगादौ च व्यतीपाते दिनक्षये ।\nयो दद्यात्पितृमातृभ्यः सोऽश्वमेधफलं लभेत्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004452112, "chapter_id": 24452, "verse_number": "५-३-१४६-११३", "content_sanskrit": "अस्माहके नरो यस्तु स्नात्वा सम्पूजयेद्धरिम् ।\nब्रह्माणं शङ्करं भक्त्या कुर्याज्जागरणक्रियाम्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004452113, "chapter_id": 24452, "verse_number": "५-३-१४६-११४", "content_sanskrit": "सर्वपापविनिर्मुक्तः शक्रातिथ्यमवाप्नुयात् ।\nतत्र तीर्थे नरः स्नात्वा यः पश्यति जनार्दनम्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004452114, "chapter_id": 24452, "verse_number": "५-३-१४६-११५", "content_sanskrit": "विशेषविधिनाभ्यर्च्य प्रणम्य च पुनःपुनः ।\nसपुत्रेण च तेनैव पितॄणां विहिता गतिः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004452115, "chapter_id": 24452, "verse_number": "५-३-१४६-११६", "content_sanskrit": "एकमूर्तिस्त्रयो देवा ब्रह्मविष्णुमहेश्वराः ।\nसत्कार्यकारणोपेताः सुसूक्ष्माः सुमहाफलाः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004452116, "chapter_id": 24452, "verse_number": "५-३-१४६-११७", "content_sanskrit": "एतत्ते कथितं राजन्महापातकनाशनम् ।\nअस्माहकस्य माहात्म्यं किमन्यत्परिपृच्छसि॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]