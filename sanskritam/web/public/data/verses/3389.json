[{"id": 2110456, "chapter_id": 3389, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110457, "chapter_id": 3389, "verse_number": "१", "content_sanskrit": "अचिन्त्यं ब्रह्म निर्द्वन्द्वमैश्वरं हि बलं मम ।\nदैन्यं गर्ह्यं च मे जैह्म्यं न मेऽस्ति यदधर्मतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110458, "chapter_id": 3389, "verse_number": "२", "content_sanskrit": "यः परेषां नरो नित्यमतिवादांस्तितिक्षति ।\nदेवयानि विजानीहि सर्वं तस्य जितं भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110459, "chapter_id": 3389, "verse_number": "३", "content_sanskrit": "यः समुत्पतितं क्रोधं निगृह्णाति हयं यथा ।\nस यन्तेत्युच्यते सद्भिर्न हये रश्मिलम्बिते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110460, "chapter_id": 3389, "verse_number": "४", "content_sanskrit": "यः समुत्पतितं क्रोधमक्रोधेन व्यपास्यति ।\nयथोरगस्त्वचं जीर्णां स वै पुरुष उच्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110461, "chapter_id": 3389, "verse_number": "५", "content_sanskrit": "यो वै मन्युं धारयति योऽतिवादांस्तितिक्षति ।\nयश्च तप्तो न तपति स वै सर्वजितः खलु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110462, "chapter_id": 3389, "verse_number": "६", "content_sanskrit": "यो यजेताश्वमेधेन मासिमासि शतं समाः ।\nतस्मादक्रोधनः श्रेष्ठः कामक्रोधौ हि गर्हितौ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110463, "chapter_id": 3389, "verse_number": "७", "content_sanskrit": "क्रुद्धस्य निष्फलान्येव दानयज्ञतपांसि च ।\nतस्मादक्रोधने यज्ञस्तपो दानं महत्फलम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110464, "chapter_id": 3389, "verse_number": "८", "content_sanskrit": "न पूतो न तपस्वी च न यज्वा न च धर्मकृत् ।\nक्रोधस्य यो वशं गच्छेत् तस्य लोकद्वयं न च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110465, "chapter_id": 3389, "verse_number": "९", "content_sanskrit": "पुत्रभृत्यसुहृन्मित्रभार्या धर्मश्च सत्यता ।\nतस्यैतान्यपयास्यन्ति क्रोधशीलस्य निश्चितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110466, "chapter_id": 3389, "verse_number": "१०", "content_sanskrit": "यत् कुमाराः कुमार्यश्च वैरं कुर्युः स्त्रियोऽपि वा ।\nन तत् प्राज्ञोऽनुकुर्वीत विद्वांस्तस्य बलाबलम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110467, "chapter_id": 3389, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110468, "chapter_id": 3389, "verse_number": "११", "content_sanskrit": "वेदाहं तात बालाऽपि धर्माणां यदिहान्तरम् ।\nआक्रोशे चातिवादे च वेद चापि बलाबलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110469, "chapter_id": 3389, "verse_number": "१२", "content_sanskrit": "स्ववृत्तिमननुष्ठाय धर्ममुत्सृज्य तत्वतः ।\nशिष्यस्याशिष्यवृत्तिर्हि न क्षन्तव्या बुभूषता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110470, "chapter_id": 3389, "verse_number": "१३", "content_sanskrit": "प्रेष्ये शिष्यार्यवृत्तिं हि उत्सृज्य विपथं गते ।\nतस्मात् सङ्कीर्णवृत्तेषु वासो मम न रोचते \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110471, "chapter_id": 3389, "verse_number": "१४", "content_sanskrit": "दह्यमानाः सुतीव्रेण नीचाः परयशोऽग्निना ।\nअशक्तास्तत्पदं गन्तुं ततो निन्दां प्रकुर्वते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110472, "chapter_id": 3389, "verse_number": "१५", "content_sanskrit": "भूयांसं ये हि निन्दन्ति वृत्तेनाभिजनेन च ।\nन तेषु निवसेत् प्राज्ञः श्रेयोऽर्थी पापबुद्धिषु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110473, "chapter_id": 3389, "verse_number": "१६", "content_sanskrit": "ये त्वेनमभिनन्दन्ति वृत्तेनाभिजनेन च ।\nतेषु साधुषु वस्तव्यं स वासः श्रेष्ठ उच्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110474, "chapter_id": 3389, "verse_number": "१७", "content_sanskrit": "सुयन्त्रिता वरा नित्यं विहीनाश्च धनैर्नराः ।\nदुर्वृत्ताः पापकर्माणः चण्डाला धनिनोऽपि च \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110475, "chapter_id": 3389, "verse_number": "१८", "content_sanskrit": "न हि जात्या हि चण्डालाः स्वकर्मविहितैर्विना ।\nधनाभिजनविद्यासु सक्ताश्चण्डालधर्मिणः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110476, "chapter_id": 3389, "verse_number": "१९", "content_sanskrit": "अकारणाद् ये द्विष्यन्ति परिवादं वदन्ति च ।\nन तत्रास्य निवासोऽस्ति पाप्मभिः पापतां व्रजेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110477, "chapter_id": 3389, "verse_number": "२०", "content_sanskrit": "सुकृते दुष्कृते वाऽपि यत्र सज्जति यो नरः ।\nध्रुवं रतिर्भवेत् तत्र तस्मात् तेषां न रोचयेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110478, "chapter_id": 3389, "verse_number": "२१", "content_sanskrit": "वाचा दुरुक्तं तातेह दुहित्रा वृषपर्वणः ।\nनातो दुःखतरं मन्ये त्रिषु लोकेष्वपि ध्रुवम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110479, "chapter_id": 3389, "verse_number": "२२", "content_sanskrit": "निःसंशयो विशेषेण परुषं मर्मकृन्तनम् ।\nसुहृन्मित्रजनास्तेषु सौहृदं च न विद्यते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110480, "chapter_id": 3389, "verse_number": "२३", "content_sanskrit": "यः सपत्ने श्रियं दीप्तां हीनश्रीः पर्युपासते ।\nअवमानमवाप्नोति शनैर्नीचसमागमात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110481, "chapter_id": 3389, "verse_number": "२४", "content_sanskrit": "अतिवादा ये वक्त्रतो निःसरन्ति\nयैराहतः शोचति रात्र्यहानि ।\nशनैर्दुःखं शस्त्रविषाग्निजातं\nरोहेन्न संरोहति वाग्व्रणं तु \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110482, "chapter_id": 3389, "verse_number": "२५", "content_sanskrit": "संरोहेदायुधैश्छिन्नं संरोहेद् दग्धमग्निना ।\nवाक्क्षतं तु न संरोहेदाशरीरं शरीरिणाम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110483, "chapter_id": 3389, "verse_number": "२६", "content_sanskrit": "संरोहति शनैर्विद्धं वनं परशुना हतम् ।\nवाचा दुरुक्तं बीभत्सं न संरोहति वाक्क्षतम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110484, "chapter_id": 3389, "verse_number": "६८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि अष्टषष्टितमोऽध्यायः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110485, "chapter_id": 3389, "verse_number": "१६", "content_sanskrit": "॥ इति सम्भवपर्वणि षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]