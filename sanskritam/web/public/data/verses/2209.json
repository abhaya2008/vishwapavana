[{"id": 2055250, "chapter_id": 2209, "verse_number": "७-१३६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055251, "chapter_id": 2209, "verse_number": "७-१३६-१", "content_sanskrit": "तवात्मजांस्तु पतितान्दृष्ट्वा कर्णः प्रतापवान्।\nक्रोधेन महताऽऽविष्टो निर्विण्णोऽभूत्स जीवितो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055252, "chapter_id": 2209, "verse_number": "७-१३६-२", "content_sanskrit": "आगस्कृतमिवात्मानं मेने चाधिरथिस्तदा।\nयत्प्रत्यक्षं तव सुता भीमेन निहता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055253, "chapter_id": 2209, "verse_number": "७-१३६-३", "content_sanskrit": "भीमसेनस्ततः क्रुद्धः कर्णस्य निशिताञ्शरान्।\nनिचखान् स सम्भ्रान्तः पूर्ववैरमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055254, "chapter_id": 2209, "verse_number": "७-१३६-४", "content_sanskrit": "स भीमं पञ्चभिर्विद्ध्वा राधेयः प्रहसन्निव।\nपुनर्विव्याध सप्तत्या स्वर्णपुङ्खैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055255, "chapter_id": 2209, "verse_number": "७-१३६-५", "content_sanskrit": "अविचिन्त्याथ तान्बाणान्कर्णेनास्तान्वृकोदरः।\nरणे विव्याध राधेयं शरेणानतपर्वणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055256, "chapter_id": 2209, "verse_number": "७-१३६-६", "content_sanskrit": "पुनश्च विशिखैस्तीक्ष्णैर्विद्ध्वा मर्मसु पञ्चभिः।\nधनुश्चिच्छेद भल्लेन सूत पुत्रस्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055257, "chapter_id": 2209, "verse_number": "७-१३६-७", "content_sanskrit": "अथान्यद्धनुरादाय कर्णो भारत दुर्मनाः।\nइषुभिश्छादयामास मीमसेनं परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055258, "chapter_id": 2209, "verse_number": "७-१३६-८", "content_sanskrit": "तस्य भीमो हयान्हत्वा विनिहत्य च सारथिम्।\nप्रजहास महाहासं कृतप्रतिकृतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055259, "chapter_id": 2209, "verse_number": "७-१३६-९", "content_sanskrit": "इषुभिः कार्मुकं चास्य चकर्त पुरुषर्षभः।\nतत्पपात महाराज स्वर्णपृष्ठं महास्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055260, "chapter_id": 2209, "verse_number": "७-१३६-१०", "content_sanskrit": "अवारोहद्रथात्तस्मादथ कर्णो महारथः।\nगदां गृहीत्वा समरे भीमाय प्राहिणोद्रुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055261, "chapter_id": 2209, "verse_number": "७-१३६-११", "content_sanskrit": "तामापतन्तीमालक्ष्य भीमसेनो महागदाम्।\nशरैरवारयद्राजन्सर्वसैन्यस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055262, "chapter_id": 2209, "verse_number": "७-१३६-१२", "content_sanskrit": "ततो बाणसहस्राणि प्रेषयामास पाण्डवः।\nसूतपुत्रवधाकाङ्क्षी त्वरमाणः पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055263, "chapter_id": 2209, "verse_number": "७-१३६-१३", "content_sanskrit": "तानिषूनिषुभिः कर्णो वारयित्वा महामृधे।\nकवचं भीमसेनस्य पाटयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055264, "chapter_id": 2209, "verse_number": "७-१३६-१४", "content_sanskrit": "अथैनं पञ्चविंशत्या नाराचानां समार्पयत्।\nपश्यतां सर्वसैन्यानां तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055265, "chapter_id": 2209, "verse_number": "७-१३६-१५", "content_sanskrit": "ततो भीमो महाबाहुर्नवभिर्नतपर्वभिः।\nप्रेषयामास सङ्क्रुद्धः सूतपुत्रस्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055266, "chapter_id": 2209, "verse_number": "७-१३६-१६", "content_sanskrit": "ते तस्य कवचं भित्त्वा तथा बाहुं च दक्षिणम्।\nअभ्ययुर्धरणीं तीक्ष्णा वल्मीकमिव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055267, "chapter_id": 2209, "verse_number": "७-१३६-१७", "content_sanskrit": "स च्छाद्यमानो बाणौधैर्भीमसेनधनुश्च्युतैः।\nपुनरेवाभवत्कर्णो भीमसेनात्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055268, "chapter_id": 2209, "verse_number": "७-१३६-१८", "content_sanskrit": "तं पराङ्मुखमालोक्य पदातिं सूतनन्दनम्।\nकौन्तेयशरसञ्छन्नं राजा दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055269, "chapter_id": 2209, "verse_number": "७-१३६-१९", "content_sanskrit": "त्वरध्वं सर्वतो यत्ता राधेयस्य रथं प्रति।\nततस्तव सुता राजञ्श्रुत्वा भ्रातुर्वचो द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055270, "chapter_id": 2209, "verse_number": "७-१३६-२०", "content_sanskrit": "अभ्ययुः पाण्डवं युद्धे विसृजन्तः शिलीमुखान्।\nचित्रोपचित्रश्चित्राक्षश्चारुचित्रः शरासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055271, "chapter_id": 2209, "verse_number": "७-१३६-२१", "content_sanskrit": "चित्रायुधश्चित्रवर्मा समरे चित्रयोधिनः।\nतानापतत एवाशु भीमसेनो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055272, "chapter_id": 2209, "verse_number": "७-१३६-२२", "content_sanskrit": "एकैकेन शरेणाजौ पातयामास ते सुतान्।\nते हता न्यपतन्भूमौ वातरूग्णा इव द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055273, "chapter_id": 2209, "verse_number": "७-१३६-२३", "content_sanskrit": "दृष्ट्वा विनिहतान्पुत्रांस्तव राजन्महारथान्।\nअश्रुपूर्णमुखः कर्णः क्षत्तुः सस्मार तद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055274, "chapter_id": 2209, "verse_number": "७-१३६-२४", "content_sanskrit": "रथं चान्यं समास्थाय विधिवत्कल्पितं पुनः।\nअभ्ययात्पाण्डवं युद्धे त्वरमाणः पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055275, "chapter_id": 2209, "verse_number": "७-१३६-२५", "content_sanskrit": "तावन्योन्यं शरैर्भित्त्वा स्वर्णपुङ्खैः शिलाशितैः।\nव्यभ्राजेतां यथा मेघौ संस्यूतौ सूर्यरश्मिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055276, "chapter_id": 2209, "verse_number": "७-१३६-२६", "content_sanskrit": "षट्त्रिंशद्भिस्ततो भल्लैर्निशितैस्तिग्मतेजनैः।\nव्यधमत्कवनं क्रुद्धः सूतपुत्रस्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055277, "chapter_id": 2209, "verse_number": "७-१३६-२७", "content_sanskrit": "सूतपुत्रोऽपि कौन्तेयं शरैः सन्नतपर्वभिः।\nपञ्चाशता महाबाहुर्विव्याध भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055278, "chapter_id": 2209, "verse_number": "७-१३६-२८", "content_sanskrit": "रक्तचन्दनदिग्धाङ्गौ शरैः कृतमहाव्रणौ।\nशोणिताक्तौ व्यराजेतां कालसूर्याविवोदितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055279, "chapter_id": 2209, "verse_number": "७-१३६-२९", "content_sanskrit": "तौ शोणितोक्षितैर्गात्रैः शरैश्छिन्नतनुच्छदौ।\nविवृताङ्गौ व्यराजेतां निर्मुक्ताविव पन्नगौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055280, "chapter_id": 2209, "verse_number": "७-१३६-३०", "content_sanskrit": "`क्रोधाग्नितेजसा दिप्तौ संरम्भाद्रक्तलोचनौ।\nव्यभ्राजेतां महाराज विधूमाविव पावकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055281, "chapter_id": 2209, "verse_number": "७-१३६-३१", "content_sanskrit": "व्याघ्राविव नरव्याघ्रौ दंष्ट्राभिरितरेतरम्।\nशरधारासृजौ वीरौ मेघाविव ववर्षतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055282, "chapter_id": 2209, "verse_number": "७-१३६-३२", "content_sanskrit": "वारणाविव चान्योन्यं विषाणाभ्यामरिन्दमौ।\nनिर्भिन्दन्तौ स्वगात्राणि सायकैश्चारु रेजतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055283, "chapter_id": 2209, "verse_number": "७-१३६-३३", "content_sanskrit": "नादयन्तौ प्रहर्षन्तौ विक्रीडन्तौ परस्परम्।\nमण्डलानि विकुर्वाणौ रथाभ्यां रथिषूत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055284, "chapter_id": 2209, "verse_number": "७-१३६-३४", "content_sanskrit": "वृषाविवाथ नर्दन्तौ बलिनौ वासितान्तरे।\nसिंहाविव पराक्रान्तौ नरसिंहौ महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055285, "chapter_id": 2209, "verse_number": "७-१३६-३५", "content_sanskrit": "परस्परं वीक्षमाणौ क्रोधसंरक्तलोचनौ।\nयुयुधाते महावीर्यौ शक्रवैरोचनी यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055286, "chapter_id": 2209, "verse_number": "७-१३६-३६", "content_sanskrit": "ततो भीमो महाबाहुर्बाहुभ्यां विक्षिपन्धनुः।\nव्यराजत रणे राजन्सविद्युदिव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055287, "chapter_id": 2209, "verse_number": "७-१३६-३७", "content_sanskrit": "सनेमिघोषस्तनितश्चापविद्युच्छराम्बुभिः।\nभीमसेनमहामेघः कर्णपर्वतमावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055288, "chapter_id": 2209, "verse_number": "७-१३६-३८", "content_sanskrit": "ततः शरसहस्रेण सम्यगस्तेन भारत।\nपाण्डवो व्यकिरत्कर्णं भीमो भीमपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055289, "chapter_id": 2209, "verse_number": "७-१३६-३९", "content_sanskrit": "तत्रापश्यंस्तव सुता भीमसेनस्य विक्रमम्।\nसुपुङ्खैः कङ्कवासोभिर्यत्कर्णं छादयञ्शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055290, "chapter_id": 2209, "verse_number": "७-१३६-४०", "content_sanskrit": "स नन्दयन्रणे पार्थं केशवं च यशस्विनम्।\nसात्यकिं चक्ररक्षौ च भीमः कर्णमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055291, "chapter_id": 2209, "verse_number": "७-१३६-४१", "content_sanskrit": "विक्रमं भुजयोर्वीर्यं धैर्यं च विदितात्मनः।\nपुत्रास्तव महाराज दृष्ट्वा विमनसोऽभवन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2055292, "chapter_id": 2209, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे षट्त्रिंशदधिकशततमोऽध्यायः॥ १३६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३६-१० अवारोहदवातरत्॥ ५-१३६-२० चित्रोपचित्रः चित्रश्चासावुपचित्रश्चेति चित्रोपचित्रः॥ ५-१३६-१३६ षट्त्रिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]