[{"id": 7002550000, "chapter_id": 22550, "verse_number": "१-२१२-१", "content_sanskrit": "सुमंतुरुवाच ।\nइत्येषा कथिता वीर अर्कसंपुटिका तव ।\nद्वितीया मरिचैर्या तु शृणुष्व गदतो मम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002550001, "chapter_id": 22550, "verse_number": "१-२१२-२", "content_sanskrit": "शुक्लपक्षे तु चैत्रस्य षष्ठ्यां सम्यगुपोषितः ।\nपूजयेद्भास्करं भक्त्या सौरधर्मविधानतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002550002, "chapter_id": 22550, "verse_number": "१-२१२-३", "content_sanskrit": "शतानीक उवाच ।\nब्रूहि सर्वान्मम ब्रह्मन्मंत्रान्पुण्यान्विशेषतः ।\nसूर्यादिहृदयं चापि शिरोन्यासयुतांस्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002550003, "chapter_id": 22550, "verse_number": "१-२१२-४", "content_sanskrit": "सुमंतुरुवाच ।\nअहं ते कथयिष्यामि रहस्यं परमं विभो ।\nयदुक्तं ब्रह्मणा पूर्वं भक्त्या भानोर्महात्मनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002550004, "chapter_id": 22550, "verse_number": "१-२१२-५", "content_sanskrit": "सर्वपापक्षयार्थाय तच्छृणुष्व महामते ।\nसर्वपापहरं पुण्यमादित्यं लोकपूजि तम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002550005, "chapter_id": 22550, "verse_number": "१-२१२-६", "content_sanskrit": "शिखादामसमायुक्तं वकारामृतमुत्तमम् ।\nॐ वं फट् ।\nॐ एष सूर्यः स्वयं तात मंत्रमूर्तिर्महाबलः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002550006, "chapter_id": 22550, "verse_number": "१-२१२-७", "content_sanskrit": "अस्यानुस्मरणान्मंत्री नित्यं मधुरभोजनः ।\nसंवत्सरेण देवेशं साक्षाद्भानुं प्रपश्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002550007, "chapter_id": 22550, "verse_number": "१-२१२-८", "content_sanskrit": "व्याधिमृत्योश्च निर्मुक्तः सूर्यलोकं स गच्छति ।\nसततं जपमानस्तु राजन्मंत्रविदां वरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002550008, "chapter_id": 22550, "verse_number": "१-२१२-९", "content_sanskrit": "मनसा कर्मणा वाचा शापानुग्रहतोपि वा ।\nक्षीराशी मौनमाश्रित्य विविक्ते नियतेन्द्रियः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002550009, "chapter_id": 22550, "verse_number": "१-२१२-१०", "content_sanskrit": "जपित्वा द्वादशलक्षं सशरीरो दिवं व्रजेत् ।\nत्रैलोक्यं चरते राजंश्चिंतामणिरिवेच्छया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002550010, "chapter_id": 22550, "verse_number": "१-२१२-११", "content_sanskrit": "अथेदं परमं वामं सूर्यस्य हृदयं शृणु ।\nस्मर्तव्यं शुचिना नित्यं सर्वपापभयाप हम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002550011, "chapter_id": 22550, "verse_number": "१-२१२-१२", "content_sanskrit": "वियुक्तं चंद्रसंयुक्तमृकारेण च भारत ।\nओंकारदीपितं चैव हृदयं परिकीर्तितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002550012, "chapter_id": 22550, "verse_number": "१-२१२-१३", "content_sanskrit": "यकारबिंदुसंयुक्तं वैशाखः कथितो बुधैः ।\nयकारश्च वकारश्च मात्रा बिंदुस्तथा नृप ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002550013, "chapter_id": 22550, "verse_number": "१-२१२-१४", "content_sanskrit": "इष्टं कवचमादिष्टमस्त्रं वक्ष्ये निबोध मे ।\nप्रणवादिं दुकारं च सानुस्वारं कटस्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002550014, "chapter_id": 22550, "verse_number": "१-२१२-१५", "content_sanskrit": "इदमस्त्रं स्मृतं राजन्नमृतं च निबोध मे ।\nबिंदुचंद्रसमायुक्तं वकारममृतं स्मृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002550015, "chapter_id": 22550, "verse_number": "१-२१२-१६", "content_sanskrit": "ॐ ब्रह्मन्नस्त्रममृतं गायत्रीं चापि ते रोगं धेनुर्वै परिकीर्तितम् ।\nयकारश्च वकारश्च रिरोवेत्रमादिशेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002550016, "chapter_id": 22550, "verse_number": "१-२१२-१७", "content_sanskrit": "व्यनेत्र एतान्यंगानि सूर्यस्यामिततेजसः ।\nआदित्यं मूर्ध्नि विन्यस्य हृदये हृदयं न्यसेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002550017, "chapter_id": 22550, "verse_number": "१-२१२-१८", "content_sanskrit": "सावित्रीं कंठदेशे तु अशेषं मूर्ध्नि चिंतयेत् ।\nअर्कन्यासो मयाख्यातो विद्वान्न्यासं प्रकल्पयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002550018, "chapter_id": 22550, "verse_number": "१-२१२-१९", "content_sanskrit": "एकाक्षरस्य सूर्यस्य शृण्वर्चनविधिं परम् ।\nप्रथमं किंकिणीमुद्रां बद्ध्वा तु हृदये नृप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002550019, "chapter_id": 22550, "verse_number": "१-२१२-२०", "content_sanskrit": "प्राणायामे च तथा परिवीरसमन्वितम् ।\nएकाक्षरं समावेत्ति आत्मशुद्ध्यर्थमादरात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002550020, "chapter_id": 22550, "verse_number": "१-२१२-२१", "content_sanskrit": "पुनस्त्वामेव वध्यं तु वकारेणात्मना लभेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002550021, "chapter_id": 22550, "verse_number": "१-२१२-२२", "content_sanskrit": "एतत्कृत्वादित्यसमो भवतीति न संशयः ।\nकृत्वा च मुद्रां प्रासादे अस्त्रं योज्य महीपते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002550022, "chapter_id": 22550, "verse_number": "१-२१२-२३", "content_sanskrit": "प्रासादशोभनं स्याद्वै कृत्वा तद्भरतर्षभ ।\nकवचेनार्कवाञ्छत्रुं क्षालयेद्वर्धनक्रियाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002550023, "chapter_id": 22550, "verse_number": "१-२१२-२४", "content_sanskrit": "ततोर्घ्यपात्रं पुष्पैश्च पूजयेद्विधिवनृप ।\nहृदिना स्नापयेद्देवं ततः पूजां समाचरेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002550024, "chapter_id": 22550, "verse_number": "१-२१२-२५", "content_sanskrit": "पद्ममुद्रा पुष्पगर्भा देवं शिरसि विन्यसेत् ।\nआवाहितो भवेदेवं देवदेवो दिवाकरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002550025, "chapter_id": 22550, "verse_number": "१-२१२-२६", "content_sanskrit": "हृदयेनार्घ्यसंयुक्तां पूजां बध्नीत भारत ।\nहृदयेन च नैवेद्यं दातव्यं शक्तितो विभोः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002550026, "chapter_id": 22550, "verse_number": "१-२१२-२७", "content_sanskrit": "यथाशक्ति जपं कुर्यात्सुव्रती वाग्यतेन्द्रियः ।\nअनेन विधिना राजन्सर्वका र्याणि साधयेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002550027, "chapter_id": 22550, "verse_number": "१-२१२-२८", "content_sanskrit": "न क्वचित्प्रतिघातः स्यान्न चापि दुरितं भवेत् ।\nव्योममुद्रां परां बद्ध्वा कृत्वा चापि प्रदक्षिणम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002550028, "chapter_id": 22550, "verse_number": "१-२१२-२९", "content_sanskrit": "देवं विसर्जयेत्पश्चाद्धृदयेन महीपते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]