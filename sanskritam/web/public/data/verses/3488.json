[{"id": 2115599, "chapter_id": 3488, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115600, "chapter_id": 3488, "verse_number": "१", "content_sanskrit": "तेन शब्देन वित्रस्तो जनस्तस्याथ रक्षसः ।\nनिष्पपात गृहाद् राजन् सहैव परिचारिभिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115601, "chapter_id": 3488, "verse_number": "२", "content_sanskrit": "भीमेन ददृशुश्चैनं बकं च विनिपातितम् ।\nततस्तु निहतं दृष्ट्वा राक्षसेन्द्रं महाबलम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115602, "chapter_id": 3488, "verse_number": "३", "content_sanskrit": "बकाः परमसन्त्रस्ता भीमं शरणमाययुः ।\nतान् भीतान् विगतज्ञानान् भीमः प्रहरतां वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115603, "chapter_id": 3488, "verse_number": "४", "content_sanskrit": "सान्त्वयामास बलवान् समये च न्यवेदयत् ।\nन हिंस्या मानुषा भूयो युष्माभिरिह कर्हिचित्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115604, "chapter_id": 3488, "verse_number": "५", "content_sanskrit": "हिंसतां च वधः शीघ्रमेवमेव भविष्यति ।\nतस्य तद्वचनं श्रुत्वा तानि रक्षांसि भारत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115605, "chapter_id": 3488, "verse_number": "६", "content_sanskrit": "एवमस्त्विति तं प्राहुर्जगृहुः समयं च तम् ।\nसगणस्तु बकभ्राता प्राणमत् पाण्डवं तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115606, "chapter_id": 3488, "verse_number": "७", "content_sanskrit": "ततः प्रभृति रक्षांसि तत्र सौम्यानि भारत ।\nनगरे प्रत्यदृश्यन्त नरैर्नगरवासिभिः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115607, "chapter_id": 3488, "verse_number": "८", "content_sanskrit": "ततो भीमस्तमादाय गतासुं पुरुषादकम् ।\nनिष्कर्णनेत्रं निर्जिह्वं निःसञ्ज्ञं कण्ठपीडनात् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115608, "chapter_id": 3488, "verse_number": "९", "content_sanskrit": "कुर्वन् बहुविधां चेष्टां पुरद्वारमकर्षत ।\nस एव राक्षसो नूनं पुनरायाति नः पुरीम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115609, "chapter_id": 3488, "verse_number": "१०", "content_sanskrit": "सबालवृद्धाः पुरुषा इति भीताः प्रदुद्रुवुः ।\nद्वारदेशे विनिक्षिप्य नगरस्य जगाम ह \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115610, "chapter_id": 3488, "verse_number": "११", "content_sanskrit": "ततः स भीमस्तं हत्वा गत्वा ब्राह्मणवेश्म तत् ।\nबलीवर्दौ च शकटं ब्राह्मणाय न्यवेदयत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115611, "chapter_id": 3488, "verse_number": "१२", "content_sanskrit": "आचचक्षेऽथ तत्सर्वं रात्रौ युद्धमभूद् यथा ।\nततो नरा विनिष्क्रम्य नागराः काल्यमेव तु \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115612, "chapter_id": 3488, "verse_number": "१३", "content_sanskrit": "ददृशुर्निहितं भूमौ राक्षसं रुधिरोक्षितम् ।\nतमद्रिकूटप्रतिमं विनिष्कीर्णं भयावहम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115613, "chapter_id": 3488, "verse_number": "१४", "content_sanskrit": "एकचक्रां पुनर्गत्वा प्रवृत्तिं प्रददुः पुरे ।\nततः सहस्रशो राजन् नरा नगरवासिनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115614, "chapter_id": 3488, "verse_number": "१५", "content_sanskrit": "तत्राजग्मुर्बकं द्रष्टुं सस्त्रीका वृद्धबालकाः ।\nततस्ते विस्मिताः सर्वे कर्म दृष्ट्वाऽतिमानुषम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115615, "chapter_id": 3488, "verse_number": "१६", "content_sanskrit": "दैवतान्यर्चयामासुः सर्व एव विशाम्पते ।\nततः परीक्षयामासुः कस्य वारोऽद्य भोजने \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115616, "chapter_id": 3488, "verse_number": "१७", "content_sanskrit": "ज्ञात्वा चागम्य तं विप्रं पप्रच्छुः सर्वमेव तत् ।\nएवं पृष्टो बहुविधं रक्षमाणश्च पाण्डवान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115617, "chapter_id": 3488, "verse_number": "१८", "content_sanskrit": "उवाच नागरान् सर्वान् काश्यपो नामतस्तदा ।\nआज्ञापितं मामनिशं रुदन्तं सह बन्धुभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115618, "chapter_id": 3488, "verse_number": "१९", "content_sanskrit": "ददर्श ब्राह्मणः कश्चिन्मन्त्रसिद्धो महाबलः ।\nपरिपृच्छ्य स मां पूर्वं परिक्लेशं पुरस्य च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115619, "chapter_id": 3488, "verse_number": "२०", "content_sanskrit": "अब्रवीद् ब्राह्मणश्रेष्ठ आश्वास्य प्रहसन्निव ।\nप्रापयिष्याम्यहं तस्मा इदमन्नं दुरात्मने \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115620, "chapter_id": 3488, "verse_number": "२१", "content_sanskrit": "मन्निमित्तं भयं चापि न कार्यमिति वीर्यवान् ।\nस तदन्नमुपादाय गतो बकवनं प्रति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115621, "chapter_id": 3488, "verse_number": "२२", "content_sanskrit": "तेन नूनं भवेदेतत् कर्म लोकहितं कृतम् ।\nततस्ते ब्राह्मणाः सर्वे क्षत्रियाश्च सुविस्मिताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115622, "chapter_id": 3488, "verse_number": "२३", "content_sanskrit": "वैश्याः शूद्राश्च मुदिताः चक्रुर्ब्रह्ममहं तदा ।\nततो जानपदाः सर्व आजग्मुर्नगरं प्रति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115623, "chapter_id": 3488, "verse_number": "२४", "content_sanskrit": "तमद्भुततमं द्रष्टुं पार्थास्तत्रैव चाभवन् ।\nवेत्रकीयगृहे सर्वे परिवार्य वृकोदरम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115624, "chapter_id": 3488, "verse_number": "२५", "content_sanskrit": "विस्मयादभ्यगच्छंस्तं भीमं भीमपराक्रमम् ।\nन वै न सम्भवेत् सर्वं ब्राह्मणेषु महात्मसु \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115625, "chapter_id": 3488, "verse_number": "समाप्तिः", "content_sanskrit": "इति सत्कृत्य तं पौराः परिवव्रुः समन्ततः ।\nअयं त्राताऽर्थिनः सर्वान् पितेव परमार्थवित् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115626, "chapter_id": 3488, "verse_number": "२७", "content_sanskrit": "अस्य शुश्रूषया पादौ प्रतिवारमुपास्महे ।\nपशुमद्दधिमच्चास्य वारं भक्तमुपाहरन् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115627, "chapter_id": 3488, "verse_number": "२८", "content_sanskrit": "तस्मिन् हते ते पुरुषा भीताः समनुबोधनाः ।\nततः सम्प्रादवन् पार्थाः सह मात्रा परन्तपाः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115628, "chapter_id": 3488, "verse_number": "२९", "content_sanskrit": "आगच्छन्नेकचक्रां ते पाण्डवाः संशितव्रताः ।\nवैदिकाध्ययने युक्ता जटिला ब्रह्मचारिणः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115629, "chapter_id": 3488, "verse_number": "३०", "content_sanskrit": "अवसंस्ते च तत्रापि ब्राह्मणस्य निवेशने ।\nमात्रा सहैकचक्रायां दीर्घकालं सुखोषिताः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115630, "chapter_id": 3488, "verse_number": "१६७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तषष्ठ्यधिकशततमोऽध्यायः ॥१६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115631, "chapter_id": 3488, "verse_number": "८", "content_sanskrit": "॥ इति बकवधपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115632, "chapter_id": 3488, "verse_number": "", "content_sanskrit": "॥ समाप्तं बकवधपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115633, "chapter_id": 3488, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]