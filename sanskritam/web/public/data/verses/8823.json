[{"id": 40001226, "chapter_id": 8823, "verse_number": "1", "content_sanskrit": "पुत्रांश्चिरगतान् ज्ञात्वा सगरो रघुनन्दन। नप्तारमब्रवीद्राजा दीप्यमानं स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001227, "chapter_id": 8823, "verse_number": "2", "content_sanskrit": "शूरश्च कृतविद्यश्च पूर्वैस्तुल्योऽसि तेजसा। पितृ़णां गतिमन्विच्छ येन चाश्वोऽपवाहित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001228, "chapter_id": 8823, "verse_number": "3", "content_sanskrit": "अन्तर्भौमानि सत्त्वानि वीर्यवन्ति महान्ति च। तेषां त्वं प्रतिघातार्थं सास्त्रं गृह्णीष्व कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001229, "chapter_id": 8823, "verse_number": "4", "content_sanskrit": "अभिवाद्याभिवाद्यांस्त्वं हत्वा विघ्नकरानपि। सिद्धार्थस्सन्निवर्तस्व मम यज्ञस्य पारग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001230, "chapter_id": 8823, "verse_number": "5", "content_sanskrit": "एवमुक्तोंऽशुमान्सम्यक् सगरेण महात्मना। धनुरादाय खड्गं च जगाम लघुविक्रम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001231, "chapter_id": 8823, "verse_number": "6", "content_sanskrit": "स खातं पितृभिर्मार्गमन्तर्भौमं महात्मभि:। प्रापद्यत नरश्रेष्ठ तेन राज्ञाऽभिचोदित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001232, "chapter_id": 8823, "verse_number": "7", "content_sanskrit": "दैत्यदानवरक्षोभि: पिशाचपतगोरगै:। पूज्यमानं महातेजा दिशागजमपश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001233, "chapter_id": 8823, "verse_number": "8", "content_sanskrit": "स तं प्रदक्षिणं कृत्वा पृष्ट्वा चापि निरामयम्। पितृ़न् स परिपप्रच्छ वाजिहर्तारमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001234, "chapter_id": 8823, "verse_number": "9", "content_sanskrit": "दिशागजस्तु तच्छ्रुत्वा प्रत्याहांशुमतो वच:। आसमञ्ज कृतार्थस्त्वं सहाश्वश्शीघ्रमेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001235, "chapter_id": 8823, "verse_number": "10", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सर्वानेव दिशागजान्। यथाक्रमं यथान्यायं प्रष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001236, "chapter_id": 8823, "verse_number": "11", "content_sanskrit": "तैश्च सर्वैर्दिशापालैर्वाक्यज्ञैर्वाक्यकोविदै:। पूजितस्सहयश्चैव गन्ताऽसीत्यभिचोदित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001237, "chapter_id": 8823, "verse_number": "12", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा जगाम लघुविक्रम:। भस्मराशीकृता यत्र पितरस्तस्य सागरा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001238, "chapter_id": 8823, "verse_number": "13", "content_sanskrit": "स दु:खवशमापन्नस्त्वसमञ्जसुतस्तदा। चुक्रोश परमार्तस्तु वधात्तेषां सुदु:खित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001239, "chapter_id": 8823, "verse_number": "14", "content_sanskrit": "यज्ञीयं च हयं तत्र चरन्तमविदूरत:। ददर्श पुरुषव्याघ्रो दु:खशोकसमन्वित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001240, "chapter_id": 8823, "verse_number": "15", "content_sanskrit": "स तेषां राजपुत्राणां कर्तुकामो जलक्रियाम् । सलिलार्थी महातेजा न चापश्यज्जलाशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001241, "chapter_id": 8823, "verse_number": "16", "content_sanskrit": "विसार्य निपुणां दृष्टिं ततोऽपश्यत्खगाधिपम् । पितृ़णां मातुलं राम सुपर्णमनिलोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001242, "chapter_id": 8823, "verse_number": "17", "content_sanskrit": "स चैवमब्रवीद्वाक्यं वैनतेयो महाबल :। मा शुच: पुरुषव्याघ्र वधोऽयं लोकसम्मत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001243, "chapter_id": 8823, "verse_number": "18", "content_sanskrit": "कपिलेनाप्रमेयेन दग्धा हीमे महाबला:। सलिलं नार्हसि प्राज्ञ दातुमेषां हि लौकिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001244, "chapter_id": 8823, "verse_number": "19", "content_sanskrit": "गङ्गा हिमवतो ज्येष्ठा दुहिता पुरुषर्षभ। तस्यां कुरु महाबाहो पितृ़णां तु जलक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001245, "chapter_id": 8823, "verse_number": "20", "content_sanskrit": "भस्मराशीकृतानेतान् प्लावयेल्लोकपावनी। तया क्लिन्नमिदं भस्म गङ्गया लोककान्तया ॥ षष्टिं पुत्रसहस्राणि स्वर्गलोकं च नेष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001246, "chapter_id": 8823, "verse_number": "21", "content_sanskrit": "गच्छ चाश्वं महाभाग तं गृह्य पुरुषर्षभ ॥ यज्ञं पैतामहं वीर संवर्तयितुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001247, "chapter_id": 8823, "verse_number": "22", "content_sanskrit": "सुपर्णवचनं श्रुत्वा सोंऽशुमानतिवीर्यवान् ॥ त्वरितं हयमादाय पुनरायान्महायशा:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001248, "chapter_id": 8823, "verse_number": "23", "content_sanskrit": "ततो राजानमासाद्य दीक्षितं रघुनन्दन ॥ न्यवेदयद्यथावृत्तं सुपर्णवचनं तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40001249, "chapter_id": 8823, "verse_number": "24", "content_sanskrit": "तच्छ्रुत्वा घोरसङ्काशं वाक्यमंशुमतो नृप: ॥ यज्ञं निवर्तयामास यथाकल्पं यथाविधि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40001250, "chapter_id": 8823, "verse_number": "25", "content_sanskrit": "स्वपुरं चागमच्छ्रीमानिष्टयज्ञोमहीपति: ॥ गङ्गायाश्चागमे राजा निश्चयं नाध्यगच्छत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40001251, "chapter_id": 8823, "verse_number": "26", "content_sanskrit": "अकृत्वा निश्चयं राजा कालेन महता महान् । त्रिंशद्वर्षसहस्राणि राज्यं कृत्वा दिवं गत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]