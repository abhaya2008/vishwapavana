[{"id": 2050681, "chapter_id": 2110, "verse_number": "७-३७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050682, "chapter_id": 2110, "verse_number": "७-३७-१", "content_sanskrit": "तां प्रभाग्नां चमूं दृष्ट्वा सौभद्रेणामितौजसा।\nदुर्योधनो भृशं क्रुद्धः स्वयं सौभद्रमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050683, "chapter_id": 2110, "verse_number": "७-३७-२", "content_sanskrit": "ततो राजानमावृत्तं सौभद्रं प्रति संयुगे।\nदृष्ट्वा द्रोणोऽब्रवीद्योधान्परीप्सध्वं नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050684, "chapter_id": 2110, "verse_number": "७-३७-३", "content_sanskrit": "पुराऽभिमन्युर्लक्षं नः पश्यतां हन्ति वीर्यवान्।\nतमाद्रवत माभैष्ट क्षिप्रं रक्षत कौरवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050685, "chapter_id": 2110, "verse_number": "७-३७-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050686, "chapter_id": 2110, "verse_number": "७-३७-४", "content_sanskrit": "`एवमुक्तास्ततस्तेन भारद्वाजेन धीमता।\nकृतज्ञानबलोत्सेधाः सुहृदो जितकाशिनः।\nत्रास्यमाना भयाद्वीरं परिवव्रुस्तवात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050687, "chapter_id": 2110, "verse_number": "७-३७-५", "content_sanskrit": "द्रोणो द्रौणिः कृपः कर्णः कृतवर्मा च सौबलः।\nबृहद्बलो मद्रराजो भूरिर्भूरिश्रवाः शलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050688, "chapter_id": 2110, "verse_number": "७-३७-६", "content_sanskrit": "पौरवो वृषसेनश्च विसृजन्तः शिताञ्शरान्।\nसौभद्रं शरवर्षेण महता समवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050689, "chapter_id": 2110, "verse_number": "७-३७-७", "content_sanskrit": "सम्मोहयित्वा तमथ दुर्योधनममोचयन्।\nआस्याद्ग्रासमिवाक्षिप्तं ममृषे नार्जुनात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050690, "chapter_id": 2110, "verse_number": "७-३७-८", "content_sanskrit": "ताञ्शरौघेण महता साश्वसूतान्महारथान्।\nविमुखीकृत्य सौभद्रः सिंहनादमथानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050691, "chapter_id": 2110, "verse_number": "७-३७-९", "content_sanskrit": "तस्य नादं ततः श्रुत्वा सिंहस्येवामिषैषिणः।\nनामृष्यन्त सुसंरब्धाः पुनर्द्रोणमुखा रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050692, "chapter_id": 2110, "verse_number": "७-३७-१०", "content_sanskrit": "त एनं कोष्ठकीकृत्य रथवंशेन मारिष।\nव्यसृजन्निषुजालानि नानालिङ्गानि सङ्घशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050693, "chapter_id": 2110, "verse_number": "७-३७-११", "content_sanskrit": "तान्यन्तरिक्षे चिच्छेद पौत्रस्ते निशितैः शरैः।\nतांश्चैव प्रतिविव्याध तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050694, "chapter_id": 2110, "verse_number": "७-३७-१२", "content_sanskrit": "`ततो रथपदात्योघाः कुञ्जराः सादिनश्च ह।\nकोपितास्तेन शूरेण शरैराशीविषोपमैः।\nपरिवब्रुर्जिघांसन्तः सौभद्रमपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050695, "chapter_id": 2110, "verse_number": "७-३७-१३", "content_sanskrit": "समुद्रमिव पर्यस्तं त्वदीयं तं बलार्णवम्।\nदधारैकोऽर्जुनिर्बाणैर्वेलेवोद्वृत्तमर्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050696, "chapter_id": 2110, "verse_number": "७-३७-१४", "content_sanskrit": "शूराणां युध्यमानानां निघ्नतामितरेतरम्।\nअभिमन्योः परेषां च नासीत्कश्चित्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050697, "chapter_id": 2110, "verse_number": "७-३७-१५", "content_sanskrit": "तस्मिंस्तु घोरे सङ्ग्रामे वर्तमाने भयङ्करे।\nदुःसहो नवभिर्बाणैरभिमन्युमविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050698, "chapter_id": 2110, "verse_number": "७-३७-१६", "content_sanskrit": "दुःशानो द्वादशभिः कृपः शारद्वतस्त्रिभिः।\nद्रोणस्तु सप्तदशभिः शरैराशीविषोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050699, "chapter_id": 2110, "verse_number": "७-३७-१७", "content_sanskrit": "विविंशतिस्तु सप्तत्या कृतवर्मा च सप्तभिः।\nबृहद्बलस्तथाऽष्टाभिरश्वत्थामा च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050700, "chapter_id": 2110, "verse_number": "७-३७-१८", "content_sanskrit": "भूरिश्रवास्त्रिभिर्बाणैर्मद्रेशः षङ्भिराशुगैः।\nद्वाभ्यां शराभ्यां शकुनिस्त्रिभिर्दुर्योधनो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050701, "chapter_id": 2110, "verse_number": "७-३७-१९", "content_sanskrit": "स तु तान्प्रतिविव्याध त्रिभिस्त्रिभिरजिह्मगैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050702, "chapter_id": 2110, "verse_number": "७-३७-१९", "content_sanskrit": "नृत्यन्निव महाराज चापहस्तः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050703, "chapter_id": 2110, "verse_number": "७-३७-२०", "content_sanskrit": "ततोऽभिमन्युः सङ्क्रुद्धस्त्रास्यमानस्तवात्मजैः।\nविदर्शयन्वै सुमहच्छिक्षौरसकृतं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050704, "chapter_id": 2110, "verse_number": "७-३७-२१", "content_sanskrit": "गरुडानिलरंहोभिर्यन्तुर्वाक्यकरैर्हयैः।\nअभ्यद्रवत तं कार्ष्णिमश्मकेन्द्रः कृतत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050705, "chapter_id": 2110, "verse_number": "७-३७-२२", "content_sanskrit": "अश्वाश्चाश्मकमादाय त्वरमाणाऽभ्यहारयन्।\nविव्याध दशभिर्बाणैस्तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050706, "chapter_id": 2110, "verse_number": "७-३७-२३", "content_sanskrit": "तस्याभिमन्युर्दशभिर्हयान्सूतं ध्वजं शरैः।\nबाहू धनुः शिरश्चोर्व्यां स्मयमानोऽभ्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050707, "chapter_id": 2110, "verse_number": "७-३७-२४", "content_sanskrit": "ततस्तस्मिन्हते वीरे सौभद्रेणाश्मकेश्वरे।\nसञ्चचाल बलं सर्वं पलायनपरायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050708, "chapter_id": 2110, "verse_number": "७-३७-२५", "content_sanskrit": "ततः कर्णः कृपो द्रोणो द्रौणिर्गान्धारराट् शलः।\nशल्यो भूरिश्रवाः क्राथः सोमदत्तो विविंशतिः।\nवृषसेनः सुषेणश्च कुण्डभेदी प्रतर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050709, "chapter_id": 2110, "verse_number": "७-३७-२६", "content_sanskrit": "बृन्दारको ललित्थश्च प्रबाहुर्दीर्घलोचनः।\nदुर्योधनश्च सङ्क्रुद्धः शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050710, "chapter_id": 2110, "verse_number": "७-३७-२७", "content_sanskrit": "सोऽतिविद्धो महेष्वासैरभिमन्युरजिह्मगैः।\nशरमादत्त कर्णाय वर्मकायावभेदिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2050711, "chapter_id": 2110, "verse_number": "७-३७-२८", "content_sanskrit": "तस्य भित्त्वा तनुत्राणं देहं निर्भिद्य चाशुगः।\nप्राविशद्धरणीं वेगाद्वल्मी कमिव पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2050712, "chapter_id": 2110, "verse_number": "७-३७-२९", "content_sanskrit": "स तेनातिप्रहारेण व्यथितो विह्वलन्निव।\nसञ्चचाल रणे कर्णः क्षितिकम्पे यथाऽचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2050713, "chapter_id": 2110, "verse_number": "७-३७-३०", "content_sanskrit": "तथान्यैर्निशितैर्बाणैः सुषेणं दीर्घलोचनम्।\nकुण्डभेदिं च सङ्क्रुद्धस्त्रिभिस्त्रीनवधीद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2050714, "chapter_id": 2110, "verse_number": "७-३७-३१", "content_sanskrit": "कर्णस्तं पञ्चविंशत्या नाराचानां समार्पयत्।\nअश्वत्थामा च विंशत्या कृतवर्मा च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2050715, "chapter_id": 2110, "verse_number": "७-३७-३२", "content_sanskrit": "स शराचितसर्वाङ्गः क्रुद्धः शक्रात्मजात्मजः।\nविचरन्ददृशे सैन्ये पाशहस्त इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2050716, "chapter_id": 2110, "verse_number": "७-३७-३३", "content_sanskrit": "शल्यं च शरवर्षेण समीपस्थामवाकिरत्।\nउदक्रोशन्महाबाहुस्तव सैन्यानि भीषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2050717, "chapter_id": 2110, "verse_number": "७-३७-३४", "content_sanskrit": "ततः स विद्धोऽस्त्रविदा मर्मभिद्भिरजिह्मगैः।\nशल्यो राजन्रथोपस्थे निषसाद मुमोह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2050718, "chapter_id": 2110, "verse_number": "७-३७-३५", "content_sanskrit": "तं हि दृष्ट्वा तथा विद्धं सौभद्रेण यशास्विना।\nसम्प्राद्रवच्चमूः सर्वा भारद्वाजस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2050719, "chapter_id": 2110, "verse_number": "७-३७-३६", "content_sanskrit": "सम्प्रेक्ष्य तं महाबाहुं रुक्मपुङ्खैः समावृतम्।\nत्वदीयाः प्रपलायन्ते मृगाः सिंहार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2050720, "chapter_id": 2110, "verse_number": "७-३७-३७", "content_sanskrit": "`सौभद्रशरनिर्भग्नाः समरेऽमरविक्रमाः।\nएवं शल्यो विमृदितस्तव पौत्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2050721, "chapter_id": 2110, "verse_number": "७-३७-३८", "content_sanskrit": "स तु रणयशसाऽभिपूज्यमानः\nपितृसुरचारणसिद्धयक्षसङ्गैः\nअवनितलगतैश्च भूतसङ्घै--\nरतिविबभौ हुतभुग्यथाऽऽज्यसिक्तः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2050722, "chapter_id": 2110, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे सप्तत्रिंशोऽध्यायः॥ ३७ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-३७- त्रास्यमानाः पालयिष्यन्तः॥ ५-३७- पर्यस्तं उत्क्रान्तमर्यादम्॥ ५-३७- शिक्षौरसकृतं अभ्यासकृतं निसर्गभवं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]