[{"id": 2048940, "chapter_id": 2074, "verse_number": "७-१-०x", "content_sanskrit": "श्रीवेदव्यासाय नमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048941, "chapter_id": 2074, "verse_number": "७-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048942, "chapter_id": 2074, "verse_number": "७-१-१x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048943, "chapter_id": 2074, "verse_number": "७-१-१", "content_sanskrit": "तमप्रतिमसत्वौजोबलवीर्यपराक्रमम्।\nहतं देवव्रतं श्रुत्वा पाञ्चाल्येन शिखण्डिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048944, "chapter_id": 2074, "verse_number": "७-१-२", "content_sanskrit": "धृतराष्ट्रस्ततो राजा शोकव्याकूललोचनः।\nकिमचेष्टत विप्रर्षे हते पिताx वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048945, "chapter_id": 2074, "verse_number": "७-१-३", "content_sanskrit": "तस्य पुत्रो हि भगवान्भीष्भद्रोणमुखै रथैः।\nपमजित्य महेष्वासान्पाण्डव राज्यमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048946, "chapter_id": 2074, "verse_number": "७-१-४", "content_sanskrit": "तस्मिन्हा तु भगवन्कतौ सर्वधनुष्मताम्।\nयदचेष्टत कौरवस्तन्मे ब्रूहि तपौधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048947, "chapter_id": 2074, "verse_number": "७-१-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048948, "chapter_id": 2074, "verse_number": "७-१-५", "content_sanskrit": "निहतं पितरं श्रुत्वा धृतराष्ट्रो जनाधिपः।\nलेभे न शान्तिं कौरव्यश्चिन्ताशौकपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048949, "chapter_id": 2074, "verse_number": "७-१-६", "content_sanskrit": "तत्व चिन्तयतो दुःखमनिशं पार्थिवस्य तत्।\nआजगाम विशुद्धात्मा पुनर्गावल्गणिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048950, "chapter_id": 2074, "verse_number": "७-१-७", "content_sanskrit": "`व्यासप्रसादाद्विज्ञाय सर्वं वृत्तान्तमुत्तमम्।\nसैनिकानां च सर्वेषां सेनयोरुभयोस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048951, "chapter_id": 2074, "verse_number": "७-१-८", "content_sanskrit": "शिबिरात्सञ्जयं प्राप्तं निशि नागाह्वयं पुरम्।\nआभ्विकेयो माहारज धृतराष्ट्रोऽन्वपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048952, "chapter_id": 2074, "verse_number": "७-१-९", "content_sanskrit": "श्रुत्वा भीष्मस्य निधनमप्रहृष्टमना भृशम्।\nपुत्राणां जयमाकाङ्क्षन्विललापातुरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048953, "chapter_id": 2074, "verse_number": "७-१-१०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048954, "chapter_id": 2074, "verse_number": "७-१-१०", "content_sanskrit": "संशोच्य तु महात्मानं भीष्मं भीमपराक्रमम्।\nकिमकार्षुःपरं तात कुरवः कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048955, "chapter_id": 2074, "verse_number": "७-१-११", "content_sanskrit": "तस्मिन्विनिहते शूरे दुराधर्षे महात्मनि।\nकिं नु स्वित्कुरवोऽकार्षुर्निमग्नाः शोकसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048956, "chapter_id": 2074, "verse_number": "७-१-१२", "content_sanskrit": "तदुदीर्णं महत्सैन्यं त्रैलोक्यस्यापि सञ्जय।\nभयमुत्पादयेत्तीव्रं पाण्डवानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048957, "chapter_id": 2074, "verse_number": "७-१-१३", "content_sanskrit": "को हि दौर्योधने सैन्ये पुमानासीन्महारथः।\nयं प्राप्य समरे वीरा न त्रस्यन्ति महाभये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048958, "chapter_id": 2074, "verse_number": "७-१-१४", "content_sanskrit": "देवव्रते तु निहते कुरूणामृषभे तदा।\nकिमकार्षुर्नृपतयस्तन्ममाचक्ष्व सञ्जया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048959, "chapter_id": 2074, "verse_number": "७-१-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048960, "chapter_id": 2074, "verse_number": "७-१-१५", "content_sanskrit": "शृणु राजन्नेकमना वचनं ब्रुवतो मम।\nयत्ते पुत्रास्तदाकार्षुर्हते देवव्रते मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048961, "chapter_id": 2074, "verse_number": "७-१-१६", "content_sanskrit": "निहते तु तदा भीष्मे राजन्सत्यपराक्रमे।\nतावकाः पाण्डवेयाश्च प्राध्यायन्त पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048962, "chapter_id": 2074, "verse_number": "७-१-१७", "content_sanskrit": "विस्मिताश्च प्रहृष्टाश्च क्षत्रधर्मं निशाम्य ते।\nस्वधर्मं निन्दमानास्ते प्रमिपत्य महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048963, "chapter_id": 2074, "verse_number": "७-१-१८", "content_sanskrit": "शयनं कल्पयामासुर्भीष्मायामितकर्मणे।\nसोपधानं नरव्याघ्र शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048964, "chapter_id": 2074, "verse_number": "७-१-१९", "content_sanskrit": "विधाय रक्षां भीष्माय समाभाष्य परस्परम्।\nअनुमान्य च गाङ्गेयं कृत्वा चापि प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048965, "chapter_id": 2074, "verse_number": "७-१-२०", "content_sanskrit": "क्रोधसंरक्तनयनाः समवेत्य परस्परम्।\nपुनर्युद्धाय निर्जग्मुः क्षत्रियाः कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048966, "chapter_id": 2074, "verse_number": "७-१-२१", "content_sanskrit": "ततस्तूर्यनिनादैश्च भेरीणां निनदेन च।\nतावकानामनीकानि परेषां च विनिर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048967, "chapter_id": 2074, "verse_number": "७-१-२२", "content_sanskrit": "व्यावृत्तेऽर्यम्णि राजेन्द्र पतिते जाह्नवीसुते।\nअमर्पवशमापन्नाः कालोपहतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048968, "chapter_id": 2074, "verse_number": "७-१-२३", "content_sanskrit": "अनादृत्य वचः पथ्यं गाङ्गेयस्य महात्मनः।\nनिर्ययुर्भरतश्रेष्टाः शस्त्राण्यादाय सत्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048969, "chapter_id": 2074, "verse_number": "७-१-२४", "content_sanskrit": "मोहात्तव सपुत्रस्य वधाच्छान्तनवस्य च।\nकौरवा म्नृत्युनाऽऽहूताः सहिताः सर्वराजभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048970, "chapter_id": 2074, "verse_number": "७-१-२५", "content_sanskrit": "अजावय इवागोपा वने श्वापदसंकुले।\n`कर्णकर्णेति चाक्रन्दञ्छेषा भारत पार्थिवाः।\nभृशमुद्विग्नमनसो हीना देवव्रतेन ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048971, "chapter_id": 2074, "verse_number": "७-१-२६", "content_sanskrit": "पतिते भरतश्रेष्ठे बभूव कुरुवाहिनी।\nद्यौरिवापेतनक्षत्रा हीनं खमिव वायुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048972, "chapter_id": 2074, "verse_number": "७-१-२७", "content_sanskrit": "विपन्नसस्येव मही वाक्चैवासंस्कृता यथा।\nआसुरीव यथा सेना निगृहीते नृपे वलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048973, "chapter_id": 2074, "verse_number": "७-१-२८", "content_sanskrit": "विधवेव वारारोहा शुष्कतोयेव निम्नगा।\nवृकैरिव वने रुद्धा पृपती हतयूथपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048974, "chapter_id": 2074, "verse_number": "७-१-२९", "content_sanskrit": "शरभाऽऽहतसिंहेव महती गिरिकन्दरा।\nसा सेना भरतश्रेष्ठे पतिते जाह्नवीसुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048975, "chapter_id": 2074, "verse_number": "७-१-३०", "content_sanskrit": "विष्वग्वाताहतिशुब्धा नौरिवासीन्महार्णवे।\nवलिभिः पाण्डवैर्वीरैर्लब्धलक्षैर्भृशार्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048976, "chapter_id": 2074, "verse_number": "७-१-३१", "content_sanskrit": "सा तदासीद्भृशं सेना व्याकुलाश्वरथद्विपा।\nविपन्नभूयिष्ठनरा कृपणा ध्वस्तमानसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048977, "chapter_id": 2074, "verse_number": "७-१-३२", "content_sanskrit": "तस्यां त्रस्ता नृपतयः सैनिकाश्च पृथग्विधाः।\nपाताल इव मज्जन्तो हीना देवव्रतेन ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048978, "chapter_id": 2074, "verse_number": "७-१-३३", "content_sanskrit": "कर्णस्य कुरवोऽस्मार्षुः स हि देवव्रतोपमः।\nसर्वशस्त्रभृतां श्रेष्ठं रोचमानमिवातिथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048979, "chapter_id": 2074, "verse_number": "७-१-३४", "content_sanskrit": "बन्धुमापद्गतस्येव तमेवोपागमन्मनः।\nचुक्रुशुः कर्मकर्णेति तत्र भारत पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048980, "chapter_id": 2074, "verse_number": "७-१-३५", "content_sanskrit": "राधेयं हितमस्माकं सूतपुत्रं तनुत्यजम्।\nस हि नाबुध्यत तदा दशाहानि महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048981, "chapter_id": 2074, "verse_number": "७-१-३६", "content_sanskrit": "सामात्यबन्धुः कर्णो वै तमानयत माचिरम्।\nभीष्णेण हि महाबाहुः सर्वक्षत्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048982, "chapter_id": 2074, "verse_number": "७-१-३७", "content_sanskrit": "रथेषु गण्यमानेषु बलविक्रमशालिषु।\nशङ्ख्यातोऽर्धरथः कर्णो द्विगुणः सन्नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048983, "chapter_id": 2074, "verse_number": "७-१-३८", "content_sanskrit": "रथातिरक्षसङ्ख्यायां योऽग्रणीः शूरसम्भतः।\nसासुरानपि देवेशान्रणे यो योद्धुमृत्सहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048984, "chapter_id": 2074, "verse_number": "७-१-३९", "content_sanskrit": "स तु तेनैव कोपेन राजन्गाङ्गेयमुक्तवान्।\nत्वयि जीकते कौरव्य नाहं योत्स्ये कदाचन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048985, "chapter_id": 2074, "verse_number": "७-१-४०", "content_sanskrit": "त्वया तु पाण्डवेयेषु निहतेषु महामृधे।\nदुर्योधनमनुज्ञाप्य वनं यास्यामि कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048986, "chapter_id": 2074, "verse_number": "७-१-४१", "content_sanskrit": "हते वा त्वयि पार्थैस्तु युधि स्वर्गमुपेयुषि।\nहन्तास्म्येकरथेनैव कृत्स्नान्वान्मन्यसे रथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048987, "chapter_id": 2074, "verse_number": "७-१-४२", "content_sanskrit": "एवमुक्त्वा महाबाहुर्दशाहान्येक एव स।\nनायुध्यत ततः कर्णः पुत्रस्य तव संयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048988, "chapter_id": 2074, "verse_number": "७-१-४३", "content_sanskrit": "भीष्मः समरविक्रान्तः पाण्डवेयस्य भारत।\nजघान समरे योधानसङ्ख्येयपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048989, "chapter_id": 2074, "verse_number": "७-१-४४", "content_sanskrit": "तस्मिंस्तु निहते शूरे सत्यसन्धे महौजसि।\nत्वत्सुताः वर्णमस्मार्पुस्तर्तुकामा इव प्लवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048990, "chapter_id": 2074, "verse_number": "७-१-४५", "content_sanskrit": "तावकास्तव पुत्राश्च सहिताः सर्वराजभिः।\nहा कर्ण इति चाक्रन्दन्कालोऽयमिति अब्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048991, "chapter_id": 2074, "verse_number": "७-१-४६", "content_sanskrit": "एवं ते स्म हि राधेयं सूतपुत्रं नतxxxx\nचुक्रुशुः सहिता योधाxxxxxxxxxxx॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048992, "chapter_id": 2074, "verse_number": "७-१-४७", "content_sanskrit": "जामदग्न्याभ्यनुज्ञातमस्त्रे दुर्वारपौरुषम्।\nअगमन्नो मनः कर्णं बन्धुमात्ययिकेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048993, "chapter_id": 2074, "verse_number": "७-१-४८", "content_sanskrit": "स हि शक्तो रणे राजञ्स्त्रातुमस्मान्महाभयात्॥\nत्रिदशानिव गोविन्दः सततं सुमहाभयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048994, "chapter_id": 2074, "verse_number": "७-१-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2048995, "chapter_id": 2074, "verse_number": "७-१-४९", "content_sanskrit": "तथा तु सञ्जयं कर्णं कीर्तयन्तं पुनः पुनः।\nआशीविषवदुच्छ्वस्य धृतराष्ट्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2048996, "chapter_id": 2074, "verse_number": "७-१-५०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2048997, "chapter_id": 2074, "verse_number": "७-१-५०", "content_sanskrit": "यत्तद्वैकर्तनं कर्णमगमद्वो मनस्तदा।\nउप्यरक्षत्स राधेयः सूतपुत्रस्तनुत्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2048998, "chapter_id": 2074, "verse_number": "७-१-५१", "content_sanskrit": "अपि तन्न मृषाकार्षीत्कच्चित्सत्यपराक्रमः।\nसम्भान्तानां तदार्तानां त्रस्तानां त्राणमिच्छतां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2048999, "chapter_id": 2074, "verse_number": "७-१-५२", "content_sanskrit": "अपि तत्पूरयांचक्रे धनुर्धरवरो युधि।\nयत्तद्विनिहते भीष्मे कौरवाणामपाकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2049000, "chapter_id": 2074, "verse_number": "७-१-५३", "content_sanskrit": "तत्खण्डं पूरयन्कर्णः परेषामादधद्भयम्।\nस हि वै पुरुषव्याघ्रो लोके सञ्जय कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2049001, "chapter_id": 2074, "verse_number": "", "content_sanskrit": "आर्तानां बान्धवानां च क्रन्दतां च विशेषतः।\nपरित्यज्य रणे प्राणांस्तत्त्राणार्थं च शर्म च।\nकृतवान्मम पुत्राणां जयाशां सफलामपि॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१-१ सत्यं xxx महत्यपि दुःखकारणे वैकल्यराहित्यम्। ओजो xxमं वलxxxवलं शरीरदार्ढ्यम्। ५-१- ५-१- ५-१- ५-१- ५-१- ५-१- ५-१- ५-१- ५-१- ५-१- ५-१-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]