[{"id": 7003627000, "chapter_id": 23627, "verse_number": "१-२-१४-१", "content_sanskrit": "अर्जुन उवाच ।\nकुमारनाथमाहात्म्यं यत्त्वयोक्तं कथांतरे ।\nतदहं श्रोतुमिच्छामि विस्तरेण महामुने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003627001, "chapter_id": 23627, "verse_number": "१-२-१४-२", "content_sanskrit": "नारद उवाच ।\nतारकं विनिहत्यैव वज्रांगतनयं प्रभुः ।\nगुहः संस्थापयामास लिंगमेतच्च फाल्गुन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003627002, "chapter_id": 23627, "verse_number": "१-२-१४-३", "content_sanskrit": "दर्शनाच्छ्रवणाद्ध्यानात्पूजया श्रुतिवंदनैः ।\nसर्वपापापहः पार्थ कुमारेशो न संशयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003627003, "chapter_id": 23627, "verse_number": "१-२-१४-४", "content_sanskrit": "अर्जुन उवाच ।\nअत्याश्चर्यमयी रम्या कथेयं पापनाशिनी ।\nविस्तरेण च मे ब्रूहि याथातथ्येन नारद ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003627004, "chapter_id": 23627, "verse_number": "१-२-१४-५", "content_sanskrit": "वज्रांगः कोप्यसौ दैत्यः किंप्रभावश्च तारकः ।\nकथं स निहतश्चैव जातश्चैव कथं गुहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003627005, "chapter_id": 23627, "verse_number": "१-२-१४-६", "content_sanskrit": "कथं संस्थापितं लिंगं कुमारेश्वरसंज्ञितम् ।\nकिं फलं चास्य लिंगस्य ब्रूहि तद्विस्तरान्मम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003627006, "chapter_id": 23627, "verse_number": "१-२-१४-७", "content_sanskrit": "नारद उवाच ।\nप्रणिपत्य कुमाराय सेनान्ये चेश्वराय च ।\nश्रृणु चैकमनाः पार्थ कुमारचरितं महत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003627007, "chapter_id": 23627, "verse_number": "१-२-१४-८", "content_sanskrit": "मानसो ब्रह्मणः पुत्रो दक्षो नाम प्रजापतिः ।\nषष्टिं सोऽजनयत्कन्या वीरिण्यां नाम फाल्गुन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003627008, "chapter_id": 23627, "verse_number": "१-२-१४-९", "content_sanskrit": "ददो स दश धर्माय कश्यपाय त्रयोदश ।\nसप्तविंशतिं सोमाय चतस्रोरिष्टनेमिने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003627009, "chapter_id": 23627, "verse_number": "१-२-१४-१०", "content_sanskrit": "भूतांगिरः कृशाश्वेभ्यो द्वेद्वे चैव ददौ प्रभुः ।\nनामधेयान्यमूषां च सपत्नीनां च मे श्रृणु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003627010, "chapter_id": 23627, "verse_number": "१-२-१४-११", "content_sanskrit": "यासां प्रसूतिप्रभवा लोका आपूरितास्त्रयः ।\nभानुर्लम्बा ककुद्भूमिर्विश्वा साध्या मरुत्वती ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003627011, "chapter_id": 23627, "verse_number": "१-२-१४-१२", "content_sanskrit": "वसुर्सुहूर्ता संकल्पा धर्मपत्न्यः सुताञ्छृणु ।\nभानोस्तु देवऋषभ सुतोऽभवत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003627012, "chapter_id": 23627, "verse_number": "१-२-१४-१३", "content_sanskrit": "विद्योत आसील्लंबायां ततश्च स्तनयित्नवः ।\nककुदः शकटः पुत्रः कीकटस्तनयो यतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003627013, "chapter_id": 23627, "verse_number": "१-२-१४-१४", "content_sanskrit": "भुवो दुर्गस्तथा स्वर्गो नंदश्चैव ततोऽभवत् ।\nविश्वेदेवाश्च विश्वाया अप्रजांस्तान्प्रचक्षते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003627014, "chapter_id": 23627, "verse_number": "१-२-१४-१५", "content_sanskrit": "साध्या द्वादश साध्याया अर्थसिद्धिस्तु तत्सुतः ।\nमरुत्वान्सुजयंतश्च मरुत्वत्या बभूवतुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003627015, "chapter_id": 23627, "verse_number": "१-२-१४-१६", "content_sanskrit": "नरनारायणौ प्राहुर्यौ तौ ज्ञानविदो जनाः ।\nवसोश्च वसवश्चाष्टौ मुहूर्तायां मुहूर्तकाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003627016, "chapter_id": 23627, "verse_number": "१-२-१४-१७", "content_sanskrit": "ये वै फलं प्रयच्छंति भूतानां स्वं स्वकालजम् ।\nसंकल्पायाश्च संकल्पः कामः संकल्पजः सुतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003627017, "chapter_id": 23627, "verse_number": "१-२-१४-१८", "content_sanskrit": "सुरूपासूत तनयान्रुद्रानेकादशैव तु ।\nकपाली पिंगलो भीमो विरुपाक्षो विलोहितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003627018, "chapter_id": 23627, "verse_number": "१-२-१४-१९", "content_sanskrit": "अजकः शासनः शास्ता शंभुश्चांत्यो भवस्तथा ।\nरुद्रस्य पार्षदाश्चान्ये विरूपायाः सुताः स्मृताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003627019, "chapter_id": 23627, "verse_number": "१-२-१४-२०", "content_sanskrit": "प्रजापतेरंगिरसः स्वधा पत्नी पितॄनथ ।\nजज्ञे सनी तथा पुत्रमथर्वागिरसं प्रभुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003627020, "chapter_id": 23627, "verse_number": "१-२-१४-२१", "content_sanskrit": "कृशाश्वस्य च द्वे भार्ये अर्चिश्च दिषणा तथा ।\nअस्त्रगामो ययोः पुत्रः ससंहारः प्रकीर्तितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003627021, "chapter_id": 23627, "verse_number": "१-२-१४-२२", "content_sanskrit": "पतंगी यामिनी ताम्रा तिमिश्चारिष्टनेमिनः ।\nपतंग्यसूत पतगान्यामिनी शलभानथ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003627022, "chapter_id": 23627, "verse_number": "१-२-१४-२३", "content_sanskrit": "ताम्रायाः श्येनगृध्राद्यास्तिमेर्यादोगणास्तथा ।\nअथ कश्यपपत्नीनां यत्प्रसूदमिदं जगत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003627023, "chapter_id": 23627, "verse_number": "१-२-१४-२४", "content_sanskrit": "श्रृणु नामानि लोकानां मातॄणां शंकराणि च ।\nअदितिर्दितिर्दनुः सिंही दनायुः सुरभिस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003627024, "chapter_id": 23627, "verse_number": "१-२-१४-२५", "content_sanskrit": "अरिष्टा विनता ग्रावा दया क्रोधवशा इरा ।\nकद्रुर्मुनिश्च ते चोभे मातरस्ताः प्रकीर्तिताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003627025, "chapter_id": 23627, "verse_number": "१-२-१४-२६", "content_sanskrit": "आदित्याश्चादितेः पुत्रा दितेर्दैत्याः प्रकीर्तिताः ।\nदनोश्च दानवाः प्रोक्ता राहुः सिंहीसुतो ग्रहः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003627026, "chapter_id": 23627, "verse_number": "१-२-१४-२७", "content_sanskrit": "दनायुषस्तथा जातो दनायुश्च गणो बली ।\nगावश्च सुरभेर्जातारिष्टापुत्रा युगंधराः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003627027, "chapter_id": 23627, "verse_number": "१-२-१४-२८", "content_sanskrit": "विनतासूत अरुणं गरुडं च महाबलम् ।\nग्रावायाः श्वापदाः पुत्रा गणः क्रोधवशस्तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003627028, "chapter_id": 23627, "verse_number": "१-२-१४-२९", "content_sanskrit": "जातः क्रोधवशायाश्च इराया भूरुहाः स्मृताः ।\nकद्रूसुताः स्मृता नागा मुनेरप्सरसां गणाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003627029, "chapter_id": 23627, "verse_number": "१-२-१४-३०", "content_sanskrit": "तत्र द्वौ तनयौ यौ च दितेस्तौ विष्णुना हतौ ।\nहिरण्यकशिपुर्वीरो हिरण्याक्षस्तथाऽपरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003627030, "chapter_id": 23627, "verse_number": "१-२-१४-३१", "content_sanskrit": "ततो निहतपुत्रा सा दितिराराध्य कश्यपम् ।\nअयाचत वरं देवी पुत्रमन्यं महाबलम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003627031, "chapter_id": 23627, "verse_number": "१-२-१४-३२", "content_sanskrit": "समरे शक्रहंतारं स तस्या अददात्प्रभुः ।\nनियमे चापि वर्तस्व वर्षाणां च सहस्रकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003627032, "chapter_id": 23627, "verse_number": "१-२-१४-३३", "content_sanskrit": "इत्युक्ता सा तथा चक्रे पुष्करस्था समाहिता ।\nवर्तंत्या नियमे तस्याः सहस्राक्षः समाहितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003627033, "chapter_id": 23627, "verse_number": "१-२-१४-३४", "content_sanskrit": "उपासामाचरद्भक्त्या सा चैनमन्वमन्यत ।\nदशवत्सरशेषस्य सहस्रस्य तदा दितिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003627034, "chapter_id": 23627, "verse_number": "१-२-१४-३५", "content_sanskrit": "उवाच शक्रं सुप्रीता भक्त्या शक्रस्य तोषिता ।\nदितिरुवाच ।\nअत्रोत्तीर्णव्रतप्रायां विद्धि देवसत्तम ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003627035, "chapter_id": 23627, "verse_number": "१-२-१४-३६", "content_sanskrit": "भविष्यति तव भ्राता तेन सार्धमिमां श्रियम् ।\nभोक्ष्यसे त्वं यथानयायं त्रैलोक्यं हतकंटकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003627036, "chapter_id": 23627, "verse_number": "१-२-१४-३७", "content_sanskrit": "इत्युक्त्वा निद्रयाविष्टा चरणाक्रांतमूर्धजा ।\nदिवा सुप्ता दितिर्देवी भाव्यर्थबलनोदिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003627037, "chapter_id": 23627, "verse_number": "१-२-१४-३८", "content_sanskrit": "तत्तु रंध्रमवेक्ष्यैव योगमूर्तिस्तदाविशत् ।\nजठरस्थं दितेर्गर्भं चक्रे वज्रेण सप्तधा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003627038, "chapter_id": 23627, "verse_number": "१-२-१४-३९", "content_sanskrit": "एकैकं च पुनः खण्डं चकार मघवा ततः ।\nसप्तधा सप्तधा कोपादुद्बुध्य च ततो दितिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003627039, "chapter_id": 23627, "verse_number": "१-२-१४-४०", "content_sanskrit": "न हंतव्यो न हंतव्य इति सा शक्रमब्रवीत् ।\nवज्रेण कृत्त्यमानानां बुद्धा सा रोदनेन च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003627040, "chapter_id": 23627, "verse_number": "१-२-१४-४१", "content_sanskrit": "ततः शक्रश्च मा रोदीरिति तांस्तान्यथाऽवदत् ।\nनिर्गत्य जठरात्तस्मात्ततः प्रांजलिरग्रतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003627041, "chapter_id": 23627, "verse_number": "१-२-१४-४२", "content_sanskrit": "उवाच वाक्यं चात्रस्तो मातरं रिषपूरिताम् ।\nदिवास्वापं कृथा मातः पादाक्रांतशिरोरुहा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003627042, "chapter_id": 23627, "verse_number": "१-२-१४-४३", "content_sanskrit": "सुप्ताथ सुचिरं वाते धिन्नो गर्भो मया तव ।\nकृता एकोनपंचाशद्भागा वज्रेण ते सुताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003627043, "chapter_id": 23627, "verse_number": "१-२-१४-४४", "content_sanskrit": "सत्यं भवतु ते वाक्यं सार्धं भोक्ष्यामि तैः श्रियम् ।\nदास्यामि तेषां स्थानानि दिवि यावदहं दिते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003627044, "chapter_id": 23627, "verse_number": "१-२-१४-४५", "content_sanskrit": "मा रोदीरिति मे प्रोक्ताः ख्याताश्च मरुतस्त्विति ।\nइत्युक्ता सा च सव्रीडा दितिर्जाता निरुत्तरा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003627045, "chapter_id": 23627, "verse_number": "१-२-१४-४६", "content_sanskrit": "सार्धं तैर्गतवानिंद्रो दिगंते वायवः स्मृताः ।\nततः पुनश्च भर्तारं दितिः प्रोवाच दुःखिता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003627046, "chapter_id": 23627, "verse_number": "१-२-१४-४७", "content_sanskrit": "पुत्रं मे भगवन्देहि शक्रहंतारमूर्जितम् ।\nयो नास्त्रशस्त्रैर्वध्यत्वं गच्छेत्त्रिदिववासिनाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003627047, "chapter_id": 23627, "verse_number": "१-२-१४-४८", "content_sanskrit": "न ददास्युत्तरं विद्धि मृतामेव प्रजापते ।\nइत्युक्तः स तदोवाच तां पत्नीमतिदुःखिताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003627048, "chapter_id": 23627, "verse_number": "१-२-१४-४९", "content_sanskrit": "दशवर्षसहस्राणि तपोनिष्ठा तु तप्स्यसे ।\nवज्रसारमयैरंगैरच्छेद्यैरायसैर्दृढैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003627049, "chapter_id": 23627, "verse_number": "१-२-१४-५०", "content_sanskrit": "वज्रांगोनाम पुत्रस्ते भविता धर्मवत्सलः ।\nसा तु लब्धवरा देवी जगाम तपसे वनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003627050, "chapter_id": 23627, "verse_number": "१-२-१४-५१", "content_sanskrit": "दशवर्षसहस्राणि तपो घोरं समाचरत् ।\nतपसोंऽते भगवती जनयामास दुर्जयम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003627051, "chapter_id": 23627, "verse_number": "१-२-१४-५२", "content_sanskrit": "पुत्रमप्रतिकर्माणमजेयं वज्रदुश्छिदम् ।\nस जातामात्र एवाभूत्सर्वशा स्त्रार्थपारगः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003627052, "chapter_id": 23627, "verse_number": "१-२-१४-५३", "content_sanskrit": "उवाच मातरं भक्त्या मातः किं करवाण्यहम् ।\nतमुवाच ततो हृष्टा दितिर्दैत्याधिपं सुतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003627053, "chapter_id": 23627, "verse_number": "१-२-१४-५४", "content_sanskrit": "बहवो मे हताः पुत्राः सहस्राक्षेण पुत्रक ।\nतेषआमपचितिं कर्तुमिच्छे शक्रवधादहम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003627054, "chapter_id": 23627, "verse_number": "१-२-१४-५५", "content_sanskrit": "बाढमित्येव सं प्रोच्य जगाम त्रिदिवं बली ।\nससैन्यं समरे शक्रं स च बाह्वायुधोऽजयत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003627055, "chapter_id": 23627, "verse_number": "१-२-१४-५६", "content_sanskrit": "पादेनाकृष्य देवेंद्रं सिंहः क्षुद्रमृगं यथा ।\nमातुरंतिकमागच्छद्याचमानं भयातुरम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003627056, "chapter_id": 23627, "verse_number": "१-२-१४-५७", "content_sanskrit": "एतस्मिन्नंतरे ब्रह्मा कश्यपश्च महातपाः ।\nआगता तत्र संत्रस्तावथो ब्रह्मा जगाद तम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003627057, "chapter_id": 23627, "verse_number": "१-२-१४-५८", "content_sanskrit": "मुंचामुं पुत्र याचंतं किमनेन प्रयोजनम् ।\nअवमानो वधः प्रोक्तो वीरसंभावितस्य च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003627058, "chapter_id": 23627, "verse_number": "१-२-१४-५९", "content_sanskrit": "अस्मद्वाक्येन यो मुक्तो जीवन्नपि मृतो हि सः ।\nशत्रुं ये घ्नंति समरे न ते वीराः प्रकीर्तिताः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003627059, "chapter_id": 23627, "verse_number": "१-२-१४-६०", "content_sanskrit": "कृत्वा मानपरिग्लनिं ये मुंचंति वरा हि ते ।\nयतामान्यतमं मत्वा त्वया मातुर्वचः कृतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003627060, "chapter_id": 23627, "verse_number": "१-२-१४-६१", "content_sanskrit": "तथा पितुर्वचः कार्यं मुंचामुं पुत्र वासवम् ।\nएतच्छ्रुत्वा तु वज्रांगः प्रणतो वाक्यमब्रवीत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003627061, "chapter_id": 23627, "verse_number": "१-२-१४-६२", "content_sanskrit": "न मे कृत्यमनेनास्ति मातुराज्ञा कृता मया ।\nत्वं सुरासुरनाथो वै मम च प्रपितामहः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003627062, "chapter_id": 23627, "verse_number": "१-२-१४-६३", "content_sanskrit": "करिष्ये त्वद्वचो देव एष मुक्तः शतक्रतुः ।\nन च कांक्षे शक्रभुक्तामिमां त्रैलोक्यराजताम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003627063, "chapter_id": 23627, "verse_number": "१-२-१४-६४", "content_sanskrit": "परभुक्ता यथा नारी परभुक्तामिवस्रजम् ।\nयच्च त्रिभुवनेष्वस्ति सारं तन्मम कथ्यताम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003627064, "chapter_id": 23627, "verse_number": "१-२-१४-६५", "content_sanskrit": "ब्रह्मोवाच ।\nतपसो न परं किंचित्तपो हि महतां धनम् ।\nतपसा प्राप्यते सर्वं तपोयोग्योऽसि पुत्रक ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003627065, "chapter_id": 23627, "verse_number": "१-२-१४-६६", "content_sanskrit": "वज्रांग उवाच ।\nतपसे मे रतिर्देव न विघ्नं तत्र मे भवेत् ।\nत्वत्प्रसादेन भगवन्नित्युक्त्वा विरराम सः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003627066, "chapter_id": 23627, "verse_number": "१-२-१४-६७", "content_sanskrit": "ब्रह्मोवाच ।\nक्रूरभावं परित्यज्य यदीच्छसि तपः सुत ।\nअनया चित्तबुद्ध्या तत्त्वयाप्तं जन्मनः फलम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003627067, "chapter_id": 23627, "verse_number": "१-२-१४-६८", "content_sanskrit": "इत्युक्त्वा पद्मजः कन्यां ससर्ज्जयतलोचनाम् ।\nतामस्मै प्रददौ देवः पत्न्यर्थं पद्मसंभवः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003627068, "chapter_id": 23627, "verse_number": "१-२-१४-६९", "content_sanskrit": "वरांगीति च नामास्याः कृतवांश्च पितामहः ।\nजगाम च ततो ब्रह्मा कश्यपेन समं दिवम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003627069, "chapter_id": 23627, "verse_number": "१-२-१४-७०", "content_sanskrit": "वज्रांगोऽपि तया सार्धं जगाम तपसे वनम् ।\nऊर्द्धूबाहुः स दैत्येंद्रोऽतिष्ठदब्दसहस्रकम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003627070, "chapter_id": 23627, "verse_number": "१-२-१४-७१", "content_sanskrit": "कालं कमलपत्राक्षः शुद्धबुद्धिर्महातपाः ।\nतावानधोमुखः कालं तावत्पंचाग्निसाधकः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003627071, "chapter_id": 23627, "verse_number": "१-२-१४-७२", "content_sanskrit": "निराहारो घोरतपास्तपोराशिरजायत ।\nततः सोंऽतर्जले चक्रे कालं वर्षसहस्रकम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003627072, "chapter_id": 23627, "verse_number": "१-२-१४-७३", "content_sanskrit": "जलांतरप्रविष्टस्य तस्य पत्नी महाव्रता ।\nतस्यैव तीरे सरसस्तत्परा मौनमाश्रिता ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003627073, "chapter_id": 23627, "verse_number": "१-२-१४-७४", "content_sanskrit": "निराहारं पतिं मत्वा तपस्तेपे पतिव्रता ।\nतस्यास्तपसि वर्तंत्या इंद्रश्चक्रे विभीषिकाम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003627074, "chapter_id": 23627, "verse_number": "१-२-१४-७५", "content_sanskrit": "भूत्वा तु मर्कटाकारस्तस्याअभ्याशमागतः ।\nअपविध्य दृशं तस्या मूत्रविष्ठे चकार सः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003627075, "chapter_id": 23627, "verse_number": "१-२-१४-७६", "content_sanskrit": "तथा विलोलवसनां विलोलवदनां तथा ।\nविलोलकेशां तां चक्रे विधित्सुस्तपसः क्षतिम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003627076, "chapter_id": 23627, "verse_number": "१-२-१४-७७", "content_sanskrit": "ततश्च मेषरूपेण क्लेशं तस्याश्चकार सः ।\nततो भुजंगरूपेण बद्धा चरणयोर्द्वयोः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003627077, "chapter_id": 23627, "verse_number": "१-२-१४-७८", "content_sanskrit": "अपाकर्षत दूरं स तस्माद्देवभृतस्तथा ।\nतपोबालाच्च सा तस्य न वध्यत्वं जगाम ह ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003627078, "chapter_id": 23627, "verse_number": "१-२-१४-७९", "content_sanskrit": "क्षमया च महाभागा क्रोधमण्वपि नाकरोत् ।\nततो गोमायुरूपेण तमदूषयदाश्रमम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003627079, "chapter_id": 23627, "verse_number": "१-२-१४-८०", "content_sanskrit": "अग्निरूपेण तस्याश्च स ददाह महाश्रमम् ।\nचकर्ष वायुरूपेण महोग्रेण च तां शुभाम् ।\nएवं सिहवृकाद्याभिर्भीषिकाभिः पुनःपुनः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003627080, "chapter_id": 23627, "verse_number": "१-२-१४-८१", "content_sanskrit": "विरराम यदा नैव वज्रांगमहिषी तदा ।\nशैलस्य दुष्टतां मत्वा शापं दातुं व्यवस्यत ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003627081, "chapter_id": 23627, "verse_number": "१-२-१४-८२", "content_sanskrit": "तां शापाभिमुखीं दृष्ट्वा शैलः पुरुषाविग्रहः ।\nउवाच तां वरारोहां त्वरयाथ सुलोचनाम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003627082, "chapter_id": 23627, "verse_number": "१-२-१४-८३", "content_sanskrit": "शैल उवाच ।\nनाहं महाव्रते दुष्टः सेव्योऽहं सर्वदेहिनाम् ।\nअतिखेदं करोत्येष ततः क्रुद्धस्तु वृत्रहा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003627083, "chapter_id": 23627, "verse_number": "१-२-१४-८४", "content_sanskrit": "एतस्मिन्नंतरे जातः कालो वर्षसहस्रिकः ।\nतस्मिन्याते स भगवान्काले कमलसंभवः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003627084, "chapter_id": 23627, "verse_number": "१-२-१४-८५", "content_sanskrit": "तुष्टः प्रोवाच वज्रांगं तमागम्य जलाशये ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003627085, "chapter_id": 23627, "verse_number": "१-२-१४-८६", "content_sanskrit": "ब्रह्मोवाच ।\nददामि सर्वकामांस्ते उत्तिष्ठ दितिनन्दन ।\nएवमुक्तस्तदोत्थाय दैत्येंद्रस्तपसो निधिः ।\nउवाच प्रांजलिर्वाक्यं सर्वलोकपितामहम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003627086, "chapter_id": 23627, "verse_number": "१-२-१४-८७", "content_sanskrit": "वज्रांग उवाच ।\nआसुरो मेऽस्तु मा भावः शक्रराज्ये च मा रतिः ।\nतपोधर्मरतिश्चास्तु वृणोम्येतत्पितामह ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003627087, "chapter_id": 23627, "verse_number": "१-२-१४-८८", "content_sanskrit": "एवमस्त्विति तं ब्रह्मा प्राह विस्मितमानसः ।\nउपेक्षते च शक्रं स भाव्यर्थं कोऽतिवर्तते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003627088, "chapter_id": 23627, "verse_number": "१-२-१४-८९", "content_sanskrit": "ऋषयो मनुजा देवाः शिवब्रह्ममुखा अपि ।\nभाव्यर्थं नाति वर्तंते वेलामिव महोदधिः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003627089, "chapter_id": 23627, "verse_number": "१-२-१४-९०", "content_sanskrit": "इति चिंत्य विरिंचोऽपि तत्रैवांतरधीयत ।\nवज्रांगोऽपि समाप्ते तु तपसि स्थिरसंयमः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003627090, "chapter_id": 23627, "verse_number": "१-२-१४-९१", "content_sanskrit": "आहारमिच्छन्स्वां भार्यां न ददर्शाश्रमे स्वके ।\nभार्याहीनोऽफलश्चेति स संचिंत्य इतस्ततः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003627091, "chapter_id": 23627, "verse_number": "१-२-१४-९२", "content_sanskrit": "विलोकयन्स्वकां भार्यां विधित्सुः कर्म नैत्यकम् ।\nविलोकयन्ददर्शाथ इहामुत्र सहयिनीम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003627092, "chapter_id": 23627, "verse_number": "१-२-१४-९३", "content_sanskrit": "रुदन्तीं स्वां प्रियां दीनां तरुप्रच्छादिताननाम् ।\nतां विलोक्य ततो दैत्यः प्रोवाच परिसांत्वयन् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003627093, "chapter_id": 23627, "verse_number": "१-२-१४-९४", "content_sanskrit": "वज्रांग उवाच ।\nकेन तेऽपकृतं भीरु वर्तंत्यास्तपसि स्वके ।\nकथं रोदिषि वा बाले मयि जीवति भर्तरि ।\nकं वा कामं प्रयच्छामि शीघ्रं प्रब्रूहि भामिनि ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003627094, "chapter_id": 23627, "verse_number": "१-२-१४-९५", "content_sanskrit": "गृहेश्वरीं सद्गुणभूषितां शुभां पंग्वंधयोगेन पतिं समेताम् ।\nन लालयेत्पूरयेन्नैव कामं स किं पुमान्न पुमान्मे मतोस्ति ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]