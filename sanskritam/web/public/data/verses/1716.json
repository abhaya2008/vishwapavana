[{"id": 2033208, "chapter_id": 1716, "verse_number": "४-३९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033209, "chapter_id": 1716, "verse_number": "४-३९-१", "content_sanskrit": "स राजधान्य निर्याय वैराटिरकुतोभयः।\nप्रयाहीत्यब्रवीत्सूतं यत्र ते कुरवो गताः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033210, "chapter_id": 1716, "verse_number": "४-३९-२", "content_sanskrit": "समवेतान्कुरून्सर्वाञ्जिगीषूनवजित्य वै।\nगाश्चैताः क्षिप्रमादाय पुनरेष्याम्यहं पुरम् ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033211, "chapter_id": 1716, "verse_number": "४-३९-३", "content_sanskrit": "ततस्तांश्चोदयामास सदश्वान्पाण्डुनन्दनः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033212, "chapter_id": 1716, "verse_number": "४-३९-४", "content_sanskrit": "ते हया नरसिंहेन चोदिता वातरंहसः।\nआलिखन्त इवाकाशमूहुः काञ्चनमालिनः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033213, "chapter_id": 1716, "verse_number": "४-३९-५", "content_sanskrit": "नातिदूरमथो गत्वा मात्स्यपुत्रधनञ्जयौ ।\nअवैक्षेतामवित्रस्तौ कुरूणां बलिनां बलम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033214, "chapter_id": 1716, "verse_number": "४-३९-६", "content_sanskrit": "श्मशानमभितो गत्वा शूरौ ददृशतुःकुरून् ॥ ६ ॥\nतदनीकं महत्तेषां विस्तृतं सागरोपमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033215, "chapter_id": 1716, "verse_number": "४-३९-७", "content_sanskrit": "सर्पमाणमिवाकाशे वनं बहुलपादपम् ॥ ७ ॥\nददृशे पार्थिवो रेणुर्जनितस्तेन सर्पता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033216, "chapter_id": 1716, "verse_number": "४-३९-८", "content_sanskrit": "दृष्टिप्रणाशो भूतानां दिवस्पृक्कुरुसत्तम ॥ ८ ॥\nतदनीकमथो वीक्ष्य गजाश्वरथसंकुलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033217, "chapter_id": 1716, "verse_number": "४-३९-९", "content_sanskrit": "कर्णदुर्योधनकृपैर्गुप्तं शान्तनवेन च ।\nद्रोणेन सह पुत्रेण महेष्वासेन धीमता ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033218, "chapter_id": 1716, "verse_number": "४-३९-१०", "content_sanskrit": "हृष्टरोमा भयोद्विग्नो निमील्य स्वदृशौ तदा।\nकम्पमानशरीरश्च पार्थं वैराटिरब्रवीत् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033219, "chapter_id": 1716, "verse_number": "४-३९-११", "content_sanskrit": "नोत्सहे कुरुभिर्योद्धुं रोमहर्षं हि पश्य मे।\nबहुप्रवीरमत्युग्रं देवैरपि दुरासदम्।\nप्रतियोद्धुं न शक्नोमि कुरुसैन्यं भयानकम् ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033220, "chapter_id": 1716, "verse_number": "४-३९-१२", "content_sanskrit": "नाशंसे भारतीं सेनां प्रवेष्टुं भीमकार्मुकाम्।\nदेवैरपि सहेन्द्रेण न शक्यं किंपुनर्नरैः ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033221, "chapter_id": 1716, "verse_number": "४-३९-१३", "content_sanskrit": "रथनागाश्वकलिलं पत्तिध्वजसमाकुलम् ।\nदृष्ट्वैव हि परानीकं मनः प्रव्यथतीव मे ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033222, "chapter_id": 1716, "verse_number": "४-३९-१४", "content_sanskrit": "यत्र द्रोणश्च भीष्मश्च कृपः कर्णो विविंशतिः ।\nअश्वत्थामा विकर्णश्च सोमदत्तश्च बाह्लिकः ।\nदुर्योधनस्तथा राजा वीरो दुर्मर्षणः परः ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033223, "chapter_id": 1716, "verse_number": "४-३९-१५", "content_sanskrit": "नीतिमन्तो महेष्वासाः सर्वे युद्धविशारदाः ।\nमत्ता इव महानागा युक्तध्वजपताकिनः ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033224, "chapter_id": 1716, "verse_number": "४-३९-१६", "content_sanskrit": "नीतिमन्तो महेष्वासाः सर्वार्थकृतनिश्चयाः ।\nताञ्जेतुं समरे शूरान्दुर्बुद्धिरहमागतः ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033225, "chapter_id": 1716, "verse_number": "४-३९-१७", "content_sanskrit": "दृष्ट्वैव हि कुरून्सर्वान्व्यूढानीकान्प्रहारिणः ।\nहृषितानि च रोमाणि कश्मलेनाहतं मनः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033226, "chapter_id": 1716, "verse_number": "४-३९-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033227, "chapter_id": 1716, "verse_number": "४-३९-१८", "content_sanskrit": "दृष्ट्वा तु महतीं सेनां कुरूणां दृढधन्विनाम्।\nपरिदेवयते मन्दः सकाशे सव्यसाचिनः ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033228, "chapter_id": 1716, "verse_number": "४-३९-१९", "content_sanskrit": "त्रिगर्तान्मे पिता यातः शून्ये वै प्रणिधाय माम्।\nसर्वां सेनामुपादाय न मे सन्तीह सैनिकाः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033229, "chapter_id": 1716, "verse_number": "४-३९-२०", "content_sanskrit": "अहमेको बहून्बालः कृतास्त्रानकृतश्रमः।\nप्रतियोद्धुं न शक्नोति निवर्तय बृहन्नले ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033230, "chapter_id": 1716, "verse_number": "४-३९-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033231, "chapter_id": 1716, "verse_number": "४-३९-२१", "content_sanskrit": "तं तथा वादिनं तत्र बीभत्सुः प्रत्यभाषत।\nसंप्रहस्य पुनस्तं वै सर्वलोकमहारथः ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033232, "chapter_id": 1716, "verse_number": "४-३९-२२", "content_sanskrit": "भयेन दीनरूपोऽसि द्विषतां हर्षवर्धनः ।\nन च तावत्कृतं किंचित्परैः कर्म रणाजिरे ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033233, "chapter_id": 1716, "verse_number": "४-३९-२३", "content_sanskrit": "स्वयमेव च मामात्थ नय मां कौरवान्प्रति ।\nसोहं त्वां तत्र नेष्यामि यत्रैते बहुला ध्वजाः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033234, "chapter_id": 1716, "verse_number": "४-३९-२४", "content_sanskrit": "मध्यमामिषगृध्रूनां कुरूणामाततायिनाम् ।\nनेष्यामि त्वां महाबाहो मा त्वं हि विमना भव।\nसमुद्रमिव गम्भीरं कुरुसैन्यमरिन्दम ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033235, "chapter_id": 1716, "verse_number": "४-३९-२५", "content_sanskrit": "स्त्रीसकाशे प्रतिज्ञाय पुरुषाणां हि शृण्वताम्।\nविकत्थमानो निर्यात्वा ब्रूषि किं नात्र युद्ध्यसे ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033236, "chapter_id": 1716, "verse_number": "४-३९-२६", "content_sanskrit": "तथा स्त्रीषु प्रतिश्रुत्य पौरुषं पुरुषेषु च।\nरथमारुह्य निर्यात्वा किमर्थं नावबुध्यसे ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033237, "chapter_id": 1716, "verse_number": "४-३९-२७", "content_sanskrit": "न चेद्विजित्य गास्त्वं हि नगरं प्रतियास्यसि।\nप्रहसिष्यन्ति वीरास्त्वां नरा नार्यश्च संगताः ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033238, "chapter_id": 1716, "verse_number": "४-३९-२८", "content_sanskrit": "अहमप्यस्मि सैरन्ध्र्या स्तुतः सारथ्यकर्मणि ।\nनाहं शक्नोम्यनिर्जित्य गाः प्रयातुं पुरं प्रति ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033239, "chapter_id": 1716, "verse_number": "४-३९-२९", "content_sanskrit": "स्तोत्रेण चैव सैरन्ध्र्यास्तव वाक्येन चोदितः ।\nकथं न युद्ध्येयमहं कुरूनेतान्स्थिरो भव ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033240, "chapter_id": 1716, "verse_number": "४-३९-३०x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033241, "chapter_id": 1716, "verse_number": "४-३९-३०", "content_sanskrit": "कामं हरन्तु मात्स्यानां भूयांसः कुरवो धनम्।\nप्रहसन्तु च मां नार्यो नरा वाऽपि बृहन्नले ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033242, "chapter_id": 1716, "verse_number": "४-३९-३१", "content_sanskrit": "संग्रामेण न मे कार्यं गावो गच्छन्तु चापि मे ।\nनगरं च प्रवेक्ष्यामि पश्यतस्ते बृहन्नले ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033243, "chapter_id": 1716, "verse_number": "४-३९-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033244, "chapter_id": 1716, "verse_number": "४-३९-३२", "content_sanskrit": "इत्युक्त्वा प्राद्रवद्भीतो रथात्प्रस्कन्द्य कुण्डली।\nत्यक्त्वा मानं सुसंत्रस्तो विसृज्य सशरं धनुः ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033245, "chapter_id": 1716, "verse_number": "४-३९-३३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033246, "chapter_id": 1716, "verse_number": "४-३९-३३", "content_sanskrit": "नैष शूरैः स्मृतो धर्मः क्षत्रियस्य पलायनम्।\nश्रेयो हि मरणं युद्धे न भीतस्य पलायनम् ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033247, "chapter_id": 1716, "verse_number": "४-३९-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033248, "chapter_id": 1716, "verse_number": "४-३९-३४", "content_sanskrit": "एवमुक्त्वा तु कौरव्यः सोऽवप्लुत्य रथोत्तमात्।\nतमन्वधावद्धावन्तं राजपुत्रं धनञ्जयः ।\nदीर्घां वेणीं विधून्वानः साधु रक्ते च वाससी ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033249, "chapter_id": 1716, "verse_number": "४-३९-३५", "content_sanskrit": "विक्रमन्तं पदन्यासैर्नमयन्तं च भूतलम् ।\nविधूय वेणीं धावन्तमजानन्तोऽर्जुनं तदा।\nसैनिकाः प्राहसन्केचिद्योषिद्रूपमवेक्ष्य तम् ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033250, "chapter_id": 1716, "verse_number": "४-३९-३६", "content_sanskrit": "तं च शीघ्रं प्रधावन्तं संप्रेक्ष्य कुरवोऽब्रुवन् ।\nकोऽयं धावत्यसङ्गेन पूर्वं मुक्त्वा रथोत्तमम् ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033251, "chapter_id": 1716, "verse_number": "४-३९-३७", "content_sanskrit": "क एष वेषसंच्छन्नो भस्मनेव हुताशनः।\nकिंचिदस्य यथा पुंसः किंचिदस्य यथा स्त्रियः ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033252, "chapter_id": 1716, "verse_number": "४-३९-३८", "content_sanskrit": "इत्येवं सैनिकाः प्राहुर्द्रोणस्तानिदमब्रवीत् ।\nआचार्यः कुरुपाण्डूनां मतौ शुक्राङ्गिरोपमः ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2033253, "chapter_id": 1716, "verse_number": "४-३९-३९", "content_sanskrit": "किं विचारेण वः कार्यमेतेनानुसृतेन वा।\nधावन्तमनुधावंश्च निर्भयो भयविप्लुतम् ।\nवेणीकलापं निर्धूय प्रविभाति नरर्षभः ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2033254, "chapter_id": 1716, "verse_number": "४-३९-४०", "content_sanskrit": "आकारमर्जुनस्येव क्लीबरूपं बिभर्ति च।\nरूपेण पार्थसदृशः स्त्रीवेषसमलंकृतः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2033255, "chapter_id": 1716, "verse_number": "४-३९-४१", "content_sanskrit": "तदेवैतच्छिरोग्रीवं तौ बाहू परिघोपमौ ।\nतत्तदेवास्य विक्रान्तं नायमन्यो धनञ्जयात् ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2033256, "chapter_id": 1716, "verse_number": "४-३९-४२", "content_sanskrit": "अमरेष्विव देवेन्द्रो मनुष्येषु धनञ्जयः।\nएकः कोस्मानुपायायादन्यो लोके धनञ्जयात् ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2033257, "chapter_id": 1716, "verse_number": "४-३९-४३", "content_sanskrit": "द्रोणेन चैवमुक्तस्तु कर्णः प्रोवाच बुद्धिमान्।\nएकः पुत्रो विराटस्य शून्ये संनिहितः पुरे ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2033258, "chapter_id": 1716, "verse_number": "४-३९-४४", "content_sanskrit": "स एष किल निर्यातो बालभावान्न पौरुषात्।\nक्लीबं वै सारथिं कृत्वा निर्यातो नगराद्बहिः ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2033259, "chapter_id": 1716, "verse_number": "४-३९-४५", "content_sanskrit": "छन्नं सत्रेण वै नूनं जानीध्वं यान्तमर्जुनम् ।\nते हि नः प्रतिसंयातुं संग्रामे न हि शक्नुयुः ।\nकथमेकतरस्तेषां समस्तान्योधयेत्कुरून् ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2033260, "chapter_id": 1716, "verse_number": "४-३९-४६", "content_sanskrit": "उत्तरः सारथिं कृत्वा निर्यातो नगराद्बहिः।\nस नो मन्ये ध्वजं दृष्ट्वा भीत एष पलायति ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2033261, "chapter_id": 1716, "verse_number": "४-३९-४७x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2033262, "chapter_id": 1716, "verse_number": "४-३९-४७", "content_sanskrit": "नूनं तमेव धावन्तं जिघृक्षति धनञ्जयः।\nसारथिं ह्युत्तरं कृत्वा स्वयं योद्धुमिहेच्छति ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2033263, "chapter_id": 1716, "verse_number": "४-३९-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2033264, "chapter_id": 1716, "verse_number": "४-३९-४८", "content_sanskrit": "इति स्म कुरवः सर्वे विमृशन्तः पृथक्पृथक्।\nन च व्यवसितुं वीरा अर्जुनं शक्नुवन्ति ते ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2033265, "chapter_id": 1716, "verse_number": "४-३९-४९", "content_sanskrit": "दुर्योधन उवाचेदं सैनिकान्रथसत्तमान् ।\nअर्जुनो वासुदेवो वा रामः प्रद्युम्न एव वा।\nते हि नः प्रतिसंयातुं संग्रामे न हि शक्नुयुः ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2033266, "chapter_id": 1716, "verse_number": "४-३९-५०", "content_sanskrit": "अन्यो वै क्लीबरूपेण यद्यागच्छेद्गवां पदम्।\nशस्त्रैस्तीक्ष्णैरर्पयित्वा पातयिष्यामि भूतले ।\nकथमेकतरस्तेषां समस्तान्योधयेत्कुरून् ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2033267, "chapter_id": 1716, "verse_number": "४-३९-५१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2033268, "chapter_id": 1716, "verse_number": "४-३९-५१", "content_sanskrit": "छन्नं तथा तं वेषेण पाण्डवं प्रेक्ष्य सैनिकाः।\nअर्जुनेति च नेत्येव न व्यवस्यन्ति ते पुनः।\nइति स्म कुरवः सर्वे विमृशन्तः पुनः पुनः ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2033269, "chapter_id": 1716, "verse_number": "४-३९-५२", "content_sanskrit": "दृढेवधी महासत्त्वः शक्रतुल्यपराक्रमः ।\nअद्यागच्छति चेद्योद्धुं सर्वं संशयितं बलम् ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2033270, "chapter_id": 1716, "verse_number": "४-३९-५३", "content_sanskrit": "न चाप्यन्यतरं तत्र व्यवस्यन्ति धनञ्जयात् ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2033271, "chapter_id": 1716, "verse_number": "४-३९-५४", "content_sanskrit": "उत्तरं तु प्रधावन्तमनुद्रुत्य धनञ्जयः।\nगत्वा शतपदं तूर्णं केशपक्षे परामृशत् ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2033272, "chapter_id": 1716, "verse_number": "४-३९-५५", "content_sanskrit": "मा मा गृहाण भद्रं ते दासोऽहं ते बृहन्नले।\nइति वादिनमेवाशु धावन्तं तरसाऽग्रहीत्।\nविराटपुत्रं बीभत्सुर्बलवानरिमर्दनः ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2033273, "chapter_id": 1716, "verse_number": "४-३९-५६", "content_sanskrit": "सोऽर्जुनेन परामृष्टः पर्यदेवयदार्तवत् ।\nबहुलं कृपणं चैव वित्तं प्रावेदयद्बहु ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2033274, "chapter_id": 1716, "verse_number": "४-३९-५७", "content_sanskrit": "सुवर्णमणिमुक्तानां यद्यदिच्छसि दद्मि ते।\nहस्तिनोश्वान्रथान्गावः स्त्रियश्च समलङ्कृताः ॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2033275, "chapter_id": 1716, "verse_number": "४-३९-५८", "content_sanskrit": "शातकुम्भस्य शुद्धस्य श्रेष्ठस्य रजतस्य च।\nददामि शतनिष्कं ते मुञ्च मां त्वं बृहन्नले ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2033276, "chapter_id": 1716, "verse_number": "४-३९-५९", "content_sanskrit": "षष्टिं स्वलंकृताः कन्या ग्राममेकं ददामि ते।\nमुञ्च मां त्वं भृशं दीनं विह्वलं भयकम्पितम् ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2033277, "chapter_id": 1716, "verse_number": "४-३९-६०", "content_sanskrit": "मणीनष्टौ च वैडूर्यान्हेमबद्धान्महाप्रभान्।\nहेमदण्डप्रतिच्छन्नं रथं युक्तं तु वाजिभिः ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2033278, "chapter_id": 1716, "verse_number": "४-३९-६१", "content_sanskrit": "मत्तांश्च दश मातङ्गान्मुञ्च मां त्वं बृहन्नले ।\nगमिष्यामि पुरं षण्ड द्रष्टुं मातरमद्य ताम् ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2033279, "chapter_id": 1716, "verse_number": "४-३९-६२", "content_sanskrit": "एकोऽहमेव मे मातुः कुमारः किं ब्रुवे ततः।\nविधिरेवंविधे काले त्वद्वशं कुरुते हि माम् ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2033280, "chapter_id": 1716, "verse_number": "४-३९-६३", "content_sanskrit": "मात्स्यस्य पुत्रो बालोऽहं तेन चास्मि सुपोषितः।\nमातृपार्श्वशयानोऽहमस्पृष्टातपवायुमान् ॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2033281, "chapter_id": 1716, "verse_number": "४-३९-६४", "content_sanskrit": "अदृष्टबालयुद्धोऽहं कुतस्ते कुरवः कुतः।\nमातृपार्श्वं गमिष्यामि मुञ्च मां त्वं बृहन्नले ॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2033282, "chapter_id": 1716, "verse_number": "४-३९-६५", "content_sanskrit": "प्रलयार्णवसंकाशं दृश्यते कौरवं बलम् ॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2033283, "chapter_id": 1716, "verse_number": "४-३९-६६", "content_sanskrit": "स्त्रीणां मध्येऽहमज्ञानाद्वीर्यशौर्याङ्कितां गिरम्।\nउक्तो यौवनगर्वेण को जेतुं शक्नुयात्कुरून् ।\nअमुक्त्वा मां यदि नयेर्मरिष्यामि तवाग्रतः ॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2033284, "chapter_id": 1716, "verse_number": "४-३९-६७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2033285, "chapter_id": 1716, "verse_number": "४-३९-६७", "content_sanskrit": "एवमादीनि वाक्यानि विलपन्तमचेतसम्।\nप्रसभं पुरुषव्याघ्रो रथस्यान्तिकमानयत् ॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2033286, "chapter_id": 1716, "verse_number": "४-३९-६८", "content_sanskrit": "अथैनमब्रवीत्पार्थो भयार्तं नष्टचेतसम् ॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2033287, "chapter_id": 1716, "verse_number": "४-३९-६९", "content_sanskrit": "अहं योत्स्यामि कौरव्यैर्हयान्संयच्छ मेति माम् ।\nआददानः किमर्थं त्वं पलायनपरोऽभवः ॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2033288, "chapter_id": 1716, "verse_number": "४-३९-७०", "content_sanskrit": "युध्यस्व कौरवैः सार्धं विजयस्ते भविष्यति।\nयस्य यन्तास्म्यहं युद्धे संयच्छामि हयोत्तमान्।\nराज्ञो वा राजपुत्रस्य तस्य युद्धे जयो ध्रुवम् ॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2033289, "chapter_id": 1716, "verse_number": "४-३९-७१", "content_sanskrit": "सर्वथोत्तर युध्यस्व यन्त्रा सह मया कुरून् ।\nजित्वा महीं यशः प्राप्य भोक्ष्यसे सकलामिमाम् ॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2033290, "chapter_id": 1716, "verse_number": "४-३९-७२", "content_sanskrit": "हतो वा प्राप्ससे स्वर्गं न श्रेयस्ते पलायनम् ॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2033291, "chapter_id": 1716, "verse_number": "४-३९-७३", "content_sanskrit": "अद्य सर्वान्कुरूञ्जित्वा यथा जयमवाप्स्यसि।\nतथाऽहं प्रयतिष्येऽत्र सहायोऽत्र मतो ह्यहम् ॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2033292, "chapter_id": 1716, "verse_number": "४-३९-७४", "content_sanskrit": "यदि नोत्सहसे योद्धुं शत्रुभिः शत्रुकर्शन।\nएहि मे त्वं हयान्यच्छ युध्यमानस्य शत्रुभिः ॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2033293, "chapter_id": 1716, "verse_number": "४-३९-७५", "content_sanskrit": "प्रयाह्येतद्रथानीकं मद्बाहुपरिरक्षितः ।\nअप्रधृष्यतमं घोरं गुप्तं घोरैर्महारथैः ।\nमा भैस्त्वं राजपुत्राग्र्य क्षत्रियोसि परंतप ॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2033294, "chapter_id": 1716, "verse_number": "४-३९-७६", "content_sanskrit": "अहं तैः कुरुभिर्योत्स्ये प्रत्यानेष्यामि ते पशून् ।\nप्रविशैतद्रथानीकमप्रधृष्यं दुरासदम् ॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2033295, "chapter_id": 1716, "verse_number": "४-३९-७७", "content_sanskrit": "यन्ता भव नरश्रेष्ठ योत्स्येऽहं कुरुभिः सह।\nशूरान्समरचण्डांश्च नयिष्ये यमसादनम् ॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2033296, "chapter_id": 1716, "verse_number": "४-३९-७८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2033297, "chapter_id": 1716, "verse_number": "४-३९-७८", "content_sanskrit": "एवं ब्रुवाणो वैराटिं बीभत्सुरपराजितः।\nसमाश्वास्य भयार्तं तमुत्तरं भरतर्षभः ॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2033298, "chapter_id": 1716, "verse_number": "४-३९-७९", "content_sanskrit": "इतस्ततो विवेष्टन्तमकामं भयपीडितम् ।\nरथमारोपमायास पार्थः परपुरंजयः ॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2033299, "chapter_id": 1716, "verse_number": "४-३९-८०", "content_sanskrit": "तमारोप्य रथोपस्थे विलपन्तं धनञ्जयः।\nगाण्डीवं धनुरादातुमुपायात्तां शमीं प्रति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2033300, "chapter_id": 1716, "verse_number": "४-३९-८१", "content_sanskrit": "उत्तरं तं समाश्वास्य कृत्वा यन्तारमर्जुनः ॥ ८० ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2033301, "chapter_id": 1716, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि एकोनचत्वारिंशोऽध्यायः ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]