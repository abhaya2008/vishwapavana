[{"id": 2044088, "chapter_id": 1989, "verse_number": "६-३८-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044089, "chapter_id": 1989, "verse_number": "६-३८-१", "content_sanskrit": "परं भूयः प्रवक्ष्यामि ज्ञानानां ज्ञानमुत्तमम् ।\nयज्ज्ञात्वा मुनयः सर्वे परां सिद्धिमितो गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044090, "chapter_id": 1989, "verse_number": "६-३८-२", "content_sanskrit": "इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः।\nसर्गेऽपि नोपजायन्ते प्रलये न व्यथन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044091, "chapter_id": 1989, "verse_number": "६-३८-३", "content_sanskrit": "मम योनिर्महद्ब्रह्म तस्मिन्गर्भं दधाम्यहम् ।\nसंभवः सर्वभूतानां ततो भवति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044092, "chapter_id": 1989, "verse_number": "६-३८-४", "content_sanskrit": "सर्वयोनिषु कौन्तेय मूर्तयः संभवन्तिः याः ।\nतासां ब्रह्म महद्योनिरहं बीजप्रदः पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044093, "chapter_id": 1989, "verse_number": "६-३८-५", "content_sanskrit": "सत्वं रजस्तम इति गुणाः प्रकृतिसंभवाः ।\nनिबध्नन्ति महाबाहो देहे देहिनमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044094, "chapter_id": 1989, "verse_number": "६-३८-६", "content_sanskrit": "तत्र सत्त्वं निर्मलत्वात्प्रकाशकमनामयम् ।\nसुखसङ्गेन बध्नाति ज्ञानसङ्गेन चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044095, "chapter_id": 1989, "verse_number": "६-३८-७", "content_sanskrit": "रजो रागात्मकं विद्धि तृष्णासङ्गसमुद्भवम् ।\nतन्निबध्नाति कौन्तेय कर्मसङ्गेन देहिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044096, "chapter_id": 1989, "verse_number": "६-३८-८", "content_sanskrit": "तमस्त्वज्ञानजं विद्धि मोहनं सर्वदेहिनाम् ।\nप्रमादालस्यनिद्राभिस्तन्निबध्नाति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044097, "chapter_id": 1989, "verse_number": "६-३८-९", "content_sanskrit": "सत्वं सुखे संजयति रजः कर्मणि भारत ।\nज्ञानमावृत्य तु तमः प्रमादे संजयत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044098, "chapter_id": 1989, "verse_number": "६-३८-१०", "content_sanskrit": "रजस्तमश्चाभिभूय सत्वं भवति भारत।\nरजः सत्वं तमश्चैव तमः सत्वं रजस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044099, "chapter_id": 1989, "verse_number": "६-३८-११", "content_sanskrit": "सर्वद्वारेषु देहेऽस्मिन्प्राकाश उपजायते।\nज्ञानं यदा तदा विद्याद्विवृद्धं सत्वमित्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044100, "chapter_id": 1989, "verse_number": "६-३८-१२", "content_sanskrit": "लोभः प्रवृत्तिरारम्भः कर्मणामशमः स्पृहा ।\nरजस्येतानि जायन्ते विवृद्धे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044101, "chapter_id": 1989, "verse_number": "६-३८-१३", "content_sanskrit": "अप्रकाशोऽप्रवृत्तिश्च प्रमादो मोह एव च ।\nतमस्येतानि जायन्ते विवृद्धे कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044102, "chapter_id": 1989, "verse_number": "६-३८-१४", "content_sanskrit": "यदा सत्वे प्रवृद्धे तु प्रलयं याति देहभृत् ।\nतदोत्तमविदां लोकानमलान्प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044103, "chapter_id": 1989, "verse_number": "६-३८-१५", "content_sanskrit": "रजसि प्रलयं गत्वा कर्मसङ्गिषु जायते ।\nतथा प्रलीनस्तमसि मूढयोनिषु जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044104, "chapter_id": 1989, "verse_number": "६-३८-१६", "content_sanskrit": "कर्मणः सुकृतस्याहुः सात्विकं निर्मलं फलम्।\nरजसस्तु फलं दुःखमज्ञानं तमसः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044105, "chapter_id": 1989, "verse_number": "६-३८-१७", "content_sanskrit": "सत्वात्संजायते ज्ञानं रजसो लोभ एव च।\nप्रमादमोहौ तमसो भवतोऽज्ञानमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044106, "chapter_id": 1989, "verse_number": "६-३८-१८", "content_sanskrit": "ऊर्ध्वं गच्छन्ति सत्वस्था मध्ये तिष्ठन्ति राजसाः ।\nजघन्यगुणवृत्तस्था अघो गच्छन्ति तामसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044107, "chapter_id": 1989, "verse_number": "६-३८-१९", "content_sanskrit": "नान्यं गुणेभ्यः कर्तारं यदा द्रष्टाऽनुपश्यति ।\nगुणेभ्यश्च परं वेत्ति मद्भावं सोऽधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044108, "chapter_id": 1989, "verse_number": "६-३८-२०", "content_sanskrit": "गुणानेतानतीत्य त्रीन्देही देहसमुद्भवान् ।\nजन्ममृत्युजरादुःखैर्विमुक्तोऽमृतमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044109, "chapter_id": 1989, "verse_number": "६-३८-२१x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044110, "chapter_id": 1989, "verse_number": "६-३८-२१", "content_sanskrit": "कैर्लिङ्गैस्त्रीन्गुणानेतानीतो भवति प्रभो ।\nकिमाचारः कथं चैतांस्त्रीन्गुणानतिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044111, "chapter_id": 1989, "verse_number": "६-३८-२२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044112, "chapter_id": 1989, "verse_number": "६-३८-२२", "content_sanskrit": "प्रकाशं च प्रवृत्तिं च मोहमेव च पाण्डव।\nन द्वेष्टि संप्रवृत्तानि न निवृत्तानि काङ्क्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044113, "chapter_id": 1989, "verse_number": "६-३८-२३", "content_sanskrit": "उदासीनवदासीनो गुणैर्यो न विचाल्यते ।\nगुणा वर्तन्त इत्येव योऽवतिष्ठति नेङ्गते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044114, "chapter_id": 1989, "verse_number": "६-३८-२४", "content_sanskrit": "समदुःखसुखः स्वस्थः समलोष्टाश्मकाञ्चनः ।\nतुल्यप्रियाप्रियो धीरस्तुल्यनिन्दात्मसंस्तुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044115, "chapter_id": 1989, "verse_number": "६-३८-२५", "content_sanskrit": "मानापमानयोस्तुल्यस्तुल्यो मित्रारिपक्षयोः ।\nसर्वारम्भपरित्यागी गुणातीतः स उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044116, "chapter_id": 1989, "verse_number": "६-३८-२६", "content_sanskrit": "मां च योऽव्यभिचारेण भक्तियोगेन सेवते ।\nस गुणान्समतीत्यैतान्ब्रह्म भूयाय कल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044117, "chapter_id": 1989, "verse_number": "६-३८-२७", "content_sanskrit": "ब्रह्मणो हि प्रतिष्ठाहममृतस्याव्ययस्य च।\nशाश्वतस्य च धर्मस्य सुखस्यैकान्तिकस्य च ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044118, "chapter_id": 1989, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि अष्टत्रिंशोऽध्यायः ॥\nइति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्दुनसंवादे गुणत्रयविभागयोगोनाम चतुर्दशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]