[{"id": 7002595000, "chapter_id": 22595, "verse_number": "३-२०-१", "content_sanskrit": "सूत उवाच ।\nसप्ताग्निष्टोमको नाम द्युत्तमः कथितो विधिः ।\nमध्यमे मध्यमफलं कनिष्ठे तु कनिष्ठकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002595001, "chapter_id": 22595, "verse_number": "३-२०-२", "content_sanskrit": "अधुना मध्यमं वक्ष्ये विधिं शास्त्रानुसारतः ।\nयथाविभवयागेन यत्कर्तव्यं नरेण वै ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002595002, "chapter_id": 22595, "verse_number": "३-२०-३", "content_sanskrit": "सद्योधिवासकल्पेन यूपादीनधिवास्य च ।\nपूर्वस्मिन्नेव दिवसे दैवज्ञकथिते शुभे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002595003, "chapter_id": 22595, "verse_number": "३-२०-४", "content_sanskrit": "मुहूर्ते कलशं स्थाप्य संगृह्य गणनायकम् ।\nस्थापयेत्प्रथमं यूपमा पोहिष्ठेतिमन्त्रकैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002595004, "chapter_id": 22595, "verse_number": "३-२०-५", "content_sanskrit": "शन्नो देव्यास्ततः पश्चाद्गन्धद्वारेति गंधकम् ।\nश्रीसूक्तेन ततो दद्यात्पुष्पं दूर्वाक्षतं ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002595005, "chapter_id": 22595, "verse_number": "३-२०-६", "content_sanskrit": "काण्डादिति च मन्त्रेण ततो धूपं निवेदयेत् ।\nये गृह्णामीति च ऋचा पूजायां स्थापयेत्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002595006, "chapter_id": 22595, "verse_number": "३-२०-७", "content_sanskrit": "विवाहविधिना सर्वं कार्यं चैवाधिवासनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002595007, "chapter_id": 22595, "verse_number": "३-२०-८", "content_sanskrit": "सर्वमेव प्रयुंजीत तडागादिषु पण्डितः ।\nअधिवास्य तडागादीनाचार्यादींश्च सर्वशः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002595008, "chapter_id": 22595, "verse_number": "३-२०-९", "content_sanskrit": "संगृह्य गंधपुष्पाद्यैर्धूपैर्दीपैः सुशोभनैः ।\nततः प्रभातसमये नित्यं निर्वर्त्य शास्त्रतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002595009, "chapter_id": 22595, "verse_number": "३-२०-१०", "content_sanskrit": "वृद्धिश्राद्धं ततः कुर्यान्मातृपूजापुरःसरम् ।\nअलंकृत्य यथाशक्ति आचार्यादींश्चरेद्बुधः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002595010, "chapter_id": 22595, "verse_number": "३-२०-११", "content_sanskrit": "शृणुयात्पश्चिमे भागे मंडपस्य समीपतः ।\nमध्यदेशे समुद्भूतं यज्ञपात्रं प्रशस्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002595011, "chapter_id": 22595, "verse_number": "३-२०-१२", "content_sanskrit": "अथ वा तत्र देशीयं गुरुं वा श्रोत्रियोद्भवम् ।\nयज्ञे प्रधानद्वितीयमृत्विगाचार्यमेव हि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002595012, "chapter_id": 22595, "verse_number": "३-२०-१३", "content_sanskrit": "वैतानकल्पे संपन्नं शक्तिकल्पपरायणम् ।\nनिगमज्ञानसंपन्नं यज्ञे पात्रं प्रशस्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002595013, "chapter_id": 22595, "verse_number": "३-२०-१४", "content_sanskrit": "पत्नीहीनमपुत्रं च श्यावदंतमदंतकम् ।\nगणानां याजकं षंढं स्वगोत्रं परिवर्जयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002595014, "chapter_id": 22595, "verse_number": "३-२०-१५", "content_sanskrit": "अप्रधानेषु यज्ञेषु दानयज्ञेषु सत्तमाः ।\nनियोजयेत्स्वगोत्रं च होमे नस्ति विचारणा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002595015, "chapter_id": 22595, "verse_number": "३-२०-१६", "content_sanskrit": "कुशप्रतिकृतौ चापि ततः स्वर्गं स गच्छति ।\nधनमादौ च संशोध्य ततो यज्ञं समाचरेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002595016, "chapter_id": 22595, "verse_number": "३-२०-१७", "content_sanskrit": "अयाज्ययाजनोद्भूतं पल्लवं व्यवहारके ।\nकूटसाक्ष्येण पल्लवे स्थाप्यहारकमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002595017, "chapter_id": 22595, "verse_number": "३-२०-१८", "content_sanskrit": "देवस्वं ब्राह्मणस्वं च लोहविक्रयणं धनम् ।\nहविर्विक्रयणं कृत्वा पुत्रभार्या दिविक्रयी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002595018, "chapter_id": 22595, "verse_number": "३-२०-१९", "content_sanskrit": "निंदितानि पुराणेषु यत्कृतं तत्र तत्फलम् ।\nयज्ञसद्मनि विप्रांश्च न श्राद्धान्भोजयेत्क्वचित् ।\nन दद्यात्तस्य दानं च यावन्नैव समापयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002595019, "chapter_id": 22595, "verse_number": "३-२०-२०", "content_sanskrit": "ब्रह्मन्नाचार्यमुख्योसि संसारात्त्राहि मां विभो ।\nत्वत्प्रसादाद्गुरो यज्ञे प्राप्नुयां मानसेप्सितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002595020, "chapter_id": 22595, "verse_number": "३-२०-२१", "content_sanskrit": "चिरं मे शाश्वती कीर्तिर्यावल्लोकाश्चराचराः ।\nप्रसीद त्वं महेशान प्रतिष्ठाकर्मसिद्धये ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002595021, "chapter_id": 22595, "verse_number": "३-२०-२२", "content_sanskrit": "त्वमादिः सर्वभूतानां संसारार्णवतारक ।\nज्ञानामृतप्रदाचार्य विष्णु रूप नमोऽस्तु ते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002595022, "chapter_id": 22595, "verse_number": "३-२०-२३", "content_sanskrit": "ब्रह्मासनसमुद्भूतं प्रकाशितदिगंतरम् ।\nत्वं च जांबूनदप्रख्य यजुर्वेद नमोस्तु ते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002595023, "chapter_id": 22595, "verse_number": "३-२०-२४", "content_sanskrit": "प्रफुल्लकमलोद्भासि भास्वरांबरभूषित ।\nप्रकीर्णशास्त्रसंभार विधिज्ञ प्रणतोस्मि ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002595024, "chapter_id": 22595, "verse_number": "३-२०-२५", "content_sanskrit": "ज्वलद्वैश्वानरप्रख्य धूमश्यामालितानन ।\nषडंगवेदतत्त्वज्ञ ऋत्विङ् मोक्षं समाचर ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002595025, "chapter_id": 22595, "verse_number": "३-२०-२६", "content_sanskrit": "ततस्तूर्यादिघोषेण पुरस्कृत्य द्विजोत्तमान् ।\nयजमानः सपत्नीकः प्रविशेद्यागमण्डपम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002595026, "chapter_id": 22595, "verse_number": "३-२०-२७", "content_sanskrit": "स्वस्थाने स्थापयेद्विप्रान्मखे धर्मैर्यथाक्रमम् ।\nपूजयेद्गन्धमाल्याद्यैर्गंधाद्यैः सुमनोहरैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002595027, "chapter_id": 22595, "verse_number": "३-२०-२८", "content_sanskrit": "यज्ञे सुवितते योसौ पूज्यते पुरुषः सदा ।\nनारायणस्वरूपोसौ यज्ञं मे सफलं कुरु ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002595028, "chapter_id": 22595, "verse_number": "३-२०-२९", "content_sanskrit": "मखश्रेष्ठेषु सर्वेषु येन मंत्राः सुविस्तृताः ।\nयजुर्वेदार्थतत्त्वज्ञ ब्रह्मरूप नमोस्तु ते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002595029, "chapter_id": 22595, "verse_number": "३-२०-३०", "content_sanskrit": "यज्ञेषु साक्षी सर्वेषु वेदवेदार्थतत्त्ववित् ।\nऋग्वेदज्ञ महाप्राज्ञ विश्वरूप नमोस्तु ते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002595030, "chapter_id": 22595, "verse_number": "३-२०-३१", "content_sanskrit": "मांगल्यं कर्मणां नित्यं शाश्वतं ब्रह्मरूपिणम् ।\nसिद्धये मम यज्ञस्य नमामि शिवरूपिणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002595031, "chapter_id": 22595, "verse_number": "३-२०-३२", "content_sanskrit": "पालयंति दिशः सर्वा विदिशश्च तथा इमाः ।\nदिक्पालरूपिणं विप्रं यज्ञसिद्ध्यै नमाम्यहम् ।\nपातयेद्दक्षिणं जानु विकिरान्विकिरेत्ततः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002595032, "chapter_id": 22595, "verse_number": "३-२०-३३", "content_sanskrit": "त्रैलोक्ये यानि भूतानि स्थावराणि चराणि च ।\nब्रह्मविष्णुशिवाः सर्वे रक्षां कुर्वंतु तानि वै ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002595033, "chapter_id": 22595, "verse_number": "३-२०-३४", "content_sanskrit": "वेद्यावेदीति मंत्रेण पठेद्वेदिं प्रणम्य च ।\nसंपूज्य गन्धपुष्पाद्यैरिमं मंत्रमुदा हरेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002595034, "chapter_id": 22595, "verse_number": "३-२०-३५", "content_sanskrit": "याजनं यजमानश्च श्रेयसा तत्र याजकः ।\nइदमर्घ्यमिदं पाद्यं धूपोयं प्रतिगृह्यताम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002595035, "chapter_id": 22595, "verse_number": "३-२०-३६", "content_sanskrit": "ऐशान्यां कलशे देवं संपूज्य गण नायकम् ।\nब्रह्माणं वासुदेवं च द्वितीयकलशे यजेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002595036, "chapter_id": 22595, "verse_number": "३-२०-३७", "content_sanskrit": "मंडलं चैव विष्णुर्वै द्वारकारूपमास्थितः ।\nतेन त्वां पूजयाम्यद्य स्वर्गप्राप्तिं कुरुष्व मे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002595037, "chapter_id": 22595, "verse_number": "३-२०-३८", "content_sanskrit": "पूर्वादिदिक्षु कलशान्संस्थाप्य च त्रयंत्रयम् ।\nअर्धपादसवर्णेन निर्मितं तारणं बुधः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002595038, "chapter_id": 22595, "verse_number": "३-२०-३९", "content_sanskrit": "गंगामृत्तिकया युक्ते पल्लवे संनिवेदयेत् ।\nमंदरं कल्पयित्वा तु गोपीनां च कुलेन वा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002595039, "chapter_id": 22595, "verse_number": "३-२०-४०", "content_sanskrit": "कलशोपरि संस्थाप्य मंदरं संप्रपूजयेत् ।\nस्योना पृथिवीति मंत्रेण गंधपुष्पैः पृथिग्विधैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002595040, "chapter_id": 22595, "verse_number": "३-२०-४१", "content_sanskrit": "एवं दक्षिणदिग्भागे नवतोलकनिर्मितम् ।\nप्रादेशमात्रलोहं तु रौप्येण गंधमादनम् ।\nमृदा संघटनैः पश्चात्कदाचन ऋचा यजेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002595041, "chapter_id": 22595, "verse_number": "३-२०-४२", "content_sanskrit": "कदाचनेति मंत्रस्य सूर्य ऋषिस्त्रिष्टुप्छन्दः सूर्यो देवता गंधमादनप्रीतये विनियोगः  ।\nउत्तरे तोरणतोद्रेरंगुष्ठद्वयमानके ।\nतोलकद्वयमानेन यवानां पिष्टकोपरि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002595042, "chapter_id": 22595, "verse_number": "३-२०-४३", "content_sanskrit": "पूजयेत्पार्श्वकलशे धात्रादीन्पूर्वदिक्क्रमात् ।\nश्रीसूक्तेनैव मन्त्रेण यजेद्विजयसप्तकम् ।\nपूजयेत्परया भक्त्या गंधपुष्पाक्षतादिना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002595043, "chapter_id": 22595, "verse_number": "३-२०-४४", "content_sanskrit": "अंबाअंबिकेति मंत्रस्य नलिन ऋषिर्गायत्री छन्दः शंभुर्देवता जय प्रीतये विनियोगः ।\nगायत्र्या पूजयेद्दक्षे पश्चिमं कलशद्वयम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002595044, "chapter_id": 22595, "verse_number": "३-२०-४५", "content_sanskrit": "भद्रं चैव सुभद्रं च प्रयतः संयजेद्बुधः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002595045, "chapter_id": 22595, "verse_number": "३-२०-४६", "content_sanskrit": "भूतशुद्धिं ततः कृत्वा न्यासं कृत्वा विधानतः ।\nविधायार्घ्यादिकं चैव धर्मादिमंडले यजेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002595046, "chapter_id": 22595, "verse_number": "३-२०-४७", "content_sanskrit": "मध्ये आधारशक्त्यादीन्वरुणं मध्यतो यजेत् ।\nपूर्वादिक्रमतश्चैव इन्द्रादीन्कुलदेवताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002595047, "chapter_id": 22595, "verse_number": "३-२०-४८", "content_sanskrit": "पार्श्वद्वये कर्णिकाया ब्रह्माणं चाप्यनन्तकम् ।\nस्वैःस्वैर्मंत्रैर्यथोक्तैश्च बलिभिर्गन्धपुष्पकैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002595048, "chapter_id": 22595, "verse_number": "३-२०-४९", "content_sanskrit": "इन्द्राभिषेकमंत्रस्य वाद्यं गांधाररागकम् ।\nअग्नेस्तेजोसीति वाद्यं रागं चैव वराटकम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002595049, "chapter_id": 22595, "verse_number": "३-२०-५०", "content_sanskrit": "घनकंटकमस्यापि वाच्यं रागं तु गुर्जरम् ।\nरक्षोधिपस्य संग्रामं वैतालं वाद्यमुच्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002595050, "chapter_id": 22595, "verse_number": "३-२०-५१", "content_sanskrit": "नाटकाख्यं तथा रागं वरुणस्यापि मे शृणु ।\nवाद्यं राज्याभिषेकाख्यं रागो वसंतसंज्ञकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002595051, "chapter_id": 22595, "verse_number": "३-२०-५२", "content_sanskrit": "ईशस्य नंदिघोषाख्यं वाद्यं रागोथ कामदः ।\nसुवर्णं दुंदुभिर्वाद्यं ब्रह्मणः कथितो बुधैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002595052, "chapter_id": 22595, "verse_number": "३-२०-५३", "content_sanskrit": "रागो देवी वसंतश्च अनंतस्य निबोध मे ।\nवाद्यं गांधारताराख्यं रागश्चाङ्गारवातकः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002595053, "chapter_id": 22595, "verse_number": "३-२०-५४", "content_sanskrit": "सोमे घोषे भवेद्वाद्यं जलेशस्य महात्मनः ।\nमालवाख्यो भवेद्रागः पत्राग्रेषु महानपि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002595054, "chapter_id": 22595, "verse_number": "३-२०-५५", "content_sanskrit": "स्वैः स्वैर्धर्मैश्च संगृह्य दक्षिणे पृथिवीं यजेत् ।\nस्योना पृथिवीति मंत्रेण उपचारैः पृथग्विधैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002595055, "chapter_id": 22595, "verse_number": "३-२०-५६", "content_sanskrit": "मण्डपस्योत्तरे भागे महादेवं प्रपूजयेत् ।\nनमो वृक्षेभ्य इत्यादि नैवेद्यैश्च पृथग्विधैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002595056, "chapter_id": 22595, "verse_number": "३-२०-५७", "content_sanskrit": "गंधपुष्पादिभिर्भक्त्या भूतानि परितो यजेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002595057, "chapter_id": 22595, "verse_number": "३-२०-५८", "content_sanskrit": "वेतालाश्च पिशाचाश्च राक्षसाश्च सरी सृपाः ।\nअस्मात्प्रयांतु मे स्थानाद्ये चान्ये विघ्नकारकाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002595058, "chapter_id": 22595, "verse_number": "३-२०-५९", "content_sanskrit": "मधुयुक्तं पायसान्नं वरुणाय निवेदयेत् ।\nपीतं चालोहितं कृष्णं शुद्धं कृष्णं च धूम्रकम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002595059, "chapter_id": 22595, "verse_number": "३-२०-६०", "content_sanskrit": "पीतं शुक्लं तथा चित्रं श्वेतमन्नं यथाक्रमम् ।\nबलयस्तु दिगीशानां ग्रहाणामपि ताञ्छृणु ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002595060, "chapter_id": 22595, "verse_number": "३-२०-६१", "content_sanskrit": "क्षीरौदनं ग्रहेशाय शुक्लान्नं शशिने स्मृतम् ।\nलोहितान्नं च भौमाय बुधाय क्षीरषाष्टिकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002595061, "chapter_id": 22595, "verse_number": "३-२०-६२", "content_sanskrit": "पीतमन्नं देवगुरोः शुक्रस्य सिततंदुलम् ।\nमांसौदनं शनेर्ज्ञेयं राहोश्च कृष्ण भक्तकम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002595062, "chapter_id": 22595, "verse_number": "३-२०-६३", "content_sanskrit": "धूम्रवर्णं तु ताम्रं तु भौमस्य क्षीरषाष्टिकम् ।\nपिष्टकान्नं शिवस्योक्तं भूतानां माषभक्तकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002595063, "chapter_id": 22595, "verse_number": "३-२०-६४", "content_sanskrit": "एवं बलिं विधायाथ अग्रे कुंभं निवेशयेत् ।\nप्रदेशद्व्यङ्गुलं नाम अष्टोत्तरसहस्रकम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002595064, "chapter_id": 22595, "verse_number": "३-२०-६५", "content_sanskrit": "बह्वंगुलकं विन्यस्य विन्यस्य कलशोपरि ।\nनिशावांछ्तिसूत्रैश्च संवेष्ट्य पिहितं तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002595065, "chapter_id": 22595, "verse_number": "३-२०-६६", "content_sanskrit": "शरावं च पुनर्दद्याद्वर्धनीं प्रतिपूजयेत् ।\nअस्त्राय फडिति मंत्रेण ध्यात्वा देवं जलेश्वरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002595066, "chapter_id": 22595, "verse_number": "३-२०-६७", "content_sanskrit": "सूक्तं यजेद्यथाशक्ति शतमष्टोत्तरं जपेत् ।\nकुंडेषु विन्यसेन्नागानष्टौ पूर्वादिषु क्रमात् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002595067, "chapter_id": 22595, "verse_number": "३-२०-६८", "content_sanskrit": "अनंतं पूजयेत्पूर्वं मानेनांगुलमात्रकम् ।\nनिर्मितं कांचनेनैव सप्तवर्तिकया सुधीः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002595068, "chapter_id": 22595, "verse_number": "३-२०-६९", "content_sanskrit": "राजतं वासुकिं नागं यजेत्पत्रांतरे पुनः ।\nपादमात्रेपि चांगुष्ठमात्रं ताम्रस्य भक्ष्यकम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002595069, "chapter_id": 22595, "verse_number": "३-२०-७०", "content_sanskrit": "पंचांगुलं तोलिकया लोहं कर्कोटकं पुनः ।\nवर्तिकाभिः षोडशभिर्बृहत्पर्वप्रमाणकम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002595070, "chapter_id": 22595, "verse_number": "३-२०-७१", "content_sanskrit": "शंखपालं कुशमयमर्धपादेन निर्मितम् ।\nअंगुष्ठमात्रं रक्तेन नागं तालकमात्रकम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002595071, "chapter_id": 22595, "verse_number": "३-२०-७२", "content_sanskrit": "अंगुष्ठे तोलकं पश्चात्पद्मनागं पुनर्यजेत् ।\nतोलकार्धप्रमाणेन अंगुलं परिमाणतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002595072, "chapter_id": 22595, "verse_number": "३-२०-७३", "content_sanskrit": "कुर्याच्छैलमयं सम्यग्यथावल्लक्षणान्वितम् ।\nमहापद्मस्य वै तस्य पूर्वमानेन निर्मितम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002595073, "chapter_id": 22595, "verse_number": "३-२०-७४", "content_sanskrit": "ध्यात्वानंतं चतुर्बाहुं शुक्लसप्तफणान्वितम् ।\nदक्षिणोर्ध्वकरे शंखमधिचक्रं प्रतिष्ठितम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002595074, "chapter_id": 22595, "verse_number": "३-२०-७५", "content_sanskrit": "वामोर्ध्वे तु गदापद्मं मध्यस्थाने व्यवस्थितम् ।\nसर्वालंकारसंयुक्तमेवं ध्यात्वा यथाविधि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002595075, "chapter_id": 22595, "verse_number": "३-२०-७६", "content_sanskrit": "सहस्रशीर्षेति मंत्रेण पूजयित्वा बलिं हरेत् ।\nलाजैश्च तिलसंमिश्रैः क्षीरयुक्तैः पृथग्विधैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002595076, "chapter_id": 22595, "verse_number": "३-२०-७७", "content_sanskrit": "चतुर्विधं तथा श्वेतं सर्वालंकारसंयुतम् ।\nस्वकीयं प्रजपेत्तत्र आप्यायस्वेति वै ऋचा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002595077, "chapter_id": 22595, "verse_number": "३-२०-७८", "content_sanskrit": "पिण्याकं नागजिह्वां च तथा सर्जरसं दधि ।\nबलयस्तस्य निर्दिष्टास्तक्षकं लोहितं यजेत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002595078, "chapter_id": 22595, "verse_number": "३-२०-७९", "content_sanskrit": "पद्मं टंकं दधानं च भुजाभ्यां नागसत्तमम् ।\nमनोन्ना इति मंत्रेण आज्यं सोमो बलिं हरेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002595079, "chapter_id": 22595, "verse_number": "३-२०-८०", "content_sanskrit": "कर्कोटकं च द्विभुजं पीतवस्त्रधरं यजेत् ।\nपञ्च नद्य इति ऋचा विष्णुक्रांता बलिर्भवेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002595080, "chapter_id": 22595, "verse_number": "३-२०-८१", "content_sanskrit": "पीतवस्त्रं च कुलिशं याजयेत्तु चतुर्भुजम् ।\nभुजाभ्यामूर्ध्वभागे तु रक्तपद्मधरं हरिम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002595081, "chapter_id": 22595, "verse_number": "३-२०-८२", "content_sanskrit": "शर्करा कुष्ठकं चैव बलिस्तस्य प्रकी र्तितः ।\nद्विभुजं शंखपालं च शंखाभं शंखधारिणम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002595082, "chapter_id": 22595, "verse_number": "३-२०-८३", "content_sanskrit": "पद्मासनस्थं पद्माभ्यां हस्ताभ्यां च वरं विभुम् ।\nध्रुवक्षितिध्रुवोसीति मंत्राभ्यां पूजयेत्पृथक् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002595083, "chapter_id": 22595, "verse_number": "३-२०-८४", "content_sanskrit": "घटौदनं भृंगराजं पद्मं च वलयस्तयोः ।\nस्वगृह्योक्तेन विधिना संस्थाप्याग्निं कुशंडिकाम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002595084, "chapter_id": 22595, "verse_number": "३-२०-८५", "content_sanskrit": "कृत्वा आज्यस्य संस्कारं वारुणं श्रपयेच्चरुम् ।\nजुहुयादष्ट बिल्वानि दिगीशानां घृतेन वै ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002595085, "chapter_id": 22595, "verse_number": "३-२०-८६", "content_sanskrit": "एकैकामाहुतिं दद्याद्ग्रहाणां च त्रयंत्रयम् ।\nसुसमिद्भिर्घृतमधु पयोभिर्मिश्रितैः पृथक् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002595086, "chapter_id": 22595, "verse_number": "३-२०-८७", "content_sanskrit": "पलाशसमिधं पश्चात्प्रतिष्ठामाहुतित्रयम् ।\nशिवस्य परमान्नेन जुहुयादष्टसंख्यया ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002595087, "chapter_id": 22595, "verse_number": "३-२०-८८", "content_sanskrit": "मध्वाज्यगुडमिश्राभिर्लाजाभिर्जुहुयात्पृथक् ।\nलाजान्यथोक्तं वितरेदेकैकामाहुतिं क्रमात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002595088, "chapter_id": 22595, "verse_number": "३-२०-८९", "content_sanskrit": "स्थालीपाकस्य जुहुयादेकैकामाहुतिं पुनः ।\nवरुणं च समुद्दिश्य रुद्रं सर्वं पृथक्पृथक् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002595089, "chapter_id": 22595, "verse_number": "३-२०-९०", "content_sanskrit": "वास्तोष्पतय इति मंत्रेण पञ्चगव्यो भवेत्ततः ।\nस्योनापृथिवीति मंत्रेण व्रीहिमृत्तिकया पुनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002595090, "chapter_id": 22595, "verse_number": "३-२०-९१", "content_sanskrit": "वृषान्न इति मंत्रेण कया न इति वै पुनः ।\nकुशमूलमृदा चैव चतुष्पथमृदा तथा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002595091, "chapter_id": 22595, "verse_number": "३-२०-९२", "content_sanskrit": "इमा रुद्रेति मंत्रेण श्रीश्चेति ऋचा पुनः ।\nपद्मखण्डस्य च मृदा स्नापयेत्सुसमाहितः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002595092, "chapter_id": 22595, "verse_number": "३-२०-९३", "content_sanskrit": "तद्विष्णोरिति मंत्रेण तथा पुष्पोदकेन च ।\nतीर्थोदकेन कृष्णेन त्रिरक्तेन त्रिशीतकैः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002595093, "chapter_id": 22595, "verse_number": "३-२०-९४", "content_sanskrit": "पञ्चरक्तेन रक्तानां मृदा कैश्च कुशोदकैः ।\nस्वर्णतोयैश्च कलशैरष्टोत्तरशतेन तु ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002595094, "chapter_id": 22595, "verse_number": "३-२०-९५", "content_sanskrit": "तैजसैर्मार्त्तिकैश्चापि अष्टाविंशतिभिस्तथा ।\nयथाशक्ति तु संस्थाप्य कुंकुमैश्चन्दनैरपि ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002595095, "chapter_id": 22595, "verse_number": "३-२०-९६", "content_sanskrit": "अन्नं लिप्य ततो मृद्भिर्दद्याच्चैव यथाक्रमम् ।\nसुरासुरेति च ऋचा वस्त्रयुग्मेन वेष्टयेत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002595096, "chapter_id": 22595, "verse_number": "३-२०-९७", "content_sanskrit": "ध्वजं च धनुनागेति गंधद्वारेति गोमयम् ।\nधूरसीति ततो धूपं होत्रे चाहुतिदीपकम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002595097, "chapter_id": 22595, "verse_number": "३-२०-९८", "content_sanskrit": "सिंधोसीति च सिंदूरं स्वभावे रक्तकं तथा ।\nमालतीकुसुमैः कृत्यैर्नागान्संस्थापयेत्ततः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002595098, "chapter_id": 22595, "verse_number": "३-२०-९९", "content_sanskrit": "धाराभिः शतपुष्पाभिर्गन्धतोयादिभिस्तथा ।\nअथवाश्वत्थपत्रेषु वटपत्रेषु वा सुधीः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002595099, "chapter_id": 22595, "verse_number": "३-२०-१००", "content_sanskrit": "रोचना कुंकुमैर्वापि संलिख्य तत्र पूजयेत् ।\nप्रक्षिपेत्तत्र मुक्ता हि कलशेषु विनिक्षिपेत् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002595100, "chapter_id": 22595, "verse_number": "३-२०-१०१", "content_sanskrit": "मंडपस्योत्तरेदेशे शय्यां निर्माय शोभनाम् ।\nराजतं वारुणं तस्यां पादमात्रेण निर्मिताम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002595101, "chapter_id": 22595, "verse_number": "३-२०-१०२", "content_sanskrit": "अंगुष्ठमात्रं संस्थाप्य ततः पुष्करिणीमपि ।\nस्वर्णपादेन घटितां चतुरस्रां सुशोभनाम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002595102, "chapter_id": 22595, "verse_number": "३-२०-१०३", "content_sanskrit": "अंगुष्ठमात्रं सम्पूज्य वरुणाय निवेदयेत् ।\nयथाशक्ति ततो गां च संभवे पञ्चविंशतिः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002595103, "chapter_id": 22595, "verse_number": "३-२०-१०४", "content_sanskrit": "सुवर्णं राजतं चैव धान्यं वासो वराटकम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002595104, "chapter_id": 22595, "verse_number": "३-२०-१०५", "content_sanskrit": "नागयष्टिं समादाय किंचिदुत्तरगां तथा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002595105, "chapter_id": 22595, "verse_number": "३-२०-१०६", "content_sanskrit": "ततोक्षताय भौमाय कृत्वा चाज्याहुतित्रयम् ।\nलाजान्दधिसमायुक्तं घृतं मधु गुडं तथा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002595106, "chapter_id": 22595, "verse_number": "३-२०-१०७", "content_sanskrit": "क्षीरं च पिष्टकं चैव शष्कुलीगन्धपुष्पकम् ।\nपंचामृतं पञ्चरत्नं गर्भे दद्यात्समाहितः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002595107, "chapter_id": 22595, "verse_number": "३-२०-१०८", "content_sanskrit": "आचार्यो यजमानेन सुसन्नद्धैश्च भृत्यकैः ।\nगंगाजलेशयोर्मध्ये पंचघोषपुरःसरम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002595108, "chapter_id": 22595, "verse_number": "३-२०-१०९", "content_sanskrit": "अवाप्य च ततो यष्टिं स्थिरो भवति वैरिवा ।\nध्रुवं ध्रुवेति मंत्रेण यष्टिमा मंत्रयेत्ततः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002595109, "chapter_id": 22595, "verse_number": "३-२०-११०", "content_sanskrit": "यज्ञप्रियासि देवि त्वं सर्वविघ्नविनाशिनी ।\nपाहि मां सर्वपापेभ्य आत्मना त्वं स्थिरीभव ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002595110, "chapter_id": 22595, "verse_number": "३-२०-१११", "content_sanskrit": "इत्यामंत्र्य यजेच्चैव गायत्रीं च पठेत्ततः ।\nवनस्पतेति विडवामिति मंत्रं जपेत्पुनः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002595111, "chapter_id": 22595, "verse_number": "३-२०-११२", "content_sanskrit": "पुनरागत्य तां वेदिं निर्मथ्य वरुणं प्रभुम् ।\nतथा पुष्करिणीं चैव वर्धनीं कलशोदरैः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002595112, "chapter_id": 22595, "verse_number": "३-२०-११३", "content_sanskrit": "अनिष्टं मार्जयेन्नागानुद्धृत्य कलशं तथा ।\nपाषाणाभ्यंतरं कृत्वा गोमयैः परिलिप्य च ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002595113, "chapter_id": 22595, "verse_number": "३-२०-११४", "content_sanskrit": "वरुणं पुष्करिण्यां च जलमध्ये विनिक्षिपेत् ।\nनमोस्त्विति च मन्त्रेण बलिं दद्याच्च पायसम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002595114, "chapter_id": 22595, "verse_number": "३-२०-११५", "content_sanskrit": "निर्मन्थेत्तत्र यो नागः स्थापयेत्तु यथाविधि ।\nश्रावयेत्तमिमं मंत्रमत्र संनिहितो भव ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002595115, "chapter_id": 22595, "verse_number": "३-२०-११६", "content_sanskrit": "अत्र स्वामी भवान्नाग रक्षणीयस्त्वया जनः ।\nगायत्रेण त्वा छंदसामीमन्त्रं संश्रावयेत्पुनः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002595116, "chapter_id": 22595, "verse_number": "३-२०-११७", "content_sanskrit": "संपूज्य गंधपुष्पाद्यैः पुरतो निक्षिपेद्दिशि ।\nपिधाय नागराजानमृचाभ्यां परिसूत्रकैः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002595117, "chapter_id": 22595, "verse_number": "३-२०-११८", "content_sanskrit": "सन्निरुद्ध्याशु संस्थाप्य बलिं दद्या द्विधानतः ।\nलाजौदनं मनस्तस्य यज्जाग्रत ऋचा जपेत् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002595118, "chapter_id": 22595, "verse_number": "३-२०-११९", "content_sanskrit": "एवं भूरिति मंत्रै स्वैः स्वैरेव तु पृथग्विधैः ।\nस्वासु दिक्षु च संस्थाप्य पूज येच्च प्रयत्नतः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002595119, "chapter_id": 22595, "verse_number": "३-२०-१२०", "content_sanskrit": "पूर्वभागे पुष्करिण्यां हरिताभं सवज्रकम् ।\nहलग्रहीत मंत्रेण न्यस्य लाजाहुतिं कुले ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002595120, "chapter_id": 22595, "verse_number": "३-२०-१२१", "content_sanskrit": "त्रातारमिति मंत्रेण अग्नौ विन्यस्य मौक्तिकम् ।\nमनःशिलां प्रवालं च अग्निमीडेति संपठेत् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7002595121, "chapter_id": 22595, "verse_number": "३-२०-१२२", "content_sanskrit": "वैश्वानरेण मन्त्रेण पठल्लांजाहुतिं पुनः ।\nदद्याद्ये ते शतमन्त्रेण पश्चिमे काटिकं न्यसेत् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7002595122, "chapter_id": 22595, "verse_number": "३-२०-१२३", "content_sanskrit": "शालिबीजेन सहितं कया न इति मंत्रकम् ।\nवरुणस्यो इति मंत्रेण दद्यादष्टादशाहुतीः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7002595123, "chapter_id": 22595, "verse_number": "३-२०-१२४", "content_sanskrit": "उत्तरे रोचनां कन्यां तथैव गौरसर्षपम् ।\nकुंकुमेन समायुक्तं कुविदंडमृचा पठन् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7002595124, "chapter_id": 22595, "verse_number": "३-२०-१२५", "content_sanskrit": "विन्यस्य तेन मंत्रेण प्रदद्यादाहुतिं पुनः ।\nऐशान्यां मंद्रकं रंगमी शावा इति संपठन् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7002595125, "chapter_id": 22595, "verse_number": "३-२०-१२६", "content_sanskrit": "संस्थाप्याज्याहुतिं दद्यात्तमीशान ऋचा पुनः ।\nआसद्यैर्मंत्रसंयुक्तैर्देवं नारायणं यजेत् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7002595126, "chapter_id": 22595, "verse_number": "३-२०-१२७", "content_sanskrit": "वरुणात्मकं ततो ध्यात्वा ततो नीराजनं पठेत् ।\nजानुभ्यामवनिं गत्वा पठेज्ज्ञानामृतं स्तवम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7002595127, "chapter_id": 22595, "verse_number": "३-२०-१२८", "content_sanskrit": "धर्मो वंशं ततः कुर्यादुत्सर्गांते विधीयते ।\nततो देवीं पुनः कृत्वा दत्त्वा पुष्पाञ्जलित्रयम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7002595128, "chapter_id": 22595, "verse_number": "३-२०-१२९", "content_sanskrit": "सर्वसत्त्वोपकाराय समुत्सृजेत्तु वै जनम् ।\nउत्सृष्टं सर्वसत्त्वेभ्यो दृश्यते जलमूर्जितम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7002595129, "chapter_id": 22595, "verse_number": "३-२०-१३०", "content_sanskrit": "रमंतीं सर्वभूतानि स्नानपानावगाहनैः ।\nवरुणं च ततो देवं पुष्करिण्यां च निक्षिपेत् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7002595130, "chapter_id": 22595, "verse_number": "३-२०-१३१", "content_sanskrit": "जले वरुणमन्त्रेण मत्स्यादीन्प्रक्षिपेत्ततः ।\nपक्षिणश्च शुभांस्तत्र भेकं कूर्मं च कर्दमम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7002595131, "chapter_id": 22595, "verse_number": "३-२०-१३२", "content_sanskrit": "शैवालं प्रक्षिपेच्चैव दक्षिणां तदनंतरम् ।\nसुवर्णं धान्यरत्नं च आचार्याय पृथग्ददेत् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7002595132, "chapter_id": 22595, "verse_number": "३-२०-१३३", "content_sanskrit": "ऋत्विग्भ्यश्च पृथग्दद्याद्यथावित्तानुसारतः ।\nब्राह्मणेभ्यो गायनेभ्यो वसुभ्यश्च पृथक्पृथक् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7002595133, "chapter_id": 22595, "verse_number": "३-२०-१३४", "content_sanskrit": "नित्यं समाप्य विधिवद्दद्यात्पूर्णाहुतिं पुनः ।\nदद्यादर्घ्यं च सूर्याय हस्तास इति संजपन् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7002595134, "chapter_id": 22595, "verse_number": "३-२०-१३५", "content_sanskrit": "ततः प्रदक्षिणावर्तं संवेष्ट्य क्षीरधारया ।\nप्रासादपक्षे प्रासादमारामे अथ मंडपम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7002595135, "chapter_id": 22595, "verse_number": "३-२०-१३६", "content_sanskrit": "शताधिधारया शक्त्या त्रिवारं ब्राह्मणैः सह ।\nविकीर्य लाजकुसुमं व्रीहीश्चैव कपर्दकान् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7002595136, "chapter_id": 22595, "verse_number": "३-२०-१३७", "content_sanskrit": "तूर्यघोषेण महता ततो विप्रपुरःसरम् ।\nयजमानः सपत्नीकः प्रविशेत्स्वगृहं पुनः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7002595137, "chapter_id": 22595, "verse_number": "३-२०-१३८", "content_sanskrit": "ततो गृहार्चनं कृत्वा ब्राह्मणानथ भोजयेत् ।\nकुमारीश्च कुमारांश्च दीनान्धकृपणानपि ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7002595138, "chapter_id": 22595, "verse_number": "३-२०-१३९", "content_sanskrit": "नारायणं ततो दद्याद्विप्रमुद्दिश्य भक्तितः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}]