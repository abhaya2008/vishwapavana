[{"id": 2197472, "chapter_id": 5198, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197473, "chapter_id": 5198, "verse_number": "१", "content_sanskrit": "श्रुतं बहुविधं वृत्तं कन्यकानां महामते ।\nइच्छामि योषितां श्रोतुं धर्माधर्मौ परिग्रहे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197474, "chapter_id": 5198, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197475, "chapter_id": 5198, "verse_number": "२", "content_sanskrit": "अष्टौ भार्यागमा धर्म्या नराणां दारकर्मणि ।\nप्रेत्येह च हिता यास्तु स्वपुत्रा हव्यकव्यदाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197476, "chapter_id": 5198, "verse_number": "३", "content_sanskrit": "साध्वी पाणिगृहीता या कौमारी पाणिवर्जिता ।\nभ्रातृभार्या स्वभार्येति प्रसूयेत् पुत्रमौरसम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197477, "chapter_id": 5198, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197478, "chapter_id": 5198, "verse_number": "४", "content_sanskrit": "त्रयो भार्यागमा ज्ञेया यत्र धर्मो न नश्यति ।\nपञ्चान्याः पश्चिमा ब्रूहि भार्यास्तासां च ये सुताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197479, "chapter_id": 5198, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197480, "chapter_id": 5198, "verse_number": "५", "content_sanskrit": "सगोत्रभार्या क्रीता च परभार्या च कारिता ।\nगतागता च या भार्या आश्रमादाहृता च या\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197481, "chapter_id": 5198, "verse_number": "६", "content_sanskrit": "एता भार्यागमाः पञ्च पुनर्भार्या भवन्ति याः ।\nएता भार्या नृणां गम्यास्तत्पुत्रा हव्यकव्यदाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197482, "chapter_id": 5198, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे भार्यागमनिर्णयो नाम एकोनपञ्चाशोऽध्यायः ॥४९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]