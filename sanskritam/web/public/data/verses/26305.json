[{"id": 7006305000, "chapter_id": 26305, "verse_number": "१-१५-१", "content_sanskrit": "जनमेजय उवाच सगरस्यात्मजा वीराः कथं जाता महात्मनः ।\nविक्रान्ताः षष्टिसाहस्रा विधिना केन वा द्विज ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006305001, "chapter_id": 26305, "verse_number": "१-१५-२", "content_sanskrit": "वैशम्पायायन उवाच द्वे भार्ये सगरस्यास्तां तपसा दग्धकिल्बिषे ।\nज्येष्ठा विदर्भदुहिता केशिनी नाम विश्रुता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006305002, "chapter_id": 26305, "verse_number": "१-१५-३", "content_sanskrit": "कनीयसी तु या तस्य पत्नी परमधर्मिणी ।\nअरिष्टनेमिदुहिता रूपेणाप्रतिमा भुवि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006305003, "chapter_id": 26305, "verse_number": "१-१५-४", "content_sanskrit": "और्वस्ताभ्यां वरं प्रादात् तं निबोध जनाधिप ।\nषष्टिं पुत्रसहस्राणि गृह्णात्वेका तपस्विनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006305004, "chapter_id": 26305, "verse_number": "१-१५-५", "content_sanskrit": "एकं वंशधरं त्वेका यथेष्ठं वरयत्विति ।\nतत्रैका जगृहे पुत्राँल्लुब्धा शूरान् बहूंस्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006305005, "chapter_id": 26305, "verse_number": "१-१५-६", "content_sanskrit": "एकं वंशधरं त्वेका तथेत्याह च तां मुनिः ।\nकेशिन्यसूत सगरादसमञ्जसमात्मजम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006305006, "chapter_id": 26305, "verse_number": "१-१५-७", "content_sanskrit": "राजा पञ्चजनो नाम बभूव सुमहाबलः ।\nइतरा सुषुवे तुम्बीं बीजपूर्णामिति श्रुतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006305007, "chapter_id": 26305, "verse_number": "१-१५-८", "content_sanskrit": "तत्र षष्टिसहस्राणि गर्भास्ते तिलसम्मिताः ।\nसम्बभूवुर्यथाकालं ववृधुश्च यथाक्रमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006305008, "chapter_id": 26305, "verse_number": "१-१५-९", "content_sanskrit": "घृतपूर्णेषु कुम्भेषु तान्गर्भान् निदधे पिता ।\nधात्रीश्चैकैकशः प्रादात् तावतीरेव पोषणे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006305009, "chapter_id": 26305, "verse_number": "१-१५-१०", "content_sanskrit": "ततो  दशसु मासेषु समुत्तस्थुर्यथासुखम् ।\nकुमारास्ते यथाकालं सगरप्रीतिवर्धनाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006305010, "chapter_id": 26305, "verse_number": "१-१५-११", "content_sanskrit": "षष्टिः पुत्रसहस्राणि तस्यैवमभवन् नृप ।\nगर्भादलाबुमध्याद् वै जातानि पृथिवीपते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006305011, "chapter_id": 26305, "verse_number": "१-१५-१२", "content_sanskrit": "तेषां नारायणं तेजः प्रविष्टानां महात्मनाम् ।\nएकः पञ्चजनो नाम पुत्रो राजा बभूव ह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006305012, "chapter_id": 26305, "verse_number": "१-१५-१३", "content_sanskrit": "सुतः पञ्चजनस्यासीदंशुमान्नाम वीर्यवान् ।\nदिलीपस्तनयस्त्वस्य खट्वाङ्ग इति विश्रुतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006305013, "chapter_id": 26305, "verse_number": "१-१५-१४", "content_sanskrit": "येन स्वर्गादिहागत्य मुहूर्तं प्राप्य जीवितम् ।\nत्रयोऽनुसंधिता लोका बुद्ध्या सत्येन चानघ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006305014, "chapter_id": 26305, "verse_number": "१-१५-१५", "content_sanskrit": "दिलीपस्य तु दायादो महाराजो भगीरथः ।\nयः स गङ्गां सरिच्छ्रेष्ठामवातारयत प्रभुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006305015, "chapter_id": 26305, "verse_number": "१-१५-१६", "content_sanskrit": "कीर्तिमान् स महाभागः शक्रतुल्यपराक्रमः ।\nसमुद्रमानयच्चैनां दुहितृत्वेन कल्पयत् ।\nतस्माद् भागीरथी गङ्गा कथ्यते वंशचिन्तकैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006305016, "chapter_id": 26305, "verse_number": "१-१५-१७", "content_sanskrit": "भगीरथसुतो राजा श्रुत इत्यभिविश्रुतः ।\nनाभागस्तु श्रुतस्यासीत्पुत्रः परमधार्मिकः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006305017, "chapter_id": 26305, "verse_number": "१-१५-१८", "content_sanskrit": "अम्बरीषस्तु नाभागिः सिन्धुद्वीपपिताभवत ।\nअयुताजित्तु दायादःसिन्धुद्वीपस्य वीर्यवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006305018, "chapter_id": 26305, "verse_number": "१-१५-१९", "content_sanskrit": "अयुताजित्सुतस्त्वासीदृतुपर्णो महायशाः ।\nदिव्याक्षहृदयज्ञो वै राजा नलसखो बली ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006305019, "chapter_id": 26305, "verse_number": "१-१५-२०", "content_sanskrit": "ऋतुपर्णसुतस्त्वासीदार्तुपर्णिर्महीपतिः ।\nसुदासस्तस्य तनयो राजात्विन्द्रसखोऽभवत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006305020, "chapter_id": 26305, "verse_number": "१-१५-२१", "content_sanskrit": "सुदासस्य सुतस्त्वासीत्सौदासो नाम पार्थिवः ।\nख्यातः कल्माषपादो वै नाम्ना मित्रसहस्तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006305021, "chapter_id": 26305, "verse_number": "१-१५-२२", "content_sanskrit": "कल्माषपादस्य सुतः सर्वकर्मेति विश्रुतः ।\nअनरण्यस्तु पुत्रोऽभूद् विश्रुतः सर्वकर्मणः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006305022, "chapter_id": 26305, "verse_number": "१-१५-२३", "content_sanskrit": "अनरण्यसुतो निघ्नो निघ्नपुत्रौ बभूवतुः ।\nअनमित्रो रघुश्चैव पार्थिवर्षभ सत्तमौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006305023, "chapter_id": 26305, "verse_number": "१-१५-२४", "content_sanskrit": "अनमित्रस्य धर्मात्मा विद्वान् दुलिदुहोऽभवत् ।\nदिलीपस्तनयस्तस्य रामप्रप्रपितामहः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006305024, "chapter_id": 26305, "verse_number": "१-१५-२५", "content_sanskrit": "दीर्घबाहुर्दिलीपस्य रघुर्नाम्नाभवत् सुतः ।\nअयोध्यायां महाराजो रघुश्चासीन्महाबलः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006305025, "chapter_id": 26305, "verse_number": "१-१५-२६", "content_sanskrit": "अजस्तु रघुतो जज्ञे अजाद् दशरथोऽभवत् ।\nरामो दशरथाज्जज्ञे धर्मात्मा सुमहायशाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006305026, "chapter_id": 26305, "verse_number": "१-१५-२७", "content_sanskrit": "रामस्य तनयो जज्ञे कुश इत्यभिविश्रुतः ।\nअतिथिस्तु कुशाज्जज्ञे निषधस्तस्य चात्मजः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006305027, "chapter_id": 26305, "verse_number": "१-१५-२८", "content_sanskrit": "निषधस्य नलः पुत्रो नभः पुत्रो नलस्य तु ।\nनभस्य पुण्डरीकस्तु क्षेमधन्वा ततः स्मृतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006305028, "chapter_id": 26305, "verse_number": "१-१५-२९", "content_sanskrit": "क्षेमधन्वसुतस्त्वासीद् देवानीकः प्रतापवान् ।\nआसीदहीनगुर्नाम देवानीकसुतः प्रभुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006305029, "chapter_id": 26305, "verse_number": "१-१५-३०", "content_sanskrit": "अहीनगोस्तु दायादः सुधन्वा नाम पार्थिवः ।\nसुधन्वनः सुतश्चैव ततो जज्ञेऽनलो नृपः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006305030, "chapter_id": 26305, "verse_number": "१-१५-३१", "content_sanskrit": "उक्थो नाम स धर्मात्मानलपुत्रो बभूव ह ।\nवज्रनाभः सुतस्तस्य उक्थस्य च महात्मनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006305031, "chapter_id": 26305, "verse_number": "१-१५-३२", "content_sanskrit": "शङ्खस्तस्य सुतो विद्वान् व्युषिताश्व इति श्रुतः ।\nपुष्पस्तस्य सुतो विद्वानर्थसिद्धिस्तु तत्सुतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006305032, "chapter_id": 26305, "verse_number": "१-१५-३३", "content_sanskrit": "सुदर्शनः सुतस्तस्य अग्निवर्णः सुदर्शनात् ।\nअग्निवर्णस्य शीघ्रस्तु शीघ्रस्य तु मरुः सुतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006305033, "chapter_id": 26305, "verse_number": "१-१५-३४", "content_sanskrit": "मरुस्तु योगमास्थाय कलापद्वीपमास्थितः ।\nतस्यासीद् विश्रुतवतः पुत्रो राजा बृहद्बलः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006305034, "chapter_id": 26305, "verse_number": "१-१५-३५", "content_sanskrit": "नलौ द्वावेव विख्यातौ पुराणे भरतर्षभ ।\nवीरसेनात्मजश्चैव यश्चेक्ष्वाकुकुलोद्वहः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006305035, "chapter_id": 26305, "verse_number": "१-१५-३६", "content_sanskrit": "इक्ष्वाकुवंशप्रभवाः प्राधान्येनेह कीर्तिताः ।\nएते विवस्वतो वंशे राजानो भूरितेजसः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006305036, "chapter_id": 26305, "verse_number": "१-१५-३७", "content_sanskrit": "पठन् सम्यगिमां सृष्टिमादित्यस्य विवस्वतः ।\nश्राद्धदेवस्य देवस्य प्रजानां पुष्टिदस्य च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006305037, "chapter_id": 26305, "verse_number": "१-१५-३८", "content_sanskrit": "प्रजावानेति सायुज्यमादित्यस्य विवस्वतः ।\nविपाप्मा विरजाश्चैव आयुष्मांश्च भवत्युत ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]