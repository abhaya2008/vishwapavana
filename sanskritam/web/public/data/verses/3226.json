[{"id": 2102758, "chapter_id": 3226, "verse_number": "१४-८२-१", "content_sanskrit": "अर्जुन उवाच।\nकिमागमनकृत्यं ते कौरव्यकुलनन्दिनि।\nमणलूरपतेर्मातुस्तथैव च रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102759, "chapter_id": 3226, "verse_number": "१४-८२-२", "content_sanskrit": "कच्चित्कुशलकामासि राज्ञोऽस्य भुजगात्मजे।\nमम वा चपलापाङ्गि कच्चित्वं शुभमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102760, "chapter_id": 3226, "verse_number": "१४-८२-३", "content_sanskrit": "कच्चित्ते पृथुलश्रोणि नाप्रियं प्रियदर्शने।\nअकार्षमहमज्ञानादयं वा बभ्रुवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102761, "chapter_id": 3226, "verse_number": "१४-८२-४", "content_sanskrit": "कच्चिन्नु राजपूत्री ते सपत्नी चैत्रवाहनी।\nचित्राङ्गदा वरारोहा नापराध्यति किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102762, "chapter_id": 3226, "verse_number": "१४-८२-५", "content_sanskrit": "तमुवाचोरगपतेर्दुहिता प्रहसन्त्यथ।\nन मे त्वमपराद्धोसि न हि मे बभ्रुवाहनः।\nन जनित्री तथाऽस्येयं मम यो प्रेष्यवत्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102763, "chapter_id": 3226, "verse_number": "१४-८२-६", "content_sanskrit": "श्रूयतां यद्यथा चेदं मया सर्वं विचेष्टितम्।\nन मे कोपस्त्वया कार्यः शिरसा त्वां प्रसादये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102764, "chapter_id": 3226, "verse_number": "१४-८२-७", "content_sanskrit": "त्वत्प्रियार्थं हि कौरव्य कृतमेतन्मया विभो।\nयत्तच्छृणु महाबाहो निखिलेन धनंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102765, "chapter_id": 3226, "verse_number": "१४-८२-८", "content_sanskrit": "महाभारतयुद्धे यत्त्वया शान्तनवो नृपः।\nअधर्मेण हतः पार्थ तस्यैषा निष्कृतिः कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102766, "chapter_id": 3226, "verse_number": "१४-८२-९", "content_sanskrit": "न हि भीष्मस्त्वया वीर युद्ध्यमानो हि पातितः।\nशिखण्डिना तु संयुक्तस्तमाश्रित्य हतस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102767, "chapter_id": 3226, "verse_number": "१४-८२-१०", "content_sanskrit": "तस्य शान्तिमकृत्वा त्वं त्यजेथा यदि जीवितम्।\nकर्मणा तेन पापेन पतेथा निरये ध्रुवम्।\nएषा तु विहिता शान्तिः पुत्राद्यां प्राप्तवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102768, "chapter_id": 3226, "verse_number": "१४-८२-११", "content_sanskrit": "वसुभिर्वसुधापाल गङ्गया च महामते।\nपुरा हि श्रुतमेतत्ते वसुभिः कथितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102769, "chapter_id": 3226, "verse_number": "१४-८२-१२", "content_sanskrit": "गङ्गायास्तीरमाश्रित्य हते शान्तनवे नृप।\nआप्लुत्य देवा वसवः समेत्य च महानदीम्।\nइदमूचुर्वचो घोरं भागीरथ्या मते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102770, "chapter_id": 3226, "verse_number": "१४-८२-१३", "content_sanskrit": "एष शान्तनवो भीष्मो निहतः सव्यसाचिना।\nअयुद्ध्यमानः सङ्ग्रामे संसक्तोऽन्येन भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102771, "chapter_id": 3226, "verse_number": "१४-८२-१४", "content_sanskrit": "तदनेनानुषङ्गेण वयमद्य धनञ्जयम्।\nशापेन योजयामेति तथाऽस्त्विति च साऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102772, "chapter_id": 3226, "verse_number": "१४-८२-१५", "content_sanskrit": "तदहं पितुरावेद्य प्रविश्य व्यथितेन्द्रिया।\nअभवं स च तच्छ्रुत्वा विषादमगमत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102773, "chapter_id": 3226, "verse_number": "१४-८२-१६", "content_sanskrit": "पिता तु मे वसून्गत्वा त्वदर्थे समयाचत।\nपुनः पुनः प्रसाद्यैतांस्त एनमिदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102774, "chapter_id": 3226, "verse_number": "१४-८२-१७", "content_sanskrit": "पुत्रस्तस्य महाभाग मणलूरेश्वरो युवा।\nस एनं रणमध्यस्थः शरैः पातयिता भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102775, "chapter_id": 3226, "verse_number": "१४-८२-१८", "content_sanskrit": "एवं कृते स नागेन्द्र मुक्तशापो भविष्यति।\nगच्छेति वसुभिश्चोक्तो मम चेदं शशंस सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102776, "chapter_id": 3226, "verse_number": "१४-८२-१९", "content_sanskrit": "तच्छ्रुत्वा त्वं मया तस्माच्छापादसि विमोक्षितः।\nन हि त्वां देवराजोऽपि समरेषु पराजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102777, "chapter_id": 3226, "verse_number": "१४-८२-२०", "content_sanskrit": "आत्मा पुत्रः स्मृतस्तस्मात्तेनेहासि पराजितः।\nन हि दोषो मम मतः कथं वा मन्यसे विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102778, "chapter_id": 3226, "verse_number": "१४-८२-२१", "content_sanskrit": "इत्येवमुक्तो विजयः प्रसन्नात्माऽब्रवीदिदम्।\nसर्वं मे सुप्रियं देवि यदेतत्कृतवत्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102779, "chapter_id": 3226, "verse_number": "१४-८२-२२", "content_sanskrit": "इत्युक्त्वा सोऽब्रवीत्पुत्रं मणलूरपतिं जयः।\nचित्राङ्गदायाः शृण्वन्त्याः कौरव्यदुहितुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102780, "chapter_id": 3226, "verse_number": "१४-८२-२३", "content_sanskrit": "युधिष्ठिरस्याश्वमेधः परिचैत्रीं भविष्यति।\nतत्रागच्छेः सहामात्यो मातृभ्यां सहितो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102781, "chapter_id": 3226, "verse_number": "१४-८२-२४", "content_sanskrit": "इत्येवमुक्तः पार्थेन स राजा बभ्रुवाहनः।\nउवाच पितरं धीमानिदमस्राविलेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102782, "chapter_id": 3226, "verse_number": "१४-८२-२५", "content_sanskrit": "उपयास्यामि धर्मज्ञ भवतः सासनादहम्।\nअश्वमेधे महायज्ञे द्विजातिपरिवेषकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102783, "chapter_id": 3226, "verse_number": "१४-८२-२६", "content_sanskrit": "मम त्वनुग्रहार्थाय प्रविशस्व पुरं स्वकम्।\nभार्याभ्यां सह धर्मज्ञ माभूत्तेऽत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102784, "chapter_id": 3226, "verse_number": "१४-८२-२७", "content_sanskrit": "उषित्वेह निशामेकां सुखं स्वभवने प्रभो।\nपुनरश्वानुगमनं कर्तासि जयतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102785, "chapter_id": 3226, "verse_number": "१४-८२-२८", "content_sanskrit": "इत्युक्ताः स तु प्रत्रेण तदा वानरकेतनः।\nस्मयन्प्रोवाच कौन्तेयस्तदा चित्राङ्गदासुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102786, "chapter_id": 3226, "verse_number": "१४-८२-२९", "content_sanskrit": "विदितं ते महाबाहो यथा दीक्षां चराम्यहम्।\nन स तावत्प्रवेक्ष्यामि पुरं ते पृथुलोचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102787, "chapter_id": 3226, "verse_number": "१४-८२-३०", "content_sanskrit": "यथाकामं व्रजत्येष यज्ञियाश्वो नरर्षभ।\nस्वस्ति तेऽस्तु गमिष्यामि न स्थानं विद्यते मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102788, "chapter_id": 3226, "verse_number": "१४-८२-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102789, "chapter_id": 3226, "verse_number": "१४-८२-३१", "content_sanskrit": "स तत्र विधिवत्तेन पूजितः पाकशासनिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102790, "chapter_id": 3226, "verse_number": "१४-८२-३२", "content_sanskrit": "भार्याभ्यामभ्यनुज्ञातः प्रायाद्भरतसत्तमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102791, "chapter_id": 3226, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्व्यशीतितमोऽध्यायः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]