[{"id": 2006252, "chapter_id": 1124, "verse_number": "१-१२५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006253, "chapter_id": 1124, "verse_number": "१-१२५-१", "content_sanskrit": "तत्रापि तपसि श्रेष्ठे वर्तमानः स वीर्यवान्।\nसिद्धचारणसङ्घानां बभूव प्रियदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006254, "chapter_id": 1124, "verse_number": "१-१२५-२", "content_sanskrit": "सुश्रूषुरनहंवादी संयतात्मा जितेन्द्रियः।\nस्वर्गं गन्तुं पराक्रान्तः स्वेन वीर्येण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006255, "chapter_id": 1124, "verse_number": "१-१२५-३", "content_sanskrit": "केषांचिदभवद्भ्राता केषांचिदभवत्सखा।\nऋषयस्त्वपरे चैनं पुत्रवत्पर्यपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006256, "chapter_id": 1124, "verse_number": "१-१२५-४", "content_sanskrit": "स तु कालेन महता प्राप्य निष्कल्मषं तपः।\nब्रह्मर्षिसदृशः पाण्डुर्बभूव भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006257, "chapter_id": 1124, "verse_number": "१-१२५-५", "content_sanskrit": "अमावास्यां तु सहिता ऋषयः संशितव्रताः।\nब्रह्माणं द्रष्टुकामास्ते संप्रतस्थुर्महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006258, "chapter_id": 1124, "verse_number": "१-१२५-६", "content_sanskrit": "संप्रयातानृषीन्दृष्ट्वा पाण्डुर्वचनमब्रवीत्।\nभवन्तः क्व गमिष्यन्ति ब्रूत मे वदतां वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006259, "chapter_id": 1124, "verse_number": "१-१२५-७x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006260, "chapter_id": 1124, "verse_number": "१-१२५-७", "content_sanskrit": "समावायो महानद्य ब्रह्मलोके महात्मनाम्।\nदेवानां च ऋषीणां च पितॄणां च महात्मनाम्।\nवयं तत्र गमिष्यामो द्रष्टुकामाः स्वयंभुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006261, "chapter_id": 1124, "verse_number": "१-१२५-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006262, "chapter_id": 1124, "verse_number": "१-१२५-८", "content_sanskrit": "पाण्डुरुत्थाय सहसा गन्तुकामो महर्षिभिः।\nस्वर्गपारं तितीर्षुः स शतशृङ्गादुदङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006263, "chapter_id": 1124, "verse_number": "१-१२५-९", "content_sanskrit": "प्रतस्थे सह पत्नीभ्यामब्रुवंस्तं च तापसाः।\nउपर्युपरि गच्छन्तः शैलराजमुदङ्मुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006264, "chapter_id": 1124, "verse_number": "१-१२५-१०", "content_sanskrit": "दृष्टवन्तो गिरौ रम्ये दुर्गान्देशान्बहून्वयम्।\nविमानशतसंबाधां गीतस्वरनिनादिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006265, "chapter_id": 1124, "verse_number": "१-१२५-११", "content_sanskrit": "आक्रीडभूमिं देवानां गन्धर्वाप्सरसां तथा।\nउद्यानानि कुबेरस्य समानि विषमाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006266, "chapter_id": 1124, "verse_number": "१-१२५-१२", "content_sanskrit": "महानदीनितम्बांश्च गहनान्गिरिगह्वरान्।\nसन्ति नित्यहिमा देशा निर्वृक्षमृगपक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006267, "chapter_id": 1124, "verse_number": "१-१२५-१३", "content_sanskrit": "सन्ति क्वचिन्महादर्यो दुर्गाः काश्चिद्दुरासदाः।\nनातिक्रामेत पक्षी यान्कुत एवेतरे मृगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006268, "chapter_id": 1124, "verse_number": "१-१२५-१४", "content_sanskrit": "वायुरेको हि यात्यत्र सिद्धाश्च परमर्षयः।\nगच्छन्त्यौ शैलराजेऽस्मिन्राजपुत्र्यौ कथं न्विमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006269, "chapter_id": 1124, "verse_number": "१-१२५-१५", "content_sanskrit": "न सीदेतामदुःखार्हे मा गमो भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006270, "chapter_id": 1124, "verse_number": "१-१२५-१५x", "content_sanskrit": "पाण्डुरुवाच।\nअप्रजस्य महाभागा न द्वारं परिचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006271, "chapter_id": 1124, "verse_number": "१-१२५-१६", "content_sanskrit": "स्वर्गे तेनाभितप्तोऽहमप्रजस्तु ब्रवीमि वः।\nसोऽहमुग्रेण तपसा सभार्यस्त्यक्तजीवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006272, "chapter_id": 1124, "verse_number": "१-१२५-१७", "content_sanskrit": "अनपत्योऽपि विन्देयं स्वर्गमुग्रेण कर्मणा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006273, "chapter_id": 1124, "verse_number": "१-१२५-१७x", "content_sanskrit": "ऋषय ऊचुः।\nअस्ति वै तव धर्मात्मन्विद्म देवोपम शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006274, "chapter_id": 1124, "verse_number": "१-१२५-१८", "content_sanskrit": "अपत्यमनघं राजन्वयं दिव्येन चक्षुषा।\nदैवोद्दिष्टं नरव्याघ्र कर्मणेहोपपादय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006275, "chapter_id": 1124, "verse_number": "१-१२५-१९", "content_sanskrit": "अक्लिष्टं फलमव्यग्रो विन्दते बुद्धिमान्नरः।\nतस्मिन्दृष्टे फले राजन्प्रयत्नं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006276, "chapter_id": 1124, "verse_number": "१-१२५-२०", "content_sanskrit": "अपत्यं गुणसंपन्नं लब्धा प्रीतिकरं ह्यसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006277, "chapter_id": 1124, "verse_number": "१-१२५-२०x", "content_sanskrit": "वैशम्पायन उवाच।\nतच्छ्रुत्वा तापसवचः पाण्डुस्चिन्तापरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006278, "chapter_id": 1124, "verse_number": "१-१२५-२१", "content_sanskrit": "आत्मनो मृगशापेन जानन्नुपहतां क्रियाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006279, "chapter_id": 1124, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि संभवपर्वणि पञ्चविंशत्यधिकशततमोऽध्यायः॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]