[{"id": 2073281, "chapter_id": 2548, "verse_number": "१२-५३-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073282, "chapter_id": 2548, "verse_number": "१२-५३-१", "content_sanskrit": "धर्मात्मनि महावीर्ये सत्यसन्धे जितात्मनि।\nदेवव्रते महाभागे शरतल्पगतेऽच्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073283, "chapter_id": 2548, "verse_number": "१२-५३-२", "content_sanskrit": "शयाने वीरशयने भीष्मे शन्तनुनन्दने।\nगाङ्गेये पुरुषव्याघ्रे पाण्डवैः पर्युपासिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073284, "chapter_id": 2548, "verse_number": "१२-५३-३", "content_sanskrit": "काः कथाः समवर्तन्त तस्मिन्वीरसमागमे।\nहतेषु सर्वसैन्येषु तन्मे शंस महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073285, "chapter_id": 2548, "verse_number": "१२-५३-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073286, "chapter_id": 2548, "verse_number": "१२-५३-४", "content_sanskrit": "शरतल्पगते भीष्मे कौरवाणां पितामहे।\nआजग्मुर्ऋषयः सिद्धा नारदप्रमुखा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073287, "chapter_id": 2548, "verse_number": "१२-५३-५", "content_sanskrit": "हतशिष्टाश्च राजानो युधिष्ठिरपुरोगमाः।\nधृतराष्ट्रश्च कृष्णश्च भीमार्जुनयमास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073288, "chapter_id": 2548, "verse_number": "१२-५३-६", "content_sanskrit": "तेऽभिगम्य महात्मानो भरतानां पितामहम्।\nअन्वशोचन्त गाङ्गेयमादित्यं पतितं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073289, "chapter_id": 2548, "verse_number": "१२-५३-७", "content_sanskrit": "मुहूर्तमिव च ध्यात्वा नारदो देवदर्शनः।\nउवाच पाण्डवान्सर्वान्हतशिष्टांश्च पार्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073290, "chapter_id": 2548, "verse_number": "१२-५३-८", "content_sanskrit": "प्राप्तकालं समाचक्षे भीष्मोऽयमनुयुज्यताम्।\nअस्तमेति हि गाङ्गेयो भानुमानिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073291, "chapter_id": 2548, "verse_number": "१२-५३-९", "content_sanskrit": "अयं प्राणानुत्सिसृक्षुस्तं सर्वेऽभ्यनुपृच्छत।\nकृत्स्नान्हि विविधान्धर्मांश्चातुर्वर्ण्यस्य वेत्त्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073292, "chapter_id": 2548, "verse_number": "१२-५३-१०", "content_sanskrit": "एष वृद्धः पराँल्लोकान्संप्राप्नोति तनुं त्यजन्।\nतं शीघ्रमनुयुञ्जीध्वं संशयान्मनसि स्थितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073293, "chapter_id": 2548, "verse_number": "१२-५३-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073294, "chapter_id": 2548, "verse_number": "१२-५३-११", "content_sanskrit": "एवमुक्ते नारदेन भीष्ममीयुर्नराधिपाः।\nप्रष्टुं चाशक्रुवन्तस्ते वीक्षांचक्रुः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073295, "chapter_id": 2548, "verse_number": "१२-५३-१२", "content_sanskrit": "अथोवाच हृषीकेशं पाण्डुपुत्रो युधिष्ठिरः।\nनान्यस्त्वद्देवकीपुत्र शक्तः प्रष्टुं पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073296, "chapter_id": 2548, "verse_number": "१२-५३-१३", "content_sanskrit": "प्रव्याहर यदुश्रेष्ठ त्वमग्रे मधुसूदन।\nत्वं हि नस्तात सर्वेषां सर्वधर्मविदुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073297, "chapter_id": 2548, "verse_number": "१२-५३-१४", "content_sanskrit": "एवमुक्तः पाण्डवेन भगवान्केशवस्तदा।\nअभिगम्य दुराधर्षं प्रव्याहारयदच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073298, "chapter_id": 2548, "verse_number": "१२-५३-१५", "content_sanskrit": "कच्चित्सुखेन रजनी व्युष्टा ते राजसत्तम।\nविस्पष्टलक्षणा बुद्धिः कच्चिच्चोपस्थिता तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073299, "chapter_id": 2548, "verse_number": "१२-५३-१६", "content_sanskrit": "कच्चिज्ज्ञानानि सर्वाणि प्रतिभान्ति च तेऽनघ।\nन ग्लायते च हृदयं न च ते व्याकुलं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073300, "chapter_id": 2548, "verse_number": "१२-५३-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073301, "chapter_id": 2548, "verse_number": "१२-५३-१७", "content_sanskrit": "दाहो मोहः श्रमश्चैव क्लमो ग्लानिस्तथा रुजा।\nतव प्रसादाद्वार्ष्णेय सद्यो व्यपगतानि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073302, "chapter_id": 2548, "verse_number": "१२-५३-१८", "content_sanskrit": "यच्च भूतं भविष्यच्च भवच्च परमद्युते।\nतत्सर्वमनुपश्यामि पाणौ फलमिवाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073303, "chapter_id": 2548, "verse_number": "१२-५३-१९", "content_sanskrit": "वेदोक्ताश्चैव ये धर्मा वेदान्ताधिगताश्च ये।\nतान्सर्वान्संप्रपश्यामि वरदानात्तवाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073304, "chapter_id": 2548, "verse_number": "१२-५३-२०", "content_sanskrit": "शिष्टैश्च धर्मो यः प्रोक्तः स च मे हृदि वर्तते।\nदेशजातिकुलानां च धर्मज्ञोऽस्मि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073305, "chapter_id": 2548, "verse_number": "१२-५३-२१", "content_sanskrit": "चतुर्ष्वाश्रमधर्मेषु योऽर्थः स च हृदि स्थितः।\nराजधर्मांश्च सकलानवगच्छामि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073306, "chapter_id": 2548, "verse_number": "१२-५३-२२", "content_sanskrit": "यच्च यत्र च वक्तव्यं तद्वक्ष्यामि जनार्दन।\nतव प्रसादाद्धि शुभा मनो मे बुद्धिराविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073307, "chapter_id": 2548, "verse_number": "१२-५३-२३", "content_sanskrit": "युवेवास्मि समावृत्तस्त्वदनुध्यानबृंहितः।\nवक्तुं श्रेयः समर्थोऽस्मि त्वत्प्रसादाज्जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073308, "chapter_id": 2548, "verse_number": "१२-५३-२४", "content_sanskrit": "स्वयं किमर्थं तु भवाञ्श्रेयो न प्राह पाण्डवम्।\nकिं ते विवक्षितं चात्र तदाशु वद माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073309, "chapter_id": 2548, "verse_number": "१२-५३-२५x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073310, "chapter_id": 2548, "verse_number": "१२-५३-२५", "content_sanskrit": "यशसः श्रेयसश्चैव मूल मां विद्धि कौरव।\nमत्तः सर्वेऽभिनिर्वृत्ता भावाः सदसदात्मकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073311, "chapter_id": 2548, "verse_number": "१२-५३-२६", "content_sanskrit": "शीतांशुश्चन्द्र इत्युक्ते लोके को विस्मयिष्यति।\nतथैव यशसा पूर्णे मयि को विस्मयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073312, "chapter_id": 2548, "verse_number": "१२-५३-२७", "content_sanskrit": "आधेयं तु मया भूयो यशस्तव महाद्युते।\nततो मे विपुला बुद्धिस्त्वयि भीष्म समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073313, "chapter_id": 2548, "verse_number": "१२-५३-२८", "content_sanskrit": "यावद्धि पृथिवीपाल पृथ्वीयं स्थास्यति ध्रुवा।\nतावत्तवाक्षया कीर्तिर्लोकाननुचरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073314, "chapter_id": 2548, "verse_number": "१२-५३-२९", "content_sanskrit": "यच्च त्वं वक्ष्यसे भीष्म पाण्डवायानुपृच्छते।\nवेदप्रवाद इव ते स्थास्यते वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073315, "chapter_id": 2548, "verse_number": "१२-५३-३०", "content_sanskrit": "यश्चैतेन प्रमाणेन योक्ष्यत्यात्मानमात्मना।\nस फलं सर्वपुण्यानां प्रेत्य चानुभविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073316, "chapter_id": 2548, "verse_number": "१२-५३-३१", "content_sanskrit": "एतस्मात्कारणाद्भीष्म मतिर्दिव्या मया हि ते।\nदत्ता यशो विप्रथयेत्कथं भूयस्तवेति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073317, "chapter_id": 2548, "verse_number": "१२-५३-३२", "content_sanskrit": "यावद्धि प्रथते लोके पुरुषस्य यशो भुवि।\nतावत्तस्याक्षया कीर्तिर्भवतीति विनिश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073318, "chapter_id": 2548, "verse_number": "१२-५३-३३", "content_sanskrit": "राजानो हतशिष्टास्त्वां राजन्नभित आसते।\nधर्माननुयुयुक्षन्तस्तेभ्यः प्रब्रूहि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073319, "chapter_id": 2548, "verse_number": "१२-५३-३४", "content_sanskrit": "भवान्हि वयसा वृद्धः श्रुताचारसमन्वितः।\nकुशलो राजधर्माणां सर्वेषामपराश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073320, "chapter_id": 2548, "verse_number": "१२-५३-३५", "content_sanskrit": "जन्मप्रभृति ते किंचिद्वॄजिनं न ददर्श ह।\nज्ञातारं सर्वधर्माणां त्वां विदुः सर्वपार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073321, "chapter_id": 2548, "verse_number": "१२-५३-३६", "content_sanskrit": "तेभ्यः पितेव पुत्रेभ्यो राजन्ब्रूहि परं नयम्।\nऋषयश्चैव देवाश्च त्वया नित्यमुपासिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073322, "chapter_id": 2548, "verse_number": "१२-५३-३७", "content_sanskrit": "तस्माद्वक्तव्यमेवेदं त्वयाऽवश्यमशेषतः।\nधर्मं शुश्रूषमाणेभ्यः पृष्टेन न सता पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073323, "chapter_id": 2548, "verse_number": "१२-५३-३८", "content_sanskrit": "वक्तव्यं विदुषा चेति धर्ममाहुर्मनीषिणः।\nअप्रतिब्रुवतः कष्टो दोषो हि भविता प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073324, "chapter_id": 2548, "verse_number": "१२-५३-३९", "content_sanskrit": "तस्मात्पुत्रैश्च पौत्रेश्च धर्मान्पृष्टान्सनातनान्।\nविद्वञ्जिज्ञासमानेभ्यः प्रब्रूहि भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073325, "chapter_id": 2548, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रिपञ्चाशोऽध्यायः॥ ५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]