[{"id": 2131159, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131160, "chapter_id": 3831, "verse_number": "१", "content_sanskrit": "यथागतं गते शक्रे भ्रातृभिः सह सङ्गतः ।\nकृष्णया चैव बीभत्सुर्धर्मपुत्रमपूजयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131161, "chapter_id": 3831, "verse_number": "२", "content_sanskrit": "अभिवादयमानं तं मूर्ध्न्युपाघ्राय पाण्डवम् ।\nहर्षगद्गदया वाचा प्रहृष्टोऽर्जुनमब्रवीत् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131162, "chapter_id": 3831, "verse_number": "३", "content_sanskrit": "कथमर्जुन कालोऽयं स्वर्गे व्यतिगतस्तव ।\nकथं चास्त्राण्यवाप्तानि देवराजश्च तोषितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131163, "chapter_id": 3831, "verse_number": "४", "content_sanskrit": "सम्यग्वा ते गृहीतानि कच्चिदस्त्राणि पाण्डव ।\nकच्चित् सुराधिपः प्रीतो रुद्रो वाऽस्त्राण्यदात् तव \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131164, "chapter_id": 3831, "verse_number": "५", "content_sanskrit": "यथा दृष्टश्च ते शक्रो भगवान् वा पिनाकधृक् ।\nयथैवास्त्राण्यवाप्तानि यथैवाराधितश्च ते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131165, "chapter_id": 3831, "verse_number": "६", "content_sanskrit": "यथोक्तवांस्त्वां भगवान् शतक्रतुररिन्दम ।\nकृतप्रियस्त्वयाऽस्मीति तस्य ते किं प्रियं कृतम् ।\nएतदिच्छाम्यहं श्रोतुं विस्तरेण महाद्युते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131166, "chapter_id": 3831, "verse_number": "७", "content_sanskrit": "यथा तुष्टो महादेवो देवराजस्तथाऽनघ \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131167, "chapter_id": 3831, "verse_number": "८", "content_sanskrit": "यच्चापि वज्रपाणेस्तु प्रियं कृतमरिन्दम ।\nएतदाख्याहि मे सर्वमखिलेन धनञ्जय\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131168, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131169, "chapter_id": 3831, "verse_number": "९", "content_sanskrit": "शृणु हन्त महाराज विधिना येन दृष्टवान् ।\nशतक्रतुमहं देवं भगवन्तं च शङ्करम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131170, "chapter_id": 3831, "verse_number": "१०", "content_sanskrit": "विद्यामधीत्य तां राजंस्त्वयोक्तामरिमर्दन ।\nभवता च समादिष्टस्तपसे प्रस्थितो वनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131171, "chapter_id": 3831, "verse_number": "११", "content_sanskrit": "भृगुतुङ्गमथो गत्वा काम्यकादास्थितस्तपः ।\nएकरात्रोषितः कञ्चिदपश्यं ब्राह्मणं पथि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131172, "chapter_id": 3831, "verse_number": "१२", "content_sanskrit": "स मामपृच्छत् कौन्तेय क्वासि गन्ता ब्रवीहि मे ।\nतस्मा अवितथं सर्वमब्रुवं कुरुनन्दन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131173, "chapter_id": 3831, "verse_number": "१३", "content_sanskrit": "स तथ्यं मम तच्छ्रुत्वा ब्राह्मणो राजसत्तम ।\nअपूजयत मां राजन् प्रीतिमांश्चाभवन्मयि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131174, "chapter_id": 3831, "verse_number": "१४", "content_sanskrit": "ततो मामब्रवीत् प्रीतस्तप आतिष्ठ भारत ।\nतपस्वी नचिरेण त्वं द्रक्ष्यसे विबुधाधिपम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131175, "chapter_id": 3831, "verse_number": "१५", "content_sanskrit": "ततोऽहं वचनात् तस्य गिरिमारुह्य शैशिरम् ।\nतपोऽतप्यं महाराज मासं मूलफलाशनः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131176, "chapter_id": 3831, "verse_number": "१६", "content_sanskrit": "द्वितीयश्चापि मे मासो जलं भक्षयतो गतः ।\nनिराहारस्तृतीयेऽथ मासे पाण्डवनन्दन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131177, "chapter_id": 3831, "verse_number": "१७", "content_sanskrit": "ऊर्ध्वबाहुश्चतुर्थं तु मासमस्मि स्थितस्तदा ।\nन च मे हीयते प्राणस्तदद्भुतमिवाभवत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131178, "chapter_id": 3831, "verse_number": "१८", "content_sanskrit": "पञ्चमे त्वथ सम्प्राप्ते प्रथमे दिवसे गते ।\nवराहसंस्थितं भूतं मत्समीपं समागमत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131179, "chapter_id": 3831, "verse_number": "१९", "content_sanskrit": "निघ्नन् प्रोथेन पृथिवीं विलिखंश्चरणैरपि ।\nसम्मार्जन् जठरेणोर्वीं विवर्तंश्च मुहुर्मुहुः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131180, "chapter_id": 3831, "verse_number": "२०", "content_sanskrit": "अनु तस्यापरं भूतं महत् कैरातसंस्थितम् ।\nधनुर्बाणासिमत्प्राप्तं स्त्रीगणानुगतं तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131181, "chapter_id": 3831, "verse_number": "२१", "content_sanskrit": "ततोऽहं धनुरादाय तथाऽक्षय्ये महेषुधी ।\nअताडयं शरेणाथ तद्भूतं लोमहर्षणम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131182, "chapter_id": 3831, "verse_number": "२२", "content_sanskrit": "युगपत् तं किरातस्तु विकृष्य बलवद्धनुः ।\nअभ्याजघ्ने दृढतरं कम्पयन्निव मे मनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131183, "chapter_id": 3831, "verse_number": "२३", "content_sanskrit": "स तु मामब्रवीद् राजन् मम पूर्वपरिग्रहः ।\nमृगयाधर्ममुत्सृज्य किमर्थं ताडितस्त्वया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131184, "chapter_id": 3831, "verse_number": "२४", "content_sanskrit": "एष ते निशितैर्बाणैर्दर्पं हन्मि स्थिरो भव ।\nस वर्षवान् महाकायस्ततो मामभ्यभावत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131185, "chapter_id": 3831, "verse_number": "२५", "content_sanskrit": "ततो गिरिमिवात्यर्थमावृणोन्मां महाशरैः ।\nतं चाहं शरवर्षेण महता समवाकिरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131186, "chapter_id": 3831, "verse_number": "२६", "content_sanskrit": "ततः शरैर्दीप्तमुखैर्यन्त्रितैरनुमन्त्रितैः ।\nप्रत्यविध्यमहं तं तु वज्रैरिव शिलोच्चयम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131187, "chapter_id": 3831, "verse_number": "२७", "content_sanskrit": "तस्य तच्छतधा रूपमभवच्च सहस्रधा ।\nतानि चास्य शरीराणि शरैरहमताडयम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131188, "chapter_id": 3831, "verse_number": "२८", "content_sanskrit": "पुनस्तानि शरीराणि एकीभूतानि भारत ।\nअदृश्यन्त महाराज तान्यहं व्यधमं पुनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131189, "chapter_id": 3831, "verse_number": "२९", "content_sanskrit": "अणुर्बृहच्छिरा भूत्वा बृहच्चाणुशिराः पुनः ।\nएकीभूतस्तदा राजन् सोऽभ्यवर्तत मां युधि \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131190, "chapter_id": 3831, "verse_number": "३०", "content_sanskrit": "यदाऽभिभवितुं बाणैर्न च शक्नोमि तं रणे ।\nततो महास्त्रमातिष्ठं वायव्यं भरतर्षभ \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131191, "chapter_id": 3831, "verse_number": "३१", "content_sanskrit": "न चैनमशकं हन्तुं तदद्भुतमिवाभवत् ।\nतस्मिन् प्रतिहते चास्त्रे विस्मयो मे महानभूत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131192, "chapter_id": 3831, "verse_number": "३२", "content_sanskrit": "भूय एव महाराज सविशेषमहं ततः ।\nअस्त्रपूगेन महता रणे भूतमवाकिरम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131193, "chapter_id": 3831, "verse_number": "३३", "content_sanskrit": "स्थूणाकर्णमथो भाजं शरवर्षमथोल्बणम् ।\nशलभास्त्रमश्मवर्षं समास्थायाहमभ्ययाम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131194, "chapter_id": 3831, "verse_number": "३४", "content_sanskrit": "जग्रास प्रसभं तानि सर्वाण्यस्त्राणि मे नृप ।\nतेषु सर्वेषु जग्धेषु ब्रह्मास्त्रं महदादिशम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131195, "chapter_id": 3831, "verse_number": "३५", "content_sanskrit": "ततः प्रज्वलितैर्बाणैः सर्वतः सोपचीयते ।\nउपचीयमानश्च मया महास्त्रेण व्यवर्धत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131196, "chapter_id": 3831, "verse_number": "३६", "content_sanskrit": "ततः सन्तापिता लोका मत्प्रसूतेन तेजसा ।\nक्षणेन हि दिशः खं च सर्वतो हि विदीपितम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131197, "chapter_id": 3831, "verse_number": "३७", "content_sanskrit": "तदप्यस्त्रं महातेजाः क्षणेनैव व्यशातयत् ।\nब्रह्मास्त्रे तु हते राजन् भयं मां महदाविशत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131198, "chapter_id": 3831, "verse_number": "३८", "content_sanskrit": "ततोऽहं धनुरादाय तथाऽक्षय्ये महेषुधी ।\nसहसाऽभ्यहनं भूतं तान्यप्यस्त्राण्यभक्षयत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131199, "chapter_id": 3831, "verse_number": "३९", "content_sanskrit": "हतेष्वस्त्रेषु सर्वेषु भक्षितेष्वायुधेषु च ।\nमम तस्य च भूतस्य बाहुयुद्धमवर्तत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131200, "chapter_id": 3831, "verse_number": "४०", "content_sanskrit": "व्यायामं मुष्टिभिः कृत्वा तळैरपि समागतैः ।\nअपारयंश्च तद्भूतं निश्चेष्टमगमं महीम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131201, "chapter_id": 3831, "verse_number": "४१", "content_sanskrit": "ततः प्रहस्य तद्भूतं तत्रैवान्तरधीयत।\nसह स्त्रीभिर्महाराज पश्यतो मेऽद्भुतोपमम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131202, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "ततश्चिन्तां समगमं पूजयिष्याम्यहं पुनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131203, "chapter_id": 3831, "verse_number": "समाप्तिः", "content_sanskrit": "इति पुष्पाणि सङ्गृह्य सैकतं शङ्करं प्रभुम् ।\nपूजयिष्यस्तमद्राक्षं किरातं पुष्पधारिणम् ।\nततश्चान्यानि पुष्पाणि पूजयिष्यन् पुनः पुनः ।\nतानि सर्वाणि दृष्ट्वाऽहं किरातस्य च मूर्धनि ।\nइति कृत्वा महादेवं प्रणतोऽस्मि पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131204, "chapter_id": 3831, "verse_number": "४२", "content_sanskrit": "एवं कृत्वा स भगवांस्ततोऽन्यद् रूपमास्थितः ।\nदिव्यमेव महाराज वसानोऽद्भुतमम्बरम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2131205, "chapter_id": 3831, "verse_number": "४३", "content_sanskrit": "हित्वा मृगतनुं तां च भगवांस्त्रिदशेश्वरः ।\nस्वरूपं दिव्यमास्थाय तस्थौ तत्र महेश्वरः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2131206, "chapter_id": 3831, "verse_number": "४४", "content_sanskrit": "अदृश्यत ततः साक्षाद् भगवान् गोवृषध्वजः ।\nउमासहायो व्यालधृग् बहुरूपः पिनाकधृक्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2131207, "chapter_id": 3831, "verse_number": "४५", "content_sanskrit": "स मामभ्येत्य समरे तथैवाभिमुखं स्थितम् ।\nशूलपाणिरथोवाच तुष्टोऽस्मीति परन्तप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2131208, "chapter_id": 3831, "verse_number": "४६", "content_sanskrit": "ततस्तद्धनुरादाय तूणौ चाक्षय्यसायकौ ।\nप्रादान्ममैव भगवान् धारयस्वेति चाब्रवीत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2131209, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2131210, "chapter_id": 3831, "verse_number": "४७", "content_sanskrit": "तुष्टोऽस्मि तव कौन्तेय ब्रूहि किं करवाणि ते ।\nयत् ते मनोगतं वीर तद् ब्रूहि वितराम्यहम् ।\nअमरत्वमपाहाय ब्रूहि यत् ते मनोगतम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2131211, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2131212, "chapter_id": 3831, "verse_number": "४८", "content_sanskrit": "ततः प्राञ्जलिरेवाहमस्त्रेषु गतमानसः ।\nप्रणम्य मनसा शर्वं ततो वचनमाददे\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2131213, "chapter_id": 3831, "verse_number": "४९", "content_sanskrit": "भगवान् मे प्रसन्नश्चेदीप्सितोऽयं वरो मम ।\nअस्त्राणीच्छाम्यहं ज्ञातुं यानि देवेषु कानिचित् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2131214, "chapter_id": 3831, "verse_number": "५०", "content_sanskrit": "ददानीत्येव भगवानब्रवीत् त्र्यम्बकश्च माम् ।\nरौद्रमस्त्रं मदीयं त्वामुपस्थास्यति पाण्डव \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2131215, "chapter_id": 3831, "verse_number": "५१", "content_sanskrit": "प्रददौ च मम प्रीतः सोऽस्त्रं पाशुपतं महत् ।\nउवाच च महादेवो दत्त्वा मेऽस्त्रं सनातनम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2131216, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2131217, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "न प्रयोज्यं भवेदेतन्मानुषेषु कथञ्चन ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2131218, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "जगद् विनिर्दहेदेवमल्पतेजसि पातितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2131219, "chapter_id": 3831, "verse_number": "५२", "content_sanskrit": "पीड्यमानेन बलवत् प्रयोज्यं स्याद् धनञ्जय \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2131220, "chapter_id": 3831, "verse_number": "५३", "content_sanskrit": "अस्त्राणां प्रतिघाते च सर्वथैव प्रयोजयेत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2131221, "chapter_id": 3831, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2131222, "chapter_id": 3831, "verse_number": "५४", "content_sanskrit": "तदप्रतिहतं दिव्यं सर्वास्त्रप्रतिषेधनम् ।\nमूर्तिमन्मे स्थितं पार्श्वे प्रसन्ने गोवृषध्वजे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2131223, "chapter_id": 3831, "verse_number": "५५", "content_sanskrit": "उत्सादनममित्राणां परसेनानिकर्तनम् ।\nदुरासदं दुष्प्रसहं सुरदानवराक्षसैः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2131224, "chapter_id": 3831, "verse_number": "५६", "content_sanskrit": "अनुज्ञातस्त्वहं तेन तत्रैव समुपाविशम् ।\nप्रेक्षतश्चैव मे देवस्तत्रैवान्तरधीयत\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2131225, "chapter_id": 3831, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि निवात- कवचयुद्धपर्वणि गन्धमादनवासे युधिष्ठिरार्जुनसंवादे द्विषष्ट्यधिकशततमोऽध्यायः\n॥ १६२॥ यक्षयुद्धपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]