[{"id": 7005775000, "chapter_id": 25775, "verse_number": "२४८-१", "content_sanskrit": "वराहावतारचरित्रवर्णनम् ।\nशौनक उवाच ।\nजगदण्डमिदं पूर्वमासीद्दिव्यं हिरण्मयम् ।\nप्रजापतेरियं मूर्तिरितीयं वैदिकी श्रुतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005775001, "chapter_id": 25775, "verse_number": "२४८-२", "content_sanskrit": "तत्तु वर्षसहस्रान्ते बिभेदोर्घ्वमुखं विभुः ।\nलोकसर्जनहेतोस्तु बिभेदाधोमुखं नृप! ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005775002, "chapter_id": 25775, "verse_number": "२४८-३", "content_sanskrit": "भूयोऽष्टदा बिभेदाण्डं विष्णुर्वै लोकजन्मकृत् ।\nचकार जगतश्चात्र विभागं सविभागकृत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005775003, "chapter_id": 25775, "verse_number": "२४८-४", "content_sanskrit": "यच्छिद्रमूर्ध्वमाकाशं विवराकृतितां गतम् ।\nविहितं विश्वयोगेन यदधस्तद्रसातलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005775004, "chapter_id": 25775, "verse_number": "२४८-५", "content_sanskrit": "यदण्डमकरोत्पूर्वं देवो लोकचिकीर्षया ।\nतत्र यत्सलिलं स्कन्नं सोऽभवत्काञ्चनो गिरिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005775005, "chapter_id": 25775, "verse_number": "२४८-६", "content_sanskrit": "शैलैः सहस्रैर्महती मेदिनी विषमाभवत् ।\nतैश्च पर्वतजालौघैर्बहुयोजनविस्तृतैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005775006, "chapter_id": 25775, "verse_number": "२४८-७", "content_sanskrit": "पीडिता गुरुभिर्देवी व्यथिता मेदिनी तदा ।\nमहामते भूरि बलं दिव्यं नारायणात्मकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005775007, "chapter_id": 25775, "verse_number": "२४८-८", "content_sanskrit": "हिरण्मयं समुत्सृज्य तेजो वै जातरूपिणम् ।\nअशक्ता वै धारयितुमधस्तात् प्राविशत्तदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005775008, "chapter_id": 25775, "verse_number": "२४८-९", "content_sanskrit": "पीड्यमाना भगवतस्तेजसा तस्य सा क्षितिः ।\nपृथ्वीं विशन्तीं दृष्ट्वा तु तामधोमधुसूदनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005775009, "chapter_id": 25775, "verse_number": "२४८-१०", "content_sanskrit": "उद्धारार्थं मनश्चक्रे तस्या वै हितकाम्यया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005775010, "chapter_id": 25775, "verse_number": "२४८-११", "content_sanskrit": "भगवानुवाच ।\nमत्तेज एषा वसुधा समासाद्य तपस्विनी ।\nरसातलं प्रविशति पङ्के गौरिव दुर्बला ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005775011, "chapter_id": 25775, "verse_number": "२४८-१२", "content_sanskrit": "पृथिव्युवाच ।\nत्रिविक्रमायामितविक्रमाय महावराहाय सुरोत्तमाय ।\nश्रीशार्ङ्गचक्रासिगदाधराय नमोऽस्तु ते देववर! प्रसीद ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005775012, "chapter_id": 25775, "verse_number": "२४८-१३", "content_sanskrit": "तव देहाज्जगज्जातं पुष्करद्वीपमुत्थितम् ।\nब्रह्माणमिह लोकानां भूतानां शाश्वतं विदुः ॥ २२४८.१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005775013, "chapter_id": 25775, "verse_number": "२४८-१४", "content_sanskrit": "तव प्रसादाद्देवोऽयं दिवं भुङ्क्ते पुरन्दरः ।\nतव क्रोधाद्धि बलवान् जनार्दन जितो बलिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005775014, "chapter_id": 25775, "verse_number": "२४८-१५", "content_sanskrit": "धाता विधाता संहर्ता त्वयि सर्वं प्रतिष्ठितम् ।\nमनुः कृतान्तोऽधिपतिर्ज्वलनः पवनो घनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005775015, "chapter_id": 25775, "verse_number": "२४८-१६", "content_sanskrit": "वर्णाश्चाश्रमधर्माश्च सागरास्तरवो जलम् ।\nनद्यो धर्मश्च कामश्च यज्ञा यज्ञस्य च क्रियाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005775016, "chapter_id": 25775, "verse_number": "२४८-१७", "content_sanskrit": "विद्यावेद्यञ्च सत्वञ्च ह्रीः श्रीः कीर्तिर्धृतिः क्षमा ।\nपुराणं वेदवेदाङ्गं साङ्ख्ययोगौ भवाभवौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005775017, "chapter_id": 25775, "verse_number": "२४८-१८", "content_sanskrit": "जङ्गमं स्थावरञ्चैव भविष्यञ्च भवच्च यत् ।\nसर्वन्तच्च त्रिलोकेषु प्रभावोपहितन्तव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005775018, "chapter_id": 25775, "verse_number": "२४८-१९", "content_sanskrit": "त्रिदशोदारफलदः स्वर्गस्त्री चारुपल्लवः ।\nसर्वलोकमनः कान्तः सर्वसत्वमनोहरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005775019, "chapter_id": 25775, "verse_number": "२४८-२०", "content_sanskrit": "वमानानेकविटपस्तोयदाम्बुमधुस्रवः ।\nदिव्यलोकमहास्कन्धसत्यलोकप्रशाखवान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005775020, "chapter_id": 25775, "verse_number": "२४८-२१", "content_sanskrit": "सागराकारनिर्यासो रसातलजलाश्रयः ।\nनागेन्द्रपादपोपेतो जन्तुपक्षिनिषेवितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005775021, "chapter_id": 25775, "verse_number": "२४८-२२", "content_sanskrit": "शीलाचारार्यगन्धस्त्वं सर्वलोकमयोद्रुमः ।\nद्वादशार्कमयद्वीपो रुद्रैकादशपत्तनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005775022, "chapter_id": 25775, "verse_number": "२४८-२३", "content_sanskrit": "वस्वष्टाचलसंयुक्त स्त्रैलोक्याम्भो महोदधिः ।\nसिद्धसाध्योर्मिसलिल सुपर्णानिलसेवित ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005775023, "chapter_id": 25775, "verse_number": "२४८-२४", "content_sanskrit": "दैत्यलोकमहाग्राहो रक्षोरगरुषाकुलः ।\nपितामहमहाधैर्यः स्वर्गस्त्रीरत्नभूषितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005775024, "chapter_id": 25775, "verse_number": "२४८-२५", "content_sanskrit": "धीश्रीह्रीकान्तिभिः नित्यं नदीभिरुपशोभितः ।\nकालयोग महापर्व प्रयागगति वेगवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005775025, "chapter_id": 25775, "verse_number": "२४८-२६", "content_sanskrit": "त्वं स्वयोगमहावीर्यो नारायणमहार्णवः ।\nकालो भूत्वा प्रसन्नाभिरद्भिर्ह्रादयसे पुनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005775026, "chapter_id": 25775, "verse_number": "२४८-२७", "content_sanskrit": "त्वया सृष्टास्त्रयो लोकास्त्वयैव प्रतिसंहृताः ।\nविशन्ति योगिनः सर्वे त्वामेव प्रतियोजिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005775027, "chapter_id": 25775, "verse_number": "२४८-२८", "content_sanskrit": "युगे युगे युगान्ताग्निः कालमेघो युगे युगे ।\nमहाभारावताराय देव! त्वं हि युगे युगे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005775028, "chapter_id": 25775, "verse_number": "२४८-२९", "content_sanskrit": "त्वं हि शुक्लः कृतयुगे त्रेतायां चम्पकप्रभः ।\nद्वापरे रक्तसङ्काशः कृष्णः कलियुगे भवान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005775029, "chapter_id": 25775, "verse_number": "२४८-३०", "content_sanskrit": "वैवर्ण्यमभिधत्सेत्वं प्राप्तेषु युगसन्धिषु ।\nवैवर्ण्यं सर्वधर्माणामुत्पादयसि वेदवित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005775030, "chapter_id": 25775, "verse_number": "२४८-३१", "content_sanskrit": "भासि वासिप्रतपसि त्वञ्च पासि विचेष्टसे ।\nक्रुध्यसि क्षान्तिमायासि त्वं दीपयसि वर्षसि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005775031, "chapter_id": 25775, "verse_number": "२४८-३२", "content_sanskrit": "त्वं हास्यसि न निर्यासि निर्वापयसि जाग्रसि ।\nनिःशेषयसि भूतानि कालो भूत्वा युगक्षये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005775032, "chapter_id": 25775, "verse_number": "२४८-३३", "content_sanskrit": "शेषमात्मानमालोक्य विशेषयसि त्वं पुनः ।\nयुगान्ताग्नावलीढेषु सर्वभूतेषु किञ्चन ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005775033, "chapter_id": 25775, "verse_number": "२४८-३४", "content_sanskrit": "यातेषु शेषो भवसि तस्माच्छेषोऽसि कीर्तितः ।\nच्यवनोत्पत्तियुक्तेषु ब्रह्मेन्द्र वरुणादिषु ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005775034, "chapter_id": 25775, "verse_number": "२४८-३५", "content_sanskrit": "यस्मान्न च्यवसे स्थानात्तस्मात्सङ्कीर्त्यसेऽच्युतः ।\nब्रह्माणमिन्द्रञ्च यमं रुद्रं वरुणमेव च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005775035, "chapter_id": 25775, "verse_number": "२४८-३६", "content_sanskrit": "निगृह्य हरसे यस्मात् तस्माद्धरिरिहोच्यसे ।\nसम्मानयसि भूतानि वपुषा यशसा श्रिया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005775036, "chapter_id": 25775, "verse_number": "२४८-३७", "content_sanskrit": "परेण वपुषा देव! तस्माच्चासि सनातनः ।\nयस्माद् ब्रह्मादयो देवा मुनयश्चोग्रतेजसः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005775037, "chapter_id": 25775, "verse_number": "२४८-३८", "content_sanskrit": "न तेऽन्तं त्वधिगच्छन्ति तेनानन्तस्त्वमुच्यसे ।\nन क्षीयसे न क्षरसे कल्पकोटिशतैरपि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005775038, "chapter_id": 25775, "verse_number": "२४८-३९", "content_sanskrit": "तस्मात्त्वमक्षरत्वाच्च विष्णुरित्येव कीर्त्यसे ।\nविष्टब्धं यत्त्वया सर्वं जगत् स्थावरजङ्गमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005775039, "chapter_id": 25775, "verse_number": "२४८-४०", "content_sanskrit": "जगद्विष्टम्भनाच्चैव विष्णुरेवेति कीर्त्यसे ।\nविष्टभ्य तिष्ठसे नित्यं त्रैलोक्यं सचराचरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005775040, "chapter_id": 25775, "verse_number": "२४८-४१", "content_sanskrit": "यक्षगन्धर्वनगरं सुमहद्भूतपन्नगम् ।\nव्याप्तं त्वयैव विशता त्रैलोक्यं सचराचरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005775041, "chapter_id": 25775, "verse_number": "२४८-४२", "content_sanskrit": "तस्माद्विष्णुरिति प्रोक्तः स्वयमेव स्वयम्भुवा ।\nनारा इत्युच्यते ह्यापो ऋषिभिस्तत्वदर्शिभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005775042, "chapter_id": 25775, "verse_number": "२४८-४३", "content_sanskrit": "अयनन्तस्यताः पूर्वन्तेन नारायणः स्मृतः ।\nयुगे युगे प्रनष्टाङ्गां विष्णो! विन्दसि तत्वतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005775043, "chapter_id": 25775, "verse_number": "२४८-४४", "content_sanskrit": "गोविन्देति ततो नाम्ना प्रोच्यसे ऋषिभिस्तथा ।\nहृषीकाणीन्द्रियाण्याहुस्तत्वज्ञान विशारदाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005775044, "chapter_id": 25775, "verse_number": "२४८-४५", "content_sanskrit": "ईशिता च त्वमेतेषां हृषीकेशस्तथोच्यते ।\nवसन्ति त्वयि भूतानि ब्रह्मादीनि युगक्षये ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005775045, "chapter_id": 25775, "verse_number": "२४८-४६", "content_sanskrit": "त्वं वा वससि भूतेषु वासुदेवस्तथोच्यसे ।\nसङ्कर्षयसि भूतानि कल्पे कल्पे पुनः पुनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005775046, "chapter_id": 25775, "verse_number": "२४८-४७", "content_sanskrit": "ततः सङ्कर्षणः प्रोक्तस्तत्वज्ञान विशारदैः ।\nप्रतिव्यूहेन तिष्ठन्ति सदेवासुरराक्षसाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005775047, "chapter_id": 25775, "verse_number": "२४८-४८", "content_sanskrit": "प्रविद्युः सर्वधर्माणां प्रद्युम्नस्तेन चोच्यसे ।\nनिरोद्धा विद्यते यस्मान्न ते भूतेषु कश्चन ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005775048, "chapter_id": 25775, "verse_number": "२४८-४९", "content_sanskrit": "अनिरुद्धस्ततः प्रोक्तः पूर्वमेव महर्षिभिः ।\nयत्त्वया धार्यते विश्वं त्वया संह्रियते जगत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005775049, "chapter_id": 25775, "verse_number": "२४८-५०", "content_sanskrit": "त्वं धारयसि भूतानि भवनं त्वं बिभर्षि च ।\nयत्त्वया धार्यते किञ्चित्तेजसा च बलेन च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005775050, "chapter_id": 25775, "verse_number": "२४८-५१", "content_sanskrit": "मया हि धार्यते पश्चान्नाधृतं धारये त्वया ।\nन हि तद्विद्यते भूतं त्वया यन्नात्र धार्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005775051, "chapter_id": 25775, "verse_number": "२४८-५२", "content_sanskrit": "त्वमेव कुरुषे! देव! नारायण युगे युगे ।\nमहाभारावतरणं जगतो हितकाम्यया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005775052, "chapter_id": 25775, "verse_number": "२४८-५३", "content_sanskrit": "तवैव तेजसाक्रान्तां रसातलतलङ्गतम् ।\nत्रायस्व मां सुरश्रेष्ठ! त्वामेव शरणङ्गताम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005775053, "chapter_id": 25775, "verse_number": "२४८-५४", "content_sanskrit": "दानवैः पीड्यमानाहं राक्षसैश्च दुरात्मभिः ।\nत्वामेव शरणं नित्यमुपयामि सनातनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005775054, "chapter_id": 25775, "verse_number": "२४८-५५", "content_sanskrit": "तावन्मेऽस्ति भयं देव! यावन्न त्वां ककुद्मिनम् ।\nशरणं यामि मनसा शतशोऽप्युपलक्षये ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005775055, "chapter_id": 25775, "verse_number": "२४८-५६", "content_sanskrit": "उपमानं न ते शक्ताः कर्तु सेन्द्रा दिवौकसः ।\nतत्त्वं त्वमेव तद्वेत्सि निरुत्तरमतः परम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005775056, "chapter_id": 25775, "verse_number": "२४८-५७", "content_sanskrit": "शौनक उवाच ।\nततः प्रीतः स भगवान् पृथिव्यै शार्ङ्ग चक्रधृक् ।\nकाममस्या यथाकाममभिपूरितवान् हरिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005775057, "chapter_id": 25775, "verse_number": "२४८-५८", "content_sanskrit": "अब्रवीच्च महादेवि! माधवीयं स्तवोत्तमम् ।\nधारयिष्यति यो मर्त्यो नास्ति तस्य पराभवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005775058, "chapter_id": 25775, "verse_number": "२४८-५९", "content_sanskrit": "लोकान्निष्कल्मषां श्चैव वैष्णवान् प्रतिपत्स्यते ।\nएतदाश्चर्य सर्वस्वं माधवीयं स्तवोत्तमम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005775059, "chapter_id": 25775, "verse_number": "२४८-६०", "content_sanskrit": "अधीतवेदः पुरुषो मुनिः प्रीतमना भवेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005775060, "chapter_id": 25775, "verse_number": "२४८-६१", "content_sanskrit": "मा भैर्धरणि! कल्याणि! शान्तिं व्रज ममाग्रतः ।\nएष त्वामुचितं स्थानं प्रापयामि मनीषितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005775061, "chapter_id": 25775, "verse_number": "२४८-६२", "content_sanskrit": "ततो महात्मा मनसा दिव्यं रूपमचिन्तयत् ।\nकिन्नु रूपमहं कृत्वा उद्धरेयं धरामिमाम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005775062, "chapter_id": 25775, "verse_number": "२४८-६३", "content_sanskrit": "जलक्रीडारुचिस्तस्माद्वाराहं वपुरास्थितः ।\nअदृश्यं सर्वभूतानां वाङ्मयं ब्रह्म संस्थितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005775063, "chapter_id": 25775, "verse_number": "२४८-६४", "content_sanskrit": "शतयोजनविस्तीर्णमुच्छ्रितं द्विगुणं ततः ।\nनीलजीमूतसङ्काशं मेघस्तनितनिस्वनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005775064, "chapter_id": 25775, "verse_number": "२४८-६५", "content_sanskrit": "गिरिसंहननं भीमं श्वेततीक्ष्णाग्रदंष्ट्रिणम् ।\nविद्युदग्निप्रतीकाशमादित्य समतेजसम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005775065, "chapter_id": 25775, "verse_number": "२४८-६६", "content_sanskrit": "पीनोन्नतकटीदेशे वृषलक्षणपूजितम् ।\nरूपमास्थाय विपुलं वाराहमजितो हरिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005775066, "chapter_id": 25775, "verse_number": "२४८-६७", "content_sanskrit": "पृथिव्युद्धरणायैव प्रविवेश रसातलम् ।\nवेदपादो यूपदंष्ट्र क्रतुदन्तश्चितीमुखः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005775067, "chapter_id": 25775, "verse_number": "२४८-६८", "content_sanskrit": "अग्निजिह्वो दर्भलोमा ब्रह्मशीर्षो महातपाः ।\nअहोरात्रेक्षणधरो वेदाङ्गश्रुतिभूषणः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005775068, "chapter_id": 25775, "verse_number": "२४८-६९", "content_sanskrit": "आज्यनासः स्रुवतुण्डः सामघोषस्वनो महान् ।\nसत्यधर्ममयः श्रीमान् कर्मविक्रम सत्क्रमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005775069, "chapter_id": 25775, "verse_number": "२४८-७०", "content_sanskrit": "प्रायश्चित्त नखो घोरः पशुजानुर्मखाकृतिः ।\nउद्गाथा होमलिङ्गोऽथ बीजौषधि महाफलः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005775070, "chapter_id": 25775, "verse_number": "२४८-७१", "content_sanskrit": "वाय्वन्तरात्मा यज्ञास्थि विकृतिः सोमशोणितः ।\nवेदस्कन्धो हविर्गन्धो हव्यकव्यविभागवान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005775071, "chapter_id": 25775, "verse_number": "२४८-७२", "content_sanskrit": "प्राग्वंशकायो द्युतिमान् नानादीक्षाभिरन्वितः ।\nदक्षिणा हृदयो योगी महासत्रमयो महान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005775072, "chapter_id": 25775, "verse_number": "२४८-७३", "content_sanskrit": "उपाकर्मोष्ठरुचकः प्रवर्ग्यावर्तभूषणः ।\nनानाच्छन्दोगतिपथो गुह्योपनिषदासनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005775073, "chapter_id": 25775, "verse_number": "२४८-७४", "content_sanskrit": "छाया पत्नी सहायो वै मणिश्रृङ्ग इवोच्छ्रितः ।\nरसातलतले मग्नां रसातलतलङ्गताम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005775074, "chapter_id": 25775, "verse_number": "२४८-७५", "content_sanskrit": "प्रभुर्लोकहितार्थाय दष्ट्राङ्ग्रेणोज्जहार ताम् ।\nततः स्वस्थानमानीय वराहः पृथिवीधरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005775075, "chapter_id": 25775, "verse_number": "२४८-७६", "content_sanskrit": "मुमोच पूर्वं मनसा धारिताञ्च वसुन्धराम् ।\nततो जगाम निर्वाणं मेदिनी तस्य धारणात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005775076, "chapter_id": 25775, "verse_number": "२४८-७७", "content_sanskrit": "चकार च नमस्कारं तस्मै देवाय शम्भवे ।\nएवं यज्ञवराहेण भूत्वा भूतहितार्थिना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005775077, "chapter_id": 25775, "verse_number": "२४८-७८", "content_sanskrit": "उद्धृता पृथिवी देवी सागराम्बुगता पुरा ।\nअथोद्धृत्य क्षितिं देवो जगतः स्थापनेच्छयापृथिवी प्रविभागाय मनश्चक्रेऽम्बुजेक्षणः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005775078, "chapter_id": 25775, "verse_number": "२४८-७९", "content_sanskrit": "रसाङ्गतामवनिमचिन्तविक्रमः सुरोत्तमः प्रवरवराहरूपधृक् ।\nवृषाकपिः प्रसभमथैकदंष्ट्रया समुद्धरद्धरणिमतुल्यपौरुषः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]