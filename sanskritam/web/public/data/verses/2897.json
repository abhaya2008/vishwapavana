[{"id": 2088751, "chapter_id": 2897, "verse_number": "१३-२७-१", "content_sanskrit": "`भीष्म उवाच।\nहत्वा तं पक्षिशार्दूलः कुविन्दानां जनं व्रती।\nउपोपविश्य शैलाग्रे भक्षयामास तावुभौ।\nवारणं कच्छर्प चैव संहृष्टः स पतत्रिराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088752, "chapter_id": 2897, "verse_number": "१३-२७-२", "content_sanskrit": "तयोः स रुधिरं पीत्वा मेदसी च परन्तप।\nसंहृष्टः यततांश्रेष्ठो लब्ध्वा बलमनुत्तमम्।\nजंगाम देवराजस्य भवनं पन्नगाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088753, "chapter_id": 2897, "verse_number": "१३-२७-३", "content_sanskrit": "तं प्रणम्य महात्मानं पावकं विस्फुलिङ्गिनम्।\nरात्रिदिवं प्रज्वलितं रक्षार्थममृतस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088754, "chapter_id": 2897, "verse_number": "१३-२७-४", "content_sanskrit": "तं दृष्ट्वा विहगेन्द्रस्य भयं तीव्रमुपाविशत्।\nनतु तोयान्न रक्षिभ्यो भयमस्योपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088755, "chapter_id": 2897, "verse_number": "१३-२७-५", "content_sanskrit": "पक्षित्वमात्मनो दृष्ट्वा ज्वलन्तं च हुताशनम्।\nपितामहमथो गत्वा ददर्श भुजगाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088756, "chapter_id": 2897, "verse_number": "१३-२७-६", "content_sanskrit": "तं प्रणम्य महात्मानं गरुडः प्रयताञ्जलिः।\nप्रोवाच तदसन्दिग्धं वचनं पन्नगेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088757, "chapter_id": 2897, "verse_number": "१३-२७-७", "content_sanskrit": "उद्यतं गुरुकृत्ये मां भगवन्धर्मनिश्चितम्।\nविमोक्षणार्थं मातुर्हि दासभावादनिन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088758, "chapter_id": 2897, "verse_number": "१३-२७-८", "content_sanskrit": "कद्रूसकाशममृतं मयाहर्तव्यमीश्वर।\nतदा मे जननी देव दासभावात्प्रमोक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088759, "chapter_id": 2897, "verse_number": "१३-२७-९", "content_sanskrit": "तत्रामृतं प्रज्वलितो नित्यमीश्वर रक्षति।\nहिरण्यरेता भगवान्पाकशासनशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088760, "chapter_id": 2897, "verse_number": "१३-२७-१०", "content_sanskrit": "तत्र मे देवदेवेश भयं तीव्रमथाविशत्।\nज्वलन्तं पावकं दृष्ट्वा पक्षित्वं चात्मनः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088761, "chapter_id": 2897, "verse_number": "१३-२७-११", "content_sanskrit": "समतिक्रमितुं शक्यः कथं स्यात्पावको मया।\nतस्याभ्युपायं वरद वक्तुमीशोऽसि मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088762, "chapter_id": 2897, "verse_number": "१३-२७-१२", "content_sanskrit": "तमब्रवीन्महाभाग तप्यमानं विहङ्गमम्।\nअग्नेः संशमनोपायमुत्सयन्त पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088763, "chapter_id": 2897, "verse_number": "१३-२७-१३", "content_sanskrit": "पयसा शाम्यते वत्स सर्पिषा च हुताशनः।\nशरीरस्थोपि भूतानां किं पुनः प्रज्वलन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088764, "chapter_id": 2897, "verse_number": "१३-२७-१४", "content_sanskrit": "नवनीतं पयो वाऽपि पावके त्वं समादधेः।\nततो गच्छ यथाकामं न त्वा धक्ष्यति पावकः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088765, "chapter_id": 2897, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तविंशोऽध्यायः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]