[{"id": 50025008, "chapter_id": 11974, "verse_number": "1", "content_sanskrit": "अतोऽनिर्वचनीयाभावादसतः प्रतीत्यनङ्गीकारात् प्रतीयमानत्वाच्च भेदस्य सत्त्वप्राप्तेर्नाद्वितीयत्वं युज्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025009, "chapter_id": 11974, "verse_number": "2", "content_sanskrit": "॥ भेदस्य सत्यत्वेनैव श्रुतिसिद्धत्वाच्च भेदप्रपञ्चस्य सत्यत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025010, "chapter_id": 11974, "verse_number": "3", "content_sanskrit": "कथं च श्रुतिसिद्धो जीवपरमात्मभेदो निराक्रियते। मिथ्यावादित्वे च श्रुतेः कथमैक्यस्य सत्यत्वम्। कथं चैवंवादिनां वेदवादित्वम्। वेदोक्तस्य मिथ्यात्वाङ्गीकारादेव ह्यवेदवादित्वं बौद्धादीनामपि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025011, "chapter_id": 11974, "verse_number": "4", "content_sanskrit": "॥ बाधकपरिहारोपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50025012, "chapter_id": 11974, "verse_number": "5", "content_sanskrit": "अतो विष्णोः सर्वोत्तमत्व एव महातात्पर्यं सर्वागमानाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50025013, "chapter_id": 11974, "verse_number": "6", "content_sanskrit": "॥ जीवेश्वराभेदस्याप्रामाणिकत्वं प्रमाणविरुद्धत्वं चेत्युक्तार्थस्य प्रपञ्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50025014, "chapter_id": 11974, "verse_number": "7", "content_sanskrit": "कथं च जीवपरमात्मैक्ये सर्वश्रुतीनां तात्पर्यं युज्यते। सर्वप्रमाणविरुद्धत्वात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50025015, "chapter_id": 11974, "verse_number": "8", "content_sanskrit": "॥ जीवेश्वराभेदस्य साक्षिप्रत्यक्षासिद्धत्वं तद्विरुद्धत्वं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50025016, "chapter_id": 11974, "verse_number": "9", "content_sanskrit": "तथाह्यनुभवविरोधः। नह्यहं सर्वज्ञः सर्वेश्वरो निर्दुःखो निर्दोष इति वा कस्यचिदनुभवः। अस्ति च तद्विपर्ययेणानुभवः। नच मिथ्यानुभवोऽयम्। तद्विपरीतप्रमाणाभावात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50025017, "chapter_id": 11974, "verse_number": "10", "content_sanskrit": "॥ जीवेश्वराभेदस्यागमासिद्धत्वं तद्विरुद्धत्वं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50025018, "chapter_id": 11974, "verse_number": "11", "content_sanskrit": "नचाभेदे कश्चिदागमः। सन्ति च भेदे सर्वागमाः। तथाहि - “अतत्त्वमसि” (कुत्र: छान्दोग्योपनिषत् ६/३/५,७,९,११,१२,१३,१४,१५,१६) इति नवकृत्व उपदेशः सदृष्टान्तकः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]