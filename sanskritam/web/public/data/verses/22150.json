[{"id": 7002150000, "chapter_id": 22150, "verse_number": "१९५-१", "content_sanskrit": "वारव्रतानि ।\nअग्निरुवाच ।\nवारव्रतानि वक्ष्यामि भुक्तिमुक्तिप्रदानि हि ।\nकरं पुनर्वसुः सूर्ये स्नाने सर्वौषधी शुभा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002150001, "chapter_id": 22150, "verse_number": "१९५-२", "content_sanskrit": "श्राध्हौ चादित्यवारे तु सप्तजन्मस्वरोगभाक् ।\nसङ्क्रान्तौ सूर्यवारो यः सोऽर्कस्य हृदयः शुभः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002150002, "chapter_id": 22150, "verse_number": "१९५-३", "content_sanskrit": "कृत्वा हस्ते सूर्यवारं नक्तेनाब्दं स सर्वभाक् ।\nचित्राभसोमवाराणि सप्त कृत्वा सुखी भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002150003, "chapter_id": 22150, "verse_number": "१९५-४", "content_sanskrit": "स्वात्यां गृहीत्वा चाङ्गारं सप्तनक्त्यार्तिवर्जितः ।\nविशाखायां बुधं गृह्य सप्तनक्ती ग्रहार्तिनुत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002150004, "chapter_id": 22150, "verse_number": "१९५-५", "content_sanskrit": "अनुराधे देवगुरुं सप्तनक्ती ग्रहार्तिनुत् ।\nशुक्रं ज्येष्ठासु सङ्गृह्य सप्तनक्ती ग्रहार्तिनुत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002150005, "chapter_id": 22150, "verse_number": "१९५-६", "content_sanskrit": "मूले शनैश्चरं गृह्य सप्तनक्ती ग्रहार्तिनुत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]