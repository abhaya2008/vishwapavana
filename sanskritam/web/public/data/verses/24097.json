[{"id": 7004097000, "chapter_id": 24097, "verse_number": "४-४६-१", "content_sanskrit": "स्कंद उवाच ।\nगतेथ योगिनीवृंदे देवदेवो घटोद्भव ।\nकाशीप्रवृत्तिं जिज्ञासुः प्राहिणोदंशुमालिनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004097001, "chapter_id": 24097, "verse_number": "४-४६-२", "content_sanskrit": "देवदेव उवाच ।\nसप्ताश्व त्वरितो याहि पुरीं वाराणसीं शुभाम् ।\nयत्रास्ति स दिवोदासो धर्ममूर्तिर्महीपतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004097002, "chapter_id": 24097, "verse_number": "४-४६-३", "content_sanskrit": "तस्य धर्मविरोधेन यथातत्क्षेत्रमुद्वसेत् ।\nतथा कुरुष्व भो क्षिप्रं मावमंस्थाश्च तं नृपम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004097003, "chapter_id": 24097, "verse_number": "४-४६-४", "content_sanskrit": "धर्ममार्ग प्रवृत्तस्य क्रियते यावमानना ।\nसा भवेदात्मनो नूनं महदेनश्च जायते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004097004, "chapter_id": 24097, "verse_number": "४-४६-५", "content_sanskrit": "तवबुद्धिविकासेन च्यवते चेत्स धर्मतः ।\nतदा सा नगरी भानो त्वयोद्वास्याऽसहैः करैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004097005, "chapter_id": 24097, "verse_number": "४-४६-६", "content_sanskrit": "कामक्रोधौ लोभमोहौ मत्सराहंकृती अपि ।\nते तत्र न भवेतां यत्तत्कालोपि न तं जयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004097006, "chapter_id": 24097, "verse_number": "४-४६-७", "content_sanskrit": "यावद्धर्मे स्थिराबुद्धिर्यावद्धर्मेस्थिरं मनः ।\nतावद्विघ्नोदयः क्वास्ति विपद्यपि रवे नृषु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004097007, "chapter_id": 24097, "verse_number": "४-४६-८", "content_sanskrit": "सर्वेषामिह जंतूनां त्वं वेत्सि ब्रध्नचेष्टितम् ।\nअतएव जगच्चक्षुर्व्रज त्वं कार्यसिद्धये ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004097008, "chapter_id": 24097, "verse_number": "४-४६-९", "content_sanskrit": "रविरादाय देवाज्ञां मूर्तिमन्यां प्रकल्प्य च ।\nनभोध्वगामहोरात्रं काशीमभिमुखोऽभवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004097009, "chapter_id": 24097, "verse_number": "४-४६-१०", "content_sanskrit": "मनसातीवलोलोऽभूत्काशीदर्शनलालसः ।\nसहस्रचरणोप्यैच्छत्तदा खे नैकपादताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004097010, "chapter_id": 24097, "verse_number": "४-४६-११", "content_sanskrit": "हंसत्वं तस्य सूर्यस्य तदा सफलतामगात् ।\nसदा नभोध्वनीनस्य काशीं प्रति यियासतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004097011, "chapter_id": 24097, "verse_number": "४-४६-१२", "content_sanskrit": "अथ काशीं समासाद्य रविरंतर्बहिश्चरन् ।\nमनागपि न तद्भूपे धर्मध्वस्तिमवेक्षत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004097012, "chapter_id": 24097, "verse_number": "४-४६-१३", "content_sanskrit": "विभावसुर्वसन्काश्यां नानारूपेण वत्सरम् ।\nक्वचिन्नावसरं प्राप तत्र राज्ञि सुधर्मिणि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004097013, "chapter_id": 24097, "verse_number": "४-४६-१४", "content_sanskrit": "कदाचिदतिथिर्भूतो दुर्लभं प्रार्थयन्रविः ।\nन तस्य राज्ञो विषये दुर्लभं किंचिदैक्षत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004097014, "chapter_id": 24097, "verse_number": "४-४६-१५", "content_sanskrit": "कदाचिद्याचको जातो बहुदोपि कदाप्यभूत् ।\nकदाचिद्दीनतां प्राप्तः कदाचिद्गणकोप्यभूत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004097015, "chapter_id": 24097, "verse_number": "४-४६-१६", "content_sanskrit": "वेदबाह्यां क्रियां चापि कदाचित्प्रत्यपादयत् ।\nकदाचित्स्थापयामास दृष्टप्रत्ययमैहिकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004097016, "chapter_id": 24097, "verse_number": "४-४६-१७", "content_sanskrit": "कदाचिज्जटिलो जातः कदाचिच्च दिगंबरः ।\nस कदाचिज्जांगुलिको विषविद्याविशारदः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004097017, "chapter_id": 24097, "verse_number": "४-४६-१८", "content_sanskrit": "सर्वपाषंडधर्मज्ञः कदाचिद्ब्रह्मवाद्यभूत् ।\nऐंद्रजालिक आसीच्च कदाचिद्भ्रामयञ्जनान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004097018, "chapter_id": 24097, "verse_number": "४-४६-१९", "content_sanskrit": "नानाव्रतोपदेशैश्च कदाचित्स पतिव्रताः ।\nक्षोभयामास बहुशः सदृष्टांत कथानकैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004097019, "chapter_id": 24097, "verse_number": "४-४६-२०", "content_sanskrit": "कापालिक व्रतधरः कदाचिच्चाभवद्द्विजः ।\nकदाचिदपि विज्ञानी धातुवादी कदाचन ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004097020, "chapter_id": 24097, "verse_number": "४-४६-२१", "content_sanskrit": "क्वचिद्विप्रः क्वचिद्राजपुत्रो वैश्योंत्यजः क्वचित ।\nब्रह्मचारी क्वचिदभूद्गृही वनचरः क्वचित् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004097021, "chapter_id": 24097, "verse_number": "४-४६-२२", "content_sanskrit": "यतिः कदाचिदिति सरूपैरभ्रामयज्जनान् ।\nसर्वविद्यासु कुशलः सर्वज्ञश्चाभवत्क्वचित् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004097022, "chapter_id": 24097, "verse_number": "४-४६-२३", "content_sanskrit": "इति नानाविधै रूपैश्चरन्काश्यां ग्रहेश्वरः ।\nन कदापि जने क्वापि च्छिद्रं प्राप कदाचन ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004097023, "chapter_id": 24097, "verse_number": "४-४६-२४", "content_sanskrit": "ततो निनिंद चात्मानं चिंतार्तः कश्यपात्मजः ।\nधिक्परप्रेष्यतां यस्यां यशो लभ्येत न क्वचित् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004097024, "chapter_id": 24097, "verse_number": "४-४६-२५", "content_sanskrit": "मार्तंड उवाच ।\nमंदरं यदि याम्यद्य सद्यस्तत्क्रुद्ध्यतीश्वरः ।\nअनिष्पादितकार्यार्थे मयि सामान्यभृत्यवत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004097025, "chapter_id": 24097, "verse_number": "४-४६-२६", "content_sanskrit": "कोपमप्युररीकृत्य यदि यायां कथंचन ।\nकथं तिष्ठे पुरस्तस्य तर्हि वै मूढभृत्यवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004097026, "chapter_id": 24097, "verse_number": "४-४६-२७", "content_sanskrit": "अथोंकृत्यावहेलं वा यामि चेच्च कथंचन ।\nक्रोधान्निरीक्षेत्त्र्यक्षो मां विषं पेयं तदा मया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004097027, "chapter_id": 24097, "verse_number": "४-४६-२८", "content_sanskrit": "हरकोपानले नूनं यदि यातः पतंगताम् ।\nपितामहोपि मां त्रातुं तदा शक्ष्यति नस्फुटम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004097028, "chapter_id": 24097, "verse_number": "४-४६-२९", "content_sanskrit": "स्थास्याम्यत्रैव तन्नित्यं न त्यक्ष्यामि कदाचन ।\nक्षेत्रसंन्यासविधिना वाराणस्यां कृताश्रमः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004097029, "chapter_id": 24097, "verse_number": "४-४६-३०", "content_sanskrit": "पुरः पुरारेः कायार्थमनिवेद्येह तिष्ठतः ।\nयत्पापं भावि मे तस्य काशीपापस्यनिष्कृतिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004097030, "chapter_id": 24097, "verse_number": "४-४६-३१", "content_sanskrit": "अन्यान्यपि च पापानि महांत्यल्पानि यानि च ।\nक्षयंति तानि सर्वाणि काशीं प्रविशतां सताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004097031, "chapter_id": 24097, "verse_number": "४-४६-३२", "content_sanskrit": "बुद्धिपूर्वं मया चैतन्न पापं समुपार्जितम् ।\nपुरारिणैव हि पुराऽशासि धर्मो हि रक्ष्यताम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004097032, "chapter_id": 24097, "verse_number": "४-४६-३३", "content_sanskrit": "धर्मो हि रक्षितो येन देहे सत्वरगत्वरे ।\nत्रैलोक्यरक्षितं तेन किं कामार्थैः सुरक्षितैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004097033, "chapter_id": 24097, "verse_number": "४-४६-३४", "content_sanskrit": "रक्षणीयो यदि भवेत्कामः कामारिणा कथम् ।\nक्षणादनंगतां नीतो बहूनां सुखकार्यपि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004097034, "chapter_id": 24097, "verse_number": "४-४६-३५", "content_sanskrit": "अर्थश्चेत्सर्वथारक्ष्य इति कैश्चिदुदाहृतम् ।\nतत्कथं न हरिश्चंद्रोऽरक्षत्कुशिकनंदने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004097035, "chapter_id": 24097, "verse_number": "४-४६-३६", "content_sanskrit": "धर्मस्तु रक्षितः सर्वैरपिदेहव्ययेन च ।\nशिबिप्रभृतिभूपालैर्दधीचिप्रमुखैर्द्विजैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004097036, "chapter_id": 24097, "verse_number": "४-४६-३७", "content_sanskrit": "अयमेव हि वै धर्मः काशीसेवनसंभवः ।\nरुषितादपि रुद्रान्मां रक्षिष्यति न संशयः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004097037, "chapter_id": 24097, "verse_number": "४-४६-३८", "content_sanskrit": "अवाप्य काशीं दुष्प्रापां को जहाति सचेतनः ।\nरत्नं करस्थमुत्सृज्य कः काचं संजिघृक्षति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004097038, "chapter_id": 24097, "verse_number": "४-४६-३९", "content_sanskrit": "वाराणसीं समुत्सृज्य यस्त्वन्यत्र यियासति ।\nहत्वा निधानं पादेन सोर्थमिच्छति भिक्षया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004097039, "chapter_id": 24097, "verse_number": "४-४६-४०", "content_sanskrit": "पुत्रमित्रकलत्राणि क्षेत्राणि च धनानि च ।\nप्रतिजन्मेह लभ्यंते काश्येका नैव लभ्यते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004097040, "chapter_id": 24097, "verse_number": "४-४६-४१", "content_sanskrit": "येन लब्धा पुरी काशी त्रैलोक्योद्धरणक्षमा ।\nत्रैलोक्यैश्वर्यदुष्प्रापं तेन लब्धं महासुखम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004097041, "chapter_id": 24097, "verse_number": "४-४६-४२", "content_sanskrit": "कुपितोपि हि मे रुद्रस्तेजोहानिं विधास्यति ।\nकाश्यां च लप्स्ये तत्तेजो यद्वै स्वात्मावबोधजम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004097042, "chapter_id": 24097, "verse_number": "४-४६-४३", "content_sanskrit": "इतराणीह तेजांसि भासंते तावदेव हि ।\nखद्योताभानि यावन्नो जृंभते काशिजं महः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004097043, "chapter_id": 24097, "verse_number": "४-४६-४४", "content_sanskrit": "इति काशीप्रभावज्ञो जगच्चक्षुस्तमोनुदः ।\nकृत्वा द्वादशधात्मानं काशीपुर्यां व्यवस्थितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004097044, "chapter_id": 24097, "verse_number": "४-४६-४५", "content_sanskrit": "लोलार्क उत्तरार्कश्च सांबादित्यस्तथैव च ।\nचतुर्थो द्रुपदादित्यो मयूखादित्य एव च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004097045, "chapter_id": 24097, "verse_number": "४-४६-४६", "content_sanskrit": "खखोल्कश्चारुणादित्यो वृद्धकेशवसंज्ञकौ ।\nदशमो विमलादित्यो गंगादित्यस्तथैव च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004097046, "chapter_id": 24097, "verse_number": "४-४६-४७", "content_sanskrit": "द्वादशश्च यमादित्यः काशिपुर्यां घटोद्भव ।\nतमोऽधिकेभ्यो दुष्टेभ्यः क्षेत्रं रक्षंत्यमी सदा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004097047, "chapter_id": 24097, "verse_number": "४-४६-४८", "content_sanskrit": "तस्यार्कस्य मनोलोलं यदासीत्काशिदर्शने ।\nअतो लोलार्क इत्याख्या काश्यां जाता विवस्वतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004097048, "chapter_id": 24097, "verse_number": "४-४६-४९", "content_sanskrit": "लोलार्कस्त्वसिसंभेदे दक्षिणस्यां दिशिस्थितः ।\nयोगक्षेमं सदा कुर्यात्काशीवासि जनस्य च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004097049, "chapter_id": 24097, "verse_number": "४-४६-५०", "content_sanskrit": "मार्गशीर्षस्य सप्तम्यां षष्ठ्यां वा रविवासरे ।\nविधाय वार्षिकीं यात्रां नरः पापै प्रमुच्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004097050, "chapter_id": 24097, "verse_number": "४-४६-५१", "content_sanskrit": "कृतानि यानि पापानि नरैः संवत्सरावधि ।\nनश्यंति क्षणतस्तानि षष्ठ्यर्के लोलदर्शनात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004097051, "chapter_id": 24097, "verse_number": "४-४६-५२", "content_sanskrit": "नरः स्नात्वासिसंभेदे संतर्प्य पितृदेवताः ।\nश्राद्धं विधाय विधिना पित्रानृण्यमवाप्नुयात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004097052, "chapter_id": 24097, "verse_number": "४-४६-५३", "content_sanskrit": "लोलार्कसंगमे स्नात्वा दानं होमं सुरार्चनम् ।\nयत्किंचित्क्रियते कर्म तदानंत्याय कल्पते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004097053, "chapter_id": 24097, "verse_number": "४-४६-५४", "content_sanskrit": "सूर्योपरागे लोलार्के स्नानदानादिकाः क्रियाः ।\nकुरुक्षेत्राद्दशगुणा भवंतीह न संशयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004097054, "chapter_id": 24097, "verse_number": "४-४६-५५", "content_sanskrit": "लोलार्के रथसप्तम्यां स्नात्वा गंगासिसंगमे ।\nसप्तजन्मकृतैः पापैर्मुक्तो भवति तत्क्षणात् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004097055, "chapter_id": 24097, "verse_number": "४-४६-५६", "content_sanskrit": "प्रत्यर्कवारं लोलार्कं यः पश्यति शुचिव्रतः ।\nन तस्य दुःखं लोकेस्मिन्कदाचित्संभविष्यति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004097056, "chapter_id": 24097, "verse_number": "४-४६-५७", "content_sanskrit": "न तस्य दुःखं नो पामा न दद्रुर्न विचर्चिका ।\nलोलार्कमर्के यः पश्येत्तत्पादोदकसेवकः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004097057, "chapter_id": 24097, "verse_number": "४-४६-५८", "content_sanskrit": "वाराणस्यामुषित्वापि यो लोलार्कं न सेवते ।\nसेवंते तं नरं नूनं क्लेशाः क्षुद्व्याधिसंभवाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004097058, "chapter_id": 24097, "verse_number": "४-४६-५९", "content_sanskrit": "सर्वेषां काशितीर्थानां लोलार्कः प्रथमं शिरः ।\nततोंऽगान्यन्यतीर्थानि तज्जलप्लावितानिहि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004097059, "chapter_id": 24097, "verse_number": "४-४६-६०", "content_sanskrit": "तीर्थांतराणि सर्वाणि भूमीवलयगान्यपि ।\nअसिसंभेदतीर्थस्य कलां नार्हंति षोडशीम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004097060, "chapter_id": 24097, "verse_number": "४-४६-६१", "content_sanskrit": "सर्वेषामेव तीर्थानां स्नानाद्यल्लभ्यते फलम् ।\nतत्फलं सम्यगाप्येत नरैर्गंगासिसंगमे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004097061, "chapter_id": 24097, "verse_number": "४-४६-६२", "content_sanskrit": "नार्थवादोयमुदितः स्तुतिवादो न वै मुने ।\nसत्यं यथार्थवादोयं श्रद्धेयः सद्भिरादरात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004097062, "chapter_id": 24097, "verse_number": "४-४६-६३", "content_sanskrit": "यत्र विश्वेश्वरः साक्षाद्यत्र स्वर्गतरंगिणी ।\nमिथ्या तत्रानुमन्यंते तार्किकाश्चानुसूयकाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004097063, "chapter_id": 24097, "verse_number": "४-४६-६४", "content_sanskrit": "उदाहरंति ये मूढाः कुतर्कबलदर्पिताः ।\nकाश्यां सर्वेर्थवादोयं ते विट्कीटा युगेयुगे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004097064, "chapter_id": 24097, "verse_number": "४-४६-६५", "content_sanskrit": "कस्यचित्काशितीर्थस्य महिम्नो महतस्तुलाम् ।\nनाधिरोहेन्मुने नूनमपि त्रैलोक्यमंडपः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004097065, "chapter_id": 24097, "verse_number": "४-४६-६६", "content_sanskrit": "नास्तिका वेदबाह्याश्च शिश्नोदरपरायणाः ।\nअंत्यजाताश्च ये तेषां पुरः काशी न वर्ण्यताम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004097066, "chapter_id": 24097, "verse_number": "४-४६-६७", "content_sanskrit": "लोलार्ककरनिष्टप्ता असिधार विखंडिताः ।\nकाश्यां दक्षिणदिग्भागे न विशेयुर्महामलाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004097067, "chapter_id": 24097, "verse_number": "४-४६-६८", "content_sanskrit": "महिमानमिमं श्रुत्वा लोलार्कस्य नरोत्तमः ।\nन दुःखी जायते क्वापि संसारे दुःखसागरे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004097068, "chapter_id": 24097, "verse_number": "४-४६-६९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंडे पूर्वार्द्धे लोलार्कवर्णनं नाम षट्चत्वारिंशोध्यायः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]