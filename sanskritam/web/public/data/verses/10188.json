[{"id": 6000188000, "chapter_id": 10188, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000188001, "chapter_id": 10188, "verse_number": "९-१३-१", "content_sanskrit": "ऐलस्य चोर्वशीगर्भात् षडासन्नात्मजा नृप।\nआयुः श्रुतायुः सत्यायू रयोऽथ विजयो जयः॥ ९/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.001.m4a", "display_order": 2, "topics": [{"text": "पुरूरवसः षट्पुत्राणां मध्ये श्रुतायुप्रभृतीनां पञ्चानां वंशकथनम्", "range": "१–२"}]}, {"id": 6000188002, "chapter_id": 10188, "verse_number": "९-१३-२", "content_sanskrit": "श्रुतायोर्वसुमान् पुत्रः सत्यायोश्च श्रुतञ्जयः।\nरयस्याद्भुत एकस्तु जयस्य तनयोऽमितः॥ ९/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.002.m4a", "display_order": 3}, {"id": 6000188003, "chapter_id": 10188, "verse_number": "९-१३-३", "content_sanskrit": "भीमस्तु विजयस्याथ काञ्चनो होत्रकस्ततः।\nतस्य जह्नुः सुतो गङ्गां गण्डूषीकृत्य योऽपिबत्॥ ९/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.003.m4a", "display_order": 4, "topics": [{"text": "तत्र विजयवंशे गाधिराजस्योत्पत्तिः", "range": "३–५"}]}, {"id": 6000188004, "chapter_id": 10188, "verse_number": "९-१३-४", "content_sanskrit": "जह्नोस्तु पूरुस्तत्पुत्रो बलाकश्चात्मजोऽजकः।\nततः कुशः कुशस्यापि कुशाम्बुस्तनयो वसुः॥ ९/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.004.m4a", "display_order": 5}, {"id": 6000188005, "chapter_id": 10188, "verse_number": "९-१३-५", "content_sanskrit": "कुशनाभश्च चत्वारो गाधिरासीत् कुशाम्बुजः॥ ९/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.005.m4a", "display_order": 6}, {"id": 6000188006, "chapter_id": 10188, "verse_number": "९-१३-६", "content_sanskrit": "तस्य सत्यवतीं कन्यामृचीकोऽयाचत द्विजः।\nवरं विसदृशं मत्वा गाधिर्भार्गवमब्रवीत्॥ ९/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.006.m4a", "display_order": 7, "topics": [{"text": "तस्य सत्यवतीनामकपुत्र्या उत्पत्तिः", "range": "६"}]}, {"id": 6000188007, "chapter_id": 10188, "verse_number": "९-१३-७", "content_sanskrit": "एकतः श्यामकर्णानां हयानां चन्द्रवर्चसाम्।\nसहस्रं दीयतां शुल्कं कन्यायाः कुशिकान्वयः॥ ९/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.007.m4a", "display_order": 8, "topics": [{"text": "गाधिदौहित्राज्जमदग्नेर्भगवदंशस्यपरशुरामस्योत्पत्तिः", "range": "७–१४"}]}, {"id": 6000188008, "chapter_id": 10188, "verse_number": "९-१३-८", "content_sanskrit": "इत्युक्तस्तन्मतं ज्ञात्वा गतः स वरुणान्तिकम्।\nआनीय दत्त्वा तानश्वानुपयेमे वराङ्गनाम्॥ ९/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.008.m4a", "display_order": 9}, {"id": 6000188009, "chapter_id": 10188, "verse_number": "९-१३-९", "content_sanskrit": "स ऋषिः प्रार्थितः पत्न्या श्वश्र्वा चापत्यकाम्यया।\nश्रपयित्वोभयैर्मन्त्रैश्चरुं स्नातुं गतो मुनिः॥ ९/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.009.m4a", "display_order": 10}, {"id": 6000188010, "chapter_id": 10188, "verse_number": "९-१३-१०", "content_sanskrit": "तावत् सत्यवती मात्रा स्वचरुं याचिता सती।\nश्रेष्ठं मत्वाऽनयाऽयच्छन्मात्रे मातुरदात् स्वयम्॥ ९/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.010.m4a", "display_order": 11}, {"id": 6000188011, "chapter_id": 10188, "verse_number": "९-१३-११", "content_sanskrit": "तद् विज्ञाय मुनिः प्राह पत्नीं कष्टमकारषीः।\nघोरो दण्डधरः पुत्रो भ्राता ते ब्रह्मवित्तमः॥ ९/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.011.m4a", "display_order": 12}, {"id": 6000188012, "chapter_id": 10188, "verse_number": "९-१३-१२", "content_sanskrit": "प्रसादितः सत्यवत्या मैवं भूदिति भार्गवः।\nअथ तर्हि भवेत् पौत्रो जमदग्निस्ततोऽभवत्॥ ९/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.012.m4a", "display_order": 13}, {"id": 6000188013, "chapter_id": 10188, "verse_number": "९-१३-१३", "content_sanskrit": "सा चाभूत् सुमहापुण्या कौशिकी लोकपावनी।\nरेणोः सुतां रेणुकां वै जमदग्निरुवाह याम्॥ ९/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.013.m4a", "display_order": 14}, {"id": 6000188014, "chapter_id": 10188, "verse_number": "९-१३-१४", "content_sanskrit": "तस्यां वै भार्गवऋषेः सुता वसुमदादयः।\nयवीयान् जज्ञ एतेषां राम इत्यभिविश्रुतः॥ ९/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.014.m4a", "display_order": 15}, {"id": 6000188015, "chapter_id": 10188, "verse_number": "९-१३-१५", "content_sanskrit": "यमाहुर्वासुदेवांशं हैहयानां कुलान्तकम्।\nत्रिःसप्तकृत्वो य इमां चक्रे निःक्षत्रियां महीम्॥ ९/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.015.m4a", "display_order": 16, "topics": [{"text": "परशुरामेण कार्तवीर्यार्जुनहननम्", "range": "१५–५१"}]}, {"id": 6000188016, "chapter_id": 10188, "verse_number": "९-१३-१६", "content_sanskrit": "दृप्तं क्षत्रं भुवो भारमब्रह्मण्यमधार्मिकम्।\nरजस्तमोधृतमहन् फल्गुन्यपि कृतेंऽहसि॥ ९/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.016.m4a", "display_order": 17}, {"id": 6000188017, "chapter_id": 10188, "verse_number": null, "content_sanskrit": "राजोवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.017.m4a", "display_order": 18}, {"id": 6000188018, "chapter_id": 10188, "verse_number": "९-१३-१७", "content_sanskrit": "किं तदंहो भगवतो राजन्यैरजितात्मभिः।\nकृतं येन कुलं नष्टं क्षत्रियाणामभीक्ष्णशः॥ ९/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.018.m4a", "display_order": 19}, {"id": 6000188019, "chapter_id": 10188, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.019.m4a", "display_order": 20}, {"id": 6000188020, "chapter_id": 10188, "verse_number": "९-१३-१८", "content_sanskrit": "हैहयानामधिपतिरर्जुनः क्षत्रियर्षभः।\nदत्तं नारायणस्यांशमाराध्य परिकर्मभिः॥ ९/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.020.m4a", "display_order": 21}, {"id": 6000188021, "chapter_id": 10188, "verse_number": "९-१३-१९", "content_sanskrit": "बाहून् दशशतं लेभे दुर्धर्षत्वमरातिषु।\nअव्याहतेन्द्रियौजश्रीतेजोवीर्ययशोबलम्॥ ९/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.021.m4a", "display_order": 22}, {"id": 6000188022, "chapter_id": 10188, "verse_number": "९-१३-२०", "content_sanskrit": "योगेश्वरत्वमैश्वर्यं गुणा यत्राणिमादयः।\nचचाराव्याहतगतिर्लोकेषु पवनो यथा॥ ९/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.022.m4a", "display_order": 23}, {"id": 6000188023, "chapter_id": 10188, "verse_number": "९-१३-२१", "content_sanskrit": "स्‍त्रीरत्नैरावृतः क्रीडन् रेवाम्भसि मदोत्कटः।\nवैजयन्तीं स्रजं बिभ्रद् रुरोध सरितं भुजैः॥ ९/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.023.m4a", "display_order": 24}, {"id": 6000188024, "chapter_id": 10188, "verse_number": "९-१३-२२", "content_sanskrit": "विप्लावितं स्वशिबिरं प्रतिस्रोतःसरिज्जलैः।\nनामृष्यत् तस्य तद्वीर्यं वीरमानी दशाननः॥ ९/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.024.m4a", "display_order": 25}, {"id": 6000188025, "chapter_id": 10188, "verse_number": "९-१३-२३", "content_sanskrit": "गृहीतो लीलया स्‍त्रीणां समक्षं कृतकिल्बिषः।\nमाहिष्मत्यां सन्निरुद्धो मुक्तो येन कपिर्यथा॥ ९/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.025.m4a", "display_order": 26}, {"id": 6000188026, "chapter_id": 10188, "verse_number": "९-१३-२४", "content_sanskrit": "स एकदा तु मृगयां विचरन् विजने वने।\nयदृच्छयाऽऽश्रमपदं जमदग्नेरुपाविशत्॥ ९/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.026.m4a", "display_order": 27}, {"id": 6000188027, "chapter_id": 10188, "verse_number": "९-१३-२५", "content_sanskrit": "तस्मै स नरदेवाय मुनिरर्हणमाहरत्।\nससैन्यामात्यवाहाय हविर्धान्या तपोधनः॥ ९/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.027.m4a", "display_order": 28}, {"id": 6000188028, "chapter_id": 10188, "verse_number": "९-१३-२६", "content_sanskrit": "स वीरस्तस्य तद् दृष्ट्वा आत्मैश्वर्यातिशायिनम्।\nतन्नाद्रियन्नग्निहोत्रीं साभिलाषः स हैहयः॥ ९/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.028.m4a", "display_order": 29}, {"id": 6000188029, "chapter_id": 10188, "verse_number": "९-१३-२७", "content_sanskrit": "हविर्धानीमृषेर्दर्पान्नरान् हर्तुमयोजयत्।\nतां ते माहिष्मतीं निन्युः सवत्सां क्रन्दतीं बलात्॥ ९/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.029.m4a", "display_order": 30}, {"id": 6000188030, "chapter_id": 10188, "verse_number": "९-१३-२८", "content_sanskrit": "अथ राजनि निर्याते राम आश्रम आगतः।\nश्रुत्वा तत् तस्य दौरात्म्यं चुक्रोधाहिरिवाहतः॥ ९/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.030.m4a", "display_order": 31}, {"id": 6000188031, "chapter_id": 10188, "verse_number": "९-१३-२९", "content_sanskrit": "परशुं योजयामास सतूणं चर्म कार्मुकम्।\nअन्वधावत दुर्धर्षो मृगेन्द्र इव यूथपम्॥ ९/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.031.m4a", "display_order": 32}, {"id": 6000188032, "chapter_id": 10188, "verse_number": "९-१३-३०", "content_sanskrit": "तमापतन्तं भृगुवर्यमोजसा धनुर्धरं बाणपरश्वधायुधम्।\nऐणेयचर्माम्बरमात्मधामभिर्युतं जटाभिर्ददृशे पुरीं नृपः॥ ९/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.032.m4a", "display_order": 33}, {"id": 6000188033, "chapter_id": 10188, "verse_number": "९-१३-३१", "content_sanskrit": "अचोदयद्धस्तिवरांश्च पत्तिभिर्गदासिबाणर्ष्टिशतघ्निशक्तिभिः।\nअक्षौहिणीः सप्तदशातिभीषणास्ता राम एको भगवानसूदयत्॥ ९/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.033.m4a", "display_order": 34}, {"id": 6000188034, "chapter_id": 10188, "verse_number": "९-१३-३२", "content_sanskrit": "यतो यतोऽसौ प्रहरन् परश्वधो मनोनिलौजाः परचक्रसूदनः।\nततस्ततश्छिन्नभुजोरुकन्धरा निपेतुरुर्व्यां हतसूतवाहनाः॥ ९/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.034.m4a", "display_order": 35}, {"id": 6000188035, "chapter_id": 10188, "verse_number": "९-१३-३३", "content_sanskrit": "दृष्ट्वा स्वसैन्यं रुधिरौघकर्दमे रणाजिरे रामकुठारसायकैः।\nविवृक्णचर्मध्वजचापविग्रहं निपातितं हैहय आपतद् रुषा॥ ९/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.035.m4a", "display_order": 36}, {"id": 6000188036, "chapter_id": 10188, "verse_number": "९-१३-३४", "content_sanskrit": "अथार्जुनः पञ्चशतेषु बाहुभिर्धनुष्षु बाणान् युगपत् स सन्दधे।\nरामाय रामोऽस्‍त्रभृतां समग्रणीस्तानेकबद्धेषुभिरच्छिनत् समम्॥ ९/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.036.m4a", "display_order": 37}, {"id": 6000188037, "chapter_id": 10188, "verse_number": "९-१३-३५", "content_sanskrit": "पुनः स्वहस्तैरचलान् मृधेऽङ्घ्रिपानुत्क्षिप्य वेगादभिधावतो युधि।\nभुजान् कुठारेण कठोरनेमिना चिच्छेद रामः प्रसभं हसन्निव॥ ९/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.037.m4a", "display_order": 38}, {"id": 6000188038, "chapter_id": 10188, "verse_number": "९-१३-३६", "content_sanskrit": "कृन्तबाहोः शिरस्तस्य गिरिशृङ्गमिवाहरत्।\nहते पितरि तत्पुत्रा अयुतं दुद्रुवुर्भयात्॥ ९/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.038.m4a", "display_order": 39}, {"id": 6000188039, "chapter_id": 10188, "verse_number": "९-१३-३७", "content_sanskrit": "अग्निहोत्रीमुपावृत्य सवत्सां परवीरहा।\nसमुपेत्याश्रमं पित्रे परिक्लिष्टां समार्पयत्॥ ९/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.039.m4a", "display_order": 40}, {"id": 6000188040, "chapter_id": 10188, "verse_number": "९-१३-३८", "content_sanskrit": "स्वकर्म तत्कृतं रामः पित्रे भ्रातृभ्य एव च। वर्णयामास तच्छ्रुत्वा जमदग्निरभाषत।\nराम राम महाबाहो भवान् पापमकारषीत्॥ ९/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.040.m4a", "display_order": 41}, {"id": 6000188041, "chapter_id": 10188, "verse_number": "९-१३-३९", "content_sanskrit": "अवधीर्नरदेवं यत् सर्वदेवमयं वृथा।\nवयं हि ब्राह्मणास्तात क्षमयाऽर्हणतां गताः॥ ९/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.041.m4a", "display_order": 42}, {"id": 6000188042, "chapter_id": 10188, "verse_number": "९-१३-४०", "content_sanskrit": "यथा लोकगुरुर्देवः पारमेष्ठ्यमगात् पदम्। क्षमया रोचते लक्ष्मीः ब्राह्मी सौरी यथा प्रभा।\nक्षमिणामाशु भगवांस्तुष्यते हरिरीश्वरः॥ ९/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.042.m4a", "display_order": 43}, {"id": 6000188043, "chapter_id": 10188, "verse_number": "९-१३-४१", "content_sanskrit": "राज्ञो मूर्धावसिक्तस्य वधो ब्रह्मवधाद् गुरुः।\nतीर्थसंसेवया चांहो जह्यङ्गाच्युतचेतनः॥ ९/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_013/BhP_09.013.043.m4a", "display_order": 44}, {"id": 6000188044, "chapter_id": 10188, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]