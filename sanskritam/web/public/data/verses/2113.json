[{"id": 2050787, "chapter_id": 2113, "verse_number": "७-४०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050788, "chapter_id": 2113, "verse_number": "७-४०-१", "content_sanskrit": "`ततः समभवद्युद्धं तयोः पुरुषसिंहयोः।\nतस्मिन्काले महाबाहुः सौभद्रः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050789, "chapter_id": 2113, "verse_number": "७-४०-२", "content_sanskrit": "सशरं कार्मुकं छित्त्वा लाघवेन व्यपातयत्।\nदुःशासनं शरैस्तीक्ष्णैः संततक्ष समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050790, "chapter_id": 2113, "verse_number": "७-४०-३", "content_sanskrit": "शरविक्षतगात्रं तु प्रत्यमित्रमवस्थितम्।\nअभिमन्युः स्मयन्धीमान्दुःशासनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050791, "chapter_id": 2113, "verse_number": "७-४०-४", "content_sanskrit": "दिष्ट्या पश्यामि सङ्ग्रमे मानिनं शूरमागतम्।\nनिष्ठुरं त्यक्तधर्माणमाक्रोशनपरायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050792, "chapter_id": 2113, "verse_number": "७-४०-५", "content_sanskrit": "यत्सभायां त्वया राज्ञो धृतराष्ट्रस्य शृण्वतः।\nकोपितः परुषैर्वाक्यैर्धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050793, "chapter_id": 2113, "verse_number": "७-४०-६", "content_sanskrit": "जयोन्मत्तेन भीमश्च बह्वबद्धं प्रभाषितः।\nअक्षकूटं समाश्रित्य सौबलस्यात्मनो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050794, "chapter_id": 2113, "verse_number": "७-४०-७", "content_sanskrit": "तत्त्वयेदमनुप्राप्तं तस्य कोपान्महात्मनः।\nपरवित्तापहारस्य कोधस्याप्रशमस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050795, "chapter_id": 2113, "verse_number": "७-४०-८", "content_sanskrit": "लोभस्य ज्ञाननाशस्य द्रोहस्यात्याहितस्य च।\nपितॄणां मम राज्यस्य हरणस्योग्रधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050796, "chapter_id": 2113, "verse_number": "७-४०-९", "content_sanskrit": "तत्त्वयेदमनुप्राप्तं प्रकोपाद्वै महात्मनाम्।\nस तस्योग्रमधर्मस्य फलं प्राप्नुहि दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050797, "chapter_id": 2113, "verse_number": "७-४०-१०", "content_sanskrit": "शासिताऽस्म्यद्य ते बाणैः सर्वसैन्यस्य पश्यतः।\nअद्याहमनृणस्तस्य कोपस्य भविता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050798, "chapter_id": 2113, "verse_number": "७-४०-११", "content_sanskrit": "अमर्षितायाः कृष्णायाः काङ्क्षितस्य च मे पितुः।\nअद्य कौरव्य भीमस्य भवितास्म्यनृणो युधि।\nन हि मे मोक्ष्यसे जीवन्यदि नोत्सृजसे रणं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050799, "chapter_id": 2113, "verse_number": "७-४०-१२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050800, "chapter_id": 2113, "verse_number": "७-४०-१२", "content_sanskrit": "एवमुक्त्वा महाबाहुर्बाणं दुःशासनान्तकम्।\nसंदधे परवीरघ्नः कालाग्न्यनिलवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050801, "chapter_id": 2113, "verse_number": "७-४०-१३", "content_sanskrit": "तस्योरस्तूर्णमासाद्य जत्रुदेशे विभिद्य तम्।\nजगाम सह पुङ्खेन वल्मीकमिव पन्नगः।\nअथैनं पञ्चविंशत्या पुनरेव समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050802, "chapter_id": 2113, "verse_number": "७-४०-१४", "content_sanskrit": "शरैरग्निसमस्पर्शैराकर्णसमचोदितैः।\nस गाढविद्धो व्यथितो रथोपस्थ उपाविशत्।\nदुःशासनो महाराज कश्मलं चाविशन्महत्॥\nसारथिस्त्वरमाणस्तु दुःशासनमचेतनम्।\nरणमध्यादपोवाह सौभद्रशरपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050803, "chapter_id": 2113, "verse_number": "७-४०-१६", "content_sanskrit": "पाण्डवा द्रौपदेयाश्च विराटश्च समीक्ष्य तम्।\nपाञ्चालाः केकयाश्चैव सिंहनादमथानदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050804, "chapter_id": 2113, "verse_number": "७-४०-१७", "content_sanskrit": "वादित्राणि च सर्वाणि नानालिङ्गानि सर्वशः।\nप्रावादयन्त संहृष्टाः पाण्डूनां तत्र सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050805, "chapter_id": 2113, "verse_number": "७-४०-१८", "content_sanskrit": "अपश्यन्स्मयमानाश्च सौभद्रस्य विचेष्टितम्।\nअत्यन्तवैरिणं दृप्तं दृष्ट्वा शत्रुं पराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050806, "chapter_id": 2113, "verse_number": "७-४०-१९", "content_sanskrit": "धर्ममारुतशक्राणामश्विनोः प्रतिमास्तथा।\nधारयन्तो ध्वजाग्रेषु द्रौपदेया महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050807, "chapter_id": 2113, "verse_number": "७-४०-२०", "content_sanskrit": "सात्यकिश्चेकितानश्च धृष्टद्युम्नशिखण्डिनौ।\nकेकया धृष्टकेतुश्च मात्स्याः पाञ्चालसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050808, "chapter_id": 2113, "verse_number": "७-४०-२१", "content_sanskrit": "पाण्डवाश्च मुदा युक्ता युधिष्ठिरपुरोगमाः।\nअभ्यद्रवन्त त्वरिता द्रोणानीकं बिभित्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050809, "chapter_id": 2113, "verse_number": "७-४०-२२", "content_sanskrit": "ततोऽभवन्महायुद्धं त्वदीयानां परैः सह।\nजयमाकाङ्क्षमाणानां शूराणामनिवर्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050810, "chapter_id": 2113, "verse_number": "७-४०-२३", "content_sanskrit": "तथा तु वर्तमाने वै सङ्ग्रामेऽतिभयंकरे।\nदुर्योधनो महाराज राधेयमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050811, "chapter_id": 2113, "verse_number": "७-४०-२४", "content_sanskrit": "पश्य दुःशासनं वीरमभिमन्युवशंगतम्।\nप्रतपन्तमिवादित्यं निघ्नन्तं शात्रवान्रणे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050812, "chapter_id": 2113, "verse_number": "७-४०-२५", "content_sanskrit": "अथ चैते सुसंरब्धाः सिंहा इव बलोत्कटाः।\nसौभद्रमुद्यतास्त्रातुमभ्यधावन्त पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050813, "chapter_id": 2113, "verse_number": "७-४०-२६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050814, "chapter_id": 2113, "verse_number": "७-४०-२६", "content_sanskrit": "ततः कर्णः शरैस्तीक्ष्णैरभिमन्युं दुरासदम्।\nअभ्यवर्षत सङ्क्रुद्धः पुत्रस्य हितकृत्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050815, "chapter_id": 2113, "verse_number": "७-४०-२७", "content_sanskrit": "तस्य चानुचरांस्तीक्ष्णैर्विव्याघ परमेषुभिः।\nअवज्ञापूर्वकं शूरः सौभद्रस्य परणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050816, "chapter_id": 2113, "verse_number": "७-४०-२८", "content_sanskrit": "अभिमन्युस्तु राधेयं त्रिसप्तत्या शिलीमुखैः।\nअविध्यत्त्वरितो राजन्द्रोणं प्रेप्सुर्महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2050817, "chapter_id": 2113, "verse_number": "७-४०-२९", "content_sanskrit": "तं तथा नाशकत्कश्चिद्दोणाद्वारयितुं रथी।\nआरुजन्तं रथव्रातान्वज्रहस्तात्मजात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2050818, "chapter_id": 2113, "verse_number": "७-४०-३०", "content_sanskrit": "ततः कर्णो जयप्रेप्सुर्मानी सर्वधनुष्मताम्।\nसौभद्रं शतशोऽविध्यदुत्तमास्त्राणि दर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2050819, "chapter_id": 2113, "verse_number": "७-४०-३१", "content_sanskrit": "सोऽस्त्रैरस्त्रविदां श्रेष्ठो रामशिष्यः प्रतापवान्।\nसमरे शत्रुदुर्धर्षमभिमन्युमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2050820, "chapter_id": 2113, "verse_number": "७-४०-३२", "content_sanskrit": "स तथा पीड्यमानस्तु राधेयेनास्त्रवृष्टिभिः।\nसमरेऽमरसङ्काशः सौभद्रो न व्यशीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2050821, "chapter_id": 2113, "verse_number": "७-४०-३३", "content_sanskrit": "ततः शिलाशितैस्तीक्ष्णैर्भल्लैरानतपर्वभिः।\nछित्त्वा धनूंषि शूराणामार्जुनिः कर्णमार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2050822, "chapter_id": 2113, "verse_number": "७-४०-३४", "content_sanskrit": "धनुर्मण्डलनिर्मुक्तैः शरैराशीविषोपमैः।\nसच्छत्रध्वजयन्तारं साश्वमाशु स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2050823, "chapter_id": 2113, "verse_number": "७-४०-३५", "content_sanskrit": "कर्णोऽपि चास्य चिक्षेप बाणान्सन्नतपर्वणः।\nअसम्ब्रान्तश्च तान्सर्वानगृह्णात्फल्गुनात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2050824, "chapter_id": 2113, "verse_number": "७-४०-३६", "content_sanskrit": "ततो मुहूर्तात्कर्णस्य बाणेनैकेन वीर्यवान्।\nसध्वजं कार्मुकं वीरश्छित्त्वा भूमावपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2050825, "chapter_id": 2113, "verse_number": "७-४०-३७", "content_sanskrit": "ततः कृच्छ्रगतं कर्णं दृष्ट्वा कर्णादनन्तरः।\nसौभद्रमभ्ययात्तूर्णं दृढमुद्यम्य कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2050826, "chapter_id": 2113, "verse_number": "७-४०-३८", "content_sanskrit": "तत उच्चुक्रुशुः पार्थास्तेषां चानुचरा जनाः।\nवादित्राणि च सञ्जघ्नः सौभद्रं चापि तुष्टुवुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2050827, "chapter_id": 2113, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे चत्वारिंशोऽध्यायः॥ ४० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-४०-८ अत्याहितस्य जीवानपेक्षकर्मणः। साहसस्येतियावत्॥ ५-४०-४० चत्वारिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]