[{"id": 36000000, "chapter_id": 8143, "verse_number": "1.0.1", "content_sanskrit": "ओंकारार्थाय तत्त्वाय वाच्यवाचकशक्तये । ब्रह्मसंज्ञाय पूर्वेषां गुरूणां गुरवे नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 36000001, "chapter_id": 8143, "verse_number": "1.0.2", "content_sanskrit": "प्रकाश्याष्टविधं लिङ्गं निर्लिङ्गं वचनानि च । वैजयन्तीति विख्यातं क्रियते नामशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 36000002, "chapter_id": 8143, "verse_number": "1.0.3", "content_sanskrit": "स्त्रीपुन्नपुंसकं लिङ्गं संकीर्णं तच्च पञ्चधा । नृस्त्री नृषण्डषण्डस्त्री त्रिलिङ्गं वाच्यलिङ्गकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 36000003, "chapter_id": 8143, "verse_number": "1.0.4", "content_sanskrit": "समासलिङ्गाद्विधृतः साहचर्यात् पृथक्कृतेः । लिङ्गं विद्यात् प्रयोगाच्च क्तिन् सर्वत्रापि च स्त्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 36000004, "chapter_id": 8143, "verse_number": "1.0.5", "content_sanskrit": "यत्प्रवृत्तं समासस्य लिङ्गं तत्स्यात् समासिनाम् । विशेषविहितः क्वापि लिङ्गं तत्राप्ययं क्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 36000005, "chapter_id": 8143, "verse_number": "1.0.6", "content_sanskrit": "स्त्रीलिङ्गे स्त्रीत्ययं शब्दः पुंलिङ्गे ना पुमानिति । षण् क्लीबपुमिति क्लीबे ये च षण्डार्थवाचिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 36000006, "chapter_id": 8143, "verse_number": "1.0.7", "content_sanskrit": "त्रिष्वित्युक्तिर्वाच्यलिङ्गे त्रयीशब्दस्त्रिलिङ्गके । अस्त्रीत्यादि निषेधेषु नृषण्डादीतरद्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 36000007, "chapter_id": 8143, "verse_number": "1.0.8", "content_sanskrit": "ज्ञातैर्लिङ्गैः साहचर्यात् क्वचित् स्याल्लिङ्गनिश्चयः । एकत्र सब पुंलिङ्गाः स्त्रियोऽन्यत्रान्यतो नपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 36000008, "chapter_id": 8143, "verse_number": "1.0.9", "content_sanskrit": "इत्येकस्यापि पर्याया लिङ्गायात्र पृथक्कृताः । प्रयोगात् प्रायशो लिङ्गमुदन्तः संशये पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 36000009, "chapter_id": 8143, "verse_number": "1.0.10", "content_sanskrit": "सन्दिग्धद्विवचोऽन्तं स्त्री ना स्याद्बहुवचोऽन्तकम् । समासे स्युः पृथक् सर्वे शब्दा बहुवचोऽन्तके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 36000010, "chapter_id": 8143, "verse_number": "1.0.11", "content_sanskrit": "न पूर्वशब्दभागत्र पुनस्त्वन्तमथादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 36000011, "chapter_id": 8143, "verse_number": "1.1.1", "content_sanskrit": "स्वर्गो नाकः सुरावास ऊर्ध्वलोकः फलोदयः । सौरिको भोगभूमिः स्त्री दिवि द्यौश्च त्रिविष्टपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 36000012, "chapter_id": 8143, "verse_number": "1.1.2", "content_sanskrit": "अमर्त्यभवनं गौश्च त्रिदिवः स्यात्स्वरव्ययम् । देवा निलिम्पा मरुतो गीर्वाणा वायुनाः सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 36000013, "chapter_id": 8143, "verse_number": "1.1.3", "content_sanskrit": "आदित्या ऋभवोऽस्वप्ना विवस्वन्तो दिवौकसः । आदिदेवा दिविषदो लेखा अदितिनन्दनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 36000014, "chapter_id": 8143, "verse_number": "1.1.4", "content_sanskrit": "सुपर्वाणः क्रतुभुजो निर्जरा अमृताशनाः । बहिर्मुखा विटपत्यस्त्रिदशा हन्ययोनयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 36000015, "chapter_id": 8143, "verse_number": "1.1.5", "content_sanskrit": "अमर्त्याश्चाथ न स्त्री स्याद्दैवतं देवता स्त्रियाम् । त्रय एवादिदेवाः स्युर्ब्रह्मविष्णुमहेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 36000016, "chapter_id": 8143, "verse_number": "1.1.6", "content_sanskrit": "आजानजाः स्वतोदेवाः कर्मदेवास्तु कर्मभिः । ब्रह्मा विधाता विश्वात्मा धाता स्रष्टा प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 36000017, "chapter_id": 8143, "verse_number": "1.1.7", "content_sanskrit": "हिरण्यगर्भो द्रुहिणो विरिञ्चः कश्चतुर्मुखः । पद्मनाभः सुरज्येष्ठश्चिरजीवी सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 36000018, "chapter_id": 8143, "verse_number": "1.1.8", "content_sanskrit": "शतानन्दः शतधृतिः स्वयंभूः सर्वतोमुखः । परमेष्ठी विश्वरेताः पुरुषो हंसवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 36000019, "chapter_id": 8143, "verse_number": "1.1.9", "content_sanskrit": "पद्मभूः प्राणदो वेधा द्रुघणो नाभिजो विधिः । वाग्वाणी भारती भाषा गीर्गीर्ब्राह्मी सरस्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 36000020, "chapter_id": 8143, "verse_number": "1.1.10", "content_sanskrit": "विष्णुर्नारायणो बभ्रुश्चक्रपाणिर्जनार्दनः । दैत्यारिः पुण्डरीकाक्षस्त्रिककुद्दिष्टरश्रवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 36000021, "chapter_id": 8143, "verse_number": "1.1.11", "content_sanskrit": "पीताम्बरो हृषीकेशो विष्वक्सेनश्चतुर्भुजः । श्रीवत्सः श्रीपतिः शार्ङ्गी श्रीवत्साङ्कोऽच्युतो हुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 36000022, "chapter_id": 8143, "verse_number": "1.1.12", "content_sanskrit": "वासुदेवः स्वभूश्चक्री वैकुण्ठः पुरुषोत्तमः । अरिष्टनेमिरजितः श्रीधरो यज्ञपूरुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 36000023, "chapter_id": 8143, "verse_number": "1.1.13", "content_sanskrit": "मुञ्जकेशी मुररिपुर्गदापाणिरधोऽक्षजः । अनन्तशायी वृन्दाको मुकुन्दो धरणीधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 36000024, "chapter_id": 8143, "verse_number": "1.1.14", "content_sanskrit": "शतानन्दः शतावर्ती युगावर्तः सुरोत्तमः । कालकुन्थो रन्तिदेवः केशवो गरुडध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 36000025, "chapter_id": 8143, "verse_number": "1.1.15", "content_sanskrit": "पद्मनाभो विश्वरूपः कृष्णो हरिरसंपुषः । कैटभारिर्ब्रह्मनाभो गोविन्दो मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 36000026, "chapter_id": 8143, "verse_number": "1.1.16", "content_sanskrit": "आचारा वैष्णवी सूक्ष्मा लक्ष्मीः पुष्टिर्निरञ्जना । जीवनी मोहनी माया नवैता विष्णुशक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 36000027, "chapter_id": 8143, "verse_number": "1.1.17", "content_sanskrit": "कौस्तुभोऽस्य मणिर्लक्ष्म श्रीवत्सो नन्दकस्त्वसिः । चापः शार्ङ्गं पाञ्चजन्यः शङ्खश्चक्रं सुदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 36000028, "chapter_id": 8143, "verse_number": "1.1.18", "content_sanskrit": "कौमोदकी गदाऽथास्य मत्स्याद्यैः समनामकाः । अवतारा नृसिंहस्तु हिरण्यकशिपुद्विषन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 36000029, "chapter_id": 8143, "verse_number": "1.1.19", "content_sanskrit": "उपेन्द्र इन्द्रावरजो वामनो बलिकण्टकः । आदित्यो द्विपदस्ताक्ष्योंस्त्रिविक्रम उरुक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 36000030, "chapter_id": 8143, "verse_number": "1.1.20", "content_sanskrit": "विष्णुश्च जामदग्न्यस्तु रामो दाशरथिः पुनः । राघवो जानकीकान्तो रामो रावणसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 36000031, "chapter_id": 8143, "verse_number": "1.1.21", "content_sanskrit": "दूषणारिः खरारिश्च कुम्भकर्णारिरेव च । राक्षसघ्नः सुखकरः कौसल्यानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 36000032, "chapter_id": 8143, "verse_number": "1.1.22", "content_sanskrit": "पार्थिवेन्द्रो धनुष्पाणिर्बलिर्दाशरथात्मजः । रामः संकर्षणः पौरो बलदेवो हलायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 36000033, "chapter_id": 8143, "verse_number": "1.1.23", "content_sanskrit": "बलभद्रः प्रलम्बारिः कालिन्दीकर्षणो हली । तालाङ्को रेवतीकान्तः सात्त्वतो मुसली बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 36000034, "chapter_id": 8143, "verse_number": "1.1.24", "content_sanskrit": "भद्राङ्को भद्रवदनः कामपालः सितासितः । बलो नीलाम्बरश्चाथ तस्य संवर्तकं हलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 36000035, "chapter_id": 8143, "verse_number": "1.1.25", "content_sanskrit": "सौनन्दमस्य मुसलं कृष्णो दामोदरोऽद्रिधृत् । दाशार्हो नरकारार्तिर्वनमाली गदाग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 36000036, "chapter_id": 8143, "verse_number": "1.1.26", "content_sanskrit": "शौनिः कंसरिपुः शौरिः सारथिस्तस्य दारुकः । वसुदेवोऽस्य जनको दुन्दुरानकदुन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 36000037, "chapter_id": 8143, "verse_number": "1.1.27", "content_sanskrit": "प्रद्युम्नो मन्मथः कामो मारो मनसिजः स्मरः । कन्दर्पो दर्पकोऽनङ्गो मीनाङ्को मकरध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 36000038, "chapter_id": 8143, "verse_number": "1.1.28", "content_sanskrit": "पुष्पधन्वा रतिपतिः शंबरारिरनन्यजः । शूर्पकारिर्मधुसखः पञ्चेषुर्विषमायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 36000039, "chapter_id": 8143, "verse_number": "1.1.29", "content_sanskrit": "बन्धुवामो जराभीरुहृच्छयो मधुसारथिः । ब्रह्मासूरनिरुद्धः स्यादृष्यकेतुरुषापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 36000040, "chapter_id": 8143, "verse_number": "1.1.30", "content_sanskrit": "अथान्ये ह्यवताराः स्युर्नरनारायणावृषी । अश्वो हयशिराः शेषः कपिलो व्यास इत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 36000041, "chapter_id": 8143, "verse_number": "1.1.31", "content_sanskrit": "दत्तात्रेयश्च कल्की च बुद्धश्चेत्येवमादयः । कपिलस्तु महाविष्णुर्व्यासः सत्यवतीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 36000042, "chapter_id": 8143, "verse_number": "1.1.32", "content_sanskrit": "पाराशर्यो द्वैपायनः कृष्णद्वैपायनोऽपि च । बुद्धस्तु श्रीघनः शास्ता बोधिसत्त्वो विनायकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 36000043, "chapter_id": 8143, "verse_number": "1.1.33", "content_sanskrit": "समन्तभद्रः सर्वज्ञो मारजिँल्लोकजिज्जिनः । षडभिज्ञो दशबलो धर्मराजस्तथागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 36000044, "chapter_id": 8143, "verse_number": "1.1.34", "content_sanskrit": "मुनीन्द्रः सुगतः शाक्यो मुनिरद्वयवाद्यपि । शाक्यसिंहस्तु सर्वार्थसिद्धः शौद्धोदनिर्गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 36000045, "chapter_id": 8143, "verse_number": "1.1.35", "content_sanskrit": "गौतमश्चार्कबन्धुश्च जिनस्त्वर्हन्त्रिकालदृक् । अष्टकर्मपरिभ्रष्टो वीतरागश्च केवली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 36000046, "chapter_id": 8143, "verse_number": "1.1.36", "content_sanskrit": "लक्ष्मीः पद्मालया शक्तिर्मा क्षीरोदसुतेन्दिरा । रमाब्धिजा भार्गवी च स्त्रीलिङ्गाश्चाम्बुजाह्वयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 36000047, "chapter_id": 8143, "verse_number": "1.1.37", "content_sanskrit": "गरुडः काश्यपसुतो गरुत्मानुरगाशनः । सुपर्णीतंनयस्ताक्षर्यो वैनतेयो महेन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 36000048, "chapter_id": 8143, "verse_number": "1.1.38", "content_sanskrit": "पन्नगारिविष्णुस्थः सुपर्णो विहगाधिपः । महेश्वरः पशुपतिः श्रीकण्ठः पांसुचन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}, {"id": 36000049, "chapter_id": 8143, "verse_number": "1.1.39", "content_sanskrit": "शङ्करो गिरिशो रुद्रो गिरीशः शशिभूषणः । महेश्वरश्चन्द्रमौलिः पिनाकी शशिशेखरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50, "avatarnika": ""}, {"id": 36000050, "chapter_id": 8143, "verse_number": "1.1.40", "content_sanskrit": "कपर्दी धूर्जटिः शर्वः कपाली नीललोहितः । ईश ईश्वर ईशानो भर्गो मृत्युञ्जयो मृडः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51, "avatarnika": ""}, {"id": 36000051, "chapter_id": 8143, "verse_number": "1.1.41", "content_sanskrit": "व्योमकेशो महादेवः प्रमथाधिपतिः शिवः । शूली दक्षाध्वरारातिः कामारिः परमेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52, "avatarnika": ""}, {"id": 36000052, "chapter_id": 8143, "verse_number": "1.1.42", "content_sanskrit": "कृत्तिवासा अहिर्बुध्न्यो नीलग्रीवस्त्रिलोचनः । गङ्गाधरो विरूपाक्षो वामदेवो वृषध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53, "avatarnika": ""}, {"id": 36000053, "chapter_id": 8143, "verse_number": "1.1.43", "content_sanskrit": "भूतेशः खण्डपरशुः स्थाणुरन्धकसूदनः । भगनेत्रान्तको भीमस्त्रिपुरारिर्मृगायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54, "avatarnika": ""}, {"id": 36000054, "chapter_id": 8143, "verse_number": "1.1.44", "content_sanskrit": "कटाटङ्को जटाटीरो जटाभाटो महानटः । झिण्डीकान्तो रेरिहाणः सर्वज्ञो नन्दिवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55, "avatarnika": ""}, {"id": 36000055, "chapter_id": 8143, "verse_number": "1.1.45", "content_sanskrit": "स्थालो डिण्डीश उड्डीशः कण्ठेकालो महाव्रतः । कृतानुरेता जोटिङ्गः कङ्कटीक उमापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56, "avatarnika": ""}, {"id": 36000056, "chapter_id": 8143, "verse_number": "1.1.46", "content_sanskrit": "खट्वाङ्गी मन्दरमणिरुलन्दो वृषवाहनः । उमः कटप्रुर्टिग्वासा भाण्डः षाण्डोऽकुतश्चनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57, "avatarnika": ""}, {"id": 36000057, "chapter_id": 8143, "verse_number": "1.1.47", "content_sanskrit": "बहुरूपोऽर्धमकुटो दशबाहुर्दशाव्ययः । ज्ञानं वैराग्यमैश्वर्यं तपः सत्यं क्षमा धृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58, "avatarnika": ""}, {"id": 36000058, "chapter_id": 8143, "verse_number": "1.1.48", "content_sanskrit": "परमेश्‍वरः शम्भुरीशो पशुपतिः शिवः । शूली महेश्वरश्चैव महादेवश्च शङ्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59, "avatarnika": ""}, {"id": 36000059, "chapter_id": 8143, "verse_number": "1.1.49", "content_sanskrit": "वामा ज्येष्ठा शिवा रौद्री चित्तोन्मादकरी सुखा । काली कलेवरा भूतदमनी चेशशक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60, "avatarnika": ""}, {"id": 36000060, "chapter_id": 8143, "verse_number": "1.1.50", "content_sanskrit": "कपर्दोऽस्य जटाजूटः खट्वाङ्गोऽस्य सुखङ्गगुणः । पिनाकोऽजगवं युग्ममजगावमजीगवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61, "avatarnika": ""}, {"id": 36000061, "chapter_id": 8143, "verse_number": "1.1.51", "content_sanskrit": "प्रमथाः स्युः पारिषदा नन्दी स्यान्नन्दिकेश्वरः । अथ कूष्माण्डकः केलिकिलो गणपतिप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62, "avatarnika": ""}, {"id": 36000062, "chapter_id": 8143, "verse_number": "1.1.52", "content_sanskrit": "भृङ्गरीटः पुनर्भूङ्गी चर्मो भृङ्गिरिटिः शला । वृषाणो लूनदोर्बाणो भेलुकस्तु कृतालकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63, "avatarnika": ""}, {"id": 36000063, "chapter_id": 8143, "verse_number": "1.1.53", "content_sanskrit": "वीरभद्रस्तु देवाजो विघ्नेशस्तु विनायकः । लम्बोदरो हस्तिराज एकदन्तो गजाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64, "avatarnika": ""}, {"id": 36000064, "chapter_id": 8143, "verse_number": "1.1.54", "content_sanskrit": "द्वैमातुरः परशुभृदाखुयानो गणाधिपः । कुमारः शरजः स्कन्दस्तारकारिरुमासुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65, "avatarnika": ""}, {"id": 36000065, "chapter_id": 8143, "verse_number": "1.1.55", "content_sanskrit": "महासेनो महातेजाः शक्तिपाणिर्गुहोऽग्निभूः । वैजयन्तः सिद्धसेनः सेनानीः शिखिवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66, "avatarnika": ""}, {"id": 36000066, "chapter_id": 8143, "verse_number": "1.1.56", "content_sanskrit": "स्वामो गाङ्गेयगौरेयब्रह्मचारिग्रहौजसः । षाण्मातुरः कार्त्तिकेयो ब्रह्मगर्भः षडाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67, "avatarnika": ""}, {"id": 36000067, "chapter_id": 8143, "verse_number": "1.1.57", "content_sanskrit": "सुब्रह्मण्यो नीलदंष्ट्रः क्रौञ्चारिः कुक्कुटध्वजः । अस्य शाखो विशाखश्च नैगमेषश्च पृष्ठजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68, "avatarnika": ""}, {"id": 36000068, "chapter_id": 8143, "verse_number": "1.1.58", "content_sanskrit": "उमा मेनात्मजा रौद्री रुद्राणी सर्वमङ्गला । आर्याऽद्रिजा महादेवी शर्वाणी पार्वती शिवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69, "avatarnika": ""}, {"id": 36000069, "chapter_id": 8143, "verse_number": "1.1.59", "content_sanskrit": "भ्रामरी रेवती षष्ठी गौतमी बाभ्रवी सती । अपर्णाऽपरुजा जारी शाण्डिली वारुणी हिमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70, "avatarnika": ""}, {"id": 36000070, "chapter_id": 8143, "verse_number": "1.1.60", "content_sanskrit": "बर्हिध्वजा शतमुखी योगिनी परमेष्ठिनी । सुनन्दा नन्दिनी नन्दा नन्दयन्ती कपालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71, "avatarnika": ""}, {"id": 36000071, "chapter_id": 8143, "verse_number": "1.1.61", "content_sanskrit": "कालरात्री महारात्री रक्तदन्त्येकपाटला । एकपर्णी भद्रकाली महाकाली करालिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72, "avatarnika": ""}, {"id": 36000072, "chapter_id": 8143, "verse_number": "1.1.62", "content_sanskrit": "दुर्गा कात्यायनी चण्डी कैटभी सिंहवाहना । यमेन्द्रकृष्णमैनाकरामाणां भगिनी स्वसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73, "avatarnika": ""}, {"id": 36000073, "chapter_id": 8143, "verse_number": "1.1.63", "content_sanskrit": "विन्ध्यमन्दरकान्तारमलयेष्वभ्र वासिनी । चर्ममुण्डा तु चामुण्डा चर्चा मार्जारकर्णिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74, "avatarnika": ""}, {"id": 36000074, "chapter_id": 8143, "verse_number": "1.1.64", "content_sanskrit": "कर्णमोटी महाचण्डी महागन्धा कपालिनी । ब्राह्मी माहेश्वरी चैन्द्री वाराही नारसिंह्यपि कौमारी वैष्णवी चेति ता एताः सप्त मातरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75, "avatarnika": ""}, {"id": 36000075, "chapter_id": 8143, "verse_number": "1.2.1", "content_sanskrit": "इन्द्रो दुश्च्यवनो वज्री वृत्रारिर्वासवो वृषा । वृद्धश्रवाः शुनासीरः सहस्राक्षो दिवस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76, "avatarnika": ""}, {"id": 36000076, "chapter_id": 8143, "verse_number": "1.2.2", "content_sanskrit": "वास्तोष्पतिर्बलरिपुः पुरुहूतः पुरन्दरः । मघवान् पूर्वदिक्पालः पृतनाषाट् सुराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77, "avatarnika": ""}, {"id": 36000077, "chapter_id": 8143, "verse_number": "1.2.3", "content_sanskrit": "संक्रन्दनो हरिहयो गोत्रभृत् पाकशासनः । पुलोमशत्रुर्हरिवानूर्ध्वधन्वा शचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78, "avatarnika": ""}, {"id": 36000078, "chapter_id": 8143, "verse_number": "1.2.4", "content_sanskrit": "कारुर्जम्भरिपुर्जिष्णुर्मरुत्वान् हरिवाहनः । स्वाराड्भुक्षः सुत्रामा विडौजाः सितकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79, "avatarnika": ""}, {"id": 36000079, "chapter_id": 8143, "verse_number": "1.2.5", "content_sanskrit": "भूरिश्रवाश्चित्ररथः सुनासीरो युधिष्ठिरः । परमन्युर्वज्रपाणिः शतमन्युर्विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80, "avatarnika": ""}, {"id": 36000080, "chapter_id": 8143, "verse_number": "1.2.6", "content_sanskrit": "आखण्डल उग्रधन्वा मेषाण्डोऽप्सरसां पतिः । खदिरो माहिरो दाल्मिः शयीचिर्विमुनो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81, "avatarnika": ""}, {"id": 36000081, "chapter_id": 8143, "verse_number": "1.2.7", "content_sanskrit": "गौरावस्कन्दिवन्दीकौ वारणो देवदुन्दुभिः । महेन्द्रो बाहुदन्तेयस्तुराषाड् वज्रदक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82, "avatarnika": ""}, {"id": 36000082, "chapter_id": 8143, "verse_number": "1.2.8", "content_sanskrit": "वृषण्वसु धनाद्यस्य पुराजः शान्तिकर्मकृत् । सुतो जयो जयन्तश्च जयदत्तोऽप्यथो सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83, "avatarnika": ""}, {"id": 36000083, "chapter_id": 8143, "verse_number": "1.2.9", "content_sanskrit": "जयन्ती देवनन्दी तु द्वाःस्थः सूतस्तु मातलिः । प्रासादो वैजयन्तोऽस्य वैजयन्तो ध्वजोऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84, "avatarnika": ""}, {"id": 36000084, "chapter_id": 8143, "verse_number": "1.2.10", "content_sanskrit": "अमरावत्यस्य पुरी स्यात् सुदर्शनमित्यपि । अश्वोऽस्य वृषणश्वः स्यादारा मस्त्वस्य नन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85, "avatarnika": ""}, {"id": 36000085, "chapter_id": 8143, "verse_number": "1.2.11", "content_sanskrit": "क्रीडासरो नन्दिसरः क्रीडाभूस्त्वस्य नन्दिका । पुलोमजा शचीन्द्राणी पौलोमी जयवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86, "avatarnika": ""}, {"id": 36000086, "chapter_id": 8143, "verse_number": "1.2.12", "content_sanskrit": "ऐरावतो राथन्तरिरभ्रनागोऽभ्रमुप्रियः । ऐरावणश्चतुर्दंष्ट्रः सूर्यभ्रातारिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87, "avatarnika": ""}, {"id": 36000087, "chapter_id": 8143, "verse_number": "1.2.13", "content_sanskrit": "अस्त्रियौ वज्रकुलिशौ भिदुरं शतधारकम् । व्याघामः पुंसि दम्भोलिः शतकोटिः पविर्भिदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88, "avatarnika": ""}, {"id": 36000088, "chapter_id": 8143, "verse_number": "1.2.14", "content_sanskrit": "वह्निर्वैश्वानरो घासिः कृष्णवर्त्मा समन्तभुक् । जातवेदा बृहद्भानुर्वीतिहोत्रस्तनूनपात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89, "avatarnika": ""}, {"id": 36000089, "chapter_id": 8143, "verse_number": "1.2.15", "content_sanskrit": "दहनो ज्वलनः शुष्मा रोहिताश्व उषर्बुधः । शोचिष्केशस्त्रिधामाऽग्निरुदर्चिः पावकोऽनलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90, "avatarnika": ""}, {"id": 36000090, "chapter_id": 8143, "verse_number": "1.2.16", "content_sanskrit": "सृदाकुर्भेरथः पीथो जुहुराणोषिराशिराः । तेजोऽप्पित्तमपांपित्तं स्वाहाऽग्नायी च तत्प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91, "avatarnika": ""}, {"id": 36000091, "chapter_id": 8143, "verse_number": "1.2.17", "content_sanskrit": "मन्त्रजिह्वः सप्तजिह्वः स्रुग्जिह्वो हव्यवाहनः । आश्रयाशो वातसखः कृशानुर्वातसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92, "avatarnika": ""}, {"id": 36000092, "chapter_id": 8143, "verse_number": "1.2.18", "content_sanskrit": "वमिर्भुजिः पचिः साचिश्छिरिर्बभ्रस्तिरश्चतिः । जागृविः सहुरिः सद्रिर्वमुना हवनो हवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93, "avatarnika": ""}, {"id": 36000093, "chapter_id": 8143, "verse_number": "1.2.19", "content_sanskrit": "सृदाकुर्भरथः पीथो जुहुराणोषिराशिराः । तेजोऽप्वित्तमपांपित्तं स्वाहाऽग्नायी च तत्प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94, "avatarnika": ""}, {"id": 36000094, "chapter_id": 8143, "verse_number": "1.2.20", "content_sanskrit": "स्कन्धाग्निः स्थूलकाष्ठाग्निर्मुर्मुरस्तु तुषानलः । छगणास्तु करीषाग्निर्मेघवह्रिरिरंमदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95, "avatarnika": ""}, {"id": 36000095, "chapter_id": 8143, "verse_number": "1.2.21", "content_sanskrit": "कुट्यग्निह्रिच्छयोऽथौर्वे द्वौ संवर्तकवाडवौ । सहरक्षा दवो दुभ्रस्तार्णे क्षामतरत्समौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96, "avatarnika": ""}, {"id": 36000096, "chapter_id": 8143, "verse_number": "1.2.22", "content_sanskrit": "क्रव्यात्तु प्रेतदाहाग्निर्देवाग्निर्हव्यवाहनः । सहरक्षस्तु दैत्यानां पितॄणां कव्यवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97, "avatarnika": ""}, {"id": 36000097, "chapter_id": 8143, "verse_number": "1.2.23", "content_sanskrit": "अपोनपात्तु यज्ञाग्निः क्रत्वग्निः स्यादपांनपात् । शुक्रान्वाहार्यपचनावध्वरे दक्षिणानिले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98, "avatarnika": ""}, {"id": 36000098, "chapter_id": 8143, "verse_number": "1.2.24", "content_sanskrit": "गार्हपत्यो गृहपतिः पवमानश्च पश्चिमे । शंस्य आहवनीयश्च पूर्वोऽग्निर्हव्यवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99, "avatarnika": ""}, {"id": 36000099, "chapter_id": 8143, "verse_number": "1.2.25", "content_sanskrit": "सभ्यावसथ्यौ तत्पूर्वावामुः स्यात् पाशुबन्धिकः । पृष्टिकृद्रतर्महोमेषु पदहोमेष्वनीकवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100, "avatarnika": ""}, {"id": 36000100, "chapter_id": 8143, "verse_number": "1.2.26", "content_sanskrit": "आधानादिष्वहस्तानः सुरभिर्यूपकर्मणि । ब्रह्मौदनाग्निर्भरतो यविष्ठः सवनाहुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101, "avatarnika": ""}, {"id": 36000101, "chapter_id": 8143, "verse_number": "1.2.27", "content_sanskrit": "महिमांसु विवाहम्रिर्वैश्वदेवाग्निरद्भुतः । व्रतान्ते बहुरन्नादः सुलभः पाकयज्ञिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102, "avatarnika": ""}, {"id": 36000102, "chapter_id": 8143, "verse_number": "1.2.28", "content_sanskrit": "सव्यस्तु मृतके वह्निरपसव्यस्तु सूतके । धूमस्तरिर्मेघवाही धूषोऽसौ गन्धवासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103, "avatarnika": ""}, {"id": 36000103, "chapter_id": 8143, "verse_number": "1.2.29", "content_sanskrit": "शिखा जिह्वार्चिरपुमान् कीला ज्वाला च मुस्रियोः । झलका तु महाज्वाला प्रवर्यो नीलकोऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104, "avatarnika": ""}, {"id": 36000104, "chapter_id": 8143, "verse_number": "1.2.30", "content_sanskrit": "सप्त जिह्वा पुनः काली कराली विष्फुलिङ्गिनी । धूम्रवर्णा विश्वरुचिर्लोहिता च मनोजवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105, "avatarnika": ""}, {"id": 36000105, "chapter_id": 8143, "verse_number": "1.2.31", "content_sanskrit": "त्रयी स्फुलिङ्गोऽपुसो ना खट्वाङ्गश्चाथ संज्वरः । सन्तापः स्यात्प्रकाशस्तु द्योत आलोक आतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106, "avatarnika": ""}, {"id": 36000106, "chapter_id": 8143, "verse_number": "1.2.32", "content_sanskrit": "दीप्ताग्रं काष्ठमुल्का स्यात् क्रमकऽलातमुल्मुकम् । अङ्गारोऽस्त्री प्रशान्तार्चिरिङ्गालः कारिकाम्रिविद् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107, "avatarnika": ""}, {"id": 36000107, "chapter_id": 8143, "verse_number": "1.2.33", "content_sanskrit": "भसितं भस्म भूतिः स्यादग्न्युत्पात उपाहितः । यमः पितृपतिर्दण्डधरो महिषवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108, "avatarnika": ""}, {"id": 36000108, "chapter_id": 8143, "verse_number": "1.2.34", "content_sanskrit": "यमराड् यमुनाभ्राता मन्दे वैवस्वतोऽन्तकः । सावित्रेयः श्राद्धदेवः समवर्ती परेतराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109, "avatarnika": ""}, {"id": 36000109, "chapter_id": 8143, "verse_number": "1.2.35", "content_sanskrit": "कालः कृतान्तः शमनः कीनाशो दक्षिणाधिपः । धर्मराजः पुराणान्तः कालकुन्थो विशीर्णपात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110, "avatarnika": ""}, {"id": 36000110, "chapter_id": 8143, "verse_number": "1.2.36", "content_sanskrit": "पत्नी यमस्य धूमोर्णा चित्रगुप्तस्तु लेखकः । पञ्जिका त्वग्रसन्धानी कालीची तु विचारभूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111, "avatarnika": ""}, {"id": 36000111, "chapter_id": 8143, "verse_number": "1.2.37", "content_sanskrit": "नरको नारकोऽप्येष निरयो दुर्गतिः स्त्रियाम् । अवीच्यन्ता रौरवाद्याः प्रायशो नरका नरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112, "avatarnika": ""}, {"id": 36000112, "chapter_id": 8143, "verse_number": "1.2.38", "content_sanskrit": "नारका जन्तवः प्रेता यात्या अप्यातिवाहिकाः । प्रेताः परेता वेताला गन्धर्वाः सत्त्वका ग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113, "avatarnika": ""}, {"id": 36000113, "chapter_id": 8143, "verse_number": "1.2.39", "content_sanskrit": "यातना कारणा दुःखं त्वामनस्यं प्रसूतिजम् । स्यात् कष्टं कृच्छ्रमाभीलं त्रिष्वेषां तद्वदर्थकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114, "avatarnika": ""}, {"id": 36000114, "chapter_id": 8143, "verse_number": "1.2.40", "content_sanskrit": "अथ रक्षांसि यातूनि राक्षसा अललोहिताः । रात्रिञ्चरा रात्रिचराः क्रव्यात्क्रव्यादनैर्ऋताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115, "avatarnika": ""}, {"id": 36000115, "chapter_id": 8143, "verse_number": "1.2.41", "content_sanskrit": "कैकसेया यातुधानाः पुरुषादाः प्रवाहिकाः । अनुषा विधुरा रक्तग्रहाः शङ्खव आशराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116, "avatarnika": ""}, {"id": 36000116, "chapter_id": 8143, "verse_number": "1.2.42", "content_sanskrit": "अलक्ष्मीर्निर्ऋतिर्ज्येष्ठा रावणस्तु दशाननः । दशास्यो विंशतिभुजश्चतुष्पान्मानमन्दिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117, "avatarnika": ""}, {"id": 36000117, "chapter_id": 8143, "verse_number": "1.2.43", "content_sanskrit": "लङ्केश्वरो यातुपतिः सन्नाहोऽस्य विचोलकः । चन्द्रहासस्तु खड्गोऽस्य क्रीडाभूस्त्वमरावली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118, "avatarnika": ""}, {"id": 36000118, "chapter_id": 8143, "verse_number": "1.2.44", "content_sanskrit": "अशोकवनिकोद्यानं त्रिशिराः समनीपदः । इन्द्रजिन्मेघनादः स्यात् प्रहस्तः स्यादलम्बुसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119, "avatarnika": ""}, {"id": 36000119, "chapter_id": 8143, "verse_number": "1.2.45", "content_sanskrit": "वरुणः शीतलो वामो दुन्दुभिः संवृतोऽप्पतिः । अम्बुवासोऽम्बुकान्तारः पाशी मकरवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120, "avatarnika": ""}, {"id": 36000120, "chapter_id": 8143, "verse_number": "1.2.46", "content_sanskrit": "प्रचेता यादसाम्नाथः प्रत्यगाशापतिस्तथा । जलभूषण उद्दामो गौरी तु वरुणप्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121, "avatarnika": ""}, {"id": 36000121, "chapter_id": 8143, "verse_number": "1.2.47", "content_sanskrit": "वातो वायुर्जगत्प्राणः शुषिलः श्वसनोऽनिलः । गन्धवाहो गन्धवहो मातरिश्वा समीरणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122, "avatarnika": ""}, {"id": 36000122, "chapter_id": 8143, "verse_number": "1.2.48", "content_sanskrit": "युजिनो लघुगो वातिर्ध्वजप्रहरणो जगत् । दैत्यदेवो वहः प्राणो नभः प्राणोऽङ्कतिः सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123, "avatarnika": ""}, {"id": 36000123, "chapter_id": 8143, "verse_number": "1.2.49", "content_sanskrit": "आशुगः पवनः स्पर्शः पवमानः प्रभञ्जनः । मरुद्दधृगिष्वजो मर्कः समीरोऽग्रिसखश्चलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124, "avatarnika": ""}, {"id": 36000124, "chapter_id": 8143, "verse_number": "1.2.50", "content_sanskrit": "शुष्मिर्महाबलो वेगी नभोजातः सदागतिः । नभस्वान् मारुतः शीघ्रः पृषदश्वः प्रकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125, "avatarnika": ""}, {"id": 36000125, "chapter_id": 8143, "verse_number": "1.2.51", "content_sanskrit": "सङ्क्रावातः सवृष्टिः स्याद्व्रात्या वातस्तु मण्डली । मृदुवातश्शिश्ञिलिको लेहा लिट् सौरतोऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126, "avatarnika": ""}, {"id": 36000126, "chapter_id": 8143, "verse_number": "1.2.52", "content_sanskrit": "मध्यमो हारितो नेरी यौनिकः स्वेदचूषकः । खरः स्वरिङ्गगोऽथासौ ग्रीष्मोभ्रूभ्रानिलोऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127, "avatarnika": ""}, {"id": 36000127, "chapter_id": 8143, "verse_number": "1.2.53", "content_sanskrit": "पयोदान्तस्तु पवनो वसन्तेऽमलपालिकः । गरवायुर्निदाघेऽल्पः शिशिरे सपुटानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128, "avatarnika": ""}, {"id": 36000128, "chapter_id": 8143, "verse_number": "1.2.54", "content_sanskrit": "जारवायुस्तु हेमन्ते शारदः शारणः शरः । गोगन्धनः पुरोवात उत्तरस्तु हिमानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129, "avatarnika": ""}, {"id": 36000129, "chapter_id": 8143, "verse_number": "1.2.55", "content_sanskrit": "रंहस्तरः क्ली प्रसभो जवो वेगः स्यदो रयः । कुबेरो यक्षराड् यक्षः कुतनुः किन्नरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130, "avatarnika": ""}, {"id": 36000130, "chapter_id": 8143, "verse_number": "1.2.56", "content_sanskrit": "मनुष्यधमैैलविलः पौलस्त्यो धनदो धनी । कैलासनाथस्त्रिशिरा धनाध्यक्षो वटाश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131, "avatarnika": ""}, {"id": 36000131, "chapter_id": 8143, "verse_number": "1.2.57", "content_sanskrit": "निधिपालो वैश्रवणो वित्तेशो नरवाहनः । राजराजः पराविद्धः किशालि गुह्यकेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132, "avatarnika": ""}, {"id": 36000132, "chapter_id": 8143, "verse_number": "1.2.58", "content_sanskrit": "एकपिङ्गो रुद्रसखः कुडः पुण्यजनेश्वरः । इच्छावसू रत्नगर्भो रत्नहस्तः सितोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133, "avatarnika": ""}, {"id": 36000133, "chapter_id": 8143, "verse_number": "1.2.59", "content_sanskrit": "अस्योद्यानं चैत्ररथं पुत्रस्तु नलकूबरः । पुरी कैलाससारास्य विमानं पुष्पकोऽस्त्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134, "avatarnika": ""}, {"id": 36000134, "chapter_id": 8143, "verse_number": "1.2.60", "content_sanskrit": "निधानं गूढकोशो ना निधिः शेवधिरस्त्रियाम् । भेदाः पद्मो महापद्मः शङ्खो मकरकच्छपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135, "avatarnika": ""}, {"id": 36000135, "chapter_id": 8143, "verse_number": "1.3.1", "content_sanskrit": "मुकुन्दकुन्दनीलाश्च चर्चश्चेति निधेर्नव । स्पर्शानन्दास्त्वप्सरसः सुमदाश्च रतेमदाः । स्वर्वेश्याश्चाथ स्वापेयो यक्षोऽथ सुरगायनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136, "avatarnika": ""}, {"id": 36000136, "chapter_id": 8143, "verse_number": "1.3.2", "content_sanskrit": "गन्धर्वो गातुगान्धर्वौ सिद्धाः स्युः सनकादयः । भूतापुत्रास्तु भूतानि भूताश्च शिवपार्श्वगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137, "avatarnika": ""}, {"id": 36000137, "chapter_id": 8143, "verse_number": "1.3.3", "content_sanskrit": "किन्नराः स्युः किम्पुरुषा मयवोऽश्वमुखाश्च ते । गुह्यका माणिचरयस्तथा देवजनाः सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138, "avatarnika": ""}, {"id": 36000138, "chapter_id": 8143, "verse_number": "1.3.4", "content_sanskrit": "विद्याधरास्तु द्युचराः खेचराः सत्ययौवनाः । पिशाचः स्यात्कापिशेयोऽसृजुर्दर्पश्च पिण्डकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139, "avatarnika": ""}, {"id": 36000139, "chapter_id": 8143, "verse_number": "1.3.5", "content_sanskrit": "देवयोनय एते स्युः स्वर्वेश्याद्याः सरक्षसः । नासत्यदस्रौ नासत्यावश्विनौ वरवाहनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140, "avatarnika": ""}, {"id": 36000140, "chapter_id": 8143, "verse_number": "1.3.6", "content_sanskrit": "आश्विनेयौ यज्ञवहौ देववैद्यौ वरान्तकौ । नासिक्यावाश्विनौ दस्रौ विश्वकर्मा द्युवर्धकिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141, "avatarnika": ""}, {"id": 36000141, "chapter_id": 8143, "verse_number": "1.3.7", "content_sanskrit": "त्वष्टा नाम स देवानां मयो नाम सुरद्विषाम् । सनत्कुमारो वैधात्रो नारदः कलहप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142, "avatarnika": ""}, {"id": 36000142, "chapter_id": 8143, "verse_number": "1.3.8", "content_sanskrit": "रुद्रा वसव आदित्या विश्वे साध्या मरुद्गणाः । तुषिता भास्वराद्याश्च बहवो देवतागणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143, "avatarnika": ""}, {"id": 36000143, "chapter_id": 8143, "verse_number": "1.3.9", "content_sanskrit": "मन्वन्तरेषु भिद्यन्ते देवाः सप्तर्षिभिः सह । असुरा दानवा दैत्या दैतेया देवशत्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144, "avatarnika": ""}, {"id": 36000144, "chapter_id": 8143, "verse_number": "1.3.10", "content_sanskrit": "पूर्वदेवाः शुक्रशिष्याः रसागेहा हरिद्विषः । ईहृङ्‌चेत्यादिभिर्मन्त्रैः सदा प्रोक्ता मरुद्गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145, "avatarnika": ""}, {"id": 36000145, "chapter_id": 8143, "verse_number": "1.3.11", "content_sanskrit": "स्वानभ्रादिति गन्धर्वगणा एकादशोदिताः । सुधर्मा स्याद्देवसभा दिव्य उच्चैःश्रवा हयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146, "avatarnika": ""}, {"id": 36000146, "chapter_id": 8143, "verse_number": "1.3.12", "content_sanskrit": "मेरुः सुमेरुः स्वर्णाद्रिर्मणिसानुः सुरालयः । महामेरुर्देवगिरिर्गौधुक् चाथापरेऽद्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147, "avatarnika": ""}, {"id": 36000147, "chapter_id": 8143, "verse_number": "1.3.13", "content_sanskrit": "तालाङ्का मेरुगण्डाश्च ये मेरुं परितः स्थिताः । मन्दाकिनी वियद्गङ्गा स्वर्णदी सुरदीर्घिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148, "avatarnika": ""}, {"id": 36000148, "chapter_id": 8143, "verse_number": "1.3.14", "content_sanskrit": "पञ्चैते देवतरवो मन्दारः पारिजातकः । सन्तानः कल्पवृक्षश्च हरिचन्दनमस्त्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149, "avatarnika": ""}]