[{"id": 2052600, "chapter_id": 2164, "verse_number": "७-९१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052601, "chapter_id": 2164, "verse_number": "७-९१-१", "content_sanskrit": "दुःशसनबलं हत्वा सव्यसाची महारथः।\nसिन्धुराजं परीप्सन्वै द्रोणानीकमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052602, "chapter_id": 2164, "verse_number": "७-९१-२", "content_sanskrit": "स तु द्रोणं समासाद्य व्यूहस्य प्रमुखे स्थितम्।\nकृताञ्जलिरिदं वाक्यं कृष्णस्यानुमतेऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052603, "chapter_id": 2164, "verse_number": "७-९१-३", "content_sanskrit": "शिवेन ध्याहि मां ब्रह्मन्स्वस्ति चैव वदस्व मे।\nभवत्प्रसादादिच्छामि प्रवेष्टं दुर्भिदां चमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052604, "chapter_id": 2164, "verse_number": "७-९१-४", "content_sanskrit": "भवान्पितृसमो मह्यं धर्मराजसमोऽपि च।\nधौम्यकृष्णसमश्चैव सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052605, "chapter_id": 2164, "verse_number": "७-९१-५", "content_sanskrit": "अश्वत्थामा यथा तात रक्षणीयस्त्वयाऽनघ।\nतथाऽहमपि ते रक्ष्यः सदैव द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052606, "chapter_id": 2164, "verse_number": "७-९१-६", "content_sanskrit": "तव प्रसादादिच्छेयं सिन्धुराजानमाहवे।\nनिहन्तुं द्विपदां श्रेष्ठ प्रतिज्ञां रक्ष मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052607, "chapter_id": 2164, "verse_number": "७-९१-७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052608, "chapter_id": 2164, "verse_number": "७-९१-७", "content_sanskrit": "एवमुक्तस्तदाऽऽचार्यः प्रत्युवाच स्मयन्निव।\nमामजित्वा न बीभत्सो शक्यो जेतुं जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052609, "chapter_id": 2164, "verse_number": "७-९१-८", "content_sanskrit": "एतावदुक्त्वा तं द्रोणः शरव्रातैरवाकिरत्।\nसरथाश्वध्वजं तीक्ष्णैः प्रहसन्वै ससारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052610, "chapter_id": 2164, "verse_number": "७-९१-९", "content_sanskrit": "ततोऽर्जुनः शरव्रातान्द्रोणस्यावार्य सायकैः।\nद्रोणमभ्यर्दयद्बाणैर्घोररूपैर्हत्तरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052611, "chapter_id": 2164, "verse_number": "७-९१-१०", "content_sanskrit": "विव्याध च रणे द्रोणमनुमान्य विशाम्पते।\nक्षत्रधर्मं समास्थाय नवभिः सायकैः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052612, "chapter_id": 2164, "verse_number": "७-९१-११", "content_sanskrit": "तस्येषूनिषुभिश्छित्त्वा द्रोणो विव्याध तावुभौ।\nविषाग्निज्वलितप्रख्यैरिषुभिः कृष्णपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052613, "chapter_id": 2164, "verse_number": "७-९१-१२", "content_sanskrit": "इयेप पाण्डवस्तस्य बाणैश्छेत्तुं शरासनम्।\nतस्य चिन्तयतस्त्वेव फल्गुनस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052614, "chapter_id": 2164, "verse_number": "७-९१-१३", "content_sanskrit": "द्रोणः शरैरसम्भ्रान्तो ज्यां चिच्छेदाशु वीर्यवान्।\nविव्याध च हयानस्य ध्वजं सारथिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052615, "chapter_id": 2164, "verse_number": "७-९१-१४", "content_sanskrit": "अर्जुनं च शरैर्वीरः स्मयमानोऽभ्यवाकिरत्।\nएतस्मिन्नन्तरे पार्थः सज्यं कृत्वा महद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052616, "chapter_id": 2164, "verse_number": "७-९१-१५", "content_sanskrit": "विशेषयिष्यन्नाचार्यं सर्वास्त्रविदुषां वरः।\nमुमोच षट्शतान्बाणान्गृहीत्वैकमिव द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052617, "chapter_id": 2164, "verse_number": "७-९१-१६", "content_sanskrit": "पुनः सप्तशतानन्यान्सहस्रं चानिवर्तिनः।\nचिक्षेपायुतशश्चान्यांस्तेऽघ्नन्द्रोणस्य तां चमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052618, "chapter_id": 2164, "verse_number": "७-९१-१७", "content_sanskrit": "तैः सम्यगस्तैर्बलिना कृतिना चित्रयोधिना।\nमनुष्यवाजिमातङ्गा विद्धाः पेतुर्गतासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052619, "chapter_id": 2164, "verse_number": "७-९१-१८", "content_sanskrit": "विसूताश्वध्वजाः पेतुः सञ्छिन्नायुधजीविताः।\nरथिनो रथमुख्येभ्यः सहसा शरपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052620, "chapter_id": 2164, "verse_number": "७-९१-१९", "content_sanskrit": "चूर्णिताक्षिप्तदग्धानां वज्रानिलहुताशनैः।\nतुल्यरूपा गजाः पेतुर्गिर्यग्राम्बुदवेश्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052621, "chapter_id": 2164, "verse_number": "७-९१-२०", "content_sanskrit": "पेतुरश्वसहस्राणि प्रहतान्यर्जुनेषुभिः।\nहंसा हिमवतः पृष्ठे वारिविप्रहता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052622, "chapter_id": 2164, "verse_number": "७-९१-२१", "content_sanskrit": "रथाश्वद्विपपत्त्योघाः सलिलौघा इवाद्भुताः।\nयुगान्तादित्यरश्म्याभैः पाण्डवास्त्रशरैर्हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052623, "chapter_id": 2164, "verse_number": "७-९१-२२", "content_sanskrit": "तं पाण्डवादित्यशरांशुजालं\nकुरुप्रवीरान्युधि निष्टपन्तम्।\nस द्रोणमेघः शरवृष्टिवेगैः\nप्राच्छादयन्मेघ इवार्करश्मीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052624, "chapter_id": 2164, "verse_number": "७-९१-२३", "content_sanskrit": "अथात्यर्थं विसृष्टेन द्विषतामसुभोजिना।\nआजघ्ने वक्षसि द्रोणो नाराचेन धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052625, "chapter_id": 2164, "verse_number": "७-९१-२४", "content_sanskrit": "स विह्वलितसर्वाङ्गः क्षितिकम्पे यथाऽचलः।\nधैर्यमालम्ब्य बीभत्सुर्द्रोणं विव्याध पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052626, "chapter_id": 2164, "verse_number": "७-९१-२५", "content_sanskrit": "द्रोणस्तु पञ्चभिर्बाणैर्वासुदेवमताडयत्।\nअर्जुनं च त्रिसप्तत्या ध्वजं चास्य त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052627, "chapter_id": 2164, "verse_number": "७-९१-२६", "content_sanskrit": "विशेषयिष्यञ्शिष्यं च द्रोणो राजन्पराक्रमी।\nअदृश्यमर्जुनं चक्रे निमेषाच्छरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052628, "chapter_id": 2164, "verse_number": "७-९१-२७", "content_sanskrit": "प्रसक्तान्पततोऽद्राक्ष्म भारद्वाजस्य सायकान्।\nमण्डलीकृतमेवास्य धनुश्चादृश्यताद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052629, "chapter_id": 2164, "verse_number": "७-९१-२८", "content_sanskrit": "तेऽभ्ययुः समरे राजन्वासुदेवधनञ्जयौ।\nद्रोणसृष्टाः सुबहवः कङ्कपत्रपरिच्छदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052630, "chapter_id": 2164, "verse_number": "७-९१-२९", "content_sanskrit": "तत्राद्भुतमपश्याम शिलानामिव सर्पणम्।\nयद्द्रोणं तरसा पार्थो वृद्धं बालोऽपि नातरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052631, "chapter_id": 2164, "verse_number": "७-९१-३०", "content_sanskrit": "चिन्तयामास वार्ष्णेयो दृष्ट्वा द्रोणस्य विक्रमम्।\nनातिवर्तिष्यते ह्योनं वेलामिव महार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052632, "chapter_id": 2164, "verse_number": "७-९१-३१", "content_sanskrit": "ततः पार्थं समुद्विग्नं लक्ष्य चिन्तयतेऽच्युतः।\nद्रोणस्य चापि विक्रान्तं दृष्ट्वा मधुनिषूदनः।\nइत्यब्रवीद्वासुदेवो धनञ्जयमुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052633, "chapter_id": 2164, "verse_number": "७-९१-३२", "content_sanskrit": "पार्थपार्थ महाबाहो न नः कालात्ययो भवेत्।\nद्रोणमुत्सृज्य गच्छामो ब्राह्मणोऽसौ गतक्लमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052634, "chapter_id": 2164, "verse_number": "७-९१-३३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052635, "chapter_id": 2164, "verse_number": "७-९१-३३", "content_sanskrit": "पार्थश्चाप्यब्रवीत्कृष्णं यथेष्टमिति केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2052636, "chapter_id": 2164, "verse_number": "७-९१-३४", "content_sanskrit": "ततः प्रदक्षिणं कृत्वा द्रोणं प्रायान्महाभुजम्।\nपरिवृत्तश्च बीभत्सुरगच्छद्विसृजञ्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2052637, "chapter_id": 2164, "verse_number": "७-९१-३५", "content_sanskrit": "ततोऽब्रवीत्स्वयं द्रोणः क्वेदं पाण्डव गम्यते।\nननु नाम रणे शत्रुमजित्वा न निवर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2052638, "chapter_id": 2164, "verse_number": "७-९१-३६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2052639, "chapter_id": 2164, "verse_number": "७-९१-३६", "content_sanskrit": "गुरुर्भवान्न मे शत्रुः शिष्यः पुत्रसमोऽस्मि ते।\nन चास्ति स पुमाँल्लोके यस्त्वां युधि पराजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2052640, "chapter_id": 2164, "verse_number": "७-९१-३७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2052641, "chapter_id": 2164, "verse_number": "७-९१-३७", "content_sanskrit": "एवं ब्रुवाणो बीभत्सुर्जयद्रथवधोत्सुकः।\nत्वरायुक्तो महाबाहुस्त्वत्सैन्यं समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2052642, "chapter_id": 2164, "verse_number": "७-९१-३८", "content_sanskrit": "तं चक्ररक्षौ पाञ्चाल्यौ युधामन्यूत्तमौजसौ।\nअन्वयातां महात्मानौ विशन्तं तावकं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2052643, "chapter_id": 2164, "verse_number": "७-९१-३९", "content_sanskrit": "ततो जयो महाराज कृतवर्मा च सात्वतः।\nकाम्भोजश्च श्रुतायुश्च धनञ्जयमवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2052644, "chapter_id": 2164, "verse_number": "७-९१-४०", "content_sanskrit": "तेषां दशसहस्राणि रथानामनुयायिनाम्।\nअभीषाहाः शूरसेनाः शिबयोऽथ वसातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2052645, "chapter_id": 2164, "verse_number": "७-९१-४१", "content_sanskrit": "मावेल्लका ललित्थाश्च केकया मद्रकास्तथा।\nनारायणाश्च गोपालाः काम्भोजानां च ये गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2052646, "chapter_id": 2164, "verse_number": "७-९१-४२", "content_sanskrit": "कर्णेन विजिताः पूर्वं सङ्ग्रामे शूरसम्मताः।\nभारद्वाजं पुरस्कृत्य हृष्टात्मानोऽर्जुनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2052647, "chapter_id": 2164, "verse_number": "७-९१-४३", "content_sanskrit": "पुत्रशोकाभिसन्तप्तं क्रुद्धं मृत्युमिवान्तकम्।\nत्यजन्तं तुमुले प्राणान्सन्नद्धं चित्रयोधिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2052648, "chapter_id": 2164, "verse_number": "७-९१-४४", "content_sanskrit": "गाहमानमनीकानि मातङ्गमिव यूथपम्।\nमहेष्वासं पराक्रान्तं नरव्याघ्रमवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2052649, "chapter_id": 2164, "verse_number": "७-९१-४५", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं रोमहर्षणम्।\nअन्योन्यं वै प्रार्थयतां योधानामर्जुनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2052650, "chapter_id": 2164, "verse_number": "७-९१-४६", "content_sanskrit": "जयद्रथवधप्रेप्सुमायान्तं पुरुषर्षभम्।\nन्यवारयन्त सहिताः क्रिया व्याधिमिवोत्थितं॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2052651, "chapter_id": 2164, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशोदिसयुद्धे एकनवतिततमोऽध्यायः॥ ९१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९१-१९ गिर्यग्राम्बुदवेश्मनां वज्रानिलहुताशनैः चूर्णिताक्षिप्तदग्धानां इति यथासङ्ख्येनान्वयः॥ ५-९१-९१ एकनवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]