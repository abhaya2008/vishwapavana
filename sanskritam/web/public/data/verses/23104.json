[{"id": 7003104000, "chapter_id": 23104, "verse_number": "४-४०-१", "content_sanskrit": "श्रीराधिकोवाच ।\nअहो विचित्रं चरितमपूर्वं किं श्रुतं विभो ।\nसुन्दरं श्रुतिपीयूषं निगूढं ज्ञानकारणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003104001, "chapter_id": 23104, "verse_number": "४-४०-२", "content_sanskrit": "न विशेषं समासं च श्रुतं न व्यासमीप्सितम् ।\nअधुना श्रोतुमिच्छामि विस्तीर्णं कथय प्रभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003104002, "chapter_id": 23104, "verse_number": "४-४०-३", "content_sanskrit": "किं किं तपः कठोरं च चकार पार्वती स्वयम् ।\nकं कं वरं वा संप्राप्य कथमाप महेश्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003104003, "chapter_id": 23104, "verse_number": "४-४०-४", "content_sanskrit": "रतिः केन प्रकारेण जीवयामास मन्मथम् ।\nपार्वतीशिवयोः कृष्ण विवाहं वर्णय प्रभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003104004, "chapter_id": 23104, "verse_number": "४-४०-५", "content_sanskrit": "तयो रहसि संभोगं पापिनां पापमोचनम् ।\nकथ्यतां करुणासिन्धो दुःखिनां दुःखमोचनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003104005, "chapter_id": 23104, "verse_number": "४-४०-६", "content_sanskrit": "दम्पतीविरहोक्तिश्च कर्णज्वाला च योषितः ।\nश्रोतुं कौतूहलं कृष्ण पुनः संमेलनं तयोः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003104006, "chapter_id": 23104, "verse_number": "४-४०-७", "content_sanskrit": "अग्निज्वाला विषज्वाला क्षमा सोढुं च योषितः ।\nदम्पतीविरहज्वाला न श्रोतुं च क्षणं क्षमा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003104007, "chapter_id": 23104, "verse_number": "४-४०-८", "content_sanskrit": "राधिकावचनं श्रुत्वा विस्मितश्चकिताननः ।\nविस्तीर्णं वक्तुमारेभे हृदयेन विदूयता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003104008, "chapter_id": 23104, "verse_number": "४-४०-९", "content_sanskrit": "दम्पतीविरहोक्तिं च यां राधा श्रोतुमक्षमा ।\nविच्छेदे शतवर्षीये किमस्या भविता मम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003104009, "chapter_id": 23104, "verse_number": "४-४०-१०", "content_sanskrit": "इत्येवं मानसे कृत्वा मायेशो माययाऽन्वितः ।\nकृपासिन्धुश्च कृपया कथां कथितुमुद्यतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003104010, "chapter_id": 23104, "verse_number": "४-४०-११", "content_sanskrit": "श्रीकृष्ण उवाच ।\nप्राणाधिके राधिके त्वं श्रूयतां प्राणवल्लभे ।\nप्राणाधिदेवि प्राणेशि प्राणाधारे मनोहरे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003104011, "chapter_id": 23104, "verse_number": "४-४०-१२", "content_sanskrit": "वटमूलाद्गते रुद्रे पार्वती तपसे ययौ ।\nपुनः पुनः स्वमात्रा च पित्रा च विनिवारिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003104012, "chapter_id": 23104, "verse_number": "४-४०-१३", "content_sanskrit": "गत्वा सा स्वर्णदीतीरं स्नात्वा त्रिषवणं मुदा ।\nसंदेशे च मया दत्तं जजाप तं मनुं मुदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003104013, "chapter_id": 23104, "verse_number": "४-४०-१४", "content_sanskrit": "वर्षमेकं च संपूर्णमनाहारा स्वभक्तितः।\nतप्त्वा तपः कठोरं च चकार जगदम्बिका ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003104014, "chapter_id": 23104, "verse_number": "४-४०-१५", "content_sanskrit": "ग्रीष्मे च परितो वह्निं प्रज्वलन्तं दिवानिशम्॥ ।\nकृत्वा प्रतस्थौ तन्मध्ये संततं जपती मनुम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003104015, "chapter_id": 23104, "verse_number": "४-४०-१६", "content_sanskrit": "शश्वत्स्मशाने वर्षासु कृत्वा योगासनं शिवा। ।\nशिलां दृष्ट्वा च संसिक्ता बभूव जलधारया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003104016, "chapter_id": 23104, "verse_number": "४-४०-१७", "content_sanskrit": "शीते जलान्तरे शश्वत्प्रतस्थौ भक्तिपूर्वकम् ।\nअनाहारा शरद्रौद्रनीहारासु दिशासु च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003104017, "chapter_id": 23104, "verse_number": "४-४०-१८", "content_sanskrit": "एवं कृत्वा परं वर्षमप्राप्य शंकरं सती। ।\nशुचा कृत्वाऽग्निकुण्डं च प्रवेष्टुं सा समुद्यता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003104018, "chapter_id": 23104, "verse_number": "४-४०-१९", "content_sanskrit": "तामग्निकुण्डं विशतीं तपसाऽतिकृशां सतीम्।\nदृष्ट्वा शिवः कृपासिन्धुः कृपया तां जगाम ह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003104019, "chapter_id": 23104, "verse_number": "४-४०-२०", "content_sanskrit": "अतीव वामनो बालो विप्ररूपी स्वतेजसा ।\nप्रज्वलन्मनसा हृष्टो दण्डी छत्री जटाधरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003104020, "chapter_id": 23104, "verse_number": "४-४०-२१", "content_sanskrit": "शुक्लयज्ञोपवीती च शुक्लवासाश्च सस्मितः ।\nश्वेताब्जबीजमालां च बिभ्रत्तिलकमुज्ज्वलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003104021, "chapter_id": 23104, "verse_number": "४-४०-२२", "content_sanskrit": "निर्जने बालकं दृष्ट्वा स्निग्धा सापि जगाद ह ।\nतत्तेजसाऽतिप्रच्छन्ना तत्याज च तपः स्वयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003104022, "chapter_id": 23104, "verse_number": "४-४०-२३", "content_sanskrit": "को भवानिति पप्रच्छ तं शिशुं पुरतः स्थितम् ।\nमनसाऽलिङ्गनं कर्तुमिच्छन्ती परमादरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003104023, "chapter_id": 23104, "verse_number": "४-४०-२४", "content_sanskrit": "श्रुत्वा शैलसुता प्रश्नं प्रहस्य परमेश्वरः ।\nउवाचातीव मधुरं कर्णपीयूषमीश्वरीम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003104024, "chapter_id": 23104, "verse_number": "४-४०-२५", "content_sanskrit": "शंकर उवाच ।\nइच्छागामी बटुरहं तपस्वी विप्रबालकः ।\nका त्वं कान्ताऽतिकान्तारे तपश्चरसि सुन्दरि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003104025, "chapter_id": 23104, "verse_number": "४-४०-२६", "content_sanskrit": "वद कस्य कुले जाता कस्य कन्या च काऽभिधा ।\nतपसः फलदात्री त्वं कस्माद्धेतोस्तपस्तव ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003104026, "chapter_id": 23104, "verse_number": "४-४०-२७", "content_sanskrit": "अहो वा तपसां राशिः स्वयं मूर्तिमती सती। ।\nतपो वा लोकशिक्षार्थं करोषि कमलेक्षणे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003104027, "chapter_id": 23104, "verse_number": "४-४०-२८", "content_sanskrit": "स्वयं तेजःस्वरूपा वा मूलप्रकृतिरीश्वरी ।\nविधाय भक्तध्यानार्थं विग्रहं भारते जनुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003104028, "chapter_id": 23104, "verse_number": "४-४०-२९", "content_sanskrit": "किं वा त्रिलोके लक्ष्मीस्त्वं संपद्रूपा सनातनी ।\nरक्षां विधातुं जगतामागता धातुरन्तिके ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003104029, "chapter_id": 23104, "verse_number": "४-४०-३०", "content_sanskrit": "किं वाम्बिका त्वं देवानां स्वयं मूर्तिमती सती ।\nसावित्री भारते जन्म स्वेच्छया लब्धुमागता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003104030, "chapter_id": 23104, "verse_number": "४-४०-३१", "content_sanskrit": "रागाधिष्ठातृदेवी वा स्वयं साक्षात्सरस्वती ।\nसर्वविद्याः प्रकटितुं स्वेच्छया जन्म भारते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003104031, "chapter_id": 23104, "verse_number": "४-४०-३२", "content_sanskrit": "एतासु मध्ये का वा त्वं नाहं तर्कितुमीश्वरः ।\nया सा भवति कल्याणि परितुष्टा च मां भव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003104032, "chapter_id": 23104, "verse_number": "४-४०-३३", "content_sanskrit": "सति त्वयि प्रसन्नायां प्रसन्नः परमेश्वरः ।\nपतिव्रतायां तुष्टायां तुष्टो नारायणः स्वयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003104033, "chapter_id": 23104, "verse_number": "४-४०-३४", "content_sanskrit": "तुष्टे नारायणे देवे शश्वत्तुष्टं जगत्त्रयम् ।\nतरुमूलेषु सिक्तेषु शाखाः सिक्ता यथा प्रिये ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003104034, "chapter_id": 23104, "verse_number": "४-४०-३५", "content_sanskrit": "शिशोस्तद्वचनं श्रुत्वा प्रहस्य परमेश्वरी ।\nउवाच वचनं चारु कर्णपीयूषमीश्वरी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003104035, "chapter_id": 23104, "verse_number": "४-४०-३६", "content_sanskrit": "पार्वत्युवाच॥नाहं वेदप्रसूर्लक्ष्मीर्वागधिष्ठातृदेवता ।\nजन्म मे भारते वर्षे साम्प्रतं शैलकन्यका ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003104036, "chapter_id": 23104, "verse_number": "४-४०-३७", "content_sanskrit": "पूर्वं जन्म दक्षगेहे सती शंकरकामिनी ।\nयोगेन त्यक्तदेहाऽहं तातभर्तृविनिन्दया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003104037, "chapter_id": 23104, "verse_number": "४-४०-३८", "content_sanskrit": "अत्र जन्मनि पुण्येन सम्प्राप्ते शंकरे द्विज ।\nमां त्यक्त्वा भस्मसात्कृत्वा मन्मथं स जगाम ह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003104038, "chapter_id": 23104, "verse_number": "४-४०-३९", "content_sanskrit": "प्रयाते शंकरे तापाद्व्रीडयाऽहं पितुर्गृहात् ।\nआगमत्तपसे चित्तं ममेदं स्वर्णदीतटे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003104039, "chapter_id": 23104, "verse_number": "४-४०-४०", "content_sanskrit": "तपः कृत्वा कठोरं च सुचिरं प्राणवल्लभम् ।\nअप्राप्याग्निं प्रवेष्टुं च त्वां च दृष्ट्वा क्षणं स्थिता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003104040, "chapter_id": 23104, "verse_number": "४-४०-४१", "content_sanskrit": "गच्छ त्वं प्रविशाम्यग्नौ प्रलयाग्निशिखोपमे ।\nकृत्वा स्वकामनां विप्र हरप्राप्तिमनीषितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003104041, "chapter_id": 23104, "verse_number": "४-४०-४२", "content_sanskrit": "यत्र यत्र जनुर्लब्ध्वा लभिष्यामि शिवं परम् ।\nप्राणाधिकं प्रियं कान्तं विभुं जन्मनि जन्मनि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003104042, "chapter_id": 23104, "verse_number": "४-४०-४३", "content_sanskrit": "सर्वा हि स्वप्रियं लब्धुं लभन्ति जन्म वाञ्छितम् ।\nतज्जन्म पतिलाभार्थं सर्वासां च श्रुतौ श्रुतम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003104043, "chapter_id": 23104, "verse_number": "४-४०-४४", "content_sanskrit": "प्राक्तनीयो हि यो भर्ता स तासां प्रतिजन्मनि ।\nया स्त्री येषां सुनियता सा तेषां जन्मजन्मनि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003104044, "chapter_id": 23104, "verse_number": "४-४०-४५", "content_sanskrit": "तद्देहमिह न प्राप्य कृत्वा घोरतरं तपः ।\nकृत्वाऽग्निकुण्डे काम्यं च लभिष्यामि परत्र तम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003104045, "chapter_id": 23104, "verse_number": "४-४०-४६", "content_sanskrit": "इत्युक्त्वा पार्वती तत्र तत्पुरः प्रविवेश ह ।\nनिषिध्यमाना पुरतो ब्राह्मणेन पुनः पुनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003104046, "chapter_id": 23104, "verse_number": "४-४०-४७", "content_sanskrit": "वह्निप्रवेशं कुर्वन्त्याः पार्वत्याः परमेश्वरि ।\nबभूव तपसा सद्यो वह्निश्चन्दनवद्ध्रुवम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003104047, "chapter_id": 23104, "verse_number": "४-४०-४८", "content_sanskrit": "क्षणं तदन्तरे स्थित्वा चोत्पतन्तीं शिवां शिवः ।\nपुनः प्रपच्छ सहसा वृन्दावनविनोदिनि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003104048, "chapter_id": 23104, "verse_number": "४-४०-४९", "content_sanskrit": "श्रीमहादेव उवाच ।\nअहो तपस्ते किं भद्रे न बुद्धं किंचिदेव हि ।\nन दग्धो वह्निना देहो न च प्राप्तो मनीषितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003104049, "chapter_id": 23104, "verse_number": "४-४०-५०", "content_sanskrit": "शिवं कल्याणरूपं च भर्तारं कर्तुमिच्छसि। ।\nअविग्रहं पतिं कृत्वा किं वा ते वाञ्छितं भवेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003104050, "chapter_id": 23104, "verse_number": "४-४०-५१", "content_sanskrit": "संहर्तारं च भर्तारं यदीच्छसि शुचिस्मिते ।\nकान्तमिच्छति का वा स्त्री सर्वसंहारकारणम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003104051, "chapter_id": 23104, "verse_number": "४-४०-५२", "content_sanskrit": "मोक्षं वाञ्छसि चेद्देवि कृत्वा कान्तं स्वरूपिणम् ।\nसर्वमुक्तिप्रदा त्वं च तपस्या विफला तव ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003104052, "chapter_id": 23104, "verse_number": "४-४०-५३", "content_sanskrit": "शिवश्च मङ्गले मोक्षे संहर्ता न च दृश्यते ।\nशिवशब्दस्य चान्योऽर्थो न हि वेदे निरूपितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003104053, "chapter_id": 23104, "verse_number": "४-४०-५४", "content_sanskrit": "तं च संहारकर्तारं यदि वाञ्छसि सुन्दरि ।\nलभिष्यसे रतं रुद्रं सर्वलोकभयंकरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003104054, "chapter_id": 23104, "verse_number": "४-४०-५५", "content_sanskrit": "न भविष्यति मोक्षस्ते स्वाभीष्टं देवसेवनम् ।\nहरिस्मृतिरमोघा च सर्वमंगलदा सदा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003104055, "chapter_id": 23104, "verse_number": "४-४०-५६", "content_sanskrit": "शीघ्रं पितुर्गृहं गच्छ तत्र द्रक्ष्यसि शंकरम् ।\nममाशिषा स्वतपसां फलेन च सुदुर्लभम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003104056, "chapter_id": 23104, "verse_number": "४-४०-५७", "content_sanskrit": "इत्युक्त्वा पार्वतीं विप्रस्तत्रैवान्तरधीयत ।\nदुर्गा ययौ पितुर्गेहं महादेवेति वादिनी ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003104057, "chapter_id": 23104, "verse_number": "४-४०-५८", "content_sanskrit": "पार्वत्यागमनं श्रुत्वा मेनका च हिमालयः ।\nदिव्यं यानं पुरस्कृत्य प्रययौ हर्षविह्वलः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003104058, "chapter_id": 23104, "verse_number": "४-४०-५९", "content_sanskrit": "संस्थाप्य मंगलघटान्राजवर्त्मनि राधिके ।\nचन्दनागुरुकस्तूरीफलशाखासमन्वितान् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003104059, "chapter_id": 23104, "verse_number": "४-४०-६०", "content_sanskrit": "पट्टसूत्रसन्निबद्धरसालपल्लवान्वितैः ।\nपरितः परितो रम्भास्तम्भवृन्दसमन्विते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003104060, "chapter_id": 23104, "verse_number": "४-४०-६१", "content_sanskrit": "पतिपुत्रवतीयोषित्समूहैर्दीपहस्तकैः ।\nपूर्णैर्लाजाधान्यदूर्वाफलपुष्पसमन्वितैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003104061, "chapter_id": 23104, "verse_number": "४-४०-६२", "content_sanskrit": "सुपुण्यैर्ब्राह्मणैश्चापि मुनिभिर्ब्रह्मचारिभिः ।\nनटीभिर्नर्तकीभिश्च गजेन्द्रैः परिशोभिते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003104062, "chapter_id": 23104, "verse_number": "४-४०-६३", "content_sanskrit": "पुरोहितैश्च संयुक्तैः कुर्वद्भिर्मङ्गलध्वनिम् ।\nसुचारुमालतीमालाहस्तैः शस्तैः प्रशंसितैः  ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003104063, "chapter_id": 23104, "verse_number": "४-४०-६४", "content_sanskrit": "नानाप्रकारवाद्यैश्च शंखध्वनिसुनादितैः। ।\nसिन्दूररेणुभिश्चारुचन्दनद्रवपङ्किलम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003104064, "chapter_id": 23104, "verse_number": "४-४०-६५", "content_sanskrit": "प्रविश्य नगरं दुर्गा ददर्श पितरौ पुरः ।\nसुप्रसन्नौ प्रधावन्तौ हर्षाश्रुपुलकान्वितौ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003104065, "chapter_id": 23104, "verse_number": "४-४०-६६", "content_sanskrit": "प्रसन्नवदना देवी चालिभिः प्रणनाम तौ ।\nसंयुज्याथाशिषं तौ च चक्रतुस्तां च वक्षसि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003104066, "chapter_id": 23104, "verse_number": "४-४०-६७", "content_sanskrit": "हे वत्से वत्सेत्युच्चार्य रुदन्तौ प्रेमविह्वलौ। ।\nतदा तां च रथे कृत्वा जग्मतुर्निजमन्दिरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003104067, "chapter_id": 23104, "verse_number": "४-४०-६८", "content_sanskrit": "स्त्रियो निर्मंच्छनं चक्रुर्विप्रा युयुजुराशिषम्। ।\nब्राह्मणेभ्यश्च बन्दिभ्यः पर्वतेन्द्रो धनं ददौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003104068, "chapter_id": 23104, "verse_number": "४-४०-६९", "content_sanskrit": "मङ्गलं कारयामास पाठयामास छान्दसम् ।\nएवं स्वकन्यया सार्द्धं तस्थतुस्तौ स्वमन्दिरे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003104069, "chapter_id": 23104, "verse_number": "४-४०-७०", "content_sanskrit": "सुखेन वसतौ तौ हि हर्षनिर्भरमानसौ ।\nएकदा च तपः कर्तुं जगाम स्वर्णदीं गिरिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003104070, "chapter_id": 23104, "verse_number": "४-४०-७१", "content_sanskrit": "मेनकाकन्यया सार्द्धमुवास प्राङ्गणे मुदा ।\nएतस्मिन्नन्तरे भिक्षुर्नर्तकश्च सुगायनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003104071, "chapter_id": 23104, "verse_number": "४-४०-७२", "content_sanskrit": "सहसैक आजगाम मेनकासन्निधिं मुदा ।\nशृङ्गवाद्यं वामहस्ते डमरुं दक्षिणे तथा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003104072, "chapter_id": 23104, "verse_number": "४-४०-७३", "content_sanskrit": "कृत्वा विभूतिगात्रोऽतिवृद्धोऽतीव जरातुरः ।\nपृष्ठकन्थो रक्तवासाः सुकण्ठोऽतिमनोहरः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003104073, "chapter_id": 23104, "verse_number": "४-४०-७४", "content_sanskrit": "जगौ मम गुणाख्यानं कृत्वा नृत्यं मनोहरम् ।\nवादयामास शृङ्गं च क्षणं डमरुकं तथा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003104074, "chapter_id": 23104, "verse_number": "४-४०-७५", "content_sanskrit": "आजग्मुर्नागरा बाला बालिका हर्षविह्वलाः ।\nवृद्धा युवानो युवतीसमूहो वृद्धयोषितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003104075, "chapter_id": 23104, "verse_number": "४-४०-७६", "content_sanskrit": "श्रुत्वा तु सुन्दरं गीतं सुतानस्वरसंयुतम् ।\nसहसा मुमुहुः सर्वे तेन मूर्च्छामवाप्नुवन् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003104076, "chapter_id": 23104, "verse_number": "४-४०-७७", "content_sanskrit": "मूर्छां संप्राप सा दुर्गा ददर्श हृदि शङ्करम् ।\nत्रिशूलपट्टिशकरं व्याघ्रचर्मधरं परम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003104077, "chapter_id": 23104, "verse_number": "४-४०-७८", "content_sanskrit": "विभूतिभूषणं रम्यमस्थिमालां सुनिर्मलाम् ।\nईषद्धास्यप्रसन्नास्यं सुप्रसन्नं त्रिलोचनम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003104078, "chapter_id": 23104, "verse_number": "४-४०-७९", "content_sanskrit": "मालाहस्तं पंचवक्त्रं नागयज्ञोपवीतकम्। ।\nवरं वृण्वित्युक्तवन्तं सुन्दरं चन्द्रशेखरम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003104079, "chapter_id": 23104, "verse_number": "४-४०-८०", "content_sanskrit": "हृदयस्थं हरं दृष्ट्वा मनसा तं ननाम सा ।\nवरं वव्रे मानसे सा त्वं पतिर्मे भवेति च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003104080, "chapter_id": 23104, "verse_number": "४-४०-८१", "content_sanskrit": "एवं दत्त्वा शिवस्तस्य चान्तर्धानं चकार सः ।\nन दृष्ट्वा हृदि तं दुर्गा संप्राप्य चेतनां पुनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003104081, "chapter_id": 23104, "verse_number": "४-४०-८२", "content_sanskrit": "ददर्श चक्षुरुन्मील्य भिक्षुकं गायकं पुरः ।\nनृत्यसंगीततः सा तु भिक्षुकस्य च मेनका ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003104082, "chapter_id": 23104, "verse_number": "४-४०-८३", "content_sanskrit": "दातुं ययौ सा रत्नानि स्वर्णपात्रस्थितानि च ।\nभिक्षां ययाचे भिक्षुस्तां दुर्गां नान्यां गृहीतवान् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003104083, "chapter_id": 23104, "verse_number": "४-४०-८४", "content_sanskrit": "पुनश्च नर्तनं कर्तुमुद्यतः कौतुकेन च ।\nमेना तद्वचनं श्रुत्वा चुकोप विस्मयं ययौ ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003104084, "chapter_id": 23104, "verse_number": "४-४०-८५", "content_sanskrit": "भिक्षुकं भर्त्सयामास बहिः कर्तुमुवाच तम् ।\nपत्नी त्रिलोकनाथस्य शिवस्य परमात्मनः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003104085, "chapter_id": 23104, "verse_number": "४-४०-८६", "content_sanskrit": "याञ्चामिमां प्रकुर्वन्तं दूरं कुरु सुभाषिणम्। ।\nएतस्मिन्नन्तरे तप्त्वा गिरिः स्वालयमाययौ ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003104086, "chapter_id": 23104, "verse_number": "४-४०-८७", "content_sanskrit": "ददर्श पुरतो भिक्षुं प्राङ्गणस्थं मनोहरम्।\nकृत्वा नारायणार्चां च गङ्गातीरे मनोहरे ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003104087, "chapter_id": 23104, "verse_number": "४-४०-८८", "content_sanskrit": "तन्मूर्तिध्यानविश्लेषशोकादुद्विग्नमानसः ।\nश्रुत्वा मेनामुखाद्वार्तां जहास च चुकोप सः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003104088, "chapter_id": 23104, "verse_number": "४-४०-८९", "content_sanskrit": "आज्ञां चकार स्वचरं बहिः कर्तुं च भिक्षुकम् ।\nआकाशामिव दुःस्पर्शं प्रज्वलन्तं स्वतेजसा॥ ।८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003104089, "chapter_id": 23104, "verse_number": "४-४०-९०", "content_sanskrit": "न शशाक बहिः कर्तुं समीपं गन्तुमक्षमः। ।\nददर्श भिक्षुकं शैलः क्षणं चारुचतुर्भुजम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003104090, "chapter_id": 23104, "verse_number": "४-४०-९१", "content_sanskrit": "किरीटिनं कुण्डलिनं पीताम्बरधरं परम्। ।\nसुवेषं सुन्दरश्याममीषद्धास्यं मनोहरम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003104091, "chapter_id": 23104, "verse_number": "४-४०-९२", "content_sanskrit": "चन्दनोक्षितसर्वाङ्गं भक्तानुग्रहकातरम् ।\nयद्यत्पुष्पं प्रदत्तं च पूजाकाले गदाभृते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003104092, "chapter_id": 23104, "verse_number": "४-४०-९३", "content_sanskrit": "गात्रे शिरसि तत्सर्वं भिक्षुकस्य ददर्श ह ।\nधूपः प्रदीपो यो दत्तो नैवेद्यं वा मनोहरम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003104093, "chapter_id": 23104, "verse_number": "४-४०-९४", "content_sanskrit": "ददर्श शैलस्तत्सर्वं भिक्षुकस्य पुरः स्थितम्। ।\nक्षणं ददर्श द्विभुजं विनोदमुरलीकरम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003104094, "chapter_id": 23104, "verse_number": "४-४०-९५", "content_sanskrit": "गोपवेषं किशोरं च सस्मितं श्यामसुन्दरम् ।\nमयूरपिच्छचूडं च रत्नालंकारभूषितम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003104095, "chapter_id": 23104, "verse_number": "४-४०-९६", "content_sanskrit": "चन्दनोक्षितसर्वाङ्गं वनमालाविभूषितम् ।\nक्षणं ददर्श स्वच्छं च शंकरं चंद्रशेखर म्९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003104096, "chapter_id": 23104, "verse_number": "४-४०-९७", "content_sanskrit": "त्रिशूलपट्टिशकरं व्याघ्रचर्माम्बरं परम् ।\nविभूतिगात्रममलमस्थिमालाविभूषितम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003104097, "chapter_id": 23104, "verse_number": "४-४०-९८", "content_sanskrit": "नागयज्ञोपवीतं च तप्तस्वर्णजटाधरम् ।\nडमरुशृंगहस्तं च सुप्रशस्तं मनोहरम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003104098, "chapter_id": 23104, "verse_number": "४-४०-९९", "content_sanskrit": "प्रजपन्तं हरेर्नाम श्वेताब्जबीजमालया ।\nईषद्धास्यप्रसन्नास्यं भक्तानुग्रहकातरम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003104099, "chapter_id": 23104, "verse_number": "४-४०-१००", "content_sanskrit": "स्वतेजसा प्रज्वलन्तं पञ्चवक्त्रं त्रिलोचनम् ।\nक्षणं ददर्श जगतां स्रष्टारं च चतुर्मुखम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003104100, "chapter_id": 23104, "verse_number": "४-४०-१०१", "content_sanskrit": "जपन्तं श्रीहरेर्नाम स्वच्छस्फटिकमालया ।\nक्षणं सूर्य स्वरूपं च ददर्श त्रिगुणात्मकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003104101, "chapter_id": 23104, "verse_number": "४-४०-१०२", "content_sanskrit": "ददर्श तमतीव्रं तु ज्वलन्तं ब्रह्मतेजसा ।\nक्षणमग्निस्वरूपं च ज्वलन्तमतितेजसा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003104102, "chapter_id": 23104, "verse_number": "४-४०-१०३", "content_sanskrit": "क्षणमाह्लादजनकं चन्द्ररूपं ददर्श ह ।\nक्षणं तेजःस्वरूपं च निराकारं निरञ्जनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003104103, "chapter_id": 23104, "verse_number": "४-४०-१०४", "content_sanskrit": "निर्लिप्तं च निरीहं च परमात्मस्वरूपिणम् ।\nएवं स्वेच्छामयं दृष्ट्वा नानारूपधरं परम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003104104, "chapter_id": 23104, "verse_number": "४-४०-१०५", "content_sanskrit": "हर्षाश्रुपुलकः शैलो दण्डवत्प्रणनाम तम् ।\nभक्त्या प्रदक्षिणीकृत्य प्रणम्य च पुनः पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003104105, "chapter_id": 23104, "verse_number": "४-४०-१०६", "content_sanskrit": "समुत्पत्य हर्षयुक्तो ददर्श पुनरेव तम्।\nवास्तवं भिक्षुकं दृष्ट्वा शैलेन्द्रो विष्णुमायया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003104106, "chapter_id": 23104, "verse_number": "४-४०-१०७", "content_sanskrit": "विसस्मार च तत्सर्वं नानारूपधरं परम् ।\nभिक्षां ययाचे भिक्षुस्तं भिक्षास्थालीस्वपार्श्वकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003104107, "chapter_id": 23104, "verse_number": "४-४०-१०८", "content_sanskrit": "रक्ताम्बरः शृङ्गवाद्यविचित्रडमरुः करे ।\nआदातुमुत्सुको दुर्गां नान्यां भिक्षुः कदाचन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003104108, "chapter_id": 23104, "verse_number": "४-४०-१०९", "content_sanskrit": "न स्वीचकार शैलेन्द्रो मोहितो विष्णुमायया ।\nभिक्षुः किंचिन्न जग्राह तत्रैवान्तरधीयत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003104109, "chapter_id": 23104, "verse_number": "४-४०-११०", "content_sanskrit": "तदा बभूव ज्ञानं च मेनकाशैलयोः प्रिये ।\nअहो दृष्टो जगन्नाथ आवाभ्यां स्वप्नवद्दिने ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003104110, "chapter_id": 23104, "verse_number": "४-४०-१११", "content_sanskrit": "आवां शिवौ वञ्चयित्वा स्वस्थानं गतवान्विभुः ।\nतयोर्भक्तिं शिवे दृष्ट्वा सर्वे देवाश्च चिन्तिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003104111, "chapter_id": 23104, "verse_number": "४-४०-११२", "content_sanskrit": "चक्रुः शक्रादयो युक्तिं सुमेरो रक्षणे भरात् ।\nएकान्तभक्त्या शैलश्चेत्कन्यां तस्मै प्रदास्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003104112, "chapter_id": 23104, "verse_number": "४-४०-११३", "content_sanskrit": "ध्रुवं निर्वाणतां सद्यः संप्राप्नोत्येव भारते ।\nअनन्तरत्नाधारश्चेत्पृथ्वी त्यक्त्वा प्रयास्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003104113, "chapter_id": 23104, "verse_number": "४-४०-११४", "content_sanskrit": "रत्नगर्भाभिधा भूमेर्मिथ्यैव भविता ध्रुवम् ।\nस्थावरत्वं परित्यज्य दिव्यरूपं विधाय सः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003104114, "chapter_id": 23104, "verse_number": "४-४०-११५", "content_sanskrit": "कन्यां शूलभृते दत्त्वा विष्णुलोकं गमिष्यति ।\nनारायणस्य सारूप्यं भविष्यत्येव लीलया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003104115, "chapter_id": 23104, "verse_number": "४-४०-११६", "content_sanskrit": "संप्राप्य पार्षदत्वं च हरिदासो भविष्यति ।\nदशवापीसमा कन्या दीयते ब्राह्मणाय ता म्१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003104116, "chapter_id": 23104, "verse_number": "४-४०-११७", "content_sanskrit": "वेदज्ञाय पवित्राय चाप्रतिग्रहशालिने ।\nसंध्यायज्ञवेदपाठकारिणे सत्यवादिने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003104117, "chapter_id": 23104, "verse_number": "४-४०-११८", "content_sanskrit": "अस्यै प्रदत्ता कन्या च दशवापीफलप्रदा ।\nत्रिसंध्याकारिणे सत्यवादिने गृहशालिने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003104118, "chapter_id": 23104, "verse_number": "४-४०-११९", "content_sanskrit": "वेदज्ञाय सुविप्राय दत्त्वा सुफलदायिनी ।\nपरदारगृहीताय याजकाय द्विजातये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003104119, "chapter_id": 23104, "verse_number": "४-४०-१२०", "content_sanskrit": "शठाय संध्याहीनाय वाप्यैकफलदा सुता ।\nसर्वसंध्यास्वगायत्रीविहीनाय शठाय च ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003104120, "chapter_id": 23104, "verse_number": "४-४०-१२१", "content_sanskrit": "वैश्योद्भवाय दत्ता या वाप्यर्द्धफलदा स्मृता ।\nपापिने शूद्रजाताय विप्रक्षत्रोद्भवाय च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003104121, "chapter_id": 23104, "verse_number": "४-४०-१२२", "content_sanskrit": "दत्त्वा चाण्डालतुल्याय कन्या सा नरकप्रदा ।\nविष्णुभक्ताय विदुषे विप्राय सत्यवादिने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003104122, "chapter_id": 23104, "verse_number": "४-४०-१२३", "content_sanskrit": "जितेन्द्रियाय दत्ता या विंशद्वापीफलप्रदा ।\nषष्टि वर्षसहस्राणि दिव्यरूपं विधाय च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003104123, "chapter_id": 23104, "verse_number": "४-४०-१२४", "content_sanskrit": "एवंभूताय दत्ता चेन्मोदते विष्णुमंदिरे ।\nदत्त्वा कन्यां सुशीलां च हराय हरयेऽथ वा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003104124, "chapter_id": 23104, "verse_number": "४-४०-१२५", "content_sanskrit": "नारायणस्वरूपं च भवेदेव श्रुतौ श्रुतम् ।\nविष्णुभक्तो यदा कन्यां ददाति विष्णुप्रीतये ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003104125, "chapter_id": 23104, "verse_number": "४-४०-१२६", "content_sanskrit": "स लभेद्धरिदास्यं च ध्रुवं विप्रोद्भवाय च ।\nइत्यालोच्य सुराः सर्वे कृत्वा च मन्त्रणां प्रिये ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003104126, "chapter_id": 23104, "verse_number": "४-४०-१२७", "content_sanskrit": "गुरुं प्रस्थापितुं जग्मुर्हिमालयगृहं प्रति ।\nगत्वा प्रणम्य च गुरुं सर्वे चक्रुर्निवेदनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003104127, "chapter_id": 23104, "verse_number": "४-४०-१२८", "content_sanskrit": "हिमालयगृहं गत्वा कुरु निन्दां च शूलिनः ।\nपिनाकिनं विना दुर्गा वरं नान्यं वरिष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003104128, "chapter_id": 23104, "verse_number": "४-४०-१२९", "content_sanskrit": "अनिच्छया सुतां दत्त्वा फलं तूर्णं लभिष्यति ।\nकालेन यातु शैलेन्द्रश्चेदानीं भुवि तिष्ठतु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003104129, "chapter_id": 23104, "verse_number": "४-४०-१३०", "content_sanskrit": "अनन्तरत्नाधारं च त्वमेव रक्ष भारते ।\nदेवानां वचनं श्रुत्वा प्रददौ कर्णयोः करौ ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003104130, "chapter_id": 23104, "verse_number": "४-४०-१३१", "content_sanskrit": "न स्वीचकार स्वगुरुः स्मरन्नारायणेति च ।\nउवाच देववर्गांश्च संभर्त्स्य च पुनः पुनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003104131, "chapter_id": 23104, "verse_number": "४-४०-१३२", "content_sanskrit": "वेदवेदान्तविज्ञाता महाभक्तो हरौ हरे ।\nबृहस्पतिरुवाच ।\nश्रूयतां मद्वचः सत्यं हे देवाः स्वार्थसाधकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003104132, "chapter_id": 23104, "verse_number": "४-४०-१३३", "content_sanskrit": "नीतिसारं च वेदोक्तं परिणामसुखावहम् ।\nहरकेशवयोर्भक्तं ये च निन्दन्ति पापिनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003104133, "chapter_id": 23104, "verse_number": "४-४०-१३४", "content_sanskrit": "भूदेवान्ब्राह्मणांश्चैव स्वगुरुं च पतिव्रताः। ।\nपतिभिक्षुब्रह्मचारिसृष्टिबीजान्सुरांस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003104134, "chapter_id": 23104, "verse_number": "४-४०-१३५", "content_sanskrit": "पच्यन्ते कालसूत्रे ते यावच्चन्द्रदिवाकरौ ।\nश्लेष्ममूत्रपुरीषेषु शेरते ते दिवानिशम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003104135, "chapter_id": 23104, "verse_number": "४-४०-१३६", "content_sanskrit": "भक्षिताः कीटनिकरैः शब्दं कुर्वंति कातराः ।\nये निन्दन्ति च ब्रह्माणं स्रष्टारं जगतां गुरुम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003104136, "chapter_id": 23104, "verse_number": "४-४०-१३७", "content_sanskrit": "शिवं सुराणां प्रवरं दुर्गां लक्ष्मीं सरस्वतीम् ।\nगीतां च तुलसीं गङ्गां वेदांश्च वेदमातरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003104137, "chapter_id": 23104, "verse_number": "४-४०-१३८", "content_sanskrit": "व्रतं तपस्यां पूजां च मन्त्रं मंत्रप्रदं गुरुम्।\nते पच्यन्तेऽन्धकूपे वै चायुषोऽर्धं विधेरहो ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003104138, "chapter_id": 23104, "verse_number": "४-४०-१३९", "content_sanskrit": "भक्षिताः सर्पसंघैश्च शब्दं कुर्वन्ति संततम् ।\nये निन्दन्ति हृषीकेशं देवसाम्यं विधाय च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003104139, "chapter_id": 23104, "verse_number": "४-४०-१४०", "content_sanskrit": "विष्णुभक्तिप्रदं चैव पुराणं च श्रुतेः परम् ।\nराधा तदङ्गजा गोपी ब्राह्मणांश्च सदार्चितान् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003104140, "chapter_id": 23104, "verse_number": "४-४०-१४१", "content_sanskrit": "ते पच्यन्तेऽवटे देवा विधातुरायुषा समम् ।\nअधोमुखा ऊर्ध्वजङ्घाः सर्पसंघैश्च वेष्टिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003104141, "chapter_id": 23104, "verse_number": "४-४०-१४२", "content_sanskrit": "भक्षिता विकृताकारैः कीटैः सर्पसमाकृतैः ।\nअतीव कातरा भीताः शब्दं कुर्वन्ति संततम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7003104142, "chapter_id": 23104, "verse_number": "४-४०-१४३", "content_sanskrit": "श्लेष्ममूत्रपुरीषाणि ध्रुवं भक्षन्ति क्षोभिताः ।\nउल्कां ददति रुष्टाश्च तन्मुखे यमकिंकराः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7003104143, "chapter_id": 23104, "verse_number": "४-४०-१४४", "content_sanskrit": "त्रिसन्ध्यं तर्जनं कृत्वा कुर्वन्ति दण्डताडनम् ।\nकुर्वन्ति मूत्रपानं च प्रहारैस्तृषितान्भिया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7003104144, "chapter_id": 23104, "verse_number": "४-४०-१४५", "content_sanskrit": "तदा कल्पान्तरे स्रष्टुं सृष्टिं च प्रथमे पुनः ।\nतेषां भवेत्प्रतीकार इत्याह कमलोद्भवः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7003104145, "chapter_id": 23104, "verse_number": "४-४०-१४६", "content_sanskrit": "कृत्वा हि शिवनिन्दां च यास्यन्ति नरकं सुराः ।\nइममेवोपकारं च कर्तुमिच्छथ पुत्रकाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7003104146, "chapter_id": 23104, "verse_number": "४-४०-१४७", "content_sanskrit": "ब्रह्मणा प्रेरितो दक्षो दत्त्वा शूलभृते सुताम् ।\nन पापं परमैश्वर्यं संप्राप हरनिन्दकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7003104147, "chapter_id": 23104, "verse_number": "४-४०-१४८", "content_sanskrit": "अनिच्छया सुतां दत्त्वा तुर्यपुण्यं ललाभ सः ।\nअहो विहाय सारूप्यं तुच्छं स्वर्गं ललाभ सः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7003104148, "chapter_id": 23104, "verse_number": "४-४०-१४९", "content_sanskrit": "कश्चिन्मध्ये च युष्माकं गत्वा शैलगृहं सुराः ।\nसंपादयतु स्वमतं शैलेन्द्रस्य प्रयत्नतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7003104149, "chapter_id": 23104, "verse_number": "४-४०-१५०", "content_sanskrit": "अनिच्छया सुतां दत्त्वा सुखं तिष्ठतु भारते ।\nतस्मै भक्त्या सुतां दत्त्वा मोक्षं प्राप्स्यति निश्चितम् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7003104150, "chapter_id": 23104, "verse_number": "४-४०-१५१", "content_sanskrit": "पश्चात्सप्तर्षयः सर्वे गृहीत्वा तामरुन्धतीम् ।\nध्रुवं तस्य गृहं गत्वा बोधयिष्यन्ति पर्वतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7003104151, "chapter_id": 23104, "verse_number": "४-४०-१५२", "content_sanskrit": "विना पिनाकिनं दुर्गा वरं नान्यं वरिष्यति ।\nअनिच्छया सुतां तस्मै प्रदास्यति सुताज्ञया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7003104152, "chapter_id": 23104, "verse_number": "४-४०-१५३", "content_sanskrit": "इत्येवं कथितं सर्वं देवा गच्छन्तु मन्दिरम् ।\nइत्युक्त्वा वाक्पतिः शीघ्रं तपसे स्वर्णदीं गतः ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}]