[{"id": 2173240, "chapter_id": 4688, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173241, "chapter_id": 4688, "verse_number": "१", "content_sanskrit": "दुर्योधनो महाराज धृष्टद्युम्नश्च पार्षतः ।\nचक्रतुः सुमहद्युद्धं शरशक्तिसमाकुलम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173242, "chapter_id": 4688, "verse_number": "२", "content_sanskrit": "तयो राजन् समापेतुः शरधाराः सहस्रशः ।\nअम्बुदानां यथा काले जलधाराः समन्ततः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173243, "chapter_id": 4688, "verse_number": "३", "content_sanskrit": "राजा तु पार्षतं विद्ध्वा शरैः सन्नतपर्वभिः ।\nद्रोणहन्तारमुग्रैस्तु पुनर्विव्याध सप्तभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173244, "chapter_id": 4688, "verse_number": "४", "content_sanskrit": "धृष्टद्युम्नश्च समरे बलवान् दृढविक्रमः ।\nसप्तत्या विशिखानां वै दुर्योधनमपीडयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173245, "chapter_id": 4688, "verse_number": "५", "content_sanskrit": "पीडितं प्रेक्ष्य राजानं सोदर्या भरतर्षभ ।\nमहत्या सेनया सार्धं परिवव्रुश्च पार्षतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173246, "chapter_id": 4688, "verse_number": "६", "content_sanskrit": "स तैः परिवृतः शूरैः सर्वतोऽतिरथैर्भृशम् ।\nव्यचरत् समरे राजन् दर्शयन् हस्तलाघवम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173247, "chapter_id": 4688, "verse_number": "७", "content_sanskrit": "शिखण्डी कृतवर्माणं गौतमं च महारथम् ।\nप्रभद्रकैः समायुक्तो योधयामास धन्विनौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173248, "chapter_id": 4688, "verse_number": "८", "content_sanskrit": "ततस्तौ च महायुद्धे यमतुल्यपराक्रमौ ।\nयोधयामास समरे वीरैर्दुर्मन्त्रिते तव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173249, "chapter_id": 4688, "verse_number": "९", "content_sanskrit": "तत्रासीत् सुमहद्युद्धं घोररूपं विशाम्पते ।\nप्राणान् सन्त्यजतोर्युद्धे प्राणद्यूताभिदेविनोः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173250, "chapter_id": 4688, "verse_number": "१०", "content_sanskrit": "शल्यस्तु शरवर्षाणि विमुञ्चन् सर्वतो दिशम् ।\nपाण्डवान् पीडयामास ससात्यकिवृकोदरान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173251, "chapter_id": 4688, "verse_number": "११", "content_sanskrit": "शल्यसायकभिन्नानां पाण्डवानां महामृधे ।\nत्रातारं नाध्यगच्छन्त तत्र केचिन्महारथाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173252, "chapter_id": 4688, "verse_number": "१२", "content_sanskrit": "ततस्तु नकुलः शूरो धर्मराजे प्रपीडिते ।\nअभिदुद्राव वेगेन मातुलं माद्रिनन्दनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173253, "chapter_id": 4688, "verse_number": "१३", "content_sanskrit": "सञ्छाद्य समरे शल्यं नकुलः परवीरहा ।\nविव्याध चैनं दशभिः स्मयमानः स्तनान्तरे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173254, "chapter_id": 4688, "verse_number": "१४", "content_sanskrit": "सर्वपारशवैर्बाणैः कर्मारपरिमार्जितैः ।\nसुवर्णपुङ्खैर्विशिखैः धनुर्यन्त्रप्रपीडितैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173255, "chapter_id": 4688, "verse_number": "१५", "content_sanskrit": "शल्यस्तु पीडितस्तेन स्वस्रीयेण तु मातुलः ।\nनकुलं पीडयामास शरैः सन्नतपर्वभिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173256, "chapter_id": 4688, "verse_number": "१६", "content_sanskrit": "ततो युधिष्ठिरो राजा भीमसेनश्च सात्यकिः ।\nसहदेवश्च माद्रेयो मद्रराजमुपाद्रवन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173257, "chapter_id": 4688, "verse_number": "१७", "content_sanskrit": "तानापतत एवाशु पूरयाणान् रथस्वनैः ।\nदिशश्च प्रदिशश्चैव कम्पयानांश्च मेदिनीम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173258, "chapter_id": 4688, "verse_number": "१८", "content_sanskrit": "प्रतिजग्राह समरे सेनापतिरमित्रजित्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173259, "chapter_id": 4688, "verse_number": "१९", "content_sanskrit": "युधिष्ठिरं त्रिभिर्विद्ध्वा भीमसेनं च पञ्चभिः ।\nसात्यकिं च शतेनाजौ सहदेवं त्रिभिः शरैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173260, "chapter_id": 4688, "verse_number": "२०", "content_sanskrit": "ततस्तु सशरं चापं नकुलस्य महात्मनः ।\nमद्रेश्वरः क्षुरप्रेण मध्ये चिच्छेद मारिष\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173261, "chapter_id": 4688, "verse_number": "२१", "content_sanskrit": "तदपास्य धनुश्छिन्नं ततः शल्यस्य सायकैः ।\nअथान्यद् धनुरादाय माद्रीपुत्रो महाबलः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173262, "chapter_id": 4688, "verse_number": "२२", "content_sanskrit": "मद्रराजरथं तूर्णं पूरयामास पत्रिभिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173263, "chapter_id": 4688, "verse_number": "२३", "content_sanskrit": "युधिष्ठिरस्तु मद्रेशं सहदेवश्च मारिष ।\nदशभिर्दशभिर्बाणैः उरस्येनम् अपीड्यताम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173264, "chapter_id": 4688, "verse_number": "२४", "content_sanskrit": "भीमसेनस्तथा षष्ट्या सात्यकिर्नवभिः शरैः ।\nमद्रराजमभिद्रुत्य जघ्नतुः कङ्कपत्रिभिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173265, "chapter_id": 4688, "verse_number": "२५", "content_sanskrit": "मद्रराजस्ततः क्रुद्धः सात्यकिं दशभिः शरैः ।\nविव्याध भूयः सप्तत्या शराणां नतपर्वणाम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173266, "chapter_id": 4688, "verse_number": "२६", "content_sanskrit": "अथास्य सशरं चापं मुष्टौ चिच्छेद मारिष ।\nहयांश्च चतुरः सङ्खे प्रेषयामास मृत्यवे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173267, "chapter_id": 4688, "verse_number": "२७", "content_sanskrit": "विरथं सात्यकिं कृत्वा मद्रराजो महाबलः ।\nविशिखानां शतेनैनमाजघान समन्ततः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173268, "chapter_id": 4688, "verse_number": "२८", "content_sanskrit": "माद्रीपुत्रौ च संरब्धौ भीमसेनं च पाण्डवम् ।\nयुधिष्ठिरं च कौरव्य विव्याध निशितैः शरैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173269, "chapter_id": 4688, "verse_number": "२९", "content_sanskrit": "तत्राद्भुतमपश्याम मद्रराजस्य पौरुषम् ।\nयदेनं सहिताः पार्था नाभ्यवर्तन्त संयुगे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173270, "chapter_id": 4688, "verse_number": "३०", "content_sanskrit": "अथान्यं रथमास्थाय सात्यकिः सत्यविक्रमः ।\nपीडितान् पाण्डवान् दृष्ट्वा मद्रराजवशं गतान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173271, "chapter_id": 4688, "verse_number": "३१", "content_sanskrit": "अभिदुद्राव वेगेन मद्राणामधिपं बली\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173272, "chapter_id": 4688, "verse_number": "३२", "content_sanskrit": "आपतन्तं रथं तस्य शल्यः समितिशोभनः ।\nप्रत्युद्ययौ रथेनैनं मत्तो मत्तमिव द्विपम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173273, "chapter_id": 4688, "verse_number": "३३", "content_sanskrit": "स सन्निपातस्तुमुलो बभूवाद्भुतदर्शनः ।\nसात्यकेश्चैव शूरस्य मद्राणामधिपस्य च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173274, "chapter_id": 4688, "verse_number": "३४", "content_sanskrit": "यादृशो वै पुरा वृत्तः शम्बरामरराजयोः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173275, "chapter_id": 4688, "verse_number": "३५", "content_sanskrit": "सात्यकिः प्रेक्ष्य समरे मद्रराजमवस्थितम् ।\nविव्याध निशितैर्बाणैः तिष्ठ तिष्ठेति चाब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173276, "chapter_id": 4688, "verse_number": "३६", "content_sanskrit": "मद्रराजस्तु सुभृशं विद्धस्तेन महात्मना ।\nसात्यकिं प्रतिविव्याध विंशत्या निशितैः शरैः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173277, "chapter_id": 4688, "verse_number": "३७", "content_sanskrit": "ततः पार्था महेष्वासाः सात्वताभिमुखं नृपम् ।\nअभ्यद्रवन् रथैस्तूर्णं मातुलं वधकाम्यया\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173278, "chapter_id": 4688, "verse_number": "३८", "content_sanskrit": "तत आसीत् परामर्दः तुमुलः शोणितोदकः ।\nशूराणां युध्यमानानां सिंहानामिव गर्जताम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173279, "chapter_id": 4688, "verse_number": "३९", "content_sanskrit": "तेषामासीन्महाराज व्यतिक्षेपः परस्परम् ।\nसिंहानामामिषेप्सूनां गर्जतामिव संयुगे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173280, "chapter_id": 4688, "verse_number": "४०", "content_sanskrit": "तेषां बाणसहस्रौघैः आकीर्णा वसुधाऽभवत् ।\nअन्तरिक्षं च सहसा बाणभूतमभूत् तदा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173281, "chapter_id": 4688, "verse_number": "४१", "content_sanskrit": "शरान्धकारे महति कृते तत्र समन्ततः ।\nअभ्रच्छायेव सञ्जज्ञे शरैः पूर्णैर्महात्मभिः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173282, "chapter_id": 4688, "verse_number": "४२", "content_sanskrit": "तत्र राजन् शरैर्मुक्तैः निर्मुक्तैरिव पन्नगैः ।\nरुग्मपुङ्खैः प्रकाशद्भिः व्यराजन्त दिशस्तथा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173283, "chapter_id": 4688, "verse_number": "४३", "content_sanskrit": "तत्राद्भुतं परं चक्रे शल्यः शत्रुनिबर्हणः ।\nतदेकः समरे शूरो योधयामास वै बहून्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173284, "chapter_id": 4688, "verse_number": "४४", "content_sanskrit": "मद्रराजभुजोत्सृष्टैः कङ्कबर्हिणवाजितैः ।\nसम्पतद्भिः शरैर्घोरैरवाकीर्यत मेदिनी\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173285, "chapter_id": 4688, "verse_number": "४५", "content_sanskrit": "तत्र शल्यरथं घोरं विचरन्तं महाहवे ।\nअपश्याम यथापूर्वं शक्रस्यासुरसङ्क्षये\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173286, "chapter_id": 4688, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173287, "chapter_id": 4688, "verse_number": "१५", "content_sanskrit": "शल्यवधपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]