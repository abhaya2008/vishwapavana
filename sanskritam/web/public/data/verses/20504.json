[{"id": 7000504000, "chapter_id": 20504, "verse_number": "३-५१-१", "content_sanskrit": "ऋषय ऊचु ।\nकर्मयोगः कथं सूत येन चाराधितो हरिः ।\nप्रसीदति महाभाग वद नो वदतां वर॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000504001, "chapter_id": 20504, "verse_number": "३-५१-२", "content_sanskrit": "येनासौ भगवानीशः समाराध्यो मुमुक्षुभिः ।\nतद्वदाखिललोकानां रक्षणं धर्मसंग्रहम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000504002, "chapter_id": 20504, "verse_number": "३-५१-३", "content_sanskrit": "तं कर्मयोगं वद नः सूत मूर्तिमयस्तु यः ।\nइति शुश्रूषवो विप्रा भवदग्रे व्यवस्थिताः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000504003, "chapter_id": 20504, "verse_number": "३-५१-४", "content_sanskrit": "सूत उवाच ।\nएवमेव पुरा पृष्टो व्यासः सत्यवतीसुतः ।\nऋषिभिरग्निसंकाशैर्व्यासस्तानाह तच्छृणु॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000504004, "chapter_id": 20504, "verse_number": "३-५१-५", "content_sanskrit": "व्यास उवाच ।\nशृणुध्वंमृषयः सर्वे वक्ष्यमाणं सनातनम् ।\nकर्मयोगं ब्राह्मणानामात्यंतिकफलप्रदम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000504005, "chapter_id": 20504, "verse_number": "३-५१-६", "content_sanskrit": "आम्नायसिद्धमखिलं ब्राह्मणार्थं प्रदर्शितम् ।\nऋषीणां शृण्वतां पूर्वं मनुराह प्रजापतिः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000504006, "chapter_id": 20504, "verse_number": "३-५१-७", "content_sanskrit": "सर्वव्याधिहरं पुण्यमृषिसंघैर्निषेवितम् ।\nसमाहितधियो यूयं शृणुध्वं गदतो मम॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000504007, "chapter_id": 20504, "verse_number": "३-५१-८", "content_sanskrit": "कृतोपनयनो वेदानधीयीत द्विजोत्तमः ।\nगर्भाष्टमेऽष्टमेवाब्दे स्वसूत्रोक्तविधानतः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000504008, "chapter_id": 20504, "verse_number": "३-५१-९", "content_sanskrit": "दंडी च मेखली सूत्री कृष्णाजिनधरो मुनिः ।\nभिक्षाहारो गुरुहितो वीक्ष्यमाणो गुरोर्मुखम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000504009, "chapter_id": 20504, "verse_number": "३-५१-१०", "content_sanskrit": "कार्पासमुपवीतार्थं निर्मितं ब्रह्मणा पुरा ।\nब्राह्मणानां त्रिवृत्सूत्रं कौशं वा वस्त्रमेव वा॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000504010, "chapter_id": 20504, "verse_number": "३-५१-११", "content_sanskrit": "सदोपवीती चैव स्यात्सदाबद्ध शिखो द्विजः ।\nअन्यथा यत्कृतं कर्म्म तद्भवत्ययथाकृतम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000504011, "chapter_id": 20504, "verse_number": "३-५१-१२", "content_sanskrit": "वसेदविकृतं वासः कार्पासं वा कषायकम् ।\nतदेव परिधानीयं शुक्लं तांतवमुत्तमम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000504012, "chapter_id": 20504, "verse_number": "३-५१-१३", "content_sanskrit": "उत्तरं तु समाम्नातं वासः कृष्णाजिनं शुभम् ।\nअभावे गावयमपि रौरवं वा विधीयते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000504013, "chapter_id": 20504, "verse_number": "३-५१-१४", "content_sanskrit": "उद्धृत्य दक्षिणं बाहुं सव्यबाहौ समर्पितम् ।\nउपवीतं भवेन्नित्यं निवीतं कंठसज्जने॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000504014, "chapter_id": 20504, "verse_number": "३-५१-१५", "content_sanskrit": "सव्यबाहुं समुद्धृत्य दक्षिणे तु धृतं द्विजाः ।\nप्राचीनावीतमित्युक्तं पित्र्येकर्मणि योजयेत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000504015, "chapter_id": 20504, "verse_number": "३-५१-१६", "content_sanskrit": "अग्न्यागारे गवां गोष्ठे होमे तप्ये तथैव च ।\nस्वाध्याये भोजने नित्यं ब्राह्मणानां च सन्निधौ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000504016, "chapter_id": 20504, "verse_number": "३-५१-१७", "content_sanskrit": "उपासने गुरूणां च संध्ययोः साधुसंगमे ।\nउपवीती भवेन्नित्यं विधिरेष सनातनः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000504017, "chapter_id": 20504, "verse_number": "३-५१-१८", "content_sanskrit": "मौंजी त्रिवृत्समां श्लिष्टां कुर्याद्विप्रस्य मेखलाम् ।\nमुंजाभावे कुशेनाहुर्ग्रंथिनैकेन वा त्रिभिः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000504018, "chapter_id": 20504, "verse_number": "३-५१-१९", "content_sanskrit": "धारयेद्वैणवपालाशौ दंडौ केशांतिकौ द्विजः ।\nयज्ञार्हवृक्षजं वाथ सौम्यमव्रणमेव च॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000504019, "chapter_id": 20504, "verse_number": "३-५१-२०", "content_sanskrit": "सायंप्रातर्द्विजः संध्यामुपासीत समाहितः ।\nकामाल्लोभाद्भयान्मोहात्त्यक्त्वैनां पतितो भवेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000504020, "chapter_id": 20504, "verse_number": "३-५१-२१", "content_sanskrit": "अग्निकार्यं ततः कुर्यात्सायंप्रातः प्रसन्नधीः ।\nस्नात्वा संतर्पयेद्देवानृषीन्पितृगणांस्तथा॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000504021, "chapter_id": 20504, "verse_number": "३-५१-२२", "content_sanskrit": "देवताभ्यर्चनं कुर्यात्पुष्पैः पत्रैर्यवांबुभिः ।\nअभिवादनशीलः स्यान्नित्यं वृद्धेषु धर्मतः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000504022, "chapter_id": 20504, "verse_number": "३-५१-२३", "content_sanskrit": "असावहं भो नामेति सम्यक्प्रणतिपूर्वकम् ।\nआयुरारोग्यसिद्ध्यर्थं तंद्रादिपरिवर्जितः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000504023, "chapter_id": 20504, "verse_number": "३-५१-२४", "content_sanskrit": "आयुष्मान्भव सौम्येति वचो विप्रोऽभिवादने ।\nआकारश्चास्य नाम्नोंऽते वाच्यः पूर्वाक्षरप्लुतः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000504024, "chapter_id": 20504, "verse_number": "३-५१-२५", "content_sanskrit": "यो न वेत्त्यभिवादस्य विप्रः प्रत्यभिवादनम् ।\nनाभिवाद्यः स विदुषा यथा शूद्रस्तथैव सः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000504025, "chapter_id": 20504, "verse_number": "३-५१-२६", "content_sanskrit": "व्यत्यस्तपाणिना कार्यं पादसंग्रहणं गुरोः ।\nसव्येन सव्यः स्प्रष्टव्यो दक्षिणेन तु दक्षिणः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000504026, "chapter_id": 20504, "verse_number": "३-५१-२७", "content_sanskrit": "लौकिकं वैदिकं वापि तथाध्यात्मिकमेव वा ।\nअवाप्य प्रयतो ज्ञानं तं पूर्वमभिवादयेत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000504027, "chapter_id": 20504, "verse_number": "३-५१-२८", "content_sanskrit": "नोदकं धारयेद्भैक्ष्यं पुष्पाणि समिधस्तथा ।\nएवंविधानि चान्यानि न देवार्थेषु कर्म्मसु॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000504028, "chapter_id": 20504, "verse_number": "३-५१-२९", "content_sanskrit": "ब्राह्मणं कुशलं पृच्छेत्क्षत्रबंधुमनामयम् ।\nवैश्यं क्षेमं समागम्य शूद्रमारोग्यमेव च॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000504029, "chapter_id": 20504, "verse_number": "३-५१-३०", "content_sanskrit": "उपाध्यायः पिता ज्येष्ठो भ्राता त्राता च भीतितः ।\nमातुलः श्वशुरश्चैव मातामह पितामहौ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000504030, "chapter_id": 20504, "verse_number": "३-५१-३१", "content_sanskrit": "वर्णश्रेष्ठः पितृव्यश्च पुंसोऽत्र गुरवः स्मृताः ।\nमाता मातामही गुर्वी पितुर्मातुश्च सोदराः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000504031, "chapter_id": 20504, "verse_number": "३-५१-३२", "content_sanskrit": "श्वश्रूः पितामही ज्येष्ठा धात्री च गुरवः स्त्रियः ।\nज्ञेयस्तु गुरुवर्गोऽयं मातृतः पितृतो द्विजाः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000504032, "chapter_id": 20504, "verse_number": "३-५१-३३", "content_sanskrit": "अनुवर्तनमेतेषां मनोवाक्कायकर्मभिः ।\nगुरून्दृष्ट्वा समुत्तिष्ठेदभिवाद्य कृताञ्जलि॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000504033, "chapter_id": 20504, "verse_number": "३-५१-३४", "content_sanskrit": "नैतैरुपविशेत्सार्द्धं विवदेन्नात्मकारणात् ।\nजीवितार्थमपि द्वेषाद्गुरुभिर्नैव भाषणम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000504034, "chapter_id": 20504, "verse_number": "३-५१-३५", "content_sanskrit": "उद्रिक्तोऽपि गुणैरन्यैर्गुरुद्वेषी पतत्यधः ।\nगुरूणामपि सर्वेषां पंच पूज्या विशेषतः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000504035, "chapter_id": 20504, "verse_number": "३-५१-३६", "content_sanskrit": "तेषामाद्यास्त्रयः श्रेष्ठास्तेषां माता सुपूजिता ।\nयो भावयति या सूते येन विद्योपदिश्यते॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000504036, "chapter_id": 20504, "verse_number": "३-५१-३७", "content_sanskrit": "ज्येष्ठो भ्राता च भर्ता च पंचैते गुरवः स्मृताः ।\nआत्मनः सर्वयत्नेन प्राणत्यागेन वा पुनः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000504037, "chapter_id": 20504, "verse_number": "३-५१-३८", "content_sanskrit": "पूजनीया विशेषेण पंचैते भूतिमिच्छता ।\nयावत्पिता च माता च द्वावेतौ निर्विकारिणौ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000504038, "chapter_id": 20504, "verse_number": "३-५१-३९", "content_sanskrit": "तावत्सर्वं परित्यज्य पुत्रः स्यात्तत्परायणः ।\nपिता माता च सुप्रीतौ स्यातां पुत्रगुणैर्यदि॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000504039, "chapter_id": 20504, "verse_number": "३-५१-४०", "content_sanskrit": "स पुत्रः सकलं धर्मं प्राप्नुयात्तेन कर्मणा ।\nनास्ति मातृसमं दैवं नास्ति पितृसमो गुरुः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000504040, "chapter_id": 20504, "verse_number": "३-५१-४१", "content_sanskrit": "तयोः प्रत्युपकारोऽपि न कथंचन विद्यते ।\nतयोर्नित्यं प्रियं कुर्यात्कर्मणा मनसा गिरा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000504041, "chapter_id": 20504, "verse_number": "३-५१-४२", "content_sanskrit": "न ताभ्यामननुज्ञातो धर्ममन्यं समाचरेत् ।\nवर्जयित्वा मुक्तिफलं नित्यं नैमित्तिकं तथा॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000504042, "chapter_id": 20504, "verse_number": "३-५१-४३", "content_sanskrit": "धर्मसारः समुद्दिष्टः प्रेत्यानंतफलप्रदः ।\nसम्यगाराध्य वक्तारं विसृष्टस्तदनुज्ञया॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000504043, "chapter_id": 20504, "verse_number": "३-५१-४४", "content_sanskrit": "शिष्यो विद्याफलं भुंक्ते प्रेत्य चापद्यते दिवि ।\nयो भ्रातरं पितृसमं ज्येष्ठं मूढोऽवमन्यते॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000504044, "chapter_id": 20504, "verse_number": "३-५१-४५", "content_sanskrit": "तेन दोषेण संप्रेत्य निरयं घोरमृच्छति ।\nपुंसां वर्त्मनि सृष्टेन पूज्यो भर्ता तु सर्वदा॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000504045, "chapter_id": 20504, "verse_number": "३-५१-४६", "content_sanskrit": "अपि मातरि लोकेऽस्मिन्नुपकाराद्धि गौरवम् ।\nमातुलांश्च पितृव्यांश्च श्वशुरानृत्विजो गुरून्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000504046, "chapter_id": 20504, "verse_number": "३-५१-४७", "content_sanskrit": "असावहमिति ब्रूयात्प्रत्युत्थायाभिवादयेत् ।\nअवाच्यो दीक्षितो नाम्ना यवीयानपि यो भवेत्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000504047, "chapter_id": 20504, "verse_number": "३-५१-४८", "content_sanskrit": "भो भवत्पूर्वकं त्वेनमभिभाषेत धर्मवित् ।\nअभिवाद्यश्च पूज्यश्च शिरसानम्य एव च॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000504048, "chapter_id": 20504, "verse_number": "३-५१-४९", "content_sanskrit": "ब्राह्मणक्षत्रियाद्यैश्च श्रीकामैः सादरं सदा ।\nनाभिवाद्याश्च विप्रेण क्षत्रियाद्याः कथंचन॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000504049, "chapter_id": 20504, "verse_number": "३-५१-५०", "content_sanskrit": "ज्ञानकर्मगुणोपेता यद्यप्येते बहुश्रुताः ।\nब्राह्मणः सर्ववर्णानां स्वस्ति कुर्यादिति श्रुतिः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000504050, "chapter_id": 20504, "verse_number": "३-५१-५१", "content_sanskrit": "सवर्णेन सवर्णानां कार्यमेवाभिवादनम् ।\nगुरुरग्निर्द्विजातीनां वर्णानां ब्राह्मणो गुरुः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000504051, "chapter_id": 20504, "verse_number": "३-५१-५२", "content_sanskrit": "पतिरेको गुरुः स्त्रीणां सर्वत्राभ्यागतो गुरुः ।\nविद्याकर्मवयोबंधुर्वित्तं भवति पंचमम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000504052, "chapter_id": 20504, "verse_number": "३-५१-५३", "content_sanskrit": "मान्यस्थानानि पंचाहुः पूर्वं पूर्वं गुरूत्तरात् ।\nपंचानां त्रिषु वर्णेषु भूयांसि बलवंति च॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000504053, "chapter_id": 20504, "verse_number": "३-५१-५४", "content_sanskrit": "यत्र स्युः सोऽत्र मानार्हः शूद्रोऽपि दशमीं गतः ।\nपंथा देयो ब्राह्मणाय स्त्रियै राज्ञे विचक्षुषे॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000504054, "chapter_id": 20504, "verse_number": "३-५१-५५", "content_sanskrit": "वृद्धाय भारभग्नाय रोगिणे दुर्बलाय च ।\nभिक्षामाहृत्य शिष्टानां गृहेभ्यः प्रयतोऽन्वहम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000504055, "chapter_id": 20504, "verse_number": "३-५१-५६", "content_sanskrit": "निवेद्य गुरुवेऽश्नीयाद्वाग्यतस्तदनुज्ञया ।\nभवत्पूर्वं चरेद्भैक्ष्यमुपवीती द्विजोत्तमः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000504056, "chapter_id": 20504, "verse_number": "३-५१-५७", "content_sanskrit": "भवन्मध्यं तु राजन्यो वैश्यस्तु भवदुत्तरम् ।\nमातरं वा स्वसारं वा मातुर्वा भगिनीं निजाम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000504057, "chapter_id": 20504, "verse_number": "३-५१-५८", "content_sanskrit": "भिक्षेत भिक्षांप्रथमं याचैनं न विमानयेत् ।\nसजातीयगृहेष्वेव सार्ववर्णिकमेव वा॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000504058, "chapter_id": 20504, "verse_number": "३-५१-५९", "content_sanskrit": "भैक्ष्यस्याचरणं प्रोक्तं पतिता दिवि वर्जितम् ।\nवेदयज्ञैरहीनानां प्रशस्तानां स्वकर्म्मसु॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000504059, "chapter_id": 20504, "verse_number": "३-५१-६०", "content_sanskrit": "ब्रह्मचार्य्याहरेद्भैक्ष्यं गृहेभ्यः प्रयतोऽन्वहम् ।\nगुरोः कुले न भिक्षेत न ज्ञातिकुलबंधुषु॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000504060, "chapter_id": 20504, "verse_number": "३-५१-६१", "content_sanskrit": "अलाभेत्वन्यगेहानां पूर्वं पूर्वं विवर्जयेत् ।\nसर्वं वा विचरेद्ग्रामं पूर्वोक्तानामसंभवे॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000504061, "chapter_id": 20504, "verse_number": "३-५१-६२", "content_sanskrit": "नियम्य प्रयतो वाचं दिशस्त्वनवलोकयन् ।\nसमाहृत्य तु भैक्ष्यान्नं यावदर्थममायया॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000504062, "chapter_id": 20504, "verse_number": "३-५१-६३", "content_sanskrit": "भुंजीत प्रयतो नित्यं वाग्यतोऽनन्यमानसः ।\nभैक्ष्येण वर्तयेन्नित्यं नैवेकान्नो भवेद्व्रती॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000504063, "chapter_id": 20504, "verse_number": "३-५१-६४", "content_sanskrit": "भैक्ष्यैण वर्त्तिनो वृत्तिरुपवाससमा स्मृता ।\nपूजयेदशनं नित्यमद्याच्चैनमकुत्सयन्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000504064, "chapter_id": 20504, "verse_number": "३-५१-६५", "content_sanskrit": "दृष्ट्वा हृष्येत्प्रसीदेच्च प्रतिनंदेच्च सर्वशः ।\nअनारोग्यमनायुष्यमस्वर्ग्यं चातिभोजनम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000504065, "chapter_id": 20504, "verse_number": "३-५१-६६", "content_sanskrit": "अपुण्यं लोकविद्विष्टं तस्मात्तत्परिवर्जयेत् ।\nप्राङ्मुखोऽन्नानि भुंजीत सूर्याभिमुखमेव वा॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000504066, "chapter_id": 20504, "verse_number": "३-५१-६७", "content_sanskrit": "नाद्यादुदङ्मुखो नित्यं विधिरेष सनातनः ।\nप्रक्षाल्य पाणिपादौ च भुंजानो द्विरुपस्पृशेत्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000504067, "chapter_id": 20504, "verse_number": "३-५१-६८", "content_sanskrit": "शुद्धे देशे समासीनो भुक्त्वा च द्विरुपस्पृशेत्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]