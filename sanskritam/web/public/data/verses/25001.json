[{"id": 7005001000, "chapter_id": 25001, "verse_number": "७-१-१८४-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि मंकीश्वरमनुत्तमम् ।\nत्रिसंगमसमीपस्थं सर्वपातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005001001, "chapter_id": 25001, "verse_number": "७-१-१८४-२", "content_sanskrit": "मंकीनाम ऋषिः पूर्वमासीत्स तपतां वरः ।\nस च ज्ञात्वा महाक्षेत्रं प्रभासं शंकरप्रियम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005001002, "chapter_id": 25001, "verse_number": "७-१-१८४-३", "content_sanskrit": "अतपद्वै तपो घोरं कन्दमूलफलाशनः ।\nवर्षाणामयुतं साग्रं प्रतिष्ठाप्य महेश्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005001003, "chapter_id": 25001, "verse_number": "७-१-१८४-४", "content_sanskrit": "ततस्तुष्टो महादेवो ददौ प्रीतो वरं तदा ।\nस वव्रे यदि तुष्टोऽसि अस्मिन्स्थाने स्थितो भव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005001004, "chapter_id": 25001, "verse_number": "७-१-१८४-५", "content_sanskrit": "मन्नामांकितलिंगस्तु वस कल्पायुतायुतम् ।\nएवमस्त्वित्यथेत्युक्त्वा तत्रैवान्तरधीयत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005001005, "chapter_id": 25001, "verse_number": "७-१-१८४-६", "content_sanskrit": "तदाप्रभृति तल्लिंगं मंकीश्वरमिति श्रुतम् ।\nमाघे मासे त्रयोदश्यां चतुर्दश्यामथापि वा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005001006, "chapter_id": 25001, "verse_number": "७-१-१८४-७", "content_sanskrit": "पूज्याः पंचोपचारेण प्राप्नुयादीप्सितं फलम् ।\nगोदानं तत्र वै देयं सम्यग्यात्राफलेप्सुभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005001007, "chapter_id": 25001, "verse_number": "७-१-१८४-८", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां सहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये मंकीश्वरमाहात्म्यवर्णनंनाम चतुरशीत्युत्तरशततमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]