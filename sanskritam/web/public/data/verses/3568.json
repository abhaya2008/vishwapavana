[{"id": 2119547, "chapter_id": 3568, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119548, "chapter_id": 3568, "verse_number": "१", "content_sanskrit": "सभा वैश्रवणी राजन् शतयोजनमायता ।\nविस्तीर्णा सप्ततिश्चैव योजनानां सितप्रभा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119549, "chapter_id": 3568, "verse_number": "२", "content_sanskrit": "तपसा निर्मिता राजन् स्वयं वैश्रवणेन सा ।\nशशिप्रभा खेचराणां कैलासशिखरोपमा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119550, "chapter_id": 3568, "verse_number": "३", "content_sanskrit": "गुह्यकैरुह्यमाना सा खे विषक्तेव दृश्यते ।\nदिव्यैर्हेममयैरग्य्रैः पादपैरुपशोभिता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119551, "chapter_id": 3568, "verse_number": "४", "content_sanskrit": "अर्चिष्मती भास्वरा च दिव्यगन्धा मनोरमा ।\nसिताभ्रनिचयाकारा प्लवमानेव दृश्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119552, "chapter_id": 3568, "verse_number": "५", "content_sanskrit": "तस्यां वैश्रवणो राजा विचित्राभरणाम्बरः ।\nसहितः त्रिदशैः सार्धमास्ते रुचिरकुण्डलः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119553, "chapter_id": 3568, "verse_number": "६", "content_sanskrit": "स हि पत्न्न्या महाराज ऋद्ध्या सह विराजते ।\nसर्वाभरणभूषिण्या वपुष्मत्या धनेश्वरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119554, "chapter_id": 3568, "verse_number": "७", "content_sanskrit": "दिवाकरनिभे दिव्ये दिव्यास्तरणसंवृते ।\nदिव्यपादोपधाने च निषण्णः परमासने\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119555, "chapter_id": 3568, "verse_number": "८", "content_sanskrit": "मन्दाराणामुदाराणां वनानि सुरभीण्यथ ।\nसौगन्धिकानां चादाय गन्धं गन्धवहः शुचिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119556, "chapter_id": 3568, "verse_number": "९", "content_sanskrit": "नलिन्याश्चारुमुख्यायाः चन्दनानां वनस्य च ।\nमनोहृदयसंह्लादी वायुस्तमुपसेवते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119557, "chapter_id": 3568, "verse_number": "१०", "content_sanskrit": "यत्र ते देवगन्धर्वा गणैरप्सरसां वृताः ।\nदिव्यतानेषु गीतानि गायन्ति भरतर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119558, "chapter_id": 3568, "verse_number": "११", "content_sanskrit": "मिश्रकेशी च रम्भा च चित्रसेना शुचिस्मिता ।\nचारुदेष्णा घृताची च मेनका पुञ्जिकस्थला\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119559, "chapter_id": 3568, "verse_number": "१२", "content_sanskrit": "विश्वाची सहजन्या च प्रम्लोचन्त्युर्वशी तथा ।\nदिव्या च सौरभेयी च देवी रम्भा मनोरमा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119560, "chapter_id": 3568, "verse_number": "१३", "content_sanskrit": "गोपाली पञ्चचूळा च विद्युद्वर्णा सुलोचना ।\nचित्रदेवी च नीला च काम्या च ललिता तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119561, "chapter_id": 3568, "verse_number": "१४", "content_sanskrit": "एताः सहस्रशश्चान्या नृत्तगीतविशारदाः ।\nउपतिष्ठन्ति राजानं पाण्डवाप्सरसां गणाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119562, "chapter_id": 3568, "verse_number": "१५", "content_sanskrit": "अनिशं गीतवादित्रैर्नृत्तगीतैश्च सा सभा ।\nअशून्या रुचिरा भाति गन्धर्वाप्सरसां गणैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119563, "chapter_id": 3568, "verse_number": "१६", "content_sanskrit": "गन्धर्वाणां च पतयो विश्वावसुर्हहा हुहूः ।\nतुम्बुरुः पर्वतश्चैव शैलूषस्त्वथ नारदः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119564, "chapter_id": 3568, "verse_number": "१७", "content_sanskrit": "चित्रसेनश्च गीतज्ञः तथा चित्ररथोऽपि च ।\nएते चान्ये च गन्धर्वा धनेश्वरमुपासते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119565, "chapter_id": 3568, "verse_number": "१८", "content_sanskrit": "विद्याधराधिपश्चैव चन्द्रापीडस्तथानुजैः ।\nउपासते महात्मानं धनानामीश्वरं प्रभुम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119566, "chapter_id": 3568, "verse_number": "१९", "content_sanskrit": "किन्नराः शतशस्तत्र भगदत्तपुरोगमाः ।\nद्रुमः किम्पुरुषेशश्च उपास्ते धनदेश्वरम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119567, "chapter_id": 3568, "verse_number": "२०", "content_sanskrit": "राक्षसानां पतिश्चैव सह सर्वैर्निशाचरैः ।\nविभीषणः सुधर्मिष्ठ उपास्ते भ्रातरं प्रभुम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119568, "chapter_id": 3568, "verse_number": "२१", "content_sanskrit": "निधीनां प्रवरौ मुख्यौ शङ्खपद्मौ धनेश्वरम् ।\nसर्वान् निधीन् प्रगृह्यैतावुपासाते महेश्वरम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119569, "chapter_id": 3568, "verse_number": "२२", "content_sanskrit": "किन्नरा नाम गन्धर्वा नरा नाम तथाऽपरे ।\nमाणिभद्रश्च धनदं श्वेतभद्रश्च गुह्यकः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119570, "chapter_id": 3568, "verse_number": "२३", "content_sanskrit": "स्थूणश्च सूर्यभानुश्च तथा शोणिकतिन्दुकौ ।\nकुशेरलो गन्धपणो वृषोदश्च महाबलः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119571, "chapter_id": 3568, "verse_number": "२४", "content_sanskrit": "द्रूमः किम्पुरुषश्चैव गजकर्णो विशालकः ।\nवराहकर्णः सङ्कृष्टः फलभक्षः फलोदकः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119572, "chapter_id": 3568, "verse_number": "२५", "content_sanskrit": "अङ्गचूडः शिलापुष्पो हेमनेत्रो विभूषणः ।\nपुष्पाननः पिङ्गलकः शोणितोदः प्रपालितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119573, "chapter_id": 3568, "verse_number": "२६", "content_sanskrit": "वृक्षपार्श्वो निकेतश्च चीरवासास्तथैव च ।\nएते चान्ये च बहवो यक्षाः शतसहस्रशः ।\nउपासते सदा श्रीश्च तथैव नलकूबरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119574, "chapter_id": 3568, "verse_number": "२७", "content_sanskrit": "हिमवान् पारियात्रश्च विन्ध्यकैलासमन्दराः ।\nमलयो दर्दुरश्चैव महेन्द्रो गन्धमादनः ।\nइन्द्रनीलः सुनाभश्च उदयास्तौ च पर्वतौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119575, "chapter_id": 3568, "verse_number": "२८", "content_sanskrit": "एते चान्ये च बहवः सर्वे मेरुपुरोगमाः ।\nउपासते महात्मानं धनानामीश्वरं प्रभुम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119576, "chapter_id": 3568, "verse_number": "२९", "content_sanskrit": "अहं च बहुशस्तत्र तथा देवर्षयोऽपरे ।\nभगवान् भूतसङ्घैश्च वृतः सततमीश्वरः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119577, "chapter_id": 3568, "verse_number": "३०", "content_sanskrit": "उमापतिः पशुपतिः शूलधृग् भगनेत्रहा ।\nत्र्यम्बको विश्वरूपश्च देवी च विगतक्लमा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119578, "chapter_id": 3568, "verse_number": "३१", "content_sanskrit": "नन्दीश्वरश्च भगवान् महाकालस्तथैव च ।\nशङ्कुकर्णमुखाः सर्वे दिव्याः पारिषदास्तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119579, "chapter_id": 3568, "verse_number": "", "content_sanskrit": "काष्ठकूटः सोमनन्दी विजयश्च तपोधिकः ।\nश्वेतश्च वृषभस्तत्र नर्दन्नास्ते महारवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119580, "chapter_id": 3568, "verse_number": "३२", "content_sanskrit": "नैर्ऋता राक्षसाश्चान्ये गन्धर्वाश्च समासते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119581, "chapter_id": 3568, "verse_number": "३३", "content_sanskrit": "वामनैर्विकटैः कुब्जैः क्षतजाक्षैर्महारवैः ।\nमांसमेदोवसाहारैरुग्रश्रवणदर्शनैः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119582, "chapter_id": 3568, "verse_number": "३४", "content_sanskrit": "नानाप्रहरणैर्घोरैर्वातैरिव महाजवैः ।\nपरिषद्गणैः परिवृतमुपायान्तं महेश्वरम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119583, "chapter_id": 3568, "verse_number": "३५", "content_sanskrit": "तं दृष्ट्वा देवदेवेशं शिवं त्रैलोक्यभावनम् ।\nप्रणम्य मूर्ध्ना पौलस्त्यो बहुरूपमुमापतिम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119584, "chapter_id": 3568, "verse_number": "३६", "content_sanskrit": "ततोऽभ्यनुज्ञां सम्प्राप्य महादेवाद् धनेश्वरः ।\nआस्ते कदाचिद् भगवान् भवो धनपतेः सखा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119585, "chapter_id": 3568, "verse_number": "३७", "content_sanskrit": "सा सभा तादृशी राजन् मया दृष्टाऽन्तरिक्षगा ।\nपितामहसभां तात कथयिष्ये गतक्लमाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119586, "chapter_id": 3568, "verse_number": "१०", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि दशमोऽध्यायः ॥१०॥ ॥ मन्त्रपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119587, "chapter_id": 3568, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]