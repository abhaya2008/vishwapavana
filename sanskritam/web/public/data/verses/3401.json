[{"id": 2110998, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110999, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "चरन् गृहस्थः कथमेति देवान् तथा भिक्षुः कथमाचार्यकर्मा ।\nवानप्रस्थः सत्पथे सन्निविष्टो बहून्यस्मिन् सम्प्रति वेदयन्ति \t॥१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111000, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111001, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "आहूताध्यायी गुरुकर्मस्वचोद्यः पूर्वोत्थायी चरमं चोपशायी ।\nमुदुर्दान्तो धृतिमानप्रमत्तः \tस्वाध्यायशीलः सिध्यति ब्रह्मचारी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111002, "chapter_id": 3401, "verse_number": "३", "content_sanskrit": "धर्मागतं प्राप्य धनं यजेत \tदद्यात् सदैवाप्यतिथीन् भोजयेच्च ।\nअनाददानश्च परैरदत्तं सैषा गृहस्थोपनिषत् पुराणी \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111003, "chapter_id": 3401, "verse_number": "४", "content_sanskrit": "स्ववीर्यजीवी वृजिनान्निवृत्तो दाता परेषां न परोपतापी ।\nमृगैः सचारी वनजान्नभोजी तादृङ्मुनिः सिद्धिमुपैत्यरण्ये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111004, "chapter_id": 3401, "verse_number": "५", "content_sanskrit": "अशिल्पजीवी न गृहस्थश्च नित्यं जितेन्द्रियः सर्वतो विप्रमुक्तः ।\nवनौकसारी लघुरल्पचारः चरन् देशानेकचरः स भिक्षुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111005, "chapter_id": 3401, "verse_number": "६", "content_sanskrit": "रात्र्या यया चाभिजिताश्च लोका\nभवन्ति कामा विजिताः सुखाश्च ।\nतामेव रात्रिं प्रयतेत विद्वान्\nअरण्यसंस्थो भवितुं यतात्मा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111006, "chapter_id": 3401, "verse_number": "७", "content_sanskrit": "दशैव पूर्वानपरान् दशैव ज्ञातीन् सहात्मानमथैकविंशम् ।\nअरण्यशीलः सुकृते दधाति विमुच्यारण्ये स्वशरीरधातून् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111007, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111008, "chapter_id": 3401, "verse_number": "८", "content_sanskrit": "कथंस्विद् वसतोऽरण्यं मौनानि कति चाप्युत ।\nभवन्तीह तदाचक्ष्व श्रोतुमिच्छामहे वयम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111009, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111010, "chapter_id": 3401, "verse_number": "९", "content_sanskrit": "अरण्ये वसतो यस्य ग्रामो भवति पृष्ठतः ।\nग्रामे चावसतोऽरण्यं स मुनिः स्याज्जनाधिप\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111011, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111012, "chapter_id": 3401, "verse_number": "१०", "content_sanskrit": "कथंस्विद् वसतोऽरण्ये ग्रामो भवति पृष्ठतः ।\nग्रामे चावसतोऽरण्यं कथं भवति पृष्ठतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111013, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111014, "chapter_id": 3401, "verse_number": "११", "content_sanskrit": "न ग्राम्यानुपयुञ्जीत य आरण्यो मुनिर्भवेत् ।\nतथाऽस्य वसतोऽरण्ये ग्रामो भवति पृष्ठतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111015, "chapter_id": 3401, "verse_number": "१२", "content_sanskrit": "अनग्निरनिकेतश्च अगोत्रावरणो मुनिः ।\nकौपीनाच्छादनी चीरी सर्वस्वादुविवर्जितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111016, "chapter_id": 3401, "verse_number": "१३", "content_sanskrit": "यावत्प्राणाभिसन्धानं तावदिच्छेच्च भोजनम् ।\nतथाऽस्य वसतो ग्रामेऽरण्यं भवति पृष्ठतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111017, "chapter_id": 3401, "verse_number": "१४", "content_sanskrit": "यस्तु कामान् परित्यज्य त्यक्त्वा कर्म जितेन्द्रियः ।\nआतिष्ठेच्च मुनिर्मौनं स लोके सिद्धिमाप्नुयात्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111018, "chapter_id": 3401, "verse_number": "१५", "content_sanskrit": "धौतदन्तं कृत्तनखं सदा स्नातमलङ्कृतम् ।\nअसितं सितकर्मस्थं कस्तं नार्चितुमर्हति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111019, "chapter_id": 3401, "verse_number": "१६", "content_sanskrit": "तपसा कर्शितः क्षामः क्षीणमांसास्थिशोणितः ।\nयदा भवति निर्द्वन्द्वो मुनिर्मौनं समास्थितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111020, "chapter_id": 3401, "verse_number": "१७", "content_sanskrit": "अथ लोकमिमं जित्वा लोकं विजयते परम् ।\nआस्येन तु यदाऽऽहारं गोवन्मृगयते मुनिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111021, "chapter_id": 3401, "verse_number": "१८", "content_sanskrit": "अथास्य लोकः पूर्वो यः सोऽमृतत्वाय कल्पते ।\nसामान्यधर्मः सर्वेषां क्रोधो लोभो द्रुहाऽक्षमा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111022, "chapter_id": 3401, "verse_number": "१९", "content_sanskrit": "विहाय मत्सरं स्तैन्यं गर्वं डम्भं च पैशुनम् ।\nक्रोधं लोभं ममत्वं च यस्य नास्ति स धर्मवित्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111023, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111024, "chapter_id": 3401, "verse_number": "२०", "content_sanskrit": "नित्याध्यायी ब्रह्मचारी गृहस्थो वनगो मुनिः ।\nनाधर्ममशनात् प्राप्येत् कथं ब्रूहीह पृच्छते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111025, "chapter_id": 3401, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111026, "chapter_id": 3401, "verse_number": "२१", "content_sanskrit": "अष्टौ ग्रासा मुनेः प्रोक्ताः षोडशारण्यवासिनः ।\nद्वात्रिंशत्तु गृहस्थस्य ह्यमितं ब्रह्मचारिणः ।\nइत्येतत् कारणं ज्ञेयमष्टकैतच्छुभाशुभम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111027, "chapter_id": 3401, "verse_number": "८०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअशीतितमोऽध्यायः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111028, "chapter_id": 3401, "verse_number": "२८", "content_sanskrit": "॥ सम्भवपर्वणि अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]