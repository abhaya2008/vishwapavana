[{"id": 6000026000, "chapter_id": 10026, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000026001, "chapter_id": 10026, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.001.m4a", "display_order": 2}, {"id": 6000026002, "chapter_id": 10026, "verse_number": "२-६-१", "content_sanskrit": "वाचो वह्नेर्मुखं क्षेत्रं छन्दसां सप्तधातवः।\nहव्यकव्यामृतान्नानां जिह्वा सर्वरसस्य च॥ २/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.002.m4a", "display_order": 3, "topics": [{"text": "ब्रह्मणा नारदं प्रति पुरुषसूक्तोक्तप्रकारेण भगवन्मुखादिभ्य इन्द्रियाणां तदभिमानिदेवानां चोत्पत्तिप्रकार-निरूपणम्", "range": "१–२६"}]}, {"id": 6000026003, "chapter_id": 10026, "verse_number": "२-६-२", "content_sanskrit": "सर्वासूनां च वायोश्च तन्नासे परमायने।\nअश्विनोरोषधीनां च घ्राणो गन्धस्य चैव हि॥ २/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.003.m4a", "display_order": 4}, {"id": 6000026004, "chapter_id": 10026, "verse_number": "२-६-३", "content_sanskrit": "रूपाणां तेजसां चक्षुर्दिवः सूर्यस्य चाक्षिणी।\nकर्णौ दिशां च तीर्थानां श्रोत्रमाकाशशब्दयोः॥ २/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.004.m4a", "display_order": 5}, {"id": 6000026005, "chapter_id": 10026, "verse_number": "२-६-४", "content_sanskrit": "तद्गात्रं वस्तुसाराणां सौभाग्यस्य च भाजनम्।\nत्वगस्य स्पर्शवायोश्च सर्वमेधस्य चैव हि॥ २/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.005.m4a", "display_order": 6}, {"id": 6000026006, "chapter_id": 10026, "verse_number": "२-६-५", "content_sanskrit": "रोमाण्युद्भिजजातीनां यैर्वा यज्ञस्तु सम्भृतः।\nकेशश्मश्रुनखान्यस्य शिलालोहाभ्रविद्युताम्॥ २/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.006.m4a", "display_order": 7}, {"id": 6000026007, "chapter_id": 10026, "verse_number": "२-६-६", "content_sanskrit": "बाहवो लोकपालानां प्रायशः क्षेमकर्मणाम्। विक्रमो भूर्भुवःस्वश्च क्षेमस्य शरणस्य च।\nसर्वकामवरस्यापि हरेश्चरण आस्पदम्॥ २/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.007.m4a", "display_order": 8}, {"id": 6000026008, "chapter_id": 10026, "verse_number": "२-६-७", "content_sanskrit": "अपां वीर्यस्य सर्गस्य पर्जन्यस्य प्रजापतेः।\nपुंसः शिश्न उपस्थस्तु प्रजात्यानन्दनिर्वृतेः॥ २/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.008.m4a", "display_order": 9}, {"id": 6000026009, "chapter_id": 10026, "verse_number": "२-६-८", "content_sanskrit": "पायुर्यमस्य मित्रस्य परिमोक्षस्य नारद।\nहिंसाया निऋतेर्मृत्योर्निरयस्य गुदः स्मृतः॥ २/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.009.m4a", "display_order": 10}, {"id": 6000026010, "chapter_id": 10026, "verse_number": "२-६-९", "content_sanskrit": "पराभूतेरधर्मस्य तमसश्चापि पश्चिमः।\nनाड्यो नदनदीनां तु गोत्राणामस्थिसंहतिः॥ २/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.010.m4a", "display_order": 11}, {"id": 6000026011, "chapter_id": 10026, "verse_number": "२-६-१०", "content_sanskrit": "अव्यक्तरससिन्धूनां भूतानां निधनस्य च।\nउदरं विदितं पुंसो हृदयं मनसः पदम्॥ २/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.011.m4a", "display_order": 12}, {"id": 6000026012, "chapter_id": 10026, "verse_number": "२-६-११", "content_sanskrit": "धर्मस्य मम तुभ्यं च कुमाराणां भवस्य च।\nविज्ञानस्य च तत्त्वस्य परस्यात्मा परायणम्॥ २/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.012.m4a", "display_order": 13}, {"id": 6000026013, "chapter_id": 10026, "verse_number": "२-६-१२", "content_sanskrit": "अहं भवान् भवश्चैव य इमे मुनयोऽग्रजाः।\nसुरासुरनरा नागाः खगा मृगसरीसृपाः॥ २/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.013.m4a", "display_order": 14}, {"id": 6000026014, "chapter_id": 10026, "verse_number": "२-६-१३", "content_sanskrit": "गन्धर्वाप्सरसो यक्षा रक्षोभूतगणोरगाः।\nपशवः पितरः सिद्धा विद्याध्राश्चारणा द्रुमाः॥ २/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.014.m4a", "display_order": 15}, {"id": 6000026015, "chapter_id": 10026, "verse_number": "२-६-१४", "content_sanskrit": "अन्ये च विविधा जीवा जलस्थलनभौकसः।\nग्रहर्क्षकेतवस्तारास्तडितः स्तनयित्नवः॥ २/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.015.m4a", "display_order": 16}, {"id": 6000026016, "chapter_id": 10026, "verse_number": "२-६-१५", "content_sanskrit": "सर्वं पुरुष एवेदं भूतं भव्यं भवच्च यत्।\nतेनेदमावृतं विश्वं वितस्तिमधितिष्ठता॥ २/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.016.m4a", "display_order": 17}, {"id": 6000026017, "chapter_id": 10026, "verse_number": "२-६-१६", "content_sanskrit": "स्वधिष्ण्यं प्रतपन्प्राणो बहिश्च प्रतपत्यसौ।\nएवं विराजं प्रतपंस्तपत्यन्तर्बहिः पुमान्॥ २/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.017.m4a", "display_order": 18}, {"id": 6000026018, "chapter_id": 10026, "verse_number": "२-६-१७", "content_sanskrit": "सोऽमृतस्याभयस्येशो मर्त्यमन्नं यदत्यगात्।\nमहिमैष ततो ब्रह्मन्पुरुषस्य दुरत्ययः॥ २/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.018.m4a", "display_order": 19}, {"id": 6000026019, "chapter_id": 10026, "verse_number": "२-६-१८", "content_sanskrit": "पादोऽस्य सर्वा भूतानि पुंसः स्थितिविदो विदुः।\nअमृतं क्षेममभयं त्रिमूर्ध्नोऽधायि मूर्धसु॥ २/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.019.m4a", "display_order": 20}, {"id": 6000026020, "chapter_id": 10026, "verse_number": "२-६-१९", "content_sanskrit": "पादास्‍त्रयो बहिस्त्वासन्नप्रजानां य आश्रयाः।\nअन्तस्‍त्रिलोक्यास्त्वपरो गृहमेधैर्बृहद्वृतः॥ २/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.020.m4a", "display_order": 21}, {"id": 6000026021, "chapter_id": 10026, "verse_number": "२-६-२०", "content_sanskrit": "सृती विचक्रमे विष्वक्साशनानशने उभे।\nयदविद्या च विद्या च पुरुषस्तूभयाश्रयः॥ २/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.021.m4a", "display_order": 22}, {"id": 6000026022, "chapter_id": 10026, "verse_number": "२-६-२१", "content_sanskrit": "तस्मादण्डाद्विराड् जज्ञे भूतेन्द्रियगुणाश्रयः।\nतद्द्रव्यमत्यगाद्विश्वं गोभिः सूर्य इवाश्रयम्॥ २/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.022.m4a", "display_order": 23}, {"id": 6000026023, "chapter_id": 10026, "verse_number": "२-६-२२", "content_sanskrit": "यदाऽस्य नाभ्यां नलिनाद् अहमासं महात्मनः।\nनाविन्दं यज्ञसम्भारान् पुरुषावयवानृते॥ २/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.023.m4a", "display_order": 24}, {"id": 6000026024, "chapter_id": 10026, "verse_number": "२-६-२३", "content_sanskrit": "तेषु यज्ञाश्च पशवः सवनस्पतयः कुशाः।\nइदं च देवयजनं कालश्चात्मगुणान्वितः॥ २/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.024.m4a", "display_order": 25}, {"id": 6000026025, "chapter_id": 10026, "verse_number": "२-६-२४", "content_sanskrit": "वस्तून्योषधयः स्नेहा रसलोहमृदो जलम्।\nऋचो यजूंषि सामानि चातुर्होत्रं च सत्तम॥ २/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.025.m4a", "display_order": 26}, {"id": 6000026026, "chapter_id": 10026, "verse_number": "२-६-२५", "content_sanskrit": "नामधेयानि मन्त्राश्च दक्षिणाश्च व्रतानि च।\nदेवतानुक्रमः कल्पः सङ्कल्पः सूत्रमेव च॥ २/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.026.m4a", "display_order": 27}, {"id": 6000026027, "chapter_id": 10026, "verse_number": "२-६-२६", "content_sanskrit": "गतयो मतयः श्रद्धा प्रायश्चित्तं समर्पणम्।\nपुरुषावयवैरेतैः सम्भाराः सम्भृता मया॥ २/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.027.m4a", "display_order": 28}, {"id": 6000026028, "chapter_id": 10026, "verse_number": "२-६-२७", "content_sanskrit": "इति सम्भृतसम्भारः पुरुषावयवैरहम्।\nतमेव पुरुषं यज्ञं तेनैवायजमीश्वरम्॥ २/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.028.m4a", "display_order": 29, "topics": [{"text": "तथा भगवदवयवेभ्यो यज्ञसाधनकुशादिसंभवकथनपूर्वकं प्राधान्येन भगवदवतारचरित्र-निरूपणप्रतिज्ञानम्", "range": "२७–४५"}]}, {"id": 6000026029, "chapter_id": 10026, "verse_number": "२-६-२८", "content_sanskrit": "ततस्ते भ्रातर इमे प्रजानां पतयो नव।\nअयजन् व्यक्तमव्यक्तं पुरुषं सुसमाहिताः॥ २/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.029.m4a", "display_order": 30}, {"id": 6000026030, "chapter_id": 10026, "verse_number": "२-६-२९", "content_sanskrit": "ततश्च मनवः काल ईजिरे ऋषयोऽपरे।\nपितरो विबुधा दैत्या मनुष्याः क्रतुभिर्विभुम्॥ २/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.030.m4a", "display_order": 31}, {"id": 6000026031, "chapter_id": 10026, "verse_number": "२-६-३०", "content_sanskrit": "नारायणे भगवति तदिदं विश्वमाहितम्।\nगृहीतमायोरुगुणे सर्गादावगुणे स्वतः॥ २/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.031.m4a", "display_order": 32}, {"id": 6000026032, "chapter_id": 10026, "verse_number": "२-६-३१", "content_sanskrit": "सृजामि तन्नियुक्तोऽहं हरो हरति तद्वशः।\nविश्वं पुरुषरूपेण परिपाति त्रिशक्तिधृक्॥ २/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.032.m4a", "display_order": 33}, {"id": 6000026033, "chapter_id": 10026, "verse_number": "२-६-३२", "content_sanskrit": "इति तेऽभिहितं तात यथेदमनुपृच्छसि।\nनान्यद्भगवतः किञ्चिद्भाव्यं सदसदात्मकम्॥ २/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.033.m4a", "display_order": 34}, {"id": 6000026034, "chapter_id": 10026, "verse_number": "२-६-३३", "content_sanskrit": "न भारती मेऽङ्ग मृषोपलक्ष्यते न कर्हिचिन्मे मनसो मृषा गतिः।\nन मे हृषीकाणि पतन्त्यसत्पथे यन्मे हृदौत्कण्ठ्यवता धृतो हरिः॥ २/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.034.m4a", "display_order": 35}, {"id": 6000026035, "chapter_id": 10026, "verse_number": "२-६-३४", "content_sanskrit": "सोऽहं समाम्नायमयस्तपोमयः प्रजापतीनामभिवन्दितः पतिः।\nआस्थाय योगं निपुणं समाहितस्तन्नाध्यगच्छं यत आत्मसम्भवः॥ २/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.035.m4a", "display_order": 36}, {"id": 6000026036, "chapter_id": 10026, "verse_number": "२-६-३५", "content_sanskrit": "नतोऽस्म्यहं तच्चरणं समीयुषां भवच्छिदं स्वस्त्ययनं सुमङ्गलम्।\nयः स्वात्ममायाविभवं स्वयं गतो नाहं नभस्वांस्तमथापरे कुतः॥ २/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.036.m4a", "display_order": 37}, {"id": 6000026037, "chapter_id": 10026, "verse_number": "२-६-३६", "content_sanskrit": "नाहं न यूयं बत तद्गतिं विदुः न वामदेवः किमुतापरे सुराः।\nयन्मायया मोहितबुद्धयस्त्विदं विनिर्मितं स्वात्मसमं विचक्ष्महे॥ २/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.037.m4a", "display_order": 38}, {"id": 6000026038, "chapter_id": 10026, "verse_number": "२-६-३७", "content_sanskrit": "यस्यावतारकर्माणि गायन्ति ह्यस्मदादयः।\nन यं विदन्ति तत्त्वेन तस्मै भगवते नमः॥ २/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.038.m4a", "display_order": 39}, {"id": 6000026039, "chapter_id": 10026, "verse_number": "२-६-३८", "content_sanskrit": "स एष आद्यः पुरुषः कल्पे कल्पे सृजत्यजः।\nआत्माऽऽत्मन्यात्मनाऽऽत्मानं स संयच्छति पाति च॥ २/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.039.m4a", "display_order": 40}, {"id": 6000026040, "chapter_id": 10026, "verse_number": "२-६-३९", "content_sanskrit": "विशुद्धं केवलं ज्ञानं प्रत्यक् सम्यगवस्थितम्।\nसत्यं पूर्णमनाद्यन्तं निर्गुणं नित्यमद्वयम्॥ २/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.040.m4a", "display_order": 41}, {"id": 6000026041, "chapter_id": 10026, "verse_number": "२-६-४०", "content_sanskrit": "ऋतं विन्दन्ति मुनयः प्रशान्तात्मेन्द्रियाशयाः।\nयदा तदैवासत्तर्कैस्तिरोधीयेत विप्लुतम्॥ २/६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.041.m4a", "display_order": 42}, {"id": 6000026042, "chapter_id": 10026, "verse_number": "२-६-४१", "content_sanskrit": "आद्योऽवतारः पुरुषः परस्य कालः स्वभावः सदसन्मनश्च।\nद्रव्यं विकारो गुण इन्द्रियाणि विराड् स्वराट् स्थास्नु चरिष्णु भूम्नः॥ २/६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.042.m4a", "display_order": 43}, {"id": 6000026043, "chapter_id": 10026, "verse_number": "२-६-४२", "content_sanskrit": "अहं भवो यज्ञ इमे प्रजेशा दक्षादयो ये भवदादयश्च।\nस्वर्लोकपालाः खगलोकपाला नृलोकपालास्तललोकपालाः॥ २/६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.043.m4a", "display_order": 44}, {"id": 6000026044, "chapter_id": 10026, "verse_number": "२-६-४३", "content_sanskrit": "गन्धर्वविद्याधरचारणेशा ये यक्षरक्षोरगनागनाथाः।\nये वा ऋषीणामृषभाः पितॄणां दैत्येन्द्रसिद्धेश्वरदानवेन्द्राः॥ २/६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.044.m4a", "display_order": 45}, {"id": 6000026045, "chapter_id": 10026, "verse_number": "२-६-४४", "content_sanskrit": "अन्ये च ये प्रेतपिशाचभूतकूष्माण्डयादोमृगपश्वधीशाः।\nयत्किञ्च लोके भगवन्महस्वद् ओजःसहस्वद्बलवत्क्षमावत्।\nह्रीश्रीविभूत्यात्मवदद्भुतार्णं तत्तत्परं रूपवदस्वरूपम्॥ २/६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.045.m4a", "display_order": 46}, {"id": 6000026046, "chapter_id": 10026, "verse_number": "२-६-४५", "content_sanskrit": "प्राधान्यतो यानृषय आमनन्ति लीलावतारान्पुरुषस्य भूम्नः।\nआपीयतां कर्मकषायशोषाननुक्रमिष्ये त इमान्सुपेशलान्॥ २/६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_006/BhP_02.006.046.m4a", "display_order": 47}, {"id": 6000026047, "chapter_id": 10026, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]