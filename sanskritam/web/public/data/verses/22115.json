[{"id": 7002115000, "chapter_id": 22115, "verse_number": "१६०-१", "content_sanskrit": "वानप्रस्थाश्रमः ।\nपुष्कर उवाच ।\nवानप्रस्थयतीनाञ्च धर्मं वक्ष्येऽधुना शृणु ।\nजटित्वमग्निहोत्रित्वं भूशय्याजिनधारणं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002115001, "chapter_id": 22115, "verse_number": "१६०-२", "content_sanskrit": "वने वासः पयोमूलनीवारफलवृत्तिता ।\nप्रतिग्रहनिवृत्तिश्च त्रिःस्नानं ब्रह्मचारिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002115002, "chapter_id": 22115, "verse_number": "१६०-३", "content_sanskrit": "देवातिथीनां पूजा च धर्मोऽयं वनवासिनः ।\nगृही ह्यपत्यापत्यञ्च दृष्ट्वारण्यं समाश्रयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002115003, "chapter_id": 22115, "verse_number": "१६०-४", "content_sanskrit": "तृतीयमायुषो भागमेकाकी वा सभार्यकः ।\nग्रीष्मे पञ्चतपा नित्यं वर्षास्वभ्राविकाशिकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002115004, "chapter_id": 22115, "verse_number": "१६०-५", "content_sanskrit": "आर्द्रवासाश्च हेमन्ते तपश्चोग्रञ्चरेद्बली ।\nअपरावृत्तिमास्थाय व्रजेद्दिशमजिह्मगः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]