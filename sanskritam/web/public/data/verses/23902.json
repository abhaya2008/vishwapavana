[{"id": 7003902000, "chapter_id": 23902, "verse_number": "२-८-७-१", "content_sanskrit": "अगस्त्य उवाच ।\nतीर्थमन्यत्प्रवक्ष्यामि क्षीरोदकमिति स्मृतम् ।\nसीताकुण्डाच्च वायव्ये वर्त्तते गुणसुन्दरम् ।\nपुण्यैकनिचयस्थानं सर्वदुःखविनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003902001, "chapter_id": 23902, "verse_number": "२-८-७-२", "content_sanskrit": "पुरा दशरथो राजा पुत्रेष्टिनाम नामतः ।\nचकार विधिवद्यज्ञं पुत्रार्थं यत्र चादरात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003902002, "chapter_id": 23902, "verse_number": "२-८-७-३", "content_sanskrit": "क्रतुं समापयामास सानन्दो भूरिदक्षिणम् ।\nयज्ञान्ते क्रतुभुक्तत्र मूर्तिमान्समदृश्यत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003902003, "chapter_id": 23902, "verse_number": "२-८-७-४", "content_sanskrit": "हस्ते कृत्वा हेमपात्रं हविःपूर्णमनुत्तमम् ।\nतस्मिन्हविषि संकीर्णं वैष्णवं तेज उत्तमम् ।\nचतुर्विधं विभज्यैव पत्नीभ्यो दत्तवान्नृपः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003902004, "chapter_id": 23902, "verse_number": "२-८-७-५", "content_sanskrit": "यत्र तत्क्षीरसंप्राप्तिर्जाता परमदुर्लभा ।\nक्षीरोदकमिति ख्यातं तत्स्थानं पापनाशनम् ।\nउदकेनाभिव्यक्तं च उत्तमं च फलप्रदम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003902005, "chapter_id": 23902, "verse_number": "२-८-७-६", "content_sanskrit": "तत्र स्नात्वा नरो धीमान्विजितेन्द्रिय आदरात् ।\nसर्वान्कामानवाप्नोति पुत्रांश्च सुबहुश्रुतान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003902006, "chapter_id": 23902, "verse_number": "२-८-७-७", "content_sanskrit": "आश्विने शुक्लपक्षस्य एकादश्यां जितव्रतः ।\nतत्र स्नात्वा विधानेन दत्त्वा शक्त्या द्विजन्मने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003902007, "chapter_id": 23902, "verse_number": "२-८-७-८", "content_sanskrit": "विष्णुं संपूज्य विधिवत्सर्वान्कामानवाप्नुयात् ।\nपुत्रानवाप्नुयाद्विद्धि धर्मांश्च विधिवन्नरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003902008, "chapter_id": 23902, "verse_number": "२-८-७-९", "content_sanskrit": "तस्मात्क्षीरोदकस्थानान्नैरृते दिग्दले श्रितम् ।\nख्यातं बृहस्पतेः कुण्डमुद्दंडाचंडमंडितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003902009, "chapter_id": 23902, "verse_number": "२-८-७-१०", "content_sanskrit": "सर्वपापप्रशमनं पुण्यामृततरंगितम् ।\nयत्र साक्षात्सुरगुरुर्निवासं किल निर्ममे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003902010, "chapter_id": 23902, "verse_number": "२-८-७-११", "content_sanskrit": "यज्ञं च विधिवच्चक्रे बृहस्पतिरुदारधीः ।\nनानामुनिगणैर्युक्तं रम्यं बहुफलप्रदम् ।\nसुपर्णच्छायसंपन्नं कुण्डं तत्पापिदुर्ल्लभम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003902011, "chapter_id": 23902, "verse_number": "२-८-७-१२", "content_sanskrit": "इन्द्रादयोऽपि विबुधा यत्र स्नात्वा प्रयत्नतः ।\nमनोभीष्टफलं प्राप्ताः सौंदर्यौदार्यतुंदिलाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003902012, "chapter_id": 23902, "verse_number": "२-८-७-१३", "content_sanskrit": "यत्र स्नानेन दानेन नरो मुच्येत किल्बिषात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003902013, "chapter_id": 23902, "verse_number": "२-८-७-१४", "content_sanskrit": "भाद्रे शुक्ले तु पंचम्यां यात्रा तत्र फलप्रदा ।\nअन्यदापि गुरोर्वारे स्नानं बहुफलप्रदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003902014, "chapter_id": 23902, "verse_number": "२-८-७-१५", "content_sanskrit": "बृहस्पतेस्तथा विष्णोः पूजां तत्र य आचरेत् ।\nसर्वपापविनिर्मुक्तो विष्णुलोके स मोदते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003902015, "chapter_id": 23902, "verse_number": "२-८-७-१६", "content_sanskrit": "भवेद्बृहस्पतेः पीडा यस्य गोचरवेधतः ।\nतेनात्र विधिवत्स्नानं कार्यं संकल्पपूर्वकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003902016, "chapter_id": 23902, "verse_number": "२-८-७-१७", "content_sanskrit": "होमं कृत्वा गुरोर्मूर्तिः सुवर्णेन विनिर्मिता ।\nस्थित्वा जले प्रदेया वै पीतांबरसमन्विता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003902017, "chapter_id": 23902, "verse_number": "२-८-७-१८", "content_sanskrit": "वेदज्ञायातिशुचये स्नात्वा पीडापनुत्तये ।\nहोमं च कारयेत्तत्र ग्रहजाप्यविधानतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003902018, "chapter_id": 23902, "verse_number": "२-८-७-१९", "content_sanskrit": "एवं कृते न संदेहो ग्रहपीडा प्रणश्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003902019, "chapter_id": 23902, "verse_number": "२-८-७-२०", "content_sanskrit": "तद्दक्षिणे मुनिश्रेष्ठ रुक्मिणीकुण्डमुत्तमम् ।\nचकार यत्स्वयं देवी रुक्मिणी कृष्णवल्लभा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003902020, "chapter_id": 23902, "verse_number": "२-८-७-२१", "content_sanskrit": "तत्र विष्णुः स्वयं चक्रे निवासं सलिले तदा ।\nवरप्रदानात्स्नेहेन भार्यायाः प्रगुणीकृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003902021, "chapter_id": 23902, "verse_number": "२-८-७-२२", "content_sanskrit": "तत्र स्नानं तथा दानं होमं वैष्णवमंत्रकम् ।\nद्विजपूजां विष्णुपूजां कुर्वीत प्रयतो नरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003902022, "chapter_id": 23902, "verse_number": "२-८-७-२३", "content_sanskrit": "तत्र सांवत्सरी यात्रा कर्त्तव्या सुप्रयत्नतः ।\nऊर्जकृष्णनवम्यां च सर्वपापापनुत्तये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003902023, "chapter_id": 23902, "verse_number": "२-८-७-२४", "content_sanskrit": "पुत्रवाञ्जायते वन्ध्यो यात्रां कृत्वा न संशयः ।\nनारीभिर्वा नरैर्वापि कर्त्तव्यं स्नानमादरात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003902024, "chapter_id": 23902, "verse_number": "२-८-७-२५", "content_sanskrit": "भुक्त्वा भोगान्समग्रांश्च विष्णुलोके स मोदते ।\nलक्ष्मीकामनया तत्र स्नातव्यं च विशेषतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003902025, "chapter_id": 23902, "verse_number": "२-८-७-२६", "content_sanskrit": "सर्वकाममवाप्नोति तत्र स्नानेन मानवः ।\nरुक्मिणीश्रीपतिप्रीत्यै दातव्यं च स्वशक्तितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003902026, "chapter_id": 23902, "verse_number": "२-८-७-२७", "content_sanskrit": "कर्त्तव्या विधिवत्पूजा ब्राह्मणानां विशेषतः ।\nध्येयो लक्ष्मीपतिस्तत्र शंखचक्रगदाधरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003902027, "chapter_id": 23902, "verse_number": "२-८-७-२८", "content_sanskrit": "पीतांबरधरः स्रग्वी नारदादिभिरीडितः ।\nतार्क्ष्यासनो मुकुटवान्महेन्द्रादिविभूषितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003902028, "chapter_id": 23902, "verse_number": "२-८-७-२९", "content_sanskrit": "सर्वकामफलावाप्त्यै वक्षोलक्षितकौस्तुभः ।\nअतसीकुसुमश्यामः कमलामललोचनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003902029, "chapter_id": 23902, "verse_number": "२-८-७-३०", "content_sanskrit": "एवं कृते न संदेहः सर्वान्कामानवाप्नुयात् ।\nइह लोके सुखं भुक्त्वा हरिलोके स मोदते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003902030, "chapter_id": 23902, "verse_number": "२-८-७-३१", "content_sanskrit": "अतः परं प्रवक्ष्यामि तीर्थमन्यदघापहम् ।\nकलिकिल्विषसंहारकारकं प्रत्ययात्मकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003902031, "chapter_id": 23902, "verse_number": "२-८-७-३२", "content_sanskrit": "परं पवित्रमतुलं सर्वकामार्थसिद्धिदम् ।\nधनयक्षैतिख्यातं परं प्रत्ययकारकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003902032, "chapter_id": 23902, "verse_number": "२-८-७-३३", "content_sanskrit": "रुक्मिणीकुण्डवायव्यदिग्दले संस्मृतं शुभम् ।\nहरिश्चन्द्रस्य राजर्षेरासीत्तत्र धनं महत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003902033, "chapter_id": 23902, "verse_number": "२-८-७-३४", "content_sanskrit": "तस्य रक्षार्थमत्यर्थं रक्षितो यक्षौच्चकैः ।\nविश्वामित्रो मुनिः पूर्वं यदा चैव पराजयत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003902034, "chapter_id": 23902, "verse_number": "२-८-७-३५", "content_sanskrit": "हरिश्चंद्रं नरपतिं राज्यसूयकरं परम् ।\nराज्यं जग्राह सकलं चतुरंगबलान्वितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003902035, "chapter_id": 23902, "verse_number": "२-८-७-३६", "content_sanskrit": "तद्वशेऽदाच्च स मुनिर्धनं सकलमुत्तमम् ।\nतद्रक्षायै प्रयत्नेन यक्षं स्थापितवानसौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003902036, "chapter_id": 23902, "verse_number": "२-८-७-३७", "content_sanskrit": "प्रमंथुर इति ख्यातं प्रमोदानन्दमंदिरम् ।\nरक्षां विदधतस्तस्य बहुयत्नेन सर्वशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003902037, "chapter_id": 23902, "verse_number": "२-८-७-३८", "content_sanskrit": "तुतोष स मुनिर्द्धीमान्कदाचिद्विजितेन्द्रियः ।\nउवाच मधुरं वाक्यं प्रीत्या परमया युतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003902038, "chapter_id": 23902, "verse_number": "२-८-७-३९", "content_sanskrit": "विश्वामित्र उवाच ।\nवरं वरय धर्मज्ञ क्षिप्रमेव विमत्सरः ।\nभक्त्या परमया धीर संतुष्टोऽस्मि विशेषतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003902039, "chapter_id": 23902, "verse_number": "२-८-७-४०", "content_sanskrit": "यक्ष उवाच ।\nवरं प्रयच्छसि यदि विप्रवर्य मदीप्सितम् ।\nममांगमतिदुर्गंधि शापाच्च नृपतेरभूत् ।\nसुगन्धयितुं ब्रह्मर्षे तत्प्रसीद मुनीश्वर ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003902040, "chapter_id": 23902, "verse_number": "२-८-७-४१", "content_sanskrit": "अगस्त्य उवाच ।\nएवमुक्ते तु यक्षेण मुनिर्ध्यानस्थलोचनः ।\nतं विविच्यानया भक्त्या अभिषेकं चकार सः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003902041, "chapter_id": 23902, "verse_number": "२-८-७-४२", "content_sanskrit": "तीर्थोदकेन विधिवत्कृत्वा संकल्पमादरात् ।\nततः सोऽभूत्क्षणेनैव सुगन्धोत्तरविग्रहः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003902042, "chapter_id": 23902, "verse_number": "२-८-७-४३", "content_sanskrit": "तथाभूतः स मधुरं प्रोवाच प्रांजलिस्ततः ।\nपुनः पुरः स्थितो धीमान्विनयावनतस्तदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003902043, "chapter_id": 23902, "verse_number": "२-८-७-४४", "content_sanskrit": "यक्ष उवाच ।\nत्वत्कृपाभिरहं धीर जातः सुरभिविग्रहः ।\nएतत्स्थानं यथा ख्यातिं याति सर्वज्ञ तत्कुरु ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003902044, "chapter_id": 23902, "verse_number": "२-८-७-४५", "content_sanskrit": "त्वत्प्रसादेन विप्रर्षे तथा यत्नं विधेहि वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003902045, "chapter_id": 23902, "verse_number": "२-८-७-४६", "content_sanskrit": "अगस्त्य उवाच ।\nएवमुक्तः क्षणं ध्यात्वा मुनिः स्तिमितलोचनः ।\nयक्षं प्रति प्रसन्नात्मा ह्युवाच श्लक्ष्णया गिरा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003902046, "chapter_id": 23902, "verse_number": "२-८-७-४७", "content_sanskrit": "विश्वामित्र उवाच ।\nप्रसिद्धिमतुलां यक्ष एतत्स्थानं गमिष्यति ।\nधनयक्ष इति ख्यातिमेतत्तीर्थं गमिष्यति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003902047, "chapter_id": 23902, "verse_number": "२-८-७-४८", "content_sanskrit": "सौंदर्य्यदं शरीरस्य परं प्रत्ययकारकम् ।\nयत्र स्नात्वा विधानेन दौर्गंध्यं त्यजति क्षणात् ।\nतत्र स्नानं प्रयत्नेन कर्त्तव्यं पुण्यकांक्षिभिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003902048, "chapter_id": 23902, "verse_number": "२-८-७-४९", "content_sanskrit": "दानं श्रद्धास्वशक्तिभ्यां लक्ष्मीपूजा विशेषतः ।\nतत्र स्नानेन दानेन लक्ष्मीप्रीत्यै विशेषतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003902049, "chapter_id": 23902, "verse_number": "२-८-७-५०", "content_sanskrit": "पूजया तु निधीनां च नवानामपि सुव्रत ।\nइह लोके सुखं भुक्त्वा परलोके स मोदते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003902050, "chapter_id": 23902, "verse_number": "२-८-७-५१", "content_sanskrit": "महापद्मस्तथा पद्मः शंखो मकरकच्छपौ ।\nमुकुन्दकुंदनीलाश्च खर्वश्च निधयो नव ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003902051, "chapter_id": 23902, "verse_number": "२-८-७-५२", "content_sanskrit": "एतेषामपि कुण्डेऽत्र संनिधिर्भविताऽनघ ।\nएतेषां तु विशेषेण पूजा बहुफलप्रदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003902052, "chapter_id": 23902, "verse_number": "२-८-७-५३", "content_sanskrit": "जलमध्ये प्रकर्त्तव्यं निधिलक्ष्मीप्रपूजनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003902053, "chapter_id": 23902, "verse_number": "२-८-७-५४", "content_sanskrit": "अन्नं बहुविधं देयं वासांसि विविधानि च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003902054, "chapter_id": 23902, "verse_number": "२-८-७-५५", "content_sanskrit": "सुवर्णादि यथाशक्त्या वित्तशाठ्यं विवर्जयेत् ।\nगुप्तं दानं प्रयत्नेन कर्त्तव्यं सुप्रयत्नतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003902055, "chapter_id": 23902, "verse_number": "२-८-७-५६", "content_sanskrit": "फलानि च सुवर्णानि देयानि च विशेषतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003902056, "chapter_id": 23902, "verse_number": "२-८-७-५७", "content_sanskrit": "कृष्णपक्षे चतुर्दश्यां स्नानं बहुफलप्रदम् ।\nश्रद्धया परया युक्तैः कर्त्तव्यं श्रद्धयाधिकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003902057, "chapter_id": 23902, "verse_number": "२-८-७-५८", "content_sanskrit": "माघे कृष्णचतुर्दश्यां यात्रा सांवत्सरी भवेत् ।\nतत्र स्नानं पितॄणान्तु तर्पणं च विशेषतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003902058, "chapter_id": 23902, "verse_number": "२-८-७-५९", "content_sanskrit": "आब्रह्मस्तम्बपर्यंतं जगत्तृप्यत्विति ब्रुवन् ।\nअपसव्येन विधिवत्तर्प्पयेदंजलित्रयम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003902059, "chapter_id": 23902, "verse_number": "२-८-७-६०", "content_sanskrit": "एवं कुर्वन्नरो यक्ष न मुह्यति कदाचन ।\nअत्र स्नातो दिवं याति अत्र स्नातः सुखी भवेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003902060, "chapter_id": 23902, "verse_number": "२-८-७-६१", "content_sanskrit": "अत्र स्नातेन ते यक्ष कर्त्तव्यं पूजनं पुरः ।\nत्वत्पूजनेन विधिवन्नृणां पापक्षयो भवेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003902061, "chapter_id": 23902, "verse_number": "२-८-७-६२", "content_sanskrit": "नमः प्रमथराजेति पूजामन्त्र उदाहृतः ।\nतीर्थमध्ये प्रकर्त्तव्यं पूजनं श्रवणादिकम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003902062, "chapter_id": 23902, "verse_number": "२-८-७-६३", "content_sanskrit": "निधिलक्ष्म्यो तथा यक्ष तव पूजा विशेषतः ।\nएवं यः कुरुते धीरः सर्वान्कामानवाप्नुयात् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003902063, "chapter_id": 23902, "verse_number": "२-८-७-६४", "content_sanskrit": "धनार्थी धनमाप्नोति पुत्रार्थी पुत्रमाप्नुयात् ।\nमोक्षार्थी मोक्षमाप्नोति तत्किं न यदिहाप्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003902064, "chapter_id": 23902, "verse_number": "२-८-७-६५", "content_sanskrit": "यस्तु मोहान्नरो यक्ष स्नानं न कुरुते किल ।\nतस्य सांवत्सरं पुण्यं त्वं ग्रहीष्यसि सर्वशः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003902065, "chapter_id": 23902, "verse_number": "२-८-७-६६", "content_sanskrit": "इति दत्त्वा वरांस्तस्मै विश्वामित्रो मुनीश्वरः ।\nअन्तर्दधे मुनिवरस्तदा स च तपोनिधिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003902066, "chapter_id": 23902, "verse_number": "२-८-७-६७", "content_sanskrit": "तदाप्रभृति तत्स्थानं परमां ख्यातिमाययौ ।\nतस्य तीर्थस्य सकला भूमिः स्वर्णविनिर्मिता ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003902067, "chapter_id": 23902, "verse_number": "२-८-७-६८", "content_sanskrit": "दिव्यरत्नौघखचिता समंतादुपशोभिता ।\nएवं यः कुरुते विद्वन्स याति परमां गतिम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003902068, "chapter_id": 23902, "verse_number": "२-८-७-६९", "content_sanskrit": "धनयक्षादुत्तरस्मिन्दिग्भागे संस्थितं द्विज ।\nवसिष्ठकुण्डं विख्यातं सर्वपापापहं सदा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003902069, "chapter_id": 23902, "verse_number": "२-८-७-७०", "content_sanskrit": "वसिष्ठस्य सदा तत्र निवासः सुतपोनिधेः ।\nअरुन्धती सदा यस्य वर्तते निर्मलव्रता ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003902070, "chapter_id": 23902, "verse_number": "२-८-७-७१", "content_sanskrit": "अत्र स्नानं विशेषेण श्राद्धपूर्वमतंद्रितः ।\nयः कुर्यात्प्रयतो धीमांस्तस्य पुण्यमनुत्तमम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003902071, "chapter_id": 23902, "verse_number": "२-८-७-७२", "content_sanskrit": "वामदेवस्य तत्रैव संनिधिर्वर्ततेऽनघ ।\nवशिष्ठवामदेवौ तु पूजनीयौ प्रयत्नतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003902072, "chapter_id": 23902, "verse_number": "२-८-७-७३", "content_sanskrit": "पतिव्रता पूजनीयाऽरुन्धती च विशेषतः ।\nस्नातव्यं विधिना सम्यग्दातव्यं च स्वशक्तितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003902073, "chapter_id": 23902, "verse_number": "२-८-७-७४", "content_sanskrit": "सर्वकामफलप्राप्तिर्जायते नात्र संशयः ।\nअत्र यः कुरुते स्नानं स वशिष्ठसमो भवेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003902074, "chapter_id": 23902, "verse_number": "२-८-७-७५", "content_sanskrit": "भाद्रे मासि सिते पक्षे पंचम्यां नियतव्रतः ।\nतस्य सांवत्सरी यात्रा कर्त्तव्या विधिपूर्विका ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003902075, "chapter_id": 23902, "verse_number": "२-८-७-७६", "content_sanskrit": "विष्णुपूजा प्रयत्नेन कर्तव्या श्रद्धयात्र वै ।\nसर्वपापविशुद्धात्मा विष्णुलोके महीयते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003902076, "chapter_id": 23902, "verse_number": "२-८-७-७७", "content_sanskrit": "वसिष्ठकुण्डाद्विप्रेंद्र प्रत्यग्दिग्दलमाश्रितम् ।\nविख्यातं सागरं कुण्डं सर्वकामार्थसिद्धिदम् ।\nयत्र स्नानेन दानेन सर्वकामानवाप्नुयात् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003902077, "chapter_id": 23902, "verse_number": "२-८-७-७८", "content_sanskrit": "पौर्णमास्यां समुद्रस्य स्नानाद्यत्पुण्यमाप्नुयात् ।\nतत्पुण्यं पर्वणि स्नातो नरश्चाक्षयमाप्नुयात् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003902078, "chapter_id": 23902, "verse_number": "२-८-७-७९", "content_sanskrit": "तस्मादत्र विधानेन स्नातव्यं पुत्रकांक्षया ।\nआश्विने पौर्णमास्यां तु विशेषात्स्नानमाचरेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003902079, "chapter_id": 23902, "verse_number": "२-८-७-८०", "content_sanskrit": "एवं कुर्वन्नरो विद्वान्सर्वपापैः प्रमुच्यते ।\nअत्र स्नात्वा नरो दत्त्वा यथाशक्त्या दिवं व्रजेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003902080, "chapter_id": 23902, "verse_number": "२-८-७-८१", "content_sanskrit": "सागरान्नैरृते भागे योगिनीकुण्डमुत्तमम् ।\nयत्राऽसते चतुःषष्टियोगिन्यो जलसंस्थिताः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003902081, "chapter_id": 23902, "verse_number": "२-८-७-८२", "content_sanskrit": "सर्वार्थसिद्धिदाः पुंसां स्त्रीणां चैव विशेषतः ।\nपरसिद्धिप्रदाः सर्वाः सर्वकामफलप्रदाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003902082, "chapter_id": 23902, "verse_number": "२-८-७-८३", "content_sanskrit": "आश्विने शुक्लपक्षस्य अष्टम्यां च विशेषतः ।\nस्नातव्यं च प्रयत्नेन योगिनीप्रीतये नृभिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003902083, "chapter_id": 23902, "verse_number": "२-८-७-८४", "content_sanskrit": "अत्र स्नानं तथा दानं सर्वं सफलतां व्रजेत् ।\nयक्षिणीप्रभृतयः सिद्धा भवंत्यत्र न संशयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003902084, "chapter_id": 23902, "verse_number": "२-८-७-८५", "content_sanskrit": "योगिनीकुंडतः पूर्वमुर्वशीकुण्डमुत्तमम् ।\nयत्र स्नातो नरो विद्वन्नुर्वशीं दिवि संश्रयेत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003902085, "chapter_id": 23902, "verse_number": "२-८-७-८६", "content_sanskrit": "पुरा किल मुनिर्धीरो रैभ्यो नाम तपोधनः ।\nचचार हिमवत्पार्श्वे निराहारो जितेन्द्रियः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003902086, "chapter_id": 23902, "verse_number": "२-८-७-८७", "content_sanskrit": "तत्तपो विपुलं दृष्ट्वा भीतः सुरपतिस्ततः ।\nउर्वशीं प्रेषयामास तपोविघ्नाय चादरात् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003902087, "chapter_id": 23902, "verse_number": "२-८-७-८८", "content_sanskrit": "ततः सा प्रेषिता तेनाजगाम गजगामिनी ।\nउवास हिमवत्पार्श्वे रैभ्याश्रममनुत्तमम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003902088, "chapter_id": 23902, "verse_number": "२-८-७-८९", "content_sanskrit": "वनफुल्ललताकुञ्जे मञ्जुकूजद्विहंगमे ।\nकिन्नरीकेलिसंगीतस्तिमितांगकुरंगके ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003902089, "chapter_id": 23902, "verse_number": "२-८-७-९०", "content_sanskrit": "पुन्नागकेशराशोकच्छिन्नकिजल्कपिंजरे ।\nकल्पिते कांचनगिरौ द्वितीय इव वेधसा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003902090, "chapter_id": 23902, "verse_number": "२-८-७-९१", "content_sanskrit": "सा बभौ कांतिसर्वस्वकोशः कुसुमधन्वनः ।\nउर्वश्यनल्पसामान्यलावण्यामृतवाहिनी ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003902091, "chapter_id": 23902, "verse_number": "२-८-७-९२", "content_sanskrit": "अंगप्रभासुवर्णेन सितमौक्तिकशोभिता ।\nतारुण्यरुचिरत्वेन तारुण्येन विभूषिता ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003902092, "chapter_id": 23902, "verse_number": "२-८-७-९३", "content_sanskrit": "विलोमलोचनापांगतरंगधवलत्विषा ।\nनवपल्लवसच्छायं कल्पयन्ती निजाधरम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003902093, "chapter_id": 23902, "verse_number": "२-८-७-९४", "content_sanskrit": "कर्णोपलम्बिसंघुष्यद्भृङ्गाढ्यचूतमञ्जरी ।\nसुधागर्भसमुद्भूता पारिजातलता यथा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003902094, "chapter_id": 23902, "verse_number": "२-८-७-९५", "content_sanskrit": "तनुमध्या पृथुश्रोणिर्वर्णोद्भिन्नपयोधरा ।\nनिःशाणितशरस्येव शक्तिः कुसुमधन्वनः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003902095, "chapter_id": 23902, "verse_number": "२-८-७-९६", "content_sanskrit": "अपश्यदाश्रमे तस्मिन्मुनिरायतलोचनाम् ।\nनयनानलदाहेन विदग्धेन मनोभुवा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003902096, "chapter_id": 23902, "verse_number": "२-८-७-९७", "content_sanskrit": "त्रिनेत्रवंचनायैव कल्पितां ललनातनुम् ।\nतामाश्रमलतापुष्पकांचीरचितकुण्डलाम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003902097, "chapter_id": 23902, "verse_number": "२-८-७-९८", "content_sanskrit": "विलोक्य तां विशालाक्षीं मुनिर्व्याकुलितेन्द्रियः ।\nबभूव रोषसंतप्तः शशाप च बहु ज्वलन् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003902098, "chapter_id": 23902, "verse_number": "२-८-७-९९", "content_sanskrit": "रैभ्य उवाच ।\nकुरूपतां व्रज क्षिप्रं या त्वं सौंदर्यगर्विता ।\nसमागता तपोविघ्नहेतवे मम सन्निधौ ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003902099, "chapter_id": 23902, "verse_number": "२-८-७-१००", "content_sanskrit": "अगस्त्य उवाच ।\nइति शप्ता रुषा तेन मुनिना सा शुभेक्षणा ।\nउवाच वनिता भूत्वा प्रांजलिर्मुनिमादरात् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003902100, "chapter_id": 23902, "verse_number": "२-८-७-१०१", "content_sanskrit": "उर्वश्युवाच ।\nभगवन्मे प्रसीद त्वं पराधीना यतस्त्वहम् ।\nत्वच्छापस्य कथं मुक्तिर्भविता नियतव्रत ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003902101, "chapter_id": 23902, "verse_number": "२-८-७-१०२", "content_sanskrit": "रैभ्य उवाच ।\nअयोध्यायामस्ति तीर्थं पावनं परमं महत् ।\nतत्र स्नानं कुरुष्वाद्य सौंदर्यं परमाप्नुहि ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003902102, "chapter_id": 23902, "verse_number": "२-८-७-१०३", "content_sanskrit": "त्वन्नाम्नैव च विख्यातिं तोयं यास्यति तद्ध्रुवम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003902103, "chapter_id": 23902, "verse_number": "२-८-७-१०४", "content_sanskrit": "अगस्त्य उवाच ।\nएवं सा विप्रवचसा विदधे सर्वमादरात् ।\nसुन्दरी साऽभवत्क्षिप्रं तत्स्थानं ख्यातिमाययौ ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003902104, "chapter_id": 23902, "verse_number": "२-८-७-१०५", "content_sanskrit": "अत्र स्नानं मुनिश्रेष्ठ यः कुर्याद्विधिवज्जनः ।\nसौंदर्यं परमं तस्य भवेत्तत्र न संशयः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003902105, "chapter_id": 23902, "verse_number": "२-८-७-१०६", "content_sanskrit": "भाद्रे शुक्लतृतीयायां यात्रा सांवत्सरी भवेत् ।\nविष्णुरत्र जनैः पूज्यः सर्वकामार्थसिद्धये ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003902106, "chapter_id": 23902, "verse_number": "२-८-७-१०७", "content_sanskrit": "एवं कुर्वन्नरो विद्वान्विष्णुलोके वसेत्सदा ।\nनरो वा यदि वा नारी सर्वान्कामानवाप्नुयात् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003902107, "chapter_id": 23902, "verse_number": "२-८-७-१०८", "content_sanskrit": "घोषार्ककुंडं परममुर्वशीकुंडदक्षिणे ।\nवर्तते मुनिशार्दूल सर्वपापापहं सदा ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003902108, "chapter_id": 23902, "verse_number": "२-८-७-१०९", "content_sanskrit": "यत्र स्नानेन दानेन सूर्यलोके महीयते ।\nएतत्तीर्थस्य सदृशं नापरं विद्यते क्वचित् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003902109, "chapter_id": 23902, "verse_number": "२-८-७-११०", "content_sanskrit": "व्रणी कुष्ठी दरिद्री वा दुःखाक्रांतोऽपि यो नरः ।\nकरोति विधिवत्स्नानं सर्वान्कामानवाप्नुयात् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003902110, "chapter_id": 23902, "verse_number": "२-८-७-१११", "content_sanskrit": "रविवारे विशेषेण कर्त्तव्यं स्नानमादरात् ।\nभाद्रे मासि तथा माघे शुक्लषष्ठ्यां प्रयत्नतः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003902111, "chapter_id": 23902, "verse_number": "२-८-७-११२", "content_sanskrit": "कर्त्तव्यं विधिवत्स्नानं सूर्यलोकाभिकांक्षया ।\nपौषे मासि तथा स्नानं सूर्यवारे विशेषतः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003902112, "chapter_id": 23902, "verse_number": "२-८-७-११३", "content_sanskrit": "सप्तम्यां रवियुक्तायां स्नानं बहुफलप्रदम् ।\nघोषाभिधोऽभवत्पूर्वं सूर्यवंशे नरेश्वरः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003902113, "chapter_id": 23902, "verse_number": "२-८-७-११४", "content_sanskrit": "समुद्रमेखलामेकः पृथिवीं समपालयत् ।\nयस्य कीर्त्या प्रकाशंते त्रिलोकीमंडलानि वै ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003902114, "chapter_id": 23902, "verse_number": "२-८-७-११५", "content_sanskrit": "यः प्रतापात्स्फुरन्भाति प्रभाकर इवापरः ।\nप्रचंडतरदोर्दंडखंडितारातिमंडलः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003902115, "chapter_id": 23902, "verse_number": "२-८-७-११६", "content_sanskrit": "स कदाचित्प्रजापालो मंत्त्रिविन्यस्तभूतलः ।\nबभ्राम मृगयासक्तो वनेऽतिगहनद्रुमे ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003902116, "chapter_id": 23902, "verse_number": "२-८-७-११७", "content_sanskrit": "स राजा पूर्वजन्मोत्थपापैरशुभसूचकैः ।\nकृमिव्याप्तकरांभोजः सुन्दरोपि गतस्मयः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003902117, "chapter_id": 23902, "verse_number": "२-८-७-११८", "content_sanskrit": "मृगयायामभूदेकः कदाचित्पर्यटन्वने ।\nवराहसिंहहरिणान्निघ्नन्गच्छन्नितस्ततः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003902118, "chapter_id": 23902, "verse_number": "२-८-७-११९", "content_sanskrit": "तृषाक्रान्तो म्लानतनुः सरोऽपश्यत्पुरो नृपः ।\nददर्श तत्र च मुनीन्स्नानसंध्यादितत्परान् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003902119, "chapter_id": 23902, "verse_number": "२-८-७-१२०", "content_sanskrit": "ततो विधिवदाचम्य स्नानं चक्रे नरेश्वरः ।\nततो दिव्यशरीरोऽभूदानंदामलमानसः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003902120, "chapter_id": 23902, "verse_number": "२-८-७-१२१", "content_sanskrit": "मुनिभिस्तीर्थमाज्ञाय चक्रे सूर्य्यस्तुतिं प्रियाम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003902121, "chapter_id": 23902, "verse_number": "२-८-७-१२२", "content_sanskrit": "राजोवाच ।\nभगवन्देवदेवेश नमस्तुभ्यं चिदात्मने ।\nनमः सवित्रे सूर्याय जगदानंददायिने ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003902122, "chapter_id": 23902, "verse_number": "२-८-७-१२३", "content_sanskrit": "प्रभागेहाय देवाय त्रयीभूताय ते नमः ।\nविवस्वते नमस्तुभ्यं योगज्ञाय सदात्मने ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003902123, "chapter_id": 23902, "verse_number": "२-८-७-१२४", "content_sanskrit": "पराय परमेशाय त्रिलोकीतिमिरच्छिदे ।\nअचिन्त्याय सदा तुभ्यं नमो भास्करतेजसे ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003902124, "chapter_id": 23902, "verse_number": "२-८-७-१२५", "content_sanskrit": "योगप्रियाय योगाय योगज्ञाय सदा नमः ।\nओंकाराय वषट्काररूपिणे ज्ञानरूपिणे ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003902125, "chapter_id": 23902, "verse_number": "२-८-७-१२६", "content_sanskrit": "यज्ञाय यज्ञमानाय हविषे ऋत्विजे नमः ।\nरोगघ्नाय स्वरूपाय कमलानंददायिने ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003902126, "chapter_id": 23902, "verse_number": "२-८-७-१२७", "content_sanskrit": "अतिसौम्यातितीक्ष्णाय सुराणां पतये नमः ।\nसत्राशाय नमस्तुभ्यं भक्तत्राय प्रियात्मने ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003902127, "chapter_id": 23902, "verse_number": "२-८-७-१२८", "content_sanskrit": "प्रकाशकाय सततं लोकानां हितकारिणे ।\nप्रसीद प्रणतायाद्य मह्यं भक्तिकृते स्वयम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003902128, "chapter_id": 23902, "verse_number": "२-८-७-१२९", "content_sanskrit": "अगस्त्य उवाच ।\nइत्येवं ब्रुवतस्तस्य स प्रसन्नो रविः स्वयम् ।\nआविर्बभूव सहसा भक्तस्य प्रियकाम्यया ।\nउवाच मधुरं वाक्यं प्रश्रयानतमूर्द्धजम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003902129, "chapter_id": 23902, "verse_number": "२-८-७-१३०", "content_sanskrit": "रविरुवाच ।\nवरं वरय राजेंद्र प्रसन्नोऽस्मि तवाग्रतः ।\nददामि तद्वरं तेऽद्य यत्त्वया मनसेप्सितम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003902130, "chapter_id": 23902, "verse_number": "२-८-७-१३१", "content_sanskrit": "राजोवाच ।\nभगवन्भास्करानंत प्रयच्छसि वरं यदि ।\nमन्नाम्ना कृतमूर्त्तिस्ते तिष्ठत्वत्र सदा विभो ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003902131, "chapter_id": 23902, "verse_number": "२-८-७-१३२", "content_sanskrit": "रविरुवाच ।\nएवमस्तु मनुष्येंद्र तव वांछा मनोहरा ।\nएतत्स्तोत्रं त्वयोक्तं मे ये पठिष्यंति मानवाः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003902132, "chapter_id": 23902, "verse_number": "२-८-७-१३३", "content_sanskrit": "तेभ्यस्तुष्टः प्रदास्यामि सर्वान्कामान्नरेश्वर ।\nएतत्स्थानं परां ख्यातिं त्वन्नाम्ना यास्यति क्षितौ ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003902133, "chapter_id": 23902, "verse_number": "२-८-७-१३४", "content_sanskrit": "सर्वान्कामानवाप्नोति योऽत्र स्नानं समाचरेत् ।\nमद्भक्तेन सदा राजन्कर्त्तव्यं स्नानमत्र वै ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003902134, "chapter_id": 23902, "verse_number": "२-८-७-१३५", "content_sanskrit": "यंयं काममिहेच्छेत तंतं काममवाप्नुयात् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003902135, "chapter_id": 23902, "verse_number": "२-८-७-१३६", "content_sanskrit": "अगस्त्य उवाच ।\nइति दत्त्वा वरं देवः कृपया परया युतः ।\nभास्वान्सहस्रकिरणस्तदान्तर्द्धानमाययौ ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003902136, "chapter_id": 23902, "verse_number": "२-८-७-१३७", "content_sanskrit": "राजा भास्करदेहोत्थां रविमूर्त्तिमनुत्तमाम् ।\nतत्र संस्थापयामास पूजयामास च स्वयम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003902137, "chapter_id": 23902, "verse_number": "२-८-७-१३८", "content_sanskrit": "घोषार्ककुण्डं तन्नाम्ना तत्र ख्यातिं जगाम ह ।\nयत्र स्नानान्नरो राजन्सूर्य्यलोके वसेत्सदा ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003902138, "chapter_id": 23902, "verse_number": "२-८-७-१३९", "content_sanskrit": "इति रुचिरविधानैस्तूर्णमादित्यमूर्त्तिं विमलपरमभक्त्या पूजयित्वाऽदरेण ।\nतदमृतमयकुण्डे स्नानमादौ विधाय प्रचुरविमलकीर्तिः सूर्यलोके वसेत्सः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}]