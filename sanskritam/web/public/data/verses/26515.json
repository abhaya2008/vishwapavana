[{"id": 7006515000, "chapter_id": 26515, "verse_number": "३-५४-१", "content_sanskrit": "देवासुराणां युद्धस्य यज्ञरूपेण वर्णनं, द्वयोः सेनयोः तुमुलं युद्धं, सावित्रध्रुवयोः पराजयम् वैशम्पायन उवाच उभयोः सेनयो राजन् भूयो युद्धमवर्तत ।\nनादेन संचालयतां त्रैलोक्यमिदमव्ययम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006515001, "chapter_id": 26515, "verse_number": "३-५४-२", "content_sanskrit": "गोमुखाडम्बराणां च भेरीणां मुरजैः सह ।\nझल्लरीडिण्डिमानां च व्यभूयन्त महास्वनाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006515002, "chapter_id": 26515, "verse_number": "३-५४-३", "content_sanskrit": "प्रवृत्तो युद्धयज्ञस्तु तुमुलो लोमहर्षणः ।\nरणमध्ये महानादः स्वर्गीयः शूरसम्मतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006515003, "chapter_id": 26515, "verse_number": "३-५४-४", "content_sanskrit": "युद्धयज्ञस्य नेताभूत् प्रह्रादो दैत्यसत्तमः ।\nविरोचनस्तथाध्वर्युर्युद्धयज्ञप्रवर्तकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006515004, "chapter_id": 26515, "verse_number": "३-५४-५", "content_sanskrit": "होता चैवात्र नमुचिर्वृत्रः स्तोत्रोपकल्पकः ।\nमन्त्रा दैत्याः समाख्याता यज्ञकर्मणि तत्र वै ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006515005, "chapter_id": 26515, "verse_number": "३-५४-६", "content_sanskrit": "अनुयातश्च पितरमधिको वा पराक्रमैः ।\nयष्टा तत्राभवद् बाण संयुगे चोपतिष्ठते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006515006, "chapter_id": 26515, "verse_number": "३-५४-७", "content_sanskrit": "ऐन्द्रं पाशुपतं ब्राह्मं स्थूणाकर्णं सुदुर्जयम् ।\nमन्त्रास्तत्राभ्यवर्तन्त साध्वनुह्रादयोजिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006515007, "chapter_id": 26515, "verse_number": "३-५४-८", "content_sanskrit": "उद्गाता च मयः श्रीमान् स्थितः शत्रुभयंकरः ।\nविनदन् दितिजश्रेष्ठो देवानीकं व्यदारयत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006515008, "chapter_id": 26515, "verse_number": "३-५४-९", "content_sanskrit": "बलिस्तु राजा द्युतिमान् स्वयं तत्र महासुरः ।\nजाप्यैर्होमैश्च संयुक्ता ब्रह्मत्वमकरोत्प्रभुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006515009, "chapter_id": 26515, "verse_number": "३-५४-१०", "content_sanskrit": "रणाग्निर्ज्वलितो घोरो वैरेन्धनसमीरितः ।\nहूयते त्वसुरैस्तत्र देवो विष्णुः सुरैः सह ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006515010, "chapter_id": 26515, "verse_number": "३-५४-११", "content_sanskrit": "शङ्खशब्दैः सुतुमुलैर्भेरीणां च महास्वनैः ।\nउद्घुष्टं विमलं चैव सुब्रह्मण्यं प्रयुज्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006515011, "chapter_id": 26515, "verse_number": "३-५४-१२", "content_sanskrit": "बलश्च बलकश्चैव पुलोमा च महासुरः ।\nप्रशस्तं च समं कृत्वा सत्रं सम्यक् प्रचक्रिरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006515012, "chapter_id": 26515, "verse_number": "३-५४-१३", "content_sanskrit": "कल्माषदण्डा विमला विपुला रथपङ्क्तयः ।\nयूपाश्च समकल्पन्त युद्धयज्ञे महाफले ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006515013, "chapter_id": 26515, "verse_number": "३-५४-१४", "content_sanskrit": "कर्णिनालीकनाराचा वत्सदन्तोपबृंहिकाः ।\nतोमराः सोमकलशा विचित्राणि धनूंषि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006515014, "chapter_id": 26515, "verse_number": "३-५४-१५", "content_sanskrit": "अस्थीन्यत्र कपालानि पुरोडाशाः शिरांसि च ।\nआज्यं च रौद्रं रुधिरं तस्मिन् यज्ञेऽभिहूयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006515015, "chapter_id": 26515, "verse_number": "३-५४-१६", "content_sanskrit": "इध्माः परिधयस्तत्र प्रस्तारा विपुला गदाः ।\nहयग्रीवोऽसिलोमा च राहुः केशी च दानवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006515016, "chapter_id": 26515, "verse_number": "३-५४-१७", "content_sanskrit": "विरोचनश्च जम्भश्च कुजम्भश्च महाबलः ।\nसदस्यास्तत्र तु मखे विप्रचित्तिस्तु वीर्यवान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006515017, "chapter_id": 26515, "verse_number": "३-५४-१८", "content_sanskrit": "इषवस्तु स्रुवास्तत्र रथाक्षसदृशाः शुभाः ।\nधनुष्कोट्या धनुर्ज्याश्च स्रुवस्तत्र महामखे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006515018, "chapter_id": 26515, "verse_number": "३-५४-१९", "content_sanskrit": "प्रतिप्रास्थानिकं कर्म वृषपर्वाकरोदिह ।\nदीक्षितस्तत्र तु बलिस्तस्य पत्नी महाचमूः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006515019, "chapter_id": 26515, "verse_number": "३-५४-२०", "content_sanskrit": "शम्बरस्तत्र शामित्रमकरोद् दितिनन्दनः ।\nअतिरात्रे महाबाहुर्वितते यज्ञकर्मणि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006515020, "chapter_id": 26515, "verse_number": "३-५४-२१", "content_sanskrit": "दक्षिणास्तस्य यज्ञस्य कालनेमिर्महासुरः ।\nवैताने कर्मणि विभोर्यः ख्यातो हव्यवाडिव ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006515021, "chapter_id": 26515, "verse_number": "३-५४-२२", "content_sanskrit": "त्रिदशानां तु सैन्यस्य शरीरैर्गतजीवितैः ।\nतस्मिन् यज्ञे तु सवनं वर्धते दैत्यनिर्मितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006515022, "chapter_id": 26515, "verse_number": "३-५४-२३", "content_sanskrit": "देवानां रुधिरं संख्ये पपुरुग्रा दितेः सुताः ।\nनर्दमानाः प्रमुदिताः सोमपानं रणाध्वरे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006515023, "chapter_id": 26515, "verse_number": "३-५४-२४", "content_sanskrit": "यदा बलिर्महादैत्यो विजेता समरे सुरान् ।\nतदा ह्यवभृथो यज्ञे भविष्यति न संशयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006515024, "chapter_id": 26515, "verse_number": "३-५४-२५", "content_sanskrit": "महासुरेन्द्रपतयो यज्वानो भूरिदक्षिणाः ।\nवेदवन्तो वृत्तवन्तः शूराः सर्वे तनुत्यजः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006515025, "chapter_id": 26515, "verse_number": "३-५४-२६", "content_sanskrit": "त्रैलोक्यहरणे सृष्टा युद्धयज्ञाय दीक्षिताः ।\nबद्धकृष्णाजिनाः सर्वे व्रतिनो मुञ्जधारिणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006515026, "chapter_id": 26515, "verse_number": "३-५४-२७", "content_sanskrit": "एकनिश्चयकार्याश्च त्रैलोक्यजयकाङ्क्षिणः ।\nसुरदानवदैत्यानां शब्दः समभवन्महान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006515027, "chapter_id": 26515, "verse_number": "३-५४-२८", "content_sanskrit": "नानायुधविहस्तानां त्वरितानां प्रधावताम् ।\nक्ष्वेडितोत्क्रुष्टनिनदैर्गजबृंहितनिःस्वनैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006515028, "chapter_id": 26515, "verse_number": "३-५४-२९", "content_sanskrit": "रथनेमिस्वनैर्घोरैस्तुमुलः सर्वतोऽभवत् ।\nशङ्खदुन्दुभिनिर्घोषैर्हयहेषितनिःस्वनैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006515029, "chapter_id": 26515, "verse_number": "३-५४-३०", "content_sanskrit": "हयानां हेषमाणानां दानवानां च गर्जताम् ।\nक्ष्वेडितोत्क्रुष्टनिनदैः पाणिपादरवैस्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006515030, "chapter_id": 26515, "verse_number": "३-५४-३१", "content_sanskrit": "दानवानां परेषां च शस्त्रवन्ति महान्ति च ।\nसमरे भीमकर्माणि सैन्यानि प्रचकाशिरे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006515031, "chapter_id": 26515, "verse_number": "३-५४-३२", "content_sanskrit": "ततो नागा रथाश्चैव जाम्बूनदविभूषिताः ।\nभ्राजमाना व्यराजन्त मेघा इव सविद्युतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006515032, "chapter_id": 26515, "verse_number": "३-५४-३३", "content_sanskrit": "ऋष्टिखड्गगदास्तीक्ष्णाः शूलशक्तिपरश्वधाः ।\nचारु विभ्राजिरे तत्र तेष्वनीकेषु भागशः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006515033, "chapter_id": 26515, "verse_number": "३-५४-३४", "content_sanskrit": "रथा बहुविधाकाराः शतशोऽथ सहस्रशः ।\nहेमप्रच्छन्नशिखरा ज्वलन्त इव पावकाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006515034, "chapter_id": 26515, "verse_number": "३-५४-३५", "content_sanskrit": "दानवानां सुराणां च समालोक्यन्त सैनिकाः ।\nकाञ्चनैः कवचैः सर्वे ज्वलितार्कसमप्रभैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006515035, "chapter_id": 26515, "verse_number": "३-५४-३६", "content_sanskrit": "संनद्धाः समदृश्यन्त ज्योतींषि गगने यथा ।\nउद्यतैरायुधैश्चित्रैस्तलबद्धाः कलापिनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006515036, "chapter_id": 26515, "verse_number": "३-५४-३७", "content_sanskrit": "ऋषभाक्षाः सुरगणाश्चमूमुखगता बभुः ।\nनानावर्णाः पताकाश्च ध्वजमालाश्च संयुगे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006515037, "chapter_id": 26515, "verse_number": "३-५४-३८", "content_sanskrit": "युद्ध्यतां रणशौण्डानामीरयामास मारुतः ।\nध्वजालंकारवस्त्राणि कवचानि च रश्मिभिः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006515038, "chapter_id": 26515, "verse_number": "३-५४-३९", "content_sanskrit": "भासयामास सर्वाणि रश्मिवर्णानि रश्मिवान् ।\nसर्वेषामप्रमेयाणां बलानां पादचारिणाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006515039, "chapter_id": 26515, "verse_number": "३-५४-४०", "content_sanskrit": "रजः प्रच्छादयामास पत्रोर्णं पाण्डुरं दिशः ।\nदिव्यायुधधराः सर्वे दीप्तायुधपरिच्छदाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006515040, "chapter_id": 26515, "verse_number": "३-५४-४१", "content_sanskrit": "प्रतितस्तम्भिरेऽन्योन्यमनीकं प्रत्यनीकतः ।\nगिरिकूटोच्छ्रयाः सर्वे तदा ते देवदानवाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006515041, "chapter_id": 26515, "verse_number": "३-५४-४२", "content_sanskrit": "अन्योन्यमभिनिघ्नन्तो रणस्थाश्चित्रयोधिनः ।\nबाणैः सुरुचिरैस्तीक्ष्णैः पत्रवाजैर्दुरासदैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006515042, "chapter_id": 26515, "verse_number": "३-५४-४३", "content_sanskrit": "मुद्गरैर्मुसलैः शूलैरयस्तुण्डैरुलूखलैः ।\nवज्रैरशनिकल्पैश्च खड्गवृक्षादिभिस्तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006515043, "chapter_id": 26515, "verse_number": "३-५४-४४", "content_sanskrit": "तथा प्रवर्तिते तेषां विमर्देऽद्भुतविक्रमे ।\nसावित्रस्य वधं प्रेप्सुर्बाणो जग्राह कार्मुकम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006515044, "chapter_id": 26515, "verse_number": "३-५४-४५", "content_sanskrit": "शरजालेन दिव्येन च्छादयानः सुरोत्तमम् ।\nमन्त्रैर्हुत इवार्चिष्मान् सम्प्रजज्वाल तेजसा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006515045, "chapter_id": 26515, "verse_number": "३-५४-४६", "content_sanskrit": "सागराभां महासेनां देवानां दैत्यपुंगवः ।\nसंशोषयति बाणौघैरर्कोंऽशुभिरिवार्णवम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006515046, "chapter_id": 26515, "verse_number": "३-५४-४७", "content_sanskrit": "मारुतः सुमहावेगः सावित्रः शक्तिमुत्तमाम् ।\nचिक्षेप बलिपुत्राय शक्रोऽशनिमिवाद्रये ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006515047, "chapter_id": 26515, "verse_number": "३-५४-४८", "content_sanskrit": "आपतन्ती च सा शक्तिर्महोल्का ज्वलिता इव ।\nद्विधा छिन्ना क्षुरप्रेण बाणेनाद्भुतकर्मणा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006515048, "chapter_id": 26515, "verse_number": "३-५४-४९", "content_sanskrit": "हतायामथ शक्त्यां तु सावित्रो देवसत्तमः ।\nविश्वकर्मकृतं दिव्यं सुतीक्ष्ण दानवार्दनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006515049, "chapter_id": 26515, "verse_number": "३-५४-५०", "content_sanskrit": "सुपीनधारं विमलं विपुलं चन्द्रवर्चसम् ।\nअगृह्णन्निशितं खड्गमाशीविषमिवोरगम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006515050, "chapter_id": 26515, "verse_number": "३-५४-५१", "content_sanskrit": "तं गृहीत्वा रणमुखे प्रज्वलन्तं महाप्रभम् ।\nबाणाभ्याशे महातेजाः खड्गपाणिरवस्थितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006515051, "chapter_id": 26515, "verse_number": "३-५४-५२", "content_sanskrit": "स तं स्थितमथालक्ष्य सावित्रं बलिनन्दनः ।\nलोहिताक्षं महाकायं चिक्षेप च ननाद च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006515052, "chapter_id": 26515, "verse_number": "३-५४-५३", "content_sanskrit": "ततोऽर्ककिरणाकारानशनिप्रतिमाञ्छितान् ।\nसंदधे चाशु बाणौघानाशीविषशिलीमुखान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006515053, "chapter_id": 26515, "verse_number": "३-५४-५४", "content_sanskrit": "रुक्मपुङ्खान् प्रदीप्ताग्रानुग्रवेगानलंकृतान् ।\nआकर्णपूरांश्चिक्षेप शरानुग्रान् समन्ततः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006515054, "chapter_id": 26515, "verse_number": "३-५४-५५", "content_sanskrit": "दृढचापप्रयुक्तास्ते शरा वैश्वानरप्रभाः ।\nसावित्रं छादयामासुः कैलासमिव तोयदाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006515055, "chapter_id": 26515, "verse_number": "३-५४-५६", "content_sanskrit": "संछाद्यमानः शस्त्रौघैर्बाणेन बलिसूनुना ।\nपराङ्मुखः सुरवरः प्रयातः सरथध्वजः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006515056, "chapter_id": 26515, "verse_number": "३-५४-५७", "content_sanskrit": "पराजित्य स सावित्रं बाणः परमहर्षितः ।\nप्रगृह्य कार्मुकं घोरं गतः शक्ररथं प्रति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006515057, "chapter_id": 26515, "verse_number": "३-५४-५८", "content_sanskrit": "बलश्चाप्यसुरश्रेष्ठः प्रगृह्य महतीं गदाम् ।\nध्रुवाय वसवे मूर्ध्नि रौद्रां चिक्षेप दानवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006515058, "chapter_id": 26515, "verse_number": "३-५४-५९", "content_sanskrit": "तस्य निर्मथितं त्वंसे हेमचित्रं च वर्म वै ।\nगदावेगेन भीमेन ध्रुवस्य समरे तदा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006515059, "chapter_id": 26515, "verse_number": "३-५४-६०", "content_sanskrit": "शेषाश्च वसवः सर्वे दिव्यास्त्रैर्घोरदर्शनैः ।\nप्राच्छादयन् रणे दैत्यमादित्यमिव तोयदाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006515060, "chapter_id": 26515, "verse_number": "३-५४-६१", "content_sanskrit": "ततः सम्मर्दितो बाणैर्बलो दानवसत्तमः ।\nअवातरद् रथात्तस्माद् गदामुद्यम्य वेगवान् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006515061, "chapter_id": 26515, "verse_number": "३-५४-६२", "content_sanskrit": "पातयामास शत्रूणां समाविध्य महासुरः ।\nदिशः प्राद्रावयत्सर्वांस्त्रिदशान्सा महागदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006515062, "chapter_id": 26515, "verse_number": "३-५४-६३", "content_sanskrit": "इन्द्राशनिरिवेन्द्रेण प्रवृद्धा सुमहास्वना ।\nतस्याः सविद्युद्धोषायास्तेन शब्देन वेपिताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006515063, "chapter_id": 26515, "verse_number": "३-५४-६४", "content_sanskrit": "व्यद्रवन्त परिभ्रष्टा रथेभ्यो रथिनस्तदा ।\nतदुदीर्णे रथानीकं सूर्याभं मेघनिःस्वनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006515064, "chapter_id": 26515, "verse_number": "३-५४-६५", "content_sanskrit": "देवानां शरधाराभिः समन्तादभ्यवर्षत ।\nक्षुरप्रैर्विशिखैर्भल्लैर्वत्सदन्तैः शिलीमुखैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006515065, "chapter_id": 26515, "verse_number": "३-५४-६६", "content_sanskrit": "मुहुर्मुहुर्महातेजाः प्रत्यविध्यन्महासुरः ।\nबलाकस्तु गदापाणिर्व्यादितास्य इवान्तकः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006515066, "chapter_id": 26515, "verse_number": "३-५४-६७", "content_sanskrit": "तडिद्गणार्कसदृशो वैश्वानर इवापरः ।\nपिबन्निव शरौघांस्तान् देवचापसमुच्छ्रितान् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006515067, "chapter_id": 26515, "verse_number": "३-५४-६८", "content_sanskrit": "अभ्यद्रवत दैत्येन्द्रो महार्णव इवापरः ।\nअवस्फूर्जन् दिशः सर्वाः स्वेन वीर्येण दानवः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006515068, "chapter_id": 26515, "verse_number": "३-५४-६९", "content_sanskrit": "अरुणत्त्रिदशान् दैत्यः सिंधुवेगान् नगा इव ।\nसमुद्रस्तरसा देवान् वायुर्वृक्षानिवौजसा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006515069, "chapter_id": 26515, "verse_number": "३-५४-७०", "content_sanskrit": "दमयंश्च महेष्वासान् वसुभ्यां समसज्जत ।\nआपश्चैवानिलश्चैव ववर्षतुररिंदमौ ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006515070, "chapter_id": 26515, "verse_number": "३-५४-७१", "content_sanskrit": "शरवर्षाणि दीप्तानि मेघाविव परंतपौ ।\nक्षिप्तांस्तान् विशिखान् दीप्तानन्तरिक्षे स चिच्छिदे ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006515071, "chapter_id": 26515, "verse_number": "३-५४-७२", "content_sanskrit": "अमृष्यमाणस्तत्कर्म ध्रुवस्तमभिदुद्रुवे ।\nतौ पृथक्छरवर्षाभ्यामन्योन्यमभिजघ्नतुः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006515072, "chapter_id": 26515, "verse_number": "३-५४-७३", "content_sanskrit": "उत्तमाभिजनौ शूरौ देवदैत्यौ यशस्करौ ।\nतौ नखैरिव शार्दूलौ दन्तैरिव महाद्विपौ ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006515073, "chapter_id": 26515, "verse_number": "३-५४-७४", "content_sanskrit": "रथशक्तिभिरन्योन्यं विशिखैश्चाप्यकृन्तताम् ।\nनिर्भिन्दन्तौ च गात्राणि विलिखन्तौ च सायकैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006515074, "chapter_id": 26515, "verse_number": "३-५४-७५", "content_sanskrit": "स्तम्भयन्तौ च बलिनौ प्रतुदन्तौ स्थितौ रणे ।\nचरन्तौ विविधान् मार्गान्मण्डलानि च भागशः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006515075, "chapter_id": 26515, "verse_number": "३-५४-७६", "content_sanskrit": "मुद्गरैर्जघ्नतुः क्रुद्धावन्योन्यमभिमानिनौ ।\nअसिभ्यां चर्मणी दिव्ये विपुले च शरासने ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006515076, "chapter_id": 26515, "verse_number": "३-५४-७७", "content_sanskrit": "निकृत्याचलसंकाशौ बाहुयुद्धं प्रचक्रतुः ।\nव्यूढोरस्कौ दीर्घभुजौ नियुद्धकुशलावुभौ ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006515077, "chapter_id": 26515, "verse_number": "३-५४-७८", "content_sanskrit": "बाहुभिः समसज्जेतामायसैः परिघैरिव ।\nतयोरासीद् भुजाघातैर्निग्रहः प्रग्रहस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006515078, "chapter_id": 26515, "verse_number": "३-५४-७९", "content_sanskrit": "अतीव भीमः संह्रादो वज्रपर्वतयोरिव ।\nद्विपाविव विषाणाग्रैः शृङ्गैरिव महावृषौ ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006515079, "chapter_id": 26515, "verse_number": "३-५४-८०", "content_sanskrit": "अन्योन्यमभिसंरब्धौ मुहूर्तं पर्यकर्षताम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006515080, "chapter_id": 26515, "verse_number": "३-५४-८१", "content_sanskrit": "ततः पराजितो देवो बलाकेन तथा ध्रुवः ।\nरथं त्यक्त्वा भयात्तस्य प्रणष्टः प्राङ्मुखो वसुः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]