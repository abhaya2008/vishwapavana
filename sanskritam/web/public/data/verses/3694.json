[{"id": 2125692, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2125693, "chapter_id": 3694, "verse_number": "१", "content_sanskrit": "गतेषु तेषु सर्वे ब्राह्मणेषु तपस्विषु ।\nपिनाकपाणिर्भगवान् सर्वपापहरो हरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2125694, "chapter_id": 3694, "verse_number": "२", "content_sanskrit": "कैरातं वेषमास्थाय काञ्चनद्रुमसन्निभः ।\nविभ्राजमानो धनुषा गिरिर्मेरुरिवापरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2125695, "chapter_id": 3694, "verse_number": "३", "content_sanskrit": "श्रीमद्धनुरुपादाय शरांश्चाशीविषोपमान् ।\nनिष्पपात महार्चिष्मान् दहनः कक्षवानिव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2125696, "chapter_id": 3694, "verse_number": "४", "content_sanskrit": "देव्या सहोमया श्रीमान् समानव्रतवेषया ।\nनानावेषधरैर्हृष्टैर्भूतैरनुगतस्तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2125697, "chapter_id": 3694, "verse_number": "५", "content_sanskrit": "किरातवेषसञ्छन्नैः स्त्रीभिश्चापि सहस्रशः ।\nअशोभत तदा राजन् स देवोऽतीव भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2125698, "chapter_id": 3694, "verse_number": "६", "content_sanskrit": "क्षणेन तद्वनं सर्वं निःशब्दमभवत् तदा ।\nनादः प्रस्रवणानां च पक्षिणामप्युपारमत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2125699, "chapter_id": 3694, "verse_number": "७", "content_sanskrit": "स सन्निकर्षमागम्य पार्थस्याक्लिष्टकर्मणः ।\nमूकं नाम दितेः पुत्रं ददर्शाद्भुतविक्रमम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2125700, "chapter_id": 3694, "verse_number": "८", "content_sanskrit": "वाराहं रूपमास्थाय तर्जयन्तमिवार्जुनम् ।\nहन्तुं परमदुष्टात्मा तमुवाचाथ फल्गुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2125701, "chapter_id": 3694, "verse_number": "९", "content_sanskrit": "गाण्डीवं धनुरादाय शरांश्चाशीविषोपमान् ।\nसज्यं धनुर्वरं कृत्वा ज्याघोषेण व्यनादयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2125702, "chapter_id": 3694, "verse_number": "१०", "content_sanskrit": "यन्मां प्रार्थयसे हन्तुमनागसमिहागतः।\nतस्मात्त्वां पूर्वमेवाद्य नेष्यामि यमसादनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2125703, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2125704, "chapter_id": 3694, "verse_number": "११", "content_sanskrit": "दृष्ट्वा तं प्रहरिष्यन्तं फल्गुनं दृढधन्विनम् ।\nकिरातरूपी सहसा वारयामास शङ्करः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2125705, "chapter_id": 3694, "verse_number": "१२", "content_sanskrit": "मयैष प्रार्थितः पूर्वं नीलमेघसमप्रभः ।\nअनादृत्यैव तद्वाक्यं प्रजहारैव फल्गुनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2125706, "chapter_id": 3694, "verse_number": "१३", "content_sanskrit": "किरातश्च समं तस्मिन्नेकलक्षे महाद्युतिः ।\nप्रमुमोचाशनिप्रख्यं शरमग्निशिखोपमम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2125707, "chapter_id": 3694, "verse_number": "१४", "content_sanskrit": "तौ मुक्तौ सायकौ ताभ्यां समं तत्र निपेततुः ।\nमूकस्य गात्रे विस्तीर्णे शैलपृष्ठनिभे तदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2125708, "chapter_id": 3694, "verse_number": "१५", "content_sanskrit": "यथाऽशनेर्विनिष्पेषो वज्रस्येव च पर्वते ।\nतथा तयोः सन्निपातः शरयोरभवत् तदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2125709, "chapter_id": 3694, "verse_number": "१६", "content_sanskrit": "स विद्धो बहुभिर्बाणैर्दीप्तास्यैः पन्नगैरिव ।\nममार राक्षसं रूपं भूयः कृत्वाऽतिदारुणम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2125710, "chapter_id": 3694, "verse_number": "१७", "content_sanskrit": "ददर्शाथ ततो जिष्णुः पुरुषं काञ्चनप्रभम् ।\nकिरातवेषप्रच्छन्नं स्त्रीसहायममित्रहा ।\nतमब्रवीत् प्रीतमनाः कौन्तेयः प्रहसन्निव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2125711, "chapter_id": 3694, "verse_number": "१८", "content_sanskrit": "को भवानटते शून्ये वने स्त्रीगणसंवृतः ।\nन त्वमस्मिन् वने घोरे बिभेषि कनकप्रभ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2125712, "chapter_id": 3694, "verse_number": "१९", "content_sanskrit": "किमर्थं च त्वया विद्धो मृगोऽयं मत्परिग्रहः ।\nमयाऽभिपन्नः पूर्वं हि राक्षसोऽयमिहागतः ।\nकामात् परिभवाच्चापि न मे जीवन् विमोक्ष्यसे \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2125713, "chapter_id": 3694, "verse_number": "२०", "content_sanskrit": "न ह्येष मृगयाधर्मो यस्त्वयाऽद्य कृतो मयि ।\nतेन त्वां भ्रंशयिष्यामि जीवितान् पर्वताश्रयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2125714, "chapter_id": 3694, "verse_number": "२१", "content_sanskrit": "इत्युक्तः पाण्डवेयेन किरातः प्रहसन्निव ।\nउवाच श्लक्ष्णया वाचा पाण्डवं सव्यसाचिनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2125715, "chapter_id": 3694, "verse_number": "२२", "content_sanskrit": "ममैवायं लक्षभूतः पूर्वमेव परिग्रहः ।\nममैव च प्रहारेण जीवितादवरोपितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2125716, "chapter_id": 3694, "verse_number": "२३", "content_sanskrit": "दोषान् स्वान् नार्हसेऽन्यस्मै वक्तुं स्वबलदर्पितः ।\nअभिषक्तोऽस्मि मन्दात्मन् न मे जीवन् विमोक्ष्यसे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2125717, "chapter_id": 3694, "verse_number": "२४", "content_sanskrit": "स्थिरो भवस्व मोक्षामि सायकानशनीनिव ।\nघटस्व परया शक्त्या मुञ्च त्वमपि सायकान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2125718, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2125719, "chapter_id": 3694, "verse_number": "२५", "content_sanskrit": "ततस्तौ तत्र संरब्धौ गर्जमानौ मुहुर्मुहुः ।\nशरैराशीविषाकारैः ततक्षाते परस्परम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2125720, "chapter_id": 3694, "verse_number": "२६", "content_sanskrit": "ततोऽर्जुनः शरव्रातान् किराते समवासृजत् ।\nतत्प्रसन्नेन मनसा प्रतिजग्राह शङ्करः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2125721, "chapter_id": 3694, "verse_number": "२७", "content_sanskrit": "मुहूर्तं शरवर्षं तु प्रतिगृह्य पिनाकधृक् ।\nअक्षतेन शरीरेण तस्थौ गिरिरिवाचलः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2125722, "chapter_id": 3694, "verse_number": "२८", "content_sanskrit": "स दृष्ट्वा बाणवर्षं तु मोघीभूतं धनञ्जयः ।\nपरमं विस्मयं चक्रे साधु साध्विति चाब्रवीत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2125723, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2125724, "chapter_id": 3694, "verse_number": "२९", "content_sanskrit": "अहोऽयं सुकुमाराङ्गो हिमवच्छिखराश्रयः ।\nगाण्डीवमुक्तान् नाराचान् प्रतिगृह्णात्यविह्वलः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2125725, "chapter_id": 3694, "verse_number": "३०", "content_sanskrit": "कोऽयं देवो भवेत् साक्षाद् रुद्रो यक्षोऽथ राक्षसः ।\nविद्यते हि गिरिश्रेष्ठे त्रिदशानां समागमः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2125726, "chapter_id": 3694, "verse_number": "३१", "content_sanskrit": "न हि मद्वाणजालानामुत्सृष्टानां सहस्रशः ।\nशक्तोऽन्यः सहितुं वेगमृते देवं पिनाकिनम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2125727, "chapter_id": 3694, "verse_number": "३२", "content_sanskrit": "देवो वा यदि वा रक्षो रुद्रोन्यो वा व्यवस्थितः ।\nअहमेनं शरैस्तीक्ष्णैर्नयामि यमसादनम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2125728, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2125729, "chapter_id": 3694, "verse_number": "३३", "content_sanskrit": "ततो हृष्टमना जिष्णुर्नाराचान् मर्मभेदिनः ।\nव्यसृजच्छतधा राजन् मयूखानिव भास्करः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2125730, "chapter_id": 3694, "verse_number": "३४", "content_sanskrit": "तान् प्रसन्नेन मनसा भगवाँल्लोकभावनः ।\nशूलपाणिः प्रत्यगृह्णात् शिलावर्षमिवाचलः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2125731, "chapter_id": 3694, "verse_number": "३५", "content_sanskrit": "क्षणेन क्षीणबाणस्तु संवृत्तः फल्गुनस्तदा ।\nशरासं च स जग्राह तं दृष्ट्वा शरसङ्क्षयम् ।\nचिन्तयामास जिष्णुस्तु भगवन्तं हुताशनम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2125732, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2125733, "chapter_id": 3694, "verse_number": "३६", "content_sanskrit": "पुरस्तादक्षयौ दत्तौ तूणौ मे येन खाण्डवे ।\nकिं नु मोक्ष्यामि धनुषा यन्मे बाणाः क्षयं गताः ।\nअयं च पुरुषः कोऽपि बाणान् ग्रसति सर्वशः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2125734, "chapter_id": 3694, "verse_number": "३७", "content_sanskrit": "अहमेनं धनुष्कोट्या शूलाग्रेणेव कुञ्जरम् ।\nनयामि दण्डधारस्य यमस्य सदनं प्रति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2125735, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2125736, "chapter_id": 3694, "verse_number": "३८", "content_sanskrit": "सम्प्रायुद्ध्यत् तमासाद्य क्षात्रं धर्ममनुव्रतः ।\nसम्प्रयुद्ध्यन् धनुष्कोट्या कौन्तेयः परवीरहा \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2125737, "chapter_id": 3694, "verse_number": "३९", "content_sanskrit": "अतुलं देवमीशानं ललाटे समताडयत् ।\nतदप्यस्य धनुर्दिव्यं जग्राह गिरिगोचरः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2125738, "chapter_id": 3694, "verse_number": "४०", "content_sanskrit": "ततोऽर्जुनो ग्रस्तधनुः खड्गपाणिरतिष्ठत ।\nयुद्धस्यान्तमभीप्सन् वै वेगेनाभिजगाम तम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2125739, "chapter_id": 3694, "verse_number": "४१", "content_sanskrit": "तस्य मूर्ध्नि शितं खड्गमसक्तं पर्वतेष्वपि ।\nमुमोच भुजवीर्येण विक्रम्य कुरुनन्दनः ।\nतस्य मूर्धानमासाद्य पफालासिवरोऽथ सः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2125740, "chapter_id": 3694, "verse_number": "४२", "content_sanskrit": "ततो वृक्षैः शिलाभिश्च योधयामास फल्गुनः ।\nयथा वृक्षान्महाकायः प्रत्यगृह्णादथो शिलाः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2125741, "chapter_id": 3694, "verse_number": "४३", "content_sanskrit": "किरातरूपी भगवांस्ततः पार्थो महाबलः ।\nमुष्टिभिर्वज्रसंस्पर्शैर्धूममुत्पादयन् मुखे ।\nप्रजहार दुराधर्षे किरातसमरूपिणि \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2125742, "chapter_id": 3694, "verse_number": "४४", "content_sanskrit": "ततःशक्राशनिसमैर्मुष्टिभिर्भृशदारुणैः ।\nकिरातरूपी भगवानर्दयामास फल्गुनम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2125743, "chapter_id": 3694, "verse_number": "४५", "content_sanskrit": "ततश्चटचटाशब्दः सुघोरः समयाजत ।\nपाण्डवस्य च मुष्टीनां किरातस्य च युध्यतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2125744, "chapter_id": 3694, "verse_number": "४६", "content_sanskrit": "सुमुहूर्तं तयोर्युद्धमासील्लोकप्रहर्षणम् ।\nभुजप्रहारसंयुक्तं वृत्रवासवयोरिव\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2125745, "chapter_id": 3694, "verse_number": "४७", "content_sanskrit": "जहाराथ ततो जिष्णुः किरातमुरसा बली ।\nपाण्डवं च विचेष्टन्तं किरातोऽप्यहनद्बलात् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2125746, "chapter_id": 3694, "verse_number": "४८", "content_sanskrit": "तयोर्भुजविनिष्पेषात् सङ्घर्षेणोरसोस्तदा ।\nसमजायत गात्रेषु पावकोऽङ्गारधूमवान्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2125747, "chapter_id": 3694, "verse_number": "४९", "content_sanskrit": "तत एनं महादेवः पीड्य गात्रैः सुपीडितः ।\nतेजसाऽत्याक्रमद् रोषाच्चेतस्तस्य विमोहयन्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2125748, "chapter_id": 3694, "verse_number": "५०", "content_sanskrit": "ततो निष्पीडितैर्गात्रैः पिण्डीकृत इवाबभौ ।\nफल्गुनो गात्रसंरुद्धो देवदेवेन भारत\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2125749, "chapter_id": 3694, "verse_number": "५१", "content_sanskrit": "निरुच्छ्वासोऽभवच्चैष सन्निरुद्धो महामनाः ।\nततः पपात सम्मूढः ततः प्रीतोऽभवद्धरः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2125750, "chapter_id": 3694, "verse_number": "५२", "content_sanskrit": "सुमुहूर्तं ततो भूत्वा सचेताः पुनरुत्थितः ।\nरुधिरेणाप्लुताङ्गस्तु पाण्डवो भृशदुःखितः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2125751, "chapter_id": 3694, "verse_number": "५३", "content_sanskrit": "शरण्यं शरणं गत्वा भगवन्तं पिनाकिनम् ।\nमृन्मयं स्थण्डिले कृत्वा भावपुष्पैर्भवं तदा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2125752, "chapter_id": 3694, "verse_number": "५४", "content_sanskrit": "पूजयामास पुष्पैश्च सर्वलोकेश्वरं प्रभुम् ।\nशरण्यं शरणं गत्वा मनसा पाण्डुनन्दनः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2125753, "chapter_id": 3694, "verse_number": "५५", "content_sanskrit": "यैः पूजितस्तदा पार्थस्तान् दृष्ट्वा तस्य मूर्द्धनि ।\nहर्षेण विस्मयाविष्टो ज्ञात्वा देवं महेश्वरम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2125754, "chapter_id": 3694, "verse_number": "५६", "content_sanskrit": "पपात पादयोस्तस्य ततः प्रीतोऽभवद् भवः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2125755, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2125756, "chapter_id": 3694, "verse_number": "५७", "content_sanskrit": "भो भो फल्गुन तुष्टोऽस्मि कर्मणाऽप्रतिमेन ते ।\nशौर्येणानेन धृत्या च क्षत्रियो नास्ति ते समः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2125757, "chapter_id": 3694, "verse_number": "५८", "content_sanskrit": "समं तेजश्च वीर्यं च तवाद्य मम चानघ ।\nप्रीतस्तेऽहं महाबाहो पश्य मां पुरुषर्षभ\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2125758, "chapter_id": 3694, "verse_number": "५९", "content_sanskrit": "ददामि ते विशालाक्ष चक्षुः पूर्वं मुनिर्भवान् ।\nविजेष्यसि रणे शत्रूनपि देवान् दिवौकसः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2125759, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2125760, "chapter_id": 3694, "verse_number": "६०", "content_sanskrit": "ततो देवं महादेवं गिरिशं शूलपाणिनम् ।\nददर्श फल्गुनस्तत्र सह देव्या महाद्युतिम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2125761, "chapter_id": 3694, "verse_number": "६१", "content_sanskrit": "स जानुभ्यां महीं गत्वा शिरसा प्रणिपत्य च ।\nप्रसादयामास हरं पार्थः परपुरञ्जयः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2125762, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2125763, "chapter_id": 3694, "verse_number": "६२", "content_sanskrit": "कपर्दिन् सर्वभूतेश भगनेत्रनिपातन ।\nकारणानामपि परं जाने त्वां त्र्यम्बकं परम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2125764, "chapter_id": 3694, "verse_number": "६३", "content_sanskrit": "देवानां च गतिं देव त्वत्प्रसूतमिदं जगत् ।\nअजेयस्त्वं त्रिभिर्लोकैः सदेवासुरमानुषैः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2125765, "chapter_id": 3694, "verse_number": "६४", "content_sanskrit": "शिवाय विष्णुरूपाय शिवरूपाय विष्णवे ।\nदक्षयज्ञविनाशाय हरिरुद्राय वै नमः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2125766, "chapter_id": 3694, "verse_number": "६५", "content_sanskrit": "ललाटाक्षाय रुद्राय  मीषे  शूलपाणये ।\nपिनाकगोप्त्रे सूर्याय मार्जनीयाय वेधसे \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2125767, "chapter_id": 3694, "verse_number": "६६", "content_sanskrit": "प्रसादये त्वां भगवन् सर्वभूतनमस्कृतम् ।\nगणेशं जगतः शम्भुं लोककारणकारणम् \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2125768, "chapter_id": 3694, "verse_number": "६७", "content_sanskrit": "प्रधानपुरुषादिभ्यः परं सूक्ष्मतरं हरिम् ।\nव्यतिक्रमं मे भगवन् क्षन्तुमर्हसि शङ्कर\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2125769, "chapter_id": 3694, "verse_number": "६८", "content_sanskrit": "भगवद्दर्शनाकाङ्क्षी प्राप्तोऽस्मीमं महागिरिम् ।\nदयितं तव देवेश तापसालयमुत्तमम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2125770, "chapter_id": 3694, "verse_number": "६९", "content_sanskrit": "प्रसादये त्वां भगवन् सर्वभूतविभुं गुरुम् ।\nन मे स्यादपराधोऽयं महादेवातिसाहसात्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2125771, "chapter_id": 3694, "verse_number": "७०", "content_sanskrit": "कृतो मया यदज्ञानाद् विमर्दो यस्त्वया सह ।\nशरणं मे प्रपन्नाय तत् क्षमस्वाद्य शङ्कर\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2125772, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2125773, "chapter_id": 3694, "verse_number": "७१", "content_sanskrit": "तमुवाच महातेजाः प्रहस्य वृषभध्वजः ।\nप्रगृह्य रुचिरं बाहुं क्षान्तमित्येव फल्गुनम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2125774, "chapter_id": 3694, "verse_number": "७२", "content_sanskrit": "परिष्वज्य च बाहुभ्यां प्रीतात्मा भगवान् हरः ।\nपुनः पार्थं सान्त्वपूर्वमुवाच वृषभध्वजः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2125775, "chapter_id": 3694, "verse_number": "७३", "content_sanskrit": "गङ्गाङ्कितजटः शर्वः पार्थस्यामिततेजसः ।\nप्रगृह्य रुचिरं बाहुं वृत्तं ताम्रतळाङ्गुलिम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2125776, "chapter_id": 3694, "verse_number": "७४", "content_sanskrit": "नरस्त्वं पूर्वदेहे वै नारायणसहायवान् ।\nबदर्यां तप्तवानुग्रं तपो वर्षायुतान् बहून्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2125777, "chapter_id": 3694, "verse_number": "७५", "content_sanskrit": "त्वयि वा परमं तेजो विष्णौ वा पुरुषोत्तमे ।\nयुवाभ्यां पुरुषाग्र्याभ्यां तेजसा धार्यते जगत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2125778, "chapter_id": 3694, "verse_number": "७६", "content_sanskrit": "शक्राभिषेके सुमहद् धनुर्जलदनिस्वनम् ।\nप्रगृह्य दानवाः शस्ताः त्वया कृष्णेन च प्रभो\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2125779, "chapter_id": 3694, "verse_number": "७७", "content_sanskrit": "एतत्तदेव गाण्डीवं तव पार्थ करोचितम् ।\nमायामास्थाय यद् ग्रस्तं मया पुरुषसत्तम \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2125780, "chapter_id": 3694, "verse_number": "७८", "content_sanskrit": "तूणौ चाप्यक्षयौ भूयः तव पार्थ करोचितौ ।\nभविष्यति शरीरं च नीरुजं कुरुनन्दन\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2125781, "chapter_id": 3694, "verse_number": "७९", "content_sanskrit": "प्रीतिमानस्मि वै पार्थ तव सत्यपराक्रम ।\nगृहाण वरमस्मत्तः काङ्क्षितं पुरुषर्षभ\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2125782, "chapter_id": 3694, "verse_number": "८०", "content_sanskrit": "न त्वया सदृशः कश्चित् पुमान् मर्त्येषु भारत ।\nदिवि वा विद्यते क्षत्रं त्वत्प्रधानमरिन्दम\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2125783, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2125784, "chapter_id": 3694, "verse_number": "८१", "content_sanskrit": "भवान् ददासि चेन्मह्यं कामं प्रीत्या वृषध्वज ।\nकामये दिव्यमस्त्रं तद् घोरं पाशुपतं महत्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2125785, "chapter_id": 3694, "verse_number": "८२", "content_sanskrit": "एतद् ब्रह्यशिरो नाम रौद्रं भीमपराक्रमम् ।\nयुगान्ते दारुणे प्राप्ते कृत्स्नं संहरते जगत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2125786, "chapter_id": 3694, "verse_number": "८३", "content_sanskrit": "जयेयं येन सङ्ग्रामे दानवान् राक्षसांस्तथा ।\nराज्ञश्चैव पिशाचांश्च गन्धर्वानथ पन्नगान्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2125787, "chapter_id": 3694, "verse_number": "८४", "content_sanskrit": "यस्मिन् शूलसहस्राणि गदाश्चोग्रप्रदर्शनाः ।\nशराश्चाशीविषाकाराः सम्भवन्त्यनुमन्त्रिताः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2125788, "chapter_id": 3694, "verse_number": "८५", "content_sanskrit": "युध्येयं येन भीष्मेण द्रोणेन च कृपेण च ।\nसूतपुत्रेण च रणे नित्यं कटुकभाषिणा\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2125789, "chapter_id": 3694, "verse_number": "८६", "content_sanskrit": "एष मे प्रथमः कामो भगवन् भगनेत्रहन् ।\nत्वत्प्रसादाद्विनिर्वर्त्ते समर्थः स्यादमहं यथा\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2125790, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2125791, "chapter_id": 3694, "verse_number": "८७", "content_sanskrit": "ददामि तेऽस्त्रं दयितमहं पाशुपतं महत् ।\nसमर्थो धारणे मोक्षे संहारे चासि पाण्डव\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2125792, "chapter_id": 3694, "verse_number": "८८", "content_sanskrit": "न तद्वेद महेन्द्रोऽपि न यमो न च यक्षराट् ।\nवरुणोऽप्यथवा वायुः कुतो वेत्स्यन्ति मानवाः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2125793, "chapter_id": 3694, "verse_number": "८९", "content_sanskrit": "न त्वया सहसा तात मोक्तव्यं पुरुषे क्वचित् ।\nजगद्विनिर्दहेत् सर्वमल्पतेजसि पातितम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2125794, "chapter_id": 3694, "verse_number": "९०", "content_sanskrit": "अवध्यो नाम नास्त्यस्य त्रैलोक्ये सचराचरे ।\nमनसा चक्षुषा वाचा धनुषा च निपात्यते \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2125795, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2125796, "chapter_id": 3694, "verse_number": "९१", "content_sanskrit": "तच्छ्रुत्वा सहसा पार्थः शुचिर्भूत्वा समाहितः ।\nउपसङ्गृह्य विश्वेशमधीष्वेति च सोऽब्रवीत्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2125797, "chapter_id": 3694, "verse_number": "९२", "content_sanskrit": "ततस्त्वध्यापयामास सरहस्यनिवर्तनम् ।\nतदस्त्रं पाण्डवश्रेष्ठं मूर्तिमन्तमिवान्तकम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2125798, "chapter_id": 3694, "verse_number": "९३", "content_sanskrit": "उपतस्थे महात्मानं यथा त्र्यक्षमुपापतिम् ।\nप्रतिजग्राह तत्पार्थः प्रीतिमानरिमर्दनः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2125799, "chapter_id": 3694, "verse_number": "९४", "content_sanskrit": "ततश्चचाल पृथिवी सपर्वतवनद्रुमा ।\nससागरवनोद्देशा सग्रामनगराकरा\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2125800, "chapter_id": 3694, "verse_number": "९५", "content_sanskrit": "शङ्खदुन्दुभिघोषाश्च भेरीणां च सहस्रशः ।\nतस्मिन् मुहूर्ते सम्प्राप्ते निर्घातश्च महानभूत्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2125801, "chapter_id": 3694, "verse_number": "९६", "content_sanskrit": "अथास्त्रं जाज्वलद्घोरं पाण्डवस्यामितौजसः ।\nमूर्तिमद् विष्ठितं पार्श्वे ददृशुर्देवदानवाः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2125802, "chapter_id": 3694, "verse_number": "९७", "content_sanskrit": "स्पृष्टस्य च त्र्यम्बकेण फल्गुनस्यामितौजसः ।\nयत् किञ्चिदशुभं देहे तत् सर्वं नाशमेयिवान् \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2125803, "chapter_id": 3694, "verse_number": "९८", "content_sanskrit": "स्वर्गं गच्छेत्यनुज्ञातः त्र्यम्बकेण महात्मना ।\nप्रणम्य शिरसा राजन् प्राञ्जलिर्हरमैक्षत\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2125804, "chapter_id": 3694, "verse_number": "९९", "content_sanskrit": "ततः प्रभुस्त्रिदिवनिवासिनं वशी\nमहामतिर्गिरिश उमापतिः शिवः ।\nधनुर्महद् दितिजपिशाचसूदनं\nददौ भवः पुरुषवराय गाण्डिवम्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2125805, "chapter_id": 3694, "verse_number": "१००", "content_sanskrit": "ततः शुभं गिरिवरमीश्वरस्तदा\nसहोमया सिततटसानुकन्दरम् ।\nविहाय तं पतगमहर्षिसेवितं\nजगाम खं पुरुषवरस्य पश्यतः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2125806, "chapter_id": 3694, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि षट्त्रिंशोऽध्यायः ॥३६॥\n॥ कैरातपर्वणि षड्विंशोऽध्यायः ॥२६॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}]