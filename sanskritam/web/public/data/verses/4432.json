[{"id": 2158478, "chapter_id": 4432, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158479, "chapter_id": 4432, "verse_number": "१", "content_sanskrit": "तथा प्रमथमानं तं महेष्वासमजिह्मगैः ।\nआर्जुनिं मामकाः सङ्खे के तत्र समवारयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158480, "chapter_id": 4432, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158481, "chapter_id": 4432, "verse_number": "२", "content_sanskrit": "शृणु राजन् कुमारस्य रणे विक्रीडितं महत् ।\nबिभित्सतो रथानीकं भारद्वाजेन रक्षितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158482, "chapter_id": 4432, "verse_number": "३", "content_sanskrit": "मद्रेशं सादितं दृष्ट्वा सौभद्रेणाशुगैः शरैः ।\nशल्यादवरजः क्रुद्धः किरन् बाणान् समभ्ययात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158483, "chapter_id": 4432, "verse_number": "४", "content_sanskrit": "आर्जुनिं दशभिर्विद्ध्वा साश्वयन्तारमाशुगैः ।\nउदक्रोशन्महाशब्दं तिष्ठ तिष्ठेति चाब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158484, "chapter_id": 4432, "verse_number": "५", "content_sanskrit": "तस्यार्जुनिः शिरोग्रीवं पाणिपादं धनुर्हयान् ।\nछत्रं ध्वजं नियन्तारं त्रिवेणुं शम्युपस्करम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158485, "chapter_id": 4432, "verse_number": "६", "content_sanskrit": "चक्रे युगेषां तूणीरान् अनुकर्षं च सायकैः ।\nपताकां चक्रगोप्तारौ सर्वोपकरणानि च\nव्यधमल्लाघवात् तस्य ददृशे नात्र कश्चन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158486, "chapter_id": 4432, "verse_number": "७", "content_sanskrit": "स पपात क्षितौ क्षीणः प्रविद्धाभरणाम्बरः ।\nवायुनेव महाचैत्यः समूलश्चोरुवेदिकः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158487, "chapter_id": 4432, "verse_number": "८", "content_sanskrit": "अनुगाश्चास्य वित्रस्ता विद्रुताः सर्वतोदिशम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158488, "chapter_id": 4432, "verse_number": "९", "content_sanskrit": "तत् तु कर्मार्जुनेर्दृष्ट्वा प्रणेदुः सर्वतोदिशम् ।\nनादेन सर्वभूतानि साधु साध्विति भारत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158489, "chapter_id": 4432, "verse_number": "१०", "content_sanskrit": "शल्यभ्रातर्यथारुग्णे हताश्वास्तव सैनिकाः ।\nकुलाधिवासनामानि श्रावयन्तोऽर्जुनात्मजम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158490, "chapter_id": 4432, "verse_number": "११", "content_sanskrit": "अभ्यद्रवन् सुसङ्क्रुद्धा विविधायुधपाणयः ।\nरथैरश्वैर्गजैरन्यैः पादाताश्च मदोत्कटाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158491, "chapter_id": 4432, "verse_number": "१२", "content_sanskrit": "बाणशब्देन महता खुरनेमिस्वनेन च ।\nहुङ्कारैः क्ष्वेडितोत्कृष्टैः सिंहनादैः सगर्जितैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158492, "chapter_id": 4432, "verse_number": "१३", "content_sanskrit": "ज्यातळत्रस्वनैश्चैव गर्जन्तोऽर्जुननन्दनम् ।\nब्रुवाणाश्च न नो जीवन् मोक्ष्यसे जीवतामिति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158493, "chapter_id": 4432, "verse_number": "१४", "content_sanskrit": "तांस्तथा ब्रुवतो दृष्ट्वा सौभद्रः प्रहसन्निव ।\nयो योऽसौ प्रहरत् पूर्वं तं तं विव्याध पत्रिभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158494, "chapter_id": 4432, "verse_number": "१५", "content_sanskrit": "सन्दर्शयिष्यन्नस्त्राणि चित्राणि च लघूनि च ।\nआर्जुनिः समरे शूरो मृदुपूर्वमयुद्ध्यत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158495, "chapter_id": 4432, "verse_number": "१६", "content_sanskrit": "वासुदेवादुपादत्तं यदस्त्रं यद् धनञ्जयात् ।\nसर्वं सन्दर्शयत् कार्ष्णिः कृष्णाभ्यामविशेषतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158496, "chapter_id": 4432, "verse_number": "१७", "content_sanskrit": "दूरमस्य गुरुं भारं साध्वसं च पुनःपुनः ।\nसन्दधद् विसृजंश्चेषून् निर्विशेषमदृश्यत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158497, "chapter_id": 4432, "verse_number": "१८", "content_sanskrit": "चापमण्डलमेवास्य स्फुरदेव प्रकाशते ।\nतमो घ्नतः सुदीप्तस्य सवितुर्मण्डलं यथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158498, "chapter_id": 4432, "verse_number": "१९", "content_sanskrit": "ज्याशब्दः शुश्रुवे तस्य तळशब्दश्च भारत ।\nमहाशनिमुचः काले पयोदस्येव निस्वनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158499, "chapter_id": 4432, "verse_number": "२०", "content_sanskrit": "ह्रीमानमर्षी सौभद्रो मानकृत् प्रियदर्शनः ।\nसम्मिमानयिषुर्वीरान् इष्वासांश्चाप्ययुद्ध्यत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158500, "chapter_id": 4432, "verse_number": "२१", "content_sanskrit": "मृदुर्भूत्वा महाराज दारुणः समपद्यत ।\nवर्षाव्यतीतो भगवान् शरदीव दिवाकरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158501, "chapter_id": 4432, "verse_number": "२२", "content_sanskrit": "शरान् विपाठान् विशिखान् स्वर्णपुङ्खान् शिलाशितान् ।\nसहस्रशोऽमुचत् क्रुद्धो गभस्तीनिव भास्करः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158502, "chapter_id": 4432, "verse_number": "२३", "content_sanskrit": "क्षुरप्रैर्वत्सदन्तैश्च विपाठैश्च महायशाः ।\nनाराचैरर्धनाराचैर्भल्लैरञ्जलिकैरपि\nअवाकिरद् रथानीकं भारद्वाजस्य पश्यतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158503, "chapter_id": 4432, "verse_number": "२४", "content_sanskrit": "तत् सैन्यमभवत् सर्वं विमुखं शरपीडितम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158504, "chapter_id": 4432, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि सप्तत्रिंशोऽध्यायः ॥३७॥\nअभिमन्युवधपर्वणि षष्ठोऽध्यायः॥ ६॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]