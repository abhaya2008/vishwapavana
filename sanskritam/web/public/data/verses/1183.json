[{"id": 2009314, "chapter_id": 1183, "verse_number": "१-१८४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009315, "chapter_id": 1183, "verse_number": "१-१८४-१", "content_sanskrit": "वसत्सु तेषु प्रच्छन्नं पाण्डवेषु महात्मसु।\nआजगामाथ तान्द्रष्टुं व्यासः सत्यवतीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009316, "chapter_id": 1183, "verse_number": "१-१८४-२", "content_sanskrit": "तमागतमभिप्रेक्ष्य प्रत्युद्गम्य परन्तपाः।\nप्रणिपत्याभिवाद्यैनं तस्थुः प्राञ्जलयस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009317, "chapter_id": 1183, "verse_number": "१-१८४-३", "content_sanskrit": "समनुज्ञाप्य तान्सर्वानासीनान्मुनिरब्रवीत्।\nप्रच्छन्नं पूजितः पार्थैः प्रीतिपूर्वमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009318, "chapter_id": 1183, "verse_number": "१-१८४-४", "content_sanskrit": "अपि धर्मेण वर्तध्वं शास्त्रेण च परन्तपाः।\nअपि विप्रेषु पूजा वः पूजार्हेषु न हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009319, "chapter_id": 1183, "verse_number": "१-१८४-५", "content_sanskrit": "अथ धर्मार्थवद्वाक्यमुक्त्वा स भगवानृषिः।\nविचित्राश्च कथास्तास्ताः पुनरेवेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009320, "chapter_id": 1183, "verse_number": "१-१८४-६", "content_sanskrit": "आसीत्तपोवने काचिदृषेः कन्या महात्मनः।\nविलग्नमध्या सुश्रोणी सुभ्रूः सर्वगुणान्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009321, "chapter_id": 1183, "verse_number": "१-१८४-७", "content_sanskrit": "कर्मभिः स्वकृतैः सा तु दुर्भगा समपद्यत।\nनाध्यगच्छत्पतिं सा तु कन्या रूपवती सती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009322, "chapter_id": 1183, "verse_number": "१-१८४-८", "content_sanskrit": "तपस्तप्तुमथारेभे पत्यर्थमसुखा ततः।\nतोषयामास तपसा सा किलोग्रेण शङ्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009323, "chapter_id": 1183, "verse_number": "१-१८४-९", "content_sanskrit": "तस्याः स भगवांस्तुष्टस्तामुवाच यशस्विनीम्।\nवरं वरय भद्रं ते वरदोऽस्मीति शङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009324, "chapter_id": 1183, "verse_number": "१-१८४-१०", "content_sanskrit": "अथेश्वरमुवाचेदमात्मनः सा वचो हितम्।\nपतिं सर्वगुणोपेतमिच्छामीति पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009325, "chapter_id": 1183, "verse_number": "१-१८४-११", "content_sanskrit": "तामथ प्रत्युवाचेदमीशानो वदतां वरः।\nपञ्च ते पतयो भद्रे भविष्यन्तीति भारताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009326, "chapter_id": 1183, "verse_number": "१-१८४-१२", "content_sanskrit": "एवमुक्ता ततः कन्या देवं वरदमब्रवीत्।\nएकमिच्छाम्यहं देव त्वत्प्रसादात्पतिं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009327, "chapter_id": 1183, "verse_number": "१-१८४-१३", "content_sanskrit": "पुनरेवाब्रवीद्देव इदं वचनमुत्तमम्।\nपञ्चकृत्वस्त्वया ह्युक्तः पतिं देहीत्यहं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009328, "chapter_id": 1183, "verse_number": "१-१८४-१४", "content_sanskrit": "देहमन्यं गतायास्ते यथोक्तं तद्भविष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009329, "chapter_id": 1183, "verse_number": "१-१८४-१४x", "content_sanskrit": "व्यास उवाच।\nद्रुपदस्य कुले जज्ञे सा कन्या देवरूपिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009330, "chapter_id": 1183, "verse_number": "१-१८४-१५", "content_sanskrit": "निर्दिष्टा भवतां पत्नी कृष्णा पार्षत्यनिन्दिता।\nपाञ्चालनगरे तस्मान्निवसध्वं महाबलाः।\nसुखिनस्तामनुप्राप्य भविष्यथ न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009331, "chapter_id": 1183, "verse_number": "१-१८४-१६", "content_sanskrit": "एवमुक्त्वा महाभागः पाण्डवान्स पितामहः।\nपार्थानामन्त्र्य कुन्तीं च प्रातिष्ठत महातपाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009332, "chapter_id": 1183, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि चतुरशीत्यधिकशततमोऽध्यायः॥ १८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]