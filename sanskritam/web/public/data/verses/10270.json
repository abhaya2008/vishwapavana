[{"id": 6000270000, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "अथ चतुःसप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "नन्दगोपः कृष्णबलरामयोः प्रीत्या मासत्रयमवसत् समन्तपञ्चके", "range": "२६"}, {"text": "रामकृष्णानीतबालकान् देवकी", "range": null}]}, {"id": 6000270001, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.001.m4a", "display_order": 2}, {"id": 6000270002, "chapter_id": 10270, "verse_number": "१०-७४-१", "content_sanskrit": "अथैकदात्मजौ प्राप्तौ कृतपादाभिवन्दनौ।\nवसुदेवोऽभिनन्द्याह प्रीत्या सङ्कर्षणाच्युतौ॥ १०/७४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.002.m4a", "display_order": 3, "topics": [{"text": "वसुदेवकृतहरिमाहात्म्यवर्णनम्", "range": "१–२६"}]}, {"id": 6000270003, "chapter_id": 10270, "verse_number": "१०-७४-२", "content_sanskrit": "मुनीनां वदतां श्रुत्वा पुत्रयोर्धामसूचकम्।\nतद्वीर्यजातविस्रम्भः परिष्वज्याभ्यभाषत॥ १०/७४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.003.m4a", "display_order": 4}, {"id": 6000270004, "chapter_id": 10270, "verse_number": "१०-७४-३", "content_sanskrit": "कृष्ण कृष्ण महायोगिन् सङ्कर्षण सनातन।\nजाने वामस्य यत्साक्षात् प्रधानपुरुषौ परौ॥ १०/७४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.004.m4a", "display_order": 5}, {"id": 6000270005, "chapter_id": 10270, "verse_number": "१०-७४-४", "content_sanskrit": "यत्र येन यतो यस्य यस्मै यद्यद्यथा यदा।\nस्यादिदं भगवान् साक्षात् प्रधानपुरुषेश्वरः॥ १०/७४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.005.m4a", "display_order": 6}, {"id": 6000270006, "chapter_id": 10270, "verse_number": "१०-७४-५", "content_sanskrit": "एतन्नानाविधं विश्वमात्मसृष्टमधोक्षज।\nआत्मनाऽनुप्रविश्यात्मन् प्राणान् जीवो बिभर्ष्यजः॥ १०/७४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.006.m4a", "display_order": 7}, {"id": 6000270007, "chapter_id": 10270, "verse_number": "१०-७४-६", "content_sanskrit": "प्राणादीनां विश्वसृजां शक्तयो याः परस्य ताः।\nपारतन्त्र्याद्वैसादृश्याद् द्वयोः श्रेष्ठे च चेष्टितम्॥ १०/७४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.007.m4a", "display_order": 8}, {"id": 6000270008, "chapter_id": 10270, "verse_number": "१०-७४-७", "content_sanskrit": "कान्तिस्तेजः प्रभा सत्ता चन्द्राग्न्यर्कसविद्युताम्।\nयत् स्थैर्यं भूभृतां भूमेर्वृत्तिर्गन्धोऽर्थतो भवान्॥ १०/७४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.008.m4a", "display_order": 9}, {"id": 6000270009, "chapter_id": 10270, "verse_number": "१०-७४-८", "content_sanskrit": "तर्पणं प्राणनं चापां द्रवत्वं ताश्च तद्रसः।\nओजः सहो बलं चेष्टा गतिर्वायोरियत्तव॥ १०/७४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.009.m4a", "display_order": 10}, {"id": 6000270010, "chapter_id": 10270, "verse_number": "१०-७४-९", "content_sanskrit": "दिशां त्वमवकाशोऽसि शब्दस्त्वं स्फोट आश्रयः।\nनादो वर्णस्त्वमोङ्कार आकृतीनां पृथक्कृतीः॥ १०/७४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.010.m4a", "display_order": 11}, {"id": 6000270011, "chapter_id": 10270, "verse_number": "१०-७४-१०", "content_sanskrit": "इन्द्रियं त्विन्द्रियाणां त्वं देवाश्च तदनुग्रहाः।\nअवबोधो भवान् बुद्धेर्ज्जीवस्यानुस्मृतिः सती॥ १०/७४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.011.m4a", "display_order": 12}, {"id": 6000270012, "chapter_id": 10270, "verse_number": "१०-७४-११", "content_sanskrit": "भूतानामसि भूतादिरिन्द्रियाणां च तैजसम्।\nवैकारिकं विकल्पानां प्रधानमनुशायिनाम्॥ १०/७४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.012.m4a", "display_order": 13}, {"id": 6000270013, "chapter_id": 10270, "verse_number": "१०-७४-१२", "content_sanskrit": "नश्वरेष्विह भावेषु तदसि त्वमनश्वरः।\nयथा द्रव्यविकारेषु द्रव्यमात्रं निरूपितम्॥ १०/७४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.013.m4a", "display_order": 14}, {"id": 6000270014, "chapter_id": 10270, "verse_number": "१०-७४-१३", "content_sanskrit": "सत्त्वं रजस्तम इति गुणास्तद्वृत्तयश्च याः।\nत्वय्यद्धा ब्रह्मणि परे कल्पिता योगमायया॥ १०/७४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.014.m4a", "display_order": 15}, {"id": 6000270015, "chapter_id": 10270, "verse_number": "१०-७४-१४", "content_sanskrit": "तस्मान्न सन्त्यमी भावा यर्हि त्वय्यविकल्पिताः।\nत्वं चामीषु विकारेषु सन् सदा व्यावहारिकः॥ १०/७४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.015.m4a", "display_order": 16}, {"id": 6000270016, "chapter_id": 10270, "verse_number": "१०-७४-१५", "content_sanskrit": "गुणप्रवाह एतस्मिन्नबुद्ध्वा त्वखिलात्मनः।\nगतिं सूक्ष्मामबोधेन संसरन्तीह कर्मभिः॥ १०/७४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.016.m4a", "display_order": 17}, {"id": 6000270017, "chapter_id": 10270, "verse_number": "१०-७४-१६", "content_sanskrit": "यदृच्छया नृतां प्राप्य सुकल्पामिह दुर्लभम्।\nस्वार्थे प्रमत्तस्य वयो गतं त्वन्माययेश्वर॥ १०/७४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.017.m4a", "display_order": 18}, {"id": 6000270018, "chapter_id": 10270, "verse_number": "१०-७४-१७", "content_sanskrit": "असावहं ममैवैते देहे चास्यान्वयादिषु।\nस्नेहपाशैर्निबध्नाति भवान् सर्वमिदं जगत्॥ १०/७४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.018.m4a", "display_order": 19}, {"id": 6000270019, "chapter_id": 10270, "verse_number": "१०-७४-१८", "content_sanskrit": "युवां न नः सुतौ साक्षात् प्रधानपुरुषेश्वरौ।\nभूभारदैत्यक्षपणे अवतीर्णौ तथान्विह॥ १०/७४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.019.m4a", "display_order": 20}, {"id": 6000270020, "chapter_id": 10270, "verse_number": "१०-७४-१९", "content_sanskrit": "तत् ते गतोऽस्म्यरणमद्य पदारविन्दमापन्नसंसृतिभयापहमार्तबन्धो।\nएतावताऽलमलमिन्द्रियलालसेन मर्त्यात्मदृक् त्वयि परे यदपत्यबुद्धिः॥ १०/७४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.020.m4a", "display_order": 21}, {"id": 6000270021, "chapter_id": 10270, "verse_number": "१०-७४-२०", "content_sanskrit": "सूतीगृहे ननु जगाद भवानजो नौ यद् यज्ञ इत्यनुयुगं निजधर्मगुप्त्यै।\nनानातनूर्गगनवद् विदधज्जहासि को वेद भूम्न उरुगाय विभूतिमायाम्॥ १०/७४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.021.m4a", "display_order": 22}, {"id": 6000270022, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.022.m4a", "display_order": 23}, {"id": 6000270023, "chapter_id": 10270, "verse_number": "१०-७४-२१", "content_sanskrit": "आकर्ण्येत्थं पितुर्वाक्यं भगवान् सात्त्वतर्षभः।\nप्रत्याह प्रश्रयानम्रः प्रहसन् श्लक्ष्णया गिरा॥ १०/७४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.023.m4a", "display_order": 24}, {"id": 6000270024, "chapter_id": 10270, "verse_number": "१०-७४-२२", "content_sanskrit": "वचो वः समवेतार्थं तातैतदुपमन्महे।\nयन्नः पुत्रान् समुद्दिश्य तत्वग्राम उदाहृतः॥ १०/७४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.024.m4a", "display_order": 25}, {"id": 6000270025, "chapter_id": 10270, "verse_number": "१०-७४-२३", "content_sanskrit": "अहं यूयमसावार्य इमे च द्वारकौकसः।\nसर्वेऽप्येव यदुश्रेष्ठ विश्वं च सचराचरम्॥ १०/७४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.025.m4a", "display_order": 26}, {"id": 6000270026, "chapter_id": 10270, "verse_number": "१०-७४-२४", "content_sanskrit": "आत्मा ह्येकः स्वयञ्ज्योतिर्नित्योऽन्यो निर्गुणो गुणैः।\nआत्मसृष्टैस्तत्कृतेषु भूतेषु बहुधेयते॥ १०/७४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.026.m4a", "display_order": 27}, {"id": 6000270027, "chapter_id": 10270, "verse_number": "१०-७४-२५", "content_sanskrit": "खं वायुर्ज्योतिरापो भूस्तत्कृतेषु यथाशयम्।\nआविस्तारोऽल्पभूर्येकनानात्वं यात्यसावपि॥ १०/७४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.027.m4a", "display_order": 28}, {"id": 6000270028, "chapter_id": 10270, "verse_number": "१०-७४-२६", "content_sanskrit": "एवं भगवता राजन् वसुदेव उदाहृतम्।\nश्रुत्वा विनष्टनामाधिस्तूष्णीं प्रीतमना अभूत्॥ १०/७४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.028.m4a", "display_order": 29}, {"id": 6000270029, "chapter_id": 10270, "verse_number": "१०-७४-२७", "content_sanskrit": "अथ तत्र कुरुश्रेष्ठ देवकी सर्वदेवता।\nश्रुत्वाऽऽनीतं गुरोः पुत्रमात्मजाभ्यां सुविस्मिता॥ १०/७४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.029.m4a", "display_order": 30, "topics": [{"text": "मृतपुत्रान् द्रष्टुकामा देवकी कृष्णं प्रार्थितवती", "range": "२७"}]}, {"id": 6000270030, "chapter_id": 10270, "verse_number": "१०-७४-२८", "content_sanskrit": "कृष्णरामौ समाश्राव्य पुत्रान् कंसविहिंसितान्।\nस्मरन्ती कृपणा प्राह वैक्लव्यादश्रुलोचना॥ १०/७४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.030.m4a", "display_order": 31, "topics": [{"text": "रामकृष्णौ सुतललोकं प्रविविशतुः", "range": "२८–३४"}]}, {"id": 6000270031, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "देवक्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.031.m4a", "display_order": 32}, {"id": 6000270032, "chapter_id": 10270, "verse_number": "१०-७४-२९", "content_sanskrit": "राम रामाप्रमेयात्मन् कृष्ण योगेश्वरेश्वर।\nवेदाहं वां विश्वसृजामीश्वरावादिपूरुषौ॥ १०/७४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.032.m4a", "display_order": 33}, {"id": 6000270033, "chapter_id": 10270, "verse_number": "१०-७४-३०", "content_sanskrit": "कालविध्वस्तसेतूनां राज्ञामुच्छास्‍त्रवर्तिनाम्।\nभूमेर्भारायमाणानामवतीर्णो क्षयाय मे॥ १०/७४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.033.m4a", "display_order": 34}, {"id": 6000270034, "chapter_id": 10270, "verse_number": "१०-७४-३१", "content_sanskrit": "यस्यांशांशभागेन विश्वस्थित्युदयौ लयः।\nभवन्ति किल विश्वात्मंस्तं त्वाऽद्याहं गतिं गता॥ १०/७४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.034.m4a", "display_order": 35}, {"id": 6000270035, "chapter_id": 10270, "verse_number": "१०-७४-३२", "content_sanskrit": "चिरान्मृतसुतादाने गुरुणा किल चोदितौ।\nआनिन्यथुः पितृस्थानाद् गुरवे गुरुदक्षिणाम्॥ १०/७४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.035.m4a", "display_order": 36}, {"id": 6000270036, "chapter_id": 10270, "verse_number": "१०-७४-३३", "content_sanskrit": "तथा मे कुरुतां कामं युवां योगेश्वरेश्वरौ।\nभोजराजहतान् पुत्रान् कामये द्रष्टुमाहृतान्॥ १०/७४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.036.m4a", "display_order": 37}, {"id": 6000270037, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.037.m4a", "display_order": 38}, {"id": 6000270038, "chapter_id": 10270, "verse_number": "१०-७४-३४", "content_sanskrit": "एवं सञ्चोदितौ मात्रा रामकृष्णौ कुरूद्वह।\nसुतलं संविविशतुर्योगमायामुपाश्रितौ॥ १०/७४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.038.m4a", "display_order": 39}, {"id": 6000270039, "chapter_id": 10270, "verse_number": "१०-७४-३५", "content_sanskrit": "तस्मिन् प्रविष्टावुपलभ्य दैत्यराड् विश्वात्मदैवं सुतरां तथाऽऽत्मनः।\nतद्दर्शनाह्लादपरिप्लुताशयः सद्यः समुत्थाय ननाम सान्वयः॥ १०/७४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.039.m4a", "display_order": 40, "topics": [{"text": "सुतललोकबलिकृतविष्णुमाहात्म्यवर्णनम्", "range": "३५–४६"}]}, {"id": 6000270040, "chapter_id": 10270, "verse_number": "१०-७४-३६", "content_sanskrit": "तयोः समानीय वरासने मुदा निविष्टयोस्तत्र महात्मनोस्तयोः।\nदधार पादाववनिज्य तज्जलं सवृन्द आब्रह्म पुनद् यदम्बुभिः॥ १०/७४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.040.m4a", "display_order": 41}, {"id": 6000270041, "chapter_id": 10270, "verse_number": "१०-७४-३७", "content_sanskrit": "समर्हयामास महाविभूतिभिर्महार्हवस्‍त्राभरणानुलेपनैः।\nस्रग्धूपदीपामृतभक्षणादिभिः स्वगोत्रवित्तात्मसमर्पणेन च॥ १०/७४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.041.m4a", "display_order": 42}, {"id": 6000270042, "chapter_id": 10270, "verse_number": "१०-७४-३८", "content_sanskrit": "स इन्द्रसेनो भगवत्पदाम्बुजं भ्रमन् मुहुः प्रेमविभिन्नया धिया।\nबभाष हानन्दजलाकुलेक्षणः प्रहृष्टरोमा नृप गद्गदाक्षरम्॥ १०/७४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.042.m4a", "display_order": 43}, {"id": 6000270043, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "बलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.043.m4a", "display_order": 44}, {"id": 6000270044, "chapter_id": 10270, "verse_number": "१०-७४-३९", "content_sanskrit": "नमोऽनन्ताय महते नमः कृष्णाय वेधसे।\nसाङ्ख्ययोगवितानाय ब्रह्मणे परमात्मने॥ १०/७४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.044.m4a", "display_order": 45}, {"id": 6000270045, "chapter_id": 10270, "verse_number": "१०-७४-४०", "content_sanskrit": "दर्शनं वां हि भूतानां दुष्प्रापमतिदुर्लभम्।\nरजस्तमःस्वभावानां यन्नः प्राप्तं यदृच्छया॥ १०/७४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.045.m4a", "display_order": 46}, {"id": 6000270046, "chapter_id": 10270, "verse_number": "१०-७४-४१", "content_sanskrit": "दैत्यदानवगन्धर्वसिद्धविद्याधरादयः।\nयक्षरक्षःपिशाचाश्च भूतप्रमथनायकाः॥ १०/७४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.046.m4a", "display_order": 47}, {"id": 6000270047, "chapter_id": 10270, "verse_number": "१०-७४-४२", "content_sanskrit": "विशुद्धसत्त्वधाम्न्यद्धा त्वयि शास्‍त्रशरीरिणि।\nनित्यं निबद्धवैरास्ते वयं चान्ये च तादृशाः॥ १०/७४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.047.m4a", "display_order": 48}, {"id": 6000270048, "chapter_id": 10270, "verse_number": "१०-७४-४३", "content_sanskrit": "केेचनोद्बद्धवैरेण भक्ताः केचन कामतः।\nन तथा सत्त्वसंरब्धाः सन्निकृष्टाः सुरादयः॥ १०/७४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.048.m4a", "display_order": 49}, {"id": 6000270049, "chapter_id": 10270, "verse_number": "१०-७४-४४", "content_sanskrit": "इदमित्थमिति प्रायस्तव योगेश्वरेश्वर।\nन विदन्त्यपि योगेशा योगमायां कुतो वयम्॥ १०/७४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.049.m4a", "display_order": 50}, {"id": 6000270050, "chapter_id": 10270, "verse_number": "१०-७४-४५", "content_sanskrit": "तन्नः प्रसीद निरपेक्षविमृग्ययुष्मत्पादारविन्दधिषणः स्वगृहान्धकूपात्।\nनिष्क्रम्य विश्वशरणाङ्घ्र्युपलब्धवृत्तिः शान्तो यथैक उत सत्त्वसखैश्चरामि॥ १०/७४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.050.m4a", "display_order": 51}, {"id": 6000270051, "chapter_id": 10270, "verse_number": "१०-७४-४६", "content_sanskrit": "शाध्यस्मानीशितव्येश निष्कामान् कुरु नः प्रभो।\nपुमान् यच्छ्रद्धयातिष्ठंश्चोदनाया विमुच्यते॥ १०/७४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.051.m4a", "display_order": 52}, {"id": 6000270052, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.052.m4a", "display_order": 53}, {"id": 6000270053, "chapter_id": 10270, "verse_number": "१०-७४-४७", "content_sanskrit": "आसन् मरीचेः षट् पुत्रा ऊर्णायां प्रथमेऽन्तरे।\nदेवलं जहसुर्वीक्ष्य सुताञ्छपितुमुद्यतम्॥ १०/७४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.053.m4a", "display_order": 54, "topics": [{"text": "अङ्कमारोप्य अजिघ्रत्", "range": "४७–५४"}]}, {"id": 6000270054, "chapter_id": 10270, "verse_number": "१०-७४-४८", "content_sanskrit": "तेनासुरीमगुर्योनिममुनाऽवद्यकर्मणा।\nहिरण्यकशिपोः शापात् पुत्रास्ते योगमायया॥ १०/७४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.054.m4a", "display_order": 55}, {"id": 6000270055, "chapter_id": 10270, "verse_number": "१०-७४-४९", "content_sanskrit": "देवक्या जठरे जाता राजन् कंसविहिंसिताः।\nसा तान् शोचत्यात्मजान् स्वांस्त इमेऽध्यासतेऽन्तिके॥ १०/७४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.055.m4a", "display_order": 56}, {"id": 6000270056, "chapter_id": 10270, "verse_number": "१०-७४-५०", "content_sanskrit": "इत एतान् प्रणेष्यामो मातृशोकापनुत्तये।\nततः शापविनिर्मुक्ता लोकं यास्यन्ति विज्वराः॥ १०/७४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.056.m4a", "display_order": 57}, {"id": 6000270057, "chapter_id": 10270, "verse_number": "१०-७४-५१", "content_sanskrit": "स्मरोद्गीथः परिष्वङ्गः पतङ्गः क्षुद्रभृद् घृणी।\nषडिमे मत्प्रसादेन पुनर्यास्यन्ति मद्गतिम्॥ १०/७४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.057.m4a", "display_order": 58}, {"id": 6000270058, "chapter_id": 10270, "verse_number": "१०-७४-५२", "content_sanskrit": "इत्युक्त्वा तान् समादाय इन्द्रसेनेन पूजितौ।\nपुनर्द्वारावतीमेत्य मातुः पुत्रानयच्छताम्॥ १०/७४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.058.m4a", "display_order": 59}, {"id": 6000270059, "chapter_id": 10270, "verse_number": "१०-७४-५३", "content_sanskrit": "तान् दृष्ट्वा बालकान् देवी पुत्रस्नेहस्रुतस्तनी।\nपरिष्वज्याङ्कमारोप्य मूर्ध्न्यजिघ्रदभीक्ष्णशः॥ १०/७४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.059.m4a", "display_order": 60}, {"id": 6000270060, "chapter_id": 10270, "verse_number": "१०-७४-५४", "content_sanskrit": "अपाययत् स्तनं प्रीता सुतस्पर्शपरिस्रुतम्।\nमोहिता मायया विष्णोर्यया सृष्टिः प्रवर्तते॥ १०/७४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.060.m4a", "display_order": 61}, {"id": 6000270061, "chapter_id": 10270, "verse_number": "१०-७४-५५", "content_sanskrit": "पीत्वाऽमृतं पयस्तस्या पीतशेषं गदाभृतः।\nनारायणाङ्गसंस्पर्शप्रतिलब्धात्मदर्शनाः॥ १०/७४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.061.m4a", "display_order": 62}, {"id": 6000270062, "chapter_id": 10270, "verse_number": "१०-७४-५६", "content_sanskrit": "ते नमस्कृत्य गोविन्दं देवकीं पितरं बलम्।\nमिषतां सर्वभूतानां ययुर्धाम विहायसा॥ १०/७४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.062.m4a", "display_order": 63}, {"id": 6000270063, "chapter_id": 10270, "verse_number": "१०-७४-५७", "content_sanskrit": "तं दृष्ट्वा देवकी देवी मृतागमननिर्गमम्।\nमेने सुविस्मिता मायां कृष्णसंसूचितां नृप॥ १०/७४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.063.m4a", "display_order": 64}, {"id": 6000270064, "chapter_id": 10270, "verse_number": "१०-७४-५८", "content_sanskrit": "एवंविधान्यद्भुतानि कृष्णस्य परमात्मनः।\nवीर्याण्यनन्तवीर्यस्य सन्त्यनन्तानि भारत॥ १०/७४/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.064.m4a", "display_order": 65}, {"id": 6000270065, "chapter_id": 10270, "verse_number": "१०-७४-५९", "content_sanskrit": "य इदमनुशृृणोति श्रावयेद्वा मुरारेश्चरितममृतकीर्तेर्वर्णितं व्यासपुत्रैः।\nजगदघभिदलं तद्भक्तसत्कर्णपूरं भगवति कृतचित्तो याति तत्क्षेमधाम॥ १०/७४/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_074/BhP_10.074.065.m4a", "display_order": 66}, {"id": 6000270066, "chapter_id": 10270, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे चतुःसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]