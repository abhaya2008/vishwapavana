[{"id": 2116889, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116890, "chapter_id": 3517, "verse_number": "१", "content_sanskrit": "मा भूद् राजंस्तव तापो मनस्स्थः\nपञ्चानां भार्या दुहिता ममेति ।\nमातुरेषा पार्थिव प्रार्थिता स्यात्\nपञ्चानां भार्या दुहिता ममेति \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116891, "chapter_id": 3517, "verse_number": "२", "content_sanskrit": "याजोपयाजौ धर्मघृणी तपोभ्यां\nतौ चक्रतुः पञ्चपतित्वमस्याः ।\nसा धर्मतः पाण्डुसुतैरवाप्ता\nभार्या कृष्णा मोदतां वै कुलं ते \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116892, "chapter_id": 3517, "verse_number": "३", "content_sanskrit": "लोके नान्यो नाथवांस्त्वद्विशिष्टः\nसर्वारीणामप्रधृष्योऽसि राजन् ।\nभूयस्तु मे शृण्विदं त्वं विशोको\nयथागमं पञ्चपतित्वमस्याः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116893, "chapter_id": 3517, "verse_number": "४", "content_sanskrit": "एषा नाळायनी पूर्वं मौद्गल्यं स्थविरं पतिम् ।\nआराधयामास तदा कुष्ठिनं तमनिन्दिता \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116894, "chapter_id": 3517, "verse_number": "५", "content_sanskrit": "त्वगस्थिभूतं कटुकं लोलमीर्ष्युं सुकोपनम् ।\nसुगन्धेतरगन्धाढ्यं वलीपलितधारिणम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116895, "chapter_id": 3517, "verse_number": "६", "content_sanskrit": "स्थविरं विकृताकारं शीर्यमाणनखत्वचम् ।\nउच्छिष्टमुपभुञ्जाना पर्युपास्ते महाव्रता \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116896, "chapter_id": 3517, "verse_number": "७", "content_sanskrit": "ततः कदाचिदङ्गुष्ठो भुञ्जानस्य व्यशीर्यत ।\nअन्नादुद्धृत्य तच्चान्नमुपभुङ्क्तेऽविशङ्किता \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116897, "chapter_id": 3517, "verse_number": "८", "content_sanskrit": "तेन तस्याः प्रसन्नेन कामव्याहारिणा तदा ।\nवरं वृणीष्वेत्यसकृदुक्ता वव्रे वरं तदा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116898, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "मौद्गल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116899, "chapter_id": 3517, "verse_number": "९", "content_sanskrit": "नास्मि वृद्धो न कटुको नेर्ष्युर्नैवातिकोपनः ।\nन च दुर्गन्धवदनो न कृशो न च लोलुपः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116900, "chapter_id": 3517, "verse_number": "१०", "content_sanskrit": "कथं त्वां रमयामीह कथं त्वां वासयाम्यहम् ।\nवद कल्याणि भद्रं ते यथा त्वं मनसेच्छसि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116901, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116902, "chapter_id": 3517, "verse_number": "११", "content_sanskrit": "तदा साऽक्लिष्टकर्माणं वरदं सर्वकामदम् ।\nभर्तारमनवद्याङ्गी प्रसन्नं प्रत्युवाच ह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116903, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "नालायनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116904, "chapter_id": 3517, "verse_number": "१२", "content_sanskrit": "पञ्चधा मां विभक्तात्मा भगवँल्लोकविश्रुत ।\nरमय त्वमचिन्त्यात्मन् पुनश्चैकत्वमास्थितः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116905, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116906, "chapter_id": 3517, "verse_number": "१३", "content_sanskrit": "तां तथेत्यब्रवीद् धीमान् ब्रह्मर्षिर्वै महातपाः ।\nस पञ्चधा तु भूतां च रमयामास सर्वशः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116907, "chapter_id": 3517, "verse_number": "१४", "content_sanskrit": "नाळायनीं सुकेशान्तां मौद्गल्यश्चारुहासिनीम् ।\nआश्रमेष्वधिकं चापि पूज्यमानो महर्षिभिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116908, "chapter_id": 3517, "verse_number": "१५", "content_sanskrit": "विचचार यथाकामं कामरूपवपुः पुनः ।\nयदा ययौ दिवं चापि तत्र देवर्षिभिः सह \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116909, "chapter_id": 3517, "verse_number": "१६", "content_sanskrit": "स्वधामृतसमाहारः सुरलोके चचार ह ।\nपूज्यमानस्तथा शच्या शक्रस्य भवनेष्वपि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116910, "chapter_id": 3517, "verse_number": "१७", "content_sanskrit": "महेन्द्रसेनया सार्धं पर्यधावद् रिरंसया ।\nसूर्यस्य च रथं दिव्यमारुह्य भगवान् प्रभुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116911, "chapter_id": 3517, "verse_number": "१८", "content_sanskrit": "पर्युपेत्य पुनर्मेरुं मेरौ वासमरोचयत् ।\nआकाशगङ्गामाप्लुत्य तया सह तपोनिधिः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116912, "chapter_id": 3517, "verse_number": "१९", "content_sanskrit": "अंशुजालेषु चन्द्रस्य उवास च यथाऽनिलः ।\nगिरिरूपं यथा दध्रे स महर्षिस्तदा पुनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116913, "chapter_id": 3517, "verse_number": "२०", "content_sanskrit": "तत्प्रभावेन सा तस्य मध्ये जज्ञे महानदी ।\nयदा पुष्पाकुलः सालः सञ्जज्ञे मुनिसत्तमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116914, "chapter_id": 3517, "verse_number": "२१", "content_sanskrit": "लतात्वमथ सम्पेदे तमेवाभ्यनुवेष्टती ।\nपुपोष च वपुर्यद्वत् तस्य तस्यानुगं पुनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116915, "chapter_id": 3517, "verse_number": "२२", "content_sanskrit": "सा पुपोष समं भर्तुः स्कन्धेनापि चचार ह ।\nततस्तस्य च तस्याश्च तुल्या प्रीतिरवर्धत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116916, "chapter_id": 3517, "verse_number": "२३", "content_sanskrit": "यथा ह भगवांस्तस्याः प्रसादादृषिसत्तमः ।\nविजज्ञुषी च सा तत्र दैवयोगेन भामिनी \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116917, "chapter_id": 3517, "verse_number": "२४", "content_sanskrit": "स च तां तपसा देवीं दैवयोगात् तु वै द्विजः ।\nएकपत्नीं पुनर्भूत्वा सदैवाग्रे तपस्विनीम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116918, "chapter_id": 3517, "verse_number": "२५", "content_sanskrit": "अरुन्धतीव सीतेव बभूवातिपतिव्रता ।\nदमयन्त्याश्च मातुः सा विशेषमधिकं ययौ \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116919, "chapter_id": 3517, "verse_number": "२६", "content_sanskrit": "एतत्तथ्यं महाराज मा भूद् बुद्धिरतोऽन्यथा ।\nएषा नाळायनी जज्ञे दैवयोगेन केनचित् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116920, "chapter_id": 3517, "verse_number": "२७", "content_sanskrit": "राजंस्तवात्मजा कृष्णा वेद्यां तेजस्विनी शुभा ।\nतस्मिंस्तस्या मनः सक्तं न शशाक कदाचन ।\nतया प्रणिहितो ह्यात्मा तस्यास्तस्मिन् द्विजोत्तमे \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116921, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116922, "chapter_id": 3517, "verse_number": "२८", "content_sanskrit": "ब्रूहि तत्कारणं येन ब्रह्मन् जाता तपस्विनी ।\nसुता ममाध्वरे कृष्णा सर्ववेदविदां वर \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116923, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116924, "chapter_id": 3517, "verse_number": "२९", "content_sanskrit": "शृणु राजन् यथा ह्यस्या दत्तो रुद्रेण वै वरः ।\nयदर्थं चैव सम्भूता तव यज्ञे यशस्विनी \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116925, "chapter_id": 3517, "verse_number": "३०", "content_sanskrit": "हन्त ते कथयिष्यामि कृष्णायाः पौर्वदैहिकम् ।\nइन्द्रसेनेति विख्याता पुरा नाळायनी शुभा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116926, "chapter_id": 3517, "verse_number": "३१", "content_sanskrit": "मौद्गल्यं पतिमासाद्य चचार विगतज्वरा ।\nमौद्गल्यस्य महर्षेश्च रममाणस्य वै तया \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116927, "chapter_id": 3517, "verse_number": "३२", "content_sanskrit": "संवत्सरगणा राजन् व्यतीयुः क्षणवत् तदा ।\nततः कदाचिद् धर्मात्मा तृप्तो भूमेर्व्यरज्यत \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116928, "chapter_id": 3517, "verse_number": "३३", "content_sanskrit": "अन्विच्छन् स परं ब्रह्म त्यागधर्मपरोऽभवत् ।\nउत्ससर्ज स तां विप्रः सा तदा चापतद् भुवि ।\nमौद्गल्यो राजशार्दूल तपोभिर्भावितः सदा \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116929, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "नाळायनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116930, "chapter_id": 3517, "verse_number": "३४", "content_sanskrit": "प्रसीद भगवन् मह्यं न मामुत्स्रष्टुमर्हसि ।\nअवितृप्ताऽस्मि विप्रर्षे कामानां मम कामद \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2116931, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "ऋषिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2116932, "chapter_id": 3517, "verse_number": "३५", "content_sanskrit": "यस्मात् त्वं मयि निश्शङ्का ह्यवक्तव्यं प्रभाषसे ।\nआचरन्ती तपोविघ्नं तस्माच्छृणु वचो मम \t॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2116933, "chapter_id": 3517, "verse_number": "३६", "content_sanskrit": "भीवष्यसि नृलोकेऽस्मिन् राजपुत्री यशस्विनी ।\nपाञ्चालराजस्य सुता द्रुपदस्य महात्मनः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2116934, "chapter_id": 3517, "verse_number": "३७", "content_sanskrit": "भवितारस्ततस्तत्र पतयः पञ्च विश्रुताः ।\nतैः सार्धं मधुराकारैश्चिरं रतिमवाप्स्यसि \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2116935, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2116936, "chapter_id": 3517, "verse_number": "३८", "content_sanskrit": "सैवं शप्ता तु विमना वनं प्रायाद् यशस्विनी ।\nभोगैरतृप्ता देवेशं तपसाऽऽराधयत् तदा \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2116937, "chapter_id": 3517, "verse_number": "३९", "content_sanskrit": "निराशीर्मारुताहारा व्रतशीला तथैव च ।\nअनुवर्तमाना चादित्यं तथा पञ्चतपाऽभवत् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2116938, "chapter_id": 3517, "verse_number": "४०", "content_sanskrit": "तीव्रेण तपसा तस्यास्तुष्टः पशुपतिः स्वयम् ।\nवरं प्रादात् तदा रुद्रः सर्वलोकेश्वरः प्रभुः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2116939, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2116940, "chapter_id": 3517, "verse_number": "४१", "content_sanskrit": "भविष्यसि परं जन्मन् मनुष्येषु वराङ्गने ।\nभविष्यन्ति च ते भद्रे पतयः पञ्च सुव्रताः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2116941, "chapter_id": 3517, "verse_number": "४२", "content_sanskrit": "महेन्द्रवपुषः सर्वे महेन्द्रसमविक्रमाः ।\nतत्रस्था च महत्कर्म सुराणां त्वं करिष्यसि \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2116942, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "नाळायनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2116943, "chapter_id": 3517, "verse_number": "४३", "content_sanskrit": "एकः खलु मया भर्ता वृतः पञ्च त्विमे कथम् ।\nभविष्यन्ति ममैकस्याः पतयस्तद् ब्रवीहि मे \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2116944, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2116945, "chapter_id": 3517, "verse_number": "४४", "content_sanskrit": "पञ्चकृत्वस्त्वया ह्युक्तः पतिं देहीत्यहं पुनः ।\nपञ्च ते पतयो भद्रे भविष्यन्ति सुखावहाः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2116946, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "नाळायनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2116947, "chapter_id": 3517, "verse_number": "४५", "content_sanskrit": "धर्म एकः पतिः स्त्रीणां पूर्वमेव प्रकल्पितः ।\nबहुपत्नीकृतः पुंसो धर्मश्च पितृभिः कृतः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2116948, "chapter_id": 3517, "verse_number": "४६", "content_sanskrit": "स्त्रीधर्मः पूर्वमेवायं निर्मितो मुनिभिः पुरा ।\nस ह धर्मभृतां भर्तुरेका एकस्य चोच्यते \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2116949, "chapter_id": 3517, "verse_number": "४७", "content_sanskrit": "एको भर्ता हि नारीणां कौमार इति लौकिकः ।\nआपत्सु च वियोगे च सन्तानार्थे परः स्मृतः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2116950, "chapter_id": 3517, "verse_number": "४८", "content_sanskrit": "गच्छेत या तृतीयं तु तस्या निष्कृतिरुच्यते ।\nचतुर्थे पतिता धर्मात् पञ्चमे बन्धकी भवेत् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2116951, "chapter_id": 3517, "verse_number": "४९", "content_sanskrit": "एवं गते धर्मपथे न वृणे बहुपुंस्कताम् ।\nअलोकाचरितात् तस्मात् कथं मुच्येय सङ्करात् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2116952, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2116953, "chapter_id": 3517, "verse_number": "५०", "content_sanskrit": "अनावृताः पुरा नार्यो ह्यासन् शुध्यन्ति चार्तवे ।\nसकृदुक्तं त्वया नैतन्नाधर्मस्ते भविष्यति \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2116954, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "नाळायनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2116955, "chapter_id": 3517, "verse_number": "५१", "content_sanskrit": "यदि मे पतयः पञ्च वरानिच्छामि तैर्मिथः ।\nकौमारं च भवेत् सर्वैः सङ्गमेसङ्गमे च मे \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2116956, "chapter_id": 3517, "verse_number": "५२", "content_sanskrit": "पतिशुश्रूषया चैव सिद्धिः प्राप्ता मया पुरा ।\nभोगेच्छा च मया प्राप्ता स च भोगश्च मे भवेत् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2116957, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2116958, "chapter_id": 3517, "verse_number": "५३", "content_sanskrit": "रतिश्च भद्रे सिद्धिश्च न भजेते परस्परम् ।\nदुर्भगा लप्स्यसे सिद्धिं योगेन च महत्त्वताम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2116959, "chapter_id": 3517, "verse_number": "५४", "content_sanskrit": "अन्यदेहान्तरे त्वं च रूपभाग्यगुणान्विता ।\nपञ्चभिः प्राप्य कौमारं महाभागा भविष्यसि \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2116960, "chapter_id": 3517, "verse_number": "५५", "content_sanskrit": "गच्छ गङ्गाजलस्था च नरं पश्यसि यं शुभे ।\nतमानय ममाभ्याशं सुरराजं शुचिस्मिते \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2116961, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2116962, "chapter_id": 3517, "verse_number": "५६", "content_sanskrit": "इत्युक्ता विश्वरूपेण रुद्रं कृत्वा प्रदक्षिणम् ।\nजगाम गङ्गामुद्दिश्य पुण्यां त्रिपथगां नदीम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2116963, "chapter_id": 3517, "verse_number": "१९७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषण्णवत्यधिकशततमोऽध्यायः ॥१९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2116964, "chapter_id": 3517, "verse_number": "५", "content_sanskrit": "॥ इति वैवाहिकपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2116965, "chapter_id": 3517, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]