[{"id": 5000235000, "chapter_id": 9235, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000235001, "chapter_id": 9235, "verse_number": "३-३९-१", "content_sanskrit": "एवमस्मि तदा मुक्तः कथंचित् तेन संयुगे।\nइदानीमपि यद् वृत्तं तच्छृणुष्व यदुत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000235002, "chapter_id": 9235, "verse_number": "३-३९-२", "content_sanskrit": "राक्षसाभ्यामहं द्वाभ्यामनिर्विण्णस्तथाकृतः।\nसहितो मृगरूपाभ्यां प्रविष्टो दण्डकावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000235003, "chapter_id": 9235, "verse_number": "३-३९-३", "content_sanskrit": "दीप्तजिह्वो महादंष्ट्रस्तीक्ष्णशृङ्गो महाबलः।\nव्यचरन् दण्डकारण्यं मांसभक्षो महामृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000235004, "chapter_id": 9235, "verse_number": "३-३९-४", "content_sanskrit": "अग्निहोत्रेषु तीर्थेषु चैत्यवृक्षेषु रावण।\nअत्यन्तघोरो व्यचरंस्तापसांस्तान् प्रधर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000235005, "chapter_id": 9235, "verse_number": "३-३९-५", "content_sanskrit": "निहत्य दण्डकारण्ये तापसान् धर्मचारिणः।\nरुधिराणि पिबंस्तेषां तन्मांसानि च भक्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000235006, "chapter_id": 9235, "verse_number": "३-३९-६", "content_sanskrit": "ऋषिमांसाशनः क्रूरस्त्रासयन् वनगोचरान्।\nतदा रुधिरमत्तोऽहं व्यचरं दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000235007, "chapter_id": 9235, "verse_number": "३-३९-७", "content_sanskrit": "तदाहं दण्डकारण्ये विचरन् धर्मदूषकः।\nआसादयं तदा रामं तापसं धर्ममाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000235008, "chapter_id": 9235, "verse_number": "३-३९-८", "content_sanskrit": "वैदेहीं च महाभागां लक्ष्मणं च महारथम्।\nतापसं नियताहारं सर्वभूतहिते रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000235009, "chapter_id": 9235, "verse_number": "३-३९-९", "content_sanskrit": "सोऽहं वनगतं रामं परिभूय महाबलम्।\nतापसोऽयमिति ज्ञात्वा पूर्ववैरमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000235010, "chapter_id": 9235, "verse_number": "३-३९-१०", "content_sanskrit": "अभ्यधावं सुसंक्रुद्धस्तीक्ष्णशृङ्गो मृगाकृतिः।\nजिघांसुरकृतप्रज्ञस्तं प्रहारमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000235011, "chapter_id": 9235, "verse_number": "३-३९-११", "content_sanskrit": "तेन त्यक्तास्त्रयो बाणाः शिताः शत्रुनिबर्हणाः।\nविकृष्य सुमहच्चापं सुपर्णानिलतुल्यगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000235012, "chapter_id": 9235, "verse_number": "३-३९-१२", "content_sanskrit": "ते बाणा वज्रसंकाशाः सुघोरा रक्तभोजनाः।\nआजग्मुः सहिताः सर्वे त्रयः संनतपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000235013, "chapter_id": 9235, "verse_number": "३-३९-१३", "content_sanskrit": "पराक्रमज्ञो रामस्य शठो दृष्टभयः पुरा।\nसमुत्क्रान्तस्ततो मुक्तस्तावुभौ राक्षसौ हतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000235014, "chapter_id": 9235, "verse_number": "३-३९-१४", "content_sanskrit": "शरेण मुक्तो रामस्य कथंचित् प्राप्य जीवितम्।\nइह प्रव्राजितो युक्तस्तापसोऽहं समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000235015, "chapter_id": 9235, "verse_number": "३-३९-१५", "content_sanskrit": "वृक्षे वृक्षे हि पश्यामि चीरकृष्णाजिनाम्बरम्।\nगृहीतधनुषं रामं पाशहस्तमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000235016, "chapter_id": 9235, "verse_number": "३-३९-१६", "content_sanskrit": "अपि रामसहस्राणि भीतः पश्यामि रावण।\nरामभूतमिदं सर्वमरण्यं प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000235017, "chapter_id": 9235, "verse_number": "३-३९-१७", "content_sanskrit": "राममेव हि पश्यामि रहिते राक्षसेश्वर।\nदृष्ट्वा स्वप्नगतं राममुद‍्भ्रमामि विचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000235018, "chapter_id": 9235, "verse_number": "३-३९-१८", "content_sanskrit": "रकारादीनि नामानि रामत्रस्तस्य रावण।\nरत्नानि च रथाश्चैव वित्रासं जनयन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000235019, "chapter_id": 9235, "verse_number": "३-३९-१९", "content_sanskrit": "अहं तस्य प्रभावज्ञो न युद्धं तेन ते क्षमम्।\nबलिं वा नमुचिं वापि हन्याद्धि रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000235020, "chapter_id": 9235, "verse_number": "३-३९-२०", "content_sanskrit": "रणे रामेण युद्धस्व क्षमां वा कुरु रावण।\nन ते रामकथा कार्या यदि मां द्रष्टुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000235021, "chapter_id": 9235, "verse_number": "३-३९-२१", "content_sanskrit": "बहवः साधवो लोके युक्ता धर्ममनुष्ठिताः।\nपरेषामपराधेन विनष्टाः सपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000235022, "chapter_id": 9235, "verse_number": "३-३९-२२", "content_sanskrit": "सोऽहं परापराधेन विनशेयं निशाचर।\nकुरु यत् ते क्षमं तत्त्वमहं त्वां नानुयामि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000235023, "chapter_id": 9235, "verse_number": "३-३९-२३", "content_sanskrit": "रामश्च हि महातेजा महासत्त्वो महाबलः।\nअपि राक्षसलोकस्य भवेदन्तकरोऽपि हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000235024, "chapter_id": 9235, "verse_number": "३-३९-२४", "content_sanskrit": "यदि शूर्पणखाहेतोर्जनस्थानगतः खरः।\nअतिवृत्तो हतः पूर्वं रामेणाक्लिष्टकर्मणा।\nअत्र ब्रूहि यथातत्त्वं को रामस्य व्यतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000235025, "chapter_id": 9235, "verse_number": "३-३९-२५", "content_sanskrit": "इदं वचो बन्धुहितार्थिना मया\nयथोच्यमानं यदि नाभिपत्स्यसे।\nसबान्धवस्त्यक्ष्यसि जीवितं रणे\nहतोऽद्य रामेण शरैरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000235026, "chapter_id": 9235, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]