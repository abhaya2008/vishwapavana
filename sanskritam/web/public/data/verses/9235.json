a": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015876, "chapter_id": 9235, "verse_number": "7", "content_sanskrit": "हताविन्द्रजिताख्यातवैदेह्यारामलक्ष्मणौ । पुष्पकंतत्समारोप्यदर्शयध्वंहतौरणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015877, "chapter_id": 9235, "verse_number": "8", "content_sanskrit": "यदाश्रयादवष्टब्धामामुपतिष्ठति । सोऽस्याभर्तासहभ्रात्रानिहतोरणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015878, "chapter_id": 9235, "verse_number": "9", "content_sanskrit": "निर्विशङ्कानिरुद्विग्नानिरपेक्षाचमैथिली । मामुपस्थास्यतेसीतासर्वाभरणभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015879, "chapter_id": 9235, "verse_number": "10", "content_sanskrit": "अद्यकालवशंप्राप्तंरणेरामंसलक्ष्मणम् । अवेक्ष्यविनिवृत्तासाचान्यांगतिमपश्यती ॥ निरपेक्षाविशालाक्षीमामुपस्थास्यतेस्वयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015880, "chapter_id": 9235, "verse_number": "11", "content_sanskrit": "तस्यतद्वचनंश्रुत्वारावणस्यदुरात्मनः ॥ राक्षस्यस्तास्तथेत्युक्त्वाजग्मुर्वैयत्रपुष्पकम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015881, "chapter_id": 9235, "verse_number": "12", "content_sanskrit": "ततःपुष्पकमादायराक्षस्योरावणाज्ञया ॥ अशोकवनिकास्थांतांमैथिलींसमुपानयन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015882, "chapter_id": 9235, "verse_number": "13", "content_sanskrit": "तामादायतुराक्षस्योभर्तृशोकपराजिताम् ॥ सीतामारोपयामासुर्विमानंपुष्पकंतदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015883, "chapter_id": 9235, "verse_number": "14", "content_sanskrit": "ततःपुष्पकमारोप्यसीतांत्रिजटयासह ॥ जग्मुर्दर्शयितुंतस्यैराक्षस्योरामलक्ष्मणौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015884, "chapter_id": 9235, "verse_number": "15", "content_sanskrit": "रावणोऽकारयल्लङ्कांपताकाध्वजमालिनीम् ॥ प्राघोषयतहृष्टश्चलङ्कायांराक्षसेश्वरः । राघवोलक्ष्मणश्चैवहताविन्द्रजितारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015885, "chapter_id": 9235, "verse_number": "16", "content_sanskrit": "रावणोऽकारयल्लङ्कांपताकाध्वजमालिनीम् ॥ प्राघोषयतहृष्टश्चलङ्कायांराक्षसेश्वरः । राघवोलक्ष्मणश्चैवहताविन्द्रजितारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015886, "chapter_id": 9235, "verse_number": "17", "content_sanskrit": "विमानेनापिगत्वातुसीतात्रिजटयासह । ददर्शवानराणांतुसर्वंसैन्यंनिपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015887, "chapter_id": 9235, "verse_number": "18", "content_sanskrit": "प्रहृष्टमनसश्चापिददर्शपिशिताशनान् । वानरांश्चातिदुःखार्तान्रामलक्ष्मणपार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015888, "chapter_id": 9235, "verse_number": "19", "content_sanskrit": "ततस्सीताददर्शोभौशयानौशरतल्पगौ । लक्ष्मणंचापिरामंचविसंज्ञौशरपीडितौ ॥ विध्वस्तकवचौवीरौविप्रविद्धशरासनौ । सायकैचशिन्नसर्वाङ्गौशरस्तम्बमयौक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015889, "chapter_id": 9235, "verse_number": "20", "content_sanskrit": "ततस्सीत