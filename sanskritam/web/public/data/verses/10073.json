[{"id": 6000073000, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "तत्र नारदोपदिष्टप्रकारेण ध्रुवेण भगवदाराधनम्, ध्रुवस्य मधुवनगमनम्", "range": null}]}, {"id": 6000073001, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.001.m4a", "display_order": 2}, {"id": 6000073002, "chapter_id": 10073, "verse_number": "४-९-१", "content_sanskrit": "सनकाद्या नारदश्च ऋभुर्हंसोऽरुणिर्यतिः।\nनैते गृहान् ब्रह्मसुता ह्यवसन्नूर्ध्वरेतसः॥ ४/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.002.m4a", "display_order": 3, "topics": [{"text": "स्वायंभुवमनुपुत्र्याः प्रसूत्या वंशकथनावसरे प्राप्तां सतीदेव्याः तद्भर्तुः शङ्करस्य, तत्पितुर्दक्षस्य, तद्यज्ञस्य च कथां समाप्य ब्रह्मपुत्रस्याधर्मस्य वंशकथनम्", "range": "१–६"}]}, {"id": 6000073003, "chapter_id": 10073, "verse_number": "४-९-२", "content_sanskrit": "मृषाऽधर्मस्य भार्याऽऽसीद् दम्भं मायां च शत्रुहन्।\nअसूत मिथुनं तत्तु निर्ऋतिर्जगृहेऽप्रजः॥ ४/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.003.m4a", "display_order": 4}, {"id": 6000073004, "chapter_id": 10073, "verse_number": "४-९-३", "content_sanskrit": "तयोः समभवल्लोभो निकृतिश्च महामते।\nताभ्यां क्रोधश्च हिंसा च दुरुक्तिश्च तयोः कलिः॥ ४/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.004.m4a", "display_order": 5}, {"id": 6000073005, "chapter_id": 10073, "verse_number": "४-९-४", "content_sanskrit": "दुरुक्तौ कलिराधत्त भयं मृत्युं च सत्तम।\nतयोश्च मिथुनं जज्ञे यातना निरयस्तथा॥ ४/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.005.m4a", "display_order": 6}, {"id": 6000073006, "chapter_id": 10073, "verse_number": "४-९-५", "content_sanskrit": "एते ह्यधर्मवृक्षस्य वंशाः संसृतिहेतवः।\nश्रेयस्कामो न सेवेत नितरामाश्रमोत्तमी॥ ४/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.006.m4a", "display_order": 7}, {"id": 6000073007, "chapter_id": 10073, "verse_number": "४-९-६", "content_sanskrit": "सङ्ग्रहेण मया ख्यातः अनुसर्गस्तवानघ।\nत्रिःश्रुत्वैतत् पुमान् पुण्यं विधुनोत्यात्मनो मलम्॥ ४/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.007.m4a", "display_order": 8}, {"id": 6000073008, "chapter_id": 10073, "verse_number": "४-९-७", "content_sanskrit": "अथातः कीर्तये वंशं पुण्यकीर्तेः कुरूद्वह।\nस्वायंभुवस्यापि मनोर्हरेरंशांशजन्मनः॥ ४/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.008.m4a", "display_order": 9}, {"id": 6000073009, "chapter_id": 10073, "verse_number": "४-९-८", "content_sanskrit": "प्रियव्रतोत्तानपादौ शतरूपापतेः सुतौ।\nवासुदेवस्य कलया रक्षायां जगतः स्थितौ॥ ४/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.009.m4a", "display_order": 10, "topics": [{"text": "अथ ध्रुवस्य चरित्रं कथ्यते ॥ मातुः सपत्न्या दुरुक्त्यवमानितेन ध्रुवेण तपसे वनगमनम्", "range": "८–२९"}]}, {"id": 6000073010, "chapter_id": 10073, "verse_number": "४-९-९", "content_sanskrit": "जाये उत्तानपादस्य सुनीतिः सुरुचिस्तयोः।\nसुरुचिः प्रेयसी पत्युर्नेतरा यत्सुतो ध्रुवः॥ ४/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.010.m4a", "display_order": 11}, {"id": 6000073011, "chapter_id": 10073, "verse_number": "४-९-१०", "content_sanskrit": "एकदा सुरुचेः पुत्रमङ्कमारोप्य लालयन्।\nउत्तमं नारुरुक्षन्तं ध्रुवं राजाऽभ्यनन्दत॥ ४/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.011.m4a", "display_order": 12}, {"id": 6000073012, "chapter_id": 10073, "verse_number": "४-९-११", "content_sanskrit": "तथा चिकीर्षमाणं तं सपत्न्यास्तनयं ध्रुवम्।\nसुरुचिः शृृण्वतो राज्ञः सेर्ष्यमाहातिगर्विता॥ ४/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.012.m4a", "display_order": 13}, {"id": 6000073013, "chapter_id": 10073, "verse_number": "४-९-१२", "content_sanskrit": "न वत्स नृपतेर्धिष्ण्यं भवानारोढुमर्हति।\nन गृहीतो मया यत् त्वं कुक्षावपि नृपात्मज॥ ४/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.013.m4a", "display_order": 14}, {"id": 6000073014, "chapter_id": 10073, "verse_number": "४-९-१३", "content_sanskrit": "बालोऽसि बत नात्मानमन्यस्‍त्रीगर्भसम्भृतम्।\nनूनं वेद भवान् यस्य दुर्लभेऽर्थे मनोरथः॥ ४/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.014.m4a", "display_order": 15}, {"id": 6000073015, "chapter_id": 10073, "verse_number": "४-९-१४", "content_sanskrit": "तपसाऽऽराध्य पुरुषं तस्यैवानुग्रहेण मे।\nगर्भे त्वं साधयाऽत्मानं यदीच्छसि नृपासनम्॥ ४/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.015.m4a", "display_order": 16}, {"id": 6000073016, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.016.m4a", "display_order": 17}, {"id": 6000073017, "chapter_id": 10073, "verse_number": "४-९-१५", "content_sanskrit": "मातुः सपत्न्याः सुदुरुक्तिविद्धः श्वसन् रुषा दण्डहतो यथाऽहिः।\nहित्वा मिषन्तं पितरं सन्नवाचं जगाम मातुः स रुदन् सकाशम्॥ ४/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.017.m4a", "display_order": 18}, {"id": 6000073018, "chapter_id": 10073, "verse_number": "४-९-१६", "content_sanskrit": "तं निःश्वसन्तं स्फुरिताधरोष्ठं सुनीतिरुत्सङ्गमुदूह्य बालम्।\nनिशम्य तत् पुत्रमुखान्नितान्तं सा विव्यथे यद् गदितं सपत्न्या॥ ४/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.018.m4a", "display_order": 19}, {"id": 6000073019, "chapter_id": 10073, "verse_number": "४-९-१७", "content_sanskrit": "सोत्सृज्य धैर्यं विललाप शोकदावाग्निना दावलतेव बाला।\nवाक्यं सपत्न्याः स्मरती सरोजश्रिया दृशा बाष्पकलामुवाह॥ ४/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.019.m4a", "display_order": 20}, {"id": 6000073020, "chapter_id": 10073, "verse_number": "४-९-१८", "content_sanskrit": "दीर्घं श्वसन्ती वृजिनस्य पारम् अपश्यती बालकमाह बाला।\nमाऽमङ्गलं तात परेषु मंस्था भुङ्क्ते जनो यत् परदुःखदस्तत्॥ ४/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.020.m4a", "display_order": 21}, {"id": 6000073021, "chapter_id": 10073, "verse_number": "४-९-१९", "content_sanskrit": "सत्यं सुरुच्याऽभिहितं भवान् मे यद् दुर्भगाया उदरे गृहीतः।\nस्तन्येन वृद्धश्च विलज्जते यां भार्येति वा वोढुमिडस्पतिर्माम्॥ ४/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.021.m4a", "display_order": 22}, {"id": 6000073022, "chapter_id": 10073, "verse_number": "४-९-२०", "content_sanskrit": "आतिष्ठ तत् तात विमत्सरस्त्वमुक्तं सुमात्राऽपि यदव्यलीकम्।\nआराधयाधोक्षजपादपद्मं यदीच्छसेऽध्यासनमुत्तमो यथा॥ ४/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.022.m4a", "display_order": 23}, {"id": 6000073023, "chapter_id": 10073, "verse_number": "४-९-२१", "content_sanskrit": "यत्पादपद्मं परिचर्य विश्वविभावनायात्तगुणाभिपत्तेः।\nअजोऽध्यतिष्ठत् खलु पारमेष्ठ्यं पदं जितात्मा श्वसनाभिवन्द्यम्॥ ४/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.023.m4a", "display_order": 24}, {"id": 6000073024, "chapter_id": 10073, "verse_number": "४-९-२२", "content_sanskrit": "तथा मनुर्वो भगवान् पितामहो यमेकभक्त्या पुरुदक्षिणैर्मखैः।\nइष्ट्वाऽभिपेदे दुरवापमन्यतो भौमं सुखं दिव्यमथापवर्ग्यम्॥ ४/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.024.m4a", "display_order": 25}, {"id": 6000073025, "chapter_id": 10073, "verse_number": "४-९-२३", "content_sanskrit": "तमेव वत्साश्रय भृत्यवत्सलं मुमुक्षुभिर्मृग्यपदाब्जपद्धतिम्।\nअनन्यभावे निजधर्मभाविते मनस्यवस्थाप्य भजस्व पूरुषम्॥ ४/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.025.m4a", "display_order": 26}, {"id": 6000073026, "chapter_id": 10073, "verse_number": "४-९-२४", "content_sanskrit": "नान्यं ततः पद्मपलाशलोचनाद् दुःखच्छिदं ते मृगयामि कञ्चन।\nयो मृग्यते हस्तगृहीतपद्मया श्रियेतरैरङ्ग विमृग्यमाणया॥ ४/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.026.m4a", "display_order": 27}, {"id": 6000073027, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.027.m4a", "display_order": 28}, {"id": 6000073028, "chapter_id": 10073, "verse_number": "४-९-२५", "content_sanskrit": "एवं संजल्पितं मातुराकर्ण्यार्थागमं वचः।\nसन्नियम्यात्मनाऽऽत्मानं निश्चक्राम पितुः पुरात्॥ ४/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.028.m4a", "display_order": 29}, {"id": 6000073029, "chapter_id": 10073, "verse_number": "४-९-२६", "content_sanskrit": "नारदस्तदुपाकर्ण्य ज्ञात्वा चास्य चिकीर्षितम्।\nस्पृष्ट्वा मूर्धन्यघघ्नेन पाणिना प्राह विस्मितः॥ ४/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.029.m4a", "display_order": 30}, {"id": 6000073030, "chapter_id": 10073, "verse_number": "४-९-२७", "content_sanskrit": "अहो तेजः क्षत्रियाणां मानभङ्गममृष्यताम्।\nबालोऽप्ययं हृदा धत्ते यत् समातुरसद्वचः॥ ४/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.030.m4a", "display_order": 31}, {"id": 6000073031, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.031.m4a", "display_order": 32}, {"id": 6000073032, "chapter_id": 10073, "verse_number": "४-९-२८", "content_sanskrit": "क्‍व यात्येको भवान् वत्स हित्वा स्वगृहमृद्धिमत्।\nलक्षये त्वाऽवमत्याङ्ग सन्तप्तं स्वजनोत्थया॥ ४/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.032.m4a", "display_order": 33}, {"id": 6000073033, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "ध्रुव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.033.m4a", "display_order": 34}, {"id": 6000073034, "chapter_id": 10073, "verse_number": "४-९-२९", "content_sanskrit": "किं न ते ध्यानजातेन दृष्टं वा योगराधसा।\nनोत्सहे सुरुचेर्वाचा समाधातुं मनःक्षतम्॥ ४/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.034.m4a", "display_order": 35}, {"id": 6000073035, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.035.m4a", "display_order": 36}, {"id": 6000073036, "chapter_id": 10073, "verse_number": "४-९-३०", "content_sanskrit": "नाधुनाऽप्यवमानं ते सन्मानं चापि पुत्रक।\nलक्षयामः कुमारस्य सक्तस्य क्रीडनादिषु॥ ४/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.036.m4a", "display_order": 37}, {"id": 6000073037, "chapter_id": 10073, "verse_number": "४-९-३१", "content_sanskrit": "विकल्पे विद्यमानेऽपि न ह्यसन्तोषहेतवः।\nपुंसो मोहमृते भिन्ना यल्लोका निजकर्मभिः॥ ४/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.037.m4a", "display_order": 38}, {"id": 6000073038, "chapter_id": 10073, "verse_number": "४-९-३२", "content_sanskrit": "परितुष्येत् ततस्तात तावन्मात्रेण पूरुषः।\nदैवोपसादितं यावद् वीक्ष्येश्वरगतिं बुधः॥ ४/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.038.m4a", "display_order": 39}, {"id": 6000073039, "chapter_id": 10073, "verse_number": "४-९-३३", "content_sanskrit": "अथ मात्रोपदिष्टेन योगेनावरुरुत्ससि।\nयत्प्रसादात् स वै पुंसां दुराराध्यो मतो मम॥ ४/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.039.m4a", "display_order": 40}, {"id": 6000073040, "chapter_id": 10073, "verse_number": "४-९-३४", "content_sanskrit": "मुनयः पदवीं यस्य निःसङ्गेनोरुजन्मभिः।\nन विदुर्मृगयन्तोऽपि तीव्रयोगसमाधिना॥ ४/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.040.m4a", "display_order": 41}, {"id": 6000073041, "chapter_id": 10073, "verse_number": "४-९-३५", "content_sanskrit": "अतो निवर्ततामेष निर्बन्धस्तव निष्फलः।\nयतिष्यति भवान् काले श्रेयसे समुपस्थिते॥ ४/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.041.m4a", "display_order": 42}, {"id": 6000073042, "chapter_id": 10073, "verse_number": "४-९-३६", "content_sanskrit": "यस्य यद्देवविहितं स तेन सुखदुःखयोः।\nआत्मानं तोषयन् देही तमसः पारमृच्छति॥ ४/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.042.m4a", "display_order": 43}, {"id": 6000073043, "chapter_id": 10073, "verse_number": "४-९-३७", "content_sanskrit": "गुणाधिकान्मुदं लिप्सेदनुक्रोशं गुणाधमात्।\nमैत्रीं समानादन्विच्छेन्न तापैरभिभूयते॥ ४/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.043.m4a", "display_order": 44}, {"id": 6000073044, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "ध्रुव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.044.m4a", "display_order": 45}, {"id": 6000073045, "chapter_id": 10073, "verse_number": "४-९-३८", "content_sanskrit": "सोऽयं शमो भगवता सुखदुःखहतात्मनाम्।\nदर्शितः कृपया पुंसां दुर्दर्शोऽस्मद्विधैस्तु यः॥ ४/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.045.m4a", "display_order": 46}, {"id": 6000073046, "chapter_id": 10073, "verse_number": "४-९-३९", "content_sanskrit": "अथापि मेऽविनीतस्य क्षात्रं घोरमुपेयुषः।\nसुरुच्या दुर्वचोबाणैर्न भिन्ने श्रयते हृदि॥ ४/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.046.m4a", "display_order": 47}, {"id": 6000073047, "chapter_id": 10073, "verse_number": "४-९-४०", "content_sanskrit": "पदं त्रिभुवनोत्कृष्टं जिगीषोः साधु वर्त्म मे।\nब्रूह्यस्मत्पितृभिर्ब्रह्यन्नन्यैरप्यनधिष्ठितम्॥ ४/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.047.m4a", "display_order": 48}, {"id": 6000073048, "chapter_id": 10073, "verse_number": "४-९-४१", "content_sanskrit": "नूनं भवान् भगवतो योऽङ्गजः परमेष्ठिनः।\nवितुदन्नटते वीणां हितार्थं जगतोऽर्कवत्॥ ४/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.048.m4a", "display_order": 49}, {"id": 6000073049, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.049.m4a", "display_order": 50}, {"id": 6000073050, "chapter_id": 10073, "verse_number": "४-९-४२", "content_sanskrit": "इत्युदाहृतमाकर्ण्य भगवान् नारदस्तदा।\nप्रीतः प्रत्याह तं बालं तद्वाक्यमनुकम्पया॥ ४/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.050.m4a", "display_order": 51}, {"id": 6000073051, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.051.m4a", "display_order": 52}, {"id": 6000073052, "chapter_id": 10073, "verse_number": "४-९-४३", "content_sanskrit": "जनन्याऽभिहितः पन्थाः स वै निःश्रेयसस्य ते।\nभगवान् वासुदेवस्तं भज तत्प्रवणात्मना॥ ४/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.052.m4a", "display_order": 53}, {"id": 6000073053, "chapter_id": 10073, "verse_number": "४-९-४४", "content_sanskrit": "धर्मार्थकाममोक्षाख्यं य इच्छेच्छ्रेय आत्मनः।\nएकमेव हरेस्तत्र कारणं पादसेवनम्॥ ४/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.053.m4a", "display_order": 54}, {"id": 6000073054, "chapter_id": 10073, "verse_number": "४-९-४५", "content_sanskrit": "तत् तात गच्छ भद्रं ते यमुनायास्तटं शुचि।\nपुण्यं मधुवनं यत्र सान्निध्यं नित्यदा हरेः॥ ४/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.054.m4a", "display_order": 55}, {"id": 6000073055, "chapter_id": 10073, "verse_number": "४-९-४६", "content_sanskrit": "स्नात्वाऽनुसवनं तस्मिन् कालिन्द्याः सलिले शिवे।\nकृत्वोचितानि निवसन्नात्मनः कल्पितासने॥ ४/९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.055.m4a", "display_order": 56}, {"id": 6000073056, "chapter_id": 10073, "verse_number": "४-९-४७", "content_sanskrit": "प्राणायामेन त्रिवृता प्राणेन्द्रियमनोमलम्।\nशनैर्व्युदस्याभिध्यायेन्मनसा गुरुणां गुरुम्॥ ४/९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.056.m4a", "display_order": 57}, {"id": 6000073057, "chapter_id": 10073, "verse_number": "४-९-४८", "content_sanskrit": "प्रसादाभिमुखं शश्वत्प्रसन्नवदनेक्षणम्।\nसुनासं सुभ्रुवं चारुकपोलं सुन्दरं हरिम्॥ ४/९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.057.m4a", "display_order": 58}, {"id": 6000073058, "chapter_id": 10073, "verse_number": "४-९-४९", "content_sanskrit": "तरुणं रमणीयाङ्गमरुणाब्जेक्षणाधरम्।\nप्रयताश्रयणं कृष्णं शरण्यं करुणार्णवम्॥ ४/९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.058.m4a", "display_order": 59}, {"id": 6000073059, "chapter_id": 10073, "verse_number": "४-९-५०", "content_sanskrit": "श्रीवत्साङ्कं घनश्यामं पुरुषं वनमालिनम्।\nशङ्खचक्रगदापद्मैरभिव्यक्तचतुर्भुजम्॥ ४/९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.059.m4a", "display_order": 60}, {"id": 6000073060, "chapter_id": 10073, "verse_number": "४-९-५१", "content_sanskrit": "किरीटिनं कुण्डलिनं केयूरवलयान्वितम्।\nकौस्तुभाभरणग्रीवं पीतकौशेयवाससम्॥ ४/९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.060.m4a", "display_order": 61}, {"id": 6000073061, "chapter_id": 10073, "verse_number": "४-९-५२", "content_sanskrit": "काञ्चीकलापपर्यस्तं लसत्काञ्चननूपुरम्।\nदर्शनीयतमं शान्तं मनोनयनवर्धनम्॥ ४/९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.061.m4a", "display_order": 62}, {"id": 6000073062, "chapter_id": 10073, "verse_number": "४-९-५३", "content_sanskrit": "पद्भ्यां नखमणिश्रेण्या विलसद्भ्यां समर्चताम्।\nहृत्पद्मकर्णिकाधिष्ण्यमाक्रम्यात्मन्यवस्थितम्॥ ४/९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.062.m4a", "display_order": 63}, {"id": 6000073063, "chapter_id": 10073, "verse_number": "४-९-५४", "content_sanskrit": "स्मयमानमभिध्यायेत् सानुरागावलोकनम्।\nनियमेनैकभूतेन मनसा वरदर्षभम्॥ ४/९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.063.m4a", "display_order": 64}, {"id": 6000073064, "chapter_id": 10073, "verse_number": "४-९-५५", "content_sanskrit": "एवं भगवतो रूपं सुभद्रं ध्यायतो मनः।\nनिर्वृत्या परया पूर्णं सम्पन्नं न निवर्तते॥ ४/९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.064.m4a", "display_order": 65}, {"id": 6000073065, "chapter_id": 10073, "verse_number": "४-९-५६", "content_sanskrit": "जाप्यश्च परमो गुह्यः श्रूयतां मे नृपात्मज।\nयं सप्तरात्रं प्रपठन् पुमान् पश्यति खेचरान्॥ ४/९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.065.m4a", "display_order": 66}, {"id": 6000073066, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "‘‘ओं नमो भगवते वासुदेवाय’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.066.m4a", "display_order": 67}, {"id": 6000073067, "chapter_id": 10073, "verse_number": "४-९-५७", "content_sanskrit": "मन्त्रेणानेन देवस्य कुर्याद् द्रव्यमयीं बुधः।\nसपर्यां विविधैर्द्रव्यैर्देशकालविभागवित्॥ ४/९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.067.m4a", "display_order": 68}, {"id": 6000073068, "chapter_id": 10073, "verse_number": "४-९-५८", "content_sanskrit": "सलिलैः शुचिभिर्माल्यैर्वन्यैर्मूलफलादिभिः।\nशस्ताङ्कुरैः कुशैश्चार्चेत् तुलस्या प्रियया प्रभुम्॥ ४/९/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.068.m4a", "display_order": 69}, {"id": 6000073069, "chapter_id": 10073, "verse_number": "४-९-५९", "content_sanskrit": "लब्ध्वा द्रव्यमयीमर्चां क्षित्यम्ब्वादिषु चार्चयेत्।\nआहृतात्मा मुनिः शान्तो यतवाङ्मितवन्यभुक्॥ ४/९/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.069.m4a", "display_order": 70}, {"id": 6000073070, "chapter_id": 10073, "verse_number": "४-९-६०", "content_sanskrit": "स्वेच्छावतारचरितैः चरितं निजमायया।\nकरिष्यत्युत्तमश्लोकस्तान् ध्यायेद् हृदयङ्गमान्॥ ४/९/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.070.m4a", "display_order": 71}, {"id": 6000073071, "chapter_id": 10073, "verse_number": "४-९-६१", "content_sanskrit": "परिचर्या भगवतो यावतीः पूर्वकल्पिताः।\nता मन्त्रहृदयेनैव प्रयुज्यान्मन्त्रमूर्तये॥ ४/९/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.071.m4a", "display_order": 72}, {"id": 6000073072, "chapter_id": 10073, "verse_number": "४-९-६२", "content_sanskrit": "एवं कायेन मनसा वचसा च मनोगतः।\nपरिचर्यमाणो भगवान् भक्तिमत्परिचर्यया॥ ४/९/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.072.m4a", "display_order": 73}, {"id": 6000073073, "chapter_id": 10073, "verse_number": "४-९-६३", "content_sanskrit": "पुंसाममायिनां सम्यग् भजतां भाववर्धनः।\nश्रेयो दिशत्यभिमतं यद् धर्मादिषु देहिनाम्॥ ४/९/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.073.m4a", "display_order": 74}, {"id": 6000073074, "chapter_id": 10073, "verse_number": "४-९-६४", "content_sanskrit": "विरक्तश्चेन्द्रियरतौ भक्तियोगेन भूयसा।\nतन्निरन्तरभावेन भजेताद्धा विमुक्तये॥ ४/९/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.074.m4a", "display_order": 75}, {"id": 6000073075, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.075.m4a", "display_order": 76}, {"id": 6000073076, "chapter_id": 10073, "verse_number": "४-९-६५", "content_sanskrit": "इत्युक्तस्तं परिक्रम्य प्रणम्य च नृपार्भकः।\nययौ मधुवनं पुण्यं हरेश्चरणचर्चितम्॥ ४/९/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.076.m4a", "display_order": 77}, {"id": 6000073077, "chapter_id": 10073, "verse_number": "४-९-६६", "content_sanskrit": "तपोवनं गते तस्मिन् प्रविष्टोऽन्तःपुरं मुनिः।\nअर्हितोऽर्हणया राज्ञा सुखासीन उवाच तम्॥ ४/९/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.077.m4a", "display_order": 78}, {"id": 6000073078, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.078.m4a", "display_order": 79}, {"id": 6000073079, "chapter_id": 10073, "verse_number": "४-९-६७", "content_sanskrit": "राजन् किं ध्यायसे दीर्घं मुखेन परिशुष्यता।\nकिं वा न रिष्यते कामो धर्मो वाऽर्थेन संयुतः॥ ४/९/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.079.m4a", "display_order": 80}, {"id": 6000073080, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.080.m4a", "display_order": 81}, {"id": 6000073081, "chapter_id": 10073, "verse_number": "४-९-६८", "content_sanskrit": "सुतो मे बालको ब्रह्मन् स्‍त्रैणेनाकरुणात्मना।\nनिर्वासितः पञ्चवर्षः सह मात्रा महान् कविः॥ ४/९/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.081.m4a", "display_order": 82, "topics": [{"text": "नारदेन उत्तानपादभर्त्सनम्", "range": "६८–७३"}]}, {"id": 6000073082, "chapter_id": 10073, "verse_number": "४-९-६९", "content_sanskrit": "अप्यनाथं वने ब्रह्मन् मा खादन्त्यर्भकं वृकाः।\nश्रान्तं शयानं क्षुधितं परिम्लानमुखाम्बुजम्॥ ४/९/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.082.m4a", "display_order": 83}, {"id": 6000073083, "chapter_id": 10073, "verse_number": "४-९-७०", "content_sanskrit": "अहो मे बत दौरात्म्यं स्‍त्रीजितस्योपधारय।\nयोऽङ्कं प्रेम्णाऽऽरुरुक्षन्तं नाभ्यनन्दमसत्तमः॥ ४/९/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.083.m4a", "display_order": 84}, {"id": 6000073084, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.084.m4a", "display_order": 85}, {"id": 6000073085, "chapter_id": 10073, "verse_number": "४-९-७१", "content_sanskrit": "मा मा शुचः स्वतनयं देवगुप्तं विशांपते।\nतत्प्रभावमविज्ञाय प्रावृङ्क्ते यद्यशो जगत्॥ ४/९/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.085.m4a", "display_order": 86}, {"id": 6000073086, "chapter_id": 10073, "verse_number": "४-९-७२", "content_sanskrit": "सुदुष्करं कर्म कृत्वा लोकपालैरपि प्रभुः।\nएष एष्यत्यचिरतो यशो विपुलयंस्तव॥ ४/९/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.086.m4a", "display_order": 87}, {"id": 6000073087, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.087.m4a", "display_order": 88}, {"id": 6000073088, "chapter_id": 10073, "verse_number": "४-९-७३", "content_sanskrit": "इति देवर्षिणा प्रोक्तं विस्रभ्य जगतीपतिः।\nराज्यलक्ष्मीमनादृत्य पुत्रमेवान्वचिन्तयत्॥ ४/९/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.088.m4a", "display_order": 89}, {"id": 6000073089, "chapter_id": 10073, "verse_number": "४-९-७४", "content_sanskrit": "तत्राभिषिक्तः प्रयतस्तामुपोष्य विभावरीम्।\nसमाहितः पर्यचरद् दृष्ट्याऽऽदेशेन पूरुषम्॥ ४/९/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.089.m4a", "display_order": 90, "topics": [{"text": "ध्रुवस्य तपोवर्णनम्", "range": "७४–८४"}]}, {"id": 6000073090, "chapter_id": 10073, "verse_number": "४-९-७५", "content_sanskrit": "त्रिरात्रान्ते त्रिरात्रान्ते कपित्थबदराशनः।\nआत्मवृत्त्यनुसारेण मासं निन्येऽर्चयन् हरिम्॥ ४/९/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.090.m4a", "display_order": 91}, {"id": 6000073091, "chapter_id": 10073, "verse_number": "४-९-७६", "content_sanskrit": "द्वितीयं च तथा मासं षष्ठे षष्ठेऽर्भको दिने।\nतृणपर्णादिभिः शीर्णैः कृतान्नोऽभ्यर्चयद् विभुम्॥ ४/९/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.091.m4a", "display_order": 92}, {"id": 6000073092, "chapter_id": 10073, "verse_number": "४-९-७७", "content_sanskrit": "तृतीयं चानयन्मासं नवमे नवमेऽहनि।\nअब्भक्ष उत्तमश्लोकमुपाधावत् समाधिना॥ ४/९/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.092.m4a", "display_order": 93}, {"id": 6000073093, "chapter_id": 10073, "verse_number": "४-९-७८", "content_sanskrit": "चतुर्थमपि वै मासं द्वादशे द्वादशेऽहनि।\nवायुभक्षो जितश्वासो ध्यायन् देवमपारयत्॥ ४/९/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.093.m4a", "display_order": 94}, {"id": 6000073094, "chapter_id": 10073, "verse_number": "४-९-७९", "content_sanskrit": "पञ्चमे मास्यनुप्राप्ते जितश्वासो नृपात्मजः।\nध्यायन् ब्रह्म पदैकेन तस्थौ स्थाणुरिवाचलः॥ ४/९/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.094.m4a", "display_order": 95}, {"id": 6000073095, "chapter_id": 10073, "verse_number": "४-९-८०", "content_sanskrit": "देवाश्चक्रुस्तपोविघ्नं त्रासयन्तः स्वमायया।\nसर्पेभसिंहकूष्माण्डैस्तान् नापश्यत् परं गतः॥ ४/९/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.095.m4a", "display_order": 96}, {"id": 6000073096, "chapter_id": 10073, "verse_number": "४-९-८१", "content_sanskrit": "सर्वतो मन आकृष्य हृदि भूतेन्द्रियाश्रयम्।\nध्यायन् भगवतो रूपं नाद्राक्षीत् किञ्चनापरम्॥ ४/९/८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.096.m4a", "display_order": 97}, {"id": 6000073097, "chapter_id": 10073, "verse_number": "४-९-८२", "content_sanskrit": "आधारं महदादीनां प्रधानपुरुषेश्वरम्।\nब्रह्म धारयमाणस्य त्रयो लोकाश्चकम्पिरे॥ ४/९/८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.097.m4a", "display_order": 98}, {"id": 6000073098, "chapter_id": 10073, "verse_number": "४-९-८३", "content_sanskrit": "यदैकपादेन स पार्थिवार्भकस्तस्थौ तदङ्गुष्ठनिपीडिता मही।\nननाम तत्रार्धमिभेन्द्रधिष्ठिता तरीव सव्येतरतः पदे पदे॥ ४/९/८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.098.m4a", "display_order": 99}, {"id": 6000073099, "chapter_id": 10073, "verse_number": "४-९-८४", "content_sanskrit": "तस्मिन्नभिध्यायति विश्वमात्मनो द्वारं निरुध्यासुमनन्यया धिया।\nलोका निरुच्छ्वासनिपीडिता भृशं सलोकपालाः शरणं ययुर्हरिम्॥ ४/९/८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.099.m4a", "display_order": 100}, {"id": 6000073100, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.100.m4a", "display_order": 101}, {"id": 6000073101, "chapter_id": 10073, "verse_number": "४-९-८५", "content_sanskrit": "नैवं विदामो भगवन् प्राणरोधं चराचरस्याखिलसत्त्वधाम्नः।\nविधेहि तन्नो वृजिनाद् विमोक्षं प्राप्ता वयं त्वां शरणं शरण्यम्॥ ४/९/८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.101.m4a", "display_order": 102, "topics": [{"text": "देवानां विष्णुप्रार्थनम्, विष्णुना तेषां वरदानं च", "range": "८५–८६"}]}, {"id": 6000073102, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.102.m4a", "display_order": 103}, {"id": 6000073103, "chapter_id": 10073, "verse_number": "४-९-८६", "content_sanskrit": "मा भैष्ट बालं तपसो दुरत्ययान्निवर्तयिष्ये प्रतियात स्वधाम।\nयतो हि वः प्राणनिरोध आसीदौत्तानपादिर्मयि सङ्गतात्मा॥ ४/९/८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_009/BhP_04.009.103.m4a", "display_order": 104}, {"id": 6000073104, "chapter_id": 10073, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]