[{"id": 2101467, "chapter_id": 3187, "verse_number": "१४-४३-१", "content_sanskrit": "ब्रह्मोवाच।\nमनुष्याणां तु राज्यः क्षत्रियो मध्यमो गुणः।\nकुञ्जरो वाहनानां च सिंहश्चारण्यवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101468, "chapter_id": 3187, "verse_number": "१४-४३-२", "content_sanskrit": "अविः पशूनां सर्वेषामहिस्तु बिलवासिनाम्।\nगवां गोवृषभश्चैव स्त्रीणां पुरुष एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101469, "chapter_id": 3187, "verse_number": "१४-४३-३", "content_sanskrit": "न्यग्रोधो जम्बुवृक्षश्च पिप्पलः शाल्मलिस्तथा।\nशिंशपा मेषशृङ्गश्च तथा कीचकवेणवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101470, "chapter_id": 3187, "verse_number": "१४-४३-४", "content_sanskrit": "एते द्रुमाणां राजानो गणानां मरुतस्तथा।\nहिमवान्पारियात्रश्च सह्यो विन्ध्यस्त्रिकूटवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101471, "chapter_id": 3187, "verse_number": "१४-४३-५", "content_sanskrit": "श्वेतो नीलश्च भासश्च राष्ट्रवांश्चैव पर्वतः।\nभृशस्कन्धो महेन्द्रश्च माल्यवान्पर्वतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101472, "chapter_id": 3187, "verse_number": "१४-४३-६", "content_sanskrit": "एते पर्वतराजानो गणानां मरुतस्तथा।\nसूर्यो ग्रहाणामधिपो नक्षत्राणां च चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101473, "chapter_id": 3187, "verse_number": "१४-४३-७", "content_sanskrit": "यमः पितॄणामधिपः सरितामथ सागरः।\nअंभसां वरुणो राजा मरुतामिन्द्र उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101474, "chapter_id": 3187, "verse_number": "१४-४३-८", "content_sanskrit": "अर्कोऽधिपतिरुष्णानां ज्योतिषामिन्दुरुच्यते।\nअग्निर्भूतपतिर्नित्यं ब्राह्मणानां बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101475, "chapter_id": 3187, "verse_number": "१४-४३-९", "content_sanskrit": "ओषधीनां पतिः सोमो विष्णुर्बलवतां वरः।\nत्वष्टाऽधिनां पतिः सोमो विष्णुर्बलवतां वरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101476, "chapter_id": 3187, "verse_number": "१४-४३-१०", "content_sanskrit": "दक्षिणानां तथा यज्ञो वेदानामृच एव च।\nदिशामुदीची विप्राणां सोमो राजा प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101477, "chapter_id": 3187, "verse_number": "१४-४३-११", "content_sanskrit": "कुबेरः सर्वरत्नानां देवतानां पुरंदरः।\nएष भूताधिपः सर्गः प्रजानां च प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101478, "chapter_id": 3187, "verse_number": "१४-४३-१२", "content_sanskrit": "सर्वेषामेव भूतानामहं ब्रह्ममयो महान्।\nभूतं परतरं मत्तो विष्णोर्वाऽपि न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101479, "chapter_id": 3187, "verse_number": "१४-४३-१३", "content_sanskrit": "राजाधिराजः सर्वेषां विष्णुर्ब्रह्ममयो महान्।\nईश्वरं तं विजानीमः स विभुः स प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101480, "chapter_id": 3187, "verse_number": "१४-४३-१४", "content_sanskrit": "नरकिन्नरयक्षाणां गन्धर्वोरगरक्षसाम्।\nदेवदानवनागानां सर्वेषामीश्वरो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101481, "chapter_id": 3187, "verse_number": "१४-४३-१५", "content_sanskrit": "भगदेवानुयातानां सर्वासां वामलोचना।\nमाहेश्वरी महादेवी प्रोच्यते पार्वती हि सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101482, "chapter_id": 3187, "verse_number": "१४-४३-१६", "content_sanskrit": "उमां देवीं विजानीध्वं नारीणामुत्तमां शुभाम्।\nरतीनां वसुमत्यस्तु स्त्रीणामप्सरसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101483, "chapter_id": 3187, "verse_number": "१४-४३-१७", "content_sanskrit": "धर्मिकामाश्च राजानो ब्राह्मणा धर्मसेतवः।\nतस्माद्राजा द्विजातीनां प्रयतेतेह रक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101484, "chapter_id": 3187, "verse_number": "१४-४३-१८", "content_sanskrit": "राज्ञां हि विषये येषामवसीदन्ति साधवः।\nहीनास्ते स्वगुणैः सर्वैः प्रेत्यावाङ्मार्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101485, "chapter_id": 3187, "verse_number": "१४-४३-१९", "content_sanskrit": "राज्ञां हि विषये येषां साधवः परिरक्षिताः।\nतेऽस्मिँल्लोके प्रमोदन्ते प्रेत्य चानन्दमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101486, "chapter_id": 3187, "verse_number": "१४-४३-२०", "content_sanskrit": "प्राप्नुवन्ति महात्मान इति वित्त द्विजर्षभाः।\nअत ऊर्ध्वं प्रवक्ष्यामि नियतं धर्मलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101487, "chapter_id": 3187, "verse_number": "१४-४३-२१", "content_sanskrit": "अहिंसालक्षणो धर्मो हिंसा चाधर्मलक्षणा।\nप्रकाशलक्षणा देवा मनुष्याः कर्मलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101488, "chapter_id": 3187, "verse_number": "१४-४३-२२", "content_sanskrit": "शब्दलक्षणमाकाशं वायुस्तु स्पर्शलक्षणः।\nज्योतिषां लक्षणं रूपमापश्च रसलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101489, "chapter_id": 3187, "verse_number": "१४-४३-२३", "content_sanskrit": "धारिणी सर्वभूतानां पृथिवी गन्धलक्षणा।\nस्वरव्यञ्जनसंस्कारा भारती शब्दलक्षणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101490, "chapter_id": 3187, "verse_number": "१४-४३-२४", "content_sanskrit": "मनसो लक्षणं चिन्ता तथोक्ता बुद्धिरन्वयात्।\nमनसा चिन्तितानर्थान्बुद्ध्या चेह व्यवस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101491, "chapter_id": 3187, "verse_number": "१४-४३-२५", "content_sanskrit": "बुद्धिर्हि व्यवसायेन लक्ष्यते नात्र संशयः।\nलक्षणं मनसो ध्यानमव्यक्तं साधुलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101492, "chapter_id": 3187, "verse_number": "१४-४३-२६", "content_sanskrit": "प्रवृत्तिलक्षणो योगो ज्ञानं संन्यासलक्षणम्।\nतस्माज्ज्ञानं पुरस्कृत्य संन्यसेदिह बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101493, "chapter_id": 3187, "verse_number": "१४-४३-२७", "content_sanskrit": "संन्यासी ज्ञानसंयुक्तः प्राप्नोति परमां गतिम्।\nअतीतो द्वन्द्वमभ्येति तमोमृत्युजरातिगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101494, "chapter_id": 3187, "verse_number": "१४-४३-२८", "content_sanskrit": "धर्मलक्षणसंयुक्तमुक्तं वो विधिवन्मया।\nगुणानां ग्रहणं सम्यग्वक्ष्याम्यहमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101495, "chapter_id": 3187, "verse_number": "१४-४३-२९", "content_sanskrit": "पार्तिवो यस्तु गन्धो वै घ्राणेन हि स गृह्यते।\nप्राणस्यश्च तथा वायुर्गन्धज्ञाने विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101496, "chapter_id": 3187, "verse_number": "१४-४३-३०", "content_sanskrit": "अपां धातू रसो नित्यं जिह्वया स तु गृह्यते।\nजिह्वास्थश्च तथा सोमो रसज्ञाने विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101497, "chapter_id": 3187, "verse_number": "१४-४३-३१", "content_sanskrit": "तेजसस्तु गुणो रूपं चक्षुषा तच्च गृह्यते।\nचक्षुःस्थश्च ततादित्यो रूपज्ञाने विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101498, "chapter_id": 3187, "verse_number": "१४-४३-३२", "content_sanskrit": "वायव्यस्तु सदा स्पर्शस्त्वचा प्रज्ञायते च सः।\nत्वक्स्थश्चैव सदा वायुः स्पर्सने स विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101499, "chapter_id": 3187, "verse_number": "१४-४३-३३", "content_sanskrit": "आकाशस्य गुणो घोषः श्रोत्रेण च स गृह्यते।\nश्रोत्रस्थाश्च दिशः सर्वाः शब्दज्ञाने प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101500, "chapter_id": 3187, "verse_number": "१४-४३-३४", "content_sanskrit": "मनसश्च गुणश्चिन्ता प्रज्ञया स तु गृह्यते।\nहृदिस्थश्चेतनो धातुर्मनोज्ञाने विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101501, "chapter_id": 3187, "verse_number": "१४-४३-३५", "content_sanskrit": "बुद्धिरध्यवसायेन ध्यानेन च महांस्तथा।\nनिश्चित्य ग्रहणाद्व्यक्तमव्यक्तं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101502, "chapter_id": 3187, "verse_number": "१४-४३-३६", "content_sanskrit": "अलिङ्गग्रहणो नित्यः क्षेत्रज्ञो निर्गुणात्मकः।\nतस्मादलिङ्गः क्षेत्रज्ञः केवलं ज्ञानलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101503, "chapter_id": 3187, "verse_number": "१४-४३-३७", "content_sanskrit": "अव्यक्तं क्षेत्रमुद्दिष्टं गुणानां प्रभवाप्ययम्।\nसदा पश्याम्यहं लीनं विजानामि शृणोमि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101504, "chapter_id": 3187, "verse_number": "१४-४३-३८", "content_sanskrit": "पुरुषस्तद्विजानीते तस्मात्क्षेत्रज्ञ उच्यते।\nगुणवृत्तं तथा कृत्स्नं क्षेत्रज्ञः परिपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101505, "chapter_id": 3187, "verse_number": "१४-४३-३९", "content_sanskrit": "आदिमद्यावसानं तत्सृज्यमानमचेतनम्।\nन गुणा विदुरात्मानं सृज्यमानाः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101506, "chapter_id": 3187, "verse_number": "१४-४३-४०", "content_sanskrit": "न सत्यं वेद वै कश्चित्क्षेत्रज्ञस्त्वेव विन्दति।\nगुणानां गुणभूतानां यत्परं परतो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101507, "chapter_id": 3187, "verse_number": "१४-४३-४१", "content_sanskrit": "तस्माद्गुणांश्च तत्वं च परित्यज्येह तत्ववित्।\nक्षीणदोषो गुणान्हित्वा क्षेत्रज्ञं प्रविशत्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101508, "chapter_id": 3187, "verse_number": "१४-४३-४२", "content_sanskrit": "निर्द्वन्द्वो निर्नमस्कारो निःस्वधाकार एव च।\nअचलश्चानिकेतश्च क्षेत्रज्ञः स परो विधिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101509, "chapter_id": 3187, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्रिचत्वारिंशोऽध्यायः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]