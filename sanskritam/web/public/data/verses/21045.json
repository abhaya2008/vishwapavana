[{"id": 7001045000, "chapter_id": 21045, "verse_number": "५-२७-१", "content_sanskrit": "शम्बरेण ह्टतो वीरः प्रद्यु म्रः स कथं मुने!\nशम्बरश्व महावीर्य्यः प्रद्यु म्नेन कथं हतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001045001, "chapter_id": 21045, "verse_number": "५-२७-२", "content_sanskrit": "पराशर उवाच ।\nषष्ठेऽह्नि जातमात्रन्तु प्रद्युम्र सूतिकागृहात् ।\nममैष हन्तेति मुने! ह्टतवान् कालशम्बरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001045002, "chapter_id": 21045, "verse_number": "५-२७-३", "content_sanskrit": "ह्टत्वा चिक्षेप चैवैनं ग्राहोग्र लवणार्णावे ।\nकल्लोलजनितावर्त्ते सुघोरे मकरालये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001045003, "chapter_id": 21045, "verse_number": "५-२७-४", "content_sanskrit": "पतितं तत्र चैवैको मत्स्यो जग्राह बालकम् ।\nन ममार च तस्यापि जठरेऽनलदीपितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001045004, "chapter_id": 21045, "verse_number": "५-२७-५", "content_sanskrit": "मतूस्यबन्धश्व मत्स्योऽसौ मत्स्यैरन्यैः सह द्रिज!\nघातितोऽसुरवर्य्याय शम्बराय निवेदितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001045005, "chapter_id": 21045, "verse_number": "५-२७-६", "content_sanskrit": "तस्य मायावती नाम पत्री सर्व्वगृहेश्वरी ।\nकारयामास सूदानामाधिपत्यमनिन्दिता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001045006, "chapter_id": 21045, "verse_number": "५-२७-७", "content_sanskrit": "दारिते मत्स्यजठरे सा ददर्शातिशोभनम् ।\nकुमारं मन्मथतरोर्दग्धस्य प्रथमाङ्कुरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001045007, "chapter_id": 21045, "verse_number": "५-२७-८", "content_sanskrit": "कोऽयं कथमयं मत्स्यजठरं समुपागतः ।\nइत्येवं कौतुकाविष्टां तां तन्वीं प्राह नारादः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001045008, "chapter_id": 21045, "verse_number": "५-२७-९", "content_sanskrit": "अयं समस्तजगतः सूतिसंहारकारिणा ।\nशम्बरेण ह्टतः कृष्णृ-तनयः सूतिकागृहात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001045009, "chapter_id": 21045, "verse_number": "५-२७-१०", "content_sanskrit": "क्षिप्तः समुद्र मत्स्येन निगीर्णास्ते वशं गतः ।\nनररत्रमिदं सुभ्रू विस्त्रब्धा परिपालय ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001045010, "chapter_id": 21045, "verse_number": "५-२७-११", "content_sanskrit": "नारदेनैवमुक्ता सा पालयामास तं शिशुम् ।\nबाल्यादेवातिरागेण रूपातिशयमोहिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001045011, "chapter_id": 21045, "verse_number": "५-२७-१२", "content_sanskrit": "स यदा यौवनाभोग-भूषितोऽभून्महामते!\nसाभिलाषा तदा साति बभूव गजगामिनी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001045012, "chapter_id": 21045, "verse_number": "५-२७-१३", "content_sanskrit": "मायावती ददौ तस्म मायाः सर्व्वा महामुन!\nप्रद्यु म्रायातिरागान्धा तन्नयस्तह्टदयेक्षणा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001045013, "chapter_id": 21045, "verse_number": "५-२७-१४", "content_sanskrit": "प्रसज्जन्तीन्तु तामाह स कार्ष्णिः कमलेक्षणाम् ।\nमातृभावमपाहाय किमेवं वर्त्तसेऽन्यथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001045014, "chapter_id": 21045, "verse_number": "५-२७-१५", "content_sanskrit": "सा चास्मै कथयामास न पुत्रस्त्वं ममेति वै ।\nतनयं त्वामयं विष्णोह्ट तवान् कालशम्बरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001045015, "chapter_id": 21045, "verse_number": "५-२७-१६", "content_sanskrit": "क्षिप्तः समुद्र मत्स्यस्य सम्प्राप्तो जठरान्मया ।\nसा तु रोदिति ते माता कान्ताद्याप्यतिवत्सला ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001045016, "chapter_id": 21045, "verse_number": "५-२७-१७", "content_sanskrit": "इत्युक्तः शम्बरं युद्धे प्रद्यु म्रः स समाह्वयत् ।\nक्रोधाकुलीकृतमना युयुधे च महाबलः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001045017, "chapter_id": 21045, "verse_number": "५-२७-१८", "content_sanskrit": "हत्वा सैन्यमशेषन्तु तस्य दैत्यस्य माधविः ।\nसप्त माया व्यतिक्रम्य मायां प्रयुयुजेऽशष्टमीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001045018, "chapter_id": 21045, "verse_number": "५-२७-१९", "content_sanskrit": "तया जघान तं दैत्यं मायया कालशम्बरम् ।\nउत्पत्य च तया सार्द्धमाजगाम पितुर्गृहम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001045019, "chapter_id": 21045, "verse_number": "५-२७-२०", "content_sanskrit": "अन्तः परे निपतितं मायावत्या समन्वितम् ।\nतं दृष्ट्वा कृष्णसंकल्पा बभूवुः कृष्णयोषितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001045020, "chapter_id": 21045, "verse_number": "५-२७-२१", "content_sanskrit": "रुक्मिणी चावदत् प्रेमूणा प्रम्णा साश्रुदृष्टिरनिन्दिता ।\nधन्यायाः खल्वयं पुत्रो वर्त्तते नवयौवने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001045021, "chapter_id": 21045, "verse_number": "५-२७-२२", "content_sanskrit": "अस्मिन् वयसि पुत्रो मे प्रद्यु म्रो यदि जीवति ।\nसभाग्या जननी वतूस! त्वया कापि विभूषिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001045022, "chapter_id": 21045, "verse_number": "५-२७-२३", "content_sanskrit": "अथवा यादृशः स्नेहो मम यादृगू वपुस्तव ।\nहरेरपत्यं सुव्यक्त भवान् वत्स!भविष्यति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001045023, "chapter_id": 21045, "verse_number": "५-२७-२४", "content_sanskrit": "एतिस्मिन्नन्तरे प्राप्तः सह कृष्णेन नारदः ।\nअन्तः पुरचरीं देवीं रुक्मिणीं प्राह हर्षयन् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001045024, "chapter_id": 21045, "verse_number": "५-२७-२५", "content_sanskrit": "एश ते तनयः सुभ्रु! हत्वा शम्बरमागतः ।\nह्टतो येनाभवद् बालो भवत्याः सूतिकागृहात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001045025, "chapter_id": 21045, "verse_number": "५-२७-२६", "content_sanskrit": "इयं मायावती भार्य्या तनयस्यास्य ते सती ।\nशम्बरस्य न भार्य्येयं श्रूयतामत्र कारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001045026, "chapter_id": 21045, "verse_number": "५-२७-२७", "content_sanskrit": "मन्मथे तु गते नाशं तदुद्भवपरायाणा ।\nशम्बरं मोहयामास मायारूपेण रूपिणी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001045027, "chapter_id": 21045, "verse_number": "५-२७-२८", "content_sanskrit": "व्यवायाद्यु पभोगेषु रूपं मायामयं शुभम् ।\nदर्शयामास दैत्यस्य तस्येयं मदिरेक्षणा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001045028, "chapter_id": 21045, "verse_number": "५-२७-२९", "content_sanskrit": "कामोऽवतीर्णः पुत्रस्ते तस्येयं दयिता रतिः ।\nविशङ्का नात्र कर्त्तव्या स्नुषेयं तव शोभना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001045029, "chapter_id": 21045, "verse_number": "५-२७-३०", "content_sanskrit": "ततो हर्षसमाविष्टा रुक्मिणी केशवस्तथा ।\nनगरी च समस्ता सा साधु साध्वित्यभाषत ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001045030, "chapter_id": 21045, "verse_number": "५-२७-३१", "content_sanskrit": "चिरं नष्टेन पुत्रेण संयुक्तां प्रेक्ष्य रुक्मिणीम् ।\nअवाप विस्मयं सर्व्वो द्रारवत्यां जनस्तदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]