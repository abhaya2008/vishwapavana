[{"id": 2072833, "chapter_id": 2540, "verse_number": "१२-४५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072834, "chapter_id": 2540, "verse_number": "१२-४५-१", "content_sanskrit": "किमिदं परमाश्चर्यं ध्यायस्यमितविक्रम।\nकच्चिल्लोकत्रयस्यास्य स्वस्ति लोकपरायण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072835, "chapter_id": 2540, "verse_number": "१२-४५-२", "content_sanskrit": "`इन्द्रियाणि मनश्चैव बुद्धौ संवेशितानि ते।\nचतुर्थं ध्यानमार्गं त्वमालम्ब्य पुरुषर्षभ।\nअपक्रान्तो यतो जीवस्तेन मे विस्मितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072836, "chapter_id": 2540, "verse_number": "१२-४५-३", "content_sanskrit": "निगृहीतो हि वायुस्ते पञ्चकर्मा शरीरगः।\nइन्द्रियाणि च सर्वाणि मनसि स्थापितानि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072837, "chapter_id": 2540, "verse_number": "१२-४५-४", "content_sanskrit": "वाक्च सत्वं च गोविन्द बुद्धौ संवेशितानि ते।\nसर्वे चैव गुणा देवाः क्षेत्रज्ञे ते निवेशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072838, "chapter_id": 2540, "verse_number": "१२-४५-५", "content_sanskrit": "नेङ्गन्ति तव रोमाणि स्थिरा बुद्धिस्तथा मनः।\nकाष्ठकुड्यशिलाभूतो निरीहश्चासि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072839, "chapter_id": 2540, "verse_number": "१२-४५-६", "content_sanskrit": "यथा दीपो निवातस्थो निरिङ्गो ज्वलतेऽच्युत।\nतथाऽसि भगवन्देन निश्चलो योगनिश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072840, "chapter_id": 2540, "verse_number": "१२-४५-७", "content_sanskrit": "यदि श्रोतुमिहार्हामि न रहस्यं च ते यदि।\nछिन्धि मे संशयं देव प्रपन्नायाभियाचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072841, "chapter_id": 2540, "verse_number": "१२-४५-८", "content_sanskrit": "त्वं हि कर्ता विकर्ता च त्वं क्षरश्चाक्षरश्च ह।\nअनादिनिधनो ह्याद्यस्त्वमेकः पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072842, "chapter_id": 2540, "verse_number": "१२-४५-९", "content_sanskrit": "त्वं प्रपन्नाय भक्ताय शिरसा प्रणताय च।\nध्यानस्यास्य यथातत्त्वं ब्रूहि धर्मभृतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072843, "chapter_id": 2540, "verse_number": "१२-४५-१०", "content_sanskrit": "ततः स्वगोचरे न्यस्य मनोबुद्धीन्द्रियाणि च।\nस्मितपूर्वमुवाचेदं भगवान्वासवानुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072844, "chapter_id": 2540, "verse_number": "१२-४५-११x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072845, "chapter_id": 2540, "verse_number": "१२-४५-११", "content_sanskrit": "शरतल्पगतो भीष्मः शाम्यन्निव हुताशनः।\nमां ध्याति पुरुषव्याघ्रस्ततो मे तद्गतं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072846, "chapter_id": 2540, "verse_number": "१२-४५-१२", "content_sanskrit": "यस्य ज्यातलनिर्घोषं विस्फूर्जितमिवाशनेः।\nन सहेद्देवराजोऽपि तमस्मि मनसा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072847, "chapter_id": 2540, "verse_number": "१२-४५-१३", "content_sanskrit": "येनाभिजित्य तरसा समस्तं राजमण्डलम्।\nऊढास्तिस्रः पुरा कन्यास्तमस्मि मनसा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072848, "chapter_id": 2540, "verse_number": "१२-४५-१४", "content_sanskrit": "त्रयोविंशतिरात्रं यो योधयामास भार्गवम्।\nन च रामेण निस्तीर्णस्तमस्मि मनसा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072849, "chapter_id": 2540, "verse_number": "१२-४५-१५", "content_sanskrit": "यं गङ्गा गर्भविधिना धारयामास भारतम्।\nवसिष्ठशिष्यं तं तात गतोऽस्मि मनसा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072850, "chapter_id": 2540, "verse_number": "१२-४५-१६", "content_sanskrit": "दिव्यास्राणि महातेजा यो धारयति बुद्धिमान्।\nसाङ्गांश्च चतुरो वेदांस्तमस्मि मनसा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072851, "chapter_id": 2540, "verse_number": "१२-४५-१७", "content_sanskrit": "रामस्य दयितं शिष्यं जामदग्न्यस्य पाण्डव।\nआधारं सर्व्रविद्यानां तमस्मि मनसा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072852, "chapter_id": 2540, "verse_number": "१२-४५-१८", "content_sanskrit": "`एकीकृत्येन्द्रियग्रामं मनः संयम्य मेधया।\nशरणं मामुपागच्छत्ततो मे तद्गतं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072853, "chapter_id": 2540, "verse_number": "१२-४५-१९", "content_sanskrit": "स हि भूतं भविष्यच्च भवच्च भरतर्षभ।\nवेत्ति धर्मविदां श्रेष्ठस्तमस्मि मनसा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072854, "chapter_id": 2540, "verse_number": "१२-४५-२०", "content_sanskrit": "तस्मिन्हि पुरुषव्याघ्रे शान्ते भीष्मे महात्मनि।\nभविष्यति मही पार्थ नष्टचन्द्रेव शर्वरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072855, "chapter_id": 2540, "verse_number": "१२-४५-२१", "content_sanskrit": "तद्युधिष्ठिर गाङ्गेयं भीष्मं भीमपराक्रमम्।\nअभिगम्योपसंगृह्य पृच्छ यत्ते मनोगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072856, "chapter_id": 2540, "verse_number": "१२-४५-२२", "content_sanskrit": "चातुर्विद्यं चातुर्होत्रं चातुराश्रम्यमेव च।\nराजधर्मांश्चि निखिलान्पृच्छैनं पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072857, "chapter_id": 2540, "verse_number": "१२-४५-२३", "content_sanskrit": "तस्मिन्नस्तमिते भीष्मे कौरवाणां धुंरधरे।\nज्ञानान्यल्पीभविष्यन्ति तस्मात्त्वां चोदयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072858, "chapter_id": 2540, "verse_number": "१२-४५-२४", "content_sanskrit": "तच्छ्रुत्वा वासुदेवस्य तथ्यं वचनमुत्तमम्।\nसाश्रुकण्ठः स धर्मज्ञो जनार्दनमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072859, "chapter_id": 2540, "verse_number": "१२-४५-२५", "content_sanskrit": "यद्भवानाह भीष्मस्य प्रभावं प्रति माधव।\nतथा तन्नात्र संदेहो विद्यते मम माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072860, "chapter_id": 2540, "verse_number": "१२-४५-२६", "content_sanskrit": "महाभाग्यं च भीष्मस्य प्रभावश्च महाद्युते।\nश्रुतं मया कथयतां ब्राह्मणानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072861, "chapter_id": 2540, "verse_number": "१२-४५-२७", "content_sanskrit": "भवांश्च कर्ता लोकानां यद्ब्रवीत्यरिसूदन।\nतथा तद्रनभिध्येयं वाक्यं यादवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072862, "chapter_id": 2540, "verse_number": "१२-४५-२८", "content_sanskrit": "यदि त्वनुग्रहवती बुद्धिस्ते मयि माधव।\nत्वामग्रतः पुरस्कृत्य भीष्मं यास्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072863, "chapter_id": 2540, "verse_number": "१२-४५-२९", "content_sanskrit": "आवृत्ते भगवत्यर्के स हि लोकान्गमिष्यति।\nत्वद्दर्शनं महाबाहो तस्मादर्हति कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072864, "chapter_id": 2540, "verse_number": "१२-४५-३०", "content_sanskrit": "तव ह्याद्यस्य देवस्य क्षरस्यैवाक्षरस्य च।\nदर्शनं त्वस्य लाभः स्यात्त्वं हि ब्रह्ममयो निधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072865, "chapter_id": 2540, "verse_number": "१२-४५-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072866, "chapter_id": 2540, "verse_number": "१२-४५-३१", "content_sanskrit": "श्रुत्वैवं धर्मराजस्य वचनं मधुसूदनः।\nपार्श्वस्थं सात्यकिं प्राह रथो मे युज्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072867, "chapter_id": 2540, "verse_number": "१२-४५-३२", "content_sanskrit": "सात्यकिस्त्वाशु निष्क्रम्य केशवस्य समीपतः।\nदारुकं प्राह कृष्णस्य युज्यतां रथ इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072868, "chapter_id": 2540, "verse_number": "१२-४५-३३", "content_sanskrit": "स सात्यकेराशु वचो निशम्य\nरथोत्तमं काञ्चनभूषिताङ्गम्।\nमसारगल्वर्कमयैर्विभङ्गै\nर्विभूषितं हेमनिबद्धचक्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072869, "chapter_id": 2540, "verse_number": "१२-४५-३४", "content_sanskrit": "दिवाकरांशुप्रभमाशुगामिनं\nविचित्रनानामणिभूषितान्तरम्।\nनवोदितं सूर्यमिव प्रतापिनं\nविचित्रतार्क्ष्यध्वजिनं पताकिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072870, "chapter_id": 2540, "verse_number": "१२-४५-३५", "content_sanskrit": "सुग्रीवशैब्यप्रप्नुखैर्वराश्वै\nर्मनोजवैः काञ्चनभूषिताङ्गैः।\nसंयुक्तमावेदयदच्युताय\nकृताञ्जलिर्दारुको राजसिंह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072871, "chapter_id": 2540, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि प्रञ्चचत्वारिंशोऽध्यायः॥ ४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]