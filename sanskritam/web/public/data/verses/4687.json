[{"id": 2173186, "chapter_id": 4687, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173187, "chapter_id": 4687, "verse_number": "१", "content_sanskrit": "अर्जुनो द्रौणिना विद्धो युद्धे बहुभिरायसैः ।\nतस्य चानुचरैः शूरैः त्रिगर्तानां महारथैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173188, "chapter_id": 4687, "verse_number": "२", "content_sanskrit": "द्रौणिं विव्याध समरे त्रिभिरेव शिलीमुखैः ।\nतथेतरान् महेष्वासान् द्वाभ्यां द्वाभ्यां समाच्छिनत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173189, "chapter_id": 4687, "verse_number": "३", "content_sanskrit": "भूयश्चैतान् महाबाहुः शरवर्षैरवाकिरत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173190, "chapter_id": 4687, "verse_number": "४", "content_sanskrit": "शरकण्टकिनस्ते तु तावका भरतर्षभ ।\nन जहुः समरे पार्थं वध्यमानाः शिलीमुखैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173191, "chapter_id": 4687, "verse_number": "५", "content_sanskrit": "अर्जुनं रथवंशेन द्रोणपुत्रपुरोगमाः ।\nपरिवार्य मुदा युक्ता योधयन्तश्चकाशिरे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173192, "chapter_id": 4687, "verse_number": "६", "content_sanskrit": "तैस्तु क्षिप्ताः शरा राजन् कार्तस्वरविभूषिताः ।\nअर्जुनस्य रथोपस्थं पूरयामासुरञ्जसा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173193, "chapter_id": 4687, "verse_number": "७", "content_sanskrit": "तथा कृष्णौ महेष्वासौ वृषभौ सर्वधन्विनाम् ।\nविव्यधुश्च शरैर्घोरैः प्रहृष्टा युद्धदुर्मदाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173194, "chapter_id": 4687, "verse_number": "८", "content_sanskrit": "कूबरं रथचक्राणि ईषान् योक्त्त्राणि चाभि भो ।\nयुगं चैवानुकर्षं च शरभूतमभूत् तदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173195, "chapter_id": 4687, "verse_number": "९", "content_sanskrit": "नैतादृशं दृष्टपूर्वं राजन् नैव च मे श्रुतम् ।\nयादृशं तस्य पार्थस्य तावकाः सम्प्रचक्रिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173196, "chapter_id": 4687, "verse_number": "१०", "content_sanskrit": "स रथः सर्वतो भाति रुग्मपुङ्खैः शिलाशितैः ।\nउल्काशतैः सम्प्रदीप्तं विमानमिव भूतळे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173197, "chapter_id": 4687, "verse_number": "११", "content_sanskrit": "ततोऽर्जुनो महाराज शरैः सन्नतपर्वभिः ।\nअवाकिरत् तां पृतनां मेघो वृष्ट्या यथाऽचलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173198, "chapter_id": 4687, "verse_number": "१२", "content_sanskrit": "ते वध्यमानाः समरे पार्थनामाङ्कितैः शरैः ।\nपार्थभूतममन्यन्त प्रेक्षमाणास्तथाविधम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173199, "chapter_id": 4687, "verse_number": "१३", "content_sanskrit": "ततोद्भुतशरज्वालो धनुःशब्दानिलो महान् ।\nसेनेन्धनं ददाहाशु तावकं पार्थपावकः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173200, "chapter_id": 4687, "verse_number": "१४", "content_sanskrit": "चक्राणां पततां चैव युगानां च धरातळे ।\nतूणीराणां पताकानां ध्वजानां च रथैः सह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173201, "chapter_id": 4687, "verse_number": "१५", "content_sanskrit": "ईषाणामनुकर्षाणां विवेणूनां च भारत ।\nअक्षाणामथ योक्त्त्राणां प्रतोदानां च राशयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173202, "chapter_id": 4687, "verse_number": "१६", "content_sanskrit": "शिरसां पततां चैव कुण्डलोष्णीषधारिणाम् ।\nभुजानां च महाराज सुस्कन्धानां समन्ततः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173203, "chapter_id": 4687, "verse_number": "१७", "content_sanskrit": "छत्राणां व्यजनैः सार्धं मकुटानां च राशयः ।\nसमदृश्यन्त पार्थस्य रथमार्गेषु सर्वशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173204, "chapter_id": 4687, "verse_number": "१८", "content_sanskrit": "ततः क्रुद्धस्य पार्थस्य रथमार्गे विशाम्पते ।\nअगम्यरूपा पृथिवी मांसशोणितकर्दमा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173205, "chapter_id": 4687, "verse_number": "१९", "content_sanskrit": "बभूव भरतश्रेष्ठ रुद्रस्याक्रीडनं यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173206, "chapter_id": 4687, "verse_number": "२०", "content_sanskrit": "भीरूणां त्रासजननी शूराणां हर्षवर्धनी\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173207, "chapter_id": 4687, "verse_number": "२१", "content_sanskrit": "हत्वा तु समरे पार्थः सहस्रे द्वे परन्तपः ।\nरथानां सवरूथानां विधूमोऽग्निरिव ज्वलन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173208, "chapter_id": 4687, "verse_number": "२२", "content_sanskrit": "यथा हि भगवान् वह्निः जगद्दग्ध्वा चराचरम् ।\nविधूमो दृश्यते राजन् बलमानस्तथाऽर्जुनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173209, "chapter_id": 4687, "verse_number": "२३", "content_sanskrit": "द्रौणिस्तु समरे दृष्ट्वा पाण्डवस्य पराक्रमम् ।\nरथेनातिपताकेन पाण्डवं पर्यवारयत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173210, "chapter_id": 4687, "verse_number": "२४", "content_sanskrit": "तावुभौ पुरुषव्याघ्रौ श्वेताश्वौ धन्विनां वरौ ।\nसमीयतुस्तदा तूर्णं परस्परवधैषिणौ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173211, "chapter_id": 4687, "verse_number": "२५", "content_sanskrit": "तयोरासीन्महाराज बाणवर्षं सुदारुणम् ।\nजीमूतयोर्यथा वृष्टिः तपान्ते भरतर्षभ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173212, "chapter_id": 4687, "verse_number": "२६", "content_sanskrit": "अन्योन्यस्पर्धिनौ तौ तु शरैः सन्नतपर्वभिः ।\nततक्षतुर्मृधेऽन्योन्यं शृङ्गाभ्यां वृषभाविव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173213, "chapter_id": 4687, "verse_number": "२७", "content_sanskrit": "तयोर्युद्धं महाराज चिरं सममिवाभवत् ।\nअस्त्राणां सङ्गमश्चैव घोरस्तत्राभवत् पुनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173214, "chapter_id": 4687, "verse_number": "२८", "content_sanskrit": "ततोऽर्जुनं द्वादशभी रुग्मपुङ्खैः सुतेजनैः ।\nवासुदेवं च दशभिः द्रौणिर्विव्याध भारत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173215, "chapter_id": 4687, "verse_number": "२९", "content_sanskrit": "ततः प्रहस्य बीभत्सुर्विक्षिपन् गाण्डिवं धनुः ।\nमानयित्वा मुहूर्तं तु गुरुपुत्रं महारथम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173216, "chapter_id": 4687, "verse_number": "३०", "content_sanskrit": "व्यश्वसूतरथं चक्रे सव्यसाची परन्तपः ।\nमृदुपूर्वं ततश्चैनं त्रिभिर्विव्याध सायकैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173217, "chapter_id": 4687, "verse_number": "३१", "content_sanskrit": "हताश्वे तु रथे तिष्ठन् द्रोणपुत्रोऽप्यविस्मयन् ।\nमुसलं पाण्डुपुत्राय चिक्षेप परिघोपमम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173218, "chapter_id": 4687, "verse_number": "३२", "content_sanskrit": "तमापतन्तं सहसा हेमपट्टविभूषितम् ।\nचिच्छेद सप्तधा वीरः पार्थः शत्रुनिबर्हणः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173219, "chapter_id": 4687, "verse_number": "३३", "content_sanskrit": "सञ्छिन्नं मुसलं दृष्ट्वा द्रौणिः परमकोपनः ।\nआददे परिघं घोरं नगेन्द्रशिखरोपमम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173220, "chapter_id": 4687, "verse_number": "३४", "content_sanskrit": "चिक्षेप चैव पार्थाय द्रौणिर्युद्धविशारदः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173221, "chapter_id": 4687, "verse_number": "३५", "content_sanskrit": "तमन्तकमिव क्रुद्धं परिघं प्रेक्ष्य पाण्डवः ।\nअर्जुनस्त्वरितो जघ्ने पञ्चभिः सायकोत्तमैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173222, "chapter_id": 4687, "verse_number": "३६", "content_sanskrit": "स च्छिन्नः पतितो भूमौ पार्थबाणैर्महाहवे ।\nदारयन् पृथिवीन्द्राणां मनःशब्देन भारत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173223, "chapter_id": 4687, "verse_number": "३७", "content_sanskrit": "ततोऽपरैस्त्रिभिर्भल्लैः द्रौणिं विव्याध पाण्डवः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173224, "chapter_id": 4687, "verse_number": "३८", "content_sanskrit": "सोऽतिविद्धो बलवता पार्थेन सुमहाबलः ।\nन मुमोह तदा द्रौणिः पौरुषे स्वे व्यवस्थितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173225, "chapter_id": 4687, "verse_number": "३९", "content_sanskrit": "सुरथं तु महाराज भारद्वाजो महारथः ।\nअवाकिरत् शरव्रातैः सर्वक्षत्रस्य पश्यतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173226, "chapter_id": 4687, "verse_number": "४०", "content_sanskrit": "ततस्तु सुरथोऽप्याजौ पाञ्चालानां महारथः ।\nरथेन मेघघोषेण द्रौणिमेवाभ्यधावत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173227, "chapter_id": 4687, "verse_number": "४१", "content_sanskrit": "विचकर्ष धनुःश्रेष्ठं सर्वभारसहं दृढम् ।\nज्वलदाशीविषसमैः शरैराच्छादयन् शितैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173228, "chapter_id": 4687, "verse_number": "४२", "content_sanskrit": "सुरथं तु तदा क्रुद्धमापतन्तं महारथम् ।\nचुकोप समरे द्रौणिर्दण्डाहत इवोरगः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173229, "chapter_id": 4687, "verse_number": "४३", "content_sanskrit": "त्रिशिखां भ्रुकुटीं कृत्वा सृक्विणी परिलेलिहन् ।\nउद्वीक्ष्य सुरथं रोषाद् धनुर्ज्यामवमृज्य च\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173230, "chapter_id": 4687, "verse_number": "४४", "content_sanskrit": "मुमोच तीक्ष्णं नाराचं यमदण्डसमप्रभम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173231, "chapter_id": 4687, "verse_number": "४५", "content_sanskrit": "स तस्य हृदयं भित्त्वा प्रविवेशातिवेगितः ।\nशक्राशनिरिवोत्सृष्टो विदार्य धरणीतळम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173232, "chapter_id": 4687, "verse_number": "४६", "content_sanskrit": "ततः स पतितो भूमौ नाराचेन समाहतः ।\nवज्रेणेव महाशृङ्गं पर्वतस्य महावने\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173233, "chapter_id": 4687, "verse_number": "४७", "content_sanskrit": "तस्मिंस्तु निहते शूरे द्रोणपुत्रः प्रतापवान् ।\nआरुरोह रथं तूर्णं तमेव रथिनां वरः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173234, "chapter_id": 4687, "verse_number": "४८", "content_sanskrit": "ततः सद्यो महाराज द्रौणिराहवदुर्मदः ।\nअर्जुनं योधयामास संशप्तकवृतो रणे\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173235, "chapter_id": 4687, "verse_number": "४९", "content_sanskrit": "तत्र युद्धं महच्चासीद् अर्जुनस्य परैः सह ।\nमध्यन्दिनगते सूर्ये यमराष्ट्रविवर्धनम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173236, "chapter_id": 4687, "verse_number": "५०", "content_sanskrit": "तत्राश्चर्यमपश्याम दृष्ट्वा तेषां पराक्रमम् ।\nयदेको युगपद्वीरान् समयोधयदर्जुनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173237, "chapter_id": 4687, "verse_number": "५१", "content_sanskrit": "विमर्दश्च महानासीद् एकस्य बहुभिः सह ।\nशतक्रतोर्यथा पूर्वं महत्या दैत्यसेनया\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173238, "chapter_id": 4687, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173239, "chapter_id": 4687, "verse_number": "१४", "content_sanskrit": "शल्यवधपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]