[{"id": 50006230, "chapter_id": 11340, "verse_number": "1", "content_sanskrit": "॥ ॐ सर्वत्र प्रसिद्धोपदेशात् ॐ॥ बहुलिङ्गसहितश्रुतिः। निरवकाशश्रुत्यादयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006231, "chapter_id": 11340, "verse_number": "2", "content_sanskrit": "॥ ॐ अत्ता चराचरग्रहणात् ॐ॥ श्रुतिलिङ्गे। निश्चितबलवत्वम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006232, "chapter_id": 11340, "verse_number": "3", "content_sanskrit": "॥ ॐ गुहां प्रविष्टावात्मानौ हि तद्दर्शनात् ॐ॥ द्विवचनश्रुतिः। द्विरूपत्वम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006233, "chapter_id": 11340, "verse_number": "4", "content_sanskrit": "॥ ॐ अन्तर उपपत्तेः ॐ॥ अभ्यासार्थवादसहितबहुश्रुतयः। निरवकाशोपपत्तिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006234, "chapter_id": 11340, "verse_number": "5", "content_sanskrit": "॥ ॐ अन्तर्याम्याधिदैवादिषु तद्धर्मव्यपदेशात् ॐ॥ पृथिव्यादिशरीरत्वम्। यौगिकशरीरत्वोपपत्तिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006235, "chapter_id": 11340, "verse_number": "6", "content_sanskrit": "॥ ॐ अदृश्यत्वादिगुणको धर्मोक्तेः ॐ॥ निरवकाशत्वम्। अक्षरान्तरत्ववचनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006236, "chapter_id": 11340, "verse_number": "7", "content_sanskrit": "॥ ॐ वैश्वानरः साधारणशब्दविशेषात् ॐ॥ श्रुतिसाधारण्यम्। विशेषश्रुत्यादि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]