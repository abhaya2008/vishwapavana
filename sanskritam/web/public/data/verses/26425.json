[{"id": 7006425000, "chapter_id": 26425, "verse_number": "२-८५-१", "content_sanskrit": "वैशम्पायन उवाच\nरुद्धेषु भूमिपालेषु सानुगेषु विशाम्पते ।\nआविवेशासुरांश्चाथ कश्मलं जनमेजय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006425001, "chapter_id": 26425, "verse_number": "२-८५-२", "content_sanskrit": "दिशः प्रतस्थुस्ते वीरा वध्यमानाः समन्ततः ।\nकृष्णानन्तप्रभृतिभिर्यदुभिर्युद्धदुर्मदैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006425002, "chapter_id": 26425, "verse_number": "२-८५-३", "content_sanskrit": "निकुम्भस्तानथोवाच रुषितो दानवोत्तमः ।\nभित्त्वा प्रतिज्ञां किं मोहाद्भयार्ता यात विह्वलाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006425003, "chapter_id": 26425, "verse_number": "२-८५-४", "content_sanskrit": "हीनप्रतिज्ञाः काँल्लोकान् प्रयास्यथ पलायिताः ।\nअगत्वापचितिं युद्धे ज्ञातीनां कृतनिश्चयाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006425004, "chapter_id": 26425, "verse_number": "२-८५-५", "content_sanskrit": "फलं जित्वेह भोक्तव्यं रिपून् समरकर्कशान् ।\nहतेन चापि शूरेण वस्तव्यं त्रिदिवे सुखम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006425005, "chapter_id": 26425, "verse_number": "२-८५-६", "content_sanskrit": "पलायित्वा गृहं गत्वा कस्य द्रक्ष्यथ हे मुखम् ।\nदारान्वक्ष्यथ किं चापि धिग्धिक् किं किं न लज्जथ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006425006, "chapter_id": 26425, "verse_number": "२-८५-७", "content_sanskrit": "एवमुक्ता निवृत्तास्ते लज्जमाना नृपासुराः ।\nद्विगुणेन च वेगेन युयुधुर्यदुभिः सह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006425007, "chapter_id": 26425, "verse_number": "२-८५-८", "content_sanskrit": "उत्सवे युद्धशौण्डानां नानाप्रहरणैर्नृप ।\nये यान्ति यज्ञवाटं तं तान् निहन्ति धनंजयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006425008, "chapter_id": 26425, "verse_number": "२-८५-९", "content_sanskrit": "यमौ भीमश्च राजा च धर्मपुत्रो युधिष्ठिरः ।\nद्यां प्रयाताञ्जघानैन्द्रिः प्रवरश्च द्विजोत्तमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006425009, "chapter_id": 26425, "verse_number": "२-८५-१०", "content_sanskrit": "अथासुरासृक्तोयाढ्या केशशैवलशाद्वला ।\nचक्रकूर्मरथावर्ता गजशैलानुशोभिनी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006425010, "chapter_id": 26425, "verse_number": "२-८५-११", "content_sanskrit": "ध्वजकुन्ततरुच्छन्ना स्तनितोत्क्रुष्टनादिनी ।\nगोविन्दशैलप्रभवा भीरुचित्तप्रमाथिनी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006425011, "chapter_id": 26425, "verse_number": "२-८५-१२", "content_sanskrit": "असृग्बुद्बुदफेनाढ्या असिमत्स्यतरङ्गिणी ।\nसुस्राव शोणितनदी नदीव जलदागमे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006425012, "chapter_id": 26425, "verse_number": "२-८५-१३", "content_sanskrit": "तान् दृष्ट्वैव निकुम्भस्तु वर्द्धमानांश्च शात्रवान् ।\nहतान् सर्वान् सहायांश्च वीर्यादेवात्पपात ह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006425013, "chapter_id": 26425, "verse_number": "२-८५-१४", "content_sanskrit": "स वारितो जयन्तेन प्रवरेण च भारत ।\nशरैः कुलिशसंकाशैर्निकुम्भो रणकर्कशः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006425014, "chapter_id": 26425, "verse_number": "२-८५-१५", "content_sanskrit": "संनिवृत्याथ दष्टोष्ठः परिघेण दुरासदः ।\nप्रवरं ताडयामास स पपात महीतले ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006425015, "chapter_id": 26425, "verse_number": "२-८५-१६", "content_sanskrit": "ऐन्द्रिस्तं पतितं भूमौ बाहुभ्यां परिषस्वजे ।\nविदित्वा चैव सप्राणं हित्वासुरमभिद्रुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006425016, "chapter_id": 26425, "verse_number": "२-८५-१७", "content_sanskrit": "अभिद्रुत्य निकुम्भं च निस्त्रिंशेन जघान ह ।\nपरिघेणापि दैतेयो जयन्तं समताडयत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006425017, "chapter_id": 26425, "verse_number": "२-८५-१८", "content_sanskrit": "ततक्ष बहुलं गात्रं निकुम्भस्यैन्द्रिराहवे ।\nस चिन्तयामास तदा वध्यमानो महासुरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006425018, "chapter_id": 26425, "verse_number": "२-८५-१९", "content_sanskrit": "कृष्णेन सह योद्धव्यं वैरिणा ज्ञातिघातिना ।\nश्रावयामि किमात्मानमाहवे शक्रसूनुना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006425019, "chapter_id": 26425, "verse_number": "२-८५-२०", "content_sanskrit": "एवं स निश्चयं कृत्वा तत्रैवान्तरधीयत ।\nजगाम चैव युद्धार्थं यत्र कृष्णो महाबलः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006425020, "chapter_id": 26425, "verse_number": "२-८५-२१", "content_sanskrit": "तं दृष्ट्वैरावतस्कन्धमास्थितो बलनाशनः ।\nद्रष्टुमभ्यागतो युद्धं जहृषे सह दैवतैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006425021, "chapter_id": 26425, "verse_number": "२-८५-२२", "content_sanskrit": "साधु साध्विति पुत्रं च परितुष्टः स सस्वजे ।\nप्रवरं चापि धर्मात्मा सस्वजे मोहवर्जितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006425022, "chapter_id": 26425, "verse_number": "२-८५-२३", "content_sanskrit": "देवदुन्दुभयश्चापि प्रणेदुर्वासवाज्ञया ।\nजयमानं रणे दृष्ट्वा जयन्तं रणदुर्जयम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006425023, "chapter_id": 26425, "verse_number": "२-८५-२४", "content_sanskrit": "ददर्शाथ निकुम्भस्तु केशवं रणदुर्जयम् ।\nअर्जुनेन स्थितं सार्धं यज्ञवाटाविदूरतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006425024, "chapter_id": 26425, "verse_number": "२-८५-२५", "content_sanskrit": "स नादं सुमहान् कृत्वा पक्षिराजमताडयत् ।\nपरिघेण सुघोरेण बलं सत्यकमेव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006425025, "chapter_id": 26425, "verse_number": "२-८५-२६", "content_sanskrit": "नारायणं चार्जुनं च भीमं चाथ युधिष्ठिरम् ।\nयमौ च वासुदेवं च साम्बं कामं च वीर्यवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006425026, "chapter_id": 26425, "verse_number": "२-८५-२७", "content_sanskrit": "युयुधे मायया दैत्यः शीघ्रकारी च भारत ।\nन चैनं ददृशुः सर्वे सर्वशस्त्रविशारदाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006425027, "chapter_id": 26425, "verse_number": "२-८५-२८", "content_sanskrit": "यदा तु नैवापश्यस्तं तदा बिल्वोदकेश्वरम् ।\nदध्यौ देवं हृषीकेशः प्रमथानां गणेश्वरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006425028, "chapter_id": 26425, "verse_number": "२-८५-२९", "content_sanskrit": "ततस्ते ददृशुः सर्वे प्रभावादतितेजसः ।\nबिल्वोदकेश्वरस्याशु निकुम्भं मायिनां वरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006425029, "chapter_id": 26425, "verse_number": "२-८५-३०", "content_sanskrit": "कैलासशिखराकारं ग्रसन्तमिव धिष्ठितम् ।\nआह्वयन्तं रणे कृष्णं वैरिणं ज्ञातिनाशनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006425030, "chapter_id": 26425, "verse_number": "२-८५-३१", "content_sanskrit": "सत्यगाण्डीव एवाद्य पार्थस्तस्य रथेषुभिः ।\nपरिघं चैव गात्रेषु विव्याधैनमथासकृत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006425031, "chapter_id": 26425, "verse_number": "२-८५-३२", "content_sanskrit": "ते बाणास्तस्य गात्रेषु परिघे च जनाधिप ।\nभङ्गाः शिलाशिताः सर्वे निपेतुः कुञ्चिताः क्षितौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006425032, "chapter_id": 26425, "verse_number": "२-८५-३३", "content_sanskrit": "विफलानस्त्रयुक्तांस्तान् दृष्ट्वा बाणान्धनंजयः ।\nपप्रच्छ केशवं वीरः किमेतदिति भारत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006425033, "chapter_id": 26425, "verse_number": "२-८५-३४", "content_sanskrit": "पर्वतानपि भिन्दन्ति मम वज्रोपमाः शराः ।\nकिमिदं देवकीपुत्र विस्मयोऽत्र महान् मम ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006425034, "chapter_id": 26425, "verse_number": "२-८५-३५", "content_sanskrit": "तमुवाच ततः कृप्णः प्रहसन्निव भारत ।\nमहद्भूतं निकुम्भोऽयं कौन्तेय शृणु विस्तरात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006425035, "chapter_id": 26425, "verse_number": "२-८५-३६", "content_sanskrit": "पुरा गत्वोत्तरकुरूंस्तपश्चक्रे महासुरः ।\nशतं वर्षसहस्राणां देवशत्रुर्दुरासदः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006425036, "chapter_id": 26425, "verse_number": "२-८५-३७", "content_sanskrit": "अथैनं छन्दयामास वरेण भगवान् हरः ।\nस वव्रे त्रीणि रूपाणि न वध्यानि सुरासुरैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006425037, "chapter_id": 26425, "verse_number": "२-८५-३८", "content_sanskrit": "तमुवाच महादेवो भगवान् वृषभध्वजः ।\nमम वा ब्राह्मणानां वा विष्णोर्वा प्रियमाचरन् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006425038, "chapter_id": 26425, "verse_number": "२-८५-३९", "content_sanskrit": "भविष्यसि हरेर्वध्यो न त्वन्यस्य महासुर ।\nब्रह्मण्योऽहं च विष्णुश्च विप्राणां परमा गतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006425039, "chapter_id": 26425, "verse_number": "२-८५-४०", "content_sanskrit": "स एष सर्वशस्त्राणामवध्यः पाण्डुनन्दन ।\nत्रिदेहोऽतिप्रमाथी च वरमत्तश्च दानवः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006425040, "chapter_id": 26425, "verse_number": "२-८५-४१", "content_sanskrit": "भानुमत्यापहरणे देहोऽस्यैको हतो मया ।\nअवध्यं षट्पुरं देहमिदमस्य दुरात्मनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006425041, "chapter_id": 26425, "verse_number": "२-८५-४२", "content_sanskrit": "दितिं शुश्रूषति न्येको देहोऽस्य तपसान्वितः ।\nअन्यस्तु देहो घोरोऽस्य येनावसति षट्पुरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006425042, "chapter_id": 26425, "verse_number": "२-८५-४३", "content_sanskrit": "एतत् तु सर्वमाख्यातं निकुम्भचरितं मया ।\nत्वरयास्य वधे वीर कथा पश्चाद् भविष्यति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006425043, "chapter_id": 26425, "verse_number": "२-८५-४४", "content_sanskrit": "तयोः कथयतोरेवं कृष्णयोरसुरस्तदा ।\nगुहां षट्पुरसंज्ञां तां विवेश रणदुर्जयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006425044, "chapter_id": 26425, "verse_number": "२-८५-४५", "content_sanskrit": "अन्विष्य तस्य भगवान् विवेश मधुसूदनः ।\nतां षट्पुरगुहां घोरां दुर्धर्षां कुरुनन्दन ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006425045, "chapter_id": 26425, "verse_number": "२-८५-४६", "content_sanskrit": "चन्द्रसूर्यप्रभाहीनां ज्वलन्तीं स्वेन तेजसा ।\nसुखदुःखोष्णशीतानि प्रयच्छन्तीं यथेप्सितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006425046, "chapter_id": 26425, "verse_number": "२-८५-४७", "content_sanskrit": "तत्र प्रविश्य भगवानपश्यत जनाधिपान् ।\nयुयुधे सह घोरेण निकुम्भेन जनाधिप ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006425047, "chapter_id": 26425, "verse_number": "२-८५-४८", "content_sanskrit": "कृष्णस्यानुप्रविष्टास्तु बलाद्या यादवास्तदा ।\nप्रविष्टाश्च तथा सर्वे पाण्डवास्ते महात्मनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006425048, "chapter_id": 26425, "verse_number": "२-८५-४९", "content_sanskrit": "समेतास्तु प्रविष्टास्ते कृष्णस्यानुमतेन वै ।\nयुयुधे स तु कृष्णेन रौक्मिणेयः प्रचोदितः ।\nमानयद् यादवान्सर्वान्यानयं बद्धवान्पुरा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006425049, "chapter_id": 26425, "verse_number": "२-८५-५०", "content_sanskrit": "ते मुक्ता रौक्मिणेयेन प्राप्ता यत्र जनार्दनः ।\nप्रहृष्टमनसः सर्वे निकुम्भवधकाङ्क्षिणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006425050, "chapter_id": 26425, "verse_number": "२-८५-५१", "content_sanskrit": "राजानो वीर मुञ्चेति पुनः कामं यथाब्रुवन् ।\nमुमोच चाथ तान्वीरो रौक्मिणेयः प्रतापवान् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006425051, "chapter_id": 26425, "verse_number": "२-८५-५२", "content_sanskrit": "अधोमुखमुखाः सर्वे बद्धमौना नराधिपाः ।\nलज्जयाभिप्लुता वीरास्तस्थुर्नष्टश्रियस्तदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006425052, "chapter_id": 26425, "verse_number": "२-८५-५३", "content_sanskrit": "निकुम्भमपि गोविन्दः प्रयतन्तं जयं प्रति ।\nयोधयामास भगवान् घोरमात्मरिपुं हरिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006425053, "chapter_id": 26425, "verse_number": "२-८५-५४", "content_sanskrit": "परिघेनाहतः कृष्णो निकुम्भेन भृशं विभो ।\nगदया चापि कृष्णेन निकुम्भस्ताडितो भृशम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006425054, "chapter_id": 26425, "verse_number": "२-८५-५५", "content_sanskrit": "तावुभौ मोहमापन्नौ सुप्रहारहतौ तदा ।\nततः प्रव्यथितान्दृष्ट्वा पाण्डवांश्चाथ यादवान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006425055, "chapter_id": 26425, "verse_number": "२-८५-५६", "content_sanskrit": "जेपुर्मुनिगणास्तत्र कृष्णस्य हितकाम्यया ।\nतुष्टुवुश्च महात्मानं वेदप्रोक्तैस्तथा स्तवैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006425056, "chapter_id": 26425, "verse_number": "२-८५-५७", "content_sanskrit": "ततः प्रत्यागतप्राणो भगवान् केशवस्तदा ।\nदानवश्च पुनर्वीरावुद्यतौ समरं प्रति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006425057, "chapter_id": 26425, "verse_number": "२-८५-५८", "content_sanskrit": "वृषभाविव नर्दन्तौ गजाविव च भारत ।\nशालावृकाविव क्रुद्धौ प्रहरन्तौ रणोत्कटौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006425058, "chapter_id": 26425, "verse_number": "२-८५-५९", "content_sanskrit": "अथ कृष्णं तदोवाच नृप वागशरीरिणी ।\nचक्रेण शमयस्यैनं देवब्राह्मणकण्टकम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006425059, "chapter_id": 26425, "verse_number": "२-८५-६०", "content_sanskrit": "इति होवाच भगवान् देवो बिल्वोदकेश्वरः ।\nधर्मं यशश्च विपुलं प्राप्नुहि त्वं महाबल ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006425060, "chapter_id": 26425, "verse_number": "२-८५-६१", "content_sanskrit": "तथेत्युक्त्वा नमस्कृत्वा लोकनाथः सतां गतिः ।\nसुदर्शनं मुमोचाथ चक्रं दैत्यकुलान्तकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006425061, "chapter_id": 26425, "verse_number": "२-८५-६२", "content_sanskrit": "तन्निकुम्भस्य चिच्छेद शिरः प्रवरकुण्डलम् ।\nनारायणभुजोत्सृष्टं सूर्यमण्डलवर्चसम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006425062, "chapter_id": 26425, "verse_number": "२-८५-६३", "content_sanskrit": "उत्पपात शिरस्तस्य भूमौ ज्वलितकुण्डलम् ।\nमेघमत्तो गिरेः शृङ्गान्मयूर इव भूतले ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006425063, "chapter_id": 26425, "verse_number": "२-८५-६४", "content_sanskrit": "निकुम्भे निहते तस्मिन् देवो बिल्वोदकेश्वरः ।\nतुतोष च नरव्याघ्र जगत्त्रासकरे विभुः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006425064, "chapter_id": 26425, "verse_number": "२-८५-६५", "content_sanskrit": "पपात पुष्पवृष्टिश्च शक्रसृष्टा नभस्तलात् ।\nदेवदुन्दुभयश्चैव प्रणेदुररिनाशने ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006425065, "chapter_id": 26425, "verse_number": "२-८५-६६", "content_sanskrit": "ननन्द च जगत्कृत्स्नं मुनयश्च विशेषतः ।\nदैत्यकन्याश्च भगवान् यदुभ्यः शतशो ददौ ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006425066, "chapter_id": 26425, "verse_number": "२-८५-६७", "content_sanskrit": "क्षत्त्रियाणां च भगवान्सान्त्वयित्वा पुनः पुनः ।\nरत्नानि च विचित्राणि वासांसि प्रवराणि च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006425067, "chapter_id": 26425, "verse_number": "२-८५-६८", "content_sanskrit": "रथानां वाजियुक्तानां षट् सहस्राणि केशवः ।\nअददात् पाण्डवेभ्यश्च प्रीतात्मा गदपूर्वजः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006425068, "chapter_id": 26425, "verse_number": "२-८५-६९", "content_sanskrit": "तदेव चाथ प्रवरं षट्पुरं पुरवर्द्धनः ।\nद्विजाय ब्रह्मदत्ताय ददौ तार्क्ष्यवरध्वजः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006425069, "chapter_id": 26425, "verse_number": "२-८५-७०", "content_sanskrit": "सत्रे समाप्ते च तदा शङ्खचक्रगदाधरः ।\nविसर्जयित्वा तत् क्षत्रं पाण्डवांश्च महाबलः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006425070, "chapter_id": 26425, "verse_number": "२-८५-७१", "content_sanskrit": "बिल्वोदकेश्वरस्याथ समाजमकरोत् प्रभुः ।\nमांससूपसमाकीर्णं बह्वन्नं व्यञ्जनाकुलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006425071, "chapter_id": 26425, "verse_number": "२-८५-७२", "content_sanskrit": "नियुद्धकुशलान् मल्लान् देवो मल्लप्रियस्तदा ।\nयोधयित्वा ददौ भूरि वित्तं वस्त्राणि चात्मवान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006425072, "chapter_id": 26425, "verse_number": "२-८५-७३", "content_sanskrit": "मातापितृभ्यां सहितो यदुभिश्च महाबलः ।\nअभिवाद्य ब्रह्मदत्तं ययौ द्वारवतीं पुरीम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006425073, "chapter_id": 26425, "verse_number": "२-८५-७४", "content_sanskrit": "स विवेश पुरीं रम्यां हृष्टपुष्टजनाकुलाम् ।\nपुष्पचित्रपथां वीरो वन्द्यमानो नरैः पथि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006425074, "chapter_id": 26425, "verse_number": "२-८५-७५", "content_sanskrit": "इमं यः षटपुरवधं विजयं चक्रपाणिनः ।\nशृणुयाद् वा पठेद् वापि युद्धे जयमवाप्नुयात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006425075, "chapter_id": 26425, "verse_number": "२-८५-७६", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो लभते धनम् ।\nव्याधितो मुच्यते रोगी बद्धश्चाप्यथ बन्धनात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006425076, "chapter_id": 26425, "verse_number": "२-८५-७७", "content_sanskrit": "इदं पुंसवनं प्रोक्तं गर्भाधानं च भारत ।\nश्राद्धेषु पठितं सम्यगक्षय्यकरणं स्मृतम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006425077, "chapter_id": 26425, "verse_number": "२-८५-७८", "content_sanskrit": "इदममरवरस्य भारते प्रथितबलस्य जयं महात्मनः ।\nसततमिह हि यः पठेन्नरः सुगतिमितो व्रजते गतज्वरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006425078, "chapter_id": 26425, "verse_number": "२-८५-७९", "content_sanskrit": "मणिकनकविचित्रपाणिपादो निरतिशयार्कगुणोऽरिहादिनाथः ।\nचतुरुदधिशयश्चतुर्विधात्मा जयति जगत्पुरुषः सहस्रनामा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]