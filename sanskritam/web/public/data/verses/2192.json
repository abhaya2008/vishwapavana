[{"id": 2054263, "chapter_id": 2192, "verse_number": "७-११९-०x", "content_sanskrit": "`सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054264, "chapter_id": 2192, "verse_number": "७-११९-१", "content_sanskrit": "निर्जित्य कृतवर्माणं भारद्वाजं च संयुगे।\nस सात्यकिः सत्यधृतिर्महात्मा शिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054265, "chapter_id": 2192, "verse_number": "७-११९-२", "content_sanskrit": "*दुर्योधनं च निर्जित्य शूरं चैव सुयोधनम्।\nजलसन्धं निहत्याजौ शूरसेनं च पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054266, "chapter_id": 2192, "verse_number": "७-११९-३", "content_sanskrit": "म्लेच्छांश्च बहुधा राजन्काश्यपुत्रं च संयुगे।\nनिषादांस्तङ्कणांश्चैव कलिङ्गान्मगधानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054267, "chapter_id": 2192, "verse_number": "७-११९-४", "content_sanskrit": "केकयाञ्छूरसेनांश्च तथा पर्वतवासिनः।\nकाम्भोजान्यवनांश्चैव वसातींश्च शिबीनपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054268, "chapter_id": 2192, "verse_number": "७-११९-५", "content_sanskrit": "कोसलान्मगधांश्चैव यातुधानान्सतित्तिरान्।\nएतांश्चान्यान्रणे हत्वाऽगच्छद्युद्धे स सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054269, "chapter_id": 2192, "verse_number": "७-११९-६", "content_sanskrit": "रुधिरौघनदीं घोरां केशशैवालशाद्वलाम्।\nशक्तिग्राहसमाकीर्णां छत्रहंसोपशोभिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054270, "chapter_id": 2192, "verse_number": "७-११९-७", "content_sanskrit": "दुस्तरां भीरुभिर्नित्यं शूरलोकप्रवाहिनीम्।\nप्रवर्त्य हृषितो राजन्पुनर्यन्तारमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054271, "chapter_id": 2192, "verse_number": "७-११९-८", "content_sanskrit": "ध्वजनागाश्वकलिलं शरशक्त्यूर्मिमालिनम्।\nखङ्कमत्स्यं गदाग्राहं शूरायुधमहास्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054272, "chapter_id": 2192, "verse_number": "७-११९-९", "content_sanskrit": "प्राणापहारिणं रौद्रं वादित्रोद्धुष्टनादितम्।\nशूराणां सुखसंस्पर्शमस्पृश्यमथ भीरुणाम्।\nतीर्णाः स्म दुस्तरं तात द्रोणानीकमहार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054273, "chapter_id": 2192, "verse_number": "७-११९-१०", "content_sanskrit": "जलसन्धबलेनाजौ पुरुषादैरिवावृतम्।\nअतोऽन्यत्पृतनाशेषं मन्ये कुनदिकामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054274, "chapter_id": 2192, "verse_number": "७-११९-११", "content_sanskrit": "तर्तव्यामल्पसलिलां चोदयाश्वानसम्भ्रमम्।\nहस्तप्राप्तमहं मन्ये साम्प्रतं सव्यसाचिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054275, "chapter_id": 2192, "verse_number": "७-११९-१२", "content_sanskrit": "निर्जित्य दुर्धरं द्रोणं सपदानुगमाहवे।\nहार्दिक्यं योधवर्यं च मन्ये प्राप्तं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054276, "chapter_id": 2192, "verse_number": "७-११९-१३", "content_sanskrit": "न हि मे जायते त्रासो दृष्ट्वा सैन्यान्यनेकशः।\nवह्नेरिव प्रदीप्तस्य वने शुष्कतृणालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054277, "chapter_id": 2192, "verse_number": "७-११९-१४", "content_sanskrit": "पश्य पाण्डवमुख्येन यातां भूमिं किरीटिना।\nपत्त्यश्वरथनागौघैः पतितैर्विषमीकृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054278, "chapter_id": 2192, "verse_number": "७-११९-१५", "content_sanskrit": "द्रवते तद्यथा सैन्यं तेन भग्नं महात्मना।\nरथैर्विपरिधावद्भिर्गजैरश्वैश्च सारथे।\nकौशेयारुणसंकाशमेतदुद्वूयते रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054279, "chapter_id": 2192, "verse_number": "७-११९-१६", "content_sanskrit": "अभ्याशस्थमहं मन्ये श्वेताश्वं कृष्णसारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054280, "chapter_id": 2192, "verse_number": "७-११९-१७", "content_sanskrit": "श्रूयते ह्येष निर्घोषो जलदस्येव गर्जतः।\nविष्फार्यमाणस्य रणे गाण्डीवस्यामितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054281, "chapter_id": 2192, "verse_number": "७-११९-१८", "content_sanskrit": "अभ्याशस्थमहं मन्ये सैन्धवस्य किरीटिनम्।\nतादृशः श्रूयते शब्दः सैन्यानां सागरोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054282, "chapter_id": 2192, "verse_number": "७-११९-१९", "content_sanskrit": "यादृशानि निमित्तानि मम प्रादुर्भवन्ति वै।\nअनस्तंगत आदित्ये हन्ता सैन्धवमर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054283, "chapter_id": 2192, "verse_number": "७-११९-२०", "content_sanskrit": "शनैर्विस्रम्भयन्नश्वान्याहि यत्रारिवाहिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054284, "chapter_id": 2192, "verse_number": "७-११९-२१", "content_sanskrit": "यत्रैते सतलत्रामाः सुयोधनपुरोगमाः।\nदंशिताः क्रूरकर्माणः काम्भोजा युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054285, "chapter_id": 2192, "verse_number": "७-११९-२२", "content_sanskrit": "शरबाणासनधरा यवनाश्च प्रहारिणः।\nशकाः किराता दरदा बर्बरास्ताम्रलिप्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054286, "chapter_id": 2192, "verse_number": "७-११९-२३", "content_sanskrit": "अन्ये च बहवो म्लेच्छा विविधायुधपाणयः।\nमामेवाभिमुखाः सर्वे तिष्ठन्ति समरार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054287, "chapter_id": 2192, "verse_number": "७-११९-२४", "content_sanskrit": "एतान्सरथनागाश्वान्निहत्याजौ सपत्तिनः।\nइदं दुर्गं महाघोरं तीर्णमेवोपधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054288, "chapter_id": 2192, "verse_number": "७-११९-२५x", "content_sanskrit": "सूत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054289, "chapter_id": 2192, "verse_number": "७-११९-२५", "content_sanskrit": "न सम्भ्रमो मे वार्ष्णेय विद्यते सत्यविक्रम।\nयद्यपि स्यात्तव क्रुद्धो जामदग्न्योऽग्रतः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054290, "chapter_id": 2192, "verse_number": "७-११९-२६", "content_sanskrit": "द्रोणो वा रथिनां श्रेष्ठः कृपो मद्रेश्वरोऽपि वा।\nतथापि सम्भ्रामो न स्यात्त्वामाश्रित्य महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054291, "chapter_id": 2192, "verse_number": "७-११९-२७", "content_sanskrit": "त्वया सुबहवो युद्धे निर्जिताः शत्रुसूदन।\nदंशिताःक्रूरकर्माणः काम्भोजा युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054292, "chapter_id": 2192, "verse_number": "७-११९-२८", "content_sanskrit": "शरवाणासनधरा यवनाश्च प्रहारिणः।\nशकाः किराता दरदा बर्बरास्ताम्रलिप्तकाः।\nअन्ये च बहवो म्लेच्छा विविधायुधपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054293, "chapter_id": 2192, "verse_number": "७-११९-२९", "content_sanskrit": "न च मे सम्भ्रमः कश्चिद्भूतपूर्वः कथञ्चन।\nकिमुतैतत्समासाद्य धीरं संयुगगोष्पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054294, "chapter_id": 2192, "verse_number": "७-११९-३०", "content_sanskrit": "आयुष्मन्कतरेण त्वां प्रापयामि धनञ्जयम्।\nकेभ्यः क्रुद्धोऽसि वार्ष्णेय कान्स्विन्मृत्युरुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054295, "chapter_id": 2192, "verse_number": "७-११९-३१", "content_sanskrit": "केषां सङ्घमनीकस्य हन्तुमुत्सहते मनः।\nकेत्वां युधि पराक्रान्तं कालान्तकयमोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054296, "chapter_id": 2192, "verse_number": "७-११९-३२", "content_sanskrit": "दृष्ट्वा विक्रमसम्पन्नं विद्रविष्यन्ति संयुगे।\nकेषां वैवस्वतो राजा स्मरतेऽद्य महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054297, "chapter_id": 2192, "verse_number": "७-११९-३३x", "content_sanskrit": "सात्यकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054298, "chapter_id": 2192, "verse_number": "७-११९-३३", "content_sanskrit": "मुण्डानेतान्हनिष्यामि दानवानिव वासवः।\nप्रतिज्ञां पारयिष्यामि काम्भोजानेव मां वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054299, "chapter_id": 2192, "verse_number": "७-११९-३४", "content_sanskrit": "xxxxxकदनं कृत्वा क्षिप्रं यास्यामि पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054300, "chapter_id": 2192, "verse_number": "७-११९-३५", "content_sanskrit": "xxxxxयन्ति मे वीर्यं कौरवाः ससुयोधनाः।\nxxxxxxनाके हते सूत सर्वसैन्येषु चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054301, "chapter_id": 2192, "verse_number": "७-११९-३६", "content_sanskrit": "अद्य कौरवसैन्यस्य दीर्घमाणस्य संयुगे।\nश्रुत्वा विरावं बहुधा सन्तप्स्यति सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054302, "chapter_id": 2192, "verse_number": "७-११९-३७", "content_sanskrit": "अद्य पाण्डवमुख्यस्य श्वेताश्वस्य महात्मनः।\nआचार्यककृतं मार्गं दर्शयिष्यामि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054303, "chapter_id": 2192, "verse_number": "७-११९-३८", "content_sanskrit": "अद्य मद्बाणनिहतान्योधमुख्यान्सहस्रशः।\nदृष्ट्वा दुर्योधनो राजा पश्चात्तापं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054304, "chapter_id": 2192, "verse_number": "७-११९-३९", "content_sanskrit": "अद्य मे क्षिप्रहस्तस्य क्षिपतः सायकोत्तमान्।\nअलातचक्रप्रतिमं धनुर्द्रक्ष्यन्ति कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054305, "chapter_id": 2192, "verse_number": "७-११९-४०", "content_sanskrit": "मत्सायकचिताङ्गानां रुधिरं स्रवतां मुहुः।\nसैनिकानां वधं दृष्ट्वा सन्तप्स्यति सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054306, "chapter_id": 2192, "verse_number": "७-११९-४१", "content_sanskrit": "अद्य मे क्रुद्धरूपस्य निघ्नतश्च वरान्वरान्।\nद्विफल्गुनामिमं लोकं मंस्यतेऽद्य सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054307, "chapter_id": 2192, "verse_number": "७-११९-४२", "content_sanskrit": "अद्य राजसहस्राणि निहतानि मया रणे।\nदृष्ट्वा दुर्योधनो राजा सन्तप्स्यति महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054308, "chapter_id": 2192, "verse_number": "७-११९-४३", "content_sanskrit": "अद्य स्नेहं च भक्तिं च पाण्डवेषु महात्मसु।\nहत्वा राजसहस्राणि दर्शयिष्यामि राजसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054309, "chapter_id": 2192, "verse_number": "७-११९-४४", "content_sanskrit": "बलं वीर्यं कृतज्ञत्वं मम ज्ञास्यन्ति कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054310, "chapter_id": 2192, "verse_number": "७-११९-४५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054311, "chapter_id": 2192, "verse_number": "७-११९-४५", "content_sanskrit": "एवमुक्तस्तदा सूतः शिक्षितान्साधुवाहिनः।\nशशाङ्कसन्निकाशान्वै वाजिनो व्यनुदद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054312, "chapter_id": 2192, "verse_number": "७-११९-४६", "content_sanskrit": "ते पिबन्त इवाकाशं युयुधानं हयोत्तमाः।\nप्रापयन्यवनाञ्शनीघ्रं मनः पवनरंहसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054313, "chapter_id": 2192, "verse_number": "७-११९-४७", "content_sanskrit": "सात्यकिं ते समासाद्य पृतनास्वनिवर्तिनम्।\nबहवो लघुहस्ताश्च शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054314, "chapter_id": 2192, "verse_number": "७-११९-४८", "content_sanskrit": "तेषामिषूनथास्त्राणि वेगवान्नतपर्वभिः।\nअच्छिनत्सात्यकी राजन्नैनं ते प्राप्नुवञ्शराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054315, "chapter_id": 2192, "verse_number": "७-११९-४९", "content_sanskrit": "रुक्मपुङ्खैः सुनिशितैर्गार्ध्रपत्रैरजिह्मगैः।\nउच्चकर्त शिरांस्युग्रो यवनानां भुजानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054316, "chapter_id": 2192, "verse_number": "७-११९-५०", "content_sanskrit": "शैक्यायसानि वर्माणि कांस्यानि च समन्ततः।\nभित्त्वा देहांस्तथा तेषां शरा जग्मुर्महीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054317, "chapter_id": 2192, "verse_number": "७-११९-५१", "content_sanskrit": "ते हन्यमाना वीरेण म्लेच्छाः सात्यकिना रणे।\nशतशोऽभ्यपतंस्तत्र व्यसवो वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054318, "chapter_id": 2192, "verse_number": "७-११९-५२", "content_sanskrit": "सुपूर्णायतमुक्तैस्तानव्यवच्छिन्नपिण्डितैः।\nपञ्च षट् सप्त चाष्टौ च भिभेद यवनाञ्शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054319, "chapter_id": 2192, "verse_number": "७-११९-५३", "content_sanskrit": "काम्भोजानां सहस्रैश्च शकानां च विशाम्पते।\nशबराणां किरातानां बर्बराणां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054320, "chapter_id": 2192, "verse_number": "७-११९-५४", "content_sanskrit": "अगम्यरूपां पृथिवीं मांसशोणितकर्दमाम्।\nकृतवांस्तत्र शैनेयः क्षपयंस्तावकं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054321, "chapter_id": 2192, "verse_number": "७-११९-५५", "content_sanskrit": "दस्यूनां सशिरस्त्राणैः शिरोभिर्लूनमूर्धदौः।\nदीर्घकूर्चैर्मही कीर्णा विबर्हैरण्डजैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2054322, "chapter_id": 2192, "verse_number": "७-११९-५६", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गैस्तैस्तदायोधनं बभौ।\nकबन्धैः संवृतं सर्वं ताम्राभ्रैः खमिवावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2054323, "chapter_id": 2192, "verse_number": "७-११९-५७", "content_sanskrit": "वज्राशनिसमस्पर्शैः सुपर्वभिरजिह्मगैः।\nते सात्वतेन निहताः समावव्रुर्वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2054324, "chapter_id": 2192, "verse_number": "७-११९-५८", "content_sanskrit": "`तेषामस्त्राणि बाणांश्च शैनेयो नतपर्वभिः।\nनिचकर्त महाराज यवनानां शिरोधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2054325, "chapter_id": 2192, "verse_number": "७-११९-५९", "content_sanskrit": "ते शरा नतपर्वाणो युयुधानप्रचोदिताः।\nहित्वा देहांस्तथा तेषां पतन्ति स्म महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2054326, "chapter_id": 2192, "verse_number": "७-११९-६०", "content_sanskrit": "ते हन्यमाना वीरास्तु वृष्णिवीरेण संयुगे।\nशस्त्राहताः पतन्त्युर्व्यां काम्भोजाः सपदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2054327, "chapter_id": 2192, "verse_number": "७-११९-६१", "content_sanskrit": "काम्भोजानां भुजैश्छिन्नैर्यवनानां च भारत।\nतत्रतत्र मही भाति पञ्चास्यैरिव पन्नगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2054328, "chapter_id": 2192, "verse_number": "७-११९-६२", "content_sanskrit": "अल्पावशिष्टाः सम्भग्नाः कृच्छ्रप्राणा विचेतसः।\nजिताः सङ्ख्ये महाराज युयुधानेन दंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2054329, "chapter_id": 2192, "verse_number": "७-११९-६३", "content_sanskrit": "पार्ष्णिभिश्च कशाभिश्च ताडयन्तस्तुरङ्गमान्।\nजवमुत्तममास्थाय सर्वतः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2054330, "chapter_id": 2192, "verse_number": "७-११९-६४", "content_sanskrit": "काम्भोजसैन्यं विद्राव्य दुर्जयं युधि भारत।\nयवनानां च तत्सैन्यं शकानां च महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2054331, "chapter_id": 2192, "verse_number": "७-११९-६५", "content_sanskrit": "ततः स पुरुषव्याघ्रः सात्यकिः सत्यविक्रमः।\nप्रहृष्टस्तावकाञ्जित्वा सूतं याहीत्यचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2054332, "chapter_id": 2192, "verse_number": "७-११९-६६", "content_sanskrit": "तत्तस्य समरे कर्म दृष्ट्वाऽन्यैरकृतं पुरा।\nचारणाः सहगन्धर्वाः पूजयाञ्चक्रिरे भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2054333, "chapter_id": 2192, "verse_number": "७-११९-६७", "content_sanskrit": "तं यान्तं पृष्ठगोप्तारमर्जुनस्य विशाम्पते।\nचारणाः प्रेक्ष्य संहृष्टास्त्वदीयाश्चाभ्यपूजयन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2054334, "chapter_id": 2192, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकोनविंशत्यधिकशततमोऽध्यायः॥ ११९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-११९-* एतदादिसार्धसप्तश्लोकस्थाने वक्ष्यमाणः सार्धएव श्लोकः झ.पुस्तकेऽस्ति। सञ्जय उवाच। ततः स सात्यकिर्धामीन्महात्मा वृष्णिपुङ्गवः। सुदर्शनं निहत्याजौ यन्तारं पुनरब्रवीत्॥ रथाश्वनागकलिलं शरशत्तयूर्मिमालिनम्। ५-११९-२० विस्रम्भयन् आश्वासयन्॥ ५-११९-३३ पारयिष्यामि समापयिष्यामि॥ ५-११९-५० वैक्यायसानि शोणितायोमयानि॥ ५-११९-५२ सुपूर्णयतमुक्तैराकर्णज्योत्सृष्टैः। अव्यवच्छिन्नपिण्डितैरनवच्छिन्नसंहतैः॥ ५-११९-११९ एकोनविंशत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]