[{"id": 2195467, "chapter_id": 5157, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195468, "chapter_id": 5157, "verse_number": "१", "content_sanskrit": "कर्मणां मे समस्तानां शुभानां भरतर्षभ ।\nफलानि वदतांश्रेष्ठ प्रब्रूहि परिपृच्छतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195469, "chapter_id": 5157, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195470, "chapter_id": 5157, "verse_number": "२", "content_sanskrit": "रहस्यं यदृषीणां तु तच्छृणुष्व युधिष्ठिर ।\nया गतिः प्राप्यते येन प्रेत्यभावे चिरेप्सिता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195471, "chapter_id": 5157, "verse_number": "३", "content_sanskrit": "येन येन शरीरेण यद्यत्कर्म करोति यः ।\nतेन तेन शरीरेण तत्तत्फलमुपाश्नुते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195472, "chapter_id": 5157, "verse_number": "४", "content_sanskrit": "यस्यां यस्यामवस्थायां यत्करोति शुभाशुभम् ।\nतस्यां तस्यामवस्थायां तत्फलं प्रतिपद्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195473, "chapter_id": 5157, "verse_number": "५", "content_sanskrit": "न नश्यति कृतं कर्म सदा पञ्चेन्द्रियैरिह ।\nते ह्यस्य साक्षिणो नित्यं षष्ठ आत्मा तथैव च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195474, "chapter_id": 5157, "verse_number": "६", "content_sanskrit": "चक्षुर्दद्यान्मनो दद्याद् वाचं दद्याच्च सूनृताम् ।\nअनुव्रजेदुपासीत स यज्ञः पञ्चदक्षिणः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195475, "chapter_id": 5157, "verse_number": "७", "content_sanskrit": "यो दद्यादपरिक्लिष्टमन्नमध्वनि वर्तते ।\nश्रान्तायादृष्टपूर्वाय तस्य पुण्यफलं महत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195476, "chapter_id": 5157, "verse_number": "८", "content_sanskrit": "स्थण्डिलेषु शयानानां गृहाणि शयनानि च ।\nचीरवल्कलसंवीते वासांस्याभरणानि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195477, "chapter_id": 5157, "verse_number": "९", "content_sanskrit": "वाहनासनयानानि योगात्मनि तपोधने ।\nअग्नीनुपशयानस्य राज्ञः पौरुषमुच्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195478, "chapter_id": 5157, "verse_number": "१०", "content_sanskrit": "रसानां प्रतिसंहारे सौभाग्यमनुगच्छति ।\nआमिषप्रतिसंहारे पशून् पुत्रांश्च विन्दति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195479, "chapter_id": 5157, "verse_number": "११", "content_sanskrit": "अवाक्शिरास्तु यो लम्बेदुदवासं च यो वसेत् ।\nसततं चैकशायी यः स लभेतेप्सितां गतिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195480, "chapter_id": 5157, "verse_number": "१२", "content_sanskrit": "पाद्यमासनमेवाथ दीपमन्नं प्रतिश्रयम् ।\nदद्यादतिथिपूजार्थं स यज्ञः पञ्चदक्षिणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195481, "chapter_id": 5157, "verse_number": "१३", "content_sanskrit": "वीरासनं वीरशय्यां वीरस्थानमुपासतः ।\nअक्षयास्तस्य वै लोकाः सर्वकामगमास्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195482, "chapter_id": 5157, "verse_number": "१४", "content_sanskrit": "धनं लभेत दानेन मौनेनाज्ञां विशाम्पते ।\nउपभोगांश्च तपसा जीवितं ब्रह्मचर्यया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195483, "chapter_id": 5157, "verse_number": "१५", "content_sanskrit": "रूपमैश्वर्यमारोग्यमहिंसाफलमश्नुते ।\nफलमूलाशिनां राज्यं स्वर्गः पर्णाशिनां तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195484, "chapter_id": 5157, "verse_number": "१६", "content_sanskrit": "प्रायोपवेशनाद् राज्यं सर्वत्र सुखमुच्यते ।\nस्वर्गं सत्येन लभते दीक्षया कुलमुत्तमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195485, "chapter_id": 5157, "verse_number": "१७", "content_sanskrit": "गवाढ्यः शाकदीक्षायां स्वर्गगामी तृणाशनः ।\nस्त्रियस्त्रिषवणं स्नात्वा वायुं पीत्वा क्रतुं लभेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195486, "chapter_id": 5157, "verse_number": "१८", "content_sanskrit": "सलिलाशी भवेद्यस्तु सदाग्निः संस्कृतो द्विजः ।\nमनुं साधयतो राज्यं नाकपृष्ठमनाशके\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195487, "chapter_id": 5157, "verse_number": "१९", "content_sanskrit": "उपवासं च दीक्षां च अभिषेकं च पार्थिव ।\nकृत्वा द्वादशवर्षाणि वीरस्थानाद् विशिष्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195488, "chapter_id": 5157, "verse_number": "२०", "content_sanskrit": "अधीत्य सर्ववेदान् वै सद्यो दुःखात् प्रमुच्यते ।\nमानसं हि चरन् धर्मं स्वर्गलोकमवाप्नुते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195489, "chapter_id": 5157, "verse_number": "२१", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः ।\nयोऽसौ प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195490, "chapter_id": 5157, "verse_number": "२२", "content_sanskrit": "यथा धेनुसहस्रेषु वत्सो विन्दति मातरम् ।\nएवं पूर्वकृतं कर्म कर्तारमनुगच्छति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195491, "chapter_id": 5157, "verse_number": "२३", "content_sanskrit": "अचोद्यमानानि यथा पुष्पाणि च फलानि च ।\nस्वकालं नातिवर्तन्ते तथा कर्म पुराकृतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195492, "chapter_id": 5157, "verse_number": "२४", "content_sanskrit": "जीर्यन्ति जीर्यतः केशा दन्ता जीर्यन्ति जीर्यतः ।\nचक्षुःश्रोत्रे च जीर्येते तृष्णैका तु न जीर्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195493, "chapter_id": 5157, "verse_number": "२५", "content_sanskrit": "येन प्रीणाति पितरं तेन प्रीतः पितामहः ।\nप्रीणाति मातरं येन पृथिवी तेन पूजिता\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195494, "chapter_id": 5157, "verse_number": "२५", "content_sanskrit": "येन प्रीणात्युपाध्यायं तेन स्याद् ब्रह्म पूजितम् ।\nयज्ञवच्चरते धर्मं स्वर्गलोकमवाप्नुयात् ।\nअतिथिः पूजितो येन तेन देवाश्च पूजिताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195495, "chapter_id": 5157, "verse_number": "२६", "content_sanskrit": "सर्वे तस्यादृता धर्मा यस्यैते त्रय आदृताः ।\nअनादृतास्तु यस्यैते सर्वास्तस्याफलाः क्रियाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195496, "chapter_id": 5157, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195497, "chapter_id": 5157, "verse_number": "२७", "content_sanskrit": "भीष्मस्य तद्वचः श्रुत्वा विस्मिताः कुरुपुङ्गवाः ।\nआसन् प्रहृष्टमनसः प्रीतिमन्तोऽभवंस्तदा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2195498, "chapter_id": 5157, "verse_number": "२८", "content_sanskrit": "यन्मन्त्रे भवति वृथा प्रयुज्यमाने\nयत्सोमे भवति वृथाभिषूयमाणे ।\nयच्चाग्नौ भवति वृथाभिहूयमाने\nतत्सर्वं भवति वृथाऽभिधीयमाने\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2195499, "chapter_id": 5157, "verse_number": "२९", "content_sanskrit": "इत्येतदृषिणा प्रोक्तमुक्तवानस्मि यद् विभो ।\nशुभाशुभफलप्राप्तौ किमतः श्रोतुमिच्छसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2195500, "chapter_id": 5157, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे कर्मफलप्रशंसनं नाम अष्टमोऽध्यायः ॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]