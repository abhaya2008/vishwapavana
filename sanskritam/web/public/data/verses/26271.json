[{"id": 7006271000, "chapter_id": 26271, "verse_number": "३-२५-१", "content_sanskrit": "ततः श्रुत्वा वधं तेषां तपोबलवतामपि ।\nन्यश्वसत्कृष्णसर्पेन्द्र इव भण्डो महासुरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006271001, "chapter_id": 26271, "verse_number": "३-२५-२", "content_sanskrit": "एकान्ते मन्त्रयामास स आहूय महोदरौ ।\nभण्डः प्रचण्डशैण्डीर्यः काङ्क्षमाणो रणे जयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006271002, "chapter_id": 26271, "verse_number": "३-२५-३", "content_sanskrit": "युवराजोऽपि सक्रोधो विषङ्गेण यवीयसा ।\nभण्डासुरं नमस्कृत्य मन्त्रस्थानमुपागमत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006271003, "chapter_id": 26271, "verse_number": "३-२५-४", "content_sanskrit": "अत्याप्तैर्मन्त्रिभिर्युक्तः कुटिलाक्षपुरःसरैः ।\nललिताविजये मन्त्रं चकार क्वथिताश्यः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006271004, "chapter_id": 26271, "verse_number": "३-२५-५", "content_sanskrit": "भण्ड उवाच अहो बत कुलभ्रंशः समायातः सुरद्विषाम् ।\nउपेक्षामधुना कर्तुं प्रवृत्तो बलवान्विधिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006271005, "chapter_id": 26271, "verse_number": "३-२५-६", "content_sanskrit": "मद्भृत्यनाममात्रेण विद्रवन्ति दिवौकसः ।\nतादृशानामिहास्माकमागतोऽयं विपर्ययः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006271006, "chapter_id": 26271, "verse_number": "३-२५-७", "content_sanskrit": "करोति बलिनं क्लीबं धनिनं धनवर्जितम् ।\nदीर्घायुषमनायुष्कं दुर्धाता भवितव्यता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006271007, "chapter_id": 26271, "verse_number": "३-२५-८", "content_sanskrit": "क्व सत्त्वमस्मद्बाहुनां क्वेयं दुर्ल्ललिता वधूः ।\nअकाण्ड एव विधिना कृतोऽयं निष्ठुरो विधिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006271008, "chapter_id": 26271, "verse_number": "३-२५-९", "content_sanskrit": "सर्पिणीमाययोदग्रास्तंया दुर्घटशौर्यया ।\nअधिसंग्रामभूचक्रे सेनान्यो विनिपातिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006271009, "chapter_id": 26271, "verse_number": "३-२५-१०", "content_sanskrit": "एवमुद्दामदर्पाढ्या वनिता कापि मायिनी ।\nयदि संप्रहरत्यस्मान्धिग्बलं नो भुजार्जितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006271010, "chapter_id": 26271, "verse_number": "३-२५-११", "content_sanskrit": "इमं प्रसंगं वक्तुं च जिह्वा जिह्वेति मामकी ।\nवनिता किमु मत्सैन्यं मर्द यिष्यति दुर्मदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006271011, "chapter_id": 26271, "verse_number": "३-२५-१२", "content_sanskrit": "तदत्र मूलच्छेदाय तस्या यत्नो विधीयताम् ।\nमया चारमुखाज्ज्ञाता तस्या वृत्तिर्महाबला ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006271012, "chapter_id": 26271, "verse_number": "३-२५-१३", "content_sanskrit": "सर्वेषामपि सैन्यानां पश्चादेवावतिष्ठते ।\nअग्रतश्चलितं सैन्यं हयहस्तिरथादिकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006271013, "chapter_id": 26271, "verse_number": "३-२५-१४", "content_sanskrit": "अस्मिन्नेव ह्यवसरे पार्ष्णिग्राहो विधीयताम् ।\nपार्ष्णिग्रहमिमं कर्तुं विषङ्गश्चतुरो भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006271014, "chapter_id": 26271, "verse_number": "३-२५-१५", "content_sanskrit": "तेन प्रौढमदोन्मता बहुसंग्रामदुर्मदाः ।\nदश पञ्च च सेनान्यः सह यान्तु युयुत्सया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006271015, "chapter_id": 26271, "verse_number": "३-२५-१६", "content_sanskrit": "पृष्ठतः परिवारास्तु न तथा संति ते पुनः ।\nअल्पैस्तु रक्षिता वै स्यात्तेनैवासौ सुनिग्रहा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006271016, "chapter_id": 26271, "verse_number": "३-२५-१७", "content_sanskrit": "अतस्त्वं बहुसन्नाहमाविधाय मदोत्कटः ।\nविषङ्ग गुप्तरूपेण पार्ष्णिग्राहं समाचर ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006271017, "chapter_id": 26271, "verse_number": "३-२५-१८", "content_sanskrit": "अल्पीयसी त्वया सार्द्धं सेना गच्छतु विक्रमात् ।\nसज्जाश्च लन्तु सेनान्यो दिक्पालविजयोद्धताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006271018, "chapter_id": 26271, "verse_number": "३-२५-१९", "content_sanskrit": "अक्षौहिण्यश्च सेनानां दश पञ्च चलन्तु ते ।\nत्वं गुप्तवेषस्तां दुष्टां सन्निपत्य दृढं जहि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006271019, "chapter_id": 26271, "verse_number": "३-२५-२०", "content_sanskrit": "सैव निःशेषशक्तीनां मूलभूता महीयसी ।\nतस्याः समूलनाशेन शक्तिवृन्दं विनश्यति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006271020, "chapter_id": 26271, "verse_number": "३-२५-२१", "content_sanskrit": "कन्दच्छेदे सरोजिन्या दलजालमिवांभसि ।\nसर्वेषामेव पश्चाद्यो रथश्चलति भासुरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006271021, "chapter_id": 26271, "verse_number": "३-२५-२२", "content_sanskrit": "दशयोजनसंपन्ननिजदेहसमुच्छ्रयः ।\nमहामुक्तातपत्रेण सर्वोद्ध्व परिशोभितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006271022, "chapter_id": 26271, "verse_number": "३-२५-२३", "content_sanskrit": "वहन्मुहर्वीज्यमानं चामराणां चतुष्टयम् ।\nउत्तङ्गकेतुसंघातलिखितांबुदमण्डलः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006271023, "chapter_id": 26271, "verse_number": "३-२५-२४", "content_sanskrit": "तस्मिन्रथे समायाति सा दृष्टा हरिणेक्षणा ।\nनिबृतं संनिपत्य त्वं चिह्नेनानेन लक्षिताम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006271024, "chapter_id": 26271, "verse_number": "३-२५-२५", "content_sanskrit": "तां विजित्य दुराचारां केशेष्वा कृष्य मर्दय ।\nपुरतश्चलिते सैन्ये सत्त्वशालिनि सा वधूः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006271025, "chapter_id": 26271, "verse_number": "३-२५-२६", "content_sanskrit": "स्त्रीमात्ररक्षा भवतो वशमेष्यति सत्त्वरम् ।\nभवत्सहायभूतायां सेनेन्द्राणामिहाभिधा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006271026, "chapter_id": 26271, "verse_number": "३-२५-२७", "content_sanskrit": "शृणु यैर्भवतो युद्धे साह्यकार्यमतन्द्रितैः ।\nआद्यो मदनको नाम दीर्घजिह्वो द्वितीयकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006271027, "chapter_id": 26271, "verse_number": "३-२५-२८", "content_sanskrit": "हुबको हुलुमुलुश्च कक्लसः कक्लिवाहनः ।\nथुक्लसः पुण्ड्रकेतुश्च चण्डबाहुश्च कुक्कुरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006271028, "chapter_id": 26271, "verse_number": "३-२५-२९", "content_sanskrit": "जंबुकाक्षो जंभनश्च तीक्ष्णशृङ्गस्त्रिकण्टकः ।\nचन्द्रगुप्तश्च पञ्चैते दश चोक्ताश्चमूवराः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006271029, "chapter_id": 26271, "verse_number": "३-२५-३०", "content_sanskrit": "एकैकाक्षौहिणीयुक्ताः प्रत्येकं भवता सह ।\nआगमिष्यन्ति सेनान्यो दमनाद्या महाबलाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006271030, "chapter_id": 26271, "verse_number": "३-२५-३१", "content_sanskrit": "परस्य कटकं नैव यथा जानाति ते गतिम् ।\nतथा गुप्तसमाचारः पार्ष्णिग्राहं समाचर ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006271031, "chapter_id": 26271, "verse_number": "३-२५-३२", "content_sanskrit": "अस्मिन्कार्ये सुमहतां प्रौढिमानं समुद्वहन् ।\nनिषङ्ग त्वं हि तभसे जयसिद्धिमनुत्तमाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006271032, "chapter_id": 26271, "verse_number": "३-२५-३३", "content_sanskrit": "इति मन्त्रितमन्त्रोऽयं दुर्मन्त्री भण्डदानवः ।\nविषङ्गं प्रेषयामास रक्षितं सैन्यपालकैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006271033, "chapter_id": 26271, "verse_number": "३-२५-३४", "content_sanskrit": "अथ श्रीललितादेव्याः पार्ष्णिग्राहकृतोद्यमे ।\nयुवराजानुजे दैत्ये सूर्योऽस्तगिरिमाययौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006271034, "chapter_id": 26271, "verse_number": "३-२५-३५", "content_sanskrit": "प्रथमे युद्धदिवसे व्यतीते लोकभीषणे ।\nअन्धकारः समभवत्तस्य बाह्यचिकीर्षया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006271035, "chapter_id": 26271, "verse_number": "३-२५-३६", "content_sanskrit": "महिषस्कन्धधूम्राभं वनक्रोडवपुर्द्दुति ।\nनीलकण्ठनिभच्छायं निबिडं पप्रथे तमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006271036, "chapter_id": 26271, "verse_number": "३-२५-३७", "content_sanskrit": "कुञ्जेषु पिण्डितमिव प्रधावदिव संधिषु ।\nउज्जिहानमिव क्षोणीविवरेभ्यः सहस्रशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006271037, "chapter_id": 26271, "verse_number": "३-२५-३८", "content_sanskrit": "निर्गच्छदिव शैलानां भूरि कन्दरमन्दिरात् ।\nक्वचिद्दीपप्रभाजाले कृतकातरचेष्टितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006271038, "chapter_id": 26271, "verse_number": "३-२५-३९", "content_sanskrit": "दत्तावलंबनमिव स्त्रीणां कर्णोत्पलत्विषि ।\nएकीभूतमिव प्रौढदिङ्नागमिव कज्जले ।\nआबद्धमैत्रकमिव स्फुरच्छाद्वलमण्डले ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006271039, "chapter_id": 26271, "verse_number": "३-२५-४०", "content_sanskrit": "कृतप्रियाश्लेषमिव स्फुरन्तीष्वसियष्टिषु ।\nगुप्तप्रविष्टमिव च श्यामासु वनपङ्क्तिषु ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006271040, "chapter_id": 26271, "verse_number": "३-२५-४१", "content_sanskrit": "क्रमेण बहुलीभूतं प्रससार महत्तमः ।\nत्रियामावामनयना नीलकञ्चुकरोचिषा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006271041, "chapter_id": 26271, "verse_number": "३-२५-४२", "content_sanskrit": "तिमिरेणावृतं विश्वं न किञ्चित्प्रत्यपद्यत ।\nअसुराणां प्रदुष्टानां रात्रिरेव बलावहा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006271042, "chapter_id": 26271, "verse_number": "३-२५-४३", "content_sanskrit": "तेषां मायाविलासोऽयं तस्यामेव हि वर्धते ।\nअथ प्रचलितं सैन्यं विषङ्गेण महौजसा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006271043, "chapter_id": 26271, "verse_number": "३-२५-४४", "content_sanskrit": "धौतखड्गलताच्छायावर्धिष्णु तिमिरच्छटम् ।\nदमनाद्याश्च सेनान्यः श्मामकङ्कटधारिणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006271044, "chapter_id": 26271, "verse_number": "३-२५-४५", "content_sanskrit": "श्यामोष्णीषधराः श्यामवर्णसर्वपरिच्छदाः ।\nएकत्वमिव संप्राप्तास्तिमिरेणातिभूयसा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006271045, "chapter_id": 26271, "verse_number": "३-२५-४६", "content_sanskrit": "विषङ्गमनुसंचेलुः कृताग्रजनमस्कृतिम् ।\nकूटेन युद्धकृत्येन विजिगीषुर्महेश्वरीम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006271046, "chapter_id": 26271, "verse_number": "३-२५-४७", "content_sanskrit": "मेघडंबरकं नाम दधे वक्षसि कङ्कटम् ।\nयथा तस्य निशायुद्धानुरूपो वेषसंग्रहः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006271047, "chapter_id": 26271, "verse_number": "३-२५-४८", "content_sanskrit": "तथा कृतवती सेना श्यामलं कञ्चुकादिकम् ।\nन च दुन्दुभिनिस्वानो न च मर्द्दलगर्जितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006271048, "chapter_id": 26271, "verse_number": "३-२५-४९", "content_sanskrit": "पणवानकभेरीणां न च घोषविजृंभणम् ।\nगुप्ताचाराः प्रचलितास्तिमिरेण समावृताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006271049, "chapter_id": 26271, "verse_number": "३-२५-५०", "content_sanskrit": "परैरदृश्यगतयो विष्कोशीकृतरिष्टयः ।\nपश्चिमाभिमुखं यान्ति ललितायाः पताकिनीम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006271050, "chapter_id": 26271, "verse_number": "३-२५-५१", "content_sanskrit": "आवृतोत्तरमार्गेण पूर्वभागमशिश्रियन् ।\nनिश्वासमपि सस्वानमकुर्वन्तः पदेपदे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006271051, "chapter_id": 26271, "verse_number": "३-२५-५२", "content_sanskrit": "सावधानाः प्रचलिताः पार्ष्णिग्राहाय दानवाः ।\nभूयः पुरस्य दिग्भागं गत्वा मन्दपराक्रमाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006271052, "chapter_id": 26271, "verse_number": "३-२५-५३", "content_sanskrit": "ललितासैन्यमेव स्वान्सूचयन्तः प्रपृच्छतः ।\nआगत्य निभृतं पृष्ठे कवचच्छन्नविग्रहाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006271053, "chapter_id": 26271, "verse_number": "३-२५-५४", "content_sanskrit": "चक्रराजरथं तुङ्गं मेरुमन्दरसंनिभम् ।\nअपश्यन्नतिदीप्ताभिः शक्तिभिः परिवारितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006271054, "chapter_id": 26271, "verse_number": "३-२५-५५", "content_sanskrit": "तत्र मुक्तातपत्रस्य वर्त्तमानामधःस्थले ।\nसहस्रादित्यसंकाशां पश्चिमाभिमुखीं स्थिताम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006271055, "chapter_id": 26271, "verse_number": "३-२५-५६", "content_sanskrit": "कामेश्वर्यादिनित्याभिः स्वसमानसमृद्धिभिः ।\nनर्मालापविनोदेन सेव्यमानां रथोत्तमे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006271056, "chapter_id": 26271, "verse_number": "३-२५-५७", "content_sanskrit": "तां तथाभूतवृत्तान्ताम तादृशरणोद्यमाम् ।\nपुरोगतं महत्सैन्यं वीक्षमाण सकौतुकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006271057, "chapter_id": 26271, "verse_number": "३-२५-५८", "content_sanskrit": "मन्वानश्च हि तामेव विषङ्गः सुदुराशयः ।\nपृष्ठवंशे रथेन्द्रस्य घट्टयामास सैनिकैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006271058, "chapter_id": 26271, "verse_number": "३-२५-५९", "content_sanskrit": "तत्राणि मादिशक्तीनां परिवारवरूथिनी ।\nमहाकलकलं चक्रुरणिमाद्याः परःशतम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006271059, "chapter_id": 26271, "verse_number": "३-२५-६०", "content_sanskrit": "पट्टिशैर्द्रुघणैश्चैव भिन्दिपालैर्भुशुण्डिभिः ।\nकठोरवज्रनिर्धातनिष्ठुरैः शक्तिमण्डलैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006271060, "chapter_id": 26271, "verse_number": "३-२५-६१", "content_sanskrit": "मर्दयन्तो महासत्त्वाः समरं बहुमेनिरे ।\nआकस्मिकरणोत्साहविपर्याविष्टविग्रहम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006271061, "chapter_id": 26271, "verse_number": "३-२५-६२", "content_sanskrit": "अकाण्डक्षुभितं चासीद्रथस्थं शक्तिमण्डलम् ।\nविपाटैः पाटयामासुरदृश्यैरन्धकारिणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006271062, "chapter_id": 26271, "verse_number": "३-२५-६३", "content_sanskrit": "ततश्चक्ररथेन्द्रस्य नवमे पर्वणि स्थिताः ।\nअदृश्यमानशस्त्राणामदृश्यनिजवर्मणाम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006271063, "chapter_id": 26271, "verse_number": "३-२५-६४", "content_sanskrit": "तिमिरच्छन्नरूपाणां दानवानां शिलीमुखैः ।\nइतस्ततो बहु क्लिष्टं छन्नवर्मितमर्मवत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006271064, "chapter_id": 26271, "verse_number": "३-२५-६५", "content_sanskrit": "शक्तीनां मण्डलं तेने क्रन्दनं ललितां प्रति ।\nपूर्वानुक्रम तस्तत्र संप्राप्तं सुमहद्भयम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006271065, "chapter_id": 26271, "verse_number": "३-२५-६६", "content_sanskrit": "कर्णाकर्णिकयाकर्ण्य ललिता कोपमादधे ।\nएतस्मिन्नन्तरे भण्डश्चण्डदुर्मत्रिपण्डितः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006271066, "chapter_id": 26271, "verse_number": "३-२५-६७", "content_sanskrit": "दशाक्षौहिणिकायुक्तं कुटिलाक्षं महौजसम् ।\nललितासैन्यनाशाय युद्धाय प्रजिघाय सः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006271067, "chapter_id": 26271, "verse_number": "३-२५-६८", "content_sanskrit": "यथा पश्चात्कलकलं श्रुत्वाग्रेवर्तिनी चमूः ।\nनागच्छति तथा चक्रे कुटिलाक्षो महारणम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006271068, "chapter_id": 26271, "verse_number": "३-२५-६९", "content_sanskrit": "एवं चोभयतो युद्धं पश्चादग्रे तथाभवत् ।\nअत्यन्ततुमुलं चासीच्छक्तीनां सैनिके महत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006271069, "chapter_id": 26271, "verse_number": "३-२५-७०", "content_sanskrit": "नक्तसत्त्वाश्च दैत्येन्द्रास्तिमिरेण समावृताः ।\nइतस्ततः शिथिलतां कण्टके निन्युरुद्धताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006271070, "chapter_id": 26271, "verse_number": "३-२५-७१", "content_sanskrit": "निषङ्गेण दुराशेन धमनाद्यैश्चमूवरैः ।\nचमूभिश्च प्रणहिता न्यपतञ्छत्रुकोटयः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006271071, "chapter_id": 26271, "verse_number": "३-२५-७२", "content_sanskrit": "ताभिर्दैत्यास्त्रमालाभिश्चक्रराजरथो वृतः ।\nबकावलीनिबिडतः शैलराज इवाबभौ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006271072, "chapter_id": 26271, "verse_number": "३-२५-७३", "content_sanskrit": "आक्रान्तपर्वणाधस्ताद्विषङ्गेण दुरात्मना ।\nमुक्त एकः शरोदेव्यास्तालवृन्तमचूर्णयत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006271073, "chapter_id": 26271, "verse_number": "३-२५-७४", "content_sanskrit": "अथ तेनाव्याहितेन संभ्रान्ते शक्तिमण्डले ।\nकामेश्वरीमुखा नित्या महान्तं क्रोधमाययुः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006271074, "chapter_id": 26271, "verse_number": "३-२५-७५", "content_sanskrit": "ईषद्भृकुटिसंसक्तं श्रीदेव्या वदनांबुजम् ।\nअवलोक्य भृशोद्विग्ना नित्या दधुरतिश्रमम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006271075, "chapter_id": 26271, "verse_number": "३-२५-७६", "content_sanskrit": "नित्या कालस्वरूपिण्यः प्रत्येकं तिथिविग्रहाः ।\nक्रोधमुद्वीक्ष्य सन्नाज्ञ्या युद्धाय दधुरुद्यमम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006271076, "chapter_id": 26271, "verse_number": "३-२५-७७", "content_sanskrit": "प्रणिपत्य च तां देवीं महाराज्ञीं महोदयाम् ।\nऊचुर्वाचमकाण्डोत्थां युद्धकौतुकगद्गदाम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006271077, "chapter_id": 26271, "verse_number": "३-२५-७८", "content_sanskrit": "तिथिनित्या उचुः ।\nदेवदेवी महाराज्ञी तवाग्रे ब्रेक्षितां चमूम् ।\nदण्डिनीमन्त्रनाथादिमहाशक्त्याभपालिताम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006271078, "chapter_id": 26271, "verse_number": "३-२५-७९", "content_sanskrit": "धर्षितु कातरा दुष्टा मायाच्छद्मपरायणाः ।\nपार्ष्णिग्राहेण युद्धेन बाधन्ते रथपुङ्गवम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006271079, "chapter_id": 26271, "verse_number": "३-२५-८०", "content_sanskrit": "तस्मात्तिमिरसंछन्नमूर्तीनां विबुधद्रुहाम् ।\nशमयामो वयं दर्पं क्षणमात्रं विलोकय ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006271080, "chapter_id": 26271, "verse_number": "३-२५-८१", "content_sanskrit": "या वह्निवासिनी नित्या या ज्वालामालिनी परा ।\nताभ्यां प्रदीपिते युद्धे द्रष्टुं शक्ताः सुरद्विषः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006271081, "chapter_id": 26271, "verse_number": "३-२५-८२", "content_sanskrit": "प्रशमय्य महादर्पं पार्ष्णिग्राहप्रवर्तिनाम् ।\nसहसैवागमिष्यामः सेवितुं श्रीपदांबुजम् ।\nआज्ञां देहि महाराज्ञि मर्दनार्थं दुरात्मनाम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006271082, "chapter_id": 26271, "verse_number": "३-२५-८३", "content_sanskrit": "इत्युक्ते सति नित्याभिस्तथास्त्विति जगाद सा ।\nअथ कामेश्वरी नित्या प्रणम्य ललितेश्वरीम् ।\nतया संप्रेषिता ताभिः कुण्डलीकृत कार्मुका ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006271083, "chapter_id": 26271, "verse_number": "३-२५-८४", "content_sanskrit": "सा हन्तुं तान्दुराचारान्कूटयुद्धकृतक्षणान् ।\nबालारुणमिव क्रोधारुणं वक्त्रं वितन्वती ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006271084, "chapter_id": 26271, "verse_number": "३-२५-८५", "content_sanskrit": "रे रे तिष्ठत पापिष्ठा मायानिष्ठाश्छिनद्मि वः ।\nअन्धकारमनुप्राप्य कूटयुद्धपरायणाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006271085, "chapter_id": 26271, "verse_number": "३-२५-८६", "content_sanskrit": "इति तान्भर्त्सयन्ती सा तूणीरोत्खातसायकात् ।\nपर्वावरोहणं चक्रे क्रोधेन प्रस्खलद्गतिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006271086, "chapter_id": 26271, "verse_number": "३-२५-८७", "content_sanskrit": "सज्जकार्मुकहस्ताश्च भगमालापुरःसराः ।\nअन्याश्च चरिता नित्याः कृत पर्वावरोहणाः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006271087, "chapter_id": 26271, "verse_number": "३-२५-८८", "content_sanskrit": "ज्वालामालिनि नित्या च या नित्या वह्निवासिनी ।\nसज्जे युद्धे स्वतेजोभिः समदीपयतां रणे ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006271088, "chapter_id": 26271, "verse_number": "३-२५-८९", "content_sanskrit": "अथ ते दुष्टदनुजाः प्रदीप्ते युद्धमण्डले ।\nप्रकाशवपुषस्तत्र मरान्तं क्रोधमाययुः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006271089, "chapter_id": 26271, "verse_number": "३-२५-९०", "content_sanskrit": "कामेश्वर्यादिका नित्यास्ताः पञ्चदश सायुधाः ।\nससिंहनादास्तान्दैत्यानमृद्नन्नेव हेलया ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006271090, "chapter_id": 26271, "verse_number": "३-२५-९१", "content_sanskrit": "महाकलकलस्तत्र समभूद्युद्धसीमनि ।\nमन्दरक्षोभितांभोदिवेल्लत्कल्लोलमण्डलः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006271091, "chapter_id": 26271, "verse_number": "३-२५-९२", "content_sanskrit": "ताश्च नित्यावलत्क्वाणकङ्कणैर्युधि पाणिभिः ।\nआकृष्य प्रामकोदण्डास्तेनिरे युद्धमुद्धतम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006271092, "chapter_id": 26271, "verse_number": "३-२५-९३", "content_sanskrit": "यामत्रितयपर्यन्तमेवं युद्धमवर्त्तत ।\nनित्यानां निशितैर्बाणैरक्षौहिण्यश्च संहृताः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006271093, "chapter_id": 26271, "verse_number": "३-२५-९४", "content_sanskrit": "जघान दमनं दुष्टं कामेशी प्रथमं शरैः ।\nदीर्घजिह्वं चमूनाथं भगमाला व्यदारत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006271094, "chapter_id": 26271, "verse_number": "३-२५-९५", "content_sanskrit": "नित्यक्लिन्ना च भेरुण्डा हुम्बेकं हुलुमल्लकम् ।\nकक्लसं वह्निवासा च निजघान शरैः शतैः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006271095, "chapter_id": 26271, "verse_number": "३-२५-९६", "content_sanskrit": "महावज्रेश्वरी बाणैरभिनत्केकिवाहनम् ।\nपुक्लसं शिवदूती च प्राहिणोद्यमसादनम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006271096, "chapter_id": 26271, "verse_number": "३-२५-९७", "content_sanskrit": "पुण्ड्रकेतुं भुजोद्दण्डं त्वरिता समदारयत् ।\nकुलसुन्दरिका नित्या चण्डबाहुं च कुक्कुरम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006271097, "chapter_id": 26271, "verse_number": "३-२५-९८", "content_sanskrit": "अथ निलपताका च विजया च जयोद्धते ।\nजंबुकाक्षं जृंभणं च व्यतन्वातां रणे बलिम् ।\nसर्वमङ्गलिका नित्या तीक्ष्णशृङ्गमखण्डयत् ।\nज्वालामालिनिका नित्या जघानोग्रं त्रिकर्णकम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006271098, "chapter_id": 26271, "verse_number": "३-२५-९९", "content_sanskrit": "चन्द्रगुप्तं च दुःशीलं चित्रं चित्रा व्यदारत् ।\nसेनानाथेषु सर्वेषु निहतेषु दुरात्मसु ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006271099, "chapter_id": 26271, "verse_number": "३-२५-१००", "content_sanskrit": "विषङ्गः परमः कुद्धश्चचाल पुरतो बली ।\nअथ यामावशेषायां यामिन्यां घटिकाद्वयम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006271100, "chapter_id": 26271, "verse_number": "३-२५-१०१", "content_sanskrit": "नित्याभिः सह संग्रामं विधाय स दुराशयः ।\nअशक्यत्वं समुद्दिश्य चक्राम प्रपलायितुम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006271101, "chapter_id": 26271, "verse_number": "३-२५-१०२", "content_sanskrit": "कामेश्वरीकराकृष्टचापोत्थौर्निशितैः शरैः ।\nभिन्नवर्मा दृढतरं विषङ्गो विह्वलाशयः ।\nहतावशिष्टैर्योधैश्च सार्धमेव पलायितः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006271102, "chapter_id": 26271, "verse_number": "३-२५-१०३", "content_sanskrit": "ताभिर्न निहतो दुष्टो यस्माद्वध्यः स दानवः ।\nदण्डनाथाशरेणैव कालदण्डसमत्विषा ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006271103, "chapter_id": 26271, "verse_number": "३-२५-१०४", "content_sanskrit": "तस्मिन्पलायिते दुष्टे विषङ्गे भण्डसोदरे ।\nसा विभाता च रजनी प्रसन्नाश्चाभवन्दिशः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006271104, "chapter_id": 26271, "verse_number": "३-२५-१०५", "content_sanskrit": "पलायितं रणेवीरमनुसर्त्तुमनौचिती ।\nइति ताः समरान्नित्यास्तस्मिन्काले व्यरंसिषुः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006271105, "chapter_id": 26271, "verse_number": "३-२५-१०६", "content_sanskrit": "दैत्यशस्त्रव्रणस्यन्दिशोणितप्लुतविग्रहाः ।\nनित्याः श्रीललितां देवीं प्रणिपेतुर्जयोद्धताः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006271106, "chapter_id": 26271, "verse_number": "३-२५-१०७", "content_sanskrit": "इत्थं रात्रौ महद्युद्धं तत्र जातं भयङ्करम् ।\nनित्यानां रूपजालं च शस्त्रक्षतमलोकयत् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006271107, "chapter_id": 26271, "verse_number": "३-२५-१०८", "content_sanskrit": "श्रुत्वोदन्तं महाराज्ञी कृपापाङ्गेन सैक्षत ।\nतदालोकनमात्रेण व्रणो निर्व्रणतामगात् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006271108, "chapter_id": 26271, "verse_number": "३-२५-१०९", "content_sanskrit": "नित्यानां विक्रमैश्चापि ललिता प्रीतिमासदत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}]