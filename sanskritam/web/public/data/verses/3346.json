[{"id": 2108366, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108367, "chapter_id": 3346, "verse_number": "१", "content_sanskrit": "स्पृष्टमात्रेण पद्भ्यां सा गरुडेन बलीयसा ।\nअभज्यत तरोः शाखा भग्नां चैनामधारयत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108368, "chapter_id": 3346, "verse_number": "२", "content_sanskrit": "तां भङ्क्त्वा महतीं शाखां विस्मयात् समलोकयन् ।\nअथाऽत्र लम्बतोऽपश्यद् वालखिल्यांस्त्वधोमुखान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108369, "chapter_id": 3346, "verse_number": "३", "content_sanskrit": "वैखानसांश्च शाखायां लम्बमानानवाङ्मुखान् ।\nस तद्विनाशसंत्रासादनुपश्यन् खगाधिपः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108370, "chapter_id": 3346, "verse_number": "४", "content_sanskrit": "शाखामास्येन जगृहे तेषामेवानुकम्पया ।\nशनैः पर्यचरत् पक्षी पर्वतान् प्रविचालयन् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108371, "chapter_id": 3346, "verse_number": "५", "content_sanskrit": "एवं सोऽभ्यपतद् देशान् पक्षी सगजकच्छपः ।\nयदर्थं वालखिल्यानां नावस्थानमविन्दत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108372, "chapter_id": 3346, "verse_number": "६", "content_sanskrit": "स गत्वा पर्वतश्रेष्ठं गन्धमादनमव्ययम् ।\nददर्श काश्यपं तत्र पितरं संशितव्रतम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108373, "chapter_id": 3346, "verse_number": "७", "content_sanskrit": "ददर्श तं पिता चापि दिव्यरूपं विहङ्गमम् ।\nतेजोवीर्यबलोपेतं मनोमारुतरंहसम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108374, "chapter_id": 3346, "verse_number": "८", "content_sanskrit": "शैलशृङ्गप्रतीकाशं ब्रह्मदण्डमिवोद्यतम् ।\nअचिन्त्यमनभिज्ञेयं सर्वभूतभयङ्करम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108375, "chapter_id": 3346, "verse_number": "९", "content_sanskrit": "महावीर्यधरं साक्षाद् अग्निमिद्धमिवोद्यतम् ।\nअप्रधृष्यमजेयं च देवदानवराक्षसैः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108376, "chapter_id": 3346, "verse_number": "१०", "content_sanskrit": "भेत्तारं गिरिशृङ्गाणां नदीजलविशोषणम् ।\nलोकसङ्क्षोभणं घोरं कृतान्तसमदर्शनम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108377, "chapter_id": 3346, "verse_number": "११", "content_sanskrit": "तमागतमभिप्रेत्य भगवान् काश्यपस्तदा ।\nविदित्वा चास्य सङ्कल्पमिदं वचनमब्रवीत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108378, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "कश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108379, "chapter_id": 3346, "verse_number": "१२", "content_sanskrit": "पुत्र मा साहसं कार्षीस्त्वं सद्यो लप्स्यसे व्यथाम् ।\nन त्वां दहेयुः सङ्क्रुद्धा वालखिल्या मरीचिपाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108380, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108381, "chapter_id": 3346, "verse_number": "१३", "content_sanskrit": "प्रसादयामास स तान् काश्यपः पुत्रकारणात् ।\nवालखिल्यांस्तपःसिद्धानिदं वचनमब्रवीत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108382, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108383, "chapter_id": 3346, "verse_number": "१४", "content_sanskrit": "प्रजाहितार्थमारम्भो गरुडस्य तपोधनाः ।\nचिकीर्षति महत्कर्म तदनुज्ञातुमर्हथ\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108384, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108385, "chapter_id": 3346, "verse_number": "१५", "content_sanskrit": "एवमुक्त्वा भगवता मुनयस्ते समभ्ययुः ।\nमुक्त्वा शाखां गिरिं पुण्यं हिमवन्तं तपोधनाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108386, "chapter_id": 3346, "verse_number": "१६", "content_sanskrit": "ततस्तेष्वपयातेषु पितरं विनतात्मजः ।\nशाखाव्याक्षिप्तवदनः पर्यपृच्छत काश्यपम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108387, "chapter_id": 3346, "verse_number": "१७", "content_sanskrit": "भगवान् क्व विमुञ्चामि तरुशाखामिमामहम् ।\nवर्जितं ब्राह्मणैर्देशमाख्यातु भगवान् मम\t ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108388, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108389, "chapter_id": 3346, "verse_number": "१८", "content_sanskrit": "ततो निष्पुरुषं शैलं हिमसंरुद्धकन्दरम् ।\nअगम्यं मनसाप्यन्यैस्तस्याचख्यौ स काश्यपः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108390, "chapter_id": 3346, "verse_number": "१९", "content_sanskrit": "तं पर्वतं महाकुक्षिमादिश्य मनसा खगः ।\nजवेनाभ्यपतत् तार्क्ष्यः सशाखागजकच्छपः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108391, "chapter_id": 3346, "verse_number": "२०", "content_sanskrit": "न तां वार्धः परीणाहेच्छतचर्मा महानणुः ।\nशाखिनो महतीं शाखां यां प्रगृह्य ययौ खगः\t ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108392, "chapter_id": 3346, "verse_number": "२१", "content_sanskrit": "ततः शतसहस्रं स योजनान्तरमागतः ।\nकालेन नातिमहता गरुडः पततां वरः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108393, "chapter_id": 3346, "verse_number": "२२", "content_sanskrit": "स तं गत्वा क्षणेनैव पर्वतं वचनात् पितुः ।\nप्रामुञ्चन् महतीं शाखां सस्वनां तत्र खेचरः\t ॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108394, "chapter_id": 3346, "verse_number": "२३", "content_sanskrit": "तस्य पक्षानिलहतः प्राकम्पत स शैलराट् ।\nमुमुचुः पुष्पवर्षं च समागाळितपादपाः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108395, "chapter_id": 3346, "verse_number": "२४", "content_sanskrit": "शृङ्गाणि च व्यशीर्यन्त गिरेस्तस्य समन्ततः ।\nमणिकाञ्चनचित्राणि शोभयन्ति महागिरिम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108396, "chapter_id": 3346, "verse_number": "२५", "content_sanskrit": "शाखिनो बहवश्चापि शाखया निहतास्तया ।\nकाञ्चनैः कुसुमैर्भान्ति विद्युत्वन्त इवाम्बुदाः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108397, "chapter_id": 3346, "verse_number": "२६", "content_sanskrit": "ते हेमरजसा भूयो युक्ताः पर्वतधातुभिः ।\nव्यराजञ्छाखिनस्तत्र सूर्यांशुप्रतिरञ्जिताः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108398, "chapter_id": 3346, "verse_number": "२७", "content_sanskrit": "ततस्तस्य गिरेः शृङ्गं समास्थाय खगोत्तमः ।\nभक्षयामास गरुडस्तावुभौ गजकच्छपौ \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108399, "chapter_id": 3346, "verse_number": "२८", "content_sanskrit": "तावुभौ भक्षयित्वा तु स तार्क्ष्यः कूर्मकुञ्जरौ ।\nततः पर्वतकूटाग्रादुत्पपात मनोजवः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108400, "chapter_id": 3346, "verse_number": "२९", "content_sanskrit": "प्रावर्तन्ताथ देवानामुत्पाता भयवेदिनः ।\nइन्द्रस्य वज्रं दयितं प्रजज्वाल व्यथान्वितम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108401, "chapter_id": 3346, "verse_number": "३०", "content_sanskrit": "सधूमा चापतत् सार्चिर्दिवि चोल्का नभश्च्युता ।\nतथा वसूनां रुद्राणामादित्यानां च सर्वशः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108402, "chapter_id": 3346, "verse_number": "३१", "content_sanskrit": "साध्यानां मरुतां चैव ये चान्ये देवतागणाः ।\nस्वं स्वं प्रहरणं तेषां परस्परमुपाद्रवन्\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108403, "chapter_id": 3346, "verse_number": "३२", "content_sanskrit": "अभूतपूर्वः  सङ्ग्रामो यथा देवासुरेष्वपि ।\nववुर्वाताः सनिर्घाताः पेतुरुल्काः समन्ततः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108404, "chapter_id": 3346, "verse_number": "३३", "content_sanskrit": "निरभ्रमेव चाकाशं प्रजगर्ज महास्वनम् ।\nदेवानामपि यो देवः सोऽप्यवर्षदसृक् तदा \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108405, "chapter_id": 3346, "verse_number": "३४", "content_sanskrit": "मम्लुर्माल्यानि देवानां तेजस्तेजांसि चैव ह ।\nउत्पातमेघा रौद्राश्च ववृषुः शोणितं बहु \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2108406, "chapter_id": 3346, "verse_number": "३५", "content_sanskrit": "रजांसि मकुटांश्चैषामुत्थितानि व्यकर्षयन् ।\nततस्त्राससमुद्विग्नः सह देवैः शतक्रतुः\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2108407, "chapter_id": 3346, "verse_number": "३६", "content_sanskrit": "उत्पातान् दारुणान् पश्यन्नित्युवाच बृहस्पतिम् ।\nकिमर्थं भगवन् घोरा महोत्पाताः समुत्थिताः ।\nन हि पश्यामि शत्रुं मे युधि यो नः प्रधर्षयेत् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2108408, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2108409, "chapter_id": 3346, "verse_number": "३७", "content_sanskrit": "तवापराधाद् देवेश प्रमादाच्च शतक्रतो ।\nतपसा वालखिल्यानां भयमुत्पन्नमद्भुतम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2108410, "chapter_id": 3346, "verse_number": "३८", "content_sanskrit": "काश्यपस्य मुनेः पुत्रो विनतायाः खगेश्वरः ।\nहर्तुं सोममनुप्राप्तो बलवान् कामरूपवान्\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2108411, "chapter_id": 3346, "verse_number": "३९", "content_sanskrit": "समर्थो बलिनां श्रेष्ठो हर्तुं सोममिहागतः ।\nसर्वं सम्भावयाम्यस्मिन्नसाध्यमपि साधयेत् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2108412, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2108413, "chapter_id": 3346, "verse_number": "४०", "content_sanskrit": "श्रुत्वैतद्वचनं शक्रः प्रोवाचामृतरक्षिणः ।\nमहावीर्यबलः पक्षी हर्तुं सोममिहोद्यतः\t ॥ ४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2108414, "chapter_id": 3346, "verse_number": "४१", "content_sanskrit": "युष्मान् सम्बोधयाम्येष यथा न स हरेद् बलात् ।\nअतुलं हि बलं तस्य बृहस्पतिरुवाच मे \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2108415, "chapter_id": 3346, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2108416, "chapter_id": 3346, "verse_number": "४२", "content_sanskrit": "तच्छ्रुत्वा विबुधा वाक्यं विस्मिता यत्नमास्थिताः ।\nपरिवार्यामृतं तस्थुः सर्वे क्षुभितमानसाः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2108417, "chapter_id": 3346, "verse_number": "४३", "content_sanskrit": "धारयन्तो महार्हाणि कवचानि मनस्विनः ।\nकाञ्चनानि विचित्राणि वैढूर्यविकृतानि च\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2108418, "chapter_id": 3346, "verse_number": "४४", "content_sanskrit": "विविधानि च शस्त्राणि समुद्यम्य सहस्रशः ।\nसिततीक्ष्णोग्रधाराणि समुद्यम्य सहस्रशः\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2108419, "chapter_id": 3346, "verse_number": "४५", "content_sanskrit": "सविष्फुलिङ्गज्वालानि घोररूपाण्यनेकशः ।\nचक्राणि परिघांश्चैव त्रिशूलानि परश्वधान् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2108420, "chapter_id": 3346, "verse_number": "४६", "content_sanskrit": "शक्तीश्च विमलास्तीक्ष्णाः करवाळांश्च निर्मलान् ।\nस्वदेहरूपाण्यादाय गदाश्चोग्रप्रदर्शनाः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2108421, "chapter_id": 3346, "verse_number": "४६", "content_sanskrit": "तैः शस्त्रैर्भानुमद्भिस्ते दिव्याभरणभूषिताः ।\nभानुमन्तः सुरगणास्तस्थुर्विगतकल्मषाः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2108422, "chapter_id": 3346, "verse_number": "४७", "content_sanskrit": "अनुपमबलवीर्यतेजसो\nधृतमनसः परिरक्षणेऽमृतस्य ।\nअसुरपुरविदारणाः सुरास्ते\nज्वलनसमिद्धवपुःप्रकाशिनः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2108423, "chapter_id": 3346, "verse_number": "समाप्तिः", "content_sanskrit": "इति समरपरं सुरास्थितं\nपरिघसहस्रशतैः समाकुलम् ।\nविगळितमिव चाम्बरान्तरं\nतपनमरीचिभिरार्चितं बभौ\t ॥ ४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2108424, "chapter_id": 3346, "verse_number": "१३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि पञ्चविंशोऽध्यायः ॥२५॥ ॥ आस्तीकपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]