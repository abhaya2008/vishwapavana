[{"id": 5000219000, "chapter_id": 9219, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000219001, "chapter_id": 9219, "verse_number": "३-२३-१", "content_sanskrit": "तत्प्रयातं बलं घोरमशिवं शोणितोदकम्।\nअभ्यवर्षन्महाघोरस्तुमुलो गर्दभारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000219002, "chapter_id": 9219, "verse_number": "३-२३-२", "content_sanskrit": "निपेतुस्तुरगास्तस्य रथयुक्ता महाजवाः।\nसमे पुष्पचिते देशे राजमार्गे यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000219003, "chapter_id": 9219, "verse_number": "३-२३-३", "content_sanskrit": "श्यामं रुधिरपर्यन्तं बभूव परिवेषणम्।\nअलातचक्रप्रतिमं प्रतिगृह्य दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000219004, "chapter_id": 9219, "verse_number": "३-२३-४", "content_sanskrit": "ततो ध्वजमुपागम्य हेमदण्डं समुच्छ्रितम्।\nसमाक्रम्य महाकायस्तस्थौ गृध्रः सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000219005, "chapter_id": 9219, "verse_number": "३-२३-५", "content_sanskrit": "जनस्थानसमीपे च समाक्रम्य खरस्वनाः।\nविस्वरान् विविधान् नादान् मांसादा मृगपक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000219006, "chapter_id": 9219, "verse_number": "३-२३-६", "content_sanskrit": "व्याजह्रुरभिदीप्तायां दिशि वै भैरवस्वनम्।\nअशिवं यातुधानानां शिवा घोरा महास्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000219007, "chapter_id": 9219, "verse_number": "३-२३-७", "content_sanskrit": "प्रभिन्नगजसंकाशास्तोयशोणितधारिणः।\nआकाशं तदनाकाशं चक्रुर्भीमाम्बुवाहकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000219008, "chapter_id": 9219, "verse_number": "३-२३-८", "content_sanskrit": "बभूव तिमिरं घोरमुद्धतं रोमहर्षणम्।\nदिशो वा प्रदिशो वापि सुव्यक्तं न चकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000219009, "chapter_id": 9219, "verse_number": "३-२३-९", "content_sanskrit": "क्षतजार्द्रसवर्णाभा संध्या कालं विना बभौ।\nखरं चाभिमुखं नेदुस्तदा घोरा मृगाः खगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000219010, "chapter_id": 9219, "verse_number": "३-२३-१०", "content_sanskrit": "कङ्कगोमायुगृध्राश्च चुक्रुशुर्भयशंसिनः।\nनित्याशिवकरा युद्धे शिवा घोरनिदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000219011, "chapter_id": 9219, "verse_number": "३-२३-११", "content_sanskrit": "नेदुर्बलस्याभिमुखं ज्वालोद‍्गारिभिराननैः।\nकबन्धः परिघाभासो दृश्यते भास्करान्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000219012, "chapter_id": 9219, "verse_number": "३-२३-१२", "content_sanskrit": "जग्राह सूर्यं स्वर्भानुरपर्वणि महाग्रहः।\nप्रवाति मारुतः शीघ्रं निष्प्रभोऽभूद् दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000219013, "chapter_id": 9219, "verse_number": "३-२३-१३", "content_sanskrit": "उत्पेतुश्च विना रात्रिं ताराः खद्योतसप्रभाः।\nसंलीनमीनविहगा नलिन्यः शुष्कपङ्कजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000219014, "chapter_id": 9219, "verse_number": "३-२३-१४", "content_sanskrit": "तस्मिन् क्षणे बभूवुश्च विना पुष्पफलैर्द्रुमाः।\nउद‍्धूतश्च विना वातं रेणुर्जलधरारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000219015, "chapter_id": 9219, "verse_number": "३-२३-१५", "content_sanskrit": "चीचीकूचीति वाश्यन्त्यो बभूवुस्तत्र सारिकाः।\nउल्काश्चापि सनिर्घोषा निपेतुर्घोरदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000219016, "chapter_id": 9219, "verse_number": "३-२३-१६", "content_sanskrit": "प्रचचाल मही चापि सशैलवनकानना।\nखरस्य च रथस्थस्य नर्दमानस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000219017, "chapter_id": 9219, "verse_number": "३-२३-१७", "content_sanskrit": "प्राकम्पत भुजः सव्यः स्वरश्चास्यावसज्जत।\nसास्रा सम्पद्यते दृष्टिः पश्यमानस्य सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000219018, "chapter_id": 9219, "verse_number": "३-२३-१८", "content_sanskrit": "ललाटे च रुजो जाता न च मोहान्न्यवर्तत।\nतान् समीक्ष्य महोत्पातानुत्थितान् रोमहर्षणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000219019, "chapter_id": 9219, "verse_number": "३-२३-१९", "content_sanskrit": "अब्रवीद् राक्षसान् सर्वान् प्रहसन् स खरस्तदा।\nमहोत्पातानिमान् सर्वानुत्थितान् घोरदर्शनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000219020, "chapter_id": 9219, "verse_number": "३-२३-२०", "content_sanskrit": "न चिन्तयाम्यहं वीर्याद् बलवान् दुर्बलानिव।\nतारा अपि शरैस्तीक्ष्णैः पातयेयं नभस्तलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000219021, "chapter_id": 9219, "verse_number": "३-२३-२१", "content_sanskrit": "मृत्युं मरणधर्मेण संक्रुद्धो योजयाम्यहम्।\nराघवं तं बलोत्सिक्तं भ्रातरं चापि लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000219022, "chapter_id": 9219, "verse_number": "३-२३-२२", "content_sanskrit": "अहत्वा सायकैस्तीक्ष्णैर्नोपावर्तितुमुत्सहे।\nयन्निमित्तं तु रामस्य लक्ष्मणस्य विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000219023, "chapter_id": 9219, "verse_number": "३-२३-२३", "content_sanskrit": "सकामा भगिनीमेऽस्तु पीत्वा तु रुधिरं तयोः।\nन क्वचित् प्राप्तपूर्वो मे संयुगेषु पराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000219024, "chapter_id": 9219, "verse_number": "३-२३-२४", "content_sanskrit": "युष्माकमेतत् प्रत्यक्षं नानृतं कथयाम्यहम्।\nदेवराजमपि क्रुद्धो मत्तैरावतगामिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000219025, "chapter_id": 9219, "verse_number": "३-२३-२५", "content_sanskrit": "वज्रहस्तं रणे हन्यां किं पुनस्तौ च मानवौ।\nसा तस्य गर्जितं श्रुत्वा राक्षसानां महाचमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000219026, "chapter_id": 9219, "verse_number": "३-२३-२६", "content_sanskrit": "प्रहर्षमतुलं लेभे मृत्युपाशावपाशिता।\nसमेयुश्च महात्मानो युद्धदर्शनकांक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000219027, "chapter_id": 9219, "verse_number": "३-२३-२७", "content_sanskrit": "ऋषयो देवगन्धर्वाः सिद्धाश्च सह चारणैः।\nसमेत्य चोचुः सहितास्तेऽन्योन्यं पुण्यकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000219028, "chapter_id": 9219, "verse_number": "३-२३-२८", "content_sanskrit": "स्वस्ति गोब्राह्मणेभ्यस्तु लोकानां ये च सम्मताः।\nजयतां राघवो युद्धे पौलस्त्यान् रजनीचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000219029, "chapter_id": 9219, "verse_number": "३-२३-२९", "content_sanskrit": "चक्रहस्तो यथा विष्णुः सर्वानसुरसत्तमान्।\nएतच्चान्यच्च बहुशो ब्रुवाणाः परमर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000219030, "chapter_id": 9219, "verse_number": "३-२३-३०", "content_sanskrit": "जातकौतूहलास्तत्र विमानस्थाश्च देवताः।\nददृशुर्वाहिनीं तेषां राक्षसानां गतायुषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000219031, "chapter_id": 9219, "verse_number": "३-२३-३१", "content_sanskrit": "रथेन तु खरो वेगात् सैन्यस्याग्राद् विनिःसृतः।\nश्येनगामी पृथुग्रीवो यज्ञशत्रुर्विहंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000219032, "chapter_id": 9219, "verse_number": "३-२३-३२", "content_sanskrit": "दुर्जयः करवीराक्षः परुषः कालकार्मुकः।\nहेममाली महामाली सर्पास्यो रुधिराशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000219033, "chapter_id": 9219, "verse_number": "३-२३-३३", "content_sanskrit": "द्वादशैते महावीर्याः प्रतस्थुरभितः खरम्।\nमहाकपालः स्थूलाक्षः प्रमाथस्त्रिशिरास्तथा।\nचत्वार एते सेनाग्रे दूषणं पृष्ठतोऽन्वयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000219034, "chapter_id": 9219, "verse_number": "३-२३-३४", "content_sanskrit": "सा भीमवेगा समराभिकांक्षिणी\nसुदारुणा राक्षसवीरसेना।\nतौ राजपुत्रौ सहसाभ्युपेता\nमाला ग्रहाणामिव चन्द्रसूर्यौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000219035, "chapter_id": 9219, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]