[{"id": 40015233, "chapter_id": 9219, "verse_number": "1", "content_sanskrit": "ततस्तमक्षोभ्यबलंलङ्काधिपतयेचराः । सुवेलेराघवंशैलेनिविष्टंप्रत्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015234, "chapter_id": 9219, "verse_number": "2", "content_sanskrit": "चाराणांरावणश्श्रुत्वाप्राप्तंरामंमहाबलम् । जातोद्वेगोऽभवत्किञ्चित्सचिवानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015235, "chapter_id": 9219, "verse_number": "3", "content_sanskrit": "मन्त्रिणश्शीघ्रमायान्तुसर्वेवैसुसमाहिताः । अयंनोमन्त्रकालोहिसम्प्रप्ताइतिराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015236, "chapter_id": 9219, "verse_number": "4", "content_sanskrit": "तस्यतद्वचनंश्रुत्वामन्त्रिणोऽभ्यागमन् द्रुतम् । ततस्समन्त्रयामासराक्षसैस्सचिवैस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015237, "chapter_id": 9219, "verse_number": "5", "content_sanskrit": "मन्त्रयित्वासदुर्धर्षःक्षमंयत्समनन्तरम् । विसर्जयित्वासचिवान्प्रविवेशस्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015238, "chapter_id": 9219, "verse_number": "6", "content_sanskrit": "ततोराक्षसमाहूयविद्युज्जिह्वंमहाबलम् । मायाविदंमहामायःप्राविशद्यत्रमैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015239, "chapter_id": 9219, "verse_number": "7", "content_sanskrit": "विद्युज्जिह्वंचमायाज्ञमब्रवीद्राक्षसाधिपः । मोहयिष्यावहेसीतांमाययाजनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015240, "chapter_id": 9219, 