[{"id": 2084658, "chapter_id": 2802, "verse_number": "१२-३०७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084659, "chapter_id": 2802, "verse_number": "१२-३०७-१", "content_sanskrit": "सम्पक्त्वयाऽयं नृपते वर्णितः शिष्टसंमतः।\nयोगमार्गो यथान्यायं शिष्यायेह हितैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084660, "chapter_id": 2802, "verse_number": "१२-३०७-२", "content_sanskrit": "साङ्ख्ये त्विदानीं कार्त्स्न्येन विधिं प्रब्रूहि पृच्छते।\nत्रिषु लोकेषु यज्ज्ञानं सर्वं तद्विदितं हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084661, "chapter_id": 2802, "verse_number": "१२-३०७-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084662, "chapter_id": 2802, "verse_number": "१२-३०७-३", "content_sanskrit": "शृणु मे त्वमिदं कृत्स्नं साङ्ख्यानां विदितात्मनाम्।\nविदितं यतिभिः सर्वैः कपिलादिभिरीश्वरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084663, "chapter_id": 2802, "verse_number": "१२-३०७-४", "content_sanskrit": "यस्मिन्नविभ्रमाः केचिद्दृश्यन्ते मनुजर्षभ।\nगुणाश्च यस्मिन्बहवो दोषहानिश्च केवला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084664, "chapter_id": 2802, "verse_number": "१२-३०७-५", "content_sanskrit": "ज्ञानेन परिसङ्ख्याय सदोषान्विषयान्नृप।\nमानुषान्दुर्जयान्कृत्स्नान्पैशाचान्विषयांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084665, "chapter_id": 2802, "verse_number": "१२-३०७-६", "content_sanskrit": "राक्षसान्विषयाञ्ज्ञात्वा यक्षाणां विषयांस्तथा।\nविषयानौरगाञ्ज्ञात्वा गान्धर्वविषयांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084666, "chapter_id": 2802, "verse_number": "१२-३०७-७", "content_sanskrit": "पितृणां विषयाञ्ज्ञात्वा तिर्यक्षु चरतां नृप।\nसुपर्णविषयाञ्ज्ञात्वा मरुतां विषयांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084667, "chapter_id": 2802, "verse_number": "१२-३०७-८", "content_sanskrit": "राजर्षिविषयाञ्ज्ञात्वा ब्रह्मर्षिविषयांस्तथा।\nआसुरान्विषयाञ्ज्ञात्वा वैश्वदेवांस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084668, "chapter_id": 2802, "verse_number": "१२-३०७-९", "content_sanskrit": "देवर्षिविषयाञ्ज्ञात्वा योगानामपि चेश्वरान्।\nप्रजापतीनां विषयान्ब्रह्मणो विषयांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084669, "chapter_id": 2802, "verse_number": "१२-३०७-१०", "content_sanskrit": "आयुषश्च परं कालं लोके विज्ञाय तत्त्वतः।\nसुखस्य च परं तत्त्वं विज्ञाय वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084670, "chapter_id": 2802, "verse_number": "१२-३०७-११", "content_sanskrit": "प्राप्ते काले च यद्दुःखं सततं विषयैषिणाम्।\nतिर्यक्षु पततां दुःखं पततां नरके च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084671, "chapter_id": 2802, "verse_number": "१२-३०७-१२", "content_sanskrit": "स्वर्गस्य च गुणान्कृत्स्नान्दोषान्सर्वांश्च भारत।\n`परिसंख्यानसंख्यानं सत्वं सांख्यगुणात्मकम्।\nवेदवादे येऽपि दोषा गुणा ये चापि वैदिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084672, "chapter_id": 2802, "verse_number": "१२-३०७-१३", "content_sanskrit": "ज्ञानयोगे च ये दोषा गुणा योगे च ये नृप।\nसाङ्ख्यज्ञाने च ये दोषास्तथैव च गुणा नृप।\n`इतरेषु च ये दोषा गुणास्तेषु च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084673, "chapter_id": 2802, "verse_number": "१२-३०७-१४", "content_sanskrit": "सत्वं दशगुणं ज्ञात्वा रजो नवगुणं तथा।\nतमश्चाष्टगुणं ज्ञात्वा वृद्धिं सप्तगुणां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084674, "chapter_id": 2802, "verse_number": "१२-३०७-१५", "content_sanskrit": "षङ्गुणं च मनो ज्ञात्वा नभः पञ्चगुणं तथा।\nबुद्धिं चतुर्गुणां ज्ञात्वा तमश्च त्रिगुणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084675, "chapter_id": 2802, "verse_number": "१२-३०७-१६", "content_sanskrit": "द्विगुणं च रजो ज्ञात्वा सत्वमेकगुणं पुनः।\nसर्गं विज्ञाय तत्त्वेन प्रलये प्रेक्ष्य चात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084676, "chapter_id": 2802, "verse_number": "१२-३०७-१७", "content_sanskrit": "ज्ञानविज्ञानसंपन्नाः कारणैर्भाविताः शुभाः।\nप्राप्नुवन्ति शुभं मोक्षं सूक्ष्मा इव नभः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084677, "chapter_id": 2802, "verse_number": "१२-३०७-१८", "content_sanskrit": "रूपेण दृष्टिं संयुक्तां घ्राणं गन्धगुणेन च।\nशब्दे सक्तं तथा श्रोत्रं जिह्वा रसगुणेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084678, "chapter_id": 2802, "verse_number": "१२-३०७-१९", "content_sanskrit": "त्वचं स्पर्शे तथा सक्तां वायुं नभसि चाश्रितम्।\nमोहं तमसि संयुक्तं लोभमर्थेषु संश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084679, "chapter_id": 2802, "verse_number": "१२-३०७-२०", "content_sanskrit": "विष्णौ क्रान्तं बलं शक्रे कोष्ठे सक्तं तथाऽनलम्।\nअप्सु देवीं समासक्तामपस्तेजसि संश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084680, "chapter_id": 2802, "verse_number": "१२-३०७-२१", "content_sanskrit": "तेजः सूक्ष्मे च संयुक्तं वायुं नभसि चाश्रितम्।\nनभो महति संयुक्तं महद्बुद्धौ च संश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084681, "chapter_id": 2802, "verse_number": "१२-३०७-२२", "content_sanskrit": "बुद्धिं तमसि संसक्तां तमो रजसि संश्रितम्।\nरजः सत्वे तथा सक्तं सत्वं सक्तं तथाऽऽत्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084682, "chapter_id": 2802, "verse_number": "१२-३०७-२३", "content_sanskrit": "सक्तमात्मानमीशे च देवे नारायणे तथा।\nदेवं मोक्षे च संसक्तं मोक्षं सक्तं तु न क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084683, "chapter_id": 2802, "verse_number": "१२-३०७-२४", "content_sanskrit": "ज्ञात्वा सत्वयुतं देहं वृतं षोडशभिर्गुणैः।\nस्वभावं चेतनां चैव ज्ञात्वा देहसमाश्रिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084684, "chapter_id": 2802, "verse_number": "१२-३०७-२५", "content_sanskrit": "मध्यस्थमेकमात्मानं पापं यस्मिन्न विद्यते।\nद्वितीयं कर्म विज्ञाय नृपते विषयैषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084685, "chapter_id": 2802, "verse_number": "१२-३०७-२६", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थांश्च सर्वानात्मनि संश्रितान्।\nदुर्लभत्वं च मोक्षस्य विज्ञाय श्रुतिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084686, "chapter_id": 2802, "verse_number": "१२-३०७-२७", "content_sanskrit": "प्राणापानौ समानं च व्यानोदानौ च तत्त्वतः।\nआवहं चानिलं ज्ञात्वा प्रवहं चानिलं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084687, "chapter_id": 2802, "verse_number": "१२-३०७-२८", "content_sanskrit": "सप्तवातांस्तथा शेषान्सप्तधा विहितान्पुनः।\nप्रजापतीनृषींश्चैव मार्गांश्चैव बहून्वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084688, "chapter_id": 2802, "verse_number": "१२-३०७-२९", "content_sanskrit": "सप्तर्षीश्च बहूञ्ज्ञात्वा राजर्षीश्च परंतप।\nसुरर्षीन्महतश्चान्यान्ब्रह्मर्षीन्सूर्यसन्निभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084689, "chapter_id": 2802, "verse_number": "१२-३०७-३०", "content_sanskrit": "ऐश्वर्याच्च्यावितान्दृष्ट्वा कालेन महता नृप।\nमहतां भूतसङ्घानां श्रुत्वा नाशं च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084690, "chapter_id": 2802, "verse_number": "१२-३०७-३१", "content_sanskrit": "गतिं चाप्यशुभां ज्ञात्वा नृपते पापकर्मिणाम्।\nवैतरण्यां च यद्दुःखं पतितानां यमक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084691, "chapter_id": 2802, "verse_number": "१२-३०७-३२", "content_sanskrit": "योनीषु च विचित्रासु संसारानशुभांस्तथा।\nजठरे चाशुभे वासं शोणितोदकभाजने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084692, "chapter_id": 2802, "verse_number": "१२-३०७-३३", "content_sanskrit": "श्लेष्ममूत्रपुरीषे च तीव्रगन्धसमन्विते।\nशुक्रशोणितसंघाते मज्जास्नायुपरिग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084693, "chapter_id": 2802, "verse_number": "१२-३०७-३४", "content_sanskrit": "सिराशतसमाकीर्णे नवद्वारे पुरेऽशुचौ।\nविज्ञायाहितमात्मानं योगांश्च विविधान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084694, "chapter_id": 2802, "verse_number": "१२-३०७-३५", "content_sanskrit": "तामसानां च जन्तूनां रमणीयावृतात्मनाम्।\nसात्विकानां च जन्तूनां कुत्सितं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084695, "chapter_id": 2802, "verse_number": "१२-३०७-३६", "content_sanskrit": "गर्हितं महतामर्थे साङ्ख्यानां विदितात्मनाम्।\nउपप्लवांस्तथा घोराञ्शशिनस्तेजसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084696, "chapter_id": 2802, "verse_number": "१२-३०७-३७", "content_sanskrit": "ताराणां पतनं दृष्ट्वा नक्षत्राणां च पर्ययम्।\nद्वन्द्वानां विप्रयोगं च विज्ञाय कृपण नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084697, "chapter_id": 2802, "verse_number": "१२-३०७-३८", "content_sanskrit": "अन्योन्यभक्षणं दृष्ट्वा भूतानामपि चाशुभम्।\nबाल्ये मोहं च विज्ञाय क्षयं देहस्य चाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084698, "chapter_id": 2802, "verse_number": "१२-३०७-३९", "content_sanskrit": "रागे मोहे च संप्राप्ते क्वचित्सत्वं समाश्रितम्।\nसहस्रेषु नरः कश्चिन्मोक्षबुद्धिं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084699, "chapter_id": 2802, "verse_number": "१२-३०७-४०", "content_sanskrit": "दुर्लभत्वं च मोक्षस्य विज्ञाय श्रुतिपूर्वकम्।\nबहुमानमलब्धेषु लब्धे मध्यस्थतां पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084700, "chapter_id": 2802, "verse_number": "१२-३०७-४१", "content_sanskrit": "विषयाणां च दौरात्म्यं विज्ञाय नृपते पुनः।\nगतासूनां च कौन्तेय देहान्दृष्ट्वा तथाऽशुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084701, "chapter_id": 2802, "verse_number": "१२-३०७-४२", "content_sanskrit": "वासं कुलेषु जन्तूनां दुःखं विज्ञाय भारत।\nब्रह्मघ्नानां गतिं ज्ञात्वा पतितानां सुदारुणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084702, "chapter_id": 2802, "verse_number": "१२-३०७-४३", "content_sanskrit": "सुरापाने च सक्तानां ब्राह्मणानां दुरात्मनाम्।\nगुरूदारप्रसक्तानां गतिं विज्ञाय चाशुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084703, "chapter_id": 2802, "verse_number": "१२-३०७-४४", "content_sanskrit": "जननीषु च वर्तन्ते येन सम्यग्युधिष्ठिर।\nसदेवकेषु लोकेषु येन वर्तन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084704, "chapter_id": 2802, "verse_number": "१२-३०७-४५", "content_sanskrit": "तेन ज्ञानेन विज्ञाय गतिं चाशुभकर्मणाम्\nतिर्यग्योनिगतानां च विज्ञाय च गतिं पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084705, "chapter_id": 2802, "verse_number": "१२-३०७-४६", "content_sanskrit": "वेदवादांस्तथा चित्रानृतूनां पर्ययांस्तथा।\nक्षयं संवत्सराणां च मासानां च क्षयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084706, "chapter_id": 2802, "verse_number": "१२-३०७-४७", "content_sanskrit": "पक्षक्षयं तथा दृष्ट्वा दिवसानां च संक्षयम्।\nक्षयं वृद्धिं च चन्द्रस्य दृष्ट्वा प्रत्यक्षतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084707, "chapter_id": 2802, "verse_number": "१२-३०७-४८", "content_sanskrit": "वृद्धिं दृष्ट्वा समुद्राणां क्षयं तेषां तथा पुनः।\nक्षयं धनानां दृष्ट्वा च पुनर्वृद्धिं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084708, "chapter_id": 2802, "verse_number": "१२-३०७-४९", "content_sanskrit": "संयोगानां क्षयं दृष्ट्वा युगानां च विशेषतः।\nक्षयं च दृष्ट्वा शैलानां क्षयं च सरितां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084709, "chapter_id": 2802, "verse_number": "१२-३०७-५०", "content_sanskrit": "वर्णानां च क्षयं दृष्ट्वा क्षयान्तं च पुनः पुनः।\nजरा मृत्युस्तथा जन्म दृष्ट्वा दुःखानि चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084710, "chapter_id": 2802, "verse_number": "१२-३०७-५१", "content_sanskrit": "देहदोषांस्तथा ज्ञात्वा तेषां दुःखं च तत्त्वतः।\nदेहविक्लवतां चैव सम्यग्विज्ञाय तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2084711, "chapter_id": 2802, "verse_number": "१२-३०७-५२", "content_sanskrit": "आत्मदोषांश्च विज्ञाय सर्वानात्मनि संश्रितान्।\nस्वदेहादुत्थितान्गब्धांस्तथा विज्ञाय चाशुभान्।\n`मूत्रश्लेष्मपुरीषादीन्स्वेदजांश्च सुकुत्सितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2084712, "chapter_id": 2802, "verse_number": "१२-३०७-५३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2084713, "chapter_id": 2802, "verse_number": "१२-३०७-५३", "content_sanskrit": "कान्स्वगात्रोद्भवान्दोषान्पश्यस्यमितविक्रम।\nएतन्मे संशयं कृत्स्नं वक्तुमर्हसि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2084714, "chapter_id": 2802, "verse_number": "१२-३०७-५४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2084715, "chapter_id": 2802, "verse_number": "१२-३०७-५४", "content_sanskrit": "पञ्च दोषान्प्रभो देहे प्रवदन्ति मनीषिणः।\nमार्गज्ञाः कापिलाः साङ्ख्याः शृणु तानरिसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2084716, "chapter_id": 2802, "verse_number": "१२-३०७-५५", "content_sanskrit": "कामक्रोधौ भयं निद्रा पञ्चमः श्वास उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2084717, "chapter_id": 2802, "verse_number": "१२-३०७-५६", "content_sanskrit": "एते दोषाः शरीरेषु दृश्यन्ते सर्वदेहिनाम्।\nछिन्दन्ति क्षमया क्रोधं कामं संकल्पवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2084718, "chapter_id": 2802, "verse_number": "१२-३०७-५७", "content_sanskrit": "सत्वसंसेवनान्निद्रामप्रमादाद्भयं तथा।\nछिन्दन्ति पञ्चमं श्वासमल्पाहारतया नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2084719, "chapter_id": 2802, "verse_number": "१२-३०७-५८", "content_sanskrit": "गुणान्गुणशतैर्ज्ञात्वा दोषान्दोषशतैरपि।\nहेतून्हेतुशतैश्चित्रैश्चित्रान्विज्ञाय तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2084720, "chapter_id": 2802, "verse_number": "१२-३०७-५९", "content_sanskrit": "अपां फेनोपमं लोकं विष्णोर्मायाशतैश्वितम्।\nचित्रभित्तिप्रतीकाशं नलसारमनर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2084721, "chapter_id": 2802, "verse_number": "१२-३०७-६०", "content_sanskrit": "तमः श्वभ्रनिभं दृष्ट्वा वर्षबुद्बुदसंनिभम्।\nक्लेशप्रायं सुखाद्धीनं नाशोत्तरमिहावशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2084722, "chapter_id": 2802, "verse_number": "१२-३०७-६१", "content_sanskrit": "रजस्तमसि संमग्नं पङ्के द्वीपमिवावशम्।\nसाङ्ख्या राजन्महाप्राज्ञास्त्यक्त्वा देहं प्रजाकृतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2084723, "chapter_id": 2802, "verse_number": "१२-३०७-६२", "content_sanskrit": "ज्ञानयोगेन साङ्ख्येन व्यापिना महता नृप।\nराजसानशुभान्गन्धांस्तांमसांश्च तथाविधान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2084724, "chapter_id": 2802, "verse_number": "१२-३०७-६३", "content_sanskrit": "पुण्यांश्च सात्विकान्गन्धान्स्पर्शजान्देहसंश्रितान्।\nछित्त्वाऽऽशु ज्ञानशस्त्रेण तपो दण्डेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2084725, "chapter_id": 2802, "verse_number": "१२-३०७-६४", "content_sanskrit": "ततो दुःखोदधिं घोरं चिन्ताशोकमहाह्रदम्।\nव्याधिमृत्युमहाग्राहं महाभयमहोरगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2084726, "chapter_id": 2802, "verse_number": "१२-३०७-६५", "content_sanskrit": "तमःकूर्मं रजोमीनं प्रज्ञया संतरन्त्युत।\nस्नेहपङ्कं जरादुर्गं ज्ञानदीपमरिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2084727, "chapter_id": 2802, "verse_number": "१२-३०७-६६", "content_sanskrit": "कर्मागाधं सत्यतीरं स्थितव्रतमरिंदम्।\nहिंसाशीघ्रमहावेगं नानारससमाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2084728, "chapter_id": 2802, "verse_number": "१२-३०७-६७", "content_sanskrit": "नानाप्रीतिमहारत्नं दुःखज्वरसमीरणम्।\nशोकतृष्णामहावर्तं तीक्ष्णव्याधिमहागजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2084729, "chapter_id": 2802, "verse_number": "१२-३०७-६८", "content_sanskrit": "अस्थिसंघातसंघट्टं श्लेष्मफेनमरिंदम्।\nदानमुक्ताकरं घोरं शोणितह्रदविद्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2084730, "chapter_id": 2802, "verse_number": "१२-३०७-६९", "content_sanskrit": "हसितोत्क्रुष्टनिर्घोषं नानाज्ञानसुदुस्तरम्।\nरोदनाश्रुमलक्षारं सङ्गत्यागपरायणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2084731, "chapter_id": 2802, "verse_number": "१२-३०७-७०", "content_sanskrit": "पुत्रदारजलौकौघं मत्रिबान्धवपत्तनम्।\nअहिंसासत्यमर्यादं प्राणत्यागमहोर्मिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2084732, "chapter_id": 2802, "verse_number": "१२-३०७-७१", "content_sanskrit": "वेदान्तगमनद्वीपं सर्वभूतदयोदकम्।\nमोक्षदुर्लाभविषयं व़डवामुखसागरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2084733, "chapter_id": 2802, "verse_number": "१२-३०७-७२", "content_sanskrit": "तरन्ति मुनयः सिद्धा ज्ञानयानेन भारत।\nतीर्त्वाऽतिदुस्तरं जन्म विशन्ति विमलं नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2084734, "chapter_id": 2802, "verse_number": "१२-३०७-७३", "content_sanskrit": "तत्र तान्सुकृतीन्साङ्ख्यान्सूर्यो वहति रश्मिभिः।\nपद्मतन्तुवदाविश्य प्रसह्य विषयान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2084735, "chapter_id": 2802, "verse_number": "१२-३०७-७४", "content_sanskrit": "तत्र तान्प्रवहो वायुः प्रतिगृह्णाति भारत।\nवीतरागान्यतीन्सिद्धान्वीर्ययुक्तांस्तपोधनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2084736, "chapter_id": 2802, "verse_number": "१२-३०७-७५", "content_sanskrit": "सूक्ष्मः शीतः सुगन्धी च सुखस्पर्शश्च भारत।\nसप्तानां मरुतां श्रेष्ठो लोकान्गच्छति यः शुभान्।\nस तान्वहति कौन्तेय नभसः परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2084737, "chapter_id": 2802, "verse_number": "१२-३०७-७६", "content_sanskrit": "नभो वहति लोकेश रजसः परमां गतिम्।\n`तमो वहति लोकेश रजसः परमां गतिम्।\nरजो वहति राजेन्द्र सत्वस्य परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2084738, "chapter_id": 2802, "verse_number": "१२-३०७-७७", "content_sanskrit": "सत्वं वहति राजेन्द्र परं नारायणं प्रभुम्।\nप्रभुर्वहति शुद्धात्मा परमात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2084739, "chapter_id": 2802, "verse_number": "१२-३०७-७८", "content_sanskrit": "परमात्मानमासाद्य तद्भूता यतयोऽमलाः।\nअमृतत्वाय कल्पन्ते न निवर्तन्ति वा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2084740, "chapter_id": 2802, "verse_number": "१२-३०७-७९", "content_sanskrit": "परमा सा गतिः पार्थ निर्द्वन्द्वानां महात्मनाम्।\nसत्यार्जवरतानां वै सर्वभूतदयावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2084741, "chapter_id": 2802, "verse_number": "१२-३०७-८०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2084742, "chapter_id": 2802, "verse_number": "१२-३०७-८०", "content_sanskrit": "स्थानमुत्तममासाद्य भगवन्तं स्थिरव्रताः।\nआजन्ममरणं वा ते स्मरन्त्युत न वाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2084743, "chapter_id": 2802, "verse_number": "१२-३०७-८१", "content_sanskrit": "यदत्र तथ्यं तन्मे त्वं यथावद्वक्तुमर्हसि।\nत्वदृते पुरुषं नान्यं प्रष्टुमर्हामि कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2084744, "chapter_id": 2802, "verse_number": "१२-३०७-८२", "content_sanskrit": "मोक्षे दोषो महानेष प्राप्य सिद्धिगतानृषीन्।\nयदि तत्रैव विज्ञाने वर्तन्ते यतयः परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2084745, "chapter_id": 2802, "verse_number": "१२-३०७-८३", "content_sanskrit": "प्रवृत्तिलक्षणं धर्मं पश्यामि परमं नृप।\nमग्नस्य हि परे ज्ञाने किं न दुःखतरं भवेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2084746, "chapter_id": 2802, "verse_number": "१२-३०७-८४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2084747, "chapter_id": 2802, "verse_number": "१२-३०७-८४", "content_sanskrit": "यथान्यायं त्वया तात प्रश्नः पृष्टः सुसंकटः।\nबुधानामपि संमोहः प्रश्नेऽस्मिन्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2084748, "chapter_id": 2802, "verse_number": "१२-३०७-८५", "content_sanskrit": "अत्रापि तत्त्वं परमं शृणु सम्यङ्भयेरितम्।\nबुद्धिश्च परमा यत्र कापिलानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2084749, "chapter_id": 2802, "verse_number": "१२-३०७-८६", "content_sanskrit": "इन्द्रियाण्येव बुध्यन्ते स्वदेहे देहिनां नृप।\nकारणान्यात्मनस्तानि सूक्ष्मः पश्यति तैस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2084750, "chapter_id": 2802, "verse_number": "१२-३०७-८७", "content_sanskrit": "आत्मना विप्रहीणानि काष्ठकुड्यसमानि तु।\nविनश्यन्ति न संदेहः फेना इव महार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2084751, "chapter_id": 2802, "verse_number": "१२-३०७-८८", "content_sanskrit": "इन्द्रियैः सह सुप्तस्य देहिनः शत्रुतापन।\nसूक्ष्मश्चरति सर्वत्र नभसीव समीरणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2084752, "chapter_id": 2802, "verse_number": "१२-३०७-८९", "content_sanskrit": "स पश्यति यथान्यायं स्पर्शान्स्पृशति वा विभो।\nबुध्यमानो यथापूर्वमखिलेनेह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2084753, "chapter_id": 2802, "verse_number": "१२-३०७-९०", "content_sanskrit": "इन्द्रियाणीह सर्वाणि स्वे स्वे स्थाने यथाविधि।\nअनीशत्वात्प्रलीयन्ते सर्पा हतविषा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2084754, "chapter_id": 2802, "verse_number": "१२-३०७-९१", "content_sanskrit": "इन्द्रियाणां तु सर्वेषां स्वस्थानेष्वेव सर्वशः।\nआक्रम्य गतयः सूक्ष्माश्चरत्यात्मा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2084755, "chapter_id": 2802, "verse_number": "१२-३०७-९२", "content_sanskrit": "सत्वस्य च गुणान्कृत्स्नान्नजसश्च गुणान्पुनः।\nगुणांश्च तमसः सर्वान्गुणान्बुद्धेश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2084756, "chapter_id": 2802, "verse_number": "१२-३०७-९३", "content_sanskrit": "गुणांश्च मनसश्चापि नभसश्च गुणांश्च सः।\nगुणान्वायोश्च धर्मात्मंस्तेजसां च गुणान्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2084757, "chapter_id": 2802, "verse_number": "१२-३०७-९४", "content_sanskrit": "अपां गुणांस्तथा पार्थ पार्थिंवांश्च गुणानपि।\nसर्वात्मना गुणैर्व्याप्तः क्षेत्रज्ञेषु युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2084758, "chapter_id": 2802, "verse_number": "१२-३०७-९५", "content_sanskrit": "आत्मा च याति क्षेत्रज्ञं कर्मणी च शुभाशुभे।\nशिष्या इव महात्मानमिन्द्रियाणि च तं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2084759, "chapter_id": 2802, "verse_number": "१२-३०७-९६", "content_sanskrit": "प्रकृतिं चाप्यतिक्रम्य गच्छत्यात्मानमव्ययम्।\nपरं नारायणं देवं निर्द्वन्द्वं प्रकृतेः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2084760, "chapter_id": 2802, "verse_number": "१२-३०७-९७", "content_sanskrit": "विमुक्तः सर्वपापेभ्यः प्रविष्टस्तमनामयम्।\nपरमात्मानमगुणं न निवर्तति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2084761, "chapter_id": 2802, "verse_number": "१२-३०७-९८", "content_sanskrit": "शिष्टं तत्र मनस्तात इन्द्रियाणि च भारत।\nआगच्छन्ति यथाकालं गुरोः संदेशकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2084762, "chapter_id": 2802, "verse_number": "१२-३०७-९९", "content_sanskrit": "शक्यं चाल्पेन कालेन शान्तिं प्राप्तुं गुणार्थिना।\nएवमुक्तेन कौन्तेय युक्तज्ञानेन मोक्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2084763, "chapter_id": 2802, "verse_number": "१२-३०७-१००", "content_sanskrit": "साङ्ख्या राजन्महाप्राज्ञा गच्छन्ति परमां गतिम्।\nज्ञानेनानेन कौन्तेय तुल्यं ज्ञानं न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2084764, "chapter_id": 2802, "verse_number": "१२-३०७-१०१", "content_sanskrit": "अत्र ते संशयो मा भूज्ज्ञानं सांख्यं परं मतम्।\nअक्षरं ध्रुवमव्यक्तं पूर्णं ब्रह्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2084765, "chapter_id": 2802, "verse_number": "१२-३०७-१०२", "content_sanskrit": "अनादिमध्यनिधनं निर्द्वन्द्वं कर्तृ शाश्वतम्।\nकूटस्थं चैव नित्यं च यद्वदन्ति शमात्मकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2084766, "chapter_id": 2802, "verse_number": "१२-३०७-१०३", "content_sanskrit": "यतः सर्वाः प्रवर्तन्ते सर्गप्रलयविक्रियाः।\nयच्च शंसन्ति शास्त्रेषु वदन्ति परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2084767, "chapter_id": 2802, "verse_number": "१२-३०७-१०४", "content_sanskrit": "सर्वे विप्राश्च देवाश्च तथा शमविदो जनाः।\nब्रह्मण्यं परमं देवमनन्तं परमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2084768, "chapter_id": 2802, "verse_number": "१२-३०७-१०५", "content_sanskrit": "प्रार्थयन्तश्च तं विप्रा वदन्ति गुणबुद्धयः।\nसम्यग्युक्तास्तथा योगाः साङ्ख्याश्चामितदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2084769, "chapter_id": 2802, "verse_number": "१२-३०७-१०६", "content_sanskrit": "अमूर्तेस्तस्य कौन्तेय साङ्ख्यं मूर्तिरिति श्रुतिः।\nअभिज्ञानानि तस्याहुर्मतं हि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2084770, "chapter_id": 2802, "verse_number": "१२-३०७-१०७", "content_sanskrit": "द्विविधानीह भूतानि पृथिव्यां पृथिवीपते।\nजङ्गमाजङ्गमाख्यानि जङ्गमं तु विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2084771, "chapter_id": 2802, "verse_number": "१२-३०७-१०८", "content_sanskrit": "ज्ञानं महद्यद्धि महत्सु राज\nन्वेदेषु साङ्ख्येषु तथैव योगे।\nयच्चापि दृष्टं विविधं पुराणे\nसाङ्ख्यागतं तन्निखिलं नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2084772, "chapter_id": 2802, "verse_number": "१२-३०७-१०९", "content_sanskrit": "यच्चेतिहासेषु महत्सु दृष्टं\nयच्चार्थशास्त्रे नृप शिष्टजुष्टे।\nज्ञानं च लोके यदिहास्ति किंचि\nत्साङ्ख्यागतं तच्च महन्महात्मन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2084773, "chapter_id": 2802, "verse_number": "१२-३०७-११०", "content_sanskrit": "शमश्च दृष्टः परमं बलं च\nज्ञानं च साङ्ख्यं च यथावदुक्तम्।\nतपांसि सूक्ष्माणि सुखानि चैव\nसाङ्ख्ये यथावद्विहितानि राजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2084774, "chapter_id": 2802, "verse_number": "१२-३०७-१११", "content_sanskrit": "विपर्यये तस्य हि पार्थ देवा\nन्गच्छन्ति साङ्ख्याः सततं सुखेन।\nतांश्चानुसंचार्य ततः कृतार्थाः\nपतन्ति विप्रेषु यतेषु भूयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2084775, "chapter_id": 2802, "verse_number": "१२-३०७-११२", "content_sanskrit": "हित्वा च देहं प्रविशन्ति मोक्षं\nदिवौकसो द्यामिव पार्थ साङ्ख्याः।\nअतोऽधिकं तेऽभिरता महार्थे\nसाङ्ख्ये द्विजाः पार्थिव शिष्टजुष्टे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2084776, "chapter_id": 2802, "verse_number": "१२-३०७-११३", "content_sanskrit": "तेषां न तिर्यग्गमनं हि दृष्टं\nनार्वाग्गतिः पापकृताधिवासः।\nच चाबुधानामपि ते द्विजातयो\nये ज्ञानमेतन्नृपतेऽनुरक्ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2084777, "chapter_id": 2802, "verse_number": "१२-३०७-११४", "content_sanskrit": "साङ्ख्यं विशालं परमं पुराणं\nमहार्णवं विमलमुदाहरन्ति\nकृत्स्नं च साङ्ख्यं नृपते महात्मा\nनारायणो धारयतेऽप्रमेयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2084778, "chapter_id": 2802, "verse_number": "१२-३०७-११५", "content_sanskrit": "एतन्मयोक्तं नरदेव तत्त्वं\nनारायणो विश्वमिदं पुराणम्।\nस सर्गकाले च करोति सर्गं\nसंहारकाले च तदत्ति भूयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2084779, "chapter_id": 2802, "verse_number": "१२-३०७-११६", "content_sanskrit": "संहृत्य सर्वं निजदेहसंस्थं\nकृत्वाऽप्सु शेते जगदन्तरात्मा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2084780, "chapter_id": 2802, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्ताधिकत्रिशततमोऽध्यायः॥ ३०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]