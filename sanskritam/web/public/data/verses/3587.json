[{"id": 2120817, "chapter_id": 3587, "verse_number": "", "content_sanskrit": "नकुलस्य पश्चिमदिग्विजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120818, "chapter_id": 3587, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120819, "chapter_id": 3587, "verse_number": "१", "content_sanskrit": "नकुलस्य तु वक्ष्यामि कर्माणि विजयं तथा ।\nवासुदेवजितामाशां यथाऽसावजयत् प्रभुः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120820, "chapter_id": 3587, "verse_number": "२", "content_sanskrit": "निर्याय खाण्डवप्रस्थात् प्रतीचीं दिशमच्युतः ।\nउद्दिश्य मतिमान् प्रायान्महत्या सेनया सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120821, "chapter_id": 3587, "verse_number": "३", "content_sanskrit": "सिंहनादेन महता यौधानां गर्जितेन च ।\nरथनेमिनिनादेन कम्पयन् वसुधामिमाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120822, "chapter_id": 3587, "verse_number": "४", "content_sanskrit": "ततो बहुधनं रम्यं गवाश्वबहुधान्यवत् ।\nकार्त्तिकेयस्य दयितं रोहीतकमुपाद्रवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120823, "chapter_id": 3587, "verse_number": "५", "content_sanskrit": "तत्र युद्धं महद् दत्तं शूरैर्मत्तमयूरकैः ।\nमरुभूमिं स कार्त्स्न्येन तथैव बहुधान्यकम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120824, "chapter_id": 3587, "verse_number": "६", "content_sanskrit": "शैरीषकं च हैमं च वशे चक्रे महाद्युतिः ।\nलिलन्ध्रान् वटधानांश्च दूतैरेव जिगाय सः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120825, "chapter_id": 3587, "verse_number": "७", "content_sanskrit": "शिबींस्त्रिगर्तानम्बष्ठान् माळवान् पञ्च कर्पटान् ।\nतथा मध्यनिकायांश्च औपावृतगणानथ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120826, "chapter_id": 3587, "verse_number": "८", "content_sanskrit": "पुनश्च परिवृत्याथ पुष्करारण्यवासिनः ।\nगणानुत्सवसङ्केतान् अजयत् पाण्डवर्षभः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120827, "chapter_id": 3587, "verse_number": "९", "content_sanskrit": "सिन्धुकूलाश्रिता ये च ग्रामणीया महाबलाः ।\nशूद्राभीरगणाश्चैव ये चाश्रित्य सरस्वतीम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120828, "chapter_id": 3587, "verse_number": "१०", "content_sanskrit": "वर्तयन्ति च ये मत्स्यैर्ये च पर्वतवासिनः ।\nकृत्स्नं पञ्चनदं चैव मित्रभोगं तथैव च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120829, "chapter_id": 3587, "verse_number": "११", "content_sanskrit": "तथा सिंहनदं चैव तथैवापरपत्तनान् ।\nदूतैरेव वशं चक्रे नकुलः कुलनन्दनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120830, "chapter_id": 3587, "verse_number": "१२", "content_sanskrit": "उत्तरज्योतिषांश्चैव तथा वृन्दारकं पुरम् ।\nद्वारपालं च तरसा वशे चक्रे महाद्युतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120831, "chapter_id": 3587, "verse_number": "१३", "content_sanskrit": "रामठान् हारहूणांश्च प्रतीच्याश्चैव ये नृपाः ।\nतान् सर्वान् स वशे चक्रे नकुलः पाण्डवर्षभः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120832, "chapter_id": 3587, "verse_number": "१४", "content_sanskrit": "अरणं चैव रोमं च यवनानां पुराणि च ।\nलम्बनादेशजांश्चैव बन्धकांश्च नरोत्तम ।\nदूतैरेव वशं चक्रे करं चैनानदापयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120833, "chapter_id": 3587, "verse_number": "१५", "content_sanskrit": "तत्रस्थः प्रेषयामास वासुदेवाय चाभिभूः ।\nस चास्य यादवैः सार्धं प्रतिजग्राह शासनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120834, "chapter_id": 3587, "verse_number": "१६", "content_sanskrit": "ततः शाकलमभ्येत्य मद्राणां पुटभेदनम् ।\nमातुलं प्रीतिपूर्वेण शल्यं चक्रे वशे वशी\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120835, "chapter_id": 3587, "verse_number": "१७", "content_sanskrit": "स तेन सत्कृतो राज्ञा सत्कारार्हो विशाम्पते ।\nरत्नानि भूरीण्यादाय सम्प्रतस्थे युधां पतिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120836, "chapter_id": 3587, "verse_number": "१८", "content_sanskrit": "ततः सागरकुक्षिस्थान् म्लेच्छान् परमदारुणान् ।\nपल्लवान् बर्बरांश्चैव तान् सर्वाननयद् वशम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120837, "chapter_id": 3587, "verse_number": "१९", "content_sanskrit": "तत्र रत्नान्युपादाय वशे कृत्वा च पार्थिवान् ।\nन्यवर्तत कुरुश्रेष्ठो नकुलश्चित्रमार्गवित्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120838, "chapter_id": 3587, "verse_number": "२०", "content_sanskrit": "कळभानां सहस्राणि कोशं तस्य महात्मनः ।\nऊहुर्दश महाराज कृच्छ्रादिव महाधनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120839, "chapter_id": 3587, "verse_number": "२१", "content_sanskrit": "इन्द्रप्रस्थगतं वीरमभ्यगच्छद् युधिष्ठिरम् ।\nहृष्टो माद्रीसुतः श्रीमान् धनं त्वस्य न्यवेदयत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120840, "chapter_id": 3587, "verse_number": "२२", "content_sanskrit": "एवं प्रतीचीं नकुलो दिशं वरुणपालिताम् ।\nअजयद् वासुदेवेन निर्जितां भरतर्षभ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120841, "chapter_id": 3587, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकोनत्रिंशोऽध्यायः ॥ २९ ॥\nदिग्विजयपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120842, "chapter_id": 3587, "verse_number": "", "content_sanskrit": "॥ समाप्तं दिग्विजयपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120843, "chapter_id": 3587, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]