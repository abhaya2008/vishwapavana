[{"id": 5000452000, "chapter_id": 9452, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000452001, "chapter_id": 9452, "verse_number": "६-४५-१", "content_sanskrit": "स तस्य गतिमन्विच्छन् राजपुत्रः प्रतापवान्।\nदिदेशातिबलो रामो दश वानरयूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000452002, "chapter_id": 9452, "verse_number": "६-४५-२", "content_sanskrit": "द्वौ सुषेणस्य दायादौ नीलं च प्लवगाधिपम्।\nअङ्गदं वालिपुत्रं च शरभं च तरस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000452003, "chapter_id": 9452, "verse_number": "६-४५-३", "content_sanskrit": "द्विविदं च हनूमन्तं सानुप्रस्थं महाबलम्।\nऋषभं चर्षभस्कन्धमादिदेश परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000452004, "chapter_id": 9452, "verse_number": "६-४५-४", "content_sanskrit": "ते सम्प्रहृष्टा हरयो भीमानुद्यम्य पादपान्।\nआकाशं विविशुः सर्वे मार्गमाणा दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000452005, "chapter_id": 9452, "verse_number": "६-४५-५", "content_sanskrit": "तेषां वेगवतां वेगमिषुभिर्वेगवत्तरैः।\nअस्त्रवित् परमास्त्रस्तु वारयामास रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000452006, "chapter_id": 9452, "verse_number": "६-४५-६", "content_sanskrit": "तं भीमवेगा हरयो नाराचैः क्षतविक्षताः।\nअन्धकारे न ददृशुर्मेघैः सूर्यमिवावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000452007, "chapter_id": 9452, "verse_number": "६-४५-७", "content_sanskrit": "रामलक्ष्मणयोरेव सर्वदेहभिदः शरान्।\nभृशमावेशयामास रावणिः समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000452008, "chapter_id": 9452, "verse_number": "६-४५-८", "content_sanskrit": "निरन्तरशरीरौ तु तावुभौ रामलक्ष्मणौ।\nक्रुद्धेनेन्द्रजिता वीरौ पन्नगैः शरतां गतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000452009, "chapter_id": 9452, "verse_number": "६-४५-९", "content_sanskrit": "तयोः क्षतजमार्गेण सुस्राव रुधिरं बहु।\nतावुभौ च प्रकाशेते पुष्पिताविव किंशुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000452010, "chapter_id": 9452, "verse_number": "६-४५-१०", "content_sanskrit": "ततः पर्यन्तरक्ताक्षो भिन्नाञ्जनचयोपमः।\nरावणिर्भ्रातरौ वाक्यमन्तर्धानगतोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000452011, "chapter_id": 9452, "verse_number": "६-४५-११", "content_sanskrit": "युध्यमानमनालक्ष्यं शक्रोऽपि त्रिदशेश्वरः।\nद्रष्टुमासादितुं वापि न शक्तः किं पुनर्युवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000452012, "chapter_id": 9452, "verse_number": "६-४५-१२", "content_sanskrit": "प्रापिताविषुजालेन राघवौ कङ्कपत्रिणा।\nएष रोषपरीतात्मा नयामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000452013, "chapter_id": 9452, "verse_number": "६-४५-१३", "content_sanskrit": "एवमुक्त्वा तु धर्मज्ञौ भ्रातरौ रामलक्ष्मणौ।\nनिर्बिभेद शितैर्बाणैः प्रजहर्ष ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000452014, "chapter_id": 9452, "verse_number": "६-४५-१४", "content_sanskrit": "भिन्नाञ्जनचयश्यामो विस्फार्य विपुलं धनुः।\nभूय एव शरान् घोरान् विससर्ज महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000452015, "chapter_id": 9452, "verse_number": "६-४५-१५", "content_sanskrit": "ततो मर्मसु मर्मज्ञो मज्जयन् निशितान् शरान्।\nरामलक्ष्मणयोर्वीरो ननाद च मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000452016, "chapter_id": 9452, "verse_number": "६-४५-१६", "content_sanskrit": "बद्धौ तु शरबन्धेन तावुभौ रणमूर्धनि।\nनिमेषान्तरमात्रेण न शेकतुरवेक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000452017, "chapter_id": 9452, "verse_number": "६-४५-१७", "content_sanskrit": "ततो विभिन्नसर्वाङ्गौ शरशल्याचितौ कृतौ।\nध्वजाविव महेन्द्रस्य रज्जुमुक्तौ प्रकम्पितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000452018, "chapter_id": 9452, "verse_number": "६-४५-१८", "content_sanskrit": "तौ सम्प्रचलितौ वीरौ मर्मभेदेन कर्शितौ।\nनिपेततुर्महेष्वासौ जगत्यां जगतीपती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000452019, "chapter_id": 9452, "verse_number": "६-४५-१९", "content_sanskrit": "तौ वीरशयने वीरौ शयानौ रुधिरोक्षितौ।\nशरवेष्टितसर्वाङ्गावार्तौ परमपीडितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000452020, "chapter_id": 9452, "verse_number": "६-४५-२०", "content_sanskrit": "नह्यविद्धं तयोर्गात्रे बभूवाङ्गुलमन्तरम्।\nनानिर्विण्णं न चाध्वस्तमाकराग्रादजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000452021, "chapter_id": 9452, "verse_number": "६-४५-२१", "content_sanskrit": "तौ तु क्रूरेण निहतौ रक्षसा कामरूपिणा।\nअसृक् सुस्रुवतुस्तीव्रं जलं प्रस्रवणाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000452022, "chapter_id": 9452, "verse_number": "६-४५-२२", "content_sanskrit": "पपात प्रथमं रामो विद्धो मर्मसु मार्गणैः।\nक्रोधादिन्द्रजिता येन पुरा शक्रो विनिर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000452023, "chapter_id": 9452, "verse_number": "६-४५-२३", "content_sanskrit": "रुक्मपुङ्खैः प्रसन्नाग्रै रजोगतिभिराशुगैः।\nनाराचैरर्धनाराचैर्भल्लैरञ्जलिकैरपि।\nविव्याध वत्सदन्तैश्च सिंहदंष्ट्रैः क्षुरैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000452024, "chapter_id": 9452, "verse_number": "६-४५-२४", "content_sanskrit": "स वीरशयने शिश्येऽविज्यमाविध्य कार्मुकम्।\nभिन्नमुष्टिपरीणाहं त्रिनतं रुक्मभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000452025, "chapter_id": 9452, "verse_number": "६-४५-२५", "content_sanskrit": "बाणपातान्तरे रामं पतितं पुरुषर्षभम्।\nस तत्र लक्ष्मणो दृष्ट्वा निराशो जीवितेऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000452026, "chapter_id": 9452, "verse_number": "६-४५-२६", "content_sanskrit": "रामं कमलपत्राक्षं शरण्यं रणतोषिणम्।\nशुशोच भ्रातरं दृष्ट्वा पतितं धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000452027, "chapter_id": 9452, "verse_number": "६-४५-२७", "content_sanskrit": "हरयश्चापि तं दृष्ट्वा संतापं परमं गताः।\nशोकार्ताश्चुक्रुशुर्घोरमश्रुपूरितलोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000452028, "chapter_id": 9452, "verse_number": "६-४५-२८", "content_sanskrit": "बद्धौ तु तौ वीरशये शयानौ\nते वानराः सम्परिवार्य तस्थुः।\nसमागता वायुसुतप्रमुख्या\nविषादमार्ताः परमं च जग्मुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000452029, "chapter_id": 9452, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]