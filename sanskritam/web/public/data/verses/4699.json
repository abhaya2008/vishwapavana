[{"id": 2173997, "chapter_id": 4699, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173998, "chapter_id": 4699, "verse_number": "१", "content_sanskrit": "गजानीके हते तस्मिन् पाण्डुपुत्रेण भारत ।\nवध्यमाने बले राजन् भीमसेनेन सर्वशः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173999, "chapter_id": 4699, "verse_number": "२", "content_sanskrit": "विचरन्तमपश्याम भीमसेनं रणाजिरे ।\nदण्डहस्तमिव क्रुद्धमन्तकं प्राणहारिणम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174000, "chapter_id": 4699, "verse_number": "३", "content_sanskrit": "समेत्य च महाराज हतशेषाः सुतास्तव ।\nअदृश्यमाने कौरव्ये पुत्रे दुर्योधने तव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174001, "chapter_id": 4699, "verse_number": "४", "content_sanskrit": "सोदर्याः सहिता भूत्वा भीमसेनमुपाद्रवन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174002, "chapter_id": 4699, "verse_number": "५", "content_sanskrit": "दुर्मर्षणो महाराज जैत्रो भूरिबलो नलः ।\nसुनाभो जयसेनश्च दुर्विषह्यस्तथैव च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174003, "chapter_id": 4699, "verse_number": "६", "content_sanskrit": "दुष्प्रधर्षसुजातौ च पुत्रावभिमतौ तव ।\nदुर्विमोचननामा च श्रुतर्वा च महाबलः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174004, "chapter_id": 4699, "verse_number": "७", "content_sanskrit": "इत्येते सहिता भूत्वा तव पुत्राः समन्ततः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174005, "chapter_id": 4699, "verse_number": "८", "content_sanskrit": "भीमसेनमभिद्रुत्य रुरुधुः सर्वतो दिशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174006, "chapter_id": 4699, "verse_number": "९", "content_sanskrit": "ततो भीमो महाराज स्वरथं पुनरास्थितः ।\nमुमोच निशितान् बाणान् पुत्राणां तव मर्मसु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174007, "chapter_id": 4699, "verse_number": "१०", "content_sanskrit": "ते कीर्यमाणा भीमेन पुत्रास्तव महारणे ।\nभीमसेनमवासेधन् प्रवणादिव कुञ्जरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174008, "chapter_id": 4699, "verse_number": "११", "content_sanskrit": "ततः क्रुद्धो रणे भीमः शिरो दुर्मर्षणस्य च ।\nक्षुरप्रेण प्रमथ्याशु पातयामास भूतळे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174009, "chapter_id": 4699, "verse_number": "१२", "content_sanskrit": "ततोऽपरेण भल्लेन सर्वावरणभेदिना ।\nश्रुतान्तमवधीद् भीमः तव पुत्रं महारथम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174010, "chapter_id": 4699, "verse_number": "१३", "content_sanskrit": "जयत्सेनं ततो विद्ध्वा नाराचेन हसन्निव ।\nपातयामास कौरव्यं रथोपस्थादरिन्दमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174011, "chapter_id": 4699, "verse_number": "१४", "content_sanskrit": "स पपात रथाद् राजन् भूमौ तूर्णं ममार च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174012, "chapter_id": 4699, "verse_number": "१५", "content_sanskrit": "श्रुतर्वा तु ततो भीमं क्रुद्धो विव्याध मारिष ।\nशतेन गृध्रवाजानां शराणां नतपर्वणाम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174013, "chapter_id": 4699, "verse_number": "१६", "content_sanskrit": "ततः क्रुद्धो रणे भीमो जैत्रं भूरिबलं नलम् ।\nत्रीनेतांस्त्रिभिरानर्च्छद् विषाग्निप्रतिमैः शरैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174014, "chapter_id": 4699, "verse_number": "१७", "content_sanskrit": "ते हता न्यपतन् भूमौ स्यन्दनेभ्यो महारथाः ।\nवसन्ते पुष्पशबला निकृत्ता इव किंशुकाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174015, "chapter_id": 4699, "verse_number": "१८", "content_sanskrit": "ततोऽपरेण तीक्ष्णेन नाराचेन परन्तप ।\nदुर्विमोचनमाहत्य प्रेषयामास मृत्यवे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174016, "chapter_id": 4699, "verse_number": "१९", "content_sanskrit": "स हतः प्रापतद् भूमौ स्वरथात् रथिनां वरः ।\nगिरेस्तु कूटजो वृक्षो मारुतेनेव पातितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174017, "chapter_id": 4699, "verse_number": "२०", "content_sanskrit": "दुष्प्रधर्षं ततश्चैव सुजातं च सुतौ तव ।\nएकैकं ह्यवधीत् सङ्खे द्वाभ्यां द्वाभ्यां महाबलः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174018, "chapter_id": 4699, "verse_number": "२१", "content_sanskrit": "तौ शिलीमुखविद्धाग्नौ पेततू रथसत्तमौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174019, "chapter_id": 4699, "verse_number": "२२", "content_sanskrit": "ततो यतन्तमपरमभिवीक्ष्य सुतं तव ।\nभल्लेन युधि विव्याध भीमो दुर्विषहं रणे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174020, "chapter_id": 4699, "verse_number": "२३", "content_sanskrit": "स पपात रणे राजन् पश्यतां सर्वधन्विनाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174021, "chapter_id": 4699, "verse_number": "२४", "content_sanskrit": "दृष्ट्वा तु निहतान् भ्रातॄन् बहूनेकेन संयुगे ।\nअमर्षवशमापन्नः श्रुतर्वा भीममभ्ययात्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174022, "chapter_id": 4699, "verse_number": "२५", "content_sanskrit": "विक्षिपंस्तु महच्चापं कार्तस्वरविभूषितम् ।\nविसृजन् सायकांश्चैव विषाग्निप्रतिमान् बहून्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174023, "chapter_id": 4699, "verse_number": "२६", "content_sanskrit": "स तु राजन् धनुश्छित्वा पाण्डवस्य महामृधे ।\nअथैनं छिन्नधन्वानं विंशत्या समवाकिरत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174024, "chapter_id": 4699, "verse_number": "२७", "content_sanskrit": "ततोऽन्यद्धनुरादाय भीमसेनो महारथः ।\nअवाकिरत् तव सुतं तिष्ठ तिष्ठेति चाब्रवीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174025, "chapter_id": 4699, "verse_number": "२८", "content_sanskrit": "महदासीत् तयोर्युद्धं चित्ररूपं भयानकम् ।\nयादृशः समरः पूर्वं जम्भवासवयोरभूत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174026, "chapter_id": 4699, "verse_number": "२९", "content_sanskrit": "तयोस्तत्र शरैर्मुक्तैर्यमदण्डनिभैः शितैः ।\nसमाच्छन्ना धरा सर्वा खं च सर्वा दिशस्तथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174027, "chapter_id": 4699, "verse_number": "३०", "content_sanskrit": "ततः श्रुतर्वा सङ्क्रुद्धो धनुरायम्य सायकैः ।\nभीमसेनं रणे राजन् बाह्वोरुरसि चापर्यत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174028, "chapter_id": 4699, "verse_number": "३१", "content_sanskrit": "सोऽतिविद्धो महाराज तव पुत्रेण धन्विना ।\nभीमः सञ्चुक्षुभे क्रुद्धः पर्वणीव महोदधिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174029, "chapter_id": 4699, "verse_number": "३२", "content_sanskrit": "ततो भीमो रुषाविष्टः पुत्रस्य तव भारत ।\nसारथिं चतुरोऽश्वांश्च शरैर्निन्ये यमक्षयम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174030, "chapter_id": 4699, "verse_number": "३३", "content_sanskrit": "विरथं तं समालक्ष्य विशिखैर्लोमवापिभिः ।\nअवाकिरदमेयात्मा दर्शयन् पाणिलाघवम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174031, "chapter_id": 4699, "verse_number": "३४", "content_sanskrit": "श्रुतर्वा विरथो राजन् नाददे खड्गचर्मणी\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174032, "chapter_id": 4699, "verse_number": "३५", "content_sanskrit": "अथास्याददतः खड्गं शतचन्द्रं च भानुमत् ।\nक्षुरप्रेण शिरः कायात् पातयामास पाण्डवः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174033, "chapter_id": 4699, "verse_number": "३६", "content_sanskrit": "छिन्नोत्तमाङ्गस्य ततः क्षुरप्रेण महात्मना ।\nपपात कायः स्वरथाद् वसुधामनुनादयन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174034, "chapter_id": 4699, "verse_number": "३७", "content_sanskrit": "तस्मिन्निपतिते वीरे तावका भयमोहिताः ।\nअभ्यद्रवन्त सङ्ग्रामे भीमसेनं युयुत्सवः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174035, "chapter_id": 4699, "verse_number": "३८", "content_sanskrit": "तानापतत एवाशु हतशेषान् महाबलान् ।\nदंसितः प्रतिजग्राह भीमसेनः प्रतापवान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174036, "chapter_id": 4699, "verse_number": "३९", "content_sanskrit": "ते तु तं वै समासाद्य परिवव्रुः समन्ततः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174037, "chapter_id": 4699, "verse_number": "४०", "content_sanskrit": "ततस्तु संवृतो भीमः तावकैर्निशितैः शरैः ।\nपीडयामास तान् सर्वान् सहस्राक्ष इवासुरान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174038, "chapter_id": 4699, "verse_number": "४१", "content_sanskrit": "ततः पञ्चशतान् हत्वा स्ववरूथान् महारथान् ।\nजघान कुञ्जरानीकं पुनः सप्तशतं युधि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174039, "chapter_id": 4699, "verse_number": "४२", "content_sanskrit": "हत्वा दश सहस्राणि पत्तीनां परमेषुभिः ।\nवाजिनां च शतान्यष्टौ पाण्डवः स विराजते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174040, "chapter_id": 4699, "verse_number": "४३", "content_sanskrit": "भीमसेनस्तु कौन्तेयो हत्वा युद्धे सुतांस्तव ।\nमेने कृतार्थमात्मानं सफलं जन्म च प्रभो\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174041, "chapter_id": 4699, "verse_number": "४४", "content_sanskrit": "तं तथा युध्यमानं च विनिघ्नन्तं च तावकान् ।\nईक्षितुं नोत्सहन्ते स्म तव सैन्या नराधिप\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174042, "chapter_id": 4699, "verse_number": "४५", "content_sanskrit": "विद्राव्य तु कुरून् सर्वान् तांश्च हत्वा पदानुगान् ।\nदोर्भ्यां शब्दं ततश्चक्रे त्रासयानो हयद्विपान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174043, "chapter_id": 4699, "verse_number": "४६", "content_sanskrit": "हतभूयिष्ठयोधा तु तव सेना विशाम्पते ।\nकिञ्चिच्छेषा महाराज कृपणा समपद्यत\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174044, "chapter_id": 4699, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि गजयुद्धं नाम षड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174045, "chapter_id": 4699, "verse_number": "२६", "content_sanskrit": "शल्यवधपर्वणि षड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]