[{"id": 2027942, "chapter_id": 1601, "verse_number": "३-२३९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027943, "chapter_id": 1601, "verse_number": "३-२३९-१", "content_sanskrit": "कर्णस्य वचनं श्रुत्वा राजा दुर्योधनस्ततः।\nहृष्टो भूत्वापुनर्दीनो राधेयमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027944, "chapter_id": 1601, "verse_number": "३-२३९-२", "content_sanskrit": "ब्रवीषि यदिदं कर्ण सर्वं मनसि मे स्थितम्।\nन त्वभ्यनुज्ञां लप्स्यामि गमने यत्रपाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027945, "chapter_id": 1601, "verse_number": "३-२३९-३", "content_sanskrit": "परिदेवति तान्वीरान्धृतराष्ट्रो महीपतिः।\nमन्यतेऽभ्यधिकांश्चापि तपोयोगेन पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027946, "chapter_id": 1601, "verse_number": "३-२३९-४", "content_sanskrit": "अथवाऽप्यनुबुध्येत नृपोऽस्माकं चिकीर्षितम्।\nएतामप्यायतिं रक्षन्नाभ्यनुज्ञातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027947, "chapter_id": 1601, "verse_number": "३-२३९-५", "content_sanskrit": "न हि द्वैतवने किंचिद्विद्यतेऽन्यत्प्रयोजनम्।\nउन्माथनमृते तेषां वनस्थानामपि द्विषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027948, "chapter_id": 1601, "verse_number": "३-२३९-६", "content_sanskrit": "जानासिहि यथा क्षत्ता द्यूतकाल उपस्थिते।\nअब्रवीद्यच्च मां त्वां च सौबलं वचनं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027949, "chapter_id": 1601, "verse_number": "३-२३९-७", "content_sanskrit": "तानिसर्वाणि वाक्यानि यच्चान्यत्परिदेवितम्।\nविचिन्त्य निश्चय गच्छे गमनायेतराय वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027950, "chapter_id": 1601, "verse_number": "३-२३९-८", "content_sanskrit": "ममापि हिमहान्हर्षो यदहं भीमफल्गुनौ।\nक्लिष्टावरण्ये पश्येयं कृष्णया सहिताविति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027951, "chapter_id": 1601, "verse_number": "३-२३९-९", "content_sanskrit": "न तथा ह्याप्नुयां प्रीतिमवाप्य वसुधामिमाम्।\nदृष्ट्वा यथा पाण्डुसुतान्वल्कलाजिनवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027952, "chapter_id": 1601, "verse_number": "३-२३९-१०", "content_sanskrit": "किंनु स्यादधिकं तस्माद्यदहं द्रुपदात्मजाम्।\nद्रौपदीं कर्ण पश्येयं काषायवसनां वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027953, "chapter_id": 1601, "verse_number": "३-२३९-११", "content_sanskrit": "यदि मां दर्मराजश्च भीमसेनश्च पाण्डवः।\nयुक्तं रपरमया लक्ष्म्या पश्येतां जीवितं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027954, "chapter_id": 1601, "verse_number": "३-२३९-१२", "content_sanskrit": "उपायं न तु पश्यामि येन गच्छेम तद्वनम्।\nयथाचाभ्यनुजानीयाद्गच्छन्तं मां महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027955, "chapter_id": 1601, "verse_number": "३-२३९-१३", "content_sanskrit": "स सौबलेन सहितस्तथा दुःशासनेन च।\nउपायं पश्य रनिपुणं येन गच्छेम तद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027956, "chapter_id": 1601, "verse_number": "३-२३९-१४", "content_sanskrit": "अहमप्यनुगच्छामि गमनायेतराय च।\nकल्यमेव गमिष्यामि समीपं पार्थिवस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027957, "chapter_id": 1601, "verse_number": "३-२३९-१५", "content_sanskrit": "मयि तत्रोपविष्टे तु भीष्मे च कुरुसत्तमे।\nउपायो यो भवेद्दृष्टस्तं ब्रूयाः सहसौबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027958, "chapter_id": 1601, "verse_number": "३-२३९-१६", "content_sanskrit": "ततो भीष्मस्य राज्ञश्च निशम्य रगमनं प्रति।\nव्यवसायं करिष्येऽहमनुनीय पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027959, "chapter_id": 1601, "verse_number": "३-२३९-१७", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वेग्मुरावसथान्प्रति।\nव्युषितायां रजन्यां तु कर्णो राजानमभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027960, "chapter_id": 1601, "verse_number": "३-२३९-१८", "content_sanskrit": "ततो दुर्योधनं कर्णः प्रहसन्निदमब्रवीत्।\nउपायः परिदृष्टोऽयं तं निबोधजनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027961, "chapter_id": 1601, "verse_number": "३-२३९-१९", "content_sanskrit": "घोषा द्वैतवने सर्वेत्वत्प्रतीक्षा नराधिप।\nघोषयात्रापदेशेन गमिष्यामो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027962, "chapter_id": 1601, "verse_number": "३-२३९-२०", "content_sanskrit": "उचितं हि सदा गन्तुं घोषयात्रां विशांपते।\nएवं चेत्त्वां पिता राजन्समनुज्ञातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027963, "chapter_id": 1601, "verse_number": "३-२३९-२१", "content_sanskrit": "तथा कथयमानौ तु घोषयात्राविनिश्चयम्।\nगान्धारराजः शकुनिरित्युवाच हसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027964, "chapter_id": 1601, "verse_number": "३-२३९-२२", "content_sanskrit": "उपायोऽयंमया दृष्टो गमनाय निरामयः।\nअनुज्ञास्यतिनो राजा चोदयिष्यति चाप्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027965, "chapter_id": 1601, "verse_number": "३-२३९-२३", "content_sanskrit": "घोषा द्वैतव्रने सर्वेत्वत्प्रतीक्षा नराधिप।\nघोषयात्रापदेशेन गमिष्यामः सरः प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027966, "chapter_id": 1601, "verse_number": "३-२३९-२४", "content_sanskrit": "ततः प्रहसिताः सर्वे तेऽन्योन्यस्य तलान्ददुः।\nतदेव च विनिश्चेत्य ददृशुः कुरुसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027967, "chapter_id": 1601, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि एकोनचत्वारिंशदधिकद्विशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]