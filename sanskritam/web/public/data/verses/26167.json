[{"id": 7006167000, "chapter_id": 26167, "verse_number": "१-२-२८-१", "content_sanskrit": "सूत उवाच ।\nऋषिकाणां सुताश्चापि विज्ञेया ऋषिपुत्रकाः ।\nब्राह्यणानां प्रवक्तारो नामतश्च निबोधत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006167001, "chapter_id": 26167, "verse_number": "१-२-२८-२", "content_sanskrit": "सप्रधानाः प्रवक्ष्यन्ते समासाच्च श्रुतर्षयः ।\nबह्वृचो भार्गवः पैलः सांकृत्यो जाजलिस्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006167002, "chapter_id": 26167, "verse_number": "१-२-२८-३", "content_sanskrit": "संध्यास्तिर्माठरश्चैव याज्ञवल्क्यः पराशरः ।\nउपमन्युरिंद्रप्रमतिर्माडूकिः शाकलिश्च सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006167003, "chapter_id": 26167, "verse_number": "१-२-२८-४", "content_sanskrit": "बाष्कलिः शोकपाणिश्च नैलः पैलोऽलकस्तथा ।\nपन्नगाः पक्षगंताश्च षडशीतिः श्रुतर्षयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006167004, "chapter_id": 26167, "verse_number": "१-२-२८-५", "content_sanskrit": "एते द्विजातयो मुख्या बह्वृचानां श्रुतर्षयः ।\nवैशंपायनलौहित्यौ कंठकालावशावधः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006167005, "chapter_id": 26167, "verse_number": "१-२-२८-६", "content_sanskrit": "श्यामापतिः पलाडुश्च आलंबिः कमलापतिः ।\nतेषां शिष्याः प्रशिष्याश्च षडशीति श्रुतर्षयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006167006, "chapter_id": 26167, "verse_number": "१-२-२८-७", "content_sanskrit": "एते द्विजर्षयः प्रोक्ताश्चरकाध्वर्यवो द्विजाः ।\nचैमिनिः सभरद्वाजः काव्यः पौष्यंजिरेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006167007, "chapter_id": 26167, "verse_number": "१-२-२८-८", "content_sanskrit": "हिरण्यनाभः कौशिल्यो लौगाक्षिः कुसुमिस्तथा ।\nलंगली शालिहोत्रश्च शक्तिराजश्च भार्गवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006167008, "chapter_id": 26167, "verse_number": "१-२-२८-९", "content_sanskrit": "सामगानामथाचार्य ऐलो राजा पुरूरवाः ।\nषट्चत्वारिंशदन्ये वै तेषां शिष्याः श्रुतर्षयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006167009, "chapter_id": 26167, "verse_number": "१-२-२८-१०", "content_sanskrit": "कौशीतिः कंकमुद्गश्च कुंडकः सपराशरः ।\nलोभालोभश्च धर्मात्मा तथा ब्रह्म बलश्च सः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006167010, "chapter_id": 26167, "verse_number": "१-२-२८-११", "content_sanskrit": "क्रंथलोऽथो मदगलो मार्कंडेयोऽथ धर्मवित् ।\nइत्येते नवतिर्ज्ञेया होत्रवद्ब्रह्मचारिणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006167011, "chapter_id": 26167, "verse_number": "१-२-२८-१२", "content_sanskrit": "चरकाध्वर्यवश्चापि ह्यनुमंन्त्रं तु ब्राह्मणम् ।\nचलूभिः सुमतिश्चैव तथा देववरश्च यः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006167012, "chapter_id": 26167, "verse_number": "१-२-२८-१३", "content_sanskrit": "अनुकृष्णस्तथायुश्च अनुभूमिस्तथैव च ।\nतथाप्रीतः कृशाश्वश्व सुमूलिर्बाष्कलिस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006167013, "chapter_id": 26167, "verse_number": "१-२-२८-१४", "content_sanskrit": "चरकाध्वर्यकाध्वर्युनमस्युर्ब्रह्मचारिणः ।\nवैयासकिः शुको विद्वाँल्लौकिर्भूरिश्रवास्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006167014, "chapter_id": 26167, "verse_number": "१-२-२८-१५", "content_sanskrit": "सोमाविरतुनांतक्यस्तथा धौम्यश्च काश्यपः ।\nआरण्या इलकश्चैव उपमन्युर्विदस्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006167015, "chapter_id": 26167, "verse_number": "१-२-२८-१६", "content_sanskrit": "भार्गवो मधुकः पिंगः श्वेत केतुस्तथैव च ।\nप्रजादर्पः कहोडश्च याज्ञवल्क्योऽथ शौनकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006167016, "chapter_id": 26167, "verse_number": "१-२-२८-१७", "content_sanskrit": "अनंगो निरतालश्च मध्यमाध्वर्यवस्तुते ।\nअदितिर्देवमाता च जलापा चैव मानवी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006167017, "chapter_id": 26167, "verse_number": "१-२-२८-१८", "content_sanskrit": "उर्वशी विश्वयोषा च ह्यप्सरःप्रवरे शुभे ।\nमुद्गला चातुजीवैव तारा चैव यशस्विनी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006167018, "chapter_id": 26167, "verse_number": "१-२-२८-१९", "content_sanskrit": "प्रातिमेधी च मार्गा च सुजाता च महातपा ।\nलोपामुद्रा च धर्मज्ञा या च कोशीतिका स्मृता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006167019, "chapter_id": 26167, "verse_number": "१-२-२८-२०", "content_sanskrit": "एताश्च ब्रह्मवादिन्य अप्सरो रूपंसमताः ।\nइत्येता मुख्यशः प्रोक्ता मया च ऋषिपुत्रकाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006167020, "chapter_id": 26167, "verse_number": "१-२-२८-२१", "content_sanskrit": "वैदशाखाप्रणयनास्ततस्ते ऋषयः स्मृताः ।\nईश्वरा मंत्रवक्तार ऋषयो ह्यृषिकास्तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006167021, "chapter_id": 26167, "verse_number": "१-२-२८-२२", "content_sanskrit": "ऋषिपुत्राः प्रवक्तरः कल्पानां ब्राह्मणस्य तु ।\nईश्वराणामृषीणां च ऋषिकाणां सहात्मजैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006167022, "chapter_id": 26167, "verse_number": "१-२-२८-२३", "content_sanskrit": "तथा वाक्यानि जनीष्व यथैषां मंत्रदृष्टयः ।\nतत्राज्ञायुक्तमद्वैतं दीप्तं गंभीरशब्दवत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006167023, "chapter_id": 26167, "verse_number": "१-२-२८-२४", "content_sanskrit": "अत्यंतमपरोक्षं च लिंगं नाम तथैव च ।\nसर्वभूतान्यभूतं च परिदानं च यद्भवेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006167024, "chapter_id": 26167, "verse_number": "१-२-२८-२५", "content_sanskrit": "क्वचिन्निरुक्तप्रोक्तार्थं वाक्यं स्वायंभुवं विदुः ।\nयत्किंचिन्मंत्रसंयुक्तं तत्र नामविभक्तिभिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006167025, "chapter_id": 26167, "verse_number": "१-२-२८-२६", "content_sanskrit": "प्रत्यक्षाभिहितं चैवमृषीणां वचनं मतम् ।\nनैगमैर्विविधैः शब्दैर्निपातैर्बहुलं च यत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006167026, "chapter_id": 26167, "verse_number": "१-२-२८-२७", "content_sanskrit": "यच्चाप्यस्ति महद्वाक्यमृषीकाणां वचः स्मृतम् ।\nअविस्पष्टपदं यच्च यच्च स्याद्बहुसंशयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006167027, "chapter_id": 26167, "verse_number": "१-२-२८-२८", "content_sanskrit": "ऋषिपुत्रवचस्तद्वै सर्वाश्च परिदेवताः ।\nहेतुदृष्टांत बहुलं चित्रशब्दमपार्थकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006167028, "chapter_id": 26167, "verse_number": "१-२-२८-२९", "content_sanskrit": "सर्वास्तु तमशक्तं च वाक्यमेतत्तु मानुषम् ।\nमिश्रा इति समाख्याताः प्रभावादृषितां गाताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006167029, "chapter_id": 26167, "verse_number": "१-२-२८-३०", "content_sanskrit": "समुत्कर्षाय कर्षाभ्यां जातिव्यत्याससंभवाः ।\nभूतभव्यभवज्ज्ञान जन्मदुःखचिकित्सनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006167030, "chapter_id": 26167, "verse_number": "१-२-२८-३१", "content_sanskrit": "मिश्राणां तद्भवेद्वाक्यं गुरोर्बलप्रवर्त्तनम् ।\nधर्मशास्त्रप्रणेतारो महिम्ना सर्वगाश्च वै ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006167031, "chapter_id": 26167, "verse_number": "१-२-२८-३२", "content_sanskrit": "तपःप्रकर्षः सुमहान्येषां ते ऋषयः स्मृताः ।\nबृहस्पतिश्च शुक्रश्च व्यासः सारस्वतस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006167032, "chapter_id": 26167, "verse_number": "१-२-२८-३३", "content_sanskrit": "व्यासाः शास्त्रप्रणयना वेदव्यास इति स्मृताः ।\nयस्मादवारजाः संतः पूर्वेभ्यो मेधयाधिकाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006167033, "chapter_id": 26167, "verse_number": "१-२-२८-३४", "content_sanskrit": "ऐश्वर्येण च संपन्नास्ततस्ते ऋषयः स्मृताः ।\nयस्मिन्कालो न चं वयः प्रमाणमृषिभावने ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006167034, "chapter_id": 26167, "verse_number": "१-२-२८-३५", "content_sanskrit": "दृश्यते हि पुमान्कश्चित्कश्चिज्ज्येष्ठतमो धिया ।\nयस्माद्बुद्ध्या च वर्षीयान्बलोऽपि श्रुतवानृषिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006167035, "chapter_id": 26167, "verse_number": "१-२-२८-३६", "content_sanskrit": "यः कश्चित्पादवान्मध्ये प्रयुक्तोऽक्षर संपदा ।\nविनियुक्तावसानां तु तामृचं परिचक्षते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006167036, "chapter_id": 26167, "verse_number": "१-२-२८-३७", "content_sanskrit": "यः कश्चित्करणैर्मंत्रो न च पादक्षरैर्मितः ।\nअतियुक्तावसानं च तद्यजुर्वै प्रचक्षते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006167037, "chapter_id": 26167, "verse_number": "१-२-२८-३८", "content_sanskrit": "ह्रींकारः प्रणवो गीतः प्रस्तावश्च चतुर्थकम् ।\nपंचमः प्रतिहोत्रश्च षष्ठमाहुरुपद्रवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006167038, "chapter_id": 26167, "verse_number": "१-२-२८-३९", "content_sanskrit": "निधनं सप्तमं साम्नः सप्तविंध्य मिदं स्मृतम् ।\nपंचविंध्य इति प्रोक्तं ह्रींकारः प्रणवादृते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006167039, "chapter_id": 26167, "verse_number": "१-२-२८-४०", "content_sanskrit": "ब्रह्मणे धर्ममत्युक्तौ यत्तदा ज्ञाप्यतेऽर्थतः ।\nआशास्तिस्तु प्रसंख्याता विलापः परिदेवना ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006167040, "chapter_id": 26167, "verse_number": "१-२-२८-४१", "content_sanskrit": "क्रोधाद्वा द्वेषणाच्चैव प्रश्राख्यानं तथैव च ।\nएतत्तु सर्वविद्यानां विहितं मंत्रलक्षणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006167041, "chapter_id": 26167, "verse_number": "१-२-२८-४२", "content_sanskrit": "मंत्रा नवविधाः प्रोक्ता ऋग्यजुः सामलक्षणाः ।\nमूर्तिर्निन्दा प्रशंसा चाक्रोशस्तोषस्तथैव च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006167042, "chapter_id": 26167, "verse_number": "१-२-२८-४३", "content_sanskrit": "प्रश्रानुज्ञास्तथाख्यानमाशास्मतिविधयो मताः ।\nमंत्रभेदांश्च वक्ष्यामि चतुर्विशतिलक्षणान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006167043, "chapter_id": 26167, "verse_number": "१-२-२८-४४", "content_sanskrit": "प्रशंसा स्तुतिराक्रोशो निंदा च परिदेवना ।\nअभिशापो विशापश्च प्रश्नः प्रतिवचस्तथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006167044, "chapter_id": 26167, "verse_number": "१-२-२८-४५", "content_sanskrit": "आशीर्यज्ञस्तथाऽक्षेप अर्थाख्यानं च संकथा ।\nवियोगा ह्यभियोगाश्च कथा संस्था वरश्च वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006167045, "chapter_id": 26167, "verse_number": "१-२-२८-४६", "content_sanskrit": "प्रतिषेधोप देशौ च नमस्कारः स्पृहा तथा ।\nविलापश्चेति मंत्राणां चतुर्विंशतिरुद्धृताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006167046, "chapter_id": 26167, "verse_number": "१-२-२८-४७", "content_sanskrit": "ऋषिभिर्यज्ञतत्त्वज्ञैर्विहितं ब्रह्मणं पुरा ।\nहेतु र्निर्वचनं निन्दा प्रशस्तिः संशयो निधिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006167047, "chapter_id": 26167, "verse_number": "१-२-२८-४८", "content_sanskrit": "पुराकृतिपुराकल्पौ व्यवधारणकल्पना ।\nुपमा च दशैते वै विधयो ब्राह्मणस्य तु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006167048, "chapter_id": 26167, "verse_number": "१-२-२८-४९", "content_sanskrit": "लक्षणं ब्राह्मणस्यैनद्विहितं सर्वशाखिनाम ।\nहेतुर्हंतेः स्मृतो धातोर्यन्निहंत्युदितं परैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006167049, "chapter_id": 26167, "verse_number": "१-२-२८-५०", "content_sanskrit": "अथवार्थे परिप्राप्ते हिनो तेर्गतिकर्मणा ।\nतथा निर्वचनं ब्रूयाद्वाक्यार्थस्यावधारणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006167050, "chapter_id": 26167, "verse_number": "१-२-२८-५१", "content_sanskrit": "निन्दां तामाहुरायार्या यद्दोषे निन्दनं वचः ।\nप्रपूर्वाच्छंसतेर्धातोः प्रशंसागुणवत्तया ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006167051, "chapter_id": 26167, "verse_number": "१-२-२८-५२", "content_sanskrit": "इदं त्विदमिदं नैदमित्यनिश्चित्य संशयम् ।\nइदमेवं विधातव्यमित्ययं विधिरुच्यते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006167052, "chapter_id": 26167, "verse_number": "१-२-२८-५३", "content_sanskrit": "अन्यस्यान्यस्य चौक्तिर्या बुधैः सोक्ता पुराकृतिः ।\nयो ह्यत्यंतपरोक्षार्थः स पुराकल्प उच्यते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006167053, "chapter_id": 26167, "verse_number": "१-२-२८-५४", "content_sanskrit": "पुरातिक्रांतवाचित्वात्पुराकल्पस्य कल्प नाम् ।\nमंत्रब्राह्मणकल्पैश्च निगमैः शुद्धविस्तरैः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006167054, "chapter_id": 26167, "verse_number": "१-२-२८-५५", "content_sanskrit": "अनिश्चित्य कृतामाहुर्व्यवधारणकल्पनाम् ।\nयथा हीदं तथा तद्वै इदं चैव तथैव तत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006167055, "chapter_id": 26167, "verse_number": "१-२-२८-५६", "content_sanskrit": "इत्येवमेषा ह्युपमा दशमो ब्राह्मणस्य तु ।\nइत्येतद्ब्रह्मणस्यादौ विहितं रक्षणं बुधैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006167056, "chapter_id": 26167, "verse_number": "१-२-२८-५७", "content_sanskrit": "तस्य तद्विद्भिरुद्दिष्टा व्याख्याम्यनुपदं द्विजैः ।\nमंत्राणां कल्पना चैव विधिदृष्टिषु कर्मसु ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006167057, "chapter_id": 26167, "verse_number": "१-२-२८-५८", "content_sanskrit": "मंत्रो मन्त्रयतेर्द्धातोर्ब्राह्मणो ब्राह्मणेन तु ।\nअल्पाक्षरमसंदिग्धं सारवद्विश्वतोमुखम् ।\nअस्तोभमनवद्यं च सूत्रं सूत्रविदो विदुः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]