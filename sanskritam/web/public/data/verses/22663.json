[{"id": 7002663000, "chapter_id": 22663, "verse_number": "७-६-१", "content_sanskrit": "सूत उवाच ।\nएकदा रत्नभानुर्हि महीराजेन पालिताम् ।\nदिशं याम्यां स वै जित्वा तेषां कोशानुपाहरत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002663001, "chapter_id": 22663, "verse_number": "७-६-२", "content_sanskrit": "महीराजस्तु तच्छुत्वा परं विस्मयमागतः ।\nरत्नभानोश्च तिलको बभूव बहुविस्तरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002663002, "chapter_id": 22663, "verse_number": "७-६-३", "content_sanskrit": "तिलका नाम विख्याता या तु वीरवती शुभा ।\nश्रेष्ठा द्वादशराज्ञीनां जननी लक्षणस्य वै ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002663003, "chapter_id": 22663, "verse_number": "७-६-४", "content_sanskrit": "जयचंद्रस्य भूपस्य योषितः षोडशाभवन् ।\nतासां न तनयो ह्यासीत्पूर्वकर्मविपाकतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002663004, "chapter_id": 22663, "verse_number": "७-६-५", "content_sanskrit": "गौडभूपस्य दुहिता नाम्ना दिव्यविभावरी ।\nजयचंद्रस्य महिषी तद्दासी सुरभानवी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002663005, "chapter_id": 22663, "verse_number": "७-६-६", "content_sanskrit": "रूपयौवन संयुक्ता रतिकेलिविशारदा ।\nदृष्ट्वा तां स नृपः कामी बुभुजे स्मरपीडितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002663006, "chapter_id": 22663, "verse_number": "७-६-७", "content_sanskrit": "तस्याः स्वयंवरे राजाह्वयद्भूपान्महाशुभान् ।\nभूमिराजस्तु बलवाञ्छ्रुत्वा तद्रूपमुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002663007, "chapter_id": 22663, "verse_number": "७-६-८", "content_sanskrit": "तस्यां जाता सुता देवी नाम्ना संयोगिनी शुभा ।\nद्वादशाब्दवयः प्राप्ता सा बभूव वरांगना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002663008, "chapter_id": 22663, "verse_number": "७-६-९", "content_sanskrit": "विवाहार्थे मनश्चासीच्चंद्रभट्टमचोदयत् ।\nमंत्रिप्रवर भो मित्र चंद्रभट्ट मम प्रिय ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002663009, "chapter_id": 22663, "verse_number": "७-६-१०", "content_sanskrit": "कान्यकुब्जपुरीं प्राप्य मन्मूर्तिं स्वर्णनिर्मिताम् ।\nस्थापय त्वं सभामध्ये यद्वृत्तांतं तु मे वद ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002663010, "chapter_id": 22663, "verse_number": "७-६-११", "content_sanskrit": "इति श्रुत्वा चंद्रभट्टो भवानीभक्तितत्परः ।\nगत्वा तत्र भृगुश्रेष्ठ यथा प्रोक्तस्तथाकरोत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002663011, "chapter_id": 22663, "verse_number": "७-६-१२", "content_sanskrit": "स्वयंवरे च भूपाश्च नानादेश्याः समागताः ।\nत्यक्त्वा संयोगिनी तान्वै नृपमूर्तिविमोहिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002663012, "chapter_id": 22663, "verse_number": "७-६-१३", "content_sanskrit": "पितरं प्राह कामाक्षी यस्य मूर्तिरियं नृप ।\nभविष्यति स मे भर्ता सर्वलक्षणलक्षितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002663013, "chapter_id": 22663, "verse_number": "७-६-१४", "content_sanskrit": "जयचंद्रस्तु तच्छ्रुत्वा चंद्रभद्रमुवाच तम् ।\nयदि ते भूपतिश्चैव सर्वसैन्यसमन्वितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002663014, "chapter_id": 22663, "verse_number": "७-६-१५", "content_sanskrit": "सञ्जयेद्योगिनीमेतां तर्हि मेऽतिप्रियो भवेत् ।\nचंद्रभट्टस्तु तच्छ्रुत्वा तत्तु सर्वमवर्णयत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002663015, "chapter_id": 22663, "verse_number": "७-६-१६", "content_sanskrit": "पृथिवीराज एवासौ श्रुत्वा सैन्यमचोदयत् ।\nएकलक्षा गजास्तस्य सप्तलक्षास्तुरंगमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002663016, "chapter_id": 22663, "verse_number": "७-६-१७", "content_sanskrit": "रथाः पंचसहस्राश्च धनुर्बाणविशारदाः ।\nलक्षाः पदातयो ज्ञेया द्वादशैव महाबलाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002663017, "chapter_id": 22663, "verse_number": "७-६-१८", "content_sanskrit": "राजानस्त्रिशतान्येव महीराजपदानुगाः ।\nसार्द्धं द्वाभ्यां च बन्धुभ्यां कान्यकुब्जे नृपोऽगमत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002663018, "chapter_id": 22663, "verse_number": "७-६-१९", "content_sanskrit": "धुन्धुकारश्च तद्बन्धुर्गजानीकपतिस्सदा ।\nहयानीकपतिः कृष्ण कुमारो बलवत्तरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002663019, "chapter_id": 22663, "verse_number": "७-६-२०", "content_sanskrit": "पदातीनां नृपतयः पतयस्तत्र चाभवन् ।\nमहान्कोलाहलो जातः स्थलीं शून्यामकारयन् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002663020, "chapter_id": 22663, "verse_number": "७-६-२१", "content_sanskrit": "विंशत्कोशप्रमाणेन स्थितं तस्य महाबलम् ।\nजयचंद्रस्तु संज्ञाय महीराजस्य चागमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002663021, "chapter_id": 22663, "verse_number": "७-६-२२", "content_sanskrit": "स्वसैन्यं कल्पयामास लक्षषोडशसंमितम् ।\nएकलक्षा गजास्तस्य सप्तलक्षाः पदातयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002663022, "chapter_id": 22663, "verse_number": "७-६-२३", "content_sanskrit": "वाजिनश्चाष्टलक्षाश्च सर्वयुद्धविशारदाः ।\nद्विशतान्येव राजानः प्राप्तास्तत्र समागमे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002663023, "chapter_id": 22663, "verse_number": "७-६-२४", "content_sanskrit": "आगस्कृतं महीराजं मत्वा ते शुक्लवंशिनः ।\nयुद्धार्थिनः स्थितास्तत्र पुरमागस्कृतं ह्यभूत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002663024, "chapter_id": 22663, "verse_number": "७-६-२५", "content_sanskrit": "ईशनद्याः परे कूले तद्दोला स्थपिता तदा ।\nनाना वाद्यानि रम्याणि तत्र चक्रुर्महारवम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002663025, "chapter_id": 22663, "verse_number": "७-६-२६", "content_sanskrit": "रत्नभानुर्गजानीके रूपानीके हि लक्षणः ।\nतस्यां सेनापतिभ्यां तौ संगुप्तौ बलवत्तरौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002663026, "chapter_id": 22663, "verse_number": "७-६-२७", "content_sanskrit": "प्रद्योतश्चैव विद्योतो रत्नभानुं ररक्षतुः ।\nभीष्मः परिमलश्चैव लक्षणं चंद्रवंशजः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002663027, "chapter_id": 22663, "verse_number": "७-६-२८", "content_sanskrit": "भूपाः पदातिसैन्ये च संस्थिता मदविह्वलाः ।\nतयोश्चासीन्महद्युद्धं दारुणं सैन्यसंक्षयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002663028, "chapter_id": 22663, "verse_number": "७-६-२९", "content_sanskrit": "हया हयैर्मृता जाता गजाश्चैव गजैस्तथा ।\nपदातयः पदातैश्च मृताश्चान्ये क्रमाद्रणे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002663029, "chapter_id": 22663, "verse_number": "७-६-३०", "content_sanskrit": "भूपैश्च रक्षिताः सर्वे निर्भया रणमाययुः ।\nयावत्सूर्यः स्थितो व्योम्नि तावद्युद्धमवर्तत ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002663030, "chapter_id": 22663, "verse_number": "७-६-३१", "content_sanskrit": "एवं पंचदिनं जातं युद्धं वीरजनक्षयम् ।\nगजा दशसहस्रणि हया लक्षाणि संक्षिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002663031, "chapter_id": 22663, "verse_number": "७-६-३२", "content_sanskrit": "पंचलक्षं महीभर्तुर्हतास्तत्र पदातयः ।\nराजानो द्वे शते तत्र रथाश्च त्रिशतं तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002663032, "chapter_id": 22663, "verse_number": "७-६-३३", "content_sanskrit": "कान्यकुब्जाधिपस्यैव गजा नवसहस्रकाः ।\nसहस्रैकं रथा ज्ञेयास्त्रिलक्षं च पदातयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002663033, "chapter_id": 22663, "verse_number": "७-६-३४", "content_sanskrit": "एकलक्षं हयास्तत्र मृताः स्वर्गपुरं ययुः ।\nषष्ठाहे समनुप्राप्ते पृथिवीराज एव सः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002663034, "chapter_id": 22663, "verse_number": "७-६-३५", "content_sanskrit": "दुःखितो मनसा देवं रुद्रं तुष्टाव भक्तिमान् ।\nसंतुष्टस्तु महादेवो मोहयामास तद्बलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002663035, "chapter_id": 22663, "verse_number": "७-६-३६", "content_sanskrit": "प्रसन्नस्तु महीराजो गतः संयोगिनीं प्रति ।\nदृष्ट्वा तत्सुन्दरं रूपं मुमोह वसुधाधिपः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002663036, "chapter_id": 22663, "verse_number": "७-६-३७", "content_sanskrit": "संयोगिनी नृपं दृष्ट्वा मूर्च्छिता चाभवत्क्षणात् ।\nएतस्मिन्नंतरे राजा तद्दोलामनयद्बलात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002663037, "chapter_id": 22663, "verse_number": "७-६-३८", "content_sanskrit": "जगाम देहलीं भूपः सर्वसैन्यसमन्वितः ।\nयोजनान्ते गते तस्मिन्बोधितास्ते मदोद्भटाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002663038, "chapter_id": 22663, "verse_number": "७-६-३९", "content_sanskrit": "दृष्ट्वा नैव तदा दोलां प्रजग्मुर्वेगवत्तराः ।\nश्रुत्वा कोलाहलं तेषां महीराजो नृपोत्तमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002663039, "chapter_id": 22663, "verse_number": "७-६-४०", "content_sanskrit": "अर्द्धसैन्यं च संस्थाप्य स्वयं गेहमुपागमत् ।\nउभौ तद्भ्रातरौ वीरौ चार्द्धसैन्यसमन्वितौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002663040, "chapter_id": 22663, "verse_number": "७-६-४१", "content_sanskrit": "सूकरक्षेत्रमासाद्य युद्धाय समुपस्थितौ ।\nएतस्मिन्नन्तरे सर्वे प्रद्योतादिमहाबलाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002663041, "chapter_id": 22663, "verse_number": "७-६-४२", "content_sanskrit": "स्वसैन्यैः सह संप्राप्य महद्युद्धमकारयन् ।\nहया हयैश्च संजग्मुर्गजा अथ गजैः सह ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002663042, "chapter_id": 22663, "verse_number": "७-६-४३", "content_sanskrit": "संकुलश्च महानासीद्दारुणो लोमहर्षणः ।\nदिनान्ते संक्षयं यातं तयोश्चैव महद्बलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002663043, "chapter_id": 22663, "verse_number": "७-६-४४", "content_sanskrit": "भयभीता परे तत्र ज्ञात्वा रात्रिं तमोवृताम् ।\nप्रदुद्रुवुर्भयाद्वीरा हतशेषास्तु देहलीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002663044, "chapter_id": 22663, "verse_number": "७-६-४५", "content_sanskrit": "प्रद्योताद्याश्च ते वीरा देहलीं प्रति संययुः ।\nपुनस्तयोर्महद्युद्धं ह्यभवल्लोमहर्षणम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002663045, "chapter_id": 22663, "verse_number": "७-६-४६", "content_sanskrit": "धुंधुकारश्च प्रद्योतं हृदि बाणैरताडयत् ।\nत्रिभिश्च विषनिर्धूतैर्मूछितः स ममार च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002663046, "chapter_id": 22663, "verse_number": "७-६-४७", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा विद्योतश्च महावलः ।\nआजगाम गजारूढो धुंधुकारमताडयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002663047, "chapter_id": 22663, "verse_number": "७-६-४८", "content_sanskrit": "त्रिभिश्च तोमरैः सोऽपि मूर्छितो भूमिमागमत् ।\nमूर्छितं भ्रातरं दृष्ट्वा धुंधुकारं महाबलम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002663048, "chapter_id": 22663, "verse_number": "७-६-४९", "content_sanskrit": "तदा कृष्णकुमारोऽसौ गजस्थस्त्वरितो ययौ ।\nरूपाविष्टश्च तं वीरं भल्लेनैवमताड यत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002663049, "chapter_id": 22663, "verse_number": "७-६-५०", "content_sanskrit": "भल्लेन तेन संभिन्नो मृतः स्वर्गपुरं ययौ ।\nविद्योते निहते तस्मित्सर्वसैन्यचमूपतौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002663050, "chapter_id": 22663, "verse_number": "७-६-५१", "content_sanskrit": "रत्नाभानुर्महावीरोऽयुध्यत्तेन समन्वितः ।\nएतस्मिन्नंतरे राजा सहस्रगजसंयुतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002663051, "chapter_id": 22663, "verse_number": "७-६-५२", "content_sanskrit": "लक्षणं सहितं ताभ्यां क्रुद्धं तं समयुध्यत ।\nशिवदत्तवरो राजा भीष्मं परिमलं रुषा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002663052, "chapter_id": 22663, "verse_number": "७-६-५३", "content_sanskrit": "रुद्रास्त्रैर्मोहयामास लक्षणं बलवत्तरम् ।\nमूर्छितांस्तान्समालोक्य रत्नभानुः शरैर्निजैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002663053, "chapter_id": 22663, "verse_number": "७-६-५४", "content_sanskrit": "धुंधुकारं महीराजं वैष्णवैः सममोजयन् ।\nकृष्णको रत्नभानुश्च युयुधाते परस्परम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002663054, "chapter_id": 22663, "verse_number": "७-६-५५", "content_sanskrit": "उभौ समबलौ वीरौ गजपृष्ठस्थितौ रणे ।\nअन्योन्यनिहतौ नागौ खङ्गहस्तौ मही तले ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002663055, "chapter_id": 22663, "verse_number": "७-६-५६", "content_sanskrit": "युयुधाते बहून्मार्गान्कृतवंतौ सुदुर्जयौ ।\nप्रहरान्तं रणं कृत्वा मरणायोपजग्मतुः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002663056, "chapter_id": 22663, "verse_number": "७-६-५७", "content_sanskrit": "हते तस्मिन्महावीर्ये कान्यकुब्जा भयातुराः ।\nमूर्छितांस्त्रीन्समादाय पंचलक्षबलैर्युताः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002663057, "chapter_id": 22663, "verse_number": "७-६-५८", "content_sanskrit": "रणं त्यक्त्वा गृहं जग्मुर्नृपशोकपरायणाः ।\nरत्नभानौ च निहते हतोत्साहाश्च भूमिपाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002663058, "chapter_id": 22663, "verse_number": "७-६-५९", "content_sanskrit": "स्वंस्वं निवेशनं जग्मुर्महीराजभयातुराः ।\nदेवानाराधयामासुर्यथेष्टं ते गृहे गृहे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002663059, "chapter_id": 22663, "verse_number": "७-६-६०", "content_sanskrit": "महीराजस्तु बलवान्सप्तलक्षबलान्वितः ।\nधुंधुकारेण सहितो वंधुकृत्योर्ध्वमाचरत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002663060, "chapter_id": 22663, "verse_number": "७-६-६१", "content_sanskrit": "तथा भीष्मः परिमलो लक्षणः पितरं स्वकम् ।\nगंगाकूले समागम्य चौर्ध्वदैहिकमाचरन् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002663061, "chapter_id": 22663, "verse_number": "७-६-६२", "content_sanskrit": "भूमिराजस्य विजयो जयचंदयशो रणे ।\nप्रसिद्धमभवद्भूमौ गेहेगेहे जनेजने ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002663062, "chapter_id": 22663, "verse_number": "७-६-६३", "content_sanskrit": "जयचंद्रः कान्यकुब्जे देहल्यां पृथिवीपतिः ।\nउत्सवं कारयित्वा तु परमानन्दमाययौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]