[{"id": 2101157, "chapter_id": 3176, "verse_number": "१४-३२-१", "content_sanskrit": "ब्राह्मण उवाच।\nत्रयो वै रिपवो लोके नवधा गुणतः स्मृताः।\nहर्षः स्तंभोतिमानश्च त्रयस्ते सात्विका गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101158, "chapter_id": 3176, "verse_number": "१४-३२-२", "content_sanskrit": "शोकः क्रोधाभिसंरम्भो राजसास्ते गुणाः स्मृताः।\nस्वप्नस्तन्द्रा च मोहश्च त्रयस्ते तामसा गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101159, "chapter_id": 3176, "verse_number": "१४-३२-३", "content_sanskrit": "एतान्निकृत्य धृतिमान्बाणसङ्घैरतन्द्रितः।\nजेतुं परानुत्सहते प्रशान्तात्मा जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101160, "chapter_id": 3176, "verse_number": "१४-३२-४", "content_sanskrit": "अत्र गाथाः कीर्तयन्ति पुराकल्पविदो जनाः।\nअम्बरीषेण या गीता राज्ञा राज्यं प्रशासता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101161, "chapter_id": 3176, "verse_number": "१४-३२-५", "content_sanskrit": "समुदीर्णेषु दोषेषु बाध्यमानेषु साधुषु।\nजग्राह तरसा राज्यमम्बरीष इति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101162, "chapter_id": 3176, "verse_number": "१४-३२-६", "content_sanskrit": "स निगृह्यात्मनो दोषान्साधून्समभिपूज्य च।\nजगाम महतीं सिद्धिं गाथाश्चेमा जगाद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101163, "chapter_id": 3176, "verse_number": "१४-३२-७", "content_sanskrit": "भूयिष्ठं विजिता दोषा निहताः सर्वशत्रवः।\nएको दोषो वरिष्ठश्च वध्यः स न हतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101164, "chapter_id": 3176, "verse_number": "१४-३२-८", "content_sanskrit": "यत्प्रयुक्तो जन्तुरयं वैतृष्ण्यं नाधिगच्छति।\nतृष्णार्त इव निम्नानि धावमानो न बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101165, "chapter_id": 3176, "verse_number": "१४-३२-९", "content_sanskrit": "अकार्यमपि येनेह प्रयुक्तः सेवते नरः।\nतं लोभमसिभिस्तीक्ष्णैर्निकृत्य सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101166, "chapter_id": 3176, "verse_number": "१४-३२-१०", "content_sanskrit": "लोभाद्धि जायते तृष्णा ततश्चिन्ता प्रवर्तते।\nस लिप्समानो लभते भूयिष्ठं राजसान्गुणान्।\nतदवाप्तौ तु लभते भूयिष्ठं तामसान्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101167, "chapter_id": 3176, "verse_number": "१४-३२-११", "content_sanskrit": "स तैर्गुणैः संहतदेहबन्धनः।\nपुनःपनर्जायति कर्म चेहते।\nजन्मक्षये भिन्नविकीर्मदेहो\nमृत्युं पुनर्गच्छति जन्मनैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101168, "chapter_id": 3176, "verse_number": "१४-३२-१२", "content_sanskrit": "तस्मादेतं सम्यगवेक्ष्य लोभं\nनिगृह्य धृत्याऽऽत्मनि राज्यमिच्छेत्।\nएतद्राज्यं नान्यदस्तीह राज्य-\nमात्मैव राजा विदितो यथावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101169, "chapter_id": 3176, "verse_number": "१४-३२-१३", "content_sanskrit": "इति राज्ञाऽम्बरीषेण गाथा गीता यशस्विना।\nआधिराज्य पुरस्कृत्य लोभमेकं निकृन्तता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101170, "chapter_id": 3176, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्वात्रिंशोऽध्यायः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]