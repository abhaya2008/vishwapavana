[{"id": 6000176000, "chapter_id": 10176, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000176001, "chapter_id": 10176, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000176002, "chapter_id": 10176, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.001.m4a", "display_order": 3}, {"id": 6000176003, "chapter_id": 10176, "verse_number": "९-१-१", "content_sanskrit": "मन्वन्तराणि सर्वाणि त्वयोक्तानि श्रुतानि मे।\nवीर्याण्यनन्तवीर्यस्य हरेस्तत्र कृतानि च॥ ९/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.002.m4a", "display_order": 4, "topics": [{"text": "पूर्वस्कन्धे चतुर्दशमन्वन्तराणि श्रुतवता परीक्षिता शुकाचार्यं प्रति वैवस्वतमनोर्वंशकथनप्रार्थना", "range": "१–५"}]}, {"id": 6000176004, "chapter_id": 10176, "verse_number": "९-१-२", "content_sanskrit": "योऽसौ सत्यव्रतो नाम राजर्षिर्द्रविडेश्वरः।\nज्ञानं योऽतीतकल्पान्ते लेभे पुरुषसेवया॥ ९/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.003.m4a", "display_order": 5}, {"id": 6000176005, "chapter_id": 10176, "verse_number": "९-१-३", "content_sanskrit": "स वै विवस्वतः पुत्रो मनुरासीदिति श्रुतम्।\nत्वया तस्य सुताः प्रोक्ता इक्ष्वाकुप्रमुखा नृपाः॥ ९/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.004.m4a", "display_order": 6}, {"id": 6000176006, "chapter_id": 10176, "verse_number": "९-१-४", "content_sanskrit": "तेषां वंशं पृथग् ब्रह्मन् वंशानुचरितानि च।\nकीर्तयस्व महाभाग नित्यं शुश्रूषतां हि नः॥ ९/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.005.m4a", "display_order": 7}, {"id": 6000176007, "chapter_id": 10176, "verse_number": "९-१-५", "content_sanskrit": "ये भूता ये भविष्याश्च भवन्त्यद्यतनाश्च ये।\nतेषां नः पुण्यकीर्तीनां सर्वेषां वद विक्रमान्॥ ९/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.006.m4a", "display_order": 8}, {"id": 6000176008, "chapter_id": 10176, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.007.m4a", "display_order": 9}, {"id": 6000176009, "chapter_id": 10176, "verse_number": "९-१-६", "content_sanskrit": "एवं परीक्षिता राज्ञा सदसि ब्रह्मवादिनाम्।\nपृष्टः प्रोवाच भगवान् शुकः परमधर्मवित्॥ ९/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.008.m4a", "display_order": 10, "topics": [{"text": "श्रीशुकाचार्येण सूर्यवंशकथनारम्भः", "range": "६–१०"}]}, {"id": 6000176010, "chapter_id": 10176, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.009.m4a", "display_order": 11}, {"id": 6000176011, "chapter_id": 10176, "verse_number": "९-१-७", "content_sanskrit": "श्रूयतां मानवो वंशः सङ्क्षेपेण परन्तप।\nन शक्यते विस्तरतो वक्तुं वर्षशतैरपि॥ ९/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.010.m4a", "display_order": 12}, {"id": 6000176012, "chapter_id": 10176, "verse_number": "९-१-८", "content_sanskrit": "परावरेषां भूतानामात्मा यः पुरुषः परः।\nस एवासीदिदं विश्वं कल्पान्तेऽन्यन्न किञ्चन॥ ९/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.011.m4a", "display_order": 13}, {"id": 6000176013, "chapter_id": 10176, "verse_number": "९-१-९", "content_sanskrit": "तस्य नाभेरुदस्तात् स पद्मकोशो हिरण्मयः।\nतस्मिन् जज्ञे महाराज स्वयम्भूश्चतुराननः॥ ९/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.012.m4a", "display_order": 14}, {"id": 6000176014, "chapter_id": 10176, "verse_number": "९-१-१०", "content_sanskrit": "मरीचिर्मानसस्तस्य जज्ञे तस्यापि कश्यपः।\nदाक्षायण्यां ततोऽदित्यां विवस्वानभवत् सुतः॥ ९/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.013.m4a", "display_order": 15}, {"id": 6000176015, "chapter_id": 10176, "verse_number": "९-१-११", "content_sanskrit": "ततो मनुः श्राद्धदेवः सञ्ज्ञायामास भारत।\nश्रद्धायां जनयामास दश पुत्रान् स आत्मवान्॥ ९/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.014.m4a", "display_order": 16, "topics": [{"text": "सूर्यपुत्रस्य श्राद्धदेवस्य मनोः इक्ष्वाकुप्रभृतिपुत्रोत्पत्तेः पूर्वं पुत्रोत्पत्त्यर्थं मैत्रावरुणेष्टिकरणम्", "range": "११–१३"}]}, {"id": 6000176016, "chapter_id": 10176, "verse_number": "९-१-१२", "content_sanskrit": "इक्ष्वाकुनृगशर्यातिदिष्टधृष्टकरूशकान्।\nनरिष्यन्तं वृषध्रं च नाभागं च नभं विभुम्॥ ९/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.015.m4a", "display_order": 17}, {"id": 6000176017, "chapter_id": 10176, "verse_number": "९-१-१३", "content_sanskrit": "अप्रजस्य मनोः पूर्वं वसिष्ठो भगवान् किल।\nमित्रावरुणयोरिष्टिं प्रजार्थमकरोद् विभुः॥ ९/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.016.m4a", "display_order": 18}, {"id": 6000176018, "chapter_id": 10176, "verse_number": "९-१-१४", "content_sanskrit": "तत्र श्रद्धा मनोः पत्नी होतारं समयाचत।\nदुहित्रर्थमुपागम्य प्रणिपत्य पयोव्रता॥ ९/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.017.m4a", "display_order": 19, "topics": [{"text": "मनुपत्न्या श्रद्धादेव्या दुहितृजननार्थं प्रार्थितस्य होतुर्मन्त्रविपर्यासेन इलानामककन्योत्पत्तिः", "range": "१४–१६"}]}, {"id": 6000176019, "chapter_id": 10176, "verse_number": "९-१-१५", "content_sanskrit": "प्रेषितोऽध्वर्युणा होता दध्यौ तत् सुसमाहितः।\nगृहीते तेन हविषि वषट्कारं गृणन् द्विजः॥ ९/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.018.m4a", "display_order": 20}, {"id": 6000176020, "chapter_id": 10176, "verse_number": "९-१-१६", "content_sanskrit": "होतुस्तद्व्यभिचारेण कन्येला नाम साऽभवत्।\nतां विलोक्य मनुः प्राह नातिहृष्टमना गुरुम्॥ ९/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.019.m4a", "display_order": 21}, {"id": 6000176021, "chapter_id": 10176, "verse_number": "९-१-१७", "content_sanskrit": "भगवन् किमिदं जातं कर्म वो ब्रह्मवादिनाम्।\nविपरीतमहो कष्टं मैवं स्याद् ब्रह्मविक्रिया॥ ९/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.020.m4a", "display_order": 22, "topics": [{"text": "वसिष्ठाराधितस्य भगवतो वरदानेन इलायाः पुंस्त्वप्राप्तिः", "range": "१७–२२"}]}, {"id": 6000176022, "chapter_id": 10176, "verse_number": "९-१-१८", "content_sanskrit": "यूयं मन्त्रविदो युक्तास्तपसा दग्धकिल्बिषाः।\nकुतः सङ्कल्पवैषम्यमनृतं विबुधेष्विव॥ ९/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.021.m4a", "display_order": 23}, {"id": 6000176023, "chapter_id": 10176, "verse_number": "९-१-१९", "content_sanskrit": "तन्निशम्य वचस्तस्य भगवान् प्रपितामहः।\nहोतुर्व्यतिक्रमं ज्ञात्वा बभाषे रविनन्दनम्॥ ९/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.022.m4a", "display_order": 24}, {"id": 6000176024, "chapter_id": 10176, "verse_number": "९-१-२०", "content_sanskrit": "एतत् सङ्कल्पवैषम्यं होतुस्ते व्यभिचारतः।\nतथापि साधयिष्येऽहं सुप्रजास्त्वं स्वतेजसा॥ ९/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.023.m4a", "display_order": 25}, {"id": 6000176025, "chapter_id": 10176, "verse_number": "९-१-२१", "content_sanskrit": "एवं व्यवसितो राजन् भगवान् स महायशाः।\nअस्तौषीदादिपुरुषमिलायाः पुंस्त्वकाम्यया॥ ९/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.024.m4a", "display_order": 26}, {"id": 6000176026, "chapter_id": 10176, "verse_number": "९-१-२२", "content_sanskrit": "तस्मै कामवरं तुष्टो भगवान् हरिरीश्वरः।\nददाविलाऽभवत् तेन सुद्युम्नः पुरुषर्षभः॥ ९/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.025.m4a", "display_order": 27}, {"id": 6000176027, "chapter_id": 10176, "verse_number": "९-१-२३", "content_sanskrit": "स एकदा महाराज विचरन् मृगयां वने।\nवृृतः कतिपयामात्यैरश्वमारुह्य सैन्धवम्॥ ९/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.026.m4a", "display_order": 28, "topics": [{"text": "मृगयार्थं मेरुसमीपस्थं किंचन वनं प्रविष्टस्य सुद्युम्ननामकस्य तस्य स्‍त्रीत्वप्राप्तिः", "range": "२३–२७"}]}, {"id": 6000176028, "chapter_id": 10176, "verse_number": "९-१-२४", "content_sanskrit": "प्रगृह्य रुचिरं चापं शरांश्च परमाद्भुतान्।\nदंशितोऽनुमृगं वीरो जगाम दिशमुत्तराम्॥ ९/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.027.m4a", "display_order": 29}, {"id": 6000176029, "chapter_id": 10176, "verse_number": "९-१-२५", "content_sanskrit": "सुकुमारवनं मेरोरधस्तात् प्रविवेश ह।\nयत्रास्ते भगवान् शम्भू रममाणः सहोमया॥ ९/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.028.m4a", "display_order": 30}, {"id": 6000176030, "chapter_id": 10176, "verse_number": "९-१-२६", "content_sanskrit": "तस्मिन् प्रविष्ट एवासौ सुद्युम्नः परवीरहा।\nअपश्यत् स्‍त्रियमात्मानमश्वं च वडवां नृप॥ ९/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.029.m4a", "display_order": 31}, {"id": 6000176031, "chapter_id": 10176, "verse_number": "९-१-२७", "content_sanskrit": "तथा तदनुगाः सर्व आत्मलिङ्गविपर्ययम्।\nदृष्ट्वा विमनसोऽभूवन् वीक्ष्यमाणाः परस्परम्॥ ९/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_001/BhP_09.001.030.m4a", "display_order": 32}, {"id": 6000176032, "chapter_id": 10176, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धस्य प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]