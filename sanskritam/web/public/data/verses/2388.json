[{"id": 2065626, "chapter_id": 2388, "verse_number": "९-६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065627, "chapter_id": 2388, "verse_number": "९-६-१", "content_sanskrit": "एतच्छ्रुत्वा वचो राज्ञो मद्रराजः प्रतापवान्।\nदुर्योधनं तदा राजन्वाक्यमेतदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065628, "chapter_id": 2388, "verse_number": "९-६-२", "content_sanskrit": "दुर्योधन महाबाहो शृणु वाक्यविदां वर।\nयावेतौ मन्यसे कृष्णौ रथस्थौ रथिनांवरौ।\nन मे तुल्यावुभावेतौ बाहुवीर्ये कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065629, "chapter_id": 2388, "verse_number": "९-६-३", "content_sanskrit": "उद्यतां पृथिवीं सर्वां ससुरासुरमानवाम्।\nयोधयेयं रणमुखे सङ्क्रुद्धः किमु पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065630, "chapter_id": 2388, "verse_number": "९-६-४", "content_sanskrit": "विजेष्यामि रणे पार्थान्सोमकांश्च समागतान्।\nअहं सेनाप्रमेता ते भविष्यामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065631, "chapter_id": 2388, "verse_number": "९-६-५", "content_sanskrit": "तं च व्यूहं विधास्यामि न क (त) रिष्यन्ति यं परे।\nइति सत्यं ब्रवीम्येष दुर्योधन न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065632, "chapter_id": 2388, "verse_number": "९-६-६", "content_sanskrit": "`अद्यैवाहं रणे सर्वान्पाञ्चालान्सह पाण्डवैः।\nनिहनिष्यामि वा राजन्स्वर्गं यास्यामि वा हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065633, "chapter_id": 2388, "verse_number": "९-६-७", "content_sanskrit": "अद्य पश्यन्तु मां लोका विचरन्तमभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065634, "chapter_id": 2388, "verse_number": "९-६-८", "content_sanskrit": "अद्य पाण्डुसुताः सर्वे वासुदेवः ससात्यकिः।\nपाञ्चालाश्चेदयश्चैव द्रौपदेयाश्च सर्वशः।\nधृष्टद्युम्नः शिखण्डी च सर्वे चापि प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065635, "chapter_id": 2388, "verse_number": "९-६-९", "content_sanskrit": "विक्रमं मम पश्यन्तु धनुषश्च महद्बलम्।\nलाघवं चास्त्रवीर्यं च भुजयोश्च बलं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065636, "chapter_id": 2388, "verse_number": "९-६-१०", "content_sanskrit": "अद्य पश्यन्तु मे पार्थाः सिद्धाश्च सह चारणैः।\nयादृशं मे बलं बाह्वोः सम्पदस्त्रेषु या च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065637, "chapter_id": 2388, "verse_number": "९-६-११", "content_sanskrit": "अद्य मे विक्रमं दृष्ट्वा पाण्डवानां महारथाः।\nप्रतीकारपरा भूत्वा चेष्टन्ते विविधाः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065638, "chapter_id": 2388, "verse_number": "९-६-१२", "content_sanskrit": "अद्य सैन्यानि पाण्डूनां द्रावयिष्ये समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065639, "chapter_id": 2388, "verse_number": "९-६-१३", "content_sanskrit": "द्रोणभीष्मावति विमो सूतपुत्रं च संयुगे।\nविचरिष्ये रणमुखे प्रियार्थं तव कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065640, "chapter_id": 2388, "verse_number": "९-६-१४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065641, "chapter_id": 2388, "verse_number": "९-६-१४", "content_sanskrit": "एवमुक्तस्ततो राजा मद्राधिपतिमञ्जसा।\nअभ्यषिञ्चत सेनाया मध्ये भरतसत्तम।\nविधिना शास्त्रदृष्टेन क्लिष्टरूपो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065642, "chapter_id": 2388, "verse_number": "९-६-१५", "content_sanskrit": "अभिषिक्ते ततस्तस्मिन्सिंहनादो महानभूत्।\nतव सैन्येऽभ्यवाद्यन्त वादित्राणि च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065643, "chapter_id": 2388, "verse_number": "९-६-१६", "content_sanskrit": "हृष्टाश्चासंस्तथा योधा मद्रकाश्च महारथाः।\nतुष्टुवुश्चैव राजानं शल्यमाहवशोभिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065644, "chapter_id": 2388, "verse_number": "९-६-१७", "content_sanskrit": "जय राजंश्चिरं जीव जहि शत्रून्समागतान्।\nतव बाहुबलं प्राप्य धार्तराष्ट्रो महाबलः।\nनिखिलां पृथिवीं सर्वां प्रशास्तु निहतद्विषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065645, "chapter_id": 2388, "verse_number": "९-६-१८", "content_sanskrit": "त्वं हि शक्तो रणे जेतुं ससुरासुरमानवान्।\nमर्त्यधर्माण इह तु किमु सृञ्जयसोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065646, "chapter_id": 2388, "verse_number": "९-६-१९", "content_sanskrit": "एवं सम्पूज्यमानस्तु मद्राणामधिपो बली।\nहर्षं प्राप तदा वीरो दुरापमकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065647, "chapter_id": 2388, "verse_number": "९-६-२०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065648, "chapter_id": 2388, "verse_number": "९-६-२०", "content_sanskrit": "अभिषिक्ते तथा शल्ये तव सैन्येषु मानद।\nन कर्णव्यसनं किञ्चिन्मेनिरे तत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065649, "chapter_id": 2388, "verse_number": "९-६-२१", "content_sanskrit": "हृष्टाः सुमनसश्चैव बभूवुस्तत्र सैनिकाः।\nमेनिरे निहतान्पार्थान्मद्रराजवशङ्गतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065650, "chapter_id": 2388, "verse_number": "९-६-२२", "content_sanskrit": "प्रहर्षं प्राप्य सेना तु तावकी भरतर्षभ।\nतां रात्रिं सुखिता सुप्ता हर्षचित्ता च साभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065651, "chapter_id": 2388, "verse_number": "९-६-२३", "content_sanskrit": "सैन्यस्य तव तं शब्दं श्रुत्वा राजा युधिष्ठिरः।\nवार्ष्णेयमब्रवीद्वाक्यं सर्वक्षत्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065652, "chapter_id": 2388, "verse_number": "९-६-२४", "content_sanskrit": "मद्रराजः कृतः शल्यो धार्तराष्ट्रेण माघव।\nसेनापतिर्महेष्वासः सर्वसैन्येषु पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065653, "chapter_id": 2388, "verse_number": "९-६-२५", "content_sanskrit": "एतज्ज्ञात्वा यथाभूतं कुरु माधव यत्क्षमम्।\nभवान्नेता च गोप्ता च विधत्स्व यदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065654, "chapter_id": 2388, "verse_number": "९-६-२६", "content_sanskrit": "तमब्रवीन्महाराज वासुदेवो जनाधिपम्।\nआर्तायनिमहं जाने यथातत्त्वेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065655, "chapter_id": 2388, "verse_number": "९-६-२७", "content_sanskrit": "वीर्यवांश्च महातेजा महात्मा च विशेषतः।\nकृती च चित्रयोधी च संयुक्तो लाघवेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065656, "chapter_id": 2388, "verse_number": "९-६-२८", "content_sanskrit": "यादृग्भीष्मस्तथा द्रोणो यादृक्कर्णश्च संयुगे।\nतादृशृस्तद्विशिष्टो वा मद्रराजो मतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065657, "chapter_id": 2388, "verse_number": "९-६-२९", "content_sanskrit": "युध्यमानस्य तस्याहं चिन्तयानश्च भारत।\nयोद्धारं नाधिगच्छामि तुल्यरूपं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065658, "chapter_id": 2388, "verse_number": "९-६-३०", "content_sanskrit": "शिखण़्ड्यर्जुनभीमानां सात्वतस्य च भारत।\nधृष्टद्युम्नस्य च तथा बलेनाभ्यधिको रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065659, "chapter_id": 2388, "verse_number": "९-६-३१", "content_sanskrit": "मद्रराजो महाराजः सिंहद्विरदविक्रमः।\nविचरिष्यत्यभीः काले कालः क्रुद्धः प्रजास्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065660, "chapter_id": 2388, "verse_number": "९-६-३२", "content_sanskrit": "तस्याद्य न प्रपश्यामि प्रतियोद्धारमाहने।\nत्वामृते पुरुषव्याघ्र शार्दूलसमविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065661, "chapter_id": 2388, "verse_number": "९-६-३३", "content_sanskrit": "स त्वमेको हि लोकेऽस्मिन्नान्यस्त्वत्तः पुमान्भवेत्।\nमद्रराजं रणे क्रुद्धं यो हन्यात्कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065662, "chapter_id": 2388, "verse_number": "९-६-३४", "content_sanskrit": "अहन्यहनि युध्यन्तं क्षोभयन्तं बलं तव।\nतस्माज्जहि रणे शल्यं मघवानिव शम्बरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065663, "chapter_id": 2388, "verse_number": "९-६-३५", "content_sanskrit": "सौतेः पश्चादसौ वीरो धार्तराष्ट्रेण सत्कृतः।\nतवैव हि जयो नूनं हते मद्रेश्वरे युधि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065664, "chapter_id": 2388, "verse_number": "९-६-३६", "content_sanskrit": "तस्मिन्हते हतं सर्वं धार्तराष्ट्रबलं महत्॥\nएतच्छ्रुत्वा महाराज वचनं मम साम्प्रतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065665, "chapter_id": 2388, "verse_number": "९-६-३७", "content_sanskrit": "प्रत्युद्याहि रणे पार्थ मद्रराजं महारथम्॥\nजहि चैनं महाबाहो वासवो नमुचिं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065666, "chapter_id": 2388, "verse_number": "९-६-३८", "content_sanskrit": "न चैवात्र दया कार्या मातुलोऽयं ममेति वै।\nक्षत्रवर्म पुरस्कृत्य जहि मद्रजनेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065667, "chapter_id": 2388, "verse_number": "९-६-३९", "content_sanskrit": "द्रोणभीष्मार्णवं तीर्त्वा कर्णपातालसम्भवम्।\nमा निमज्जस्व सगणः शल्यमासाद्य गोष्पदम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065668, "chapter_id": 2388, "verse_number": "९-६-४०", "content_sanskrit": "यच्च ते तपसो वीर्यं यच्च क्षात्रं बलं तव।\nतद्दर्शय रणे सर्वं जहि चैनं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065669, "chapter_id": 2388, "verse_number": "९-६-४१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065670, "chapter_id": 2388, "verse_number": "९-६-४१", "content_sanskrit": "एतावदुक्त्वा वचनं केशवः परवीरहा।\nजगाम शिबिरं सायं पूज्यमानोऽथ पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065671, "chapter_id": 2388, "verse_number": "९-६-४२", "content_sanskrit": "केशवे तु तदा याते धर्मपुत्रो युधिष्ठिरः।\nविसृज्य सर्वान्भ्रातॄंश्च पाञ्चालानथ सोमकान्।\nसुष्वाप रजनीं तां तु विशल्य इव कुञ्जरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065672, "chapter_id": 2388, "verse_number": "९-६-४३", "content_sanskrit": "ते च सर्वे महेष्वासाः पाञ्चालाः पाण्डवास्तथा।\nकर्णस्य निधने हृष्टाः सुषुपुस्तां निशां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065673, "chapter_id": 2388, "verse_number": "९-६-४४", "content_sanskrit": "गतज्वरं महेष्वासं तीर्णपारं महारथम्।\nबभूव पाण्डवेयानां सैन्यं च मुदितं निशि।\nसूतपुत्रस्य निधनाज्जयं लब्ध्वा च मारिष॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065674, "chapter_id": 2388, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि शल्यवधपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]