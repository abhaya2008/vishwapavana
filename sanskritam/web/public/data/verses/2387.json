[{"id": 2065594, "chapter_id": 2387, "verse_number": "९-१६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065595, "chapter_id": 2387, "verse_number": "९-१६-१", "content_sanskrit": "एवमुक्तस्ततो राजा गौतमेन तपस्विना।\nनिःश्वस्य दीर्घमुष्णं च तूष्णीमासीद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065596, "chapter_id": 2387, "verse_number": "९-१६-२", "content_sanskrit": "ततो मुहूर्तं स ध्यात्वा तव पुत्रो महामनाः।\nकृपं शारद्वतं वाक्यमित्युवाच परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065597, "chapter_id": 2387, "verse_number": "९-१६-३", "content_sanskrit": "यत्किञ्चित्सुहृदा वाच्यं तत्सर्वं श्रावितो ह्यहम्।\nकृतं च भवता सर्वं प्राणान्सन्त्यज्य युध्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065598, "chapter_id": 2387, "verse_number": "९-१६-४", "content_sanskrit": "गाहमानमनीकानि युध्यमानं महारथैः।\nपाण्डवैरतितेजोभिर्लोकस्त्वामनुदृष्टवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065599, "chapter_id": 2387, "verse_number": "९-१६-५", "content_sanskrit": "सुहृदा यदिदं वाक्यं भवता श्रावितो ह्यहम्।\nन मां प्रीणाति तत्सर्वं मुमूर्षोरिव भेषजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065600, "chapter_id": 2387, "verse_number": "९-१६-६", "content_sanskrit": "हेतुकारणसंयुक्तं हितं वचनमुत्तमम्।\nउच्यमानं महाबाहो न मे विप्राग्र्य रोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065601, "chapter_id": 2387, "verse_number": "९-१६-७", "content_sanskrit": "राज्याद्विनिकृतोऽस्माभिः कथं सोस्मासु विश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065602, "chapter_id": 2387, "verse_number": "९-१६-८", "content_sanskrit": "अक्षद्यूते च नृपतिर्जितोऽस्माभिर्महाधनः।\nस कथं मम वाक्यानि श्रद्दध्याद्भूय एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065603, "chapter_id": 2387, "verse_number": "९-१६-९", "content_sanskrit": "तथा दूत्येन सम्प्राप्तः कृष्णः पार्थहिते रतः।\nप्रलब्धश्च हृषीकेशस्तच्च कर्माविचारितम्।\nस च मे वचनं ब्रह्मन्कथमेवाभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065604, "chapter_id": 2387, "verse_number": "९-१६-१०", "content_sanskrit": "विललाप च यत्कृष्णा सभामध्ये समेयुषी।\nन तन्मर्षयते कृष्णो न राज्यहरणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065605, "chapter_id": 2387, "verse_number": "९-१६-११", "content_sanskrit": "एकप्राणावुभौ कृष्णावन्योन्यमभिसंश्रितौ।\nपुरा यच्छ्रुतमेवासीदद्य पश्यामि तत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065606, "chapter_id": 2387, "verse_number": "९-१६-१२", "content_sanskrit": "स्वस्रीयं निहतं दृष्ट्वा दुःखं स्वपिति केशवः।\nकृतागसो वयं तस्य हितं मे स कथं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065607, "chapter_id": 2387, "verse_number": "९-१६-१३", "content_sanskrit": "अभिमन्योर्विनाशेन न शर्म लभतेऽर्जुनः।\nस कथं मद्धिते यत्नं प्रकरिष्यति याचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065608, "chapter_id": 2387, "verse_number": "९-१६-१४", "content_sanskrit": "मध्यमः पाण्डवस्तीक्ष्णो भीमसेनो महाबलः।\nप्रतिज्ञातं च तेनोग्रं भज्येतापि न सन्नमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065609, "chapter_id": 2387, "verse_number": "९-१६-१५", "content_sanskrit": "उभौ तौ बद्धनिस्त्रिंशावुभौ चाबद्धकङ्कटौ।\nकृतवैरावुभौ वीरौ यमावपि यमोपमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065610, "chapter_id": 2387, "verse_number": "९-१६-१६", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च कृतवैरौ मया सह।\nतौ कथं मद्धिते यत्नं कुर्यातां द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065611, "chapter_id": 2387, "verse_number": "९-१६-१७", "content_sanskrit": "दुःशासनेन यत्कृष्णा एकवस्त्रा रजस्वला।\nपरिक्लिष्टा सभामध्ये सर्वलोकस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065612, "chapter_id": 2387, "verse_number": "९-१६-१८", "content_sanskrit": "कथा विवसनां दीनां स्मरन्त्यद्यापि पाण्डवाः।\nन निवारयितुं शक्याः सङ्ग्रामत्ते परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065613, "chapter_id": 2387, "verse_number": "९-१६-१९", "content_sanskrit": "यदा च द्रौपदी क्लिष्टा मद्विनाशाय दुःखिता।\nउग्रं तेपे तपः कृष्णा भर्तॄणामर्थसिद्धये।\nस्थण्डिले नित्यदा शेते यावद्वैरस्य यातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065614, "chapter_id": 2387, "verse_number": "९-१६-२०", "content_sanskrit": "निक्षिप्य मानं दर्पं च वासुदेवसहोदरा।\nकृष्णायाः प्रेष्यवद्भूत्वा शुश्रूषां कुरुते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065615, "chapter_id": 2387, "verse_number": "९-१६-२१", "content_sanskrit": "इति सर्वं समुन्नद्धं न निर्वाति कथञ्चन।\nअभिमन्योर्विनाशेन स सन्धेयः कथं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065616, "chapter_id": 2387, "verse_number": "९-१६-२२", "content_sanskrit": "कथं च राजा भुक्त्वेमां पृथिवीं सागराम्बराम्।\nपाण्डवानां प्रसादेन भोक्ष्ये राज्यमहं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065617, "chapter_id": 2387, "verse_number": "९-१६-२३", "content_sanskrit": "उपर्युपरि राज्ञां वै ज्वलित्वा भास्करो यथा।\nयुधिष्ठिरं कथं पञ्चादनुयास्यामि दासवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065618, "chapter_id": 2387, "verse_number": "९-१६-२४", "content_sanskrit": "कथं भुक्त्वा स्वयं भोगान्दत्त्वा दायांश्च पुष्कलान्।\nकृपणं वर्तयिष्यामि कृपणैः सह जीविकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065619, "chapter_id": 2387, "verse_number": "९-१६-२५", "content_sanskrit": "नाभ्यसूयामि ते वाक्यमुक्तं स्निग्धं हितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065620, "chapter_id": 2387, "verse_number": "९-१६-२६", "content_sanskrit": "न तु सन्धिमहं मन्ये प्राप्तकालं कथञ्चन।\nसुनीतमनुपश्यामि सुयुद्धेन परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065621, "chapter_id": 2387, "verse_number": "९-१६-२७", "content_sanskrit": "नायं क्लीबायितुं कालः संयोद्धुं काल एव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065622, "chapter_id": 2387, "verse_number": "९-१६-२८", "content_sanskrit": "इष्टं मे बहुभिर्यज्ञैर्दत्ता विप्रेषु दक्षिणाः।\nप्राप्ताः कामाः श्रुता वेदाः शत्रूणां मूर्ध्निं च स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065623, "chapter_id": 2387, "verse_number": "९-१६-२९", "content_sanskrit": "भृत्या मे सुभृतास्तात दीनश्चाभ्यृद्भृतो जनः।\nनोत्सहेऽद्य द्विजश्रेष्ठ पाण्डवान्वक्तुमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065624, "chapter_id": 2387, "verse_number": "९-१६-३०", "content_sanskrit": "जितानि परराष्ट्राणि स्वराष्ट्रमनुपालितम्।\nभुक्ताश्च विविधा भोगास्त्रिवर्गः सेवितो मया॥ == ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065625, "chapter_id": 2387, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]