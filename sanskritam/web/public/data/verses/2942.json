[{"id": 2091352, "chapter_id": 2942, "verse_number": "१३-७२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअपूर्वं वा भवेत्पात्रमथवाऽपि चिरोषितम्।\nदूरादभ्यागतं वाऽपि किं पात्रं स्यात्पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091353, "chapter_id": 2942, "verse_number": "१३-७२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091354, "chapter_id": 2942, "verse_number": "१३-७२-२", "content_sanskrit": "क्रिया भवति केषांचिदुपांशुव्रतमुत्तमम्।\nयो नो याचेत यत्किंचित्सर्वं दद्याम इत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091355, "chapter_id": 2942, "verse_number": "१३-७२-३", "content_sanskrit": "अपीडयन्भृत्यवर्गमित्येवमनुशुश्रुम।\nपीडयन्भृत्यवर्गं हि आत्मानमपकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091356, "chapter_id": 2942, "verse_number": "१३-७२-४", "content_sanskrit": "अपूर्वं चापि यत्पात्रं यच्चापि स्याच्चिरोषितम्।\nदूरादभ्यागतं चापि तत्पात्रं न विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091357, "chapter_id": 2942, "verse_number": "१३-७२-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091358, "chapter_id": 2942, "verse_number": "१३-७२-५", "content_sanskrit": "अपीडया च भूतानां धर्मस्याहिंसया तथा।\nपात्रं विद्यामतत्त्वेन यस्मै दत्तं न सन्तपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091359, "chapter_id": 2942, "verse_number": "१३-७२-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091360, "chapter_id": 2942, "verse_number": "१३-७२-६", "content_sanskrit": "ऋत्विक्पुरोहिताचार्याः शिष्यसम्बन्धिबान्धवाः।\nसर्वे पूज्याश्च मान्याश्च श्रुतवन्तोऽनसूयकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091361, "chapter_id": 2942, "verse_number": "१३-७२-७", "content_sanskrit": "अतोऽन्यथा वर्तमानाः सर्वे नार्हन्ति सत्क्रियाम्।\nतस्माद्गुणैः परीक्षेत पुरुषान्प्रणिधाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091362, "chapter_id": 2942, "verse_number": "१३-७२-८", "content_sanskrit": "अक्रोधः सत्यवचनमहिंसा दम आर्जवम्।\nअद्रोहोऽनभिमानश्च ह्रीस्तितिक्षा दमः शमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091363, "chapter_id": 2942, "verse_number": "१३-७२-९", "content_sanskrit": "यस्मिन्नोतानि दृश्यन्ते न चाकार्याणि भारत।\nस्वभावतो निविष्टानि तत्पात्रं मानमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091364, "chapter_id": 2942, "verse_number": "१३-७२-१०", "content_sanskrit": "तथा चिरोषितं चापि सम्प्रत्यागतमेव च।\nअपूर्वं चैव पूर्वं च तत्पात्रं मानमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091365, "chapter_id": 2942, "verse_number": "१३-७२-११", "content_sanskrit": "अप्रामाण्यं च वेदानां शास्त्राणां चाभिलङ्घनम्।\nअव्यवस्था च सर्वत्र एतन्नाशनमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091366, "chapter_id": 2942, "verse_number": "१३-७२-१२", "content_sanskrit": "भवेत्पण्डितमानी यो ब्राह्मणो वेदनिन्दकः।\nआन्वीक्षिकीं तर्कविद्यामनुरक्तो निरर्थिकां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091367, "chapter_id": 2942, "verse_number": "१३-७२-१३", "content_sanskrit": "हेतुवादान्बुवन्सत्सु विजेताऽहेतुवादकः।\nआक्रोष्टा चातिवक्ता च ब्राह्मणानां सदैवहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091368, "chapter_id": 2942, "verse_number": "१३-७२-१४", "content_sanskrit": "सर्वाभिशङ्की मूढश्च बालः कटुकवागपि।\nबोद्धव्यस्तादृशस्तात नरं श्वानं हि तं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091369, "chapter_id": 2942, "verse_number": "१३-७२-१५", "content_sanskrit": "यथा श्वा भषितुं चैव हन्तु चैवावसज्जते।\nएवं सम्भाषणार्थाय सर्वशास्त्रवधाय च।\n`अल्पश्रुताः कुतर्काश्च दृष्टाः सृष्टाः कुपण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091370, "chapter_id": 2942, "verse_number": "१३-७२-१६", "content_sanskrit": "श्रुतिस्मृती चेतिहासपुराणारण्यवेदिनः।\nअनुरुन्ध्याद्बहुज्ञांश्च सारज्ञाश्चैव पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091371, "chapter_id": 2942, "verse_number": "१३-७२-१७", "content_sanskrit": "लोकयात्रा च द्रष्टव्या धर्मश्चात्महितानि च।\nएवं नरो वर्तमानः शाश्वतीर्वर्धते समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091372, "chapter_id": 2942, "verse_number": "१३-७२-१८", "content_sanskrit": "ऋणमुन्मुच्य देवानामृषीणां च तथैव च।\nपितॄणामथ विप्राणामतिथीनां च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091373, "chapter_id": 2942, "verse_number": "१३-७२-१९", "content_sanskrit": "पर्यायेण विमुक्तो यः सुनिर्णिक्तेन कर्मणा।\nएवं गृहस्थः कर्माणि कुर्वन्धर्मानन हीयते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091374, "chapter_id": 2942, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विसप्ततितमोऽध्यायः॥१३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]