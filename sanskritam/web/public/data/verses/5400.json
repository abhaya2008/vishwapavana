[{"id": 2206572, "chapter_id": 5400, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206573, "chapter_id": 5400, "verse_number": "१", "content_sanskrit": "ये च धर्ममसूयन्ति ये चैनं पर्युपासते ।\nब्रवीतु भगवानेतत् क्व ते गच्छन्ति तादृशाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206574, "chapter_id": 5400, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206575, "chapter_id": 5400, "verse_number": "२", "content_sanskrit": "रजसा तमसा चैव समवस्तीर्णचेतसः ।\nनरकं प्रतिपद्यन्ते धर्मविद्वेषिणो नराः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206576, "chapter_id": 5400, "verse_number": "३", "content_sanskrit": "ये तु धर्मं महाराज सततं पर्युपासते ।\nसत्यार्जवपराः सन्तस्ते वै स्वर्गभुजो नराः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206577, "chapter_id": 5400, "verse_number": "४", "content_sanskrit": "धर्म एव रतिस्तेषामाचार्योपासनाद् भवेत् ।\nदेवलोकं प्रपद्यन्ते ये धर्मं पर्युपासते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206578, "chapter_id": 5400, "verse_number": "५", "content_sanskrit": "मनुष्या यदि वा देवाः शरीरमुपताप्य वै ।\nधर्मिणः सुखमेधन्ते लोभद्वेषविवर्जिताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206579, "chapter_id": 5400, "verse_number": "६", "content_sanskrit": "प्रथमं ब्रह्मणः पुत्रं धर्ममाहुर्मनीषिणः ।\nधर्मिणः पर्युपासन्ते फलं पक्वमिवाशिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206580, "chapter_id": 5400, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206581, "chapter_id": 5400, "verse_number": "७", "content_sanskrit": "असतां कीदृशं रूपं साधवः किं च कुर्वते ।\nब्रवीतु मे भवानेतत् सन्तोऽसन्तश्च कीदृशाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206582, "chapter_id": 5400, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206583, "chapter_id": 5400, "verse_number": "८", "content_sanskrit": "दुराचाराः दुराधर्षा दुर्मुखाश्चाप्यसाधवः ।\nसाधवः शीलसम्पन्नाः शिष्टाचारस्य लक्षणम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206584, "chapter_id": 5400, "verse_number": "९", "content_sanskrit": "राजमार्गे गवां मध्ये गोष्ठमध्ये च धर्मिणः ।\nनोपसेवन्ति राजेन्द्र सर्गं मूत्रपुरीषयोः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206585, "chapter_id": 5400, "verse_number": "१०", "content_sanskrit": "पञ्चानामशनं दत्त्वा शेषमश्नन्ति साधवः ।\nन जल्पन्ति च भुञ्जाना न निद्रान्त्यार्द्रपाणयः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206586, "chapter_id": 5400, "verse_number": "११", "content_sanskrit": "चित्रभानुमनड्वाहं देवं गोष्ठं चतुष्पथम् ।\nब्राह्मणं धार्मिकं चैत्यं ते कुर्वन्ति प्रदक्षिणम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206587, "chapter_id": 5400, "verse_number": "१२", "content_sanskrit": "वृद्धानां भारतप्तानां स्त्रीणां बालातुरस्य च ।\nब्राह्मणानां गवां राज्ञां पन्थानं ददते च ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206588, "chapter_id": 5400, "verse_number": "१३", "content_sanskrit": "अतिथीनां च सर्वेषां प्रेष्याणां स्वजनस्य च ।\nतथा शरणकामानां गोप्ता स्यात् स्वागतप्रदः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206589, "chapter_id": 5400, "verse_number": "१४", "content_sanskrit": "सायं प्रातर्मनुष्याणामशनं देवनिर्मितम् ।\nनान्तरा भोजनं दृष्टमुपवासविधिर्हि सः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206590, "chapter_id": 5400, "verse_number": "१५", "content_sanskrit": "होमकाले यथा वह्निः कालमेव प्रतीक्षते ।\nऋतुकाले तथा नारी ऋतुमेव प्रतीक्षते ।\nन चान्यां गच्छते यस्तु ब्रह्मचर्यं हि तत्स्मृतम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206591, "chapter_id": 5400, "verse_number": "१६", "content_sanskrit": "अमृतं ब्राह्मणा गाव इत्येतत् त्रयमेकतः ।\nतस्माद् गोब्राह्मणं नित्यमर्चयेत यथाविधि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206592, "chapter_id": 5400, "verse_number": "१७", "content_sanskrit": "यजुषा संस्कृतं मांसमुपभुञ्जन् न दुष्यति ।\nपृष्ठमांसं वृथामांसं पुत्रमांसं च तत्समम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206593, "chapter_id": 5400, "verse_number": "१८", "content_sanskrit": "स्वदेशे परदेशे वाप्यतिथिं नोपवासयेत् ।\nकर्म वै सफलं कृत्वा गुरूणामभिवादयेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206594, "chapter_id": 5400, "verse_number": "१९", "content_sanskrit": "गुरुभ्य आसनं देयमभिवाद्याभिपूज्य च ।\nगुरूनभ्यर्च्य वर्धन्ते आयुषा यशसा श्रिया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206595, "chapter_id": 5400, "verse_number": "२०", "content_sanskrit": "वृद्धान् नातिवदेज्जातु न च सम्प्रेषयेदपि ।\nनासीनः स्यात् स्थितेष्वेवमायुरस्य न रिष्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206596, "chapter_id": 5400, "verse_number": "२१", "content_sanskrit": "न नग्नामीक्षते नारीं न विद्वान् पुरुषानपि ।\nमैथुनं सततं गुप्तमाहारं च समाचरेत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206597, "chapter_id": 5400, "verse_number": "२२", "content_sanskrit": "तीर्थानां गुरवस्तीर्थं शुचीनां हृदयं शुचि ।\nदर्शनानां परं ज्ञानं सन्तोषः परमं सुखम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206598, "chapter_id": 5400, "verse_number": "२३", "content_sanskrit": "सायं प्रातश्च वृद्धानां शृणुयात् पुष्कळा गिरः ।\nश्रुतमाप्नोति हि नरः सततं वृद्धसेवया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206599, "chapter_id": 5400, "verse_number": "२४", "content_sanskrit": "स्वाध्याये भोजने चैव दक्षिणं पाणिमुद्धरेत् ।\nयच्छेद्वाङ्मनसी नित्यमिन्द्रियाणि तथैव च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206600, "chapter_id": 5400, "verse_number": "२५", "content_sanskrit": "संस्कृतं पायसं नित्यं यवागूं कृसरं हविः ।\nअष्टकाः पितृदैवत्या वृद्धानामभिपूजनम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2206601, "chapter_id": 5400, "verse_number": "२६", "content_sanskrit": "श्मश्रुकर्मणि मङ्गल्यं क्षुतानामभिनन्दनम् ।\nव्याधितानां च सर्वेषामायुषः प्रतिनन्दनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2206602, "chapter_id": 5400, "verse_number": "२७", "content_sanskrit": "न जातु त्वमिति ब्रूयादापन्नोऽपि महत्तरम् ।\nअहङ्कारो वधो वापि विद्वत्सु न विशिष्यते ।\nअवराणां समानानां शिष्याणां च समाचरेत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2206603, "chapter_id": 5400, "verse_number": "२८", "content_sanskrit": "पापमाचक्षते नित्यं हृदयं पापकर्मिणाम् ।\nज्ञानपूर्वं विनश्यन्ति गूहमाना महाजने\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2206604, "chapter_id": 5400, "verse_number": "२९", "content_sanskrit": "ज्ञानपूर्वं कृतं कर्म च्छादयन्ते ह्यसाधवः ।\nन मां मनुष्याः पश्यन्ति न मां पश्यन्ति देवताः ।\nपापेनाभिहतः पापः तथा सद्यः प्रणश्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2206605, "chapter_id": 5400, "verse_number": "३०", "content_sanskrit": "यथा वार्धुषिको वृद्धिं देहभेदे प्रतीक्षते ।\nधर्मेणापिहितं पापं धर्ममेवाभिवर्धयेत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2206606, "chapter_id": 5400, "verse_number": "३१", "content_sanskrit": "यथा लवणमम्भोभिराप्लुतं प्रविलीयते ।\nप्रायश्चित्तहतं पापं तथा सद्यः प्रणश्यति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2206607, "chapter_id": 5400, "verse_number": "३२", "content_sanskrit": "तस्मात् पापं न गूहेत गूहमानं विवर्धते ।\nकृत्वा तु साधुष्वाख्येयं ते तत् प्रशमयन्त्युत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2206608, "chapter_id": 5400, "verse_number": "३३", "content_sanskrit": "आशया सञ्चितं द्रव्यं यत् काले नोपभुज्यते ।\nअन्ये चैतत् प्रपद्यन्ते वियोगे तस्य देहिनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2206609, "chapter_id": 5400, "verse_number": "३४", "content_sanskrit": "मानसं सर्वभूतानां धर्ममाहुर्मनीषिणः ।\nतस्मात् सर्वाणि भूतानि धर्ममेव समासते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2206610, "chapter_id": 5400, "verse_number": "३५", "content_sanskrit": "एक एव चरेद् धर्मं न धर्मध्वजिको भवेत् ।\nधर्मवाणिजका ह्येते ये धर्ममुपभुञ्जते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2206611, "chapter_id": 5400, "verse_number": "३६", "content_sanskrit": "सर्वथैव नडम्भेन सेवेतामायया गुरून् ।\nनिधिं निदध्यात् पारत्र्यं यात्रार्थं दानशेषितम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2206612, "chapter_id": 5400, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे धर्मस्वरूपविचारकथनं नाम एकपञ्चाशदुत्तरशततमोऽध्यायः ॥२५१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]