[{"id": 5000538000, "chapter_id": 9538, "verse_number": "७-३-१", "content_sanskrit": "अथ पुत्रः पुलस्त्यस्य विश्रवा मुनिपुङ्गवः ।\nअचिरेणैव कालेन पितेव तपसि स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000538001, "chapter_id": 9538, "verse_number": "७-३-२", "content_sanskrit": "सत्यवाञ्छीलवाञ्छान्तः स्वाध्यायनिरतः शुचिः ।\nसर्वभोगेष्वसंसक्तो नित्यं धर्मपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000538002, "chapter_id": 9538, "verse_number": "७-३-३", "content_sanskrit": "ज्ञात्वा तस्य तु तद्वृत्तं भरद्वाजो महामुनिः ।\nददौ विश्रवसे भार्यां स्वसुतां देववर्णिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000538003, "chapter_id": 9538, "verse_number": "७-३-४", "content_sanskrit": "प्रतिगृह्य तु धर्मेण भरद्वाजसुतां तदा ।\nप्रजान्वेक्षिकया बुद्ध्या श्रेयो ह्यस्य विचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000538004, "chapter_id": 9538, "verse_number": "७-३-५", "content_sanskrit": "मुदा परमया युक्तो विश्रवा मुनिपुङ्गवः ।\nस तस्यां वीर्यसम्पन्नमपत्यं परमाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000538005, "chapter_id": 9538, "verse_number": "७-३-६", "content_sanskrit": "जनयामास धर्मज्ञः सर्वैर्ब्रह्मगुणैर्युतम् ।\nतस्मिञ्जाते तु संहृष्टः सम्बभूव पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000538006, "chapter_id": 9538, "verse_number": "७-३-७", "content_sanskrit": "दृष्ट्वा श्रेयस्करीं बुद्धिं धनाध्यक्षो भविष्यति ।\nनाम तस्याकरोत्प्रीतः सार्धं देवर्षिभिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000538007, "chapter_id": 9538, "verse_number": "७-३-८", "content_sanskrit": "यस्माद्विश्रवसो ऽपत्यं सादृश्याद्विश्रवा इव ।\nतस्माद्वैश्रवणो नाम भविष्यत्वेष विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000538008, "chapter_id": 9538, "verse_number": "७-३-९", "content_sanskrit": "स तु वैश्रवणस्तत्र तपोवनगतस्तदा ।\nअवर्धताहुतिहुतो महातेजा यथानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000538009, "chapter_id": 9538, "verse_number": "७-३-१०", "content_sanskrit": "तस्याश्रमपदस्थस्य बुद्धिर्जज्ञे महात्मनः ।\nचरिष्ये परमं धर्मं धर्मो हि परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000538010, "chapter_id": 9538, "verse_number": "७-३-११", "content_sanskrit": "स तु वर्षसहस्राणि तपस्तप्त्वा महावने ।\nयन्त्रितो नियमैरुग्रैश्चकार सुमहत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000538011, "chapter_id": 9538, "verse_number": "७-३-१२", "content_sanskrit": "पूर्णे वर्षसहस्रान्ते तं तं विधिमकल्पयत् ।\nजलाशी मारुताहारो निराहारस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000538012, "chapter_id": 9538, "verse_number": "७-३-१३", "content_sanskrit": "एवं वर्षसहस्राणि जग्मुस्तान्येकवर्षवत् ।\nअथ प्रीतो महातेजाः सेन्द्रैः सुरगणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000538013, "chapter_id": 9538, "verse_number": "७-३-१४", "content_sanskrit": "गत्वा तस्याश्रमपदं ब्रह्मेदं वाक्यमब्रवीत् ।\nपरितुष्टो ऽस्मि ते वत्स कर्मणानेन सुव्रत ।\nवरं वृणीष्व भद्रं ते वरार्हस्त्वं महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000538014, "chapter_id": 9538, "verse_number": "७-३-१५", "content_sanskrit": "अथाब्रवीद्वैश्रवणः पितामहमुपस्थितम् ।\nभगवँल्लोकपालत्वमिच्छेयं वित्तरक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000538015, "chapter_id": 9538, "verse_number": "७-३-१६", "content_sanskrit": "अथाब्रवीद्वैश्रवणं परितुष्टेन चेतसा ।\nब्रह्मा सुरगणैः सार्धं बाढमित्येव हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000538016, "chapter_id": 9538, "verse_number": "७-३-१७", "content_sanskrit": "अहं वै लोकपालानां चतुर्थं स्रष्टुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000538017, "chapter_id": 9538, "verse_number": "७-३-१८", "content_sanskrit": "यमेन्द्रवरुणानां च पदं यत्तव चेप्सितम् ।\nतद्गच्छ त्वं हि धर्मज्ञ निधीशत्वमवाप्नुहि ।\nशक्राम्बुपयमानां च चतुर्थस्त्वं भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000538018, "chapter_id": 9538, "verse_number": "७-३-१९", "content_sanskrit": "एतच्च पुष्पकं नाम विमानं सूर्यसन्निभम् ।\nप्रतिगृह्णीष्व यानार्थं त्रिदशैः समतां व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000538019, "chapter_id": 9538, "verse_number": "७-३-२०", "content_sanskrit": "स्वस्ति ते ऽस्तु गमिष्यामः सर्व एव यथागतम् ।\nकृतकृत्या वयं तात दत्त्वा तव वरद्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000538020, "chapter_id": 9538, "verse_number": "७-३-२१", "content_sanskrit": "इत्युक्त्वा स गतो ब्रह्मा स्वस्थानं त्रिदशैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000538021, "chapter_id": 9538, "verse_number": "७-३-२२", "content_sanskrit": "गतेषु ब्रह्मपूर्वेषु देवेष्वथ नभस्थलम् ।\nवने स पितरं प्राह प्राञ्जलिः प्रयतात्मवान् ।\nनिवासनं न मे देवो विदधे स प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000538022, "chapter_id": 9538, "verse_number": "७-३-२३", "content_sanskrit": "भगवँल्लब्धवानस्मि वरमिष्टं पितामहात् ।\nतं पश्य भगवन्कञ्चिन्निवासं साधु मे प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000538023, "chapter_id": 9538, "verse_number": "७-३-२४", "content_sanskrit": "न च पीडा भवेद्यत्र प्राणिनो यस्य कस्यचित् ।\nएवमुक्तस्तु पुत्रेण विश्रवा मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000538024, "chapter_id": 9538, "verse_number": "७-३-२५", "content_sanskrit": "वचनं प्राह धर्मज्ञः श्रूयतामिति सत्तमः ।\nदक्षिणस्योदधेस्तीरे त्रिकूटो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000538025, "chapter_id": 9538, "verse_number": "७-३-२६", "content_sanskrit": "तस्याग्रे तु विशाला सा महेन्द्रस्य पुरी यथा ।\nलङ्का नाम पुरी रम्या निर्मिता विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000538026, "chapter_id": 9538, "verse_number": "७-३-२७", "content_sanskrit": "राक्षसानां निवासार्थं यथेन्द्रस्यामरावती ।\nतत्र त्वं वस भद्रं ते लङ्कायां नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000538027, "chapter_id": 9538, "verse_number": "७-३-२८", "content_sanskrit": "हेमप्राकारपरिघा यन्त्रशस्त्रसमावृता ।\nरमणीया पुरी सा हि रुक्मवैडूर्यतोरणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000538028, "chapter_id": 9538, "verse_number": "७-३-२९", "content_sanskrit": "राक्षसैः सा परित्यक्ता पुरा विष्णुभयार्दितैः ।\nशून्या रक्षोगणैः सर्वै रसातलतलं गतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000538029, "chapter_id": 9538, "verse_number": "७-३-३०", "content_sanskrit": "शून्या सम्प्रति लङ्का सा प्रभुस्तस्या न विद्यते ।\nस त्वं तत्र निवासाय गच्छ पुत्र यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000538030, "chapter_id": 9538, "verse_number": "७-३-३१", "content_sanskrit": "निर्दोषस्तत्र ते वासो न बाधास्तत्र कस्यचित् ।\nएतच्छुत्वा स धर्मात्मा धर्मिष्ठं वचनं पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000538031, "chapter_id": 9538, "verse_number": "७-३-३२", "content_sanskrit": "निवासयामास तदा लङ्कां पर्वतमूर्धनि ।\nनैर्ऋतानां सहस्रैस्तु हृष्टैः प्रमुदुतैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000538032, "chapter_id": 9538, "verse_number": "७-३-३३", "content_sanskrit": "अचिरेणैव कालेन सम्पूर्णा तस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000538033, "chapter_id": 9538, "verse_number": "७-३-३४", "content_sanskrit": "स तु तत्रावसत्प्रीतो धर्मात्मा नैर्ऋतर्षभः ।\nसमुद्रपरिघायां तु लङ्कायां विश्रवात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000538034, "chapter_id": 9538, "verse_number": "७-३-३५", "content_sanskrit": "काले काले तु धर्मात्मा पुष्पकेण धनेश्वरः ।\nअभ्यागच्छद्विनीतात्मा पितरं मातरं च हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000538035, "chapter_id": 9538, "verse_number": "७-३-३६", "content_sanskrit": "स देवगन्धर्वगणैरभिष्टुतस्तथाप्सरोनृत्यविभूषितालयः ।\nगभस्तिभिः सूर्य इवावभासयन्पितुः समीपं प्रययौ स वित्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000538036, "chapter_id": 9538, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]