[{"id": 50024174, "chapter_id": 11836, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। इन्द्रः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024175, "chapter_id": 11836, "verse_number": "2", "content_sanskrit": "आ त्वेता॒ नि षी॑द॒तेन्द्र॑म॒भि प्र गा॑यत। सखा॑य॒ः स्तोम॑वाहसः॥ ५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024176, "chapter_id": 11836, "verse_number": "3", "content_sanskrit": "पु॒रू॒तमं॑ पुरू॒णामीशा॑नं॒ वार्या॑णाम्। इन्द्रं॒ सोमे॒ सचा॑ सु॒ते॥ ५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024177, "chapter_id": 11836, "verse_number": "4", "content_sanskrit": "स घा॑ नो॒ योग॒ आ भु॑व॒त्स रा॒ये स पुरं॑ध्याम्। गम॒द्वाजे॑भि॒रा स न॑ः॥ ५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024178, "chapter_id": 11836, "verse_number": "5", "content_sanskrit": "यस्य॑ सं॒स्थे न वृ॒ण्वते॒ हरी॑ स॒मत्सु॒ शत्र॑वः। तस्मा॒ इन्द्रा॑य गायत॥ ५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024179, "chapter_id": 11836, "verse_number": "6", "content_sanskrit": "सु॒त॒पाव्ने॑ सु॒ता इ॒मे शुच॑यो यन्ति वी॒तये॑। सोमा॑सो॒ दध्या॑शिरः॥ ५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024180, "chapter_id": 11836, "verse_number": "7", "content_sanskrit": "त्वं सु॒तस्य॑ पी॒तये॑ स॒द्यो वृ॒द्धो अ॑जायथाः। इन्द्र॒ ज्यैष्ठ्या॑य सुक्रतो॥ ५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024181, "chapter_id": 11836, "verse_number": "8", "content_sanskrit": "आ त्वा॑ विशन्त्वा॒शव॒ः सोमा॑स इन्द्र गिर्वणः। शं ते॑ सन्तु॒ प्रचे॑तसे॥ ५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024182, "chapter_id": 11836, "verse_number": "9", "content_sanskrit": "त्वां स्तोमा॑ अवीवृध॒न्त्वामु॒क्था श॑तक्रतो। त्वां व॑र्धन्तु नो॒ गिर॑ः॥ ५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024183, "chapter_id": 11836, "verse_number": "10", "content_sanskrit": "अक्षि॑तोतिः सनेदि॒मं वाज॒मिन्द्र॑ः सह॒स्रिण॑म्। यस्मि॒न्विश्वा॑नि॒ पौंस्या॑॥ ५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024184, "chapter_id": 11836, "verse_number": "11", "content_sanskrit": "मा नो॒ मर्ता॑ अ॒भि द्रु॑हन्त॒नूना॑मिन्द्र गिर्वणः। ईशा॑नो यवया व॒धम्॥ ५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]