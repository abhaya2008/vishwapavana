[{"id": 7002898000, "chapter_id": 22898, "verse_number": "९-१८३-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथातः संप्रवक्ष्यामि दानमन्यत्तवोत्तमम् ।\nमहाभूतघटं नाम महापातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002898001, "chapter_id": 22898, "verse_number": "९-१८३-२", "content_sanskrit": "पुण्यां तिथिं समासाद्य स्वनुलिप्ते गृहांगणे ।\nकारयेत्कांचनं कुंभं महारत्नान्वितं पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002898002, "chapter_id": 22898, "verse_number": "९-१८३-३", "content_sanskrit": "प्रादेशादंगुलशतं यावत्कुर्यात्प्रमाणतः ।\nशक्त्या पंचपलादूर्ध्वमाशताच्च नरोत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002898003, "chapter_id": 22898, "verse_number": "९-१८३-४", "content_sanskrit": "क्षीराज्यपूरितं कृत्वा कल्पवृक्षसमन्वितम् ।\nपद्मासनगतास्तत्र ब्रह्मविष्णुमहेश्वराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002898004, "chapter_id": 22898, "verse_number": "९-१८३-५", "content_sanskrit": "लोकपाला महेन्द्राश्च स्ववाहनसमास्थिताः ।\nऋग्वेदः साक्षसूत्रश्च यजुर्वेदः सपंकजः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002898005, "chapter_id": 22898, "verse_number": "९-१८३-६", "content_sanskrit": "वीणाधारी सामवेदो ह्यथर्वा स्रक्छुभान्वितः ।\nपुराणवेदो वरदः साक्षसूत्रकमंडलुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002898006, "chapter_id": 22898, "verse_number": "९-१८३-७", "content_sanskrit": "सप्तधान्यानि पुरतः स्थापयेच्छक्तितो बुधः ।\nपादुकोपानहच्छत्रं चामराग्र्यासनायुधान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002898007, "chapter_id": 22898, "verse_number": "९-१८३-८", "content_sanskrit": "एवं प्रकल्प्य विधिवन्महाभूतघटं नरः ।\nगुडसारोपरिगतं माल्यवस्त्रैरथार्चयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002898008, "chapter_id": 22898, "verse_number": "९-१८३-९", "content_sanskrit": "अथ पर्वसमीपे तु स्नात्वा नियतमानसः ।\nत्रिः प्रदक्षिणमावृत्य मंत्रमेतमुदीरयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002898009, "chapter_id": 22898, "verse_number": "९-१८३-१०", "content_sanskrit": "यस्मान्न किंचिदप्यस्ति महाभूतैर्विना कृतम् ।\nमहाभूतमयश्चायं तस्माच्छांतिं ददातु मे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002898010, "chapter_id": 22898, "verse_number": "९-१८३-११", "content_sanskrit": "अत्र सन्निहिता देवाः स्थापिता विश्वकर्मणा ।\nते मे शांतिं प्रयच्छंतु भक्तिभावेन पूजिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002898011, "chapter_id": 22898, "verse_number": "९-१८३-१२", "content_sanskrit": "इत्येवं पूजयित्वा तु महाभूतघटं नरः ।\nब्राह्मणं पूजयित्वा तु भूषणाच्छादनादिभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002898012, "chapter_id": 22898, "verse_number": "९-१८३-१३", "content_sanskrit": "महाभूतघटं दद्यात्पर्वकाले यतव्रतः ।\nपुनः प्रदक्षिणीकृत्य ब्राह्मणं तं क्षमापयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002898013, "chapter_id": 22898, "verse_number": "९-१८३-१४", "content_sanskrit": "अनेन विधिना यश्च दानमेतत्प्रयच्छति ।\nएकविंशत्कुलोपेतः शिवलोके प्रयात्यसौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002898014, "chapter_id": 22898, "verse_number": "९-१८३-१५", "content_sanskrit": "पुण्यक्षयादिहाभ्येत्य राजा भवति धार्मिकः ।\nअजेयः शत्रुसंघातैर्महाबल पराक्रमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002898015, "chapter_id": 22898, "verse_number": "९-१८३-१६", "content_sanskrit": "क्षत्रधर्मरतो विद्वान्देवब्राह्मणपूजकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002898016, "chapter_id": 22898, "verse_number": "९-१८३-१७", "content_sanskrit": "अष्टापदोत्तमघटं विमलं विधाय ब्रह्मेशकेशवयुतं सहलोकपालैः ।\nक्षीराज्यपूर्णविवरं प्रणिपत्य भक्त्या विप्राय देहि तव दानशतैः किमन्यैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]