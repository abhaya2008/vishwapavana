[{"id": 2171693, "chapter_id": 4662, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2171694, "chapter_id": 4662, "verse_number": "१", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य वेलोद्वृत्तमिवार्णवम् ।\nगर्जन्तं सुमहाकायं दुर्निवारं सुरैरपि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2171695, "chapter_id": 4662, "verse_number": "२", "content_sanskrit": "अर्जुनं प्राह दाशार्हः प्रहस्य पुरुषर्षभः ।\nअयं सरथ आयाति श्वेताश्वः शल्यसारथिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2171696, "chapter_id": 4662, "verse_number": "३", "content_sanskrit": "येन ते सह योद्धव्यं स्थिरो भव धनञ्जय ।\nपश्य चैनं समायुक्तं रथं कर्णस्य पाण्डव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2171697, "chapter_id": 4662, "verse_number": "४", "content_sanskrit": "श्वेतवाजिसमायुक्तं युक्तं राधासुतेन च ।\nनानापताकाकलिलं किङ्किणीजालमालिनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2171698, "chapter_id": 4662, "verse_number": "५", "content_sanskrit": "उह्यमानमिवाकाशे विमानं पाण्डुरैर्हयैः ।\nध्वजं च पश्य कर्णस्य नागकक्षं महात्मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2171699, "chapter_id": 4662, "verse_number": "६", "content_sanskrit": "आखण्डलधनुःप्रख्यमुल्लिखन्तमिवाम्बरम् ।\nपश्य कर्णं समायान्तं धार्तराष्ट्रप्रियैषिणम् ।\nशरधारा विमुञ्चन्तं धारासारमिवाम्बुदम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2171700, "chapter_id": 4662, "verse_number": "७", "content_sanskrit": "एष मद्रेश्वरो राजा रथाग्रे पर्यवस्थितः ।\nनियच्छति हयानस्य राधेयस्यामितौजसः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2171701, "chapter_id": 4662, "verse_number": "८", "content_sanskrit": "शृणु दुन्दुभिनिर्घोषं शङ्खनादं च दारुणम् ।\nसिंहनादांश्च विविधान् शृणु पाण्डव सर्वशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2171702, "chapter_id": 4662, "verse_number": "९", "content_sanskrit": "अन्तर्धाय महाशब्दान् कर्णेनामिततेजसा ।\nदोधूयमानस्य भृशं धनुषः शृणु निःस्वनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2171703, "chapter_id": 4662, "verse_number": "१०", "content_sanskrit": "एते दीर्यन्ति सगणाः पाञ्चालानां महारथाः ।\nदृष्ट्वा केसरिणं क्रुद्धं मृगा इव महावने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2171704, "chapter_id": 4662, "verse_number": "११", "content_sanskrit": "सर्वयत्नेन कौन्तेय हन्तुमर्हसि सूतजम् ।\nन हि कर्णशरानन्यः सोढुमुत्सहतेऽनघ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2171705, "chapter_id": 4662, "verse_number": "१२", "content_sanskrit": "सदेवासुरगन्धर्वांस्त्रीन् लोकान् सचराचरान् ।\nत्वं हि जेतुं रणे शक्तस्तथैव विदितं मम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2171706, "chapter_id": 4662, "verse_number": "१३", "content_sanskrit": "भीममुग्रं महादेवं त्र्यक्षं शर्वं कपर्दिनम् ।\nन शक्ता द्रष्टुमीशानं किं पुनर्योधितुं प्रभुम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2171707, "chapter_id": 4662, "verse_number": "१४", "content_sanskrit": "त्वया साक्षान्महादेवः सर्वभूतशिवः शिवः ।\nयुद्धेनाराधितः स्थाणुर्देवाश्च वरदास्तव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2171708, "chapter_id": 4662, "verse_number": "१५", "content_sanskrit": "तस्य पार्थ प्रसादेन देवदेवस्य शूलिनः ।\nजहि कर्णं महाबाहो नमुचिं वृत्रहा यथा ।\nश्रेयस्तेऽस्तु सदा पार्थ युद्धे जयमवाप्नुहि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2171709, "chapter_id": 4662, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2171710, "chapter_id": 4662, "verse_number": "१६", "content_sanskrit": "ध्रुव एव जयः कृष्ण मम नास्त्यत्र संशयः ।\nसर्वलोकगुरुर्यस्त्वं तुष्टोऽसि मधुसूदन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2171711, "chapter_id": 4662, "verse_number": "१७", "content_sanskrit": "चोदयाश्वान् हृषीकेश रथं मम महारथ ।\nनाहत्वा समरे शत्रुं निवर्तिष्यति फल्गुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2171712, "chapter_id": 4662, "verse_number": "१८", "content_sanskrit": "अद्य कर्णं हतं पश्य मच्छरैः शकलीकृतम् ।\nमां वा द्रक्ष्यसि गोविन्द कर्णेन निहतं शरैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2171713, "chapter_id": 4662, "verse_number": "१९", "content_sanskrit": "उपस्थितमिदं घोरं युद्धं त्रैलोक्यमोहनम् ।\nयज्जनाः कथयिष्यन्ति यावद्भूमिर्धरिष्यति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2171714, "chapter_id": 4662, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2171715, "chapter_id": 4662, "verse_number": "२०", "content_sanskrit": "एवं ब्रुवंस्तदा पार्थः कृष्णमक्लिष्टकारिणम् ।\nप्रत्युद्ययौ रथेनाशु गजं प्रतिगजो यथा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2171716, "chapter_id": 4662, "verse_number": "२१", "content_sanskrit": "पुनश्चाह महातेजाः पार्थः कृष्णमरिन्दमम् ।\nचोदयाश्वान् हृषीकेश कालोऽयमतिवर्तते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2171717, "chapter_id": 4662, "verse_number": "२२", "content_sanskrit": "एवमुक्तस्तदा तेन पाण्डवेन महात्मना\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2171718, "chapter_id": 4662, "verse_number": "२३", "content_sanskrit": "जयेन सम्पूज्य स पाण्डवं तदा\nप्रचोदयामास हयान् मनोजवान् ।\nस पाण्डुपुत्रस्य रथो मनोजवः\nक्षणेन कर्णस्य रथाग्रगोऽभवत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2171719, "chapter_id": 4662, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nवृषसेनवधो नाम द्व्यशीतितमोऽध्यायः ॥८२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]