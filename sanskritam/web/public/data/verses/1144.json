[{"id": 2007443, "chapter_id": 1144, "verse_number": "१-१४५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007444, "chapter_id": 1144, "verse_number": "१-१४५-१", "content_sanskrit": "कुरुराजे हि रङ्गस्थे भीमे च बलिनां वरे।\nपक्षपातकृतस्नेहः स द्विधेवाभवज्जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007445, "chapter_id": 1144, "verse_number": "१-१४५-२", "content_sanskrit": "जय हे कुरुराजेति जय हे भीम इत्युत।\nपुरुषाणां सुविपुलाः प्रणादाः सहसोत्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007446, "chapter_id": 1144, "verse_number": "१-१४५-३", "content_sanskrit": "ततः क्षुब्धार्णवनिभं रङ्गमालोक्य बुद्धिमान्।\nभारद्वाजः प्रियं पुत्रमश्वत्थामानमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007447, "chapter_id": 1144, "verse_number": "१-१४५-४", "content_sanskrit": "वारयैतौ महावीर्यौ कृतयोग्यावुभावपि।\nमा भूद्रङ्गप्रकोपोऽयं भीमदुर्योधनोद्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007448, "chapter_id": 1144, "verse_number": "१-१४५-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007449, "chapter_id": 1144, "verse_number": "१-१४५-५", "content_sanskrit": "तत उत्थाय वेगेन अश्वत्थामा न्यवारयत्।\nगुरोराज्ञा भीम इति गान्धारे गुरुशासनम्।\nअलं शिक्षाकृतं वेगमलं साहसमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007450, "chapter_id": 1144, "verse_number": "१-१४५-६", "content_sanskrit": "ततस्तावुद्यतगतौ गुरुपुत्रेण वारितौ।\nयुगान्तानिलसंक्षुब्धौ महावेलाविवार्णवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007451, "chapter_id": 1144, "verse_number": "१-१४५-७", "content_sanskrit": "ततो रङ्गाङ्गणगतो द्रोणो वचनमब्रवीत्।\nनिवार्य वादित्रगणं महामेघनिभस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007452, "chapter_id": 1144, "verse_number": "१-१४५-८", "content_sanskrit": "यो मे पुत्रात्प्रियतरः सर्वशस्त्रविशारदः।\nऐन्द्रिरिन्द्रानुजसमः स पार्थो दृश्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007453, "chapter_id": 1144, "verse_number": "१-१४५-९", "content_sanskrit": "आचार्यवचनेनाथ कृतस्वस्त्ययनो युवा।\nबद्धगोधाङ्गुलित्राणः पूर्णतूणः सकार्मुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007454, "chapter_id": 1144, "verse_number": "१-१४५-१०", "content_sanskrit": "काञ्चनं कवचं बिभ्रत्प्रत्यदृश्य फाल्गुनः।\nसार्कः सेन्द्रायुधतडित्ससन्ध्य इव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007455, "chapter_id": 1144, "verse_number": "१-१४५-११", "content_sanskrit": "ततः सर्वस्य रङ्गस्य समुत्पिञ्जलकोऽभवत्।\nप्रावाद्यन्त च वाद्यानि सशङ्खानि समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007456, "chapter_id": 1144, "verse_number": "१-१४५-१२x", "content_sanskrit": "प्रेक्षका ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007457, "chapter_id": 1144, "verse_number": "१-१४५-१२", "content_sanskrit": "एष कुन्तीसुतः श्रीमानेष मध्यमपाण्डवः।\nएष पुत्रो महेन्द्रस्य कुरूणामेष रक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007458, "chapter_id": 1144, "verse_number": "१-१४५-१३", "content_sanskrit": "एषोऽस्त्रविदुषां श्रेष्ठ एष धर्मभृतां वरः।\nएष शीलवतां चापि शीलज्ञाननिधिः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007459, "chapter_id": 1144, "verse_number": "१-१४५-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007460, "chapter_id": 1144, "verse_number": "१-१४५-१४", "content_sanskrit": "इत्येवं तुमुला वाचः शुश्रुवुः प्रेक्षकेरिताः।\nकुन्त्याः प्रस्रवसंयुक्तैरस्रैः क्लिन्नमुरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007461, "chapter_id": 1144, "verse_number": "१-१४५-१५", "content_sanskrit": "तेन शब्देन महता पूर्णश्रुतिरथाब्रवीत्।\nधृतराष्ट्रो नरश्रेष्ठो विदुरं हृष्टमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007462, "chapter_id": 1144, "verse_number": "१-१४५-१६", "content_sanskrit": "क्षत्तः क्षुब्धार्णवनिभः किमेष सुमहास्वनः।\nसहसैवोत्थितो रङ्गे भिन्दन्निव नभस्तलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007463, "chapter_id": 1144, "verse_number": "१-१४५-१७x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007464, "chapter_id": 1144, "verse_number": "१-१४५-१७", "content_sanskrit": "एष पार्थो महाराज फाल्गुनः पाण्डुनन्दनः।\nअवतीर्णः सकवचस्तत्रैव सुमिहास्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007465, "chapter_id": 1144, "verse_number": "१-१४५-१८x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007466, "chapter_id": 1144, "verse_number": "१-१४५-१८", "content_sanskrit": "धन्योऽस्म्यनुगृहीतोऽस्मि रक्षितोऽस्मि महामते।\nपृथारणिसमुद्भूतैस्त्रिभिः पाण्डववह्निभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007467, "chapter_id": 1144, "verse_number": "१-१४५-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007468, "chapter_id": 1144, "verse_number": "१-१४५-१९", "content_sanskrit": "तस्मिन्प्रमुदिते रङ्गे कथंचित्प्रत्युपस्थिते।\nदर्शयामास बीभत्सुराचार्यायास्त्रलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007469, "chapter_id": 1144, "verse_number": "१-१४५-२०", "content_sanskrit": "आग्नेयेनासृजद्वह्निं वारुणेनासृजत्पयः।\nवायव्येनासृजद्वह्निं पार्जन्येनासृजद्धनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007470, "chapter_id": 1144, "verse_number": "१-१४५-२१", "content_sanskrit": "भौमेन प्रासृजद्भूमिं पार्वतेनासृजद्गिरीन्।\nअन्तर्धानेन चास्त्रेण पुनरन्तर्हितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007471, "chapter_id": 1144, "verse_number": "१-१४५-२२", "content_sanskrit": "क्षणात्प्रांशुः क्षणाद्ध्रस्वः क्षणाच्च रथधूर्गतः।\nक्षणेन रथमध्यस्थः क्षणेनावतरन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007472, "chapter_id": 1144, "verse_number": "१-१४५-२३", "content_sanskrit": "सुकुमारं च सूक्ष्मं च गुरु चापि गुरुप्रियः।\nसौष्ठवेनाभिसंयुक्तः सोऽविध्यद्विविधैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007473, "chapter_id": 1144, "verse_number": "१-१४५-२४", "content_sanskrit": "भ्रमतश्च वराहस्य लोहस्य प्रमुखे समम्।\nपञ्चबाणानसंक्तान्संमुमोचैकबाणवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007474, "chapter_id": 1144, "verse_number": "१-१४५-२५", "content_sanskrit": "गव्ये विषाणकोशे च चले रज्ज्ववलम्बिनि।\nनिचखान महावीर्यः सायकानेकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007475, "chapter_id": 1144, "verse_number": "१-१४५-२६", "content_sanskrit": "इत्येवमादि सुमहत्खड्गे धनुषि चानघ।\nगदायां शस्त्रकुशलो मण्डलानि ह्यदर्शयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007476, "chapter_id": 1144, "verse_number": "१-१४५-२७", "content_sanskrit": "ततः समाप्तभूयिष्ठे तस्मिन्कर्मणि भारत।\nमन्दीभूते समाजे च वादित्रस्य च निःस्वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007477, "chapter_id": 1144, "verse_number": "१-१४५-२८", "content_sanskrit": "द्वारदेशात्समुद्भूतो माहात्म्यबलसूचकः।\nवज्रनिष्पेषसदृशः शुश्रुवे भुजनिःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007478, "chapter_id": 1144, "verse_number": "१-१४५-२९", "content_sanskrit": "दीर्यन्ते किं नु गिरयः किंस्विद्भूमिर्विदीर्यते।\nकिंस्विदापूर्यते व्योम जलधाराघनैर्घनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007479, "chapter_id": 1144, "verse_number": "१-१४५-३०", "content_sanskrit": "रङ्गस्यैवं मतिरभूत्क्षणेन वसुधाधिप।\nद्वारं चाभिमुखाः सर्वे बभूवुः प्रेक्षकास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007480, "chapter_id": 1144, "verse_number": "१-१४५-३१", "content_sanskrit": "पञ्चभिर्भ्रातृभिः पार्थैर्द्रोणः परिवृतो वभौ।\nपञ्चतारेण संयुक्तः सावित्रेणेव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007481, "chapter_id": 1144, "verse_number": "१-१४५-३२", "content_sanskrit": "अश्वत्थाम्ना च सहितं भ्रातॄणां शतमूर्जितम्।\nदुर्योधनममित्रघ्नमुत्थितं पर्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007482, "chapter_id": 1144, "verse_number": "१-१४५-३३", "content_sanskrit": "स तैस्तदा भ्रातृभिरुद्यतायुधै-\nर्गदाग्रपाणिः समवस्थितैर्वृतः।\nबभौ यथा दानवसंक्षये पुरा\nपुनन्दरो देवगणैः समावृतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007483, "chapter_id": 1144, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चचत्वारिंशदधिकशततमोऽध्यायः॥ १४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]