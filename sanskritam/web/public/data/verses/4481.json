[{"id": 2160779, "chapter_id": 4481, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2160780, "chapter_id": 4481, "verse_number": "१", "content_sanskrit": "बाणे तस्मिन् निकृत्ते तु धृष्टद्युम्ने च मोक्षिते ।\nतेन वृष्णिप्रवीरेण युयुधानेन संयुगे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2160781, "chapter_id": 4481, "verse_number": "२", "content_sanskrit": "अमर्षितो महेष्वासः सर्वशस्त्रभृतां वरः ।\nरथव्याघ्रं शिनेः पौत्रं द्रोणः किमकरोद् युधि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2160782, "chapter_id": 4481, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2160783, "chapter_id": 4481, "verse_number": "३", "content_sanskrit": "सम्प्रस्रुतक्रोधविषो व्यादितास्य इवान्तकः ।\nतीक्ष्णधारेषुदशनः शितनाराचदंष्ट्रवान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2160784, "chapter_id": 4481, "verse_number": "४", "content_sanskrit": "संरम्भामर्षताम्राक्षो महाहिरिव निःश्वसन् ।\nनरवीरः प्रमुदितैः शोणैरश्वैर्महाजवैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2160785, "chapter_id": 4481, "verse_number": "५", "content_sanskrit": "उत्पतद्भिरिवाकाशं पतद्भिरिव सर्वतः ।\nरुग्मपुङ्खान् शरानस्यन् युयुधानमुपाद्रवत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2160786, "chapter_id": 4481, "verse_number": "६", "content_sanskrit": "शरपातमहावर्षं रथघोषबलाहकम् ।\nकार्मुकाकर्षविक्षेपं नाराचबहुविद्युतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2160787, "chapter_id": 4481, "verse_number": "७", "content_sanskrit": "शक्तिखड्गाशनिधरं क्रोधवेगसमुत्थितम् ।\nद्रोणमेघमनावार्यं हयमारुतचोदितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2160788, "chapter_id": 4481, "verse_number": "८", "content_sanskrit": "दृष्ट्वैवाभिपतन्तं तं शूरः परपुरञ्जयः ।\nउवाच सूतं शैनेयः प्रहसन् युद्धदुर्मदः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2160789, "chapter_id": 4481, "verse_number": "९", "content_sanskrit": "एतं वै ब्राह्मणं क्रूरं स्वकर्मण्यनवस्थितम् ।\nआश्रयं धार्तराष्ट्राणां धर्मराजभयावहम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2160790, "chapter_id": 4481, "verse_number": "१०", "content_sanskrit": "शीघ्रं प्रजवितैरश्वैः प्रत्युद्याहि प्रहृष्टवत् ।\nआचार्यं राजपुत्राणां सततं शूरमानिनम्\nएवमुक्तस्ततः सूतः सात्यकस्यावहद् रथम्\t॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2160791, "chapter_id": 4481, "verse_number": "११", "content_sanskrit": "ततो रजतसङ्काशा माधवस्य हयोत्तमाः ।\nद्रोणस्याभिमुखाः शीघ्रमवहन् वातरंहसः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2160792, "chapter_id": 4481, "verse_number": "१२", "content_sanskrit": "ततस्तौ द्रोणशैनेयौ युयुधाते परन्तपौ ।\nशरैरनेकसाहस्रैस्ताडयन्तौ परस्परम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2160793, "chapter_id": 4481, "verse_number": "१३", "content_sanskrit": "इषुजालावृतं व्योम चक्रतुः पुरुषर्षभौ ।\nपूरयामासतुर्वीरावुभौ दश दिशः शरैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2160794, "chapter_id": 4481, "verse_number": "१४", "content_sanskrit": "मेधाविवातपात्याये धाराभिरितरेतरम् ।\nन स्म सूर्यस्तदा भाति न ववौ च समीरणः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2160795, "chapter_id": 4481, "verse_number": "१५", "content_sanskrit": "इषुजालावृतं व्योम अन्धकारमनन्तकम् ।\nअनाधृष्यमिवान्येषां शूराणामभवत् तदा\nअन्धकारीकृते लोके द्रोणशैनेययोः शरैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2160796, "chapter_id": 4481, "verse_number": "१६", "content_sanskrit": "तयोः शीघ्रास्त्रविदुषोर्द्रोणसात्यकयोस्तदा ।\nनान्तरं शरवृष्टीनां दृश्यते नरसिंहयोः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2160797, "chapter_id": 4481, "verse_number": "१७", "content_sanskrit": "तयोर्ज्यातळनिर्घोषः श्रूयते युद्धशौण्डयोः ।\nप्रावृषीवेन्द्रमुक्तानामशनीनामिव स्वनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2160798, "chapter_id": 4481, "verse_number": "१८", "content_sanskrit": "नाराचैरतिविद्धानां शूराणां रूपमाबभौ ।\nआशीविषविदष्टानां सर्पाणामिव भारत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2160799, "chapter_id": 4481, "verse_number": "१९", "content_sanskrit": "तयोर्ज्यातळनिर्घोषः श्रूयते युद्ध्यमानयोः ।\nअजस्रं शैलशृङ्गाणां वज्रेणाहन्यतामिव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2160800, "chapter_id": 4481, "verse_number": "२०", "content_sanskrit": "उभौ तौ हि रथौ राजन् ते चाश्वास्तौ च सारथी ।\nरुग्मपुङ्खैः शरैश्छिन्नाः चित्ररूपा बभुस्तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2160801, "chapter_id": 4481, "verse_number": "२१", "content_sanskrit": "निर्मलानामजिह्मानां नाराचानां विशांपते ।\nनिर्मुक्ताशीविषाभानां सम्पातोऽभूत् सुदारुणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2160802, "chapter_id": 4481, "verse_number": "२२", "content_sanskrit": "उभयोः पतिते च्छत्रे पतितौ च महाध्वजौ ।\nनिकृन्ततोः शरैस्तीक्ष्णैर्द्रोणसात्यकयोस्तदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2160803, "chapter_id": 4481, "verse_number": "२३", "content_sanskrit": "उभौ रुधिरसंसिक्तावुभौ च विजयैषिणौ ।\nस्रवद्भिः शोणितं गात्रैः प्रस्रुताविव वारणौ\nअन्योन्यमभिविद्ध्येतां जीवितान्तकरैः शरैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2160804, "chapter_id": 4481, "verse_number": "२४", "content_sanskrit": "गर्जिताक्रुष्टसन्नादाः शङ्खदुन्दुभिनिस्वनाः ।\nउपारमन् महाराज व्याजहार न कश्चन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2160805, "chapter_id": 4481, "verse_number": "२५", "content_sanskrit": "तूष्णीम्भूतान्यनीकानि योधा युद्धादुपारमन् ।\nददर्श द्वैरथं ताभ्यां जातकौतूहलो जनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2160806, "chapter_id": 4481, "verse_number": "२६", "content_sanskrit": "रथिनो हस्तियन्तारो हयारोहाः पदातयः ।\nअवेक्षन्नचलैर्नेत्रैः परिवार्य रथर्षभौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2160807, "chapter_id": 4481, "verse_number": "२७", "content_sanskrit": "हस्त्यनीकानि तिष्ठन्ति तथाऽनीकानि वाजिनाम् ।\nतिष्ठन्ति रथवाहिन्यः प्रतिव्यूहे व्यवस्थिताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2160808, "chapter_id": 4481, "verse_number": "२८", "content_sanskrit": "मुक्ताविद्रुमचित्रैश्च मणिकाञ्चनभूषितैः ।\nध्वजैराभरणैश्चित्रैः कवचैश्च हिरण्मयैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2160809, "chapter_id": 4481, "verse_number": "२९", "content_sanskrit": "वैजयन्तीपताकाभिः परिस्तोमैश्च कम्बलैः ।\nनिर्मलैर्निशितैः शस्त्रैर्हयानां च प्रकीर्णकैः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2160810, "chapter_id": 4481, "verse_number": "३०", "content_sanskrit": "जातरूपमयीभिश्च राजतीभिश्च मूर्धनि ।\nगजानां कुम्भमालाभिर्दन्तवेष्टैश्च भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2160811, "chapter_id": 4481, "verse_number": "३१", "content_sanskrit": "सबलाका सखद्योता सैरावतशतह्रदा ।\nअदृश्यतोष्णपर्यन्ते मेघानामिव वागुरा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2160812, "chapter_id": 4481, "verse_number": "३२", "content_sanskrit": "अपश्यन्नस्मदीयाश्च ते च यौधिष्ठिरास्तदा ।\nतद् युद्धं युयुधानस्य द्रोणस्य च महात्मनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2160813, "chapter_id": 4481, "verse_number": "३३", "content_sanskrit": "विमानस्थास्तदा देवा ब्रह्मसोमपुरोगमाः ।\nसिद्धचारणसङ्घाश्च विद्याधरमहोरगाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2160814, "chapter_id": 4481, "verse_number": "३४", "content_sanskrit": "गन्धर्वा दानवा यक्षा राक्षसाप्सरसः खगाः ।\nगतप्रत्यागताक्षेपैः चित्रैः शस्त्रविघातनैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2160815, "chapter_id": 4481, "verse_number": "३५", "content_sanskrit": "विविधैर्विस्मयं जग्मुस्तयोः पुरुषसिंहयोः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2160816, "chapter_id": 4481, "verse_number": "३६", "content_sanskrit": "हस्तलाघवमस्त्रेषु दर्शयन्तौ महारथौ ।\nअन्योन्यमभिविद्ध्येतां तीक्ष्णैस्तौ द्रोणसात्यकी॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2160817, "chapter_id": 4481, "verse_number": "३७", "content_sanskrit": "ततो द्रोणस्य वार्ष्णेयो बाणांश्चिच्छेद संयुगे ।\nपत्रिभिः सुदृढैराशु धनुश्चैव महीपते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2160818, "chapter_id": 4481, "verse_number": "३८", "content_sanskrit": "निमेषान्तरमात्रेण भारद्वाजोऽपरं धनुः ।\nसज्यं चकार तच्चाशु चिच्छेदास्य स सात्यकिः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2160819, "chapter_id": 4481, "verse_number": "३९", "content_sanskrit": "तत आशु पुनर्द्रोणो धनुर्हस्तो व्यतिष्ठत ।\nसज्यं सज्यं पुनश्चापं चिच्छेद निशितैः शरैः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2160820, "chapter_id": 4481, "verse_number": "४०", "content_sanskrit": "ततोऽस्य संयुगे द्रोणो दृष्ट्वा कर्मातिमानुषम् ।\nयुयुधानस्य राजेन्द्र मनसैतदचिन्तयत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2160821, "chapter_id": 4481, "verse_number": "४१", "content_sanskrit": "एतदस्त्रबलं रामे कार्तवीर्ये धनञ्जये ।\nभीष्मे च पुरुषव्याघ्रे सात्यके चाशुविक्रमे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2160822, "chapter_id": 4481, "verse_number": "४२", "content_sanskrit": "तं चास्य मनसा द्रोणः पूजयामास विक्रमम् ।\nलाघवं वृष्णिवीरस्य वासवस्येव दृश्य सः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2160823, "chapter_id": 4481, "verse_number": "४३", "content_sanskrit": "तुष्टुवुर्लाघवं तस्य देवाः साग्निपुरोगमाः ।\nसिद्धचारणसङ्घाश्च साधु साध्विति चुक्रुशुः\nन तस्य लघुतामन्येऽलक्षयन् शीघ्रकारिणः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2160824, "chapter_id": 4481, "verse_number": "४४", "content_sanskrit": "देवास्तु युयुधानस्य गन्धर्वाश्च विशांपते ।\nसिद्धचारणसङ्घाश्च विदुर्द्रोणस्य कर्म तत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2160825, "chapter_id": 4481, "verse_number": "४५", "content_sanskrit": "ततोऽन्यद् धनुरादाय द्रोणः शस्त्रभृतां वरः ।\nयुयुधानं नरव्याघ्रं योधयामास भारत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2160826, "chapter_id": 4481, "verse_number": "४६", "content_sanskrit": "तस्यास्त्राण्यस्त्रमायाभिः प्रहसन् शिनिपुङ्गवः ।\nनिजघ्ने निशितैर्बाणैः तदद्भुतमिवाभवत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2160827, "chapter_id": 4481, "verse_number": "४७", "content_sanskrit": "तस्यातिमानुषं कर्म दृष्ट्वाऽन्यैरसमं रणे ।\nयुक्तं योगेन योगज्ञाः पूजयन्ति स्म तावकाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2160828, "chapter_id": 4481, "verse_number": "४८", "content_sanskrit": "यदस्त्रमस्यति द्रोणः तदेवास्यति सात्यकिः ।\nअसम्भ्रान्तस्तदाचार्यो योधयत्यरिसूदनः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2160829, "chapter_id": 4481, "verse_number": "४९", "content_sanskrit": "ततः क्रुद्धो महाराज धनुर्वेदस्य पारगः ।\nआग्नेयं युयुधानस्य दिव्यमस्त्रमुदैरयत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2160830, "chapter_id": 4481, "verse_number": "५०", "content_sanskrit": "तदाग्नेयं महाराज रिपुघ्नमुपलक्ष्य सः ।\nअस्त्रं दिव्यं महेष्वासो वारुणं समुदैरयत्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2160831, "chapter_id": 4481, "verse_number": "५१", "content_sanskrit": "हाहाकारो महानासीद् दृष्ट्वा दिव्यास्त्रधारिणौ ।\nन चेरुश्च तदाऽकाशे भूतान्याकाशगान्यपि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2160832, "chapter_id": 4481, "verse_number": "५२", "content_sanskrit": "अस्त्रे ते वारुणाग्नेये ताभ्यां बाणैः समाहिते ।\nन तदा व्यभिषज्येते व्यावर्तदथ भास्करः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2160833, "chapter_id": 4481, "verse_number": "५३", "content_sanskrit": "ततो युधिष्ठिरो राजा भीमसेनश्च पाण्डवः ।\nनकुलः सहदेवश्च पर्यरक्षन्त सात्यकिम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2160834, "chapter_id": 4481, "verse_number": "५४", "content_sanskrit": "धृष्टद्युम्नमुखैः सार्धं विराटः केकयैः सह ।\nमात्स्यसाल्वेयसेनाश्च द्रोणमभ्ययुरञ्जसा\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2160835, "chapter_id": 4481, "verse_number": "५५", "content_sanskrit": "दुःशासनं पुरस्कृत्य राजपुत्राः सहस्रशः ।\nद्रोणमभ्यवपद्यन्त सपत्नैः परिवारितम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2160836, "chapter_id": 4481, "verse_number": "५६", "content_sanskrit": "ततो युद्धमभूद् राजन् तव तेषां च धन्विनाम् ।\nरजसा संवृते लोके शरजालसमावृते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2160837, "chapter_id": 4481, "verse_number": "५७", "content_sanskrit": "सर्वमाविग्नमभवन्न प्राज्ञायत किञ्चन ।\nसैन्येन रजसा ध्वस्ते निर्मर्यादमवर्तत\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2160838, "chapter_id": 4481, "verse_number": "५८", "content_sanskrit": "तेनान्तरेण पार्थस्तु रणे जित्वा महारथान् ।\nअतिक्रान्तस्तदा युद्धं कृत्वा पर्यवतस्थिवान्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2160839, "chapter_id": 4481, "verse_number": "५९", "content_sanskrit": "वर्तमाने तदा युद्धे द्रोणस्य सह पाण्डुभिः ।\nपरिवर्तमान आदित्ये तत्रास्तशिखरं प्रति\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2160840, "chapter_id": 4481, "verse_number": "६०", "content_sanskrit": "रजसा कीर्यमाणाश्च मन्दीभूताश्च कौरवाः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2160841, "chapter_id": 4481, "verse_number": "६१", "content_sanskrit": "तिष्ठतां युद्ध्यमानानां पुनरावर्ततामपि ।\nजयतां भज्यमानानां जगाम तदहः शनैः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2160842, "chapter_id": 4481, "verse_number": "६२", "content_sanskrit": "तथा तेषु विषक्तेषु सैन्येषु जयगृद्धिषु ।\nअर्जुनो वासुदेवश्च सैन्धवायैव जग्मतुः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2160843, "chapter_id": 4481, "verse_number": "६३", "content_sanskrit": "रथमार्गप्रमाणं तु कौन्तेयो निशितैः शरैः ।\nचकार यं च पन्थानं ययौ तेन जनार्दनः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2160844, "chapter_id": 4481, "verse_number": "६४", "content_sanskrit": "यत्र यत्र रथो याति पाण्डवस्य महात्मनः ।\nतत्र तत्रैव दीर्यन्ते सेनास्तव विशांपते\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2160845, "chapter_id": 4481, "verse_number": "६५", "content_sanskrit": "रथशिक्षां तु दाशार्हो दर्शयामास वीर्यवान् ।\nउत्तमाधममध्यानि मण्डलानि विदर्शयन्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2160846, "chapter_id": 4481, "verse_number": "६६", "content_sanskrit": "ते तु नामाङ्किता पीताः कालज्वलनसन्निभाः ।\nस्नायुबद्धाः सुपर्वाणः पृथवः प्रियदर्शनाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2160847, "chapter_id": 4481, "verse_number": "६७", "content_sanskrit": "वैणवायस्मयशराः स्वायता विविधाननाः ।\nरुधिरं विहगैः सार्धं प्राणिनां पपुराहवे\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2160848, "chapter_id": 4481, "verse_number": "६८", "content_sanskrit": "रथस्थितोऽग्रतः क्रोशे यानस्यत्यर्जुनः शरान् ।\nरथे क्रोशमतिक्रान्ते तस्य ते घ्नन्ति शात्रवान्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2160849, "chapter_id": 4481, "verse_number": "६९", "content_sanskrit": "तार्क्ष्यमारुतरंहोभिर्वाजिभिः साधुवाहिभिः ।\nयथाऽगच्छद् हृषीकेशः कृत्स्नं विस्मापयन् जगत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2160850, "chapter_id": 4481, "verse_number": "७०", "content_sanskrit": "न तथा गच्छति रथः तपनस्य विशांपते ।\nन शक्रस्य न रुद्रस्य न च वैश्रवणस्य च\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2160851, "chapter_id": 4481, "verse_number": "७१", "content_sanskrit": "नान्यस्य समरे राजन् गतपूर्वस्तथा रथः ।\nयथा ययावर्जुनस्य मनोऽभिप्रायशीघ्रगः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2160852, "chapter_id": 4481, "verse_number": "७२", "content_sanskrit": "प्रविश्य तु रणे राजन् केशवः परवीरहा ।\nसेनामध्ये हयांस्तूर्णं चोदयामास भारत\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2160853, "chapter_id": 4481, "verse_number": "७३", "content_sanskrit": "ततस्तस्य रथौघस्य मध्यं प्राप्य हयोत्तमाः ।\nकृच्छ्रेण रथमूहुस्ते क्षुत्पिपासाश्रमान्विताः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2160854, "chapter_id": 4481, "verse_number": "७४", "content_sanskrit": "क्षताश्च बहुभिः शस्त्रैर्युद्धशौण्डैरनेकशः ।\nमण्डलानि विचित्राणि विचेरुस्ते मुहुर्मुहुः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2160855, "chapter_id": 4481, "verse_number": "७५", "content_sanskrit": "हतानां वाजिनागानां रथानां च नरैः सह ।\nउपरिष्टादतिक्रान्ताः शैलाभानां सहस्रशः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2160856, "chapter_id": 4481, "verse_number": "७६", "content_sanskrit": "श्रमेण महता युक्तास्ते हया वातरंहसः ।\nमन्दवेगगता राजन् संवृत्तास्तत्र संयुगे\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2160857, "chapter_id": 4481, "verse_number": "७७", "content_sanskrit": "एतस्मिन्नन्तरे वीरावावन्त्यौ भ्रातरौ नृप ।\nसहसैन्यौ तमार्च्छेतां पाण्डवं क्लान्तवाहनम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2160858, "chapter_id": 4481, "verse_number": "७८", "content_sanskrit": "तावर्जुनं चतुःषष्ट्या सप्तत्या च जनार्दनम् ।\nशराणां च शतेनाश्वानविद्ध्येतां मुदाऽन्वितौ\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2160859, "chapter_id": 4481, "verse_number": "७९", "content_sanskrit": "तावर्जुनो महाराज नवभिर्नतपर्वभिः ।\nआजघान रणे क्रुद्धो मर्मज्ञो मर्मभेदिभिः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2160860, "chapter_id": 4481, "verse_number": "८०", "content_sanskrit": "ततस्तौ तु शरौघेण बीभत्सुं सहकेशवम् ।\nछादयेतां सुसंरब्धौ सिंहनादं च चक्रतुः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2160861, "chapter_id": 4481, "verse_number": "८१", "content_sanskrit": "तयोस्तु धनुषी चित्रे भल्लाभ्यां श्वेतवाहनः ।\nचिच्छेद समरे तूर्णं भूय एव धनञ्जयः ।\nअथान्यैर्विशिखैस्तूर्णं ध्वजौ च कनकोज्ज्वलौ\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2160862, "chapter_id": 4481, "verse_number": "८२", "content_sanskrit": "अथान्ये धनुषी राजन् प्रगृह्य समरे तदा ।\nपाण्डवं भृशसङ्क्रुद्धावर्दयामासतुः शरैः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2160863, "chapter_id": 4481, "verse_number": "८३", "content_sanskrit": "तौ तु शस्त्रभृतां श्रेष्ठः शरैः सन्ताड्य भारत ।\nधनुषी चिच्छिदे तूर्णं भूय एव धनञ्जयः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2160864, "chapter_id": 4481, "verse_number": "८४", "content_sanskrit": "अथान्यैर्दशभिस्तूर्णं हेमपुङ्खैः शिलाशितैः ।\nजघानाश्वांस्तथा सूतं पार्ष्णिं च सपदानुगम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2160865, "chapter_id": 4481, "verse_number": "८५", "content_sanskrit": "ज्येष्ठस्य तु क्षुरप्रेण शिरः कायान्न्यकृन्तत ।\nस पपात हतः पृथ्व्यां वातरुग्ण इव द्रुमः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2160866, "chapter_id": 4481, "verse_number": "८६", "content_sanskrit": "विन्दं तु निहतं दृष्ट्वा अनुविन्दः प्रतापवान् ।\nहताश्वं रथमुत्सृज्य गदां गृह्य महाबलः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2160867, "chapter_id": 4481, "verse_number": "८७", "content_sanskrit": "अभ्यद्रवत सङ्ग्रामे भ्रातुर्वधमनुस्मरन् ।\nगदया गदिनां श्रेष्ठो नृत्यन्निव महारथः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2160868, "chapter_id": 4481, "verse_number": "८८", "content_sanskrit": "अनुविन्दः स गदया ललाटे मधुसूदनम् ।\nस्पृष्ट्वा नाकम्पयत् क्रुद्धो मैनाकमिव पर्वतम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2160869, "chapter_id": 4481, "verse_number": "८९", "content_sanskrit": "तत्रार्जुनः शरैः षड्भिः ग्रीवां पादौ भुजौ शिरः ।\nनिचकर्त स तु च्छिन्नः पपाताद्रिचयो यथा\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2160870, "chapter_id": 4481, "verse_number": "९०", "content_sanskrit": "ततस्तौ निहतौ दृष्ट्वा तयो राजन् पदानुगाः ।\nअभ्यद्रवन्त सङ्क्रुद्धाः किरन्तः शतशः शरान्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2160871, "chapter_id": 4481, "verse_number": "९१", "content_sanskrit": "तानर्जुनः शरैस्तूर्णं निहत्य भरतर्षभ ।\nव्यरोचत यथा वह्निर्दावं दग्ध्वा हिमात्यये\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2160872, "chapter_id": 4481, "verse_number": "९२", "content_sanskrit": "तयोः सेनामतिक्रम्य कृच्छ्रान्निघ्नन् धनञ्जयः ।\nविबभौ जलदान् हित्वा दिवाकर इवोदितः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2160873, "chapter_id": 4481, "verse_number": "९३", "content_sanskrit": "तं दृष्ट्वा कुरवस्त्रस्ताः प्रहृष्टाश्चाभवन् पुनः ।\nअभ्यद्रवन्त पार्थं च समन्ताद् भरतर्षभ\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2160874, "chapter_id": 4481, "verse_number": "९४", "content_sanskrit": "श्रान्तं चैनं समालक्ष्य ज्ञात्वा दूरे च सैन्धवम् ।\nसिंहनादेन महता सर्वतः पर्यवारयन्\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2160875, "chapter_id": 4481, "verse_number": "९५", "content_sanskrit": "तांस्तु दृष्ट्वा सुसंरब्धान् उत्स्मयन् पुरुषर्षभः ।\nशनकैरिव दाशार्हमर्जुनो वाक्यमब्रवीत्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2160876, "chapter_id": 4481, "verse_number": "९६", "content_sanskrit": "शरार्दिताश्च क्लान्ताश्च हया दूरे च सैन्धवः ।\nकिमिहानन्तरं कार्यं ज्यायिष्ठं तव रोचते\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2160877, "chapter_id": 4481, "verse_number": "९७", "content_sanskrit": "ब्रूहि कृष्ण यथातत्त्वं त्वं हि प्राज्ञतमः सदा ।\nभवन्नेत्रा रणे शत्रून् विजेष्यन्ति हि पाण्डवाः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2160878, "chapter_id": 4481, "verse_number": "९८", "content_sanskrit": "मम त्वनन्तरं कृत्यं यद् वैतत् सन्निबोध मे ।\nहयान् विमुच्य हि सुखं विशल्यान् कुरु माधव\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2160879, "chapter_id": 4481, "verse_number": "९९", "content_sanskrit": "एवमुक्तस्तु पार्थेन केशवः प्रत्युवाच तम्॥\nममाप्येतन्मतं पार्थ यदिदं ते प्रभाषितम्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2160880, "chapter_id": 4481, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2160881, "chapter_id": 4481, "verse_number": "१००", "content_sanskrit": "अहं हि वारयिष्यामि सर्वसैन्यानि केशव ।\nत्वमप्यत्र यथान्यायं कुरु कार्यमनन्तरम्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2160882, "chapter_id": 4481, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2160883, "chapter_id": 4481, "verse_number": "१०१", "content_sanskrit": "सोऽवतीर्य रथोपस्थाद् असम्भ्रान्तो धनञ्जयः ।\nगाण्डीवं धनुरादाय तस्थौ गिरिरिवाचलः\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2160884, "chapter_id": 4481, "verse_number": "१०२", "content_sanskrit": "तमभ्यधावन् क्रोशन्तः क्षत्रिया जयकाङ्क्षिणः ।\nइदं च्छिद्रमिति ज्ञात्वा धरणीस्थं धनञ्जयम्\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2160885, "chapter_id": 4481, "verse_number": "१०३", "content_sanskrit": "त एनं रथवंशेन समन्तात् पर्यवारयन् \t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2160886, "chapter_id": 4481, "verse_number": "१०४", "content_sanskrit": "विकर्षन्तश्च ते चापान् विसृजन्तश्च सायकान् ।\nविचित्राणि च शस्त्राणि क्रुद्धास्तत्र व्यदर्शयन्\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2160887, "chapter_id": 4481, "verse_number": "१०५", "content_sanskrit": "छादयन्तः शरैः पार्थं मेघा इव दिवाकरम् ।\nअद्रवंश्चापि वेगेन क्षत्रिया क्षत्रियर्षभम्\nरथसिंहं रथोदाराः सिंहं मत्ता इव द्विपाः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2160888, "chapter_id": 4481, "verse_number": "१०६", "content_sanskrit": "तत्र पार्थस्य भुजयोर्महद् बलमदृश्यत ।\nयत् क्रुद्धा बहुलाः सेनाः सर्वतः पर्यवारयत्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2160889, "chapter_id": 4481, "verse_number": "१०७", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य द्विषतां सर्वतो विभुः ।\nइषुभिर्बहुभिस्तूर्णं सर्वानेव समावृणोत्\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2160890, "chapter_id": 4481, "verse_number": "१०८", "content_sanskrit": "तत्रान्तरिक्षे बाणानां प्रगाढानां विशांपते ।\nसङ्घर्षेण महार्चिष्मान् पावकः समजायत\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2160891, "chapter_id": 4481, "verse_number": "१०९", "content_sanskrit": "तत्र तैश्च महेष्वासैः श्वसद्भिः शोणितोक्षितैः ।\nहयैर्नागैश्च सम्भिन्नैर्नदद्भिश्चारिकर्शन\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2160892, "chapter_id": 4481, "verse_number": "११०", "content_sanskrit": "संरब्धैश्चारिभिर्वीरैः प्रार्थयद्भिर्जयं मृधे ।\nएकस्थैर्बहुभिः क्रुद्धैरूर्मीव समजायत\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2160893, "chapter_id": 4481, "verse_number": "१११", "content_sanskrit": "शरोर्मिणं गजावर्तं नागनक्रं दुरत्ययम् ।\nपदातिमत्स्यकलिलं शङ्खदुन्दुभिनिस्वनम्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2160894, "chapter_id": 4481, "verse_number": "११२", "content_sanskrit": "असङ्ख्येयमपारं च रजोनीरमतीव च ।\nउष्णीषकमठच्छन्नं पताकाफेनमालिनम्\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2160895, "chapter_id": 4481, "verse_number": "११३", "content_sanskrit": "रथसागरमक्षोभ्यं मातङ्गाङ्गशिलाचितम् ।\nवेलाभूतस्तदा पार्थः पत्रिभिः समवारयत्\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2160896, "chapter_id": 4481, "verse_number": "११४", "content_sanskrit": "ततो जनार्दनः सङ्खे प्रियं पुरुषसत्तमम् ।\nअसम्भ्रान्तं महाबाहुमर्जुनं वाक्यमब्रवीत्\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2160897, "chapter_id": 4481, "verse_number": "११५", "content_sanskrit": "उदपानमिहाश्वानां नाल्पमस्ति रणेऽर्जुन ।\nपरीप्सन्ते जलं चेमे पेयं न त्ववगाहनम्\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2160898, "chapter_id": 4481, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2160899, "chapter_id": 4481, "verse_number": "११६", "content_sanskrit": "इदमस्तीत्यसम्भ्रान्तो ब्रुवन्नस्त्रेण मेदिनीम् ।\nअभिहत्यार्जुनश्चक्रे वाजिपानं सरःशुभम्\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2160900, "chapter_id": 4481, "verse_number": "११७", "content_sanskrit": "शरवंशं शरस्थूणं शरच्छादनमद्भुतम् ।\nशरवेश्माकरोत् पार्थः त्वष्टेवाद्भुतकर्मकृत्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2160901, "chapter_id": 4481, "verse_number": "११८", "content_sanskrit": "ततः प्रहस्य गोविन्दः साधु साध्वित्यथाब्रवीत् ।\nशरवेश्मनि पार्थेन कृते तस्मिन् महारणे\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2160902, "chapter_id": 4481, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षडशीतितमोऽध्यायः ॥ ८६ ॥\nजयद्रथवधपर्वणि दशमोऽध्यायः ॥ १० ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}]