[{"id": 7003279000, "chapter_id": 23279, "verse_number": "१-८२-१", "content_sanskrit": "सूत उवाच  ।\nव्यपोहनस्तवं वक्ष्ये सर्वसिद्धिप्रदं शुभम्  ।\nनंदिनश्च मुखाच्छ्रुत्वा कुमारेण महात्मना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003279001, "chapter_id": 23279, "verse_number": "१-८२-२", "content_sanskrit": "व्यासाय कथितं तस्माद्बहुमानेन वै मया  ।\nनमः शिवाय शुद्धाय निर्मलाय यशस्विने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003279002, "chapter_id": 23279, "verse_number": "१-८२-३", "content_sanskrit": "दुष्टांतकाय सर्वाय भवाय परमात्मने  ।\nपंचवक्त्रो दशभुजो ह्यक्षपंचदशैर्युतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003279003, "chapter_id": 23279, "verse_number": "१-८२-४", "content_sanskrit": "शुद्धस्फटिकसंकाशः सर्वाभरणभूषितः  ।\nसर्वज्ञ सर्वगः शांतः सर्वोपरि सुसंस्थितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003279004, "chapter_id": 23279, "verse_number": "१-८२-५", "content_sanskrit": "पद्मासनस्थः सोमेशः पापमाशु व्यपोहतु  ।\nईशानः पुरुषश्चैव अघोरः सद्य एव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003279005, "chapter_id": 23279, "verse_number": "१-८२-६", "content_sanskrit": "वामदेवश्च भगवान्पापमाशु व्यपोहतु  ।\nअनंतः सर्वविद्येशः सर्वज्ञः सर्वदः प्रभुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003279006, "chapter_id": 23279, "verse_number": "१-८२-७", "content_sanskrit": "शिवध्यानैकसंपन्नः स मे पापं व्यपोहतु  ।\nसूक्ष्मः सुरासुरेशानो विश्वेशो गणपूजितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003279007, "chapter_id": 23279, "verse_number": "१-८२-८", "content_sanskrit": "शिवध्यानैकसंपन्नः स मे पापं व्यपोहतु  ।\nशिवोत्तमो महापूज्यः शिवध्यानपरायणः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003279008, "chapter_id": 23279, "verse_number": "१-८२-९", "content_sanskrit": "सर्वगः सर्वदः शांतः स मे पापं व्यपोहतु  ।\nएकाश्रो भगवानीशः शिवार्चनपरायणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003279009, "chapter_id": 23279, "verse_number": "१-८२-१०", "content_sanskrit": "शिवध्यानैकसंपन्नः स मे पापं व्यपोहतु  ।\nत्रिमूर्तिर्भगवानीशः शिवभक्तिप्रबोधकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003279010, "chapter_id": 23279, "verse_number": "१-८२-११", "content_sanskrit": "शिवध्यानैकसंपन्नः स मे पापं व्यपोहतु  ।\nश्रीकंठः श्रीपतिः श्रीमाञ्शिवध्यानरतः सदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003279011, "chapter_id": 23279, "verse_number": "१-८२-१२", "content_sanskrit": "शिवार्चनरतः श्रीमान् स मे पापं व्यपोहतु  ।\nशिखण्डी भगवाञ्शांतः शवभस्मानुलेपनः।।८२.१२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003279012, "chapter_id": 23279, "verse_number": "१-८२-१३", "content_sanskrit": "त्रैलोक्यनमिता देवी सोल्काकारा पुरातन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003279013, "chapter_id": 23279, "verse_number": "१-८२-१४", "content_sanskrit": "शिवार्चनरतः श्रीमान् स मे पापं व्यपोहतु।।८२.१३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003279014, "chapter_id": 23279, "verse_number": "१-८२-१५", "content_sanskrit": "दाक्षायणी महादेवी भौरी हैमवती शुभा  ।\nएकपर्णाग्रजा सौम्या तथा वै चैकपाटला ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003279015, "chapter_id": 23279, "verse_number": "१-८२-१६", "content_sanskrit": "अपर्णावरदा देवी वरदानैकतत्परा  ।\nउमा सुरहरा साक्षात्कौशिकी वा कपर्दिनी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003279016, "chapter_id": 23279, "verse_number": "१-८२-१७", "content_sanskrit": "खट्वांगधारिणी दिव्या कराग्रतरुपल्लवा  ।\nनैगमेयादिभिर्दिव्यैश्चतुर्भिः पुत्रकैर्वृता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003279017, "chapter_id": 23279, "verse_number": "१-८२-१८", "content_sanskrit": "मेनाया नंदिनी देवी वारिजा वारिजेक्षणा  ।\nअंबाया वीतशोकस्य नंदिनश्च महात्मनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003279018, "chapter_id": 23279, "verse_number": "१-८२-१९", "content_sanskrit": "शुभावत्याः सखी शांता पंचचूडा वरप्रदा  ।\nसृष्ट्यर्थं सर्वभूतानां प्रकृतित्वं गताव्यया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003279019, "chapter_id": 23279, "verse_number": "१-८२-२०", "content_sanskrit": "त्रयोविंशतिभिस्तत्त्वैर्महदाद्यौर्विजृंभिता  ।\nलक्ष्म्यादिशक्तिभिर्नित्यं नमिता नंदनंदिनी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003279020, "chapter_id": 23279, "verse_number": "१-८२-२१", "content_sanskrit": "मनोन्मनी महादेवी मायावी मंडनप्रिया  ।\nमायया या जगत्सर्वं ब्रह्माद्यं सचराचरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003279021, "chapter_id": 23279, "verse_number": "१-८२-२२", "content_sanskrit": "क्षोभिणी मोहिनी नित्यं योगिनां हृदि संस्थिता  ।\nएकानेकस्थिता लोके इंदीवरनिभेक्षणा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003279022, "chapter_id": 23279, "verse_number": "१-८२-२३", "content_sanskrit": "भक्त्या परमया नित्यं सर्वदेवैरभिष्टुता  ।\nगणेँद्रांभोजगर्भैंद्रयमवित्तेशपूर्वकैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003279023, "chapter_id": 23279, "verse_number": "१-८२-२४", "content_sanskrit": "संस्तुता जननी तेषां सर्वोपद्रवनाशिनी  ।\nभक्तानामार्तिहा भव्या भवभावविनाशनी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003279024, "chapter_id": 23279, "verse_number": "१-८२-२५", "content_sanskrit": "भुक्तिमुक्तिप्रदा दिव्या भक्तानामप्रयत्नतः  ।\nसा मे साक्षान्महादेवी पापमाशु व्यपोहतु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003279025, "chapter_id": 23279, "verse_number": "१-८२-२६", "content_sanskrit": "चंडः सर्वगणेशानो मुखाच्छंभोर्विनिर्गतः  ।\nशिवार्चनरतः श्रीमान् स मे पापं व्यपोहतु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003279026, "chapter_id": 23279, "verse_number": "१-८२-२७", "content_sanskrit": "शालंकायनपुत्रस्तु हलमार्गोत्थितः प्रभुः  ।\nजामाता मरुतां देवः सर्वभूतमहेश्वरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003279027, "chapter_id": 23279, "verse_number": "१-८२-२८", "content_sanskrit": "सर्वगः सर्वदृक् शर्वः सर्वेशसदृशः प्रभुः  ।\nसनारायणकैर्देवैः सेंद्रचन्द्रदिवाकरैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003279028, "chapter_id": 23279, "verse_number": "१-८२-२९", "content_sanskrit": "सिद्धैश्च यक्षगंधर्वैर्भूतैर्भूतविधायकैः  ।\nउरगैर्ऋषिभिश्चैव ब्रह्मणा च महात्मना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003279029, "chapter_id": 23279, "verse_number": "१-८२-३०", "content_sanskrit": "स्तुतस्त्रैलोक्यनाथस्तु मुनिरंतः पुरं स्थितः  ।\nसर्वदा पूजितः सर्वैर्नंदी पापं व्यपोहतु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003279030, "chapter_id": 23279, "verse_number": "१-८२-३१", "content_sanskrit": "महाकायो महा तेजा महादेव इवापरः  ।\nशिवार्चनरतः श्रीमान्स मे पापं व्यपोहतु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003279031, "chapter_id": 23279, "verse_number": "१-८२-३२", "content_sanskrit": "मेरुमंदारकैलासतटकूटप्रभेदनः  ।\nऐरावतादिभिर्दिव्यैर्दिग्गजैश्च सुपूजितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003279032, "chapter_id": 23279, "verse_number": "१-८२-३३", "content_sanskrit": "सप्तपातालपादश्च सप्तद्वीपोरुजंघकः  ।\nसप्तार्णवांकुशश्चैव सर्वतीर्थोदरः शिवः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003279033, "chapter_id": 23279, "verse_number": "१-८२-३४", "content_sanskrit": "आकाशदेहो दिग्बाहुः सोमसूर्याग्निलोचनः  ।\nहतासुरमहावृक्षो ब्रह्मविद्यामहोत्कटः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003279034, "chapter_id": 23279, "verse_number": "१-८२-३५", "content_sanskrit": "ब्रह्माद्याधोरणैर्दिव्यैर्योगपाशसमन्वितैः  ।\nबद्धो हृत्पुंडरीकाख्येस्तंभे वृत्तिं निरुध्य च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003279035, "chapter_id": 23279, "verse_number": "१-८२-३६", "content_sanskrit": "नागेंद्रवक्त्रो यः साक्षाद्गणकोटिशतैर्वृतः  ।\nशिवध्यानैकसंपन्नः स मे पापं व्यपोहतु ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003279036, "chapter_id": 23279, "verse_number": "१-८२-३७", "content_sanskrit": "भृंगीशः पिंगलाक्षोसौ भसिताशस्तु देहयुक्  ।\nशिवार्चनरतः श्रीमान्स मे पापं व्यपोहतु ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003279037, "chapter_id": 23279, "verse_number": "१-८२-३८", "content_sanskrit": "चतुर्भिस्तनुभिर्नित्यं सर्वासुरनिबर्हणः  ।\nस्कंदः शक्तिधरः शांतः सेनानीः शिखिवाहनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003279038, "chapter_id": 23279, "verse_number": "१-८२-३९", "content_sanskrit": "देवसेनापतिः श्रीमान्स मे पापं व्यपोहतु  ।\nभवः शर्वस्तथेशानो रुद्रः पशुपतिस्तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003279039, "chapter_id": 23279, "verse_number": "१-८२-४०", "content_sanskrit": "उग्रो भीमो महादेवः शिवार्चनरतः सदा  ।\nएताः पापं व्यपोहंतु मूर्तयः परमेष्ठिनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003279040, "chapter_id": 23279, "verse_number": "१-८२-४१", "content_sanskrit": "महादेवः शिवो रुद्रः शंकरो नीललोहितः  ।\nईशानो विजयो भीमो देवदेवो भवोद्भवः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003279041, "chapter_id": 23279, "verse_number": "१-८२-४२", "content_sanskrit": "कपालीशश्च विज्ञेयो रुद्रा रुद्रांशसंभवाः  ।\nशिवप्रणामसंपन्ना व्यपोहंतु मलं मम ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003279042, "chapter_id": 23279, "verse_number": "१-८२-४३", "content_sanskrit": "विकर्तनो विवस्वांश्च मार्तंडो भास्करो रविः  ।\nलोकप्रकाशकश्चैव लोकसाक्षीत्रिविक्रमः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003279043, "chapter_id": 23279, "verse_number": "१-८२-४४", "content_sanskrit": "आदित्यश्च तथा सूर्यश्चांशुमांश्च दिवाकरः  ।\nएते वै द्वादशादित्या व्यपोहंतु मलं मम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003279044, "chapter_id": 23279, "verse_number": "१-८२-४५", "content_sanskrit": "गगनं स्पर्शनं तेजो रसश्च पृथिवी तथा  ।\nचंद्रः सूर्यस्तथात्मा च तनवः शिवभाषिताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003279045, "chapter_id": 23279, "verse_number": "१-८२-४६", "content_sanskrit": "पापं व्यपोहंतु मम भयं निर्नाशयंतु मे  ।\nवासवः पावकश्चैव यमो निर्ऋतिरेव च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003279046, "chapter_id": 23279, "verse_number": "१-८२-४७", "content_sanskrit": "वरुणो वायुसोमौ च ईशानो भगवान् हरिः  ।\nपितामहश्च भगवान् शिवध्यानपरायणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003279047, "chapter_id": 23279, "verse_number": "१-८२-४८", "content_sanskrit": "एते पापं व्यपोहंतु मनसा कर्मणा कृतम्  ।\nनभस्वान्स्पर्शनो वायुरनिलो मारुतस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003279048, "chapter_id": 23279, "verse_number": "१-८२-४९", "content_sanskrit": "प्राणः प्राणेशजीवेशौ मारुतः शिवभाषिताः  ।\nशिवार्चनरताः सर्वे व्यपोहंतु मलं मम ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003279049, "chapter_id": 23279, "verse_number": "१-८२-५०", "content_sanskrit": "खेचरी वसुचारी च ब्रह्मेशो ब्रह्मब्रह्मधीः  ।\nसुषेणः शाश्वतः पृष्टः सुपुष्टश्चमहाबलः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003279050, "chapter_id": 23279, "verse_number": "१-८२-५१", "content_sanskrit": "एते वै चारणाः शंभोः पूजयंतीव भाविताः  ।\nव्यपोहंतु मलं सर्वं पापं चैव मया कृतम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003279051, "chapter_id": 23279, "verse_number": "१-८२-५२", "content_sanskrit": "मंत्रज्ञो मंत्रवित् प्राज्ञो मंत्रराट् सिद्धपूजितः  ।\nसिद्धवत्परमः सिद्धः सर्वसिद्धिप्रदायिनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003279052, "chapter_id": 23279, "verse_number": "१-८२-५३", "content_sanskrit": "व्यपोहंतु मलं सर्वे सिद्धाः शिवपदार्चकाः  ।\nयक्षो यक्षेश धनदो जृंभको मणिभद्रकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003279053, "chapter_id": 23279, "verse_number": "१-८२-५४", "content_sanskrit": "पूर्णभद्रेश्वरो माली शितिकुंडलिरेव च  ।\nनरेंद्रश्चैव यक्षेशा व्यपोहंतु मलं मम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003279054, "chapter_id": 23279, "verse_number": "१-८२-५५", "content_sanskrit": "अनंतः कुलिकश्चैव वासुकिस्तक्षकस्तथा।\nकर्कोटको महापद्मः शंखपालो महाबलः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003279055, "chapter_id": 23279, "verse_number": "१-८२-५६", "content_sanskrit": "शिवप्रणामसंपन्नाः शिवदेहप्रभूषणाः  ।\nमम पापं व्यपोहंतु विषं स्थावरजंगमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003279056, "chapter_id": 23279, "verse_number": "१-८२-५७", "content_sanskrit": "वीणाज्ञः किन्नरश्चैव सुरसेनः प्रमर्दनः  ।\nअतिशयः स प्रयोगी गीतज्ञश्चैव किन्नराः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003279057, "chapter_id": 23279, "verse_number": "१-८२-५८", "content_sanskrit": "शिवप्रणामसंपन्ना व्यपोहंतु मलं मम  ।\nविद्याधरश्च विबुधो विद्याराशिर्विदां वरः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003279058, "chapter_id": 23279, "verse_number": "१-८२-५९", "content_sanskrit": "विबुद्धो विबुधः श्रीमान्कृतज्ञश्च महायशाः  ।\nएते विद्याधराः सर्वे शिवध्यानपरायणाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003279059, "chapter_id": 23279, "verse_number": "१-८२-६०", "content_sanskrit": "व्यपोहंतु मलं घोरं महादेवप्रसादतः  ।\nवामदेवी महाजंभः कालनेमिर्महाबलः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003279060, "chapter_id": 23279, "verse_number": "१-८२-६१", "content_sanskrit": "सुग्रीवो मर्दकश्चैव पिंगलो देवमर्दनः  ।\nप्रह्रादश्चाप्यनुह्रादः संह्रादः किल बाष्कलौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003279061, "chapter_id": 23279, "verse_number": "१-८२-६२", "content_sanskrit": "जंभः कुंभश्च मायवी कार्तवीर्यः कृतंजयः  ।\nएतेऽसुरा महात्मानो महादेवपरायणाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003279062, "chapter_id": 23279, "verse_number": "१-८२-६३", "content_sanskrit": "व्यपोहंतु भयं घोरमासुरं भावमेव च  ।\nगरुत्मान् खगतिश्चैव पक्षिराट् नागमर्दनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003279063, "chapter_id": 23279, "verse_number": "१-८२-६४", "content_sanskrit": "नागशत्रुर्हिरण्यांगो वैनतेयः प्रभंजनः  ।\nनागाशीर्विषनाशश्च विष्णुवाहन एव च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003279064, "chapter_id": 23279, "verse_number": "१-८२-६५", "content_sanskrit": "एते हिरण्यवर्णाभा गरुडा विष्णुवाहनाः  ।\nनानाभरणसंपन्ना व्यपोहंतु मलं मम ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003279065, "chapter_id": 23279, "verse_number": "१-८२-६६", "content_sanskrit": "अगस्त्यश्च वसिष्ठश्च अंगिराभृगुरेव च  ।\nकाश्यपो नारदश्चैव दधीचश्च्यवनस्तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003279066, "chapter_id": 23279, "verse_number": "१-८२-६७", "content_sanskrit": "उपमन्युस्तथान्ये च ऋषयः शिवभाविताः  ।\nशिवार्चनरताः सर्वे व्यपोहंतु मलं मम ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003279067, "chapter_id": 23279, "verse_number": "१-८२-६८", "content_sanskrit": "पितरः पितामहाश्चैव तथैव च प्रपितामहाः  ।\nअग्निष्वात्ता बर्हिषदस्तथा मातामहादयः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003279068, "chapter_id": 23279, "verse_number": "१-८२-६९", "content_sanskrit": "व्यपोहंतु भयं पापं शिवध्यानपरायणाः  ।\nलक्ष्मीश्च धरणी चैव गायत्री च सरस्वती ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003279069, "chapter_id": 23279, "verse_number": "१-८२-७०", "content_sanskrit": "दुर्गा उषा शची ज्येष्ठा मातरः सुरपूजिताः  ।\nदेवानां मातरश्चैव गणानां मातरस्तथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003279070, "chapter_id": 23279, "verse_number": "१-८२-७१", "content_sanskrit": "भूतानां मातरः सर्वा यत्र या गणमातरः  ।\nप्रसादाद्देवदेवस्य व्यपोहंतु मलं मम ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003279071, "chapter_id": 23279, "verse_number": "१-८२-७२", "content_sanskrit": "उर्वशी मेनका चैव रंभा रतितिलोत्तमाः  ।\nसुमुखी दुर्मुखी चैव कामुखी कामवर्धनी ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003279072, "chapter_id": 23279, "verse_number": "१-८२-७३", "content_sanskrit": "तथान्याः सर्वलोकेषु दिव्याश्चाप्सरसस्तथा  ।\nशिवाय तांडवं नित्यं कुर्वंत्योतीव भाविताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003279073, "chapter_id": 23279, "verse_number": "१-८२-७४", "content_sanskrit": "देव्यः शिवार्चनरता व्यपोहंतु मलं मम  ।\nअर्कः सोमोंगारकश्च बुधश्चैव बृहस्पतिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003279074, "chapter_id": 23279, "verse_number": "१-८२-७५", "content_sanskrit": "शुक्रः शनैश्चरश्चैव राहुः केतुस्तथैव च  ।\nव्यपोहंतु भयं घोरं ग्रहपीडां शिवार्चकाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003279075, "chapter_id": 23279, "verse_number": "१-८२-७६", "content_sanskrit": "मेषो वृषोथ मिथुनस्तथा कर्कटकः शुभः  ।\nसिंहश्च कन्या विपुला तुला वै वृश्चिकस्तथा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003279076, "chapter_id": 23279, "verse_number": "१-८२-७७", "content_sanskrit": "धनुश्च मकरश्चैव कुंभो मीनस्तथैव च  ।\nराशयो द्वादश ह्येते शिवपूजापरायणाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003279077, "chapter_id": 23279, "verse_number": "१-८२-७८", "content_sanskrit": "व्यपोहंतु भयं पापं प्रसादात्परमेष्ठिनः  ।\nअश्विनी भरणी चैव कृत्तिका रोहिणी तथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003279078, "chapter_id": 23279, "verse_number": "१-८२-७९", "content_sanskrit": "श्रीमन्मृगशिरश्चार्द्रा पुनर्वसुपुष्यसार्पकाः  ।\nमघा वै पूर्वफाल्गुन्य उत्तराफाल्गुनी तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003279079, "chapter_id": 23279, "verse_number": "१-८२-८०", "content_sanskrit": "हस्तश्चित्रा तथा स्वाती विशाखा चानुराधिका  ।\nज्येष्ठा मूलं महाभागा पूर्वाषाढा तथैव च ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003279080, "chapter_id": 23279, "verse_number": "१-८२-८१", "content_sanskrit": "उत्तराषाढिका चैव श्रवणं च श्रविष्ठिका  ।\nशतभिषक्पूर्वभद्रा च तथा प्रोष्ठपदा तथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003279081, "chapter_id": 23279, "verse_number": "१-८२-८२", "content_sanskrit": "पौष्णं च देव्यः सततं व्यपोहंतु मलं मम  ।\nज्वरः कुंभोदरश्चैव शंकुकर्णो महाबलः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003279082, "chapter_id": 23279, "verse_number": "१-८२-८३", "content_sanskrit": "महाकर्णः प्रभातश्च महाभूतप्रमर्दनः  ।\nश्येनजिच्छिवदूतश्च प्रमथाः प्रीतिवर्धनाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003279083, "chapter_id": 23279, "verse_number": "१-८२-८४", "content_sanskrit": "कोटिकोटिशतैश्चैव भूतानां मातरः सदा  ।\nव्यपोहंतु भयं पापं महादेवप्रसादतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003279084, "chapter_id": 23279, "verse_number": "१-८२-८५", "content_sanskrit": "शिवध्यानैकसंपन्नो हिमराडंबुसन्निभः  ।\nकुन्देन्दुसदृशाकारः कुंभकुंदेंदुभूषणः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003279085, "chapter_id": 23279, "verse_number": "१-८२-८६", "content_sanskrit": "वडवानलशत्रुर्यो वडवामुखभेदनः  ।\nचतुष्पादसमायुक्तः क्षीरोद इव पांडुरः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003279086, "chapter_id": 23279, "verse_number": "१-८२-८७", "content_sanskrit": "रुद्रलोके स्थितो नित्यं रुद्रैः सार्धं गणेश्वरैः  ।\nवृषेंद्रो विश्वधृग्देवो विश्वस्य जगतः पिता ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003279087, "chapter_id": 23279, "verse_number": "१-८२-८८", "content_sanskrit": "वृतो नंदादिभिर्नित्यं मातृभिर्मखमर्दनः  ।\nशिवार्चनरतो नित्यं स मे पापं व्यपोहतु ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003279088, "chapter_id": 23279, "verse_number": "१-८२-८९", "content_sanskrit": "गंगा माता जगन्माता रुद्रलोके व्यवस्थिता  ।\nशिवभक्ता तु या नंदा सा मे पापं व्यपोहतु ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003279089, "chapter_id": 23279, "verse_number": "१-८२-९०", "content_sanskrit": "भद्रा भद्रपदा देवी शिवलोके व्यवस्थिता   ।\nमाता गवां महाभागा सा मे पापं व्यपोहतु ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003279090, "chapter_id": 23279, "verse_number": "१-८२-९१", "content_sanskrit": "सुरभिः सर्वतोभद्रा सर्वपापप्रणाशनी  ।\nरुद्रपूजारता नित्यं सा मे पापं व्यपोहतु ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003279091, "chapter_id": 23279, "verse_number": "१-८२-९२", "content_sanskrit": "सुशीला शीलसंपन्ना श्रीप्रदा शिवभाविता  ।\nशिवलोके स्थिता नित्यं सा मे पापं व्यपोहतु ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003279092, "chapter_id": 23279, "verse_number": "१-८२-९३", "content_sanskrit": "वेदशास्त्रार्थतत्त्वज्ञः सर्वकार्याभिचिंतकः  ।\nसमस्तगुणसंपन्नः सर्वदेवेश्वरात्मजः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003279093, "chapter_id": 23279, "verse_number": "१-८२-९४", "content_sanskrit": "ज्येष्ठः सर्वेश्वरः सौम्यो महा विष्णुतनुः स्वयम्  ।\nआर्यः सेनापतिः साक्षाद्गहनो मखमर्दनः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003279094, "chapter_id": 23279, "verse_number": "१-८२-९५", "content_sanskrit": "ऐरावतगजारूढः कृष्णकुंचितमूर्धजः  ।\nकृष्णांगो रक्तनयनः शशिपन्नगभूषणः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003279095, "chapter_id": 23279, "verse_number": "१-८२-९६", "content_sanskrit": "भूतैः प्रेतैः पिशाचैश्च कूष्माण्डैश्च समावृतः  ।\nशिवार्चनरतः साक्षात्स मे पापं व्यपोहतु ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003279096, "chapter_id": 23279, "verse_number": "१-८२-९७", "content_sanskrit": "ब्रह्माणी चैव माहेशी कौमारी वैष्णवी तथा  ।\nवाराही चैव माहेंद्री चामुंडाग्नेयिका तथा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003279097, "chapter_id": 23279, "verse_number": "१-८२-९८", "content_sanskrit": "एता वै मातरः सर्वाः सर्वलोकप्रपूजिताः  ।\nयोगिनीभीर्महापापं व्यपोहंतु समाहिताः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003279098, "chapter_id": 23279, "verse_number": "१-८२-९९", "content_sanskrit": "वीरभद्रो महातेजा हिमकुंदेंदुसन्निभः  ।\nरुद्रस्य तनयो रौद्रः शूलासक्तमहाकरः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003279099, "chapter_id": 23279, "verse_number": "१-८२-१००", "content_sanskrit": "सहस्रबाहुः सर्वज्ञः सर्वायुधधरः स्वयम्  ।\nत्रेताग्निनयनो देवस्त्रैलोक्याभयदः प्रभुः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003279100, "chapter_id": 23279, "verse_number": "१-८२-१०१", "content_sanskrit": "मातॄणां रक्षको नित्यं महावृषभवाहनः  ।\nत्रैलोक्यनमितः श्रीमान्शिवपादार्चने रतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003279101, "chapter_id": 23279, "verse_number": "१-८२-१०२", "content_sanskrit": "यज्ञस्य च शिरश्छेत्ता पूष्णो दंतविनाशनः  ।\nवह्नेर्हस्तहरः साक्षाद्भगनेत्रनिपातनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003279102, "chapter_id": 23279, "verse_number": "१-८२-१०३", "content_sanskrit": "पादांगुष्ठेन सोमांगपेषकः प्रभुसंज्ञकः  ।\nउपेंद्रेंद्रयमादीनां देवानामंगरक्षकः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003279103, "chapter_id": 23279, "verse_number": "१-८२-१०४", "content_sanskrit": "सरस्वत्य महादेव्या नासिकोष्ठावकर्तनः  ।\nगणेश्वरोयः सेनानीः स मे पापं व्यपोहतु ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003279104, "chapter_id": 23279, "verse_number": "१-८२-१०५", "content_sanskrit": "ज्येष्ठा वरिष्ठा वरदा वराभरणभूषिता  ।\nमहालक्ष्मीर्जगन्माता सा मे पापं व्यपोहतु ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003279105, "chapter_id": 23279, "verse_number": "१-८२-१०६", "content_sanskrit": "महामोहा महाभागा महाभूतगणैर्वृता  ।\nशिवार्चनरता नित्यं सा मे पापं व्यपोहतु ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003279106, "chapter_id": 23279, "verse_number": "१-८२-१०७", "content_sanskrit": "लक्ष्मीः सर्वगुणोपेता सर्वलक्षणसंयुता  ।\nसर्वदा सर्वगा देवी सा मे पापं व्यपोहतु ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003279107, "chapter_id": 23279, "verse_number": "१-८२-१०८", "content_sanskrit": "सिंहारूढा महादेवी पार्वत्यास्तनयाव्यया  ।\nविष्णोर्निद्रा महामाया वैष्णवी सुरपूजिता ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003279108, "chapter_id": 23279, "verse_number": "१-८२-१०९", "content_sanskrit": "त्रिनेत्र वरदा देवी महिषासुरमर्दिनी  ।\nशिवार्चनरता दुर्गा सा मे पापं व्यवोहतु ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003279109, "chapter_id": 23279, "verse_number": "१-८२-११०", "content_sanskrit": "ब्रह्मांडधारका रुद्राः सर्वलोकप्रपूजिताः  ।\nसत्याश्च मानसाः सर्वे व्यपोहन्तु भयं मम ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003279110, "chapter_id": 23279, "verse_number": "१-८२-१११", "content_sanskrit": "भूताः प्रेताः पिशाचाश्च कूष्मांडगणनायकाः  ।\nकूष्मांडकाश्च ते पापं व्यपोहन्तु समाहिताः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003279111, "chapter_id": 23279, "verse_number": "१-८२-११२", "content_sanskrit": "अनेन देवं स्तुत्वा तु चांते सर्वं समापयेत्  ।\nप्रणम्य शिरसा भूमौ प्रतिमासे द्विजोत्तमाः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003279112, "chapter_id": 23279, "verse_number": "१-८२-११३", "content_sanskrit": "व्यपोहनस्तवं दिव्यं यः पठेच्छृणुयादपि  ।\nविधूय सर्वपापानि रुद्रलोकेमहीयते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003279113, "chapter_id": 23279, "verse_number": "१-८२-११४", "content_sanskrit": "कन्यार्थी लभते कन्यां जयकामो जयं लभेत्  ।\nअर्थकामो लभेदर्थं पुत्रकामो बहून् सुतान् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003279114, "chapter_id": 23279, "verse_number": "१-८२-११५", "content_sanskrit": "विद्यार्थी लभते विद्यां भोगार्थी भोगमाप्नुयात्  ।\nयान्यान्प्रार्थयते कामान्मानवः श्रवणादिह ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003279115, "chapter_id": 23279, "verse_number": "१-८२-११६", "content_sanskrit": "तान्सर्वान् शीघ्रमाप्नोति देवानां च प्रियो भवेत्  ।\nपठ्यमानमिदं पुण्यं यमुद्दिश्य तु पठ्यते ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003279116, "chapter_id": 23279, "verse_number": "१-८२-११७", "content_sanskrit": "तस्य रोगा न बाधंते वातपित्तादिसंभवाः  ।\nनाकाले मरणं तस्य न सर्पैरपि दश्यते ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003279117, "chapter_id": 23279, "verse_number": "१-८२-११८", "content_sanskrit": "यत्पुण्यं चैव तीर्थानां यज्ञानां चैव यत्फलम्  ।\nदानानां चैव यत्पुण्यं व्रतानां च विशेषतः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003279118, "chapter_id": 23279, "verse_number": "१-८२-११९", "content_sanskrit": "तत्पुण्यं कोटिगुणितं जप्त्वा चाप्नोति मानवः  ।\nगोघ्नश्चैव कृतघ्नश्च वीरहा ब्रह्महा भवेत् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003279119, "chapter_id": 23279, "verse_number": "१-८२-१२०", "content_sanskrit": "शरणागतघाती च मित्रविश्वासघातकः  ।\nदुष्टः पापसमाचारो मातृहा पितृहा तथा ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003279120, "chapter_id": 23279, "verse_number": "१-८२-१२१", "content_sanskrit": "व्यपोह्य सर्वपापानि शिवलोके महीयते ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]