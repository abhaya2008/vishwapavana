[{"id": 900008362, "chapter_id": 8629, "verse_number": "10.1", "content_sanskrit": "अत्राध्यात्मिकप्राणादिशब्दसमन्वय उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008363, "chapter_id": 8629, "verse_number": "10.2", "content_sanskrit": "अत्र प्राणः किं मुख्यवायुरुत ब्रह्मेति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008364, "chapter_id": 8629, "verse_number": "10.3", "content_sanskrit": "नन्वाकाशाधिकरणपूर्वपक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008365, "chapter_id": 8629, "verse_number": "10.4", "content_sanskrit": "एतेन ‘‘प्राणस्तथा’’ इत्यनेनास्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008366, "chapter_id": 8629, "verse_number": "10.5", "content_sanskrit": "केचित्तु ‘‘अन्वयव्यतिरेकाभ्यां हि हेतुता कल्प्या..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008367, "chapter_id": 8629, "verse_number": "10.6", "content_sanskrit": "प्रमाणाश्रिता तु पूर्वत्राकाशश्रुतेरिवेह न श्रुतेरावृत्तिमात्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008368, "chapter_id": 8629, "verse_number": "10.7", "content_sanskrit": "न च श्रीपतित्वादिकं लिङ्गं निरवकाशमिति वाच्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008369, "chapter_id": 8629, "verse_number": "10.8", "content_sanskrit": "कथं चानुवाकद्वयं भिन्नार्थम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008370, "chapter_id": 8629, "verse_number": "10.9", "content_sanskrit": "अन्ये तु ‘‘प्रस्तोतर्या देवताप्रस्तावम्’’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008371, "chapter_id": 8629, "verse_number": "10.10", "content_sanskrit": "तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008372, "chapter_id": 8629, "verse_number": "10.11", "content_sanskrit": "यच्चोक्तं पुंवाक्यस्येत्यादि तत्र ब्रूमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008373, "chapter_id": 8629, "verse_number": "10.12", "content_sanskrit": "केचित्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008374, "chapter_id": 8629, "verse_number": "10.13", "content_sanskrit": "अत्र श्रुतिलिङ्गबाहुल्येन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008375, "chapter_id": 8629, "verse_number": "10.14", "content_sanskrit": "न च पूर्वत्र प्रसिद्ध्यवलम्बेन श्रुत्या पूर्वपक्षे लिङ्गैः सिद्धान्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008376, "chapter_id": 8629, "verse_number": "10.15", "content_sanskrit": "दृष्टं हि ‘‘दर्शपूर्णमासाभ्यां यजेत’’ इत्यादौ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008377, "chapter_id": 8629, "verse_number": "10.16", "content_sanskrit": "चक्षुरादिभिश्चातिनिकृष्टैः सर्वोत्कृष्टस्य ब्रह्मणः कलहोऽप्ययुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008378, "chapter_id": 8629, "verse_number": "10.17", "content_sanskrit": "नन्वथापि ‘‘प्राचीनोऽप्यन्यः’’ इति प्रयोजनोक्तिरयुक्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008379, "chapter_id": 8629, "verse_number": "10.18", "content_sanskrit": "न च तत्र श्रीपतित्वादिलिङ्गात्प्राणशब्दस्य विष्ण्वर्थत्वे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008380, "chapter_id": 8629, "verse_number": "10.19", "content_sanskrit": "एवं च ‘‘अत एव प्राणः’’ इत्यत्र..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008381, "chapter_id": 8629, "verse_number": "10.20", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008382, "chapter_id": 8629, "verse_number": "10.21", "content_sanskrit": "चक्षुरादिसाहचर्यं तु सति संशये निर्णायकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008383, "chapter_id": 8629, "verse_number": "10.22", "content_sanskrit": "सूत्रक्रमस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008384, "chapter_id": 8629, "verse_number": "10.23", "content_sanskrit": "अन्ये तु प्रतर्दनं प्रतीन्द्रेण प्रयुक्तं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900008385, "chapter_id": 8629, "verse_number": "10.24", "content_sanskrit": "केचित्तु ‘‘मामुपास्स्व’’ इतीन्द्रलिङ्गात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900008386, "chapter_id": 8629, "verse_number": "10.25", "content_sanskrit": "यत्तु परकीयं ‘‘न वक्तुः’’ इति सूत्रव्याख्यानं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900008387, "chapter_id": 8629, "verse_number": "10.26", "content_sanskrit": "यच्च शास्त्रदृष्ट्येत्यस्य परकीयं व्याख्यानं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900008388, "chapter_id": 8629, "verse_number": "10.27", "content_sanskrit": "केचित्तु ‘‘यस्यात्मा शरीरम्’’ इत्यादि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900008389, "chapter_id": 8629, "verse_number": "10.28", "content_sanskrit": "इतरे तु प्राणधर्मेण बुद्धिधर्मेण स्वधर्मेण..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]