[{"id": 2212317, "chapter_id": 5522, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212318, "chapter_id": 5522, "verse_number": "१", "content_sanskrit": "कीदृशा ब्राह्मणा पुण्या भावशुद्धाः सुरेश्वर ।\nतत्कर्म सफलं नेति कथयस्व ममानघ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212319, "chapter_id": 5522, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212320, "chapter_id": 5522, "verse_number": "२", "content_sanskrit": "शृणु पाण्डव तत्सर्वं ब्राह्मणानां यथाक्रमम् ।\nसफलं निष्फलं चेति तेषां कर्म ब्रवीमि ते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212321, "chapter_id": 5522, "verse_number": "३", "content_sanskrit": "त्रिदण्डधारणं मौनं जटाधारणमुण्डनम् ।\nवल्कलाजिनसंवासो व्रतचर्याऽभिषेचनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212322, "chapter_id": 5522, "verse_number": "४", "content_sanskrit": "अग्निहोत्रं वने वासः स्वाध्यायो दानसत्क्रिया ।\nसर्वाण्येतानि वै मिथ्या यदि भावो न निर्मलः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212323, "chapter_id": 5522, "verse_number": "५", "content_sanskrit": "अग्निहोत्रं वृथा राजन् वृथा वेदास्तथैव च ।\nशीलेन देवास्तुष्यन्ति श्रुतयस्तत्र कारणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212324, "chapter_id": 5522, "verse_number": "६", "content_sanskrit": "क्षान्तं दान्तं जितक्रोधं जितात्मानं जितेन्द्रियम् ।\nतमग्र्यं ब्राह्मणं मन्ये शेषाः शूद्रा इति स्मृताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212325, "chapter_id": 5522, "verse_number": "७", "content_sanskrit": "अग्निहोत्रव्रतपरान् स्वाध्यायनिरतान् शुचीन् ।\nउपवासरतान् दान्तान् तान् देवा ब्राह्मणान् विदुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212326, "chapter_id": 5522, "verse_number": "८", "content_sanskrit": "न जातिः पूज्यते राजन् गुणाः कल्याणकारणाः ।\nचण्डालमपि वृत्तस्थं तं देवा ब्राह्मणं विदुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212327, "chapter_id": 5522, "verse_number": "९", "content_sanskrit": "मनःशौचं कर्मशौचं कुलशौचं च भारत ।\nशरीरशौचं वाक्छौचं शौचं पञ्चविधं स्मृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212328, "chapter_id": 5522, "verse_number": "१०", "content_sanskrit": "पञ्चस्वेतेषु शौचेषु हृदि शौचं विशिष्यते ।\nहृदयस्य च शौचेन स्वर्गं गच्छन्ति मानवाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212329, "chapter_id": 5522, "verse_number": "११", "content_sanskrit": "अग्निहोत्रपरिभ्रष्टः प्रसक्तः क्रयविक्रये ।\nवर्णसङ्करकर्ता च ब्राह्मणो वृषलैः समः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212330, "chapter_id": 5522, "verse_number": "१२", "content_sanskrit": "यस्य वेदश्रुतिर्नष्टा कर्षकश्चापि यो द्विजः ।\nविकर्मसेवी कौन्तेय स वै वृषल उच्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212331, "chapter_id": 5522, "verse_number": "१३", "content_sanskrit": "वृषो हि धर्मो विज्ञेयस्तस्य यः कुरुते लयम् ।\nवृषलं तं विदुर्देवा निकृष्टं श्वपचादपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212332, "chapter_id": 5522, "verse_number": "१४", "content_sanskrit": "स्तुतिभिर्ब्रह्मपूर्वाभिर्यः शूद्रं स्तौति मानवः ।\nन तु मां स्तौति पापात्मा स तु चण्डाल एव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212333, "chapter_id": 5522, "verse_number": "१५", "content_sanskrit": "श्वदृतौ तु यथा क्षीरं ब्रह्म वै वृषले तथा ।\nदुष्टतामेति तत्सर्वं शुना लीढं हविर्यथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212334, "chapter_id": 5522, "verse_number": "१६", "content_sanskrit": "अङ्गानि वेदाश्चत्वारो मीमांसा न्यायविस्तरः ।\nधर्मशास्त्रं पुराणं च विद्या ह्येताश्चतुर्दश ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212335, "chapter_id": 5522, "verse_number": "१७", "content_sanskrit": "यान्युक्तानि मया सम्यग् विद्यास्थानानि भारत ।\nउत्पन्नानि पवित्राणि पावनार्थं तथैव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212336, "chapter_id": 5522, "verse_number": "१८", "content_sanskrit": "तस्मात् तानि न शूद्रस्य स्प्रष्टव्यानि युधिष्ठिर ।\nसर्वं च शूद्रसंस्पृष्टमपवित्रं न संशयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212337, "chapter_id": 5522, "verse_number": "१९", "content_sanskrit": "लोके त्रीण्यपवित्राणि पञ्चामेध्यानि भारत ।\nश्वा च शूद्रः श्वपाकश्च अपवित्राणि भारत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212338, "chapter_id": 5522, "verse_number": "२०", "content_sanskrit": "देवलः कुक्कुटो यूपो ह्युदक्या वृषलीपतिः ।\nपञ्चैते स्युरमेध्याश्च स्प्रष्टव्या न कदाचन ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212339, "chapter_id": 5522, "verse_number": "२१", "content_sanskrit": "स्पृष्ट्वैतानष्ट वै विप्रः सचेलो जलमाविशेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212340, "chapter_id": 5522, "verse_number": "२२", "content_sanskrit": "मद्भक्तान् शूद्रसामान्याद् अवमन्यन्ति ये नराः ।\nनरकेष्वेव तिष्ठन्ति वर्षकोटिं नराधमाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212341, "chapter_id": 5522, "verse_number": "२३", "content_sanskrit": "चण्डालमपि मद्भक्तं नावमन्येत बुद्धिमान् ।\nअवमत्य पतन्त्येव नरके रौरवे नराः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212342, "chapter_id": 5522, "verse_number": "२४", "content_sanskrit": "मम मद्भक्तभक्तेषु प्रीतिरभ्यधिका नृप ।\nतस्मान्मद्भक्तभक्ताश्च पूजनीया विशेषतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212343, "chapter_id": 5522, "verse_number": "२४", "content_sanskrit": "कीटपक्षिमृगाणां च मयि सन्न्यस्तचेतसाम् ।\nऊर्ध्वामेव गतिं विद्धि किं पुनर्ज्ञानिनां नृणाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212344, "chapter_id": 5522, "verse_number": "२६", "content_sanskrit": "पत्रं वाऽप्यथवा पुष्पं फलं वाऽप्यप एव वा ।\nददाति मम शूद्रोऽपि शिरसा धारयामि तत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212345, "chapter_id": 5522, "verse_number": "२७", "content_sanskrit": "विप्रानेवार्चयेद् भक्त्या शूद्रप्रायांश्च मत्प्रियान् ।\nतेषां तेनैव रूपेण पूजां गृह्णामि भारत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212346, "chapter_id": 5522, "verse_number": "२८", "content_sanskrit": "वेदोक्तेनैव मार्गेण सर्वभूतहृदि स्थितम् ।\nमामर्चयन्ति ये विप्रा मत्सायुज्यं व्रजन्ति ते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212347, "chapter_id": 5522, "verse_number": "२९", "content_sanskrit": "ब्राह्मणानां हितायैव प्रादुर्भावः कृतो मया ।\nप्रादुर्भावाकृतिः काचिद् अर्चनीया युधिष्ठिर ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212348, "chapter_id": 5522, "verse_number": "३०", "content_sanskrit": "आसामान्यतमां मूर्तिं यो मद्भक्त्या समर्चति ।\nतेनैव परितुष्टोऽहं भविष्यामि न संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212349, "chapter_id": 5522, "verse_number": "३१", "content_sanskrit": "मृदा च मणिरत्नैश्च ताम्रेण रजतेन वा ।\nकृत्वा प्रतिकृतिं कुर्यादर्चनां काञ्चनेन वा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212350, "chapter_id": 5522, "verse_number": "३२", "content_sanskrit": "पुण्यं दशगुणं विद्यादेतेषामुत्तरोत्तरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212351, "chapter_id": 5522, "verse_number": "३३", "content_sanskrit": "जयकामोऽर्चयेद् राजा विद्याकामो द्विजोत्तमः ।\nवैश्यो वा धनकामो हि शूद्रः पुण्यं फलं स्त्रियः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212352, "chapter_id": 5522, "verse_number": "३४", "content_sanskrit": "सर्वकामाः स्त्रियो वाऽपि सर्वान् कामानवाप्नुयुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212353, "chapter_id": 5522, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे विष्णुभक्त्यादिमहिमावर्णनं नाम षोडशोत्तरशततमोऽध्यायः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]