[{"id": 2071479, "chapter_id": 2509, "verse_number": "१२-१४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071480, "chapter_id": 2509, "verse_number": "१२-१४-१", "content_sanskrit": "अव्याहरति कौन्तेये धर्मराजे युधिष्ठिरे।\nभ्रातृणां ब्रुवतां तांस्तान्विविधान्वेदनिश्चयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071481, "chapter_id": 2509, "verse_number": "१२-१४-२", "content_sanskrit": "महाभिजनसंपन्ना श्रीमत्यायतलोचना।\nअभ्यभाषत राजानं द्रौपदी योषितां वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071482, "chapter_id": 2509, "verse_number": "१२-१४-३", "content_sanskrit": "आसीनमृषभं राज्ञां भ्रातृभिः परिवारितम्।\nसिंहशार्दूलसदृशैर्वारणैरिव यूथपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071483, "chapter_id": 2509, "verse_number": "१२-१४-४", "content_sanskrit": "अभिमानवती नित्यं विशेषेण युधिष्ठिरे।\nलालिता सततं राज्ञा धर्माधर्मनिदर्शिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071484, "chapter_id": 2509, "verse_number": "१२-१४-५", "content_sanskrit": "आमन्त्रयित्वा सुश्रोणी साम्ना परमवल्गुना।\nभर्तारमभिसंप्रेक्ष्य ततो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071485, "chapter_id": 2509, "verse_number": "१२-१४-६x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071486, "chapter_id": 2509, "verse_number": "१२-१४-६", "content_sanskrit": "इमे ते भ्रातरः पार्थ शुष्यन्ते स्तोकका इव।\nवावाश्यमानास्तिष्ठन्ति न चैनानभिनन्दसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071487, "chapter_id": 2509, "verse_number": "१२-१४-७", "content_sanskrit": "नन्दयैतान्महाराज मत्तानिव महाद्विपान्।\nउपपन्नेन वाक्येन सततं दुःखभागिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071488, "chapter_id": 2509, "verse_number": "१२-१४-८", "content_sanskrit": "कथं द्वैतवने राजन्पूर्वमुक्त्वा तथा वचः।\nभ्रातॄनेतान्स्म सहिताञ्शीतवातातपार्दितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071489, "chapter_id": 2509, "verse_number": "१२-१४-९", "content_sanskrit": "वयं दुर्योधनं हत्वा मृधे भोक्ष्याम मेदिनीम्।\nसंपूर्णां सर्वकामानामाहवे विजयैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071490, "chapter_id": 2509, "verse_number": "१२-१४-१०", "content_sanskrit": "नृवीरांश्च रथान्हत्वा निहत्य च महागजान्।\nसंस्तीर्य च रथैर्भूमिं ससादिभिररिंदमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071491, "chapter_id": 2509, "verse_number": "१२-१४-११", "content_sanskrit": "यजेभ विविधैर्यज्ञैः समृद्धैराप्तदक्षिणैः।\nवनवासकृतं दुःखं भविष्यति सुखाय नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071492, "chapter_id": 2509, "verse_number": "१२-१४-१२", "content_sanskrit": "इत्येतानेवमुक्त्वा त्वं स्वयं धर्मभृतां वर।\nकथमद्य पुनर्वीर विनिहंसि मनांसि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071493, "chapter_id": 2509, "verse_number": "१२-१४-१३", "content_sanskrit": "न क्लीबो वसुधां भुङ्क्ते न क्लीबो धनमश्नुते।\nन क्लीबस्य गृहे पुत्रा मत्स्याः पङ्क इवासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071494, "chapter_id": 2509, "verse_number": "१२-१४-१४", "content_sanskrit": "नादण्डः क्षत्रियो भाति नादण्डो भूमिमश्नुते।\nनादण्डस्य प्रजा राज्ञः सुखं विन्दन्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071495, "chapter_id": 2509, "verse_number": "१२-१४-१५", "content_sanskrit": "`सदेवासुरगन्घर्वैरप्सरोभिर्विभूषितम्।\nरक्षोभिर्गुह्यकैर्नागैर्मनुष्यैश्च विभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071496, "chapter_id": 2509, "verse_number": "१२-१४-१६", "content_sanskrit": "त्रिवर्गेण च संपूर्णं त्रिवर्गस्यागमेन च।\nदण्डेनाभ्याहृतं सर्वं जगद्भोगाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071497, "chapter_id": 2509, "verse_number": "१२-१४-१७", "content_sanskrit": "स्वायंभुवं महीपाल आगमं शृणु शाश्वतम्।\nविप्राणां विदितश्चायं तव चैव विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071498, "chapter_id": 2509, "verse_number": "१२-१४-१८", "content_sanskrit": "अराजके हि लोकेऽस्मिन्सर्वतो विद्रुते भयात्।\nरक्षार्थमस्य लोकस्य राजानमसृजत्प्रभुः।\nमहाकायं महावीर्यं पालने जगतः क्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071499, "chapter_id": 2509, "verse_number": "१२-१४-१९", "content_sanskrit": "अनिलाग्नियमार्काणामिन्द्रस्य वरुणस्य च।\nचन्द्रवित्तेशयोश्चैव मात्रा निर्हृत्य शाश्वतीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071500, "chapter_id": 2509, "verse_number": "१२-१४-२०", "content_sanskrit": "यस्मादेषां सुरेन्द्राणां संभवत्यंशतो नृपः।\nतस्मादभिभवत्येष सर्वभूतानि तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071501, "chapter_id": 2509, "verse_number": "१२-१४-२१", "content_sanskrit": "तपत्यादित्यवच्चैव चक्षूंषि च मनांसि च।\nच चैनं भुवि शक्नोति कश्चिदप्यभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071502, "chapter_id": 2509, "verse_number": "१२-१४-२२", "content_sanskrit": "सोऽग्निर्भवति वायुश्च सोऽर्कः सोमश्च धर्मराट्।\nस कुबेरः स वरुणः स महेन्द्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071503, "chapter_id": 2509, "verse_number": "१२-१४-२३", "content_sanskrit": "पितामहस्य देवस्य विष्णोः शर्वस्य चैव हि।\nऋषीणां चैव सर्वेषां तस्मिंस्तेजः प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071504, "chapter_id": 2509, "verse_number": "१२-१४-२४", "content_sanskrit": "बालोऽपि नावमन्तव्यो मनुष्य इति भूमिपः।\nमहती देवता ह्येषा नररूपेण तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071505, "chapter_id": 2509, "verse_number": "१२-१४-२५", "content_sanskrit": "एकमेव दहत्यग्निर्नरं दुरुपसर्पिणम्।\nकुलं दहति राजाग्निः सपशुद्रव्यसंचयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071506, "chapter_id": 2509, "verse_number": "१२-१४-२६", "content_sanskrit": "धृतराष्ट्रकुलं दग्धं क्रोधोद्भूतेन वह्निना।\nप्रत्यक्षमेतल्लोकस्य संशयो हि न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071507, "chapter_id": 2509, "verse_number": "१२-१४-२७", "content_sanskrit": "कुलजो वृत्तसंपन्नो धार्मिकश्च महीपतिः।\nप्रजानां पालने युक्तः पूज्यते दैवतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071508, "chapter_id": 2509, "verse_number": "१२-१४-२८", "content_sanskrit": "कार्यं योऽवेक्ष्य शक्तिं च देशकालौ च तत्वतः।\nकुरुते धर्मसिद्ध्यर्थं वैश्वरूप्यं पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071509, "chapter_id": 2509, "verse_number": "१२-१४-२९", "content_sanskrit": "तस्य प्रसादे पझा श्रीर्विजयश्च पराक्रमे।\nमृत्युश्च वसति क्रोधे सर्वतेजोमयो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071510, "chapter_id": 2509, "verse_number": "१२-१४-३०", "content_sanskrit": "तं यस्तु द्वेष्टि संमोहात्स विनश्यति मानवः।\nतस्य ह्याशुविनाशाय राजाऽपि कुरुते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071511, "chapter_id": 2509, "verse_number": "१२-१४-३१", "content_sanskrit": "तस्माद्धर्मं यदिष्टेषु स व्यवस्यति पार्थिवः।\nअनिष्टं चाप्यनिष्टेषु तद्धर्मं न विचालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071512, "chapter_id": 2509, "verse_number": "१२-१४-३२", "content_sanskrit": "तस्यार्थे सर्वभूतानां गोप्तारं धर्ममात्मजम्॥\nब्रह्मतेजोमयं दण्डमसृजत्पूर्वमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071513, "chapter_id": 2509, "verse_number": "१२-१४-३३", "content_sanskrit": "तस्य सर्वाणि भूतानि स्थावराणि चराणि च।\nभयाद्भोगाय कल्पन्ते धर्मान्न विचलन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071514, "chapter_id": 2509, "verse_number": "१२-१४-३४", "content_sanskrit": "देशकालौ च शक्तिं च कार्यं चावेक्ष्य तत्वतः।\nयथार्हतः संप्रणयेन्नरेष्वन्यायवर्तिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071515, "chapter_id": 2509, "verse_number": "१२-१४-३५", "content_sanskrit": "स राजा पुरुषो दण्डः स नेता शासिता च सः।\nवर्णानामाश्रमाणां च धर्मप्रभुरथाव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071516, "chapter_id": 2509, "verse_number": "१२-१४-३६", "content_sanskrit": "दण्डः शास्ति प्रजाः सर्वा दण्ड एवाभिरक्षति।\nदण्डः सुप्तेषु जागर्ति दण्डं धर्मं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071517, "chapter_id": 2509, "verse_number": "१२-१४-३७", "content_sanskrit": "सुसमीक्ष्य धृतो दण्डः सर्वा रञ्जयति प्रजाः।\nअसमीक्ष्य प्रणीतस्तु विनाशयति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071518, "chapter_id": 2509, "verse_number": "१२-१४-३८", "content_sanskrit": "यदि न प्रणयेद्राजा दण्डं दण्ड्येष्वतन्द्रितः।\nजले मत्स्यानिवाभक्ष्यन्दुर्बलान्बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071519, "chapter_id": 2509, "verse_number": "१२-१४-३९", "content_sanskrit": "काकोऽद्याच्च पुरोडाशं श्वा चैवावलिहेद्धविः।\nस्वामित्वं न क्वचिच्च स्यात्प्रपद्येताधरोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2071520, "chapter_id": 2509, "verse_number": "१२-१४-४०", "content_sanskrit": "सर्वो दण्डजितो लोको दुर्लभस्तु शुचिर्नरः।\nदण्डस्य हि भयात्सर्वं जगद्भोगाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2071521, "chapter_id": 2509, "verse_number": "१२-१४-४१", "content_sanskrit": "देवदानवगन्धर्वा रक्षांसि पतगोरगाः।\nतेऽपि भोगाय कल्पन्ते दण्डेनैवाभिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2071522, "chapter_id": 2509, "verse_number": "१२-१४-४२", "content_sanskrit": "दूष्येयुः सर्ववर्णाश्च भिद्येरन्सर्वसेतवः।\nसर्वलोकप्रकोपश्च भवेद्दण्डस्य विभ्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2071523, "chapter_id": 2509, "verse_number": "१२-१४-४३", "content_sanskrit": "यत्र श्यामो लोहिताक्षो दण्डश्चरति पापहा।\nप्रजास्तत्र न मुह्यन्ति नेता चेत्साधु पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2071524, "chapter_id": 2509, "verse_number": "१२-१४-४४", "content_sanskrit": "आहुस्तस्य प्रणेतारं राजानं सत्यवादिनम्।\nसमीक्ष्यकारिणं प्राज्ञं धर्मकामार्थकोविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2071525, "chapter_id": 2509, "verse_number": "१२-१४-४५", "content_sanskrit": "तं राजा प्रणयन्सम्यक्स्वर्गायाभिप्रवर्तते।\nकामात्मविषयी क्षुद्रो दण्डेनैव निहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2071526, "chapter_id": 2509, "verse_number": "१२-१४-४६", "content_sanskrit": "दण्डो हि सुमहातेजा दुर्धरश्चाकृतात्मभिः।\nधर्माद्विचलितं हन्ति नृपमेव सबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2071527, "chapter_id": 2509, "verse_number": "१२-१४-४७", "content_sanskrit": "ततो दुर्गं च राष्ट्रं च लोकं च सचराचरम्।\nअन्तरिक्षगतांश्चैव मुनीन्देवांश्च हिंसति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2071528, "chapter_id": 2509, "verse_number": "१२-१४-४८", "content_sanskrit": "सोऽसहायेन मूढेन लुब्धेनाकृतबुद्धिना।\nअशक्यो न्यायतो नेतुं विषयांश्चैव सेवता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2071529, "chapter_id": 2509, "verse_number": "१२-१४-४९", "content_sanskrit": "शुचिना सत्यसन्धेन नीतिशास्त्रानुसारिणा।\nदण्डः प्रणेतुं शक्यो हि सुसहायेन धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2071530, "chapter_id": 2509, "verse_number": "१२-१४-५०", "content_sanskrit": "स्वराष्ट्रे न्यायवर्ती स्याद्भृशदण्डश्च शत्रुषु।\nसुहृत्स्वजिह्मः स्निग्धेषु ब्राह्मणेषु क्षमान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2071531, "chapter_id": 2509, "verse_number": "१२-१४-५१", "content_sanskrit": "एवंवृत्तस्य राज्ञस्तु शिलोञ्छेनापि जीवतः।\nविस्तीर्येत यशो लोके तैलबिन्दुरिवाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2071532, "chapter_id": 2509, "verse_number": "१२-१४-५२", "content_sanskrit": "अतस्तु विपरीतस्य नृपतेरकृतात्मनः।\nसंक्षिप्येन यशो लोके घृतबिन्दुरिवाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2071533, "chapter_id": 2509, "verse_number": "१२-१४-५३", "content_sanskrit": "देवदेवेन रुद्रेण ब्रह्मणा च महीपते।\nविष्णुना चैव देवेन शक्रेण च महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2071534, "chapter_id": 2509, "verse_number": "१२-१४-५४", "content_sanskrit": "लोकपालैश्च भूतैश्च पाण्डवैश्च महात्मभिः।\nधर्माद्विचलिता राजन्धार्तराष्ट्रा निपातिताः।\nअधार्मिका दुराचाराः ससैन्या विनिपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2071535, "chapter_id": 2509, "verse_number": "१२-१४-५५", "content_sanskrit": "तान्निहत्य न दोषस्ते स्वल्पोऽपि जगतीपते।\nछलेन मायया वाऽथ क्षत्रधर्मेण वा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2071536, "chapter_id": 2509, "verse_number": "१२-१४-५६", "content_sanskrit": "मित्रता सर्वभूतेषु दानमध्ययनं तपः।\nब्राह्मणस्यैव धर्मः स्यान्न राज्ञो राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2071537, "chapter_id": 2509, "verse_number": "१२-१४-५७", "content_sanskrit": "असतां प्रतिषेधश्च सतां च परिपालनम्।\nएष राज्ञां परो धर्मः समरे चापलायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2071538, "chapter_id": 2509, "verse_number": "१२-१४-५८", "content_sanskrit": "यस्मिन्क्षमा च क्रोधश्च दानादाने भयाभये।\nनिग्रहानुग्रहौ चोभौ स वै धर्मविदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2071539, "chapter_id": 2509, "verse_number": "१२-१४-५९", "content_sanskrit": "न श्रुतेन न दानेन न सांत्वेन न चेज्यया।\nत्वयेयं पृथिवी लब्धा न संकोचेन चाप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2071540, "chapter_id": 2509, "verse_number": "१२-१४-६०", "content_sanskrit": "यत्तद्बलममित्राणां तथा वीरसमुद्यतम्।\nहस्त्यश्वरथसंपन्नं त्रिभिरङ्गैरनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2071541, "chapter_id": 2509, "verse_number": "१२-१४-६१", "content_sanskrit": "रक्षितं द्रोणकर्णाभ्यामश्वत्थाम्ना कृपेण च।\nतत्त्वया निहतं वीर तस्माद्भुङ्क्ष्व वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2071542, "chapter_id": 2509, "verse_number": "१२-१४-६२", "content_sanskrit": "जम्बूद्वीपो महाराज नानाजनपदैर्युतः।\nत्वया पुरुषशार्दूल दण्डेन मृदितः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2071543, "chapter_id": 2509, "verse_number": "१२-१४-६३", "content_sanskrit": "जम्बूद्वीपेन सदृशः क्रौञ्चद्वीपो नराधिप।\nअपरेण महामेरोर्दण्डेन मृदितस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2071544, "chapter_id": 2509, "verse_number": "१२-१४-६४", "content_sanskrit": "क्रौञ्चद्वीपेन सदृशः शाकद्वीपो नराधिप।\nपूर्वेण तु महामेरोर्दण्डेन मृदितस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2071545, "chapter_id": 2509, "verse_number": "१२-१४-६५", "content_sanskrit": "उत्तरेण महामेरोः शाकद्वीपेन संमितः।\nभद्राश्वः पुरुषव्याघ्र दण्डेन मृदितस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2071546, "chapter_id": 2509, "verse_number": "१२-१४-६६", "content_sanskrit": "द्वीपाश्च सान्तरद्वीपा नानाजनपदाश्रयाः।\nविगाह्य सागरं वीर दण्डेन मृदितास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2071547, "chapter_id": 2509, "verse_number": "१२-१४-६७", "content_sanskrit": "एतान्यप्रतिमेयानि कृत्वा कर्माणि भारत।\nन प्रीयसे महाराज पूज्यमानो द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2071548, "chapter_id": 2509, "verse_number": "१२-१४-६८", "content_sanskrit": "स त्वं भ्रातॄनिमान्दृष्ट्वा प्रतिनन्दस्व भारत।\nऋषभानिव संमत्तान्गजेन्द्रान्गर्जितानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2071549, "chapter_id": 2509, "verse_number": "१२-१४-६९", "content_sanskrit": "अमरप्रतिमाः सर्वे शत्रुसाहाः परंतपाः।\nएकैकोऽपि सुखायैषां मम स्यादिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2071550, "chapter_id": 2509, "verse_number": "१२-१४-७०", "content_sanskrit": "किं पुनः पुरुषव्याघ्राः पतयो मे नरर्षभाः।\nसमस्तानीन्द्रियाणीव शरीरस्य विचेष्टने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2071551, "chapter_id": 2509, "verse_number": "१२-१४-७१", "content_sanskrit": "अनृतं नाब्रवीच्छ्वश्रूः सर्वज्ञा सर्वदर्शिनी।\nयुधिष्ठिरस्त्वां पाञ्चालि सुखे धास्यत्यनुत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2071552, "chapter_id": 2509, "verse_number": "१२-१४-७२", "content_sanskrit": "इत्वा राजसहस्राणि बहून्याशुपराक्रमः।\nतद्व्यर्थं संप्रपश्यामि मोहात्तव जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2071553, "chapter_id": 2509, "verse_number": "१२-१४-७३", "content_sanskrit": "येषामुन्मत्तको ज्येष्ठः सर्वे तेऽप्यनुसारिणः।\nतवोन्मादान्महाराजसोन्मादाः सर्वपाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2071554, "chapter_id": 2509, "verse_number": "१२-१४-७४", "content_sanskrit": "यदि हि स्युरनुन्मत्ता भ्रातरस्ते नराधिप।\nबद्ध्वा त्वां नास्तिकैः सार्धं प्रशासेयुर्वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2071555, "chapter_id": 2509, "verse_number": "१२-१४-७५", "content_sanskrit": "कुरुते मूढ एवं हि यः श्रेयो नाधिगच्छति।\nधूपैरञ्जनयोगैश्च नस्यकर्मभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2071556, "chapter_id": 2509, "verse_number": "१२-१४-७६", "content_sanskrit": "`उन्मत्तिरपनेतव्या तव राजन्यदृच्छया।\nभेषजैः स चिकित्स्यः स्याद्य उन्मार्गेण गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2071557, "chapter_id": 2509, "verse_number": "१२-१४-७७", "content_sanskrit": "साहं सर्वाधमा लोके स्त्रीणां भरतसत्तम।\nतथा विनिकृता पुत्रैर्याऽहमिच्छामि जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2071558, "chapter_id": 2509, "verse_number": "१२-१४-७८", "content_sanskrit": "धृतराष्ट्रसुता राजन्नित्यमुत्पथगामिनः।\nतादृशानां वधे दोषं नाहं पश्यामि कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2071559, "chapter_id": 2509, "verse_number": "१२-१४-७९", "content_sanskrit": "इमांश्चोशनसा गीताञ्श्लोकाञ्श्रृणु नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2071560, "chapter_id": 2509, "verse_number": "१२-१४-८०", "content_sanskrit": "आत्महन्ताऽर्थहन्ता च बन्धुहन्ता विषप्रदः।\nअकारणेन हन्ता च यश्च भार्यां परामृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2071561, "chapter_id": 2509, "verse_number": "१२-१४-८१", "content_sanskrit": "निर्दोषं वधमेतेषां षण्णामप्याततायिनाम्।\nब्रह्मा प्रोवाच भगवान्भार्गवाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2071562, "chapter_id": 2509, "verse_number": "१२-१४-८२", "content_sanskrit": "ब्रह्मक्षत्रविशां राजन्सत्पथे वर्तिनामपि।\nप्रसह्यागारमागम्य हन्तारं गरदं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2071563, "chapter_id": 2509, "verse_number": "१२-१४-८३", "content_sanskrit": "अभक्ष्यापेयदातारमग्निदं च निशातयेत्।\nमार्ग एष महीपानां गोब्राह्मणवधेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2071564, "chapter_id": 2509, "verse_number": "१२-१४-८४", "content_sanskrit": "केशग्रहे च नारीणामपि युध्येत्पितामहम्।\nब्रह्माणं देवदेवेशं किं पुनः पापकारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2071565, "chapter_id": 2509, "verse_number": "१२-१४-८५", "content_sanskrit": "गोब्राह्मणार्थे व्यसने च राज्ञां राष्ट्रोपमर्दे स्वशरीरहेतोः।\nस्त्रीणां च विक्रुष्टरुतानि श्रुत्वा विप्रोऽपि युध्येत महाप्रभावः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2071566, "chapter_id": 2509, "verse_number": "१२-१४-८६", "content_sanskrit": "धर्माद्विचलितं विप्रं निहन्यादाततायिनम्।\nतस्यान्यत्र वधं विद्वान्मनसाऽपि न चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2071567, "chapter_id": 2509, "verse_number": "१२-१४-८७", "content_sanskrit": "गोब्राह्मणवधे वृत्तं मन्त्रत्राणार्थमेव च।\nनिहन्यात्क्षत्रियो विप्रं स्वकुटुम्बस्य चाप्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2071568, "chapter_id": 2509, "verse_number": "१२-१४-८८", "content_sanskrit": "तस्करेण नृशंसेन धर्मात्प्रचलितेन च।\nक्षत्रबन्धुः परं शक्त्या युध्येद्विप्रेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2071569, "chapter_id": 2509, "verse_number": "१२-१४-८९", "content_sanskrit": "आततायिनमायान्तमपि वेदान्तपारगम्।\nजिघांसन्तं जिघांसीयान्न तेन भ्रूणहा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2071570, "chapter_id": 2509, "verse_number": "१२-१४-९०", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यः शूद्रो वाऽप्यन्त्यजोपि वा।\nन हन्याद्ब्राह्मणं शान्तं तृणेनापि कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2071571, "chapter_id": 2509, "verse_number": "१२-१४-९१", "content_sanskrit": "ब्राह्मणायावगुर्याद्यः स्पृष्ट्वा गुरुतरं महत्।\nवर्षाणां त्रिशतं पापः प्रतिष्ठां नाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2071572, "chapter_id": 2509, "verse_number": "१२-१४-९२", "content_sanskrit": "सहस्राणि च वर्षाणि निहत्य नरके पतेत्।\nतस्मान्नैवावगुर्याद्धि नैव शस्त्रं निपातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2071573, "chapter_id": 2509, "verse_number": "१२-१४-९३", "content_sanskrit": "शोणितं यावतः पांसून्गृह्णातीति हि धारणा।\nतावतीः स समाः पापो नरके परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2071574, "chapter_id": 2509, "verse_number": "१२-१४-९४", "content_sanskrit": "त्वगस्थिभेदं विप्रस्य यः कुर्यात्कारयेत वा।\nब्रह्महा स तु विज्ञेयः प्रायश्चित्ती नराधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2071575, "chapter_id": 2509, "verse_number": "१२-१४-९५", "content_sanskrit": "श्रोत्रियं ब्राह्मणं हत्वा तथाऽऽत्रेयीं च ब्राह्मणीम्।\nचतुर्विशतिवर्षाणि चरेद्ब्रह्महणो व्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2071576, "chapter_id": 2509, "verse_number": "१२-१४-९६", "content_sanskrit": "द्विगुणां ब्रह्महत्येयं सर्वैः प्रोक्ता महर्षिभिः।\nप्रायश्चित्तमकुर्वाणं कृताङ्कं विप्रवासयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2071577, "chapter_id": 2509, "verse_number": "१२-१४-९७", "content_sanskrit": "ब्राह्मणं क्षत्रियं वैश्यं शूद्रं वा घातयेन्नृपः।\nब्रह्मघ्नं तस्करं चैव माभूदेवं चरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2071578, "chapter_id": 2509, "verse_number": "१२-१४-९८", "content_sanskrit": "छित्त्वा हस्तौ च पादौ च नासिकोष्ठौ च भूपतिः।\nब्रह्मघ्नं चोत्तमं पापं नेत्रोद्धारेण योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2071579, "chapter_id": 2509, "verse_number": "१२-१४-९९", "content_sanskrit": "शूद्रस्यैव स्मृतो दण्डस्तद्वद्राजन्यवैश्ययोः।\nप्रायश्चित्तमकुर्वाणं ब्राह्मणं तु प्रवासयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2071580, "chapter_id": 2509, "verse_number": "१२-१४-१००", "content_sanskrit": "क्षत्रियं वैश्यशूद्रौ च शस्त्रेणैव च घातयेत्।\nब्रह्मघ्नान्ब्राह्मणात्राजा कृताङ्कान्विप्रवासयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2071581, "chapter_id": 2509, "verse_number": "१२-१४-१०१", "content_sanskrit": "विकलेन्द्रियांस्त्रिवर्णांश्च चण्डालैः सह वासयेत्।\nतैश्च यः संपिबेत्कश्चित्स पिबन्ब्रह्महा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2071582, "chapter_id": 2509, "verse_number": "१२-१४-१०२", "content_sanskrit": "प्रेतानां न च देयानि पिण्डदानानि केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2071583, "chapter_id": 2509, "verse_number": "१२-१४-१०३", "content_sanskrit": "कृष्णवर्णा विरूपा च निर्णीता लम्बमूर्धजा।\nदुनोत्यदृष्ट्वा कर्तारं ब्रह्महत्येति तां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2071584, "chapter_id": 2509, "verse_number": "१२-१४-१०४", "content_sanskrit": "ब्रह्मघ्नेन पिबन्तश्च विप्रा देशाः पुराणि च।\nअचिरादेव पीड्यन्ते दुर्भिक्षव्याधितस्करैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2071585, "chapter_id": 2509, "verse_number": "१२-१४-१०५", "content_sanskrit": "ब्राह्मणं पापकर्माणं विप्राणामाततायिनम्।\nक्षत्रियं वैश्यशूद्रौ च नेत्रोद्धारेण योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2071586, "chapter_id": 2509, "verse_number": "१२-१४-१०६", "content_sanskrit": "दुर्बलानां बलं राजा बलिनो ये च साधवः।\nबलिनां दुर्बलानां च पापानां मृत्त्युरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2071587, "chapter_id": 2509, "verse_number": "१२-१४-१०७", "content_sanskrit": "सदोषमपि यो हन्यादश्राव्य जगतीपते।\nदुर्बलं बलवन्तं वा स पराजयमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2071588, "chapter_id": 2509, "verse_number": "१२-१४-१०८", "content_sanskrit": "राजाज्ञां प्राड्विवाकं च नेच्छेद्यच्चापि निष्पतेत्।\nसाक्षिणं साधुवाक्यं च जितं तमपि निर्दिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2071589, "chapter_id": 2509, "verse_number": "१२-१४-१०९", "content_sanskrit": "बन्धनान्निष्पतेद्यच्च प्रतिभूर्न ददाति च।\nकुलजश्च धनाढ्यश्च स पराजयमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2071590, "chapter_id": 2509, "verse_number": "१२-१४-११०", "content_sanskrit": "राजाज्ञया समाहूतो यो न गच्छेत्सभां नरः।\nबलवन्तमुपाश्रित्य सायुधः स पराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2071591, "chapter_id": 2509, "verse_number": "१२-१४-१११", "content_sanskrit": "तं दण्डेन विनिर्जित्य महासाहसिकं नरम्।\nवियुक्तदेहसर्वस्वं परलोकं विसर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2071592, "chapter_id": 2509, "verse_number": "१२-१४-११२", "content_sanskrit": "मृतस्यापि न देयानि पिण्डदानानि केनचित्।\nदत्त्वा दण्डं प्रयच्छेत मध्यमं पूर्वसाहयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2071593, "chapter_id": 2509, "verse_number": "१२-१४-११३", "content_sanskrit": "कुलस्त्रीव्यभिचारं च राष्ट्रस्य च विमर्दनम्।\nब्रह्महत्यां च चौर्यं च राजद्रोहं च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2071594, "chapter_id": 2509, "verse_number": "१२-१४-११४", "content_sanskrit": "युद्धादन्यत्र हिंसायां सुरापस्य च कीर्तने।\nमहान्तं गुरुतल्पे च मित्रद्रोहे च पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2071595, "chapter_id": 2509, "verse_number": "१२-१४-११५", "content_sanskrit": "न कथंचिदुपेक्षेत महासाहसिकं नरम्।\nसर्वस्वमपहृत्याशु ततः प्राणैर्वियोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2071596, "chapter_id": 2509, "verse_number": "१२-१४-११६", "content_sanskrit": "त्रिषु वर्णेषु यो दण्डः प्रणीतो ब्रह्मणा पुरा।\nमहासाहसिकं विप्रं कृताङ्कं विप्रवासयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2071597, "chapter_id": 2509, "verse_number": "१२-१४-११७", "content_sanskrit": "साहस्रो वा भवेद्दण्डः काञ्चनो देहनिष्क्रिया।\nचतुर्णामपि वर्णानामेवमाहोशना कविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2071598, "chapter_id": 2509, "verse_number": "१२-१४-११८", "content_sanskrit": "नारीणां बालवृद्धानां गोपतेश्च महामतिः।\nपापानां दुर्विनीतानां प्राणान्तं च बृहस्पतिः।\nदण्डमाह महाभाग सर्वेषामाततायिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2071599, "chapter_id": 2509, "verse_number": "१२-१४-११९", "content_sanskrit": "सर्वेषां पापबुद्धीनां पापकर्मैव क्वुर्वताम्।\nधृतराष्ट्रस्य पुत्राणां दण्डो निर्दोष इष्यते।\nसौबलस्य च दुर्बुद्धेः कर्णस्य च दुरात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2071600, "chapter_id": 2509, "verse_number": "१२-१४-१२०", "content_sanskrit": "पश्यतां चैव शूराणां याऽहं द्यूते सभां तदा।\nरजस्वला समानीता भवतां पश्यतां नृप।\nवाससैकेन संवीता तव दोषेण भूपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2071601, "chapter_id": 2509, "verse_number": "१२-१४-१२१", "content_sanskrit": "माभूद्धर्मविलोपस्ते धृतराष्ट्रकुलक्षयात्।\nक्रोधाग्निना तु दग्धं च सपशुद्रव्यसंचयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2071602, "chapter_id": 2509, "verse_number": "१२-१४-१२२", "content_sanskrit": "साऽहमेवंविधं दुःखं संप्राप्ता तव हेतुना।\nआदित्यस्य प्रसादेन न च प्राणैर्वियोजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2071603, "chapter_id": 2509, "verse_number": "१२-१४-१२३", "content_sanskrit": "रक्षिता देवदेवेन जगतः कालहेतुना।\nदिवाकरेण देवेन विवस्त्रा न कृता तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2071604, "chapter_id": 2509, "verse_number": "१२-१४-१२४", "content_sanskrit": "एतेषां यतमानानां न मेऽद्य वचनं मृषा।\nत्वं तु सर्वां महीं त्यक्त्वा कुरुषे स्वयमापदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2071605, "chapter_id": 2509, "verse_number": "१२-१४-१२५", "content_sanskrit": "यथाऽऽस्तां संमतौ राज्ञां पृथिव्यां राजसत्तम्।\nमांधाता चाम्बरीषश्च तथा राजन्विराजसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2071606, "chapter_id": 2509, "verse_number": "१२-१४-१२६", "content_sanskrit": "प्रशाधि पृथिवीं देवीं प्रजा धर्मेण पालयन्।\nसपर्वतवनद्वीपां मा राजन्विमना भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2071607, "chapter_id": 2509, "verse_number": "१२-१४-१२७", "content_sanskrit": "यजस्व विविधैर्यज्ञैर्युध्यस्वारीन्प्रयच्छ च।\nधनानि भोगान्वासांसि द्विजातिभ्यो नृपोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2071608, "chapter_id": 2509, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुर्दशोऽध्यायः॥ १४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}]