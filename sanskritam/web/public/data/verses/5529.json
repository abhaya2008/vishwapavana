[{"id": 2212558, "chapter_id": 5529, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212559, "chapter_id": 5529, "verse_number": "१", "content_sanskrit": "विदितं भवतामेतद् यथा वृत्तं कुरुक्षयम् ।\nममापराधात् तत् सर्वमिति ज्ञेयं तु कौरवाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212560, "chapter_id": 5529, "verse_number": "२", "content_sanskrit": "योऽहं दुष्टमतिं मूर्खं ज्ञातीनां भयवर्धनम् ।\nदुर्योधनं कौरवाणामाधिपत्येऽभ्यषेचयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212561, "chapter_id": 5529, "verse_number": "३", "content_sanskrit": "यच्चाहं वासुदेवस्य वाक्यं नाश्रौषमर्थवत् ।\nबध्यतां साध्वयं पापः सामात्य इति दुर्मतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212562, "chapter_id": 5529, "verse_number": "४", "content_sanskrit": "पुत्रस्नेहाभिभूतश्च हितमुक्तो हितैषिणा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212563, "chapter_id": 5529, "verse_number": "५", "content_sanskrit": "विदुरेणाथ भीष्मेण द्रोणेन च कृपेण च ।\nपदे पदे भगवता व्यासेन च महात्मना\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212564, "chapter_id": 5529, "verse_number": "६", "content_sanskrit": "सञ्जयेनाथ गान्धार्या तदिदं तप्यते मया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212565, "chapter_id": 5529, "verse_number": "७", "content_sanskrit": "यच्चाहं पाण्डुपुत्रेषु गुणवत्सु महात्मसु ।\nन न्यस्तवान् श्रियं दीप्तां पितृपैतामहीमिमाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212566, "chapter_id": 5529, "verse_number": "८", "content_sanskrit": "पश्यन्नपि विनाशं हि सर्वराज्ञां गदाग्रजः ।\nएतच्छ्रेयः स परमम् अमन्यत जनार्दनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212567, "chapter_id": 5529, "verse_number": "९", "content_sanskrit": "सोऽहमेतान्यतीतानि दुर्वृत्तान्यात्मनः सदा ।\nहृदये शल्यभूतानि धारयामि सहस्रशः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212568, "chapter_id": 5529, "verse_number": "१०", "content_sanskrit": "विशेषतस्तु दह्यामि वर्षे पञ्चदशे हि वै ।\nअस्य पापस्य शुद्ध्यर्थे नियतोऽस्मि सुदुर्मतिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212569, "chapter_id": 5529, "verse_number": "११", "content_sanskrit": "चतुर्थे नियते काले कदाचिदपि चाष्टमे ।\nतृष्णाविनयनं भुञ्जे गान्धारी वेद तन्मम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212570, "chapter_id": 5529, "verse_number": "१२", "content_sanskrit": "करोत्याहारमिति च सर्वः परिजनः सदा ।\nयुधिष्ठिरभयाद्वेत्ति भृशं तप्येत पाण्डवः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212571, "chapter_id": 5529, "verse_number": "१३", "content_sanskrit": "भूमौ शये जप्यपरो दर्भेष्वजिनसंवृतः ।\nनियमव्यपदेशेन गान्धारी च यशस्विनी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212572, "chapter_id": 5529, "verse_number": "१४", "content_sanskrit": "हतं पुत्रशतं वीरं सङ्ग्रामेष्वपलायिनम् ।\nनानुतप्ये ह्यहं तच्च क्षत्रधर्मं हि तं विदुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212573, "chapter_id": 5529, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212574, "chapter_id": 5529, "verse_number": "१५", "content_sanskrit": "इत्युक्त्वा धर्मराजं सोऽथाभ्यभाषत वीर्यवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212575, "chapter_id": 5529, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212576, "chapter_id": 5529, "verse_number": "१६", "content_sanskrit": "भद्रं ते यादवीमातः वाक्यं चेदं निबोध मे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212577, "chapter_id": 5529, "verse_number": "१७", "content_sanskrit": "सुखमस्म्युषितः पुत्र त्वया सुपरिपालितः ।\nमया दानानि दत्तानि श्राद्धानि च पुनः पुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212578, "chapter_id": 5529, "verse_number": "१८", "content_sanskrit": "प्रकृष्टं मे वयः पुत्र पुण्यं प्राप्तं यथाबलम् ।\nगान्धारी हतपुत्रेयं धैर्येणावेक्षते च माम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212579, "chapter_id": 5529, "verse_number": "१९", "content_sanskrit": "द्रौपद्यशुभकर्तारस्तव चैश्वर्यहारिणः ।\nसमतीता नृशंसास्ते धर्मेण निहता युधि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212580, "chapter_id": 5529, "verse_number": "२०", "content_sanskrit": "न तेषु प्रतिकर्तव्यं पश्यामि कुरुनन्दन ।\nसर्वे शस्त्रजितान् लोकान् गता ह्यभिमुखा हताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212581, "chapter_id": 5529, "verse_number": "२१", "content_sanskrit": "आत्मनस्तु सतां मुख्य प्रतिकर्तव्यमद्य मे ।\nगान्धार्याश्चैव राजेन्द्र तदनुज्ञातुमर्हसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212582, "chapter_id": 5529, "verse_number": "२२", "content_sanskrit": "त्वं हि धर्मभृतां श्रेष्ठः सततं धर्मवत्सलः ।\nराजा गुरुः प्राणभृतां तस्मादेतद् ब्रवीम्यहम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212583, "chapter_id": 5529, "verse_number": "२३", "content_sanskrit": "अनुज्ञातस्त्वया वीर संश्रयेयं वनान्यहम् ।\nचीरवल्कलभृद् राजन् गान्धार्या सहितोऽनघ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212584, "chapter_id": 5529, "verse_number": "२४", "content_sanskrit": "तवाशिषः प्रयुञ्जानो भविष्यामि वनेचरः ।\nउचितं नः कुले तात सर्वेषां भरतर्षभ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212585, "chapter_id": 5529, "verse_number": "२५", "content_sanskrit": "पुत्रेष्वैश्वर्यमाधाय वयसोऽन्ते वनं नृप\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212586, "chapter_id": 5529, "verse_number": "२६", "content_sanskrit": "तत्राहं वायुभक्षो वा निराहारोऽपि वा वसन् ।\nपत्न्या सहानया वीर संश्रयेयं वनान्यहम् ।\nपत्न्या सहानया वीर चरिष्यामि तपः परम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212587, "chapter_id": 5529, "verse_number": "२७", "content_sanskrit": "त्वं चापि फलभुक् तात तपसा पार्थिवो ह्यसि ।\nफलभाजो हि राजानः कल्याणस्येतरस्य वा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212588, "chapter_id": 5529, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि वनवासप्रार्थनं नाम पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212589, "chapter_id": 5529, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]