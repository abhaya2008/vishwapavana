[{"id": 7003704000, "chapter_id": 23704, "verse_number": "१-४-१२-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nततस्तेजोमयं स्तंभमनुसृत्य पितामहः ।\nउत्पपातोन्मुखो वेगान्निरालंबे नभस्तले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003704001, "chapter_id": 23704, "verse_number": "१-४-१२-२", "content_sanskrit": "द्रुतमुत्पततस्तस्य पक्षावेगेन वारिताः ।\nव्यशीर्यत समुद्वर्ताः प्रणुन्ना इव वायुभिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003704002, "chapter_id": 23704, "verse_number": "१-४-१२-३", "content_sanskrit": "स वेगादुत्पतन्दूरं नाक्ष्णोर्विषयतामगात् ।\nकेवलं दीर्घदीर्घैव रेखा व्योम्नि व्यभाव्यत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003704003, "chapter_id": 23704, "verse_number": "१-४-१२-४", "content_sanskrit": "मायामरालो ददृशे तेजःस्तंभस्यपार्श्वतः ।\nसंध्यापयोधराभ्यर्णचारीव रजनीकरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003704004, "chapter_id": 23704, "verse_number": "१-४-१२-५", "content_sanskrit": "प्रागत्यगादुत्पततां ततोऽध्वानं पयोमुचाम् ।\nविमानपदवीं पश्चात्तारावर्तं ततः परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003704005, "chapter_id": 23704, "verse_number": "१-४-१२-६", "content_sanskrit": "तेजसां यानि धामानि ह्यत्युच्चान्यूर्ध्वचारिणाम् ।\nअतिचक्राम वेगेन तान्यसौ कुहनाखगः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003704006, "chapter_id": 23704, "verse_number": "१-४-१२-७", "content_sanskrit": "मरुतो मनसो वापि जवः सूक्ष्मतराकृतेः ।\nसोऽभूदधःकृतस्तेन हंसेन गमनादिना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003704007, "chapter_id": 23704, "verse_number": "१-४-१२-८", "content_sanskrit": "यथायथा चोत्पपात सुदूरं श्रमितच्छदः ।\nतथातथा च ददृशे तेजःस्तंभः समुन्नतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003704008, "chapter_id": 23704, "verse_number": "१-४-१२-९", "content_sanskrit": "अतीत्य मरुतां स्कंधान्सप्त संप्राप्तविस्मयः ।\nबिभेदांडकटाहं च ज्वलंतं तमुदैक्षत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003704009, "chapter_id": 23704, "verse_number": "१-४-१२-१०", "content_sanskrit": "कथं वाऽदृष्टमूलस्य स्थातव्यं पुरतो हरेः ।\nअविमोचयतः शौरेरसमासमशीर्षताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003704010, "chapter_id": 23704, "verse_number": "१-४-१२-११", "content_sanskrit": "अनिर्व्यूढप्रतिज्ञस्य दीर्घैः किं वा ममासुभिः ।\nतदत्रौपयिकं किं स्यात्कार्यं का मा गतिर्मम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003704011, "chapter_id": 23704, "verse_number": "१-४-१२-१२", "content_sanskrit": "अतिसंधित्सतो विष्णुं कस्सहायो भविष्यति ।\nआर्जवं नैव निर्जेतुं प्रतिवादिनमक्षमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003704012, "chapter_id": 23704, "verse_number": "१-४-१२-१३", "content_sanskrit": "छद्मना वा तिरस्कुर्यान्माना हि महतां धनम् ।\nइति संचितयत्येव विरिंचौ व्याकुलात्मनि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003704013, "chapter_id": 23704, "verse_number": "१-४-१२-१४", "content_sanskrit": "आकाशे ददृशे नातिदूरे किमपि निर्मलम् ।\nऐंदवी किमियं रेखा तस्याः कथमिहागमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003704014, "chapter_id": 23704, "verse_number": "१-४-१२-१५", "content_sanskrit": "यद्वा मृणालं तत्सिंधौ वियत्यस्यां कुतस्तु सः ।\nइति तस्मिन्ससंदेहे नेदीयस्तं तदागतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003704015, "chapter_id": 23704, "verse_number": "१-४-१२-१६", "content_sanskrit": "अबोधि केतकीबर्हमिति राजीवजन्मना ।\nतत्पर्युषितमप्युद्यत्सौरभं वस्तुशक्तितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003704016, "chapter_id": 23704, "verse_number": "१-४-१२-१७", "content_sanskrit": "हिरण्यगर्भो विमलमगृह्णात्केतकच्छदम् ।\nगृहीतमात्रं तेनैतत्सचैतन्यं किलाब्रवीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003704017, "chapter_id": 23704, "verse_number": "१-४-१२-१८", "content_sanskrit": "केतक उवाच ।\nभो गृह्णासि किमर्थं त्वं मुंच मां विश्रमोद्यतम् ।\nवर्षाणां शतसाहस्रमुत्पत्यैवं विहायसा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003704018, "chapter_id": 23704, "verse_number": "१-४-१२-१९", "content_sanskrit": "नंदीश उवाच ।\nतथा समेधमानं तं दृष्ट्वा श्रममखिद्यत ।\nअचिंतयत्पद्मसूतिरत्यंतं विहताशयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003704019, "chapter_id": 23704, "verse_number": "१-४-१२-२०", "content_sanskrit": "अनिर्व्यूढप्रतिज्ञावान्नीचतामपि संश्रितः ।\nआक्रांतरोदोविवरः क्व राशिस्तेजसामसौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003704020, "chapter_id": 23704, "verse_number": "१-४-१२-२१", "content_sanskrit": "अहमेतत्परीक्षायां क्व परिच्छिन्न पौरुषः ।\nभज्येते इव मे पक्षौ दृशा चांधायते इव ।\nप्रध्वंसंत इवांगानि पतामीवाहमप्यधः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003704021, "chapter_id": 23704, "verse_number": "१-४-१२-२२", "content_sanskrit": "किं वान्यद्बहुनोक्तेन सह निश्वासवायुभिः ।\nमम प्राणाश्च नियतं निर्गच्छंतीव सांप्रतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003704022, "chapter_id": 23704, "verse_number": "१-४-१२-२३", "content_sanskrit": "अहंकारमदग्रंथिरयं त्रुटतु चित्ततः ।\nमुकुंदेन सह स्पर्धा सा च शीघ्ं प्रणश्यतु ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003704023, "chapter_id": 23704, "verse_number": "१-४-१२-२४", "content_sanskrit": "यदेष रोदःकुहरपरिणाहाधिकोद्यमः ।\nऔन्नत्यमयतेऽद्यापि तेजस्तंभो यथा पुरा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003704024, "chapter_id": 23704, "verse_number": "१-४-१२-२५", "content_sanskrit": "तदस्य तेजसां राशेर्नाहं नारायणोऽथवा ।\nकारणं दूरतश्चान्ये महेंद्रप्रमुखाः सुराः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003704025, "chapter_id": 23704, "verse_number": "१-४-१२-२६", "content_sanskrit": "इतो नोत्पतितुं शक्तिरस्ति मे तन्निवर्त्तये ।\nइति निश्चित्य मनसा विधाता जातविस्मयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003704026, "chapter_id": 23704, "verse_number": "१-४-१२-२७", "content_sanskrit": "प्रत्यभाषत तं कस्त्वं कुतो वा प्राप्तवानिति ।\nस च प्रत्यब्रवीदेनं वेधसं केतकच्छदः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003704027, "chapter_id": 23704, "verse_number": "१-४-१२-२८", "content_sanskrit": "केतकच्छद एवासं सचैतन्यः शिवाज्ञया ।\nतेजस्तंभात्मनः शंभोरस्य मूर्ध्नि चिरं स्थितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003704028, "chapter_id": 23704, "verse_number": "१-४-१२-२९", "content_sanskrit": "भूलोक इच्छया वस्तुं ततः संप्राप्तवानहम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003704029, "chapter_id": 23704, "verse_number": "१-४-१२-३०", "content_sanskrit": "इत्थं श्रुत्वा केतकीबर्हवाचं लब्ध्वाश्वासं तं किलांभोजभूतिः ।\nब्रूहि त्वं मे तत्कियत्यंतरे वा तेजःस्तंभस्याग्रमित्यावभाषे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003704030, "chapter_id": 23704, "verse_number": "१-४-१२-३१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे ब्रह्मणा लिंगोपरिभागशोधनवर्णनंनाम द्वादशोऽध्यायः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]