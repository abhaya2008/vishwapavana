[{"id": 2065845, "chapter_id": 2392, "verse_number": "९-१०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065846, "chapter_id": 2392, "verse_number": "९-१०-१", "content_sanskrit": "तस्मिन्विलुलिते सैन्ये वध्यमाने परस्परम्।\nद्रवमाणेषु योधेषु विद्रवत्सु च दन्तिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065847, "chapter_id": 2392, "verse_number": "९-१०-२", "content_sanskrit": "कूजतां स्तनतां चैव पदातीनां महाहवे।\nनिहतेषु महाराज हयेषु बहुधा तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065848, "chapter_id": 2392, "verse_number": "९-१०-३", "content_sanskrit": "प्रक्षये दारुणे घोरे संहारे सर्वदेहिनाम्।\nनानाशस्त्रसमावापे व्यतिषक्तरथद्विपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065849, "chapter_id": 2392, "verse_number": "९-१०-४", "content_sanskrit": "हर्षणे युद्धशौण्डानां भीरूणां भयवर्धने।\nगाहमानेषु योधेषु परस्परवधैषिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065850, "chapter_id": 2392, "verse_number": "९-१०-५", "content_sanskrit": "प्राणादाने महाघोरे वर्तमाने दुरोदरे।\nसङ्ग्रामे घोररूपे तु यमराष्ट्रविवर्धने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065851, "chapter_id": 2392, "verse_number": "९-१०-६", "content_sanskrit": "पाण्डवास्तावकं सैन्यं व्यधमन्निशितैः शरैः।\nतथैव तावका योधा जघ्नुः पाण्डवसैनिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065852, "chapter_id": 2392, "verse_number": "९-१०-७", "content_sanskrit": "तस्मिंस्तथा वर्तमाने युद्धे भीरुभयावहे।\nपूर्वाह्णे चापि सम्प्राप्ते भास्करोदयनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065853, "chapter_id": 2392, "verse_number": "९-१०-८", "content_sanskrit": "लब्धलक्षाः परे राजन्रक्षितास्तु महात्मना।\nअयोधयंस्तव बलं मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065854, "chapter_id": 2392, "verse_number": "९-१०-९", "content_sanskrit": "बलिभिः पाण्डवैर्दृप्तैर्लैब्धलक्षैः प्रहारिभिः।\nकौरव्यसीदत्पृतना मृगीवाग्निबयाकुला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065855, "chapter_id": 2392, "verse_number": "९-१०-१०", "content_sanskrit": "तां दृष्ट्वा सीदतीं सेनां पङ्के गामिव दुर्बलाम्।\nउज्जिहीर्षुस्तदा शल्यः प्रायात्पाण्डुसुतान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065856, "chapter_id": 2392, "verse_number": "९-१०-११", "content_sanskrit": "मद्रराजः सुसङ्क्रुद्धो गृहीत्वा धनुरुत्तमम्।\nअभ्यद्रवत सङ्ग्रामे पाण्डवानाततायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065857, "chapter_id": 2392, "verse_number": "९-१०-१२", "content_sanskrit": "पाण्डवा अपि भूपाल समरे जितकाशिनः।\nमद्रराजं समासाद्य बिभिदुर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065858, "chapter_id": 2392, "verse_number": "९-१०-१३", "content_sanskrit": "ततः शरशतैस्तीक्ष्णैर्मद्रराजो महारथः।\nअर्दयामास तां सेनां धर्मराजस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065859, "chapter_id": 2392, "verse_number": "९-१०-१४", "content_sanskrit": "प्रादुरासन्निमित्तानि नानारूपाण्यनेकशः।\nचचाल शब्दं कुर्वाणा मही चापि सपर्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065860, "chapter_id": 2392, "verse_number": "९-१०-१५", "content_sanskrit": "[सदण्डशूला दीप्ताग्रा दीर्यमाणाः समन्ततः।]\nउल्का भूमिं दिवः पेतुराहत्य रविमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065861, "chapter_id": 2392, "verse_number": "९-१०-१६", "content_sanskrit": "मृगाश्च महिषाश्चापि पक्षिणश्च विशाम्पते।\nअपसव्यं तदा चक्रुः सेनां ते बहुशो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065862, "chapter_id": 2392, "verse_number": "९-१०-१७", "content_sanskrit": "[भृगुसूनुधरापुत्रौ शशिजेन समन्वितौ।\nचरमं पाण्डुपुत्राणां पुरस्तात्सर्वभूभुजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065863, "chapter_id": 2392, "verse_number": "९-१०-१८", "content_sanskrit": "शस्त्राग्रेष्वभवज्ज्वाला नेत्राण्याहत्य वर्षती।\nशिरः स्वलीयन्त भृशं काकोलूकाश्च केतुषु]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065864, "chapter_id": 2392, "verse_number": "९-१०-१९", "content_sanskrit": "ततस्तद्युद्धमत्युग्रमभवत्सहचारिणाम्।\nतथा सर्वाण्यनीकानि सन्निपत्य जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065865, "chapter_id": 2392, "verse_number": "९-१०-२०", "content_sanskrit": "अभ्यघ्नत्कौरवो राजा पाण्डवानामनीकिनीम्।\nशल्यस्तु शरवर्षेण वर्षन्निव सहस्रदृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065866, "chapter_id": 2392, "verse_number": "९-१०-२१", "content_sanskrit": "अभ्यवर्षत धर्मात्मा कुन्तीपुत्रं युधिष्ठिरम्।\nभीमसेनं शरैश्चापि रुक्मपुङ्खैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065867, "chapter_id": 2392, "verse_number": "९-१०-२२", "content_sanskrit": "द्रौपदेयांस्तथा सर्वान्माद्रीपुत्रौ च पाण्डवौ।\nधृष्टद्युम्नं च शैनेयं शिखण्डिनमथापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065868, "chapter_id": 2392, "verse_number": "९-१०-२३", "content_sanskrit": "एकैकं दशभिर्बाणैर्विव्याध स महाबलः।\nततोऽसृजद्बाणवर्षं घर्मान्ते मघवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065869, "chapter_id": 2392, "verse_number": "९-१०-२४", "content_sanskrit": "ततः प्रभद्रका राजन्सोमकाश्च सहस्रशः।\nपतिताः पात्यमानाश्च दृश्यन्ते शल्यसायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065870, "chapter_id": 2392, "verse_number": "९-१०-२५", "content_sanskrit": "भ्रमराणामिव व्राताः शलभानामिव व्रजाः।\nहादिन्य इव मेघेभ्यः शल्यस्य न्यपतञ्शराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065871, "chapter_id": 2392, "verse_number": "९-१०-२६", "content_sanskrit": "द्विरदास्तुरगाश्चार्ताः पत्तयो रथिनस्तथा।\nशल्यस्य बाणैरपतन्बभ्रमुर्व्यनदंस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065872, "chapter_id": 2392, "verse_number": "९-१०-२७", "content_sanskrit": "आविष्ट इव मद्रेशो मन्युना पौरुषेण च।\nप्राच्छादयदरीन्सङ्ख्ये कालसृष्ट इवान्तकः।\nविनर्दमानो मद्रेशो मेघहादो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065873, "chapter_id": 2392, "verse_number": "९-१०-२८", "content_sanskrit": "सा वध्यमाना शल्येन पाण्डवानामनीकिनी।\nअजातशत्रुं कौन्तेयमभ्यधावद्युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065874, "chapter_id": 2392, "verse_number": "९-१०-२९", "content_sanskrit": "तां सम्मर्द्य शतैः सङ्ख्ये लघुहस्तः शितैः शरैः।\nबाणवर्षेण महता युधिष्ठिरमताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065875, "chapter_id": 2392, "verse_number": "९-१०-३०", "content_sanskrit": "तमापतन्तं जात्यश्वैः क्रुद्धो राजा युधिष्ठिरः।\nअवारयच्छरैस्तीक्ष्णैर्महाद्विपमिवाङ्कुशैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065876, "chapter_id": 2392, "verse_number": "९-१०-३१", "content_sanskrit": "तस्य शल्यः शरं घोरं मुमोचाशीविषोपमम्।\nसोऽभ्यविध्यन्महात्मानं वेगेनाभ्यपतच्च गाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065877, "chapter_id": 2392, "verse_number": "९-१०-३२", "content_sanskrit": "ततो वृकोदरः क्रुद्धः शल्यं विव्याध सप्तभिः।\nपञ्चभिः सहदेवस्तु नकुलो दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065878, "chapter_id": 2392, "verse_number": "९-१०-३३", "content_sanskrit": "द्रौपदेयाश्च शत्रुघ्नं शूरमार्तायनिं शरैः।\nअभ्यवर्षन्महाराज मेघा इव महीधस्म्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065879, "chapter_id": 2392, "verse_number": "९-१०-३४", "content_sanskrit": "ततो दृष्ट्वा वार्यमाणं शल्यं पार्थैः समन्ततः।\nकृतवर्मा कृपश्चैव सङ्क्रुद्धावभ्यधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065880, "chapter_id": 2392, "verse_number": "९-१०-३५", "content_sanskrit": "उलूकश्च महावीर्यः शकुनिंश्चापि सौबलः।\nसमागम्याथ शनकैरश्वत्थामा महाबलः।\nतव पुत्राश्च कार्त्स्न्येन जुगुपुः शल्यमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065881, "chapter_id": 2392, "verse_number": "९-१०-३६", "content_sanskrit": "भीमसेनं त्रिभिर्विद्धा कृतवर्मा शिलीमुखैः।\nबाणवर्षेण महता क्रुद्धरूपमवारयत्।\nधृष्टद्युम्नं ततः क्रुद्धो बाणवर्षैरपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065882, "chapter_id": 2392, "verse_number": "९-१०-३७", "content_sanskrit": "द्रौपदेयांश्च शकुनिर्यमौ च द्रौणिरभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065883, "chapter_id": 2392, "verse_number": "९-१०-३८", "content_sanskrit": "दुर्योधनो युधांश्रेष्ठ आहवे केशवार्जुनौ।\nसमभ्ययादुग्रतेजाः शरैश्चाप्यहनद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065884, "chapter_id": 2392, "verse_number": "९-१०-३९", "content_sanskrit": "एवं द्वन्द्वशतान्यासंस्त्वदीयानां परैः सह।\nघोररूपाणि चित्राणि तत्रतत्र विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065885, "chapter_id": 2392, "verse_number": "९-१०-४०", "content_sanskrit": "ऋक्षवर्णाञ्जघानाश्वान्भोजो भीमस्य संयुगे।\nसोऽवतीर्य रथोपस्थाद्धताश्वात्पाण्डुनन्दनः।\nकालो दण्डमिवोद्यम्य गदापाणिरयुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065886, "chapter_id": 2392, "verse_number": "९-१०-४१", "content_sanskrit": "प्रमुखे सहदेवस्य जघानाश्वान्स मद्रराट्।\nततः शल्यस्य तनयं सहदेवोऽसिनावधीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065887, "chapter_id": 2392, "verse_number": "९-१०-४२", "content_sanskrit": "गौतमः पुनराचार्यो धृष्टद्युम्नमयोधयत्।\nअसम्भ्रान्तमसम्भ्रान्तो यत्नवान्यत्नवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065888, "chapter_id": 2392, "verse_number": "९-१०-४३", "content_sanskrit": "द्रौपदेयांस्तथा वीरानेकैकं दशभिः शरैः।\nअविद्ध्यदाचार्यसुतो नातिक्रुद्धो हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065889, "chapter_id": 2392, "verse_number": "९-१०-४४", "content_sanskrit": "[पुनश्च भीमसेनस्य जघानाश्वांस्तथाऽऽहवे।\nसोऽवतीर्य रथात्तूर्णं हताश्वः पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065890, "chapter_id": 2392, "verse_number": "९-१०-४५", "content_sanskrit": "कालो दण़्डमिवोद्यम्य गदां क्रुद्धो महाबलः।\nपोथयामास तुरगान्रथं च कृतवर्मणः।\nकृतवर्मा त्ववप्लुत्य रथात्तस्मादपाक्रमत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065891, "chapter_id": 2392, "verse_number": "९-१०-४६", "content_sanskrit": "शल्योऽपि राजन्सङ्क्रुद्धो निघ्नन्सोमकपाण्डवान्।\nपुनरेव शितैर्बाणैर्युधिष्ठिरमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065892, "chapter_id": 2392, "verse_number": "९-१०-४७", "content_sanskrit": "तस्य भीमो रणे क्रुद्धः सन्दश्य दशनच्छदम्।\nविनाशायाभिसन्धाय गदामादाय वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065893, "chapter_id": 2392, "verse_number": "९-१०-४८", "content_sanskrit": "यमदण्डप्रतीकाशां कालरात्रिमिवोद्यताम्।\nगजवाजिमनुष्याणां देहान्तकरणीमति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065894, "chapter_id": 2392, "verse_number": "९-१०-४९", "content_sanskrit": "हेमपट्टपरिक्षिप्तामुल्कां प्रज्वलितामिव।\nशैक्यां व्यालीमिवात्युग्रां वज्रकल्पामयोमयीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065895, "chapter_id": 2392, "verse_number": "९-१०-५०", "content_sanskrit": "चन्दनागुरुपङ्काक्तां प्रमदामीप्सितामिव।\nवसामेदोपदिग्धाङ्गीं जिह्वां वैवस्वतीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065896, "chapter_id": 2392, "verse_number": "९-१०-५१", "content_sanskrit": "पटुघण्टाशतरवां वासवीमशनीमिव।\nनिर्मुक्ताशीविषाकारां पृक्तां गजमदैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065897, "chapter_id": 2392, "verse_number": "९-१०-५२", "content_sanskrit": "त्रासनीं सर्वभूतानां स्वसैन्यपरिहर्षिणीम्।\nमनुष्यलोके विख्यातां गिरिशृङ्गविदारणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065898, "chapter_id": 2392, "verse_number": "९-१०-५३", "content_sanskrit": "यया कैलासभवने महेश्वरसखं बली।\nआह्वयामास कौन्तेयः सङ्क्रुद्धमलकाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065899, "chapter_id": 2392, "verse_number": "९-१०-५४", "content_sanskrit": "यया मायामयान्दृप्तान्सुबहून्धनदालये।\nजघान गुह्यकान्क्रुद्धो मन्दारार्थे महाबलः।\nनिवार्यमाणो बहुभिर्द्रौपद्याः प्रियमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065900, "chapter_id": 2392, "verse_number": "९-१०-५५", "content_sanskrit": "तां वज्रमणिरत्नौघकल्माषां वज्रगौरवाम्।\nसमुद्यम्य महाबाहुः शल्यमभ्यपतद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065901, "chapter_id": 2392, "verse_number": "९-१०-५६", "content_sanskrit": "गदया युद्धकुशलस्तया दारुणनादया।\nपोथयामास शल्यस्य चतुरोऽश्वान्महाजवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065902, "chapter_id": 2392, "verse_number": "९-१०-५७", "content_sanskrit": "ततः शल्यो रणे क्रुद्धः पीने वक्षसि तोमरम्।\nनिचखान नदन्वीरोवर्म भित्त्वा च सोभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065903, "chapter_id": 2392, "verse_number": "९-१०-५८", "content_sanskrit": "वृकोदरस्त्वसम्भ्रान्तस्तमेवोद्धृत्य तोमरम्।\nयन्तारं मद्रराजस्य निर्बिभेद तदा हृदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065904, "chapter_id": 2392, "verse_number": "९-१०-५९", "content_sanskrit": "स भिन्नवर्मा रुधिरं वमन्वित्रस्तमानसः।\nपपाताभिमुखो भीमं मद्रराजस्त्वपाक्रमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065905, "chapter_id": 2392, "verse_number": "९-१०-६०", "content_sanskrit": "कृतप्रतिकृतं दृष्ट्वा शल्यो विस्मितमानसः।\nगदामाश्रित्य धर्मात्मा प्रत्यमित्रमवैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2065906, "chapter_id": 2392, "verse_number": "९-१०-६१", "content_sanskrit": "ततः सुमनसः पार्था भीमसेनमपूजयन्।\nते दृष्ट्वा कर्म सङ्ग्रामे घोरमक्लिष्टकर्मणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2065907, "chapter_id": 2392, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे दशमोऽध्यायः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]