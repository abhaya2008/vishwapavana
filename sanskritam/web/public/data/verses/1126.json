[{"id": 2006326, "chapter_id": 1126, "verse_number": "१-१२७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006327, "chapter_id": 1126, "verse_number": "१-१२७-१", "content_sanskrit": "एवमुक्ता महाराज कुन्ती पाण्डुमभाषत।\nकुरूणामृषभं वीरं तदा भूमिपतिं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006328, "chapter_id": 1126, "verse_number": "१-१२७-२x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006329, "chapter_id": 1126, "verse_number": "१-१२७-२", "content_sanskrit": "न मामर्हसि धर्मज्ञ वक्तुमेवं कथंचन।\nधर्मपत्नीमभिरतां त्वयि राजीवलोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006330, "chapter_id": 1126, "verse_number": "१-१२७-३", "content_sanskrit": "त्वमेव तु महाबाहो मय्यपत्यानि भारत।\nवीर वीर्योपपन्नानि धर्मतो जनयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006331, "chapter_id": 1126, "verse_number": "१-१२७-४", "content_sanskrit": "स्वर्गं मनुजशार्दूल गच्छेयं सहिता त्वया।\nअपत्याय च मां गच्छ त्वमेव कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006332, "chapter_id": 1126, "verse_number": "१-१२७-५", "content_sanskrit": "न ह्यहं मनसाप्यन्यं गच्छेयं त्वदृते नरम्।\nत्वत्तः प्रति विशिष्टश्च कोऽन्योऽस्ति भुवि मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006333, "chapter_id": 1126, "verse_number": "१-१२७-६", "content_sanskrit": "इमां च तावद्धर्मात्मन्पौराणीं शृणु मे कथाम्।\nपरिश्रुतां विशालाक्ष कीर्तयिष्यामि यामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006334, "chapter_id": 1126, "verse_number": "१-१२७-७", "content_sanskrit": "व्युषइताश्व इति ख्यातो बभूव किल पार्थिवः।\nपुरा परमधर्मिष्ठः पूरोर्वंशविवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006335, "chapter_id": 1126, "verse_number": "१-१२७-८", "content_sanskrit": "तस्मिंश्च यजमाने वै धर्मात्मनि महाभुजे।\nउपागमंस्ततो देवाः सेन्द्रा देवर्षिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006336, "chapter_id": 1126, "verse_number": "१-१२७-९", "content_sanskrit": "अमाद्यदिन्द्रः सोमेन दक्षिणाभिर्द्विजातयः।\nव्युषिताश्वस्य राजर्षेस्ततो यज्ञे महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006337, "chapter_id": 1126, "verse_number": "१-१२७-१०", "content_sanskrit": "देवा ब्रह्मर्षयश्चैव चक्रुः कर्म स्वयं तदा।\nव्युषिताश्वस्ततो राजन्नति मर्त्यान्व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006338, "chapter_id": 1126, "verse_number": "१-१२७-११", "content_sanskrit": "सर्वभूतान्प्रति यथा तपनः शिशिरात्यये।\nस विजित्य गृहीत्वा च नृपतीन्राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006339, "chapter_id": 1126, "verse_number": "१-१२७-१२", "content_sanskrit": "प्राच्यानुदिच्यान्पाश्चात्यान्दाक्षिणात्यानकालयत्।\nअश्वमेधे महायज्ञे व्युषिताश्वः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006340, "chapter_id": 1126, "verse_number": "१-१२७-१३", "content_sanskrit": "बभूव स हि राजेन्द्रो दशनागबलान्वितः।\nअप्यत्र गाथां गायन्ति ये पुराणविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006341, "chapter_id": 1126, "verse_number": "१-१२७-१४", "content_sanskrit": "व्युषिताश्वे यशोवृद्धे मनुष्येन्द्रे कुरूत्तम।\nव्युषिताश्वः समुद्रान्तां विजित्येमां वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006342, "chapter_id": 1126, "verse_number": "१-१२७-१५", "content_sanskrit": "अपालयत्सर्ववर्णान्पिता पुत्रानिवौरसान्।\nयजमानो महायज्ञैर्ब्राह्मणेभ्यो धनं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006343, "chapter_id": 1126, "verse_number": "१-१२७-१६", "content_sanskrit": "अनन्तरत्नान्यादाय स जहार महाक्रतून्।\nसुषाव च बहून्सोमान्सोमसंस्थास्ततान च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006344, "chapter_id": 1126, "verse_number": "१-१२७-१७", "content_sanskrit": "आसीत्काक्षीवती चास्य भार्या परमसंमता।\nभद्रा नाम मनुष्येन्द्र रूपेणासदृशी भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006345, "chapter_id": 1126, "verse_number": "१-१२७-१८", "content_sanskrit": "कामयामासतुस्तौ च परस्परमिति श्रुतम्।\nस तस्यां कामसंपन्नो यक्ष्मणा समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006346, "chapter_id": 1126, "verse_number": "१-१२७-१९", "content_sanskrit": "तेनाचिरेण कालेन जगामास्तमिवांशुमान्।\nतस्मिन्प्रेते मनुष्येन्द्रे भार्याऽस्य भृशदुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006347, "chapter_id": 1126, "verse_number": "१-१२७-२०", "content_sanskrit": "अपुत्रा पुरुषव्याघ्र विललापेति नः श्रुतम्।\nभद्रा परमदुःखार्ता तन्निबोध जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006348, "chapter_id": 1126, "verse_number": "१-१२७-२१x", "content_sanskrit": "भद्रोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006349, "chapter_id": 1126, "verse_number": "१-१२७-२१", "content_sanskrit": "नारी परमधर्मज्ञ सर्वा भर्तृविनाकृता।\nपतिं विना जीवति या न सा जीवति दुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006350, "chapter_id": 1126, "verse_number": "१-१२७-२२", "content_sanskrit": "पतिं विना मृतं श्रेयो नार्याः क्षत्रियपुंगव॥\nत्वद्गतिं गन्तुमिच्छामि प्रसीदस्वनयस्वमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006351, "chapter_id": 1126, "verse_number": "१-१२७-२३", "content_sanskrit": "त्वया हीना क्षणमपि नाहं जीवितुमुत्सहे।\nप्रसादं कुरु मे राजन्नितस्तूर्णं नयस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006352, "chapter_id": 1126, "verse_number": "१-१२७-२४", "content_sanskrit": "पृष्ठतोऽनुगमिष्यामि समेषु विषमेषु च।\nत्वामहं नरशार्दूल गच्छन्तमनिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006353, "chapter_id": 1126, "verse_number": "१-१२७-२५", "content_sanskrit": "छायेवानुगता राजन्सततं वशवर्तिनी।\nभविष्यामि नरव्याघ्र नित्यं प्रियहिते रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006354, "chapter_id": 1126, "verse_number": "१-१२७-२६", "content_sanskrit": "अद्यप्रभृति मां राजन्कष्टा हृदयशोषणाः।\nआधयोऽभिभविष्यन्ति त्वामृते पुष्करेक्षण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006355, "chapter_id": 1126, "verse_number": "१-१२७-२७", "content_sanskrit": "अभाग्यया मया नूनं वियुक्ताः सहचारिणः।\nतेन मे विप्रयोगोऽयमुपपन्नस्त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006356, "chapter_id": 1126, "verse_number": "१-१२७-२८", "content_sanskrit": "विप्रयुक्ता तु या पत्या मुहूर्तमपि जीवति।\nदुःखं जीवति सा पापा नरकस्थेव पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006357, "chapter_id": 1126, "verse_number": "१-१२७-२९", "content_sanskrit": "संयुक्ता विप्रयुक्ताश्च पूर्वदेहे कृता मया।\nतदिदं कर्मभिः पापैः पूर्वदेहेषु संचितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006358, "chapter_id": 1126, "verse_number": "१-१२७-३०", "content_sanskrit": "दुःखं मामनुसंप्राप्तं राजंस्त्वद्विप्रयोगजम्।\nअद्यप्रभृत्यहं राजन्कुशसंस्तरशायिनी।\nभविष्याम्यसुखाविष्टा त्वद्दर्शनपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006359, "chapter_id": 1126, "verse_number": "१-१२७-३१", "content_sanskrit": "दर्शयस्व नरव्याघ्र शाधि मामसुखान्विताम्।\nकृपणां चाथ करुणं विलपत्नीं नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006360, "chapter_id": 1126, "verse_number": "१-१२७-३२x", "content_sanskrit": "कन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006361, "chapter_id": 1126, "verse_number": "१-१२७-३२", "content_sanskrit": "एवं बहुविधं तस्यां विलपन्त्यां पुनःपुनः।\nतं शवं संपरिष्वज्य वाक्किलाऽन्तर्हिताऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006362, "chapter_id": 1126, "verse_number": "१-१२७-३३", "content_sanskrit": "उत्तिष्ठ भद्रे गच्छ त्वं ददानीह वरं तव।\nजनयिष्याम्यपत्यानि त्वय्यहं चारुहासिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006363, "chapter_id": 1126, "verse_number": "१-१२७-३४", "content_sanskrit": "आत्मकीये वरारोहे शयनीये चतुर्दशीम्।\nअष्टमीं वा ऋतुस्नाता संविशेथा मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006364, "chapter_id": 1126, "verse_number": "१-१२७-३५", "content_sanskrit": "एवमुक्ता तु सा देवी तथा चक्रे पतिव्रता।\nयथोक्तमेव तद्वाक्यं भद्रा पुत्रार्थिनी तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006365, "chapter_id": 1126, "verse_number": "१-१२७-३६", "content_sanskrit": "सा तेन सुषुवे देवी शवेन भरतर्षभ।\nत्रीञ्शाल्वांश्चतुरो मद्रान्सुतान्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006366, "chapter_id": 1126, "verse_number": "१-१२७-३७", "content_sanskrit": "तथा त्वमपि मय्येवं मनसा भरतर्षभ।\nशक्तो जनयितुं पुत्रांस्तपोयोगबलान्वितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006367, "chapter_id": 1126, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि सप्तविंशत्यधिकशततमोऽध्यायः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]