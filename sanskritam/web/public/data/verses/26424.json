[{"id": 7006424000, "chapter_id": 26424, "verse_number": "२-८४-१", "content_sanskrit": "वैशम्पायन उवाच\nमुहूर्ताभ्युदिते सूर्ये जनचक्षुषि निर्मले ।\nबलः कृष्णः सात्यकिश्च तार्क्ष्यमारुरुहुस्तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006424001, "chapter_id": 26424, "verse_number": "२-८४-२", "content_sanskrit": "बद्धगोधाङ्गुलित्राणा दंशिता युद्धकाङ्क्षिणः ।\nबिल्वोदकेश्वरं देवं नमस्कृत्य सुरोत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006424002, "chapter_id": 26424, "verse_number": "२-८४-३", "content_sanskrit": "आवर्तया जले स्नात्वा रुद्रेण वरदत्तया ।\nगङ्गायाः कुरुशार्दूल रुद्रवाक्येन पुण्यया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006424003, "chapter_id": 26424, "verse_number": "२-८४-४", "content_sanskrit": "प्रद्युम्नमग्रे सैन्यस्य वियति स्थाप्य मानदः ।\nरक्षार्थं यज्ञवाटस्य पाण्डवान् विनियुज्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006424004, "chapter_id": 26424, "verse_number": "२-८४-५", "content_sanskrit": "शेषां सेनां गुहाद्वारि भगवान् विनियुज्य च ।\nजयन्तमथ सस्मार प्रवरं च सतां गतिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006424005, "chapter_id": 26424, "verse_number": "२-८४-६", "content_sanskrit": "तावापेतुरेवाथ स्वयं चापश्यतां तथा ।\nवियत्येव नियुक्तौ तौ प्रद्युम्न इव भारत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006424006, "chapter_id": 26424, "verse_number": "२-८४-७", "content_sanskrit": "ततः कृष्णस्य वचनादाहतो रणदुन्दुभिः ।\nजलजा मुरजाश्चैव वाद्यान्येवापराणि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006424007, "chapter_id": 26424, "verse_number": "२-८४-८", "content_sanskrit": "मकरो रचितो व्यूहः साम्बेन च गदेन च ।\nसारणश्चोद्धवश्चैव भोजो वैतरणस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006424008, "chapter_id": 26424, "verse_number": "२-८४-९", "content_sanskrit": "अनाधृष्टिश्च धर्मात्मा पृथुर्विपृथुरेव च ।\nकृतवर्मा च दंष्ट्रश्च निचक्षुररिमर्दनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006424009, "chapter_id": 26424, "verse_number": "२-८४-१०", "content_sanskrit": "सनत्कुमारो धर्मात्मा चारुदेष्णश्च भारत ।\nअनिरुद्धसहायौ तौ पृष्ठानीकं ररक्षतुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006424010, "chapter_id": 26424, "verse_number": "२-८४-११", "content_sanskrit": "शेषा यादवसेना तु व्यूहमध्ये व्यवस्थिता ।\nरथैरश्वैर्नरैर्नागैराकुला कुलवर्धन ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006424011, "chapter_id": 26424, "verse_number": "२-८४-१२", "content_sanskrit": "षट्पुरादपि निष्क्रान्ता दानवा युद्धदुर्मदाः ।\nआरुह्य मेघनादांश्च गर्दभानपि हस्तिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006424012, "chapter_id": 26424, "verse_number": "२-८४-१३", "content_sanskrit": "मकराञ्छिशुमारांश्च द्रुतानपि च भारत ।\nमहिषानपि खड्गांश्च उष्ट्रानपि च कच्छपान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006424013, "chapter_id": 26424, "verse_number": "२-८४-१४", "content_sanskrit": "एतैरेव रथैर्युक्ता विविधायुधपाणयः ।\nकिरीटापीडमुकुटैरङ्गदैरपि मण्डिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006424014, "chapter_id": 26424, "verse_number": "२-८४-१५", "content_sanskrit": "नानर्दमानैर्विविधैस्तूर्यैर्नेमिस्वनाकुलैः ।\nप्रध्मायमानैः शङ्खैश्च महाम्बुदसमस्वनैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006424015, "chapter_id": 26424, "verse_number": "२-८४-१६", "content_sanskrit": "तासामसुरसेनानामुद्यतानां जनेश्वर ।\nनिकुम्भो निर्ययावग्रे देवानामिव वासवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006424016, "chapter_id": 26424, "verse_number": "२-८४-१७", "content_sanskrit": "भूमिं द्यां च ववृधिरे दानवास्ते बलोत्कटाः ।\nनदन्तो विविधान्नादान् क्ष्वेडन्तश्च पुनः पुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006424017, "chapter_id": 26424, "verse_number": "२-८४-१८", "content_sanskrit": "राजसेनापि संयत्ता चेदिराजपुरोगमा ।\nअसुराणां सहायार्थे निश्चिता जनमेजय ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006424018, "chapter_id": 26424, "verse_number": "२-८४-१९", "content_sanskrit": "दुर्योधनभ्रातृशतं चेदिराजानुजाग्रगम् ।\nस्थितं रथैर्नरव्याघ्र गन्धर्वनगरोपमैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006424019, "chapter_id": 26424, "verse_number": "२-८४-२०", "content_sanskrit": "कठिनानादिनो वीर द्रुपदस्यन्दनास्तथा ।\nरुक्मी चैवाह्वृतिश्चैव तस्थतुर्निश्चितौ रणे ।\nतालवृक्षप्रतीकाशे धुन्वानौ धनुषी शुभे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006424020, "chapter_id": 26424, "verse_number": "२-८४-२१", "content_sanskrit": "शल्यश्च शकुनिश्चोभौ भगदत्तश्च पार्थिवः ।\nजरासंधस्त्रिगर्तश्च विराटश्च सहोत्तरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006424021, "chapter_id": 26424, "verse_number": "२-८४-२२", "content_sanskrit": "युद्धार्थमुद्यता वीरा निकुम्भाद्या जयैषिणः ।\nयुयुत्समाना यदुभिर्देवैरिव महासुराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006424022, "chapter_id": 26424, "verse_number": "२-८४-२३", "content_sanskrit": "ततो निकुम्भः समरे शरैराशीविषोपमैः ।\nममर्द समरे सेनां भैमानां भीमदर्शनाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006424023, "chapter_id": 26424, "verse_number": "२-८४-२४", "content_sanskrit": "सेनापतिरनाधृष्टिर्ममृषे तन्न यादवः ।\nममर्द घोरैर्बाणोघैश्चित्रपुङ्खैः शिलाशितैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006424024, "chapter_id": 26424, "verse_number": "२-८४-२५", "content_sanskrit": "न रथोऽसुरमुख्यस्य ददृशे न च वाजिनः ।\nन ध्वजो न निकुम्भस्तु सर्वे बाणाभिसंवृताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006424025, "chapter_id": 26424, "verse_number": "२-८४-२६", "content_sanskrit": "स परीत्य ततो वीरो निकुम्भो मायिनां वरः ।\nअस्तम्भयदनाधृष्टिं मायया भैमसत्तमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006424026, "chapter_id": 26424, "verse_number": "२-८४-२७", "content_sanskrit": "स्तम्भयित्वानयद् वीरं गुहां षट्पुरसंज्ञिताम् ।\nरुद्ध्वा चाभ्यगमद्वीरो मायाबलमुपाश्रितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006424027, "chapter_id": 26424, "verse_number": "२-८४-२८", "content_sanskrit": "पुनरेव निकुम्भस्तु कृतवर्माणमाहवे ।\nअनयच्चारुदेष्णं च भोजं वैतरणं तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006424028, "chapter_id": 26424, "verse_number": "२-८४-२९", "content_sanskrit": "सनत्कुमारमृक्षं च तथैव निशठोल्मुकौ ।\nबहूंश्चैवापरान् भोजान् मायाबलसमाश्रितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006424029, "chapter_id": 26424, "verse_number": "२-८४-३०", "content_sanskrit": "न तस्य ददृशे देहो मायाच्छन्नो जनेश्वर ।\nनयतो यादवान्घोरान् गुहां षट्पुरसंशिताम् ॥ ३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006424030, "chapter_id": 26424, "verse_number": "२-८४-३१", "content_sanskrit": "तद् दृष्ट्वा कदनं घोरं भैमानां भयवर्धनः ।\nचुकोप भगवान्कृष्णो बलः सत्यक एव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006424031, "chapter_id": 26424, "verse_number": "२-८४-३२", "content_sanskrit": "सविशेषं तथा कामः साम्बश्च परवीरहा ।\nअनिरुद्धश्च दुर्धर्षो भैमाश्च बहवोऽपरे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006424032, "chapter_id": 26424, "verse_number": "२-८४-३३", "content_sanskrit": "ततः शार्ङ्गायुधः शार्ङ्गं कृत्वा सज्यं नरेश्वर ।\nदानवेषु प्रवृत्तेषु तृणेष्विव हुताशनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006424033, "chapter_id": 26424, "verse_number": "२-८४-३४", "content_sanskrit": "तं दृष्ट्वा दानवा देवमभिदुद्रुवुरीश्वरम् ।\nशलभाः कालपाशार्ताः प्रदीप्तमिव पावकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006424034, "chapter_id": 26424, "verse_number": "२-८४-३५", "content_sanskrit": "समुत्सृज्य शतघ्नीश्च परिघांश्च सहस्रशः ।\nशूलानि चाग्नितुल्यानि प्रदीप्तांश्च परश्वधान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006424035, "chapter_id": 26424, "verse_number": "२-८४-३६", "content_sanskrit": "पर्वताग्राणि वृक्षांश्च घोराश्च विपुलाः शिलाः ।\nउत्क्षिप्य च गजान्मत्तान् रथानपि हयानपि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006424036, "chapter_id": 26424, "verse_number": "२-८४-३७", "content_sanskrit": "नारायणाग्निस्तान् सर्वान् ददाह प्रहसन्निव ।\nबाणार्चिषा महातेजा जगद्धितकरो हरिः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006424037, "chapter_id": 26424, "verse_number": "२-८४-३८", "content_sanskrit": "शारदं वर्षणं यद्वत् सेहे धीरो गवां पतिः ।\nतद्वद् यदुवृषः सेहे बाणवर्षमरिंदमः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006424038, "chapter_id": 26424, "verse_number": "२-८४-३९", "content_sanskrit": "न सेहिरे ऽसुरा बाणान्नारायणधनुश्च्युतान् ।\nवर्षं पर्जन्यविहितं वालुकासेतवो यथा ॥ ३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006424039, "chapter_id": 26424, "verse_number": "२-८४-४०", "content_sanskrit": "न शेकुः प्रमुखे स्थातुं कृष्णस्यासुरसत्तमाः ।\nव्यादितास्यस्य सिंहस्य वृषभा इव भारत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006424040, "chapter_id": 26424, "verse_number": "२-८४-४१", "content_sanskrit": "ते वध्यमानाः कृष्णेन दिवमाचक्रमुस्तदा ।\nजीविताशां वहन्तस्तु नारायणभयार्दिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006424041, "chapter_id": 26424, "verse_number": "२-८४-४२", "content_sanskrit": "तानाकाशगतानैन्द्रिर्जयन्तः प्रवरस्तथा ।\nनिजघ्नतुः शरैर्घोरैर्ज्वलितार्चिसमैः प्रभो ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006424042, "chapter_id": 26424, "verse_number": "२-८४-४३", "content_sanskrit": "निपेतुरसुराणां तु शिरांसि धरणीतले ।\nतृणराजफलानीव मुक्तानि शिखरात् तरोः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006424043, "chapter_id": 26424, "verse_number": "२-८४-४४", "content_sanskrit": "निपेतुर्बाहवश्छिन्ना दैन्यानां वसुधातले ।\nकालेनोपहता वीर पञ्चवक्त्रा इवोरगाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006424044, "chapter_id": 26424, "verse_number": "२-८४-४५", "content_sanskrit": "रौक्मिणेयस्ततः सृष्ट्वा घोरां मायामयीं गुहाम् ।\nअदृश्यनिष्क्रमं वीरः क्षत्रं प्रक्षेप्तुमुद्यतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006424045, "chapter_id": 26424, "verse_number": "२-८४-४६", "content_sanskrit": "गदेन सह धर्मात्मा सारणेन सुतेन च ।\nसाम्बेन चापरैश्चापि पूर्वं ये न प्रवेशिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006424046, "chapter_id": 26424, "verse_number": "२-८४-४७", "content_sanskrit": "प्रमथ्य तरसा कर्णे यतन्तं रणमूर्धनि ।\nजग्राह बलवान् कार्ष्णिः प्रस्फुरन्तं ततस्ततः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006424047, "chapter_id": 26424, "verse_number": "२-८४-४८", "content_sanskrit": "विनद्य च गुहां वीरो घोरां मायामयीं नृप ।\nदुर्योधनं च राजानं विराटद्रुपदावपि ॥ ४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006424048, "chapter_id": 26424, "verse_number": "२-८४-४९", "content_sanskrit": "शकुनिं चैव शल्यं च नीलं चापि नदीसुतम् ।\nविन्दानुविन्दौ राजानौ जरासंधं च भारत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006424049, "chapter_id": 26424, "verse_number": "२-८४-५०", "content_sanskrit": "त्रिगर्तान्मालवांश्चैव वासन्त्यांश्च महाबलान् ।\nधृष्टद्युस्नादिकांश्चैव पञ्चालानस्त्रकोविदान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006424050, "chapter_id": 26424, "verse_number": "२-८४-५१", "content_sanskrit": "तथाह्वृतिमुवाचेदं मातुलं रुक्मिमेव च ।\nशिशुपालं च राजानं भगदत्तं च भारत ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006424051, "chapter_id": 26424, "verse_number": "२-८४-५२", "content_sanskrit": "सम्बन्धं च गुरुत्वं च मानयामि नराधिपाः ।\nगुहामिमां घोररूपां यत्र प्रक्षेपयामि वः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006424052, "chapter_id": 26424, "verse_number": "२-८४-५३", "content_sanskrit": "बिल्वोदकेश्वरेणाहमाज्ञप्तः शूलपाणिना ।\nप्रक्षेप्तव्या नरेन्द्रास्ते गुहायामिति धीमता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006424053, "chapter_id": 26424, "verse_number": "२-८४-५४", "content_sanskrit": "आश्रित्य शाम्बरीं मायां निकुम्भेन महात्मना ।\nप्रक्षिप्तान् यादवांश्चैव मोक्षयिष्यामि सर्वथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006424054, "chapter_id": 26424, "verse_number": "२-८४-५५", "content_sanskrit": "इत्युक्तो शिशुपालस्तु राजा सेनापतिस्तथा ।\nशरैस्ततर्द तान् भैमान् प्रद्युम्नं च विशेषतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006424055, "chapter_id": 26424, "verse_number": "२-८४-५६", "content_sanskrit": "बिल्वोदकेश्वरं देवं रौक्मिणेयो नमस्य च ।\nआरभन्नृपतिं बद्धुं शिशुपालं महाबलम् ॥ ५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006424056, "chapter_id": 26424, "verse_number": "२-८४-५७", "content_sanskrit": "ततः पाशसहस्त्राणि ग्रहाय प्रवरोत्तमः ।\nशैलादिरब्रवीद् वीरं रौक्मिणेयं महाबलम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006424057, "chapter_id": 26424, "verse_number": "२-८४-५८", "content_sanskrit": "बिल्वोदकेश्वरो देवः प्राह त्वां यदुनन्दन ।\nसर्वं कुरु तथा रात्र्यां चोक्तस्त्वं भो यथा मया॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006424058, "chapter_id": 26424, "verse_number": "२-८४-५९", "content_sanskrit": "कन्यार्थं रत्नलुब्धांस्तु बद्ध्वा चेमान् नराधिपान् ।\nपाशैस्त्वमेव भोक्तुं च प्रमाणं यदुनन्दन ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006424059, "chapter_id": 26424, "verse_number": "२-८४-६०", "content_sanskrit": "असुरांस्तु महाबाहो निःशेषान् कर्तुमर्हसि ।\nएवमेव च वक्तव्यस्त्वया वीर जनार्दनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006424060, "chapter_id": 26424, "verse_number": "२-८४-६१", "content_sanskrit": "ततः स भगदत्तं च शिशुपालं च भूमिप ।\nआह्वृतिं चैव रुक्मिं च शेषांश्चान्यान्नराधिपान् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006424061, "chapter_id": 26424, "verse_number": "२-८४-६२", "content_sanskrit": "बबन्ध हरदत्तैस्तैः पाशैरुत्तमवीर्यधृक् ।\nमायामयीं गुहां चैवमानयत् कुरुनन्दन ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006424062, "chapter_id": 26424, "verse_number": "२-८४-६३", "content_sanskrit": "बद्ध्वा च रौक्मिणेयोऽथ निःश्वसन्त इवोरगान् ।\nअनिरुद्धं चकाराथ रक्षितारं स्वमात्मजम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006424063, "chapter_id": 26424, "verse_number": "२-८४-६४", "content_sanskrit": "तेषां निरवशेषेण बबन्ध यदुनन्दनः ।\nसेनापतीन् क्षत्रियांश्च कोशाध्यक्षांश्च भारत ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006424064, "chapter_id": 26424, "verse_number": "२-८४-६५", "content_sanskrit": "अव्यग्रस्तु ततो हन्तुमसुरानुद्यतः प्रभो ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006424065, "chapter_id": 26424, "verse_number": "२-८४-६६", "content_sanskrit": "संनद्ध एव चोवाच ब्रह्मदत्तं द्विजोत्तमम् ।\nविस्रब्धं वर्ततां कर्म मा भैः पश्य धनंजयम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006424066, "chapter_id": 26424, "verse_number": "२-८४-६७", "content_sanskrit": "न देवेभ्यो नासुरेभ्यो नागेभ्यो द्विजसत्तम ।\nभयं हि विद्यते तस्य गोप्तारो यस्य पाण्डवाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006424067, "chapter_id": 26424, "verse_number": "२-८४-६८", "content_sanskrit": "न चासुरैस्तव सुताः स्पृष्टाः खल्वपि चेतसा ।\nयज्ञवाटे निरीक्ष्यन्तां मायया निहिता मया ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]