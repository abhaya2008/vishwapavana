[{"id": 7006238000, "chapter_id": 26238, "verse_number": "२-६६-१", "content_sanskrit": "सूत उवाच सोमस्य तु बुधः पुत्रो बुधस्य तु पुरूरवाः ।\nतेजस्वी दानशीलश्च यज्वा विपुलदक्षिणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006238001, "chapter_id": 26238, "verse_number": "२-६६-२", "content_sanskrit": "ब्रह्मवादी पराक्रान्तः शत्रुभिर्युधि दुर्जयः ।\nआहर्त्ता जाग्निहोत्रस्य यज्ञानां च महीपतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006238002, "chapter_id": 26238, "verse_number": "२-६६-३", "content_sanskrit": "सत्यवाग्धर्मबुद्धिश्च कान्तः संवृत्तमैथुनः ।\nअतीव त्रिषु लोकेषु रूपेणाप्रतिमोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006238003, "chapter_id": 26238, "verse_number": "२-६६-४", "content_sanskrit": "तं ब्रह्मवादिनं दान्तं धर्मज्ञं सत्यवादिनम् ।\nउर्वशी वरयामास हित्वा मानं यशस्विनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006238004, "chapter_id": 26238, "verse_number": "२-६६-५", "content_sanskrit": "तया सहावसद्राजा दश वर्षाणि चाष्ट च ।\nसप्त षट्सप्त चाष्टौ च दश चाष्टौ च वीर्यवान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006238005, "chapter_id": 26238, "verse_number": "२-६६-६", "content_sanskrit": "वने चैत्ररथे रम्ये तथा मन्दाकिनीतटे ।\nअलकायां विशालायां नन्दने च वनोत्तमे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006238006, "chapter_id": 26238, "verse_number": "२-६६-७", "content_sanskrit": "गन्धमादनपादेषु मेरुशृङ्गे नगोत्तमे ।\nउत्तरांश्च कुरून्प्राप्य कलापग्राममेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006238007, "chapter_id": 26238, "verse_number": "२-६६-८", "content_sanskrit": "एतेषु वनमुख्येषु सुरैराचरितेषु च ।\nउर्वश्या महितो राजा रेमे परमया मुदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006238008, "chapter_id": 26238, "verse_number": "२-६६-९", "content_sanskrit": "ऋषय ऊचुः गन्धर्वी चोर्वशी देवी राजानं मानुषं कथम् ।\nउत्सृज्य तं च संप्राप्ता तन्नो ब्रूहि च दुष्कृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006238009, "chapter_id": 26238, "verse_number": "२-६६-१०", "content_sanskrit": "सूत उवाच ब्रह्मशापाभिभूता सा मानुषं समुपस्थिता ।\nआत्मनः शापमोक्षार्थं नियमं सा चकार तु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006238010, "chapter_id": 26238, "verse_number": "२-६६-११", "content_sanskrit": "अनग्नदर्शनं चैव अकामात्सह मैथुनम् ।\nद्वौ मेषौ शयनाभ्याशे सा तावद्ध्यवतिष्ठते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006238011, "chapter_id": 26238, "verse_number": "२-६६-१२", "content_sanskrit": "घृतमात्रं तथाऽहारः कालमेकं तु पार्थिव ।\nयद्येष समयो राजन्यावत्कालश्च ते दृढः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006238012, "chapter_id": 26238, "verse_number": "२-६६-१३", "content_sanskrit": "तावत्कालं तु वत्स्यामि एष नः समयः कृतः ।\nतस्यास्तं समयं सर्वं स राजा पर्यपालयत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006238013, "chapter_id": 26238, "verse_number": "२-६६-१४", "content_sanskrit": "एवं सा चावसत्तेन सहेलेना भिगामिनी ।\nवर्षाण्यथ चतुःषष्टिं तद्भक्त्या शापमोहिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006238014, "chapter_id": 26238, "verse_number": "२-६६-१५", "content_sanskrit": "उर्वशी मानुषं प्राप्ता गन्धर्वाश्चिन्तयान्विताः ।\nगन्धर्वा ऊचुः चिन्तयध्वं महाभागा यथा सा तु वराङ्गना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006238015, "chapter_id": 26238, "verse_number": "२-६६-१६", "content_sanskrit": "आगच्छेत्तु पुनर्देवानुर्वशी स्वर्गभूषणम् ।\nततो विश्वापसुर्नाम गन्धर्वः सुमहामतिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006238016, "chapter_id": 26238, "verse_number": "२-६६-१७", "content_sanskrit": "जहारोरणकौ तस्यास्तत्पश्चात्सा दिवं गता ।\nतस्यास्तु विरहेणासौ भ्रममाणस्त्वथोर्वशीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006238017, "chapter_id": 26238, "verse_number": "२-६६-१८", "content_sanskrit": "ददर्श च कुरुक्षेत्रे तया संभाषितोऽप्ययम् ।\nगन्धर्वानुपधावेति स तच्चक्रेऽथ ते ददुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006238018, "chapter_id": 26238, "verse_number": "२-६६-१९", "content_sanskrit": "अग्निस्थालीं तया राजा गतः स्वर्गं महारथः ।\nएकोऽग्निः पूर्वमासीद्वै ऐलस्तं त्रीनकल्पयत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006238019, "chapter_id": 26238, "verse_number": "२-६६-२०", "content_sanskrit": "एवंप्रभावो राजासीदैलस्तु द्विजसत्तमाः ।\nदेशे पुण्यतमे चैव महर्षिभिरलङ्कृते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006238020, "chapter_id": 26238, "verse_number": "२-६६-२१", "content_sanskrit": "राज्यं स कारयामास प्रयागे पृथिवीपतिः ।\nउत्तरे यामुने तीरे प्रतिष्ठाने महायशाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006238021, "chapter_id": 26238, "verse_number": "२-६६-२२", "content_sanskrit": "तस्य पुत्रा बभूवुर्हि षडिन्द्रोपमतेजसः ।\nगन्धर्वलोके विदिता आयुर्द्धीमानमावसुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006238022, "chapter_id": 26238, "verse_number": "२-६६-२३", "content_sanskrit": "विश्वावसुः श्रतायुश्च घृतायुश्चोवर्शीसुताः ।\nअमाव सोस्तु वै जाते भीमो राजाथ विश्वचित् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006238023, "chapter_id": 26238, "verse_number": "२-६६-२४", "content_sanskrit": "श्रीमान्भीमस्य दायादो राजासीत्काञ्चनप्रभः ।\nविद्वांस्तु काञ्चनस्यापि सुहोत्रोऽभून्महाबल ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006238024, "chapter_id": 26238, "verse_number": "२-६६-२५", "content_sanskrit": "सुहोत्रस्याभवज्जह्नुः केशिनीगर्भसंभवः ।\nप्रतिगत्य ततो गङ्गा वितते य५ अर्मणि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006238025, "chapter_id": 26238, "verse_number": "२-६६-२६", "content_sanskrit": "सादयामास तं देशं भाविनोर्ऽथस्य दर्शनात् ।\nगङ्गया प्लावितं दृष्ट्वा यज्ञवाटं समन्ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006238026, "chapter_id": 26238, "verse_number": "२-६६-२७", "content_sanskrit": "सौहोत्रिरपि संक्रुद्धो गङ्गां राजा द्विजोत्तमाः ।\nतदाराजर्षिणा पीतां गङ्गां दृष्ट्वा सुरर्षयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006238027, "chapter_id": 26238, "verse_number": "२-६६-२८", "content_sanskrit": "उपनिन्युर्महाभागा दुहितृत्वेन जाह्नवीम् ।\nयौवनाश्वस्य पौत्रीं तु कावेरीं जह्नुरावहत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006238028, "chapter_id": 26238, "verse_number": "२-६६-२९", "content_sanskrit": "युवनाश्वस्य शापेन गङ्गार्द्धेन विनिर्ममे ।\nकावेरीं सरितां श्रेष्ठ जह्नुभार्यामनिन्दिताम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006238029, "chapter_id": 26238, "verse_number": "२-६६-३०", "content_sanskrit": "जह्नुस्तु दयितं पुत्रं सुनहं नाम धार्मिकम् ।\nकावेर्यां जनयामास अजकस्तस्य चात्मजः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006238030, "chapter_id": 26238, "verse_number": "२-६६-३१", "content_sanskrit": "अजकस्य तु दायादो बलाकाश्वो महायशाः ।\nबभूव मृग शीलः सुशस्तस्यात्मजः स्मृतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006238031, "chapter_id": 26238, "verse_number": "२-६६-३२", "content_sanskrit": "कुशपुत्रा बभूवुश्च चत्वारो देववर्चसः ।\nकुशांबः कुशानाभश्च अमूर्तरयमो वसुः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006238032, "chapter_id": 26238, "verse_number": "२-६६-३३", "content_sanskrit": "कुशिकस्तु तपस्तेपे पुत्रार्थी राजसत्तमः ।\nपूर्णे वर्षसहस्रे वै शतक्रतुरपश्यत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006238033, "chapter_id": 26238, "verse_number": "२-६६-३४", "content_sanskrit": "तमुग्रतपसं दृष्ट्वा सहस्राक्षः पुरन्दरः ।\nसमर्थः पुत्रजनने स्वयमेवास्य शाश्वतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006238034, "chapter_id": 26238, "verse_number": "२-६६-३५", "content_sanskrit": "पुत्रत्वं कल्पयामास स्वयमेव पुरन्दरः ।\nगाधिर्नामाभवत्पुत्रः कौशिकः पाकशासनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006238035, "chapter_id": 26238, "verse_number": "२-६६-३६", "content_sanskrit": "पौरुकुत्स्यभवद्भार्या गाधेस्तस्यामजायत ।\nपूर्वं कन्या महाभागा नाम्ना सत्यवती शुभा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006238036, "chapter_id": 26238, "verse_number": "२-६६-३७", "content_sanskrit": "तां गाधिः पुत्रकामाय ऋचीकाय ददौ प्रभुः ।\nतस्याः प्रीतस्तु वै भर्त्ता भार्गवो भृगुनन्दनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006238037, "chapter_id": 26238, "verse_number": "२-६६-३८", "content_sanskrit": "पुत्रार्थे साधयामास चरुं गाधेस्तथैव च ।\nअथावोचत्प्रियां तत्र ऋचीको भार्गवस्तदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006238038, "chapter_id": 26238, "verse_number": "२-६६-३९", "content_sanskrit": "उपभोज्यश्चरुरयं त्वया मात्रा च ते शुभा ।\nतस्या जनिष्यते पुत्रो दीप्तिमान्क्षत्त्रियर्षभः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006238039, "chapter_id": 26238, "verse_number": "२-६६-४०", "content_sanskrit": "अजेयः क्षत्त्रियैर्युद्धे क्षत्रियर्षभसूदनः ।\nतवापि पुत्रं कल्याणि धृतिमन्तं तपोधनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006238040, "chapter_id": 26238, "verse_number": "२-६६-४१", "content_sanskrit": "शमात्मकं द्विजश्रेष्ठं चरुरेष विधास्यति ।\nएवमुक्त्वा तु तां भार्यामृचीको भृगुनन्दनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006238041, "chapter_id": 26238, "verse_number": "२-६६-४२", "content_sanskrit": "तपस्यभिरतो नित्यमरण्यं प्रविशेश ह ।\nगाधिः सदारस्तु तदा ऋचीकाश्रममभ्यगात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006238042, "chapter_id": 26238, "verse_number": "२-६६-४३", "content_sanskrit": "तीर्थयात्राप्रसंगेन सुतां द्रष्टुं नरेश्वरः ।\nचरुद्वयं गृहीत्वा तु ऋषेः स्त्यवती तदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006238043, "chapter_id": 26238, "verse_number": "२-६६-४४", "content_sanskrit": "भर्तुर्वचनमव्यग्रा हृष्टा मात्रे न्यवेदयत् ।\nमाता तु तस्यै दैवैन दुहित्रे स्वचरुं ददौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006238044, "chapter_id": 26238, "verse_number": "२-६६-४५", "content_sanskrit": "तस्याश्चरुमथाज्ञानादात्मनः सा चकार ह ।\nअथ सत्यवती गर्भं क्षत्रियान्तकरं शुभम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006238045, "chapter_id": 26238, "verse_number": "२-६६-४६", "content_sanskrit": "धारयामास दीप्तेन वपुषा घोरदर्शना ।\nतामृचीकस्ततो दृष्ट्वा योगेनाप्यवमृश्य च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006238046, "chapter_id": 26238, "verse_number": "२-६६-४७", "content_sanskrit": "तदाब्रवीद्द्विजश्रेष्ठः स्वां भार्यां वरवर्णिनीम् ।\nमात्रासि वञ्चिता भद्रे चरुव्यत्यासहेतुना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006238047, "chapter_id": 26238, "verse_number": "२-६६-४८", "content_sanskrit": "जनिष्यति हि पुत्रस्ते क्रूरकर्मातिदारुमः ।\nमाता जनिष्यते चापि तथा भूतं तपोधनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006238048, "chapter_id": 26238, "verse_number": "२-६६-४९", "content_sanskrit": "विश्वं हि ब्रह्मतपसा मया तत्र समर्पितम् ।\nएवमुक्ता महाभागा भर्त्रा सत्यवती तदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006238049, "chapter_id": 26238, "verse_number": "२-६६-५०", "content_sanskrit": "प्रसादयामास पतिं सुतो मे नेदृशो भवेत् ।\nब्राह्मणापसदस्त्वत्त इत्युक्तो मुनिमब्रवीत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006238050, "chapter_id": 26238, "verse_number": "२-६६-५१", "content_sanskrit": "नैव संकल्पितः कामो मया भद्रे तथा त्वया ।\nउग्रकर्मा भवेत्पुत्रः पितुर्मातुश्च कारणात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006238051, "chapter_id": 26238, "verse_number": "२-६६-५२", "content_sanskrit": "पुनः सत्यवती वाक्यमेवमुक्ताब्रवीदिदम् ।\nइच्छंल्लोकानपि मुने सृजेथाः किं पुनः सुतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006238052, "chapter_id": 26238, "verse_number": "२-६६-५३", "content_sanskrit": "शमात्मकमृजुं भर्त्तः पुत्रं मे दातुमर्हसि ।\nकाममेवंविधः पौत्रो मम स्यात्तव सुव्रत ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006238053, "chapter_id": 26238, "verse_number": "२-६६-५४", "content_sanskrit": "यद्यन्यथा न सक्यं वै कर्तुंमेवं द्विजोत्तम ।\nततः प्रसादमकरोत्स तस्यास्तपसो बलात् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006238054, "chapter_id": 26238, "verse_number": "२-६६-५५", "content_sanskrit": "पुत्रे नास्ति विशेषो मे पौत्रे वा वरवर्णिनि ।\nत्वया यथोक्तं वचनं तथा भद्रेभविष्यति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006238055, "chapter_id": 26238, "verse_number": "२-६६-५६", "content_sanskrit": "तस्मात्सत्यवती पुत्रं जनयामास भार्गवम् ।\nतपस्यभिरतं दान्तं जमदग्निं शमात्मकम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006238056, "chapter_id": 26238, "verse_number": "२-६६-५७", "content_sanskrit": "भृगोश्चरुविपर्यासे रौद्रवैष्णवयोः पुरा ।\nजमनाद्वैष्णवस्याग्नेर्जमदग्निरजायत ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006238057, "chapter_id": 26238, "verse_number": "२-६६-५८", "content_sanskrit": "विश्वामित्रं तु दायादं गाधिः कुशिकनन्दनः ।\nप्राप्य ब्रह्मर्षिसमतां जगाम ब्रह्मणा वृतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006238058, "chapter_id": 26238, "verse_number": "२-६६-५९", "content_sanskrit": "सा हि सत्यवती पुण्या सत्यव्रतपरायणा ।\nकौशिकी तु समाख्याता प्रवृत्तेयं महानदी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006238059, "chapter_id": 26238, "verse_number": "२-६६-६०", "content_sanskrit": "परिस्रुता महाभागा कौशिकी सरितां वरा ।\nइक्ष्वाकुवंशप्रभवो रेणुको नाम पार्थिवः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006238060, "chapter_id": 26238, "verse_number": "२-६६-६१", "content_sanskrit": "तस्य कन्या महाभागा कमली नाम रेणुका ।\nरेणुकायां कमल्यां तु तपोधृतिसमाधिना ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006238061, "chapter_id": 26238, "verse_number": "२-६६-६२", "content_sanskrit": "आर्चीको जनयामाम जमदग्निः सुदारुणम् ।\nसर्वविद्यान्तगं श्रेष्ठं धनुर्वेदस्य पारगम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006238062, "chapter_id": 26238, "verse_number": "२-६६-६३", "content_sanskrit": "रामं क्षत्त्रियहन्तारं प्रदीप्तमिव पावकम् ।\nऔर्वस्यैवमृचीकस्य सत्यवत्यां महामनाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006238063, "chapter_id": 26238, "verse_number": "२-६६-६४", "content_sanskrit": "जमदग्निस्तपोवीर्याज्जज्ञे ब्रह्मविदां वरः ।\nमध्यमश्च शुनःशेफः शुनः पुच्छः कनिष्ठकः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006238064, "chapter_id": 26238, "verse_number": "२-६६-६५", "content_sanskrit": "विश्वामित्रस्तु धर्मात्मा नाम्ना विश्वरथः स्मृतः ।\nजज्ञे भृगुप्रसादेन कौशिकान्वयवर्द्धनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006238065, "chapter_id": 26238, "verse_number": "२-६६-६६", "content_sanskrit": "विश्वामित्रस्य पुत्रस्तु शुनःशेफोऽभवन्मुनिः ।\nहरिश्चन्द्रस्य यज्ञे तु पशुत्वे नियतः स वै ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006238066, "chapter_id": 26238, "verse_number": "२-६६-६७", "content_sanskrit": "देवैर्दत्तः शुनःशेफो विश्वामित्राय वै पुनः ।\nदेवैर्दत्तः स वै यस्माद्देवरातस्ततोऽभवत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006238067, "chapter_id": 26238, "verse_number": "२-६६-६८", "content_sanskrit": "विश्वामित्रस्य पुत्राणां शुनःशेफोऽग्रजः स्मृतः ।\nमधुच्छन्दादयश्चैव कृतदेवौ ध्रुवाष्टकौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006238068, "chapter_id": 26238, "verse_number": "२-६६-६९", "content_sanskrit": "कच्छपः पूरणश्चैव विश्वामित्रसुतास्तु वै ।\nतेषाङ्गोत्राणि बहुधा कौशिकानां महात्मनाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006238069, "chapter_id": 26238, "verse_number": "२-६६-७०", "content_sanskrit": "पार्थिवा देवराताश्च जाज्ञवल्क्याः समर्पणाः ।\nउदुंबराश्च वातड्यास्तलकायनचान्द्रवाः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006238070, "chapter_id": 26238, "verse_number": "२-६६-७१", "content_sanskrit": "लोहिण्यो रेणवस्छैव तथा कारिषवः स्मृताः ।\nबभ्रवः पणिनस्छैव ध्यानजप्यास्तथैव च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006238071, "chapter_id": 26238, "verse_number": "२-६६-७२", "content_sanskrit": "श्यामायना हिरण्याक्षाः सांकृता गालवाः स्मृताः ।\nदेवला यामदूताश्च शालङ्कायनबाष्कलाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006238072, "chapter_id": 26238, "verse_number": "२-६६-७३", "content_sanskrit": "लालाढ्या बादराश्चान्ये विश्वामित्रस्य धीमतः ।\nऋष्यन्तरविवाह्यास्ते बहबः कौशिकाः स्मृताः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006238073, "chapter_id": 26238, "verse_number": "२-६६-७४", "content_sanskrit": "कौशिकाः सौश्रुताश्चैव तथान्ये सैन्धवायनाः ।\nयोगेश्वरस्य पुण्यस्य बह्मर्षेः कौशिकस्य वै ।\nविश्वामित्रस्य पुत्राणां शुनःशेफोऽग्रजः स्मृतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006238074, "chapter_id": 26238, "verse_number": "२-६६-७५", "content_sanskrit": "दृषद्वती सुतश्चापि विश्वामित्रात्तथाष्टकः ।\nअष्टकस्य सुतो लौहिः प्रोक्तो जह्नुगणो मया ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006238075, "chapter_id": 26238, "verse_number": "२-६६-७६", "content_sanskrit": "ऋषय ऊचुः किंलक्षणेन धर्मेण तपसेह श्रुतेन वा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006238076, "chapter_id": 26238, "verse_number": "२-६६-७७", "content_sanskrit": "ब्राह्मण्यं समनुप्राप्तं विश्वामित्रादिभिर्नृपैः ।\nयेनयेनाभिधानेन ब्राह्मण्यं क्षत्रिया गताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006238077, "chapter_id": 26238, "verse_number": "२-६६-७८", "content_sanskrit": "विशेषं ज्ञातुमिच्छामि तपसो दानतस्तथा ।\nएवमुक्तस्ततो वाक्यमब्रवीदिदमर्थवत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006238078, "chapter_id": 26238, "verse_number": "२-६६-७९", "content_sanskrit": "अन्यायोपगतैर्द्रव्यैराहूय द्विजसत्तमान् ।\nधर्माभिकाङ्क्षी यजते न धर्मफलमश्नुते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006238079, "chapter_id": 26238, "verse_number": "२-६६-८०", "content_sanskrit": "जपं कृत्वा तथा तीव्रं धनलोभान्निरङ्कुशः ।\nरागमोहान्वितो ह्यन्ते पावनार्थं ददाति यः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006238080, "chapter_id": 26238, "verse_number": "२-६६-८१", "content_sanskrit": "तेन दत्तानि दानानि ह्यफलानि भवन्त्युत ।\nतस्य धर्मप्रवृत्तस्य हिंसकस्य दुरात्मनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006238081, "chapter_id": 26238, "verse_number": "२-६६-८२", "content_sanskrit": "एवं लब्ध्वा धने मोहाद्ददतो यजतश्च ह ।\nसंक्लिष्टं कर्मणा दानं न तिष्ठति दुरात्मनः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006238082, "chapter_id": 26238, "verse_number": "२-६६-८३", "content_sanskrit": "न्यायागतानां द्रव्याणां तीर्थं संप्रतिपादनम् ।\nकामाननभि संधाय यजते च ददाति च ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006238083, "chapter_id": 26238, "verse_number": "२-६६-८४", "content_sanskrit": "स दानफलमाप्नोति तच्च दानं सुखोदयम् ।\nदानेन भोगानाप्नोति स्वर्गं सत्येन गच्छति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006238084, "chapter_id": 26238, "verse_number": "२-६६-८५", "content_sanskrit": "तपसा तु सुतप्तेन लोकान्विष्टभ्य तिष्ठति ।\nसत्यं तु तपसः श्रेयस्तस्माज्ज्ञानं गुरु स्मृतम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006238085, "chapter_id": 26238, "verse_number": "२-६६-८६", "content_sanskrit": "श्रूयते हि तपस्सिद्धाः क्षत्त्रोपेता द्विजातयः ।\nविश्वामित्रो नरपतिर्मान्धाता संकृतिः कपिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006238086, "chapter_id": 26238, "verse_number": "२-६६-८७", "content_sanskrit": "काश्यश्च पुरुकुत्सश्च शलो गृत्समदः प्रभुः ।\nआर्ष्टिषेणोऽजमीढश्च भार्गव्योमस्तथैव च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006238087, "chapter_id": 26238, "verse_number": "२-६६-८८", "content_sanskrit": "कक्षीवांश्चैवौशिजश्च नृपश्च शिशिरस्तथा ।\nरथान्तरः शौनकश्च विष्णुवृद्धादयो नृपाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006238088, "chapter_id": 26238, "verse_number": "२-६६-८९", "content_sanskrit": "क्षत्रोपेताः स्मृता ह्येते तपसा ऋषितां गताः ।\nएते राजर्षयः सर्वे सिद्धिं तु महतीं गताः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006238089, "chapter_id": 26238, "verse_number": "२-६६-९०", "content_sanskrit": "अत ज्ञर्ध्वं प्रवक्ष्यामि आयोर्वंशं महात्मनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]