[{"id": 7006357000, "chapter_id": 26357, "verse_number": "२-१३-१", "content_sanskrit": "वैशम्पायन उवाच\nदमिते सर्पराजे तु कृष्णेन यमुनाह्रदे ।\nतमेव चेरतुर्देशं सहितौ रामकेशवौ ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006357001, "chapter_id": 26357, "verse_number": "२-१३-२", "content_sanskrit": "आजग्मतुस्तौ सहितौ गोधनैः सह गामिनौ ।\nगिरिं गोवर्द्धनं रम्यं वसुदेवसुतावुभौ ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006357002, "chapter_id": 26357, "verse_number": "२-१३-३", "content_sanskrit": "गोवर्द्धनस्योत्तरतो यमुनातीरमाश्रितम् ।\nददृशाते च तौ वीरौ रम्यं तालवनं महत् ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006357003, "chapter_id": 26357, "verse_number": "२-१३-४", "content_sanskrit": "तौ तालपर्णप्रतते रम्यै तालवने रतौ ।\nचेरतुः परमप्रीतौ वृषपोताविवोद्धतौ ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006357004, "chapter_id": 26357, "verse_number": "२-१३-५", "content_sanskrit": "स तु देशः सदा स्निग्धो लोष्टपाषाणवर्जितः ।\nदर्भप्रायस्थलीभूतः सुमहान् कृष्णमृत्तिकः ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006357005, "chapter_id": 26357, "verse_number": "२-१३-६", "content_sanskrit": "तालैस्तैर्विपुलस्कन्धैरुच्छ्रितैः श्यामपर्वभिः ।\nफलाग्रशाखिभिर्भाति नागहस्तैरिवोच्छ्रितैः ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006357006, "chapter_id": 26357, "verse_number": "२-१३-७", "content_sanskrit": "तत्र दामोदरो वाक्यमुवाच वदतां वरः ।\nअहो तालफलैः पक्वैर्वासितेयं वनस्थली ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006357007, "chapter_id": 26357, "verse_number": "२-१३-८", "content_sanskrit": "स्वादून्यार्य सुगन्धीनि श्यामानि रसवन्ति च ।\nपक्वतालानि सहितौ पातयावो लघुक्रमौ ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006357008, "chapter_id": 26357, "verse_number": "२-१३-९", "content_sanskrit": "यद्येषामीदृशो गन्धो माधुर्यघ्राणतर्पणः ।\nरसेनामृतकल्पेन भवितव्यं च मे मतिः ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006357009, "chapter_id": 26357, "verse_number": "२-१३-१०", "content_sanskrit": "दामोदरवचः श्रुत्वा रौहिणेयो हसन्निव ।\nपातयन् पक्वतालानि चालयामास तांस्तरून् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006357010, "chapter_id": 26357, "verse_number": "२-१३-११", "content_sanskrit": "तत्तु तालवनं नृणामसेव्यं दुरतिक्रमम् ।\nनिर्माणभूतमिरिणं पुरुषादालयोपमम् ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006357011, "chapter_id": 26357, "verse_number": "२-१३-१२", "content_sanskrit": "दारुणो धेनुको नाम दैत्यो गर्दभरूपधृक् ।\nखरयूथेन महता वृतः समनुसेवते ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006357012, "chapter_id": 26357, "verse_number": "२-१३-१३", "content_sanskrit": "स तु तालवनं घोरं गर्दभः परिरक्षति ।\nनृपक्षिश्वापदगणांस्त्रासयानः सुदुर्मतिः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006357013, "chapter_id": 26357, "verse_number": "२-१३-१४", "content_sanskrit": "तालशब्दं स तं श्रुत्वा संघुष्टं फलपातनात् ।\nनामर्षयत् स संक्रुद्धस्तालस्वनमिव द्विपः ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006357014, "chapter_id": 26357, "verse_number": "२-१३-१५", "content_sanskrit": "शब्दानुसारी संक्रुद्धो दर्पाविद्धसटाननः ।\nस्तब्धाक्षो ह्रेषितपटुः खुरैर्निर्दारयन्महीम् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006357015, "chapter_id": 26357, "verse_number": "२-१३-१६", "content_sanskrit": "आविद्धपुच्छो हृषितो व्यात्तानन इवान्तकः ।\nआपतन्नेव ददृशे रौहिणेयमुपस्थितम् ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006357016, "chapter_id": 26357, "verse_number": "२-१३-१७", "content_sanskrit": "तालानां तमधो दृष्ट्वा स ध्वजाकारमव्ययम् ।\nरौहिणेयं खरो दुष्टः सोऽदशद् दशनायुधः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006357017, "chapter_id": 26357, "verse_number": "२-१३-१८", "content_sanskrit": "पद्भ्यामुभाभ्यां च पुनः पश्चिमाभ्यां पराङ्मुखः ।\nजघानोरसि दैत्येन्द्रो रौहिणेयं निरायुधम् ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006357018, "chapter_id": 26357, "verse_number": "२-१३-१९", "content_sanskrit": "ताभ्यामेव च जग्राह पद्भ्यां तं दैत्यगर्दभम् ।\nआवर्जितमुखस्कन्धं प्रेरयंस्तालमूर्धनि ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006357019, "chapter_id": 26357, "verse_number": "२-१३-२०", "content_sanskrit": "सम्भग्नोरुकटिग्रीवो भग्नपृष्ठो दुराकृतिः ।\nखरस्तालफलैः सार्धं पपात धरणीतले ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006357020, "chapter_id": 26357, "verse_number": "२-१३-२१", "content_sanskrit": "त' गतासुं गतश्रीकं पतितं वीक्ष्य गर्दभम् ।\nज्ञातींस्तथापरांस्तस्य तृणराजनि सोऽक्षिपत् ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006357021, "chapter_id": 26357, "verse_number": "२-१३-२२", "content_sanskrit": "सा भूर्गर्दभदेहैश्च तालैः पक्वैश्च पातितैः ।\nबभासे छन्नजलदा द्यौरिवाव्यक्तशारदी ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006357022, "chapter_id": 26357, "verse_number": "२-१३-२३", "content_sanskrit": "तस्मिन् गर्दभदैत्ये तु सानुगे विनिपातिते ।\nरम्यं तालवनं तद्धि भूयो रम्यतरं बभौ ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006357023, "chapter_id": 26357, "verse_number": "२-१३-२४", "content_sanskrit": "विप्रमुक्तभयं शुभ्रं विविक्ताकारदर्शनम् ।\nचरन्ति स्म सुखं गावस्तत् तालवनमुत्तमम् ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006357024, "chapter_id": 26357, "verse_number": "२-१३-२५", "content_sanskrit": "ततः प्रविष्टास्ते सर्वे गोपा वनविचारिणः ।\nवीतशोकभयायासाश्चञ्चूर्यन्ते समन्ततः ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006357025, "chapter_id": 26357, "verse_number": "२-१३-२६", "content_sanskrit": "ततः सुखं प्रकीर्णासु गोषु नागेन्द्रविक्रमौ ।\nद्रुमपर्णासनं कृत्वा तौ यथार्हं निषीदतुः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]