[{"id": 7001141000, "chapter_id": 21141, "verse_number": "२-२-३२-१", "content_sanskrit": "॥ नारद उवाच  ।\nश्रुत्वा व्योमगिरं दक्षः किमकार्षीत्तदाऽबुधः ।\nअन्ये च कृतवंतः किं ततश्च किमभूद्वद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001141001, "chapter_id": 21141, "verse_number": "२-२-३२-२", "content_sanskrit": "पराजिताः शिवगणा भृगुमंत्रबलेन वै ।\nकिमकार्षुः कुत्र गतास्तत्त्वं वद महामते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001141002, "chapter_id": 21141, "verse_number": "२-२-३२-३", "content_sanskrit": "ब्रह्मोवाच ।\nश्रुत्वा व्योमगिरं सर्वे विस्मिताश्च सुरादयः ।\nनावोचत्किंचिदपि ते तिष्ठन्तस्तु विमोहिताः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001141003, "chapter_id": 21141, "verse_number": "२-२-३२-४", "content_sanskrit": "पलायमाना ये वीरा भृगुमंत्रबलेन ते ।\nअवशिष्टा श्शिवगणाश्शिवं शरणमाययुः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001141004, "chapter_id": 21141, "verse_number": "२-२-३२-५", "content_sanskrit": "सर्वं निवेदयामासू रुद्रायामिततेजसे ।\nचरित्रं च तथाभूतं सुप्रणम्यादराच्च ते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001141005, "chapter_id": 21141, "verse_number": "२-२-३२-६", "content_sanskrit": "गणा ऊचुः ।\nदेवदेव महादेव पाहि नश्शरणागतान् ।\nसंशृण्वादरतो नाथ सती वार्तां च विस्तरात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001141006, "chapter_id": 21141, "verse_number": "२-२-३२-७", "content_sanskrit": "गर्वितेन महेशानदक्षेन सुदुरात्मना ।\nअवमानः कृतस्सत्याऽनादरो निर्जरैस्तथा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001141007, "chapter_id": 21141, "verse_number": "२-२-३२-८", "content_sanskrit": "तुभ्यं भागमदात्रो स देवेभ्यश्च प्रदत्तवान् ।\nदुर्वचांस्यवदत्प्रोच्चैर्दुष्टो दक्षस्सुगर्वितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001141008, "chapter_id": 21141, "verse_number": "२-२-३२-९", "content_sanskrit": "ततो दृष्ट्वा न ते भागं यज्ञेऽकुप्यत्सती प्रभो ।\nविनिंद्य बहुशस्तातमधाक्षीत्स्वतनुं तदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001141009, "chapter_id": 21141, "verse_number": "२-२-३२-१०", "content_sanskrit": "गणास्त्वयुतसंख्याका मृतास्तत्र विलज्जया ।\nस्वांगान्याछिद्य शस्त्रैश्च क्रुध्याम ह्यपरे वयम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001141010, "chapter_id": 21141, "verse_number": "२-२-३२-११", "content_sanskrit": "तद्यज्ञे ध्वंसितुं वेगात्सन्नद्धास्तु भयावहाः ।\nतिरस्कृता हि भृगुणा स्वप्रभावाद्विरोधिना॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001141011, "chapter_id": 21141, "verse_number": "२-२-३२-१२", "content_sanskrit": "ते वयं शरणं प्राप्तास्तव विश्वंभर प्रभो ।\nनिर्भयान् कुरु नस्तस्माद्दयमानभवाद्भयात्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001141012, "chapter_id": 21141, "verse_number": "२-२-३२-१३", "content_sanskrit": "अपमानं विशेषेण तस्मिन् यज्ञे महाप्रभो ।\nदक्षाद्यास्तेऽखिला दुष्टा अकुर्वन् गर्विता अति॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001141013, "chapter_id": 21141, "verse_number": "२-२-३२-१४", "content_sanskrit": "इत्युक्तं निखिलं वृत्तं स्वेषां सत्याश्च नारद ।\nतेषां च मूढबुद्धीनां यथेच्छसि तथा कुरु॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001141014, "chapter_id": 21141, "verse_number": "२-२-३२-१५", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्याकर्ण्यवचस्तस्य स्वगणानां वचः प्रभुः ।\nसस्मार नारदं सर्वं ज्ञातुं तच्चरितं लघु॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001141015, "chapter_id": 21141, "verse_number": "२-२-३२-१६", "content_sanskrit": "आगतस्त्वं द्रुतं तत्र देवर्षे दिव्यदर्शन ।\nप्रणम्य शंकरं भक्त्या सांजलिस्तत्र तस्थिवान्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001141016, "chapter_id": 21141, "verse_number": "२-२-३२-१७", "content_sanskrit": "त्वां प्रशस्याथ स स्वामी सत्या वार्त्तां च पृष्टवान् ।\nदक्षयज्ञगताया वै परं च चरितं तथा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001141017, "chapter_id": 21141, "verse_number": "२-२-३२-१८", "content_sanskrit": "पृष्टेन शंभुना तात त्वयाश्वेव शिवात्मना ।\nतत्सर्वं कथितं वृतं जातं दक्षाध्वरे हि यत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001141018, "chapter_id": 21141, "verse_number": "२-२-३२-१९", "content_sanskrit": "तदाकर्ण्येश्वरो वाक्यं मुने तत्त्वन्मुखोदितम् ।\nचुकोपातिद्रुतं रुद्रो महारौद्रपराक्रमः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001141019, "chapter_id": 21141, "verse_number": "२-२-३२-२०", "content_sanskrit": "उत्पाट्यैकां जटां रुद्रो लोकसंहारकारकः ।\nआस्फालयामास रुषा पर्वतस्य तदोपरि॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001141020, "chapter_id": 21141, "verse_number": "२-२-३२-२१", "content_sanskrit": "तोदनाच्च द्विधा भूता सा जटा च मुने प्रभोः ।\nसंबभूव महारावो महाप्रलयभीषणः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001141021, "chapter_id": 21141, "verse_number": "२-२-३२-२२", "content_sanskrit": "तज्जटायास्समुद्भूतो वीरभद्रो महाबलः ।\nपूर्वभागेन देवर्षे महाभीमो गणाग्रणीः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001141022, "chapter_id": 21141, "verse_number": "२-२-३२-२३", "content_sanskrit": "स भूमिं विश्वतो वृत्त्वात्यतिष्ठद्दशांगुलम् ।\nप्रलयानलसंकाशः प्रोन्नतो दोस्सहस्रवान्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001141023, "chapter_id": 21141, "verse_number": "२-२-३२-२४", "content_sanskrit": "कोपनिश्वासतस्तत्र महारुद्रस्य चेशितुः ।\nजातं ज्वराणां शतकं संनिपातास्त्रयोदश॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001141024, "chapter_id": 21141, "verse_number": "२-२-३२-२५", "content_sanskrit": "महाकाली समुत्पन्ना तज्जटापरभा गतः ।\nमहाभयंकरा तात भूतकोटिभिरावृता॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001141025, "chapter_id": 21141, "verse_number": "२-२-३२-२६", "content_sanskrit": "सर्वे मूर्त्तिधराः क्रूराः स्वर लोकभयंकराः ।\nस्वतेजसा प्रज्वलंतो दहंत इव सर्वतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001141026, "chapter_id": 21141, "verse_number": "२-२-३२-२७", "content_sanskrit": "अथ वीरो वीरभद्रः प्रणम्य परमेश्वरम् ।\nकृतांजलिपुटः प्राह वाक्यं वाक्यविशारदः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001141027, "chapter_id": 21141, "verse_number": "२-२-३२-२८", "content_sanskrit": "वीरभद्र उवाच ।\nमहारुद्र महारौद्र सोमसूर्याग्निलोचन ।\nकिं कर्तव्यं मया कार्यं शीघ्रमाज्ञापय प्रभो॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001141028, "chapter_id": 21141, "verse_number": "२-२-३२-२९", "content_sanskrit": "शोषणीयाः किमीशान क्षणार्द्धेनैव सिंधवः ।\nपेषणीयाः किमीशान क्षणार्द्धेनैव पर्वताः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001141029, "chapter_id": 21141, "verse_number": "२-२-३२-३०", "content_sanskrit": "क्षणेन भस्मसात्कुर्यां ब्रह्मांडमुत किं हर ।\nक्षणेन भस्मसात्कुर्याम्सुरान्वा किं मुनीश्वरान्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001141030, "chapter_id": 21141, "verse_number": "२-२-३२-३१", "content_sanskrit": "व्याश्वासः सर्वलोकानां किमु चार्यो हि शंकर ।\nकर्तव्य किमुतेशान सर्वप्राणिविहिंसनम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001141031, "chapter_id": 21141, "verse_number": "२-२-३२-३२", "content_sanskrit": "ममाशक्यं न कुत्रापि त्वत्प्रसादान्महेश्वर ।\nपराक्रमेण मत्तुल्यो न भूतो न भविष्यति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001141032, "chapter_id": 21141, "verse_number": "२-२-३२-३३", "content_sanskrit": "यत्र यत्कार्यमुद्दिश्य प्रेषयिष्यसि मां प्रभो ।\nतत्कार्यं साधयाम्येव सत्वरं त्वत्प्रसादतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001141033, "chapter_id": 21141, "verse_number": "२-२-३२-३४", "content_sanskrit": "क्षुद्रास्तरंति लोकाब्धिं शासनाच्छंकरस्य ते ।\nहरातोहं न किं तर्तुं महापत्सागरं क्षमः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001141034, "chapter_id": 21141, "verse_number": "२-२-३२-३५", "content_sanskrit": "त्वत्प्रेषिततृणेनापि महत्कार्यं मयत्नतः ।\nक्षणेन शक्यते कर्तुं शंकरात्र न संशयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001141035, "chapter_id": 21141, "verse_number": "२-२-३२-३६", "content_sanskrit": "लीलामात्रेण ते शंभो कार्यं यद्यपि सिद्ध्यति ।\nतथाप्यहं प्रेषणीयो तवैवानुग्रहो ह्ययम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001141036, "chapter_id": 21141, "verse_number": "२-२-३२-३७", "content_sanskrit": "शक्तिरेतादृशी शंभो ममापि त्वदनुग्रहात् ।\nविना शक्तिर्न कस्यापि शंकर त्वदनुग्रहात्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001141037, "chapter_id": 21141, "verse_number": "२-२-३२-३८", "content_sanskrit": "त्वदाज्ञया विना कोपि तृणादीनपि वस्तुतः ।\nनैव चालयितुं शक्तस्सत्यमेतन्न संशयः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001141038, "chapter_id": 21141, "verse_number": "२-२-३२-३९", "content_sanskrit": "शंभो नियम्यास्सर्वेपि देवाद्यास्ते महेश्वर ।\nतथैवाहं नियम्यस्ते नियंतुस्सर्वदेहिनाम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001141039, "chapter_id": 21141, "verse_number": "२-२-३२-४०", "content_sanskrit": "प्रणतोस्मि महादेव भूयोपि प्रणतोस्म्यहम् ।\nप्रेषय स्वेष्ट सिद्ध्यर्थं मामद्य हर सत्वरम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001141040, "chapter_id": 21141, "verse_number": "२-२-३२-४१", "content_sanskrit": "स्पंदोपि जायते शंभो सख्यांगानां मुहुर्मुहुः ।\nभविष्यत्यद्य विजयो मामतः प्रेषय प्रभो॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001141041, "chapter_id": 21141, "verse_number": "२-२-३२-४२", "content_sanskrit": "हर्षोत्साहविशेषोपि जायते मम कश्चन ।\nशंभो त्वत्पादकमले संसक्तश्च मनो मम॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001141042, "chapter_id": 21141, "verse_number": "२-२-३२-४३", "content_sanskrit": "भविष्यति प्रतिपदं शुभसंतानसंततिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001141043, "chapter_id": 21141, "verse_number": "२-२-३२-४४", "content_sanskrit": "तस्यैव विजयो नित्यं तस्यैव शुभमन्वहम् ।\nयस्य शंभौ दृढा भक्तिस्त्वयि शोभनसंश्रये॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001141044, "chapter_id": 21141, "verse_number": "२-२-३२-४५", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्तं तद्वचः श्रुत्वा संतुष्टो मंगलापतिः ।\nवीरभद्र जयेति त्वं प्रोक्ताशीः प्राह तं पुनः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001141045, "chapter_id": 21141, "verse_number": "२-२-३२-४६", "content_sanskrit": "महेश्वर उवाच ।\nशृणु मद्वचनं तात वीरभद्र सुचेतसा ।\nकरणीयं प्रयत्नेन तद्द्रुतं मे प्रतोषकम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001141046, "chapter_id": 21141, "verse_number": "२-२-३२-४७", "content_sanskrit": "यागं कर्तुं समुद्युक्तो दक्षो विधिसुतः खलः ।\nमद्विरोधी विशेषेण महागर्वोऽबुधोऽधुना॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001141047, "chapter_id": 21141, "verse_number": "२-२-३२-४८", "content_sanskrit": "तन्मखं भस्मसात्कृत्वा सयागपरिवारकम् ।\nपुनरायाहि मत्स्थानं सत्वरं गणसत्तम॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001141048, "chapter_id": 21141, "verse_number": "२-२-३२-४९", "content_sanskrit": "सुरा भवंतु गंधर्वा यक्षा वान्ये च केचन ।\nतानप्यद्यैव सहसा भस्मसात्कुरु सत्वरम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001141049, "chapter_id": 21141, "verse_number": "२-२-३२-५०", "content_sanskrit": "तत्रास्तु विष्णुर्ब्रह्मा वा शचीशो वा यमोपि वा ।\nअपि चाद्यैव तान्सर्वान्पातयस्व प्रयत्नतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001141050, "chapter_id": 21141, "verse_number": "२-२-३२-५१", "content_sanskrit": "सुरा भवंतु गंधर्वा यक्षा वान्ये च केचन ।\nतानप्यद्यैव सहसा भस्मसात्कुरु सत्वरम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001141051, "chapter_id": 21141, "verse_number": "२-२-३२-५२", "content_sanskrit": "दधीचिकृतमुल्लंघ्य शपथं मयि तत्र ये ।\nतिष्ठंति ते प्रयत्नेन ज्वालनीयास्त्वया ध्रुवम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001141052, "chapter_id": 21141, "verse_number": "२-२-३२-५३", "content_sanskrit": "प्रमथाश्चागमिष्यंति यदि विष्ण्वादयो भ्रमात् ।\nनानाकर्षणमंत्रेण ज्वालयानीय सत्वरम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001141053, "chapter_id": 21141, "verse_number": "२-२-३२-५४", "content_sanskrit": "ये तत्रोल्लंघ्य शपथं मदीयं गर्विताः स्थिताः ।\nते हि मद्द्रोहिणोऽतस्तान् ज्वालयानलमालया॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001141054, "chapter_id": 21141, "verse_number": "२-२-३२-५५", "content_sanskrit": "सपत्नीकान्ससारांश्च दक्षयागस्थलस्थितान् ।\nप्रज्वाल्य भस्मसात्कृत्वा पुनरायाहि सत्वरम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001141055, "chapter_id": 21141, "verse_number": "२-२-३२-५६", "content_sanskrit": "तत्र त्वयि गते देवा विश्वाद्य अपि सादरम् ।\nस्तोष्यंति त्वां तदाप्याशु ज्वालया ज्वालयैव तान्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001141056, "chapter_id": 21141, "verse_number": "२-२-३२-५७", "content_sanskrit": "देवानपि कृतद्रोहान् ज्वालामालासमाकुलः ।\nज्वालय ज्वलनैश्शीघ्रं माध्यायाध्यायपालकम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001141057, "chapter_id": 21141, "verse_number": "२-२-३२-५८", "content_sanskrit": "दक्षादीन्सकलांस्तत्र सपत्नीकान्सबांधवान् ।\nप्रज्वाल्य वीर दक्षं नु सलीलं सलिलं पिब॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001141058, "chapter_id": 21141, "verse_number": "२-२-३२-५९", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्तो रोषताम्राक्षो वेदमर्यादपालकः ।\nविरराम महावीरं कालारिस्सकलेश्वरः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]