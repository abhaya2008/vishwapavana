[{"id": 2034572, "chapter_id": 1745, "verse_number": "४-६८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034573, "chapter_id": 1745, "verse_number": "४-६८-१", "content_sanskrit": "ततो विजित्य संग्रामे कुरुगोवृषभेक्षणः।\nसमानयामास तदा विराटस्य धनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034574, "chapter_id": 1745, "verse_number": "४-६८-२", "content_sanskrit": "मतषु च प्रभग्नेषु धार्तराष्ट्रेषु सर्वशः।\nवनान्निष्क्रम्य गहनाद्बहवः कुरुसैनिकाः ।\nभयात्संत्रस्तमनसः समाजग्मुस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034575, "chapter_id": 1745, "verse_number": "४-६८-३", "content_sanskrit": "मुक्तकेशाः प्रदृश्यन्ते स्थिताः प्राञ्जलयस्तदा।\nक्षुत्पिणसापरिश्रान्ता विदेशस्था विचेतसः ।\nऊचुः प्राञ्जलयः सर्वे पार्थ किं करवामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034576, "chapter_id": 1745, "verse_number": "४-६८-४", "content_sanskrit": "प्राणानन्तर्मनोयातान्प्रयाचिष्यामहे वयम्।\nवयं चार्जुन ते दासा ह्यनुरक्ष्या ह्यनाथकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034577, "chapter_id": 1745, "verse_number": "४-६८-५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034578, "chapter_id": 1745, "verse_number": "४-६८-५", "content_sanskrit": "अनाथान्दुःखितान्दीनान्कृशान्वृद्धान्पराजितान्।\nन्यस्तशस्त्रान्निराशांश्च नाहं हन्मि कृताञ्जलीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034579, "chapter_id": 1745, "verse_number": "४-६८-६", "content_sanskrit": "भवन्तो यान्तु विस्रब्धा निर्भया अमृता यथा।\nमम पादरजोलक्ष्म्या जीवन्तु सुचिरं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034580, "chapter_id": 1745, "verse_number": "४-६८-७", "content_sanskrit": "तस्य तामभयां वाचं श्रुत्वा योधाः समागताः ।\nआयुः कीर्तियशोभिस्ते तमाशीर्भिरवर्धयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034581, "chapter_id": 1745, "verse_number": "४-६८-८", "content_sanskrit": "ततो निवृत्ताः कुरवो यग्नाश्च दिवमास्थिताः ।\nप्रयाताः सर्वतस्तत्र नमस्कृत्य धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034582, "chapter_id": 1745, "verse_number": "४-६८-९", "content_sanskrit": "एवं दत्ताभयास्तेन ततो याताः कुरून्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034583, "chapter_id": 1745, "verse_number": "४-६८-१०", "content_sanskrit": "स कर्म कृत्वा परमार्यकर्मा निहत्य शत्रून्द्विषतां निहन्ता।\nयातो महामेघ इवातपान्ते विद्राव्य पार्थः कुरुसैन्यमेकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034584, "chapter_id": 1745, "verse_number": "४-६८-११", "content_sanskrit": "तं मात्स्यपुत्रं द्विषतां निहन्ता वचोऽब्रवीत्संपरिगृह्य राजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034585, "chapter_id": 1745, "verse_number": "४-६८-१२", "content_sanskrit": "पितुः सकाशे तव तात सर्वे वसन्ति पार्था विदितं त्वयेति।\nतान्मास्म शंसीर्नगरं प्रविश्य भीतः प्रणश्येत्स च मत्स्यराजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034586, "chapter_id": 1745, "verse_number": "४-६८-१३", "content_sanskrit": "मया जिता सा ध्वजिनी कुरूणां मया हि गावो विजिता द्विषद्भ्यः ।\nएवं तु कामं नगरं प्रविश्य त्वमात्मना कर्म कृतं ब्रवीहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034587, "chapter_id": 1745, "verse_number": "४-६८-१४x", "content_sanskrit": "र उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034588, "chapter_id": 1745, "verse_number": "४-६८-१४", "content_sanskrit": "यत्ते कृतं कर्म न वारणीयं तत्कर्म कर्तुं मम नास्ति शक्तिः।\nन त्वां प्रवक्ष्यामि पितुः सकाशे यावन्न मां वक्ष्यसि सव्यसाचिन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034589, "chapter_id": 1745, "verse_number": "४-६८-१५x", "content_sanskrit": "पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034590, "chapter_id": 1745, "verse_number": "४-६८-१५", "content_sanskrit": "स शत्रुसेनां तरसा विजित्य आच्छिद्य सर्वं तु धनं कुरूणाम्।\nश्मशानमागम्य पुनः शमीं तामभ्येत्य तस्थौ शरविक्षताङ्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034591, "chapter_id": 1745, "verse_number": "४-६८-१६", "content_sanskrit": "ततः स वह्निप्रतिमो महाकपिः सहैव भूतैर्दिवमुत्पपात।\nतथा च माया विहिता बभूव सा ध्वजं च सिंहं युयुजे रथे पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034592, "chapter_id": 1745, "verse_number": "४-६८-१७", "content_sanskrit": "निधाय तच्चायुधमाजिमर्दनः कुरूत्तमानामिषुधीन्ध्वजांस्तथा।\nप्रायात्स मात्स्यो नगरं प्रवेष्टुं किरीटिना सारथिना महात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034593, "chapter_id": 1745, "verse_number": "४-६८-१८", "content_sanskrit": "पार्थश्च कृत्वा परमार्यकर्म निहत्य शत्रून्द्विषतां निहन्ता।\nविधाय भूयश्च तथैव वेषं जग्राह रश्मीन्पुनरुत्तरस्य।\nबृहन्नलारूपमथो विधाय प्रायात्य मात्स्यो नगरं प्रवेष्टुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034594, "chapter_id": 1745, "verse_number": "४-६८-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034595, "chapter_id": 1745, "verse_number": "४-६८-१९", "content_sanskrit": "ततो निवृत्ताः कुरवः प्रभग्नाः शममास्थिताः ।\nपरस्परमवेक्ष्यैव जग्मुस्ते हृतवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034596, "chapter_id": 1745, "verse_number": "४-६८-२०", "content_sanskrit": "पन्थानमुपसंगम्य फल्गुनो वाक्यमब्रवीत्।\nराजपुत्र प्रपद्यस्व धनानीमानि सर्वशः।\nगोकुलानि महाबाहो वीरगोपालकैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034597, "chapter_id": 1745, "verse_number": "४-६८-२१", "content_sanskrit": "ततोऽपराह्णे यास्यामो विराटनगरं प्रति।\nआश्वास्य पाययित्वा च परिप्लाव्य च वाजिनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034598, "chapter_id": 1745, "verse_number": "४-६८-२२", "content_sanskrit": "गच्छन्तु त्वरितं दूता गोपालाः प्रेषितास्त्वया।\nनगरे प्रियमाख्यातुं घोषयन्तु च ते जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034599, "chapter_id": 1745, "verse_number": "४-६८-२३", "content_sanskrit": "उत्तरस्त्वरमाणोऽथ दूतानाज्ञापयत्ततः।\nवचनादर्जुनस्यैव ह्याचक्षध्वं जयं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034600, "chapter_id": 1745, "verse_number": "", "content_sanskrit": "मया जिता सा ध्वजिनी कुरुणं\nमया च गावो विजिता द्विषद्भ्यः।\nएवं तु कामं नगरं प्रविश्य\nमयाऽऽत्मना कर्म कृतं ब्रवीत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]