[{"id": 7005968000, "chapter_id": 25968, "verse_number": "१-१५१-१", "content_sanskrit": "धन्वन्तरिरुवाच ।\nहिक्रारोगनिदानञ्च वक्ष्ये सुश्रुत ! तच्छृण ।\nश्वासैकहेतुः प्राग्रूपं संख्या प्रकृतिसंश्रया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005968001, "chapter_id": 25968, "verse_number": "१-१५१-२", "content_sanskrit": "हिक्रा भक्ष्योद्भवा क्षुद्रा यमला महतीतिच ।\nगम्भीरा च मरुत्तत्र त्वरयायुक्तिसेवितैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005968002, "chapter_id": 25968, "verse_number": "१-१५१-३", "content_sanskrit": "रूक्षतीक्ष्णखराशान्तैरन्नपानैः प्रपीडितः ।\nकरोति हिक्रां श्वसनः मन्दशब्दां क्षुधानुगाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005968003, "chapter_id": 25968, "verse_number": "१-१५१-४", "content_sanskrit": "समं सन्ध्यान्नपानेन या प्रयाति च सान्नजा ।\nआयासात्पवनः क्रुद्धः क्षुद्रां हिक्रां प्रवर्तयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005968004, "chapter_id": 25968, "verse_number": "१-१५१-५", "content_sanskrit": "जत्रुमूलात्परिसृता मन्दवेगवन्ती हि सा ।\nवृद्धिमायासतो याति भुक्तमात्रे च मार्दबम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005968005, "chapter_id": 25968, "verse_number": "१-१५१-६", "content_sanskrit": "चिरेण यमलैर्वेगैर्या हिक्रा संप्रवर्तते। ।\nपरिणामान्मुखे वृद्धिं परिणामे च गच्छति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005968006, "chapter_id": 25968, "verse_number": "१-१५१-७", "content_sanskrit": "कम्पयन्ती शिरो ग्रीवां यमलां तां विनिर्दिशत् ।\nप्रलापच्छर्द्यतीसारनेत्रविप्लुतजृम्भिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005968007, "chapter_id": 25968, "verse_number": "१-१५१-८", "content_sanskrit": "यमला वेगिनी हिक्रा परिणामवती च सा ।\nध्वस्तभ्रूशङ्खयुग्मस्य श्रुतिविप्लुतचक्षुषः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005968008, "chapter_id": 25968, "verse_number": "१-१५१-९", "content_sanskrit": "स्तम्भयन्ती तनुं वाचं स्मृतिं संज्ञां च मुञ्चत ।\nतुदन्ती मार्गमाणस्य कुर्वती मर्मघट्टनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005968009, "chapter_id": 25968, "verse_number": "१-१५१-१०", "content_sanskrit": "पृष्ठतो नमनं सार्ष्यं महाहिक्रा प्र्तते ।\nमहाशूला महाशब्दा महावेगा महाबला ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005968010, "chapter_id": 25968, "verse_number": "१-१५१-११", "content_sanskrit": "पक्राशयाच्च नाभेर्वा पूर्ववत्सा प्रवर्तते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005968011, "chapter_id": 25968, "verse_number": "१-१५१-१२", "content_sanskrit": "तद्रूपा सा महत्कुर्याञ्जृम्भणां गप्रसारम ।\nगम्भीरेण निदानेन गम्भीरा तु सुसाधयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005968012, "chapter_id": 25968, "verse_number": "१-१५१-१३", "content_sanskrit": "आद्ये द्वे वर्जयेदन्ये सर्वलिङ्गां च वेगिनम ।\nसर्वस्य संचितामस्य स्थविरस्य व्यवायिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005968013, "chapter_id": 25968, "verse_number": "१-१५१-१४", "content_sanskrit": "व्याधिभिः क्षीणदेहस्य भक्तच्छेदकृशस्य च ।\nसर्वेऽपि रोगा नाशाय न त्वेवं शाघ्रकारिणः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005968014, "chapter_id": 25968, "verse_number": "१-१५१-१५", "content_sanskrit": "हिक्राश्वासौ यथा तौ हि मृत्युकाले कृतालयौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]