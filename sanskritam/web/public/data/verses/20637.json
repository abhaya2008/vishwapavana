[{"id": 7000637000, "chapter_id": 20637, "verse_number": "५-९६-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूतसूतमहाप्राज्ञ जीवजीव शतंसमाः ।\nयद्वयं पुण्यसमयं श्राविता जगतो हितम् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000637001, "chapter_id": 20637, "verse_number": "५-९६-२", "content_sanskrit": "वद भूयोऽपि भूयिष्ठं पिबामस्तावकं वचः ।\nपायंपायं न तृप्यामो वयं सूत तदुत्तमम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000637002, "chapter_id": 20637, "verse_number": "५-९६-३", "content_sanskrit": "सूत उवाच ।\nअत्राप्युदाहरंतीममितिहासं पुरातनम् ।\nसंवादमादिलोकस्य जगतां जगदीशितुः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000637003, "chapter_id": 20637, "verse_number": "५-९६-४", "content_sanskrit": "षट्सहस्राणिचोच्छ्रायो विस्तारेण पुनस्त्रयम् ।\nएवं नवसहस्राणि योजनानां विधाय च ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000637004, "chapter_id": 20637, "verse_number": "५-९६-५", "content_sanskrit": "वामया दंष्ट्रया गृह्य उद्धृतादौ वसुंधरा ।\nदिव्यवर्षसहस्रं वै दंष्ट्रया धारिता मही ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000637005, "chapter_id": 20637, "verse_number": "५-९६-६", "content_sanskrit": "धर्माख्यानप्रसंगेन सोवाच विनयाद्विभुम् ।\nपृथिव्युवाच ।\nएते द्वादश मासा वै षष्टिर्दिनशतत्रयम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000637006, "chapter_id": 20637, "verse_number": "५-९६-७", "content_sanskrit": "एषां किमुत्तमं पुण्यं प्रियं च तव केशव ।\nपवित्रः कार्तिको मासस्तुलासंस्थे दिवाकरे ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000637007, "chapter_id": 20637, "verse_number": "५-९६-८", "content_sanskrit": "मकरस्थे रवौ मासः पुराणे पावनः स्मृतः ।\nमेषस्थे माधवो मासो भास्करे पठ्यते बुधैः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000637008, "chapter_id": 20637, "verse_number": "५-९६-९", "content_sanskrit": "मार्गशीर्षोऽपि मासानां पावनः परिकीर्तितः ।\nएवं मासाः पवित्रास्ते वासराः केपि कीर्तिताः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000637009, "chapter_id": 20637, "verse_number": "५-९६-१०", "content_sanskrit": "युगादयो युगांताश्च तथा कल्पादयोऽपि च ।\nसर्वेभ्योऽप्यधिकं मासमेतेभ्यो वद पावनम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000637010, "chapter_id": 20637, "verse_number": "५-९६-११", "content_sanskrit": "सर्वयज्ञमय श्रीमन्नेकं निश्चित्य मे वद ।\nवराह उवाच ।\nविधिनाविधिनाचैव ये यजंति नराधमाः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000637011, "chapter_id": 20637, "verse_number": "५-९६-१२", "content_sanskrit": "माधवे मासि मां भक्त्या तैश्च पूज्योऽस्म्यहं सदा ।\nहिरण्याक्षो वरारोहे माधवे तु मधुर्हत ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000637012, "chapter_id": 20637, "verse_number": "५-९६-१३", "content_sanskrit": "आदिदैत्यावुभावेतौ हत्वा त्वं तु समुद्धृता ।\nत्रेतायुगे त्रयी धर्मो ज्ञानवर्णव्यवस्थितिः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000637013, "chapter_id": 20637, "verse_number": "५-९६-१४", "content_sanskrit": "माधवे मासि संभूता तेन मे माधवःप्रियः ।\nत्रेतायुगं तृतीयायां शुक्लायां मासि माधवे ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000637014, "chapter_id": 20637, "verse_number": "५-९६-१५", "content_sanskrit": "प्रवृत्तं च त्रयी धर्माः प्रवृत्तास्ते प्रवर्द्धिताः ।\nअक्षया सोच्यते लोके तृतीया हरिवल्लभा ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000637015, "chapter_id": 20637, "verse_number": "५-९६-१६", "content_sanskrit": "स्नाने दानार्चने श्राद्धे जपे पूर्वजतर्प्पणे ।\nयेऽर्चयंति यवैर्विष्णुं श्राद्धं कुर्वंति यत्नतः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000637016, "chapter_id": 20637, "verse_number": "५-९६-१७", "content_sanskrit": "तेषां ददाम्यहं सर्वं यन्मनोऽभीष्टमुत्तमम् ।\nये ददंत्यपि दानानि धन्यास्ते धार्मिका नराः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000637017, "chapter_id": 20637, "verse_number": "५-९६-१८", "content_sanskrit": "ये यजंति हरेर्नित्यमध्वरैर्विविधैरपि ।\nमाधवे यजते यो मां तेभ्यस्तदधिकं फलम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000637018, "chapter_id": 20637, "verse_number": "५-९६-१९", "content_sanskrit": "स्नानं दानं जपो होमस्तपो यज्ञ व्रतादिकम् ।\nवैशाखे यत्कृतं देवि तस्य पुण्यफलं शृणु ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000637019, "chapter_id": 20637, "verse_number": "५-९६-२०", "content_sanskrit": "मन्वंतराणां कोट्यस्तु दशपंच च सप्त च ।\nमत्सान्निध्यगतास्तेपि तिष्ठंति भयवर्जिताः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000637020, "chapter_id": 20637, "verse_number": "५-९६-२१", "content_sanskrit": "यद्यपि स्युर्ग्रहाः सर्वे क्रूरा जन्मव्ययाष्टकाः ।\nप्रातःस्नानेन वैशाखे सर्वे सौम्या भवंति ते ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000637021, "chapter_id": 20637, "verse_number": "५-९६-२२", "content_sanskrit": "वैशाखे मासि यो विप्रान्भोजयेद्भक्तितत्परः ।\nसिक्थेसिक्थे भवेत्तृप्तिः पितॄणां युगसंख्यया ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000637022, "chapter_id": 20637, "verse_number": "५-९६-२३", "content_sanskrit": "यच्छंति तत्र मधुराधिकभोजनानि ये वायवाशन तिलोदक भोजनानि ।\nछत्रांबराणि चरणोचितरक्षणानि धन्यास्त एव परितोषकराहि विष्णोः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000637023, "chapter_id": 20637, "verse_number": "५-९६-२४", "content_sanskrit": "विशेषादिह दातव्यास्तिला मधुसमन्विताः ।\nधर्माय बृहते दीर्घ दुरितक्षय हेतवे ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000637024, "chapter_id": 20637, "verse_number": "५-९६-२५", "content_sanskrit": "एवंकृते तु यत्पुण्यं प्राप्यते मनुजैश्च तैः ।\nतत्कैर्गणयितुं शक्यं वर्षकोटिशतैरपि ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000637025, "chapter_id": 20637, "verse_number": "५-९६-२६", "content_sanskrit": "पुत्रपौत्रादिसंपत्ति दीर्घायूंषि यथेप्सितम् ।\nइहाप्नोति परत्रापि मामेव प्रतिपद्यते ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000637026, "chapter_id": 20637, "verse_number": "५-९६-२७", "content_sanskrit": "अनेकजन्मार्जित पातकावली विलीयते माधव मज्जनेन ।\nजनस्य तत्रोषसि पुण्यतीर्थे यथाविधानं श्रयते तथा वा ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000637027, "chapter_id": 20637, "verse_number": "५-९६-२८", "content_sanskrit": "यः परित्यज्य वैशाखं व्रतमन्यदुपाचरेत् ।\nस करस्थं महारत्नं हित्वा लोष्टं हि याचते ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000637028, "chapter_id": 20637, "verse_number": "५-९६-२९", "content_sanskrit": "सूतौवाच ।\nएवं स भगवान्पूर्वमादिदेवो वदद्विभुः ।\nमाधवं मासमुद्दिश्य जगत्यां जगतीधरः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000637029, "chapter_id": 20637, "verse_number": "५-९६-३०", "content_sanskrit": "किमत्र बहुनोक्तेन न तदस्ति महीसुराः ।\nयदप्राप्यं भवेन्मासि माधवे माधवार्चनात् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000637030, "chapter_id": 20637, "verse_number": "५-९६-३१", "content_sanskrit": "शृणुध्वं च पुरावृत्तमिहार्थे परमाद्भुतम् ।\nब्राह्मणस्य च संवादं यमस्य च महात्मनः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000637031, "chapter_id": 20637, "verse_number": "५-९६-३२", "content_sanskrit": "मध्यदेशे महाग्रामो ब्राह्मणानां बभूव ह ।\nगंगायमुनयोर्मध्ये यामुनस्य गिरेरधः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000637032, "chapter_id": 20637, "verse_number": "५-९६-३३", "content_sanskrit": "विद्वांसस्तत्र भूयिष्ठा ब्राह्मणाश्चावसंस्तदा ।\nअथ प्राह यमः कंचित्पुरुषं कृष्णपिंगलम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000637033, "chapter_id": 20637, "verse_number": "५-९६-३४", "content_sanskrit": "रक्ताक्षमूर्द्ध्वरोमाणं काकजंघाक्षिनासिकम् ।\nगच्छ त्वं भो महाग्रामं गत्वा ब्राह्मणमानय ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000637034, "chapter_id": 20637, "verse_number": "५-९६-३५", "content_sanskrit": "वसिष्ठगोत्रसंभूतं नामतो यज्ञदत्तकम् ।\nशमे निविष्टं विद्वांसं यज्ञकर्मविशारदम् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000637035, "chapter_id": 20637, "verse_number": "५-९६-३६", "content_sanskrit": "नचान्यमानयेथास्त्वं सगोत्रं तस्य पार्श्वतः ।\nसहितादृग्गुणस्तेन तुल्योऽध्ययन जन्मना ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000637036, "chapter_id": 20637, "verse_number": "५-९६-३७", "content_sanskrit": "आकृत्या च तथा चिह्नैः समस्तेनैव सत्तमः ।\nतमानय यथोद्दिष्टा पूजा कार्या हि तस्य मे ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000637037, "chapter_id": 20637, "verse_number": "५-९६-३८", "content_sanskrit": "स गत्वा प्रतिकूलं तु चकार यमशासनम् ।\nतमेव मानयामास प्रतिषिद्धो यमेन यः ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000637038, "chapter_id": 20637, "verse_number": "५-९६-३९", "content_sanskrit": "तस्मै यमः समुत्थाय पूजां कृत्वा च धर्मवित् ।\nप्रोवाच नीयतामेष सोऽन्य आनीयतामिति ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000637039, "chapter_id": 20637, "verse_number": "५-९६-४०", "content_sanskrit": "सूत उवाच ।\nएवमुक्ते तु वचने धर्मराजेन स द्विजः ।\nउवाच धर्मराजं तं निर्विण्णो गमनाय वै ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000637040, "chapter_id": 20637, "verse_number": "५-९६-४१", "content_sanskrit": "ब्राह्मण उवाच ।\nकस्मादहमिहानीतः कस्मात्प्रेरयसे पुनः ।\nगंतुं नैवोत्सहे तत्र मर्त्यलोकं पुनः प्रभो ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000637041, "chapter_id": 20637, "verse_number": "५-९६-४२", "content_sanskrit": "यम उवाच ।\nइह क्षीणायुषां पुंसां वासः पुण्यवतां भवेत् ।\nअयं वै धर्मराजस्य लोको धर्मः प्रकीर्तितः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000637042, "chapter_id": 20637, "verse_number": "५-९६-४३", "content_sanskrit": "सौख्यभूमिरियं सर्वा धर्मराजोऽहमीश्वरः ।\nपुण्यापुण्यानुसारेण जंतूनां सुखदुःखदः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000637043, "chapter_id": 20637, "verse_number": "५-९६-४४", "content_sanskrit": "पापिनां यमरूपोऽस्मि नृणां निरयदायकः ।\nतथा पुण्यवतां सौख्य स्वर्गदो धर्म मूर्तिमान् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000637044, "chapter_id": 20637, "verse_number": "५-९६-४५", "content_sanskrit": "गच्छ विप्र त्वमद्यैव निलयं स्वं यथागतः ।\nअद्यापि दशवर्षाणामायुस्ते परिवर्तते ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000637045, "chapter_id": 20637, "verse_number": "५-९६-४६", "content_sanskrit": "क्षये तवायुषः प्राप्तिर्लोकस्यास्य भविष्यति ।\nप्रष्टव्यं च त्वया ह्यन्यत्पृच्छस्व प्रब्रवीमि ते ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000637046, "chapter_id": 20637, "verse_number": "५-९६-४७", "content_sanskrit": "ब्राह्मण उवाच ।\nयत्कृत्वा सुमहत्पुण्यं स्वर्गः स्याद्ब्रूहि तन्मम ।\nसर्वस्य हि प्रमाणंत्वं धर्माधर्मविनिश्चये ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000637047, "chapter_id": 20637, "verse_number": "५-९६-४८", "content_sanskrit": "यदि देव मया सम्यग्गंतव्यं निजमंदिरे ।\nतद्ब्रूहि कर्मणा केन पतंति नरके नराः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000637048, "chapter_id": 20637, "verse_number": "५-९६-४९", "content_sanskrit": "व्रजंति केन वै स्वर्गं तत्सर्वं कृपया वद ।\nयम उवाच ।\nकर्मणा मनसा वाचा ये धर्मविमुखा नराः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000637049, "chapter_id": 20637, "verse_number": "५-९६-५०", "content_sanskrit": "विष्णुभक्तिविहीना ये ते वै निरयगामिनः ।\nपश्यंति भेदबुद्ध्या ये ब्रह्माणं शंकरं हरिम् ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000637050, "chapter_id": 20637, "verse_number": "५-९६-५१", "content_sanskrit": "विरक्ता विष्णुविद्यासु नरा निरयगामिनः ।\nकुलदेशोचितं कर्म यस्त्यक्त्वान्यत्समाचरेत् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000637051, "chapter_id": 20637, "verse_number": "५-९६-५२", "content_sanskrit": "कामाद्वा यदि वा मोहात्स याति नरकं नरः ।\nअयाज्ययाजकश्चैव याज्यानां च विवर्जकः ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000637052, "chapter_id": 20637, "verse_number": "५-९६-५३", "content_sanskrit": "विरतो विष्णुविद्यासु स भुंक्ते नरकान्बहून् ।\nअदत्वा पितृदेवेभ्यो विप्रेभ्यो मर्त्यबंधुषु ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000637053, "chapter_id": 20637, "verse_number": "५-९६-५४", "content_sanskrit": "सधनो म्रियते पापः स याति नरकान्बहून् ।\nसर्वाण्यन्नानि सिद्धानि पाकभेदं करोति यः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000637054, "chapter_id": 20637, "verse_number": "५-९६-५५", "content_sanskrit": "अवैश्वदेवं भुंजीत स याति नरकं चिरम् ।\nबहुद्रोहेण भूतानां येऽजयंति धनं द्विज ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000637055, "chapter_id": 20637, "verse_number": "५-९६-५६", "content_sanskrit": "धनवंतो निरयगा दांभिका दुःखभागिनः ।\nनास्तिक्यादथ वा लोभान्मोहात्काले यथोदिते ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000637056, "chapter_id": 20637, "verse_number": "५-९६-५७", "content_sanskrit": "भक्त्या न श्राद्धदा ये स्युः पच्यंते नरकेषु ते ।\nदीयमानस्य वित्तस्य ब्राह्मणेभ्यस्तु पापकृत् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000637057, "chapter_id": 20637, "verse_number": "५-९६-५८", "content_sanskrit": "विघ्नमाचरते योऽसौ नरो निरयगो भवेत् ।\nसामान्य दक्षिणां लब्ध्वा गृह्णात्येको विमोहतः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000637058, "chapter_id": 20637, "verse_number": "५-९६-५९", "content_sanskrit": "नास्तिक्यभावनिरतो नरः स्यान्नरकालये ।\nअसहिष्णुतया तस्य गुणानां कारणं भवेत् ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000637059, "chapter_id": 20637, "verse_number": "५-९६-६०", "content_sanskrit": "महत्पापं समुत्पन्नं कारणं नरकस्य तत् ।\nनिर्दोषां सुहृदां भार्यां त्यजन्कालेन याति यः ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000637060, "chapter_id": 20637, "verse_number": "५-९६-६१", "content_sanskrit": "न वहेत यशस्तेषां स नरो नरके पतेत् ।\nअधर्मं धर्ममिति यो वदन्मोहवशं गतः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000637061, "chapter_id": 20637, "verse_number": "५-९६-६२", "content_sanskrit": "हैतुको नास्तिको यस्तु स नरो निरयालयः ।\nमनसा योऽन्यभावेन वचसा चान्यथा वदेत् ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000637062, "chapter_id": 20637, "verse_number": "५-९६-६३", "content_sanskrit": "हृदयं कलुषं कुर्यात्स नरो नरके वसेत् ।\nअवमन्य च ये यांति भगवत्कीर्तनं नराः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000637063, "chapter_id": 20637, "verse_number": "५-९६-६४", "content_sanskrit": "ते यांति नरकं घोरं तेन पापेन कर्मणा ।\nपश्यंतो भगवद्द्वारं नामशास्त्र परिच्छदम् ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000637064, "chapter_id": 20637, "verse_number": "५-९६-६५", "content_sanskrit": "अकृत्वा तत्प्रणामादि ते यांति नरकौकसः ।\nविनापराधेन नराः कृत्वा पत्न्यधिवेदनम् ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000637065, "chapter_id": 20637, "verse_number": "५-९६-६६", "content_sanskrit": "त्यजंति सुकलत्रं ये ते यांति नरके नराः ।\nन शृणोति गुरोर्वाक्यं धर्मशास्त्रं च यो नरः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000637066, "chapter_id": 20637, "verse_number": "५-९६-६७", "content_sanskrit": "परेषां चेतसः क्लेशकारी निरयगो भवेत् ।\nपश्यतां बंधु बालानां प्रकर्षी मिष्टमश्नुते ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000637067, "chapter_id": 20637, "verse_number": "५-९६-६८", "content_sanskrit": "स याति नरकं घोरं केवलोदरपूरकः ।\nतुला मकर मेषेषु प्रातः स्नानं न यश्चरेत् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000637068, "chapter_id": 20637, "verse_number": "५-९६-६९", "content_sanskrit": "नद्यादिषु च नास्तिक्यस्तस्य स्यान्नरकालयः ।\nवैष्णवं जनमालोक्य नाभ्युत्थानं करोति यः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000637069, "chapter_id": 20637, "verse_number": "५-९६-७०", "content_sanskrit": "प्रणयादरतो विप्र स नरो नरकातिथिः ।\nकाष्ठैर्वा शंकुभिर्वापि शूलैरश्मभिरेव च ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000637070, "chapter_id": 20637, "verse_number": "५-९६-७१", "content_sanskrit": "ये मार्गांश्चैव रुंधंति ते वै निरयगामिनः ।\nआद्यं पुरुषमीशानं सर्वलोकमहेश्वरम् ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000637071, "chapter_id": 20637, "verse_number": "५-९६-७२", "content_sanskrit": "न चिन्तयंति ये विष्णुं ते वै निरयगामिनः ।\nक्षेत्रवृत्ति गृहच्छेदं प्रीतिच्छेदं च ये नराः ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000637072, "chapter_id": 20637, "verse_number": "५-९६-७३", "content_sanskrit": "आशाच्छेदं च कुर्वंति ते नरा नरकौकसः ।\nआगतान्भोजनार्थं च ब्राह्मणान्वृत्तिकर्शितान् ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000637073, "chapter_id": 20637, "verse_number": "५-९६-७४", "content_sanskrit": "यः परीक्षेत मूढात्मा स ज्ञेयो नरकातिथिः ।\nअनाथं वैष्णवं दीनं रोगार्तं वृद्धमेव च ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000637074, "chapter_id": 20637, "verse_number": "५-९६-७५", "content_sanskrit": "नानुकंपंति ये मूढास्ते वै निरयगामिनः ।\nनियमांस्तु समादाय ये पश्चादजितेंद्रियाः ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000637075, "chapter_id": 20637, "verse_number": "५-९६-७६", "content_sanskrit": "विलोपयंति तान्भूयस्ते वै निरयगामिनः ।\nशृणु विप्र यथा यांति नराः स्वर्गं दयालवः ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000637076, "chapter_id": 20637, "verse_number": "५-९६-७७", "content_sanskrit": "समासेनैव वक्ष्यामि किंचित्ते गौरवादहम् ।\nयेऽर्चयंति हरिं देवंजिष्णुं विष्णुं सनातनम् ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000637077, "chapter_id": 20637, "verse_number": "५-९६-७८", "content_sanskrit": "नारायणमजं कृष्णं विष्वक्सेनं चतुर्भुजम् ।\nध्यायंति पुरुषं दिव्यमच्युतं ये स्मरंति च ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000637078, "chapter_id": 20637, "verse_number": "५-९६-७९", "content_sanskrit": "लभंते तेऽच्युतस्थानं श्रुतिरेषा पुरातनी ।\nइदमेवहि मांगल्यमिदमेव धनार्जनम् ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000637079, "chapter_id": 20637, "verse_number": "५-९६-८०", "content_sanskrit": "जीवितस्य फलं चैतद्यद्दामोदरकीर्तनम् ।\nकीर्तनाद्देवदेवस्य विष्णोरमिततेजसः ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000637080, "chapter_id": 20637, "verse_number": "५-९६-८१", "content_sanskrit": "दुरितानि विलीयंते तमांसीव दिनोदये ।\nगाथां गायंति ये नित्यं वैष्णवीं श्रद्धयान्विताः ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000637081, "chapter_id": 20637, "verse_number": "५-९६-८२", "content_sanskrit": "स्वाध्यायनिरता नित्यं ते नराः स्वर्गगामिनः ।\nसर्वान्क्लेशान्परित्यज्य विष्णुमेव स्तुवंति ये ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000637082, "chapter_id": 20637, "verse_number": "५-९६-८३", "content_sanskrit": "स्वधर्मनिरता धीरास्ते नराः स्वर्गगामिनः ।\nवासुदेवजपासक्तानपि पापकृतो जनान् ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000637083, "chapter_id": 20637, "verse_number": "५-९६-८४", "content_sanskrit": "नोपसर्पन्ति तान्विप्र यमदूताश्च दारुणाः ।\nनान्यत्पश्यन्ति जंतूनां विहाय हरिकीर्तनम् ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000637084, "chapter_id": 20637, "verse_number": "५-९६-८५", "content_sanskrit": "सर्वपापप्रशमनं प्रायश्चित्तं द्विजोत्तम ।\nये याचिताः प्रहृष्यंति प्रियं दत्वा वदंति च ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000637085, "chapter_id": 20637, "verse_number": "५-९६-८६", "content_sanskrit": "त्यक्तदानफला ये च ते नराःस्वर्गगामिनः ।\nवर्जयंति दिवास्वापं नराः सर्वसहाश्च ये ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000637086, "chapter_id": 20637, "verse_number": "५-९६-८७", "content_sanskrit": "पर्वण्याश्रयभूता ये ते मर्त्याः स्वर्गगामिनः ।\nद्विषतामपि ये दोषान्न वदंति कदाचन ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000637087, "chapter_id": 20637, "verse_number": "५-९६-८८", "content_sanskrit": "कीर्तयंति गुणांश्चैव ते नराः स्वर्गगामिनः ।\nये परेषां श्रियं दृष्ट्वा न वितप्यंति मत्सरात् ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000637088, "chapter_id": 20637, "verse_number": "५-९६-८९", "content_sanskrit": "प्रहृष्टाश्चाभिनंदंति ते नराः स्वर्गगामिनः ।\nप्रवृत्तौ च निवृत्तौ च श्रुतिशास्त्रोक्तमेव च ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000637089, "chapter_id": 20637, "verse_number": "५-९६-९०", "content_sanskrit": "आदरंति प्रतीता ये ते नराः स्वर्गगामिनः ।\nयस्मिन्कस्मिन्कुले जाता दयावंतो यशस्विनः ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000637090, "chapter_id": 20637, "verse_number": "५-९६-९१", "content_sanskrit": "सानुक्रोशाः सदाचारास्ते नराः स्वर्गगामिनः ।\nये पूताः परदारांश्च कर्मणा मनसा गिरा ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000637091, "chapter_id": 20637, "verse_number": "५-९६-९२", "content_sanskrit": "रमयंति न सत्वस्थास्तेनराः स्वर्गगामिनः ।\nसदा कर्मयथोक्तेन कुर्वंति विहितानि च ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000637092, "chapter_id": 20637, "verse_number": "५-९६-९३", "content_sanskrit": "आत्मशक्तिं च विज्ञाय ते नराः स्वर्गगामिनः ।\nमनो वाक्कायिके धर्मे श्रद्धां यः कुरुते सदा ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000637093, "chapter_id": 20637, "verse_number": "५-९६-९४", "content_sanskrit": "साधूनां संमतो यश्च स भवेद्देवतातिथिः ।\nवचोवेगं मनोवेगं यो वेगमुदरोद्भवम् ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000637094, "chapter_id": 20637, "verse_number": "५-९६-९५", "content_sanskrit": "उपस्थवेगं सहते स स्वर्गी जायते नरः ।\nयेषां गुणेषु संतोषो वाणी येषां श्रुतं प्रति ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000637095, "chapter_id": 20637, "verse_number": "५-९६-९६", "content_sanskrit": "परमार्थे मतिर्येषां ते शिष्टाः स्वर्गगामिनः ।\nव्रतं रक्षंति ये कोपाच्छ्रियं रक्षंति मत्सरात् ॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000637096, "chapter_id": 20637, "verse_number": "५-९६-९७", "content_sanskrit": "विद्यां मानापमानाभ्यामात्मानं तु प्रमादतः ।\nमतिं रक्षंति ये लोभान्मनो रक्षंति कामतः ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000637097, "chapter_id": 20637, "verse_number": "५-९६-९८", "content_sanskrit": "धर्मं रक्षंति दुःसंगात्ते नराः स्वर्गगामिनः ।\nएकादश्यां च विधिवदुपवासपरायणाः ॥९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000637098, "chapter_id": 20637, "verse_number": "५-९६-९९", "content_sanskrit": "शुक्लेऽसिते च ये विप्र ते नराः स्वर्गगामिनः ।\nमातेव सर्वबालानामौषधं रोगिणा मिव ॥९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000637099, "chapter_id": 20637, "verse_number": "५-९६-१००", "content_sanskrit": "रक्षार्थं सर्वलोकानां निर्मितैकादशी तिथिः ।\nएकादशी समं किंचित्पादत्राणं न विद्यते ॥१०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000637100, "chapter_id": 20637, "verse_number": "५-९६-१०१", "content_sanskrit": "तामुपोष्य विधानेन पुरुषाः स्वर्गगामिनः ।\nएकादशेन्द्रियैः पापं यत्कृतं भवति द्विज ॥१०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000637101, "chapter_id": 20637, "verse_number": "५-९६-१०२", "content_sanskrit": "नरो निर्द्धूय तत्तूर्णं प्रीतः स्वर्गतिमान्भवेत् ।\nअश्वमेधसहस्राणि राजसूयशतानि च ॥१०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000637102, "chapter_id": 20637, "verse_number": "५-९६-१०३", "content_sanskrit": "एकादश्युपवासस्य कलां नार्हंति षोडशीम् ।\nएकतः क्रतवः सर्वे सर्वतीर्थतपांसि च ॥१०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000637103, "chapter_id": 20637, "verse_number": "५-९६-१०४", "content_sanskrit": "महादानादिदानानि व्रतं वैष्णवमेकतः ।\nवैष्णवव्रतजो धर्मो धर्मो यज्ञादिसंभवः ॥१०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000637104, "chapter_id": 20637, "verse_number": "५-९६-१०५", "content_sanskrit": "एकत्र तुलितौ धात्रा तत्र पूर्वो भवेद्गुरुः ।\nहरिवासर भक्तानामच्युतानंतभाषिणाम् ॥१०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000637105, "chapter_id": 20637, "verse_number": "५-९६-१०६", "content_sanskrit": "नाहं शास्ता विशेषेण तेभ्यो विप्र बिभेम्यहम् ।\nयेषां पुत्रश्च पौत्रश्च एकादश्यामुपोषितः ॥१०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000637106, "chapter_id": 20637, "verse_number": "५-९६-१०७", "content_sanskrit": "सहात्मना स पुरुषाञ्छतमुद्धरते बलात् ।\nउपोषणं ततः कुर्यात्पक्षयोरुभयोरपि ॥१०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000637107, "chapter_id": 20637, "verse_number": "५-९६-१०८", "content_sanskrit": "एकादश्यां स पुरुषो भुक्तिमुक्त्येकभाजनम् ।\nजया च विजया चैव जयंती पापनाशिनी ॥१०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000637108, "chapter_id": 20637, "verse_number": "५-९६-१०९", "content_sanskrit": "त्रिस्पृशा वंजुली चैव पक्षसंवर्धिनी वरा ।\nतिलदुग्धा परा ज्ञेया अखंडद्वादशी तथा ॥१०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000637109, "chapter_id": 20637, "verse_number": "५-९६-११०", "content_sanskrit": "मनोरथाख्या च परा भीमद्वादशिका तथा ।\nइत्येवमादयो भेदा द्वादश्याः संत्यनेकशः ॥११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000637110, "chapter_id": 20637, "verse_number": "५-९६-१११", "content_sanskrit": "व्रतेष्वेतेषु ये शक्ता ज्ञेयास्ते ब्रह्मणि स्थिताः ।\nश्रोतारो धर्मशास्त्राणां धर्मप्रत्यय संगताः ॥१११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000637111, "chapter_id": 20637, "verse_number": "५-९६-११२", "content_sanskrit": "प्रियंकराश्च बालानां स्वर्गलोकं व्रजंति ते ।\nमासिमास्येकदिवसे दर्शे श्राद्धव्रता नराः ॥११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000637112, "chapter_id": 20637, "verse_number": "५-९६-११३", "content_sanskrit": "तृप्यंति पितरो येषां ते धन्याः स्वर्गगामिनः ।\nभोजनेषूपपन्नेषु भोज्यं यच्छंति सादरात् ॥११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000637113, "chapter_id": 20637, "verse_number": "५-९६-११४", "content_sanskrit": "अभिन्नमुखरागेण शिष्टास्ते स्वर्गगामिनः ॥११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000637114, "chapter_id": 20637, "verse_number": "५-९६-११५", "content_sanskrit": "ये भक्तिमंतो मधुसूदनस्य नारायणस्याखिलनायकस्य ।\nसत्येन हीना रजसापि युक्ता गच्छंति ते नाकमनंतपुण्याः ॥११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000637115, "chapter_id": 20637, "verse_number": "५-९६-११६", "content_sanskrit": "वितस्तां यमुनां सीतां पुण्यां गोदावरीं नदीम् ।\nसेवंते ये शुभाचाराः स्नानदानपरायणाः ॥११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000637116, "chapter_id": 20637, "verse_number": "५-९६-११७", "content_sanskrit": "न ते पश्यंति पंथानं नरकस्य कदाचन ।\nये नर्मदायामिह शर्मदायां मज्जंति तुष्यंत्यपि दर्शनेन ॥११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000637117, "chapter_id": 20637, "verse_number": "५-९६-११८", "content_sanskrit": "विधूय पापानि महेशलोकं गच्छंति ते तत्र चिरं रमंते ॥११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000637118, "chapter_id": 20637, "verse_number": "५-९६-११९", "content_sanskrit": "स्नाताश्चर्मनदी तीरे त्रिरात्रं नियता नराः ।\nव्यासाश्रमे विशेषेण ते नरा नाकिनः स्मृताः ॥११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000637119, "chapter_id": 20637, "verse_number": "५-९६-१२०", "content_sanskrit": "गंगाजले प्रयागे च केदारे पुष्करे तथा ।\nव्यासाश्रमे प्रभासे च मृतास्ते विष्णुगामिनः ॥१२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000637120, "chapter_id": 20637, "verse_number": "५-९६-१२१", "content_sanskrit": "द्वारवत्यां कुरुक्षेत्रे योगाभ्यासेन वा मृताः ।\nहरिरित्यक्षरं वक्त्रे येषां ते न पुनर्भवाः ॥१२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000637121, "chapter_id": 20637, "verse_number": "५-९६-१२२", "content_sanskrit": "त्रिरात्रमपि ये विप्र द्वारवत्यां पुरि स्थिताः ।\nमज्जंति गोमती तीरे धन्यास्ते केशवप्रियाः ॥१२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000637122, "chapter_id": 20637, "verse_number": "५-९६-१२३", "content_sanskrit": "नरनारायणावासे त्रिरात्रं ये समाश्रिताः ।\nमर्त्यलोके च नंदायां धन्यास्ते केशवप्रियाः ॥१२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000637123, "chapter_id": 20637, "verse_number": "५-९६-१२४", "content_sanskrit": "षण्मासमुषिता विप्र पुरुषोत्तमसंनिधौ ।\nते नूनमच्युतात्मानो दृष्ट्वा स्युरघहारिणः ॥१२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000637124, "chapter_id": 20637, "verse_number": "५-९६-१२५", "content_sanskrit": "अनेक जन्मार्जितपुण्यतोये मज्जंति तोये मणिकर्णिकायाः ।\nनमंति विश्वेशमवाप्यकाशीं ते वै मयापीह भवंति वंद्याः ॥१२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000637125, "chapter_id": 20637, "verse_number": "५-९६-१२६", "content_sanskrit": "पूजयित्वा हरिं ये तु भूमौ दर्भ तिलैः सह ।\nतिलान्विकीर्य लोहं च दत्वा धेनुं पयस्विनीम् ॥१२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000637126, "chapter_id": 20637, "verse_number": "५-९६-१२७", "content_sanskrit": "ये मृता विधिवद्विप्र ते नराः स्वर्गगामिनः ।\nउत्पाद्य पुत्रान्संस्थाप्य पितृपैतामहे पदे ॥१२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000637127, "chapter_id": 20637, "verse_number": "५-९६-१२८", "content_sanskrit": "निर्ममा निरहंकारा ये मृतास्तेऽपि नाकिनः ।\nस्तैन्यान्निवृत्ताः सततं संतुष्टाः स्वधनेन च ॥१२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000637128, "chapter_id": 20637, "verse_number": "५-९६-१२९", "content_sanskrit": "स्वभाग्येनोपजीवंति ते नराः स्वर्गगामिनः ।\nश्लक्ष्णां वाणीं निराबाधां मधुरोपाय वर्जिताम् ॥१२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000637129, "chapter_id": 20637, "verse_number": "५-९६-१३०", "content_sanskrit": "स्वागतेनाभिभाषंते ते नराः स्वर्गगामिनः ।\nशुभानामशुभानां च कर्मणां फलसंचये ॥१३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000637130, "chapter_id": 20637, "verse_number": "५-९६-१३१", "content_sanskrit": "विपाकज्ञाश्च ये विप्र ते नराः स्वर्गगामिनः ।\nधनधर्मप्रवृत्तानां धर्ममार्गानुयायिनाम् ॥१३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000637131, "chapter_id": 20637, "verse_number": "५-९६-१३२", "content_sanskrit": "प्रोत्साहं वर्धयंते ये मोदंते दिवि ते नराः ।\nहेमंते वह्निदो यश्च तथा ग्रीष्मे जलप्रदः ॥१३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000637132, "chapter_id": 20637, "verse_number": "५-९६-१३३", "content_sanskrit": "वर्षा स्वाश्रमदाता च स स्वर्गे मोदते चिरम् ।\nपुण्यकालेषु सर्वेषु नित्य नैमित्तिकादिषु ॥१३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000637133, "chapter_id": 20637, "verse_number": "५-९६-१३४", "content_sanskrit": "भक्त्या यः कुरुते श्राद्धं स नूनं सुरलोकभाक् ॥१३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000637134, "chapter_id": 20637, "verse_number": "५-९६-१३५", "content_sanskrit": "दानं दरिद्रस्य विभोः क्षमित्वं यूनां तपो ज्ञानवतां च मौनम् ।\nइच्छानिवृत्तिश्च सुखोचितानां दया च भूतेषु दिवं नयंति ॥१३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000637135, "chapter_id": 20637, "verse_number": "५-९६-१३६", "content_sanskrit": "द्विविधः कर्मसंबंधः पापपुण्यसमुद्भवः ।\nसत्यमेव समाश्रित्य क्रियते ह्यत्र निर्णयः ॥१३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000637136, "chapter_id": 20637, "verse_number": "५-९६-१३७", "content_sanskrit": "तपोध्यानसमायुक्तं तारणाय भवांबुधेः ।\nपापं तु पतनायोक्तं सत्यमेव न संशयः ॥१३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000637137, "chapter_id": 20637, "verse_number": "५-९६-१३८", "content_sanskrit": "बलेन परिचारेण शौर्येणाभियुतस्य च ।\nपुण्यहीनस्य वै पुंसस्तद्बलादिव लीयते ॥१३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000637138, "chapter_id": 20637, "verse_number": "५-९६-१३९", "content_sanskrit": "उन्नता गिरि दुर्गेषु वृक्षाः संति सुपुष्टकाः ।\nपतंति वातवेगेन समूलास्तु घना अपि ॥१३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000637139, "chapter_id": 20637, "verse_number": "५-९६-१४०", "content_sanskrit": "सत्यधर्मविहीनास्ते तथा यांति यमालयम् ।\nसामान्यं सर्वजंतूंनां बलं धर्मस्तु केवलः ॥१४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000637140, "chapter_id": 20637, "verse_number": "५-९६-१४१", "content_sanskrit": "येन संतरते जंतुरिहलोके परत्र च ।\nमया सर्वमिदं सम्यक्स्वर्गमार्ग प्रदायकम् ॥१४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000637141, "chapter_id": 20637, "verse_number": "५-९६-१४२", "content_sanskrit": "समासेन समाख्यातं किं भूयः श्रोतुमिच्छसि ॥१४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]