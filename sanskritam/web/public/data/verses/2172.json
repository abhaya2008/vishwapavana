[{"id": 2053085, "chapter_id": 2172, "verse_number": "७-९९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2053086, "chapter_id": 2172, "verse_number": "७-९९-१", "content_sanskrit": "`वर्तमाने तदा युद्धे द्रोणस्य सह पाण्डुभिः।\nपरिवर्तमान आदित्ये तत्र सूर्ये च रश्मिभिः।\nरजसा कीर्यमाणाश्च मन्दीभूताश्च कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2053087, "chapter_id": 2172, "verse_number": "७-९९-२", "content_sanskrit": "तिष्ठतां युध्यमानानां पुनरावर्ततामपि।\nभज्यतां जयतां चैव जगाम तदहः शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2053088, "chapter_id": 2172, "verse_number": "७-९९-३", "content_sanskrit": "तथा तेषु विषक्तेषु सैन्येषु जयगृद्धिषु।\nअर्जुनो वासुदेवश्च सैन्धवायैव जग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2053089, "chapter_id": 2172, "verse_number": "७-९९-४", "content_sanskrit": "रथमार्गप्रमाणं तु कौन्तेयो निशितैः शरैः।\nचकार यं च पन्थानं ययौ तेन जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2053090, "chapter_id": 2172, "verse_number": "७-९९-५", "content_sanskrit": "यत्रयत्र रथो याति पाण्डवस्य महात्मनः।\nतत्रतत्रैव दीर्यन्ते सेनास्तव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2053091, "chapter_id": 2172, "verse_number": "७-९९-६", "content_sanskrit": "रथशिक्षां तु दाशार्हो दर्शयामास वीर्यवान्।\nउत्तमाधममध्यानि मण्डलानि विदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2053092, "chapter_id": 2172, "verse_number": "७-९९-७", "content_sanskrit": "ते तु नामाङ्किता बाणाः कालज्वलनसन्निभाः।\nस्नायुनद्धाः सुपर्वाणः पृथवो दीर्घगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2053093, "chapter_id": 2172, "verse_number": "७-९९-८", "content_sanskrit": "वैणवाश्चायसाश्चोग्रा ग्रसन्तो विविधानरीन्।\nरुधिरं पतगैः सार्धं प्राणिनां पपुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2053094, "chapter_id": 2172, "verse_number": "७-९९-९", "content_sanskrit": "रथस्थितोऽग्रतः क्रोशं यानस्यत्यर्जुनः शरान्।\nरथे क्रोशमतिक्रान्ते तस्य ते घ्नन्ति शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2053095, "chapter_id": 2172, "verse_number": "७-९९-१०", "content_sanskrit": "तार्क्ष्यमारुतरंहोभिर्वाजिभिः साधुवाहिभिः।\nयथाऽगच्छद्धृषीकेशः कृत्स्नं विस्मापयञ्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2053096, "chapter_id": 2172, "verse_number": "७-९९-११", "content_sanskrit": "न तथा गच्छति रथस्तपनस्य विशाम्पते।\nनेन्द्रस्य न तु रुद्रस्य नापि वैश्रवणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2053097, "chapter_id": 2172, "verse_number": "७-९९-१२", "content_sanskrit": "नान्यस्य समरे राजन्गतपूर्वस्तथा रथः।\nयथा ययावर्जुनस्य मनोभिप्रायशीघ्रगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2053098, "chapter_id": 2172, "verse_number": "७-९९-१३", "content_sanskrit": "प्रविश्य तु रणे राजन्केशवः परवीरहा।\nसेनामध्ये हयांस्तूर्णं चोदयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2053099, "chapter_id": 2172, "verse_number": "७-९९-१४", "content_sanskrit": "ततस्तस्य रथौघस्य मध्यं प्राप्य हयोत्तमाः।\nकृच्छ्रेणरथमूहुस्तं क्षुत्पिपासासमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2053100, "chapter_id": 2172, "verse_number": "७-९९-१५", "content_sanskrit": "क्षताश्च बहुभिः शस्त्रैर्युद्धशौण्डैरनेकशः।\nमण्डलानि विचित्राणि विचेरुस्ते मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2053101, "chapter_id": 2172, "verse_number": "७-९९-१६", "content_sanskrit": "हतानां वाजिनागानां रथानां च नरैः सह।\nउपरिष्टादतिक्रान्ताः शैलाभानां सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2053102, "chapter_id": 2172, "verse_number": "७-९९-१७", "content_sanskrit": "`श्रमेण महता युक्तास्ते हया वातरंहसः।\nमन्दवेगगता राजन्संवृत्तास्तत्र संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2053103, "chapter_id": 2172, "verse_number": "७-९९-१८", "content_sanskrit": "एतस्मिन्नन्तरे वीरावावन्त्यौ भ्रातरौ नृप।\nसहसेनौ समार्च्छेतां पाण्डवं क्लान्तवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2053104, "chapter_id": 2172, "verse_number": "७-९९-१९", "content_sanskrit": "तावर्जुनं चतुःषष्ट्या सप्तत्या च जनार्दनम्।\nशराणां च शतैरश्वानविध्येतां मुदान्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2053105, "chapter_id": 2172, "verse_number": "७-९९-२०", "content_sanskrit": "तावर्जुनो महाराज नवभिर्नतपर्वभिः।\nआजघान रणे क्रुद्धो मर्मज्ञो मर्मभेदिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2053106, "chapter_id": 2172, "verse_number": "७-९९-२१", "content_sanskrit": "ततस्तौ तु शरौघेण बीभत्सुं सहकेशवम्।\nआच्छादयेतां संरब्धौ सिंहनादं च चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2053107, "chapter_id": 2172, "verse_number": "७-९९-२२", "content_sanskrit": "तयोस्तु धनुषी मुष्टौ भल्लाभ्यां श्वेतवाहनः।\nचिच्छेद समरे तूर्णं भूय एव धनञ्जयः।\nअथान्यैर्विशिखैस्तूर्णं ध्वजौ च कनकोज्ज्वलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2053108, "chapter_id": 2172, "verse_number": "७-९९-२३", "content_sanskrit": "अथान्ये धनुषी राजन्प्रगृह्य समरे तदा।\nपाण्डवं भृशसङ्क्रुद्धावर्दयामासतुः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2053109, "chapter_id": 2172, "verse_number": "७-९९-२४", "content_sanskrit": "तयोस्तु भृशसङ्क्रुद्धः शराभ्यां पाण्डुनन्दनः।\nधनुषी चिच्छिदे तूर्णं भूय एव धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2053110, "chapter_id": 2172, "verse_number": "७-९९-२५", "content_sanskrit": "तथान्यैर्विशिखैस्तूर्णं रुक्मपुङ्खैः शिलाशितैः।\nजघानाश्वांस्तथा सूतौ पार्ष्णी च सपदानुगौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2053111, "chapter_id": 2172, "verse_number": "७-९९-२६", "content_sanskrit": "ज्येष्ठस्य च शिरः कायात्क्षुरप्रेण न्यकृन्तत।\nस पपात हतः पृथ्व्यां वातरुग्ण इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2053112, "chapter_id": 2172, "verse_number": "७-९९-२७", "content_sanskrit": "विन्दं तु निहतं दृष्ट्वा ह्यनुविन्दः प्रतापवान्।\nहताश्वं रथमुत्सृज्य गदां गृह्य महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2053113, "chapter_id": 2172, "verse_number": "७-९९-२८", "content_sanskrit": "अभ्यवर्तत सङ्ग्रामे भ्रातुर्वधमनुस्मरन्।\nगदया रथिनां श्रेष्ठो नृत्यन्निव महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2053114, "chapter_id": 2172, "verse_number": "७-९९-२९", "content_sanskrit": "अनुविन्दस्तु गदया ललाटे मधुसूदनम्।\nस्पष्ट्वा नाकम्पयत्क्रुद्धो मैनाकमिव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2053115, "chapter_id": 2172, "verse_number": "७-९९-३०", "content_sanskrit": "तस्यार्जुनः शरैः षड्भिर्ग्रीवां पादौ भुजौ शिरः।\nनिचकर्त स सञ्छन्नः पपाताद्रिचयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2053116, "chapter_id": 2172, "verse_number": "७-९९-३१", "content_sanskrit": "ततस्तौ निहतौ दृष्ट्वा तयो राजन्पदानुगाः।\nअभ्यद्रुवन्त सङ्क्रुद्धाः किरन्तः शतशः शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2053117, "chapter_id": 2172, "verse_number": "७-९९-३२", "content_sanskrit": "तानर्जुनः शरैस्तूर्णं निहत्य भरतर्षभ।\nव्यरोचत यथा वह्निर्दावं दग्ध्वा हिमात्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2053118, "chapter_id": 2172, "verse_number": "७-९९-३३", "content_sanskrit": "तयोः सेनामतिक्रम्य कृच्छ्रादिव धनञ्जयः।\nविबभौ जलदं हित्वा दिवाकर इवोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2053119, "chapter_id": 2172, "verse_number": "७-९९-३४", "content_sanskrit": "तं दृष्ट्वा कुरवस्त्रस्ताः प्रहृष्टाश्चाभवन्पुनः।\nअभ्यवर्तन्त पार्थं च समन्ताद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2053120, "chapter_id": 2172, "verse_number": "७-९९-३५", "content_sanskrit": "श्रान्तं चैनं समालक्ष्य ज्ञात्वा दूरे च सैन्धवम्।\nसिंहनादेन महता सर्वतः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2053121, "chapter_id": 2172, "verse_number": "७-९९-३६", "content_sanskrit": "तांस्तु दृष्ट्वा सुसंरब्धानुत्स्मयन्पुरुषर्भः।\nशनकैरिव दाशार्हमर्जुनो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2053122, "chapter_id": 2172, "verse_number": "७-९९-३७", "content_sanskrit": "शरार्दिताश्च ग्लानाश्च हया दूरे च सैन्धवः।\nकिमिहानन्तरं कार्यं साधिष्ठं तव रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2053123, "chapter_id": 2172, "verse_number": "७-९९-३८", "content_sanskrit": "ब्रूहि कृष्ण यथातत्त्वं त्वं हि प्राज्ञतमः सदा।\nभवन्नेत्रा रणे शत्रून्विजेष्यन्तीह पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2053124, "chapter_id": 2172, "verse_number": "७-९९-३९", "content_sanskrit": "मम त्वनन्तरं कृत्यं यद्वै तत्त्वं निबोध मे।\nहयान्विमुच्य हि सुखं विशल्यान्कुरु माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2053125, "chapter_id": 2172, "verse_number": "७-९९-४०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2053126, "chapter_id": 2172, "verse_number": "७-९९-४०", "content_sanskrit": "एवमुक्तस्तु पार्थेन केशवः प्रत्युवाच तम्।\nममाप्येतन्मतं पार्थ यदितं ते प्रभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2053127, "chapter_id": 2172, "verse_number": "७-९९-४१x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2053128, "chapter_id": 2172, "verse_number": "७-९९-४१", "content_sanskrit": "अहमावारयिष्यामि सर्वसैन्यानि केशव।\nत्वमप्यत्र यथान्यायं कुरु कार्यमनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2053129, "chapter_id": 2172, "verse_number": "७-९९-४२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2053130, "chapter_id": 2172, "verse_number": "७-९९-४२", "content_sanskrit": "सोऽवतीर्य रथोपस्थादसम्भ्रान्तो धनञ्जयः।\nगाण्डीवं धनुरादाय तस्थौ गिरिविवाचलः)॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2053131, "chapter_id": 2172, "verse_number": "७-९९-४३", "content_sanskrit": "तमभ्यधावन्क्रोशन्तः क्षत्रिया जयकाङ्क्षिणः।\nइदं छिद्रमिति ज्ञात्वा धरणीस्थं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2053132, "chapter_id": 2172, "verse_number": "७-९९-४४", "content_sanskrit": "तमेकं रथवंशेन महता पर्यवारयन्।\nविकर्षन्तश्च चापानि विसृजन्तश्च सायकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2053133, "chapter_id": 2172, "verse_number": "७-९९-४५", "content_sanskrit": "शस्त्राणि च विचित्राणि क्रुद्धास्तत्र व्यदर्शयन्।\nछादयन्तः शरैः पार्थं मेघा इव दिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2053134, "chapter_id": 2172, "verse_number": "७-९९-४६", "content_sanskrit": "अभ्यद्रवन्त वेगेन क्षत्रियाः क्षत्रियर्षभम्।\nनरसिंहं रथोदाराः सिंहं मत्ता इव द्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2053135, "chapter_id": 2172, "verse_number": "७-९९-४७", "content_sanskrit": "तत्र पार्थस्य भुजयोर्महद्बलमदृश्यत।\nयत्क्रुद्धो बहुलाः सेनाः सर्वतः समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2053136, "chapter_id": 2172, "verse_number": "७-९९-४८", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य द्विषतां सर्वतो विभुः।\nइषुभिर्बुभिस्तूर्णं सर्वानेव समावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2053137, "chapter_id": 2172, "verse_number": "७-९९-४९", "content_sanskrit": "तत्रान्तरिक्षे बाणानां प्रगाढानां विशाम्पते।\nसङ्घर्षेण महार्चिष्मान्पावकः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2053138, "chapter_id": 2172, "verse_number": "७-९९-५०", "content_sanskrit": "तत्रतत्र महेष्वासैः श्वसद्भिः शोणितोक्षितैः।\nहयैर्नागैश्च सम्भिन्नैर्नदद्भिश्चारिकर्शन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2053139, "chapter_id": 2172, "verse_number": "७-९९-५१", "content_sanskrit": "संरब्धैश्चारिभिर्वीरैः प्रार्थयद्भिर्जयं मृधे।\nएकस्थैर्बहुभिः क्रुद्धैरूष्मेव समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2053140, "chapter_id": 2172, "verse_number": "७-९९-५२", "content_sanskrit": "शरोर्मिणं ध्वजावर्तं नागनक्रं दुरत्ययम्।\nपदातिमत्स्यकलिलं शङ्खदुन्दुभिनिःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2053141, "chapter_id": 2172, "verse_number": "७-९९-५३", "content_sanskrit": "असङ्ख्येयमपारं च रजो नीरमतीव च।\nउष्णीषकमठं छत्रपताकाफेनमालिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2053142, "chapter_id": 2172, "verse_number": "७-९९-५४", "content_sanskrit": "रथसागरमक्षोभ्यं मातङ्गाङ्गशिलाचितम्।\nवेलाभूतस्तदा पार्थः पत्रिभिः समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2053143, "chapter_id": 2172, "verse_number": "७-९९-५५x", "content_sanskrit": "[धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2053144, "chapter_id": 2172, "verse_number": "७-९९-५५", "content_sanskrit": "अर्जुने धरणीं प्राप्ते हयहस्ते च केशवे।\nएतदन्तरमासाद्य कथं पार्थो न घातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2053145, "chapter_id": 2172, "verse_number": "७-९९-५६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2053146, "chapter_id": 2172, "verse_number": "७-९९-५६", "content_sanskrit": "सद्यः पार्थिव पार्थेन निरुद्धाः सर्वपार्थिवाः।\nरथस्था धरणीस्थेन वाक्यमच्छान्दसं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2053147, "chapter_id": 2172, "verse_number": "७-९९-५७", "content_sanskrit": "स पार्थः पार्थिवान्सर्वान्भूमिस्थोपि रथस्थितान्।\nएको निवारयामास लोभः सर्वगुणानिव॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2053148, "chapter_id": 2172, "verse_number": "७-९९-५८", "content_sanskrit": "ततो जनार्दनः सङ्ख्ये प्रियं पुरुषसत्तमम्।\nअसम्भ्रान्तो महाबाहुरर्जुनं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2053149, "chapter_id": 2172, "verse_number": "७-९९-५९", "content_sanskrit": "उदपानमिहाश्वानां नालमस्ति रणेऽर्जुन।\nपरीप्सन्ते जलं चेमे पेयं न त्ववगाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2053150, "chapter_id": 2172, "verse_number": "७-९९-६०", "content_sanskrit": "इदमस्तीत्यसम्भ्रान्तो ब्रुवन्नस्त्रेण मेदिनीम्।\nअभिहत्यार्जुनश्चक्रे वाजिपानं सरः शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2053151, "chapter_id": 2172, "verse_number": "७-९९-६१", "content_sanskrit": "[हंसकारण्डवाकीर्णं चक्रवाकोपशोभितम्।\nसुविस्तीर्णं प्रसन्नाम्भः प्रफुल्लवरपङ्कजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2053152, "chapter_id": 2172, "verse_number": "७-९९-६२", "content_sanskrit": "कूर्ममत्स्यगणाकीर्णमगाधमृषिसेवितम्।\nआगच्छन्नारदमुनिर्दर्शनार्थं कृतं क्षणात्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2053153, "chapter_id": 2172, "verse_number": "७-९९-६३", "content_sanskrit": "शरवंशं शरस्थूणं शराच्छादनमद्भुतम्।\nशरवेश्माकरोत्पार्थस्त्वष्टेवाद्भुतकर्मकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2053154, "chapter_id": 2172, "verse_number": "७-९९-६४", "content_sanskrit": "ततः प्रहस्य गोविन्दः साधुसाध्वित्यथाब्रवीत्।\nशरवेश्मनि पार्थेन कृते तस्मिन्महात्मना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2053155, "chapter_id": 2172, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकोनशततमोऽध्यायः॥ ९९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९९-१७ स्नायुनद्धाः सूक्ष्मचर्माग्रग्रथिताः॥ ५-९९-९ क्रोशं कोशमुद्दिश्य॥ ५-९९-२५ सूतौ सारथी। पाष्णीं पृष्ठरक्षौ॥ ५-९९-३० अद्रिचयो निरिशृङ्गम्॥ ५-९९-४९ प्रगाढानां व्यवगाढानाम्॥ ५-९९-५४ वेलाभूतो मर्यादारूपः॥ ५-९९-५५ कुण्डलितास्त्रयः श्लोकाः झ. पाठे एव वर्तन्ते॥ ५-९९-५९ अलं पर्याप्तम्॥ ५-९९-६० अभिहत्य खात्वा। दाजिपानं अश्वपानीयम्॥ ५-९९-६१ हंसकारण्डवाकीर्णमित्यादियोग्यतया वर्णनम्॥ कुण्डलितौ द्वौ श्लोकौ घ.झ.पाठयोरेव॥ ५-९९-६३ वंशः शालाधारकाष्ठम्। स्थूणा मध्यस्तम्भः॥ ५-९९-९९ एकोनशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]