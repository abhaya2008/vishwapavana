[{"id": 7005208000, "chapter_id": 25208, "verse_number": "७-३-६-१", "content_sanskrit": "पुलस्त्य उवाच ।\nततो गच्छेन्नृपश्रेष्ठ वसिष्ठं तपसां निधिम् ।\nयं दृष्ट्वा मानवः सम्यक्कृतार्थत्वमवाप्नुयात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005208001, "chapter_id": 25208, "verse_number": "७-३-६-२", "content_sanskrit": "तत्रास्ति जलसम्पूर्णं कुण्डं पापहरं नृणाम् ।\nतस्मिन्कुण्डे नृपश्रेष्ठ वसिष्ठेन महात्मना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005208002, "chapter_id": 25208, "verse_number": "७-३-६-३", "content_sanskrit": "गोमती च समानीता तपसा नृपसत्तम ।\nतत्र स्नातो नरः सम्यक्पातकै र्विप्रमुच्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005208003, "chapter_id": 25208, "verse_number": "७-३-६-४", "content_sanskrit": "ऋषिधान्येन यस्तत्र श्राद्धं नृप समाचरेत् ।\nस पितृंस्तारयेत्सर्वान्पक्षयोरुभयोरपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005208004, "chapter_id": 25208, "verse_number": "७-३-६-५", "content_sanskrit": "अत्र गाथा पुरा गीता नारदेन महात्म ना ।\nस्नात्वा पुण्योदके तत्र दृष्ट्वा तं मुनिसत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005208005, "chapter_id": 25208, "verse_number": "७-३-६-६", "content_sanskrit": "किं गयाश्राद्धदानेन किमन्यैर्मखविस्तरैः ।\nवसिष्ठस्याश्रमं प्राप्य यः श्राद्धं कुरुते नरः ।\nस पितॄंस्तारयेत्सर्वानात्मना नृपसत्तम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005208006, "chapter_id": 25208, "verse_number": "७-३-६-७", "content_sanskrit": "तत्रैवारुंधती साध्वी वसिष्ठस्य समीपतः ।\nपूजनीया विशेषेण सर्वकामप्रदा नृणाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005208007, "chapter_id": 25208, "verse_number": "७-३-६-८", "content_sanskrit": "बाल्ये वयसि यत्पापं वार्द्धके यौवनेऽपि वा ।\nवसिष्ठदर्शनात्सद्यो नराणां याति संक्षयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005208008, "chapter_id": 25208, "verse_number": "७-३-६-९", "content_sanskrit": "दीपं प्रयच्छते यस्तु वसिष्ठाग्रे समाहितः ।\nसुखसौभाग्यसंयुक्तस्तेजस्वी जायते नरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005208009, "chapter_id": 25208, "verse_number": "७-३-६-१०", "content_sanskrit": "उपवासपरो यस्तु तत्रैका रजनीं नयेत् ।\nस याति परमं स्थानं यत्र सप्तर्षयोऽमलाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005208010, "chapter_id": 25208, "verse_number": "७-३-६-११", "content_sanskrit": "त्रिरात्रिं कुरुते यस्तु वसिष्ठाग्रे समाहितः ।\nस याति च महर्लोकं जरामरणवर्जितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005208011, "chapter_id": 25208, "verse_number": "७-३-६-१२", "content_sanskrit": "यस्तु मासोपवासं च वसिष्ठाग्रे करोति च ।\nसोऽपि मुक्तिमवाप्नोति न याति स भवार्णवम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005208012, "chapter_id": 25208, "verse_number": "७-३-६-१३", "content_sanskrit": "श्रावणस्य सिते पक्षे पौर्णमास्यां समाहितः ।\nऋषिं तर्पयते यस्तु ब्रह्मलोकं स गच्छति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005208013, "chapter_id": 25208, "verse_number": "७-३-६-१४", "content_sanskrit": "वसिष्ठस्याग्रतो यस्तु गायत्र्यष्टशतं जपेत् ।\nआजन्ममरणात्पापात्सद्यो मुच्येत मानवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005208014, "chapter_id": 25208, "verse_number": "७-३-६-१५", "content_sanskrit": "वामदेवं यजेत्तत्र यदि श्रद्धासमन्वितः ।\nअग्निष्टोमफलं राजन्सद्यः प्राप्नोति मानवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005208015, "chapter_id": 25208, "verse_number": "७-३-६-१६", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन द्रष्टव्योऽसौ महामुनिः ।\nशुचिभिः श्रद्धया युक्तास्ते यास्यंति परं पदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005208016, "chapter_id": 25208, "verse_number": "७-३-६-१७", "content_sanskrit": "तस्मात्सर्वात्मना राजन्वामदेवं च पूजयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005208017, "chapter_id": 25208, "verse_number": "७-३-६-१८", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां सप्तमे प्रभासखण्डे तृतीयेऽर्बुदखंडे वसिष्ठाश्रममाहात्म्यवर्णनंनाम षष्ठोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]