[{"id": 2037442, "chapter_id": 1807, "verse_number": "५-५२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037443, "chapter_id": 1807, "verse_number": "५-५२-१", "content_sanskrit": "यस्य वै नानृता वाचः कदाचिदनुशुश्रुम ।\nत्रैलोक्यमपि तस्य स्याद्योद्धा यस्य धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037444, "chapter_id": 1807, "verse_number": "५-५२-२", "content_sanskrit": "तस्यैव च न पश्यामि युधि गाण्डीवधन्वनः।\nअनिशं चिन्तयानोऽपि यः प्रतीयाद्रथेन तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037445, "chapter_id": 1807, "verse_number": "५-५२-३", "content_sanskrit": "अस्यतः कर्णिनालीकान्मार्गणान्हृदयच्छिदः।\nप्रत्येता न समः कश्चिद्युधि गाण्डीवधन्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037446, "chapter_id": 1807, "verse_number": "५-५२-४", "content_sanskrit": "द्रोणाकर्णौ प्रतीयातां यदि वीरौ नरर्षभौ ।\nकृतास्त्रौ बलिनां श्रेष्ठौ समरेष्वपराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037447, "chapter_id": 1807, "verse_number": "५-५२-५", "content_sanskrit": "महान्स्यात्संशयो लोके न त्वस्ति विजयो मम।\nघृणी कर्णः प्रमादी च आचार्यः स्थविरो गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037448, "chapter_id": 1807, "verse_number": "५-५२-६", "content_sanskrit": "समर्थो बलवान्पार्थो दृढधन्वा जितक्लमः ।\nभवेत्सुतुमुलं युद्धं सर्वशोऽप्यपराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037449, "chapter_id": 1807, "verse_number": "५-५२-७", "content_sanskrit": "सर्वे ह्यस्त्रविदः शूराः सर्वे प्राप्ता महद्यशः ।\nअपि सर्वामरैश्वर्यं त्यजेयुर्न पुनर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037450, "chapter_id": 1807, "verse_number": "५-५२-८", "content_sanskrit": "वधे नूनं भवेच्छान्तिस्तयोर्वा फाल्गुनस्य च।\nन तु हन्तार्जुनस्यास्ति जेता चास्य न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037451, "chapter_id": 1807, "verse_number": "५-५२-९", "content_sanskrit": "मन्युस्तस्य कथं शाम्येन्मन्दान्प्रति य उत्थितः ।\nअन्येऽप्यस्त्राणि जानन्ति जीयन्ते च जयन्ति च।\nएकान्तविजयस्त्वेव श्रूयते फाल्गुनस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037452, "chapter_id": 1807, "verse_number": "५-५२-१०", "content_sanskrit": "त्रयस्त्रिंशत्समाहूय खाण्डवेऽग्निमतर्पयत्।\nजिगाय च सुरान्सर्वान्नास्य विद्मः पराजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037453, "chapter_id": 1807, "verse_number": "५-५२-११", "content_sanskrit": "यस्य यन्ता हृषीकेशः शीलवृत्तसमो युधि।\nध्रुवस्तस्य जयस्तात यथेन्द्रस्य जयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037454, "chapter_id": 1807, "verse_number": "५-५२-१२", "content_sanskrit": "कृष्णावेकरथे यत्तावधिज्यं गाण्डिवं धनुः।\nयुगपत्रीणि तेजांसि समेतान्यनुशुश्रुम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037455, "chapter_id": 1807, "verse_number": "५-५२-१३", "content_sanskrit": "नैवास्ति नो धनुस्तदृङ्व योद्धा न च सारथिः ।\nतच्च मन्दा न जानन्ति दुर्योधनवशानुगाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037456, "chapter_id": 1807, "verse_number": "५-५२-१४", "content_sanskrit": "शेषयेदशनिर्दीप्तो विपतन्मूर्ध्नि सञ्जय।\nन तु शेषं शरास्तात कुर्युरस्ताः किरीटिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037457, "chapter_id": 1807, "verse_number": "५-५२-१५", "content_sanskrit": "अपि चास्यन्निवाभाति निघ्नन्निव धनञ्जयः ।\nउद्धरन्निव कायेभ्यः शिरांसि शरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037458, "chapter_id": 1807, "verse_number": "५-५२-१६", "content_sanskrit": "अपि बाणमयं तेजः प्रदीप्तमिव सर्वतः ।\nगाण्डीवोत्थं दहेताजौ पुत्राणां मम वाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037459, "chapter_id": 1807, "verse_number": "५-५२-१७", "content_sanskrit": "अपि सा रथघोषेण भयार्ता सव्यसाचिनः ।\nवित्रस्ता बहुधा सेना भारती प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037460, "chapter_id": 1807, "verse_number": "५-५२-१८", "content_sanskrit": "यथा कक्षं महानग्निः प्रदहेत्सर्वतश्चरन्।\nमहार्चिरनिलोद्धूतस्तद्वद्धक्ष्यति मामकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037461, "chapter_id": 1807, "verse_number": "५-५२-१९", "content_sanskrit": "यदोद्वमन्निशितान्बाणसङ्घां-\nस्तानाततायी समरे किरीटी।\nसृष्टोऽन्तकः सर्वहरो विधात्रा\nयथा भवेत्तद्वदपारणीयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037462, "chapter_id": 1807, "verse_number": "५-५२-२०", "content_sanskrit": "यदा हयभीक्ष्णं सुबुहून्प्रकारान्\nश्रोतास्मि तानावसथे कुरूणाम्।\nतेषां समन्ताच्च तथा रणाग्रे\nक्षयः किलायं भरतानुपैति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037463, "chapter_id": 1807, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि द्विपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]