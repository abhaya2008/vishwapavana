[{"id": 900004421, "chapter_id": 8341, "verse_number": "2.1", "content_sanskrit": "लक्ष्मीपतेः पदाम्भोजयुगं नत्वा गुरोरपि । करिष्ये तत्वसङ्ख्यानव्याख्यानं नातिविस्तरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004422, "chapter_id": 8341, "verse_number": "2.2", "content_sanskrit": "मुमुक्षुणा खलु परमात्मा जगदुदयादिनिमित्तत्वेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004423, "chapter_id": 8341, "verse_number": "2.3", "content_sanskrit": "ननु प्रकरणादौ मङ्गलं किमपि कस्मान्नानुष्ठितम् ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004424, "chapter_id": 8341, "verse_number": "2.4", "content_sanskrit": "स्वतन्त्रमस्वतन्त्रं च द्विविधं तत्वमिष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004425, "chapter_id": 8341, "verse_number": "2.5", "content_sanskrit": "ननु शुक्तिरजतादिकं कथं न तत्वम् ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004426, "chapter_id": 8341, "verse_number": "2.6", "content_sanskrit": "एतेन भाविपाकरागः कुम्भः श्यामतादशायां रक्तपित्तिना ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004427, "chapter_id": 8341, "verse_number": "2.7", "content_sanskrit": "तद्द्विविधं स्वतन्त्रमस्वतन्त्रं चेति, इति इतिशब्दाध्याहारेण योज्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004428, "chapter_id": 8341, "verse_number": "2.8", "content_sanskrit": "तदुपपादनायोक्तं इष्यते इति । प्रामाणिकैरिति शेषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004429, "chapter_id": 8341, "verse_number": "2.9", "content_sanskrit": "यदि चैकमेव तत्वं तदा भेदोपलम्भविरोधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004430, "chapter_id": 8341, "verse_number": "2.10", "content_sanskrit": "यद्यपि भावाभावतया वा चेतनाचेतनत्वेन वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004431, "chapter_id": 8341, "verse_number": "2.11", "content_sanskrit": "स्वतन्त्रो भगवान्विष्णुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004432, "chapter_id": 8341, "verse_number": "2.12", "content_sanskrit": "भावाभावौ द्विधेतरत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004433, "chapter_id": 8341, "verse_number": "2.13", "content_sanskrit": "ननु स्वतन्त्रतत्वं भावोऽभावोऽन्यद्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004434, "chapter_id": 8341, "verse_number": "2.14", "content_sanskrit": "अथ अस्वतन्त्रं चेतनत्वादिनैव विभज्यताम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004435, "chapter_id": 8341, "verse_number": "2.15", "content_sanskrit": "अभाव एव नास्तीति केचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004436, "chapter_id": 8341, "verse_number": "2.16", "content_sanskrit": "प्राक्प्रध्वंससदात्वेन त्रिविधोऽभाव इष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004437, "chapter_id": 8341, "verse_number": "2.17", "content_sanskrit": "नचैवं प्रागभावप्रध्वंसः प्रध्वंसप्रागभाव इति प्रवाहौ प्रसज्येते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004438, "chapter_id": 8341, "verse_number": "2.18", "content_sanskrit": "एके ब्रुवते, संसर्गाभावोऽन्योन्याभावश्चेति द्विविध एवाभाव इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004439, "chapter_id": 8341, "verse_number": "2.19", "content_sanskrit": "चेतनाचेतनत्वेन भावोऽपि द्विविधो मतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004440, "chapter_id": 8341, "verse_number": "2.20", "content_sanskrit": "दुःखस्पृष्टं तदस्पृष्टमिति द्वेधैव चेतनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900004441, "chapter_id": 8341, "verse_number": "2.21", "content_sanskrit": "नित्यादुःखा रमाऽन्ये तु स्पृष्टदुःखाः समस्तशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900004442, "chapter_id": 8341, "verse_number": "2.22", "content_sanskrit": "स्पृष्टदुःखा विमुक्ताश्च दुःखसंस्था इति द्विधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900004443, "chapter_id": 8341, "verse_number": "2.23", "content_sanskrit": "दुःखसंस्था मुक्तियोग्या अयोग्या इति च द्विधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900004444, "chapter_id": 8341, "verse_number": "2.24", "content_sanskrit": "देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900004445, "chapter_id": 8341, "verse_number": "2.25", "content_sanskrit": "एवं विमुक्तियोग्याश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900004446, "chapter_id": 8341, "verse_number": "2.26", "content_sanskrit": "तमोगाः सृतिसंस्थिताः इति द्विधा मुक्त्ययोग्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900004447, "chapter_id": 8341, "verse_number": "2.27", "content_sanskrit": "दैत्यरक्षःपिशाचकाः । मर्त्याधमाश्चतुर्धैव तमोयोग्याः प्रकीर्तिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900004448, "chapter_id": 8341, "verse_number": "2.28", "content_sanskrit": "ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900004449, "chapter_id": 8341, "verse_number": "2.29", "content_sanskrit": "नित्यानित्यविभागेन त्रिधैवाचेतनं मतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900004450, "chapter_id": 8341, "verse_number": "2.30", "content_sanskrit": "केचित्सर्वं क्षणिकं मन्यमाना नित्यं न मन्यन्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900004451, "chapter_id": 8341, "verse_number": "2.31", "content_sanskrit": "नित्या वेदाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900004452, "chapter_id": 8341, "verse_number": "2.32", "content_sanskrit": "पुराणाद्याः कालः प्रकृतिरेव च । नित्यानित्यं त्रिधा प्रोक्तं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900004453, "chapter_id": 8341, "verse_number": "2.33", "content_sanskrit": "नन्वेवं सत्यवान्तरभेदैर्विधान्तरमप्युत्प्रेक्षितुं शक्यमित्यत एवेत्युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900004454, "chapter_id": 8341, "verse_number": "2.34", "content_sanskrit": "अथ वा ‘पुराणानि तदर्थानि’ ‘सर्वे निमेषा जज्ञिरे’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900004455, "chapter_id": 8341, "verse_number": "2.35", "content_sanskrit": "अनित्यं द्विविधं मतम् असंसृष्टं च संसृष्टं...", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900004456, "chapter_id": 8341, "verse_number": "2.36", "content_sanskrit": "असंसृष्टं महानहम् । बुद्धिर्मनः खानि दश मात्रा भूतानि पञ्च च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900004457, "chapter_id": 8341, "verse_number": "2.37", "content_sanskrit": "केचिन्महदादिस्वरूपमेव नाभ्युपच्छन्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900004458, "chapter_id": 8341, "verse_number": "2.38", "content_sanskrit": "विष्णुनाऽस्य समस्तस्य समासव्यासयोगतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]