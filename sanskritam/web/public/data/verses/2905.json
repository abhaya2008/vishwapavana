[{"id": 2089049, "chapter_id": 2905, "verse_number": "१३-३५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकिं कर्तव्यं मनुष्येण लोकयात्राहितार्थिना।\nकथं वै लोकयात्रां तु किंशीलश्च समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089050, "chapter_id": 2905, "verse_number": "१३-३५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089051, "chapter_id": 2905, "verse_number": "१३-३५-२", "content_sanskrit": "`देवे नारायणे भक्तिः शंकरे साधुपूजया।\nध्यानेनाथ जपः कार्यः स्वधर्मैः शुचिचेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089052, "chapter_id": 2905, "verse_number": "१३-३५-३", "content_sanskrit": "कायेन त्रिविधं कर्म वाचा चापि चतुर्विधम्।\nमनसा त्रिविधं चैव दश कर्मपथांस्त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089053, "chapter_id": 2905, "verse_number": "१३-३५-४", "content_sanskrit": "प्राणातिपातः स्तैन्यं च परदाराभिमर्शनम्।\nत्रीणि पापानि कायेन सर्वतः परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089054, "chapter_id": 2905, "verse_number": "१३-३५-५", "content_sanskrit": "असत्प्रलापं पारुष्यं पैशुन्यमनृतं तथा।\nचत्वारि वाचा राजेन्द्र न जल्पेन्नानुचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089055, "chapter_id": 2905, "verse_number": "१३-३५-६", "content_sanskrit": "अनभिध्या परखेषु सर्वसत्वेषु सौहृदम्।\nकर्मणां फलमस्तीति त्रिविधं मनसा चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089056, "chapter_id": 2905, "verse_number": "१३-३५-७", "content_sanskrit": "तस्माद्वाक्वायमनसा नाचरेदशुभं नरः।\nशुभान्येवाचरँल्लोके भक्तो नारायणस्य हि।\nतस्यैव तु पदं सूक्ष्मं प्रसादादश्नुयात्परम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089057, "chapter_id": 2905, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चत्रिंशोऽध्यायः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]