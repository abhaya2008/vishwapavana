[{"id": 50003958, "chapter_id": 10743, "verse_number": "1", "content_sanskrit": "नासतो विद्यते भावो नाभावो विद्यते सतः। उभयोरपि दृष्टोऽन्तस्त्वनयोस्तत्त्वदर्शिभिः॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50003959, "chapter_id": 10743, "verse_number": "2", "content_sanskrit": "“असन्नेव स भवति। असद् ब्रह्मेति वेद चेत्” (कुत्र: तैत्तिरीयोपनिषत् २/६) इत्यादेश्च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50003960, "chapter_id": 10743, "verse_number": "3", "content_sanskrit": "अन्तः निर्णयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50003961, "chapter_id": 10743, "verse_number": "4", "content_sanskrit": "॥ भास्करव्याख्याननिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50003962, "chapter_id": 10743, "verse_number": "5", "content_sanskrit": "॥ मायावादिव्याख्याननिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]