[{"id": 5000518000, "chapter_id": 9518, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकादशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000518001, "chapter_id": 9518, "verse_number": "६-१११-१", "content_sanskrit": "तासां विलपमानानां तदा राक्षसयोषिताम्।\nज्येष्ठपत्नी प्रिया दीना भर्तारं समुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000518002, "chapter_id": 9518, "verse_number": "६-१११-२", "content_sanskrit": "दशग्रीवं हतं दृष्ट्वा रामेणाचिन्त्यकर्मणा।\nपतिं मन्दोदरी तत्र कृपणा पर्यदेवयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000518003, "chapter_id": 9518, "verse_number": "६-१११-३", "content_sanskrit": "ननु नाम महाबाहो तव वैश्रवणानुज।\nक्रुद्धस्य प्रमुखे स्थातुं त्रस्यत्यपि पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000518004, "chapter_id": 9518, "verse_number": "६-१११-४", "content_sanskrit": "ऋषयश्च महान्तोऽपि गन्धर्वाश्च यशस्विनः।\nननु नाम तवोद्वेगाच्चारणाश्च दिशो गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000518005, "chapter_id": 9518, "verse_number": "६-१११-५", "content_sanskrit": "स त्वं मानुषमात्रेण रामेण युधि निर्जितः।\nन व्यपत्रपसे राजन् किमिदं राक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000518006, "chapter_id": 9518, "verse_number": "६-१११-६", "content_sanskrit": "कथं त्रैलोक्यमाक्रम्य श्रिया वीर्येण चान्वितम्।\nअविषह्यं जघान त्वां मानुषो वनगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000518007, "chapter_id": 9518, "verse_number": "६-१११-७", "content_sanskrit": "मानुषाणामविषये चरतः कामरूपिणः।\nविनाशस्तव रामेण संयुगे नोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000518008, "chapter_id": 9518, "verse_number": "६-१११-८", "content_sanskrit": "न चैतत् कर्म रामस्य श्रद्दधामि चमूमुखे।\nसर्वतः समुपेतस्य तव तेनाभिमर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000518009, "chapter_id": 9518, "verse_number": "६-१११-९", "content_sanskrit": "अथवा रामरूपेण कृतान्तः स्वयमागतः।\nमायां तव विनाशाय विधायाप्रतितर्किताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000518010, "chapter_id": 9518, "verse_number": "६-१११-१०", "content_sanskrit": "अथवा वासवेन त्वं धर्षितोऽसि महाबल।\nवासवस्य तु का शक्तिस्त्वां द्रष्टुमपि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000518011, "chapter_id": 9518, "verse_number": "६-१११-११", "content_sanskrit": "महाबलं महावीर्यं देवशत्रुं महौजसम्।\nव्यक्तमेष महायोगी परमात्मा सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000518012, "chapter_id": 9518, "verse_number": "६-१११-१२", "content_sanskrit": "अनादिमध्यनिधनो महतः परमो महान्।\nतमसः परमो धाता शङ्खचक्रगदाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000518013, "chapter_id": 9518, "verse_number": "६-१११-१३", "content_sanskrit": "श्रीवत्सवक्षा नित्यश्रीरजय्यः शाश्वतो ध्रुवः।\nमानुषं रूपमास्थाय विष्णुः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000518014, "chapter_id": 9518, "verse_number": "६-१११-१४", "content_sanskrit": "सर्वैः परिवृतो देवैर्वानरत्वमुपागतैः।\nसर्वलोकेश्वरः श्रीमाँल्लोकानां हितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000518015, "chapter_id": 9518, "verse_number": "६-१११-१५", "content_sanskrit": "स राक्षसपरीवारं देवशत्रुं भयावहम्।\nइन्द्रियाणि पुरा जित्वा जितं त्रिभुवनं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000518016, "chapter_id": 9518, "verse_number": "६-१११-१६", "content_sanskrit": "स्मरद्भिरिव तद् वैरमिन्द्रियैरेव निर्जितः।\nयदैव हि जनस्थाने राक्षसैर्बहुभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000518017, "chapter_id": 9518, "verse_number": "६-१११-१७", "content_sanskrit": "खरस्तु निहतो भ्राता तदा रामो न मानुषः।\nयदैव नगरीं लङ्कां दुष्प्रवेशां सुरैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000518018, "chapter_id": 9518, "verse_number": "६-१११-१८", "content_sanskrit": "प्रविष्टो हनुमान् वीर्यात् तदैव व्यथिता वयम्।\nक्रियतामविरोधश्च राघवेणेति यन्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000518019, "chapter_id": 9518, "verse_number": "६-१११-१९", "content_sanskrit": "उच्यमानो न गृह्णासि तस्येयं व्युष्टिरागता।\nअकस्माच्चाभिकामोऽसि सीतां राक्षसपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000518020, "chapter_id": 9518, "verse_number": "६-१११-२०", "content_sanskrit": "ऐश्वर्यस्य विनाशाय देहस्य स्वजनस्य च।\nअरुन्धत्या विशिष्टां तां रोहिण्याश्चापि दुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000518021, "chapter_id": 9518, "verse_number": "६-१११-२१", "content_sanskrit": "सीतां धर्षयता मान्यां त्वया ह्यसदृशं कृतम्।\nवसुधाया हि वसुधां श्रियाः श्रीं भर्तृवत्सलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000518022, "chapter_id": 9518, "verse_number": "६-१११-२२", "content_sanskrit": "सीतां सर्वानवद्याङ्गीमरण्ये विजने शुभाम्।\nआनयित्वा तु तां दीनां छद्मनाऽऽत्मस्वदूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000518023, "chapter_id": 9518, "verse_number": "६-१११-२३", "content_sanskrit": "अप्राप्य तं चैव कामं मैथिलीसंगमे कृतम्।\nपतिव्रतायास्तपसा नूनं दग्धोऽसि मे प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000518024, "chapter_id": 9518, "verse_number": "६-१११-२४", "content_sanskrit": "तदैव यन्न दग्धस्त्वं धर्षयंस्तनुमध्यमाम्।\nदेवा बिभ्यति ते सर्वे सेन्द्राः साग्निपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000518025, "chapter_id": 9518, "verse_number": "६-१११-२५", "content_sanskrit": "अवश्यमेव लभते फलं पापस्य कर्मणः।\nभर्तः पर्यागते काले कर्ता नास्त्यत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000518026, "chapter_id": 9518, "verse_number": "६-१११-२६", "content_sanskrit": "शुभकृच्छुभमाप्नोति पापकृत् पापमश्नुते।\nविभीषणः सुखं प्राप्तस्त्वं प्राप्तः पापमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000518027, "chapter_id": 9518, "verse_number": "६-१११-२७", "content_sanskrit": "सन्त्यन्याः प्रमदास्तुभ्यं रूपेणाभ्यधिकास्ततः।\nअनङ्गवशमापन्नस्त्वं तु मोहान्न बुद्ध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000518028, "chapter_id": 9518, "verse_number": "६-१११-२८", "content_sanskrit": "न कुलेन न रूपेण न दाक्षिण्येन मैथिली।\nमयाधिका वा तुल्या वा तत् तु मोहान्न बुद्ध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000518029, "chapter_id": 9518, "verse_number": "६-१११-२९", "content_sanskrit": "सर्वदा सर्वभूतानां नास्ति मृत्युरलक्षणः।\nतव तद्वदयं मृत्युर्मैथिलीकृतलक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000518030, "chapter_id": 9518, "verse_number": "६-१११-३०", "content_sanskrit": "सीतानिमित्तजो मृत्युस्त्वया दूरादुपाहृतः।\nमैथिली सह रामेण विशोका विहरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000518031, "chapter_id": 9518, "verse_number": "६-१११-३१", "content_sanskrit": "अल्पपुण्या त्वहं घोरे पतिता शोकसागरे।\nकैलासे मन्दरे मेरौ तथा चैत्ररथे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000518032, "chapter_id": 9518, "verse_number": "६-१११-३२", "content_sanskrit": "देवोद्यानेषु सर्वेषु विहृत्य सहिता त्वया।\nविमानेनानुरूपेण या याम्यतुलया श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000518033, "chapter_id": 9518, "verse_number": "६-१११-३३", "content_sanskrit": "पश्यन्ती विविधान् देशांस्तांस्तांश्चित्रस्रगम्बरा।\nभ्रंशिता कामभोगेभ्यः सास्मि वीर वधात् तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000518034, "chapter_id": 9518, "verse_number": "६-१११-३४", "content_sanskrit": "सैवान्येवास्मि संवृत्ता धिग्राज्ञां चञ्चलां श्रियम्।\nहा राजन् सुकुमारं ते सुभ्रु सुत्वक्समुन्नसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000518035, "chapter_id": 9518, "verse_number": "६-१११-३५", "content_sanskrit": "कान्तिश्रीद्युतिभिस्तुल्यमिन्दुपद्मदिवाकरैः।\nकिरीटकूटोज्ज्वलितं ताम्रास्यं दीप्तकुण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000518036, "chapter_id": 9518, "verse_number": "६-१११-३६", "content_sanskrit": "मदव्याकुललोलाक्षं भूत्वा यत्पानभूमिषु।\nविविधस्रग्धरं चारु वल्गुस्मितकथं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000518037, "chapter_id": 9518, "verse_number": "६-१११-३७", "content_sanskrit": "तदेवाद्य तवैवं हि वक्त्रं न भ्राजते प्रभो।\nरामसायकनिर्भिन्नं रक्तं रुधिरविस्रवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000518038, "chapter_id": 9518, "verse_number": "६-१११-३८", "content_sanskrit": "विशीर्णमेदोमस्तिष्कं रूक्षं स्यन्दनरेणुभिः।\nहा पश्चिमा मे सम्प्राप्ता दशा वैधव्यदायिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000518039, "chapter_id": 9518, "verse_number": "६-१११-३९", "content_sanskrit": "या मयाऽऽसीन्न सम्बुद्धा कदाचिदपि मन्दया।\nपिता दानवराजो मे भर्ता मे राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000518040, "chapter_id": 9518, "verse_number": "६-१११-४०", "content_sanskrit": "पुत्रो मे शक्रनिर्जेता इत्यहं गर्विता भृशम्।\nदृप्तारिमथनाः क्रूराः प्रख्यातबलपौरुषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000518041, "chapter_id": 9518, "verse_number": "६-१११-४१", "content_sanskrit": "अकुतश्चिद्भया नाथा ममेत्यासीन्मतिर्ध्रुवा।\nतेषामेवंप्रभावाणां युष्माकं राक्षसर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000518042, "chapter_id": 9518, "verse_number": "६-१११-४२", "content_sanskrit": "कथं भयमसम्बुद्धं मानुषादिदमागतम्।\nस्निग्धेन्द्रनीलनीलं तु प्रांशुशैलोपमं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000518043, "chapter_id": 9518, "verse_number": "६-१११-४३", "content_sanskrit": "केयूराङ्गदवैदूर्यमुक्ताहारस्रगुज्ज्वलम्।\nकान्तं विहारेष्वधिकं दीप्तं संग्रामभूमिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000518044, "chapter_id": 9518, "verse_number": "६-१११-४४", "content_sanskrit": "भात्याभरणभाभिर्यद् विद्युद्भिरिव तोयदः।\nतदेवाद्य शरीरं ते तीक्ष्णैर्नैकशरैश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000518045, "chapter_id": 9518, "verse_number": "६-१११-४५", "content_sanskrit": "पुनर्दुर्लभसंस्पर्शं परिष्वक्तुं न शक्यते।\nश्वाविधः शललैर्यद्वद् बाणैर्लग्नैर्निरन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000518046, "chapter_id": 9518, "verse_number": "६-१११-४६", "content_sanskrit": "स्वर्पितैर्मर्मसु भृशं संछिन्नस्नायुबन्धनम्।\nक्षितौ निपतितं राजन् श्यामं वै रुधिरच्छवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000518047, "chapter_id": 9518, "verse_number": "६-१११-४७", "content_sanskrit": "वज्रप्रहाराभिहतो विकीर्ण इव पर्वतः।\nहा स्वप्नः सत्यमेवेदं त्वं रामेण कथं हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000518048, "chapter_id": 9518, "verse_number": "६-१११-४८", "content_sanskrit": "त्वं मृत्योरपि मृत्युः स्याः कथं मृत्युवशं गतः।\nत्रैलोक्यवसुभोक्तारं त्रैलोक्योद्वेगदं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000518049, "chapter_id": 9518, "verse_number": "६-१११-४९", "content_sanskrit": "जेतारं लोकपालानां क्षेप्तारं शंकरस्य च।\nदृप्तानां निग्रहीतारमाविष्कृतपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000518050, "chapter_id": 9518, "verse_number": "६-१११-५०", "content_sanskrit": "लोकक्षोभयितारं च साधुभूतविदारणम्।\nओजसा दृप्तवाक्यानां वक्तारं रिपुसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000518051, "chapter_id": 9518, "verse_number": "६-१११-५१", "content_sanskrit": "स्वयूथभृत्यगोप्तारं हन्तारं भीमकर्मणाम्।\nहन्तारं दानवेन्द्राणां यक्षाणां च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000518052, "chapter_id": 9518, "verse_number": "६-१११-५२", "content_sanskrit": "निवातकवचानां तु निग्रहीतारमाहवे।\nनैकयज्ञविलोप्तारं त्रातारं स्वजनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000518053, "chapter_id": 9518, "verse_number": "६-१११-५३", "content_sanskrit": "धर्मव्यवस्थाभेत्तारं मायास्रष्टारमाहवे।\nदेवासुरनृकन्यानामाहर्तारं ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000518054, "chapter_id": 9518, "verse_number": "६-१११-५४", "content_sanskrit": "शत्रुस्त्रीशोकदातारं नेतारं स्वजनस्य च।\nलङ्काद्वीपस्य गोप्तारं कर्तारं भीमकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000518055, "chapter_id": 9518, "verse_number": "६-१११-५५", "content_sanskrit": "अस्माकं कामभोगानां दातारं रथिनां वरम्।\nएवंप्रभावं भर्तारं दृष्ट्वा रामेण पातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000518056, "chapter_id": 9518, "verse_number": "६-१११-५६", "content_sanskrit": "स्थिरास्मि या देहमिमं धारयामि हतप्रिया।\nशयनेषु महार्हेषु शयित्वा राक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000518057, "chapter_id": 9518, "verse_number": "६-१११-५७", "content_sanskrit": "इह कस्मात् प्रसुप्तोऽसि धरण्यां रेणुगुण्ठितः।\nयदा मे तनयः शस्तो लक्ष्मणेनेन्द्रजिद् युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000518058, "chapter_id": 9518, "verse_number": "६-१११-५८", "content_sanskrit": "तदा त्वभिहता तीव्रमद्य त्वस्मिन् निपातिता।\nसाहं बन्धुजनैर्हीना हीना नाथेन च त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000518059, "chapter_id": 9518, "verse_number": "६-१११-५९", "content_sanskrit": "विहीना कामभोगैश्च शोचिष्ये शाश्वतीः समाः।\nप्रपन्नो दीर्घमध्वानं राजन्नद्य सुदुर्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000518060, "chapter_id": 9518, "verse_number": "६-१११-६०", "content_sanskrit": "नय मामपि दुःखार्तां न वर्तिष्ये त्वया विना।\nकस्मात् त्वं मां विहायेह कृपणां गन्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000518061, "chapter_id": 9518, "verse_number": "६-१११-६१", "content_sanskrit": "दीनां विलपतीं मन्दां किं च मां नाभिभाषसे।\nदृष्ट्वा न खल्वभिक्रुद्धो मामिहानवगुण्ठिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000518062, "chapter_id": 9518, "verse_number": "६-१११-६२", "content_sanskrit": "निर्गतां नगरद्वारात् पद‍्भ्यामेवागतां प्रभो।\nपश्येष्टदार दारांस्ते भ्रष्टलज्जावगुण्ठनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000518063, "chapter_id": 9518, "verse_number": "६-१११-६३", "content_sanskrit": "बहिर्निष्पतितान् सर्वान् कथं दृष्ट्वा न कुप्यसि।\nअयं क्रीडासहायस्तेऽनाथो लालप्यते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000518064, "chapter_id": 9518, "verse_number": "६-१११-६४", "content_sanskrit": "न चैनमाश्वासयसि किं वा न बहुमन्यसे।\nयास्त्वया विधवा राजन् कृता नैकाः कुलस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000518065, "chapter_id": 9518, "verse_number": "६-१११-६५", "content_sanskrit": "पतिव्रता धर्मरता गुरुशुश्रूषणे रताः।\nताभिः शोकाभितप्ताभिः शप्तः परवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000518066, "chapter_id": 9518, "verse_number": "६-१११-६६", "content_sanskrit": "त्वया विप्रकृताभिश्च तदा शप्तस्तदागतम्।\nप्रवादः सत्यमेवायं त्वां प्रति प्रायशो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000518067, "chapter_id": 9518, "verse_number": "६-१११-६७", "content_sanskrit": "पतिव्रतानां नाकस्मात् पतन्त्यश्रूणि भूतले।\nकथं च नाम ते राजँल्लोकानाक्रम्य तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000518068, "chapter_id": 9518, "verse_number": "६-१११-६८", "content_sanskrit": "नारीचौर्यमिदं क्षुद्रं कृतं शौण्डीर्यमानिना।\nअपनीयाश्रमाद् रामं यन्मृगच्छद्मना त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000518069, "chapter_id": 9518, "verse_number": "६-१११-६९", "content_sanskrit": "आनीता रामपत्नी सा अपनीय च लक्ष्मणम्।\nकातर्यं च न ते युद्धे कदाचित् संस्मराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000518070, "chapter_id": 9518, "verse_number": "६-१११-७०", "content_sanskrit": "तत् तु भाग्यविपर्यासान्नूनं ते पक्वलक्षणम्।\nअतीतानागतार्थज्ञो वर्तमानविचक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000518071, "chapter_id": 9518, "verse_number": "६-१११-७१", "content_sanskrit": "मैथिलीमाहृतां दृष्ट्वा ध्यात्वा निःश्वस्य चायतम्।\nसत्यवाक् स महाबाहो देवरो मे यदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000518072, "chapter_id": 9518, "verse_number": "६-१११-७२", "content_sanskrit": "अयं राक्षसमुख्यानां विनाशः प्रत्युपस्थितः।\nकामक्रोधसमुत्थेन व्यसनेन प्रसङ्गिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000518073, "chapter_id": 9518, "verse_number": "६-१११-७३", "content_sanskrit": "निवृत्तस्त्वत्कृतेनार्थः सोऽयं मूलहरो महान्।\nत्वया कृतमिदं सर्वमनाथं राक्षसं कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000518074, "chapter_id": 9518, "verse_number": "६-१११-७४", "content_sanskrit": "नहि त्वं शोचितव्यो मे प्रख्यातबलपौरुषः।\nस्त्रीस्वभावात् तु मे बुद्धिः कारुण्ये परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000518075, "chapter_id": 9518, "verse_number": "६-१११-७५", "content_sanskrit": "सुकृतं दुष्कृतं च त्वं गृहीत्वा स्वां गतिं गतः।\nआत्मानमनुशोचामि त्वद्विनाशेन दुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000518076, "chapter_id": 9518, "verse_number": "६-१११-७६", "content_sanskrit": "सुहृदां हितकामानां न श्रुतं वचनं त्वया।\nभ्रातॄणां चैव कात्स्‍‍र्न्येन हितमुक्तं दशानन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000518077, "chapter_id": 9518, "verse_number": "६-१११-७७", "content_sanskrit": "हेत्वर्थयुक्तं विधिवच्छ्रेयस्करमदारुणम्।\nविभीषणेनाभिहितं न कृतं हेतुमत् त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000518078, "chapter_id": 9518, "verse_number": "६-१११-७८", "content_sanskrit": "मारीचकुम्भकर्णाभ्यां वाक्यं मम पितुस्तथा।\nन कृतं वीर्यमत्तेन तस्येदं फलमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000518079, "chapter_id": 9518, "verse_number": "६-१११-७९", "content_sanskrit": "नीलजीमूतसंकाश पीताम्बर शुभाङ्गद।\nस्वगात्राणि विनिक्षिप्य किं शेषे रुधिरावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000518080, "chapter_id": 9518, "verse_number": "६-१११-८०", "content_sanskrit": "प्रसुप्त इव शोकार्तां किं मां न प्रतिभाषसे।\nमहावीर्यस्य दक्षस्य संयुगेष्वपलायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000518081, "chapter_id": 9518, "verse_number": "६-१११-८१", "content_sanskrit": "यातुधानस्य दौहित्रीं किं मां न प्रतिभाषसे।\nउत्तिष्ठोत्तिष्ठ किं शेषे नवे परिभवे कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000518082, "chapter_id": 9518, "verse_number": "६-१११-८२", "content_sanskrit": "अद्य वै निर्भया लङ्कां प्रविष्टाः सूर्यरश्मयः।\nयेन सूदयसे शत्रून् समरे सूर्यवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000518083, "chapter_id": 9518, "verse_number": "६-१११-८३", "content_sanskrit": "वज्रं वज्रधरस्येव सोऽयं ते सततार्चितः।\nरणे बहुप्रहरणो हेमजालपरिष्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000518084, "chapter_id": 9518, "verse_number": "६-१११-८४", "content_sanskrit": "परिघो व्यवकीर्णस्ते बाणैश्छिन्नः सहस्रधा।\nप्रियामिवोपसंगृह्य किं शेषे रणमेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000518085, "chapter_id": 9518, "verse_number": "६-१११-८५", "content_sanskrit": "अप्रियामिव कस्माच्च मां नेच्छस्यभिभाषितुम्।\nधिगस्तु हृदयं यस्या ममेदं न सहस्रधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000518086, "chapter_id": 9518, "verse_number": "६-१११-८६", "content_sanskrit": "त्वयि पञ्चत्वमापन्ने फलते शोकपीडितम्।\nइत्येवं विलपन्ती सा बाष्पपर्याकुलेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000518087, "chapter_id": 9518, "verse_number": "६-१११-८७", "content_sanskrit": "स्नेहोपस्कन्नहृदया तदा मोहमुपागमत्।\nकश्मलाभिहता सन्ना बभौ सा रावणोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000518088, "chapter_id": 9518, "verse_number": "६-१११-८८", "content_sanskrit": "संध्यानुरक्ते जलदे दीप्ता विद्युदिवोज्ज्वला।\nतथागतां समुत्थाप्य सपत्न्यस्तां भृशातुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000518089, "chapter_id": 9518, "verse_number": "६-१११-८९", "content_sanskrit": "पर्यवस्थापयामासू रुदत्यो रुदतीं भृशम्।\nकिं ते न विदिता देवि लोकानां स्थितिरध्रुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000518090, "chapter_id": 9518, "verse_number": "६-१११-९०", "content_sanskrit": "दशाविभागपर्याये राज्ञां वै चञ्चलाः श्रियः।\nइत्येवमुच्यमाना सा सशब्दं प्ररुरोद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000518091, "chapter_id": 9518, "verse_number": "६-१११-९१", "content_sanskrit": "स्नपयन्ती तदास्रेण स्तनौ वक्त्रं सुनिर्मलम्।\nएतस्मिन्नन्तरे रामो विभीषणमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000518092, "chapter_id": 9518, "verse_number": "६-१११-९२", "content_sanskrit": "संस्कारः क्रियतां भ्रातुः स्त्रीगणः परिसान्त्व्यताम्।\nतमुवाच ततो धीमान् विभीषण इदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000518093, "chapter_id": 9518, "verse_number": "६-१११-९३", "content_sanskrit": "विमृश्य बुद्ध्या प्रश्रितं धर्मार्थसहितं हितम्।\nत्यक्तधर्मव्रतं क्रूरं नृशंसमनृतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000518094, "chapter_id": 9518, "verse_number": "६-१११-९४", "content_sanskrit": "नाहमर्हामि संस्कर्तुं परदाराभिमर्शनम्।\nभ्रातृरूपो हि मे शत्रुरेष सर्वाहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000518095, "chapter_id": 9518, "verse_number": "६-१११-९५", "content_sanskrit": "रावणो नार्हते पूजां पूज्योऽपि गुरुगौरवात्।\nनृशंस इति मां राम वक्ष्यन्ति मनुजा भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000518096, "chapter_id": 9518, "verse_number": "६-१११-९६", "content_sanskrit": "श्रुत्वा तस्यागुणान् सर्वे वक्ष्यन्ति सुकृतं पुनः।\nतच्छ्रुत्वा परमप्रीतो रामो धर्मभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000518097, "chapter_id": 9518, "verse_number": "६-१११-९७", "content_sanskrit": "विभीषणमुवाचेदं वाक्यज्ञं वाक्यकोविदः।\nतवापि मे प्रियं कार्यं त्वत्प्रभावान्मया जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000518098, "chapter_id": 9518, "verse_number": "६-१११-९८", "content_sanskrit": "अवश्यं तु क्षमं वाच्यो मया त्वं राक्षसेश्वर।\nअधर्मानृतसंयुक्तः कामं त्वेष निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000518099, "chapter_id": 9518, "verse_number": "६-१११-९९", "content_sanskrit": "तेजस्वी बलवाञ्छूरः संग्रामेषु च नित्यशः।\nशतक्रतुमुखैर्देवैः श्रूयते न पराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 5000518100, "chapter_id": 9518, "verse_number": "६-१११-१००", "content_sanskrit": "महात्मा बलसम्पन्नो रावणो लोकरावणः।\nमरणान्तानि वैराणि निर्वृत्तं नः प्रयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 5000518101, "chapter_id": 9518, "verse_number": "६-१११-१०१", "content_sanskrit": "क्रियतामस्य संस्कारो ममाप्येष यथा तव।\nत्वत्सकाशान्महाबाहो संस्कारं विधिपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 5000518102, "chapter_id": 9518, "verse_number": "६-१११-१०२", "content_sanskrit": "क्षिप्रमर्हति धर्मेण त्वं यशोभाग् भविष्यसि।\nराघवस्य वचः श्रुत्वा त्वरमाणो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 5000518103, "chapter_id": 9518, "verse_number": "६-१११-१०३", "content_sanskrit": "संस्कारयितुमारेभे भ्रातरं रावणं हतम्।\nस प्रविश्य पुरीं लङ्कां राक्षसेन्द्रो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 5000518104, "chapter_id": 9518, "verse_number": "६-१११-१०४", "content_sanskrit": "रावणस्याग्निहोत्रं तु निर्यापयति सत्वरम्।\nशकटान् दारुरूपाणि अग्नीन् वै याजकांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 5000518105, "chapter_id": 9518, "verse_number": "६-१११-१०५", "content_sanskrit": "तथा चन्दनकाष्ठानि काष्ठानि विविधानि च।\nअगरूणि सुगन्धीनि गन्धांश्च सुरभींस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 5000518106, "chapter_id": 9518, "verse_number": "६-१११-१०६", "content_sanskrit": "मणिमुक्ताप्रवालानि निर्यापयति राक्षसः।\nआजगाम मुहूर्तेन राक्षसैः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 5000518107, "chapter_id": 9518, "verse_number": "६-१११-१०७", "content_sanskrit": "ततो माल्यवता सार्धं क्रियामेव चकार सः।\nसौवर्णीं शिबिकां दिव्यामारोप्य क्षौमवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 5000518108, "chapter_id": 9518, "verse_number": "६-१११-१०८", "content_sanskrit": "रावणं राक्षसाधीशमश्रुवर्णमुखा द्विजाः।\nतूर्यघोषैश्च विविधैः स्तुवद्भिश्चाभिनन्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 5000518109, "chapter_id": 9518, "verse_number": "६-१११-१०९", "content_sanskrit": "पताकाभिश्च चित्राभिः सुमनोभिश्च चित्रिताम्।\nउत्क्षिप्य शिबिकां तां तु विभीषणपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 5000518110, "chapter_id": 9518, "verse_number": "६-१११-११०", "content_sanskrit": "दक्षिणाभिमुखाः सर्वे गृह्य काष्ठानि भेजिरे।\nअग्नयो दीप्यमानास्ते तदाध्वर्युसमीरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 5000518111, "chapter_id": 9518, "verse_number": "६-१११-१११", "content_sanskrit": "शरणाभिगताः सर्वे पुरस्तात् तस्य ते ययुः।\nअन्तःपुराणि सर्वाणि रुदमानानि सत्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 5000518112, "chapter_id": 9518, "verse_number": "६-१११-११२", "content_sanskrit": "पृष्ठतोऽनुययुस्तानि प्लवमानानि सर्वतः।\nरावणं प्रयते देशे स्थाप्य ते भृशदुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 5000518113, "chapter_id": 9518, "verse_number": "६-१११-११३", "content_sanskrit": "चितां चन्दनकाष्ठैश्च पद्मकोशीरचन्दनैः।\nब्राह्म्या संवर्तयामासू राङ्कवास्तरणावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 5000518114, "chapter_id": 9518, "verse_number": "६-१११-११४", "content_sanskrit": "प्रचक्रू राक्षसेन्द्रस्य पितृमेधमनुत्तमम्।\nवेदिं च दक्षिणाप्राचीं यथास्थानं च पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 5000518115, "chapter_id": 9518, "verse_number": "६-१११-११५", "content_sanskrit": "पृषदाज्येन सम्पूर्णं स्रुवं स्कन्धे प्रचिक्षिपुः।\nपादयोः शकटं प्रापुरूर्वोश्चोलूखलं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 5000518116, "chapter_id": 9518, "verse_number": "६-१११-११६", "content_sanskrit": "दारुपात्राणि सर्वाणि अरणिं चोत्तरारणिम्।\nदत्त्वा तु मुसलं चान्यं यथास्थानं विचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 5000518117, "chapter_id": 9518, "verse_number": "६-१११-११७", "content_sanskrit": "शास्त्रदृष्टेन विधिना महर्षिविहितेन च।\nतत्र मेध्यं पशुं हत्वा राक्षसेन्द्रस्य राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 5000518118, "chapter_id": 9518, "verse_number": "६-१११-११८", "content_sanskrit": "परिस्तरणिकां राज्ञो घृताक्तां समवेशयन्।\nगन्धैर्माल्यैरलंकृत्य रावणं दीनमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 5000518119, "chapter_id": 9518, "verse_number": "६-१११-११९", "content_sanskrit": "विभीषणसहायास्ते वस्त्रैश्च विविधैरपि।\nलाजैरवकिरन्ति स्म बाष्पपूर्णमुखास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 5000518120, "chapter_id": 9518, "verse_number": "६-१११-१२०", "content_sanskrit": "स ददौ पावकं तस्य विधियुक्तं विभीषणः।\nस्नात्वा चैवार्द्रवस्त्रेण तिलान् दर्भविमिश्रितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 5000518121, "chapter_id": 9518, "verse_number": "६-१११-१२१", "content_sanskrit": "उदकेन च सम्मिश्रान् प्रदाय विधिपूर्वकम्।\nताः स्त्रियोऽनुनयामास सान्त्वयित्वा पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 5000518122, "chapter_id": 9518, "verse_number": "६-१११-१२२", "content_sanskrit": "गम्यतामिति ताः सर्वा विविशुर्नगरं ततः।\nप्रविष्टासु पुरीं स्त्रीषु राक्षसेन्द्रो विभीषणः।\nरामपार्श्वमुपागम्य समतिष्ठद् विनीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 5000518123, "chapter_id": 9518, "verse_number": "६-१११-१२३", "content_sanskrit": "रामोऽपि सह सैन्येन ससुग्रीवः सलक्ष्मणः।\nहर्षं लेभे रिपुं हत्वा वृत्रं वज्रधरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 5000518124, "chapter_id": 9518, "verse_number": "६-१११-१२४", "content_sanskrit": "ततो विमुक्त्वा सशरं शरासनं\nमहेन्द्रदत्तं कवचं स तन्महत्।\nविमुच्य रोषं रिपुनिग्रहात् ततो\nरामः स सौम्यत्वमुपागतोऽरिहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 5000518125, "chapter_id": 9518, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकादशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}]