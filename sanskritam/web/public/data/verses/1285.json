[{"id": 2013871, "chapter_id": 1285, "verse_number": "२-२६-१", "content_sanskrit": "वैशम्पायन उवाच।\nऋषेस्तद्वचनं स्मृत्वा निशश्वास युधिष्ठिरः।\nधर्म धर्मभृतां श्रेष्ठः कर्तुमिच्छन्परन्तपः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013872, "chapter_id": 1285, "verse_number": "२-२६-२", "content_sanskrit": "तस्येङ्गितज्ञो बीभत्सुः सर्वशस्त्रभृतां वरः।\nसंविवर्तयिषुः कामं पावकात्पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013873, "chapter_id": 1285, "verse_number": "२-२६-३", "content_sanskrit": "प्राप्तं प्राप्य धनुः श्रेष्ठमक्षय्यौ च महेषुधी।\nरथं ध्वजं सभां चैव युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013874, "chapter_id": 1285, "verse_number": "२-२६-४x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013875, "chapter_id": 1285, "verse_number": "२-२६-४", "content_sanskrit": "धनुरस्त्रं शरा वीर्यं पक्षो भूमिर्यशो बलम्।\nप्राप्तमेतन्मया राजन्दुष्प्रापं यदभीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013876, "chapter_id": 1285, "verse_number": "२-२६-५", "content_sanskrit": "तस्य कृत्यमहं मन्ये कोशस्य परिवर्धनम्।\nकरमाहारयिष्यामि राज्ञः सर्वान्नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013877, "chapter_id": 1285, "verse_number": "२-२६-६", "content_sanskrit": "विजयाय प्रयास्यामि दिशं धनदपालिताम्।\nतिथावथ मुहूर्ते च नक्षत्रे चाभिपूजिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013878, "chapter_id": 1285, "verse_number": "२-२६-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013879, "chapter_id": 1285, "verse_number": "२-२६-७", "content_sanskrit": "धनञ्जयवचः श्रुत्वा धर्मराजो युधिष्ठिरः\nस्निग्धगम्भीरनादिन्यां तं गिरा प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013880, "chapter_id": 1285, "verse_number": "२-२६-८", "content_sanskrit": "स्वस्ति वाच्यार्हतो विप्रान्प्रयाहि भरतर्षभ।\nदुर्हृदामप्रहर्षाय सुहृदां नन्दनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013881, "chapter_id": 1285, "verse_number": "२-२६-९", "content_sanskrit": "विजयस्ते ध्रुवं पार्थ प्रियं काममवाप्स्यसि।\nइत्युक्तः प्रययौ पार्थः सैन्येन महता वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013882, "chapter_id": 1285, "verse_number": "२-२६-१०", "content_sanskrit": "अग्निदत्तेन दिव्येन रथेनाद्भुतकर्मणा।\nतथैव भीमसेनोऽपि यमौ च पुरुषर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013883, "chapter_id": 1285, "verse_number": "२-२६-११", "content_sanskrit": "ससैन्याः प्रययुः सर्वे धर्मराजेन पूजिताः।\nदिशं धनपतेरिष्टामजयत्पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013884, "chapter_id": 1285, "verse_number": "२-२६-१२", "content_sanskrit": "भीमसेनस्तथा प्राचीं सहदेवस्तु दक्षिणाम्।\nप्रतीचीं नकुलो राजन्दिशं व्यजयतास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013885, "chapter_id": 1285, "verse_number": "२-२६-१३", "content_sanskrit": "खाण्डवप्रस्थमध्यस्थो धर्मराजो युधिष्ठिरः।\nआसीत्परमया लक्ष्म्या सुहृद्गणवृतः प्रभुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013886, "chapter_id": 1285, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि षड्विंशोऽध्यायः॥ २६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]