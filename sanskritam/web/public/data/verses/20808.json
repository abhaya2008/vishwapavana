[{"id": 7000808000, "chapter_id": 20808, "verse_number": "६-१५१-१", "content_sanskrit": "महादेव उवाच ।\nअस्मात्तीर्थात्परं तीर्थं इंद्रग्राममिति स्मृतम् ।\nयत्र स्नात्वा पुरा शक्रो विमुक्तो घोरकिल्बिषात्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000808001, "chapter_id": 20808, "verse_number": "६-१५१-२", "content_sanskrit": "पार्वत्युवाच ।\nकेनेह कर्मणा शक्रः प्राप्तवान्घोरकिल्बिषम् ।\nविपाप्मा च कथं सोऽभूदिति विस्तरतो वद॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000808002, "chapter_id": 20808, "verse_number": "६-१५१-३", "content_sanskrit": "महादेव उवाच ।\nइंद्रः सुरेश्वरः पूर्वं नमुचिश्चासुरेश्वरः ।\nअशस्त्रवधमन्योऽन्य समयं तौ प्रचक्रतुः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000808003, "chapter_id": 20808, "verse_number": "६-१५१-४", "content_sanskrit": "अथेंद्रस्तु नभोवाणीनिर्देशान्नमुचिं तदा ।\nजघान फेनमादाय ब्रह्महत्या तदाऽभवत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000808004, "chapter_id": 20808, "verse_number": "६-१५१-५", "content_sanskrit": "पप्रच्छ च गुरुं शक्रः पापनिर्नाशकारणम् ।\nबृहस्पतेरथादेशात्साभ्रामत्युत्तरे तटे॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000808005, "chapter_id": 20808, "verse_number": "६-१५१-६", "content_sanskrit": "अस्मिन्स्थाने समागत्य स्थानं चक्रे सुरेश्वरः ।\nतस्येह स्नानमात्रेण गतपापस्य तत्क्षणात्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000808006, "chapter_id": 20808, "verse_number": "६-१५१-७", "content_sanskrit": "पूर्णेंदुधवलाकांतिः शरीरे समजायत ।\nधवलेश्वरमीशानं स्थापयामास वृत्रहा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000808007, "chapter_id": 20808, "verse_number": "६-१५१-८", "content_sanskrit": "इंद्र नाम्ना च तल्लिंगं विश्रुतं पृथिवीतले ।\nपूर्णिमास्यां तथा दर्शे संक्रांतौ ग्रहणे तथा॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000808008, "chapter_id": 20808, "verse_number": "६-१५१-९", "content_sanskrit": "श्राद्धे कृते पितॄणां तु तृप्तिर्द्वादशवार्षिकी ।\nधवलेश्वरमासाद्य यः कुर्याद्विप्रभोजनम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000808009, "chapter_id": 20808, "verse_number": "६-१५१-१०", "content_sanskrit": "एकस्मिन्भोजिते विप्रे सहस्रं भोजितं भवेत् ।\nहिरण्यभूमिवासांसि दातव्यानि स्वशक्तितः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000808010, "chapter_id": 20808, "verse_number": "६-१५१-११", "content_sanskrit": "शुक्ला गौ ब्राह्मणे देया सवत्सा च पयस्विनी ।\nअत्रागत्य तु यो विप्रो रुद्रजाप्यादिकं चरेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000808011, "chapter_id": 20808, "verse_number": "६-१५१-१२", "content_sanskrit": "तत्कृतं कोटिगुणितं श्रीमहेशप्रसादतः ।\nअत्र तीर्थे नरो यस्तु उपवासादिकं चरेत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000808012, "chapter_id": 20808, "verse_number": "६-१५१-१३", "content_sanskrit": "स एव सर्वकामाढ्यो भवत्येव न संशयः ।\nबिल्वपत्रं समानीय यः पूजयति तं प्रभुम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000808013, "chapter_id": 20808, "verse_number": "६-१५१-१४", "content_sanskrit": "धर्ममर्थं च कामं च लभते मानवो भुवि ।\nसोमवारे विशेषेण ये गच्छंति नरोत्तमाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000808014, "chapter_id": 20808, "verse_number": "६-१५१-१५", "content_sanskrit": "तेषां रोगं तथा दोषं शमयेद्धवलेश्वरः ।\nरवौ वाऽथ विशेषेण अर्चनं कुरुते यदा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000808015, "chapter_id": 20808, "verse_number": "६-१५१-१६", "content_sanskrit": "तेषां महिमा तु भो देवि न ज्ञातः कर्हिचिन्मया ।\nदूर्वया चार्कपुष्पैर्वा कल्हारैः कमलैर्दलैः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000808016, "chapter_id": 20808, "verse_number": "६-१५१-१७", "content_sanskrit": "पूजनं कुर्वते येऽत्र ते नराः पुण्यभागिनः ।\nश्वेतार्कपुष्पमानीय धवलेशं प्रपूज्य तु॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000808017, "chapter_id": 20808, "verse_number": "६-१५१-१८", "content_sanskrit": "वांच्छितं लभते नित्यं धवलेशप्रसादतः ।\nकृते वै नीलकंठस्तु सर्वेषां शंकरः सदा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000808018, "chapter_id": 20808, "verse_number": "६-१५१-१९", "content_sanskrit": "त्रेतायुगे स विख्यातो हरो वै भगवान्प्रभुः ।\nद्वापरे शर्वसंज्ञस्तु कलौ वै धवलेश्वरः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000808019, "chapter_id": 20808, "verse_number": "६-१५१-२०", "content_sanskrit": "अत्रार्थे यत्पुरावृत्तं तच्छृणुष्व सुरेश्वरि ।\nनंदिर्नाम पुरा वैश्य इंद्रग्रामे समावसत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000808020, "chapter_id": 20808, "verse_number": "६-१५१-२१", "content_sanskrit": "शिवध्यानपरो भूत्वा शिवपूजां चकार सः ।\nनित्यं तपोवनस्थं हि लिंगं धवलसंज्ञकम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000808021, "chapter_id": 20808, "verse_number": "६-१५१-२२", "content_sanskrit": "उषस्युषसि चोत्थाय प्रत्यहं शिववल्लभः ।\nनंदी लिंगार्चनरतो बभूवातिशयेन हि॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000808022, "chapter_id": 20808, "verse_number": "६-१५१-२३", "content_sanskrit": "यथाशास्त्रेण विधिना पुष्पार्चनपरोऽभवत् ।\nएकदा मृगयालुब्धः किरातो भूतहिंसकः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000808023, "chapter_id": 20808, "verse_number": "६-१५१-२४", "content_sanskrit": "पापी पापसमाचारश्चरन्साभ्रमती तटे ।\nअनेक श्वापदाकीर्णे हन्यमानो मृगान्शरैः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000808024, "chapter_id": 20808, "verse_number": "६-१५१-२५", "content_sanskrit": "एवं विचरमाणोऽसौ किरातो भूतहिंसकः ।\nयदृच्छयागतस्तत्र यत्र लिंगं सुपूजितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000808025, "chapter_id": 20808, "verse_number": "६-१५१-२६", "content_sanskrit": "धवलेश्वरविख्यातं अनेकाश्चर्यमंडितम् ।\nदृष्टं सुपूजितं लिंगं नानापुष्पैः फलैस्तथा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000808026, "chapter_id": 20808, "verse_number": "६-१५१-२७", "content_sanskrit": "एवं लिंगं समालिंग्य गतः साभ्रमतीतटे ।\nतत्र पीत्वा पयः सोऽथ मुखं गंडूषपूरितम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000808027, "chapter_id": 20808, "verse_number": "६-१५१-२८", "content_sanskrit": "कृत्वा चैकेनहस्तेन मृगमांसं समुद्वहन् ।\nकरेणैकेन पूजार्थं बिल्वपत्राणि वै दधत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000808028, "chapter_id": 20808, "verse_number": "६-१५१-२९", "content_sanskrit": "शीघ्रमागत्य लिंगांते पदा पूजां समाहनत् ।\nपुष्पाणि तानि सर्वाणि विधूतानि इतस्ततः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000808029, "chapter_id": 20808, "verse_number": "६-१५१-३०", "content_sanskrit": "स्नापनं तस्य लिंगस्य कृतं गंडूषवारिणा ।\nकरेणैकेन पूजार्थं बिल्वपत्राणि सोऽर्पयत्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000808030, "chapter_id": 20808, "verse_number": "६-१५१-३१", "content_sanskrit": "द्वितीयेन करेणैव मृगमांसं समर्पयत् ।\nदंडप्रणामसंयुक्तः संकल्पं मनसाऽकरोत्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000808031, "chapter_id": 20808, "verse_number": "६-१५१-३२", "content_sanskrit": "अद्यप्रभृति पूजां वै करिष्यामि प्रयत्नतः ।\nत्वं मे स्वामी च भक्तोऽहं अद्यप्रभृति शंकर॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000808032, "chapter_id": 20808, "verse_number": "६-१५१-३३", "content_sanskrit": "एवं नियमवान्भूत्वा किरातो गृहमागमत् ।\nतथा प्रभातसमये देवायतनमागतः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000808033, "chapter_id": 20808, "verse_number": "६-१५१-३४", "content_sanskrit": "नंदी ददर्श तं सर्वं किरातेन च यत्कृतम् ।\nअव्यवस्थं च तं दृंष्ट्वा अमेध्यं शिवसन्निधौ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000808034, "chapter_id": 20808, "verse_number": "६-१५१-३५", "content_sanskrit": "विधूतानि च सर्वाणि हिंसकेन दुरात्मना ।\nचिंतायुक्तोभवन्नंदी जातं किं चित्रमद्य मे॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000808035, "chapter_id": 20808, "verse_number": "६-१५१-३६", "content_sanskrit": "कथितानि च विघ्नानि शिवपूजारतस्य हि ।\nउपस्थितानि तान्येव मम भाग्यविपर्ययात्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000808036, "chapter_id": 20808, "verse_number": "६-१५१-३७", "content_sanskrit": "एवं विमृश्य सुचिरं प्रक्षाल्य शिवमंदिरम् ।\nयथागतेन मार्गेण नंदी स्वगृहमागमत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000808037, "chapter_id": 20808, "verse_number": "६-१५१-३८", "content_sanskrit": "ततो नंदिनमालक्ष्य पुरोधा गतमानसम् ।\nअब्रवीद्वचनं तं तु कस्मात्त्वं गतमानसः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000808038, "chapter_id": 20808, "verse_number": "६-१५१-३९", "content_sanskrit": "पुरोहितं प्रति तदा नंदी वचनमब्रवीत् ।\nअद्य दृष्टं मया विप्र अमेध्यं शिवसन्निधौ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000808039, "chapter_id": 20808, "verse_number": "६-१५१-४०", "content_sanskrit": "केनेदं कारितं तत्र न जानामीह किंचन ।\nततः पुरोधा वचनं नंदिनं चाब्रवीत्तथा॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000808040, "chapter_id": 20808, "verse_number": "६-१५१-४१", "content_sanskrit": "येन विस्खलितं तत्र पुष्पादीनां प्रपूजनम् ।\nसोऽपि मूढो न संदेहः कार्याकार्येषु मंदधीः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000808041, "chapter_id": 20808, "verse_number": "६-१५१-४२", "content_sanskrit": "तस्माच्चिंता न कर्तव्या त्वया पुनरपि प्रभो ।\nप्रभाते च मया सार्द्धं गम्यतां तच्छिवालयम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000808042, "chapter_id": 20808, "verse_number": "६-१५१-४३", "content_sanskrit": "निरीक्षणार्थं दुष्टस्य तस्य दंडंकरोम्यहम् ।\nएतच्छ्रुत्वा तु वचनं नंदी तस्य पुरोधसः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000808043, "chapter_id": 20808, "verse_number": "६-१५१-४४", "content_sanskrit": "आस्थितः स्वगृहे नक्तं दूयमानेन चेतसा ।\nतस्यां रात्र्यां व्यतीतायां आहूय च पुरोधसम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000808044, "chapter_id": 20808, "verse_number": "६-१५१-४५", "content_sanskrit": "गतः शिवालयं नंदी समंतेन महात्मना ।\nप्रक्षाल्य पूजनं कृत्वा नानारत्नपरिच्छदम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000808045, "chapter_id": 20808, "verse_number": "६-१५१-४६", "content_sanskrit": "पंचोपचारसंयुक्तं कृत्वा वै ब्राह्मणैः सह ।\nएवं यामद्वयं जातं स्तूयमानस्य नंदिनः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000808046, "chapter_id": 20808, "verse_number": "६-१५१-४७", "content_sanskrit": "आयातोऽसौ महाकालस्तथारूपो महाबलः ।\nकालरूपो महारौद्रो धनुष्पाणिः प्रतापवान्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000808047, "chapter_id": 20808, "verse_number": "६-१५१-४८", "content_sanskrit": "तं दृष्ट्वा भयसंत्रस्तो नंदी तत्र न्यलीयत ।\nपुरोधाश्चैव सहसा भयभीतस्तदाभवत्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000808048, "chapter_id": 20808, "verse_number": "६-१५१-४९", "content_sanskrit": "किरातेन कृतं तत्र यथापूर्वमविस्खलन् ।\nतां पूजां स पदाहृत्य बिल्वपत्रं समर्पयत्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000808049, "chapter_id": 20808, "verse_number": "६-१५१-५०", "content_sanskrit": "नैवेद्येन पलेनैव किरातः शिवमार्चयत् ।\nदंडवत्पतितो भूमौ उत्थाय स्वगृहं गतः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000808050, "chapter_id": 20808, "verse_number": "६-१५१-५१", "content_sanskrit": "तं दृष्ट्वा महदाश्चर्यं चिंतयामास वै चिरम् ।\nपुरोधसा तदा नंदी सह व्याकुलचेतसा॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000808051, "chapter_id": 20808, "verse_number": "६-१५१-५२", "content_sanskrit": "तेन पृष्टास्तदा विप्राः कथ्यतां च यथातथम् ।\nसंप्रधार्य ततः सर्वे मिलित्वा धर्मशास्त्रतः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000808052, "chapter_id": 20808, "verse_number": "६-१५१-५३", "content_sanskrit": "ऊचुः सर्वे तदा विप्रा नंदिनं जातशंकितम् ।\nईशविघ्नं समुत्पन्नं दुर्निवार्यं सुरैरपि॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000808053, "chapter_id": 20808, "verse_number": "६-१५१-५४", "content_sanskrit": "तस्मादानय लिंगं त्वं स्वगृहे वैश्यसत्तम ।\nतथेति मत्वाऽसौ नंदी शिवस्योत्पाटनं महत्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000808054, "chapter_id": 20808, "verse_number": "६-१५१-५५", "content_sanskrit": "कृत्वा स्वगृहमानीय प्रतिष्ठाप्य यथाविधि ।\nसुवर्णपीठिकां कृत्वा नवरंभासुशोभिताम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000808055, "chapter_id": 20808, "verse_number": "६-१५१-५६", "content_sanskrit": "उपाहारैरनेकैश्च पूजयामास वै तदा ।\nअथापरेद्युरायातः किरातः शिवमंदिरम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000808056, "chapter_id": 20808, "verse_number": "६-१५१-५७", "content_sanskrit": "यावद्विलोकयामास लिंगमैशं न दृष्टवान् ।\nमौनं विहाय सहसा साक्रोशमिदमब्रवीत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000808057, "chapter_id": 20808, "verse_number": "६-१५१-५८", "content_sanskrit": "हे शंभो क्व गतोऽसि त्वं दर्शयात्मानमद्य वै ।\nयदि नो दर्शनं हेयं त्यक्ष्याम्यद्य कलेवरम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000808058, "chapter_id": 20808, "verse_number": "६-१५१-५९", "content_sanskrit": "हे शंभो हे जगन्नाथ त्रिपुरांतक शंकर ।\nहेरुद्र हे महादेव दर्शयात्मानमात्मना॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000808059, "chapter_id": 20808, "verse_number": "६-१५१-६०", "content_sanskrit": "एवं साक्षेपमधुरैर्वाक्यैः क्षिप्त्वा सदाशिवम् ।\nकिरातोऽसौ क्षुरिकया धीरो वै जठरं स्वकम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000808060, "chapter_id": 20808, "verse_number": "६-१५१-६१", "content_sanskrit": "बिभेद्याशु ततो बाहुमासाद्योच्चै रुषाब्रवीत् ।\nहे शंभो दर्शयात्मानं कुतो मां त्यज्य यास्यसि॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000808061, "chapter_id": 20808, "verse_number": "६-१५१-६२", "content_sanskrit": "इति क्षिप्त्वा ततोंत्राणि मांसमुद्धृत्य सर्वतः ।\nतस्मिन्गर्ते करेणैव किरातः सहसाक्षिपत्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000808062, "chapter_id": 20808, "verse_number": "६-१५१-६३", "content_sanskrit": "स्वच्छं च हृदयं कृत्वा साभ्रमत्यां निमज्जतु ।\nतथैव जलमानीय बिल्वपत्रं त्वरान्वितः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000808063, "chapter_id": 20808, "verse_number": "६-१५१-६४", "content_sanskrit": "पूजयित्वा यथान्यायं दंडवत्पतितो भुवि ।\nयदा ध्यानस्थितस्तत्र किरातः शिवसन्निधौ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000808064, "chapter_id": 20808, "verse_number": "६-१५१-६५", "content_sanskrit": "प्रादुर्भूतस्तदा रुद्रः प्रमथैः परिवारितः ।\nकर्पूरगौरो द्युतिमान्कपर्दी चंद्रशेखरः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000808065, "chapter_id": 20808, "verse_number": "६-१५१-६६", "content_sanskrit": "तं गृहीत्वा करे रुद्रः उवाच परिसांत्वयन् ।\nभो भो वीर महाप्राज्ञ मद्भक्तोऽसि महामते॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000808066, "chapter_id": 20808, "verse_number": "६-१५१-६७", "content_sanskrit": "वरं वृणीष्व भो भक्त यत्ते मनसि वर्त्तते ।\nएवमुक्तः स रुद्रेण महाकालो मुदान्वितः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000808067, "chapter_id": 20808, "verse_number": "६-१५१-६८", "content_sanskrit": "पपात दंडवद्भूमौ भक्त्या परमया युतः ।\nततो रुद्रं बभाषेदं न वरं प्रार्थयाम्यहम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000808068, "chapter_id": 20808, "verse_number": "६-१५१-६९", "content_sanskrit": "अहं दासोऽस्मि ते रुद्र त्वं मे स्वामी न संशयः ।\nएतत्श्लाघ्यतमं लोके देहि जन्मनि जन्मनि॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000808069, "chapter_id": 20808, "verse_number": "६-१५१-७०", "content_sanskrit": "त्वं माता च पिता त्वं च त्वं बंधुश्च सखा च मे ।\nत्वं गुरुस्त्वं महामंत्रो मंत्रैर्वेद्योऽसि सर्वदा॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000808070, "chapter_id": 20808, "verse_number": "६-१५१-७१", "content_sanskrit": "निष्कामं वाक्यमाकर्ण्य किरातस्य तदा भवः ।\nददौ पार्षदमुख्यत्वं द्वारपालत्वमेव च॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000808071, "chapter_id": 20808, "verse_number": "६-१५१-७२", "content_sanskrit": "तदा डमरुनादेन नादितं भुवनत्रयम् ।\nभेरीभांकारशब्देन शंखानां निनदेन च॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000808072, "chapter_id": 20808, "verse_number": "६-१५१-७३", "content_sanskrit": "तदा दुंदुभयो नेदुः पटहाश्च सहस्रशः ।\nनंदी तं नादमाकर्ण्य विस्मयात्त्वरितो ययौ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000808073, "chapter_id": 20808, "verse_number": "६-१५१-७४", "content_sanskrit": "तपोवनं यत्र शिवः स्थितः प्रमथसंवृतः ।\nकिरातो हि तथा दृष्टो नंदिना च तदा भृशम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000808074, "chapter_id": 20808, "verse_number": "६-१५१-७५", "content_sanskrit": "उवाच प्रसृतो वाक्यं स नंदी विस्मयान्वितः ।\nकिरातं स्तोतुकामोऽसौ परमेन समाधिना॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000808075, "chapter_id": 20808, "verse_number": "६-१५१-७६", "content_sanskrit": "इहानीतस्त्वया शंभुस्त्वं भक्तोऽसि परंतपः ।\nत्वद्भक्तोऽहमिह प्राप्तो मां निवेदय शंकरे॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000808076, "chapter_id": 20808, "verse_number": "६-१५१-७७", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य किरातस्त्वरयान्वितः ।\nनंदिनं च करे गृह्य शंकरं समुपागतः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000808077, "chapter_id": 20808, "verse_number": "६-१५१-७८", "content_sanskrit": "प्रहस्य भगवान्रुद्रः किरातं वाक्यमब्रवीत् ।\nब्रूहि कोऽसौ त्वयानीतो गणानामिह सन्निधौ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000808078, "chapter_id": 20808, "verse_number": "६-१५१-७९", "content_sanskrit": "किरात उवाच ।\nत्वद्भक्तोऽसौ तदा देव तव पूजारतो ह्यसौ ।\nप्रत्यहं रत्नमाणिक्यपुष्पैश्चौच्चावचैरिह॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000808079, "chapter_id": 20808, "verse_number": "६-१५१-८०", "content_sanskrit": "जीवितेन धनेनापि पूजितोऽसि न संशयः ।\nतस्माच्चानीहि भो स्वामिन्नंदिनं भक्तवत्सल॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000808080, "chapter_id": 20808, "verse_number": "६-१५१-८१", "content_sanskrit": "महादेव उवाच ।\nजानाम्यहं महाभाग नंदिनं वैश्यवर्त्तनम् ।\nत्वं मे भक्तः सखा चेति महाकाल महामते॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000808081, "chapter_id": 20808, "verse_number": "६-१५१-८२", "content_sanskrit": "उपाधिरहिता ये च ये निष्कपटमानसाः ।\nते प्रियास्ते च मे भक्तास्ते विशिष्टा नरोत्तमाः ।\nतावुभौ स्वीकृतौ तेन पार्षदत्वेन शंभुना॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000808082, "chapter_id": 20808, "verse_number": "६-१५१-८३", "content_sanskrit": "ततो विमानानि बहुनि तत्र समागतान्येव महाप्रभाणि ।\nकिरातवर्येण स वैश्यवर्य उद्धारितस्तेन महाप्रभेण॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000808083, "chapter_id": 20808, "verse_number": "६-१५१-८४", "content_sanskrit": "कैलासलोकमापन्नौ विमानैर्वेगवत्तरैः ।\nसारूप्यमेव संप्राप्तो ईश्वरस्य महात्मनः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000808084, "chapter_id": 20808, "verse_number": "६-१५१-८५", "content_sanskrit": "नीराजितौ गिरिजया पुत्रवत्तौ गणावुभौ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000808085, "chapter_id": 20808, "verse_number": "६-१५१-८६", "content_sanskrit": "उवाचेदं ततो देवी प्रहस्य गजगामिनी ।\nयथा त्वं हि महादेव तथा चेतौ न संशयः॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000808086, "chapter_id": 20808, "verse_number": "६-१५१-८७", "content_sanskrit": "सारूप्येण च गत्या च हास्यभावैः सुपूजितैः ।\nदेव्यास्तद्वचनं श्रुत्वा किरातो वैश्य एव च॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000808087, "chapter_id": 20808, "verse_number": "६-१५१-८८", "content_sanskrit": "सद्यः पराङ्मुखौ भूत्वा शंकरस्य च पश्यतः ।\nऊचतुस्त्वरया युक्तौ गणौ रुद्रस्य पश्यतः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000808088, "chapter_id": 20808, "verse_number": "६-१५१-८९", "content_sanskrit": "उभावप्यनुकंप्यौ च भवता हि त्रिलोचन ।\nतव द्वारिस्थितौ नित्यं भवावस्ते नमो नमः॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000808089, "chapter_id": 20808, "verse_number": "६-१५१-९०", "content_sanskrit": "तयोर्भावं स भगवान्विदित्वा प्रहसन्भवः ।\nउवाच परया भक्त्या भवतोरस्तु वांछितम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000808090, "chapter_id": 20808, "verse_number": "६-१५१-९१", "content_sanskrit": "ततः प्रभृति द्वावेतौ द्वारपालौ बभूवतुः ।\nशिवद्वारि स्थितौ देवि मध्याह्ने शिवदर्शिनौ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000808091, "chapter_id": 20808, "verse_number": "६-१५१-९२", "content_sanskrit": "एको नंदी महाकालो द्वावेतौ शिववल्लभौ ।\nये पापिनोप्यधर्मिष्ठा अंधा मूकाश्च पंगवाः॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000808092, "chapter_id": 20808, "verse_number": "६-१५१-९३", "content_sanskrit": "कुलहीना दुरात्मानः श्वपचाद्या हि मानवाः ।\nयादृशास्तादृशाश्चान्ये आराध्य धवलेश्वरम्॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000808093, "chapter_id": 20808, "verse_number": "६-१५१-९४", "content_sanskrit": "गतास्तेऽपि गमिष्यंति नात्र कार्या विचराणा ।\nअत्र स्नानं च दानं च सांनिध्यं शंकरस्य च॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000808094, "chapter_id": 20808, "verse_number": "६-१५१-९५", "content_sanskrit": "साभ्रमत्यां कृतस्नाना धवलेश्वरपूजकाः ।\nते रुद्रलोकं गच्छंति नात्र कार्या विचारणा॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000808095, "chapter_id": 20808, "verse_number": "६-१५१-९६", "content_sanskrit": "अत्र स्नानं च दानं च ये कुर्वंति नरोत्तमाः ।\nधर्मार्थकामभोगाश्च भुक्त्वा यांति हरालयम्॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000808096, "chapter_id": 20808, "verse_number": "६-१५१-९७", "content_sanskrit": "चंद्र सर्योपरागे च पितुः सांवत्सरे दिने ।\nयत्फलं लभते मर्त्यस्तत्फलं प्राप्नुयाद्ध्रुवम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000808097, "chapter_id": 20808, "verse_number": "६-१५१-९८", "content_sanskrit": "स्वर्गात्कामदुघा देवि नित्यमायाति सर्वथा ।\nआगत्य तं शिवं देवं समभ्यर्च्य यथा तथा॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000808098, "chapter_id": 20808, "verse_number": "६-१५१-९९", "content_sanskrit": "सा गच्छति सुरश्रेष्ठे स्वर्गं प्रति न संशयः ।\nतेन दुग्धाभियोगेन लिंगं तद्धवलीकृतम्॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000808099, "chapter_id": 20808, "verse_number": "६-१५१-१००", "content_sanskrit": "धवलेश्वरं नाम ततः संजातं भुवि सर्वदा ।\nजंतवोऽत्र सदा देवि म्रियंते कालनोदिताः ।\nते ते शिवपदं यांति यावच्चंद्रदिवाकरौ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]