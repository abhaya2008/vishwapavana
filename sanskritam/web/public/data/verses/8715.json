[{"id": 900008897, "chapter_id": 8715, "verse_number": "5.1", "content_sanskrit": "ननु तथाऽपि वर्णसमुदायरूपस्य वेदस्य न नित्यत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008898, "chapter_id": 8715, "verse_number": "5.2", "content_sanskrit": "अस्तु वा सा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008899, "chapter_id": 8715, "verse_number": "5.3", "content_sanskrit": "नचेन्द्रियविशेषणताप्रत्यासत्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008900, "chapter_id": 8715, "verse_number": "5.4", "content_sanskrit": "नचप्रतियोगितद्व्याप्येतरप्रतियोग्युपलम्भकसामग्रीरूपयोग्यता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008901, "chapter_id": 8715, "verse_number": "5.5", "content_sanskrit": "एतेनैवप्रतियोगिसत्त्वासञ्जनप्रयुक्तासञ्जनविषयभूतोपलब्धेर-भावरूपा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008902, "chapter_id": 8715, "verse_number": "5.6", "content_sanskrit": "मन्मते तु नेन्द्रियस्यानुपलब्धिः सहकारिणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008903, "chapter_id": 8715, "verse_number": "5.7", "content_sanskrit": "प्रत्यक्षशब्देनाभावग्राहकत्वेनाभिप्रेतेन्द्रियकरणकज्ञानविवक्षायामपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008904, "chapter_id": 8715, "verse_number": "5.8", "content_sanskrit": "नन्वभावप्रत्यक्षत्वप्रयोजकाधिकरणयोग्यता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008905, "chapter_id": 8715, "verse_number": "5.9", "content_sanskrit": "यन्निष्ठत्वेनाभावो ज्ञायते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008906, "chapter_id": 8715, "verse_number": "5.10", "content_sanskrit": "वनादिकं च शब्दाभावग्राहकत्वेनाभिमतश्रोत्राग्राह्यमिति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008907, "chapter_id": 8715, "verse_number": "5.11", "content_sanskrit": "नचाधिकरणयोग्यतायास्तन्त्रत्वे आत्मादौ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008908, "chapter_id": 8715, "verse_number": "5.12", "content_sanskrit": "ननु तर्हि योग्यानुपलब्धिरूपं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008909, "chapter_id": 8715, "verse_number": "5.13", "content_sanskrit": "एतेनैव वर्णोऽनित्यः उत्पत्तिमत्त्वे सति भावत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008910, "chapter_id": 8715, "verse_number": "5.14", "content_sanskrit": "आद्ये हेतावुत्पत्तिमत्त्वस्य द्वितीये..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008911, "chapter_id": 8715, "verse_number": "5.15", "content_sanskrit": "न चोत्कर्षस्य गुणत्वव्याप्यजात्या..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008912, "chapter_id": 8715, "verse_number": "5.16", "content_sanskrit": "किञ्च स एवायं गकार इतिप्रत्यभिज्ञाबाधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008913, "chapter_id": 8715, "verse_number": "5.17", "content_sanskrit": "नचेयंप्रत्यभिज्ञा पुरोवर्तिनि गकारे गत्वेनोपस्थितगकारा-भेदविषया..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008914, "chapter_id": 8715, "verse_number": "5.18", "content_sanskrit": "नच जात्यभेदोऽपि व्यक्तौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008915, "chapter_id": 8715, "verse_number": "5.19", "content_sanskrit": "इयांस्तु भेदः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008916, "chapter_id": 8715, "verse_number": "5.20", "content_sanskrit": "नचैकदैव चैत्रमैत्रोच्चारितयोर्गकारयोस्तारत्वमन्द्रत्वे दृश्येते इति वाच्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008917, "chapter_id": 8715, "verse_number": "5.21", "content_sanskrit": "अत एव स्वर्णत्वादिव्याप्यघटत्वादिकमपि नाना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008918, "chapter_id": 8715, "verse_number": "5.22", "content_sanskrit": "यदि च बुभुत्सोत्तेजिका तर्हि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008919, "chapter_id": 8715, "verse_number": "5.23", "content_sanskrit": "नचोच्चारणस्य व्यञ्जकत्वान्नोक्तदोष इति वाच्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900008920, "chapter_id": 8715, "verse_number": "5.24", "content_sanskrit": "तदेवमुपपत्तिविरोधादापणे ध्वनिरुत्पन्नः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900008921, "chapter_id": 8715, "verse_number": "5.25", "content_sanskrit": "तदेतदभिप्रेत्योक्तं भगवत्पादैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900008922, "chapter_id": 8715, "verse_number": "5.26", "content_sanskrit": "एतेन ‘‘प्रत्यभिज्ञानन्तरमुत्पत्त्यादिप्रत्ययानां..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900008923, "chapter_id": 8715, "verse_number": "5.27", "content_sanskrit": "ननूत्पत्त्यादिधीर्न तावत्स्मर्यमाणारोपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900008924, "chapter_id": 8715, "verse_number": "5.28", "content_sanskrit": "सत्प्रतिपक्षाणि च । तथा हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900008925, "chapter_id": 8715, "verse_number": "5.29", "content_sanskrit": "अत्राद्ये हेतौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900008926, "chapter_id": 8715, "verse_number": "5.30", "content_sanskrit": "सप्तमे शब्दपदम् केवलान्वयिनो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900008927, "chapter_id": 8715, "verse_number": "5.31", "content_sanskrit": "ननु वर्णानां नित्यत्वे सर्वदोपलब्धिः स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900008928, "chapter_id": 8715, "verse_number": "5.32", "content_sanskrit": "ननु वर्णा नप्रतिनियतव्यञ्जकव्यङ्ग्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900008929, "chapter_id": 8715, "verse_number": "5.33", "content_sanskrit": "अत एव– ‘‘प्रदीपे व्यज्यते जातिर्न तु नीरजनीलिमा’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900008930, "chapter_id": 8715, "verse_number": "5.34", "content_sanskrit": "ननु परस्परव्यभिचारिव्यञ्जकाव्यङ्ग्यत्वं साध्यम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900008931, "chapter_id": 8715, "verse_number": "5.35", "content_sanskrit": "किं चैवं सति वर्णाः परस्परं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900008932, "chapter_id": 8715, "verse_number": "5.36", "content_sanskrit": "नचेदं गौरवं फलमुखम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900008933, "chapter_id": 8715, "verse_number": "5.37", "content_sanskrit": "नच नित्यत्वे कालादिकृतक्रमाभावादुच्चारणक्रमस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900008934, "chapter_id": 8715, "verse_number": "5.38", "content_sanskrit": "नचैवं पदादिभावस्याभिव्यक्तिघटितत्वे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]