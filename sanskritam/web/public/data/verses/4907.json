[{"id": 2184068, "chapter_id": 4907, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184069, "chapter_id": 4907, "verse_number": "१", "content_sanskrit": "तात धर्मार्थकामानां श्रोतुमिच्छामि निश्चयम् ।\nलोकयात्रा हि कार्त्स्न्येन त्रिष्वेतेषु प्रतिष्ठिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184070, "chapter_id": 4907, "verse_number": "२", "content_sanskrit": "धर्मार्थकामाः किंमूलास्त्रयाणां प्रभवश्च कः ।\nअन्योन्यं चानुषज्जन्ते वर्तन्ते च पृथक् पृथक्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184071, "chapter_id": 4907, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184072, "chapter_id": 4907, "verse_number": "३", "content_sanskrit": "यदा ते स्युः सुमनसो लोकसंस्थार्थनिश्चये ।\nकालप्रभवसंस्थासु सज्जन्ते च त्रयस्तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184073, "chapter_id": 4907, "verse_number": "४", "content_sanskrit": "धर्ममूलस्तु देहोऽर्थः कामोऽर्थफलमुच्यते ।\nसङ्कल्पमूलास्ते सर्वे सङ्कल्पो विषयात्मकः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184074, "chapter_id": 4907, "verse_number": "५", "content_sanskrit": "विषयाश्चैव कार्त्स्न्येन सर्व आहारसिद्धये ।\nमूलमेतत् त्रिवर्गस्य निवृत्तिर्मोक्ष उच्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184075, "chapter_id": 4907, "verse_number": "६", "content_sanskrit": "धर्मः शरीरसंगुप्तिर्धर्मार्थं चार्थ इष्यते ।\nकामो रतिफलश्चात्र सर्व एते रजस्वलाः ।\nसन्निकृष्टांश्चरेदेनान्न चैनान् मनसा त्यजेत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184076, "chapter_id": 4907, "verse_number": "७", "content_sanskrit": "वियुक्तस्तपसा सर्वान् धर्मादीन् कामनैष्ठिकान् ।\nश्रेष्ठबुद्धिस्त्रिवर्गस्य यदयं प्राप्नुयात् क्षणात् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184077, "chapter_id": 4907, "verse_number": "८", "content_sanskrit": "बुद्ध्या बुद्धिरिहार्थेषु तदज्ञाननिकृष्ठया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184078, "chapter_id": 4907, "verse_number": "९", "content_sanskrit": "अर्थार्थमन्यद् भवति विपरीतमथापरम् ।\nअनर्थार्थमवाप्यार्थमन्यत्राद्योपकारकम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184079, "chapter_id": 4907, "verse_number": "१०", "content_sanskrit": "अपध्यानमलो धर्मो मलोऽर्थस्य निगूहनम् ।\nसम्प्रमोदमलः कामो भूयः स्वगुणवर्जितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184080, "chapter_id": 4907, "verse_number": "११", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nकामन्दस्य च संवादमङ्गारिष्ठस्य चोभयोः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184081, "chapter_id": 4907, "verse_number": "१२", "content_sanskrit": "कामन्दमृषिमासीनमभिवाद्य नराधिपः ।\nअङ्गारिष्ठोऽथ पप्रच्छ कृत्वा समयपर्ययम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184082, "chapter_id": 4907, "verse_number": "१३", "content_sanskrit": "यः पापं कुरुते राजा काममोहबलात्कृतः ।\nप्रत्यासन्नस्य तस्यर्षे किं स्यात् पापप्रणाशनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184083, "chapter_id": 4907, "verse_number": "१४", "content_sanskrit": "अधर्मं धर्म इति ह योऽज्ञानादाचरेदिह ।\nतं चापि प्रथितं लोके कथं राजा निवर्तयेत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184084, "chapter_id": 4907, "verse_number": "", "content_sanskrit": "कामन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184085, "chapter_id": 4907, "verse_number": "१५", "content_sanskrit": "यो धर्मार्थौ समुत्सृज्य काममेवानुवर्तते ।\nस धर्मार्थपरित्यागात् प्रज्ञानाशमिहार्च्छति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184086, "chapter_id": 4907, "verse_number": "१६", "content_sanskrit": "प्रज्ञाप्रणाशको मोहस्तथा धर्मार्थनाशकः ।\nतस्मान्नास्तिकता चैव दुराचारश्च जायते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2184087, "chapter_id": 4907, "verse_number": "१७", "content_sanskrit": "दुराचारान् यदा राजा प्रदुष्टान्न नियच्छति ।\nतस्मादुद्विजते लोकः सर्पाद् वेश्मगतादिव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2184088, "chapter_id": 4907, "verse_number": "१८", "content_sanskrit": "तं प्रजा नानुवर्तन्ते ब्राह्मणा नच साधवः ।\nततः संक्षयमाप्नोति तथाऽपध्वस्त एव च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2184089, "chapter_id": 4907, "verse_number": "१९", "content_sanskrit": "अपध्वस्तस्त्ववमतो दुःखं जीवति जीवितम् ।\nजीवेच्च यदपध्वस्तस्तच्छुद्धं मरणं भवेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2184090, "chapter_id": 4907, "verse_number": "२०", "content_sanskrit": "अत्रैतदाहुराचार्याः पापस्य परिबर्हणम् ।\nसेवितव्या त्रयी विद्या सत्कारो ब्राह्मणेषु च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2184091, "chapter_id": 4907, "verse_number": "२१", "content_sanskrit": "महामना भवेद् धर्मे विवहेच्च महाकुले ।\nब्राह्मणांश्चापि सेवेत क्षमायुक्तान् मनस्विनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2184092, "chapter_id": 4907, "verse_number": "२२", "content_sanskrit": "जपेदुदकशीलः स्यात् सुमुखो नान्यदास्थितः ।\nधर्मान्वितान् सम्प्रविशेद् बहिः कृत्वैव दुष्कृतीन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2184093, "chapter_id": 4907, "verse_number": "", "content_sanskrit": "प्रसादयेन्मधुरया वाचाप्यथ च कर्मणा ।\nइत्यस्मीति वदेन्नित्यं परेषां कीर्तयन् गुणान्\t॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2184094, "chapter_id": 4907, "verse_number": "२३", "content_sanskrit": "अपापो ह्येवमाचारः क्षिप्रं बहुमतो भवेत् ।\nपापान्यपि च कृच्छ्राणि शमयेन्नात्र संशयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2184095, "chapter_id": 4907, "verse_number": "२४", "content_sanskrit": "गुरवोऽपि परं धर्मं यद् ब्रूयुस्तत् तथा कुरु ।\nगुरूणां हि प्रसादाद्धि श्रेयः परमवाप्स्यसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2184096, "chapter_id": 4907, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुर्विंशत्यधिकशततमोध्यायः ॥ १२४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]