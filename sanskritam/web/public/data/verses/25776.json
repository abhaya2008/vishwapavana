[{"id": 7005776000, "chapter_id": 25776, "verse_number": "२४९-१", "content_sanskrit": "क्षीरोदमथनप्रकरणवर्णनम् ।\nऋषय ऊचुः ।\nनारायणस्य माहात्म्यं श्रुत्वा सूत! यथाक्रमम् ।\nन तृप्तिर्जायतेऽस्माकमतः पुनरिहोच्यताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005776001, "chapter_id": 25776, "verse_number": "२४९-२", "content_sanskrit": "कथं देवा गताः पूर्वममरत्वं विचक्षणाः ।\nतपसा कर्मणा वापि प्रसादात्कस्य तेजसा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005776002, "chapter_id": 25776, "verse_number": "२४९-३", "content_sanskrit": "सूत उवाच ।\nयत्र नारायणो देवो महादेवश्च शूलधृक् ।\nतत्रामरत्वे सर्वेषां सहायौ तत्र तौ स्मृतौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005776003, "chapter_id": 25776, "verse_number": "२४९-४", "content_sanskrit": "पुरा देवासुरे युद्धे हताश्च शतशः सुरैः ।\nपुनः सञ्जीविनीं विद्यां प्रयोज्य भृगुनन्दनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005776004, "chapter_id": 25776, "verse_number": "२४९-५", "content_sanskrit": "जीवापयति दैत्येन्द्रान् यथा सुप्तोत्थितानिव ।\nतस्य तुष्टेन देवेन शङ्करेण महात्मना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005776005, "chapter_id": 25776, "verse_number": "२४९-६", "content_sanskrit": "मृतसञ्जीविनी नाम विद्या दत्ता महाप्रभा ।\nतां तु माहेश्वरीं विद्यां महेश्वर मुखोद्गताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005776006, "chapter_id": 25776, "verse_number": "२४९-७", "content_sanskrit": "भार्गवे संस्थितां दृष्ट्वा मुमुहुः सर्वदानवाः ।\nततोऽमरत्वं दैत्यानां कृतं शुक्रेण धीमता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005776007, "chapter_id": 25776, "verse_number": "२४९-८", "content_sanskrit": "या नास्ति सर्वलोकानां देवानां सर्वरक्षसाम् ।\nन नागानामृषीणाञ्च न च ब्रह्मेन्द्र विष्णुषु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005776008, "chapter_id": 25776, "verse_number": "२४९-९", "content_sanskrit": "तां लब्ध्वा शङ्कराच्छुक्रः परां निर्गतिमागतः ।\nततो दैवासुरो घोरः समरः सुमहानभूत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005776009, "chapter_id": 25776, "verse_number": "२४९-१०", "content_sanskrit": "तत्र देवैर्हतान् दैत्यान् शुक्रो विद्याबलेन च ।\nउत्थापयति दैत्येन्द्रान् लीलयैव विचक्षणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005776010, "chapter_id": 25776, "verse_number": "२४९-११", "content_sanskrit": "एवम्विधेन शक्रस्तु बृहस्पतिरुदारधीः ।\nहन्यमानास्ततो देवाः शतशोऽथ सहस्रशः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005776011, "chapter_id": 25776, "verse_number": "२४९-१२", "content_sanskrit": "विषण्णवदनाः सर्वे बभूवुर्विकलेन्द्रियाः ।\nततस्तेषु विषण्णेषु भगवान् कमलोद्भवः  ।\nमेरुपृष्ठे सुरेन्द्राणामिदमाह जगत्पतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005776012, "chapter_id": 25776, "verse_number": "२४९-१३", "content_sanskrit": "ब्रह्मोवाच ।\nदेवाः! श्रुणुत मद्वाक्यं तत्तथैव निरूप्यताम् ।\nक्षिपतां दानवै- सार्द्धं सख्यमत्र प्रवर्तताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005776013, "chapter_id": 25776, "verse_number": "२४९-१४", "content_sanskrit": "क्रियताममृतोद्योगो मथ्यतां क्षीरवारिधिः ।\nसहायं वरुणं कृत्वा चक्रपाणिर्विबोध्यताम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005776014, "chapter_id": 25776, "verse_number": "२४९-१५", "content_sanskrit": "मन्थानं मन्दरं कृत्वा शेषनेत्रेण वेष्टितम् ।\nदानवेन्द्रो बलि स्वामी स्तोककालं निवेश्यताम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005776015, "chapter_id": 25776, "verse_number": "२४९-१६", "content_sanskrit": "प्रार्थ्यतां कूर्मरूपश्च पाताले विष्णुरव्ययः ।\nप्रार्थ्यतां मन्दरः शैलः मन्थकार्यं प्रवर्त्यताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005776016, "chapter_id": 25776, "verse_number": "२४९-१७", "content_sanskrit": "तच्छ्रुत्वा वचनं देवा जग्मुर्दानवमन्दिरम् ।\nअलं विरोधेन वयं भृत्यास्तव बले!ऽधुना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005776017, "chapter_id": 25776, "verse_number": "२४९-१८", "content_sanskrit": "क्रियताममृतोद्योगो व्रियतां शेषनेत्रकम् ।\nत्वया चोत्पादिते दैत्य! अमृतेऽमृतमन्थने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005776018, "chapter_id": 25776, "verse_number": "२४९-१९", "content_sanskrit": "भविष्यामोऽमराः सर्वे त्वत्प्रसादान्न संशयः ।\nएवमुक्तस्तदा देवैः परितुष्टः स दानवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005776019, "chapter_id": 25776, "verse_number": "२४९-२०", "content_sanskrit": "यथा वदत हे देवाः! तथा कार्यं मयाऽधुना ।\nशक्तोऽहमेक एवात्र मथितुं क्षीरवारिधिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005776020, "chapter_id": 25776, "verse_number": "२४९-२१", "content_sanskrit": "आहरिष्येऽमृतं दिव्यममृतत्वाय वोऽधुना ।\nसुदूरादाश्रयं प्राप्तान् प्रणतानपि वैरिणः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005776021, "chapter_id": 25776, "verse_number": "२४९-२२", "content_sanskrit": "यो न पूजयते भक्त्या प्रेत्य चेह विनश्यति ।\nपालयिष्यामि वः सर्वानधुना स्नेहमास्तितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005776022, "chapter_id": 25776, "verse_number": "२४९-२३", "content_sanskrit": "एवमुक्त्वा स दैत्येन्द्रो देवैः सह ययौ तदा ।\nमन्दरं प्रार्थयामास सहायत्वे धराधरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005776023, "chapter_id": 25776, "verse_number": "२४९-२४", "content_sanskrit": "सखा भवत्वमस्माकमधुनाऽमृतमन्थने ।\nसुरासुराणां सर्वेषां महत्कार्यमिदं जगत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005776024, "chapter_id": 25776, "verse_number": "२४९-२५", "content_sanskrit": "तथेति मन्दरः प्राह यद्याधारो भवेन् मम ।\nयत्र स्थित्वा भ्रमिष्यामि मथिष्ये वरुणालयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005776025, "chapter_id": 25776, "verse_number": "२४९-२६", "content_sanskrit": "कल्प्यतां नेत्रकार्ये यः शक्तः स्याद्वेष्टने मम ।\nततस्तु निर्गतौ देवौ कूर्मशेषौ महाबलौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005776026, "chapter_id": 25776, "verse_number": "२४९-२७", "content_sanskrit": "विष्णोर्भागौ चतुर्थांशाद्धरण्या धारणे स्थितौ ।\nऊचतुर्गर्वसंयुक्तं वचनं शेषकच्छपौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005776027, "chapter_id": 25776, "verse_number": "२४९-२८", "content_sanskrit": "त्रैलोक्यधारणेनापि न ग्लानिर्मम जायते ।\nकिमु मन्दरकात्क्षुद्रात् घुटिकासन्निभादिह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005776028, "chapter_id": 25776, "verse_number": "२४९-२९", "content_sanskrit": "शेष उवाच ।\nब्रह्माण्डवेष्टनेनापि ब्रह्माण्डमथनेन वा ।\nन मे ग्लानिर्भवेद्देहे किमु मन्दरवर्तने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005776029, "chapter_id": 25776, "verse_number": "२४९-३०", "content_sanskrit": "तत उत्पाट्य तं शैलं तत्क्षणात् क्षीरसागरे ।\nचिक्षेप लीलया नागः कूर्मश्चाधः स्थितस्तदा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005776030, "chapter_id": 25776, "verse_number": "२४९-३१", "content_sanskrit": "निराधारं यदा शैलं नशेकुर्देवदानवाः ।\nमन्दरभ्रमणं कर्तुं क्षीरोदमथने तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005776031, "chapter_id": 25776, "verse_number": "२४९-३२", "content_sanskrit": "नारायणनिवासन्ते जग्मुर्बलि समन्विताः ।\nयत्रास्ते देवदेवेशः स्वयमेव जनार्दनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005776032, "chapter_id": 25776, "verse_number": "२४९-३३", "content_sanskrit": "तत्रापश्यन्त तन्देवं सितपद्मप्रभं शुभम्  ।\nयोगनिद्रासु निरतं पीतवाससमच्युतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005776033, "chapter_id": 25776, "verse_number": "२४९-३४", "content_sanskrit": "हारकेयूरनद्धाङ्गमहिपर्यङ्क संस्थितम् ।\nपादपद्मेन पद्मायाः स्पृशन्तं नाभिमण्डलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005776034, "chapter_id": 25776, "verse_number": "२४९-३५", "content_sanskrit": "स्वपक्षव्यजनेनाथ वीज्यमानङ्गरुत्मता ।\nस्तूयमानं समन्ताच्च सिद्धचारणकिन्नरैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005776035, "chapter_id": 25776, "verse_number": "२४९-३६", "content_sanskrit": "आम्नायैर्मूर्त्तिमद्भिश्च स्तूयमानं समन्ततः ।\nसव्यबाहूपधानं तन्तुष्टुवुर्देवदानवाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005776036, "chapter_id": 25776, "verse_number": "२४९-३७", "content_sanskrit": "कृताञ्जलिपुटाः सर्वे प्रणताः सर्वतो दिशम् ।\nदेवदानवा ऊचुः ।\nनमो लोकत्रयाध्यक्ष! तेजसामितभास्कर! ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005776037, "chapter_id": 25776, "verse_number": "२४९-३८", "content_sanskrit": "नमो विष्णो! नमो जिष्णो! नमस्ते कैटभार्दन! ।\nनमः सर्गक्रियाकर्त्रे जगत्पालयते नमः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005776038, "chapter_id": 25776, "verse_number": "२४९-३९", "content_sanskrit": "रुद्ररूपाय शर्व्वाय नमः संहारकारिणे ।\nनमः शूलाबुधाधृष्य नमो दानवघातिने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005776039, "chapter_id": 25776, "verse_number": "२४९-४०", "content_sanskrit": "नमः क्रमत्रयाक्रान्त त्रैलोक्यायाभवाय च ।\nनमः प्रचण्डदैत्येन्द्र कुलकाल महानल! ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005776040, "chapter_id": 25776, "verse_number": "२४९-४१", "content_sanskrit": "नमो नाभहृदोद्भूत पद्मगर्भ महाचल! ।\nपद्मभूत! महाभूत! कर्त्रे हर्त्रे जगत्प्रिय! ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005776041, "chapter_id": 25776, "verse_number": "२४९-४२", "content_sanskrit": "जनिता सर्वलोकेश! क्रिया कारणकारिणे ।\nअमरारि विनाशाय महासमरशालिने ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005776042, "chapter_id": 25776, "verse_number": "२४९-४३", "content_sanskrit": "लक्ष्मीमुखाब्ज मधुप! नमः कीर्तिनिवासिने ।\nअस्माकममरत्वाय ध्रियतां ध्रियतामयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005776043, "chapter_id": 25776, "verse_number": "२४९-४४", "content_sanskrit": "मन्दरः सर्वशैलानामयुतायुत विस्तृतः ।\nअनन्तबलबाहुभ्यामवष्टभ्यैकपाणिना ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005776044, "chapter_id": 25776, "verse_number": "२४९-४५", "content_sanskrit": "मथ्यताममृतं देव! स्वधा स्वाहार्थकामिनाम् ।\nततः श्रुत्वा स भगवान् स्तोत्रपूर्व्वं वचस्तदा ।\nविहाय योगनिद्रान्तामुवाच मधुसूदनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005776045, "chapter_id": 25776, "verse_number": "२४९-४६", "content_sanskrit": "श्रीभगवानुवाच ।\nस्वागतं विबुधाः! सर्वे किमागमनकारणम् ।\nयस्मात्कार्य्यादिह प्राप्तस्तद् ब्रूत विगतज्वराः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005776046, "chapter_id": 25776, "verse_number": "२४९-४७", "content_sanskrit": "नारायणेनैव मुक्ताः प्रोचुस्तत्र दिवौकसः ।\nअमरत्वाय देवेश! मथ्यमाने महोदधौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005776047, "chapter_id": 25776, "verse_number": "२४९-४८", "content_sanskrit": "यथाऽमृतत्वं देवेश! तथा नः कुरु माधव! ।\nत्वया विना न तच्छक्यमस्माभिः कैटभार्दन! ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005776048, "chapter_id": 25776, "verse_number": "२४९-४९", "content_sanskrit": "प्राप्तुं तदमृतं नाथ! ततोऽग्रे भव नो विभो! ।\nइत्युक्तश्च ततो विष्णुरप्रधृष्योऽरिमर्दनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005776049, "chapter_id": 25776, "verse_number": "२४९-५०", "content_sanskrit": "जगाम देवैः सहितो यत्रासौ मन्दराचलः ।\nवेष्टितो भोगिभोगेन धृतश्चामरदानवैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005776050, "chapter_id": 25776, "verse_number": "२४९-५१", "content_sanskrit": "विषभीतास्ततो देवा यतः पुच्छं ततः स्थिताः ।\nमुखतो दैत्यसङ्घास्तु सैंहिकेयपुरः सराः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005776051, "chapter_id": 25776, "verse_number": "२४९-५२", "content_sanskrit": "सहस्रवदनं चास्य शिरः सव्येन पाणिना ।\nदक्षिणेन बलिर्देहं नागस्याकृष्टवांस्तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005776052, "chapter_id": 25776, "verse_number": "२४९-५३", "content_sanskrit": "दधारामृतमन्थानं मन्दरं चारुकन्दरम् ।\nनारायणः स भगवान् भुजयुग्मद्वयेन तु ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005776053, "chapter_id": 25776, "verse_number": "२४९-५४", "content_sanskrit": "ततो देवासुरैः सर्वैर्जयशब्दपुरः सरम् ।\nदिव्यं वर्षशतं साग्रं मथितः क्षीरसागरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005776054, "chapter_id": 25776, "verse_number": "२४९-५५", "content_sanskrit": "ततः श्रान्तास्तु ते सर्वे देवाः दैत्यपुरः सरः ।\nश्रान्तेषु तेषु देवेन्द्रो मेघो भूत्वाम्बुशीकरान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005776055, "chapter_id": 25776, "verse_number": "२४९-५६", "content_sanskrit": "ववर्षामृतकल्पांस्तान् ववौ वायुश्च शीतलः ।\nभग्नप्रायेषु देवेषु शान्तेषु कमलासनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005776056, "chapter_id": 25776, "verse_number": "२४९-५७", "content_sanskrit": "मथ्यतां मथ्यतां सिन्धुरित्युवाच पुनः पुनः ।\nअवश्यमुद्योगवतां श्रीरपारा भवेत्सदा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005776057, "chapter_id": 25776, "verse_number": "२४९-५८", "content_sanskrit": "ब्रह्मप्रोत्साहिताः देवा ममन्थुः पुनरम्बुधिम् ।\nभ्राम्यमाणे ततः शैले योजनायुतशेखरे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005776058, "chapter_id": 25776, "verse_number": "२४९-५९", "content_sanskrit": "निपेतुर्हस्तियूथानि वराहशरभादयः ।\nश्वापदायुतलक्षाणि तथा पुष्पफलाद्रुमाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005776059, "chapter_id": 25776, "verse_number": "२४९-६०", "content_sanskrit": "ततः फलानां वीर्य्येण पुष्पौषधिरसेन च ।\nक्षीरसङ्घर्षणाच्चापि दधिरूपमजायत ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005776060, "chapter_id": 25776, "verse_number": "२४९-६१", "content_sanskrit": "ततस्तु सर्वजीवेषु चूर्णितेषु सहस्रशः ।\nतदम्बुमेदसोत्सर्गाद् वारुणी समपद्यत ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005776061, "chapter_id": 25776, "verse_number": "२४९-६२", "content_sanskrit": "वारुणीगन्धमाघ्राय मुमुदुर्देवदानवाः ।\nतदा स्वादेन बलिनो देवदैत्यादयोऽभवन् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005776062, "chapter_id": 25776, "verse_number": "२४९-६३", "content_sanskrit": "ततोऽतिवेगाज्जगृहुर्नागेन्द्रं सर्वतोऽसुराः ।\nमन्थानं मन्थयष्टिस्तु मेरुस्तत्राचलोऽभवत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005776063, "chapter_id": 25776, "verse_number": "२४९-६४", "content_sanskrit": "अभवच्चाग्रतो विष्णुर्भुजमन्दरबन्धनः ।\nस वासुकिफणालग्न पाणिः कृष्णो व्यराजत ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005776064, "chapter_id": 25776, "verse_number": "२४९-६५", "content_sanskrit": "यथा नीलोत्पलैर्युक्तो ब्रह्मदण्डोऽतिविस्तरः ।\nध्वनिर्मेघसहस्रस्य जलधेरुत्थितस्तदा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005776065, "chapter_id": 25776, "verse_number": "२४९-६६", "content_sanskrit": "भागे द्वितीये मघवानादित्यस्तु ततःपरम् ।\nततो रुद्रा महोत्साहा वसवो गुह्यकादयः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005776066, "chapter_id": 25776, "verse_number": "२४९-६७", "content_sanskrit": "पुरतो विप्रचित्तिश्च नमुचिर्वृत्रशम्बरौ ।\nद्विमूर्द्धा वज्रदंष्ट्रश्च सौंहिकेयो बलिस्तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005776067, "chapter_id": 25776, "verse_number": "२४९-६८", "content_sanskrit": "एते चान्ये च बहवो मुखभागमुपस्थिताः ।\nममन्थुरम्बुधिं दृप्ता बलतेजो विभूषिताः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005776068, "chapter_id": 25776, "verse_number": "२४९-६९", "content_sanskrit": "बभूवात्र महाघोषो महामेघरवोपमः ।\nउदधेर्मथ्यमानस्य मन्दरेण सुरासुरैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005776069, "chapter_id": 25776, "verse_number": "२४९-७०", "content_sanskrit": "तत्र नानाजलचरा वनिर्धूता महाद्रिणा ।\nविलयं समुपाजग्मुः शतशोऽथ सहस्रशः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005776070, "chapter_id": 25776, "verse_number": "२४९-७१", "content_sanskrit": "वारुणानि च भूतानि विविधानि महेश्वरः ।\nपातालतलवासीनि विलयं समुपानयत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005776071, "chapter_id": 25776, "verse_number": "२४९-७२", "content_sanskrit": "तस्मिंश्च भ्राम्यमाणेऽद्रौ सङ्घृष्टाश्च परस्परम् ।\nन्यपतन् पतगोपेताः पर्वताग्रान्महाद्रुमाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005776072, "chapter_id": 25776, "verse_number": "२४९-७३", "content_sanskrit": "तेषां सङ्घर्षणाच्चाग्निरर्चिभिः प्रज्वलन् मुहुः ।\nविद्युद्भिरिव नीलाभ्रमावृणोत् मन्दरं गिरिम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005776073, "chapter_id": 25776, "verse_number": "२४९-७४", "content_sanskrit": "ददाह कुञ्जरांश्चैव सिंहांश्चैव विनिःसृतान् ।\nविगतासूनि सर्वाणि सत्वानि विविधानि च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005776074, "chapter_id": 25776, "verse_number": "२४९-७५", "content_sanskrit": "तमग्निममरश्रेष्ठः प्रदहन्तमितस्ततः ।\nवारिणा मेघजेनेन्द्रः शमयामास सर्वतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005776075, "chapter_id": 25776, "verse_number": "२४९-७६", "content_sanskrit": "ततो नाना रसास्तत्र सुस्रुवुः सागराम्भसि ।\nमहाद्रुमाणां निर्यासा बहवश्चौषधीरसाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005776076, "chapter_id": 25776, "verse_number": "२४९-७७", "content_sanskrit": "तेषाममृतवीर्य्याणां रसानां पयसैव च ।\nअमरत्वं सुरा जग्मुः काञ्चनच्छविसन्निभाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005776077, "chapter_id": 25776, "verse_number": "२४९-७८", "content_sanskrit": "अथ तस्य समुद्रस्य तज्जातमुदकं पयः ।\nरसान्तरैर्विमिश्रञ्च ततः क्षीरादभूद् घृतम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005776078, "chapter_id": 25776, "verse_number": "२४९-७९", "content_sanskrit": "तता ब्रह्माणमासीनं देवा वचनमब्रुवन् ।\nश्रान्ताः स्म सुभृशं ब्रह्मन्नोद्भवत्यमृतञ्च यत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005776079, "chapter_id": 25776, "verse_number": "२४९-८०", "content_sanskrit": "ऋते नारायणात् सर्वे दैत्या देवोत्तमास्तथा ।\nचिरायितमिदञ्चापि सागरस्य तु मन्थनम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005776080, "chapter_id": 25776, "verse_number": "२४९-८१", "content_sanskrit": "ततो नारायणं देवं ब्रह्मा वचनमब्रवीत् ।\nविधत्स्वैषां बलं विष्णो! भवानेव परायणम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005776081, "chapter_id": 25776, "verse_number": "२४९-८२", "content_sanskrit": "विष्णुरुवाच ।\nबलं ददामि सर्वेषां कर्मैतद्ये समास्थिताः ।\nक्षुभ्यतां क्रमशः सर्वैर्मन्दरः परिवर्त्यताम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]