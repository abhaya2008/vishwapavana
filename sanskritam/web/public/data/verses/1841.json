[{"id": 2038493, "chapter_id": 1841, "verse_number": "५-८६-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038494, "chapter_id": 1841, "verse_number": "५-८६-१", "content_sanskrit": "उपप्लाव्यादिह क्षत्तरुपायातो जनार्दनः।\nवृकस्थले निवसति स च प्रातरिहैष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038495, "chapter_id": 1841, "verse_number": "५-८६-२", "content_sanskrit": "आहुकानामधिपतिः पुरोगः सर्वसात्वताम्।\nमहामना महावीर्यो महासत्वो जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038496, "chapter_id": 1841, "verse_number": "५-८६-३", "content_sanskrit": "स्फीतस्य वृष्णिराष्ट्रस्य भर्ता गोप्ता च माधवः ।\nत्रयाणामपि लोकानां भगवान्प्रपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038497, "chapter_id": 1841, "verse_number": "५-८६-४", "content_sanskrit": "वृष्ण्यन्धकाः सुमनसो यस्य प्रज्ञामुपासते।\nआदित्या वसवो रुद्रा यथा बुद्धिं बृहस्पतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038498, "chapter_id": 1841, "verse_number": "५-८६-५", "content_sanskrit": "तस्मै पूजां प्रयोक्ष्यामि दाशार्हाय महात्मने ।\nप्रत्यक्षं तव धर्मज्ञ तां मे कथयतः श्रुणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038499, "chapter_id": 1841, "verse_number": "५-८६-६", "content_sanskrit": "एकवर्णैः सुक्लृप्ताङ्गैर्बाह्लिजातैर्हयोत्तमैः।\nचतुर्यक्तान्रथांस्तस्मै रौक्मान्दास्यामि षोडश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038500, "chapter_id": 1841, "verse_number": "५-८६-७", "content_sanskrit": "नित्यप्रभिन्नान्मातङ्गानीषादन्तान्प्रहारिणः।\nअष्टानुचरमेकैकमष्टौ दास्यामि कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038501, "chapter_id": 1841, "verse_number": "५-८६-८", "content_sanskrit": "दासीनामप्रजातानां शुभानां रुक्मवर्चसाम् ।\nशतमस्मै प्रदास्यामि दासानामपि तावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038502, "chapter_id": 1841, "verse_number": "५-८६-९", "content_sanskrit": "आविकं च सुखस्पर्शं पार्वतीयैरुपाहृतम् ।\nतदप्यस्मै प्रदास्यामि सहस्त्राणि दाशाष्ट च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038503, "chapter_id": 1841, "verse_number": "५-८६-१०", "content_sanskrit": "अजिनानां सहस्राणि चीनदेशोद्भवानि च।\nतान्यप्यस्मै प्रदास्यामि यावदर्हति केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038504, "chapter_id": 1841, "verse_number": "५-८६-११", "content_sanskrit": "दिवा रात्रौ च भात्येष सुतेजा विमलो मणिः ।\nतमप्यस्मै प्रदास्यामि तमर्हति हि केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038505, "chapter_id": 1841, "verse_number": "५-८६-१२", "content_sanskrit": "एकेनाभिपतत्यह्ना योजनानि चतुर्दश ।\nयानमश्वतरीयुक्तं दास्ये तस्मै तदप्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038506, "chapter_id": 1841, "verse_number": "५-८६-१३", "content_sanskrit": "यावन्ति वाहनान्यस्य यावन्तः पुरुषाश्च ते ।\nततोष्टगुणमप्यस्मै भोज्यं दास्याम्यहं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038507, "chapter_id": 1841, "verse_number": "५-८६-१४", "content_sanskrit": "मम पुत्राश्च पौत्रश्च सर्वे दुर्योधनादृते।\nप्रत्युद्यास्यन्ति दाशार्हं रथैर्मृष्टैः स्वलङ्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038508, "chapter_id": 1841, "verse_number": "५-८६-१५", "content_sanskrit": "स्वलङ्कृताश्च कल्याण्यः पादैरेव सहस्रशः।\nवारमुख्या महाभागं प्रत्युद्यास्यन्ति केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038509, "chapter_id": 1841, "verse_number": "५-८६-१६", "content_sanskrit": "नगरादपि याः काश्चिद्गमिष्यन्ति जनार्दनम् ।\nद्रष्टुं कन्याश्च कल्याण्यस्ताश्च यास्यन्त्यनावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038510, "chapter_id": 1841, "verse_number": "५-८६-१७", "content_sanskrit": "सस्त्रीपुरुषबालं च नगरं मधुसूदनम् ।\nउदीक्षतां महात्मानं भानुमन्तमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038511, "chapter_id": 1841, "verse_number": "५-८६-१८", "content_sanskrit": "महाध्वजपताकाश्च क्रियन्तां सर्वतो दिशः।\nजलावसिक्तो विरजाः पन्थास्तस्येति चान्वशात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038512, "chapter_id": 1841, "verse_number": "५-८६-१९", "content_sanskrit": "दुःशासनस्य च गृहं दुर्योधनगृहाद्वरम् ।\nतदद्य क्रियतां क्षिप्रं सुसंमृष्टमलङ्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038513, "chapter_id": 1841, "verse_number": "५-८६-२०", "content_sanskrit": "एतद्धि रुचिराकारैः प्रासादैरुपशोभितम् ।\nशिवं च रमणीयं च सर्वर्तु सुमहाधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038514, "chapter_id": 1841, "verse_number": "५-८६-२१", "content_sanskrit": "सर्वमस्मिन्गृहे रत्नं मम दुर्योधनस्य च।\nयद्यदर्हति वार्ष्णेयस्तत्तद्देयमसंशयम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038515, "chapter_id": 1841, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वमि षडशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]