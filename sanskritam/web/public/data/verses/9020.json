[{"id": 5000020000, "chapter_id": 9020, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000020001, "chapter_id": 9020, "verse_number": "१-२०-१", "content_sanskrit": "तच्छ्रुत्वा राजशार्दूलो विश्वामित्रस्य भाषितम् ।\nमुहूर्तमिव निःसंज्ञः संज्ञावानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000020002, "chapter_id": 9020, "verse_number": "१-२०-२", "content_sanskrit": "ऊनषोडशवर्षो मे रामो राजीवलोचनः ।\nन युद्धयोग्यतामस्य पश्यामि सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000020003, "chapter_id": 9020, "verse_number": "१-२०-३", "content_sanskrit": "इयमक्षौहिणी सेना यस्याहं पतिरीश्वरः ।\nअनया सहितो गत्वा योद्धाहं तैर्निशाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000020004, "chapter_id": 9020, "verse_number": "१-२०-४", "content_sanskrit": "इमे शूराश्च विक्रान्ता भृत्या मेऽस्त्रविशारदाः ।\nयोग्या रक्षोगणैर्योद्धुं न रामं नेतुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000020005, "chapter_id": 9020, "verse_number": "१-२०-५", "content_sanskrit": "अहमेव धनुष्पाणिर्गोप्ता समरमूर्धनि ।\nयावत् प्राणान् धरिष्यामि तावद् योत्स्ये निशाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000020006, "chapter_id": 9020, "verse_number": "१-२०-६", "content_sanskrit": "निर्विघ्ना व्रतचर्या सा भविष्यति सुरक्षिता ।\nअहं तत्र गमिष्यामि न रामं नेतुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000020007, "chapter_id": 9020, "verse_number": "१-२०-७", "content_sanskrit": "बालो ह्यकृतविद्यश्च न च वेत्ति बलाबलम् ।\nन चास्त्रबलसंयुक्तो न च युद्धविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000020008, "chapter_id": 9020, "verse_number": "१-२०-८", "content_sanskrit": "न चासौ रक्षसां योग्यः कूटयुद्धा हि राक्षसाः ।\nविप्रयुक्तो हि रामेण मुहूर्तमपि नोत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000020009, "chapter_id": 9020, "verse_number": "१-२०-९", "content_sanskrit": "जीवितुं मुनिशार्दूल न रामं नेतुमर्हसि ।\nयदि वा राघवं ब्रह्मन् नेतुमिच्छसि सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000020010, "chapter_id": 9020, "verse_number": "१-२०-१०", "content_sanskrit": "चतुरङ्गसमायुक्तं मया सह च तं नय ।\nषष्टिर्वर्षसहस्राणि जातस्य मम कौशिक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000020011, "chapter_id": 9020, "verse_number": "१-२०-११", "content_sanskrit": "कृच्छ्रेणोत्पादितश्चायं न रामं नेतुमर्हसि ।\nचतुर्णामात्मजानां हि प्रीतिः परमिका मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000020012, "chapter_id": 9020, "verse_number": "१-२०-१२", "content_sanskrit": "ज्येष्ठे धर्मप्रधानेच न रामं नेतुमर्हसि ।\nकिंवीर्या राक्षसास्ते च कस्य पुत्राश्च के च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000020013, "chapter_id": 9020, "verse_number": "१-२०-१३", "content_sanskrit": "कथं प्रमाणाः के चैतान् रक्षन्ति मुनिपुंगव ।\nकथं च प्रतिकर्तव्यं तेषां रामेण रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000020014, "chapter_id": 9020, "verse_number": "१-२०-१४", "content_sanskrit": "मामकैर्वा बलैर्ब्रह्मन् मया वा कूटयोधिनाम् ।\nसर्वं मे शंस भगवन् कथं तेषां मया रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000020015, "chapter_id": 9020, "verse_number": "१-२०-१५", "content_sanskrit": "स्थातव्यं दुष्टभावानां वीर्योत्सिक्ता हि राक्षसाः ।\nतस्य तद् वचनं श्रुत्वा विश्वामित्रोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000020016, "chapter_id": 9020, "verse_number": "१-२०-१६", "content_sanskrit": "पौलस्त्यवंशप्रभवो रावणो नाम राक्षसः ।\nस ब्रह्मणा दत्तवरस्त्रैलोक्यं बाधते भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000020017, "chapter_id": 9020, "verse_number": "१-२०-१७", "content_sanskrit": "महाबलो महावीर्यो राक्षसैर्बहुभिर्वृतः ।\nश्रूयते च महाराज रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000020018, "chapter_id": 9020, "verse_number": "१-२०-१८", "content_sanskrit": "साक्षाद्वैश्रवणभ्राता पुत्रो विश्रवसो मुनेः ।\nयदा न खलु यज्ञस्य विघ्नकर्ता महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000020019, "chapter_id": 9020, "verse_number": "१-२०-१९", "content_sanskrit": "तेन संचोदितौ तौ तु राक्षसौ सुमहाबलौ ।\nमारीचश्च सुबाहुश्च यज्ञविघ्नं करिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000020020, "chapter_id": 9020, "verse_number": "१-२०-२०", "content_sanskrit": "इत्युक्तो मुनिना तेन राजोवाच मुनिं तदा ।\nनहि शक्तोऽस्मि संग्रामे स्थातुं तस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000020021, "chapter_id": 9020, "verse_number": "१-२०-२१", "content_sanskrit": "स त्वं प्रसादं धर्मज्ञ कुरुष्व मम पुत्रके ।\nमम चैवाल्पभाग्यस्य दैवतं हि भवान् गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000020022, "chapter_id": 9020, "verse_number": "१-२०-२२", "content_sanskrit": "देवदानवगन्धर्वा यक्षाः पतगपन्नगाः ।\nन शक्ता रावणं सोढुं किं पुनर्मानवा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000020023, "chapter_id": 9020, "verse_number": "१-२०-२३", "content_sanskrit": "स तु वीर्यवतां वीर्यमादत्ते युधि रावणः ।\nतेन चाहं न शक्तोऽस्मि संयोद्धुं तस्य वा बलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000020024, "chapter_id": 9020, "verse_number": "१-२०-२४", "content_sanskrit": "सबलो वा मुनिश्रेष्ठ सहितो वा ममात्मजैः ।\nकथमप्यमरप्रख्यं संग्रामाणामकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000020025, "chapter_id": 9020, "verse_number": "१-२०-२५", "content_sanskrit": "बालं मे तनयं ब्रह्मन् नैव दास्यामि पुत्रकम् ।\nअथ कालोपमौ युद्धे सुतौ सुन्दोपसुन्दयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000020026, "chapter_id": 9020, "verse_number": "१-२०-२६", "content_sanskrit": "यज्ञविघ्नकरौ तौ ते नैव दास्यामि पुत्रकम् ।\nमारीचश्च सुबाहुश्च वीर्यवन्तौ सुशिक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000020027, "chapter_id": 9020, "verse_number": "१-२०-२७", "content_sanskrit": "तयोरन्यतरं योद्धुं यास्यामि ससुहृद्गणः ।\nअन्यथा त्वनुनेष्यामि भवन्तं सहबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000020028, "chapter_id": 9020, "verse_number": "१-२०-२८", "content_sanskrit": "इति नरपतिजल्पनात् द्विजेन्द्रं\n:::कुशिकसुतं सुमहान् विवेश मन्युः ।\nसुहुत इव मखेऽग्निराज्यसिक्तः\n:::समभवदुज्ज्वलितो महर्षिवह्निः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000020029, "chapter_id": 9020, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]