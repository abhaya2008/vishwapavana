[{"id": 40007771, "chapter_id": 9020, "verse_number": "1", "content_sanskrit": "एवमुक्त्वा तु वचनं मारीचो रावणं ततः। गच्छावेत्यब्रवीद्दीनो भयाद्रात्रिंचरप्रभोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40007772, "chapter_id": 9020, "verse_number": "2", "content_sanskrit": "दृष्टश्चाहं पुनस्तेन शरचापासिधारिणा। मद्वधोद्यतशस्त्रेऽण विनष्टं जीवितं च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40007773, "chapter_id": 9020, "verse_number": "3", "content_sanskrit": "न हि रामं पराक्रम्य जीवन्प्रतिनिवर्तते। वर्तते प्रतिरूपोऽसौ यमदण्डहतस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40007774, "chapter_id": 9020, "verse_number": "4", "content_sanskrit": "किं नु शक्यं मया कर्तुमेवं त्वयि दुरात्मनि। एष गच्छाम्यहं तात स्वस्ति तेऽस्तु निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40007775, "chapter_id": 9020, "verse_number": "5", "content_sanskrit": "प्रहृष्टस्त्वभवत्तेन वचनेन स रावणः। परिष्वज्य सुसंश्लिष्टमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40007776, "chapter_id": 9020, "verse_number": "6", "content_sanskrit": "एतच्छौण्डीर्ययुक्तं ते मच्छन्दवशवर्तिनः। इदानीमसि मारीचः पूर्वमन्यो निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40007777, "chapter_id": 9020, "verse_number": "7", "content_sanskrit": "आरुह्यतामयं शीघ्रं रथो रत्नविभूषितः। मया सह तथा युक्तः पिशाचवदनैः खरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40007778, "chapter_id": 9020, "verse_number": "8", "content_sanskrit": "प्रलोभयित्वा वैदेहीं यथेष्टं गन्तुमर्हसि। तां शून्ये प्रसभं सीतामानयिष्यामि मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40007779, "chapter_id": 9020, "verse_number": "9", "content_sanskrit": "ततो रावणमारीचौ विमानमिव तं रथम्। आरुह्य ययतुश्शीघ्रं तस्मादाश्रममण्डलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40007780, "chapter_id": 9020, "verse_number": "10", "content_sanskrit": "तथैव तत्र पश्यन्तौ पत्तनानि वनानि च। गीरींश्च सरितस्सर्वा राष्ट्राणि नगराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40007781, "chapter_id": 9020, "verse_number": "11", "content_sanskrit": "समेत्य दण्डकारण्यं राघवस्याश्रमं ततः। ददर्श सह मारीचो रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40007782, "chapter_id": 9020, "verse_number": "12", "content_sanskrit": "अवतीर्य रथात्तस्मात्ततः काञ्चनभूषणात्। हस्ते गृहीत्वा मारीचं रावणो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40007783, "chapter_id": 9020, "verse_number": "13", "content_sanskrit": "एतदाश्रमपदं दृश्यते कदलीवृतम्। क्रियतां तत्सखे शीघ्रं यदर्थं वयमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40007784, "chapter_id": 9020, "verse_number": "14", "content_sanskrit": "स रावणवचश्श्रुत्वा मारीचो राक्षसस्तदा। मृगो भूत्वाऽश्रमद्वारि रामस्य विचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40007785, "chapter_id": 9020, "verse_number": "15", "content_sanskrit": "स तु तद्रूपमास्थाय महदद्भुतदर्शनम्। मणिप्रवरशृङ्गाग्रस्सितासितमुखाकृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40007786, "chapter_id": 9020, "verse_number": "16", "content_sanskrit": "रक्तपद्मोत्पलमुख इन्द्रनीलोत्पलश्रवाः। किंचिदभ्युन्नतग्रीव इंद्रनीलदलाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40007787, "chapter_id": 9020, "verse_number": "17", "content_sanskrit": "कुन्देन्दुवज्रसङ्काशमुदरं चास्य भास्वरम्। मधूकनिभपार्श्वश्च पद्मकिञ्जल्कसन्निभः ॥ वैडूर्यसङ्काशखुरस्तनुजङ्घस्सुसंहतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40007788, "chapter_id": 9020, "verse_number": "18", "content_sanskrit": "इन्द्रायुधसवर्णेन पुच्छेनोर्ध्वं विराजता ॥ मनोहरस्स्निग्धवर्णो रत्नैर्नानाविधैर्वृतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40007789, "chapter_id": 9020, "verse_number": "19", "content_sanskrit": "क्षणेन राक्षसो जातो मृगः परमशोभनः ॥ वनं प्रज्वलयन्रम्यं रामाश्रमपदं च तत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40007790, "chapter_id": 9020, "verse_number": "20", "content_sanskrit": "मनोहरं दर्शनीयं रूपं कृत्वा स राक्षसः ॥ प्रलोभनार्थं वैदेह्या नानाधातुविचित्रितम्। विचरन्गच्छते तस्माच्छाद्वलानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40007791, "chapter_id": 9020, "verse_number": "21", "content_sanskrit": "मनोहरं दर्शनीयं रूपं कृत्वा स राक्षसः ॥ प्रलोभनार्थं वैदेह्या नानाधातुविचित्रितम्। विचरन्गच्छते तस्माच्छाद्वलानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40007792, "chapter_id": 9020, "verse_number": "22", "content_sanskrit": "रूप्यैर्बिन्दुशतैश्चित्रो भूत्वा स प्रियदर्शनः। विटपीनां किसलयान्भङ्त्क्वाऽदन्विचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40007793, "chapter_id": 9020, "verse_number": "23", "content_sanskrit": "कदलीगृहकं गत्वा कर्णिकारानितस्ततः। समाश्रयन्मन्दगतिस्सीतासन्दर्शनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40007794, "chapter_id": 9020, "verse_number": "24", "content_sanskrit": "राजीवचित्रपृष्ठस्स विरराज महामृगः। रामाश्रमपदाभ्याशे विचचार यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40007795, "chapter_id": 9020, "verse_number": "25", "content_sanskrit": "पुनर्गत्वा निवृत्तश्च विचचार मृगोत्तमः। गत्वा मुहूर्तं त्वरया पुनः प्रतिनिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40007796, "chapter_id": 9020, "verse_number": "26", "content_sanskrit": "विक्रीडंश्च क्वचिद्भूमौ पुनरेव निषीदति। आश्रमद्वारमागम्य मृगयूथानि गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40007797, "chapter_id": 9020, "verse_number": "27", "content_sanskrit": "मृगयूथैरनुगतः पुनरेव निवर्तते। सीतादर्शनमाकांक्षन्राक्षसो मृगतां गतः ॥ परिभ्रमति चित्राणि मण्डलानि विनिष्पतन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40007798, "chapter_id": 9020, "verse_number": "28", "content_sanskrit": "समुद्वीक्ष्य च ते सर्वे मृगा ह्यन्ये वनेचराः ॥ उपागम्य समाघ्राय विद्रवन्ति दिशो दश।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40007799, "chapter_id": 9020, "verse_number": "29", "content_sanskrit": "राक्षसस्सोऽपि तान्वन्यान्मृगान्मृगवधे रतः ॥ प्रच्छादनार्थं भावस्य न भक्षयति संस्पृशन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40007800, "chapter_id": 9020, "verse_number": "30", "content_sanskrit": "तस्मिन्नेव ततः काले वैदेही शुभलोचना ॥ कुसुमावचयव्यग्रा पादपानभ्यवर्तत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40007801, "chapter_id": 9020, "verse_number": "31", "content_sanskrit": "कर्णिकारानशोकांश्च चूतांश्च मदिरेक्षणा ॥ कुसुमान्यवचिन्वन्ती चचार रुचिरानना।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40007802, "chapter_id": 9020, "verse_number": "32", "content_sanskrit": "अनर्हाऽरण्यवासस्य सा तं रत्नमयं मृगम् ॥ मुक्तामणि विचित्राङ्गं ददर्श परमाङ्गना।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40007803, "chapter_id": 9020, "verse_number": "33", "content_sanskrit": "सा तं रुचिरदन्तोष्ठी रूप्यधातुतनूरुहम् ॥ विस्मयोत्फुल्लनयना सस्नेहं समुदैक्षत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40007804, "chapter_id": 9020, "verse_number": "34", "content_sanskrit": "स च तां रामदयितां पश्यन्मायामयो मृगः ॥ विचचार पुनश्चित्रं दीपयन्निव तद्वनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40007805, "chapter_id": 9020, "verse_number": "35", "content_sanskrit": "अदृष्टपूर्वं तं दृष्ट्वा नानारत्नमयं मृगम् ॥ विस्मयं परमं सीता जगाम जनकात्मजा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]