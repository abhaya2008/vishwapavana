[{"id": 7003115000, "chapter_id": 23115, "verse_number": "४-५१-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nनारायणांशो भगवान्स्वयं धन्वन्तरिर्महान् ।\nपुरा समुद्रमथने समुत्तस्थौ महोदधेः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003115001, "chapter_id": 23115, "verse_number": "४-५१-२", "content_sanskrit": "सर्ववेदेषु निष्णातो मंत्रतन्त्रविशारदः ।\nशिष्यो हि वैनतेयस्य शङ्करस्योपशिष्यकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003115002, "chapter_id": 23115, "verse_number": "४-५१-३", "content_sanskrit": "शिष्याणां च सहस्रेण गतः कैलासमीश्वरि ।\nददर्श तक्षकं मार्गे लेलिहानं भयानकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003115003, "chapter_id": 23115, "verse_number": "४-५१-४", "content_sanskrit": "लक्षनागैः परिवृतं शूलतुल्यं विषोल्बणम् ।\nभोक्तुं कोपात्समायांतमेवं दृष्ट्वा जहास च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003115004, "chapter_id": 23115, "verse_number": "४-५१-५", "content_sanskrit": "दम्भी धन्वन्तरेः शिष्यो धृत्वा तक्षकमुल्बणम् ।\nमंत्रेण जृंभितं कृत्वा निर्विषं तं चकार ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003115005, "chapter_id": 23115, "verse_number": "४-५१-६", "content_sanskrit": "अमूल्यं मणिरत्नं च जहार मस्तके स्थितम् ।\nकरेण भ्रामयित्वा च प्रेरयामास दूरतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003115006, "chapter_id": 23115, "verse_number": "४-५१-७", "content_sanskrit": "निश्चेष्टस्तक्षकस्तस्थौ तत्र मार्गे यथा मृतः ।\nगणा निवेदनं चकुर्गत्वा वासुकिसन्निधिम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003115007, "chapter_id": 23115, "verse_number": "४-५१-८", "content_sanskrit": "वासुकिस्तत्समाकर्ण्य प्रज्वलन्नतिकोपतः ।\nसर्पान्प्रस्थापयामासासंख्यांश्चैव विषोल्बणान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003115008, "chapter_id": 23115, "verse_number": "४-५१-९", "content_sanskrit": "सर्पसेनाग्रणीनां च मुख्यान्पञ्च विशारदान् ।\nद्रोणकालीयकर्कोटपुण्डरीकधनंजयान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003115009, "chapter_id": 23115, "verse_number": "४-५१-१०", "content_sanskrit": "सर्वे नागाः समाजग्मुर्यत्र धन्वन्तरिः स्वयम् ।\nभयमापुः शिष्यगणा दृष्ट्वा नागानसंख्यकान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003115010, "chapter_id": 23115, "verse_number": "४-५१-११", "content_sanskrit": "नागनिश्वासवातेन सर्वे शिष्या मृता इव।\nनिश्चेष्टा ज्ञानरहिताः शेरते धरणीतले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003115011, "chapter_id": 23115, "verse_number": "४-५१-१२", "content_sanskrit": "धन्वन्तरिश्च भगवान्पीयूषवर्षणेन च ।\nजीवयामास शिष्यांश्च मंत्रेण च गुरुं स्मर न् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003115012, "chapter_id": 23115, "verse_number": "४-५१-१३", "content_sanskrit": "चेतनां कारयित्वा च शिष्याणां च जगद्गुरुः ।\nचकार जृंभितं मन्त्रैः सर्पसंघं विषोल्बणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003115013, "chapter_id": 23115, "verse_number": "४-५१-१४", "content_sanskrit": "सर्वे बभूवुर्निश्चेष्टा जृंभितास्ते मृता इव ।\nकोऽपि नालं ततो देवि वार्तां दातुं गणेषु च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003115014, "chapter_id": 23115, "verse_number": "४-५१-१५", "content_sanskrit": "वासुकिर्बुबुधे सर्वं सर्वज्ञः सर्वसंकटम् ।\nआजुहाव जगद्गौरीं भगिनीं ज्ञानरूपिणीम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003115015, "chapter_id": 23115, "verse_number": "४-५१-१६", "content_sanskrit": "वासुकिरुवाच ।\nमनसे त्वं समागच्छ नागान्रक्षातिसङ्कटात् ।\nजगत्त्रये महाभागे पूजा तव भविष्य ति१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003115016, "chapter_id": 23115, "verse_number": "४-५१-१७", "content_sanskrit": "वासुकेर्वचनं श्रुत्वा प्रहस्योवाच कन्यका ।\nवाक्यपीयूषतुल्यं च विनयावनतस्थिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003115017, "chapter_id": 23115, "verse_number": "४-५१-१८", "content_sanskrit": "मनसोवाच ।\nनागेन्द्र शृणु मद्वाक्यं यास्यामि समरं प्रति ।\nभद्राभद्रं दैवसाध्यं करिष्यामि यथोचितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003115018, "chapter_id": 23115, "verse_number": "४-५१-१९", "content_sanskrit": "तं शत्रुं संहरिष्यामि लीलया समरस्थले ।\nअहं यं निहनिष्यामि तं को रक्षितुमीश्वरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003115019, "chapter_id": 23115, "verse_number": "४-५१-२०", "content_sanskrit": "यदि ब्रह्मादयो देवाः समायान्ति रणस्थले ।\nतथापि तव शत्रुं च प्रजेष्यामि न संशयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003115020, "chapter_id": 23115, "verse_number": "४-५१-२१", "content_sanskrit": "गुरुर्मे भगवाञ्छेषः सिद्धमन्त्रं च दत्तवान् ।\nनारायणस्य जगतामीशस्य परमाद्भुतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003115021, "chapter_id": 23115, "verse_number": "४-५१-२२", "content_sanskrit": "बिभर्मि कवचं कण्ठे परं त्रैलोक्यमङ्गलम् ।\nसंसारं भस्मसात्कृत्वा पुनः स्रष्टुमहं क्षमा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003115022, "chapter_id": 23115, "verse_number": "४-५१-२३", "content_sanskrit": "शिष्याऽहं मंत्रशास्त्रेषु शंभोर्भगवतः पुरा ।\nमहाज्ञानं दत्तवान्स मह्यं च कृपया विभुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003115023, "chapter_id": 23115, "verse_number": "४-५१-२४", "content_sanskrit": "शंभोश्च शिष्यो गरुडो गणयामि न तं ध्रुवम् ।\nधन्वंतरिस्तच्छिष्याणामेकः किं गणयामि तम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003115024, "chapter_id": 23115, "verse_number": "४-५१-२५", "content_sanskrit": "इत्युक्त्वा सा जगामैका त्यक्त्वा नागगणान्रुषा ।\nप्रणम्य श्रीहरिं शंभुं शेषं च हृष्टमानसा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003115025, "chapter_id": 23115, "verse_number": "४-५१-२६", "content_sanskrit": "यत्र धन्वन्तरिर्देवः प्रसन्नवदनेक्षणः ।\nतत्राजगाम सा देवी कोपरक्तेक्षणा रुषा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003115026, "chapter_id": 23115, "verse_number": "४-५१-२७", "content_sanskrit": "दृष्टिमात्रेण सर्वाश्च जीवयामास सुन्दरी ।\nविषदृष्ट्या शत्रुशिष्यान्निश्चेष्टांश्च चकार ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003115027, "chapter_id": 23115, "verse_number": "४-५१-२८", "content_sanskrit": "धन्वन्तरिस्तु भगवान्मन्त्रशास्त्रविशारदः ।\nमन्त्रेण यत्नं कृतवान्नोत्थापयितुमीश्वरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003115028, "chapter_id": 23115, "verse_number": "४-५१-२९", "content_sanskrit": "दृष्ट्वा धन्वंतरिं देवी प्रहस्योवाच सत्वरम् ।\nबहूक्तिमर्थयुक्तां च साहंकारा सुरेश्वरि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003115029, "chapter_id": 23115, "verse_number": "४-५१-३०", "content_sanskrit": "मनसोवाच ।\nमन्त्रार्थं मन्त्रशिल्पं च मन्त्रभेदं महौषधम् ।\nवद जानासि किं सिद्ध शिष्योऽसि गरुडस्य च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003115030, "chapter_id": 23115, "verse_number": "४-५१-३१", "content_sanskrit": "अहं च वैनतेयश्च शिष्यौ शंभोश्च विश्रुतौ ।\nसुकल्पकालं सुचिरमहं धन्वन्तरे शृणु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003115031, "chapter_id": 23115, "verse_number": "४-५१-३२", "content_sanskrit": "इत्युक्त्वा सरसः पद्मं समानीय जगत्प्रसूः ।\nमन्त्रसंवलितं कृत्वा प्रेरयामास कोपतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003115032, "chapter_id": 23115, "verse_number": "४-५१-३३", "content_sanskrit": "दृष्ट्वाऽऽगतं पद्मपुष्पं ज्वलदग्निशिखोपमम् ।\n(धन्वतरिश्च निःश्वासैर्भस्मसात्तच्चकार ह) ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003115033, "chapter_id": 23115, "verse_number": "४-५१-३४", "content_sanskrit": "तच्च धन्वतरिर्दृष्ट्वा समंत्ररेणुमुष्टिना ।\nचकार निष्कलं भस्म तां प्रहस्यावलीलया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003115034, "chapter_id": 23115, "verse_number": "४-५१-३५", "content_sanskrit": "देवी जग्राह शक्तिं च ग्रीष्मसूर्यसमप्रभाम् ।\nमंत्रसंवलितां कृत्वा प्रेरयामास तं रिपुम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003115035, "chapter_id": 23115, "verse_number": "४-५१-३६", "content_sanskrit": "दृष्ट्वा जाज्वल्यमानां तां शक्तिं धन्वतरिः स्वयम् ।\nविष्णुदत्तेन शूलेन स तु चिच्छेद लीलया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003115036, "chapter_id": 23115, "verse_number": "४-५१-३७", "content_sanskrit": "तां च शक्तिं वृथा दृष्ट्वा प्रजज्वालेश्वरी रुषा ।\nजग्राह नागपाशं च घोरमव्यर्थमुल्बणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003115037, "chapter_id": 23115, "verse_number": "४-५१-३८", "content_sanskrit": "नागलक्षसमायुक्तं सिद्धमन्त्रेण मन्त्रितम् ।\nप्रेरयामास कोपेन कालान्तकसमप्रभम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003115038, "chapter_id": 23115, "verse_number": "४-५१-३९", "content_sanskrit": "धन्वतरिर्नागपाशं दृष्ट्वा च सस्मितो मुदा ।\nसस्मार गरुडं तूर्णमाजगाम खगेश्वरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003115039, "chapter_id": 23115, "verse_number": "४-५१-४०", "content_sanskrit": "सर्पास्त्रमागतं दृष्ट्वा गरुडो हरिवाहनः ।\nविधाय चञ्चुना शीघ्रं बुभुजे क्षुधितश्चिरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003115040, "chapter_id": 23115, "verse_number": "४-५१-४१", "content_sanskrit": "नागास्त्रं निष्फलं दृष्ट्वा कोपरक्तेक्षणा भृशम् ।\nजग्राह भस्ममुष्टिं च शिवदत्तां पुरा प्रिये ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003115041, "chapter_id": 23115, "verse_number": "४-५१-४२", "content_sanskrit": "भस्ममुष्टिं मन्त्रपूतां दृष्ट्वा च प्रेरितां यथा ।\nपक्षवातेन चिक्षेप शिष्यं पश्चान्निधाय च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003115042, "chapter_id": 23115, "verse_number": "४-५१-४३", "content_sanskrit": "निरस्तां भस्ममुष्टिं च दृष्ट्वा देवी चुकोप ह ।\nजग्राह शूलमव्यर्थं हन्तुं धन्वन्तरिं स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003115043, "chapter_id": 23115, "verse_number": "४-५१-४४", "content_sanskrit": "शिवदत्तं च शूलं च शतसूर्यसमप्रभम् ।\nअव्यर्थशूलं लोकेषु प्रलयाग्निसमप्रभम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003115044, "chapter_id": 23115, "verse_number": "४-५१-४५", "content_sanskrit": "अथ ब्रह्मा तथा शंभुराजगाम रणाजिरम् ।\nधन्वंतरेश्च रक्षार्थं शमनार्थं खगस्य च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003115045, "chapter_id": 23115, "verse_number": "४-५१-४६", "content_sanskrit": "दृष्ट्वा शंभुं जगद्गौरी विधिं च जगतां पतिम् ।\nभक्त्या ननाम तावेव निःशङ्का शूलधारिणी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003115046, "chapter_id": 23115, "verse_number": "४-५१-४७", "content_sanskrit": "धन्वन्तरिश्च गरुडः प्रणनाम सुरेश्वरौ ।\nतुष्टाव परया भक्त्या तौ च चक्रतुराशिषम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003115047, "chapter_id": 23115, "verse_number": "४-५१-४८", "content_sanskrit": "उवाच ब्रह्मा मधुरं हितं धन्वतरिं मुदा ।\nपूजार्थं मनसायाश्च लोकानां हितकाम्यया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003115048, "chapter_id": 23115, "verse_number": "४-५१-४९", "content_sanskrit": "ब्रह्मोवाच ।\nधन्वंतरे महाभाग सर्वशास्त्रविशारद ।\nरणं ते मनसा सार्द्धं न हि साम्यं च मे मतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003115049, "chapter_id": 23115, "verse_number": "४-५१-५०", "content_sanskrit": "शिवदत्तेन शूलेन दुर्निवार्येण सर्वतः ।\nत्रैलोक्यं भस्मसात्कर्तुं क्षमेयं त्रिदशेश्वरी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003115050, "chapter_id": 23115, "verse_number": "४-५१-५१", "content_sanskrit": "ध्याने कौथुमशाखोक्तं कृत्वा भक्त्या समाहितः ।\nदत्त्वा षोडशोपचारं देव्याश्च कुरु पूजनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003115051, "chapter_id": 23115, "verse_number": "४-५१-५२", "content_sanskrit": "आस्तिकोक्तेन स्तोत्रेण स्तवनं कर्तुमर्हसि ।\nपरितुष्टा च मनसा वरं तुभ्यं प्रदास्यति ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003115052, "chapter_id": 23115, "verse_number": "४-५१-५३", "content_sanskrit": "ब्रह्मणो वचनं श्रुत्वा चकारानुमतिं शिवः ।\nवैनतेयश्च संप्रीत्या बोधयामास यत्नतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003115053, "chapter_id": 23115, "verse_number": "४-५१-५४", "content_sanskrit": "एषां च वचनं श्रुत्वा स्नात्वा शुचिरलंकृतः ।\nविधिं पुरोहितं कृत्वा पूजां कर्तुं समुद्यतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003115054, "chapter_id": 23115, "verse_number": "४-५१-५५", "content_sanskrit": "धन्वन्तरिरुवाच ।\nइहागच्छ जगद्गौरि गृहाण मम पूजनम्।\nपूज्या त्वं त्रिषु लोकेषु पुरा कश्यपकन्यके ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003115055, "chapter_id": 23115, "verse_number": "४-५१-५६", "content_sanskrit": "त्वया जितं जगत्सर्वं देवि विष्णुस्वरूपया ।\nतेन तेऽस्त्रप्रयोगश्च न कृतो रणभूमिषु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003115056, "chapter_id": 23115, "verse_number": "४-५१-५७", "content_sanskrit": "इत्युक्त्या संयतो भूत्वा भक्तिनम्रात्मकंधरः ।\nगृहीत्वा शुक्लकुसुमं ध्यानं कर्तुं समुद्यतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003115057, "chapter_id": 23115, "verse_number": "४-५१-५८", "content_sanskrit": "चारुचम्पकवर्णाभां सर्वाङ्गसुमनोहराम् ।\nईषद्धास्यप्रसन्नास्यां शोभितां सूक्ष्मवाससा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003115058, "chapter_id": 23115, "verse_number": "४-५१-५९", "content_sanskrit": "सुचारुकबरीशोभां रत्नाभरणभूषिताम् ।\nसर्वाभयप्रदां देवीं भक्तानुग्रहकातराम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003115059, "chapter_id": 23115, "verse_number": "४-५१-६०", "content_sanskrit": "सर्वविद्याप्रदां शान्तां सर्वविद्याविशारदाम् ।\nनागेन्द्रवाहिनीं देवीं भजे नागेश्वरीं पराम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003115060, "chapter_id": 23115, "verse_number": "४-५१-६१", "content_sanskrit": "ध्यात्वैवं कुसुमं दत्त्वा नानाद्रव्यसमन्वितम् ।\nदत्त्वा षोडशोपचारं पूजयामास तां प्रिये ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003115061, "chapter_id": 23115, "verse_number": "४-५१-६२", "content_sanskrit": "स्तोत्रं चकार यत्नाच्च पुलकाञ्चितविग्रहः ।\nपुटाञ्जलियुतो भूत्वा भक्तिनम्रात्मकंधरः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003115062, "chapter_id": 23115, "verse_number": "४-५१-६३", "content_sanskrit": "धन्वतरिरुवाच ।\nनमः सिद्धिस्वरूपायै सिद्धिदायै नमो नमः ।\nनमः कश्यपकन्यायै वरदायै नमो नमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003115063, "chapter_id": 23115, "verse_number": "४-५१-६४", "content_sanskrit": "नमः शंकरकन्यायै शंकरायै नमो नमः ।\nनमस्ते नागवाहिन्यै नागेश्वर्यै नमो नमः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003115064, "chapter_id": 23115, "verse_number": "४-५१-६५", "content_sanskrit": "नम आस्तीकजननि जनन्यै जगतां मम ।\nनमो जगत्कारणायै जरत्कारुस्त्रियै नमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003115065, "chapter_id": 23115, "verse_number": "४-५१-६६", "content_sanskrit": "नमो नागभगिन्यै च योगिन्यै च नमो नमः ।\nनमश्चिरं तपस्विन्यै सुखदायै नमो नमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003115066, "chapter_id": 23115, "verse_number": "४-५१-६७", "content_sanskrit": "नमस्तपस्यारूपायै फलदायै नमो नमः ।\nसुशीलायै च साध्व्यै च शान्तायै च नमो नमः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003115067, "chapter_id": 23115, "verse_number": "४-५१-६८", "content_sanskrit": "इत्येवमुक्त्वा भक्त्या च प्रणनाम प्रयत्नतः ।\nतुष्टा देवी वरं दत्त्वा सत्वरं स्वालयं ययौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003115068, "chapter_id": 23115, "verse_number": "४-५१-६९", "content_sanskrit": "ब्रह्मरुद्रवैनतेयाः समाजग्मुर्निजालयम् ।\nधन्वंतरिश्च भगवाञ्जगाम निजमन्दिरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003115069, "chapter_id": 23115, "verse_number": "४-५१-७०", "content_sanskrit": "जग्मुर्नागाः प्रहृष्टाश्च फणाराजिविराजिताः ।\nइत्येवं कथितं सर्वं स्तवराजं मया तव ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003115070, "chapter_id": 23115, "verse_number": "४-५१-७१", "content_sanskrit": "विधिना मातरं भक्तिमास्तीकश्च चकार ह ।\nतदा तुष्टा जगद्गौरी पुत्रं तं मुनिपुंगवम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003115071, "chapter_id": 23115, "verse_number": "४-५१-७२", "content_sanskrit": "इदं स्तोत्रं महापुण्यं भक्तियुक्तश्च यः पठेत् ।\nवंशजानां नागभयं नास्ति तस्य न संशयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]