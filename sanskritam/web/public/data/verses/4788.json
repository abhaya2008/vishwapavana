[{"id": 2179027, "chapter_id": 4788, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2179028, "chapter_id": 4788, "verse_number": "१", "content_sanskrit": "आविष्कृतबलं कर्णं ज्ञात्वा राजा तु मागधः ।\nआह्वयद् द्वैरथेनाजौ जरासन्धो महीपतिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2179029, "chapter_id": 4788, "verse_number": "२", "content_sanskrit": "तयोः समभवद् युद्धं दिव्यास्त्रविदुषोर्द्वयोः ।\nयुधि नानाप्रहरणैरन्योन्यमभिवर्षतोः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2179030, "chapter_id": 4788, "verse_number": "३", "content_sanskrit": "क्षीणवाणौ विधनुषौ भग्नखड्गौ महीं गतौः ।\nबाहुभिः समसज्जेतामुभावपि बलान्वितौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2179031, "chapter_id": 4788, "verse_number": "४", "content_sanskrit": "बाहुकण्टकयुद्धेन तस्य कर्णोऽथ युद्ध्यतः ।\nबिभेद सन्धिं देहस्य जरया श्लेषितस्य ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2179032, "chapter_id": 4788, "verse_number": "५", "content_sanskrit": "स विकारं शरीरस्य दृष्ट्वा नृपतिरात्मनः ।\nप्रीतोऽस्ीत्यब्रवीत् कर्णं वैरमुत्सृज्य भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2179033, "chapter_id": 4788, "verse_number": "६", "content_sanskrit": "प्रीत्या ददौ स कर्णाय मालिनीं नगरीमथ ।\nअङ्गेषु नरशार्दूल स राजासीत् सपत्नजित्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2179034, "chapter_id": 4788, "verse_number": "७", "content_sanskrit": "पालयामास चम्पां तु कर्णः परबलार्दनः ।\nदुर्योधनस्यानुमते तवापि विदितं तथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2179035, "chapter_id": 4788, "verse_number": "८", "content_sanskrit": "एवं शस्त्रप्रपातेन प्रथितः सोऽभवत् क्षितौ ।\nत्वद्धितार्थं सुरेन्द्रेण भिक्षितो वर्मकुण्डले\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2179036, "chapter_id": 4788, "verse_number": "९", "content_sanskrit": "स दिव्ये सहजे प्रादात् कुण्डले परमार्चिते ।\nसहजं कवचं चैव मोहितो देवमायया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2179037, "chapter_id": 4788, "verse_number": "१०", "content_sanskrit": "विमुक्तः कुण्डलाभ्यां च सहजेन च वर्मणा ।\nनिहतो विजयेनाजौ वासुदेवस्य पश्यतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2179038, "chapter_id": 4788, "verse_number": "११", "content_sanskrit": "ब्राह्मणस्याभिशापेन रामस्य च महात्मनः ।\nकुन्त्याश्च वरदानेन मायया च शतक्रतोः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2179039, "chapter_id": 4788, "verse_number": "१२", "content_sanskrit": "भीष्मावमानात् सङ्ख्यायां रथानामर्धकीर्तनात् ।\nशल्यात् तेजोवधाच्चापि वासुदेवनयेन च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2179040, "chapter_id": 4788, "verse_number": "१३", "content_sanskrit": "रुद्रस्य देवराजस्य यमस्य वरुणस्य च ।\nकुबेरद्रोणयोश्चैव कृपस्य च महात्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2179041, "chapter_id": 4788, "verse_number": "१४", "content_sanskrit": "अस्त्राणि दिव्यान्यादाय युधि गाण्डीवधन्वना ।\nहतो वैकर्तनः कर्णो दिवाकरसमद्युतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2179042, "chapter_id": 4788, "verse_number": "१५", "content_sanskrit": "एवं शप्तस्तव भ्राता बहुभिश्चापि वञ्चितः ।\nन शोच्यः स नरव्याघ्रो युद्धे हि निधनं गताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2179043, "chapter_id": 4788, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]