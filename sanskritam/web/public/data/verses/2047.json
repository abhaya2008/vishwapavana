[{"id": 2047271, "chapter_id": 2047, "verse_number": "६-९६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047272, "chapter_id": 2047, "verse_number": "६-९६-१", "content_sanskrit": "पुत्रं विनिहतं श्रुत्वा इरावन्तं धऩञ्जयः।\nदुःखेन महताऽऽविष्टो निःश्वसन्पन्नगो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047273, "chapter_id": 2047, "verse_number": "६-९६-२", "content_sanskrit": "अब्रवीत्समरे राजन्वासुदेवमिदं वचः।\nइदं नूनं महाप्राज्ञो विदुरो दृष्टवान्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047274, "chapter_id": 2047, "verse_number": "६-९६-३", "content_sanskrit": "कुरूणां पाण्डवानां च क्षयं घोरं महामतिःक ।\nस ततो निवारितवान्धृतराष्ट्रं जनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047275, "chapter_id": 2047, "verse_number": "६-९६-४", "content_sanskrit": "अन्ये च बहवो वीराः संग्रामे मधुसूदन।\nनिहताः कौरवैः सङ्ख्ये तथाऽस्माभिश्च कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047276, "chapter_id": 2047, "verse_number": "६-९६-५", "content_sanskrit": "अर्थहेतोर्नरश्रेष्ठ क्रियते कर्म कुत्सितम्।\nधिगर्थान्यत्कृते ह्येवं क्रियते ज्ञातिसंक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047277, "chapter_id": 2047, "verse_number": "६-९६-६", "content_sanskrit": "अधनस्य मृतं श्रेयो न च ज्ञातिवधाद्वनम् ।\nकिं नु प्राप्स्यामहे कृष्ण हत्वा ज्ञातीन्समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047278, "chapter_id": 2047, "verse_number": "६-९६-७", "content_sanskrit": "दुर्योधनापराधेन शकुनेः सौबलस्य च।\nक्षत्रिया निधनं यान्ति कर्णदुर्मन्त्रितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047279, "chapter_id": 2047, "verse_number": "६-९६-८", "content_sanskrit": "इदानीं च विजानामि सुकृतं मधुसूदन।\nकृतं राज्ञा महाबाहो याचता त सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047280, "chapter_id": 2047, "verse_number": "६-९६-९", "content_sanskrit": "राज्यार्धं पञ्च वा ग्रामान्नाकार्षीत्स च दुर्मतिःक ।\nदृष्ट्वा हि क्षत्रियाञ्शूराञ्शयानान्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047281, "chapter_id": 2047, "verse_number": "६-९६-१०", "content_sanskrit": "निन्दामि भृशमात्मानं धिगस्तु क्षत्रिजीविकाम् ।\nअशक्तमिति मामेते ज्ञास्यन्ते क्षत्रिया रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047282, "chapter_id": 2047, "verse_number": "६-९६-११", "content_sanskrit": "एतदर्थं मया युद्धं रोचितं मधुसूदन।\nसंचोदय हयाञ्शीघ्रं धार्तराष्ट्रचमूं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047283, "chapter_id": 2047, "verse_number": "६-९६-१२", "content_sanskrit": "प्रतरिष्ये महापारं भुजाभ्यां समरोदधिम् ।\nनायं क्लीबायितुं कालो विद्यते माधव क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047284, "chapter_id": 2047, "verse_number": "६-९६-१३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047285, "chapter_id": 2047, "verse_number": "६-९६-१३", "content_sanskrit": "एवमुक्तस्तु पार्थेन केशवः परवीरहा।\nचोदयामास तानश्वान्पाण्डुरान्वातरंहसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047286, "chapter_id": 2047, "verse_number": "६-९६-१४", "content_sanskrit": "अथ शब्दो महानासीत्तव सैन्यस्य भारत।\nमारुतोद्धूतवेगस्य सागरस्येव पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047287, "chapter_id": 2047, "verse_number": "६-९६-१५", "content_sanskrit": "अपराह्णे महाराज संग्रामः समपद्यत ।\nपर्जन्यसमनिर्घोषो भीष्मस्य सह पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047288, "chapter_id": 2047, "verse_number": "६-९६-१६", "content_sanskrit": "ततो राजंस्तव सुता भीमसेनमुपाद्रवन् ।\nपरिवार्य रणे द्रोणं वसवो वासवं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047289, "chapter_id": 2047, "verse_number": "६-९६-१७", "content_sanskrit": "ततः शान्तनवो भीष्मः कृपश्च रथिनां वरः।\nभगदत्तः सुशर्मा च धनंजयमुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047290, "chapter_id": 2047, "verse_number": "६-९६-१८", "content_sanskrit": "हार्दिक्यो बाह्लिकश्चैव सात्यकिं समभिद्रुतौ ।\nअम्बष्ठकस्तु नृपतिरभिमन्युमवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047291, "chapter_id": 2047, "verse_number": "६-९६-१९", "content_sanskrit": "शेषास्त्वन्ये महाराज शेषानेव महारथान् ।\nततः प्रववृते युद्धं घोररूपं भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047292, "chapter_id": 2047, "verse_number": "६-९६-२०", "content_sanskrit": "`भीमसेनस्तु संप्रेक्ष्य पुत्रांस्तव विशांपते।\nप्रजज्वाल रणे क्रुद्धो हविषा हव्यवाडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047293, "chapter_id": 2047, "verse_number": "६-९६-२१", "content_sanskrit": "पुत्रास्तु तव कौन्तेयं छादयांचक्रिरे शरैः।\nप्रावृषीव महाराज जलदा इव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047294, "chapter_id": 2047, "verse_number": "६-९६-२२", "content_sanskrit": "स च्छाद्यमानो बहुधा पुत्रैस्तव विशांपते ।\nसृक्विणी संलिहन्वीरः शार्दूल इव दर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047295, "chapter_id": 2047, "verse_number": "६-९६-२३", "content_sanskrit": "व्यूढोरस्कस्ततो भीमः पोथयामास पार्थिवम् ।\nक्षुरप्रेण सुतीक्ष्णेन सुमुक्तेन महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047296, "chapter_id": 2047, "verse_number": "६-९६-२४", "content_sanskrit": "ताडयामास संक्रुद्धः सोऽभवद्व्यथितेन्द्रियः ।\nअपरेण तु भल्लेन पीतेन निशितेन तु।\nअपातयत्कुण्डलितं सिंहः क्षुद्रमृगं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047297, "chapter_id": 2047, "verse_number": "६-९६-२५", "content_sanskrit": "ततः सुनिशितान्बाणान्भीमसेनः शिलाशितान् ।\nस सप्त संदधे हन्तुं पुत्रास्ते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047298, "chapter_id": 2047, "verse_number": "६-९६-२६", "content_sanskrit": "प्रेषिता भिमसेनेन शरास्ते दृढधन्वना ।\nअपातयन्त पुत्रांस्ते रथेभ्यः सुमहारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047299, "chapter_id": 2047, "verse_number": "६-९६-२७", "content_sanskrit": "अनाधृष्टिं कुण्डभेदिं विराजं दीप्तलोचनम् ।\nदीर्घबाहुं सुबाहुं च तथैव मकरध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047300, "chapter_id": 2047, "verse_number": "६-९६-२८", "content_sanskrit": "प्रपतन्तिस्म वीरास्ते विरेजुर्भरतर्षभ।\nवसन्ते पुष्पशबलाः किंशुकाः पतिता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047301, "chapter_id": 2047, "verse_number": "६-९६-२९", "content_sanskrit": "ततः प्रदुद्रुवुः शेषास्तव पुत्रा महाहवे ।\nतं कालमिव मन्यन्तो भीमसेनं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047302, "chapter_id": 2047, "verse_number": "६-९६-३०", "content_sanskrit": "द्रोणस्तु समरे वीरं निर्दहनक्तं सुतांस्तव ।\nयथाद्रिं वारिधाराभिः समन्ताद्व्यकिरच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047303, "chapter_id": 2047, "verse_number": "६-९६-३१", "content_sanskrit": "तत्राद्भुतमपश्याम कुन्तीपुत्रस्य पौरुषम् ।\nद्रोणेन वार्यमाणोऽपि निजघ्ने यत्सुतांस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047304, "chapter_id": 2047, "verse_number": "६-९६-३२", "content_sanskrit": "यथा गोवृषभो वर्षं संधारयति स्वात्पतत् ।\nभीमस्तथा द्रोणमुक्तं शरवर्षमदीधरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047305, "chapter_id": 2047, "verse_number": "६-९६-३३", "content_sanskrit": "अद्भुतं च महाराज तत्र चक्रे वृकोदरः ।\nयत्पुत्रांस्तेऽवधीत्सङ्ख्ये द्रोणं चैव न्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047306, "chapter_id": 2047, "verse_number": "६-९६-३४", "content_sanskrit": "पुत्रेषु तव वीरेषु चिक्रीडार्जुनपूर्वजः ।\nमृगेष्विव महाराज चरन्व्याघ्रो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047307, "chapter_id": 2047, "verse_number": "६-९६-३५", "content_sanskrit": "यथा हि पशुमध्यस्थो द्रावयेत पशून्वृकः ।\nवृकोदरस्तव सुतांस्तथा व्यद्रावयद्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047308, "chapter_id": 2047, "verse_number": "६-९६-३६", "content_sanskrit": "गाङ्गेयो भगदत्तश्च गोतमश्च महारथाः ।\nपाण्डवं रभसं युद्धे वारयामासुरर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047309, "chapter_id": 2047, "verse_number": "६-९६-३७", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य तेषां सोऽतिरथो रणे\nप्रवीरांस्तव सैन्येषु प्रेषयामास मृत्यवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047310, "chapter_id": 2047, "verse_number": "६-९६-३८", "content_sanskrit": "अभिमन्युस्तु राजानमम्बष्ठं लोकविश्रुतम् ।\nविरथं रथिनां श्रेष्ठं कारयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047311, "chapter_id": 2047, "verse_number": "६-९६-३९", "content_sanskrit": "विरथो वध्यमानस्तु सौभद्रेण यशस्विना ।\nअवप्लुत्य रथात्तूर्णमम्बष्ठो वसुधाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047312, "chapter_id": 2047, "verse_number": "६-९६-४०", "content_sanskrit": "असिं चिक्षेप समरे सौभद्रस्य महात्मनः ।\nआरुरोह रथं चैव हार्दिक्यस्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047313, "chapter_id": 2047, "verse_number": "६-९६-४१", "content_sanskrit": "आपतन्तं तु निस्त्रिंशं युद्धमार्गविशारदः ।\nलाघवाद्व्यंसयामास सौभद्रः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047314, "chapter_id": 2047, "verse_number": "६-९६-४२", "content_sanskrit": "व्यंसितं वीक्ष्य निस्त्रिंशं सौभद्रेण रणे तदा।\nसाधुसाध्विति सैन्यानां प्रणादोऽभूद्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047315, "chapter_id": 2047, "verse_number": "६-९६-४३", "content_sanskrit": "धृष्टद्युम्नमुखास्त्वन्ये तव सैन्यमयोधयन्।\nतथैव तावकाः सर्वे पाण्डुसैन्यमयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2047316, "chapter_id": 2047, "verse_number": "६-९६-४४", "content_sanskrit": "तत्राक्रन्दो महानासीत्तव तेषां च भारत।\nनिघ्नतां दृढमन्योन्यं कुर्वतां कर्म दुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2047317, "chapter_id": 2047, "verse_number": "६-९६-४५", "content_sanskrit": "अन्योन्यं हि रणे शूराः केशेष्वाक्षिष्य मानिनः।\nनखदन्तैरयुध्यन्त मुष्टिभिर्जानुभिस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2047318, "chapter_id": 2047, "verse_number": "६-९६-४६", "content_sanskrit": "तलैश्चैवाथ निस्त्रिंशैर्बाहुभिश्च सुसंस्थितैः।\nविवरं प्राप्य चान्योन्यमनयन्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2047319, "chapter_id": 2047, "verse_number": "६-९६-४७", "content_sanskrit": "न्यहनच्च पिता पुत्रं पुत्रश्च पितरं तथा।\nव्याकुलीकृतसंकल्पा युयुधुस्तत्र मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2047320, "chapter_id": 2047, "verse_number": "६-९६-४८", "content_sanskrit": "रणे चारूणि चापानि हेमपृष्ठानि मारिष ।\nहतानामपविद्धानि कलापाश्च महाधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2047321, "chapter_id": 2047, "verse_number": "६-९६-४९", "content_sanskrit": "जातरूपमयैः पुङ्खै राजतैर्निशिताः शराः।\nतैलधौता व्यराजन्त निर्मुक्तभुजगोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2047322, "chapter_id": 2047, "verse_number": "६-९६-५०", "content_sanskrit": "खङ्गाश्च दान्तत्सरवो जातरूपपरिष्कृताः ।\nचर्माणि चापविद्धानि रुक्मचित्राणि धन्विनां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2047323, "chapter_id": 2047, "verse_number": "६-९६-५१", "content_sanskrit": "सुवर्णाविकृताः प्रासाः प्रभग्ना हेमभूषिताः।\nजातरूपमया यष्ट्यः शक्त्यश्च कनकोज्ज्वलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2047324, "chapter_id": 2047, "verse_number": "६-९६-५२", "content_sanskrit": "अवस्कन्दाश्च पतिता मुसलानि गुरूणि च ।\nपरिघाः पट्टसाश्चैव भिण्डिपालाश्च मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2047325, "chapter_id": 2047, "verse_number": "६-९६-५३", "content_sanskrit": "पतिता विविधाश्चापाश्चित्रा हेमपरिष्कृताः ।\nकुथा बहुविधाकाराश्चामरा व्यजनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2047326, "chapter_id": 2047, "verse_number": "६-९६-५४", "content_sanskrit": "नानाविधानि शस्त्राणि प्रगृह्य पतिता नराः।\nजीवन्त इव दृश्यनते गतसत्त्वा महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2047327, "chapter_id": 2047, "verse_number": "६-९६-५५", "content_sanskrit": "गजाविमथितैर्गात्रैर्मुसलैर्भिन्नमस्तकाः।\nगजावाजिरथक्षुण्णाः शेरते स्म नराः क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2047328, "chapter_id": 2047, "verse_number": "६-९६-५६", "content_sanskrit": "तथैवाश्वनृनागानां शरीरैर्विबभौ तदा।\nसंछन्ना वसुधा राजन्पर्वतैरिव शातितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2047329, "chapter_id": 2047, "verse_number": "६-९६-५७", "content_sanskrit": "समरे पतितैश्चैव शक्त्यृष्टिशरतोमरैः।\nनिस्त्रिंशैः पट्टसैः प्रासैरवस्कन्दैः परश्वथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2047330, "chapter_id": 2047, "verse_number": "६-९६-५८", "content_sanskrit": "परिघैर्भिण्डिपालैश्च शतघ्नीभिश्च मारिष।\nशरीरैः शस्त्रनिर्भिन्नैः समास्तीर्यत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2047331, "chapter_id": 2047, "verse_number": "६-९६-५९", "content_sanskrit": "विशब्दैरल्पशब्दैश्च शोणितौगपरिप्लुतैः।\nगतासुभिरमित्रघ्न विबभौ निचिता मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2047332, "chapter_id": 2047, "verse_number": "६-९६-६०", "content_sanskrit": "सतलत्रैः सकेयूरैर्बाहुभिश्चन्दनोक्षितैः ।\nहस्तिहस्तोपमैश्छिन्नैरूरुभिश्च तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2047333, "chapter_id": 2047, "verse_number": "६-९६-६१", "content_sanskrit": "बद्धचूजामणिवरैः शिरोभिश्च सकुण्डलैः ।\nपातितै ऋषभाक्षाणां बभौ भारत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2047334, "chapter_id": 2047, "verse_number": "६-९६-६२", "content_sanskrit": "कवचैः शोणितादिग्धैर्विप्रकीर्णैश्च काञ्चनैः ।\nरराज सुभृशं भूमिः शान्तार्चिर्भिरिवानलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2047335, "chapter_id": 2047, "verse_number": "६-९६-६३", "content_sanskrit": "विप्रविद्धैः कलापैश्च पतितैश्च शरासनैः ।\nविप्रकीर्णैः शरैश्चैव रुक्मपुङ्खैः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2047336, "chapter_id": 2047, "verse_number": "६-९६-६४", "content_sanskrit": "रथैश्च सर्वतो भग्नैः किङ्किणीजालभूषितैः ।\nवाजिभिश्च हतैर्बाणैः स्रस्तजिह्वैः सशोणितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2047337, "chapter_id": 2047, "verse_number": "६-९६-६५", "content_sanskrit": "अनुकर्षैः पताकाभिरुपासङ्गैर्ध्वजैरपि ।\nप्रवीराणां महाशङ्खैर्विप्रकीर्णैश्च पाण्डुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2047338, "chapter_id": 2047, "verse_number": "६-९६-६६", "content_sanskrit": "स्रस्तहस्तैश्च मातङ्गैः शयानैर्विबभौ मही ।\nनानारूपेरलंकारैः प्रमदेवाभ्यलङ्कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2047339, "chapter_id": 2047, "verse_number": "६-९६-६७", "content_sanskrit": "दन्तिभिश्चापरैस्तत्र सप्राणैर्गाढवेदनैः ।\nकरैः शब्दं विमुञ्चद्भिः शीकरं च मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2047340, "chapter_id": 2047, "verse_number": "६-९६-६८", "content_sanskrit": "विबभौ तद्रणस्थानं स्यन्दमानैरिवाचलैः।\nनानारागैः कम्बलैश्च परिस्तोमेश्च दन्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2047341, "chapter_id": 2047, "verse_number": "६-९६-६९", "content_sanskrit": "वैदूर्यमणिदण्डैश्च पतितैरङ्कुशैः शुभैः।\nघण्टाभिश्च गजेन्द्राणां पतिताभिः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2047342, "chapter_id": 2047, "verse_number": "६-९६-७०", "content_sanskrit": "विपाटितविचित्राभिः कुथाभिरङ्कुशैस्तथा।\nग्रैवेयैश्चित्ररूपैश्च रुक्मकक्ष्याभिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2047343, "chapter_id": 2047, "verse_number": "६-९६-७१", "content_sanskrit": "यन्त्रैश्च बहुधा च्छिन्नैस्तोमरैश्चापि काञ्चनैः।\n`रराज सुभृशं भूमिस्तत्रतत्र विशांपते\nअश्वानां रेणुकपिलै रुक्मच्छन्नैरुरश्छदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2047344, "chapter_id": 2047, "verse_number": "६-९६-७२", "content_sanskrit": "सादिनां च भुजैश्छिन्नैः पतितैः साङ्गदैस्तथा।\nप्रासैश्च विमलैस्तीक्ष्णैर्विमलाभिस्तथर्ष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2047345, "chapter_id": 2047, "verse_number": "६-९६-७३", "content_sanskrit": "उष्णीषैश्च तथा चित्रैर्विप्रविद्धैस्ततस्ततः।\nविचित्रैर्बाणवर्षैश्च जातरूपपरिष्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2047346, "chapter_id": 2047, "verse_number": "६-९६-७४", "content_sanskrit": "अश्वास्तरपरिस्तोमै राङ्कवैर्मृदितैस्तथा।\nनरेन्द्रचूडामणिभिर्विचित्रैश्च महाधनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2047347, "chapter_id": 2047, "verse_number": "६-९६-७५", "content_sanskrit": "छत्रैस्तथापविद्धैश्च चामरैर्व्यजनैरपि ।\nपद्मेन्दुद्युतिभिश्चैव वदनैश्चारुकुण्डलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2047348, "chapter_id": 2047, "verse_number": "६-९६-७६", "content_sanskrit": "क्लृप्तश्मश्रुभिरत्यर्थं वीराणां समलङ्कृतैः ।\nअपविद्धैर्महाराज सुवर्णाज्ज्वलकुण्डलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2047349, "chapter_id": 2047, "verse_number": "६-९६-७७", "content_sanskrit": "ग्रहनक्षत्रशबला द्यौरिवासीद्वसुंधरा।\nएवमेते महासेने मृदिते तत्र भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2047350, "chapter_id": 2047, "verse_number": "६-९६-७८", "content_sanskrit": "परस्परं समासाद्य तव तेषां च संयुगे ।\nतेषु श्रान्तेषु भग्नेषु मृदितेषु च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2047351, "chapter_id": 2047, "verse_number": "६-९६-७९", "content_sanskrit": "रात्रिः समभवत्तत्र नापश्याम ततोऽनुगान् ।\nततोऽवहारं सैकन्यानां प्रचुक्रुः कुरुपाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2047352, "chapter_id": 2047, "verse_number": "६-९६-८०", "content_sanskrit": "घोरे निशामुखे रौद्रे वर्तमाने महाभये।\nअवहारं ततः कृत्वा सहिताः कुरुपाणड्वाः ।\nन्यविशन्त निशाकाले गत्वा स्वशिबिरं तदा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2047353, "chapter_id": 2047, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे षण्णवतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-९६-२३ व्यूढोरस्कं इति झo पाठः ॥ ६-९६-४८ अपविद्धानि पतितानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]