[{"id": 2015339, "chapter_id": 1322, "verse_number": "२-६३-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततः सागरसङ्काशं दृष्ट्वा नृपतिमण्डलम्।\nसंवर्तवाताभिहतं भीमं क्षुब्धमिवार्णवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015340, "chapter_id": 1322, "verse_number": "२-६३-२", "content_sanskrit": "रोषात्प्रचलितं सर्वमिदमाह युधिष्ठिरः।\nभीष्मं मतिमतां मुख्यं वृद्धं कुरुपितामहम्।\nबृहस्पतिं बृहत्तेजाः पुरुहूत इवारिहा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015341, "chapter_id": 1322, "verse_number": "२-६३-३", "content_sanskrit": "असौ रोषात्प्रचलितो महान्नृपतिसागरः।\nअत्र यत्प्रतिपत्तव्यं तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015342, "chapter_id": 1322, "verse_number": "२-६३-४", "content_sanskrit": "यज्ञस्य च न विघ्नः स्यात्प्रजानां च हितं भवेत्।\nयथा सर्वत्र तत्सर्वं ब्रूहि मेऽद्य पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015343, "chapter_id": 1322, "verse_number": "२-६३-५", "content_sanskrit": "इत्युक्तवति धर्मज्ञे धर्मराजे युधिष्ठिरे।\nउवाचेदं वचो भीष्मस्ततः कुरुपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015344, "chapter_id": 1322, "verse_number": "२-६३-६", "content_sanskrit": "मा भैस्त्वं कुरुशार्दूल श्वा सिंहं हन्तुमर्हति।\nशिवः पन्थाः सुनीतोऽत्र मया पूर्वतरं वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015345, "chapter_id": 1322, "verse_number": "२-६३-७", "content_sanskrit": "प्रसुप्ते हि यथा सिंहे श्वानस्तात समागताः।\nभषेयुः सहिताः सर्वे तथेमे वसुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015346, "chapter_id": 1322, "verse_number": "२-६३-८", "content_sanskrit": "वृष्णिसिंहस्य सुप्तस्य तथाऽमी प्रमुके स्थिताः।\nभषन्ते तात सङ्क्रुद्धाः श्वानः सिंहस्य सन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015347, "chapter_id": 1322, "verse_number": "२-६३-९", "content_sanskrit": "न हि सम्बुध्यते यावत्सुप्तः सिंह इवाच्युतः।\nतदिदं ज्ञातपूर्वं हि तव संस्तोतुमिच्छसि।\nतेन सिंहीकरोत्येतानसिंहश्चेदिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015348, "chapter_id": 1322, "verse_number": "२-६३-१०", "content_sanskrit": "पार्थिवान्पार्थिवश्रेष्ठ शिशुपालोऽल्पचेतनः।\nसर्वान्सर्वात्मना तात नेतुकामो यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015349, "chapter_id": 1322, "verse_number": "२-६३-११", "content_sanskrit": "नूनमेतत्समादातुं पुनरिच्छत्यधोक्षजः।\nयदस्य शिशुपालस्य तेजस्तिष्ठति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015350, "chapter_id": 1322, "verse_number": "२-६३-१२", "content_sanskrit": "विप्लुता चास्य भद्रं ते बुद्धिर्बुद्धिमतां वर।\nचेदिराजस्य कौन्तेय सर्वेषां च महीक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015351, "chapter_id": 1322, "verse_number": "२-६३-१३", "content_sanskrit": "आदातुं च नरव्याघ्रो यं यमिच्छत्ययं तदा।\nतस्य विप्लवते बुद्धिरेवं चेदिपतेर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015352, "chapter_id": 1322, "verse_number": "२-६३-१४", "content_sanskrit": "चतुर्विधानां भूतानां त्रिषु लोकेषु माधवः।\nप्रभवश्चैव सर्वेषां निधनं च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015353, "chapter_id": 1322, "verse_number": "२-६३-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015354, "chapter_id": 1322, "verse_number": "२-६३-१५", "content_sanskrit": "इति तस्य वचः श्रुत्वा ततश्चेदिपतिर्नृपः।\nभीष्मं रूक्षाक्षरा वाचः श्रावयामास भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015355, "chapter_id": 1322, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि त्रिषष्टितमोऽध्यायः॥ ६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]