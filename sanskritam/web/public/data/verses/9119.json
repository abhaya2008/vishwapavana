[{"id": 5000119000, "chapter_id": 9119, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000119001, "chapter_id": 9119, "verse_number": "२-४२-१", "content_sanskrit": "यावत् तु निर्यतस्तस्य रजोरूपमदृश्यत।\nनैवेक्ष्वाकुवरस्तावत् संजहारात्मचक्षुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000119002, "chapter_id": 9119, "verse_number": "२-४२-२", "content_sanskrit": "यावद् राजा प्रियं पुत्रं पश्यत्यत्यन्तधार्मिकम्।\nतावद् व्यवर्धतेवास्य धरण्यां पुत्रदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000119003, "chapter_id": 9119, "verse_number": "२-४२-३", "content_sanskrit": "न पश्यति रजोऽप्यस्य यदा रामस्य भूमिपः।\nतदार्तश्च निषण्णश्च पपात धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000119004, "chapter_id": 9119, "verse_number": "२-४२-४", "content_sanskrit": "तस्य दक्षिणमन्वागात् कौसल्या बाहुमङ्गना।\nपरं चास्यान्वगात् पार्श्वं कैकेयी सा सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000119005, "chapter_id": 9119, "verse_number": "२-४२-५", "content_sanskrit": "तां नयेन च सम्पन्नो धर्मेण विनयेन च।\nउवाच राजा कैकेयीं समीक्ष्य व्यथितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000119006, "chapter_id": 9119, "verse_number": "२-४२-६", "content_sanskrit": "कैकेयि मामकाङ्गानि मा स्प्राक्षीः पापनिश्चये।\nनहि त्वां द्रष्टुमिच्छामि न भार्या न च बान्धवी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000119007, "chapter_id": 9119, "verse_number": "२-४२-७", "content_sanskrit": "ये च त्वामनुजीवन्ति नाहं तेषां न ते मम।\nकेवलार्थपरां हि त्वां त्यक्तधर्मां त्यजाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000119008, "chapter_id": 9119, "verse_number": "२-४२-८", "content_sanskrit": "अगृह्णां यच्च ते पाणिमग्निं पर्यणयं च यत्।\nअनुजानामि तत् सर्वमस्मिंल्लोके परत्र च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000119009, "chapter_id": 9119, "verse_number": "२-४२-९", "content_sanskrit": "भरतश्चेत् प्रतीतः स्याद् राज्यं प्राप्यैतदव्ययम्।\nयन्मे स दद्यात् पित्रर्थं मा मां तद्दत्तमागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000119010, "chapter_id": 9119, "verse_number": "२-४२-१०", "content_sanskrit": "अथ रेणुसमुद‍्ध्वस्तं समुत्थाप्य नराधिपम्।\nन्यवर्तत तदा देवी कौसल्या शोककर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000119011, "chapter_id": 9119, "verse_number": "२-४२-११", "content_sanskrit": "हत्वेव ब्राह्मणं कामात् स्पृष्ट्वाग्निमिव पाणिना।\nअन्वतप्यत धर्मात्मा पुत्रं संचिन्त्य राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000119012, "chapter_id": 9119, "verse_number": "२-४२-१२", "content_sanskrit": "निवृत्यैव निवृत्यैव सीदतो रथवर्त्मसु।\nराज्ञो नातिबभौ रूपं ग्रस्तस्यांशुमतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000119013, "chapter_id": 9119, "verse_number": "२-४२-१३", "content_sanskrit": "विललाप स दुःखार्तः प्रियं पुत्रमनुस्मरन्।\nनगरान्तमनुप्राप्तं बुद्‍ध्वा पुत्रमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000119014, "chapter_id": 9119, "verse_number": "२-४२-१४", "content_sanskrit": "वाहनानां च मुख्यानां वहतां तं ममात्मजम्।\nपदानि पथि दृश्यन्ते स महात्मा न दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000119015, "chapter_id": 9119, "verse_number": "२-४२-१५", "content_sanskrit": "यः सुखेनोपधानेषु शेते चन्दनरूषितः।\nवीज्यमानो महार्हाभिः स्त्रीभिर्मम सुतोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000119016, "chapter_id": 9119, "verse_number": "२-४२-१६", "content_sanskrit": "स नूनं क्वचिदेवाद्य वृक्षमूलमुपाश्रितः।\nकाष्ठं वा यदि वाश्मानमुपधाय शयिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000119017, "chapter_id": 9119, "verse_number": "२-४२-१७", "content_sanskrit": "उत्थास्यति च मेदिन्याः कृपणः पांसुगुण्ठितः।\nविनिःश्वसन् प्रस्रवणात् करेणूनामिवर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000119018, "chapter_id": 9119, "verse_number": "२-४२-१८", "content_sanskrit": "द्रक्ष्यन्ति नूनं पुरुषा दीर्घबाहुं वनेचराः।\nराममुत्थाय गच्छन्तं लोकनाथमनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000119019, "chapter_id": 9119, "verse_number": "२-४२-१९", "content_sanskrit": "सा नूनं जनकस्येष्टा सुता सुखसदोचिता।\nकण्टकाक्रमणक्लान्ता वनमद्य गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000119020, "chapter_id": 9119, "verse_number": "२-४२-२०", "content_sanskrit": "अनभिज्ञा वनानां सा नूनं भयमुपैष्यति।\nश्वपदानर्दितं श्रुत्वा गम्भीरं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000119021, "chapter_id": 9119, "verse_number": "२-४२-२१", "content_sanskrit": "सकामा भव कैकेयि विधवा राज्यमावस।\nनहि तं पुरुषव्याघ्रं विना जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000119022, "chapter_id": 9119, "verse_number": "२-४२-२२", "content_sanskrit": "इत्येवं विलपन् राजा जनौघेनाभिसंवृतः।\nअपस्नात इवारिष्टं प्रविवेश गृहोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000119023, "chapter_id": 9119, "verse_number": "२-४२-२३", "content_sanskrit": "शून्यचत्वरवेश्मान्तां संवृतापणवेदिकाम्।\nक्लान्तदुर्बलदुःखार्तां नात्याकीर्णमहापथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000119024, "chapter_id": 9119, "verse_number": "२-४२-२४", "content_sanskrit": "तामवेक्ष्य पुरीं सर्वां राममेवानुचिन्तयन्।\nविलपन् प्राविशद् राजा गृहं सूर्य इवाम्बुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000119025, "chapter_id": 9119, "verse_number": "२-४२-२५", "content_sanskrit": "महाह्रदमिवाक्षोभ्यं सुपर्णेन हृतोरगम्।\nरामेण रहितं वेश्म वैदेह्या लक्ष्मणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000119026, "chapter_id": 9119, "verse_number": "२-४२-२६", "content_sanskrit": "अथ गद्‍गदशब्दस्तु विलपन् वसुधाधिपः।\nउवाच मृदु मन्दार्थं वचनं दीनमस्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000119027, "chapter_id": 9119, "verse_number": "२-४२-२७", "content_sanskrit": "कौसल्याया गृहं शीघ्रं राममातुर्नयन्तु माम्।\nनह्यन्यत्र ममाश्वासो हृदयस्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000119028, "chapter_id": 9119, "verse_number": "२-४२-२८", "content_sanskrit": "इति ब्रुवन्तं राजानमनयन् द्वारदर्शिनः।\nकौसल्याया गृहं तत्र न्यवेस्यत विनीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000119029, "chapter_id": 9119, "verse_number": "२-४२-२९", "content_sanskrit": "ततस्तत्र प्रविष्टस्य कौसल्याया निवेशनम्।\nअधिरुह्यापि शयनं बभूव लुलितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000119030, "chapter_id": 9119, "verse_number": "२-४२-३०", "content_sanskrit": "पुत्रद्वयविहीनं च स्नुषया च विवर्जितम्।\nअपश्यद् भवनं राजा नष्टचन्द्रमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000119031, "chapter_id": 9119, "verse_number": "२-४२-३१", "content_sanskrit": "तच्च दृष्ट्वा महाराजो भुजमुद्यम्य वीर्यवान्।\nउच्चैःस्वरेण प्राक्रोशद्धा राम विजहासि नौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000119032, "chapter_id": 9119, "verse_number": "२-४२-३२", "content_sanskrit": "सुखिता बत तं कालं जीविष्यन्ति नरोत्तमाः।\nपरिष्वजन्तो ये रामं द्रक्ष्यन्ति पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000119033, "chapter_id": 9119, "verse_number": "२-४२-३३", "content_sanskrit": "अथ रात्र्यां प्रपन्नायां कालरात्र्यामिवात्मनः।\nअर्धरात्रे दशरथः कौसल्यामिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000119034, "chapter_id": 9119, "verse_number": "२-४२-३४", "content_sanskrit": "न त्वां पश्यामि कौसल्ये साधु मां पाणिना स्पृश।\nरामं मेऽनुगता दृष्टिरद्यापि न निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000119035, "chapter_id": 9119, "verse_number": "२-४२-३५", "content_sanskrit": "तं राममेवानुविचिन्तयन्तं\nसमीक्ष्य देवी शयने नरेन्द्रम्।\nउपोपविश्याधिकमार्तरूपा\nविनिश्वसन्तं विललाप कृच्छ्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000119036, "chapter_id": 9119, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]