[{"id": 50014728, "chapter_id": 11541, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014729, "chapter_id": 11541, "verse_number": "2", "content_sanskrit": "कथमेवंगुणो देशः केन वा भगवन् कृतः। प्रश्नमेतं समाचक्ष्व परं कौतूहलं हि नः॥ ९/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014730, "chapter_id": 11541, "verse_number": "3", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014731, "chapter_id": 11541, "verse_number": "4", "content_sanskrit": "एकदा गिरिशं द्रष्टुमृषयस्तत्र सुव्रताः। दिशो वितिमिरा भासा कुर्वन्तस्तमुपागमन्॥ ९/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014732, "chapter_id": 11541, "verse_number": "5", "content_sanskrit": "तान् विलोक्याम्बिका देवी विवस्त्रा व्रीळता (???) भृशम्। भर्तुरङ्कात् समुत्थाय नीवीमाश्वथ पर्यधात्॥ ९/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014733, "chapter_id": 11541, "verse_number": "6", "content_sanskrit": "ऋषयोऽपि तयोर्वीक्ष्य प्रसङ्गं रममाणयोः। निवृत्ताः प्रययुस्तस्मान्नरनारायणाश्रमम्॥ ९/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014734, "chapter_id": 11541, "verse_number": "7", "content_sanskrit": "तदैवं भगवानाह प्रियायाः प्रियकाम्यया। स्थानं यः प्रविशेदेतत् स वै योषिद् भवेदिति॥ ९/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014735, "chapter_id": 11541, "verse_number": "8", "content_sanskrit": "तत ऊर्ध्वं वनं तद् वै पुरुषा वर्जयन्ति हि। सा चानुचरसंयुक्ता विचचार वनाद् वनम्॥ ९/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014736, "chapter_id": 11541, "verse_number": "9", "content_sanskrit": "अथ तामाश्रमाभ्याशे चरन्तीं प्रमदोत्तमाम्। स्त्रीभिः परिवृतां वीक्ष्य चकमे भगवान् बुधः॥ ९/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014737, "chapter_id": 11541, "verse_number": "10", "content_sanskrit": "साऽपि तं चकमे सुभ्रूः सोमराजसुतं पतिम्। स तस्यां जनयामास पुरूरवसमात्मजम्॥ ९/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014738, "chapter_id": 11541, "verse_number": "11", "content_sanskrit": "एवं स्त्रीत्वमनुप्राप्तः सुद्युम्नो मानवो नृपः। सस्मार स्वकुलाचार्यं वसिष्ठमिति शुश्रुमः॥ ९/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014739, "chapter_id": 11541, "verse_number": "12", "content_sanskrit": "स तस्य तां दशां दृष्ट्वा कृपया भृशपीडितः। सुद्युम्नस्याशयन् पुंस्त्वमुपाधावत शङ्करम्॥ ९/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014740, "chapter_id": 11541, "verse_number": "13", "content_sanskrit": "तुष्टः स तस्मै भगवान् ऋषये प्रियमावहन्। स्वां च वाचमृतां कुर्वन्निदमाह विशाम्पते॥ ९/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014741, "chapter_id": 11541, "verse_number": "14", "content_sanskrit": "मासं पुमान् स भविता स्त्री मासं तपसा तव। इत्थं व्यवस्थया कामं सुद्युम्नोऽवतु मेदिनीम्॥ ९/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50014742, "chapter_id": 11541, "verse_number": "15", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50014743, "chapter_id": 11541, "verse_number": "16", "content_sanskrit": "आचार्यानुग्रहात् कामं लब्ध्वा पुंस्त्वं व्यवस्थया। पालयामास जगतीं नाभ्यनन्दन् स्म तं प्रजाः॥ ९/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50014744, "chapter_id": 11541, "verse_number": "17", "content_sanskrit": "तस्योत्कलो गयो राजन् विमलश्च सुतास्त्रयः। दक्षिणापथराजानो बभूवुर्धर्मवत्सलाः॥ ९/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50014745, "chapter_id": 11541, "verse_number": "18", "content_sanskrit": "ततः परिणतः काले प्रतिष्ठानपतिः प्रभुः। पुरूरवस उत्सृज्य गां पुत्राय गतो वनम्॥ ९/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50014746, "chapter_id": 11541, "verse_number": "19", "content_sanskrit": "इति श्रीमद्भागवते नवमस्कन्धस्य द्वितीयोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]