[{"id": 2186557, "chapter_id": 4962, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186558, "chapter_id": 4962, "verse_number": "१", "content_sanskrit": "पार्थिवं धातुमाश्रित्य शारीरोऽग्निः कथं भवेत् ।\nअवकाशविशेषेण कथं वर्तयतेऽनिलः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186559, "chapter_id": 4962, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186560, "chapter_id": 4962, "verse_number": "२", "content_sanskrit": "वायोर्गतिमहं ब्रह्मन् कीर्तयिष्यामि तेऽनघ ।\nप्राणिनामनिलो देहान्यथा चेष्टयते बली\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186561, "chapter_id": 4962, "verse_number": "३", "content_sanskrit": "श्रितो मूर्धानमग्निस्तु शरीरं परिपालयन् ।\nप्राणो मूर्धनि चाग्नौ च वर्तमानो विचेष्टते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186562, "chapter_id": 4962, "verse_number": "४", "content_sanskrit": "स जन्तुः सर्वभूतात्मा पुरुषः स सनातनः ।\nमनो बुद्धिरहङ्कारो भूतानि विषयाश्च सः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186563, "chapter_id": 4962, "verse_number": "५", "content_sanskrit": "एवं त्विह स सर्वत्र प्राणेन परिपाल्यते ।\nपृष्ठतश्च समानेन स्वां स्वां गतिमुपाश्रितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186564, "chapter_id": 4962, "verse_number": "६", "content_sanskrit": "बस्तिमूलं गुदं चैव पावकं च समाश्रितः ।\nवहन्मूत्रं पुरीषं चाप्यपानः परिवर्तते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186565, "chapter_id": 4962, "verse_number": "७", "content_sanskrit": "प्रयत्ने कर्मणि बले य एकस्त्रिषु वर्तते ।\nउदान इति तं प्राहुरध्यात्मविदुषो जनाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186566, "chapter_id": 4962, "verse_number": "८", "content_sanskrit": "सन्धिष्वपि च सर्वेषु सन्निविष्टस्तथानिलः ।\nशरीरेषु मनुष्याणां व्यान इत्युपदिश्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186567, "chapter_id": 4962, "verse_number": "९", "content_sanskrit": "धातुष्वग्निस्तु विततः समानेन समीरितः ।\nरसान्धातूंश्च दोषांश्च वर्तयन्नवतिष्ठति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186568, "chapter_id": 4962, "verse_number": "१०", "content_sanskrit": "अपानप्राणयोर्मध्ये प्राणापानसमाहितः ।\nसमन्वितः स्वधिष्ठानः सम्यक्पचति पावकः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186569, "chapter_id": 4962, "verse_number": "११", "content_sanskrit": "आस्यं हि पायुसंयुक्तमन्ते स्याद्गुदसञ्ज्ञितम् ।\nस्रोतसोऽस्मात् प्रजायन्ते सर्वस्रोतांसि देहिनाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186570, "chapter_id": 4962, "verse_number": "१२", "content_sanskrit": "प्राणानां सन्निपाताच्च सन्निपातः प्रजायते ।\nऊष्मा चाग्निरिति ज्ञेयो योऽन्नं पचति देहिनाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186571, "chapter_id": 4962, "verse_number": "१३", "content_sanskrit": "अग्निवेगवहः प्राणो गुदान्ते प्रतिहन्यते ।\nस ऊर्ध्वमागम्य पुनः समुत्क्षिपति पावकम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186572, "chapter_id": 4962, "verse_number": "१४", "content_sanskrit": "पक्वाशयस्त्वधो नाभ्या ऊर्ध्वमामाशयः स्थितः ।\nनाभिमध्ये शरीरस्य सर्वे प्राणाः समाहिताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186573, "chapter_id": 4962, "verse_number": "१५", "content_sanskrit": "प्रसृता हृदयात् सर्वे तिर्यगूर्ध्वमधस्तथा ।\nवहन्त्यन्नरसान्नाड्यो दश प्राणप्रचोदिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186574, "chapter_id": 4962, "verse_number": "१६", "content_sanskrit": "एष मार्गोऽथ योगानां येन गच्छन्ति तत् पदम् ।\nजितक्लमासना धीरा मूर्धन्यात्मानमादधुः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186575, "chapter_id": 4962, "verse_number": "१७", "content_sanskrit": "एवं सर्वेषु विहितः प्राणापानेषु देहिनाम् ।\nतस्मिन् स्थितो नित्यमग्निः स्थाल्यामिव समाहितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186576, "chapter_id": 4962, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकादशोऽध्यायः ॥ ११ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]