[{"id": 7003492000, "chapter_id": 23492, "verse_number": "१३२-१", "content_sanskrit": "अथ मृतकस्पर्शप्रायश्चित्तम् ।\nश्रीवराह उवाच ।\nगत्वा तु मैथुनं भद्रे अस्नातो यः शवं स्पृशेत् ।\nरेतः पिबति दुर्बुद्धिः सहस्रं नव पंच च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003492001, "chapter_id": 23492, "verse_number": "१३२-२", "content_sanskrit": "वर्षं नारायणाच्छ्रुत्वा सा मही संशितव्रता ।\nततो दीनमना भूत्वा प्रोवाच मधुसूदनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003492002, "chapter_id": 23492, "verse_number": "१३२-३", "content_sanskrit": "धरण्युवाच ।\nकिमिदं भाषसे देव धर्मं भीषणसङ्कटम् ।\nकथमेवं पुमान्वै स रेतःपानपरो भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003492003, "chapter_id": 23492, "verse_number": "१३२-४", "content_sanskrit": "एतन्मे परमं दुःखं तद्भवान्वक्तुमर्हति ।\nश्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि इदं गुह्यमनुत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003492004, "chapter_id": 23492, "verse_number": "१३२-५", "content_sanskrit": "चिह्नमैतद्वरारोहे आधिचारविनिश्चयः।\nपुरुषः स्त्रीषु कर्माणि यो विकुर्वीत निर्घृणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003492005, "chapter_id": 23492, "verse_number": "१३२-६", "content_sanskrit": "दृष्टं तस्यापराधस्य फलं प्राप्नोति मानवः ।\nएवमेतद्वरारोहे यन्मां त्वं परिपृच्छसि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003492006, "chapter_id": 23492, "verse_number": "१३२-७", "content_sanskrit": "अपराधस्य दोषेण विशुद्धिश्च न जायते ।\nप्रायश्चित्तं प्रवक्ष्यामि रागदोषेण दोषितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003492007, "chapter_id": 23492, "verse_number": "१३२-८", "content_sanskrit": "गृहस्थाः पुरुषा भद्रे मम कर्मपरायणाः ।\nयावकेन त्रयं क्षिप्त्वा पिण्याकेन दिनत्रयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003492008, "chapter_id": 23492, "verse_number": "१३२-९", "content_sanskrit": "वायुभक्षं दिनं त्वेकं ततो मुच्येत किल्बिषात् ।\nय एवं कुरुते भूमे विधिदृष्टेन कर्मणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003492009, "chapter_id": 23492, "verse_number": "१३२-१०", "content_sanskrit": "ज्ञात्वा कर्मापराधं तु न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003492010, "chapter_id": 23492, "verse_number": "१३२-११", "content_sanskrit": "एतत्ते कथितं भद्रे मिथुनं योऽभिगच्छति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003492011, "chapter_id": 23492, "verse_number": "१३२-१२", "content_sanskrit": "प्रायश्चित्तं महाभागे मम लोकसुखावहम् ।\nस्पृष्ट्वा तु मृतकं भद्रे नरं पंचत्वमागतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003492012, "chapter_id": 23492, "verse_number": "१३२-१३", "content_sanskrit": "मम शास्त्रं बहिष्कृत्य यः श्मशानं प्रपद्यते ।\nपितरस्तस्य सुश्रोणि आत्मनश्च पितामहाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003492013, "chapter_id": 23492, "verse_number": "१३२-१४", "content_sanskrit": "श्मशाने जम्बुका भूत्वा भक्षयन्ति शवान् तथा ।\nततो हरेवर्चः श्रुत्वा धर्मकामा वसुन्धरा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003492014, "chapter_id": 23492, "verse_number": "१३२-१५", "content_sanskrit": "उवाच मधुरं वाक्यं सर्वलोकहिताय वै ।\nधरण्युवाच ।\nतव नाथ प्रपन्नानां क्व पापं विद्यते प्रभो ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003492015, "chapter_id": 23492, "verse_number": "१३२-१६", "content_sanskrit": "प्रायश्चित्तं च मे ब्रूहि येन मुच्यन्ति किल्बिषात् ।\nश्रीवराह उवाच ।\nशृणु सुन्दरि तत्त्वेन यन्मां त्वं परिपृच्छसि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003492016, "chapter_id": 23492, "verse_number": "१३२-१७", "content_sanskrit": "कथयिष्यामि ते हीदं शोभनं पापनाशनम् ।\nएकाहारो दिनान्सप्त त्रिरात्रं चाप्युपोषितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003492017, "chapter_id": 23492, "verse_number": "१३२-१८", "content_sanskrit": "पंचगव्यं ततः पीत्वा ततो मुच्येत किल्बिषात् ।\nशवे स्पृष्टेऽपराधस्य एष ते कथितो विधिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003492018, "chapter_id": 23492, "verse_number": "१३२-१९", "content_sanskrit": "सर्वथा वर्जनीयं वै सर्वभागवतेन तु ।\nय एतेन विधानेन प्रायश्चित्तं समाचरेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003492019, "chapter_id": 23492, "verse_number": "१३२-२०", "content_sanskrit": "विमुक्तः सर्वपापेभ्यो नापराधोऽस्ति तस्य वै ।\nनारीं रजस्वलां स्पृष्ट्वा यो मां स्पृशति निर्भयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003492020, "chapter_id": 23492, "verse_number": "१३२-२१", "content_sanskrit": "रागमोहेन संयुक्तः कामेन  च वशीकृतः ।\nवर्षाणां तु सहस्रैकं रजः पिबति निर्घृणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003492021, "chapter_id": 23492, "verse_number": "१३२-२२", "content_sanskrit": "अन्धश्च जायते देवि दरिद्रो ज्ञानमूर्खवान्।\nन च विन्दति चात्मानं पतितो नरके यथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003492022, "chapter_id": 23492, "verse_number": "१३२-२३", "content_sanskrit": "अपराधमिमं कृत्वा तत्रैवं नास्ति संशयः ।\nधरण्युवाच ।\nतव देव प्रपन्नानां मोक्षं संसारसागरात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003492023, "chapter_id": 23492, "verse_number": "१३२-२४", "content_sanskrit": "अपराधसमायुक्तस्तव कर्मपरायणः ।\nकर्मणा येन शुध्येत तन्मे ब्रूहि जनार्दन ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003492024, "chapter_id": 23492, "verse_number": "१३२-२५", "content_sanskrit": "श्रीवराह उवाच ।\nस्पृष्ट्वा रजस्वलां नारीं नरो मद्भक्तितत्परः ।\nतपः कृत्वा त्रिरात्रं तु आकाशशयने वसेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003492025, "chapter_id": 23492, "verse_number": "१३२-२६", "content_sanskrit": "शुद्धो भागवतो भूत्वा मम कर्मपरायणः ।\nएवं कृत्वा महाभागे प्रायश्चित्तं मम प्रियम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003492026, "chapter_id": 23492, "verse_number": "१३२-२७", "content_sanskrit": "मुच्यते किल्बिषाद्देवि आचारेण बहिष्कृतः ।\nएतत्ते कथितं भद्रे यत्स्पृष्ट्वा तु रजस्वलाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003492027, "chapter_id": 23492, "verse_number": "१३२-२८", "content_sanskrit": "स्पृष्ट्वा तु मृतकं देवि यो मत्क्षेत्रेषु तिष्ठति ।\nशतवर्षसहस्राणि गर्भेषु परिवर्त्तते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003492028, "chapter_id": 23492, "verse_number": "१३२-२९", "content_sanskrit": "दशवषर्सहस्राणि चण्डालश्चैव जायते ।\nअन्धः सप्तसहस्राणि मण्डूकश्च शतं समाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003492029, "chapter_id": 23492, "verse_number": "१३२-३०", "content_sanskrit": "मक्षिका त्रीणि वर्षाणि टिट्टिभैकादशं समाः ।\nदंशो वै सप्त चान्यानि कृकलासो भवेत्समाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003492030, "chapter_id": 23492, "verse_number": "१३२-३१", "content_sanskrit": "हस्ती वर्षशतं चैव खरो द्वात्रिंशकं भवेत् ।\nमार्जारो नववर्षाणि वानरो दशपञ्च च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003492031, "chapter_id": 23492, "verse_number": "१३२-३२", "content_sanskrit": "एवं स चात्मदोषेण मम कर्मपरायणः ।\nप्राप्नोति सुमहद्दुःखं देवि चैवं न संशयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003492032, "chapter_id": 23492, "verse_number": "१३२-३३", "content_sanskrit": "ततो हरेर्वचः श्रुत्वा दुःखेन परिपृच्छति ।\nसर्वसंसारमोक्षाय प्रत्युवाच वसुन्धरा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003492033, "chapter_id": 23492, "verse_number": "१३२-३४", "content_sanskrit": "धरण्युवाच ।\nकिमिदं भाषसे देव मानुषाणां दुरासदम् ।\nवाक्यं भीषणमत्यन्तं मम मर्मप्रभेदकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003492034, "chapter_id": 23492, "verse_number": "१३२-३५", "content_sanskrit": "आचाराच्च परिभ्रष्टस्तवकर्मपरायणः ।\nयथा तरति दुर्गाणि प्रायश्चित्तं तथा वद ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003492035, "chapter_id": 23492, "verse_number": "१३२-३६", "content_sanskrit": "श्रुत्वा पृथ्व्यास्तथा वाक्यं लोकनाथो जनार्द्दनः ।\nधर्मसंरक्षणार्थाय प्रत्युवाच वसुन्धराम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003492036, "chapter_id": 23492, "verse_number": "१३२-३७", "content_sanskrit": "श्रीवराह उवाच ।\nस्पृष्ट्वा तु मृतकं भूमे मम कर्मपरायणः ।\nएकाहारं ततस्तिष्ठेद्दिनानि दश पञ्च च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003492037, "chapter_id": 23492, "verse_number": "१३२-३८", "content_sanskrit": "तत एवं विधिं कृत्वा पञ्चगव्यं तु प्राशयेत् ।\nशुद्धभावं विशुद्धात्मा कर्मणा च न लिप्यते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003492038, "chapter_id": 23492, "verse_number": "१३२-३९", "content_sanskrit": "एतत्ते कथितं देवि स्पृष्ट्वा मृतकमेव च ।\nदोषं चैव विशुद्ध्यर्थं यत्त्वया पूर्वपृच्छितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003492039, "chapter_id": 23492, "verse_number": "१३२-४०", "content_sanskrit": "य एतेन विधानेन प्रायश्चित्तं समाचरेत् ।\nअपराधविमुक्तो वै मम लोकं स गच्छति॥ ३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]