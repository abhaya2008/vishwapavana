[{"id": 2140273, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140274, "chapter_id": 4027, "verse_number": "१", "content_sanskrit": "ततो विराटः कौन्तेयानतिमानुषविक्रमान् ।\nअर्चयामास वित्तेन मानेन च महारथान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140275, "chapter_id": 4027, "verse_number": "२", "content_sanskrit": "वचसा चैव सान्त्वेन स्नेहेन च मुदाऽन्वितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140276, "chapter_id": 4027, "verse_number": "३", "content_sanskrit": "यथैव मम रत्नानि युष्माकं तानि वै तथा ।\nकार्यं कुरुत तैः सर्वैर्यथाकामं यथासुखम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140277, "chapter_id": 4027, "verse_number": "४", "content_sanskrit": "ददाम्यलङ्कृताः कन्या वसूनि विविधानि च ।\nमनसा चाप्यभिप्रेतं यद् वः शत्रुनिबर्हणाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140278, "chapter_id": 4027, "verse_number": "५", "content_sanskrit": "युष्माकं विक्रमादद्य मुक्तोऽहं स्वस्तिमानिति ।\nतस्माद् भवन्तो मत्स्यानामीश्वराः सर्व एव हि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140279, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140280, "chapter_id": 4027, "verse_number": "६", "content_sanskrit": "तं तथावादिनं सर्वे कौरवेयाः पृथक् पृथक् ।\nऊचुः प्रहृष्टमनसो युधिष्ठिरपुरोगमाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140281, "chapter_id": 4027, "verse_number": "७", "content_sanskrit": "प्रतिनन्दामहे वाचं सर्वथैव विशाम्पते ।\nएतेनैवाद्य प्रीताः स्मो यत् त्वं मुक्तोऽसि शत्रुभिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140282, "chapter_id": 4027, "verse_number": "८", "content_sanskrit": "यत् त्वं मुक्तोऽसि शत्रुभ्यो ह्येतत् कार्यं हितं हि नः ।\nन किञ्चित् कार्यमस्माकं न धनं मृगयामहे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140283, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140284, "chapter_id": 4027, "verse_number": "९", "content_sanskrit": "अथाब्रवीत् प्रीतमना मत्स्यराजो युधिष्ठिरम् ।\nपुनरेव महाबाहुर्विराटो राजसत्तमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140285, "chapter_id": 4027, "verse_number": "१०", "content_sanskrit": "एहि त्वामभिषेक्ष्यामि मत्स्यराजस्तु नो भवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140286, "chapter_id": 4027, "verse_number": "११", "content_sanskrit": "मनसा चाप्यभिप्रेतं यत् ते शत्रुनिबर्हण ।\nतत् तुभ्यं सम्प्रदास्यामि सर्वमर्हति नो भवान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140287, "chapter_id": 4027, "verse_number": "१२", "content_sanskrit": "रत्नानि गाः सुवर्णं च मणिमुक्तमथापि च ।\nवैयाघ्रपद्य विप्रेन्द्र सर्वथैव नमोऽस्तु ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140288, "chapter_id": 4027, "verse_number": "१३", "content_sanskrit": "त्वत्कृते ह्यद्य पश्यामि राज्यमात्मानमेव च ।\nयतश्च जातः संरम्भः स च शत्रुर्वशं गतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140289, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140290, "chapter_id": 4027, "verse_number": "१४", "content_sanskrit": "ततो युधिष्ठिरो मात्स्यं पुनरेवाब्रवीद् वचः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140291, "chapter_id": 4027, "verse_number": "१५", "content_sanskrit": "प्रतिनन्दामि ते वाक्यं मनोज्ञं मात्स्य भाषितम् ।\nआनृशंस्यपरो नित्यं सुमुखः सततं भव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140292, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140293, "chapter_id": 4027, "verse_number": "१६", "content_sanskrit": "पुनरेव विराटश्च राजा कङ्कमभाषत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140294, "chapter_id": 4027, "verse_number": "१७", "content_sanskrit": "अहो सूदस्य कर्माणि वललस्य द्विजोत्तम ।\nसोऽहं शूद्रेण सङ्ग्रामे वललेनाभिरक्षितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140295, "chapter_id": 4027, "verse_number": "१८", "content_sanskrit": "त्वत्कृते सर्वमेवैतदुपपन्नं ममानघ ।\nवरं वृणीष्व भद्रं ते ब्रूहि किं करवाणि ते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140296, "chapter_id": 4027, "verse_number": "१९", "content_sanskrit": "ददामि ते महाप्रीत्या रत्नान्युच्चावचानि च ।\nशयनासनयानानि कन्याश्च समलङ्कृताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140297, "chapter_id": 4027, "verse_number": "२०", "content_sanskrit": "हस्त्यश्वरथसङ्घांश्च राष्ट्राणि विविधानि च ।\nएतानि च मम प्रीत्या प्रतिगृह्णीष्व सुव्रत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140298, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140299, "chapter_id": 4027, "verse_number": "२१", "content_sanskrit": "तं तथावादिनं तत्र कौरव्यः प्रत्यभाषत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140300, "chapter_id": 4027, "verse_number": "२२", "content_sanskrit": "एषैव तु मम प्रीतिर्यत् त्वं मुक्तोऽसि शत्रुभिः ।\nप्रतीपस्ते पुनस्तुष्टः प्रवेक्ष्यति तदाऽनघ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140301, "chapter_id": 4027, "verse_number": "२३", "content_sanskrit": "दारैः पुत्रैश्च संश्लिष्टः सा हि प्रीतिर्ममातुला\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140302, "chapter_id": 4027, "verse_number": "२४", "content_sanskrit": "सुशर्माणं तु राजेन्द्र सभृत्यबलवाहनम् ।\nविसर्जय नृपश्रेष्ठ एतदेव वरं वृणु\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140303, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140304, "chapter_id": 4027, "verse_number": "२५", "content_sanskrit": "एवमुक्तस्तु कङ्केन विराटो राजसत्तमः ।\nप्रत्युवाच ततः कङ्कं सुशर्मा यातु चेष्टतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140305, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140306, "chapter_id": 4027, "verse_number": "२६", "content_sanskrit": "गच्छन्तु दूतास्त्वरिता नगरं तव पार्थिव ।\nसुहृदां प्रियमाख्यातुं घोषयन्तु च ते जयम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140307, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140308, "chapter_id": 4027, "verse_number": "२७", "content_sanskrit": "ततस्तद्वचनान्मात्स्यो दूतान् राजा समादिशत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140309, "chapter_id": 4027, "verse_number": "२८", "content_sanskrit": "आचक्षध्वं पुरं गत्वा सङ्ग्रामे विजयं मम ।\nकुमार्यः समलङ्कृत्य पर्यागच्छन्तु मे पुरात्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140310, "chapter_id": 4027, "verse_number": "२९", "content_sanskrit": "वादित्राणि च सर्वाणि गणिकाश्च स्वलङ्कृताः ।\nप्रत्यायान्तु च मे शीघ्रं नागराः सर्व एव हि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140311, "chapter_id": 4027, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140312, "chapter_id": 4027, "verse_number": "३०", "content_sanskrit": "एवमुक्तास्तथा दूता रात्रौ यात्वा तु केवलम् ।\nततोऽन्तरा वै उषिता दूताः शीघ्रानुयायिनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140313, "chapter_id": 4027, "verse_number": "३१", "content_sanskrit": "नगरं प्राविशंस्ते वै सम्यगभ्युदिते रवौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140314, "chapter_id": 4027, "verse_number": "३२", "content_sanskrit": "विराटनगरं प्राप्य शीघ्रं नान्दीमघोषयन् ।\nपताकोत्तरमालाढ्यं पुरमप्रतिमं यथा \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140315, "chapter_id": 4027, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥\nगोग्रहणपर्वणि अष्टमोऽध्यायः ॥८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]