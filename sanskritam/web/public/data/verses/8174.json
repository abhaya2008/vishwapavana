[{"id": 900000595, "chapter_id": 8174, "verse_number": "1.1", "content_sanskrit": "चेतनाचेतनजगन्नियन्त्रे शेषसंविदे ।नमो नारायणायजशर्वशक्रादिवन्दित", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000596, "chapter_id": 8174, "verse_number": "1.2", "content_sanskrit": "बहुलिङ्गसहितश्रुतेरपि सावकाशायाः निरवकाशश्रुत्यादीनामेव बलवत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000597, "chapter_id": 8174, "verse_number": "1.3", "content_sanskrit": "\"प्राणानां ग्रन्थिरसि' \"रुद्रो वै लोकायतनम्'", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000598, "chapter_id": 8174, "verse_number": "1.4", "content_sanskrit": "अवरत्वादिधर्मनियन्तृत्वं तत्तादात्म्यवत्वं चेति द्विविधं ह्यवरत्वादि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]