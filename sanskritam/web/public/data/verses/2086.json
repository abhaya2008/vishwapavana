[{"id": 2049464, "chapter_id": 2086, "verse_number": "७-१३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049465, "chapter_id": 2086, "verse_number": "७-१३-१", "content_sanskrit": "सान्तरे तु प्रतिज्ञाने राज्ञो द्रोणेन निग्रहे।\nततस्ते सैनिकाः श्रुत्वा तं युधिष्ठिरनिग्रहम्।\nसिंहनादरवांश्चक्रुर्बाहुशब्दांश्च कृत्स्नशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049466, "chapter_id": 2086, "verse_number": "७-१३-२", "content_sanskrit": "तच्च सर्वं यथान्यायं धर्मराजेन भारत।\nआप्तैश्चारैः परिज्ञातं भारद्वाजचिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049467, "chapter_id": 2086, "verse_number": "७-१३-३", "content_sanskrit": "ततः सर्वान्समानाय्य भ्रातृनन्यांश्च सर्वशः।\nअव्रवीद्धर्मराजस्तु धनञ्जयमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049468, "chapter_id": 2086, "verse_number": "७-१३-४", "content_sanskrit": "श्रुतं ते पुरुषव्याघ्र द्रोणस्याद्य चिकीर्षितम्।\nयथा तन्न भवेत्सत्यं तथा नीतिर्विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049469, "chapter_id": 2086, "verse_number": "७-१३-५", "content_sanskrit": "सान्तरं हि प्रतिज्ञातं द्रोणेनामित्रघातिना।\nतच्चान्तरममोघेषौ त्वयि तेन समाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049470, "chapter_id": 2086, "verse_number": "७-१३-६", "content_sanskrit": "तत्त्वमद्य महाबाहो युध्यस्व मदनन्तरम्।\nयथा दुर्योधनः कामं नेमं द्रोणादवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049471, "chapter_id": 2086, "verse_number": "७-१३-७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049472, "chapter_id": 2086, "verse_number": "७-१३-७", "content_sanskrit": "यथा मे न वधः कार्य आचार्यस्य कथञ्चन।\nतथा तव परित्यागो न मे राजंश्चिकीर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049473, "chapter_id": 2086, "verse_number": "७-१३-८", "content_sanskrit": "अप्येवं पाण्डव प्राणानुत्सृजेयमहं युधि।\nप्रतियाताऽहमाचार्यं त्वां न जह्यां कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049474, "chapter_id": 2086, "verse_number": "७-१३-९", "content_sanskrit": "त्वां निगृह्याहवे राजन्धार्तराष्ट्रो यमिच्छति।\nन स तं जीवलोकेऽस्मिन्कामं प्राप्ता कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049475, "chapter_id": 2086, "verse_number": "७-१३-१०", "content_sanskrit": "प्रपतेद्द्यौः सनक्षत्रा पृथिवी शकली भवेत्।\nन त्वां द्रोणो निगृह्णीयाज्जीवमाने मयि ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049476, "chapter_id": 2086, "verse_number": "७-१३-११", "content_sanskrit": "यदि तस्य रणे साह्यं कुरुते वज्रभृत्स्वयम्।\nविष्णुर्वा सहितो देवैर्न त्वां प्राप्स्यत्यसौ मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049477, "chapter_id": 2086, "verse_number": "७-१३-१२", "content_sanskrit": "मयि जीवति राजेन्द्र न भयं कर्तुमर्हसि।\nद्रोणादस्त्रभृतां श्रेष्ठात्सर्वशस्त्रभृतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049478, "chapter_id": 2086, "verse_number": "७-१३-१३", "content_sanskrit": "अन्यच्च ब्रूयां राजेन्द्र प्रतिज्ञां मम निश्चलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049479, "chapter_id": 2086, "verse_number": "७-१३-१४", "content_sanskrit": "न स्मराम्यनृतं तावन्न स्मरामि पराजयम्।\nन स्मरामि प्रतिश्रुत्य विस्मृत्य मनस्वऽकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049480, "chapter_id": 2086, "verse_number": "७-१३-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049481, "chapter_id": 2086, "verse_number": "७-१३-१५", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च मृदङ्गाश्चानकैः सह।\nप्रावाद्यन्त महाराज पाण्डवानां निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049482, "chapter_id": 2086, "verse_number": "७-१३-१६", "content_sanskrit": "सिंहनादश्च संजज्ञे पाण्डवानां महात्मनाम्॥\nधनुर्ज्यातलशब्दश्च गगनस्पृक्सुभैरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049483, "chapter_id": 2086, "verse_number": "७-१३-१७", "content_sanskrit": "श्रुत्वा शङ्खस्य निर्घोषं पाण्डवस्य महौजसः।\nत्वदीयेष्वप्यनीकेषु वादित्राण्यभिजघ्निरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049484, "chapter_id": 2086, "verse_number": "७-१३-१८", "content_sanskrit": "ततो व्यूढान्यनीकानि तव तेषां च भारत।\nशनैरुपेयुरन्योन्यं योत्स्यमानानि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049485, "chapter_id": 2086, "verse_number": "७-१३-१९", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं रोमहर्षणम्।\nपाण्डवानां कुरूणां च द्रोणपाञ्चाल्ययोरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049486, "chapter_id": 2086, "verse_number": "७-१३-२०", "content_sanskrit": "यतमानाः प्रयतेन द्रोणानीकविशातने।\nन शेकुः सृञ्जया युद्धे तद्धि द्रोणेन पालितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049487, "chapter_id": 2086, "verse_number": "७-१३-२१", "content_sanskrit": "तथैव तव पुत्रस्य रथोदाराः प्रहारिणः।\nन शेकुः पाण्डवीं सेनां पाल्यमानां किरीटीना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049488, "chapter_id": 2086, "verse_number": "७-१३-२२", "content_sanskrit": "आस्तां ते स्तिमिते सेने रक्ष्यमाणे परस्परम्।\nसम्प्रसुप्ते यथा नक्तं वनराज्यौ सुपुष्पिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049489, "chapter_id": 2086, "verse_number": "७-१३-२३", "content_sanskrit": "ततो रुक्मरथो राजन्नर्केणेव विराजता।\nवरूथिना विनिष्पत्य व्यचरत्पृतनामुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049490, "chapter_id": 2086, "verse_number": "७-१३-२४", "content_sanskrit": "तमुद्यन्तं रथेनैकमाशुकारिणमाहवे।\nअनेकमिव सन्त्रसान्मेनिरे पाण्डुसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049491, "chapter_id": 2086, "verse_number": "७-१३-२५", "content_sanskrit": "तेन मुक्ताः शरा घोरा विचेरुः सर्वतोदिशम्।\nत्रासयन्तो महाराज पाण्डवेयस्य वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049492, "chapter_id": 2086, "verse_number": "७-१३-२६", "content_sanskrit": "मध्यन्दिनमनुप्राप्तो गभस्तिशतसंवृतः।\nयथा दृश्येत घर्मोशुस्तथा द्रोणोऽप्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049493, "chapter_id": 2086, "verse_number": "७-१३-२७", "content_sanskrit": "न चैनं पाण्डवेयानां कश्चिच्छक्नोति भारत।\nवीक्षितुं समरे क्रुद्धं महेन्द्रमिव दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049494, "chapter_id": 2086, "verse_number": "७-१३-२८", "content_sanskrit": "मोहयित्वा ततः सैन्यं भारद्वाजः प्रतापवान्।\nधृष्टद्युम्नबलं तूर्णं व्यधमन्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049495, "chapter_id": 2086, "verse_number": "७-१३-२९", "content_sanskrit": "स दिशः सर्वतो रुद्ध्वा संवृत्य खमजिह्मगैः।\nपार्षतो यत्र तत्रैनामभिनत्पाण्डुवाहिनीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049496, "chapter_id": 2086, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि एकादशदिवसयुद्धे त्रयोदशोऽध्यायः॥ १३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३-२२ सम्प्रसुप्ते कृतपत्रसङ्कोचे॥ ५-१३-२३ वरूथिना रथेन॥ ५-१३-१३ त्रयोदशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]