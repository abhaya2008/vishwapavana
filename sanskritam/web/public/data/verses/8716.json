[{"id": 900008935, "chapter_id": 8716, "verse_number": "6.1", "content_sanskrit": "यच्चोच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008936, "chapter_id": 8716, "verse_number": "6.2", "content_sanskrit": "एतेनायं तन्तुपटसम्बन्धप्रत्ययश्चाक्षुषः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008937, "chapter_id": 8716, "verse_number": "6.3", "content_sanskrit": "तथापि मण्युक्तं गुण्यादिना सह ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008938, "chapter_id": 8716, "verse_number": "6.4", "content_sanskrit": "किञ्च समवायसिद्ध्यनन्तरमपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008939, "chapter_id": 8716, "verse_number": "6.5", "content_sanskrit": "किञ्चाभाववद्भूतलमित्यभावविशिष्टबुद्धिवत्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008940, "chapter_id": 8716, "verse_number": "6.6", "content_sanskrit": "एवमसंयुक्तविषयकसत्यविशिष्टबुद्धयः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008941, "chapter_id": 8716, "verse_number": "6.7", "content_sanskrit": "नापि गुणक्रियाजातिविशिष्टसत्यबुद्धयः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008942, "chapter_id": 8716, "verse_number": "6.8", "content_sanskrit": "ननु तथात्वे पटाभाववति घटवति घटाभावधीः स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008943, "chapter_id": 8716, "verse_number": "6.9", "content_sanskrit": "ननु तदा रक्तरूपाभावात्तदप्रतीतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008944, "chapter_id": 8716, "verse_number": "6.10", "content_sanskrit": "किञ्च त्वद्रीत्याश्रयणेपि किमत्यन्ताभावस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008945, "chapter_id": 8716, "verse_number": "6.11", "content_sanskrit": "किञ्च रूपसमवायवतोपि वायो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008946, "chapter_id": 8716, "verse_number": "6.12", "content_sanskrit": "ननु अभावस्य स्वाश्रयेण नित्यसम्बन्धश्चेत् ध्वंसस्यापि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008947, "chapter_id": 8716, "verse_number": "6.13", "content_sanskrit": "किञ्च यदि लाघवान्नित्यसम्बन्धिकारणनाशः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008948, "chapter_id": 8716, "verse_number": "6.14", "content_sanskrit": "एतेनैव सत्यलौकिकप्रत्यक्षजातिगुणक्रियाविशिष्टबुद्धयः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008949, "chapter_id": 8716, "verse_number": "6.15", "content_sanskrit": "यत्तु युतसिद्धसम्बन्धिद्वयविषयाणां..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008950, "chapter_id": 8716, "verse_number": "6.16", "content_sanskrit": "अभावप्रतियोगिनोर्ज्ञानज्ञेयादीनां च विवेकप्रकाशस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008951, "chapter_id": 8716, "verse_number": "6.17", "content_sanskrit": "किञ्च कालस्य स्वगतेन सङ्ख्यापरिमाणादिना ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008952, "chapter_id": 8716, "verse_number": "6.18", "content_sanskrit": "अपि च गुणादेरपि त्वन्मते स्वाभावस्वज्ञानस्वकालैः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008953, "chapter_id": 8716, "verse_number": "6.19", "content_sanskrit": "किञ्च समवायस्यैकत्वमयुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008954, "chapter_id": 8716, "verse_number": "6.20", "content_sanskrit": "अपि चात्माकाशकालादौ रूपरसादिसमवायस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008955, "chapter_id": 8716, "verse_number": "6.21", "content_sanskrit": "न हि सम्बन्धनाशेपि सम्बन्धिनः स्थितिवत् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008956, "chapter_id": 8716, "verse_number": "6.22", "content_sanskrit": "एतेन लाघवतर्कसहकृतेन धर्मिग्राहकानुमानेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]