[{"id": 2067404, "chapter_id": 2418, "verse_number": "९-३६-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067405, "chapter_id": 2418, "verse_number": "९-३६-१", "content_sanskrit": "किमर्थं भगवान्सोमो यक्ष्मणा समगृह्यत।\nकथं च तीर्थप्रवरे तस्मिंश्चन्द्रो न्यमज्जत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067406, "chapter_id": 2418, "verse_number": "९-३६-२", "content_sanskrit": "कथमाप्लुत्य तस्मिंस्तु पुनराप्यायितः शशी।\nएतन्मे सर्वमाचक्ष्व विस्तरेण महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067407, "chapter_id": 2418, "verse_number": "९-३६-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067408, "chapter_id": 2418, "verse_number": "९-३६-३", "content_sanskrit": "दक्षस्य तनयास्तात प्रादुरासन्विशाम्पते।\nस सप्तविंशतिं कन्या दक्ष सोमाय वै ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067409, "chapter_id": 2418, "verse_number": "९-३६-४", "content_sanskrit": "नक्षत्रयोगनिरताः सङ्ख्यानार्थं च ताभवन्।\nपत्न्यो वै तस्य राजेन्द्र सोमस्य शुभकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067410, "chapter_id": 2418, "verse_number": "९-३६-५", "content_sanskrit": "तास्तु सर्वा विशालाक्ष्यो रूपेणाप्रतिमाऽभवन्।\nअत्यरिच्यत तासां तु रोहिणी रुपसम्पदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067411, "chapter_id": 2418, "verse_number": "९-३६-६", "content_sanskrit": "ततस्तस्यां स भगवान्प्रीतिं चक्रे निशाकरः।\nसाऽस्य हृद्या बभूवाथ तस्मात्तां बुभुजे सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067412, "chapter_id": 2418, "verse_number": "९-३६-७", "content_sanskrit": "ततस्ताः कुपिताः सर्वा नक्षत्राख्या महात्मनः।\nता गत्वा पितरं प्राहुः प्रजापतिमतन्द्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067413, "chapter_id": 2418, "verse_number": "९-३६-८", "content_sanskrit": "सोमो वसति नास्मासु रोहिणीं भजते सदा।\nता वयं सहिताः सर्वास्त्वत्सकाशे प्रजेश्वर।\nवत्स्यामो नियताहारास्तपश्चरणतत्पराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067414, "chapter_id": 2418, "verse_number": "९-३६-९", "content_sanskrit": "श्रुत्वा तासां तु वचनं दक्षः सोममथाब्रवीत्।\nसमं वर्तस्व सर्वासु मा त्वाऽधर्मो महान्स्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067415, "chapter_id": 2418, "verse_number": "९-३६-१०", "content_sanskrit": "तास्तु सर्वाऽब्रवीद्दक्षो गच्छध्वं शशिनोन्तिकम्।\nसमं वत्स्यति सर्वासु चन्द्रमा मम शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067416, "chapter_id": 2418, "verse_number": "९-३६-११", "content_sanskrit": "विसृष्टास्तास्तथा जग्मुः शीताशोर्भवनं शुभाः।\nतथाऽपि सोमो भगवान्पुनरेव महीपते।\nरोहिण्या सार्धमवसत्प्रीयमाणो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067417, "chapter_id": 2418, "verse_number": "९-३६-१२", "content_sanskrit": "ततस्ताः सहिताः सर्वा भूयः पितरमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067418, "chapter_id": 2418, "verse_number": "९-३६-१३", "content_sanskrit": "सोमो वसति नास्मासु नाकरोद्वचनं तव।\nतव शुश्रूषणे युक्ता वत्स्यामो हि तवान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067419, "chapter_id": 2418, "verse_number": "९-३६-१४", "content_sanskrit": "तासां तद्वचनं श्रुत्वा दक्षः सोममथाब्रवीत्।\nसमं वर्तस्व सर्वासु मा त्वां शप्स्ये विरोचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067420, "chapter_id": 2418, "verse_number": "९-३६-१५", "content_sanskrit": "अनादृत्य तु तद्वाक्यं दक्षस्य भगवाञ्शशी।\nरोहिण्या सार्धमवसत्ततस्ताः कुपिताः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067421, "chapter_id": 2418, "verse_number": "९-३६-१६", "content_sanskrit": "गत्वा च पितरं प्राहुः प्रणम्य शिरसा तदा।\nसोमो वसति नास्मासु तस्मान्नः शरणं भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067422, "chapter_id": 2418, "verse_number": "९-३६-१७", "content_sanskrit": "रोहिण्यामेव भगवान्सदा वसति चन्द्रमाः।\nन त्वद्वचो गणयति नास्मासु स्नेहमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067423, "chapter_id": 2418, "verse_number": "९-३६-१८", "content_sanskrit": "तस्मान्नस्त्राहि सर्वा वै यथा नः सोम आविशेत्।\nतच्छ्रुत्वा भगवान्क्रुद्धो यक्ष्माणं पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067424, "chapter_id": 2418, "verse_number": "९-३६-१९", "content_sanskrit": "ससर्ज रोषात्सोमाय स चोडुपतिमाविशत्।\nस यक्ष्मणाऽभिभूतात्माक्षीयताहरहः शशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067425, "chapter_id": 2418, "verse_number": "९-३६-२०", "content_sanskrit": "यत्नं चाप्यकरोद्राजन्मोक्षार्थं तस्य यक्ष्मणः।\nइष्ट्वेष्टिभिर्महाराज विविधाभिर्निशाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067426, "chapter_id": 2418, "verse_number": "९-३६-२१", "content_sanskrit": "न चामुच्यत शापाद्वै क्षयं चैवाधिगच्छति।\nक्षीयमाणे ततः सोमे ओषध्यो न प्रजज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067427, "chapter_id": 2418, "verse_number": "९-३६-२२", "content_sanskrit": "निरास्वादरसाः सर्वा हतवीर्याश्च सर्वशः।\nओषधीनां क्षये जाते प्राणिनामपि सङ्क्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067428, "chapter_id": 2418, "verse_number": "९-३६-२३", "content_sanskrit": "कृशाश्चासन्प्रजाः सर्वाः क्षीयमाणे निशाकरे।\nततो देवाः समागम्य सोममूचुर्महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067429, "chapter_id": 2418, "verse_number": "९-३६-२४", "content_sanskrit": "किमिदं भवतो रूपमीदृशं सम्प्रकाशते।\nकारणं ब्रूहि नः सर्वं येनेदं ते महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067430, "chapter_id": 2418, "verse_number": "९-३६-२५", "content_sanskrit": "श्रुत्वा तु कारणं त्वत्तो विधास्यामस्ततो वयम्।\nएवमुक्तः प्रत्युवाच सर्वांस्ताञ्शशलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067431, "chapter_id": 2418, "verse_number": "९-३६-२६", "content_sanskrit": "शापस्य कारमं चैव यक्ष्माणं च तथाऽऽत्मनः।\nदेवास्तस्य वचः श्रुत्वा गत्वा दक्षमथाऽब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067432, "chapter_id": 2418, "verse_number": "९-३६-२७", "content_sanskrit": "प्रसीद भगवन्सोमे शापोऽयं विनिवर्त्यताम्।\nअसौ हि चन्द्रमाः क्षीणः किञ्चिच्छेषो हि लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067433, "chapter_id": 2418, "verse_number": "९-३६-२८", "content_sanskrit": "क्षयाच्चैवास्य देवेश प्रजाश्चैव गताः क्षयम्।\nवीरुदोषधयश्चैव बीजानि विविधानि च।\nतथा नरा लोकगुरो प्रसादं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067434, "chapter_id": 2418, "verse_number": "९-३६-२९", "content_sanskrit": "एवमुक्तस्ततो देवान्प्राह वाक्यं प्रजापतिः।\nनैतच्छक्यं मम वचो व्यावर्तयितुमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067435, "chapter_id": 2418, "verse_number": "९-३६-३०", "content_sanskrit": "हेतुना तु महाभागा निवर्तिष्यति केनचित्।\nसमं वर्ततु सर्वासु शशी भार्यासु नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067436, "chapter_id": 2418, "verse_number": "९-३६-३१", "content_sanskrit": "सरस्वत्या वरे तीर्थे निमज्जञ्शशलक्षणः।\nपुनर्वर्धिष्यते देवास्तद्वै सत्यं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067437, "chapter_id": 2418, "verse_number": "९-३६-३२", "content_sanskrit": "मासार्धं च क्षयं सोमो नित्यमेव गमिष्यति।\nमासार्धं तु पुनर्वृद्विं सत्यमेतद्वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067438, "chapter_id": 2418, "verse_number": "९-३६-३३", "content_sanskrit": "समुद्रं पश्चिमं गत्वा सरस्वत्यब्धिसङ्गमम्।\nआराधयतु देवेशं ततः कान्तिमवाप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067439, "chapter_id": 2418, "verse_number": "९-३६-३४", "content_sanskrit": "सरस्वतीं ततः सोमः स जगामर्षिशासनात्।\nप्रभासं प्रथमं तीर्थं सरस्वत्या जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067440, "chapter_id": 2418, "verse_number": "९-३६-३५", "content_sanskrit": "अमावास्यां महातेजास्तत्रामज्जन्महाद्युतिः।\nलोकान्प्रभासयामास शीतांशुत्वमवाप च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067441, "chapter_id": 2418, "verse_number": "९-३६-३६", "content_sanskrit": "देवास्तु सर्वे राजेन्द्र प्रसादं प्राप्य पुष्कलम्।\nसोमेन सहिता भूत्वा दक्षस्य प्रमुखेऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067442, "chapter_id": 2418, "verse_number": "९-३६-३७", "content_sanskrit": "ततः प्रजापतिः सर्वा विससर्जाथ देवताः।\nसोमं च भगवान्प्रीतो भूयो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067443, "chapter_id": 2418, "verse_number": "९-३६-३८", "content_sanskrit": "मावमंस्थाः स्त्रियः पुत्र मा च विप्रान्कदाचन।\nगच्छ युक्तः सदा भूत्वा कुरु वै शासनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067444, "chapter_id": 2418, "verse_number": "९-३६-३९", "content_sanskrit": "स विसृष्टो महाराज जगामाथ स्वमालयम्।\nप्रजाश्च मुदिता भूत्वा ईजिरे च यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067445, "chapter_id": 2418, "verse_number": "९-३६-४०", "content_sanskrit": "एवं ते सर्वमाख्यातं यथा शप्तो निशाकरः।\nप्रभासं च यथा तीर्थं तीर्थानां प्रवरं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067446, "chapter_id": 2418, "verse_number": "९-३६-४१", "content_sanskrit": "अमावास्यां महाराज नित्यशः शशलक्षणः।\nस्नात्वाह्याप्यायते श्रीमान्प्रभासे तीर्थउत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067447, "chapter_id": 2418, "verse_number": "९-३६-४२", "content_sanskrit": "अतश्चैतत्प्रजानन्ति प्रभासमिति भूमिप।\nप्रभां हि परमां लेभे तस्मिंश्चामज्ज्य चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067448, "chapter_id": 2418, "verse_number": "९-३६-४३", "content_sanskrit": "`लोकान्प्रभासयामास पुपोष च वपुस्तथा।\nतत्र स्नात्वा हलीरामो दत्वा प्रीतोऽथ दक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067449, "chapter_id": 2418, "verse_number": "९-३६-४४", "content_sanskrit": "ततस्तु चमसोद्भेदमभीतस्त्वगमद्बली।\nचमसोद्भेद इत्येवं यं जनाः कथयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067450, "chapter_id": 2418, "verse_number": "९-३६-४५", "content_sanskrit": "तत्र दत्त्वा च दानानि विशिष्टानि हलायुधः।\nउषित्वा रजनीमेकां स्नात्वा च विधिवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067451, "chapter_id": 2418, "verse_number": "९-३६-४६", "content_sanskrit": "उदपानमथागच्छत्त्वरावान्केशवाग्रजः।\nआद्यं स्वस्त्ययनं चैव तत्रावाप्य महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067452, "chapter_id": 2418, "verse_number": "९-३६-४७", "content_sanskrit": "स्निग्धत्वादोषधीनां च भूमेश्च जनमेजय।\nजानन्ति सिद्धा राजेन्द्र निगूढां तां सरस्वतीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067453, "chapter_id": 2418, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टादशदिवसयुद्धे षट्त्रिंशोऽध्यायः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]