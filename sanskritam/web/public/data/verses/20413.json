[{"id": 7000413000, "chapter_id": 20413, "verse_number": "२-८५-१", "content_sanskrit": "वेन उवाच ।\nभगवन्देवदेवेश प्रसादाच्च मम त्वया ।\nभार्यातीर्थं समाख्यातं पितृतीर्थमनुत्तमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000413001, "chapter_id": 20413, "verse_number": "२-८५-२", "content_sanskrit": "मातृतीर्थं हृषीकेश बहुपुण्यप्रदायकम् ।\nप्रसादसुमुखो भूत्वा गुरुतीर्थं वदस्व मे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000413002, "chapter_id": 20413, "verse_number": "२-८५-३", "content_sanskrit": "श्रीभगवानुवाच ।\nकथयिष्याम्यहं राजन्गुरुतीर्थमनुत्तमम् ।\nसर्वपापहरं प्रोक्तं शिष्याणां गतिदायकम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000413003, "chapter_id": 20413, "verse_number": "२-८५-४", "content_sanskrit": "शिष्याणां परमं पुण्यं धर्मरूपं सनातनम् ।\nपरं तीर्थं परं ज्ञानं प्रत्यक्षफलदायकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000413004, "chapter_id": 20413, "verse_number": "२-८५-५", "content_sanskrit": "यस्यप्रसादाद्राजेंद्र इहैव फलमश्नुते ।\nपरलोके सुखं भुंक्ते यशः कीर्तिमवाप्नुयात्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000413005, "chapter_id": 20413, "verse_number": "२-८५-६", "content_sanskrit": "प्रसादाद्यस्य राजेंद्र गुरोश्चैव महात्मनः ।\nप्रत्यक्षं दृश्यते शिष्यैस्त्रैलोक्यं सचराचरम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000413006, "chapter_id": 20413, "verse_number": "२-८५-७", "content_sanskrit": "व्यवहारं च लोकानामाचारं नृपनंदन ।\nविज्ञानं विंदते शिष्यो मोक्षं चैव प्रयाति च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000413007, "chapter_id": 20413, "verse_number": "२-८५-८", "content_sanskrit": "सर्वेषामेव लोकानां यथा सूर्यः प्रकाशकः ।\nगुरुः प्रकाशकस्तद्वच्छिष्याणां गतिरुत्तमा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000413008, "chapter_id": 20413, "verse_number": "२-८५-९", "content_sanskrit": "रात्रावेव प्रकाशेच्च सोमो राजा नृपोत्तम ।\nतेजसा साधयेत्सर्वमधिकारं चराचरम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000413009, "chapter_id": 20413, "verse_number": "२-८५-१०", "content_sanskrit": "गृहेप्रकाशयेद्दीपः समूहं नृपसत्तम ।\nतेजसा नाशयेत्सर्वमंधकारघनाविलम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000413010, "chapter_id": 20413, "verse_number": "२-८५-११", "content_sanskrit": "अज्ञानतमसा व्याप्तं शिष्यं द्योतयते गुरुः ।\nशिष्यप्रकाशौद्द्योतैरुपदेशैर्महामते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000413011, "chapter_id": 20413, "verse_number": "२-८५-१२", "content_sanskrit": "दिवाप्रकाशकः सूर्यः शशीरात्रौ प्रकाशकः ।\nगृहप्रकाशको दीपस्तमोनाशकरः सदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000413012, "chapter_id": 20413, "verse_number": "२-८५-१३", "content_sanskrit": "रात्रौ दिवा गृहस्यांते गुरुः शिष्यं सदैव हि ।\nअज्ञानाख्यं तमस्तस्य गुरुः सर्वं प्रणाशयेत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000413013, "chapter_id": 20413, "verse_number": "२-८५-१४", "content_sanskrit": "तस्माद्गुरुः परं तीर्थं शिष्याणामवनीपते ।\nएवं ज्ञात्वा ततः शिष्यः सर्वदा तं प्रपूजयेत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000413014, "chapter_id": 20413, "verse_number": "२-८५-१५", "content_sanskrit": "गुरुं पुण्यमयं ज्ञात्वा त्रिविधेनापि कर्मणा ।\nइत्यर्थे श्रूयते विप्र इतिहासः पुरातनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000413015, "chapter_id": 20413, "verse_number": "२-८५-१६", "content_sanskrit": "सर्वपापहरः प्रोक्तश्च्यवनस्य महात्मनः ।\nभार्गवस्य कुले जातश्च्यवनो मुनिसत्तमः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000413016, "chapter_id": 20413, "verse_number": "२-८५-१७", "content_sanskrit": "तस्य चिंता समुत्पन्ना एकदा तु नृपोत्तम ।\nकदाहं ज्ञानसंपन्नो भविष्यामि महीतले॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000413017, "chapter_id": 20413, "verse_number": "२-८५-१८", "content_sanskrit": "दिवारात्रौप्रचिंतेत्स ज्ञानार्थी मुनिसत्तमः ।\nएवं तु चिंतमानस्य मतिरासीन्महात्मनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000413018, "chapter_id": 20413, "verse_number": "२-८५-१९", "content_sanskrit": "तीर्थयात्रां प्रयास्यामि अभीष्टफलदायिनीम् ।\nगृहक्षेत्रादिसंत्यज्य भार्यां पुत्रं धनं ततः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000413019, "chapter_id": 20413, "verse_number": "२-८५-२०", "content_sanskrit": "तीर्थयात्राप्रसंगेन अटते मेदिनीं तदा ।\nलोमानुलोमयात्रां स गंगायाः कृतवान्नृप॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000413020, "chapter_id": 20413, "verse_number": "२-८५-२१", "content_sanskrit": "स तद्वन्नर्मदायाश्च सरस्वत्या मुनीश्वरः ।\nगोदावर्यादिसर्वासां नदीनां सागरस्य च॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000413021, "chapter_id": 20413, "verse_number": "२-८५-२२", "content_sanskrit": "अन्येषां सर्वतीर्थानां क्षेत्राणां च नृपोत्तम ।\nदेवानां पुण्यलिगानां यात्राव्याजेन सोऽभ्रमत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000413022, "chapter_id": 20413, "verse_number": "२-८५-२३", "content_sanskrit": "भ्रममाणस्य तस्यापि तीर्थेषु परमेषु च ।\nभ्रममाणः समायातः क्षेत्राणामुत्तमं तदा ।\nकायश्च निर्मलो जातः सूर्यतेजः समप्रभः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000413023, "chapter_id": 20413, "verse_number": "२-८५-२४", "content_sanskrit": "च्यवनः काशते दीप्त्या पूतात्मानेन कर्मणा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000413024, "chapter_id": 20413, "verse_number": "२-८५-२५", "content_sanskrit": "नर्मदा दक्षिणे कूले नाम्ना अमरकंटकम् ।\nददर्श सुमहालिगं सर्वेषां गतिदायकम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000413025, "chapter_id": 20413, "verse_number": "२-८५-२६", "content_sanskrit": "नत्वा स्तुत्वा तु संपूज्य सिद्धनाथं महेश्वरम् ।\nज्वालेश्वरं ततो दृष्ट्वा दृष्ट्वा चाप्यमरेश्वरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000413026, "chapter_id": 20413, "verse_number": "२-८५-२७", "content_sanskrit": "ब्रह्मेशं कपिलेशं च मार्कंडेश्वरमुत्तमम् ।\nएवं यात्रां ततः कृत्वा ओंकारं समुपागतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000413027, "chapter_id": 20413, "verse_number": "२-८५-२८", "content_sanskrit": "वटच्छायां समाश्रित्य शीतलां श्रमनाशिनीम् ।\nसुखेन संस्थितो विप्रश्च्यवनो भृगुनंदनः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000413028, "chapter_id": 20413, "verse_number": "२-८५-२९", "content_sanskrit": "तत्र स्वनं स शुश्राव समुक्तं पक्षिणा तदा ।\nदिव्यभाषा समायुक्तं ज्ञानविज्ञानसंयुतम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000413029, "chapter_id": 20413, "verse_number": "२-८५-३०", "content_sanskrit": "शुकश्च एकस्तत्रास्ते बहुकालप्रजीवकः ।\nकुंजलोनाम धर्मात्मा चतुःपुत्रः सभार्यकः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000413030, "chapter_id": 20413, "verse_number": "२-८५-३१", "content_sanskrit": "आसंस्तस्य हि पुत्राश्च चत्वारः पितृनंदनाः ।\nतेषां नामानि राजेंद्र कथयिष्ये तवाग्रतः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000413031, "chapter_id": 20413, "verse_number": "२-८५-३२", "content_sanskrit": "ज्येष्ठस्तु उज्ज्वलो नाम द्वितीयस्तु समुज्ज्वलः ।\nतृतीयो विज्वलोनाम चतुर्थश्च कपिंजलः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000413032, "chapter_id": 20413, "verse_number": "२-८५-३३", "content_sanskrit": "एवं पुत्रास्तु चत्वारः कुंजलस्य महामते ।\nशुकस्य तस्य पुण्यस्य पितृमातृपरायणाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000413033, "chapter_id": 20413, "verse_number": "२-८५-३४", "content_sanskrit": "भ्रमंति गिरिकुंजेषु द्वीपेषु च समाहिताः ।\nभोजनार्थं तु संक्षुब्धाः क्षुधया परिपीडिताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000413034, "chapter_id": 20413, "verse_number": "२-८५-३५", "content_sanskrit": "स्वोदरस्थां क्षुधां सौम्य फलैरमृतसन्निभैः ।\nअमृतस्वादुतोयेन शमयंति नृपोत्तम॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000413035, "chapter_id": 20413, "verse_number": "२-८५-३६", "content_sanskrit": "फलं पक्वं रसालं तु आहारार्थं सुपुत्रकाः ।\nदत्वा फलानि दंपत्योर्निक्षिपंति प्रयत्नतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000413036, "chapter_id": 20413, "verse_number": "२-८५-३७", "content_sanskrit": "मातुरर्थे महाभागा भक्तिभावसमन्विताः ।\nतुष्टा आहारमुत्पाद्य भक्षयंति पठंति च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000413037, "chapter_id": 20413, "verse_number": "२-८५-३८", "content_sanskrit": "तत्र क्रीडारताः सर्वे विलसंति रमंति च ।\nसंध्याकालं समाज्ञाय पितुरंतिकमुत्तमम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000413038, "chapter_id": 20413, "verse_number": "२-८५-३९", "content_sanskrit": "आयांति भक्ष्यमादाय गुर्वर्थं तु प्रयत्नतः ।\nपश्यतस्तस्य विप्रस्य च्यवनस्य महात्मनः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000413039, "chapter_id": 20413, "verse_number": "२-८५-४०", "content_sanskrit": "आगतास्त्वंडजाः सर्वे पितुर्नीडं सुशोभनम् ।\nपितरं मातरं चोभौ प्रणेमुस्ते महामते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000413040, "chapter_id": 20413, "verse_number": "२-८५-४१", "content_sanskrit": "ताभ्यां भक्ष्यं समासाद्य उपतस्थुस्तयोः पुरः ।\nसर्वे संभाषिताः पित्रा मानितास्ते सुतोत्तमाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000413041, "chapter_id": 20413, "verse_number": "२-८५-४२", "content_sanskrit": "मात्रा च कृपया राजन्वचनैः प्रीतिसंमितैः ।\nपक्षवातेन शीतेन मातापित्रोश्च ते तदा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000413042, "chapter_id": 20413, "verse_number": "२-८५-४३", "content_sanskrit": "तेषामाप्यायनं तौ द्वौ चक्राते पक्षिणौ नृप ।\nआशीर्भिरभिनंद्यैव द्वाभ्यामपि सुपुत्रकान्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000413043, "chapter_id": 20413, "verse_number": "२-८५-४४", "content_sanskrit": "तैश्च दत्तं सुसंपुष्टमाहारममृतोपमम् ।\nतावेव हि सुसंप्रीतिं चक्राते द्विजसत्तम॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000413044, "chapter_id": 20413, "verse_number": "२-८५-४५", "content_sanskrit": "पिबतो निर्मलं तोयं तीर्थकोटिसमुद्भवम् ।\nस्वस्थानं तु समाश्रित्य सुखसंतुष्टमानसौ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000413045, "chapter_id": 20413, "verse_number": "२-८५-४६", "content_sanskrit": "चक्राते च कथां दिव्यां सुपुण्यां पापनाशिनीम् ।\nविष्णुरुवाच ।\nपित्रा तु कुंजलेनापि पृष्ट उज्ज्वल आत्मजः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000413046, "chapter_id": 20413, "verse_number": "२-८५-४७", "content_sanskrit": "क्वगतोऽस्यद्य पुत्र त्वं किमपूर्वं त्वया पुनः ।\nतत्र दृष्टं श्रुतं पुण्यं तन्मे कथय नंदन॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000413047, "chapter_id": 20413, "verse_number": "२-८५-४८", "content_sanskrit": "कुंजलस्य पितुर्वाक्यं समाकर्ण्य स उज्ज्वलः ।\nपितरं प्रत्युवाचाथ भक्त्या नमितकंधरः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000413048, "chapter_id": 20413, "verse_number": "२-८५-४९", "content_sanskrit": "प्रणाममकरोन्मूर्ध्ना कथां चक्रे मनोहराम् ।\nउज्ज्वल उवाच ।\nप्लक्षद्वीपं महाभाग नित्यमेव व्रजाम्यहम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000413049, "chapter_id": 20413, "verse_number": "२-८५-५०", "content_sanskrit": "महता उद्यमेनापि आहारार्थं महामते ।\nप्लक्षेद्वीपे महाराज संति देशा अनेकशः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000413050, "chapter_id": 20413, "verse_number": "२-८५-५१", "content_sanskrit": "पर्वताः सरिदुद्यान वनानि च सरांसि च ।\nग्रामाश्च पत्तनाश्चान्ये सुप्रजाभिः प्रमोदिताः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000413051, "chapter_id": 20413, "verse_number": "२-८५-५२", "content_sanskrit": "सदा सुखेन संतुष्टा लोका हृष्टा वसंति ते ।\nदानपुण्यजपोपेताः श्रद्धाभावसमन्विताः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000413052, "chapter_id": 20413, "verse_number": "२-८५-५३", "content_sanskrit": "प्लक्षद्वीपे महाराज आसीत्पुण्यमतिः सदा ।\nदिवोदासस्तु धर्मात्मा तत्सुतासीदनूपमा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000413053, "chapter_id": 20413, "verse_number": "२-८५-५४", "content_sanskrit": "गुणरूपसमायुक्ता सुशीला चारुमंगला ।\nदिव्यादेवीति विख्याता रूपेणाप्रतिमा भुवि॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000413054, "chapter_id": 20413, "verse_number": "२-८५-५५", "content_sanskrit": "पित्रा विलोकिता सा तु रूपतारुण्यमंगला ।\nप्रथमे वयसि सा च वर्त्तते चारुमंगला॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000413055, "chapter_id": 20413, "verse_number": "२-८५-५६", "content_sanskrit": "स तां दृष्ट्वा दिवोदासो दिव्यां देवीं सुतां तदा ।\nकस्मै प्रदीयते कन्या सुवराय महात्मने॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000413056, "chapter_id": 20413, "verse_number": "२-८५-५७", "content_sanskrit": "इति चिंतापरो भूत्वा समालोक्य नरोत्तमः ।\nरूपदेशस्य राजानं समालोक्य महीपतिः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000413057, "chapter_id": 20413, "verse_number": "२-८५-५८", "content_sanskrit": "चित्रसेनं महात्मानं समाहूय नरोत्तमः ।\nकन्यां ददौ महात्मासौ चित्रसेनाय धीमते॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000413058, "chapter_id": 20413, "verse_number": "२-८५-५९", "content_sanskrit": "तस्या विवाहकाले तु संप्राप्ते समये नृप ।\nमृतोसौ चित्रसेनस्तु कालधर्मेण वै किल॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000413059, "chapter_id": 20413, "verse_number": "२-८५-६०", "content_sanskrit": "दिवोदासस्तु धर्मात्मा चिंतयामास भूपतिः ।\nसुब्राह्मणान्समाहूय पप्रच्छ नृपनंदनः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000413060, "chapter_id": 20413, "verse_number": "२-८५-६१", "content_sanskrit": "अस्या विवाहकाले तु चित्रसेनो दिवं गतः ।\nअस्यास्तु कीदृशं कर्म भविष्यति वदंतु मे॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000413061, "chapter_id": 20413, "verse_number": "२-८५-६२", "content_sanskrit": "ब्राह्मणा ऊचुः ।\nविवाहो दृश्यते राजन्कन्यायास्तु विधानतः ।\nपतिर्मृत्युं प्रयात्यस्या नोचेत्संगं करोति च॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000413062, "chapter_id": 20413, "verse_number": "२-८५-६३", "content_sanskrit": "महाधिव्याधिना ग्रस्तस्त्यागं कृत्वा प्रयाति च ।\nप्रव्राजितो भवेद्राजन्धर्मशास्त्रेषु दृश्यते॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000413063, "chapter_id": 20413, "verse_number": "२-८५-६४", "content_sanskrit": "अनुद्वाहितायाः कन्याया उद्वाहः क्रियते बुधैः ।\nन स्याद्रजस्वला यावदन्यः पतिर्विधीयते॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000413064, "chapter_id": 20413, "verse_number": "२-८५-६५", "content_sanskrit": "विवाहं तु विधानेन पिता कुर्यान्न संशयः ।\nएवं राजन्समादिष्टं धर्मशास्त्रं बुधैर्जनैः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000413065, "chapter_id": 20413, "verse_number": "२-८५-६६", "content_sanskrit": "विवाहः क्रियतामस्या इत्यूचुस्ते द्विजोत्तमाः ।\nदिवोदासस्तु धर्मात्मा द्विजवाक्यप्रणोदितः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000413066, "chapter_id": 20413, "verse_number": "२-८५-६७", "content_sanskrit": "विवाहार्थं महाराज उद्यमं कृतवान्नृप ।\nपुनर्दत्ता तु दानेन दिव्यादेवी द्विजोत्तम॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000413067, "chapter_id": 20413, "verse_number": "२-८५-६८", "content_sanskrit": "रूपसेनाय पुण्याय तस्मै राज्ञे महात्मने ।\nमृत्युधर्मं गतो राजा विवाहे तु महीपतिः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000413068, "chapter_id": 20413, "verse_number": "२-८५-६९", "content_sanskrit": "यदा यदा महाभाग दिव्यादेव्याश्च भूपतिः ।\nभर्ता च म्रियते काले प्राप्ते लग्नस्य सर्वदा॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000413069, "chapter_id": 20413, "verse_number": "२-८५-७०", "content_sanskrit": "एकविंशतिभर्तारः काले काले मृताः पितः ।\nततो राजा महादुःखी संजातः ख्यातविक्रमः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000413070, "chapter_id": 20413, "verse_number": "२-८५-७१", "content_sanskrit": "समालोच्य समाहूय समामंत्र्य स मंत्रिभिः ।\nस्वयंवरे महाबुद्धिं चकार पृथिवीपतिः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000413071, "chapter_id": 20413, "verse_number": "२-८५-७२", "content_sanskrit": "प्लक्षद्वीपस्य राजानः समाहूता महात्मना ।\nस्वयंवरार्थमाहूतास्तथा ते धर्मतत्पराः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000413072, "chapter_id": 20413, "verse_number": "२-८५-७३", "content_sanskrit": "तस्यास्तु रूपसंमुग्धा राजानो मृत्युनोदिताः ।\nसंग्रामं चक्रिरे मूढास्ते मृताः समरांगणे॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000413073, "chapter_id": 20413, "verse_number": "२-८५-७४", "content_sanskrit": "एवं तात क्षयो जातः क्षत्रियाणां महात्मनाम् ।\nदिव्यादेवी सुदुःखार्ता गता सा वनकंदरम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000413074, "chapter_id": 20413, "verse_number": "२-८५-७५", "content_sanskrit": "रुरोद करुणं बाला दिव्यादेवी मनस्विनी ।\nएवं तात मया दृष्टमपूर्वं तत्र वै तदा॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000413075, "chapter_id": 20413, "verse_number": "२-८५-७६", "content_sanskrit": "तन्मे सुविस्तरं तात तस्याः कथय कारणम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]