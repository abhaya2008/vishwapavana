[{"id": 7006316000, "chapter_id": 26316, "verse_number": "१-२६-१", "content_sanskrit": "वैशम्पायन उवाच बुधस्य तु महाराज विद्वान् पुत्रः पुरूरवाः ।\nतेजस्वी दानशीलश्च यज्वा विपुलदक्षिणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006316001, "chapter_id": 26316, "verse_number": "१-२६-२", "content_sanskrit": "ब्रह्मवादी पराक्रान्तः शत्रुभिर्युधि दुर्जयः ।\nआहर्ता चाग्निहोत्रस्य यज्ञानां च महीपतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006316002, "chapter_id": 26316, "verse_number": "१-२६-३", "content_sanskrit": "सत्यवादी पुण्यमतिः काम्यः संवृतमैथुनः ।\nअतीव त्रिषु लोकेषु यशसाप्रतिमस्तदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006316003, "chapter_id": 26316, "verse_number": "१-२६-४", "content_sanskrit": "तं ब्रह्मवादिनं क्षान्तं धर्मज्ञं सत्यवादिनम् ।\nउर्वशी वरयामास हित्वा मानं यशस्विनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006316004, "chapter_id": 26316, "verse_number": "१-२६-५", "content_sanskrit": "तया सहावसद् राजा वर्षाणि दश पञ्च च ।\nपञ्च षट्सप्त चाष्टौ च दश चाष्टौ च भारत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006316005, "chapter_id": 26316, "verse_number": "१-२६-६", "content_sanskrit": "वने चैत्ररथे रम्ये तथा मन्दाकिनीतटे ।\nअलकायां विशालायां नन्दने च वनोत्तमे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006316006, "chapter_id": 26316, "verse_number": "१-२६-७", "content_sanskrit": "उत्तरान् स कुरून् प्राप्य मनोरथफलद्रुमान् ।\nगन्धमादनपादेषु  मेरुपृष्ठे तथोत्तरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006316007, "chapter_id": 26316, "verse_number": "१-२६-८", "content_sanskrit": "एतेषु वनमुख्येषु सुरैराचरितेषु च ।\nउर्वश्या सहितो राजा रेमे परमया मुदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006316008, "chapter_id": 26316, "verse_number": "१-२६-९", "content_sanskrit": "देशे पुण्यतमे चैव महर्षिभिरभिष्टुते ।\nराज्यं च कारयामास प्रयागं पृथिवीपतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006316009, "chapter_id": 26316, "verse_number": "१-२६-१०", "content_sanskrit": "तस्य पुत्रा बभूवुस्ते सप्त देवसुतोपमाः ।\nदिवि जाता महात्मान आयुर्धीमानमावसुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006316010, "chapter_id": 26316, "verse_number": "१-२६-११", "content_sanskrit": "विश्वायुश्चैव धर्मात्मा श्रुतायुश्च तथापरः ।\nदृढायुश्च वनायुश्च शतायुश्चोर्वशीसुताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006316011, "chapter_id": 26316, "verse_number": "१-२६-१२", "content_sanskrit": "जनमेजय उवाच गान्धर्वी चोर्वशी देवी राजानं मानुषं कथम् ।\nदेवानुत्सृज्य सम्प्राप्ता तन्नो ब्रूहि बहुश्रुत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006316012, "chapter_id": 26316, "verse_number": "१-२६-१३", "content_sanskrit": "वैशम्पायन उवाच ब्रह्मशापाभिभूता सा मानुषं समपद्यत ।\nऐलं तु सा वरारोहा समयात्समुपस्थिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006316013, "chapter_id": 26316, "verse_number": "१-२६-१४", "content_sanskrit": "आत्मनः शापमोक्षार्थं समयं सा चकार ह ।\nअनग्नदर्शनं चैव सकामायां च मैथुनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006316014, "chapter_id": 26316, "verse_number": "१-२६-१५", "content_sanskrit": "द्वौ मेषौ शयनाभ्याशे सदा बद्धौ च तिष्ठतः ।\nघृतमात्रो तथाऽऽहारः कालमेकं तु पार्थिव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006316015, "chapter_id": 26316, "verse_number": "१-२६-१६", "content_sanskrit": "यद्येष समयो राजन् यावत्कालं च ते दृढः ।\nतावत्कालं तु वत्स्यामि त्वत्तः समय एष नः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006316016, "chapter_id": 26316, "verse_number": "१-२६-१७", "content_sanskrit": "तस्यास्तं समयं सर्वं स राजा समपालयत् ।\nएवं सा वसते तत्र पुरूरवसि भामिनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006316017, "chapter_id": 26316, "verse_number": "१-२६-१८", "content_sanskrit": "बर्षाण्येकोनषष्टिस्तु तत्सक्ता शापमोहिता ।\nउर्वश्यां मानुषस्थायां गन्धर्वाश्चिन्तयान्विताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006316018, "chapter_id": 26316, "verse_number": "१-२६-१९", "content_sanskrit": "गन्धर्वा ऊचुः चिन्तयध्वं महाभागा यथा सा तु वराङ्गना ।\nसमागच्छेत् पुनर्देवानुर्वशी स्वर्गभूषणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006316019, "chapter_id": 26316, "verse_number": "१-२६-२०", "content_sanskrit": "ततो विश्वावसुर्नाम तत्राह वदतां वरः ।\nमया तु समयस्ताभ्यां क्रियमाणः श्रुतः पुरा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006316020, "chapter_id": 26316, "verse_number": "१-२६-२१", "content_sanskrit": "व्युत्क्रान्तसमयं सा वै राजानं त्यक्ष्यते यथा ।\nतदहं वेद्म्यशेषेण यथा भेत्स्यत्यसौ नृपः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006316021, "chapter_id": 26316, "verse_number": "१-२६-२२", "content_sanskrit": "ससहायो गमिष्यामि युष्माकं कार्यसिद्धये ।\nएवमुक्त्वा गतस्तत्र प्रतिष्ठानं महायशाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006316022, "chapter_id": 26316, "verse_number": "१-२६-२३", "content_sanskrit": "निशायामथ चागम्य मेषमेकं जहार सः ।\nमातृवद् वर्तते सा तु मेषयोश्चारुहासिनी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006316023, "chapter_id": 26316, "verse_number": "१-२६-२४", "content_sanskrit": "गन्धर्वागमनं श्रुत्वा शापान्तं च यशस्विनी ।\nराजानमब्रवीत् तत्र पुत्रो मेऽह्रियतेति सा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006316024, "chapter_id": 26316, "verse_number": "१-२६-२५", "content_sanskrit": "एवमुक्तो विनिश्चित्य नग्नो नैवोदतिष्ठत ।\nनग्नं मां द्रक्ष्यते देवी समयो वितथो भवेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006316025, "chapter_id": 26316, "verse_number": "१-२६-२६", "content_sanskrit": "ततो भूयस्तु गन्धर्वा द्वितीयं मेषमाददुः ।\nद्वितीये तु हृते मेषे ऐलं देव्यब्रवीदिदम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006316026, "chapter_id": 26316, "verse_number": "१-२६-२७", "content_sanskrit": "पुत्रो मेऽपहृतो राजन्ननाथाया इव प्रभो ।\nएवमुक्तस्तथोत्थाय नग्नो राजा प्रधावितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006316027, "chapter_id": 26316, "verse_number": "१-२६-२८", "content_sanskrit": "मेषयोः पदमन्विच्छन् गन्धर्वैर्विद्युदप्यथ ।\nउत्पादिता सुमहती ययौ तद्भवनं महत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006316028, "chapter_id": 26316, "verse_number": "१-२६-२९", "content_sanskrit": "प्रकाशितं वै सहसा ततो नग्नमवैक्षत ।\nनग्नं दृष्ट्वा तिरोभूता साप्सरा कामरूपिणी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006316029, "chapter_id": 26316, "verse_number": "१-२६-३०", "content_sanskrit": "उत्सृष्टावुरणौ दृष्ट्वा राजा गृह्यागतो गृहे ।\nअपश्यन्नुर्वशीं तत्र विललाप सुदुःखितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006316030, "chapter_id": 26316, "verse_number": "१-२६-३१", "content_sanskrit": "चचार पृथिवीं सर्वां मार्गमाण इतस्ततः ।\nअथापश्यत् स तां राजा कुरुक्षेत्रे महाबलः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006316031, "chapter_id": 26316, "verse_number": "१-२६-३२", "content_sanskrit": "प्लक्षतीर्थे पुष्करिण्यां हैमवत्यां समाप्लुताम् ।\nक्रीडन्तीमप्सरोभिश्च पञ्चभिः सह शोभनाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006316032, "chapter_id": 26316, "verse_number": "१-२६-३३", "content_sanskrit": "तां क्रीडन्तीं ततो दृष्ट्वा विललाप सुदुःखितः ।\nसा चापि तत्र तं दृष्ट्वा राजानमविदूरतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006316033, "chapter_id": 26316, "verse_number": "१-२६-३४", "content_sanskrit": "उर्वशी ताः सखीः प्राह स एष पुरुषोत्तमः ।\nयस्मिन्नहमवात्सं वै दर्शयामास तं नृपम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006316034, "chapter_id": 26316, "verse_number": "१-२६-३५", "content_sanskrit": "समाविग्नास्तु ताः सर्वाः पुनरेव नराधिपः ।\nजाये ह तिष्ठ मनसा घोरे वचसि तिष्ठ ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006316035, "chapter_id": 26316, "verse_number": "१-२६-३६", "content_sanskrit": "एवमादीनि सूक्तानि परस्परमभाषत ।\nउर्वशी चाब्रवीदैलं सगर्भाहं त्वया प्रभो ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006316036, "chapter_id": 26316, "verse_number": "१-२६-३७", "content_sanskrit": "संवत्सरात् कुमारास्ते भविष्यन्ति न संशयः ।\nनिशामेकां च नृपते निवत्स्यसि मया सह ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006316037, "chapter_id": 26316, "verse_number": "१-२६-३८", "content_sanskrit": "हृष्टो जगाम राजाथ स्वपुरं तु महायशाः ।\nगते संवत्सरे भूय उर्वशी पुनरागमत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006316038, "chapter_id": 26316, "verse_number": "१-२६-३९", "content_sanskrit": "उषितश्च तया सार्द्धमेकरात्रं महायशाः ।\nउर्वश्यथाब्रवीदैलं गन्धर्वा वरदास्तव ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006316039, "chapter_id": 26316, "verse_number": "१-२६-४०", "content_sanskrit": "तान् वृणीष्व महाराज ब्रूहि चैनांस्त्वमेव हि ।\nवृणीष्व समतां राजन् गन्धर्वाणां महात्मनाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006316040, "chapter_id": 26316, "verse_number": "१-२६-४१", "content_sanskrit": "तथेत्युक्त्वा वरं वव्रे गन्धर्वाश्च तथास्त्विति ।\nपूरयित्वाग्निना स्थालीं गन्धर्वाश्च तमब्रुवन् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006316041, "chapter_id": 26316, "verse_number": "१-२६-४२", "content_sanskrit": "अनेनेष्ट्वा च लोकान्नः प्राप्स्यसि त्वं नराधिप ।\nतानादाय कुमारांस्तु नगरायोपचक्रमे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006316042, "chapter_id": 26316, "verse_number": "१-२६-४३", "content_sanskrit": "निक्षिप्याग्निमरण्ये तु सपुत्रस्तु गृहं ययौ ।\nस त्रेताग्निं तु नापश्यदश्वत्थं तत्र दृष्टवान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006316043, "chapter_id": 26316, "verse_number": "१-२६-४४", "content_sanskrit": "शमीजातं तु तं दृष्ट्वा अश्वत्थं विस्मितस्तदा ।\nगन्धर्वेभ्यस्तदाशंसदग्निनाशं ततस्तु सः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006316044, "chapter_id": 26316, "verse_number": "१-२६-४५", "content_sanskrit": "श्रुत्वा तमर्थमखिलमरणीं तु समादिशन् ।\nअश्वत्थादरणीं कृत्वा मथित्वाग्निं यथाविधि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006316045, "chapter_id": 26316, "verse_number": "१-२६-४६", "content_sanskrit": "मथित्वाग्निं त्रिधा कृत्वा अयजत्स नराधिपः ।\nइष्ट्वा यज्ञैर्बहुविधैर्गतस्तेषां सलोकताम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006316046, "chapter_id": 26316, "verse_number": "१-२६-४७", "content_sanskrit": "गन्धर्वेभ्यो वरं लब्ध्वा त्रेताग्निं समकारयत् ।\nएकोऽग्निः पूर्वमेवासीदैलस्त्रेतामकारयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006316047, "chapter_id": 26316, "verse_number": "१-२६-४८", "content_sanskrit": "एवंप्रभावो राजासीदैलस्तु नरसत्तम ।\nदेशे पुण्यतमे चैव महर्षिभिरभिष्टुते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006316048, "chapter_id": 26316, "verse_number": "१-२६-४९", "content_sanskrit": "राज्यं स कारयामास प्रयागे पृथिवीपतिः ।\nउत्तरे जाह्नवीतीरे प्रतिष्ठाने महायशाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]