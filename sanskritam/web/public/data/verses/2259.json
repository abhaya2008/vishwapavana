[{"id": 2058275, "chapter_id": 2259, "verse_number": "७-१८६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058276, "chapter_id": 2259, "verse_number": "७-१८६-१", "content_sanskrit": "ततो दुर्योधनो द्रोममभिगम्याब्रवीदिदम्।\nअमर्षवशमापन्नो जनयन्हर्षतेजसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058277, "chapter_id": 2259, "verse_number": "७-१८६-२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058278, "chapter_id": 2259, "verse_number": "७-१८६-२", "content_sanskrit": "न मर्षणीयाः सङ्ग्रामे विश्रमन्तः श्रमान्विताः।\nसपत्ना ग्लानमनसो लब्धलक्षा विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058279, "chapter_id": 2259, "verse_number": "७-१८६-३", "content_sanskrit": "यत्तु मर्षितमस्माभिर्भवतः प्रियकाम्यया।\nत एते परिविश्रान्ताः पाण्डवा बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058280, "chapter_id": 2259, "verse_number": "७-१८६-४", "content_sanskrit": "सर्वथा परिहीनाः स्म तेजसा च बलेन च।\nभवता पाल्यमानास्ते विवर्धन्ते पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058281, "chapter_id": 2259, "verse_number": "७-१८६-५", "content_sanskrit": "दिव्यान्यस्त्राणि सर्वाणि ब्राह्मादीनि च यानि ह।\nतानि सर्वामि तिष्ठन्ति भवत्येव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058282, "chapter_id": 2259, "verse_number": "७-१८६-६", "content_sanskrit": "न पाण्डवेया न वयं नान्ये लोके धनुर्धराः।\nयुध्यमानस्य ते तुल्याः सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058283, "chapter_id": 2259, "verse_number": "७-१८६-७", "content_sanskrit": "ससुरासुरगन्धर्वानिमाँलोकान्द्विजोत्तम।\nसर्वास्त्रविद्भवान्हन्याद्दिव्यैरस्त्रैर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058284, "chapter_id": 2259, "verse_number": "७-१८६-८", "content_sanskrit": "स भवान्मर्षयत्येनांस्तव तुल्यानवेत्य च।\nशिष्यत्वं वा पुरस्कृत्य मम वा मन्दभाग्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058285, "chapter_id": 2259, "verse_number": "७-१८६-९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058286, "chapter_id": 2259, "verse_number": "७-१८६-९", "content_sanskrit": "एवमुद्धर्षितो द्रोणः कोपितश्च सुतेन ते।\nसमन्युरब्रवीद्राजन्दुर्योधनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058287, "chapter_id": 2259, "verse_number": "७-१८६-१०", "content_sanskrit": "स्थविरः सन्परं शक्त्या घटे दुर्योधनाहवे।\nअतः परं मया कार्यं क्षुद्रं विजयगृद्धिना।\nअनस्त्रविदयं सर्वो हन्तव्योऽस्त्रविदा जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058288, "chapter_id": 2259, "verse_number": "७-१८६-११", "content_sanskrit": "यद्भवान्मन्यते चापि शुभं वा यदि वाऽशुभम्।\nतद्वै कर्ताऽस्मि कौरव्य वचनात्तव नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058289, "chapter_id": 2259, "verse_number": "७-१८६-१२", "content_sanskrit": "निहत्य सर्वपाञ्चालान्युद्धे कृत्वा पराक्रमम्।\nविमोक्ष्ये कवचं राजन्सत्येनायुधमालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058290, "chapter_id": 2259, "verse_number": "७-१८६-१३", "content_sanskrit": "मन्यसे यच्च कौन्तेयमर्जुनं श्रान्तमाहवे।\nतस्य वीर्यं महाबाहो शृणु सत्येन कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058291, "chapter_id": 2259, "verse_number": "७-१८६-१४", "content_sanskrit": "तं न देवा न गन्धर्वा न यक्षा न च राक्षसाः।\nउत्सहन्ते रणे जेतुं कुपितं सव्यसाचिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058292, "chapter_id": 2259, "verse_number": "७-१८६-१५", "content_sanskrit": "खाण्डवे येन भगवान्प्रत्युद्यातः सुरेश्वरः।\nसायकैर्वारितश्चापि वर्षमाणो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058293, "chapter_id": 2259, "verse_number": "७-१८६-१६", "content_sanskrit": "यक्षा नागास्तथा दैत्या ये चान्ये बलगर्विताः।\nनिहताः पुरुषेन्द्रेण तच्चापि विदितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058294, "chapter_id": 2259, "verse_number": "७-१८६-१७", "content_sanskrit": "गन्धर्वा घोषयात्रायां चित्रसेनादयो जिताः।\nयूयं तैर्ह्रियमाणाश्च मोक्षिता दृढधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058295, "chapter_id": 2259, "verse_number": "७-१८६-१८", "content_sanskrit": "निवातकवचाश्चापि देवानां शत्रवस्तथा।\nसुरैरवध्याः सङ्ग्रामे तेन वीरेण निर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058296, "chapter_id": 2259, "verse_number": "७-१८६-१९", "content_sanskrit": "दानवानां सहस्राणि हिरण्यपुरवासिनाम्।\nविजिग्ये पुरुषव्याघ्रः स शक्यो मानुषैः कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058297, "chapter_id": 2259, "verse_number": "७-१८६-२०", "content_sanskrit": "प्रत्यक्षं चैव ते सर्वं यथा बलमिदं तव।\nक्षपितं पाण्डुपुत्रेण चेष्टतां नो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058298, "chapter_id": 2259, "verse_number": "७-१८६-२१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058299, "chapter_id": 2259, "verse_number": "७-१८६-२१", "content_sanskrit": "तं तदाऽभिप्रशंसन्तमर्जुनं कुपितस्तदा।\nद्रोणं तव सुतो राजन्पुनरेवेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058300, "chapter_id": 2259, "verse_number": "७-१८६-२२", "content_sanskrit": "अहं दुःशासनः कर्णः शकुनिर्मातुलश्च मे।\nहनिष्यामोऽर्जुनं सङ्ख्ये द्विधा कृत्वाऽद्य भारतीम्।\n`तिष्ठ स त्वं महाबाहो नित्यं शिष्यः प्रियस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058301, "chapter_id": 2259, "verse_number": "७-१८६-२३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा भारद्वाजो हसन्निव।\nअन्ववर्तत राजानं स्वस्ति तेऽस्त्विति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058302, "chapter_id": 2259, "verse_number": "७-१८६-२४", "content_sanskrit": "को हि गाण्डीवधन्वानं ज्वलन्तमिव तेजसा।\nअक्षयं क्षपयेत्कश्चित्क्षत्रियः क्षत्रियर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058303, "chapter_id": 2259, "verse_number": "७-१८६-२५", "content_sanskrit": "तं न वित्तपतिर्नेन्द्रो न यमो न जलेश्वरः।\nनासुरोरगरक्षांसि क्षपयेयुः सहायुधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058304, "chapter_id": 2259, "verse_number": "७-१८६-२६", "content_sanskrit": "मूढास्त्वेतानि भाषन्ते यानीमान्यात्थ भारत।\nयुद्धे ह्यर्जुनमासाद्य स्वस्तिमान्को व्रजेद्गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058305, "chapter_id": 2259, "verse_number": "७-१८६-२७", "content_sanskrit": "त्वं तु सर्वाभिशङ्कित्वान्निष्ठुरः पापनिश्चयः।\nश्रेयसस्त्वद्धिते युक्तांस्तत्तद्वक्तुमिहेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058306, "chapter_id": 2259, "verse_number": "७-१८६-२८", "content_sanskrit": "गच्छ त्वमपि कौन्तेयमात्मार्थे जहि माचिरम्।\nत्वमप्याशंससे योद्धुं कुलजः क्षत्रियो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058307, "chapter_id": 2259, "verse_number": "७-१८६-२९", "content_sanskrit": "इमान्किं क्षत्रियान्सर्वान्घातयिष्यस्यनागसः।\nत्वस्य मूलं वैरस्य तस्मादासादयार्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058308, "chapter_id": 2259, "verse_number": "७-१८६-३०", "content_sanskrit": "एष ते मातुलः प्राज्ञः क्षत्रधर्ममनुव्रतः।\nदुर्द्युतदेवी गान्धारे प्रयात्वर्जुनमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058309, "chapter_id": 2259, "verse_number": "७-१८६-३१", "content_sanskrit": "एषोऽक्षकुशलो जिह्मो द्यूतकृत्कितवः शठः।\nदेविता निकृतिप्रज्ञो युधि जेष्यति पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058310, "chapter_id": 2259, "verse_number": "७-१८६-३२", "content_sanskrit": "त्वया कथितमत्यर्थं कर्णेन सह हृष्टवत्।\nअसकृच्छून्यवन्मोहाद्वृतराष्ट्रस्य शृण्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058311, "chapter_id": 2259, "verse_number": "७-१८६-३३", "content_sanskrit": "अहं च तात कर्णश्च भ्राता दुःशानश्च मे।\nपाण्डुपुत्रान्हनिष्यामः सहिताः समरे त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058312, "chapter_id": 2259, "verse_number": "७-१८६-३४", "content_sanskrit": "इति ते कत्थमानस्य श्रुतं संसदिसंसदि।\nअनुतिष्ठ प्रतिज्ञां तां सत्यवाग्भव तैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058313, "chapter_id": 2259, "verse_number": "७-१८६-३५", "content_sanskrit": "एष ते पाण्डवः शत्रुरविशङ्कोऽग्रतः स्थितः।\nक्षत्रधर्ममवेक्षस्व श्लाघ्यस्तव वधो जयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058314, "chapter_id": 2259, "verse_number": "७-१८६-३६", "content_sanskrit": "दत्तं भुक्तमधीतं च प्राप्तमैश्वर्यमीप्सितम्।\nकृतकृत्योऽनृणश्चासि मा भैर्युध्यस्व पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058315, "chapter_id": 2259, "verse_number": "७-१८६-३७", "content_sanskrit": "इत्युक्त्वा समरे द्रोणो न्यवर्तत यतः परे।\nद्वैधीकृत्य ततः सेनां युद्धं समभवत्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058316, "chapter_id": 2259, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणवधपर्वणि चतुर्दशरात्रियुद्धे षडशीत्यधिकशततमोऽध्यायः॥ १८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]