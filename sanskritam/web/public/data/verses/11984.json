[{"id": 50025143, "chapter_id": 11984, "verse_number": "1", "content_sanskrit": "॥ भास्करमतेऽपि जीवब्रह्मव्यवस्थाया बद्धमुक्तव्यवस्थायाश्चानुपपत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025144, "chapter_id": 11984, "verse_number": "2", "content_sanskrit": "यदिचैकमेव ब्रह्मोपाधिभेदात् संसरति मुच्यते च, तदा संसारिणां सर्वदा विद्यमानत्वात् सर्वदा संसार्येव ब्रह्म, अतस्तद्भावोऽपि न मुक्तिः। सर्वदोपाधिसम्बद्धत्वात् तस्य।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025145, "chapter_id": 11984, "verse_number": "3", "content_sanskrit": "॥ तन्मते शुद्धस्यैवोपाधिसम्बन्धोऽङ्गीकार्य इति प्रतिपादनद्वारोक्तार्थस्थिरीकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025146, "chapter_id": 11984, "verse_number": "4", "content_sanskrit": "नच शुद्धस्य नोपाधिसम्बन्ध इति वाच्यम्। उपाधिसम्बद्धस्योपाधिसम्बन्धकल्पनेऽनवस्थाप्रसङ्गात्। नच तेनैव सम्बन्धेन सम्बद्धस्य। आत्माश्रयप्रसङ्गात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]