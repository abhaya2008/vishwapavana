[{"id": 2028606, "chapter_id": 1622, "verse_number": "३-२६०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028607, "chapter_id": 1622, "verse_number": "३-२६०-१", "content_sanskrit": "वने निवसतां तेषां पाण्डवानां महात्मनाम्।\nवर्षाण्येकादशातीयुः कृच्छ्रेण भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028608, "chapter_id": 1622, "verse_number": "३-२६०-२", "content_sanskrit": "फलमूलाशनास्ते हि सुखार्हा दुःखमुत्तमम्।\nप्राप्तकालमनुध्यान्तः सेहिरे वरपूरुषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028609, "chapter_id": 1622, "verse_number": "३-२६०-३", "content_sanskrit": "युधिष्ठिरस्तु राजर्षिरात्मकर्मापराधजम्।\nचिन्तयन्स महाबाहुर्भ्रातॄणां दुःखमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028610, "chapter_id": 1622, "verse_number": "३-२६०-४", "content_sanskrit": "न सुष्वाप सुखं राजा हृदि शल्यैरिवार्पितैः।\nदौरात्म्यमनुपश्यंस्तत्काले द्यूतोद्भवस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028611, "chapter_id": 1622, "verse_number": "३-२६०-५", "content_sanskrit": "संस्मरन्परुषा वाचः सूतपुत्रस्य पाण्डवः।\nनिःश्वासपरमो दीनो दध्रे कोपविषं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028612, "chapter_id": 1622, "verse_number": "३-२६०-६", "content_sanskrit": "अर्जुनोयमजौ चोभौ द्रौपदी च यशस्विनी।\nस च भीमो महातेजाः सर्वेषामुत्तमो बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028613, "chapter_id": 1622, "verse_number": "३-२६०-७", "content_sanskrit": "`चिरस्य जातं धर्मज्ञं सासूयमिव ते तदा।\nयुधिष्ठिरमुदीक्षन्तः सेहुर्दुखमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028614, "chapter_id": 1622, "verse_number": "३-२६०-८", "content_sanskrit": "अवशिष्टं त्वल्पकालं मन्वानाः पुरुषर्षभाः।\nवपुरन्यदिवाकार्पुरुत्साहामर्षचेष्टितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028615, "chapter_id": 1622, "verse_number": "३-२६०-९", "content_sanskrit": "कस्यचित्त्वथ कालस्य व्यासः सत्यवतीसुतः।\nआजगाम महायोगी पाण्डवानवलोककः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028616, "chapter_id": 1622, "verse_number": "३-२६०-१०", "content_sanskrit": "तमागतमभिप्रेक्ष्यकुन्तीपुत्रो युधिष्ठिरः।\nप्रत्युद्गम्य महात्मानं प्रत्यगृह्णाद्यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028617, "chapter_id": 1622, "verse_number": "३-२६०-११", "content_sanskrit": "तमासीनमुपासीनः शुश्रूषुर्नियतेन्द्रियः।\nतोषयामास शौचेन व्यासं पाण्डवनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028618, "chapter_id": 1622, "verse_number": "३-२६०-१२", "content_sanskrit": "तानवेक्ष्यकृशान्पौत्रान्वने वन्येन जीवतः।\nमहर्षिरनुकम्पार्थमब्रवीद्बाष्पगद्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028619, "chapter_id": 1622, "verse_number": "३-२६०-१३", "content_sanskrit": "युधिष्ठिर महाबाहो शृणु धर्मभृतांवर।\nनातप्ततपसो लोके प्राप्नुवन्ति महत्सुखम्।\nसुखदुःखे हि पुरुषः पर्यायेणोपसेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028620, "chapter_id": 1622, "verse_number": "३-२६०-१४", "content_sanskrit": "नात्यन्तमसुखं कश्चित्प्राप्नोति पुरुषर्षभ।\nप्रज्ञावांस्त्वेव पुरुषः संयुक्तः परया धिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028621, "chapter_id": 1622, "verse_number": "३-२६०-१५", "content_sanskrit": "उदयास्तमयज्ञो हि न हृष्यति न शोचति।\nसुखमापतितं विन्दन्दुःखमापतितं सहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028622, "chapter_id": 1622, "verse_number": "३-२६०-१६", "content_sanskrit": "कालप्राप्तमुपासीत सस्यानामिव कर्षकः।\nतपसो हि परं नास्ति तपसा विन्दते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028623, "chapter_id": 1622, "verse_number": "३-२६०-१७", "content_sanskrit": "नासाध्यं तपसः किंचिदिति बुध्यस् भारत।\nसत्यमार्जवमक्रोधः संविभागो दमः शमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028624, "chapter_id": 1622, "verse_number": "३-२६०-१८", "content_sanskrit": "अनसूयाऽविहिंसा च शौचमिन्द्रियसंयमः।\nसाधनानि महाराज नराणां पुण्यकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028625, "chapter_id": 1622, "verse_number": "३-२६०-१९", "content_sanskrit": "अधर्मरुचयो मूढास्तिर्यग्गतिपरायणाः।\nकृच्छ्रां योनिमनुप्राप्ता न सुखं विन्दते अनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028626, "chapter_id": 1622, "verse_number": "३-२६०-२०", "content_sanskrit": "इह यत्क्रियते कर्म तत्परत्रोपभुज्यते।\n`मूलसिक्तस्य वृक्षस्य फलं शाखासु दृश्यते।\nतस्माच्छरीरं युञ्जीत तपसा नियमेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028627, "chapter_id": 1622, "verse_number": "३-२६०-२१", "content_sanskrit": "यथाशक्ति प्रयच्छेत संपूज्याभिप्रणम्य च।\nकाले प्राप्ते च हृष्टात्मा राजन्विगतमत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028628, "chapter_id": 1622, "verse_number": "३-२६०-२२", "content_sanskrit": "सत्यवादी लभेतायुरनायासमथार्जवम्।\nअक्रोधनोऽनसूयश्च निर्वृतिं लभते पराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028629, "chapter_id": 1622, "verse_number": "३-२६०-२३", "content_sanskrit": "दान्तः शमपरः शश्वत्परिक्लेशं न विन्दति।\nन च तप्यति दान्तात्मा दृष्ट्वा परगतां श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028630, "chapter_id": 1622, "verse_number": "३-२६०-२४", "content_sanskrit": "संविभक्ता च दाता च भोगवान्सुखवान्नरः।\nभवत्यहिंसकश्चैव परमारोग्यमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028631, "chapter_id": 1622, "verse_number": "३-२६०-२५", "content_sanskrit": "मान्यं मानयिता जन्म कुले महति विन्दति।\n`विन्दते सुखमत्यर्थमिह लोके परत्र च।\nव्यसनैर्न तुसंयोगं प्राप्नोति विजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028632, "chapter_id": 1622, "verse_number": "३-२६०-२६", "content_sanskrit": "शुभानुशयबुद्धिर्हि संयुक्तः कालधर्मणा।\nप्रादुर्भवति तद्योगात्कल्याणमतिरेव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028633, "chapter_id": 1622, "verse_number": "३-२६०-२७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028634, "chapter_id": 1622, "verse_number": "३-२६०-२७", "content_sanskrit": "भगवन्दानधर्माणआं तपसो वा महामुने।\nकिंस्विद्बहुगुणं प्रेत्य किं वा दुष्करमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028635, "chapter_id": 1622, "verse_number": "३-२६०-२८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028636, "chapter_id": 1622, "verse_number": "३-२६०-२८", "content_sanskrit": "दानान्न दुष्करं तात पृथिव्यामस्ति किंचन।\nअर्थे च महती तृष्णा स च दुःखेन लभ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028637, "chapter_id": 1622, "verse_number": "३-२६०-२९", "content_sanskrit": "`राजन्प्रत्यक्षमेवैतद्दृश्यते लोकसाक्षिकम्।\nपरित्यज्य प्रियान्प्राणान्प्रविशन्ति रणाजिरम्।\nतथैव प्रतिपद्यन्ते समुद्रमटवीं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028638, "chapter_id": 1622, "verse_number": "३-२६०-३०", "content_sanskrit": "कृषिगोरक्ष्यमित्येके प्रतिपद्यन्ति मानवाः।\nपुरुषाः प्रेष्यतामेके निर्गच्छन्ति धनार्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028639, "chapter_id": 1622, "verse_number": "३-२६०-३१", "content_sanskrit": "तस्माद्दुःखार्जितस्यैव परित्यागः सुदुष्करः।\nसुदुष्करतरं दानं तस्माद्दानं मतं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028640, "chapter_id": 1622, "verse_number": "३-२६०-३२", "content_sanskrit": "विसेषस्त्वत्र विज्ञेयो न्यायेनोपार्जितं धनम्।\nपात्रे काले च देशे च प्रयतः प्रतिपादयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028641, "chapter_id": 1622, "verse_number": "३-२६०-३३", "content_sanskrit": "अन्यायात्समुपात्तेन दानधर्मौ धनन यः।\nकुरुते न स कर्तारं त्रायते महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028642, "chapter_id": 1622, "verse_number": "३-२६०-३४", "content_sanskrit": "पात्रे दानं स्वल्पमपि काले दत्तं युधिष्ठिर।\nमनसा हि विशुद्धेन प्रेत्यानन्तफलं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028643, "chapter_id": 1622, "verse_number": "३-२६०-३५", "content_sanskrit": "`श्रद्धा धर्मानुगा देवी पावनी विश्वधारिणी।\nसवित्री प्रसवित्री च संसारार्णवतारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2028644, "chapter_id": 1622, "verse_number": "३-२६०-३६", "content_sanskrit": "श्रद्धया धार्यते धर्मो महद्भिर्नार्थदर्शिभिः।\nसधना अपिराजानो निःश्रद्धा नरकं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2028645, "chapter_id": 1622, "verse_number": "३-२६०-३७", "content_sanskrit": "निष्किंचनाश्च मुनयः श्रद्धावन्तो दिवं गताः।\nदेशे काले च पात्रे च मुद्गलः श्रद्धयाऽन्वितः।\nव्रीहिद्रोणं प्रदायाथ परं पदमवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2028646, "chapter_id": 1622, "verse_number": "३-२६०-३८", "content_sanskrit": "अत्राप्युदाहरन्तीमतिहासं पुरातनम्।\nव्रीहिद्रोणपरित्यागाद्यत्फलं प्राप मुद्गलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2028647, "chapter_id": 1622, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि व्रीहिद्रौणिकपर्वणि षष्ट्यधिकद्विशततमोऽध्यायः ॥ २६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]