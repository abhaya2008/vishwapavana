[{"id": 2115783, "chapter_id": 3491, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115784, "chapter_id": 3491, "verse_number": "१", "content_sanskrit": "दृष्ट्वा शोचन्तमत्यर्थं पाञ्चालमिदमब्रवीत् ।\nपुरोधाः सत्वसम्पन्नः सम्यग्विद्याविशेषवान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115785, "chapter_id": 3491, "verse_number": "२", "content_sanskrit": "वृद्धानुशासने सक्ताः पाण्डवा धर्मचारिणः ।\nतादृशा न विनश्यन्ति नैव यान्ति पराभवम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115786, "chapter_id": 3491, "verse_number": "३", "content_sanskrit": "मया दृष्टमिदं सत्यं शृणुष्व मनुजाधिप ।\nब्राह्मणैः कथितं सत्यं वेदेषु च मया श्रुतम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115787, "chapter_id": 3491, "verse_number": "४", "content_sanskrit": "बृहस्पतिमतेनाथ पौलोम्या च पुरा श्रुतम् ।\nनष्टमिन्द्रो बिसग्रन्थ्यामुपश्रुत्या ह दर्शितः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115788, "chapter_id": 3491, "verse_number": "५", "content_sanskrit": "उपश्रुतिर्महाराज पाण्डवार्थे मया श्रुता ।\nयत्र वा तत्र जीवन्ति पाण्डवास्ते न संशयः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115789, "chapter_id": 3491, "verse_number": "६", "content_sanskrit": "मया दृष्टानि लिङ्गानि ध्रुवमेष्यन्ति पाण्डवाः ।\nयन्निमित्तमिहायान्ति तच्छृणुष्व नराधिप\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115790, "chapter_id": 3491, "verse_number": "७", "content_sanskrit": "स्वयंवरः क्षत्रियाणां कन्यादाने प्रतिश्रुतः ।\nस्वयंवरस्तु नगरे घुष्यतां राजसत्तम \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115791, "chapter_id": 3491, "verse_number": "८", "content_sanskrit": "यत्र वा निवसन्तस्ते पाण्डवाः पृथया सह ।\nदूरस्था वा समीपस्थाः स्वर्गस्था वाऽपि पाण्डवाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115792, "chapter_id": 3491, "verse_number": "९", "content_sanskrit": "श्रुत्वा स्वयंवरे राजन् समेष्यन्ति न संशयः ।\nतस्मात् स्वयंवरो राजन् घुष्यतां माचिरं कृथाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115793, "chapter_id": 3491, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115794, "chapter_id": 3491, "verse_number": "१०", "content_sanskrit": "श्रुत्वा पुरोहितेनोक्तं पाञ्चालः प्रीतिमांस्तदा ।\nघोषयामास नगरे द्रौपद्यास्तु स्वयंवरम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115795, "chapter_id": 3491, "verse_number": "११", "content_sanskrit": "पुष्यमासे तु रोहिण्यां शुक्लपक्षे शुभे तिथौ ।\nदिवसैः पञ्चसप्तत्या भविष्यति स्वयंवरः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115796, "chapter_id": 3491, "verse_number": "१२", "content_sanskrit": "देवगन्धर्वयक्षाश्च ऋषयश्च तपोधनाः ।\nस्वयंवरं द्रष्टुकामा गच्छन्त्येव न संशयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115797, "chapter_id": 3491, "verse_number": "१३", "content_sanskrit": "तव पुत्रा महात्मानो दर्शनीया विशेषतः ।\nयदृच्छया तु पाञ्चाली गच्छेद् वाऽन्यतमं पतिम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115798, "chapter_id": 3491, "verse_number": "१४", "content_sanskrit": "को हि जानाति लोकेषु प्रजापतिविधिं परम् ।\nतस्मात् सपुत्रा गच्छेथा यदि ब्राह्मणि रोचते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115799, "chapter_id": 3491, "verse_number": "१५", "content_sanskrit": "नित्यकालं सुभिक्षास्ते पाञ्चालास्तु तपोधने ।\nयज्ञसेनस्तु राजाऽसौ ब्रह्मण्यः सत्यसङ्गरः \t॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115800, "chapter_id": 3491, "verse_number": "१६", "content_sanskrit": "ब्रह्मण्या नागराश्चाथ ब्राह्मणाश्चातिथिप्रियाः ।\nनित्यकालं प्रदास्यन्ति आमन्त्रणमयाचितम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115801, "chapter_id": 3491, "verse_number": "१७", "content_sanskrit": "अहं च तत्र गच्छामि ममैभिः सह शिष्यकैः ।\nएकसार्था प्रयाताः स्म ब्राह्मणि यदि रोचते \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115802, "chapter_id": 3491, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115803, "chapter_id": 3491, "verse_number": "१८", "content_sanskrit": "एतावदुक्त्वा वचनं ब्राह्मणो विरराम ह \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115804, "chapter_id": 3491, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तत्यधिकशततमोऽध्यायः ॥१७०॥ ॥ इति चैत्ररथपर्वणि तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]