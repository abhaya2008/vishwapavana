[{"id": 33000138, "chapter_id": 7893, "verse_number": "1", "content_sanskrit": "प्रक्रम्यते प्रारभते प्रस्तौत्युद्धायत्यपि । प्रस्तुते चोपक्रमते दशोपक्रम्यतेऽप्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000139, "chapter_id": 7893, "verse_number": "2", "content_sanskrit": "अभ्यादत्ते प्रक्रमते उपजानात्युपक्रमे । कृतौ करोत्यावहति विदधात्यादधाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000140, "chapter_id": 7893, "verse_number": "3", "content_sanskrit": "वितनोत्यात्मने पञ्च सुजत्युत्पादयत्यपि । निर्मिमीते भावयति निर्माति रचयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000141, "chapter_id": 7893, "verse_number": "4", "content_sanskrit": "निष्पादयति निर्वर्तयति साधयतीति च। अनुतिष्ठत्याचरति श्रद्धायुक्तेऽनुसृज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000142, "chapter_id": 7893, "verse_number": "5", "content_sanskrit": "उत्तिष्ठते तु घटते चेष्टते त्रन्दतीहते । व्यायच्छते व्याप्रियते चेष्टनेऽष्टौ प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000143, "chapter_id": 7893, "verse_number": "6", "content_sanskrit": "विडुत्सर्गे तु गुवति हदतेऽथाऽवमेहति । मूत्रणे मूत्रयति च प्रस्त्रवत्यपि च त्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000144, "chapter_id": 7893, "verse_number": "7", "content_sanskrit": "उद्वर्तयति चोत्सादयत्युत्सीदति तत्समम्‌ । वस्ते प्रोर्णौति संवस्रयति प्रोर्णोति चेलति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000145, "chapter_id": 7893, "verse_number": "8", "content_sanskrit": "परिधत्ते परिदधात्याच्छादे प्रोर्णुतेऽष्टकम् । अनुलिम्पति चर्चायां दिग्धे देग्ध्यनुलिम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000146, "chapter_id": 7893, "verse_number": "9", "content_sanskrit": "चर्चत्येवं चर्चयति षडथो भूषणाऽर्थकाः । मण्डति मण्डयति च भूषयत्यपि भूषति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000147, "chapter_id": 7893, "verse_number": "10", "content_sanskrit": "परिष्करोत्यात्मनेऽलङकरोति द्वे च मङ्कते । प्रसाधयत्यथोत्तंसत्यवतंसेऽवतंसति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000148, "chapter_id": 7893, "verse_number": "11", "content_sanskrit": "प्रतिमुञ्चत्यपिनह्यत्यामुञ्चति पिनह्यति। भूषाद्यामोचने चत्वार्यूहनीयानि चात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000149, "chapter_id": 7893, "verse_number": "12", "content_sanskrit": "चकास्ति भासते भाति द्योतते रोचतेऽसति । राजति त्वेषति घृणोत्यात्मनेऽपि चतुष्टयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000150, "chapter_id": 7893, "verse_number": "13", "content_sanskrit": "भ्राजते शुम्भति शूभत्येजते शोभतीति च। प्रकाशते भ्राशते च भ्लाशते श्यन्यपि द्वयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000151, "chapter_id": 7893, "verse_number": "14", "content_sanskrit": "भ्रेजते दीव्यति हटत्यमी ज्वलति जोतते । वर्चते दीप्यते दीप्तौ कनत्युल्लसतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000152, "chapter_id": 7893, "verse_number": "15", "content_sanskrit": "केचिज्जिघर्ति दीधीते बभस्ति च्छान्दसान्‌ विदुः । कञ्चते योतते मन्दतेऽमी द्वात्रिंशद्‌ ईरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000153, "chapter_id": 7893, "verse_number": "16", "content_sanskrit": "नटत्यमी नाटयति नृत्ते नृत्यत्यथो हसे । जक्षिति कक्खति तकति प्रहसति कखति घघति स्मयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000154, "chapter_id": 7893, "verse_number": "17", "content_sanskrit": "क्रीडति दीव्यति खेलति केलति विहरति च कूर्दते लसति। रमतेऽमी विहरते कुमारयति खूर्दते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000155, "chapter_id": 7893, "verse_number": "18", "content_sanskrit": "केलायति ललत्येलायति खेलायतीति च । आङोऽनुसम्‌परिभ्यश्च क्रीडते क्रीडनार्थकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000156, "chapter_id": 7893, "verse_number": "19", "content_sanskrit": "हिलति स्याद् भावकृतौ त्रयं चुड्डति चुल्लति । विडम्बयत्यनुकरोत्यात्मनेऽनुहरत्यदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000157, "chapter_id": 7893, "verse_number": "20", "content_sanskrit": "अनुकारे रिङ्गगणे तु रिङ्गति स्खलति द्वयम्‌ । भण्डते स्फुण्डयति च केलौ परिहसत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000158, "chapter_id": 7893, "verse_number": "21", "content_sanskrit": "कुत्सिते स्मयने प्रोक्तं तङ्‌ वा कुस्मयते पदम्‌ । तर्षे तृष्यत्यमि धित्सत्युदन्यति पिपासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000159, "chapter_id": 7893, "verse_number": "22", "content_sanskrit": "पिबत्याचामति धयत्यपि चूषति पीयते । पानेऽथ क्षुध्यति क्षुध्यशनायति जिघत्सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000160, "chapter_id": 7893, "verse_number": "23", "content_sanskrit": "जेमत्यश्राति जमति भक्षयत्यत्ति खादति । चरति प्साति झमति भुङ्क्ते चमति चर्वति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000161, "chapter_id": 7893, "verse_number": "24", "content_sanskrit": "वल्भते घसति क्वाऽपि च्छमति प्रत्यवस्यति । चषत्यप्यभ्यवहरत्येते तर्णोति भक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000162, "chapter_id": 7893, "verse_number": "25", "content_sanskrit": "तृणोति चाऽऽत्मने पञचऽप्युपभरङ्क्ते च जक्षिति । वेति भुक्तौ विष्वणति चाऽवष्वणति सध्वनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000163, "chapter_id": 7893, "verse_number": "26", "content_sanskrit": "ग्रसते ग्लसते गीर्णौ गिरत्येते गिलत्यपि । गर्हितायां निजागर्ति निजेगिल्यत इत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000164, "chapter_id": 7893, "verse_number": "27", "content_sanskrit": "दन्दश्यते दन्दशीति दन्दष्ट्यपि च खर्दति । गर्ह्यो दंशेऽथ दशति शद्धे दंशयति द्वयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000165, "chapter_id": 7893, "verse_number": "28", "content_sanskrit": "वान्तौ वमत्युद्गिरति स्नुह्यत्युद्गिलतीत्यमी। निष्ठीव्यति ष्ठीव्यति च निष्ठीवति च थूत्कृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000166, "chapter_id": 7893, "verse_number": "29", "content_sanskrit": "शेषे परिशिनष्टीति शेषयत्यपि शेषति । तृप्यत्येते मादयते तृप्तौ ध्रायति तुम्फति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000167, "chapter_id": 7893, "verse_number": "30", "content_sanskrit": "तृप्नोत्येके च्छन्दसीदं तुपत्येवं चकत्यपि । विश्राम्यतीति विश्रान्तौ क्वचिद्‌ विश्रमते मतम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000168, "chapter_id": 7893, "verse_number": "31", "content_sanskrit": "स्युरास्ते तूपविशति निषीदत्युपवेशने । ऊर्ध्वीभवति तूत्तिष्ठत्यूर्ध्वत्वे तिष्ठतीत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000169, "chapter_id": 7893, "verse_number": "32", "content_sanskrit": "आदाने कोकते लाति गर्हते ग्लहते क्वचित्‌ । वर्कते धिण्णते गृह्णात्येवं झषति चीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000170, "chapter_id": 7893, "verse_number": "33", "content_sanskrit": "स्वीकरोतीति चत्वारि चाऽत्मने स्युः प्रतीच्छति । घुण्णतेऽमी गृहयते घृण्णते स्युश्चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000171, "chapter_id": 7893, "verse_number": "34", "content_sanskrit": "रहति त्यजति त्यागे जहात्युज्झति बुस्यति ।विसृजत्युत्सृजति च मुञ्चते मुञ्चतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 33000172, "chapter_id": 7893, "verse_number": "35", "content_sanskrit": "विष्यत्यवस्यति रहयति मोक्षयतीत्यपि । मोचयत्यूनयति चोत्सृज्यते हापयत्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 33000173, "chapter_id": 7893, "verse_number": "36", "content_sanskrit": "वृणक्ति वर्जयति च वृङ्क्ते युङ्गति जुङ्गति  । वर्जने राखति प्रत्याचष्टे वर्जति वुङ्गति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 33000174, "chapter_id": 7893, "verse_number": "37", "content_sanskrit": "व्यासेधति निषेधत्यात्मने  परिहरत्यपि । अथ व्रीणाति वरति वृणाति च वृणोति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 33000175, "chapter_id": 7893, "verse_number": "38", "content_sanskrit": "त्रीण्यात्मनेऽपि वरणे वारयत्यपि वृक्षते । वावृत्यते कीटयति व्रीयते चाऽपि वृश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 33000176, "chapter_id": 7893, "verse_number": "39", "content_sanskrit": "करोति हस्तेपाणिभ्यां कुरुते चोपयच्छते । विवहत्युद्वहति चोद्वाहे परिणयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 33000177, "chapter_id": 7893, "verse_number": "40", "content_sanskrit": "चत्वारि चाऽऽत्मने ज्येष्ठेऽनूढेऽत्र परिविन्दति । परिष्वजत आश्लिष्यत्यालिङ्गत्युपगूहति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 33000178, "chapter_id": 7893, "verse_number": "41", "content_sanskrit": "क्रोडीकरोत्यात्मने द्वावङ्कपालयतीति च । आलिङ्गने सप्त परिरभतेऽप्यथ कामने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 33000179, "chapter_id": 7893, "verse_number": "42", "content_sanskrit": "रिरंसते कामयते यियप्सति वृषस्यति । अन्यस्त्री चेद्‌ अथाऽश्वा चेद्‌ अश्वस्यत्यथ चुम्बने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 33000180, "chapter_id": 7893, "verse_number": "43", "content_sanskrit": "निक्षति चुम्बति निंस्ते व्यवैति मिथुनीभवत्यपि च । यभति च भजतीत्येते निधुवति संविशति मैथुनेऽमी स्युः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 33000181, "chapter_id": 7893, "verse_number": "44", "content_sanskrit": "उपभुङ्क्ते तूपभोगे सम्भुङ्क्ते निर्विशत्यपि ।शूलत्यामयतीत्येते रुजत्यपि रुजि त्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 33000182, "chapter_id": 7893, "verse_number": "45", "content_sanskrit": "प्रसूयते प्रसूते च गर्भमोक्षे विजायते । प्रजायते जनयति जजन्ति च्छान्दसं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 33000183, "chapter_id": 7893, "verse_number": "46", "content_sanskrit": "उल्लाघयति भैषज्ये भिषज्यति चिकित्सति । उपक्रमत इत्येतच्छाम्यत्युपरमत्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}]