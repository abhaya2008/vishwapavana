[{"id": 2047606, "chapter_id": 2053, "verse_number": "६-१०२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047607, "chapter_id": 2053, "verse_number": "६-१०२-१", "content_sanskrit": "कथं द्रोणो महेष्वासः पाण्डवश्च धनञ्जयः ।\nसमीयतू रणे यत्तौ तावुभौ पुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047608, "chapter_id": 2053, "verse_number": "६-१०२-२", "content_sanskrit": "प्रियो हि पाण्डवो नित्यं भारद्वाजस्य धीमतः ।\nआचार्यश्च रणे नित्यं प्रियः पार्थस्य सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047609, "chapter_id": 2053, "verse_number": "६-१०२-३", "content_sanskrit": "तावुभौ रथिनो सङ्ख्ये हृष्टौ सिंहाविवोत्कटौ ।\nकथं समीयतुर्यत्तौ भारद्वाजधनञ्जयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047610, "chapter_id": 2053, "verse_number": "६-१०२-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047611, "chapter_id": 2053, "verse_number": "६-१०२-४", "content_sanskrit": "न द्रोणः समरे पार्थं जानीते प्रियमात्मनः ।\nक्षत्रधर्मं पुरस्कृत्य पार्थो वा गुरुमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047612, "chapter_id": 2053, "verse_number": "६-१०२-५", "content_sanskrit": "न क्षत्रिया रणे राजन्वर्जयन्ति परस्परम् ।\nनिर्मर्यादं हि युध्यन्ते पितृभिर्भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047613, "chapter_id": 2053, "verse_number": "६-१०२-६", "content_sanskrit": "रणे भारत पार्थेन द्रोणो विद्धस्त्रिभिः शरैः ।\nनाचिन्तयच्च तान्बाणान्पार्थचापच्युतान्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047614, "chapter_id": 2053, "verse_number": "६-१०२-७", "content_sanskrit": "शरवृष्ट्या पुनः पार्थश्छादयामास तं रणे ।\nस प्रजज्वाल रोषेण गहनेऽग्निरिवोर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047615, "chapter_id": 2053, "verse_number": "६-१०२-८", "content_sanskrit": "ततोऽर्जुनं रणे द्रोणः शरैः सन्नतपर्वभिः ।\nछादयामास राजेन्द्र नचिरादेव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047616, "chapter_id": 2053, "verse_number": "६-१०२-९", "content_sanskrit": "ततो दुर्योधनो राजा सुशर्माणमचोदयत् ।\nद्रोणस्य समरे राजन्पार्ष्णिग्रहणकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047617, "chapter_id": 2053, "verse_number": "६-१०२-१०", "content_sanskrit": "त्रिगर्तराडपि क्रुद्धो भृशमायम्य कार्मुकम् ।\nछादयामास समरे पार्थं बाणैरयोमुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047618, "chapter_id": 2053, "verse_number": "६-१०२-११", "content_sanskrit": "ताभ्यां मुक्ताः शरा राजन्नन्तरिक्षे विरेजिरे ।\nहंसा इव महाराज शरत्काले नभस्तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047619, "chapter_id": 2053, "verse_number": "६-१०२-१२", "content_sanskrit": "ते शराः प्राप्य कौन्तेयं समन्ताद्विविशुः प्रभो ।\nफलभारनतं यद्वत्स्वादुवृक्षं विहंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047620, "chapter_id": 2053, "verse_number": "६-१०२-१३", "content_sanskrit": "अर्जुनस्तु रणे नादं विनद्य रथिनां वरः।\nत्रिगर्तराजं समरे सपुत्रं विव्यधे शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047621, "chapter_id": 2053, "verse_number": "६-१०२-१४", "content_sanskrit": "ते वध्यमानाः पार्थेन कालेनेव युगक्षये ।\nपार्थमेवाभ्यवर्तन्त मरणे कृतनिश्चयाः ।\nमुमुचुः शरवृष्टिं च पाण्डवस्य रथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047622, "chapter_id": 2053, "verse_number": "६-१०२-१५", "content_sanskrit": "शरवृष्टिं ततस्तां तु शरवर्षैः समन्ततः ।\nप्रतिजग्राह राजेन्द्र तोयवृष्टिमिवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047623, "chapter_id": 2053, "verse_number": "६-१०२-१६", "content_sanskrit": "तत्राद्भुतमपश्याम बीभत्सोर्हस्तलाघवम् ।\nविमुक्तां बहुभिर्योधैः शस्त्रवृष्टिं दुरासदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047624, "chapter_id": 2053, "verse_number": "६-१०२-१७", "content_sanskrit": "यदेको वारयामास मारुतोऽभ्रगणानिव ।\nकर्मणा तेन पार्थस्य तुतुषुर्देवदानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047625, "chapter_id": 2053, "verse_number": "६-१०२-१८", "content_sanskrit": "अथ क्रुद्धो रणे पार्थस्त्रिगर्तान्प्रति भारत।\nमुमोचास्त्रं महाराज वायव्यं पृतनामुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047626, "chapter_id": 2053, "verse_number": "६-१०२-१९", "content_sanskrit": "प्रादुरासीत्ततो वायुः क्षोभयाणो नभस्तलम् ।\nपातयन्वै तरुगणान्विनिघ्नंश्चैव सैनिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047627, "chapter_id": 2053, "verse_number": "६-१०२-२०", "content_sanskrit": "ततो द्रोणोऽभिवीक्ष्यैव वायव्यास्त्रं सुदारुणम्।\nशैलमन्यन्महाराज घोरमस्त्रं मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047628, "chapter_id": 2053, "verse_number": "६-१०२-२१", "content_sanskrit": "द्रोणेन युधि निर्मुक्ते तस्मिन्नस्त्रे नराधिप।\nप्रशशाम ततो वयुः प्रसन्नाश्च दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047629, "chapter_id": 2053, "verse_number": "६-१०२-२२", "content_sanskrit": "ततः पाण्डुसुतो वीरस्त्रिगर्तस्य रथव्रजान् ।\nनिरुत्साहान्रणे चक्रे विमुखान्विपराक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047630, "chapter_id": 2053, "verse_number": "६-१०२-२३", "content_sanskrit": "ततो दुर्योधनश्चैव कृपश्च रथिनां वरः।\nअश्वत्थामा तथा शल्यः काम्भोजश्च सुदक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047631, "chapter_id": 2053, "verse_number": "६-१०२-२४", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ बाह्लिकः सह बाह्लिकैः ।\nमहता रथवंशेन पार्थस्यावारयन्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047632, "chapter_id": 2053, "verse_number": "६-१०२-२५", "content_sanskrit": "तथैव भगदत्तश्च श्रतायुश्च महाबलः।\nगजानीकेन भीमस्य ताववारयतां दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047633, "chapter_id": 2053, "verse_number": "६-१०२-२६", "content_sanskrit": "भूरिश्रवाः शलश्चैव सौबलश्च विशांपते ।\nशरौघैर्विमलैस्तीक्ष्णैर्माद्रीपुत्राववारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047634, "chapter_id": 2053, "verse_number": "६-१०२-२७", "content_sanskrit": "भीष्मस्तु संहतः सङ्ख्ये धार्तराष्ट्रैः ससैनिकैः ।\nयुधिष्ठिरं समासाद्य सर्वतः पर्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047635, "chapter_id": 2053, "verse_number": "६-१०२-२८", "content_sanskrit": "आपतन्तं गजानीकं दृष्ट्वा पार्थो वृकोदरः।\nलोलिहन्सृक्किणी वीरो मृगराडिव कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047636, "chapter_id": 2053, "verse_number": "६-१०२-२९", "content_sanskrit": "भीमस्तु रथिनां श्रेष्ठो गदां गृह्य महाहवे ।\nअवप्लुत्य रथात्तूर्णं तव सैन्यान्यभीषयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047637, "chapter_id": 2053, "verse_number": "६-१०२-३०", "content_sanskrit": "तमुद्वीक्ष्य गदाहस्तं ततस्ते गजसादिनः ।\nपरिवव्रू रणे यत्ता भीमसेनं समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047638, "chapter_id": 2053, "verse_number": "६-१०२-३१", "content_sanskrit": "गजमध्यमनुप्राप्तः पाण्डवः स व्यराजत।\nमेघजालस्य महतो यथा मध्यगतो रविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047639, "chapter_id": 2053, "verse_number": "६-१०२-३२", "content_sanskrit": "व्यधमत्स गजानीकं गदया पाण्डवर्षभः ।\nमहाभ्रजालमतुलं मातरिश्वेव सन्ततम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047640, "chapter_id": 2053, "verse_number": "६-१०२-३३", "content_sanskrit": "ते वध्यमाना बलिना भीमसेनेन दन्तिनः ।\nआर्तनादं रणे चक्रुर्गर्जन्तो जलदा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047641, "chapter_id": 2053, "verse_number": "६-१०२-३४", "content_sanskrit": "बहुधा दारितश्चैव विषाणैस्तत्र दन्तिभिः ।\nफुल्लाशोकनिभः पार्थः शुशुभे रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047642, "chapter_id": 2053, "verse_number": "६-१०२-३५", "content_sanskrit": "`सादिनां शस्त्रवृष्टिं च व्यधमद्गदया ततः।\nवायुवेगसमायुक्तो व्यचरत्पाण्डवो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047643, "chapter_id": 2053, "verse_number": "६-१०२-३६", "content_sanskrit": "विषाणोल्लिखितैर्गात्रौर्विषाणाभिहतो भृशम्।\nविषाणे दन्तिनं गृह्य निर्विषाणमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047644, "chapter_id": 2053, "verse_number": "६-१०२-३७", "content_sanskrit": "विषाणेन च तेनैव कुम्भोऽभ्याहत्य दन्तिनम् ।\nपातयामास समरे दण्डहस्त इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047645, "chapter_id": 2053, "verse_number": "६-१०२-३८", "content_sanskrit": "शोणिताक्तां गदां बिभ्रन्मेदोभञ्जाकृतच्छविः ।\nकृताभ्यङ्गः शोणितेन रुद्रवत्प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047646, "chapter_id": 2053, "verse_number": "६-१०२-३९", "content_sanskrit": "एवं के वध्यमानाश्च हतशेषा महागजाः ।\nप्राद्रवन्त दिशो राजन्विमृद्गन्तः स्वकं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047647, "chapter_id": 2053, "verse_number": "६-१०२-४०", "content_sanskrit": "द्रवद्भिस्तैर्महानागैः समन्ताद्भरतर्षभ।\nदुर्योधनबलं सर्वं पुनरासीत्पराङ्भुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047648, "chapter_id": 2053, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि नवमदिवसयुद्धे द्व्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]