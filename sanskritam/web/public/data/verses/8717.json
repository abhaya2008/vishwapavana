[{"id": 900008957, "chapter_id": 8717, "verse_number": "7.1", "content_sanskrit": "यच्चोच्यते समवायसम्बन्धेन पूर्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008958, "chapter_id": 8717, "verse_number": "7.2", "content_sanskrit": "तथापि ‘‘एतज्जन्मनि प्राथमिकं गौरितिप्रत्यक्षं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008959, "chapter_id": 8717, "verse_number": "7.3", "content_sanskrit": "तस्मादर्थान्निर्विकल्पकसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008960, "chapter_id": 8717, "verse_number": "7.4", "content_sanskrit": "अस्तु वा साध्यप्रसिद्ध्यादिरनुमित्यादिहेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008961, "chapter_id": 8717, "verse_number": "7.5", "content_sanskrit": "अपि चैवंप्रत्यक्षविशिष्टज्ञानंप्रति विशेष्यज्ञानस्यापि हेतुता स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008962, "chapter_id": 8717, "verse_number": "7.6", "content_sanskrit": "अपि च त्वयापि घटाभाववद्भूतलामिति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008963, "chapter_id": 8717, "verse_number": "7.7", "content_sanskrit": "यदि ह्यननुमित्यनुमितिरूपज्ञानद्वयवन्निर्विकल्पक..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008964, "chapter_id": 8717, "verse_number": "7.8", "content_sanskrit": "ननु विशेषणज्ञानस्याजनकत्वे कथं विशेषणस्यैवप्रकारत्वमिति नियमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008965, "chapter_id": 8717, "verse_number": "7.9", "content_sanskrit": "किञ्च विशेष्यस्यापि सम्बन्धित्वेन तज्ज्ञानस्यापि हेतुता स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008966, "chapter_id": 8717, "verse_number": "7.10", "content_sanskrit": "अस्तु वा स्मृतिसाधारणं जन्यज्ञानत्वमेव कार्यतावच्छेदकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008967, "chapter_id": 8717, "verse_number": "7.11", "content_sanskrit": "किञ्चातीन्द्रियज्ञानोपगमे योग्यानुलब्धेरभावेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008968, "chapter_id": 8717, "verse_number": "7.12", "content_sanskrit": "न च सविकल्पकाभाव एव निर्विकल्पकाभावे लिङ्गम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008969, "chapter_id": 8717, "verse_number": "7.13", "content_sanskrit": "किञ्च दण्डपुरुषसन्निकर्षे तदुभयस्वरूपमात्रविषयकनिर्विकल्पकवत्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008970, "chapter_id": 8717, "verse_number": "7.14", "content_sanskrit": "अपि चैवं निर्विकल्पकज्ञानंप्रत्यक्षविशेषवत् अनुमितिविशेषोऽपि स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]