[{"id": 2118751, "chapter_id": 3552, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118752, "chapter_id": 3552, "verse_number": "१", "content_sanskrit": "तौ रथाभ्यां सुयुक्ताभ्यां दावस्योभयतः स्थितौ ।\nदिक्षु सर्वासु भूतानां चक्राते कदनं तदा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118753, "chapter_id": 3552, "verse_number": "२", "content_sanskrit": "यत्रयत्र हि दृश्यन्ते प्राणिनः खाण्डवालयाः ।\nपलायन्तस्तत्रतत्र तौ वीरौ पर्यधावताम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118754, "chapter_id": 3552, "verse_number": "३", "content_sanskrit": "छिद्रं न स्म प्रपश्यन्ति रथयोराशुविक्रमाः ।\nआविद्धाविव दृश्येते रथिनौ तौ रथोत्तमे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118755, "chapter_id": 3552, "verse_number": "४", "content_sanskrit": "खाण्डवे दह्यमाने तु भूतान्यथ सहस्रशः ।\nउत्पेतुर्भैरवान् नादान् विनदन्तो दिशो दश \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118756, "chapter_id": 3552, "verse_number": "५", "content_sanskrit": "दग्धैकदेशा बहवो निष्टप्ताश्च विचेतसः ।\nस्फुटिताक्षा विशीर्णाश्च विप्लुताक्षा विचेतसः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118757, "chapter_id": 3552, "verse_number": "६", "content_sanskrit": "समालिङ्ग्य सुतानन्ये पितॄन् भ्रातॄंस्तथाऽपरे ।\nत्यक्तुं न शेकुः स्नेहेन तत्रैव निधनं गताः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118758, "chapter_id": 3552, "verse_number": "७", "content_sanskrit": "विकृतैर्दशनैरन्ये खमुत्पेतुः सहस्रशः ।\nतत्रतत्र विधून्वन्तः पुनरग्नौ प्रपेदिरे \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118759, "chapter_id": 3552, "verse_number": "८", "content_sanskrit": "दग्धपक्षाक्षिचरणा विवेष्टन्तो महीतळे ।\nतत्रतत्र प्रदृश्यन्ते विनश्यन्तः शरीरिणः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118760, "chapter_id": 3552, "verse_number": "९", "content_sanskrit": "जलस्थानेषु तप्तेषु क्काथ्यमानेषु वह्निना ।\nगतसत्वाः स्म दृश्यन्ते कूर्ममत्स्याः सहस्रशः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118761, "chapter_id": 3552, "verse_number": "१०", "content_sanskrit": "शरीरैः सम्प्रदीप्तैश्च देहवन्त इवाग्नयः ।\nअदृश्यन्त वने तत्र प्राणिनः प्राणिसङ्क्षये \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118762, "chapter_id": 3552, "verse_number": "११", "content_sanskrit": "तांस्तथोत्पततः पार्थः शरैः सञ्छिद्य खण्डशः ।\nदीप्यमाने ततः प्रास्यत् सहस्रं कृष्णवर्त्मनि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118763, "chapter_id": 3552, "verse_number": "१२", "content_sanskrit": "ते शराचितसर्वाङ्गा निनदन्तो महारवान् ।\nऊर्ध्वमुत्पत्य वेगेन निपेतुः पावके पुनः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118764, "chapter_id": 3552, "verse_number": "१३", "content_sanskrit": "शरैरभ्याहतानां च दह्यतां च वनौकसाम् ।\nविरावः श्रूयते ह्यस्मिन् समुद्रस्येव मथ्यतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118765, "chapter_id": 3552, "verse_number": "१४", "content_sanskrit": "वह्नेश्चापि प्रवृद्धस्य समुत्पेतुर्महार्चिषः ।\nजनयामासुरुद्वेगं सुमहान्तं दिवौकसाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118766, "chapter_id": 3552, "verse_number": "१५", "content_sanskrit": "ततो जग्मुर्महात्मानः सर्व एव दिवौकसः ।\nशरणं देवराजं तं सहस्राक्षं पुरन्दरम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118767, "chapter_id": 3552, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118768, "chapter_id": 3552, "verse_number": "१६", "content_sanskrit": "किमिदं मानवाः सर्वे दह्यन्ते कृष्णवर्त्मना ।\nकच्चिन्न सङ्क्षयः प्राप्तो लोकानाममरेश्वर \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118769, "chapter_id": 3552, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118770, "chapter_id": 3552, "verse_number": "१७", "content_sanskrit": "तच्छ्रुत्वा वृत्रहा तेभ्यः स्वयमेवान्ववेक्ष्य च ।\nखाण्डवस्य विमोक्षार्थं प्रययौ हरिवाहनः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118771, "chapter_id": 3552, "verse_number": "१८", "content_sanskrit": "महता मेघजालेन नानारूपेण वज्रभृत् ।\nआकाशं तमसाऽऽस्तीर्य प्रययावमरेश्वरः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118772, "chapter_id": 3552, "verse_number": "१९", "content_sanskrit": "तत्राक्षमात्रा विसृजन् धाराः शतसहस्रशः ।\nअभ्यवर्षत् सहस्राक्षः पावकं खाण्डवं प्रति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118773, "chapter_id": 3552, "verse_number": "२०", "content_sanskrit": "असम्प्राप्तास्तु ता धारास्तेजसा जातवेदसः ।\nख एव समशुष्यन्त न काश्चित् पावकं गताः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118774, "chapter_id": 3552, "verse_number": "२१", "content_sanskrit": "ततो नमुचिहा क्रुद्धो भृशमर्चिष्मतस्तदा ।\nपुनरेवातिवर्षेण ववर्ष बलवृत्रहा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118775, "chapter_id": 3552, "verse_number": "२२", "content_sanskrit": "अर्चिर्ज्वालाभिसम्बद्धं स्तनयित्नुसुघोषवत् ।\nबभूव तद्वनं घोरं धूमविद्युत्समाकुलम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118776, "chapter_id": 3552, "verse_number": "२३", "content_sanskrit": "तस्याभिवर्षतो वारि खाण्डवं प्रत्यवारयत् ।\nशरवर्षेण बीभत्सुरुत्तमास्त्राणि दर्शयन् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118777, "chapter_id": 3552, "verse_number": "२४", "content_sanskrit": "शरैः समन्ततः सर्वं खाण्डवं चापि पाण्डवः ।\nछादयामास तद्वर्षमपकृत्य ततो वनात् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118778, "chapter_id": 3552, "verse_number": "२५", "content_sanskrit": "न च स्म किञ्चिच्छक्नोति भूतं निश्चरितुं ततः ।\nसंस्तीर्यमाणैः खगमैरस्यता सव्यसाचिना \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118779, "chapter_id": 3552, "verse_number": "२६", "content_sanskrit": "तक्षकस्तु न तत्रासीन्नागराजो महाबलः ।\nदह्यमाने तु तास्मिंस्तु कुरुक्षेत्रेऽभवत् तदा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118780, "chapter_id": 3552, "verse_number": "२७", "content_sanskrit": "अश्वसेनस्तु तत्रासीत् तक्षकस्य सुतो बली ।\nस यत्नमकरोत् तीव्रं मोक्षार्थं हव्यवाहनात् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118781, "chapter_id": 3552, "verse_number": "२८", "content_sanskrit": "न शशाक स निर्गन्तुं कौन्तेयशरपीडितः ।\nमोक्षयामास तं माता निगीर्य भुजगात्मजा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118782, "chapter_id": 3552, "verse_number": "२९", "content_sanskrit": "तस्य पूर्वं शिरो ग्रस्तं पुच्छमस्य निगीर्यते ।\nऊर्ध्वमत्यक्रमीत् सा तु पन्नगी पुत्रगृद्धिनी \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118783, "chapter_id": 3552, "verse_number": "३०", "content_sanskrit": "तस्यास्तीक्ष्णेन भल्लेन पृथुधारेण पाण्डवः ।\nशिरश्चिच्छेद गच्छन्त्यास्तामपश्यत् सुरेश्वरः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118784, "chapter_id": 3552, "verse_number": "३१", "content_sanskrit": "तं मुमोचयिषुर्वज्री वातवर्षेण पाण्डवम् ।\nमोहयामास तत्काले ह्यश्वसेनस्त्वमुच्यत \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118785, "chapter_id": 3552, "verse_number": "३२", "content_sanskrit": "तां च मायां तदा दृष्ट्वा घोरां नागेन वञ्चितः ।\nद्विधा त्रिधा च चिच्छेद खगतान् भरतर्षभ \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118786, "chapter_id": 3552, "verse_number": "३३", "content_sanskrit": "शशाप तु ततः क्रुद्धो बीभत्सुं जिह्मगामिनी ।\nपावको वासुदेवश्चाप्यप्रतिष्ठो भवत्विह \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118787, "chapter_id": 3552, "verse_number": "३४", "content_sanskrit": "ततो जिष्णुः सहस्राक्षं खे वितत्याशुगैः शरैः ।\nयोधयामास सङ्क्रुद्धो वञ्चनां तामनुस्मरन् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118788, "chapter_id": 3552, "verse_number": "३५", "content_sanskrit": "देवराजोऽपि तं दृष्ट्वा संरब्धमतिफल्गुनम् ।\nदिव्यास्त्रं व्यसृजद् यत् ततानाखिला दिशः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118789, "chapter_id": 3552, "verse_number": "३६", "content_sanskrit": "ततो वायुर्महाघोरः क्षोभयामास सागरान् ।\nवियत्स्थो जनयन् मेघान् जलधारामुचोऽतुलान् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118790, "chapter_id": 3552, "verse_number": "३७", "content_sanskrit": "तद्विघातार्थमसृजदर्जुनोऽप्यस्त्रमद्भुतम् ।\nवायव्यमेवाभिमन्त्र्य अस्त्रं प्रति विशारदः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118791, "chapter_id": 3552, "verse_number": "३८", "content_sanskrit": "तेनेन्द्राशनिमेघानां वीर्यौजस्तद् विनाशितम् ।\nजलधाराश्च ताः शोषं जग्मुर्नेशुश्च विद्युतः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118792, "chapter_id": 3552, "verse_number": "३९", "content_sanskrit": "क्षणेन चाभवद् व्योम सम्प्रशान्तरजस्तमः ।\nसुखशीतानिलवहं प्रकृतिस्थार्कमण्डलम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118793, "chapter_id": 3552, "verse_number": "४०", "content_sanskrit": "निष्प्रतीकारहृष्टश्च हुतभुग्विविधाकृतिः ।\nप्रजज्वालाथ सोऽर्चिष्मान् स्वनादैः पूरयन् दिशः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118794, "chapter_id": 3552, "verse_number": "४१", "content_sanskrit": "कृष्णाभ्यां रक्षितं दृष्ट्वा तं च दावमहङ्कृताः ।\nसमुत्पेतुरथाकाशं सुपर्णाद्याः पतत्रिणः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118795, "chapter_id": 3552, "verse_number": "४२", "content_sanskrit": "गरुडा वज्रसदृशैः पक्षतुण्डनखैस्तथा ।\nप्रहर्तुकामाः सम्पेतुराकाशं कृष्णपाण्डवौ \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2118796, "chapter_id": 3552, "verse_number": "४३", "content_sanskrit": "तथैवोरगसङ्घाश्च पाण्डवस्य समीपतः ।\nउत्सृजन्तो विषं घोरं विचेरुर्ज्वलिताननाः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2118797, "chapter_id": 3552, "verse_number": "४४", "content_sanskrit": "तांश्चकर्त शरैः पार्थः सरोषान् दृश्य खेचरान् ।\nविवशा विविशुर्दीप्तं देहाभावाय पावकम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2118798, "chapter_id": 3552, "verse_number": "४५", "content_sanskrit": "ततोऽसुराः सगन्धर्वा यक्षराक्षसपन्नगाः ।\nउत्पेतुर्नादमतुलमुत्सृजन्तो रणार्थिनः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2118799, "chapter_id": 3552, "verse_number": "४६", "content_sanskrit": "अयःकाञ्चनचक्राश्च गदामुसलपाणयः ।\nकृष्णपार्थौ जिघांसन्तः क्रोधसम्मूर्छितौजसः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2118800, "chapter_id": 3552, "verse_number": "४७", "content_sanskrit": "तेषामपि व्याहरतां शस्त्रवर्षाणि मुञ्चताम् ।\nप्रममाथोत्तमाङ्गानि बीभत्सुर्निशितैः शरैः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2118801, "chapter_id": 3552, "verse_number": "४८", "content_sanskrit": "कृष्णश्च सुमहातेजाश्चक्रेणारिविघातिना ।\nदैत्यदानवसङ्घानां चकार कदनं महत् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2118802, "chapter_id": 3552, "verse_number": "४९", "content_sanskrit": "अपरे तु शरैर्विद्धाश्चक्रवेगेरितास्तदा ।\nवेलामिव समासाद्य व्यवेष्टन्त महौजसः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2118803, "chapter_id": 3552, "verse_number": "५०", "content_sanskrit": "ततः शक्रोऽतिसङ्क्रुद्धस्त्रिदशानां महेश्वरः ।\nपाण्डरं गजमास्थाय तावुभौ समुपाद्रवत् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2118804, "chapter_id": 3552, "verse_number": "५१", "content_sanskrit": "अशनिं गृह्य तरसा वज्रं चोद्यम्य चाहवे ।\nनिघ्नतैताविति प्राह सुरानसुरसूदनः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2118805, "chapter_id": 3552, "verse_number": "५२", "content_sanskrit": "ततः समुद्यतां दृष्ट्वा देवेन्द्रेण महाशनिम् ।\nजगृहुः सर्वशस्त्राणि स्वानिस्वानि ततस्तदा \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2118806, "chapter_id": 3552, "verse_number": "५३", "content_sanskrit": "कालदण्डं यमो राजन् शिबिकां च धनेश्वरः ।\nपाशांश्च तत्र वरुणः त्रिशूलं च तथा शिवः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2118807, "chapter_id": 3552, "verse_number": "५४", "content_sanskrit": "स्कन्दः शक्तिं समादाय तस्थौ मेरुरिवाचलः ।\nओषधीर्दीप्यमानाश्च जगृहातेऽश्विनावपि \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2118808, "chapter_id": 3552, "verse_number": "५५", "content_sanskrit": "जगृहे च धनुर्धाता मुसलं तु धनुस्तथा ।\nपर्वतं चापि जग्राह क्रुद्धस्त्वष्टा महाबलः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2118809, "chapter_id": 3552, "verse_number": "५६", "content_sanskrit": "स्कन्दस्तु शक्तिं जग्राह मृत्युर्देवः परश्वधम् ।\nप्रगृह्य परिघं घोरं प्रचचारार्यमाऽपि च \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2118810, "chapter_id": 3552, "verse_number": "५७", "content_sanskrit": "मित्रश्च क्षुरपर्यन्तं चक्रं गृह्य व्यतिष्ठत ।\nपूषा भगश्च सङ्क्रुद्धः सविता च विशाम्पते \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2118811, "chapter_id": 3552, "verse_number": "५८", "content_sanskrit": "आत्तकार्मुकनिस्त्रिंशाः कृष्णपार्थावभिद्रवन् ।\nरुद्राश्च वसवश्चैव मरुतश्च महाबलाः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2118812, "chapter_id": 3552, "verse_number": "५९", "content_sanskrit": "विश्वेदेवास्तथा साध्या दीप्यमानाः स्वतेजसा ।\nएते चान्ये च बहवो देवास्तौ पुरुषोत्तमौ \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2118813, "chapter_id": 3552, "verse_number": "६०", "content_sanskrit": "कृष्णपार्थौ जिघांसन्तः प्रतीयुर्विविधायुधाः ।\nतत्राद्भुतान्यदृश्यन्त विविधानि महावने \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2118814, "chapter_id": 3552, "verse_number": "६१", "content_sanskrit": "युगान्तसमरूपाणि भूतोत्पाताश्च भारत ।\nतथा दृष्ट्वा सुसंरब्धं शक्रं देवैः सहाच्युतौ \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2118815, "chapter_id": 3552, "verse_number": "६२", "content_sanskrit": "अभीतौ युधि दुर्धर्षौ तस्थतुः सज्यकार्मुकौ ।\nआगतांश्चैव तान् दृष्ट्वा देवानेकैकशस्तथा \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2118816, "chapter_id": 3552, "verse_number": "६३", "content_sanskrit": "वारयेतां सुसङ्क्रुद्धौ बाणैर्वज्रोपमैस्तदा ।\nअसकृद् भग्नसङ्कल्पाः सुराः शरबहुक्षताः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2118817, "chapter_id": 3552, "verse_number": "६४", "content_sanskrit": "भयाद् रणं परित्यज्य शक्रमेवाभिसंश्रयुः ।\nदृष्ट्वा निवारितान् देवान् माधवेनार्जुनेन च \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2118818, "chapter_id": 3552, "verse_number": "६५", "content_sanskrit": "आश्चर्यमगमंस्तत्र मुनयो दिवि निष्ठिताः ।\nशक्रश्चापि तयोर्वीर्यमुपलभ्यासकृद् रणे \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2118819, "chapter_id": 3552, "verse_number": "६६", "content_sanskrit": "बभूव परमप्रीतो भूयश्चैतावयोधयत् ।\nततोऽश्मवर्षं सुमहद् व्यसृजत् पाकशासनः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2118820, "chapter_id": 3552, "verse_number": "६७", "content_sanskrit": "भूय एव तदा वीर्यं जिज्ञासुः सव्यसाचिनः ।\nतच्छरैरर्जुनो वर्षं प्रतिजघ्नेऽत्यमर्षणः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2118821, "chapter_id": 3552, "verse_number": "६८", "content_sanskrit": "विफलं क्रियमाणं तत् सम्प्रेक्ष्य च शतक्रतुः ।\nभूयः संवर्धयामास तद्वर्षं देवराडपि \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2118822, "chapter_id": 3552, "verse_number": "६९", "content_sanskrit": "सोऽश्मवर्षं महावेगैरिषुभिः पाकशासनिः ।\nविलयं गमयामास हर्षयन् पितरं तथा \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2118823, "chapter_id": 3552, "verse_number": "७०", "content_sanskrit": "समुत्क्षित्य तु पाणिभ्यां मन्दराच्छिखरं महत् ।\nसद्रुमं व्यसृजच्छक्रो जिघांसुः पाण्डुनन्दनम् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2118824, "chapter_id": 3552, "verse_number": "७१", "content_sanskrit": "ततोऽर्जुनो वेगवद्भिर्ज्वलितानलसन्निभैः ।\nबाणैर्विध्वंसयामास गिरेः शृङ्गं सहस्रशः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2118825, "chapter_id": 3552, "verse_number": "७२", "content_sanskrit": "गिरेर्विकीर्यमाणस्य तस्य रूपं तदा बभौ ।\nसार्कचन्द्रग्रहस्येव नभसः प्रविशीर्यतः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2118826, "chapter_id": 3552, "verse_number": "७३", "content_sanskrit": "तेन चापतता देशे शैलेन महता भृशम् ।\nभूय एव ततस्तत्र प्राणिनां प्राणसङ्क्षयः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2118827, "chapter_id": 3552, "verse_number": "१३१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकत्रिंशत्यधिकद्विशततमोऽध्यायः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2118828, "chapter_id": 3552, "verse_number": "३", "content_sanskrit": "॥ इति खाण्डवदाहपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2118829, "chapter_id": 3552, "verse_number": "", "content_sanskrit": "॥ समाप्तं खाण्डवदाहपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]