[{"id": 2044849, "chapter_id": 2001, "verse_number": "६-५०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044850, "chapter_id": 2001, "verse_number": "६-५०-१", "content_sanskrit": "कृतेऽवहारे सैन्यानां प्रथमे भरतर्षभ ।\nभीष्मे च युद्धसंरब्धे हृष्टे दुर्योधने तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044851, "chapter_id": 2001, "verse_number": "६-५०-२", "content_sanskrit": "धर्मराजस्ततस्तूर्णमभिगम्य जनार्दनम् ।\nभ्रातृभिः सहितः सर्वैः सर्वैश्चैव जनेश्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044852, "chapter_id": 2001, "verse_number": "६-५०-३", "content_sanskrit": "शुचा परमया युक्तश्चिन्तयानः पराजयम्।\nवार्ष्णेयमब्रवीद्रजान्दृष्ट्वा भीष्मस्य विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044853, "chapter_id": 2001, "verse_number": "६-५०-४", "content_sanskrit": "कृष्ण पश्य महेष्वासं भीष्मं भीमपराक्रमम् ।\nशरैर्दहन्तं सैन्यं मे ग्रीष्मे कक्षमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044854, "chapter_id": 2001, "verse_number": "६-५०-५", "content_sanskrit": "कथमेनं महात्मानं शक्ष्यामः प्रतिवीक्षितुम् ।\nलेलिह्यमानं सैन्यं मे हविष्मन्तमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044855, "chapter_id": 2001, "verse_number": "६-५०-६", "content_sanskrit": "एतं हि पुरुषव्याघ्रं धनुष्मन्तं महाबलम् ।\nदृष्ट्वा विप्रद्रुर्त सैन्यं समरे मार्गणाहतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044856, "chapter_id": 2001, "verse_number": "६-५०-७", "content_sanskrit": "शक्यो जेतुं यमः क्रुद्धो वज्रपाणिश्च संयुगे ।\nवरुणः पाशभृद्वापि कुबेरो वा गदाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044857, "chapter_id": 2001, "verse_number": "६-५०-८", "content_sanskrit": "न तु भीष्मो महाजेताः शक्यो जेतुं महाबलः ।\nसोऽहमेवं गते मग्नो भीष्मागाधजलेऽप्लुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044858, "chapter_id": 2001, "verse_number": "६-५०-९", "content_sanskrit": "आत्मनो बुद्धिदौर्बल्याद्भीष्ममासाद्य केशव ।\nवनं यात्सामि वार्ष्णेय श्रेयो मे तत्र जीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044859, "chapter_id": 2001, "verse_number": "६-५०-१०", "content_sanskrit": "न त्वेतान्पृथिवीपालान्दातुं भीष्माय मृत्यवे ।\nक्षपयिष्यति सेनां मे कृष्ण भीष्मो महास्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044860, "chapter_id": 2001, "verse_number": "६-५०-११", "content_sanskrit": "यथाऽनलं प्रज्वलितं पतङ्गाः समभिद्रुताः ।\nविनाशायोपगच्छन्ति तथा मे सनिको जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044861, "chapter_id": 2001, "verse_number": "६-५०-१२", "content_sanskrit": "क्षयं नीतोऽस्मि वार्ष्णेय राज्यहेतोः पराक्रमी ।\nभ्रातश्चैव मे वीराः कर्शिताः शरपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044862, "chapter_id": 2001, "verse_number": "६-५०-१३", "content_sanskrit": "मत्कृते भ्रातृहार्देन राज्याद्भ्रष्टास्तथा सुखात्।\nजीवितं बहुमन्येऽहं जीवितं ह्यद्य दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044863, "chapter_id": 2001, "verse_number": "६-५०-१४", "content_sanskrit": "जीवितस्य च शेषेण तपस्तप्स्यामि दुश्चरम् ।\nन घातयिष्यामि रणे मित्राणीमानि केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044864, "chapter_id": 2001, "verse_number": "६-५०-१५", "content_sanskrit": "रथान्मे बहुसाहस्रान्दिव्यैरस्त्रैर्महाबलः ।\nघातयत्यनिशं भीष्मः प्रवराणां प्रहारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044865, "chapter_id": 2001, "verse_number": "६-५०-१६", "content_sanskrit": "किं नु कृत्वा हितं मे स्याद्ब्रूहि माधव माचिरम् ।\nमध्यस्थमिव पश्यामि समरे सव्यसाचिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044866, "chapter_id": 2001, "verse_number": "६-५०-१७", "content_sanskrit": "एको भीमः परं शक्त्या युध्यत्येव महाभुजः ।\nकेवलं बाहुवीर्येण क्षत्रधर्ममनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044867, "chapter_id": 2001, "verse_number": "६-५०-१८", "content_sanskrit": "गदया वीरघातिन्या यथोत्साहं महामनाः ।\nकरोत्यसुकरं कर्म रथाश्वनरपङ्क्तिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044868, "chapter_id": 2001, "verse_number": "६-५०-१९", "content_sanskrit": "नालमेष क्षयं कर्तुं परसैन्यस्य मारिष ।\nआर्जवेनैव युद्धेन वीर वर्षशतैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044869, "chapter_id": 2001, "verse_number": "६-५०-२०", "content_sanskrit": "एकोऽस्त्रवित्सखा तेऽयं सोऽप्यस्मान्समुपेक्षते ।\nनिर्दह्यमानान्भीष्मेण द्रोणेन च महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044870, "chapter_id": 2001, "verse_number": "६-५०-२१", "content_sanskrit": "दिव्यान्यस्त्राणि भीष्मस्य द्रोणस्य च महात्मनः ।\nधक्ष्यन्ति क्षत्रियान्सर्वान्प्रयुक्तानि पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044871, "chapter_id": 2001, "verse_number": "६-५०-२२", "content_sanskrit": "कृष्ण भीष्मः सुसंरब्धः सहितः सर्वपार्थिवैः ।\nक्षपयिष्यति नो नूनं यादृशोऽस्य पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044872, "chapter_id": 2001, "verse_number": "६-५०-२३", "content_sanskrit": "स त्वं पश्य महाभाग योगेश्वर महारथम् ।\nभीष्मं यः शमयेत्संख्ये दावाग्निं जलदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044873, "chapter_id": 2001, "verse_number": "६-५०-२४", "content_sanskrit": "तव प्रसादाद्गोविन्द पाण्डवा निहतद्विषः ।\nस्वराज्यमनुसंप्राप्ता मोदिष्यन्ते सबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044874, "chapter_id": 2001, "verse_number": "६-५०-२५", "content_sanskrit": "एवमुक्त्वा ततः पार्थो ध्यान्नास्ते महामनाः ।\nचिरमन्तर्मना भूत्वा शोकोपहतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044875, "chapter_id": 2001, "verse_number": "६-५०-२६", "content_sanskrit": "शोकार्तं तमथो ज्ञात्वा दुःखोपहतचेतसम् ।\nअब्रवीत्तत्र गोविन्दो हर्षयन्सर्वपाण्डवान् ॥ ६-५०-२७aमाशुचो भरतश्रेष्ट न त्वं शोचितुमर्हसि ।\nयस्य ते भ्रातरः शूराः सर्वलोकेषु धन्विनःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044876, "chapter_id": 2001, "verse_number": "६-५०-२८", "content_sanskrit": "अहं च प्रियकृद्राजन्सात्यकिश्च महायशाः ।\nविराटद्रुपदौ चेमौ धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044877, "chapter_id": 2001, "verse_number": "६-५०-२९", "content_sanskrit": "तथैव सबलाश्चेमे राजानो राजसत्तम।\nत्वत्प्रसादं प्रतीक्षन्ते त्वद्भक्ताश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044878, "chapter_id": 2001, "verse_number": "६-५०-३०", "content_sanskrit": "एष ते पार्षतो नित्यं हितकामः प्रिये रतः ।\nसैनापत्यमनुप्राप्तो धृष्टद्युम्नो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044879, "chapter_id": 2001, "verse_number": "६-५०-३१", "content_sanskrit": "शिखण्डी च महाबाहो भीष्मस्य निधनं किल।\nएतच्छ्रुत्वा ततो धर्मो धृष्टद्युम्नं महारथम् ।\nअब्रवीत्समितौ तस्यां वासुदेवस्य श्रृण्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044880, "chapter_id": 2001, "verse_number": "६-५०-३२", "content_sanskrit": "धृष्टद्युम्न निबोधेदं यत्त्वां वक्ष्यामि मारिष।\nनातिक्रम्यं भवेत्तच्च वचनं मम भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044881, "chapter_id": 2001, "verse_number": "६-५०-३३", "content_sanskrit": "भवान्सेनापतिर्मह्यं वासुदेवेन संमितः।\nकार्तिकेयो यथा नित्यं देवानामभवत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044882, "chapter_id": 2001, "verse_number": "६-५०-३४", "content_sanskrit": "तथा त्वमपि पाण्डूनां सेनानीः पुरुषर्षभ।\nस त्वं पुरुषशार्दूल विक्रम्य जहि कौरवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044883, "chapter_id": 2001, "verse_number": "६-५०-३५", "content_sanskrit": "अहं च तेऽनुयास्यामि भीमः कृष्णश्च मारिष ।\nमाद्रीपुत्रौ च सहितौ द्रौपदेयाश्च दंशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044884, "chapter_id": 2001, "verse_number": "६-५०-३६", "content_sanskrit": "ये चान्ये पृथिवीपालाः प्रधानाः पुरुषर्षभ ।\nतत उद्धर्षयन्सर्वान्धृष्टद्युम्नोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044885, "chapter_id": 2001, "verse_number": "६-५०-३७", "content_sanskrit": "अहं द्रोणान्तकः पार्थ विहितः शम्भुना पुरा।\nरणे भीष्मं कृपं द्रोणं तथा शल्यं जयद्रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044886, "chapter_id": 2001, "verse_number": "६-५०-३८", "content_sanskrit": "सर्वानद्य रणे दृप्तान्प्रतियोत्स्यामि पार्थिव ।\nअथोत्क्रुष्टं महेष्वासैः पाण्डवैर्युद्धदुर्मदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044887, "chapter_id": 2001, "verse_number": "६-५०-३९", "content_sanskrit": "समुद्यते पार्थिवेन्द्रे पार्षते शत्रुसूदने ।\nतमब्रवीत्ततः पार्थः पार्षतं पृतनापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044888, "chapter_id": 2001, "verse_number": "६-५०-४०", "content_sanskrit": "व्यूहः क्रौञ्चारुणो नाम सर्वशत्रुनिबर्हणः ।\nयं बृहस्पतिरिन्द्राय तदा देवासुरेऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044889, "chapter_id": 2001, "verse_number": "६-५०-४१", "content_sanskrit": "तं यथावत्प्रतिव्यूहं परानीकविनाशनम् ।\nअदृष्टपूर्वं राजानः पश्यन्तु कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044890, "chapter_id": 2001, "verse_number": "६-५०-४२", "content_sanskrit": "यथोक्तः स नृदेवेन विष्णुर्वज्रभृता यथा।\nप्रभाते सर्वसैन्यानामग्रे चक्रे धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044891, "chapter_id": 2001, "verse_number": "६-५०-४३", "content_sanskrit": "आदित्यपथगः केतुस्तस्याद्भुतमनोरमः ।\nशासनात्पुरुहूतस्य निर्मितो विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044892, "chapter_id": 2001, "verse_number": "६-५०-४४", "content_sanskrit": "इन्द्रायुधसवर्णाभिः पताकाभिरलङ्कृतः । ६-५०-४४bआकाशग इवाकाशे गन्धर्वनगरोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044893, "chapter_id": 2001, "verse_number": "६-५०-४५", "content_sanskrit": "नृत्यमान इवाभाति रथचर्यासु मारिष ।\nतेन रत्नवता पार्थः स च गाण्डीवधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044894, "chapter_id": 2001, "verse_number": "६-५०-४६", "content_sanskrit": "बभूव परमोपेतः सुमेरुरिव भानुना ।\nशिरोभूद्द्रुपदो राजा महत्या सेनया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044895, "chapter_id": 2001, "verse_number": "६-५०-४७", "content_sanskrit": "कुन्तिभोजश्च चैद्यश्च चक्षुर्भ्यां तौ जनेश्वरौ ।\nदाशार्णकाः प्रभद्राश्च दाशेरकगणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044896, "chapter_id": 2001, "verse_number": "६-५०-४८", "content_sanskrit": "अनूपकाः किराताश्च ग्रीवायां भरतर्षभ ।\nपटच्चरैश्च पौण्ड्रैश्च राजन्पौरवकैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044897, "chapter_id": 2001, "verse_number": "६-५०-४९", "content_sanskrit": "निषादैः सहितश्चापि पृष्ठमासीद्युधिष्ठिरः।\nपक्षौ तु भीमसेनश्च धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044898, "chapter_id": 2001, "verse_number": "६-५०-५०", "content_sanskrit": "द्रौपदेयाभिमन्युश्च सात्यकिश्च महारथः ।\nपिशाचा दारदाश्चैव पुण्ड्राः कुण्डीविषैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044899, "chapter_id": 2001, "verse_number": "६-५०-५१", "content_sanskrit": "मारुता धेनुकाश्चैव तंगमाः परतंगणाः ।\nबाह्लिकास्तित्तिराश्चैव चोलाः पाण्ड्याश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044900, "chapter_id": 2001, "verse_number": "६-५०-५२", "content_sanskrit": "एते जनपदा राजन्दक्षिणं पक्षमाश्रिताः ।\nअग्निवेशास्तुद्दुण्डाश्च मालवा दानभारयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044901, "chapter_id": 2001, "verse_number": "६-५०-५३", "content_sanskrit": "शबरा उद्भसाश्चैव वत्साश्च सह नाकुलैः ।\nनकुलः सहदेवश्च वामं पक्षं समाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044902, "chapter_id": 2001, "verse_number": "६-५०-५४", "content_sanskrit": "रथानामयुतं पक्षौ शिरस्तु नियुतं तथा।\nपृष्ठमर्बुदमेवासीत्सहस्रामि च विंशतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044903, "chapter_id": 2001, "verse_number": "६-५०-५५", "content_sanskrit": "ग्रीवायां नियुतं चापि सहस्रामि च सप्ततिः ।\nपक्षकोटिप्रपक्षेषु पक्षान्तेषु च वारणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044904, "chapter_id": 2001, "verse_number": "६-५०-५६", "content_sanskrit": "जग्मुः परिवृता राजंश्चलन्त इव पर्वताः ।\nजघनं पालयामास विराटः सह केकयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2044905, "chapter_id": 2001, "verse_number": "६-५०-५७", "content_sanskrit": "काशिराजश्च शैब्यश्च रथानामयुतैस्त्रिभिः ।\nएवमेनं महाव्यूहं व्यूह्य भारत पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2044906, "chapter_id": 2001, "verse_number": "६-५०-५८", "content_sanskrit": "सूर्योधयं त इच्छतः स्थिता युद्धाय दंशिताः ।\nतेषामादित्यवर्मानि विमलानि महान्ति च ।\nश्वेतच्छत्राण्यशोभन्त वारणेषु रथेषु च ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2044907, "chapter_id": 2001, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि द्वितीयदिवसयुद्धे पञ्चाशोऽद्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]