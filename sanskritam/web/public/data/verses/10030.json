[{"id": 6000030000, "chapter_id": 10030, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000030001, "chapter_id": 10030, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.001.m4a", "display_order": 2}, {"id": 6000030002, "chapter_id": 10030, "verse_number": "२-१०-१", "content_sanskrit": "अत्र सर्गो विसर्गश्च स्थानं पोषणमूतयः।\nमन्वन्तरेशानुकथा निरोधो मुक्तिराश्रयः॥ २/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.002.m4a", "display_order": 3, "topics": [{"text": "शुकेन परीक्षितं प्रति भागवतदशलक्षणीलक्षणकथनम्", "range": "१–७"}]}, {"id": 6000030003, "chapter_id": 10030, "verse_number": "२-१०-२", "content_sanskrit": "दशमस्य विशुद्ध्यर्थं नवानामिह लक्षणम्।\nवर्णयन्ति महात्मानः श्रुतेनार्थेन चाञ्जसा॥ २/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.003.m4a", "display_order": 4}, {"id": 6000030004, "chapter_id": 10030, "verse_number": "२-१०-३", "content_sanskrit": "भूतमात्रेन्द्रियधियां जन्म सर्ग उदाहृतः।\nब्रह्मणो गुणवैषम्याद्विसर्गः पौरुषः स्मृतः॥ २/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.004.m4a", "display_order": 5}, {"id": 6000030005, "chapter_id": 10030, "verse_number": "२-१०-४", "content_sanskrit": "स्थितिर्वैकुण्ठविजयः पोषणं तदनुग्रहः।\nमन्वन्तराणि सद्धर्मा ऊतयः कर्मवासनाः॥ २/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.005.m4a", "display_order": 6}, {"id": 6000030006, "chapter_id": 10030, "verse_number": "२-१०-५", "content_sanskrit": "अवतारानुचरितं हरेश्चास्यानुवर्तिनाम्।\nपुंसामीशकथा प्रोक्ता नानाख्यानोपबृंहिताः॥ २/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.006.m4a", "display_order": 7}, {"id": 6000030007, "chapter_id": 10030, "verse_number": "२-१०-६", "content_sanskrit": "निरोधोऽस्यानुशयनमात्मनः सह शक्तिभिः।\nमुक्तिर्हित्वाऽन्यथारूपं स्वरूपेण व्यवस्थितिः॥ २/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.007.m4a", "display_order": 8}, {"id": 6000030008, "chapter_id": 10030, "verse_number": "२-१०-७", "content_sanskrit": "आभासश्च निरोधश्च यतस्तत्त्रयमीयते।\nस आश्रयः परं ब्रह्म परमात्मेति शब्द्यते॥ २/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.008.m4a", "display_order": 9}, {"id": 6000030009, "chapter_id": 10030, "verse_number": "२-१०-८", "content_sanskrit": "आध्यात्मिको यः पुरुषः सोऽसावेवाधिदैविकः।\nयस्तत्रोभयविच्छेदः स स्मृतो ह्याधिभौतिकः॥ २/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.009.m4a", "display_order": 10, "topics": [{"text": "पूर्वोक्तायाः सृष्ट्याः पुनः प्रपञ्चनम्", "range": "७–४५"}]}, {"id": 6000030010, "chapter_id": 10030, "verse_number": "२-१०-९", "content_sanskrit": "एतदेकतमाभावे यदा नोपलभामहे।\nत्रितयं तत्र यो वेद स आत्मा स्वाश्रयाश्रयः॥ २/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.010.m4a", "display_order": 11}, {"id": 6000030011, "chapter_id": 10030, "verse_number": "२-१०-१०", "content_sanskrit": "पुरुषोऽण्डं विनिर्भिद्य यदाऽसौ स विनिर्गतः।\nआत्मनोऽयनमन्विच्छन्नपोऽस्राक्षीच्छुचिः शुचीः॥ २/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.011.m4a", "display_order": 12}, {"id": 6000030012, "chapter_id": 10030, "verse_number": "२-१०-११", "content_sanskrit": "तास्ववात्सीत्स्वसृष्टासु सहस्रपरिवत्सरान्।\nतेन नारायणो नाम यदापः पुरुषोद्भवाः॥ २/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.012.m4a", "display_order": 13}, {"id": 6000030013, "chapter_id": 10030, "verse_number": "२-१०-१२", "content_sanskrit": "द्रव्यं कर्म च कालश्च स्वभावो जीव एव च।\nयदनुग्रहतः सन्ति न सन्ति यदुपेक्षया॥ २/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.013.m4a", "display_order": 14}, {"id": 6000030014, "chapter_id": 10030, "verse_number": "२-१०-१३", "content_sanskrit": "एको नानात्वमन्विच्छन्योगतल्पात्समुत्थितः।\nवीर्यं हिरण्मयं देवो मायया व्यसृजत्त्रिधा॥ २/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.014.m4a", "display_order": 15}, {"id": 6000030015, "chapter_id": 10030, "verse_number": "२-१०-१४", "content_sanskrit": "अधिदैवमथाध्यात्ममधिभूतमिति प्रभुः।\nपुनस्तत्पौरुषं वीर्यं त्रिधाऽभिद्यत तच्छृणु॥ २/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.015.m4a", "display_order": 16}, {"id": 6000030016, "chapter_id": 10030, "verse_number": "२-१०-१५", "content_sanskrit": "अन्तः शरीर आकाशे पुरुषस्य विचेष्टतः।\nओजः सहो बलं जज्ञे ततः प्राणो महानभूत्॥ २/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.016.m4a", "display_order": 17}, {"id": 6000030017, "chapter_id": 10030, "verse_number": "२-१०-१६", "content_sanskrit": "अनुप्राणन्ति यं प्राणाः प्राणन्तं सर्वजन्तुषु।\nअपानन्तमपानन्ति नरदेवमिवानुगाः॥ २/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.017.m4a", "display_order": 18}, {"id": 6000030018, "chapter_id": 10030, "verse_number": "२-१०-१७", "content_sanskrit": "प्राणेन क्षिपता क्षुत्तृडन्तरा जायते विभोः।\nपिपासतो जक्षतश्च प्राङ्मुखं निरभिद्यत॥ २/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.018.m4a", "display_order": 19}, {"id": 6000030019, "chapter_id": 10030, "verse_number": "२-१०-१८", "content_sanskrit": "मुखतस्तालु निर्भिन्नं जिह्वा तत्रोपजायते।\nततो नानारसो जज्ञे जिह्वया योऽधिगम्यते॥ २/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.019.m4a", "display_order": 20}, {"id": 6000030020, "chapter_id": 10030, "verse_number": "२-१०-१९", "content_sanskrit": "विवक्षोर्मुखतो भूम्नो वह्निर्वाग्व्याहृतं तयोः।\nजले वै तस्य सुचिरं निरोधः समजायत॥ २/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.020.m4a", "display_order": 21}, {"id": 6000030021, "chapter_id": 10030, "verse_number": "२-१०-२०", "content_sanskrit": "नासिके निरभिद्येतां दोधूयति नभस्वति।\nतत्र वायुर्गन्धवहो घ्राणो नसि जिघृक्षतः॥ २/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.021.m4a", "display_order": 22}, {"id": 6000030022, "chapter_id": 10030, "verse_number": "२-१०-२१", "content_sanskrit": "यदाऽऽत्मनि निरालोक आत्मानं च दिदृक्षतः।\nनिर्भिन्ने अक्षिणी तस्य ज्योतिश्चक्षुर्गुणग्रहः॥ २/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.022.m4a", "display_order": 23}, {"id": 6000030023, "chapter_id": 10030, "verse_number": "२-१०-२२", "content_sanskrit": "बोध्यमानस्य ऋषिभिरात्मनस्तज्जिघृक्षतः।\nकर्णौ च निरभिद्येतां दिशः श्रोत्रं गुणग्रहः॥ २/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.023.m4a", "display_order": 24}, {"id": 6000030024, "chapter_id": 10030, "verse_number": "२-१०-२३", "content_sanskrit": "वस्तुनो मृदुकाठिन्यलघुगुर्वुष्णशीतताम्। जिघृक्षतस्त्वङ्निर्भिन्ना तस्यां रोममहीरुहाः।\nतत्र चान्तर्बहिर्व्याप्तस्त्वचा लब्धगुणावृतः॥ २/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.024.m4a", "display_order": 25}, {"id": 6000030025, "chapter_id": 10030, "verse_number": "२-१०-२४", "content_sanskrit": "हस्तौ रुरुहतुस्तस्य नानाकर्मचिकीर्षया।\nतयोस्तु बलवानिन्द्र आदानमुभयाश्रयम्॥ २/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.025.m4a", "display_order": 26}, {"id": 6000030026, "chapter_id": 10030, "verse_number": "२-१०-२५", "content_sanskrit": "गतिं चिकीर्षतः पादौ रुरुहातेऽभिकामतः।\nपद्भ्यां हव्यं स्वयं यज्ञः कर्म यत्क्रियते नृभिः॥ २/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.026.m4a", "display_order": 27}, {"id": 6000030027, "chapter_id": 10030, "verse_number": "२-१०-२६", "content_sanskrit": "निरभिद्यत शिश्नो वै प्रजानन्दामृतार्थिनः।\nउपस्थ आसीत्कामानां प्रियं तदुभयाश्रयम्॥ २/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.027.m4a", "display_order": 28}, {"id": 6000030028, "chapter_id": 10030, "verse_number": "२-१०-२७", "content_sanskrit": "उत्सिसृक्षोर्धातुमलं निरभिद्यत वै गुदम्।\nततः पायुस्ततो मित्र उत्सर्ग उभयाश्रयः॥ २/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.028.m4a", "display_order": 29}, {"id": 6000030029, "chapter_id": 10030, "verse_number": "२-१०-२८", "content_sanskrit": "आसिसृक्षोः पुरः पुर्यां नाभिद्वारमपावृतम्।\nततोऽपानस्ततो मृत्युः पृथक्त्वमुभयाश्रयम्॥ २/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.029.m4a", "display_order": 30}, {"id": 6000030030, "chapter_id": 10030, "verse_number": "२-१०-२९", "content_sanskrit": "आदित्सोरन्नपानानाम् असृक्कुक्ष्यन्त्रनाडिके।\nनद्यः समुद्राश्च तयोस्तृप्तिः पुष्टिस्तदाश्रये॥ २/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.030.m4a", "display_order": 31}, {"id": 6000030031, "chapter_id": 10030, "verse_number": "२-१०-३०", "content_sanskrit": "निदिध्यासोरात्ममायां हृदयं निरभिद्यत।\nततो मनश्चन्द्र इति सङ्कल्पः काम एव च॥ २/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.031.m4a", "display_order": 32}, {"id": 6000030032, "chapter_id": 10030, "verse_number": "२-१०-३१", "content_sanskrit": "त्वक्चर्ममांसरुधिरमेदोमज्जास्थिधातवः।\nभूम्यप्तेजोमयाः सप्त प्राणो व्योमाम्बुवायुभिः॥ २/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.032.m4a", "display_order": 33}, {"id": 6000030033, "chapter_id": 10030, "verse_number": "२-१०-३२", "content_sanskrit": "गुणात्मकानीन्द्रियाणि भूतादिप्रभवा गुणाः।\nमनः सर्वविकारात्मा बुद्धिर्विज्ञानरूपिणी॥ २/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.033.m4a", "display_order": 34}, {"id": 6000030034, "chapter_id": 10030, "verse_number": "२-१०-३३", "content_sanskrit": "एतद्भगवतो रूपं स्थूलं ते व्याहृतं मया।\nमह्यादिभिश्चावरणैरष्टभिर्बहिरावृतम्॥ २/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.034.m4a", "display_order": 35}, {"id": 6000030035, "chapter_id": 10030, "verse_number": "२-१०-३४", "content_sanskrit": "अतःपरं सूक्ष्मतममव्यक्तं निर्विशेषणम्।\nअनादिमध्यनिधनं नित्यं वाङ्मनसोः परम्॥ २/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.035.m4a", "display_order": 36}, {"id": 6000030036, "chapter_id": 10030, "verse_number": "२-१०-३५", "content_sanskrit": "अमुनी भगवद्रूपे मया ते ह्यनुवर्णिते।\nउभे अपि न गृह्णन्ति मायासृष्टेऽविपश्चितः॥ २/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.036.m4a", "display_order": 37}, {"id": 6000030037, "chapter_id": 10030, "verse_number": "२-१०-३६", "content_sanskrit": "स वाच्यवाचकतया भगवान्ब्रह्मरूपधृक्।\nनामरूपक्रिया धत्ते सकर्माकर्मकः परः॥ २/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.037.m4a", "display_order": 38}, {"id": 6000030038, "chapter_id": 10030, "verse_number": "२-१०-३७", "content_sanskrit": "प्रजापतीन् मनून् देवानृषीन् पितृगणान् पृथक्।\nसिद्धचारणगन्धर्वान् विद्याध्रासुरगुह्यकान्॥ २/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.038.m4a", "display_order": 39}, {"id": 6000030039, "chapter_id": 10030, "verse_number": "२-१०-३८", "content_sanskrit": "किन्नराप्सरसो नागान् सर्पान् किम्पुरुषानपि।\nमातृरक्षःपिशाचांश्च प्रेतभूतविनायकान्॥ २/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.039.m4a", "display_order": 40}, {"id": 6000030040, "chapter_id": 10030, "verse_number": "२-१०-३९", "content_sanskrit": "कूष्माण्डोन्मादवेतालान् यातुधानान् ग्रहानपि।\nखगान् मृगान् पशून् वृक्षान् गिरीन् नृप सरीसृपान्॥ २/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.040.m4a", "display_order": 41}, {"id": 6000030041, "chapter_id": 10030, "verse_number": "२-१०-४०", "content_sanskrit": "विविधाश्चतुर्विधाश्चान्ये जलस्थलनभौकसः।\nकुशलाकुशलमिश्राणां कर्मणां गतयस्त्विमाः॥ २/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.041.m4a", "display_order": 42}, {"id": 6000030042, "chapter_id": 10030, "verse_number": "२-१०-४१", "content_sanskrit": "सत्त्वं रजस्तम इति तिस्रः सुरनृनारकाः।\nतत्राप्येकैकशो राजन् भिद्यन्ते गतयस्‍त्रिधा॥ २/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.042.m4a", "display_order": 43}, {"id": 6000030043, "chapter_id": 10030, "verse_number": "२-१०-४२", "content_sanskrit": "यदैवैकतमोऽन्याभ्यां स्वभाव उपहन्यते। तदैवेदं जगद्धाता भगवान् धर्मरूपधृक्।\nपुष्णाति स्थापयन् विश्वं तिर्यङ्नरसुरात्मभिः॥ २/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.043.m4a", "display_order": 44}, {"id": 6000030044, "chapter_id": 10030, "verse_number": "२-१०-४३", "content_sanskrit": "ततः कालाग्निरुद्रात्मा यत्सृष्टमिदमात्मनः।\nसन्नियच्छति तत्काले घनानीकमिवानिलः॥ २/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.044.m4a", "display_order": 45}, {"id": 6000030045, "chapter_id": 10030, "verse_number": "२-१०-४४", "content_sanskrit": "इत्थम्भावेन कथितो भगवान् भगवत्तमः।\nनेत्थम्भावेन हि परं द्रष्टुमर्हन्ति सूरयः॥ २/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.045.m4a", "display_order": 46}, {"id": 6000030046, "chapter_id": 10030, "verse_number": "२-१०-४५", "content_sanskrit": "न चास्य जन्मकर्माणि परस्य न विधीयते।\nकर्तृत्वं प्रतिषेधार्थं, माययाऽऽरोपितं हि तत्॥ २/१०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.046.m4a", "display_order": 47}, {"id": 6000030047, "chapter_id": 10030, "verse_number": "२-१०-४६", "content_sanskrit": "अयं ते ब्रह्मणः कल्पः सविकल्प उदाहृतः।\nविधिः साधारणो यत्र सर्गाः प्राकृतवैकृताः॥ २/१०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.047.m4a", "display_order": 48, "topics": [{"text": "तृतीयस्कन्धे पाद्मकल्पनिरूपणप्रतिज्ञानम्", "range": "४६–४७"}]}, {"id": 6000030048, "chapter_id": 10030, "verse_number": "२-१०-४७", "content_sanskrit": "परिमाणं च कालस्य कल्पलक्षणविग्रहम्।\nयथा परस्ताद्व्याख्यास्ये पाद्मं कल्पमिमं शृृणु॥ २/१०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.048.m4a", "display_order": 49}, {"id": 6000030049, "chapter_id": 10030, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.049.m4a", "display_order": 50}, {"id": 6000030050, "chapter_id": 10030, "verse_number": "२-१०-४८", "content_sanskrit": "यदाह नो भवान् सूत क्षत्ता भागवतोत्तमः।\nचचार तीर्थानि भुवस्त्यक्त्वा बन्धून्सुदुस्त्यजान्॥ २/१०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.050.m4a", "display_order": 51, "topics": [{"text": "शौनकेन विदुरमैत्रेयसंवादप्रकारं पृष्टेन सूतेन तं प्रति शुकेन परीक्षितं प्रत्युक्तस्य संवादस्य कथनप्रतिज्ञानम्", "range": "४८–५१"}]}, {"id": 6000030051, "chapter_id": 10030, "verse_number": "२-१०-४९", "content_sanskrit": "कुत्र कौषारवेस्तस्य संवादोऽध्यात्मसम्भवः।\nयद्वा स भगवांस्तस्मै पृष्टस्तत्त्वमुवाच ह॥ २/१०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.051.m4a", "display_order": 52}, {"id": 6000030052, "chapter_id": 10030, "verse_number": "२-१०-५०", "content_sanskrit": "ब्रूहि नस्तदिदं सौम्य विदुरस्य विचेष्टितम्।\nबन्धुत्यागनिमित्तं च यथैवागतवान् पुनः॥ २/१०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.052.m4a", "display_order": 53}, {"id": 6000030053, "chapter_id": 10030, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.053.m4a", "display_order": 54}, {"id": 6000030054, "chapter_id": 10030, "verse_number": "२-१०-५१", "content_sanskrit": "राज्ञा परीक्षिता पृष्टो यदवादीन्महामुनिः।\nतद्वोऽभिधास्ये शृृणुत राज्ञः प्रश्नानुसारतः॥ २/१०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_010/BhP_02.010.054.m4a", "display_order": 55}, {"id": 6000030055, "chapter_id": 10030, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 6000030056, "chapter_id": 10030, "verse_number": null, "content_sanskrit": "॥ इति द्वितीयस्कन्धः समाप्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]