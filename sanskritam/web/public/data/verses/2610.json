[{"id": 2075992, "chapter_id": 2610, "verse_number": "१२-११५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075993, "chapter_id": 2610, "verse_number": "१२-११५-१", "content_sanskrit": "पितामह महाप्राज्ञ संशयो मे महानयम्।\nसंछेत्तव्यस्त्वया राजन्भवान्कुलकरो हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075994, "chapter_id": 2610, "verse_number": "१२-११५-२", "content_sanskrit": "पुरुषाणामयं तात दुर्वृत्तानां दुरात्मनाम्।\nकथितो वाक्यसंचारस्ततो विज्ञापयामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075995, "chapter_id": 2610, "verse_number": "१२-११५-३", "content_sanskrit": "यद्धितं राज्यतन्त्रस्य कुलस्य च सुखोदयम्।\nअयत्यां च तदात्वे च क्षेमवृद्धिकरं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075996, "chapter_id": 2610, "verse_number": "१२-११५-४", "content_sanskrit": "पुत्रपौत्राभिरामं च राष्ट्रवृद्धिकरं च यत्।\nअन्नपाने शरीरे च हितं यत्तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075997, "chapter_id": 2610, "verse_number": "१२-११५-५", "content_sanskrit": "अभिषिक्तो हि यो राजा राज्यस्थो मित्रसंवृत।\nसमुहृत्समुपेतो वा स कथं रञ्जयेत्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075998, "chapter_id": 2610, "verse_number": "१२-११५-६", "content_sanskrit": "यो ह्यसत्प्रग्रहरतिः स्नेहरागबलात्कृतः।\nइन्द्रियाणामनीशत्वादसज्जनबुभूषकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075999, "chapter_id": 2610, "verse_number": "१२-११५-७", "content_sanskrit": "तस्य भृत्या विमुखतां यान्ति सर्वे कुलोद्गताः।\nन च भृत्यबलैरर्थैः स राजा संप्रयुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076000, "chapter_id": 2610, "verse_number": "१२-११५-८", "content_sanskrit": "एतन्मे चिन्तयानस्य राजधर्मान्दिवानिशम्।\nबृहस्पतिसमो बुद्ध्या भवाञ्शंसितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076001, "chapter_id": 2610, "verse_number": "१२-११५-९", "content_sanskrit": "शासता पुरुषव्याघ्र त्वं नः कुलहिते रतः।\nक्षत्ता चैको महाप्राज्ञो यो नः शंसति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076002, "chapter_id": 2610, "verse_number": "१२-११५-१०", "content_sanskrit": "त्वत्तः कुलहितं वाक्यं श्रुत्वा राज्यहितोदयम्।\nअमृतस्याव्ययस्येव तृप्तः स्वप्स्याम्यहं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076003, "chapter_id": 2610, "verse_number": "१२-११५-११", "content_sanskrit": "कीदृशाः सन्निकर्षस्था भृत्याः सर्वगुणान्विताः।\nकीदृशैः किं कुलीनैर्वा सह यात्रा विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076004, "chapter_id": 2610, "verse_number": "१२-११५-१२", "content_sanskrit": "न ह्येको भृत्यरहितो राजा भवति रक्षिता।\nराज्यं चेदं जनः सर्वस्तत्कुलीनः प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076005, "chapter_id": 2610, "verse_number": "१२-११५-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076006, "chapter_id": 2610, "verse_number": "१२-११५-१३", "content_sanskrit": "न च प्रशास्तुं राज्यं हि शक्यमेकेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076007, "chapter_id": 2610, "verse_number": "१२-११५-१४", "content_sanskrit": "असहायवता तात नैवार्थाः केचिदप्युत।\nलब्धुं लब्धा ह्यपि सदा रक्षितुं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076008, "chapter_id": 2610, "verse_number": "१२-११५-१५", "content_sanskrit": "यस्य भृत्यजनः सर्वो ज्ञानविज्ञानकोविदः।\nहितैषी कुलजः स्निग्धः स राज्यफलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076009, "chapter_id": 2610, "verse_number": "१२-११५-१६", "content_sanskrit": "मन्त्रिणो यस्य कुलजा असंहार्याः सहोषिताः।\nनृपतेर्मतिमाप्सन्ते सत्पथज्ञानकोविदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076010, "chapter_id": 2610, "verse_number": "१२-११५-१७", "content_sanskrit": "अनागतविधातारः कालज्ञानविशारदाः।\nअतिक्रान्तमशोचन्तः स राज्यफलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076011, "chapter_id": 2610, "verse_number": "१२-११५-१८", "content_sanskrit": "समदुःखसुखा यस्य सहायाः प्रियकारिणः।\nअर्थचिन्तापराः सभ्याः स राज्यफलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076012, "chapter_id": 2610, "verse_number": "१२-११५-१९", "content_sanskrit": "यस्य नार्तो जनपदः सन्निकर्षगतः सदा।\nअक्षुद्रः सत्पथालम्बी स राजा राज्यभाग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076013, "chapter_id": 2610, "verse_number": "१२-११५-२०", "content_sanskrit": "कोशोऽक्षपटलं यस्य कोशवृद्धिकरैर्नरैः।\nआप्तैस्तुष्टैश्च पृष्टैश्च धार्यते स नृपोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076014, "chapter_id": 2610, "verse_number": "१२-११५-२१", "content_sanskrit": "कोष्ठागारमसंहार्यैराप्तैः संचयतत्परैः।\nपात्रभूतैरलुब्धैश्च पाल्यमानं गुणी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076015, "chapter_id": 2610, "verse_number": "१२-११५-२२", "content_sanskrit": "व्यवहारश्च नगरे यस्य धर्मफलोदयः।\nदृश्यते शङ्खलिखितः स धर्मफलभाङ् नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076016, "chapter_id": 2610, "verse_number": "१२-११५-२३", "content_sanskrit": "संगृहीतमनुष्यश्च यो राजा राजधर्मवित्।\nषङ्भागं परिगृह्णाति स धर्मफलमश्नुते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076017, "chapter_id": 2610, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चदशाधिकशततमोऽध्यायः॥ ११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]