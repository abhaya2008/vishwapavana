[{"id": 2150312, "chapter_id": 4260, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150313, "chapter_id": 4260, "verse_number": "१", "content_sanskrit": "चकार यत्नं द्रुपदः सुतायाः सर्वकर्मसु ।\nततो लेखादिषु तथा शिल्पेषु च परन्तप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150314, "chapter_id": 4260, "verse_number": "२", "content_sanskrit": "इष्वस्त्रेषु च राजेन्द्र द्रोणशिष्यो बभूव ह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150315, "chapter_id": 4260, "verse_number": "३", "content_sanskrit": "तस्य माता महाराज राजानं वरवर्णिनी ।\nचोदयामास भार्यार्थं कन्यायाः पुत्रवत् तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150316, "chapter_id": 4260, "verse_number": "४", "content_sanskrit": "ततस्तां पार्षतो दृष्ट्वा कन्यां सम्प्राप्तयौवनाम् ।\nस्त्रियं मत्वा ततश्चिन्तां प्रपेदे सह भार्यया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150317, "chapter_id": 4260, "verse_number": "५", "content_sanskrit": "कन्या ममेयं सम्प्राप्ता यौवनं शोकवर्धिनी ।\nमया प्रच्छादिता चैषा वचनाच्छूलपाणिनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150318, "chapter_id": 4260, "verse_number": "६", "content_sanskrit": "न तन्मिथ्या महाराज्ञि भविष्यति कथञ्चन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150319, "chapter_id": 4260, "verse_number": "", "content_sanskrit": "भार्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150320, "chapter_id": 4260, "verse_number": "७", "content_sanskrit": "त्रैलोक्यकर्ता कस्माद्धि वृथा वक्तुमिहार्हति ।\nयदि ते रोचते राजन् वक्ष्यामि शृणु मे वचः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150321, "chapter_id": 4260, "verse_number": "८", "content_sanskrit": "श्रुत्वेदानीं प्रपद्येथाः स्वां मतिं पृषतात्मज\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150322, "chapter_id": 4260, "verse_number": "९", "content_sanskrit": "क्रियतामद्य यत्नेन विधिवद् दारसङ्ग्रहः ।\nभविता तद्वचः सत्यमिति मे निश्चिता मतिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150323, "chapter_id": 4260, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150324, "chapter_id": 4260, "verse_number": "१०", "content_sanskrit": "ततस्तौ निश्चयं कृत्वा तस्मिन् कार्येऽथ दम्पती ।\nवरयाञ्चक्रतुः कन्यां दशार्णाधिपतेः सुताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150325, "chapter_id": 4260, "verse_number": "११", "content_sanskrit": "ततो राजा द्रुपदो राजसिंहः\nसर्वान् राज्ञः कुलतः सन्निशाम्य ।\nदाशार्णकस्य नृपतेस्तनूजां\nशिखण्डिने वरयामास कन्याम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150326, "chapter_id": 4260, "verse_number": "१२", "content_sanskrit": "हिरण्यवर्मेति नृपो योऽसौ दाशार्णकः स्मृतः ।\nस च प्रादान्महीपालः कन्यां तस्मै शिखण्डिने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150327, "chapter_id": 4260, "verse_number": "१३", "content_sanskrit": "स च राजा दशार्णेषु महानासीत् सुदुर्जयः ।\nहिरण्यवर्मा दुर्धर्षो महासेनो महाबलः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150328, "chapter_id": 4260, "verse_number": "१४", "content_sanskrit": "कृते विवाहे तु तदा सा कन्या राजसत्तम ।\nयौवनं समनुप्राप्ता सा च कन्या शिखण्डिनी\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150329, "chapter_id": 4260, "verse_number": "१५", "content_sanskrit": "कृतदारः शिखण्डी च काम्पिल्यं पुनरागमत् ।\nन च सा वेद तां कन्यां कञ्चित् कालं स्त्रियं किल\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150330, "chapter_id": 4260, "verse_number": "१६", "content_sanskrit": "यदा त्वेनामजानात् सा स्त्रियमेव नृपात्मजा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150331, "chapter_id": 4260, "verse_number": "१७", "content_sanskrit": "धात्रीणां च सखीनां च व्रीडमाना न्यवेदयत् ।\nकन्यां पाञ्चालराजस्य सुतां तां वै शिखण्डिनीम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150332, "chapter_id": 4260, "verse_number": "१८", "content_sanskrit": "ततस्ता राजशार्दूल धात्र्यो दाशार्णिकास्तदा ।\nजग्मुरार्तिं परां प्रेष्याः प्रेषयामासुरेव च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150333, "chapter_id": 4260, "verse_number": "१९", "content_sanskrit": "ततो दशार्णाधिपतेः प्रेष्याः सर्वा न्यवेदयन् ।\nविप्रलम्भं यथावृत्तं स च चुक्रोध पार्थिवः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150334, "chapter_id": 4260, "verse_number": "२०", "content_sanskrit": "शिखण्ड्यपि महाराज पुंवद् राजकुले तदा ।\nविजहार मुदा युक्तः स्त्रीत्वं नैवाभिरोचयन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150335, "chapter_id": 4260, "verse_number": "२१", "content_sanskrit": "ततः कतिपयाहस्सु तच्छ्रुत्वा भरतर्षभ ।\nहिरण्यवर्मा राजेन्द्र रोषादार्तिं जगाम ह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150336, "chapter_id": 4260, "verse_number": "२२", "content_sanskrit": "ततो दाशार्णको राजा तीव्रकोपसमन्वितः ।\nदूतं प्रस्थापयामास द्रुपदस्य निवेशनम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150337, "chapter_id": 4260, "verse_number": "२३", "content_sanskrit": "ततो द्रुपदमासाद्य दूतः काञ्चनवर्मणः ।\nएकस्त्वेकान्तमुत्सार्य रहो वचनमब्रवीत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150338, "chapter_id": 4260, "verse_number": "२४", "content_sanskrit": "दशार्णराजो राजंस्त्वामिदं वचनमब्रवीत् ।\nअभिषङ्गात् प्रकुपितो विप्रलब्धस्त्वयाऽनघ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150339, "chapter_id": 4260, "verse_number": "२५", "content_sanskrit": "अवमन्यसे मां नृपते नूनं दुर्मन्त्रितं तव ।\nयन्मां कन्यां स्वकन्यार्थे मोहाद् याचितवानसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150340, "chapter_id": 4260, "verse_number": "२६", "content_sanskrit": "तस्याद्य विप्रलम्भस्य फलं प्राप्नुहि दुर्मते ।\nएष त्वां सजनामात्यमुद्धरामि स्थिरो भव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150341, "chapter_id": 4260, "verse_number": "२७", "content_sanskrit": "अवमत्य च वीर्यं मे कुलं चारित्रमेव च ।\nविप्रलम्भस्त्वयाऽपूर्वो मनुष्येषु प्रवर्तितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150342, "chapter_id": 4260, "verse_number": "२८", "content_sanskrit": "कुरु सर्वाणि कार्याणि भुङ्क्ष्व भोगाननुत्तमान् ।\nअभियास्यामि शीघ्रं त्वां समुद्धर्तुं सबान्धवम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150343, "chapter_id": 4260, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकनवत्युत्तरशततमोऽध्यायः ॥१९१॥\nअम्बोपाख्यानपर्वणि एकविंशोऽध्यायः ॥२१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]