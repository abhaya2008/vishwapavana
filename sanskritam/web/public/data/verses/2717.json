[{"id": 2080741, "chapter_id": 2717, "verse_number": "१२-२२२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080742, "chapter_id": 2717, "verse_number": "१२-२२२-१", "content_sanskrit": "जनको नरदेवस्तु ज्ञापितः परमर्षिणा।\nपुनरेवानुपप्रच्छ सांपराये भवाभवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080743, "chapter_id": 2717, "verse_number": "१२-२२२-२x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080744, "chapter_id": 2717, "verse_number": "१२-२२२-२", "content_sanskrit": "भगवन्यदि न प्रेत्य संज्ञा भवति कस्यचित्।\nएवं सति किमज्ञानं ज्ञानं वा किं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080745, "chapter_id": 2717, "verse_number": "१२-२२२-३", "content_sanskrit": "सर्वमुच्छेदनिष्ठं स्यात्पश्य चैतद्द्विजोत्तम।\nअप्रमत्तः प्रमत्तो वा किं विशेषं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080746, "chapter_id": 2717, "verse_number": "१२-२२२-४", "content_sanskrit": "असंसर्गो हि भूतेषु संसर्गो वा विनाशिषु।\nकस्मै क्रियेत तत्वेन निश्चयः कोऽत्र तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080747, "chapter_id": 2717, "verse_number": "१२-२२२-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080748, "chapter_id": 2717, "verse_number": "१२-२२२-५", "content_sanskrit": "तमसा हि प्रतिच्छन्नं विभ्रान्तमिव चातुरम्।\nपुनः प्रशमयन्वाक्यैः कविः पञ्चशिखोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080749, "chapter_id": 2717, "verse_number": "१२-२२२-६", "content_sanskrit": "उच्छेदनिष्ठा नेहास्ति भा निष्ठा न विद्यते।\nअयं ह्यपि समाहारः शरीरेन्द्रियचेतसाम्।\nवर्तते पृथगन्योन्यमप्यपाश्रित्य कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080750, "chapter_id": 2717, "verse_number": "१२-२२२-७", "content_sanskrit": "धावतः पञ्च तेषां तु खं वायुर्ज्योतिरम्बु भूः।\nते स्वभावेन तिष्ठन्ति वियुज्यन्ते स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080751, "chapter_id": 2717, "verse_number": "१२-२२२-८", "content_sanskrit": "आकाशो वायुरूष्मा च स्नेहो यश्चापि पार्थिवः।\nएष पञ्चसमाहारः शरीरमपि नैकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080752, "chapter_id": 2717, "verse_number": "१२-२२२-९", "content_sanskrit": "`अहं वाच्यं द्विजानां यद्विशिष्टं बुद्धिरूपवत्।\nवाचामगोचरं नित्यं ज्ञेयमेवं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080753, "chapter_id": 2717, "verse_number": "१२-२२२-१०", "content_sanskrit": "ज्ञानं ज्ञेयं तथा ज्ञानं त्रिविधं ज्ञानमुच्यते।\nज्ञानमूष्मा च वायुश्च त्रिविधः कर्मसंग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080754, "chapter_id": 2717, "verse_number": "१२-२२२-११", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थाश्च स्वभावश्चेतना मनः।\nप्राणापानौ विकारश्च धातवश्चात्र निःसृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080755, "chapter_id": 2717, "verse_number": "१२-२२२-१२", "content_sanskrit": "`प्राणादयस्तथा स्पर्शा न संबाधगतास्तथा।\nपुत्राधीनं भविष्येत चिन्मात्रः स परः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080756, "chapter_id": 2717, "verse_number": "१२-२२२-१३", "content_sanskrit": "श्रवणं स्पर्शनं जिह्वा दृष्टिर्नासा तथैव च।\nइन्द्रियाणीति पञ्चैते चित्तपूर्वगमा गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080757, "chapter_id": 2717, "verse_number": "१२-२२२-१४", "content_sanskrit": "तत्र विज्ञानसंयुक्ता त्रिविधा चेतना ध्रुवा।\nसुखदुःखेति यामाहुरदुःखेत्यसुखेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080758, "chapter_id": 2717, "verse_number": "१२-२२२-१५", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धश्च मूर्तयः।\nएते ह्यामरणात्पञ्च षङ्गुणा ज्ञानसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080759, "chapter_id": 2717, "verse_number": "१२-२२२-१६", "content_sanskrit": "तेषु कर्मविसर्गश्च सर्वतत्वार्थनिश्चयः।\nतमाहुः परमं शुक्रं `पारे च रजसः प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080760, "chapter_id": 2717, "verse_number": "१२-२२२-१७", "content_sanskrit": "विरागाद्वर्तते तस्मिन्मतो रजसि नित्यगम्।\nतस्मिन्प्रसन्ने संपश्ये द्वुद्धिरित्यव्ययं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080761, "chapter_id": 2717, "verse_number": "१२-२२२-१८", "content_sanskrit": "इमं गुणसमाहारमात्मभावेन पश्यतः।\nअसम्यद्गर्शिनो दुःखमनन्तं नोपशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080762, "chapter_id": 2717, "verse_number": "१२-२२२-१९", "content_sanskrit": "`तस्मादेतेषु मेधावी न प्रसज्येत बुद्धिमान्।\nअनात्मेति च यद्दृष्टं तन्नाहं न ममेत्यपि।\nवर्तते किमधिष्ठाना प्रसक्ता दुःखसंततिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080763, "chapter_id": 2717, "verse_number": "१२-२२२-२०", "content_sanskrit": "यत्र सम्यङ्भनो नाम त्यागमात्रमनुत्तमम्।\nशृणु यत्तव मोक्षाय भाष्यमाणं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080764, "chapter_id": 2717, "verse_number": "१२-२२२-२१", "content_sanskrit": "त्याग एव हि सर्वेषां युक्तानामपि कर्मणाम्।\nनित्यदुःखविनीतानां श्लेषो दुःखवहो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080765, "chapter_id": 2717, "verse_number": "१२-२२२-२२", "content_sanskrit": "द्रव्यत्यागे तु कर्माणि भोगत्यागे व्रतान्यपि।\nसुखत्यागे तपोयोगं सर्वत्यागे समापना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080766, "chapter_id": 2717, "verse_number": "१२-२२२-२३", "content_sanskrit": "तस्य मार्गोऽयमद्वैधः सर्वत्यागस्य दर्शितः।\nविप्रहाणाय दुःखस्य दुर्गतिस्त्वन्यथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080767, "chapter_id": 2717, "verse_number": "१२-२२२-२४", "content_sanskrit": "`शेते जरामृत्युभयैर्विमुक्तः\nक्षीणे पुण्ये विगते च पापे।\nतपोनिमित्ते विगते च निष्ठे\nफले यथाऽऽकाशमलिङ्ग एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080768, "chapter_id": 2717, "verse_number": "१२-२२२-२५", "content_sanskrit": "पञ्चज्ञानेन्द्रियाण्युक्त्वा मनःषष्ठानि चेतसि।\nमनःषष्ठानि वक्ष्यामि पञ्चकर्मेन्द्रियाणि तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080769, "chapter_id": 2717, "verse_number": "१२-२२२-२६", "content_sanskrit": "हस्तौ कर्मेन्द्रियं ज्ञेयमथ पादौ गतीन्द्रियम्।\nप्रजनानन्दयोः शेफो निसर्गे पायुरिन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080770, "chapter_id": 2717, "verse_number": "१२-२२२-२७", "content_sanskrit": "वाक्च शब्दविशेषार्थं गतिं पञ्चान्वितां विदुः।\nएवमेकादशैतानि बुद्ध्या तूपहतं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080771, "chapter_id": 2717, "verse_number": "१२-२२२-२८", "content_sanskrit": "कर्णौ शब्दश्च चित्तं च त्रयः श्रवणसंग्रहे।\nतथा स्पर्शे तथा रूपे तथैव रसगन्धयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080772, "chapter_id": 2717, "verse_number": "१२-२२२-२९", "content_sanskrit": "एवं पञ्चत्रिका ह्येते गुणास्तदुपलब्धये।\nयेनायं त्रिविधो भावः पर्यायात्समुंपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080773, "chapter_id": 2717, "verse_number": "१२-२२२-३०", "content_sanskrit": "सात्विको राजसश्चापि तामसश्चापि ते त्रयः।\nत्रिविधा वेदना येषु प्रसूताः सर्वसाधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080774, "chapter_id": 2717, "verse_number": "१२-२२२-३१", "content_sanskrit": "प्रहर्षः प्रीतिरानन्दः सुखं संशान्तचित्तता।\nअकुतश्चित्कुतश्चिद्वा चिन्तितः सात्विको गुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080775, "chapter_id": 2717, "verse_number": "१२-२२२-३२", "content_sanskrit": "अतुष्टिः परितापश्च शोको लोभस्तथाऽक्षमा।\nलिङ्गानि रजसस्तानि दृश्यन्ते हेत्वहेतुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080776, "chapter_id": 2717, "verse_number": "१२-२२२-३३", "content_sanskrit": "अविवेकस्तथा मोहः प्रमादः स्वप्नतन्द्रिता।\nकथंचिदपि वर्तन्ते विविधास्तामसा गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080777, "chapter_id": 2717, "verse_number": "१२-२२२-३४", "content_sanskrit": "तत्र यत्प्रीतिसंयुक्तं काये मनसि वा भवेत्।\nवर्तते सात्विको भाव इत्यपेक्षेत तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080778, "chapter_id": 2717, "verse_number": "१२-२२२-३५", "content_sanskrit": "यत्तु सन्तापसंयुक्तमप्रीतिकरमात्मनः।\nप्रवृत्तं रज इत्येवं ततस्तदपि चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080779, "chapter_id": 2717, "verse_number": "१२-२२२-३६", "content_sanskrit": "अथ यन्मोहसंयुक्तं काये मनसि वा भवेत्।\nअप्रतर्क्यमविज्ञेयं तमस्तदुपधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080780, "chapter_id": 2717, "verse_number": "१२-२२२-३७", "content_sanskrit": "श्रोत्रं व्योमाश्रितं भूतं शब्दः श्रोत्रं समाश्रितः।\nनोभयं शब्दविज्ञाने विज्ञानस्तेतरस्य वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080781, "chapter_id": 2717, "verse_number": "१२-२२२-३८", "content_sanskrit": "एवं त्वक्चक्षुषी जिह्वा नासिका चेति पञ्चमी।\nस्पर्शे रूपे रसे गन्धे तानि चेतो मनश्च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080782, "chapter_id": 2717, "verse_number": "१२-२२२-३९", "content_sanskrit": "स्वकर्मयुगपद्भावो दशस्वेतेषु तिष्ठति।\nचित्तमेकादशं विद्धि बुद्धिर्द्वादशमी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080783, "chapter_id": 2717, "verse_number": "१२-२२२-४०", "content_sanskrit": "तेषामयुगपद्भाव उच्छेदो नास्ति तामसः।\nआस्थितो युगपद्भावे व्यवहारः स लौकिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080784, "chapter_id": 2717, "verse_number": "१२-२२२-४१", "content_sanskrit": "इन्द्रियाण्युपसृत्यापि दृष्ट्वा पूर्वं श्रुतागमात्।\nचिन्तयन्ननुपर्येति त्रिभिरेवान्वितो गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080785, "chapter_id": 2717, "verse_number": "१२-२२२-४२", "content_sanskrit": "यत्तमोपहतं चित्तमाशुसंचारमध्रुवम्।\nकरोत्युपरमं काये तदाहुस्तामसं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080786, "chapter_id": 2717, "verse_number": "१२-२२२-४३", "content_sanskrit": "यद्यदागमसंयुक्तं न कृच्छ्रादुपशाम्यति।\nअथ तत्राप्युपादत्ते तमो व्यक्तमिवानृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080787, "chapter_id": 2717, "verse_number": "१२-२२२-४४", "content_sanskrit": "एवमेव प्रसङ्ख्यातः स्वकर्मप्रत्ययो गुणः।\nकथंचिद्वर्तते सम्यक्केषांचिद्वा निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080788, "chapter_id": 2717, "verse_number": "१२-२२२-४५", "content_sanskrit": "`अहमित्येष वै भावो नान्यत्र प्रतितिष्ठति।\nयस्य भावो दृढो नित्यं स वै विद्वांस्तथेतरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080789, "chapter_id": 2717, "verse_number": "१२-२२२-४६", "content_sanskrit": "देहधर्मस्तथा नित्यं सर्वभूतेषु वै दृढः।\nएतेनैवानुमानेन त्याज्यो धर्मस्तथा ह्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080790, "chapter_id": 2717, "verse_number": "१२-२२२-४७", "content_sanskrit": "ज्ञानेन मुच्यते जन्तुर्धर्मात्मा ज्ञानवान्भवेत्।\nधर्मेण धार्यते लोकः सर्वं धर्मे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080791, "chapter_id": 2717, "verse_number": "१२-२२२-४८", "content_sanskrit": "सर्वार्थजनकश्चैव धर्मः सर्वस्य कारणम्।\nसर्वो हि दृश्यते लोके न सर्वार्थः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080792, "chapter_id": 2717, "verse_number": "१२-२२२-४९", "content_sanskrit": "सर्वत्यागे कृते तस्मात्परमात्मा प्रसीदति।\nव्यक्तादव्यक्तमतुलं लोकेषु परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080793, "chapter_id": 2717, "verse_number": "१२-२२२-५०", "content_sanskrit": "एतदाहुः समाहारं क्षेत्रमध्यात्मचिन्तकाः।\nस्थितो मनसि यो भावः स वै क्षेत्रज्ञ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080794, "chapter_id": 2717, "verse_number": "१२-२२२-५१", "content_sanskrit": "एवं सति क उच्छेदः शाश्वतो वा कथं भवेत्।\nस्वभावाद्वर्तमानेषु सर्वभूतेषु हेतुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2080795, "chapter_id": 2717, "verse_number": "१२-२२२-५२", "content_sanskrit": "यथार्णवगता नद्यो व्यक्तीर्जहति नाम च।\nनतु स्वतां नियच्छन्ति तादृशः सत्वसंक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2080796, "chapter_id": 2717, "verse_number": "१२-२२२-५३", "content_sanskrit": "एवं सति कुतः संज्ञा प्रेत्यभावे पुनर्भवेत्।\nप्रतिसंमिश्रिते जीवे गृह्यमाणे च सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2080797, "chapter_id": 2717, "verse_number": "१२-२२२-५४", "content_sanskrit": "इमां च यो वेद विमोक्षबुद्धि\nमात्मानमन्विच्छति चाप्रमत्तः।\nन लिप्यते कर्मफलैरनिष्टैः\nपत्रं बिसस्येव जलेन सिक्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2080798, "chapter_id": 2717, "verse_number": "१२-२२२-५५", "content_sanskrit": "दृढैर्हि पाशैर्बहुभिर्विमुक्तः\nप्रजानिमित्तैरपि दैवतैश्च।\nयदा ह्यसौ सुखदुःखे जहाति\nमुक्तस्तदाग्र्यां गतिमेत्यलिङ्गः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2080799, "chapter_id": 2717, "verse_number": "१२-२२२-५६", "content_sanskrit": "श्रुतिप्रमाणागममङ्गलैश्च\nशेते जरामृत्युभयादभीतः।\nक्षीणे च पुण्ये विगते च पापे\nततो निमित्ते च फले विनष्टे।\nअलेपमाकाशमलिङ्गमेव\nमास्थाय पश्यन्ति महत्यसक्ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2080800, "chapter_id": 2717, "verse_number": "१२-२२२-५७", "content_sanskrit": "यथोर्णनाभिः परिवर्तमान\nस्तन्तुक्षये तिष्ठति पात्यमानः।\nतथा विमुक्तः प्रजहाति दुःखं\nबिध्वंसते लोष्ठ इवाद्रिमृच्छन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2080801, "chapter_id": 2717, "verse_number": "१२-२२२-५८", "content_sanskrit": "यथा रुरुः शृङ्गमथो पुराणं\nहित्वा त्वचं वाऽप्युरगो यथा च।\nविहाय गच्छत्यनवेक्षमाण\nस्तथा विमुक्तो विजहाति दुःखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2080802, "chapter_id": 2717, "verse_number": "१२-२२२-५९", "content_sanskrit": "द्रुमं यथावाऽप्युदकै पतन्त\nमुत्सृज्य पक्षी निपतत्यसक्तः।\nतथा ह्यसौ सुखदुःखे विहाय\nमुक्तः पराद्धर्यां गतिमेत्यलिङ्गः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2080803, "chapter_id": 2717, "verse_number": "१२-२२२-६०", "content_sanskrit": "`इमान्स्वलोकाननुपश्य सर्वा\nन्व्रजन्यथाऽऽकाशमिवाप्नुकामः।\nइमां हि गाथां प्रलपन्यथाऽस्ति\nसमस्तसङ्कल्पविशेषमुक्तः।\nअहं हि सर्वं किल सर्वभावे\nह्यहं तदन्तर्ह्यहमेव भोक्ता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2080804, "chapter_id": 2717, "verse_number": "१२-२२२-६१", "content_sanskrit": "अपिच भवति मैथिलेन गीतं\nनगरमुपाहितमग्निनाऽभिवीक्ष्य।\nन खलु मम तुषोऽपि दह्यतेऽत्र\nस्वयमिदमाह किल स्म भूमिपालः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2080805, "chapter_id": 2717, "verse_number": "१२-२२२-६२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2080806, "chapter_id": 2717, "verse_number": "१२-२२२-६२", "content_sanskrit": "इदममृतपदं विदेहराजा\nस्वयमिह पञ्चशिखेन भाष्यमाणम्।\nनिखिलमभिसमीक्ष्य निश्चितार्थः\nपरमसुखी विजहार वीतशोकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2080807, "chapter_id": 2717, "verse_number": "१२-२२२-६३", "content_sanskrit": "इमं हि यः पठति विमोक्षनिश्चयं\nमहीपते सततमवेक्षते तथा।\nउपद्रवान्नानुभवत्यदुःखितः\nप्रमुच्यते कपिलमिवैत्य मैथिलः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2080808, "chapter_id": 2717, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोश्रधर्मपर्वणि द्वाविंशत्यधिकद्विशततमोऽध्यायः॥ २२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]