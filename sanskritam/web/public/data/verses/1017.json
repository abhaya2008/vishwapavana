[{"id": 2001253, "chapter_id": 1017, "verse_number": "१-१८-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001254, "chapter_id": 1017, "verse_number": "१-१८-१", "content_sanskrit": "ततोऽभ्रशिखराकारैर्गिरिशृङ्गैरलंकृतम्।\nमन्दरं पर्वतवरं लताजालसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001255, "chapter_id": 1017, "verse_number": "१-१८-२", "content_sanskrit": "नानाविहंगसंघुष्टं नानादंष्ट्रिसमाकुलम्।\nकिंनरैरप्सरोभिश्च देवैरपि च सेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001256, "chapter_id": 1017, "verse_number": "१-१८-३", "content_sanskrit": "एकादश सहस्राणि योजनानां समुच्छ्रितम्।\nअधोभूमेः सहस्रेषु तावत्स्वेव प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001257, "chapter_id": 1017, "verse_number": "१-१८-४", "content_sanskrit": "तमुद्धर्तुमशक्ता वै सर्वे देवगणास्तदा।\nविष्णुमासीनमभ्येत्य ब्रह्माणं चेदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001258, "chapter_id": 1017, "verse_number": "१-१८-५", "content_sanskrit": "भवन्तावत्र कुरुतां बुद्धिं नैःश्रेयसीं पराम्।\nमन्दरोद्धरणे यत्नः क्रियतां च हिताय नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001259, "chapter_id": 1017, "verse_number": "१-१८-६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001260, "chapter_id": 1017, "verse_number": "१-१८-६", "content_sanskrit": "तथेति चाब्रवीद्विष्णुर्ब्रह्मणा सह भार्गव।\nअचोदयदमेयात्मा फणीन्द्रं पद्मलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001261, "chapter_id": 1017, "verse_number": "१-१८-७", "content_sanskrit": "ततोऽनन्तः समुत्थाय ब्रह्मणा परिचोदितः।\nनारायणेन चाप्युक्तस्तस्मिन्कर्मणि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001262, "chapter_id": 1017, "verse_number": "१-१८-८", "content_sanskrit": "अथ पर्वतराजानं तमनन्तो महाबलः।\nउज्जहार बलाद्ब्रह्मन्सवनं सवनौकसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001263, "chapter_id": 1017, "verse_number": "१-१८-९", "content_sanskrit": "ततस्तेन सुराः सार्धं समुद्रमुपतस्थिरे।\nतमूचुरमृतस्यार्थे निर्मथिष्यामहे जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001264, "chapter_id": 1017, "verse_number": "१-१८-१०", "content_sanskrit": "अपांपतिरथोवाच ममाप्यंशो भवेत्ततः।\nसोढाऽस्मि विपुलं मर्दं मन्दरभ्रमणादिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001265, "chapter_id": 1017, "verse_number": "१-१८-११", "content_sanskrit": "ऊचुश्च कूर्मराजानमकूपारे सुरासुराः।\nअधिष्ठानं गिरेरस्य भवान्भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001266, "chapter_id": 1017, "verse_number": "१-१८-१२", "content_sanskrit": "कूर्मेण तु तथेत्युक्त्वा पृष्ठमस्य समर्पितम्।\nतं शैलं तस्य पृष्ठस्थं वज्रेणेन्द्रोऽभ्यपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001267, "chapter_id": 1017, "verse_number": "१-१८-१३", "content_sanskrit": "मन्थानं मन्दरं कृत्वा तथा योक्त्रं च वासुकिम्।\nदेवा मथितुमारब्धाः समुद्रं निधिमम्भसाम्।\nअमृतार्थे पुरा ब्रह्मस्तथैवासुरदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001268, "chapter_id": 1017, "verse_number": "१-१८-१४", "content_sanskrit": "एकमन्तमुपाश्लिष्टा नागराज्ञो महासुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001269, "chapter_id": 1017, "verse_number": "१-१८-१५", "content_sanskrit": "विबुधाः सहिताः सर्वे यतः पुच्छं ततः स्थिताः।\nअनन्तो भगवान्देवो यतो नारायणः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001270, "chapter_id": 1017, "verse_number": "१-१८-१६", "content_sanskrit": "वासुकेरग्रमाश्लिष्टा नागराज्ञो महासुराः।\nशिर उत्क्षिप्य नागस्य पुनः पुनरवाक्षिपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001271, "chapter_id": 1017, "verse_number": "१-१८-१७", "content_sanskrit": "वासुकेरथ नागस्य सहसा क्षिप्यतोऽसुरैः।\nसधूमाः सार्चिषो वाता निष्पेतुरसकृन्मुखात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001272, "chapter_id": 1017, "verse_number": "१-१८-१८", "content_sanskrit": "वासुकेर्मथ्यमानस्य निःसृतेन विषेण च।\nअभवन्मिश्रितं तोयं तदा भार्गवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001273, "chapter_id": 1017, "verse_number": "१-१८-१९", "content_sanskrit": "मथनान्मन्दरेणाथ देवदानवबाहुभिः।\nविषं तीक्ष्णं समुद्भूतं हालाहलमिति श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001274, "chapter_id": 1017, "verse_number": "१-१८-२०", "content_sanskrit": "देवाश्च दानवाश्चैव दग्धाश्चैव विषेण ह।\nअपाक्रामंस्ततो भीता विषादमगमंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001275, "chapter_id": 1017, "verse_number": "१-१८-२१", "content_sanskrit": "ब्रह्माणमब्रुवन्देवाः समेत्य मुनिपुंगवैः।\nमथ्यमानेऽमृते जातं विषं कालानलप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001276, "chapter_id": 1017, "verse_number": "१-१८-२२", "content_sanskrit": "तेनैव तापिता लोकास्तस्य प्रतिकुरुष्वह।\nएवमुक्तस्तदा ब्रह्मा दध्यौ लोकेश्वरं हरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001277, "chapter_id": 1017, "verse_number": "१-१८-२३", "content_sanskrit": "त्र्यक्षं त्रिशूलिनं रुद्रे देवदेवमुमापतिम्।\nतदाऽथ चिन्तितो देवस्तज्ज्ञात्वा द्रुतमाययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001278, "chapter_id": 1017, "verse_number": "१-१८-२४", "content_sanskrit": "तस्याथ देवस्तत्सर्वमाचचक्षे प्रजापतिः।\nतच्छ्रुत्वा दवेदेवेशो लोकस्यास्य हितेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001279, "chapter_id": 1017, "verse_number": "१-१८-२५", "content_sanskrit": "अपिबत्तद्विषं रुद्रः कालानलसमप्रभम्।\nकण्ठे स्थापितवान्देवो लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001280, "chapter_id": 1017, "verse_number": "१-१८-२६", "content_sanskrit": "यस्मात्तु नीलता कण्ठे नीलकण्ठस्ततः स्मृतः।\nपीतमात्रे विषे तत्र रुद्रेणामिततेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001281, "chapter_id": 1017, "verse_number": "१-१८-२७", "content_sanskrit": "देवाः प्रीताः पुनर्जग्मुश्चक्रुर्वै कर्म तत्तथा।\nमथ्यमानेऽमृतस्यार्थे भूयो वै देवदानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001282, "chapter_id": 1017, "verse_number": "१-१८-२८", "content_sanskrit": "वासुकेरथ नागस्य सहसा क्षिप्यतोऽसुरैः।\nसधूमाः सार्चिषो वाता निष्पेतुरसकृन्मुखात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001283, "chapter_id": 1017, "verse_number": "१-१८-२९", "content_sanskrit": "ते धूमसङ्घाः संभूता मेघसङ्घाः सविद्युतः।\nअभ्यवर्षन्सुरगणाञ्श्रमसंतापकर्शितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001284, "chapter_id": 1017, "verse_number": "१-१८-३०", "content_sanskrit": "तस्माच्च गिरिकूटाग्रात्प्रच्युताः पुष्पवृष्टयः।\nसुरासुरगणान्सर्वान्समन्तात्समवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001285, "chapter_id": 1017, "verse_number": "१-१८-३१", "content_sanskrit": "बभूवात्र महान्नादो महामेघरवोपमः।\nउदधेर्मथ्यमानस्य मन्दरेण सुरासुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001286, "chapter_id": 1017, "verse_number": "१-१८-३२", "content_sanskrit": "तत्र नानाजलचरा विनिष्पिष्टा महाद्रिणा।\nविलयं समुपाजग्मुः शतशो लवणाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001287, "chapter_id": 1017, "verse_number": "१-१८-३३", "content_sanskrit": "वारुणानि च भूतानि विविधानि महीधरः।\nपातालतलवासीनि विलयं समुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001288, "chapter_id": 1017, "verse_number": "१-१८-३४", "content_sanskrit": "तस्मिंश्च भ्राम्यमाणेऽद्रौ संघृष्यन्तः परस्परम्।\nन्यपतन्पतगोपेताः पर्वताग्रान्महाद्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001289, "chapter_id": 1017, "verse_number": "१-१८-३५", "content_sanskrit": "तेषां संघर्षजश्चाग्निरर्चिर्भिः प्रज्वलन्मुहुः।\nविद्युद्भिरिव नीलाभ्रमावृणोन्मन्दरं गिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2001290, "chapter_id": 1017, "verse_number": "१-१८-३६", "content_sanskrit": "ददाह कुञ्जरांस्तत्र सिंहांश्चैव विनिर्गतान्।\nविगतासूनि सर्वाणि सत्त्वानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2001291, "chapter_id": 1017, "verse_number": "१-१८-३७", "content_sanskrit": "तमग्निममरश्रेष्ठः प्रदहन्तमितस्ततः।\nवारिणा मेघजेनेन्द्रः शमयामास सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2001292, "chapter_id": 1017, "verse_number": "१-१८-३८", "content_sanskrit": "ततो नानाविधास्तत्र सुस्रुवुः सागराम्भसि।\nमहाद्रुमाणां निर्यासा बहवश्चौषधीरसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2001293, "chapter_id": 1017, "verse_number": "१-१८-३९", "content_sanskrit": "तेषाममृतवीर्याणां रसानां पयसैव च।\nअमरत्वं सुरा जग्मुः काञ्चनस्य च निःस्रवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2001294, "chapter_id": 1017, "verse_number": "१-१८-४०", "content_sanskrit": "ततस्तस्य समुद्रस्य तञ्जातमुदकं पयः।\nरसोत्तमैर्विमिश्रं च ततः क्षीरादभूद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2001295, "chapter_id": 1017, "verse_number": "१-१८-४१", "content_sanskrit": "ततो ब्रह्माणमासीनं देवा वरदमब्रुवन्।\nश्रान्ताः स्म सुभृशं ब्रह्मन्नोद्भवत्यमृतं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2001296, "chapter_id": 1017, "verse_number": "१-१८-४२", "content_sanskrit": "ऋते नारायणं देवं सर्वेऽन्ये देवदानवाः।\nचिरारब्धमिदं चापि सागरस्यापि मन्थनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2001297, "chapter_id": 1017, "verse_number": "१-१८-४३", "content_sanskrit": "ग्लानिरस्मान्समाविष्टा न चात्रामृतमत्थितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2001298, "chapter_id": 1017, "verse_number": "१-१८-४३x", "content_sanskrit": "सौतिरुवाच।\nदेवानां वचनं श्रुत्वा ब्रह्मा लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2001299, "chapter_id": 1017, "verse_number": "१-१८-४४", "content_sanskrit": "ततो नारायणं देवं वचनं चेदमब्रवीत्।\nविधत्स्वैषां बलं विष्णो भवानत्र परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2001300, "chapter_id": 1017, "verse_number": "१-१८-४५x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2001301, "chapter_id": 1017, "verse_number": "१-१८-४५", "content_sanskrit": "बलं ददामि सर्वेषां कर्मैतद्ये समास्थिताः।\nक्षोभ्यतां कलशः सर्वैमन्दरः परिवर्त्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2001302, "chapter_id": 1017, "verse_number": "१-१८-४६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2001303, "chapter_id": 1017, "verse_number": "१-१८-४६", "content_sanskrit": "नारायणवचः श्रुत्वा बलिनस्ते महोदधेः।\nतत्पयः सहिता भूयश्चक्रिरे भृशमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2001304, "chapter_id": 1017, "verse_number": "१-१८-४७", "content_sanskrit": "तत्र पूर्वं विषं जातं तद्ब्रह्मवचनाच्छिवः।\nप्राग्रसल्लोकरक्षार्थं ततो ज्येष्ठा समुत्थिता।\nकृष्णरूपधरा देवी सर्वाभरणभूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2001305, "chapter_id": 1017, "verse_number": "१-१८-४८", "content_sanskrit": "ततः शतसहस्रांशुर्मथ्यमानात्तु सागरात्।\nप्रसन्नात्मा समुत्पन्नः सोमः शीतांशुरुज्ज्वलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2001306, "chapter_id": 1017, "verse_number": "१-१८-४९", "content_sanskrit": "श्रीरनन्तरमुत्पन्ना घृतात्पाण्डुरवासिनी।\nसुरा देवी समुत्पन्ना तुरगः पाण्डुरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2001307, "chapter_id": 1017, "verse_number": "१-१८-५०", "content_sanskrit": "कौस्तुभस्तु मणिर्दिव्य उत्पन्नो घृतसंभवः।\nमरीचिविकचः श्रीमान्नारायणउरोगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2001308, "chapter_id": 1017, "verse_number": "१-१८-५१", "content_sanskrit": "श्रीः सुरा चैव सोमश्च तुरगश्च मनोजवः।\nपारिजातश्च तत्रैव सुरभिश्च महामुने।\nजज्ञाते तौ तदा ब्रह्मन्सर्वकामफलप्रदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2001309, "chapter_id": 1017, "verse_number": "१-१८-५२", "content_sanskrit": "ततो जज्ञे महाकायश्चतुर्दन्तो महागजः।\nकपिला कामवृक्षश्च कौस्तुभश्चाप्सरोगणः।\nयतो देवास्ततो जग्मुरादित्यपथमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2001310, "chapter_id": 1017, "verse_number": "१-१८-५३", "content_sanskrit": "धन्वन्तरिस्ततो देवो वपुष्मानुदतिष्ठत।\nश्वेतं कमण्डलुं बिभ्रदमृतं यत्र तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2001311, "chapter_id": 1017, "verse_number": "१-१८-५४", "content_sanskrit": "एतदत्यद्भुतं दृष्ट्वा दानवानां समुत्थितः।\nअमृतार्थे महान्नादो ममेदमिति जल्पताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2001312, "chapter_id": 1017, "verse_number": "१-१८-५५", "content_sanskrit": "ततो नारायणो मायां मोहिनीं समुपाश्रितः।\nस्त्रीरूपमद्भुतं कृत्वा दानवानभिसंश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2001313, "chapter_id": 1017, "verse_number": "१-१८-५६", "content_sanskrit": "ततस्तदमृतं तस्यै ददुस्ते मूढचेतसः।\nस्त्रियै दानवदैतेयाः सर्वे तद्गतमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2001314, "chapter_id": 1017, "verse_number": "१-१८-५७", "content_sanskrit": "सा तु नारायणी माया धारयन्ती कमण्डलुम्।\nआस्यमानेषु दैत्येषु पङ्क्त्या च प्रति दानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2001315, "chapter_id": 1017, "verse_number": "१-१८-५८", "content_sanskrit": "देवानपाययद्देवी न दैत्यांस्ते च चुक्रुशुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2001316, "chapter_id": 1017, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाबारते आदिपर्वणि आस्तीकपर्वणि अष्टादशोऽध्यायः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]