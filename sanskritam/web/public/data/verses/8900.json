[{"id": 40003891, "chapter_id": 8900, "verse_number": "1", "content_sanskrit": "तस्मिन्स्तु पुरुषव्याघ्रे विनिर्याति कृताञ्जलौ। आर्तशब्दोऽहि सञ्जज्ञे स्त्रीणामन्त:पुरे महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40003892, "chapter_id": 8900, "verse_number": "2", "content_sanskrit": "अनाथस्य जनस्यास्य दुर्बलस्य तपस्विनः। यो गतिश्शरणं चासीत्स नाथः क्व नु गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40003893, "chapter_id": 8900, "verse_number": "3", "content_sanskrit": "न क्रुध्यत्यभिशप्तोऽपि क्रोधनीयानि वर्जयन्। क्रुद्धान्प्रसादयन्सर्वान् समदुःखः क्व गज्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40003894, "chapter_id": 8900, "verse_number": "4", "content_sanskrit": "कौशल्यायां महातेजा यथा मातरि वर्तते। तथा यो वर्ततेऽस्मासु महात्मा क्व नु गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40003895, "chapter_id": 8900, "verse_number": "5", "content_sanskrit": "कैकेय्या क्लिश्यमानेन राज्ञा सञ्चोदितो वनम्। परित्राता जनस्यास्य जगतः क्व नु गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40003896, "chapter_id": 8900, "verse_number": "6", "content_sanskrit": "अहो निश्चेतनो राजा जीवलोकस्य सम्प्रियम्। धर्म्यं सत्यव्रतं रामं वनवासे प्रवत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40003897, "chapter_id": 8900, "verse_number": "7", "content_sanskrit": "इति सर्वा महिष्यस्ता विवत्सा इव धेनवः। रुरुदुश्चैव दुःखार्ताः सस्वरं च विचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40003898, "chapter_id": 8900, "verse_number": "8", "content_sanskrit": "स तमन्तः पुरे घोरमार्तशब्दं महीपतिः। पुत्रशोकाभिसन्तप्तः श्रुत्वा चासीत्सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40003899, "chapter_id": 8900, "verse_number": "9", "content_sanskrit": "नाग्निहोत्राण्यहूयन्त नापचन् गृहमेधिनः अकुर्वन्न प्रजाः कार्यं सूर्यश्चान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40003900, "chapter_id": 8900, "verse_number": "10", "content_sanskrit": "व्यसृजन् कबलान्नागा गावो वत्सान्न पाययन्। पुत्रं प्रथमजं लब्ध्वा जननी नाभ्यनन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40003901, "chapter_id": 8900, "verse_number": "11", "content_sanskrit": "त्रिशङ्कुर्लोहिताङ्गश्च बृहस्पतिबुधावपि। दारुणा स्सोममभ्येत्य ग्रहास्सर्वे व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40003902, "chapter_id": 8900, "verse_number": "12", "content_sanskrit": "नक्षत्राणि गतार्चींषि ग्रहाश्च गततेजसः। विशाखास्तु सधूमाश्च नभसि प्रचकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40003903, "chapter_id": 8900, "verse_number": "13", "content_sanskrit": "कालिकानिलवेगेन महोदधिरिवोत्थितः। रामे वनं प्रव्रजिते नगरं प्रचचाल तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40003904, "chapter_id": 8900, "verse_number": "14", "content_sanskrit": "दिशः पर्याकुलास्सर्वा स्तिमिरेणेव संवृताः। न ग्रहो नापि नक्षत्रं प्रचकाशे नकिञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40003905, "chapter_id": 8900, "verse_number": "15", "content_sanskrit": "अकस्मान्नागरस्सर्वो जनो दैन्यमुपागमत्। आहारे वा विहारे वा न कश्चिदकरोन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40003906, "chapter_id": 8900, "verse_number": "16", "content_sanskrit": "शोकपर्यायसन्तप्त स्सततं दीर्घमुच्छवसन्। अयोध्यायां जनस्सर्व श्शुशोच जगतीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40003907, "chapter_id": 8900, "verse_number": "17", "content_sanskrit": "बाष्पपर्याकुलमुखो राजमार्गगतो जनः। न हृष्टो लक्ष्यते कश्चित्सर्व श्शोकपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40003908, "chapter_id": 8900, "verse_number": "18", "content_sanskrit": "न वाति पवन श्शीतो न शशी सौम्यदर्शनः। न सूर्यस्तपते लोकं सर्वं पर्याकुलं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40003909, "chapter_id": 8900, "verse_number": "19", "content_sanskrit": "अनर्थिनस्सुताः स्त्रीणां भर्तारो भ्रातरस्तथा। सर्वे सर्वं परित्यज्य राममेवान्वचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40003910, "chapter_id": 8900, "verse_number": "20", "content_sanskrit": "ये तु रामस्य सुहृद स्सर्वे ते मूढचेतसः। शोकभारेण चाक्रान्ता श्शयनं न जहुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40003911, "chapter_id": 8900, "verse_number": "21", "content_sanskrit": "ततस्त्वयोध्या रहिता महात्मना पुरन्दरेणेव मही सपर्वता। चचाल घोरं भयशोकपीडिता सनागयोधाश्वगणा ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]