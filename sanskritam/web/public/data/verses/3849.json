[{"id": 2131753, "chapter_id": 3849, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131754, "chapter_id": 3849, "verse_number": "१", "content_sanskrit": "स भीमसेनस्तेजस्वी तथा सर्पवशं गतः ।\nचिन्तयामास सर्पस्य वीर्यमत्यद्भुतं महत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131755, "chapter_id": 3849, "verse_number": "२", "content_sanskrit": "उवाच च महासर्पं कामया ब्रूहि पन्नग ।\nकस्त्वं भो भुजगश्रेष्ठ किं मया च करिष्यसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131756, "chapter_id": 3849, "verse_number": "३", "content_sanskrit": "पाण्डवो भीमसेनोऽहं धर्मराजादनन्तरः ।\nनागायुतसमप्राणस्त्वया नीतः कथं वशम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131757, "chapter_id": 3849, "verse_number": "४", "content_sanskrit": "सिंहाः केसरिणो व्याघ्रा महिषा वारणास्तथा ।\nसमागताश्च बहुशो निहताश्च मया युधि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131758, "chapter_id": 3849, "verse_number": "५", "content_sanskrit": "राक्षसाश्च पिशाचाश्च पन्नगाश्च महाबलाः ।\nभुजवेगमशक्ता मे सोढुं पन्नगसत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131759, "chapter_id": 3849, "verse_number": "६", "content_sanskrit": "किं नु विद्याबलं किं नु वरदानमथो तव ।\nउद्योगमपि कुर्वाणो वशगोऽस्मि कृतस्त्वया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131760, "chapter_id": 3849, "verse_number": "७", "content_sanskrit": "असत्यो विक्रमो नॄणामिति मे धीयते मतिः ।\nयथेदं मे त्वया नाग बलं प्रतिहतं महत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131761, "chapter_id": 3849, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131762, "chapter_id": 3849, "verse_number": "८", "content_sanskrit": "इत्येवंवादिनं वीरं भीममक्लिष्टकारिणम् ।\nभोगेन महता गृह्य समन्तात् पर्यवेष्टयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131763, "chapter_id": 3849, "verse_number": "९", "content_sanskrit": "निगृह्यैनं महाबाहुं ततः स भुजगस्तदा ।\nविमुच्यास्य भुजौ पीनाविदं वचनमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131764, "chapter_id": 3849, "verse_number": "१०", "content_sanskrit": "दिष्टस्त्वं क्षुधितस्याद्य देवैर्भक्षो महाभुज ।\nदिष्ट्या कालस्य महतः प्रियाः प्राणा हि देहिनाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131765, "chapter_id": 3849, "verse_number": "११", "content_sanskrit": "यथा त्विदं मया प्राप्तं सर्परूपमरिन्दम ।\nतथाऽवश्यं मया ख्याप्यं तवाद्य शृणु सत्तम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131766, "chapter_id": 3849, "verse_number": "१२", "content_sanskrit": "इमामवस्थां सम्प्राप्तो ह्यहं कोपान्मनीषिणाम् ।\nशापस्यान्तं परिप्रेप्सुः सर्वं तत् कथयामि ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131767, "chapter_id": 3849, "verse_number": "१३", "content_sanskrit": "नहुषो नाम राजर्षिर्व्यक्तं ते श्रोत्रमागतः ।\nतवैव पूर्वः पूर्वेषामायोर्वंशधरः सुतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131768, "chapter_id": 3849, "verse_number": "१४", "content_sanskrit": "तपोभिः क्रतुभिश्चैव विद्ययाऽभिजनेन च ।\nत्रैलोक्यैश्वर्यमतुलं प्राप्तं मे विक्रमेण च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131769, "chapter_id": 3849, "verse_number": "१५", "content_sanskrit": "अथ सर्वनृपोन्माथी मदो मां समुपाविशत् ।\nसहस्रं मुनिमुख्यानामुवाह शिबिकां मम\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131770, "chapter_id": 3849, "verse_number": "१६", "content_sanskrit": "ततो विभ्रंशितश्चाहमगस्त्येन महात्मना ।\nइमामवस्थां सम्प्राप्तः पश्य दैवमिदं मम\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131771, "chapter_id": 3849, "verse_number": "१७", "content_sanskrit": "न दैवं प्रज्ञया तात न बलोत्साहशक्तिभिः ।\nन सहायबलैश्चापि कश्चिदप्यतिवर्तते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131772, "chapter_id": 3849, "verse_number": "१८", "content_sanskrit": "यथा प्राज्ञाश्च शूराश्च दृश्यन्ते दुःखजीविनः ।\nभीरुमूर्खाश्च सुखिनस्तस्माद् दैवं हि कारणम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131773, "chapter_id": 3849, "verse_number": "१९", "content_sanskrit": "सोऽहं शापादगस्त्यस्य ब्राह्मणानवमन्य च ।\nइमामवस्थामापन्नः पश्य दैवमिदं मम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131774, "chapter_id": 3849, "verse_number": "२०", "content_sanskrit": "त्वां चेदवध्यं दायादमतीव प्रियदर्शनम् ।\nअहमद्योपयोक्ष्यामि विधानं पश्य यादृशम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131775, "chapter_id": 3849, "verse_number": "२१", "content_sanskrit": "न हि मे मुच्यते कश्चित् कथञ्चित् प्रग्रहं गतः ।\nगजो वा महिषो वाऽपि षष्ठे काले नरोत्तम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131776, "chapter_id": 3849, "verse_number": "२२", "content_sanskrit": "नासि केवलसर्पेण तिर्यग्योनिषु वर्तता ।\nगृहीतः कौरवश्रेष्ठ वरदानमिदं मम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131777, "chapter_id": 3849, "verse_number": "२३", "content_sanskrit": "पतता हि विमानाग्र्यान्मया शक्रासनाद् द्रुतम् ।\nकुरु शापान्तमित्युक्तो भगवान् मुनिसत्तमः ।\nस मामुवाच तेजस्वी कृपयाऽभिपरिप्लुतः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131778, "chapter_id": 3849, "verse_number": "", "content_sanskrit": "यस्त्वया वेष्टितो राजन् मोहमेति महाबलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131779, "chapter_id": 3849, "verse_number": "२४", "content_sanskrit": "मोक्षस्ते भविता राजन् कस्माच्चित् कालपर्ययात् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131780, "chapter_id": 3849, "verse_number": "२५", "content_sanskrit": "ततोऽस्मि पतितो भूमौ न च मामजहात् स्मृतिः ।\nस्मार्तमस्ति पुराणं मे यथैवाधिगतं तथा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131781, "chapter_id": 3849, "verse_number": "२६", "content_sanskrit": "यस्तु ते व्याहृतान् प्रश्नान् प्रतिब्रूयाद् विभागवित् ।\nस त्वां मोक्षयिता शापादिति मामब्रवीदृषिः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131782, "chapter_id": 3849, "verse_number": "२७", "content_sanskrit": "गृहीतस्य त्वया राजन् प्राणिनोऽपि बलीयसः ।\nसत्त्वभ्रंशोऽधिकस्यापि सर्वस्याशु भविष्यति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131783, "chapter_id": 3849, "verse_number": "समाप्तिः", "content_sanskrit": "इति चाप्यहमश्रौषं वचस्तेषां दयावताम् ।\nमयि सञ्जातहार्दानामथ तेऽन्तर्हिता द्विजाः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131784, "chapter_id": 3849, "verse_number": "२९", "content_sanskrit": "सोऽहं परमदुष्कर्मा वसामि निरयेऽशुचौ ।\nसर्पयोनिमिमां प्राप्य कालाकाङ्क्षी महाद्युते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131785, "chapter_id": 3849, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131786, "chapter_id": 3849, "verse_number": "३०", "content_sanskrit": "तमुवाच महाबाहुर्भीमसेनो भुजङ्गमम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131787, "chapter_id": 3849, "verse_number": "३१", "content_sanskrit": "न च कुप्ये महासर्प न चात्मानं विगर्हये\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131788, "chapter_id": 3849, "verse_number": "३२", "content_sanskrit": "यस्मादभावी भावी वा मनुष्यः सुखदुःखयोः ।\nआगमे यदि वाऽपाये न तत्र ग्लपयेन्मनः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131789, "chapter_id": 3849, "verse_number": "३३", "content_sanskrit": "दैवं पुरुषकारेण को वञ्चयितुमर्हति ।\nदैवमेव परं मन्ये पुरुषार्थो निरर्थकः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131790, "chapter_id": 3849, "verse_number": "३४", "content_sanskrit": "पश्य दैवोपघाताद्धि भुजवीर्यव्यपाश्रयम् ।\nइमामवस्थां सम्प्राप्तमनिमित्तमिहाद्य माम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131791, "chapter_id": 3849, "verse_number": "३५", "content_sanskrit": "किन्तु नाद्यानुशोचामि तथाऽऽत्मानं विनाशितम् ।\nयथा तु विपिने न्यस्तान् भ्रातॄन् राज्यपरिच्युतान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131792, "chapter_id": 3849, "verse_number": "३६", "content_sanskrit": "हिमवांश्च सुदुर्गोऽयं यक्षराक्षससङ्कुलः ।\nमां समुद्वीक्षमाणास्ते प्रपतिष्यन्ति विह्वलाः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131793, "chapter_id": 3849, "verse_number": "३७", "content_sanskrit": "विनष्टमथ मां श्रुत्वा भविष्यन्ति निरुद्यमाः ।\nधर्मशीला मया ते हि बाध्यन्ते राज्यगृद्धिना\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131794, "chapter_id": 3849, "verse_number": "३८", "content_sanskrit": "अथवा नार्जुनो धीमान् विषादमुपयास्यति ।\nसर्वास्त्रविदनाधृष्यो देवगन्धर्वराक्षसैः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131795, "chapter_id": 3849, "verse_number": "३९", "content_sanskrit": "समर्थः स महाबाहुरेकोऽपि सुमहाबलः ।\nदेवराजमपि स्थानात् प्रच्यावयितुमञ्जसा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131796, "chapter_id": 3849, "verse_number": "४०", "content_sanskrit": "किं पुनर्धृतराष्ट्रस्य पुत्रं दुर्द्यूतदेविनम् ।\nविद्विष्टं सर्वलोकस्य दम्भमोहपरायणम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131797, "chapter_id": 3849, "verse_number": "४१", "content_sanskrit": "मातरं चैव शोचामि कृपणां पुत्रगृद्धिनीम् ।\nयाऽस्माकं नित्यमाशास्ते महत्त्वमधिकं परैः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131798, "chapter_id": 3849, "verse_number": "४२", "content_sanskrit": "तस्याः कथं त्वनाथाया मद्विनाशाद् भुजङ्गम ।\nसफलास्ते भविष्यन्ति मयि सर्वे मनोरथाः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2131799, "chapter_id": 3849, "verse_number": "४३", "content_sanskrit": "नकुलः सहदेवश्च यमौ च गुरुवर्तिनौ ।\nमद्बाहुबलसङ्गुप्तौ नित्यं पुरुषमानिनौ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2131800, "chapter_id": 3849, "verse_number": "४४", "content_sanskrit": "भविष्यतो निरुत्साहौ भ्रष्टवीर्यपराक्रमौ ।\nमद्विनाशात् परिद्यूनाविति मे वर्तते मतिः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2131801, "chapter_id": 3849, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2131802, "chapter_id": 3849, "verse_number": "४५", "content_sanskrit": "एवंविधं बहु तदा विललाप वृकोदरः ।\nभुजङ्गभोगसंरुद्धो नाशकच्च विचेष्टितुम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2131803, "chapter_id": 3849, "verse_number": "४६", "content_sanskrit": "युधिष्ठिरस्तु कौन्तेयो बभूवास्वस्थचेतनः ।\nअनिष्टदर्शनान् घोरानुत्पातान् परिचिन्तयन्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2131804, "chapter_id": 3849, "verse_number": "४७", "content_sanskrit": "दारुणं ह्यशिवं नादं शिवा दक्षिणतः स्थिता ।\nदीप्तायां दिशि वित्रस्ता रौति तस्याश्रमस्य ह \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2131805, "chapter_id": 3849, "verse_number": "४८", "content_sanskrit": "एकपक्षाक्षिचरणा वर्तिका घोरदर्शना ।\nरक्तं वमन्ती ददृशे प्रत्यादित्यमभासुरा \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2131806, "chapter_id": 3849, "verse_number": "४९", "content_sanskrit": "प्रववौ चानिलो रूक्षश्चण्डः शर्करकर्षणः ।\nअपसव्यानि सर्वाणि मृगपक्षिरुतानि च \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2131807, "chapter_id": 3849, "verse_number": "५०", "content_sanskrit": "पृष्ठतो वायसः कृष्णो याहि याहीति शंसति।\nमुहुर्मुहुः स्फुरति च दक्षिणोऽस्य भुजस्तथा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2131808, "chapter_id": 3849, "verse_number": "५१", "content_sanskrit": "हृदयं चरणश्चापि वामोऽस्य परितप्यति।\nसव्यस्याक्ष्णो विकारश्चाप्यनिष्टः समपद्यत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2131809, "chapter_id": 3849, "verse_number": "५२", "content_sanskrit": "धर्मराजोऽपि मेधावी मन्यमानो महद्भयम् ।\nद्रौपदीं परिपप्रच्छ क्व भीम इति भारत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2131810, "chapter_id": 3849, "verse_number": "५३", "content_sanskrit": "शशंस तस्मै पाञ्चाली चिरयातं वृकोदरम् ।\nस प्रतस्थे महाबाहुर्धौम्येन सहितो नृपः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2131811, "chapter_id": 3849, "verse_number": "५४", "content_sanskrit": "कथयामास तत्सर्वं मृगान् हन्तुमितो गतम् ।\nतच्छ्रुत्वा त्वरितो राजा भृशमुद्विग्नमानसः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2131812, "chapter_id": 3849, "verse_number": "५५", "content_sanskrit": "द्रौपद्या रक्षणं कार्यमित्युवाच धनञ्जयम्।\nनकुलं सहदेवं च व्यादिदेश द्विजान् प्रति\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2131813, "chapter_id": 3849, "verse_number": "५६", "content_sanskrit": "स तस्य पदमुन्नीय तस्मादेवाश्रमात् प्रभुः ।\nददर्श पृथिवीं चिह्नैर्भीमस्य परिचिह्निताम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2131814, "chapter_id": 3849, "verse_number": "५७", "content_sanskrit": "मृगयामास कौन्तेयो भीमसेनं महावने ।\nस प्राचीं दिशमास्थाय महतो गजयूथपान्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2131815, "chapter_id": 3849, "verse_number": "५८", "content_sanskrit": "ततो मृगसहस्राणि मृगेन्द्राणां शतानि च ।\nपतितानि वने दृष्ट्वा मार्गं तस्याविशन्नपः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2131816, "chapter_id": 3849, "verse_number": "५९", "content_sanskrit": "धावतस्तस्य वीरस्य मृगार्थं वातरंहसः ।\nऊरुवातविनिर्भग्ना द्रुमा व्यावर्जिताः पथि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2131817, "chapter_id": 3849, "verse_number": "६०", "content_sanskrit": "स गत्वा तैस्तदा चिह्नैर्ददर्श गिरिगह्वरे।\nगृहीतं भुजगेन्द्रेण निश्चेष्टमनुजं तदा\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2131818, "chapter_id": 3849, "verse_number": "", "content_sanskrit": "रूक्षमारुतभूयिष्ठे निष्पत्रद्रुमसङ्कुले ।\nईरिणे निर्जले देशे कण्टकिद्रुमसङ्कुले ।\nअश्मस्थाणुक्षुपाकीर्णे सुदुर्गे विषमोत्कटे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2131819, "chapter_id": 3849, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रिसप्तत्य- धिकशततमोऽध्यायः ॥१७३॥ अजगरपर्वणि युधिष्ठिरभीमदर्शने तृतीयोऽध्यायः ॥३\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]