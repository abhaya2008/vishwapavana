[{"id": 2019997, "chapter_id": 1417, "verse_number": "३-५५-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019998, "chapter_id": 1417, "verse_number": "३-५५-१", "content_sanskrit": "वृते तु नैषधे भैम्या लोकपाला महौजसः।\nयान्तो ददृशुरायान्तं द्वापरं कलिना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019999, "chapter_id": 1417, "verse_number": "३-५५-२", "content_sanskrit": "अथाब्रवीत्कलिं शक्रः संप्रेक्ष्य बलवृत्रहा।\nद्वापरेण सहायेन कले ब्रूहि क्व यास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020000, "chapter_id": 1417, "verse_number": "३-५५-३", "content_sanskrit": "ततोऽब्रवीत्कलिः शक्रं दमयन्त्याः स्वयंवरम्।\nगत्वा हि वरयिष्ये तां मनो हि मम तां गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020001, "chapter_id": 1417, "verse_number": "३-५५-४", "content_sanskrit": "तमब्रवीत्प्रहस्येन्द्रो निर्वृत्तः स स्वयंवरः।\nवृतस्तया नलो राजा पतिरस्मत्समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020002, "chapter_id": 1417, "verse_number": "३-५५-५", "content_sanskrit": "एवमुक्तस्तु शक्रेण कलिः कोपसमन्वितः।\nदेवानामन्त्र्य तान्सर्वानुवाचेदं वचस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020003, "chapter_id": 1417, "verse_number": "३-५५-६", "content_sanskrit": "देवानां मानुषं मध्ये यत्सा पतिमविन्दत।\nननु तस्या भवेन्न्याय्यं विपुलं दण्डधारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020004, "chapter_id": 1417, "verse_number": "३-५५-७", "content_sanskrit": "एवमुक्ते तु कलिना प्रत्यूचुस्ते दिवौकसः।\nअस्माभिः सभनुज्ञाते दमयन्त्या नलो वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020005, "chapter_id": 1417, "verse_number": "३-५५-८", "content_sanskrit": "का हि सर्वगुणोपेतं नाश्रयेत नलं नृपम्।\nयो वेद धर्मानखिलान्यथावच्चरितव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020006, "chapter_id": 1417, "verse_number": "३-५५-९", "content_sanskrit": "योऽधीते चतुरो वेदान्सर्वानाख्यानपञ्चमान्।\nअहिंसानिरतो यश्च सत्यवादी दृढव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020007, "chapter_id": 1417, "verse_number": "३-५५-१०", "content_sanskrit": "यस्मिन्दाक्ष्यं धृतिर्ज्ञानं तपः शौचं दमः शमः।\nध्रुवाणि पुरुषव्याघ्रे लोकपालसमे नृपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020008, "chapter_id": 1417, "verse_number": "३-५५-११", "content_sanskrit": "एवंरूपं नलं यो वै कामयेच्छपितुं कले।\nआत्मानं स शपेन्मूढो हन्यादात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020009, "chapter_id": 1417, "verse_number": "३-५५-१२", "content_sanskrit": "एवंगुणं नलं यो वै कामयेच्छपितुं कले।\nकृच्छ्रे स नरके मञ्जेदगाधे विपुले ह्रदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020010, "chapter_id": 1417, "verse_number": "३-५५-१३", "content_sanskrit": "एवमुक्त्वा कलिं देवा द्वापरं च दिवं ययुः।\nततो गतेषु देवेषु कलिर्द्वापरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020011, "chapter_id": 1417, "verse_number": "३-५५-१४", "content_sanskrit": "संयन्तुं नोत्सहे कोपं नले वत्स्यामि द्वापर।\nभ्रंशयिष्यामि तं राज्यान्न भैम्या सह रंस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020012, "chapter_id": 1417, "verse_number": "३-५५-१५", "content_sanskrit": "त्वमप्यक्षान्समाविश्य साहाय्यं कर्तुमर्हसि।\n`मम प्रियकृते ह्यस्मन्कृतवांश्च भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020013, "chapter_id": 1417, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि पञ्चपञ्चाशोऽध्यायः ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]