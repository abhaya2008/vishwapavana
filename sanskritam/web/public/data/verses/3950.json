[{"id": 2136031, "chapter_id": 3950, "verse_number": "१", "content_sanskrit": "वसतस्तस्य रामस्य ततः शूर्पणखाकृतम् ।\nखरेणासीन्महद् वैरं जनस्थाननिवासिना \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136032, "chapter_id": 3950, "verse_number": "२", "content_sanskrit": "रक्षार्थं तापसानां तु राघवो धर्मवत्सलः ।\nचतुर्दशसहस्राणि जघान भुवि रक्षसाम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136033, "chapter_id": 3950, "verse_number": "३", "content_sanskrit": "दूषणं च खरं चैव निहत्य सुमहाबलौ।\nचक्रे क्षेमं पुनर्धीमान् धर्मारण्यं च राघवः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136034, "chapter_id": 3950, "verse_number": "", "content_sanskrit": "तेन शूर्पणखा दृष्ट्वा सहस्राणि चतुर्दश ।\nहतानि युधि रामेण शरैस्तीक्ष्णैः पदातिना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136035, "chapter_id": 3950, "verse_number": "४", "content_sanskrit": "हतेषु तेषु रक्षःसु ततः शूर्पणखा पुनः।\nययौ निकृत्तनासोष्ठी लङ्कां भ्रातुर्निवेशनम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136036, "chapter_id": 3950, "verse_number": "५", "content_sanskrit": "ततो रावणमभ्येत्य राक्षसी दुःखमूर्च्छिता ।\nपपात पादयोर्भ्रातुः संशुष्करुधिरानना \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136037, "chapter_id": 3950, "verse_number": "६", "content_sanskrit": "तां तथा विकृतां दृष्ट्वा रावणः क्रोधमूर्च्छितः ।\nउत्पपातासनात् क्रुद्धो दन्तैर्दन्तानुपस्पृशन् ।\nस्वानमात्यान् विसृज्याथ विविक्ते तामुवाच सः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136038, "chapter_id": 3950, "verse_number": "", "content_sanskrit": "रावणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136039, "chapter_id": 3950, "verse_number": "७", "content_sanskrit": "केनास्येवं कृता भद्रे मामचिन्त्यावमन्य च ।\nकः शूलं तीक्ष्णमासाद्य सर्वगात्रैर्निषेवते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136040, "chapter_id": 3950, "verse_number": "८", "content_sanskrit": "कः शिरस्यग्निमाधाय विश्वस्तः स्वपते सुखम् ।\nआशीविषं घोरतरं पादेन स्पृशतीह कः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136041, "chapter_id": 3950, "verse_number": "९", "content_sanskrit": "सिंहं केसरिणं कश्च दंष्ट्रायां स्पृश्य तिष्ठति \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136042, "chapter_id": 3950, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136043, "chapter_id": 3950, "verse_number": "१०", "content_sanskrit": "इत्येवं ब्रुवतस्तस्य स्रोतोभ्यस्तेजसोऽर्चिष ।\nनिश्चेरुर्दह्यतो रात्रौ वृक्षस्येव स्वरन्ध्रतः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136044, "chapter_id": 3950, "verse_number": "११", "content_sanskrit": "तस्य तत्सर्वमाचख्यौ भगिनी रामविक्रमम् ।\nखरदूषणसंयुक्तं राक्षसानां पराभवम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136045, "chapter_id": 3950, "verse_number": "१२", "content_sanskrit": "ततो ज्ञातिवधं श्रुत्वा रावणः कालचोदितः ।\nरामस्य वधमाकाङ्घन् मारीच मनसागमत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136046, "chapter_id": 3950, "verse_number": "१३", "content_sanskrit": "स निश्चित्य ततः कृत्यं स्वसारमुपसान्त्व्य च ।\nऊर्ध्वमाचक्रमे राजा विधाय नगरे विधिम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136047, "chapter_id": 3950, "verse_number": "१४", "content_sanskrit": "त्रिकूटं समतिक्रम्य कालपर्वतमेव च ।\nददर्श मकरावासं गम्भीरोदं महोदधिम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136048, "chapter_id": 3950, "verse_number": "१५", "content_sanskrit": "तमतीत्याथ गोकर्णमभ्यगच्छद् दशाननः ।\nदयितं स्थानमव्यग्रं शूलपाणेर्महात्मनः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136049, "chapter_id": 3950, "verse_number": "१६", "content_sanskrit": "तत्राभ्यगच्छन्मारीचं पूर्वामात्यं दशाननः ।\nपुरा रामभयादेव तापस्यं समुपाश्रितम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136050, "chapter_id": 3950, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामोपाख्यानपर्वणि रामवनाभिगमने षट्षष्ट्याधिकद्विशततमोऽध्यायः ॥२६६॥\nरामोपाख्यानपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]