[{"id": 2126523, "chapter_id": 3712, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126524, "chapter_id": 3712, "verse_number": "१", "content_sanskrit": "इत्युक्तः स तदा देव्या नळो वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126525, "chapter_id": 3712, "verse_number": "२", "content_sanskrit": "यथा राज्यं पितुस्ते तत् तथा मम न संशयः ।\nनतु तत्र गमिष्यामि विषमस्थः कथञ्चन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126526, "chapter_id": 3712, "verse_number": "३", "content_sanskrit": "कथं समृद्धो गत्वाऽहं तव हर्षविवर्धनः ।\nकृपणोऽद्य गमिष्यामि तव शोकविवर्धनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126527, "chapter_id": 3712, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवन्नळो राजा दमयन्तीं पुनः पुनः ।\nसान्त्वयामास कल्याणीं वाससोऽर्धेन संवृतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126528, "chapter_id": 3712, "verse_number": "५", "content_sanskrit": "तावेकवस्त्रसंवीतावटमानावितस्ततः ।\nक्षुत्पिपासापरिश्रान्तौ सभां काञ्चिदुपेयतुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126529, "chapter_id": 3712, "verse_number": "६", "content_sanskrit": "तां सभामुपसम्प्राप्य वनमध्ये खिलीकृताम् ।\nवैदर्भ्या सहितो राजा निषसाद महीतळे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126530, "chapter_id": 3712, "verse_number": "७", "content_sanskrit": "स वै विवस्त्रो विकचो मलिनः पांसुगुण्ठितः ।\nदमयन्त्या सह श्रान्तः सुष्वाप धरणीतळे \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126531, "chapter_id": 3712, "verse_number": "८", "content_sanskrit": "दमयन्त्यपि कल्याणी निद्रयाऽपहृता ततः ।\nसहसा दुःखमासाद्य सुकुमारी तपस्विनी \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126532, "chapter_id": 3712, "verse_number": "९", "content_sanskrit": "सुप्तायां दमयन्त्यां तु नळो राजा विशाम्पते ।\nशोकोन्मथितचित्तः सन् न स्म शेते यथा पुरा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126533, "chapter_id": 3712, "verse_number": "१०", "content_sanskrit": "स तद्राज्यापहरणं सुहृत्त्यागं च सर्वशः ।\nवने च तं परिध्वंसं प्रेक्ष्य चिन्तामुपेयिवान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126534, "chapter_id": 3712, "verse_number": "११", "content_sanskrit": "किं नु मे स्यादिदं कृत्वा किं नु मे स्यादकुर्वतः ।\nकिं नु मे मरणं श्रेयः परित्यागो जनस्य वा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126535, "chapter_id": 3712, "verse_number": "१२", "content_sanskrit": "मामियं त्वनुरक्ता वै दुःखमाप्नोति मत्कृते ।\nमद्विहीना त्वियं गच्छेत् कदाचित् स्वजनं प्रति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126536, "chapter_id": 3712, "verse_number": "१३", "content_sanskrit": "मया निःसंशयं दुःखमियं प्राप्स्यत्यनिन्दिता ।\nउत्सर्गे संशयः स्यात्तु विन्देतापि सुखं क्वचित्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126537, "chapter_id": 3712, "verse_number": "१४", "content_sanskrit": "स विनिश्चित्य बहुधा विचार्य च पुनःपुनः ।\nउत्सर्गेऽमन्यत श्रेयो दमयन्त्या नराधिपः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126538, "chapter_id": 3712, "verse_number": "१५", "content_sanskrit": "सोऽवस्त्रतामात्मनश्च तस्याश्चाप्येकवस्त्रताम् ।\nचिन्तयित्वाऽध्यगाद् राजा वस्त्रार्धस्यावकर्तनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126539, "chapter_id": 3712, "verse_number": "१६", "content_sanskrit": "कथं वासोऽवकर्तेयं न च बुद्ध्येत मे प्रिया ।\nचिन्त्यैवं नैषधो राजा सभां पर्यचरन्नृपः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126540, "chapter_id": 3712, "verse_number": "१७", "content_sanskrit": "परिधावन्नथ नळ इतश्चेतश्च भारत ।\nआससाद सभोद्देशे विकोशं खङ्गमुत्तमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126541, "chapter_id": 3712, "verse_number": "१८", "content_sanskrit": "तेनार्धं वाससश्छित्त्वा निवस्य च परन्तपः ।\nसुप्तामुत्सृज्य वैदर्भीं प्राद्रवद् गतचेतनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126542, "chapter_id": 3712, "verse_number": "१९", "content_sanskrit": "ततो निबद्धहृदयः पुनरागम्य तां सभाम् ।\nदमयन्तीं तथा दृष्ट्वा रुरोद स नराधिपः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126543, "chapter_id": 3712, "verse_number": "२०", "content_sanskrit": "यां न वायुर्न चादित्यः पुरा पश्यति मे प्रियाम् ।\nसेयमद्य सभामध्ये शेते भूमावनाथवत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126544, "chapter_id": 3712, "verse_number": "२१", "content_sanskrit": "इयं वस्त्रावकर्तेन संवीता चारुहासिनी ।\nउन्मत्तेव मया हीना कथं बुद्ध्वा भविष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126545, "chapter_id": 3712, "verse_number": "२२", "content_sanskrit": "कथमेकाकिनी भैमी मया विरहिता शुभा ।\nचरिष्यति वने घोरे मृगव्यालसमाकुले\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126546, "chapter_id": 3712, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126547, "chapter_id": 3712, "verse_number": "२३", "content_sanskrit": "गत्वा गत्वा नळो राजा मुहुरेति सभां प्रति ।\nआकृष्यमाणः कलिना सौहृदेनापकृष्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126548, "chapter_id": 3712, "verse_number": "२४", "content_sanskrit": "द्विधेव हृदयं तस्य दुःखितस्याभवत् तदा ।\nदोलेव मुहुरायाति याति चैव सभां मुहुः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126549, "chapter_id": 3712, "verse_number": "२५", "content_sanskrit": "सोऽपकृष्टस्तु कलिना मोहितः प्राद्रवन् नळः ।\nसुप्तामुत्सृज्य तां भार्यां विलप्य करुणं बहु\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126550, "chapter_id": 3712, "verse_number": "२६", "content_sanskrit": "नष्टात्मा कलिनाऽऽविष्टः तत्तद्विगणयन् मुहुः ।\nजगामैव वने शून्ये भार्यामुत्सृज्य दुःखितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126551, "chapter_id": 3712, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nचतुःपञ्चाशोऽध्यायः ॥\n॥ तीर्थयात्रापर्वणि दशमोऽध्यायः ॥१०॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]