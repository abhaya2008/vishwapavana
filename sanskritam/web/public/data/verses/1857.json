[{"id": 2039126, "chapter_id": 1857, "verse_number": "५-१०२-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039127, "chapter_id": 1857, "verse_number": "५-१०२-१", "content_sanskrit": "इदं रसातलं नाम सप्तमं पृथिवीतलम्।\nयत्रास्ते सुरभिर्माता गवाममृतसंभवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039128, "chapter_id": 1857, "verse_number": "५-१०२-२", "content_sanskrit": "क्षरन्ती सततं क्षीरं पृथिवीसारसंभवम् ।\nषण्णं रसानां सारेण रसमेकमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039129, "chapter_id": 1857, "verse_number": "५-१०२-३", "content_sanskrit": "अमृतेनाभितृप्तस्य सारमुद्गिरतः पुरा।\nपितामहस्य वदनादुदतिष्ठदनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039130, "chapter_id": 1857, "verse_number": "५-१०२-४", "content_sanskrit": "यस्याः क्षीरस्य धाराया निपतन्त्या महीतले।\nह्रदः कृतः क्षीरनिधिः पवित्रं परमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039131, "chapter_id": 1857, "verse_number": "५-१०२-५", "content_sanskrit": "पुष्पितस्येव फेनेन पर्यन्तमनुवेष्टितम्।\nपिबन्तो निवसन्त्यत्र फेनपा मुनिसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039132, "chapter_id": 1857, "verse_number": "५-१०२-६", "content_sanskrit": "फेनपा नाम ते ख्याताः फेनाहाराश्च मातले।\nउग्रे तपसि वर्तन्ते येषां बिभ्यति देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039133, "chapter_id": 1857, "verse_number": "५-१०२-७", "content_sanskrit": "अस्याश्चतस्रो धेन्वोऽन्या दिक्षु सर्वासु मातले।\nनिवसन्ति दिशां पाल्यो धारयन्त्योदिशःस्म ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039134, "chapter_id": 1857, "verse_number": "५-१०२-८", "content_sanskrit": "पूर्वां दिशं धारयते सुरूपा नाम सौरभी ।\nदक्षिणां हंसिका कनाम धारयत्यपरां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039135, "chapter_id": 1857, "verse_number": "५-१०२-९", "content_sanskrit": "पश्चिमा वारुणी दिक्च धार्यते वै सुभद्रया।\nमहानुभावया नित्यं मातले विश्वरूपया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039136, "chapter_id": 1857, "verse_number": "५-१०२-१०", "content_sanskrit": "सर्वकामदुघा नाम धेनुर्धारयते दिशम्।\nउत्तरां मातले धर्म्यां तथैलविलसंश्रिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039137, "chapter_id": 1857, "verse_number": "५-१०२-११", "content_sanskrit": "आसां त पयसा मिश्रं पयो निर्मथ्य सागरे ।\nमन्थानं मन्दरं कृत्वा देवैरसुरसंहितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039138, "chapter_id": 1857, "verse_number": "५-१०२-१२", "content_sanskrit": "अद्धृता वारुणी लक्ष्मीरमृतं चापि मातले।\nउच्चैःश्रवाश्चाश्वराजो मणिरत्नं च कौस्तुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039139, "chapter_id": 1857, "verse_number": "५-१०२-१३", "content_sanskrit": "सुधाहारेषु च सुधां स्वधाभोजिषु च स्वधाम्।\nअमृतं चामृताशेषु सुरभी क्षरते पयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039140, "chapter_id": 1857, "verse_number": "५-१०२-१४", "content_sanskrit": "अत्र गाथा पुरा गीता रसातलनिवासिभिः ।\nपौराणी श्रूयते लोके गीयते या मनीषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039141, "chapter_id": 1857, "verse_number": "५-१०२-१५", "content_sanskrit": "न नागलोके न स्वर्गे न विमाने त्रिविष्टपे।\nपरिवासः सुखस्तादृक् रसातलतले यथा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039142, "chapter_id": 1857, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवाद्यानपर्वणि द्व्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]