[{"id": 7000322000, "chapter_id": 20322, "verse_number": "१-७६-१", "content_sanskrit": "संजय उवाच ।\nयेऽसुराश्च मृता युद्धे संमुखे विमुखेऽपि वा ।\nगतिं तेषामहं ब्रह्मन्श्रोतुमिच्छामि तत्त्वतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000322001, "chapter_id": 20322, "verse_number": "१-७६-२", "content_sanskrit": "असंख्याता इमे दैत्यास्त्रैलोक्ये सचराचरे ।\nअद्याप्यासन्गताः कुत्र एतन्मे शंस भो गुरो॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000322002, "chapter_id": 20322, "verse_number": "१-७६-३", "content_sanskrit": "व्यास उवाच ।\nये मृतास्संमुखे शूरा दैत्यानां प्रवरा रणे ।\nस्वयं प्राप्य च देवत्वं भोग्यमश्नंति शाश्वतम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000322003, "chapter_id": 20322, "verse_number": "१-७६-४", "content_sanskrit": "प्रासादा यत्र सौवर्णा नानारत्नाविभूषिताः ।\nसर्वकामप्रदा वृक्षाः स्वर्णदीतोय संयुताः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000322004, "chapter_id": 20322, "verse_number": "१-७६-५", "content_sanskrit": "पद्मोत्पलसुकल्हारैर्गंधाढ्यैरन्यपुष्पकैः ।\nदधिदुग्धाज्यखंडैश्च युता पुष्करिणी शुभा॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000322005, "chapter_id": 20322, "verse_number": "१-७६-६", "content_sanskrit": "अतीवरूपसंपन्नाः सदैव नवयौवनाः ।\nतत्र राज्यं प्रकुर्वंति तथैव वसुधातले॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000322006, "chapter_id": 20322, "verse_number": "१-७६-७", "content_sanskrit": "एवं जन्माष्टकं प्राप्य धनिनोऽध्यक्षमंत्रिणः ।\nअर्धसंमुखगात्रेण दिवमश्नंति शाश्वतम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000322007, "chapter_id": 20322, "verse_number": "१-७६-८", "content_sanskrit": "विमुखाः कातरा भीता ये च मायाविनो रणे ।\nते यांति निरयं घोरं ये च देवद्विजद्विषः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000322008, "chapter_id": 20322, "verse_number": "१-७६-९", "content_sanskrit": "पतितं मूर्च्छितं भग्नमन्ययोद्धारमाहवे ।\nहंतारो निरयं यांति ते च म्लेच्छाः कुवाचकाः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000322009, "chapter_id": 20322, "verse_number": "१-७६-१०", "content_sanskrit": "परन्यासापहर्तारो विमुखास्संति तत्त्वतः ।\nरात्रौ वा विपिने नष्टे चोरास्साहसकारिणः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000322010, "chapter_id": 20322, "verse_number": "१-७६-११", "content_sanskrit": "सर्वभक्षरता मूढा म्लेच्छा गोब्रह्मघातकाः ।\nकुवाचकाः परे म्लेच्छा एते ये कूटयोनयः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000322011, "chapter_id": 20322, "verse_number": "१-७६-१२", "content_sanskrit": "तेषां पैशाचिकी भाषा लोकाचारो न विद्यते ।\nनास्ति शौचं तपो ज्ञानं न देवपितृतर्पणम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000322012, "chapter_id": 20322, "verse_number": "१-७६-१३", "content_sanskrit": "दानश्राद्धादिकं यज्ञे सुराणां च प्रपूजनम् ।\nपितॄणां च न शुश्रूषा द्विजदेवतपस्विनाम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000322013, "chapter_id": 20322, "verse_number": "१-७६-१४", "content_sanskrit": "ज्ञानलोपादतस्तेषां मलशौचं न विद्यते ।\nमातरं भगिनीं चान्यां गृहिणीं कामयंति च॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000322014, "chapter_id": 20322, "verse_number": "१-७६-१५", "content_sanskrit": "सर्वो विपर्ययो लोकात्सदाचारो मलीमसः ।\nतार्क्ष्यस्योद्ववनानां च अन्येषां गोत्रवासिनाम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000322015, "chapter_id": 20322, "verse_number": "१-७६-१६", "content_sanskrit": "कुलजातास्सदा दैत्या येषां पुण्यमकारणम् ।\nदुर्गतिं च मृता यांति द्विजस्त्रीशिशुघातिनः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000322016, "chapter_id": 20322, "verse_number": "१-७६-१७", "content_sanskrit": "गवाशिनो दुरात्मानो ह्यभक्ष्यभक्षणे रताः ।\nकीटयोनिं व्रजंत्येते तरवश्च पिपीलिकाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000322017, "chapter_id": 20322, "verse_number": "१-७६-१८", "content_sanskrit": "न मंत्रेषु न देवेषु कल्पंते ते सुरद्विषः ।\nअग्रजः सहजस्तेषां सदृङ्नो ग्राम्यवृत्तयः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000322018, "chapter_id": 20322, "verse_number": "१-७६-१९", "content_sanskrit": "लोमकेशप्रणेतारः क्रव्यभक्षरता भुवि ।\nसाहसं च व्रतं दानं स्नानं यज्ञादिकं च यत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000322019, "chapter_id": 20322, "verse_number": "१-७६-२०", "content_sanskrit": "मत्स्यमांसादिषु प्रीता मृषावचनभाषिणः ।\nसदाकामास्सदा लोभास्सदा क्रोधमदान्विताः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000322020, "chapter_id": 20322, "verse_number": "१-७६-२१", "content_sanskrit": "वधबंधरतोद्वेगा द्यूतसंगीतसंप्रियाः ।\nकुभृत्याः कुजनप्रीताः पूतिगंधरता नराः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000322021, "chapter_id": 20322, "verse_number": "१-७६-२२", "content_sanskrit": "न देवेषु न विज्ञेषु न धर्मश्रवणेषु च ।\nस्तोत्रमंत्रादिके पुण्ये यथाकार्येष्वनिश्चयाः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000322022, "chapter_id": 20322, "verse_number": "१-७६-२३", "content_sanskrit": "बहुरोगाधिरोषाश्च बहुरूपपरिच्छदाः ।\nनरजातिषु दैत्यानां चिह्नान्येतानि भूतले॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000322023, "chapter_id": 20322, "verse_number": "१-७६-२४", "content_sanskrit": "न जानंति परं लोकं न गुरुं स्वं न चापरं ।\nगर्भपूरणमिच्छंति नातिथिं न गुरून्द्विजान्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000322024, "chapter_id": 20322, "verse_number": "१-७६-२५", "content_sanskrit": "न देवं न सुतं गोत्रं न मित्रं न च बान्धवं ।\nस्वप्ने दानं न जानंति भक्षणान्न परिच्छदं॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000322025, "chapter_id": 20322, "verse_number": "१-७६-२६", "content_sanskrit": "गोपायंति धनं यस्मात्ते यक्षा नररूपिणः ।\nप्राणांतेपि धनं किचिन्न दिशंति च राजनि॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000322026, "chapter_id": 20322, "verse_number": "१-७६-२७", "content_sanskrit": "ते यक्षा दुर्गतिस्थाश्च परार्थे भारवाहकाः ।\nप्रेतानां लक्षणं यद्वा सर्वलोकविगर्हितं॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000322027, "chapter_id": 20322, "verse_number": "१-७६-२८", "content_sanskrit": "स्त्रीणां च पुरुषाणां च शृणुष्वैकमना मम ।\nमलपंकधरा नित्यं सत्यशौचविवर्जिताः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000322028, "chapter_id": 20322, "verse_number": "१-७६-२९", "content_sanskrit": "दंतकुंतलवस्त्राणां वपुषो मलसंचयाः ।\nगृहपीठादिपात्राणां सकृच्छौचं न रोचते॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000322029, "chapter_id": 20322, "verse_number": "१-७६-३०", "content_sanskrit": "न पश्यंति सुखं स्त्रीणां विशंति कानने द्रुतं ।\nविघसोच्छिष्टपूतीनां भक्षणेभिरता भुवि॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000322030, "chapter_id": 20322, "verse_number": "१-७६-३१", "content_sanskrit": "अन्नपानं च शयनमन्धकारेषु रोचते ।\nकदाचित्स्वस्थता नास्ति क्वचिद्वा शुचितातनौ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000322031, "chapter_id": 20322, "verse_number": "१-७६-३२", "content_sanskrit": "लक्षणं नरलोकेषु प्रेतानामीदृशं किल ।\nहिताहितं न जानंति मित्रामित्रं गुणागुणम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000322032, "chapter_id": 20322, "verse_number": "१-७६-३३", "content_sanskrit": "पापपुण्यादिकं स्थानं स्नानं देवद्विजार्चनं ।\nअरिमित्रमुदासीनं न विंदंति स्वभावतः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000322033, "chapter_id": 20322, "verse_number": "१-७६-३४", "content_sanskrit": "मर्त्यस्थाः पशवस्ते च ज्ञायंते बुद्धिसंमतैः ।\nबुद्ध्या नानात्वभावाश्च भ्रमंति च मृषा भुवि॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000322034, "chapter_id": 20322, "verse_number": "१-७६-३५", "content_sanskrit": "यक्षरूपा नरास्ते च सर्वकर्मबहिष्कृताः ।\nएषां भेदं प्रवक्ष्यामि लक्षणं धरणीतले॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000322035, "chapter_id": 20322, "verse_number": "१-७६-३६", "content_sanskrit": "विजाता मर्त्यलोकेषु पापस्यैवानुरूपतः ।\nमलीमस भुविप्रस्थं नागरं छद्मरूपिणं॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000322036, "chapter_id": 20322, "verse_number": "१-७६-३७", "content_sanskrit": "विघसादिप्रभोक्तारं काकमाहुर्मनीषिणः ।\nअभक्ष्ये निरतः पापः कुकुरः पूतिसंप्रियः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000322037, "chapter_id": 20322, "verse_number": "१-७६-३८", "content_sanskrit": "प्रवृत्तस्सर्वगृह्येषु भक्ष्याभक्ष्यसजीवनः ।\nभूम्यां पश्वादियोनीनां कुलेषु प्राप्तसंभवाः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000322038, "chapter_id": 20322, "verse_number": "१-७६-३९", "content_sanskrit": "शुनो विगृह्य हस्तेन म्लेच्छानां भक्षणप्रियाः ।\nविशेषात्सूकराणां च तथा च रणयोधिनां॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000322039, "chapter_id": 20322, "verse_number": "१-७६-४०", "content_sanskrit": "पोषणे भक्षणे प्रीताः पूतिगर्ह्येष्वसाधुषु ।\nपर्वतेकरणाद्वह्नेः काष्ठसंचयसंग्रहे॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000322040, "chapter_id": 20322, "verse_number": "१-७६-४१", "content_sanskrit": "विज्ञेयास्ते सदा म्लेच्छाः क्षत्रियाणां भयाकुलाः ।\nलोकानां नष्टधर्मे च सदा शौचविवर्जिते॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000322041, "chapter_id": 20322, "verse_number": "१-७६-४२", "content_sanskrit": "कुलीनानां तदा म्लेच्छा भविष्यंति च दस्यवः ।\nतेषां संसर्गतोन्ये च संबंधादन्नभोजनात्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000322042, "chapter_id": 20322, "verse_number": "१-७६-४३", "content_sanskrit": "मैथुनात्तस्य योषासु तद्भावं तु व्रजंति ते ।\nतस्मिन्काले जनास्सर्वे दुःखरोगप्रतापिताः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000322043, "chapter_id": 20322, "verse_number": "१-७६-४४", "content_sanskrit": "दुर्भिक्षान्न परामूढाः सदा राजप्रपीडिताः ।\nतत्रासत्येरता मर्त्याः सर्वशौचविवर्जिताः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000322044, "chapter_id": 20322, "verse_number": "१-७६-४५", "content_sanskrit": "न श्रूयंते जनैरेव पुराणागमसंहिताः ।\nमद्यमांसप्रियाः पापास्सर्वभक्षास्सुदारुणाः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000322045, "chapter_id": 20322, "verse_number": "१-७६-४६", "content_sanskrit": "दारुणाचारनिरता नित्यं छलपरायणाः ।\nन पुष्णंति सुतास्तातं प्रसुवं च गुरूनपि॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000322046, "chapter_id": 20322, "verse_number": "१-७६-४७", "content_sanskrit": "न शुश्रूषंति वै भृत्याः स्वामिनं गुणशालिनम् ।\nभर्तारं न स्त्रियः काश्चिच्छ्वशुरौ च स्वमातरः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000322047, "chapter_id": 20322, "verse_number": "१-७६-४८", "content_sanskrit": "नित्यकष्टा नरास्तत्र कलहश्च गृहे गृहे ।\nनृपा म्लेच्छाः सुरापाश्च तथा मंत्रिपुरोहिताः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000322048, "chapter_id": 20322, "verse_number": "१-७६-४९", "content_sanskrit": "मनुष्यैश्च बलिस्तेषां मत्स्यैर्मांसैर्निरामिषः ।\nपाषंडायासयोगेभ्यः प्रधाना गुणवार्तयोः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000322049, "chapter_id": 20322, "verse_number": "१-७६-५०", "content_sanskrit": "धनिकैः कोकिलैर्मंदैर्व्याप्तं तैस्तु महीतलम् ।\nततोन्योन्यं प्रिया मूढा वने वा नगरेषु च॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000322050, "chapter_id": 20322, "verse_number": "१-७६-५१", "content_sanskrit": "भक्ष्याभक्ष्यं समश्नंति मत्स्यमांसादिकं नराः ।\nवने द्विजातयश्चान्ये भुंजते चानुपापकम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000322051, "chapter_id": 20322, "verse_number": "१-७६-५२", "content_sanskrit": "भक्तिमंतं पशुं चान्यत्सर्वे यांत्यपुनर्भवम् ।\nपातयंति पितॄन्पापाः सर्वे ते पूर्वदेवकाः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000322052, "chapter_id": 20322, "verse_number": "१-७६-५३", "content_sanskrit": "पिशाचा राक्षसा ये च मुर्त्यका गुह्यका ध्रुवम् ।\nएते चाविनयप्रीता न देवा न च मानुषाः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000322053, "chapter_id": 20322, "verse_number": "१-७६-५४", "content_sanskrit": "संजय उवाच ।\nकथं च मर्त्यभावेषु लक्षंजानंतितात्त्विकाः ।\nएतं मे संशयं नाथ दूरीकुरु ततस्ततः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000322054, "chapter_id": 20322, "verse_number": "१-७६-५५", "content_sanskrit": "व्यास उवाच ।\nकृतपापानुरूपास्तु द्विजातिष्वन्यजातिषु ।\nअसुरा राक्षसाः प्रेताः स्वभावं न त्यजंति ते॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000322055, "chapter_id": 20322, "verse_number": "१-७६-५६", "content_sanskrit": "जाता ये चासुरा मर्त्ये सदाते कलहोत्सुकाः ।\nकुहकाः कच्चराः क्रूराः विज्ञेया राक्षसाभुवि॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000322056, "chapter_id": 20322, "verse_number": "१-७६-५७", "content_sanskrit": "जनोद्विग्नादिकं दानं तथा देवार्चनं भुवि ।\nउग्रभावाद्धनं लब्ध्वा राज्यं भुञ्जंति शाश्वतम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000322057, "chapter_id": 20322, "verse_number": "१-७६-५८", "content_sanskrit": "जयं शौर्यादिकं पुण्यं पुनःपापक्षयं व्रजेत् ।\nएवमुर्व्यां तथा नाके नागलोके यमालये॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000322058, "chapter_id": 20322, "verse_number": "१-७६-५९", "content_sanskrit": "उग्रेण तपसा कश्चित्सुरत्वं लभते दिवि ।\nवासुदेवं समाराध्य प्रह्लादः सुरपूजितः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000322059, "chapter_id": 20322, "verse_number": "१-७६-६०", "content_sanskrit": "हरं तथान्धको दैत्यः स्तुत्वा तत्सभ्यकोऽभवत् ।\nतस्यैव गणमुख्यत्वं लेभे भृंगी महाबलः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000322060, "chapter_id": 20322, "verse_number": "१-७६-६१", "content_sanskrit": "एते चान्ये च बहवो बलिरिंद्रो भविष्यति ।\nगच्छंति सद्गतिं तात इहामुत्र च सर्वदा॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000322061, "chapter_id": 20322, "verse_number": "१-७६-६२", "content_sanskrit": "केचिद्दैत्यकुले जाताः पृथिव्यां सुरसत्तमाः ।\nभावयंति पितॄन्सर्वान्शतशोथ सहस्रशः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000322062, "chapter_id": 20322, "verse_number": "१-७६-६३", "content_sanskrit": "एकेनापि सुपुत्रेण कुलत्राणं च धीमता ।\nएकोपि वैष्णवः पुत्रः कुलकोटिं समुद्धरेत्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000322063, "chapter_id": 20322, "verse_number": "१-७६-६४", "content_sanskrit": "जितेंद्रियोपि धर्मात्मा द्विजदेवार्चने रतः ।\nक्षये धर्मे कलौ शेषे पुरे जनपदेषु च॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000322064, "chapter_id": 20322, "verse_number": "१-७६-६५", "content_sanskrit": "एको रक्षति धर्मात्मा पुरे ग्रामं जनं कुलम् ।\nविज्ञातृमेदुरं चासीद्ब्राह्मणानां पुरं महत्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000322065, "chapter_id": 20322, "verse_number": "१-७६-६६", "content_sanskrit": "तत्र सर्वे द्विजाः शश्वत्संध्योपासनतत्पराः ।\nवेदपाठरता धीरा देवातिथिद्विजार्चकाः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000322066, "chapter_id": 20322, "verse_number": "१-७६-६७", "content_sanskrit": "यज्ञव्रताग्निकर्माणः षट्कर्मपरिनिश्चयाः ।\nअतिकृच्छ्रे च तेषां वै न पापे वर्तते मनः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000322067, "chapter_id": 20322, "verse_number": "१-७६-६८", "content_sanskrit": "कुर्वंति सततं वीरा व्रतं यज्ञं सनातनम् ।\nकदाचिद्दैवयोगाच्च गृहस्थश्च स कोविदः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000322068, "chapter_id": 20322, "verse_number": "१-७६-६९", "content_sanskrit": "वह्नौ जुहोति विप्रर्षि राज्यं मंत्रेण मंत्रवित् ।\nतस्मिन्काले च तस्यैव मूत्रकृच्छ्रं सुदारुणम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000322069, "chapter_id": 20322, "verse_number": "१-७६-७०", "content_sanskrit": "तत्प्रोज्झितुं गतः सोपि रक्षार्थं स्थाप्य चेटिकाम् ।\nतस्यास्त्वनवधानेन शुना चाज्यं च भक्षितम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000322070, "chapter_id": 20322, "verse_number": "१-७६-७१", "content_sanskrit": "भिया तया ततः पात्रं स्वीयमूत्रेण संभृतम् ।\nअसंलक्ष्या जुहोदग्नौ स विप्रस्त्वरया ततः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000322071, "chapter_id": 20322, "verse_number": "१-७६-७२", "content_sanskrit": "आश्चर्यं च ततो वह्नौ लक्षितं तेन तत्क्षणात् ।\nकूटं हेममयं साक्षात्स्वर्णं जांबूनदप्रभं॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000322072, "chapter_id": 20322, "verse_number": "१-७६-७३", "content_sanskrit": "गृहीत्वा तन्मुदा विप्रः पापयोगं चकार ह ।\nपप्रच्छ विस्मयाद्दासीं कथमेतद्वद प्रिये॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000322073, "chapter_id": 20322, "verse_number": "१-७६-७४", "content_sanskrit": "मुदा तत्र यथावृत्तं कथितं तु तया द्विज ।\nततो नित्यं यथाकालं तच्च तस्य प्रवर्तते॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000322074, "chapter_id": 20322, "verse_number": "१-७६-७५", "content_sanskrit": "समृद्धिरद्भुता गेहे लोकविस्मयकारिणी ।\nततः परस्पराच्छ्रुत्वा सर्वैरेव च तत्पुरे॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000322075, "chapter_id": 20322, "verse_number": "१-७६-७६", "content_sanskrit": "कृतं कर्म दुराचारं श्रुत्वा लोभादसाधुभिः ।\nगुरुलोभाच्च सुमहत्स्वांते पंकं विशत्यपि॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000322076, "chapter_id": 20322, "verse_number": "१-७६-७७", "content_sanskrit": "पंकादेव भयान्मोहान्मतिभ्रंशोऽभवत्ततः ।\nअथ किल्बिषकूटेन दग्धमेव पुरं च तत्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000322077, "chapter_id": 20322, "verse_number": "१-७६-७८", "content_sanskrit": "स्त्रियो दुष्टा जना दुष्टाः सर्वे पापबलात्तदा ।\nवृद्धो ज्ञाता द्विजस्तत्र तत्कार्ये न मतिं दधौ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000322078, "chapter_id": 20322, "verse_number": "१-७६-७९", "content_sanskrit": "तस्य भार्या तदा साध्वी पुरुदुःखेन संयुता ।\nभर्तारं कृच्छ्रसन्तप्ता पुरकार्यं जगाद सा॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000322079, "chapter_id": 20322, "verse_number": "१-७६-८०", "content_sanskrit": "ब्राह्मण्युवाच ।\nकष्टं मे वर्तते नाथ दृष्ट्वा त्वां दुःखसंयुतम् ।\nग्रामाचारमिमं यद्वाप्यऽपरं कर्तुमर्हसि॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000322080, "chapter_id": 20322, "verse_number": "१-७६-८१", "content_sanskrit": "ततस्तत्र स दोषज्ञः स्मित्वा वचनमब्रवीत् ।\nयस्तु जीवति पापेन त्यक्त्वा धर्मं परं हितम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000322081, "chapter_id": 20322, "verse_number": "१-७६-८२", "content_sanskrit": "स वैधेयो महाभागे प्रगच्छत्यपुनर्भवम् ।\nएते विप्रा दुराचाराः सदारास्सपरिच्छदाः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000322082, "chapter_id": 20322, "verse_number": "१-७६-८३", "content_sanskrit": "अतिपातकयोगाच्च महापातकसंमताः ।\nसह पापेन महता प्रयास्यंति रसातलम्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000322083, "chapter_id": 20322, "verse_number": "१-७६-८४", "content_sanskrit": "अंतेऽपुनर्भवं प्राप्यापराधांतो न विद्यते ।\nअहमेकोत्र तिष्ठामि स्वपुण्यपरिरक्षणात्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000322084, "chapter_id": 20322, "verse_number": "१-७६-८५", "content_sanskrit": "ततस्सा तमुवाचेदं लोकहास्यवचस्तव ।\nवक्तुमर्हसि नश्चाग्रे न पुरोऽन्यस्य कस्यचित्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000322085, "chapter_id": 20322, "verse_number": "१-७६-८६", "content_sanskrit": "द्विज उवाच ।\nयदि यास्यामि चान्यत्र इतोऽहं तत्क्षणात्प्रिये ।\nसवित्तैः स्वजनैरेव पुरीयास्यत्यथोगतिम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000322086, "chapter_id": 20322, "verse_number": "१-७६-८७", "content_sanskrit": "इत्युक्त्वा परमप्रीतः संगृह्य च धनं स्वकम् ।\nक्षिप्रं स च तया सार्धं ययौ सीमांतरं द्विजः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000322087, "chapter_id": 20322, "verse_number": "१-७६-८८", "content_sanskrit": "स्थित्वाऽपश्यत्पुरी तावत्स्थिरा तिष्ठति पूर्ववत् ।\nसा चाह तं पतिं साध्वी पुरी चेयं न नश्यति॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000322088, "chapter_id": 20322, "verse_number": "१-७६-८९", "content_sanskrit": "विमृश्यतामुवाचेदं विप्रवर्यस्सुविस्मितः ।\nकिं नु तिष्ठति तत्रैव द्रव्यमस्मद्गृहाद्बहिः॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000322089, "chapter_id": 20322, "verse_number": "१-७६-९०", "content_sanskrit": "विचार्य सा धवं प्राह मया भ्रांत्या उपानहौ ।\nनानीते तिष्ठतस्तत्र धारयिष्यामि किं नु वै॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000322090, "chapter_id": 20322, "verse_number": "१-७६-९१", "content_sanskrit": "एवमुक्त्वा पतिं साध्वी गृहीत्वा ते उपागता ।\nपत्युरभ्याशतो दृष्टं पुरं निर्व्यथनं गतम्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000322091, "chapter_id": 20322, "verse_number": "१-७६-९२", "content_sanskrit": "ततो विप्रादयो वर्णाः कच्चराः पुरवासिनः ।\nतिष्ठंति नरके घोरे दुःखिताश्चापुनर्भवे॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000322092, "chapter_id": 20322, "verse_number": "१-७६-९३", "content_sanskrit": "कृच्छाद्यमपुरं यांति नास्ति तेषां च निष्कृतिः ।\nपूतिगंधं ततो मेध्यं वर्जनीयं प्रकीर्तितम्॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000322093, "chapter_id": 20322, "verse_number": "१-७६-९४", "content_sanskrit": "पूर्ववद्भक्षणे प्रीतो ह्यद्यपापं करोति च ।\nस्तेयशीलो निशाचारी बुधैर्ज्ञेयस्स वंचकः॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000322094, "chapter_id": 20322, "verse_number": "१-७६-९५", "content_sanskrit": "अबुधः सर्वकार्येषु अज्ञातः सर्वकर्मसु ।\nसमयाचारहीनस्तु पशुरेव स बालिशः॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000322095, "chapter_id": 20322, "verse_number": "१-७६-९६", "content_sanskrit": "एवमुष्ट्रादयस्संति भक्षादि नकुलादयः ।\nहिंस्रो ज्ञातिजनोद्वेगरिते युद्धे च कातरः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000322096, "chapter_id": 20322, "verse_number": "१-७६-९७", "content_sanskrit": "विघसादिप्रियो नित्यं नरः श्वा कीर्तितो बुधैः ।\nचौर्यकर्मरतो नित्यं बहुमित्रप्रवंचकः॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000322097, "chapter_id": 20322, "verse_number": "१-७६-९८", "content_sanskrit": "मिथुने कलहो नित्यं मर्त्यस्तु परिकीर्तितः ।\nप्रकृत्या चपलो नित्यं सदा भोजनचंचलः॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000322098, "chapter_id": 20322, "verse_number": "१-७६-९९", "content_sanskrit": "प्लवगः काननप्रीतो नरः शाखामृगो भुवि ।\nसूचको भाषया बुध्या स्वजनेऽन्यजनेषु च॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000322099, "chapter_id": 20322, "verse_number": "१-७६-१००", "content_sanskrit": "उद्वेगजनकत्वाच्च स पुमानुरगः स्मृतः ।\nबलवान्क्रांतशीलश्च सततं चानपत्रपः॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000322100, "chapter_id": 20322, "verse_number": "१-७६-१०१", "content_sanskrit": "पूतिमांसप्रियो भोगी नृसिंहस्समुदाहृतः ।\nतत्स्वनादेव सीदंति भीता अन्ये वृकादयः॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000322101, "chapter_id": 20322, "verse_number": "१-७६-१०२", "content_sanskrit": "द्विरदादि नरा ये च ज्ञायंते दूरदर्शिनः ।\nएवमादि क्रमेणैव विजानीयान्नरेषु च॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000322102, "chapter_id": 20322, "verse_number": "१-७६-१०३", "content_sanskrit": "सुराणां लक्षणं ब्रूमो नररूपं व्यवस्थितम् ।\nद्विजदेवातिथीनां च गुरुसाधुतपस्विनाम्॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000322103, "chapter_id": 20322, "verse_number": "१-७६-१०४", "content_sanskrit": "पूजातपोरतोनित्यं धर्मशास्त्रेषु नीतिषु ।\nक्षमाशीलो जितक्रोधः सत्यवादी जितेंद्रिंयः॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000322104, "chapter_id": 20322, "verse_number": "१-७६-१०५", "content_sanskrit": "दयालुर्दयितो लोके रूपवान्मधुरस्वरः ।\nवागीशः सर्वकार्येषु गुणी दक्षो महाबलः॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000322105, "chapter_id": 20322, "verse_number": "१-७६-१०६", "content_sanskrit": "साक्षरश्चापि विद्वांश्च गीतनृत्यार्थतत्त्ववित् ।\nआत्मविद्यादिकार्येषु सर्वतंत्रीस्वरेषु च॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000322106, "chapter_id": 20322, "verse_number": "१-७६-१०७", "content_sanskrit": "हविष्येषु च सर्वेषु गव्येषु च निरामिषे ।\nसद्योगास्वादद्रव्ये च प्रत्यग्रे चातिशोभने॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000322107, "chapter_id": 20322, "verse_number": "१-७६-१०८", "content_sanskrit": "गंधमाल्येषु वस्त्रेषु शास्त्रेष्वाभरणेषु च ।\nसंप्रीतश्चातिथौ दाने पार्वणादिषु कर्मसु॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000322108, "chapter_id": 20322, "verse_number": "१-७६-१०९", "content_sanskrit": "स्नानदानादिभिः कार्ये व्रतैर्यज्ञैः सुरार्चनैः ।\nकालो गच्छति पाठैश्च न क्लीबं वासरं भवेत्॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000322109, "chapter_id": 20322, "verse_number": "१-७६-११०", "content_sanskrit": "अयमेव मनुष्याणां सदाचारो निरंतरम् ।\nदेववन्मानवाचारो गीयते मुनिसत्तमैः॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000322110, "chapter_id": 20322, "verse_number": "१-७६-१११", "content_sanskrit": "किंतु सत्त्वाधिको देवो मनुष्यो भीत एव च ।\nगंभीरः सर्वदा देवः सदैव मानवो मृदुः॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000322111, "chapter_id": 20322, "verse_number": "१-७६-११२", "content_sanskrit": "द्वयोस्तुत्या च संप्रीतिर्न दैत्यादौ भवेत्किल ।\nप्रीतिभावं परं सौख्यं सौहृदं सुकृतं शुभम्॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000322112, "chapter_id": 20322, "verse_number": "१-७६-११३", "content_sanskrit": "दैवमानुषयोरेव दैत्यराक्षसयोस्तथा ।\nप्रेतादीनां च प्रेतेषु पशौ प्रीतिः पशोरपि॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000322113, "chapter_id": 20322, "verse_number": "१-७६-११४", "content_sanskrit": "काकादयः स्वजातौ च तथान्ये च स्वजातिषु ।\nप्रीता भवंति चाप्रीता विद्या तेषां च लक्षणम्॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000322114, "chapter_id": 20322, "verse_number": "१-७६-११५", "content_sanskrit": "एवं पुण्यविशेषेण सविशेषा सुजातिषु ।\nप्रियाप्रियं विजानीयात्पुण्यापुण्यं गुणागुणम्॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000322115, "chapter_id": 20322, "verse_number": "१-७६-११६", "content_sanskrit": "दंपत्योर्न सुखं किंचिज्जातिभेदान्नृणां भुवि ।\nस्वजातिषु भवेत्प्रीतिर्मुक्तो वा निरयेपि वा॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000322116, "chapter_id": 20322, "verse_number": "१-७६-११७", "content_sanskrit": "अतिपुण्याल्लभेदायुः शोभनाः पुण्यकारिणः ।\nपापात्मानो लभंतेऽन्तं ये च दैत्यादयो नराः॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000322117, "chapter_id": 20322, "verse_number": "१-७६-११८", "content_sanskrit": "कृते जाताः सुरा भूमौ न दैत्याश्चान्यजातयः ।\nत्रेतायामेकपादं च द्विपदं द्वापरे युगे॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000322118, "chapter_id": 20322, "verse_number": "१-७६-११९", "content_sanskrit": "संध्यायां च कलेरेव सर्वपादं च संकुलम् ।\nदेवादीनां भवेज्जातं भारतं यत्प्रवर्तितम्॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000322119, "chapter_id": 20322, "verse_number": "१-७६-१२०", "content_sanskrit": "ये ते दुर्योधनस्यैव योधाः सैन्यादयस्तथा ।\nते च दैत्यादयः सर्वे ये च कर्णादयो भुवि॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000322120, "chapter_id": 20322, "verse_number": "१-७६-१२१", "content_sanskrit": "गांगेयो वसुमुख्यश्च द्रोणो देवमुनिः प्रभुः ।\nअश्वत्थामा हरः साक्षाद्धरिर्नंदकुलोद्भवः॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000322121, "chapter_id": 20322, "verse_number": "१-७६-१२२", "content_sanskrit": "पंचेंद्राः पांडवा जाता विदुरो धर्म एव च ।\nगांधारी द्रौपदी कुंती चैता देव्यो धरातले॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000322122, "chapter_id": 20322, "verse_number": "१-७६-१२३", "content_sanskrit": "देवदैत्याः कलेर्मध्ये दैत्याश्शेषे च मानवाः ।\nउत्पत्स्यंते सदा प्रेताः क्रव्यादाः पशुपक्षिणः॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000322123, "chapter_id": 20322, "verse_number": "१-७६-१२४", "content_sanskrit": "तेषां च कुलटा दासी नित्यकष्टा यवीयसी ।\nनित्यं द्वंद्वेषु संप्रीत्या तेषामाचारभाषिणी॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000322124, "chapter_id": 20322, "verse_number": "१-७६-१२५", "content_sanskrit": "किल्बिषेषु च सर्वेषु कलहेऽन्यायकर्मणि ।\nरता दैत्यादयो ये ते सर्वे निरयगामिनः॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000322125, "chapter_id": 20322, "verse_number": "१-७६-१२६", "content_sanskrit": "वैशंपायन उवाच ।\nदैत्यादीनां मृषाभावात्सुरत्वं न सुरालयम् ।\nकथं भोग्यं कथं सौख्यमारोग्यं बलसंचयम्॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000322126, "chapter_id": 20322, "verse_number": "१-७६-१२७", "content_sanskrit": "राज्यमायुस्तथा कीर्तिरभीष्टं दयितं बलम् ।\nनीतिविद्यादिकं भाव्यं जन्मवृद्धं सनातनम्॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000322127, "chapter_id": 20322, "verse_number": "१-७६-१२८", "content_sanskrit": "दानाध्ययनकर्माणि यज्ञादि च कथं प्रभो ।\nएतदाप्ताय शिष्याय मह्यं भो वक्तुमर्हसि॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000322128, "chapter_id": 20322, "verse_number": "१-७६-१२९", "content_sanskrit": "व्यास उवाच ।\nदैत्यानां साहसादेव तपो भवति निश्चितम् ।\nव्रतं यज्ञादिकं चैव संप्रीतिः स्वजनस्य च॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000322129, "chapter_id": 20322, "verse_number": "१-७६-१३०", "content_sanskrit": "यो दांतो विगुणैर्मुक्तो नीतिशास्रार्थतत्त्वगः ।\nएतैश्च विविधैः पूतः स भवेत्सुरलक्षणः॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000322130, "chapter_id": 20322, "verse_number": "१-७६-१३१", "content_sanskrit": "पुराणागमकर्माणि नाकेष्वत्र च वै द्विज ।\nस्वयमाचरते पुण्यं स धरोद्धरणक्षमः॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000322131, "chapter_id": 20322, "verse_number": "१-७६-१३२", "content_sanskrit": "विशेषाद्वैष्णवं दृष्ट्वा प्रीयते पूजयेच्च यः ।\nविमुक्तस्सर्वपापेभ्यस्स धरोद्धरणक्षमः॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000322132, "chapter_id": 20322, "verse_number": "१-७६-१३३", "content_sanskrit": "षट्कर्मनिरतो विप्रस्सर्वयज्ञरतस्सदा ।\nधर्माख्यानप्रियो नित्यं स धरोद्धरणक्षमः॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000322133, "chapter_id": 20322, "verse_number": "१-७६-१३४", "content_sanskrit": "विश्वासघातिनो ये च कृतघ्ना व्रतलोपिनः ।\nद्विजदेवेषु विद्विष्टाः शातयंति धरां नराः॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000322134, "chapter_id": 20322, "verse_number": "१-७६-१३५", "content_sanskrit": "ये च मद्यरताः पापा द्यूतकर्मरतास्तथा ।\nपाषंडपतितालापाः शातयंति धरां नराः॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000322135, "chapter_id": 20322, "verse_number": "१-७६-१३६", "content_sanskrit": "सुकर्मरहिता ये च नित्योद्वेगाश्च निर्भयाः ।\nस्मृतिशास्त्रार्थकोद्विग्नाश्शातयंति धरां नराः॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000322136, "chapter_id": 20322, "verse_number": "१-७६-१३७", "content_sanskrit": "निजवृत्तिं परित्यज्य कुर्वंति चाधमां च ये ।\nगुरुनिंदारता द्वेषाच्छातयंति धरां नराः॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000322137, "chapter_id": 20322, "verse_number": "१-७६-१३८", "content_sanskrit": "दातारं ये रोधयंति पातके प्रेरयंति च ।\nदीनानाथान्पीडयंति शातयंति धरां नराः॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000322138, "chapter_id": 20322, "verse_number": "१-७६-१३९", "content_sanskrit": "एते चान्ये च बहवः पापकर्मकृतो नराः ।\nपुरुषान्पातयित्वा तु शातयंति धरां नराः॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000322139, "chapter_id": 20322, "verse_number": "१-७६-१४०", "content_sanskrit": "य इदं शृणुयाद्रम्यं गुह्याद्गुह्यं परं हितम् ।\nन तस्य दुर्गतिर्दुःखं दौर्भाग्यं दीनता भुवि॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000322140, "chapter_id": 20322, "verse_number": "१-७६-१४१", "content_sanskrit": "न दैत्यादौ भवेज्जन्म स्वर्लोके शाश्वतं सुखम् ।\nनाकाले मरणं तस्य न च पापैः प्रलिप्यते॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000322141, "chapter_id": 20322, "verse_number": "१-७६-१४२", "content_sanskrit": "इह सर्वजनाध्यक्षस्त्रिदिवे त्रिदिवेश्वरः ।\nकल्पंकल्पं दिवं भुक्त्वा मोक्षमार्गं व्रजत्यसौ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]