[{"id": 5000343000, "chapter_id": 9343, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000343001, "chapter_id": 9343, "verse_number": "५-४-१", "content_sanskrit": "स निर्जित्य पुरीं लंकां श्रेष्ठां तां कामरूपिणीम्।\nविक्रमेण महातेजा हनूमान् कपिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000343002, "chapter_id": 9343, "verse_number": "५-४-२", "content_sanskrit": "अद्वारेण महावीर्यः प्राकारमवपुप्लुवे।\nनिशि लंकां महासत्त्वो विवेश कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000343003, "chapter_id": 9343, "verse_number": "५-४-३", "content_sanskrit": "प्रविश्य नगरीं लंकां कपिराजहितंकरः।\nचक्रेऽथ पादं सव्यं च शत्रूणां स तु मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000343004, "chapter_id": 9343, "verse_number": "५-४-४", "content_sanskrit": "प्रविष्टः सत्त्वसम्पन्नो निशायां मारुतात्मजः।\nस महापथमास्थाय मुक्तपुष्पविराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000343005, "chapter_id": 9343, "verse_number": "५-४-५", "content_sanskrit": "ततस्तु तां पुरीं लंकां रम्यामभिययौ कपिः।\nहसितोत्कृष्टनिनदैस्तूर्यघोषपुरस्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000343006, "chapter_id": 9343, "verse_number": "५-४-६", "content_sanskrit": "वज्राङ्कुशनिकाशैश्च वज्रजालविभूषितैः।\nगृहमेघैः पुरी रम्या बभासे द्यौरिवाम्बुदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000343007, "chapter_id": 9343, "verse_number": "५-४-७", "content_sanskrit": "प्रजज्वाल तदा लंका रक्षोगणगृहैः शुभैः।\nसिताभ्रसदृशैश्चित्रैः पद्मस्वस्तिकसंस्थितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000343008, "chapter_id": 9343, "verse_number": "५-४-८", "content_sanskrit": "वर्धमानगृहैश्चापि सर्वतः सुविभूषितैः।\nतां चित्रमाल्याभरणां कपिराजहितंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000343009, "chapter_id": 9343, "verse_number": "५-४-९", "content_sanskrit": "राघवार्थे चरन् श्रीमान् ददर्श च ननन्द च।\nभवनाद् भवनं गच्छन् ददर्श कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000343010, "chapter_id": 9343, "verse_number": "५-४-१०", "content_sanskrit": "विविधाकृतिरूपाणि भवनानि ततस्ततः।\nशुश्राव रुचिरं गीतं त्रिस्थानस्वरभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000343011, "chapter_id": 9343, "verse_number": "५-४-११", "content_sanskrit": "स्त्रीणां मदनविद्धानां दिवि चाप्सरसामिव।\nशुश्राव काञ्चीनिनदं नूपुराणां च निःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000343012, "chapter_id": 9343, "verse_number": "५-४-१२", "content_sanskrit": "सोपाननिनदांश्चापि भवनेषु महात्मनाम्।\nआस्फोटितनिनादांश्च क्ष्वेडितांश्च ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000343013, "chapter_id": 9343, "verse_number": "५-४-१३", "content_sanskrit": "शुश्राव जपतां तत्र मन्त्रान् रक्षोगृहेषु वै।\nस्वाध्यायनिरतांश्चैव यातुधानान् ददर्श सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000343014, "chapter_id": 9343, "verse_number": "५-४-१४", "content_sanskrit": "रावणस्तवसंयुक्तान् गर्जतो राक्षसानपि।\nराजमार्गं समावृत्य स्थितं रक्षोगणं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000343015, "chapter_id": 9343, "verse_number": "५-४-१५", "content_sanskrit": "ददर्श मध्यमे गुल्मे राक्षसस्य चरान् बहून्।\nदीक्षिताञ्जटिलान् मुण्डान् गोजिनाम्बरवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000343016, "chapter_id": 9343, "verse_number": "५-४-१६", "content_sanskrit": "दर्भमुष्टिप्रहरणानग्निकुण्डायुधांस्तथा।\nकूटमुद‍्गरपाणींश्च दण्डायुधधरानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000343017, "chapter_id": 9343, "verse_number": "५-४-१७", "content_sanskrit": "एकाक्षानेकवर्णांश्च लंबोदरपयोधरान्।\nकरालान् भुग्नवक्त्रांश्च विकटान् वामनांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000343018, "chapter_id": 9343, "verse_number": "५-४-१८", "content_sanskrit": "धन्विनः खड‍‍्गिनश्चैव शतघ्नीमुसलायुधान्।\nपरिघोत्तमहस्तांश्च विचित्रकवचोज्ज्वलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000343019, "chapter_id": 9343, "verse_number": "५-४-१९", "content_sanskrit": "नातिस्थूलान् नातिकृशान् नातिदीर्घातिह्रस्वकान्।\nनातिगौरान् नातिकृष्णान्नातिकुब्जान्न वामनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000343020, "chapter_id": 9343, "verse_number": "५-४-२०", "content_sanskrit": "विरूपान् बहुरूपांश्च सुरूपांश्च सुवर्चसः।\nध्वजिनः पताकिनश्चैव ददर्श विविधायुधान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000343021, "chapter_id": 9343, "verse_number": "५-४-२१", "content_sanskrit": "शक्तिवृक्षायुधांश्चैव पट्टिशाशनिधारिणः।\nक्षेपणीपाशहस्तांश्च ददर्श स महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000343022, "chapter_id": 9343, "verse_number": "५-४-२२", "content_sanskrit": "स्रग्विणस्त्वनुलिप्तांश्च वराभरणभूषितान्।\nनानावेषसमायुक्तान् यथास्वैरचरान् बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000343023, "chapter_id": 9343, "verse_number": "५-४-२३", "content_sanskrit": "तीक्ष्णशूलधरांश्चैव वज्रिणश्च महाबलान्।\nशतसाहस्रमव्यग्रमारक्षं मध्यमं कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000343024, "chapter_id": 9343, "verse_number": "५-४-२४", "content_sanskrit": "रक्षोऽधिपतिनिर्दिष्टं ददर्शान्तःपुराग्रतः।\nस तदा तद् गृहं दृष्ट्वा महाहाटकतोरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000343025, "chapter_id": 9343, "verse_number": "५-४-२५", "content_sanskrit": "राक्षसेन्द्रस्य विख्यातमद्रिमूर्ध्नि प्रतिष्ठितम्।\nपुण्डरीकावतंसाभिः परिखाभिः समावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000343026, "chapter_id": 9343, "verse_number": "५-४-२६", "content_sanskrit": "प्राकारावृतमत्यन्तं ददर्श स महाकपिः।\nत्रिविष्टपनिभं दिव्यं दिव्यनादविनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000343027, "chapter_id": 9343, "verse_number": "५-४-२७", "content_sanskrit": "वाजिह्रेषितसंघुष्टं नादितं भूषणैस्तथा।\nरथैर्यानैर्विमानैश्च तथा हयगजैः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000343028, "chapter_id": 9343, "verse_number": "५-४-२८", "content_sanskrit": "वारणैश्च चतुर्दन्तैः श्वेताभ्रनिचयोपमैः।\nभूषितै रुचिरद्वारं मत्तैश्च मृगपक्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000343029, "chapter_id": 9343, "verse_number": "५-४-२९", "content_sanskrit": "रक्षितं सुमहावीर्यैर्यातुधानैः सहस्रशः।\nराक्षसाधिपतेर्गुप्तमाविवेश गृहं कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000343030, "chapter_id": 9343, "verse_number": "५-४-३०", "content_sanskrit": "स हेमजाम्बूनदचक्रवालं\nमहार्हमुक्तामणि भूषितान्तम्।\nपरार्घ्यकालागुरुचन्दनार्हं\nस रावणान्तःपुरमाविवेश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000343031, "chapter_id": 9343, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]