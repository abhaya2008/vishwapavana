[{"id": 900008851, "chapter_id": 8714, "verse_number": "4.1", "content_sanskrit": "ननु यदुक्तमीश्वरस्य सार्वज्ञ्यादिकमप्रामाणिकमेव बहु कल्प्यमिति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008852, "chapter_id": 8714, "verse_number": "4.2", "content_sanskrit": "अत्र पक्षे जन्यानीत्येवोक्ते ध्वंसस्यापि पक्षत्वेनांशे बाधः स्यात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008853, "chapter_id": 8714, "verse_number": "4.3", "content_sanskrit": "साध्ये यद्यपि ज्ञानचिकीर्षाकृतीनां मध्ये एकैकोक्तावपीश्वर-सिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008854, "chapter_id": 8714, "verse_number": "4.4", "content_sanskrit": "अत्र च भाष्यादौ सकर्तृकत्वनिरुक्तावुपादानपदप्रक्षेपाद् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008855, "chapter_id": 8714, "verse_number": "4.5", "content_sanskrit": "यद्वा क्षितिरेव पक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008856, "chapter_id": 8714, "verse_number": "4.6", "content_sanskrit": "संयोगस्य हेतुत्वे मानं तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008857, "chapter_id": 8714, "verse_number": "4.7", "content_sanskrit": "ननु घटादौ ज्ञानस्य कृतिद्वारैव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008858, "chapter_id": 8714, "verse_number": "4.8", "content_sanskrit": "ननु द्वोषयोनिकृतिसाध्ये चिकीर्षाभावाद्व्यभिचारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008859, "chapter_id": 8714, "verse_number": "4.9", "content_sanskrit": "ननु तथापि घटादौ चेष्टाव्यापारककृतेरेव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008860, "chapter_id": 8714, "verse_number": "4.10", "content_sanskrit": "नन्वथापि ज्ञानमनित्यमेव कर्ता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008861, "chapter_id": 8714, "verse_number": "4.11", "content_sanskrit": "अत्रोच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008862, "chapter_id": 8714, "verse_number": "4.12", "content_sanskrit": "द्रव्यारब्धद्रव्यत्वं चेत् अकार्यत्ववादिनंप्रत्यसिद्धम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008863, "chapter_id": 8714, "verse_number": "4.13", "content_sanskrit": "अत एव भूमेः खननादिना पूर्वावयवविनाशेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008864, "chapter_id": 8714, "verse_number": "4.14", "content_sanskrit": "किञ्च घटादौ दर्शनमात्रेण भूभूधरादेः सावयवत्वेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008865, "chapter_id": 8714, "verse_number": "4.15", "content_sanskrit": "किञ्चास्तु कृतेः कार्यसामान्यंप्रति हेतुत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008866, "chapter_id": 8714, "verse_number": "4.16", "content_sanskrit": "नच कपालगोचरकृतिव्यतिरेकेण घटव्यतिरेक इव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008867, "chapter_id": 8714, "verse_number": "4.17", "content_sanskrit": "किञ्चोपादानशब्दो यदि यत्किञ्चिदुपादानपरस्तदा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008868, "chapter_id": 8714, "verse_number": "4.18", "content_sanskrit": "यच्चोक्तं विशेषयोरन्वयव्यतिरेकेण वा कारणत्वेन वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008869, "chapter_id": 8714, "verse_number": "4.19", "content_sanskrit": "यच्चोक्तमुपादानज्ञानं साक्षात्कारत्वेनैव हेतुरिति तदपि न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008870, "chapter_id": 8714, "verse_number": "4.20", "content_sanskrit": "यच्चोक्तं ज्ञानमनित्यमेवेत्यादि व्याप्तिरमूलेति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008871, "chapter_id": 8714, "verse_number": "4.21", "content_sanskrit": "नचास्या व्याप्तेरस्मदादिज्ञानादिमात्रविषयकत्वात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008872, "chapter_id": 8714, "verse_number": "4.22", "content_sanskrit": "अदृष्टाद्वारकशरीरजन्यत्वमुपाधिश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008873, "chapter_id": 8714, "verse_number": "4.23", "content_sanskrit": "नच कर्तृजन्यत्वंप्रथमं ज्ञातं सच्छरीरजन्यतावच्छेदकत्वेन कल्प्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900008874, "chapter_id": 8714, "verse_number": "4.24", "content_sanskrit": "किञ्चोपाधेर्व्यभिचारोन्नायकत्वपक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900008875, "chapter_id": 8714, "verse_number": "4.25", "content_sanskrit": "अथ मतं आकाशादावजन्यत्वस्यैवाकर्तृकत्वेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900008876, "chapter_id": 8714, "verse_number": "4.26", "content_sanskrit": "अथ मतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900008877, "chapter_id": 8714, "verse_number": "4.27", "content_sanskrit": "अनुमितिप्रयोजकव्याप्तिविरहो हि व्याप्यत्वासिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900008878, "chapter_id": 8714, "verse_number": "4.28", "content_sanskrit": "नन्विहावच्छेदकत्वं न तावदवच्छित्तिप्रत्ययहेतुत्वादिकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900008879, "chapter_id": 8714, "verse_number": "4.29", "content_sanskrit": "अवच्छेदकत्वं हि विशेषणताविशेषरूपः स्वरूपसम्बन्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900008880, "chapter_id": 8714, "verse_number": "4.30", "content_sanskrit": "अत्रोच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900008881, "chapter_id": 8714, "verse_number": "4.31", "content_sanskrit": "नच व्यभिचारेण हेतुतावच्छेदकस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900008882, "chapter_id": 8714, "verse_number": "4.32", "content_sanskrit": "किञ्च हेतुशरीरघटकं द्विविधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900008883, "chapter_id": 8714, "verse_number": "4.33", "content_sanskrit": "अपि च शरीराजन्यत्वादित्यत्र शरीरविशिष्टोऽभावो न हेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900008884, "chapter_id": 8714, "verse_number": "4.34", "content_sanskrit": "नच गगनादौ व्याप्तिग्रहार्थं विशिष्टाभावग्रहकाले..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900008885, "chapter_id": 8714, "verse_number": "4.35", "content_sanskrit": "नन्वेवं वह्न्यनुमापके धूमप्रागभावादौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900008886, "chapter_id": 8714, "verse_number": "4.36", "content_sanskrit": "तदेवं कार्यत्वहेतोर्दुष्टतयाप्रमित्यनुन्मुखत्वाल्लाघवतर्कानुगृहीतेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900008887, "chapter_id": 8714, "verse_number": "4.37", "content_sanskrit": "एतेन अस्तु तर्हि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900008888, "chapter_id": 8714, "verse_number": "4.38", "content_sanskrit": "ऐतेनैव विमतं ब्रह्माण्डादि धारकप्रयत्नवता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900008889, "chapter_id": 8714, "verse_number": "4.39", "content_sanskrit": "नच घटादिनिर्माणं स्वतन्त्रपुरुषविश्रान्तं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900008890, "chapter_id": 8714, "verse_number": "4.40", "content_sanskrit": "नच वाच्यं सर्गादौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900008891, "chapter_id": 8714, "verse_number": "4.41", "content_sanskrit": "ननु त्र्यणुकपरिमाणं सङ्ख्याऽसमवायिकारणकं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900008892, "chapter_id": 8714, "verse_number": "4.42", "content_sanskrit": "सङ्ख्यायोनित्वेऽपि द्व्यणुकपरिमाणंप्रति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900008893, "chapter_id": 8714, "verse_number": "4.43", "content_sanskrit": "किञ्च द्रव्यारम्भकत्वेन क्लृप्तस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900008894, "chapter_id": 8714, "verse_number": "4.44", "content_sanskrit": "किञ्च द्वित्वादेरपेक्षाबुद्धिजन्यतैव न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900008895, "chapter_id": 8714, "verse_number": "4.45", "content_sanskrit": "नच परमाणुपरिमाणं परिमाणानारम्भकं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900008896, "chapter_id": 8714, "verse_number": "4.46", "content_sanskrit": "ननु तूलपिण्डादिपरिमाणेप्रचयाख्यसंयोगविशेषस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]