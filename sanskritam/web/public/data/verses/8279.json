[{"id": 900003218, "chapter_id": 8279, "verse_number": "13.1", "content_sanskrit": "प्रकृतिं पुरुषं चैव क्षेत्रं क्षेत्रज्ञमेव च । एतद्वेदितुमिच्छामि ज्ञानं ज्ञेयं च केशव ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003219, "chapter_id": 8279, "verse_number": "13.2", "content_sanskrit": "इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते । एतद्यो वेत्ति तं प्राहुः क्षेत्रज्ञ इति तद्विदः ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003220, "chapter_id": 8279, "verse_number": "13.3", "content_sanskrit": "क्षेत्रज्ञं चापि मां विद्धि सर्वक्षेत्रेषु भारत । क्षेत्रक्षेत्रज्ञयोर्ज्ञानं यत् तज्ज्ञानं मतं मम ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003221, "chapter_id": 8279, "verse_number": "13.4", "content_sanskrit": "तत् क्षेत्रं यच्च यादृक्च यद्विकारि यतश्च यत् । स च यो यत्प्रभावश्च तत्समासेन मे शृणु ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003222, "chapter_id": 8279, "verse_number": "13.5", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003223, "chapter_id": 8279, "verse_number": "13.6", "content_sanskrit": "ऋषिभिर्बहुधा गीतं छन्दोभिर्विविधैः पृथक् । ब्रह्मसूत्रपदैश्चैव हेतुमद्भिर्विनिश्चितैः ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003224, "chapter_id": 8279, "verse_number": "13.7", "content_sanskrit": "महाभूतान्यहङ्कारो बुद्धिरव्यक्तमेव च । इन्द्रियाणि दशैकं च पञ्च चेन्द्रियगोचराः ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003225, "chapter_id": 8279, "verse_number": "13.8", "content_sanskrit": "इच्छा द्वेषः सुखं दुःखं सङ्घातश्चेतना धृतिः । एतत् क्षेत्रं समासेन सविकारमुदाहृतम् ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003226, "chapter_id": 8279, "verse_number": "13.9", "content_sanskrit": "अमानित्वमदम्भित्वमहिंसा क्षान्तिरार्जवम् । आचार्योपासनं शौचं स्थैर्यमात्मविनिग्रहः ।। ८ ।। इन्द्रियार्थेषु वैराग्यमनहङ्कार एव च । जन्ममृत्युजराव्याधिदुःखदोषानुदर्शनम् ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003227, "chapter_id": 8279, "verse_number": "13.10", "content_sanskrit": "असक्तिरनभिष्वङ्गः पुत्रदारगृहादिषु । नित्यं च समचित्तत्वमिष्टानिष्टोपपत्तिषु ।। १० ।। मयि चानन्ययोगेन भक्तिरव्यभिचारिणी । विविक्तदेशसेवित्वमरतिर्जनसंसदि ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003228, "chapter_id": 8279, "verse_number": "13.11", "content_sanskrit": "अध्यात्मज्ञाननित्यत्वं तत्त्वज्ञानार्थदर्शनम् । एतज्ज्ञानमिति प्रोक्तमज्ञानं यदतोऽन्यथा ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003229, "chapter_id": 8279, "verse_number": "13.12", "content_sanskrit": "ज्ञेयं यत्तत् प्रवक्ष्यामि यज्ज्ञात्वाऽमृतमश्नुते । अनादिमत् परं ब्रह्म न सत्तन्नासदुच्यते ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003230, "chapter_id": 8279, "verse_number": "13.13", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003231, "chapter_id": 8279, "verse_number": "13.14", "content_sanskrit": "सर्वतः पाणिपादं तत् सर्वतोऽक्षिशिरोमुखम् । सर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003232, "chapter_id": 8279, "verse_number": "13.15", "content_sanskrit": "सर्वेन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम् । असक्तं सर्वभृच्चैव निर्गुणं गुणभोक्तृ च ।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003233, "chapter_id": 8279, "verse_number": "13.16", "content_sanskrit": "बहिरन्तश्च भूतानामचरं चरमेव च । सूक्ष्मत्वात् तदविज्ञेयं दूरस्थं चान्तिके च तत् ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003234, "chapter_id": 8279, "verse_number": "13.17", "content_sanskrit": "अविभक्तं च भूतेषु विभक्तमिव च स्थितम् । भूतभर्तृ च तज्ज्ञेयं ग्रसिष्णु प्रभविष्णु च ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003235, "chapter_id": 8279, "verse_number": "13.18", "content_sanskrit": "ज्योतिषामपि तज्ज्योतिस्तमसः परमुच्यते । ज्ञानं ज्ञेयं ज्ञानगम्यं हृदि सर्वस्य विष्ठितम् ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003236, "chapter_id": 8279, "verse_number": "13.19", "content_sanskrit": "इति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः । मद्भक्त एतद्विज्ञाय मद्भावायोपपद्यते ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003237, "chapter_id": 8279, "verse_number": "13.20", "content_sanskrit": "प्रकृतिं पुरुषं चैव विद्ध्यनादी उभावपि । विकारांश्च गुणांश्चैव विद्धि प्रकृतिसम्भवान् ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003238, "chapter_id": 8279, "verse_number": "13.21", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003239, "chapter_id": 8279, "verse_number": "13.22", "content_sanskrit": "कार्यकारणकर्तृत्वे हेतुः प्रकृतिरुच्यते । पुरुषः सुखदुःखानां भोक्तृत्वे हेतुरुच्यते ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003240, "chapter_id": 8279, "verse_number": "13.23", "content_sanskrit": "पुरुषः प्रकृतिस्थो हि भुङ्क्ते प्रकृतिजान् गुणान् । कारणं गुणसङ्गोऽस्य सदसद्योनिजन्मसु ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003241, "chapter_id": 8279, "verse_number": "13.24", "content_sanskrit": "उपद्रष्टाऽनुमन्ता च भर्ता भोक्ता महेश्वरः । परमात्मेति चाप्युक्तो देहेऽस्मिन् पुरुषः परः ।। २३ ।। य एवं(एनं ) वेत्ति पुरुषं प्रकृतिं च गुणैः सह । सर्वथा वर्तमानोऽपि न स भूयोऽभिजायते ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900003242, "chapter_id": 8279, "verse_number": "13.25", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900003243, "chapter_id": 8279, "verse_number": "13.26", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900003244, "chapter_id": 8279, "verse_number": "13.27", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900003245, "chapter_id": 8279, "verse_number": "13.28", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900003246, "chapter_id": 8279, "verse_number": "13.29", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900003247, "chapter_id": 8279, "verse_number": "13.30", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900003248, "chapter_id": 8279, "verse_number": "13.31", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900003249, "chapter_id": 8279, "verse_number": "13.32", "content_sanskrit": "ध्यानेनाऽत्मनि पश्यन्ति केचिदात्मानमात्मना । अन्ये साङ्ख्येन योगेन कर्मयोगेन चापरे ।। २५ ।। अन्ये त्वेवमजानन्तः श्रुत्वाऽन्येभ्य उपासते । तेऽपि चातितरन्त्येव मृत्युं श्रुतिपरायणाः ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900003250, "chapter_id": 8279, "verse_number": "13.33", "content_sanskrit": "यावत् सञ्जायते किञ्चित् सत्त्वं स्थावरजङ्गमम् । क्षेत्रक्षेत्रज्ञसंयोगात् तद्विद्धि भरतर्षभ ।। २७ ।। समं सर्वेषु भूतेषु तिष्ठन्तं परमेश्वरम् । विनश्यत्स्वविनश्यन्तं यः पश्यति स पश्यति ।। २८ ।। समं पश्यन्ति सर्वत्र समवस्थितमीश्वरम् । न हिनस्त्यात्मनाऽऽत्मानं ततो याति परां गतिम् ।। २९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900003251, "chapter_id": 8279, "verse_number": "13.34", "content_sanskrit": "प्रकृत्यैव च कर्माणि क्रियमाणानि सर्वशः । यः पश्यति तथाऽऽत्मानमकर्तारं स पश्यति ।। ३० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900003252, "chapter_id": 8279, "verse_number": "13.35", "content_sanskrit": "यदा भूतपृथग्भावमेकस्थमनुपश्यति । तत एव च विस्तारं ब्रह्म सम्पद्यते तदा ।। ३१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900003253, "chapter_id": 8279, "verse_number": "13.36", "content_sanskrit": "अनादित्वान्निर्गुणत्वात् परमात्माऽयमव्ययः । शरीरस्थोऽपि कौन्तेय न करोति न लिप्यते ।। ३२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900003254, "chapter_id": 8279, "verse_number": "13.37", "content_sanskrit": "यथा सर्वगतं सौक्ष्म्यादाकाशं नोपलिप्यते । सर्वत्रावस्थितो देहे तथाऽऽत्मा नोपलिप्यते ।। ३३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900003255, "chapter_id": 8279, "verse_number": "13.38", "content_sanskrit": "यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः । क्षेत्रं क्षेत्री तथा कृत्स्नं प्रकाशयति भारत ।। ३४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900003256, "chapter_id": 8279, "verse_number": "13.39", "content_sanskrit": "क्षेत्रक्षेत्रज्ञयोरेवमन्तरं ज्ञानचक्षुषा । भूतप्रकृतिमोक्षं च ये विदुर्यान्ति ते परम् ।। ३५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]