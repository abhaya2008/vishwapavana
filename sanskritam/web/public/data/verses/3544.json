[{"id": 2118197, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118198, "chapter_id": 3544, "verse_number": "१", "content_sanskrit": "वृष्ण्यन्धकपुरान्मोक्षमपयानं धनञ्जयः ।\nविनिश्चित्य तदा पार्थः सुभद्रामिदमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118199, "chapter_id": 3544, "verse_number": "२", "content_sanskrit": "शृणु भद्रे यथाशास्त्रं हितार्थमृषिभिः कृतम् ।\nकन्यायास्तु पिता भ्राता माता मातुल एव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118200, "chapter_id": 3544, "verse_number": "३", "content_sanskrit": "पितुर्भ्राता गुरुश्चापि दातुं प्रभवतां गताः ।\nमहोत्सवं पशुपतेर्द्रष्टुकामः पिता गतः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118201, "chapter_id": 3544, "verse_number": "४", "content_sanskrit": "अन्तर्द्वीपं गतो भद्रे पुत्रैः पौत्रैः सबान्धवैः ।\nमम चैव विशालाक्षि विदेशस्थास्तु वान्धवाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118202, "chapter_id": 3544, "verse_number": "५", "content_sanskrit": "तस्मात् सुभद्रे गान्धर्वो विवाहः पञ्चमो भवेत् ।\nसमागमे तु कन्यायाः क्रियाः प्रोक्ताश्चतुर्विधाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118203, "chapter_id": 3544, "verse_number": "६", "content_sanskrit": "तासां प्रवृत्तिं साधूनां शृणु माधवि तद्यथा ।\nवरमाहूय विधिना पित्रा दत्ता यथाऽर्थिने \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118204, "chapter_id": 3544, "verse_number": "७", "content_sanskrit": "सा पत्नी तु बुधैरुक्ता सा वश्या तु पतिव्रता ।\nभृत्यानां भरणार्थाय आत्मनः पोषणाय च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118205, "chapter_id": 3544, "verse_number": "८", "content_sanskrit": "दाने गृहीता या नारी सा भार्येति बुधैर्मता ।\nधर्मतो वरयित्वा तु आनीय स्वं निवेशनम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118206, "chapter_id": 3544, "verse_number": "९", "content_sanskrit": "न्यायेन दत्ता तारुण्ये दाराः पितृकृता भवेत् ।\nजायते याऽनु भर्तारं जाया इत्येव नामतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118207, "chapter_id": 3544, "verse_number": "१०", "content_sanskrit": "दाराः पत्नी च भार्या च जाया चेति चतुर्विधाः ।\nचतस्र एवाग्निसाक्ष्याः क्रियायुक्तास्तु धर्मतः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118208, "chapter_id": 3544, "verse_number": "११", "content_sanskrit": "गान्धर्वेण विवाहेन रागात् पुत्रार्थकारणात् ।\nआत्मनाऽनुगृहीता या वश्या सा तु प्रजावती \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118209, "chapter_id": 3544, "verse_number": "१२", "content_sanskrit": "गान्धर्वस्तु क्रियाहीनो रागादेव प्रवर्तते ।\nसकामायाः सकामेन निर्मन्त्रो रहसा कृतः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118210, "chapter_id": 3544, "verse_number": "१३", "content_sanskrit": "मयोक्तमक्रियं चापि कर्तव्यं माधवि त्वया ।\nअयनं चैव मासश्च ऋक्षं पक्षस्तथा तिथिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118211, "chapter_id": 3544, "verse_number": "१४", "content_sanskrit": "करणं च मुहूर्तं च लग्नसम्पत् तथाऽद्य वै ।\nविवाहस्य विशालाक्षि प्रशस्तं चोत्तरायणम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118212, "chapter_id": 3544, "verse_number": "१५", "content_sanskrit": "वैशाखश्चैव मासानां पक्षाणां शुभ्र एव च ।\nनक्षत्राणां तथा हस्तस्तृतीया च तिथिष्वपि \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118213, "chapter_id": 3544, "verse_number": "१६", "content_sanskrit": "लग्नो हि मकरः श्रेष्ठः करणानां बवस्तथा ।\nमैत्रो मुहूर्तो वैवाह्य आवयोः शुभकर्मणि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118214, "chapter_id": 3544, "verse_number": "१७", "content_sanskrit": "सर्वसम्पदियं भद्रे अद्य रात्रौ भविष्यति ।\nभगवानस्तमभ्येति आदित्यस्तपतां वरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118215, "chapter_id": 3544, "verse_number": "१८", "content_sanskrit": "नारायणोऽपि धर्मज्ञो नावबुध्येत विश्वकृत् ।\nधर्मसङ्कटमापन्ने किं नु कृत्वा शुभं भवेत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118216, "chapter_id": 3544, "verse_number": "१९", "content_sanskrit": "मनोभवेन कामेन मोहितं मां प्रलापिनम् ।\nप्रतिवाक्यं च मे देवि किं न वक्ष्यसि माधवि \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118217, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118218, "chapter_id": 3544, "verse_number": "२०", "content_sanskrit": "अर्जुनस्य वचः श्रुत्वा चिन्तयन्ती जनार्दनम् ।\nनोवाच किञ्चिद् वचनं बाष्पदूषितलोचना \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118219, "chapter_id": 3544, "verse_number": "२१", "content_sanskrit": "रागोन्मादप्रलापी सन्नर्जुनो जयतां वरः ।\nचिन्तयामास पितरं प्रविश्य च लतागृहम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118220, "chapter_id": 3544, "verse_number": "२२", "content_sanskrit": "चिन्तयानं तु कौन्तेयं ज्ञात्वा शच्या शचीपतिः ।\nसहितो नारदाद्यैस्तु मुनिसिद्धाप्सरोगणैः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118221, "chapter_id": 3544, "verse_number": "२३", "content_sanskrit": "अरुन्धत्या वसिष्ठेन आजगाम कुशस्थलीम् ।\nचिन्तितं च सुभद्रायाः चिन्तयित्वा जनार्दनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118222, "chapter_id": 3544, "verse_number": "२४", "content_sanskrit": "निद्रयाऽपहृतज्ञानं रौहिणेयं विना तदा ।\nसहाक्रूरेण शिनिना सत्यकेन गदेन च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118223, "chapter_id": 3544, "verse_number": "२५", "content_sanskrit": "वसुदेवेन देवक्या आहुकेन च धीमता ।\nआजगाम पुरीं रात्रौ द्वारकां स्वजनैर्वृतः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118224, "chapter_id": 3544, "verse_number": "२६", "content_sanskrit": "पूजयित्वा तु देवेशं नारदाद्यैर्महर्षिभिः ।\nकुशलप्रश्नमुक्त्वा तु देवेन्द्रेणाभियाचितः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118225, "chapter_id": 3544, "verse_number": "२७", "content_sanskrit": "वैवाहिकीं क्रियां कृष्णस्तथेत्येवमुवाच ह ।\nआहुको वसुदेवश्च सहाक्रूरः ससात्यकिः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118226, "chapter_id": 3544, "verse_number": "२८", "content_sanskrit": "अभिप्रणम्य शिरसा पाकशासनमब्रुवन् ।\nदेवदेव नमस्तेऽस्तु लोकनाथ जगत्पते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118227, "chapter_id": 3544, "verse_number": "२९", "content_sanskrit": "वयं धन्याः स्म लोकेषु बान्धवैः सहिताः प्रभो ।\nकृतप्रसादास्तु वयं तव वाक्येन विश्वजित्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118228, "chapter_id": 3544, "verse_number": "३०", "content_sanskrit": "एवमुक्त्वा प्रसाद्यैनं पूजयित्वा प्रयत्नतः ।\nमहेन्द्रशासनात् सर्वे सहिताश्च महर्षिभिः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118229, "chapter_id": 3544, "verse_number": "३१", "content_sanskrit": "विवाहं कारयामासुः शक्रपुत्रस्य शास्त्रतः ।\nअरुन्धती शची देवी रुग्मिणी देवकी तथा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118230, "chapter_id": 3544, "verse_number": "३२", "content_sanskrit": "दिव्यस्त्रीभिश्च सहिताः क्रियां भद्रे प्रयोजयन् ।\nमहर्षिः काश्यपो होता सदस्या नारदादयः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118231, "chapter_id": 3544, "verse_number": "३३", "content_sanskrit": "पुण्याशिषः प्रयोक्तारः सर्वे ह्यासंस्तदाऽर्जुने ।\nअभिषेकं ततः कृत्वा महेन्द्रः पाकशासनिम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118232, "chapter_id": 3544, "verse_number": "३४", "content_sanskrit": "लोकपालैस्तु सहितः सर्वदेवैरभिष्टुतः ।\nकिरीटाङ्गदहाराद्यैर्हस्ताभरणकुण्डलैः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118233, "chapter_id": 3544, "verse_number": "३५", "content_sanskrit": "भूषयित्वा तदा पार्थं द्वितीयमिव वासवम् ।\nपार्थं परिष्वज्य तदा प्रीतिमाप पुरन्दरः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118234, "chapter_id": 3544, "verse_number": "३६", "content_sanskrit": "शची देवी तदा भद्रामरुन्धत्यादिभिस्तथा ।\nकारयामास वैवाह्यान् माङ्गल्यान् यादवस्त्रियः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118235, "chapter_id": 3544, "verse_number": "३७", "content_sanskrit": "सहाप्सरोभिर्मुदिता भूषणैश्चाभ्यभूषयन् ।\nपौलोमीमिव मन्यन्ते सुभद्रां भद्रभाषिणीम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118236, "chapter_id": 3544, "verse_number": "३८", "content_sanskrit": "ततो विवाहो ववृते स्फीतः सर्वगुणान्वितः ।\nतस्याः पाणिं गृहीत्वाऽसौ मन्त्रहोमपुरस्कृतः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118237, "chapter_id": 3544, "verse_number": "३९", "content_sanskrit": "यथा तस्यैव हि पिता शच्या इव शतक्रतुः ।\nसा जिष्णुमधिकं भेजे सुभद्रा चारुदर्शना \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118238, "chapter_id": 3544, "verse_number": "४०", "content_sanskrit": "पार्थस्य सदृशी भद्रा रूपेण वयसा तथा ।\nसुभद्रायाश्च पार्थोऽपि सदृशो रूपलक्षणैः \t॥ ४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118239, "chapter_id": 3544, "verse_number": "४१", "content_sanskrit": "इत्यूचुः स्म तदा देवाः प्रीताः सेन्द्रपुरोगमाः ।\nएवं निवेश्य देवास्तु गन्धर्वैश्चाप्सरोगणैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118240, "chapter_id": 3544, "verse_number": "४२", "content_sanskrit": "आमन्त्र्य यादवांत्सर्वे विप्रजग्मुर्यथागतम् ।\nयादवाः पार्थमामन्त्र्य अन्तर्द्वीपं गतास्तदा \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118241, "chapter_id": 3544, "verse_number": "४३", "content_sanskrit": "वासुदेवस्तदा पार्थमुवाच यदुनन्दनः ।\nद्वाविंशद्दिवसान् पार्थ इहोष्य भरतर्षभ \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2118242, "chapter_id": 3544, "verse_number": "४४", "content_sanskrit": "मामकं रथमारुह्य सैन्यसुग्रीवयोजितम् ।\nसुभद्रया सुखं पार्थ खाण्डवप्रस्थमाविश \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2118243, "chapter_id": 3544, "verse_number": "४५", "content_sanskrit": "यादवैः सहितः पश्चादागमिष्यामि भारत ।\nयतिवेषेण निरतो वसेस्त्वं रुग्मिणीवृतः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2118244, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2118245, "chapter_id": 3544, "verse_number": "४६", "content_sanskrit": "एवमुक्त्वा प्रचक्राम अन्तर्द्वीपं जनार्दनः ।\nकृतोद्वाहस्तदा पार्थः कृतकार्योऽभवत् तदा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2118246, "chapter_id": 3544, "verse_number": "४७", "content_sanskrit": "तस्यां चोत्पतितो भावः पार्थस्य सहसाऽऽगतः ।\nस तया युयुजे वीरो भद्रया भरतर्षभः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2118247, "chapter_id": 3544, "verse_number": "४८", "content_sanskrit": "अभिनिष्पन्नया रामः सीतयेव समन्वितः ।\nस हि जिष्णुर्विजज्ञे तां ह्रीं श्रियं सन्नतिं क्रियाम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2118248, "chapter_id": 3544, "verse_number": "४९", "content_sanskrit": "द्वादशानां वरस्त्रीणां रूपेणासदृशीं सतीम् ।\nस प्रकृत्या श्रिया दीप्तः सन्दिदीपे तयाऽधिकम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2118249, "chapter_id": 3544, "verse_number": "५०", "content_sanskrit": "उद्यत्सहस्रदीप्तांशुः शरदीव दिवाकरः ।\nसा तु तं मनुजव्याघ्रमनुरक्ता मनस्विनी ।\nकन्या पुरगता भूत्वा तत्प्रसादमपद्यत \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2118250, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2118251, "chapter_id": 3544, "verse_number": "५१", "content_sanskrit": "वृष्ण्यन्धकपुरात् तत्र अपयातुं धनञ्जयः ।\nविनिश्चित्य तदा पार्थः सुभद्रामिदमब्रवीत् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2118252, "chapter_id": 3544, "verse_number": "५२", "content_sanskrit": "द्विजानां गणमुख्यानां यथार्हं प्रतिप्रादय ।\nभोज्यैर्भक्ष्यैश्च पेयैश्च प्रयच्छ प्रतियास्यताम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2118253, "chapter_id": 3544, "verse_number": "५३", "content_sanskrit": "आत्मनश्च समुद्दिश्य महाव्रतसमापनम् ।\nगच्छ भद्रे स्वयं तूर्णं महाराजनिवेशनम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2118254, "chapter_id": 3544, "verse_number": "५४", "content_sanskrit": "तेजोबलजवोपेतैः श्लक्ष्णैर्हयवरोत्तमैः ।\nशैब्यसुग्रीवसंयुक्तं रथं तूर्णमिहानय \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2118255, "chapter_id": 3544, "verse_number": "५५", "content_sanskrit": "व्रतार्थमिव भाषित्वा सखीभिः सुभगे सह ।\nक्षिप्रमादाय पर्येहि सह सर्वायुधानि च \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2118256, "chapter_id": 3544, "verse_number": "५६", "content_sanskrit": "अनुकर्षपताकाश्च तूणीरांश्च धनूंषि च ।\nसर्वान् रथवरे कुर्याः सोत्सेधाश्च महागदाः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2118257, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2118258, "chapter_id": 3544, "verse_number": "५७", "content_sanskrit": "अर्जुनेनैवमुक्ता सा सुभद्रा भद्रभाषिणी ।\nजगाम नृपतेर्वेश्म सखीभिस्त्वरिता सह \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2118259, "chapter_id": 3544, "verse_number": "५८", "content_sanskrit": "क्रीडार्थमिति तत्रस्थान् रक्षिणो वाक्यमब्रवीत् ।\nरथेनानेन यास्यामि महाव्रतसमापनम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2118260, "chapter_id": 3544, "verse_number": "५९", "content_sanskrit": "शैब्यसुग्रीवयुक्तेन सायुधेन च शार्ङ्गिणः ।\nसुभद्रयैवमुक्ते तु जनाः प्राञ्जलयोऽभवन् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2118261, "chapter_id": 3544, "verse_number": "६०", "content_sanskrit": "रथेनानेन भद्रे त्वं यथेष्टं क्रियतामिति ।\nयोजयित्वा रथवरं कल्याणैरभिभाष्य तान् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2118262, "chapter_id": 3544, "verse_number": "६१", "content_sanskrit": "यथोक्तं सर्वमारोप्य आयुधानि च भामिनी ।\nक्षिप्रमादाय कल्याणी सुभद्राऽर्जुनमब्रवीत् \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2118263, "chapter_id": 3544, "verse_number": "६२", "content_sanskrit": "रथोऽयं रथिनां श्रेष्ठ आनीतस्तव शासनात् ।\nस्वस्ति याहि यथाकामं कुरून् कौरवनन्दन \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2118264, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2118265, "chapter_id": 3544, "verse_number": "६३", "content_sanskrit": "निवेद्य तु रथं भर्तुः सुभद्रा भद्रसम्मता ।\nब्राह्मणानां ददौ हृष्टा तदा सा विविधं वसु \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2118266, "chapter_id": 3544, "verse_number": "६४", "content_sanskrit": "स्नेहवन्ति च भोज्यनि प्रददावीप्सितानि च ।\nयथाकामं यथाश्रद्धं वस्त्राणि विविधानि च \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2118267, "chapter_id": 3544, "verse_number": "६५", "content_sanskrit": "तर्पिता विविधैर्भक्ष्यैस्तान्यवाप्य वसूनि च ।\nब्राह्मणाः स्वगृहं जम्मुः प्रयुज्य परमाशिषः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2118268, "chapter_id": 3544, "verse_number": "६६", "content_sanskrit": "सुभद्रया तु विज्ञप्तः पूर्वमेव धनञ्जयः ।\nअभीशुग्रहणे पार्थ न मेऽस्ति सदृशो भुवि \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2118269, "chapter_id": 3544, "verse_number": "६७", "content_sanskrit": "तस्मात् सा पूर्वमारुह्य रश्मीन् जग्राह माधवी ।\nसोदरा वासुदेवस्य कृतस्वस्त्ययना हयान् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2118270, "chapter_id": 3544, "verse_number": "६८", "content_sanskrit": "व्यत्ययित्वा तु तल्लिङ्गं समुच्छ्रितमहाधनुः ।\nआरुरोह रथश्रेष्ठं शुक्लवासा धनञ्जयः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2118271, "chapter_id": 3544, "verse_number": "६९", "content_sanskrit": "महेन्द्रदत्तं मकुटं तथा ह्याभरणानि च ।\nअलङ्कृत्य तु कौन्तेयः प्रयातुमुपचक्रमे \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2118272, "chapter_id": 3544, "verse_number": "७०", "content_sanskrit": "ततः कन्यापुरे घोषस्तुमुलः समपद्यत ।\nदृष्ट्वा रथगतं पार्थं खङ्गबाणधनुर्धरम् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2118273, "chapter_id": 3544, "verse_number": "७१", "content_sanskrit": "अभीशुहस्तां सुश्रोणीमर्जुनेन रथे स्थिताम् ।\nजगुः कन्यापुरे कन्या वासुदेवसहोदराम् \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2118274, "chapter_id": 3544, "verse_number": "७२", "content_sanskrit": "सर्वे कामाः समृद्धास्ते सुभद्रे भद्रभाषिणि ।\nवासुदेवप्रियं लब्ध्वा भर्तारं वीरमर्जुनम् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2118275, "chapter_id": 3544, "verse_number": "७३", "content_sanskrit": "सर्वसीमन्तिनीनां त्वं श्रेष्ठा कृष्णसहोदरे ।\nयस्मात् सर्वमनुष्याणां श्रेष्ठो भर्ता तवार्जुनः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2118276, "chapter_id": 3544, "verse_number": "७४", "content_sanskrit": "उपपन्नस्त्वया वीरः सर्वलोकमहारथः ।\nस्वस्ति याहि गृहं भद्रे सुहृद्भिः सङ्गमोऽस्तु ते \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2118277, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2118278, "chapter_id": 3544, "verse_number": "७५", "content_sanskrit": "एवमुक्ता प्रहृष्टाभिः सखीभिः प्रतिनन्दिता ।\nभद्रा भद्रजवोपेतानश्वान् पुनरचोदयत् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2118279, "chapter_id": 3544, "verse_number": "७६", "content_sanskrit": "पार्श्वे वामे पुरस्ताच्च सखा तस्याग्रणीरिव ।\nअथ कन्यापुरद्वारात् सघोषमभिनिःसृतम् \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2118280, "chapter_id": 3544, "verse_number": "७७", "content_sanskrit": "ददृशुस्तं रथश्रेष्ठं जना जीमूतनिस्वनम् ।\nसुभद्रासङ्गृहीतस्य रथस्य महतो रवम् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2118281, "chapter_id": 3544, "verse_number": "७८", "content_sanskrit": "मेघस्वनमिवाकाशे शुश्रुवुः पुरवासिनः ।\nसुभद्रया च सम्पन्ने तिष्ठन् रथवरेऽर्जुनः \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2118282, "chapter_id": 3544, "verse_number": "७९", "content_sanskrit": "प्रबभौ परयोपेतः कैलास इव गङ्गया ।\nपार्थः सुभद्रासहितो विरराज महारथः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2118283, "chapter_id": 3544, "verse_number": "८०", "content_sanskrit": "पार्थस्यैव पिता शक्रो यथा शच्या समन्वितः ।\nसुभद्रां प्रेक्ष्य धर्मेण ह्रियमाणां यशस्विनीम् \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2118284, "chapter_id": 3544, "verse_number": "८१", "content_sanskrit": "चक्रुः किलकिलाशब्दमासाद्य बहवो जनाः ।\nदाशार्हाणां कुलस्य श्रीः सुभद्रा भद्रभाषिणी \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2118285, "chapter_id": 3544, "verse_number": "८२", "content_sanskrit": "अभिकामा सकामेन पार्थेन सह गच्छति ।\nअथापरे तु सङ्क्रुद्धा गृह्णीत घ्नत माचिरम् \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2118286, "chapter_id": 3544, "verse_number": "समाप्तिः", "content_sanskrit": "इति सम्भाषमाणानां सन्नादः सुमहानभूत् ।\nस तेन जनघोषेण वीरो गज इवार्दितः \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2118287, "chapter_id": 3544, "verse_number": "८४", "content_sanskrit": "ववर्ष शरवर्षाणि न तु कञ्चन रोषयत् ।\nमुमोच निशितान् बाणान् दीप्यमानान् स्वतेजसा\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2118288, "chapter_id": 3544, "verse_number": "८५", "content_sanskrit": "प्रासादवरसङ्घेषु हर्म्येषु भवनेषु च ।\nक्षोभयित्वा पुरश्रेष्ठं गरुत्मानिव सागरम् ।\nप्रेक्षन् रैवतकद्वारं निर्ययौ भरतर्षभः \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2118289, "chapter_id": 3544, "verse_number": "२२३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रयोविंशत्यधिकद्विशततमोऽध्यायः ॥२२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2118290, "chapter_id": 3544, "verse_number": "४", "content_sanskrit": "॥ इति सुभद्राहरणपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2118291, "chapter_id": 3544, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]