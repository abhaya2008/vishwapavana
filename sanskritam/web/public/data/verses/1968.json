[{"id": 2043291, "chapter_id": 1968, "verse_number": "६-१७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043292, "chapter_id": 1968, "verse_number": "६-१७-१", "content_sanskrit": "यथा स भगवान्व्यासः कृष्णद्वैपायनोऽब्रवीत्।\nतथैव सहिताः सर्वे समाजग्मुर्महीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043293, "chapter_id": 1968, "verse_number": "६-१७-२", "content_sanskrit": "मघाविषयगः सोमस्तद्दिनं प्रत्यपद्यत।\nदीप्यमानाश्च संपेतुर्दिवि सप्त महग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043294, "chapter_id": 1968, "verse_number": "६-१७-३", "content_sanskrit": "द्विधाभूत इवादित्य उदये प्रत्यदृश्यत।\nज्वलन्त्या शिखया भूयो भानुमानुदितो रविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043295, "chapter_id": 1968, "verse_number": "६-१७-४", "content_sanskrit": "ववाशिरे च दीप्तायां दिशि गोमायुवायसाः ।\nलिप्समानाः शरीराणि मांसशोणितभोजनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043296, "chapter_id": 1968, "verse_number": "६-१७-५", "content_sanskrit": "अहन्यहनि पार्थानां वृद्धः कुरुपितामहः ।\nभरद्वाजात्मजश्चैव प्रातरुत्थाय संयतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043297, "chapter_id": 1968, "verse_number": "६-१७-६", "content_sanskrit": "जयोऽस्तु पाण्डुपुत्राणामित्यूचतुरिन्दमौ ।\nयुयुधाते तवार्थाय यथा स समयः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043298, "chapter_id": 1968, "verse_number": "६-१७-७", "content_sanskrit": "सर्वधर्मविशेषज्ञः पिता देवव्रतस्तव ।\nसमानीय महीपालानिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043299, "chapter_id": 1968, "verse_number": "६-१७-८", "content_sanskrit": "इदं वः क्षत्रिया द्वारं स्वर्गायापावृतं महत्।\nगच्छध्वं तेन शक्रस्य ब्रह्मणः सहलोकताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043300, "chapter_id": 1968, "verse_number": "६-१७-९", "content_sanskrit": "एष वः शाश्वतः पन्थाः पूर्वैः पूर्वतरैः कृतः ।\nसंभावयध्वमात्मानमव्यग्रमनसो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043301, "chapter_id": 1968, "verse_number": "६-१७-१०", "content_sanskrit": "नाभागोऽथ ययातिश्च मान्धाता नहुषो नृगः ।\nसंसिद्धाः परमं स्थानं गताः कर्मभिरीदृशैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043302, "chapter_id": 1968, "verse_number": "६-१७-११", "content_sanskrit": "अधर्मः क्षत्रियस्यैष यद्व्याधिमरणं गृहे ।\nयदयोनिधनं याति सोऽस्य धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043303, "chapter_id": 1968, "verse_number": "६-१७-१२", "content_sanskrit": "एवमुक्ता महीपाला भीष्मेण भरतर्षभ।\nनिर्ययुः स्वान्यनीकानि शोभयन्तो रथोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043304, "chapter_id": 1968, "verse_number": "६-१७-१३", "content_sanskrit": "स तु वैकर्तनः कर्णः सामात्यः सह बन्धुभिः ।\nन्यासितः समरे शस्त्रं भीष्मेण भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043305, "chapter_id": 1968, "verse_number": "६-१७-१४", "content_sanskrit": "अपेतकर्णाः पुत्रास्ते राजनश्चैव तावकाः ।\nनिर्ययुः सिंहनादेन नादयन्तो दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043306, "chapter_id": 1968, "verse_number": "६-१७-१५", "content_sanskrit": "श्वेतैश्छत्रैः पताकाभिर्ध्वजवारणवाजिभिः ।\nतान्यनीकानि शोभन्ते गजैरथ पदातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043307, "chapter_id": 1968, "verse_number": "६-१७-१६", "content_sanskrit": "भेरीपणवशब्दैश्च दुन्दुभीनां च निःस्वनैः ।\nरथनेमिनिनादैश्च बभूवाकुलिता मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043308, "chapter_id": 1968, "verse_number": "६-१७-१७", "content_sanskrit": "काञ्चनाङ्गदकेयूरैः कार्मुकैश्च महारथाः ।\nभ्राजमाना व्यराजन्त साग्नयः पर्वता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043309, "chapter_id": 1968, "verse_number": "६-१७-१८", "content_sanskrit": "तालेन महता भीष्मः पञ्चतारेण केतुना ।\nविमलादित्यसंकाशस्तस्थौ कुरुचमूपरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043310, "chapter_id": 1968, "verse_number": "६-१७-१९", "content_sanskrit": "ये त्वदीया महेष्वासा राजानो भरतर्षभ ।\nअवर्तन्त यथादेशं राजञ्शान्तनवस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043311, "chapter_id": 1968, "verse_number": "६-१७-२०", "content_sanskrit": "स तु गोवासनः शैब्यः सहितः सर्वराजभिः ।\nययौ मातङ्गराजेन राजार्हेण पताकिना ।\nपद्मवर्णस्त्वनीकानां सर्वेषामग्रतः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043312, "chapter_id": 1968, "verse_number": "६-१७-२१", "content_sanskrit": "अश्वत्थामा ययौ यत्तः सिंहलाङ्गूलकेतुना ।\nश्रुतायुधश्चित्रसेनः पुरुमित्रो विविंशतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043313, "chapter_id": 1968, "verse_number": "६-१७-२२", "content_sanskrit": "शल्यो भूरिश्रवाश्चैव विकर्णश्च महारथः ।\nएते सप्त महेष्वासा द्रोणपुत्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043314, "chapter_id": 1968, "verse_number": "६-१७-२३", "content_sanskrit": "स्यन्दनैर्वरवर्माणो भीष्मस्यासन्पुरोगमाः।\nतेषामपि महोत्सेधाः शोभयन्तो रथोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043315, "chapter_id": 1968, "verse_number": "६-१७-२४", "content_sanskrit": "भ्राजमाना व्यरोचन्त जाम्बूनदमया ध्वजाः।\nजाम्बूनदमयी वेदी कमण्डलुविभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043316, "chapter_id": 1968, "verse_number": "६-१७-२५", "content_sanskrit": "केतुराचार्यमुख्यस्य द्रोणस्य धनुषा सह ।\nअनेकशतसाहस्रमनीकमनुकर्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043317, "chapter_id": 1968, "verse_number": "६-१७-२६", "content_sanskrit": "महान्दुर्योधनस्यासीन्नागो मणिमयो ध्वजः ।\nतस्य पौरवकालिङ्गकाम्भोजाः समुदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043318, "chapter_id": 1968, "verse_number": "६-१७-२७", "content_sanskrit": "क्षेमधन्वा च शल्यश्च तस्थुः प्रमुखतो रथाः।\nस्यन्दनेन महार्हेण केतुना वृषभेण च।\nप्रकर्षन्नेव सेनाग्नं मागधस्य कृपो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043319, "chapter_id": 1968, "verse_number": "६-१७-२८", "content_sanskrit": "तदङ्गपतिनां गुप्तं कृपेण च मनस्विना ।\nशारदाम्बुधरप्रख्यं प्राच्यानां सुमहद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2043320, "chapter_id": 1968, "verse_number": "६-१७-२९", "content_sanskrit": "अनीकप्रमुखे तिष्ठन्वराहेण महायशाः।\nशुशुभे केतुमुख्येन राजतेन जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2043321, "chapter_id": 1968, "verse_number": "६-१७-३०", "content_sanskrit": "शतं रतसहस्राणां तस्यासन्वशवर्तिनः।\nअष्टौ नागसहस्राणि सादिनामयुतानि षट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2043322, "chapter_id": 1968, "verse_number": "६-१७-३१", "content_sanskrit": "तत्सिन्धुपतिना राज्ञा पालितं ध्वजिनीमुखम्।\nअनन्तरथनागाश्वमशोभत महद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2043323, "chapter_id": 1968, "verse_number": "६-१७-३२", "content_sanskrit": "षष्ट्या रथसहस्रैस्तु नागानामयुतेन च।\nपतिः सर्वकलिङ्गानां ययौ केतुमता सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2043324, "chapter_id": 1968, "verse_number": "६-१७-३३", "content_sanskrit": "तस्य पर्वतसंकाशा व्यरोचन्त महागजाः ।\nयन्त्रतोमरतूणीरैः पताकाभिः सुशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2043325, "chapter_id": 1968, "verse_number": "६-१७-३४", "content_sanskrit": "शुशुभे केतुमुख्येन पावकेन कलिङ्गकः।\nश्वेतच्छत्रेण निष्केण चामरव्यजनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2043326, "chapter_id": 1968, "verse_number": "६-१७-३५", "content_sanskrit": "केतुमानपि मातङ्गं विचित्रपरमाङ्कुशम्।\nआस्थितः समरे राजन्मेघस्थ इव भानुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2043327, "chapter_id": 1968, "verse_number": "६-१७-३६", "content_sanskrit": "तेजसा दीप्यमानस्तु वारणोत्तममास्थितः ।\nभगदत्तो ययौ राजा यथा वज्रधरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2043328, "chapter_id": 1968, "verse_number": "६-१७-३७", "content_sanskrit": "गजस्कन्धगतावास्तां भगदत्तेन संमितौ ।\nविन्दानुविन्दावावन्त्यौ केतुमन्तमनुव्रतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2043329, "chapter_id": 1968, "verse_number": "६-१७-३८", "content_sanskrit": "स रथानीकवान्व्यूहो हस्त्यङ्गो नृपशीर्षवान् ।\nवाजिपक्षः पतत्युग्रः प्रहसन्सर्वतोमुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2043330, "chapter_id": 1968, "verse_number": "६-१७-३९", "content_sanskrit": "द्रोणेन विहितो राजन्राज्ञा शान्तनवेन च।\nतथैवाचार्यपुत्रेण बाह्लीकेन कृपेम च ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2043331, "chapter_id": 1968, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि सप्तदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]