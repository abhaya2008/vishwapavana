[{"id": 2006101, "chapter_id": 1121, "verse_number": "१-१२२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006102, "chapter_id": 1121, "verse_number": "१-१२२-१", "content_sanskrit": "ततः शान्तनवो भीष्मो राज्ञः पाण्डोर्यशस्विनः।\nविवाहस्यापरस्यार्थे चकार मतिमान्मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006103, "chapter_id": 1121, "verse_number": "१-१२२-२", "content_sanskrit": "सोऽमात्यैः स्थविरैः सार्धं ब्राह्मणैश्च महर्षिभिः।\nबलेन चतुरङ्गेण ययौ मद्रपतेः पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006104, "chapter_id": 1121, "verse_number": "१-१२२-३", "content_sanskrit": "तमागतमभिश्रुत्य भीष्मं वाहीकपुङ्गवः।\nप्रत्युद्गम्यार्चयित्वा च पुरं प्रावेशयन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006105, "chapter_id": 1121, "verse_number": "१-१२२-४", "content_sanskrit": "दत्त्वा तस्यासनं शुभ्रं पाद्यमर्घ्यं तथैव च।\nमधुपर्कं च मद्रेशः पप्रच्छागमनेऽर्थिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006106, "chapter_id": 1121, "verse_number": "१-१२२-५", "content_sanskrit": "तं भीष्मः प्रत्युवाचेदं मद्रराजं कुरूद्वहः।\nआगतं मां विजानीहि कन्यार्थिनमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006107, "chapter_id": 1121, "verse_number": "१-१२२-६", "content_sanskrit": "श्रूयते भवतः साध्वी स्वसा माद्री यशस्विनी।\nतामहं वरयिष्यामि पाण्डोरर्थे यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006108, "chapter_id": 1121, "verse_number": "१-१२२-७", "content_sanskrit": "युक्तरूपो हि संबन्धे त्वं नो राजन्वयं तव।\nएतत्संचिन्त्य मद्रेश गृहाणास्मान्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006109, "chapter_id": 1121, "verse_number": "१-१२२-८", "content_sanskrit": "तमेवंवादिनं भीष्मं प्रत्यभाषत मद्रपः।\nन हि मेऽन्यो वरस्त्वत्तः श्रेयानिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006110, "chapter_id": 1121, "verse_number": "१-१२२-९", "content_sanskrit": "पूर्वैः प्रवर्तितं किंचित्कुलेऽस्मिन्नृपसत्तमैः।\nसाधु वा यदि वाऽसाधु तन्नातिक्रान्तुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006111, "chapter_id": 1121, "verse_number": "१-१२२-१०", "content_sanskrit": "व्यक्तं तद्भवतश्चापि विदितं नात्र संशयः।\nन च युक्तं तथा वक्तुं भवान्देहीति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006112, "chapter_id": 1121, "verse_number": "१-१२२-११", "content_sanskrit": "कुलधर्मः स नो वीर प्रमाणं परमं च तत्।\nतेन त्वां न ब्रवीम्येतदसंदिग्धं वचोऽरिहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006113, "chapter_id": 1121, "verse_number": "१-१२२-१२", "content_sanskrit": "तं भीष्मः प्रत्युवाचेदं मद्रराजं जनाधिपः।\nधर्म एष परो राजन्स्वयमुक्तः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006114, "chapter_id": 1121, "verse_number": "१-१२२-१३", "content_sanskrit": "नात्र कश्चन दोषोऽस्ति पूर्वैर्विधिरयं कृतः।\nविदितेयं च ते शल्य मर्यादा साधुसंमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006115, "chapter_id": 1121, "verse_number": "१-१२२-१४", "content_sanskrit": "इत्युक्त्वा स महातेजाः शातकुम्भं कृताकृतम्।\nरत्नानि च विचित्राणि शल्यायादात्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006116, "chapter_id": 1121, "verse_number": "१-१२२-१५", "content_sanskrit": "गजानश्वान्रथांश्चैव वासांस्याभरणानि च।\nमणिमुक्ताप्रवालं च गाङ्गेयो व्यसृजच्छुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006117, "chapter_id": 1121, "verse_number": "१-१२२-१६", "content_sanskrit": "तत्प्रगृह्य धनं सर्वं शल्यः संप्रतीमानसः।\nददौ तां समलङ्कृत्य स्वसारं कौरवर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006118, "chapter_id": 1121, "verse_number": "१-१२२-१७", "content_sanskrit": "स तां माद्रीमुपादाय भीष्मः सागरगासुतः।\nआजगाम पुरीं धीमान्प्रविष्टो गजसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006119, "chapter_id": 1121, "verse_number": "१-१२२-१८", "content_sanskrit": "तत इष्टेऽहनि प्राप्ते मुहूर्ते साधुसंमते।\nविवाहं कारायामास भीष्मः पाण्डोर्महात्मनः।\nजग्राह विधिवत्पाणिं माद्र्याः पाण्डुर्नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006120, "chapter_id": 1121, "verse_number": "१-१२२-१९", "content_sanskrit": "ततो विवाहे निर्वृत्ते स राजा कुरुनन्दनः।\nस्थापयामास तां भार्यां शुभे वेश्मनि भामिनीं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006121, "chapter_id": 1121, "verse_number": "१-१२२-२०", "content_sanskrit": "स ताभ्यां व्यचरत्सार्धं भार्याभ्यां राजसत्तमः।\nकुन्त्या माद्र्या च राजेन्द्रो यथाकामं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006122, "chapter_id": 1121, "verse_number": "१-१२२-२१", "content_sanskrit": "ततः स कौरवो राजा विहृत्य त्रिदशा निशाः।\nजिगीषया महीं पाण्डुर्निरक्रामत्पुरात्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006123, "chapter_id": 1121, "verse_number": "१-१२२-२२", "content_sanskrit": "स भीष्मप्रमुखान्वृद्धानभिवाद्य प्रणम्य च।\nधृतराष्ट्रं च कौरव्यं तथान्यान्कुरुसत्तमान्।\nआमन्त्र्य प्रययौ राजा तैश्चैवाप्यनुमोजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006124, "chapter_id": 1121, "verse_number": "१-१२२-२३", "content_sanskrit": "मङ्गलाचारयुक्ताभिराशीर्भिरभिनन्दितः।\nगजवाजिरथौघेन बलेन महताऽगमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006125, "chapter_id": 1121, "verse_number": "१-१२२-२४", "content_sanskrit": "स राजा देवगर्भाभो विजिगीषुर्वसुन्धराम्।\nहृष्टपुष्टबलैः प्रायात्पाण्डुः शत्रूननेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006126, "chapter_id": 1121, "verse_number": "१-१२२-२५", "content_sanskrit": "पूर्वमागस्कृतो गत्वा दशार्णाः समरे जिताः।\nपाण्डुना नरसिंहेन कौरवाणां यशोभृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006127, "chapter_id": 1121, "verse_number": "१-१२२-२६", "content_sanskrit": "ततः सेनामुपादाय पाण्डुर्नानाविधध्वजाम्।\nप्रभूतहस्त्यश्वयुतां पदातिरथसंकुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006128, "chapter_id": 1121, "verse_number": "१-१२२-२७", "content_sanskrit": "आगस्कारी महीपानां बहूनां बलदर्पितः।\nगोप्ता मगधराष्ट्रस्य दीर्घो राजगृहे हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006129, "chapter_id": 1121, "verse_number": "१-१२२-२८", "content_sanskrit": "ततः कोशं समादाय वाहनानि च भूरिशः।\nपाण्डुना मिथिलां गत्वा विदेहाः समरे जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006130, "chapter_id": 1121, "verse_number": "१-१२२-२९", "content_sanskrit": "तथा काशिषु सुह्मेषु पुण्ड्रेषु च नरर्षभ।\nस्वबाहुबलवीर्येण कुरूणामकरोद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006131, "chapter_id": 1121, "verse_number": "१-१२२-३०", "content_sanskrit": "तं शरौघमहाज्वालं शस्त्रार्चिषमरिन्दमम्।\nपाण्डुपावकमासाद्य व्यवह्यन्त नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006132, "chapter_id": 1121, "verse_number": "१-१२२-३१", "content_sanskrit": "ते ससेनाः ससेनेन विध्वंसितबला नृपाः।\nपाण्डुना वशगाः कृत्वा कुरुकर्मसु योजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006133, "chapter_id": 1121, "verse_number": "१-१२२-३२", "content_sanskrit": "तेन ते निर्जिताः सर्वे पृथिव्यां सर्वपार्थिवाः।\nतमेकं मेनिरे शूरं देवेष्विव पुरन्दरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006134, "chapter_id": 1121, "verse_number": "१-१२२-३३", "content_sanskrit": "तं कृताञ्जलयः सर्वे प्रणता वसुधाधिपाः।\nउपाजग्मुर्धनं गृह्य रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006135, "chapter_id": 1121, "verse_number": "१-१२२-३४", "content_sanskrit": "मणिमुक्ताप्रवालं च सुवर्णं रजतं बहु।\nगोरत्नान्यश्वरत्नानि रथरत्नानि कुञ्जरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006136, "chapter_id": 1121, "verse_number": "१-१२२-३५", "content_sanskrit": "खरोष्ट्रमहिषांश्चैव यच्च किंचिदजाविकम्।\nकम्लाजिनरत्नानि राङ्कवास्तरणानि च।\nतत्सर्वं प्रतिजग्राह राजा नागपुराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006137, "chapter_id": 1121, "verse_number": "१-१२२-३६", "content_sanskrit": "तदादाय ययौ पाण्डुः पुनर्मदितवाहनः।\nहर्षयिष्यन्स्वराष्ट्राणि पुरं च गजसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006138, "chapter_id": 1121, "verse_number": "१-१२२-३७", "content_sanskrit": "शान्तनो राजसिंहस्य भरतस्य च धीमतः।\nप्रनष्टः कीर्तिजः शब्दः पाण्डुना पुनराहृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006139, "chapter_id": 1121, "verse_number": "१-१२२-३८", "content_sanskrit": "ये पुरा कुरुराष्ट्राणि जह्रुः कुरुधनानि च।\nते नागपुरसिंहेन पाण्डुना करदीकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006140, "chapter_id": 1121, "verse_number": "१-१२२-३९", "content_sanskrit": "इत्यभाषन्त राजानो राजामात्याश्च सङ्गताः।\nप्रतीतमनसो हृष्टाः पौरजानपदैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006141, "chapter_id": 1121, "verse_number": "१-१२२-४०", "content_sanskrit": "प्रत्युद्ययुश्च तं प्राप्तं सर्वे भीष्मपुरोगमाः।\nते नदूरमिवाध्वानं गत्वा नागपुरालयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006142, "chapter_id": 1121, "verse_number": "१-१२२-४१", "content_sanskrit": "आवृतं ददृशुर्हृष्टा लोकं बहुविधैर्धनैः।\nनानायानसमानीतै रत्नैरुच्चावचैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006143, "chapter_id": 1121, "verse_number": "१-१२२-४२", "content_sanskrit": "हस्त्यश्वरथरत्नैश्च गोभिरुष्ट्रैस्तथाऽऽविभिः।\nनान्तं ददृशुरासाद्य भीष्मेण सह कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006144, "chapter_id": 1121, "verse_number": "१-१२२-४३", "content_sanskrit": "सोऽभिवाद्य पितुः पादौ कौसल्यानन्दवर्धनः।\nयथाऽर्हं मानयामास पौरजानपदानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006145, "chapter_id": 1121, "verse_number": "१-१२२-४४", "content_sanskrit": "प्रमृद्य परराष्ट्राणि कृतार्थं पुनरागतम्।\nपुत्रमाश्लिष्य भीष्मस्तु हर्षादश्रूण्यवर्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006146, "chapter_id": 1121, "verse_number": "१-१२२-४५", "content_sanskrit": "स तूर्यशतशङ्खानां भेरीणां च महास्वनैः।\nहर्षयन्सर्वशः पौरान्विवेश गजसाह्वयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006147, "chapter_id": 1121, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्वाविंशत्यधिकशततमोऽध्यायः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]