[
  {
    "id": 16760001,
    "chapter_id": 6160,
    "verse_number": "12.1",
    "content_sanskrit": "अर्जुन उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C12_V01"
  },
  {
    "id": 16760002,
    "chapter_id": 6160,
    "verse_number": "12.2",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C12_V02"
  },
  {
    "id": 16760003,
    "chapter_id": 6160,
    "verse_number": "12.3",
    "content_sanskrit": "ये त्वक्षरमनिर्देश्यमव्यक्तं पर्युपासते ।\nसर्वत्रगमचिन्त्यं च कूटस्थमचलं ध्रुवम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C12_V03"
  },
  {
    "id": 16760004,
    "chapter_id": 6160,
    "verse_number": "12.4",
    "content_sanskrit": "संनियम्येन्द्रियग्रामं सर्वत्र समबुद्धयः ।\nते प्राप्नुवन्ति मामेव सर्वभूतहिते रताः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C12_V04"
  },
  {
    "id": 16760005,
    "chapter_id": 6160,
    "verse_number": "12.5",
    "content_sanskrit": "क्लेशोऽधिकतरस्तेषामव्यक्तासक्तचेतसाम् ।\nअव्यक्ता हि गतिर्दुःखं देहवद्भिरवाप्यते ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C12_V05"
  },
  {
    "id": 16760006,
    "chapter_id": 6160,
    "verse_number": "12.6",
    "content_sanskrit": "ये तु सर्वाणि कर्माणि मयि संन्यस्य मत्पराः ।\nअनन्येनैव योगेन मां ध्यायन्त उपासते ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C12_V06"
  },
  {
    "id": 16760007,
    "chapter_id": 6160,
    "verse_number": "12.7",
    "content_sanskrit": "तेषामहं समुद्धर्ता मृत्युसंसारसागरात् ।\nभवामि न चिरात्पार्थ मय्यावेशितचेतसाम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C12_V07"
  },
  {
    "id": 16760008,
    "chapter_id": 6160,
    "verse_number": "12.8",
    "content_sanskrit": "मय्येव मन आधत्स्व मयि बुद्धिं निवेशय ।\nनिवसिष्यसि मय्येव अत ऊर्ध्वं न संशयः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C12_V08"
  },
  {
    "id": 16760009,
    "chapter_id": 6160,
    "verse_number": "12.9",
    "content_sanskrit": "अथ चित्तं समाधातुं\nन शक्नोषि मयि स्थिरम् ।\nअभ्यासयोगेन ततो\nमामिच्छाप्तुं धनञ्जय ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C12_V09"
  },
  {
    "id": 16760010,
    "chapter_id": 6160,
    "verse_number": "12.10",
    "content_sanskrit": "अभ्यासेऽप्यसमर्थोऽसि\nमत्कर्मपरमो भव ।\nमदर्थमपि कर्माणि\nकुर्वन्सिद्धिमवाप्स्यसि ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C12_V10"
  },
  {
    "id": 16760011,
    "chapter_id": 6160,
    "verse_number": "12.11",
    "content_sanskrit": "अथैतदप्यशक्तोऽसि कर्तुं मद्योगमाश्रितः ।\nसर्वकर्मफलत्यागं ततः कुरु यतात्मवान् ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C12_V11"
  },
  {
    "id": 16760012,
    "chapter_id": 6160,
    "verse_number": "12.12",
    "content_sanskrit": "श्रेयो हि ज्ञानमभ्यासाज्ज्ञानाद्ध्यानं विशिष्यते ।\nध्यानात्कर्मफलत्यागस्त्यागाच्छान्तिरनन्तरम् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C12_V12"
  },
  {
    "id": 16760013,
    "chapter_id": 6160,
    "verse_number": "12.13",
    "content_sanskrit": "अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च ।\nनिर्ममो निरहङ्कारः समदुःखसुखः क्षमी ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C12_V13"
  },
  {
    "id": 16760014,
    "chapter_id": 6160,
    "verse_number": "12.14",
    "content_sanskrit": "सन्तुष्टः सततं योगी यतात्मा दृढनिश्चयः ।\nमय्यर्पितमनोबुद्धिर्यो मद्भक्तः स मे प्रियः ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C12_V14"
  },
  {
    "id": 16760015,
    "chapter_id": 6160,
    "verse_number": "12.15",
    "content_sanskrit": "यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः ।\nहर्षामर्षभयोद्वेगैर्मुक्तो यः स च मे प्रियः ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C12_V15"
  },
  {
    "id": 16760016,
    "chapter_id": 6160,
    "verse_number": "12.16",
    "content_sanskrit": "अनपेक्षः शुचिर्दक्ष\nउदासीनो गतव्यथः ।\nसर्वारम्भपरित्यागी\nयो मद्भक्तः स मे प्रियः ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C12_V16"
  },
  {
    "id": 16760017,
    "chapter_id": 6160,
    "verse_number": "12.17",
    "content_sanskrit": "यो न हृष्यति न द्वेष्टि\nन शोचति न काङ्क्षति ।\nशुभाशुभपरित्यागी\nभक्तिमान्यः स मे प्रियः ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C12_V17"
  },
  {
    "id": 16760018,
    "chapter_id": 6160,
    "verse_number": "12.18",
    "content_sanskrit": "समः शत्रौ च मित्रे च\nतथा मानापमानयोः ।\nशीतोष्णसुखदुःखेषु\nसमः सङ्गविवर्जितः ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C12_V18"
  },
  {
    "id": 16760019,
    "chapter_id": 6160,
    "verse_number": "12.19",
    "content_sanskrit": "तुल्यनिन्दास्तुतिर्मौनी सन्तुष्टो येन केनचित् ।\nअनिकेतः स्थिरमतिर्भक्तिमान्मे प्रियो नरः ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C12_V19"
  },
  {
    "id": 16760020,
    "chapter_id": 6160,
    "verse_number": "12.20",
    "content_sanskrit": "ये तु धर्म्यामृतमिदं\nयथोक्तं पर्युपासते ।\nश्रद्दधाना मत्परमा\nभक्तास्तेऽतीव मे प्रियाः ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C12_V20"
  }
]