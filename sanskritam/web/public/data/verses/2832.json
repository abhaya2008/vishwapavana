[{"id": 2086131, "chapter_id": 2832, "verse_number": "१२-३३७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086132, "chapter_id": 2832, "verse_number": "१२-३३७-१", "content_sanskrit": "एतस्मिन्नन्तरे भूते नारदः पुनरागमत्।\nशुकं स्वाध्यायनिरतं वेदार्थान्प्रष्टुमीप्सवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086133, "chapter_id": 2832, "verse_number": "१२-३३७-२", "content_sanskrit": "देवर्षि तु शुको दृष्ट्वा नारदं समुपस्यितम्।\nअर्ध्यपूर्वेण विधिवा वेदोक्तेनाभ्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086134, "chapter_id": 2832, "verse_number": "१२-३३७-३", "content_sanskrit": "नारदोऽयाजवीत्प्रीतो ब्रूहि ब्रह्मविदां वर।\nकेन त्वां श्रेयसा वत्स योजयामीति हृष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086135, "chapter_id": 2832, "verse_number": "१२-३३७-४", "content_sanskrit": "नारदस्य वचः श्रुत्वा शुकः प्रोवाच भारत।\nअस्मिँल्लोके हितं यत्स्वात्तेन मां योक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086136, "chapter_id": 2832, "verse_number": "१२-३३७-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086137, "chapter_id": 2832, "verse_number": "१२-३३७-५", "content_sanskrit": "तत्त्वं जिज्ञासतां पूर्वनृषीणां भावितात्मनाम्।\nसनत्कुमारो भगवानिदं वतनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086138, "chapter_id": 2832, "verse_number": "१२-३३७-६", "content_sanskrit": "नास्ति विद्यासगं चक्षुर्नास्ति सत्यसमं तपः।\nनास्ति रागसमं दुःखं नास्ति त्यागसमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086139, "chapter_id": 2832, "verse_number": "१२-३३७-७", "content_sanskrit": "निवृत्तिः कर्मणा पापात्सततं पुण्यशीलता।\nसद्वृत्तिः सद्वदाचारः श्रेय एवदनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086140, "chapter_id": 2832, "verse_number": "१२-३३७-८", "content_sanskrit": "नानुवयसुखं प्राप्य यः सज्जति न मुच्यते।\nनालं स दुःखमोक्षाय संयोगो दुःखलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086141, "chapter_id": 2832, "verse_number": "१२-३३७-९", "content_sanskrit": "सक्तस्य बुद्धिश्चलति मोहजालविवर्धनी।\nमोहवालावृतो दुःखमिह चामुत्र सोऽश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086142, "chapter_id": 2832, "verse_number": "१२-३३७-१०", "content_sanskrit": "सर्वोपागात्तु कामस्व क्रोधस्य च विनिग्रहः।\nकार्यः श्रेयोर्थिना तौ हि श्रेयोघातार्थमुद्यतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086143, "chapter_id": 2832, "verse_number": "१२-३३७-११", "content_sanskrit": "नित्यं क्रोधात्तपो रक्षेच्छ्रियं रक्षेच्च मत्सरात्।\nविद्यां मानावमानाभ्यामात्मानं तु प्रमादतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086144, "chapter_id": 2832, "verse_number": "१२-३३७-१२", "content_sanskrit": "आनृशंस्यं परो धर्मः क्षमा च परमं बलम्।\nआत्मज्ञानं परं ज्ञानं न सत्याद्विद्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086145, "chapter_id": 2832, "verse_number": "१२-३३७-१३", "content_sanskrit": "सत्यस्य वचनं श्रेयः सत्यादपि हितं वदेत्।\nयद्भूतहितमत्यन्तमेतत्सत्यं मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086146, "chapter_id": 2832, "verse_number": "१२-३३७-१४", "content_sanskrit": "सर्वारम्भपरित्यागी निराशीर्निष्परिग्रहः।\nयेन सर्वं परित्यक्तं स विद्वान्स च पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086147, "chapter_id": 2832, "verse_number": "१२-३३७-१५", "content_sanskrit": "इन्द्रियैरिन्द्रियार्थान्यश्चरत्यात्मवशैरिह।\nआसज्जमानः शान्तात्मा निर्विकारः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086148, "chapter_id": 2832, "verse_number": "१२-३३७-१६", "content_sanskrit": "अत्मभूतैरतद्भूतः सह चैव विनैव च।\nस विमुक्तः परं श्रेयो नचिरेणाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086149, "chapter_id": 2832, "verse_number": "१२-३३७-१७", "content_sanskrit": "अदर्शनमसंस्पर्शस्तथाऽसंभाषणं तदा।\nयस्य भूतैः सह मुने स श्रेयो विन्दते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086150, "chapter_id": 2832, "verse_number": "१२-३३७-१८", "content_sanskrit": "न हिंस्यात्सर्वभूतानि मैत्रायगणतश्चरेत्।\nनेदं जन्म समासाद्य वैरं कुर्वीत केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086151, "chapter_id": 2832, "verse_number": "१२-३३७-१९", "content_sanskrit": "आकिञ्चन्यं सुसंतोषो निराशीस्त्वमचापलम्।\nएतदाहुः परं श्रेय आत्मज्ञस्य जितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086152, "chapter_id": 2832, "verse_number": "१२-३३७-२०", "content_sanskrit": "परिग्रहं परित्यज्य भव तात जितेन्द्रियः।\nअशोकं स्थानमातिष्ठ इह चामुत्र चाभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086153, "chapter_id": 2832, "verse_number": "१२-३३७-२१", "content_sanskrit": "निरामिषा न शोचन्ति त्यजेदामिषमात्मनः।\nपरित्यज्यामिषं सौभ्य दुःखतापाद्विमोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086154, "chapter_id": 2832, "verse_number": "१२-३३७-२२", "content_sanskrit": "तपोनित्येन दान्तेन मुनिना संयतात्मना।\nअजितं जेतुकामेन भाव्यं सङ्गेष्वसङ्गिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086155, "chapter_id": 2832, "verse_number": "१२-३३७-२३", "content_sanskrit": "गुणसङ्गेष्वनासक्त एकचर्यारतः सदा।\nब्राह्मणो नचिरादेव सुखमायात्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086156, "chapter_id": 2832, "verse_number": "१२-३३७-२४", "content_sanskrit": "द्वन्द्वारामेषु भूतेषु य एको रमते मुनिः।\nविद्धि प्रज्ञानतृप्तं तं ज्ञानतृप्तो न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086157, "chapter_id": 2832, "verse_number": "१२-३३७-२५", "content_sanskrit": "शुभैर्लभति देवत्वं व्यामिश्रेर्जन्म मानुषम्।\nअशुभैश्चाप्यधोजन्म कर्मभिर्लभतेऽवशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086158, "chapter_id": 2832, "verse_number": "१२-३३७-२६", "content_sanskrit": "तत्र मृत्युवशो दुःखैः सततं समभिद्रुतः।\nसंसारे पच्यते जन्तुस्तत्कथं नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086159, "chapter_id": 2832, "verse_number": "१२-३३७-२७", "content_sanskrit": "अहिते हितसंज्ञस्त्वमध्रुवे ध्रुवसंज्ञकः।\nअनर्थे चार्थसंज्ञस्त्वं किमर्थं नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086160, "chapter_id": 2832, "verse_number": "१२-३३७-२८", "content_sanskrit": "संवेष्ट्यमानं बहुभिर्मोहात्तन्तुभिरात्मजैः।\nकोशकार इवात्मानं वेष्टयन्नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086161, "chapter_id": 2832, "verse_number": "१२-३३७-२९", "content_sanskrit": "अलं परिग्रहेणेह दोषवान्हि परिग्रहः।\nकृमिर्हि कोशकारस्तु बध्यते स परिग्रहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086162, "chapter_id": 2832, "verse_number": "१२-३३७-३०", "content_sanskrit": "पुत्रदारकुटुम्बेषु सक्ताः सीदन्ति जन्तवः।\nसरःपङ्कार्णवे मग्ना जीर्णा वनगजा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086163, "chapter_id": 2832, "verse_number": "१२-३३७-३१", "content_sanskrit": "महाजालसमाकृष्टान्स्थले मत्स्यानिवोद्धृतान्।\nमोहजालसमाकृष्टान्पश्य जन्तून्सुदुःखितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086164, "chapter_id": 2832, "verse_number": "१२-३३७-३२", "content_sanskrit": "कुटुम्बं पुत्रदारांश्च शरीरं संचयाश्च ये।\nपारक्यमध्रुवं सर्वं किं स्वं सुकृतदुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086165, "chapter_id": 2832, "verse_number": "१२-३३७-३३", "content_sanskrit": "यदा सर्वान्परित्यज्य गन्तव्यमवशेन ते।\nअनर्थे किं प्रसक्तस्त्वं समर्थं नानुतिष्ठसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086166, "chapter_id": 2832, "verse_number": "१२-३३७-३४", "content_sanskrit": "अविश्रान्तमनालम्बमपाथेयमदैशिकम्।\nतमः कान्तारमध्वानं कथमेको गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086167, "chapter_id": 2832, "verse_number": "१२-३३७-३५", "content_sanskrit": "न हि त्वां प्रस्थितं कश्चित्पृष्ठतोऽनुगमिष्यति।\nसुकृतं दुष्कृतं च त्वां यास्यन्तमनुयास्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086168, "chapter_id": 2832, "verse_number": "१२-३३७-३६", "content_sanskrit": "विद्या कर्म च शौचं च ज्ञानं च बहुविस्तरम्।\nअर्थार्थमनुसार्यन्ते सिद्धार्थस्य विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086169, "chapter_id": 2832, "verse_number": "१२-३३७-३७", "content_sanskrit": "निबन्धनी रज्जुरेषा या ग्रामे वसतो रतिः।\nछित्त्वैतां सुकृतो यान्ति नैनां छिन्दन्ति दुष्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086170, "chapter_id": 2832, "verse_number": "१२-३३७-३८", "content_sanskrit": "रूपकूलां मनःस्रोतां स्पर्शद्वीपां रसावहाम्।\nगन्धपङ्कां शब्दजलां स्वर्गमार्गदुरावहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086171, "chapter_id": 2832, "verse_number": "१२-३३७-३९", "content_sanskrit": "क्षमारित्रां सत्यमयीं धर्मस्थैर्यपदाङ्कुराम्।\nत्यागवाताध्वगां शीघ्रां नौतार्यां तां नदीं तरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086172, "chapter_id": 2832, "verse_number": "१२-३३७-४०", "content_sanskrit": "त्यज धर्ममधर्मं च उभे सत्यानृते त्यज।\nउभे सत्यानृते त्यक्त्वा येन त्यजसि तं त्यज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086173, "chapter_id": 2832, "verse_number": "१२-३३७-४१", "content_sanskrit": "त्यज धर्ममसंकल्पादधर्मं चाप्यलिप्सया।\nउभे सत्यानृते बुद्ध्या बुद्धिं परमनिश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086174, "chapter_id": 2832, "verse_number": "१२-३३७-४२", "content_sanskrit": "अस्थिस्थूणं स्नायुयुतं मांसशोणितलेपनम्।\nचर्मावनद्धं दुर्गन्धिं पूर्णं मूत्रपुरीषयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086175, "chapter_id": 2832, "verse_number": "१२-३३७-४३", "content_sanskrit": "जराशोकसमाविष्टं रोगायतनमातुरम्।\nरजस्वलमनित्यं च भूतावासमिमं त्यज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086176, "chapter_id": 2832, "verse_number": "१२-३३७-४४", "content_sanskrit": "इदं विश्वं जगत्सर्वमजगच्चापि यद्भवेत्।\nमहाभूतात्मकं सर्वं महद्यत्परमाणु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086177, "chapter_id": 2832, "verse_number": "१२-३३७-४५", "content_sanskrit": "`महाभूतानि खं वायुरग्निरापस्तथा मही।\nषष्ठं तु चेतना या तु आत्मा सप्तममुच्यते।\nअष्टमं तु मनो ज्ञेयं बुद्धिस्तु नवमी स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086178, "chapter_id": 2832, "verse_number": "१२-३३७-४६", "content_sanskrit": "इन्द्रियाणि च पञ्चैव तमः सत्वं रजस्तथा।\nइत्येष सप्तदशको राशिरव्यक्तसंज्ञकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086179, "chapter_id": 2832, "verse_number": "१२-३३७-४७", "content_sanskrit": "सर्वैरिहेन्द्रियार्थैश्च व्यक्ताव्यक्तैर्हि संहितः।\nचतुर्विशक इत्येष व्यक्ताव्यक्तमयो गणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086180, "chapter_id": 2832, "verse_number": "१२-३३७-४८", "content_sanskrit": "एतैः सर्वैः समायुक्तः पुमानित्यभिधीयते।\nत्रिवर्गं तु सुखं दुःखं जीवितं मरणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086181, "chapter_id": 2832, "verse_number": "१२-३३७-४९", "content_sanskrit": "य इदं वेद तत्त्वेन स वेद प्रभवाप्ययौ।\nपारम्पर्येह बोद्धव्यं ज्ञानानां यच्च किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086182, "chapter_id": 2832, "verse_number": "१२-३३७-५०", "content_sanskrit": "इन्द्रियैर्गृह्यते यद्यत्तत्तद्व्यक्तमिति स्थितिः।\nअव्यक्तमिति विज्ञेयं लिङ्गग्राह्यमतीन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086183, "chapter_id": 2832, "verse_number": "१२-३३७-५१", "content_sanskrit": "इन्द्रियैर्नियतैर्देही धाराभिरिव तर्प्यते।\nलोके विततमात्मानं लोकांश्चात्मनि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086184, "chapter_id": 2832, "verse_number": "१२-३३७-५२", "content_sanskrit": "परावरदृशः शक्तिर्ज्ञानमूला न नश्यति।\nपश्यतः सर्वभूतानि सर्वावस्थासु सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086185, "chapter_id": 2832, "verse_number": "१२-३३७-५३", "content_sanskrit": "ब्रह्मभूतस्य संयोगो नाशुभेनोपपद्यते।\nज्ञानेन विविधान्क्लेशानतिवृत्तस्य मोहजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086186, "chapter_id": 2832, "verse_number": "१२-३३७-५४", "content_sanskrit": "लोके बुद्धिप्रकाशेन लोकमार्गो न रिष्यते।\nअनादिनिधनज्ञं तमात्मनि स्थितमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086187, "chapter_id": 2832, "verse_number": "१२-३३७-५५", "content_sanskrit": "अकर्तारममूर्तं च भगवानाह तीर्थवित्।\nयो जन्तुः स्वकृतैस्तैस्तैः कर्मभिर्नित्यदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086188, "chapter_id": 2832, "verse_number": "१२-३३७-५६", "content_sanskrit": "स दुःखप्रतिघातार्थं हन्ति जन्तूननेकधा।\nततः कर्म समादत्ते पुनरन्यन्नवं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086189, "chapter_id": 2832, "verse_number": "१२-३३७-५७", "content_sanskrit": "तप्यतेऽथ पुनस्तेन भुक्त्वा पथ्यमिवातुरः।\nअजस्रमेव मोहान्धो दुःखेषु सुखसंज्ञितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086190, "chapter_id": 2832, "verse_number": "१२-३३७-५८", "content_sanskrit": "बध्यते मथ्यते चैव कर्मभिर्मन्थवत्सदा।\nततो निबद्धः स्वां योनिं कर्मणामुदयादिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086191, "chapter_id": 2832, "verse_number": "१२-३३७-५९", "content_sanskrit": "परिभ्रमति संसारं चक्रवद्बहुवेदनः।\nसत्वं निर्वृत्तबन्धस्तु निवृत्तश्चापि कर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086192, "chapter_id": 2832, "verse_number": "१२-३३७-६०", "content_sanskrit": "सर्ववित्सर्वजित्सिद्धौ भव भावविवर्जितः।\nसंयमेन नवं बन्धं निवर्त्य तपसो बलात्।\nसंप्राप्ता बहवः सिद्धिमप्यबाधां सुखोदयाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086193, "chapter_id": 2832, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तत्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]