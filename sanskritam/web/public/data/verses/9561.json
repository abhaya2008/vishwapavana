[{"id": 5000561000, "chapter_id": 9561, "verse_number": "७-२६-१", "content_sanskrit": "स तु तत्र दशग्रीवः सह सैन्येन वीर्यवान् ।\nअस्तं प्राप्ते दिनकरे निवासं समरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000561001, "chapter_id": 9561, "verse_number": "७-२६-२", "content_sanskrit": "उदिते विमले चन्द्रे तुल्यपर्वतवर्चसि ।\nप्रसुप्तं सुमहत्सैन्यं नानाप्रहरणायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000561002, "chapter_id": 9561, "verse_number": "७-२६-३", "content_sanskrit": "रावणस्तु महावीर्यो निषण्णः शैलमूर्धनि ।\nस ददर्श गुणांस्तत्र चन्द्रपादपशोभितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000561003, "chapter_id": 9561, "verse_number": "७-२६-४", "content_sanskrit": "कर्णिकारवनैर्दीप्तैः कदम्बगहनैस्तथा ।\nपद्मिनीभिश्च फुल्लाभिर्मन्दाकिन्या जलैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000561004, "chapter_id": 9561, "verse_number": "७-२६-५", "content_sanskrit": "चम्पकाशोकपुन्नागमन्दारतरुभिस्तथा ।\nचूतपाटललोध्रैश्च प्रियङ्ग्वर्जुनकेतकैः ।\nतगरैर्नारिकैलैश्च प्रियालपनसैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000561005, "chapter_id": 9561, "verse_number": "७-२६-६", "content_sanskrit": "आरग्वधैस्तमालैश्च प्रियालवकुलैरपि ।\nएतैरन्यैश्च तरुभिरुद्भासितवनान्तरे ।\nकिन्नरा मदनेनार्ता रक्ता मधुरकण्ठिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000561006, "chapter_id": 9561, "verse_number": "७-२६-७", "content_sanskrit": "समं सम्प्रजगुर्यत्र मनस्तुष्टिविवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000561007, "chapter_id": 9561, "verse_number": "७-२६-८", "content_sanskrit": "भिरुद्भासितवनान्तरे ।\nविद्याधरा मदक्षीबा मदरक्तान्तलोचनाः ।\nयोषिद्भिः सह सङ्क्रान्ताश्चिक्रीडुर्जहृषुश्च वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000561008, "chapter_id": 9561, "verse_number": "७-२६-९", "content_sanskrit": "घण्टानामिव सन्नादः शुश्रुवे मधुरस्वरः ।\nअप्सरोगणसङ्घानां गायतां धनदालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000561009, "chapter_id": 9561, "verse_number": "७-२६-१०", "content_sanskrit": "पुष्पवर्षाणि मुञ्चन्तो नगाः पवनताडिताः ।\nशैलं तं वासयन्तीव मधुमाधवगन्धिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000561010, "chapter_id": 9561, "verse_number": "७-२६-११", "content_sanskrit": "मधुपुष्परजःपृक्तं गन्धमादाय पुष्कलम् ।\nप्रववौ वर्धयन्कामं रावणस्य सुखो ऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000561011, "chapter_id": 9561, "verse_number": "७-२६-१२", "content_sanskrit": "गेयात्पुष्पसमृद्ध्या च शैत्याद्वायोर्गिरेर्गुणात् ।\nप्रवृत्तायां रजन्यां च चन्द्रस्योदयनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000561012, "chapter_id": 9561, "verse_number": "७-२६-१३", "content_sanskrit": "रावणस्तु महावीर्यः कामस्य वशमागतः ।\nविनिःश्वस्य विनिःश्वस्य शशिनं समवैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000561013, "chapter_id": 9561, "verse_number": "७-२६-१४", "content_sanskrit": "एतस्मिन्नन्तरे तत्र दिव्याभरणभूषिता ।\nसर्वाप्सरोवरा रम्भा दिव्यपुष्पविभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000561014, "chapter_id": 9561, "verse_number": "७-२६-१५", "content_sanskrit": "दिव्यचन्दनलिप्ताङ्गी मन्दारकृतमूर्धजा ।\nदिव्योत्सवकृतारम्भा पूर्णचन्द्रनिभानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000561015, "chapter_id": 9561, "verse_number": "७-२६-१६", "content_sanskrit": "चक्षुर्मनोहरं पीनं मेखलादामभूषितम् ।\nसमुद्वहन्ती जघनं रतिप्राभृतमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000561016, "chapter_id": 9561, "verse_number": "७-२६-१७", "content_sanskrit": "कृतैर्विशेषकैरार्द्रैः षडर्तुकुसुमोद्भवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000561017, "chapter_id": 9561, "verse_number": "७-२६-१८", "content_sanskrit": "बभावन्यतमेव श्रीकान्तिद्युतिमतिह्रियाम् ।\nनीलं सतोयमेघाभं वस्त्रं समवकुण्ठिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000561018, "chapter_id": 9561, "verse_number": "७-२६-१९", "content_sanskrit": "यस्या वक्त्रं शशिनिभं भ्रुवौ चापनिभे शुभे ।\nऊरू करिकराकारौ करौ पल्लवकोमलौ ।\nसैन्यमध्येन गच्छन्ती रावणेनोपवीक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000561019, "chapter_id": 9561, "verse_number": "७-२६-२०", "content_sanskrit": "तां समुत्थाय गच्छन्तीं कामबाणवशं गतः ।\nकरे गृहीत्वा लज्जन्तीं स्मयमानो ऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000561020, "chapter_id": 9561, "verse_number": "७-२६-२१", "content_sanskrit": "क्व गच्छसि वरारोहे कां सिद्धिं भजसे स्वयम् ।\nकस्याभ्युदयकालो ऽयं यस्त्वां समुपभोक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000561021, "chapter_id": 9561, "verse_number": "७-२६-२२", "content_sanskrit": "त्वदाननरसस्याद्य पद्मोत्पलसुगन्धिनः ।\nसुधामृतरसस्येव को ऽद्य तृप्तिं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000561022, "chapter_id": 9561, "verse_number": "७-२६-२३", "content_sanskrit": "स्वर्णकुम्भनिभौ पीनौ शुभौ भीरु निरन्तरौ ।\nकस्योरस्थलसंस्पर्शं दास्यतस्ते कुचाविमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000561023, "chapter_id": 9561, "verse_number": "७-२६-२४", "content_sanskrit": "सुवर्णचक्रप्रतिमं स्वर्णदामचितं पृथु ।\nअध्यारोहति कस्ते ऽद्य जघनं स्वर्गरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000561024, "chapter_id": 9561, "verse_number": "७-२६-२५", "content_sanskrit": "मद्विशिष्टः पुमान्को ऽद्य शक्रो विष्णुरथाश्विनौ ।\nमामतीत्य हि यं च त्वं यासि भीरु न शोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000561025, "chapter_id": 9561, "verse_number": "७-२६-२६", "content_sanskrit": "विश्रम त्वं पृथुश्रोणि शिलातलमिदं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000561026, "chapter_id": 9561, "verse_number": "७-२६-२७", "content_sanskrit": "त्रैलोक्ये यः प्रभुश्चैव मदन्यो नैव विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000561027, "chapter_id": 9561, "verse_number": "७-२६-२८", "content_sanskrit": "तदेवं प्राञ्जलिः प्रह्वो याचते त्वां दशाननः ।\nभर्तुर्भर्ता विधाता च त्रैलोक्यस्य भजस्व माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000561028, "chapter_id": 9561, "verse_number": "७-२६-२९", "content_sanskrit": "एवमुक्ता ऽब्रवीद्रम्भा वेपमाना कृताञ्जलिः ।\nप्रसीद नार्हसे वक्तुमीदृशं त्वं हि मे गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000561029, "chapter_id": 9561, "verse_number": "७-२६-३०", "content_sanskrit": "अन्येभ्यो हि त्वया रक्ष्या प्राप्नुयां धर्षणं यदि ।\nतद्धर्मतः स्नुषा ते ऽहं तत्त्वमेव ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000561030, "chapter_id": 9561, "verse_number": "७-२६-३१", "content_sanskrit": "अथाब्रवीद्दशग्रीवश्चरणाधोमुखीं स्थिताम् ।\nरोमहर्षमनुप्राप्तां दृष्टमात्रेण तां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000561031, "chapter_id": 9561, "verse_number": "७-२६-३२", "content_sanskrit": "सुतस्य यदि मे भार्या ततस्त्वं हि स्नुषा भवेः ।\nबाढमित्येव सा रम्भा प्राह रावणमुत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000561032, "chapter_id": 9561, "verse_number": "७-२६-३३", "content_sanskrit": "धर्मतस्ते सुतस्याहं भार्या राक्षसपुङ्गव ।\nपुत्रः प्रियतरः प्राणैर्भ्रातुर्वैश्रवणस्य ते ।\nविख्यातस्त्रिषु लोकेषु नलकूबर इत्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000561033, "chapter_id": 9561, "verse_number": "७-२६-३४", "content_sanskrit": "धर्मतो यो भवेद्विप्रः क्षत्रियो वीर्यतो भवेत् ।\nक्रोधाद्यश्च भवेदग्निः क्षान्त्या च वसुधासमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000561034, "chapter_id": 9561, "verse_number": "७-२६-३५", "content_sanskrit": "तस्यास्मि कृतसङ्केता लोकपालसुतस्य वै ।\nतमुद्दिश्य तु मे सर्वं विभूषणमिदं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000561035, "chapter_id": 9561, "verse_number": "७-२६-३६", "content_sanskrit": "तथा तस्य हि नान्यस्य भावो मां प्रति तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000561036, "chapter_id": 9561, "verse_number": "७-२६-३७", "content_sanskrit": "तेन सत्येन मां राजन्मोक्तुमर्हस्यरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000561037, "chapter_id": 9561, "verse_number": "७-२६-३८", "content_sanskrit": "स हि तिष्ठति धर्मात्मा मां प्रतीक्ष्य समुत्सुकः ।\nतत्र विघ्नं सुतस्येह कर्तुं नार्हसि मुञ्च माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000561038, "chapter_id": 9561, "verse_number": "७-२६-३९", "content_sanskrit": "सद्भिराचरितं मार्गं गच्छ राक्षसुपुङ्गव ।\nमाननीयो मम त्वं हि पालनीया तथा ऽस्मि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000561039, "chapter_id": 9561, "verse_number": "७-२६-४०", "content_sanskrit": "एवमुक्तो दशग्रीवः प्रत्युवाच विनीतवत् ।\nस्नुषा ऽस्मि यदवोचस्त्वमेकपत्नीष्वयं क्रमः ।\nदेवलोकस्थितिरियं सुराणां शाश्वती मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000561040, "chapter_id": 9561, "verse_number": "७-२६-४१", "content_sanskrit": "पतिरप्सरसां नास्ति न चैकस्त्रीपरिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000561041, "chapter_id": 9561, "verse_number": "७-२६-४२", "content_sanskrit": "स्मि यदवोचस्त्वमेकपत्नीष्वयं क्रमः ।\nएवमुक्त्वा स तां रक्षो निवेश्य च शिलातले ।\nकामभोगाभिसंसक्तो मैथुनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000561042, "chapter_id": 9561, "verse_number": "७-२६-४३", "content_sanskrit": "सा विमुक्ता ततो रम्भा भ्रष्टमाल्यविभूषणा ।\nगजेन्द्राक्रीडमथिता नदीवाकुलतां गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000561043, "chapter_id": 9561, "verse_number": "७-२६-४४", "content_sanskrit": "लुलिताकुलकेशान्ता करवेपितपल्लवा ।\nपवनेनावधूतेव लता कुसुमशालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000561044, "chapter_id": 9561, "verse_number": "७-२६-४५", "content_sanskrit": "सा वेपमाना लज्जन्ती भीता करकृताञ्जलिः ।\nनलकूबरमासाद्य पादयोर्निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000561045, "chapter_id": 9561, "verse_number": "७-२६-४६", "content_sanskrit": "तदवस्थां च तां दृष्ट्वा महात्मा नलकूबरः ।\nअब्रवीत्किमिदं भद्रे पादयोः पतिता ऽसि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000561046, "chapter_id": 9561, "verse_number": "७-२६-४७", "content_sanskrit": "सा वै निःश्वसमाना तु वेपमाना कृताञ्जलिः ।\nतस्मै सर्वं यथातत्त्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000561047, "chapter_id": 9561, "verse_number": "७-२६-४८", "content_sanskrit": "एष देव दशग्रीवः प्राप्तो गन्तुं त्रिविष्टपम् ।\nतेन सैन्यसहायेन निशेयं परिणामिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000561048, "chapter_id": 9561, "verse_number": "७-२६-४९", "content_sanskrit": "आयन्ती तेन दृष्टा ऽस्मि त्वत्सकाशमरिन्दम ।\nगृहीता तेन पृष्टा ऽस्मि कस्य त्वमिति रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000561049, "chapter_id": 9561, "verse_number": "७-२६-५०", "content_sanskrit": "मया तु सर्वं यत्सत्यं तस्मै सर्वं निवेदितम् ।\nकाममोहाभिभूतात्मा नाश्रौषीत्तद्वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000561050, "chapter_id": 9561, "verse_number": "७-२६-५१", "content_sanskrit": "याच्यमानो मया देव स्नुषा ते ऽहमिति प्रभो ।\nतत्सर्वं पृष्ठतः कृत्वा बलात्तेनास्मि धर्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000561051, "chapter_id": 9561, "verse_number": "७-२६-५२", "content_sanskrit": "एवं त्वमपराधं मे क्षन्तुमर्हसि सुव्रत ।\nन हि तुल्यं बलं सौम्य स्त्रियाश्च पुरुषस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000561052, "chapter_id": 9561, "verse_number": "७-२६-५३", "content_sanskrit": "एतछुत्वा तु सङ्क्रुद्धस्तदा वैश्रवणात्मजः ।\nधर्षणां तां परां श्रुत्वा ध्यानं सम्प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000561053, "chapter_id": 9561, "verse_number": "७-२६-५४", "content_sanskrit": "तस्य तत्कर्म विज्ञाय तदा वैश्रवणात्मजः ।\nमुहूर्तात्क्रोधताम्राक्षस्तोयं जग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000561054, "chapter_id": 9561, "verse_number": "७-२६-५५", "content_sanskrit": "गृहीत्वा सलिलं सर्वमुपस्पृश्य यथाविधि ।\nउत्ससर्ज यथा शापं राक्षसेन्द्राय दारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000561055, "chapter_id": 9561, "verse_number": "७-२६-५६", "content_sanskrit": "अकामा तेन यस्मात्त्वं बलाद्भद्रे प्रधर्षिता ।\nतस्मात्स युवतीमन्यां नाकामामुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000561056, "chapter_id": 9561, "verse_number": "७-२६-५७", "content_sanskrit": "यदा ह्यकामां कामार्तो धर्षयिष्यति योषितम् ।\nमूर्धा तु सप्तधा तस्य शकलीभविता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000561057, "chapter_id": 9561, "verse_number": "७-२६-५८", "content_sanskrit": "तस्मिन्नुदाहृते शापे ज्वलिताग्निसमप्रभे ।\nदेवदुन्दुभयो नेदुः पुष्पवृष्टिश्च खाच्च्युता ।\nपितामहमुखाश्चैव सर्वे देवाः प्रहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000561058, "chapter_id": 9561, "verse_number": "७-२६-५९", "content_sanskrit": "ज्ञात्वा लोकगतिं सर्वां तस्य मृत्युं च रक्षसः ।\nऋषयः पितरश्चैव प्रीतिमापुरनुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000561059, "chapter_id": 9561, "verse_number": "७-२६-६०", "content_sanskrit": "श्रुत्वा तु स दशग्रीवस्तं शापं रोमहर्षणम् ।\nनारीषु मैथुने भावं नाकामास्वभ्यरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000561060, "chapter_id": 9561, "verse_number": "७-२६-६१", "content_sanskrit": "तेन नीताः स्त्रियः प्रीतिमापुः सर्वाः पतिव्रताः ।\nनलकूबरनिर्मुक्तं शापं श्रुत्वा मनःप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000561061, "chapter_id": 9561, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षड्वविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]