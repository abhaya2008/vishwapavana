[{"id": 50024185, "chapter_id": 11837, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। १ २ ४ - मरुतः, ३ ५ - मरुत इन्द्रश्च, ६-१० इन्द्रः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024186, "chapter_id": 11837, "verse_number": "2", "content_sanskrit": "यु॒ञ्जन्ति॑ ब्र॒ध्नम॑रु॒षं चर॑न्तं॒ परि॑ त॒स्थुष॑ः। रोच॑न्ते रोच॒ना दि॒वि॥ ६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024187, "chapter_id": 11837, "verse_number": "3", "content_sanskrit": "यु॒ञ्जन्त्य॑स्य॒ काम्या॒ हरी॒ विप॑क्षसा॒ रथे॑। शोणा॑ धृ॒ष्णू नृ॒वाह॑सा॥ ६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024188, "chapter_id": 11837, "verse_number": "4", "content_sanskrit": "के॒तुं कृ॒ण्वन्न॑के॒तवे॒ पेशो॑ मर्या अपे॒शसे॑। समु॒षद्भि॑रजायथाः॥ ६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024189, "chapter_id": 11837, "verse_number": "5", "content_sanskrit": "आदह॑ स्व॒धामनु॒ पुन॑र्गर्भ॒त्वमे॑रि॒रे। दधा॑ना॒ नाम॑ य॒ज्ञिय॑म्॥ ६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024190, "chapter_id": 11837, "verse_number": "6", "content_sanskrit": "वी॒ळु चि॑दारुज॒त्नुभि॒र्गुहा॑ चिदिन्द्र॒ वह्नि॑भिः। अवि॑न्द उ॒स्रिया॒ अनु॑॥ ६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024191, "chapter_id": 11837, "verse_number": "7", "content_sanskrit": "दे॒व॒यन्तो॒ यथा॑ म॒तिमच्छा॑ वि॒दद्व॑सुं॒ गिर॑ः। म॒हाम॑नूषत श्रु॒तम्॥ ६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024192, "chapter_id": 11837, "verse_number": "8", "content_sanskrit": "इन्द्रे॑ण॒ सं हि दृक्ष॑से संजग्मा॒नो अबि॑भ्युषा। म॒न्दू स॑मा॒नव॑र्चसा॥ ६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024193, "chapter_id": 11837, "verse_number": "9", "content_sanskrit": "अ॒न॒व॒द्यैर॒भिद्यु॑भिर्म॒खः सह॑स्वदर्चति। ग॒णैरिन्द्र॑स्य॒ काम्यै॑ः॥ ६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024194, "chapter_id": 11837, "verse_number": "10", "content_sanskrit": "अत॑ः परिज्म॒न्ना ग॑हि दि॒वो वा॑ रोच॒नादधि॑। सम॑स्मिन्नृञ्जते॒ गिर॑ः॥ ६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024195, "chapter_id": 11837, "verse_number": "11", "content_sanskrit": "इ॒तो वा॑ सा॒तिमीम॑हे दि॒वो वा॒ पार्थि॑वा॒दधि॑। इन्द्रं॑ म॒हो वा॒ रज॑सः॥ ६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]