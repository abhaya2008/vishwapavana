[{"id": 2064241, "chapter_id": 2364, "verse_number": "८-८५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2064242, "chapter_id": 2364, "verse_number": "८-८५-१", "content_sanskrit": "तमायान्तं महावेगैरश्वैः कपिवरध्वजम्।\nयुद्धायाभ्यद्रवन्दीराः कुरूणां नवतीं रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2064243, "chapter_id": 2364, "verse_number": "८-८५-२", "content_sanskrit": "कृत्वा संशप्तका घोरं शपथं पारलौकिकम्।\nपरिवव्रुर्नरव्याघ्रा नरव्याघ्रं रणेऽर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2064244, "chapter_id": 2364, "verse_number": "८-८५-३", "content_sanskrit": "कृष्णः श्वेतान्महावेगानश्वान्काञ्चनभूषणान्।\nमुक्ताजालप्रतिच्छन्नान्प्रैषीत्कर्णरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2064245, "chapter_id": 2364, "verse_number": "८-८५-४", "content_sanskrit": "प्रेक्ष्य कर्णरथं यान्तमरिघ्नं तं धनञ्जयम्।\nबाणवर्षैरभिघ्नन्तः संशप्तकगणा ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2064246, "chapter_id": 2364, "verse_number": "८-८५-५", "content_sanskrit": "त्वरमाणांस्तु तान्सर्वान्ससूतेष्वसनध्वजान्।\nजघान नवतिं वीरानर्जुनो निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2064247, "chapter_id": 2364, "verse_number": "८-८५-६", "content_sanskrit": "तेऽपतन्त हता बाणैर्नानारूपैः किरीटिना।\nविमानेभ्यः सुकृतिनः स्वर्गात्पुण्यक्षये यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2064248, "chapter_id": 2364, "verse_number": "८-८५-७", "content_sanskrit": "ततः सरथनागाश्वाः कुरवः कुरुसत्तमम्।\nनिर्भया भरतश्रेष्ठमभ्यवर्तन्त फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2064249, "chapter_id": 2364, "verse_number": "८-८५-८", "content_sanskrit": "तदायस्तमनुष्याश्वमुदीर्णवरवारणम्।\nपुत्राणां ते महासैन्यं समरौत्सीद्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2064250, "chapter_id": 2364, "verse_number": "८-८५-९", "content_sanskrit": "शक्त्यृष्टितोमरप्रासैर्गदानिस्त्रिंशसायकैः।\nप्राच्छादयन्महेष्वासाः कुरवः कुरुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2064251, "chapter_id": 2364, "verse_number": "८-८५-१०", "content_sanskrit": "तामन्तरिक्षे विततां शस्त्रवृष्टिं समन्ततः।\nव्यधमत्पाण्डवो बाणैस्तमः सूर्य इवांशुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2064252, "chapter_id": 2364, "verse_number": "८-८५-११", "content_sanskrit": "ततो म्लेच्छाः स्थिता मत्तैस्त्रयोदशशतैर्गजैः।\nपार्श्वतो व्यहनन्पार्थं तव पुत्रस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2064253, "chapter_id": 2364, "verse_number": "८-८५-१२", "content_sanskrit": "कर्णिनालीकनाराचैस्तोमरप्रासशक्तिभिः।\nकर्पणैर्भिण्डिपालैश्च रथस्थं पार्थमार्दयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2064254, "chapter_id": 2364, "verse_number": "८-८५-१३", "content_sanskrit": "तां शस्त्रवृष्टिमतुलां द्विपस्थैः प्रेषितां प्रभुः।\nचिच्छेद निशितैर्भल्लैरर्धचन्द्रैश्च फल्गुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2064255, "chapter_id": 2364, "verse_number": "८-८५-१४", "content_sanskrit": "अथ तान्द्विरदान्सर्वान्नानालिङ्गैः शरोत्तमैः।\nसपताकध्वजारोहान्गिरीन्वज्रैरिवाभिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2064256, "chapter_id": 2364, "verse_number": "८-८५-१५", "content_sanskrit": "ते हेमपुङ्खैरिषुभिरर्दिता हेममालिनः।\nहताः पेतुर्महानागाः साग्रिज्वाला इवाद्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2064257, "chapter_id": 2364, "verse_number": "८-८५-१६", "content_sanskrit": "ततो गाण्डीवनिर्घोषो महानासीद्विशाम्पते।\nस्तनतां कूजतां चैव मनुष्यगजवाजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2064258, "chapter_id": 2364, "verse_number": "८-८५-१७", "content_sanskrit": "कुञ्चराश्च हता राजन्दद्रुवुस्ते समन्ततः।\nअश्वाश्च पर्यधावन्त हतारोहा दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2064259, "chapter_id": 2364, "verse_number": "८-८५-१८", "content_sanskrit": "रथा हीना नहाराज रथिभिर्वाजिभिस्तथा।\nगन्धर्वनगराकारा दृश्यन्ते स्म सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2064260, "chapter_id": 2364, "verse_number": "८-८५-१९", "content_sanskrit": "अश्वारोहा महाराज धावमाना इतस्ततः।\nतत्रतत्रैव दृश्यन्ते निहताः पार्थसायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2064261, "chapter_id": 2364, "verse_number": "८-८५-२०", "content_sanskrit": "तस्मिन्क्षणे पाण्डवस्य बाह्वोर्बलमदृश्यत।\nयत्सादिनो वारणांश्च रथांश्चैकोऽजयद्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2064262, "chapter_id": 2364, "verse_number": "८-८५-२१", "content_sanskrit": "असंयुक्ताश्च ते राजन्परिवृत्ता रणं प्रति।\nनरा नागा रथाश्चैव नदन्तोऽर्जुनमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2064263, "chapter_id": 2364, "verse_number": "८-८५-२२", "content_sanskrit": "ततस्त्र्येङ्गेण महता बलेन भरतर्षभ।\nदृष्ट्वा परिवृतं राजन्भीमसेनः किरीटिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2064264, "chapter_id": 2364, "verse_number": "८-८५-२३", "content_sanskrit": "हतावशेषानुत्सृज्य त्वदीयान्कतिचिद्रथान्।\nजवेनाभ्यद्रवद्भीमो धनञ्जयरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2064265, "chapter_id": 2364, "verse_number": "८-८५-२४", "content_sanskrit": "ततस्तत्प्राद्रवत्सैन्यं हतभूयिष्ठमातुरम्।\nदृष्ट्वाऽर्जुनं तदा भीममागतं भ्रातरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2064266, "chapter_id": 2364, "verse_number": "८-८५-२५", "content_sanskrit": "हतावशिष्टांस्तुरगानर्जुनेन महाबलः।\nभीमो व्यधमदश्रान्तो गदापाणिर्महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2064267, "chapter_id": 2364, "verse_number": "८-८५-२६", "content_sanskrit": "`गदापाणिं तदा दृष्ट्वा भीमं भारत भारताः।\nमेनिरे तमनुप्राप्तं दण्डपाणिमिवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2064268, "chapter_id": 2364, "verse_number": "८-८५-२७", "content_sanskrit": "कालरात्रिमिवात्युग्रां नरनागाश्वभोजनाम्।\nप्राकाराट्टपुरद्वारदारणीमतिदारुणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2064269, "chapter_id": 2364, "verse_number": "८-८५-२८", "content_sanskrit": "गदां तुरगनाशाय त्वरन्भीमो व्यवासृजत्।\nसा जघान बहूनश्वानश्वारोहांश्च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2064270, "chapter_id": 2364, "verse_number": "८-८५-२९", "content_sanskrit": "कांस्यायसतनुत्रांश्च नरानश्वांश्च पाण्डवः।\nपोथयामास गदया सशब्दं तेऽपतन्हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2064271, "chapter_id": 2364, "verse_number": "८-८५-३०", "content_sanskrit": "दन्तैर्दशन्तो वसुधां शेरते क्षतजोक्षिताः।\nभग्नमूर्धास्थिचरणाः क्रव्यादगणभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2064272, "chapter_id": 2364, "verse_number": "८-८५-३१", "content_sanskrit": "असृङ्मांसवसाभिश्च तृप्तिमभ्यागता गदा।\nअस्थीन्यप्यश्नती तस्थौ कालरात्रीव दुर्दृशा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2064273, "chapter_id": 2364, "verse_number": "८-८५-३२", "content_sanskrit": "सहस्राणि दशाश्वानां हत्वा पत्तींश्च भूयसः।\nभीमोऽभ्यधावत्सङ्क्रुद्धो गदापाणिरितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2064274, "chapter_id": 2364, "verse_number": "८-८५-३३", "content_sanskrit": "गदापाणिं ततो भीमं दृष्ट्वा भारत तावकाः।\nमेनिरे समनुप्राप्तं कालदण़्डोद्यतं यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2064275, "chapter_id": 2364, "verse_number": "८-८५-३४", "content_sanskrit": "स मत्त इव मातङ्गः सङ्क्रुद्धः पाण्डुनन्दनः।\nप्रविवेश गजानीकं मकरः सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2064276, "chapter_id": 2364, "verse_number": "८-८५-३५", "content_sanskrit": "विगाह्य च गजानीकं प्रगृह्य महतीं गदाम्।\nक्षणेन भीमः सङ्क्रुद्धस्तन्निन्ये यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2064277, "chapter_id": 2364, "verse_number": "८-८५-३६", "content_sanskrit": "गजान्सकङ्कटान्मत्तान्सारोहान्सपताकिनः।\nपततः समपश्याम सपक्षान्पर्वतानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2064278, "chapter_id": 2364, "verse_number": "८-८५-३७", "content_sanskrit": "हत्वा तु तद्गजानीकं भीमसेनो महाबलः।\nपुनः स्वरथमास्थाय पृष्ठतोऽर्जुनमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2064279, "chapter_id": 2364, "verse_number": "८-८५-३८", "content_sanskrit": "ततः पराङ्मुखीभूतं निरुत्साहं बलं तव।\nतदानीं तु महाराज प्रायशः शस्त्रवेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2064280, "chapter_id": 2364, "verse_number": "८-८५-३९", "content_sanskrit": "विलम्बमानं तत्सैन्यभप्रगल्भमवस्थितम्।\nदृष्ट्वा प्राच्छादयद्बाणैरर्जुनः शस्त्रवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2064281, "chapter_id": 2364, "verse_number": "८-८५-४०", "content_sanskrit": "नराश्वरथमातङ्गा युधि गाण्डीवधन्वना।\nशरव्रातैश्चिता रेजुः कदम्बा इव केसरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2064282, "chapter_id": 2364, "verse_number": "८-८५-४१", "content_sanskrit": "ततः कुरुणामभवदार्तनादो महान्नृप।\nनराश्वनागासुहनान्दृष्ट्वा बाणान्किरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2064283, "chapter_id": 2364, "verse_number": "८-८५-४२", "content_sanskrit": "हाहाकृतं भृशं त्रस्तं लीयमानं परस्परम्।\nअलातचक्रवत्सैन्यं तदा बभ्राम तावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2064284, "chapter_id": 2364, "verse_number": "८-८५-४३", "content_sanskrit": "ततोऽर्जुनशरध्वस्तं कुरूणां सुमहद्बलम्।\nन ह्यत्रासीदनिर्भिन्नो रथः सादी हयो गजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2064285, "chapter_id": 2364, "verse_number": "८-८५-४४", "content_sanskrit": "आदीप्तमिव तत्सैन्यं शरैश्छिन्नतनुच्छदम्।\nआसीत्स्वशोणितक्लिन्नं रौद्रं नष्टं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2064286, "chapter_id": 2364, "verse_number": "८-८५-४५", "content_sanskrit": "तत्सैन्यं हतभूयिष्ठमाहतं निशितैः शरैः।\nन जहौ समरं प्राप्य फल्गुनं शत्रुतापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2064287, "chapter_id": 2364, "verse_number": "८-८५-४६", "content_sanskrit": "तत्राद्भुतमपश्याम कौरवाणां पराक्रमम्।\nवध्यमानोऽपि यत्पार्थं न जहौ भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2064288, "chapter_id": 2364, "verse_number": "८-८५-४७", "content_sanskrit": "तं दृष्ट्वा विक्रमं तस्य कुरवः सव्यसाचिनः।\nनिराशाः समपद्यन्त सर्वे कर्णस्य जीविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2064289, "chapter_id": 2364, "verse_number": "८-८५-४८", "content_sanskrit": "अविषह्यं तु पार्थस्य शरसंस्पर्शमाहवे।\nमत्वा न्यवर्तन्कुरवो जिता गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2064290, "chapter_id": 2364, "verse_number": "८-८५-४९", "content_sanskrit": "ते हित्वा समरे पार्थं वध्यमानाश्च सायकैः।\nप्रदुद्रुवुर्दिशो भीताश्चुक्रुशुश्चापि सूतजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2064291, "chapter_id": 2364, "verse_number": "८-८५-५०", "content_sanskrit": "तान्विद्रावयते पार्थः किरञ्शरशतान्बहून्।\nहर्षयन्पाण्डवीं सेनां राजानं च युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2064292, "chapter_id": 2364, "verse_number": "८-८५-५१", "content_sanskrit": "पुत्रास्तव महाराज जग्मुः कर्णरथं प्रति।\nअगाधे मज्जतां तेषां द्वीपः कर्णोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2064293, "chapter_id": 2364, "verse_number": "८-८५-५२", "content_sanskrit": "कुरवो हि महाराज निर्विषाः पन्नगा इव।\nकर्णमेवोपलीयन्त भयाद्गाण्डीवघन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2064294, "chapter_id": 2364, "verse_number": "८-८५-५३", "content_sanskrit": "यथा सर्वाणि भूतानि मृत्योर्भीतानि मारिष।\nउपलीयन्ति सन्त्रासाद्धर्मं लोकपरायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2064295, "chapter_id": 2364, "verse_number": "८-८५-५४", "content_sanskrit": "तथा कर्णं महेष्वासं पुत्रास्तव नराधिप।\nउपालीयन्त सन्त्रासात्पाण्डवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2064296, "chapter_id": 2364, "verse_number": "८-८५-५५", "content_sanskrit": "ताञ्शोणितपरिक्लिन्नान्विषमस्थाञ्शरातुरान्।\nमा भैष्टेत्यब्रवीत्कर्णो भीतानाविष्टचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2064297, "chapter_id": 2364, "verse_number": "८-८५-५६", "content_sanskrit": "सम्भग्नं हि बलं दृष्ट्वा बलात्पार्थेन तावकम्।\nधनुर्विस्फारयन्कर्णस्तस्थौ शत्रुजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2064298, "chapter_id": 2364, "verse_number": "८-८५-५७", "content_sanskrit": "तान्प्रद्रुतान्कुरून्दृष्ट्वा कर्णः शस्त्रभृतां वरः।\nसञ्चिन्तयित्वा पार्थस्य वधे दध्रे मनः श्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2064299, "chapter_id": 2364, "verse_number": "८-८५-५८", "content_sanskrit": "विस्फार्य सुमहच्चापं ततश्चाधिरथिर्वृषः।\nपाञ्चालान्पुनराधावत्पश्यतः सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2064300, "chapter_id": 2364, "verse_number": "८-८५-५९", "content_sanskrit": "ततः क्षणेन क्षितिपाः क्षतजप्रतिमेक्षणाः।\nशरौघैश्छादयामासुर्महामेघा इवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2064301, "chapter_id": 2364, "verse_number": "८-८५-६०", "content_sanskrit": "ततः शरसहस्राणि कर्णमुक्तानि मारिष।\nपाञ्चालानां हरत्प्राणांस्तमांसीव तमोनुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2064302, "chapter_id": 2364, "verse_number": "८-८५-६१", "content_sanskrit": "महदासीत्तदा युद्धं पाञ्चालानां महामते।\nवध्यतां सूतपुत्रेण मित्रार्थे मित्रगृद्धिना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2064303, "chapter_id": 2364, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे पञ्चाशीतितमोऽध्यायः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]