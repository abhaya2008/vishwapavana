[{"id": 2046908, "chapter_id": 2041, "verse_number": "६-९०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046909, "chapter_id": 2041, "verse_number": "६-९०-१", "content_sanskrit": "वर्तमाने तथा रौद्रे राजन्वीरवरक्षये।\nशकुनिः सौबलः श्रीमान्पाण्डवान्समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046910, "chapter_id": 2041, "verse_number": "६-९०-२", "content_sanskrit": "तथैव सात्वतो राजन्हार्दिक्यः परवीरहा।\nअभ्यद्रवत संग्रामे पाण्डवानां वरूथिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046911, "chapter_id": 2041, "verse_number": "६-९०-३", "content_sanskrit": "ततः काम्भोजमुख्यानां नदीजानां च वाजिनाम् ।\nआरट्टानां महीजानां सिन्धुजानां च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046912, "chapter_id": 2041, "verse_number": "६-९०-४", "content_sanskrit": "वनायुजानां शुभ्राणां तथा पर्वतवासिनाम् ।\nवाजिनां बहुभिः सङ्ख्ये समन्तात्परिवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046913, "chapter_id": 2041, "verse_number": "६-९०-५", "content_sanskrit": "ये चापरे तित्तिरिजा जवना वातरंहसः ।\nसुवर्णालङ्कृतैरेतैर्वर्मवद्भिः सुकल्पितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046914, "chapter_id": 2041, "verse_number": "६-९०-६", "content_sanskrit": "हयैर्वातजवैर्मुख्यैः पाण्डवस्य सुतो बली ।\nअभ्यवर्तत तत्सैन्यं हृष्टरूपः परंतपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046915, "chapter_id": 2041, "verse_number": "६-९०-७", "content_sanskrit": "अर्जुनस्य सुतः श्रीमानिरावान्नाम वीर्यवान् ।\nसुतायां नागराजस्य जातः पार्थेन धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046916, "chapter_id": 2041, "verse_number": "६-९०-८", "content_sanskrit": "ऐरावतेन सा दत्ता अनपत्या महात्मना ।\nपत्यौ हते सुपर्णेन कृपणा दीनचेतना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046917, "chapter_id": 2041, "verse_number": "६-९०-९", "content_sanskrit": "कार्यार्थं तां च जग्राह पार्थः कामवशानुगाम् ।\nएवमेष समुत्पन्नः परक्षेत्रेऽर्जुनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046918, "chapter_id": 2041, "verse_number": "६-९०-१०", "content_sanskrit": "स नागलोके संवृद्धो मात्रा च परिरक्षितः ।\nपितृव्येण परित्यक्तः पार्थद्वेषाद्दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046919, "chapter_id": 2041, "verse_number": "६-९०-११", "content_sanskrit": "खमुत्पत्य महाराज नागराट् सत्यविक्रमः ।\nइन्द्रलोकं जगामाशु श्रुत्वा तत्रार्जुनं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046920, "chapter_id": 2041, "verse_number": "६-९०-१२", "content_sanskrit": "सोऽभिगम्य महाबाहुः पितरं सत्यविक्रमः ।\nअभ्यवादयदव्यग्रो विनयेन कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046921, "chapter_id": 2041, "verse_number": "६-९०-१३", "content_sanskrit": "न्यवेदयत चात्मानमर्जुनस्य महात्मनः ।\nइरावानस्मि भद्रं ते पुत्रश्चाहं तव प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046922, "chapter_id": 2041, "verse_number": "६-९०-१४", "content_sanskrit": "मातुः समागमो यश्च तत्सर्वं प्रत्यवेदयत् ।\nतच्च सर्वं यथावृत्तमनुसस्मार पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046923, "chapter_id": 2041, "verse_number": "६-९०-१५", "content_sanskrit": "परिष्वज्य सुतं चापि आत्मनः सदृशं गुणैः ।\nप्रीतिमाननयत्पार्थो देवराजनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046924, "chapter_id": 2041, "verse_number": "६-९०-१६", "content_sanskrit": "सोऽर्जुनेन समाज्ञप्तो देवलोके तदा नृप ।\nप्रीतिपूर्वं महाबाहुः स्वकार्यं प्रति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046925, "chapter_id": 2041, "verse_number": "६-९०-१७", "content_sanskrit": "`स चापि नरशार्दूलः शार्दूलसमविक्रमः।\nअब्रवीच्च तदा पार्थमयमस्मि तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046926, "chapter_id": 2041, "verse_number": "६-९०-१८", "content_sanskrit": "स्थितः प्रेष्यश्च पुत्रश्च सर्वथा त्वं प्रशाधि माम् ।\nकं करोमि च ते कामं कं च कामं त्वमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046927, "chapter_id": 2041, "verse_number": "६-९०-१९", "content_sanskrit": "परिष्वज्य सुतं प्रेम्णा वासविः प्रत्युवाच तम्।\nप्रीतिपूर्वं च कार्यं च कार्या प्रीतिश्च मानदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046928, "chapter_id": 2041, "verse_number": "६-९०-२०", "content_sanskrit": "युद्धकाले तु साहाय्यं दातव्यं नो भवेदिति ।\nबाढमित्येवमुक्त्वा तु युद्धकाल इहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046929, "chapter_id": 2041, "verse_number": "६-९०-२१", "content_sanskrit": "कामवर्णजवैरश्वैः सर्वतः शुशुभे वृतः ।\nते हयाः काञ्चनापीडा नानावर्णा मनोजवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046930, "chapter_id": 2041, "verse_number": "६-९०-२२", "content_sanskrit": "उत्पेतुः सहसा राजन्हंसा इव महोदधौ ।\nते त्वदीयान्समासाद्य हयसंघान्मनोजवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046931, "chapter_id": 2041, "verse_number": "६-९०-२३", "content_sanskrit": "क्रोडैः क्रोडानभिघ्नन्तो घोणाभिश्च परस्परम् ।\nनिपेतुः सहसा राजन्सुवेगाभिहता भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046932, "chapter_id": 2041, "verse_number": "६-९०-२४", "content_sanskrit": "निपतद्भिस्तथा तैश्च हयसङ्घैः परस्परम् ।\nशुश्रुवे दारुणः शब्दः सुपर्णपतने यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046933, "chapter_id": 2041, "verse_number": "६-९०-२५", "content_sanskrit": "तथैव तावका राजन्समेत्यान्योन्यमाहवे ।\nपरस्परवधं घोरं चक्रुस्ते हयसादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046934, "chapter_id": 2041, "verse_number": "६-९०-२६", "content_sanskrit": "तस्मिंस्तथा वर्तमाने संकुले तुमुले भृशम् ।\nउभयोरपि संशान्ता हयसङ्घाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046935, "chapter_id": 2041, "verse_number": "६-९०-२७", "content_sanskrit": "प्रक्षीणसायकाः शूरा निहताश्वाः श्रमातुराः ।\nविलयं समनुप्राप्तास्तक्षमाणाः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046936, "chapter_id": 2041, "verse_number": "६-९०-२८", "content_sanskrit": "ततः क्षीणे हयानिके किंचिच्छेषे च भारत ।\nसौबलस्यानुजाः शूरा निर्गता रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046937, "chapter_id": 2041, "verse_number": "६-९०-२९", "content_sanskrit": "वायुवेगसमस्पर्शाञ्जवे वायुसमांश्च ते।\nआरुह्य बलसंपन्नान्वयःस्थांस्तुरगोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046938, "chapter_id": 2041, "verse_number": "६-९०-३०", "content_sanskrit": "गजो गवाक्षो वृषकश्चर्मवानार्जयः शुकः।\nषडेते बलसंपन्ना निर्ययुर्महतो बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046939, "chapter_id": 2041, "verse_number": "६-९०-३१", "content_sanskrit": "वार्यमाणाः शकुनिना स्वैश्च योधैर्महाबलैः ।\nसन्नद्धा युद्धकुशला रौद्ररूपा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046940, "chapter_id": 2041, "verse_number": "६-९०-३२", "content_sanskrit": "तदनीकं महाबहो भित्त्वा परमदुर्जयम् ।\nबलेन महता युक्ताः स्वर्गाय विजयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046941, "chapter_id": 2041, "verse_number": "६-९०-३३", "content_sanskrit": "विविशुस्ते तदा हृष्टा गान्धारा युद्धदुर्मदाः ।\nतान्प्रविष्टांस्तदा दृष्ट्वा इरावानपि वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046942, "chapter_id": 2041, "verse_number": "६-९०-३४", "content_sanskrit": "अब्रवीत्समरे योधान्स्वान्विचित्रहयस्थितान् ।\nयथैते धार्तराष्ट्रस्य योधाः सानुगवाहनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046943, "chapter_id": 2041, "verse_number": "६-९०-३५", "content_sanskrit": "हन्यन्ते समरे सर्वे तथा नीतिर्विधीयताम् ।\nबाढमित्येवमुक्त्वा ते सर्वे योधा इरावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046944, "chapter_id": 2041, "verse_number": "६-९०-३६", "content_sanskrit": "जघ्नुस्तेषां बलानीकं दुर्जयं समरे परैः ।\nतदनीकमनीकेन समरे वीक्ष्य पातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046945, "chapter_id": 2041, "verse_number": "६-९०-३७", "content_sanskrit": "अमृष्यमाणास्ते सर्वे सुबलस्यात्मजा रणे ।\nइरावन्तमभिद्रुत्य सर्वतः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046946, "chapter_id": 2041, "verse_number": "६-९०-३८", "content_sanskrit": "ताडयन्तः शितैः प्रासैश्चोदयन्तः परस्परम्।\nते शूराः पर्यधावन्त कुर्वन्तो महदाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046947, "chapter_id": 2041, "verse_number": "६-९०-३९", "content_sanskrit": "इरावानथ निर्भिन्नः प्रासैस्तीक्ष्णैर्महात्मभिः ।\nस्रवता रुधिरेणाक्तस्तोत्रैर्विद्ध इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046948, "chapter_id": 2041, "verse_number": "६-९०-४०", "content_sanskrit": "उरस्यपि च पृष्ठे च पार्श्वयोश्च भृशाहतः ।\nएको बहुभिरत्यर्थं धैर्याद्राजन्न विव्यथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046949, "chapter_id": 2041, "verse_number": "६-९०-४१", "content_sanskrit": "इरावानपि संक्रुद्धः सर्वास्तान्निशितैः शरैः ।\nमोहयामास समरे विद्ध्वा परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046950, "chapter_id": 2041, "verse_number": "६-९०-४२", "content_sanskrit": "प्रासानुत्कृष्य तरसा स्वशरीरादरिन्दमः ।\nतैरेव ताडयामास सुबलस्यात्मजान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046951, "chapter_id": 2041, "verse_number": "६-९०-४३", "content_sanskrit": "विकृष्य च शितं खङ्गं गृहीत्वा च शरावरम् ।\nपदातिर्द्रुतमागच्छज्जिघांसुः सौबलान्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046952, "chapter_id": 2041, "verse_number": "६-९०-४४", "content_sanskrit": "ततः प्रत्यागतप्राणाः सर्वे ते सुबलात्मजाः ।\nभूयः क्रोधसमाविष्टा इरावन्तमभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046953, "chapter_id": 2041, "verse_number": "६-९०-४५", "content_sanskrit": "इरावानपि खङ्गेन दर्शयन्पाणिलाघवम् ।\nअभ्यवर्तत देवांश्च मानुषांश्चैव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2046954, "chapter_id": 2041, "verse_number": "६-९०-४६", "content_sanskrit": "लाघवेनाथ चरतः सर्वे ते सुबलात्मजाः ।\nअन्तरं नाभ्यगच्छन्त चरन्तः शीघ्रगैर्हयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2046955, "chapter_id": 2041, "verse_number": "६-९०-४७", "content_sanskrit": "भूमिष्ठमथ तं सह्ख्ये ह्यन्तरिक्षादवप्लुतम् ।\nपरिवार्य भृशं सर्वे ग्रहीतुमुपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2046956, "chapter_id": 2041, "verse_number": "६-९०-४८", "content_sanskrit": "अथाभ्याशगतानां तेषां गात्राण्यकृन्तत ।\nअसिहस्तोऽस्त्रहस्तानां तेषां गात्राण्यकृन्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2046957, "chapter_id": 2041, "verse_number": "६-९०-४९", "content_sanskrit": "आयुधानि च सर्वेषां बाहूनपि विभूषितान्।\nअपतन्त निकृत्ताङ्गा मृता भूमौ गतासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2046958, "chapter_id": 2041, "verse_number": "६-९०-५०", "content_sanskrit": "वृषकस्तु महाराज बहुधा विपरिक्षतः।\nअमुच्यत महारौद्रात्तस्माद्वीरावकर्तनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2046959, "chapter_id": 2041, "verse_number": "६-९०-५१", "content_sanskrit": "तान्सर्वान्पतितान्दृष्ट्वा भीतो दुर्योधनस्ततः।\nअभ्यधावत संक्रुद्धो राक्षसं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2046960, "chapter_id": 2041, "verse_number": "६-९०-५२", "content_sanskrit": "आर्श्यशृङ्गिं महेष्वासं मायाविनमरिन्दमम्।\nवैरिणं भीमसेनस्य पूर्वं बकवधेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2046961, "chapter_id": 2041, "verse_number": "६-९०-५३", "content_sanskrit": "पश्य वीर यथा ह्येष फल्गुनस्य सुतो बली।\nमायावी विप्रियं कर्तुमकार्षीन्मे बलक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2046962, "chapter_id": 2041, "verse_number": "६-९०-५४", "content_sanskrit": "त्वं च कामगमस्तात मायास्त्रे च विशारदः ।\nकृतवैरश्च पार्थेन तस्मादेनं रणे जहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2046963, "chapter_id": 2041, "verse_number": "६-९०-५५", "content_sanskrit": "बाढमित्येवमुक्त्वा तु राक्षसो घोरदर्शनः ।\nप्रययौ सिंहनादेन यत्रार्जुनसुतो युवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2046964, "chapter_id": 2041, "verse_number": "६-९०-५६", "content_sanskrit": "स योधैर्युद्धकुशलैर्विमलप्रासयोधिभिः ।\nवीरैः प्रहारिभिर्युक्तैः स्वैरनीकैः समावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2046965, "chapter_id": 2041, "verse_number": "६-९०-५७", "content_sanskrit": "[हतशेषैर्महाराज द्विसाहस्त्रैर्हयोत्तमैः]\nनिहन्तुकामः समरे इरावन्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2046966, "chapter_id": 2041, "verse_number": "६-९०-५८", "content_sanskrit": "इरावानपि संक्रुद्धस्त्वरमाणः पराक्रमी\nहन्तुकाममयित्रघ्नो राक्षसं प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2046967, "chapter_id": 2041, "verse_number": "६-९०-५९", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य राक्षसः सुमहाबलः।\nत्वरमाणस्ततो मायां प्रयोक्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2046968, "chapter_id": 2041, "verse_number": "६-९०-६०", "content_sanskrit": "तेन मायामयाः सृष्टा हयास्तावन्त एव हि।\nस्वारूढा राक्षसैर्घोरैः शूलपट्टसधारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2046969, "chapter_id": 2041, "verse_number": "६-९०-६१", "content_sanskrit": "ते संरब्धाः समागम्य द्विसाहस्राः प्रहारिणः।\nअचिराद्गमयामासुः प्रेतलोकं परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2046970, "chapter_id": 2041, "verse_number": "६-९०-६२", "content_sanskrit": "तस्मिंस्तु निहते सैन्ये तावुभौ युद्धदुर्मदौ।\nसंग्रामे समतिष्ठेतां यथा वै वृत्रवासवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2046971, "chapter_id": 2041, "verse_number": "६-९०-६३", "content_sanskrit": "आद्रवन्तमभिप्रेक्ष्य राक्षसं युद्धदुर्मदम् ।\nइरावाथ संरब्धः प्रत्यधावन्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2046972, "chapter_id": 2041, "verse_number": "६-९०-६४", "content_sanskrit": "समभ्याशगतस्याजौ तस्य खङ्गेन दुर्मदः ।\nचिच्छेद कार्मुकं दीप्तं शरवापं च कञ्चुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2046973, "chapter_id": 2041, "verse_number": "६-९०-६५", "content_sanskrit": "स निकृत्तं धनुर्दृष्ट्वा खं जवेन समाविशत्।\nइरावन्तमभिक्रुद्धं मोहयन्निव मायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2046974, "chapter_id": 2041, "verse_number": "६-९०-६६", "content_sanskrit": "ततोऽन्तरिक्षमुत्पत्य इरावानपि राक्षसम्।\nविमोहयित्वा मायाभिसत्स्य गात्रामि सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2046975, "chapter_id": 2041, "verse_number": "६-९०-६७", "content_sanskrit": "चिच्छेद सर्वमर्मज्ञः कामरूपो दुरासदः ।\nतथा स राक्षसश्रेष्ठः शरैः कृत्तः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2046976, "chapter_id": 2041, "verse_number": "६-९०-६८", "content_sanskrit": "संबभूव महाराज समवाप च यौवनम् ।\nमाया हि सहराज समवाप च यौवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2046977, "chapter_id": 2041, "verse_number": "६-९०-६९", "content_sanskrit": "एवं तद्राक्षसस्याङ्गं छिन्नंछिन्नं व्यरोहत ।\nइरावानपि संक्रुद्धो राक्षसं त महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2046978, "chapter_id": 2041, "verse_number": "६-९०-७०", "content_sanskrit": "परश्वथेन तीक्ष्णेन चिच्छेद च पुनः पुनः ।\nस तेन बलिना वीरश्छिद्यमान इव द्रुमः ॥ ६-९०-७१aराक्षसो व्यनदद्धोरं स शब्दस्तुमुलोऽभवत्।\nपरश्वथक्षतं रक्षः सुस्राव बहुशोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2046979, "chapter_id": 2041, "verse_number": "६-९०-७२", "content_sanskrit": "ततश्रुक्रोध बलवांश्चक्रे वेगं च संयुगे।\nआर्श्यशृङ्गिस्ततो दृष्ट्वा समरे शत्रुमूर्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2046980, "chapter_id": 2041, "verse_number": "६-९०-७३", "content_sanskrit": "कृत्वा घोरं महद्रूपं ग्रहीतुमुपचक्रमे ।\nअर्जुनस्य सुतं वीरमिरावन्तं यशस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2046981, "chapter_id": 2041, "verse_number": "६-९०-७४", "content_sanskrit": "संग्रामशिरसो मध्ये सर्वेषां तत्र पश्यताम्।\nतां दृष्ट्वा तादृशीं मायां राक्षसस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2046982, "chapter_id": 2041, "verse_number": "६-९०-७५", "content_sanskrit": "इरावानपि संक्रुद्धो मायां स्रष्टुं प्रचक्रमे।\nतस्य क्रोधाभिभूतस्य समरेष्वनिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2046983, "chapter_id": 2041, "verse_number": "६-९०-७६", "content_sanskrit": "योऽन्वयो मातृकस्तस्य स एनमभिपेदिवान्।\nस नागैर्बहुभी राजन्निरावान्संवृतो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2046984, "chapter_id": 2041, "verse_number": "६-९०-७७", "content_sanskrit": "दधार सुमहद्रूपमनन्त इव भोगवान्।\nततो बहुविधैर्नागैश्छादयामास राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2046985, "chapter_id": 2041, "verse_number": "६-९०-७८", "content_sanskrit": "छाद्यमानस्तु नागैः स ध्यात्वा राक्षसपुङ्गवः।\nसौपर्णं रूपमास्थाय भक्षयामास पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2046986, "chapter_id": 2041, "verse_number": "६-९०-७९", "content_sanskrit": "मायया भक्षिते तस्मिन्नन्वये तस्य मातृके ।\nविमोहितमिरावन्तं न्यहनद्राक्षसोऽसिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2046987, "chapter_id": 2041, "verse_number": "६-९०-८०", "content_sanskrit": "सकुण्डलं समुकुटं पद्मेन्दुसदृशप्रभम् ।\nइरावतः शिरो रक्षः पातयामास भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2046988, "chapter_id": 2041, "verse_number": "६-९०-८१", "content_sanskrit": "तस्मिंस्तु निहते वीरे राक्षसेनार्जुनात्मजे।\nविशोकाः समपद्यन्त धार्तराष्ट्राः सराजकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2046989, "chapter_id": 2041, "verse_number": "६-९०-८२", "content_sanskrit": "तस्मिन्महति संग्रामे तादृशे भैरवे पुनः।\nमहान्व्यतिकरो घोरः सेनयोः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2046990, "chapter_id": 2041, "verse_number": "६-९०-८३", "content_sanskrit": "गजा हयाः पदाताश्च विमिश्रा दन्तिभिर्हताः ।\nरथाश्वा दन्तिनश्चैव पत्तिभिस्तत्र सूदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2046991, "chapter_id": 2041, "verse_number": "६-९०-८४", "content_sanskrit": "तथा पत्तिरथौघाश्च हयाश्च बहवो रणे।\nरथिभिर्निहता राजंस्तव तेषां च संकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2046992, "chapter_id": 2041, "verse_number": "६-९०-८५", "content_sanskrit": "अजानन्नर्जुनश्चापि निहतं पुत्रमौरसम्।\nजघान समरे शूरान्राज्ञस्तान्भीष्मरक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2046993, "chapter_id": 2041, "verse_number": "६-९०-८६", "content_sanskrit": "तथैव तावका राजन्सृञ्जयाश्च सहस्रशः।\nजुह्वतः समरे प्राणान्निजघ्रुरितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2046994, "chapter_id": 2041, "verse_number": "६-९०-८७", "content_sanskrit": "मुक्तकेशा विकवचा विरथाश्छिन्नकार्मुकाः ।\nबाहुभिः समयुध्यन्त समवेताः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2046995, "chapter_id": 2041, "verse_number": "६-९०-८८", "content_sanskrit": "तथा मर्मातिगैर्भीष्मो निजघान महारथान्।\nकम्पयन्समरे सेनां पाण्डवानां परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2046996, "chapter_id": 2041, "verse_number": "६-९०-८९", "content_sanskrit": "तेन यौधिष्ठिरे सैन्ये बहवो मानवा हताः।\nदन्तिनः सादिनश्चैव रथिनोऽथ हयास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2046997, "chapter_id": 2041, "verse_number": "६-९०-९०", "content_sanskrit": "तत्र भारत भीष्मस्य रणे दृष्ट्वा पराक्रमम् ।\nअत्यद्भुतमपश्याम शक्रस्येव पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2046998, "chapter_id": 2041, "verse_number": "६-९०-९१", "content_sanskrit": "तथैव भीमसेनस्य पार्षतस्य च भारत।\nरौद्रमासीद्रणे युद्धं सात्यकस्य च धन्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2046999, "chapter_id": 2041, "verse_number": "६-९०-९२", "content_sanskrit": "दृष्ट्वा द्रोणस्य विक्रान्तं पाण्डवान्भयमाविशत् ।\nएक एव रणे शक्तो निहन्तुं सर्वसैनिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2047000, "chapter_id": 2041, "verse_number": "६-९०-९३", "content_sanskrit": "किं पुनः पृथिवीशूरैर्योधव्रातैः समावृतः।\nइत्यब्रुवन्महाराज रणे द्रोणेन पीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2047001, "chapter_id": 2041, "verse_number": "६-९०-९४", "content_sanskrit": "वर्तमाने तथा रौद्रे संग्रामे भरतर्षभ ।\nउभयोः सेनयोः शूरा नामृष्यन्त परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2047002, "chapter_id": 2041, "verse_number": "६-९०-९५", "content_sanskrit": "आविष्टा इव युध्यन्ते रक्षोभूतैर्महाबलैः ।\nतावकाः पाण्डवेयाश्च संरब्धास्तात धन्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2047003, "chapter_id": 2041, "verse_number": "६-९०-९६", "content_sanskrit": "न स्म पश्यामहे कंचित्प्राणान्यः परिरक्षति।\nदैवासुराभे समरे तस्मिन्योधा नराधिप ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2047004, "chapter_id": 2041, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे नवतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-९०-३ वाजिनां वेगवतां वाजिनामश्वानां बहुभिर्गणैः परिवारयन्निति गणशब्दाध्याहारेण द्वयोः संबन्धः ॥ ६-९०-६ पाण्डवस्यार्जुनस्य सुत इरावान् ॥ ६-९०-७ नागराजस्य ऐरावतस्य ॥ ६-९०-१० पितृव्येण अश्वसेनेन ॥ ६-९०-५७ अयमर्धः श्लोको दाक्षिणात्यकोशेषु नास्ति खo झo पुस्तकयोरस्ति ॥ ६-९०-९५ आविष्टाः ग्रहाद्याविष्टाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]