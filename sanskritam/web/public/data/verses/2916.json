[{"id": 2089954, "chapter_id": 2916, "verse_number": "१३-४६-१", "content_sanskrit": "कृष्ण उवाच।\nमूर्ध्ना निपत्य नियतस्तेजःसन्निचये ततः।\nपरमं हर्षमागत्य भगवन्तमथाब्रवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089955, "chapter_id": 2916, "verse_number": "१३-४६-२", "content_sanskrit": "धर्मे दृढत्वं युधि शत्रुघातं\nयशस्तथाऽग्र्यं परमं बलं च\nयोगप्रियत्वं तव सन्निकर्षं\nवृणे सुतानां च शतं शतानि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089956, "chapter_id": 2916, "verse_number": "१३-४६-३", "content_sanskrit": "एवमस्त्विति तद्वाक्यं मयोक्तः प्राह शङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089957, "chapter_id": 2916, "verse_number": "१३-४६-४", "content_sanskrit": "ततो मां जगतो माता धारिणी सर्वपावनी।\nउवाचोमा प्रणिहिता शर्वाणी तपसां निधिः।\nदत्तो भगवता पुत्रः साम्बो नाम तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089958, "chapter_id": 2916, "verse_number": "१३-४६-५", "content_sanskrit": "मत्तोप्यष्टौ वरानिष्टान्गृहण त्वं ददामि ते।\nप्रणम्य शिरसा सा च मयोक्ता पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089959, "chapter_id": 2916, "verse_number": "१३-४६-६", "content_sanskrit": "द्विजेष्वकोपं पितृतः प्रसादं\nशतं सुतानां परमं च भोगम्।\nकुले प्रीतिं मातृतश्च प्रसादं-\nशमप्राप्तिं प्रवृणे चापि दाक्ष्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089960, "chapter_id": 2916, "verse_number": "१३-४६-७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089961, "chapter_id": 2916, "verse_number": "१३-४६-७", "content_sanskrit": "एवं भविष्यत्यमरप्रभाव\nनाहं मृषा जातु वदे कदाचित्।\nभार्यासहस्राणि च षोडशैव\nतासु प्रियत्वं च तथाऽक्षयं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089962, "chapter_id": 2916, "verse_number": "१३-४६-८", "content_sanskrit": "प्रीतिं चाग्र्यां बान्धवानां सकाशा-\nद्ददामि तेऽहं वपुषः काम्यतां च।\nभोक्ष्यन्ते वै सप्ततिं वै शतानि\nगृहे तुभ्यमतिथीनां च नित्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089963, "chapter_id": 2916, "verse_number": "१३-४६-९x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089964, "chapter_id": 2916, "verse_number": "१३-४६-९", "content_sanskrit": "एवं दत्त्वा वरान्देवो मम देवी च भारत।\nअन्तर्हितः क्षणे तस्मिन्सगणो भीमपूर्वज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089965, "chapter_id": 2916, "verse_number": "१३-४६-१०", "content_sanskrit": "एतदत्यद्भुतं पूर्वं ब्राह्मणायातितेजसे।\nउपमन्यवे मया कृत्स्नं व्याख्यातं पार्थिवोत्तम।\nनमस्कृत्वा तु स प्राह देवदेवाय सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089966, "chapter_id": 2916, "verse_number": "१३-४६-११", "content_sanskrit": "नास्ति शर्वसमो देवो नास्ति शर्वसमा गतिः।\nनास्ति शर्वसमो दाने नास्ति शर्वसमो रणे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089967, "chapter_id": 2916, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्चत्वारिंशोऽध्यायः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]