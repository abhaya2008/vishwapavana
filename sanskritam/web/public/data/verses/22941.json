[{"id": 7002941000, "chapter_id": 22941, "verse_number": "१-१८-१", "content_sanskrit": "सौतिरुवाच ।\nदेवाः सार्द्धं ब्राह्मणेन मोहिता विष्णुमायया ।\nप्रययुर्मालतीमूलं ब्रह्मेशानपुरोगमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002941001, "chapter_id": 22941, "verse_number": "१-१८-२", "content_sanskrit": "ब्रह्मा कमण्डलुजलं ददौ गात्रे शवस्य च ।\nसंचारं मनसस्तस्य चकार सुन्दरं वपुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002941002, "chapter_id": 22941, "verse_number": "१-१८-३", "content_sanskrit": "ज्ञानदानं ददौ तस्मै ज्ञानानन्दः शिवः स्वयम् ।\nधर्मज्ञानं स्वयं धर्मो जीवदानं च ब्राह्मणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002941003, "chapter_id": 22941, "verse_number": "१-१८-४", "content_sanskrit": "वह्निदर्शनमात्रेण बभूव जठरानलः ।\nकामदर्शनमात्रेण सर्वकामः सुनिश्चितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002941004, "chapter_id": 22941, "verse_number": "१-१८-५", "content_sanskrit": "तस्य वायोरधिष्ठानाज्जगत्प्राणस्वरूपिणः ।\nनिश्वासस्य च सञ्चारः प्राणानां च बभूव ह॥ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002941005, "chapter_id": 22941, "verse_number": "१-१८-६", "content_sanskrit": "सर्व्वाधिष्ठानमात्रेण दृष्टिशक्तिर्बभूव ह ।\nवाक्यं वाणीदर्शनेन शोभा श्रीदर्शनेन च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002941006, "chapter_id": 22941, "verse_number": "१-१८-७", "content_sanskrit": "शवस्तथाऽपि नोत्तस्थौ यथा शेते जडस्तथा ।\nविशिष्टबोधनं प्राप चाधिष्ठानं विनाऽऽत्मनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002941007, "chapter_id": 22941, "verse_number": "१-१८-८", "content_sanskrit": "ब्रह्मणो वचनात्साध्वी तुष्टाव परमेश्वरम् ।\nस्नात्वा शीघ्रं सरित्तोये धृत्वा धौते च वाससी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002941008, "chapter_id": 22941, "verse_number": "१-१८-९", "content_sanskrit": "मालावत्युवाच ।\nवन्दे तं परमात्मानं सर्वकारणकारणम् ।\nविना येन शवाः सर्वे प्राणिनो जगतीतले ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002941009, "chapter_id": 22941, "verse_number": "१-१८-१०", "content_sanskrit": "निर्लिप्तं साक्षिरूपं च सर्वेषां सर्वकर्मसु ।\nविद्यमानं न दृष्टं च सर्वैः सर्वत्र सर्वदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002941010, "chapter_id": 22941, "verse_number": "१-१८-११", "content_sanskrit": "येन सृष्टा च प्रकृतिः सर्वाधारो परात्परा ।\nब्रह्मविष्णुशिवादीनां प्रसूर्या त्रिगुणात्मिका ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002941011, "chapter_id": 22941, "verse_number": "१-१८-१२", "content_sanskrit": "जगत्स्रष्टा स्वयं ब्रह्मा नियतो यस्य सेवया ।\nपाता विष्णुश्च जगतां संहर्त्ता शङ्करः स्वयम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002941012, "chapter_id": 22941, "verse_number": "१-१८-१३", "content_sanskrit": "ध्यायन्ते यं सुराः सर्वे मुनयो मनवस्तथा ।\nसिद्धाश्च योगिनः सन्तः सन्ततं प्रकृतेः परम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002941013, "chapter_id": 22941, "verse_number": "१-१८-१४", "content_sanskrit": "साकारं च निराकारं परं स्वेच्छामयं विभुम् ।\nवरं वरेण्यं वरदं वरार्हं वरकारणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002941014, "chapter_id": 22941, "verse_number": "१-१८-१५", "content_sanskrit": "तपःफलं तपोबीजं तपसां च फलप्रदम् ।\nस्वयंतपःस्वरूपं च सर्वरूपं च सर्वतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002941015, "chapter_id": 22941, "verse_number": "१-१८-१६", "content_sanskrit": "सर्वाधारं सर्वबीजं कर्म तत्कर्मणां फलम् ।\nतेषां च फलदातारं तद्बीजं क्षयकारणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002941016, "chapter_id": 22941, "verse_number": "१-१८-१७", "content_sanskrit": "स्वयंतेजःस्वरूपं च भक्तानुग्रहविग्रहम् ।\nसेवाध्यानं न घटते भक्तानां विग्रहं विना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002941017, "chapter_id": 22941, "verse_number": "१-१८-१८", "content_sanskrit": "तत्तेजो मण्डलाकारं सूर्यकोटिसमप्रभम् ।\nअतीव कमनीयं च रूपं तत्र मनोहरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002941018, "chapter_id": 22941, "verse_number": "१-१८-१९", "content_sanskrit": "नवीननीरदश्यामं शरत्पङ्कजलोचनम् ।\nशरत्पार्वणचन्द्रास्यमीषद्धास्यसमन्वितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002941019, "chapter_id": 22941, "verse_number": "१-१८-२०", "content_sanskrit": "कोटिकन्दर्पलावण्यं लीलाधाम मनोहरम् ।\nचन्दनोक्षितसर्वाङ्गं रत्नभूषणभूषितम्॥ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002941020, "chapter_id": 22941, "verse_number": "१-१८-२१", "content_sanskrit": "द्विभुजं मुरलीहस्तं पीतकौशेयवाससम् ।\nकिशोरवयसं शान्तं राधाकान्तमनन्तकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002941021, "chapter_id": 22941, "verse_number": "१-१८-२२", "content_sanskrit": "गोपाङ्गनापरिवृतं कुत्रचिन्निर्जने वने ।\nकुत्रचिद्रासमध्यस्थं राधया परिषेवितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002941022, "chapter_id": 22941, "verse_number": "१-१८-२३", "content_sanskrit": "कुत्रचिद्गोपवेषं च वेष्टितं गोपबालकैः ।\nशतशृङ्गाचलोत्कृष्टे रम्ये वृन्दावने वने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002941023, "chapter_id": 22941, "verse_number": "१-१८-२४", "content_sanskrit": "निकरं कामधेनूनां रक्षन्तं शिशुरूपिणम् ।\nगोलोके विरजातीरे पारिजातवने वने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002941024, "chapter_id": 22941, "verse_number": "१-१८-२५", "content_sanskrit": "वेणुं क्वणन्तं मधुरं गोपीसम्मोहकारणम् ।\nनिरामये च वैकुंठे कुत्रचिच्च चतुर्भुजम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002941025, "chapter_id": 22941, "verse_number": "१-१८-२६", "content_sanskrit": "लक्ष्मीकान्तं पार्षदैश्च सेवितं च चतुर्भुजैः ।\nकुत्रचित्स्वांशरूपेण जगतां पालनाय च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002941026, "chapter_id": 22941, "verse_number": "१-१८-२७", "content_sanskrit": "श्वेतद्वीपे विष्णुरूपं पद्मया परिषेवितम् ।\nकुत्रचित्स्वांशकलया ब्रह्माण्डब्रह्मरूपिणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002941027, "chapter_id": 22941, "verse_number": "१-१८-२८", "content_sanskrit": "शिवस्वरूपं शिवदं स्वांशेन शिवरूपिणम् ।\nस्वात्मनः षोडशांशेन सर्वाधारं परात्परम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002941028, "chapter_id": 22941, "verse_number": "१-१८-२९", "content_sanskrit": "स्वयं महद्विराड्रूपं विश्वौघं यस्य लोमसु ।\nलीलया स्वांशकलया जगतां पालनाय च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002941029, "chapter_id": 22941, "verse_number": "१-१८-३०", "content_sanskrit": "नानावतारं बिभ्रन्तं बीजं तेषां सनातनम्॥।\nवसन्तं कुत्रचित्सन्तं योगिनां हृदये सताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002941030, "chapter_id": 22941, "verse_number": "१-१८-३१", "content_sanskrit": "प्राणरूपं प्राणिनां च परमात्मानमीश्वरम्॥।\nतं च स्तोतुमशक्ताऽहमबला निर्गुणं विभुम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002941031, "chapter_id": 22941, "verse_number": "१-१८-३२", "content_sanskrit": "निर्लक्ष्यं च निरीहं च सारं वाङ्मनसोः परम् ।\nयं स्तोतुमक्षमोऽनन्तः सहस्रवदनेन च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002941032, "chapter_id": 22941, "verse_number": "१-१८-३३", "content_sanskrit": "पञ्चवक्त्रश्चतुर्वक्त्रो गजवक्त्रः षडाननः ।\nयं स्तोतुं न क्षमा माया मोहिता यस्य मायया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002941033, "chapter_id": 22941, "verse_number": "१-१८-३४", "content_sanskrit": "यं स्तोतुं न क्षमा श्रीश्च जडीभूता सरस्वती ।\nवेदा न शक्ता यं स्तोतुं को वा विद्वांश्च वेदवित् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002941034, "chapter_id": 22941, "verse_number": "१-१८-३५", "content_sanskrit": "किं स्तौमि तमनीहं च शोकार्त्ता स्त्री परात्परम् ।\nइत्युक्त्वा सा च गान्धर्वी विरराम रुरोद च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002941035, "chapter_id": 22941, "verse_number": "१-१८-३६", "content_sanskrit": "कृपानिधिं प्रणनाम भयार्ता च पुनः पुनः ।\nकृष्णश्च शक्तिभिः सार्द्धमधिष्ठानं चकार ह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002941036, "chapter_id": 22941, "verse_number": "१-१८-३७", "content_sanskrit": "भर्तुरस्यान्तरे तस्याः परमात्मा निराकृतिः॥। ।\nउत्थाय शीघ्रं वीणां च धृत्वा स्नात्वा च वाससी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002941037, "chapter_id": 22941, "verse_number": "१-१८-३८", "content_sanskrit": "प्रणनाम देवसंघं ब्राह्मणं पुरतः स्थितम् ।\nनेदुर्दुन्दुभयो देवाः पुष्पवृष्टिं च चक्रिरे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002941038, "chapter_id": 22941, "verse_number": "१-१८-३९", "content_sanskrit": "दृष्ट्वा चोपरि दम्पत्योः प्रददुः परमाशिषम् ।\nगन्धर्वो देवपुरतो ननर्त्त च जगौ क्षणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002941039, "chapter_id": 22941, "verse_number": "१-१८-४०", "content_sanskrit": "जीवितं पुरतः प्राप देवानां च वरेण च ।\nजगाम पत्न्या सार्द्धं च पित्रा मात्रा च हर्षितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002941040, "chapter_id": 22941, "verse_number": "१-१८-४१", "content_sanskrit": "उपबर्हणगन्धर्वो गन्धर्वनगरं पुनः ।\nमालावती रत्नकोटिं धनानि विविधानि च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002941041, "chapter_id": 22941, "verse_number": "१-१८-४२", "content_sanskrit": "प्रददौ ब्राह्मणेभ्यश्च भोजयामास तान्सती ।\nवेदांश्च पाठयामास कारयामास मङ्गलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002941042, "chapter_id": 22941, "verse_number": "१-१८-४३", "content_sanskrit": "महोत्सवं च विविधं हरेर्नामैकमङ्गलम् ।\nजग्मुर्देवाश्च स्वस्थानं विप्ररूपी हरिः स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002941043, "chapter_id": 22941, "verse_number": "१-१८-४४", "content_sanskrit": "एतत्ते कथितं सर्वं स्तवराजं च शौनक ।\nइदं स्तोत्रं पुण्यरूपं पूजाकाले तु यः पठेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002941044, "chapter_id": 22941, "verse_number": "१-१८-४५", "content_sanskrit": "हरिभक्तिं हरेर्दास्यं लभते वैष्णवोजनः॥।\nवरार्थी यः पठेद्भक्त्या चास्तिकः परमास्थया ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002941045, "chapter_id": 22941, "verse_number": "१-१८-४६", "content_sanskrit": "धर्मार्थकाममोक्षाणां निश्चितं लभते फलम् ।\nविद्यार्थी लभते विद्यां धनार्थी लभते धनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002941046, "chapter_id": 22941, "verse_number": "१-१८-४७", "content_sanskrit": "भार्य्यार्थी लभते भार्य्यां पुत्रार्थी लभते सुतम् ।\nधर्मार्थी लभते धर्मं यशोऽर्थी लभते यशः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002941047, "chapter_id": 22941, "verse_number": "१-१८-४८", "content_sanskrit": "भ्रष्टराज्यो लभेद्राज्यं प्रजाभ्रष्टः प्रजां लभेत् ।\nरोगार्त्तो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002941048, "chapter_id": 22941, "verse_number": "१-१८-४९", "content_sanskrit": "भयान्मुच्येत भीतस्तु धनं नष्टधनो लभेत् ।\nदस्युग्रस्तो महारण्ये हिंस्रजन्तुसमन्वितः ।\nदावाग्निदग्धो मुच्येत निमग्नश्च जलार्णवे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]