[{"id": 2024106, "chapter_id": 1516, "verse_number": "३-१५४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024107, "chapter_id": 1516, "verse_number": "३-१५४-१", "content_sanskrit": "स गत्वानलिनीं रम्यां राक्षसैरभिरक्षिताम्।\nकैलासशिरे रम्ये ददर्श शुभकानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024108, "chapter_id": 1516, "verse_number": "३-१५४-२", "content_sanskrit": "कुबेरभुवनाभ्याशे जातां पर्वतनिर्झरैः।\nसुरम्यां विपुलच्छायां नानाद्रुमलताकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024109, "chapter_id": 1516, "verse_number": "३-१५४-३", "content_sanskrit": "हरिताम्बुजसंछन्नां दिव्यां कनकपुष्कराम्।\nनानापक्षिजनाकीर्णां सूपतीर्थामकर्दमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024110, "chapter_id": 1516, "verse_number": "३-१५४-४", "content_sanskrit": "अतीव रम्यां सुजलां जातां पर्वतसानुषु।\nविचित्रभूतां लोकस्य शुभामद्भुतदर्शनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024111, "chapter_id": 1516, "verse_number": "३-१५४-५", "content_sanskrit": "तत्रामृतरसं शीतं लघु कुन्तीसुतः शुभम्।\nददर्शविमलं तोयं पिबंश्च बहु पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024112, "chapter_id": 1516, "verse_number": "३-१५४-६", "content_sanskrit": "तां तु कपुष्करिणीं रम्यां दिव्यसौगन्धिकावृताम्।\nजातरूपमयैः पद्मैश्छन्नां परमगन्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024113, "chapter_id": 1516, "verse_number": "३-१५४-७", "content_sanskrit": "वैडूर्यवरनालैश्च बहुचित्रैर्मनोरमैः।\nहंसकारण्डवोद्धूतैः सृजद्भिरमलं रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024114, "chapter_id": 1516, "verse_number": "३-१५४-८", "content_sanskrit": "आक्रीडं राजराजस् कुबेरस्य महात्मनः।\nगन्धर्वैरप्सरोभिश्च देवैश्च परमार्चिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024115, "chapter_id": 1516, "verse_number": "३-१५४-९", "content_sanskrit": "सेवितामृषिभिर्दिव्यैर्यक्षैः किंपुरुषैस्तथा।\nराक्षसैः किंनरैश्चापि गुप्तां वैश्रवणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024116, "chapter_id": 1516, "verse_number": "३-१५४-१०", "content_sanskrit": "तां च दृष्ट्वैव कौन्तेयो भीमसेनो महाहलः।\nबभूव परमप्रीतो दिव्यंप्रेक्ष्य सरो महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024117, "chapter_id": 1516, "verse_number": "३-१५४-११", "content_sanskrit": "तच्च क्रोवशा नाम राक्षसा राजशासनात्।\nरक्षन्ति शतसाहस्राश्चित्रायुधपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024118, "chapter_id": 1516, "verse_number": "३-१५४-१२", "content_sanskrit": "ते तु दृष्ट्वैव कौन्तेयमजिनैः परिवारितम्।\nरुक्माङ्गदधरं वीरं भीमं भीमपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024119, "chapter_id": 1516, "verse_number": "३-१५४-१३", "content_sanskrit": "सायुधं बद्धनिस्त्रिंशमशङ्कितमरिंदमम्।\nपुष्करप्सुमुपायान्तमन्योन्यमभिचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024120, "chapter_id": 1516, "verse_number": "३-१५४-१४", "content_sanskrit": "अयं पुरुषशार्दूलः सायुधोऽजिनसंवृतः।\nयच्चिकीर्षुरिह प्राप्तस्तत्संप्रष्टुमिहार्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024121, "chapter_id": 1516, "verse_number": "३-१५४-१५", "content_sanskrit": "ततः सर्वे महाबाहुं समासाद्यवृकोदरम्।\nतेजोयुक्तमपृच्छन्त कस्त्वमाख्यातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024122, "chapter_id": 1516, "verse_number": "३-१५४-१६", "content_sanskrit": "मुनिवेषधरश्चैव सायुधश्चैव लक्ष्यसे।\nयदर्थमाभिसंप्राप्तस्तदाचक्ष्यमहामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024123, "chapter_id": 1516, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्तयात्रापर्वणि चतुःपञ्चाशदधिकशततमोऽध्यायः ॥ १५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]