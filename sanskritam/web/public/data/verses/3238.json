[{"id": 2103216, "chapter_id": 3238, "verse_number": "१४-९४-१", "content_sanskrit": "जनमेजय उवाच।\nधर्मागतेन त्यागेन भगवन्सर्वमस्ति चेत्।\nएतन्मे सर्वमाचक्ष्व कुशलो ह्यसि भाषितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103217, "chapter_id": 3238, "verse_number": "१४-९४-२", "content_sanskrit": "तस्योञ्छवृत्तेर्यद्वृत्तं सक्तुदाने फलं महत्।\nकथितं तु मम ब्रह्मंस्तथ्यमेतदसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103218, "chapter_id": 3238, "verse_number": "१४-९४-३", "content_sanskrit": "कथं हि सर्वयज्ञेषु निश्चयः परमो भवेत्।\nएतदर्हसि मे वक्तुं निखिलेन द्विजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103219, "chapter_id": 3238, "verse_number": "१४-९४-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103220, "chapter_id": 3238, "verse_number": "१४-९४-४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअगस्त्यस्य महायज्ञे पुरावृत्तमरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103221, "chapter_id": 3238, "verse_number": "१४-९४-५", "content_sanskrit": "पुराऽगस्त्यो महातेजा दीक्षां द्वादशवार्षिकीम्।\nप्रविवेश महाराज सर्वभूतहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103222, "chapter_id": 3238, "verse_number": "१४-९४-६", "content_sanskrit": "तत्राग्निकल्पा होतार आसन्सत्रे महात्मनः।\nमूलाहाराः फलाहाराश्चाश्मकुट्टा मरीचिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103223, "chapter_id": 3238, "verse_number": "१४-९४-७", "content_sanskrit": "परिपृष्टिका वैघसिकाः प्रसङ्ख्यानास्तथैव च।\nयतयो भिक्षवश्चात्र बभूवुः पर्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103224, "chapter_id": 3238, "verse_number": "१४-९४-८", "content_sanskrit": "सर्वे प्रत्यक्षधर्माणो जितक्रोधा जितेन्द्रियाः।\nदमे स्थिताश्च सर्वे ते हिंसादंभविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103225, "chapter_id": 3238, "verse_number": "१४-९४-९", "content_sanskrit": "वृत्ते शुद्धे स्थिता नित्यमिन्द्रियैश्चाप्यबाधिताः।\nउपातिष्ठन्त तं यज्ञं यजन्तस्ते महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103226, "chapter_id": 3238, "verse_number": "१४-९४-१०", "content_sanskrit": "यथाशक्त्या भगवता तदन्नं समुपार्जितम्।\nतस्मिन्सत्रे तु यद्वृत्तं यद्योग्यं च तदाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103227, "chapter_id": 3238, "verse_number": "१४-९४-११", "content_sanskrit": "तथा ह्यनेकैर्मुनिभिर्महान्तः क्रतवः कृताः।\nएवंविधे त्वगस्त्यस्य वर्तमाने तथाऽध्वरे।\nन ववर्ष सहस्राक्षस्तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103228, "chapter_id": 3238, "verse_number": "१४-९४-१२", "content_sanskrit": "ततः कर्मान्तरे राजन्नगस्त्यस्य महात्मनः।\nकथेयमभिनिर्वृत्ता मुनीनां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103229, "chapter_id": 3238, "verse_number": "१४-९४-१३", "content_sanskrit": "अगस्त्यो यजमानोसौ ददात्यन्नं विमत्सरः।\nन च वर्षति पर्जन्यः कथमन्नं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103230, "chapter_id": 3238, "verse_number": "१४-९४-१४", "content_sanskrit": "सत्रं चेदं महद्विप्रा मुनेर्द्वादशवार्षिकम्।\nन वर्षिष्यति देवश्च वर्षाण्येतानि द्वादश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103231, "chapter_id": 3238, "verse_number": "१४-९४-१५", "content_sanskrit": "एतद्भवन्तः संचिन्त्य महर्षेरस्य धीमतः।\nअगस्त्यस्यातितपसः कर्तुमर्हन्त्यनुग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103232, "chapter_id": 3238, "verse_number": "१४-९४-१६", "content_sanskrit": "इत्येवमुक्ते वचने ततोऽगस्त्यः प्रतापवान्।\nप्रोवाच वाक्यं स तदा प्रसाद्य शिरसा मुनीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103233, "chapter_id": 3238, "verse_number": "१४-९४-१७", "content_sanskrit": "यदि द्वादशवर्षाणि न वर्षिष्यति वासवः।\nचिन्तायज्ञं करिष्यामि विधिरेष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103234, "chapter_id": 3238, "verse_number": "१४-९४-१८", "content_sanskrit": "यदि द्वादशवर्षाणि न वर्षिष्यति वासवः।\nस्पर्शयज्ञं करिष्यामि विधिरेष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103235, "chapter_id": 3238, "verse_number": "१४-९४-१९", "content_sanskrit": "यदि द्वादशवर्षाणि न वर्षिष्यति वासवः।\nव्यायामेनाहरिष्यामि यज्ञानेतान्यतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103236, "chapter_id": 3238, "verse_number": "१४-९४-२०", "content_sanskrit": "बीजयज्ञो मयाऽयं वै बहुवर्षसमाचितः।\nबीजैर्हितं करिष्यामि नात्र विघ्नो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103237, "chapter_id": 3238, "verse_number": "१४-९४-२१", "content_sanskrit": "नेदं शक्यं वृथा कर्तुं मम सत्रं कथञ्चन।\nवर्षिष्यतीह वा देवो नवा वर्षं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103238, "chapter_id": 3238, "verse_number": "१४-९४-२२", "content_sanskrit": "अथवाऽभ्यर्थनामिन्द्रो न करिष्यति कामतः।\nस्वयमिन्द्रो भविष्यामि जीवयिष्यामि च प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103239, "chapter_id": 3238, "verse_number": "१४-९४-२३", "content_sanskrit": "यो यदाहारजातश्च स तथैव भविष्यति।\nविशेषं चैव कर्तास्मि पुनः पुनरतीव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103240, "chapter_id": 3238, "verse_number": "१४-९४-२४", "content_sanskrit": "अद्येह स्वर्णमभ्येतु यच्चान्यद्वसु दुर्लभम्।\nत्रिषु लोकेषु यच्चास्ति तदिहागम्यतां स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103241, "chapter_id": 3238, "verse_number": "१४-९४-२५", "content_sanskrit": "दिव्याश्चाप्सरसां सङ्घा गन्धर्वाश्च सकिन्नराः।\nविश्वावसुश्च ये चान्ये तेऽप्युपासन्तु मे मखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103242, "chapter_id": 3238, "verse_number": "१४-९४-२६", "content_sanskrit": "उत्तरेभ्यः कुरुभ्यश्च यत्किंचिद्वसु विद्यते।\nसर्वं तदिह यज्ञेषु स्वयमेवोपतिष्ठतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103243, "chapter_id": 3238, "verse_number": "१४-९४-२७", "content_sanskrit": "स्वर्गः स्वर्गसदश्चैवक धर्मश्च स्वयमेव तु।\nइत्युक्ते सर्वमेवैतदभवत्तपसा मुनेः।\nतस्य दीप्ताग्निमहसस्त्वगस्त्यस्यातितेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103244, "chapter_id": 3238, "verse_number": "१४-९४-२८", "content_sanskrit": "ततस्ते मुनयो हृष्टा ददृशुस्तपसो बलम्।\nविस्मिता वचनं प्राहुरिदं सर्वे महार्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103245, "chapter_id": 3238, "verse_number": "१४-९४-२९", "content_sanskrit": "प्रीताः स्म तव वाक्येन न त्विच्छामस्तपोवनम्।\nतैरेव यज्ञैस्तुष्टाः स्य न्यायेनेच्छामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103246, "chapter_id": 3238, "verse_number": "१४-९४-३०", "content_sanskrit": "यज्ञं दीक्षां तथा होमान्यच्चान्यन्मृगयामहे।\n`तयोस्संधर्षितैर्यज्ञैर्नान्यतो मृगयामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103247, "chapter_id": 3238, "verse_number": "१४-९४-३१", "content_sanskrit": "न्यायेनोपार्जिताहाराः स्वकर्माभिरता वयम्।\nवेदांश्च ब्रह्मचर्येण न्यायतः प्रार्थयामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103248, "chapter_id": 3238, "verse_number": "१४-९४-३२", "content_sanskrit": "न्यायेनोत्तरकालं च गृहेभ्यो निःसृता वयम्।\nधर्मदृष्टैर्विधिद्वारैस्तपस्तप्स्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103249, "chapter_id": 3238, "verse_number": "१४-९४-३३", "content_sanskrit": "भवतः सम्यगिष्टा तु बुद्धिर्हिसाविवर्जिता।\nएतामहिंसा यज्ञेषु ब्रूयास्त्वं सततं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103250, "chapter_id": 3238, "verse_number": "१४-९४-३४", "content_sanskrit": "प्रीतास्ततो भविष्यामो वयं तु द्विजसत्तम।\nविसर्जिताः समाप्तौ च सत्रादस्माद्व्रजामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103251, "chapter_id": 3238, "verse_number": "१४-९४-३५", "content_sanskrit": "तथा कथयतां तेषां देवराजः पुरंदरः।\nववर्ष सुमहातेजा दृष्ट्वा तस्य तपोबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103252, "chapter_id": 3238, "verse_number": "१४-९४-३६", "content_sanskrit": "आसमाप्तेश्च यज्ञस्य तस्यामितपराक्रमः।\nनिकामवर्षी पर्जन्यो बभूव जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103253, "chapter_id": 3238, "verse_number": "१४-९४-३७", "content_sanskrit": "प्रसादयामास च तमगस्त्यं त्रिदशेश्वरः।\nस्वयमभ्येत्य राजर्षे पुरस्कृत्य बृहस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103254, "chapter_id": 3238, "verse_number": "१४-९४-३८", "content_sanskrit": "ततो यज्ञसमाप्तौ तान्विससर्ज महामुनीन्।\nअगस्त्यः परमप्रीतः पूजयित्वा यथाविधि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103255, "chapter_id": 3238, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वि चतुर्नवतितमोऽध्यायः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]