[{"id": 6000320000, "chapter_id": 10320, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000320001, "chapter_id": 10320, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.001.m4a", "display_order": 2}, {"id": 6000320002, "chapter_id": 10320, "verse_number": "११-१९-१", "content_sanskrit": "यो विद्याश्रुतसम्पन्न आत्मवानानुमानिकः।\nमायामात्रमिदं ज्ञात्वा ज्ञानं च मयि सन्न्यसेत्॥ ११/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.002.m4a", "display_order": 3, "topics": [{"text": "ज्ञानादीनां यमादीनां च स्वरूपकथनम्", "range": "१–४६"}]}, {"id": 6000320003, "chapter_id": 10320, "verse_number": "११-१९-२", "content_sanskrit": "ज्ञानिनस्त्वहमेवेष्टः स्वार्थो हेतुश्च सम्मतः।\nस्वर्गश्चैवापवर्गश्च नान्योऽर्थो मदृते प्रियः॥ ११/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.003.m4a", "display_order": 4}, {"id": 6000320004, "chapter_id": 10320, "verse_number": "११-१९-३", "content_sanskrit": "ज्ञानविज्ञानसम्बद्धाः पदं श्रेष्ठं विदुर्मम।\nज्ञानी प्रियतमोऽतो मे ज्ञानेनासौ बिभर्ति माम्॥ ११/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.004.m4a", "display_order": 5}, {"id": 6000320005, "chapter_id": 10320, "verse_number": "११-१९-४", "content_sanskrit": "तपस्तीर्थं जपो दानं पवित्राणीतराणि च।\nनालं कुर्वन्ति तां शुद्धिं या ज्ञानकलया कृता॥ ११/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.005.m4a", "display_order": 6}, {"id": 6000320006, "chapter_id": 10320, "verse_number": "११-१९-५", "content_sanskrit": "ज्ञानविज्ञानसहितं ज्ञात्वा स्वात्मानमुद्धव।\nज्ञानविज्ञानसम्पन्नो भज मां भक्तिभावितः॥ ११/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.006.m4a", "display_order": 7}, {"id": 6000320007, "chapter_id": 10320, "verse_number": "११-१९-६", "content_sanskrit": "ज्ञानविज्ञानयज्ञेन मामिष्ट्वाऽऽत्मानमात्मनि।\nसर्वयज्ञपतिं मां वै संसिद्धिं मुनयोऽन्वगुः॥ ११/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.007.m4a", "display_order": 8}, {"id": 6000320008, "chapter_id": 10320, "verse_number": "११-१९-७", "content_sanskrit": "त्वय्युद्धवाऽश्रयति यस्त्रिविधो विकारो मायाऽन्तराऽपतति नाद्यपवर्गयोर्यः।\nजन्मादयोऽस्य वद मां तव तस्य किं स्युराद्यन्तयोर्यदसतोऽस्ति तदेव मध्ये॥ ११/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.008.m4a", "display_order": 9}, {"id": 6000320009, "chapter_id": 10320, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.009.m4a", "display_order": 10}, {"id": 6000320010, "chapter_id": 10320, "verse_number": "११-१९-८", "content_sanskrit": "ज्ञानं विशुद्धं विपुलं यथैतद् वैराग्यविज्ञानयुतं पुराणम्।\nआख्याहि विश्वेश्वर विश्वमूर्ते त्वद्भक्तियोगं च महद्विमृग्यम्॥ ११/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.010.m4a", "display_order": 11}, {"id": 6000320011, "chapter_id": 10320, "verse_number": "११-१९-९", "content_sanskrit": "तापत्रयेणाभिहतस्य घोरे सन्तप्यमानस्य भवाध्वनीश।\nपश्यामि नान्यच्छरणं तवाङ्घ्रिद्वन्द्वातपत्रादमृताभिवर्षात्॥ ११/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.011.m4a", "display_order": 12}, {"id": 6000320012, "chapter_id": 10320, "verse_number": "११-१९-१०", "content_sanskrit": "दष्टं जनं सम्पतितं बिलेऽस्मिन् कालाहिना क्षुद्रसुखोरुतर्षम्।\nसमुद्धरैनं कृपयाऽपवर्ग्यैर्वचोभिरासिञ्च महानुभाव॥ ११/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.012.m4a", "display_order": 13}, {"id": 6000320013, "chapter_id": 10320, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.013.m4a", "display_order": 14}, {"id": 6000320014, "chapter_id": 10320, "verse_number": "११-१९-११", "content_sanskrit": "इत्थमेतत् पुरा राजा भीष्मं धर्मभृतां वरम्।\nअजातशत्रुः पप्रच्छ सर्वेषामनुशृण्वताम्॥ ११/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.014.m4a", "display_order": 15}, {"id": 6000320015, "chapter_id": 10320, "verse_number": "११-१९-१२", "content_sanskrit": "निवृत्ते भारते युद्धे सुहृन्निधनविह्वलः।\nश्रुत्वा धर्मान् बहून् भीष्मं मोक्षधर्मानपृच्छत॥ ११/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.015.m4a", "display_order": 16}, {"id": 6000320016, "chapter_id": 10320, "verse_number": "११-१९-१३", "content_sanskrit": "तानहं तेऽभिधास्यामि देवव्रतमुखाच्छ्रुतान्।\nज्ञानविज्ञानवैराग्यश्रद्धाभक्त्युपबृंहितान्॥ ११/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.016.m4a", "display_order": 17}, {"id": 6000320017, "chapter_id": 10320, "verse_number": "११-१९-१४", "content_sanskrit": "नवैकादश पञ्च त्रीन् भावान् भूतेषु येन वै।\nईक्षेतान्वेकमप्येषु तज्ज्ञानं मम निश्चितम्॥ ११/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.017.m4a", "display_order": 18}, {"id": 6000320018, "chapter_id": 10320, "verse_number": "११-१९-१५", "content_sanskrit": "एतदेव हि विज्ञानं न तथैकेन येन यत्।\nस्थित्युत्पत्त्यप्यया नः स्युर्भावानां त्रिगुणात्मनाम्॥ ११/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.018.m4a", "display_order": 19}, {"id": 6000320019, "chapter_id": 10320, "verse_number": "११-१९-१६", "content_sanskrit": "आदावन्ते च मध्ये च यज्ज्ञं सृज्यं यदन्वयात्।\nपुनस्तत्प्रतिसङ्क्रामे यच्छिष्येत तदेव सत्॥ ११/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.019.m4a", "display_order": 20}, {"id": 6000320020, "chapter_id": 10320, "verse_number": "११-१९-१७", "content_sanskrit": "श्रुतिः प्रत्यक्षमैतिह्यमनुमानं चतुष्टयम्।\nप्रमाणेष्वनवस्थानाद् विकल्पात् स विरज्यते॥ ११/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.020.m4a", "display_order": 21}, {"id": 6000320021, "chapter_id": 10320, "verse_number": "११-१९-१८", "content_sanskrit": "कर्मणां फलरूपत्वादाविरिञ्चादमङ्गलम्।\nविपश्चिन्नश्वरं पश्येददृष्टमपि दृष्टवत्॥ ११/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.021.m4a", "display_order": 22}, {"id": 6000320022, "chapter_id": 10320, "verse_number": "११-१९-१९", "content_sanskrit": "भक्तियोगः पुरैवोक्तः प्रीयमाणाय तेऽनघ।\nपुनश्च कथयिष्यामि मद्भक्तेः कारणं परम्॥ ११/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.022.m4a", "display_order": 23}, {"id": 6000320023, "chapter_id": 10320, "verse_number": "११-१९-२०", "content_sanskrit": "श्रद्धाऽमृतकथायां मे शश्वन्मदनुकीर्तनम्।\nपरिनिष्ठा च पूजायां स्तुतिभिः स्तवनं मम॥ ११/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.023.m4a", "display_order": 24}, {"id": 6000320024, "chapter_id": 10320, "verse_number": "११-१९-२१", "content_sanskrit": "आदरः परिचर्यायां सर्वाङ्गैरभिवन्दनम्।\nमद्भक्तपूजाऽभ्यधिका सर्वभूतेषु मन्मतिः॥ ११/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.024.m4a", "display_order": 25}, {"id": 6000320025, "chapter_id": 10320, "verse_number": "११-१९-२२", "content_sanskrit": "मदर्थेष्वङ्गचेष्टा च वचसा मद्गुणेरणम्।\nमय्यर्पणं च मनसः सर्वकामविसर्जनम्॥ ११/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.025.m4a", "display_order": 26}, {"id": 6000320026, "chapter_id": 10320, "verse_number": "११-१९-२३", "content_sanskrit": "मदर्थे च परित्यागो भोगस्य च सुखस्य च।\nइष्टं दत्तं हुतं भुक्तं मदर्थं यद् व्रतं तपः॥ ११/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.026.m4a", "display_order": 27}, {"id": 6000320027, "chapter_id": 10320, "verse_number": "११-१९-२४", "content_sanskrit": "एवं धर्मैर्मनुष्याणामुद्धवाऽत्मनिवेदिनाम्।\nमयि संजायते भक्तिः कोऽन्योऽर्थोऽस्यावशिष्यते॥ ११/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.027.m4a", "display_order": 28}, {"id": 6000320028, "chapter_id": 10320, "verse_number": "११-१९-२५", "content_sanskrit": "यदा मय्यर्पितं चित्तं शान्तं सत्वोपबृंहितम्।\nधर्मं ज्ञानं सवैराग्यमैश्वर्यं चाभिपद्यते॥ ११/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.028.m4a", "display_order": 29}, {"id": 6000320029, "chapter_id": 10320, "verse_number": "११-१९-२६", "content_sanskrit": "यद्यर्पितं तद्विकल्प इन्द्रियैः परिधावति।\nरजस्वलमसन्निष्ठं चित्तं विद्धि विपर्ययम्॥ ११/१९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.029.m4a", "display_order": 30}, {"id": 6000320030, "chapter_id": 10320, "verse_number": "११-१९-२७", "content_sanskrit": "धर्मो मद्भक्तिकृत् प्रोक्तो ज्ञानं चैकात्म्यदर्शनम्।\nगुणेष्वसङ्गो वैराग्यमैश्वर्यं चाणिमादयः॥ ११/१९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.030.m4a", "display_order": 31}, {"id": 6000320031, "chapter_id": 10320, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.031.m4a", "display_order": 32}, {"id": 6000320032, "chapter_id": 10320, "verse_number": "११-१९-२८", "content_sanskrit": "यमः कतिविधः प्रोक्तो नियमो वाऽरिकर्शन।\nकः शमः को दमः कृष्ण का तितिक्षा धृतिः प्रभो॥ ११/१९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.032.m4a", "display_order": 33}, {"id": 6000320033, "chapter_id": 10320, "verse_number": "११-१९-२९", "content_sanskrit": "किं दानं किं तपः शौर्यं किं सत्यम् ऋतमुच्यते।\nकिमन्नं तृप्तिजननं किञ्च शौचं जनार्दन॥ ११/१९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.033.m4a", "display_order": 34}, {"id": 6000320034, "chapter_id": 10320, "verse_number": "११-१९-३०", "content_sanskrit": "कस्त्यागः किं धनं श्रेष्ठं को यज्ञः का च दक्षिणा।\nपुंसः किंस्विद् बलं श्रीमद् भगो लाभश्च केशव॥ ११/१९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.034.m4a", "display_order": 35}, {"id": 6000320035, "chapter_id": 10320, "verse_number": "११-१९-३१", "content_sanskrit": "का विद्या ह्रीः परा का श्रीः किं सुखं दुःखमेव च।\nकः पण्डितः कश्च मूर्खः कः पन्था उत्पथश्च कः॥ ११/१९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.035.m4a", "display_order": 36}, {"id": 6000320036, "chapter_id": 10320, "verse_number": "११-१९-३२", "content_sanskrit": "कः स्वर्गो नरकः कः स्वित् को बन्धुरुत किं गृहम्।\nक आढ्यः को दरिद्रो वा कृपणः कः क ईश्वरः॥ ११/१९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.036.m4a", "display_order": 37}, {"id": 6000320037, "chapter_id": 10320, "verse_number": "११-१९-३३", "content_sanskrit": "एतान् प्रश्नान् मम ब्रूहि विपरीतं च सत्पते॥ ११/१९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.037.m4a", "display_order": 38}, {"id": 6000320038, "chapter_id": 10320, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.038.m4a", "display_order": 39}, {"id": 6000320039, "chapter_id": 10320, "verse_number": "११-१९-३४", "content_sanskrit": "अहिंसा सत्यमस्तेयमसङ्गो ह्रीरसञ्चयः।\nआस्तिक्यं ब्रह्मचर्यं च मौनं स्थैर्यं क्षमाऽभयम्॥ ११/१९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.039.m4a", "display_order": 40}, {"id": 6000320040, "chapter_id": 10320, "verse_number": "११-१९-३५", "content_sanskrit": "शौचं जपस्तपो होमः श्रद्धातिथ्यं मदर्चनम्।\nतीर्थाटनं परार्थेहा तुष्टिराचार्यसेवनम्॥ ११/१९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.040.m4a", "display_order": 41}, {"id": 6000320041, "chapter_id": 10320, "verse_number": "११-१९-३६", "content_sanskrit": "एते यमाः सनियमा उभयोर्द्वादश स्मृताः।\nपुंसामुपासितास्तात यथाकामं दुहन्ति हि॥ ११/१९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.041.m4a", "display_order": 42}, {"id": 6000320042, "chapter_id": 10320, "verse_number": "११-१९-३७", "content_sanskrit": "शमो मन्निष्ठता बुद्धेर्दम इन्द्रियनिग्रहः ।\nतितिक्षा दुःखसम्मर्षो जिह्वोपस्थजयो धृतिः॥ ११/१९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.042.m4a", "display_order": 43}, {"id": 6000320043, "chapter_id": 10320, "verse_number": "११-१९-३८", "content_sanskrit": "दण्डन्यासः परं दानं कामत्यागस्तपः स्मृतम् ।\nस्वभावविजयः शौर्यं सत्वं च समदर्शनम्॥ ११/१९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.043.m4a", "display_order": 44}, {"id": 6000320044, "chapter_id": 10320, "verse_number": "११-१९-३९", "content_sanskrit": "ऋतं च सूनृता वाणी कविभिः परिकीर्तिता।\nकर्मस्वसङ्गमः शौचं त्यागः सन्न्यास उच्यते॥ ११/१९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.044.m4a", "display_order": 45}, {"id": 6000320045, "chapter_id": 10320, "verse_number": "११-१९-४०", "content_sanskrit": "धर्म इष्टं धनं नॄणां यज्ञोऽहं भगवत्तमः।\nदक्षिणा ज्ञानसन्देशः प्राणायामः परं बलम्॥ ११/१९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.045.m4a", "display_order": 46}, {"id": 6000320046, "chapter_id": 10320, "verse_number": "११-१९-४१", "content_sanskrit": "भगो म ऐश्वरो भावो लाभो मद्भक्तिरुत्तमा।\nविद्याऽऽत्मनि भिदाबोधो जुगुप्सा ह्रीर्विकर्मसु॥ ११/१९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.046.m4a", "display_order": 47}, {"id": 6000320047, "chapter_id": 10320, "verse_number": "११-१९-४२", "content_sanskrit": "श्रीर्गुणा नैरपेक्ष्याद्याः सुखं दुःखात्ययात् सुखम्।\nदुःखं कामसुखापेक्षा पण्डितो बन्धमोक्षवित्॥ ११/१९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.047.m4a", "display_order": 48}, {"id": 6000320048, "chapter_id": 10320, "verse_number": "११-१९-४३", "content_sanskrit": "मूर्खो देहाद्यहंबुद्धिः पन्था मन्निगमः स्मृतः।\nउत्पथश्चित्तविक्षेपः स्वर्गः सत्वगुणोदयः॥ ११/१९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.048.m4a", "display_order": 49}, {"id": 6000320049, "chapter_id": 10320, "verse_number": "११-१९-४४", "content_sanskrit": "नरकस्तमउन्नाहो बन्धुर्गुरुरहं सखा।\nगृहं शरीरं मानुष्यं गुणाढ्यो ह्याढ्य उच्यते॥ ११/१९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.049.m4a", "display_order": 50}, {"id": 6000320050, "chapter_id": 10320, "verse_number": "११-१९-४५", "content_sanskrit": "दरिद्रो यस्त्वसंतुष्टः कृपणो योऽजितेन्द्रियः। गुणेष्वसक्तधीरीशो गुणसङ्गी विपर्ययः ।\nएत उद्धव ते प्रश्नाः सर्वे साधु निरूपिताः॥ ११/१९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.050.m4a", "display_order": 51}, {"id": 6000320051, "chapter_id": 10320, "verse_number": "११-१९-४६", "content_sanskrit": "किं वर्णितेन बहुना लक्षणं गुणदोषयोः ।\nगुणदोषदृशिर्दोषो गुणस्तूभयवर्जनम्॥ ११/१९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_019/BhP_11.019.051.m4a", "display_order": 52}, {"id": 6000320052, "chapter_id": 10320, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्ध एकोनविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]