[{"id": 2189519, "chapter_id": 5023, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189520, "chapter_id": 5023, "verse_number": "१", "content_sanskrit": "अथ ज्ञानप्लवं धीरो गृहीत्वा शान्तिमास्थितः ।\nउन्मज्जंश्च निमज्जंश्च ज्ञानमेवाभिसंश्रयेत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189521, "chapter_id": 5023, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189522, "chapter_id": 5023, "verse_number": "२", "content_sanskrit": "किं तज्ज्ञानमथो विद्या यया निस्तरति द्वयम् ।\nप्रवृत्तिलक्षणो धर्मो निवृत्तिरिति चैव हि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2189523, "chapter_id": 5023, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2189524, "chapter_id": 5023, "verse_number": "३", "content_sanskrit": "यस्तु पश्येत् स्वभावेन विना भावमचेतनः ।\nपुष्यते च पुनः सर्वान् प्रज्ञया मुक्तहेतुकः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2189525, "chapter_id": 5023, "verse_number": "४", "content_sanskrit": "येषां चैकान्तभावेन स्वभावः कारणं मतम् ।\nदूर्वातृणबृसीका वै ते लभन्ते न किञ्चन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2189526, "chapter_id": 5023, "verse_number": "५", "content_sanskrit": "ये चैनं पक्षमाश्रित्य वर्तयन्त्यल्पचेतसः ।\nस्वभावं कारणं ज्ञात्वा न श्रेयः प्राप्नुवन्ति ते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2189527, "chapter_id": 5023, "verse_number": "६", "content_sanskrit": "स्वभावो हि विनाशाय मोहकर्ममनोभवः ।\nनिरुक्तमेतयोरेतत् स्वभावपरिभावयोः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2189528, "chapter_id": 5023, "verse_number": "७", "content_sanskrit": "कृष्यादीनि हि कर्माणि सस्यसंहरणानि च ।\nप्रज्ञावद्भिः प्रक्लृप्तानि यानासनगृहाणि च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2189529, "chapter_id": 5023, "verse_number": "८", "content_sanskrit": "आक्रीडानां गृहाणां च गदानामगदस्य च ।\nप्रज्ञावन्तः प्रवक्तारो ज्ञानवद्भिरनुष्ठिताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2189530, "chapter_id": 5023, "verse_number": "९", "content_sanskrit": "प्रज्ञा संयोजयत्यर्थैः प्रज्ञा श्रेयोऽधिगच्छति ।\nराजानो भुञ्जते राज्यं प्रज्ञया तुल्यलक्षणाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2189531, "chapter_id": 5023, "verse_number": "१०", "content_sanskrit": "पारावर्यं तु भूतानां ज्ञानेनैवोपलभ्यते ।\nविद्यया तात सृष्टानां विद्यैव परमा गतिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2189532, "chapter_id": 5023, "verse_number": "११", "content_sanskrit": "भूतानां जन्म सर्वेषां विविधानां चतुर्विधम् ।\nजराय्वण्डमथोद्भेदं स्वेदं चाप्युपलक्षयेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2189533, "chapter_id": 5023, "verse_number": "१२", "content_sanskrit": "स्थावरेभ्यो विशिष्टानि जङ्गमान्युपलक्षयेत् ।\nउपपन्नं हि यच्चेष्टा विशिष्येत विशेष्ययोः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2189534, "chapter_id": 5023, "verse_number": "१३", "content_sanskrit": "आहुर्द्विबहुपादानि जङ्गमानि द्वयानि च ।\nबहुपाद्भ्यो विशिष्टानि द्विपादानि बहून्यपि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2189535, "chapter_id": 5023, "verse_number": "१४", "content_sanskrit": "द्विपदानि द्वयान्याहुः पार्थिवान्युत्तराणि च ।\nपार्थिवानि विशिष्टानि तानि ह्यन्नानि भुञ्जते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2189536, "chapter_id": 5023, "verse_number": "१५", "content_sanskrit": "पार्थिवानि द्वयान्याहुर्मध्यमानीतराणि च ।\nमध्यमानि विशिष्टानि जातिधर्मोपधारणात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2189537, "chapter_id": 5023, "verse_number": "१६", "content_sanskrit": "मध्यमानि द्वयान्याहुर्धर्मज्ञानीतराणि च ।\nधर्मज्ञानि विशिष्टानि कार्याकार्योपधारणात्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2189538, "chapter_id": 5023, "verse_number": "१७", "content_sanskrit": "धर्मज्ञानि द्वयान्याहुर्वेदज्ञानीतराणि च ।\nवेदज्ञानि विशिष्टानि वेदो ह्येषु प्रतिष्ठितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2189539, "chapter_id": 5023, "verse_number": "१८", "content_sanskrit": "वेदज्ञानि द्वयान्याहुः प्रवक्तॄणीतराणि च ।\nप्रवक्तॄणि विशिष्टानि सर्वधर्मोपधारणात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2189540, "chapter_id": 5023, "verse_number": "१९", "content_sanskrit": "विज्ञायन्ते हि यैर्वेदाः सर्वधर्मक्रियाफलाः ।\nसयज्ञाः सखिला वेदाः प्रवक्तृभ्यो विनिःसृताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2189541, "chapter_id": 5023, "verse_number": "२०", "content_sanskrit": "प्रवक्तॄणि द्वयान्याहुरात्मज्ञानीतराणि च ।\nआत्मज्ञानि विशिष्टानि जन्माजन्मोपधारणात्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2189542, "chapter_id": 5023, "verse_number": "", "content_sanskrit": "धर्मद्वयं हि यो वेद स सर्वः सर्वधर्मविद् ।\nस त्यागी सत्यसङ्कल्पः स तु क्षान्तः स ईश्वरः\t॥२१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2189543, "chapter_id": 5023, "verse_number": "२२", "content_sanskrit": "धर्मज्ञानप्रतिष्ठं हि तं देवा ब्राह्मणं विदुः ।\nशब्दब्रह्मणि निष्णातं परे च कृतनिश्चयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2189544, "chapter_id": 5023, "verse_number": "२३", "content_sanskrit": "अन्तःस्थं च बहिष्ठं च येऽऽधियज्ञाधिदैवतम् ।\nजानन्ति तान्नमस्यामस्ते देवास्तात ते द्विजाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2189545, "chapter_id": 5023, "verse_number": "२४", "content_sanskrit": "तेषु विश्वमिदं भूतं साग्रं च जगदाहितम् ।\nतेषां माहात्म्यभावस्य सदृशं नास्ति किञ्चन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2189546, "chapter_id": 5023, "verse_number": "२५", "content_sanskrit": "आदिं ते निधनं चैव कर्म चातीत्य सर्वशः ।\nचतुर्विधस्य भूतस्य सर्वस्येशाः स्वयम्भुवः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2189547, "chapter_id": 5023, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि द्वासप्ततितमोऽध्यायः ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]