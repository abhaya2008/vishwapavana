[{"id": 2041802, "chapter_id": 1931, "verse_number": "५-१७६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041803, "chapter_id": 1931, "verse_number": "५-१७६-१", "content_sanskrit": "ततस्ते तापसाः सर्वे कार्यवन्तोऽभवंस्तदा।\nतां कन्यां चिन्तयन्तस्ते किंकार्यमिति धर्मिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041804, "chapter_id": 1931, "verse_number": "५-१७६-२", "content_sanskrit": "केचिदाहुः पितुर्वेश्म नीयतामिति तापसाः ।\nकेचिदस्यदुमालम्भे मतिं चक्रुर्हि तापसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041805, "chapter_id": 1931, "verse_number": "५-१७६-३", "content_sanskrit": "केचित्साल्वपतिं गत्वा नियोज्यमिति मेनिरे।\nनेति केचिद्व्यवस्यन्ति प्रत्याख्याता हि तेन सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041806, "chapter_id": 1931, "verse_number": "५-१७६-४", "content_sanskrit": "एवं गते तु किं शक्यं भद्रे कर्तुं मनीषिभिः ।\nपुनरूचुश्च तां सर्वे तापसाः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041807, "chapter_id": 1931, "verse_number": "५-१७६-५", "content_sanskrit": "अलं प्रव्रजितेनेह भद्रे श्रृणु हितं वचः।\nइतो गच्छस्व भद्रं ते पितुरेव निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041808, "chapter_id": 1931, "verse_number": "५-१७६-६", "content_sanskrit": "प्रतिपस्त्यति राजा स पिता ते यदनन्तरम् ।\nतत्र वत्स्यसि कल्याणि सुखं सर्वगुणान्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041809, "chapter_id": 1931, "verse_number": "५-१७६-७", "content_sanskrit": "न च तेऽन्या गतिर्न्याय्या भवेद्भद्रे यथा पिता ।\nपतिर्वापि गतिर्नार्याः पिता वा वरवर्णिनि ।\nगतिः पतिः समस्थाया विषमे च पिता गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041810, "chapter_id": 1931, "verse_number": "५-१७६-८", "content_sanskrit": "प्रव्रज्या हि सुदुःखेयं सुकुमार्या विशेषतः ।\nराजपुत्र्याः प्रकृत्या चक कुमार्यास्तव भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041811, "chapter_id": 1931, "verse_number": "५-१७६-९", "content_sanskrit": "भद्रे दोषा हि विद्यन्ते बहवो वरवर्णिनि ।\nआश्रमे वै वसन्त्यास्ते न भवेयुः पितुर्गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041812, "chapter_id": 1931, "verse_number": "५-१७६-१०", "content_sanskrit": "ततस्त्वन्येऽब्रुवन्वाक्यं तापसास्तां तपस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041813, "chapter_id": 1931, "verse_number": "५-१७६-११", "content_sanskrit": "त्वामिहैकाकिनीं दृष्ट्वा निर्जने गहने वने।\nप्रार्थयिष्यन्तिराजानस्तस्मान्मैवं मनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041814, "chapter_id": 1931, "verse_number": "५-१७६-१२x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041815, "chapter_id": 1931, "verse_number": "५-१७६-१२", "content_sanskrit": "न शक्यं काशिनगरं पुनर्गन्तुं पितुर्गृहान्।\nअवज्ञाता भविष्यामि बान्धवानां न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041816, "chapter_id": 1931, "verse_number": "५-१७६-१३", "content_sanskrit": "उषितास्मि तथा बाल्ये पितुर्वेश्मनि तापसाः ।\nनाहं गमिष्ये भद्रं वस्तत्र यत्र पिता मम।\nतपस्तप्तुमभीप्सामि तापसैः परिरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041817, "chapter_id": 1931, "verse_number": "५-१७६-१४", "content_sanskrit": "यथा परेऽपि मे लोके न स्यादेवं महात्ययः ।\nदौर्भाग्यं तापसश्रेष्ठास्तस्मात्तप्स्याम्यहं तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041818, "chapter_id": 1931, "verse_number": "५-१७६-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041819, "chapter_id": 1931, "verse_number": "५-१७६-१५", "content_sanskrit": "इत्येवं तेषु विप्रेषु चिन्तयन्सु यथातथम्।\nराजर्षिस्तद्वनं प्राप्तस्तपस्वी होत्रवाहनः ।\n`तां तथा भाविनीं दृष्ट्वा श्रुत्वा चोद्विग्रमानसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041820, "chapter_id": 1931, "verse_number": "५-१७६-१६", "content_sanskrit": "ततस्ते तापसाः सर्वे पूजयन्ति स्म तं नृपम् ।\nपूजाभिः स्वागताद्याभिरासनेनोदकेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041821, "chapter_id": 1931, "verse_number": "५-१७६-१७", "content_sanskrit": "तस्योपविष्टस्य सतो विश्रान्तस्योपश्रृण्वतः।\nपुनरेव कथां चक्रुः कन्यां प्रति वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041822, "chapter_id": 1931, "verse_number": "५-१७६-१८", "content_sanskrit": "अम्बायास्तां कथां श्रुत्वा काशिराज्ञश्च भारत।\nराजर्षिः स महातेजा बभूवोद्विग्रमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041823, "chapter_id": 1931, "verse_number": "५-१७६-१९", "content_sanskrit": "तां तथावादिनीं श्रुत्वा दृष्ट्वा च स महातपाः ।\nराजर्षिः कृपयाविष्टो महात्मा होत्रवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041824, "chapter_id": 1931, "verse_number": "५-१७६-२०", "content_sanskrit": "स वेपमान उत्थाय मातुस्तस्याः पिता तदा।\nतां कन्यामङ्कमारोप्य पर्यश्वासयत प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041825, "chapter_id": 1931, "verse_number": "५-१७६-२१", "content_sanskrit": "स तामपृच्छत्कार्त्स्न्येन व्यसनोत्पत्तिमादितः ।\nसा च तस्मै यथावृत्तं विस्तरेण न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041826, "chapter_id": 1931, "verse_number": "५-१७६-२२", "content_sanskrit": "ततः स राजर्षिरभूद्दुःखशोकसमन्वितः।\nकार्यं च प्रतिपेदे तन्मनसां सुमहातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041827, "chapter_id": 1931, "verse_number": "५-१७६-२३", "content_sanskrit": "अब्रवीद्वेपमानश्च कन्यामार्तां सुदुःखितः ।\nमा गाः पितुर्गृहं भद्रे मातुस्ते जनको ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041828, "chapter_id": 1931, "verse_number": "५-१७६-२४", "content_sanskrit": "दुःखं छिन्द्यामहं ते वै मयि वर्तस्व पुत्रिके।\nपर्याप्तं ते मनो वत्से यदेवं परिशुष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041829, "chapter_id": 1931, "verse_number": "५-१७६-२५", "content_sanskrit": "गच्छ मद्वचनाद्रामं जामदग्न्यं तपस्विनम् ।\nरामस्ते सुमहद्दुःखं शोकं चैवापनेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041830, "chapter_id": 1931, "verse_number": "५-१७६-२६", "content_sanskrit": "हनिष्यति रणे भीष्मं न करिष्यति चेद्वचः ।\nतं गच्छ भार्गवश्रेष्ठं कालाग्निसमतेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041831, "chapter_id": 1931, "verse_number": "५-१७६-२७", "content_sanskrit": "प्रतिष्ठापयिता स त्वां समे पथि महातपाः ।\nततस्तु सुस्वरं बाष्पसुत्सृजन्ती पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041832, "chapter_id": 1931, "verse_number": "५-१७६-२८", "content_sanskrit": "अब्रवीत्पितरं मातुः मा तदा होत्रवाहनम् ।\nअभिवादयित्वा शिरसा गमिष्ये तव शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041833, "chapter_id": 1931, "verse_number": "५-१७६-२९", "content_sanskrit": "अपि नामाद्य पश्येयमार्यं तं लोकविश्रुतम् ।\nकथं च तीव्रं दुःकं मे नाशकयिष्यति भार्गवः।\nएतदिच्छाम्यहं ज्ञातुं यथा यास्यमि तत्र वैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041834, "chapter_id": 1931, "verse_number": "५-१७६-३०x", "content_sanskrit": "होत्रवाहन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041835, "chapter_id": 1931, "verse_number": "५-१७६-३०", "content_sanskrit": "रामं द्रक्ष्यसि भद्रे त्वं जामदग्न्यं महावने।\nउग्रे तपसि वर्तन्तं सत्यसन्धं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041836, "chapter_id": 1931, "verse_number": "५-१७६-३१", "content_sanskrit": "महेन्द्रं वै गिरिश्रेष्ठं रामो नित्यमुपास्ति ह।\nऋषयो वेदविद्वांसो गन्धर्वाप्सरसस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041837, "chapter_id": 1931, "verse_number": "५-१७६-३२", "content_sanskrit": "तत्र गच्छस्व भद्रं ते ब्रूयाश्चैनं वचो मम।\nअभिवाद्य च तं मूंर्ध्ना तपोवृद्धं दृढव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041838, "chapter_id": 1931, "verse_number": "५-१७६-३३", "content_sanskrit": "ब्रूयाश्चैनं पुनर्भद्रे यत्ते कार्यं मनीषितम् ।\nमयि संकीर्तिते रामः सर्वं तत्ते करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041839, "chapter_id": 1931, "verse_number": "५-१७६-३४", "content_sanskrit": "मम रामः सखा वत्से प्रीतियुक्तः सुहृच्च मे।\nजमदग्निसुतो वीरः सर्वशस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041840, "chapter_id": 1931, "verse_number": "५-१७६-३५", "content_sanskrit": "एवं ब्रुवति कन्यां तु पार्थिवे होत्रवाहने ।\nअकृतव्रणः प्रादुरासीद्रामस्यानुचरः प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041841, "chapter_id": 1931, "verse_number": "५-१७६-३६", "content_sanskrit": "ततस्ते मनुयः सर्वे समुत्तस्थुः महस्रशः ।\nस च राजा वयोवृद्धः सृञ्ययो होत्रवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041842, "chapter_id": 1931, "verse_number": "५-१७६-३७", "content_sanskrit": "ततो दृष्ट्वा कृतातिथ्यमन्योन्यं ते वनौकसः ।\nसहिता भरतश्रेष्ठ निषेदुः परिवार्य तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041843, "chapter_id": 1931, "verse_number": "५-१७६-३८", "content_sanskrit": "ततस्ते कथयामासुः कथास्तास्ता मनोरमाः ।\nधन्या दिव्याश्च राजेन्द्र प्रीतिहर्षमुदा युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041844, "chapter_id": 1931, "verse_number": "५-१७६-३९", "content_sanskrit": "ततः कथान्ते राजर्षिर्महात्मा होत्रवाहनः ।\nरामं श्रेष्ठं महर्षीणामपृच्छदकृतव्रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041845, "chapter_id": 1931, "verse_number": "५-१७६-४०", "content_sanskrit": "क्व संप्रति महाबाहो जामदग्न्यः प्रतापवान् ।\nअकृतव्रण शक्यो वै द्रुष्टुं वेदविदां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041846, "chapter_id": 1931, "verse_number": "५-१७६-४१x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041847, "chapter_id": 1931, "verse_number": "५-१७६-४१", "content_sanskrit": "भवन्तमेव सततं रामः कीर्तयति प्रभो।\nसृञ्जयो मे प्रियसखो राजर्षिरिति पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2041848, "chapter_id": 1931, "verse_number": "५-१७६-४२", "content_sanskrit": "इह रामः प्रभाते श्वो भवितेति मतिर्मम।\nद्रष्टस्येनमिहायान्तं तव दर्शनकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2041849, "chapter_id": 1931, "verse_number": "५-१७६-४३", "content_sanskrit": "इयं च कन्या राजर्षे किमर्थं वनमागता।\nकस्य चेयं तव च का भवतीच्छामि वेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2041850, "chapter_id": 1931, "verse_number": "५-१७६-४४x", "content_sanskrit": "होत्रवाहन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2041851, "chapter_id": 1931, "verse_number": "५-१७६-४४", "content_sanskrit": "दौहित्रीयं मम विभो काशिराजसुता प्रिया।\nज्येष्ठा स्वयंवरे तस्थौ भगिनीभ्यां सहानध ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2041852, "chapter_id": 1931, "verse_number": "५-१७६-४५", "content_sanskrit": "इयमम्बेति विख्याता ज्येष्ठा काशिपतेः सुता।\nअम्बिकाम्बालिके कन्ये कनीयस्यौ तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2041853, "chapter_id": 1931, "verse_number": "५-१७६-४६", "content_sanskrit": "समेतं पार्थिवं क्षत्रं काशिपुर्यां ततोऽभवत्।\nकन्यानिमित्तं विप्रर्षे तत्रासीदुत्सवो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2041854, "chapter_id": 1931, "verse_number": "५-१७६-४७", "content_sanskrit": "तता किल महावीर्यो भीष्मः शान्तनवो नृपान् ।\nअधिक्षिप्य महातेजास्तिस्त्रः कन्या जहार ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2041855, "chapter_id": 1931, "verse_number": "५-१७६-४८", "content_sanskrit": "निर्जित्य पृथिवीपालानथ भीष्मो जगाह्वयम् ।\nआजगाम विशुद्धात्मा कन्याभिः सह भारतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2041856, "chapter_id": 1931, "verse_number": "५-१७६-४९", "content_sanskrit": "सत्यवत्यै निवेद्याथ विवाहं समनन्तरम् ।\nभ्रातुर्विचित्रवीर्यस्य समाज्ञापयत प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2041857, "chapter_id": 1931, "verse_number": "५-१७६-५०", "content_sanskrit": "तं तु वैवाहिकं दृष्ट्वा कन्येयं समुपार्जितम् ।\nअब्रवीत्तत्र गाङ्गेयं मन्त्रिमध्ये द्विजर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2041858, "chapter_id": 1931, "verse_number": "५-१७६-५१", "content_sanskrit": "मया साल्वपतिर्वीरो मनसाऽभिवृतः पतिः ।\nन ममार्हसि धर्मज्ञ दातुं भ्रात्रेऽन्यमानसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2041859, "chapter_id": 1931, "verse_number": "५-१७६-५२", "content_sanskrit": "तच्छ्रुत्वा वचनं भीष्मः संमन्त्र्य सह मन्त्रिभिः ।\nनिश्चित्य विससर्जेमां सत्यवत्या मते स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2041860, "chapter_id": 1931, "verse_number": "५-१७६-५३", "content_sanskrit": "अनुज्ञाता तु भीष्मेण साल्वं सौभपतिं ततः।\nकन्येयं मुदिता तत्र काले वाचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2041861, "chapter_id": 1931, "verse_number": "५-१७६-५४", "content_sanskrit": "विसर्जितास्मि भीष्मेण धर्मं मां प्रतिपादय।\nमनसाभिवृत्तः पूर्वं मया त्वं पार्थिवर्षम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2041862, "chapter_id": 1931, "verse_number": "५-१७६-५५", "content_sanskrit": "प्रत्याचख्यौ च साल्वोऽस्याश्चारित्रस्याभिशङ्कितः ।\nसेयं तपोवनं प्राप्ता तापस्येऽभिरता भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2041863, "chapter_id": 1931, "verse_number": "५-१७६-५६", "content_sanskrit": "मया च प्रत्यभिज्ञाता वंशस्य परिकीर्तनात्।\nअस्य दुःखस्य चोत्पत्तिं भीष्ममेवेह मन्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2041864, "chapter_id": 1931, "verse_number": "५-१७६-५७x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2041865, "chapter_id": 1931, "verse_number": "५-१७६-५७", "content_sanskrit": "भगवन्नेवमेवेह यथाह पृथिवीपतिः।\nशरीरकर्ता मातुर्मे सृञ्जयो होत्रवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2041866, "chapter_id": 1931, "verse_number": "५-१७६-५८", "content_sanskrit": "न ह्युत्सहे स्वनगरं प्रतियातुं तपोधन ।\nअपमानभयाच्चैव व्रीडया च महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2041867, "chapter_id": 1931, "verse_number": "५-१७६-५९", "content_sanskrit": "यत्तु मां भगवान्रामो वक्ष्यति द्विजसत्तम ।\nतन्मे कार्यतमं कार्यमिति मे भगवन्मतिः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2041868, "chapter_id": 1931, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि षट्सप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]