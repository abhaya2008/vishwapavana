[{"id": 7005871000, "chapter_id": 25871, "verse_number": "१-५४-१", "content_sanskrit": "हरिरुवाच ।\nअग्नीध्रश्चाग्निबाहुश्च वपुष्मान्ध्युतिमांस्था।\nमेधामेधातिथिर्भव्यः शबलः पुत्र एव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005871001, "chapter_id": 25871, "verse_number": "१-५४-२", "content_sanskrit": "ज्योतिष्मान्दशमो जातः पुत्रा ह्येते प्रिव्रतात्।\nमेधाग्निबाहुपुत्रास्तु त्रयो योगपरायणाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005871002, "chapter_id": 25871, "verse_number": "१-५४-३", "content_sanskrit": "जातिस्मरा महाभागा नैराज्याय मनो दधुः ।\nविभज्य सप्त द्वीपानि सप्तानां प्रददौ नृपः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005871003, "chapter_id": 25871, "verse_number": "१-५४-४", "content_sanskrit": "योजनानां प्रमाणेन पञ्चाशत्कोटिराप्लुता ।\nजलोपरि मही याता नौरिवास्ते सरिज्जले ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005871004, "chapter_id": 25871, "verse_number": "१-५४-५", "content_sanskrit": "जम्बूप्लक्षाह्वयौ द्वीपौ शाल्मलश्चापरो हर ।\nकुशः क्रौञ्चस्तथा शाकः पुष्करश्चैव सप्तमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005871005, "chapter_id": 25871, "verse_number": "१-५४-६", "content_sanskrit": "एते द्वीपाः समुद्रैस्तु सप्त सप्तभिरावताः।\nलवणेक्षुसुरासर्पिर्दाधिदुग्धजलैः समम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005871006, "chapter_id": 25871, "verse_number": "१-५४-७", "content_sanskrit": "द्वीपात्तु द्विगुणो द्वीपः समुद्रश्च वृषध्ज।\nजम्बूद्वीपे स्थितो मेरुर्लक्षयोजनविस्तृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005871007, "chapter_id": 25871, "verse_number": "१-५४-८", "content_sanskrit": "चतुरशीतिसाहस्त्रैर्योजनैरस्य चोच्छ्रयः ।\nप्रविष्टः षोडशाधस्ताद्द्वत्रिंशन्मूर्ध्नि विस्तृतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005871008, "chapter_id": 25871, "verse_number": "१-५४-९", "content_sanskrit": "अधः षोडशसाहस्त्रः कर्णिकाकारसंस्थितः ।\nहिमवान्हेमकूटश्च निषधश्चास्य दक्षिणे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005871009, "chapter_id": 25871, "verse_number": "१-५४-१०", "content_sanskrit": "नीलः श्वेतश्च श्रृंगी च उत्तरे वर्षपर्वता।\nप्लक्षादिषु नरा रुद्र ये वसन्ति सनातनाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005871010, "chapter_id": 25871, "verse_number": "१-५४-११", "content_sanskrit": "शङ्कराथ न तेष्वस्ति युगावस्था कथञ्चन ।\nजम्बूद्वीपेश्वरात्पुत्रा ह्यग्रीध्नादभवन्नव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005871011, "chapter_id": 25871, "verse_number": "१-५४-१२", "content_sanskrit": "नाभिः किंपुरुषश्चैव हरिवर्षमिला वृतः ।\nरम्यो हिरण्मयाख्यश्च कुरुर्भद्राश्व एव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005871012, "chapter_id": 25871, "verse_number": "१-५४-१३", "content_sanskrit": "केतुमालो नृपस्तेभ्यस्तत्संज्ञान् खण्डकान्दद।\nनाभेस्तु मेरुदेव्यां तु पुत्रोऽभूदृषभो हर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005871013, "chapter_id": 25871, "verse_number": "१-५४-१४", "content_sanskrit": "तत्पुत्रो भरतो नाम शालग्रामे स्थितो व्रत।\nसुमतिर्भरतस्याभूत्तत्पुत्रस्तैजसोऽभवत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005871014, "chapter_id": 25871, "verse_number": "१-५४-१५", "content_sanskrit": "इन्द्रद्युम्नश्च तत्पुत्रः परमेष्ठी ततः स्मत।\nप्रतीहारश्चतत्पुत्रः प्रतिहर्त्ता तदात्मजः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005871015, "chapter_id": 25871, "verse_number": "१-५४-१६", "content_sanskrit": "सुतस्तस्मादथै जातः प्रस्तारस्तत्सुतो विभुः ।\nपृथुश्च तत्सुतो नक्तो नक्तस्यापि गयः स्मृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005871016, "chapter_id": 25871, "verse_number": "१-५४-१७", "content_sanskrit": "नरो गयस्य तनयस्तत्पुत्रोभुद्विराडगतः ।\nततो धीमान्महातेजा भौवनस्तस्य चात्मजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005871017, "chapter_id": 25871, "verse_number": "१-५४-१८", "content_sanskrit": "त्वष्टा त्वष्टुश्च विरजा रजस्तस्याप्यभूत्सुत।\nशतजिद्रजसस्तस्य विष्वग्ज्योतिः सुतः स्मृतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]