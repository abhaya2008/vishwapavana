[{"id": 7003855000, "chapter_id": 23855, "verse_number": "२-५-६-१", "content_sanskrit": "ब्रह्मोवाच ।\nघण्टानादस्य माहात्म्यं चंदनस्य तथाऽच्युत ।\nयत्फलं लभते स्वामिंस्तत्सर्वं ब्रूहि तत्त्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003855001, "chapter_id": 23855, "verse_number": "२-५-६-२", "content_sanskrit": "श्रीभगवानुवाच ।\nस्नानार्चनक्रियाकाले घंटानादं करोति यः ।\nपुरतो मम देवेश तस्य पुण्यफलं शृणु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003855002, "chapter_id": 23855, "verse_number": "२-५-६-३", "content_sanskrit": "वर्षकोटिसहस्राणि वर्षकोटिशतानि च ।\nवसते मामके लोके अप्सरोगणसेवितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003855003, "chapter_id": 23855, "verse_number": "२-५-६-४", "content_sanskrit": "सर्ववाद्यमयी घण्टा सर्वदेवमयी यतः ।\nतस्मात्सर्वप्रयत्नेन घण्टानादं तु कारयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003855004, "chapter_id": 23855, "verse_number": "२-५-६-५", "content_sanskrit": "सर्ववाद्यमयी घण्टा सर्वदा मम वल्लभा ।\nवादनाल्लभते पुण्यं यज्ञकोटिशतोद्भवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003855005, "chapter_id": 23855, "verse_number": "२-५-६-६", "content_sanskrit": "घंटानादः सदा कार्यः पूजाकाले विशेषतः ।\nमन्वंतरसहस्राणि मन्वतरशतानि च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003855006, "chapter_id": 23855, "verse_number": "२-५-६-७", "content_sanskrit": "प्रीतो भवामि सततं घंटानादेन पुत्रक ।\nभेरीशंखनिनादेन घंटानादान्वितेन च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003855007, "chapter_id": 23855, "verse_number": "२-५-६-८", "content_sanskrit": "मृदंगशंखेन युतं प्रणवेन समन्वितम् ।\nअर्चनं मम देवेश सततं मोक्षदं नृणाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003855008, "chapter_id": 23855, "verse_number": "२-५-६-९", "content_sanskrit": "यत्र तिष्ठेत पुरतो घंटा नादान्विता मम ।\nअर्चिता वैष्णवैर्यत्र तत्र मां विद्धि पुत्रक ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003855009, "chapter_id": 23855, "verse_number": "२-५-६-१०", "content_sanskrit": "वैनतेयांऽकिता घंटा सुदर्शनयुताऽथवा ।\nममाग्रे स्थापयेद्यस्तु तस्य पापं हराम्यहम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003855010, "chapter_id": 23855, "verse_number": "२-५-६-११", "content_sanskrit": "मदीयार्चनवेलायां घंटानादं करोति यः ।\nनश्यंति तस्य पापानि शतजन्मार्जितान्यपि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003855011, "chapter_id": 23855, "verse_number": "२-५-६-१२", "content_sanskrit": "स्वापकाले प्रकुर्वीत घण्टानादं स्वभक्तितः ।\nममैवार्चनवेलायां फलं कोटिगुणोद्भवम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003855012, "chapter_id": 23855, "verse_number": "२-५-६-१३", "content_sanskrit": "ये मामर्चंति देवेश सुपर्णोपरिसंस्थितम् ।\nशंखपद्मगदायुक्तं सचक्रं च श्रिया युतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003855013, "chapter_id": 23855, "verse_number": "२-५-६-१४", "content_sanskrit": "किं करिष्यंति ते तीर्थैर्देवतानां च दर्शनैः ।\nकिं यज्ञैः किं व्रतैर्वापि किं दानैः किमुपोषणैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003855014, "chapter_id": 23855, "verse_number": "२-५-६-१५", "content_sanskrit": "मूर्तिर्नारायणी यैश्च मामकी गरुडोपरि ।\nस्थापिता ते कलौ यांति कल्पकोटिं पदं मम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003855015, "chapter_id": 23855, "verse_number": "२-५-६-१६", "content_sanskrit": "ममाऽग्रे स्थापयेद्यस्तु प्रासादेऽथ गृहेऽथवा ।\nतीर्थकोटिसहस्राणि तत्र तिष्ठंति देवताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003855016, "chapter_id": 23855, "verse_number": "२-५-६-१७", "content_sanskrit": "यस्तु पूजयते धन्यो गरुडोपरिसंस्थितम् ।\nएकादश्यां तथा रात्रौ वासनासंयुतो मम ।\nकृत्वा गीतं च नृत्यं च तारयेन्नरकात्पितॄन् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003855017, "chapter_id": 23855, "verse_number": "२-५-६-१८", "content_sanskrit": "पुनश्च कथयिष्यामि शृणु घंटामहं सुत ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003855018, "chapter_id": 23855, "verse_number": "२-५-६-१९", "content_sanskrit": "मम नामांकिता घण्टा पुरतो या च तिष्ठति ।\nअर्चिता वैष्णवी यत्र तत्र मां विद्धि पुत्रक ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003855019, "chapter_id": 23855, "verse_number": "२-५-६-२०", "content_sanskrit": "यस्तु वादयते घंटां वैनतेयविचिह्निताम् ।\nधूपे नीराजने स्नाने पूजाकाले विलेपने ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003855020, "chapter_id": 23855, "verse_number": "२-५-६-२१", "content_sanskrit": "ममाग्रे प्रत्यहं वत्स प्रत्येकं लभते फलम् ।\nमखायुतं गोऽयुतं च चांद्रायणशतोद्भवम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003855021, "chapter_id": 23855, "verse_number": "२-५-६-२२", "content_sanskrit": "विधिबाह्यकृता पृजा सफला जायते नृणाम् ।\nघण्टानादेन तुष्टोऽहं प्रयच्छामि स्वकं पदम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003855022, "chapter_id": 23855, "verse_number": "२-५-६-२३", "content_sanskrit": "नागाऽरिचिह्निता घंटा रथांगेन समन्विता ।\nवादनात्कुरुते नाशं जन्मकोटिभयस्य वै ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003855023, "chapter_id": 23855, "verse_number": "२-५-६-२४", "content_sanskrit": "गरुडेनांऽकितां घंटां दृष्ट्वाहं प्रत्यहं मुदा ।\nप्रीतिं करोमि देवेश लक्ष्मीं प्राप्य यथाऽधनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003855024, "chapter_id": 23855, "verse_number": "२-५-६-२५", "content_sanskrit": "घंटादण्डस्य शिरसि सुचक्रं स्थापयेत्तु यः ।\nमत्प्रियं वैनतेयं वा स्थापितं भुवनत्रयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003855025, "chapter_id": 23855, "verse_number": "२-५-६-२६", "content_sanskrit": "घंटानादं सचक्रं च अंतकाले शृणोति यः ।\nपापकोटियुतस्याऽपि नश्यंति यमकिंकराः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003855026, "chapter_id": 23855, "verse_number": "२-५-६-२७", "content_sanskrit": "सर्वदोषाः प्रणश्यंति घंटानादेन वै सुत ।\nदेवतानां सरुद्राणां पितॄणामुत्सवो भवेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003855027, "chapter_id": 23855, "verse_number": "२-५-६-२८", "content_sanskrit": "अभावे वैनतेयस्य चक्रस्याऽपि न संशयः ।\nघंटानादेन भक्तानां प्रसादं प्रकरोम्यहम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003855028, "chapter_id": 23855, "verse_number": "२-५-६-२९", "content_sanskrit": "गृहे यस्मिन्भवेन्नित्यं घण्टा नागारिसंयुता ।\nसर्पाणां न भयं तत्र नाग्निविद्युत्समुद्भवम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003855029, "chapter_id": 23855, "verse_number": "२-५-६-३०", "content_sanskrit": "यस्य घंटा गृहे नास्ति शंखो न पुरतो मम ।\nकथं भागवतो ज्ञेयः कथं भवति वल्लभः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003855030, "chapter_id": 23855, "verse_number": "२-५-६-३१", "content_sanskrit": "चंदनस्य प्रवक्ष्याम माहात्म्यं तव पुत्रक ।\nयस्मिन्कृते भवेत्प्रीतिर्ममात्यंतं न संशयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003855031, "chapter_id": 23855, "verse_number": "२-५-६-३२", "content_sanskrit": "सचंदनं सकुसुमं कर्पूरागरुमिश्रितम् ।\nमृगनाभिसमायुक्तं जातीफलसमन्वितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003855032, "chapter_id": 23855, "verse_number": "२-५-६-३३", "content_sanskrit": "तुलसीचंदनोपेतं ममात्यंतसुखावहम् ।\nयो ददाति हि मां नित्यं तुलसीकाष्ठसंभवम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003855033, "chapter_id": 23855, "verse_number": "२-५-६-३४", "content_sanskrit": "युगानि वसते स्वर्गे ह्यनंतानि नरोत्तमः ।\nमहाविष्णोः कलौ भक्त्या दत्त्वा तुलसिचंदनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003855034, "chapter_id": 23855, "verse_number": "२-५-६-३५", "content_sanskrit": "अर्चयेन्मालतीपुष्पैर्न भूयः स्तनपो भवेत् ।\nतुलसीकाष्ठसंभूतं चंदनं यच्छते मम ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003855035, "chapter_id": 23855, "verse_number": "२-५-६-३६", "content_sanskrit": "दहामि पातकं सर्वं पूर्वजन्मशतैः कृतम् ।\nसर्वेषामेव देवानां तुलसीकाष्ठचंदनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003855036, "chapter_id": 23855, "verse_number": "२-५-६-३७", "content_sanskrit": "पितॄणां च विशेषेण सदाऽभीष्टं यथा मम ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003855037, "chapter_id": 23855, "verse_number": "२-५-६-३८", "content_sanskrit": "श्रीखंडं चंदनं तावच्छ्रेष्ठं कृष्णागुरुं तथा ।\nयावन्न दीयते मह्यं तुलसीकाष्ठचंदनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003855038, "chapter_id": 23855, "verse_number": "२-५-६-३९", "content_sanskrit": "तावत्कस्तूरिकाऽमोदः कर्पूरस्य सुगंधिता ।\nयावन्न दीयते मह्यं तुलसीकाष्ठचंदनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003855039, "chapter_id": 23855, "verse_number": "२-५-६-४०", "content_sanskrit": "कलौ यच्छंति ये मह्यं तुलसीकाष्ठचंदनम् ।\nमार्गशीर्षशुभेमासे ते कृतार्था न संशयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003855040, "chapter_id": 23855, "verse_number": "२-५-६-४१", "content_sanskrit": "यो हि भागवतो भूत्वा कलौ तुलसिचंदनम् ।\nनार्पयेद्वै सहोमासे नाऽसौ भागवतो नरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003855041, "chapter_id": 23855, "verse_number": "२-५-६-४२", "content_sanskrit": "कुंकुमागुरुश्रीखण्डकर्दमैर्मम विग्रहम् ।\nआलिपेद्वै सहोमासे कल्पकोटिं वसेद्दिवि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003855042, "chapter_id": 23855, "verse_number": "२-५-६-४३", "content_sanskrit": "कर्पूरागुरुमिश्रेण चंदनेनाऽनुलिंपयेत् ।\nमृगदर्पं विशेषेण अभीष्टं च सदा मम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003855043, "chapter_id": 23855, "verse_number": "२-५-६-४४", "content_sanskrit": "विलेपयति यो मां वै शंखे कृत्वा तु चंदनम् ।\nमार्गशीर्षे तदा प्रीतिं करोमि शतवार्षिकीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003855044, "chapter_id": 23855, "verse_number": "२-५-६-४५", "content_sanskrit": "सेवते तुलसीपत्रैर्नित्यमामलकैश्च यः ।\nमार्गशीर्षे सदा भक्त्या स लभेद्वांछितं फलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003855045, "chapter_id": 23855, "verse_number": "२-५-६-४६", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे ब्रह्मविष्णुसंवादे मार्गशीर्षमाहात्म्ये भगवते तुलसीकाष्ठचंदनार्पणफलकथनंनाम षष्ठोऽध्यायः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]