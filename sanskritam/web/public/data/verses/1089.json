[{"id": 2004449, "chapter_id": 1089, "verse_number": "१-९०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004450, "chapter_id": 1089, "verse_number": "१-९०-१", "content_sanskrit": "संभवं भरतस्याहं चरितं च महामतेः।\nशकुन्तलायाश्चोत्पत्तिं श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004451, "chapter_id": 1089, "verse_number": "१-९०-२", "content_sanskrit": "दुष्यन्तेन च वीरेण यथा प्राप्ता शकुन्तला।\nतं वै पुरुषसिंहस्य भगवन्विस्तरं त्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004452, "chapter_id": 1089, "verse_number": "१-९०-३", "content_sanskrit": "श्रोतुमिच्छामि तत्त्वज्ञ सर्वं मतिमतां वर।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004453, "chapter_id": 1089, "verse_number": "१-९०-३x", "content_sanskrit": "वैशम्पायन उवाच।\nस कदाचिन्महाबाहुः प्रभूतबलवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004454, "chapter_id": 1089, "verse_number": "१-९०-४", "content_sanskrit": "वनं जगाम गहनं हयनागशतैर्वृतः।\nबलेन चतुरङ्गेण वृतः परमवल्गुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004455, "chapter_id": 1089, "verse_number": "१-९०-५", "content_sanskrit": "खड्गशक्तिधरैर्वीरैर्गदामुसलपाणिभिः।\nप्रासतोमरहस्तैश्च ययौ योधशतैर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004456, "chapter_id": 1089, "verse_number": "१-९०-६", "content_sanskrit": "सिंहनादैश्च योधानां शङ्खदुनदुभिनिःस्वनैः।\nरथनेमिस्वनैश्चैव सनागवरबृंहितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004457, "chapter_id": 1089, "verse_number": "१-९०-७", "content_sanskrit": "नानायुधधरैश्चापि नानावेषधरैस्तथा।\nह्रेषितस्वनमिश्रैश्च क्ष्वेडितास्फोटितस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004458, "chapter_id": 1089, "verse_number": "१-९०-८", "content_sanskrit": "आसीत्किलकिलाशब्दस्तस्मिन्गच्छति पार्थिवे।\nप्रासादवरशृङ्गस्थाः परया नृपशोभया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004459, "chapter_id": 1089, "verse_number": "१-९०-९", "content_sanskrit": "ददृशुस्तं स्त्रियस्तत्र शूरमात्मयशस्करम्।\nशक्रोपमममित्रघ्नं परवारणवारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004460, "chapter_id": 1089, "verse_number": "१-९०-१०", "content_sanskrit": "पश्यन्तः स्त्रीगणास्तत्र वज्रपाणिं स्म मेनिरे।\nअयं स पुरुषव्याघ्रो रणे वसुपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004461, "chapter_id": 1089, "verse_number": "१-९०-११", "content_sanskrit": "यस्य बाहुबलं प्राप्य न भवन्त्यसुहृद्गणाः।\nइति वाचो ब्रुवन्त्यस्ताः स्त्रियः प्रेम्णा नराधिपं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004462, "chapter_id": 1089, "verse_number": "१-९०-१२", "content_sanskrit": "तुष्टुवुः पुष्पवृष्टीश्च ससृजुस्तस्य मूर्धनि।\nतत्रतत्र च विप्रेन्द्रैः स्तूयमानः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004463, "chapter_id": 1089, "verse_number": "१-९०-१३", "content_sanskrit": "निर्ययौ परमप्रीत्या वनं मृगजिघांसया।\nतं देवराजप्रतिमं मत्तवारणधूर्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004464, "chapter_id": 1089, "verse_number": "१-९०-१४", "content_sanskrit": "द्विजक्षत्रियविट्शूद्रा निर्यान्तमनुजग्मिरे।\nददृशुर्वर्धमानास्ते आशीर्भिश्च जयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004465, "chapter_id": 1089, "verse_number": "१-९०-१५", "content_sanskrit": "सुदूरमनुजग्मुस्तं पौरजानपदास्तथा।\nन्यवर्तन्त ततः पश्चादनुज्ञाता नृपेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004466, "chapter_id": 1089, "verse_number": "१-९०-१६", "content_sanskrit": "सुपर्णप्रतिमेनाथ रथेन वसुधाधिपः।\nमहीमापूरयामास घोषेण त्रिदिवं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004467, "chapter_id": 1089, "verse_number": "१-९०-१७", "content_sanskrit": "स गच्छन्ददृशे धीमान्नन्दनप्रतिमं वनम्।\nबिल्वार्कखदिराकीर्णं कपित्थधवसंकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004468, "chapter_id": 1089, "verse_number": "१-९०-१८", "content_sanskrit": "विषमं पर्वतस्रस्तै रश्मभिश्च समावृतम्।\nनिर्जलं निर्मनुष्यं च बहुयोजनमायतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004469, "chapter_id": 1089, "verse_number": "१-९०-१९", "content_sanskrit": "मृगसिंहैर्वृतं घोरैरन्यैश्चापि वनेचरैः।\nतद्वनं मनुजव्याघ्रः सभृत्यबलवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004470, "chapter_id": 1089, "verse_number": "१-९०-२०", "content_sanskrit": "लोडयामास दुष्यन्तः सूदयन्विविधान्मृगान्।\nबाणगोचरसंप्राप्तांस्तत्र व्याघ्रगणान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004471, "chapter_id": 1089, "verse_number": "१-९०-२१", "content_sanskrit": "पातयामास दुष्यन्तो निर्बिभेद च सायकैः।\nदूरस्थान्सायकैः कांश्चिदभिनत्स नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004472, "chapter_id": 1089, "verse_number": "१-९०-२२", "content_sanskrit": "अभ्याशमागतांश्चान्यान्खड्गेन निरकृन्तत।\nकांश्चिदेणान्समाजघ्ने शक्त्या शक्तिमतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004473, "chapter_id": 1089, "verse_number": "१-९०-२३", "content_sanskrit": "गदामण्डलतत्त्वज्ञश्चचारामितविक्रमः।\nतोमरैरसिभिश्चापि गदामुसलकम्पनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004474, "chapter_id": 1089, "verse_number": "१-९०-२४", "content_sanskrit": "चचार स विनिघ्नन्वै वन्यांस्तत्र मृगद्विजान्।\nराज्ञा चाद्भुतवीर्येण योधैश्च समरप्रियैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004475, "chapter_id": 1089, "verse_number": "१-९०-२५", "content_sanskrit": "लोड्यमानं महारण्यं तत्यजुः स्म मृगाधिपाः।\nतत्र विद्रुतयूथानि हतयूथपतीनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004476, "chapter_id": 1089, "verse_number": "१-९०-२६", "content_sanskrit": "मृगयूथान्यथौत्सुक्याच्छब्दं चक्रुस्ततस्ततः।\nशुष्काश्चापि नदीर्गत्वा जलनैराश्यकर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004477, "chapter_id": 1089, "verse_number": "१-९०-२७", "content_sanskrit": "व्यायामक्लान्तहृदयाः पतन्ति स्म विचेतसः।\nक्षुत्पिपासापरीताश्च श्रान्ताश्च पतिता भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004478, "chapter_id": 1089, "verse_number": "१-९०-२८", "content_sanskrit": "केचित्तत्र नरव्याघ्रैरभक्ष्यन्त बुभुक्षितैः।\nकेचिदग्निमथोत्पाद्य संसाध्य च वनेचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004479, "chapter_id": 1089, "verse_number": "१-९०-२९", "content_sanskrit": "भक्षयन्ति स्म मांसानि प्रकुट्य विधिवत्तदा।\nतत्र केचिद्गजा मत्ता बलिनः शस्त्रविक्षताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004480, "chapter_id": 1089, "verse_number": "१-९०-३०", "content_sanskrit": "संकोच्याग्रकरान्भीताः प्राद्रवन्ति स्म वेगिताः।\nशकृन्मूत्रं सृजन्तश्च क्षरन्तः शोणितं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004481, "chapter_id": 1089, "verse_number": "१-९०-३१", "content_sanskrit": "वन्या गजवरास्तत्र ममृदुर्मनुजान्बहून्।\nतद्वनं बलमेघेन शरधारेण संवृतम्।\nव्यरोचत मृगाकीर्णं राज्ञा हतमृगाधिपम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004482, "chapter_id": 1089, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि नवतितमोऽध्यायः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]