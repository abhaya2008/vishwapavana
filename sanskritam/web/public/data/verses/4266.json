[{"id": 2150551, "chapter_id": 4266, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150552, "chapter_id": 4266, "verse_number": "१", "content_sanskrit": "ततः प्रभाते विमले धार्तराष्ट्रेण चोदिताः ।\nदुर्योधनेन राजानः प्रययुः पाण्डवान् प्रति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150553, "chapter_id": 4266, "verse_number": "२", "content_sanskrit": "आप्लाव्य शुचयः सर्वे स्रग्विणः शुक्लवाससः ।\nगृहीतशस्त्रा ध्वजिनः स्वस्ति वाच्य हुताग्नयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150554, "chapter_id": 4266, "verse_number": "३", "content_sanskrit": "सर्वे ब्रह्मविदः शूरा सर्वे सुचरितव्रताः ।\nसर्वे धर्मकृतश्चैव सर्वे चाहितलक्षणाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150555, "chapter_id": 4266, "verse_number": "४", "content_sanskrit": "आहवेषु पराँल्लोकान् जिगीषन्तो महाबलाः ।\nएकाग्रमनसः सर्वे श्रद्दधानाः परस्य च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150556, "chapter_id": 4266, "verse_number": "५", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ केकया बाह्लिकैः सह ।\nप्रययुः सर्व एवैते भारद्वाजपुरोगमाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150557, "chapter_id": 4266, "verse_number": "६", "content_sanskrit": "अश्वत्थामा शान्तनवः सैन्धवोऽथ जयद्रथः ।\nदाक्षिणात्याः प्रतीच्याश्च पार्वतीयाश्च ये नृपाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150558, "chapter_id": 4266, "verse_number": "७", "content_sanskrit": "गान्धारराजः शकुनिः प्राच्योदीच्याश्च सर्वशः ।\nशकाः किराता यवनाः शिबयोऽथ वसातयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150559, "chapter_id": 4266, "verse_number": "८", "content_sanskrit": "स्वैः स्वैरनीकैः सहिताः परिवार्य महारथाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150560, "chapter_id": 4266, "verse_number": "९", "content_sanskrit": "एते महारथाः सर्वे द्वितीये निर्ययुर्बले\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150561, "chapter_id": 4266, "verse_number": "१०", "content_sanskrit": "कृतवर्मा सहानीकः त्रिगर्तश्च महारथः ।\nदुर्योधनश्च नृपतिर्भ्रातृभिः परिवारितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150562, "chapter_id": 4266, "verse_number": "११", "content_sanskrit": "शलो भूरिश्रवाः शल्यः कौसल्योऽथ बृहद्बलः ।\nएते पश्चादवर्तन्त धार्तराष्ट्रपुरोगमाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150563, "chapter_id": 4266, "verse_number": "१२", "content_sanskrit": "ते समेत्य यथान्यायं धार्तराष्ट्रा महाबलाः ।\nकुरुक्षेत्रस्य पश्चार्धे व्यवातिष्ठन्त दंसिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150564, "chapter_id": 4266, "verse_number": "१३", "content_sanskrit": "दुर्योधनस्तु शिबिरं कारयामास भारत ।\nयथैव हस्तिनपुरं द्वितीयं समलङ्कृतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150565, "chapter_id": 4266, "verse_number": "१४", "content_sanskrit": "न विशेषं विजानन्ति पुरस्य शिबिरस्य वा ।\nकुशला अपि राजेन्द्र नरा नगरवासिनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150566, "chapter_id": 4266, "verse_number": "१५", "content_sanskrit": "तादृशान्येव दुर्गाणि राज्ञामपि महीपतिः ।\nकारयामास कौरव्यः शतशोऽथ सहस्रशः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150567, "chapter_id": 4266, "verse_number": "१६", "content_sanskrit": "पञ्चयोजनविस्तीर्णं मण्डलं तद्रणाजिरम् ।\nसेनानिवेशांस्ते राजन्नाविशन् शतसङ्घशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150568, "chapter_id": 4266, "verse_number": "१७", "content_sanskrit": "तत्र ते पृथिवीपाला यथोत्साहं यथाबलम् ।\nविविशुः शिबिराण्यत्र द्रव्यवन्ति सहस्रशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150569, "chapter_id": 4266, "verse_number": "१८", "content_sanskrit": "तेषां दुर्योधनो राजा ससैन्यानां महात्मनाम् ।\nव्यादिदेश सबाह्यानां भक्ष्यभोज्यमनुत्तमम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150570, "chapter_id": 4266, "verse_number": "१९", "content_sanskrit": "सनागाश्वमनुष्याणां ये च शिल्पोपजीविनः ।\nये चान्येऽनुगतास्तत्र सूतमागधवन्दिनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150571, "chapter_id": 4266, "verse_number": "२०", "content_sanskrit": "वणिजो गणिकाश्चारा ये चैव प्रेक्षका जनाः ।\nसर्वांस्तान् कौरवो राजा विधिवत् पर्यरक्षत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150572, "chapter_id": 4266, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तनवत्युत्तरशततमोऽध्यायः ॥१९७॥\nअम्बोपाख्यानपर्वणि सप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]