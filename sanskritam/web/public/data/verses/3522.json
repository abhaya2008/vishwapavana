[{"id": 2117110, "chapter_id": 3522, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117111, "chapter_id": 3522, "verse_number": "१", "content_sanskrit": "सौमदत्तेर्वचः श्रुत्वा कर्णो वैकर्त्तनो वृषा ।\nउवाच वचनं काले कालज्ञः सर्वकर्मणाम् \t॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117112, "chapter_id": 3522, "verse_number": "२", "content_sanskrit": "नीतिपूर्वमिदं सर्वमुक्तं वचनमर्थवत् ।\nवचनं नाभ्यसूयामि श्रूयतां मद्वचस्स्थितिः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117113, "chapter_id": 3522, "verse_number": "३", "content_sanskrit": "द्वैधीभावो न गन्तव्यः सर्वकर्मसु मानवैः ।\nद्विधाभूतेन मनसा ह्यन्यत् कर्म न सिध्यति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117114, "chapter_id": 3522, "verse_number": "४", "content_sanskrit": "सम्प्रयाणासनाभ्यां तु कर्शनेन तथैव च ।\nनैतच्छक्यं पुरं हन्तुमाक्रन्दश्चाप्यशोभनः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117115, "chapter_id": 3522, "verse_number": "५", "content_sanskrit": "अवमर्दनकालोऽत्र मतश्चिन्तयतो मम ।\nयावन्नो वृष्णयः पार्ष्णिं न गृह्णन्ति रणप्रियाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117116, "chapter_id": 3522, "verse_number": "६", "content_sanskrit": "भवन्तो हृष्टरूपास्तु स्वबाहुबलशालिनः ।\nप्राकारमवमृद्नन्तु परिघाश्च किरन्त्वपि \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117117, "chapter_id": 3522, "verse_number": "७", "content_sanskrit": "प्रस्रावयन्तु सलिलं क्रियतां विषमं समम् ।\nतृणकाष्ठेन महता खातमस्य प्रपूर्यताम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117118, "chapter_id": 3522, "verse_number": "८", "content_sanskrit": "घुष्यतां राजसैन्येषु परेषां यो हनिष्यति ।\nनागमश्वं पदातिं वा दानमानं स लप्स्यते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117119, "chapter_id": 3522, "verse_number": "९", "content_sanskrit": "नागे दशसहस्राणि पञ्च चाश्वपदातिषु ।\nरथे वै द्विगुणं नागाद् वसु दास्यन्ति पार्थिवाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117120, "chapter_id": 3522, "verse_number": "१०", "content_sanskrit": "यश्च कामगुणे सक्तो बालश्च स्थविरश्च यः ।\nअयुद्धमनसो ये तु ते च तिष्ठन्तु भीरवः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117121, "chapter_id": 3522, "verse_number": "११", "content_sanskrit": "प्रदरश्च न दातव्यो न गन्तव्यमचोदितैः ।\nयशो रक्षत भद्रं वो विजेष्यामो वयं पुरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117122, "chapter_id": 3522, "verse_number": "१२", "content_sanskrit": "अनुलोमाश्च नो वाताः सर्वतो मृगपक्षिणः ।\nअग्नयश्च विराजन्ते शस्त्राणि कवचानि च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117123, "chapter_id": 3522, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117124, "chapter_id": 3522, "verse_number": "१३", "content_sanskrit": "ततः कर्णवचः श्रुत्वा धार्तराष्ट्रप्रियैषिणः ।\nभवन्ति हृष्टपुष्टास्तु राजानो बलवत्तराः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117125, "chapter_id": 3522, "verse_number": "१४", "content_sanskrit": "निर्ययुः पृथिवीपालाश्चालयन्तः परान् रणे ।\nन हि तेषां मनःसक्तिरिन्द्रियार्थेषु सर्वशः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117126, "chapter_id": 3522, "verse_number": "१५", "content_sanskrit": "यथा परपुरघ्नानां प्रसभे युद्ध एव च ।\nवैकर्तनपुरोवातः सैन्धवोर्मिमहास्वनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117127, "chapter_id": 3522, "verse_number": "१६", "content_sanskrit": "दुःशासनसरिन्मध्ये दुर्योधनमहाग्रहः ।\nस राजसागरो भीमो भीमघोषप्रदर्शनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117128, "chapter_id": 3522, "verse_number": "१७", "content_sanskrit": "अभिदुद्राव वेगेन पुरं तदपसव्यतः ।\nतदनीकमनाधृष्यं शस्त्राग्निव्यपदीपितम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117129, "chapter_id": 3522, "verse_number": "१८", "content_sanskrit": "समुत्कुपितमाज्ञाय चुक्रुशुर्द्रुपदात्मजाः ।\nते मेघसमनिर्घोषैर्बलेन स्यन्दनोत्तमैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117130, "chapter_id": 3522, "verse_number": "१९", "content_sanskrit": "निर्ययुर्नगरद्वारात् त्रासयन्तः परान् रणे ।\nधृष्टद्युम्नः शिखण्डी च सुचित्रः प्रियदर्शनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117131, "chapter_id": 3522, "verse_number": "२०", "content_sanskrit": "चित्रकेतुः सुकेतुश्च ध्वजसेनश्च वीर्यवान् ।\nपुत्रा द्रुपदराजस्य बलवन्तो जयैषिणः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117132, "chapter_id": 3522, "verse_number": "२१", "content_sanskrit": "द्रुपदश्च महावीर्यः पाण्डरोष्णीषकेतनः ।\nपाण्डरव्यजनच्छत्रः पाण्डरध्वजवाहनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117133, "chapter_id": 3522, "verse_number": "२२", "content_sanskrit": "स पुत्रगणमध्यस्थः शुशुभे राजसत्तमः ।\nचन्द्रमा ज्योतिषां मध्ये पौर्णमास्यामिवोदितः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117134, "chapter_id": 3522, "verse_number": "२३", "content_sanskrit": "अथोद्धूतपताकाग्रमजिह्मगतिमव्ययम् ।\nद्रुपदानीकमायान्तं कुरुसैन्यमभिद्रवत् \t॥ २३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117135, "chapter_id": 3522, "verse_number": "२४", "content_sanskrit": "तयोरुभयतो जज्ञे भैरवस्तुमुलः स्वनः ।\nबलयोः सम्प्रहरतोः स्रवन्त्योः सरितोरिव \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117136, "chapter_id": 3522, "verse_number": "२५", "content_sanskrit": "प्रकीर्णरथनागाश्वैस्तान्यनीकानि सर्वशः ।\nज्योतींषीव प्रकीर्णानि सर्वतः प्रचकाशिरे \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117137, "chapter_id": 3522, "verse_number": "२६", "content_sanskrit": "उत्कृष्टभेरीनिनदे सम्प्रवृत्ते महाहवे ।\nप्रहर्षिता महात्मानः पाण्डवा निर्ययुस्ततः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117138, "chapter_id": 3522, "verse_number": "२७", "content_sanskrit": "रथांश्च मेघनिर्घोषान् युक्तान् परमवाजिभिः ।\nआस्थाय धन्विनः शुभ्रान् धन्विनो भरतर्षभाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117139, "chapter_id": 3522, "verse_number": "२८", "content_sanskrit": "ततः पाण्डुसुतान् दृष्ट्वा रथस्थानात्तकार्मुकान् ।\nनृपाणामभवत् कम्पो वेपथुर्हृदयेषु च \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117140, "chapter_id": 3522, "verse_number": "२९", "content_sanskrit": "निर्यातेष्वथ पार्थेषु द्रौपदं तद्बलं रणे ।\nआविशत् परमो हर्षः प्रमोदश्च बलं प्रति \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117141, "chapter_id": 3522, "verse_number": "३०", "content_sanskrit": "सुमुहूर्तं व्यतिकरः सैन्यानामभवद् भृशम्।\nततो द्वन्द्वमयुध्यन्त मृत्युं कृत्वा निवर्तनम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117142, "chapter_id": 3522, "verse_number": "३१", "content_sanskrit": "जघ्नतुः समरे तस्मिन् सुचित्रप्रियदर्शनौ ।\nजयद्रथश्च कर्णश्च पश्यतः सव्यसाचिनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117143, "chapter_id": 3522, "verse_number": "३२", "content_sanskrit": "अर्जुनः प्रेक्ष्य निहतौ सुचित्रप्रियदर्शनौ ।\nजयद्रथसुतं तत्र जघान पितुरन्तिके \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117144, "chapter_id": 3522, "verse_number": "३३", "content_sanskrit": "वृषसेनादवरजं सुभानुं वै धनञ्जयः ।\nकर्णपुत्रं महावीर्यं रथनीडादपाहरत् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117145, "chapter_id": 3522, "verse_number": "३४", "content_sanskrit": "तौ सुतौ निहतौ दृष्ट्वा राजसिंहौ तरस्विनौ ।\nनामृष्येतां महावीर्यौ प्रहारमिव सद्गजौ \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117146, "chapter_id": 3522, "verse_number": "३५", "content_sanskrit": "तौ जग्मतुरसम्भ्रान्तौ फल्गुनस्य रथं प्रति ।\nतौ तु बद्धतळत्राणौ त्रायमाणौ परस्परम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117147, "chapter_id": 3522, "verse_number": "३६", "content_sanskrit": "सन्निपातस्तयोरासीत् फल्गुनेन महामृधे ।\nवृत्रशम्बरयोः सङ्खे वज्रिणेव महारणे \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117148, "chapter_id": 3522, "verse_number": "३७", "content_sanskrit": "तानश्वाञ्जघ्नतुस्तत्र फल्गुनस्य नरर्षभौ ।\nततः किलिकिलाशब्दः कुरूणामभवत् तदा \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117149, "chapter_id": 3522, "verse_number": "३८", "content_sanskrit": "तान् हयान् निहतान् दृष्ट्वा भीमसेनः प्रतापवान् ।\nनिमेषान्तरमात्रेण रथमश्वैरयोजयत् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117150, "chapter_id": 3522, "verse_number": "३९", "content_sanskrit": "उपयातं रथं दृष्ट्वा दुर्योधनपुरःसरौ ।\nसौबलः सौमदत्तिश्च समेयातां परन्तपौ \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117151, "chapter_id": 3522, "verse_number": "४०", "content_sanskrit": "तैः पञ्चभिरदीनात्मा भीमसेनो महाबलः ।\nअयुध्यत बलैर्वीरैरिन्द्रियार्थैरिवेश्वरः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2117152, "chapter_id": 3522, "verse_number": "४१", "content_sanskrit": "तैर्निरुद्धो न सन्त्रासं जगाम समितिञ्जयः ।\nपञ्चभिर्द्विरदैर्मत्तैर्निरुद्ध इव केसरी \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2117153, "chapter_id": 3522, "verse_number": "४२", "content_sanskrit": "तस्य ते युगपत् पञ्च पञ्चभिर्निशितैः शरैः ।\nसारथिं वाजिनश्चैव निन्युर्वैवस्वतक्षयम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2117154, "chapter_id": 3522, "verse_number": "४३", "content_sanskrit": "हताश्वात् स्यन्दनश्रेष्ठादवरुह्य महारथः ।\nचचार विविधान् मार्गानसिमुद्यम्य पाण्डवः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2117155, "chapter_id": 3522, "verse_number": "४४", "content_sanskrit": "अश्वस्कन्धेषु चक्रेषु युगेष्वीषासु चैव ह ।\nव्यचरत् पातयन् शत्रून् सुपर्ण इव भोगिनः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2117156, "chapter_id": 3522, "verse_number": "४५", "content_sanskrit": "विधनुष्कं विकवचं विरथं च समीक्ष्य तम् ।\nअभिपेतुर्नरव्याघ्रमर्जुनप्रवरा रथाः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2117157, "chapter_id": 3522, "verse_number": "४६", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च यमौ च युधि दुर्जयौ ।\nतस्मिन् दशरथे युद्धे प्रवृद्धे शरवृष्टिभिः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2117158, "chapter_id": 3522, "verse_number": "४७", "content_sanskrit": "रथा ध्वजाः पताकाश्च सर्वमन्तरधीयत ।\nतत् प्रवृत्तं चिरं कालं युद्धं सममिवाभवत् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2117159, "chapter_id": 3522, "verse_number": "४८", "content_sanskrit": "रथेन तान् महाबाहुरर्जुनोऽभ्यपतत् पुनः\nतमापतन्तं दृष्ट्वैव महाबाहुर्धनुर्धरः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2117160, "chapter_id": 3522, "verse_number": "४९", "content_sanskrit": "कर्णोऽस्त्रविदुषां श्रेष्ठो वारयामास सायकैः ।\nस तेनाभिहतः पार्थो वासविर्वज्रसन्निभान् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2117161, "chapter_id": 3522, "verse_number": "५०", "content_sanskrit": "त्रीन् शरान् सन्दधे क्रुद्धो वधात् कर्णस्य पाण्डवः ।\nतैः शरैराहतः कर्णः ध्वजयष्टिमुपाश्रितः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2117162, "chapter_id": 3522, "verse_number": "५१", "content_sanskrit": "अपोवाह रथेनाशु सूतः परपुरञ्जयम् ।\nततः पराजिते कर्णे धार्तराष्ट्रं महद्भयम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2117163, "chapter_id": 3522, "verse_number": "५२", "content_sanskrit": "विवेश समुदग्रांश्च पाण्डवान् प्रसमीक्ष्य च ।\nतत्प्रकम्पितमत्यर्थं दृष्ट्वा वै सौबलो बलम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2117164, "chapter_id": 3522, "verse_number": "५३", "content_sanskrit": "गिरा गम्भीरया वीरः समाश्वसयतासकृत् ।\nधार्तराष्ट्रैस्ततः सर्वैर्दुर्योधनपुरस्सरैः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2117165, "chapter_id": 3522, "verse_number": "५४", "content_sanskrit": "छत्रमाल्याम्बरधरं पताकाशतशोभितम् ।\nधृतं तत्पुनरेवासीद् बलं पार्थप्रकम्पितम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2117166, "chapter_id": 3522, "verse_number": "५५", "content_sanskrit": "ततो दुर्योधनं दृष्ट्वा भीमो भीमपराक्रमः ।\nअक्रुध्यत् स महाबाहुरगारं जातुषं स्मरन् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2117167, "chapter_id": 3522, "verse_number": "५६", "content_sanskrit": "ततः सङ्ग्रामशिरसि ददर्श विपुलद्रुमम् ।\nआयामभूतं तिष्ठन्तं स्कन्धपञ्चाशदुन्नतम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2117168, "chapter_id": 3522, "verse_number": "५७", "content_sanskrit": "महास्कन्धं महोत्सेधं शक्रध्वजमिवोच्छ्रितम् ।\nसालमुत्पाट्य पाणिभ्यामुद्यम्य च रणे बली \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2117169, "chapter_id": 3522, "verse_number": "५८", "content_sanskrit": "अभिपेदे परान् सङ्खे वज्रपाणिरिवासुरान् ।\nभीमसेनभयार्तानि फल्गुनाभिहतानि च \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2117170, "chapter_id": 3522, "verse_number": "५९", "content_sanskrit": "न शेकुस्तान्यनीकानि धार्तराष्ट्रं निरीक्षितुम् ।\nतानि सम्भ्रान्तयोधानि श्रान्तवाजिगजानि च\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2117171, "chapter_id": 3522, "verse_number": "६०", "content_sanskrit": "दिशः प्राकालयद् भीमो दिवीवाभ्राणि मारुतः ।\nतान् निवृत्तान् निरानन्दान् हतवारणवाजिनः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2117172, "chapter_id": 3522, "verse_number": "६१", "content_sanskrit": "नानुसस्रुर्न चाजघ्नुर्नोचुः किञ्चिच्च दारुणम् ।\nस्वमेव शिबिरं जग्मुः क्षत्रियाः शरविक्षताः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2117173, "chapter_id": 3522, "verse_number": "६२", "content_sanskrit": "परेऽप्यभिययुर्हृष्टाः पुरं पौरसुखावहाः ।\nमुहूर्तमभवद् वैरं तेषां वै पाण्डवैः सह \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2117174, "chapter_id": 3522, "verse_number": "६३", "content_sanskrit": "यावत् तद्युद्धमभवन्महद् देवासुरोपमम् ।\nतावदेवाभवच्छान्तं निवृत्ता वै महारथाः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2117175, "chapter_id": 3522, "verse_number": "६४", "content_sanskrit": "सुवृत्तं चक्रिरे सर्वे सुप्राप्तामब्रुवन् वधूम् ।\nकृतार्थं द्रुपदं चोचुर्धृष्टद्युम्नं च पार्षतम् \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2117176, "chapter_id": 3522, "verse_number": "६५", "content_sanskrit": "शकुनिः सिन्धुराजश्च कर्णदुर्योधनावपि ।\nतेषां तदभवद् दुःखं हृदि वाचा तु नाब्रुवन् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2117177, "chapter_id": 3522, "verse_number": "६६", "content_sanskrit": "ततः प्रयाता राजानः सर्व एव यथागतम् ।\nधार्तराष्ट्रा हि ते सर्वे गता नागपुरं तदा \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2117178, "chapter_id": 3522, "verse_number": "६७", "content_sanskrit": "प्रागेव पुररोधात् तु पाण्डवैरश्वसादिनः ।\nप्रेषिता गच्छतारिष्टानस्मानाख्यात शौरये \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2117179, "chapter_id": 3522, "verse_number": "६८", "content_sanskrit": "ते त्वदीर्घेण कालेन गत्वा द्वारवतीं पुरीम् ।\nऊचुः सङ्कर्षणोपेन्द्रौ वचनं वचनक्षमौ \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2117180, "chapter_id": 3522, "verse_number": "६९", "content_sanskrit": "कुशलं पाण्डवाः सर्वानाहुः स्मान्धकवृष्णयः ।\nआत्मनोऽत्राक्षतानाहुर्विमुक्तान् जातुषाद् गृहात्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2117181, "chapter_id": 3522, "verse_number": "७०", "content_sanskrit": "समाजे द्रौपदीं स्माहुर्लब्धां राजीवलोचनाम् ।\nआत्मनः सदृशीं सर्वे शीलवृत्तसमाधिभिः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2117182, "chapter_id": 3522, "verse_number": "७१", "content_sanskrit": "तच्छ्रुत्वा वचनं कृष्णस्तानुवाचोत्तरं वचः ।\nसर्वमेतदहं जाने वधात् तस्य तु रक्षसः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2117183, "chapter_id": 3522, "verse_number": "७२", "content_sanskrit": "तत उद्योजयामास केशवश्चतुरङ्गिणीम् ।\nसेनामुपादिशत् तूर्णं पाञ्चालनगरीं प्रति \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2117184, "chapter_id": 3522, "verse_number": "७३", "content_sanskrit": "ततः सङ्कर्षणश्चैव केशवश्च महाबलः ।\nयादवैः सह सर्वैश्च पाञ्चालानभिजग्मतुः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2117185, "chapter_id": 3522, "verse_number": "७४", "content_sanskrit": "पितृष्वसारं सम्पूज्य द्रुपदं च महाधनैः ।\nद्रौपदीं भूषणैः शुभ्रैर्भूषयित्वा महाधनैः \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2117186, "chapter_id": 3522, "verse_number": "७५", "content_sanskrit": "न्यायतः पूजिता राज्ञा द्रुपदेन महात्मना ।\nरेमिरे पाण्डवैः सार्धं पाञ्चालनगरे तदा \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2117187, "chapter_id": 3522, "verse_number": "२०१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकाधिकद्विशततमोऽध्यायः ॥२०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2117188, "chapter_id": 3522, "verse_number": "२", "content_sanskrit": "॥ इति विदुरागमनपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2117189, "chapter_id": 3522, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]