[{"id": 2073213, "chapter_id": 2546, "verse_number": "१२-५१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073214, "chapter_id": 2546, "verse_number": "१२-५१-१", "content_sanskrit": "ततः कृष्णस्य तद्वाक्यं धर्मार्थसहितं हितम्।\nश्रुत्वा शान्तनवः कृष्णं प्रत्युवाच कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073215, "chapter_id": 2546, "verse_number": "१२-५१-२", "content_sanskrit": "लोकनाथ महाबाहो शिव नारायणाच्युत।\nतव वाक्यमुपश्रुत्य हर्षेणास्मि परिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073216, "chapter_id": 2546, "verse_number": "१२-५१-३", "content_sanskrit": "किंचाहमभिधास्यामि वाक्पते तव सन्निधौ।\nयदा वाचोगतं सर्वं तव वाचि समाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073217, "chapter_id": 2546, "verse_number": "१२-५१-४", "content_sanskrit": "यच्च किंचित्कृतं लोके कर्तव्यं क्रियते च यत्।\nत्वत्तस्तन्निः सृतं देव लोके बुद्धिमतो हिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073218, "chapter_id": 2546, "verse_number": "१२-५१-५", "content_sanskrit": "कथयेद्देवलोकं यो देवराजसमीपतः।\nधर्मकामार्थमोक्षाणां सोऽर्थं ब्रूयात्तवाग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073219, "chapter_id": 2546, "verse_number": "१२-५१-६", "content_sanskrit": "शराभितापाद्व्यथितं मनो मे मधुसूदन।\nगात्राणि चावसीदन्ति न च बुद्धिः प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073220, "chapter_id": 2546, "verse_number": "१२-५१-७", "content_sanskrit": "न च मे प्रतिभा काचिदस्ति किंचित्प्रभाषितुम्।\nपीड्यमानस्य गोविन्द विपानलसमैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073221, "chapter_id": 2546, "verse_number": "१२-५१-८", "content_sanskrit": "बलं मे प्रजहातीव प्राणाः सत्वरयन्ति च।\nमर्माणि परितप्यन्ति भ्रान्तचित्तस्तथा ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073222, "chapter_id": 2546, "verse_number": "१२-५१-९", "content_sanskrit": "दौर्बल्यात्सज्जते वाङ्भे स कथं वक्तुमुत्सहे।\nसाधु मे त्वं प्रसीदस्व दाशार्हकुलवर्धन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073223, "chapter_id": 2546, "verse_number": "१२-५१-१०", "content_sanskrit": "तत्क्षमस्व महाबाहो न ब्रूयां किंचिदच्युत॥\nत्वत्सन्निधौ च सीदेद्धि वाचस्पतिरपि ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073224, "chapter_id": 2546, "verse_number": "१२-५१-११", "content_sanskrit": "न दिशः संप्रजानामि नाकाशं न च मेदिनीम्।\nकेवलं तव वीर्येण तिष्ठामि मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073225, "chapter_id": 2546, "verse_number": "१२-५१-१२", "content_sanskrit": "स्वयमेव भवांस्तस्माद्धर्मराजस्य यद्धितम्।\nतद्ब्रवीत्वाशु सर्वेषामागमानां त्वमागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073226, "chapter_id": 2546, "verse_number": "१२-५१-१३", "content_sanskrit": "कथं त्वयि स्थिते कृष्णे शाश्वते लोककर्तरि।\nप्रब्रूयान्मद्विधः कश्चिद्गुरौ शिष्य इव स्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073227, "chapter_id": 2546, "verse_number": "१२-५१-१४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073228, "chapter_id": 2546, "verse_number": "१२-५१-१४", "content_sanskrit": "उपपन्नमिदं वाक्यं कौरवाणां धुरन्धरे।\nमहावीर्ये महासत्वे स्थिरे सर्वार्थदर्शिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073229, "chapter_id": 2546, "verse_number": "१२-५१-१५", "content_sanskrit": "यच्च मामात्थ गाङ्गेय बाणघातरुजं प्रति।\nगृहाणात्र वरं भीष्म मत्प्रसादकृतं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073230, "chapter_id": 2546, "verse_number": "१२-५१-१६", "content_sanskrit": "न ते ग्लानिर्न ते मूर्च्छा न तापो न च ते रुजा।\nप्रभविष्यन्ति गाङ्गेय क्षुत्पिपासे न चाप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073231, "chapter_id": 2546, "verse_number": "१२-५१-१७", "content_sanskrit": "ज्ञानानि च समग्राणि प्रतिभास्यन्ति तेऽनघ।\nन च ते क्वचिदासत्तिर्बुद्धेः प्रादुर्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073232, "chapter_id": 2546, "verse_number": "१२-५१-१८", "content_sanskrit": "सत्वस्थं च मनो नित्यं तव भीष्म भविष्यति।\nरजस्तमोभ्यां निर्मुक्तं घनैर्मुक्त इवोडुराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073233, "chapter_id": 2546, "verse_number": "१२-५१-१९", "content_sanskrit": "यद्यच्च धर्मसंयुक्तमर्थयुक्तमथापि च।\nचिन्तयिष्यसि तत्राग्र्या बुद्धिस्तव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073234, "chapter_id": 2546, "verse_number": "१२-५१-२०", "content_sanskrit": "इमं च राजशार्दूल भूतग्रामं चतुर्विधम्।\nचक्षुर्दिव्यं समाश्रित्य द्रक्ष्यस्यमितविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073235, "chapter_id": 2546, "verse_number": "१२-५१-२१", "content_sanskrit": "चतुर्विधं प्रजाजालं संयुक्तो ज्ञानचक्षुषा।\nभीष्म द्रक्ष्यसि तत्त्वेन जले मीन इवामले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073236, "chapter_id": 2546, "verse_number": "१२-५१-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073237, "chapter_id": 2546, "verse_number": "१२-५१-२२", "content_sanskrit": "ततस्ते व्याससहिताः सर्व एव महर्षयः।\nऋग्यजुःसामसहितैर्वचोभिः कृष्णमार्चयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073238, "chapter_id": 2546, "verse_number": "१२-५१-२३", "content_sanskrit": "ततः सर्वार्तवं दिव्यं पुष्पवर्षं न भस्तलात्।\nपपात यत्र वार्ष्णेयः सगाङ्गेयः सपाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073239, "chapter_id": 2546, "verse_number": "१२-५१-२४", "content_sanskrit": "वादित्राणि च सर्वाणि जगुश्चाप्सरसां गणाः।\nन चाहितमनिष्टं च किंचित्तत्र व्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073240, "chapter_id": 2546, "verse_number": "१२-५१-२५", "content_sanskrit": "ववौ शिवः सुखो वायुः सर्वगन्धवहः शुचिः।\nशान्तायां दिशिशन्ताश्च प्रावदन्मृगपक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073241, "chapter_id": 2546, "verse_number": "१२-५१-२६", "content_sanskrit": "ततो मुहूर्ताद्भगवान्सहस्रांशुर्दिवाकरः।\nदहन्वनमिवैकान्ते प्रतीच्यां प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073242, "chapter_id": 2546, "verse_number": "१२-५१-२७", "content_sanskrit": "ततो महर्षयः सर्वे समुत्थाय जनार्दनम्।\nभीष्ममामन्त्रयांचक्रू राजानं च युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073243, "chapter_id": 2546, "verse_number": "१२-५१-२८", "content_sanskrit": "ततः प्रणाममकरोत्केशवः सहपाण्डवः।\nसात्यकिः स़ञ्जयश्चैव स च शारद्वतः कृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073244, "chapter_id": 2546, "verse_number": "१२-५१-२९", "content_sanskrit": "ततस्ते धर्मनिरताः सम्यक् तैरभिपूजिताः।\nश्वः समेष्याम इत्युक्त्वा यथेष्टं त्वरिता ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073245, "chapter_id": 2546, "verse_number": "१२-५१-३०", "content_sanskrit": "तथैवामन्त्र्य गाङ्गेयं केशवः पाण्डवास्तथा।\nप्रदक्षिणमुपावृत्य रथानारुरुहुः शुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073246, "chapter_id": 2546, "verse_number": "१२-५१-३१", "content_sanskrit": "ततो रथैः काञ्चनचित्रकूबरै\nर्महीधराभैः समदैश्च दन्तिभिः।\nहयैः सुपर्णैरिव चाशुगामिभिः\nपदातिभिश्चात्तशरासनादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073247, "chapter_id": 2546, "verse_number": "१२-५१-३२", "content_sanskrit": "ययौ रथानां पुरतो हि सा चमू\nस्तथैव पश्चादतिमात्रसारिणी।\nपुरश्च पश्चाच्च यथा महानदी\nतमृक्षवन्तं गिरिमेत्य नर्मदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073248, "chapter_id": 2546, "verse_number": "१२-५१-३३", "content_sanskrit": "ततः पुरस्ताद्भगवान्निशाकरः।\nसमुत्थितस्तामभिहर्षयंश्चमूम्।\nदिवाकरापीतरसा महौषधीः\nपुनः स्वकेनैव गुणेन योजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073249, "chapter_id": 2546, "verse_number": "१२-५१-३४", "content_sanskrit": "ततः पुरं सुरपुरसंमितद्युति\nप्रविश्य ते यदुवृषपाण्डवास्तदा।\nयथोचितान्भवनवरान्समाविशन्\nश्रमान्विता मृगपतयो गुहा इव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073250, "chapter_id": 2546, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकपञ्चाशोऽध्यायः॥ ५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]