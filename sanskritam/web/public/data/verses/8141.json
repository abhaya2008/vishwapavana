[{"id": 35000685, "chapter_id": 8141, "verse_number": "4.686", "content_sanskrit": "निकरनिकायनिवहविसरव्रजपुञ्जसमूहसञ्चयाः समुदयसार्थयूथनिकुरम्बकदम्बकपूगराशयः । चयसमवायवृन्दसन्दोहसमाजवितानसंहतिप्रकरणौघसंघसंघातव्रातकुलौत्कराः स्मृताः । पटलं पेटकं चक्रं चक्रवालं च मण्डलम् । जालं जातं तथा व्यूहवारस्तोमाश्च ते स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 35000686, "chapter_id": 8141, "verse_number": "4.687", "content_sanskrit": "पटलं पेटकं चक्रं चक्रवालं च मण्डलम् । जालं जातं तथा व्यूहवारस्तोमाश्च ते स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 35000687, "chapter_id": 8141, "verse_number": "4.688", "content_sanskrit": "सूक्ष्मलेशलबश्लक्ष्णक्षुद्रदभ्रकणाणवः । किञ्चिन्मात्रतनुस्तोकह्रस्वाल्पत्रुटयः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 35000688, "chapter_id": 8141, "verse_number": "4.689", "content_sanskrit": "प्राग्र्यं प्राग्रहरं प्रवेकमपरं वर्यं वरेण्यं वरं श्रेष्ठं प्रेष्ठमनुत्तमं च मधुरं मञ्जु प्रियं मञ्जुलम् । हृद्यं हारि मनोहरं च रुचिरं कान्तं परं सुन्दरं सौम्यं साधु च वल्गु चारु सुषमं वामं शुभं पेशलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 35000689, "chapter_id": 8141, "verse_number": "4.690", "content_sanskrit": "अग्र्यं प्रधानं प्रमुखं पुरोगं मुख्यं परार्ध्यं प्रवरं प्रवर्हम् । अग्रेसरं सत्तममुत्तमं च ग्रामण्यमग्रण्यमुदाहरन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 35000690, "chapter_id": 8141, "verse_number": "4.691", "content_sanskrit": "शङ्का वितर्कः सन्देहः संशयारेकविभ्रमाः । विचिकित्सा विकल्पश्च भ्रान्तिरेकार्थवाचकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 35000691, "chapter_id": 8141, "verse_number": "4.692", "content_sanskrit": "समीपं सनिडं समर्यादमारात् सदेशं सवेशं ससीमोपकण्ठम् । तथाभ्यर्णमभ्यग्रमभ्याशमाहुर्बुधाः सन्निधानान्तिके सन्निकृष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 35000692, "chapter_id": 8141, "verse_number": "4.693", "content_sanskrit": "आसन्नं सविधं पार्श्वमुपान्तमपदान्तरम् । विप्रकृष्टं परं दूरमाराद् व्यवहितं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 35000693, "chapter_id": 8141, "verse_number": "4.694", "content_sanskrit": "सदृक् समानः सदृशः सदृक्षः प्रख्यः प्रकाशः प्रतिमः प्रकारः । तुल्यः समः सन्निभ इत्यभिन्नाः शब्दाः प्रयोगेषु गवेषणीयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 35000694, "chapter_id": 8141, "verse_number": "4.695", "content_sanskrit": "लोलं चपलं चटुलं प्रचलं तरलं परिप्लवमधीरम् । पारिप्लवं च धीराश्चलाचलं चञ्चलं च कथयन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 35000695, "chapter_id": 8141, "verse_number": "4.696", "content_sanskrit": "वक्रं वृजिनं भङ्गुरमाविद्धं वेल्लितं नतं जिह्मम् । भुग्नमरालं कुटिलं व्याकुञ्चितमूर्मिमत्कथितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 35000696, "chapter_id": 8141, "verse_number": "4.697", "content_sanskrit": "द्राक् चपलं लघु मङ्क्षु द्राक् तूर्णं त्वरितमाशु शीघ्रमरम् । अह्नाय सत्वरं च क्षिप्रं द्रुतमञ्जसा झटिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 35000697, "chapter_id": 8141, "verse_number": "4.698", "content_sanskrit": "सततं सन्ततमनिशं नित्यमजस्रं च शश्वदश्रान्तम् । अविरतमनवरतं स्यादेकार्थमनारतमसक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 35000698, "chapter_id": 8141, "verse_number": "4.699", "content_sanskrit": "वृहदुरु गुरु विस्तीर्णं पुरु पृथु पृथुलं महद्विशालं च । व्यूढं विपुलं रुद्रं वरिष्ठमेकार्थमुद्दिष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 35000699, "chapter_id": 8141, "verse_number": "4.700", "content_sanskrit": "युग्मं युगं च युगलं द्वन्द्वं द्वितयं यमं यमलम् । स्त्रीपुंसयोस्तु युग्मं मिथुनं परिकथ्यते सद्भिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 35000700, "chapter_id": 8141, "verse_number": "4.701", "content_sanskrit": "प्राज्यं भूरि प्रभूतं च प्रचुरं बहुलं बहु । पुरुजं पुष्कलं पुष्टमदभ्रमभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 35000701, "chapter_id": 8141, "verse_number": "4.702", "content_sanskrit": "आचितं निचितं व्याप्तं छन्नं कीर्णं च सङ्कुलम् । आकुलं भरितं पूर्णं नातिनानार्थवाचकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 35000702, "chapter_id": 8141, "verse_number": "4.703", "content_sanskrit": "प्रत्याख्यातं प्रतिक्षिप्तं प्रत्यादिष्टं निराकृतम् । निरस्तमपविद्धं च प्राज्ञाः परिहृतं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 35000703, "chapter_id": 8141, "verse_number": "4.704", "content_sanskrit": "अत्याकारः परिभवो निकारश्च पराभवः । अनादरश्चाभिभवस्तिरस्कारश्च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 35000704, "chapter_id": 8141, "verse_number": "4.705", "content_sanskrit": "घोरं प्रतिभयं भीमं दारुणं स्याद्भयानकम् । आभीलं भीषणं भीष्मं भैरवं च भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 35000705, "chapter_id": 8141, "verse_number": "4.706", "content_sanskrit": "सख्यं साप्तपदीनं सौहार्दं सौहृदं तथा स्नेहः । मैत्री प्रीतिरजय्यं सभाजनं सङ्गतं प्रोक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 35000706, "chapter_id": 8141, "verse_number": "4.707", "content_sanskrit": "आदिरग्रं पुरा पूर्वं प्रथमं प्राक् पुरः स्मृतम् । उपज्ञोपक्रमारम्भौ पश्चाच्च चरमं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 35000707, "chapter_id": 8141, "verse_number": "4.708", "content_sanskrit": "रहः प्रच्छन्नमेकान्तं निःशलाकमपह्नरम् । उपांशु विजनं प्रोक्तं रहस्यं गुह्यमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 35000708, "chapter_id": 8141, "verse_number": "4.709", "content_sanskrit": "कैतवं कपटं कूटं व्याजच्छद्मोपधिच्छलम् । मिषं निभं च निर्दिष्टं व्यपदेशश्च सूरिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 35000709, "chapter_id": 8141, "verse_number": "4.710", "content_sanskrit": "इच्छा वाञ्छा स्पृहा काङ्क्षा कामनेप्सा रुचिस्तथा । आशंसा चेति तुल्यार्था निश्चितं नियतं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 35000710, "chapter_id": 8141, "verse_number": "4.711", "content_sanskrit": "जीर्णं जरत्पुराणं प्रत्नं प्रतनं पुरातनं प्रोक्तम् । नव्यं नवं नवीनं स्यान्नूतनमभिनवं नूत्नम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 35000711, "chapter_id": 8141, "verse_number": "4.712", "content_sanskrit": "निवृतं वेष्टितमुक्तं परिवृत्तं वलयितं परिक्षिप्तम् । आवर्हितमुन्मूलितमुत्पाटितमुद्धृतं च समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 35000712, "chapter_id": 8141, "verse_number": "4.713", "content_sanskrit": "कृत्स्नं समग्रं सकलं समस्तं सर्वं च विश्वं निखिलाखिले च । खण्डार्धनेमाः शकलं च भित्तं सामीत्यसम्पूर्णसमानसञ्ज्ञाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 35000713, "chapter_id": 8141, "verse_number": "4.714", "content_sanskrit": "अवकीर्णमवध्वस्तं त्यक्तमुत्सृष्टमुज्झितम् । अनादृतमवज्ञातमपहस्तितमिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 35000714, "chapter_id": 8141, "verse_number": "4.715", "content_sanskrit": "आगूः सङ्गरसन्धाप्रतिश्रवाः संश्रवः प्रतिज्ञा च । हेला स्यादवहेलं रीढावज्ञावलीढा च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 35000715, "chapter_id": 8141, "verse_number": "4.716", "content_sanskrit": "मूलीकर्म प्रोक्तं संवननं कामणं वशीकरणम् । विप्रतिसारोऽनुशयः पश्चात्तापोऽनुतापः स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 35000716, "chapter_id": 8141, "verse_number": "4.717", "content_sanskrit": "क्षामं शातं कृशं क्षीणं पेलवं तलिनं तनु । निरन्तरं घनं सान्द्रं बहुलं विरलेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 35000717, "chapter_id": 8141, "verse_number": "4.718", "content_sanskrit": "निविडं निविरीशं च दृढं गाढं प्रचक्षते । कामं प्रकामं पर्याप्तं नितान्तं भृशमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 35000718, "chapter_id": 8141, "verse_number": "4.719", "content_sanskrit": "अत्यर्थमतिमर्यादमतिवेलं च कथ्यते । व्यवधानं तिरोधानमन्तर्धिरपवारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 35000719, "chapter_id": 8141, "verse_number": "4.720", "content_sanskrit": "परस्परं मिथः प्रोक्तमन्योन्यमितरेतरम् । कौतूहलं विनोदः स्यात्कौतुकं च कुतूहलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 35000720, "chapter_id": 8141, "verse_number": "4.721", "content_sanskrit": "आली श्रेण्यावली पङ्क्तिर्वीथी राजी च कथ्यते । क्षौरं च भद्राकरणं मुण्डनं वपनं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 35000721, "chapter_id": 8141, "verse_number": "4.722", "content_sanskrit": "दर्पो मदोऽवलेपो मानो गर्वा भवेदहङ्कारः । आवेशः संवेगः संरम्भः सम्भ्रमस्तथाटोपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 35000722, "chapter_id": 8141, "verse_number": "4.723", "content_sanskrit": "प्राणः स्थाम बलं द्युम्नमोजः शुष्म तरः सहः । प्रतापः पौरुषं तेजो विक्रमः स्यात्पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 35000723, "chapter_id": 8141, "verse_number": "4.724", "content_sanskrit": "अनुक्रोशः कृपा शूकं दया च करुणा घृणा । प्रतिक्षणमभीक्ष्णं च भूयः स्यादसकृन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 35000724, "chapter_id": 8141, "verse_number": "4.725", "content_sanskrit": "आतङ्को भयमाशङ्का दरस्त्रासश्च साध्वसम् । मर्षः क्षमा तितिक्षा च क्षान्तिरुक्ता सहिष्णुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 35000725, "chapter_id": 8141, "verse_number": "4.726", "content_sanskrit": "वैणवो लगुडो रम्भो दण्डो यष्टिश्च कथ्यते । गतिर्वीखा विहारः स्यात्परिसर्पः परिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 35000726, "chapter_id": 8141, "verse_number": "4.727", "content_sanskrit": "अणिरश्रिस्तथा कोटिरश्रः कोणश्च कथ्यते । कश्मलं मलिनं म्लानं मलीमसमुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 35000727, "chapter_id": 8141, "verse_number": "4.728", "content_sanskrit": "भृतिर्भृत्या च कर्मण्या वेता मूल्यं च वेतनम् । लिपिरालेख्यलेखा स्याल्लिपिर्लेखाक्षरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 35000728, "chapter_id": 8141, "verse_number": "4.729", "content_sanskrit": "कल्पनं कर्तनं प्रोक्तं वर्धनं छेदनं तथा । व्यत्ययः स्याद्विपर्यासो वैपरीत्यं विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 35000729, "chapter_id": 8141, "verse_number": "4.730", "content_sanskrit": "अपह्नवोपलापः स्यादपज्ञानमपात्ययः । श्रन्थनं ग्रन्थनं गुम्फः सन्दर्भो रचना स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 35000730, "chapter_id": 8141, "verse_number": "4.731", "content_sanskrit": "उद्वर्तनमुत्सादनमाहुः सोत्प्रासहसितमुपहसितम् । उत्पिञ्जलमाकुलकं स्यादनुपदमनवगन्वक्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 35000731, "chapter_id": 8141, "verse_number": "4.732", "content_sanskrit": "गौरः श्वेतः सितः शुभ्रो वलक्षो धवलोऽर्जुनः । हरिणः पाण्डुरः पाण्डुरवदातश्च पाण्डरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 35000732, "chapter_id": 8141, "verse_number": "4.733", "content_sanskrit": "अरुणः शोणो रक्तो माञ्जिष्ठः पाटलस्तथा ताम्रः । लोहित इत्येकार्थाः कविभिः शब्दाः प्रयुज्यन्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 35000733, "chapter_id": 8141, "verse_number": "4.734", "content_sanskrit": "असितं शिति कृष्णं च कालं नीलं च मेचकम् । श्यामं तु श्यामल रामं पालाशं हरितं हरित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}, {"id": 35000734, "chapter_id": 8141, "verse_number": "4.735", "content_sanskrit": "हरिः कद्रुः कडारश्च पिङ्गलः परिकीर्तितः । पीतं हारिद्रमाख्यातं श्यावं तु कपिशं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50, "avatarnika": ""}, {"id": 35000735, "chapter_id": 8141, "verse_number": "4.736", "content_sanskrit": "पिङ्गः पिशङ्ग इत्युक्तो बभ्रुः कपिलः पिङ्गलः । सारङ्गः शबलो वर्णः कल्माषः कृष्णपाण्डुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51, "avatarnika": ""}, {"id": 35000736, "chapter_id": 8141, "verse_number": "4.737", "content_sanskrit": "पिञ्जरः पीतरक्तः स्याद्धूसरः स्तोकपाण्डुरः । रक्तश्यामो भवेद्धूम्रो धूमलः स च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52, "avatarnika": ""}, {"id": 35000737, "chapter_id": 8141, "verse_number": "4.738", "content_sanskrit": "श्येनी कुमुदपत्राभा शुकाभा हरिणी स्मृता । जपाकुसुमसंकाशा लोहिनी परिकीर्तिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53, "avatarnika": ""}, {"id": 35000738, "chapter_id": 8141, "verse_number": "4.739", "content_sanskrit": "परिपाट्यानुपूर्वी स्यादुपशायोऽनुपात्ययः । अनुक्रमश्च पर्यायो विशायः परिकीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54, "avatarnika": ""}, {"id": 35000739, "chapter_id": 8141, "verse_number": "4.740", "content_sanskrit": "ईर्ष्या स्यात्कुहना दम्भो मिथ्याचर्या च कुक्कुटिः । कुसृतिर्निकृतिर्माया शाम्बरी पथकल्पना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55, "avatarnika": ""}, {"id": 35000740, "chapter_id": 8141, "verse_number": "4.741", "content_sanskrit": "चित्रकिर्मीरकल्माषशबलान्मिश्रकर्बुराः करम्बः कवरः शारः सम्पृक्तः खचितः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56, "avatarnika": ""}, {"id": 35000741, "chapter_id": 8141, "verse_number": "4.742", "content_sanskrit": "आयल्लकमुत्कण्ठा स्यादुत्कलिका रतिश्च रणरणकम् । औत्सुक्यं हृल्लेखो विरहवियोगौ च तुल्यार्थौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57, "avatarnika": ""}, {"id": 35000742, "chapter_id": 8141, "verse_number": "4.743", "content_sanskrit": "प्रतिकूलं प्रतिलोमं प्रतीपमुक्तं प्रसव्यमेकार्थम् । अपवारितं च पिहितं संवीतं संवृतं स्थगितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58, "avatarnika": ""}, {"id": 35000743, "chapter_id": 8141, "verse_number": "4.744", "content_sanskrit": "आहुः प्रतीकमवयवमपघनमङ्गं तथैकदेशं च । उल्बणमुद्धतमुद्भटमुत्कटमिति नातिनानार्थाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59, "avatarnika": ""}, {"id": 35000744, "chapter_id": 8141, "verse_number": "4.745", "content_sanskrit": "समाजः संसदास्थानी सभा स्यात्परिषत्सदः । चित्रमद्भुतमाश्चर्यं विस्मयश्चोद्यमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60, "avatarnika": ""}, {"id": 35000745, "chapter_id": 8141, "verse_number": "4.746", "content_sanskrit": "प्रेङ्खोलितं तरलितं प्रेङ्खितं लुलितं स्मृतम् । युक्तं स्यादुचितं न्याय्यं प्राप्तमौपयिकं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61, "avatarnika": ""}, {"id": 35000746, "chapter_id": 8141, "verse_number": "4.747", "content_sanskrit": "आहितं निहितं न्यस्तमारोपितमिति स्मृतम् । बद्धं पिनद्धमामुक्तमपिनद्धं च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62, "avatarnika": ""}, {"id": 35000747, "chapter_id": 8141, "verse_number": "4.748", "content_sanskrit": "वञ्चनं चातिसन्धानं व्यलीकं स्यात्प्रतारणम् । विप्रलम्भो विसंवादो विप्रलापश्च कीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63, "avatarnika": ""}, {"id": 35000748, "chapter_id": 8141, "verse_number": "4.749", "content_sanskrit": "व्यलीकमपराधः स्यादागो मन्तुश्च विप्रियम् । प्रणतिः स्यादनुनयः प्रणिपातश्च सान्त्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64, "avatarnika": ""}, {"id": 35000749, "chapter_id": 8141, "verse_number": "4.750", "content_sanskrit": "उद्घात उक्तः प्रस्तावो वारश्चावसरः क्षणः । वदन्त्युपनतं प्राज्ञा उपसन्नमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65, "avatarnika": ""}, {"id": 35000750, "chapter_id": 8141, "verse_number": "4.751", "content_sanskrit": "प्रांशूच्चमुन्नतं तुङ्गमुदग्रं दीर्घमायतम् । अयन्त्रितं स्यादुद्दाममुच्छृङ्खलमनर्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66, "avatarnika": ""}, {"id": 35000751, "chapter_id": 8141, "verse_number": "4.752", "content_sanskrit": "विशदं प्रकटं स्पष्टं प्रकाशं स्फुटमिष्यते । तत्क्षणैकपदे तुल्ये सद्यः सपदि च स्मृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67, "avatarnika": ""}, {"id": 35000752, "chapter_id": 8141, "verse_number": "4.753", "content_sanskrit": "विशङ्कटं विशालं स्यात्करालं विकटं तथा । निस्तलं वर्तुलं वृत्तं स्थपुटं विषमोन्नतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68, "avatarnika": ""}, {"id": 35000753, "chapter_id": 8141, "verse_number": "4.754", "content_sanskrit": "अवगाहो जलद्रोणी निर्वेदः खेद उच्यते । प्रमादोऽनवधानं स्यादत्याधानमतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69, "avatarnika": ""}, {"id": 35000754, "chapter_id": 8141, "verse_number": "4.755", "content_sanskrit": "निर्वेश उपभोगः स्यादाभोगः परिपूर्णता । अवगीतं मुहुर्दृष्टमुपलब्धं च यद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70, "avatarnika": ""}, {"id": 35000755, "chapter_id": 8141, "verse_number": "4.756", "content_sanskrit": "वामं सव्यं विदुः प्राज्ञा अपसव्यं च दक्षिणम् । प्रतिकूलानुकूलार्थे अपष्ठु त्वनपष्ठु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71, "avatarnika": ""}, {"id": 35000756, "chapter_id": 8141, "verse_number": "4.757", "content_sanskrit": "विपरीतं पराचीनमपाचीनं पराङ्मुखम् । स्मृतं कौसीद्यमालस्यमुपधा तु परीक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72, "avatarnika": ""}, {"id": 35000757, "chapter_id": 8141, "verse_number": "4.758", "content_sanskrit": "विवधो वीवधो भारः पर्याहारश्च कथ्यते । काचं शिक्यमिति प्रोक्तं भारयष्टिर्विहङ्गिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73, "avatarnika": ""}, {"id": 35000758, "chapter_id": 8141, "verse_number": "4.759", "content_sanskrit": "सौष्ठवं स्यादवष्टम्भो हठः प्रसभमुच्यते । प्रग्रहो ग्रहको वन्दी पणोऽक्षेषु ग्लहः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74, "avatarnika": ""}, {"id": 35000759, "chapter_id": 8141, "verse_number": "4.760", "content_sanskrit": "प्रायः स्याद्भोजनत्यागः संन्यासोऽनशनं स्मृतम् । मोघं मुधाऽफलं बन्ध्यं नतं नम्रं च बन्धुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75, "avatarnika": ""}, {"id": 35000760, "chapter_id": 8141, "verse_number": "4.761", "content_sanskrit": "स्मृतं वणिज्यं वाणिज्यं वणिज्या च समं त्रयम् । युद्धार्थे द्वे प्रयुज्येते दोर्मर्दं च करीरकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76, "avatarnika": ""}, {"id": 35000761, "chapter_id": 8141, "verse_number": "4.762", "content_sanskrit": "आकूतं स्यादभिप्रायो व्याकूतिर्भङ्गिरुच्यते । स्थण्डिलं संस्कृता भूमिरयनं स्थानमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77, "avatarnika": ""}, {"id": 35000762, "chapter_id": 8141, "verse_number": "4.763", "content_sanskrit": "प्रत्यग्रमुक्तं सद्यस्कमुपाग्रमुपसर्जनम् । दोला प्रेङ्खोलनं प्रेङ्खा उत्सवः स्यान्महः क्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78, "avatarnika": ""}, {"id": 35000763, "chapter_id": 8141, "verse_number": "4.764", "content_sanskrit": "गवलं माहिषं शृङ्गं दृतिश्चर्मप्रसेवकः । समुद्गः सम्पुटो ज्ञेयो वडिशं मत्स्यबन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79, "avatarnika": ""}, {"id": 35000764, "chapter_id": 8141, "verse_number": "4.765", "content_sanskrit": "कृते प्रतिकृतं प्राज्ञैः प्रतिनिर्यातनं स्मृतम् । सपत्नाकरणं प्रोक्तं यत्परस्यातिपीडनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80, "avatarnika": ""}, {"id": 35000765, "chapter_id": 8141, "verse_number": "4.766", "content_sanskrit": "समासः स्यात्समाहारः संक्षेपः सङ्ग्रहस्तथा । व्यासः प्रपञ्चो विस्तारः स च शब्दस्य विस्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81, "avatarnika": ""}, {"id": 35000766, "chapter_id": 8141, "verse_number": "4.767", "content_sanskrit": "उन्नं क्लिन्नं स्मृतं नुन्नं क्षिप्तं तुन्नं च पीडितम् । पन्नं तु पतितं प्रोक्तं सन्नं शान्तं च सूरिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82, "avatarnika": ""}, {"id": 35000767, "chapter_id": 8141, "verse_number": "4.768", "content_sanskrit": "न्यञ्चितं स्यादधःक्षिप्तं क्षिप्तमूर्ध्वमुदञ्चितम् । काचितं सञ्जितं प्रोक्तं रुषितं गुण्डितं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83, "avatarnika": ""}, {"id": 35000768, "chapter_id": 8141, "verse_number": "4.769", "content_sanskrit": "विष्कम्भः प्रतिबन्धो विश्रम्भः कथ्यते च विश्वासः । सम्मर्दः स्यात्परिमल उपमर्दो विप्रकारः स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84, "avatarnika": ""}, {"id": 35000769, "chapter_id": 8141, "verse_number": "4.770", "content_sanskrit": "उपाधिर्धर्मचिन्ता स्यान्निःशोध्यमनवस्करः । कुप्रियं च जघन्यं स्यान्निःशेषं न्यक्षमिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85, "avatarnika": ""}, {"id": 35000770, "chapter_id": 8141, "verse_number": "4.771", "content_sanskrit": "अपकारो भवेद् द्रोहो दोष आदीनवो मतः । कषायं तुवरं प्रोक्तं सुरुङ्गा सन्थिरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86, "avatarnika": ""}, {"id": 35000771, "chapter_id": 8141, "verse_number": "4.772", "content_sanskrit": "असौम्यं यद्भवेच्चक्षुरचक्षुस्तत्प्रचक्षते । अवहित्थं च शब्दज्ञा आकारस्य निगूहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87, "avatarnika": ""}, {"id": 35000772, "chapter_id": 8141, "verse_number": "4.773", "content_sanskrit": "संस्तवः स्यात्परिचयः प्रसादः प्रणयः स्मृतः । प्रवारणं महादानं सङ्कल्पः कर्म मानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88, "avatarnika": ""}, {"id": 35000773, "chapter_id": 8141, "verse_number": "4.774", "content_sanskrit": "अनायासार्थकं फाण्टमन्तर्गडु निरर्थकम् । स्वाच्छन्द्यं निर्निमित्तं च यदृच्छेत्यभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89, "avatarnika": ""}, {"id": 35000774, "chapter_id": 8141, "verse_number": "4.775", "content_sanskrit": "आद्यमादिममन्त्यं स्यादन्तिमं चाग्र्यमग्रिमम् । मध्यमं मध्यमीयं च मध्यन्दिनमुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90, "avatarnika": ""}, {"id": 35000775, "chapter_id": 8141, "verse_number": "4.776", "content_sanskrit": "नमस्या वन्दना प्रोक्ता तपस्या नियमस्थितिः । परिव्रज्या व्रतादानं व्रज्याऽट्या च गतिः स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91, "avatarnika": ""}, {"id": 35000776, "chapter_id": 8141, "verse_number": "4.777", "content_sanskrit": "रिक्तं तुच्छमसारं तु फल्गु व्युष्टिः फलं स्मृतम् । कलिलं गहनं प्रोक्तं श्लथं शिथिलमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92, "avatarnika": ""}, {"id": 35000777, "chapter_id": 8141, "verse_number": "4.778", "content_sanskrit": "स्वतन्त्रवृत्तिर्व्युत्थानमभ्युत्थानं च गौरवम् । संस्थानं संनिवेशः स्यादास्थानं नृपतेः सभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93, "avatarnika": ""}, {"id": 35000778, "chapter_id": 8141, "verse_number": "4.779", "content_sanskrit": "सङ्कथान्योन्यसञ्जीतिः प्रतिपत्तिः प्रगल्भता । उच्यत ऊर्ज उत्साहो भृकुटिर्भ्रुकुटिस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94, "avatarnika": ""}, {"id": 35000779, "chapter_id": 8141, "verse_number": "4.780", "content_sanskrit": "उपजापो भवेद्भेदः साम सान्त्वमिति स्मृतम् । तथेति प्रत्ययः श्रद्धा संस्कारो वासना स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95, "avatarnika": ""}, {"id": 35000780, "chapter_id": 8141, "verse_number": "4.781", "content_sanskrit": "स्मृतमास्थितमाक्रान्तं प्रतीष्टं पतदाहृतम् । प्रच्छादितं स्यात्संवीतं प्रशस्तं संस्कृतं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96, "avatarnika": ""}, {"id": 35000781, "chapter_id": 8141, "verse_number": "4.782", "content_sanskrit": "उन्माथः कूटयन्त्रं स्यादवपातोऽवटः स्मृतः । धर्मः स्वभावः आत्मा स्यादवेक्षा प्रतिजागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97, "avatarnika": ""}, {"id": 35000782, "chapter_id": 8141, "verse_number": "4.783", "content_sanskrit": "स्मृतं परुषमस्निग्धमाचारातिक्रमः क्रिया । उच्चण्डमप्रलम्बं स्यान्नाडिः पत्रशिरा स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98, "avatarnika": ""}, {"id": 35000783, "chapter_id": 8141, "verse_number": "4.784", "content_sanskrit": "अहमहमिका तु सा स्याद्यत्क्रियते स्पर्धयाधिकं किञ्चित् । यत्र वृथाभिनिवेशस्तामाहोपुरुषिकां विदुः प्राज्ञाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99, "avatarnika": ""}, {"id": 35000784, "chapter_id": 8141, "verse_number": "4.785", "content_sanskrit": "सिंहनादो भवेत् क्ष्वेडा गण्डूषो मुखपूरणम् । प्रभावतां वदन्त्यार्याः प्रभुतां प्रभविष्णुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100, "avatarnika": ""}, {"id": 35000785, "chapter_id": 8141, "verse_number": "4.786", "content_sanskrit": "परभागो गुणोत्कर्षः स्पर्धा संघर्ष उच्यते । आयामः स्मृत आनाहः परिणाहो विशालता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101, "avatarnika": ""}]