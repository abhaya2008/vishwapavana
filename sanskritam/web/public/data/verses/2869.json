[{"id": 2087832, "chapter_id": 2869, "verse_number": "१२-३७४-०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087833, "chapter_id": 2869, "verse_number": "१२-३७४-१", "content_sanskrit": "आश्चर्यं नात्र संदेहः सुप्रीतोस्मि भुजङ्गम।\nअन्वर्थोपगतैर्वाक्यैः पन्थानं चास्मि दर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087834, "chapter_id": 2869, "verse_number": "१२-३७४-२", "content_sanskrit": "स्वस्ति तेऽस्तु गमिष्यामि साधो भुजगसत्तम।\nस्मरणीयोस्मि भवता संप्रेषणनियोजनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087835, "chapter_id": 2869, "verse_number": "१२-३७४-३x", "content_sanskrit": "नाग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087836, "chapter_id": 2869, "verse_number": "१२-३७४-३", "content_sanskrit": "अनुक्त्वा हृद्गतं कार्यं क्वेदानीं प्रस्थितो भवान्।\nउच्यतां द्विज यत्कार्यं यदर्थं त्वमिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087837, "chapter_id": 2869, "verse_number": "१२-३७४-४", "content_sanskrit": "उक्तानुक्ते कृते कार्ये मामामन्त्र्य द्विजर्षभ।\nमया प्रत्यभ्यनुज्ञातस्ततो यास्यसि सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087838, "chapter_id": 2869, "verse_number": "१२-३७४-५", "content_sanskrit": "न हि मां केवलं दृष्ट्वा त्यक्त्वा प्रणयवानिह।\nगन्तुमर्हसि विप्रर्षे वृक्षमूलगतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087839, "chapter_id": 2869, "verse_number": "१२-३७४-६", "content_sanskrit": "त्वयि चाहं द्विजश्रेष्ठ भवान्मयि न संशयः।\nलोकोऽयं भवतः सर्वः का चिन्ता मयि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087840, "chapter_id": 2869, "verse_number": "१२-३७४-७x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087841, "chapter_id": 2869, "verse_number": "१२-३७४-७", "content_sanskrit": "एवमेतन्महाप्राज्ञ विदितात्मन्भुजङ्गम।\nनातिरिक्तास्त्वया देवाः सर्वथैव यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087842, "chapter_id": 2869, "verse_number": "१२-३७४-८", "content_sanskrit": "स एव त्वं स एवाहं योऽहं स तु भवानपि।\nअहं भवांश्च भूतानि सर्वे यत्र गताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087843, "chapter_id": 2869, "verse_number": "१२-३७४-९", "content_sanskrit": "आसीत्तु मे भोगिपते संशयः पुण्यरसंचये।\nसोहमुञ्छव्रतं साधो चरिष्याम्यर्थसाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087844, "chapter_id": 2869, "verse_number": "१२-३७४-१०", "content_sanskrit": "एष मे निश्चयः साधो कृतं कारणमुत्तमम्।\nआमन्त्रयामि भद्रं ते कृतार्थोऽस्मि भुजङ्गम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087845, "chapter_id": 2869, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुःसप्तत्यधिकत्रिशततमोऽध्यायः॥ ३७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]