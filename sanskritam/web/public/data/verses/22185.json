[{"id": 7002185000, "chapter_id": 22185, "verse_number": "२३०-१", "content_sanskrit": "पुष्कर उवाच ।\nऔषधानि च युक्तानि धान्यं कृष्णमशोभनं ।\nकार्पासं तृणशुष्कञ्च गोमयं वै धनानि च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002185001, "chapter_id": 22185, "verse_number": "२३०-२", "content_sanskrit": "अङ्गारं गुडसर्जौ च मुण्डाभ्यक्तञ्च नग्नकं ।\nअयः पङ्कं चर्म्मकेशौ उन्मत्तञ्च नपुंसकं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002185002, "chapter_id": 22185, "verse_number": "२३०-३", "content_sanskrit": "चण्डालश्वपचाद्यानि नरा बन्धनपालकाः ।\nगर्भिणी स्त्री च विधवाः पिण्याकादीनि वै मृतं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002185003, "chapter_id": 22185, "verse_number": "२३०-४", "content_sanskrit": "तुषभस्मकपालास्थिभिन्नभाण्डमशस्तकं ।\nअशस्तो वाद्यशब्दश्च भिन्न भैरवझर्क्भरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002185004, "chapter_id": 22185, "verse_number": "२३०-५", "content_sanskrit": "एहीति पुरतः शब्दः शस्यते न तु पृष्ठतः ।\nगच्छेति पश्चाच्छब्दोऽग्र्यः पुरस्तात्तु विगर्हितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002185005, "chapter_id": 22185, "verse_number": "२३०-६", "content_sanskrit": "क्व यासि तिष्ठ मा गच्छ किन्ते तत्र गतस्य च ।\nअनिष्टशब्दा मृत्यर्थं क्रव्यादश्च ध्वजादिगः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002185006, "chapter_id": 22185, "verse_number": "२३०-७", "content_sanskrit": "स्खलनं वाहनानाञ्च शस्त्रभङ्गस्तथैव च ।\nशिरोघातश्च चद्वाराद्यैश्छत्र वासादिपातनं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002185007, "chapter_id": 22185, "verse_number": "२३०-८", "content_sanskrit": "हरिमभ्यर्च्य संस्तुत्य स्यादमङ्गल्यनाशनं ।\nद्वितीयन्तु ततो दृष्ट्वा विरुद्धं प्रविशेद् गृहं ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002185008, "chapter_id": 22185, "verse_number": "२३०-९", "content_sanskrit": "श्वेताः सुमनसः श्रेष्ठाः पूर्णकुम्भो महोत्तमः ।\nमांसं मत्स्या दूरशब्दा वृद्ध एकः पशुस्त्वजः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002185009, "chapter_id": 22185, "verse_number": "२३०-१०", "content_sanskrit": "गावस्तुरङ्गमा नागा देवाश्च ज्वलितोऽनलः ।\nदूर्वार्द्रगोमयं वेश्या स्वर्णरूप्यञ्च रत्नकं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002185010, "chapter_id": 22185, "verse_number": "२३०-११", "content_sanskrit": "वचासिद्धार्थकौषध्यो मुद्र आयुधखड्गकं ।\nछत्रं पीठं राजलिङ्गं शवं रुदितवर्जितं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002185011, "chapter_id": 22185, "verse_number": "२३०-१२", "content_sanskrit": "फलं घृतं दधि पयो अक्षतादर्शमाक्षिकं ।\nशङ्ख इक्षुः शुभं वाक्पं भक्तवादित्रगीतकं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002185012, "chapter_id": 22185, "verse_number": "२३०-१३", "content_sanskrit": "गम्भीरमेघस्तनितं तडित्तुष्टिश्च मानसी ।\nएकतं सर्वलिङ्गानि मनसस्तुष्टिरेकतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]