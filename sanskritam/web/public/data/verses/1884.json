[{"id": 2039935, "chapter_id": 1884, "verse_number": "५-१२९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039936, "chapter_id": 1884, "verse_number": "५-१२९-१", "content_sanskrit": "कृष्णस्य तु वचः श्रुत्वा धृतराष्ट्रो जनेश्वरः।\nविदुरं सर्वधर्मज्ञं त्वरमाणोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039937, "chapter_id": 1884, "verse_number": "५-१२९-२", "content_sanskrit": "गच्छ तात महाप्राज्ञ गान्धारीं दीर्घदर्शिनीम् ।\nआनयेह तया सार्धमनुनेष्यामि दुर्मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039938, "chapter_id": 1884, "verse_number": "५-१२९-३", "content_sanskrit": "यदि सा न दुरात्मानं शमयेद्दुष्टचेतसम्।\nअपि कृष्णस्य सुहृदस्तिष्ठेम वचने वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039939, "chapter_id": 1884, "verse_number": "५-१२९-४", "content_sanskrit": "दुर्बुद्धेर्दुःसहायस्य शमार्थं ब्रुवती वचः ॥\nअपि नो व्यसनं घोरं दुर्योधनकृतं महत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039940, "chapter_id": 1884, "verse_number": "५-१२९-५", "content_sanskrit": "शमयेच्चिररात्राय योगक्षेमवदव्ययम् ।\nराज्ञस्तु वचनं श्रुत्वा विदुरो दीर्घदर्शिनीम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039941, "chapter_id": 1884, "verse_number": "५-१२९-६", "content_sanskrit": "आनयामास गान्धारीं धृतराष्ट्रस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039942, "chapter_id": 1884, "verse_number": "५-१२९-७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039943, "chapter_id": 1884, "verse_number": "५-१२९-७", "content_sanskrit": "एष गान्धारि पुत्रस्ते दुरात्मा शासनातिगः ।\nऐश्वर्यलोभादैश्वर्यं जीवितं च प्रहास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039944, "chapter_id": 1884, "verse_number": "५-१२९-८", "content_sanskrit": "अशिष्टवदमर्यादः पापैः सह दुरात्मवान्।\nसभाया निर्गतो मूढो व्यतिक्रम्य सुहृद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039945, "chapter_id": 1884, "verse_number": "५-१२९-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039946, "chapter_id": 1884, "verse_number": "५-१२९-९", "content_sanskrit": "सा भर्तृवचनं श्रुत्वा राजपुत्री यशस्विनी ।\nअन्विच्छन्ती महच्छ्रेयो गान्धारी वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039947, "chapter_id": 1884, "verse_number": "५-१२९-१०", "content_sanskrit": "आनायय सुतं क्षिप्रं राज्यकामुकमातुरम् ।\nनहि राज्यमशिष्टेन शक्यं धर्मार्थलोपिना ।\nआप्तुमाप्तं तथाऽपीदमविनीतेन सर्वथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039948, "chapter_id": 1884, "verse_number": "५-१२९-११", "content_sanskrit": "त्वं ह्येवात्र भृशं गर्ह्यो धृतराष्ट्र सुतप्रियः ।\nयो जानन्पापतामस्य तत्प्रज्ञामनुवर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039949, "chapter_id": 1884, "verse_number": "५-१२९-१२", "content_sanskrit": "स एष काममन्युभ्यां प्रलब्धो लोभमास्थितः ।\nअशक्योऽद्य त्वया राजन्विनिवर्तयितुं बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039950, "chapter_id": 1884, "verse_number": "५-१२९-१३", "content_sanskrit": "राष्ट्रप्रदाने मूढस्य बालिशस्य दुरात्मनः ।\nदुःसहायस्य लुब्धस्य धृतराष्ट्रोऽश्रुते फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039951, "chapter_id": 1884, "verse_number": "५-१२९-१४", "content_sanskrit": "कथं हि स्वजने भेदमुपेक्षेत महीपतिः।\nभिन्नं हि स्वजनेन त्वां प्रहरिष्यन्ति शत्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039952, "chapter_id": 1884, "verse_number": "५-१२९-१५", "content_sanskrit": "या हि शक्या महाराज साम्ना भेदेन वा पुनः ।\nनिस्तर्तुमापदः स्वेषु दण्डं कस्तत्र पातयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039953, "chapter_id": 1884, "verse_number": "५-१२९-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039954, "chapter_id": 1884, "verse_number": "५-१२९-१६", "content_sanskrit": "शासनाद्धृतराष्ट्रस्य दुर्योधनममर्षणम्।\nमातुश्च वचनात्क्षत्ता सभां प्रावेशयत्पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039955, "chapter_id": 1884, "verse_number": "५-१२९-१७", "content_sanskrit": "स मातुर्वचनाकाङ्क्षी प्रविवेश पुनः सभाम् ।\nअभिताम्रेक्षणः क्रोधान्निश्वसन्निव पन्नगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039956, "chapter_id": 1884, "verse_number": "५-१२९-१८", "content_sanskrit": "तं प्रविष्टमभिप्रेक्ष्य पुत्रमुत्पथमास्थितम् ।\nविगर्हमाणा गान्धारी शमार्थं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039957, "chapter_id": 1884, "verse_number": "५-१२९-१९", "content_sanskrit": "दुर्योधन निबोधेदं वचनं मम पुत्रक ।\nहितं ते सानुबन्धस्य तथाऽऽयत्यांसुखोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039958, "chapter_id": 1884, "verse_number": "५-१२९-२०", "content_sanskrit": "दुर्योधन यदाह त्वां पिता भरतसत्तम ।\nभीष्मो द्रोणः कृपः क्षत्ता सुहृदां कुरु तद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039959, "chapter_id": 1884, "verse_number": "५-१२९-२१", "content_sanskrit": "भीष्मस्य तु पितुश्चैव मम चापचितिः कृता ।\nभवेद्द्रोणमुखानां च सुहृदां शाम्यता त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039960, "chapter_id": 1884, "verse_number": "५-१२९-२२", "content_sanskrit": "न हि राज्यं महाप्राज्ञ स्वेन कामेन शक्यते ।\nअवाप्तुं रक्षितुं वाऽपि भोक्तुं भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039961, "chapter_id": 1884, "verse_number": "५-१२९-२३", "content_sanskrit": "न ह्यवश्येन्द्रियो राज्यमश्रीयाद्दीर्घमन्तरम्।\nविजितात्मा तु मेधावी स राज्यमभिपालयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039962, "chapter_id": 1884, "verse_number": "५-१२९-२४", "content_sanskrit": "कामक्रोधौ हि पुरुषमर्थेभ्यो व्यपकर्षतः ।\nतौ तु शत्रू विनिर्जित्य राजा विजयते महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039963, "chapter_id": 1884, "verse_number": "५-१२९-२५", "content_sanskrit": "लोकेश्वर प्रभुत्वंहि महदेतद्दुरात्मभिः ।\nराज्यं नामेप्सितं स्थानं न शक्यमभिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039964, "chapter_id": 1884, "verse_number": "५-१२९-२६", "content_sanskrit": "इन्द्रियाणि महत्प्रेप्सुर्नियच्छेदर्थधर्मयोः ।\nइन्द्रियैर्नियतैर्बुद्धिर्वर्धतेऽग्निरिवेन्धनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039965, "chapter_id": 1884, "verse_number": "५-१२९-२७", "content_sanskrit": "अविधेयानि हीमानि व्यापादयितुमप्यलम् ।\nअविधेया इवादान्ता हयाः पथि कुसारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039966, "chapter_id": 1884, "verse_number": "५-१२९-२८", "content_sanskrit": "अविजित्य य आत्मानममात्यान्विजिगीषते।\nअमित्रान्वाऽजितामात्यः सोऽवशः परिहीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2039967, "chapter_id": 1884, "verse_number": "५-१२९-२९", "content_sanskrit": "आत्मानमेव प्रथमं द्वेष्यरूपेण योजयेत् ।\nततोऽमात्यानमित्रांश्च न मोघं विजिगीषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2039968, "chapter_id": 1884, "verse_number": "५-१२९-३०", "content_sanskrit": "वश्येन्द्रियं जितामात्यं धृतदण्डं विकारिषु ।\nपरीक्ष्यकारिणं धीरमत्यर्थं श्रीर्निषेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2039969, "chapter_id": 1884, "verse_number": "५-१२९-३१", "content_sanskrit": "क्षुद्राक्षेणेव जालेन झषावपिहितावुभौ ।\nकामक्रोधौ शरीरस्थौ प्रज्ञानं तौ विलुम्पतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2039970, "chapter_id": 1884, "verse_number": "५-१२९-३२", "content_sanskrit": "याभ्यां हि देवाः स्वर्यातुः स्वर्गस्य पिदधुर्मुखम् ।\nबिभ्यतोऽनुपरागस्य कामक्रोधौ स्म वर्धितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2039971, "chapter_id": 1884, "verse_number": "५-१२९-३३", "content_sanskrit": "कामं क्रोधं च लोभं च दम्भं दर्पं च भूमिपः ।\nसम्यग्विजेतुं यो वेद स महीमभिजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2039972, "chapter_id": 1884, "verse_number": "५-१२९-३४", "content_sanskrit": "सततं निग्रहे युक्त इन्द्रियाणां भवेन्नृपः ।\nईप्सन्नर्थं च धर्मं च द्विषतां च पराभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2039973, "chapter_id": 1884, "verse_number": "५-१२९-३५", "content_sanskrit": "कामाभिभूतः क्रोधाद्वा यो मिथ्या प्रतिपद्यते।\nस्वेषु चान्येषु वा तस्य न सहाया भवन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2039974, "chapter_id": 1884, "verse_number": "५-१२९-३६", "content_sanskrit": "एकीभूतैर्महाप्राज्ञैः शूरैररिनिबर्हणैः ।\nपाण्डवैः पृथिवीं तात भोक्ष्यसे सहितः सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2039975, "chapter_id": 1884, "verse_number": "५-१२९-३७", "content_sanskrit": "यथा भीष्मः शान्तनवो द्रोणश्चापि महारथः।\nआहतुस्तात तत्सत्यमजेयौ कृष्णपाण्डवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2039976, "chapter_id": 1884, "verse_number": "५-१२९-३८", "content_sanskrit": "प्रपद्यष्व महाबाहुं कृष्णमक्लिष्टकारिणम्।\nप्रसन्नो हि सुखाय स्यादुभयोरेव केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2039977, "chapter_id": 1884, "verse_number": "५-१२९-३९", "content_sanskrit": "सुहृदामर्थकामानां यो न तिष्ठति शासने।\nप्राज्ञानां कृतविद्यानां स नरः शत्रुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2039978, "chapter_id": 1884, "verse_number": "५-१२९-४०", "content_sanskrit": "न युद्धे तात कल्याणं न धर्मार्थौ कुतः सुखम्।\nन चापि विजयो नित्यं मा युद्धे चेत आधिथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2039979, "chapter_id": 1884, "verse_number": "५-१२९-४१", "content_sanskrit": "भीष्मेण हि महाप्राज्ञ पित्र ते बाह्लिकेन च।\nदत्तोंऽशः पाण्डुपुत्राणां भेदाद्भतैररिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2039980, "chapter_id": 1884, "verse_number": "५-१२९-४२", "content_sanskrit": "तस्थ चैतत्प्रदानस्य फलमद्यानुपश्यसि ।\nयद्भुङ्क्षे पृथिवीं कृत्स्नां शूरैर्निहतकण्टकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2039981, "chapter_id": 1884, "verse_number": "५-१२९-४३", "content_sanskrit": "प्रयच्छ पाण्डुपुत्राणां यथोचितमरिन्दम ।\nयदीच्छसि सहामात्यो भोक्तुमर्धं प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2039982, "chapter_id": 1884, "verse_number": "५-१२९-४४", "content_sanskrit": "अलमर्धं पृथिव्यास्ते महामात्यस्य जीवितुम् ।\nसुहृदां वचने तिष्ठन्यशः प्राप्स्यति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2039983, "chapter_id": 1884, "verse_number": "५-१२९-४५", "content_sanskrit": "श्रीमद्भिरात्मवद्भिस्तैर्बुद्धिमद्भिर्जितेन्द्रियैः ।\nपाण्डवैर्विग्रहस्तात भ्रंशयेन्महतः सुखात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2039984, "chapter_id": 1884, "verse_number": "५-१२९-४६", "content_sanskrit": "निगृह्य सुहृदां मन्युं शाधि राज्यं यथोचितम्।\nस्वमंशं पाण्डुपुत्रेभ्यः प्रदाय भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2039985, "chapter_id": 1884, "verse_number": "५-१२९-४७", "content_sanskrit": "अलमङ्ग निकारोऽयं त्रयोदशसमाः कृतः ।\nशमयैनं महाप्राज्ञ कामक्रोधसमेधितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2039986, "chapter_id": 1884, "verse_number": "५-१२९-४८", "content_sanskrit": "न चैष शक्तः पार्थानां यस्त्वदर्थमभीप्सति ।\nसूतपुत्रो दृढक्रोधो भ्राता दुःशासनश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2039987, "chapter_id": 1884, "verse_number": "५-१२९-४९", "content_sanskrit": "भीष्मे द्रोणे कृपे कर्णे भीमसेने धनञ्जये।\nधृष्टद्युम्ने च संक्रुद्धे न स्युः सर्वाः प्रजा ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2039988, "chapter_id": 1884, "verse_number": "५-१२९-५०", "content_sanskrit": "अमर्षवशमापन्नो मा कुरूंस्तात जीघनः ।\nएषा हि पृथिवी कृत्स्ना मा गमत्त्वत्कृते वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2039989, "chapter_id": 1884, "verse_number": "५-१२९-५१", "content_sanskrit": "यच्च त्वं मन्यसे मूढ भीष्मद्रोणकृपादयः।\nयोत्स्यन्ते सर्वशक्त्येति नैतदद्योपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2039990, "chapter_id": 1884, "verse_number": "५-१२९-५२", "content_sanskrit": "समं हि राज्यं प्रीतिश्च स्थानं हि विदितात्मनाम् ।\nपाण्डवेष्वथ युष्मासु धर्मस्त्वभ्यधिकस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2039991, "chapter_id": 1884, "verse_number": "५-१२९-५३", "content_sanskrit": "राजपिण्डभयादेते यदि हास्यन्ति जीवितम् ।\nन हि शक्ष्यन्ति राजानं युधिष्ठिरमुदीक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2039992, "chapter_id": 1884, "verse_number": "५-१२९-५४", "content_sanskrit": "न लोभादर्थसंपत्तिर्नराणामिह दृश्यते ।\nतदलं तात लोभेन प्रशाम्य भरतर्षभ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2039993, "chapter_id": 1884, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकोनत्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]