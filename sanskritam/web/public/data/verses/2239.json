[{"id": 2057142, "chapter_id": 2239, "verse_number": "७-१६६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057143, "chapter_id": 2239, "verse_number": "७-१६६-१", "content_sanskrit": "वर्तमाने तदा रौद्रे रात्रियुद्धे विशाम्पते।\nसर्वभूतक्षयकरे धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057144, "chapter_id": 2239, "verse_number": "७-१६६-२", "content_sanskrit": "अब्रवीत्पाण्डवांश्चैव पाञ्चालांश्चैव सोमकान्।\nअभिद्रवत संयात द्रोणमेव जिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057145, "chapter_id": 2239, "verse_number": "७-१६६-३", "content_sanskrit": "राज्ञस्ते वचनाद्राजन्पाञ्चालाः सृञ्जयास्तथा।\nद्रोणमेवाभ्यवर्तन्त नदन्तो भैरवान्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057146, "chapter_id": 2239, "verse_number": "७-१६६-४", "content_sanskrit": "तान्वयं प्रतिगर्जन्तः प्रत्युद्याताः स्म हर्षिताः।\nयथाशक्ति यथोत्साहं यथासत्वं च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057147, "chapter_id": 2239, "verse_number": "७-१६६-५", "content_sanskrit": "कृतवर्मा तु हार्दिक्यो युधिष्ठिरमुपाद्रवत्।\nद्रोणं प्रति समायान्तं मत्तो मत्तमिव द्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057148, "chapter_id": 2239, "verse_number": "७-१६६-६", "content_sanskrit": "शैनेयं शरवर्षाणि विकिरन्तं समन्ततः।\nअभ्ययात्कौरवो राजन्भूरिः सङ्ग्राममूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057149, "chapter_id": 2239, "verse_number": "७-१६६-७", "content_sanskrit": "सहदेवमथायान्तं द्रोणप्रेप्सुं महारथम्।\nकर्णो वैकर्तनो राजन्वारयामास पाण़्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057150, "chapter_id": 2239, "verse_number": "७-१६६-८", "content_sanskrit": "भीमसेनमथायान्तं व्यादितास्यामिवान्तकम्।\nस्वयं दुर्योधनो राजा प्रतीपं मृत्युमाव्रजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057151, "chapter_id": 2239, "verse_number": "७-१६६-९", "content_sanskrit": "नकुलं च युधां श्रेष्ठं सर्वयुद्धविशारदम्।\nशकुनिः सौबलो राजन्वारयामास सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057152, "chapter_id": 2239, "verse_number": "७-१६६-१०", "content_sanskrit": "शिखण्डिनमथायान्तं रथेन रथिनां वरम्।\nकृपः शारद्वतो राजन्वारयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057153, "chapter_id": 2239, "verse_number": "७-१६६-११", "content_sanskrit": "प्रतिविन्ध्यमथायान्तं मयूरसदृशैर्हयैः।\nदुःशासनो महाराज यत्तो यत्तमवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057154, "chapter_id": 2239, "verse_number": "७-१६६-१२", "content_sanskrit": "भैमसेनिमथायान्तं मायाशतविशारदम्।\nअश्वत्थामा महाराज राक्षसं प्रत्यषेधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057155, "chapter_id": 2239, "verse_number": "७-१६६-१३", "content_sanskrit": "द्रुपदं वृषसेनस्तु ससैन्यं सपदानुगम्।\nवारयामास समरे द्रोणप्रेप्सुं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057156, "chapter_id": 2239, "verse_number": "७-१६६-१४", "content_sanskrit": "विराटं द्रुतमायान्तं द्रोणस्य निधनं प्रति।\nमद्रराजः सुसङ्क्रुद्धो वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057157, "chapter_id": 2239, "verse_number": "७-१६६-१५", "content_sanskrit": "शतानीकमथायान्तं नाकुलिं रभसं रणे।\nचित्रसेनो रुरोधाशु शरैर्द्रोणपरीप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057158, "chapter_id": 2239, "verse_number": "७-१६६-१६", "content_sanskrit": "अर्जुनं च युधांश्रेष्ठं प्राद्रवन्तं महारथम्।\nअलायुधो महाराज राक्षसेन्द्रो न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057159, "chapter_id": 2239, "verse_number": "७-१६६-१७", "content_sanskrit": "तथा द्रोणं महेष्वासं निघ्नन्तं शात्रवान्रणे।\nधृष्टद्युम्नोऽथ पाञ्चाल्यो हृष्टरूपमवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057160, "chapter_id": 2239, "verse_number": "७-१६६-१८", "content_sanskrit": "तथाऽन्यान्पाण्डुपुत्राणां समायातान्महारथान्।\nतावका रथिनो राजन्वारयामासुरोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057161, "chapter_id": 2239, "verse_number": "७-१६६-१९", "content_sanskrit": "गजारोहा गजैस्तूर्णं सन्निपत्य महामृधे।\nयोधयन्तः स्म दृश्यन्ते शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057162, "chapter_id": 2239, "verse_number": "७-१६६-२०", "content_sanskrit": "निशीथे तुरगा राजन्द्रावयन्तः परस्परम्।\nसमदृश्यन्त वेगेन पक्षवन्तो यथाऽद्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057163, "chapter_id": 2239, "verse_number": "७-१६६-२१", "content_sanskrit": "सादिनः सादिभिः सार्धं प्रासशक्त्यृष्टिपाणयः।\nसमागच्छन्महाराज विनदन्तः पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057164, "chapter_id": 2239, "verse_number": "७-१६६-२२", "content_sanskrit": "नरास्तु बहवस्तत्र समाजग्मुः परस्परम्।\nगादाभिर्मुसलैश्चैव नानाशस्त्रैश्च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057165, "chapter_id": 2239, "verse_number": "७-१६६-२३", "content_sanskrit": "कृतवर्मा तु हार्दिक्यो धर्मपुत्रं युधिष्ठिरम्।\nवारयामास सङ्क्रुद्धो वेलेवोद्वृत्तमर्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057166, "chapter_id": 2239, "verse_number": "७-१६६-२४", "content_sanskrit": "युधिष्ठिरस्तु हार्दिक्यं विद्व्वा पञ्चभिराशुगैः।\nपुनर्विव्याध विंशत्या तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057167, "chapter_id": 2239, "verse_number": "७-१६६-२५", "content_sanskrit": "कृतवर्मा तु सङ्क्रुद्धो धर्मपुत्रस्य मारिष।\nधनुश्चिच्छेद भल्लेन तं च विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057168, "chapter_id": 2239, "verse_number": "७-१६६-२६", "content_sanskrit": "अथान्यद्धनुरादाय धर्मपुत्रो महारथः।\nहार्दिक्यं दशभिर्बाणैर्बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057169, "chapter_id": 2239, "verse_number": "७-१६६-२७", "content_sanskrit": "माधवस्तु रणे विद्धो धर्मपुत्रेण मारिष।\nप्राकम्पत च रोषेण सप्तभिश्चार्दयच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057170, "chapter_id": 2239, "verse_number": "७-१६६-२८", "content_sanskrit": "तस्य पार्थो धनुश्छित्त्वा हस्तावापं निकृत्य च।\nप्राहिणोन्निशितान्बाणान्पञ्च राजञ्छिलाशितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057171, "chapter_id": 2239, "verse_number": "७-१६६-२९", "content_sanskrit": "ते तस्य कवचं भित्त्वा हेमचित्रं महाधनम्।\nप्राविशन्धरणीं भित्त्वा वल्मीकमिव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057172, "chapter_id": 2239, "verse_number": "७-१६६-३०", "content_sanskrit": "अक्ष्णोर्निमेषमात्रेण सोऽन्यदादाय कार्मुकम्।\nविव्याध पाण्डवं षष्ट्या सूतं च नवभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057173, "chapter_id": 2239, "verse_number": "७-१६६-३१", "content_sanskrit": "तस्य शक्तिममेयात्मा पाण्डवो भुजगोपमाम्।\nचिक्षेप भरश्रेष्ठ रथे न्यस्य महद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057174, "chapter_id": 2239, "verse_number": "७-१६६-३२", "content_sanskrit": "सा हेमचित्रा महती पाण्डवेयेन प्रेरिता।\nनिर्भिद्य दक्षिणं बाहुं प्राविशद्धरणीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057175, "chapter_id": 2239, "verse_number": "७-१६६-३३", "content_sanskrit": "एतस्मिन्नेव काले तु गृह्य पार्थः पुनर्धनुः।\nहार्दिक्यं छादयामास शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057176, "chapter_id": 2239, "verse_number": "७-१६६-३४", "content_sanskrit": "ततस्तु समरे शूरो वृष्णीनां प्रवरो रथी।\nव्यश्चसूतरथं चक्रे निमेषार्धाद्युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057177, "chapter_id": 2239, "verse_number": "७-१६६-३५", "content_sanskrit": "ततस्तु पाण्डवो ज्येष्ठः खङ्गं चर्म समाददे।\nतदस्य निशितैर्बाणैर्व्यधमन्माधवो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057178, "chapter_id": 2239, "verse_number": "७-१६६-३६", "content_sanskrit": "तोमरं तु ततो गृह्य स्वर्णदण्डं दुरासदम्।\nप्रैषयत्समरे तूर्णं हार्दिक्यस्य युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057179, "chapter_id": 2239, "verse_number": "७-१६६-३७", "content_sanskrit": "तमापतन्तं सहसा धर्मराजभुजच्युतम्।\nद्विधा चिच्छेद हार्दिक्यः कृतहस्तः स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057180, "chapter_id": 2239, "verse_number": "७-१६६-३८", "content_sanskrit": "ततः शरशतेनाजौ धर्मपुत्रमवाकिरत्।\nकवचं चास्य सङ्क्रुद्धः शरैस्तीक्ष्णैरदारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057181, "chapter_id": 2239, "verse_number": "७-१६६-३९", "content_sanskrit": "हार्दिक्यशरसञ्छन्नं कवचं तन्महाधनम्।\nव्यशीर्यत रणे राजंस्ताराजालमिवाम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057182, "chapter_id": 2239, "verse_number": "७-१६६-४०", "content_sanskrit": "स च्छिन्नधन्वा विरथः शीर्णवर्मा शरार्दितः।\nअपायासीद्रणात्तूर्णं धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057183, "chapter_id": 2239, "verse_number": "७-१६६-४१", "content_sanskrit": "कृतवर्मा तु निर्जित्य धर्मात्मानं युधिष्ठिरम्।\nपुनर्द्रोणस्य जुगुपे चक्रमेव महात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057184, "chapter_id": 2239, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे षट्षष्ट्यधिकशततमोऽध्यायः॥ १६६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१६६-१२ भैमसेनिं घटोत्कचम्॥ ५-१६६-२७ माधवः कृतवर्मा॥ ५-१६६-१६६ षट्षष्ठ्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]