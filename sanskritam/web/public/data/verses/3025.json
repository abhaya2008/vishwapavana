[{"id": 2094651, "chapter_id": 3025, "verse_number": "१३-१५५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nआलोकदानं नामैतत्कीदृशं भरतर्षभ।\nकथमेतत्समुत्पन्नं फलं वा तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094652, "chapter_id": 3025, "verse_number": "१३-१५५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094653, "chapter_id": 3025, "verse_number": "१३-१५५-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nमनोः प्रजापतेर्वादं सुवर्णस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094654, "chapter_id": 3025, "verse_number": "१३-१५५-३", "content_sanskrit": "तपस्वी कश्चिदभवत्सुवर्णो नाम भारत।\nवर्णतो हेमवर्णः स सुवर्ण इति विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094655, "chapter_id": 3025, "verse_number": "१३-१५५-४", "content_sanskrit": "कुलशीलगुणोपेतः स्वाध्यायोपरमं गतः।\nबहून्सुवंशप्रभवान्समतीतः स्वकैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094656, "chapter_id": 3025, "verse_number": "१३-१५५-५", "content_sanskrit": "स कदाचिन्मनुं विप्रो ददर्शोपससर्प च।\nकुशलप्रश्नमन्योन्यं तौ चोभौ तत्र चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094657, "chapter_id": 3025, "verse_number": "१३-१५५-६", "content_sanskrit": "ततस्तौ सत्यसंकल्पौ मेरौ काञ्चनपर्वते।\nदेवर्षिभिः सदा जुष्टे सहितौ संन्यषीदताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094658, "chapter_id": 3025, "verse_number": "१३-१५५-७", "content_sanskrit": "तत्र तौ कथयन्तौ स्तां कथा नानाविधाश्रयाः।\nब्रह्मर्षिदेवदैत्यानां पुराणानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094659, "chapter_id": 3025, "verse_number": "१३-१५५-८", "content_sanskrit": "सुवर्णस्त्वब्रवीद्वाक्यं मनुं स्वायंभुवं प्रति।\nहितार्थं सर्वभूतानां प्रश्नं मे वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094660, "chapter_id": 3025, "verse_number": "१३-१५५-९", "content_sanskrit": "सुमनोगन्धधूपाद्यैरिज्यन्ते दैवतानि च।\nकिमेतत्कथमुत्पन्नं फलं योगं च शंस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094661, "chapter_id": 3025, "verse_number": "१३-१५५-१०x", "content_sanskrit": "मनुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094662, "chapter_id": 3025, "verse_number": "१३-१५५-१०", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nशुक्रस्य च बलेश्चैव संवादं वै महात्मनोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094663, "chapter_id": 3025, "verse_number": "१३-१५५-११", "content_sanskrit": "बलेर्वैरोचनस्येह त्रैलोक्यमनुशासतः।\nसमीपमाजगामाशु शुक्रो भृगुकुलोद्वहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094664, "chapter_id": 3025, "verse_number": "१३-१५५-१२", "content_sanskrit": "तमर्घ्यादिभिरभ्यर्च्य भार्गवं सोऽसुराधिपः।\nनिषसादासने पश्चाद्विधिवद्भूरिदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094665, "chapter_id": 3025, "verse_number": "१३-१५५-१३", "content_sanskrit": "कथेयमभवत्तत्र त्वया या परिकीर्तिता।\nसुमनोधूपदीपानां सम्प्रदाने फलं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094666, "chapter_id": 3025, "verse_number": "१३-१५५-१४", "content_sanskrit": "ततः पप्रच्छ दैत्येन्द्रः कवीन्द्रं प्रश्नमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094667, "chapter_id": 3025, "verse_number": "१३-१५५-१५", "content_sanskrit": "सुमनोधूपदीपानां किं फलं ब्रह्मिवित्तम।\nप्रदानस्य द्विजश्रेष्ठ तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094668, "chapter_id": 3025, "verse_number": "१३-१५५-१६x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094669, "chapter_id": 3025, "verse_number": "१३-१५५-१६", "content_sanskrit": "अग्नीषोमादिसृष्टौ तु विष्णोः सर्वात्मनः प्रभोः।\nतपः पूर्वं समुत्पन्नं धर्मस्तस्मादनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094670, "chapter_id": 3025, "verse_number": "१३-१५५-१७", "content_sanskrit": "एतस्मिन्नन्तरे चैव वीरुदोषध्य एव च।\nसोमस्यात्मा च बहुधा सम्भूतः पृथिवीतले।\nअमृतं च विषं चैव याश्चान्यास्तृणजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094671, "chapter_id": 3025, "verse_number": "१३-१५५-१८", "content_sanskrit": "अमृतं मनसः प्रीतिं सद्यस्तृप्तिं ददाति च।\nमनो ग्लपयते तीव्रं विषं गन्धेन सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094672, "chapter_id": 3025, "verse_number": "१३-१५५-१९", "content_sanskrit": "अमृतं मङ्गलं विद्धि महद्विषममङ्गलम्।\nओषध्यो ह्यमृतं सर्वा विषं तेजोग्निसम्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094673, "chapter_id": 3025, "verse_number": "१३-१५५-२०", "content_sanskrit": "अमृतं मनो ह्लादयते श्रियं चापि ददाति च।\nतस्मात्सुमनसः प्रोक्ता नरैः सुकृतकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094674, "chapter_id": 3025, "verse_number": "१३-१५५-२१", "content_sanskrit": "देवताभ्यः सुमनसो यो ददाति नरः शुचिः।\nतस्मै सुमनसो देवास्तस्मात्सुमनसः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094675, "chapter_id": 3025, "verse_number": "१३-१५५-२२", "content_sanskrit": "यंयमुद्दिश्य दीयेरन्देवं सुमनसः प्रभो।\nमङ्गलार्तं स तेनास्य प्रीतो भवति दैत्यप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094676, "chapter_id": 3025, "verse_number": "१३-१५५-२३", "content_sanskrit": "ज्ञेयास्तूग्राश्च सौम्याश्च तेजस्विन्यश्च ताः पृथक्।\nओषध्यो बहुवीर्या हि बहुरूपास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094677, "chapter_id": 3025, "verse_number": "१३-१५५-२४", "content_sanskrit": "यज्ञियानां च वृक्षाणामयज्ञीयान्निबोध मे।\nआसुराणि च माल्यानि दैवतेभ्यो हितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094678, "chapter_id": 3025, "verse_number": "१३-१५५-२५", "content_sanskrit": "रक्षसामुरगाणां च यक्षाणां च तथा प्रियाः।\nमनुष्याणां पितॄणां च कान्ता यास्त्वनुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094679, "chapter_id": 3025, "verse_number": "१३-१५५-२६", "content_sanskrit": "वन्या ग्राम्याश्चेह तथा कृष्टोप्ताः पर्वताश्रयाः।\nअकण्टकाः कण्टकिनो गन्धरूपरसान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094680, "chapter_id": 3025, "verse_number": "१३-१५५-२७", "content_sanskrit": "द्विविधो हि स्मृतो गन्ध इष्टोऽनिष्टश्च पुष्पजः।\nइष्टगन्धानि देवानां पुष्पाणीति विभावय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094681, "chapter_id": 3025, "verse_number": "१३-१५५-२८", "content_sanskrit": "अकण्टकानां वृक्षाणां श्वेतप्रायाश्च वर्णतः।\nतेषां पुष्पाणि देवानामिष्टानि सततं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094682, "chapter_id": 3025, "verse_number": "१३-१५५-२९", "content_sanskrit": "`पद्मं च तुलसी जातिरापः सर्वेषु पूजिता।\nजलजानि च माल्यानि पद्मादीनि च यानि वै।\nगन्धर्वनागयक्षेभ्यस्तानि दद्याद्विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094683, "chapter_id": 3025, "verse_number": "१३-१५५-३०", "content_sanskrit": "ओपध्यो रक्तपुष्पाश्च कटुकाः कण्टकान्विताः।\nशत्रूणामभिचारार्थमथर्वसु निदर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094684, "chapter_id": 3025, "verse_number": "१३-१५५-३१", "content_sanskrit": "तीक्ष्णवीर्यास्तु भूतानां दुरालम्भाः सकण्टकाः।\nरक्तभूयिष्ठवर्णाश्च कृष्णाश्चैवोपहारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094685, "chapter_id": 3025, "verse_number": "१३-१५५-३२", "content_sanskrit": "मनोहृदयनन्दिन्यो विमर्दे मधुराश्च याः।\nचारुररूपाः सुमनसो मानुपाणां स्मृता विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094686, "chapter_id": 3025, "verse_number": "१३-१५५-३३", "content_sanskrit": "न तु श्मशानसम्भूता न देवायतनोद्भवाः।\nसन्नयेत्पुष्टियुक्तेषु विवाहेषु रहःसु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094687, "chapter_id": 3025, "verse_number": "१३-१५५-३४", "content_sanskrit": "गिरिसानुरुहाः सौम्या देवानामुपधारयेत्।\nप्रोक्षिताभ्युक्षिताः सौम्या यथायोगं यथास्मृति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094688, "chapter_id": 3025, "verse_number": "१३-१५५-३५", "content_sanskrit": "गन्धेन देवास्तुष्यन्ति दर्शनाद्यक्षराक्षसाः।\nनागाः समुपभोगेन त्रिभिरेतैस्तु मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094689, "chapter_id": 3025, "verse_number": "१३-१५५-३६", "content_sanskrit": "सद्यः प्रीणाति देवान्वै ते प्रीता भावयन्त्युत।\nसङ्कल्पसिद्धा मर्त्यानामीप्सिताश्च मनोरथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2094690, "chapter_id": 3025, "verse_number": "१३-१५५-३७", "content_sanskrit": "देवाः प्रीणन्ति सततं मानिता मानयन्ति च।\nअवज्ञातावधूताश्च निर्दहन्त्यधमान्नरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2094691, "chapter_id": 3025, "verse_number": "१३-१५५-३८", "content_sanskrit": "अत ऊर्ध्वं प्रवक्ष्यामि धूपदानविधेः फलम्।\nधूपांश्च विविधान्साधूनसाधूंश्च निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2094692, "chapter_id": 3025, "verse_number": "१३-१५५-३९", "content_sanskrit": "निर्यासाः सरलाश्चैव कृत्रिमाश्चैव ते त्रयः।\nइष्टोऽनिष्टो भवेद्गन्धस्तन्मे विस्तरशः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2094693, "chapter_id": 3025, "verse_number": "१३-१५५-४०", "content_sanskrit": "निर्यासाः सल्लकीवर्ज्या देवानां दयितास्तु ते।\nगुग्गुलुः प्रवरस्तेषां सर्वेपामिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2094694, "chapter_id": 3025, "verse_number": "१३-१५५-४१", "content_sanskrit": "अगुरुः सारिणां श्रेष्ठो यक्षराक्षसभोगिनाम्।\nदैत्यानां सल्लकीजश्च काङ्क्षितो यश्च तद्विधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2094695, "chapter_id": 3025, "verse_number": "१३-१५५-४२", "content_sanskrit": "अथ सर्जरसादीनां गन्धैः पार्थिवदारवैः।\nफाणितासवसंयुक्तैर्मनुष्याणां विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2094696, "chapter_id": 3025, "verse_number": "१३-१५५-४३", "content_sanskrit": "देवदानवभूतानां सद्यस्तुष्ठिकरः स्मृतः।\nयेऽन्ये वैहारिकास्तत्र मानुषाणामिति स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2094697, "chapter_id": 3025, "verse_number": "१३-१५५-४४", "content_sanskrit": "य एवोक्ताः सुमनसां प्रदाने गुणहेतवः।\nधूपेष्वपि परिज्ञेयास्त एव प्रीतिवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2094698, "chapter_id": 3025, "verse_number": "१३-१५५-४५", "content_sanskrit": "दीपदाने प्रवक्ष्यामि फलयोगमनुत्तमम्।\nयथा येन यदा चैव प्रदेया यादृशाश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2094699, "chapter_id": 3025, "verse_number": "१३-१५५-४६", "content_sanskrit": "ज्योतिस्तेजः प्रकाशं वाऽप्यूध्वगं चापि वर्धते।\nप्रदानं तेजसां तस्मात्तेजो वर्धयते नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2094700, "chapter_id": 3025, "verse_number": "१३-१५५-४७", "content_sanskrit": "अन्धतमस्तमिस्रं च दक्षिणायनमेव च।\nउत्तरायणमेतस्माज्ज्योतिर्दानं प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2094701, "chapter_id": 3025, "verse_number": "१३-१५५-४८", "content_sanskrit": "यस्मादूर्ध्वगमे तत्तु तमसश्चैव भेषजम्।\nतस्मादूर्ध्वगतेर्दाता भवेदत्रेति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2094702, "chapter_id": 3025, "verse_number": "१३-१५५-४९", "content_sanskrit": "देवास्तेजस्विनो यस्मात्प्रभावन्तः प्रकाशकाः।\nतामसा राक्षसाश्चैव तस्माद्दीपः प्रदीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2094703, "chapter_id": 3025, "verse_number": "१३-१५५-५०", "content_sanskrit": "आलोकदानाच्चक्षुष्मान्प्रभायुक्तो भवेन्नरः।\nतान्दत्त्वा नोपहिंसेन न हरेन्नोपनाशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2094704, "chapter_id": 3025, "verse_number": "१३-१५५-५१", "content_sanskrit": "दीपहार्ता भवेदन्धस्तमोगतिरसुप्रभः।\nदीपप्रदः स्वर्गलोके दीपमाली विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2094705, "chapter_id": 3025, "verse_number": "१३-१५५-५२", "content_sanskrit": "हविपा प्रथमः कल्पो द्वितीयश्चौषधीरसैः।\nवसामेदोस्थिनिर्यासैर्न कार्यः पुष्टिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2094706, "chapter_id": 3025, "verse_number": "१३-१५५-५३", "content_sanskrit": "देवालये सभायां च गिरौ चैत्यचतुष्पथे।\nदीपदाता भवेन्नित्यं य इच्छेद्भूतिमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2094707, "chapter_id": 3025, "verse_number": "१३-१५५-५४", "content_sanskrit": "कुलोद्योतो विशुद्धात्मा प्रकाशत्वं च गच्छति।\nज्योतिषां चैव सालोक्यं दीपदाता भवेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2094708, "chapter_id": 3025, "verse_number": "१३-१५५-५५", "content_sanskrit": "बलिकर्मसु वक्ष्यामि गुणान्कर्मफलोदयान्।\nदेवयक्षोरगनृणां भूतानामथ रक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2094709, "chapter_id": 3025, "verse_number": "१३-१५५-५६", "content_sanskrit": "येषां नाग्रभुजो विप्रा देवतातिथिबालकाः।\nराक्षसानेव तान्विद्धि निर्वषट्कारमङ्गलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2094710, "chapter_id": 3025, "verse_number": "१३-१५५-५७", "content_sanskrit": "तस्मादग्रं प्रयच्छेत देवभ्यः प्रतिपूजितम्।\nशिरसा प्रणतश्चापि हरेद्बलिमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2094711, "chapter_id": 3025, "verse_number": "१३-१५५-५८", "content_sanskrit": "गृह्णन्ति देवता नित्यमाशंसन्ति सदा गृहान्।\nबाह्याश्चागन्तवो येऽन्ये यक्षराक्षसपन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2094712, "chapter_id": 3025, "verse_number": "१३-१५५-५९", "content_sanskrit": "इतो दत्तेन जीवन्ति देवताः पितरस्तथा।\nते प्रीताः प्रीणयन्त्येनमायुषा यशसा धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2094713, "chapter_id": 3025, "verse_number": "१३-१५५-६०", "content_sanskrit": "बलयः सह पुष्पैस्तु देवानामुपहारयेत्।\nदधिदुग्धमयाः पुण्याः सुगन्धाः प्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2094714, "chapter_id": 3025, "verse_number": "१३-१५५-६१", "content_sanskrit": "कार्या रुधिरमांसाढ्या बलयो यक्षरक्षसाम्।\nसुरासवपुरस्कारा लाजोल्लापिकभूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2094715, "chapter_id": 3025, "verse_number": "१३-१५५-६२", "content_sanskrit": "नागानां दयिता नित्यं पद्मोत्पलविमिश्रिताः।\nतिलान्गुडसुसम्पन्नान्भूतानामुपहारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2094716, "chapter_id": 3025, "verse_number": "१३-१५५-६३", "content_sanskrit": "अग्रदाताऽग्रभोगी स्याद्बलवीर्यसमन्वितः।\nतस्मादग्रं प्रयच्छेत देवभ्यः प्रतिपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2094717, "chapter_id": 3025, "verse_number": "१३-१५५-६४", "content_sanskrit": "ज्वलन्त्यहरहो वेश्म याश्चास्य गृहदेवताः।\nताः पूज्या भूतिकामेन प्रसृताग्रप्रदायिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2094718, "chapter_id": 3025, "verse_number": "१३-१५५-६५", "content_sanskrit": "इत्येतदसुरेन्द्राय काव्यः प्रोवाच भार्गवः।\nसुवर्णाय मनुः प्राह सुवर्णो नारदाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2094719, "chapter_id": 3025, "verse_number": "१३-१५५-६६", "content_sanskrit": "नारदोऽपि मयि प्राह गुणानेतान्महाद्युते।\nत्वमप्येतद्विदित्वेह सर्वमाचर पुत्रक॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2094720, "chapter_id": 3025, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चपञ्चाशदधिकशततमोऽध्यायः॥ १५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]