[{"id": 7006417000, "chapter_id": 26417, "verse_number": "२-७६-१", "content_sanskrit": "वैशम्पायन उवाच\nअथ कृष्णस्य कौरव्य ध्यातमात्रस्तपोधनः ।\nआजगाम मुनिश्रेष्ठो नारदो वदतां वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006417001, "chapter_id": 26417, "verse_number": "२-७६-२", "content_sanskrit": "सम्पूजयित्वा विधिवद् वासुदेवो विशाम्पते ।\nप्रतिग्रहार्थं विधिवच्छ्रीमान् भक्त्या न्यमन्त्रयत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006417002, "chapter_id": 26417, "verse_number": "२-७६-३", "content_sanskrit": "ततः काले च सम्प्राप्ते स्नातं देवो महामुनिम् ।\nसम्पूज्य माल्यैर्गन्धैश्च भोजयामास भारत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006417003, "chapter_id": 26417, "verse_number": "२-७६-४", "content_sanskrit": "सार्वकामिकमन्नाद्यं सर्वभूतकृदन्वयः ।\nसत्यया प्रियया सार्द्धं प्रहृष्टेनान्तरात्मना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006417004, "chapter_id": 26417, "verse_number": "२-७६-५", "content_sanskrit": "पुष्पदामावसृज्याथ कण्ठे कृष्णस्य भाविनी ।\nबबन्ध कृष्णं सुभगा पारिजाते वनस्पतौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006417005, "chapter_id": 26417, "verse_number": "२-७६-६", "content_sanskrit": "अद्भिर्ददौ नारदाय ततोऽनुज्ञाप्य केशवम् ।\nदेवी धेनुसहस्रं च काञ्चनस्य च पर्वतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006417006, "chapter_id": 26417, "verse_number": "२-७६-७", "content_sanskrit": "हिरण्यरूप्यमिश्रं च मणिरत्नप्रभस्य च ।\nतिलमिश्रस्य च तथा धान्यैरन्यैर्युतस्य च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006417007, "chapter_id": 26417, "verse_number": "२-७६-८", "content_sanskrit": "प्रतिगृह्य तु तत् सर्वं नारदो मुनिसत्तमः ।\nस सम्प्रहृष्टो भुक्त्वाथ भूयः केशवमब्रवीत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006417008, "chapter_id": 26417, "verse_number": "२-७६-९", "content_sanskrit": "भोः केशव मदीयस्त्वमद्भिर्दत्तोऽसि सत्यया ।\nस त्वं मामनुगच्छस्व कुरु यद्यद् ब्रवीम्यहम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006417009, "chapter_id": 26417, "verse_number": "२-७६-१०", "content_sanskrit": "प्रथमः पक्ष इत्येवमब्रवीन्मधुसूदनः ।\nव्रजन्तमनुवव्राज नारदं च जनार्दनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006417010, "chapter_id": 26417, "verse_number": "२-७६-११", "content_sanskrit": "परिहासं बहुविधं कृत्वा मुनिवरस्तदा ।\nतिष्ठस्व गच्छामीत्युक्त्वा परिहासविचक्षणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006417011, "chapter_id": 26417, "verse_number": "२-७६-१२", "content_sanskrit": "अपनीय ततः कण्ठात् पुष्पदामैनमब्रवीत् ।\nकपिलां गां सवत्सां भो निष्क्रयार्थं प्रयच्छ मे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006417012, "chapter_id": 26417, "verse_number": "२-७६-१३", "content_sanskrit": "कृष्णाजिनं तिलैः पूर्णं प्रयच्छ च सकाञ्चनम् ।\nएषोऽत्र निष्क्रयः कृष्ण विहितो वृषकेतुना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006417013, "chapter_id": 26417, "verse_number": "२-७६-१४", "content_sanskrit": "तथेत्युक्त्वा हृषीकेशस्तथा चक्रे जनाधिप ।\nस उवाच मुनिश्रेष्ठं हसित्वा मधुसूदनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006417014, "chapter_id": 26417, "verse_number": "२-७६-१५", "content_sanskrit": "वरं वरय धर्मज्ञ यस्ते नारद काङ्क्षितः ।\nतत्ते दातास्मि धर्मज्ञ परा प्रीतिर्हि मे त्वयि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006417015, "chapter_id": 26417, "verse_number": "२-७६-१६", "content_sanskrit": "नारद उवाच\nनित्यमेवास्तु मे प्रीतो भवान् विष्णो सनातन ।\nत्वत्प्रसादात्तु सालोक्यं व्रजेयं ते महामते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006417016, "chapter_id": 26417, "verse_number": "२-७६-१७", "content_sanskrit": "अयोनिजो भवेयं ते नारायण सतां गते ।\nभवेयं ब्राह्मणश्चैव पुनर्जात्यन्तरेष्वपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006417017, "chapter_id": 26417, "verse_number": "२-७६-१८", "content_sanskrit": "एवमस्त्विति तं देवो विष्णुः प्रोवाच भारत ।\nतुतोष च ततो धीमान् नारदो मुनिसत्तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006417018, "chapter_id": 26417, "verse_number": "२-७६-१९", "content_sanskrit": "षोडश स्त्रीसहस्राणि विष्णोरतुलतेजसः ।\nनिमन्त्रितानि कौरव्य सत्यया हरिक्रान्तया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006417019, "chapter_id": 26417, "verse_number": "२-७६-२०", "content_sanskrit": "तासां ददौ संनियोगमेकैकं हरिवल्लभा ।\nशच्या यो वासुदेवस्य पुरा दत्तो नराधिप ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006417020, "chapter_id": 26417, "verse_number": "२-७६-२१", "content_sanskrit": "पारिजातो वसंस्तत्र ततः प्रववृते तदा ।\nआज्ञया वासुदेवस्य नारदेन महात्मना ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006417021, "chapter_id": 26417, "verse_number": "२-७६-२२", "content_sanskrit": "निमन्त्रिता गणाः सर्वे केशवेन महात्मना ।\nविभूतिं पारिजातस्य ददृशुः कुरुनन्दन ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006417022, "chapter_id": 26417, "verse_number": "२-७६-२३", "content_sanskrit": "पाण्डवांश्चानयामास सहैव पृथया हरिः ।\nद्रौपद्या च महातेजास्तथैव च सुभद्रया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006417023, "chapter_id": 26417, "verse_number": "२-७६-२४", "content_sanskrit": "श्रुतश्रवां च ससुतां भीष्मकं ससुतं तदा ।\nअन्यानपि च कौरव्य मित्रसम्बन्धिबान्धवान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006417024, "chapter_id": 26417, "verse_number": "२-७६-२५", "content_sanskrit": "रेमे च सह पार्थेन फाल्गुनेन जनार्दनः ।\nसान्तःपुरो महातेजाः परमर्द्ध्यावसन्नृप ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006417025, "chapter_id": 26417, "verse_number": "२-७६-२६", "content_sanskrit": "संवत्सरे ततो याते केशिहामरसत्तमः ।\nपारिजातं पुनः स्वर्गमानयत् सर्वभावनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006417026, "chapter_id": 26417, "verse_number": "२-७६-२७", "content_sanskrit": "तत्रादितिं कश्यपं च दृष्ट्वा स्वजननीं प्रभुः ।\nशक्रेण सहितो धीमानप्रमेयपराक्रमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006417027, "chapter_id": 26417, "verse_number": "२-७६-२८", "content_sanskrit": "तमुवाचादितिर्माता प्रणतं मधुसूदनम् ।\nसौभ्रात्रमस्तु वामेवं नित्यं चामरसत्तम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006417028, "chapter_id": 26417, "verse_number": "२-७६-२९", "content_sanskrit": "मनोरथं मम त्वं च पूरयस्व जनार्दन ।\nतथेत्येवाब्रवीत्कृष्णस्ततो मातरमात्मवान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006417029, "chapter_id": 26417, "verse_number": "२-७६-३०", "content_sanskrit": "आमन्त्रयित्वा पितरौ देवराजानमब्रवीत् ।\nवासुदेवो महातेजाः कालप्राप्तमिदं वचः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006417030, "chapter_id": 26417, "verse_number": "२-७६-३१", "content_sanskrit": "महादेवेन देवेश संदिष्टोऽस्मि महात्मना ।\nभन्तर्भूमितलेऽवध्यानसुरान् प्रति मानद ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006417031, "chapter_id": 26417, "verse_number": "२-७६-३२", "content_sanskrit": "तदितो दशरात्रेण हन्ताहमसुरोत्तमान् ।\nतत्रोपविष्टान् स्थातव्यं प्रवरेण महात्मना ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006417032, "chapter_id": 26417, "verse_number": "२-७६-३३", "content_sanskrit": "जयन्तेन च वीरेण दानवानां जिघांसया ।\nएकोऽत्र मानुषो देवो देवपुत्रस्तथा परः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006417033, "chapter_id": 26417, "verse_number": "२-७६-३४", "content_sanskrit": "अवध्याः किल ते देवैर्ब्रह्मणो वरदर्पिताः ।\nअस्माभिः किल हन्तव्या मानुषत्वमुपागतैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006417034, "chapter_id": 26417, "verse_number": "२-७६-३५", "content_sanskrit": "तथेति कृष्णं स हरिः प्रीतरूपस्तथाव्रवीत् ।\nसस्वजाते ततो देवावन्योन्यं जनमेजय ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]