[{"id": 50006072, "chapter_id": 11301, "verse_number": "1", "content_sanskrit": "तस्मादनन्तमाहात्म्यगुणपूर्णो 【पाठभेदः: BG—तस्मादनन्तमाहात्म्यगुणपूगो】 जनार्दनः। भक्त्या परमयाऽऽराध्य इति पादार्थ ईयते॥ २२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006073, "chapter_id": 11301, "verse_number": "2", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते ब्रह्मसूत्रानुव्याख्याने तृतीयाध्यायस्य द्वितीयः पादः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006074, "chapter_id": 11301, "verse_number": "3", "content_sanskrit": "॥ तृतीयः पादः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]