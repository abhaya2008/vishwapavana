[{"id": 7001042000, "chapter_id": 21042, "verse_number": "५-२४-१", "content_sanskrit": "इत्थं स्तुतस्तदा तेन मुचुकुन्देन धीमता ।\nप्राहेशः सर्व्वभूतानामनादिर्भगवान हरिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001042001, "chapter_id": 21042, "verse_number": "५-२४-२", "content_sanskrit": "यथाभिवाञ्छितान् दिव्यान् गच्छ लोकान् नरेखर ।\nअव्याहतपरैश्वर्य्यो मतप्रसादोपबुं हितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001042002, "chapter_id": 21042, "verse_number": "५-२४-३", "content_sanskrit": "भुक्त्वा भोगान् महादिव्यान् भविष्यसि महाकुले ।\nजातिस्मरो मत्प्रसादात ततो मोक्षमवाप्स्यसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001042003, "chapter_id": 21042, "verse_number": "५-२४-४", "content_sanskrit": "इत्युक्तः प्रमिपत्येशं जगतामच्युतं नृपः ।\nगुहामुखाद् विनिष्कान्तो ददृशे सोऽल्पकान् नरान ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001042004, "chapter_id": 21042, "verse_number": "५-२४-५", "content_sanskrit": "ततः कलियुगं ज्ञात्वा प्राप्तं तप्तुं नृपस्तपः ।\nनरनारायणस्थानं प्रययौ गन्धमादनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001042005, "chapter_id": 21042, "verse_number": "५-२४-६", "content_sanskrit": "कृष्णोऽपि घातयित्वारिमुपायेन हि तदूबलम् ।\nजग्राह मथुरामेत्य हस्त्यश्वस्यन्दनोज्जवलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001042006, "chapter_id": 21042, "verse_number": "५-२४-७", "content_sanskrit": "आनीय चोग्रसेनाय द्रारवत्यां न्यवेदयत् ।\nपराभिभवनिः शङ्क बभूव च यदोः कुलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001042007, "chapter_id": 21042, "verse_number": "५-२४-८", "content_sanskrit": "बलदेवोऽपि मैत्रेय! प्रशान्ताखिलविग्रह- ।\nज्ञातिसन्दर्शनोतूकण्ठः प्रययौ नन्दगौकुलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001042008, "chapter_id": 21042, "verse_number": "५-२४-९", "content_sanskrit": "ततो गोपीश्व गोपांश्व यथापूर्व्वममित्रजित् ।\nतथैवाभ्यवदत् प्रेमूणा बहुमानपुरःसरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001042009, "chapter_id": 21042, "verse_number": "५-२४-१०", "content_sanskrit": "कैश्वापि सम्परिष्वक्तः कांश्वित् स परिषस्वजे ।\nहास्यञ्चक समं कैश्विदू गोपैर्गोपीजनैस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001042010, "chapter_id": 21042, "verse_number": "५-२४-११", "content_sanskrit": "प्रियाणयनेकान्यवदन् गोपास्तत्र हलायुधम् ।\nगोप्यश्व प्रे मकुपिताः प्रोचुः सेर्ष्यमथापराः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001042011, "chapter_id": 21042, "verse_number": "५-२४-१२", "content_sanskrit": "गोप्यः पप्रच्छुरपरा नागरीजनवल्लभः ।\nकज्विदास्ते सुखं कृष्णश्वलत्प्र मलवात्मकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001042012, "chapter_id": 21042, "verse_number": "५-२४-१३", "content_sanskrit": "अस्मच्चेष्टामुपहसन् कज्विन्न पुरयोताम् ।\nसौभाग्यमानमधिकं करोति करोति क्षणसौह्टदः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001042013, "chapter_id": 21042, "verse_number": "५-२४-१४", "content_sanskrit": "कज्वित् स्मरति नः कृष्णो गातानुगमन कलम् ।\nअप्यसौ मातरं द्रष्टुं सकृदप्यागमिष्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001042014, "chapter_id": 21042, "verse_number": "५-२४-१५", "content_sanskrit": "अथवा कि तदालापरपरा क्रियतां कथा ।\nतस्यास्माभिर्विना तेन विनास्माकं भविष्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001042015, "chapter_id": 21042, "verse_number": "५-२४-१६", "content_sanskrit": "पिता माता तथा भ्राता भर्त्ता बन्धुजनश्व किम् ।\nन त्यक्तस्ततूकृतेऽस्माभिरकृतज्ञध्वजो हि सः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001042016, "chapter_id": 21042, "verse_number": "५-२४-१७", "content_sanskrit": "तथापि क्वचिदालापमिहागमनसंश्रयम् ।\nकरोति कृष्णो वक्तव्यं भवताकृष्ण नानृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001042017, "chapter_id": 21042, "verse_number": "५-२४-१८", "content_sanskrit": "दामोदरोऽसौ गोविन्दः पुरस्त्रीन्यस्तमानसः ।\nअपेतप्रीतिरस्मासु दुर्द्दर्शः प्रतिभाति नः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001042018, "chapter_id": 21042, "verse_number": "५-२४-१९", "content_sanskrit": "आमन्त्रितः स कृष्णोति पुनर्दामोदरेति च ।\nजहसुः सुस्वर गोप्यो हरिणा ह्टतचेतसः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001042019, "chapter_id": 21042, "verse_number": "५-२४-२०", "content_sanskrit": "सन्देशैः साममधुरैः प्रमगर्भैरगर्व्वितैः ।\nरामेणाश्वासिता गोप्यः कृष्णस्यातिमनोहरैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001042020, "chapter_id": 21042, "verse_number": "५-२४-२१", "content_sanskrit": "गोपैश्व पूर्व्ववदू रामः परिहासमनोरमाः ।\nकथाश्वकार रेमे च सह तैर्व्रजभूमिषु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]