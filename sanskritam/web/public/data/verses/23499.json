[{"id": 7003499000, "chapter_id": 23499, "verse_number": "१३९-१", "content_sanskrit": "अथ सौकरमाहात्म्यम् ।\nश्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि लिप्यमानस्य यत्फलम् ।\nसर्वं ते कथयष्यामि यथा प्राप्नोति मानवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003499001, "chapter_id": 23499, "verse_number": "१३९-२", "content_sanskrit": "गृहीत्वा गोमयं भूमे मम वेश्मोपलेपयेत् ।\nन्यस्तानि तत्र यावन्ति पदानि च विलिम्पतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003499002, "chapter_id": 23499, "verse_number": "१३९-३", "content_sanskrit": "तावद्वर्षसहस्राणि दिव्यानि दिवि मोदते ।\nयदि द्वादशवर्षाणि लिप्यते मम कर्मसु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003499003, "chapter_id": 23499, "verse_number": "१३९-४", "content_sanskrit": "जायते विपुले शुद्धे धनधान्यसमाकुले ।\nदिव्यैर्नमस्कृतो देवि कुशद्वीपं च गच्छति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003499004, "chapter_id": 23499, "verse_number": "१३९-५", "content_sanskrit": "कुशद्वीपमनुप्राप्य सहस्राणि च जीवति ।\nदश चैव तु वर्षाणां मम भक्तो महाञ्छुचिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003499005, "chapter_id": 23499, "verse_number": "१३९-६", "content_sanskrit": "कुशद्वीपात्परिभ्रष्टो मम कर्मपरायणः।\nराजा वै जायते सुभ्रु सर्वधर्मेषु निष्ठितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003499006, "chapter_id": 23499, "verse_number": "१३९-७", "content_sanskrit": "तेन तस्य प्रभावेण मम कर्मपरायणः ।\nभक्तौ व्यवस्थितश्चापि सर्वशास्त्राणि पृच्छति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003499007, "chapter_id": 23499, "verse_number": "१३९-८", "content_sanskrit": "देवि कारयते सर्वं मम चायतनानि च।\nकारयित्वा यथान्यायं मम लोकं स गच्छति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003499008, "chapter_id": 23499, "verse_number": "१३९-९", "content_sanskrit": "गोमयस्य तु वक्ष्यामि तच्छृणुष्व वसुन्धरे।\nगोमयन्तु समासाद्य यावल्लोकोऽनुगच्छति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003499009, "chapter_id": 23499, "verse_number": "१३९-१०", "content_sanskrit": "समीपे यदि वा दूरे गत्वा नयति गोमयम्।\nयावन्ति तत्पदान्यस्य तावद्वर्ष सहस्रकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003499010, "chapter_id": 23499, "verse_number": "१३९-११", "content_sanskrit": "गोमयानां च नेता वै स्वर्गलोके महीयते।\nततः स शाल्मले द्वीपे रमते च मुदा युतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003499011, "chapter_id": 23499, "verse_number": "१३९-१२", "content_sanskrit": "एकादशसहस्राणि एकादशशतानि च ।\nशाल्मलात्तु परिभ्रष्टो राजा भवति धार्मिकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003499012, "chapter_id": 23499, "verse_number": "१३९-१३", "content_sanskrit": "मद्भक्तश्चैव जायेत सर्वधर्मविदां वरः ।\nअथ द्वादशवर्षाणि मच्छ्रितः सुदृढव्रतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003499013, "chapter_id": 23499, "verse_number": "१३९-१४", "content_sanskrit": "वहते गोमयं सुष्ठु मम लोकं स गच्छति ।\nस्नानोपलेपने भूमे सलिलं यो ददाति च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003499014, "chapter_id": 23499, "verse_number": "१३९-१५", "content_sanskrit": "तस्य पुण्यं महाभागे शृणु तत्वेन निष्कलम् ।\nयावन्तो बिन्दवस्तत्र पानीयस्य वसुन्धरे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003499015, "chapter_id": 23499, "verse_number": "१३९-१६", "content_sanskrit": "तावद्वर्षसहस्राणि स्वर्गलोके महीयते ।\nस्वर्गलोकात्परिभ्रष्टः क्रौचद्वीपं च गच्छति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003499016, "chapter_id": 23499, "verse_number": "१३९-१७", "content_sanskrit": "क्रौंचद्वीपात्परिभ्रष्टो राजा भवति धार्मिकः ।\nतेनैव गुणयोगेन श्वेतद्वीपं च गच्छति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003499017, "chapter_id": 23499, "verse_number": "१३९-१८", "content_sanskrit": "संमार्ज्जनं प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nयां गतिं पुरुषा यान्ति स्त्रियो वा कर्मसु स्थिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003499018, "chapter_id": 23499, "verse_number": "१३९-१९", "content_sanskrit": "शुचिर्भागवतः शुद्धो अपराधविवर्जितः ।\nयावन्तः पांसवो भूमेरुड्डीयन्ते तु चालिताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003499019, "chapter_id": 23499, "verse_number": "१३९-२०", "content_sanskrit": "तावद्वर्षशतान्याशु स्वर्गलोके महीयते ।\nस्वर्गलोकात्परिभ्रष्टः शाकद्वीपं स गच्छति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003499020, "chapter_id": 23499, "verse_number": "१३९-२१", "content_sanskrit": "तत्र स्थित्वा चिरङ्कालं राजा भवति धार्मिकः ।\nततो भुक्त्वा सर्वभोगान्स्थित्वा संसारसागरे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003499021, "chapter_id": 23499, "verse_number": "१३९-२२", "content_sanskrit": "श्वेतद्वीपं ततो गच्छेन्मत्कर्मनिरतः शुचिः ।\nअन्यच्च ते प्रवक्ष्यामि शृणुष्व गदतो मम ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003499022, "chapter_id": 23499, "verse_number": "१३९-२३", "content_sanskrit": "गायनं ये प्रकुर्वन्ति मम कर्मपरायणाः ।\nतेषां यद्यत्फलं भूमे शृणुष्व गदतो मम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003499023, "chapter_id": 23499, "verse_number": "१३९-२४", "content_sanskrit": "गीयमानस्य गीतस्य यावदक्षरपङ्क्तयः ।\nतावद्वर्षसहस्राणि इन्द्रलोके महीयते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003499024, "chapter_id": 23499, "verse_number": "१३९-२५", "content_sanskrit": "रूपवान्गुणवान् सिद्धः सर्ववेदविदां वरः ।\nनित्यं पश्यति तत्रस्थो देवराजं न संशयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003499025, "chapter_id": 23499, "verse_number": "१३९-२६", "content_sanskrit": "मद्भक्तश्चैव जायेत इन्द्रलोकपथे स्थितः ।\nसर्वकर्मगुणश्रेष्ठस्तत्रापि मम पूजकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003499026, "chapter_id": 23499, "verse_number": "१३९-२७", "content_sanskrit": "इन्द्रलोकात्परिभ्रष्टो मम गीतपरायणः ।\nनन्दनोपवने रम्ये रमन्देवगणैः सह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003499027, "chapter_id": 23499, "verse_number": "१३९-२८", "content_sanskrit": "ततः स भूमौ जायेत वैष्णवैः सह संस्थितः ।\nगायन्मम यशो नित्यं भक्त्या परमया युतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003499028, "chapter_id": 23499, "verse_number": "१३९-२९", "content_sanskrit": "मत्प्रसादात्स शुद्धात्मा मम लोकं हि गच्छति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003499029, "chapter_id": 23499, "verse_number": "१३९-३०", "content_sanskrit": "सूत उवाच ।\nतस्य तद्वचनं श्रुत्वा माधवस्य यशस्विनी ।\nकृताञ्जलिपुटा भूयः प्रत्युवाच वसुन्धरा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003499030, "chapter_id": 23499, "verse_number": "१३९-३१", "content_sanskrit": "धरण्युवाच ।\nअहो गीतप्रभावो वै यस्त्वया कीर्त्तितो महान्।\nके च गीतप्रभावेण सिद्धिं प्राप्ता महौजसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003499031, "chapter_id": 23499, "verse_number": "१३९-३२", "content_sanskrit": "वराह उवाच ।\nतत्रैव चाश्रमे भद्रे चाण्डालः कृतनिश्चयः ।\nदूराज्जागरणे याति मम भक्तौ व्यवस्थितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003499032, "chapter_id": 23499, "verse_number": "१३९-३३", "content_sanskrit": "गायमानश्च गीतानि संवत्सरगणान्बहून् ।\nश्वपाकः स गुणज्ञश्च मद्भक्तश्चैव सुन्दरि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003499033, "chapter_id": 23499, "verse_number": "१३९-३४", "content_sanskrit": "कौमुदस्य तु मासस्य शुक्लपक्षे तु द्वादशी ।\nसुप्ते गते येन जाते वीणामादाय चंक्रमत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003499034, "chapter_id": 23499, "verse_number": "१३९-३५", "content_sanskrit": "जाग्रंस्तत्र स चाण्डालो गृहीतो ब्रह्मरक्षसा ।\nअल्पप्राणः श्वपाको वै बलवान्ब्रह्मराक्षसः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003499035, "chapter_id": 23499, "verse_number": "१३९-३६", "content_sanskrit": "दुःखशोकेन सन्तप्तो न शक्नोति विचेष्टितुम् ।\nतेन प्रोक्तः श्वपाकेन बलवान्ब्रह्मराक्षसः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003499036, "chapter_id": 23499, "verse_number": "१३९-३७", "content_sanskrit": "किं त्वया चेष्टितं मह्यं यस्त्वेवं परिधावसि ।\nश्वपाकवचनं श्रुत्वा तेन वै ब्रह्मरक्षसा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003499037, "chapter_id": 23499, "verse_number": "१३९-३८", "content_sanskrit": "ततः प्रोवाच तं श्वादं मानुषाहारलोलुपः ।\nअथेह दशरात्रं मे निराहारस्य तिष्ठतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003499038, "chapter_id": 23499, "verse_number": "१३९-३९", "content_sanskrit": "विधात्रा विहितस्त्वं व आहारः पारणाविधौ ।\nअद्य तां भक्षयिष्यामि सवसामांसशोणितैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003499039, "chapter_id": 23499, "verse_number": "१३९-४०", "content_sanskrit": "तृप्तिं यास्यामि परमां विधात्रा विहितां मम ।\nब्रह्मरक्षोवचः श्रुत्वा श्वपाको गीतलालसः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003499040, "chapter_id": 23499, "verse_number": "१३९-४१", "content_sanskrit": "राक्षसं छन्दयामास मम भक्त्या व्यवस्थितः ।\nएवमेतन्महाभाग भक्ष्योऽहं समुपागतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003499041, "chapter_id": 23499, "verse_number": "१३९-४२", "content_sanskrit": "अवश्यमेतत्कर्तव्यं धात्रा दत्तं यथा तव ।\nकिं त्वहं देवदेवस्य भक्त्या गातुं च जागरे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003499042, "chapter_id": 23499, "verse_number": "१३९-४३", "content_sanskrit": "उद्यंस्तत्र गत्वाहमुपास्य विधिना हरिम् ।\nपश्चात्खादस्व मां रक्षो जागराद्विनिवर्तितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003499043, "chapter_id": 23499, "verse_number": "१३९-४४", "content_sanskrit": "विष्णोः सन्तोषणार्थाय यतो मे व्रतमास्थितम् ।\nजागरे विनिवृत्ते मां भक्षय त्वं यदीच्छति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003499044, "chapter_id": 23499, "verse_number": "१३९-४५", "content_sanskrit": "श्वपाकस्य वचः श्रुत्वा ब्रह्मरक्षः क्षुधार्दितः ।\nउवाच पुरुषं वाक्यं श्वपाकं तदनन्तरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003499045, "chapter_id": 23499, "verse_number": "१३९-४६", "content_sanskrit": "मिथ्या किं भाषसे मूढ पुनरेष्यामि तेऽन्तिकम् ।\nमृत्योर्मुखमनुप्राप्य पुनर्जीवति मानवः  ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003499046, "chapter_id": 23499, "verse_number": "१३९-४७", "content_sanskrit": "रक्षसो मुखविभ्रष्टः पुनरागन्तुमिच्छसि ।\nराक्षसस्य वचः श्रुत्वा चाण्डालस्तमथाब्रवीत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003499047, "chapter_id": 23499, "verse_number": "१३९-४८", "content_sanskrit": "यद्यप्यहं हि चाण्डालः पूर्वकर्मविदूषितः ।\nसम्प्राप्तो मानुषं भावं विहितेनान्तरात्मना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003499048, "chapter_id": 23499, "verse_number": "१३९-४९", "content_sanskrit": "शृणु मत्समयं रक्षो येनाहं पुनरागमम् ।\nदूराज्जागरणं कृत्वा लोकस्य द्विजराक्षस ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003499049, "chapter_id": 23499, "verse_number": "१३९-५०", "content_sanskrit": "सत्येन पुनरेष्यामि मन्यसे यदि मुंच माम् ।\nसत्यमूलं जगत्सर्वं लोकाः सत्ये प्रतिष्ठिताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003499050, "chapter_id": 23499, "verse_number": "१३९-५१", "content_sanskrit": "सत्येन सिद्धिं प्राप्ता हि ऋषयो ब्रह्मवादिनः ।\nसत्येन दीयते  कन्या सत्यं जल्पन्ति ब्राह्मणाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003499051, "chapter_id": 23499, "verse_number": "१३९-५२", "content_sanskrit": "सत्यं जयन्ति राजानस्त्रीण्येतान्यब्रुवन्नृतम् ।\nसत्येन गम्यते स्वर्गो मोक्षः सत्येन चाप्यते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003499052, "chapter_id": 23499, "verse_number": "१३९-५३", "content_sanskrit": "सत्येन तपते सूर्यः सोमः सत्येन रज्यते ।\nषष्ठ्यष्टमीममावास्यामुभे पक्षे चतुर्दशी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003499053, "chapter_id": 23499, "verse_number": "१३९-५४", "content_sanskrit": "अस्नातानां गतिं यास्ये यद्यहं नागमे पुनः।\nगुरुपत्नीं राजपत्नीं योऽभिगच्छति मोहितः॥ ५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003499054, "chapter_id": 23499, "verse_number": "१३९-५५", "content_sanskrit": "तां गतिं सम्प्रपद्येऽहं यद्यहं नागमे पुनः ।\nयाजकानां च ये लोका ये च मिथ्याभिभाषिणाम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003499055, "chapter_id": 23499, "verse_number": "१३९-५६", "content_sanskrit": "तां गतिं सम्प्रपद्येऽहं यद्यं नागमे पुनः ।\nब्रह्मघ्ने च सुरापे वा स्तेने भग्नव्रते तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003499056, "chapter_id": 23499, "verse_number": "१३९-५७", "content_sanskrit": "तेषां गतिं प्रपद्येऽहं यद्यहं नागमे पुनः ।\nश्वपाकवचनं श्रुत्वा तुष्टो ब्राह्मणराक्षसः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003499057, "chapter_id": 23499, "verse_number": "१३९-५८", "content_sanskrit": "उवाच मधुरं वाक्यं गच्छ शीघ्रं नमोऽस्तु ते ।\nब्रह्मराक्षसमुक्त्वा तु श्वपाकः कृतनिश्चयः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003499058, "chapter_id": 23499, "verse_number": "१३९-५९", "content_sanskrit": "पुनर्गायति मह्यं वै मम भक्तौ व्यवस्थितः ।\nअथ प्रभाते विमले गीते नृत्ये च जागरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003499059, "chapter_id": 23499, "verse_number": "१३९-६०", "content_sanskrit": "नमो नारायणायेति श्वपाकः परिवर्त्तते ।\nततस्त्वरितमागत्य पुमांस्तस्याग्रतः स्थितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003499060, "chapter_id": 23499, "verse_number": "१३९-६१", "content_sanskrit": "उवाच मधुरं वाक्यं चाण्डालं कृतनिश्चयम् ।\nक्व यासि त्वरितः साधो न च त्वं गन्तुमर्हसि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003499061, "chapter_id": 23499, "verse_number": "१३९-६२", "content_sanskrit": "जानन्कौणपपं तं च न त्वं मर्त्तुमिहार्हसि ।\nपुरुषस्य वचः श्रुत्वा चाण्डालः पुनरब्रवीत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003499062, "chapter_id": 23499, "verse_number": "१३९-६३", "content_sanskrit": "समयो मे कृतः पूर्वं राक्षसेन हि भक्षता ।\nतेन तत्र गमिष्यामि सत्यं च परिपालयन् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003499063, "chapter_id": 23499, "verse_number": "१३९-६४", "content_sanskrit": "ततः स पद्मपत्राक्षः श्वपाकं प्रत्युवाच ह ।\nमधुरां गिरमादाय विहितेनान्तरात्मना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003499064, "chapter_id": 23499, "verse_number": "१३९-६५", "content_sanskrit": "मा गच्छ तत्र चाण्डाल यत्रासौ पापराक्षसः ।\nजीवितार्थाय सत्यस्य न दोषः परिहापनात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003499065, "chapter_id": 23499, "verse_number": "१३९-६६", "content_sanskrit": "ततस्तस्य वचः श्रुत्वा श्वपाकः संशितव्रतः ।\nउवाच मधुरं वाक्यं मरणे कृतनिश्चयः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003499066, "chapter_id": 23499, "verse_number": "१३९-६७", "content_sanskrit": "नाहमेवं करिष्यामि यन्मां त्वं परिभाषसे ।\nन चाहं नाशये सत्यमेतन्मे निश्चितं व्रतम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003499067, "chapter_id": 23499, "verse_number": "१३९-६८", "content_sanskrit": "सत्यमूलं जगत्सर्वं कुलं सत्ये प्रतिष्ठितम् ।\nसत्यमेव परो धर्म आत्मा सत्ये प्रतिष्ठितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003499068, "chapter_id": 23499, "verse_number": "१३९-६९", "content_sanskrit": "न चैवाहं तदुत्सृज्य असत्यः स्यां कदाचन ।\nनाहं मिथ्या चरिष्यामि गच्छ तात नमोऽस्तु ते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003499069, "chapter_id": 23499, "verse_number": "१३९-७०", "content_sanskrit": "एवमुक्त्वा श्वपाकोपि नित्यं सत्यव्रते स्थितः ।\nराक्षसं समनुप्राप्तस्तमुवाचाथ पूजयन् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003499070, "chapter_id": 23499, "verse_number": "१३९-७१", "content_sanskrit": "आगतोऽस्मि महाभाग मा विलम्बय भक्षय ।\nत्वत्प्रसादादहं गन्ता वैष्णवं स्थानमुत्तमम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003499071, "chapter_id": 23499, "verse_number": "१३९-७२", "content_sanskrit": "एतानि मम गात्राणि भक्षयस्व यथेष्टतः ।\nपिबोष्णं रुधिरं मह्यं पीडितोऽसि क्षुधा भृशम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003499072, "chapter_id": 23499, "verse_number": "१३९-७३", "content_sanskrit": "तर्पयस्व स्वमात्मानं कुरुष्व मम वै हितम् ।\nश्वपाकस्य वचः श्रुत्वा ततः स ब्रह्मराक्षसः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003499073, "chapter_id": 23499, "verse_number": "१३९-७४", "content_sanskrit": "उवाच मधुरं वाक्यं श्वपाकं तदनन्तरम् ।\nसाधु तुष्टोऽस्म्यहं वत्स सत्यं धर्मं च पालितम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003499074, "chapter_id": 23499, "verse_number": "१३९-७५", "content_sanskrit": "चण्डालस्याविधिज्ञस्य यस्य ते मतिरीदृशी ।\nब्रह्मरक्षोवचः श्रुत्वा श्वपाकः सत्यसङ्गरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003499075, "chapter_id": 23499, "verse_number": "१३९-७६", "content_sanskrit": "उवाच मधुरं वाक्यं ब्रह्मराक्षसमेव तु ।\nयद्यप्यहं वै चाण्डालः सर्वकर्मविवर्जितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003499076, "chapter_id": 23499, "verse_number": "१३९-७७", "content_sanskrit": "तथापि सत्यं वक्तव्यं ब्रह्मराक्षस नित्यशः ।\nश्वपाकवचनं श्रुत्वा ब्रह्मरक्षो भयानकम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003499077, "chapter_id": 23499, "verse_number": "१३९-७८", "content_sanskrit": "उवाच मधुरं वाक्यं श्वपाकं संशितव्रतम् ।\nयत्त्वया गीयते रात्रौ विष्णोर्जागरणं प्रति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003499078, "chapter_id": 23499, "verse_number": "१३९-७९", "content_sanskrit": "फलं गीतस्य मे देहि यदीच्छेर्जीवितं स्वकम् ।\nततो मोक्ष्यामि कल्याण भक्ष्यामि न च भीषणः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003499079, "chapter_id": 23499, "verse_number": "१३९-८०", "content_sanskrit": "ब्रह्मरक्षोवचः श्रुत्वा श्वपाकः प्रत्युवाच ह।\nमनोऽज्ञातमिदं वाक्यं ब्रह्मरक्षो निभाषसे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003499080, "chapter_id": 23499, "verse_number": "१३९-८१", "content_sanskrit": "भक्षयामीति चोक्त्वा मां गीतपुण्यं किमिच्छसि ।\nश्वपाकवचनं श्रुत्वा ब्रह्मरक्षोऽब्रवीत्पुनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003499081, "chapter_id": 23499, "verse_number": "१३९-८२", "content_sanskrit": "देहि मे त्वेकयामीयं पुण्यं गीतस्य वै परम् ।\nततो मोक्ष्यसि भक्ष्येण संगतः पुत्रदारकैः॥ ८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003499082, "chapter_id": 23499, "verse_number": "१३९-८३", "content_sanskrit": "श्रुत्वा राक्षसवाक्यानि चाण्डालो गीतलोभितः ।\nउवाच मधुरं वाक्यं राक्षसं कृतनिश्चयः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003499083, "chapter_id": 23499, "verse_number": "१३९-८४", "content_sanskrit": "न गायनफलं दद्मि ब्रह्मरक्षस्तवेप्सितम् ।\nभक्षयस्व यथान्यायं रुधिरं पिब चेप्सितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003499084, "chapter_id": 23499, "verse_number": "१३९-८५", "content_sanskrit": "श्वपाकवचनं श्रुत्वा राक्षसः पुनरब्रवीत् ।\nएकगीतस्य मे देहि यत्त्वया विष्णुसंसदि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003499085, "chapter_id": 23499, "verse_number": "१३९-८६", "content_sanskrit": "एतेन तारितोऽस्मीति तव गीतफलेन वै ।\nश्रुत्वा वाक्यानि चाण्डालो राक्षसस्य निवारयन् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003499086, "chapter_id": 23499, "verse_number": "१३९-८७", "content_sanskrit": "उवाच मधुरं वाक्यं चाण्डालो विस्मयान्वितः ।\nकिं त्वया विकृतं कर्म तद्ब्रूहि मम राक्षस ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003499087, "chapter_id": 23499, "verse_number": "१३९-८८", "content_sanskrit": "कर्मणो यस्य दोषेण राक्षसत्वं समागतः ।\nश्वपाकवचनं श्रुत्वा ब्रह्मरक्षो महायशाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003499088, "chapter_id": 23499, "verse_number": "१३९-८९", "content_sanskrit": "&nbsp;उवाच मधुरं वाक्यं दुःखसन्तप्तमानसः ।\nनाम्ना वै सोमशर्माहं चरको ब्रह्मयोनिजः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003499089, "chapter_id": 23499, "verse_number": "१३९-९०", "content_sanskrit": "सूत्रमन्त्रपरिभ्रष्टो यज्ञकर्मसु निष्ठितः ।\nततोऽहं याजयाम्यज्ञान् लोभमोहप्रपीडितः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003499090, "chapter_id": 23499, "verse_number": "१३९-९१", "content_sanskrit": "प्रवर्तमाने यज्ञे तु कदाचिद्दैवयोगतः ।\nउदरे जातशूलोऽहं तेन पंचत्वमागतः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003499091, "chapter_id": 23499, "verse_number": "१३९-९२", "content_sanskrit": "अथ पञ्चमहारात्रे ह्यसमाप्ते क्रतौ तथा ।\nअस्य यज्ञस्य दोषेण मातंग शृणु मे वचः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003499092, "chapter_id": 23499, "verse_number": "१३९-९३", "content_sanskrit": "राक्षसत्वमनुप्राप्तस्तेन दुष्टेन कर्मणा ।\nमंत्रहीनं मया तत्र स्वरहीनं च तत्कृतम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003499093, "chapter_id": 23499, "verse_number": "१३९-९४", "content_sanskrit": "सूत्रहीनं तथा तत्र प्राग्वंशादि कृतं मया ।\nपरिमाणं च रूपं च मया तत्रोपलक्षितम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003499094, "chapter_id": 23499, "verse_number": "१३९-९५", "content_sanskrit": "कृतस्य तस्य दोषेण योनिं प्राप्तोऽस्मि राक्षसीम् ।\nस्वगीतफलदानेन निस्तारयितुमर्हसि ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003499095, "chapter_id": 23499, "verse_number": "१३९-९६", "content_sanskrit": "मोचयस्वाधमं पापाद्विष्णुगीतेन सत्वरम् ।\nब्रह्मरक्षोवचः श्रुत्वा श्वपाकः संशितव्रतः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003499096, "chapter_id": 23499, "verse_number": "१३९-९७", "content_sanskrit": "बाढमित्येव तद्वाक्यं राक्षसं प्राब्रवीत्तदा ।\nएतस्य मम गीतस्य सुस्वरस्य फलं तु यत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003499097, "chapter_id": 23499, "verse_number": "१३९-९८", "content_sanskrit": "ददामि राक्षस त्वं चेन्मुच्यसे शुद्धमानसः ।\nयस्तु गायति संयुक्तं गीतकं विष्णुसन्निधौ ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003499098, "chapter_id": 23499, "verse_number": "१३९-९९", "content_sanskrit": "स तारयति दुर्गाणीत्युक्त्वा तद्दत्तवान् फलम् ।\nएवं तस्मात्फलं प्राप्य श्वपाकाद्राक्षसस्तदा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003499099, "chapter_id": 23499, "verse_number": "१३९-१००", "content_sanskrit": "जातः सुविमलो भद्रे शरदीव यथा शशी ।\nश्वपकश्चापि सुश्रोणि मम चैवोपगायकः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003499100, "chapter_id": 23499, "verse_number": "१३९-१०१", "content_sanskrit": "कृत्वा सुविपुलं कर्म स ब्रह्मत्वमुपागतः ।\nएतद्गीतफलं देवि प्राप्नोति मनुजो भुवि ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003499101, "chapter_id": 23499, "verse_number": "१३९-१०२", "content_sanskrit": "मह्यं जागरतो भद्रे गीयमानं मनस्विनि ।\nयस्तु गायति सुश्रोणि कौमुदीं द्वादशीं प्रति ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003499102, "chapter_id": 23499, "verse_number": "१३९-१०३", "content_sanskrit": "सर्वसंगं परित्यज्य मम लोकं स गच्छति ।\nयस्तु गायति गीतानि मम जागरणे सदा ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003499103, "chapter_id": 23499, "verse_number": "१३९-१०४", "content_sanskrit": "सर्वसंगात्प्रमुक्तो वै मम लोकं स गच्छति ।\nएतत्ते कथितं देवि गायनस्य फलं महत् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003499104, "chapter_id": 23499, "verse_number": "१३९-१०५", "content_sanskrit": "यस्य गीतस्य शब्देन तरेत्संसारसागरम् ।\nवादित्रस्य प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003499105, "chapter_id": 23499, "verse_number": "१३९-१०६", "content_sanskrit": "प्राप्तवान्मानुषो येन देवेभ्यः सबलां स्वयम् ।\nशम्पातालप्रयोगेण सन्निपातेन वा पुनः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003499106, "chapter_id": 23499, "verse_number": "१३९-१०७", "content_sanskrit": "नववर्षसहस्राणि नववर्षशतानि च ।\nकुबेरभवनं गत्वा मोदते वै यदृच्छया ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003499107, "chapter_id": 23499, "verse_number": "१३९-१०८", "content_sanskrit": "कुबेरभवनाद्भ्रष्टः स्वच्छन्दगमनालयः ।\nशम्यादितालसम्पातैर्मम लोकं स गच्छति ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003499108, "chapter_id": 23499, "verse_number": "१३९-१०९", "content_sanskrit": "नृत्यमानस्य वक्ष्यामि तच्छृणुष्व वसुन्धरे।.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003499109, "chapter_id": 23499, "verse_number": "१३९-११०", "content_sanskrit": "मानवो येन गच्छेत्तु च्छित्त्वा संसारबन्धनम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003499110, "chapter_id": 23499, "verse_number": "१३९-१११", "content_sanskrit": "त्रिंशद्वर्षसहस्राणि त्रिंशद्वर्षशतानि च ।\nपुष्करद्वीपमासाद्य स्वच्छन्दगमनालयः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003499111, "chapter_id": 23499, "verse_number": "१३९-११२", "content_sanskrit": "फलं प्राप्नोति सुश्रोणि मम कर्मपरायणः ।\nरूपवान् गुणवाञ्छूरः शीलवान्सत्पथे स्थितः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003499112, "chapter_id": 23499, "verse_number": "१३९-११३", "content_sanskrit": "मद्भक्तश्चैव जायेत संसारपरिमोचितः ।\nयस्तु जागरितो नित्यं गीतवाद्येन नर्त्तकः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003499113, "chapter_id": 23499, "verse_number": "१३९-११४", "content_sanskrit": "जम्बूद्वीपं समासाद्य राजराजस्तु जायते ।\nसर्वकर्मसमायुक्तो रक्षिता वै महीपतिः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003499114, "chapter_id": 23499, "verse_number": "१३९-११५", "content_sanskrit": "मद्भक्तश्चैव जायेत मम कर्मपरायणः ।\nउपहार्याणि पुष्पाणि मम कर्मपरायणः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003499115, "chapter_id": 23499, "verse_number": "१३९-११६", "content_sanskrit": "यो मामुपनयेद्भूमे मम कर्मपथे स्थितः ।\nपुष्पाणि तत्र यावन्ति मम मूर्द्धनि धारयेत् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003499116, "chapter_id": 23499, "verse_number": "१३९-११७", "content_sanskrit": "स कृत्वा पुष्कलं कर्म मम लोकं स गच्छति ।\nएतत्ते कथितं देवि भक्तानां तु महौजसाम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003499117, "chapter_id": 23499, "verse_number": "१३९-११८", "content_sanskrit": "मम भक्तसुखार्थाय सर्वसंसारमोक्षणम् ।\nय एतत्पठते भूमे कल्यमुत्थाय मानवः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003499118, "chapter_id": 23499, "verse_number": "१३९-११९", "content_sanskrit": "स तु तारयते जन्तुर्दश पूर्वान्दशापरान् ।\nन पठेन्मूर्खमध्ये तु पिशुनानां पुरो न च ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003499119, "chapter_id": 23499, "verse_number": "१३९-१२०", "content_sanskrit": "पठेद्भागवतानां च मध्ये मुक्तिरतात्मनाम् ।\nअश्रद्दधाने क्रूरे वा न पठेद्देवले तथा ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003499120, "chapter_id": 23499, "verse_number": "१३९-१२१", "content_sanskrit": "यदीच्छेत्सिद्धिकल्याणं मंगलं च मम प्रियम् ।\nधर्माणां परमो धर्मः क्रियाणां परमा क्रिया ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003499121, "chapter_id": 23499, "verse_number": "१३९-१२२", "content_sanskrit": "मा पठेच्छास्त्रदूषाय अध्यायं वा कदाचन ।\nयदीच्छेत्परमां सिद्धिं मम लोके महीयते ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}]