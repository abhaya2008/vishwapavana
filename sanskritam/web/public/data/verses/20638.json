[{"id": 7000638000, "chapter_id": 20638, "verse_number": "५-९७-१", "content_sanskrit": "ब्राह्मण उवाच ।\nएतन्मूर्खोऽपि जानाति शुभकर्मकरः पुमान् ।\nन याति नरकं स्वर्गं तथा पापक्रिया रतः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000638001, "chapter_id": 20638, "verse_number": "५-९७-२", "content_sanskrit": "क्रतुभिर्विविधैरिष्टैर्व्रत दान जपादिभिः ।\nसत्येनाचारकुशलैः स्वर्गसौख्यमवाप्यते ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000638002, "chapter_id": 20638, "verse_number": "५-९७-३", "content_sanskrit": "विद्याचारधनोपेतैरृषिभिर्वेदपारगैः ।\nप्राप्यते पुण्ययोगेन यज्ञैर्नाकस्ततः क्वचित् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000638003, "chapter_id": 20638, "verse_number": "५-९७-४", "content_sanskrit": "वित्तेन च विना दानं बहुदातुं न शक्यते ।\nविद्यमान धनेनापि कुटुंबासक्तचेतसा ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000638004, "chapter_id": 20638, "verse_number": "५-९७-५", "content_sanskrit": "अग्निहोत्रादयो धर्मा विशेषेण कलौ युगे ।\nदुष्करा दानधर्मोऽपि दुष्करो भगवन्मतः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000638005, "chapter_id": 20638, "verse_number": "५-९७-६", "content_sanskrit": "अल्पायासेन धर्मेण लभ्यते धर्मसंचयः ।\nतन्मे विशेषतो ब्रूहि धर्माधर्मप्रदर्शक ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000638006, "chapter_id": 20638, "verse_number": "५-९७-७", "content_sanskrit": "तदेकं कथ्यतां धर्मं सर्वधर्मोत्तमोत्तमम् ।\nकृतेनैकेन येनेह सर्वपापक्षयो भवेत् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000638007, "chapter_id": 20638, "verse_number": "५-९७-८", "content_sanskrit": "धनं धान्यं यशो धर्ममायुर्येनाभि वर्त्तते ।\nमर्त्यलोकेऽपि सख्यं स्यात्स्वर्गो येनाक्षयो भवेत् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000638008, "chapter_id": 20638, "verse_number": "५-९७-९", "content_sanskrit": "साक्षान्नारायणो येन भक्तानामभयप्रदः ।\nतुष्येदस्यप्रसादेन कामः करतले स्थितः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000638009, "chapter_id": 20638, "verse_number": "५-९७-१०", "content_sanskrit": "सर्वयज्ञ तपोदानतीर्थसेवाधिकं फलम् ।\nलभ्यते येन यद्यस्ति वैवस्वत तदादिश ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000638010, "chapter_id": 20638, "verse_number": "५-९७-११", "content_sanskrit": "अनुग्राह्यो ह्यहं देव यदि धर्मोपदेशतः ।\nसर्वधर्मक्रियासारं तदेकं कृपया वद ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000638011, "chapter_id": 20638, "verse_number": "५-९७-१२", "content_sanskrit": "पापानामनुरूपाणि प्रायश्चित्तानि यद्यथा ।\nतथा तथैव संस्मृत्य कथितानि मनीषिभिः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000638012, "chapter_id": 20638, "verse_number": "५-९७-१३", "content_sanskrit": "कर्तुं तानि न शक्यंते देव प्रत्येकशो नरैः ।\nसर्वपापहरं पुण्यमेकं चेदस्ति तद्वद ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000638013, "chapter_id": 20638, "verse_number": "५-९७-१४", "content_sanskrit": "सूत उवाच ।\nइत्युक्त्वा ब्राह्मणश्रेष्ठो यमं धर्मस्वरूपिणम् ।\nतुष्टाव प्रयतो भूत्वा सूक्ष्मधर्माभिकामुकः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000638014, "chapter_id": 20638, "verse_number": "५-९७-१५", "content_sanskrit": "ब्राह्मण उवाच ।\nनमस्ते सर्वशमन नमस्ते जगतांपते ।\nनमोऽस्तु देवरूपाय स्वर्गमार्गप्रदायिने ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000638015, "chapter_id": 20638, "verse_number": "५-९७-१६", "content_sanskrit": "धर्मशास्त्रस्वरूपाय धर्मराज नमोस्तुते ।\nत्वया भूः पाल्यते देवाप्यंतरिक्षं च द्यौर्महः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000638016, "chapter_id": 20638, "verse_number": "५-९७-१७", "content_sanskrit": "जनस्तपस्तथासत्यं सर्वस्वं पाल्यते त्वया ।\nन त्वया रहितं किंचिज्जगत्स्थावर जंगमम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000638017, "chapter_id": 20638, "verse_number": "५-९७-१८", "content_sanskrit": "विद्यते त्वद्गृहीतं तु सद्यो नश्यति वै जगत् ।\nत्वमात्मा सर्वभूतानां सतां सत्वस्वरूपवान् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000638018, "chapter_id": 20638, "verse_number": "५-९७-१९", "content_sanskrit": "राजसानां रजस्त्वं च तामसानां तमस्तथा ।\nचतुष्पदां भवान्देव चतुःशृंगस्त्रिलोचनः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000638019, "chapter_id": 20638, "verse_number": "५-९७-२०", "content_sanskrit": "सप्तहस्तस्त्रिधा बद्धो वृषरूप नमोस्तु ते ।\nसर्वयज्ञमयो धर्मस्त्वयि विग्रहविग्रहः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000638020, "chapter_id": 20638, "verse_number": "५-९७-२१", "content_sanskrit": "साक्षाद्दृष्टोसि लोकेश देव तुभ्यं नमोनमः ।\nहृदिस्थः सर्वभूतानां पुण्यपापेक्षिता भवान् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000638021, "chapter_id": 20638, "verse_number": "५-९७-२२", "content_sanskrit": "तेन शास्ता च भूतानां दाता देव प्रशासिता ।\nप्रवर्त्तको हि धर्मस्य देवदंडधरो भुवि ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000638022, "chapter_id": 20638, "verse_number": "५-९७-२३", "content_sanskrit": "सर्वधर्ममयं सारमेकं वद सुनिश्चितम् ।\nयम उवाच ।\nपरितुष्टोऽस्मि ते विप्र स्तोत्रेण च विशेषतः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000638023, "chapter_id": 20638, "verse_number": "५-९७-२४", "content_sanskrit": "तथाप्यागम धर्मेण मान्योसि मम सत्तम ।\nयन्न कस्यचिदाख्यातं तद्गोप्यं परमं मम ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000638024, "chapter_id": 20638, "verse_number": "५-९७-२५", "content_sanskrit": "सारमुद्धृत्य सर्वेषां यदेकं निश्चितं मया ।\nमहानिरयसंघातान्निर्वासनकरं परम् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000638025, "chapter_id": 20638, "verse_number": "५-९७-२६", "content_sanskrit": "अनाख्येयमपि ब्रह्मन्वक्ष्ये विनयतोषितः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000638026, "chapter_id": 20638, "verse_number": "५-९७-२७", "content_sanskrit": "स्युर्मोहाय चराचरस्य जगतस्ते ते पुराणागमास्तां तामेव हि देवतां परमिकां जल्पंतु कल्पे विधौ ।\nसिद्धांते पुनरेक एव भगवान्विष्णुः समस्तागम ।\nव्यापारेषु विवेकिनां व्यतिकरं नीतेषु निश्चीयते ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000638027, "chapter_id": 20638, "verse_number": "५-९७-२८", "content_sanskrit": "भवो ब्रह्मा च विष्णुश्च त्रयमेव त्रयी मता ।\nदीपोऽग्निर्वर्तिस्नेहैस्तु यथा विप्र तथा हरिः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000638028, "chapter_id": 20638, "verse_number": "५-९७-२९", "content_sanskrit": "समाराध्य हरिं भक्त्या गोलोकान्प्राप्नुयाच्छुभान् ।\nआराधिते हरौ कामाः सर्वे करतले स्थिताः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000638029, "chapter_id": 20638, "verse_number": "५-९७-३०", "content_sanskrit": "दानमेव परं श्रेष्ठं सर्वपुण्येषु वै द्विज ।\nदानेन नश्यते पापं सर्वं दानेन लभ्यते ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000638030, "chapter_id": 20638, "verse_number": "५-९७-३१", "content_sanskrit": "नित्यं नैमित्तिकं काम्यमन्यदभ्युदयात्मकम् ।\nअन्यं च परमं दानमिति पंचविधं स्मृतम् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000638031, "chapter_id": 20638, "verse_number": "५-९७-३२", "content_sanskrit": "प्रातर्मध्यापराह्णेषु त्रिषु कालेषु यत्नतः ।\nयत्किंचिदपि दातव्यं नित्यमेव प्रकीर्तितम् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000638032, "chapter_id": 20638, "verse_number": "५-९७-३३", "content_sanskrit": "शून्यं दिनं न कर्तव्यमात्मार्थं हितमिच्छताम् ।\nयस्मिन्कुले तु दत्तं यत्तत्रतत्रोपतिष्ठति ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000638033, "chapter_id": 20638, "verse_number": "५-९७-३४", "content_sanskrit": "यः स्वयं भक्षयेन्मोहाददत्वा बुद्धिवर्जितः ।\nउत्पादयाम्यहं रोगं तस्य भोगनिवारणम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000638034, "chapter_id": 20638, "verse_number": "५-९७-३५", "content_sanskrit": "तेषु कार्येषु संतुष्टं बहुपीडाप्रदायकम् ।\nमंदानलेन संयुक्तं द्वारं संतापकारकम् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000638035, "chapter_id": 20638, "verse_number": "५-९७-३६", "content_sanskrit": "त्रिषु कालेषु नो दत्तं ब्राह्मणेषु सुरेषु यैः ।\nस्वयं तु भुंजते मिष्टं पापं तैस्तु महत्कृतम् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000638036, "chapter_id": 20638, "verse_number": "५-९७-३७", "content_sanskrit": "प्रायश्चित्तेन रौद्रेण तानहं परिशोधये ।\nउपवासैर्महीदेव कायशोषकरादिकैः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000638037, "chapter_id": 20638, "verse_number": "५-९७-३८", "content_sanskrit": "चर्मकारो यथा चर्मकुंडस्योपरि निर्घृणे ।\nशोधयेच्च कशाद्यैश्च कुद्रव्यं स्फोटयेद्यथा ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000638038, "chapter_id": 20638, "verse_number": "५-९७-३९", "content_sanskrit": "तथाहं पापकर्तारं शोधयामि न संशयः ।\nऔषधीनां सुयोगैश्च कषायैः कटुकैर्ध्रुवम् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000638039, "chapter_id": 20638, "verse_number": "५-९७-४०", "content_sanskrit": "उष्णोदकैश्च संतापैर्वैद्यरूपेण नान्यथा ।\nअन्ये भुंजंति तस्याग्रे भोगानन्यान्मनोगतान् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000638040, "chapter_id": 20638, "verse_number": "५-९७-४१", "content_sanskrit": "किं करोमि समर्थश्च न दत्तं दानमुत्तमम् ।\nमहता रोगरूपेण तमेनं परिवारयेत् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000638041, "chapter_id": 20638, "verse_number": "५-९७-४२", "content_sanskrit": "नित्यकालस्य यद्दानमात्मानं पापिभिर्यथा ।\nन दत्तं च महीदेव श्रद्धया निजशक्तितः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000638042, "chapter_id": 20638, "verse_number": "५-९७-४३", "content_sanskrit": "तथायातान्प्रधक्ष्येतानुपायैर्दारुणैः किल ।\nनैमित्तिकं प्रवक्ष्यामि दानकालं तवाग्रतः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000638043, "chapter_id": 20638, "verse_number": "५-९७-४४", "content_sanskrit": "महापर्वणि संप्राप्ते तीर्थप्राप्तौ तथैव च ।\nपितुः क्षयाहदिवसे वैशाखादिषु यत्नतः ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000638044, "chapter_id": 20638, "verse_number": "५-९७-४५", "content_sanskrit": "मासेषु पुण्यकालेषु दानं नैमित्तिकं स्मृतम् ।\nकाम्यकालं प्रवक्ष्यामि यद्दानं फलदायकम् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000638045, "chapter_id": 20638, "verse_number": "५-९७-४६", "content_sanskrit": "व्रतादिकं समुद्दिश्य कामनाफलकल्पितम् ।\nयत्कामं कथितं सम्यक्सर्वांगैरेव संगतम् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000638046, "chapter_id": 20638, "verse_number": "५-९७-४७", "content_sanskrit": "तस्य दानप्रभावेण भावनापरिभावितः ।\nतादृक्फलं समश्नाति मानुषस्तत्प्रसादनात् ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000638047, "chapter_id": 20638, "verse_number": "५-९७-४८", "content_sanskrit": "आभ्युदयं प्रवक्ष्यामि यच्च यज्ञादिषु स्मृतम् ।\nजातकर्मादिकार्येषु मौञ्ज्याद्युद्वाहकर्मसु ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000638048, "chapter_id": 20638, "verse_number": "५-९७-४९", "content_sanskrit": "प्रासादध्वजदेवानां प्रतिष्ठासु प्रयत्नतः ।\nइत्यादिकं महीदेव दानमभ्युदयात्मकम् ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000638049, "chapter_id": 20638, "verse_number": "५-९७-५०", "content_sanskrit": "प्रजावृद्धिकरं भोगयशःस्वर्गसुखप्रदम् ।\nअंत्यं चैव प्रवक्ष्यामि शृणु दानं द्विजोत्तम ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000638050, "chapter_id": 20638, "verse_number": "५-९७-५१", "content_sanskrit": "कामस्य संक्षयं ज्ञात्वा जरया परिपीडितः ।\nदद्याद्दानानि यत्नेन कुर्यादाशां न कस्यचित् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000638051, "chapter_id": 20638, "verse_number": "५-९७-५२", "content_sanskrit": "मृते च मयि मे पुत्रा जायाबांधवसोदराः ।\nकथमेते भविष्यंति मां विना सुहृदो मम ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000638052, "chapter_id": 20638, "verse_number": "५-९७-५३", "content_sanskrit": "अहं वित्तविहीनो वा कथं जीवन्पुनस्तथा ।\nभविष्यामीति विज्ञाय न ददाति हि किंचन ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000638053, "chapter_id": 20638, "verse_number": "५-९७-५४", "content_sanskrit": "आशापाशशतैर्बद्धो भाग्यादेव कुमायया ।\nमृत्युं प्रयाति मूढात्मा रुदंति च ततः सुताः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000638054, "chapter_id": 20638, "verse_number": "५-९७-५५", "content_sanskrit": "दुःखेन पीडिताः किचिंन्मोहेनाकुलचेतसः ।\nस्वल्पमल्पं च वा दानं कथंचित्कल्पयंति ते ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000638055, "chapter_id": 20638, "verse_number": "५-९७-५६", "content_sanskrit": "न तत्रास्मिन्गते काले महादुःखगते सति ।\nविस्मरंति तदा दानं लोभाद्वा न ददत्यपि ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000638056, "chapter_id": 20638, "verse_number": "५-९७-५७", "content_sanskrit": "मृतोऽयं च पिता ज्ञात्वा स्नेहपाशो निवर्त्तते ।\nयोऽसौ मृतो महीदेव मम पाशैर्नियंत्रितः ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000638057, "chapter_id": 20638, "verse_number": "५-९७-५८", "content_sanskrit": "तृष्णा क्षुधा समाक्रांतो बहुदुःखैः प्रपीडितः ।\nपच्यते नरके घोरे चिरकालं न संशयः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000638058, "chapter_id": 20638, "verse_number": "५-९७-५९", "content_sanskrit": "तस्माद्दानं प्रदातव्यं स्वयमेव न संशयः ।\nकस्य पुत्राश्च पौत्राश्च कस्य भार्या धनं च वा ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000638059, "chapter_id": 20638, "verse_number": "५-९७-६०", "content_sanskrit": "संसारे नास्तिकः कस्य स्वयं तस्मात्प्रदीयते ।\nपानमन्नं च तांबूलमुदकं कांचनं तथा ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000638060, "chapter_id": 20638, "verse_number": "५-९७-६१", "content_sanskrit": "वसनं गां च भूमिं च च्छत्रपात्राण्यनेकधा ।\nफलानि भूमिदानानि विविधानि स्वशक्तितः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000638061, "chapter_id": 20638, "verse_number": "५-९७-६२", "content_sanskrit": "दातव्यानि महीदेव नात्र कार्या विचारणा ।\nतीर्थानां लक्षणं विप्र प्रवक्ष्यामि तवाग्रतः ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000638062, "chapter_id": 20638, "verse_number": "५-९७-६३", "content_sanskrit": "सुतीर्थानि इयं गंगा भाति पुण्या सरस्वती ।\nरेवा च यमुना तापी नदी चर्मण्वती तथा ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000638063, "chapter_id": 20638, "verse_number": "५-९७-६४", "content_sanskrit": "सरयू च वरा वेणी पूर्णा पापप्रणाशिनी ।\nकावेरी कपिला चान्या विशल्या विश्वतारिणी ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000638064, "chapter_id": 20638, "verse_number": "५-९७-६५", "content_sanskrit": "गोदावरी समाख्याता तुंगभद्रा च गंडकी ।\nपापानां भीतिदा नित्यं नदी भीमरथी स्मृता ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000638065, "chapter_id": 20638, "verse_number": "५-९७-६६", "content_sanskrit": "देविका कृष्णगंगा च अन्या याः सरितांवराः ।\nएतास्तु पुण्यकालेषु संति तीर्थान्यनेकशः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000638066, "chapter_id": 20638, "verse_number": "५-९७-६७", "content_sanskrit": "ग्रामे वा यदि वारण्ये नद्यः सर्वत्र पावनाः ।\nतत्र तत्रैव कर्त्तव्याः स्नानदानादिकाः क्रियाः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000638067, "chapter_id": 20638, "verse_number": "५-९७-६८", "content_sanskrit": "यदा न ज्ञायते नाम तस्य तीर्थस्य भो द्विज ।\nतत्रेत्युच्चारणं कार्यं विष्णुतीर्थमिदं महत् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000638068, "chapter_id": 20638, "verse_number": "५-९७-६९", "content_sanskrit": "तीर्थस्य देवता विष्णुःस र्वत्रापि न संशयः ।\nनारायणेति यन्नाम स्मरेत्तीर्थेषु साधकः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000638069, "chapter_id": 20638, "verse_number": "५-९७-७०", "content_sanskrit": "तस्य तीर्थफलं सम्यग्विष्णुनाम्नैव जायते ।\nअज्ञातानां च तीर्थानां देवतानां न संशयः ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000638070, "chapter_id": 20638, "verse_number": "५-९७-७१", "content_sanskrit": "विष्णुनाम्नैव नामानि मानवः परिकीर्तयेत् ।\nसर्वास्तु सिद्धयः पुण्यास्तीर्थभूतास्तु सागरः ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000638071, "chapter_id": 20638, "verse_number": "५-९७-७२", "content_sanskrit": "सरांसि मानसादीनि निर्झराः पल्वलादयः ।\nस्वल्पा नद्योऽपि सर्वास्तास्तीर्थानि हरिनामतः ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000638072, "chapter_id": 20638, "verse_number": "५-९७-७३", "content_sanskrit": "पर्वतास्तीर्थरूपाश्च यज्ञो यज्ञमही तथा ।\nब्राह्मणा यत्र विद्वांसः कौतुकेनाप्यवस्थिताः ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000638073, "chapter_id": 20638, "verse_number": "५-९७-७४", "content_sanskrit": "तदेव तीर्थं सुमहत्सर्वपापहरं स्मृतम् ।\nश्राद्धं च श्राद्धभूमिश्च देवशाला च होमभूः ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000638074, "chapter_id": 20638, "verse_number": "५-९७-७५", "content_sanskrit": "यत्र वेदध्वनिः सम्यग्यत्र विष्णुकथाः शुभाः ।\nस्वगृहं पुण्यसंयुक्तं गोस्थानमपि पावनम् ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000638075, "chapter_id": 20638, "verse_number": "५-९७-७६", "content_sanskrit": "यत्राश्वत्थ तरु वने यत्रागारोपि पावनः ।\nएवमादीनि तीर्थानि पिता माता तथैव च ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000638076, "chapter_id": 20638, "verse_number": "५-९७-७७", "content_sanskrit": "पच्यते यत्र धर्मार्थं स्वयं तत्र गुरुः स्थितः ।\nसाध्वी यत्रास्ति वै भार्या तत्र तीर्थं न संशयः ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000638077, "chapter_id": 20638, "verse_number": "५-९७-७८", "content_sanskrit": "यत्र धर्मरतिर्नित्यं विद्वान्पुत्रः प्रवर्तते ।\nतत्र तस्य हि तत्तीर्थं तारणाय प्रतिष्ठितम् ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000638078, "chapter_id": 20638, "verse_number": "५-९७-७९", "content_sanskrit": "इत्येवमादि तीर्थानि राजवेश्म तथैव च ।\nएवमादिषु तीर्थेषु पर्वयोगाद्विशेषतः ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000638079, "chapter_id": 20638, "verse_number": "५-९७-८०", "content_sanskrit": "अनाराध्य हृषीकेशं सर्वदं सर्वदेहिनाम् ।\nकोपि क्वापि किमप्यत्र न लभेतेति निश्चितम् ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000638080, "chapter_id": 20638, "verse_number": "५-९७-८१", "content_sanskrit": "अपत्यं द्रविणं दारास्तारहर्म्यं हया गजाः ।\nसुखानि स्वर्गमोक्षौ च न दूरे हरिभक्तितः ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000638081, "chapter_id": 20638, "verse_number": "५-९७-८२", "content_sanskrit": "नारायणः परो देवः सत्यरूपो जनार्दनः ।\nत्रिधात्मानंसभगवान्ससर्जपरमेश्वरः ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000638082, "chapter_id": 20638, "verse_number": "५-९७-८३", "content_sanskrit": "रजस्तमोभ्यांयुक्तोऽभूद्रजःसत्वाधिकंविभुः ।\nससर्जनाभिकमलेब्रह्माणंकमलासनम् ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000638083, "chapter_id": 20638, "verse_number": "५-९७-८४", "content_sanskrit": "रजसा तमसा जुष्टं स रुद्रमसृजद्विभुः ।\nसत्वं रजस्तमश्चैव त्रितयं चैतदुच्यते ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000638084, "chapter_id": 20638, "verse_number": "५-९७-८५", "content_sanskrit": "सत्वेन मुच्यते जंतुः सत्वं नारायणात्मकम् ।\nरजसा सत्वयुक्तेन भवेच्छ्रीमान्यशोधिकः ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000638085, "chapter_id": 20638, "verse_number": "५-९७-८६", "content_sanskrit": "यद्वेदवाक्यं धर्मस्य समुद्दिश्योपसेवते ।\nतद्रुद्रमिति विख्यातं विशिष्टं गदितं नृणाम् ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000638086, "chapter_id": 20638, "verse_number": "५-९७-८७", "content_sanskrit": "तेन राजा भवेल्लोके रजसा तमसा पुनः ।\nयद्धीनं रजसा धर्मं केवलं तामसं च यत् ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000638087, "chapter_id": 20638, "verse_number": "५-९७-८८", "content_sanskrit": "तच्च दुर्गतिदं नॄणामिहलोके परत्र च ।\nयो विष्णुः स स्वयं ब्रह्मा यो ब्रह्मा स स्वयं हरः ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000638088, "chapter_id": 20638, "verse_number": "५-९७-८९", "content_sanskrit": "देवास्त्रयोपि यज्ञेऽस्मिन्निज्या देवेषु नित्यशः ।\nयो भेदं कुरुते तेषां त्रयाणां द्विजसत्तमः ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000638089, "chapter_id": 20638, "verse_number": "५-९७-९०", "content_sanskrit": "स पापकारी पापात्मा अनिष्टां गतिमाप्नुयात् ।\nविष्णुरेव परं ब्रह्म विष्णुरेव जगद्द्विज ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000638090, "chapter_id": 20638, "verse_number": "५-९७-९१", "content_sanskrit": "तस्यायं माधवो मासः प्रियः सर्वेषु कर्मसु ।\nकीर्त्यते हयमेधादि महाक्रतुफलप्रदः ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000638091, "chapter_id": 20638, "verse_number": "५-९७-९२", "content_sanskrit": "तीर्थस्नान तपो दान जप यज्ञफलाधिकः ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000638092, "chapter_id": 20638, "verse_number": "५-९७-९३", "content_sanskrit": "स्नानं विभाते नियमेन नद्यामनारतं मेषगते रवौ ये ।\nकुर्वंति येऽस्मिन्नपि विप्रपूजां मद्दंडभाजो न हि ते भवंति ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000638093, "chapter_id": 20638, "verse_number": "५-९७-९४", "content_sanskrit": "हत्वा हत्वा किंकरौघं पुरो मे लुप्त्वा लुप्त्वा चित्रगुप्तस्य लेख्यम् ।\nस्नात्वा स्नात्वा माधवे मासि तीर्थे पूर्वान्पूर्वानुद्धरंतीह पापात् ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000638094, "chapter_id": 20638, "verse_number": "५-९७-९५", "content_sanskrit": "इदं भयच्छेदकरं न तस्मात्प्रकाशनीयं परमं रहस्यम् ।\nनिर्वासहेतुर्नरकालयस्य ममाधिकारक्षयकारणं तत् ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000638095, "chapter_id": 20638, "verse_number": "५-९७-९६", "content_sanskrit": "भागीरथीनर्मदा च यमुना च सरस्वती ।\nविशोका च वितस्ता च विंध्यस्योत्तरतः स्थिताः ॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000638096, "chapter_id": 20638, "verse_number": "५-९७-९७", "content_sanskrit": "गोदावरी भीमरथी तुंगभद्रा च देविका ।\nतापी पयोष्णी विंध्यस्य दक्षिणास्तु प्रकीर्तिताः ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000638097, "chapter_id": 20638, "verse_number": "५-९७-९८", "content_sanskrit": "द्वादशैता महानद्यो नित्यं तेनावगाहिताः ।\nवैशाखे विधिना स्नानं नद्यां यः प्रातराचरेत् ॥९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000638098, "chapter_id": 20638, "verse_number": "५-९७-९९", "content_sanskrit": "सर्वाः समुद्रगाः पुण्याः सर्वे पुण्या नगोत्तमाः ।\nसर्वे चायतनाः पुण्याः सर्वे पुण्या वनाश्रयाः ॥९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000638099, "chapter_id": 20638, "verse_number": "५-९७-१००", "content_sanskrit": "तेनावगाहिता दृष्टाः प्रणता बहुसेविताः ।\nस्नानमर्द्धोदिते सूर्ये वैशाखे नियतश्चरेत् ॥१०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000638100, "chapter_id": 20638, "verse_number": "५-९७-१०१", "content_sanskrit": "तस्य पुण्यं महीदेव कश्चिद्वक्तुं न शक्यते ।\nयदि वक्त्रसहस्राणां सहस्राणि भवंति हि ॥१०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000638101, "chapter_id": 20638, "verse_number": "५-९७-१०२", "content_sanskrit": "आयुश्च ब्रह्मणा स्वल्पं यदि स्याद्द्विजसत्तम ।\nतदा माधवमासस्य फलं कथयितुं भवेत् ॥१०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000638102, "chapter_id": 20638, "verse_number": "५-९७-१०३", "content_sanskrit": "महानिरयकर्षाग्नि माधवो माधवो यथा ।\nब्रह्महत्यादिकं पापमगम्यागमनादिकम् ॥१०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000638103, "chapter_id": 20638, "verse_number": "५-९७-१०४", "content_sanskrit": "कामाकामकृतं पापमेति पातकमेव च ।\nउपपापरहस्यं च संकरीकरणं परम् ॥१०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000638104, "chapter_id": 20638, "verse_number": "५-९७-१०५", "content_sanskrit": "जातिभ्रंशकरं घोरमपात्रीकरणं तथा ।\nमलावहं प्रकीर्णं च वाङ्मनः काय संभवम् ॥१०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000638105, "chapter_id": 20638, "verse_number": "५-९७-१०६", "content_sanskrit": "माधवो निर्दहेन्मासो विधिना समुपासितः ।\nकल्पकोटिसहस्राणि कल्पकोटि शतानि च ॥१०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000638106, "chapter_id": 20638, "verse_number": "५-९७-१०७", "content_sanskrit": "वसेद्विष्णुपुरे श्रीमान्माधवे योऽर्चयेद्धरिम् ॥१०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]