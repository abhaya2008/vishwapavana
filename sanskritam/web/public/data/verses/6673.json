  {
    "id": 20010420,
    "chapter_id": 6673,
    "verse_number": "1.96",
    "content_sanskrit": "सुरमिथुनसहस्रैर्गीयमानं दिविष्ठैरतिशुभमपदानं देहजानां निशम्य । यममरुदमरेशद्योमिषक्पाण्डुमाद्यः पुलकशिशिरवाष्पप्रस्रविण्यो बभूवुः ॥",
    "padaccheda": "",
