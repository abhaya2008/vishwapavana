  {
    "id": 20010414,
    "chapter_id": 6673,
    "verse_number": "1.90",
    "content_sanskrit": "सवात्सकं सौक्षकमस्य राष्ट्रं व्यभूषयद्धैनुकमाश्रितश्रि । मानुष्यकाधिष्ठितमौष्ट्रकञ्च सहाजकं राजकमप्यसंख्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20010415,
    "chapter_id": 6673,
    "verse_number": "1.91",
    "content_sanskrit": "व्याकर्तारस्स्वादुतां व्यञ्जनानामन्नस्यापि स्रग्विणश्चन्दनार्द्राः । काले काले वर्धयामासुरेनं प्रीत्याशीर्भिः श्राद्धिनो भूमिदेवाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20010416,
    "chapter_id": 6673,
    "verse_number": "1.92",
