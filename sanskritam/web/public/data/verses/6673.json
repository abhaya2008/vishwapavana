  {
    "id": 20010412,
    "chapter_id": 6673,
    "verse_number": "1.88",
    "content_sanskrit": "चक्रक्षतक्षोणिरजोनिरुद्धध्वजांशुकाकाशदिनेशभासा । यात्रासु रेजे रथकड्ययासौ तताङ्गरागच्छटयेव लक्ष्म्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
