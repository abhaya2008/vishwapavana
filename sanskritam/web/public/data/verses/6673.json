  {
    "id": 20010419,
    "chapter_id": 6673,
    "verse_number": "1.95",
    "content_sanskrit": "आच्छादितेन्दुकिरणाच्छयशोदुकूलं सर्पत्प्रतापकनकाभरणप्रकाशम् । ज्ञानाग्निपक्वविनयान्नरसप्रधानं धर्मात्मभूरभृत धर्मशरीरमुच्चैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
