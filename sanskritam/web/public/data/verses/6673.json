    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20010417,
    "chapter_id": 6673,
    "verse_number": "1.93",
    "content_sanskrit": "महामहस्सर्वजनीनमुद्वहन् मलिम्लुचव्रातसमन्धकारभित् । धनोदकाकृष्टिविसृष्टिचेष्टितस्सुतोपि धर्मस्य पितेव दिद्युते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
