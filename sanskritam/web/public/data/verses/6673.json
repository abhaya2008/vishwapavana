[
  {
    "id": 20010325,
    "chapter_id": 6673,
    "verse_number": "1.1",
    "content_sanskrit": "मधुव्रताकारमुनीन्द्रवृन्दप्रपीतदानात्मरसप्रवाहम् । अनन्तमध्यादि परं महस्तन्नृहस्तिरूपं शरणं प्रपद्ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20010326,
    "chapter_id": 6673,
    "verse_number": "1.2",
    "content_sanskrit": "हारं सुधावर्णतनुस्स्तनाभ्यामाबिभ्रती सेन्दुजटा त्रिनेत्रा । सपुस्तकाक्षस्रगभीष्टहस्ता सरस्वती चेतसि भासतां नः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20010327,
    "chapter_id": 6673,
    "verse_number": "1.3",
    "content_sanskrit": "शैलादिदौवारिकरुद्धदेवौ विविक्तकैलासगुहागृहस्थौ । अपूर्वयोगेन सुखायमानौ शिवावुपासे पितरौ पुराणौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20010328,
    "chapter_id": 6673,
    "verse_number": "1.4",
    "content_sanskrit": "हैयङ्गवीनं मुषितं वनेश्नन्नन्वागतां दृष्टपदोर्ध्वरेखाम् । गोपाङ्गनां मङ्गलमावहेद् वो वासो विमुष्णन् वसुदेवसूनुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20010329,
    "chapter_id": 6673,
    "verse_number": "1.5",
    "content_sanskrit": "मुनित्रयीपादभुवः परागा मृजन्तु चेतोमुकुरं ममेमम् । वागर्थरूपा शिवयोस्तनुस्सा यथोभयीह प्रतिबिम्बिता स्यात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20010330,
    "chapter_id": 6673,
    "verse_number": "1.6",
    "content_sanskrit": "वाल्मीकिमाद्यं प्रणुमः कविं तं जगद्धितायातिपवित्रहृद्याम् । सरस्वतीं यो विततान दिव्यां भगीरथस्सिन्धुमिवेह लोके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20010331,
    "chapter_id": 6673,
    "verse_number": "1.7",
    "content_sanskrit": "जटातडिद्दामभृतं नमामः कृष्णं महाभारतवारिमेघम् । सत्केकिनो यस्य निशम्य शब्दान् मत्ताः प्रनृत्यन्ति महागभीरान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20010332,
    "chapter_id": 6673,
    "verse_number": "1.8",
    "content_sanskrit": "जयन्ति ते सत्कविकुञ्जरा ये लिखन्ति जिह्वामयतूलिकाभिः । पृथग्विधप्रातिभरागिणीभिश्चित्रं जगद्भित्तितलेषु काव्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20010333,
    "chapter_id": 6673,
    "verse_number": "1.9",
    "content_sanskrit": "कठोरमेके सुकुमारमन्ये मार्गं कवीन्द्रा वचसः प्रपन्नाः । मेघस्वनेषून्मनसो मयूरा हंसाः पुनर्नूपुरशिञ्जितेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20010334,
    "chapter_id": 6673,
    "verse_number": "1.10",
    "content_sanskrit": "सुदुस्तरं व्याकरणाम्बुराशिं मनस्तरित्रेण विगाह्य लब्धैः । सुशब्दरत्नै रचयामि हारं काव्यं सुभद्राहरणाभिधानम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20010335,
    "chapter_id": 6673,
    "verse_number": "1.11",
    "content_sanskrit": "अनन्यसन्तोषफलं तमेतं वहन्तु सन्तो हृदयेषु हृष्टाः । येषामनीर्ष्यागुणपक्षपातः परोपकारश्च निसर्गसिद्धः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20010336,
    "chapter_id": 6673,
    "verse_number": "1.12",
    "content_sanskrit": "सदैव सद्वागमृतेन पूर्ण विशत्यसूया हृदयं न साधोः । मनो यथेर्ष्यागरलेन रुद्धं सुभाषितं नावतरत्यसाधोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20010337,
    "chapter_id": 6673,
    "verse_number": "1.13",
    "content_sanskrit": "निलोपकण्ठाभरणाद्विनीताद्यो ब्रह्मदत्तादजनि द्विजेन्द्रात् । रामोदयाचार्यपितृव्यचुञ्चुनारायणोसौ कविरस्य कर्ता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20010338,
    "chapter_id": 6673,
    "verse_number": "1.14",
    "content_sanskrit": "अगृह्यमाणं पुरुषैर्बुद्धैर्बुद्धैरसूयाकलुषीकृतैश्च । मनीषिणो मत्सरमुक्तचित्ता नन्वेषते काव्यमिदं मदीयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20010339,
    "chapter_id": 6673,
    "verse_number": "1.15",
    "content_sanskrit": "बभूव भूमेरखिलावदातं विभूषणं वारिधिमेखलायाः । धर्माकरं भूतिदमाश्रितानां युधिष्ठिरो नाम नरेन्द्ररत्नम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20010340,
    "chapter_id": 6673,
    "verse_number": "1.16",
    "content_sanskrit": "मृगर्षिशापापहृतप्रसूतेः क्षेत्रे कुरूणामधिपस्य पाण्डोः । दयालुना यः किल भक्तिमत्यां धर्मेण कुन्त्यां जनयांबभूवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20010341,
    "chapter_id": 6673,
    "verse_number": "1.17",
    "content_sanskrit": "द्वाभ्यां पृथा वातवलारिभूभ्यां द्वाभ्याञ्च माद्री सुरवैद्यजाभ्याम् । जुष्टोऽनुजैस्तुङ्गतमस्स तुङ्गैः कुलाचलैर्मेरुरिव स्म भाति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20010342,
    "chapter_id": 6673,
    "verse_number": "1.18",
    "content_sanskrit": "मूलं मुकुन्दस्सहभूमिदेवस्स्कन्धः किरीटी विटपानि भीमः । माद्रीसुतौ पुष्पफले तथोक्तौ धर्मात्मनो यस्य महाद्रुमस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20010343,
    "chapter_id": 6673,
    "verse_number": "1.19",
    "content_sanskrit": "समस्तसन्तापमुषा परीतो यश्छाययासाद्य सपक्षपातैः । शाखीव नित्यं नुतिशब्दकृद्भिर्जनाण्डजौघैरुपजीव्यते स्म ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20010344,
    "chapter_id": 6673,
    "verse_number": "1.20",
    "content_sanskrit": "योऽसाधयत् संभृतसाधनस्स्वं धर्मोपि साध्यस्सकलैर्नरैस्सन् । सनातनं सर्वजनाय सार्वं वृत्तं सतां दर्शयितुं दयालुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20010345,
    "chapter_id": 6673,
    "verse_number": "1.21",
    "content_sanskrit": "धर्म्याय चार्थ्याय च कर्मणेऽलं विद्येव कामानखिलान् दुहाना । शुचिः स्वतस्तस्य सहानुजस्य बभूव कृष्णा किल धर्मपत्नी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20010346,
    "chapter_id": 6673,
    "verse_number": "1.22",
    "content_sanskrit": "धृतासिचर्मण्यनलस्य मध्याद् द्रोणान्तके भ्रातरि जातमात्रे । द्विजप्रभावाद् द्रुपदस्य यज्ञे या वेदिमध्यादजनि ज्वलन्ती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20010347,
    "chapter_id": 6673,
    "verse_number": "1.23",
    "content_sanskrit": "आरोप्य चापं लघु पूरयित्वा लक्षं क्षितौ पत्ररथं पृषत्कैः । भङ्क्त्वा मदं कर्णपुरस्सराणामहारि या कीर्त्तिरिवार्जुनेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20010348,
    "chapter_id": 6673,
    "verse_number": "1.24",
    "content_sanskrit": "तप्तैस्तपोभिः पुरतो रतार्थैः प्रसादमाप्त्वा परमेश्वरस्य । या पञ्चपार्थीतनुमुद्वहन्तं भेजे महेन्द्रं पतिमेकमेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20010349,
    "chapter_id": 6673,
    "verse_number": "1.25",
    "content_sanskrit": "या मुञ्जवत्सोमलतेव यष्टृन् महीपतीनर्णवमेखलेव । पीयूषधारेव सुरान् प्रपेदे तानात्मविद्येव मुमुक्षमाणान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20010350,
    "chapter_id": 6673,
    "verse_number": "1.26",
    "content_sanskrit": "सुगन्धिनीलेन बहूलपलेन स्त्रीरत्नमूढाखिललक्षणेन । या कर्णजाहश्रितलोचनेन स्वान्तानि तेषां वपुषा जहार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20010351,
    "chapter_id": 6673,
    "verse_number": "1.27",
    "content_sanskrit": "मुखं मृगाङ्कस्सुरलोकवल्यौ भुजौ स्तनौ तालफलानि मध्यम् । अश्वत्थपत्रं जघनं यदीयं रथोऽनुपादावपि पङ्कजानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20010352,
    "chapter_id": 6673,
    "verse_number": "1.28",
    "content_sanskrit": "ऊरू यदीयौ द्विपहस्तकल्पौ भारः कचानामलिवृन्ददेश्यः । अर्धेन्दुदेशीयमभ्रूल्ललाटं ताम्राधरोष्ठो बहुविद्रुमोऽभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20010353,
    "chapter_id": 6673,
    "verse_number": "1.29",
    "content_sanskrit": "उत्तिष्ठमाना भवनोचितासु क्रियासु यापि प्रतिदेहिशब्दम् । अर्थित्रजायान्वहमिष्टमिष्टं व्यश्राणयद्विश्वजनीनशीला ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20010354,
    "chapter_id": 6673,
    "verse_number": "1.30",
    "content_sanskrit": "मृदुस्मितोपस्कृतजल्पितायै सदा नतायै विनयेन यस्यै । गाढं निबद्ध्येव गुणावलीभिराकृष्यमाणा जनता प्रणेमे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20010355,
    "chapter_id": 6673,
    "verse_number": "1.31",
    "content_sanskrit": "उत्थाय पूर्वं शयनादनिद्रा कार्मञ्जनं कर्मसु या न्ययुङ्क्त । सस्नावुषस्यभ्युदितं ववन्दे रविं समर्चत् गृहदेवताश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20010356,
    "chapter_id": 6673,
    "verse_number": "1.32",
    "content_sanskrit": "स्नातानुलिप्ताञ्जननीलनेत्रा मालाभिरामोदितकेशहस्ता । प्रातश्शुचिक्षौमवती प्रकृत्या या हारिणी हारमधत्त मोघम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20010357,
    "chapter_id": 6673,
    "verse_number": "1.33",
    "content_sanskrit": "सुसिक्तसम्मृष्टतलप्रकीर्णप्रभूतनानाकुसुमोत्करेषु । उपस्युषस्यावसथेषु दास्यो यया नियुक्तास्समभाण्डयन्त ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20010358,
    "chapter_id": 6673,
    "verse_number": "1.34",
    "content_sanskrit": "आढ्यं भविष्णुस्सुभगं भविष्णुः स्थूलं भविष्णुः स्तनचक्रवालः । यदास्यमाप्त्वा युवलोचनानां प्रियं भविष्णुर्वनिताजनोऽभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20010359,
    "chapter_id": 6673,
    "verse_number": "1.35",
    "content_sanskrit": "अन्धं भविष्णून् पलितं भविष्णून् नग्नं भविष्णूंश्च जनाननाथान् । निस्वानरक्षद्दययाश्रितान् या परोपकारैकरसार्द्रचित्ता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20010360,
    "chapter_id": 6673,
    "verse_number": "1.36",
    "content_sanskrit": "क्रमेण यस्यास्सकलेष्टदानैस्त्रैणं गृहे स्थापितमर्च्चमानम् । सतीकथाढ्यं करणोपदेशैर्जरत्प्रियं भावुकतामगच्छत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20010361,
    "chapter_id": 6673,
    "verse_number": "1.37",
    "content_sanskrit": "वृषान्विताः पुष्कलदुग्धपानप्रहृष्यदुत्पुच्छ्यमानवत्साः । समां समीनास्स्वयमेव माहा ररक्ष या सुष्ठु युधिष्ठिरस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20010362,
    "chapter_id": 6673,
    "verse_number": "1.38",
    "content_sanskrit": "देवान् पितॄन् प्राणभृतोऽतिथीनप्यग्न्याहितान् सोमसुतोप्यसंख्यान् । सवर्णिपाराशरिणोर्चयित्वा सहामृतं या विघसञ्जघास ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20010363,
    "chapter_id": 6673,
    "verse_number": "1.39",
    "content_sanskrit": "पार्थैःकृत्वा सह पाकयज्ञानभोजयित्वातिथिमण्डलानि । बालातुरादींश्च सभृत्यवर्गानाभोजनीयत् खलु या कदाचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20010364,
    "chapter_id": 6673,
    "verse_number": "1.40",
    "content_sanskrit": "धर्मार्थकामाखिलसाधनौघैर्या पूरयन्ती भवनान्तराणि । सर्वेषु कृत्येषु धृतप्रमीला सदा जजागार च चक्रमे च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20010365,
    "chapter_id": 6673,
    "verse_number": "1.41",
    "content_sanskrit": "तां जागरूकामिति कर्मशीलां पार्थाश्श्रियं मूर्तिमतीमिवाप्त्वा । धर्मार्थकामानलभन्त कृत्स्नान् सजानयो ये गृहिणस्त एव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20010366,
    "chapter_id": 6673,
    "verse_number": "1.42",
    "content_sanskrit": "सा पञ्चभिः पञ्चभिराप वर्षैरन्वग्रजं पञ्च पृथातनूजान् । एकापि तेषामनुवर्तमाना चित्तानि दाक्ष्यादपरा परेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20010367,
    "chapter_id": 6673,
    "verse_number": "1.43",
    "content_sanskrit": "स्कन्धाधिरूढस्तनचक्रगुच्छा भुजालताभ्यामुपगूहमाना । सा देवपुत्रानवलंब्य रेजे देवद्रुमान्नन्दनवल्लरीव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20010368,
    "chapter_id": 6673,
    "verse_number": "1.44",
    "content_sanskrit": "शौचेन वृत्तेन च धर्मराजं समीस्सुनुं मनसोन्नतेन । शीलेन पार्थं नकुलं कलाभिर्मनीषया सा सहदेवमार्चत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20010369,
    "chapter_id": 6673,
    "verse_number": "1.45",
    "content_sanskrit": "भीमार्जुनौ तस्य भुजावभूतां 'महीभुजोन्यौ मथिताभिमानी । माद्रीकुमारौ हृदयं द्वितीयं ज्यायान् कनीयांस्तु मतिर्द्वितीया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20010370,
    "chapter_id": 6673,
    "verse_number": "1.46",
    "content_sanskrit": "विनीतिमद्भिर्विजितेन्द्रियैस्तैः क्षतारिभिः क्षत्रियकेतुभूतैः । पृथा पृथिव्यां प्रथितप्रतापैस्तुतोष शोकापनुदैस्तनूजैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20010371,
    "chapter_id": 6673,
    "verse_number": "1.47",
    "content_sanskrit": "भीमादयो भूवलयान्तलग्नामुदग्रसत्वाश्रितसर्वरत्नाः । वेलामिवाम्भोनिधयः कदाचिन्नालंघयन् बुद्धिमजातशत्रोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20010372,
    "chapter_id": 6673,
    "verse_number": "1.48",
    "content_sanskrit": "रागादयो यद्यपि नान्तरासन्नजातशत्रोरमुना तथापि । रागादिभिः स्वैर्बहिरुद्भवन्तो भुजौजसाघानिषत द्विषन्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20010373,
    "chapter_id": 6673,
    "verse_number": "1.49",
    "content_sanskrit": "अपीडयत् कर्शयति स्म शत्रून् नुच्छिन्नकोपस्समदच्छिनत्त । हित्वातिसङ्गं विषयान् सिषेवे स सञ्चिकाय द्रविणान्यलोभः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20010374,
    "chapter_id": 6673,
    "verse_number": "1.50",
    "content_sanskrit": "प्रेयानभूद्धर्मसुतस्य धर्मो धनाच्च कामाच्च न चित्रमेतत् । प्रेयान् हि सर्वस्य जनस्य तातः किमङ्ग सम्पन्नगुणस्य सूरेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20010375,
    "chapter_id": 6673,
    "verse_number": "1.51",
    "content_sanskrit": "माद्रीसुतेनावरजेन सार्धं कृतापडक्षीणनयस्य तस्य । जैवातृकस्येव जगद्विवृद्ध्यै महीभृतो मण्डलमेधते स्म ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20010376,
    "chapter_id": 6673,
    "verse_number": "1.52",
    "content_sanskrit": "प्रह्लादयामास शशीव लोकान् मयूखमालीव समुत्तताप । स सर्वगीर्वाणसमूहदेहः कोपि क्षितिं देव इवावतीर्णः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20010377,
    "chapter_id": 6673,
    "verse_number": "1.53",
    "content_sanskrit": "स्वमण्डलं प्राप्य मुहुर्निवृत्तं दीप्तद्युतिर्दर्शनकालनम्रम् । समण्डलं प्राभृत राजकीयं ततः करं पुष्कलमाददानः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20010378,
    "chapter_id": 6673,
    "verse_number": "1.54",
    "content_sanskrit": "अदुःखमिश्रं कृतभूरिपुण्या सुखं गरीयः प्रतिपद्यमानाः । सहस्रभानोरिव धर्मसूनोस्सन्तः पुरा मण्डलमावसन्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20010379,
    "chapter_id": 6673,
    "verse_number": "1.55",
    "content_sanskrit": "सुतेषु तेष्वर्पितविश्वकार्याश्शक्रादयोऽकुर्वत लोकपालाः । चन्द्रानना चन्दनपङ्कदिग्धस्तनद्वयांम्भोजविहारलीलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20010380,
    "chapter_id": 6673,
    "verse_number": "1.56",
    "content_sanskrit": "पुण्यस्य पुत्रेण सदानुशिष्टः पपाठ वेदानखिलान् द्विजातिः । ईजे मखैर्भूरि ददे च वित्तं शेषेण वृत्तित्रितयेन लब्धम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20010381,
    "chapter_id": 6673,
    "verse_number": "1.57",
    "content_sanskrit": "युधिष्ठिरस्योर्जितप्रतापाच्चकार राजन्यकमानताङ्गम् । किरीटरत्नांशुचयव्यवायस्फुरन्मयूखं मणिपादपीठम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20010382,
    "chapter_id": 6673,
    "verse_number": "1.58",
    "content_sanskrit": "समग्रवेदाध्ययनेषु भूपा मखेषु च त्यक्तधनोच्चयेषु । उत्तिष्ठमानास्सततं सुवृत्ताः प्रिया बभूवुर्भरतर्षभस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20010383,
    "chapter_id": 6673,
    "verse_number": "1.59",
    "content_sanskrit": "कृष्यादिधर्मेषु कृतोद्यमास्तं सिषेविरे सन्ततमर्यमर्याः । वर्णत्रयाराधनलब्धवर्णस्तमन्त्यवर्णोप्यधिनोदजस्रम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20010384,
    "chapter_id": 6673,
    "verse_number": "1.60",
    "content_sanskrit": "वशंवदस्तस्य बभूव नित्यं प्रियंवदस्य प्रथमाश्रमोपि । व्यातायि पीयूषकरांशुगौरं यशो हि यौधिष्टिरमाकुमारम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20010385,
    "chapter_id": 6673,
    "verse_number": "1.61",
    "content_sanskrit": "महामखानध्ययनप्रधानान् पञ्च प्रपञ्चासुभृतश्चरन्तः । तस्याज्ञया तर्पयितुः प्रजानां गृहेषु सुस्था गृहमेधिनोऽस्थुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20010386,
    "chapter_id": 6673,
    "verse_number": "1.62",
    "content_sanskrit": "सदर्भनीवारपलाशराशि प्राप्याश्रमान्तं मृगयापदेन । ररक्षिरेऽरण्यजुषो मुनीन्द्रास्स्वयंहतक्रूरमृगेण तेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20010387,
    "chapter_id": 6673,
    "verse_number": "1.63",
    "content_sanskrit": "पादोदकस्पर्शपवित्रगात्रो भिक्षां ददत्सर्वमनोगतज्ञः । वेदान्तवाक्यार्थविचारचुञ्चून् बहून् स पाराशरिणो बभार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20010388,
    "chapter_id": 6673,
    "verse_number": "1.64",
    "content_sanskrit": "बभ्रे धनैर्धर्मसुतो द्विजातीन् यज्ञैस्सुरानग्निपुरस्सरास्ते । ते दिव्यतोयैस्सकलाः प्रजास्ताष्षष्ठार्धदानेन पतिं तमेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20010389,
    "chapter_id": 6673,
    "verse_number": "1.65",
    "content_sanskrit": "सुरैर्यथाकालकृतेष्टिपुष्टैः प्रवर्तितं प्रावृषि वर्षतोयम् । प्राणैस्समः प्राणभृतामपुष्णात् सस्यानि सर्वाणि महीगतानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20010390,
    "chapter_id": 6673,
    "verse_number": "1.66",
    "content_sanskrit": "तस्मिन् द्विजास्तेषु स तेषु लोकाः लोकेषु सर्वेषु च तेऽधितस्थुः । तदित्यहो धर्मसुतस्य राज्यं परस्पराधीनमपि प्रक्लृप्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20010391,
    "chapter_id": 6673,
    "verse_number": "1.67",
    "content_sanskrit": "पितेव तत्रे विदधे विनीतानाचार्यवन्मित्रमिवाधिनोत्सः । सर्वान्निरांस्तत्र च ते व्यतन्वन्नपत्यशिष्यप्रियचेष्टितानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20010392,
    "chapter_id": 6673,
    "verse_number": "1.68",
    "content_sanskrit": "नादैष्टिकः कश्चिद्धार्मिको वा तन्द्रालुरुत्कृष्टपराक्रमो वा । आसीदभोगस्सुखवर्जितो वा भूमण्डलं भुञ्जति धर्मराजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20010393,
    "chapter_id": 6673,
    "verse_number": "1.69",
    "content_sanskrit": "इति क्षमाभर्त्रिति भीमसेनमिति द्युभृत्सून्विति दस्रपुत्रौ । बभूव तेषामिति दिक्षु शब्दस्स्वं भूरि सम्पादयतां स्ववीर्यैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20010394,
    "chapter_id": 6673,
    "verse_number": "1.70",
    "content_sanskrit": "चराचराणां समवायिहेतुपराणुभाजोऽसमवायिहेतून् । निमित्तहेतुत्वमितैस्तनूनां जुगोप संयोगगुणान् स धर्मैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20010395,
    "chapter_id": 6673,
    "verse_number": "1.71",
    "content_sanskrit": "प्रद्योतिताद्बिभ्यदमुष्य धाम्नो न कश्चनोदायत मर्त्यलोके । नैर्ष्यत्परस्मै न दधावसूयां चित्तेन दुद्रोह न वा चुकोप ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20010396,
    "chapter_id": 6673,
    "verse_number": "1.72",
    "content_sanskrit": "व्युत्पादितो रञ्जयतीति तस्मिन् विचक्षणैः कैश्चन राजशब्दः । अन्यैः 'पुनाराजत इत्युदीर्णप्रजानुरागे विपुलप्रतापे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20010397,
    "chapter_id": 6673,
    "verse_number": "1.73",
    "content_sanskrit": "सेन्द्राग्निसूर्यद्युतिरन्तकोपमसुधांशुवारीशकुबेरकान्तिः । कविष्णुरुद्रानिलशेषकल्पो जज्ञे न देवः क इति प्रजाभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20010398,
    "chapter_id": 6673,
    "verse_number": "1.74",
    "content_sanskrit": "शास्त्रैर्निरासात्मभवं स दुःखं पुरोहितैर्देवभवं प्रजानाम् । भूतोद्भवं च स्वभुजोपमानैस्तेजस्विभिर्भ्रातृभिरात्तशस्त्रैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20010399,
    "chapter_id": 6673,
    "verse_number": "1.75",
    "content_sanskrit": "भीमादयो यद्यपि धर्मसूनोः प्रेयांस आसन्निजवर्ष्मणोपि । जेघ्नीयमानस्स्वयमेव दस्यूंस्तथापि तेभ्यः प्रददौ न हन्तुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20010400,
    "chapter_id": 6673,
    "verse_number": "1.76",
    "content_sanskrit": "भीमादिविक्रान्तिजिताखिलाशो महीशविश्राणितवित्तराशीन् । सत्स्वेव पात्रेषुवपन्नजस्रं धर्मस्य पुत्रः पितरं पुपोष ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20010401,
    "chapter_id": 6673,
    "verse_number": "1.77",
    "content_sanskrit": "अबाधिता व्याधिभिराधिहीना न जातुचित्प्रापुरकालमृत्युम् । युधिष्टिरे शासति भूतधात्रीमृद्धाः प्रजा धर्मपरास्समस्ताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20010402,
    "chapter_id": 6673,
    "verse_number": "1.78",
    "content_sanskrit": "उत्पादितस्तंबकरिप्रभूतव्रीहिर्महानीलसवर्णमृत्स्नाः । आर्द्रेण चित्तेन करेण चासौ बह्वीर्भुवो ब्राह्मणसाच्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20010403,
    "chapter_id": 6673,
    "verse_number": "1.79",
    "content_sanskrit": "शकृत्करीनालिहतीस्स्रवत्सान् स्वर्णौल्लसच्छृङ्गखुरा घटोध्नीः । आम्नायविद्भ्योनुदिनं द्विजेभ्यस्स स्पर्शयामास सहस्रशो गाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20010404,
    "chapter_id": 6673,
    "verse_number": "1.80",
    "content_sanskrit": "आशान्तरेभ्योपि धनानि गृह्णन्नाशा नृणां तैस्समपूरयत्सः । त्यजन्नपि स्वर्णमहांसि सद्‌भ्यो भृताव्ययस्स्वर्णमहास्सदाङ्गैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20010405,
    "chapter_id": 6673,
    "verse_number": "1.81",
    "content_sanskrit": "तद्दत्तवित्तैर्द्विजगेहिनीनां सम्पादिताशेषमनोरथानाम् । दरिद्रतीनां गुरुशोककोष्णा निश्वासवाताश्शिशिरीबभूवुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20010406,
    "chapter_id": 6673,
    "verse_number": "1.82",
    "content_sanskrit": "आपूरयन्नित्यममुष्य कोशान् राजन्यवैश्या व्ययशङ्कयेव । ईर्ष्यन्निवासौ तु धनोच्चयेभ्यः प्राज्यं प्रजाभ्यो विससर्ज वित्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20010407,
    "chapter_id": 6673,
    "verse_number": "1.83",
    "content_sanskrit": "स्वनिर्विशेषं परिपालयन् स प्रजा न ताभ्यो बिभिदे विभुभ्यः । अन्यत्र वालव्यजनात् किरीटात् सितातपत्रात् परमासनाच्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20010408,
    "chapter_id": 6673,
    "verse_number": "1.84",
    "content_sanskrit": "पुरूरवः पूरुपुरस्सराणां राजन्वती यद्यपि भूमिरासीत् । तथापि सा राजवतीव भूत्वा राजन्वती धर्मसुतस्य जाता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20010409,
    "chapter_id": 6673,
    "verse_number": "1.85",
    "content_sanskrit": "प्रजापतिश्च श्रितवेदवक्त्रश्श्रियं वहन् वक्षसि चाम्बुजाक्षः । महेश्वरश्चाखिलभूतसेव्यस्स चित्रमेको भरतर्षभोभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20010410,
    "chapter_id": 6673,
    "verse_number": "1.86",
    "content_sanskrit": "धुतोच्चलन्मस्तकचामराल्या सौराज्यलक्ष्मीमिव वीजयन्तः । यानेषु सल्लक्षणपूर्णकाया रंहस्विनस्तस्य हया विरेजुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
