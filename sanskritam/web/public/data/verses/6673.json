  },
  {
    "id": 20010418,
    "chapter_id": 6673,
    "verse_number": "1.94",
    "content_sanskrit": "द्विषदरण्यदवज्वलनोप्यसावमलिनेन चचार सदाध्वना । सुजनकैरवशीतकरोप्यधादपि च मण्डलमच्छमखण्डितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
