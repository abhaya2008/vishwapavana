[{"id": 7002488000, "chapter_id": 22488, "verse_number": "१-१५०-१", "content_sanskrit": "वासुदेव उवाच ।\nअतः परं प्रवक्ष्यामि यथा पूज्यो दिवाकरः ।\nस्थण्डिले यदुशार्दूल निबोधैकाग्रमानसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002488001, "chapter_id": 22488, "verse_number": "१-१५०-२", "content_sanskrit": "मण्डलैरष्टभिः कार्यं चक्रं कालात्मकं शुभम् ।\nमध्ये पद्माकृतं चक्रमरैर्द्वादशभिर्युतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002488002, "chapter_id": 22488, "verse_number": "१-१५०-३", "content_sanskrit": "तन्मध्ये कमलं प्रोक्तं पत्राष्टकसमन्वितम् ।\nसर्वात्मा सकलो देवः खषोल्कः किरणोज्ज्वलः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002488003, "chapter_id": 22488, "verse_number": "१-१५०-४", "content_sanskrit": "पूजनीयः सदा मध्ये सहस्रकिरणायुधः ।\nप्रणवेन महाबाहो चतुर्बाहुसमन्वितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002488004, "chapter_id": 22488, "verse_number": "१-१५०-५", "content_sanskrit": "अरुणं१ पूजयेत्प्राज्ञः सदा देवाग्रजं२ शुभम् ।\nदक्षिणे पूजयेद्देवीं निक्षुभां भास्करस्य तु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002488005, "chapter_id": 22488, "verse_number": "१-१५०-६", "content_sanskrit": "रेवतं दक्षिणे पार्श्वे उत्तरे पिङ्गलं सदा ।\nसंज्ञां च यदुशार्दूल श्रेयसे सततं बुधः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002488006, "chapter_id": 22488, "verse_number": "१-१५०-७", "content_sanskrit": "आग्नेय्यां लेखकं वीर नैरृत्यामश्विनौ तथा ।\nवायव्यां पूजयेद्देवं मनुं वैवस्वतं विभुम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002488007, "chapter_id": 22488, "verse_number": "१-१५०-८", "content_sanskrit": "ऐशान्यां पूजयेद्देवीं यमुनां लोकपावनीम् ।\nद्वितीयावरणे वीर पूर्वतः पूजयेद्वियत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002488008, "chapter_id": 22488, "verse_number": "१-१५०-९", "content_sanskrit": "दक्षिणे च ततो देवीं पश्चिमे गरुडं तथा ।\nउत्तरे नागराजानं पुत्रमैरावतं शुभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002488009, "chapter_id": 22488, "verse_number": "१-१५०-१०", "content_sanskrit": "आग्नेय्यां पूजयेद्धेलिं प्रहेलिं नैरृते तथा ।\nवायव्यामुर्वशीं देवीमीशाने विनतां तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002488010, "chapter_id": 22488, "verse_number": "१-१५०-११", "content_sanskrit": "तृतीयावरणे पूर्वे पूजयेद्गुरुमादरात् ।\nपश्चिमे त्वर्कपुत्रं तु उत्तरे धिषणं तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002488011, "chapter_id": 22488, "verse_number": "१-१५०-१२", "content_sanskrit": "ऐशाने शशिपुत्रं तु सोममाग्नेयमण्डले ।\nपूजयेद्दक्षिणे कोणे नैरृते राहुमादरात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002488012, "chapter_id": 22488, "verse_number": "१-१५०-१३", "content_sanskrit": "वायव्ये विकचं वीर पूजयेत्सततं बुधः ।\nचतुर्थावरणे देवं पूजयेल्लेखमादरात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002488013, "chapter_id": 22488, "verse_number": "१-१५०-१४", "content_sanskrit": "आग्नेये शाण्डिलीपुत्रं दक्षिणे दक्षिणाधिपम् ।\nविरूपाक्षं नैरृते देवं जलेशं पश्चिमे तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002488014, "chapter_id": 22488, "verse_number": "१-१५०-१५", "content_sanskrit": "वायुपुत्रं च वायव्यां सततं पूजयेन्नरः ।\nईशाने देवमीशानं पूजयेत्सततं बुधः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002488015, "chapter_id": 22488, "verse_number": "१-१५०-१६", "content_sanskrit": "उत्तरे यक्षराजानां कुबेरं पूजयेद्बुधः ।\nपञ्चमे पूजयेद्वीर सदा स्वावरणे द्विजाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002488016, "chapter_id": 22488, "verse_number": "१-१५०-१७", "content_sanskrit": "पूर्वतः परमां देवीं महाश्वेतां महामतिः ।\nश्रियमृद्धिं विभूतिं च धृतिं चैवोन्नतिं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002488017, "chapter_id": 22488, "verse_number": "१-१५०-१८", "content_sanskrit": "पृथिवीं यदुशार्दूल महाकीर्तिं तथैव च ।\nइन्द्रं विष्णुं चार्यमणं भगं पर्जन्यमेव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002488018, "chapter_id": 22488, "verse_number": "१-१५०-१९", "content_sanskrit": "विवस्वन्तं तथार्कं च त्वष्टारं किरणोज्ज्वलम् ।\nपूजयेद्वरुणं षष्ठे चैवमेतान्दिवाकरान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002488019, "chapter_id": 22488, "verse_number": "१-१५०-२०", "content_sanskrit": "शिरो नेत्रे तथा वर्म अस्त्रं च यदुसत्तम ।\nअरुणं सरथं वीर सप्तमे पूजयेद्बुधः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002488020, "chapter_id": 22488, "verse_number": "१-१५०-२१", "content_sanskrit": "तथाश्वान्यदुशार्दूल सदा चावरणे बुधः ।\nयक्षरक्षांसि गन्धर्वान्मासान्पक्षानहानि तु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002488021, "chapter_id": 22488, "verse_number": "१-१५०-२२", "content_sanskrit": "संवत्सरं तथा पुत्र ह्येतान्संपूजयेत्पुरा ।\nय एवं पूजयेद्देवं भास्करं सततं नरः ।\nस गच्छेत्परमं स्थानं यत्र गत्वा न शोचति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002488022, "chapter_id": 22488, "verse_number": "१-१५०-२३", "content_sanskrit": "मूलमन्त्राक्षराणीह चाङ्गानि परिचक्षते ।\nअनेन विधिना यस्तु पूजयेत्सततं रविम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002488023, "chapter_id": 22488, "verse_number": "१-१५०-२४", "content_sanskrit": "नित्यमुभयसप्तम्यां स गच्छेत्परमं पदम् ।\nइत्युक्त्वा भगवान्देवो जगामाशु गृहं रविः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]