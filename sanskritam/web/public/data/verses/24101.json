[{"id": 7004101000, "chapter_id": 24101, "verse_number": "४-५०-१", "content_sanskrit": "स्कंद उवाच ।\nवाराणस्यां तथादित्या ये चान्ये तान्वदाम्यतः ।\nकलशोद्भव ते प्रीत्या सर्वे सर्वाघनाशनाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004101001, "chapter_id": 24101, "verse_number": "४-५०-२", "content_sanskrit": "खखोल्को नाम भगवानादित्य परिकीर्तितः ।\nत्रिविष्टपोत्तरे भागे सर्वव्याधिविघातकृत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004101002, "chapter_id": 24101, "verse_number": "४-५०-३", "content_sanskrit": "यथा खखोल्क इत्याख्या तस्यादित्यस्य तच्छृणु ।\nपुरा कद्रूश्च विनता दक्षस्य तनये शुभे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004101003, "chapter_id": 24101, "verse_number": "४-५०-४", "content_sanskrit": "कश्यपस्य च ते पत्न्यौ मारीचेः प्राक्प्रजापतेः ।\nक्रीडंत्यावेकदान्योन्यं मुने ते ऊचतुस्त्विति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004101004, "chapter_id": 24101, "verse_number": "४-५०-५", "content_sanskrit": "कद्रूरुवाच ।\nविनते त्वं विजानासि यदि तद्ब्रूहि मेग्रतः ।\nअखंडिता गतिस्तेस्ति यतो गगनमंडले ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004101005, "chapter_id": 24101, "verse_number": "४-५०-६", "content_sanskrit": "योसावुच्चैःश्रवा वाजी श्रूयते सवितूरथे ।\nकिं रूपःसोस्ति शबलो धवलो वा वदाशु मे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004101006, "chapter_id": 24101, "verse_number": "४-५०-७", "content_sanskrit": "पणं च कुरु कल्याणि तुभ्यं यो रोचतेनघे ।\nएवमेव न यात्येष कालक्रीडनकं विना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004101007, "chapter_id": 24101, "verse_number": "४-५०-८", "content_sanskrit": "विनतोवाच ।\nकिं पणेन भगिन्यत्र कथयाम्येवमेव हि ।\nत्वज्जये का च मे प्रीतिर्मज्जये किं नु ते सुखम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004101008, "chapter_id": 24101, "verse_number": "४-५०-९", "content_sanskrit": "ज्ञात्वा पणो न कर्तव्यो मिथः स्नेहमभीप्सता ।\nध्रुवमेकस्य विजये क्रोधोन्स्येह जायते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004101009, "chapter_id": 24101, "verse_number": "४-५०-१०", "content_sanskrit": "कद्रूरुवाच ।\nक्रीडेयं नात्र भगिनि कारणं किमपि क्रुधः ।\nखेलस्य व्यवहारोयं पणे यत्किंचिदुच्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004101010, "chapter_id": 24101, "verse_number": "४-५०-११", "content_sanskrit": "विनतोवाच ।\nतथा कुरु यथा प्रीतिस्तवास्ति पवनाशिनि ।\nअथ तां विनतामाह कद्रूः कुटिलमानसा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004101011, "chapter_id": 24101, "verse_number": "४-५०-१२", "content_sanskrit": "तस्यास्तु सा भवेद्दासी पराजीयेत या यया ।\nअस्मिन्पणे इमाः सर्वाः सख्यः साक्षिण्य एव नौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004101012, "chapter_id": 24101, "verse_number": "४-५०-१३", "content_sanskrit": "इत्यन्योन्यं पणीकृत्य सर्पिण्यपि पतत्त्रिणी ।\nउवाच कर्बुरं कद्रूरश्वं श्वेतं गरुत्मती ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004101013, "chapter_id": 24101, "verse_number": "४-५०-१४", "content_sanskrit": "कदागंतव्यमिति च चक्राते ते गमावधिम् ।\nजग्मतुश्च विरम्याथ क्रीडनात्स्वस्वमालयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004101014, "chapter_id": 24101, "verse_number": "४-५०-१५", "content_sanskrit": "विनतायां गतायां तु कद्रूराहूय चांगजान् ।\nउवाच यात वै पुत्रा द्रुतं वचनतो मम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004101015, "chapter_id": 24101, "verse_number": "४-५०-१६", "content_sanskrit": "तुरंगमुच्चैःश्रवसं प्रोद्भूतं क्षीरनीरधेः ।\nसुरासुरैर्मथ्यमानान्मंदराघातसाध्वसात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004101016, "chapter_id": 24101, "verse_number": "४-५०-१७", "content_sanskrit": "कार्यकारणरूपस्य सादृश्यमधिगच्छति ।\nअतस्तं क्षीरवर्णाभं कल्माषयत पुत्रकाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004101017, "chapter_id": 24101, "verse_number": "४-५०-१८", "content_sanskrit": "तस्य वालधिमध्यास्य कृष्णकुंतलतां गताः ।\nतथा तदंगलोमानि विधत्तविषसीत्कृतैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004101018, "chapter_id": 24101, "verse_number": "४-५०-१९", "content_sanskrit": "इति श्रुत्वा वचो मातुः काद्रवेयाः परस्परम् ।\nसंमंत्र्य मातरं प्रोचुः कद्रूं कद्रूपमागताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004101019, "chapter_id": 24101, "verse_number": "४-५०-२०", "content_sanskrit": "नागा ऊचुः ।\nमातर्वयं त्वदाह्वानाद्विहाय क्रीडनं बलात् ।\nप्राप्ताः प्रहृष्टा मृष्टान्नं दास्यत्यद्य प्रसूरिति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004101020, "chapter_id": 24101, "verse_number": "४-५०-२१", "content_sanskrit": "मृष्टं तिष्ठतु तद्दूरं विषादप्यधिकं कटु ।\nतत्त्वया वादियन्मंत्रैरौषधैर्नोपशाम्यति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004101021, "chapter_id": 24101, "verse_number": "४-५०-२२", "content_sanskrit": "वयं न यामो यद्भाव्यं तदस्माकं भवत्विह ।\nइति प्रोक्तं विषास्यैस्तैस्तदा कुटिलगामिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004101022, "chapter_id": 24101, "verse_number": "४-५०-२३", "content_sanskrit": "स्कंद उवाच ।\nअन्येपि ये कुटिलगाः पररंध्रनिषेविणः ।\nअकर्णाः कूरहृदयाः पितरौ व्रीडयंति ते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004101023, "chapter_id": 24101, "verse_number": "४-५०-२४", "content_sanskrit": "पित्रोर्गिरं निराकृत्य ये तिष्ठेयुः सुदुर्मदाः ।\nअत्याहितमिह प्राप्य गच्छेयुस्तेऽचिराल्लयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004101024, "chapter_id": 24101, "verse_number": "४-५०-२५", "content_sanskrit": "तेषां वचनमाकर्ण्य नयाम इति सोरगी ।\nशशाप तान्क्रुधाविष्टा नागांश्चागः समागतान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004101025, "chapter_id": 24101, "verse_number": "४-५०-२६", "content_sanskrit": "तार्क्ष्यस्य भक्ष्या भवत यूयं मद्वाक्यलंघनात् ।\nजातमात्राश्च सर्पिण्यो भक्षयंतु स्वबालकान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004101026, "chapter_id": 24101, "verse_number": "४-५०-२७", "content_sanskrit": "इति शापानलाद्भीतैः कैश्चित्पातालमाश्रितम् ।\nजिजीविषुभिरन्यैश्च द्वित्रैश्चक्रे प्रसूवचः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004101027, "chapter_id": 24101, "verse_number": "४-५०-२८", "content_sanskrit": "ते पुच्छमौच्चैःश्रवसमधिगम्य महाधियः ।\nसुनीलचिकुराभासं चक्रुरंगं च कर्बुरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004101028, "chapter_id": 24101, "verse_number": "४-५०-२९", "content_sanskrit": "तत्क्ष्वेडानल धूमौघैः फूत्कारभरनिःसृतैः ।\nमातृवाक्कृतिजाद्धर्मान्न दग्धा भानुभानुभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004101029, "chapter_id": 24101, "verse_number": "४-५०-३०", "content_sanskrit": "विनतापृष्ठमारुह्य कद्रूः स्नेहवशात्ततः ।\nवियन्मार्गमलंकृत्य ददर्शोष्णांशुमंडलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004101030, "chapter_id": 24101, "verse_number": "४-५०-३१", "content_sanskrit": "तिग्मरश्मिप्रभावेण व्याकुलीभूतमानसा ।\nकद्रुस्ततः खगीं प्राह विस्रब्धं विनते व्रज ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004101031, "chapter_id": 24101, "verse_number": "४-५०-३२", "content_sanskrit": "उष्णगोरुष्णगोभिर्मे ताप्यते नितरां तनुः ।\nविस्रब्धाहं स्वभावेन त्वं सापेक्षाहि सर्वतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004101032, "chapter_id": 24101, "verse_number": "४-५०-३३", "content_sanskrit": "स्वरूपेण पतंगी त्वं पतंगोसौ सहस्रगुः ।\nअतएव न ते बाधा गगने तापसंभवा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004101033, "chapter_id": 24101, "verse_number": "४-५०-३४", "content_sanskrit": "वियत्सरसि हंसोयं भवती हंसगामिनी ।\nचंडरश्मिप्रतापाग्निस्त्वामतो नेह बाधते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004101034, "chapter_id": 24101, "verse_number": "४-५०-३५", "content_sanskrit": "खगीमुद्गीयमानां खे पुनरूचे बिलेशया ।\nत्राहित्राहि भगिन्यत्र यावोन्यत्र वियत्पथः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004101035, "chapter_id": 24101, "verse_number": "४-५०-३६", "content_sanskrit": "विनते विनतां मां त्वं किं नावसि पतत्त्रिणी ।\nतव दासी भविष्यामि त्वदुच्छिष्टनिषेविणी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004101036, "chapter_id": 24101, "verse_number": "४-५०-३७", "content_sanskrit": "यावज्जीवमहं भूयां त्वत्पादोदकपायिनी ।\nखखोल्कानि पतेदेषा भृशगद्गदभाषिणी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004101037, "chapter_id": 24101, "verse_number": "४-५०-३८", "content_sanskrit": "मूर्च्छां गतवती पक्षपुटौ धृत्वा बिडोरगी ।\nसख्युल्कानि पतेदेषा वक्तव्ये त्विति संभ्रमात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004101038, "chapter_id": 24101, "verse_number": "४-५०-३९", "content_sanskrit": "खखोल्केति यदुक्ता गीः कद्र्वा संभ्रातचेतसा ।\nतदा खखोल्कनामार्कः स्तुतो विनतया बहु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004101039, "chapter_id": 24101, "verse_number": "४-५०-४०", "content_sanskrit": "मनागतिग्मतां प्राप्ते खे प्रयाति विवस्वति ।\nताभ्यां तुरंगमो दर्शि किंचित्किर्मीरवान्रथे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004101040, "chapter_id": 24101, "verse_number": "४-५०-४१", "content_sanskrit": "उक्ता विनतयैवैषा तापोपहतलोचना ।\nक्रूरा सरीसृपी सत्यवादिन्या विश्वमान्यया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004101041, "chapter_id": 24101, "verse_number": "४-५०-४२", "content_sanskrit": "कद्रु त्वया जितं भद्रे यत उच्चैःश्रवा हयः ।\nचंद्ररश्मिप्रभोप्येष कल्माष इव भासते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004101042, "chapter_id": 24101, "verse_number": "४-५०-४३", "content_sanskrit": "विधिर्बलीयान्भुजगि चित्रं जयपराजये ।\nक्रूरोपि विजयी क्वापि त्वक्रूरोपि पराजयी ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004101043, "chapter_id": 24101, "verse_number": "४-५०-४४", "content_sanskrit": "विनताविनताधारा वदंतीति यथागतम् ।\nकद्रूनिवेशनं प्राप्ता तस्या दास्यमचीकरत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004101044, "chapter_id": 24101, "verse_number": "४-५०-४५", "content_sanskrit": "कदाचिद्विनतादर्शि सुपर्णनाश्रुलोचना ।\nविच्छाया मलिना दीना दीर्घनिःश्वासवत्यपि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004101045, "chapter_id": 24101, "verse_number": "४-५०-४६", "content_sanskrit": "सुपर्ण उवाच ।\nप्रातःप्रातरहो मातः क्व यासि त्वं दिनेदिने ।\nसायमायासि च कुतो विच्छाया दीनमानसा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004101046, "chapter_id": 24101, "verse_number": "४-५०-४७", "content_sanskrit": "कुतो निःश्वसिसि प्रोच्चैरश्रुपूर्ण विलोचना ।\nयथा क्लीबसुता योषिद्यथापति तिरस्कृता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004101047, "chapter_id": 24101, "verse_number": "४-५०-४८", "content_sanskrit": "ब्रूहि मातर्झटित्यद्य कुतो दूनासि पत्त्रिणि ।\nमयि जीवति ते बाले कालेपि कृतसाध्वसे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004101048, "chapter_id": 24101, "verse_number": "४-५०-४९", "content_sanskrit": "अश्रुनिर्माणकरणे कारणं किं तपस्विनि ।\nसुचरित्रा सुनारीषु नामंगलमिहेष्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004101049, "chapter_id": 24101, "verse_number": "४-५०-५०", "content_sanskrit": "धिक्तांश्च पुत्रान्यन्माता तेषु जीवत्सु दुःखभाक् ।\nवरं वंध्यैव सा यस्याः सुता वंध्यमनोरथाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004101050, "chapter_id": 24101, "verse_number": "४-५०-५१", "content_sanskrit": "इत्यूर्जस्वलमाकर्ण्य वचः सूनोर्गरुत्मतः ।\nविनता प्राह तं पुत्रं मातृभक्तिसमन्वितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004101051, "chapter_id": 24101, "verse_number": "४-५०-५२", "content_sanskrit": "अहं दास्यस्मि रे बाल कद्र्वाश्च क्रूरचेतसः ।\nपृष्ठे वहामि तां नित्यं तत्पुत्रानपि पुत्रक ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004101052, "chapter_id": 24101, "verse_number": "४-५०-५३", "content_sanskrit": "कदाचिन्मंदरं यामि कदाचिन्मलयाचलम् ।\nकदाचिदंतरीपेषु चरेयं तदुदन्वताम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004101053, "chapter_id": 24101, "verse_number": "४-५०-५४", "content_sanskrit": "यत्रयत्र नयेयुस्ते काद्रवेयाः सुदुर्मदाः ।\nव्रजेयं तत्रतत्राहं तदधीना यतः सुत ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004101054, "chapter_id": 24101, "verse_number": "४-५०-५५", "content_sanskrit": "गरुड उवाच ।\nदासीत्वकारणं मातः किं ते जातं सुलक्षणे ।\nदक्षप्रजापतेः पुत्रि कश्यपस्यप्रियेऽनघे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004101055, "chapter_id": 24101, "verse_number": "४-५०-५६", "content_sanskrit": "विनतोवाच गरुडं पुरावृत्तमशेषतः ।\nदासीत्वकारणं यद्वदादित्याश्वविलोकनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004101056, "chapter_id": 24101, "verse_number": "४-५०-५७", "content_sanskrit": "श्रुत्वेति गरुडः प्राह मातरं सत्वरं व्रज ।\nपृच्छाद्य मातस्तान्दुष्टान्काद्रवेयानिदं वचः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004101057, "chapter_id": 24101, "verse_number": "४-५०-५८", "content_sanskrit": "यद्दुर्लभं हि भवतां यत्रात्यंतरुचिश्च वः ।\nमद्दासीत्वविमोक्षाय तद्याचध्वं ददाम्यहम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004101058, "chapter_id": 24101, "verse_number": "४-५०-५९", "content_sanskrit": "तथाकरोच्च विनता तेपि श्रुत्वा तदीरितम् ।\nसर्पाः संमंत्र्य तां प्रोचुर्विनतां हृष्टमानसाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004101059, "chapter_id": 24101, "verse_number": "४-५०-६०", "content_sanskrit": "मातृशापविमोक्षाय यदि दास्यति नः सुधाम् ।\nतदा समीहितं तेस्तु न दास्यत्यथ दास्यसि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004101060, "chapter_id": 24101, "verse_number": "४-५०-६१", "content_sanskrit": "इत्योंकृत्य समापृच्छ्य कद्रूं द्रुतगतिः खगी ।\nगरुत्मंतं समाचष्ट दृष्ट्वा संहृष्टमानसम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004101061, "chapter_id": 24101, "verse_number": "४-५०-६२", "content_sanskrit": "नागांतकस्ततः प्राह मातरं चिंतयातुराम् ।\nआनीतं विद्धि पीयूषं मातर्मे देहि भोजनम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004101062, "chapter_id": 24101, "verse_number": "४-५०-६३", "content_sanskrit": "विनता प्राह तं पुत्रं संप्रहृष्टतनूरुहा ।\nभोः सुपर्णार्णवं तूर्णं याहि मंगलमस्तु ते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004101063, "chapter_id": 24101, "verse_number": "४-५०-६४", "content_sanskrit": "संति तत्रापि बहुशो निषादा मत्स्यघातिनः ।\nवेलातटनिवासाश्च तान्भक्षय दुरात्मनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004101064, "chapter_id": 24101, "verse_number": "४-५०-६५", "content_sanskrit": "परप्राणैर्निजप्राणान्ये पुष्णंतीह दुर्धियः ।\nशासनीयाः प्रयत्नेन श्रेयस्तच्छासनं परम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004101065, "chapter_id": 24101, "verse_number": "४-५०-६६", "content_sanskrit": "बहुहिंसाकृतां हिंसा भवेत्स्वर्गस्य साधनम् ।\nविहिंसितेषु दुष्टेषु रक्ष्यते भूरिशो यतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004101066, "chapter_id": 24101, "verse_number": "४-५०-६७", "content_sanskrit": "निषादेष्वपि चेद्विप्रः कश्चिद्भवति पुत्रक ।\nसंरक्षणीयो यत्नेन भक्षणीयो न कर्हिचित् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004101067, "chapter_id": 24101, "verse_number": "४-५०-६८", "content_sanskrit": "गरुड उवाच ।\nमत्स्यादिनां वसन्मध्ये कथं ज्ञेयो द्विजो मया॥ अभक्ष्यो यस्त्वया प्रोक्तस्तच्चिह्नं किं चनात्थ मे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004101068, "chapter_id": 24101, "verse_number": "४-५०-६९", "content_sanskrit": "विनतोवाच ।\nयज्ञसूत्रं गले यस्य सोत्तरीयं सुनिर्मलम् ।\nनित्यधौतानि वासांसि भालं तिलक लांछितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004101069, "chapter_id": 24101, "verse_number": "४-५०-७०", "content_sanskrit": "सपवित्रौ करौ यस्य यन्नीवी कुशगर्भिणी ।\nयन्मौलिः सशिखाग्रंथिः स ज्ञेयो ब्राह्मणस्त्वया ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004101070, "chapter_id": 24101, "verse_number": "४-५०-७१", "content_sanskrit": "उच्चरेदृग्यजुःसाम्नामृचमेकामपीह यः ।\nगायत्रीमात्रमंत्रोपि स विज्ञेयो द्विजस्त्वया ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004101071, "chapter_id": 24101, "verse_number": "४-५०-७२", "content_sanskrit": "गरुड उवाच ।\nमध्ये सदा निषादानां यो वसेज्जननि द्विजः ।\nतस्यैतेष्वेकमप्येव न मन्ये लक्ष्मबोधकम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004101072, "chapter_id": 24101, "verse_number": "४-५०-७३", "content_sanskrit": "लक्ष्मांतरं समाचक्ष्व द्विजबोधकरं प्रसूः ।\nयेन विज्ञाय तं विप्रं त्यजेयमपि कंठगम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004101073, "chapter_id": 24101, "verse_number": "४-५०-७४", "content_sanskrit": "तच्छ्रुत्वा विनता प्राह यस्ते कंठगतोंऽगज ।\nखदिरांगारवद्दह्यात्तमपाकुरु दूरतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004101074, "chapter_id": 24101, "verse_number": "४-५०-७५", "content_sanskrit": "द्विजमात्रेपि या हिंसा सा हिंसा कुशलाय न ।\nदेशं वंशं श्रियं स्वं च निर्मूलयति कालतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004101075, "chapter_id": 24101, "verse_number": "४-५०-७६", "content_sanskrit": "निशम्य काश्यपिरितिप्रसूपादौप्रणम्य च ।\nगृहीताशीर्ययौ शीघ्रं खमार्गेण खगेश्वरः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004101076, "chapter_id": 24101, "verse_number": "४-५०-७७", "content_sanskrit": "दूरादालोकयांचक्रे निषादान्मत्स्यजीविनः ।\nपक्षौ विधूय पक्षींद्रो रजसापूर्य रोदसी ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004101077, "chapter_id": 24101, "verse_number": "४-५०-७८", "content_sanskrit": "अंधीकृत्य दिशोभागानब्धिरोधस्युपाविशत् ।\nव्यादाय वदनं घोरं महाकंदरसन्निभम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004101078, "chapter_id": 24101, "verse_number": "४-५०-७९", "content_sanskrit": "कांदिशीका निषादास्तु विविशुस्तत्र च स्वयम् ।\nमन्वानेष्वथ पंथानं तेषु कंठं विशत्स्वपि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004101079, "chapter_id": 24101, "verse_number": "४-५०-८०", "content_sanskrit": "जज्वालेंगलसंस्पर्शो द्विजस्तत्कंठकंदलीम् ।\nप्राक्प्रविष्टानथो तार्क्ष्यो निषादानौदरीं दरीम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004101080, "chapter_id": 24101, "verse_number": "४-५०-८१", "content_sanskrit": "प्रवेश्य कंठतालुस्थं तं विज्ञाय द्विजस्फुटम् ।\nभयादुदगिरत्तूर्णं मातृवाक्येन यंत्रितः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004101081, "chapter_id": 24101, "verse_number": "४-५०-८२", "content_sanskrit": "तमुद्गीर्णं नरं दृष्ट्वा पक्षिराट्समभाषत ।\nकस्त्वं जात्यासि निगद मम कंठविदाहकृत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004101082, "chapter_id": 24101, "verse_number": "४-५०-८३", "content_sanskrit": "स तदाहेति विप्रोहं पृष्टः सन्गरुडाग्रतः ।\nवसाम्येषु निषादेषु जातिमात्रोपजीवकः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004101083, "chapter_id": 24101, "verse_number": "४-५०-८४", "content_sanskrit": "तं प्रेष्य गरुडो दूरं भक्षयित्वाथ भूरिशः ।\nनभो विक्षोभयांचक्रे प्रलयानिल सन्निभः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004101084, "chapter_id": 24101, "verse_number": "४-५०-८५", "content_sanskrit": "तं दृष्ट्वा तिग्मतेजस्कं ज्वालाततदिगंतरम् ।\nज्वलद्दावानलं शैलमिव बिभ्युर्दिवौकसः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004101085, "chapter_id": 24101, "verse_number": "४-५०-८६", "content_sanskrit": "ते सन्नह्यंत युद्धाय सज्जीकृत बलायुधाः ।\nअध्यास्य वाहनान्याशु सर्वे वर्मभृतः सुराः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004101086, "chapter_id": 24101, "verse_number": "४-५०-८७", "content_sanskrit": "तिर्यग्गतीरविर्नायं नायमग्निः सधूमवान् ।\nक्षणप्रभाप्यसौ नैव को नः सम्मुख एत्यसौ ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004101087, "chapter_id": 24101, "verse_number": "४-५०-८८", "content_sanskrit": "न दैत्येषु प्रभेदृक्स्यान्नाकृतिर्दानवेष्वियम् ।\nमहासाध्वसदः कोयमस्माकं हृत्प्रकंपनः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004101088, "chapter_id": 24101, "verse_number": "४-५०-८९", "content_sanskrit": "यावत्संभावयंतीति नीतिज्ञा अपि निर्जराः ।\nतावद्दुधाव स्वौ पक्षौ पक्षिराजो महाबलः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004101089, "chapter_id": 24101, "verse_number": "४-५०-९०", "content_sanskrit": "निपेतुः पक्षवातेन सायुधाश्च सवाहनाः ।\nन ज्ञायंते क्व संप्राप्ता वात्यया पार्णतार्णवत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004101090, "chapter_id": 24101, "verse_number": "४-५०-९१", "content_sanskrit": "अथ तेषु प्रणष्टेषु बुद्ध्या विज्ञाय पक्षिराट् ।\nकोशागारं सुधायाः स तत्रापश्यच्च रक्षिणः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004101091, "chapter_id": 24101, "verse_number": "४-५०-९२", "content_sanskrit": "शस्त्रास्त्रोद्यतपाणींस्तान्सुरानाधूय सर्वशः ।\nददर्श कर्तरीयंत्रममृतोपरिसंस्थितम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004101092, "chapter_id": 24101, "verse_number": "४-५०-९३", "content_sanskrit": "मनःपवनवेगेन भ्रममाणं महारयम् ।\nअपिस्पृशंतं मशकं यत्खंडयति कोटिशः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004101093, "chapter_id": 24101, "verse_number": "४-५०-९४", "content_sanskrit": "उपोपविश्य पक्षींद्रस्तस्य यंत्रस्य निर्भयः ।\nक्षणं विचारयामास किमत्र करवाण्यहो ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004101094, "chapter_id": 24101, "verse_number": "४-५०-९५", "content_sanskrit": "स्प्रष्टुं न लभ्यते चैतद्वात्या न प्रभवेदिह ।\nक उपायोत्र कर्तव्यो वृथा जातो ममोद्यमः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004101095, "chapter_id": 24101, "verse_number": "४-५०-९६", "content_sanskrit": "न बलं प्रभवेदत्र न किंचिदपि पौरुषम् ।\nअहो प्रयत्नो देवानामेतत्पीयूषरक्षणे ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004101096, "chapter_id": 24101, "verse_number": "४-५०-९७", "content_sanskrit": "यदि मे शंकरे भक्तिर्निर्द्वंद्वातीव निश्चला ।\nतदा स देवदेवो मां वियुनक्तु महाऽधिया ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004101097, "chapter_id": 24101, "verse_number": "४-५०-९८", "content_sanskrit": "यद्यहं मातृभक्तोस्मि स्वामिनः शंकरादपि ।\nतदा मे बुद्धिरत्रास्तु पीयूषहरणं क्षमा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004101098, "chapter_id": 24101, "verse_number": "४-५०-९९", "content_sanskrit": "आत्मार्थं नोद्यमश्चायं हृत्स्थो वेत्तीति विश्वगः ।\nमातुर्दास्यविमोक्षाय यतेहममृतं प्रति ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004101099, "chapter_id": 24101, "verse_number": "४-५०-१००", "content_sanskrit": "जरितौ पितरौ यस्य बालापत्यश्च यः पुमान् ।\nसाध्वी भार्या च तत्पुष्ट्यै दोषोऽकृत्येपि तस्य न ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004101100, "chapter_id": 24101, "verse_number": "४-५०-१०१", "content_sanskrit": "इति चिंतयतस्तस्य बुद्धिरासीन्महात्मनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004101101, "chapter_id": 24101, "verse_number": "४-५०-१०२", "content_sanskrit": "देहं चकार सोत्यंतमणीयांसमणोरपि ।\nपरमाणुसहस्रांशं कृत्वा रूपं महाद्भुतम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004101102, "chapter_id": 24101, "verse_number": "४-५०-१०३", "content_sanskrit": "प्रविश्य कर्तरीयंत्रमधोदेहस्य लाघवात् ।\nबिभ्यत्तद्यंत्रतो देहं वंचयन्वायुखंडनात् ।\nमूलमुत्पाट्य तरसा गृहीत्वाऽमृतभाजनम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004101103, "chapter_id": 24101, "verse_number": "४-५०-१०४", "content_sanskrit": "निर्ययौ पावने मार्गे क्रोशत्सु स्वर्गसद्मसु ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004101104, "chapter_id": 24101, "verse_number": "४-५०-१०५", "content_sanskrit": "तथा वैकुंठनाथं ते गत्वा प्रोचुः सुधाभुजः ।\nनिर्जित्य नीयते चक्रिन्सुधा नो जीवितं परम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004101105, "chapter_id": 24101, "verse_number": "४-५०-१०६", "content_sanskrit": "इत्याकर्ण्य हरिस्तेभ्योऽभयं दत्त्वा त्वरायुतः ।\nकृत्वा युद्धं च सुमहद्विंशार्कघटिकाद्वयम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004101106, "chapter_id": 24101, "verse_number": "४-५०-१०७", "content_sanskrit": "शुंभदेव्योर्यथासूत गरुडस्तत्र चाधिकः ।\nतदा प्रसन्नो भगवान्महायुद्धेन सर्वदः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004101107, "chapter_id": 24101, "verse_number": "४-५०-१०८", "content_sanskrit": "गत्वा गरुडमाहेदं प्रसन्नोस्मि खगेश्वर ।\nवरं वृणीहि भद्रं ते जितवृंदारवृंदक ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004101108, "chapter_id": 24101, "verse_number": "४-५०-१०९", "content_sanskrit": "हसित्वा गरुडः प्राह विश्वरूपं जनार्दनम् ।\nअहमेव प्रसन्नोस्मि त्वं प्रार्थय वरद्वयम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004101109, "chapter_id": 24101, "verse_number": "४-५०-११०", "content_sanskrit": "ततः कैटभजित्प्राह वैनतेयं मुदान्वितः ।\nवृतंवृतं महोदार देहिदेहि वरद्वयम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004101110, "chapter_id": 24101, "verse_number": "४-५०-१११", "content_sanskrit": "इति विष्णूदितं श्रुत्वा प्रहसन्नाह पक्षिराट् ।\nकिं विलंबेन तद्ब्रूहि दत्तं दत्तं वरद्वयम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004101111, "chapter_id": 24101, "verse_number": "४-५०-११२", "content_sanskrit": "अलब्धलाभे संजाते द्यूतादि विजयोदये ।\nदातव्यं सुधियापात्रे सदा लाभजयौ क्व वा ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004101112, "chapter_id": 24101, "verse_number": "४-५०-११३", "content_sanskrit": "श्रीविष्णुरुवाच ।\nबलवानसि पक्षींद्र तन्मे वाहनतां व्रज ।\nएको वरोयं वरद द्वितीयं शृणु काश्यप ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004101113, "chapter_id": 24101, "verse_number": "४-५०-११४", "content_sanskrit": "दर्शयित्वामृतं प्राज्ञ मातृदास्यविमोक्षकम् ।\nद्विजिह्वेभ्यः कुरु तथा द्रागश्नंति न ते यथा ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004101114, "chapter_id": 24101, "verse_number": "४-५०-११५", "content_sanskrit": "देया सुधा सुधाभुग्भ्यो द्वितीयोस्तु वरो मम ।\nतथेति स प्रतिज्ञाय निर्ययौ पक्षिराड्दिवः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004101115, "chapter_id": 24101, "verse_number": "४-५०-११६", "content_sanskrit": "स मातरं विनिर्मोच्य दास्यात्काश्यपनंदनः ।\nनागानां पुरतो धृत्वा महामृतकमंडलुम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004101116, "chapter_id": 24101, "verse_number": "४-५०-११७", "content_sanskrit": "अमृतं पातुकामांस्तानित्याचष्ट महामतिः ।\nनागाः शुचित्वमासाद्य भोक्तव्यैषा सुधा शुभा ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004101117, "chapter_id": 24101, "verse_number": "४-५०-११८", "content_sanskrit": "नोचेदशुचिभिः स्पृष्टा स्नानादि परिवर्जितैः ।\nयास्यत्यदृश्यतामेषा सुधाऽनिमिषरक्षिता ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004101118, "chapter_id": 24101, "verse_number": "४-५०-११९", "content_sanskrit": "सामान्यमपि यद्रक्ष्यं स्पृश्यतेऽशुचिभिः क्वचित् ।\nहरंति तद्रसं देवास्तच्च तिष्ठति नीरसम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004101119, "chapter_id": 24101, "verse_number": "४-५०-१२०", "content_sanskrit": "इत्युक्त्वा सहितो मात्रा वैनतेयो विनिर्ययौ ।\nकुशासने च तैरुक्तो धृत्वा पीयूषभाजनम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004101120, "chapter_id": 24101, "verse_number": "४-५०-१२१", "content_sanskrit": "यावत्स्नातुं गताः सर्पास्तावत्पीयूषभाजनम् ।\nआदाय विष्णुना दत्तं देवेभ्य इव जीवितम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004101121, "chapter_id": 24101, "verse_number": "४-५०-१२२", "content_sanskrit": "आगत्य भुजगाः स्नात्वा न दृष्ट्वामृतभाजनम् ।\nअहो प्रतारिता नीतममृतं चेति चुक्रुशुः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004101122, "chapter_id": 24101, "verse_number": "४-५०-१२३", "content_sanskrit": "ततः पर्यलिहन्दर्भान्पीयूषस्पर्शकांक्षिणः ।\nआस्तां तावत्सुधा दूरं जिह्वास्तेषां द्विधाभवन् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004101123, "chapter_id": 24101, "verse_number": "४-५०-१२४", "content_sanskrit": "अन्येप्यन्यायलब्धार्थं ये बुभुक्षंति केवलम् ।\nतन्नो परिणतिं गच्छेद्भोक्तुं वातैर्न लभ्यते ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004101124, "chapter_id": 24101, "verse_number": "४-५०-१२५", "content_sanskrit": "न्यायाध्वस्थेन तार्क्ष्येण सुधा प्राप्तातिदुर्लभा ।\nलब्धाप्यन्यायतो नागैर्दृष्टमात्रा क्षणाद्गता ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004101125, "chapter_id": 24101, "verse_number": "४-५०-१२६", "content_sanskrit": "अथ दास्याद्विनिर्मुक्ता विनतोवाच खेचरम् ।\nपुत्र काशीं प्रयास्यामि दास्यपापापनुत्तये ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004101126, "chapter_id": 24101, "verse_number": "४-५०-१२७", "content_sanskrit": "तावत्पापानि जृंभंते नानाजन्मार्जितान्यपि ।\nयावत्काशी न हृत्संस्था पुनर्भवविघातिनी ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004101127, "chapter_id": 24101, "verse_number": "४-५०-१२८", "content_sanskrit": "काशीस्मरणमात्रेण किं चित्रं यदघं व्रजेत् ।\nगर्भवासोपि नश्येत विश्वेशानुग्रहात्परात् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004101128, "chapter_id": 24101, "verse_number": "४-५०-१२९", "content_sanskrit": "यत्र विश्वेश्वरः साक्षात्तारापतिविभूषणः ।\nतारयेत्तारकद्रोण्या दुस्तराद्भवसागरात् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004101129, "chapter_id": 24101, "verse_number": "४-५०-१३०", "content_sanskrit": "विश्वेशानुगृहीतानां विच्छिन्नाखिलकर्मणाम् ।\nभवेत्काशीं प्रति मतिर्नेतरेषां कदाचन ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004101130, "chapter_id": 24101, "verse_number": "४-५०-१३१", "content_sanskrit": "काशीं प्रति मनो येषां निःशेषक्षालितैनसाम् ।\nत एव मानवा लोके सत्यं नृप शवोपरे ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004101131, "chapter_id": 24101, "verse_number": "४-५०-१३२", "content_sanskrit": "तैरेव कालो विजितस्त एव हि गतैनसः ।\nअपुनर्गर्भवासास्ते प्राप्ता वाराणसीह यैः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004101132, "chapter_id": 24101, "verse_number": "४-५०-१३३", "content_sanskrit": "श्रेयसां भाजनं चैतन्नृजन्मन मुधा नयेत् ।\nदेवानामपिदुष्प्राप्यं काशीसंदर्शनादृते ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004101133, "chapter_id": 24101, "verse_number": "४-५०-१३४", "content_sanskrit": "कः कलिः कोथवा कालः किं वा कर्माण्यनेकधा ।\nपरानंदप्रदं क्षेत्रमविमुक्तं यदीक्षितम् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004101134, "chapter_id": 24101, "verse_number": "४-५०-१३५", "content_sanskrit": "ते गर्भवासे तिष्ठंति पुनस्ते गर्भवासिनः ।\nये न गर्भवनच्छेत्रीं सेवंते वरणामसिम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004101135, "chapter_id": 24101, "verse_number": "४-५०-१३६", "content_sanskrit": "निशम्येति वचः प्राह तार्क्ष्यो नत्वाथ मातरम् ।\nअहमप्यागमिष्यामि काशीं द्रष्टुं शिवार्चिताम् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004101136, "chapter_id": 24101, "verse_number": "४-५०-१३७", "content_sanskrit": "मातुराज्ञामथ प्राप्य जनन्या सह पक्षिराट् ।\nक्षणाद्वाराणसीं प्राप मोक्षनिक्षेपभूमिकाम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004101137, "chapter_id": 24101, "verse_number": "४-५०-१३८", "content_sanskrit": "उभावपि च तेपाते तप उग्रं महामती ।\nसंस्थाप्य शांभवं लिंगं पतत्त्रींद्रोऽचलेंद्रियः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004101138, "chapter_id": 24101, "verse_number": "४-५०-१३९", "content_sanskrit": "नाम्ना खखोल्कमादित्यं संस्थाप्य विनता शुभम् ।\nअचिरेणैव कालेन महतस्तपसस्तयोः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004101139, "chapter_id": 24101, "verse_number": "४-५०-१४०", "content_sanskrit": "काश्यां प्रसन्नौ संजातौ देवौ शंकरभास्करौ ।\nगरुडस्थापिताल्लिंगादाविरासीदुमापतिः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004101140, "chapter_id": 24101, "verse_number": "४-५०-१४१", "content_sanskrit": "गरुडाय वरान्प्रादात्स बहूनतिदुर्लभान् ।\nखगेंद्र मम भक्तोसि तव ज्ञानं भविष्यति ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004101141, "chapter_id": 24101, "verse_number": "४-५०-१४२", "content_sanskrit": "वेत्स्यसि त्वं रहस्यं मे यन्न ज्ञातं सुरैरपि ।\nत्वयैतत्स्थापितं लिंगं गरुडेश्वरसंज्ञितम् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004101142, "chapter_id": 24101, "verse_number": "४-५०-१४३", "content_sanskrit": "परमज्ञानदं पुंसां दृष्टं स्पृष्टं समर्चितम्॥ अन्यच्च शृणु पक्षींद्र हितं ते वच्मि सांप्रतम् ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004101143, "chapter_id": 24101, "verse_number": "४-५०-१४४", "content_sanskrit": "असावहं स वै विष्णुर्मास्तु ते भेददृक्च नौ ।\nएवं तस्यैव पक्षींद्र दैत्येंद्र बलहारिण ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004101144, "chapter_id": 24101, "verse_number": "४-५०-१४५", "content_sanskrit": "प्राप्य सत्पत्रतां पत्रिंस्त्वमप्यर्च्यो भविष्यसि ।\nइति दत्त्वा वरं शंभुः स्वभक्ताय गरुत्मते ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004101145, "chapter_id": 24101, "verse_number": "४-५०-१४६", "content_sanskrit": "तत्रैवांतर्हितो जातो गरुडोपि हरिं ययौ ।\nहरे रथत्वं संप्राप्य सोपि पूज्योऽभवद्भुवि ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004101146, "chapter_id": 24101, "verse_number": "४-५०-१४७", "content_sanskrit": "तपस्यंतीमथालोक्य कदाचिद्विनतां प्रभुः ।\nशिवस्यैव परामूर्तिः खखोल्को नाम भास्करः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004101147, "chapter_id": 24101, "verse_number": "४-५०-१४८", "content_sanskrit": "दत्त्वा वरं च पापघ्नं शिवज्ञानसमन्वितम् ।\nकाशीवासिजनानेक भवपापक्षयंकरः ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004101148, "chapter_id": 24101, "verse_number": "४-५०-१४९", "content_sanskrit": "विनतादित्य इत्याख्यः खखोल्कस्तत्र संस्थितः ।\nइत्थं खखोल्क आदित्यः काशीविघ्नतमोहरः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004101149, "chapter_id": 24101, "verse_number": "४-५०-१५०", "content_sanskrit": "तस्य दर्शनमात्रेण सर्वपापैः प्रमुच्यते ।\nकाश्यां पैशंगिले तीर्थे खखोल्कस्य विलोकनात् ।\nनरश्चिंतितमाप्नोति नीरोगो जायते क्षणात् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7004101150, "chapter_id": 24101, "verse_number": "४-५०-१५१", "content_sanskrit": "नरः श्रुत्वैतदाख्यानं खखोल्कादित्यसंभवम् ।\nगरुडेशेन सहितं सर्वपापैः प्रमुच्यते ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7004101151, "chapter_id": 24101, "verse_number": "४-५०-१५२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखण्डे पूर्वार्द्धे खखोल्कादित्य गरुडेशयोर्वर्णनंनाम पंचाशत्तमोऽध्यायः ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}]