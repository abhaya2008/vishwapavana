[{"id": 7001660000, "chapter_id": 21660, "verse_number": "१-४६-१", "content_sanskrit": "सूत उवाच ।\nतच्छृत्वा नारदो विप्रा मैथिलाध्यात्ममुत्तमम् ।\nपुनः पप्रच्छ तं प्रीत्या सनंदनमुदारधीः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001660001, "chapter_id": 21660, "verse_number": "१-४६-२", "content_sanskrit": "नारद उवाच ।\nआध्यात्मिकादित्रिविधं तापं नानुभवेद्यथा ।\nप्रब्रूहि तन्मुने मह्यं प्रपन्नाय दयानिधे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001660002, "chapter_id": 21660, "verse_number": "१-४६-३", "content_sanskrit": "सनंदन उवाच ।\nतदस्य त्रिविधं दुःखमिह जातस्य पंडित ।\nगर्भे जन्मजराद्येषुस्थानेषु प्रभविष्यतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001660003, "chapter_id": 21660, "verse_number": "१-४६-४", "content_sanskrit": "निरस्तातिशयाह्लादसुखभावैकलक्षणा ।\nभेषजं भगवत्प्राप्तिरैका चात्यंतिकी मता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001660004, "chapter_id": 21660, "verse_number": "१-४६-५", "content_sanskrit": "तस्मात्तत्प्राप्तये यत्नः कर्तव्यः पंडितैर्नरैः ।\nतत्प्राप्तिहेतुज्ञानं च कर्म चोक्तं महामुने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001660005, "chapter_id": 21660, "verse_number": "१-४६-६", "content_sanskrit": "आगमोत्थं विवेकाञ्च द्विधा ज्ञानं तथोच्यते ।\nशब्दब्रह्मागममयं परं ब्रह्मविवेकजम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001660006, "chapter_id": 21660, "verse_number": "१-४६-७", "content_sanskrit": "मनुरप्याह वेदार्थं स्मृत्वायं मुनिसत्तमः ।\nतदेतच्छ्रूयतामत्र सुबोधं गदतो मम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001660007, "chapter_id": 21660, "verse_number": "१-४६-८", "content_sanskrit": "द्वे ब्रह्मणी वेदितव्ये शब्दब्रह्म परं च यत् ।\nशब्दब्रह्मणि निष्णातः परं ब्रह्माधिगच्छति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001660008, "chapter_id": 21660, "verse_number": "१-४६-९", "content_sanskrit": "द्वे विद्ये वेदितव्ये चेत्याह चाथर्वणी श्रुतिः ।\nपरमा त्वक्षरप्राप्तिर्ऋग्वेदादिमया परा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001660009, "chapter_id": 21660, "verse_number": "१-४६-१०", "content_sanskrit": "यत्तदव्यक्तमजरमनीहमजमव्ययम् ।\nअनिर्देश्यमरूपं च पाणिपादादिसंयुतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001660010, "chapter_id": 21660, "verse_number": "१-४६-११", "content_sanskrit": "विभुं सर्वगतं नित्यं भूतयोनिमकारणम् ।\nव्याप्यं व्याप्तं यतः सर्वं तं वै पश्यंति सूरयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001660011, "chapter_id": 21660, "verse_number": "१-४६-१२", "content_sanskrit": "तद्ब्रह्म तत्परं धाम तद्ध्येयं मोक्षकांक्षिभिः ।\nश्रुतिवाक्योदितं सूक्ष्मं तद्विष्णोः परमं पदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001660012, "chapter_id": 21660, "verse_number": "१-४६-१३", "content_sanskrit": "तदेव भगवद्वाच्यं स्वरूपं परमात्मनः ।\nवाचको भगवच्छब्दस्तस्योद्दिष्टोऽक्षयात्मनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001660013, "chapter_id": 21660, "verse_number": "१-४६-१४", "content_sanskrit": "एवं निगदितार्थस्य यत्तत्वं तस्य तत्त्वतः ।\nज्ञायते येन तज्ज्ञानं परमन्यत्त्रयीमयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001660014, "chapter_id": 21660, "verse_number": "१-४६-१५", "content_sanskrit": "अशब्दगोचरस्यापि तस्य वै ब्रह्मणो द्विजा ।\nपूजायां भगवच्छब्दः क्रियते ह्यौपचारिकः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001660015, "chapter_id": 21660, "verse_number": "१-४६-१६", "content_sanskrit": "शुद्धे महाविभूत्याख्ये परे ब्रह्मणि वर्त्तते ।\nभगवन्भगवच्छब्दः सर्वकारणकारणे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001660016, "chapter_id": 21660, "verse_number": "१-४६-१७", "content_sanskrit": "ज्ञेयं ज्ञातेति तथा भकारोऽर्थद्वयात्मकः ।\nतेनागमपिता स्रष्टा गकारोऽयं तथा मुने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001660017, "chapter_id": 21660, "verse_number": "१-४६-१८", "content_sanskrit": "ऐश्वर्यस्य समग्रस्य वीर्यस्य यशसः श्रियः ।\nज्ञानवैराग्ययोश्चैव षण्णां भग इतीरणा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001660018, "chapter_id": 21660, "verse_number": "१-४६-१९", "content_sanskrit": "वसंति तत्र भूतानि भूतात्मन्यखिलात्मनि ।\nसर्वभूतेष्वशेषेषु वकारार्थस्ततोऽव्ययः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001660019, "chapter_id": 21660, "verse_number": "१-४६-२०", "content_sanskrit": "एवमेव महाशब्दो भगवानिति सत्तम ।\nपरमब्रह्मभूतस्य वासुदेवस्य नान्यगः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001660020, "chapter_id": 21660, "verse_number": "१-४६-२१", "content_sanskrit": "तत्र पूज्यपदार्थोक्तिः परिभाषासमन्वितः ।\nशब्दोऽयं नोपचारेण चान्यत्र ह्युपचारतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001660021, "chapter_id": 21660, "verse_number": "१-४६-२२", "content_sanskrit": "उत्पत्तिं प्रलयं चैव भूतानामागतिं गतिम् ।\nवेत्ति विद्यामविद्यां च स वाच्यो भगवानिति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001660022, "chapter_id": 21660, "verse_number": "१-४६-२३", "content_sanskrit": "ज्ञानशक्तिबलैश्वर्यवीर्यतेजांस्यशेषतः ।\nभगवच्छब्दवाच्यानि विना हेयैर्गुणादिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001660023, "chapter_id": 21660, "verse_number": "१-४६-२४", "content_sanskrit": "सर्वाणि तत्र भूतानि वसंति परमात्मनि ।\nभूतेषु वसनादेव वासुदेवस्ततः स्मृतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001660024, "chapter_id": 21660, "verse_number": "१-४६-२५", "content_sanskrit": "खांडिक्यं जनकं प्राह पृष्टः केशिध्वजः पुरा ।\nनामव्याख्यामनंतस्य वासुदेवस्य तत्त्वतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001660025, "chapter_id": 21660, "verse_number": "१-४६-२६", "content_sanskrit": "भूतेषु वसते सोंऽतर्वसंत्यत्र च तानि यत् ।\nधाता विधाता जगतां वासुदेवस्ततः प्रभुः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001660026, "chapter_id": 21660, "verse_number": "१-४६-२७", "content_sanskrit": "स सर्वभूतप्रकृतिं विकारं गुणादिदोषांश्च मुने व्यतीतः ।\nअतीतसर्वावरणोऽखिलात्मा तेनास्तृतं यद्भुवनांतरालम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001660027, "chapter_id": 21660, "verse_number": "१-४६-२८", "content_sanskrit": "समस्तकल्याणगुणं गुणात्मको हित्वातिदुःखावृतभूतसर्गः ।\nइच्छागृहीताभिमतोरुदेहः संसाधिताशेषजगद्धितोऽसौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001660028, "chapter_id": 21660, "verse_number": "१-४६-२९", "content_sanskrit": "तेजोबलैश्वर्यमहावबोधं स्ववीर्यशक्त्यादुगुणैकराशिः ।\nपरः पराणां सकला न यत्र क्लेशादयः संति परावरेशे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001660029, "chapter_id": 21660, "verse_number": "१-४६-३०", "content_sanskrit": "स ईश्वरो व्यष्टिसमष्टिरूपोऽव्यक्तस्वरूपः प्रकटस्वरूपः ।\nसर्वेश्वरः सर्वनिसर्गवेत्ता समस्तशक्तिः परमेश्वराख्यः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001660030, "chapter_id": 21660, "verse_number": "१-४६-३१", "content_sanskrit": "स ज्ञायते येन तदस्तदोषं शुद्धं परं निर्मलमेव रूपम् ।\nसंदृश्यते चाप्यवगम्यते च तज्ज्ञानमतोऽन्यदुक्तम् ॥३० ।.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001660031, "chapter_id": 21660, "verse_number": "१-४६-३२", "content_sanskrit": "स्वाध्यायसंयमाभ्यां स दृश्यते पुरुषोत्तमः ।\nतत्प्राप्तिकारणं ब्रह्म तवेतत्प्रतिपद्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001660032, "chapter_id": 21660, "verse_number": "१-४६-३३", "content_sanskrit": "स्वाध्यायाद्योगमासीत योगात्स्वाध्यायमामनेत् ।\nस्वाध्याययोगसंपत्त्या परमात्मा प्रकाशते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001660033, "chapter_id": 21660, "verse_number": "१-४६-३४", "content_sanskrit": "तदीक्षणाय स्वाध्यायश्चक्षुर्योगस्तथापरम् ।\nन मांसचक्षुषा द्रष्टुं ब्रह्मभूतः स शक्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001660034, "chapter_id": 21660, "verse_number": "१-४६-३५", "content_sanskrit": "॥ नारद उवाच ।\nभगवंस्तमहं योगं ज्ञातुमिच्छामि तं वद ।\nज्ञाते यन्नाखिलाधारं पश्येयं परमेश्वरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001660035, "chapter_id": 21660, "verse_number": "१-४६-३६", "content_sanskrit": "सनंदन उवाच ।\nकेशिध्वजो यथा प्राह खांडिक्याय महात्मने ।\nजनकाय पुरा योगं तथाहं कथयामि ते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001660036, "chapter_id": 21660, "verse_number": "१-४६-३७", "content_sanskrit": "नारद उवाच ।\nखांङिक्यः कोऽभवद्बह्यन्को वा केशिध्वजोऽभवत् ।\nकथं तयोश्च संवादो योगसंबन्धवानभूत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001660037, "chapter_id": 21660, "verse_number": "१-४६-३८", "content_sanskrit": "सनंदन उवाच ।\nधर्मध्वजो वै जनक तस्य पुशेऽमितध्वजः ।\nकृतध्वजोऽस्य भ्राताभूत्सदाध्यात्मरतिर्नृपः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001660038, "chapter_id": 21660, "verse_number": "१-४६-३९", "content_sanskrit": "कृतध्वजस्य पुत्रोऽभूद्धन्यः केशिध्वजो द्विजः ।\nपुत्रोऽमितव्वजस्यापि खांडिक्यजनकाभिधः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001660039, "chapter_id": 21660, "verse_number": "१-४६-४०", "content_sanskrit": "कर्ममार्गे हि खांडिक्यः स्वराज्यादवरोपितः ।\nपुरोधसा मंत्रिभिश्च समवेतोऽल्पसाधनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001660040, "chapter_id": 21660, "verse_number": "१-४६-४१", "content_sanskrit": "राज्यान्निराकृतः सोऽथ दुर्गारण्यचरोऽभवत् ।\nइयाज सोऽपि सुबहून यज्ञाञ्ज्ञानव्यपाश्रयः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001660041, "chapter_id": 21660, "verse_number": "१-४६-४२", "content_sanskrit": "ब्रह्मविद्यामधिष्टाय तर्तुं मृत्युमपि स्वयम् ।\nएकदा वर्तमानस्य यागे योगविदां वर ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001660042, "chapter_id": 21660, "verse_number": "१-४६-४३", "content_sanskrit": "तस्य धेनुं जघानोग्रः शार्दूलो विजने वने ।\nततो राजा हतां ज्ञात्वा धेनुं व्याघ्रेण चर्त्विजः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001660043, "chapter_id": 21660, "verse_number": "१-४६-४४", "content_sanskrit": "प्रायश्चित्तं स पप्रच्छ किमत्रेति विधीयताम् ।\nते चोचुर्नवयंविद्मः कशेरुः पृच्छ्यतामिति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001660044, "chapter_id": 21660, "verse_number": "१-४६-४५", "content_sanskrit": "कशेरुरपि तेनोक्तस्तथेति प्राह नारद ।\nशुनकं पृच्छ राजेन्द्र वेद स वेत्स्यति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001660045, "chapter_id": 21660, "verse_number": "१-४६-४६", "content_sanskrit": "स गत्वा तमपृच्छञ्च सोऽप्याह नृपतिं मुने ।\nन कशेरुर्नचैवाहं न चान्यः सांप्रतं भुवि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001660046, "chapter_id": 21660, "verse_number": "१-४६-४७", "content_sanskrit": "वेत्त्येक एव त्वच्छत्रुः खांडिक्यो यो जितस्त्वया ।\nस चाह तं व्रजाम्येष प्रष्टुमात्मरिपुं मुने ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001660047, "chapter_id": 21660, "verse_number": "१-४६-४८", "content_sanskrit": "प्राप्त एव मया यज्ञे यदि मां स हनिष्यति ।\nप्रायश्चित्तं स चेत्पृष्टो वदिष्यति रिपुर्मम ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001660048, "chapter_id": 21660, "verse_number": "१-४६-४९", "content_sanskrit": "ततश्चाविकलो योगो मुनिश्रेष्ट भविष्यति ।\nइत्युक्त्वा रथमारुह्य कृष्णाजिनधरो नृपः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001660049, "chapter_id": 21660, "verse_number": "१-४६-५०", "content_sanskrit": "वनं जगाम यत्रास्ते खांडिक्यः स महीपतिः ।\nतमायांतं समालोक्य खांजडिक्यो रिपुमात्मनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001660050, "chapter_id": 21660, "verse_number": "१-४६-५१", "content_sanskrit": "प्रोवाच क्रोधताम्राक्षः समारोपितकार्मुकः ।\nखांडिक्य उवाच ।\nकृष्णाजिनत्वक्कवचभावेनास्मान्हनिष्यसि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001660051, "chapter_id": 21660, "verse_number": "१-४६-५२", "content_sanskrit": "कृष्णाजिनधरे वेत्सि न मयि प्रहरिष्यति ।\nमृगानां वद पृष्टेषु मूढ कृष्णाजिनं न किम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001660052, "chapter_id": 21660, "verse_number": "१-४६-५३", "content_sanskrit": "येषां मत्वा वृथा चोग्राः प्रहिताः शितसायकाः ।\nस त्वामहं हनिष्यामि न मे जीवन्विमोक्ष्यसे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001660053, "chapter_id": 21660, "verse_number": "१-४६-५४", "content_sanskrit": "आतताय्यसि दुर्बुद्धे मम राज्यहरो रिपुः ।\nकेशिध्वज उवाच ।\nखांडिक्य संशयं प्रष्टुं भवंतमहमागतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001660054, "chapter_id": 21660, "verse_number": "१-४६-५५", "content_sanskrit": "न त्वां हंतुं विचार्यतैत्कोपं बाणं च मुंच वा ।\nततः स मंत्रिभिः सार्द्धमेकांते सपुरोहितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001660055, "chapter_id": 21660, "verse_number": "१-४६-५६", "content_sanskrit": "मंत्रयामास खांडिक्यः सर्वैरेव महामतिः ।\nतमूर्मंत्रिणो वध्यो रिपुरेष वशंगतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001660056, "chapter_id": 21660, "verse_number": "१-४६-५७", "content_sanskrit": "हतेऽत्र पृथिवी सर्वा तव वश्या भविष्यति ।\nखांडिक्यश्चाह तान्सर्वानेवमेव न संशयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001660057, "chapter_id": 21660, "verse_number": "१-४६-५८", "content_sanskrit": "हते तु पृथिवी सर्वा मम वश्या भविष्यति ।\nपरलोकजयस्तस्य पृथिवी सकला मम ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001660058, "chapter_id": 21660, "verse_number": "१-४६-५९", "content_sanskrit": "न हन्मि चेल्लोकजयो मम वयत्वस्सुंधरा ।\nपरलोकजयोऽनंतः स्वल्पकालो महीजयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001660059, "chapter_id": 21660, "verse_number": "१-४६-६०", "content_sanskrit": "तस्मान्नैनं हनिष्येऽहं यत्पृच्छति वदामि तत् ।\nततस्तमभ्युपेत्याह खांडिक्यो जनको रिपुम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001660060, "chapter_id": 21660, "verse_number": "१-४६-६१", "content_sanskrit": "प्रष्टव्यं यत्त्वया सर्वं तत्पृच्छ त्वं वदाम्यहम् ।\nततः प्राह यथावृत्तं होमधेनुवधं मुने ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001660061, "chapter_id": 21660, "verse_number": "१-४६-६२", "content_sanskrit": "ततश्च तं स पप्रच्छ प्रायश्चित्तं हि तद्रूतम् ।\nस चाचष्ट यथान्यायं मुने केशिध्वजाय तत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001660062, "chapter_id": 21660, "verse_number": "१-४६-६३", "content_sanskrit": "प्रायश्चित्तमशेषं हि यद्वै तत्र विधीयते ।\nविदितार्थः स तेनैवमनुज्ञातो महात्मना ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001660063, "chapter_id": 21660, "verse_number": "१-४६-६४", "content_sanskrit": "यागभूमिमुपागत्य चक्रे सर्वां क्रियां क्रमत् ।\nक्रमेण विधिवद्यागं नीत्वा सोऽवभृथाप्लुतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001660064, "chapter_id": 21660, "verse_number": "१-४६-६५", "content_sanskrit": "कृतकृत्यस्ततो भूत्वा चिंतयामास पार्थिवः ।\nपूजिता ऋत्विजः सर्वे सदस्या मानिता मया ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001660065, "chapter_id": 21660, "verse_number": "१-४६-६६", "content_sanskrit": "तथैवार्थिजनोऽप्यर्थोजितोऽभिमतैर्मया ।\nयथाहं मर्त्यलोकस्य मया सर्वं विचष्टितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001660066, "chapter_id": 21660, "verse_number": "१-४६-६७", "content_sanskrit": "अनिष्पन्नक्रियं चेतस्तथा न मम किं यथा ।\nइत्थं तु चिंतयन्नेव सम्मार स महीपतिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001660067, "chapter_id": 21660, "verse_number": "१-४६-६८", "content_sanskrit": "खांडिक्याय न दत्तेति मया वैगुरुदक्षिणा ।\nस जगाम ततो भूयो रथमारुह्य पार्थिवः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001660068, "chapter_id": 21660, "verse_number": "१-४६-६९", "content_sanskrit": "स्वायंभुवः स्थितो यत्र खांडिक्योऽरण्यदुर्गमम् ।\nखांडिक्योऽपि पुनर्द्दष्ट्वा तमायान्तं धृतायुधः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001660069, "chapter_id": 21660, "verse_number": "१-४६-७०", "content_sanskrit": "तस्थौ हंतुं कृतमतिस्ममाह स पुनर्नृपः ।\nअहं तु नापकाराय प्राप्तः खांडिक्य मा क्रुधः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001660070, "chapter_id": 21660, "verse_number": "१-४६-७१", "content_sanskrit": "गुरोर्निष्कृतिदानाय मामवेहि सेमागतम् ।\nनिष्पादितो मया यागः सम्यक् त्वदुपदेशतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001660071, "chapter_id": 21660, "verse_number": "१-४६-७२", "content_sanskrit": "सोऽहं ते दातुमिच्छामि वृणीष्व गुरुदक्षिणाम् ।\nइत्युक्तो मंत्रयामास स भूयो मंत्रिभिः सह ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001660072, "chapter_id": 21660, "verse_number": "१-४६-७३", "content_sanskrit": "गुरोर्निष्कृतिकामोऽय किमयं प्रार्थ्यतां मया ।\nतमूचुर्मंत्रिणो राज्यमशेषं याच्यतामयम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001660073, "chapter_id": 21660, "verse_number": "१-४६-७४", "content_sanskrit": "कृताभिः प्रार्थ्यते राज्यमनायासितसैनिकैः ।\nप्राहस्य तानाह नृपः स खांडिक्यो महापतिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001660074, "chapter_id": 21660, "verse_number": "१-४६-७५", "content_sanskrit": "स्वल्पकालं महीराज्यं मादृशैः प्रार्थ्यते कथम् ।\nएतमेतद्भंवतोऽत्र स्वार्थ साधनमंत्रिणः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001660075, "chapter_id": 21660, "verse_number": "१-४६-७६", "content_sanskrit": "परमार्थः कथं कोऽत्र यूयं नात्र विचक्षणाः ।\nइत्युक्त्वा समुपेत्यैंनं स तु केशिध्वजं नृपम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001660076, "chapter_id": 21660, "verse_number": "१-४६-७७", "content_sanskrit": "उवाच किमवश्यं त्वं दास्यसि गुरुदक्षिणाम् ।\nबाढमित्येव तेनोक्तः खांडिक्यस्तमथाब्रवीत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001660077, "chapter_id": 21660, "verse_number": "१-४६-७८", "content_sanskrit": "भवानध्यात्मविज्ञानपरमार्थविचक्षणः ।\nयदि चेद्दीयते मह्यं भवता गुरुनिष्क्रयः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001660078, "chapter_id": 21660, "verse_number": "१-४६-७९", "content_sanskrit": "तत्क्लेशप्रशमायालं यत्कर्म तदुदीरय ।\nकेशिध्वज उवाच ।\nन प्रार्थितं त्वया कस्मान्मम राज्यमकंटकम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001660079, "chapter_id": 21660, "verse_number": "१-४६-८०", "content_sanskrit": "राज्यलाभाः द्धि नास्त्यन्यत्क्षत्रियाणामतिप्रियम् ।\nखांडिक्य उवाच ।\nकेशिध्वज निबोध त्वं मया न प्रार्थितं यतः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001660080, "chapter_id": 21660, "verse_number": "१-४६-८१", "content_sanskrit": "राज्यमेतदशेषेण यन्न गृघ्रंति पंडिताः ।\nक्षत्रियाणामयं धर्मो यत्प्रजापरिपालनम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001660081, "chapter_id": 21660, "verse_number": "१-४६-८२", "content_sanskrit": "वधश्च धर्मयुद्धेन स्वराज्यपरिपंथिनाम् ।\nयत्राशक्तस्य मे दोषो नैवास्त्यपकृते त्वया ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001660082, "chapter_id": 21660, "verse_number": "१-४६-८३", "content_sanskrit": "बंधायैव भवत्येषा ह्यविद्या चाक्रमोज्झिता ।\nजन्मोपभोगलिप्सार्थमियं राज्यस्पृहा मम ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001660083, "chapter_id": 21660, "verse_number": "१-४६-८४", "content_sanskrit": "अन्येषां दोपजानेव धर्ममेवानुरुध्यते ।\nन याच्ञा क्षत्रबंधूनां धर्मायैतत्सतां मतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001660084, "chapter_id": 21660, "verse_number": "१-४६-८५", "content_sanskrit": "अतो न याचित राज्यमविद्यांतर्गतं तव ।\nराज्यं गृध्नंति विद्वांसो ममत्वाकृष्टचेतसः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001660085, "chapter_id": 21660, "verse_number": "१-४६-८६", "content_sanskrit": "अहंमानमह्य पानमदमत्ता न मादृशाः ।\nकेशिध्वज उवाच ।\nअहं च विद्यया मृत्युं तर्तुकामः करोमि वै ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001660086, "chapter_id": 21660, "verse_number": "१-४६-८७", "content_sanskrit": "राज्यं यज्ञांश्च विविधान्भोगे पुण्यक्षयं तथा ।\nतदिदं ते मनो दिष्ट्या विवेकैश्चर्यतां गतम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001660087, "chapter_id": 21660, "verse_number": "१-४६-८८", "content_sanskrit": "श्रूयतां चाप्यविद्यायाः स्वरूपं कुलनंदन ।\nअनात्मन्यात्मबुद्धिर्या ह्यस्वे स्वविषया मतिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001660088, "chapter_id": 21660, "verse_number": "१-४६-८९", "content_sanskrit": "अविद्यातरुसंन्भूतं बीजमेतद्द्विधा स्थितम् ।\nपंचभूतात्मके देहे देही मोहतमोवृत्तः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001660089, "chapter_id": 21660, "verse_number": "१-४६-९०", "content_sanskrit": "अहमेतदितीत्युञ्चैः कुरुते कुमतिर्मतिम् ।\nआकाशवाय्वग्रिजलपृथिवीभिः पृथक् स्थिते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001660090, "chapter_id": 21660, "verse_number": "१-४६-९१", "content_sanskrit": "आत्मन्यात्ममयं भावं कः करोति कलेवरे ।\nकलेवरोपभोग्यं हि गृहक्षेत्रादिकं च यत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001660091, "chapter_id": 21660, "verse_number": "१-४६-९२", "content_sanskrit": "अदेहे ह्यात्मनि प्राज्ञो ममेदमिति मन्यते ।\nइत्थं च पुत्रपौत्रेषु तद्देहोत्पादितेषु च ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001660092, "chapter_id": 21660, "verse_number": "१-४६-९३", "content_sanskrit": "करोति पंडितः स्वाम्यमनात्मनि कलेवरे ।\nसर्वदेहोपभोगाय कुरुते कर्म मानवः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001660093, "chapter_id": 21660, "verse_number": "१-४६-९४", "content_sanskrit": "देहं चान्यद्यदा पुंसस्सदा बंधाय तत्परम् ।\nमृण्मयं हि यथा गेहं लिप्यते वै मृदंभसा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001660094, "chapter_id": 21660, "verse_number": "१-४६-९५", "content_sanskrit": "पार्थिवोऽयं तथा देहो मृदंभोलेपनस्थितिः ।\nपंचभोगात्मकैर्भोगैः पंचभोगात्मकं वपुः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001660095, "chapter_id": 21660, "verse_number": "१-४६-९६", "content_sanskrit": "आप्यायते यदि ततः पुंसो गर्वोऽत्र किंकृतः ।\nअनेकजन्मसाहस्त्रं ससारपदवीं व्रजन् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001660096, "chapter_id": 21660, "verse_number": "१-४६-९७", "content_sanskrit": "मोहश्रमं प्रयातोऽसौ वासनारेणुगुंठितः ।\nप्रक्षाल्यते यदा सौम्य रेणुर्ज्ञानोष्णवारिणा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001660097, "chapter_id": 21660, "verse_number": "१-४६-९८", "content_sanskrit": "तदा संसारपांथस्य याति मोहश्रमः शमम् ।\nमोहश्रमे शमं याते स्वच्छांतःकरणः पुमान् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001660098, "chapter_id": 21660, "verse_number": "१-४६-९९", "content_sanskrit": "अनन्यातिशयाधारः परं निर्वाणमृच्छति ।\nनिर्वाणमय एवायमात्मा ज्ञानमयोऽमलः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001660099, "chapter_id": 21660, "verse_number": "१-४६-१००", "content_sanskrit": "दुःखाज्ञानमया धर्माः प्रकृतेस्ते तुनात्मनः ।\nजलस्य नाग्निना संगः स्थालीसंगात्तथापि हि ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001660100, "chapter_id": 21660, "verse_number": "१-४६-१०१", "content_sanskrit": "शब्दोद्रेकादिकान्धर्मान्करोति हि यथा बुधः ।\nतथात्मा प्रकृतेः संगादहंमानादिदूषितः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001660101, "chapter_id": 21660, "verse_number": "१-४६-१०२", "content_sanskrit": "भजते प्राकृतान्धर्मान्न्यस्तस्तंभो हि सोऽव्ययः ।\nतदेतत्कथितं बीजमविद्याया मया तव ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001660102, "chapter_id": 21660, "verse_number": "१-४६-१०३", "content_sanskrit": "क्लेशानां च क्षयकरं योगादन्यन्न विद्यते ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]