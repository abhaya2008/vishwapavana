[{"id": 2168481, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168482, "chapter_id": 4613, "verse_number": "१", "content_sanskrit": "भूय एव तु मद्रेश यत्त्वां वक्ष्यामि तच्छृणु ।\nयथा पुरावृत्तमिदं युद्धे देवासुरे प्रभो\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168483, "chapter_id": 4613, "verse_number": "२", "content_sanskrit": "यदुक्तवान् पितुर्मह्यं मार्कण्डेयो महातपाः ।\nब्रुवतस्तदशेषेण मम राजर्षिसत्तम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168484, "chapter_id": 4613, "verse_number": "३", "content_sanskrit": "निबोध मनसा चात्र न ते कार्या विचारणा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168485, "chapter_id": 4613, "verse_number": "४", "content_sanskrit": "देवानामसुराणां च महानासीत् समुच्छ्रयः ।\n(सैंहिकेयास्तदोद्वृत्ता विबुधानवसूदयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168486, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "ते निरस्ताः कृता देवैर्दानवा बलगर्विताः\t॥५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168487, "chapter_id": 4613, "verse_number": "६", "content_sanskrit": "तत्रासीत्प्रथमो राजन् सङ्ग्रामस्तारकामयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168488, "chapter_id": 4613, "verse_number": "७", "content_sanskrit": "कश्चित् प्रजापतिर्घोरस्तेन सार्धं दुरात्मना ।\nयुद्धमासीत् महाघोरं देवानामिति नः श्रुतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168489, "chapter_id": 4613, "verse_number": "८", "content_sanskrit": "पराबभूवुरसुरा दैवतैः सह संयुगे ।\nदेवैर्निरस्ता ह्यसुरा निश्वस्ता मर्दितास्ततः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168490, "chapter_id": 4613, "verse_number": "९", "content_sanskrit": "निर्जिताश्च ततो दैत्या दैवतैरिति नः श्रुतिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168491, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "(भग्नदर्पा निरुत्साहाः पातालं विविशुस्तदा\t॥१०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168492, "chapter_id": 4613, "verse_number": "११", "content_sanskrit": "निर्जितेषु च दैत्येषु तारकस्य सुतास्त्रयः ।\nताराक्षः कमलाक्षश्च विद्युन्माली च पार्थिव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168493, "chapter_id": 4613, "verse_number": "१२", "content_sanskrit": "तप उग्रं समास्थाय नियमे परमे स्थिताः ।\nतपसा कर्शयामासुर्देहांस्तान् शत्रुकर्शनाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168494, "chapter_id": 4613, "verse_number": "१३", "content_sanskrit": "दमेन तपसा चैव नियमेन समाधिना ।\nतेषां पितामहः प्रीतो वरदः प्रददौ वरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168495, "chapter_id": 4613, "verse_number": "१४", "content_sanskrit": "अवध्यत्वं च ते सर्वे सर्वभूतेषु सर्वदा ।\nसहिता वरयामासुः सर्वलोकपितामहम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168496, "chapter_id": 4613, "verse_number": "१५", "content_sanskrit": "तानब्रवीत् तदा देवः सर्वलोकगुरुः प्रभुः ।\nनास्ति सर्वामरत्वं वै निवर्तध्वमितोऽसुराः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168497, "chapter_id": 4613, "verse_number": "१६", "content_sanskrit": "अन्यं वरं वृणीध्वं वै रोचते यादृशो हि वः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168498, "chapter_id": 4613, "verse_number": "१७", "content_sanskrit": "ततस्ते सहिता राजन् सम्प्रधार्यासकृद् बहु ।\nसर्वलोकेश्वरं वाक्यं प्रणम्यैनमथाऽब्रुवन्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168499, "chapter_id": 4613, "verse_number": "१८", "content_sanskrit": "(वस्तुमिच्छाम नगरं कर्तुं कामगमं शुभम् ।\nसर्वकामसमृद्धार्थमवध्यं देवदानवैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168500, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "यक्षरक्षोरगगणैर्नानाजातिभिरेव च ।\nन कृत्याभिर्न शस्त्रैश्च न शापैर्ब्रह्मवादिनाम्\t॥१९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168501, "chapter_id": 4613, "verse_number": "२०", "content_sanskrit": "वध्येत त्रिपुरं देव प्रयच्छेमं पितामह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168502, "chapter_id": 4613, "verse_number": "२१", "content_sanskrit": "वयं पुराणि त्रीण्येव समास्थाय महीमिमाम् ।\nविचरिष्याम लोकेऽस्मिन् त्वत्प्रसादपुरस्कृताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168503, "chapter_id": 4613, "verse_number": "२२", "content_sanskrit": "ततो वर्षसहस्रेषु समेष्यामः परस्परम् ।\nएकीभावं गमिष्यन्ति पुराण्येतानि चानघ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168504, "chapter_id": 4613, "verse_number": "२३", "content_sanskrit": "समागतानि चैतानि यो हन्याद् भगवांस्तदा ।\nएकेषुणा देववरः स नो मृत्युर्भविष्यति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168505, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168506, "chapter_id": 4613, "verse_number": "२४", "content_sanskrit": "(तेषां तद्वचनं श्रुत्वा दानवानां पितामहः ।)\nएवमस्त्विति तान् देवः प्रत्युक्त्वा प्राविशद् दिवम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168507, "chapter_id": 4613, "verse_number": "२५", "content_sanskrit": "ते तु लब्धवराः प्रीताः सम्प्रधार्य परस्परम् ।\nपुरत्रयविसृष्ट्यर्थं मयं वव्रुर्महारथाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168508, "chapter_id": 4613, "verse_number": "२६", "content_sanskrit": "विश्वकर्माणमजरं दैत्यदानवपूजितम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168509, "chapter_id": 4613, "verse_number": "२७", "content_sanskrit": "ततो मयः स्वतपसा चक्रे धीमान् पुराणि च ।\nत्रीणि काञ्चनमेकं वै रौप्यं कार्ष्णायसं तथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168510, "chapter_id": 4613, "verse_number": "२८", "content_sanskrit": "काञ्चनं दिवि तत्रासीदन्तरिक्षे च राजतम् ।\nआयसं चाभवद् भौमं तदा तेषां परन्तप\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168511, "chapter_id": 4613, "verse_number": "२९", "content_sanskrit": "एकैकं योजनशतं विस्तृतं तावदायतम् ।\nदृढं चाट्टालकयुतं बृहत्प्राकारतोरणम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168512, "chapter_id": 4613, "verse_number": "३०", "content_sanskrit": "गृहप्रवरसम्बाधमसम्बाधमहापथम् ।\nप्रासादैर्विविधैश्चापि द्वारैश्चैवोपशोभितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168513, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "(त्रिपुरं तेषु चाप्यासन् राजानो वै पृथक्पृथक् ।\nदिव्यमाल्याम्बरधरा दैतेया राजसत्तम\t॥३१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168514, "chapter_id": 4613, "verse_number": "३२", "content_sanskrit": "काञ्चनं तारकाक्षस्य दिव्यमासीन्महात्मनः ।\nराजतं कमलाक्षस्य विद्युन्मालिन आयसम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168515, "chapter_id": 4613, "verse_number": "३३", "content_sanskrit": "त्रयस्ते दैत्यराजानस्त्रीन् लोकानाशु तेजसा ।\nआक्रम्य तस्थुरूचुश्च कश्च नाम प्रजापतिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168516, "chapter_id": 4613, "verse_number": "३४", "content_sanskrit": "तेषां दानवमुख्यानां प्रयुतान्यर्बुदानि च ।\nकोट्यश्चाप्रतिवीराणां समाजग्मुस्ततस्ततः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168517, "chapter_id": 4613, "verse_number": "३५", "content_sanskrit": "मांसाशिनः सुदृप्ताश्च सुरैर्विनिकृताः पुरा ।\nमहदैश्वर्यमिच्छन्तस्त्रिपुरं दुर्गमाश्रिताः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168518, "chapter_id": 4613, "verse_number": "३६", "content_sanskrit": "सर्वेषां च पुनश्चैषां सर्वयोगवहो मयः ।\nतमाश्रित्य हि ते सर्वेऽवर्तयन्नकुतोभयाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168519, "chapter_id": 4613, "verse_number": "३७", "content_sanskrit": "यो हि यं मनसा कामं दध्यौ त्रिपुरसंश्रयः ।\nतस्मै तस्मै मयस्तं तं विदधे मायया तदा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168520, "chapter_id": 4613, "verse_number": "३८", "content_sanskrit": "तारकाक्षसुतश्चासीद्धरिर्नाम महाबलः ।\nतपस्तेपे परमकं येनातुष्यत् पितामहः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168521, "chapter_id": 4613, "verse_number": "३९", "content_sanskrit": "सन्तुष्टमवृणोद् देवं वापी भवतु नः पुरे ।\nशस्त्रैर्विनिहता यत्र क्षिप्ताः स्युर्बलवत्तराः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168522, "chapter_id": 4613, "verse_number": "४०", "content_sanskrit": "स तु लब्ध्वा वरं वीरस्तारकाक्षसुतो हरिः ।\nससृजे तत्र वापीं तां मृतसञ्जीविनीं प्रभो\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168523, "chapter_id": 4613, "verse_number": "४१", "content_sanskrit": "येन रूपेण यो दैत्यो येन वेषेण चाप्यथ ।\nक्षिप्यते निहतो वाप्यां तादृशेनैव जायते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168524, "chapter_id": 4613, "verse_number": "४२", "content_sanskrit": "(सम्पूर्णबलवीर्यस्तु राजन् शौर्यसमन्वितः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168525, "chapter_id": 4613, "verse_number": "४३", "content_sanskrit": "एवं वीर्येण संयुक्ताः कृतास्तेन महात्मना ।)\nतां प्राप्य त्रैपुरा वापीं लोकान् सर्वान् बबाधिरे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168526, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "महता तपसा सिद्धाः सुराणां भयवर्धनाः ।\n(एकस्मिन्निहते दैत्ये सृजति स्म दशासुरान्\t॥४४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168527, "chapter_id": 4613, "verse_number": "४५", "content_sanskrit": "न तेषां विद्यते युद्धे क्षयो राजन् कथञ्चन\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168528, "chapter_id": 4613, "verse_number": "४६", "content_sanskrit": "ततस्ते लोभमोहाभ्यामभिभूता विचेतसः ।\nनिर्भीकाः संस्थितिं सर्वे स्थापितां समलूलुपन्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168529, "chapter_id": 4613, "verse_number": "४७", "content_sanskrit": "विद्राव्य सगणान् देवांस्तत्र तत्र तदा तदा ।\nविचेरुः स्वेन कामेन वरदानेन दर्पिताः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168530, "chapter_id": 4613, "verse_number": "४८", "content_sanskrit": "देवोद्यानानि सर्वाणि स्थानानि च दिवौकसाम् ।\nऋषीणामाश्रमान् पुण्यान् रम्यान् जनपदांस्तथा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2168531, "chapter_id": 4613, "verse_number": "४९", "content_sanskrit": "उत्सादयन्त मर्यादां दानवा दुष्टचारिणः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2168532, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "(निःस्थानाश्च कृता देवा ऋषयः पितृभिः सह ।\nदैत्यैस्त्रिभिस्त्रयो लोका ह्याक्रान्तास्तैः सुरेतरैः\t॥५०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2168533, "chapter_id": 4613, "verse_number": "५१", "content_sanskrit": "पीड्यमानेषु लोकेषु ततः शक्रो मरुद्वृतः ।\nपुराण्यायोधयाञ्चक्रे वज्रहस्तः समन्ततः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2168534, "chapter_id": 4613, "verse_number": "५२", "content_sanskrit": "नाशकत् तान्यभेद्यानि यदा भेत्तुं पुरन्दरः ।\nपुराणि वरदत्तानि धात्रा तेन नराधिप\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2168535, "chapter_id": 4613, "verse_number": "५३", "content_sanskrit": "तदा भीतः सुरपतिर्मुक्त्वा तानि पुराण्यथ ।\nतैरेव विबुधैः सार्धं पितामहमरिन्दम\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2168536, "chapter_id": 4613, "verse_number": "५४", "content_sanskrit": "जगामाथ तदाख्यातुं विप्रकारं सुरेतरैः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2168537, "chapter_id": 4613, "verse_number": "५५", "content_sanskrit": "ते तत्त्वं सर्वमाख्याय शिरोभिः सम्प्रणम्य च ।\nतद्वधोपायमाचक्ष्व भगवन्निति चाब्रुवन्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2168538, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "(श्रुत्वा तद् भगवान् देवो देवानिदमुवाच ह ।\nश्रूयतां त्रिदशाः सर्वे यथेदं वाक्यगौरवम्\t॥५६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2168539, "chapter_id": 4613, "verse_number": "५७", "content_sanskrit": "ममापि सोऽपराध्नोति यो युष्माकमसौख्यकृत् ।\nअसुराश्च दुरात्मानः सर्व एव सुरद्विषः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2168540, "chapter_id": 4613, "verse_number": "५८", "content_sanskrit": "दुरात्मानोऽसुरा नित्यं ते चापि विबुधा मम ।\nअपराद्ध्यन्ति सततं युष्मान् वै पीडयन्ति ते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2168541, "chapter_id": 4613, "verse_number": "५९", "content_sanskrit": "अहं समस्तु सर्वेषां भूतानां नात्र संशयः ।\n(अविनीता निहन्तव्या इत्येवं प्रब्रवीमि वः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2168542, "chapter_id": 4613, "verse_number": "६०", "content_sanskrit": "एकेषुणा (हि) विभेद्यानि तानि दुर्गाणि नान्यथा ।\nशक्तस्तु तानि बाणेन भेत्तुं कामं त्रिलोचनः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2168543, "chapter_id": 4613, "verse_number": "६१", "content_sanskrit": "ते यूयं स्थाणुमीशानं जिष्णुमक्लिष्टकारिणम् ।\nयोद्धारं वृणुत क्षिप्रं स तान् हन्ता सुरेतरान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2168544, "chapter_id": 4613, "verse_number": "६२", "content_sanskrit": "ते देवास्तेन वाक्येन चोदिताः प्रणताः स्थिताः ।\nदिव्यं वर्षसहस्रं वै तपस्तप्त्वा सुरर्षभाः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2168545, "chapter_id": 4613, "verse_number": "६३", "content_sanskrit": "शुभात्मानो महात्मानो जग्मुर्वै वृषभध्वजम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2168546, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "ब्रह्माणमग्रतः कृत्वा शरण्यं शरणागताः ।\nतपः परममाजग्मुर्गृणन्तो ब्रह्म शाश्वतम्\t॥६४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2168547, "chapter_id": 4613, "verse_number": "६५", "content_sanskrit": "अनङ्गमथनं सर्वे भवं सर्वात्मना गताः ।\nदेवदेवं परं स्थाणुं वरदं त्र्यम्बकं शिवम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2168548, "chapter_id": 4613, "verse_number": "६६", "content_sanskrit": "शर्वमीड्यमजं रुद्रं शशाङ्काङ्कितमूर्धजम् ।\nतुष्टुवुर्वाग्भिरग्राभिर्भयेष्वभयमच्युतम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2168549, "chapter_id": 4613, "verse_number": "६७", "content_sanskrit": "सर्वात्मानं महात्मानं येनाप्तं विश्वमात्मना\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2168550, "chapter_id": 4613, "verse_number": "६८", "content_sanskrit": "तपोविशेषैर्विविधैर्योगं यो वेद चात्मना ।\nयः साङ्ख्यमात्मना वेत्ति यस्य चात्मा वशे सदा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2168551, "chapter_id": 4613, "verse_number": "", "content_sanskrit": "तं ते ददृशुरीशानं तेजोराशिमुमापतिम् ।\n(परेण यत्नेन भवं त्रिदशाः शर्वमीश्वरम्\t॥६९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2168552, "chapter_id": 4613, "verse_number": "७०", "content_sanskrit": "अनन्यसदृशं लोके प्रतपन्तमकल्मषम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2168553, "chapter_id": 4613, "verse_number": "७१", "content_sanskrit": "एकं च भगवन्तं ते नानारूपमकल्पयन् ।\nआत्मनः प्रतिरूपाणि रूपाण्यथ महात्मनि\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2168554, "chapter_id": 4613, "verse_number": "७२", "content_sanskrit": "परस्परस्य चापश्यन् सर्वे परमविस्मिताः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2168555, "chapter_id": 4613, "verse_number": "७३", "content_sanskrit": "सर्वभूतमयं दृष्ट्वा तमजं जगतः पतिम् ।\nदेवा ब्रह्मर्षयश्चैव शिरोभिर्धरणीं गताः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2168556, "chapter_id": 4613, "verse_number": "७४", "content_sanskrit": "तान् स्वस्तिवाच्य चाभ्यर्च्य समुत्थाप्य च शङ्करः ।\nबूत ब्रूतेति भगवान् स्मयमानोऽभ्यभाषत\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2168557, "chapter_id": 4613, "verse_number": "७५", "content_sanskrit": "त्र्यम्बकेणाभ्यनुज्ञातास्ततस्ते स्वस्थचेतसः ।\nनमो नमो नमस्तेऽस्तु प्रभो इत्यब्रुवन् भवम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2168558, "chapter_id": 4613, "verse_number": "७६", "content_sanskrit": "नमो देवाधिदेवाय धन्विने चातिमन्यवे ।\nप्रजापतिमखघ्नाय प्रजापतिभिरीड्यते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2168559, "chapter_id": 4613, "verse_number": "७७", "content_sanskrit": "नमः स्तुताय स्तुत्याय स्तूयमानाय शम्भवे ।\nविलोहिताय चोग्राय नीलरुद्राय शूलिने\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2168560, "chapter_id": 4613, "verse_number": "७८", "content_sanskrit": "अमोघाय मृगाक्षाय सूक्ष्माय सुधनाय च ।\nअर्हाय चैव शुक्लाय क्षमाय क्रथनाय च\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2168561, "chapter_id": 4613, "verse_number": "७९", "content_sanskrit": "ईशानायाप्रमेयाय निहन्त्रे चीरवाससे\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2168562, "chapter_id": 4613, "verse_number": "८०", "content_sanskrit": "तपोरताय पिङ्गाय व्रतिने कृत्तिवाससे ।\nकुमारपित्रे त्र्यक्षाय प्रवरायुधधारिणे\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2168563, "chapter_id": 4613, "verse_number": "८१", "content_sanskrit": "प्रपन्नार्तिविनाशाय ब्रह्मद्विट्सङ्घघातिने ।\nवनस्पतीनां पतये वनानां पतये नमः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2168564, "chapter_id": 4613, "verse_number": "८२", "content_sanskrit": "गवां च पतये नित्यं यज्ञानां पतये नमः ।\nनमोस्तु ते ससैन्याय त्र्यम्बकायामितौजसे\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2168565, "chapter_id": 4613, "verse_number": "८३", "content_sanskrit": "मनोवाक्कर्मभिर्देव त्वां प्रपन्नान् भजस्व नः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2168566, "chapter_id": 4613, "verse_number": "८४", "content_sanskrit": "ततः प्रसन्नो भगवान् स्वागतेनाभिनन्द्य च ।\nप्रोवाच व्येतु वस्त्रासो ब्रूत किं करवाणि वः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2168567, "chapter_id": 4613, "verse_number": "८५", "content_sanskrit": "देवाः शर्वस्य वचनं श्रुत्वा हर्षमुपागताः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2168568, "chapter_id": 4613, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]