[{"id": 5000086000, "chapter_id": 9086, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000086001, "chapter_id": 9086, "verse_number": "२-९-१", "content_sanskrit": "एवमुक्ता तु कैकेयी क्रोधेन ज्वलितानना।\nदीर्घमुष्णं विनिःश्वस्य मन्थरामिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000086002, "chapter_id": 9086, "verse_number": "२-९-२", "content_sanskrit": "अद्य राममितः क्षिप्रं वनं प्रस्थापयाम्यहम्।\nयौवराज्येन भरतं क्षिप्रमद्याभिषेचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000086003, "chapter_id": 9086, "verse_number": "२-९-३", "content_sanskrit": "इदं त्विदानीं सम्पश्य केनोपायेन साधये।\nभरतः प्राप्नुयाद् राज्यं न तु रामः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000086004, "chapter_id": 9086, "verse_number": "२-९-४", "content_sanskrit": "एवमुक्ता तु सा देव्या मन्थरा पापदर्शिनी।\nरामार्थमुपहिंसन्ती कैकेयीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000086005, "chapter_id": 9086, "verse_number": "२-९-५", "content_sanskrit": "हन्तेदानीं प्रपश्य त्वं कैकेयि श्रूयतां वचः।\nयथा ते भरतो राज्यं पुत्रः प्राप्स्यति केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000086006, "chapter_id": 9086, "verse_number": "२-९-६", "content_sanskrit": "किं न स्मरसि कैकेयि स्मरन्ती वा निगूहसे।\nयदुच्यमानमात्मार्थं मत्तस्त्वं श्रोतुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000086007, "chapter_id": 9086, "verse_number": "२-९-७", "content_sanskrit": "मयोच्यमानं यदि ते श्रोतुं छन्दो विलासिनि।\nश्रूयतामभिधास्यामि श्रुत्वा चैतद् विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000086008, "chapter_id": 9086, "verse_number": "२-९-८", "content_sanskrit": "श्रुत्वैवं वचनं तस्या मन्थरायास्तु कैकयी।\nकिंचिदुत्थाय शयनात् स्वास्तीर्णादिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000086009, "chapter_id": 9086, "verse_number": "२-९-९", "content_sanskrit": "कथयस्व ममोपायं केनोपायेन मन्थरे।\nभरतः प्राप्नुयाद् राज्यं न तु रामः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000086010, "chapter_id": 9086, "verse_number": "२-९-१०", "content_sanskrit": "एवमुक्ता तदा देव्या मन्थरा पापदर्शिनी।\nरामार्थमुपहिंसन्ती कैकेयीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000086011, "chapter_id": 9086, "verse_number": "२-९-११", "content_sanskrit": "पुरा देवासुरे युद्धे सह राजर्षिभिः पतिः।\nअगच्छत् त्वामुपादाय देवराजस्य साह्यकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000086012, "chapter_id": 9086, "verse_number": "२-९-१२", "content_sanskrit": "दिशमास्थाय कैकेयि दक्षिणां दण्डकान् प्रति।\nवैजयन्तमिति ख्यातं पुरं यत्र तिमिध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000086013, "chapter_id": 9086, "verse_number": "२-९-१३", "content_sanskrit": "स शम्बर इति ख्यातः शतमायो महासुरः।\nददौ शक्रस्य संग्रामं देवसङ्घैरनिर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000086014, "chapter_id": 9086, "verse_number": "२-९-१४", "content_sanskrit": "तस्मिन् महति संग्रामे पुरुषान् क्षतविक्षतान्।\nरात्रौ प्रसुप्तान् घ्नन्ति स्म तरसापास्य राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000086015, "chapter_id": 9086, "verse_number": "२-९-१५", "content_sanskrit": "तत्राकरोन्महायुद्धं राजा दशरथस्तदा।\nअसुरैश्च महाबाहुः शस्त्रैश्च शकलीकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000086016, "chapter_id": 9086, "verse_number": "२-९-१६", "content_sanskrit": "अपवाह्य त्वया देवि संग्रामान्नष्टचेतनः।\nतत्रापि विक्षतः शस्त्रैः पतिस्ते रक्षितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000086017, "chapter_id": 9086, "verse_number": "२-९-१७", "content_sanskrit": "तुष्टेन तेन दत्तौ ते द्वौ वरौ शुभदर्शने।\nस त्वयोक्तः पतिर्देवि यदेच्छेयं तदा वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000086018, "chapter_id": 9086, "verse_number": "२-९-१८", "content_sanskrit": "गृह्णीयां तु तदा भर्तस्तथेत्युक्तं महात्मना।\nअनभिज्ञा ह्यहं देवि त्वयैव कथितं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000086019, "chapter_id": 9086, "verse_number": "२-९-१९", "content_sanskrit": "कथैषा तव तु स्नेहान्मनसा धार्यते मया।\nरामाभिषेकसम्भारान्निगृह्य विनिवर्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000086020, "chapter_id": 9086, "verse_number": "२-९-२०", "content_sanskrit": "तौ च याचस्व भर्तारं भरतस्याभिषेचनम्।\nप्रव्राजनं च रामस्य वर्षाणि च चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000086021, "chapter_id": 9086, "verse_number": "२-९-२१", "content_sanskrit": "चतुर्दश हि वर्षाणि रामे प्रव्राजिते वनम्।\nप्रजाभावगतस्नेहः स्थिरः पुत्रो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000086022, "chapter_id": 9086, "verse_number": "२-९-२२", "content_sanskrit": "क्रोधागारं प्रविश्याद्य क्रुद्धेवाश्वपतेः सुते।\nशेष्वानन्तर्हितायां त्वं भूमौ मलिनवासिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000086023, "chapter_id": 9086, "verse_number": "२-९-२३", "content_sanskrit": "मा स्मैनं प्रत्युदीक्षेथा मा चैनमभिभाषथाः।\nरुदन्ती पार्थिवं दृष्ट्वा जगत्यां शोकलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000086024, "chapter_id": 9086, "verse_number": "२-९-२४", "content_sanskrit": "दयिता त्वं सदा भर्तुरत्र मे नास्ति संशयः।\nत्वत्कृते च महाराजो विशेदपि हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000086025, "chapter_id": 9086, "verse_number": "२-९-२५", "content_sanskrit": "न त्वां क्रोधयितुं शक्तो न क्रुद्धां प्रत्युदीक्षितुम्।\nतव प्रियार्थं राजा तु प्राणानपि परित्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000086026, "chapter_id": 9086, "verse_number": "२-९-२६", "content_sanskrit": "न ह्यतिक्रमितुं शक्तस्तव वाक्यं महीपतिः।\nमन्दस्वभावे बुध्यस्व सौभाग्यबलमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000086027, "chapter_id": 9086, "verse_number": "२-९-२७", "content_sanskrit": "मणिमुक्तासुवर्णानि रत्नानि विविधानि च।\nदद्याद् दशरथो राजा मा स्म तेषु मनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000086028, "chapter_id": 9086, "verse_number": "२-९-२८", "content_sanskrit": "यौ तौ देवासुरे युद्धे वरौ दशरथो ददौ।\nतौ स्मारय महाभागे सोऽर्थो न त्वा क्रमेदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000086029, "chapter_id": 9086, "verse_number": "२-९-२९", "content_sanskrit": "यदा तु ते वरं दद्यात् स्वयमुत्थाप्य राघवः।\nव्यवस्थाप्य महाराजं त्वमिमं वृणुया वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000086030, "chapter_id": 9086, "verse_number": "२-९-३०", "content_sanskrit": "रामप्रव्रजनं दूरं नव वर्षाणि पञ्च च।\nभरतः क्रियतां राजा पृथिव्यां पार्थिवर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000086031, "chapter_id": 9086, "verse_number": "२-९-३१", "content_sanskrit": "चतुर्दश हि वर्षाणि रामे प्रव्राजिते वनम्।\nरूढश्च कृतमूलश्च शेषं स्थास्यति ते सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000086032, "chapter_id": 9086, "verse_number": "२-९-३२", "content_sanskrit": "रामप्रव्राजनं चैव देवि याचस्व तं वरम्।\nएवं सेत्स्यन्ति पुत्रस्य सर्वार्थास्तव कामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000086033, "chapter_id": 9086, "verse_number": "२-९-३३", "content_sanskrit": "एवं प्रव्राजितश्चैव रामोऽरामो भविष्यति।\nभरतश्च गतामित्रस्तव राजा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000086034, "chapter_id": 9086, "verse_number": "२-९-३४", "content_sanskrit": "येन कालेन रामश्च वनात् प्रत्यागमिष्यति।\nअन्तर्बहिश्च पुत्रस्ते कृतमूलो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000086035, "chapter_id": 9086, "verse_number": "२-९-३५", "content_sanskrit": "संगृहीतमनुष्यश्च सुहृद्भिः साकमात्मवान्।\nप्राप्तकालं नु मन्येऽहं राजानं वीतसाध्वसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000086036, "chapter_id": 9086, "verse_number": "२-९-३६", "content_sanskrit": "रामाभिषेकसंकल्पान्निगृह्य विनिवर्तय।\nअनर्थमर्थरूपेण ग्राहिता सा ततस्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000086037, "chapter_id": 9086, "verse_number": "२-९-३७", "content_sanskrit": "हृष्टा प्रतीता कैकेयी मन्थरामिदमब्रवीत्।\nसा हि वाक्येन कुब्जायाः किशोरीवोत्पथं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000086038, "chapter_id": 9086, "verse_number": "२-९-३८", "content_sanskrit": "कैकेयी विस्मयं प्राप्य परं परमदर्शना।\nप्रज्ञां ते नावजानामि श्रेष्ठे श्रेष्ठाभिधायिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000086039, "chapter_id": 9086, "verse_number": "२-९-३९", "content_sanskrit": "पृथिव्यामसि कुब्जानामुत्तमा बुद्धिनिश्चये।\nत्वमेव तु ममार्थेषु नित्ययुक्ता हितैषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000086040, "chapter_id": 9086, "verse_number": "२-९-४०", "content_sanskrit": "नाहं समवबुद्ध्येयं कुब्जे राज्ञश्चिकीर्षितम्।\nसन्ति दुःसंस्थिताः कुब्जाः वक्राः परमपापिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000086041, "chapter_id": 9086, "verse_number": "२-९-४१", "content_sanskrit": "त्वं पद्ममिव वातेन संनता प्रियदर्शना।\nउरस्तेऽभिनिविष्टं वै यावत् स्कन्धात् समुन्नतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000086042, "chapter_id": 9086, "verse_number": "२-९-४२", "content_sanskrit": "अधस्ताच्चोदरं शान्तं सुनाभमिव लज्जितम्।\nप्रतिपूर्णं च जघनं सुपीनौ च पयोधरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000086043, "chapter_id": 9086, "verse_number": "२-९-४३", "content_sanskrit": "विमलेन्दुसमं वक्त्रमहो राजसि मन्थरे।\nजघनं तव निर्मृष्टं रशनादामभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000086044, "chapter_id": 9086, "verse_number": "२-९-४४", "content_sanskrit": "जङ्घे भृशमुपन्यस्ते पादौ च व्यायतावुभौ।\nत्वमायताभ्यां सक्थिभ्यां मन्थरे क्षौमवासिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000086045, "chapter_id": 9086, "verse_number": "२-९-४५", "content_sanskrit": "अग्रतो मम गच्छन्ती राजसेऽतीव शोभने।\nआसन् याः शम्बरे मायाः सहस्रम् असुराधिपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000086046, "chapter_id": 9086, "verse_number": "२-९-४६", "content_sanskrit": "हृदये ते निविष्टास् ता भूयश् चान्याः सहस्रशः।\nतदेव स्थगु(=पृष्ठ-वक्रभागः) यद् दीर्घं रथ-घोणम् इवायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000086047, "chapter_id": 9086, "verse_number": "२-९-४७", "content_sanskrit": "मतयः क्षत्र-विद्याश् च मायाश्चात्र वसन्ति ते।\nअत्र तेऽहं प्रमोक्ष्यामि मालां कुब्जे हिरण्मयीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000086048, "chapter_id": 9086, "verse_number": "२-९-४८", "content_sanskrit": "अभिषिक्ते च भरते राघवे च वनं गते।\nजात्येन च सुवर्णेन सुनिष्टप्तेन सुन्दरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000086049, "chapter_id": 9086, "verse_number": "२-९-४९", "content_sanskrit": "लब्धार्था च प्रतीता च लेपयिष्यामि ते स्थगु।\nमुखे च तिलकं चित्रं जातरूपमयं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000086050, "chapter_id": 9086, "verse_number": "२-९-५०", "content_sanskrit": "कारयिष्यामि ते कुब्जे शुभान्याभरणानि च।\nपरिधाय शुभे वस्त्रे देवतेव चरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000086051, "chapter_id": 9086, "verse_number": "२-९-५१", "content_sanskrit": "चन्द्रमाह्वयमानेन मुखेनाप्रतिमानना।\nगमिष्यसि गतिं मुख्यां गर्वयन्ती द्विषज्जने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000086052, "chapter_id": 9086, "verse_number": "२-९-५२", "content_sanskrit": "तवापि कुब्जाः कुब्जायाः सर्वाभरणभूषिताः।\nपादौ परिचरिष्यन्ति यथैव त्वं सदा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000086053, "chapter_id": 9086, "verse_number": "२-९-५३", "content_sanskrit": "इति प्रशस्यमाना सा कैकेयीमिदमब्रवीत्।\nशयानां शयने शुभ्रे वेद्यामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000086054, "chapter_id": 9086, "verse_number": "२-९-५४", "content_sanskrit": "गतोदके सेतुबन्धो न कल्याणि विधीयते।\nउत्तिष्ठ कुरु कल्याणं राजानमनुदर्शय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000086055, "chapter_id": 9086, "verse_number": "२-९-५५", "content_sanskrit": "तथा प्रोत्साहिता देवी गत्वा मन्थरया सह।\nक्रोधागारं विशालाक्षी सौभाग्यमदगर्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000086056, "chapter_id": 9086, "verse_number": "२-९-५६", "content_sanskrit": "अनेकशतसाहस्रं मुक्ताहारं वराङ्गना।\nअवमुच्य वरार्हाणि शुभान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000086057, "chapter_id": 9086, "verse_number": "२-९-५७", "content_sanskrit": "तदा हेमोपमा तत्र कुब्जावाक्यवशंगता।\nसंविश्य भूमौ कैकेयी मन्थरामिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000086058, "chapter_id": 9086, "verse_number": "२-९-५८", "content_sanskrit": "इह वा मां मृतां कुब्जे\nनृपायावेदयिष्यसि।\nवनं तु राघवे प्राप्ते\nभरतः प्राप्स्यते क्षितिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000086059, "chapter_id": 9086, "verse_number": "२-९-५९", "content_sanskrit": "सुवर्णेन न मे ह्यर्थो\nन रत्नैर्न च भोजनैः।\nएष मे जीवितस्यान्तो\nरामो यद्यभिषिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000086060, "chapter_id": 9086, "verse_number": "२-९-६०", "content_sanskrit": "ततः पुनस्तां महिषीं महीक्षितो\nवचोभिरत्यर्थमहापराक्रमैः।\nउवाच कुब्जा भरतस्य मातरं\nहितं वचो राममुपेत्य चाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000086061, "chapter_id": 9086, "verse_number": "२-९-६१", "content_sanskrit": "प्रपत्स्यते राज्यमिदं हि राघवो\nयदि ध्रुवं त्वं ससुता च तप्स्यसे।\nततो हि कल्याणि यतस्व तत् तथा\nयथा सुतस्ते भरतोऽभिषेक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000086062, "chapter_id": 9086, "verse_number": "२-९-६२", "content_sanskrit": "तथातिविद्धा महिषीति कुब्जया\nसमाहता वागिषुभिर्मुहुर्मुहुः।\nविधाय हस्तौ हृदयेऽतिविस्मिता\nशशंस कुब्जां कुपिता पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000086063, "chapter_id": 9086, "verse_number": "२-९-६३", "content_sanskrit": "यमस्य वा मां विषयं गतामितो\nनिशम्य कुब्जे प्रतिवेदयिष्यसि।\nवनं गते वा सुचिराय राघवे\nसमृद्धकामो भरतो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000086064, "chapter_id": 9086, "verse_number": "२-९-६४", "content_sanskrit": "अहं हि नैवास्तरणानि न स्रजो\nन चन्दनं नाञ्जनपानभोजनम्।\nन किंचिदिच्छामि न चेह जीवनं\nन चेदितो गच्छति राघवो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000086065, "chapter_id": 9086, "verse_number": "२-९-६५", "content_sanskrit": "अथैवमुक्त्वा वचनं सुदारुणं\nनिधाय सर्वाभरणानि भामिनी।\nअसंस्कृतामास्तरणेन मेदिनीं\nतदाधिशिश्ये पतितेव किंनरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000086066, "chapter_id": 9086, "verse_number": "२-९-६६", "content_sanskrit": "उदीर्णसंरम्भतमोवृतानना\nतदावमुक्तोत्तममाल्यभूषणा।\nनरेन्द्रपत्नी विमना बभूव सा\nतमोवृता द्यौरिव मग्नतारका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000086067, "chapter_id": 9086, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]