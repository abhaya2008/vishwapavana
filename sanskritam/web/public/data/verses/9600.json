[{"id": 5000600000, "chapter_id": 9600, "verse_number": "७-६५-१", "content_sanskrit": "प्रस्थाप्य च बलं सर्वं मासमात्रोषितः पथि ।\nएक एवाशु शत्रुघ्नो जगाम त्वरितं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000600001, "chapter_id": 9600, "verse_number": "७-६५-२", "content_sanskrit": "द्विरात्रमन्तरे शूर उष्य राघवनन्दनः ।\nवाल्मीकेराश्रमं पुण्यमगच्छद्वासमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000600002, "chapter_id": 9600, "verse_number": "७-६५-३", "content_sanskrit": "सो ऽभिवाद्य महात्मानं वाल्मीकिं मुनिसत्तमम् ।\nकृताञ्जलिरथो भूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000600003, "chapter_id": 9600, "verse_number": "७-६५-४", "content_sanskrit": "भगवन्वस्तुमिच्छामि गुरोः कृत्यादिहागतः ।\nश्वः प्रभाते गमिष्यामि प्रतीचीं वारुणीं दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000600004, "chapter_id": 9600, "verse_number": "७-६५-५", "content_sanskrit": "शत्रुघ्नस्य वचः श्रुत्वा प्रहस्य मुनिपुङ्गवः ।\nप्रत्युवाच महात्मानं स्वागतं ते महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000600005, "chapter_id": 9600, "verse_number": "७-६५-६", "content_sanskrit": "स्वमाश्रममिदं सौम्य राघवाणां कुलस्य हि ।\nआसनं पाद्यमर्ध्यं च निर्विशङ्कः प्रतीच्छ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000600006, "chapter_id": 9600, "verse_number": "७-६५-७", "content_sanskrit": "प्रतिगृह्य तदा पूजां फलमूलं च भोजनम् ।\nभक्षयामास काकुत्स्थस्तृप्तिं च परमां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000600007, "chapter_id": 9600, "verse_number": "७-६५-८", "content_sanskrit": "स भुक्त्वा फलमूलं च महर्षिं तमुवाच ह ।\nइयं यज्ञविभूतिस्ते कस्याश्रमसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000600008, "chapter_id": 9600, "verse_number": "७-६५-९", "content_sanskrit": "तत्तस्य भाषितं श्रुत्वा वाल्मीकिर्वाक्यमब्रवीत् ।\nशत्रुघ्न शृणु यस्येदं बभूवायतनं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000600009, "chapter_id": 9600, "verse_number": "७-६५-१०", "content_sanskrit": "युष्माकं पूर्वको राजा सौदासस्तस्य भूपतेः ।\nपुत्रो वीरसहो नाम वीर्यवानतिधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000600010, "chapter_id": 9600, "verse_number": "७-६५-११", "content_sanskrit": "स बाल एव सौदासो मृगयामुपचक्रमे ।\nचञ्चूर्यमाणं ददृशे स शूरो राक्षसद्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000600011, "chapter_id": 9600, "verse_number": "७-६५-१२", "content_sanskrit": "शार्दूलरूपिणौ घोरौ मृगान्बहुसहस्रशः ।\nभक्षमाणावसन्तुष्टौ पर्याप्तिं नैव जग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000600012, "chapter_id": 9600, "verse_number": "७-६५-१३", "content_sanskrit": "स तु तौ राक्षसौ दृष्ट्वा निर्मृगं च वनं कृतम् ।\nक्रोधेन महता ऽ ऽविष्टो जघानैकं महेषुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000600013, "chapter_id": 9600, "verse_number": "७-६५-१४", "content_sanskrit": "विनिपात्य तमेकं तु सौदासः पुरुषर्षभः ।\nविज्वरो विगतामार्षो हतं रक्षो ह्युदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000600014, "chapter_id": 9600, "verse_number": "७-६५-१५", "content_sanskrit": "निरीक्षमाणं तं दृष्ट्वा सहायं तस्य रक्षसः ।\nसन्तापमकरोद्घोरं सौदासं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000600015, "chapter_id": 9600, "verse_number": "७-६५-१६", "content_sanskrit": "यस्मादनपराधं त्वं सहायं मम जघ्निवान् ।\nतस्मात्तवापि पापिष्ठ प्रदास्यामि प्रतिक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000600016, "chapter_id": 9600, "verse_number": "७-६५-१७", "content_sanskrit": "एवमुक्त्वा तु तद्राक्षस्तत्रैवान्तरधीयत ।\nकालपर्याययोगेन राजा मित्रसहो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000600017, "chapter_id": 9600, "verse_number": "७-६५-१८", "content_sanskrit": "राजापि यजते यज्ञमस्याश्रमसमीपतः ।\nअश्वमेधं महायज्ञं तं वसिष्ठो ऽभ्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000600018, "chapter_id": 9600, "verse_number": "७-६५-१९", "content_sanskrit": "तत्र यज्ञो महानासीद्बहुवर्षगणायुतः ।\nसमृद्धः परया लक्ष्म्या देवयज्ञसमो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000600019, "chapter_id": 9600, "verse_number": "७-६५-२०", "content_sanskrit": "अथावसाने यज्ञस्य पूर्ववैरमनुस्मरन् ।\nवसिष्ठरूपी राजानमिति होवाच राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000600020, "chapter_id": 9600, "verse_number": "७-६५-२१", "content_sanskrit": "अस्य यज्ञस्य जातो ऽन्तः सामिषं भोजनं मम ।\nदीयतामिह शीघ्रं वै नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000600021, "chapter_id": 9600, "verse_number": "७-६५-२२", "content_sanskrit": "तच्छ्रुत्वा व्याहृतं वाक्यं रक्षसा ब्रह्मरूपिणा ।\nभक्ष्यसंस्कारकुशलमुवाच पृथिवीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000600022, "chapter_id": 9600, "verse_number": "७-६५-२३", "content_sanskrit": "हविष्यं सामिषं स्वादु यथा भवति भोजनम् ।\nतथा कुरुष्व शीघ्रं वै परितुष्येद्यथा गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000600023, "chapter_id": 9600, "verse_number": "७-६५-२४", "content_sanskrit": "शासनात्पार्थिवेन्द्रस्य सूदः सम्भ्रान्तमानसः ।\nस राक्षसः पुनस्तत्र सूदवेषमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000600024, "chapter_id": 9600, "verse_number": "७-६५-२५", "content_sanskrit": "स मानुषमथो मांसं पार्थिवाय न्यवेदयत् ।\nइदं स्वादु हविष्यं च सामिषं चान्नमाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000600025, "chapter_id": 9600, "verse_number": "७-६५-२६", "content_sanskrit": "स भोजनं वसिष्ठाय पत्न्या सार्धमुपाहरत् ।\nमदयन्त्या नरव्याघ्र सामिषं रक्षसा हृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000600026, "chapter_id": 9600, "verse_number": "७-६५-२७", "content_sanskrit": "ज्ञात्वा तदामिषं विप्रो मानुषं भाजनं गतम् ।\nक्रोधेन महता ऽ ऽविष्टो व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000600027, "chapter_id": 9600, "verse_number": "७-६५-२८", "content_sanskrit": "यस्मात्त्वं भोजनं राजन्ममैतद्दातुमिच्छसि ।\nतस्माद्भोजनमेतत्ते भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000600028, "chapter_id": 9600, "verse_number": "७-६५-२९", "content_sanskrit": "ततः क्रुद्धस्तु सौदासस्तोयं जग्राह पाणिना ।\nवसिष्ठं शप्तुमारेभे भार्या चैनमवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000600029, "chapter_id": 9600, "verse_number": "७-६५-३०", "content_sanskrit": "राजन्प्रभुर्यतो ऽस्माकं वसिष्ठो भगवानृषिः ।\nप्रतिशप्तुं न शक्तस्त्वं देवतुल्यं पुरोधसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000600030, "chapter_id": 9600, "verse_number": "७-६५-३१", "content_sanskrit": "ततः क्रोधमयं तोयं तेजोबलसमन्वितम् ।\nव्यसर्जयत धर्मात्मा ततः पादौ सिषेच च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000600031, "chapter_id": 9600, "verse_number": "७-६५-३२", "content_sanskrit": "तेनास्य राज्ञस्तौ पादौ तदा कल्माषतां गतौ ।\nतदाप्रभृति राजा ऽसौ सौदासः सुमहायशाः ।\nकल्माषपादः संवृत्तः ख्यातश्चैव तथा नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000600032, "chapter_id": 9600, "verse_number": "७-६५-३३", "content_sanskrit": "स राजा सह पत्न्या वै प्रणिपत्य मुहुर्मुहुः ।\nपुनर्वसिष्ठं प्रोवाच यदुक्तं ब्रह्मरूपिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000600033, "chapter_id": 9600, "verse_number": "७-६५-३४", "content_sanskrit": "तच्छ्रुत्वा पार्थिवेन्द्रस्य रक्षसा विकृतं च तत् ।\nपुनः प्रोवाच राजानं वसिष्ठः पुरुषर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000600034, "chapter_id": 9600, "verse_number": "७-६५-३५", "content_sanskrit": "मया रोषपरीतेन यदिदं व्याहृतं वचः ।\nनैतच्छक्यं वृथा कर्तुं प्रदास्यामि च ते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000600035, "chapter_id": 9600, "verse_number": "७-६५-३६", "content_sanskrit": "कालो द्वादश वर्षाणि शापस्यान्तो भविष्यति ।\nमत्प्रासादाच्च राजेन्द्र व्यतीतं न स्मरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000600036, "chapter_id": 9600, "verse_number": "७-६५-३७", "content_sanskrit": "एवं स राजा तं शापमुपभुज्यारिसूदनः ।\nप्रतिलेभे पुना राज्यं प्रजाश्चैवान्वपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000600037, "chapter_id": 9600, "verse_number": "७-६५-३८", "content_sanskrit": "तस्य कल्माषपादस्य यज्ञस्यायतनं शुभम् ।\nआश्रमस्य समीपे ऽस्य यन्मां पृच्छसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000600038, "chapter_id": 9600, "verse_number": "७-६५-३९", "content_sanskrit": "तस्य तां पार्थिवेन्द्रस्य कथां श्रुत्वा सुदारुणाम् ।\nविवेश पर्णशालायां महर्षिमभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000600039, "chapter_id": 9600, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]