[{"id": 2186421, "chapter_id": 4958, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186422, "chapter_id": 4958, "verse_number": "१", "content_sanskrit": "यद्यस्ति दत्तमिष्टं वा तपस्तप्तं तथैव च ।\nगुरूणां चापि शुश्रूषा तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186423, "chapter_id": 4958, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186424, "chapter_id": 4958, "verse_number": "२", "content_sanskrit": "आत्मनानर्थयुक्तेन पापे निविशते मनः ।\nस कर्म कलुषं कृत्वा क्लेशे महति धीयते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186425, "chapter_id": 4958, "verse_number": "३", "content_sanskrit": "दुर्भिक्षादेव दुर्भिक्षं क्लेशात्क्लेशं भयाद्भयम् ।\nमृतेभ्यः प्रमृतं यान्ति दरिद्राः पापकारिणः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186426, "chapter_id": 4958, "verse_number": "४", "content_sanskrit": "उत्सवादुत्सवं यान्ति स्वर्गात्स्वर्गं सुखात् सुखम् ।\nश्रद्दधानाश्च दान्ताश्च धनाढ्याः शुभकारिणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186427, "chapter_id": 4958, "verse_number": "५", "content_sanskrit": "व्यालकुञ्जरदुर्गेषु सर्पचोरभयेषु च ।\nहस्तवामेन गच्छन्ति नास्तिकाः किमतः परम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186428, "chapter_id": 4958, "verse_number": "६", "content_sanskrit": "प्रियदेवातिथेयाश्च वदान्याः प्रियसाधवः ।\nक्षेम्यमात्मवतां मार्गमास्थिता हस्तदक्षिणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186429, "chapter_id": 4958, "verse_number": "७", "content_sanskrit": "पुलाका इव धान्येषु पुत्तिका इव पक्षिषु ।\nतद्विधास्ते मनुष्येषु येषां धर्मो न कारणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186430, "chapter_id": 4958, "verse_number": "८", "content_sanskrit": "सुशीघ्रमपि धावन्तं विधानमनुधावति ।\nशेते सह शयानेन येन येन यथा कृतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186431, "chapter_id": 4958, "verse_number": "९", "content_sanskrit": "उपतिष्ठति तिष्ठन्तं गच्छन्तमनुगच्छति ।\nकरोति कुर्वतः कर्म छायेवानुविधीयते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186432, "chapter_id": 4958, "verse_number": "१०", "content_sanskrit": "येन येन यथा यद्यत् पुरा कर्म समाचितम् ।\nतत्तदेव नरो भुङ्क्ते नित्यं विहितमात्मना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186433, "chapter_id": 4958, "verse_number": "११", "content_sanskrit": "स्वकर्मफलविक्षिप्तं विधानपरिरक्षितम् ।\nभूतग्राममिमं कालः समन्तात् परिकर्षति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186434, "chapter_id": 4958, "verse_number": "१२", "content_sanskrit": "अचोद्यमानानि यथा पुष्पाणि च फलानि च ।\nस्वकालं नातिवर्तन्ते तथा कर्म पुराकृतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186435, "chapter_id": 4958, "verse_number": "१३", "content_sanskrit": "सम्मानश्चावमानश्च लाभालाभौ क्षयोदयौ ।\nप्रवृत्ता विनिवर्तन्ते विधानान्ते पुनः पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186436, "chapter_id": 4958, "verse_number": "१४", "content_sanskrit": "आत्मना विहितं दुःखमात्मना विहितं सुखम् ।\nगर्भशय्यामुपादाय भुज्यते पौर्वदेहिकम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186437, "chapter_id": 4958, "verse_number": "१५", "content_sanskrit": "बालो युवा च वृद्धश्च यत् करोति शुभाशुभम् ।\nतस्यां तस्यामवस्थायां भुङ्क्ते जन्मनि जन्मनि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186438, "chapter_id": 4958, "verse_number": "१६", "content_sanskrit": "यथा धेनुसहस्रेषु वत्सो विन्दति मातरम् ।\nतथा पूर्वकृतं कर्म कर्तारमनुगच्छति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186439, "chapter_id": 4958, "verse_number": "१७", "content_sanskrit": "संस्विन्नमग्रतो वस्त्रं पश्चाच्छुध्यति कर्मणा ।\nउपवासैः प्रतप्तानां दीर्घं सुखमनन्तकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186440, "chapter_id": 4958, "verse_number": "१८", "content_sanskrit": "दुष्कर्मापि तथा पश्यात् पूयते पुण्यकर्मणा ।\nतपसा तप्यते देहस्तपसा विन्दते महत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186441, "chapter_id": 4958, "verse_number": "१९", "content_sanskrit": "दीर्घकालेन तपसा सेवितेन तपोवने ।\nधर्मनिर्धूतपापानां संसिध्यन्ते मनोरथाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186442, "chapter_id": 4958, "verse_number": "२०", "content_sanskrit": "शकुनीनामिवाकाशे मत्स्यानामिव चोदके ।\nपदं यथा न दृश्येत तथा ज्ञानविदां गतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186443, "chapter_id": 4958, "verse_number": "२१", "content_sanskrit": "अलमन्यैरुपालम्भैः कीर्तितैश्च व्यतिक्रमैः ।\nपेशलं चानुरूपं च कर्तव्यं हितमात्मनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186444, "chapter_id": 4958, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे सप्तमोऽध्यायः ॥ ७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]