[{"id": 2087739, "chapter_id": 2864, "verse_number": "१२-३६९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087740, "chapter_id": 2864, "verse_number": "१२-३६९-१", "content_sanskrit": "अथ काले बहुतिथे पूर्णे प्राप्तो भुजङ्गमः।\nदत्ताभ्यनुज्ञः स्वं वेश्म कृतकर्मा विवस्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087741, "chapter_id": 2864, "verse_number": "१२-३६९-२", "content_sanskrit": "तं भार्याऽप्युपचक्राम पादशौचादिभिर्गुणैः।\nउपपन्नां च तां साध्वीं पन्नगः पर्यपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087742, "chapter_id": 2864, "verse_number": "१२-३६९-३", "content_sanskrit": "अथ त्वमसि कल्याणि देवतातिथिपूजने।\nपूर्वमुक्तेन विधिना युक्ता कर्मसु वर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087743, "chapter_id": 2864, "verse_number": "१२-३६९-४", "content_sanskrit": "न खल्वस्यकृतार्थेन स्त्रीबुद्ध्या मार्दवीकृता।\nमद्वियोगेन सुश्रोणि विमुक्ता धर्मसेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087744, "chapter_id": 2864, "verse_number": "१२-३६९-५x", "content_sanskrit": "नागभार्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087745, "chapter_id": 2864, "verse_number": "१२-३६९-५", "content_sanskrit": "शिष्याणां गुरुशुश्रूषा विप्राणां वेदधारणम्।\nभृत्यानां स्वामिवचनं राज्ञो लोकानुपालनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087746, "chapter_id": 2864, "verse_number": "१२-३६९-६", "content_sanskrit": "सर्वभूतपरित्राणं क्षत्रधर्म इहोच्यते।\nवैश्यानां यज्ञसंवृत्तिरातिथेयसमन्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087747, "chapter_id": 2864, "verse_number": "१२-३६९-७", "content_sanskrit": "विप्रक्षत्रियवैश्यानां शुश्रूषा शूद्रकर्म तत्।\nगृहस्थधर्मो नागेन्द्र सर्वभूतहितैषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087748, "chapter_id": 2864, "verse_number": "१२-३६९-८", "content_sanskrit": "नियताहारता नित्यं व्रतचर्या यथाक्रमम्।\nधर्मो हि धर्मसंबन्धादिन्द्रियाणां विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087749, "chapter_id": 2864, "verse_number": "१२-३६९-९", "content_sanskrit": "अहं कस्य कुतो वाऽपि कः को मे ह भवेदिति।\nप्रयोजनमतिर्नित्यमेवं मोक्षाश्रमे वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087750, "chapter_id": 2864, "verse_number": "१२-३६९-१०", "content_sanskrit": "पतिव्रतात्वं भार्यायाः परमो धर्म उच्यते।\nतवोपदेशान्नागेन्द्र तच्च तत्त्वेन वेद्मि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087751, "chapter_id": 2864, "verse_number": "१२-३६९-११", "content_sanskrit": "साऽहं धर्मं विजानन्ती धर्ननित्ये त्वयि स्थिते।\nसत्पथं कथमृत्सृज्य यास्यामि विपथं पथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087752, "chapter_id": 2864, "verse_number": "१२-३६९-१२", "content_sanskrit": "देवतानां महाभाग धर्मचर्या न हीयते।\nअतिथीनां च सत्कारे नित्ययुक्ताऽस्म्यतन्द्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087753, "chapter_id": 2864, "verse_number": "१२-३६९-१३", "content_sanskrit": "सप्ताष्टदिवसास्त्वद्य विप्रस्येहागतस्य वै।\nतच्च कार्यं न मे ख्याति दर्शनं तव काङ्क्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087754, "chapter_id": 2864, "verse_number": "१२-३६९-१४", "content_sanskrit": "गोमत्यास्त्वेष पुलिने त्वद्दर्शनसमुत्सुकः।\nआसीनो वर्तयन्ब्रह्म ब्राह्मणः संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087755, "chapter_id": 2864, "verse_number": "१२-३६९-१५", "content_sanskrit": "अहं त्वनेन नागेन्द्र सत्यपूर्वं समाहिता।\nप्रस्थाप्यो मत्सकाशं स संप्राप्तो भुजगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087756, "chapter_id": 2864, "verse_number": "१२-३६९-१६", "content_sanskrit": "एतच्छ्रुत्वा महाप्राज्ञ तत्र गन्तुं त्वमर्हसि।\nदातुमर्हसि वा तस्य दर्शनं दर्शनश्रवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087757, "chapter_id": 2864, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनसप्तत्यधिकत्रिशततमोऽध्यायः॥ ३६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]