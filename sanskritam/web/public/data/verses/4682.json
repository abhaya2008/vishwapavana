[{"id": 2172857, "chapter_id": 4682, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172858, "chapter_id": 4682, "verse_number": "१", "content_sanskrit": "ततः प्रववृते युद्धं भीरूणां भयवर्धनम् ।\nसृञ्जयैः सह राजेन्द्र देवासुररणोपमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172859, "chapter_id": 4682, "verse_number": "२", "content_sanskrit": "नरौघाश्च गजौघाश्च वाजिनश्च सहस्रशः ।\nसादिनश्च पराक्रान्ताः समाजग्मुः परस्परम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172860, "chapter_id": 4682, "verse_number": "३", "content_sanskrit": "नागानां भीमरूपाणां द्रवतां निःस्वनो महान् ।\nअश्रूयत यथा काले जलदानां नभःस्थले\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172861, "chapter_id": 4682, "verse_number": "४", "content_sanskrit": "नागैरभ्याहताः केचित् सरथा रथिनो भृशम् ।\nव्यद्रवन्त रणे भीता द्राव्यमाणा मदोत्कटैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172862, "chapter_id": 4682, "verse_number": "५", "content_sanskrit": "हयौघान् पादरक्षांश्च रथिनस्तत्र शिक्षिताः ।\nशरैः सम्प्रेषयामासुः परलोकाय भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172863, "chapter_id": 4682, "verse_number": "६", "content_sanskrit": "सादिनः शिक्षिता राजन् परिवार्य महारथान् ।\nविचरन्तो रणे ह्यघ्नन् प्रासशक्त्यादिभिस्तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172864, "chapter_id": 4682, "verse_number": "७", "content_sanskrit": "धन्विनः पुरुषाः केचित् सन्निवार्य महारथम् ।\nएकं बहव आसाद्य प्रैषयन् वै यमक्षयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172865, "chapter_id": 4682, "verse_number": "८", "content_sanskrit": "नागं रथगताश्चान्ये परिवार्य महारथाः ।\nसोत्तरायुधिनं जघ्नुः द्रवमाणा महारथाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172866, "chapter_id": 4682, "verse_number": "९", "content_sanskrit": "तथा वरूथिनः क्रुद्धा विकिरन्तः शरान् बहून् ।\nनागाः जघ्नुर्महाराज परिवार्य समन्ततः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172867, "chapter_id": 4682, "verse_number": "१०", "content_sanskrit": "नागो नागमभिद्रुत्य रथी च रथिनं रणे ।\nशक्तितोमरनाराचैः निर्जघ्ने तत्र तत्र ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172868, "chapter_id": 4682, "verse_number": "११", "content_sanskrit": "पादातानवमर्दन्तो रथवारणवाजिनः ।\nरथमध्ये व्यदृश्यन्त कुर्वन्तो महदाकुलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172869, "chapter_id": 4682, "verse_number": "१२", "content_sanskrit": "हयाश्च पर्यधावन्त चामरैरुपशोभिताः ।\nहंसा हिमवतः प्रस्थे पिबन्त इव मेदिनीम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172870, "chapter_id": 4682, "verse_number": "१३", "content_sanskrit": "तेषां तु वाजिनां भूमिः खुरैश्चित्रा विशाम्पते ।\nअशोभत यथा नारी करजैः क्षतविक्षता\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172871, "chapter_id": 4682, "verse_number": "१४", "content_sanskrit": "वाजिनां खुरशब्देन रथनेमिस्वनेन च ।\nपत्तीनां पदशब्देन नागानां बृंहितेन च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172872, "chapter_id": 4682, "verse_number": "१५", "content_sanskrit": "वादित्राणां च घोषेण शङ्खानां निःस्वनेन च ।\nअभवन्नादिता भूमिः निर्घातैरिव भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172873, "chapter_id": 4682, "verse_number": "१६", "content_sanskrit": "धनुषां कूजमानानां निस्त्रिंशानां च दीप्यताम् ।\nकवचानां प्रभाभिश्च न प्राज्ञायत किञ्चन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172874, "chapter_id": 4682, "verse_number": "१७", "content_sanskrit": "बहवो बाहवश्छिन्ना नागराजकरोपमाः ।\nउद्वेष्टन्ति विचेष्टन्ति वेगं कुर्वन्ति दारुणम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172875, "chapter_id": 4682, "verse_number": "१८", "content_sanskrit": "शिरसां च महाराज पततां वसुधातले ।\nच्युतानामिव तालेभ्यः फलानां श्रूयते स्वनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172876, "chapter_id": 4682, "verse_number": "१९", "content_sanskrit": "शिरोभिः पतितैर्भाति रुधिरार्द्रैर्वसुन्धरा ।\nतपनीयनिभैः काले नलिनैरिव भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172877, "chapter_id": 4682, "verse_number": "२०", "content_sanskrit": "उद्वृत्तनयनैस्तैस्तु गतसत्त्वैर्मही तदा ।\nव्यभ्राजत महाराज पुण्डरीकैरिवावृता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172878, "chapter_id": 4682, "verse_number": "२१", "content_sanskrit": "बाहुभिश्चन्दनादिग्धैः सकेयूरैर्महाघनैः ।\nपतितैर्भाति राजेन्द्र मही शक्रध्वजैरिव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172879, "chapter_id": 4682, "verse_number": "२२", "content_sanskrit": "ऊरुभिश्च नरेन्द्राणां विनिकृत्तैर्महाहवे ।\nहस्तिहस्तोपमैरन्यैः संवृतं तद्रणाङ्गणम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172880, "chapter_id": 4682, "verse_number": "२३", "content_sanskrit": "कबन्धशतसङ्कीर्णं छत्रचामरशोभितम् ।\nसेनावनं तच्छुशुभे वनं पुष्पचितं यथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172881, "chapter_id": 4682, "verse_number": "२४", "content_sanskrit": "तत्र योधा महाराज विचरन्तो ह्यभीतवत् ।\nदृश्यन्ते रुधिरार्द्राङ्गाः पुष्पिता इव किंशुकाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172882, "chapter_id": 4682, "verse_number": "२५", "content_sanskrit": "मातङ्गाश्चाप्यदृश्यन्त शरतोमरपीडिताः ।\nपतन्तस्तत्र तत्रैव श्वेताभ्रसदृशा रणे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172883, "chapter_id": 4682, "verse_number": "२६", "content_sanskrit": "गजानीकं महाराज वध्यमानं महारथैः ।\nव्यकीर्यत दिशःसर्वा वातनुन्ना घना इव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172884, "chapter_id": 4682, "verse_number": "२७", "content_sanskrit": "ते गजा गिरिसङ्काशाः पेतुरुर्व्यां समन्ततः ।\nवज्रभिन्ना इव बभुः पर्वता युगपर्यये\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172885, "chapter_id": 4682, "verse_number": "२८", "content_sanskrit": "हयानां सादिभिः सार्धं पतितानां महीतळे ।\nराशयः प्रत्यदृश्यन्त गिरिमात्रास्ततस्ततः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172886, "chapter_id": 4682, "verse_number": "२९", "content_sanskrit": "सञ्जज्ञे रणभूमौ तु परलोकवहा नदी ।\nशोणितोदा रथावर्ता ध्वजवृक्षास्थिशर्करा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172887, "chapter_id": 4682, "verse_number": "३०", "content_sanskrit": "भुजनक्रा धनुःस्रोता हस्तिशैला हयोरगा ।\nमेदोमज्जाकर्दमिनी छत्रहंसोपशोभिता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172888, "chapter_id": 4682, "verse_number": "३१", "content_sanskrit": "कवचोष्णीषसञ्छन्ना पताकारुचिरद्रुमा ।\nचक्रनक्रावलीजुष्टा त्रिवेणूरगसंवृता\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172889, "chapter_id": 4682, "verse_number": "३२", "content_sanskrit": "शूराणां हर्षजननी भीरूणां भयवर्धनी ।\nप्रावर्तत नदी रौद्रा कुरुसृञ्जयसङ्कुले\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172890, "chapter_id": 4682, "verse_number": "३३", "content_sanskrit": "तां नदीं पितृलोकाय वहन्तीमतिभैरवाम् ।\nतेरुर्वाहननौभिस्ते शूराः परिघबाहवः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172891, "chapter_id": 4682, "verse_number": "३४", "content_sanskrit": "वर्तमाने तथा युद्धे निर्मर्यादे विशाम्पते ।\nचतुरङ्गक्षये घोरे युद्धे देवासुरोपमे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172892, "chapter_id": 4682, "verse_number": "३५", "content_sanskrit": "आक्रोशन् बान्धवाश्चान्ये भयार्तानां निवर्तने\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172893, "chapter_id": 4682, "verse_number": "३६", "content_sanskrit": "निर्मर्यादे तथा युद्धे वर्तमाने भयानके ।\nअर्जुनो भीमसेनश्च मोहयाञ्चक्रतुः परान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172894, "chapter_id": 4682, "verse_number": "३७", "content_sanskrit": "सा वध्यमाना महती सेना तव जनाधिप ।\nअमुह्यत् तत्र तत्रैव योषिन्मदवशादिव\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172895, "chapter_id": 4682, "verse_number": "३८", "content_sanskrit": "मोहयित्वा च तां सेनां भीमसेनधनञ्जयौ ।\nदध्मतुर्वारिजौ तत्र सिंहनादं च नेदतुः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172896, "chapter_id": 4682, "verse_number": "३९", "content_sanskrit": "श्रुत्वैव च महाशब्दं धृष्टद्युम्नशिखण्डिनौ ।\nधर्मराजं पुरस्कृत्य मद्रराजमभिद्रुतौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172897, "chapter_id": 4682, "verse_number": "४०", "content_sanskrit": "तत्राश्चर्यमपश्याम घोररूपं विशाम्पते ।\nशल्येन सङ्गताः शूरा यदयुध्यन्त भागशः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172898, "chapter_id": 4682, "verse_number": "४१", "content_sanskrit": "माद्रीपुत्रौ सरभसौ कृतास्त्रौ युद्धदुर्मदौ ।\nअभीतौ त्वरया युक्तौ जिगीषन्तौ बलं तव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172899, "chapter_id": 4682, "verse_number": "४२", "content_sanskrit": "ततोऽभ्यवर्तत बलं तावकं भरतर्षभ ।\nततः शरप्रवृद्धैश्च पाण्डवैर्जितकाशिभिः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172900, "chapter_id": 4682, "verse_number": "४३", "content_sanskrit": "वध्यमाना चमूः सा तु पुत्राणां प्रेक्षतां तव\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172901, "chapter_id": 4682, "verse_number": "४४", "content_sanskrit": "भेजे दश दिशो राजन् प्रणुन्ना दृढविक्रमैः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172902, "chapter_id": 4682, "verse_number": "४५", "content_sanskrit": "हाहाकारो महान् जज्ञे योधानां तव भारत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172903, "chapter_id": 4682, "verse_number": "४६", "content_sanskrit": "तिष्ठ तिष्ठेति वागासीद् द्रावितानां महात्मभिः ।\nक्षत्रियाणां तदाऽन्योन्यं सङ्ग्रामे जयमिच्छताम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172904, "chapter_id": 4682, "verse_number": "४७", "content_sanskrit": "प्राद्रवन्ते च भग्नास्ते पाण्डवैस्तव सैनिकाः ।\nत्यक्त्वा युद्धे प्रियान् पुत्रान् भ्रातॄनपि पितामहान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172905, "chapter_id": 4682, "verse_number": "४८", "content_sanskrit": "मातुलान् भागिनेयांश्च तथा सम्बन्धिबान्धवान् ।\nहया द्विपाश्च रथिनो भिया जग्मुः समन्ततः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172906, "chapter_id": 4682, "verse_number": "४९", "content_sanskrit": "आत्मत्राणकृतोत्साहास्तावका भरतर्षभ\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172907, "chapter_id": 4682, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172908, "chapter_id": 4682, "verse_number": "९", "content_sanskrit": "शल्यवधपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]