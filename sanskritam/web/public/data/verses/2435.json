[{"id": 2068416, "chapter_id": 2435, "verse_number": "९-५३-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068417, "chapter_id": 2435, "verse_number": "९-५३-१", "content_sanskrit": "कथं कुमारी भगवंस्तपोयुक्ता ह्यभूत्पुरा।\nकिमर्थं च तपस्तेपे को वाऽस्या नियमोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068418, "chapter_id": 2435, "verse_number": "९-५३-२", "content_sanskrit": "सुदुष्करमिदं ब्रह्मंस्त्वत्तः श्रुतमनुत्तमम्।\nआख्याहि तत्त्वमखिलं यथा तपसि सा स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068419, "chapter_id": 2435, "verse_number": "९-५३-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068420, "chapter_id": 2435, "verse_number": "९-५३-३", "content_sanskrit": "ऋषिरासीन्महावीर्यः कुणिर्गार्ग्यो महायशाः।\nस तप्त्वा विपुलं राजंस्तपो वै तपतां वरः।\nतपसाऽथ सुतां सुभ्रूं समुत्पादितवान्विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068421, "chapter_id": 2435, "verse_number": "९-५३-४", "content_sanskrit": "तां च दृष्ट्वा मुनिः प्रीतः कुणिर्गार्ग्यो महायशाः।\nजगाम त्रिदिवं राजन्संत्यज्येह कलेवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068422, "chapter_id": 2435, "verse_number": "९-५३-५", "content_sanskrit": "सुभ्रूः सा ह्यथ कल्याणी पुण्डरीकनिभेक्षणा।\nमहता तपसोग्रेण कृत्वाश्रममनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068423, "chapter_id": 2435, "verse_number": "९-५३-६", "content_sanskrit": "उपवासैः पूजयन्ती पितॄन्देवांश्च सा पुरा।\nतस्यास्तु तपसोग्रेण महान्कालोऽत्यगान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068424, "chapter_id": 2435, "verse_number": "९-५३-७", "content_sanskrit": "सा पित्रा दीयमानापि पतिं नैच्छदनिन्दिता।\nआत्मनः सदृशं सा तु भर्तारं नान्वपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068425, "chapter_id": 2435, "verse_number": "९-५३-८", "content_sanskrit": "ततः सा तपसोग्रेण पीडयित्वाऽऽत्मनस्तनुम्।\nपितृदेवार्चनरता बभूव विजने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068426, "chapter_id": 2435, "verse_number": "९-५३-९", "content_sanskrit": "साऽऽत्मानं मन्यमाना तु कृतकृत्यं श्रमान्विता।\n`जगाम वृद्धभावं तु कौमारब्रह्मचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068427, "chapter_id": 2435, "verse_number": "९-५३-१०", "content_sanskrit": "वार्धकेन च राजेन्द्र तपसा चैव कर्शिता।\nसा नाशकद्यदा गन्तुं पदात्पदमपि स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068428, "chapter_id": 2435, "verse_number": "९-५३-११", "content_sanskrit": "चकार गमने बुद्धिं परलोकाय वै तदा।\nमोक्तुकामां तु तां दृष्ट्वा शरीरं नारदोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068429, "chapter_id": 2435, "verse_number": "९-५३-१२", "content_sanskrit": "असंस्कृतायाः कन्यायाः कुतो लोकास्तवानघे।\nएवं तु श्रुतमस्माभिर्देवलोके महाव्रते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068430, "chapter_id": 2435, "verse_number": "९-५३-१३", "content_sanskrit": "तपः परमकं प्राप्तं न तु लोकास्त्वया जिताः।\nतन्नारदवचः श्रुत्वा साऽब्रवीदृषिसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068431, "chapter_id": 2435, "verse_number": "९-५३-१४", "content_sanskrit": "तपसोऽर्धं प्रयच्छामि पाणिग्राहस्य सत्तमाः।\nइत्युक्तेऽस्यास्तु जग्राह पाणिं गालवसम्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068432, "chapter_id": 2435, "verse_number": "९-५३-१५", "content_sanskrit": "ऋषिः प्राक् शृङ्गवान्नाम समयं चेममब्रवीत्।\nसमयेन तवाद्याहं पाणिं स्प्रक्ष्यामि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068433, "chapter_id": 2435, "verse_number": "९-५३-१६", "content_sanskrit": "यद्येकरात्रं वस्तव्यं त्वया सह मयेति ह।\nतथेति सा प्रतिश्रुत्य तस्मै पाणिं ददौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068434, "chapter_id": 2435, "verse_number": "९-५३-१७", "content_sanskrit": "यथादृष्टेन विधिना हुत्वा चाग्निं विधानतः।\nचक्रे च पाणिग्रहणं तस्योद्वाहं च गालविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068435, "chapter_id": 2435, "verse_number": "९-५३-१८", "content_sanskrit": "सा रात्रावभवद्राजंस्तरुणी वरवर्णिनी।\nदिव्याभरणवस्त्रा च दिव्यगन्धानुलेपना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068436, "chapter_id": 2435, "verse_number": "९-५३-१९", "content_sanskrit": "तां दृष्ट्वा गालविः प्रीतो दीपयन्तीमिव श्रिया।\nउवास च क्षपामेकां प्रभाते साऽब्रवीच्च तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068437, "chapter_id": 2435, "verse_number": "९-५३-२०", "content_sanskrit": "यस्त्वया समयो विप्र कृतो मे तपतां वर।\nतेनोषिताऽस्मि भद्रं ते स्वस्ति तेऽस्तु व्रजाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068438, "chapter_id": 2435, "verse_number": "९-५३-२१", "content_sanskrit": "सा तु ध्यात्वाऽब्रवीद्भूयो योऽस्मिंस्तीर्थे समाहितः।\nवसते रजनीमेकां तर्पयित्वा दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068439, "chapter_id": 2435, "verse_number": "९-५३-२२", "content_sanskrit": "चत्वारिंशतमष्टौ च द्वौ चाष्टौ सम्यगाचरेत्।\nयो ब्रह्मचर्यं वर्षाणि फलं तस्य लभेत सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068440, "chapter_id": 2435, "verse_number": "९-५३-२३", "content_sanskrit": "एवमुक्त्वा ततः साध्वी देहं त्यक्त्वा दिवं गता।\nऋषिरप्यभवद्दीनस्तस्या रूपं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068441, "chapter_id": 2435, "verse_number": "९-५३-२४", "content_sanskrit": "समयेन तपोऽर्धं च कृच्छ्रात्प्रतिगृहीतवान्।\nसाधयित्वा तदाऽऽत्मानं तस्याः स गतिमाप्तवान्।\nदुःखितो भरतश्रेष्ठ तस्या रूपबलात्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068442, "chapter_id": 2435, "verse_number": "९-५३-२५", "content_sanskrit": "एतत्ते वृद्वकन्याया व्याख्यातं चरितं महत्।\nतथैव ब्रह्मचर्यं च स्वर्गस्य च गतिः शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068443, "chapter_id": 2435, "verse_number": "९-५३-२६", "content_sanskrit": "तत्रस्थश्चापि शुश्राव हतं शल्यं हलायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068444, "chapter_id": 2435, "verse_number": "९-५३-२७", "content_sanskrit": "तत्रापि दत्त्वा दानानि द्विजातिभ्यः परन्तपः।\nशुशोच शल्यं सङ्ग्रामे निहतं पाण्डवैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068445, "chapter_id": 2435, "verse_number": "९-५३-२८", "content_sanskrit": "समन्तपञ्चकद्वारात्ततो निष्क्रम्य माधवः।\nपप्रच्छर्षिगणारामः कुरुक्षेत्रस्य यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068446, "chapter_id": 2435, "verse_number": "९-५३-२९", "content_sanskrit": "ते पृष्टा यदुसिंहेन कुरुक्षेत्रफलं विभो\nसमाचख्युर्महात्मानस्तस्मै सर्वं यथातथम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068447, "chapter_id": 2435, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि त्रिपञ्चाशतमोऽध्यायः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]