[{"id": 2209274, "chapter_id": 5471, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209275, "chapter_id": 5471, "verse_number": "१", "content_sanskrit": "क्रियतामुपहारोऽद्य त्र्यम्बकस्य महात्मनः ।\nकृत्वोपहारं नृपते ततः स्वार्थं यतामहे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209276, "chapter_id": 5471, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209277, "chapter_id": 5471, "verse_number": "२", "content_sanskrit": "तेषां तु वचनं श्रुत्वा ब्राह्मणानां युधिष्ठिरः ।\nगिरीशस्य यथान्यायमुपहारमुपाहरत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209278, "chapter_id": 5471, "verse_number": "३", "content_sanskrit": "आज्येन तर्पयित्वाऽग्निं विधिवत् संस्कृतेन ह ।\nमन्त्रसिद्धं चरुं कृत्वा पुरोधाः प्रययौ तदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209279, "chapter_id": 5471, "verse_number": "४", "content_sanskrit": "स गृहीत्वा सुमनसो मन्त्रपूता जनाधिप ।\nमोदकैः पायसेनाथ मांसैश्चोपाहरद् बलिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209280, "chapter_id": 5471, "verse_number": "५", "content_sanskrit": "सुमनोभिश्च चित्राभिर्लाजैरुच्चावचैरपि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209281, "chapter_id": 5471, "verse_number": "६", "content_sanskrit": "सर्वं स्विष्टकृतं हुत्वा विधिवद् वेदपारगः ।\nकिङ्कराणां ततः पश्चात् चकार बलिमुत्तमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209282, "chapter_id": 5471, "verse_number": "७", "content_sanskrit": "यक्षेन्द्राय कुबेराय मणिभद्राय चैव ह ।\nतथाऽन्येषां च यक्षेभ्यो भूताधिपतयश्च ये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209283, "chapter_id": 5471, "verse_number": "८", "content_sanskrit": "कृसरेण समांसेन निवापैस्तिलसंयुतैः ।\nपितॄणामञ्जलिं कृत्वा पुरोधाः समुपाहरत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209284, "chapter_id": 5471, "verse_number": "९", "content_sanskrit": "ब्राह्मणेभ्यः सहस्राणि गवां दत्त्वा तु भूमिपः ।\nनक्तञ्चरेभ्यो भूतेभ्यो व्यादिदेश बलिं तदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209285, "chapter_id": 5471, "verse_number": "१०", "content_sanskrit": "धूपगन्धनिरुद्धं तत् सुमनोभिश्च संवृतम् ।\nशुशुभे स्थानमत्यन्तं देवदेवस्य पार्थिव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209286, "chapter_id": 5471, "verse_number": "११", "content_sanskrit": "कृत्वा पूजां तु रुद्रस्य गणानां चैव सर्वशः ।\nययौ व्यासं पुरस्कृत्य तत्र रत्ननिधिं प्रति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209287, "chapter_id": 5471, "verse_number": "१२", "content_sanskrit": "पूजयित्वा धनाध्यक्षं रुद्रं प्रत्यभिवाद्य च ।\nसुमनोभिर्विचित्राभिरपूपैः कृसरेण च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209288, "chapter_id": 5471, "verse_number": "१३", "content_sanskrit": "शङ्खादींश्च निधीन् सर्वान् निधिपालांश्च सर्वशः ।\nअर्चयित्वा द्विजाग्र्यान् स स्वस्ति संवाच्य वीर्यवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209289, "chapter_id": 5471, "verse_number": "१४", "content_sanskrit": "तेषां पुण्याहघोषेण तेजसा समवस्थितः ।\nप्रीतिमान् स कुरुश्रेष्ठः खानयामास तं निधिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209290, "chapter_id": 5471, "verse_number": "१५", "content_sanskrit": "ततः पत्राणि करका साश्मन्तकमनोरमाः ।\nभृङ्गराणि कटाहानि कलशान् वर्धमानकाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209291, "chapter_id": 5471, "verse_number": "१६", "content_sanskrit": "बहूनि च विचित्राणि भाजनानि सहस्रशः ।\nउद्धारयामास तदा धर्मपुत्रो युधिष्ठिरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209292, "chapter_id": 5471, "verse_number": "१७", "content_sanskrit": "तेषां लक्षाणि चाप्यासन् महाकरपुटस्तदा ।\nनद्धं च भाजनं राजन् तुलार्धमभवन्नृप ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209293, "chapter_id": 5471, "verse_number": "१८", "content_sanskrit": "वाहनं पाण्डुपुत्रस्य तत्रासीत्तु विशाम्पते ।\nषष्टिरुष्ट्रसहस्राणि शतानि द्विगुणा हयाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209294, "chapter_id": 5471, "verse_number": "१९", "content_sanskrit": "वारणाश्च महाराज सहस्रशतसम्मिताः ।\nशकटानि रथाश्चैव तावदेव यथा गजाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209295, "chapter_id": 5471, "verse_number": "२०", "content_sanskrit": "खराणां पुरुषाणां च परिसङ्ख्या न विद्यते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209296, "chapter_id": 5471, "verse_number": "२१", "content_sanskrit": "एतावद् वित्तमभवद् यदुद्दध्रे युधिष्ठिरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209297, "chapter_id": 5471, "verse_number": "२२", "content_sanskrit": "षोडशाष्टौ चतुर्विंशत्सहस्रं भारलक्षणम् ।\nएतेष्वाधाय तद् द्रव्यं पुनरभ्यर्च्य पाण्डवः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209298, "chapter_id": 5471, "verse_number": "२३", "content_sanskrit": "महादेवं महाराज प्रत्यागच्छद् युधिष्ठिरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209299, "chapter_id": 5471, "verse_number": "२४", "content_sanskrit": "द्वैपायनाभ्यनुज्ञातः पुरस्कृत्य पुरोहितम् ।\nगोरुते गोरुते चापि न्यवसत् पुरुषर्षभः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209300, "chapter_id": 5471, "verse_number": "२५", "content_sanskrit": "सा पुराभिमुखी राजन् जगाम महती चमूः ।\nकृच्छ्राद् द्रविणभारार्ता वाहयन्ती कुरूत्तमान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209301, "chapter_id": 5471, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वित्तं गृहीत्वा पुनरागमनं नाम पञ्चषष्टितमोऽध्यायः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]