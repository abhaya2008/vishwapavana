[{"id": 2001968, "chapter_id": 1039, "verse_number": "१-४०-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001969, "chapter_id": 1039, "verse_number": "१-४०-१", "content_sanskrit": "जरत्कारुरिति ख्यातो यस्त्वया सूतनन्दन।\nइच्छामि तदहं श्रोतुं ऋषेस्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001970, "chapter_id": 1039, "verse_number": "१-४०-२", "content_sanskrit": "किं कारणं जरत्कारोर्नामैतत्प्रथितं भुवि।\nजरत्कारुनिरुक्तिं त्वं यथावद्वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001971, "chapter_id": 1039, "verse_number": "१-४०-३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001972, "chapter_id": 1039, "verse_number": "१-४०-३", "content_sanskrit": "जरेति क्षयमाहुर्वै दारुणं कारुसंज्ञितम्।\nशरीरं कारु तस्यासीत्तत्स धीमाञ्शनैःशनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001973, "chapter_id": 1039, "verse_number": "१-४०-४", "content_sanskrit": "क्षपयामास तीव्रेण तपसेत्यत उच्यते।\nजरत्कारुरिति ब्रह्मन्वासुकेर्भगिनी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001974, "chapter_id": 1039, "verse_number": "१-४०-५", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा शौनकः प्राहसत्तदा।\nउग्रश्रवसमामन्त्र्य उपपन्नमिति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001975, "chapter_id": 1039, "verse_number": "१-४०-६x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001976, "chapter_id": 1039, "verse_number": "१-४०-६", "content_sanskrit": "उक्तं नाम यथा पूर्वं सर्वं तच्छ्रुतवानहम्।\nयथा तु जातो ह्यास्तीक एतदिच्छामि वेदितुम्।\nतच्छ्रुत्वा वचनं तस्य सौतिः प्रोवाच शास्त्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001977, "chapter_id": 1039, "verse_number": "१-४०-७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001978, "chapter_id": 1039, "verse_number": "१-४०-७", "content_sanskrit": "संदिश्य पन्नगान्सर्वान्वासुकिः सुसमाहितः।\nस्वसारमुद्यम्य तदा जरत्कारुमृषिं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001979, "chapter_id": 1039, "verse_number": "१-४०-८", "content_sanskrit": "अथ कालस्य महतः स मुनिः संशितव्रतः।\nतपस्यभिरतो धीमान्स दारान्नाभ्यकाङ्क्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001980, "chapter_id": 1039, "verse_number": "१-४०-९", "content_sanskrit": "स तूर्ध्वरेतास्तपसि प्रसक्तः\nस्वाध्यायवान्वीतभयः कृतात्मा।\nचचार सर्वां पृथिवीं महात्मा\nन चापि दारान्मनसाध्यकाङ्क्षत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001981, "chapter_id": 1039, "verse_number": "१-४०-१०", "content_sanskrit": "ततोऽपरस्मिन्संप्राप्ते काले कस्मिंश्चिदेव तु।\nपरिक्षिन्नाम राजासीद्ब्रह्मन्कौरववंशजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001982, "chapter_id": 1039, "verse_number": "१-४०-११", "content_sanskrit": "यथा पाण्डुर्महाबाहुर्धनुर्धरवरो युधि।\nबभूव मृगयाशीलः पुरास्य प्रपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001983, "chapter_id": 1039, "verse_number": "१-४०-१२", "content_sanskrit": "तथा विख्यातवाँल्लोके परीक्षिदभिमन्युजः।\nमृगान्विध्यन्वराहांश्च तरक्षून्महिषांस्तथा।\nअन्यांश्च विविधान्वन्यांश्चचार पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001984, "chapter_id": 1039, "verse_number": "१-४०-१३", "content_sanskrit": "स कदाचिन्मृगं विद्ध्वा बाणेनानतपर्वणा।\nपृष्ठतो धनुरादाय ससार गहने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001985, "chapter_id": 1039, "verse_number": "१-४०-१४", "content_sanskrit": "यथैव भगवान्रुद्रो विद्ध्वा यज्ञमृगं दिवि।\nअन्वगच्छद्धनुष्पाणिः पर्यन्वेष्टुमितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001986, "chapter_id": 1039, "verse_number": "१-४०-१५", "content_sanskrit": "न हि तेन मृगो विद्धो जीवन्गच्छति वै वने।\nपूर्वरूपं तु तत्तूर्णं तस्यासीत्स्वर्गतिं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001987, "chapter_id": 1039, "verse_number": "१-४०-१६", "content_sanskrit": "परिक्षितो नरेन्द्रस्य विद्धो यन्नष्टवान्मृगः।\nदूरं चापहृतस्तेन मृगेण स महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001988, "chapter_id": 1039, "verse_number": "१-४०-१७", "content_sanskrit": "परिश्रान्तः पिपासार्त आससाद मुनिं वने।\nगवां प्रचारेष्वासीनं वत्सानां मुखनिःसृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001989, "chapter_id": 1039, "verse_number": "१-४०-१८", "content_sanskrit": "भूयिष्ठमुपयुञ्जानं फेनमापिबतां पयः।\nतमभिद्रुत्य वेगेन स राजा संशितव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001990, "chapter_id": 1039, "verse_number": "१-४०-१९", "content_sanskrit": "अपृच्छद्धनुरुद्यम्य तं मुनिं क्षुच्छ्रमान्वितः।\nभोभो ब्रह्मन्नहं राजा परीक्षिदभिमन्युजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001991, "chapter_id": 1039, "verse_number": "१-४०-२०", "content_sanskrit": "मया विद्धो मृगो नष्टः कच्चित्तं दृष्टवानसि।\nस मुनिस्तं तु नोवाच किंचिन्मौनव्रते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001992, "chapter_id": 1039, "verse_number": "१-४०-२१", "content_sanskrit": "तस्य स्कन्धे मृतं सर्पं क्रुद्धो राजा समासजत्।\nसमुत्क्षिप्य धनुष्कोट्या स चैनं समुपैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001993, "chapter_id": 1039, "verse_number": "१-४०-२२", "content_sanskrit": "न स किंचिदुवाचैनं शुभं वा यदि वाऽशुभम्।\nस राजा क्रोधमुत्सृज्य व्यथितस्तं तथागतम्।\nदृष्ट्वा जगाम नगरमृषिस्त्वासीत्तथैव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001994, "chapter_id": 1039, "verse_number": "१-४०-२३", "content_sanskrit": "न हि तं राजशार्दूलं क्षमाशीलो महामुनिः।\nस्वधर्मनिरतं भूपं समाक्षिप्तोऽप्यधर्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001995, "chapter_id": 1039, "verse_number": "१-४०-२४", "content_sanskrit": "न हि तं राजशार्दूलस्तथा धर्मपरायणम्।\nजानाति भरतश्रेष्ठस्तत एनमधर्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001996, "chapter_id": 1039, "verse_number": "१-४०-२५", "content_sanskrit": "तरुणस्तस्य पुत्रोऽभूत्तिग्मतेजा महातपाः।\nशृङ्गी नाम महाक्रोधो दुष्पसादोमहाव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001997, "chapter_id": 1039, "verse_number": "१-४०-२६", "content_sanskrit": "स देवं परमासीनं सर्वभूतहिते रतम्।\nब्रह्माणमुपतस्थे वै काले काले सुंसयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001998, "chapter_id": 1039, "verse_number": "१-४०-२७", "content_sanskrit": "सतेन समनुज्ञातो ब्रह्मणा गृहमेयिवान्।\nसख्योक्तः क्रीडमानेन स तत्र हसता किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001999, "chapter_id": 1039, "verse_number": "१-४०-२८", "content_sanskrit": "संरम्भात्कोपनोऽतीव विषकल्पो मुनेः सुतः।\nउद्दिश्य पितरं तस्य यच्छ्रुत्वा रोषमाहरत्।\nऋषिपुत्रेण नर्मार्थे कृशेन द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002000, "chapter_id": 1039, "verse_number": "१-४०-२९x", "content_sanskrit": "कृश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002001, "chapter_id": 1039, "verse_number": "१-४०-२९", "content_sanskrit": "तेजस्विनस्तव पिता तथैव च तपस्विनः।\nशवं स्कन्धेन वहति मा शृङ्गिन्गर्वितो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002002, "chapter_id": 1039, "verse_number": "१-४०-३०", "content_sanskrit": "व्याहरत्स्वृषिपुत्रेषु मा स्म किंचिद्वचो वद।\nअस्मद्विधेषु सिद्धेषु ब्रह्मवित्सु तपस्विषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002003, "chapter_id": 1039, "verse_number": "१-४०-३१", "content_sanskrit": "क्व ते पुरुषमानित्वं क्व ते वाचस्तथाविधाः।\nदर्पजाः पितरं द्रष्टा यस्त्वं शवधरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002004, "chapter_id": 1039, "verse_number": "१-४०-३२", "content_sanskrit": "पित्रा च तव तत्कर्म नानुरूपमिवात्मनः।\nकृतं मुनिजनश्रेष्ठ येनाहं भृशदुःखितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002005, "chapter_id": 1039, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि चत्वारिंशोऽध्यायः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]