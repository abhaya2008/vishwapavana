[{"id": 2068630, "chapter_id": 2440, "verse_number": "९-५८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068631, "chapter_id": 2440, "verse_number": "९-५८-१", "content_sanskrit": "ततो दुर्योधनो दृष्ट्वा भीमसेनं तथाऽऽगतम्।\nप्रत्युद्ययावदीनात्मा वेगेन महता नदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068632, "chapter_id": 2440, "verse_number": "९-५८-२", "content_sanskrit": "समापेततुरन्योन्यं शृङ्गिणौ वृषभाविव।\nमहानिर्घातघोषश्च प्रहाराणामजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068633, "chapter_id": 2440, "verse_number": "९-५८-३", "content_sanskrit": "अभवच्च तयोर्युद्वं तुमुलं रोमहर्षणम्।\nजिघृक्षतोर्यथाऽन्योन्यमिन्द्रप्रह्लादयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068634, "chapter_id": 2440, "verse_number": "९-५८-४", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गौ गदाहस्तौ मनस्विनौ।\nददृशाते महात्मानौ पुष्पिताविव किंशुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068635, "chapter_id": 2440, "verse_number": "९-५८-५", "content_sanskrit": "तथा तस्मिन्महायुद्धे वर्तमाने सुदारुणे।\nखद्योतसङ्खैरिव खं दर्शनीयं व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068636, "chapter_id": 2440, "verse_number": "९-५८-६", "content_sanskrit": "तथा तस्मिन्वर्तमाने सङ्कुले तुमुले भृशम्।\nउभावपि परिश्रान्तौ युध्यमानावरिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068637, "chapter_id": 2440, "verse_number": "९-५८-७", "content_sanskrit": "तौ मुहूर्तं समाश्वस्य पुनरेव परन्तपौ।\nसम्प्रहारयतां चित्रे सम्प्रगृह्य गदे शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068638, "chapter_id": 2440, "verse_number": "९-५८-८", "content_sanskrit": "तौ तु दृष्ट्वा महावीर्यौ समाश्वस्तौ नरर्षभौ।\nबलिनौ वारणौ यद्वद्वासितार्थे मदोत्कटौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068639, "chapter_id": 2440, "verse_number": "९-५८-९", "content_sanskrit": "समानवीर्यौ सम्प्रेक्ष्य प्रगृहीतगदावुभौ।\nप्रहर्षं परमं जग्मुर्देवगन्धर्वदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068640, "chapter_id": 2440, "verse_number": "९-५८-१०", "content_sanskrit": "प्रगृहीतगदौ दृष्ट्वा दुर्योधनवृकोदरौ।\nसंशयः सर्वभूतानां विजये समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068641, "chapter_id": 2440, "verse_number": "९-५८-११", "content_sanskrit": "समागम्य ततो भूयो भ्रातरौ बलिनां वरौ।\nअन्योन्यस्यान्तरप्रेप्सू प्रचक्रातेऽन्तरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068642, "chapter_id": 2440, "verse_number": "९-५८-१२", "content_sanskrit": "यमदण्डोपमां गुर्वीमिन्द्राशनिमिवोद्यताम्।\nददृशुः प्रेक्षका राजन्रौद्रीं विशसनीं गदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068643, "chapter_id": 2440, "verse_number": "९-५८-१३", "content_sanskrit": "आविद्ध्यतो गतां तस्य भीमसेनस्य संयुगे।\nशब्दः सुतुमुलो घोरो मुहूर्तं समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068644, "chapter_id": 2440, "verse_number": "९-५८-१४", "content_sanskrit": "आविद्ध्यन्तमरिं प्रेक्ष्य धार्तराष्ट्रोऽथ पाण्डवम्।\nगदामतुलवेगां तां विस्मितः सम्बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068645, "chapter_id": 2440, "verse_number": "९-५८-१५", "content_sanskrit": "चरंश्च विविधान्मार्गान्मण्डलानि च भारत।\nअशोभत तदा वीरो भूय एव वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068646, "chapter_id": 2440, "verse_number": "९-५८-१६", "content_sanskrit": "तौ परस्परमासाद्य यत्तावन्योन्यसूदने।\nमार्जाराविव भक्षार्थे ततक्षाते मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068647, "chapter_id": 2440, "verse_number": "९-५८-१७", "content_sanskrit": "अचरद्भीमसेनस्तु मार्गान्बहुविधांस्तथा।\nमण्डलानि विचित्राणि गतप्रत्यागतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068648, "chapter_id": 2440, "verse_number": "९-५८-१८", "content_sanskrit": "गोमूत्रिकाणि चित्राणि स्थानानि विविधानि च।\nपरिमोक्षं प्रहाराणां वर्जनं परिधावनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068649, "chapter_id": 2440, "verse_number": "९-५८-१९", "content_sanskrit": "अभिद्रवणमाक्षेपमवस्थानं सविग्रहम्।\nमत्स्योद्वृत्तं सोरुवृत्तमवप्लुतमुपप्लुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068650, "chapter_id": 2440, "verse_number": "९-५८-२०", "content_sanskrit": "उपन्यस्तमपन्यस्तं गदायुद्धविशारदौ।\nएवं तौ विचरन्तौ तु न्यघ्नतां वै परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068651, "chapter_id": 2440, "verse_number": "९-५८-२१", "content_sanskrit": "वञ्चयानौ पुनश्चैव चेरतुः कुरुसत्तमौ।\nविक्रीडन्तौ सुबलिनौ मण्डलानि विचेरतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068652, "chapter_id": 2440, "verse_number": "९-५८-२२", "content_sanskrit": "[तौ दर्शयन्तौ समरे युद्धक्रीडां समन्ततः।\nगदाभ्यां सहसाऽन्योन्यमाजघ्नतुररिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068653, "chapter_id": 2440, "verse_number": "९-५८-२३", "content_sanskrit": "परस्परं समासाद्य दंष्ट्राभ्यां द्विरदौ यथा।\nअशोभेतां महाराज शोणितेन परिप्लुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068654, "chapter_id": 2440, "verse_number": "९-५८-२४", "content_sanskrit": "एवं तदभवद्युद्धं घोररूपं परन्तप।\nपरिवृत्तेऽहनि क्रूरं वृत्रवासवयोरिव॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068655, "chapter_id": 2440, "verse_number": "९-५८-२५", "content_sanskrit": "गदाहस्तौ ततस्तौ तु मण्डलावस्थितौ बली।\nदक्षिणं मण्डलं राजन्धार्तराष्ट्रोऽभ्यवर्तत।\nसव्यं तु मण्डलं तत्र भीमसेनोऽभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068656, "chapter_id": 2440, "verse_number": "९-५८-२६", "content_sanskrit": "तथा तु चरतस्तस्य भीमस्य रणमूर्धनि।\nदुर्योधनो महाराज पार्श्वदेशेऽभ्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068657, "chapter_id": 2440, "verse_number": "९-५८-२७", "content_sanskrit": "आहतस्तु ततो भीमः पुत्रेण तव भारत।\nआविध्यत गदां गुवीं प्रहारं तमचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068658, "chapter_id": 2440, "verse_number": "९-५८-२८", "content_sanskrit": "इन्द्राशनिसमां घोरां यमदण्डमिवोद्यताम्।\nददृशुस्ते महाराज भीमसेनस्य तां गदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068659, "chapter_id": 2440, "verse_number": "९-५८-२९", "content_sanskrit": "आविध्यन्तं गदां दृष्ट्वा भीमसेनं तवात्मजः।\nसमुद्यम्य गदां घोरां प्रत्यविध्यत्परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068660, "chapter_id": 2440, "verse_number": "९-५८-३०", "content_sanskrit": "गदामारुतवेगेन तव पुत्रस्य भारत।\nशब्द आसीत्सुतुमुलस्तेजश्च समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068661, "chapter_id": 2440, "verse_number": "९-५८-३१", "content_sanskrit": "स चरन्विविधान्मार्गान्मण्डलानि च भागशः।\nसमशोभत तेजस्वी भूयो भीमात्सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068662, "chapter_id": 2440, "verse_number": "९-५८-३२", "content_sanskrit": "आविद्धा सर्ववेगेन भीमेन महती गदा।\nसधूमं सार्चिषं चाग्निं मुमोचोग्रमहास्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068663, "chapter_id": 2440, "verse_number": "९-५८-३३", "content_sanskrit": "आधूतां भीमसेनेन गदां दृष्ट्वा सुयोधनः।\nअद्रिसारमयीं गुर्वीमाविध्यन्बह्वशोभत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068664, "chapter_id": 2440, "verse_number": "९-५८-३४", "content_sanskrit": "गदामारुतवेगं हि दृष्ट्वा तस्य महात्मनः।\nभयं विवेश पाण्डूंस्तु सर्वानेव ससात्यकीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068665, "chapter_id": 2440, "verse_number": "९-५८-३५", "content_sanskrit": "तौ दर्शयन्तौ समरे युद्धक्रीडां समन्ततः।\nगदाभ्यां सहसाऽन्योन्यमाजघ्नतुररिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068666, "chapter_id": 2440, "verse_number": "९-५८-३६", "content_sanskrit": "तौ परस्परमासाद्य दंष्ट्राभ्यां द्विरदौ यथा।\nअशोभेतां महाराज शोणितेन परिप्लुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068667, "chapter_id": 2440, "verse_number": "९-५८-३७", "content_sanskrit": "एवं तदभवद्युद्धं घोररूपमसंवृतम्।\nपरिवृत्तेऽहनि क्रूरं वृत्रवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068668, "chapter_id": 2440, "verse_number": "९-५८-३८", "content_sanskrit": "दृष्ट्वा व्यवस्थितं भीमं तव पुत्रो महाबलः।\nचरंश्चित्रतरान्मा र्गान्कौन्तेयमभिदुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068669, "chapter_id": 2440, "verse_number": "९-५८-३९", "content_sanskrit": "तस्य भीमो महावेगां जाम्बूनदपरिष्कृताम्।\nअतिक्रुद्धस्य क्रुद्धस्तु ताडयामास तां गदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068670, "chapter_id": 2440, "verse_number": "९-५८-४०", "content_sanskrit": "सविस्फुलिङ्गो निर्हादस्तयोस्तत्राभिघातजः।\nप्रादुरासीन्महाराज घृष्टयोर्वज्रयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068671, "chapter_id": 2440, "verse_number": "९-५८-४१", "content_sanskrit": "वेगवत्या तया तत्र भीमसेनप्रमुक्तया।\nनिपतन्त्या महाराज पृथिवी समकम्पत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068672, "chapter_id": 2440, "verse_number": "९-५८-४२", "content_sanskrit": "तां नामृष्यत कौरव्यो गदां प्रतिहतां रणे।\nमत्तो द्विप इव क्रुद्धः प्रतिकुञ्जरदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068673, "chapter_id": 2440, "verse_number": "९-५८-४३", "content_sanskrit": "स सव्यं मण्डलं राजा उद्धाम्य कृतनिश्चयः।\nआजघ्ने मूर्ध्नि कौन्तेयं गदया भीमवेगया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068674, "chapter_id": 2440, "verse_number": "९-५८-४४", "content_sanskrit": "तया त्वभिहतो भीमः पुत्रेण तव पाण्डवः।\nनाकम्पत महाराज तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068675, "chapter_id": 2440, "verse_number": "९-५८-४५", "content_sanskrit": "आश्चर्यं चापि तद्राजन्सर्वसैन्यान्यपूजयन्।\nयद्गदाभिहतो भीमो नाकम्पत पदात्पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068676, "chapter_id": 2440, "verse_number": "९-५८-४६", "content_sanskrit": "ततो गुरुतरां दीप्तां गदां हेमपरिष्कृताम्।\nदुर्योधनाय व्यसृजद्भीमो भीमपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068677, "chapter_id": 2440, "verse_number": "९-५८-४७", "content_sanskrit": "तं प्रहारमसम्भ्रान्तो लाघवेन महाबलः।\nमोघं दुर्योधनश्चक्रे तत्राभूद्विस्मयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068678, "chapter_id": 2440, "verse_number": "९-५८-४८", "content_sanskrit": "सा तु मोघा गदा राजन्पतन्ती भीमचोदिता।\nचालयामास पृथिवीं महानिर्घातनिःस्वनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068679, "chapter_id": 2440, "verse_number": "९-५८-४९", "content_sanskrit": "आस्थाय कौशिकान्मार्गानुत्पतन्स पुनः पुनः।\nगदानिपातं प्रज्ञाय भीमसेनं च वञ्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068680, "chapter_id": 2440, "verse_number": "९-५८-५०", "content_sanskrit": "वञ्चयित्वा तदा भीमं गदया कुरुसत्तमः।\nताडयामास सङ्क्रुद्धो वक्षोदेशे महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068681, "chapter_id": 2440, "verse_number": "९-५८-५१", "content_sanskrit": "गदया निहतो भीमो मुह्यमानो महारणे।\nनाभ्यमन्यत कर्तव्यं पुत्रेणाभ्याहतस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068682, "chapter_id": 2440, "verse_number": "९-५८-५२", "content_sanskrit": "तस्मिंस्तथा वर्तमाने राजन्सोमकपाण़्डवाः।\nभृशोपहतसङ्कल्पा नहृष्टमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068683, "chapter_id": 2440, "verse_number": "९-५८-५३", "content_sanskrit": "स तु तेन प्रहारेण मातङ्ग इव रोषितः।\nहस्तिवद्वस्तिसंकाशमभिदुद्राव ते सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068684, "chapter_id": 2440, "verse_number": "९-५८-५४", "content_sanskrit": "ततस्तु तरसा भीमो गदया तनयं तव।\nअभिदुद्राव वेगेन सिंहो वनगजं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068685, "chapter_id": 2440, "verse_number": "९-५८-५५", "content_sanskrit": "उपसृत्य तु राजानं गदामोक्षविशारदः।\nआविध्यत गदां राजन्समुद्दिश्य सुतं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068686, "chapter_id": 2440, "verse_number": "९-५८-५६", "content_sanskrit": "अताडयद्भीमसेनः पार्श्वे दुर्योधनं तदा।\nस विह्वलः प्रहारेण जानुभ्यामगमन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068687, "chapter_id": 2440, "verse_number": "९-५८-५७", "content_sanskrit": "तस्मिन्कुरुकुलश्रेष्ठे जानुभ्यामवनीं गते।\nउदतिष्ठत्ततो नादः सृञ्जयानां जगत्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2068688, "chapter_id": 2440, "verse_number": "९-५८-५८", "content_sanskrit": "तेषां तु निनदं श्रुत्वा शृञ्जयानां नरर्षभः।\nअमर्षाद्भरतश्रेष्ठ पुत्रस्ते समकुप्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2068689, "chapter_id": 2440, "verse_number": "९-५८-५९", "content_sanskrit": "उत्थाय तु महाबाहुर्महानाग इव श्वसन्।\nदिधक्षन्निव नेत्राभ्यां भीमसेनमवैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2068690, "chapter_id": 2440, "verse_number": "९-५८-६०", "content_sanskrit": "ततः स भरतश्रेष्ठो गदापाणिरभिद्रवन्।\nप्रमथिष्यन्निव शिरो भीमसेनस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2068691, "chapter_id": 2440, "verse_number": "९-५८-६१", "content_sanskrit": "स महात्मा महात्मानं भीमं भीमपराक्रमः।\nअताडयच्छङ्खदेशे न चचालाचलोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2068692, "chapter_id": 2440, "verse_number": "९-५८-६२", "content_sanskrit": "स भूयः शुशुभे पार्थस्ताडितो गदया रणे।\nउद्भिन्नरुधिरो राजन्प्रभिन्न इव कुञ्चरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2068693, "chapter_id": 2440, "verse_number": "९-५८-६३", "content_sanskrit": "ततो गदां वीरहणीमयोमयीं\nप्रगृह्य वज्राशनितुल्यनिःस्वनाम्।\nअताडयच्छत्रुममित्रकर्शनो\nबलेन विक्रम्य धनञ्जयाग्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2068694, "chapter_id": 2440, "verse_number": "९-५८-६४", "content_sanskrit": "स भीमसेनाभिहतस्तवात्मजः\nपपात सङ्कम्पितदेहबन्धनः।\nसुपुष्पितो मारुतवेगताडितो\nवने महासाल इवावघूर्णितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2068695, "chapter_id": 2440, "verse_number": "९-५८-६५", "content_sanskrit": "ततः प्रणेदुर्जहृषुश्च पाण्डवाः\nसमीक्ष्य पुत्रं पतितं क्षितौ तव।\nततः सुतस्ते प्रतिलभ्य चेतनां\nसमुत्पपात द्विरदो यथा हदात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2068696, "chapter_id": 2440, "verse_number": "९-५८-६६", "content_sanskrit": "स पार्थिवो नित्यममर्षितस्तदा\nमहारथः शिक्षितवत्परिभ्रमन्।\nअताडयत्पाण्डवमग्रतः स्थितं\nस विह्वलाङ्गो जगतीमुपास्पृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2068697, "chapter_id": 2440, "verse_number": "९-५८-६७", "content_sanskrit": "स सिंहनादं विननाद कौरवो\nनिपात्य भूमौ युधि भीममोजसा।\nबिभेद चैवाशनितुल्यमोजसा\nगदानिपातेन शरीररक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2068698, "chapter_id": 2440, "verse_number": "९-५८-६८", "content_sanskrit": "ततोऽन्तरिक्षे निनदो महानभू--\nद्दिवौकसामप्सरसां च नेदुषाम्।\nपपात चोच्चैरमरप्रवेरितं\nविचित्रपुष्पोत्करवर्षमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2068699, "chapter_id": 2440, "verse_number": "९-५८-६९", "content_sanskrit": "ततः परानाविशदुत्तमं भयं\nसमीक्ष्य भूमौ पतितं नरोत्तमम्।\nअहीयमानं च बलेन कौरवं\nनिशाम्य भेदं सुदृढस्य वर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2068700, "chapter_id": 2440, "verse_number": "९-५८-७०", "content_sanskrit": "ततो मुहूर्तादुपलभ्य चेतनां\nप्रमृज्य वक्त्रं रुधिराक्तमात्मनः।\nधृतिं समालम्ब्य विवृत्य लोचने\nबलेन संस्तभ्य वृकोदरः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2068701, "chapter_id": 2440, "verse_number": "९-५८-७१", "content_sanskrit": "`ततो यमौ यमसदृशौ पराक्रमे\nसपार्षतः शिनितनयश्च वीर्यवान्।\nसमाह्वयन्नहमहमित्यभित्वरं--\nस्तवात्मजं समभिययुर्वधैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2068702, "chapter_id": 2440, "verse_number": "९-५८-७२", "content_sanskrit": "निवर्त्य तान्पुनरपि पाण्डवो बली\nतवात्मजं स्वयमभिगम्य कालवत्।\nचचार चाप्यपगतखेदवेपथुः\nसुरेश्वरो नमुचिमिवोत्तमं रणे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2068703, "chapter_id": 2440, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि अष्टपञ्चाशत्तमोऽध्यायः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]