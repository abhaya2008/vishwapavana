[{"id": 2189571, "chapter_id": 5025, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189572, "chapter_id": 5025, "verse_number": "१", "content_sanskrit": "इत्युक्तोऽभिप्रशस्यैतत् परमर्षेस्तु शासनम् ।\nमोक्षधर्मार्थसंयुक्तमिदं प्रष्टुं प्रचक्रमे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189573, "chapter_id": 5025, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189574, "chapter_id": 5025, "verse_number": "२", "content_sanskrit": "प्रजावान् श्रोत्रियो यज्वा वृद्धः प्रज्ञोऽनसूयकः ।\nअनागतमनैतिह्यं कथं ब्रह्माधिगच्छति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2189575, "chapter_id": 5025, "verse_number": "३", "content_sanskrit": "तपसा ब्रह्मचर्येण सर्वत्यागेन मेधया ।\nसाङ्ख्ये वा यदि वा योगे एतत् पृष्टोऽभिधत्स्व मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2189576, "chapter_id": 5025, "verse_number": "४", "content_sanskrit": "मनसश्चेन्द्रियाणां चाप्यैकाग्र्यं समवाप्यते ।\nयेनोपायेन पुरुषैस्तच्च व्याख्यातुमर्हसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2189577, "chapter_id": 5025, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2189578, "chapter_id": 5025, "verse_number": "५", "content_sanskrit": "नान्यत्र विद्यातपसोर्नान्यत्रेन्द्रियनिग्रहात् ।\nनान्यत्र सर्वसन्त्यागात् सिद्धिं विन्दति कश्चन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2189579, "chapter_id": 5025, "verse_number": "६", "content_sanskrit": "महाभूतानि सर्वाणि पूर्वसृष्टिः स्वयम्भुवः ।\nभूयिष्ठं प्राणभृद् वामे निविष्टानि शरीरिषु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2189580, "chapter_id": 5025, "verse_number": "७", "content_sanskrit": "भूमेर्देहो जलात् सारो ज्योतिषश्चक्षुषी स्मृते ।\nप्राणापानाश्रयो वायुः खेष्वाकाशं शरीरिणाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2189581, "chapter_id": 5025, "verse_number": "८", "content_sanskrit": "क्रान्ते विष्णुर्बले शक्रः कोष्ठेऽग्निर्भुक्तमर्छति ।\nकर्णयोः प्रदिशः श्रोत्रे जिह्वायां वाक् सरस्वती\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2189582, "chapter_id": 5025, "verse_number": "९", "content_sanskrit": "कर्णौ त्वक्चक्षुषी जिह्वा नासिका चैव पञ्चमी ।\nदर्शनानीन्द्रियोक्तानि द्वाराण्याहारसिद्धये\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2189583, "chapter_id": 5025, "verse_number": "१०", "content_sanskrit": "शब्दं स्पर्शं तथा रूपं रसं गन्धं च पञ्चमम् ।\nइन्द्रियाणि पृथक्त्वर्थान्मनसो दर्शयन्त्युत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2189584, "chapter_id": 5025, "verse_number": "११", "content_sanskrit": "इन्द्रियाणि मनो युङ्क्ते वश्यान्यन्तेव वाजिनः ।\nमनश्चापि सदा युङ्क्ते भूतात्मा हृदयाश्रितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2189585, "chapter_id": 5025, "verse_number": "१२", "content_sanskrit": "इन्द्रियाणां तथैवेषां सर्वेषामीश्वरं मनः ।\nनियमे च विसर्गे च भूतात्मा मनसस्तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2189586, "chapter_id": 5025, "verse_number": "१३", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थाश्च स्वभावश्चेतना मनः ।\nप्राणापानौ च जीवश्च नित्यं देहेषु देहिनाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2189587, "chapter_id": 5025, "verse_number": "१४", "content_sanskrit": "आश्रयोऽन्योऽस्ति सत्त्वस्य गुणः सत्त्वस्य चेतना ।\nसत्त्वं हि तेजः सृजति न गुणान् वै कदाचन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2189588, "chapter_id": 5025, "verse_number": "१५", "content_sanskrit": "एवं सप्तदशं देहे वृतं षोडशभिर्गुणैः ।\nमनीषी मनसा विप्रः पश्यत्यात्मानमात्मनि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2189589, "chapter_id": 5025, "verse_number": "१६", "content_sanskrit": "न ह्ययं चक्षुषा दृश्यो न च सर्वैरपीन्द्रियैः ।\nमनसा सम्प्रदीप्तेन महानात्मा प्रकाशते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2189590, "chapter_id": 5025, "verse_number": "१७", "content_sanskrit": "अशब्दस्पर्शरूपं तदरसागन्धमव्ययम् ।\nअशरीरं शरीरे स्वे निरीक्षेत निरिन्द्रियम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2189591, "chapter_id": 5025, "verse_number": "१८", "content_sanskrit": "अव्यक्तं व्यक्तदेहेषु मर्त्येष्वमरमाश्रितम् ।\nयोऽनुपश्यति स प्रेत्य कल्पते ब्रह्मभूयसे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2189592, "chapter_id": 5025, "verse_number": "१९", "content_sanskrit": "विद्याभिजनसम्पन्ने ब्राह्मणे गवि हस्तिनि ।\nशुनि चैव श्वपाके च पण्डिताः समदर्शिनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2189593, "chapter_id": 5025, "verse_number": "२०", "content_sanskrit": "स हि सर्वेषु भूतेषु जङ्गमेषु ध्रुवेषु च ।\nवसत्येको महानात्मा येन सर्वमिदं ततम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2189594, "chapter_id": 5025, "verse_number": "२१", "content_sanskrit": "सर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि ।\nयदा पश्यति भूतात्मा ब्रह्म सम्पद्यते तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2189595, "chapter_id": 5025, "verse_number": "२२", "content_sanskrit": "यावानात्मनि वेदात्मा तावानात्मा परात्मनि ।\nय एवं सततं वेद सोऽमृतत्वाय कल्पते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2189596, "chapter_id": 5025, "verse_number": "२३", "content_sanskrit": "सर्वभूतात्मभूतस्य सर्वभूतहितस्य च ।\nदेवापि मार्गे मुह्यन्ति अपदस्य पदैषिणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2189597, "chapter_id": 5025, "verse_number": "२४", "content_sanskrit": "शकुनीनामिवाकाशे जले वारिचरस्य वा ।\nयथा गतिर्न दृश्येत तथैव सुमहात्मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2189598, "chapter_id": 5025, "verse_number": "२५", "content_sanskrit": "कालः पचति भूतानि सर्वाण्येवात्मनात्मनि ।\nयस्मिंस्तु पच्यते कालस्तं न वेदेह कश्चन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2189599, "chapter_id": 5025, "verse_number": "२६", "content_sanskrit": "न तदूर्ध्वं न तिर्यक्च नाधो न च तिरः पुनः ।\nन मध्ये प्रतिगृह्णीते नैव कश्चित् कुतश्चन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2189600, "chapter_id": 5025, "verse_number": "२७", "content_sanskrit": "सर्वेऽन्तःस्था इमे लोका बाह्यमेषां न किञ्चन ।\nयः सहस्रं समागच्छेद्यथा बाणो गुणच्युतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2189601, "chapter_id": 5025, "verse_number": "२८", "content_sanskrit": "नैवान्तं कारणस्येयाद्यद्यपि स्यान्मनोजवः ।\nतस्मात् सूक्ष्मात् सूक्ष्मतरं नास्ति स्थूलतरं ततः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2189602, "chapter_id": 5025, "verse_number": "२९", "content_sanskrit": "सर्वतःपाणिपादं तत् सर्वतोक्षिशिरोमुखम् ।\nसर्वतःश्रुतिमल्लोके सर्वमावृत्य तिष्ठति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2189603, "chapter_id": 5025, "verse_number": "३०", "content_sanskrit": "तदेवाणोरणुतरं तन्महद्भ्यो महत्तरम् ।\nतदन्तः सर्वभूतानां ध्रुवं तिष्ठन्न दृश्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2189604, "chapter_id": 5025, "verse_number": "३१", "content_sanskrit": "अक्षरं च क्षरं चैव द्वैधीभावोऽयमात्मनः ।\nक्षरः सर्वेषु भूतेषु दिव्यं ह्यमृतमक्षरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2189605, "chapter_id": 5025, "verse_number": "३२", "content_sanskrit": "नवद्वारं पुरं गत्वा हंसो हि नियतो वशी ।\nईशः सर्वस्य भूतस्य स्थावरस्य चरस्य च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2189606, "chapter_id": 5025, "verse_number": "३३", "content_sanskrit": "पातेनाजं विकल्पानां नवानां संशयेन शयः ।\nशरीराणामजस्याहुर्हंसत्वं पारदर्शिनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2189607, "chapter_id": 5025, "verse_number": "३४", "content_sanskrit": "हंसोक्तं यत् क्षरं चैव कूटस्थं यत्तदक्षरम् ।\nतद् विद्वानक्षरं प्राप्य जहाति प्राणजन्मनी\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2189608, "chapter_id": 5025, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे ब्रह्माधिगमोपायविधिर्नाम चतुःसप्ततितमोऽध्यायः ॥७४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]