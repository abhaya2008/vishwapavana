[{"id": 2035700, "chapter_id": 1773, "verse_number": "५-१८-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035701, "chapter_id": 1773, "verse_number": "५-१८-१", "content_sanskrit": "ततः शक्रः स्तूयमानो गन्धर्वाप्सरसां गणैः।\nऐरावतं समारुह्य द्विपेन्द्रं लक्षणैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035702, "chapter_id": 1773, "verse_number": "५-१८-२", "content_sanskrit": "पावकः सुमहातेजा महर्षिश्च बृहस्पतिः।\nयमश्च वरुणश्चैव कुबेरश्च धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035703, "chapter_id": 1773, "verse_number": "५-१८-३", "content_sanskrit": "सर्वैर्देवैः परिवृतः शक्रो वृत्रनिषूदनः ।\nगन्धर्वैरप्सरोभिश्च यातस्त्रिभुवनं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035704, "chapter_id": 1773, "verse_number": "५-१८-४", "content_sanskrit": "स समेत्य महेन्द्राण्या देवराजः शतक्रतुः।\nमुदा परमया युक्तः पालयामास देवराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035705, "chapter_id": 1773, "verse_number": "५-१८-५", "content_sanskrit": "ततः स भगवांस्तत्र अङ्गिराः समदृश्यत।\nअथर्ववेदमन्त्रैश्च देवेन्द्रं समपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035706, "chapter_id": 1773, "verse_number": "५-१८-६", "content_sanskrit": "ततस्तु भगवानिन्द्रः संहृष्टः समपद्यत।\nवरं च प्रददौ तस्मै अथर्वाङ्गिरसे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035707, "chapter_id": 1773, "verse_number": "५-१८-७", "content_sanskrit": "अथर्वाङ्गिरसं नाम वेदेऽस्मिन्वै भविष्यति।\nउदाहरणमेतद्धि यज्ञभागं च लप्स्यसे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035708, "chapter_id": 1773, "verse_number": "५-१८-८", "content_sanskrit": "एवं संपूज्य भगवानथर्वाङ्गिरसं तदा।\nव्यसर्जयन्महाराज देवराजः शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035709, "chapter_id": 1773, "verse_number": "५-१८-९", "content_sanskrit": "संपूज्य सर्वांस्त्रिदशानृषींश्चापि तपोधनान्।\nइन्द्रः प्रमुदितो राजन्धर्मेणापालयत्प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035710, "chapter_id": 1773, "verse_number": "५-१८-१०", "content_sanskrit": "एवं दुःखमनुप्राप्तमिन्द्रेण सह भार्यया।\nअज्ञातवासश्च कृतः शत्रूणां वधकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035711, "chapter_id": 1773, "verse_number": "५-१८-११", "content_sanskrit": "नात्र मन्युस्त्वया कार्यो यत्क्लिष्टोऽसि महावने।\nद्रौपद्या सह राजेन्द्र भ्रातृभिश्च महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035712, "chapter_id": 1773, "verse_number": "५-१८-१२", "content_sanskrit": "एवं त्वमपि राजेन्द्र राज्यं प्राप्स्यसि भारत।\nवृत्रं हत्वा यथा प्राप्तः शक्रः कौरवनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035713, "chapter_id": 1773, "verse_number": "५-१८-१३", "content_sanskrit": "दुराचारश्च नहुषो ब्रह्वद्विट् पापचेतनः।\nअगस्त्यशापाभिहतो विनष्टः शाश्वतीः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035714, "chapter_id": 1773, "verse_number": "५-१८-१४", "content_sanskrit": "एवं तव दुरात्मानः शत्रवः शत्रुसूदन ।\nक्षिप्रं नाशं गमिष्यन्ति कर्णदुर्योधनादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035715, "chapter_id": 1773, "verse_number": "५-१८-१५", "content_sanskrit": "ततः सागरपर्यन्तां भोक्ष्यसे मेदिनीमिमाम्।\nभ्रातृभिः सहितो वीर द्रौपद्या च सहानया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035716, "chapter_id": 1773, "verse_number": "५-१८-१६", "content_sanskrit": "उपाख्यानमिदं शक्रविजयं वेदसंमितम् ।\nराज्ञा व्यूढेष्वनीकेषु श्रोतव्यं जयमिच्छता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035717, "chapter_id": 1773, "verse_number": "५-१८-१७", "content_sanskrit": "तस्मात्संश्रावयामि त्वां विजयं जयतां वर।\nसंस्तूयमाना वर्धन्ते महात्मानो युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035718, "chapter_id": 1773, "verse_number": "५-१८-१८", "content_sanskrit": "क्षत्रियाणामभावोयं युधिष्ठिर महात्मनाम्।\nदुर्योधनापराधेन भीमार्जुनबलेन च॥\nसङ्ग्रामे संक्षयो घोरो भविष्यत्यचिरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035719, "chapter_id": 1773, "verse_number": "५-१८-१९", "content_sanskrit": "आख्यानमिन्द्रविजयं य इदं नियतः पठेत्।\nधूतपाप्मा जितस्वर्गः परत्रेह च मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035720, "chapter_id": 1773, "verse_number": "५-१८-२०", "content_sanskrit": "न चारिजं भयं तस्य नापुत्रो वा भवेन्नरः।\nनापदं प्राप्नुयात्कांचिद्दीर्घमायुश्च विन्दति।\nसर्वत्र दयमाप्नोति न कदाचित्पराजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035721, "chapter_id": 1773, "verse_number": "५-१८-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035722, "chapter_id": 1773, "verse_number": "५-१८-२१", "content_sanskrit": "एवमाश्वासितो राजा शल्येन भरतर्षभ ।\nपूजयामास विधिवच्छल्यं धर्मभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035723, "chapter_id": 1773, "verse_number": "५-१८-२२", "content_sanskrit": "श्रुत्वा तु शल्यवचनं कुन्तीपुत्रो युधिष्ठिरः।\nप्रत्युवाच महाबाहुर्मद्रराजमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035724, "chapter_id": 1773, "verse_number": "५-१८-२३", "content_sanskrit": "भवान्कर्णस्य सारथ्यं करिष्यति न संशयः।\nतत्र तेजोवधः कार्यः कर्णस्यार्जुनसंस्तवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035725, "chapter_id": 1773, "verse_number": "५-१८-२४x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035726, "chapter_id": 1773, "verse_number": "५-१८-२४", "content_sanskrit": "एवमेतत्करिष्यामि यथा मां संप्रभाषसे।\nयच्चान्यदपि शक्ष्यामि तत्करिष्याम्यहं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035727, "chapter_id": 1773, "verse_number": "५-१८-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035728, "chapter_id": 1773, "verse_number": "५-१८-२५", "content_sanskrit": "ततस्त्वामन्त्र्य कौन्तेयाञ्छल्यो मद्राधिपस्तदा।\nजगाम सबलः श्रीमान्दुर्योधनमरिन्दम ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035729, "chapter_id": 1773, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि अष्टादशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]