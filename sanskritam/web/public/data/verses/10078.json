[{"id": 6000078000, "chapter_id": 10078, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000078001, "chapter_id": 10078, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.001.m4a", "display_order": 2}, {"id": 6000078002, "chapter_id": 10078, "verse_number": "४-१४-१", "content_sanskrit": "भृग्वादयस्ते मुनयो लोकानां क्षेमदर्शिनः।\nगोप्तर्यसति वै नॄणां पश्यन्तः पशुसाम्यताम्॥ ४/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.002.m4a", "display_order": 3, "topics": [{"text": "अराजकभयत्रस्तैः भृग्वादिमुनिभिः वेनस्य पट्टाभिषेकः", "range": "१–१२"}]}, {"id": 6000078003, "chapter_id": 10078, "verse_number": "४-१४-२", "content_sanskrit": "वीर मातरमाहूय सुनीथां ब्रह्मवादिनः।\nप्रकृत्याऽसंमतं वेनमभ्यषिञ्चन् पतिं भुवः॥ ४/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.003.m4a", "display_order": 4}, {"id": 6000078004, "chapter_id": 10078, "verse_number": "४-१४-३", "content_sanskrit": "श्रुत्वा नृपासनगतं वेनमत्युग्रशासनम्।\nनिलिल्युर्दस्यवः सद्यः सर्पत्रस्ता इवाखवः॥ ४/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.004.m4a", "display_order": 5}, {"id": 6000078005, "chapter_id": 10078, "verse_number": "४-१४-४", "content_sanskrit": "स आरूढनृपस्थान उन्नद्धोऽष्टविभूतिभिः।\nअवमेने महाभागान् स्तब्धः सम्भावितः शठः॥ ४/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.005.m4a", "display_order": 6}, {"id": 6000078006, "chapter_id": 10078, "verse_number": "४-१४-५", "content_sanskrit": "एवं मदान्ध उत्सिक्तो निरङ्कुश इव द्विपः।\nपर्यटन् रथमास्थाय कम्पयन्निव रोदसी॥ ४/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.006.m4a", "display_order": 7}, {"id": 6000078007, "chapter_id": 10078, "verse_number": "४-१४-६", "content_sanskrit": "न यष्टव्यं न दातव्यं न होतव्यं द्विजाःक्‍वचित्।\nएवं न्यवारयद् धर्मं भेरीघोषेण सर्वतः॥ ४/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.007.m4a", "display_order": 8}, {"id": 6000078008, "chapter_id": 10078, "verse_number": "४-१४-७", "content_sanskrit": "वेनस्यावेक्ष्य मुनयो दुर्वृत्तस्य विचेष्टितम्।\nविमृश्य लोकव्यसनं कृपयोचुः स्म सत्रिणः॥ ४/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.008.m4a", "display_order": 9}, {"id": 6000078009, "chapter_id": 10078, "verse_number": "४-१४-८", "content_sanskrit": "अहो उभयतः प्राप्तं लोकस्य व्यसनं महत्।\nदारुण्युभयतो दीप्त इव तस्करपालयोः॥ ४/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.009.m4a", "display_order": 10}, {"id": 6000078010, "chapter_id": 10078, "verse_number": "४-१४-९", "content_sanskrit": "अराजकभयादेषः कृतो राजाऽतदर्हणः।\nततोऽप्यासीद्भयं त्वद्य कथं स्यात् स्वस्ति देहिनाम्॥ ४/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.010.m4a", "display_order": 11}, {"id": 6000078011, "chapter_id": 10078, "verse_number": "४-१४-१०", "content_sanskrit": "अहेरिव पयःपोषः पोषकस्याप्यनर्थकृत्॥ ४/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.011.m4a", "display_order": 12}, {"id": 6000078012, "chapter_id": 10078, "verse_number": "४-१४-११", "content_sanskrit": "वेनः प्रकृत्यैव खलः सुनीथागर्भसम्भवः।\nनिरूपितः प्रजापालः स जिघांसति वै प्रजाः॥ ४/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.012.m4a", "display_order": 13}, {"id": 6000078013, "chapter_id": 10078, "verse_number": "४-१४-१२", "content_sanskrit": "तथाऽपि सान्त्वयामोऽमुं माऽस्मांस्तत्पातकं स्पृशेत्।\nतद्विद्वद्भिरसद्वृत्तो वेनोऽस्माभिः कृतो नृपः॥ ४/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.013.m4a", "display_order": 14}, {"id": 6000078014, "chapter_id": 10078, "verse_number": "४-१४-१३", "content_sanskrit": "सान्त्वितो यदि नो वाचं न ग्रहीष्यत्यधर्मकृत्।\nलोकधिक्‍कारसन्दग्धं दहिष्यामः स्वतेजसा॥ ४/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.014.m4a", "display_order": 15, "topics": [{"text": "अधर्मे प्रवृत्तस्य वेनस्य ऋषिभिः हुङ्कारेण हननम्", "range": "१३–३६"}]}, {"id": 6000078015, "chapter_id": 10078, "verse_number": "४-१४-१४", "content_sanskrit": "एवमध्यवसायैनं मुनयो गूढमन्यवः।\nउपव्रज्याब्रुवन् वेनं सान्त्वयित्वाऽथ सामभिः॥ ४/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.015.m4a", "display_order": 16}, {"id": 6000078016, "chapter_id": 10078, "verse_number": "४-१४-१५", "content_sanskrit": "नृपवर्य निबोधैतद् यत् ते विज्ञापयाम भोः।\nआयुःश्रीबलकीर्तीनां तव तात विवर्धनम्॥ ४/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.016.m4a", "display_order": 17}, {"id": 6000078017, "chapter_id": 10078, "verse_number": "४-१४-१६", "content_sanskrit": "धर्म आचरितः पुंसां वाङ्मनःकायबुद्धिभिः।\nलोकान् विशोकान् वितरत्यथाऽनन्त्यमसङ्गिनाम्॥ ४/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.017.m4a", "display_order": 18}, {"id": 6000078018, "chapter_id": 10078, "verse_number": "४-१४-१७", "content_sanskrit": "स ते मा विनशेद् वीर प्रजानां क्षेमलक्षणः।\nयस्मिन् विनष्टे नृपतिरैश्वर्यादवरोहति॥ ४/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.018.m4a", "display_order": 19}, {"id": 6000078019, "chapter_id": 10078, "verse_number": "४-१४-१८", "content_sanskrit": "राजन्नसाध्वमात्येभ्यश्चोरादिभ्यः प्रजा नृपः।\nरक्षन् यथा बलिं गृह्णन्निह प्रेत्य च मोदते॥ ४/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.019.m4a", "display_order": 20}, {"id": 6000078020, "chapter_id": 10078, "verse_number": "४-१४-१९", "content_sanskrit": "यस्य राष्ट्रे पुरे चैव भगवान् यज्ञपूरुषः।\nइज्यते स्वेन धर्मेण जनैर्वर्णाश्रमात्मकैः॥ ४/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.020.m4a", "display_order": 21}, {"id": 6000078021, "chapter_id": 10078, "verse_number": "४-१४-२०", "content_sanskrit": "तस्य राज्ञो महाराज भगवान् भूतभावनः।\nपरितुष्यति विश्वात्मा तिष्ठतो निजशासने॥ ४/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.021.m4a", "display_order": 22}, {"id": 6000078022, "chapter_id": 10078, "verse_number": "४-१४-२१", "content_sanskrit": "तस्मिंस्तुष्टे किमप्राप्यं जगतामीश्वरेश्वरे।\nलोकाः सपाला ह्येतस्मै हरन्ति बलिमादृताः॥ ४/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.022.m4a", "display_order": 23}, {"id": 6000078023, "chapter_id": 10078, "verse_number": "४-१४-२२", "content_sanskrit": "तं सर्वलोकामरयज्ञसंग्रहं त्रयीमयं द्रव्यमयं तपोमयम्।\nयज्ञैर्विचित्रैर्यजतो भवाय ते राजन् स्वदेशाननुरोद्धुमर्हसि॥ ४/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.023.m4a", "display_order": 24}, {"id": 6000078024, "chapter_id": 10078, "verse_number": "४-१४-२३", "content_sanskrit": "यज्ञेन युष्मद्विषये द्विजातिभिर्वितायमानेन सुराः कला हरेः।\nस्विष्टाः सुतुष्टाः प्रदिशन्ति वाञ्छितं तद्धेलनं नार्हसि वीर चेष्टितुम्॥ ४/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.024.m4a", "display_order": 25}, {"id": 6000078025, "chapter_id": 10078, "verse_number": null, "content_sanskrit": "वेन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.025.m4a", "display_order": 26}, {"id": 6000078026, "chapter_id": 10078, "verse_number": "४-१४-२४", "content_sanskrit": "बालिशा बत यूयं वै अधर्मे धर्ममानिनः।\nये वृत्तिदं पतिं हित्वा जारं पतिमुपासते॥ ४/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.026.m4a", "display_order": 27}, {"id": 6000078027, "chapter_id": 10078, "verse_number": "४-१४-२५", "content_sanskrit": "अवजानन्ति ये मूढा नृपरूपिणमीश्वरम्।\nनानुविन्दन्ति ते भद्रमिह लोके परत्र च॥ ४/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.027.m4a", "display_order": 28}, {"id": 6000078028, "chapter_id": 10078, "verse_number": "४-१४-२६", "content_sanskrit": "को यज्ञपुरुषो नाम यत्र वो भक्तिरीदृशी।\nभर्तृस्नेहविदूराणां यथा जारे कुयोषिताम्॥ ४/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.028.m4a", "display_order": 29}, {"id": 6000078029, "chapter_id": 10078, "verse_number": "४-१४-२७", "content_sanskrit": "विष्णुर्विरिञ्चो गिरिश इन्द्रो वायुर्यमो रविः।\nपर्जन्यो धनदः सोमः क्षितिरग्निरपां पतिः॥ ४/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.029.m4a", "display_order": 30}, {"id": 6000078030, "chapter_id": 10078, "verse_number": "४-१४-२८", "content_sanskrit": "एते चान्ये च विबुधाः प्रभवो वरशापयोः।\nदेहे तिष्ठन्ति नृपतेः सर्वदेवमयो नृपः॥ ४/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.030.m4a", "display_order": 31}, {"id": 6000078031, "chapter_id": 10078, "verse_number": "४-१४-२९", "content_sanskrit": "तस्मान्मां कर्मभिर्विप्रा यजध्वं गतमत्सराः।\nबलिं च मह्यं हरत मत्तोऽन्यः कोऽग्रभुक् पुमान् २९॥ ४/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.031.m4a", "display_order": 32}, {"id": 6000078032, "chapter_id": 10078, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.032.m4a", "display_order": 33}, {"id": 6000078033, "chapter_id": 10078, "verse_number": "४-१४-३०", "content_sanskrit": "इत्थं विपर्ययमतिः पापीयानुत्पथं गतः।\nअनुनीयमानस्तद्याच्ञां न चक्रे भ्रष्टमङ्गलः॥ ४/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.033.m4a", "display_order": 34}, {"id": 6000078034, "chapter_id": 10078, "verse_number": "४-१४-३१", "content_sanskrit": "इति तेऽसकृतास्तेन द्विजाः पण्डितमानिना।\nभग्नायां हव्ययाच्ञायां तस्मै विदुर चुक्रुधुः॥ ४/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.034.m4a", "display_order": 35}, {"id": 6000078035, "chapter_id": 10078, "verse_number": "४-१४-३२", "content_sanskrit": "हन्यतां हन्यतामेष पापः प्रकृतिदारुणः।\nजीवन् जगदसावाशु कुरुते भस्मसाद् ध्रुवम्॥ ४/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.035.m4a", "display_order": 36}, {"id": 6000078036, "chapter_id": 10078, "verse_number": "४-१४-३३", "content_sanskrit": "नायमर्हत्यसद्वृत्तो नरदेववरासनम्।\nयो वै यज्ञपतिं विष्णुं विनिन्दत्यनपत्रपः॥ ४/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.036.m4a", "display_order": 37}, {"id": 6000078037, "chapter_id": 10078, "verse_number": "४-१४-३४", "content_sanskrit": "को वैनं परिचक्षीत वेनमेकमृतेऽशुभम्।\nप्राप्त ईदृशमैश्वर्यं यदनुग्रहभाजनम्॥ ४/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.037.m4a", "display_order": 38}, {"id": 6000078038, "chapter_id": 10078, "verse_number": "४-१४-३५", "content_sanskrit": "इत्थं व्यवसिता हन्तुमृषयो रूढमन्यवः।\nनिजघ्नुर्हुङ्कृतैर्वेनं हतमच्युतनिन्दया॥ ४/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.038.m4a", "display_order": 39}, {"id": 6000078039, "chapter_id": 10078, "verse_number": "४-१४-३६", "content_sanskrit": "ऋषिभिः स्वाश्रमपदं गते पुत्रकलेवरम्।\nसुनीथा पालयामास विद्यायोगेन शोचती॥ ४/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.039.m4a", "display_order": 40}, {"id": 6000078040, "chapter_id": 10078, "verse_number": "४-१४-३७", "content_sanskrit": "एकदा मुनयस्ते तु सरयूसलिलाप्लुताः।\nहुत्वाऽग्निं सत्कथाश्चक्रुरुपविष्टाः सरित्तटे॥ ४/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.040.m4a", "display_order": 41, "topics": [{"text": "पुना राज्यस्याराजकत्वात् चोरेभ्यो लोकस्य भयोत्पत्तिः", "range": "३७–४३"}]}, {"id": 6000078041, "chapter_id": 10078, "verse_number": "४-१४-३८", "content_sanskrit": "वीक्ष्योत्थितान् महोत्पातानाहुर्लोकभयंकरान्।\nअप्यभद्रमनाथाया दस्युभ्यो न भवेद् भुवः॥ ४/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.041.m4a", "display_order": 42}, {"id": 6000078042, "chapter_id": 10078, "verse_number": "४-१४-३९", "content_sanskrit": "एवं ब्रुवत्सु ऋषिषु धावतां सर्वतो दिशम्।\nपांसुः समुत्थितो भूमेश्चोराणां वसु लुम्पताम्॥ ४/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.042.m4a", "display_order": 43}, {"id": 6000078043, "chapter_id": 10078, "verse_number": "४-१४-४०", "content_sanskrit": "तदुपद्रवमाज्ञाय लोकस्य वसु लुम्पताम्।\nभर्तर्युपरते तस्मिन्नन्योन्यं च जिघांसताम्॥ ४/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.043.m4a", "display_order": 44}, {"id": 6000078044, "chapter_id": 10078, "verse_number": "४-१४-४१", "content_sanskrit": "चोरप्रायं जनपदं हीनसत्त्वमराजकम्।\nलोका नावारयञ्छक्ता अपि तद्दोषदर्शिनः॥ ४/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.044.m4a", "display_order": 45}, {"id": 6000078045, "chapter_id": 10078, "verse_number": "४-१४-४२", "content_sanskrit": "ब्राह्मणः समदृक् शान्तो दीनानां समुपेक्षकः।\nस्रवते ब्रह्म तस्यापि भिन्नभाण्डात् पयो यथा॥ ४/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.045.m4a", "display_order": 46}, {"id": 6000078046, "chapter_id": 10078, "verse_number": "४-१४-४३", "content_sanskrit": "नाङ्गस्य वंशो राजर्षेरेष संस्थातुमर्हति।\nअमोघवीर्या हि नृपा वंशेऽस्मिन् केशवाश्रयाः॥ ४/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.046.m4a", "display_order": 47}, {"id": 6000078047, "chapter_id": 10078, "verse_number": "४-१४-४४", "content_sanskrit": "विनिश्चित्यैवमृषयो विपन्नस्य महीपतेः।\nममन्थुरूरुं तरसा तत्रासीद् बाहुको नरः॥ ४/१४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.047.m4a", "display_order": 48, "topics": [{"text": "मृतस्य वेनस्य ऊरुमथनान्निषादोत्पत्तिः, विप्रैः पुनः पुत्रोत्पत्यर्थं वेनबाहोर्मथनेन पृथुनामकस्य भगवदंशस्य पुत्रस्य अर्चिर्नाम्न्या महालक्ष्म्यंशभूतायाः पुत्र्याश्चोत्पत्तिः", "range": "४४–५०"}]}, {"id": 6000078048, "chapter_id": 10078, "verse_number": "४-१४-४५", "content_sanskrit": "काककृष्णोऽतिह्रस्वाङ्गो ह्रस्वबाहुर्महाहनुः।\nह्रस्वपान्निम्ननासाग्रो रक्ताक्षस्ताम्रमूर्धजः॥ ४/१४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.048.m4a", "display_order": 49}, {"id": 6000078049, "chapter_id": 10078, "verse_number": "४-१४-४६", "content_sanskrit": "तं तु तेऽवनतं दृष्ट्वा किं करोमीति वादिनम्।\nनिषीदेत्यब्रुवंस्तात स निषादस्ततोऽभवत्॥ ४/१४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.049.m4a", "display_order": 50}, {"id": 6000078050, "chapter_id": 10078, "verse_number": "४-१४-४७", "content_sanskrit": "तस्य वंश्यास्तु नैषादा गिरिकाननगोचराः।\nयोऽपाहरज्जायमानो वेनकल्मषमुल्बणम्॥ ४/१४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.050.m4a", "display_order": 51}, {"id": 6000078051, "chapter_id": 10078, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.051.m4a", "display_order": 52}, {"id": 6000078052, "chapter_id": 10078, "verse_number": "४-१४-४८", "content_sanskrit": "अथ तस्य पुनर्विप्रैर्विपन्नस्य महीपतेः।\nबाहुभ्यां मथ्यमानाभ्यां मिथुनं समपद्यत॥ ४/१४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.052.m4a", "display_order": 53}, {"id": 6000078053, "chapter_id": 10078, "verse_number": "४-१४-४९", "content_sanskrit": "तद् दृष्ट्वा मिथुनं जातमृषयो ब्रह्मवादिनः।\nऊचुः परमसन्तुष्टा विदित्वा भगवत्कलाम्॥ ४/१४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.053.m4a", "display_order": 54}, {"id": 6000078054, "chapter_id": 10078, "verse_number": null, "content_sanskrit": "ऋषय ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.054.m4a", "display_order": 55}, {"id": 6000078055, "chapter_id": 10078, "verse_number": "४-१४-५०", "content_sanskrit": "एष विष्णोर्भगवतः कला भुवनपावनी।\nइयं च लक्ष्मीः सम्भूतिः पुरुषस्यानपायिनी॥ ४/१४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_014/BhP_04.014.055.m4a", "display_order": 56}, {"id": 6000078056, "chapter_id": 10078, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे चतुर्दशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]