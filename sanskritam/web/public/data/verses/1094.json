[{"id": 2004725, "chapter_id": 1094, "verse_number": "१-९५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004726, "chapter_id": 1094, "verse_number": "१-९५-१", "content_sanskrit": "प्रतिज्ञाय च दुष्यन्ते प्रतियाते दिने दिने।\nगर्भश्च ववृधे तस्यां राजपुत्र्यां महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004727, "chapter_id": 1094, "verse_number": "१-९५-२", "content_sanskrit": "शकुन्तला चिन्तयन्ती राजानं कार्यगौरवात्।\nदिवारात्रमनिद्रैव स्नानभोजनवर्जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004728, "chapter_id": 1094, "verse_number": "१-९५-३", "content_sanskrit": "राजप्रेषणिका विप्राश्चतुरङ्गबलान्विताः।\nअद्य श्वो वा परश्वो वा समायान्तीति निस्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004729, "chapter_id": 1094, "verse_number": "१-९५-४", "content_sanskrit": "दिनान्पक्षानृतून्मासानयनानि च सर्वशः।\nगण्यमानानि वर्षाणि व्यतीयुस्त्रीणि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004730, "chapter_id": 1094, "verse_number": "१-९५-५", "content_sanskrit": "त्रिषु वर्षेषु पूर्णेषु ऋषेर्वचनगौरवात्।\nऋषिपत्न्यः सुबहुशो हेतुमद्वाक्यमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004731, "chapter_id": 1094, "verse_number": "१-९५-६x", "content_sanskrit": "ऋषिपत्न्य ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004732, "chapter_id": 1094, "verse_number": "१-९५-६", "content_sanskrit": "शृणु भद्रे लोकवृत्तं श्रुत्वा यद्रोचते तव।\nतत्कुरुष्व हितं देवि नावमान्यं गुरोर्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004733, "chapter_id": 1094, "verse_number": "१-९५-७", "content_sanskrit": "देवानां दैवतं विष्णुर्विप्राणामग्निर्ब्रह्म च।\nनारीणां दैवतं भर्ता लोकानां ब्राह्मणो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004734, "chapter_id": 1094, "verse_number": "१-९५-८", "content_sanskrit": "सूतिकाले प्रसूष्वेति भगवांस्ते पिताऽब्रवीत्।\nकरिष्यामीति कर्तव्यं तदा ते सुकृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004735, "chapter_id": 1094, "verse_number": "१-९५-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004736, "chapter_id": 1094, "verse_number": "१-९५-९", "content_sanskrit": "पत्नीनां वचनं श्रुत्वा साधु साध्वित्यचिन्तयत्।\nगर्भं सुषाव वामोरूः कुमारममितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004737, "chapter_id": 1094, "verse_number": "१-९५-१०", "content_sanskrit": "त्रिषु वर्षेषु पूर्णेषु प्राजायत शकुन्तला।\nरूपौदार्यगुणोपेतं दौष्यन्तिं जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004738, "chapter_id": 1094, "verse_number": "१-९५-११", "content_sanskrit": "जाते तस्मिन्नन्तरिक्षात्पुष्पवृष्टिः पपात ह।\nदेवदुन्दुभयो नेदुर्ननृतुश्चाप्सरोगणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004739, "chapter_id": 1094, "verse_number": "१-९५-१२", "content_sanskrit": "गायद्भिर्मधुरं तत्र देवैः शक्रोऽभ्युवाच ह।\nशकुन्तले तव सुतश्चक्रवर्ती भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004740, "chapter_id": 1094, "verse_number": "१-९५-१३", "content_sanskrit": "बलं तेजश्च रूपं च न समं भुवि केनचित्।\nआहर्ता वाजिमेधस्य शतसङ्ख्यस्य पौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004741, "chapter_id": 1094, "verse_number": "१-९५-१४", "content_sanskrit": "अनेकारपि साहस्रै राजसूयादिभिर्मखैः।\nस्वार्थं ब्राह्मणसात्कृत्वा दक्षिणाममितां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004742, "chapter_id": 1094, "verse_number": "१-९५-१५", "content_sanskrit": "देवतानां वचः श्रुत्वा कण्वाश्रमनिवासिनः।\nसभाजयन्तः कण्वस्य सुतां सर्वे महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004743, "chapter_id": 1094, "verse_number": "१-९५-१६", "content_sanskrit": "शकुन्तला च तच्छ्रुत्वा परं हर्षमवाप सा।\nद्विजानाहूय मुनिभिः सत्कृत्य च महायशाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004744, "chapter_id": 1094, "verse_number": "१-९५-१७", "content_sanskrit": "जातकर्मादिसंस्कारं कण्वः पुण्यवतां वरः।\nतस्याथ कारयामास वर्धमानस्य चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004745, "chapter_id": 1094, "verse_number": "१-९५-१८", "content_sanskrit": "यथाविधि यथान्यायं क्रियाः सर्वास्त्वकारयत्।\nदन्तैः शुक्लैः शिखरिभिःसिंहसंहननोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004746, "chapter_id": 1094, "verse_number": "१-९५-१९", "content_sanskrit": "चक्राङ्कितकरः श्रीमान्स्वयं विष्णुरिवापरः।\nचतुष्किष्कुर्महातेजा महामूर्धा महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004747, "chapter_id": 1094, "verse_number": "१-९५-२०", "content_sanskrit": "कुमारो देवगर्भाभः स तत्राशु व्यवर्धत।\nऋषेर्भयात्तु दुष्यन्तः स्मरन्नैवाह्वयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004748, "chapter_id": 1094, "verse_number": "१-९५-२१", "content_sanskrit": "गते काले तु महति न सस्मार तपोधनाम्।\nषड्वर्षेषु ततो बालः कण्वाश्रमपदं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004749, "chapter_id": 1094, "verse_number": "१-९५-२२", "content_sanskrit": "व्याघ्रान्सिंहान्वराहांश्च वृकांश्च महिषांस्तथा।\nऋक्षांश्चाभ्यहनद्व्यालान्पद्भ्यामाश्रमपीडकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004750, "chapter_id": 1094, "verse_number": "१-९५-२३", "content_sanskrit": "बलाद्भुजाभ्यां संगृह्य बलवान्संनियम्य च।\nबद्ध्वा वृक्षेषु दौष्यन्तिराश्रमस्य समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004751, "chapter_id": 1094, "verse_number": "१-९५-२४", "content_sanskrit": "आरुरोह द्रुमांश्चैव क्रीडन्स्म परिधावति।\nवनं च लोडयामास सिंहव्याघ्रगणैर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004752, "chapter_id": 1094, "verse_number": "१-९५-२५", "content_sanskrit": "ततश्च राक्षसान्सर्वान्पिशाचांश्च रिपून्रणे।\nमुष्टियुद्धेन तान्हत्वा ऋषीनाराधयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004753, "chapter_id": 1094, "verse_number": "१-९५-२६", "content_sanskrit": "कश्चिद्दितिसुतस्तं तु हन्तुकामो महाबलः।\nवध्यमानांस्तु दैतेयानमर्षी तं समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004754, "chapter_id": 1094, "verse_number": "१-९५-२७", "content_sanskrit": "तमागतं प्रहस्यैव बाहुभ्यां परिगृह्य च।\nदृढं चाबध्य बाहुभ्यां पीडयामास तं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004755, "chapter_id": 1094, "verse_number": "१-९५-२८", "content_sanskrit": "मर्दितो न शशाकास्मान्मोचितुं बलवत्तया।\nप्राक्रोशद्भैरवं तत्र द्वारेभ्यो निःसृतं त्वसृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004756, "chapter_id": 1094, "verse_number": "१-९५-२९", "content_sanskrit": "तेन शब्देन वित्रस्ता मृगाः सिंहादयो गणाः।\nसुस्रुवुश्च शकृन्मूत्रमाश्रमस्थाश्च सुस्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004757, "chapter_id": 1094, "verse_number": "१-९५-३०", "content_sanskrit": "निरसुं जानुभिः कृत्वा विससर्ज च सोऽपतत्।\nतद्दृष्ट्वा विस्मयं जग्मुः कुमारस्य विचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004758, "chapter_id": 1094, "verse_number": "१-९५-३१", "content_sanskrit": "नित्यकालं वध्यमाना दैतेया राक्षसैः सह।\nकुमारस्य भयादेव नैव जग्मुस्तदाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004759, "chapter_id": 1094, "verse_number": "१-९५-३२", "content_sanskrit": "ततोऽस्य नाम चक्रुस्ते कण्वाश्रमनिवासिनः।\nकण्वेन सहिताः सर्वे दृष्ट्वा कर्मातिमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004760, "chapter_id": 1094, "verse_number": "१-९५-३३", "content_sanskrit": "अस्त्वयं सर्वदमनः सर्वं हि दमयत्यसौ।\nस सर्वदमनो नाम कुमारः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004761, "chapter_id": 1094, "verse_number": "१-९५-३४", "content_sanskrit": "विक्रमेणौजसा चैव बलेन च समन्वितः।\nअप्रेषयति दुष्यन्ते महिष्यास्तनयस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004762, "chapter_id": 1094, "verse_number": "१-९५-३५", "content_sanskrit": "पाण्डुभावपरीताङ्गीं चिन्तया समभिप्लुताम्।\nलम्बालकां कृशां दीनां तथा मलिनवाससम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004763, "chapter_id": 1094, "verse_number": "१-९५-३६", "content_sanskrit": "शकुन्तलां च संप्रेक्ष्य प्रदध्यौ स मुनिस्तदा।\nशास्त्राणि सर्ववेदाश्च द्वादशाब्दस्य चाभवन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004764, "chapter_id": 1094, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चनवतितमोऽध्यायः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]