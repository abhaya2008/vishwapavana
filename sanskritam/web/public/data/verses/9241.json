[{"id": 5000241000, "chapter_id": 9241, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000241001, "chapter_id": 9241, "verse_number": "३-४५-१", "content_sanskrit": "आर्तस्वरं तु तं भर्तुर्विज्ञाय सदृशं वने।\nउवाच लक्ष्मणं सीता गच्छ जानीहि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000241002, "chapter_id": 9241, "verse_number": "३-४५-२", "content_sanskrit": "नहि मे जीवितं स्थाने हृदयं वावतिष्ठते।\nक्रोशतः परमार्तस्य श्रुतः शब्दो मया भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000241003, "chapter_id": 9241, "verse_number": "३-४५-३", "content_sanskrit": "आक्रन्दमानं तु वने भ्रातरं त्रातुमर्हसि।\nतं क्षिप्रमभिधाव त्वं भ्रातरं शरणैषिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000241004, "chapter_id": 9241, "verse_number": "३-४५-४", "content_sanskrit": "रक्षसां वशमापन्नं सिंहानामिव गोवृषम्।\nन जगाम तथोक्तस्तु भ्रातुराज्ञाय शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000241005, "chapter_id": 9241, "verse_number": "३-४५-५", "content_sanskrit": "तमुवाच ततस्तत्र क्षुभिता जनकात्मजा।\nसौमित्रे मित्ररूपेण भ्रातुस्त्वमसि शत्रुवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000241006, "chapter_id": 9241, "verse_number": "३-४५-६", "content_sanskrit": "यस्त्वमस्यामवस्थायां भ्रातरं नाभिपद्यसे।\nइच्छसि त्वं विनश्यन्तं रामं लक्ष्मण मत्कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000241007, "chapter_id": 9241, "verse_number": "३-४५-७", "content_sanskrit": "लोभात्तु मत्कृते नूनं नानुगच्छसि राघवम्।\nव्यसनं ते प्रियं मन्ये स्नेहो भ्रातरि नास्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000241008, "chapter_id": 9241, "verse_number": "३-४५-८", "content_sanskrit": "तेन तिष्ठसि विस्रब्धं तमपश्यन् महाद्युतिम्।\nकिं हि संशयमापन्ने तस्मिन्निह मया भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000241009, "chapter_id": 9241, "verse_number": "३-४५-९", "content_sanskrit": "कर्तव्यमिह तिष्ठन्त्या यत्प्रधानस्त्वमागतः।\nएवं ब्रुवाणां वैदेहीं बाष्पशोकसमन्विताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000241010, "chapter_id": 9241, "verse_number": "३-४५-१०", "content_sanskrit": "अब्रवील्लक्ष्मणस्त्रस्तां सीतां मृगवधूमिव।\nपन्नगासुरगन्धर्वदेवदानवराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000241011, "chapter_id": 9241, "verse_number": "३-४५-११", "content_sanskrit": "अशक्यस्तव वैदेहि भर्ता जेतुं न संशयः।\nदेवि देवमनुष्येषु गन्धर्वेषु पतत्रिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000241012, "chapter_id": 9241, "verse_number": "३-४५-१२", "content_sanskrit": "राक्षसेषु पिशाचेषु किन्नरेषु मृगेषु च।\nदानवेषु च घोरेषु न स विद्येत शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000241013, "chapter_id": 9241, "verse_number": "३-४५-१३", "content_sanskrit": "यो रामं प्रतियुध्येत समरे वासवोपमम्।\nअवध्यः समरे रामो नैवं त्वं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000241014, "chapter_id": 9241, "verse_number": "३-४५-१४", "content_sanskrit": "न त्वामस्मिन् वने हातुमुत्सहे राघवं विना।\nअनिवार्यं बलं तस्य बलैर्बलवतामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000241015, "chapter_id": 9241, "verse_number": "३-४५-१५", "content_sanskrit": "त्रिभिर्लोकैः समुदितैः सेश्वरैः सामरैरपि।\nहृदयं निर्वृतं तेऽस्तु संतापस्त्यज्यतां तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000241016, "chapter_id": 9241, "verse_number": "३-४५-१६", "content_sanskrit": "आगमिष्यति ते भर्ता शीघ्रं हत्वा मृगोत्तमम्।\nन स तस्य स्वरो व्यक्तं न कश्चिदपि दैवतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000241017, "chapter_id": 9241, "verse_number": "३-४५-१७", "content_sanskrit": "गन्धर्वनगरप्रख्या माया तस्य च रक्षसः।\nन्यासभूतासि वैदेहि न्यस्ता मयि महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000241018, "chapter_id": 9241, "verse_number": "३-४५-१८", "content_sanskrit": "रामेण त्वं वरारोहे न त्वां त्यक्तुमिहोत्सहे।\nकृतवैराश्च कल्याणि वयमेतैर्निशाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000241019, "chapter_id": 9241, "verse_number": "३-४५-१९", "content_sanskrit": "खरस्य निधने देवि जनस्थानवधं प्रति।\nराक्षसा विविधा वाचो व्याहरन्ति महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000241020, "chapter_id": 9241, "verse_number": "३-४५-२०", "content_sanskrit": "हिंसाविहारा वैदेहि न चिन्तयितुमर्हसि।\nलक्ष्मणेनैवमुक्ता तु क्रुद्धा संरक्तलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000241021, "chapter_id": 9241, "verse_number": "३-४५-२१", "content_sanskrit": "अब्रवीत् परुषं वाक्यं लक्ष्मणं सत्यवादिनम्।\nअनार्याकरुणारम्भ नृशंस कुलपांसन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000241022, "chapter_id": 9241, "verse_number": "३-४५-२२", "content_sanskrit": "अहं तव प्रियं मन्ये रामस्य व्यसनं महत्।\nरामस्य व्यसनं दृष्ट्वा तेनैतानि प्रभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000241023, "chapter_id": 9241, "verse_number": "३-४५-२३", "content_sanskrit": "नैव चित्रं सपत्नेषु पापं लक्ष्मण यद् भवेत्।\nत्वद्विधेषु नृशंसेषु नित्यं प्रच्छन्नचारिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000241024, "chapter_id": 9241, "verse_number": "३-४५-२४", "content_sanskrit": "सुदुष्टस्त्वं वने राममेकमेकोऽनुगच्छसि।\nमम हेतोः प्रतिच्छन्नः प्रयुक्तो भरतेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000241025, "chapter_id": 9241, "verse_number": "३-४५-२५", "content_sanskrit": "तन्न सिध्यति सौमित्रे तवापि भरतस्य वा।\nकथमिन्दीवरश्यामं रामं पद्मनिभेक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000241026, "chapter_id": 9241, "verse_number": "३-४५-२६", "content_sanskrit": "उपसंश्रित्य भर्तारं कामयेयं पृथग्जनम्।\nसमक्षं तव सौमित्रे प्राणांस्त्यक्ष्याम्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000241027, "chapter_id": 9241, "verse_number": "३-४५-२७", "content_sanskrit": "रामं विना क्षणमपि नैव जीवामि भूतले।\nइत्युक्तः परुषं वाक्यं सीतया रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000241028, "chapter_id": 9241, "verse_number": "३-४५-२८", "content_sanskrit": "अब्रवील्लक्ष्मणः सीतां प्राञ्जलिः स जितेन्द्रियः।\nउत्तरं नोत्सहे वक्तुं दैवतं भवती मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000241029, "chapter_id": 9241, "verse_number": "३-४५-२९", "content_sanskrit": "वाक्यमप्रतिरूपं तु न चित्रं स्त्रीषु मैथिलि।\nस्वभावस्त्वेष नारीणामेषु लोकेषु दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000241030, "chapter_id": 9241, "verse_number": "३-४५-३०", "content_sanskrit": "विमुक्तधर्माश्चपलास्तीक्ष्णा भेदकराः स्त्रियः।\nन सहे हीदृशं वाक्यं वैदेहि जनकात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000241031, "chapter_id": 9241, "verse_number": "३-४५-३१", "content_sanskrit": "श्रोत्रयोरुभयोर्मध्ये तप्तनाराचसंनिभम्।\nउपशृण्वन्तु मे सर्वे साक्षिणो हि वनेचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000241032, "chapter_id": 9241, "verse_number": "३-४५-३२", "content_sanskrit": "न्यायवादी यथा वाक्यमुक्तोऽहं परुषं त्वया।\nधिक् त्वामद्य विनश्यन्तीं यन्मामेवं विशङ्कसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000241033, "chapter_id": 9241, "verse_number": "३-४५-३३", "content_sanskrit": "स्त्रीत्वाद् दुष्टस्वभावेन गुरुवाक्ये व्यवस्थितम्।\nगच्छामि यत्र काकुत्स्थः स्वस्ति तेऽस्तु वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000241034, "chapter_id": 9241, "verse_number": "३-४५-३४", "content_sanskrit": "रक्षन्तु त्वां विशालाक्षि समग्रा वनदेवताः।\nनिमित्तानि हि घोराणि यानि प्रादुर्भवन्ति मे।\nअपि त्वां सह रामेण पश्येयं पुनरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000241035, "chapter_id": 9241, "verse_number": "३-४५-३५", "content_sanskrit": "लक्ष्मणेनैवमुक्ता तु रुदती जनकात्मजा।\nप्रत्युवाच ततो वाक्यं तीव्रबाष्पपरिप्लुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000241036, "chapter_id": 9241, "verse_number": "३-४५-३६", "content_sanskrit": "गोदावरीं प्रवेक्ष्यामि हीना रामेण लक्ष्मण।\nआबन्धिष्येऽथवा त्यक्ष्ये विषमे देहमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000241037, "chapter_id": 9241, "verse_number": "३-४५-३७", "content_sanskrit": "पिबामि वा विषं तीक्ष्णं प्रवेक्ष्यामि हुताशनम्।\nन त्वहं राघवादन्यं कदापि पुरुषं स्पृशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000241038, "chapter_id": 9241, "verse_number": "३-४५-३८", "content_sanskrit": "इति लक्ष्मणमाश्रुत्य सीता शोकसमन्विता।\nपाणिभ्यां रुदती दुःखादुदरं प्रजघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000241039, "chapter_id": 9241, "verse_number": "३-४५-३९", "content_sanskrit": "तामार्तरूपां विमना रुदन्तीं\nसौमित्रिरालोक्य विशालनेत्राम्।\nआश्वासयामास न चैव भर्तु-\nस्तं भ्रातरं किंचिदुवाच सीता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000241040, "chapter_id": 9241, "verse_number": "३-४५-४०", "content_sanskrit": "ततस्तु सीतामभिवाद्य लक्ष्मणः\nकृताञ्जलिः किंचिदभिप्रणम्य।\nअवेक्षमाणो बहुशः स मैथिलीं\nजगाम रामस्य समीपमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000241041, "chapter_id": 9241, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]