[{"id": 6000015000, "chapter_id": 10015, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000015001, "chapter_id": 10015, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.001.m4a", "display_order": 2}, {"id": 6000015002, "chapter_id": 10015, "verse_number": "१-१५-१", "content_sanskrit": "वासुदेवाङ्घ्र्यभिध्यानपरिबृंहितरंहसा।\nभक्‍त्या निर्मथिताशेषकषायधिषणोऽर्जुनः॥ १/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.002.m4a", "display_order": 3}, {"id": 6000015003, "chapter_id": 10015, "verse_number": "१-१५-२", "content_sanskrit": "गीतं भगवता ज्ञानं यत्तत्संग्राममूर्धनि।\nकालकर्मतमोरुद्धं पुनरध्यगमद्विभुः॥ १/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.003.m4a", "display_order": 4}, {"id": 6000015004, "chapter_id": 10015, "verse_number": "१-१५-३", "content_sanskrit": "विशोको ब्रह्मसम्पत्त्या सञ्च्छिन्नद्वैतसंशयः।\nलीनप्रकृतिनैर्गुण्यादलिङ्गत्वादसम्भवः॥ १/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.004.m4a", "display_order": 5}, {"id": 6000015005, "chapter_id": 10015, "verse_number": "१-१५-४", "content_sanskrit": "निशम्य भगवन्मार्गं संस्थां यदुकुलस्य च।\nस्वःपथाय मतिं चक्रे निवृत्तात्मा युधिष्‍ठिरः॥ १/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.005.m4a", "display_order": 6}, {"id": 6000015006, "chapter_id": 10015, "verse_number": "१-१५-५", "content_sanskrit": "यदा मुकुन्दो भगवानिमां महीं जहौ स्वतन्वा श्रवणीयसत्कथः।\nतदा हरावप्रतिबुद्धचेतसामभद्रहेतुः कलिरन्ववर्तत॥ १/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.006.m4a", "display_order": 7}, {"id": 6000015007, "chapter_id": 10015, "verse_number": "१-१५-६", "content_sanskrit": "युधिष्‍ठिरस्तत्परिसर्पणं बुधः पुरे च राष्‍ट्रे च गृहे तथाऽऽत्मनि।\nविभाव्य लोभानृतजिह्महिंसनाद्यधर्मचक्रं गमनाय पर्यधात्॥ १/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.007.m4a", "display_order": 8}, {"id": 6000015008, "chapter_id": 10015, "verse_number": "१-१५-७", "content_sanskrit": "स्वराट् पौत्रं विनीतं तमात्मनोऽनवमं गुणैः।\nतोयनीव्याः पतिं भूमेरभ्यषिञ्चद्गजाह्वये॥ १/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.008.m4a", "display_order": 9}, {"id": 6000015009, "chapter_id": 10015, "verse_number": "१-१५-८", "content_sanskrit": "मधुरायां ततो वज्रं शूरसेनपतिं ततः।\nप्राजापत्यां निरूप्येष्‍टिमग्नीनपिबदीश्‍वरः॥ १/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.009.m4a", "display_order": 10}, {"id": 6000015010, "chapter_id": 10015, "verse_number": "१-१५-९", "content_sanskrit": "विसृज्य तत्र तत्सर्वं दुकूलवलयादिकम्।\nनिर्ममो निरहङ्कारः सञ्च्छिन्नाशेषबन्धनः॥ १/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.010.m4a", "display_order": 11, "topics": [{"text": "जातनिर्वेदेन युधिष्‍ठिरेण वज्रपरीक्षितोर्मधुरायां स्वपुर्यां चाभिषेचन ॥-१-८॥ युधिष्ठिरेण द्रौपद्या भ्रातृभिश्‍च सह स्वर्गारोहणम्, श्रवणफलम्", "range": "९–१९"}]}, {"id": 6000015011, "chapter_id": 10015, "verse_number": "१-१५-१०", "content_sanskrit": "वाचं जुहाव मनसि तत्प्राण इतरे परम्।\nधृत्या ह्यपानं सोत्सर्गं तत्परत्वे ह्यजोहवीत्॥ १/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.011.m4a", "display_order": 12}, {"id": 6000015012, "chapter_id": 10015, "verse_number": "१-१५-११", "content_sanskrit": "त्रित्वे हुत्वाऽथ पञ्चत्वं तच्चैकत्वेऽजुहोन्मुनिः।\nसर्वमात्मन्यजुहवीद्ब्रह्मण्यात्मानमव्यये॥ १/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.012.m4a", "display_order": 13}, {"id": 6000015013, "chapter_id": 10015, "verse_number": "१-१५-१२", "content_sanskrit": "चीरवासा निराहारो बद्धवाङ्मुक्‍तमूर्धजः। दर्शयन्नात्मनो रूपं जडोन्मत्तपिशाचवत्।\nअनपेक्षमाणो निरगाद् अशृण्वन् बधिरो यथा॥ १/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.013.m4a", "display_order": 14}, {"id": 6000015014, "chapter_id": 10015, "verse_number": "१-१५-१३", "content_sanskrit": "उदीचीं प्रविवेशाशां गतपूर्वां महात्मभिः।\nहृदि ब्रह्म परं ध्यायन्नावर्तेत गतो यतः॥ १/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.014.m4a", "display_order": 15}, {"id": 6000015015, "chapter_id": 10015, "verse_number": "१-१५-१४", "content_sanskrit": "सर्वे तमनु निर्जग्मुर्भ्रातरः कृतनिश्‍चयाः।\nकलिनाऽधर्ममिश्रेण दृष्‍ट्वा स्पृष्‍टाः प्रजा भुवि॥ १/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.015.m4a", "display_order": 16}, {"id": 6000015016, "chapter_id": 10015, "verse_number": "१-१५-१५", "content_sanskrit": "ते साधुकृतसर्वार्था ज्ञात्वाऽऽत्यन्तिकमात्मनः।\nमनसा धारयामासुर्वैकुण्ठचरणाम्बुजम्॥ १/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.016.m4a", "display_order": 17}, {"id": 6000015017, "chapter_id": 10015, "verse_number": "१-१५-१६", "content_sanskrit": "तद्ध्यानोद्रिक्‍तया भक्‍त्या विशुद्धधिषणाः परे।\nतस्मिन्नारायणपद एकान्तमतयोऽपतन्॥ १/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.017.m4a", "display_order": 18}, {"id": 6000015018, "chapter_id": 10015, "verse_number": "१-१५-१७", "content_sanskrit": "अवापुर्दुरवापं त असद्भिर्विषयात्मभिः।\nविधूतकल्मषस्थानं विरजेनात्मनैव हि॥ १/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.018.m4a", "display_order": 19}, {"id": 6000015019, "chapter_id": 10015, "verse_number": "१-१५-१८", "content_sanskrit": "द्रौपदी च तदाज्ञाय पतीनामनपेक्षताम्।\nवासुदेवे भगवति एकान्तमतिरापतत्॥ १/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.019.m4a", "display_order": 20}, {"id": 6000015020, "chapter_id": 10015, "verse_number": "१-१५-१९", "content_sanskrit": "यः श्रद्धयैतद्भगवत्प्रयाणं पाण्डोः सुतानामपि संप्रयाणम्।\nशृणोत्यलं स्वस्त्ययनं पवित्रं लब्ध्वा हरौ भक्‍तिमुपैति शान्तिम्॥ १/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_015/BhP_01.015.020.m4a", "display_order": 21}, {"id": 6000015021, "chapter_id": 10015, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे पञ्चदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]