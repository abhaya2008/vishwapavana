[{"id": 5000460000, "chapter_id": 9460, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000460001, "chapter_id": 9460, "verse_number": "६-५३-१", "content_sanskrit": "धूम्राक्षं निहतं श्रुत्वा रावणो राक्षसेश्वरः।\nक्रोधेन महताऽऽविष्टो निःश्वसन्नुरगो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000460002, "chapter_id": 9460, "verse_number": "६-५३-२", "content_sanskrit": "दीर्घमुष्णं विनिःश्वस्य क्रोधेन कलुषीकृतः।\nअब्रवीद् राक्षसं क्रूरं वज्रदंष्ट्रं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000460003, "chapter_id": 9460, "verse_number": "६-५३-३", "content_sanskrit": "गच्छ त्वं वीर निर्याहि राक्षसैः परिवारितः।\nजहि दाशरथिं रामं सुग्रीवं वानरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000460004, "chapter_id": 9460, "verse_number": "६-५३-४", "content_sanskrit": "तथेत्युक्त्वा द्रुततरं मायावी राक्षसेश्वरः।\nनिर्जगाम बलैः सार्धं बहुभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000460005, "chapter_id": 9460, "verse_number": "६-५३-५", "content_sanskrit": "नागैरश्वैः खरैरुष्ट्रैः संयुक्तः सुसमाहितः।\nपताकाध्वजचित्रैश्च बहुभिः समलंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000460006, "chapter_id": 9460, "verse_number": "६-५३-६", "content_sanskrit": "ततो विचित्रकेयूरमुकुटेन विभूषितः।\nतनुत्रं स समावृत्य सधनुर्निर्ययौ द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000460007, "chapter_id": 9460, "verse_number": "६-५३-७", "content_sanskrit": "पताकालंकृतं दीप्तं तप्तकाञ्चनभूषितम्।\nरथं प्रदक्षिणं कृत्वा समारोहच्चमूपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000460008, "chapter_id": 9460, "verse_number": "६-५३-८", "content_sanskrit": "ऋष्टिभिस्तोमरैश्चित्रैः श्लक्ष्णैश्च मुसलैरपि।\nभिन्दिपालैश्च चापैश्च शक्तिभिः पट्टिशैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000460009, "chapter_id": 9460, "verse_number": "६-५३-९", "content_sanskrit": "खड्गैश्चक्रैर्गदाभिश्च निशितैश्च परश्वधैः।\nपदातयश्च निर्यान्ति विविधाः शस्त्रपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000460010, "chapter_id": 9460, "verse_number": "६-५३-१०", "content_sanskrit": "विचित्रवाससः सर्वे दीप्ता राक्षसपुङ्गवाः।\nगजा महोत्कटाः शूराश्चलन्त इव पर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000460011, "chapter_id": 9460, "verse_number": "६-५३-११", "content_sanskrit": "ते युद्धकुशला रूढास्तोमराङ्कुशपाणिभिः।\nअन्ये लक्षणसंयुक्ताः शूरारूढा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000460012, "chapter_id": 9460, "verse_number": "६-५३-१२", "content_sanskrit": "तद् राक्षसबलं सर्वं विप्रस्थितमशोभत।\nप्रावृट्काले यथा मेघा नर्दमानाः सविद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000460013, "chapter_id": 9460, "verse_number": "६-५३-१३", "content_sanskrit": "निःसृता दक्षिणद्वारादङ्गदो यत्र यूथपः।\nतेषां निष्क्रममाणानामशुभं समजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000460014, "chapter_id": 9460, "verse_number": "६-५३-१४", "content_sanskrit": "आकाशाद् विघनात् तीव्रा उल्काश्चाभ्यपतंस्तदा।\nवमन्तः पावकज्वालाः शिवा घोरा ववाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000460015, "chapter_id": 9460, "verse_number": "६-५३-१५", "content_sanskrit": "व्याहरन्त मृगा घोरा रक्षसां निधनं तदा।\nसमापतन्तो योधास्तु प्रास्खलंस्तत्र दारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000460016, "chapter_id": 9460, "verse_number": "६-५३-१६", "content_sanskrit": "एतानौत्पातिकान् दृष्ट्वा वज्रदंष्ट्रो महाबलः।\nधैर्यमालम्ब्य तेजस्वी निर्जगाम रणोत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000460017, "chapter_id": 9460, "verse_number": "६-५३-१७", "content_sanskrit": "तांस्तु विद्रवतो दृष्ट्वा वानरा जितकाशिनः।\nप्रणेदुः सुमहानादान् दिशः शब्देन पूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000460018, "chapter_id": 9460, "verse_number": "६-५३-१८", "content_sanskrit": "ततः प्रवृत्तं तुमुलं हरीणां राक्षसैः सह।\nघोराणां भीमरूपाणामन्योन्यवधकाङ्क्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000460019, "chapter_id": 9460, "verse_number": "६-५३-१९", "content_sanskrit": "निष्पतन्तो महोत्साहा भिन्नदेहशिरोधराः।\nरुधिरोक्षितसर्वाङ्गा न्यपतन् धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000460020, "chapter_id": 9460, "verse_number": "६-५३-२०", "content_sanskrit": "केचिदन्योन्यमासाद्य शूराः परिघबाहवः।\nचिक्षिपुर्विविधान् शस्त्रान् समरेष्वनिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000460021, "chapter_id": 9460, "verse_number": "६-५३-२१", "content_sanskrit": "द्रुमाणां च शिलानां च शस्त्राणां चापि निःस्वनः।\nश्रूयते सुमहांस्तत्र घोरो हृदयभेदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000460022, "chapter_id": 9460, "verse_number": "६-५३-२२", "content_sanskrit": "रथनेमिस्वनस्तत्र धनुषश्चापि घोरवत्।\nशङ्खभेरीमृदङ्गानां बभूव तुमुलः स्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000460023, "chapter_id": 9460, "verse_number": "६-५३-२३", "content_sanskrit": "केचिदस्त्राणि संत्यज्य बाहुयुद्धमकुर्वत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000460024, "chapter_id": 9460, "verse_number": "६-५३-२४", "content_sanskrit": "तलैश्च चरणैश्चापि मुष्टिभिश्च द्रुमैरपि।\nजानुभिश्च हताः केचिद् भग्नदेहाश्च राक्षसाः।\nशिलाभिश्चूर्णिताः केचिद् वानरैर्युद्धदुर्मदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000460025, "chapter_id": 9460, "verse_number": "६-५३-२५", "content_sanskrit": "वज्रदंष्ट्रो भृशं बाणै रणे वित्रासयन् हरीन्।\nचचार लोकसंहारे पाशहस्त इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000460026, "chapter_id": 9460, "verse_number": "६-५३-२६", "content_sanskrit": "बलवन्तोऽस्त्रविदुषो नानाप्रहरणा रणे।\nजघ्नुर्वानरसैन्यानि राक्षसाः क्रोधर्मूच्छिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000460027, "chapter_id": 9460, "verse_number": "६-५३-२७", "content_sanskrit": "जघ्ने तान् राक्षसान् सर्वान् धृष्टो वालिसुतो रणे।\nक्रोधेन द्विगुणाविष्टः संवर्तक इवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000460028, "chapter_id": 9460, "verse_number": "६-५३-२८", "content_sanskrit": "तान् राक्षसगणान् सर्वान् वृक्षमुद्यम्य वीर्यवान्।\nअङ्गदः क्रोधताम्राक्षः सिंहः क्षुद्रमृगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000460029, "chapter_id": 9460, "verse_number": "६-५३-२९", "content_sanskrit": "चकार कदनं घोरं शक्रतुल्यपराक्रमः।\nअङ्गदाभिहतास्तत्र राक्षसा भीमविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000460030, "chapter_id": 9460, "verse_number": "६-५३-३०", "content_sanskrit": "विभिन्नशिरसः पेतुर्निकृत्ता इव पादपाः।\nरथैश्चित्रैर्ध्वजैरश्वैः शरीरैर्हरिरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000460031, "chapter_id": 9460, "verse_number": "६-५३-३१", "content_sanskrit": "रुधिरौघेण संछन्ना भूमिर्भयकरी तदा।\nहारकेयूरवस्त्रैश्च शस्त्रैश्च समलंकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000460032, "chapter_id": 9460, "verse_number": "६-५३-३२", "content_sanskrit": "भूमिर्भाति रणे तत्र शारदीव यथा निशा।\nअङ्गदस्य च वेगेन तद् राक्षसबलं महत्।\nप्राकम्पत तदा तत्र पवनेनाम्बुदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000460033, "chapter_id": 9460, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]