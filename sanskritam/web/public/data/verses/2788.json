[{"id": 2084045, "chapter_id": 2788, "verse_number": "१२-२९३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084046, "chapter_id": 2788, "verse_number": "१२-२९३-१", "content_sanskrit": "अतत्त्वज्ञस्य शास्त्राणां संततं संशयात्मनः।\nअकृतव्यवसायस्य श्रेयो ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084047, "chapter_id": 2788, "verse_number": "१२-२९३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084048, "chapter_id": 2788, "verse_number": "१२-२९३-२", "content_sanskrit": "गुरुपूजा च सततं वृद्धानां पर्युपासनम्।\nश्रवणं चैव विद्यानां कूटस्थं श्रेय उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084049, "chapter_id": 2788, "verse_number": "१२-२९३-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nगालवस्य च संवादं देवर्षेर्नारदस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084050, "chapter_id": 2788, "verse_number": "१२-२९३-४", "content_sanskrit": "वीतमोहक्लमं विप्रं ज्ञानतृप्तं जितेन्द्रियः।\nश्रेयस्कामो यतान्मानं नारदं गालवोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084051, "chapter_id": 2788, "verse_number": "१२-२९३-५", "content_sanskrit": "यैः कैश्चित्संमतो लोके गुणैश्च पुरुषो नृषु।\nभवत्यनपगान्सर्वांस्तान्गुणाँल्लक्षयामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084052, "chapter_id": 2788, "verse_number": "१२-२९३-६", "content_sanskrit": "भवानेवंविधोऽस्माकं संशयं छेत्तुमर्हति।\nअमूढश्चिरमूढानां लोकतत्त्वमजानताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084053, "chapter_id": 2788, "verse_number": "१२-२९३-७", "content_sanskrit": "ज्ञाने ह्येवं प्रवृत्तिः स्यात्कार्याणामविशेषतः।\nयत्कार्यं न व्यवस्यामस्तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084054, "chapter_id": 2788, "verse_number": "१२-२९३-८", "content_sanskrit": "भगवन्नाश्रमाः सर्वे पृथगाचारदर्शिनः।\nइदं श्रेय इदं श्रेय इति सर्वे प्रबोधिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084055, "chapter_id": 2788, "verse_number": "१२-२९३-९", "content_sanskrit": "तांस्तु विप्रस्थितानदृष्ट्वा शास्त्रैः शास्त्राभिनन्दिनः।\nस्वशास्त्रैः पिरतुष्टाश्च श्रेयो नोपलभामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084056, "chapter_id": 2788, "verse_number": "१२-२९३-१०", "content_sanskrit": "शास्त्रं यदि भवेदेकं श्रेयो व्यक्तं भवेत्तदा।\nशास्त्रैश्च बहुभिर्भूयः श्रेयो गुह्यं प्रवेशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084057, "chapter_id": 2788, "verse_number": "१२-२९३-११", "content_sanskrit": "एतस्मात्कारणाच्छ्रेयो गहनं प्रतिभाति मे।\nब्रवीतु भगवांस्तन्मे उपसन्नोस्म्यधीहि भो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084058, "chapter_id": 2788, "verse_number": "१२-२९३-१२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084059, "chapter_id": 2788, "verse_number": "१२-२९३-१२", "content_sanskrit": "आश्रमास्तात चत्वारो यथा संकल्पिताः पृथक्।\nतान्सर्वाननुपश्य त्वं समाश्रित्यैव गालव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084060, "chapter_id": 2788, "verse_number": "१२-२९३-१३", "content_sanskrit": "तेषांतेषां तथाहि त्वमाश्रमाणां ततस्ततः।\nनानारूपं गुणोद्देशं पश्य विप्रस्थितं पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084061, "chapter_id": 2788, "verse_number": "१२-२९३-१४", "content_sanskrit": "न यान्ति चैव ते सम्यगभिप्रेतमसंशयम्।\nअन्येऽपश्यंस्तथा सम्यगाश्रमाणां परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084062, "chapter_id": 2788, "verse_number": "१२-२९३-१५", "content_sanskrit": "यत्तु निःश्रेयसं सम्यक्तच्चैवासंशयात्मकम्।\nअनुग्रहं च मित्राणाममित्राणां च निग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084063, "chapter_id": 2788, "verse_number": "१२-२९३-१६", "content_sanskrit": "संग्रहं च त्रिवर्गस्य श्रेय आहुर्मनीषिणः।\nनिवृत्तिः कर्मणः पापात्सततं पुण्यशीलता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084064, "chapter_id": 2788, "verse_number": "१२-२९३-१७", "content_sanskrit": "सद्भिश्च समुदाचारः श्रेय एतदसंशयम्।\nमार्दवं सर्वभूतेषु व्यवहारेषु चार्जवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084065, "chapter_id": 2788, "verse_number": "१२-२९३-१८", "content_sanskrit": "वाक्चैव मधुरा प्रोक्ता श्रेय एतदसंशयम्।\nदेवताभ्यः पितृभ्यश्च संविभागोऽतिथिष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084066, "chapter_id": 2788, "verse_number": "१२-२९३-१९", "content_sanskrit": "असंत्यागश्च भूत्यानां श्रेय एतदसंशयम्।\nसत्यस्य वचनं श्रेयः सत्यज्ञानं तु दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084067, "chapter_id": 2788, "verse_number": "१२-२९३-२०", "content_sanskrit": "यद्भूतहितमत्यन्तमेतत्सत्यं ब्रवीम्यहम्।\nअहंकारस्य च त्यागः प्रमादस्य च निग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084068, "chapter_id": 2788, "verse_number": "१२-२९३-२१", "content_sanskrit": "संतोषश्चैकचर्या च कूटस्थं श्रेय उच्यते।\nधर्मेण वेदाध्ययनं वेदाङ्गानां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084069, "chapter_id": 2788, "verse_number": "१२-२९३-२२", "content_sanskrit": "ज्ञानार्थानां च जिज्ञासा श्रेय एतदसंशयम्।\nशब्दरूपरसस्पर्शान्सह गन्धेन केवलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084070, "chapter_id": 2788, "verse_number": "१२-२९३-२३", "content_sanskrit": "नात्यर्थमुपसेवेत श्रेयसोर्थी कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084071, "chapter_id": 2788, "verse_number": "१२-२९३-२४", "content_sanskrit": "नक्तंचर्यां दिवास्वप्नमालस्यं पैशुनं मदम्।\nअतियोगमयोगं च श्रेयसोर्थी परित्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084072, "chapter_id": 2788, "verse_number": "१२-२९३-२५", "content_sanskrit": "आत्मोत्कर्षं न मार्गेत परेषां परिनिन्दया।\nस्वगुणैरेव मार्गेति विप्रकर्षं पृथग्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084073, "chapter_id": 2788, "verse_number": "१२-२९३-२६", "content_sanskrit": "निर्गुणास्त्वेव भूयिष्ठमात्मसंभाविता नराः।\nदोषैरन्यान्गुणवतः क्षिपन्त्यात्मगुणक्षयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084074, "chapter_id": 2788, "verse_number": "१२-२९३-२७", "content_sanskrit": "अनूच्यमानास्तु पुनस्ते मन्यन्ते महाजनात्।\nगुणवत्तरमात्मानं स्वेन मानेन दर्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084075, "chapter_id": 2788, "verse_number": "१२-२९३-२८", "content_sanskrit": "अब्रुवन्कस्यचिन्निन्दामात्मपूजामवर्णयन्।\nविपश्चिद्गुणसंपन्नः प्राप्नोत्येव महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084076, "chapter_id": 2788, "verse_number": "१२-२९३-२९", "content_sanskrit": "अब्रुवन्वाऽतिसुरभिर्गन्धः सुमनसां शुचिः।\nतथैवाव्याहरन्भाति विमलो भानुरम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084077, "chapter_id": 2788, "verse_number": "१२-२९३-३०", "content_sanskrit": "एव मादीनि चान्यानि परित्यक्तानि मेधया।\nज्वलन्ति यशसा लोके यानि न व्याहरन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084078, "chapter_id": 2788, "verse_number": "१२-२९३-३१", "content_sanskrit": "न लोके दीप्यते मूर्खः केवलात्मप्रशंसया।\nअपि चापिहितः श्वभ्रे कृतविद्यः प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084079, "chapter_id": 2788, "verse_number": "१२-२९३-३२", "content_sanskrit": "असदुच्चैरपि प्रोक्तः शब्दः समुपशाम्यति।\nदीप्यते त्वेव लोकेषु शनैरपि सुभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084080, "chapter_id": 2788, "verse_number": "१२-२९३-३३", "content_sanskrit": "मूढानामवलिप्तानामसारं भाषितं बहु।\nदर्शयत्यन्तरात्मानमग्निरूपमिवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084081, "chapter_id": 2788, "verse_number": "१२-२९३-३४", "content_sanskrit": "एतस्मात्कारणात्प्रज्ञां मृगयन्ते पृथग्विधाम्।\nप्रज्ञालाभो हि भूतानामुत्तमः प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084082, "chapter_id": 2788, "verse_number": "१२-२९३-३५", "content_sanskrit": "नापृष्टः कस्यचिद्ब्रूयान्नाप्यन्यायेन पृच्छतः।\nजानन्नपि च मेधावी जडवत्समुपाविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084083, "chapter_id": 2788, "verse_number": "१२-२९३-३६", "content_sanskrit": "ततो वासं परीक्षेत धर्मनित्येषु साधुषु।\nमनुष्येषु वदान्येषु स्वधर्मनिरतेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084084, "chapter_id": 2788, "verse_number": "१२-२९३-३७", "content_sanskrit": "चतुर्णां यत्र वर्णानां धर्मव्यतिकरो भवेत्।\nन तत्र वासं कुर्वीत श्रेयोर्थी वै कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084085, "chapter_id": 2788, "verse_number": "१२-२९३-३८", "content_sanskrit": "निरारम्भोऽप्ययमिह यथालब्धोपजीवनः।\nपुण्यं पुण्येषु विमलं पापं पापेषु चाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084086, "chapter_id": 2788, "verse_number": "१२-२९३-३९", "content_sanskrit": "अपामग्नेस्तथेन्दोश्च स्पर्शं वेदयते यथा।\nतथा पश्यामहे स्पर्शमुभयोः पुण्यपापयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084087, "chapter_id": 2788, "verse_number": "१२-२९३-४०", "content_sanskrit": "अपश्यन्तोऽन्यविषयं भुञ्जते विघसाशिनः।\nभुञ्जानाश्चान्यविषयान्विषयान्विद्धि कर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084088, "chapter_id": 2788, "verse_number": "१२-२९३-४१", "content_sanskrit": "यत्रागमयमानानामसत्कारेण पृच्छताम्।\nप्रब्रूयाद्ब्रह्माणो धर्मं त्यजेत्तं देशमात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084089, "chapter_id": 2788, "verse_number": "१२-२९३-४२", "content_sanskrit": "शिष्योषाध्यायिका वृत्तिर्यत्र स्यात्सुसमाहिता।\nयथावच्छास्त्रसंपन्ना कस्तं देशं परित्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084090, "chapter_id": 2788, "verse_number": "१२-२९३-४३", "content_sanskrit": "आकाशस्था ध्रुवं यत्र दोषं ब्रूयुर्विपश्चिताम्।\nआत्मपूजाभिकामो वै को वसेत्तत्र पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084091, "chapter_id": 2788, "verse_number": "१२-२९३-४४", "content_sanskrit": "यत्र संलोडिता लुब्धैः प्रायशो धर्मसेतवः।\nप्रदीप्तमिव चेलान्तं कस्तं देशं न संत्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084092, "chapter_id": 2788, "verse_number": "१२-२९३-४५", "content_sanskrit": "यत्र धर्ममनाशङ्काश्चरेयुर्वीतमत्सराः।\nभवेत्तत्र वसेच्चैव पुण्यशीलेषु साधुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084093, "chapter_id": 2788, "verse_number": "१२-२९३-४६", "content_sanskrit": "धर्ममर्थनिमित्तं च चरेयुर्यत्र मानवाः।\nन ताननुवसेज्जातु ते हि पापकृतो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084094, "chapter_id": 2788, "verse_number": "१२-२९३-४७", "content_sanskrit": "कर्मणां यत्र पापेन वर्तन्ते जीवितेप्सवः।\nव्यवधावेत्ततस्तूर्णं ससर्पाच्छरणादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084095, "chapter_id": 2788, "verse_number": "१२-२९३-४८", "content_sanskrit": "येन खट्वां समारूढः कर्मणाऽनुशयी भवेत्।\nआदितस्तन्न कर्तव्यमिच्छता भवमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084096, "chapter_id": 2788, "verse_number": "१२-२९३-४९", "content_sanskrit": "यत्र राजा च राज्ञश्च पुरुषाः प्रत्यनन्तराः।\nकुटुम्बिनामग्रभुजस्त्यजेत्तद्राष्ट्रमात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084097, "chapter_id": 2788, "verse_number": "१२-२९३-५०", "content_sanskrit": "श्रोत्रियास्त्वग्रभोक्तारो धर्मनित्याः सनातनाः।\nयाजनाध्यापने युक्ता यत्र तद्राष्ट्रमावसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2084098, "chapter_id": 2788, "verse_number": "१२-२९३-५१", "content_sanskrit": "स्वाहास्वधावषट्कारा यत्र सम्यगनुष्ठिताः।\nअजस्रं चैव वर्तन्ते वसेत्तत्राविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2084099, "chapter_id": 2788, "verse_number": "१२-२९३-५२", "content_sanskrit": "अशुचीन्यत्र पश्येत ब्राह्मणान्वृत्तिकर्शितान्।\nत्यजेत्तद्राष्ट्रमासन्नमुपसृष्टमिवामिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2084100, "chapter_id": 2788, "verse_number": "१२-२९३-५३", "content_sanskrit": "प्रीयमाणा नरा यत्र प्रयच्छेयुरयाचिताः।\nस्वस्थचित्तो वसेत्तत्र कृतकृत्य इवात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2084101, "chapter_id": 2788, "verse_number": "१२-२९३-५४", "content_sanskrit": "दण्डो यत्राविनीतेषु सत्कारश्च कृतात्मसु।\nचरेत्तत्र वसेच्चैव पुण्यशीलेषु साधुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2084102, "chapter_id": 2788, "verse_number": "१२-२९३-५५", "content_sanskrit": "उपसृष्टेषु दान्तेषु दुराचारेषु साधुषु।\nअविनीतेषु लुब्धेषु सुमहद्दण्डधारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2084103, "chapter_id": 2788, "verse_number": "१२-२९३-५६", "content_sanskrit": "यत्र राजा धर्मनित्यो राज्यं धर्मेण पालयेत्।\nअपास्य कामान्कामेशो वसेत्तत्राविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2084104, "chapter_id": 2788, "verse_number": "१२-२९३-५७", "content_sanskrit": "यथाशीला हि राजानः सर्वान्विषयवासिनः।\nश्रेयसा योजयत्याशु श्रेयसि प्रत्युपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2084105, "chapter_id": 2788, "verse_number": "१२-२९३-५८", "content_sanskrit": "पृच्छतस्ते मया तात श्रेय एतदुदाहृतम्।\nन हि शक्यं प्रधानेन श्रेयः सङ्ख्यातुमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2084106, "chapter_id": 2788, "verse_number": "१२-२९३-५९", "content_sanskrit": "एवं प्रवर्तमानस्य वृत्तिं प्राणिहितात्मनः।\nतपसैवेह बहुलं श्रेयो व्यक्तं भविष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2084107, "chapter_id": 2788, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिनवत्यधिकद्विशततमोऽध्यायः॥ २९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]