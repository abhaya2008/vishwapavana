[{"id": 5000503000, "chapter_id": 9503, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्विनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000503001, "chapter_id": 9503, "verse_number": "६-९६-१", "content_sanskrit": "तथा तैः कृत्तगात्रैस्तु दशग्रीवेण मार्गणैः।\nबभूव वसुधा तत्र प्रकीर्णा हरिभिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000503002, "chapter_id": 9503, "verse_number": "६-९६-२", "content_sanskrit": "रावणस्याप्रसह्यं तं शरसम्पातमेकतः।\nन शेकुः सहितुं दीप्तं पतङ्गा ज्वलनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000503003, "chapter_id": 9503, "verse_number": "६-९६-३", "content_sanskrit": "तेऽर्दिता निशितैर्बाणैः क्रोशन्तो विप्रदुद्रुवुः।\nपावकार्चिः समाविष्टा दह्यमाना यथा गजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000503004, "chapter_id": 9503, "verse_number": "६-९६-४", "content_sanskrit": "प्लवंगानामनीकानि महाभ्राणीव मारुतः।\nसंययौ समरे तस्मिन् विधमन् रावणः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000503005, "chapter_id": 9503, "verse_number": "६-९६-५", "content_sanskrit": "कदनं तरसा कृत्वा राक्षसेन्द्रो वनौकसाम्।\nआससाद ततो युद्धे त्वरितं राघवं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000503006, "chapter_id": 9503, "verse_number": "६-९६-६", "content_sanskrit": "सुग्रीवस्तान् कपीन् दृष्ट्वा भग्नान् विद्रावितान् रणे।\nगुल्मे सुषेणं निक्षिप्य चक्रे युद्धे द्रुतं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000503007, "chapter_id": 9503, "verse_number": "६-९६-७", "content_sanskrit": "आत्मनः सदृशं वीरं स तं निक्षिप्य वानरम्।\nसुग्रीवोऽभिमुखं शत्रुं प्रतस्थे पादपायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000503008, "chapter_id": 9503, "verse_number": "६-९६-८", "content_sanskrit": "पार्श्वतः पृष्ठतश्चास्य सर्वे वानरयूथपाः।\nअनुजग्मुर्महाशैलान् विविधांश्च वनस्पतीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000503009, "chapter_id": 9503, "verse_number": "६-९६-९", "content_sanskrit": "ननर्द युधि सुग्रीवः स्वरेण महता महान्।\nपोथयन् विविधांश्चान्यान् ममन्थोत्तमराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000503010, "chapter_id": 9503, "verse_number": "६-९६-१०", "content_sanskrit": "ममर्द च महाकायो राक्षसान् वानरेश्वरः।\nयुगान्तसमये वायुः प्रवृद्धानगमानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000503011, "chapter_id": 9503, "verse_number": "६-९६-११", "content_sanskrit": "राक्षसानामनीकेषु शैलवर्षं ववर्ष ह।\nअश्मवर्षं यथा मेघः पक्षिसङ्घेषु कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000503012, "chapter_id": 9503, "verse_number": "६-९६-१२", "content_sanskrit": "कपिराजविमुक्तैस्तैः शैलवर्षैस्तु राक्षसाः।\nविकीर्णशिरसः पेतुर्विकीर्णा इव पर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000503013, "chapter_id": 9503, "verse_number": "६-९६-१३", "content_sanskrit": "अथ संक्षीयमाणेषु राक्षसेषु समन्ततः।\nसुग्रीवेण प्रभग्नेषु नदत्सु च पतत्सु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000503014, "chapter_id": 9503, "verse_number": "६-९६-१४", "content_sanskrit": "विरूपाक्षः स्वकं नाम धन्वी विश्राव्य राक्षसः।\nरथादाप्लुत्य दुर्धर्षो गजस्कन्धमुपारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000503015, "chapter_id": 9503, "verse_number": "६-९६-१५", "content_sanskrit": "स तं द्विपमथारुह्य विरूपाक्षो महाबलः।\nननर्द भीमनिर्ह्रादं वानरानभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000503016, "chapter_id": 9503, "verse_number": "६-९६-१६", "content_sanskrit": "सुग्रीवे स शरान् घोरान् विससर्ज चमूमुखे।\nस्थापयामास चोद्विग्नान् राक्षसान् सम्प्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000503017, "chapter_id": 9503, "verse_number": "६-९६-१७", "content_sanskrit": "सोऽतिविद्धः शितैर्बाणैः कपीन्द्रस्तेन रक्षसा।\nचुक्रोश च महाक्रोधो वधे चास्य मनो दधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000503018, "chapter_id": 9503, "verse_number": "६-९६-१८", "content_sanskrit": "ततः पादपमुद‍्धृत्य शूरः सम्प्रधनो हरिः।\nअभिपत्य जघानास्य प्रमुखे तं महागजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000503019, "chapter_id": 9503, "verse_number": "६-९६-१९", "content_sanskrit": "स तु प्रहाराभिहतः सुग्रीवेण महागजः।\nअपासर्पद् धनुर्मात्रं निषसाद ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000503020, "chapter_id": 9503, "verse_number": "६-९६-२०", "content_sanskrit": "गजात् तु मथितात् तूर्णमपक्रम्य स वीर्यवान्।\nराक्षसोऽभिमुखः शत्रुं प्रत्युद‍्गम्य ततः कपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000503021, "chapter_id": 9503, "verse_number": "६-९६-२१", "content_sanskrit": "आर्षभं चर्म खड्गं च प्रगृह्य लघुविक्रमः।\nभर्त्सयन्निव सुग्रीवमाससाद व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000503022, "chapter_id": 9503, "verse_number": "६-९६-२२", "content_sanskrit": "स हि तस्याभिसंक्रुद्धः प्रगृह्य विपुलां शिलाम्।\nविरूपाक्षस्य चिक्षेप सुग्रीवो जलदोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000503023, "chapter_id": 9503, "verse_number": "६-९६-२३", "content_sanskrit": "स तां शिलामापतन्तीं दृष्ट्वा राक्षसपुंगवः।\nअपक्रम्य सुविक्रान्तः खड्गेन प्राहरत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000503024, "chapter_id": 9503, "verse_number": "६-९६-२४", "content_sanskrit": "तेन खड्गप्रहारेण रक्षसा बलिना हतः।\nमुहूर्तमभवद् भूमौ विसंज्ञ इव वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000503025, "chapter_id": 9503, "verse_number": "६-९६-२५", "content_sanskrit": "सहसा स तदोत्पत्य राक्षसस्य महाहवे।\nमुष्टिं संवर्त्य वेगेन पातयामास वक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000503026, "chapter_id": 9503, "verse_number": "६-९६-२६", "content_sanskrit": "मुष्टिप्रहाराभिहतो विरूपाक्षो निशाचरः।\nतेन खड्गेन संक्रुद्धः सुग्रीवस्य चमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000503027, "chapter_id": 9503, "verse_number": "६-९६-२७", "content_sanskrit": "कवचं पातयामास पद्‍भ्यामभिहतोऽपतत्।\nस समुत्थाय पतितः कपिस्तस्य व्यसर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000503028, "chapter_id": 9503, "verse_number": "६-९६-२८", "content_sanskrit": "तलप्रहारमशनेः समानं भीमनिःस्वनम्।\nतलप्रहारं तद् रक्षः सुग्रीवेण समुद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000503029, "chapter_id": 9503, "verse_number": "६-९६-२९", "content_sanskrit": "नैपुण्यान्मोचयित्वैनं मुष्टिनोरसि ताडयत्।\nततस्तु संक्रुद्धतरः सुग्रीवो वानरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000503030, "chapter_id": 9503, "verse_number": "६-९६-३०", "content_sanskrit": "मोक्षितं चात्मनो दृष्ट्वा प्रहारं तेन रक्षसा।\nस ददर्शान्तरं तस्य विरूपाक्षस्य वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000503031, "chapter_id": 9503, "verse_number": "६-९६-३१", "content_sanskrit": "ततोऽन्यं पातयत् क्रोधाच्छङ्खदेशे महातलम्।\nमहेन्द्राशनिकल्पेन तलेनाभिहतः क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000503032, "chapter_id": 9503, "verse_number": "६-९६-३२", "content_sanskrit": "पपात रुधिरक्लिन्नः शोणितं हि समुद‍‍्गिरन्।\nस्रोतोभ्यस्तु विरूपाक्षो जलं प्रस्रवणादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000503033, "chapter_id": 9503, "verse_number": "६-९६-३३", "content_sanskrit": "विवृत्तनयनं क्रोधात् सफेनं रुधिराप्लुतम्।\nददृशुस्ते विरूपाक्षं विरूपाक्षतरं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000503034, "chapter_id": 9503, "verse_number": "६-९६-३४", "content_sanskrit": "स्फुरन्तं परिवर्तन्तं पार्श्वेन रुधिरोक्षितम्।\nकरुणं च विनर्दन्तं ददृशुः कपयो रिपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000503035, "chapter_id": 9503, "verse_number": "६-९६-३५", "content_sanskrit": "तथा तु तौ संयति सम्प्रयुक्तौ\nतरस्विनौ वानरराक्षसानाम्।\nबलार्णवौ सस्वनतुश्च भीमौ\nमहार्णवौ द्वाविव भिन्नसेतू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000503036, "chapter_id": 9503, "verse_number": "६-९६-३६", "content_sanskrit": "विनाशितं प्रेक्ष्य विरूपनेत्रं\nमहाबलं तं हरिपार्थिवेन।\nबलं समेतं कपिराक्षसाना-\nमुद‍्वृत्तगङ्गाप्रतिमं बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000503037, "chapter_id": 9503, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षण्णवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]