[{"id": 7001547000, "chapter_id": 21547, "verse_number": "१-४४-१", "content_sanskrit": "॥सूत उवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001547001, "chapter_id": 21547, "verse_number": "१-४४-२", "content_sanskrit": "निसर्ग एष विख्यातो भद्राश्वानां यथार्थवत्  ।\nश्रृणुध्वं केतुमालानां विस्तरेण प्रकीर्त्तनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001547002, "chapter_id": 21547, "verse_number": "१-४४-३", "content_sanskrit": "निषधस्याचलेन्द्रस्य पश्चिमस्य महात्मनः ।\nपश्चिमेन हि यत्तत्र दिक्षु सर्वासु कीर्तितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001547003, "chapter_id": 21547, "verse_number": "१-४४-४", "content_sanskrit": "कुलाचलानां सप्तानां नदीनाञ्च विशेषतः ।\nतथा जनपदानाञ्च विस्तरं श्रोतुमर्हथ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001547004, "chapter_id": 21547, "verse_number": "१-४४-५", "content_sanskrit": "विशालः कम्बलः कृष्णो जयन्तो हरिपर्वतः ।\nअशोको वर्द्धमानश्च सप्तैते कुलपर्व्वताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001547005, "chapter_id": 21547, "verse_number": "१-४४-६", "content_sanskrit": "तेषां प्रसूतिरन्येऽपि पर्वता बहुविस्तराः ।\nकोटिकोटिशता ज्ञेयाः शतशोऽथ सहस्रशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001547006, "chapter_id": 21547, "verse_number": "१-४४-७", "content_sanskrit": "तैर्विमिश्रा जनपदा नानाजातिसमाकुलाः ।\nनानाप्रकारविज्ञेयास्त्वनेकनृपपालिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001547007, "chapter_id": 21547, "verse_number": "१-४४-८", "content_sanskrit": "ते नामधेयैर्विक्रान्ता विविधाः प्रथिताः भुवि ।\nअध्यासिता जनपदैः कीर्त्तनैश्च विभूषिताः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001547008, "chapter_id": 21547, "verse_number": "१-४४-९", "content_sanskrit": "तेषां सनामधेयानि राष्ट्राणि विविधानि च ।\nगिर्य्यन्तरनिविष्टानि समेषु विषमेषु च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001547009, "chapter_id": 21547, "verse_number": "१-४४-१०", "content_sanskrit": "यथैह कथिताः पौरा गोमनुष्यकपोतकाः ।\nतत्सुखा भ्रमरा यूथा माहेयाचलकूटकाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001547010, "chapter_id": 21547, "verse_number": "१-४४-११", "content_sanskrit": "सुमौलाः स्तावकाः क्रौञ्चाः कृष्णाङ्गमणिपुञ्जकाः ।\nकूटकम्बलमौषीयाः समुद्रान्तरकास्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001547011, "chapter_id": 21547, "verse_number": "१-४४-१२", "content_sanskrit": "करम्भवाः कुचाः श्वेताः सुवर्णकटकाः शुभाः ।\nश्वेताङ्गाः कृष्णपादाश्च विहगा कपिलकर्णिकाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001547012, "chapter_id": 21547, "verse_number": "१-४४-१३", "content_sanskrit": "अत्याकरालगोज्वाला हीनानावनपातकाः ।\nमहिषाः कुमुदाभाश्च करवाटाः सहोत्कचाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001547013, "chapter_id": 21547, "verse_number": "१-४४-१४", "content_sanskrit": "शु(नका) कनासा महानासा वनासगजभूमिकाः ।\nकरञ्जमञ्जमा वाहाः किष्किण्डीपाण्डुभूमिकीः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001547014, "chapter_id": 21547, "verse_number": "१-४४-१५", "content_sanskrit": "कुबेरा धूमजा जङ्गा वङ्गा राजीवकोकिलाः ।\nवाचाङ्गाश्च महाङ्गाश्च मधौरेयाः सुरेचकाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001547015, "chapter_id": 21547, "verse_number": "१-४४-१६", "content_sanskrit": "पित्तलाः काचलाश्चैव श्रवणा मत्तकासिकाः ।\nगोदावा बकुला वाङ्गा वङ्गका मोदकाः कलाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001547016, "chapter_id": 21547, "verse_number": "१-४४-१७", "content_sanskrit": "ते पिबन्ति महाभागाः प्रथमान्तु महानदीम् ।\nसुवप्रां पुण्यसलिलां महानागनिषेविताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001547017, "chapter_id": 21547, "verse_number": "१-४४-१८", "content_sanskrit": "कम्बलां तामसीं श्यामां सुमेधां बकुलां नदीम् ।\nविकीर्णां शिखिमालाञ्च तथा दर्भावतीमपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001547018, "chapter_id": 21547, "verse_number": "१-४४-१९", "content_sanskrit": "भद्रानदीं शुकनदीं पलाशाञ्च महानदीम् ।\nभीमां प्रभञ्जनां काञ्चीं पुण्याञ्चैव कुशावतीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001547019, "chapter_id": 21547, "verse_number": "१-४४-२०", "content_sanskrit": "दक्षां शाकवतीञ्चैव पुण्यो दाञ्च महानदीम् ।\nचन्द्रावतीं सुमूलाञ्च ऋषभाञ्चापगोत्तमाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001547020, "chapter_id": 21547, "verse_number": "१-४४-२१", "content_sanskrit": "नदीं समुद्रमालाञ्च तथा चम्पावतीमपि ।\nएकाक्षां पुष्कलां वाहां सुवर्णां नन्दि नीमपि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001547021, "chapter_id": 21547, "verse_number": "१-४४-२२", "content_sanskrit": "कालिन्दीञ्चैव पुण्योदां भारतीञ्च महानदीम्  ।\nसीतोदाम्पातिकां ब्राह्मीं विशालाञ्च महानदीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001547022, "chapter_id": 21547, "verse_number": "१-४४-२३", "content_sanskrit": "पीवरीं कुम्भकारीञ्च रुषा ञ्चैवापगोत्तमाम् ।\nमहिषीं मानुषीं दण्डां तथा नदनदीं शुभाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001547023, "chapter_id": 21547, "verse_number": "१-४४-२४", "content_sanskrit": "एताञ्चान्याञ्च पीयन्ते बह्वयो हि सरितोत्तमाः  ।\nदेवर्षिसिद्धचरिताः पुण्योदाः पापहाः शुभाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001547024, "chapter_id": 21547, "verse_number": "१-४४-२५", "content_sanskrit": "नानाजनपदास्फीतं महापगाविभूषितम् ।\nनानारत्नौघसम्पूर्णं नित्यं प्रमुदितं शिवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001547025, "chapter_id": 21547, "verse_number": "१-४४-२६", "content_sanskrit": "उदीर्णं धनधान्यार्थैर्नरवासैः समन्ततः ।\nसन्निविष्टं महाद्वीपं पश्चिमं सुकृतात्मनाम्  ।\nनिसर्गः केतुमालानामेष वः परिकीर्त्तितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001547026, "chapter_id": 21547, "verse_number": "१-४४-२७", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते भुवनविन्यासो नाम चतुश्वत्वारिंशोऽध्यायः ॥ ४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]