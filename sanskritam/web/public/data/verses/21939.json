[{"id": 7001939000, "chapter_id": 21939, "verse_number": "११८-१", "content_sanskrit": "करन्धमचरितवर्णनम् ।\nमार्कण्डेय उवाच ।\nततः स नृपतिर्गत्वा गोमतीं पापनाशिनीम् ।\nतत्र तुष्टाव नियतो भूत्वा देवं पुरन्दरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001939001, "chapter_id": 21939, "verse_number": "११८-२", "content_sanskrit": "तप्यमानस्तपश्चोग्रं यतवाक्कायमानसः ।\nतुष्टाव प्रयतः शक्रमपत्यार्थं महीपतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001939002, "chapter_id": 21939, "verse_number": "११८-३", "content_sanskrit": "तस्य स्तोत्रेण तपसा भक्त्या चापि सुरेश्वरः ।\nतुतोष भगवानिन्द्रः प्राह चैनं महामुने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001939003, "chapter_id": 21939, "verse_number": "११८-४", "content_sanskrit": "अनेन तपसा भक्त्या स्तोत्रेणोच्चारितेन च ।\nपरितुष्टोऽस्मि ते भूप व्रियतां भवता वरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001939004, "chapter_id": 21939, "verse_number": "११८-५", "content_sanskrit": "राजोवाच ।\nअपुत्रस्य सुतो मेऽस्तु सर्वशस्त्रभृतां वरः ।\nसदा चाव्याहतैश्वर्यो धर्मकृद्धर्मवित्कृती ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001939005, "chapter_id": 21939, "verse_number": "११८-६", "content_sanskrit": "मार्कण्डेय उवाच ।\nतथेति चोक्तः शक्रेण राजा प्राप्तमनोरथः ।\nप्रजाः पालयितुं भूप आजगाम निजं पुरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001939006, "chapter_id": 21939, "verse_number": "११८-७", "content_sanskrit": "तत्रास्य कुर्वतो यज्ञं सम्यक्पालयतः प्रजाः ।\nअजायत सुतो विप्र तदा शक्रप्रसादतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001939007, "chapter_id": 21939, "verse_number": "११८-८", "content_sanskrit": "तस्य नाम पिता चक्रे बलाश्व इति भूपतिः ।\nअस्त्रग्राममशेषं च ग्राहयामास तं सुतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001939008, "chapter_id": 21939, "verse_number": "११८-९", "content_sanskrit": "पितर्युपरते विप्र सोऽधिराज्ये स्थितो नृपः ।\nस बलाश्वो वशं निन्ये भुवि सर्वमहीक्षितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001939009, "chapter_id": 21939, "verse_number": "११८-१०", "content_sanskrit": "करं च दापयामास सारग्रहणपूर्वकम् ।\nस सर्वभूमिपान्राजा पालयामास च प्रजाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001939010, "chapter_id": 21939, "verse_number": "११८-११", "content_sanskrit": "अथाखिलनरेन्द्रास्ते दायादास्तस्य दुर्मदाः ।\nन चाभ्युत्थाय सततं त चास्मै प्रददुः करान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001939011, "chapter_id": 21939, "verse_number": "११८-१२", "content_sanskrit": "व्युत्थिताः स्वेषु राष्ट्रेषु न सन्तोषपरास्ततः ।\nभुवं तस्य नरेन्द्रस्य जगृहुस्ते नराधिपाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001939012, "chapter_id": 21939, "verse_number": "११८-१३", "content_sanskrit": "स गृहीत्वा स्वकं राज्यं पृथिवीशो बलान्मुने ।\nतस्थौ स्वनगरे भूपैर्विरोधो बहुभिः कृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001939013, "chapter_id": 21939, "verse_number": "११८-१४", "content_sanskrit": "समेत्य सुमहावीर्याः ससाधनधनास्ततः ।\nरुरुधुस्तं महीपालं पुरे तत्र नरेश्वराः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001939014, "chapter_id": 21939, "verse_number": "११८-१५", "content_sanskrit": "पुररोधेन तेनाथ कुपितः स महीपतिः ।\nस्वल्पकोशोऽल्पदण्डश्च वैक्लव्यं परमं गतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001939015, "chapter_id": 21939, "verse_number": "११८-१६", "content_sanskrit": "अपश्यमानः शरणं सबलो द्विजसत्तम ।\nकरौ मुखाग्रतः कृत्वा निशश्वासार्तमानसः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001939016, "chapter_id": 21939, "verse_number": "११८-१७", "content_sanskrit": "ततोऽस्य हस्तविवरान्मुखानिलसमाहताः ।\nनिर्जग्मुः शतशो योधा रथनागतुरङ्गमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001939017, "chapter_id": 21939, "verse_number": "११८-१८", "content_sanskrit": "ततः क्षणेन तत्सर्वं नगरं तस्य भूपतेः ।\nव्याप्तमासीद्बलौघेन सारेणातिबलान्मुने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001939018, "chapter_id": 21939, "verse_number": "११८-१९", "content_sanskrit": "अथ सोऽतिबलौघेन महता तेन संवृतः ।\nनिर्मथ्यनगरात्तस्मात्तान्विजिग्ये नराधिपः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001939019, "chapter_id": 21939, "verse_number": "११८-२०", "content_sanskrit": "जित्वा च वशमानीय चकार करदान्पुनः ।\nयथापूर्वं महाभाग महाभाग्यो नरेश्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001939020, "chapter_id": 21939, "verse_number": "११८-२१", "content_sanskrit": "धुतयोः करयोर्जज्ञे यतस्तस्यारिदाहदम् ।\nबलं करन्धमस्तस्मात्स बलाश्वोऽभिधीयते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001939021, "chapter_id": 21939, "verse_number": "११८-२२", "content_sanskrit": "स धर्मात्मा महात्मा च स मैत्रः सर्वजन्तुषु ।\nकरन्धमोऽभवद्भूपस्त्रिषु लोकेषु विश्रुतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001939022, "chapter_id": 21939, "verse_number": "११८-२३", "content_sanskrit": "सम्प्रास्तस्य परामार्त्तिं ददावरिविनाशनम् ।\nबलं धर्मेण चाक्षिप्तमभ्युपेत्य स्वयं नृपम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]