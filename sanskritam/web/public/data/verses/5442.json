[{"id": 2208069, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208070, "chapter_id": 5442, "verse_number": "१", "content_sanskrit": "ब्रह्म यत् परमं वेद्यं तन्मे व्याख्यातुमर्हसि ।\nभवतो हि प्रसादेन सुसूक्ष्मे रमते मतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208071, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208072, "chapter_id": 5442, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nसंवादं मोक्षसंयुक्तं शिष्यस्य गुरुणा सह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208073, "chapter_id": 5442, "verse_number": "३", "content_sanskrit": "कञ्चिद् ब्राह्मणमासीनमाचार्यं संशितव्रतम् ।\nशिष्यः पप्रच्छ मेधावी किंस्विच्छ्रेयः परन्तप ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208074, "chapter_id": 5442, "verse_number": "४", "content_sanskrit": "भगवन्तं प्रपन्नोऽहं निःश्रेयसपरायणः ।\nयाचे त्वां शिरसा विप्र यद् ब्रूयां तद् विचक्ष्व मे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208075, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208076, "chapter_id": 5442, "verse_number": "५", "content_sanskrit": "तमेवंवादिनं पार्थ शिष्यं गुरुरुवाच ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208077, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "गुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208078, "chapter_id": 5442, "verse_number": "६", "content_sanskrit": "कथयस्व प्रवक्ष्यामि यत्र ते संशयो द्विज ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208079, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208080, "chapter_id": 5442, "verse_number": "७", "content_sanskrit": "इत्युक्तः स कुरुश्रेष्ठ गुरुणा गुरुवत्सलः ।\nप्राञ्जलिः परिपप्रच्छ यत् तच्छृणु महामते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208081, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "शिष्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208082, "chapter_id": 5442, "verse_number": "८", "content_sanskrit": "कुतश्चाहं कुतश्च त्वं तत् सर्वं ब्रूहि यत् परम् ।\nकुतो जातानि भूतानि चराणि स्थावराणि च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208083, "chapter_id": 5442, "verse_number": "९", "content_sanskrit": "केन जीवन्ति जातानि तेषामायुः किमात्मकम् ।\nकिं सत्यं किं तपो विप्र के गुणाः सद्भिरीरिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208084, "chapter_id": 5442, "verse_number": "१०", "content_sanskrit": "के पन्थानः शिवाः सन्ति सुकृतं किं च दुष्कृतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208085, "chapter_id": 5442, "verse_number": "११", "content_sanskrit": "एतान् मे भगवन् प्रश्नान् याथातथ्येन सत्तम ।\nवक्तुमर्हसि विप्रर्षे यथावदिह तत्त्वतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208086, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208087, "chapter_id": 5442, "verse_number": "१२", "content_sanskrit": "तस्मै सम्प्रतिपन्नाय यथावत् परिपृच्छते ।\nशिष्याय गुणयुक्ताय शान्ताय प्रियवर्तिने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208088, "chapter_id": 5442, "verse_number": "१३", "content_sanskrit": "छायाभूताय दान्ताय यतये ब्रह्मचारिणे ।\nतान् प्रश्नानब्रवीत् पार्थ मेधावी सुदृढव्रतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208089, "chapter_id": 5442, "verse_number": "१४", "content_sanskrit": "गुरुः कुरुकुलश्रेष्ठ सम्यक् सर्वानशेषतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208090, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "गुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208091, "chapter_id": 5442, "verse_number": "१५", "content_sanskrit": "ब्रह्मप्रोक्तमिदं धर्ममृषिप्रवरसेवितम् ।\nवेदविद्यासमावाप्तं तत्त्वभूतार्थभावनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208092, "chapter_id": 5442, "verse_number": "१६", "content_sanskrit": "भूतभव्यभविष्यादिधर्मकामार्थनिश्चयम् ।\nसिद्धसङ्घपरिज्ञातं पुराकल्पं सनातनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208093, "chapter_id": 5442, "verse_number": "१७", "content_sanskrit": "प्रवक्ष्यामि महाप्राज्ञ परमुत्तममद्य ते ।\nबुद्ध्या यदिह संसिद्धा भवन्तीह मनीषिणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208094, "chapter_id": 5442, "verse_number": "१८", "content_sanskrit": "उपागम्यर्षयः पूर्वं जिज्ञासन्तः परस्परम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208095, "chapter_id": 5442, "verse_number": "१९", "content_sanskrit": "बृहस्पतिर्भरद्वाजो गौतमो भार्गवस्तथा ।\nवसिष्ठः कश्यपश्चैव विश्वामित्रोऽत्रिरेव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208096, "chapter_id": 5442, "verse_number": "२०", "content_sanskrit": "मार्गान् सर्वान् परिक्रम्य परिश्रान्ताः स्वकर्मभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208097, "chapter_id": 5442, "verse_number": "२१", "content_sanskrit": "ऋषिमाङ्गिरसं वृद्धं पुरस्कृत्य तु ते द्विजाः ।\nददृशुर्ब्रह्मभवने ब्रह्माणं वीतकल्मषम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208098, "chapter_id": 5442, "verse_number": "२२", "content_sanskrit": "तं प्रणम्य महात्मानं सुखासीनं महर्षयः ।\nपप्रच्छुर्विनयोपेता नैःश्रेयसमिदं परम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208099, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208100, "chapter_id": 5442, "verse_number": "२३", "content_sanskrit": "कथं कर्म कृतं साधु कथं मुच्येत किल्बिषात् ।\nके नो मार्गाः शिवाश्च स्युः किं सत्यं किं च दुष्कृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208101, "chapter_id": 5442, "verse_number": "२४", "content_sanskrit": "कौ वेमौ कर्मपन्थानौ महत्त्वं केन विन्दति ।\nनिरयं चापवर्गं च भूतानां प्रभवाप्ययौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208102, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "गुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208103, "chapter_id": 5442, "verse_number": "२५", "content_sanskrit": "इत्युक्तः स मुनिश्रेष्ठैर्यदाह प्रपितामहः ।\nतत् तेऽहं सम्प्रवक्ष्यामि शृणु शिष्य यथातथम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208104, "chapter_id": 5442, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208105, "chapter_id": 5442, "verse_number": "२६", "content_sanskrit": "सत्याद् भूतानि जातानि स्थावराणि चराणि च ।\nतपसा तानि जीवन्ति जीवितं तद्धि सुव्रतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208106, "chapter_id": 5442, "verse_number": "२७", "content_sanskrit": "स्वां योनिं पुनरागम्य वर्तन्ते येन कर्मणा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208107, "chapter_id": 5442, "verse_number": "२८", "content_sanskrit": "सत्यं हि गुणसंयुक्तं नियतं पञ्चलक्षणम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208108, "chapter_id": 5442, "verse_number": "२९", "content_sanskrit": "ब्रह्म सत्यं तपः सत्यं सत्यं चैव प्रजापतिः ।\nसत्याद् भूतानि जातानि भूतं सत्यमयं महत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208109, "chapter_id": 5442, "verse_number": "३०", "content_sanskrit": "तस्मात् सत्याश्रया विप्रा नित्यं योगपरायणाः ।\nअतीतक्रोधसन्तापा नियता धर्मसेतवः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2208110, "chapter_id": 5442, "verse_number": "३१", "content_sanskrit": "अन्योन्यनियतान् वैद्यान् धर्मसेतुप्रवर्तकान् ।\nतानहं सम्प्रवक्ष्यामि शाश्वतान् लोकभावनान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2208111, "chapter_id": 5442, "verse_number": "३२", "content_sanskrit": "चातुर्वैद्यांस्तथा वर्णान् आश्रमांश्च पृथक् पृथक् ।\nधर्ममेकं चतुष्पादं नित्यमाहुर्मनीषिणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2208112, "chapter_id": 5442, "verse_number": "३३", "content_sanskrit": "पन्थानं वः प्रवक्ष्यामि शिवं क्षेमकरं द्विजाः ।\nनित्यं ब्रह्मविदामिष्टं गतं पूर्वमहर्षिभिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2208113, "chapter_id": 5442, "verse_number": "३४", "content_sanskrit": "गदतस्तु ममाद्येह पन्थानं दुर्विदं परम् ।\nनिबोधत महाभागा निखिलेन परं पदम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2208114, "chapter_id": 5442, "verse_number": "३५", "content_sanskrit": "ब्रह्मचारिकमेवाहुराश्रमं परमं पदम् ।\nद्वितीयं गार्हपत्यं तु वानप्रस्थमतः परम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2208115, "chapter_id": 5442, "verse_number": "३६", "content_sanskrit": "ततः परं तु विज्ञेयम् अध्यात्मं परमं पदम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2208116, "chapter_id": 5442, "verse_number": "३७", "content_sanskrit": "ज्योतिराकाशमादित्यो वायुरिन्द्रः प्रजापतिः ।\nनोपैति यावदध्यात्मं तावदेतान् न पश्यति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2208117, "chapter_id": 5442, "verse_number": "३८", "content_sanskrit": "तस्य रूपं प्रवक्ष्यामि पुरस्तात् तं निबोधत ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2208118, "chapter_id": 5442, "verse_number": "३९", "content_sanskrit": "फलमूलाशनवतां मुनीनां वसतां वने ।\nवानप्रस्थं द्विजातीनां त्रयाणामुपदिश्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2208119, "chapter_id": 5442, "verse_number": "४०", "content_sanskrit": "सर्वेषामेव वर्णानां गृहस्थोऽयं विशिष्यते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2208120, "chapter_id": 5442, "verse_number": "४१", "content_sanskrit": "नैष्ठिकोऽथ यतिर्वाऽपि विरक्तो ब्रह्मदर्शने ।\nश्रद्धालक्षणमित्येवं धर्मं धीराः प्रचक्षते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2208121, "chapter_id": 5442, "verse_number": "४२", "content_sanskrit": "सदेवयानाः पन्थानः पन्थानः परिकीर्तिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2208122, "chapter_id": 5442, "verse_number": "४३", "content_sanskrit": "सद्भिरध्यासिता धीरैः कर्मभिर्धर्मसेतवः ।\nएतेषां पृथगध्यास्ते यो धर्मं संशितव्रतः ।\nकालात् पश्यति भूतानां सतां हि प्रभवाप्ययौ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2208123, "chapter_id": 5442, "verse_number": "४४", "content_sanskrit": "अतस्तत्त्वानि वक्ष्यामि याथातथ्येन हेतुना ।\nविषयस्थानि सर्वाणि वर्तमानानि भागशः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2208124, "chapter_id": 5442, "verse_number": "४५", "content_sanskrit": "महानात्मा तथाऽव्यक्तमहङ्कारस्तथैव च ।\nइन्द्रियाणि दशैकं च महाभूतानि पञ्च च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2208125, "chapter_id": 5442, "verse_number": "४६", "content_sanskrit": "विशेषाः पञ्चभूतानामित्येषा वैदिकी श्रुतिः ।\nचतुर्विंशतिरेषा वै तत्त्वानां सम्प्रकीर्तिता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2208126, "chapter_id": 5442, "verse_number": "४७", "content_sanskrit": "तत्त्वानामथ यो वेद सर्वेषां प्रभवाप्ययौ ।\nस धीरः सर्वभूतेषु न मोहमधिगच्छति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2208127, "chapter_id": 5442, "verse_number": "४८", "content_sanskrit": "तत्त्वानि यो वेदयते यथातथं\nगुणांश्च सर्वानखिलां च देवताः ।\nविधूतपाप्मा हि विमुच्य बन्धनं\nस सर्वलोकानमलः समश्नुते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2208128, "chapter_id": 5442, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु गुरुशिष्यसंवादे तत्वकथनं नाम षट्त्रिंशोऽध्यायः ॥३६॥\nअनुगीतापर्वणि एकविंशोऽध्यायः ॥२१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]