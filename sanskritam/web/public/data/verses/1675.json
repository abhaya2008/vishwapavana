[{"id": 2030807, "chapter_id": 1675, "verse_number": "३-३१३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030808, "chapter_id": 1675, "verse_number": "३-३१३-१", "content_sanskrit": "नापदामस्ति मर्यादा न निमित्तं न कारणम्।\nधर्मस्तु विभजत्यर्थमुभयोः पुण्यपापयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030809, "chapter_id": 1675, "verse_number": "३-३१३-२x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030810, "chapter_id": 1675, "verse_number": "३-३१३-२", "content_sanskrit": "प्रातिकाम्यनयत्कृष्णां सभायां प्रेष्यवत्तदा।\nन मया निहतस्तत्रतेन प्राप्ताः स्म संशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030811, "chapter_id": 1675, "verse_number": "३-३१३-३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030812, "chapter_id": 1675, "verse_number": "३-३१३-३", "content_sanskrit": "वाचस्तीक्ष्णास्थिभेदिन्यः सूतपुत्रेण भाषिताः।\nअतितीव्रा मया क्षान्तास्तेन प्राप्ताः स्म संशयं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030813, "chapter_id": 1675, "verse_number": "३-३१३-४x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030814, "chapter_id": 1675, "verse_number": "३-३१३-४", "content_sanskrit": "शकुनिस्त्वां यदाऽजैषीदक्षद्यूतेन भारत।\nस मया न हतस्तत्रतेन प्राप्ताः स्म संशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030815, "chapter_id": 1675, "verse_number": "३-३१३-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030816, "chapter_id": 1675, "verse_number": "३-३१३-५", "content_sanskrit": "ततो युधिष्ठिरो राजा नकुलं वाक्यमब्रवीत्।\nआरुह्य वृक्षं माद्रेय निरीक्षस्व दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030817, "chapter_id": 1675, "verse_number": "३-३१३-६", "content_sanskrit": "पानीयमन्तिके पश्य वृक्षान्वाप्युदकाश्रयान्।\nएते हि भ्रातरः श्रान्तास्तव तात पिपासिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030818, "chapter_id": 1675, "verse_number": "३-३१३-७", "content_sanskrit": "नकुलस्तु तथेत्युक्त्वा भ्रातुर्ज्येऽष्ठस्य शासनात्।\nतत उत्थाय मतिमाञ्शीघ्रमारुह्य पादपम्।\nअब्रवीद्धांतरं ज्येष्मभिवीक्ष्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030819, "chapter_id": 1675, "verse_number": "३-३१३-८", "content_sanskrit": "पश्यामि बहुलान्राजन्वृक्षानुदकसंश्रयान्।\nसारसानां च निर्ह्रादस्तत्रोदकमसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030820, "chapter_id": 1675, "verse_number": "३-३१३-९", "content_sanskrit": "ततोऽब्रवीत्सत्यधृतिः कुन्तीपुत्रो युधिष्ठिरः।\nगच्छ सौम्य ततः शीघ्रं तूणैः रपानीयमानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030821, "chapter_id": 1675, "verse_number": "३-३१३-१०", "content_sanskrit": "नकुलस्तु तथेत्युक्त्वा भ्रातुर्ज्येष्ठस्य शासनात्।\nप्राद्रवद्यत्र पानीयं शीघ्रं चैवान्वपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030822, "chapter_id": 1675, "verse_number": "३-३१३-११", "content_sanskrit": "स दृष्ट्वा विमलं तोयं सारसैः परिवारितम्।\nपातुकामस्ततो वाचमन्तरिक्षात्स शुश्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030823, "chapter_id": 1675, "verse_number": "३-३१३-१२x", "content_sanskrit": "यक्ष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030824, "chapter_id": 1675, "verse_number": "३-३१३-१२", "content_sanskrit": "मा तात साहसं कार्षीर्मम पूर्वपरिग्रहः।\nप्रश्नानुक्त्वा तु माद्रेय ततः पिब हरस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030825, "chapter_id": 1675, "verse_number": "३-३१३-१३", "content_sanskrit": "अनादृत्य तु तद्वाक्यं नकुलः सुपिपासितः।\nअपिबच्छीतलं तोयं पीत्वा च निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030826, "chapter_id": 1675, "verse_number": "३-३१३-१४", "content_sanskrit": "चिरायमाणे नकुले कुन्तीपुत्रो युधिष्ठिरः।\nअब्रवीद्ध्रातरं वीरं सहदेवमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030827, "chapter_id": 1675, "verse_number": "३-३१३-१५", "content_sanskrit": "भ्राता चिरायते तात सहदेव तवाग्रजः।\nतं चैवानय सोदर्यं पानीयं च त्वमानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030828, "chapter_id": 1675, "verse_number": "३-३१३-१६", "content_sanskrit": "सहदेवस्तथेत्युक्त्वा तां दिशं प्रत्यपद्यत।\nददर्श च हतं भूमौ भ्रातरं नकुलं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030829, "chapter_id": 1675, "verse_number": "३-३१३-१७", "content_sanskrit": "भ्रातृशोकाभिसंतप्तस्तृषया च प्रपीडितः।\nअभिदुद्राव रपानीयं ततो वागभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030830, "chapter_id": 1675, "verse_number": "३-३१३-१८", "content_sanskrit": "मा तात साहसं कार्षीर्मम पूर्वपरिग्रहः।\nप्रश्नानुक्त्वा यथाकामं पिबस्व च हरस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030831, "chapter_id": 1675, "verse_number": "३-३१३-१९", "content_sanskrit": "अनादृत्य तु तद्वाक्यं सहदेवः पिपासितः।\nअपिबच्छीतलं तोयं पीत्वा च निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030832, "chapter_id": 1675, "verse_number": "३-३१३-२०", "content_sanskrit": "अथाब्रवीत्स विजयं कुन्तीपुत्रो युधिष्ठिरः।\nभ्रातरौ ते चिरगतौ बीभत्सो शत्रुकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030833, "chapter_id": 1675, "verse_number": "३-३१३-२१", "content_sanskrit": "तौ चैवानय भद्रं ते पानीयं च त्वमानय।\nत्वं हि नस्तात सर्वेषां दुःखितानामपाश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030834, "chapter_id": 1675, "verse_number": "३-३१३-२२", "content_sanskrit": "एवमुक्तो गुडाकेशः प्रगृह्य सशरं धनुः।\nआमुक्तखङ्गो मेधावी तत्सरः प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030835, "chapter_id": 1675, "verse_number": "३-३१३-२३", "content_sanskrit": "यतः पुरुषशार्दूलौ पानीयहरणे गतौ।\nतौ ददर्श हतौ तत्रभ्रातरौ श्वेतवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030836, "chapter_id": 1675, "verse_number": "३-३१३-२४", "content_sanskrit": "`विगतासू नरव्याघ्रौ शयानौ वसुधातले।\nप्रसुप्ताविव तौ दृष्ट्वा नरसिंहः सुदुःखितः।\nधनुरुद्यम्य कौन्तेयो व्यलोकयत तद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030837, "chapter_id": 1675, "verse_number": "३-३१३-२५", "content_sanskrit": "नापश्यत्तत्रकिंचित्स भूतमस्मिन्महावने।\nसव्यसाची पिपासार्तः पानीयं सोभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030838, "chapter_id": 1675, "verse_number": "३-३१३-२६", "content_sanskrit": "अभिधावंस्ततो वाचमन्तरिक्षात्स शुश्रुवे।\nयत्त्वमिच्छसि पानीयं नैतच्छक्यं बलात्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030839, "chapter_id": 1675, "verse_number": "३-३१३-२७", "content_sanskrit": "कौन्तेय यदि वै प्रश्नान्मयोक्तान्प्रतिवक्ष्यसि।\nततः पास्यसि पानीयं हरिष्यसि च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030840, "chapter_id": 1675, "verse_number": "३-३१३-२८", "content_sanskrit": "वारितस्त्वब्रवीत्पार्थो दृश्यमानो निवारय।\nयावद्बाणैर्विनिर्भिन्नः पुनर्नैवं वदिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030841, "chapter_id": 1675, "verse_number": "३-३१३-२९", "content_sanskrit": "एवमुक्त्वा ततः पार्थः शरैरस्त्रानुमन्त्रितैः।\nप्रववर्ष रदिशः कृत्स्नाः शब्दवेधं च दर्शयन्।\nकर्णिनालीकनाराचानुत्सृजन्भरतर्षभः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030842, "chapter_id": 1675, "verse_number": "३-३१३-३०", "content_sanskrit": "स त्वमोघानिषून्मुक्त्वा तृष्णयाऽभिप्रपीडितः।\nअनेकैरिषुसंघातैरन्तरिक्षे ववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030843, "chapter_id": 1675, "verse_number": "३-३१३-३१x", "content_sanskrit": "यक्ष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030844, "chapter_id": 1675, "verse_number": "३-३१३-३१", "content_sanskrit": "किं विधानेन ते पार्थ प्रश्नानुक्त्वा पयः पिब।\nअनुक्त्वा च पिबन्प्रश्नान्पीत्वैव नभविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030845, "chapter_id": 1675, "verse_number": "३-३१३-३२", "content_sanskrit": "स च मोघानिषून्दृष्ट्वातृष्णया च प्रपीडितः।\nअवज्ञायैव तां वाचं पीत्वैव निपपात् ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030846, "chapter_id": 1675, "verse_number": "३-३१३-३३", "content_sanskrit": "अथाब्रवीद्भीमसेनं कुनतीपुत्रो युधिष्ठिरः।\nनकुलः सहदेवश्च बीभत्सुश्च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030847, "chapter_id": 1675, "verse_number": "३-३१३-३४", "content_sanskrit": "चिरंगतास्तोयहेतोर्न चागच्छन्ति भारत।\nतांश्चैवानय भद्रं ते पानीयं च त्वमानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030848, "chapter_id": 1675, "verse_number": "३-३१३-३५", "content_sanskrit": "भीमसेनस्तथेत्युक्त्वा तं देशं प्रत्यपद्यत।\nरयत्रते पुरुषव्याघ्रा भ्रातरोस्य निपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030849, "chapter_id": 1675, "verse_number": "३-३१३-३६", "content_sanskrit": "तान्दृष्ट्वा दुःखितो भीमस्तृषया च प्रपीडितः।\nअमन्यत महाबाहुः कर्म तद्यक्षरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030850, "chapter_id": 1675, "verse_number": "३-३१३-३७", "content_sanskrit": "सचिन्तयामास तदा योद्धव्यं ध्रुवमद्य मे।\nपास्यामि तावत्पानीयमिति पार्थो वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030851, "chapter_id": 1675, "verse_number": "३-३१३-३८", "content_sanskrit": "ततोऽभ्यधावत्पानीयं पिपासुः पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2030852, "chapter_id": 1675, "verse_number": "३-३१३-३९x", "content_sanskrit": "यक्ष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2030853, "chapter_id": 1675, "verse_number": "३-३१३-३९", "content_sanskrit": "मा तात साहसंकार्षीर्मम पूर्वपरिग्रहः।\nप्रश्नानुक्त्वा तु कौन्तेय ततः पिब हरस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2030854, "chapter_id": 1675, "verse_number": "३-३१३-४०", "content_sanskrit": "एवमुक्तस्तदा भीमो यक्षेणामिततेजसा।\nअनुक्त्वैव तु तान्प्रश्नान्पीत्वैव निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2030855, "chapter_id": 1675, "verse_number": "३-३१३-४१", "content_sanskrit": "ततः कुन्तीसुतो राजा प्रचिन्त्य पुरुषर्षभः।\n`आत्मनाऽऽत्मानमन्विष्य विचारमकरोत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2030856, "chapter_id": 1675, "verse_number": "३-३१३-४२", "content_sanskrit": "ततश्चिरगतान्भ्रातृनथाऽऽज्ञाय युधिष्ठिरः।\nचिरायमाणान्बहुशः पुनः पुनरुवाचह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2030857, "chapter_id": 1675, "verse_number": "३-३१३-४३", "content_sanskrit": "किंस्विद्वनमिदं दग्धं किंखिद्दृष्टो मृतो भवेत्।\nप्रहरन्तो महाभूतं शप्तास्तेनाथ तेऽपतन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2030858, "chapter_id": 1675, "verse_number": "३-३१३-४४", "content_sanskrit": "न पश्यन्त्यथवा वीराः पानीयं यत्रते गताः।\nअन्विच्छद्भिर्वने तोयं कालोऽयमतिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2030859, "chapter_id": 1675, "verse_number": "३-३१३-४५", "content_sanskrit": "किंनु तत्कारणं येन नायान्ति पुरुषर्षभाः।\nगच्छाम्येषां पदं द्रष्टुमिति कृत्वा युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2030860, "chapter_id": 1675, "verse_number": "३-३१३-४६", "content_sanskrit": "समुत्थाय महाबुद्धिर्दह्यमानेन चेतसा।\nव्यपेतजननिर्घोषं प्रविवेश महावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2030861, "chapter_id": 1675, "verse_number": "३-३१३-४७", "content_sanskrit": "रुरुभिश्च वराहैश्च पक्षिभिश्च निषेवितम्।\nनीलभास्वरवर्णैश्च पादपैरुशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2030862, "chapter_id": 1675, "verse_number": "३-३१३-४८", "content_sanskrit": "भ्रमरैरुपगीतं च पक्षिभिश् समन्ततः।\n`मृदुशाड्वलसंकीर्णभूमिभागं मनोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2030863, "chapter_id": 1675, "verse_number": "३-३१३-४९", "content_sanskrit": "स गच्छन्कानने तस्मिन्हेमजालपरिष्कृतम्।\nददर्श तत्सरः श्रीमान्विश्वकर्मकृतं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2030864, "chapter_id": 1675, "verse_number": "३-३१३-५०", "content_sanskrit": "उपेतं नलिनीजालैः सिन्धुवारैः सचेतसैः।\nकेतकैः करवीरैश्च पिप्पलैश्चैव संवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2030865, "chapter_id": 1675, "verse_number": "३-३१३-५१", "content_sanskrit": "`ततो धर्मसुतः श्रीमान्भ्रातृदर्शनलालसः।\nश्रमार्तस्तदुपागम्य सरो दृष्ट्वाऽथ विस्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2030866, "chapter_id": 1675, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि आरणेयपर्वणि त्रयोदशाधिकत्रिशततमोऽध्यायः ॥ ३१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]