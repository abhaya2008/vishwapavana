[{"id": 7001103000, "chapter_id": 21103, "verse_number": "२-१-१४-१", "content_sanskrit": "ऋषय ऊचुः ।\nव्यासशिष्य महाभाग कथय त्वं प्रमाणतः ।\nकैः पुष्पैः पूजितश्शंभुः किं किं यच्छति वै फलम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001103001, "chapter_id": 21103, "verse_number": "२-१-१४-२", "content_sanskrit": "॥ सूत उवाच  ।\nशौनकाद्याश्च ऋषयः शृणुतादरतोऽखिलम् ।\nकथयाम्यद्य सुप्रीत्या पुष्पार्पणविनिर्णयम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001103002, "chapter_id": 21103, "verse_number": "२-१-१४-३", "content_sanskrit": "एष एव विधिः पृष्टो नारदेन महर्षिणा ।\nप्रोवाच परमप्रीत्या पुष्पार्पणविनिर्णयम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001103003, "chapter_id": 21103, "verse_number": "२-१-१४-४", "content_sanskrit": "ब्रह्मोवाच ।\nकमलैर्बिल्वपत्रैश्च शतपत्रैस्तथा पुनः ।\nशंखपुष्पैस्तथा देवं लक्ष्मीकामोऽर्चयेच्छिवम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001103004, "chapter_id": 21103, "verse_number": "२-१-१४-५", "content_sanskrit": "एतैश्च लक्षसंख्याकैः पूजितश्चेद्भवेच्छिवः ।\nपापहानिस्तथा विप्र लक्ष्मीस्स्यान्नात्र संशयः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001103005, "chapter_id": 21103, "verse_number": "२-१-१४-६", "content_sanskrit": "विंशतिः कमलानां तु प्रस्थमेकमुदाहृतम् ।\nबिल्वो दलसहस्रेण प्रस्थार्द्धं परिभाषितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001103006, "chapter_id": 21103, "verse_number": "२-१-१४-७", "content_sanskrit": "शतपत्रसहस्रेण प्रस्थार्द्धं परिभाषितम् ।\nपलैः षोडशभिः प्रत्थः पलं टंकदशस्मृतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001103007, "chapter_id": 21103, "verse_number": "२-१-१४-८", "content_sanskrit": "अनेनैव तु मानेन तुलामारोपयेद्यदा ।\nसर्वान्कामानवाप्नोति निष्कामश्चेच्छिवो भवेत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001103008, "chapter_id": 21103, "verse_number": "२-१-१४-९", "content_sanskrit": "राज्यस्य कामुको यो वै पार्थिवानां च पूजया ।\nतोषयेच्छंकरं देवं दशकोष्ट्या मुनीश्वराः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001103009, "chapter_id": 21103, "verse_number": "२-१-१४-१०", "content_sanskrit": "लिंगं शिवं तथा पुष्पमखण्डं तंदुलं तथा ।\nचर्चितं चंदनेनैव जलधारां तथा पुनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001103010, "chapter_id": 21103, "verse_number": "२-१-१४-११", "content_sanskrit": "प्रतिरूपं तथा मंत्रं बिल्वीदलमनुत्तमम् ।\nअथवा शतपत्रं च कमलं वा तथा पुनः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001103011, "chapter_id": 21103, "verse_number": "२-१-१४-१२", "content_sanskrit": "शंखपुष्पैस्तथा प्रोक्तं विशेषेण पुरातनैः ।\nसर्वकामफलं दिव्यं परत्रेहापि सर्वथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001103012, "chapter_id": 21103, "verse_number": "२-१-१४-१३", "content_sanskrit": "धूपं दीपं च नैवेद्यमर्घं चारार्तिक तथा ।\nप्रदक्षिणां नमस्कारं क्षमापनविसर्जने॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001103013, "chapter_id": 21103, "verse_number": "२-१-१४-१४", "content_sanskrit": "कृत्वा सांगं तथा भोज्यं कृतं येन भवेदिह ।\nतस्य वै सर्वथा राज्यं शंकरः प्रददाति च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001103014, "chapter_id": 21103, "verse_number": "२-१-१४-१५", "content_sanskrit": "प्रधान्यकामुको यो वै तदर्द्धेनार्चयेत्पुमान् ।\nकारागृहगतो यो वै लक्षेनैवार्चयेद्धनम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001103015, "chapter_id": 21103, "verse_number": "२-१-१४-१६", "content_sanskrit": "रोगग्रस्तो यदा स्याद्वै तदर्द्धेनार्चयेच्छिवम् ।\nकन्याकामो भवेद्यो वै तदर्द्धेन शिवं पुनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001103016, "chapter_id": 21103, "verse_number": "२-१-१४-१७", "content_sanskrit": "विद्याकामस्तथा यः स्यात्तदर्द्धेनार्चयेच्छिवम् ।\nवाणीकामो भवेद्यो वै घृतेनैवार्चयेच्छिवम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001103017, "chapter_id": 21103, "verse_number": "२-१-१४-१८", "content_sanskrit": "उच्चाटनार्थं शत्रूणां तन्मितेनैव पूजनम् ।\nमारणे वै तु लक्षेण मोहने तु तदर्धतः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001103018, "chapter_id": 21103, "verse_number": "२-१-१४-१९", "content_sanskrit": "सामंतानां जये चैव कोटिपूजा प्रशस्यते ।\nराज्ञामयुतसंख्यं च वशीकरणकर्मणि॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001103019, "chapter_id": 21103, "verse_number": "२-१-१४-२०", "content_sanskrit": "यशसे च तथा संख्या वाहनाद्यैः सहस्रिका ।\nमुक्तिकामोर्चयेच्छंभुं पंचकोट्या सुभक्तितः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001103020, "chapter_id": 21103, "verse_number": "२-१-१४-२१", "content_sanskrit": "ज्ञानार्थी पूजयेत्कोट्या शंकरं लोक शंकरम् ।\nशिवदर्शनकामो वै तदर्धेन प्रपूजयेत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001103021, "chapter_id": 21103, "verse_number": "२-१-१४-२२", "content_sanskrit": "तथा मृत्युंजयो जाप्यः कामनाफलरूपतः ।\nपंचलक्षा जपा यर्हि प्रत्यक्षं तु भवेच्छिवः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001103022, "chapter_id": 21103, "verse_number": "२-१-१४-२३", "content_sanskrit": "लक्षेण भजते कश्चिद्द्वितीये जातिसंभवः ।\nतृतीये कामनालाभश्चतुर्थे तं प्रपश्यति॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001103023, "chapter_id": 21103, "verse_number": "२-१-१४-२४", "content_sanskrit": "पंचमं च यदा लक्षं फलं यच्छत्यसंशयम् ।\nअनेनैव तु मंत्रेण दशलक्षे फलं भवेत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001103024, "chapter_id": 21103, "verse_number": "२-१-१४-२५", "content_sanskrit": "मुक्तिकामो भवेद्यो वै दर्भैश्च पूजनं चरेत् ।\nलक्षसंख्या तु सर्वत्र ज्ञातव्या ऋषिसत्तम॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001103025, "chapter_id": 21103, "verse_number": "२-१-१४-२६", "content_sanskrit": "आयुष्कामो भवेद्यो वै दूर्वाभिः पूजनश्चरेत् ।\nपुत्रकामो भवेद्यो वै धत्तूरकुसुमैश्चरेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001103026, "chapter_id": 21103, "verse_number": "२-१-१४-२७", "content_sanskrit": "रक्तदण्डश्च धत्तूरः पूजने शुभदः स्मृतः ।\nअगस्त्यकुसुमैश्चैव पूजकस्य महद्यशः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001103027, "chapter_id": 21103, "verse_number": "२-१-१४-२८", "content_sanskrit": "भुक्तिमुक्तिफलं तस्य तुलस्याः पूजयेद्यदि ।\nअर्कपुष्पैः प्रतापश्च कुब्जकल्हारकैस्तथा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001103028, "chapter_id": 21103, "verse_number": "२-१-१४-२९", "content_sanskrit": "जपाकुसुमपूजा तु शत्रूणां मृत्युदा स्मृता ।\nरोगोच्चाटनकानीह करवीराणि वै क्रमात्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001103029, "chapter_id": 21103, "verse_number": "२-१-१४-३०", "content_sanskrit": "बंधुकैर्भूषणावाप्तिर्जात्यावाहान्न संशयः ।\nअतसीपुष्पकैर्देवं विष्णुवल्लभतामियात्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001103030, "chapter_id": 21103, "verse_number": "२-१-१४-३१", "content_sanskrit": "शमीपत्रैस्तथा मुक्तिः प्राप्यते पुरुषेण च ।\nमल्लिकाकुसुमैर्दत्तैः स्त्रियं शुभतरां शिवः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001103031, "chapter_id": 21103, "verse_number": "२-१-१४-३२", "content_sanskrit": "यूथिकाकुसुमैश्शस्यैर्गृहं नैव विमुच्यते ।\nकर्णिकारैस्तथा वस्त्रसंपत्तिर्जायते नृणाम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001103032, "chapter_id": 21103, "verse_number": "२-१-१४-३३", "content_sanskrit": "निर्गुण्डीकुसुमैर्लोके मनो निर्मलतां व्रजेत् ।\nबिल्वपत्रैस्तथा लक्षैः सर्वान्कामानवाप्नुयात्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001103033, "chapter_id": 21103, "verse_number": "२-१-१४-३४", "content_sanskrit": "शृङ्गारहारपुष्पैस्तु वर्द्धते सुख सम्पदा ।\nऋतुजातानि पुष्पाणि मुक्तिदानि न संशयः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001103034, "chapter_id": 21103, "verse_number": "२-१-१४-३५", "content_sanskrit": "राजिकाकुसुमानीह शत्रूणां मृत्युदानि च ।\nएषां लक्षं शिवे दद्याद्दद्याच्च विपुलं फलम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001103035, "chapter_id": 21103, "verse_number": "२-१-१४-३६", "content_sanskrit": "विद्यते कुसुमं तन्न यन्नैव शिववल्लभम् ।\nचंपकं केतकं हित्वा त्वन्यत्सर्वं समर्पयेत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001103036, "chapter_id": 21103, "verse_number": "२-१-१४-३७", "content_sanskrit": "अतः परं च धान्यानां पूजने शंकरस्य च ।\nप्रमाणं च फलं सर्वं प्रीत्या शृणु च सत्तम॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001103037, "chapter_id": 21103, "verse_number": "२-१-१४-३८", "content_sanskrit": "तंदुलारोपणे नॄणां लक्ष्मी वृद्धिः प्रजायते ।\nअखण्डितविधौ विप्र सम्यग्भक्त्या शिवोपरि॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001103038, "chapter_id": 21103, "verse_number": "२-१-१४-३९", "content_sanskrit": "षट्केनैव तु प्रस्थानां तदर्धेन तथा पुनः ।\nपलद्वयं तथा लक्षमानेन समदाहृतम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001103039, "chapter_id": 21103, "verse_number": "२-१-१४-४०", "content_sanskrit": "पूजां रुद्रप्रधानेन कृत्वा वस्त्रं सुसुन्दरम् ।\nशिवोपरि न्यसेत्तत्र तंदुलार्पणमुत्तमम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001103040, "chapter_id": 21103, "verse_number": "२-१-१४-४१", "content_sanskrit": "उपरि श्रीफलं त्वेकं गंधपुष्पादिभिस्तथा ।\nरोपयित्वा च धूपादि कृत्वा पूजाफलं भवेत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001103041, "chapter_id": 21103, "verse_number": "२-१-१४-४२", "content_sanskrit": "प्रजापत्यद्वयं रौप्यमासंख्या च दक्षिणा ।\nदेया तदुपदेष्ट्रे हि शक्त्या वा दक्षिणा मता॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001103042, "chapter_id": 21103, "verse_number": "२-१-१४-४३", "content_sanskrit": "आदित्यसंख्यया तत्र ब्राह्मणान्भोजयेत्ततः ।\nलक्षपूजा तथा जाता साङ्गश्च मन्त्रपूर्वकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001103043, "chapter_id": 21103, "verse_number": "२-१-१४-४४", "content_sanskrit": "शतमष्टोत्तरं तत्र मंत्रे विधिरुदाहृतः ।\nतिलानां च पलं लक्षं महापातकनाशनम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001103044, "chapter_id": 21103, "verse_number": "२-१-१४-४५", "content_sanskrit": "एकादशपलैरेव लक्षमानमुदाहृतम् ।\nपूर्ववत्पूजनं तत्र कर्तव्यं हितकाम्यया॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001103045, "chapter_id": 21103, "verse_number": "२-१-१४-४६", "content_sanskrit": "भोज्या वै ब्राह्मणास्तस्मादत्र कार्या नरेण हि ।\nमहापातकजं दुखं तत्क्षणान्नश्यति ध्रुवम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001103046, "chapter_id": 21103, "verse_number": "२-१-१४-४७", "content_sanskrit": "यवपूजा तथा प्रोक्ता लक्षेण परमा शिवे ।\nप्रस्थानामष्टकं चैव तथा प्रस्थार्द्धकं पुनः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001103047, "chapter_id": 21103, "verse_number": "२-१-१४-४८", "content_sanskrit": "पलद्वययुतं तत्र मानमेतत्पुरातनम् ।\nयवपूजा च मुनिभिः स्वर्गसौख्यविवर्द्धिनी॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001103048, "chapter_id": 21103, "verse_number": "२-१-१४-४९", "content_sanskrit": "प्राजापत्यं ब्राह्मणानां कर्तव्यं च फलेप्सुभिः ।\nगोधूमान्नैस्तथा पूजा प्रशस्ता शंकरस्य वै॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001103049, "chapter_id": 21103, "verse_number": "२-१-१४-५०", "content_sanskrit": "संततिर्वर्द्धते तस्य यदि लक्षावधिः कृता ।\nद्रोणार्द्धेन भवेल्लक्षं विधानं विधिपूर्वकम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001103050, "chapter_id": 21103, "verse_number": "२-१-१४-५१", "content_sanskrit": "मुद्गानां पूजने देवः शिवो यच्छति वै सुखम् ।\nप्रस्थानां सप्तकेनैव प्रस्थार्द्धेनाथवा पुनः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001103051, "chapter_id": 21103, "verse_number": "२-१-१४-५२", "content_sanskrit": "पलद्वययुतेनैव लक्षमुक्तं पुरातनैः ।\nब्राह्मणाश्च तथा भोज्या रुद्रसंख्याप्रमाणतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001103052, "chapter_id": 21103, "verse_number": "२-१-१४-५३", "content_sanskrit": "प्रियंगुपूजनादेव धर्माध्यक्षे परात्मनि ।\nधर्मार्थकामा वर्द्धंते पूजा सर्वसुखावहा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001103053, "chapter_id": 21103, "verse_number": "२-१-१४-५४", "content_sanskrit": "प्रस्थैकेन च तस्योक्तं लक्षमेकं पुरातनैः ।\nब्रह्मभोजं तथा प्रोक्तमर्कसंख्याप्रमाणतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001103054, "chapter_id": 21103, "verse_number": "२-१-१४-५५", "content_sanskrit": "राजिकापूजनं शंभोश्शत्रोर्मृत्युकरं स्मृतम् ।\nसार्षपानां तथा लक्षं पलैर्विशतिसंख्यया॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001103055, "chapter_id": 21103, "verse_number": "२-१-१४-५६", "content_sanskrit": "तेषां च पूजनादेव शत्रोर्मृत्युरुदाहृतः ।\nआढकीनां दलैश्चैव शोभयित्वार्चयेच्छिवम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001103056, "chapter_id": 21103, "verse_number": "२-१-१४-५७", "content_sanskrit": "वृता गौश्च प्रदातव्या बलीवर्दस्तथैव च ।\nमरीचिसंभवा पूजा शत्रोर्नाशकरी स्मृता॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001103057, "chapter_id": 21103, "verse_number": "२-१-१४-५८", "content_sanskrit": "आढकीनां दलैश्चैव रंजयि त्वार्चयेच्छिवम् ।\nनानासुखकरी ह्येषा पूजा सर्वफलप्रदा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001103058, "chapter_id": 21103, "verse_number": "२-१-१४-५९", "content_sanskrit": "धान्यमानमिति प्रोक्तं मया ते मुनिसत्तम ।\nलक्षमानं तु पुष्पाणां शृणु प्रीत्या मुनीश्वर॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001103059, "chapter_id": 21103, "verse_number": "२-१-१४-६०", "content_sanskrit": "प्रस्थानां च तथा चैकं शंखपुष्पसमुद्भवम् ।\nप्रोक्तं व्यासेन लक्षं हि सूक्ष्ममानप्रदर्शिना॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001103060, "chapter_id": 21103, "verse_number": "२-१-१४-६१", "content_sanskrit": "प्रस्थैरेकादशैर्जातिलक्षमानं प्रकीर्तितम् ।\nयूथिकायास्तथा मानं राजिकायास्तदर्द्धकम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001103061, "chapter_id": 21103, "verse_number": "२-१-१४-६२", "content_sanskrit": "प्रस्थैर्विंशतिकैश्चैव मल्लिकामान मुत्तमम् ।\nतिलपुष्पैस्तथा मानं प्रस्थान्न्यूनं तथैव च॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001103062, "chapter_id": 21103, "verse_number": "२-१-१४-६३", "content_sanskrit": "ततश्च द्विगुणं मानं करवीरभवे स्मृतम् ।\nनिर्गुंडीकुसुमे मानं तथैव कथितं बुधैः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001103063, "chapter_id": 21103, "verse_number": "२-१-१४-६४", "content_sanskrit": "कर्णिकारे तथा मानं शिरीषकुसुमे पुनः ।\nबंधुजीवे तथा मानं प्रस्थानं दशकेन च॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001103064, "chapter_id": 21103, "verse_number": "२-१-१४-६५", "content_sanskrit": "इत्याद्यैर्विविधै मानं दृष्ट्वा कुर्याच्छिवार्चनम् ।\nसर्वकामसमृध्यर्थं मुक्त्यर्थं कामनोज्झितः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001103065, "chapter_id": 21103, "verse_number": "२-१-१४-६६", "content_sanskrit": "अतः परं प्रवक्ष्यामि धारापूजाफलं महत् ।\nयस्य श्रवणमात्रेण कल्याणं जायते नृणाम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001103066, "chapter_id": 21103, "verse_number": "२-१-१४-६७", "content_sanskrit": "विधानपूर्वकं पूजां कृत्वा भक्त्या शिवस्य वै ।\nपश्चाच्च जलधारा हि कर्तव्या भक्तितत्परैः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001103067, "chapter_id": 21103, "verse_number": "२-१-१४-६८", "content_sanskrit": "ज्वरप्रलापशांत्यर्थं जल धारा शुभावहा ।\nशतरुद्रियमंत्रेण रुद्रस्यैकादशेन तु॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001103068, "chapter_id": 21103, "verse_number": "२-१-१४-६९", "content_sanskrit": "रुद्रजाप्येन वा तत्र सूक्तेन् पौरुषेण वा ।\nषडंगेनाथ वा तत्र महामृत्युंजयेन च॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001103069, "chapter_id": 21103, "verse_number": "२-१-१४-७०", "content_sanskrit": "गायत्र्या वा नमोंतैश्च नामभिः प्रणवादिभिः ।\nमंत्रैवाथागमोक्तैश्च जलधारादिकं तथा॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001103070, "chapter_id": 21103, "verse_number": "२-१-१४-७१", "content_sanskrit": "सुखसंतानवृद्ध्यर्थं धारापूजनमुत्तमम् ।\nनानाद्रव्यैः शुभैर्दिव्यैः प्रीत्या सद्भस्मधारिणा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001103071, "chapter_id": 21103, "verse_number": "२-१-१४-७२", "content_sanskrit": "घृतधारा शिवे कार्या यावन्मंत्रसहस्रकम् ।\nतदा वंशस्य विस्तारो जायते नात्र संशयः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001103072, "chapter_id": 21103, "verse_number": "२-१-१४-७३", "content_sanskrit": "एवं मदुक्तमंत्रेण कार्यं वै शिवपूजनम् ।\nब्रह्मभोज्यं तथा प्रोक्तं प्राजापत्यं मुनीश्वरैः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001103073, "chapter_id": 21103, "verse_number": "२-१-१४-७४", "content_sanskrit": "केवलं दुग्धधारा च तदा कार्या विशेषतः ।\nशर्करामिश्रिता तत्र यदा बुद्धिजडो भवेत्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001103074, "chapter_id": 21103, "verse_number": "२-१-१४-७५", "content_sanskrit": "तस्या संजायते जीवसदृशी बुद्धिरुत्तमा ।\nयावन्मंत्रायुतं न स्यात्तावद्धाराप्रपूजनम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001103075, "chapter_id": 21103, "verse_number": "२-१-१४-७६", "content_sanskrit": "यदा चोच्चाटनं देहे जायते कारणं विना ।\nयत्र कुत्रापि वा प्रेम दुःखं च परिवर्द्धितम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001103076, "chapter_id": 21103, "verse_number": "२-१-१४-७७", "content_sanskrit": "स्वगृहे कलहो नित्यं यदा चैव प्रजायते ।\nतद्धारायां कृतायां वै सर्वं दुःखं विलीयते॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001103077, "chapter_id": 21103, "verse_number": "२-१-१४-७८", "content_sanskrit": "शत्रूणां तापनार्थं वै तैलधारा शिवोपरि ।\nकर्तव्या सुप्रयत्नेन कार्यसिद्धिर्धुवं भवेत्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001103078, "chapter_id": 21103, "verse_number": "२-१-१४-७९", "content_sanskrit": "मासि तेनैव तैलेन भोगवृद्धिः प्रजायते ।\nसार्षपेनैव तैलेन शत्रुनाशोभवेद्ध्रुवम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001103079, "chapter_id": 21103, "verse_number": "२-१-१४-८०", "content_sanskrit": "मधुना यक्षराजो वै गच्छेच्च शिवपूजनात ।\nधारा चेक्षुरसस्यापि सर्वानन्दकरी शिवे॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001103080, "chapter_id": 21103, "verse_number": "२-१-१४-८१", "content_sanskrit": "धारा गंगाजलस्यैव भुक्तिमुक्तिफलप्रदा ।\nएतास्सर्वाश्च याः प्रोक्ता मृत्यंजयसमुद्भवाः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001103081, "chapter_id": 21103, "verse_number": "२-१-१४-८२", "content_sanskrit": "तत्राऽयुतप्रमाणं हि कर्तव्यं तद्विधानतः ।\nकर्तव्यं ब्राह्मणानां च भोज्यं वै रुद्रसंख्यया॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001103082, "chapter_id": 21103, "verse_number": "२-१-१४-८३", "content_sanskrit": "एतत्ते सर्वमाख्यातं यत्पृष्टोऽहं मुनीश्वर ।\nएतद्वै सफलं लोके सर्वकामहितावहम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001103083, "chapter_id": 21103, "verse_number": "२-१-१४-८४", "content_sanskrit": "स्कंदोमासहितं शंभुं संपूज्य विधिना सह ।\nयत्फलं लभते भक्त्या तद्वदामि यथाश्रुतम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001103084, "chapter_id": 21103, "verse_number": "२-१-१४-८५", "content_sanskrit": "अत्र भुक्त्वाखिलं सौख्यं पुत्रपौत्रादिभिः शुभम् ।\nततो याति महेशस्य लोकं सर्वसुखावहम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001103085, "chapter_id": 21103, "verse_number": "२-१-१४-८६", "content_sanskrit": "सूर्यकोटिप्रतीकाशैर्विमानैः सर्वकामगैः ।\nरुद्रकन्यासमाकीर्णैर्गेयवाद्यसमन्वितैः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001103086, "chapter_id": 21103, "verse_number": "२-१-१४-८७", "content_sanskrit": "क्रीडते शिवभूतश्च यावदाभूतसंप्लवम् ।\nततो मोक्षमवाप्नोति विज्ञानं प्राप्य चाव्ययम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]