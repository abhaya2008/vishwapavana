[{"id": 2042126, "chapter_id": 1937, "verse_number": "५-१८२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042127, "chapter_id": 1937, "verse_number": "५-१८२-१", "content_sanskrit": "ततः प्रभाते राजेन्द्र सूर्ये विमलतां गते।\nभार्गवस्य मया सार्धं पुनर्युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042128, "chapter_id": 1937, "verse_number": "५-१८२-२", "content_sanskrit": "ततोऽभ्रान्ते रथे तिष्ठन्रामः प्रहरतां वरः।\nववर्ष शरजालानि मयि मेध इवाचले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042129, "chapter_id": 1937, "verse_number": "५-१८२-३", "content_sanskrit": "ततः सूतो मम सुहृच्छरवर्षेण ताडितः।\nअपयातो रथोपस्थान्मनो मम विषादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042130, "chapter_id": 1937, "verse_number": "५-१८२-४", "content_sanskrit": "ततः सूतो ममात्यर्थं कश्मलं प्राविशन्महत् ।\nपृथिव्यां च शराघातान्निपपात मुमोह च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042131, "chapter_id": 1937, "verse_number": "५-१८२-५", "content_sanskrit": "ततः सूतो जहात्प्राणान्रामबाणप्रपीडितः।\nमुहूर्तादिव राजेन्द्र मां च भीराविशत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042132, "chapter_id": 1937, "verse_number": "५-१८२-६", "content_sanskrit": "ततः सूते हते तस्मिन्क्षिपतस्तस्य मे शरान् ।\nप्रमत्तमनसो रामः प्राहिणोन्मृत्युसंमितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042133, "chapter_id": 1937, "verse_number": "५-१८२-७", "content_sanskrit": "ततः सूतव्यसनिनं विप्लुतं मां स भार्गवः ।\nशरेणाभ्यहनद्गाढं विकृष्य बलवद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042134, "chapter_id": 1937, "verse_number": "५-१८२-८", "content_sanskrit": "स मे भुजान्तरे राजन्निपत्य रुधिराशनः।\nमयैव सह राजेन्द्र जगाम वसुधातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042135, "chapter_id": 1937, "verse_number": "५-१८२-९", "content_sanskrit": "मत्वा तु निहतं रामस्ततो मां भरतर्षभ ।\nमेघवद्विननादोच्चैर्जहृषे च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042136, "chapter_id": 1937, "verse_number": "५-१८२-१०", "content_sanskrit": "तथा तु पतिते राजन्मयि रामो मुदा युतः।\nउदक्रोशन्महानादं सह तैरनुयायिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042137, "chapter_id": 1937, "verse_number": "५-१८२-११", "content_sanskrit": "मम तत्राभवन्ये तु कुरवः पार्श्वतः स्थिताः ।\nआगता अपि युद्धं तञ्जनास्तत्र दिदृक्षवः ।\nआर्तिं परमिकां जग्मुस्ते तदा पतिते मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042138, "chapter_id": 1937, "verse_number": "५-१८२-१२", "content_sanskrit": "ततोऽपश्यं पतितो राजसिंह\nद्विजानष्टौ सूर्यहुताशनाभान् ।\nते मां समन्तात्परिर्वाय तस्थुः\nस्वबाहुभिः परिधार्याजिमध्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042139, "chapter_id": 1937, "verse_number": "५-१८२-१३", "content_sanskrit": "रक्ष्यमाणश्च तैर्विप्रैर्नाहं भूमिमुपास्पृशम् ।\nअन्तरिक्षे धृतो ह्यस्मि तैर्विप्रैर्बान्धवैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042140, "chapter_id": 1937, "verse_number": "५-१८२-१४", "content_sanskrit": "श्वसन्निवान्तरिक्षे च जलबिन्दुभिरुक्षितः ।\nततस्ते ब्राह्मणा राजन्नब्रुवन्परिगृह्य माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042141, "chapter_id": 1937, "verse_number": "५-१८२-१५", "content_sanskrit": "मा भैरिति समं सर्वे स्वस्ति तेऽस्त्विति चासकृत्।\nततस्तेषामहं वाग्भिस्तर्पितः सहसोत्थितः ।\nमातरं सरितां श्रेष्ठामपश्यं रथमास्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042142, "chapter_id": 1937, "verse_number": "५-१८२-१६", "content_sanskrit": "हयाश्च मे संगृहीतास्तयाऽऽस-\nन्महानद्या संयति कौरवेन्द्र।\nपादौ जनन्याः प्रतिगृह्य चाहं\nतथा पितॄणां रथमभ्यरोहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042143, "chapter_id": 1937, "verse_number": "५-१८२-१७", "content_sanskrit": "ररक्ष सा मां सरथं हयांश्चोपस्काराणि च।\nतामहं प्राञ्जलिर्भूत्वा पुनरेव व्यसर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042144, "chapter_id": 1937, "verse_number": "५-१८२-१८", "content_sanskrit": "ततोऽहं स्वयमुद्यम्य हयांस्तान्वातरंहसः।\nअयुध्यं जामदग्न्येन निवृत्तेऽहनि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042145, "chapter_id": 1937, "verse_number": "५-१८२-१९", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ वेगवन्तं महाबलम् ।\nअमुञ्चं समरे बाणं रामाय हृदयच्छिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042146, "chapter_id": 1937, "verse_number": "५-१८२-२०", "content_sanskrit": "ततो जगाम वसुधां मम बाणप्रपीडितः ।\nजानुभ्यां धनुरुत्सृज्य रामो मोहवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042147, "chapter_id": 1937, "verse_number": "५-१८२-२१", "content_sanskrit": "ततस्तस्मिन्निपतिते रामे भूरिसहस्रदे ।\nआवव्रुर्जलदा व्योम क्षरन्तो रुधिरं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042148, "chapter_id": 1937, "verse_number": "५-१८२-२२", "content_sanskrit": "उल्काश्च शतशः पेतुः सनिर्घाताः सकम्पनाः। ५-१८२-२२bअर्कं च सहसा दीप्तं स्वर्भानुरभिसंवृणोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042149, "chapter_id": 1937, "verse_number": "५-१८२-२३", "content_sanskrit": "ववुश्च वाताः परुषाश्चलिता च वसुंधरा ।\nगृध्रा बलाश्च कङ्काश्च परिपेतुर्गुदा युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042150, "chapter_id": 1937, "verse_number": "५-१८२-२४", "content_sanskrit": "दीप्तायां दिशि गोमायुर्दारुणं मुहुरुन्नदत् ।\nअनाहता दुन्दुभयो विनेदुर्भृशनिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042151, "chapter_id": 1937, "verse_number": "५-१८२-२५", "content_sanskrit": "एतदौत्पातिकं सर्वं घोरमासीद्भयंकरम् ।\nविसंज्ञकल्पे धरणीं गते रामे महात्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042152, "chapter_id": 1937, "verse_number": "५-१८२-२६", "content_sanskrit": "ततो वै सहसोत्थाय रामो मामभ्यवर्तत ।\nपुनर्युद्धाय कौरव्य विह्वलः क्रोधमूर्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042153, "chapter_id": 1937, "verse_number": "५-१८२-२७", "content_sanskrit": "आददानो महाबाहुः कार्मुकं तालसन्निभम् ।\nततो मय्याददानं तं राममेव न्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042154, "chapter_id": 1937, "verse_number": "५-१८२-२८", "content_sanskrit": "महर्षयः कृपायुक्ताः क्रोधाविष्टोऽपि भार्गवः ।\nसमाहरदमेयात्मा शरं कालानलोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042155, "chapter_id": 1937, "verse_number": "५-१८२-२९", "content_sanskrit": "सतो रविर्मन्दमरीचिमण्डलो\nजगामास्तं पांसुपुञ्जावगूढः\nनिशा व्यगाहत्सुखशीतमारुता\nततो युद्धं प्रत्यवहारयाव- ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042156, "chapter_id": 1937, "verse_number": "५-१८२-३०", "content_sanskrit": "एवं राजन्नवहारो बभूव\nततः पुनर्विमलेऽभूत्सुघोरम्।\nकल्यंकल्यं विंशतिं वै दिनानि\nतथैव चान्यानि दिनानि त्रीणि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042157, "chapter_id": 1937, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि द्व्यशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]