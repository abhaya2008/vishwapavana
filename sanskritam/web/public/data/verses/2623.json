[{"id": 2076552, "chapter_id": 2623, "verse_number": "१२-१२८-०x", "content_sanskrit": "राजोवचा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076553, "chapter_id": 2623, "verse_number": "१२-१२८-१", "content_sanskrit": "वीरद्युम्न इति ख्यातो राजाऽहं दिक्षु विश्रुतः।\nभूरिद्युम्नं सुतं नष्टमन्वेष्टुं वनमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076554, "chapter_id": 2623, "verse_number": "१२-१२८-२", "content_sanskrit": "एकः पुत्रः स विप्राग्र्य बाल एव च सोऽनघः।\nन दृश्यते वने चास्मिंस्तमन्वेष्टुं चराम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076555, "chapter_id": 2623, "verse_number": "१२-१२८-३x", "content_sanskrit": "ऋषभ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076556, "chapter_id": 2623, "verse_number": "१२-१२८-३", "content_sanskrit": "इत्युक्ते तेन वचने राज्ञा मुनिरधोमुखः।\nतूष्णीमेवाभवत्तत्र न च प्रत्युक्तवान्नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076557, "chapter_id": 2623, "verse_number": "१२-१२८-४", "content_sanskrit": "स हि तेन पुरा विप्रो राज्ञा नात्यर्थमानितः।\nआशाकृतश्च राजेन्द्र तपो दीर्घं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076558, "chapter_id": 2623, "verse_number": "१२-१२८-५", "content_sanskrit": "प्रतिग्रहमहं राज्ञां न करिष्ये कथंचन।\nअन्येषां चैव वर्णानामिति कृत्वा धियं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076559, "chapter_id": 2623, "verse_number": "१२-१२८-६", "content_sanskrit": "आशा हि पुरुषं बालमालापयति तस्थूषी।\nतामहं व्यपनेष्यामि इति कृत्वा व्यवस्थितः।\n[वीरद्युम्नस्तु तं भूयः पप्रच्छ मुनिसत्तमम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076560, "chapter_id": 2623, "verse_number": "१२-१२८-७x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076561, "chapter_id": 2623, "verse_number": "१२-१२८-७", "content_sanskrit": "आशायाः किंच वृत्तं वै किंचेह भुवि दुर्लभम्।\nब्रवीतु भगवानेतत्त्वं हि धर्मार्थदर्शिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076562, "chapter_id": 2623, "verse_number": "१२-१२८-८x", "content_sanskrit": "ऋषभ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076563, "chapter_id": 2623, "verse_number": "१२-१२८-८", "content_sanskrit": "ततः संस्मृत्य तत्सर्वं स्मारयिष्यन्निवाब्रवीत्।\nराजानं भगवान्विप्रस्ततः कृशतनुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076564, "chapter_id": 2623, "verse_number": "१२-१२८-९x", "content_sanskrit": "ऋषिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076565, "chapter_id": 2623, "verse_number": "१२-१२८-९", "content_sanskrit": "कृशत्वेन समं राजन्नाशाया विद्यते नृप।\nतस्या वै दुर्लभत्वाच्च प्रार्थितः पार्थिवो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076566, "chapter_id": 2623, "verse_number": "१२-१२८-१०x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076567, "chapter_id": 2623, "verse_number": "१२-१२८-१०", "content_sanskrit": "कृशाकृशे मया ब्रह्मन्गृहीते वचनात्तव।\nदुर्लभत्वं च तस्यैव वेदवाक्यमिवाद्विजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076568, "chapter_id": 2623, "verse_number": "१२-१२८-११", "content_sanskrit": "संशयस्तु महाप्राज्ञ संजातो हृदये मम।\nतन्मुने मम तत्त्वेन वक्तुमर्हसि पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076569, "chapter_id": 2623, "verse_number": "१२-१२८-१२", "content_sanskrit": "त्वत्तः कृशतरं किंनु ब्रवीतु भगवानिदम्।\nयदि गुह्यं न ते विप्र लोके किंचेह दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076570, "chapter_id": 2623, "verse_number": "१२-१२८-१३x", "content_sanskrit": "कृश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076571, "chapter_id": 2623, "verse_number": "१२-१२८-१३", "content_sanskrit": "दुर्लभोऽप्यथवा नास्ति योऽर्थी धृतिमवाप्नुयात्।\nस दुर्लभतरस्तात योऽर्थिनं नावमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076572, "chapter_id": 2623, "verse_number": "१२-१२८-१४", "content_sanskrit": "सत्कृत्य नोपक्रियते परं शक्त्या यथार्थतः।\nया सक्ता सर्वभूतेषु साऽऽशा कृशतरी मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076573, "chapter_id": 2623, "verse_number": "१२-१२८-१५", "content_sanskrit": "कृतघ्नेषु च या सक्ता नृशंसेष्वलसेषु च।\nअपकारिषु चासक्ता साऽऽशा कृशतरी मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076574, "chapter_id": 2623, "verse_number": "१२-१२८-१६", "content_sanskrit": "एकपुत्रः पिता पुत्रे नष्टे वा प्रोषितेऽपि वा।\nप्रवृत्तिं यो न जानाति साऽऽशा कृशतरी मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076575, "chapter_id": 2623, "verse_number": "१२-१२८-१७", "content_sanskrit": "प्रसवे चैव नारीणां वृद्धानां पुत्रकारिता।\nतथा नरेन्द्र धनिनां साऽशा कृशतरी मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076576, "chapter_id": 2623, "verse_number": "१२-१२८-१८", "content_sanskrit": "प्रदानकाङ्क्षिणीनां च कन्यानां वयसि स्थिते।\nश्रुत्वा कथास्तथायुक्ताः साऽऽशा कृशतरी मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076577, "chapter_id": 2623, "verse_number": "१२-१२८-१९", "content_sanskrit": "एतच्छ्रुत्वा ततो राजन्स राजा सावरोधनः।\nसंस्पृश्य पादौ शिरसा निपपात द्विजर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076578, "chapter_id": 2623, "verse_number": "१२-१२८-२०x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076579, "chapter_id": 2623, "verse_number": "१२-१२८-२०", "content_sanskrit": "प्रसादये त्वां भगवन्पुत्रेणेच्छामि संगमम्।\nयदेतदुक्तं भवता संप्रति द्विजसत्तम।\nवृणीष्व च वरान्विप्र यानिच्छसि यथाविधि।\nअब्रवीच्चैव तद्वाक्यं राजा राजीवलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076580, "chapter_id": 2623, "verse_number": "१२-१२८-२१", "content_sanskrit": "सत्यमेतत्त्वया विप्र यथोक्तं नान्यथा मृषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076581, "chapter_id": 2623, "verse_number": "१२-१२८-२२", "content_sanskrit": "ततः प्रहस्य भगवांस्तनुर्धर्मभृतां वरः।\nपुत्रमस्यानयत्क्षिप्रं तपसा च श्रुतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076582, "chapter_id": 2623, "verse_number": "१२-१२८-२३", "content_sanskrit": "स समानीय तत्पुत्रं तमुपालभ्य पार्थिवम्।\nआत्मानं दर्शयामास धर्मं धर्मभृतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2076583, "chapter_id": 2623, "verse_number": "१२-१२८-२४", "content_sanskrit": "स दर्शयित्वा चात्मानं दिव्यमद्भुतदर्शनम्।\nविपाप्मा विगतक्रोधश्चचार वनमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2076584, "chapter_id": 2623, "verse_number": "१२-१२८-२५", "content_sanskrit": "एतदॄष्टं मया राजंस्त्वत्तश्च वचनं श्रुतम्।\nआशामपनय त्वाशु ततः कृषतरीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2076585, "chapter_id": 2623, "verse_number": "१२-१२८-२६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2076586, "chapter_id": 2623, "verse_number": "१२-१२८-२६", "content_sanskrit": "स तथोक्तस्तदा राजन्नृषभेण महात्मना।\nसुमित्रोऽपानयत्क्षिप्रमाशां कृशतरीं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2076587, "chapter_id": 2623, "verse_number": "१२-१२८-२७", "content_sanskrit": "एवं त्वमपि कौन्तेय श्रुत्वा वाणीमिमां मम।\nस्थिरो भव महाराज हिमवानिव निश्चलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2076588, "chapter_id": 2623, "verse_number": "१२-१२८-२८", "content_sanskrit": "त्वं हि श्रुत्वा च पृष्ट्वा च कृच्छ्रेष्वर्थेषु तेष्विह।\nश्रुत्वा मम महाराज न संतप्तुमिहार्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2076589, "chapter_id": 2623, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टाविंशत्यधिकशततमोऽध्यायः॥ १२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]