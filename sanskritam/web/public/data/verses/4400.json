[{"id": 2156765, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2156766, "chapter_id": 4400, "verse_number": "१", "content_sanskrit": "रथस्थं पुरुषव्याघ्रं दृष्ट्वा कर्णमवस्थितम् ।\nहृष्टो दुर्योधनो राजा कर्णं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2156767, "chapter_id": 4400, "verse_number": "२", "content_sanskrit": "सनाथमिव मन्येऽहं भवता पालितं बलम् ।\nमन्ये किन्तु तदेतद् वै यद्धितं तत् प्रधार्यताम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2156768, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2156769, "chapter_id": 4400, "verse_number": "३", "content_sanskrit": "ब्रूहि तत् पुरुषव्याघ्र त्वं हि प्राज्ञतमो नृषु ।\nयथा चार्थपतिः कृत्यं पश्यते न तथेतरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2156770, "chapter_id": 4400, "verse_number": "४", "content_sanskrit": "वयं सर्वे तव वचः श्रोतुकामा नरेश्वर ।\nनान्याय्यं हि भवान् वाक्यं ब्रूयादिति मतिर्मम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2156771, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2156772, "chapter_id": 4400, "verse_number": "५", "content_sanskrit": "भीष्मः सेनाप्रणेताऽऽसीद् वयसा विक्रमेण च ।\nश्रुतेन च सुसम्पन्नः सर्वैर्योधगणैः सह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2156773, "chapter_id": 4400, "verse_number": "६", "content_sanskrit": "तेनातिरथिना कर्ण घ्नता शत्रुगणान् मम ।\nसुयुद्धेन दशाहानि पालिताः स्म महात्मना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2156774, "chapter_id": 4400, "verse_number": "७", "content_sanskrit": "तस्मिन्नसुकरं कर्म कृतवत्यास्थिते दिवम् ।\nकं नु सेनाप्रणेतारं मन्यसे तदनन्तरम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2156775, "chapter_id": 4400, "verse_number": "८", "content_sanskrit": "ऋते तु नायकं सेना मुहूर्तं नावतिष्ठते ।\nआहवेषु विशेषेण भ्रष्टनेत्रेष्विवाञ्जनम्\nआहवेष्वाहवश्रेष्ठ नेतृहीनेव नौर्जले\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2156776, "chapter_id": 4400, "verse_number": "१०", "content_sanskrit": "यथा ह्यकर्णधारा नौ रथश्चासारथिर्यथा ।\nद्रवेद् यथेष्टं तद्वत् स्याद् ऋते सेनापतेर्बलम्\t॥९॥\nअदेशिके यथा सार्थः सर्वं कृच्छ्रं समृच्छति ।\nअनायकी तथा सेना सर्वान् दोषान् समृच्छति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2156777, "chapter_id": 4400, "verse_number": "११", "content_sanskrit": "स भवान् वीक्ष्य सर्वेषु मामकेषु महात्मसु ।\nपश्य सेनापतिं युक्तम् अनुशास्तु भवानिह\nयं हि सेनाप्रणेतारं मन्यसे तदनन्तरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2156778, "chapter_id": 4400, "verse_number": "१२", "content_sanskrit": "यं हि सेनाप्रणेतारं भवान् वक्ष्यति संयुगे ।\nतं वयं सहिताः सर्वे प्रकरिष्याम नायकम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2156779, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2156780, "chapter_id": 4400, "verse_number": "१३", "content_sanskrit": "सर्व एव महात्मान इमे पुरुषसत्तमाः ।\nसेनापतित्वमर्हन्ति नात्र कार्या विचारणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2156781, "chapter_id": 4400, "verse_number": "१४", "content_sanskrit": "कुलसंहननज्ञानबलविक्रमबुद्धिभिः ।\nयुक्ताः कृतज्ञा ह्रीमन्त आहवेष्वनिवर्तिनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2156782, "chapter_id": 4400, "verse_number": "१५", "content_sanskrit": "युगपन्न तु ते शक्याः कर्तुं सर्वे पुरस्सराः ।\nएक एवात्र कर्तव्यो यस्मिन् वैशेषिका गुणाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2156783, "chapter_id": 4400, "verse_number": "१६", "content_sanskrit": "अन्योन्यस्पर्धिनां तेषां यद्येकं त्वं करिष्यसि ।\nशेषा विमनसोऽत्यर्थं न योत्स्यन्तीह भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2156784, "chapter_id": 4400, "verse_number": "१७", "content_sanskrit": "अयं तु सर्वसैन्यानामाचार्यः स्थविरो गुरुः ।\nयुक्तः सेनापतित्वाय द्रोणः शस्त्रभृतां वरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2156785, "chapter_id": 4400, "verse_number": "१८", "content_sanskrit": "को हि तिष्ठति सङ्ग्रामे द्रोणे ब्राह्मणपुङ्गवे ।\nसेनापतिरिहान्योऽस्माच्छुक्राङ्गिरसदर्शनात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2156786, "chapter_id": 4400, "verse_number": "१९", "content_sanskrit": "नच स ह्यस्ति योधस्ते सर्वराजसु भारत ।\nयो द्रोणं समरं यान्तमनुयास्यति संयुगे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2156787, "chapter_id": 4400, "verse_number": "२०", "content_sanskrit": "एष सेनाप्रणेतॄणामेष शस्त्रभृतां वरः ।\nएष बुद्धिमतां श्रेष्ठो ब्राह्मणः स्थविरो गुरुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2156788, "chapter_id": 4400, "verse_number": "२१", "content_sanskrit": "एनं दुर्योधनाचार्यमाशु सेनापतिं कुरु ।\nजिगीषन्तोऽसुरान् सङ्खे कर्त्तिकेयमिवामराः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2156789, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2156790, "chapter_id": 4400, "verse_number": "२२", "content_sanskrit": "कर्णस्य वचनं श्रुत्वा राजा दुर्योधनस्तदा ।\nसेनामध्यगतं द्रोणमिदं वचनमब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2156791, "chapter_id": 4400, "verse_number": "२३", "content_sanskrit": "वर्णश्रैष्ठ्यात् कुलोत्पत्त्या श्रुतेन वयसा धिया ।\nवीर्याद् दाक्ष्यादधृष्यत्वादर्थज्ञानान्नयान्वयात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2156792, "chapter_id": 4400, "verse_number": "२४", "content_sanskrit": "तपसा च कृतज्ञत्वाद् वृद्धः सर्वगुणैस्तथा ।\nयुक्तो भवत्समो गोप्ता राज्ञामन्यो न विद्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2156793, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "स भवान् पातु नः सर्वान् विबुधानिव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2156794, "chapter_id": 4400, "verse_number": "२५", "content_sanskrit": "त्वया नेत्रा परान् जेतुमिच्छामो द्विजसत्तम ।\nरुद्राणामिव कापालिर्वसूनामिव पावकः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2156795, "chapter_id": 4400, "verse_number": "२६", "content_sanskrit": "कुबेर इव यक्षाणां मरुतामिव वासवः ।\nवसिष्ठ इव विप्राणां तेजसामिव भास्करः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2156796, "chapter_id": 4400, "verse_number": "२७", "content_sanskrit": "पितॄणामिव धर्मोऽथ आदित्यानामिवाम्बुराट् ।\nनक्षत्राणामिव शशी वीरुधामंशुमानिव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2156797, "chapter_id": 4400, "verse_number": "२८", "content_sanskrit": "सर्वेषामिव लोकानां विश्वस्य च यथा क्षयः ।\nविश्वोत्पत्तिस्थितिश्चैव श्रेष्ठो नारायणः प्रभुः\nएवं सेनाप्रणेतॄणां मम सेनापतिर्भव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2156798, "chapter_id": 4400, "verse_number": "२९", "content_sanskrit": "एकादशेमा वशगा अक्षोहिण्यस्तवानघ ।\nताभिः शत्रून् प्रतिव्यूह्य जहीन्द्रो दितिजानिव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2156799, "chapter_id": 4400, "verse_number": "३०", "content_sanskrit": "प्रयातु स भवानग्रे देवानामिव पावकिः ।\nअनुयास्यामहे त्वाऽऽजौ सौरभेया इवर्षभम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2156800, "chapter_id": 4400, "verse_number": "३१", "content_sanskrit": "उग्रधन्वा महेष्वासो दिव्यं विष्फारयन् धनुः ।\nदृष्ट्वा भवन्तं सङ्ग्रामे नार्जुनः प्रसहिष्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2156801, "chapter_id": 4400, "verse_number": "३२", "content_sanskrit": "ध्रुवं युधिष्ठिरं सङ्खे ससैन्यं सहबान्धवम् ।\nजेतास्मि पुरुषव्याघ्र भवान् सेनापतिर्यदि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2156802, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2156803, "chapter_id": 4400, "verse_number": "३३", "content_sanskrit": "एवमुक्ते ततो द्रोणे जयेत्यूचुर्नराधिपाः ।\nसिंहनादेन संहृष्टा हर्षयन्तस्तवात्मजम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2156804, "chapter_id": 4400, "verse_number": "३४", "content_sanskrit": "सैनिकाश्च मुदा युक्ता वर्धयन्तो द्विजोत्तमम् ।\nदुर्योधनं पुरस्कृत्य प्रार्थयन्तो महद् यशः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2156805, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2156806, "chapter_id": 4400, "verse_number": "३५", "content_sanskrit": "वेदान् षडङ्गान् वेदाहमर्थविद्यां च मानवीम् ।\nत्रैय्यम्बकमथेष्वस्त्रमस्त्राणि विविधानि च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2156807, "chapter_id": 4400, "verse_number": "३६", "content_sanskrit": "ये चाप्युक्ता मयि गुणा भवद्भिर्जयकाङ्क्षिभिः ।\nचिकीर्षंस्तानहं सत्यान् योधयिष्यामि पाण्डवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2156808, "chapter_id": 4400, "verse_number": "३७", "content_sanskrit": "पार्षतं तु रणे राजन् न हनिष्ये कथञ्चन ।\nस हि सृष्टो वधार्थाय ममैव पुरुषर्षभः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2156809, "chapter_id": 4400, "verse_number": "३८", "content_sanskrit": "योधयिष्यामि सैन्यानि नाशयन् सर्वसोमकान् ।\nन च मां पाण्डवा युद्धे योधयिष्यन्ति हर्षिताः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2156810, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2156811, "chapter_id": 4400, "verse_number": "३९", "content_sanskrit": "एवमुक्तोऽभ्यनुज्ञातः चक्रे सेनापतिं तदा ।\nद्रोणं तव सुतो राजन् विधिदृष्टेन कर्मणा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2156812, "chapter_id": 4400, "verse_number": "४०", "content_sanskrit": "तथाऽभिषिषिचुर्द्रोणं दुर्योधनमुखा नृपाः॥\nयथा सेनापतिं स्कन्दं पुरा शक्रमुखाः सुराः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2156813, "chapter_id": 4400, "verse_number": "४१", "content_sanskrit": "ततो वादित्रघोषेण शङ्खानां च महास्वनैः ।\nप्रादुरासीत् ततो द्रोणे कृते सेनापतौ रवः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2156814, "chapter_id": 4400, "verse_number": "४२", "content_sanskrit": "ततः पुण्याहघोषेण साशीर्वादस्वनेन च ।\nसूतमागधवन्दीनां संस्तवैर्गीतमङ्गलैः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2156815, "chapter_id": 4400, "verse_number": "", "content_sanskrit": "जयशब्दैर्मनोज्ञैश्च नर्तनैस्तत्र तं प्रति ।\nसत्कृत्य विधिवद् द्रोणं जितान् मन्यन्त पाण्डवान्\t।४३।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2156816, "chapter_id": 4400, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि पञ्चमोऽध्यायः ॥ ५ ॥\nद्रोणाभिषेकपर्वणि पञ्चमोऽध्यायः ॥ ५ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]