[{"id": 50019540, "chapter_id": 11642, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50019541, "chapter_id": 11642, "verse_number": "2", "content_sanskrit": "अयुते द्वे शतान्यष्टौ लीलया युधि निर्जिताः। विनिर्गता गिरिद्रोण्यां मलिनो मलवाससः॥ १०/८१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50019542, "chapter_id": 11642, "verse_number": "3", "content_sanskrit": "क्षुत्क्षामाः शुष्कवदनाः संरोधपरिकर्शिताः। ददृशुस्ते घनश्यामं पीतकौशेयवाससम्॥ १०/८१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50019543, "chapter_id": 11642, "verse_number": "4", "content_sanskrit": "श्रीवत्साङ्कं चतुर्बाहुं पदम्पत्रनिभेक्षणम्। चारुप्रसन्नवदनं स्फुरन्मकरकुण्डलम्॥ १०/८१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50019544, "chapter_id": 11642, "verse_number": "5", "content_sanskrit": "पदम्हस्तं गदाशङ्खरथाङ्गैरुपलक्षितम्। किरीटहारकटककटिसूत्राङ्गदान्वितम्॥ १०/८१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50019545, "chapter_id": 11642, "verse_number": "6", "content_sanskrit": "भ्राजद्वरमणिग्रीवं निवीतं वनमालया। पिबन्त इव चक्षुर्भ्यां लिहन्त इव जिह्वया॥ १०/८१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50019546, "chapter_id": 11642, "verse_number": "7", "content_sanskrit": "जिघ्रन्त इव नासाभ्यामीहन्त इव चेतसा। प्रणेमुर्हतपाप्मानो मूर्धभिः पादयोर्हरेः॥ १०/८१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50019547, "chapter_id": 11642, "verse_number": "8", "content_sanskrit": "कृष्णसन्दर्शनाह्लादध्वस्तसंरोधनक्ल्माः। प्रशशंसुर्हृषीकेशं गीर्भिः प्राञ्जलयो नृपाः॥ १०/८१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50019548, "chapter_id": 11642, "verse_number": "9", "content_sanskrit": "राजान ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50019549, "chapter_id": 11642, "verse_number": "10", "content_sanskrit": "नमस्ते देवदेवेश प्रपन्नार्तिहराव्यय। प्रपन्नान् पाहि नः कृष्ण निर्विण्णान् घोरसंसृतेः॥ १०/८१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50019550, "chapter_id": 11642, "verse_number": "11", "content_sanskrit": "नैव नाथाभ्यसूयामो मागधं मधुसूदन। अनुग्रहो यद् भवतो राज्ञां राज्यच्युतिर्विभो॥ १०/८१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50019551, "chapter_id": 11642, "verse_number": "12", "content_sanskrit": "राज्यैश्वर्यमदोन्नध्दा न श्रेयो विन्दते नृपाः। त्वन्मायामोहिता नित्या मन्यन्ते सम्पदश्चलाः॥ १०/८१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50019552, "chapter_id": 11642, "verse_number": "13", "content_sanskrit": "मृगतृष्णां यथा बाला मन्यन्ते उदकाशयम्। एवं वैकारिकां मायामयुक्ता वस्तु चक्षते॥ १०/८१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50019553, "chapter_id": 11642, "verse_number": "14", "content_sanskrit": "वयं पुरा श्रीमदनष्टबुद्धयो जिहीर्षयाऽस्या इतरेतरस्पृधः। घ्नन्तः प्रजाः स्वा अपि निर्घृणाः प्रभो मृत्युं पुरस्त्वामगणय्य दुर्मदाः॥ १०/८१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50019554, "chapter_id": 11642, "verse_number": "15", "content_sanskrit": "त एव कृष्णाद्य गभीररंहसा दुरन्तवीर्येण विचालिताः श्रियः। कालेन तद् वै भवतोऽनुकम्पया विनष्टदर्पाश्चरणौ स्मरामहे॥ १०/८१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50019555, "chapter_id": 11642, "verse_number": "16", "content_sanskrit": "अतो न राज्यं मृगतृष्णरूपितं देहेन शश्वत् पतता रजोभुवा। उपासितव्यं स्पृहयामहे विभो क्रियाफलं प्रेत्य च कर्णरोचनम्॥ १०/८१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50019556, "chapter_id": 11642, "verse_number": "17", "content_sanskrit": "तन्नः समादिशोपायं येन ते चरणाब्जयोः। स्मृतिर्यथा न विरमेदपि संसरतामिह॥ १०/८१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50019557, "chapter_id": 11642, "verse_number": "18", "content_sanskrit": "कृष्णाय वासुदेवाय हरये परमात्मने। प्रणतक्लेशनाशाय गोविन्दाय नमो नमः॥ १०/८१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50019558, "chapter_id": 11642, "verse_number": "19", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50019559, "chapter_id": 11642, "verse_number": "20", "content_sanskrit": "संस्तूयमानो भगवान् राजभिर्मुक्तबन्धनैः। तानाह करुणस्तात शरण्यः श्लक्ष्णया गिरा॥ १०/८१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50019560, "chapter_id": 11642, "verse_number": "21", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50019561, "chapter_id": 11642, "verse_number": "22", "content_sanskrit": "अद्य प्रभृति वो भूपा मय्यात्मन्यखिलेश्वरे। सुदृढा जायते भक्तिर्बाढमाशंसितं तथा॥ १०/८१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50019562, "chapter_id": 11642, "verse_number": "23", "content_sanskrit": "दिष्ट्या व्यवसितं भूपा भवन्त ऋतभाषिणः। श्रियैश्वर्यमदोन्नाहं पश्यतोन्मादनं नृणाम्॥ १०/८१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50019563, "chapter_id": 11642, "verse_number": "24", "content_sanskrit": "हैहयो नहुषो वेनो रावणो नरकोऽपरे। श्रीमदाद् ध्वंसिताः स्थानाद् देवदैत्यनरेश्वराः॥ १०/८१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50019564, "chapter_id": 11642, "verse_number": "25", "content_sanskrit": "सञ्चिन्तयत विज्ञाय देहाद्युत्पाद्यमन्तवत्। मां यजन्तोऽध्वरैर्यत्ताः प्रजा धर्मेण रक्षत॥ १०/८१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50019565, "chapter_id": 11642, "verse_number": "26", "content_sanskrit": "सन्तन्वन्तः प्रजातन्तून् सुखदुःखे भवाभवौ। प्राप्तंप्राप्तं च सेवन्तो मच्चित्ता विचरिष्यथ॥ १०/८१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50019566, "chapter_id": 11642, "verse_number": "27", "content_sanskrit": "उदासीनाश्च देहादावात्मारामा धृतव्रताः। मय्यावेश्य मनः सम्यङ् मामन्ते ब्रह्म यास्यथ॥ १०/८१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50019567, "chapter_id": 11642, "verse_number": "28", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50019568, "chapter_id": 11642, "verse_number": "29", "content_sanskrit": "इत्यादिश्य नृपान् कृष्णो भगवान् भुवनेश्वरः। तेषां न्ययुङ्क्त पुरुषान् स्त्रियो मज्जनकर्मणि॥ १०/८१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50019569, "chapter_id": 11642, "verse_number": "30", "content_sanskrit": "सपर्यां कारयामास सहदेवेन भारत। नरदेवोचितैर्वस्त्रैर्भूषणैः स्रग्विलेपनैः॥ १०/८१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50019570, "chapter_id": 11642, "verse_number": "31", "content_sanskrit": "भोजयित्वा वरान्नेन सुस्नातान् समलङ्कृतान्। भोगैश्च विविधैर्भुक्तान् ताम्बूलाद्यैर्नृपोचितैः॥ १०/८१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50019571, "chapter_id": 11642, "verse_number": "32", "content_sanskrit": "ते पूजिता मुकुन्देन राजानो मृष्टकुण्डलाः। विरेजुर्मोचिताः क्लेशात् प्रावृडन्ते यथा ग्रहाः॥ १०/८१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50019572, "chapter_id": 11642, "verse_number": "33", "content_sanskrit": "रथान् सदश्वानारोप्य मणिकाञ्चनभूषितान्। प्रीणय्य सूनृतैर्वाक्यैः स्वदेशान् प्रत्ययापयत्॥ १०/८१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50019573, "chapter_id": 11642, "verse_number": "34", "content_sanskrit": "त एवं मोचिताः कृच्छ्रात् कृष्णेन सुमहात्मना। ययुस्तमेव ध्यायन्तः कृतानि च जगत्पतेः॥ १०/८१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50019574, "chapter_id": 11642, "verse_number": "35", "content_sanskrit": "जगदुः प्रकृतिभ्यस्ते महापुरुषचेष्टितम्। यथाऽन्वशासद् भगवान् तथा चक्रुरतन्द्रिताः॥ १०/८१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50019575, "chapter_id": 11642, "verse_number": "36", "content_sanskrit": "जरासन्धं घातयित्वा भीमसेनेन केशवः। पार्थाभ्यां संयुतः प्रायात् सहदेवेन पूजितः॥ १०/८१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50019576, "chapter_id": 11642, "verse_number": "37", "content_sanskrit": "ते गत्वा खाण्डवप्रस्थं शङ्खान् दध्मुर्जितारयः। हर्षयन्तः स्वसुहृदो दुर्हृदां चासुखावहाः॥ १०/८१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50019577, "chapter_id": 11642, "verse_number": "38", "content_sanskrit": "अभिवाद्याथ राजानं भीमार्जुनजनार्दनाः। सर्वमाश्रावयाञ्चक्रुरात्मना यदनुष्ठितम्॥ १०/८१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50019578, "chapter_id": 11642, "verse_number": "39", "content_sanskrit": "निशम्य धर्मराजस्तु केशवेनानुकम्पितः। आनन्दाश्रुकणान् मुञ्चन् प्रेम्णा नोवाच किञ्चन॥ १०/८१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50019579, "chapter_id": 11642, "verse_number": "40", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे एकाशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]