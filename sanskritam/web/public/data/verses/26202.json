[{"id": 7006202000, "chapter_id": 26202, "verse_number": "२-३०-१", "content_sanskrit": "वासिष्ठ उवाच श्रुस्वैतत्सकलं राजा जमदग्निवधादिकम् ।\nउद्विग्नचेताः सुभृशं चिन्तयामास नैकधा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006202001, "chapter_id": 26202, "verse_number": "२-३०-२", "content_sanskrit": "अहो मे सुनृसंसस्य लोकयोरुभयोरपि ।\nब्रह्मस्वहरणे वाञ्छा तद्धत्या चातिगर्हिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006202002, "chapter_id": 26202, "verse_number": "२-३०-३", "content_sanskrit": "अहो नाश्रौषमस्याहं ब्राह्मणस्य विजानतः ।\nवचनं तर्हि तां जह्यां विमूढात्मा गतत्रपः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006202003, "chapter_id": 26202, "verse_number": "२-३०-४", "content_sanskrit": "इति संचितयन्नंव हृदयेन विदूयता ।\nस्वपुरं प्रतिचक्राम सबलः सानुगस्ततः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006202004, "chapter_id": 26202, "verse_number": "२-३०-५", "content_sanskrit": "पुरीं प्रतिगते राज्ञि तस्मिन्सपरिवारके ।\nआश्रमात्सहसा राजन्विनिश्चक्राम रेणुका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006202005, "chapter_id": 26202, "verse_number": "२-३०-६", "content_sanskrit": "अथ सक्षतसर्वाङ्गं रुधिरेण परिप्लुतम् ।\nनिश्चेष्टं परितं भूमौ ददर्श पतिमात्मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006202006, "chapter_id": 26202, "verse_number": "२-३०-७", "content_sanskrit": "ततः सा विहतं मत्वा भर्त्तारं गतचेतनम् ।\nअन्वाहतेवाशनिना मूर्छितान्यपतद्भुवि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006202007, "chapter_id": 26202, "verse_number": "२-३०-८", "content_sanskrit": "चिरादिव पुनर्भूमेरुत्थायातीव दुःखिता ।\nपतित्वोत्थाय सा भूयः सुस्वरं प्ररुरोद ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006202008, "chapter_id": 26202, "verse_number": "२-३०-९", "content_sanskrit": "विललाप च सात्यर्थं धरणीधूलिधूसरा ।\nअश्रुपूर्ममुखी दीना पतिता शोकसागरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006202009, "chapter_id": 26202, "verse_number": "२-३०-१०", "content_sanskrit": "हा नाथ पिय धर्मज्ञ दाक्षिण्यामृतसागर ।\nहा धिगत्यन्तशान्त त्वं नैव काङ्क्षेत चेदृशम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006202010, "chapter_id": 26202, "verse_number": "२-३०-११", "content_sanskrit": "आश्रमादभिनिष्क्रान्तः सहसा व्यसानर्णवे ।\nक्षिप्त्वानाथामगाधे मां क्व च यातोऽसि मानद ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006202011, "chapter_id": 26202, "verse_number": "२-३०-१२", "content_sanskrit": "सतां साप्तपदे मैत्रे मुषिताहं त्वया सह ।\nयासि यत्र त्वमेकाकी तत्र मां नेतुमर्हसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006202012, "chapter_id": 26202, "verse_number": "२-३०-१३", "content_sanskrit": "दृष्ट्वा त्वामीदृशावस्थमचिराद्धृदयं मम ।\nन दीर्यते महाभाग कठिनाः खलु योषितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006202013, "chapter_id": 26202, "verse_number": "२-३०-१४", "content_sanskrit": "इत्येवं विलपन्ती सा रुदती च मुहुर्मुहुः ।\nचुक्रोश रामरामेति भृशं दुःखपरिप्लुता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006202014, "chapter_id": 26202, "verse_number": "२-३०-१५", "content_sanskrit": "तावद्रामोऽपि स वनात्समिद्भारसमन्वितः ।\nअकृतव्रणसंयुक्तः स्वाश्रमाय न्यवर्त्तत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006202015, "chapter_id": 26202, "verse_number": "२-३०-१६", "content_sanskrit": "अपश्यद्भयशंसीनि निमित्तानि बहूनि सः ।\nपश्यन्नुद्विग्नहृदयस्तूर्णं प्रापाश्रमं विभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006202016, "chapter_id": 26202, "verse_number": "२-३०-१७", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य रुदती सा भृशातुरा ।\nनविभूतेव शोकेन प्रारुदद्रेणुका पुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006202017, "chapter_id": 26202, "verse_number": "२-३०-१८", "content_sanskrit": "रामस्य पुरतो राजन्भर्तृव्यसनपीडिता ।\nउभाभ्यामपि हस्ताभ्यामुदरं समताडयत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006202018, "chapter_id": 26202, "verse_number": "२-३०-१९", "content_sanskrit": "मार्गे विदितवृत्तान्तः सम्यग्रामोऽपि मातरम् ।\nकुररीमिव शोकार्त्ता दृष्ट्वा दुःखमुपेयिवान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006202019, "chapter_id": 26202, "verse_number": "२-३०-२०", "content_sanskrit": "धैर्यमारोप्य मेधावी दुःशशोकपरिप्लुतः ।\nनेत्राभ्यामश्रुपूर्णाभ्यां तस्थौ भूमावर्धोमुखः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006202020, "chapter_id": 26202, "verse_number": "२-३०-२१", "content_sanskrit": "तं तथागतमालोक्य रामं प्राहाकृतव्रणः ।\nकिमिदं भृगुशार्दूल नैतत्वय्युपपाद्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006202021, "chapter_id": 26202, "verse_number": "२-३०-२२", "content_sanskrit": "न त्वादृशा महाभाग भृशं शोचन्ति कुत्रचित् ।\nधृतिमन्तो महान्तस्तु दुःखं कुर्वति न व्यये ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006202022, "chapter_id": 26202, "verse_number": "२-३०-२३", "content_sanskrit": "शोकः सर्वेन्द्रियाणां हि परिशोषप्रदायकः ।\nत्यज शोकं महाबाहो न तत्पात्रं भवदृशाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006202023, "chapter_id": 26202, "verse_number": "२-३०-२४", "content_sanskrit": "एहिकामुष्मिकार्थानां नूनमेकान्तरोधकः ।\nशोकस्तस्यावकाशं त्वं कथं त्दृदि नियच्छसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006202024, "chapter_id": 26202, "verse_number": "२-३०-२५", "content_sanskrit": "तत्त्वं धैर्यधनो भूत्वा परिसांत्वय मातरम् ।\nरुदतीं बत वैधव्यशं कापहतचेतनाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006202025, "chapter_id": 26202, "verse_number": "२-३०-२६", "content_sanskrit": "नैवागमनमस्तीह व्यतिक्रान्तस्य वस्तुनः ।\nतस्मादतीतमखिलं त्यक्त्वा कृत्यं विचिन्तय ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006202026, "chapter_id": 26202, "verse_number": "२-३०-२७", "content_sanskrit": "इत्येवं सांत्वमानश्च तेन दुःशसमन्वितः ।\nरामः संस्तंभयामास शनैरात्मानमात्मना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006202027, "chapter_id": 26202, "verse_number": "२-३०-२८", "content_sanskrit": "दुःखशोकपरीता हि रेणुका त्वरुदन्मुहः ।\nत्रिःसप्तकृत्वो हस्ताभ्यामुदरं समताडयत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006202028, "chapter_id": 26202, "verse_number": "२-३०-२९", "content_sanskrit": "तावत्तदन्तिकं रामः समभ्येत्याश्रुलोचनः ।\nरुदतीमलमंबेति सांत्वयामास मातरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006202029, "chapter_id": 26202, "verse_number": "२-३०-३०", "content_sanskrit": "उवाचापनयन्दुःखाद्भर्तृशोकपरायणाम् ।\nत्रिःसप्तकृत्वो यदिदं त्वया वक्षः समाहतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006202030, "chapter_id": 26202, "verse_number": "२-३०-३१", "content_sanskrit": "तावतसंख्यमहं तस्मात्क्षत्त्रजारमशेषतः ।\nहनिष्ये भुवि सर्वत्र सत्यमेतद्ब्रविमि ते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006202031, "chapter_id": 26202, "verse_number": "२-३०-३२", "content_sanskrit": "तस्मात्त्वं शोकमुत्सृज्य धैर्यमातिष्ट सांप्रतम् ।\nनास्त्येव नूनमायातमतिक्रान्तस्य वस्तुनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006202032, "chapter_id": 26202, "verse_number": "२-३०-३३", "content_sanskrit": "इत्युक्ता रेणुका तेन भृशं दुःखान्वितापि सा ।\nकृच्छ्राद्धैर्यं समालंब्य तथेति प्रत्यभाषत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006202033, "chapter_id": 26202, "verse_number": "२-३०-३४", "content_sanskrit": "ततो रामो महाबाहुः पितुः सह सहोदरैः ।\nअग्नौ सत्कर्त्तुमारेभे देहं राजन्यथविधि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006202034, "chapter_id": 26202, "verse_number": "२-३०-३५", "content_sanskrit": "भर्तृशोकपरिताङ्गी रेणुकापि दृढव्रता ।\nपुत्रान्सर्वान्समाहूय त्विदं वचनमब्रवीत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006202035, "chapter_id": 26202, "verse_number": "२-३०-३६", "content_sanskrit": "रेणुकोवाच ।\nअहं वपितरं पुत्राः स्वर्गतं पुण्यशीलिनम् ।\nअनुगन्तुमिहेच्छामि तन्मेऽनुज्ञातुमर्हथ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006202036, "chapter_id": 26202, "verse_number": "२-३०-३७", "content_sanskrit": "असह्यदुःशं वैधव्यं सहमाना कथं पुनः ।\nभर्त्रा विरहिता तेन प्रवर्त्तिष्ये विनिन्दिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006202037, "chapter_id": 26202, "verse_number": "२-३०-३८", "content_sanskrit": "तस्मादनुगमिष्यामि भर्त्तारं दयितं मम ।\nयथा तेन प्रवर्त्तिष्ये परत्रापि सहानिशम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006202038, "chapter_id": 26202, "verse_number": "२-३०-३९", "content_sanskrit": "ज्वलन्तमिममेवाग्निं संप्रविश्य चिरादिव ।\nभर्तुर्मम भविष्यामि पितृलोकप्रियातिथिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006202039, "chapter_id": 26202, "verse_number": "२-३०-४०", "content_sanskrit": "अनुवादमृते पुत्रा भवद्भिस्तत्र कर्मणि ।\nप्रतिभूय न वक्तव्यं यदि मत्प्रियमिच्छथ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006202040, "chapter_id": 26202, "verse_number": "२-३०-४१", "content_sanskrit": "इत्येवमुक्त्वा वचनं रेणुका दृढनिश्चया ।\nअग्निं प्रविश्य भर्त्तारमनुगन्तुं मनोदधे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006202041, "chapter_id": 26202, "verse_number": "२-३०-४२", "content_sanskrit": "एतस्मिन्नेव काले तु रेणुकां तनयैः सह ।\nसमाभाष्यातिगंभीरा वागुवाचाशरीरीणी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006202042, "chapter_id": 26202, "verse_number": "२-३०-४३", "content_sanskrit": "हे रेणुके स्वतनयैर्गिरं मेऽवहिता शृणु ।\nमा कार्षीः साहसं भद्रे प्रवक्ष्यामि प्रियं तव ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006202043, "chapter_id": 26202, "verse_number": "२-३०-४४", "content_sanskrit": "साहसो नैव कर्त्तव्यः केनाप्यात्महितैषिणा ।\nन मर्त्तव्यन्त्वया सर्वो जीवन्भद्राणि पश्यति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006202044, "chapter_id": 26202, "verse_number": "२-३०-४५", "content_sanskrit": "तस्माद्धैर्यधना भूत्वा भव त्वं कालकाङ्क्षिणी ।\nनिमित्तमन्तरीकृत्य किञ्चिदेव शुचिस्मिते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006202045, "chapter_id": 26202, "verse_number": "२-३०-४६", "content_sanskrit": "अचिरेणैव भर्त्ता ते भविष्यति सचेतनः ।\nउत्पन्नजीवितेन त्वं कामं प्राप्स्यसि शोभने ।\nभवित्री चिररात्राय बहुकल्याण भाजनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006202046, "chapter_id": 26202, "verse_number": "२-३०-४७", "content_sanskrit": "वसिष्ठ उवाच इति तद्वचनं श्रुत्वा धृतिमालंब्य रेणुका ।\nतद्वाक्यगौरवाद्धर्षमवापुस्तनयाश्च ते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006202047, "chapter_id": 26202, "verse_number": "२-३०-४८", "content_sanskrit": "ततोनीत्वा पितुर्देहमाश्रमाभ्यन्तरं मुनेः ।\nशाययित्वा निवाते तु परितः समुपाविशन् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006202048, "chapter_id": 26202, "verse_number": "२-३०-४९", "content_sanskrit": "तेषां तत्रोपविष्टानामप्रहृष्टात्मचेतसाम् ।\nनिमत्तानि शुभान्यासन्ननेकानि महान्ति च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006202049, "chapter_id": 26202, "verse_number": "२-३०-५०", "content_sanskrit": "तेन ते किञ्चिदाश्वस्तचेतसो मुनिपुङ्गवाः ।\nनिषेदुः सहिता मात्रा काङ्क्षन्तो जीवितं पितुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006202050, "chapter_id": 26202, "verse_number": "२-३०-५१", "content_sanskrit": "एतस्मिन्नन्तरे राजन्भृगुवंशधरो मुनिः ।\nविधेर्बलेन मतिमांस्तत्रागच्छद्यदृच्छया ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006202051, "chapter_id": 26202, "verse_number": "२-३०-५२", "content_sanskrit": "अथर्वणां विधिः सा क्षाद्वेदवेदाङ्गपारगः ।\nसर्वशास्त्रार्थवित्प्राज्ञः सकलासुरवन्दितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006202052, "chapter_id": 26202, "verse_number": "२-३०-५३", "content_sanskrit": "मृतसंजीविनीं विद्यां यो वेद मुनिदुर्लभाम् ।\nयथाहतान्मृतान्देवैरुत्थापयति दानवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006202053, "chapter_id": 26202, "verse_number": "२-३०-५४", "content_sanskrit": "शास्त्रमोशनसं येन राज्ञां राज्यफलप्रदम् ।\nप्रणीतमनुजीवन्ति सर्वेऽद्यापीह पार्थिवाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006202054, "chapter_id": 26202, "verse_number": "२-३०-५५", "content_sanskrit": "स तदाश्रममासाद्य प्रविष्टोऽन्तर्महामुनिः ।\nददर्श तदवस्थांस्तान्सर्वान्दुःखपरिप्लुतान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006202055, "chapter_id": 26202, "verse_number": "२-३०-५६", "content_sanskrit": "अथ ते तु भृगुं दृष्ट्वा वंशम्य पितरं मुदा ।\nउत्थायास्मै ददुश्चापि सत्कृत्य परमासनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006202056, "chapter_id": 26202, "verse_number": "२-३०-५७", "content_sanskrit": "स चाशीर्भिस्तु तान्सर्वानभिनन्द्य महामुनिः ।\nपप्रच्छ किमिदं वृत्तं तत्सर्वं ते न्यवेदयन् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006202057, "chapter_id": 26202, "verse_number": "२-३०-५८", "content_sanskrit": "तच्छ्रुत्वा स भृगुः शीघ्रं जलमादाय मन्त्रवित् ।\nसंजीविन्या विनया तं सिषेच प्रोच्चरन्निदम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006202058, "chapter_id": 26202, "verse_number": "२-३०-५९", "content_sanskrit": "यज्ञस्य तपसो वीय ममापि शुभमस्ति चेत् ।\nतेनासौ जीवताच्छीघ्रं प्रसुप्त इवचोत्थितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006202059, "chapter_id": 26202, "verse_number": "२-३०-६०", "content_sanskrit": "एवमुक्ते शुभे वाक्ये भृगुणा साधुकारिणा ।\nसमुत्तस्थावथार्चीकः साक्षाद्ग्ररुरिवापरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006202060, "chapter_id": 26202, "verse_number": "२-३०-६१", "content_sanskrit": "दृष्ट्वा तत्र स्थितं वन्द्यं भृगुं स्वस्य पितामहम् ।\nननाम भक्त्या नृपते कृताञ्जलिरुवाच ह ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006202061, "chapter_id": 26202, "verse_number": "२-३०-६२", "content_sanskrit": "जमदग्निरुवाच धन्योऽहं कृतकृत्योऽहं सफलं जीवितं च मे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006202062, "chapter_id": 26202, "verse_number": "२-३०-६३", "content_sanskrit": "यत्पश्ये चरणौ तेऽद्य सुरासुरनमस्कृतौ ।\nभगवन्किं करोम्यद्य शुश्रूषां तव मानद ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006202063, "chapter_id": 26202, "verse_number": "२-३०-६४", "content_sanskrit": "पुनीह्यात्मकुलं स्वस्य चरणांबुकणैर्विभो ।\nइत्युक्त्वा सहसाऽनीतं रामेणार्ध्यं मुदान्वितः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006202064, "chapter_id": 26202, "verse_number": "२-३०-६५", "content_sanskrit": "प्रददौ पादयोस्तस्य भक्त्यान मितकन्धरः ।\nतज्जलं शिरसाधत्त सकुटुंबो महामनाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006202065, "chapter_id": 26202, "verse_number": "२-३०-६६", "content_sanskrit": "अथ सत्कृत्य स भृगुं पप्रच्छ विनयान्वितः ।\nभगवन् किं कृतं तेन राज्ञा दुष्टेन पातकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006202066, "chapter_id": 26202, "verse_number": "२-३०-६७", "content_sanskrit": "यस्यातिथ्यं हि कृतवानहं सम्यग्विधानतः ।\nसाधुबुद्ध्यास दुष्टात्मा किं चकार महामते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006202067, "chapter_id": 26202, "verse_number": "२-३०-६८", "content_sanskrit": "वसिष्ठ उवाच एवं स पृष्टो मतिमान्भृगुः सर्वविदीश्वरः ।\nचिरं ध्यात्वा समालोच्य कारणं प्राह भूपते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006202068, "chapter_id": 26202, "verse_number": "२-३०-६९", "content_sanskrit": "भृगुरुवाच शृणु तात महाभाग बीजमस्य हि कर्मणः ।\nयश्च वै कृतवान्पापं सर्वज्ञस्य तवानघ ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006202069, "chapter_id": 26202, "verse_number": "२-३०-७०", "content_sanskrit": "शप्तः पुरा वसिष्ठेन नाशार्थं स महीपतिः ।\nद्विजापराधतो मूढ वीर्यं ते विनशिष्यते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006202070, "chapter_id": 26202, "verse_number": "२-३०-७१", "content_sanskrit": "तत्कथं वचनं तस्य भविष्यत्यन्यथा मुनेः ।\nअयं रामो महावीर्यं प्रसह्यनृपपुङ्गवम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006202071, "chapter_id": 26202, "verse_number": "२-३०-७२", "content_sanskrit": "हनिष्यति महाबाहो प्रतिज्ञां कृतवान्पुरा ।\nयस्मादुरः प्रतिहतं त्वया मातर्ममाग्रतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006202072, "chapter_id": 26202, "verse_number": "२-३०-७३", "content_sanskrit": "एकविंशतिवारं हि भृशं दुःखपरीतया ।\nत्रिः सप्तकृत्वो निःक्षत्रां करिष्ये पृथिवीमिमाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006202073, "chapter_id": 26202, "verse_number": "२-३०-७४", "content_sanskrit": "अतोऽयं वार्यमाणोऽपि त्वाया पित्रा निरन्तरम् ।\nभाविनोर्ऽथस्य च बलात्करिष्यत्येव मानद ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006202074, "chapter_id": 26202, "verse_number": "२-३०-७५", "content_sanskrit": "स तु राजा महाभागो वृद्धानां पर्युपासिता ।\nदत्तात्रेयाद्धरेरंशाल्लब्धबोधो महामतिः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006202075, "chapter_id": 26202, "verse_number": "२-३०-७६", "content_sanskrit": "साक्षाद्भक्तो महात्मा च तद्वधे पातकं भवेत् ।\nएवमुक्त्वा महाराज स भृगुर्ब्रह्मणः सुतः ।\nयथागतं ययौ विद्वान्भविष्यत्कालपर्ययात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]