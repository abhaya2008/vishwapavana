[{"id": 2095161, "chapter_id": 3032, "verse_number": "१३-१६२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकथं ज्येष्ठः कनिष्ठेषु वर्तेत भरतर्षभ।\nकनिष्ठाश्च यथा ज्येष्ठे वर्तेरंस्तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095162, "chapter_id": 3032, "verse_number": "१३-१६२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095163, "chapter_id": 3032, "verse_number": "१३-१६२-२", "content_sanskrit": "ज्येष्ठवत्तात वर्तस्व ज्येष्ठोसि हि तथा भवान्।\nगुरोर्गरीयसी वृत्तिर्या च शिष्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095164, "chapter_id": 3032, "verse_number": "१३-१६२-३", "content_sanskrit": "न गुरावकृतप्रज्ञे शक्यं शिष्येण वर्तितुम्।\nगुरौ हि सदृशी वृत्तिर्यथा शिष्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095165, "chapter_id": 3032, "verse_number": "१३-१६२-४", "content_sanskrit": "अन्धः स्यादन्धवेलायां जडः स्यादपि वा बुधः।\nपरिहारेण तद्ब्रूयाद्यस्तेषां स्याद्व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095166, "chapter_id": 3032, "verse_number": "१३-१६२-५", "content_sanskrit": "प्रत्यक्षं भिन्नहृदया भेदयेयुर्यथाऽहिताः।\n`श्रियाऽभितप्तास्तद्भेदान्नभिन्नाः स्युः समाहिताः\nश्रियाऽभितप्ताः कौन्तेय भेदकामास्तथाऽरयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095167, "chapter_id": 3032, "verse_number": "१३-१६२-६", "content_sanskrit": "ज्येष्ठः कुलं वर्धयति विनाशयति वा पुनः।\nहन्ति सर्वमपि ज्येष्ठः प्रायो दुर्विनयादिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095168, "chapter_id": 3032, "verse_number": "१३-१६२-७", "content_sanskrit": "अथ यो विनिकुर्वीत ज्येष्ठो भ्राता यवीयसः।\nअज्येष्ठः स्यादभागश्च नियम्यो राजभिश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095169, "chapter_id": 3032, "verse_number": "१३-१६२-८", "content_sanskrit": "निकृती हि नरो लोकान्पापान्गच्छत्यसंशयम्।\nविफलं तस्य पुत्रत्वं मोघं जनयितुः स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095170, "chapter_id": 3032, "verse_number": "१३-१६२-९", "content_sanskrit": "पित्रोरनर्थायक कुले जायते पापपूरुषः।\nअकीर्तिं जनयत्येव कीर्तिमन्तर्दधाति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095171, "chapter_id": 3032, "verse_number": "१३-१६२-१०", "content_sanskrit": "सर्वे चापि विकर्मस्था भागं नार्हन्ति सोदराः।\nज्येष्ठोऽपि दुर्विनीतस्तु कनिष्ठस्तु विशेषतः।\nनाप्रदाय कनिष्ठेभ्यो ज्येष्ठः कुर्वीत वेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095172, "chapter_id": 3032, "verse_number": "१३-१६२-११", "content_sanskrit": "अनुजस्य पितुर्दायो जङ्घाश्रमफलोऽध्वगः।\nस्वयमीहेत लब्धं तु नाकामो दातुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095173, "chapter_id": 3032, "verse_number": "१३-१६२-१२", "content_sanskrit": "भ्रातॄणामविभक्तानामुत्थानमपि चेत्सह।\nन पुत्रभागं विषमं पिता दद्यात्कदाचन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095174, "chapter_id": 3032, "verse_number": "१३-१६२-१३", "content_sanskrit": "न ज्येष्ठो वाऽवमन्येत दुष्कृतः सुकृतोऽपि वा।\nगुरूणामपराधो हि शक्यः क्षन्तव्य एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095175, "chapter_id": 3032, "verse_number": "१३-१६२-१४", "content_sanskrit": "यदि स्त्री यद्यवरज श्रेयः पश्येत्तदाचरेत्।\nधर्मार्थः श्रेय इत्याहुस्त्रयो ज्ञाता विधायकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095176, "chapter_id": 3032, "verse_number": "१३-१६२-१५", "content_sanskrit": "दशाचार्यानुपाध्याय उपाध्यायान्पिता दश।\nदश चैव पितॄन्माता सर्वां वा पृथिवीमपि।\nगौरवेणाभिभवति नास्ति मातृसमो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095177, "chapter_id": 3032, "verse_number": "१३-१६२-१६", "content_sanskrit": "माता गरीयसी यच्च तेनैतां मन्यते गुरुम्।\nज्येष्ठो भ्राता पितृसमो मृते पितरि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095178, "chapter_id": 3032, "verse_number": "१३-१६२-१७", "content_sanskrit": "स ह्येषां वृत्तिदाता स्यात्स चैतान्प्रतिपालयेत्।\nकनिष्ठास्तं नमस्येरन्सर्वे छन्दानुवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095179, "chapter_id": 3032, "verse_number": "१३-१६२-१८", "content_sanskrit": "तमेव चोपजीवेरन्यथैव पितरं तथा।\nशरीरमेतौ सृजतः पिता मता च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095180, "chapter_id": 3032, "verse_number": "१३-१६२-१९", "content_sanskrit": "आचार्यशिष्टा या जातिः सा सत्या साऽजरामरा।\nज्येष्ठा मातृसमा चापि भगिनी भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095181, "chapter_id": 3032, "verse_number": "१३-१६२-२०", "content_sanskrit": "भ्रातुर्भार्या च तद्वत्स्याद्यस्या बाल्ये स्तनं पिबेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095182, "chapter_id": 3032, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विषष्ट्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]