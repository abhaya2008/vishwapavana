[{"id": 7001091000, "chapter_id": 21091, "verse_number": "२-१-२-१", "content_sanskrit": "सूत उवाच ।\nएतस्मिन्समये विप्रा नारदो मुनिसत्तमः ।\nब्रह्मपुत्रो विनीतात्मा तपोर्थं मन आदधे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001091001, "chapter_id": 21091, "verse_number": "२-१-२-२", "content_sanskrit": "हिमशैलगुहा काचिदेका परमशोभना ।\nयत्समीपे सुरनदी सदा वहति वेगतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001091002, "chapter_id": 21091, "verse_number": "२-१-२-३", "content_sanskrit": "तत्राश्रमो महादिव्यो नानाशोभासमन्वितः ।\nतपोर्थं स ययौ तत्र नारदो दिव्यदर्शनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001091003, "chapter_id": 21091, "verse_number": "२-१-२-४", "content_sanskrit": "तां दृष्ट्वा मुनिशार्दूलस्तेपे स सुचिरं तपः ।\nबध्वासनं दृढं मौनी प्राणानायम्य शुद्धधीः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001091004, "chapter_id": 21091, "verse_number": "२-१-२-५", "content_sanskrit": "चक्रे मुनिस्समाधिं तमहम्ब्रह्मेति यत्र ह ।\nविज्ञानं भवति ब्रह्मसाक्षात्कारकरं द्विजाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001091005, "chapter_id": 21091, "verse_number": "२-१-२-६", "content_sanskrit": "इत्थं तपति तस्मिन्वै नारदे मुनिसत्तमे ।\nचकंपेऽथ शुनासीरो मनस्संतापविह्वलः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001091006, "chapter_id": 21091, "verse_number": "२-१-२-७", "content_sanskrit": "मनसीति विचिंत्यासौ मुनिर्मे राज्यमिच्छति ।\nतद्विघ्नकरणार्थं हि हरिर्यत्नमियेष सः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001091007, "chapter_id": 21091, "verse_number": "२-१-२-८", "content_sanskrit": "सस्मार स्मरं शक्रश्चेतसा देवनायकः ।\nआजगाम द्रुतं कामस्समधीर्महिषीसुतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001091008, "chapter_id": 21091, "verse_number": "२-१-२-९", "content_sanskrit": "अथागतं स्मरं दृष्ट्वा संबोध्य सुरराट् प्रभुः ।\nउवाच तं प्रपश्याशु स्वार्थे कुटिलशेमुषिः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001091009, "chapter_id": 21091, "verse_number": "२-१-२-१०", "content_sanskrit": "इन्द्र उवाच ।\nमित्रवर्य्य महावीर सर्वदा हितकारक ।\nशृणु प्रीत्या वचो मे त्वं कुरु साहाय्यमात्मना॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001091010, "chapter_id": 21091, "verse_number": "२-१-२-११", "content_sanskrit": "त्वद्बलान्मे बहूनाञ्च तपोगर्वो विनाशितः ।\nमद्राज्यस्थिरता मित्र त्वदनुग्रहतस्सदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001091011, "chapter_id": 21091, "verse_number": "२-१-२-१२", "content_sanskrit": "हिमशैलगुहायां हि मुनिस्तपति नारदः ।\nमनसोद्दिश्य विश्वेशं महासंयमवान्दृढः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001091012, "chapter_id": 21091, "verse_number": "२-१-२-१३", "content_sanskrit": "याचेन्न विधितो राज्यं स ममेति विशंकितः ।\nअद्यैव गच्छ तत्र त्वं तत्तपोविघ्नमाचर॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001091013, "chapter_id": 21091, "verse_number": "२-१-२-१४", "content_sanskrit": "इत्याज्ञप्तो महेन्द्रेण स कामस्समधु प्रियः ।\nजगाम तत्स्थलं गर्वादुपायं स्वञ्चकार ह॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001091014, "chapter_id": 21091, "verse_number": "२-१-२-१५", "content_sanskrit": "रचयामास तत्राशु स्वकलास्सकला अपि ।\nवसंतोपि स्वप्रभावं चकार विविधं मदात्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001091015, "chapter_id": 21091, "verse_number": "२-१-२-१६", "content_sanskrit": "न बभूव मुनेश्चेतो विकृतं मुनिसत्तमाः ।\nभ्रष्टो बभूव तद्गर्वो महेशानुग्रहेण ह॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001091016, "chapter_id": 21091, "verse_number": "२-१-२-१७", "content_sanskrit": "शृणुतादरतस्तत्र कारणं शौनकादयः ।\nईश्वरानुग्रहेणात्र न प्रभावः स्मरस्य हि॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001091017, "chapter_id": 21091, "verse_number": "२-१-२-१८", "content_sanskrit": "अत्रैव शम्भुनाऽकारि सुतपश्च स्मरारिणा ।\nअत्रैव दग्धस्तेनाशु कामो मुनितपोपहः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001091018, "chapter_id": 21091, "verse_number": "२-१-२-१९", "content_sanskrit": "कामजीवनहेतोर्हि रत्या संप्रार्थितैस्सुरैः ।\nसम्प्रार्थित उवाचेदं शंकरो लोकशंकरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001091019, "chapter_id": 21091, "verse_number": "२-१-२-२०", "content_sanskrit": "कंचित्समयमासाद्य जीविष्यति सुराः स्मरः ।\nपरं त्विह स्मरोपायश्चरिष्यति न कश्चन॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001091020, "chapter_id": 21091, "verse_number": "२-१-२-२१", "content_sanskrit": "इह यावद्दृश्यते भूर्जनैः स्थित्वाऽमरास्सदा ।\nकामबाणप्रभावोत्र न चलिष्यत्यसंशयम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001091021, "chapter_id": 21091, "verse_number": "२-१-२-२२", "content_sanskrit": "इति शंभूक्तितः कामो मिथ्यात्मगतिकस्तदा ।\nनारदे स जगामाशु दिवमिन्द्रसमीपतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001091022, "chapter_id": 21091, "verse_number": "२-१-२-२३", "content_sanskrit": "आचख्यौ सर्ववृत्तांतं प्रभावं च मुनेः स्मरः ।\nतदाज्ञया ययौ स्थानं स्वकीयं स मधुप्रियः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001091023, "chapter_id": 21091, "verse_number": "२-१-२-२४", "content_sanskrit": "विस्मितोभूत्सुराधीशः प्रशशंसाथ नारदम् ।\nतद्वृत्तांतानभिज्ञो हि मोहितश्शिवमायया॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001091024, "chapter_id": 21091, "verse_number": "२-१-२-२५", "content_sanskrit": "दुर्ज्ञेया शांभवी माया सर्वेषां प्राणिनामिह ।\nभक्तं विनार्पितात्मानं तया संमोह्यते जगत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001091025, "chapter_id": 21091, "verse_number": "२-१-२-२६", "content_sanskrit": "नारदोऽपि चिरं तस्थौ तत्रेशानुग्रहेण ह ।\nपूर्णं मत्वा तपस्तत्स्वं विरराम ततो मुनिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001091026, "chapter_id": 21091, "verse_number": "२-१-२-२७", "content_sanskrit": "कामोप्यजेयं निजं मत्वा गर्वितोऽभून्मुनीश्वरः ।\nवृथैव विगतज्ञानश्शिवमायाविमोहितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001091027, "chapter_id": 21091, "verse_number": "२-१-२-२८", "content_sanskrit": "धन्या धन्या महामाया शांभवी मुनिसत्तमाः ।\nतद्गतिं न हि पश्यंति विष्णुब्रह्मादयोपि हि॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001091028, "chapter_id": 21091, "verse_number": "२-१-२-२९", "content_sanskrit": "तया संमोहितोतीव नारदो मुनिसत्तमः ।\nकैलासं प्रययौ शीघ्रं स्ववृत्तं गदितुं मदी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001091029, "chapter_id": 21091, "verse_number": "२-१-२-३०", "content_sanskrit": "रुद्रं नत्वाब्रवीत्सर्वं स्ववृत्तङ्गर्ववान्मुनिः ।\nमत्वात्मानं महात्मानं स्वप्रभुञ्च स्मरञ्जयम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001091030, "chapter_id": 21091, "verse_number": "२-१-२-३१", "content_sanskrit": "तच्छ्रुत्वा शंकरः प्राह नारदं भक्तवत्सलः ।\nस्वमायामोहितं हेत्वनभिज्ञं भ्रष्टचेतसम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001091031, "chapter_id": 21091, "verse_number": "२-१-२-३२", "content_sanskrit": "रुद्र उवाच ।\nहे तात नारद प्राज्ञ धन्यस्त्वं शृणु मद्वचः ।\nवाच्यमेवं न कुत्रापि हरेरग्रे विशेषतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001091032, "chapter_id": 21091, "verse_number": "२-१-२-३३", "content_sanskrit": "पृच्छमानोऽपि न ब्रूयाः स्ववृत्तं मे यदुक्तवान् ।\nगोप्यं गोप्यं सर्वथा हि नैव वाच्यं कदाचन॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001091033, "chapter_id": 21091, "verse_number": "२-१-२-३४", "content_sanskrit": "शास्म्यहं त्वां विशेषेण मम प्रियतमो भवान् ।\nविष्णुभक्तो यतस्त्वं हि तद्भक्तोतीव मेऽनुगः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001091034, "chapter_id": 21091, "verse_number": "२-१-२-३५", "content_sanskrit": "शास्तिस्मेत्थञ्च बहुशो रुद्रस्सूतिकरः प्रभुः ।\nनारदो न हितं मेने शिवमायाविमोहितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001091035, "chapter_id": 21091, "verse_number": "२-१-२-३६", "content_sanskrit": "प्रबला भाविनी कर्म गतिर्ज्ञेया विचक्षणैः ।\nन निवार्या जनैः कैश्चिदपीच्छा सैव शांकरी॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001091036, "chapter_id": 21091, "verse_number": "२-१-२-३७", "content_sanskrit": "ततस्स मुनिवर्यो हि ब्रह्मलोकं जगाम ह ।\nविधिं नत्वाऽब्रवीत्कामजयं स्वस्य तपोबलात्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001091037, "chapter_id": 21091, "verse_number": "२-१-२-३८", "content_sanskrit": "तदाकर्ण्य विधिस्सोथ स्मृत्वा शम्भुपदाम्बुजम् ।\nज्ञात्वा सर्वं कारणं तन्निषिषेध सुतं तदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001091038, "chapter_id": 21091, "verse_number": "२-१-२-३९", "content_sanskrit": "मेने हितन्न विध्युक्तं नारदो ज्ञानिसत्तमः ।\nशिवमायामोहितश्च रूढचित्तमदांकुरः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001091039, "chapter_id": 21091, "verse_number": "२-१-२-४०", "content_sanskrit": "शिवेच्छा यादृशी लोके भवत्येव हि सा तदा ।\nतदधीनं जगत्सर्वं वचस्तंत्यांत स्थितं यतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001091040, "chapter_id": 21091, "verse_number": "२-१-२-४१", "content_sanskrit": "नारदोऽथ ययौ शीघ्रं विष्णुलोकं विनष्टधीः ।\nमदांकुरमना वृत्तं गदितुं स्वं तदग्रतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001091041, "chapter_id": 21091, "verse_number": "२-१-२-४२", "content_sanskrit": "आगच्छंतं मुनिन्दृष्ट्वा नारदं विष्णुरादरात् ।\nउत्थित्वाग्रे गतोऽरं तं शिश्लेषज्ञातहेतुकः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001091042, "chapter_id": 21091, "verse_number": "२-१-२-४३", "content_sanskrit": "स्वासने समुपावेश्य स्मृत्वा शिवपदाम्बुजम् ।\nहरिः प्राह वचस्तथ्यं नारदं मदनाशनम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001091043, "chapter_id": 21091, "verse_number": "२-१-२-४४", "content_sanskrit": "विष्णुरुवाच ।\nकुत आगम्यते तात किमर्थमिह चागतः ।\nधन्यस्त्वं मुनिशार्दूल तीर्थोऽहं तु तवागमात्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001091044, "chapter_id": 21091, "verse_number": "२-१-२-४५", "content_sanskrit": "विष्णुवाक्यमिति श्रुत्वा नारदो गर्वितो मुनिः ।\nस्ववृत्तं सर्वमाचष्ट समदं मदमोहितः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001091045, "chapter_id": 21091, "verse_number": "२-१-२-४६", "content_sanskrit": "श्रुत्वा मुनिवचो विष्णुस्समदं कारणं ततः ।\nज्ञातवानखिलं स्मृत्वा शिवपादाम्बुजं हृदि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001091046, "chapter_id": 21091, "verse_number": "२-१-२-४७", "content_sanskrit": "तुष्टाव गिरिशं भक्त्या शिवात्मा शैवराड् हरिः ।\nसांजलिर्विसुधीर्नम्रमस्तकः परमेश्वरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001091047, "chapter_id": 21091, "verse_number": "२-१-२-४८", "content_sanskrit": "विष्णुरुवाच ।\nदेवदेव महादेव प्रसीद परमेश्वर ।\nधन्यस्त्वं शिव धन्या ते माया सर्व विमोहिनी॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001091048, "chapter_id": 21091, "verse_number": "२-१-२-४९", "content_sanskrit": "इत्यादि स स्तुतिं कृत्वा शिवस्य परमात्मनः ।\nनिमील्य नयने ध्यात्वा विरराम पदाम्बुजम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001091049, "chapter_id": 21091, "verse_number": "२-१-२-५०", "content_sanskrit": "यत्कर्तव्यं शंकरस्य स ज्ञात्वा विश्वपालकः ।\nशिवशासनतः प्राह हृदाथ मुनिसत्तमम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001091050, "chapter_id": 21091, "verse_number": "२-१-२-५१", "content_sanskrit": "विष्णुरुवाच ।\nधन्यस्त्वं मुनिशार्दूल तपोनिधिरुदारधीः ।\nभक्तित्रिकं न यस्यास्ति काममोहादयो मुने॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001091051, "chapter_id": 21091, "verse_number": "२-१-२-५२", "content_sanskrit": "विकारास्तस्य सद्यो वै भवंत्यखिलदुःखदाः ।\nनैष्ठिको ब्रह्मचारी त्वं ज्ञानवैराग्यवान्सदा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001091052, "chapter_id": 21091, "verse_number": "२-१-२-५३", "content_sanskrit": "कथं कामविकारी स्या जन्मना विकृतस्सुधीः ।\nइत्याद्युक्तं वचो भूरि श्रुत्वा स मुनिसत्तमः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001091053, "chapter_id": 21091, "verse_number": "२-१-२-५४", "content_sanskrit": "विजहास हृदा नत्वा प्रत्युवाच वचो हरिम् ।\nनारद उवाच ।\nकिं प्रभावः स्मरः स्वामिन्कृपा यद्यस्ति ते मयि॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001091054, "chapter_id": 21091, "verse_number": "२-१-२-५५", "content_sanskrit": "इत्युक्त्वा हरिमानम्य ययौ यादृच्छिको मुनिः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]