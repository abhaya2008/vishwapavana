[{"id": 7002998000, "chapter_id": 22998, "verse_number": "२-४५-१", "content_sanskrit": "नारायण उवाच ।\nउक्तं द्वयोरुपाख्यानं ब्रह्मपुत्र यथागमम् ।\nश्रूयतां मनसाख्यानं यच्छ्रुतं धर्मवक्त्रतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002998001, "chapter_id": 22998, "verse_number": "२-४५-२", "content_sanskrit": "कन्या भगवती सा च कश्यपस्य च मानसी ।\nतेनेयं मनसादेवी मनसा या च दीव्यति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002998002, "chapter_id": 22998, "verse_number": "२-४५-३", "content_sanskrit": "मनसा ध्यायते या वा परमात्मानमीश्वरम् ।\nतेन सा मनसादेवी योगेनैतेन दीव्यति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002998003, "chapter_id": 22998, "verse_number": "२-४५-४", "content_sanskrit": "आत्मारामा च सा देवी वैष्णवी सिद्धयोगिनी ।\nत्रियुगं च तपस्तप्त्वा कृष्णस्य परमात्मनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002998004, "chapter_id": 22998, "verse_number": "२-४५-५", "content_sanskrit": "जरत्कारुशरीरं च दृष्ट्वा यां क्षणमीश्वरः ।\nगोपीपतिर्नाम चक्रे जरत्कारुरिति प्रभुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002998005, "chapter_id": 22998, "verse_number": "२-४५-६", "content_sanskrit": "वाञ्छितं च ददौ तस्यै कृपया च कृपानिधिः ।\nपूजां च कारयामास चकार च पुनः स्वयम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002998006, "chapter_id": 22998, "verse_number": "२-४५-७", "content_sanskrit": "स्वर्गे च नागलोके च पृथिव्यां बह्मलोकतः ।\nभृशं जपत्सु गौरी सा सुन्दरी च मनोहरा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002998007, "chapter_id": 22998, "verse_number": "२-४५-८", "content_sanskrit": "जगद्गौरीति विख्याता तेन सा पूजिता सती ।\nशिवशिष्या च सा देवी तेन शैवीति कीर्त्तिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002998008, "chapter_id": 22998, "verse_number": "२-४५-९", "content_sanskrit": "विष्णुभक्ताऽतीव रम्या वैष्णवी तेन नारद ।\nनागानां प्राणरक्षित्री जनमेजययज्ञके ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002998009, "chapter_id": 22998, "verse_number": "२-४५-१०", "content_sanskrit": "नागेश्वरीति विख्याता सा नागभगिनी तथा ।\nविषं संहर्त्तुमीशा सा तेन सा विषहारिणी  ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002998010, "chapter_id": 22998, "verse_number": "२-४५-११", "content_sanskrit": "सिद्धं योगं हरात्प्राप तेनासौ सिद्धयोगिनी ।\nमहाज्ञानं च गोप्यं च मृतसञ्जीविनीं पराम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002998011, "chapter_id": 22998, "verse_number": "२-४५-१२", "content_sanskrit": "महाज्ञानयुतां तां च प्रवदन्ति  मनीषिणः ।\nआस्तीकस्य मुनीन्द्रस्य माता सा वै तपस्विनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002998012, "chapter_id": 22998, "verse_number": "२-४५-१३", "content_sanskrit": "आस्तीकमाता विख्याता जरत्कारुरिति स्म सा ।\nप्रिया मुनेर्जरत्कारोर्मुनीन्द्रस्य महात्मनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002998013, "chapter_id": 22998, "verse_number": "२-४५-१४", "content_sanskrit": "योगिनो विश्वपूज्यस्य जरत्कारोः प्रिया ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002998014, "chapter_id": 22998, "verse_number": "२-४५-१५", "content_sanskrit": "ॐ नमो मनसायै ।\nजरत्कारुर्जगद्गौरी मनसा सिद्धयोगिनी ।\nवैष्णवी नागभगिनी शैवी नागेश्वरी तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002998015, "chapter_id": 22998, "verse_number": "२-४५-१६", "content_sanskrit": "जरत्कारुप्रियाऽऽस्तीकमाता विषहरीति च ।\nमहाज्ञानयुता चैव सा देवी विश्वपूजिता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002998016, "chapter_id": 22998, "verse_number": "२-४५-१७", "content_sanskrit": "द्वादशैतानि नामानि पूजाकाले च यः पठेत् ।\nतस्य नागभयं नस्ति तस्य वंशोद्भवस्य च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002998017, "chapter_id": 22998, "verse_number": "२-४५-१८", "content_sanskrit": "नागभीदे च शयने नागग्रस्ते च मन्दिरे ।\nनागक्षते नागदुर्गे नागवेष्टितविग्रहे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002998018, "chapter_id": 22998, "verse_number": "२-४५-१९", "content_sanskrit": "इदं स्तोत्रं पठित्वा तु मुच्यते नात्र संशयः ।\nनित्यं पठेद्यस्तं दृष्ट्वा नागवर्गः पलायते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002998019, "chapter_id": 22998, "verse_number": "२-४५-२०", "content_sanskrit": "दशलक्षजपेनैव स्तोत्रसिद्धिर्भवेन्नृणाम् ।\nस्तोत्रं सिद्धं भवेद्यस्य स विषं भोक्तुमीश्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002998020, "chapter_id": 22998, "verse_number": "२-४५-२१", "content_sanskrit": "नागौघं भूषणं कृत्वा स भवेन्नागवाहनः ।\nनागासनो नागतल्पो महा सिद्धो भवेन्नरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]