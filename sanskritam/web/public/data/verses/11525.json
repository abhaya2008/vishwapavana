[{"id": 50014071, "chapter_id": 11525, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014072, "chapter_id": 11525, "verse_number": "2", "content_sanskrit": "अथो सुराः प्रत्युपलब्धचेतसः परस्य पुंसः परयाऽनुकम्पया। जघ्नुर्भृशं शक्रसमीरणादयस्तांस्तान् रणे यैरभिसङ्गताः पुरा॥ ८/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014073, "chapter_id": 11525, "verse_number": "3", "content_sanskrit": "वैरोचनाय संरब्धो भगवान् पाकशासनः। उदयच्छद् यदा वज्रं प्रजा हाहेति चुक्रुशुः॥ ८/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014074, "chapter_id": 11525, "verse_number": "4", "content_sanskrit": "वज्रपाणिस्तमाहेदं तिरस्कृत्य पुरःस्थितम्। मनस्विनं सुसम्पन्नं विचरन्तं महामृधे॥ ८/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014075, "chapter_id": 11525, "verse_number": "5", "content_sanskrit": "नटवन्मूढ मायाभिर्मायावी त्वं जिगीषसि। जित्वा बालान् निबद्धाक्षान् नभो हरति तद्धनम्॥ ८/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014076, "chapter_id": 11525, "verse_number": "6", "content_sanskrit": "आरुरुक्षन्ति मायाभिरुत्सिसृप्सन्ति ये दिवम्। तान् दस्यून् विधुनोम्यज्ञ पूर्वस्माच्च पदादधः॥ ८/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014077, "chapter_id": 11525, "verse_number": "7", "content_sanskrit": "सोऽहं दुर्मायिनस्तेऽद्य वज्रेण शतपर्वणा। शिरो हरिष्ये मन्दात्मन् घटस्व ज्ञातिभिः सह॥ ८/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014078, "chapter_id": 11525, "verse_number": "8", "content_sanskrit": "बलिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014079, "chapter_id": 11525, "verse_number": "9", "content_sanskrit": "सङ्ग्रामे वर्तमानानां कालचोदितकर्मणाम्। कार्तिर्जयोऽजयो मृत्युः सर्वेषां स्युरनुक्रमात्॥ ८/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014080, "chapter_id": 11525, "verse_number": "10", "content_sanskrit": "तमिमं कालरशनं जनं पश्यन्ति सूरयः। न हृष्यन्ति न शोचन्ति तत्र यूयमपण्डिताः॥ ८/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014081, "chapter_id": 11525, "verse_number": "11", "content_sanskrit": "न वयं मन्यमानानामात्मानं तत्र कारणम्। गिरो वः साधु शोच्यानां गृह्णीमो मर्मताडनाः॥ ८/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014082, "chapter_id": 11525, "verse_number": "12", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014083, "chapter_id": 11525, "verse_number": "13", "content_sanskrit": "इत्याक्षिप्य विभुं वीरो नाराचैर्वीरमानदः। आकर्णपूर्णैरहनदाक्षेपैराहतं पुनः॥ ८/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014084, "chapter_id": 11525, "verse_number": "14", "content_sanskrit": "एवं निराकृतो देवो वैरिणा तथ्यवादिना। नामृष्यत् तदधिक्षेपं तोत्राहत इव द्विपः॥ ८/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50014085, "chapter_id": 11525, "verse_number": "15", "content_sanskrit": "प्राहरत् कुलिशं तस्मा अमोघं परमर्दनम्। सयानो न्यपतद् भूमौ छिन्नपक्ष इवाचलः॥ ८/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50014086, "chapter_id": 11525, "verse_number": "16", "content_sanskrit": "सखायं पतितं दृष्ट्वा जम्भो बलिसखः सुहृत्। अभ्ययात् सौहृदं सख्युर्हतस्यापि स्वमाचरन्॥ ८/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50014087, "chapter_id": 11525, "verse_number": "17", "content_sanskrit": "स सिंहवाह आसाद्य गदामुद्यम्य रंहसा। जत्रावताडयच्छक्रं गजं च सुमहाबलः॥ ८/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50014088, "chapter_id": 11525, "verse_number": "18", "content_sanskrit": "गदाप्रहारव्यथितो भृशं विह्वलितो गजः। जानुभ्यां धरणीं स्पृष्ट्वा कश्मलं परमं ययौ॥ ८/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50014089, "chapter_id": 11525, "verse_number": "19", "content_sanskrit": "ततो रथो मातलिना हयैर्दशशतैर्युतः। आनीतो द्विपमुत्सृज्य रथमारुरुहे विभुः॥ ८/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50014090, "chapter_id": 11525, "verse_number": "20", "content_sanskrit": "तस्य तत् पूजयन् कर्म शत्रोर्दानवसत्तमः। शूलेन ज्वलता तं तु स्मयमानोऽहनन्मृधे॥ ८/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50014091, "chapter_id": 11525, "verse_number": "21", "content_sanskrit": "सेहे रुजं सुदुर्मर्षं सत्वमालम्ब्य मातलिः। इन्द्रो जम्भस्य सङ्क्रुद्धो वज्रेणापाहरच्छिरः॥ ८/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50014092, "chapter_id": 11525, "verse_number": "22", "content_sanskrit": "जम्भं श्रुत्वा हतं तस्य ज्ञातयो नारदादृषेः। नमुचिः सबलः पाकस्तत्रोपेयुस्त्वरान्विताः॥ ८/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50014093, "chapter_id": 11525, "verse_number": "23", "content_sanskrit": "वचोभिः परुषैरिन्द्रमर्दयन्तोऽस्य मर्मसु। शरैरवाकिरन् मेघा धाराभिरिव पर्वतम्॥ ८/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50014094, "chapter_id": 11525, "verse_number": "24", "content_sanskrit": "हरीन् दशशतानाजौ हर्यश्वस्य बलः शरैः। तावद्भिरर्दयामास युगपल्लघुहस्तवान्॥ ८/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50014095, "chapter_id": 11525, "verse_number": "25", "content_sanskrit": "शताभ्यां मातलिं पाको रथं सावयवं पृथक्। सकृत्सन्धानमोक्षेण तदद्भुतमभूद् रणे॥ ८/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50014096, "chapter_id": 11525, "verse_number": "26", "content_sanskrit": "नमुचिः पञ्चदशभिः स्वर्णपुङ्खैर्महेषुभिः। आहत्य व्यनदत् सङ्खे सतोय इव तोयदः॥ ८/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50014097, "chapter_id": 11525, "verse_number": "27", "content_sanskrit": "सर्वतः शरकूटेन शत्रुं सरथसारथिम्। छादयामासुरसुराः प्रावृट्सूर्यमिवाम्बुदाः॥ ८/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50014098, "chapter_id": 11525, "verse_number": "28", "content_sanskrit": "अलक्षयन्तस्तमतीव विह्वला विचुक्रुशुर्देवगणाः समाकुलाः। अनायकाः शत्रुबलेन निर्जिता वणिक्पथा भिन्ननवो यथार्णवे॥ ८/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50014099, "chapter_id": 11525, "verse_number": "29", "content_sanskrit": "ततस्तुराषाडिषुबद्धपञ्जराद् विनिर्गतः साश्वरथध्वजाग्रणीः। बभौ दिशः खं पृथिवीं च रोचयन् स्वतेजसा सूर्य इव क्षपात्यये॥ ८/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50014100, "chapter_id": 11525, "verse_number": "30", "content_sanskrit": "निरीक्ष्य पृतनां देवः परैरभ्यर्दितां रणे। उदयच्छद् रिपुं हन्तुं वज्रं वज्रधरो रुषा॥ ८/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50014101, "chapter_id": 11525, "verse_number": "31", "content_sanskrit": "स तेनैवाष्टधारेण शिरसी बलपाकयोः। ज्ञातीनां पश्यतां राजन् जहार जनयन् भयम्॥ ८/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50014102, "chapter_id": 11525, "verse_number": "32", "content_sanskrit": "नमुचिस्तद्वधं दृष्ट्वा शोकामर्षरुषाऽन्वितः। जिघांसुरिन्द्रं नृपते चकार परमोद्यमम्॥ ८/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50014103, "chapter_id": 11525, "verse_number": "33", "content_sanskrit": "अश्मसारमयं शूलं घण्टावद्धेमभूषणम्। प्रगृह्याभ्यद्रवत् क्रुद्धो हतोऽसीति विसर्जयन्॥ ८/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50014104, "chapter_id": 11525, "verse_number": "34", "content_sanskrit": "प्राहिणोद् देवराजाय विनदन् मृगराडिव॥ ८/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50014105, "chapter_id": 11525, "verse_number": "35", "content_sanskrit": "तदापतद् गगनतळे महाजवं निचिच्छिदे हरिरिषुभिः सहस्रधा। तमाहनन् नृप कुलिशेन कन्धरे रुषाऽन्वितस्त्रिदशपतिः शिरो हरन्॥ ८/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50014106, "chapter_id": 11525, "verse_number": "36", "content_sanskrit": "ततोऽस्य न त्वचमपि वज्र ऊर्जितो बिभेद यः सुरपतिनौजसेरितः। तदद्भुतं परमभिवीक्ष्य वृत्रभित् तिरस्कृतो नमुचिशिरोधरत्वचा॥ ८/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50014107, "chapter_id": 11525, "verse_number": "37", "content_sanskrit": "तस्मादिन्द्रो बिभेच्छत्रोर्वज्रः प्रतिहतो यतः। किमिदं दैवयोगेन भूतं लोकविमोहनम्॥ ८/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50014108, "chapter_id": 11525, "verse_number": "38", "content_sanskrit": "येन मे पूर्वमद्रीणां पक्षच्छेदः प्रजाक्षये। कृतो निविशतां भारैः पतत्त्रैः पततां भुवि॥ ८/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50014109, "chapter_id": 11525, "verse_number": "39", "content_sanskrit": "तपःसारमयं त्वाष्ट्रं वृत्रो येन विपाटितः। अन्ये चापि बलोपेताः सर्वास्त्रैरक्षतत्वचः॥ ८/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50014110, "chapter_id": 11525, "verse_number": "40", "content_sanskrit": "सोऽयं प्रतिहतो वज्रो मया मुक्तोऽसुरेऽल्पके। नाहं तदाददे वज्रं ब्रह्मतेजोऽप्यकारणम्॥ ८/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50014111, "chapter_id": 11525, "verse_number": "41", "content_sanskrit": "इति शक्रं विषीदन्तमाह वागशरीरिणी। नायं शुष्कैरथो नाद्रैर्वधमर्हति दानवः॥ ८/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50014112, "chapter_id": 11525, "verse_number": "42", "content_sanskrit": "मयास्मै यद् वरो दत्तो मृत्युर्वै नार्द्रशुष्कयोः। अतोऽन्यश्चिन्तनीयस्ते उपायो मघवन् रिपोः॥ ८/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50014113, "chapter_id": 11525, "verse_number": "43", "content_sanskrit": "तां दैवीं गिरमाकर्ण्य मघवान् सुसमाहितः। ध्यायन् फेनमथापश्यदुपायमुभयात्मकम्॥ ८/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50014114, "chapter_id": 11525, "verse_number": "44", "content_sanskrit": "न शुष्केण नचार्द्रेण जहार नमुचेः शिरः। तं तुष्टुवुर्मुनिगणा माल्यैश्चावाकिरन् विभुम्॥ ८/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50014115, "chapter_id": 11525, "verse_number": "45", "content_sanskrit": "गन्धर्वमुख्यौ जगतुर्विश्वावसुपरावसू। देवदुन्दुभयो नेदुर्नर्तक्यो ननृतुर्मुदा॥ ८/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50014116, "chapter_id": 11525, "verse_number": "46", "content_sanskrit": "अन्येऽप्येवं प्रतिद्वन्द्वान् वाय्वग्निवरुणादयः। सूदयामासुरस्त्रौघैर्मृगान् केसरिणो यथा॥ ८/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50014117, "chapter_id": 11525, "verse_number": "47", "content_sanskrit": "ब्रह्मणा प्रेषितो देवान् देवर्षिर्नारदो नृप। वारयामास विबुधान् दृष्ट्वा दानवसङ्क्ष्यम्॥ ८/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50014118, "chapter_id": 11525, "verse_number": "48", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50014119, "chapter_id": 11525, "verse_number": "49", "content_sanskrit": "भवद्भिरमृतं प्राप्तं नारायणभुजाश्रयैः। श्रिया समेधिताः सर्वे उपारमत विग्रहात्॥ ८/१०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50014120, "chapter_id": 11525, "verse_number": "50", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50014121, "chapter_id": 11525, "verse_number": "51", "content_sanskrit": "संयम्य मन्युसंरम्भं मानयन्तो मुनेर्वचः। सङ्गीयमानानुचरैर्ययुः सर्वे त्रिविष्टपम्॥ ८/१०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50014122, "chapter_id": 11525, "verse_number": "52", "content_sanskrit": "येऽवशिष्टा रणे तस्मिन् नारदानुमतेन ते। बलिं विपन्नमादाय अस्तं गिरिमुपागमन्॥ ८/१०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50014123, "chapter_id": 11525, "verse_number": "53", "content_sanskrit": "तत्रापि नष्टावयवान् भिद्यमानशिरोधरान्। उशना जीवयामास सञ्जीविन्या स्वविद्यया॥ ८/१०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50014124, "chapter_id": 11525, "verse_number": "54", "content_sanskrit": "बलिश्चोशनसा स्पृष्टः प्रत्यापन्नेन्द्रियस्मृतिः। पराजितोऽपि नाखिद्यल्लोकतत्वविचक्षणः॥ ८/१०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50014125, "chapter_id": 11525, "verse_number": "55", "content_sanskrit": "इति श्रीमद्भागवते अष्टमस्कन्धे दशमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]