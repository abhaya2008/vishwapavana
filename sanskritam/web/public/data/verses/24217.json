[{"id": 7004217000, "chapter_id": 24217, "verse_number": "५-१-६६-१", "content_sanskrit": "सनत्कुमार उवाच ।\nभूयः शृणु परं व्यास तीर्थानामुत्तमं वरम्॥  ।\nतत्तीर्थं सर्वपापघ्नं नृसिंहस्य महात्मनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004217001, "chapter_id": 24217, "verse_number": "५-१-६६-२", "content_sanskrit": "यस्य दर्शनमात्रेण सर्वपापं समुत्तरेत् ।\nदैत्यराजः समाख्यातो हिरण्यकशिपुः पुरा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004217002, "chapter_id": 24217, "verse_number": "५-१-६६-३", "content_sanskrit": "तेनेयं वसुधा सर्वा संप्राप्ता च दुरात्मना ।\nदुष्टदैत्यबलैर्व्याप्ता भाराक्रांता शुचार्दिता॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004217003, "chapter_id": 24217, "verse_number": "५-१-६६-४", "content_sanskrit": "गौर्भूत्वाऽश्रुमुखी देवैर्ब्रह्माणं शरणं ययौ ।\nभाराक्रांतां धरां दृष्ट्वा ब्रह्मा लोकपितामहः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004217004, "chapter_id": 24217, "verse_number": "५-१-६६-५", "content_sanskrit": "उवाच श्लक्ष्णया वाचा तस्याः श्रमं व्यपोहितुम् ।\nश्रूयतां भोऽवने पुण्ये भवत्या उपकारकम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004217005, "chapter_id": 24217, "verse_number": "५-१-६६-६", "content_sanskrit": "वचो वदामि ते तथ्यं देशकालोचितं तथा ।\nपुराऽनेन तपश्चीर्णं दुष्करं सर्वदेहिनाम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004217006, "chapter_id": 24217, "verse_number": "५-१-६६-७", "content_sanskrit": "गायत्र्युपासना तेन कृता सुनियतात्मना ।\nमया चास्य वरो दत्तः प्रीतियुक्तेन चेतसा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004217007, "chapter_id": 24217, "verse_number": "५-१-६६-८", "content_sanskrit": "न दिवा न तथा रात्रौ नांतरिक्षे न भूतले ।\nनातिशुष्केण चार्द्रेण न चास्त्रशस्त्रघातनैः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004217008, "chapter_id": 24217, "verse_number": "५-१-६६-९", "content_sanskrit": "न देवासुर गंधर्वैर्न यक्षोरगकिन्नरैः ।\nपिशाचैर्गुह्यकाद्यैश्च राक्षसैर्न कदाचन॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004217009, "chapter_id": 24217, "verse_number": "५-१-६६-१०", "content_sanskrit": "मानवैः पक्षिजातैश्च न मे मृत्युर्भवेदिति ।\nएककरतलाघातैः सकुलबलवाहनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004217010, "chapter_id": 24217, "verse_number": "५-१-६६-११", "content_sanskrit": "मारयिष्यति मां वीरः स मे मृत्युर्भविष्यति ।\nतथेत्युक्त्वाऽतिहृष्टात्मा तमहं च तदाऽवने॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004217011, "chapter_id": 24217, "verse_number": "५-१-६६-१२", "content_sanskrit": "आगमं चैव लोकं स्वं स दैत्यो घोरशासनः ।\nबभूव सर्वलोकानां शास्ता चातुलविक्रमः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004217012, "chapter_id": 24217, "verse_number": "५-१-६६-१३", "content_sanskrit": "तस्यैवाऽधिकृता लोके बभूवुर्विगतज्वराः ।\nत्रैलोक्यं बुभुजे नित्यं सर्वदैत्यजनेश्वरः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004217013, "chapter_id": 24217, "verse_number": "५-१-६६-१४", "content_sanskrit": "तस्माद्यूयं वनं यात महाकालं महेशितुः ।\nतत्र तीर्थं महच्चासीत्सर्वतीर्थवरोतमम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004217014, "chapter_id": 24217, "verse_number": "५-१-६६-१५", "content_sanskrit": "संगमेश्वरस्य दक्षिणे कर्कराजोत्तरे तथा ।\nशिप्रातीरे शुभे देशे पूर्वं वैकुण्ठसन्निभम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004217015, "chapter_id": 24217, "verse_number": "५-१-६६-१६", "content_sanskrit": "नृसिंहाख्यं परं धाम तस्य तीर्थं प्रतिष्ठितम् ।\nतत्र गत्वा सुरश्रेष्ठाः स्नानदाना दिकाः क्रियाः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004217016, "chapter_id": 24217, "verse_number": "५-१-६६-१७", "content_sanskrit": "कुरुत सत्वरं सर्वे पुनर्लोकानवाप्स्यथ ।\nते तस्य वचनं श्रुत्वा देवा इन्द्रपुरोगमाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004217017, "chapter_id": 24217, "verse_number": "५-१-६६-१८", "content_sanskrit": "महाकालवनं प्राप्ता यत्र शिप्रा पयस्विनी ।\nनृसिंहतीर्थोपकूले उषित्वा शाश्वतीः समाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004217018, "chapter_id": 24217, "verse_number": "५-१-६६-१९", "content_sanskrit": "स्नानदानादिकं कृत्वा नृसिंहस्याऽर्चनं तथा ।\nएवं कृत्वा विधानेन परां सिद्धिमितो गताः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004217019, "chapter_id": 24217, "verse_number": "५-१-६६-२०", "content_sanskrit": "नृसिंहस्य स्वरूपेण हतो दानवपुंगवः ।\nसभामध्ये तदा व्यास हरिणाऽमित्रघातिना॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004217020, "chapter_id": 24217, "verse_number": "५-१-६६-२१", "content_sanskrit": "करेणैकप्रहारेण हिर ण्यकशिपुर्हतः ।\nततः सुरगणाः सर्वे स्वाधिकारान्ययुस्तदा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004217021, "chapter_id": 24217, "verse_number": "५-१-६६-२२", "content_sanskrit": "तदारभ्य सुराः सर्वे मध्याह्नोह्नोपासनं सदा ।\nप्रकुर्वंति च तत्रैव यत्र तीर्थे हरिः परम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004217022, "chapter_id": 24217, "verse_number": "५-१-६६-२३", "content_sanskrit": "एवं तीर्थं परं व्यास अवंत्यां विद्यते भुवि ।\nअस्मिंस्तीर्थे द्विजश्रेष्ठ स्नानदानादिकाः क्रियाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004217023, "chapter_id": 24217, "verse_number": "५-१-६६-२४", "content_sanskrit": "ये कुर्वंति नराः पुण्यास्ते यांति परमां गतिम् ।\nसर्वदा सर्वकालेषु पुण्यदं तीर्थमुत्तमम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004217024, "chapter_id": 24217, "verse_number": "५-१-६६-२५", "content_sanskrit": "कदाचिन्नृसिंहतिथिं प्राप्य चैव चतुर्दशीम् ।\nस्नानं कृत्वाऽर्चनं तस्य नृसिंहस्य च धीमतः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004217025, "chapter_id": 24217, "verse_number": "५-१-६६-२६", "content_sanskrit": "नृसिंहेश्वरदेवेशं पूजयेद्यः समाहितः ।\nतस्य हस्तगता लक्ष्मीर्भविष्यति न संशयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004217026, "chapter_id": 24217, "verse_number": "५-१-६६-२७", "content_sanskrit": "ततोऽगस्त्येश्वरं देवं यः पश्येत्युसमाहितः ।\nतस्य व्यास क्षितौ किंचिद्दुर्लभं नैव दृश्यते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004217027, "chapter_id": 24217, "verse_number": "५-१-६६-२८", "content_sanskrit": "यत्र सिद्धिं परां प्राप्तो हनुमान्पवनात्मजः ।\nब्रह्मचारी सदाचारो यतिः सर्वार्थसाधकः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004217028, "chapter_id": 24217, "verse_number": "५-१-६६-२९", "content_sanskrit": "तिष्ठति परदैवज्ञः सर्वकामार्थसिद्धये ।\nयस्मिन्वटे पुरा तप्तं तपः परमदुश्चरम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004217029, "chapter_id": 24217, "verse_number": "५-१-६६-३०", "content_sanskrit": "मित्रावरुणपुत्रेण सिद्धिहेतोस्तपस्विना ।\nबोधी न्यग्रोध इत्याख्यो ह्यगस्तिवट एव च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004217030, "chapter_id": 24217, "verse_number": "५-१-६६-३१", "content_sanskrit": "नरो नारीसमायुक्तः सावित्रीव्रतमाचरेत् ।\nसौभाग्यं लभते नित्यं सावित्र्याश्च परंतप॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004217031, "chapter_id": 24217, "verse_number": "५-१-६६-३२", "content_sanskrit": "यस्मिंस्तीर्थे नरः स्नात्वा दत्त्वा दानं च सौभगम् ।\nअष्टसौभाग्यसंपूर्णं वंशपात्रं सवासकम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004217032, "chapter_id": 24217, "verse_number": "५-१-६६-३३", "content_sanskrit": "सप्तधान्यसमोपेतं पंचरत्नपरिष्कृतम् ।\nसौगंध्यादीनि माल्यानि मौलिसूत्रसमायुतम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004217033, "chapter_id": 24217, "verse_number": "५-१-६६-३४", "content_sanskrit": "सावित्रीं हाटकीं कृत्वा यथाशक्ति परंतप ।\nयो वै ददाति विप्राय वेदवेदांगधीमते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004217034, "chapter_id": 24217, "verse_number": "५-१-६६-३५", "content_sanskrit": "लभते विपुलां लक्ष्मीं बहुभोगकरीं शुभाम् ।\nभुक्त्वा वै विविधान्भोगान्पुनः स्वर्गमवाप्नुयात्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004217035, "chapter_id": 24217, "verse_number": "५-१-६६-३६", "content_sanskrit": "सावित्रीव्रतकृन्नारी जायते पतिवल्लभा ।\nपतिव्रता महाभागा विधवा न कदाचन॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]