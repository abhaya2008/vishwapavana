[{"id": 7001436000, "chapter_id": 21436, "verse_number": "७-१-९-१", "content_sanskrit": "मुनय ऊचुः ।\nकथं जगदिदं कृत्स्नं विधाय च निधाय च ।\nआज्ञया परमां क्रीडां करोति परमेश्वरः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001436001, "chapter_id": 21436, "verse_number": "७-१-९-२", "content_sanskrit": "किं तत्प्रथमसंभूतं केनेदमखिलं ततम् ।\nकेना वा पुनरेवेदं ग्रस्यते पृथुकुक्षिणा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001436002, "chapter_id": 21436, "verse_number": "७-१-९-३", "content_sanskrit": "वायुरुवाच ।\nशक्तिः प्रथमसम्भूता शांत्यतीतपदोत्तरा ।\nततो माया ततो ऽव्यक्तं शिवाच्छक्तिमतः प्रभोः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001436003, "chapter_id": 21436, "verse_number": "७-१-९-४", "content_sanskrit": "शान्त्यतीतपदं शक्तेस्ततः शान्तिपदक्रमात् ।\nततो विद्यापदं तस्मात्प्रतिष्ठापदसंभवः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001436004, "chapter_id": 21436, "verse_number": "७-१-९-५", "content_sanskrit": "निवृत्तिपदमुत्पन्नं प्रतिष्ठापदतः क्रमात् ।\nएवमुक्ता समासेन सृष्टिरीश्वरचोदिता॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001436005, "chapter_id": 21436, "verse_number": "७-१-९-६", "content_sanskrit": "आनुलोम्यात्तथैतेषां प्रतिलोम्येन संहृतिः ।\nअस्मात्पञ्चपदोद्दिष्टात्परस्स्रष्टा समिष्यते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001436006, "chapter_id": 21436, "verse_number": "७-१-९-७", "content_sanskrit": "कलाभिः पञ्चभिर्व्याप्तं तस्माद्विश्वमिदं जगत् ।\nअव्यक्तं कारणं यत्तदात्मना समनुष्ठितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001436007, "chapter_id": 21436, "verse_number": "७-१-९-८", "content_sanskrit": "महदादिविशेषांतं सृजतीत्यपि संमतम् ।\nकिं तु तत्रापि कर्तृत्वं नाव्यक्तस्य न चात्मनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001436008, "chapter_id": 21436, "verse_number": "७-१-९-९", "content_sanskrit": "अचेतनत्वात्प्रकृतेरज्ञत्वात्पुरुषस्य च ।\nप्रधानपरमाण्वादि यावत्किञ्चिदचेतनम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001436009, "chapter_id": 21436, "verse_number": "७-१-९-१०", "content_sanskrit": "तत्कर्तृकं स्वयं दृष्टं बुद्धिमत्कारणं विना ।\nजगच्च कर्तृसापेक्षं कार्यं सावयवं यतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001436010, "chapter_id": 21436, "verse_number": "७-१-९-११", "content_sanskrit": "तस्माच्छक्तस्स्वतन्त्रो यः सर्वशक्तिश्च सर्ववित् ।\nअनादिनिधनश्चायं महदैश्वर्यसंयुतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001436011, "chapter_id": 21436, "verse_number": "७-१-९-१२", "content_sanskrit": "स एव जगतः कर्ता महादेवो महेश्वराः ।\nपाता हर्ता च सर्वस्य ततः पृथगनन्वयः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001436012, "chapter_id": 21436, "verse_number": "७-१-९-१३", "content_sanskrit": "परिणामः प्रधानस्य प्रवृत्तिः पुरुषस्य च ।\nसर्वं सत्यव्रतस्यैव शासनेन प्रवर्तते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001436013, "chapter_id": 21436, "verse_number": "७-१-९-१४", "content_sanskrit": "इतीयं शाश्वती निष्ठा सतां मनसि वर्तते ।\nन चैनं पक्षमाश्रित्य वर्तते स्वल्पचेतनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001436014, "chapter_id": 21436, "verse_number": "७-१-९-१५", "content_sanskrit": "यावदादिसमारंभो यावद्यः प्रलयो महान् ।\nतावदप्येति सकलं ब्रह्मणः शारदां शतम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001436015, "chapter_id": 21436, "verse_number": "७-१-९-१६", "content_sanskrit": "परमित्यायुषो नाम ब्रह्मणो ऽव्यक्तजन्मनः ।\nतत्पराख्यं तदर्धं च परार्धमभिधीयते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001436016, "chapter_id": 21436, "verse_number": "७-१-९-१७", "content_sanskrit": "परार्धद्वयकालांते प्रलये समुपस्थिते ।\nअव्यक्तमात्मनः कार्यमादायात्मनि तिष्ठति॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001436017, "chapter_id": 21436, "verse_number": "७-१-९-१८", "content_sanskrit": "आत्मन्यवस्थिते ऽव्यक्ते विकारे प्रतिसंहृते ।\nसाधर्म्येणाधितिष्ठेते प्रधानपुरुषावुभौ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001436018, "chapter_id": 21436, "verse_number": "७-१-९-१९", "content_sanskrit": "तमः सत्त्वगुणावेतौ समत्वेन व्यवस्थितौ ।\nअनुद्रिक्तावनन्तौ तावोतप्रोतौ परस्परम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001436019, "chapter_id": 21436, "verse_number": "७-१-९-२०", "content_sanskrit": "गुणसाम्ये तदा तस्मिन्नविभागे तमोदये ।\nशांतवातैकनीरे च न प्राज्ञायत किंचन॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001436020, "chapter_id": 21436, "verse_number": "७-१-९-२१", "content_sanskrit": "अप्रज्ञाते जगत्यस्मिन्नेक एव महेश्वरः ।\nउपास्य रजनीं कृत्स्नां परां माहेश्वरीं ततः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001436021, "chapter_id": 21436, "verse_number": "७-१-९-२२", "content_sanskrit": "प्रभातायां तु शर्वर्यां प्रधानपुरुषावुभौ ।\nप्रविश्य क्षोभयामास मायायोगान्महेश्वरः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001436022, "chapter_id": 21436, "verse_number": "७-१-९-२३", "content_sanskrit": "ततः पुनरशेषाणां भूतानां प्रभवाप्ययात् ।\nअव्यक्तादभवत्सृष्टिराज्ञया परमेष्ठिनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001436023, "chapter_id": 21436, "verse_number": "७-१-९-२४", "content_sanskrit": "विश्वोत्तरोत्तरविचित्रमनोरथस्य यस्यैकशक्तिशकले सकलस्समाप्तः ।\nआत्मानमध्वपतिमध्वविदो वदंति तस्मै नमः सकललोकविलक्षणाय॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]