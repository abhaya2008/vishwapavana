[{"id": 5000450000, "chapter_id": 9450, "verse_number": "६-४३-१", "content_sanskrit": "युध्यतां तु ततस्तेषां वानराणां महात्मनाम्।\nरक्षसां सम्बभूवाथ बलरोषः सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000450001, "chapter_id": 9450, "verse_number": "६-४३-२", "content_sanskrit": "ते हयैः काञ्चनापीडैर्गजैश्चाग्निशिखोपमैः।\nरथैश्चादित्यसंकाशैः कवचैश्च मनोरमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000450002, "chapter_id": 9450, "verse_number": "६-४३-३", "content_sanskrit": "निर्ययू राक्षसा वीरा नादयन्तो दिशो दश।\nराक्षसा भीमकर्माणो रावणस्य जयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000450003, "chapter_id": 9450, "verse_number": "६-४३-४", "content_sanskrit": "वानराणामपि चमूर्बृहती जयमिच्छताम्।\nअभ्यधावत तां सेनां रक्षसां घोरकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000450004, "chapter_id": 9450, "verse_number": "६-४३-५", "content_sanskrit": "एतस्मिन्नन्तरे तेषामन्योन्यमभिधावताम्।\nरक्षसां वानराणां च द्वन्द्वयुद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000450005, "chapter_id": 9450, "verse_number": "६-४३-६", "content_sanskrit": "अङ्गदेनेन्द्रजित्सार्धं वालिपुत्रेण राक्षसः।\nअयुध्यत महातेजास्त्र्यम्बकेण यथान्धकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000450006, "chapter_id": 9450, "verse_number": "६-४३-७", "content_sanskrit": "प्रजङ्घेन च सम्पातिर्नित्यं दुर्धर्षणो रणे।\nजम्बुमालिनमारब्धो हनूमानपि वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000450007, "chapter_id": 9450, "verse_number": "६-४३-८", "content_sanskrit": "संगतस्तु महाक्रोधो राक्षसो रावणानुजः।\nसमरे तीक्ष्णवेगेन शत्रुघ्नेन विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000450008, "chapter_id": 9450, "verse_number": "६-४३-९", "content_sanskrit": "तपनेन गजः सार्धं राक्षसेन महाबलः।\nनिकुम्भेन महातेजा नीलोऽपि समयुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000450009, "chapter_id": 9450, "verse_number": "६-४३-१०", "content_sanskrit": "वानरेन्द्रस्तु सुग्रीवः प्रघसेन सुसंगतः।\nसंगतः समरे श्रीमान् विरूपाक्षेण लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000450010, "chapter_id": 9450, "verse_number": "६-४३-११", "content_sanskrit": "अग्निकेतुः सुदुर्धर्षो रश्मिकेतुश्च राक्षसः।\nसुप्तघ्नो यज्ञकोपश्च रामेण सह संगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000450011, "chapter_id": 9450, "verse_number": "६-४३-१२", "content_sanskrit": "वज्रमुष्टिश्च मैन्देन द्विविदेनाशनिप्रभः।\nराक्षसाभ्यां सुघोराभ्यां कपिमुख्यौ समागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000450012, "chapter_id": 9450, "verse_number": "६-४३-१३", "content_sanskrit": "वीरः प्रतपनो घोरो राक्षसो रणदुर्धरः।\nसमरे तीक्ष्णवेगेन नलेन समयुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000450013, "chapter_id": 9450, "verse_number": "६-४३-१४", "content_sanskrit": "धर्मस्य पुत्रो बलवान् सुषेण इति विश्रुतः।\nस विद्युन्मालिना सार्धमयुध्यत महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000450014, "chapter_id": 9450, "verse_number": "६-४३-१५", "content_sanskrit": "वानराश्चापरे घोरा राक्षसैरपरैः सह।\nद्वन्द्वं समीयुः सहसा युद्‍ध्वा च बहुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000450015, "chapter_id": 9450, "verse_number": "६-४३-१६", "content_sanskrit": "तत्रासीत् सुमहद् युद्धं तुमुलं रोमहर्षणम्।\nरक्षसां वानराणां च वीराणां जयमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000450016, "chapter_id": 9450, "verse_number": "६-४३-१७", "content_sanskrit": "हरिराक्षसदेहेभ्यः प्रभूताः केशशाद्वलाः।\nशरीरसंघाटवहाः प्रसुस्रुः शोणतापगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000450017, "chapter_id": 9450, "verse_number": "६-४३-१८", "content_sanskrit": "आजघानेन्द्रजित् क्रुद्धो वज्रेणेव शतक्रतुः।\nअङ्गदं गदया वीरं शत्रुसैन्यविदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000450018, "chapter_id": 9450, "verse_number": "६-४३-१९", "content_sanskrit": "तस्य काञ्चनचित्राङ्गं रथं साश्वं ससारथिम्।\nजघान गदया श्रीमानङ्गदो वेगवान् हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000450019, "chapter_id": 9450, "verse_number": "६-४३-२०", "content_sanskrit": "सम्पातिस्तु प्रजङ्घेन त्रिभिर्बाणैः समाहतः।\nनिजघानाश्वकर्णेन प्रजङ्घं रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000450020, "chapter_id": 9450, "verse_number": "६-४३-२१", "content_sanskrit": "जम्बुमाली रथस्थस्तु रथशक्त्या महाबलः।\nबिभेद समरे क्रुद्धो हनूमन्तं स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000450021, "chapter_id": 9450, "verse_number": "६-४३-२२", "content_sanskrit": "तस्य तं रथमास्थाय हनूमान् मारुतात्मजः।\nप्रममाथ तलेनाशु सह तेनैव रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000450022, "chapter_id": 9450, "verse_number": "६-४३-२३", "content_sanskrit": "नदन् प्रतपनो घोरो नलं सोऽभ्यनुधावत।\nनलः प्रतपनस्याशु पातयामास चक्षुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000450023, "chapter_id": 9450, "verse_number": "६-४३-२४", "content_sanskrit": "भिन्नगात्रः शरैस्तीक्ष्णैः क्षिप्रहस्तेन रक्षसा।\nग्रसन्तमिव सैन्यानि प्रघसं वानराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000450024, "chapter_id": 9450, "verse_number": "६-४३-२५", "content_sanskrit": "सुग्रीवः सप्तपर्णेन निजघान जवेन च।\nप्रपीड्य शरवर्षेण राक्षसं भीमदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000450025, "chapter_id": 9450, "verse_number": "६-४३-२६", "content_sanskrit": "निजघान विरूपाक्षं शरेणैकेन लक्ष्मणः।\nअग्निकेतुश्च दुर्धर्षो रश्मिकेतुश्च राक्षसः।\nसुप्तघ्नो यज्ञकोपश्च रामं निर्बिभिदुः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000450026, "chapter_id": 9450, "verse_number": "६-४३-२७", "content_sanskrit": "तेषां चतुर्णां रामस्तु शिरांसि समरे शरैः।\nक्रुद्धश्चतुर्भिश्चिच्छेद घोरैरग्निशिखोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000450027, "chapter_id": 9450, "verse_number": "६-४३-२८", "content_sanskrit": "वज्रमुष्टिस्तु मैन्देन मुष्टिना निहतो रणे।\nपपात सरथः साश्वः पुराट्ट इव भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000450028, "chapter_id": 9450, "verse_number": "६-४३-२९", "content_sanskrit": "निकुम्भस्तु रणे नीलं नीलाञ्जनचयप्रभम्।\nनिर्बिभेद शरैस्तीक्ष्णैः करैर्मेघमिवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000450029, "chapter_id": 9450, "verse_number": "६-४३-३०", "content_sanskrit": "पुनः शरशतेनाथ क्षिप्रहस्तो निशाचरः।\nबिभेद समरे नीलं निकुम्भः प्रजहास च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000450030, "chapter_id": 9450, "verse_number": "६-४३-३१", "content_sanskrit": "तस्यैव रथचक्रेण नीलो विष्णुरिवाहवे।\nशिरश्चिच्छेद समरे निकुम्भस्य च सारथेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000450031, "chapter_id": 9450, "verse_number": "६-४३-३२", "content_sanskrit": "वज्राशनिसमस्पर्शो द्विविदोऽप्यशनिप्रभम्।\nजघान गिरिशृङ्गेण मिषतां सर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000450032, "chapter_id": 9450, "verse_number": "६-४३-३३", "content_sanskrit": "द्विविदं वानरेन्द्रं तु द्रुमयोधिनमाहवे।\nशरैरशनिसंकाशैः स विव्याधाशनिप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000450033, "chapter_id": 9450, "verse_number": "६-४३-३४", "content_sanskrit": "स शरैरभिविद्धाङ्गो द्विविदः क्रोधर्मूच्छितः।\nसालेन सरथं साश्वं निजघानाशनिप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000450034, "chapter_id": 9450, "verse_number": "६-४३-३५", "content_sanskrit": "विद्युन्माली रथस्थस्तु शरैः काञ्चनभूषणैः।\nसुषेणं ताडयामास ननाद च मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000450035, "chapter_id": 9450, "verse_number": "६-४३-३६", "content_sanskrit": "तं रथस्थमथो दृष्ट्वा सुषेणो वानरोत्तमः।\nगिरिशृङ्गेण महता रथमाशु न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000450036, "chapter_id": 9450, "verse_number": "६-४३-३७", "content_sanskrit": "लाघवेन तु संयुक्तो विद्युन्माली निशाचरः।\nअपक्रम्य रथात् तूर्णं गदापाणिः क्षितौ स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000450037, "chapter_id": 9450, "verse_number": "६-४३-३८", "content_sanskrit": "ततः क्रोधसमाविष्टः सुषेणो हरिपुङ्गवः।\nशिलां सुमहतीं गृह्य निशाचरमभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000450038, "chapter_id": 9450, "verse_number": "६-४३-३९", "content_sanskrit": "तमापतन्तं गदया विद्युन्माली निशाचरः।\nवक्षस्यभिजघानाशु सुषेणं हरिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000450039, "chapter_id": 9450, "verse_number": "६-४३-४०", "content_sanskrit": "गदाप्रहारं तं घोरमचिन्त्य प्लवगोत्तमः।\nतां तूष्णीं पातयामास तस्योरसि महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000450040, "chapter_id": 9450, "verse_number": "६-४३-४१", "content_sanskrit": "शिलाप्रहाराभिहतो विद्युन्माली निशाचरः।\nनिष्पिष्टहृदयो भूमौ गतासुर्निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000450041, "chapter_id": 9450, "verse_number": "६-४३-४२", "content_sanskrit": "एवं तैर्वानरैः शूरैः शूरास्ते रजनीचराः।\nद्वन्द्वे विमथितास्तत्र दैत्या इव दिवौकसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000450042, "chapter_id": 9450, "verse_number": "६-४३-४३", "content_sanskrit": "भल्लैश्चान्यैर्गदाभिश्च शक्तितोमरसायकैः।\nअपविद्धैश्चापि रथैस्तथा सांग्रामिकैर्हयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000450043, "chapter_id": 9450, "verse_number": "६-४३-४४", "content_sanskrit": "निहतैः कुञ्जरैर्मत्तैस्तथा वानरराक्षसैः।\nचक्राक्षयुगदण्डैश्च भग्नैर्धरणिसंश्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000450044, "chapter_id": 9450, "verse_number": "६-४३-४५", "content_sanskrit": "बभूवायोधनं घोरं गोमायुगणसेवितम्।\nकबन्धानि समुत्पेतुर्दिक्षु वानररक्षसाम्।\nविमर्दे तुमुले तस्मिन् देवासुररणोपमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000450045, "chapter_id": 9450, "verse_number": "६-४३-४६", "content_sanskrit": "निहन्यमाना हरिपुङ्गवैस्तदा\nनिशाचराः शोणितगन्धमूर्च्छिताः।\nपुनः सुयुद्धं तरसा समाश्रिता\nदिवाकरस्यास्तमयाभिकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000450046, "chapter_id": 9450, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]