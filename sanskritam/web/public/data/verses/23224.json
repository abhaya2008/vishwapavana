[{"id": 7003224000, "chapter_id": 23224, "verse_number": "१-२७-१", "content_sanskrit": "शैलादिरुवाच  ।\nवक्ष्यामि श्रृणु संक्षोपाल्लिंगार्चनविधिक्रमम्  ।\nवक्तुं वर्षशतेनापि न शक्यं विस्तरेण यत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003224001, "chapter_id": 23224, "verse_number": "१-२७-२", "content_sanskrit": "एवं स्नात्वा यथान्यायं पूजास्थानं प्रविश्य च  ।\nप्राणायामत्रयं कृत्वा ध्यायेद्देवं त्रियंबकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003224002, "chapter_id": 23224, "verse_number": "१-२७-३", "content_sanskrit": "पंचवक्त्रं दश भुज शुद्धस्फटिकसन्निभम्  ।\nसर्वाभरणसंयुक्तं चित्रांबरविभूषितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003224003, "chapter_id": 23224, "verse_number": "१-२७-४", "content_sanskrit": "तस्य रूपं समाश्रित्य दाहनप्लावनादिभिः  ।\nशैवीं तनुं समास्थाय पूजयेत्परमेश्वरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003224004, "chapter_id": 23224, "verse_number": "१-२७-५", "content_sanskrit": "देहशुद्धिं च कृत्वैव मूलमंत्रं न्यसेत् क्रमात्  ।\nसर्वत्र प्रणवेनैव ब्रह्माणि च यथाक्रमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003224005, "chapter_id": 23224, "verse_number": "१-२७-६", "content_sanskrit": "सूत्रे नमः शिवायेति छंदांसि परमे शुभे  ।\nमंत्राणि सूक्ष्मरूपेण संस्थितानि यतस्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003224006, "chapter_id": 23224, "verse_number": "१-२७-७", "content_sanskrit": "न्यग्रोधबीजे न्यग्रोधस्तथा सूत्रे तु शोभने  ।\nमहत्यपि महद्ब्रह्म संस्थितं सूक्ष्मवत्स्वयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003224007, "chapter_id": 23224, "verse_number": "१-२७-८", "content_sanskrit": "सेचयेदर्चनस्थानं गंधचंदनवारिणा  ।\nद्रव्याणि शोधयेत्पश्चात्क्षालनप्रोक्षणादिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003224008, "chapter_id": 23224, "verse_number": "१-२७-९", "content_sanskrit": "क्षालनं प्रोक्षणं चैव प्रणवेन विधीयते  ।\nप्रोक्षणी चार्घ्यपात्रं च पाद्यपात्रमनुक्रमत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003224009, "chapter_id": 23224, "verse_number": "१-२७-१०", "content_sanskrit": "तथा ह्याचमनीयार्थं कल्पितं पात्रमेव च  ।\nस्थापयेद्विधिना धीमानवगुंठ्य यथाविधि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003224010, "chapter_id": 23224, "verse_number": "१-२७-११", "content_sanskrit": "दर्भैराच्छादयेच्चैव प्रोक्षयेच्छुद्धवारिणा  ।\nतेषु तेष्वथ सर्वेषु क्षिपेत्तोयं सुशीतलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003224011, "chapter_id": 23224, "verse_number": "१-२७-१२", "content_sanskrit": "प्रणवेन क्षिपेत्तेषु द्रव्याण्यालोक्य बुद्धिमान्  ।\nउशीरं चंदनं चैव पाद्ये तु परिकल्पयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003224012, "chapter_id": 23224, "verse_number": "१-२७-१३", "content_sanskrit": "जातिकंकोलकर्पूरबहुमूलतमालकम्  ।\nचूर्णयित्वा यथान्यायं क्षिपेदाचमनीयके ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003224013, "chapter_id": 23224, "verse_number": "१-२७-१४", "content_sanskrit": "एवं सर्वेषु पात्रेषु दापयेच्चंदनं तथा  ।\nकर्पूरं च यथान्यायं पुष्पाणि विविधानि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003224014, "chapter_id": 23224, "verse_number": "१-२७-१५", "content_sanskrit": "कुशाग्रमक्षतांश्चैव यवव्रीहितिलानि च  ।\nआज्यसिद्धार्थपुष्पाणि भसितं चार्घ्यपात्रके ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003224015, "chapter_id": 23224, "verse_number": "१-२७-१६", "content_sanskrit": "कुशपुष्पयवव्रीहिबहुमूलतमालकम्  ।\nदापयेत्प्रोक्षणीपात्रे भसितं प्रणवेन च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003224016, "chapter_id": 23224, "verse_number": "१-२७-१७", "content_sanskrit": "न्यसेत्पंचाक्षरं चैव गायत्रीं रुद्रदेवताम्  ।\nकेवलं प्रणवं वापि वेदसारमनुत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003224017, "chapter_id": 23224, "verse_number": "१-२७-१८", "content_sanskrit": "अथ संप्रोक्षयेत्पश्चाद्द्रव्याणि प्रणवेन तु  ।\nप्रोक्षणीपात्रसंस्थेन ईशानाद्यैश्च पंचभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003224018, "chapter_id": 23224, "verse_number": "१-२७-१९", "content_sanskrit": "पार्श्वतो देवदेवस्य नंदिनं मां समर्चयेत्  ।\nदीप्तानलायुतप्रख्यं त्रिनेत्रं त्रिदशेश्वरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003224019, "chapter_id": 23224, "verse_number": "१-२७-२०", "content_sanskrit": "बालेंदुमुकुटं चैव हरिवक्त्रं चतुर्भुजम्  ।\nपुष्पमालाधरं सौम्यं सर्वाभरणभूषितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003224020, "chapter_id": 23224, "verse_number": "१-२७-२१", "content_sanskrit": "उत्तरे चात्मनः पुण्यां भार्यां च मरुतां शुभाम्  ।\nसुयशां सुव्रतां चांबापादमंडनतत्पराम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003224021, "chapter_id": 23224, "verse_number": "१-२७-२२", "content_sanskrit": "एवं पूज्य प्रविश्यांतर्भवनं परमेष्ठिनः  ।\nदत्त्वा पुष्पांजलिं भक्त्या पंचमूर्धसु पंचभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003224022, "chapter_id": 23224, "verse_number": "१-२७-२३", "content_sanskrit": "गंधपुष्पैस्तथा धूपैर्विविधैः पूज्य शंकरम्  ।\nस्कंदं विनायकं देवीं लिंगशुद्धिं च कारयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003224023, "chapter_id": 23224, "verse_number": "१-२७-२४", "content_sanskrit": "जप्त्वा सर्वाणि मंत्राणि प्रणवादिनमेंतकम्  ।\nकल्पयेदासनं पश्चात्पद्माख्यं प्रणवेन तत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003224024, "chapter_id": 23224, "verse_number": "१-२७-२५", "content_sanskrit": "तस्य पूर्वदलं साक्षादणिमामयमक्षरम्  ।\nलघिमा दक्षिणं चैव महिमा पश्चिमं तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003224025, "chapter_id": 23224, "verse_number": "१-२७-२६", "content_sanskrit": "प्राप्तिस्तथोत्तरं पत्रं प्राकाम्यं पावकस्य तु  ।\nईशित्वं नैऋतं पत्रं वशित्वं वायुगोचरे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003224026, "chapter_id": 23224, "verse_number": "१-२७-२७", "content_sanskrit": "सर्वज्ञत्वं तथैशान्यं कर्णिका सोम उच्यते  ।\nसोमस्याधस्तथा सूर्यस्तस्याधः पावकः स्वयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003224027, "chapter_id": 23224, "verse_number": "१-२७-२८", "content_sanskrit": "धर्मादयो विदिक्ष्वेते त्वनंतं कल्पयेत्क्रमात्  ।\nअव्यक्तादिचतुर्दिक्षु सोमस्यांते गुणत्रयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003224028, "chapter_id": 23224, "verse_number": "१-२७-२९", "content_sanskrit": "आत्मत्रयं ततश्चोर्ध्वं तस्यांते शिवपीठिका  ।\nसद्योजातं प्रपद्यामीत्यावाह्य परमेश्वरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003224029, "chapter_id": 23224, "verse_number": "१-२७-३०", "content_sanskrit": "वामदेवेन मंत्रेण स्थापयेदासनोपरि  ।\nसान्निध्यं रुद्रगायत्र्या अघोरेण निरुद्ध्य च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003224030, "chapter_id": 23224, "verse_number": "१-२७-३१", "content_sanskrit": "ईशानः सर्वविद्यानामिति मंत्रेण पूजयेत्  ।\nपाद्यमाचमनीयं च विभोश्चार्घ्यं प्रदापयेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003224031, "chapter_id": 23224, "verse_number": "१-२७-३२", "content_sanskrit": "स्नापयेद्विधिना रुद्रं गंधचंदनवारिणा  ।\nपंचगव्य विधानेन गृह्य पात्रेभिमंत्र्य च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003224032, "chapter_id": 23224, "verse_number": "१-२७-३३", "content_sanskrit": "प्रणवेनैव गव्यैस्तु स्नापयेच्च यथाविधि  ।\nआज्येन मधुना चैव तथा चेक्षुरसेन च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003224033, "chapter_id": 23224, "verse_number": "१-२७-३४", "content_sanskrit": "पुण्यैर्द्रव्यैर्महादेवं प्रणवेनाभिषेचयेत्  ।\nजलभांडैः पवित्रैस्तु मंत्रैस्तोयं क्षिपेत्ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003224034, "chapter_id": 23224, "verse_number": "१-२७-३५", "content_sanskrit": "शुद्धिं कृत्वा यथान्यायं सितवस्त्रेण साधकः  ।\nकुशापामार्गकर्पूरजातिपुष्पकचंपकैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003224035, "chapter_id": 23224, "verse_number": "१-२७-३६", "content_sanskrit": "करवीरैः सितैश्चैव मल्लिकाकमलोत्पलैः  ।\nआपूर्य पुष्पैः सुशुभैः चंदनाद्यैश्च तज्जलम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003224036, "chapter_id": 23224, "verse_number": "१-२७-३७", "content_sanskrit": "न्यसेन्मंत्राणि तत्तोये सद्योजातादिकानि तु  ।\nसुवर्णकलशेनाथ तथा वै राजतेन वा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003224037, "chapter_id": 23224, "verse_number": "१-२७-३८", "content_sanskrit": "ताम्रेण पद्मपत्रेण पालाशेन दलेन वा  ।\nशंखेन मृन्मयेनाथ शोधितेन शुभेन वा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003224038, "chapter_id": 23224, "verse_number": "१-२७-३९", "content_sanskrit": "सकूर्चेन सपुष्पेण स्नापयेन्मंत्रपूर्वकम्  ।\nमंत्राणि ते प्रवक्ष्यामि श्रृणु सर्वार्थसिद्धये ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003224039, "chapter_id": 23224, "verse_number": "१-२७-४०", "content_sanskrit": "यैर्लिंगं सकृदप्येवं स्नाप्य मुच्येत मानवः  ।\nपवमानेन मंत्रज्ञाः तथा वामीयकेन च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003224040, "chapter_id": 23224, "verse_number": "१-२७-४१", "content_sanskrit": "रुद्रेण नीलरुद्रेण श्रीसुक्तेन शुभेन च  ।\nरजनीसूक्तकेनैव चमकेन शुभेन च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003224041, "chapter_id": 23224, "verse_number": "१-२७-४२", "content_sanskrit": "होतारेणाथ शिरसा अर्थर्वेण शुभेन च  ।\nशांत्या चाथ पुनः शान्त्या भारुंडेनारुणेन च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003224042, "chapter_id": 23224, "verse_number": "१-२७-४३", "content_sanskrit": "वारुणेन च ज्येष्टेन तथा वेदव्रतेन च  ।\nतथांतरेण पुण्येन सूक्तेन पुरुषेण च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003224043, "chapter_id": 23224, "verse_number": "१-२७-४४", "content_sanskrit": "त्वरितेनैव रुद्रेण कपिना च कपिर्दिना  ।\nआवोसजेति साम्ना तु बृहच्चंद्रेण विष्णुना ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003224044, "chapter_id": 23224, "verse_number": "१-२७-४५", "content_sanskrit": "विरूपाक्षेण स्कंदेन शतऋग्भिः शिवौस्तथा  ।\nपंच ब्रह्मैश्च सूत्रेण केवलप्रणवेन च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003224045, "chapter_id": 23224, "verse_number": "१-२७-४६", "content_sanskrit": "स्नापयेद्देवदेवेशं सर्वपापप्रशांतये  ।\nवस्त्रं शिवोपवीतं च तथा ह्याचमनीयकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003224046, "chapter_id": 23224, "verse_number": "१-२७-४७", "content_sanskrit": "गंधं पुष्पं तथा धूपं दीपमन्नं क्रमेण तु  ।\nतोयं सुगंधितं चैव पुनराचमनीयकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003224047, "chapter_id": 23224, "verse_number": "१-२७-४८", "content_sanskrit": "मुकुटं च शुभं छन्नं तथा वै भूषणानि च  ।\nदापयेत्प्रणवेनैव मुखवासादिकानि च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003224048, "chapter_id": 23224, "verse_number": "१-२७-४९", "content_sanskrit": "ततः स्फटिकसंकाशं देव निष्कलमक्षरम्  ।\nकारणं सर्वदेवानां सर्वलोकमयं परम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003224049, "chapter_id": 23224, "verse_number": "१-२७-५०", "content_sanskrit": "ब्रह्मेंद्रविष्णुरुद्राद्यैर्ऋषिदेवैरगोचरम्  ।\nवेदविद्भिर्हि वेदान्तैस्त्वगोचरमिति श्रुतिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003224050, "chapter_id": 23224, "verse_number": "१-२७-५१", "content_sanskrit": "आदिमध्यांतरहितं भेषजं भवरोगिणाम्  ।\nशिवतत्त्वमिति ख्यातं शिवलिंगे व्यवस्थितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003224051, "chapter_id": 23224, "verse_number": "१-२७-५२", "content_sanskrit": "प्रणवेनैव मंत्रेण पूजयेल्लिंगमूर्धनि  ।\nस्तोत्रं जपेच्च विधिना नमस्कारं प्रदक्षिणम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003224052, "chapter_id": 23224, "verse_number": "१-२७-५३", "content_sanskrit": "अर्घ्यां दत्त्वाथ पुष्पाणि पादयोस्तु विकीर्य च  ।\nप्रणिपत्य च देवेशमात्मन्यारोपयेच्छिवम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003224053, "chapter_id": 23224, "verse_number": "१-२७-५४", "content_sanskrit": "एवं संक्षिप्य कथितं लिंगार्चनमनुत्तमम्  ।\nआभ्यंतरं प्रवक्ष्यामि लिंगार्चनमिहाद्य ते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]