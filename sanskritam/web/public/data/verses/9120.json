[{"id": 5000120000, "chapter_id": 9120, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे त्रिचत्वारिशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000120001, "chapter_id": 9120, "verse_number": "२-४३-१", "content_sanskrit": "ततः समीक्ष्य शयने सन्नं शोकेन पार्थिवम्।\nकौसल्या पुत्रशोकार्ता तमुवाच महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000120002, "chapter_id": 9120, "verse_number": "२-४३-२", "content_sanskrit": "राघवे नरशार्दूले विषं मुक्त्वाहिजिह्मगा।\nविचरिष्यति कैकेयी निर्मुक्तेव हि पन्नगी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000120003, "chapter_id": 9120, "verse_number": "२-४३-३", "content_sanskrit": "विवास्य रामं सुभगा लब्धकामा समाहिता।\nत्रासयिष्यति मां भूयो दुष्टाहिरिव वेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000120004, "chapter_id": 9120, "verse_number": "२-४३-४", "content_sanskrit": "अथास्मिन् नगरे रामश्चरन् भैक्षं गृहे वसेत्।\nकामकारो वरं दातुमपि दासं ममात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000120005, "chapter_id": 9120, "verse_number": "२-४३-५", "content_sanskrit": "पातयित्वा तु कैकेय्या रामं स्थानाद् यथेष्टतः।\nप्रविद्धो रक्षसां भागः पर्वणीवाहिताग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000120006, "chapter_id": 9120, "verse_number": "२-४३-६", "content_sanskrit": "नागराजगतिर्वीरो महाबाहुर्धनुर्धरः।\nवनमाविशते नूनं सभार्यः सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000120007, "chapter_id": 9120, "verse_number": "२-४३-७", "content_sanskrit": "वने त्वदृष्टदुःखानां कैकेय्यनुमते त्वया।\nत्यक्तानां वनवासाय कान्यावस्था भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000120008, "chapter_id": 9120, "verse_number": "२-४३-८", "content_sanskrit": "ते रत्नहीनास्तरुणाः फलकाले विवासिताः।\nकथं वत्स्यन्ति कृपणाः फलमूलैः कृताशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000120009, "chapter_id": 9120, "verse_number": "२-४३-९", "content_sanskrit": "अपीदानीं स कालः स्यान्मम शोकक्षयः शिवः।\nसहभार्यं सह भ्रात्रा पश्येयमिह राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000120010, "chapter_id": 9120, "verse_number": "२-४३-१०", "content_sanskrit": "श्रुत्वैवोपस्थितौ वीरौ कदायोध्या भविष्यति।\nयशस्विनी हृष्टजना सूच्छ्रितध्वजमालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000120011, "chapter_id": 9120, "verse_number": "२-४३-११", "content_sanskrit": "कदा प्रेक्ष्य नरव्याघ्रावरण्यात् पुनरागतौ।\nभविष्यति पुरी हृष्टा समुद्र इव पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000120012, "chapter_id": 9120, "verse_number": "२-४३-१२", "content_sanskrit": "कदायोध्यां महाबाहुः पुरीं वीरः प्रवेक्ष्यति।\nपुरस्कृत्य रथे सीतां वृषभो गोवधूमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000120013, "chapter_id": 9120, "verse_number": "२-४३-१३", "content_sanskrit": "कदा प्राणिसहस्राणि राजमार्गे ममात्मजौ।\nलाजैरवकरिष्यन्ति प्रविशन्तावरिंदमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000120014, "chapter_id": 9120, "verse_number": "२-४३-१४", "content_sanskrit": "प्रविशन्तौ कदायोध्यां द्रक्ष्यामि शुभकुण्डलौ।\nउदग्रायुधनिस्त्रिंशौ सशृङ्गाविव पर्वतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000120015, "chapter_id": 9120, "verse_number": "२-४३-१५", "content_sanskrit": "कदा सुमनसः कन्या द्विजातीनां फलानि च।\nप्रदिशन्त्यः पुरीं हृष्टाः करिष्यन्ति प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000120016, "chapter_id": 9120, "verse_number": "२-४३-१६", "content_sanskrit": "कदा परिणतो बुद्ध्या वयसा चामरप्रभाः।\nअभ्युपैष्यति धर्मात्मा सुवर्ष इव लालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000120017, "chapter_id": 9120, "verse_number": "२-४३-१७", "content_sanskrit": "निःसंशयं मया मन्ये पुरा वीर कदर्यया।\nपातुकामेषु वत्सेषु मातॄणां शातिताः स्तनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000120018, "chapter_id": 9120, "verse_number": "२-४३-१८", "content_sanskrit": "साहं गौरिव सिंहेन विवत्सा वत्सला कृता।\nकैकेय्या पुरुषव्याघ्र बालवत्सेव गौर्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000120019, "chapter_id": 9120, "verse_number": "२-४३-१९", "content_sanskrit": "नहि तावद्‍गुणैर्जुष्टं सर्वशास्त्रविशारदम्।\nएकपुत्रा विना पुत्रमहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000120020, "chapter_id": 9120, "verse_number": "२-४३-२०", "content_sanskrit": "न हि मे जीविते किंचित् सामर्थ्यमिह कल्प्यते।\nअपश्यन्त्याः प्रियं पुत्रं लक्ष्मणं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000120021, "chapter_id": 9120, "verse_number": "२-४३-२१", "content_sanskrit": "अयं हि मां दीपयतेऽद्य वह्नि-\nस्तनूजशोकप्रभवो महाहितः।\nमहीमिमां रश्मिभिरुत्तमप्रभो\nयथा निदाघे भगवान् दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000120022, "chapter_id": 9120, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे त्रिचत्वारिशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]