[{"id": 7002231000, "chapter_id": 22231, "verse_number": "२७६-१", "content_sanskrit": "अग्निरुवाच ।\nकश्यपो वसुदेवोऽभूद्देवकी चादितिर्व्वरा ।\nदेवक्यां वसुदेवात्तु कृष्णोऽभूत्तपसान्वितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002231001, "chapter_id": 22231, "verse_number": "२७६-२", "content_sanskrit": "धर्म्मसंरक्षणार्थाय ह्यधर्म्महरणाय च ।\nसुरादेः पालनार्थञ्च दैत्यादेर्म्मथनाय च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002231002, "chapter_id": 22231, "verse_number": "२७६-३", "content_sanskrit": "रुक्मिणी सत्यभामा च सत्या नग्नजिती प्रिया ।\nसत्यभामा हरेः सेव्या गान्धारी लक्ष्मणा तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002231003, "chapter_id": 22231, "verse_number": "२७६-४", "content_sanskrit": "मित्रविन्दा१ च कालिन्दी देवी जाम्बवती तथा ।\nसुशीला च तथा माद्री कौशल्या विजया जया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002231004, "chapter_id": 22231, "verse_number": "२७६-५", "content_sanskrit": "एवमादीनि देवीनां सहस्राणि तु षोड़श ।\nप्रद्युम्नाद्याश्च रुक्मिण्यां भीमाद्याः सत्यभामया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002231005, "chapter_id": 22231, "verse_number": "२७६-६", "content_sanskrit": "जाम्बवत्याञ्च शाम्बाद्याः कृष्णस्यासंस्तथापरे ।\nशतं शतसहस्राणां पुत्राणां तस्य धीमतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002231006, "chapter_id": 22231, "verse_number": "२७६-७", "content_sanskrit": "अशीतिश्च सहस्राणि यादवाः कृष्णरक्षिताः ।\nप्रद्युम्नस्य तु वैदर्भ्यामनिरुद्धो रणप्रियः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002231007, "chapter_id": 22231, "verse_number": "२७६-८", "content_sanskrit": "अनिरुद्धस्य वज्राद्या यादवाः सुमहावलाः ।\nतिस्रः कोट्यो यादवानां षष्टिर्लक्षाणि दानवाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002231008, "chapter_id": 22231, "verse_number": "२७६-९", "content_sanskrit": "मनुष्ये बाधका ये तु नन्नाशाय बभूव सः ।\nकर्त्तु कर्मव्यवस्थानं मनुष्यो जायते हरिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002231009, "chapter_id": 22231, "verse_number": "२७६-१०", "content_sanskrit": "देवासुराणां सङ्ग्रामा दायार्थं द्वादशाभवन् ।\nप्रथमो नारसिंहस्तु द्वितीयो वामनो रणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002231010, "chapter_id": 22231, "verse_number": "२७६-११", "content_sanskrit": "सङ्ग्रामस्त्वथ वाराहश्चतुर्थोऽमृतमन्थनः ।\nतारकामयसङ्ग्रामः षष्ठो ह्याजीवको रणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002231011, "chapter_id": 22231, "verse_number": "२७६-१२", "content_sanskrit": "त्रैपुरश्चान्धकबधो नवमो वृत्रघातकः ।\nजितो हालाहलश्चाथ घोरः कोलाहलो रणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002231012, "chapter_id": 22231, "verse_number": "२७६-१३", "content_sanskrit": "हिरण्यकशिपोश्चोरो विदार्य्य च नखैः पुरा ।\nनारसिंहो देवपालः प्रह्लादं कृतवान् नृपम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002231013, "chapter_id": 22231, "verse_number": "२७६-१४", "content_sanskrit": "देवासुरे वामनश्च छतित्वा बलिमूर्ज्जतम् ।\nमहेन्द्राय ददौ राज्यं काश्यपोऽदितिसम्भवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002231014, "chapter_id": 22231, "verse_number": "२७६-१५", "content_sanskrit": "वराहस्तु हिरण्याक्षं हत्वा देवानपालयत् ।\nउज्जहार भुवं मग्नां देवदेवैरभिष्टुतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002231015, "chapter_id": 22231, "verse_number": "२७६-१६", "content_sanskrit": "मन्थानं मन्दरं कृत्वा नेत्रं कृत्वा तु वासुकिम् ।\nसुरासुरैश्च मथितं२ देवेभ्यश्चामृतं ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002231016, "chapter_id": 22231, "verse_number": "२७६-१७", "content_sanskrit": "तारकामयसङ्ग्रामे तदा देवाश्च पालिताः ।\nनिवार्य्येन्द्रं गुरून् देवान् दानवान्सोमवंशकृत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002231017, "chapter_id": 22231, "verse_number": "२७६-१८", "content_sanskrit": "विश्वामित्रवशिष्ठात्रिकवयश्च रणे सुरान् ।\nअपालयन्ते निर्व्यार्य्य रगद्वेषादिदानवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002231018, "chapter_id": 22231, "verse_number": "२७६-१९", "content_sanskrit": "पृथ्वीरथे ब्रह्मयन्तुरीशस्य शरणो हरिः ।\nददाह त्रिपुरं देवपालको दैत्यमर्दनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002231019, "chapter_id": 22231, "verse_number": "२७६-२०", "content_sanskrit": "गौरीं जिहीर्षुणा रुद्रमन्धकेनार्दितं हरिः ।\nअनुरक्तश्च रेवत्यां चक्रेचान्धासुरार्दनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002231020, "chapter_id": 22231, "verse_number": "२७६-२१", "content_sanskrit": "अपां फेनमयो भूत्वा देवासुररणे हरन् ।\nवृत्रे देवहरं विष्णुर्देवधर्म्मानपालयत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002231021, "chapter_id": 22231, "verse_number": "२७६-२२", "content_sanskrit": "शाल्वादीन् दानवान् जित्वा हरिः परशुरामकः ।\nअपालयत् सुरादींश्च दुष्टक्षत्रं निहत्य च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002231022, "chapter_id": 22231, "verse_number": "२७६-२३", "content_sanskrit": "हालाहलं विषं दैत्यं निराकृत्य महेश्वरात् ।\nभयं निर्णाशयामास देवानां मधुसूदनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002231023, "chapter_id": 22231, "verse_number": "२७६-२४", "content_sanskrit": "हालाहलं विषं यश्च दैत्यः कोलाहलो जितः ।\nपालिताश्च सुराः सर्व्वे विष्णुना धम्मपालनात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002231024, "chapter_id": 22231, "verse_number": "२७६-२५", "content_sanskrit": "देवासुरे रणे यश्च दैत्यः कोलाहलो जितः ।\nपालिताश्च सुराः सर्व्वे विष्णुना धर्म्मपालनात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002231025, "chapter_id": 22231, "verse_number": "२७६-२६", "content_sanskrit": "राजानो राजपुत्राश्च मुनयो देवता हरिः ।\nयदुक्तं यच्छ नैवोक्तमवतारा हरेरिमे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]