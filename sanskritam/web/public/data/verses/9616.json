[{"id": 5000616000, "chapter_id": 9616, "verse_number": "७-८१-१", "content_sanskrit": "स मुहूर्तादुपश्रुत्य देवर्षिरमितप्रभः ।\nस्वमाश्रमं शिष्यवृतः क्षुधार्तः सन्न्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000616001, "chapter_id": 9616, "verse_number": "७-८१-२", "content_sanskrit": "सो ऽपश्यदरजां दीनां रजसा समभिप्लुताम् ।\nज्योत्स्नामिव ग्रहग्रस्तां प्रत्यूषे न विराजतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000616002, "chapter_id": 9616, "verse_number": "७-८१-३", "content_sanskrit": "तस्य रोषः समभवत्क्षुधार्तस्य विशेषतः ।\nनिर्दहन्निव लोकांस्त्रीञ्छिष्यांश्चैतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000616003, "chapter_id": 9616, "verse_number": "७-८१-४", "content_sanskrit": "पश्यध्वं विपरीतस्य दण्डस्याविजितात्मनः ।\nविपत्तिं घोरसङ्काशां क्रुद्धामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000616004, "chapter_id": 9616, "verse_number": "७-८१-५", "content_sanskrit": "क्षयो ऽस्य दुर्मतेः प्राप्तः सानुगस्य दुरात्मनः ।\nयः प्रदीप्तां हुताशस्य शिखां वै स्प्रष्टुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000616005, "chapter_id": 9616, "verse_number": "७-८१-६", "content_sanskrit": "यस्मात्स कृतवान्पापमीदृशं घोरसंहितम् ।\nतस्मात्प्राप्स्यति दुर्मेधाः फलं पापस्य कर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000616006, "chapter_id": 9616, "verse_number": "७-८१-७", "content_sanskrit": "सप्तरात्रेण राजासौ सभृत्यबलवाहनः ।\nपापकर्मसमाचारो वधं प्राप्स्यति दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000616007, "chapter_id": 9616, "verse_number": "७-८१-८", "content_sanskrit": "समन्ताद्योजनशतं विषयं चास्य दुर्मतेः ।\nधक्ष्यते पांसुवर्षेण महता पाकशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000616008, "chapter_id": 9616, "verse_number": "७-८१-९", "content_sanskrit": "सर्वसत्वानि यानीह स्थावराणि चराणि च ।\nमहता पांसुवर्षेण विलयं सर्वतो ऽगमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000616009, "chapter_id": 9616, "verse_number": "७-८१-१०", "content_sanskrit": "दण्डस्य विषयो यावत्तावत्सर्वसमुच्छ्रयम् ।\nपांसुवर्षमिवालक्ष्यं सप्तरात्रं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000616010, "chapter_id": 9616, "verse_number": "७-८१-११", "content_sanskrit": "इत्युक्त्वा क्रोधताम्राक्षस्तदाश्रमनिवासिनम् ।\nजनं जनपदान्तेषु स्थीयतामिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000616011, "chapter_id": 9616, "verse_number": "७-८१-१२", "content_sanskrit": "श्रुत्वा तूशनसो वाक्यं सो ऽ ऽश्रमावसथो जनः ।\nनिष्क्रान्तो विषयात्तस्मात्स्थानं चक्रे ऽथ बाह्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000616012, "chapter_id": 9616, "verse_number": "७-८१-१३", "content_sanskrit": "स तथोक्त्वा मुनिजनमरजामिदमब्रवीत् ।\nइहैव वस दुर्मेधे आश्रमे सुसमाहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000616013, "chapter_id": 9616, "verse_number": "७-८१-१४", "content_sanskrit": "इदं योजनपर्यन्तं सरः सुरुचिरप्रभम् ।\nअरजे विज्वरा भुङ्क्ष्व कालश्चात्र प्रतीक्ष्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000616014, "chapter_id": 9616, "verse_number": "७-८१-१५", "content_sanskrit": "त्वत्समीपे च ये सत्त्वा वासमेष्यन्ति तां निशाम् ।\nअवध्याः पांसुवर्षेण ते भविष्यन्ति नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000616015, "chapter_id": 9616, "verse_number": "७-८१-१६", "content_sanskrit": "श्रुत्वा नियोगं ब्रह्मर्षेः सा ऽरजा भार्गवी तदा ।\nतथेति पितरं प्राह भार्गवं भृशदुःखिता ।\nइत्युक्त्वा भार्गवो वासमन्यत्र समकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000616016, "chapter_id": 9616, "verse_number": "७-८१-१७", "content_sanskrit": "तच्च राज्यं नरेन्द्रस्य सभृत्यबलवाहनम् ।\nसप्ताहाद्भस्मसाद्भूतं यथोक्तं ब्रह्मवादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000616017, "chapter_id": 9616, "verse_number": "७-८१-१८", "content_sanskrit": "तस्यासौ दण्डविषयो विन्ध्यशैवलयोर्नृप ।\nशप्तो ब्रह्मर्षिणा तेन वैधर्म्ये सहिते कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000616018, "chapter_id": 9616, "verse_number": "७-८१-१९", "content_sanskrit": "ततः प्रभृति काकुत्स्थ दण्डकारण्यमुच्यते ।\nतपस्विनः स्थिता ह्यत्र जनस्थानमतो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000616019, "chapter_id": 9616, "verse_number": "७-८१-२०", "content_sanskrit": "एतत्ते सर्वमाख्यातं यन्मां पृच्छसि राघव ।\nसन्ध्यामुपासितुं वीर समयो ह्यतिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000616020, "chapter_id": 9616, "verse_number": "७-८१-२१", "content_sanskrit": "एते महर्षयः सर्वे पूर्णकुम्भाः समन्ततः ।\nकृतोदका नरव्याघ्र आदित्यं पर्युपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000616021, "chapter_id": 9616, "verse_number": "७-८१-२२", "content_sanskrit": "स तैर्ब्राह्मणमभ्यस्तं सहितैर्ब्रह्मवित्तमैः ।\nरविरस्तं गतो राम गच्छोदकमुपस्पृश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000616022, "chapter_id": 9616, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]