[{"id": 7003625000, "chapter_id": 23625, "verse_number": "१-२-१२-१", "content_sanskrit": "नारद उवाच ।\nअथ ते ददृशुः पार्थ संयमस्थं महामुनिम् ।\nकूर्माख्यानंनामैकादशोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003625001, "chapter_id": 23625, "verse_number": "१-२-१२-२", "content_sanskrit": "जटास्त्रिषवणस्नानकपिलाः शिरसा तदा ।\nधारयन्तं लोमशाख्यमाज्यसिक्तमिवानलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003625002, "chapter_id": 23625, "verse_number": "१-२-१२-३", "content_sanskrit": "सव्यहस्ते तृणौघं च च्छायार्थे विप्रसत्तमम् ।\nदक्षिणे चाक्षमालां च बिभ्रतं मैत्रमार्गगम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003625003, "chapter_id": 23625, "verse_number": "१-२-१२-४", "content_sanskrit": "अहिंसयन्दुरुक्ताद्यैः प्राणिनो भूमिचारिणः ।\nयः सिद्धिमेति जप्येन स मैत्रो मुनिरुच्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003625004, "chapter_id": 23625, "verse_number": "१-२-१२-५", "content_sanskrit": "बकभूपद्विजोलूकगृध्रकूर्मा विलोक्य च ।\nनेमुः कलापग्रामे तं चिरंतनतपोनिधिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003625005, "chapter_id": 23625, "verse_number": "१-२-१२-६", "content_sanskrit": "स्वागतासनसत्कारेणामुना तेऽति सत्कृताः ।\nयथोचितं प्रतीतास्तमाहुः कार्यं हृदि स्थितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003625006, "chapter_id": 23625, "verse_number": "१-२-१२-७", "content_sanskrit": "कूर्म उवाच ।\nइन्द्रद्युम्नोऽयमवनीपतिः सत्रिजनाग्रणीः ।\nकीर्तिलोपान्निरस्तोऽयं वेधसा नाकपृष्ठतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003625007, "chapter_id": 23625, "verse_number": "१-२-१२-८", "content_sanskrit": "मार्कंडेयादिभिः प्राप्य कीर्त्युद्धारंच सत्तम ।\nनायं कामयते स्वर्गं पुनःपातादिभीषणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003625008, "chapter_id": 23625, "verse_number": "१-२-१२-९", "content_sanskrit": "भवतानुगृहीतोऽयमिहेच्छति महोदयम् ।\nप्रणोद्यस्तदयं भूपः शिष्यस्ते भगवन्मया ।\nत्वत्सकाशमिहानीतो ब्रूहि साध्वस्य वांछितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003625009, "chapter_id": 23625, "verse_number": "१-२-१२-१०", "content_sanskrit": "परोपकरणं नाम साधूनां व्रतमाहितम् ।\nविशेषतः प्रणोद्यानां शिष्यवृत्तिमुपेयुषाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003625010, "chapter_id": 23625, "verse_number": "१-२-१२-११", "content_sanskrit": "अप्रणोद्येषु पापेषु साधु प्रोक्तमसंशयम् ।\nविद्वेषं मरणं चापि कुरुतेऽन्यतरस्य च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003625011, "chapter_id": 23625, "verse_number": "१-२-१२-१२", "content_sanskrit": "अप्रमत्तः प्रणोद्येषु मुनिरेष प्रयच्छति ।\nतदेवेति भवानेवं धर्मं वेत्ति कुतो वयम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003625012, "chapter_id": 23625, "verse_number": "१-२-१२-१३", "content_sanskrit": "लोमश उवाच ।\nकूर्म युक्तमिदं सर्वं त्वयाभिहितमद्य नः ।\nधर्मशास्त्रोपनतं तत्स्मारिताः स्म पुरातनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003625013, "chapter_id": 23625, "verse_number": "१-२-१२-१४", "content_sanskrit": "ब्रूहि राजन्सुविश्रब्धं सन्देहं हृदयस्थितम् ।\nकस्ते किमब्रवीच्छेषं वक्ष्याम्यहं न संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003625014, "chapter_id": 23625, "verse_number": "१-२-१२-१५", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nभगवन्प्रथमः प्रश्रस्तावदेव ममोच्यताम् ।\nग्रीष्मकालेऽपि मध्यस्थै रवौ किं न तवाश्रमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003625015, "chapter_id": 23625, "verse_number": "१-२-१२-१६", "content_sanskrit": "कुटीमात्रोऽपि यच्छाया तृणैः शिरसि पाणिगैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003625016, "chapter_id": 23625, "verse_number": "१-२-१२-१७", "content_sanskrit": "लोमश उवाच ।\nमर्तव्यमस्त्यवश्यं च काय एष पतिष्यति ।\nकस्यार्थे क्रियते गेहमनित्यभवमध्यगैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003625017, "chapter_id": 23625, "verse_number": "१-२-१२-१८", "content_sanskrit": "यस्य मृत्युर्भवेन्मित्रं पीतं वाऽमृतमुत्तमम् ।\nतस्यैतदुचितं वक्तुमिदं मे श्वो भविष्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003625018, "chapter_id": 23625, "verse_number": "१-२-१२-१९", "content_sanskrit": "इदं युगसहस्रेषु भविष्यमभविद्दिनम् ।\nतदप्यद्यत्वमापन्नं का कथामरणावधेः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003625019, "chapter_id": 23625, "verse_number": "१-२-१२-२०", "content_sanskrit": "कारणानुगतं कार्यमिदं शुक्रादभूद्वपुः ।\nकथं विशुद्धिमायाति क्षालितांगारवद्वद ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003625020, "chapter_id": 23625, "verse_number": "१-२-१२-२१", "content_sanskrit": "तदस्यापि कृते पापं शत्रुषड्वर्गनिर्जिताः ।\nकथंकारं न लज्जन्ते कुर्वाणा नृपसत्तम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003625021, "chapter_id": 23625, "verse_number": "१-२-१२-२२", "content_sanskrit": "तद्ब्रह्मण इहोत्पन्नः सिकताद्वयसम्भवः ।\nनिगमोक्तं पठञ्छृण्वन्निदं जीविष्यते कथम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003625022, "chapter_id": 23625, "verse_number": "१-२-१२-२३", "content_sanskrit": "तथापि वैष्णवी माया मोहयत्यविवेकिनम् ।\nहृदयस्थं न जानंति ह्यपि मृत्यु शतायुषः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003625023, "chapter_id": 23625, "verse_number": "१-२-१२-२४", "content_sanskrit": "दन्ताश्चलाश्चला लक्ष्मीर्यौवनं जीवितं नृप ।\nचलाचलमतीवेदं दानमेवं गृहं नृणाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003625024, "chapter_id": 23625, "verse_number": "१-२-१२-२५", "content_sanskrit": "इति विज्ञाय संसारसारं च चलाचलम् ।\nकस्यार्थे क्रियते राजन्कुटजादि परिग्रहः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003625025, "chapter_id": 23625, "verse_number": "१-२-१२-२६", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nचिरायुर्भगवानेव श्रूयते भुवनत्रये ।\nतदर्थमहमायातस्तत्किमेवं वचस्तव ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003625026, "chapter_id": 23625, "verse_number": "१-२-१२-२७", "content_sanskrit": "लोमश उवाच ।\nप्रतिकल्पं मच्छरीरादेकरोमपरिक्षयः ।\nजायते सर्वनाशे च मम भावि प्रमापणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003625027, "chapter_id": 23625, "verse_number": "१-२-१२-२८", "content_sanskrit": "पश्य जानुप्रदेशं मे द्व्यंगुलं रोमवर्जितम् ।\nजातं वपुस्तद्बिभेमि मर्तव्ये सति किं गृहैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003625028, "chapter_id": 23625, "verse_number": "१-२-१२-२९", "content_sanskrit": "नारद उवाच ।\nइत्थं निशम्य तद्वाक्यं स प्रहस्यातिविस्मितः ।\nभूपालस्तस्य पप्रच्छ कारणं तादृशायुषः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003625029, "chapter_id": 23625, "verse_number": "१-२-१२-३०", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nपृच्छामि त्वामहं ब्रह्मन्यदायुरिदमीदृशम् ।\nतव दीर्घं प्रभावोऽसौ दानस्य तपसोऽथवा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003625030, "chapter_id": 23625, "verse_number": "१-२-१२-३१", "content_sanskrit": "लोमश उवाच ।\nश्रृणु भूप प्रवक्ष्यामि पूर्वजन्मसमुद्भवाम् ।\nशिवधर्मयुतां पुण्यां कथां पापप्रणाशनीम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003625031, "chapter_id": 23625, "verse_number": "१-२-१२-३२", "content_sanskrit": "अहमासं पुरा शूद्रो दरिद्रोऽतीवभूतले ।\nभ्रमामि वसुधापृष्ठे ह्यशनपीडितो भृशम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003625032, "chapter_id": 23625, "verse_number": "१-२-१२-३३", "content_sanskrit": "ततो मया महल्लिंगं जालिमध्यगतं तदा ।\nमध्याह्नेऽस्य जलाधारो दृष्टश्चैवा विदूरतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003625033, "chapter_id": 23625, "verse_number": "१-२-१२-३४", "content_sanskrit": "ततः प्रविश्य तद्वारि पीत्वा स्नात्वा च शांभवम् ।\nतल्लिंगं स्नापितं पूजा विहिता कमलैः शुभैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003625034, "chapter_id": 23625, "verse_number": "१-२-१२-३५", "content_sanskrit": "अथ क्षुत्क्षामकंठोऽहं श्रीकंठं तं नमस्य च ।\nपुनः प्रचलितो मार्गे प्रमीतो नृपसत्तम ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003625035, "chapter_id": 23625, "verse_number": "१-२-१२-३६", "content_sanskrit": "ततोऽहं ब्राह्मणगृहे जातो जातिस्मरः सुतः ।\nस्नापनाच्छिवलिंगस्य सकृत्कमलपूजनात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003625036, "chapter_id": 23625, "verse_number": "१-२-१२-३७", "content_sanskrit": "स्मरन्विलसितं मिथ्या सत्याभासमिदं जगत् ।\nअविद्यामयमित्येवं ज्ञात्वा मूकत्वमास्थितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003625037, "chapter_id": 23625, "verse_number": "१-२-१२-३८", "content_sanskrit": "तेन विप्रेण वार्धक्ये समाराध्य महेश्वरम् ।\nप्राप्तोऽहमिति मे नाम ईशान इति कल्पितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003625038, "chapter_id": 23625, "verse_number": "१-२-१२-३९", "content_sanskrit": "ततः स विप्रो वात्सल्यादगदान्सुबहून्मम ।\nचकार व्यपनेष्यामि मूकत्वमिति निश्चयः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003625039, "chapter_id": 23625, "verse_number": "१-२-१२-४०", "content_sanskrit": "मंत्रवादान्बहून्वैद्यानुपायानपरानपि ।\nपित्रोस्तथा महामायासंबद्धमनसोस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003625040, "chapter_id": 23625, "verse_number": "१-२-१२-४१", "content_sanskrit": "निरीक्ष्य मूढतां हास्यमासीन्मनसि मे तदा ।\nतथा यौवनमासाद्य निशि हित्वा निजं गृहम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003625041, "chapter_id": 23625, "verse_number": "१-२-१२-४२", "content_sanskrit": "संपूज्य कमलैः शंभुं ततः शयनमभ्यगाम् ।\nततः प्रमीते पितरि मूढैत्यहमुज्झितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003625042, "chapter_id": 23625, "verse_number": "१-२-१२-४३", "content_sanskrit": "संबंधिभिः प्रतीतोऽथ फलाहारमवस्थितः ।\nप्रतीतः पूजयामीशमब्जैर्बहुविधैस्तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003625043, "chapter_id": 23625, "verse_number": "१-२-१२-४४", "content_sanskrit": "अथ वर्षशतस्यांते वरदः शशिशेखरः ।\nप्रत्यक्षो याचितो देहि जरामरणसंक्षयम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003625044, "chapter_id": 23625, "verse_number": "१-२-१२-४५", "content_sanskrit": "ईश्वर उवाच ।\nअजरामरता नास्ति नामरूपभृतोयतः ।\nममापि देहपातः स्यादवधिं कुरु जीविते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003625045, "chapter_id": 23625, "verse_number": "१-२-१२-४६", "content_sanskrit": "इति शंभोर्वचः श्रुत्वा मया वृतिमिदं तदा ।\nकल्पांते रोमपातोऽस्तु मरणं सर्वसंक्षये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003625046, "chapter_id": 23625, "verse_number": "१-२-१२-४७", "content_sanskrit": "ततस्तव गणो भूयामिति मेऽभीप्सितो वरः ।\nतथेत्युक्त्वा स भगवान्हरश्चादर्शनं गतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003625047, "chapter_id": 23625, "verse_number": "१-२-१२-४८", "content_sanskrit": "अहं तपसिनिष्ठश्च ततः प्रभृति चाभवम् ।\nब्रह्महत्यादिभिः पापैर्मुच्यते शिवपूजनात् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003625048, "chapter_id": 23625, "verse_number": "१-२-१२-४९", "content_sanskrit": "ब्रध्नाब्जैरितरैर्वपि कमलैर्नात्र संशयः ।\nएवं कुरु महाराज त्वमप्याप्स्यसि वांछितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003625049, "chapter_id": 23625, "verse_number": "१-२-१२-५०", "content_sanskrit": "हरभक्तस्य लोकस्य त्रिलोक्यां नास्ति दुर्लभम् ।\nबहिःप्रवृत्तिं सगृह्य ज्ञानकर्मेन्द्रियादि च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003625050, "chapter_id": 23625, "verse_number": "१-२-१२-५१", "content_sanskrit": "लयः सदाशिवे नित्यमतर्यो गोऽयमुच्यते ।\nदुष्करत्वाद्वहिर्योगं शिव एव स्वयं जगौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003625051, "chapter_id": 23625, "verse_number": "१-२-१२-५२", "content_sanskrit": "पंचभिश्चार्चनं भूतैर्विशिष्टफलदं ध्रुवम् ।\nक्लेशकर्मविपाकाद्यैराशयैश्चाप्य संयुतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003625052, "chapter_id": 23625, "verse_number": "१-२-१२-५३", "content_sanskrit": "ईशानमाराध्य जपन्प्रणवं मुक्तिपाप्नुयात् ।\nसर्वपापक्षये जाते शिवे भवति भावना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003625053, "chapter_id": 23625, "verse_number": "१-२-१२-५४", "content_sanskrit": "पापोपहतबुद्धीनां शिवे वार्तापि दुर्लभा ।\nदुर्लभं भारते जन्म दुर्लभं शिवपूजनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003625054, "chapter_id": 23625, "verse_number": "१-२-१२-५५", "content_sanskrit": "दुर्लभं जाह्नवीस्नानं शिवे भक्तिः सुदुर्लभा ।\nदुर्लभं ब्राह्मणे दानं दुर्लभं वह्निपूजनम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003625055, "chapter_id": 23625, "verse_number": "१-२-१२-५६", "content_sanskrit": "अल्पपुण्यैश्च दुष्प्रापं पुरुषोत्तमपूजनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003625056, "chapter_id": 23625, "verse_number": "१-२-१२-५७", "content_sanskrit": "लक्षेण धनुषां योगस्तदर्धेन हुताशनः ।\nपात्रं शतसहस्रेण रेवा रुद्रश्च षष्टिभिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003625057, "chapter_id": 23625, "verse_number": "१-२-१२-५८", "content_sanskrit": "इति दमुक्तमखिलं मया तव महीपते ।\nयथायुरभवद्दीर्घं समाराध्य महेश्वरम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003625058, "chapter_id": 23625, "verse_number": "१-२-१२-५९", "content_sanskrit": "न दुर्लभं न दुष्प्रापं न चासाध्यं महात्मनाम् ।\nशिवभक्तिकृतां पुंसां त्रिलोक्यामिति निश्चितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003625059, "chapter_id": 23625, "verse_number": "१-२-१२-६०", "content_sanskrit": "नंदीश्वरस्य तेनैव वपुषा शिवपूजनात् ।\nसिद्धिमालोक्य को राजञ्छंकरं न नमस्यति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003625060, "chapter_id": 23625, "verse_number": "१-२-१२-६१", "content_sanskrit": "श्वेतस्य च महीपस्य श्रीकंठं च नमस्यतः ।\nकालोपि प्रलयं यातः कस्तमीशं न पूजयेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003625061, "chapter_id": 23625, "verse_number": "१-२-१२-६२", "content_sanskrit": "यदिच्छया विश्वमिदं जायते व्यवतिष्ठते ।\nतथा संलीयते चांते कस्तं न शरणं व्रजेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003625062, "chapter_id": 23625, "verse_number": "१-२-१२-६३", "content_sanskrit": "एतद्रहस्यमिदमेव नृणां प्रधानं कर्तव्यमत्र शिवपूजनमेव भूप ।\nयस्यांतरायपदवीमुपयांति लोकाः सद्योः नरः शिवनतः शिवमेव सत्यम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]