[{"id": 7003317000, "chapter_id": 23317, "verse_number": "२-१२-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nमूर्तयोऽष्टौ ममाचक्ष्व शंकरस्य महात्मनः ।\nविश्वरूपस्य देवस्य गणेश्वर महामते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003317001, "chapter_id": 23317, "verse_number": "२-१२-२", "content_sanskrit": "नंदिकेश्वर उवाच  ।\nहंत ते कथयिष्यामि महिमानमुमापतेः ।\nविश्वरूपस्य देवस्य सरोजभवसंभव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003317002, "chapter_id": 23317, "verse_number": "२-१२-३", "content_sanskrit": "भूरापोग्निर्मरुद् व्योम भास्करो दीक्षितः शशी ।\nभवस्य मूर्तयः प्रोक्ताः शिवस्य परमेष्ठिनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003317003, "chapter_id": 23317, "verse_number": "२-१२-४", "content_sanskrit": "खात्मेंदुवह्निसूर्यांभोधराः पवन इत्यपि ।\nतस्याष्ट मूर्तयः प्रोक्ता देवदेवस्य धीमतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003317004, "chapter_id": 23317, "verse_number": "२-१२-५", "content_sanskrit": "अग्निहोत्रेर्पिते तेन सूर्यात्मनि महात्मनि ।\nतद्विभूतिस्तथा सर्वे देवास्तृप्यंति सर्वदाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003317005, "chapter_id": 23317, "verse_number": "२-१२-६", "content_sanskrit": "वृक्षस्य मूलसेकेन यथा शाखोपशाखिकाः ।\nतथा तस्यार्चया देवास्तथा  स्युस्तद्विभूतयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003317006, "chapter_id": 23317, "verse_number": "२-१२-७", "content_sanskrit": "तस्य द्वादशधा भिन्नं रूपं सूर्यात्मकं प्रभोः ।\nसर्वदेवात्मकं याज्यं यजंति मुनिपुंगवाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003317007, "chapter_id": 23317, "verse_number": "२-१२-८", "content_sanskrit": "अमृताख्या कला तस्य सर्वस्यादित्यरूपिणः ।\nभूतसंजीवनी चेष्टा लोकेस्मिन् पीयते सदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003317008, "chapter_id": 23317, "verse_number": "२-१२-९", "content_sanskrit": "चंद्राख्यकिरणास्तस्य धूर्जटेर्भास्करात्मनः ।\nओषधीनां विवृद्ध्यर्थं हिमवृष्टिं वितन्वते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003317009, "chapter_id": 23317, "verse_number": "२-१२-१०", "content_sanskrit": "शुक्लाख्या रश्मयस्तस्य शंभोर्मार्तंडरूपिणः ।\nघर्मं वितन्वते लोके सस्यपाकादिकारणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003317010, "chapter_id": 23317, "verse_number": "२-१२-११", "content_sanskrit": "दिवाकरात्मनस्तस्य हरिकेशाह्वयः करः ।\nनक्षत्रपोषकश्चैव प्रसिद्धः परमेष्ठिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003317011, "chapter_id": 23317, "verse_number": "२-१२-१२", "content_sanskrit": "विश्वकर्माह्वयस्तस्य किरणो बुधपोषकः ।\nसर्वेश्वरस्य देवस्य सप्तसप्तिस्वरूपिणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003317012, "chapter_id": 23317, "verse_number": "२-१२-१३", "content_sanskrit": "विश्वव्यच इति ख्यातः किरणस्तस्य शूलिनः ।\nशुक्रपोषकभावेन प्रतीतः सूर्यरूपिणः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003317013, "chapter_id": 23317, "verse_number": "२-१२-१४", "content_sanskrit": "संयद्वसुरीति ख्यातो यस्य रश्मिस्त्रिशूलिनः ।\nलोहितांगं प्रपुष्णाति सहस्रकिरणात्मनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003317014, "chapter_id": 23317, "verse_number": "२-१२-१५", "content_sanskrit": "अर्वावसुरिति ख्यातो रश्मिस्तस्य पिनाकिनः ।\nबृहस्पतिं प्रपुष्णाति सर्वदा तपनात्मनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003317015, "chapter_id": 23317, "verse_number": "२-१२-१६", "content_sanskrit": "स्वराडिति समाख्यातः शिवस्यांशुः शनैश्चरम् ।\nहरिदश्वात्मनस्तस्य प्रपुष्णाति दिवानिशम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003317016, "chapter_id": 23317, "verse_number": "२-१२-१७", "content_sanskrit": "सूर्यात्मकस्य देवस्य विश्वयोनेरुमापतेः ।\nसुषुम्णाख्यः सदा रश्मिः पुष्णाति शिशिरद्युतिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003317017, "chapter_id": 23317, "verse_number": "२-१२-१८", "content_sanskrit": "सौम्यानां वसुजातानां प्रकृतित्वमुपागता ।\nतस्य सोमाह्वया मूर्तिः शंकरस्य जगद्गुरोः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003317018, "chapter_id": 23317, "verse_number": "२-१२-१९", "content_sanskrit": "तस्य सोमात्मकं रूपं शुक्रत्वेन व्यवस्थितम् ।\nशरीरभाजां सर्वेषां देवस्यांतकशासिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003317019, "chapter_id": 23317, "verse_number": "२-१२-२०", "content_sanskrit": "शरीरिणामशेषाणां मनस्येव व्यवस्थितम् ।\nवपुः सोमात्मकं शंभोस्तस्य सर्वजगद्गुरोः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003317020, "chapter_id": 23317, "verse_number": "२-१२-२१", "content_sanskrit": "शंभोः षोडशधा भिन्ना स्थितामृतकलात्मनः ।\nसर्वभूतशरीरेषु सोमाख्या मूर्तिरुत्तमा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003317021, "chapter_id": 23317, "verse_number": "२-१२-२२", "content_sanskrit": "देवान्पितॄंश्च पुष्णाति सुधयामृतया सदा ।\nमूर्तिः सोमाह्वया तस्य देवदेवस्य शासितुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003317022, "chapter_id": 23317, "verse_number": "२-१२-२३", "content_sanskrit": "पुष्णात्योषधिजातानि देहिनामात्मशुद्धये ।\nसोमाह्वया तनुस्तस्य भवानीमिति निर्दिशेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003317023, "chapter_id": 23317, "verse_number": "२-१२-२४", "content_sanskrit": "यज्ञानां पतिभावेन जीवानां तपसामपि ।\nप्रसिद्धरूपमेतद्वै सोमात्मकमुमापतेः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003317024, "chapter_id": 23317, "verse_number": "२-१२-२५", "content_sanskrit": "जलानामोषधीनां च पतिभावेन विश्रुतम् ।\nसोमात्मकं वपुस्तस्य शंभोर्भगवतः प्रभोः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003317025, "chapter_id": 23317, "verse_number": "२-१२-२६", "content_sanskrit": "देवो हिरण्यमयो मृष्टः परस्परविवेकिनः ।\nकरणानामशेषाणां देवतानां निराकृतिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003317026, "chapter_id": 23317, "verse_number": "२-१२-२७", "content_sanskrit": "जीवत्वेन स्थिते तस्मिञ्छिवे सोमात्मके प्रभौ ।\nमधुरा विलयं याति सर्वलोकैकरक्षिणी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003317027, "chapter_id": 23317, "verse_number": "२-१२-२८", "content_sanskrit": "यजमानाह्वया मूर्तिः शैवी हव्यैरहर्निशम् ।\nपुष्णाति देवताः सर्वाः कव्यैः पितृगणानपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003317028, "chapter_id": 23317, "verse_number": "२-१२-२९", "content_sanskrit": "यजमानाह्वया या सा तनुश्चाहुतिजा तया ।\nवृष्ट्या भावयति स्पष्टं सर्वमेव परापरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003317029, "chapter_id": 23317, "verse_number": "२-१२-३०", "content_sanskrit": "अंतःस्थं च बहिःस्थं च ब्रह्मांडानां स्थितं जलम् ।\nभूतानां च शरीरस्थं शंभोर्मूर्तिर्गरीयसी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003317030, "chapter_id": 23317, "verse_number": "२-१२-३१", "content_sanskrit": "नदीनाममृतं साक्षान्नदानामपि सर्वदा ।\nसमुद्राणां च सर्वत्र व्यापी सर्वमुमापतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003317031, "chapter_id": 23317, "verse_number": "२-१२-३२", "content_sanskrit": "संजीविनी समस्तानां भूतानामेव पाविनी ।\nअंबिका प्राणसंस्था या मूर्तिरंबुमयी परा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003317032, "chapter_id": 23317, "verse_number": "२-१२-३३", "content_sanskrit": "अंतःस्थश्चज बहिःस्थश्च ब्रह्मांडानां विभावसुः ।\nयज्ञानां च शरीरस्थः शंभोर्मूर्तिर्गरीयसी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003317033, "chapter_id": 23317, "verse_number": "२-१२-३४", "content_sanskrit": "शरीरस्था च भूतानां श्रेयसी मूर्तिरैश्वरी ।\nमूर्तिः पावक संस्था या शंभोरत्यंतपूजिता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003317034, "chapter_id": 23317, "verse_number": "२-१२-३५", "content_sanskrit": "भेदा एकोनपंचाशद्वेदविद्भिरुदाहृताः ।\nहव्यं वहति देवानां शंभोर्यज्ञात्मकं वपुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003317035, "chapter_id": 23317, "verse_number": "२-१२-३६", "content_sanskrit": "कव्यं पितृगणानां च हूयमानं द्विजातिभिः ।\nसर्वदेवमयं शंभोः श्रेष्ठमग्न्यात्मकं वपुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003317036, "chapter_id": 23317, "verse_number": "२-१२-३७", "content_sanskrit": "वदंति वेदशास्त्रज्ञा यजंति च यथाविधि ।\nअंतःस्थो जगदंडानां बहिःस्थश्च समीरणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003317037, "chapter_id": 23317, "verse_number": "२-१२-३८", "content_sanskrit": "शरीरस्थश्च भूतानां शैवी मूर्तिः पटीयसी ।\nप्राणाद्या नागकूर्माद्या आवहाद्याश्च वायवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003317038, "chapter_id": 23317, "verse_number": "२-१२-३९", "content_sanskrit": "ईशानमूर्तेरेकस्य भेदाः सर्वे प्रकीर्तिताः ।\nअंतःस्थं जगदंडानां बहिःस्थं च वियद्विभोः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003317039, "chapter_id": 23317, "verse_number": "२-१२-४०", "content_sanskrit": "शरीरस्थं च भूतानां शंभोमूर्तिर्गरीयसी ।\nशंभोर्विश्वंभरा मूर्तिः सर्वब्रह्माधिदेवता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003317040, "chapter_id": 23317, "verse_number": "२-१२-४१", "content_sanskrit": "चराचराणां भूतानां सर्वेषां धारणे मता ।\nचराचराणां भूतानां शरीराणि विदुर्बुधाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003317041, "chapter_id": 23317, "verse_number": "२-१२-४२", "content_sanskrit": "पंचकेनेसमूर्तीनां समारब्धानि सर्वथा ।\nपंचभूतानि चंद्रार्कावात्मेति मुनिपुंगवाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003317042, "chapter_id": 23317, "verse_number": "२-१२-४३", "content_sanskrit": "मूर्तयोऽष्टौ शिवस्याहुर्देवदेवस्य धीमतः ।\nआत्मा तस्याष्टमी मूर्तिर्यजमानाह्वया परा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003317043, "chapter_id": 23317, "verse_number": "२-१२-४४", "content_sanskrit": "चराचर शरीरेषु सर्वेष्वेव स्थिता तदा ।\nदीक्षितं ब्राह्मणं प्राहुरात्मानं च मुनीश्वराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003317044, "chapter_id": 23317, "verse_number": "२-१२-४५", "content_sanskrit": "यजमानाह्वया मूर्तिः शिवस्य शिवदायिनः ।\nमूर्तयोऽष्टौ शिवस्यैता वंदनीयाः प्रयत्नतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003317045, "chapter_id": 23317, "verse_number": "२-१२-४६", "content_sanskrit": "श्रेयोर्थिमिभिर्नरैर्नित्यं श्रेयसामेकहेतवः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]