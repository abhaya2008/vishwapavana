[{"id": 2038564, "chapter_id": 1844, "verse_number": "५-८९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038565, "chapter_id": 1844, "verse_number": "५-८९-१", "content_sanskrit": "प्रातरुत्थाय कृष्णस्तु कृतवान्सर्वमाह्निकम्।\nब्राह्मणैरभ्यनुज्ञातः प्रययौ नगरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038566, "chapter_id": 1844, "verse_number": "५-८९-२", "content_sanskrit": "तं प्रयान्तं महाबाहुमनुज्ञाप्य महाबलम् ।\nपर्यवर्तन्त ते सर्वे वृकस्थलनिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038567, "chapter_id": 1844, "verse_number": "५-८९-३", "content_sanskrit": "` प्रददौ पुण्डरीकाक्षो रत्नानि च धनानि च।\nतान्प्रस्थाप्य महाबाहुरुपायात्कुरुसंसदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038568, "chapter_id": 1844, "verse_number": "५-८९-४", "content_sanskrit": "धार्तराष्ट्रास्तमायान्तं प्रत्युञ्जग्मुः स्वलङ्कृताः ।\nदुर्योधनादृते सर्वे भीष्मद्रोणकृपादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038569, "chapter_id": 1844, "verse_number": "५-८९-५", "content_sanskrit": "पौराश्च बहुला राजन्हृषीकेशं दिदृक्षवः ।\nयानैर्बहुविधैरन्ये पद्भिरेव तथाऽपरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038570, "chapter_id": 1844, "verse_number": "५-८९-६", "content_sanskrit": "स वै पथि समागम्य भीष्मेणाक्लिष्टकर्मणा ।\nद्रोणेन धार्तराष्ट्रैश्च तैर्वृतो नगरं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038571, "chapter_id": 1844, "verse_number": "५-८९-७", "content_sanskrit": "कृष्णसंमाननार्थं च नगरं समलङ्कृतम्।\nबभूव राजमार्गश्च बहुरत्नसमाचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038572, "chapter_id": 1844, "verse_number": "५-८९-८", "content_sanskrit": "न च कश्चिद्गृहे राजंस्तदाऽऽसीद्भरतर्षभ।\nन स्त्री न वृद्धो न शिशुर्वासुदेवदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038573, "chapter_id": 1844, "verse_number": "५-८९-९", "content_sanskrit": "राजमार्गे नरास्तस्मिन्संस्तुवन्त्यवनिं गताः ।\nतस्मिन्काले महाराज हृषीकेशप्रवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038574, "chapter_id": 1844, "verse_number": "५-८९-१०", "content_sanskrit": "आवृतानि वरस्त्रीभिर्गृहाणि सुमहान्त्यपि ।\nप्रचलन्तीव भारेण दृश्यन्तेस्म महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038575, "chapter_id": 1844, "verse_number": "५-८९-११", "content_sanskrit": "तथा च गतिमन्तस्ते वासुदेवस्य वाजिनः ।\nप्रनष्टगतयोऽभूवन्राजमार्गे नरैर्वृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038576, "chapter_id": 1844, "verse_number": "५-८९-१२", "content_sanskrit": "स गृहं धृतराष्ट्रस्य प्राविशच्छत्रुकर्शनः।\nपाण्डुरैः पुण्डरीकाक्षः प्रासादैरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038577, "chapter_id": 1844, "verse_number": "५-८९-१३", "content_sanskrit": "तिस्रः कक्ष्या व्यतिक्रम्य केशवो राजवेश्मनः ।\nवैचित्रवीर्यं राजानमभ्यगच्छदरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038578, "chapter_id": 1844, "verse_number": "५-८९-१४", "content_sanskrit": "अभ्यागच्छति दाशार्हे प्रज्ञाचक्षुर्नराधिपः ।\nतहैव द्रोणभीष्माभ्यामुदतिष्ठन्महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038579, "chapter_id": 1844, "verse_number": "५-८९-१५", "content_sanskrit": "कृपश्च सोमदत्तश्च महाराजश्च बाह्लिकः।\nआसनेभ्योऽचलन्सर्वे पूजयन्तो जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038580, "chapter_id": 1844, "verse_number": "५-८९-१६", "content_sanskrit": "ततो राजानमासाद्य धृतराष्ट्रं यशस्विनम्।\nसभीष्मं पूजयामास वार्ष्णेयो वाग्भिरञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038581, "chapter_id": 1844, "verse_number": "५-८९-१७", "content_sanskrit": "तेषु धर्मानुपूर्वी तां प्रयुज्य मधुसूदनः ।\nयथावयः समीयाय राजभिः सह माधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038582, "chapter_id": 1844, "verse_number": "५-८९-१८", "content_sanskrit": "अथ द्रोणं सबाह्लीकं सपुत्रं च यशस्विनम्।\nकृपं च सोमदत्तं च समीयाय जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038583, "chapter_id": 1844, "verse_number": "५-८९-१९", "content_sanskrit": "तत्रासीदूर्जितं मृष्टं काञ्चनं महदासनम् ।\nशासनाद्धृतराष्ट्रस्य तत्रोपाविशदच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038584, "chapter_id": 1844, "verse_number": "५-८९-२०", "content_sanskrit": "अथ गां मधुपर्कं चाप्युदकं च जनार्दने ।\nउपजह्नुर्यथान्यायं धृतराष्ट्रपुरोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038585, "chapter_id": 1844, "verse_number": "५-८९-२१", "content_sanskrit": "कृतातिथ्यस्तु गोविन्दः सर्वान्परिहसन्कुरून् ।\nआस्ते सांबन्धिकं कुर्वन्कुरुभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038586, "chapter_id": 1844, "verse_number": "५-८९-२२", "content_sanskrit": "सोऽर्चितो धृतराष्ट्रेण पूजितश्च महायशाः ।\nराजानं समनुज्ञाप्य निरक्रामदरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038587, "chapter_id": 1844, "verse_number": "५-८९-२३", "content_sanskrit": "तैः समेत्य यथान्यायं कुरुभिः कुरुसंसदि ।\nविदुरावसथं रम्यमुपातिष्ठत माधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038588, "chapter_id": 1844, "verse_number": "५-८९-२४", "content_sanskrit": "विदुरः सर्वकल्याणैरभिगम्य जनार्दनम् ।\nअर्चयामास दाशार्हं सर्वकामैरुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038589, "chapter_id": 1844, "verse_number": "५-८९-२५", "content_sanskrit": "कृतातिथ्यं तु गोविन्दं विदुरः सर्वधर्मवित्।\nकुशलं पाण्डुपुत्राणामपृच्छन्मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038590, "chapter_id": 1844, "verse_number": "५-८९-२६", "content_sanskrit": "प्रीयमाणस्य सुहृदो विदुरो बुद्धिसत्तमः ।\nधर्मार्थनित्यस्य सतो गतरोवस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038591, "chapter_id": 1844, "verse_number": "५-८९-२७", "content_sanskrit": "तस्य सर्वं सविस्तारं पाण्डवानां विचेष्टितम् ।\nक्षत्तुराचष्ट दाशार्हः सर्वं प्रत्यक्षदर्शिवान् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038592, "chapter_id": 1844, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकोननवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]