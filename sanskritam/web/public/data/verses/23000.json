[{"id": 7003000000, "chapter_id": 23000, "verse_number": "२-४७-१", "content_sanskrit": "नारद उवाच ।\nका वा सा सुरभी देवी गोलोका दागता च या ।\nतज्जन्मचरितं ब्रह्मञ्छ्रोतुमिच्छामि तत्त्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003000001, "chapter_id": 23000, "verse_number": "२-४७-२", "content_sanskrit": "नारायण उवाच ।\nगवामधिष्ठातृदेवी गवामाद्या गवां प्रसूः ।\nगवां प्रधाना सुरभी गोलोके च समुद्भवा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003000002, "chapter_id": 23000, "verse_number": "२-४७-३", "content_sanskrit": "सर्वादिसृष्टेः कथनं कथयामि निशामय ।\nबभूव तेन तज्जन्म पुरा वृन्दावने वने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003000003, "chapter_id": 23000, "verse_number": "२-४७-४", "content_sanskrit": "एकदा राधिकानाथो राधया सह कौतुकात् ।\nगोपांगनापरिवृतः पुण्यं वृन्दावनं ययौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003000004, "chapter_id": 23000, "verse_number": "२-४७-५", "content_sanskrit": "सहसा तत्र रहसि विजहार च कौतुकात् ।\nबभूव क्षीरपानेच्छा तदा स्वेच्छापरस्य च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003000005, "chapter_id": 23000, "verse_number": "२-४७-६", "content_sanskrit": "ससृजे सुरभीं देवीं लीलया वामपार्श्वतः ।\nवत्सयुक्तां दुग्धवतीं वत्सानां च मनोरमाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003000006, "chapter_id": 23000, "verse_number": "२-४७-७", "content_sanskrit": "दृष्ट्वा सवत्सां सुरभीं रत्नभाण्डे दुदोह सः ।\nक्षीरं सुधातिरिक्तं च जन्ममृत्युहरं परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003000007, "chapter_id": 23000, "verse_number": "२-४७-८", "content_sanskrit": "तदुष्णं च पयः स्वादु पपौ गोपीपतिः स्वयम् ।\nसरो बभूव पयसा भाण्डविस्रंसनेन च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003000008, "chapter_id": 23000, "verse_number": "२-४७-९", "content_sanskrit": "दीर्घे च विस्तृते चैव परितः शतयोजनम् ।\nगोलोकेषु प्रसिद्धं तद्रम्यं क्षीरसरोवरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003000009, "chapter_id": 23000, "verse_number": "२-४७-१०", "content_sanskrit": "गोपिकानां च राधायाः क्रीडावापी बभूव सा ।\nरत्नेन रचिता तूर्णं भूता वापीश्वरेच्छया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003000010, "chapter_id": 23000, "verse_number": "२-४७-११", "content_sanskrit": "बभूव कामधेनूनां सहसा लक्षकोटयः ।\nतावत्यो हि सवत्साश्च सुरभीलोमकूपतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003000011, "chapter_id": 23000, "verse_number": "२-४७-१२", "content_sanskrit": "तासां पुत्राश्च पौत्राश्च संबभूवुरसंख्यकाः ।\nकथिता च गवां सृष्टिस्तया संपूरितं जगत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003000012, "chapter_id": 23000, "verse_number": "२-४७-१३", "content_sanskrit": "पूजां चकार भगवान्सुरभ्याश्च पुरा मुने ।\nततो बभूव तत्पूजा त्रिषु लोकेषु दुर्लभा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003000013, "chapter_id": 23000, "verse_number": "२-४७-१४", "content_sanskrit": "दीपान्विता परदिने श्रीकृष्णस्याज्ञया भवे ।\nबभूव सुरभीपूजा धर्मवक्त्रादिति श्रुतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003000014, "chapter_id": 23000, "verse_number": "२-४७-१५", "content_sanskrit": "ध्यानं स्तोत्रं मूलमन्त्रं यद्यत्पूजाविधिक्रमम् ।\nवेदोक्तं च महाभाग निबोध कथयामि ते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003000015, "chapter_id": 23000, "verse_number": "२-४७-१६", "content_sanskrit": "ॐ सुरभ्यै नम इति मन्त्रोऽयं तु  षडक्षरः ।\nसिद्धो लक्षजपेनैव भक्तानां कल्पपादपः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003000016, "chapter_id": 23000, "verse_number": "२-४७-१७", "content_sanskrit": "स्थितं ध्यानं यजुर्वेदे पूजनं सर्वसम्मतम् ।\nऋद्धिदां वृद्धिदां चैव मुक्तिदो सर्वकामदाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003000017, "chapter_id": 23000, "verse_number": "२-४७-१८", "content_sanskrit": "लक्ष्मीस्वरूपां परमां राधासहचरीं पराम् ।\nगवामधिष्ठातृदेवीं गवामाद्यां गवां प्रसूम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003000018, "chapter_id": 23000, "verse_number": "२-४७-१९", "content_sanskrit": "पवित्ररूपां पूज्यां च भक्तानां सर्वकामदाम् ।\nयया पूतं सर्वविश्वं तां देवीं सुरभीं भजे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003000019, "chapter_id": 23000, "verse_number": "२-४७-२०", "content_sanskrit": "घटे वा धेनुशिरसि बद्धस्तंभे गवां च वा ।\nशालग्रामे जलेऽग्नौ वा सुरभी पूजयेद्द्विजः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003000020, "chapter_id": 23000, "verse_number": "२-४७-२१", "content_sanskrit": "दीपान्विता परदिने पूर्वाह्णे भक्तिसंयुतः ।\nयः पूजयेच्च सुरभीं स च पूज्यो भवेद्भुवि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003000021, "chapter_id": 23000, "verse_number": "२-४७-२२", "content_sanskrit": "एकदा त्रिषु लोकेषु वाराहे विष्णुमायया ।\nक्षीरं जहार सहसा चिन्तिताश्च सुरादयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003000022, "chapter_id": 23000, "verse_number": "२-४७-२३", "content_sanskrit": "ते गत्वा ब्रह्मणो लोकं ब्रह्माणं तुष्टुवुस्तदा ।\nतदाज्ञया च सुरभीं तुष्टुवे पाकशासनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003000023, "chapter_id": 23000, "verse_number": "२-४७-२४", "content_sanskrit": "महेन्द्र उवाच ।\nनमो देव्यै महादेव्यै सुरभ्यै च नमो नमः ।\nगवां बीजस्वरूपायै नमस्ते जगदम्बिके ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003000024, "chapter_id": 23000, "verse_number": "२-४७-२५", "content_sanskrit": "नमो राधाप्रियायै च पद्मांशायै नमो नमः ।\nनमः कृष्णप्रियायै च गवां मात्रे नमो नमः ।\nकल्पवृक्षस्वरूपायै प्रदात्र्यै सर्वसंपदाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003000025, "chapter_id": 23000, "verse_number": "२-४७-२६", "content_sanskrit": "श्रीदायै धनदायै च बुद्धिदायै नमो नमः ।\nशुभदायै प्रसन्नायै गोप्रदायै नमो नमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003000026, "chapter_id": 23000, "verse_number": "२-४७-२७", "content_sanskrit": "यशोदायै सौख्यदायै धर्मज्ञायै नमो नमः ।\nस्तोत्रश्रवणमात्रेण तुष्टा हृष्टा जगत्प्रसूः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003000027, "chapter_id": 23000, "verse_number": "२-४७-२८", "content_sanskrit": "आविर्बभूव तत्रैव ब्रह्मलोके सनातनी ।\nमहेन्द्राय वरं दत्त्वा वाञ्छितं सर्वदुर्लभम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003000028, "chapter_id": 23000, "verse_number": "२-४७-२९", "content_sanskrit": "जगाम सा च गोलोकं ययुर्देवादयो गृहम् ।\nबभूव विश्वं सहसा दुग्धपूर्णं च नारद ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003000029, "chapter_id": 23000, "verse_number": "२-४७-३०", "content_sanskrit": "दुग्धाद् घृतं ततो यज्ञस्ततः प्रीतिः सुरस्य च ।\nइदं स्तोत्रं महापुण्यं भक्तियुक्तश्च यः पठेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003000030, "chapter_id": 23000, "verse_number": "२-४७-३१", "content_sanskrit": "स गोमान्धनवांश्चैव कीर्त्तिमान्पुण्यवान्भवेत् ।\nसुस्नातः सर्वतीर्थेषु सर्वयज्ञेषु दीक्षितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003000031, "chapter_id": 23000, "verse_number": "२-४७-३२", "content_sanskrit": "इह लोके सुखं भुक्त्वा यात्यन्ते कृष्णमन्दिरम् ।\nसुचिरं निवसेत्तत्र कुरुते कृष्णसेवनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003000032, "chapter_id": 23000, "verse_number": "२-४७-३३", "content_sanskrit": "न पुनर्भवनं तस्य ब्रह्मपुत्र भवे भवेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]