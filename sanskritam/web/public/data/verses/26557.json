[{"id": 7006557000, "chapter_id": 26557, "verse_number": "३-९६-१", "content_sanskrit": "पौण्ड्रकस्य सात्यकिना सह युद्धम् वैशम्पायन उवाच ततः क्रुद्धो महाराज सात्यकिर्वृष्णिपुङ्गवः ।\nउवाच वचनं राजन् वासुदेवं स्मरन्निव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006557001, "chapter_id": 26557, "verse_number": "३-९६-२", "content_sanskrit": "अवोचदीदृशं वाक्यं वासुदेवं नृपाधमः ।\nको नाम जगतां नाथमित्थं ब्रूयाज्जिजीविषुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006557002, "chapter_id": 26557, "verse_number": "३-९६-३", "content_sanskrit": "मृत्युस्त्वां सर्वथा याति वदन्तं तादृशं वचः ।\nजिह्वा ते शतधा दीर्याद् वदतस्तादृशं वचः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006557003, "chapter_id": 26557, "verse_number": "३-९६-४", "content_sanskrit": "एष ते पातयिष्यामि शिरः कायाच्च पौण्ड्रक ।\nयन्नाम वासुदेवेति तव सम्प्रति वर्तते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006557004, "chapter_id": 26557, "verse_number": "३-९६-५", "content_sanskrit": "यावत् पतति कायात्ते शिरस्तावत्प्रवर्तते ।\nस एव श्वो न भगवान् वासुदेवो भविष्यसि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006557005, "chapter_id": 26557, "verse_number": "३-९६-६", "content_sanskrit": "एक एव जगन्नाथः कर्ता सर्वस्य सर्वगः ।\nदुरात्मन् सर्वथा देवो भविष्यति न संशयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006557006, "chapter_id": 26557, "verse_number": "३-९६-७", "content_sanskrit": "एष तेऽहं शिरः कायात् पातयिष्यामि राजक ।\nयदसौ भगवान् विष्णुर्नागमिष्यति साम्प्रतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006557007, "chapter_id": 26557, "verse_number": "३-९६-८", "content_sanskrit": "अस्त्रवीर्यं बलं चैव सर्वं दर्शय साम्प्रतम् ।\nनातः परतरं राजन् वीर्यं च तव वर्तते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006557008, "chapter_id": 26557, "verse_number": "३-९६-९", "content_sanskrit": "सर्वं दर्शय यत्नेन स्थितोऽस्मि व्यवसायवान् ।\nशरी चापी गदी खड्गी सर्वथाहमुपस्थितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006557009, "chapter_id": 26557, "verse_number": "३-९६-१०", "content_sanskrit": "नैतन्नगरमायासीः सत्यमेतद् ब्रवीम्यहम् ।\nसर्वथा कृतकृत्योऽस्मि दृष्ट्वा त्वां वासुदेवकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006557010, "chapter_id": 26557, "verse_number": "३-९६-११", "content_sanskrit": "तवाङ्गं तिलशः कृत्वा श्वभ्यो दास्यामि राजक ।\nइत्युक्त्वा बाणमादाय वासुदेवं महाबलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006557011, "chapter_id": 26557, "verse_number": "३-९६-१२", "content_sanskrit": "आकर्णपूर्णमाकृष्य विव्याध निशितं शरम् ।\nस तेन विद्धो यदुना वासुदेवः प्रतापवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006557012, "chapter_id": 26557, "verse_number": "३-९६-१३", "content_sanskrit": "वमञ्छोणितमत्युष्णमङ्गान्नेत्रान्नृपोत्तम ।\nततश्चुक्रोध नृपतिर्वासुदेवः प्रतापवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006557013, "chapter_id": 26557, "verse_number": "३-९६-१४", "content_sanskrit": "नवभिर्दशभिश्चैव शरैः संनतपर्वभिः ।\nविव्याध सात्यकिं राजा नदंश्च बहुधा किल ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006557014, "chapter_id": 26557, "verse_number": "३-९६-१५", "content_sanskrit": "ततो नाराचमादाय निशितं यमसंनिभम् ।\nधनुराकृष्य भगवान् वासुदेवो नृपोत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006557015, "chapter_id": 26557, "verse_number": "३-९६-१६", "content_sanskrit": "विव्याध सात्यकिं भूयो निशि प्रह्रादयन् स्वकान् ।\nनाराचेन समाविद्धः सात्यकिः सत्यसङ्गरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006557016, "chapter_id": 26557, "verse_number": "३-९६-१७", "content_sanskrit": "ललाटे सुदृढं वीरो वृष्णीनामग्रणीस्तदा ।\nनिषसाद रथोपस्थे निश्चेष्ट इव सत्तमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006557017, "chapter_id": 26557, "verse_number": "३-९६-१८", "content_sanskrit": "ततः स पौण्ड्रको राजा विद्ध्वा दशभिराशुगैः ।\nसारथिं पञ्चविंशत्या हयांश्च चतुरो नृप ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006557018, "chapter_id": 26557, "verse_number": "३-९६-१९", "content_sanskrit": "ते हया रुधिराक्ताङ्गाः सारथिश्च समन्ततः ।\nविह्वलाः समपद्यन्त वासुदेवस्य पश्यतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006557019, "chapter_id": 26557, "verse_number": "३-९६-२०", "content_sanskrit": "वासुदेवो रथे चापि सिंहनादं समाददे ।\nतेन नादेन तत्राभूद् विबुद्धः सात्यकिर्नृप ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006557020, "chapter_id": 26557, "verse_number": "३-९६-२१", "content_sanskrit": "विद्धान् हयांस्तथा दृष्ट्वा सारथिं च तथागतम् ।\nशैनेयोऽथ महावीर्यो रुषितो नृपसत्तम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006557021, "chapter_id": 26557, "verse_number": "३-९६-२२", "content_sanskrit": "अलं द्रक्ष्यामि ते वीर्यमित्युक्त्वा बाणमाददे ।\nविव्याध तेन बाणेन वक्षस्येनं महाबलः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006557022, "chapter_id": 26557, "verse_number": "३-९६-२३", "content_sanskrit": "ततश्चचाल तेनाजौ वासुदेवः शरेण ह ।\nसुस्राव रुधिरं घोरमत्युष्णं वक्षसो नृप ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006557023, "chapter_id": 26557, "verse_number": "३-९६-२४", "content_sanskrit": "रथोपस्थे पपाताशु निःश्वसन्नुरगो यथा ।\nकृत्यं चापि न जानाति केवलं निषसाद ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006557024, "chapter_id": 26557, "verse_number": "३-९६-२५", "content_sanskrit": "सात्यकिस्तु रथं विद्ध्वा दशभिः सायकैस्तथा ।\nध्वजं चिच्छेद भल्लेन वासुदेवस्य वृष्णिपः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006557025, "chapter_id": 26557, "verse_number": "३-९६-२६", "content_sanskrit": "हयांश्च चतुरो हत्वा बाणैः सारथिमेव च ।\nयुयुधानोऽथ राजेन्द्र पौण्ड्रकस्य च पश्यतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006557026, "chapter_id": 26557, "verse_number": "३-९६-२७", "content_sanskrit": "सारथेश्च शिरः कायादहरत् स रथात् तदा ।\nरथग्रन्थिं च चिच्छेद हयाश्च व्यसवोऽभवन् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006557027, "chapter_id": 26557, "verse_number": "३-९६-२८", "content_sanskrit": "चक्रं च तिलशः कृत्वा बाणैर्दशभिरञ्जसा ।\nजहास विपुलं राजन् वासुदेवं महाबलः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006557028, "chapter_id": 26557, "verse_number": "३-९६-२९", "content_sanskrit": "ततः परं महत्प्रायं सात्यकिर्वृष्णिनन्दनः ।\nशब्दं कृत्वा बली साक्षात् सर्वक्षत्रस्य पश्यतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006557029, "chapter_id": 26557, "verse_number": "३-९६-३०", "content_sanskrit": "शरैः सप्ततिसंख्याकैरर्दयामास सत्वरम् ।\nते शराः शलभाकारा निपेतुः सर्वशस्तदा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006557030, "chapter_id": 26557, "verse_number": "३-९६-३१", "content_sanskrit": "शिरस्तः पार्श्वतश्चैव पृष्ठतः पुरतस्तथा ।\nकेवलं धैर्यनिचयस्तृषार्तः शरवान् यथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006557031, "chapter_id": 26557, "verse_number": "३-९६-३२", "content_sanskrit": "यथा मनस्वी रिक्तश्च तथा तिष्ठति पौण्ड्रकः ।\nततश्चुक्रोध बलवान् वासुदेवः प्रतापवान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006557032, "chapter_id": 26557, "verse_number": "३-९६-३३", "content_sanskrit": "अर्धचन्द्रं समादाय विव्याध युधि सात्यकिम् ।\nविद्ध्वा सप्तभिरायान्तं क्रोधेन प्रस्फुरन्निव ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006557033, "chapter_id": 26557, "verse_number": "३-९६-३४", "content_sanskrit": "विद्धोऽथ सात्यकिस्तेन शरैः पञ्चभिराशुगैः ।\nचापं चिच्छेद पौण्ड्रस्य सिंहनादं व्यनीनदत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006557034, "chapter_id": 26557, "verse_number": "३-९६-३५", "content_sanskrit": "वासुदेवो गदां गृह्य भ्रामयित्वा पदात्पदम् ।\nत्वरितं पातयामास सात्यकेर्वक्षसि प्रभो ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006557035, "chapter_id": 26557, "verse_number": "३-९६-३६", "content_sanskrit": "सव्येन तां समाकृष्य करेण यदुनन्दनः ।\nशरं प्रगृह्य विव्याध सात्यकिर्युधि पौण्ड्रकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006557036, "chapter_id": 26557, "verse_number": "३-९६-३७", "content_sanskrit": "तमन्तरे गृहीत्वाशु वासुदेवः प्रतापवान् ।\nशक्तिभिर्दशभिश्चैव सात्यकिं निजघान ह ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006557037, "chapter_id": 26557, "verse_number": "३-९६-३८", "content_sanskrit": "ताभिर्विद्धो रणे वीरः सात्यकिः सत्यसंगरः ।\nअपास्य धनुरन्यत् तद् धनुरादाय सत्वरम् ।\nआजघान तदा वीरो वृष्णीनामग्रणीर्नृप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]