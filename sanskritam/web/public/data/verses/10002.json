[{"id": 6000002000, "chapter_id": 10002, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000002001, "chapter_id": 10002, "verse_number": "१-२-१", "content_sanskrit": "इति सम्प्रश्नसम्पृष्‍टो विप्राणां रौमहर्षणिः।\nप्रतिपूज्य वचस्तेषां प्रवक्‍तुमुपचक्रमे॥ १/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.001.m4a", "display_order": 2, "topics": [{"text": "शौनकादिकृतप्रश्नप्रशंसनम्", "range": "१–५"}]}, {"id": 6000002002, "chapter_id": 10002, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.002.m4a", "display_order": 3}, {"id": 6000002003, "chapter_id": 10002, "verse_number": "१-२-२", "content_sanskrit": "यं प्रव्रजन्तमनुपेतमपेतकृत्यं द्वैपायनो विरहकातर आजुहाव।\nपुत्रेति तन्मयतया तरवोऽपि नेदुस्तं सर्वभूतहृदयं मुनिमानतोऽस्मि॥ १/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.003.m4a", "display_order": 4}, {"id": 6000002004, "chapter_id": 10002, "verse_number": "१-२-३", "content_sanskrit": "यः स्वानुभावमखिलश्रुतिसारमेकम् अध्यात्मदीपमतितितीर्‌षतां तमोऽन्धम्।\nसंसारिणां करुणयाऽऽह पुराणगुह्यं तं व्याससूनुमुपयामि गुरुं मुनीनाम्॥ १/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.004.m4a", "display_order": 5}, {"id": 6000002005, "chapter_id": 10002, "verse_number": "१-२-४", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो ग्रन्थमुदीरये॥ १/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.005.m4a", "display_order": 6}, {"id": 6000002006, "chapter_id": 10002, "verse_number": "१-२-५", "content_sanskrit": "मुनयः साधु पृष्‍टोऽहं भवद्भिर्लोकमङ्गलम्।\nयत्कृतः कृष्णसंप्रश्नो येनात्माऽऽशु प्रसीदति॥ १/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.006.m4a", "display_order": 7}, {"id": 6000002007, "chapter_id": 10002, "verse_number": "१-२-६", "content_sanskrit": "स वै पुसां परो धर्मो यतो भक्‍तिरधोक्षजे।\nअहैतुक्यव्यवहिता ययाऽऽत्माऽऽशु प्रसीदति॥ १/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.007.m4a", "display_order": 8, "topics": [{"text": "भगवद्भक्तितत्कथाश्रवणादिमहिमानुवर्णनेन चतुर्णां प्रश्नानामुत्तरदानम्॥ तद्यथा- भगवद्भक्तिजनकस्यैव धर्मस्य सारत्वकथनेन प्रथमस्योत्तरम्", "range": "६–२६"}]}, {"id": 6000002008, "chapter_id": 10002, "verse_number": "१-२-७", "content_sanskrit": "वासुदेवे भगवति भक्‍तियोगः प्रयोजितः।\nजनयत्याशु वैराग्यं ज्ञानं ‍च यदहैतुकम्॥ १/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.008.m4a", "display_order": 9}, {"id": 6000002009, "chapter_id": 10002, "verse_number": "१-२-८", "content_sanskrit": "धर्मः स्वनुष्‍ठितः पुंसां विश्‍वक्सेनकथाश्रयाम्।\nनोत्पादयेद्यदि रतिं श्रम एव हि केवलम्॥ १/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.009.m4a", "display_order": 10}, {"id": 6000002010, "chapter_id": 10002, "verse_number": "१-२-९", "content_sanskrit": "धर्मस्य ह्यापवर्ग्यस्य नार्थोऽर्थायेह कल्पते।\nनार्थस्य धर्मैकान्तस्य कामो लाभाय हि स्मृतः॥ १/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.010.m4a", "display_order": 11}, {"id": 6000002011, "chapter_id": 10002, "verse_number": "१-२-१०", "content_sanskrit": "कामस्य नेन्द्रियप्रीतिर्लाभो जीवति यावता।\nजीवस्यातत्त्वजिज्ञासोर्नार्थो यश्‍चेह कर्मभिः॥ १/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.011.m4a", "display_order": 12}, {"id": 6000002012, "chapter_id": 10002, "verse_number": "१-२-११", "content_sanskrit": "वदन्ति तत्तत्त्वविदस्तत्त्वं यज्ज्ञानमद्वयम्।\nब्रह्मेति परमात्मेति भगवानिति शब्द्यते॥ १/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.012.m4a", "display_order": 13}, {"id": 6000002013, "chapter_id": 10002, "verse_number": "१-२-१२", "content_sanskrit": "सत्तामात्रं तु यत्किञ्चित्सदसच्चाविशेषणम्।\nउभाभ्यां भाष्यते साक्षाद्भगवान् केवलः स्मृतः॥ १/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.013.m4a", "display_order": 14}, {"id": 6000002014, "chapter_id": 10002, "verse_number": "१-२-१३", "content_sanskrit": "तच्छ्रद्दधाना मुनयो ज्ञानवैराग्ययुक्‍तया।\nपश्यन्त्यात्मनि चात्मानं भक्‍त्या श्रुतिगृहीतया॥ १/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.014.m4a", "display_order": 15}, {"id": 6000002015, "chapter_id": 10002, "verse_number": "१-२-१४", "content_sanskrit": "अतः पुम्भिर्द्विजश्रेष्‍ठा वर्णाश्रमविभागशः।\nस्वनुष्‍ठितस्य धर्मस्य संसिद्धिर्हरितोषणम्॥ १/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.015.m4a", "display_order": 16}, {"id": 6000002016, "chapter_id": 10002, "verse_number": "१-२-१५", "content_sanskrit": "तस्मादेकेन मनसा भगवान्सात्वतां पतिः।\nश्रोतव्यः कीर्तितव्यश्‍च ध्येयः पूज्यश्‍च नित्यदा॥ १/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.016.m4a", "display_order": 17}, {"id": 6000002017, "chapter_id": 10002, "verse_number": "१-२-१६", "content_sanskrit": "यदनुध्यायिनो युक्‍ताः कर्मग्रन्थिनिबन्धनम्।\nछिन्दन्ति कोविदास्तस्य को न कुर्यात्कथारतिम्॥ १/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.017.m4a", "display_order": 18}, {"id": 6000002018, "chapter_id": 10002, "verse_number": "१-२-१७", "content_sanskrit": "शुश्रूषोः श्रद्दधानस्य वासुदेवकथारतिः।\nस्यान्महत्सेवया विप्राः पुण्यतीर्थनिषेवणात्॥ १/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.018.m4a", "display_order": 19}, {"id": 6000002019, "chapter_id": 10002, "verse_number": "१-२-१८", "content_sanskrit": "शृण्वतां स्वकथां कृष्णः पुण्यश्रवणकीर्तनः।\nहृद्यन्तःस्थो ह्यभद्राणि विधुनोति सुहृत् सताम्॥ १/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.019.m4a", "display_order": 20}, {"id": 6000002020, "chapter_id": 10002, "verse_number": "१-२-१९", "content_sanskrit": "नष्‍टप्रायेष्वभद्रेषु नित्यं भागवतसेवया।\nभगवत्युत्तमश्लोके भक्‍तिर्भवति नैष्‍ठिकी॥ १/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.020.m4a", "display_order": 21}, {"id": 6000002021, "chapter_id": 10002, "verse_number": "१-२-२०", "content_sanskrit": "तदा रजस्तमोभावाः कामलोभादयश्‍च ये।\nचेत एतैरनाविद्धं स्थितं सत्त्वे प्रसीदति॥ १/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.021.m4a", "display_order": 22}, {"id": 6000002022, "chapter_id": 10002, "verse_number": "१-२-२१", "content_sanskrit": "एवं प्रसन्नमनसो भगवद्भक्‍तियोगतः।\nभगवत्तत्वविज्ञानं मुक्‍तसङ्गस्य जायते॥ १/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.022.m4a", "display_order": 23}, {"id": 6000002023, "chapter_id": 10002, "verse_number": "१-२-२२", "content_sanskrit": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः।\nक्षीयन्ते चास्य कर्माणि दृष्‍ट एवात्मनीश्‍वरे॥ १/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.023.m4a", "display_order": 24}, {"id": 6000002024, "chapter_id": 10002, "verse_number": "१-२-२३", "content_sanskrit": "अतो वै कवयो नित्यं भक्‍तिं परमया मुदा।\nवासुदेवे भगवति कुर्वन्त्यात्मप्रसादनीम्॥ १/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.024.m4a", "display_order": 25}, {"id": 6000002025, "chapter_id": 10002, "verse_number": "१-२-२४", "content_sanskrit": "सत्त्वं रजस्तम इति प्रकृतेर्गुणास्तैर्युक्‍तः परः पुरुष एव इहास्य धत्ते।\nस्थित्यादये हरिविरिञ्चहरेति सञ्ज्ञाः श्रेयांसि तत्र खलु सत्त्वतनौ नृणां स्युः॥ १/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.025.m4a", "display_order": 26}, {"id": 6000002026, "chapter_id": 10002, "verse_number": "१-२-२५", "content_sanskrit": "पार्थिवाद्दारुणो धूमस्तस्मादग्निस्‍त्रयीमयः।\nतमसस्तु रजस्तस्मात्सत्त्वं यद् ब्रह्मदर्शनम्॥ १/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.026.m4a", "display_order": 27}, {"id": 6000002027, "chapter_id": 10002, "verse_number": "१-२-२६", "content_sanskrit": "भेजिरे मुनयोऽथाग्रे भगवन्तमधोक्षजम्।\nसत्त्वं विशुद्धं क्षेमाय कल्पते नेतराविह॥ १/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.027.m4a", "display_order": 28}, {"id": 6000002028, "chapter_id": 10002, "verse_number": "१-२-२७", "content_sanskrit": "मुमुक्षवो घोरमूढान् हित्वा भूतपतीनथ।\nनारायणकलाः शान्ता भजन्ति ह्यनसूयवः॥ १/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.028.m4a", "display_order": 29, "topics": [{"text": "भगवद्भजनस्यैव सर्वशास्‍त्रगोचरत्वकथनेन द्वितीयस्योत्तरम्", "range": "२७–३०"}]}, {"id": 6000002029, "chapter_id": 10002, "verse_number": "१-२-२८", "content_sanskrit": "रजस्तमःप्रकृतयः समशीलान् भजन्ति वै।\nपितृभूतप्रजेशादीन् श्रियैश्‍वर्यप्रजेप्सवः॥ १/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.029.m4a", "display_order": 30}, {"id": 6000002030, "chapter_id": 10002, "verse_number": "१-२-२९", "content_sanskrit": "वासुदेवपरा वेदा वासुदेवपरा मखाः।\nवासुदेवपरा योगा वासुदेवपराः क्रियाः॥ १/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.030.m4a", "display_order": 31}, {"id": 6000002031, "chapter_id": 10002, "verse_number": "१-२-३०", "content_sanskrit": "वासुदेवपरं ज्ञानं वासुदेवपरं तपः।\nवासुदेवपरो धर्मो वासुदेवपरा गतिः॥ १/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.031.m4a", "display_order": 32}, {"id": 6000002032, "chapter_id": 10002, "verse_number": "१-२-३१", "content_sanskrit": "स एवेदं ससर्जाग्रे भगवानात्ममायया।\nसदसद्रूपया चासौ गुणमय्याऽगुणो विभुः॥ १/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.032.m4a", "display_order": 33, "topics": [{"text": "‘जगत्सृष्‍ट्यादीनि तस्योदारकर्माणि’ इति चतुर्थप्रश्नस्योत्तरम्", "range": "३१"}]}, {"id": 6000002033, "chapter_id": 10002, "verse_number": "१-२-३२", "content_sanskrit": "तया विलसितेष्वेषु गुणेषु गुणवानिव।\nअन्तःप्रविष्‍ट आभाति विज्ञानेन विजृम्भितः॥ १/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.033.m4a", "display_order": 34}, {"id": 6000002034, "chapter_id": 10002, "verse_number": "१-२-३३", "content_sanskrit": "यथा व्यवहितो वह्निर्दारुष्वेकः स्वयोनिषु।\nनानेव भाति विश्‍वात्मा भूतेषु च तथा पुमान्॥ १/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.034.m4a", "display_order": 35}, {"id": 6000002035, "chapter_id": 10002, "verse_number": "१-२-३४", "content_sanskrit": "असौ गुणमयैर्भावैर्भूतसूक्ष्मेन्द्रियादिभिः।\nस्वनिर्मितेषु निर्विष्‍टो भुङ्क्ते भूतेषु तद्गुणान्॥ १/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.035.m4a", "display_order": 36}, {"id": 6000002036, "chapter_id": 10002, "verse_number": "१-२-३५", "content_sanskrit": "भावयन्नेष सत्त्वेन लोकान् वै लोकभावनः।\nलीलावतारानुगतस्तिर्यङ्‌नरसुरादिषु॥ १/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_002/BhP_01.002.036.m4a", "display_order": 37, "topics": [{"text": "‘लोकपालनमेव सर्वेषां भगवदवताराणां प्रयोजनं विशेषतः श्रीकृष्णावतारस्य’ इति तृतीयस्योत्तरम्", "range": "३५"}]}, {"id": 6000002037, "chapter_id": 10002, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]