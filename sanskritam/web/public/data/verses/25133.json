[{"id": 7005133000, "chapter_id": 25133, "verse_number": "७-१-३१६-१", "content_sanskrit": "ईश्वर उवाच ।\nअथ देवकुलात्पूर्वे पंचगव्यूतिमात्रतः ।\nशंबरस्थान मध्ये तु क्षेमादित्येति विश्रुतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005133001, "chapter_id": 25133, "verse_number": "७-१-३१६-२", "content_sanskrit": "तं दृष्ट्वा मानवो देवि भवेत्क्षेमार्थसिद्धिभाक् ।\nसप्तम्यां रविवारेण पूजितः सर्वकामदः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005133002, "chapter_id": 25133, "verse_number": "७-१-३१६-३", "content_sanskrit": "इति देवकुलस्थाने कथिता तीर्थसंस्थितिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005133003, "chapter_id": 25133, "verse_number": "७-१-३१६-४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्र माहात्म्ये क्षेमादित्यमाहात्म्यवर्णनंनाम षोडशोत्तरत्रिशततमोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]