[{"id": 2114320, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114321, "chapter_id": 3459, "verse_number": "१", "content_sanskrit": "द्रोणेन वैरं द्रुपदो न सुष्वाप स्मरंस्तदा ।\nक्षात्रेण च बलेनास्य नाशशंसे पराजयम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114322, "chapter_id": 3459, "verse_number": "२", "content_sanskrit": "हीनं विदित्वा चात्मानं बाह्मणेन बलेन च ।\nद्रुपदस्त्वमर्षणाद् राजा कर्मसिद्ध्यै दिजोत्तमान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114323, "chapter_id": 3459, "verse_number": "३", "content_sanskrit": "अन्विच्छन् परिचक्राम ब्राह्मणावसथान् बहून् ।\nनास्ति श्रेष्ठं ममापत्यं धिग्बन्धूनिति च ब्रुवन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114324, "chapter_id": 3459, "verse_number": "४", "content_sanskrit": "निश्श्वासपरमो ह्यासीद् द्रोणप्रतिचिकीर्षया ।\nन सन्ति मम मित्राणि लोकेऽस्मिन् नास्ति वीर्यवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114325, "chapter_id": 3459, "verse_number": "५", "content_sanskrit": "न सन्ति बलिनः पुंसः सङ्ग्रामे विजिगीषवः ।\nइति चिन्ताकुलो राजा निश्श्वासपरमोऽभवत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114326, "chapter_id": 3459, "verse_number": "६", "content_sanskrit": "असुखश्च विनिद्रश्च द्रोणाप्रियचिकीर्षया ।\nपुत्रजन्म परीप्सन् वै पृथिवीमन्वयादिमाम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114327, "chapter_id": 3459, "verse_number": "७", "content_sanskrit": "पृथ्वीमन्वचरत् सर्वां द्रोणहन्तृपरीप्सया ।\nप्रभावशिक्षाविनयाद् द्रोणस्यास्य बलेन च \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114328, "chapter_id": 3459, "verse_number": "८", "content_sanskrit": "कर्तुं प्रयतमानोऽपि न शशाक पराजयम् ।\nअभितः सोऽथ कल्माषीं गङ्गातीरे परिभ्रमन् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114329, "chapter_id": 3459, "verse_number": "९", "content_sanskrit": "ब्राह्मणावसथं पुण्यमाससाद महीपतिः ।\nतत्र नास्नातकः कश्चिन्नचासीदव्रती द्विजः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114330, "chapter_id": 3459, "verse_number": "१०", "content_sanskrit": "तदैव तौ महाभागौ सोऽपश्यत् संशितव्रतौ ।\nयाजोपयाजौ ब्रह्मर्षी शाम्यन्तौ पृषतात्मजः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114331, "chapter_id": 3459, "verse_number": "११", "content_sanskrit": "संहिताध्ययने युक्तौ गोत्रतश्चापि काश्यपौ ।\nअरण्ये युक्तरूपौ तौ ब्राह्मणावृषिसत्तमौ \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114332, "chapter_id": 3459, "verse_number": "१२", "content_sanskrit": "स उपामन्त्रयामास सर्वकामैरतन्द्रितः ।\nबुद्ध्वा तयोर्बलं बुद्धिं कनीयांसमुपह्वरे \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114333, "chapter_id": 3459, "verse_number": "१३", "content_sanskrit": "प्रपेदे च्छन्दयन् कामैरुपयाजं धृतव्रतम् ।\nगुरुशुश्रूषणे युक्तः प्रियकृत् सर्वकामदः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114334, "chapter_id": 3459, "verse_number": "१४", "content_sanskrit": "पाद्येनासनदानेन तथाऽर्घ्येण फलैश्च तम् ।\nहर्षयित्वा यथान्यायमुपयाजोऽब्रवीत् ततः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114335, "chapter_id": 3459, "verse_number": "१५", "content_sanskrit": "केन कार्यविशेषेण त्वमस्मानभिकाङ्क्षसे ।\nकुतश्चायं समुद्योगस्तद् ब्रवीतु भवानिति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114336, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114337, "chapter_id": 3459, "verse_number": "१६", "content_sanskrit": "स बुद्ध्वा प्रीतिसंयुक्तमृषीणामुत्तमं तदा ।\nउवाच च्छन्दयन् कामैर्द्रुपदः स तपस्विनम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114338, "chapter_id": 3459, "verse_number": "१७", "content_sanskrit": "येन मे कर्मणा ब्रह्मन् पुत्रः स्याद् द्रोणमृत्यवे ।\nअर्जुनस्य तथा भार्या भवेद् या वरवर्णिनी ।\nउपयाज चरस्वैतत् प्रदास्याम्यर्बुदं गवाम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114339, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114340, "chapter_id": 3459, "verse_number": "१८", "content_sanskrit": "एवमुक्तस्तु तेनर्षिः प्रत्युवाच पुनश्च तम् ।\nनाहं फलार्थी द्रुपद योऽर्थी स्यात् तत्र गम्यताम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114341, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114342, "chapter_id": 3459, "verse_number": "१९", "content_sanskrit": "प्रत्याख्यातस्तु तेनैवं स वै सज्जनसन्निधौ ।\nआराधयिष्यन् द्रुपदः स तं पर्यचरत् पुनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114343, "chapter_id": 3459, "verse_number": "२०", "content_sanskrit": "ततः संवत्सरस्यान्ते द्रुपदं द्विजसत्तमः ।\nउपयाजोऽब्रवीद् वाक्यं काले मधुरया गिरा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114344, "chapter_id": 3459, "verse_number": "२१", "content_sanskrit": "ज्येष्ठो भ्राता ममागृह्णाद् विचिन्वन् वननिर्झरे ।\nअपरिज्ञातशौचायां भूमौ निपतितं फलम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114345, "chapter_id": 3459, "verse_number": "२२", "content_sanskrit": "तदपश्यमहं भ्रातुरसाम्प्रतमनुव्रजन् ।\nविमर्शं सङ्करादाने नायं कुर्यात् कथञ्चन \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114346, "chapter_id": 3459, "verse_number": "२३", "content_sanskrit": "यो नापश्यत् फलं दृष्ट्वा दोषांस्तस्यानुबन्धिकान् ।\nविविनक्ति न शौचार्थी सोऽन्यत्रापि कथं भवेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114347, "chapter_id": 3459, "verse_number": "२४", "content_sanskrit": "संहिताध्ययनस्यान्ते पञ्चयज्ञान् निरूप्य च ।\nभैक्षमुञ्छेन सहितं भुञ्जानस्तु तदा ततः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114348, "chapter_id": 3459, "verse_number": "२५", "content_sanskrit": "कीर्तयत्येव राजर्षे भोजनस्य रसं पुनः ।\nसंहिताध्ययनं कुर्वन् वने गुरुकुले वसन् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114349, "chapter_id": 3459, "verse_number": "२६", "content_sanskrit": "भैक्षमुच्छिष्टमन्येषां भुङ्क्ते स्म सततं तदा ।\nकीर्तयन् गुणमन्नानामघृणी यो मुहुर्मुहुः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114350, "chapter_id": 3459, "verse_number": "२७", "content_sanskrit": "तमहं फलार्थिनं मन्ये भ्रातरं तर्कचक्षुषा ।\nतं वै गच्छस्व नृपते स त्वां संयाजयिष्यति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114351, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114352, "chapter_id": 3459, "verse_number": "२८", "content_sanskrit": "अजुगुप्समानो नृपतिः फलानां कलुषां गतिम् ।\nउपयाजवचः श्रुत्वा द्रुपदः सर्वधर्मवित् ।\nभृशं सम्पूज्य पूजार्हमृषिं याजमुवाच च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114353, "chapter_id": 3459, "verse_number": "२९", "content_sanskrit": "गोऽयुतानि ददाम्यष्टौ याज याजय मां विभो ।\nद्रोणवैरान्तरे तप्तं विषण्णं शरणागतम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114354, "chapter_id": 3459, "verse_number": "३०", "content_sanskrit": "ब्रह्मबन्धुप्रणिहितं न क्षत्रं क्षत्रियो जयेत् ।\nतस्माद् द्रोणभयार्तं मां भवांस्त्रातुमिहार्हति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114355, "chapter_id": 3459, "verse_number": "३१", "content_sanskrit": "भारद्वाजाग्निना दग्धं संह्लादयितुमर्हसि ।\nस हि ब्रह्मविदां श्रेष्ठः शस्त्रास्त्रेष्वसमो भुवि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114356, "chapter_id": 3459, "verse_number": "३२", "content_sanskrit": "ततो द्रोणस्तथाऽजैषीत् स हि विग्रहकारणात् ।\nक्षत्रियो नास्ति तुल्योऽस्य पृथिव्यां कश्चिदर्हणः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114357, "chapter_id": 3459, "verse_number": "३३", "content_sanskrit": "भारताचार्यमुख्यस्य भारद्वाजस्य धीमतः ।\nद्रोणस्य शरजालानि रिपुदेहहराणि च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114358, "chapter_id": 3459, "verse_number": "३४", "content_sanskrit": "षडरत्नि धनुश्चास्य खड्गमप्रतिमं महत् ।\nस हि ब्राह्मणवेगेन क्षात्रं वेगमसंशयम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114359, "chapter_id": 3459, "verse_number": "३५", "content_sanskrit": "प्रतिहत्य चरत्येव भारद्वाजो महामनाः ।\nकार्तवीर्यसमो ह्येष खट्वाङ्गप्रतिमोऽपि वा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114360, "chapter_id": 3459, "verse_number": "३६", "content_sanskrit": "क्षत्रोच्छेदपरायत्तं जामदग्न्यमिवोद्यतम् ।\nसहितं क्षत्रवेगेन ब्राह्मवेगेन साम्प्रतम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114361, "chapter_id": 3459, "verse_number": "३७", "content_sanskrit": "नेषवस्तं पराकुर्युर्नच प्रासा न चासयः ।\nब्राह्मं तस्य हरेत् तेजो मन्त्राहुतिहुतं यथा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114362, "chapter_id": 3459, "verse_number": "३८", "content_sanskrit": "तस्य ह्यस्त्रबलं घोरमप्रसँह्यं परैर्भुवि ।\nशत्रून् समेत्य जयति क्षत्रं ब्रह्मपुरस्कृतम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114363, "chapter_id": 3459, "verse_number": "३९", "content_sanskrit": "ब्रह्मक्षत्रे च सहिते ब्रह्मतेजो विशिष्यते ।\nसोऽहं क्षत्रबलाद् दीनो ब्रह्मतेजः प्रपेदिवान्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114364, "chapter_id": 3459, "verse_number": "४०", "content_sanskrit": "द्रोणाद् विशिष्टमासाद्य भवन्तं वेदवित्तमम् ।\nद्रोणान्तकमहं पुत्रं लभेयं युधि दुर्जयम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114365, "chapter_id": 3459, "verse_number": "४१", "content_sanskrit": "द्रोणमृत्युर्यथा मेऽद्य पुत्रो जायेत वीर्यवान् ।\nतत्कर्म कुरु मे याज निर्वपाम्यर्बुदं गवाम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114366, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2114367, "chapter_id": 3459, "verse_number": "४२", "content_sanskrit": "तथेत्युक्त्वा तु तं याजो याज्यार्थं वाक्यमब्रवीत् ।\nगुर्वर्थ इति चाकाममुपयाजमचोदयत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2114368, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "याजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2114369, "chapter_id": 3459, "verse_number": "४३", "content_sanskrit": "मा भैस्त्वं सम्प्रदातास्मि कर्मणा भवतः सुतम् ।\nक्षिप्रमुत्तिष्ठ चाव्यग्रः सम्भारांश्चोपकल्पय \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2114370, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2114371, "chapter_id": 3459, "verse_number": "४४", "content_sanskrit": "एवमुक्त्वा प्रतिज्ञाय कर्म चास्याददे मुनिः ।\nब्राह्मणो द्विपदां श्रेष्ठो यथाविधि यथाक्रमम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2114372, "chapter_id": 3459, "verse_number": "४५", "content_sanskrit": "याजो द्रोणविनाशाय याजयामास तं नृपम् ।\nगुर्वर्थं याजयन् कर्म याजस्यापि समीपगः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2114373, "chapter_id": 3459, "verse_number": "४६", "content_sanskrit": "ततस्तस्य नरेन्द्रस्य उपयाजो महामनाः ।\nआचख्यौ कर्म वैतानं तदा पुत्रफलाय वै\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2114374, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "उपयाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2114375, "chapter_id": 3459, "verse_number": "४७", "content_sanskrit": "इह पुत्रो महावीर्यो महातेजा महाबलः ।\nइष्यते यद्विधो राजन् भविता ते तथाविधः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2114376, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2114377, "chapter_id": 3459, "verse_number": "४८", "content_sanskrit": "भारद्वाजस्य हन्तारं सोऽभिसन्धाय भूमिपः ।\nआजह्रेऽयं तथा यज्ञं द्रुपदः कर्मसिद्धये\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2114378, "chapter_id": 3459, "verse_number": "४९", "content_sanskrit": "ब्राह्मणो द्विपदां श्रेष्ठो जुहाव च यथाविधि ।\nकोकिलानामतां तस्य चक्रे वै पुत्रगृद्धिनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2114379, "chapter_id": 3459, "verse_number": "५०", "content_sanskrit": "सौत्रामणिं तां तु पत्नीं ततः कालेऽभ्यधात् तदा ।\nयाजस्तु सवनस्यान्ते देवीमाह्वापयत् तदा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2114380, "chapter_id": 3459, "verse_number": "५१", "content_sanskrit": "प्रैहि मां राज्ञि पृषति मिथुनं त्वामुपस्थितम् ।\nकुमारश्च कुमारी च पितृवंशविवृद्धये\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2114381, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "पृषती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2114382, "chapter_id": 3459, "verse_number": "५२", "content_sanskrit": "नालिप्तं वै मम मुखं पुण्यान् गन्धान् बिभर्मि च ।\nन पत्नी तेऽस्ति सूत्यर्थं तिष्ठ याज मम प्रिये\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2114383, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "याजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2114384, "chapter_id": 3459, "verse_number": "५३", "content_sanskrit": "याजेनाश्रपितं हव्यमुपयाजेन मन्त्रितम् ।\nकथं कामं न सन्दध्यात् पृषति प्रैहि तिष्ठ वा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2114385, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2114386, "chapter_id": 3459, "verse_number": "५४", "content_sanskrit": "एवमुक्ते तु याजेन हुते हविषि संस्कृते ।\nउत्तस्थौ पावकात् तस्मात् कुमारो देवसम्मितः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2114387, "chapter_id": 3459, "verse_number": "५५", "content_sanskrit": "ज्वालारूपी घोरवर्णः किरीटी वर्म धारयन् ।\nवीरः सखड्गः सशरो धनुष्मान् विनदन् मुहुः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2114388, "chapter_id": 3459, "verse_number": "५६", "content_sanskrit": "सोऽध्यारोहद् रथवरं तेन च प्रययौ तदा ।\nजातमात्रे कुमारे च वाक् किलान्तर्हिताऽब्रवीत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2114389, "chapter_id": 3459, "verse_number": "५७", "content_sanskrit": "एष शिष्यश्च मृत्युश्च भारद्वाजस्य धीमतः ।\nभयापहो राजपुत्रः पाञ्चालानां यशस्करः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2114390, "chapter_id": 3459, "verse_number": "५८", "content_sanskrit": "राज्ञः शोकापहो जात एष द्रोणवधाय हि ।\nइत्यवोचन्महद्भूतमदृश्यं खेचरं तदा\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2114391, "chapter_id": 3459, "verse_number": "५९", "content_sanskrit": "द्वितीयायां च होत्रायां हुते हविषि मन्त्रतः ।\nकुमारी चापि पाञ्चाली वेदिमध्यात् समुत्थिता\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2114392, "chapter_id": 3459, "verse_number": "६०", "content_sanskrit": "प्रत्याख्याते पृषत्या च याजके भरतर्षभ ।\nपुनः कुमारी पाञ्चाली सुभगा वेदिमध्यगा\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2114393, "chapter_id": 3459, "verse_number": "६१", "content_sanskrit": "अन्तर्वेद्यां समुद्भूता कन्या सा सुमनोहरा ।\nश्यामा पद्मपलाशाक्षी नीलकुञ्चितमूर्धजा \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2114394, "chapter_id": 3459, "verse_number": "६२", "content_sanskrit": "मानुषी विग्रहं कृत्वा साक्षादमरवर्णिनी ।\nनीलोत्पलसमो गन्धो यस्याः क्रोशात् प्रवायति\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2114395, "chapter_id": 3459, "verse_number": "६३", "content_sanskrit": "या बिभर्ति परं रूपं यस्या नास्त्युपमा भुवि ।\nदेवदानवयक्षाणामीप्सिता देववर्णिनी\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2114396, "chapter_id": 3459, "verse_number": "६४", "content_sanskrit": "तां सुजातां गुरुश्रोणीं वागुवाचाशरीरिणी ।\nसर्वयोषिद्वरा कृष्णा क्षयं क्षत्रं निनीषति \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2114397, "chapter_id": 3459, "verse_number": "६५", "content_sanskrit": "सुरकार्यमियं काले करिष्यति सुमध्यमा ।\nतच्छ्रुत्वा सर्वपाञ्चालाः प्रणेदुः सिंहसङ्घवत् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2114398, "chapter_id": 3459, "verse_number": "६६", "content_sanskrit": "न चैनान् हर्षसम्पूर्णानियं सेहे वसुन्धरा ।\nतथा तु मिथुनं जज्ञे द्रुपदस्य महात्मनः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2114399, "chapter_id": 3459, "verse_number": "६७", "content_sanskrit": "कुमारश्च कुमारी च मनोज्ञौ च नरर्षभ ।\nश्रिया परमया युक्तौ क्षात्रेण वपुषा तथा \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2114400, "chapter_id": 3459, "verse_number": "६८", "content_sanskrit": "तौ दृष्ट्वा पृषती याजं प्रपेदे सा सुतार्थिनी ।\nन मां विनाऽन्यां जननीं जानीयेतामिमाविति \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2114401, "chapter_id": 3459, "verse_number": "६९", "content_sanskrit": "तथेत्युवाच तां याजो राज्ञः प्रियचिकीर्षया ।\nतयोस्तु नामनी चक्रुर्द्विजाः सम्पूर्णमानसाः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2114402, "chapter_id": 3459, "verse_number": "७०", "content_sanskrit": "धृष्टत्वादतिधृष्णुत्वात् धर्मात् द्युत्सम्भवादपि ।\nधृष्टद्युम्नः कुमारोऽयं द्रुपदस्य भवत्विति\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2114403, "chapter_id": 3459, "verse_number": "७१", "content_sanskrit": "कृष्णेत्येवाभवत् कृष्णा राजन्नेषा च पार्षती ।\nतथा तन्मिधुनं जज्ञे द्रुपदस्य महामखे\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2114404, "chapter_id": 3459, "verse_number": "७२", "content_sanskrit": "वैदिकाध्ययने पारं धृष्टद्युम्नो गतस्ततः ।\nधृष्टद्युम्नं तु पाञ्चाल्यमानीय द्रुपदात्मजम् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2114405, "chapter_id": 3459, "verse_number": "७३", "content_sanskrit": "उपाकरोदस्त्रहेतोर्भारद्वाजः प्रतापवान् ।\nअमोक्षणीयं दैवं हि एवं मत्वा महामतिः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2114406, "chapter_id": 3459, "verse_number": "७४", "content_sanskrit": "यथावत् कृतवान् द्रोण आत्मकीर्त्यर्थकारणात् ।\nसर्वास्त्राणि स तु क्षिप्रमाप्तवान् परया मुदा\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2114407, "chapter_id": 3459, "verse_number": "१३८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टत्रिंशदधिकशततमोऽध्यायः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2114408, "chapter_id": 3459, "verse_number": "८६", "content_sanskrit": "॥ इति सम्भवपर्वणि षडशीतितमोऽध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2114409, "chapter_id": 3459, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]