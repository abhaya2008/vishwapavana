[{"id": 2014655, "chapter_id": 1305, "verse_number": "२-४६-१", "content_sanskrit": "भीष्म उवाच।\nदैत्येन्द्रो बलवान्त्राजन्सुरारिर्बलगर्वितः।\nहिरण्यकशिपुर्नाम आसीत्रैलोक्यकण्टकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014656, "chapter_id": 1305, "verse_number": "२-४६-२", "content_sanskrit": "दैत्यानामादिपुरुषो वीर्येणाप्रतिमो बली।\nप्रविश्य जलधं राजंश्चकार तप उत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014657, "chapter_id": 1305, "verse_number": "२-४६-३", "content_sanskrit": "दशवर्षसहस्राणि शतानि दश पञ्च च।\nव्रतोपवासतस्तस्थौ स्याणुमौनव्रतो दृढः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014658, "chapter_id": 1305, "verse_number": "२-४६-४", "content_sanskrit": "ततः शमदमाभ्यां च ब्रह्मचर्येण चानघ।\nब्रह्मा प्रीतमनास्तस्य तपसा नियमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014659, "chapter_id": 1305, "verse_number": "२-४६-५", "content_sanskrit": "ततः स्वयम्भूर्भगवान्स्वयमागम्य भूपते।\nविमानेनार्कवर्णेन हंसयुक्तेन भास्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014660, "chapter_id": 1305, "verse_number": "२-४६-६", "content_sanskrit": "आदित्यैर्वसुभिः साध्यैर्मरुद्भिर्दैवतैस्तथा।\nरुद्रैर्विश्वसहायैश्च यक्षराक्षसकिन्नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014661, "chapter_id": 1305, "verse_number": "२-४६-७", "content_sanskrit": "दिशाभिर्विदिशाभिश्च नदीभिः सागरैः सह।\nनक्षत्रैश्च मुहूर्तैश्च खेचरैश्चापरैर्ग्रहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014662, "chapter_id": 1305, "verse_number": "२-४६-८", "content_sanskrit": "देवर्षिभिस्तपोयुक्तैः सिद्धैः सप्तर्षिभिस्तदा।\nराजर्षिभिः पुण्यतमैर्गन्धर्वैरप्सरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014663, "chapter_id": 1305, "verse_number": "२-४६-९", "content_sanskrit": "चराचरगुरुः श्रीमान्वृतः सर्वसुरैस्तथा।\nब्रह्मा ब्रह्मविदां श्रेष्ठो दैत्यमागम्य चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014664, "chapter_id": 1305, "verse_number": "२-४६-१०", "content_sanskrit": "प्रीतोऽस्मि तव भक्तस्य तपसाऽनेन सुव्रत।\nवरं वरय भद्रं ते यथेष्टं काममाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014665, "chapter_id": 1305, "verse_number": "२-४६-११x", "content_sanskrit": "हिरण्यकशिपुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014666, "chapter_id": 1305, "verse_number": "२-४६-११", "content_sanskrit": "न देवा न च गन्धर्वा न यक्षोरगराक्षसाः।\nन मानुषाः पिशाचाश्च हन्युर्मां देवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014667, "chapter_id": 1305, "verse_number": "२-४६-१२", "content_sanskrit": "ऋषयो वा न मां शापैः क्रुद्धा लोकपितामह।\nशपेयुस्तपसा युक्ता वर एष वृतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014668, "chapter_id": 1305, "verse_number": "२-४६-१३", "content_sanskrit": "न शस्त्रेण नचास्त्रेण गिरिणा पादपेन च।\nन शुष्केण न चार्देण स्यान्न वाऽन्येन मे वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014669, "chapter_id": 1305, "verse_number": "२-४६-१४", "content_sanskrit": "नाकाशे नाथ भूमौ वा रात्रौ वा दिवसेपि वा।\nनान्तर्वा न बहिर्वापि स्याद्वधो मे पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014670, "chapter_id": 1305, "verse_number": "२-४६-१५", "content_sanskrit": "पशुभिर्वा मृगैर्न स्यात्पक्षिभिर्वा सरीसृपैः।\nददासि चेद्वरानेतन्देवदेव वृणोम्यहम्।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014671, "chapter_id": 1305, "verse_number": "२-४६-१६x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014672, "chapter_id": 1305, "verse_number": "२-४६-१६", "content_sanskrit": "एते दिव्या वरास्तात मया दत्तास्तवाद्भुताः।\nसर्वकामवरांस्तात प्राप्स्यसि त्वमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014673, "chapter_id": 1305, "verse_number": "२-४६-१७", "content_sanskrit": "एवमुक्त्वा स भगवाञ्जगामाकाशमेव हि।\nरराज ब्रह्मलोके हि ब्रह्मर्षिगणसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014674, "chapter_id": 1305, "verse_number": "२-४६-१८", "content_sanskrit": "ततो देवाश्च नागाश्च गन्धर्वा मुनयस्तथा।\nवरप्रदानं श्रुत्वैव ते ब्रह्माणमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014675, "chapter_id": 1305, "verse_number": "२-४६-१९x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014676, "chapter_id": 1305, "verse_number": "२-४६-१९", "content_sanskrit": "वरेणाने भगवन्बाधिष्यति स नोऽसुरः।\nतत्प्रसीदस्व भगवन्वधोपायोऽस्य चिन्त्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014677, "chapter_id": 1305, "verse_number": "२-४६-२०x", "content_sanskrit": "भीष्म उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014678, "chapter_id": 1305, "verse_number": "२-४६-२०", "content_sanskrit": "ततो लोकहितं वाक्यं श्रुत्वा देवः प्रजापतिः।\nप्रोवाच भगवान्वाक्यं सर्वदेवगणांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014679, "chapter_id": 1305, "verse_number": "२-४६-२१", "content_sanskrit": "अवश्यं त्रिदशास्तेन प्राप्तव्यं तपसः फलम्।\nतपसोऽन्तेऽस्य भगवान्वधं कृष्णः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014680, "chapter_id": 1305, "verse_number": "२-४६-२२", "content_sanskrit": "एतच्छ्रुत्वा सुराः सर्वे ब्रह्मणा तस्य वै वधम्।\nस्वानि स्थानानि दिव्यानि जग्मुस्ते वै मुदान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014681, "chapter_id": 1305, "verse_number": "२-४६-२३", "content_sanskrit": "लब्धमात्रे वरे चापि सर्वास्ता बाधते प्रजाः।\nहिरण्यकशिपुर्दैत्यो वरदानेन दर्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014682, "chapter_id": 1305, "verse_number": "२-४६-२४", "content_sanskrit": "राज्यं चकार दैत्येन्द्रो दैत्यसङ्घैः समावृतः।\nसप्तद्वीपान्वशेचके लोकालोकान्तरं बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014683, "chapter_id": 1305, "verse_number": "२-४६-२५", "content_sanskrit": "दिव्यभोगान्समस्तान्वै लोके सर्वानवाप सः।\nदेवांस्त्रिभुवनस्थांस्तु पराजित्य महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014684, "chapter_id": 1305, "verse_number": "२-४६-२६", "content_sanskrit": "त्रैलोक्यं वशमानीय स्वर्गे वसति दानवः।\nयदा वरमदोन्मत्तो न्यवसद्दानवो दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014685, "chapter_id": 1305, "verse_number": "२-४६-२७", "content_sanskrit": "अथ लोकान्सगस्तांश्च विजित्य स महाबलः।\nभवेयमहमेवेन्द्रः सोमोऽग्निर्मारुतो रविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014686, "chapter_id": 1305, "verse_number": "२-४६-२८", "content_sanskrit": "सलिलं चान्तरिक्षं च नक्षत्राणि दिशो दश।\nअहं क्रोधश्च कामश्च वरुणो वसवोऽर्यमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014687, "chapter_id": 1305, "verse_number": "२-४६-२९", "content_sanskrit": "धनदश्च धनाध्यक्षो यक्षकिम्पुरुषाधिपः।\nएते भवेयमित्युक्त्वा स्वयं भूत्वा बलात्स च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014688, "chapter_id": 1305, "verse_number": "२-४६-३०", "content_sanskrit": "एषां गृहीत्वा स्थानानि तेषां कार्याण्यवाप सः।\nइज्यश्चासीन्मखवरैर्देवकिन्नरसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014689, "chapter_id": 1305, "verse_number": "२-४६-३१", "content_sanskrit": "नरकस्थान्समानीय स्वर्गस्थांश्च चकार सः।\nएवमादीनि कर्माणि कृत्वा दैत्यपतिर्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014690, "chapter_id": 1305, "verse_number": "२-४६-३२", "content_sanskrit": "आश्रमेषु महाभागान्मुनीन्वै शंसितव्रतान्।\nसत्यधर्मपरान्दान्तान्पुरा धर्षितवांस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014691, "chapter_id": 1305, "verse_number": "२-४६-३३", "content_sanskrit": "याज्ञीयान्कृतबान्दैत्यन्याजकांश्चैव देवताः।\nयत्रयत्र सुरा जग्मुस्तत्रतत्र व्रजत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2014692, "chapter_id": 1305, "verse_number": "२-४६-३४", "content_sanskrit": "स्थानानि देवतानां तु हृत्वा राज्यमकारयत्।\nपञ्चकोट्यश्च वर्षाणि अयुतान्येकषष्टि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2014693, "chapter_id": 1305, "verse_number": "२-४६-३५", "content_sanskrit": "षष्टिश्चैव सहस्राणां जग्मुस्तस्य दुरात्मनः।\nएतद्वर्षं स दैत्येन्द्रो भोगैश्चर्यमवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2014694, "chapter_id": 1305, "verse_number": "२-४६-३६", "content_sanskrit": "तेनातिबाध्यमानास्ते दैत्येन्द्रेण बलीयसा।\nब्रह्मलोकं सुरा जग्मुः शर्वशक्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2014695, "chapter_id": 1305, "verse_number": "२-४६-३७", "content_sanskrit": "पितामहं समासाद्य खिन्नाः प्राञ्जलयोऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2014696, "chapter_id": 1305, "verse_number": "२-४६-३८x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2014697, "chapter_id": 1305, "verse_number": "२-४६-३८", "content_sanskrit": "भगवन्भूतभव्येश नस्त्रायस्व इहागतान्।\nभयं दितिसुताद्घोराद्भवत्यद्य दिवानिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2014698, "chapter_id": 1305, "verse_number": "२-४६-३९", "content_sanskrit": "भगवन्सर्वदैत्यानां स्वयम्भूरादिकृत्प्रभुः।\nस्रष्टा त्वं हव्यकव्यानामव्यक्तः प्रकृतिर्ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2014699, "chapter_id": 1305, "verse_number": "२-४६-४०x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2014700, "chapter_id": 1305, "verse_number": "२-४६-४०", "content_sanskrit": "श्रूयतामापदेवं हि दुर्विज्ञेया मयापि च।\nनारायणस्तु पुरुषो विश्वरूपो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2014701, "chapter_id": 1305, "verse_number": "२-४६-४१", "content_sanskrit": "अव्यक्तः सर्वभूतानामचिन्त्यो विभुरव्ययः।\nममापि स तु युष्माकं व्यसने परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2014702, "chapter_id": 1305, "verse_number": "२-४६-४२", "content_sanskrit": "नारायणः परोऽव्यक्तादहमव्यक्तसम्भवः।\nमत्तो जज्ञुः प्रजा लोकाः सर्वे देवासुराश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2014703, "chapter_id": 1305, "verse_number": "२-४६-४३", "content_sanskrit": "देवा यथाहं युष्माकं तथा नारायणो मम।\nपितामहोऽहं सर्वस्य स विष्णुः प्रपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2014704, "chapter_id": 1305, "verse_number": "२-४६-४४", "content_sanskrit": "निश्चितं विषुधा दैत्यं स विष्णुस्तं हनिष्यति।\nतस्य नास्ति न शक्यं च तस्माद्व्रजत माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2014705, "chapter_id": 1305, "verse_number": "२-४६-४५x", "content_sanskrit": "भीष्म उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2014706, "chapter_id": 1305, "verse_number": "२-४६-४५", "content_sanskrit": "पितामहवचः श्रुत्वा सर्वे ते भरतर्षभ।\nविबुधा ब्रह्मणा सार्धं जग्मुः क्षीरोदधिं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2014707, "chapter_id": 1305, "verse_number": "२-४६-४६", "content_sanskrit": "आदित्या वसवः साध्या विश्वे च मरुतस्तथा।\nरुद्रा महर्षयश्चैव अश्विनौ च सुरूपिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2014708, "chapter_id": 1305, "verse_number": "२-४६-४७", "content_sanskrit": "अन्ये च दिव्या ये राजंस्ते सर्वे सगणाः सुराः।\nचतुर्मुखं पुरस्कृत्य श्वेतद्वीपमुपागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2014709, "chapter_id": 1305, "verse_number": "२-४६-४८x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2014710, "chapter_id": 1305, "verse_number": "२-४६-४८", "content_sanskrit": "त्रायस्व नोऽद्य देवेश हिरण्यकशिपोर्वधात्।\nत्वं हि नः परमो धाता ब्रह्मादीनां सुरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2014711, "chapter_id": 1305, "verse_number": "२-४६-४९", "content_sanskrit": "उत्फुल्लाम्बुजपत्राक्ष शत्रुपक्षभयङ्कर।\nक्षयाय दितिवंशस्य शरणं त्वं भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2014712, "chapter_id": 1305, "verse_number": "२-४६-५०x", "content_sanskrit": "भीष्ण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2014713, "chapter_id": 1305, "verse_number": "२-४६-५०", "content_sanskrit": "तद्देवानां वचः श्रुत्वा तदा विष्णुः शुचिश्रवाः।\nअदृश्यः सर्वभूतात्मा वक्तुमेवोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2014714, "chapter_id": 1305, "verse_number": "२-४६-५१x", "content_sanskrit": "विष्णुरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2014715, "chapter_id": 1305, "verse_number": "२-४६-५१", "content_sanskrit": "भयं त्यजध्वममरा अभयं वो ददाम्यहम्।\nतदेव त्रिदिवं देवाः प्रतिपद्यत माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2014716, "chapter_id": 1305, "verse_number": "२-४६-५२", "content_sanskrit": "एषोऽहं सगणं दैत्यं वरदानेन दर्पितम्।\nअवध्यममरेन्द्राणां दानवेन्द्रं निहन्म्यहम्॥ २-४६-५३ ब्रह्मोवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2014717, "chapter_id": 1305, "verse_number": "२-४६-५३", "content_sanskrit": "भहवन्देवदेवेश खिन्ना एते भृशं सुराः।\nतस्मात्त्वं जहि दैत्येन्द्रं क्षिप्रं कालोऽस्य माचिरम्।\nएष त्वं सगणं दैत्यं वरदानेन दर्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2014718, "chapter_id": 1305, "verse_number": "२-४६-५४x", "content_sanskrit": "विष्णुरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2014719, "chapter_id": 1305, "verse_number": "२-४६-५४", "content_sanskrit": "क्षिप्रमेव करिष्यामि त्वरया दैत्यनाशनम्।\nतस्मात्त्वं विबुधाश्चैव प्रतिपद्यत वै दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2014720, "chapter_id": 1305, "verse_number": "२-४६-५५x", "content_sanskrit": "भीष्म उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2014721, "chapter_id": 1305, "verse_number": "२-४६-५५", "content_sanskrit": "एवमुक्त्वा तु भगवान्विसृज्य त्रिदिवेश्वरान्।\nनरस्यार्धतनुर्भूत्वा सिंहस्यार्धतनुः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2014722, "chapter_id": 1305, "verse_number": "२-४६-५६", "content_sanskrit": "नारसिंहेन वपुषा पाणिं संस्पृश्य पाणिना।\nभीमरूपो महातेजा व्यादितास्य इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2014723, "chapter_id": 1305, "verse_number": "२-४६-५७", "content_sanskrit": "हिरण्यकशिपुं राजञ्जगाम हरिरीश्वरः।\nदैत्यास्तमागतं दृष्ट्वा नारसिंहं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2014724, "chapter_id": 1305, "verse_number": "२-४६-५८", "content_sanskrit": "ववर्षुः शस्त्रवर्षैस्ते सुसङ्क्रुद्धास्तदा हरिम्।\nतैः सृष्टसर्वशस्त्राणि भक्षयामास वै हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2014725, "chapter_id": 1305, "verse_number": "२-४६-५९", "content_sanskrit": "जघान न रणे दैत्यान्सहस्राणि बहूनि च।\nतान्निहत्य च दैतेयान्सर्वान्क्रुद्धान्महाबलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2014726, "chapter_id": 1305, "verse_number": "२-४६-६०", "content_sanskrit": "अभ्यधावत्सुसङ्क्रुद्धो दैत्येन्द्रं बलगर्वितम्।\nजीमूतघनसङ्काशो जीमूतघननिस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2014727, "chapter_id": 1305, "verse_number": "२-४६-६१", "content_sanskrit": "जीमूत इव दीप्तौजा जीमूत इव वेगवान्।\nदैत्यं सोऽतिबलं दृप्तं दृप्तशार्दूलविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2014728, "chapter_id": 1305, "verse_number": "२-४६-६२", "content_sanskrit": "दृप्तैर्दैत्यगणैर्गुप्तं खरैर्नखमुकैरुत।\nततः कृत्वा तु युद्धं वै तेन दैत्येन वै हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2014729, "chapter_id": 1305, "verse_number": "२-४६-६३", "content_sanskrit": "सन्ध्याकाले महातेजा भवनान्ते त्वरान्वितः।\nऊरौ निधाय दैत्येन्द्रं निर्बिभेद नखैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2014730, "chapter_id": 1305, "verse_number": "२-४६-६४", "content_sanskrit": "महाबलं महावीर्यं वरदानेन गर्वितम्।\nदैत्यश्रेष्ठं सुरश्रेष्ठो जघान तरसा हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2014731, "chapter_id": 1305, "verse_number": "२-४६-६५", "content_sanskrit": "हिरण्यकशिपुं हत्वा सर्वदैत्यांश्च वै तदा।\nविबुधानां प्रजानां च हितं कृत्वा महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2014732, "chapter_id": 1305, "verse_number": "२-४६-६६", "content_sanskrit": "प्रमुमोद हरिर्देवः प्राप्य धर्मं तदा भुवि।\nएष ते नारसिंहोऽत्र कथितः पाण्डुनन्दन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2014733, "chapter_id": 1305, "verse_number": "२-४६-६७", "content_sanskrit": "शृणु त्वं वामनं नाम प्रादुर्भावं महात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2014734, "chapter_id": 1305, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि षट्चत्वारिंशोऽध्यायः॥ ४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]