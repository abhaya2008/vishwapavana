[{"id": 7003984000, "chapter_id": 23984, "verse_number": "३-१-४७-१", "content_sanskrit": "ऋषय ऊचुः ।\nराक्षसस्य वधात्सूत रावणस्य महामुने ।\nब्रह्महत्या कथमभूद्राघवस्य महात्मनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003984001, "chapter_id": 23984, "verse_number": "३-१-४७-२", "content_sanskrit": "ब्राह्मणस्य वधात्सूत ब्रह्महत्याभिजायते ।\nन ब्राह्मणो दशग्रीवः कथं तद्वद नो मुने॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003984002, "chapter_id": 23984, "verse_number": "३-१-४७-३", "content_sanskrit": "ब्रह्महत्या भवेत्क्रूरा रामचंद्रस्य धीमतः ।\nएतन्नः श्रद्दधानानां वद कारुण्यतोऽधुना॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003984003, "chapter_id": 23984, "verse_number": "३-१-४७-४", "content_sanskrit": "इति पृष्टस्ततः सूतो नैमिषारण्यवासिभिः ।\nवक्तुं प्रचक्रमे तेषां प्रश्नस्योत्तरमुत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003984004, "chapter_id": 23984, "verse_number": "३-१-४७-५", "content_sanskrit": "श्रीसूत उवाच ।\nब्रह्मपुत्रो महातेजाः पुलस्त्योनाम वै द्विजाः ।\nबभूव तस्य पुत्रोऽभूद्विश्रवा इति विश्रुतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003984005, "chapter_id": 23984, "verse_number": "३-१-४७-६", "content_sanskrit": "तस्य पुत्रः पुलस्त्य स्य विश्रवा मुनिपुंगवाः ।\nचिरकालं तपस्तेपे देवैरपि सुदुष्करम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003984006, "chapter_id": 23984, "verse_number": "३-१-४७-७", "content_sanskrit": "तपः कुर्वति तस्मिंस्तु सुमाली नाम राक्षसः ।\nपाताललोकाद्भूलोकं सर्वं वै विचचार ह॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003984007, "chapter_id": 23984, "verse_number": "३-१-४७-८", "content_sanskrit": "हेमनिष्कांगदधरः कालमेघनिभच्छविः ।\nसमादाय सुतां कन्यां पद्महीनामिव श्रियम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003984008, "chapter_id": 23984, "verse_number": "३-१-४७-९", "content_sanskrit": "विचरन्स महीपृष्ठे कदाचित्पुष्पकस्थितम् ।\nदृष्ट्वा विश्रवसः पुत्रं कुबेरं वै धनेश्वरम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003984009, "chapter_id": 23984, "verse_number": "३-१-४७-१०", "content_sanskrit": "चिंतयामास विप्रेंद्राः सुमाली स तु राक्षसः ।\nकुबेरसदृशः पुत्रो यद्यस्माकं भविष्यति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003984010, "chapter_id": 23984, "verse_number": "३-१-४७-११", "content_sanskrit": "वयं वर्द्धामहे सर्वे राक्षसा ह्यकुतोभयाः ।\nविचार्यैवं निजसुतामब्रवीद्राक्षसेश्वरः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003984011, "chapter_id": 23984, "verse_number": "३-१-४७-१२", "content_sanskrit": "सुते प्रदानकालोऽद्य तव कैकसि शोभने ।\nअद्य ते यौवनं प्राप्तं तद्देया त्वं वराय हि॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003984012, "chapter_id": 23984, "verse_number": "३-१-४७-१३", "content_sanskrit": "अप्रदानेन पुत्रीणां पितरो दुःखमाप्नुयुः ।\nकिं च सर्वगुणोत्कृष्टा लक्ष्मीरिव सुते शुभे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003984013, "chapter_id": 23984, "verse_number": "३-१-४७-१४", "content_sanskrit": "प्रत्याख्यानभयात्पुंभिर्न च त्वं प्रार्थ्यसे शुभे ।\nकन्यापितृत्वं दुःखाय सर्वेषां मानकांक्षिणाम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003984014, "chapter_id": 23984, "verse_number": "३-१-४७-१५", "content_sanskrit": "न जानेऽहं वरः को वा वरयेदिति कन्यके ।\nसा त्वं पुलस्त्यतनयं मुनिं विश्रवसं द्विजम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003984015, "chapter_id": 23984, "verse_number": "३-१-४७-१६", "content_sanskrit": "पितामहकुलोद्भूतं वरयस्व स्वयंगता ।\nकुबेरतुल्यास्तनया भवेयुस्ते न संशयः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003984016, "chapter_id": 23984, "verse_number": "३-१-४७-१७", "content_sanskrit": "कैकसी तद्वचः श्रुत्वा सा कन्या पितृगौरवात् ।\nअंगीचकार तद्वाक्यं तथास्त्विति शुचिस्मिता॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003984017, "chapter_id": 23984, "verse_number": "३-१-४७-१८", "content_sanskrit": "पर्णशालां मुनिश्रेष्ठा गत्वा विश्रवसो मुनेः ।\nअतिष्ठदंतिके तस्य लज्जमाना ह्यधोमुखी॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003984018, "chapter_id": 23984, "verse_number": "३-१-४७-१९", "content_sanskrit": "तस्मिन्नवसरे विप्राः पुलस्त्यतनयः सुधीः ।\nअग्निहोत्रमुपास्ते स्म ज्वलत्पावकसन्निभः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003984019, "chapter_id": 23984, "verse_number": "३-१-४७-२०", "content_sanskrit": "संध्याकालमतिक्रूरमविचिंत्य तु कैकसी ।\nअभ्येत्य तं मुनिं सुभ्रूः पितुर्वचनगौरवात्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003984020, "chapter_id": 23984, "verse_number": "३-१-४७-२१", "content_sanskrit": "तस्थावधोमुखी भूमिं लिखत्यंगुष्ठकोटिना ।\nविश्रवास्तां विलोक्याथ कैकसीं तनुमध्यमाम् ।\nउवाच सस्मितो विप्राः पूर्णचंद्रनिभाननाम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003984021, "chapter_id": 23984, "verse_number": "३-१-४७-२२", "content_sanskrit": "विश्रवा उवाच ।\nशोभने कस्य पुत्री त्वं कुतो वा त्वमिहागता॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003984022, "chapter_id": 23984, "verse_number": "३-१-४७-२३", "content_sanskrit": "कार्यं किं वा त्वमुद्दिश्य वर्तसेऽत्र शुचिस्मिते ।\nयथार्थतो वदस्वाद्य मम सर्वमनिंदिते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003984023, "chapter_id": 23984, "verse_number": "३-१-४७-२४", "content_sanskrit": "इतीरिता कैकसी सा कन्या बद्धांजलिर्द्विजाः ।\nउवाच तं मुनिं प्रह्वा विनयेन समन्विता॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003984024, "chapter_id": 23984, "verse_number": "३-१-४७-२५", "content_sanskrit": "तपः प्रभावेन मुने मदभिप्रायमद्य तु ।\nवेत्तुमर्हसि सम्यक्त्वं पुलस्त्यकुलदीपन॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003984025, "chapter_id": 23984, "verse_number": "३-१-४७-२६", "content_sanskrit": "अहं तु कैकसी नाम सुमालिदुहिता मुने ।\nमत्तातस्याज्ञया ब्रह्मंस्तवांतिकमुपागता॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003984026, "chapter_id": 23984, "verse_number": "३-१-४७-२७", "content_sanskrit": "शेष त्वं ज्ञानदृष्ट्याद्य ज्ञातुमर्हस्यसंशयः ।\nक्षणं ध्यात्वा मुनिः प्राह विश्रवाः स तु कैकसीम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003984027, "chapter_id": 23984, "verse_number": "३-१-४७-२८", "content_sanskrit": "मया ते विदितं सुभ्रूर्मनोगतमभीप्सितम् ।\nपुत्राभिलाषिणी सा त्वं मामगाः सांप्रतं शुभे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003984028, "chapter_id": 23984, "verse_number": "३-१-४७-२९", "content_sanskrit": "सायंकालेऽधुना क्रूरे यस्मान्मां त्वमुपागता ।\nपुत्राभिलाषिणी भूत्वा तस्मात्त्वां प्रब्रवीम्यहम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003984029, "chapter_id": 23984, "verse_number": "३-१-४७-३०", "content_sanskrit": "शृणुष्वावहिता रामे कैकसी त्वमनिंदिते ।\nदारुणान्दारुणाकारान्दारुणाभिजनप्रियान्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003984030, "chapter_id": 23984, "verse_number": "३-१-४७-३१", "content_sanskrit": "जनयिष्यसि पुत्रांस्त्वं राक्षसान्क्रूरकर्मणः ।\nश्रुत्वा तद्वचनं सा तु कैकसी प्रणिपत्य तम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003984031, "chapter_id": 23984, "verse_number": "३-१-४७-३२", "content_sanskrit": "पुलस्त्यतनयं प्राह कृतांजलिपुटा द्विजाः ।\nभगवदीदृशाः पुत्रास्त्वत्तः प्राप्तुं न युज्यते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003984032, "chapter_id": 23984, "verse_number": "३-१-४७-३३", "content_sanskrit": "इत्युक्तः स मुनिः प्राह कैकसीं तां सुमध्यमाम् ।\nमद्वंशानुगुणः पुत्रः पश्चिमस्ते भविष्यति॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003984033, "chapter_id": 23984, "verse_number": "३-१-४७-३४", "content_sanskrit": "धार्मिकः शास्त्रविच्छांतो न तु राक्षसचेष्टितः ।\nइत्युक्ता कैकसी विप्राः काले कतिपये गते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003984034, "chapter_id": 23984, "verse_number": "३-१-४७-३५", "content_sanskrit": "सुषुवे तनयं क्रूरं रक्षोरूपं भयंकरम् ।\nद्विपंचशीर्षं कुमतिं विंशद्बाहुं भयानकम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003984035, "chapter_id": 23984, "verse_number": "३-१-४७-३६", "content_sanskrit": "ताम्रोष्ठं कृष्णवदनं रक्तश्मश्रु शिरोरुहम् ।\nमहादंष्ट्रं महाकायं लोकत्रासकरं सदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003984036, "chapter_id": 23984, "verse_number": "३-१-४७-३७", "content_sanskrit": "दशग्रीवाभिधः सोऽभूत्तथा रावण नामवान् ।\nरावणानंतरं जातः कुम्भकर्णाभिधः सुतः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003984037, "chapter_id": 23984, "verse_number": "३-१-४७-३८", "content_sanskrit": "ततः शूर्पणखा नाम्ना क्रूरा जज्ञे च राक्षसी ।\nततो बभूव कैकस्या विभीषण इति श्रुतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003984038, "chapter_id": 23984, "verse_number": "३-१-४७-३९", "content_sanskrit": "पश्चिमस्तनयो धीमान्धार्मिको वेदशास्त्रवित् ।\nएते विश्रवसः पुत्रा दशग्रीवादयो द्विजाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003984039, "chapter_id": 23984, "verse_number": "३-१-४७-४०", "content_sanskrit": "अतो दशग्रीववधात्कुम्भकर्णवधादपि ।\nब्रह्महत्या समभवद्रामस्याक्लिष्टकर्मणः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003984040, "chapter_id": 23984, "verse_number": "३-१-४७-४१", "content_sanskrit": "अतस्तच्छांतये रामो लिंगं रामेश्वराभिधम् ।\nस्थापयामास विधिना वैदिकेन द्विजोत्तमाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003984041, "chapter_id": 23984, "verse_number": "३-१-४७-४२", "content_sanskrit": "एवं रावणघातेन ब्रह्महत्यासमुद्भवः ।\nसमभूद्रामचंद्रस्य लोककांतस्य धीमतः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003984042, "chapter_id": 23984, "verse_number": "३-१-४७-४३", "content_sanskrit": "तत्सहैतुकमाख्यातं भवतां ब्रह्मघातजम् ।\nपापं यच्छांतये रामो लिंगं प्रातिष्ठिपत्स्वयम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003984043, "chapter_id": 23984, "verse_number": "३-१-४७-४४", "content_sanskrit": "एवं लिंगं प्रतिष्ठाप्य रामचन्द्रोऽतिधार्मिकः ।\nमेने कृतार्थमात्मानं ससीता वरजो द्विजाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003984044, "chapter_id": 23984, "verse_number": "३-१-४७-४५", "content_sanskrit": "ब्रह्महत्या गता यत्र रामचंद्रस्य भूपतेः ।\nतत्र तीर्थमभूत्किंचिद्ब्रह्महत्याविमोचनम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003984045, "chapter_id": 23984, "verse_number": "३-१-४७-४६", "content_sanskrit": "तत्र स्नानं महापुण्यं ब्रह्महत्याविनाशनम् ।\nदृश्यते रावणोऽद्यापि छायारूपेण तत्र वै॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003984046, "chapter_id": 23984, "verse_number": "३-१-४७-४७", "content_sanskrit": "तदग्रे नागलोकस्य बिलमस्ति महत्तरम् ।\nदशग्रीववधोत्पन्नां ब्रह्महत्यां बलीयसीम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003984047, "chapter_id": 23984, "verse_number": "३-१-४७-४८", "content_sanskrit": "तद्बिलं प्रापयामास जानकीरमणो द्विजाः ।\nतस्योपरि बिलस्याथ कृत्वा मण्डपमुत्तमम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003984048, "chapter_id": 23984, "verse_number": "३-१-४७-४९", "content_sanskrit": "भैरवं स्थापयामास रक्षार्थं तत्र राघवः ।\nभैरवाज्ञापरित्रस्ता ब्रह्महत्या भयंकरी॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003984049, "chapter_id": 23984, "verse_number": "३-१-४७-५०", "content_sanskrit": "नाशक्नोत्तद्बिलादूर्ध्वं निर्गंतुं द्विजसत्तमाः ।\nतस्मिन्नेव बिले तस्थौ ब्रह्महत्या निरुद्यमा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003984050, "chapter_id": 23984, "verse_number": "३-१-४७-५१", "content_sanskrit": "रामनाथमहालिंगं दक्षिणे गिरिजा मुदा ।\nवर्तते परमानंदशिवस्यार्धशरीरिणी॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003984051, "chapter_id": 23984, "verse_number": "३-१-४७-५२", "content_sanskrit": "आदित्यसोमौ वर्तेते पार्श्वयोस्तत्र शूलिनः ।\nदेवस्य पुरतो वह्नी रामनाथस्य वर्तते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003984052, "chapter_id": 23984, "verse_number": "३-१-४७-५३", "content_sanskrit": "आस्ते शतक्रतुः प्राच्यामाग्नेयां च तथाऽनलः ।\nआस्ते यमो दक्षिणस्यां रामनाथस्य सेवकः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003984053, "chapter_id": 23984, "verse_number": "३-१-४७-५४", "content_sanskrit": "नैरृते निरृतिर्विप्रा वर्तते शंकरस्य तु ।\nवारुण्यां वरुणो भक्त्या सेवते राघवेश्वरम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003984054, "chapter_id": 23984, "verse_number": "३-१-४७-५५", "content_sanskrit": "वायव्ये तु दिशो भागे वायुरास्ते शिवस्य तु ।\nउत्तरस्यां च धनदो रामनाथस्य वर्तते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003984055, "chapter_id": 23984, "verse_number": "३-१-४७-५६", "content_sanskrit": "ईशान्येऽस्य च दिग्भागे महेशो वर्तते द्विजाः ।\nविनायक कुमारौ च महादेवसुतावुभौ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003984056, "chapter_id": 23984, "verse_number": "३-१-४७-५७", "content_sanskrit": "यथाप्रदेशं वर्तेते रामनाथालयेऽधुना ।\nवीरभद्रादयः सर्वे महेश्वरगणेश्वराः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003984057, "chapter_id": 23984, "verse_number": "३-१-४७-५८", "content_sanskrit": "यथाप्रदेशं वर्तंते रामनाथालये सदा ।\nमुनयः पन्नगाः सिद्धा गन्धर्वाप्सरसां गणाः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003984058, "chapter_id": 23984, "verse_number": "३-१-४७-५९", "content_sanskrit": "संतुष्यमाणहृदया यथेष्टं शिवसन्निधौ ।\nवर्तंते रामनाथस्य सेवार्थं भक्तिपूर्वकम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003984059, "chapter_id": 23984, "verse_number": "३-१-४७-६०", "content_sanskrit": "रामनाथस्य पूजार्थं श्रोत्रियान्ब्राह्मणान्बहून् ।\nरामेश्वरे रघुपतिः स्थापयामास पूजकान्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003984060, "chapter_id": 23984, "verse_number": "३-१-४७-६१", "content_sanskrit": "रामप्रतिष्ठितान्विप्रान्हव्यकव्यादिनार्चयेत् ।\nतुष्टास्ते तोषिताः सर्वा पितृभिः सहदेवताः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003984061, "chapter_id": 23984, "verse_number": "३-१-४७-६२", "content_sanskrit": "तेभ्यो बहुधनान्ग्रामान्प्रददौ जानकीपतिः ।\nरामनाथमहादेव नैवेद्यार्थमपि द्विजाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003984062, "chapter_id": 23984, "verse_number": "३-१-४७-६३", "content_sanskrit": "बहून्ग्रामान्बहुधनं प्रददौ लक्ष्मणाग्रजः ।\nहारकेयूरकटकनिष्काद्याभरणानि च॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003984063, "chapter_id": 23984, "verse_number": "३-१-४७-६४", "content_sanskrit": "अनेकपट्ट वस्त्राणि क्षौमाणि विविधानि च ।\nरामनाथाय देवाय ददौ दशरथात्मजः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003984064, "chapter_id": 23984, "verse_number": "३-१-४७-६५", "content_sanskrit": "गंगा च यमुना पुण्या सरयूश्च सरस्वती ।\nसेतौ रामेश्वरं देवं भजंते स्वाघशांतये॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003984065, "chapter_id": 23984, "verse_number": "३-१-४७-६६", "content_sanskrit": "एतदध्यायपठनाच्छ्रवणादपि मानवः ।\nविमुक्तः सर्वपापेभ्यः सायुज्यं लभते हरेः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]