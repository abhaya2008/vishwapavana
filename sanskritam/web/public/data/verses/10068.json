[{"id": 6000068000, "chapter_id": 10068, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000068001, "chapter_id": 10068, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.001.m4a", "display_order": 2}, {"id": 6000068002, "chapter_id": 10068, "verse_number": "४-४-१", "content_sanskrit": "एतावदुक्त्वा विरराम शङ्करः पत्न्यङ्गनाशं ह्युभयत्र चिन्तयन्।\nसुहृद्दिदृक्षुः परिशङ्किता भवान्निष्क्रामती निर्विशती द्विधा च सा॥ ४/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.002.m4a", "display_order": 3, "topics": [{"text": "स्वभर्त्राज्ञां विनाऽपि सतीदेव्या दक्षाध्वरं प्रति गमनम्", "range": "१–५"}]}, {"id": 6000068003, "chapter_id": 10068, "verse_number": "४-४-२", "content_sanskrit": "सुहृद्दिदृक्षाप्रतिघातदुर्मनाः स्नेहाद्रुदन्त्यश्रुकलातिविह्वला।\nभवं भवान्यप्रतिपूरुषं रुषा प्रधक्ष्यतीवैक्षत जातवेपथुः॥ ४/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.003.m4a", "display_order": 4}, {"id": 6000068004, "chapter_id": 10068, "verse_number": "४-४-३", "content_sanskrit": "ततो विनिःश्वस्य सती विहाय तं शोकेन रोषेण च दूयता हृदा।\nपित्रोरगात् स्‍त्रैणविमूढधीर्गृहान् प्रेम्णाऽऽत्मनो योऽर्धमरासत प्रियः॥ ४/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.004.m4a", "display_order": 5}, {"id": 6000068005, "chapter_id": 10068, "verse_number": "४-४-४", "content_sanskrit": "तामन्वगच्छन् द्रुतविक्रमां सतीमेकां त्रिनेत्रानुचराः सहस्रशः।\nसपार्षदमुख्या मणिमन्मदादयः पुरोवृषेन्द्रास्तरसाऽऽगतव्यथाः॥ ४/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.005.m4a", "display_order": 6}, {"id": 6000068006, "chapter_id": 10068, "verse_number": "४-४-५", "content_sanskrit": "तां सारिकामण्डुकदर्पणाम्बुजैः श्वेतातपत्रव्यजनस्रगादिभिः।\nगीतायनैर्दुन्दुभिशङ्खवेणुभिर्वृषेन्द्रमारोप्य विलम्बिता ययुः॥ ४/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.006.m4a", "display_order": 7}, {"id": 6000068007, "chapter_id": 10068, "verse_number": "४-४-६", "content_sanskrit": "आब्रह्मघोषोर्जितयज्ञवैशसं विप्रर्षिजुष्टं विबुधैश्च सर्वशः।\nमृद्दार्वयःकाञ्चनदर्भचर्मभिर्निसृष्टभाण्डं यजनं समाविशत्॥ ४/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.007.m4a", "display_order": 8, "topics": [{"text": "तत्र पित्रवमानितया तया अरुद्रभागक्रतुं निरीक्ष्य क्रोधेन स्वभर्तृप्रदर्शनपूर्वकं दक्षं विनिन्दनम्", "range": "६–२३"}]}, {"id": 6000068008, "chapter_id": 10068, "verse_number": "४-४-७", "content_sanskrit": "तामागतां तत्र न कश्चनाद्रियद् विमानितां यज्ञकृतो भयाज्‍जनः।\nऋते स्वसारो जननीं च सादराः प्रेमाश्रुकण्ठ्यः परिसस्वजुर्मुदा॥ ४/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.008.m4a", "display_order": 9}, {"id": 6000068009, "chapter_id": 10068, "verse_number": "४-४-८", "content_sanskrit": "सौन्दर्यसम्प्रश्नसमर्थवार्तया मात्रा च मातृष्वसृभिश्च सादरम्।\nदत्तां सपर्यां वरमासनं च सा नादत्त पित्राऽप्रतिनन्दिता सती॥ ४/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.009.m4a", "display_order": 10}, {"id": 6000068010, "chapter_id": 10068, "verse_number": "४-४-९", "content_sanskrit": "अरुद्रभागं तमवेक्ष्य चाध्वरं पित्रा च देवे कृतहेलनं विभौ।\nअनादृता यज्ञसदस्यधीश्वरी चुकोप लोकानिव धक्ष्यती रुषा॥ ४/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.010.m4a", "display_order": 11}, {"id": 6000068011, "chapter_id": 10068, "verse_number": "४-४-१०", "content_sanskrit": "जगर्ह सामर्षविपन्नया गिरा शिवद्विषं धूमपथश्रमस्मयम्।\nस्वतेजसा भूतगणान् समुत्थितान् निगृह्य देवी जगतोऽभिशृृण्वतः॥ ४/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.011.m4a", "display_order": 12}, {"id": 6000068012, "chapter_id": 10068, "verse_number": null, "content_sanskrit": "देव्युवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.012.m4a", "display_order": 13}, {"id": 6000068013, "chapter_id": 10068, "verse_number": "४-४-११", "content_sanskrit": "न यस्य लोकेऽस्त्यतिशायनः प्रियस्तथाऽप्रियो देहभृतां प्रियात्मनः।\nतस्मिन् समस्तात्मनि मुक्तवैरके ऋते भवन्तं कतमः प्रतीपकः॥ ४/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.013.m4a", "display_order": 14}, {"id": 6000068014, "chapter_id": 10068, "verse_number": "४-४-१२", "content_sanskrit": "दोषान् परेषां हि गुणेष्वसाधवो गृह्णन्ति केचिन्न भवादृशा द्विजाः।\nगुणांश्च फल्गून् बहुलीकरिष्णवो महत्तमास्तेष्वविदद् भवानघम्॥ ४/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.014.m4a", "display_order": 15}, {"id": 6000068015, "chapter_id": 10068, "verse_number": "४-४-१३", "content_sanskrit": "नाश्चर्यमेतद् यदसत्सु सर्वदा महद्विनिन्दा कुणपात्मवादिषु।\nसेर्ष्या महापूरुषपादपांसुभिर्निरस्ततेजस्सु तदेव शोभनम्॥ ४/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.015.m4a", "display_order": 16}, {"id": 6000068016, "chapter_id": 10068, "verse_number": "४-४-१४", "content_sanskrit": "यद् द्व्यक्षरं नाम गिरेरितं नृणां सकृत् प्रसङ्गादघमाशु हन्ति तत्।\nपवित्रकीर्तिं तमलङ्घ्यशासनं भवानहो द्वेष्टि शिवं शिवेतरः॥ ४/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.016.m4a", "display_order": 17}, {"id": 6000068017, "chapter_id": 10068, "verse_number": "४-४-१५", "content_sanskrit": "यत्पादपद्मं महतां मनोऽलिभिर्निषेवितं ब्रह्मरसासवार्थिभिः।\nलोकस्य यद् वर्षति चाशिषोऽर्थिनः तस्मै भवान् द्रुह्यति विश्वबन्धवे॥ ४/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.017.m4a", "display_order": 18}, {"id": 6000068018, "chapter_id": 10068, "verse_number": "४-४-१६", "content_sanskrit": "किं वा शिवाख्यमशिवं न विदुस्त्वदन्ये ब्रह्मादयस्तमवकीर्य जटाः श्मशाने।\nतन्माल्यभस्मनृकपाल्यवसत्पिशाचैर्ये मूर्धभिर्दधति तच्चरणावसृष्टम्॥ ४/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.018.m4a", "display_order": 19}, {"id": 6000068019, "chapter_id": 10068, "verse_number": "४-४-१७", "content_sanskrit": "कर्णौ पिधाय निरियाद् यदकल्प ईशे धर्मावितर्यघृणिभिर्नृभिरस्यमाने।\nछिन्द्यात् प्रसह्य रुशतीमसतां प्रभुश्चेज्‍जिह्वामसूनपि ततो विसृजेत् स धर्मः॥ ४/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.019.m4a", "display_order": 20}, {"id": 6000068020, "chapter_id": 10068, "verse_number": "४-४-१८", "content_sanskrit": "अतस्तवोत्पन्नमिदं कलेवरं न धारयिष्ये शितिकण्ठगर्हिणः।\nजग्धस्य मोहाद्धि विशुद्धिमन्धसो जुगुप्सितस्योद्धरणं प्रचक्षते॥ ४/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.020.m4a", "display_order": 21}, {"id": 6000068021, "chapter_id": 10068, "verse_number": "४-४-१९", "content_sanskrit": "न वेदवादाननुवर्तते मतिः स्व एव लोके रमतो महामुनेः।\nयथा गतिर्देवमनुष्ययोः पृथक् स्व एव धर्मे न परं क्षिपेत् स्थितः॥ ४/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.021.m4a", "display_order": 22}, {"id": 6000068022, "chapter_id": 10068, "verse_number": "४-४-२०", "content_sanskrit": "कर्म प्रवृत्तं च निवृत्तमप्युत वेदे विविच्योभयलिङ्गमाश्रितम्।\nविरोधि तद् यौगपदेककर्तरि द्वयं यथाऽऽब्रह्मणि कर्म नर्च्छति॥ ४/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.022.m4a", "display_order": 23}, {"id": 6000068023, "chapter_id": 10068, "verse_number": "४-४-२१", "content_sanskrit": "मा वः पदव्यः पितरस्मदास्थिता या यज्ञशालासनधूमवर्त्मनाम्।\nकदन्नतृप्तैरसुभृद्भिरीडिता अव्यक्तलिङ्गा अवधूतसेविताः॥ ४/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.023.m4a", "display_order": 24}, {"id": 6000068024, "chapter_id": 10068, "verse_number": "४-४-२२", "content_sanskrit": "एतेन देहेन हरे कृतागसो देहोद्भवेनालमलं कुजन्मना।\nव्रीडा ममाभूत् कुजनप्रसङ्गतः तज्‍जन्म धिग् यन्महतामवद्यकृत्॥ ४/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.024.m4a", "display_order": 25}, {"id": 6000068025, "chapter_id": 10068, "verse_number": "४-४-२३", "content_sanskrit": "गोत्रं त्वदीयं भगवान् वृषध्वजो दाक्षायणीत्याह यदा सुदुर्मनाः।\nव्यपेतनर्मस्मितमाशु तावदुत्स्रक्ष्य एतत्कुणपं त्वदङ्गजम्॥ ४/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_004/BhP_04.004.025.m4a", "display_order": 26}, {"id": 6000068026, "chapter_id": 10068, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]