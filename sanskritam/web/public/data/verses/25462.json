[{"id": 7005462000, "chapter_id": 25462, "verse_number": "१-३२-१", "content_sanskrit": "सूत उवाच ।\nस शिष्यैः संवृतो धीमान् गुरुर्द्वैपायनो मुनिः ।\nजगाम विपुलं लिङ्गमोंकारं मुक्तिदायकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005462001, "chapter_id": 25462, "verse_number": "१-३२-२", "content_sanskrit": "तत्राभ्यर्च्य महादेवं शिष्यैः सह महामुनिः ।\nप्रोवाच तस्य माहात्म्यं मुनीनां भावितात्मनाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005462002, "chapter_id": 25462, "verse_number": "१-३२-३", "content_sanskrit": "इदं तद् विमलं लिङ्गमोंकारं नाम शोभनम् ।\nअस्य स्मरणमात्रेण मुच्यते सर्वपातकैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005462003, "chapter_id": 25462, "verse_number": "१-३२-४", "content_sanskrit": "एतत् परतरं ज्ञानं पञ्चयतनमुत्तमम् ।\nसेवितं सूरिभिर्नित्यं वाराणस्यां विमोक्षदम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005462004, "chapter_id": 25462, "verse_number": "१-३२-५", "content_sanskrit": "अत्र साक्षान्महादेवः पञ्चायतनविग्रहः ।\nरमते भगवान् रुद्रो जन्तूनामपवर्गदः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005462005, "chapter_id": 25462, "verse_number": "१-३२-६", "content_sanskrit": "यत् तत् पाशुपतं ज्ञानं पञ्चार्थमिति शक्यते ।\nतदेतद् विमलं लिङ्गमोङ्कारं समवस्थितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005462006, "chapter_id": 25462, "verse_number": "१-३२-७", "content_sanskrit": "शान्त्यतीता तथा शान्तिर्विद्या चैव परा कला ।\nप्रतिष्ठा च निवृत्तिश्च पञ्चार्थं लिङ्गमैश्वरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005462007, "chapter_id": 25462, "verse_number": "१-३२-८", "content_sanskrit": "पञ्चानामपि देवानां ब्रह्मादीनां सदाश्रयम् ।\nओंकारबोधतं लिङ्गं पञ्चायतनमुच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005462008, "chapter_id": 25462, "verse_number": "१-३२-९", "content_sanskrit": "संस्मरेदैश्वरं लिङ्गं पञ्चायतनमव्ययम् ।\nदेहान्ते तत्परं ज्योतिरानन्दं विशते बुधः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005462009, "chapter_id": 25462, "verse_number": "१-३२-१०", "content_sanskrit": "अत्र देवर्षयः पूर्वं सिद्धा ब्रह्मर्षयस्तथा ।\nउपास्य देवमीशानं प्राप्तवन्तः परं पदम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005462010, "chapter_id": 25462, "verse_number": "१-३२-११", "content_sanskrit": "मत्स्योदर्यास्तटे पुण्यं स्थानं गुह्यतम शुभम् ।\nगोचर्ममात्रं विप्रेन्द्रा ओङ्कारेश्वरमुत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005462011, "chapter_id": 25462, "verse_number": "१-३२-१२", "content_sanskrit": "कृत्तिवासेश्वरं लिङ्गं मध्यमेश्वरमुत्तमम् ।\nविश्वेश्वरं तथोंकारं कपर्दीश्वरमेव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005462012, "chapter_id": 25462, "verse_number": "१-३२-१३", "content_sanskrit": "एतानि गुह्यलिङ्गानि वाराणस्यां द्विजोत्तमाः ।\nन कश्चिदिह जानाति विना शंभोरनुग्रहात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005462013, "chapter_id": 25462, "verse_number": "१-३२-१४", "content_sanskrit": "एवमुक्त्वा ययौ कृष्णः पाराशर्यो महामुनिः ।\nकृत्तिवासेश्वरं लिङ्गं द्रष्टुं देवस्य शूलिनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005462014, "chapter_id": 25462, "verse_number": "१-३२-१५", "content_sanskrit": "समभ्यर्च्य तथा शिष्यैर्माहात्म्यं कृत्तिवाससः ।\nकथयामास विप्रेभ्यो भगवान् ब्रह्मवित्तमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005462015, "chapter_id": 25462, "verse_number": "१-३२-१६", "content_sanskrit": "अस्मिन् स्थाने पुरा दैत्यो हस्ती भूत्वा भवान्तिकम् ।\nब्राह्मणान् हन्तुमायातो येऽत्र नित्यमुपासते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005462016, "chapter_id": 25462, "verse_number": "१-३२-१७", "content_sanskrit": "तेषां लिङ्गान्महादेवः प्रादुरासीत् त्रिलोचनः ।\nरक्षणार्थं द्विजश्रेष्ठा भक्तानां भक्तवत्सलः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005462017, "chapter_id": 25462, "verse_number": "१-३२-१८", "content_sanskrit": "हत्वा गजाकृतिं दैत्यं शूलेनावज्ञया हरः ।\nवसस्तस्याकरोत् कृत्तिं कृत्तिवासेश्वरस्ततः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005462018, "chapter_id": 25462, "verse_number": "१-३२-१९", "content_sanskrit": "अत्र सिद्धिं परां प्राप्ता मुनयो मुनिपुंगवाः ।\nतेनैव च शरीरेण प्राप्तास्तत् परमं पदम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005462019, "chapter_id": 25462, "verse_number": "१-३२-२०", "content_sanskrit": "विद्या विद्येश्वरा रुद्राः शिवाये च प्रकीर्त्तिताः ।\nकृत्तिवासेश्वरं लिङ्गं नित्यमावृत्य संस्थिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005462020, "chapter_id": 25462, "verse_number": "१-३२-२१", "content_sanskrit": "ज्ञात्वा कलियुगं घोरमधर्मबहुलं जनाः ।\nकृत्तिवासं न मुञ्चन्ति कृतार्थास्ते न संशयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005462021, "chapter_id": 25462, "verse_number": "१-३२-२२", "content_sanskrit": "जन्मान्तरसहस्रेण मोक्षोऽन्यत्राप्यते न वा ।\nएकेन जन्मना मोक्षः कृत्तिवासे तु लभ्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005462022, "chapter_id": 25462, "verse_number": "१-३२-२३", "content_sanskrit": "आलयः सर्वसिद्धानामेतत् स्थानं वदन्ति हि ।\nगोपितं देवदेवेन महादेवेन शंभुना ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005462023, "chapter_id": 25462, "verse_number": "१-३२-२४", "content_sanskrit": "युगे युगे ह्यत्र दान्ता ब्राह्मणा वेदपारागाः ।\nउपासते महादेवं जपन्ति शतरुद्रियम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005462024, "chapter_id": 25462, "verse_number": "१-३२-२५", "content_sanskrit": "स्तुवन्ति सततं देवं त्र्यम्बकं कृत्तिवाससम् ।\nध्यायन्ति हृदये देवं स्थाणुं सर्वान्तरं शिवम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005462025, "chapter_id": 25462, "verse_number": "१-३२-२६", "content_sanskrit": "गायन्ति सिद्धाः किल गीतकानि ।\nये वाराणस्यां निवसन्ति विप्राः ।\nतेषामथैकेन भवेन मुक्तिर ।\nये कृत्तिवासं शरणं प्रपन्नाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005462026, "chapter_id": 25462, "verse_number": "१-३२-२७", "content_sanskrit": "संप्राप्य लोके जगतामभीष्टं ।\nसुदुर्लभं विप्रकुलेषु जन्म ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005462027, "chapter_id": 25462, "verse_number": "१-३२-२८", "content_sanskrit": "ध्याने समाधाय जपन्ति रुद्रं ।\nध्यायन्ति चित्ते यतयो महेशम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005462028, "chapter_id": 25462, "verse_number": "१-३२-२९", "content_sanskrit": "आराधयन्ति प्रभुमीशितारं ।\nवाराणसीमध्यगता मुनिन्द्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005462029, "chapter_id": 25462, "verse_number": "१-३२-३०", "content_sanskrit": "यजन्ति यज्ञैरभिसंधिहीना ।\nस्तुवन्ति रुद्रं प्रणमन्ति शंभुम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005462030, "chapter_id": 25462, "verse_number": "१-३२-३१", "content_sanskrit": "नमो भवायामलयोगधाम्ने ।\nस्थाणुं प्रपद्ये गिरिशं पुराणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005462031, "chapter_id": 25462, "verse_number": "१-३२-३२", "content_sanskrit": "स्मरामि रुद्रं हृदये निविष्ट ।\nजाने महादेवमनेकरूपम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]