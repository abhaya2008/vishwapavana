[{"id": 2177627, "chapter_id": 4750, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177628, "chapter_id": 4750, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा कुरुश्रेष्ठं सर्वयादवनन्दनः ।\nसर्वायुधवरोपेतमारुरोह रथोत्तमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177629, "chapter_id": 4750, "verse_number": "२", "content_sanskrit": "युक्तं परमकाम्भोजैस्तुरगैर्हेममालिभिः ।\nउदितादित्यसङ्काशं सर्वरत्नविभूषितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177630, "chapter_id": 4750, "verse_number": "३", "content_sanskrit": "दक्षिणेऽस्यावहत् शैब्यः सुग्रीवः सव्यतो धुरम् ।\nपार्ष्णिवाहौ च तस्यास्तां मेघपुष्पबलाहकौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177631, "chapter_id": 4750, "verse_number": "४", "content_sanskrit": "विश्वकर्मकृता दिव्या नानारत्नविभूषिता ।\nउच्छ्रिता च रथे तस्मिन् ध्वजयष्टिरदृश्यत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177632, "chapter_id": 4750, "verse_number": "५", "content_sanskrit": "वैनतेयः स्थितस्तस्यां प्रभामण्डलरश्मिवान् ।\nतस्य सत्यवतः केतुर्भुजङ्गारिरदृश्यत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177633, "chapter_id": 4750, "verse_number": "६", "content_sanskrit": "अन्वारोहद् हृषीकेशः केतुः सर्वधनुष्मताम् ।\nअर्जुनः सत्यकर्मा च कुरुराजो युधिष्ठिरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177634, "chapter_id": 4750, "verse_number": "७", "content_sanskrit": "शुशुभाते तु तौ वीरौ दाशार्हमभितः स्थितौ ।\nरथस्थं शार्ङ्गधन्वानम् अश्विनाविव वासवम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177635, "chapter_id": 4750, "verse_number": "८", "content_sanskrit": "उभावारोप्य दाशार्हः स्यन्दनं लोकपूजितम् ।\nप्रतोदेन जवोपेतान् परमाश्वानचोदयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177636, "chapter_id": 4750, "verse_number": "९", "content_sanskrit": "ते हयाः सहसोत्पेतुर्गृहीत्वा स्यन्दनोत्तमम् ।\nआस्थितं पाण्डवेयाभ्यां यदूनामृषभेण च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177637, "chapter_id": 4750, "verse_number": "१०", "content_sanskrit": "वहतां शार्ङ्गधन्वानम् अश्वानां शीघ्रगामिनाम् ।\nप्रादुरासीन्महान् शब्दः पक्षिणां पततामिव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177638, "chapter_id": 4750, "verse_number": "११", "content_sanskrit": "ते समर्थं महाबाहुं क्षणेन भरतर्षभ ।\nभीमसेनं महात्मानमनुसृत्य सुवेगिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177639, "chapter_id": 4750, "verse_number": "१२", "content_sanskrit": "क्रोधदीप्तं तु कौन्तेयं द्विषदर्थे समुद्यतम् ।\nनाशक्नुवन् वारयितुं समेत्यापि महारथाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177640, "chapter_id": 4750, "verse_number": "१३", "content_sanskrit": "स तेषामग्रतः शूरः श्रीमतां दृढधन्विनाम् ।\nययौ भागीरथीकच्छं हरिभिर्हेममालिभिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177641, "chapter_id": 4750, "verse_number": "१४", "content_sanskrit": "यत्र स श्रूयते द्रौणिः पुत्रहन्ता दुरात्मवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177642, "chapter_id": 4750, "verse_number": "१५", "content_sanskrit": "स ददर्श महात्मानमुदकान्ते यशस्विनम् ।\nकृष्णद्वैपायनं व्यासमासीनमृषिभिः सह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177643, "chapter_id": 4750, "verse_number": "१६", "content_sanskrit": "तं चैव क्रूरकर्माणं घृताक्तं कुशचीरिणम् ।\nरजसा ध्वस्तमासीनं ददर्श द्रौणिमन्तिके\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177644, "chapter_id": 4750, "verse_number": "१७", "content_sanskrit": "तमभ्यधावत् कौन्तेयः प्रगृह्य सशरं धनुः ।\nभीमसेनो महाबाहुस्तिष्ठ तिष्ठेति चाब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177645, "chapter_id": 4750, "verse_number": "१८", "content_sanskrit": "तं दृष्ट्वा भीमकर्माणं प्रगृहीतशरासनम् ।\nभ्रातरौ पृष्ठतश्चास्य जनार्दनरथस्थितौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177646, "chapter_id": 4750, "verse_number": "१९", "content_sanskrit": "व्यथितात्माऽभवद् द्रौणिः प्राप्तं चेदममन्यत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177647, "chapter_id": 4750, "verse_number": "२०", "content_sanskrit": "स तद्दिव्यमदीनात्मा परमास्त्रमचिन्तयत् ।\nजग्राह च शरैषीकां द्रौणिः सव्येन पाणिना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177648, "chapter_id": 4750, "verse_number": "२१", "content_sanskrit": "स तामापदमासाद्य दिव्यमस्त्रमुदीरयन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177649, "chapter_id": 4750, "verse_number": "२२", "content_sanskrit": "अमृष्यमाणस्तान् शूरान् दिव्यायुधधरान् स्थितान् ।\nअपाण्डवायेति रुषा वाचमुत्सृज्य दारुणम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177650, "chapter_id": 4750, "verse_number": "२३", "content_sanskrit": "इत्युक्त्वा राजशार्दूल द्रोणपुत्रः प्रतापवान् ।\nसर्वलोकप्रमोहार्थं तदस्त्रं प्रमुमोच ह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177651, "chapter_id": 4750, "verse_number": "२४", "content_sanskrit": "ततस्तस्यामिषीकायां पावकः समजायत ।\nनाशयत्येव लोकांस्त्रीन् कालान्तकयमोपमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177652, "chapter_id": 4750, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि ऐषिकास्त्रमोचनं नाम चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]