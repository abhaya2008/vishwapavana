[{"id": 7004114000, "chapter_id": 24114, "verse_number": "४-६३-१", "content_sanskrit": "अगस्त्य उवाच ।\nदृष्ट्वा काशीं दृगानंदां तारकारे पुरारिणा ।\nकिमकारि समाचक्ष्व प्राप्तां बहुमनोरथैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004114001, "chapter_id": 24114, "verse_number": "४-६३-२", "content_sanskrit": "स्कंद उवाच ।\nपतिव्रतापते ऽगस्त्य शृणु वक्ष्याम्यशेषतः ।\nमृगांकलक्ष्मणोत्कंठं काशी नेत्रातिथीकृता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004114002, "chapter_id": 24114, "verse_number": "४-६३-३", "content_sanskrit": "अथ सर्वज्ञनाथेन भक्तवत्सलचेतसा ।\nजैगीषव्यो मुनिश्रेष्ठो गुहां तस्थो निरीक्षितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004114003, "chapter_id": 24114, "verse_number": "४-६३-४", "content_sanskrit": "यमनेहसमारभ्य मदंराद्रिं विनिर्ययौ ।\nअद्रींद्र सुतया सार्धं रुद्रेणोक्षेंद्रगामिना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004114004, "chapter_id": 24114, "verse_number": "४-६३-५", "content_sanskrit": "तं वासरं पुरस्कृत्य जग्राह नियमं दृढम् ।\nजैगीषव्यो महामेधाः कुंभयोने महाकृती ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004114005, "chapter_id": 24114, "verse_number": "४-६३-६", "content_sanskrit": "विषमेक्षण पादाब्जं समीक्षिष्ये यदा पुनः ।\nतदांबुविप्रुषमपि भक्षयिष्यामि चेत्यहो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004114006, "chapter_id": 24114, "verse_number": "४-६३-७", "content_sanskrit": "कुतश्चिद्धारणायोगादथवा शंभ्वनुग्रहात ।\nअनश्नन्नपिबन्योगी जैगीषव्यः स्थितो मुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004114007, "chapter_id": 24114, "verse_number": "४-६३-८", "content_sanskrit": "तं शंभुरेव जानाति नान्यो जानाति कश्चन ।\nअतएव ततः प्राप्तः प्रथमं प्रमथाधिपः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004114008, "chapter_id": 24114, "verse_number": "४-६३-९", "content_sanskrit": "ज्येष्ठशुक्लचतुर्दश्यां सोमवारानुराधयोः ।\nतत्पर्वणि महायात्रा कर्तव्या तत्र मानवैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004114009, "chapter_id": 24114, "verse_number": "४-६३-१०", "content_sanskrit": "ज्येष्ठस्थानं ततः काश्यां तदाभूदपि पुण्यदम् ।\nतत्र लिंगं समभवत्स्वयं ज्येष्ठेश्वराभिधम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004114010, "chapter_id": 24114, "verse_number": "४-६३-११", "content_sanskrit": "तल्लिंगदर्शनात्पुंसां पापं जन्मशतार्जितम् ।\nतमोर्कोदयमाप्येव तत्क्षणादेव नश्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004114011, "chapter_id": 24114, "verse_number": "४-६३-१२", "content_sanskrit": "ज्येष्ठवाप्यां नरः स्नात्वा तर्पयित्वा पितामहान् ।\nज्येष्ठेश्वरं समालोक्य न भूयो जायते भुवि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004114012, "chapter_id": 24114, "verse_number": "४-६३-१३", "content_sanskrit": "आविरासीत्स्वयं तत्र ज्येष्ठेश्वर समीपतः ।\nसर्वसिद्धिप्रदा गौरी ज्येष्ठाश्रेष्ठा समंततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004114013, "chapter_id": 24114, "verse_number": "४-६३-१४", "content_sanskrit": "ज्येष्ठे मासि सिताष्टम्यां तत्र कार्यो महोत्सवः ।\nरात्रौ जागरणं कार्यं सर्वसंपत्समृद्धये ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004114014, "chapter_id": 24114, "verse_number": "४-६३-१५", "content_sanskrit": "ज्येष्ठां गौरीं नमस्कृत्य ज्येष्ठवापी परिप्लुता ।\nसौभाग्यभाजनं भूयाद्योषा सौभाग्यभागपि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004114015, "chapter_id": 24114, "verse_number": "४-६३-१६", "content_sanskrit": "निवासं कृतवाञ्शंभुस्तस्मिन्स्थाने यतः स्वयम् ।\nनिवासेश इति ख्यातं लिंगं तत्र परं ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004114016, "chapter_id": 24114, "verse_number": "४-६३-१७", "content_sanskrit": "निवासेश्वरलिंगस्य सेवनात्सर्वसंपदः ।\nनिवसंति गृहे नित्यं नित्यं प्रतिपदं पुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004114017, "chapter_id": 24114, "verse_number": "४-६३-१८", "content_sanskrit": "कृत्वा श्राद्धं विधानेन ज्येष्ठस्थाने नरोत्तमः ।\nज्येष्ठां तृप्तिं ददात्येव पितृभ्यो मधुसर्पिषा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004114018, "chapter_id": 24114, "verse_number": "४-६३-१९", "content_sanskrit": "ज्येष्ठतीर्थे नरः काश्यां दत्त्वा दानानि शक्तितः ।\nज्येष्ठान्स्वर्गानवाप्नोति नरो मोक्षं च गच्छति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004114019, "chapter_id": 24114, "verse_number": "४-६३-२०", "content_sanskrit": "ज्येष्ठेश्वरो र्च्यः प्रथमं काश्यां श्रेयोर्थिभिर्नरैः ।\nज्येष्ठागौरी ततोभ्यर्च्या सर्वज्येष्ठमभीप्सुभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004114020, "chapter_id": 24114, "verse_number": "४-६३-२१", "content_sanskrit": "अथ नंदिनमाहूय धूर्जटिः स कृपानिधिः ।\nशृण्वतां सर्वदेवानामिदं वचनमब्रवीत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004114021, "chapter_id": 24114, "verse_number": "४-६३-२२", "content_sanskrit": "ईश्वर उवाच ।\nशैलादे प्रविशाशु त्वं गुहास्त्यत्र मनोहरा ।\nतदंतरेस्ति मे भक्तो जैगीषव्यस्तपोधनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004114022, "chapter_id": 24114, "verse_number": "४-६३-२३", "content_sanskrit": "महानियमवान्नंदिस्त्वगस्थिस्नायु शेषितः ।\nतमिहानय मद्भक्तं मद्दर्शन दृढव्रतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004114023, "chapter_id": 24114, "verse_number": "४-६३-२४", "content_sanskrit": "यदाप्रभृत्यगां काश्या मंदरं सर्वसुंदरम् ।\nमहानियमवानेष तदारभ्योज्झिताशनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004114024, "chapter_id": 24114, "verse_number": "४-६३-२५", "content_sanskrit": "गृहाण लीलाकमलमिदं पीयूषपोषणम् ।\nअनेन तस्य गात्राणि स्पृश सद्यः सुबृंहिणा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004114025, "chapter_id": 24114, "verse_number": "४-६३-२६", "content_sanskrit": "ततो नंदी समादाय तल्लीलाकमलं विभोः ।\nप्रणम्य देवदेवेशमाविशद्गह्वरां गुहाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004114026, "chapter_id": 24114, "verse_number": "४-६३-२७", "content_sanskrit": "नंदी दृष्ट्वाथ तं तत्र धारणादृढमानसम् ।\nतपोग्नि परिशुष्कांगं कमलेन समस्पृशत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004114027, "chapter_id": 24114, "verse_number": "४-६३-२८", "content_sanskrit": "तपांते वृष्टिसंयोगाच्छालूर इव कोटरे ।\nउल्ललास स योगींद्रः स्पर्शमात्रात्तदब्जजात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004114028, "chapter_id": 24114, "verse_number": "४-६३-२९", "content_sanskrit": "अथ नंदी समादाय सत्वरं मुनिपुंगवम् ।\nदेवदेवस्य पादाग्रे नमस्कृत्य न्यपातयत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004114029, "chapter_id": 24114, "verse_number": "४-६३-३०", "content_sanskrit": "जैगीषव्योथ संभ्रांतः पुरतो वीक्ष्य शंकरम् ।\nवामांगसन्निविष्टाद्रितनयं प्रणनाम ह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004114030, "chapter_id": 24114, "verse_number": "४-६३-३१", "content_sanskrit": "प्रणम्य दंडवद्भूमौ परिलुठ्य समंततः ।\nतुष्टाव परया भक्त्या स मुनिश्चंद्रशेखरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004114031, "chapter_id": 24114, "verse_number": "४-६३-३२", "content_sanskrit": "जैगीषव्य उवाच ।\nनमः शिवाय शांताय सर्वज्ञाय शुभात्मने ।\nजगदानंदकंदाय परमानंदहेतवे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004114032, "chapter_id": 24114, "verse_number": "४-६३-३३", "content_sanskrit": "अरूपाय सरूपाय नानारूपधराय च ।\nविरूपाक्षाय विधये विधिविष्णुस्तुताय च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004114033, "chapter_id": 24114, "verse_number": "४-६३-३४", "content_sanskrit": "स्थावराय नमस्तुभ्यं जंगमाय नमोस्तुते ।\nसर्वात्मने नमस्तुभ्यं नमस्ते परमात्मने ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004114034, "chapter_id": 24114, "verse_number": "४-६३-३५", "content_sanskrit": "नमस्त्रैलोक्यकाम्याय कामांगदहनाय च ।\nनमो शेषविशेषाय नमः शेषांगदाय ते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004114035, "chapter_id": 24114, "verse_number": "४-६३-३६", "content_sanskrit": "श्रीकंठाय नमस्तुभ्यं विषकंठाय ते नमः ।\nवैकुंठवंद्यपादाय नमोऽकुंठितशक्तये ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004114036, "chapter_id": 24114, "verse_number": "४-६३-३७", "content_sanskrit": "नमः शक्त्यर्धदेहाय विदेहाय सुदेहिने ।\nसकृत्प्रणाममात्रेण देहिदेहनिवारिणे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004114037, "chapter_id": 24114, "verse_number": "४-६३-३८", "content_sanskrit": "कालाय कालकालाय कालकूट विषादिने ।\nव्यालयज्ञोपवीताय व्यालभूषणधारिणे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004114038, "chapter_id": 24114, "verse_number": "४-६३-३९", "content_sanskrit": "नमस्ते खंडपरशो नमः खंडें दुधारिणे ।\nखंडिताशेष दुःखाय खड्गखेटकधारिणे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004114039, "chapter_id": 24114, "verse_number": "४-६३-४०", "content_sanskrit": "गीर्वाणगीतनाथाय गंगाकल्लोलमालिने ।\nगौरीशाय गिरीशाय गिरिशाय गुहारणे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004114040, "chapter_id": 24114, "verse_number": "४-६३-४१", "content_sanskrit": "चंद्रार्धशुद्धभूषाय चंद्रसूर्याग्निचक्षुषे ।\nनमस्ते चर्मवसन नमो दिग्वसनायते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004114041, "chapter_id": 24114, "verse_number": "४-६३-४२", "content_sanskrit": "जगदीशाय जीर्णाय जराजन्महराय ते ।\nजीवायते नमस्तुभ्यं जंजपूकादिहारिणे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004114042, "chapter_id": 24114, "verse_number": "४-६३-४३", "content_sanskrit": "नमो डमरुहस्ताय धनुर्हस्ताय ते नमः ।\nत्रिनेत्राय नमस्तुभ्यं जगन्नेत्राय ते नमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004114043, "chapter_id": 24114, "verse_number": "४-६३-४४", "content_sanskrit": "त्रिशूलव्यग्रहस्ताय नमस्त्रिपथगाधर ।\nत्रिविष्टपाधिनाथाय त्रिवेदीपठिताय च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004114044, "chapter_id": 24114, "verse_number": "४-६३-४५", "content_sanskrit": "त्रयीमयाय तुष्टाय भक्ततुष्टिप्रदाय च ।\nदीक्षिताय नमस्तुभ्यं देवदेवाय ते नमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004114045, "chapter_id": 24114, "verse_number": "४-६३-४६", "content_sanskrit": "दारिताशेषपापाय नमस्ते दीर्घदर्शिने ।\nदूराय दुरवाप्याय दोषनिर्दलनाय च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004114046, "chapter_id": 24114, "verse_number": "४-६३-४७", "content_sanskrit": "दोषाकर कलाधार त्यक्तदोषागमाय च ।\nनमो धूर्जटये तुभ्यं धत्तूरकुसुमप्रिय ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004114047, "chapter_id": 24114, "verse_number": "४-६३-४८", "content_sanskrit": "नमो धीराय धर्माय धर्मपालाय ते नमः ।\nनीलग्रीव नमस्तुभ्यं नमस्ते नीललोहित ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004114048, "chapter_id": 24114, "verse_number": "४-६३-४९", "content_sanskrit": "नाममात्रस्मृतिकृतां त्रैलोक्यैश्वर्यपूरक ।\nनमः प्रमथनाथाय पिनाकोद्यतपाणये ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004114049, "chapter_id": 24114, "verse_number": "४-६३-५०", "content_sanskrit": "पशुपाशविमोक्षाय पशूनां पतये नमः ।\nनामोच्चारणमात्रेण महापातकहारिणे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004114050, "chapter_id": 24114, "verse_number": "४-६३-५१", "content_sanskrit": "परात्पराय पाराय परापरपराय च ।\nनमोऽपारचरित्राय सुपवित्रकथाय च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004114051, "chapter_id": 24114, "verse_number": "४-६३-५२", "content_sanskrit": "वामदेवाय वामार्धधारिणे वृषगामिने ।\nनमो भर्गाय भीमाय नतभीतिहराय च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004114052, "chapter_id": 24114, "verse_number": "४-६३-५३", "content_sanskrit": "भवाय भवनाशाय भूतानांपतये नमः ।\nमहादेव नमस्तुभ्यं महेश महसांपते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004114053, "chapter_id": 24114, "verse_number": "४-६३-५४", "content_sanskrit": "नमो मृडानीपतये नमो मृत्युंजयाय ते ।\nयज्ञारये नमस्तुभ्यं यक्षराजप्रियाय च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004114054, "chapter_id": 24114, "verse_number": "४-६३-५५", "content_sanskrit": "यायजूकाय यज्ञाय यज्ञानां फलदायिने ।\nरुद्राय रुद्रपतये कद्रुद्राय रमाय च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004114055, "chapter_id": 24114, "verse_number": "४-६३-५६", "content_sanskrit": "शूलिने शाश्वतेशाय श्मशानावनिचारिणे ।\nशिवाप्रियाय शर्वाय सर्वज्ञाय नमोस्तु ते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004114056, "chapter_id": 24114, "verse_number": "४-६३-५७", "content_sanskrit": "हराय क्षांतिरूपाय क्षेत्रज्ञाय क्षमाकर ।\nक्षमाय क्षितिहर्त्रे च क्षीरगौराय ते नमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004114057, "chapter_id": 24114, "verse_number": "४-६३-५८", "content_sanskrit": "अंधकारे नमस्तुभ्यमाद्यंतरहिताय च ।\nइडाधाराय ईशाय उपेद्रेंद्रस्तुताय च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004114058, "chapter_id": 24114, "verse_number": "४-६३-५९", "content_sanskrit": "उमाकांताय उग्राय नमस्ते ऊर्ध्वरेतसे ।\nएकरूपाय चैकाय महदैश्वर्यरूपिणे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004114059, "chapter_id": 24114, "verse_number": "४-६३-६०", "content_sanskrit": "अनंतकारिणे तुभ्यमंबिकापतये नमः ।\nत्वमोंकारो वषट्कारो भूर्भुवःस्वस्त्वमेव हि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004114060, "chapter_id": 24114, "verse_number": "४-६३-६१", "content_sanskrit": "दृश्यादृश्य यदत्रास्ति तत्सर्वं त्वमु माधव ।\nस्तुतिं कर्तुं न जानामि स्तुतिकर्ता त्वमेव हि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004114061, "chapter_id": 24114, "verse_number": "४-६३-६२", "content_sanskrit": "वाच्यस्त्वं वाचकस्त्वं हि वाक्च त्वं प्रणतोस्मि ते ।\nनान्यं वेद्मि महादेव नान्यं स्तौमि महेश्वर ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004114062, "chapter_id": 24114, "verse_number": "४-६३-६३", "content_sanskrit": "नान्यं नमामि गौरीश नान्याख्यामाददे शिव ।\nमूकोन्यनामग्रहणे बधिरोन्यकथाश्रुतौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004114063, "chapter_id": 24114, "verse_number": "४-६३-६४", "content_sanskrit": "पंगुरन्याभिगमनेऽस्म्यंधोऽन्यपरिवीक्षणे ।\nएक एव भवानीश एककर्ता त्वमेव हि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004114064, "chapter_id": 24114, "verse_number": "४-६३-६५", "content_sanskrit": "पाता हर्ता त्वमेवैको नानात्वं मूढकल्पना ।\nअतस्त्वमेव शरणं भूयोभूयः पुनःपुनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004114065, "chapter_id": 24114, "verse_number": "४-६३-६६", "content_sanskrit": "संसारसागरे मग्नं मामुद्धर महेश्वर ।\nइति स्तुत्वा महेशानं जैगीषव्यो महामुनिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004114066, "chapter_id": 24114, "verse_number": "४-६३-६७", "content_sanskrit": "वाचंयमो भवत्स्थाणोः पुरतः स्थाणुसन्निभः ।\nइति स्तुतिं समाकर्ण्य मुनेश्चंद्रविभूषणः ।\nउवाच च प्रसन्नात्मा वरं ब्रूहीति तं मुनिम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004114067, "chapter_id": 24114, "verse_number": "४-६३-६८", "content_sanskrit": "जैगीषव्य उवाच ।\nयदि प्रसन्नो देवेश ततस्तव पदांबुजात् ।\nमा भवानि भवानीश दूरं दूरपदप्रद ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004114068, "chapter_id": 24114, "verse_number": "४-६३-६९", "content_sanskrit": "अपरश्च वरो नाथ देयोयमविचारतः ।\nयन्मया स्थापितं लिंगं तत्र सान्निध्यमस्तु ते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004114069, "chapter_id": 24114, "verse_number": "४-६३-७०", "content_sanskrit": "ईश्वर उवाच ।\nजैगीषव्य महाभाग यदुक्तं भवतानघ ।\nतदस्तु सर्वं तेभीष्टं वरमन्यं ददामि च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004114070, "chapter_id": 24114, "verse_number": "४-६३-७१", "content_sanskrit": "योगशास्त्रं मया दत्तं तव निर्वाणसाधकम् ।\nसर्वेषां योगिनां मध्ये योगाचार्योऽस्तु वै भवान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004114071, "chapter_id": 24114, "verse_number": "४-६३-७२", "content_sanskrit": "रहस्यं योगविद्याया यथावत्त्वं तपोधन ।\nसंवेत्स्यसे प्रसादान्मे येन निर्वाणमाप्स्यसि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004114072, "chapter_id": 24114, "verse_number": "४-६३-७३", "content_sanskrit": "यथा नदी यथा भृंगी सोमनंदी यथा तथा ।\nत्वं भविष्यसि भक्तो मे जरामरणवर्जितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004114073, "chapter_id": 24114, "verse_number": "४-६३-७४", "content_sanskrit": "संति व्रतानि भूयांसि नियमाः संत्यनेकधा ।\nतपांसि नाना संत्यत्र संति दानान्यनेकशः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004114074, "chapter_id": 24114, "verse_number": "४-६३-७५", "content_sanskrit": "श्रेयसां साधनान्यत्र पापघ्नान्यपि सर्वथा ।\nपरं हि परमश्चैष नियमो यस्त्वया कृतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004114075, "chapter_id": 24114, "verse_number": "४-६३-७६", "content_sanskrit": "परो हि नियमश्चैष मां विलोक्य यदश्यते ।\nमामनालोक्य यद्भुक्तं तद्भुक्तं केवलत्वघम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004114076, "chapter_id": 24114, "verse_number": "४-६३-७७", "content_sanskrit": "असमर्च्य च यो भुङ्क्ते पत्रपुष्पफलैरपि ।\nरेतोभक्षी भवेन्मूढः स जन्मान्येकविंशतिम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004114077, "chapter_id": 24114, "verse_number": "४-६३-७८", "content_sanskrit": "महतो नियमस्यास्य भवतानुष्ठितस्य वै ।\nनार्हंति षोडशी मात्रामप्यन्ये नियमा यमाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004114078, "chapter_id": 24114, "verse_number": "४-६३-७९", "content_sanskrit": "अतो मच्चरणाभ्याशे त्वं निवत्स्यसि सर्वथा ।\nअतो नैःश्रेयसीं लक्ष्मीं तत्रैव प्राप्स्यसि ध्रुवम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004114079, "chapter_id": 24114, "verse_number": "४-६३-८०", "content_sanskrit": "जैगीषव्येश्वरं नाम लिंगं काश्यां सुदुर्लभम् ।\nत्रीणि वर्षाणि संसेव्य लभेद्योगं न संशयः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004114080, "chapter_id": 24114, "verse_number": "४-६३-८१", "content_sanskrit": "जैगीषव्यगुहां प्राप्य योगाभ्यसनतत्परः ।\nषण्मासेन लभेत्सिद्धिं वाञ्छितां मदनुग्रहात् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004114081, "chapter_id": 24114, "verse_number": "४-६३-८२", "content_sanskrit": "तव लिंगमिदं भक्तैः पूजनीयं प्रयत्नतः ।\nविलोक्या च गुहा रम्या परासिद्धिमभीप्सुभिः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004114082, "chapter_id": 24114, "verse_number": "४-६३-८३", "content_sanskrit": "अत्र ज्येष्ठेश्वरक्षेत्रे त्वल्लिंगं सर्वसिद्धिदम् ।\nनाशयेदघसंघानि दृष्टं स्पृष्टं समर्चितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004114083, "chapter_id": 24114, "verse_number": "४-६३-८४", "content_sanskrit": "अस्मिञ्ज्येष्ठेश्वरक्षेत्रे संभोज्य शिवयोगिनः ।\nकोटिभोज्यफलं सम्यगेकैकपरिसंख्यया ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004114084, "chapter_id": 24114, "verse_number": "४-६३-८५", "content_sanskrit": "जैगीषव्येश्वरं लिंगं गोपनीयं प्रयत्नतः ।\nकलौ कलुषबुद्धीनां पुरतश्च विशेषतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004114085, "chapter_id": 24114, "verse_number": "४-६३-८६", "content_sanskrit": "करिष्याम्यत्र सांनिध्यमस्मिंल्लिंगे तपोधन ।\nयोगसिद्धिप्रदानाय साधकेभ्यः सदैव हि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004114086, "chapter_id": 24114, "verse_number": "४-६३-८७", "content_sanskrit": "ददे शृणु महाभाग जैगीषव्यापरं वरम् ।\nत्वयेदं यत्कृतं स्तोत्रं योगसिद्धिकरं परम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004114087, "chapter_id": 24114, "verse_number": "४-६३-८८", "content_sanskrit": "महापापौघशमनं महापुण्यप्रवर्धनम् ।\nमहाभीतिप्रशमनं महाभक्तिविवर्धनम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004114088, "chapter_id": 24114, "verse_number": "४-६३-८९", "content_sanskrit": "एतत्स्तोत्रजपात्पुंसामसाध्यं नैव किंचन ।\nतस्मात्सर्वप्रयत्नेन जपनीयं सुसाधकैः ४ ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004114089, "chapter_id": 24114, "verse_number": "४-६३-९०", "content_sanskrit": "इति दत्त्वा वरं तस्मै स्मरारिः स्मेरलोचनः ।\nददर्श ब्राह्मणां स्तत्र समेतान्क्षेत्रवासिनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004114090, "chapter_id": 24114, "verse_number": "४-६३-९१", "content_sanskrit": "स्कंद उवाच ।\nनिशम्याख्यानमतुलमेतत्प्राज्ञः प्रयत्नतः ।\nनिष्पापो जायते मर्त्यो नोपसर्गैः प्रबाध्यते ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004114091, "chapter_id": 24114, "verse_number": "४-६३-९२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्धे ज्येष्ठेशाख्यानं नाम त्रिषष्टितमोऽध्यायः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]