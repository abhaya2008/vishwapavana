[{"id": 2123540, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123541, "chapter_id": 3651, "verse_number": "१", "content_sanskrit": "अनुज्ञातांस्तान् विदित्वा सरत्नधनसञ्चयान् ।\nपाण्डवान् धार्तराष्ट्राणां कथमासीन्मनस्तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123542, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123543, "chapter_id": 3651, "verse_number": "२", "content_sanskrit": "अनुज्ञातांस्तान् विदित्वा धृतराष्ट्रेण धीमता ।\nराजन् दुश्शासनः क्षिप्रं जगाम भ्रातरं प्रति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123544, "chapter_id": 3651, "verse_number": "३", "content_sanskrit": "दुर्योधनं समासीनं सामात्यं भरतर्षभ ।\nदुःखार्तो भरतश्रेष्ठ इदं वचनमब्रवीत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123545, "chapter_id": 3651, "verse_number": "४", "content_sanskrit": "दुःखेनैतान् समानीतान् स्थविरो नाशयत्यसौ ।\nशत्रुसाद् गमयन् द्रव्यं तद् बुध्यध्वं महाबलाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123546, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123547, "chapter_id": 3651, "verse_number": "५", "content_sanskrit": "अथ दुर्योधनः कर्णः शकुनिश्चापि सौबलः ।\nमिथः सङ्गम्य सहिताः पाण्डवान् प्रति मन्त्रिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123548, "chapter_id": 3651, "verse_number": "६", "content_sanskrit": "वैचित्रवीर्यं राजानं धृतराष्ट्रं मनीषिणम् ।\nअभिगम्य त्वरायुक्ताः श्लक्ष्णं वचनमब्रुवन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123549, "chapter_id": 3651, "verse_number": "७", "content_sanskrit": "न त्वयेदं श्रुतं राजन् यज्जगाद बृहस्पतिः ।\nशक्रस्य नीतिं प्रवदन् धीमान् देवपुरोहितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123550, "chapter_id": 3651, "verse_number": "८", "content_sanskrit": "सर्वोपायैर्निहन्तव्याः शत्रवः शत्रुकर्शन ।\nपुरा युद्धाद् बलाद्वाऽपि न कुर्वन्ति यथा हितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123551, "chapter_id": 3651, "verse_number": "९", "content_sanskrit": "ते वयं पाण्डवधनैः सर्वान् सम्पूज्य पार्थिवान् ।\nयदि तान् योधयिष्यामः किं वा नः परिहास्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123552, "chapter_id": 3651, "verse_number": "१०", "content_sanskrit": "अहीनाशीविषान् क्रुद्धान् दंशाय समुपस्थितान् ।\nकृत्वा कण्ठे च पृष्ठे च कः समुत्स्रष्टुमर्हति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123553, "chapter_id": 3651, "verse_number": "११", "content_sanskrit": "आत्तशस्त्रा रथगताः कुपितास्तात पाण्डवाः ।\nनिश्शेषान् नः करिष्यन्ति क्रुद्धा ह्याशीविषा यथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123554, "chapter_id": 3651, "verse_number": "१२", "content_sanskrit": "सन्नद्धो ह्यर्जुनो याति विवर्त्य परमेषुधी ।\nगाण्डीवं गृह्य सङ्क्रुद्धः पार्थः शस्त्रभृतां वरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123555, "chapter_id": 3651, "verse_number": "१३", "content_sanskrit": "गदां गुर्वीं समुद्यम्य त्वरितं च वृकोदरः ।\nस्वं रथं योजयित्वाऽशु निर्य्यात इति नः श्रुतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123556, "chapter_id": 3651, "verse_number": "१४", "content_sanskrit": "नकुलः खड्गमादाय चर्म्म चाप्यष्टचन्द्रकम् ।\nसहदेवश्च राजा च चक्रुराकारमिङ्गितैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123557, "chapter_id": 3651, "verse_number": "१५", "content_sanskrit": "ते चास्थाय रथान् सर्वे बहुशस्त्रपरिच्छदान् ।\nअभिध्नन्तो रथान् राजन् सेनायोगाय निर्ययुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123558, "chapter_id": 3651, "verse_number": "१६", "content_sanskrit": "न क्षमन्ते यथाऽस्माभिर्ज्जातु विप्रकृता हि ते ।\nद्रोपद्यास्तु परिक्लेशं कस्तेषां क्षन्तुमर्हति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123559, "chapter_id": 3651, "verse_number": "१७", "content_sanskrit": "पुनर्दीर्व्याम भद्रं ते वनवासाय पाण्डवैः ।\nन पश्यामि रणे क्रुद्धं बीभत्सुं प्रति वारणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123560, "chapter_id": 3651, "verse_number": "१८", "content_sanskrit": "भीष्मो द्रोणश्च कर्णश्च द्रौणिश्च रथिनां वरः ।\nकृपश्च वृषसेनश्च विकर्णश्च जयद्रथः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123561, "chapter_id": 3651, "verse_number": "१९", "content_sanskrit": "बाह्लीकः सोमदत्तश्च भूरिर्भूरिश्रवाः शलः ।\nशकुनिः ससुतश्चैव नृपाश्चान्ये च कौरवाः ।\nएते सर्वे रणे यत्ताः पार्थं सोढुं न शक्नुवन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123562, "chapter_id": 3651, "verse_number": "२०", "content_sanskrit": "अर्जुनेन समो वीर्ये नास्ति लोके धनुर्धरः ।\nयोऽर्जुनेनार्जुनस्तुल्यो द्विबाहुर्बहुबाहुना ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123563, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123564, "chapter_id": 3651, "verse_number": "२१", "content_sanskrit": "कस्त्वयोक्तः पुमान् वीरो बीभत्सुसमविक्रमः ।\nतं मे ब्रूहि महावीर्यं श्रोतुमिच्छामि पुत्रक ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123565, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123566, "chapter_id": 3651, "verse_number": "२२", "content_sanskrit": "कार्तवीर्यार्जुनो नाम राजा बाहुसहस्रवान् ।\nहेहयाधिपतिर्वीरः पाञ्चदश्यः पितामहात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123567, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123568, "chapter_id": 3651, "verse_number": "२३", "content_sanskrit": "गान्धारीपुत्र सर्वांस्तान् कार्तवीर्यपितामहान् ।\nआनुपूर्व्याच्च मे शंस ततस्तं पार्थिवं तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123569, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123570, "chapter_id": 3651, "verse_number": "२४", "content_sanskrit": "कार्तवीर्यस्य चरितं शृणु राजन् महात्मनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123571, "chapter_id": 3651, "verse_number": "२५", "content_sanskrit": "अव्यक्तप्रभवो ब्रह्मा सर्वलोकपितामहः ।\nब्रह्मणोऽत्रिः सुतो विद्वानत्रेः पुत्रो निशाकरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123572, "chapter_id": 3651, "verse_number": "२६", "content_sanskrit": "सोमस्य तु बुधः पुत्रो बुधस्य तु पुरूरवाः ।\nतस्याप्यथ सुतोऽप्यायुरायोस्तु नहुषः सुतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123573, "chapter_id": 3651, "verse_number": "२७", "content_sanskrit": "नहुषस्य ययातिस्तु ययातेस्तनुजो यदुः ।\nयदोः पुत्रो महाराज सहस्रौजेति विश्रुतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123574, "chapter_id": 3651, "verse_number": "२८", "content_sanskrit": "सहस्रौजसुतो राजन् चक्रदासेति विश्रुतः ।\nचक्रदासस्य दायादो हेहयो नाम पार्थिवः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123575, "chapter_id": 3651, "verse_number": "२९", "content_sanskrit": "हेहयस्याभवत् पुत्रो धर्मनेत्र इति श्रुतः ।\nधर्मनेत्रस्य कार्तस्तु कृतवीर्यस्तु कार्तजः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123576, "chapter_id": 3651, "verse_number": "३०", "content_sanskrit": "कृतवीर्यस्य तनयो ह्यर्जुनो बलिनां वरः ।\nस चार्जुनो महाराज तपो घोरं चकार ह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123577, "chapter_id": 3651, "verse_number": "३१", "content_sanskrit": "साग्रं वर्षायुतं तप्त्वा तपः परमदुश्चरम् ।\nदत्तमाराधयामास सोऽर्जुनोऽत्रिसुतं मुनिम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123578, "chapter_id": 3651, "verse_number": "३२", "content_sanskrit": "तस्य दत्तो वरान् प्रादाच्चतुरः पार्थिवस्य वै ।\nपूर्वं बाहुसहस्रं तु प्रार्थितः परमो वरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123579, "chapter_id": 3651, "verse_number": "३३", "content_sanskrit": "अधर्मे प्रीयमाणस्य सद्भिस्तत्र निवारणम् ।\nधर्मेण पृथिवीं जित्वा धर्मेणैवानुरञ्जनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123580, "chapter_id": 3651, "verse_number": "३४", "content_sanskrit": "सङ्ग्रामान् सुबहून् जित्वा हत्वा चारीन् सहस्रशः ।\nसङ्ग्रामे यतमानस्य वधश्चैवाधिकाद् रणे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123581, "chapter_id": 3651, "verse_number": "३५", "content_sanskrit": "तस्य बाहुसहस्रं तु युध्यतः किल भारत ।\nरथो ध्वजश्च संजज्ञ इत्येवं मे श्रुतं पुरा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123582, "chapter_id": 3651, "verse_number": "३६", "content_sanskrit": "तथेयं पृथिवी राजन् सप्तद्वीपा सपत्तना ।\nससमुद्राकरा तात बलिनोग्रेण वै जिता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2123583, "chapter_id": 3651, "verse_number": "३७", "content_sanskrit": "स चार्जुनोऽथ तेजस्वी सप्तद्वीपेश्वरोऽभवत् ।\nस च राजा महायज्ञानाजहार महाबलः ।\nमहीं च सकलां जित्वा असकृत् स समा बहूः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2123584, "chapter_id": 3651, "verse_number": "३८", "content_sanskrit": "ततोऽर्जुनः कदाचिद्वै राजन् माहिष्मतीपतिः ।\nनर्मदां भरतश्रेष्ठ स्नातुं दारैर्ययौ सह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2123585, "chapter_id": 3651, "verse_number": "३९", "content_sanskrit": "ततस्तु स नदीं गत्वा प्रविश्यान्तर्जलं मुदा ।\nकर्तुं राजन् जलक्रीडां ततो राजोपचक्रमे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2123586, "chapter_id": 3651, "verse_number": "४०", "content_sanskrit": "तस्मिन्नेव तु काले तु रावणो राक्षसैः सह ।\nलङ्काया ईश्वरस्तात तं देशं प्रययौ बली ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2123587, "chapter_id": 3651, "verse_number": "४१", "content_sanskrit": "ततस्तमर्जुनं दृष्ट्वा नर्मदायां दशाननः ।\nनित्यं क्रोधपरो धीरो वरदानेन मोहितः ।\nअभ्यधावत् सुसङ्क्रुद्धो महेन्द्रं शम्बरो यथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2123588, "chapter_id": 3651, "verse_number": "४२", "content_sanskrit": "अर्जुनोऽप्यथ तं दृष्ट्वा रावणं प्रत्यवारयत् ।\nततस्तौ चक्रतुर्युद्धं रावणश्चार्जुनश्च वै ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2123589, "chapter_id": 3651, "verse_number": "४३", "content_sanskrit": "ततस्तु दुर्जयं वीरं वरदानेन दर्पितम् ।\nराक्षसेन्द्रं मनुष्येन्द्रो युध्द्वा जित्वा रणे बलात् ।\nबद्ध्वा धनुर्ज्यया राजन् विवेशाथ पुरीं स्वकाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2123590, "chapter_id": 3651, "verse_number": "४४", "content_sanskrit": "स तु तं बन्धितं श्रुत्वा पुलस्त्यो रावणं तदा ।\nमोक्षयामास दृष्ट्वाऽथ पुरेऽदृष्ट्वाऽर्जुनं तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2123591, "chapter_id": 3651, "verse_number": "४५", "content_sanskrit": "ततः कदाचित् तेजस्वी कार्तवीर्यार्जुनो बली ।\nसमुद्रतीरं गत्वाऽथ विचरन् दर्पमोहितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2123592, "chapter_id": 3651, "verse_number": "४६", "content_sanskrit": "अवाकिरत् शितशरैः समुद्रं स तु भारत ।\nतं समुद्रो नमस्कृत्य कृताञ्जलिरभाषत ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2123593, "chapter_id": 3651, "verse_number": "४७", "content_sanskrit": "आशुगान् वीर मा मुञ्च ब्रूहि किं करवाणि ते ।\nमदाश्रयाणि भूतानि त्वन्निसृष्टैर्महेषुभिः ।\nवध्यन्ते राजशार्दूल तेभ्यो देह्यभयं विभो ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2123594, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2123595, "chapter_id": 3651, "verse_number": "४८", "content_sanskrit": "देहि सिन्धुपते युद्धमद्यैव त्वरया मम ।\nअथवा पीडयामि त्वां तस्मात् त्वं कुरु मा चिरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2123596, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "समुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2123597, "chapter_id": 3651, "verse_number": "४९", "content_sanskrit": "लोके राजन् महावीर्या बहवो निवसन्ति ये ।\nतेषामेकेन राजेन्द्र कुरु युद्धं महाबल ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2123598, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2123599, "chapter_id": 3651, "verse_number": "५०", "content_sanskrit": "मत्समो यदि सङ्ग्रामे वरायुधधरः क्वचित् ।\nविद्यते तं ममाचक्ष्व यः सहेत महामृधे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2123600, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "समुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2123601, "chapter_id": 3651, "verse_number": "५१", "content_sanskrit": "महर्षिर्जमदग्निस्तु यदि राजन् परिश्रुतः ।\nतस्य पुत्रो रणं दातुं यथावद्वै तवार्हति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2123602, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2123603, "chapter_id": 3651, "verse_number": "५२", "content_sanskrit": "समुद्रस्य वचः श्रुत्वा राजा माहिष्मतीपतिः ।\nनारदस्य वचः पूर्वं क्रोधेन महता वृतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2123604, "chapter_id": 3651, "verse_number": "५३", "content_sanskrit": "ततः प्रतिययौ शीघ्रं क्रोधेन सह भारत ।\nस तमाश्रममागत्य राममेवान्वपद्यत ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2123605, "chapter_id": 3651, "verse_number": "५४", "content_sanskrit": "स रामप्रतिकूलानि चकार सह बन्धुभिः ।\nआयासं जनयामास रामस्य स महात्मनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2123606, "chapter_id": 3651, "verse_number": "५५", "content_sanskrit": "ततस्तेजः प्रजज्वाल रामस्यामिततेजसः ।\nप्रदहन्निव सैन्यानि रश्मिमानिव तेजसा ।\nअथ तौ चक्रतुर्युद्धं वृत्रवासवयोरिव ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2123607, "chapter_id": 3651, "verse_number": "५६", "content_sanskrit": "ततः परशुमादाय नृपं बाहुसहस्रिणम् ।\nचिच्छेद सहसा रामो बहुशाखमिव द्रुमम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2123608, "chapter_id": 3651, "verse_number": "५७", "content_sanskrit": "तं हतं पतितं दृष्ट्वा समेताः सर्वबान्धवाः ।\nअसीनादाय शक्तीश्च रामं ते प्रत्यवारयन् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2123609, "chapter_id": 3651, "verse_number": "५८", "content_sanskrit": "रामोऽपि रथमास्थाय धनुरायम्य सत्वरः ।\nविसृजन् परमास्त्राणि व्यधमत् पार्थिवं बलम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2123610, "chapter_id": 3651, "verse_number": "५९", "content_sanskrit": "ततस्तु क्षत्रिया राजन् जामदग्न्यभयार्दिताः ।\nविविशुर्गिरिदुर्गाणि मृगाः सिंहभयादिव ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2123611, "chapter_id": 3651, "verse_number": "६०", "content_sanskrit": "तेषां स्वविहितं कर्म तद्भयान्नानुतिष्ठताम् ।\nप्रजा वृषलतां प्राप्ता ब्राह्मणानामदर्शनात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2123612, "chapter_id": 3651, "verse_number": "६१", "content_sanskrit": "तथा ते द्रविडाः काशाः पुण्ड्राश्च शबरैः सह ।\nवृषलत्वं परिगता ह्युच्छिन्नाः क्षत्रकर्मणः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2123613, "chapter_id": 3651, "verse_number": "६२", "content_sanskrit": "ततस्तु हतवीरासु क्षत्रियासु पुनः पुनः ।\nद्विजैरभ्युदितं क्षत्रं तानि रामो निहत्य च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2123614, "chapter_id": 3651, "verse_number": "६३", "content_sanskrit": "ततस्त्रिस्सप्तमं वारं रामं वागशरीरिणी ।\nदिव्या प्रोवाच मधुरा सर्वलोकपरिश्रुता ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2123615, "chapter_id": 3651, "verse_number": "६४", "content_sanskrit": "राम राम निवर्तस्व स्वगुणं चाथ पश्यसि ।\nक्षत्रबन्धूनिमान् प्राणैर्विप्रयुज्य पुनः पुनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2123616, "chapter_id": 3651, "verse_number": "६५", "content_sanskrit": "तथैव तं महात्मानमृचीकप्रमुखास्तथा ।\nराम राम महावीर निवर्तस्वेत्यथाब्रुवन् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2123617, "chapter_id": 3651, "verse_number": "६६", "content_sanskrit": "पितुर्वधममृष्यंस्तु रामः प्रोवाच तानृषीन् ।\nनार्हा हन्त भवन्तो मां निवारयितुमित्युत ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2123618, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2123619, "chapter_id": 3651, "verse_number": "६७", "content_sanskrit": "नार्हसि क्षत्रबन्धूंस्त्वं निहन्तुं जयतां वर ।\nन हि युक्तस्तदाघातो ब्राह्मणेन सता त्वया ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2123620, "chapter_id": 3651, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2123621, "chapter_id": 3651, "verse_number": "६८", "content_sanskrit": "पितॄणां वचनं श्रुत्वा क्रोधं त्यक्त्वा स भार्गवः ।\nअश्वमेधसहस्राणि नरमेधशतानि च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2123622, "chapter_id": 3651, "verse_number": "६९", "content_sanskrit": "इष्ट्वा सागरपर्यन्तां काश्यपाय महीं ददौ ।\nतेन रामेण सङ्ग्रामे तुल्यस्तात धनञ्जयः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2123623, "chapter_id": 3651, "verse_number": "७०", "content_sanskrit": "कार्तवीर्येण च रणे तुल्यः पार्थो न संशयः ।\nरणे विक्रम्य राजेन्द्र पार्थं जेतुं न शक्यते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2123624, "chapter_id": 3651, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि त्रिनवतितमोऽध्यायः ॥९३॥ ॥ अनुद्यूतपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]