[{"id": 2052111, "chapter_id": 2152, "verse_number": "७-७९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052112, "chapter_id": 2152, "verse_number": "७-७९-१", "content_sanskrit": "ततोऽर्जुनस्य भवनं प्रविश्याप्रतिमं विभुः।\nस्पृष्ट्वाम्भः पुण्डरीकाक्षः स्थण्डिले शुभलक्षणे।\nसन्तस्तार शुभां शय्यां दर्भैर्वैदूर्यसन्निभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052113, "chapter_id": 2152, "verse_number": "७-७९-२", "content_sanskrit": "ततो माल्येन विधिवल्लाजैर्गन्धैः सुमङ्गलैः।\nअलञ्चकार तां शय्यां परिवार्यायुधोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052114, "chapter_id": 2152, "verse_number": "७-७९-३", "content_sanskrit": "ततः स्पृष्टोदकं पार्थं विनीतपरिचारकम्।\nनैत्यकं दर्शयाञ्चक्रे नैशं त्रैयम्बकं बलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052115, "chapter_id": 2152, "verse_number": "७-७९-४", "content_sanskrit": "ततः प्रीतमनाः पार्थो गन्धमाल्यैश्च माधवम्।\nअलङ्कृत्योपहारं तं नैशं तस्मै न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052116, "chapter_id": 2152, "verse_number": "७-७९-५", "content_sanskrit": "साधुसाध्विति गोविन्दः फल्गुनं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052117, "chapter_id": 2152, "verse_number": "७-७९-६", "content_sanskrit": "सुप्यतां पार्थ भद्रं ते कल्याणाय व्रजाम्यहम्।\nस्थापयित्वा ततो द्वास्थान्गोप्तॄंश्चात्तायुधान्नरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052118, "chapter_id": 2152, "verse_number": "७-७९-७", "content_sanskrit": "दारुकानुगतः श्रीमान्विवेश शिबिरं स्वकम्।\nशिश्ये च शयने शुभ्रे बहुकृत्य विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052119, "chapter_id": 2152, "verse_number": "७-७९-८", "content_sanskrit": "पार्थाय सर्वं भगवाञ्शोकदुःखापहं विधिम्।\nव्यदधात्पुण्डरीकाक्षस्तेजोद्युतिविवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052120, "chapter_id": 2152, "verse_number": "७-७९-९", "content_sanskrit": "योगमास्थाय युक्तात्मा सर्वेषामीश्वरेश्वरः।\nश्रेयस्कामः पृथुयशा विष्णुर्जिष्णुप्रियङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052121, "chapter_id": 2152, "verse_number": "७-७९-१०", "content_sanskrit": "न पाण्डवानां शिबिरे कश्चित्सुष्वाप तां निशाम्।\nप्रजागरः सर्वजनं ह्याविवेश विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052122, "chapter_id": 2152, "verse_number": "७-७९-११", "content_sanskrit": "पुत्रशोकाभितप्तेन प्रतिज्ञातो महात्मना।\nश्वः सिन्धुराजस्य वधः कार्यो गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052123, "chapter_id": 2152, "verse_number": "७-७९-१२", "content_sanskrit": "तत्कथं नु महाबाहुर्वासविः परवीरहा।\nप्रतिज्ञां सफलां कुर्यादिति ते समचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052124, "chapter_id": 2152, "verse_number": "७-७९-१३", "content_sanskrit": "कष्टं हीदं व्यवसितं पाण्डवेन महात्मना।\nपुत्रशोकाभिभूतेन प्रतिज्ञा महती कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052125, "chapter_id": 2152, "verse_number": "७-७९-१४", "content_sanskrit": "भ्रातरश्चापि विक्रान्ता बहुलानि बलानि च।\nधृतराष्ट्रस्य पुत्रेण सर्वतः सन्निवेशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052126, "chapter_id": 2152, "verse_number": "७-७९-१५", "content_sanskrit": "स हत्वा सैन्धवं सङ्ख्ये पुनरेतु जयी सुखी।\n`हत्वा रिपुगणं सर्वं पारयित्वा महाव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052127, "chapter_id": 2152, "verse_number": "७-७९-१६", "content_sanskrit": "यद्यस्ति सुकृतं किञ्चिदस्माकं हन्तु सैन्धवम्।\nजित्वा सर्वान्रिपून्पार्थस्त्रातु नोऽस्मान्महाभयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052128, "chapter_id": 2152, "verse_number": "७-७९-१७", "content_sanskrit": "एवमाशंसमानास्ते केचित्तस्थुरुपश्रुतिम्।\nश्रुत्वा चेष्टं सुमनसो व्यक्तमाशंसिरे जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052129, "chapter_id": 2152, "verse_number": "७-७९-१८", "content_sanskrit": "भविता नु कथं कृत्यमिदमित्यब्रुवञ्जनाः।\nश्वोऽहत्वा सिन्धुराजं वै धूमकेतुं प्रवेक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052130, "chapter_id": 2152, "verse_number": "७-७९-१९", "content_sanskrit": "न शक्यमनृतां कर्तुं प्रतिज्ञां विजयेन हि।\n`महद्धि साहसं पार्थः कृतवाच्छोकमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052131, "chapter_id": 2152, "verse_number": "७-७९-२०", "content_sanskrit": "धर्मपुत्रः कथं राजा भविष्यति मृतेऽर्जुने।\nतस्मिन्हि विजयः कृत्स्नः पाण्डवेन समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052132, "chapter_id": 2152, "verse_number": "७-७९-२१", "content_sanskrit": "यदि नोऽस्ति कृतं किञ्चिद्यदि दत्तं हुतं यदि।\nफलेन तस्य सर्वस्य सव्यसाची जयत्वरीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052133, "chapter_id": 2152, "verse_number": "७-७९-२२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052134, "chapter_id": 2152, "verse_number": "७-७९-२२", "content_sanskrit": "एवं कथयतां तेषां जयमाशंसतां प्रभो।\nकृच्छ्रेण महता राजन्रजनी व्यत्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052135, "chapter_id": 2152, "verse_number": "७-७९-२३", "content_sanskrit": "तस्या रजन्या मध्ये तु प्रतिबुद्धो जनार्दनः।\nस्मृत्वा प्रतिज्ञां पार्थस्य दारुकं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052136, "chapter_id": 2152, "verse_number": "७-७९-२४", "content_sanskrit": "अर्जुनेन प्रतिज्ञातमार्तेन हतबन्धुना।\nजयद्रथं वधिष्यामि श्वोभूत इति दारुक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052137, "chapter_id": 2152, "verse_number": "७-७९-२५", "content_sanskrit": "तत्तु दुर्योधनः श्रुत्वा मन्त्रिभिर्मन्त्रयिष्यति।\nयथा जयद्रथं पार्थो न हन्यादिति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052138, "chapter_id": 2152, "verse_number": "७-७९-२६", "content_sanskrit": "अक्षौहिण्यो हि ताः सर्वा रक्षिष्यन्ति जयद्रथम्।\nद्रोणश्च सहपुत्रेण सर्वास्त्रविधिपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052139, "chapter_id": 2152, "verse_number": "७-७९-२७", "content_sanskrit": "एको वीरः सहस्राक्षो दैत्यदानवदर्पहा।\nसोऽपि तं नोत्सहेताजौ हन्तुं द्रोणेन रक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052140, "chapter_id": 2152, "verse_number": "७-७९-२८", "content_sanskrit": "सोऽहं श्वस्तत्करिष्यामि यथा कुन्तीसुतोऽर्जुनः।\nअप्राप्तेऽस्तं दिनकरे हनिष्यति जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052141, "chapter_id": 2152, "verse_number": "७-७९-२९", "content_sanskrit": "न हि दारा न मित्राणि ज्ञातयो न च बान्धवाः।\nकश्चिदन्यः प्रियतरः कुन्तीपुत्रान्ममार्जुनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052142, "chapter_id": 2152, "verse_number": "७-७९-३०", "content_sanskrit": "अनर्जुनमिमं लोकं मुहूर्तमपि दारुक।\nउदीक्षितुं न शक्तोऽहं भविता न च तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052143, "chapter_id": 2152, "verse_number": "७-७९-३१", "content_sanskrit": "अहं विजित्य तान्सर्वान्सहसा सहयद्विपान्।\nअर्जुनार्थे हनिष्यामि सकर्णान्ससुयोधनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052144, "chapter_id": 2152, "verse_number": "७-७९-३२", "content_sanskrit": "श्वो निरीक्षन्तु मे वीर्यं त्रयो लोका महाहवे।\nधनञ्जयार्थे समरे पराक्रान्तस्य दारुक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052145, "chapter_id": 2152, "verse_number": "७-७९-३३", "content_sanskrit": "श्वो नरेन्द्रसहस्राणि राजपुत्रशतानि च।\nसाश्वद्विपरथान्याजौ विद्रविष्यामि दारुक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052146, "chapter_id": 2152, "verse_number": "७-७९-३४", "content_sanskrit": "श्वस्तां चक्रप्रमथितां द्रक्ष्यसे नृपवाहिनीम्।\nमया क्रुद्धेन समरे पाण्डवार्थे निपातिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2052147, "chapter_id": 2152, "verse_number": "७-७९-३५", "content_sanskrit": "श्वः सदेवाः सगन्धर्वाः पिशाचोरगराक्षसाः।\nज्ञास्यन्ति लोकाः सर्वे मां सुहृदं सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2052148, "chapter_id": 2152, "verse_number": "७-७९-३६", "content_sanskrit": "यस्तं द्वेष्टि स मां द्वेष्टि यस्तं चानु स मामनु।\nइति सङ्कल्प्यतां बुद्ध्या शरीरार्धं ममार्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2052149, "chapter_id": 2152, "verse_number": "७-७९-३७", "content_sanskrit": "यथा त्वं मे प्रभातायामस्यां निशि रथोत्तमम्।\nकल्पयित्वा यथाशास्त्रमादाय व्रज संयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2052150, "chapter_id": 2152, "verse_number": "७-७९-३८", "content_sanskrit": "गदां कौमोदकीं दिव्यां शक्तिं चक्रं धनुः शरान्।\nआरोप्य वै रथे सूत सर्वोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2052151, "chapter_id": 2152, "verse_number": "७-७९-३९", "content_sanskrit": "स्थानं च कल्पयित्वाऽथ रथोपस्थे ध्वजस्य मे।\nवैनतेयस्य वीरस्य समरे रथशोभिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2052152, "chapter_id": 2152, "verse_number": "७-७९-४०", "content_sanskrit": "छत्रं जाम्बूनदैर्जालैरर्कज्वलनसप्रभैः॥\nविश्वकर्मकृतैर्दिव्यैरश्वानपि विभूषय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2052153, "chapter_id": 2152, "verse_number": "७-७९-४१", "content_sanskrit": "बलाहकं मेघपुष्पं शैब्यं सुग्रीवमेव च।\nयुक्त्वा वाजिवरांस्तत्र कवची तिष्ठ दारुक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2052154, "chapter_id": 2152, "verse_number": "७-७९-४२", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं पर्जन्यनिनदोपमम्।\nश्रुत्वा च भैरवं नादमुपेयास्त्वं जवेन माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2052155, "chapter_id": 2152, "verse_number": "७-७९-४३", "content_sanskrit": "एकाह्नाऽहममर्षं च सर्वदुःखानि चैव ह।\nभ्रातुः पैतृष्वसेयस्य व्यपनेष्यामि दारुक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2052156, "chapter_id": 2152, "verse_number": "७-७९-४४", "content_sanskrit": "सर्वोपायैर्यतिष्यामि यथा बीभत्सुराहवे।\nपश्यतां धार्तराष्ट्राणां हनिष्यति जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2052157, "chapter_id": 2152, "verse_number": "७-७९-४५", "content_sanskrit": "यस्ययस्य च बीभत्सुर्वधे यत्नं करिष्यति।\nआशंसेऽहं रणे तन्तं तत्रतत्र हनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2052158, "chapter_id": 2152, "verse_number": "७-७९-४६x", "content_sanskrit": "दारुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2052159, "chapter_id": 2152, "verse_number": "७-७९-४६", "content_sanskrit": "जय एव ध्रुवस्तस्य कुत एव पराजयः।\nयस्य त्वं पुरुषव्याघ्र सारथ्यमुपजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2052160, "chapter_id": 2152, "verse_number": "७-७९-४७", "content_sanskrit": "एवं चैतत्करिष्यामि यथा मामनुभाषसे।\nसुप्रभातामिमां रात्रिं जयाय विजयस्य हि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2052161, "chapter_id": 2152, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि एकोनाशीतितमोऽध्यायः॥ ७९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-७९-३ लाजैरक्षतैः॥ ५-७९-४ तस्मै त्र्यम्बकाय॥ ५-७९-८ पार्थाय तादर्थ्ये चतुर्थी। तेजः प्रतापः॥ ५-७९-१३ महात्मना इत्यस्यानन्तरं स च राजा महावीर्यः पारयत्वर्जुनः स ताम् इत्येकमर्ध ङ. च.झ.ञ. पुस्तकेषु अधिकं वर्तते॥ ५-७९-३१ सहसा बलेन॥ ५-७९-३६ अनु अनुगतः॥ ५-७९-७९ एकोनाशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]