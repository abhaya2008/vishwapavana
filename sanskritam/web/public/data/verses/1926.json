[{"id": 2041661, "chapter_id": 1926, "verse_number": "५-१७१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041662, "chapter_id": 1926, "verse_number": "५-१७१-१", "content_sanskrit": "पाञ्चालराजस्य सुतो राजन्परपुरंजयः ।\nशिखण्डी रथमुख्यो मे मतः पार्थस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041663, "chapter_id": 1926, "verse_number": "५-१७१-२", "content_sanskrit": "एष योत्स्यति संग्रामे नाशयन्पूर्वसंस्थितम् ।\nपरं यशो विप्रथयंस्तव सेनासु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041664, "chapter_id": 1926, "verse_number": "५-१७१-३", "content_sanskrit": "एतस्य बहुलाः सेनाः पाञ्चालाश्च प्रभद्रकाः ।\nतेनासौ रथवंशेन महत्कर्म करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041665, "chapter_id": 1926, "verse_number": "५-१७१-४", "content_sanskrit": "धृष्टद्युम्नश्च सेनानीः सर्वसेनासु भारत ।\nमतो मेऽतिरथो राजन्द्रोणशिष्यो महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041666, "chapter_id": 1926, "verse_number": "५-१७१-५", "content_sanskrit": "एष योत्स्यति संग्रामे सूदयन्वै परान्रणे।\nभगवानिव संक्रुद्धः पिनाकी युगसंक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041667, "chapter_id": 1926, "verse_number": "५-१७१-६", "content_sanskrit": "एतस्य तद्रथानीकं कथयन्ति रणप्रियाः ।\nबहुत्वात्सागरप्रख्यं देवानामिव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041668, "chapter_id": 1926, "verse_number": "५-१७१-७", "content_sanskrit": "क्षत्रधर्मा तु राजेन्द्र मतो मेऽर्धरथो नृप।\nधृष्टद्युम्नस्य तनयो बाल्यान्नातिकृतश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041669, "chapter_id": 1926, "verse_number": "५-१७१-८", "content_sanskrit": "शिशुपालसुतो वीरश्चेदिराजो महारथः।\nधृष्टकेतुर्महेष्वासः संबन्धी पाण्डवस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041670, "chapter_id": 1926, "verse_number": "५-१७१-९", "content_sanskrit": "एष चेदिपतिः शूरः सह पुत्रेण भारत ।\nमहारथानां सुकरं महत्कर्म करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041671, "chapter_id": 1926, "verse_number": "५-१७१-१०", "content_sanskrit": "क्षत्रधर्मरतो मह्यं मतः परपुरंजयः ।\nक्षत्रदेवस्तु राजेन्द्र पाण्डवेषु रथोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041672, "chapter_id": 1926, "verse_number": "५-१७१-११", "content_sanskrit": "जयन्तश्चामितौजाश्च सत्यजिच्च महारथः ।\nमहारथा महात्मानः सर्वे पाञ्चालसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041673, "chapter_id": 1926, "verse_number": "५-१७१-१२", "content_sanskrit": "योत्स्यन्ते समरे तात संरब्धा इव कुञ्जराः ।\nअजो भोजश्च विक्रान्तौ पाण्डवार्थे महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041674, "chapter_id": 1926, "verse_number": "५-१७१-१३", "content_sanskrit": "योत्स्येते बलिनौ शूरौ परं शक्त्या यतिष्यतः।\nशीघ्रास्त्राश्चित्रयोद्धारः कृतिनो दृढविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041675, "chapter_id": 1926, "verse_number": "५-१७१-१४", "content_sanskrit": "केकयाः पञ्च राजेन्द्र भ्रातरो दृढविक्रमाः ।\nसर्वे चैव रथोदाराः सर्वे लोहितकध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041676, "chapter_id": 1926, "verse_number": "५-१७१-१५", "content_sanskrit": "काशिकः सुकुमारश्च नीलो यश्चापरो नृप ।\nसूर्यदत्तश्च शङ्खश्च मदिराश्वश्च नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041677, "chapter_id": 1926, "verse_number": "५-१७१-१६", "content_sanskrit": "सर्व एव रथोदाराः सर्वे चाहवलक्षणाः ।\nसर्वास्त्रविदुषः सर्वे महात्मानो मता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041678, "chapter_id": 1926, "verse_number": "५-१७१-१७", "content_sanskrit": "वार्धक्षेमिर्महाराज मतो मम महारथः ।\nचित्रायुघश्च नृपतिर्मतो मे रथसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041679, "chapter_id": 1926, "verse_number": "५-१७१-१८", "content_sanskrit": "स हि सङ्ग्रामशोभी च भक्तश्चापि किरीटिनः ।\nचेकितानः सत्यधृतिः पाण्डवानां महारथौ ।\nद्वाविमौ पुरुषव्याघ्रौ रथोदारौ मतौ मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041680, "chapter_id": 1926, "verse_number": "५-१७१-१९", "content_sanskrit": "व्याघ्रदत्तश्च राजेन्द्र चन्द्रसेनश्च भारत।\nमतौ मम रथोदारौ पाण्डवानां न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041681, "chapter_id": 1926, "verse_number": "५-१७१-२०", "content_sanskrit": "सेनाबिन्दुश्च राजेन्द्र क्रोधहन्ता च नामतः ।\nयः समो वासुदेवेन भीमसेनेन वा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041682, "chapter_id": 1926, "verse_number": "५-१७१-२१", "content_sanskrit": "स योत्स्यति हि विक्रम्य समरे तव सैनिकैः ।\nमां च द्रोणं कृपं चैव यथा संमन्यते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041683, "chapter_id": 1926, "verse_number": "५-१७१-२२", "content_sanskrit": "तथा स समरश्लाघी मन्तव्यो रथसत्तमः ।\nकाश्यः परमशीघ्रास्त्रः श्लाघनीयो नरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041684, "chapter_id": 1926, "verse_number": "५-१७१-२३", "content_sanskrit": "रथ एकगुणो मह्यं ज्ञेयः परपुरंजयः ।\nअयं च युधि विक्रान्तो मन्तव्योष्टगुणो रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041685, "chapter_id": 1926, "verse_number": "५-१७१-२४", "content_sanskrit": "सत्यजित्समरश्लाघी द्रुपदस्यात्मजो युवा ।\nगतः सोऽतिरथत्वं हि धृष्टद्युम्नेन संमितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041686, "chapter_id": 1926, "verse_number": "५-१७१-२५", "content_sanskrit": "पाण्डवानां यशस्कामः परं कर्म करिष्यति ।\nअनुरक्ताश्च शूरश्च रथोऽयमपरो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041687, "chapter_id": 1926, "verse_number": "५-१७१-२६", "content_sanskrit": "पाण्ड्यराजो महावीर्यः पाण्डवानां धुरंधरः ।\nदृढधन्वा महेष्वासः पाण्डवानां महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041688, "chapter_id": 1926, "verse_number": "५-१७१-२७", "content_sanskrit": "श्रेणिमान्कौरवश्रेष्ठ वसुदानश्च पार्थिवः ।\nउभावेतावतिरथौ मतौ परपुरंजयौ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041689, "chapter_id": 1926, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि एकसप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]