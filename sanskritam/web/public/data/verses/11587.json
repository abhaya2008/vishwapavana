[{"id": 50016845, "chapter_id": 11587, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50016846, "chapter_id": 11587, "verse_number": "2", "content_sanskrit": "एकादश्यां निराहारः समर्भ्यच्य जनार्दनम्। स्नातुं नन्दस्तु काळिन्द्या द्वादश्यां जलमाविशत्॥ १०/२६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50016847, "chapter_id": 11587, "verse_number": "3", "content_sanskrit": "तं गृहीत्वाऽनयद् भृत्यो वरुणस्यासुरोऽन्तिकम्। अविज्ञायासुरीं वेळां प्रविष्टमुदकं निशि॥ १०/२६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50016848, "chapter_id": 11587, "verse_number": "4", "content_sanskrit": "गोपालास्तमपश्यन्तः कृष्ण रामेति चुक्रुशुः। भगवांस्तदुपश्रुत्य पितरं वरुणाहृतम्॥ १०/२६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50016849, "chapter_id": 11587, "verse_number": "5", "content_sanskrit": "तदन्तिकं गतो राजन् स्वानामभयदो विभुः। प्राप्तं वीक्ष्य हृषीकेशं लोकपालः सपर्यया। महत्या पूजयित्वाऽऽह तद्दर्शनमहोत्सवः॥ १०/२६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50016850, "chapter_id": 11587, "verse_number": "6", "content_sanskrit": "वरुण उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50016851, "chapter_id": 11587, "verse_number": "7", "content_sanskrit": "अद्य मे विधृतो देह अद्यार्थोऽधिगतः प्रभो। यत्पादभाजो भगवन्नवापुः पारमध्वनः॥ १०/२६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50016852, "chapter_id": 11587, "verse_number": "8", "content_sanskrit": "नमस्तुभ्यं भगवते ब्रह्मणे परमात्मने। न यत्र श्रूयते माया लोकदृष्टिविकल्पना॥ १०/२६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50016853, "chapter_id": 11587, "verse_number": "9", "content_sanskrit": "अजानता मामकेन मूढेनाकार्यवेदिना। आनीतोऽयं तव पिता तत् प्रभो क्षन्तुमर्हसि॥ १०/२६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50016854, "chapter_id": 11587, "verse_number": "10", "content_sanskrit": "गोविन्द नीयतामेष पिता ते पितृवत्सल। ममाप्यनुग्रहं कृष्ण कर्तुमर्हस्यशेषदृक्॥ १०/२६/८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50016855, "chapter_id": 11587, "verse_number": "11", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50016856, "chapter_id": 11587, "verse_number": "12", "content_sanskrit": "एवं प्रसादितः कृष्णो भगवानखिलेश्वरः। आदायागात् स्वपितरं बन्धूनामावहन्मुदम्॥ १०/२६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50016857, "chapter_id": 11587, "verse_number": "13", "content_sanskrit": "नन्दस्त्वतीन्द्रियं दृष्ट्वा लोकपालमहोदयम्। कृष्णे च सन्नतिं तेषां ज्ञातिभ्यो विस्मितोऽब्रवीत्॥१०/२६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50016858, "chapter_id": 11587, "verse_number": "14", "content_sanskrit": "ते त्वौत्सुक्यधियो राजन् मत्वा गोपास्त्वधीश्वरम्। अपि नः स्वगतिं सूक्ष्मामुपाधास्यदधीश्वरः॥१०/२६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50016859, "chapter_id": 11587, "verse_number": "15", "content_sanskrit": "इति स्वानां स भगवान् विज्ञायाखिलदृक् स्वयम्। सङ्कल्पसिद्धये तेषां कृपयेदमचिन्तयत्॥ १०/२६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50016860, "chapter_id": 11587, "verse_number": "16", "content_sanskrit": "जनो वै लोक एतस्मिन्नविद्याकामकर्मभिः। उच्चावचासु गतिषु न वेद स्वगतिं भ्रमन्॥ १०/२६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50016861, "chapter_id": 11587, "verse_number": "17", "content_sanskrit": "इति सञ्चिन्त्य भगवान् महाकारुणिकः प्रभुः। दर्शयामास लोकं स्वं ४गोपानां तमसः परम्॥ १०/२६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50016862, "chapter_id": 11587, "verse_number": "18", "content_sanskrit": "सत्यं ज्ञानमनन्तं यद् ब्रह्म ज्योतिः सनातनम्। यद् हि पश्यन्ति मुनयो गुणापाये समाहितम्॥ १०/२६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50016863, "chapter_id": 11587, "verse_number": "19", "content_sanskrit": "ते तु ब्रह्मह्वदं नीता मग्नाः कृष्णमचक्षत। ददृशुर्ब्रह्मणो लोकं यत्राक्रूरोऽध्यगात् पुरा॥ १०/२६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50016864, "chapter_id": 11587, "verse_number": "20", "content_sanskrit": "नन्दादयस्तु तं दृष्ट्वा परमानन्दनिर्वृताः। कृष्णं च तत्र छन्दोभिः स्तूयमानं सुविस्मिताः॥ १०/२६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50016865, "chapter_id": 11587, "verse_number": "21", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे षड्विंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]