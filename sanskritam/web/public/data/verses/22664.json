[{"id": 7002664000, "chapter_id": 22664, "verse_number": "७-७-१", "content_sanskrit": "सूत उवाच ।\nभीष्मः सिंहस्थिते गंगाकूले शक्रप्रपूजकः ।\nशक्रं सूर्यमयं ज्ञात्वा तपसा समतोषयत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002664001, "chapter_id": 22664, "verse_number": "७-७-२", "content_sanskrit": "मासांते भगवानिंद्रो ज्ञात्वा तद्भक्तिमुत्तमाम् ।\nवरं वरय च प्राह श्रुत्वा शूरोब्रवीदिदम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002664002, "chapter_id": 22664, "verse_number": "७-७-३", "content_sanskrit": "देहि मे वडवां दिव्यां यदि तुष्टो भवान्प्रभुः ।\nइति श्रुत्वा तदा तस्मै वडवां हरिणीं शुभाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002664003, "chapter_id": 22664, "verse_number": "७-७-४", "content_sanskrit": "ददौ स भगवानिंद्रस्तत्रैवान्तर्हितोभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002664004, "chapter_id": 22664, "verse_number": "७-७-५", "content_sanskrit": "तस्मिन्काले परिमलः पितृशोकपरायणः ।\nपार्थिवैः पूजयामास महादेवमुमापतिम् ।\nपरीक्षार्थं शिवः साक्षात्सर्परोगेण तं ग्रसत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002664005, "chapter_id": 22664, "verse_number": "७-७-६", "content_sanskrit": "व्यतीते पंचमे मासे नृपः शक्तिविवर्जितः ।\nन तत्याज महापूजां महाक्लेशसमन्वितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002664006, "chapter_id": 22664, "verse_number": "७-७-७", "content_sanskrit": "मरणाय ययौ काशीं स्वपत्न्या सहितो नृपः ।\nउवास वटमूलांते रात्रौ रोगप्रपीडितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002664007, "chapter_id": 22664, "verse_number": "७-७-८", "content_sanskrit": "एतस्मिन्नन्तरे कश्चित्पन्नगो मूलसंस्थितः ।\nशब्दं चकार मधुरं श्रुत्वा रुद्राहिराययौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002664008, "chapter_id": 22664, "verse_number": "७-७-९", "content_sanskrit": "रुद्राहिं पन्नगः प्राह भवान्निर्दय मन्दधीः ।\nशिवभक्तं नृपमिमं पीडयेत्प्रत्यहं खलः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002664009, "chapter_id": 22664, "verse_number": "७-७-१०", "content_sanskrit": "मूर्खोऽयं भूपतिः साक्षादारनालं पिबेन्नहि ।\nइति श्रुत्वा स रुद्राहिराह रे पन्नगाधम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002664010, "chapter_id": 22664, "verse_number": "७-७-११", "content_sanskrit": "राज्ञो देहे परं हर्षं प्रत्यहं प्राप्तवानहम् ।\nस्वगेहं दुःखतस्त्याज्यं कथं त्याज्यं मया शठ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002664011, "chapter_id": 22664, "verse_number": "७-७-१२", "content_sanskrit": "मूर्खोत्र भूपतिर्यो वै तैलोष्णं यन्न दत्तवान् ।\nइत्युक्त्वान्तर्गतो देहे श्रुत्वा सा मलना सती ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002664012, "chapter_id": 22664, "verse_number": "७-७-१३", "content_sanskrit": "चकार पन्नगोक्तं तद्गतरोगो नृपोऽभवत् ।\nतैलोष्णैर्बिलमापूर्य चखान च सती स्वयम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002664013, "chapter_id": 22664, "verse_number": "७-७-१४", "content_sanskrit": "ततो जातं स्वयं लिंगमंगुष्ठाभं सनातनम् ।\nज्योतीरूपं चिदानंदं सर्वलक्ष्मसमन्वितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002664014, "chapter_id": 22664, "verse_number": "७-७-१५", "content_sanskrit": "निशीथे तम उद्भूते दिक्षु सूर्यत्वमागतम् ।\nदृष्ट्वा स विस्मितो राजा पूजयामास शंकरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002664015, "chapter_id": 22664, "verse_number": "७-७-१६", "content_sanskrit": "महिम्नस्तवपाठैश्च तुष्टाव गिरिजापतिम् ।\nतदा प्रसन्नो भगवान्वरं ब्रूहि तमब्रवीत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002664016, "chapter_id": 22664, "verse_number": "७-७-१७", "content_sanskrit": "श्रुत्वाह नृपतिर्देवं यदि तुष्टो महेश्वर ।\nश्रीपतिर्मे गृहं प्राप्य वसेन्मत्प्रियकारकः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002664017, "chapter_id": 22664, "verse_number": "७-७-१८", "content_sanskrit": "तथेत्युक्त्वा महादेवो लिंगरूपत्वमागतः ।\nप्रत्यहं भारमेकं च सुवर्णं सुषुवे तनोः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002664018, "chapter_id": 22664, "verse_number": "७-७-१९", "content_sanskrit": "तदा मलस्तु संतुष्टः प्राप्तो गेहं महावतीम् ।\nभीमसिंहेन सहितः परमानंदमाययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002664019, "chapter_id": 22664, "verse_number": "७-७-२०", "content_sanskrit": "ततःप्रभृति वर्षांते जयचंद्रपुरीं ययौ ।\nदृष्ट्वा परिमलं राजा कृतकृत्यत्वमागतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002664020, "chapter_id": 22664, "verse_number": "७-७-२१", "content_sanskrit": "दिष्ट्या ते संक्षितो रोगो दिष्ट्या ते दर्शितं मुखम् ।\nभवान्निजपुरीं प्राप्य सुखी भवतु मा चिरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002664021, "chapter_id": 22664, "verse_number": "७-७-२२", "content_sanskrit": "यदा मे विघ्न आभूयात्तदा त्वं मां समाचर ।\nइति श्रुत्वा परिमलो गत्वा स्थानमवासयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002664022, "chapter_id": 22664, "verse_number": "७-७-२३", "content_sanskrit": "तदा तु लक्षणो वीरो भगवन्तमुषापतिम् ।\nजगन्नाथमुपागम्य समभ्यर्च्चापरोऽभवत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002664023, "chapter_id": 22664, "verse_number": "७-७-२४", "content_sanskrit": "पक्षमात्रांतरे विष्णुर्जगन्नाथ उषापतिः ।\nवरं ब्रूहि वचश्चेति लक्षणं प्राह हर्षतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002664024, "chapter_id": 22664, "verse_number": "७-७-२५", "content_sanskrit": "इत्युक्तः स तु तं देवं नत्वोवाच विनम्रधीः ।\nदेहि मे वाहनं दिव्यं सर्वशत्रुविनाशनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002664025, "chapter_id": 22664, "verse_number": "७-७-२६", "content_sanskrit": "इति श्रुत्वा जगन्नाथः शक्तिमैरावताद्गजात् ।\nसमुत्पाद्य ददौ तस्मै दिव्यामैरावतीं मुदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002664026, "chapter_id": 22664, "verse_number": "७-७-२७", "content_sanskrit": "आरुह्यैरावतीं राजा लक्षणो गेहमाययौ ।\nस वै परिमलो राजा जगाम च महावतीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002664027, "chapter_id": 22664, "verse_number": "७-७-२८", "content_sanskrit": "एतस्मिन्नंतरे वीरास्तालनाद्या मदोत्कटाः ।\nमहावतीं पुरीं प्राप्य ददृशुस्तं महीपतिम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002664028, "chapter_id": 22664, "verse_number": "७-७-२९", "content_sanskrit": "तेन सार्द्धं च महतीं प्रीतिं कृत्वा न्यवासयन् ।\nमासान्ते च पुनस्ते वै राजानो विनयान्विताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002664029, "chapter_id": 22664, "verse_number": "७-७-३०", "content_sanskrit": "ऊचुस्तं शृणु भूपाल वयं गच्छामहे पुरीः ।\nतदा राजापि तान्प्राह सर्वान्क्षितिपती नथ ।\nदत्त्वाधिकारं पुत्रेभ्यस्तदाऽयास्यामि वोऽन्तिकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002664030, "chapter_id": 22664, "verse_number": "७-७-३१", "content_sanskrit": "तथेत्युक्तास्तु ते राज्ञा स्वगेहं पुनराययुः ।\nसानुजो देशराजस्तु द्विजेभ्यः स्वपुरं ददौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002664031, "chapter_id": 22664, "verse_number": "७-७-३२", "content_sanskrit": "पुत्रेभ्यस्तालनो वीरो ददौ वाराणसीं पुरीम् ।\nअलिकोल्लामतिः कालः पत्र पुष्पोदरी वरी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002664032, "chapter_id": 22664, "verse_number": "७-७-३३", "content_sanskrit": "करीनरी सुललितस्तेषां नामानि वै क्रमात् ।\nद्वौ द्वौ पुत्रौ स्मृतौ तेषां पितुस्तुल्यपराक्रमौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002664033, "chapter_id": 22664, "verse_number": "७-७-३४", "content_sanskrit": "स वै पुत्राज्ञया शूरस्तालनो राक्षसप्रियः ।\nयातुधानमयं देवं तुष्टाव म्लेच्छपूजनैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002664034, "chapter_id": 22664, "verse_number": "७-७-३५", "content_sanskrit": "तथा वसुमतः पुत्रौ भूपतीदेशवत्सजौ ।\nशक्रं सूर्य्यं समाराध्य कृतकृत्यौ बभूवतुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002664035, "chapter_id": 22664, "verse_number": "७-७-३६", "content_sanskrit": "सिंहिनीनाम वडवां या तु दत्ता भयानका ।\nआरुह्य बलवाञ्छूरो गमनाय मनो दधौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002664036, "chapter_id": 22664, "verse_number": "७-७-३७", "content_sanskrit": "पंचशब्दं महानागमिन्द्रदत्तं मनोरमम् ।\nदेशराजस्तमारुह्य गमनाय मनो दधे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002664037, "chapter_id": 22664, "verse_number": "७-७-३८", "content_sanskrit": "हयं पपीहकं नाम सूर्यदत्तं नरस्वरम् ।\nवत्सराजस्तमारुह्य गमनाय मनो दधे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002664038, "chapter_id": 22664, "verse_number": "७-७-३९", "content_sanskrit": "त्रयः शूराः समागम्य नगरीं ते महावतीम् ।\nऊषुस्तत्र महात्मानो बहुमानेन सत्कृताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002664039, "chapter_id": 22664, "verse_number": "७-७-४०", "content_sanskrit": "सेना षष्टिसहस्रं तत्तेषां स्वामी स तालनः ।\nमंत्रिणौ भ्रातरौ तौ च नृपतेश्चन्द्रवंशिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002664040, "chapter_id": 22664, "verse_number": "७-७-४१", "content_sanskrit": "तैर्वीरै रक्षितो राजा कृतकृत्यत्वमागतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]