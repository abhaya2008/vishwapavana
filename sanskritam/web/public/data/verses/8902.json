[{"id": 40003947, "chapter_id": 8902, "verse_number": "1", "content_sanskrit": "ततः समीक्ष्य शयने सन्नं शोकेन पार्थिवम्। कौशल्या पुत्रशोकार्ता तमुवाच महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40003948, "chapter_id": 8902, "verse_number": "2", "content_sanskrit": "राघवे नरशार्दूले विषमुप्त्वाहिजिह्मगा। विचरिष्यति कैकेयी निर्मुक्तेव हि पन्नगी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40003949, "chapter_id": 8902, "verse_number": "3", "content_sanskrit": "विवास्य रामं सुभगा लब्धकामा समाहिता। त्रासयिष्यति मां भूयो दुष्टाहिरिव वेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40003950, "chapter_id": 8902, "verse_number": "4", "content_sanskrit": "अथ स्म नगरे रामश्चरन् भैक्षं गृहे वसेत्। कामकारो वरं दातुमपि दासं ममात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40003951, "chapter_id": 8902, "verse_number": "5", "content_sanskrit": "पातयित्वा तु कैकेय्या रामं स्थानाद्यथेष्टतः। प्रदिष्टो रक्षसां भागः पर्वणीवाहिताग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40003952, "chapter_id": 8902, "verse_number": "6", "content_sanskrit": "गजराजगतिर्वीरो महाबाहुर्धनुर्धरः। वनमाविशते नूनं सभार्य स्सह लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40003953, "chapter_id": 8902, "verse_number": "7", "content_sanskrit": "वने त्वदृष्टदुःखानां केकय्यानुमते त्वया। त्यक्तानां वनवासाय कान्ववस्था भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40003954, "chapter_id": 8902, "verse_number": "8", "content_sanskrit": "ते रत्नहीनास्तरुणाः फलकाले विवासिताः। कथं वत्स्यन्ति कृपणाः फलमूलैः कृताशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40003955, "chapter_id": 8902, "verse_number": "9", "content_sanskrit": "अपीदानीं स कालस्स्यान्मम शोकक्षय श्शिवः। सभार्यं यत्सह भ्रात्रा पश्येयमिह राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40003956, "chapter_id": 8902, "verse_number": "10", "content_sanskrit": "श्रृत्वैवोपस्थितौ वीरौ कदायोध्या भविष्यति। यशस्विनी हृष्टजना सूच्छ्रितध्वजमालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40003957, "chapter_id": 8902, "verse_number": "11", "content_sanskrit": "कदा प्रेक्ष्य नरव्याघ्रावरण्यात्पुनरागतौ। नन्दिष्यति पुरी हृष्टा समुद्र इव पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40003958, "chapter_id": 8902, "verse_number": "12", "content_sanskrit": "कदाऽयोध्यां महाबाहुः पुरीं वीरः प्रवेक्ष्यति। पुरस्कृत्य रथे सीतां वृषभो गोवधूमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40003959, "chapter_id": 8902, "verse_number": "13", "content_sanskrit": "कदा प्राणिसहस्राणि राजमार्गे ममात्मजौ। लाजैरवकिरिष्यन्ति प्रविशन्तावरिन्दमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40003960, "chapter_id": 8902, "verse_number": "14", "content_sanskrit": "प्रविशन्तौ कदाऽयोध्यां द्रक्ष्यामि शुभकुण्डलौ। उदग्रायुधनिस्त्रिंशौ सश्रृङ्गाविव पर्वतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40003961, "chapter_id": 8902, "verse_number": "15", "content_sanskrit": "कदासुमनसः कन्याद्विजातीनां फलानि च। प्रदिशन्तः पुरीं हृष्टाः करिष्यन्ति प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40003962, "chapter_id": 8902, "verse_number": "16", "content_sanskrit": "कदा परिणतो बुद्ध्या वयसा चामरप्रभः। अभ्युपैष्यति धर्मज्ञस्त्रिवर्ष इव मां ललन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40003963, "chapter_id": 8902, "verse_number": "17", "content_sanskrit": "निस्संशयं मया मन्ये पुरा वीर कदर्यया। पातुकामेषु वत्सेषु मातृ़णां शातितास्स्तनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40003964, "chapter_id": 8902, "verse_number": "18", "content_sanskrit": "साहं गौरिव सिंहेन विवत्सा वत्सला कृता। कैकेय्या पुरुषव्याघ्र बालवत्सेव गौर्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40003965, "chapter_id": 8902, "verse_number": "19", "content_sanskrit": "न हि तावद्गुणैर्जुष्टं सर्वशास्त्रविशारदम्। एकपुत्रा विना पुत्रमहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40003966, "chapter_id": 8902, "verse_number": "20", "content_sanskrit": "न हि मे जीविते किञ्चित्सामर्थ्यमिह कल्प्यते। अपश्यन्त्याः प्रियं पुत्रं महाबाहुं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40003967, "chapter_id": 8902, "verse_number": "21", "content_sanskrit": "अयं हि मां दीपयते समुत्थितः तनूजशोकप्रभवो हुताशनः। महीमिमां रश्मिभिरुद्धतप्रभः यथा निदाघे भगवान् दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]