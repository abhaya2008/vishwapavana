[{"id": 7005477000, "chapter_id": 25477, "verse_number": "१-४७-१", "content_sanskrit": "सूत उवाच ।\nकेतुमाले नराः कालाः सर्वे पनसभोजनाः ।\nस्त्रियश्चोत्पलपत्राभा जीवन्ति च वर्षायुतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005477001, "chapter_id": 25477, "verse_number": "१-४७-२", "content_sanskrit": "भद्राश्वे पुरुषाः शुक्लाः स्त्रियश्चन्द्रांशुसन्निभाः ।\nदश वर्षसहस्राणि जीवन्ते आम्रभोजनाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005477002, "chapter_id": 25477, "verse_number": "१-४७-३", "content_sanskrit": "रम्यके पुरुषा नार्यो रमन्ति रजतप्रभाः ।\nदशवर्षसहस्राणि शतानि दश पञ्च च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005477003, "chapter_id": 25477, "verse_number": "१-४७-४", "content_sanskrit": "जीवन्ति चैव सत्त्वस्था न्यग्रोधफलभोजनाः ।\nहिरण्मये हिरण्याभाः सर्वे च लकुचाशनाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005477004, "chapter_id": 25477, "verse_number": "१-४७-५", "content_sanskrit": "एकादशसहस्त्राणि शतानि दश पञ्च च ।\nजीवन्ति पुरुषा नार्यो देवलोकस्थिता इव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005477005, "chapter_id": 25477, "verse_number": "१-४७-६", "content_sanskrit": "त्रयोदशसहस्राणि शतानि दश पञ्च च ।\nजीवन्ति कुरुवर्षे तु श्यामाङ्गाः क्षीरभोजनाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005477006, "chapter_id": 25477, "verse_number": "१-४७-७", "content_sanskrit": "सर्वे मिथुनजाताश्च नित्यं सुखनिषेविताः ।\nचन्द्रद्वीपे महादेवं यजन्ति सततं शिवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005477007, "chapter_id": 25477, "verse_number": "१-४७-८", "content_sanskrit": "तथा किंपुरुषे विप्रा मानवा हेमसन्निभाः ।\nदशवर्षहस्राणि जीवन्ति प्लक्षभोजनाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005477008, "chapter_id": 25477, "verse_number": "१-४७-९", "content_sanskrit": "यजन्ति सततं देवं चतुर्मूर्ति चतुर्मुखम् ।\nध्याने मनः समाधाय सादरं भक्तिसंयुताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005477009, "chapter_id": 25477, "verse_number": "१-४७-१०", "content_sanskrit": "तथा च हरिवर्षे तु महारजतसन्निभाः ।\nदशवर्षसहस्राणि जीवन्तीक्षुरसाशिनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005477010, "chapter_id": 25477, "verse_number": "१-४७-११", "content_sanskrit": "तत्र नारायणं देवं विश्वयोनिं सनातनम् ।\nउपासते सदा विष्णुं मानवा विष्णुभाविताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005477011, "chapter_id": 25477, "verse_number": "१-४७-१२", "content_sanskrit": "तत्र चन्द्रप्रभं शुभ्रं शुद्धस्फटिकसन्निभम् ।\nविमानं वासुदेवस्य पारिजातवनाश्रितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005477012, "chapter_id": 25477, "verse_number": "१-४७-१३", "content_sanskrit": "चतुर्द्धारमनोपम्यं चतुस्तोरणसंयुतम् ।\nप्राकारैर्दशभिर्युक्तं दुराधर्षं सुदुर्गमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005477013, "chapter_id": 25477, "verse_number": "१-४७-१४", "content_sanskrit": "स्फाटिकैर्मण्डपैर्युक्तं देवराजगृहोपमम् ।\nस्वर्णस्तम्भसहस्त्रैश्च सर्वतः समलंकृतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005477014, "chapter_id": 25477, "verse_number": "१-४७-१५", "content_sanskrit": "हेमसोपानसंयुक्तं नानारत्नोपशोभितम् ।\nदिव्यसिंहासनोपेतं सर्वशोभासमन्वितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005477015, "chapter_id": 25477, "verse_number": "१-४७-१६", "content_sanskrit": "सरोभिः स्वादुपानीयैर्नदीभिश्चोपशोभितम् ।\nनारायणपरैः शुद्धैर्वेदाध्ययनतत्परैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005477016, "chapter_id": 25477, "verse_number": "१-४७-१७", "content_sanskrit": "योगिभिश्च समाकीर्णं ध्यायद्भिः पुरुषं हरिम् ।\nस्तुवद्भिः सततं मन्त्रैर्नमस्यद्भिश्च माधवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005477017, "chapter_id": 25477, "verse_number": "१-४७-१८", "content_sanskrit": "तत्र देवादिदेवस्य विष्णोरमिततेजसः ।\nराजानः सर्वकालं तु महिमानं प्रकुर्वते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005477018, "chapter_id": 25477, "verse_number": "१-४७-१९", "content_sanskrit": "गायन्ति चैव नृत्यन्ति विलासिन्यो मनोरमाः ।\nस्त्रियो यौवनशालिन्यः सदा मण्डनतत्पराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005477019, "chapter_id": 25477, "verse_number": "१-४७-२०", "content_sanskrit": "इलावृते पद्मवर्णा जम्बूरसफालशिनः ।\nत्रयोदशसहस्राणि वर्षाणां वै स्थिरायुषः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005477020, "chapter_id": 25477, "verse_number": "१-४७-२१", "content_sanskrit": "भारते तु स्त्रियः पुंसो नानावर्णाः प्रकीर्त्तिताः ।\nनानादेवार्च्चने युक्ता नानाकर्माणि कुर्वते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005477021, "chapter_id": 25477, "verse_number": "१-४७-२२", "content_sanskrit": "परमायुः स्मृतं तेषां शतं वर्षाणि सुव्रताः ।\nनवयोजनसाहस्रं वर्षमेतत् प्रकीर्त्तितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005477022, "chapter_id": 25477, "verse_number": "१-४७-२३", "content_sanskrit": "कर्मभूमिरियं विप्रा नराणामधिकारिणाम् ।\nमहेन्द्रो मलयः सह्यः शुक्तिमानृक्षपर्वतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005477023, "chapter_id": 25477, "verse_number": "१-४७-२४", "content_sanskrit": "विन्ध्यश्च पारियात्रश्च सप्तात्र कुलपर्वताः ।\nइन्द्रद्वीपः कसेरुक्मान् ताम्रवर्णो गभस्तिमान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005477024, "chapter_id": 25477, "verse_number": "१-४७-२५", "content_sanskrit": "नागद्वीपस्तथा सौम्यो गन्धर्वस्त्वथ वारुणः ।\nअयं तु नवमस्तेषां द्वीपः सागरसंवृतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005477025, "chapter_id": 25477, "verse_number": "१-४७-२६", "content_sanskrit": "योजनानां सहस्रं तु द्वीपोऽयं दक्षिणोत्तरः ।\nपूर्वे किरातास्तस्यान्ते पशिचमे यवनास्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005477026, "chapter_id": 25477, "verse_number": "१-४७-२७", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः मध्ये शूद्रास्तथैव च ।\nइज्यायुद्धवणिज्याभिर्वर्तयन्त्यत्र मानवाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005477027, "chapter_id": 25477, "verse_number": "१-४७-२८", "content_sanskrit": "स्रवन्ते पावना नद्यः पर्वतेभ्यो विनिः सृताः ।\nशतद्रुश्चन्द्रभागा च सरयूर्यमुना तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005477028, "chapter_id": 25477, "verse_number": "१-४७-२९", "content_sanskrit": "इरावती वितस्ता च विपाशा देविका कुहूः ।\nगोमती धूतपापा च बाहुदा च दृषद्वती ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005477029, "chapter_id": 25477, "verse_number": "१-४७-३०", "content_sanskrit": "कौशिकी लोहिता चैव हिमवत्पादनिः सृताः ।\nवेदस्मृतिर्वेदवती व्रतघ्नी त्रिदिवा तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005477030, "chapter_id": 25477, "verse_number": "१-४७-३१", "content_sanskrit": "वर्णाशा वन्दना चैव सचर्मण्यवती सुरा ।\nविदिशा वेत्रवत्यापि पारियात्राश्रयाः स्मृताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005477031, "chapter_id": 25477, "verse_number": "१-४७-३२", "content_sanskrit": "नर्मदा सुरसा शोण दशार्णा च महानदी ।\nमन्दाकिनी चित्रकूटा तामसी च पिशाचिका ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005477032, "chapter_id": 25477, "verse_number": "१-४७-३३", "content_sanskrit": "चित्रोत्पला विपाशा च मञ्जुला वालुवाहिनी ।\nऋक्षवत्पादजा नद्यः सर्वपापहरा नृणाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005477033, "chapter_id": 25477, "verse_number": "१-४७-३४", "content_sanskrit": "तापी पयोष्णी निर्विन्ध्या शीघ्रोदा च महानदी ।\nवेण्या वैतरणी चैव बलाका च कुमुद्वती ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005477034, "chapter_id": 25477, "verse_number": "१-४७-३५", "content_sanskrit": "तथा चैव महागैरी दुर्गा चान्तः शिला तथा ।\nविन्ध्यपादप्रसूतास्तु सद्यः पुण्यजलाः शुभाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005477035, "chapter_id": 25477, "verse_number": "१-४७-३६", "content_sanskrit": "गोदावरी भीमरथी कृष्णा वेणा च वश्यता ।\nतुङ्गभद्रा सुप्रयोगा कावेरी च द्विजोत्तमाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005477036, "chapter_id": 25477, "verse_number": "१-४७-३७", "content_sanskrit": "दक्षिणापथनद्यस्तु सह्यपादाद्विनिः सृताः ।\nऋतुमाला ताम्रपर्णी पुष्पवत्युत्पलावती ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005477037, "chapter_id": 25477, "verse_number": "१-४७-३८", "content_sanskrit": "मलयान्निःसृता नद्यः सर्वाः शीतजलाः स्मृताः ।\nऋषिकुल्या त्रिसामा च गन्दमादनगामिनी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005477038, "chapter_id": 25477, "verse_number": "१-४७-३९", "content_sanskrit": "रूपा पालासिनी चैव ऋषिका वंशधारिणी ।\nशुक्तिमत्पादसंजाताः सर्वपापहरा नृणाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005477039, "chapter_id": 25477, "verse_number": "१-४७-४०", "content_sanskrit": "आसां नद्युपनद्यश्च शतशो द्विजपुंगवाः ।\nसर्वपापहराः पुण्याः स्नानदानादिकर्मसु ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005477040, "chapter_id": 25477, "verse_number": "१-४७-४१", "content_sanskrit": "तास्विमे कुरुपाञ्चाला मध्यदेशादयो जनाः ।\nपूर्वदेशादिकाश्चैव कामरूपनिवासिनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005477041, "chapter_id": 25477, "verse_number": "१-४७-४२", "content_sanskrit": "पुण्ड्राः कलिङ्गामगधा दाक्षिणात्याश्चकृत्स्नशः ।\nतथापरान्ताः सौराष्ट्राः शूद्राभीरास्तथाऽर्बुदाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005477042, "chapter_id": 25477, "verse_number": "१-४७-४३", "content_sanskrit": "मालका मालपाश्चैव पारियात्रनिवासिनः ।\nसौवीराः सैन्धवा हूणा माल्याः बाल्यनिवासिनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005477043, "chapter_id": 25477, "verse_number": "१-४७-४४", "content_sanskrit": "माद्रा रामास्तथैवान्ध्राः पारसीकास्तथैव च ।\nआसां पिबन्ति सलिलं वसन्ति सरितां सदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005477044, "chapter_id": 25477, "verse_number": "१-४७-४५", "content_sanskrit": "चत्वारि भारते वर्षे युगानि कवयोऽब्रुवन् ।\nकृतं त्रेता द्वापरं च कलिश्चान्यत्र न क्वचित् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005477045, "chapter_id": 25477, "verse_number": "१-४७-४६", "content_sanskrit": "यानि किंपुरुषाद्यानि वर्षाण्यष्टौ महर्षयः ।\nन तेषु शोको नायासो नोद्वेगः क्षुद्भयं न च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005477046, "chapter_id": 25477, "verse_number": "१-४७-४७", "content_sanskrit": "स्वस्थाः प्रजा निरातङ्काः सर्वदुः खविवर्जिताः ।\nरमन्ते विविधैर्भावैः सर्वाश्च स्थिरयौवनाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]