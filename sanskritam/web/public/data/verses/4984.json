[{"id": 2187351, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2187352, "chapter_id": 4984, "verse_number": "१", "content_sanskrit": "पितामह महाप्राज्ञ दुःखशोकसमाकुले ।\nसंसारचक्रे लोकानां निर्वेदो नास्ति किन्विदम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2187353, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2187354, "chapter_id": 4984, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनिबन्धनस्य संवादं भोगवत्या नृपोत्तम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2187355, "chapter_id": 4984, "verse_number": "३", "content_sanskrit": "मुनिं निबन्धनं शुष्कं धमनीयाकृतं तथा ।\nनिरारम्भं निरालम्बमसज्जन्तं च कर्मणि ।\nपुत्रं दृष्ट्वाऽप्युवाचार्तं माता भोगवती तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2187356, "chapter_id": 4984, "verse_number": "४", "content_sanskrit": "उत्तिष्ठ मूढ किं शेषे निरपेक्षः सुहृज्जनैः ।\nनिरालम्बो धनोपाये पैतृकं तव किं धनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2187357, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "निबन्धनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2187358, "chapter_id": 4984, "verse_number": "५", "content_sanskrit": "पैतृकं मे महन्मातः सर्वदुःखालयं त्विह ।\nअस्त्येतत्तद्विघाताय यतिष्ये तत्र मा शुचः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2187359, "chapter_id": 4984, "verse_number": "६", "content_sanskrit": "इदं शरीरमत्युग्रं पित्रा दत्तमसंशयम् ।\nतमेव पितरं गत्वा धनं तिष्ठति शाश्वतम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2187360, "chapter_id": 4984, "verse_number": "७", "content_sanskrit": "कश्चिन्महति संसारे वर्तमानो धनेच्छया ।\nवनदुर्गमभिप्राप्तो महत् क्रव्यादसङ्कुलम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2187361, "chapter_id": 4984, "verse_number": "८", "content_sanskrit": "सिंहव्याघ्रगजाकारैरतिघोरैर्महाशनैः ।\nसमन्तात् सुपरिक्षिप्तं स दृष्ट्वा व्यथते पुमान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2187362, "chapter_id": 4984, "verse_number": "९", "content_sanskrit": "स तद्वनं ह्यनुचरन् विप्रधावन्नितस्ततः ।\nवीक्षमाणो दिशः सर्वाः शरणार्थं प्रधावति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2187363, "chapter_id": 4984, "verse_number": "१०", "content_sanskrit": "अथापश्यद्वनं रूढं समन्ताद् वागुरावृतम् ।\nवनमध्ये च तत्रासीदुदपानः समावृतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2187364, "chapter_id": 4984, "verse_number": "११", "content_sanskrit": "वल्लिभिस्तृणसञ्छिन्नैर्गूढाभिरभिसंवृतः ।\nस पपात द्विजस्तत्र विजने सलिलाशये\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2187365, "chapter_id": 4984, "verse_number": "१२", "content_sanskrit": "विलग्नश्चाभवत्तस्मिँल्लतासन्तालसङ्कुले ।\nबाहुभ्यां सम्परिष्वक्तस्तया परमसत्त्वया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2187366, "chapter_id": 4984, "verse_number": "१३", "content_sanskrit": "स तथा लम्बते तत्र ऊर्ध्वपादो ह्यधःशिराः ।\nअधस्तत्रैव जातश्च जम्बूवृक्षः सुदुस्तरः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2187367, "chapter_id": 4984, "verse_number": "१४", "content_sanskrit": "कूपस्य तस्य वेलाया अपश्यत् सुमहाफलम् ।\nवृक्षं बहुविधं व्योमं वल्लीपुष्पसमाकुलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2187368, "chapter_id": 4984, "verse_number": "१५", "content_sanskrit": "नानारूपा मधुकरास्तस्मिन् वृक्षेऽभवन् किल ।\nतेषां मधूनां बहुधा धारा प्रववृते तता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2187369, "chapter_id": 4984, "verse_number": "१६", "content_sanskrit": "विलम्बमानः स पुमान् धारां पिबति सर्वदा ।\nन तस्य तृष्णा विरता पीयमानस्य सङ्कटे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2187370, "chapter_id": 4984, "verse_number": "१७", "content_sanskrit": "परीप्सति च तां नित्यमतृप्तः स पुनःपुनः ।\nएवं स वसते तत्र दःखिदुःखी पुनःपुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2187371, "chapter_id": 4984, "verse_number": "१८", "content_sanskrit": "मया तु तद्धनं देयं तव दास्यामि चेच्छसि ।\nतस्य च प्रार्थितः सोऽथ दत्वा मुक्तिमवाप सः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2187372, "chapter_id": 4984, "verse_number": "१९", "content_sanskrit": "सा च त्यक्त्वार्ऽथसङ्कल्पं जगाम परमां गतिम्\t॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2187373, "chapter_id": 4984, "verse_number": "२०", "content_sanskrit": "एवं संसारचक्रस्य स्वरूपज्ञा नृपोत्तम ।\nपरं वैराग्यमागम्य गच्छन्ति परमं पदम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2187374, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2187375, "chapter_id": 4984, "verse_number": "२१", "content_sanskrit": "एवं संसारचक्रस्य स्वरूपं विदितं न मे ।\nपैतृकं तु धनं प्रोक्तं किं तद् विद्वन्महात्मना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2187376, "chapter_id": 4984, "verse_number": "२२", "content_sanskrit": "कान्तारमिति किं प्रोक्तं को हस्ती स तु कूपकः ।\nकिंसञ्ज्ञिको महावृक्षो मधु वाऽपि पितामह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2187377, "chapter_id": 4984, "verse_number": "२३", "content_sanskrit": "एतं मे संशयं विद्धि धनशब्दं किमुच्यते ।\nकथं लब्धं धनं तेन तथा च किमिदं त्विह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2187378, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2187379, "chapter_id": 4984, "verse_number": "२४", "content_sanskrit": "उपाख्यानमिदं सर्वं मोक्षविद्भिरुदाहृतम् ।\nसुमतिं विन्दते येन बन्धनाशश्च भारत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2187380, "chapter_id": 4984, "verse_number": "२५", "content_sanskrit": "एतदुक्तं हि कान्तारं महान् संसार एव सः ।\nये ते प्रतिष्ठिता व्याला व्याधयस्ते प्रकीर्तिताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2187381, "chapter_id": 4984, "verse_number": "२६", "content_sanskrit": "या सा नारी महाघोरा वर्णरूपविनाशिनी ।\nतामाहुश्च जरां प्राज्ञाः परिष्वक्तं यया जगत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2187382, "chapter_id": 4984, "verse_number": "२७", "content_sanskrit": "यस्तत्र कूपे वसते महाहिः काल एव सः ।\nयो वृक्षः स च मृत्युर्हि स्वकृतं तस्य तत्फलम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2187383, "chapter_id": 4984, "verse_number": "२८", "content_sanskrit": "ये तु कृष्णाः सिता राजन् मूषिका रात्र्यहानि वै\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2187384, "chapter_id": 4984, "verse_number": "२९", "content_sanskrit": "द्विषट्कपदसंयुक्तो यो हस्ती षण्मुखाकृतिः ।\nस च संवत्सरः प्रोक्तः पादा मासर्तवो मुखाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2187385, "chapter_id": 4984, "verse_number": "३०", "content_sanskrit": "एतत्संसारचक्रस्य स्वरूपं व्याहृतं मया ।\nएवं लब्धधनं राजंस्तत्स्वरूपं विनाशय\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2187386, "chapter_id": 4984, "verse_number": "३१", "content_sanskrit": "एतज्ज्ञात्वा तु सा राजन् परं वैराग्यमास्थिता ।\nयथोक्तविधिना भूयः परं पदमवाप सः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2187387, "chapter_id": 4984, "verse_number": "३२", "content_sanskrit": "धत्ते धारयते चैव एतस्मात्कारणाद्धनम् ।\nतद् गच्छ चामृतं शुद्धं हिरण्यममृतं तपः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2187388, "chapter_id": 4984, "verse_number": "३३", "content_sanskrit": "तत्स्वरूपो महादेवः कृष्णो देवकिनन्दनः ।\nतस्य प्रसादाद्दुःखस्य नाशं प्राप्स्यसि मानद\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2187389, "chapter_id": 4984, "verse_number": "३४", "content_sanskrit": "एकः कर्ता स कृष्णश्च ज्ञानिनां परमा गतिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2187390, "chapter_id": 4984, "verse_number": "३५", "content_sanskrit": "इदमाश्रित्य देवेन्द्रो देवा रुद्रास्तथाऽश्विनौ ।\nस्वे स्वे पदे विविशिरे मुक्तिमुक्तिविदो जनाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2187391, "chapter_id": 4984, "verse_number": "३६", "content_sanskrit": "भूतनामन्तरात्माऽसौ स नित्यपदसंवृतः ।\nश्रूयतामस्य सद्भावः सम्यग् ज्ञानं यथा तव\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2187392, "chapter_id": 4984, "verse_number": "३७", "content_sanskrit": "भवेदेतन्निबोध त्वं नारदाय पुरा हरिः ।\nदर्शयित्वाऽऽत्मनो रूपं यदवोचत् स्वयं प्रभुः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2187393, "chapter_id": 4984, "verse_number": "३८", "content_sanskrit": "पुरा देवऋषिः श्रीमान्नारदः परमार्थवान् ।\nचचार पृथिवीं कृत्स्नां तीर्थान्यनुचरन् प्रभुः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2187394, "chapter_id": 4984, "verse_number": "३९", "content_sanskrit": "हिमवत्पादमाश्रित्य विचार्य च पुनःपुनः ।\nस ददर्श ह्रदं तत्र पद्मोत्पलसमाकुलम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2187395, "chapter_id": 4984, "verse_number": "४०", "content_sanskrit": "ददर्श कन्यां तत्तीरे सर्वाभरणभूषिताम् ।\nशोभमानां श्रिया राजन् क्रीडन्तीमुत्पलैस्तथा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2187396, "chapter_id": 4984, "verse_number": "४१", "content_sanskrit": "सा महात्मानमालोक्य नारदेत्याह भामिनी ।\nतस्याः समीपमासाद्य तस्थौ विस्मितमानसः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2187397, "chapter_id": 4984, "verse_number": "४२", "content_sanskrit": "वीक्षमाणं तमाज्ञाय सा कन्या चारुवासिनी ।\nविजजृम्भे महाभाग स्मयमाना पुनःपुनः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2187398, "chapter_id": 4984, "verse_number": "४३", "content_sanskrit": "तस्मात् समभवद् वक्त्रात् पुरुषाकृतिसंयुतः ।\nरत्नबिन्दुचिताङ्गस्तु सर्वाभरणसंयुतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2187399, "chapter_id": 4984, "verse_number": "४४", "content_sanskrit": "आदित्यसदृशाकारः शिरसा धारयन् मणिम् ।\nपुनरेव तदाकारः सदृशः समजायत\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2187400, "chapter_id": 4984, "verse_number": "४५", "content_sanskrit": "तृतीयस्तु महाराज विविधाभरणैर्युतः ।\nप्रदक्षिणं तु तां कृत्वा विविधध्वनयस्तु ताम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2187401, "chapter_id": 4984, "verse_number": "४६", "content_sanskrit": "ततः सर्वेण विप्रर्षिः कन्यां पप्रच्छ तां शुभाम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2187402, "chapter_id": 4984, "verse_number": "४७", "content_sanskrit": "का त्वं परमकल्याणि पद्मेन्दुसदृशानने ।\nन जाने त्वां महादेवि ब्रूहि सत्यमनिन्दिते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2187403, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "कन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2187404, "chapter_id": 4984, "verse_number": "४८", "content_sanskrit": "सावित्री नाम विप्रर्षे शृणु भद्रं तवास्तु वै ।\nकिं करिष्यामि तद् ब्रूहि तव यच्चेतसि स्थितम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2187405, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2187406, "chapter_id": 4984, "verse_number": "४९", "content_sanskrit": "अभिवादये त्वां सावित्रि कृतार्थोऽहमनिन्दिते ।\nएतं मे संशयं देवि वक्तुमर्हसि शोभने\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2187407, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "यस्तु वै प्रथमोत्पन्नः कोऽसौ स पुरुषाकृतिः ।\nबिन्दवस्तु महादेवि मूर्ध्नि ज्योतिर्मयाकृतिः\t॥५०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2187408, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "कन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2187409, "chapter_id": 4984, "verse_number": "५१", "content_sanskrit": "अग्रजः प्रथमोत्पन्नो यजुर्वेदस्तथाऽपरः ।\nतृतीयः सामवेदस्तु संशयो व्येतु ते मुने\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2187410, "chapter_id": 4984, "verse_number": "५२", "content_sanskrit": "वेदाश्च बिन्दुसंयुक्ता यज्ञस्य फलसंश्रिताः ।\nयत्तद् दृष्टं महज्ज्योतिर्ज्योतिरित्युच्यते बुधैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2187411, "chapter_id": 4984, "verse_number": "५३", "content_sanskrit": "ऋषेयंयाऽपीत्युक्त्वा चान्तरधीयत ।\nततः स विस्मयाविष्टो नारदः पुरुषर्षभ\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2187412, "chapter_id": 4984, "verse_number": "५४", "content_sanskrit": "ततः स्नात्वा महातेजा वाग्यतो नियतेन्द्रियः ।\nतुष्टाव पुरुषव्याघ्रो जिज्ञासुश्च तदद्भुतम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2187413, "chapter_id": 4984, "verse_number": "५५", "content_sanskrit": "ततो वर्षशते पूर्णे भगवाँल्लोकभावनः ।\nप्रादुश्चकार विश्वात्मा ऋषेः परमसौहृदात्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2187414, "chapter_id": 4984, "verse_number": "५६", "content_sanskrit": "तमागतं जगन्नाथं सर्वकारणकारणम् ।\nअखिलामरमौल्यङ्गरुक्मारुणपदद्वयम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2187415, "chapter_id": 4984, "verse_number": "५७", "content_sanskrit": "वैनतेयपदस्पर्शकिणशोभितजानुकम् ।\nपीताम्बरलसत्काञ्चीदामबद्धकटीतटम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2187416, "chapter_id": 4984, "verse_number": "५८", "content_sanskrit": "श्रीवत्सवक्षसं चारुमणिकौस्तुभकन्धरम् ।\nमन्दस्मितमुखाम्भोजं चलदायतलोचनम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2187417, "chapter_id": 4984, "verse_number": "५९", "content_sanskrit": "नम्रचापानुकरणनम्रभ्रूयुगशोभितम् ।\nनानारत्नमणीवज्रस्फुरन्मकरकुण्डलम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2187418, "chapter_id": 4984, "verse_number": "६०", "content_sanskrit": "इन्द्रनीलनिभाभं तं केयूरमुकुटोज्ज्वलम् ।\nदेवैरिन्द्रपुरोगैश्च ऋषिसङ्घैरभिष्टुतम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2187419, "chapter_id": 4984, "verse_number": "६१", "content_sanskrit": "नारदो जयशब्देन ववन्दे शिरसा हरिम्\t॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2187420, "chapter_id": 4984, "verse_number": "६२", "content_sanskrit": "ततः स भगवान् श्रीमान् मेघगम्भीरया गिरा ।\nप्राहेशः सर्वभूतानां नारदं पतितं क्षितौ\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2187421, "chapter_id": 4984, "verse_number": "६३", "content_sanskrit": "भद्रमस्तु ऋषे तुभ्यं वरं वरय सुव्रत ।\nयत्ते मनसि सुव्यक्तमस्ति च प्रददामि तत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2187422, "chapter_id": 4984, "verse_number": "६४", "content_sanskrit": "स चेमं जयशब्देन प्रसीदेत्यातुरो मुनिः ।\nप्रोवाच हृदि संरूढं शङ्खचक्रगदाधरम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2187423, "chapter_id": 4984, "verse_number": "६५", "content_sanskrit": "विवक्षितं जगन्नाथ मया ज्ञातं त्वयाऽच्युत ।\nतत् प्रसीद हृषीकेश श्रोतुमिच्छामि तद्धरे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2187424, "chapter_id": 4984, "verse_number": "६६", "content_sanskrit": "ततः स्मयन् महाविष्णुरभ्यभाषत नारदम् ।\nयद् दृष्टं मम रूपं तु वेदानां शिरसि त्वया\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2187425, "chapter_id": 4984, "verse_number": "६७", "content_sanskrit": "निर्द्वन्द्वा निरहङ्काराः शुचयः शुद्धलोचनाः ।\nतं मां पश्यन्ति सततं तान् पृच्छ यदिहेच्छसि\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2187426, "chapter_id": 4984, "verse_number": "६८", "content_sanskrit": "ये योगिनो महाप्राज्ञा मदंशा ये व्यवस्थिताः ।\nतेषां प्रसादं देवर्षे मत्प्रसादमवैहि तत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2187427, "chapter_id": 4984, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2187428, "chapter_id": 4984, "verse_number": "६९", "content_sanskrit": "इत्युक्त्वा स जगामाथ भगवान् भूतभावनः ।\nतस्माद् व्रज हृषीकेशं कृष्णं देवकिनन्दनम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2187429, "chapter_id": 4984, "verse_number": "७०", "content_sanskrit": "एतमाराध्य गोविन्दं गता मुक्तिं महर्षयः ।\nएष कर्ता विकर्ता च सर्वकारणकारणम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2187430, "chapter_id": 4984, "verse_number": "७१", "content_sanskrit": "मयाऽप्येतच्छ्रुतं राजन्नारदात्तु निबोध तत् ।\nस्वयमेव समाचष्ट नारदो भगवान् मुनिः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2187431, "chapter_id": 4984, "verse_number": "७२", "content_sanskrit": "समस्तसंसारविघातकारणं\nभजन्ति ये विष्णुमनन्यमानसाः ।\nते यान्ति सायुज्यमतीव दुर्लभ-\nमितीव नित्यं हृदि वर्णयन्ति\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2187432, "chapter_id": 4984, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षपर्वे त्रयस्त्रिंशोऽध्यायः ॥ ३३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]