[{"id": 7004957000, "chapter_id": 24957, "verse_number": "७-१-१४०-१", "content_sanskrit": "ततो गच्छेन्महादेवि नदीं चित्रपथां ततः ।\nब्रह्मकुण्डसमीपस्थां चित्रादित्यस्य मध्यतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004957001, "chapter_id": 24957, "verse_number": "७-१-१४०-२", "content_sanskrit": "यदा च चित्रः संनीतो यमदूतैः सुरप्रिये ।\nसशरीरो महाप्राज्ञो यमादेशपरायणैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004957002, "chapter_id": 24957, "verse_number": "७-१-१४०-३", "content_sanskrit": "एवं ज्ञात्वा तु तत्रस्था भगिनी तस्य दुःखिता ।\nचित्रा नदी ततो भूत्वा स्वसा तस्य महात्मनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004957003, "chapter_id": 24957, "verse_number": "७-१-१४०-४", "content_sanskrit": "प्रविष्टा सागरे देवि अन्वेषन्ती च बांधवम् ।\nततश्चित्रपथानाम तस्याश्चक्रुर्द्विजातयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004957004, "chapter_id": 24957, "verse_number": "७-१-१४०-५", "content_sanskrit": "एवं तत्र समुत्पन्ना सा नदी वरवर्णिनि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004957005, "chapter_id": 24957, "verse_number": "७-१-१४०-६", "content_sanskrit": "तस्यां स्नात्वा नरो यस्तु चित्रादित्यं प्रपश्यति ।\nस याति परमं स्थानं यत्र देवो दिवाकरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004957006, "chapter_id": 24957, "verse_number": "७-१-१४०-७", "content_sanskrit": "अस्मिन्कलियुगे देवि अंतर्धानं गता नदी ।\nप्रावृट्काले च दृश्येत दुर्लभं तत्र दर्शनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004957007, "chapter_id": 24957, "verse_number": "७-१-१४०-८", "content_sanskrit": "स्नानं दानं विशेषेण सर्वपातकनाशनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004957008, "chapter_id": 24957, "verse_number": "७-१-१४०-९", "content_sanskrit": "भुक्तो वाप्यथवाऽभुक्तो रात्रौ वा यदि वा दिवा ।\nपर्वकालेऽथवाऽकाले पवित्रोऽप्यथवाऽशुचिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004957009, "chapter_id": 24957, "verse_number": "७-१-१४०-१०", "content_sanskrit": "यदैव दृश्यते तत्र नदी चित्रपथा प्रिये ।\nप्रमाणं दर्शनं तस्या न कालस्तत्र कारणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004957010, "chapter_id": 24957, "verse_number": "७-१-१४०-११", "content_sanskrit": "दृष्ट्वा नदीं महादेवि पितरः स्वर्गसंस्थिताः ।\nगायंति तत्र सामानि नृत्यन्ति च हसंति च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004957011, "chapter_id": 24957, "verse_number": "७-१-१४०-१२", "content_sanskrit": "अस्माकं वंशजः कश्चिच्छ्राद्धमत्र करिष्यति ।\nयावत्कल्पं तथाऽस्माकं प्रीतिमुत्पादयिष्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004957012, "chapter_id": 24957, "verse_number": "७-१-१४०-१३", "content_sanskrit": "एवं ज्ञात्वा नरस्तत्र स्नानं श्राद्धं च कारयेत् ।\nसर्वपापविनाशार्थं पितॄणां प्रीतये तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004957013, "chapter_id": 24957, "verse_number": "७-१-१४०-१४", "content_sanskrit": "इत्येतत्कथितं देवि यथा चित्रपथा नदी ।\nप्रभासक्षेत्रमासाद्य संस्थिता पापनाशिनी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004957014, "chapter_id": 24957, "verse_number": "७-१-१४०-१५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एका शीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये चित्रपथानदीमाहात्म्यवर्णनंनाम चत्वारिंशदुत्तरशततमोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]