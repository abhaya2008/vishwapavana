[{"id": 2038535, "chapter_id": 1843, "verse_number": "५-८८-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038536, "chapter_id": 1843, "verse_number": "५-८८-१", "content_sanskrit": "यदाह विदुरः कृष्णे सर्वं तत्सत्यमच्युते।\nअनुरक्तो ह्यसंहार्यः पार्थान्प्रति जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038537, "chapter_id": 1843, "verse_number": "५-८८-२", "content_sanskrit": "यत्तत्सत्कारसंयुक्तं देयं वसु जनार्दने ।\nअनेकरूपं राजेन्द्र न तद्देयं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038538, "chapter_id": 1843, "verse_number": "५-८८-३", "content_sanskrit": "देशः कालस्तथाऽयुक्तो न हि नार्हति केशवः ।\nमंस्यत्यधोक्षजो राजन्भयादर्चति मामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038539, "chapter_id": 1843, "verse_number": "५-८८-४", "content_sanskrit": "अवमानश्च यत्र स्यात्क्षत्रियस्य विशांपते।\nन तत्कुर्याद्बुधः कार्यमिति मे निश्चिता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038540, "chapter_id": 1843, "verse_number": "५-८८-५", "content_sanskrit": "स हि पूज्यतमो लोके कृष्णः पृथुललोचनः ।\nत्रयाणामपि लोकानां विदितं मम सर्वथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038541, "chapter_id": 1843, "verse_number": "५-८८-६", "content_sanskrit": "न तु तस्मै प्रदेयं स्यात्तथा कार्यगतिः प्रभो ।\nविग्रहः समुपारब्धो न हि शाम्यत्यविग्रहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038542, "chapter_id": 1843, "verse_number": "५-८८-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038543, "chapter_id": 1843, "verse_number": "५-८८-७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा भीष्मः कुरुपितामहः।\nवैचित्रवीर्यं राजानमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038544, "chapter_id": 1843, "verse_number": "५-८८-८", "content_sanskrit": "सत्कृतोऽसत्कृतो वाऽपि न क्रुध्येत जनार्दनः ।\n`नावमंस्यत्यवज्ञातॄनवज्ञातोऽपि केशवः।\nनालमेनमवज्ञातुं नावज्ञेयो हि केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038545, "chapter_id": 1843, "verse_number": "५-८८-९", "content_sanskrit": "यत्तु कार्यं महाबाहो मनसा कार्यतां गतम् ।\nसर्वोपायैर्न तच्छक्यं केनचित्कर्तुमन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038546, "chapter_id": 1843, "verse_number": "५-८८-१०", "content_sanskrit": "स यद्ब्रूयान्महाबाहुस्तत्कार्यमविशङ्कया ।\nवासुदेवेन तीर्थेन क्षिप्रं संशाभ्य पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038547, "chapter_id": 1843, "verse_number": "५-८८-११", "content_sanskrit": "धर्म्यमर्थ्यं च धर्मात्मा ध्रुवं वक्ता जनार्दनः।\nतस्मिन्वाच्याः प्रिया वाचो भवता बान्धवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038548, "chapter_id": 1843, "verse_number": "५-८८-१२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038549, "chapter_id": 1843, "verse_number": "५-८८-१२", "content_sanskrit": "न पर्याप्तोस्मि यद्राजञ्श्रियं निष्केवलामहम् ।\nतैः सहेमामुपाश्रीयां यावज्जीवं पितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038550, "chapter_id": 1843, "verse_number": "५-८८-१३", "content_sanskrit": "इदं तु सुमहत्कार्यं श्रुणु मे यत्समर्थितम् ।\nपरायणं पाण्डवानां नियच्छामि जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038551, "chapter_id": 1843, "verse_number": "५-८८-१४", "content_sanskrit": "तस्मिन्बद्धे भविष्यन्ति वृष्णयः पृथिवी तथा।\nपाण्डवाश्च विधेया मे स च प्रातरिहैप्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038552, "chapter_id": 1843, "verse_number": "५-८८-१५", "content_sanskrit": "अत्रोपायान्यथा सम्यङ्न बुद्ध्येत जनार्दनः ।\nन चापायो भवेत्कश्चित्तद्भवान्प्रब्रवीतु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038553, "chapter_id": 1843, "verse_number": "५-८८-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038554, "chapter_id": 1843, "verse_number": "५-८८-१६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा घोरं कृष्णेऽभिसंहितम्।\nधृतराष्ट्रः सहामात्यो व्यथितो विमनाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038555, "chapter_id": 1843, "verse_number": "५-८८-१७", "content_sanskrit": "ततो दुर्योधनमिदं धृतराष्ट्रोऽब्रवीद्वचः ।\nमैवं वोचः प्रजापाल नैष धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038556, "chapter_id": 1843, "verse_number": "५-८८-१८", "content_sanskrit": "दूतश्च हि हृषीकेशः संबन्धी च प्रियश्च नः।\nअपापः कौरवेयेषु स कथं बन्धमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038557, "chapter_id": 1843, "verse_number": "५-८८-१९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038558, "chapter_id": 1843, "verse_number": "५-८८-१९", "content_sanskrit": "परीतस्तव पुत्रोऽयं धृतराष्ट्र सुमन्दधीः ।\nवृणोत्यनर्थं नैवार्थं याच्यमानः सुहृज्जनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038559, "chapter_id": 1843, "verse_number": "५-८८-२०", "content_sanskrit": "इममुत्पथि वर्तन्तं पापं पापानुबन्धिनम्।\nवाक्यानि सुहृदां हित्वा त्वमप्यस्यानुवर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038560, "chapter_id": 1843, "verse_number": "५-८८-२१", "content_sanskrit": "कृष्णमक्लिष्टकर्माणमासाद्यायं सुदुर्मतिः ।\nतव पुत्रः सहामात्यः क्षणेन न भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038561, "chapter_id": 1843, "verse_number": "५-८८-२२", "content_sanskrit": "पापस्यास्य नृशंसस्य त्यक्तधर्मस्य दुर्मतेः ।\nनोत्सहेऽनर्थसंयुक्ताः श्रोतुं वाचः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038562, "chapter_id": 1843, "verse_number": "५-८८-२३", "content_sanskrit": "इत्युक्त्वा भरतश्रेष्ठो वृद्धः परममन्युमान् ।\nउत्थाय तस्मात्प्रातिष्ठद्भीष्मः सत्यपराक्रमः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038563, "chapter_id": 1843, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अष्टाशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]