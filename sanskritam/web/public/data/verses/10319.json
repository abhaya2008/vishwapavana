[{"id": 6000319000, "chapter_id": 10319, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000319001, "chapter_id": 10319, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.001.m4a", "display_order": 2}, {"id": 6000319002, "chapter_id": 10319, "verse_number": "११-१८-१", "content_sanskrit": "वनं विविक्षुः पुत्रेषु भार्यां न्यस्य सहैव वा।\nवनमेव वसेच्छान्तस्तृतीयं भागमायुषः॥ ११/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.002.m4a", "display_order": 3, "topics": [{"text": "वानप्रस्थधर्मस्य यतिधर्मस्य च निरूपणम्", "range": "१–४९"}]}, {"id": 6000319003, "chapter_id": 10319, "verse_number": "११-१८-२", "content_sanskrit": "कन्दमूलफलैर्वन्यैर्मेध्यैर्वृत्तिं प्रकल्पयेत्।\nवसीत वल्कलं वासस्तृणपर्णाजिनानि च॥ ११/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.003.m4a", "display_order": 4}, {"id": 6000319004, "chapter_id": 10319, "verse_number": "११-१८-३", "content_sanskrit": "केशलोमनखश्मश्रुमलानि बिभृयाद् व्रती।\nन धावेदप्सु मज्जेत त्रिकालं स्थण्डिलेशयः॥ ११/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.004.m4a", "display_order": 5}, {"id": 6000319005, "chapter_id": 10319, "verse_number": "११-१८-४", "content_sanskrit": "ग्रीष्मे तप्येत पञ्चाग्निर्वर्षास्वासारषाड् जले।\nआकण्ठमग्नः शिशिर एवंवृत्तस्तपश्चरेत्॥ ११/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.005.m4a", "display_order": 6}, {"id": 6000319006, "chapter_id": 10319, "verse_number": "११-१८-५", "content_sanskrit": "अग्निपक्‍वं समश्नीयात् कालपक्‍वमथापि वा।\nउलूखल्यश्मकुट्टो वा दन्तोलूखल एव वा॥ ११/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.006.m4a", "display_order": 7}, {"id": 6000319007, "chapter_id": 10319, "verse_number": "११-१८-६", "content_sanskrit": "स्वयं सञ्चिनुयात् सर्वमात्मनो वृत्तिकारणम्।\nदेशकालबलाभिज्ञो नाददीतान्यदाहृतम्॥ ११/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.007.m4a", "display_order": 8}, {"id": 6000319008, "chapter_id": 10319, "verse_number": "११-१८-७", "content_sanskrit": "वन्यैश्चरुपुरोडाशान् निर्वपेत् कालचोदितान्।\nन तु श्रौतेन पशुना मां यजेत वनाश्रमी॥ ११/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.008.m4a", "display_order": 9}, {"id": 6000319009, "chapter_id": 10319, "verse_number": "११-१८-८", "content_sanskrit": "अग्निहोत्रं च दर्शं च पूर्णमासं च पूर्ववत्।\nचातुर्मास्यानि च मुनेराम्नातानि च नैगमैः॥ ११/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.009.m4a", "display_order": 10}, {"id": 6000319010, "chapter_id": 10319, "verse_number": "११-१८-९", "content_sanskrit": "एवं चीर्णेन तपसा मुनिर्धमनिसन्ततः।\nमां तपोमयमाराध्य ऋषिलोकादुपैति माम्॥ ११/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.010.m4a", "display_order": 11}, {"id": 6000319011, "chapter_id": 10319, "verse_number": "११-१८-१०", "content_sanskrit": "यस्त्वेवं कृच्छ्रतश्चीर्णं तपो नैःश्रेयसं महत्।\nकामायाल्पीयसे युञ्ज्याद् बालिशः कोऽपरस्ततः॥ ११/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.011.m4a", "display_order": 12}, {"id": 6000319012, "chapter_id": 10319, "verse_number": "११-१८-११", "content_sanskrit": "यदाऽसौ नियमेऽकल्पो जरया जातवेपथुः।\nआत्मन्यग्निं समारोप्य मच्चित्तोऽग्निं समाविशेत्॥ ११/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.012.m4a", "display_order": 13}, {"id": 6000319013, "chapter_id": 10319, "verse_number": "११-१८-१२", "content_sanskrit": "यदा धर्मविपाकेषु लोकेषु निरयात्मसु।\nविरागो जायते सम्यङ् न्यस्ताग्निः प्रव्रजेत् ततः॥ ११/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.013.m4a", "display_order": 14}, {"id": 6000319014, "chapter_id": 10319, "verse_number": "११-१८-१३", "content_sanskrit": "इष्ट्वा यथोपदेशं मां दत्वा सर्वस्वमृत्विजे।\nअग्नीन् स्वप्राण आवेश्य निरपेक्षः परिव्रजेत्॥ ११/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.014.m4a", "display_order": 15}, {"id": 6000319015, "chapter_id": 10319, "verse_number": "११-१८-१४", "content_sanskrit": "विप्रस्य वै संन्यसतो देवा दारादिरूपिणः।\nविघ्नं कुर्वन्त्ययं ह्यस्मानाक्रम्य समियात् परम्॥ ११/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.015.m4a", "display_order": 16}, {"id": 6000319016, "chapter_id": 10319, "verse_number": "११-१८-१५", "content_sanskrit": "बिभृयाच्चेन्मुनिर्वासः कौपीनाच्छादनं परम्।\nत्यक्तं न दण्डपात्राभ्यामन्यत् किञ्चिदनापदि॥ ११/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.016.m4a", "display_order": 17}, {"id": 6000319017, "chapter_id": 10319, "verse_number": "११-१८-१६", "content_sanskrit": "दृष्टिपूतं न्यसेत् पादं वस्त्रपूतं पिबेज्जलम्।\nसत्यपूतं वदेद् वाक्यं मनःपूतं समाचरेत्॥ ११/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.017.m4a", "display_order": 18}, {"id": 6000319018, "chapter_id": 10319, "verse_number": "११-१८-१७", "content_sanskrit": "मौनानीहानिलायामदण्डो वाग्देहचेतसाम्।\nन ह्येते यस्य सन्त्यङ्ग वेणुभिर्न भवेद् यतिः॥ ११/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.018.m4a", "display_order": 19}, {"id": 6000319019, "chapter_id": 10319, "verse_number": "११-१८-१८", "content_sanskrit": "भिक्षां चतुर्षु वर्णेषु विगर्ह्यान् वर्जयंश्चरेत्।\nसप्तागारानसंक्लृप्तांस्तुष्येल्लब्धेन तावता॥ ११/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.019.m4a", "display_order": 20}, {"id": 6000319020, "chapter_id": 10319, "verse_number": "११-१८-१९", "content_sanskrit": "बहिर्जलाशयं गत्वा तत्रोपस्पृश्य वाग्यतः।\nविभज्य याचितं शेषं भुञ्जीताशेषमाहृतम्॥ ११/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.020.m4a", "display_order": 21}, {"id": 6000319021, "chapter_id": 10319, "verse_number": "११-१८-२०", "content_sanskrit": "एकश्चरेन्महीमेतां निःसङ्गः संयतेन्द्रियः।\nआत्मक्रीड आत्मरत आत्मवान् समदर्शनः॥ ११/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.021.m4a", "display_order": 22}, {"id": 6000319022, "chapter_id": 10319, "verse_number": "११-१८-२१", "content_sanskrit": "विविक्तक्षेमशरणो मद्भावविमलाशयः।\nआत्मानं चिन्तयेदेकमभेदेन मया मुनिः॥ ११/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.022.m4a", "display_order": 23}, {"id": 6000319023, "chapter_id": 10319, "verse_number": "११-१८-२२", "content_sanskrit": "अन्वीक्षेताऽत्मनो बन्धं मोक्षं च ज्ञाननिष्ठया।\nबन्ध इन्द्रियविक्षेपो मोक्ष एषां च संयमः॥ ११/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.023.m4a", "display_order": 24}, {"id": 6000319024, "chapter_id": 10319, "verse_number": "११-१८-२३", "content_sanskrit": "तस्मान्नियम्य षड्वर्गं मद्भावेन चरेन्मुनिः।\nविरक्तः क्षुल्लकामेभ्यो लब्ध्वाऽत्मनि सुखं महत्॥ ११/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.024.m4a", "display_order": 25}, {"id": 6000319025, "chapter_id": 10319, "verse_number": "११-१८-२४", "content_sanskrit": "पुरग्रामव्रजान् सार्थान् भिक्षार्थं प्रविशंश्चरेत्।\nपुण्यदेशसरिच्छैलवनाश्रमवतीं महीम्॥ ११/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.025.m4a", "display_order": 26}, {"id": 6000319026, "chapter_id": 10319, "verse_number": "११-१८-२५", "content_sanskrit": "वानप्रस्थाश्रमपदेष्वभीक्ष्णं भैक्ष्यमाचरेत्।\nसंसिद्ध्यत्याश्वसंमोहः शुद्धसत्त्वः शिलान्धसा॥ ११/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.026.m4a", "display_order": 27}, {"id": 6000319027, "chapter_id": 10319, "verse_number": "११-१८-२६", "content_sanskrit": "नैतद् वस्तुतया पश्येद् दृश्यमानं विनश्वरम्।\nअसक्तचित्तो विरमेदिहामुत्र चिकीर्षितात्॥ ११/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.027.m4a", "display_order": 28}, {"id": 6000319028, "chapter_id": 10319, "verse_number": "११-१८-२७", "content_sanskrit": "यदेतदात्मनि जगन्मनोवाक्प्राणसम्भृतम्।\nसर्वं मायेति तर्केण स्वस्थस्त्यक्त्वा न तत् स्मरेत्॥ ११/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.028.m4a", "display_order": 29}, {"id": 6000319029, "chapter_id": 10319, "verse_number": "११-१८-२८", "content_sanskrit": "ज्ञाननिष्ठो विरक्तो वा मद्भक्तो वाऽनपेक्षकः।\nसलिङ्गानाश्रमान् मुक्त्वा चरेदविधिगोचरः॥ ११/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.029.m4a", "display_order": 30}, {"id": 6000319030, "chapter_id": 10319, "verse_number": "११-१८-२९", "content_sanskrit": "बुधो बालकवत् क्रीडेत् कुशलो जडवच्चरेत्।\nवदेदुन्मत्तवद् विद्वान् गोचर्यां नैगमश्चरेत्॥ ११/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.030.m4a", "display_order": 31}, {"id": 6000319031, "chapter_id": 10319, "verse_number": "११-१८-३०", "content_sanskrit": "वेदवादरतो न स्यान्न पाषण्डी न हैतुकी।\nशुष्कवादविवादेन कञ्चित्पक्षं न संश्रयेत्॥ ११/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.031.m4a", "display_order": 32}, {"id": 6000319032, "chapter_id": 10319, "verse_number": "११-१८-३१", "content_sanskrit": "नोद्विजेत जनाद् धीरो जनं चोद्वेजयेन्न तु।\nअतिवादांस्तितिक्षेत नावमन्येत कञ्चन॥ ११/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.032.m4a", "display_order": 33}, {"id": 6000319033, "chapter_id": 10319, "verse_number": "११-१८-३२", "content_sanskrit": "देहमुद्दिश्य पशुवद् वैरं कुर्यान्न केनचित्॥ ११/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.033.m4a", "display_order": 34}, {"id": 6000319034, "chapter_id": 10319, "verse_number": "११-१८-३३", "content_sanskrit": "एक एव परो ह्यात्मा भूतेष्वात्मन्यवस्थितः।\nखं यद्वदुदपात्रेषु भूतान्येकात्मकानि च॥ ११/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.034.m4a", "display_order": 35}, {"id": 6000319035, "chapter_id": 10319, "verse_number": "११-१८-३४", "content_sanskrit": "अलब्ध्वा न विषीदेत काले कालेऽशनं क्‍वचित्।\nलब्ध्वा न हृष्येद् धृतिमानुभयं देवतन्त्रितम्॥ ११/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.035.m4a", "display_order": 36}, {"id": 6000319036, "chapter_id": 10319, "verse_number": "११-१८-३५", "content_sanskrit": "आहारार्थं समीहेत युक्तं तत्प्राणधारणम्।\nतत्वं विमृश्यते तेन तद् विज्ञाय विमुच्यते॥ ११/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.036.m4a", "display_order": 37}, {"id": 6000319037, "chapter_id": 10319, "verse_number": "११-१८-३६", "content_sanskrit": "यदृच्छयोपपन्नान्नमद्याच्छ्रेष्ठमुतापरम्।\nतथा वासस्तथा शय्यां प्राप्तं प्राप्तं भजेन्मुनिः॥ ११/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.037.m4a", "display_order": 38}, {"id": 6000319038, "chapter_id": 10319, "verse_number": "११-१८-३७", "content_sanskrit": "शौचमाचमनं स्नानं न तु चोदनया चरेत्।\nअन्यांश्च नियमान् ज्ञानी यथाऽहं लीलयेश्वरः॥ ११/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.038.m4a", "display_order": 39}, {"id": 6000319039, "chapter_id": 10319, "verse_number": "११-१८-३८", "content_sanskrit": "नहि तस्य विकल्पाख्या क्रिया मद्वीक्षया हता।\nआदेहान्तात् क्‍वचित् ख्यातिस्ततः सम्पद्यते मया॥ ११/१८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.039.m4a", "display_order": 40}, {"id": 6000319040, "chapter_id": 10319, "verse_number": "११-१८-३९", "content_sanskrit": "दुःखोदर्केषु कामेषु जातनिर्वेद आत्मवान्।\nअजिज्ञासितमद्धर्मो गुरुं मुनिमुपाव्रजेत्॥ ११/१८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.040.m4a", "display_order": 41}, {"id": 6000319041, "chapter_id": 10319, "verse_number": "११-१८-४०", "content_sanskrit": "तावत् परिचरेद् भक्तः श्रद्धावाननसूयकः।\nयावद् ब्रह्म विजानीयान्मामेव गुरुमादृतः॥ ११/१८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.041.m4a", "display_order": 42}, {"id": 6000319042, "chapter_id": 10319, "verse_number": "११-१८-४१", "content_sanskrit": "यस्त्वसंयतषड्वर्गः प्रचण्डेन्द्रियसारथिः।\nज्ञानवैराग्यरहितस्त्रिदण्डमुपजीवति॥ ११/१८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.042.m4a", "display_order": 43}, {"id": 6000319043, "chapter_id": 10319, "verse_number": "११-१८-४२", "content_sanskrit": "सुरानात्मानमात्मस्थं निह्नुते मां च धर्महा।\nअविपक्‍वकषायोऽस्मादमुष्माच्च विहीयते॥ ११/१८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.043.m4a", "display_order": 44}, {"id": 6000319044, "chapter_id": 10319, "verse_number": "११-१८-४३", "content_sanskrit": "भिक्षोर्धर्मः शमोऽहिंसा तप ईक्षा वनौकसः।\nगृहिणो भूतरक्षेज्या द्विजस्याचार्यसेवनम्॥ ११/१८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.044.m4a", "display_order": 45}, {"id": 6000319045, "chapter_id": 10319, "verse_number": "११-१८-४४", "content_sanskrit": "ब्रह्मचर्यं तपः शौचं सन्तोषो भूतसौहृदम्।\nगृहस्थस्याग्रतो गन्तुः सर्वेषां मदुपासनम्॥ ११/१८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.045.m4a", "display_order": 46}, {"id": 6000319046, "chapter_id": 10319, "verse_number": "११-१८-४५", "content_sanskrit": "इति मां यः स्वधर्मेण भजेन्नित्यमनन्यभाक्।\nसर्वभूतेषु मद्भावो मद्भक्तिं विन्दते चिरात्॥ ११/१८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.046.m4a", "display_order": 47}, {"id": 6000319047, "chapter_id": 10319, "verse_number": "११-१८-४६", "content_sanskrit": "भक्त्योद्धवानपायिन्या सर्वलोकमहेश्वरम्।\nसर्वोत्पत्त्यप्ययं ब्रह्म कारणं मोपयाति सः॥ ११/१८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.047.m4a", "display_order": 48}, {"id": 6000319048, "chapter_id": 10319, "verse_number": "११-१८-४७", "content_sanskrit": "इति स्वधर्मनिर्णिक्तसत्वो निर्ज्ञातमद्गतिः।\nज्ञानविज्ञानसम्पन्नो विरक्तः समुपैति माम्॥ ११/१८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.048.m4a", "display_order": 49}, {"id": 6000319049, "chapter_id": 10319, "verse_number": "११-१८-४८", "content_sanskrit": "वर्णाश्रमवतां धर्म एष आचारलक्षणः।\nस एव मद्भक्तियुतो निःश्रेयसकरः परः॥ ११/१८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.049.m4a", "display_order": 50}, {"id": 6000319050, "chapter_id": 10319, "verse_number": "११-१८-४९", "content_sanskrit": "एतत् तेऽभिहितं साधो भवान्पृच्छति यच्च माम्।\nयथा स्वधर्मसंयुक्तो भक्तो मां समियात् परम्॥ ११/१८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_018/BhP_11.018.050.m4a", "display_order": 51}, {"id": 6000319051, "chapter_id": 10319, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे अष्टादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]