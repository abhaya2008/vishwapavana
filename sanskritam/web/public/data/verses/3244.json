[{"id": 2103573, "chapter_id": 3244, "verse_number": "१४-१००-१", "content_sanskrit": "युधिष्ठिर उवाच।\nदेवदेवेश दैत्यघ्नि परं कौतूहलं हि मे।\nएतत्कथय सर्वज्ञ त्वद्भक्तस्य च केशव।\nमानुषस्य च लोकस्य धर्मलोकस्य चान्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103574, "chapter_id": 3244, "verse_number": "१४-१००-२", "content_sanskrit": "कीदृशं किंप्रमाणं वा किमधिष्ठानमेव च।\nतरन्ति मानुषा देव केनोपायेन माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103575, "chapter_id": 3244, "verse_number": "१४-१००-३", "content_sanskrit": "त्वगस्थिमांसनिर्मुक्ते पञ्चभूतविवर्जिते।\nकथयस्व महादेव सुखदुःखमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103576, "chapter_id": 3244, "verse_number": "१४-१००-४", "content_sanskrit": "जीवस्य कर्मलोकेषु कर्मभिस्तु शुभाशुभैः।\nअनुबद्धस्य तैः पाशैर्नीयमानस्य दारुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103577, "chapter_id": 3244, "verse_number": "१४-१००-५", "content_sanskrit": "मृत्युदूतैर्दुराधर्षैर्घोरैर्घोरपरक्रमैः।\nवध्यस्याक्षिप्यमाणस्य विद्रुतस्य यमाज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103578, "chapter_id": 3244, "verse_number": "१४-१००-६", "content_sanskrit": "पुण्यपापकृदातिष्ठेत्सुखदुःखमशेषतः।\nयमदूतैर्द्रुराधर्षैर्नीयते वा कथं पुनः।\nकिं वा तत्र गता देव कर्म कुर्वन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103579, "chapter_id": 3244, "verse_number": "१४-१००-७", "content_sanskrit": "कथं धर्मपरा यान्ति देवताद्विजपूजकाः।\nकतं वा पापकर्माणो यान्ति प्रेतपुरं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103580, "chapter_id": 3244, "verse_number": "१४-१००-८", "content_sanskrit": "किं रूपं किं प्रमाणं वा वर्णः को वाऽस्य केशव।\nजीवस्य गच्छतो नित्यं यमलोकं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103581, "chapter_id": 3244, "verse_number": "१४-१००-९x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103582, "chapter_id": 3244, "verse_number": "१४-१००-९", "content_sanskrit": "शृणु राजन्यथावृतं यन्मां त्वं परिपृच्छसि।\nतत्तेऽहं कथयिष्यामि मद्भक्तस्य नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103583, "chapter_id": 3244, "verse_number": "१४-१००-१०", "content_sanskrit": "षडशीतिसहस्राणि योजनानां युधिष्ठिर।\nमानुष्यस्य च लोकस्य यमलोकस्य चान्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103584, "chapter_id": 3244, "verse_number": "१४-१००-११", "content_sanskrit": "न तत्र वृक्षच्छाया वा न तटाकं सरोपि वा।\nन वाप्यो दीर्घिका वाऽपि न कूपो वा युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103585, "chapter_id": 3244, "verse_number": "१४-१००-१२", "content_sanskrit": "न मण्टपं सभा वाऽपि न प्रपा न निकेतनम्।\nन पर्वतो नदी वाऽपि न भूमेर्विवरं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103586, "chapter_id": 3244, "verse_number": "१४-१००-१३", "content_sanskrit": "न ग्रामो नाश्रमो वाऽपि नोद्यानं वा वनानि च।\nन किंचिदाश्रयस्थानं पथि तस्मिन्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103587, "chapter_id": 3244, "verse_number": "१४-१००-१४", "content_sanskrit": "जन्तोर्हि प्राप्तकालस्य वेदनार्तस्य वै भृशम्।\nकारणैस्त्यक्तदेहस्य प्राणैः कण्ठगतैः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103588, "chapter_id": 3244, "verse_number": "१४-१००-१५", "content_sanskrit": "शरीराच्चाल्यते जीवो ह्यवशो मातरिश्वना।\nनिर्गतो वायुभूतस्तु षट्कोशात्तु कलेवरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103589, "chapter_id": 3244, "verse_number": "१४-१००-१६", "content_sanskrit": "शरीरमन्यत्तद्रूपं तद्वर्णं तत्प्रमाणतः।\nअदृश्यं तत्प्रविष्टस्तु सोप्यदृष्टोऽथ केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103590, "chapter_id": 3244, "verse_number": "१४-१००-१७", "content_sanskrit": "सोन्तरात्मा देहवतामष्टाङ्गो यस्तु संचरेत्।\nछेदनाद्भेदनाद्दाहात्ताडनाद्वा न नश्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103591, "chapter_id": 3244, "verse_number": "१४-१००-१८", "content_sanskrit": "नाना रूपधरैर्घौरैः प्रचण्डेश्चण्डसाधनैः।\nनीयमानो दुराधर्षैर्यमदूतैर्यमाज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103592, "chapter_id": 3244, "verse_number": "१४-१००-१९", "content_sanskrit": "पुत्रदारमयैः पाशैः संनिरूद्धोऽवशो बलात्।\nस्वकर्मभिश्चानुगतः कृतैः सुकृतदुष्कृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103593, "chapter_id": 3244, "verse_number": "१४-१००-२०", "content_sanskrit": "आक्रन्दमानः करुणं बन्धुभिर्दुःखपीडितैः।\nत्यक्त्वा बन्धुजनं सर्वं निरपेक्षस्तु गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103594, "chapter_id": 3244, "verse_number": "१४-१००-२१", "content_sanskrit": "मातृभिः पितृभिश्चैव भ्रातृभिर्मातुलैस्तथा।\nदारैः पुत्रैर्वयस्यैश्च रुदद्भिस्त्यज्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103595, "chapter_id": 3244, "verse_number": "१४-१००-२२", "content_sanskrit": "अदृश्यमानस्तैर्दीनैरश्रुपूर्णमुखेक्षणैः।\nस्वशरीरं परित्यज्य वायुभूतस्तु गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103596, "chapter_id": 3244, "verse_number": "१४-१००-२३", "content_sanskrit": "अन्धकारमपारं तं महाघेरं तमोवृतम्।\nदुःखान्तं दुष्प्रतारं च दुर्गमं पापकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103597, "chapter_id": 3244, "verse_number": "१४-१००-२४", "content_sanskrit": "दुःसहायं दुरन्तं च दुर्निरीक्षं दुरासदम्।\nदुरापमतिदुःखं च पापिष्ठानां नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103598, "chapter_id": 3244, "verse_number": "१४-१००-२५", "content_sanskrit": "ऋषिभिः कथ्यमानं तत्पारंपर्येण पार्थिव।\nत्रासं जनचति प्रायः श्रूयमाणं कथास्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103599, "chapter_id": 3244, "verse_number": "१४-१००-२६", "content_sanskrit": "अवश्यं चैव गन्तव्यं तदध्वानं युधिष्ठिर।\nप्राप्तकालेन संत्यज्य बन्धून्भोगान्धनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103600, "chapter_id": 3244, "verse_number": "१४-१००-२७", "content_sanskrit": "जरायुजैरण्डजैश्च स्वेदजैरुद्भिदैस्तथा।\nजङ्गमैः स्थिरसंज्ञैश्च गन्तव्यं यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103601, "chapter_id": 3244, "verse_number": "१४-१००-२८", "content_sanskrit": "देवासुरैर्मनुष्याद्यैर्वैवस्वतवशानुगैः।\nस्त्रीपुंनपुंसकैश्चापि पृथिव्यां जीवसंज्ञितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103602, "chapter_id": 3244, "verse_number": "१४-१००-२९", "content_sanskrit": "मध्यमैर्युवभिर्वाऽपि बालैर्वृद्धैस्तथैव च।\nजातमात्रैश्च गर्भस्थैर्गन्तव्यः स महापथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103603, "chapter_id": 3244, "verse_number": "१४-१००-३०", "content_sanskrit": "पूर्वाह्णे वाऽपराह्णे वा सन्ध्याकालेऽथवा पुनः।\nप्रदोषे वाऽर्धरात्रे वा प्रत्युषे वाऽप्युपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103604, "chapter_id": 3244, "verse_number": "१४-१००-३१", "content_sanskrit": "प्रवासस्थैर्वनस्थैर्वा पर्वतस्थैर्जले स्थितैः।\nक्षेत्रस्थैर्वा नभःस्थेर्वा गृहमध्यगतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103605, "chapter_id": 3244, "verse_number": "१४-१००-३२", "content_sanskrit": "भुञ्जद्भिर्वा पिबद्भिर्वा खादद्भिर्वा नरोत्तम।\nआसीनैर्वा स्थितैर्वापि शयनीयगतैरपि।\nजाग्रद्भिर्वा प्रसुप्तैर्वा गन्तव्यः स महापथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103606, "chapter_id": 3244, "verse_number": "१४-१००-३३", "content_sanskrit": "मृत्युदूतैर्दुराधर्षैः प्रचण्डैश्चण्डसासनैः।\nआक्षिप्यमाणा ह्यवशाः प्रयान्ति यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103607, "chapter_id": 3244, "verse_number": "१४-१००-३४", "content_sanskrit": "क्वचिद्भीतैः क्वचिन्मत्तैः प्रस्खलद्भिः क्वचित्क्वचित्।\nक्रन्दद्भिर्वेदनार्तैस्तु गन्तव्यं यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103608, "chapter_id": 3244, "verse_number": "१४-१००-३५", "content_sanskrit": "निर्भर्त्स्यमानैरुद्विग्रैर्विधूतैर्भयविह्वलैः।\nतुद्यमानशरीरैश्च गन्तव्यं तर्जितैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103609, "chapter_id": 3244, "verse_number": "१४-१००-३६", "content_sanskrit": "कण्टकाकीर्णमार्गेण तप्तवालुकपांसुना।\nदह्यमानैस्तु गन्तव्यं नरैर्दानविवर्जितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103610, "chapter_id": 3244, "verse_number": "१४-१००-३७", "content_sanskrit": "काष्ठोपलशिलाघातैर्दण्डोल्मुककशाङ्कुशैः।\nहन्यमानैर्यमपुरं गन्तव्यं धर्मवर्जितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103611, "chapter_id": 3244, "verse_number": "१४-१००-३८", "content_sanskrit": "मेदःशोणितपूयाद्यैर्वक्त्रैर्गात्रैश्च सव्रणैः।\nदग्धक्षतजकीर्णैश्च गन्तव्यं जीवघातकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103612, "chapter_id": 3244, "verse_number": "१४-१००-३९", "content_sanskrit": "वेदनार्तैस्च कूजद्भिर्विक्रोशद्भिश्च विस्वरम्।\nवेदनार्तैः पतद्भिश्च गन्तव्यं जीवघातकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103613, "chapter_id": 3244, "verse_number": "१४-१००-४०", "content_sanskrit": "भग्रपादोरुहस्तङ्गैर्भग्रजङ्घाशिरोधरैः।\nछिन्नकर्णोष्ठनासैश्च गन्तव्यं जीवघातकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103614, "chapter_id": 3244, "verse_number": "१४-१००-४१", "content_sanskrit": "शक्तिभिर्भिण्डिपालैश्च शङ्कुतोमरसायकैः।\nतुद्यमानैस्तु शूलाग्रैर्गन्तव्यं जीवघातकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103615, "chapter_id": 3244, "verse_number": "१४-१००-४२", "content_sanskrit": "श्वभिर्व्याघ्रैर्वृकैः काकैर्भक्ष्यमाणाः समन्ततः।\nतुद्यमानाश्च गच्छन्ति राक्षसैर्मांसघातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103616, "chapter_id": 3244, "verse_number": "१४-१००-४३", "content_sanskrit": "महिषैश्च मृगैश्चापि सूकरैः पृषतैस्तथा।\nभक्ष्यमाणैस्तदध्वानं गन्तव्यं मांसखादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103617, "chapter_id": 3244, "verse_number": "१४-१००-४४", "content_sanskrit": "सूचीसुतीक्ष्णतुण्डाभिर्मक्षिकाभिः समन्ततः।\nतुद्यमानैश्च गन्तव्यं पापिष्ठैर्बालघातकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103618, "chapter_id": 3244, "verse_number": "१४-१००-४५", "content_sanskrit": "विस्रब्धं स्वामिनं मित्रं स्त्रियं वा घ्रन्ति ये नराः।\nशस्त्रैर्निर्भिद्यमानैश्च गन्तव्यं यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103619, "chapter_id": 3244, "verse_number": "१४-१००-४६", "content_sanskrit": "खादयन्ति च ये जीवान्दुःखमापादयन्ति च।\nराक्षसैश्च श्वभिश्चैव भक्ष्यमाणा व्रजन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103620, "chapter_id": 3244, "verse_number": "१४-१००-४७", "content_sanskrit": "ये हरन्ति च वस्त्राणि शय्यां प्रावरणानि च।\nते यान्ति विद्रुता नग्नाः पिशाचा इव तत्पथं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103621, "chapter_id": 3244, "verse_number": "१४-१००-४८", "content_sanskrit": "गाश्च धान्यं हिरण्यं वा बलात्क्षेत्रं गृहं तथा।\nये हरन्ति दुरात्मानः परस्वं पापकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103622, "chapter_id": 3244, "verse_number": "१४-१००-४९", "content_sanskrit": "पाषाणैरुल्मुकैर्दण्डैः काष्ठघातैश्च चर्झरैः।\nहन्यमानैः क्षताकीर्णैर्नन्तव्यं तैर्यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103623, "chapter_id": 3244, "verse_number": "१४-१००-५०", "content_sanskrit": "ब्रह्मस्वं ये हरन्तीह नरा नरकनिर्भयाः।\nआक्रोशन्तीह ये नित्यं प्रहरन्ति च ये द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103624, "chapter_id": 3244, "verse_number": "१४-१००-५१", "content_sanskrit": "शुष्ककण्ठा निबद्धास्ते छिन्नजिह्वाक्षिनासिकाः।\nपूयशोणितदुर्गन्धा भक्ष्यमाणाश्च जंबुकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103625, "chapter_id": 3244, "verse_number": "१४-१००-५२", "content_sanskrit": "चण्डालैर्भीषणैश्चण्डैस्तुद्यमानाः समन्ततः।\nक्रोशन्तः करुणं घोरं गच्छन्ति यमासादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103626, "chapter_id": 3244, "verse_number": "१४-१००-५३", "content_sanskrit": "तत्र चापि गताः पापा विष्ठाकूपेष्वनेकशः।\nजीवन्तो वर्षकोटीस्तु क्लिश्यन्ते वेदनात्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103627, "chapter_id": 3244, "verse_number": "१४-१००-५४", "content_sanskrit": "ततश्च मुक्ताः कालेन लोके चास्मिन्नराधमाः।\nविष्ठाक्रिमित्वं गच्छन्ति जन्मकोटिशतं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103628, "chapter_id": 3244, "verse_number": "१४-१००-५५", "content_sanskrit": "विद्यमानधनैर्यैस्तु लोभडंभानृतान्वितैः।\nश्रोत्रियेभ्यो न दत्तानि दानानि कुरुपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103629, "chapter_id": 3244, "verse_number": "१४-१००-५६", "content_sanskrit": "ग्रीवापाशनिबद्धास्ते हन्यमानाश्च राक्षसैः।\nक्षुत्पिपासाश्रमार्तास्तु यान्ति प्रेतपुरं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103630, "chapter_id": 3244, "verse_number": "१४-१००-५७", "content_sanskrit": "अदत्तदाना गच्छन्ति शुष्ककण्ठास्यतालुकाः।\nअन्नं पानीयसहितं प्रार्थयन्तः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103631, "chapter_id": 3244, "verse_number": "१४-१००-५८", "content_sanskrit": "स्वामिन्बुभक्षातृष्णार्ता गन्तुं नैवाद्य शक्नुमः।\nममान्नं दीयतां स्वामिन्पानीयं दीयतां मम।\nइति ब्रुवन्तस्तैर्दूतैः प्राप्यन्ते वै यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103632, "chapter_id": 3244, "verse_number": "१४-१००-५९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103633, "chapter_id": 3244, "verse_number": "१४-१००-५९", "content_sanskrit": "तच्छ्रुत्वा वचनं विष्णोः पपात भुवि पाण्डवः।\nनिस्संज्ञो भयसंत्रस्तो मूर्छया समभिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103634, "chapter_id": 3244, "verse_number": "१४-१००-६०", "content_sanskrit": "ततो लब्ध्वा शनैः संज्ञां समाश्वस्तोच्युतेन सः।\nनेत्रे प्रक्षाल्य तोयेन भूयः केशवमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103635, "chapter_id": 3244, "verse_number": "१४-१००-६१", "content_sanskrit": "भीतोस्म्यहं महादेव श्रुत्वा मार्गस्य विस्तरम्।\nकेनोपायेन तं मार्गं तरन्ति पुरुषाः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103636, "chapter_id": 3244, "verse_number": "१४-१००-६२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103637, "chapter_id": 3244, "verse_number": "१४-१००-६२", "content_sanskrit": "इह ये धार्मिका लोके जीवगातविवर्जिताः।\nगुरुशुश्रूषणे युक्ता देवब्राह्मणपूजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2103638, "chapter_id": 3244, "verse_number": "१४-१००-६३", "content_sanskrit": "अस्मान्मानुष्यलोकात्ते समार्याः सहबान्धवाः।\nयमध्वानं तु गच्छन्ति यथावत्तं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2103639, "chapter_id": 3244, "verse_number": "१४-१००-६४", "content_sanskrit": "ब्राह्मणेभ्यः प्रदानानि नानारूपाणि पाण्डव।\nये प्रयच्छन्ति विप्रेभ्यस्ते सुखं यान्ति तत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2103640, "chapter_id": 3244, "verse_number": "१४-१००-६५", "content_sanskrit": "अन्नं ये च प्रयच्छन्ति ब्राह्मणेभ्यः सुसंस्कृतम्।\nक्षोत्रियेभ्यो विशेषेण प्रीत्या परमया युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2103641, "chapter_id": 3244, "verse_number": "१४-१००-६६", "content_sanskrit": "ते विमानैर्महात्मानो यान्ति चित्रैर्यमालयम्।\nसेव्यमाना वरस्त्रीभिरप्सरोभिर्महापथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2103642, "chapter_id": 3244, "verse_number": "१४-१००-६७", "content_sanskrit": "ये च नित्यं प्रभाषन्ते सत्यं निष्कल्मषं वचः।\nते च यान्त्यमलाभ्राभैर्विमानैर्वृषयोजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2103643, "chapter_id": 3244, "verse_number": "१४-१००-६८", "content_sanskrit": "कपिलाद्यानि पुण्यानि गोप्रदानानि ये नराः।\nब्राह्मणेभ्यः प्रयच्छन्ति श्रोत्रियेभ्यो विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2103644, "chapter_id": 3244, "verse_number": "१४-१००-६९", "content_sanskrit": "ते यान्त्यमलवर्णाभैर्विमानैर्वृषयोजितैः।\nवैवस्वतपुरं प्राप्य ह्यप्सरोभिर्निषेविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2103645, "chapter_id": 3244, "verse_number": "१४-१००-७०", "content_sanskrit": "उपानहौ च च्छत्रं च शयनान्यासनानि च।\nविप्रेभ्यो ये प्रयच्छन्ति वस्त्राण्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2103646, "chapter_id": 3244, "verse_number": "१४-१००-७१", "content_sanskrit": "ते यान्त्यश्वैर्वृषैर्वाऽपि कुञ्जरैरप्यलङ्कृताः।\nधर्मराजपुरं रम्यं सौवर्णच्छत्रशोभिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2103647, "chapter_id": 3244, "verse_number": "१४-१००-७२", "content_sanskrit": "ये च भक्ष्याणि दास्यन्ति भोज्यं पेयं तथैव च।\nस्निग्धान्नान्यापि विप्रेभ्यः श्रद्धया परया युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2103648, "chapter_id": 3244, "verse_number": "१४-१००-७३", "content_sanskrit": "ते यान्ति काञ्चनार्यानैः सुखं वैवस्वतालयम्।\nवरस्त्रीभिर्यथाकामं सेव्यमानाः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2103649, "chapter_id": 3244, "verse_number": "१४-१००-७४", "content_sanskrit": "ये च क्षीरं प्रयच्छन्ति घृतं दधि गुडं मधु।\nब्राह्मणेभ्यः प्रयत्नेन श्रद्दधानाः सुसंस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2103650, "chapter_id": 3244, "verse_number": "१४-१००-७५", "content_sanskrit": "चक्रवाकप्रयुक्तैस्तु यानै रुक्ममयैः शुभैः।\nयान्ति गन्धर्ववादित्रैः सेव्यमाना यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2103651, "chapter_id": 3244, "verse_number": "१४-१००-७६", "content_sanskrit": "ये फलानि प्रयच्छन्ति पुष्पाणि सुरभीणि च।\nहंसयुक्तैर्विमानैस्तु यान्ति धर्मपुरं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2103652, "chapter_id": 3244, "verse_number": "१४-१००-७७", "content_sanskrit": "ये प्रयच्छन्ति विप्रेभ्यो विचित्रान्नं घृताप्लुतम्।\nते व्रजनत्यमलाभ्राभैर्विमानैर्वायुवेगिभिः।\nपुरं तत्प्रेतनाथस्य नानाजनसमाकुलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2103653, "chapter_id": 3244, "verse_number": "१४-१००-७८", "content_sanskrit": "पानीयं ये प्रयच्छन्ति सर्वभूतप्रजीवनम्।\nते सुतृप्ताः सुखं यान्ति भवनैर्हंसचोदितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2103654, "chapter_id": 3244, "verse_number": "१४-१००-७९", "content_sanskrit": "ये तिलं तिलधेनुं वा धृतधेनुमथापि च।\nश्रोत्रियेभ्यः प्रयच्छन्ति सौम्यभावसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2103655, "chapter_id": 3244, "verse_number": "१४-१००-८०", "content_sanskrit": "सूर्यमण्डलसंकाशैर्यानैस्ते यान्ति निर्मलैः।\nगीयमानैस्तु गन्धर्वैर्वैवस्वतपुरं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2103656, "chapter_id": 3244, "verse_number": "१४-१००-८१", "content_sanskrit": "येषां वाप्यश्च कूपाश्च तटाकानि सरांसि च।\nदीर्घिकाः पुष्करिण्यश्च सजलाश्च जलाशयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2103657, "chapter_id": 3244, "verse_number": "१४-१००-८२", "content_sanskrit": "यानैस्ते यान्ति चन्द्राभैर्दिव्यघण्टानिनादितैः।\nचामरैस्तालवृन्तैश्च वीज्यमाना महाप्रभाः।\nनित्यतृप्ता महात्मानो गच्छन्ति यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2103658, "chapter_id": 3244, "verse_number": "१४-१००-८३", "content_sanskrit": "येषां देवगृहाणीह चित्राण्यायतनानि च।\nमनोहराणि कान्तानि दर्शनीयानि भान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2103659, "chapter_id": 3244, "verse_number": "१४-१००-८४", "content_sanskrit": "ते व्रजन्त्यमलाभ्राभैर्विमानैर्वायुवेगिभिः।\nपुरं तत्प्रेतनाथस्य नानाजनपदाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2103660, "chapter_id": 3244, "verse_number": "१४-१००-८५", "content_sanskrit": "वैवस्वतं च पश्यन्ति सुखचित्तं सुखस्थितम्।\nयमेन पूजिता यान्ति देवसालोक्यतां ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2103661, "chapter_id": 3244, "verse_number": "१४-१००-८६", "content_sanskrit": "देवानुद्दिश्य लोकेषु प्रपासु करकोद्धृतम्।\nशीतलं सलिलं रम्यं तृषितेभ्यो दिशन्ति ये।\nते तु तृप्ति परां यान्ति प्राप्य सौख्यं महापथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2103662, "chapter_id": 3244, "verse_number": "१४-१००-८७", "content_sanskrit": "काष्ठपादुकदा यान्ति तदध्वानं सुखं नराः।\nसौवर्णमणिपीठे तु पादं कृत्वा स्थोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2103663, "chapter_id": 3244, "verse_number": "१४-१००-८८", "content_sanskrit": "आरामान्वृक्षषण्डांश्च रोपयन्ति च ये नराः।\nसंवर्धयन्ति चाव्यग्रं फलपुष्पोपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2103664, "chapter_id": 3244, "verse_number": "१४-१००-८९", "content_sanskrit": "वृक्षच्छायासु रम्यासु शीतलासु स्वलङ्कृताः।\nयान्ति ते वाहनैर्दिव्यैः पूज्यमाना मुहुर्मुहुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2103665, "chapter_id": 3244, "verse_number": "१४-१००-९०", "content_sanskrit": "सेव्यमानाः सुरूपाभिरुत्तमाभिः प्रयत्नतः।\nस्त्रीभिः कनकवर्णाभिर्यथाकामं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2103666, "chapter_id": 3244, "verse_number": "१४-१००-९१", "content_sanskrit": "अश्वयानं तु गोयानं हस्तियानमथापि च।\nये प्रयच्छन्ति विप्रेभ्यो विमानैः कनकोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2103667, "chapter_id": 3244, "verse_number": "१४-१००-९२", "content_sanskrit": "सुवर्णं रजतं वाऽपि विद्रुमं मौक्तिकं तथा।\nये प्रयच्छन्ति ते यान्ति विमानैः कनकोज्ज्वलैः।\nते व्रजन्ति वरस्त्रीभिः सेव्यमाना यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2103668, "chapter_id": 3244, "verse_number": "१४-१००-९३", "content_sanskrit": "भूमिदा यान्ति तं लोकं सर्वकामैः सुतर्पिताः।\nउदितादित्यसंकाशैर्विमानैर्वृषयोजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2103669, "chapter_id": 3244, "verse_number": "१४-१००-९४", "content_sanskrit": "कन्यां ये च प्रयच्छन्ति विप्राय श्रोत्रियाय च।\nदिव्यकन्यावृता यान्ति विमानैस्ते यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2103670, "chapter_id": 3244, "verse_number": "१४-१००-९५", "content_sanskrit": "सुगन्धान्गन्धसंयोगान्पुष्पाणि सुरभीणि च।\nप्रयच्छन्ति द्विजाग्रेभ्यो भक्तया परमया युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2103671, "chapter_id": 3244, "verse_number": "१४-१००-९६", "content_sanskrit": "सुगन्धाः धर्मपुरं यानैर्विचित्रैरप्यलङ्कृताः॥\nयान्ति धर्मपुरं यानैर्विचित्रैरप्यलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2103672, "chapter_id": 3244, "verse_number": "१४-१००-९७", "content_sanskrit": "दीपया यान्ति यानैश्च द्योतयन्तो दिशो दश।\nआदित्यसदृशाकारैर्दीप्यमाना इवाग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2103673, "chapter_id": 3244, "verse_number": "१४-१००-९८", "content_sanskrit": "गृहावसथदातारो गृहैः काञ्चनवेदिकैः।\nव्रजन्ति बालसूर्याभैर्धर्मराजपुरं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2103674, "chapter_id": 3244, "verse_number": "१४-१००-९९", "content_sanskrit": "जलभाजनदातारः कुण्डिकाकरकप्रदाः।\nपूज्यमाना वरस्त्रीभिर्यान्ति तृप्ता महागजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2103675, "chapter_id": 3244, "verse_number": "१४-१००-१००", "content_sanskrit": "पादाभ्यङ्गं शिरोभ्यह्गं पानं पादोदकं तथा।\nये प्रयच्छन्ति विप्रेभ्यस्ते यान्त्यश्वैर्यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2103676, "chapter_id": 3244, "verse_number": "१४-१००-१०१", "content_sanskrit": "विश्रामायन्ति ये विप्राञ्श्रान्तानध्वनि कर्शितान्।\nचक्रवाकप्रयुक्तेन यान्ति यानेन तेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2103677, "chapter_id": 3244, "verse_number": "१४-१००-१०२", "content_sanskrit": "स्वागतेन च यो विप्रान्पूजयेदासनेन च।\nस गच्छति तदध्वानं सुखं परमनिर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2103678, "chapter_id": 3244, "verse_number": "१४-१००-१०३", "content_sanskrit": "नमो ब्रह्मण्यदेवेति यो मां दृष्ट्वाऽभिवादयेत्।\nव्रतीवं प्रयतो नित्यं स सुखं तत्पदं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2103679, "chapter_id": 3244, "verse_number": "१४-१००-१०४", "content_sanskrit": "नमः सर्वसहाभ्यश्चेत्यभिख्याय दिनेदिने।\nनमस्करोति नित्यं गां स सुखं याति तत्पथं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2103680, "chapter_id": 3244, "verse_number": "१४-१००-१०५", "content_sanskrit": "नमोस्तु प्रियदत्तायेत्येवंवादी दिनेदिने।\nभूमिमाक्रमते प्रातः सयनादुत्थितश्च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2103681, "chapter_id": 3244, "verse_number": "१४-१००-१०६", "content_sanskrit": "सर्वकामैः स तृप्तात्मा सर्वभूषणभूषितः।\nयाति यानेन दिव्येन सुकं वैवस्वतालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2103682, "chapter_id": 3244, "verse_number": "१४-१००-१०७", "content_sanskrit": "अनत्तराशिनो ये तु डंभानृतविवर्जिताः।\nतेऽपि सारसयुक्तेन यान्ति यानेन वै सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2103683, "chapter_id": 3244, "verse_number": "१४-१००-१०८", "content_sanskrit": "ये चाप्येकेन भुक्तेन डंभानृतविवर्जिताः।\nहंसयुक्तैर्विमानैस्तु सुखं यान्ति यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2103684, "chapter_id": 3244, "verse_number": "१४-१००-१०९", "content_sanskrit": "चतुर्थेन च भुक्तेन वर्तन्ते ये जितेन्द्रियाः।\nयान्ति ते धर्मनगरं यानैर्बर्हिणयोजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2103685, "chapter_id": 3244, "verse_number": "१४-१००-११०", "content_sanskrit": "तृतीयदिवसेनेह भुञ्जते ये जितेन्द्रियाः।\nतेऽपि हस्तिरथं यान्ति तत्पथं कनकोज्ज्वलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2103686, "chapter_id": 3244, "verse_number": "१४-१००-१११", "content_sanskrit": "षष्ठान्नकालिको यस्तु वर्षमेकं तु वर्तते।\nकामक्रोधवनिर्मुक्तः शुचिर्नित्यं जितेन्द्रियः।\nस याति कुञ्जरस्थैस्तु जयशब्दरवैर्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2103687, "chapter_id": 3244, "verse_number": "१४-१००-११२", "content_sanskrit": "पक्षोपवासिनो यान्ति यानैः शार्दूलयोजितैः।\nधर्मराजपूरं रम्यं दिव्यस्त्रीगणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2103688, "chapter_id": 3244, "verse_number": "१४-१००-११३", "content_sanskrit": "ये च मासोपवासं वै कुर्वते संयतेन्द्रियाः।\nतेऽपि सूर्यादयप्रख्यैर्यान्ति यानैर्यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2103689, "chapter_id": 3244, "verse_number": "१४-१००-११४", "content_sanskrit": "अग्निप्रवेशं यश्चापि कुरुते मद्गतात्मना।\nस यात्यग्निप्रकाशेन विमानेन यमालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2103690, "chapter_id": 3244, "verse_number": "१४-१००-११५", "content_sanskrit": "गोकृते स्त्रीकृते चैव हत्वा विप्रकृतेऽपि च।\nते यान्त्यमरकन्याभिः सेव्यमाना रविप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2103691, "chapter_id": 3244, "verse_number": "१४-१००-११६", "content_sanskrit": "ये च कुर्वन्ति मद्भक्तास्तीर्थयात्रां जितेन्द्रियाः।\nते पन्थानं महात्मानो यानैर्यान्ति सुनिर्वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2103692, "chapter_id": 3244, "verse_number": "१४-१००-११७", "content_sanskrit": "ये यजन्ति द्विजश्रेष्ठाः क्रतुभिर्भूरिदक्षिणैः।\nहंससारससंयुक्तैर्यानैस्ते यान्ति तत्पथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2103693, "chapter_id": 3244, "verse_number": "१४-१००-११८", "content_sanskrit": "परपीडामकृत्वैव भृत्यान्बिभ्रति ये नराः।\nतत्पथं ससुखं यान्ति विमानैः काञ्चनोज्ज्वलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2103694, "chapter_id": 3244, "verse_number": "१४-१००-११९", "content_sanskrit": "ये समाः सर्वभूतेषु जीवानामभयप्रदाः।\nक्रोधलोभविनिर्मुक्ता निगृहीतेन्द्रियास्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2103695, "chapter_id": 3244, "verse_number": "१४-१००-१२०", "content_sanskrit": "पूर्णचन्द्रप्रतीकाशैर्विमानैस्ते महाप्रभाः।\nयान्ति वैवस्वतपुरं देवगन्धर्वसेविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2103696, "chapter_id": 3244, "verse_number": "१४-१००-१२१", "content_sanskrit": "ये मामेकान्तभावेन देवं त्र्यंबकमेव वा।\nपूजयन्ति नमस्यन्ति स्तुवन्ति च दिनेदिने।\nधर्मराजपुरं यान्ति यानैस्तेऽर्कसमप्रभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2103697, "chapter_id": 3244, "verse_number": "१४-१००-१२२", "content_sanskrit": "पूजितास्तत्र धर्मेण स्वयं माल्यादिभिः शुभैः।\nयान्त्येव धर्मलोकं वा रुद्रलोकमथापि वा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2103698, "chapter_id": 3244, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि शततमोऽध्यायः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}]