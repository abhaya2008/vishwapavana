[{"id": 7003972000, "chapter_id": 23972, "verse_number": "३-१-३५-१", "content_sanskrit": "यज्ञदेव उवाच ।\nदुर्वासर्षे महाप्राज्ञ परापरविचक्षण ।\nदुर्विनीताभिधः कोऽयं योऽसौ गुर्वंगनामगात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003972001, "chapter_id": 23972, "verse_number": "३-१-३५-२", "content_sanskrit": "कस्य पुत्रो धनुष्कोटौ स्नानेन स कथं द्विजः ।\nतत्क्षणान्मुमुचे पापाद्गुरुस्त्रीगमसंभवात् ।\nएतन्मे श्रद्धधानस्य विस्तराद्वक्तुमर्हसि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003972002, "chapter_id": 23972, "verse_number": "३-१-३५-३", "content_sanskrit": "दुर्वासा उवाच ।\nपांड्यदेशे पुरा कश्चिद्ब्राह्मणोभूद्बहुश्रुतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003972003, "chapter_id": 23972, "verse_number": "३-१-३५-४", "content_sanskrit": "इध्मवाहाभिधो नाम्ना तस्य भार्या रुचिंस्तथा ।\nबभूव तस्य तनयो दुर्विनीताभिधो द्विजः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003972004, "chapter_id": 23972, "verse_number": "३-१-३५-५", "content_sanskrit": "बाल्ये वयसि पुत्रस्य ममार जनकोऽस्य॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003972005, "chapter_id": 23972, "verse_number": "३-१-३५-६", "content_sanskrit": "दुर्विनीतः पितुस्तस्य स कृत्वा चौर्ध्वदैहिकम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003972006, "chapter_id": 23972, "verse_number": "३-१-३५-७", "content_sanskrit": "कंचित्कालं गृहेऽवात्सीन्मात्रा विधवया सह ।\nततो दुर्भिक्षमभवद्वादशाब्दमवर्षणात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003972007, "chapter_id": 23972, "verse_number": "३-१-३५-८", "content_sanskrit": "ततो देशांतरमगान्मात्रा साकं द्विजोत्तम ।\nगोकर्णं स समासाद्य सुभिक्षं धान्यसंचयैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003972008, "chapter_id": 23972, "verse_number": "३-१-३५-९", "content_sanskrit": "उवास सुचिरं कालं मात्रा विधवया सह ।\nततो बहुतिथे काले दुर्विनीतो गते सति॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003972009, "chapter_id": 23972, "verse_number": "३-१-३५-१०", "content_sanskrit": "पूर्वदुष्कर्मपाकेन मूढबुद्धिरहो बत ।\nअनंगशरविद्धांगो रागाद्विकृतमानसः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003972010, "chapter_id": 23972, "verse_number": "३-१-३५-११", "content_sanskrit": "मामेति वादिनीमंबां बलादाकृष्य पातकी ।\nबुभुजे काममोहात्मा मैथुनेन द्विजोत्तम॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003972011, "chapter_id": 23972, "verse_number": "३-१-३५-१२", "content_sanskrit": "स खिन्नो दुर्विनीतोऽयं रेतःसेकादनंतरम् ।\nमनसा चिंतयन्पापं रुरोदभृशदुःखितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003972012, "chapter_id": 23972, "verse_number": "३-१-३५-१३", "content_sanskrit": "अहोतिपापकृदहं महापातकिनां वरः ।\nअगमं जननीं यस्मात्कामबाणवशानुगः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003972013, "chapter_id": 23972, "verse_number": "३-१-३५-१४", "content_sanskrit": "इति संचित्य मनसा स तत्र मुनिसन्निधौ ।\nजुगुप्तमानश्चात्मानं तान्मुनीनिदमब्रवीत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003972014, "chapter_id": 23972, "verse_number": "३-१-३५-१५", "content_sanskrit": "गुरुस्त्रीगमपापस्य प्रायश्चित्तं ममद्विजाः ।\nवदध्वं शास्त्रतत्त्वज्ञाः कृपया मयि केवलम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003972015, "chapter_id": 23972, "verse_number": "३-१-३५-१६", "content_sanskrit": "मरणान्निष्कृतिः स्याच्चेन्मरिष्यामि न संशयः ।\nभवद्भिरुच्यते यत्तु प्रायश्चित्तं ममाधुना॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003972016, "chapter_id": 23972, "verse_number": "३-१-३५-१७", "content_sanskrit": "करिष्ये तद्द्विजाः सत्यं मरणं वान्यदैव वा ।\nतच्छ्रुत्वा वचनं तस्य केचित्तत्रमुनीश्वराः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003972017, "chapter_id": 23972, "verse_number": "३-१-३५-१८", "content_sanskrit": "अनेन साकं वार्ता तु दोषायेति विनिश्चिताः ।\nमौनित्वं भेजिरे केचिन्मुनयः केचिदा भृशम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003972018, "chapter_id": 23972, "verse_number": "३-१-३५-१९", "content_sanskrit": "दुष्टात्मा मातृगामी त्वं महापातकिनां वरः ।\nगच्छगच्छेतिबहुशो वाचमूचुर्द्विजोत्तमाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003972019, "chapter_id": 23972, "verse_number": "३-१-३५-२०", "content_sanskrit": "तान्निवार्य कृपाशीलः सर्वज्ञः करुणानिधिः ।\nकृष्णद्वैपायनस्तत्र दुर्विनीतमभाषत॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003972020, "chapter_id": 23972, "verse_number": "३-१-३५-२१", "content_sanskrit": "गच्छाशु रामसेतौ त्वं धनुष्कोटौ सहांबया ।\nमकरस्थे रवौ माघे मासमेकं निरंतरम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003972021, "chapter_id": 23972, "verse_number": "३-१-३५-२२", "content_sanskrit": "जितेंद्रियो जितक्रोधः परद्रोहविवर्जितः ।\nएकमासं निराहारः कुरु स्नानं सहांबया॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003972022, "chapter_id": 23972, "verse_number": "३-१-३५-२३", "content_sanskrit": "पूतो भविष्यस्यद्धा गुरुस्त्री गमदोषतः ।\nयत्पातकं न नश्येत सेतुस्नानेन तन्नहि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003972023, "chapter_id": 23972, "verse_number": "३-१-३५-२४", "content_sanskrit": "श्रुतिस्मृतिपुराणेषु धनुष्कोटिप्रशंसनम् ।\nबहुधा भण्यते पंचमहापातकनाशनम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003972024, "chapter_id": 23972, "verse_number": "३-१-३५-२५", "content_sanskrit": "तस्मात्त्वं त्वरया गच्छ धनुष्कोटिं सहांबया ।\nप्रमाणं कुरु मद्वाक्यं वेदवाक्यमिव द्विज॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003972025, "chapter_id": 23972, "verse_number": "३-१-३५-२६", "content_sanskrit": "श्रीरामधनुषः कोटौ स्नातस्य द्विज पुत्रक ।\nमहापातककोट्योपि नैव लक्ष्या इतीव हि॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003972026, "chapter_id": 23972, "verse_number": "३-१-३५-२७", "content_sanskrit": "प्रायश्चित्तांतरं प्रोक्तं मन्वादिस्मृतिभिः स्मृतौ ।\nतद्गच्छत्वं धनुष्कोटिं महापातक नाशिनीम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003972027, "chapter_id": 23972, "verse_number": "३-१-३५-२८", "content_sanskrit": "इतीरितोऽथ व्यासेन दुर्विनीतोद्विजोत्तमाः ।\nमात्रा साकं धनुष्कोटिं नत्वा व्यासं च निर्ययौ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003972028, "chapter_id": 23972, "verse_number": "३-१-३५-२९", "content_sanskrit": "मकरस्थे रवौ माघे मासमात्रं निरंतरम् ।\nमात्रा सह निराहारो जितक्रोधो जितेंद्रियः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003972029, "chapter_id": 23972, "verse_number": "३-१-३५-३०", "content_sanskrit": "श्रीरामधनुषः कोटौ सस्नौ संकल्पपूर्वकम् ।\nरामनाथं नमस्कुर्वं स्त्रिकालं भक्तिपूर्वकम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003972030, "chapter_id": 23972, "verse_number": "३-१-३५-३१", "content_sanskrit": "मासांते पारणां कृत्वा मात्रा सह विशुद्धधीः ।\nव्यासांतिकं पुनः प्रायात्तस्मै वृत्तं निवेदितुम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003972031, "chapter_id": 23972, "verse_number": "३-१-३५-३२", "content_sanskrit": "स प्रणम्य पुनर्व्यासं दुर्विनीतोऽब्रवीद्वचः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003972032, "chapter_id": 23972, "verse_number": "३-१-३५-३३", "content_sanskrit": "दुर्विनीत उवाच ।\nभगवन्करुणासिंधो द्वैपायन महत्तम ।\nभवतः कृपया रामधनुष्कोटौ सहांबया ।\nमाघमासे निराहारो मासमात्रमतंद्रितः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003972033, "chapter_id": 23972, "verse_number": "३-१-३५-३४", "content_sanskrit": "अहं त्वकरवं स्नानं नमस्कुर्वन्महेश्वरम् ।\nइतः परं मया व्यास भगवन्भक्तवत्सल॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003972034, "chapter_id": 23972, "verse_number": "३-१-३५-३५", "content_sanskrit": "यत्कर्त्तव्यं मुने तत्त्वं ममोपदिश तत्त्वतः ।\nइति तस्य वचः श्रुत्वा दुर्विनीतस्य वै मुनिः ।\nबभाषे दुर्विनीतं तं व्यासो नारायणांशकः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003972035, "chapter_id": 23972, "verse_number": "३-१-३५-३६", "content_sanskrit": "व्यास उवाच ।\nदुर्विनीत गतं तेऽद्य पातकं मातृसंगजम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003972036, "chapter_id": 23972, "verse_number": "३-१-३५-३७", "content_sanskrit": "मातुश्च पातकं नष्टं त्वत्संगतिनिमि त्तजम् ।\nसंदेहो नात्र कर्तव्यः सत्यमुक्तं मया तव॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003972037, "chapter_id": 23972, "verse_number": "३-१-३५-३८", "content_sanskrit": "बांधवाः स्वजनाः सर्वे तथान्ये ब्राह्मणाश्च ये ।\nसर्वे त्वां संग्रहीष्यंति दुर्विनीतां बया सह॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003972038, "chapter_id": 23972, "verse_number": "३-१-३५-३९", "content_sanskrit": "मत्प्रसादाद्धनुष्कोटौ विशुद्धस्त्वं निमज्जनात् ।\nदारसंग्रहणं कृत्वा गार्हस्थ्यं धर्ममाचर॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003972039, "chapter_id": 23972, "verse_number": "३-१-३५-४०", "content_sanskrit": "त्यज त्वं प्राणिहिंसां च धर्मं भज सनातनम् ।\nसेवस्व सज्जनान्नित्यं भक्तियुक्तेन चेतसा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003972040, "chapter_id": 23972, "verse_number": "३-१-३५-४१", "content_sanskrit": "संध्योपासनमुख्यानि नित्यकर्माणि न त्यज ।\nनिगृहीष्वेन्द्रियग्राममर्चयस्व हरं हरिम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003972041, "chapter_id": 23972, "verse_number": "३-१-३५-४२", "content_sanskrit": "परापवादं मा ब्रूया मासूयां भज कर्हिचित् ।\nअन्यस्याभ्युदयं दृष्ट्वा संतापं कृणु मा वृथा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003972042, "chapter_id": 23972, "verse_number": "३-१-३५-४३", "content_sanskrit": "मातृवत्परदा रांश्च त्वन्नित्यमवलोकय ।\nअधीतवेदानखिलान्माविस्मर कदाचन॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003972043, "chapter_id": 23972, "verse_number": "३-१-३५-४४", "content_sanskrit": "अतिथीन्मावमन्यस्व श्राद्धं पितृदिने कुरु ।\nपैशून्यं मा वदस्व त्वं स्वप्नेऽप्यन्स्य कर्हिचित्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003972044, "chapter_id": 23972, "verse_number": "३-१-३५-४५", "content_sanskrit": "इतिहासपुराणानि धर्मशास्त्राणि संततम् ।\nअवलोकय वेदांतं वेदांगानि तथा पुनः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003972045, "chapter_id": 23972, "verse_number": "३-१-३५-४६", "content_sanskrit": "हरिशंकरना मानि मुक्तलज्जोऽनुकीर्त्तय ।\nजाबालोपनिषन्मंत्रैस्त्रिपुंड्रोद्धूलनं कुरु॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003972046, "chapter_id": 23972, "verse_number": "३-१-३५-४७", "content_sanskrit": "रुद्राक्षान्धारय सदा शौचाचारपरो भव ।\nतुलस्या बिल्वपत्रैश्च नारायणहरावुभौ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003972047, "chapter_id": 23972, "verse_number": "३-१-३५-४८", "content_sanskrit": "एकं कालं द्विकालं वा त्रिकालं चार्चयस्य भोः ।\nतुलसीदलसंमिश्रं सिक्तं पादोदकेन च॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003972048, "chapter_id": 23972, "verse_number": "३-१-३५-४९", "content_sanskrit": "नैवेद्यान्नं सदा भुंक्ष्व शंभुनारायणाग्रतः ।\nकुरु त्वं वैश्वदेवाख्यं बलिमन्नविशुद्धये॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003972049, "chapter_id": 23972, "verse_number": "३-१-३५-५०", "content_sanskrit": "यतीश्वरान्ब्रह्मनिष्ठान्तर्पयान्नैर्गृहागतान् ।\nवृद्धानन्याननाथांश्च रोगिणो ब्रह्मचारिणः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003972050, "chapter_id": 23972, "verse_number": "३-१-३५-५१", "content_sanskrit": "कुरु त्वं मातृशुश्रूषामौपासनपरो भव ।\nपंचाक्षरं महामंत्रं प्रणवेन समन्वितम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003972051, "chapter_id": 23972, "verse_number": "३-१-३५-५२", "content_sanskrit": "तथैवाष्टाक्षरं मंत्रमन्यमंत्रानपि द्विज ।\nजप त्वं प्रयतो भूत्वा ध्यायन्मंत्राधिदेवताः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003972052, "chapter_id": 23972, "verse_number": "३-१-३५-५३", "content_sanskrit": "एवमन्यांस्तथा धर्मान्स्मृत्युक्तान्त्सर्वदा कुरु ।\nएवं कृतव्रतस्ते स्याद्देहांते मुक्तिरप्यलम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003972053, "chapter_id": 23972, "verse_number": "३-१-३५-५४", "content_sanskrit": "इत्युक्तो व्यासमुनिना दुर्विनीतः प्रणम्य तम् ।\nतदुक्तमखिलं कृत्वा देहांते मुक्तिमाप्तवान्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003972054, "chapter_id": 23972, "verse_number": "३-१-३५-५५", "content_sanskrit": "तन्मातापि मृता काले धनुष्कोटिनिमज्जनात ।\nअवाप परमां मुक्तिमपुनर्भवदायिनीम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003972055, "chapter_id": 23972, "verse_number": "३-१-३५-५६", "content_sanskrit": "दुर्वासा उवाच ।\nएवं ते दुर्विनीतस्य तन्मातुश्च विमोक्षणम् ।\nधनुष्कोट्यभिषेकेण यज्ञदेव मयेरितम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003972056, "chapter_id": 23972, "verse_number": "३-१-३५-५७", "content_sanskrit": "पुत्रमेनं त्वमप्याशु ब्रह्महत्याविशुद्धये ।\nसमादाय व्रज ब्रह्मन्धनुष्कोटिं विमुक्तिदाम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003972057, "chapter_id": 23972, "verse_number": "३-१-३५-५८", "content_sanskrit": "सिंधुद्वीप उवाच ।\nइति दुर्वाससा प्रोक्तो यज्ञदेवो निजं सुतम् ।\nसमादाय ययौ राम धनुष्कोटिं विमुक्तिदाम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003972058, "chapter_id": 23972, "verse_number": "३-१-३५-५९", "content_sanskrit": "गत्वा निवासमकरोत्षण्मासं तत्र स द्विजः ।\nपुत्रेण साकं नियतो हे सृगालप्लवंगमौ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003972059, "chapter_id": 23972, "verse_number": "३-१-३५-६०", "content_sanskrit": "स सस्नौ च धनुष्कोटौ षण्मासं वै स पुत्रकः ।\nषण्मासांते यज्ञदेवं प्राह वागशरीरिणी॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003972060, "chapter_id": 23972, "verse_number": "३-१-३५-६१", "content_sanskrit": "विमुक्ता यज्ञदेवस्य ब्रह्महत्या सुतस्य ते ।\nस्वर्णस्तेयात्सुरापानात्किरातीसंगमात्तथा॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003972061, "chapter_id": 23972, "verse_number": "३-१-३५-६२", "content_sanskrit": "अन्येभ्योपि हि पापेभ्यो विमुक्तोयं सुतस्तव ।\nसंशयं मा कुरुष्व त्वं यज्ञदेव द्विजोत्तम॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003972062, "chapter_id": 23972, "verse_number": "३-१-३५-६३", "content_sanskrit": "इत्युक्त्वा विररामाथ सा तु वाग शरीरिणी ।\nतदाऽशरीरिणीवाक्यं यज्ञदेवः स शुश्रुवान्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003972063, "chapter_id": 23972, "verse_number": "३-१-३५-६४", "content_sanskrit": "संतुष्टः पुत्रसहितो रामनाथं निषेव्य च ।\nधनुष्कोटिं नमस्कृत्य पुत्रेण सहि तस्तदा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003972064, "chapter_id": 23972, "verse_number": "३-१-३५-६५", "content_sanskrit": "स्वदेशं प्रययौ हृष्टः स्वग्रामं स्वगृहं तथा ।\nसपुत्रदारः सुचिरं सुखमास्ते सुनिर्वृतः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003972065, "chapter_id": 23972, "verse_number": "३-१-३५-६६", "content_sanskrit": "सिन्धुद्वीप उवाच ।\nगोमायुवानरावेवं युवयोः कथितं मया ।\nयज्ञदेवसुतस्यास्य सुमतेः परिमोक्षणम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003972066, "chapter_id": 23972, "verse_number": "३-१-३५-६७", "content_sanskrit": "पातकेभ्यो महद्भ्यश्च धनुष्कोटौ निमज्जनात् ।\nयुवामतो धनुष्कोटिं गच्छतं पापशुद्धये ।\nनान्यथा पापशुद्धिः स्यात्प्रायश्चित्तायुतैरपि॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003972067, "chapter_id": 23972, "verse_number": "३-१-३५-६८", "content_sanskrit": "श्रीसूत उवाच ।\nसिन्धुद्वीपस्य वचनमिति श्रुत्वा द्विजो त्तमाः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003972068, "chapter_id": 23972, "verse_number": "३-१-३५-६९", "content_sanskrit": "सृगालवानरावाशु विलंघितमहापथौ ।\nधनुष्कोटिं प्रयासेन गत्वा स्नात्वा च तज्जले॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003972069, "chapter_id": 23972, "verse_number": "३-१-३५-७०", "content_sanskrit": "विमुक्तौ सर्वपापेभ्यो विमानवरसंस्थितौ ।\nदेवैः कुसुमवर्षेण कीर्यमाणौ सुतेजसौ॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003972070, "chapter_id": 23972, "verse_number": "३-१-३५-७१", "content_sanskrit": "हारकेयूरमुकुटकटकादिविभूषितौ ।\nदेवस्त्रीधूयमानाभ्यां चामराभ्यां विराजितौ ।\nगत्वा देवपुरीं रम्यामिंद्र स्यार्द्धासनं गतौ॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003972071, "chapter_id": 23972, "verse_number": "३-१-३५-७२", "content_sanskrit": "श्रीसूत उवाच ।\nयुष्माकमेवं कथितं सृगालस्य कपेरपि॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003972072, "chapter_id": 23972, "verse_number": "३-१-३५-७३", "content_sanskrit": "पापाद्विमोक्षणं विप्रा धनुष्कोटौ निमजनात् ।\nभक्त्या य इममध्यायं शृणोति पठतेऽपि वा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003972073, "chapter_id": 23972, "verse_number": "३-१-३५-७४", "content_sanskrit": "स्नानजं फलमाप्नोति धनुष्कोटौ स मानवः ।\nयोगिवृंदैरसुलभां मुक्तिमप्याशु विंदति॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]