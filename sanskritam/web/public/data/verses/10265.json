[{"id": 6000265000, "chapter_id": 10265, "verse_number": null, "content_sanskrit": "अथ एकोनसप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "सुदर्शनचक्रं सुदक्षिणं काशीं दग्ध्वा", "range": null}]}, {"id": 6000265001, "chapter_id": 10265, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.001.m4a", "display_order": 2}, {"id": 6000265002, "chapter_id": 10265, "verse_number": "१०-६९-१", "content_sanskrit": "पौण्ड्रको नाम राजा वै तस्मिन् काले कुरूद्वह।\nद्वारकां वृष्णिनिलयां निरुध्य बहुसैनिकः॥ १०/६९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.002.m4a", "display_order": 3, "topics": [{"text": "पौण्ड्रकवृत्तान्तः", "range": "१–१०"}]}, {"id": 6000265003, "chapter_id": 10265, "verse_number": "१०-६९-२", "content_sanskrit": "मर्दयामास कृष्णेन विदित्वा रहितां निशि।\nतं कामपालः शैनेयो वसुदेवोद्धवादयः॥ १०/६९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.003.m4a", "display_order": 4}, {"id": 6000265004, "chapter_id": 10265, "verse_number": "१०-६९-३", "content_sanskrit": "उग्रसेनश्च कौरव्य ये चान्ये यदुपुङ्गवाः।\nतर्पयामासुरायान्तं कालयोग्यमिवातिथिम्॥ १०/६९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.004.m4a", "display_order": 5}, {"id": 6000265005, "chapter_id": 10265, "verse_number": null, "content_sanskrit": "राजोवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.005.m4a", "display_order": 6}, {"id": 6000265006, "chapter_id": 10265, "verse_number": "१०-६९-४", "content_sanskrit": "कश्चासौ पौण्ड्रको नाम कस्मिन् देशे महीपतिः।\nकस्य वा तनयो ब्रह्मन् सर्वमेतद् वदस्व मे॥ १०/६९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.006.m4a", "display_order": 7}, {"id": 6000265007, "chapter_id": 10265, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.007.m4a", "display_order": 8}, {"id": 6000265008, "chapter_id": 10265, "verse_number": "१०-६९-५", "content_sanskrit": "अपुत्रः काशिराजो वै कन्यां सुतनुसञ्ज्ञिताम्।\nप्रायच्छद् वसुदेवाय राज्यशुल्कां कुरूद्वह॥ १०/६९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.008.m4a", "display_order": 9}, {"id": 6000265009, "chapter_id": 10265, "verse_number": "१०-६९-६", "content_sanskrit": "तत्र जज्ञे महाबाहुर्दिवाकरसमद्युतिः।\nकुमारः पौण्ड्रको नाम बलवीर्यमदान्वितः॥ १०/६९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.009.m4a", "display_order": 10}, {"id": 6000265010, "chapter_id": 10265, "verse_number": "१०-६९-७", "content_sanskrit": "वसुदेवसुतत्वाच्च वासुदेवेति शब्दितः।\nजाते तस्मिन् महाराजो वसुदेवो महाद्युतिः॥ १०/६९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.010.m4a", "display_order": 11}, {"id": 6000265011, "chapter_id": 10265, "verse_number": "१०-६९-८", "content_sanskrit": "राज्यं तस्मिन् समारोप्य सकोशबलवाहनम्।\nउवाह कंसावरजां देवकीं देवतोपमाम्॥ १०/६९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.011.m4a", "display_order": 12}, {"id": 6000265012, "chapter_id": 10265, "verse_number": "१०-६९-९", "content_sanskrit": "निरुद्धो भोजराजेन कंसेनानकदुन्दुभिः।\nकदाचिदपि न प्रायात् करवीरपुरीमपि॥ १०/६९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.012.m4a", "display_order": 13}, {"id": 6000265013, "chapter_id": 10265, "verse_number": "१०-६९-१०", "content_sanskrit": "असह्यं मातृसापत्न्यमभ्रातृत्वं तथाऽऽत्मनः।\nस्मरमाणः स काशीशो यदूनुद्विजतेऽनिशम्॥ १०/६९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.013.m4a", "display_order": 14}, {"id": 6000265014, "chapter_id": 10265, "verse_number": "१०-६९-११", "content_sanskrit": "स कृष्णरहितां श्रुत्वा समेत्य द्वारकां निशि।\nविमृद्य बलभद्रेण शैनेयेनापि निर्जितः॥ १०/६९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.014.m4a", "display_order": 15, "topics": [{"text": "अहमेव नारायणः इति वदन् पौण्ड्रक चतुर्भुजः सन् कृष्णेन युयोध", "range": "११–३३"}]}, {"id": 6000265015, "chapter_id": 10265, "verse_number": "१०-६९-१२", "content_sanskrit": "निहतानेकसाहस्रहयकुञ्जरसैनिकः।\nजगाम परशर्वर्यां पुरीं वाराणसीं नृप॥ १०/६९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.015.m4a", "display_order": 16}, {"id": 6000265016, "chapter_id": 10265, "verse_number": "१०-६९-१३", "content_sanskrit": "प्रभातायां तु शर्वर्यां हरिर्बदरिकाश्रमात्।\nआययौ तार्क्ष्यमारुह्य द्वारकां रामपालिताम्॥ १०/६९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.016.m4a", "display_order": 17}, {"id": 6000265017, "chapter_id": 10265, "verse_number": "१०-६९-१४", "content_sanskrit": "सपताकैः सार्ध्यपाद्यैर्यदुवृष्ण्यन्धकादिभिः।\nअभिवर्णितवृत्तान्तः प्राविशत् केशवः सभाम्॥ १०/६९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.017.m4a", "display_order": 18}, {"id": 6000265018, "chapter_id": 10265, "verse_number": "१०-६९-१५", "content_sanskrit": "कदाचित् पौण्ड्रको नाम काशिराजः प्रतापवान्।\nवासुदेवोऽहमित्यज्ञो दूतं कृष्णाय प्राहिणोत्॥ १०/६९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.018.m4a", "display_order": 19}, {"id": 6000265019, "chapter_id": 10265, "verse_number": "१०-६९-१६", "content_sanskrit": "त्वं वासुदेवो भगवानवतीर्णो जगत्पतिः।\nइति प्रस्तोभितो बालैर्मेने स्वात्मानमच्युतम्॥ १०/६९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.019.m4a", "display_order": 20}, {"id": 6000265020, "chapter_id": 10265, "verse_number": "१०-६९-१७", "content_sanskrit": "दूतस्तु द्वारकामेत्य सभायामास्थितं हरिम्।\nकृष्णं कमलपत्राक्षं राजसन्देशमब्रवीत्॥ १०/६९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.020.m4a", "display_order": 21}, {"id": 6000265021, "chapter_id": 10265, "verse_number": "१०-६९-१८", "content_sanskrit": "वासुदेवोऽवतीर्णोऽहमेक एव न चापरः।\nभूतानामनुकम्पार्थं त्वं तु मिथ्याभिधां त्यज॥ १०/६९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.021.m4a", "display_order": 22}, {"id": 6000265022, "chapter_id": 10265, "verse_number": "१०-६९-१९", "content_sanskrit": "यानि त्वमस्मच्चिह्नानि मौढ्याद् बिभर्ष्यभीतवत्।\nत्यक्त्वैहि मा त्वं शरणं नो चेद् देहि ममाहवम्॥ १०/६९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.022.m4a", "display_order": 23}, {"id": 6000265023, "chapter_id": 10265, "verse_number": "१०-६९-२०", "content_sanskrit": "कत्थनं तदुपाकर्ण्य पौण्ड्रकस्याल्पमेधसः।\nउच्चकैरुग्रसेनाद्याः सभ्याः प्रजहसुस्तदा॥ १०/६९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.023.m4a", "display_order": 24}, {"id": 6000265024, "chapter_id": 10265, "verse_number": "१०-६९-२१", "content_sanskrit": "उवाच दूतं भगवान् परिहासकथामनु।\nउत्स्रक्ष्ये मूढ चिह्नानि यैस्त्वमेवं विकत्थसे॥ १०/६९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.024.m4a", "display_order": 25}, {"id": 6000265025, "chapter_id": 10265, "verse_number": "१०-६९-२२", "content_sanskrit": "मुखं तव विधायाज्ञ कङ्कगृध्रबलैर्वृतम्।\nशयिष्यसे हतस्तत्र भविता शरणं शुनाम्॥ १०/६९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.025.m4a", "display_order": 26}, {"id": 6000265026, "chapter_id": 10265, "verse_number": "१०-६९-२३", "content_sanskrit": "इति दूतस्तदाक्षेपं स्वामिने सर्वमाहरत्।\nकृष्णोऽपि रथमारुह्य प्रायात् काशीं ससैनिकः॥ १०/६९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.026.m4a", "display_order": 27}, {"id": 6000265027, "chapter_id": 10265, "verse_number": "१०-६९-२४", "content_sanskrit": "पौण्ड्रकोऽपि तदुद्योगमुपलभ्य महारथः।\nअक्षौहिणीभिः सहितो निश्चक्राम पुराद् द्रुतम्॥ १०/६९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.027.m4a", "display_order": 28}, {"id": 6000265028, "chapter_id": 10265, "verse_number": "१०-६९-२५", "content_sanskrit": "तमायान्तं रथोपस्थे सुवर्णगरुडे स्थितम्।\nसुवर्णबाहुयुगलमपश्यत् पौण्ड्रकं हरिः॥ १०/६९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.028.m4a", "display_order": 29}, {"id": 6000265029, "chapter_id": 10265, "verse_number": "१०-६९-२६", "content_sanskrit": "शङ्खार्यसिगदाशार्ङ्गं श्रीवत्साद्युपलक्षितम्।\nबिभ्राणं कौस्तुभमणिं वनमालाविभूषितम्॥ १०/६९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.029.m4a", "display_order": 30}, {"id": 6000265030, "chapter_id": 10265, "verse_number": "१०-६९-२७", "content_sanskrit": "कौशेयवाससी पीते वसानं गरुडध्वजम्।\nआमुक्तमाल्याभरणं स्फुरन्मकरकुण्डलम्॥ १०/६९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.030.m4a", "display_order": 31}, {"id": 6000265031, "chapter_id": 10265, "verse_number": "१०-६९-२८", "content_sanskrit": "दृष्ट्वा तमात्मनाऽसाम्यं कृत्रिमाकारमास्थितम्।\nयथा नटं रङ्गगतं विजहास भृशं हरिः॥ १०/६९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.031.m4a", "display_order": 32}, {"id": 6000265032, "chapter_id": 10265, "verse_number": "१०-६९-२९", "content_sanskrit": "क्षणेन तं काशिपतेः सैनिका दृढधन्विनः।\nशरैराच्छादयामासुर्मेघाः शैलमिवाम्भसा॥ १०/६९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.032.m4a", "display_order": 33}, {"id": 6000265033, "chapter_id": 10265, "verse_number": "१०-६९-३०", "content_sanskrit": "केचिद् राजन् रथानश्वानास्थाय रणमूर्धनि। शूलैर्गदाभिः परिघैः शक्त्यृष्टिप्रासतोमरैः।\nअसिभिः पट्टसैर्बाणैः प्रहरन्नरयो हरिम्॥ १०/६९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.033.m4a", "display_order": 34}, {"id": 6000265034, "chapter_id": 10265, "verse_number": "१०-६९-३१", "content_sanskrit": "तस्य काशिपतेर्मित्रं पार्ष्णिग्राहोऽपरो नृपः।\nअक्षौहिणीभिस्तिसृभिरुपायान्नृप सङ्गरम्॥ १०/६९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.034.m4a", "display_order": 35}, {"id": 6000265035, "chapter_id": 10265, "verse_number": "१०-६९-३२", "content_sanskrit": "कृष्णस्तु तत्पौण्ड्रककाशिराजयोर्बलं गजस्यन्दनवाजिपत्तिमत्।\nगदासिचक्रेषुभिरार्दयद् भृशं यथा युगान्ते हुतभुक् प्रभाज्वलन्॥ १०/६९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.035.m4a", "display_order": 36}, {"id": 6000265036, "chapter_id": 10265, "verse_number": "१०-६९-३३", "content_sanskrit": "आयोधनं तद् रथवाजिकुञ्जरद्विपत्खरोष्ट्रैरिषुणाऽवखण्डितैः।\nबभौ च तन्मानवहं मनस्विनामाक्रीडनं भूतपतेरिवोल्बणम्॥ १०/६९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.036.m4a", "display_order": 37}, {"id": 6000265037, "chapter_id": 10265, "verse_number": "१०-६९-३४", "content_sanskrit": "अथाह पौण्ड्रकं शौरिर्भो भो पौण्ड्रक यद् भवान्।\nदूतवाक्येन मामाह तान्यस्‍त्राण्युत्सृजामि ते॥ १०/६९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.037.m4a", "display_order": 38}, {"id": 6000265038, "chapter_id": 10265, "verse_number": "१०-६९-३५", "content_sanskrit": "त्याजयिष्येऽभिधानं मे यत् त्वयाऽद्य मृषा कृतम्।\nव्रजामि शरणं तेऽद्य यदि नेच्छामि संयुगम्॥ १०/६९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.038.m4a", "display_order": 39}, {"id": 6000265039, "chapter_id": 10265, "verse_number": "१०-६९-३६", "content_sanskrit": "इति क्षिप्त्वा शितैर्बाणैर्विरथीकृत्य पौण्ड्रकम्।\nशिरोऽहरद् रथाङ्गेन वज्रेणेन्द्रो यथा गिरेः॥ १०/६९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.039.m4a", "display_order": 40, "topics": [{"text": "पौण्ड्रकवधः", "range": "३६"}]}, {"id": 6000265040, "chapter_id": 10265, "verse_number": "१०-६९-३७", "content_sanskrit": "तथा काशिपतेः कायाच्छिर उत्कृत्य पत्रिभिः।\nन्यपातयत् काशिपुर्यां पद्मकोशमिवानिलः॥ १०/६९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.040.m4a", "display_order": 41}, {"id": 6000265041, "chapter_id": 10265, "verse_number": "१०-६९-३८", "content_sanskrit": "एवं मत्सरिणं हत्वा पौण्ड्रकं ससखं हरिः।\nद्वारकामाविशत् सिद्धैर्गीयमानकथामृतः॥ १०/६९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.041.m4a", "display_order": 42}, {"id": 6000265042, "chapter_id": 10265, "verse_number": "१०-६९-३९", "content_sanskrit": "शिरः पतितमालोक्य राजद्वारि सकुण्डलम्।\nकिमिदं कस्य वा वक्त्रमिति संशयिरे जनाः॥ १०/६९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.042.m4a", "display_order": 43}, {"id": 6000265043, "chapter_id": 10265, "verse_number": "१०-६९-४०", "content_sanskrit": "राज्ञः काशिपतेर्ज्ञात्वा महिष्यः पुत्रबान्धवाः।\nपौराः शोकहता राजन् नाथ नाथेत्युपाद्रवन्॥ १०/६९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.043.m4a", "display_order": 44}, {"id": 6000265044, "chapter_id": 10265, "verse_number": "१०-६९-४१", "content_sanskrit": "सुदक्षिणस्तस्य सुतः कृत्वा संस्थाविधिं पितुः।\nनिहत्य पितृहन्तारं यास्याम्यपचितिं पितुः॥ १०/६९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.044.m4a", "display_order": 45, "topics": [{"text": "सुदक्षिणेन कृष्णवधार्थं तपः", "range": "४१–४२"}]}, {"id": 6000265045, "chapter_id": 10265, "verse_number": "१०-६९-४२", "content_sanskrit": "इत्यात्मनाऽभिसन्धाय सोपाध्यायो महेश्वरम्।\nसुदक्षिणोऽर्चयामास परमेण समाधिना॥ १०/६९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.045.m4a", "display_order": 46}, {"id": 6000265046, "chapter_id": 10265, "verse_number": "१०-६९-४३", "content_sanskrit": "प्रीतोऽविमुक्ते भगवांस्तस्मै वरमदाद् भवः।\nपितृहन्तुर्वधोपायं स वव्रे वरमीप्सितम्॥ १०/६९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.046.m4a", "display_order": 47, "topics": [{"text": "कृष्णस्य पार्श्वमुपातिष्ठत्", "range": "४३–५६"}]}, {"id": 6000265047, "chapter_id": 10265, "verse_number": "१०-६९-४४", "content_sanskrit": "दक्षिणाग्निं परिचर ब्राह्मणैः सहऋत्विजः।\nअभिचारविधानेन स चाग्निः प्रमथैर्वृतः॥ १०/६९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.047.m4a", "display_order": 48}, {"id": 6000265048, "chapter_id": 10265, "verse_number": "१०-६९-४५", "content_sanskrit": "साधयिष्यति सङ्कल्पमब्रह्मण्ये प्रयोजितः।\nइत्यादिष्टस्तथा चक्रे कृष्णायाभिचरन् नृप॥ १०/६९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.048.m4a", "display_order": 49}, {"id": 6000265049, "chapter_id": 10265, "verse_number": "१०-६९-४६", "content_sanskrit": "ततोऽग्निरुत्थितः कुण्डान्मूर्तिमानतिभीषणः।\nतप्तताम्रशिखाश्मश्रुरङ्गारोद्गारिलोचनः॥ १०/६९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.049.m4a", "display_order": 50}, {"id": 6000265050, "chapter_id": 10265, "verse_number": "१०-६९-४७", "content_sanskrit": "दंष्ट्रोग्रभ्रुकुटीदन्तकठोरास्यः स्वजिह्वया।\nआलिहन् सृक्किणी रक्ते विधुन्वन् त्रिशिखं ज्वलत्॥ १०/६९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.050.m4a", "display_order": 51}, {"id": 6000265051, "chapter_id": 10265, "verse_number": "१०-६९-४८", "content_sanskrit": "पद्भ्यां तालप्रमाणाभ्यां कम्पयन् धरणीतलम्।\nसोऽभ्यधावद् वृतो भूतैर्द्वारकां प्रदहन् दिशः॥ १०/६९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.051.m4a", "display_order": 52}, {"id": 6000265052, "chapter_id": 10265, "verse_number": "१०-६९-४९", "content_sanskrit": "तमाभिचारदहनमायान्तं द्वारकौकसः।\nविलोक्य तत्रसुः सर्वे वनदाहे यथा मृगाः॥ १०/६९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.052.m4a", "display_order": 53}, {"id": 6000265053, "chapter_id": 10265, "verse_number": "१०-६९-५०", "content_sanskrit": "अक्षैः सभायां क्रीडन्तं भगवन्तं भयातुराः।\nत्राहि त्राहीति लोकेशं वह्नेः प्रदहतः पुरम्॥ १०/६९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.053.m4a", "display_order": 54}, {"id": 6000265054, "chapter_id": 10265, "verse_number": "१०-६९-५१", "content_sanskrit": "श्रुत्वा तज्जनवैक्लव्यं दृष्ट्वा स्वानां च सङ्कटम्।\nधरणीशः प्रहस्याह मा भैष्टेत्यवितास्म्यहम्॥ १०/६९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.054.m4a", "display_order": 55}, {"id": 6000265055, "chapter_id": 10265, "verse_number": "१०-६९-५२", "content_sanskrit": "सर्वस्यान्तर्बहिः सोऽथ कृत्यां माहेश्वरीं विभुः।\nविज्ञाय तद्विघातार्थं पार्श्वस्थं चक्रमादिशत्॥ १०/६९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.055.m4a", "display_order": 56}, {"id": 6000265056, "chapter_id": 10265, "verse_number": "१०-६९-५३", "content_sanskrit": "तत् सूर्यकोटिप्रतिमं सुदर्शनं जाज्वल्यमानं प्रभयानलप्रभम्।\nस्वतेजसा खं ककुभोऽथ रोदसी चक्रं मुकुन्दस्य झटित्यपूरयत्॥ १०/६९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.056.m4a", "display_order": 57}, {"id": 6000265057, "chapter_id": 10265, "verse_number": "१०-६९-५४", "content_sanskrit": "कृत्यानलः प्रतिहतः स रथाङ्गपाणेरस्‍त्रौजसा नृप विभग्नमुखो निवृत्तः।\nवाराणसीं प्रतिसमेत्य सुदक्षिणं तं सन्निर्जितं समदहत् स्वकृतोऽभिचारः॥ १०/६९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.057.m4a", "display_order": 58}, {"id": 6000265058, "chapter_id": 10265, "verse_number": "१०-६९-५५", "content_sanskrit": "चक्रं च विष्णोस्तदनु प्रविष्टं वाराणसीं साट्टसभालयापणाम्।\nसगोपुराट्टालककोष्ठतोरणां सकोशहस्त्यश्ववरूथमन्दिराम्॥ १०/६९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.058.m4a", "display_order": 59}, {"id": 6000265059, "chapter_id": 10265, "verse_number": "१०-६९-५६", "content_sanskrit": "दग्ध्वा वाराणसीं सर्वां विष्णुचक्रं सुदर्शनम्।\nभूयः पार्श्वमुपातिष्ठत् कृष्णस्याक्लिष्टकर्मणः॥ १०/६९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.059.m4a", "display_order": 60}, {"id": 6000265060, "chapter_id": 10265, "verse_number": "१०-६९-५७", "content_sanskrit": "य एतत् श्रावयेन्मर्त्य उत्तमश्लोकविक्रमम्।\nसमाहितो वा शृणुयात् सर्वपापैः प्रमुच्यते॥ १०/६९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.060.m4a", "display_order": 61}, {"id": 6000265061, "chapter_id": 10265, "verse_number": "१०-६९-५८", "content_sanskrit": "तावुभौ सर्वपापेभ्यो ब्रह्महत्यादिभिर्नृप।\nविमुच्य देहावसाने विष्णुलोकं प्रयास्यतः॥ १०/६९/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_069/BhP_10.069.061.m4a", "display_order": 62}, {"id": 6000265062, "chapter_id": 10265, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकोनसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]