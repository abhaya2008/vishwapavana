[{"id": 2061351, "chapter_id": 2312, "verse_number": "८-३३-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061352, "chapter_id": 2312, "verse_number": "८-३३-१", "content_sanskrit": "मा सूतपुत्र मन्येत(थाः) सौवर्णं हस्तिषङ्गवम्।\nप्रयच्छसि मुधैव त्वं द्रक्ष्यस्यद्य धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061353, "chapter_id": 2312, "verse_number": "८-३३-२", "content_sanskrit": "मा सूतपुत्र दानेन सौवर्णं हस्तिषङ्गवम्।\nप्रयच्छ पुरुषायाद्य द्रक्ष्यसि त्वं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061354, "chapter_id": 2312, "verse_number": "८-३३-३", "content_sanskrit": "बलेन मत्तस्त्यजसि वसु वैश्रवणो यथा।\nअयत्नेनैव राधेय द्रष्टास्यद्य धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061355, "chapter_id": 2312, "verse_number": "८-३३-४", "content_sanskrit": "पुरा सृजसि यच्चापि वित्तं बहु च मूढवत्।\nअपात्रदानाद्ये दोषास्तान्मोहान्नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061356, "chapter_id": 2312, "verse_number": "८-३३-५", "content_sanskrit": "यत्प्रवेदयसे वित्तं बहु तेन खलु त्वया।\nशक्यं बहुविधैर्यज्ञैर्यष्टुं सूत यजस्व तैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061357, "chapter_id": 2312, "verse_number": "८-३३-६", "content_sanskrit": "यच्च प्रार्थयसे हन्तुं कृष्णौ मोहाद्वृथैव तत्।\nन हि शुश्रुम सम्मर्दे क्रोष्ट्रा सिंहौ निपातितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061358, "chapter_id": 2312, "verse_number": "८-३३-७", "content_sanskrit": "अप्रार्थितं प्रार्थयसे सुहृदो न हि सन्ति ते।\nये त्वां निवारयन्त्याशु प्रपतन्तं हुताशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061359, "chapter_id": 2312, "verse_number": "८-३३-८", "content_sanskrit": "कार्याकार्यं न जानीषे कालपक्कोऽस्यसंशयम्।\nबह्वबद्धमकर्णीयं को हि ब्रूयाज्जिजीविषुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061360, "chapter_id": 2312, "verse_number": "८-३३-९", "content_sanskrit": "समुद्रतरणं दोर्भ्यां कण्ठे बद्ध्वा यथा शिलाम्।\nगिर्यग्राद्वा निपतनं तादृक्त्व चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061361, "chapter_id": 2312, "verse_number": "८-३३-१०", "content_sanskrit": "सहितः सर्वयोधैस्त्वं व्यूढानीकैः सुरक्षितः।\nधनञ्जयेन युध्यस्व श्रेयश्चेत्प्राप्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061362, "chapter_id": 2312, "verse_number": "८-३३-११", "content_sanskrit": "हितार्थं धार्तराष्ट्रस्य ब्रवीमि त्वां न हिंसया।\nश्रद्धस्वेदं मया प्रोक्तं यदि तेऽस्ति जिजीविषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061363, "chapter_id": 2312, "verse_number": "८-३३-१२x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061364, "chapter_id": 2312, "verse_number": "८-३३-१२", "content_sanskrit": "स्वबाहुवीर्यमाश्रित्य प्रार्थयाम्यर्जुनं रणे।\nत्वं तु मित्रमुखः शत्रुर्मां भीषयितुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061365, "chapter_id": 2312, "verse_number": "८-३३-१३", "content_sanskrit": "न मामस्मादभिप्रायात्कश्चिदद्य निवर्तयेत्।\nअपीन्द्रो वज्रमुद्यम्य किमु मर्त्यः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061366, "chapter_id": 2312, "verse_number": "८-३३-१४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061367, "chapter_id": 2312, "verse_number": "८-३३-१४", "content_sanskrit": "इति कर्णस्य वाक्यान्ते शल्यः प्राहोत्तरं वचः।\nचुकोपयिषुरत्यर्थं कर्णं मद्रेश्वरः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061368, "chapter_id": 2312, "verse_number": "८-३३-१५", "content_sanskrit": "यदा वै त्वां फल्गुनबाहुवेगा--\nज्ज्याचोदिता वेगवन्तोऽग्निकल्पाः।\nअन्वेतारः कङ्कपत्राः शिताग्रा--\nस्त्यक्ष्यत्येषा स्वां तदा कर्ण बुद्धिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061369, "chapter_id": 2312, "verse_number": "८-३३-१६", "content_sanskrit": "यदा दिर्व्य धनुरादाय पार्थः\nप्रतापयन्पृतनां सव्यसाची।\nत्वां मर्दयिष्यत्यसुखैः पृषत्कै--\nस्तदापृच्छां त्यक्ष्यसे पाण्डवस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061370, "chapter_id": 2312, "verse_number": "८-३३-१७", "content_sanskrit": "बालश्चन्द्रं मातुरङ्के शयानो\nयथा कश्चित्प्रार्थयतेऽपहर्तुम्।\nतद्वन्मोहाद्दयोतामानं रथस्थं\nजेतुं पार्थं काङ्क्षसे सूतपुत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061371, "chapter_id": 2312, "verse_number": "८-३३-१८", "content_sanskrit": "हरादस्त्रं तीक्ष्णधारं यथाऽद्य\nसर्वाणि गात्राणि निकर्षसि त्वम्।\nसुतीक्ष्णशस्त्रोपमकर्मणेह\nयुयुत्ससे फल्गुनेनाद्य कर्ण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061372, "chapter_id": 2312, "verse_number": "८-३३-१९", "content_sanskrit": "हन्यादसिं तीक्ष्णधारं यथाऽतः\nसुतेजनं निहितं वै पृथिव्याम्।\nतथा खनस्यद्य शितान्पृषत्का--\nन्यथार्थयस्यर्जुनेनेह युद्धम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061373, "chapter_id": 2312, "verse_number": "८-३३-२०", "content_sanskrit": "त्रिशूलमाश्लिष्य सुतीक्ष्णधारं\nसर्वाणि गात्राणि विघर्षसि त्वम्।\nसुतीक्ष्णधारोपमकर्मणा त्वं\nयुयुत्ससे योऽर्जुनेनाद्य कर्ण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061374, "chapter_id": 2312, "verse_number": "८-३३-२१", "content_sanskrit": "क्रुद्धं सिंहं केसरिणं बृहन्तं\nबालो मूढः क्षुद्रमृगस्तरस्वी।\nसमाह्वयेद्वृष्टमुपेत्य योद्धुं\nतथा त्वमद्याह्वयसे हि पार्थम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061375, "chapter_id": 2312, "verse_number": "८-३३-२२", "content_sanskrit": "मा सूतपुत्राह्वय राजपुत्रं\nमहावीर्यं केसरिणं यथैव।\nवने शृगालः पिशितेन तृप्तः\nपार्थं समासाद्य विनङ्क्ष्यसि त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061376, "chapter_id": 2312, "verse_number": "८-३३-२३", "content_sanskrit": "ईषादन्तं महानागं प्रभिन्नकरटामुखम्।\nशशको हयसे युद्वे कर्ण पार्थं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061377, "chapter_id": 2312, "verse_number": "८-३३-२४", "content_sanskrit": "विलस्थं कृष्णसर्पं त्वं जाल्यात्काष्ठेन विध्यसि।\nमहाविषं पूर्णकोपं यत्पार्थं योद्वुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061378, "chapter_id": 2312, "verse_number": "८-३३-२५", "content_sanskrit": "सिंहं केसरिणं क्रुद्धमभिक्रम्याभिनर्दसे।\nशृगाल इव मूढस्त्वं नृसिंहं कर्ण पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061379, "chapter_id": 2312, "verse_number": "८-३३-२६", "content_sanskrit": "सुपर्णं पतगश्रेष्ठं वैनतेयं तरस्विनम्।\nस्वगेवाह्वयसे पार्थं तथा कर्णं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061380, "chapter_id": 2312, "verse_number": "८-३३-२७", "content_sanskrit": "सर्वाम्भसां निधिं भीमं मूर्तिमन्तं झषाकुलम्।\nचन्द्रोदये विवर्धन्तमप्लुवस्त्वं तितीर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061381, "chapter_id": 2312, "verse_number": "८-३३-२८", "content_sanskrit": "ऋषभं दुन्दुभिग्रीवं तीक्ष्णशृङ्गं प्रहारिणम्।\nवत्स आह्वयसे युद्वे कर्ण पार्थं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061382, "chapter_id": 2312, "verse_number": "८-३३-२९", "content_sanskrit": "महामेघं महाघोषं दर्दुरः प्रतिनर्दसि।\nबाणतोयप्रदं काले नरपर्जन्यमर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061383, "chapter_id": 2312, "verse_number": "८-३३-३०", "content_sanskrit": "यथा च श्वा गृहस्थस्तु व्याघ्रं वनगतं भषेत्।\nतथा त्वं भषसे कर्ण नरव्याघ्रं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061384, "chapter_id": 2312, "verse_number": "८-३३-३१", "content_sanskrit": "शृगालो हि वने कर्ण शशैः परिवृतो वसन्।\nमन्यते सिंहमात्मानं यावत्सिंहं न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061385, "chapter_id": 2312, "verse_number": "८-३३-३२", "content_sanskrit": "तथा त्वमपि राधेय सिंहमात्मानमिच्छसि।\nअपश्यञ्शत्रुदमनं नरसिंहं रणेऽर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061386, "chapter_id": 2312, "verse_number": "८-३३-३३", "content_sanskrit": "व्याघ्रं त्वं मन्यसेऽऽत्मानं यावत्कृष्णौ न पश्यसि।\nसमास्थितावेकरथे सूर्याचन्द्रमसाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061387, "chapter_id": 2312, "verse_number": "८-३३-३४", "content_sanskrit": "यावद्ग्राण्डीवघोषं त्वं न शृणोषि महाहवे।\nतावदेव त्वया कर्ण शक्यं वक्तुं यथेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061388, "chapter_id": 2312, "verse_number": "८-३३-३५", "content_sanskrit": "रथशङ्खधनुःशब्दैर्नादयन्तं दिशो दश।\nनर्दन्तमिव शार्दूलं दृष्ट्वा क्रोष्टा भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061389, "chapter_id": 2312, "verse_number": "८-३३-३६", "content_sanskrit": "नित्यमेव शृगालस्त्वं नित्यं सिंहो धनञ्जयः।\nवीरप्रद्वेषणान्मूढ तस्मात्क्रोष्टेव लक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061390, "chapter_id": 2312, "verse_number": "८-३३-३७", "content_sanskrit": "यथाऽऽखुः स्याद्विडालश्च श्वा व्याघ्रश्च बलाबले।\nयथा शृगालः सिंहश्च यथा च शशकुञ्जरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061391, "chapter_id": 2312, "verse_number": "८-३३-३८", "content_sanskrit": "यथाऽनृतं च सत्यं च यथा चापि विषामृते।\nतथा त्वमपि पार्थश्च प्रख्यातावात्मकर्मभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061392, "chapter_id": 2312, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]