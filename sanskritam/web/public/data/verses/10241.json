[{"id": 6000241000, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "अथ पञ्चचत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000241001, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.001.m4a", "display_order": 2}, {"id": 6000241002, "chapter_id": 10241, "verse_number": "१०-४५-१", "content_sanskrit": "तं वीक्ष्य कुष्णानुचरं व्रजस्‍त्रियः प्रलम्बबाहुं नवकञ्जलोचनम्।\nपीताम्बरं पुष्करमालिनं लसन्मुखारविन्दं परिमृष्टकुण्डलम्॥ १०/४५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.002.m4a", "display_order": 3, "topics": [{"text": "भ्रमरगीता", "range": "१–२१"}]}, {"id": 6000241003, "chapter_id": 10241, "verse_number": "१०-४५-२", "content_sanskrit": "सुविस्मिताः कोऽयमतीवदर्शनः कुतश्च कस्याच्युतवेषभूषणः।\nइति स्म सर्वाः परिवव्रुरुत्सुकास्तमुत्तमश्लोकपदाम्बुजाश्रयम्॥ १०/४५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.003.m4a", "display_order": 4}, {"id": 6000241004, "chapter_id": 10241, "verse_number": "१०-४५-३", "content_sanskrit": "तं प्रश्रयेणावनताः सुसत्कृतं सव्रीडहासेक्षणसूनृतादिभिः।\nरहस्यपृच्छन्परिविष्टमासने विज्ञाय सन्देशहरं रमापतेः॥ १०/४५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.004.m4a", "display_order": 5}, {"id": 6000241005, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.005.m4a", "display_order": 6}, {"id": 6000241006, "chapter_id": 10241, "verse_number": "१०-४५-४", "content_sanskrit": "जानीमस्त्वां यदुपतेः पार्षदार्यमनुव्रतम्।\nभर्त्रेह प्रेषितः पित्रोर्भवान् प्रियचिकीर्षया॥ १०/४५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.006.m4a", "display_order": 7}, {"id": 6000241007, "chapter_id": 10241, "verse_number": "१०-४५-५", "content_sanskrit": "अन्यथा गोव्रजे तस्य स्मरणीयं न चक्ष्महे।\nस्नेहानुबन्धो बन्धूनां मुनेरपि सुदुस्त्यजः॥ १०/४५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.007.m4a", "display_order": 8}, {"id": 6000241008, "chapter_id": 10241, "verse_number": "१०-४५-६", "content_sanskrit": "अन्येष्वर्थकृता मैत्री यावदर्थविडम्बना।\nपुम्भिः स्‍त्रीषु कृता यद्वत् सुमनस्स्विव षट्पदैः॥ १०/४५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.008.m4a", "display_order": 9}, {"id": 6000241009, "chapter_id": 10241, "verse_number": "१०-४५-७", "content_sanskrit": "निस्स्वं त्यजन्ति गणिका अकल्पं नृपतिं प्रजाः।\nअधीतविद्या आचार्यमृत्विजो दत्तदक्षिणम्॥ १०/४५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.009.m4a", "display_order": 10}, {"id": 6000241010, "chapter_id": 10241, "verse_number": "१०-४५-८", "content_sanskrit": "खगा वीतफलं वृक्षं भुक्त्वा चातिथयो गृहम्।\nदग्धं मृगास्तथाऽरण्यं जारो भुक्त्वा परस्‍त्रियम्॥ १०/४५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.010.m4a", "display_order": 11}, {"id": 6000241011, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.011.m4a", "display_order": 12}, {"id": 6000241012, "chapter_id": 10241, "verse_number": "१०-४५-९", "content_sanskrit": "ददर्श गोपीर्गोविन्दमनोवाग्देहचेष्टितैः।\nकृष्णदूतो व्रजं प्राप्त उद्धवस्त्यक्तलौकिकाः॥ १०/४५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.012.m4a", "display_order": 13}, {"id": 6000241013, "chapter_id": 10241, "verse_number": "१०-४५-१०", "content_sanskrit": "गायन्त्यः प्रियकर्माणि रुदन्त्यश्च गतह्रियः।\nतस्य संस्मृत्य संस्मृत्य यानि कैशोरबाल्ययोः॥ १०/४५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.013.m4a", "display_order": 14}, {"id": 6000241014, "chapter_id": 10241, "verse_number": "१०-४५-११", "content_sanskrit": "काचिन्मधुकरं दृष्ट्वा ध्यायन्ती कृष्णसङ्गमम्।\nप्रियप्रस्थापितं दूतं कल्पयित्वेदमब्रवीत्॥ १०/४५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.014.m4a", "display_order": 15}, {"id": 6000241015, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "गोप्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.015.m4a", "display_order": 16}, {"id": 6000241016, "chapter_id": 10241, "verse_number": "१०-४५-१२", "content_sanskrit": "मधुप कितवबन्धो मा स्पृशास्मान् सपत्न्याः कुचविलुलितमालाकुङ्कुमश्मश्रुभिस्त्वम्।\nवहतु मधुपतिस्तन्मानिनीनां प्रसादं यदुसदसि विडम्ब्यं यस्य दूतस्त्वमीदृक्॥ १०/४५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.016.m4a", "display_order": 17}, {"id": 6000241017, "chapter_id": 10241, "verse_number": "१०-४५-१३", "content_sanskrit": "सकृदधरसुधां स्वां मोहिनीं पाययित्वा सुमनस इव सद्यः कस्त्यजेन्मां भवादृक्।\nपरिचरति कथं तत्पद्मकिञ्जल्कपादमपि बत हृतचित्ता उत्तमश्लोकजल्पैः॥ १०/४५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.017.m4a", "display_order": 18}, {"id": 6000241018, "chapter_id": 10241, "verse_number": "१०-४५-१४", "content_sanskrit": "किमिह बहु षडङ्घ्रे गायसि त्वं यदूनामधिपतिमगृहाणामग्रतो नः पुराणम्।\nविजयसखसखीनां गायतां तत्प्रसङ्गक्षपितकुचरुजस्ते कल्पयन्तीष्टमिष्टाः॥ १०/४५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.018.m4a", "display_order": 19}, {"id": 6000241019, "chapter_id": 10241, "verse_number": "१०-४५-१५", "content_sanskrit": "दिवि भुवि च रसायां काः स्‍त्रियस्तद्दुरापाः कपटरुचिरहासभ्रूविजृम्भस्य याः स्युः।\nचरणरज उपास्ते यस्य भूतिर्वयं का अपि च कृपणपक्षे उत्तमश्लोकशब्दः॥ १०/४५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.019.m4a", "display_order": 20}, {"id": 6000241020, "chapter_id": 10241, "verse_number": "१०-४५-१६", "content_sanskrit": "विसृज शिरसि पादं वेद्म्यहं चाटुकारैरलमनुनयसारैर्याहि दौत्ये मुकुन्दम्।\nस्वकृत इह विसृष्टापत्यपत्याप्तलोका व्यसृजदकृतचेताः किं नु सन्धेयमस्मिन्॥ १०/४५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.020.m4a", "display_order": 21}, {"id": 6000241021, "chapter_id": 10241, "verse_number": "१०-४५-१७", "content_sanskrit": "मृगयुरिव कपीन्द्रं विव्यधे यः किरातः स्‍त्रियमकृत विरूपां स्‍त्रीजितः कामयानाम्।\nबलिमपि बिलवासं वेदविद्वर्गवन्द्यस्तदलमसितसख्यैर्दुस्त्यजस्तत्कथार्थः॥ १०/४५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.021.m4a", "display_order": 22}, {"id": 6000241022, "chapter_id": 10241, "verse_number": "१०-४५-१८", "content_sanskrit": "यदनुचरितलीलाकर्णपीयूषविप्रुट्सकृददनविधूतद्वन्द्वधर्मा विनष्टाः।\nसपदि गृहकुटुम्बं दीनमुत्सृज्य दीना बहव इह विहङ्गा भैक्षचर्यां चरन्ति॥ १०/४५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.022.m4a", "display_order": 23}, {"id": 6000241023, "chapter_id": 10241, "verse_number": "१०-४५-१९", "content_sanskrit": "वयमृतमिव जिह्मं व्याहृतं श्रद्धधानाः कुलिकरुतमिवाज्ञाः कृष्णवध्वो हरिण्यः।\nददृशिम सकृदेतत्तन्नखस्पर्शतीव्रस्तनरुजपरमार्तिं भण्यतामस्य वार्ता॥ १०/४५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.023.m4a", "display_order": 24}, {"id": 6000241024, "chapter_id": 10241, "verse_number": "१०-४५-२०", "content_sanskrit": "प्रियसख पुनरागाः प्रेयसा प्रेषितस्त्वं वरय किमनुरुन्धे माननीयोऽसि मेऽङ्ग।\nनयसि कथमिहास्मान् दुस्त्यजं बन्धुपार्श्वं सततमुरसि सौम्य श्रीवधूः साकमास्ते॥ १०/४५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.024.m4a", "display_order": 25}, {"id": 6000241025, "chapter_id": 10241, "verse_number": "१०-४५-२१", "content_sanskrit": "अपि बत मधुपुर्यामार्यपुत्रोऽधुनाऽऽस्ते स्मरति स पितृगेहं सौम्य बन्धूंश्च गोपान्।\nक्‍वचिदपि स कथं नः किङ्करीणां गृहीतो भुजमगुरुसुगन्धं मूर्ध्न्यधास्यत् कदा नु॥ १०/४५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.025.m4a", "display_order": 26}, {"id": 6000241026, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.026.m4a", "display_order": 27}, {"id": 6000241027, "chapter_id": 10241, "verse_number": "१०-४५-२२", "content_sanskrit": "अथोद्धवो निशम्यैवं कृष्णदर्शनलालसाः।\nसान्त्वयन् प्रियसन्देशैर्गोपीरिदमभाषत॥ १०/४५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.027.m4a", "display_order": 28, "topics": [{"text": "उद्धवेन श्रीकृष्णाज्ञया गोपीनां श्रीकृष्णसन्देशकथनम्", "range": "२२–५२"}]}, {"id": 6000241028, "chapter_id": 10241, "verse_number": "१०-४५-२३", "content_sanskrit": "अहो यूयं स्म पूर्णार्था भवत्यो लोकपूजिताः।\nवासुदेवे भगवति यासामित्यर्पिता मतिः॥ १०/४५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.028.m4a", "display_order": 29}, {"id": 6000241029, "chapter_id": 10241, "verse_number": "१०-४५-२४", "content_sanskrit": "दानव्रततपोहोमजपस्वाध्यायसंयमैः।\nश्रेयोविधिभिरन्यैश्च कृष्णे भक्तिर्हि साध्यते॥ १०/४५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.029.m4a", "display_order": 30}, {"id": 6000241030, "chapter_id": 10241, "verse_number": "१०-४५-२५", "content_sanskrit": "भगवत्युत्तमश्लोके भवतीभिरनुत्तमा।\nभक्तिः प्रवर्तिता दिष्ट्या मुनीनामपि दुर्लभा॥ १०/४५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.030.m4a", "display_order": 31}, {"id": 6000241031, "chapter_id": 10241, "verse_number": "१०-४५-२६", "content_sanskrit": "दिष्ट्या पुत्रान् पतीन् देहान् स्वजनान् भवनानि च।\nहित्वा वृणीत यूयं यत् कृष्णाख्यं पुरुषं परम्॥ १०/४५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.031.m4a", "display_order": 32}, {"id": 6000241032, "chapter_id": 10241, "verse_number": "१०-४५-२७", "content_sanskrit": "सर्वात्मभावोऽधिगतो भवतीनामधोक्षजे।\nविरहेण महाभागा महान् वोऽनुग्रहः कृतः॥ १०/४५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.032.m4a", "display_order": 33}, {"id": 6000241033, "chapter_id": 10241, "verse_number": "१०-४५-२८", "content_sanskrit": "श्रूयतां प्रियसन्देशो भवतीनां सुखावहः।\nयमादायागतो भद्रा अहं भर्तुर्हि किङ्करः॥ १०/४५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.033.m4a", "display_order": 34}, {"id": 6000241034, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "श्रीभगवत्सन्देशः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.034.m4a", "display_order": 35}, {"id": 6000241035, "chapter_id": 10241, "verse_number": "१०-४५-२९", "content_sanskrit": "भवतीनां वियोगो मे न हि सर्वात्मना क्‍वचित्।\nयथा भूतानि भूतेषु खं वाय्वग्निर्जलं मही॥ १०/४५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.035.m4a", "display_order": 36}, {"id": 6000241036, "chapter_id": 10241, "verse_number": "१०-४५-३०", "content_sanskrit": "यथाऽहं च मनःप्राणभूतेन्द्रियगुणाश्रयः।\nआत्मन्येवात्मनाऽऽत्मानं सृजे हन्म्यनुपालये॥ १०/४५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.036.m4a", "display_order": 37}, {"id": 6000241037, "chapter_id": 10241, "verse_number": "१०-४५-३१", "content_sanskrit": "आत्ममायानुभावेन भूतेन्द्रियगुणात्मना।\nआत्मा ज्ञानमयः शुद्धो व्यतिरिक्तो गुणान्वयः॥ १०/४५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.037.m4a", "display_order": 38}, {"id": 6000241038, "chapter_id": 10241, "verse_number": "१०-४५-३२", "content_sanskrit": "सुषुप्तिस्वप्नजाग्रद्भिर्मायावृत्तिभिरीयते॥ १०/४५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.038.m4a", "display_order": 39}, {"id": 6000241039, "chapter_id": 10241, "verse_number": "१०-४५-३३", "content_sanskrit": "एतदन्तः समाम्नायो योगः साङ्ख्यं मनीषिणाम्।\nत्यागस्तपो दमः सत्यं समुद्रान्ता इवापगाः॥ १०/४५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.039.m4a", "display_order": 40}, {"id": 6000241040, "chapter_id": 10241, "verse_number": "१०-४५-३४", "content_sanskrit": "यत्त्वहं भवतीनां वै दूरे वर्त्यपि यो दृशाम्।\nमनसः सन्निकर्षार्थं मदनुध्यानकाम्यया॥ १०/४५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.040.m4a", "display_order": 41}, {"id": 6000241041, "chapter_id": 10241, "verse_number": "१०-४५-३५", "content_sanskrit": "यथा दूरचरे प्रेष्ठे मन आविश्य वर्तते।\nस्‍त्रीणां च न तथा चेतः सन्निकृष्टेऽक्षगोचरे॥ १०/४५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.041.m4a", "display_order": 42}, {"id": 6000241042, "chapter_id": 10241, "verse_number": "१०-४५-३६", "content_sanskrit": "मय्यावेश्य मनः कृत्स्नं विमुक्ताशेषवृत्ति यत्।\nअनुस्मरन्त्यो मां नित्यमचिरान्मामुपेष्यथ॥ १०/४५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.042.m4a", "display_order": 43}, {"id": 6000241043, "chapter_id": 10241, "verse_number": "१०-४५-३७", "content_sanskrit": "यन्मया क्रीडिता रात्रीर्वनेऽस्मिन् व्रज आस्थिताः।\nअलब्धरासकल्याण्यः आपुर्मां मद्विचिन्तया॥ १०/४५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.043.m4a", "display_order": 44}, {"id": 6000241044, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.044.m4a", "display_order": 45}, {"id": 6000241045, "chapter_id": 10241, "verse_number": "१०-४५-३८", "content_sanskrit": "एवं प्रियतमादेशमाकर्ण्य व्रजयोषितः।\nता ऊचुरुद्धवं प्रीतास्तत्सन्देशागतस्मृतीः॥ १०/४५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.045.m4a", "display_order": 46}, {"id": 6000241046, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.046.m4a", "display_order": 47}, {"id": 6000241047, "chapter_id": 10241, "verse_number": "१०-४५-३९", "content_sanskrit": "दिष्ट्याऽहितो हतः कंसो यदूनां सानुगोऽघकृत्।\nदिष्ट्याऽप्तैर्लब्धसर्वार्थैः कुशल्यास्तेऽच्युतोऽधुना॥ १०/४५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.047.m4a", "display_order": 48}, {"id": 6000241048, "chapter_id": 10241, "verse_number": "१०-४५-४०", "content_sanskrit": "कच्चिद् गदाग्रजः सौम्य करोति पुरयोषिताम्।\nप्रीतिं सुस्निग्धसव्रीडहासोदारेक्षणैर्जितः॥ १०/४५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.048.m4a", "display_order": 49}, {"id": 6000241049, "chapter_id": 10241, "verse_number": "१०-४५-४१", "content_sanskrit": "कथं रतिविशेषज्ञः प्रियश्च पुरयोषिताम्।\nनानुबध्येत तद्वाक्यैर्विभ्रमैश्चानुभाजितः॥ १०/४५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.049.m4a", "display_order": 50}, {"id": 6000241050, "chapter_id": 10241, "verse_number": "१०-४५-४२", "content_sanskrit": "अपि स्मरति नः साधो गोविन्दः प्रस्तुते क्‍वचित्।\nगोष्ठीमध्ये पुरस्‍त्रीणां ग्राम्यस्वैरकथान्तरे॥ १०/४५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.050.m4a", "display_order": 51}, {"id": 6000241051, "chapter_id": 10241, "verse_number": "१०-४५-४३", "content_sanskrit": "ताः किं निशाः स्मरति यासु तदा प्रियाभिर्वृन्दावने कुमुदकुन्दशशाङ्करम्ये।\nरेमे क्‍वणच्चरणनूपुररासगोष्ठ्यामस्माभिरीडितमनोज्ञकथः कदाचित्॥ १०/४५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.051.m4a", "display_order": 52}, {"id": 6000241052, "chapter_id": 10241, "verse_number": "१०-४५-४४", "content_sanskrit": "अप्येष्यतीह दाशार्हस्तप्तं स्वकृतया शुचा।\nसञ्जीवयन् व्रजं गात्रैर्यथेन्द्रो वनमम्बुदैः॥ १०/४५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.052.m4a", "display_order": 53}, {"id": 6000241053, "chapter_id": 10241, "verse_number": "१०-४५-४५", "content_sanskrit": "कस्मात् कृष्ण इहायाति प्राप्तराज्यो हताहितः।\nविहृत्य नगरस्‍त्रीभिः प्रीतः सर्वसुहृद्वृतः॥ १०/४५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.053.m4a", "display_order": 54}, {"id": 6000241054, "chapter_id": 10241, "verse_number": "१०-४५-४६", "content_sanskrit": "किमस्माभिर्वनौकोभिरन्याभिर्वा महात्मनः।\nश्रीपतेराप्तकामस्य क्रियेतार्थः कृतात्मनः॥ १०/४५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.054.m4a", "display_order": 55}, {"id": 6000241055, "chapter_id": 10241, "verse_number": "१०-४५-४७", "content_sanskrit": "परं सुखं हि नैराश्यं स्वैरिण्यप्याह पिङ्गला।\nतज्जानतीनां नः कृष्णे तथाप्याशा दुरत्यया॥ १०/४५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.055.m4a", "display_order": 56}, {"id": 6000241056, "chapter_id": 10241, "verse_number": "१०-४५-४८", "content_sanskrit": "क उत्सहेत सन्त्यक्तुमुत्तमश्लोकसंविदम्।\nअनिच्छतोऽपि यस्य श्रीरङ्गान्न च्यवते क्‍वचित्॥ १०/४५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.056.m4a", "display_order": 57}, {"id": 6000241057, "chapter_id": 10241, "verse_number": "१०-४५-४९", "content_sanskrit": "सरिच्छैलवनोद्देशा गावो वेणुरवा इमे।\nसङ्कर्षणसहायेन कृष्णेनाक्रीडिताः प्रभो॥ १०/४५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.057.m4a", "display_order": 58}, {"id": 6000241058, "chapter_id": 10241, "verse_number": "१०-४५-५०", "content_sanskrit": "पुनःपुनः स्मारयन्ति नन्दगोपसुतं बत।\nश्रीनिकेते तत्पदके विस्मर्तुं नैव शक्नुमः॥ १०/४५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.058.m4a", "display_order": 59}, {"id": 6000241059, "chapter_id": 10241, "verse_number": "१०-४५-५१", "content_sanskrit": "गत्या ललितयोदारहासलीलावलोकनैः।\nमाध्व्या गिरा हृतधियः कथं तद् विस्मराम हे॥ १०/४५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.059.m4a", "display_order": 60}, {"id": 6000241060, "chapter_id": 10241, "verse_number": "१०-४५-५२", "content_sanskrit": "हे नाथ हे रमानाथ व्रजनाथार्तिनाशन।\nमग्नमुद्धर गोविन्द गोकुलं वृजिनार्णवात्॥ १०/४५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_045/BhP_10.045.060.m4a", "display_order": 61}, {"id": 6000241061, "chapter_id": 10241, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे पञ्चचत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]