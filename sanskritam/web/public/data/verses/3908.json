[{"id": 2134628, "chapter_id": 3908, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134629, "chapter_id": 3908, "verse_number": "१", "content_sanskrit": "धृतराष्ट्रं ततः सर्वे ददृशुर्जनमेजय ।\nपृष्ट्वा सुखमथो राज्ञः पृष्टा राज्ञा च भारत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134630, "chapter_id": 3908, "verse_number": "२", "content_sanskrit": "ततस्तैर्विहितः पूर्वं समङ्गो नाम वल्लवः ।\nसमीपस्थास्तदा गावो धृतराष्ट्रे न्यवेदयत् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134631, "chapter_id": 3908, "verse_number": "३", "content_sanskrit": "अनन्तरं च राधेयः शकुनिश्च महारथः ।\nआहतुः पार्थिवश्रेष्ठं धृतराष्ट्रं जनाधिपम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134632, "chapter_id": 3908, "verse_number": "", "content_sanskrit": "शकुनिकर्णौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134633, "chapter_id": 3908, "verse_number": "४", "content_sanskrit": "रमणीयेषु देशेषु घोषाः सम्प्रति कौरव ।\nस्मारणं समयं प्राप्ता वत्सानामपि चाङ्कनम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134634, "chapter_id": 3908, "verse_number": "५", "content_sanskrit": "मृगया चोचिता राजन्नस्मिन् काले सुतस्य ते ।\nदुर्योधनस्य गमनं समनुज्ञातुमर्हसि \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134635, "chapter_id": 3908, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134636, "chapter_id": 3908, "verse_number": "६", "content_sanskrit": "मृगया शोभना तात गवां हि समवेक्षणम् ।\nविश्रम्भस्तु न गन्तव्यो वल्लवानामिति स्मरे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134637, "chapter_id": 3908, "verse_number": "७", "content_sanskrit": "ते तु तत्र नरव्याघ्राः समीप इति नः श्रुतम्।\nअतो नाभ्यनुजानामि गमनं तत्र वः स्वयम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134638, "chapter_id": 3908, "verse_number": "८", "content_sanskrit": "छद्मना निर्जितास्ते तु कर्शिताश्च महावने ।\nतपोनित्याश्च राधेय समर्थाश्च महारथाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134639, "chapter_id": 3908, "verse_number": "९", "content_sanskrit": "धर्मराजो न सङ्क्रुद्ध्येद् भीमसेनस्त्वमर्षणः ।\nयज्ञसेनस्य दुहिता तेज एव तु केवलम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134640, "chapter_id": 3908, "verse_number": "१०", "content_sanskrit": "यूयं चाप्यपराध्येयुर्दर्पमोहसमन्विताः ।\nततो विनिर्दहेयुस्ते तपसा हि समन्विताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134641, "chapter_id": 3908, "verse_number": "११", "content_sanskrit": "अथवा सायुधा वीरा मन्युनाऽभिपरिप्लुताः ।\nसहिता बद्धनिस्त्रिशां  दहेयुः शस्त्रतेजसा \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134642, "chapter_id": 3908, "verse_number": "१२", "content_sanskrit": "अथ यूयं बहुत्वात् तानभियात कथञ्चन ।\nअनार्यं परमं तत् स्यादशक्यं तच्च वै मतम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134643, "chapter_id": 3908, "verse_number": "१३", "content_sanskrit": "उषितो हि महाबाहुरिन्द्रलोके धनञ्जयः ।\nदिव्यान्यस्त्राण्यवाप्याथ ततः प्रत्यागतो वनम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134644, "chapter_id": 3908, "verse_number": "१४", "content_sanskrit": "अकृतास्त्रेण पृथिवी जिता बीभत्सुना पुरा ।\nकिं पुनः स कृतास्त्रोऽद्य न हन्याद् वो महारथः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134645, "chapter_id": 3908, "verse_number": "१५", "content_sanskrit": "अथवा मद्वचः श्रुत्वा तत्र यत्ता भविष्यथ\nउद्विग्नवासोऽविस्रम्भात् दुःखं तत्र भविष्यति \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134646, "chapter_id": 3908, "verse_number": "१६", "content_sanskrit": "अथवा सैनिकाः केचिदपकुर्युर्युधिष्ठिरम् ।\nतदबुद्धिकृतं कर्म दोषमुत्पादयेच्च वः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134647, "chapter_id": 3908, "verse_number": "१७", "content_sanskrit": "तस्माद् गच्छन्तु पुरुषाः स्मारणायाप्तचारिणः ।\nन स्वयं तत्र गमनं रोचते तव भारत \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134648, "chapter_id": 3908, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134649, "chapter_id": 3908, "verse_number": "१८", "content_sanskrit": "धर्मज्ञः पाण्डवो ज्येष्ठः प्रतिज्ञातं च संसदि ।\nतेन द्वादश वर्षाणि वस्तव्यानीति भारत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134650, "chapter_id": 3908, "verse_number": "१९", "content_sanskrit": "अनुवृत्ताश्च ते सर्वे पाण्डवा धर्मचारिणः ।\nयुधिष्ठिरस्तु कौन्तेयो न नः कोपं करिष्यति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134651, "chapter_id": 3908, "verse_number": "२०", "content_sanskrit": "मृगयां चैव नो गन्तुमिच्छा संवर्तते भृशम् ।\nस्मारणं तु चिकीर्षामो न तु पाण्डवदर्शनम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134652, "chapter_id": 3908, "verse_number": "२१", "content_sanskrit": "न चानार्यसमाचारः कश्चित् तत्र भविष्यति ।\nन च तत्र गमिष्यामो यत्र तेषां प्रतिश्रयः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134653, "chapter_id": 3908, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134654, "chapter_id": 3908, "verse_number": "२२", "content_sanskrit": "एवमुक्तः शकुनिना धृतराष्ट्रो जनेश्वरः ।\nदुर्योधनं सहामात्यमनुजज्ञे न कामतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134655, "chapter_id": 3908, "verse_number": "२३", "content_sanskrit": "अनुज्ञातस्तु गान्धारिः कर्णेन सहितस्तदा ।\nनिर्ययौ भरतश्रेष्ठ बलेन महता वृतः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134656, "chapter_id": 3908, "verse_number": "२४", "content_sanskrit": "दुःशासनेन कर्णेन सौबलेन च धीमता ।\nसंवृतो भ्रातृभिश्चान्यैः स्त्रीभिश्चापि सहस्रशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134657, "chapter_id": 3908, "verse_number": "", "content_sanskrit": "(तं निर्यान्तं महाबाहुं द्रष्टुं द्वैतवनं सरः ।)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134658, "chapter_id": 3908, "verse_number": "२५", "content_sanskrit": "पौराश्चानुययुः सर्वे सहदारा वनं च तत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134659, "chapter_id": 3908, "verse_number": "२६", "content_sanskrit": "अष्टौ रथसहस्राणि त्रीणि नागायुतानि च ।\nपत्तयो बहुसाहस्त्रा हयाश्च नवतिः शताः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134660, "chapter_id": 3908, "verse_number": "२७", "content_sanskrit": "शकटापणवेशाश्च वणिजो वन्दिनस्तथा ।\nनराश्च मृगयाशीलाः शतशोऽथ सहस्रशः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134661, "chapter_id": 3908, "verse_number": "२८", "content_sanskrit": "ततः प्रयाणे नृपतेः सुमहानभवत् स्वनः ।\nप्रावृषीव महावायोरुद्धतस्य विशाम्पते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134662, "chapter_id": 3908, "verse_number": "२९", "content_sanskrit": "गव्यूतिमात्रे न्यवसद् राजा दुर्योधनस्तदा ।\nप्रयातो वाहनैः सर्वैस्ततो द्वैतवनं सरः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134663, "chapter_id": 3908, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि दुर्योधनप्रस्थाने अष्टाविंशदधिकद्विशततमोऽध्यायः ॥२२८॥\n॥ घोषयात्रापर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]