[{"id": 5000535000, "chapter_id": 9535, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टाविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000535001, "chapter_id": 9535, "verse_number": "६-१२८-१", "content_sanskrit": "शिरस्यञ्जलिमाधाय कैकेय्यानन्दवर्धनः।\nबभाषे भरतो ज्येष्ठं रामं सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000535002, "chapter_id": 9535, "verse_number": "६-१२८-२", "content_sanskrit": "पूजिता मामिका माता दत्तं राज्यमिदं मम।\nतद् ददामि पुनस्तुभ्यं यथा त्वमददा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000535003, "chapter_id": 9535, "verse_number": "६-१२८-३", "content_sanskrit": "धुरमेकाकिना न्यस्तां वृषभेण बलीयसा।\nकिशोरवद् गुरुं भारं न वोढुमहमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000535004, "chapter_id": 9535, "verse_number": "६-१२८-४", "content_sanskrit": "वारिवेगेन महता भिन्नः सेतुरिव क्षरन्।\nदुर्बन्धनमिदं मन्ये राज्यच्छिद्रमसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000535005, "chapter_id": 9535, "verse_number": "६-१२८-५", "content_sanskrit": "गतिं खर इवाश्वस्य हंसस्येव च वायसः।\nनान्वेतुमुत्सहे वीर तव मार्गमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000535006, "chapter_id": 9535, "verse_number": "६-१२८-६", "content_sanskrit": "यथा चारोपितो वृक्षो जातश्चान्तर्निवेशने।\nमहानपि दुरारोहो महास्कन्धः प्रशाखवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000535007, "chapter_id": 9535, "verse_number": "६-१२८-७", "content_sanskrit": "शीर्येत पुष्पितो भूत्वा न फलानि प्रदर्शयन्।\nतस्य नानुभवेदर्थं यस्य हेतोः स रोपितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000535008, "chapter_id": 9535, "verse_number": "६-१२८-८", "content_sanskrit": "एषोपमा महाबाहो त्वमर्थं वेत्तुमर्हसि।\nयद्यस्मान् मनुजेन्द्र त्वं भर्ता भृत्यान् न शाधि हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000535009, "chapter_id": 9535, "verse_number": "६-१२८-९", "content_sanskrit": "जगदद्याभिषिक्तं त्वामनुपश्यतु राघव।\nप्रतपन्तमिवादित्यं मध्याह्ने दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000535010, "chapter_id": 9535, "verse_number": "६-१२८-१०", "content_sanskrit": "तूर्यसंघातनिर्घोषैः काञ्चीनूपुरनिःस्वनैः।\nमधुरैर्गीतशब्दैश्च प्रतिबुध्यस्व शेष्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000535011, "chapter_id": 9535, "verse_number": "६-१२८-११", "content_sanskrit": "यावदावर्तते चक्रं यावती च वसुंधरा।\nतावत् त्वमिह लोकस्य स्वामित्वमनुवर्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000535012, "chapter_id": 9535, "verse_number": "६-१२८-१२", "content_sanskrit": "भरतस्य वचः श्रुत्वा रामः परपुरञ्जयः।\nतथेति प्रतिजग्राह निषसादासने शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000535013, "chapter_id": 9535, "verse_number": "६-१२८-१३", "content_sanskrit": "ततः शत्रुघ्नवचनान्निपुणाः श्मश्रुवर्धनाः।\nसुखहस्ताः सुशीघ्राश्च राघवं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000535014, "chapter_id": 9535, "verse_number": "६-१२८-१४", "content_sanskrit": "पूर्वं तु भरते स्नाते लक्ष्मणे च महाबले।\nसुग्रीवे वानरेन्द्रे च राक्षसेन्द्रे विभीषणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000535015, "chapter_id": 9535, "verse_number": "६-१२८-१५", "content_sanskrit": "विशोधितजटः स्नातश्चित्रमाल्यानुलेपनः।\nमहार्हवसनोपेतस्तस्थौ तत्र श्रिया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000535016, "chapter_id": 9535, "verse_number": "६-१२८-१६", "content_sanskrit": "प्रतिकर्म च रामस्य कारयामास वीर्यवान्।\nलक्ष्मणस्य च लक्ष्मीवानिक्ष्वाकुकुलवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000535017, "chapter_id": 9535, "verse_number": "६-१२८-१७", "content_sanskrit": "प्रतिकर्म च सीतायाः सर्वा दशरथस्त्रियः।\nआत्मनैव तदा चक्रुर्मनस्विन्यो मनोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000535018, "chapter_id": 9535, "verse_number": "६-१२८-१८", "content_sanskrit": "ततो वानरपत्नीनां सर्वासामेव शोभनम्।\nचकार यत्नात् कौसल्या प्रहृष्टा पुत्रवत्सला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000535019, "chapter_id": 9535, "verse_number": "६-१२८-१९", "content_sanskrit": "ततः शत्रुघ्नवचनात् सुमन्त्रो नाम सारथिः।\nयोजयित्वाभिचक्राम रथं सर्वाङ्गशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000535020, "chapter_id": 9535, "verse_number": "६-१२८-२०", "content_sanskrit": "अग्न्यर्कामलसंकाशं दिव्यं दृष्ट्वा रथं स्थितम्।\nआरुरोह महाबाहू रामः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000535021, "chapter_id": 9535, "verse_number": "६-१२८-२१", "content_sanskrit": "सुग्रीवो हनुमांश्चैव महेन्द्रसदृशद्युती।\nस्नातौ दिव्यनिभैर्वस्त्रैर्जग्मतुः शुभकुण्डलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000535022, "chapter_id": 9535, "verse_number": "६-१२८-२२", "content_sanskrit": "सर्वाभरणजुष्टाश्च ययुस्ताः शुभकुण्डलाः।\nसुग्रीवपत्न्यः सीता च द्रष्टुं नगरमुत्सुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000535023, "chapter_id": 9535, "verse_number": "६-१२८-२३", "content_sanskrit": "अयोध्यायां च सचिवा राज्ञो दशरथस्य च।\nपुरोहितं पुरस्कृत्य मन्त्रयामासुरर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000535024, "chapter_id": 9535, "verse_number": "६-१२८-२४", "content_sanskrit": "अशोको विजयश्चैव सिद्धार्थश्च समाहिताः।\nमन्त्रयन् रामवृद्ध्यर्थमृद्ध्यर्थं नगरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000535025, "chapter_id": 9535, "verse_number": "६-१२८-२५", "content_sanskrit": "सर्वमेवाभिषेकार्थं जयार्हस्य महात्मनः।\nकर्तुमर्हथ रामस्य यद् यन्मङ्गलपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000535026, "chapter_id": 9535, "verse_number": "६-१२८-२६", "content_sanskrit": "इति ते मन्त्रिणः सर्वे संदिश्य च पुरोहितः।\nनगरान्निर्ययुस्तूर्णं रामदर्शनबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000535027, "chapter_id": 9535, "verse_number": "६-१२८-२७", "content_sanskrit": "हरियुक्तं सहस्राक्षो रथमिन्द्र इवानघः।\nप्रययौ रथमास्थाय रामो नगरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000535028, "chapter_id": 9535, "verse_number": "६-१२८-२८", "content_sanskrit": "जग्राह भरतो रश्मीन् शत्रुघ्नश्छत्रमाददे।\nलक्ष्मणो व्यजनं तस्य मूर्ध्नि संवीजयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000535029, "chapter_id": 9535, "verse_number": "६-१२८-२९", "content_sanskrit": "श्वेतं च वालव्यजनं जगृहे परितः स्थितः।\nअपरं चन्द्रसंकाशं राक्षसेन्द्रो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000535030, "chapter_id": 9535, "verse_number": "६-१२८-३०", "content_sanskrit": "ऋषिसङ्घैस्तदाऽऽकाशे देवैश्च समरुद‍्गणैः।\nस्तूयमानस्य रामस्य शुश्रुवे मधुरध्वनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000535031, "chapter_id": 9535, "verse_number": "६-१२८-३१", "content_sanskrit": "ततः शत्रुञ्जयं नाम कुञ्जरं पर्वतोपमम्।\nआरुरोह महातेजाः सुग्रीवः प्लवगर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000535032, "chapter_id": 9535, "verse_number": "६-१२८-३२", "content_sanskrit": "नव नागसहस्राणि ययुरास्थाय वानराः।\nमानुषं विग्रहं कृत्वा सर्वाभरणभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000535033, "chapter_id": 9535, "verse_number": "६-१२८-३३", "content_sanskrit": "शङ्खशब्दप्रणादैश्च दुन्दुभीनां च निःस्वनैः।\nप्रययौ पुरुषव्याघ्रस्तां पुरीं हर्म्यमालिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000535034, "chapter_id": 9535, "verse_number": "६-१२८-३४", "content_sanskrit": "ददृशुस्ते समायान्तं राघवं सपुरःसरम्।\nविराजमानं वपुषा रथेनातिरथं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000535035, "chapter_id": 9535, "verse_number": "६-१२८-३५", "content_sanskrit": "ते वर्धयित्वा काकुत्स्थं रामेण प्रतिनन्दिताः।\nअनुजग्मुर्महात्मानं भ्रातृभिः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000535036, "chapter_id": 9535, "verse_number": "६-१२८-३६", "content_sanskrit": "अमात्यैर्ब्राह्मणैश्चैव तथा प्रकृतिभिर्वृतः।\nश्रिया विरुरुचे रामो नक्षत्रैरिव चन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000535037, "chapter_id": 9535, "verse_number": "६-१२८-३७", "content_sanskrit": "स पुरोगामिभिस्तूर्यैस्तालस्वस्तिकपाणिभिः।\nप्रव्याहरद्भिर्मुदितैर्मङ्गलानि वृतो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000535038, "chapter_id": 9535, "verse_number": "६-१२८-३८", "content_sanskrit": "अक्षतं जातरूपं च गावः कन्याः सहद्विजाः।\nनरा मोदकहस्ताश्च रामस्य पुरतो ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000535039, "chapter_id": 9535, "verse_number": "६-१२८-३९", "content_sanskrit": "सख्यं च रामः सुग्रीवे प्रभावं चानिलात्मजे।\nवानराणां च तत् कर्म ह्याचचक्षेऽथ मन्त्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000535040, "chapter_id": 9535, "verse_number": "६-१२८-४०", "content_sanskrit": "श्रुत्वा च विस्मयं जग्मुरयोध्यापुरवासिनः।\nवानराणां च तत् कर्म राक्षसानां च तद् बलम्।\nविभीषणस्य संयोगमाचचक्षेऽथ मन्त्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000535041, "chapter_id": 9535, "verse_number": "६-१२८-४१", "content_sanskrit": "द्युतिमानेतदाख्याय रामो वानरसंयुतः।\nहृष्टपुष्टजनाकीर्णामयोध्यां प्रविवेश सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000535042, "chapter_id": 9535, "verse_number": "६-१२८-४२", "content_sanskrit": "ततो ह्यभ्युच्छ्रयन् पौराः पताकाश्च गृहे गृहे।\nऐक्ष्वाकाध्युषितं रम्यमाससाद पितुर्गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000535043, "chapter_id": 9535, "verse_number": "६-१२८-४३", "content_sanskrit": "अथाब्रवीद् राजपुत्रो भरतं धर्मिणां वरम्।\nअर्थोपहितया वाचा मधुरं रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000535044, "chapter_id": 9535, "verse_number": "६-१२८-४४", "content_sanskrit": "पितुर्भवनमासाद्य प्रविश्य च महात्मनः।\nकौसल्यां च सुमित्रां च कैकेयीमभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000535045, "chapter_id": 9535, "verse_number": "६-१२८-४५", "content_sanskrit": "तच्च मद्भवनं श्रेष्ठं साशोकवनिकं महत्।\nमुक्तावैदूर्यसंकीर्णं सुग्रीवाय निवेदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000535046, "chapter_id": 9535, "verse_number": "६-१२८-४६", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा भरतः सत्यविक्रमः।\nहस्ते गृहीत्वा सुग्रीवं प्रविवेश तमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000535047, "chapter_id": 9535, "verse_number": "६-१२८-४७", "content_sanskrit": "ततस्तैलप्रदीपांश्च पर्यङ्कास्तरणानि च।\nगृहीत्वा विविशुः क्षिप्रं शत्रुघ्नेन प्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000535048, "chapter_id": 9535, "verse_number": "६-१२८-४८", "content_sanskrit": "उवाच च महातेजाः सुग्रीवं राघवानुजः।\nअभिषेकाय रामस्य दूतानाज्ञापय प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000535049, "chapter_id": 9535, "verse_number": "६-१२८-४९", "content_sanskrit": "सौवर्णान् वानरेन्द्राणां चतुर्णां चतुरो घटान्।\nददौ क्षिप्रं स सुग्रीवः सर्वरत्नविभूषितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000535050, "chapter_id": 9535, "verse_number": "६-१२८-५०", "content_sanskrit": "तथा प्रत्यूषसमये चतुर्णां सागराम्भसाम्।\nपूर्णैर्घटैः प्रतीक्षध्वं तथा कुरुत वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000535051, "chapter_id": 9535, "verse_number": "६-१२८-५१", "content_sanskrit": "एवमुक्ता महात्मानो वानरा वारणोपमाः।\nउत्पेतुर्गगनं शीघ्रं गरुडा इव शीघ्रगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000535052, "chapter_id": 9535, "verse_number": "६-१२८-५२", "content_sanskrit": "जाम्बवांश्च हनूमांश्च वेगदर्शी च वानरः।\nऋषभश्चैव कलशाञ्जलपूर्णानथानयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000535053, "chapter_id": 9535, "verse_number": "६-१२८-५३", "content_sanskrit": "नदीशतानां पञ्चानां जलं कुम्भैरुपाहरन्।\nपूर्वात् समुद्रात् कलशं जलपूर्णमथानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000535054, "chapter_id": 9535, "verse_number": "६-१२८-५४", "content_sanskrit": "सुषेणः सत्त्वसम्पन्नः सर्वरत्नविभूषितम्।\nऋषभो दक्षिणात्तूर्णं समुद्राज्जलमानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000535055, "chapter_id": 9535, "verse_number": "६-१२८-५५", "content_sanskrit": "रक्तचन्दनकर्पूरैः संवृतं काञ्चनं घटम्।\nगवयः पश्चिमात् तोयमाजहार महार्णवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000535056, "chapter_id": 9535, "verse_number": "६-१२८-५६", "content_sanskrit": "रत्नकुम्भेन महता शीतं मारुतविक्रमः।\nउत्तराच्च जलं शीघ्रं गरुडानिलविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000535057, "chapter_id": 9535, "verse_number": "६-१२८-५७", "content_sanskrit": "आजहार स धर्मात्मानिलः सर्वगुणान्वितः।\nततस्तैर्वानरश्रेष्ठैरानीतं प्रेक्ष्य तज्जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000535058, "chapter_id": 9535, "verse_number": "६-१२८-५८", "content_sanskrit": "अभिषेकाय रामस्य शत्रुघ्नः सचिवैः सह।\nपुरोहिताय श्रेष्ठाय सुहृद‍्भ्यश्च न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000535059, "chapter_id": 9535, "verse_number": "६-१२८-५९", "content_sanskrit": "ततः स प्रयतो वृद्धो वसिष्ठो ब्राह्मणैः सह।\nरामं रत्नमये पीठे ससीतं संन्यवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000535060, "chapter_id": 9535, "verse_number": "६-१२८-६०", "content_sanskrit": "वसिष्ठो वामदेवश्च जाबालिरथ काश्यपः।\nकात्यायनः सुयज्ञश्च गौतमो विजयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000535061, "chapter_id": 9535, "verse_number": "६-१२८-६१", "content_sanskrit": "अभ्यषिञ्चन्नरव्याघ्रं प्रसन्नेन सुगन्धिना।\nसलिलेन सहस्राक्षं वसवो वासवं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000535062, "chapter_id": 9535, "verse_number": "६-१२८-६२", "content_sanskrit": "ऋत्विग्भिर्ब्राह्मणैः पूर्वं कन्याभिर्मन्त्रिभिस्तथा।\nयोधैश्चैवाभ्यषिञ्चस्ते सम्प्रहृष्टैः सनैगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000535063, "chapter_id": 9535, "verse_number": "६-१२८-६३", "content_sanskrit": "सर्वौषधिरसैश्चापि दैवतैर्नभसि स्थितैः।\nचतुर्भिर्लोकपालैश्च सर्वैर्देवैश्च संगतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000535064, "chapter_id": 9535, "verse_number": "६-१२८-६४", "content_sanskrit": "ब्रह्मणा निर्मितं पूर्वं किरीटं रत्नशोभितम्।\nअभिषिक्तः पुरा येन मनुस्तं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000535065, "chapter_id": 9535, "verse_number": "६-१२८-६५", "content_sanskrit": "तस्यान्ववाये राजानः क्रमाद् येनाभिषेचिताः।\nसभायां हेमक्लृप्तायां शोभितायां महाधनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000535066, "chapter_id": 9535, "verse_number": "६-१२८-६६", "content_sanskrit": "रत्नैर्नानाविधैश्चैव चित्रितायां सुशोभनैः।\nनानारत्नमये पीठे कल्पयित्वा यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000535067, "chapter_id": 9535, "verse_number": "६-१२८-६७", "content_sanskrit": "किरीटेन ततः पश्चाद् वसिष्ठेन महात्मना।\nऋत्विग्भिर्भूषणैश्चैव समयोक्ष्यत राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000535068, "chapter_id": 9535, "verse_number": "६-१२८-६८", "content_sanskrit": "छत्रं तस्य च जग्राह शत्रुघ्नः पाण्डुरं शुभम्।\nश्वेतं च वालव्यजनं सुग्रीवो वानरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000535069, "chapter_id": 9535, "verse_number": "६-१२८-६९", "content_sanskrit": "अपरं चन्द्रसंकाशं राक्षसेन्द्रो विभीषणः।\nमालां ज्वलन्तीं वपुषा काञ्चनीं शतपुष्कराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000535070, "chapter_id": 9535, "verse_number": "६-१२८-७०", "content_sanskrit": "राघवाय ददौ वायुर्वासवेन प्रचोदितः।\nसर्वरत्नसमायुक्तं मणिभिश्च विभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000535071, "chapter_id": 9535, "verse_number": "६-१२८-७१", "content_sanskrit": "मुक्ताहारं नरेन्द्राय ददौ शक्रप्रचोदितः।\nप्रजगुर्देवगन्धर्वा ननृतुश्चाप्सरोगणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000535072, "chapter_id": 9535, "verse_number": "६-१२८-७२", "content_sanskrit": "अभिषेके तदर्हस्य तदा रामस्य धीमतः।\nभूमिः सस्यवती चैव फलवन्तश्च पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000535073, "chapter_id": 9535, "verse_number": "६-१२८-७३", "content_sanskrit": "गन्धवन्ति च पुष्पाणि बभूवू राघवोत्सवे।\nसहस्रशतमश्वानां धेनूनां च गवां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000535074, "chapter_id": 9535, "verse_number": "६-१२८-७४", "content_sanskrit": "ददौ शतवृषान् पूर्वं द्विजेभ्यो मनुजर्षभः।\nत्रिंशत्कोटीर्हिरण्यस्य ब्राह्मणेभ्यो ददौ पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000535075, "chapter_id": 9535, "verse_number": "६-१२८-७५", "content_sanskrit": "नानाभरणवस्त्राणि महार्हाणि च राघवः।\nअर्करश्मिप्रतीकाशां काञ्चनीं मणिविग्रहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000535076, "chapter_id": 9535, "verse_number": "६-१२८-७६", "content_sanskrit": "सुग्रीवाय स्रजं दिव्यां प्रायच्छन्मनुजाधिपः।\nवैदूर्यमयचित्रे च चन्द्ररश्मिविभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000535077, "chapter_id": 9535, "verse_number": "६-१२८-७७", "content_sanskrit": "वालिपुत्राय धृतिमानङ्गदायाङ्गदे ददौ।\nमणिप्रवरजुष्टं तं मुक्ताहारमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000535078, "chapter_id": 9535, "verse_number": "६-१२८-७८", "content_sanskrit": "सीतायै प्रददौ रामश्चन्द्ररश्मिसमप्रभम्।\nअरजे वाससी दिव्ये शुभान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000535079, "chapter_id": 9535, "verse_number": "६-१२८-७९", "content_sanskrit": "अवेक्षमाणा वैदेही प्रददौ वायुसूनवे।\nअवमुच्यात्मनः कण्ठाद्धारं जनकनन्दिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000535080, "chapter_id": 9535, "verse_number": "६-१२८-८०", "content_sanskrit": "अवैक्षत हरीन् सर्वान् भर्तारं च मुहुर्मुहुः।\nतामिङ्गितज्ञः सम्प्रेक्ष्य बभाषे जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000535081, "chapter_id": 9535, "verse_number": "६-१२८-८१", "content_sanskrit": "प्रदेहि सुभगे हारं यस्य तुष्टासि भामिनि।\nअथ सा वायुपुत्राय तं हारमसितेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000535082, "chapter_id": 9535, "verse_number": "६-१२८-८२", "content_sanskrit": "तेजो धृतिर्यशो दाक्ष्यं सामर्थ्यं विनयो नयः।\nपौरुषं विक्रमो बुद्धिर्यस्मिन् नेतानि नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000535083, "chapter_id": 9535, "verse_number": "६-१२८-८३", "content_sanskrit": "हनूमांस्तेन हारेण शुशुभे वानरर्षभः।\nचन्द्रांशुचयगौरेण श्वेताभ्रेण यथाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000535084, "chapter_id": 9535, "verse_number": "६-१२८-८४", "content_sanskrit": "सर्वे वानरवृद्धाश्च ये चान्ये वानरोत्तमाः।\nवासोभिर्भूषणैश्चैव यथार्हं प्रतिपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000535085, "chapter_id": 9535, "verse_number": "६-१२८-८५", "content_sanskrit": "विभीषणोऽथ सुग्रीवो हनूमाञ्जाम्बवांस्तथा।\nसर्वे वानरमुख्याश्च रामेणाक्लिष्टकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000535086, "chapter_id": 9535, "verse_number": "६-१२८-८६", "content_sanskrit": "यथार्हं पूजिताः सर्वे कामै रत्नैश्च पुष्कलैः।\nप्रहृष्टमनसः सर्वे जग्मुरेव यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000535087, "chapter_id": 9535, "verse_number": "६-१२८-८७", "content_sanskrit": "ततो द्विविदमैन्दाभ्यां नीलाय च परंतपः।\nसर्वान् कामगुणान् वीक्ष्य प्रददौ वसुधाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000535088, "chapter_id": 9535, "verse_number": "६-१२८-८८", "content_sanskrit": "दृष्ट्वा सर्वे महात्मानस्ततस्ते वानरर्षभाः।\nविसृष्टाः पार्थिवेन्द्रेण किष्किन्धां समुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000535089, "chapter_id": 9535, "verse_number": "६-१२८-८९", "content_sanskrit": "सुग्रीवो वानरश्रेष्ठो दृष्ट्वा रामाभिषेचनम्।\nपूजितश्चैव रामेण किष्किन्धां प्राविशत् पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000535090, "chapter_id": 9535, "verse_number": "६-१२८-९०", "content_sanskrit": "विभीषणोऽपि धर्मात्मा सह तैर्नैर्ऋतर्षभैः।\nलब्ध्वा कुलधनं राजा लङ्कां प्रायान्महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000535091, "chapter_id": 9535, "verse_number": "६-१२८-९१", "content_sanskrit": "स राज्यमखिलं शासन्निहतारिर्महायशाः।\nराघवः परमोदारः शशास परया मुदा।\nउवाच लक्ष्मणं रामो धर्मज्ञं धर्मवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000535092, "chapter_id": 9535, "verse_number": "६-१२८-९२", "content_sanskrit": "आतिष्ठ धर्मज्ञ मया सहेमां\nगां पूर्वराजाध्युषितां बलेन।\nतुल्यं मया त्वं पितृभिर्धृता या\nतां यौवराज्ये धुरमुद्वहस्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000535093, "chapter_id": 9535, "verse_number": "६-१२८-९३", "content_sanskrit": "सर्वात्मना पर्यनुनीयमानो\nयदा न सौमित्रिरुपैति योगम्।\nनियुज्यमानो भुवि यौवराज्ये\nततोऽभ्यषिञ्चद् भरतं महात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000535094, "chapter_id": 9535, "verse_number": "६-१२८-९४", "content_sanskrit": "पौण्डरीकाश्वमेधाभ्यां वाजपेयेन चासकृत्।\nअन्यैश्च विविधैर्यज्ञैरयजत् पार्थिवात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000535095, "chapter_id": 9535, "verse_number": "६-१२८-९५", "content_sanskrit": "राज्यं दशसहस्राणि प्राप्य वर्षाणि राघवः।\nशताश्वमेधानाजह्रे सदश्वान् भूरिदक्षिणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000535096, "chapter_id": 9535, "verse_number": "६-१२८-९६", "content_sanskrit": "आजानुलम्बिबाहुः स महावक्षाः प्रतापवान्।\nलक्ष्मणानुचरो रामः शशास पृथिवीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000535097, "chapter_id": 9535, "verse_number": "६-१२८-९७", "content_sanskrit": "राघवश्चापि धर्मात्मा प्राप्य राज्यमनुत्तमम्।\nईजे बहुविधैर्यज्ञैः ससुहृज्ज्ञातिबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000535098, "chapter_id": 9535, "verse_number": "६-१२८-९८", "content_sanskrit": "न पर्यदेवन् विधवा न च व्यालकृतं भयम्।\nन व्याधिजं भयं चासीद् रामे राज्यं प्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000535099, "chapter_id": 9535, "verse_number": "६-१२८-९९", "content_sanskrit": "निर्दस्युरभवल्लोको नानर्थं कश्चिदस्पृशत्।\nन च स्म वृद्धा बालानां प्रेतकार्याणि कुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 5000535100, "chapter_id": 9535, "verse_number": "६-१२८-१००", "content_sanskrit": "सर्वं मुदितमेवासीत् सर्वो धर्मपरोऽभवत्।\nराममेवानुपश्यन्तो नाभ्यहिंसन् परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 5000535101, "chapter_id": 9535, "verse_number": "६-१२८-१०१", "content_sanskrit": "आसन् वर्षसहस्राणि तथा पुत्रसहस्रिणः।\nनिरामया विशोकाश्च रामे राज्यं प्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 5000535102, "chapter_id": 9535, "verse_number": "६-१२८-१०२", "content_sanskrit": "रामो रामो राम इति प्रजानामभवन् कथाः।\nरामभूतं जगदभूद् रामे राज्यं प्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 5000535103, "chapter_id": 9535, "verse_number": "६-१२८-१०३", "content_sanskrit": "नित्यमूला नित्यफलास्तरवस्तत्र पुष्पिताः।\nकामवर्षी च पर्जन्यः सुखस्पर्शश्च मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 5000535104, "chapter_id": 9535, "verse_number": "६-१२८-१०४", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा लोभविवर्जिताः।\nस्वकर्मसु प्रवर्तन्ते तुष्टाः स्वैरेव कर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 5000535105, "chapter_id": 9535, "verse_number": "६-१२८-१०५", "content_sanskrit": "आसन् प्रजा धर्मपरा रामे शासति नानृताः।\nसर्वे लक्षणसम्पन्नाः सर्वे धर्मपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 5000535106, "chapter_id": 9535, "verse_number": "६-१२८-१०६", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च।\nभ्रातृभिः सहितः श्रीमान् रामो राज्यमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 5000535107, "chapter_id": 9535, "verse_number": "६-१२८-१०७", "content_sanskrit": "धर्म्यं यशस्यमायुष्यं राज्ञां च विजयावहम्।\nआदिकाव्यमिदं चार्षं पुरा वाल्मीकिना कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 5000535108, "chapter_id": 9535, "verse_number": "६-१२८-१०८", "content_sanskrit": "यः शृणोति सदा लोके नरः पापात् प्रमुच्यते।\nपुत्रकामश्च पुत्रान् वै धनकामो धनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 5000535109, "chapter_id": 9535, "verse_number": "६-१२८-१०९", "content_sanskrit": "लभते मनुजो लोके श्रुत्वा रामाभिषेचनम्।\nमहीं विजयते राजा रिपूंश्चाप्यधितिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 5000535110, "chapter_id": 9535, "verse_number": "६-१२८-११०", "content_sanskrit": "राघवेण यथा माता सुमित्रा लक्ष्मणेन च।\nभरतेन च कैकेयी जीवपुत्रास्तथा स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 5000535111, "chapter_id": 9535, "verse_number": "६-१२८-१११", "content_sanskrit": "भविष्यन्ति सदानन्दाः पुत्रपौत्रसमन्विताः।\nश्रुत्वा रामायणमिदं दीर्घमायुश्च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 5000535112, "chapter_id": 9535, "verse_number": "६-१२८-११२", "content_sanskrit": "रामस्य विजयं चेमं सर्वमक्लिष्टकर्मणः।\nशृणोति य इदं काव्यं पुरा वाल्मीकिना कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 5000535113, "chapter_id": 9535, "verse_number": "६-१२८-११३", "content_sanskrit": "श्रद्दधानो जितक्रोधो दुर्गाण्यतितरत्यसौ।\nसमागम्य प्रवासान्ते रमन्ते सह बान्धवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 5000535114, "chapter_id": 9535, "verse_number": "६-१२८-११४", "content_sanskrit": "शृण्वन्ति य इदं काव्यं पुरा वाल्मीकिना कृतम्।\nते प्रार्थितान् वरान् सर्वान् प्राप्नुवन्तीह राघवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 5000535115, "chapter_id": 9535, "verse_number": "६-१२८-११५", "content_sanskrit": "श्रवणेन सुराः सर्वे प्रीयन्ते सम्प्रशृण्वताम्।\nविनायकाश्च शाम्यन्ति गृहे तिष्ठन्ति यस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 5000535116, "chapter_id": 9535, "verse_number": "६-१२८-११६", "content_sanskrit": "विजयेत महीं राजा प्रवासी स्वस्तिमान् भवेत्।\nस्त्रियो रजस्वलाः श्रुत्वा पुत्रान् सूयुरनुत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 5000535117, "chapter_id": 9535, "verse_number": "६-१२८-११७", "content_sanskrit": "पूजयंश्च पठंश्चैनमितिहासं पुरातनम्।\nसर्वपापैः प्रमुच्येत दीर्घमायुरवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 5000535118, "chapter_id": 9535, "verse_number": "६-१२८-११८", "content_sanskrit": "प्रणम्य शिरसा नित्यं श्रोतव्यं क्षत्रियैर्द्विजात्।\nऐश्वर्यं पुत्रलाभश्च भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 5000535119, "chapter_id": 9535, "verse_number": "६-१२८-११९", "content_sanskrit": "रामायणमिदं कृत्स्नं शृण्वतः पठतः सदा।\nप्रीयते सततं रामः स हि विष्णुः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 5000535120, "chapter_id": 9535, "verse_number": "६-१२८-१२०", "content_sanskrit": "आदिदेवो महाबाहुर्हरिर्नारायणः प्रभुः।\nसाक्षाद् रामो रघुश्रेष्ठः शेषो लक्ष्मण उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 5000535121, "chapter_id": 9535, "verse_number": "६-१२८-१२१", "content_sanskrit": "एवमेतत् पुरावृत्तमाख्यानं भद्रमस्तु वः।\nप्रव्याहरत विस्रब्धं बलं विष्णोः प्रवर्धताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 5000535122, "chapter_id": 9535, "verse_number": "६-१२८-१२२", "content_sanskrit": "देवाश्च सर्वे तुष्यन्ति ग्रहणाच्छ्रवणात् तथा।\nरामायणस्य श्रवणे तृप्यन्ति पितरः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 5000535123, "chapter_id": 9535, "verse_number": "६-१२८-१२३", "content_sanskrit": "भक्त्या रामस्य ये चेमां संहितामृषिणा कृताम्।\nये लिखन्तीह च नरास्तेषां वासस्त्रिविष्टपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 5000535124, "chapter_id": 9535, "verse_number": "६-१२८-१२४", "content_sanskrit": "कुटुम्बवृद्धिं धनधान्यवृद्धिं\nस्त्रियश्च मुख्याः सुखमुत्तमं च।\nश्रुत्वा शुभं काव्यमिदं महार्थं\nप्राप्नोति सर्वां भुवि चार्थसिद्धिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 5000535125, "chapter_id": 9535, "verse_number": "६-१२८-१२५", "content_sanskrit": "आयुष्यमारोग्यकरं यशस्यं\nसौभ्रातृकं बुद्धिकरं शुभं च।\nश्रोतव्यमेतन्नियमेन सद्भि-\nराख्यानमोजस्करमृद्धिकामैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 5000535126, "chapter_id": 9535, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टाविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]