[{"id": 2131890, "chapter_id": 3852, "verse_number": "१", "content_sanskrit": "भवानेतादृशो लोके वेदवेदाङ्गपारगः ।\nब्रूहि किं कुर्वतः कर्म भवेद् गतिरनुत्तमा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131891, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131892, "chapter_id": 3852, "verse_number": "२", "content_sanskrit": "पात्रे दत्त्वा प्रियाण्युक्त्वा सत्यमुक्त्वा च भारत ।\nअहिंसानिरतः स्वर्गं गच्छेदिति मतिर्मम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131893, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131894, "chapter_id": 3852, "verse_number": "३", "content_sanskrit": "दानाद्वा सर्प सत्याद्वा किमतो गुरु दृश्यते ।\nअहिंसाप्रिययोश्चैव गुरुलाघवमुच्यताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131895, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131896, "chapter_id": 3852, "verse_number": "४", "content_sanskrit": "दानं च सत्यं तत्त्वं वा अहिंसा प्रियमेव च ।\nएषां कार्यगरीयस्त्वाद् दृश्यते गुरुलाघवम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131897, "chapter_id": 3852, "verse_number": "५", "content_sanskrit": "क्वचिद्दानप्रयोगाद्धि सत्यमेव विशिष्यते ।\nसत्यवाक्याच्च राजेन्द्र किञ्चिद्दानं विशिष्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131898, "chapter_id": 3852, "verse_number": "६", "content_sanskrit": "एवमेव महेष्वास प्रियवाक्यान्महीपते ।\nअहिंसा दृश्यते गुर्वी ततश्च प्रियमिष्यते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131899, "chapter_id": 3852, "verse_number": "७", "content_sanskrit": "एवमेतद् भवेद् राजन् कार्यापेक्षमनन्तरम् ।\nयदभिप्रेतमन्यत् ते ब्रूहि यावद् ब्रवीम्यहम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131900, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131901, "chapter_id": 3852, "verse_number": "८", "content_sanskrit": "कथं स्वर्गे गतिः सर्प कर्मणां च फलं ध्रुवम् ।\nअशरीरस्य दृश्येत प्रब्रूहि विषयांश्च मे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131902, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131903, "chapter_id": 3852, "verse_number": "९", "content_sanskrit": "तिस्रो वै गतयो राजन् परिदृष्टाः स्वकर्मभिः ।\nमानुषं स्वर्गवासश्च तिर्यग्योनिश्च तत् त्रिधा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131904, "chapter_id": 3852, "verse_number": "१०", "content_sanskrit": "तत्र वै मानुषाल्लोकाद् दानादिभिरतन्द्रितः ।\nअहिंसार्थसमायुक्तैः कारणैः स्वर्गमश्नुते \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131905, "chapter_id": 3852, "verse_number": "११", "content_sanskrit": "विपरीतैश्च राजेन्द्र कारणैर्मानुषो भवेत् ।\nतिर्यग्योनिस्तथा तात विशेषश्चात्र वक्ष्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131906, "chapter_id": 3852, "verse_number": "१२", "content_sanskrit": "कामक्रोधसमायुक्तो हिंसालोभसमन्वितः ।\nमनुष्यत्वात् परिभ्रष्टस्तिर्यग्योनौ प्रसूयते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131907, "chapter_id": 3852, "verse_number": "१३", "content_sanskrit": "तिर्यग्योन्याः पृथग्भावो मनुष्यार्थे विधीयते ।\nगवादिभ्यस्तथाश्वेभ्यो देवत्वमपि दृश्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131908, "chapter_id": 3852, "verse_number": "१४", "content_sanskrit": "सोऽयमेता गतिस्तात जन्तुश्चरति कार्यवान् ।\nनित्ये महति चात्मानमवस्थापयते द्विजः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131909, "chapter_id": 3852, "verse_number": "१५", "content_sanskrit": "जातो जातश्च बलवद् भुङ्क्ते चात्मा स देहवान् ।\nफलार्थस्तात निष्पृक्तः प्रजापालनभावनः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131910, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131911, "chapter_id": 3852, "verse_number": "१६", "content_sanskrit": "शब्दे स्पर्शे च रूपे च तथैव रसगन्धयोः ।\nतस्याधिष्ठानमव्यग्रो ब्रूहि सर्प यथातथम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131912, "chapter_id": 3852, "verse_number": "१७", "content_sanskrit": "किं न गृह्णासि विषयान् युगपत् त्वं महामते ।\nएतावदुच्यतां चोक्तं सर्वं पन्नगसत्तम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131913, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131914, "chapter_id": 3852, "verse_number": "१८", "content_sanskrit": "यदात्मद्रव्यमायुष्मन् देहसंश्रयणान्वितम् ।\nकरणाधिष्ठितं भोगानुपभुङ्क्ते यथाविधि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131915, "chapter_id": 3852, "verse_number": "१९", "content_sanskrit": "ज्ञानं चैवात्र बुद्धिश्च मनश्च भरतर्षभ।\nतस्य भोगाधिकरणे करणानि निबोध मे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131916, "chapter_id": 3852, "verse_number": "२०", "content_sanskrit": "मनसा तात पर्येति क्रमशो विषयानिमान्।\nविषयायतनस्थेन भूतात्मा क्षेत्रनिःसृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131917, "chapter_id": 3852, "verse_number": "२१", "content_sanskrit": "तत्र चापि नरव्याघ्र मनो जन्तोर्विधीयते।\nतस्माद् युगपदत्रास्य ग्रहणं नोपपद्यते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131918, "chapter_id": 3852, "verse_number": "२२", "content_sanskrit": "स आत्मा पुरुषव्याघ्र भ्रुवोरन्तरमाश्रितः ।\nबुद्धिं द्रव्येषु सृजति विविधेषु परावराम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131919, "chapter_id": 3852, "verse_number": "२३", "content_sanskrit": "बुद्धेरुत्तरकाला च वेदना दृश्यते बुधैः ।\nएष वै राजशार्दूल विधिः क्षेत्रज्ञभावनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131920, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131921, "chapter_id": 3852, "verse_number": "२४", "content_sanskrit": "मनसश्चापि बुद्धेश्च ब्रूहि मे लक्षणं परम् ।\nएतदध्यात्मविदुषां परं कार्यं विधीयते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131922, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131923, "chapter_id": 3852, "verse_number": "२५", "content_sanskrit": "बुद्धिरात्मानुगा तात उत्पातेन विधीयते ।\nतदाश्रिता हि सञ्ज्ञैषा बुद्धिस्तस्यैषिणी भवेत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131924, "chapter_id": 3852, "verse_number": "२६", "content_sanskrit": "बुद्धिरुत्पद्यते कार्यान्मनस्तूत्पन्नमेव हि ।\nबुद्धेर्गुणविधानेन मनस्तद्गुणवद् भवेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131925, "chapter_id": 3852, "verse_number": "२७", "content_sanskrit": "एतद्विशेषणं तात मनोबुद्ध्योर्यदन्तरम् ।\nत्वमप्यत्राभिसम्बुद्धः कथं वा मन्यते भवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131926, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131927, "chapter_id": 3852, "verse_number": "२८", "content_sanskrit": "अहो बुद्धिमतां श्रेष्ठ शुभा बुद्धिरियं तव ।\nविदितं वेदितव्यं ते कस्मात् समनुपृच्छसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131928, "chapter_id": 3852, "verse_number": "२९", "content_sanskrit": "सर्वज्ञं त्वां कथं मोह आविशत् स्वर्गवासिनम् ।\nएवमद्भुतकर्माणमिति मे संशयो महान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131929, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131930, "chapter_id": 3852, "verse_number": "३०", "content_sanskrit": "सुप्रज्ञमपि चेच्छूरमृद्धिर्मोहयते नरम् ।\nवर्तमानः सुखे सर्वो मुह्यतीति मतिर्मम\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131931, "chapter_id": 3852, "verse_number": "३१", "content_sanskrit": "सोऽहमैश्वर्यमोहेन मदाविष्टो युधिष्ठिर ।\nपतितः प्रतिसम्बुद्धस्त्वां तु सम्बोधयाम्यहम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131932, "chapter_id": 3852, "verse_number": "३२", "content_sanskrit": "कृतं कार्यं महाराज त्वया मम परन्तप ।\nक्षीणः शापः सुकृच्छ्रो मे त्वया सम्भाष्य साधुना\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131933, "chapter_id": 3852, "verse_number": "३३", "content_sanskrit": "अहं हि दिवि दिव्येन विमानेन चरन् पुरा ।\nअभिमानेन मत्तः सन् कञ्चिन्नान्यमचिन्तयम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131934, "chapter_id": 3852, "verse_number": "३४", "content_sanskrit": "ब्रह्मर्षिदेवगन्धर्वयक्षराक्षसपन्नगाः ।\nकरान् मम प्रयच्छन्ति सर्वे त्रैलोक्यवासिनः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131935, "chapter_id": 3852, "verse_number": "३५", "content_sanskrit": "चक्षुषा यं प्रपश्यामि प्राणिनं पृथिवीपते ।\nतस्य तेजो हराम्याशु तद्धि दृष्टेर्बलं मम\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2131936, "chapter_id": 3852, "verse_number": "३६", "content_sanskrit": "ब्रह्मर्षीणां सहस्रं हि उवाह शिबिकां मम ।\nस मामपनयो राजन् भ्रंशयामास वै श्रियः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2131937, "chapter_id": 3852, "verse_number": "३७", "content_sanskrit": "तत्र ह्यगस्त्यः पादेन वहन् स्पृष्टो मया मुनिः ।\nअदृष्टेन ततोऽस्म्युक्तो ध्वंस सर्पेऽति वै रुषा \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2131938, "chapter_id": 3852, "verse_number": "३८", "content_sanskrit": "ततस्तस्माद् विमानाग्र्यात् प्रच्युतश्च्युतलक्षणः ।\nप्रपतन् बुबुधेऽऽत्मानं व्यालीभूतमधोमुखम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2131939, "chapter_id": 3852, "verse_number": "३९", "content_sanskrit": "आयाचं तमहं विप्रं शापस्यान्तो भवेदिति ।\nप्रमादात् सम्प्रमूढस्य भगवन् क्षन्तुमर्हसि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2131940, "chapter_id": 3852, "verse_number": "४०", "content_sanskrit": "ततः स मामुवाचेदं प्रपतन्तं कृपान्वितः ।\nयुधिष्ठिरो धर्मराजः शापात् त्वां मोक्षयिष्यति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2131941, "chapter_id": 3852, "verse_number": "४१", "content_sanskrit": "अभिमानस्य घोरस्य पापस्य च नराधिप ।\nफले क्षीणे महाराज फलं पुण्यमवाप्स्यसि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2131942, "chapter_id": 3852, "verse_number": "४२", "content_sanskrit": "ततो मे विस्मयो जातस्तद्दृष्ट्वा तपसो बलम् ।\nब्रह्म च ब्राह्मणत्वं च येन त्वाहमचूचुदम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2131943, "chapter_id": 3852, "verse_number": "४३", "content_sanskrit": "सत्यं दमस्तपो दानमहिंसा धर्मनित्यता ।\nसाधकानि सदा पुंसां न जातिर्न कुलं नृप\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2131944, "chapter_id": 3852, "verse_number": "४४", "content_sanskrit": "अरिष्ट एष ते भ्राता भीमसेनो महाबलः ।\nस्वस्ति तेऽस्तु महाराज गमिष्यामि दिवं पुनः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2131945, "chapter_id": 3852, "verse_number": "४५", "content_sanskrit": "स चायं पुरुषव्याघ्र कालः पुण्य उपागतः ।\nतदस्मात् कारणात् पार्थ कार्यं मम महत् कृतम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2131946, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2131947, "chapter_id": 3852, "verse_number": "४६", "content_sanskrit": "ततस्तस्मिन् मुहूर्ते तु विमानं कामगामि वै ।\nअवपातेन महता तत्रावाप तदुत्तमम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2131948, "chapter_id": 3852, "verse_number": "४७", "content_sanskrit": "इत्युक्त्वाऽऽजगरं देहं मुक्त्वा स नहुषो नृपः ।\nदिव्यं वपुः समास्थाय गतस्त्रिदिवमेव ह \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2131949, "chapter_id": 3852, "verse_number": "४८", "content_sanskrit": "युधिष्ठिरोऽपि धर्मात्मा भ्रात्रा भीमेन सङ्गतः ।\nधौम्येन सहितः श्रीमानाश्रमं पुनरागमत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2131950, "chapter_id": 3852, "verse_number": "४९", "content_sanskrit": "ततो द्विजेभ्यः सर्वेभ्यः समेतेभ्यो यथातथम् ।\nकथयामास तत्सर्वं धर्मराजो युधिष्ठिरः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2131951, "chapter_id": 3852, "verse_number": "५०", "content_sanskrit": "तच्छ्रुत्वा ते द्विजाः सर्वे भ्रातरश्चास्य ते त्रयः ।\nआसन् सुव्रीडि(ळि)ता राजन् द्रौपदी च यशस्विनी \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2131952, "chapter_id": 3852, "verse_number": "५१", "content_sanskrit": "ते तु सर्वे द्विजश्रेष्ठाः पाण्डवानां हितेप्सया ।\nमैवमित्यब्रुवन् भीमं गर्हयन्तोऽस्य साहसम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2131953, "chapter_id": 3852, "verse_number": "५२", "content_sanskrit": "पाण्डवास्तु भयान्मुक्तं प्रेक्ष्य भीमं महाबलम् ।\nहर्षमाहारयाञ्चक्रुर्विजह्रुश्च मुदा युताः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2131954, "chapter_id": 3852, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अजगरपर्वणि युधिष्ठिरसर्पसंवादे पञ्चसप्तत्यधिकशततमोऽध्यायः ॥१७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2131955, "chapter_id": 3852, "verse_number": "५", "content_sanskrit": "अजगरपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2131956, "chapter_id": 3852, "verse_number": "", "content_sanskrit": "॥ समाप्तम् अजगरपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]