[{"id": 900000898, "chapter_id": 8195, "verse_number": "3.1", "content_sanskrit": "सह नाववतु । सह नौ भुनक्तु ...", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000899, "chapter_id": 8195, "verse_number": "3.2", "content_sanskrit": "ओम् । उशन् ह वै वाजश्रवसः सर्ववेदसं ददौ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000900, "chapter_id": 8195, "verse_number": "3.3", "content_sanskrit": "पीतोदका जग्धतृणा दुग्धदोहा निरिन्द्रियाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000901, "chapter_id": 8195, "verse_number": "3.4", "content_sanskrit": "स होवाच पितरं तात कस्मै मां दास्यसीति द्वितीयं तृतीयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000902, "chapter_id": 8195, "verse_number": "3.5", "content_sanskrit": "बहूनामे प्रथम बहूनामेमि मध्यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000903, "chapter_id": 8195, "verse_number": "3.6", "content_sanskrit": "अनुपश्य यथा पूर्वे प्रतिपश्य तथाऽपरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900000904, "chapter_id": 8195, "verse_number": "3.7", "content_sanskrit": "वैश्वानरः प्रविशत्यतिथिर्ब्राह्मणो गृहान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900000905, "chapter_id": 8195, "verse_number": "3.8", "content_sanskrit": "आशाप्रतीक्षे सङ्गतं सूनृतां चेष्टापूर्ते पुत्रपशूंश्च सर्वान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900000906, "chapter_id": 8195, "verse_number": "3.9", "content_sanskrit": "तिस्रो रात्रीर्यदवात्सीगृहे मे अनश्नन् ब्रह्मन्नतिथिर्नमस्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900000907, "chapter_id": 8195, "verse_number": "3.10", "content_sanskrit": "शान्तसङ्कल्पः सुमना यथा स्याद् वीतमन्युर्गौतमो माऽभिमृत्यो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900000908, "chapter_id": 8195, "verse_number": "3.11", "content_sanskrit": "यथा पुरस्ताद् भविता प्रतीत औद्दालकिरारुणिर्मत्प्रसृष्टः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900000909, "chapter_id": 8195, "verse_number": "3.12", "content_sanskrit": "स्वर्गे लोके न भयं किञ्चनास्ति न तत्र त्वं न जरया बिभेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900000910, "chapter_id": 8195, "verse_number": "3.13", "content_sanskrit": "स त्वमग्निं स्वर्ग्यमध्येषि मृत्यो प्रब्रूहि तं श्रद्दधानाय मह्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900000911, "chapter_id": 8195, "verse_number": "3.14", "content_sanskrit": "प्र ते ब्रवीमि तदु मे निबोध स्वर्ग्यमग्निं नचिकेतः प्रजानन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900000912, "chapter_id": 8195, "verse_number": "3.15", "content_sanskrit": "लोकादिमग्निं तमुवाच तस्मै या इष्टका यावतीर्वा यथा वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900000913, "chapter_id": 8195, "verse_number": "3.16", "content_sanskrit": "तमब्रवीत् प्रीयमाणो महात्मा वरं तवेहाद्य ददानि भूयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900000914, "chapter_id": 8195, "verse_number": "3.17", "content_sanskrit": "त्रिनाचिकेतस्त्रिभिरेत्य सन्धिं त्रिकर्मकृत् तरति जन्ममृत्यू", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900000915, "chapter_id": 8195, "verse_number": "3.18", "content_sanskrit": "त्रिनाचिकेतस्त्रयमेतद् विदित्वा य एवं विद्वांश्चिनुते नाचिकेतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900000916, "chapter_id": 8195, "verse_number": "3.19", "content_sanskrit": "एष तेऽग्निर्नाचिकेतः स्वग्य यमवृणीथा द्वितीयेन वरेण", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900000917, "chapter_id": 8195, "verse_number": "3.20", "content_sanskrit": "येयं प्रेते विचिकित्सा मनुष्ये अस्तीत्येके नायमस्तीति चैके", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900000918, "chapter_id": 8195, "verse_number": "3.21", "content_sanskrit": "देवैरत्रापि विचिकित्सितं पुरा न हि सुझेयोऽणुरेष धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900000919, "chapter_id": 8195, "verse_number": "3.22", "content_sanskrit": "देवैरत्रापि विचिकित्सितं किल त्वं च मृत्यो यन्न सुज्ञेयमात्थ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900000920, "chapter_id": 8195, "verse_number": "3.23", "content_sanskrit": "शतायुषः पुत्रपौत्रान् वृणीष्व बहून् पशून् हस्तिहिरण्यमश्वान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900000921, "chapter_id": 8195, "verse_number": "3.24", "content_sanskrit": "एतत्तुल्यं यदि मन्यसे वरं वृणीष्व वित्तं चिरजीविकां च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900000922, "chapter_id": 8195, "verse_number": "3.25", "content_sanskrit": "ये ये कामा दुर्लभा मर्त्यलोके सर्वान् कामांश्छन्दतः प्रार्थयस्व", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900000923, "chapter_id": 8195, "verse_number": "3.26", "content_sanskrit": "श्वोsभावा मर्त्यस्य यदन्तकैतत् सर्वेन्द्रियाणां जरयन्ति तेजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900000924, "chapter_id": 8195, "verse_number": "3.27", "content_sanskrit": "न वित्तेन तर्पणीयो मनुष्यो लप्स्यामहे वित्तमद्राक्ष्म चेत् त्वाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900000925, "chapter_id": 8195, "verse_number": "3.28", "content_sanskrit": "अजीर्यताममृतानामुपेत्य जीर्यन् मर्त्यः क्काधस्थः प्रजानन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900000926, "chapter_id": 8195, "verse_number": "3.29", "content_sanskrit": "यस्मिन्निदं विचिकित्सन्ति मृत्यो साम्पराये महति ब्रूहि नस्तत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]