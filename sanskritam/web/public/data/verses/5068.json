[{"id": 2191123, "chapter_id": 5068, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2191124, "chapter_id": 5068, "verse_number": "१", "content_sanskrit": "पितामह महाप्राज्ञ सर्वशास्त्रविशारद ।\nअस्ति वृत्रवधादेव विवक्षा मम जायते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2191125, "chapter_id": 5068, "verse_number": "२", "content_sanskrit": "ज्वरेण मोहितो वृत्रः कथितस्ते जनाधिप ।\nनिहतो वासवेनेह वज्रेणेति ममानघ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2191126, "chapter_id": 5068, "verse_number": "३", "content_sanskrit": "कथमेष महाप्राज्ञ ज्वरः प्रादुरभूत् कुतः ।\nज्वरोत्पत्तिं निपुणतः श्रोतुमिच्छाम्यहं प्रभो\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2191127, "chapter_id": 5068, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2191128, "chapter_id": 5068, "verse_number": "४", "content_sanskrit": "शृणु राजन् ज्वरस्येह सम्भवं लोकविश्रुतम् ।\nविस्तरं चास्य वक्ष्यामि यादृशं चैव भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2191129, "chapter_id": 5068, "verse_number": "५", "content_sanskrit": "पुरा मेरोर्महाराज शृङ्गं त्रैलोक्यविश्रुतम् ।\nज्योतिष्कं नाम सावित्रं सर्वरत्नविभूषितम्॥\nअप्रमेयमनाधृष्यं सर्वलोकेषु भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2191130, "chapter_id": 5068, "verse_number": "६", "content_sanskrit": "तत्र देवो गिरितटे हेमधातुविभूषिते ।\nपर्यङ्क इव विभ्राजन्नुपविष्टो बभूव ह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2191131, "chapter_id": 5068, "verse_number": "७", "content_sanskrit": "शैलराजसुता चास्य नित्यं पार्श्वे स्थिता बभौ ।\nतथा देवा महात्मानो वसवश्च महौजसः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2191132, "chapter_id": 5068, "verse_number": "८", "content_sanskrit": "तथैव च महात्मानावश्विनौ भिषजां वरौ ।\nतथा वैश्रवणो राजा गुह्यकैरभिसंवृतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2191133, "chapter_id": 5068, "verse_number": "९", "content_sanskrit": "यक्षाणामधिपः श्रीमान् कैलासनिलयः प्रभुः ।\nअङ्गिरःप्रमुखाश्चैव तथा देवर्षयोऽपरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2191134, "chapter_id": 5068, "verse_number": "१०", "content_sanskrit": "विश्वावसुश्च गन्धर्वस्तथा नारदपर्वतौ ।\nअप्सरोगणसङ्घाश्च समाजग्मुरनेकशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2191135, "chapter_id": 5068, "verse_number": "११", "content_sanskrit": "ववौ शिवः सुखो वायुर्नानागन्धवहः शुचिः ।\nसर्वर्तुकुसुमोपेताः पुष्पवन्तो महाद्रुमाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2191136, "chapter_id": 5068, "verse_number": "१२", "content_sanskrit": "तथा विद्याधराश्चैव सिद्धाश्चैव तपोधनाः ।\nमहादेवं पशुपतिं पर्युपासन्त भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2191137, "chapter_id": 5068, "verse_number": "१३", "content_sanskrit": "भूतानि च महाराज नानारूपधराण्यथ ।\nराक्षसाश्च महारौद्राः पिशाचाश्च महाबलाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2191138, "chapter_id": 5068, "verse_number": "१४", "content_sanskrit": "बहुरूपधरा हृष्टा नानाप्रहरणोद्यताः ।\nदेवस्यानुचरास्तत्र तस्थिरे चानलोपमाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2191139, "chapter_id": 5068, "verse_number": "१५", "content_sanskrit": "नन्दी च भगवांस्तत्र देवस्यानुमते स्थितः ।\nप्रगृह्य ज्वलितं शूलं दीप्यमानं स्वतेजसा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2191140, "chapter_id": 5068, "verse_number": "१६", "content_sanskrit": "गङ्गा च सरितां श्रेष्ठा सर्वतीर्थजलोद्भवा ।\nपर्युपासत तं देवं रूपिणी कुरुनन्दन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2191141, "chapter_id": 5068, "verse_number": "१७", "content_sanskrit": "एवं स भगवांस्तत्र पूज्यमानः सुरर्षिभिः ।\nदेवैश्च सुमहाभागैर्महादेवो व्यतिष्ठत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2191142, "chapter_id": 5068, "verse_number": "१८", "content_sanskrit": "कस्यचित्त्वथ कालस्य दक्षो नाम प्रजापतिः ।\nपूर्वोक्तेन विधानेन यक्ष्यमाणोऽन्वपद्यत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2191143, "chapter_id": 5068, "verse_number": "१९", "content_sanskrit": "ततस्तस्य मखं देवाः सर्वे शक्रपुरोगमाः ।\nगमनाय समागम्य बुद्धिमापेदिरे तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2191144, "chapter_id": 5068, "verse_number": "२०", "content_sanskrit": "ते विमानैर्महात्मानो ज्वलितैर्ज्वलनप्रभाः ।\nदेवस्यानुमतेऽगच्छन् गङ्गाद्वारमिति श्रुतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2191145, "chapter_id": 5068, "verse_number": "२१", "content_sanskrit": "प्रस्थिता देवता दृष्ट्वा शैलराजसुता तदा ।\nउवाच वचनं साध्वी देवं पशुपतिं पतिम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2191146, "chapter_id": 5068, "verse_number": "२२", "content_sanskrit": "भगवन् क्व नु यान्त्येते देवाः शक्रपुरोगमाः ।\nब्रूहि तत्त्वेन तत्त्वज्ञ संशयो मे महानयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2191147, "chapter_id": 5068, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2191148, "chapter_id": 5068, "verse_number": "२३", "content_sanskrit": "दक्षो नाम महाभागे प्रजानां पतिरुत्तमः ।\nहयमेधेन यजते तत्र यान्ति दिवौकसः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2191149, "chapter_id": 5068, "verse_number": "", "content_sanskrit": "उमाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2191150, "chapter_id": 5068, "verse_number": "२४", "content_sanskrit": "यज्ञमेतं महाभाग किमर्थं नाभिगच्छसि ।\nकेन वा प्रतिषेधेन गमनं ते न विद्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2191151, "chapter_id": 5068, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2191152, "chapter_id": 5068, "verse_number": "२५", "content_sanskrit": "सुरैरेव महाभागे सर्वमेतदनुष्ठितम् ।\nयज्ञेषु सर्वेषु मम न भाग उपकल्पितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2191153, "chapter_id": 5068, "verse_number": "२६", "content_sanskrit": "पूर्वोपायोपपन्नेन मार्गेण वरवर्णिनि ।\nन मे सुराः प्रयच्छन्ति भागं यज्ञस्य धर्मतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2191154, "chapter_id": 5068, "verse_number": "", "content_sanskrit": "उमाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2191155, "chapter_id": 5068, "verse_number": "२७", "content_sanskrit": "भगवन् सर्वभूतेषु प्रभावाभ्यधिको गुणैः ।\nअजेयश्चाप्रधृष्यश्च तेजसा यशसा श्रिया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2191156, "chapter_id": 5068, "verse_number": "२८", "content_sanskrit": "अनेन ते महाभाग प्रतिषेधेन भागतः ।\nअतीव दुःखमुत्पन्नं वेपथुश्च ममानघ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2191157, "chapter_id": 5068, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2191158, "chapter_id": 5068, "verse_number": "२९", "content_sanskrit": "एवमुक्त्वा तु सा देवी देवं पशुपतिं पतिम् ।\nतूष्णीम्भूताभवद् राजन् दह्यमानेन चेतसा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2191159, "chapter_id": 5068, "verse_number": "३०", "content_sanskrit": "अथ देव्या मतं ज्ञात्वा हृद्गतं यच्चिकीर्षितम् ।\nस समाज्ञापयामास तिष्ठ त्वमिति नन्दिनम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2191160, "chapter_id": 5068, "verse_number": "३१", "content_sanskrit": "ततो योगबलं कृत्वा सर्वयोगेश्वरेश्वरः ।\nतं यज्ञं सुमहातेजा भीमैरनुचरैस्तदा॥\nसहसा घातयामास देवदेवः पिनाकधृक्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2191161, "chapter_id": 5068, "verse_number": "३२", "content_sanskrit": "केचिन्नादानमुञ्चन्त केचिद्धासांश्च चक्रिरे ।\nरुधिरेणापरे राजंस्तत्राग्निं समवाकिरन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2191162, "chapter_id": 5068, "verse_number": "३३", "content_sanskrit": "केचिद् यूपान् समुत्पाट्य बभ्रमुर्विकृताननाः ।\nआस्यैरन्ये चाग्रसन्त तथैव परिचारकान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2191163, "chapter_id": 5068, "verse_number": "३४", "content_sanskrit": "ततः स यज्ञो नृपते वध्यमानः समन्ततः ।\nआस्थाय मृगरूपं वै खमेवाभ्यपतत्तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2191164, "chapter_id": 5068, "verse_number": "३५", "content_sanskrit": "तं तु यज्ञं तथारूपं गच्छन्तमुपलभ्य सः ।\nधनुरादाय बाणं च तदान्वसरत प्रभुः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2191165, "chapter_id": 5068, "verse_number": "३६", "content_sanskrit": "ततस्तस्य सुरेशस्य क्रोधादमिततेजसः ।\nललाटात् प्रसृतो घोरः स्वेदबिन्दुर्बभूव ह\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2191166, "chapter_id": 5068, "verse_number": "३७", "content_sanskrit": "तस्मिन् पतितमात्रे तु स्वेदबिन्दौ तथा भुवि ।\nप्रादुर्बभूव सुमहानग्निः कालानलोपमः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2191167, "chapter_id": 5068, "verse_number": "३८", "content_sanskrit": "तत्र चाजायत तदा पुरुषः पुरुषर्षभ ।\nह्रस्वोऽतिमात्ररक्ताक्षो हरिश्मश्रुर्विभीषणः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2191168, "chapter_id": 5068, "verse_number": "३९", "content_sanskrit": "ऊर्ध्वकेशोऽतिलोमाङ्गः श्येनोलूकस्तथैव च ।\nकरालः कृष्णवर्णश्च रक्तवासास्तथैव च\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2191169, "chapter_id": 5068, "verse_number": "४०", "content_sanskrit": "तं यज्ञं स महासत्त्वोऽदहत् कक्षमिवानलः ।\nदेवाश्चाप्यद्रवन् सर्वे ततो भीता दिशो दश\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2191170, "chapter_id": 5068, "verse_number": "४१", "content_sanskrit": "तेन तस्मिन् विचरता पुरुषेण विशां पते ।\nपृथिवी व्यचलद्राजन्नतीव भरतर्षभ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2191171, "chapter_id": 5068, "verse_number": "४२", "content_sanskrit": "हाहाभूते प्रवृत्ते तु नादे लोकभयङ्करे ।\nपितामहो महादेवं दर्शयन् प्रत्यभाषत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2191172, "chapter_id": 5068, "verse_number": "४३", "content_sanskrit": "भवतोऽपि सुराः सर्वे भागं दास्यन्ति वै प्रभो ।\nक्रियतां प्रतिसंहारः सर्वदेवेश्वर त्वया\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2191173, "chapter_id": 5068, "verse_number": "४४", "content_sanskrit": "इमा हि देवताः सर्वा ऋषयश्च परन्तप ।\nतव क्रोधान्महादेव न शान्तिमुपलेभिरे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2191174, "chapter_id": 5068, "verse_number": "४५", "content_sanskrit": "यश्चैष पुरुषो जातः स्वेदात्ते विबुधोत्तम ।\nज्वरो नामैष धर्मज्ञ लोकेषु प्रचरिष्यति\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2191175, "chapter_id": 5068, "verse_number": "४६", "content_sanskrit": "एकीभूतस्य न ह्यस्य धारणे तेजसः प्रभो ।\nसमर्था सकला पृथ्वी बहुधा सृज्यतामयम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2191176, "chapter_id": 5068, "verse_number": "४७", "content_sanskrit": "इत्युक्तो ब्रह्मणा देवो भागे चापि प्रकल्पिते ।\nभगवन्तं तथेत्याह ब्रह्माणममितौजसम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2191177, "chapter_id": 5068, "verse_number": "४८", "content_sanskrit": "परां च प्रीतिमगमदुत्स्मयंश्च पिनाकधृक् ।\nअवाप च तदा भागं यथोक्तं ब्रह्मणा भवः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2191178, "chapter_id": 5068, "verse_number": "४९", "content_sanskrit": "ज्वरं च सर्वधर्मज्ञो बहुधा व्यसृजत्तदा ।\nशान्त्यर्थं सर्वभूतानां शृणु तच्चापि पुत्रक\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2191179, "chapter_id": 5068, "verse_number": "५०", "content_sanskrit": "शीर्षाभितापो नागानां पर्वतानां शिखाजतु ।\nअपां तु नीलिकां विद्यान्निर्मोकं भुजगेषु च\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2191180, "chapter_id": 5068, "verse_number": "५१", "content_sanskrit": "क्षौरकं सौरभेयीणामूषरं पृथिवीतले ।\nपशूनामपि धर्मज्ञ दृष्टिप्रत्यवरोधनम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2191181, "chapter_id": 5068, "verse_number": "५२", "content_sanskrit": "रन्ध्रोद्भवश्च मत्स्यानां शिखोद्भेदश्च बर्हिणाम् ।\nनेत्ररोगः कोकिलानां ज्वरः प्रोक्तो महात्मना\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2191182, "chapter_id": 5068, "verse_number": "५३", "content_sanskrit": "अवीनां पित्तभेदश्च सर्वेषामिति नः श्रुतम् ।\nशुकानामपि सर्वेषां हिक्किका प्रोच्यते ज्वरः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2191183, "chapter_id": 5068, "verse_number": "५४", "content_sanskrit": "शार्दूलेष्वथ धर्मज्ञ श्रमो ज्वर इहोच्यते ।\nमानुषेषु तु धर्मज्ञ ज्वरो नामैष विश्रुतः ।\nमरणे जन्मनि तथा मध्ये चाविशते नरम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2191184, "chapter_id": 5068, "verse_number": "५५", "content_sanskrit": "एतन्माहेश्वरं तेजो ज्वरो नाम सुदारुणः ।\nनमस्यश्चैव मान्यश्च सर्वप्राणिभिरीश्वरः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2191185, "chapter_id": 5068, "verse_number": "५६", "content_sanskrit": "अनेन हि समाविष्टो वृत्रो धर्मभृतां वरः ।\nव्यजृम्भत ततः शक्रस्तस्मै वज्रमवासृजत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2191186, "chapter_id": 5068, "verse_number": "५७", "content_sanskrit": "प्रविश्य वज्रो वृत्रं तु दारयामास भारत ।\nदारितश्च स वज्रेण महायोगी महासुरः॥\nजगाम परमं स्थानं विष्णोरमिततेजसः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2191187, "chapter_id": 5068, "verse_number": "५८", "content_sanskrit": "विष्णुभक्त्या हि तेनेदं जगद्व्याप्तमभूत् पुरा ।\nतस्माच्च निहतो युद्धे विष्णोः स्थानमवाप्तवान्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2191188, "chapter_id": 5068, "verse_number": "५९", "content_sanskrit": "इत्येष वृत्रमाश्रित्य ज्वरस्य महतो मया ।\nविस्तरः कथितः पुत्र किमन्यत् प्रब्रवीमि ते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2191189, "chapter_id": 5068, "verse_number": "६०", "content_sanskrit": "इमां ज्वरोत्पत्तिमदीनमानसः\nपठेत् सदा यः सुसमाहितो नरः ।\nविमुक्तरोगः स सुखी मुदा युतो\nलभेत कामान् स यथामनीषितान्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2191190, "chapter_id": 5068, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे सप्तदशाधिकशततमोऽध्यायः ॥११७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]