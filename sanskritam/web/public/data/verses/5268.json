[{"id": 2200368, "chapter_id": 5268, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200369, "chapter_id": 5268, "verse_number": "१", "content_sanskrit": "पवित्राणां पवित्रं यच्छ्रेष्ठं लोकेषु पूजितम् ।\nमहाव्रतं महाभाग तन्मे ब्रूहि पितामह\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200370, "chapter_id": 5268, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200371, "chapter_id": 5268, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nपितुः पुत्रस्य संवादं व्यासस्य च शुकस्य च\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200372, "chapter_id": 5268, "verse_number": "३", "content_sanskrit": "ऋषीणामुत्तमं कृष्णं भावितात्मानमच्युतम् ।\nपारम्पर्यविशेषज्ञं सर्वशास्त्रार्थकोविदम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200373, "chapter_id": 5268, "verse_number": "४", "content_sanskrit": "कृतशौचः शुकस्तत्र कृतजप्यः कृताह्निकः ।\nपरं नियममास्थाय परं धर्ममुपाश्रितः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200374, "chapter_id": 5268, "verse_number": "५", "content_sanskrit": "प्रणम्य शिरसा व्यासं सूक्ष्मतत्वार्थदर्शिनम् ।\nशुकः पप्रच्छ वै प्रश्नं दानधर्मकुतूहलः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200375, "chapter_id": 5268, "verse_number": "६", "content_sanskrit": "बहुचित्राणि दानानि बहुशः शंससे मुने ।\nमहार्थं पावनं पुण्यं किंस्विद् दानं महाफलम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200376, "chapter_id": 5268, "verse_number": "७", "content_sanskrit": "केन दुर्गाणि तरति केन दुर्गानवाप्नुते ।\nकेन वा महदाप्नोति इह लोके परत्र च\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200377, "chapter_id": 5268, "verse_number": "८", "content_sanskrit": "के वा यज्ञस्य वोढारः केषु यज्ञः प्रतिष्ठितः ।\nकिञ्च यज्ञस्य यज्ञत्वं किञ्च यज्ञस्य भेषजम् ।\nयज्ञानामुत्तमं किञ्च तद् भवान् प्रब्रवीतु मे\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200378, "chapter_id": 5268, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200379, "chapter_id": 5268, "verse_number": "९", "content_sanskrit": "स तस्मै भजमानाय जातकौतूहलाय च ।\nव्यासो व्रतनिधिः प्राह गवामिदमनुत्तमम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200380, "chapter_id": 5268, "verse_number": "१०", "content_sanskrit": "धन्यं यशस्यमायुष्यं लोके श्रुतिसुखावहम् ।\nयत् पवित्रं पवित्राणां मङ्गलानां च मङ्गलम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200381, "chapter_id": 5268, "verse_number": "११", "content_sanskrit": "सर्वपापप्रशमनं तत् समासेन मे शृणु\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200382, "chapter_id": 5268, "verse_number": "१२", "content_sanskrit": "यदिदं तिष्ठते लोके जगत् स्थावरजङ्गमम् ।\nगावस्ताः प्राप्य तिष्ठन्ते गोलोके पुण्यदर्शनाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200383, "chapter_id": 5268, "verse_number": "१३", "content_sanskrit": "मातरः सर्वभूतानां विश्वस्य जगतश्च ह ।\nरुद्राणामथ साध्यानां गाव एव तु मातरः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200384, "chapter_id": 5268, "verse_number": "१४", "content_sanskrit": "रुद्राणां मातरो ह्येता आदित्यानां स्वसाः स्मृताः ।\nवसूनां च दुहित्र्यस्ता ब्रह्मसन्तानमूलजाः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200385, "chapter_id": 5268, "verse_number": "१५", "content_sanskrit": "यासामधिपतिः पूषा मरुतो बालबन्धनाः ।\nऐश्वर्यं वरुणो राजा विश्वेदेवा समाश्रिताः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2200386, "chapter_id": 5268, "verse_number": "१६", "content_sanskrit": "य एवं वेद ता गावो मातरो देवपूजिताः ।\nस विप्रो ब्रह्मलोकाय गवां लोकाय वा ध्रुवः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2200387, "chapter_id": 5268, "verse_number": "१७", "content_sanskrit": "गावस्तु नावमन्येत कर्मणा मनसा गिरा ।\nगवां स्थानं परं लोके प्रार्थयेद् यः परां गतिम् ।\nन पद्भ्यां ताडयेद् गावो न दण्डेन न मुष्टिना\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2200388, "chapter_id": 5268, "verse_number": "१८", "content_sanskrit": "इमां विद्यामुपाश्रित्य पावनीं ब्रह्मनिर्मिताम् ।\nमातॄणामनुपाते च न गोमध्ये न गोव्रजे\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2200389, "chapter_id": 5268, "verse_number": "१९", "content_sanskrit": "नरो मूत्रपुरीषस्य दृष्ट्वा कुर्याद् विसर्जनम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2200390, "chapter_id": 5268, "verse_number": "२०", "content_sanskrit": "शुद्धाश्चन्दनशीताङ्ग्यश्चन्द्ररश्मिसमप्रभाः ।\nसौम्याः सुरभ्यः सुभगा गावो गुग्गुळुगन्धयः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2200391, "chapter_id": 5268, "verse_number": "२१", "content_sanskrit": "सर्वे देवाविशन् गावः समुद्रमिव सिन्धवः ।\nदिवं चैवान्तरिक्षं च गवां व्युष्टिं समश्नुते\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2200392, "chapter_id": 5268, "verse_number": "२२", "content_sanskrit": "दधिना जुहुयादग्निं दधिना स्वस्ति वाचयेत् ।\nदधि दद्याच्च प्राशेत गवां व्युष्टिं समश्नुते\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2200393, "chapter_id": 5268, "verse_number": "२३", "content_sanskrit": "घृतेन जुहुयादग्निं घृतेन स्वस्ति वाचयेत् ।\nघृतमालभ्य प्राश्नीयाद् गवां व्युष्टिं समश्नुते\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2200394, "chapter_id": 5268, "verse_number": "२४", "content_sanskrit": "गावः सञ्जीवना यास्तु गावो दानमनुत्तमम् ।\nताः पुण्यगोपाः सुफला भजमानं भजन्तु माम्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2200395, "chapter_id": 5268, "verse_number": "२५", "content_sanskrit": "येन देवाः पवित्रेण स्वर्गलोकमितो गताः ।\nतत् पवित्रं पवित्राणां मम मूर्ध्नि प्रतिष्ठितम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2200396, "chapter_id": 5268, "verse_number": "२६", "content_sanskrit": "वीणामृदङ्गपणवा गवां गात्रं प्रतिष्ठिताः ।\nक्रीडारतिविहारार्थे त्रिषु लोकेषु वर्तते\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2200397, "chapter_id": 5268, "verse_number": "२७", "content_sanskrit": "न तत्र देवा वर्तन्ते नाग्निहोत्राणि जुह्वति ।\nन यज्ञैरिज्यते चात्र यत्र गौर्वै न दुह्यते\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2200398, "chapter_id": 5268, "verse_number": "२८", "content_sanskrit": "क्षीरं दधि घृतं यासां रसानामुत्तमो रसः ।\nअमृतप्रभवा गावः त्रैलोक्यं येन जीवति\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2200399, "chapter_id": 5268, "verse_number": "२९", "content_sanskrit": "इडामाहूय धेनुं च सवत्सां यज्ञमातरम् ।\nउपाह्वयन्ति यं विप्रा गावो यज्ञहविष्कृताः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2200400, "chapter_id": 5268, "verse_number": "३०", "content_sanskrit": "या मेध्या प्रथमं कर्म इयं धेनुः सरस्वती ।\nपौर्णमासेन वत्सेन कामं कामगुणान्विता\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2200401, "chapter_id": 5268, "verse_number": "३१", "content_sanskrit": "यत्र सर्वमिदं प्रोतं यत् किञ्चित् जङ्गमं जगत् ।\nसा गौर्वै प्रथमा पुण्या सर्वभूतहिते रता\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2200402, "chapter_id": 5268, "verse_number": "३२", "content_sanskrit": "धारणाः पावनाः पुण्या भावना भूतभावनाः ।\nगावो मामभिरक्षन्तु इह लोके परत्र च\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2200403, "chapter_id": 5268, "verse_number": "३३", "content_sanskrit": "एष यज्ञः सहोपाङ्गः स्विष्टश्चैव सदक्षिणः ।\nवेदा सहोपनिषदो गवां रूपे प्रतिष्ठिताः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2200404, "chapter_id": 5268, "verse_number": "३४", "content_sanskrit": "एतत् तात मया प्रोक्तं गवामिह परं मतम् ।\nसर्वतः श्रावयेन्नित्यं प्रयतो ब्रह्मसंसदि\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2200405, "chapter_id": 5268, "verse_number": "३५", "content_sanskrit": "श्रुत्वा लभेत तान् लोकान् ये मया परिकीर्तिताः ।\nश्रावयित्वाऽपि प्रीतात्मा लोकांस्तान् प्रतिपद्यते\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2200406, "chapter_id": 5268, "verse_number": "३६", "content_sanskrit": "धेनुमेकां सदा दद्यादहन्यहनि पावनीम् ।\nतत्तथा प्राप्नुयाद् विप्रः पठन् वै गोमतीं सदा\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2200407, "chapter_id": 5268, "verse_number": "३७", "content_sanskrit": "अथ धेनुर्न विद्येत तिलधेनुमनुत्तमाम् ।\nदद्याद् गोमतिकल्पेन तां धेनुं सर्वपावनीम्\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2200408, "chapter_id": 5268, "verse_number": "३८", "content_sanskrit": "आह्निकं गोमतीं नित्यं यः पठेत सदा नरः ।\nसर्वपापात् प्रमुच्येत प्रयतात्मा य आचरेत्\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2200409, "chapter_id": 5268, "verse_number": "३९", "content_sanskrit": "घृतं वा नित्यमालभ्य प्राश्य वा गोमतीं जपेत् ।\nस्नात्वा वा गोकरीषेण पठन् पापात् प्रमुच्यते\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2200410, "chapter_id": 5268, "verse_number": "४०", "content_sanskrit": "मनसा गोमतीं जप्येद् गोमत्या नित्यमाह्निकम् ।\nन त्वेव दिवसं कुर्याद् व्यर्थं गोमतिपाठकः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2200411, "chapter_id": 5268, "verse_number": "४१", "content_sanskrit": "गोमतीं जपमाना हि देवा देवत्वमाप्नुवन् ।\nऋषित्वमृषयश्चापि गोमत्या सर्वमाप्नुवन्\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2200412, "chapter_id": 5268, "verse_number": "४२", "content_sanskrit": "बद्धो बन्धात् प्रमुच्येत कृच्छ्रान्मुच्येत सङ्कटात् ।\nगोमतीं सेवते यस्तु लभते प्रियसङ्गमम्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2200413, "chapter_id": 5268, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2200414, "chapter_id": 5268, "verse_number": "४३", "content_sanskrit": "एतत् पवित्रं कार्त्स्न्येन एतद् व्रतमनुत्तमम् ।\nएत्तत् तु पृथिवीपाल पावनं शृण्वतां सदा\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2200415, "chapter_id": 5268, "verse_number": "४४", "content_sanskrit": "पुत्रकामाश्च ये केचिद् धनकामाश्च मानवाः ।\nअध्वाने चोरवैरिभ्यो मुच्यते गोमतीं पठन्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2200416, "chapter_id": 5268, "verse_number": "४५", "content_sanskrit": "पूर्ववैरानुबन्धेषु रणे चाप्याततायिनः ।\nलभते जयमेवाशु सदा गोमतिपाठकः\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2200417, "chapter_id": 5268, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे व्यासशुकसंवादो नाम एकोनविंशत्यधिकशततमोऽध्यायः ॥११९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]