[{"id": 2102018, "chapter_id": 3202, "verse_number": "१४-५८-१", "content_sanskrit": "वैशम्पायन उवाच।\nस मित्रसहमासाद्य अभिज्ञानमयाचत।\nतस्मै ददावभिज्ञानं स चेक्ष्वाकुवरस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102019, "chapter_id": 3202, "verse_number": "१४-५८-२x", "content_sanskrit": "सौदास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102020, "chapter_id": 3202, "verse_number": "१४-५८-२", "content_sanskrit": "न चैवैषा गतिः क्षेम्या न चान्या विद्यते गतिः।\nएतन्मे तत्वमाज्ञाय प्रयच्छ मणिकुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102021, "chapter_id": 3202, "verse_number": "१४-५८-३", "content_sanskrit": "इत्युक्तस्तामुदङ्कस्तु भर्तुर्वाक्यमथाब्रवीत्।\nश्रुत्वा च सा तदा प्रादात्ततस्ते मणिकुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102022, "chapter_id": 3202, "verse_number": "१४-५८-४", "content_sanskrit": "अवाप्य कुण्डले ते तु राजानं पुनरब्रवीत्।\nकिमेतद्गुह्यवचनं श्रोतुमिच्छामि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102023, "chapter_id": 3202, "verse_number": "१४-५८-५x", "content_sanskrit": "सौदास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102024, "chapter_id": 3202, "verse_number": "१४-५८-५", "content_sanskrit": "प्रजाविसर्गाद्विप्रान्वै क्षत्रियाः पूजयन्ति ह।\nविप्रेभ्यश्चापि बहवो दोषाः प्रादुर्भवन्ति नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102025, "chapter_id": 3202, "verse_number": "१४-५८-६", "content_sanskrit": "सोहं द्विजेभ्यः प्रणतो विप्राद्दोषमवाप्तवान्।\nगतिमन्यां न पश्यामि मदयन्तीसहायवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102026, "chapter_id": 3202, "verse_number": "१४-५८-७", "content_sanskrit": "न चान्यामपि पश्यामि गतिं गतिमतांवर।\nस्वर्गद्वारस्य गमने स्थाने चेह द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102027, "chapter_id": 3202, "verse_number": "१४-५८-८", "content_sanskrit": "न हि राज्ञा विशेषेण विरुद्धेन द्विजातिभिः।\nशक्यं हि लोके स्थातुं वै प्रेत्य वा सुखमेधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102028, "chapter_id": 3202, "verse_number": "१४-५८-९", "content_sanskrit": "तदिष्टे ते मया दत्ते एते स्वे मणिकुण्डले।\nयः कृतस्तेऽद्य समयः सफलं तं कुरुष्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102029, "chapter_id": 3202, "verse_number": "१४-५८-१०x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102030, "chapter_id": 3202, "verse_number": "१४-५८-१०", "content_sanskrit": "राजंस्तथेह कर्तास्मि पुनरेष्यामि ते वशम्।\nप्रश्नं च कञ्चित्प्रष्टुं त्वां व्यवसिष्ये परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102031, "chapter_id": 3202, "verse_number": "१४-५८-११x", "content_sanskrit": "सौदास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102032, "chapter_id": 3202, "verse_number": "१४-५८-११", "content_sanskrit": "ब्रूहि विप्र यथाकामं प्रतिवक्तास्मि ते वचः।\nछेत्तास्मि संशयं तेऽद्य न मेऽत्राश्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102033, "chapter_id": 3202, "verse_number": "१४-५८-१२x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102034, "chapter_id": 3202, "verse_number": "१४-५८-१२", "content_sanskrit": "प्राहुर्वाक्संयतं विप्रं धर्मनैपुणदर्शिनः।\nमित्रेषु यश्च विषमः स्तेन इत्येव तं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102035, "chapter_id": 3202, "verse_number": "१४-५८-१३", "content_sanskrit": "स बवान्मित्रतामद्य सम्प्राप्तो मम पार्थिव।\nस मे बुद्धिं प्रयच्छस्व सम्मतां पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102036, "chapter_id": 3202, "verse_number": "१४-५८-१४", "content_sanskrit": "अवाप्तार्थोऽहमद्येह भवांश्च पुरुषादकः।\nभवत्सकाशमागन्तुं क्षमं मम न वेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102037, "chapter_id": 3202, "verse_number": "१४-५८-१५x", "content_sanskrit": "सौदास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102038, "chapter_id": 3202, "verse_number": "१४-५८-१५", "content_sanskrit": "क्षमं चेदिह वक्तव्यं मया द्विजवरोत्तम।\nमत्समीपं द्विजश्रेष्ट नागन्तव्यं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102039, "chapter_id": 3202, "verse_number": "१४-५८-१६", "content_sanskrit": "एवं तव प्रपश्यामि श्रेयो भृगुकुलोद्वह।\nआगच्छतो हि ते विप्रि भवेन्मृर्त्युन संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102040, "chapter_id": 3202, "verse_number": "१४-५८-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102041, "chapter_id": 3202, "verse_number": "१४-५८-१७", "content_sanskrit": "इत्युक्तः स तदा राजा क्षमं बुद्धिमता हितम्।\nअनुज्ञाप्य स राजानमहल्यां प्रति जग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102042, "chapter_id": 3202, "verse_number": "१४-५८-१८", "content_sanskrit": "गृहीत्वा कुण्डले दिव्ये गुरुपत्न्याः प्रियंकरः।\nजवेन महता प्रायाद्गौतमस्याश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102043, "chapter_id": 3202, "verse_number": "१४-५८-१९", "content_sanskrit": "यथा तयो रक्षणं च मदयन्त्याऽभिभाषितम्।\nतथा ते कुण्डले बध्वा तदा कृष्णाजिनेऽनयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102044, "chapter_id": 3202, "verse_number": "१४-५८-२०", "content_sanskrit": "स कस्मिंश्चित्क्षुधाविष्टः फलभारसमन्वितम्।\nबिल्वं ददर्श विप्रर्षिरारुरोह च तं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102045, "chapter_id": 3202, "verse_number": "१४-५८-२१", "content_sanskrit": "शाखास्वासज्य तस्यैव कृष्णाजिनमरिंदम।\nपातयामास बिल्वानि तदा स द्विजपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102046, "chapter_id": 3202, "verse_number": "१४-५८-२२", "content_sanskrit": "अथ पातयमानस्य बिल्वापहृतचक्षुषः।\nन्यपतंस्तानि बिल्वानि तस्मिन्नेवाजिने विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102047, "chapter_id": 3202, "verse_number": "१४-५८-२३", "content_sanskrit": "यस्मिंस्ते कुण्डले बद्धे तदा द्विजवरेण वै।\nबिल्वप्रहारैस्तस्याथ व्यशीर्यद्बन्धनं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102048, "chapter_id": 3202, "verse_number": "१४-५८-२४", "content_sanskrit": "सकुण्डलं तदजिनं पपात सहसा तरोः।\nविशीर्णबन्धने तस्मिन्गते कृष्णाजिने महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102049, "chapter_id": 3202, "verse_number": "१४-५८-२५", "content_sanskrit": "अपश्यद्भुजगः कश्चित्ते तत्र मणिकुण्डले।\nऐरावतकुलोद्भूतः शीघ्रो भूत्वा तदा हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102050, "chapter_id": 3202, "verse_number": "१४-५८-२६", "content_sanskrit": "विदश्यास्येन वल्मीकं विवेशाथ स कुण्डले।\nह्रियमाणे तु दृष्ट्वा स कुण्डले भुजगेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102051, "chapter_id": 3202, "verse_number": "१४-५८-२७", "content_sanskrit": "पपात वृक्षात्सोद्वेगो दुःखात्परमकोपनः।\nस दण्डकाष्ठमादाय वल्मीकमखनत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102052, "chapter_id": 3202, "verse_number": "१४-५८-२८", "content_sanskrit": "[अहानि त्रिंशदव्यग्रः पञ्च चान्यानि भारत।]\nक्रोधामर्षाभिसंतप्तस्तदा ब्राह्मणिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102053, "chapter_id": 3202, "verse_number": "१४-५८-२९", "content_sanskrit": "तस्य वेगमसह्यं तमसहन्ती वसुन्धरा।\nदण्डकाष्ठाभिनुन्नाङ्गी चचाल भृशमाकुला।\nततः खनत एवाथ विप्रर्षेर्धरणीतलम्\nनागलोकस्य पन्थानं कर्तुकामस्य निश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102054, "chapter_id": 3202, "verse_number": "१४-५८-३०", "content_sanskrit": "रथेन हरियुक्तेन तं देशमुपजग्मिवान्।\nवज्रपाणिर्महातेजास्तं ददर्श द्विजोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102055, "chapter_id": 3202, "verse_number": "१४-५८-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102056, "chapter_id": 3202, "verse_number": "१४-५८-३१", "content_sanskrit": "स तु तं ब्राह्मणो भूत्वा तस्य दुःखेन दुःखितः।\nउदङ्कमब्रवीद्वाक्यं नैतच्छक्यं त्वयेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102057, "chapter_id": 3202, "verse_number": "१४-५८-३२", "content_sanskrit": "इतो हि नागलोको वै योजनानि सहस्रशः।\nन दण्डकाष्ठसाध्यं च मन्ये कार्यमिदं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2102058, "chapter_id": 3202, "verse_number": "१४-५८-३३x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2102059, "chapter_id": 3202, "verse_number": "१४-५८-३३", "content_sanskrit": "नागलोके यदि ब्रह्मन्न शक्ये कुण्डले मया।\nप्राप्तुं प्राणान्विमोक्ष्यामि पश्यतस्ते द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2102060, "chapter_id": 3202, "verse_number": "१४-५८-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2102061, "chapter_id": 3202, "verse_number": "१४-५८-३४", "content_sanskrit": "यदा स नाशकत्तस्य निश्चयं कर्तुमन्यथा।\nवज्रपाणिस्तदा दण्डं वज्रास्त्रेण युयोज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2102062, "chapter_id": 3202, "verse_number": "१४-५८-३५", "content_sanskrit": "ततो वज्रप्रहारैस्तैर्दार्यमाणा वसुन्धर।\nनागलोकस्य पन्थानमकरोज्जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2102063, "chapter_id": 3202, "verse_number": "१४-५८-३६", "content_sanskrit": "स तेन मार्गेण तदा नागलोकं विवेश ह।\nददर्श नागलोकं च योजनानि सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2102064, "chapter_id": 3202, "verse_number": "१४-५८-३७", "content_sanskrit": "प्रकारनिचयैर्दिव्यैर्मणिमुक्तास्वलङ्कृतैः।\nउपपन्नं महाभाग शातकुम्भमयैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2102065, "chapter_id": 3202, "verse_number": "१४-५८-३८", "content_sanskrit": "वापीः स्फटिकसोपाना नदीस्च विमलोदकाः।\nददर्श वृक्षांश्च बहून्नानाद्विजगणायुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2102066, "chapter_id": 3202, "verse_number": "१४-५८-३९", "content_sanskrit": "तस्य लोकस्य च द्वारं स ददर्श भृगूद्वहः।\nपञ्चयोजनविस्तारमायतं शतयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2102067, "chapter_id": 3202, "verse_number": "१४-५८-४०", "content_sanskrit": "नागलोकमुदङ्कस्तु प्रेक्ष्य दीनोऽभवत्तदा।\nनिराशश्चाभवत्तत्र कुण्डलाहरणे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2102068, "chapter_id": 3202, "verse_number": "१४-५८-४१", "content_sanskrit": "तत्र प्रोवाच तुरगस्तं कृष्णश्वेतवालधिः।\nताम्रास्यनेत्रः कौरव्यः प्रज्वलन्निव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2102069, "chapter_id": 3202, "verse_number": "१४-५८-४२", "content_sanskrit": "धमस्वापानमेतन्मे ततस्त्वं विप्र लप्स्यसे।\nऐरावतसुतेनेहि तव्रानीते हि कुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2102070, "chapter_id": 3202, "verse_number": "१४-५८-४३", "content_sanskrit": "मा जुगुप्सां कृथाः पुत्र त्वमत्रार्थे कथञ्चन॥\nत्वयैतद्धि समाचीर्णं गौतमस्याश्रमे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2102071, "chapter_id": 3202, "verse_number": "१४-५८-४४x", "content_sanskrit": "उदङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2102072, "chapter_id": 3202, "verse_number": "१४-५८-४४", "content_sanskrit": "कथं भवन्तं जानीयामुपाध्यायाश्रमं प्रति।\nयन्मया चीर्णपूर्वं हि श्रोतुमिच्छामि तद्ध्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2102073, "chapter_id": 3202, "verse_number": "१४-५८-४५x", "content_sanskrit": "अश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2102074, "chapter_id": 3202, "verse_number": "१४-५८-४५", "content_sanskrit": "गुरोर्गुरु मां जानीहि ज्वलन्तं जातवेदसम्।\nत्वया ह्यहं सदा विप्र गुरोरर्थेऽभिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2102075, "chapter_id": 3202, "verse_number": "१४-५८-४६", "content_sanskrit": "विधिवत्सततं विप्र शुचिना भृगुनन्दन।\nतस्माच्छ्रेयो विधास्यामि तवैवं कुरु माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2102076, "chapter_id": 3202, "verse_number": "१४-५८-४७", "content_sanskrit": "इत्युक्तस्तु तथाऽकार्षीदुदङ्कश्चित्रभानुना।\nताम्रार्चिः प्रीतिमांश्चापि प्रजज्वाल दिधक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2102077, "chapter_id": 3202, "verse_number": "१४-५८-४८", "content_sanskrit": "ततोऽस्य रोमकूपेभ्यो ध्मायमानस्य भारत।\nघनः प्रादुरभूद्धूमो नागलोकभयावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2102078, "chapter_id": 3202, "verse_number": "१४-५८-४९", "content_sanskrit": "तेन धूमेन महता वर्धमानेन भारत।\nनागलोके महाराज न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2102079, "chapter_id": 3202, "verse_number": "१४-५८-५०", "content_sanskrit": "हाहाकृतमभूत्सर्वमैरावतिनिवेशनम्।\nवासुकिप्रमुखानां च नागानां जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2102080, "chapter_id": 3202, "verse_number": "१४-५८-५१", "content_sanskrit": "न प्राकाशन्त वेश्मानि धूमरुद्धानि भारत।\nनीहारसंवृतानीव वनानि गिरयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2102081, "chapter_id": 3202, "verse_number": "१४-५८-५२", "content_sanskrit": "ते धूमरक्तनयना वह्नितेजोभितापिताः।\nआजग्मुर्निश्चयं ज्ञातुं भार्गवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2102082, "chapter_id": 3202, "verse_number": "१४-५८-५३", "content_sanskrit": "श्रुत्वा च निश्चयं तस्य महर्षेरतितेजसः।\nसम्भ्रान्तनयनाः सर्वे पूजां चक्रुर्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2102083, "chapter_id": 3202, "verse_number": "१४-५८-५४", "content_sanskrit": "सर्वे प्राञ्जलयो नागा वृद्धबालपुरोगमाः।\nशिरोभिः प्रणिपत्योचुः प्रसीद भगवन्निति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2102084, "chapter_id": 3202, "verse_number": "१४-५८-५५", "content_sanskrit": "प्रसाद्य ब्राह्मणं ते तु पाद्यमर्घ्यं निवेद्य च।\nप्रायच्छन्कुण्डले दिव्ये पन्नगाः परमार्चिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2102085, "chapter_id": 3202, "verse_number": "१४-५८-५६", "content_sanskrit": "ततः स पूजितो नागैस्तदोदङ्कः प्रतापवान्।\nअग्निं प्रदक्षिणं कृत्वा जगाम गुरुसद्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2102086, "chapter_id": 3202, "verse_number": "१४-५८-५७", "content_sanskrit": "स गत्वा त्वरितो राजन्गौतमस्य निवेशनम्।\nप्रायच्छत्कुण्डले दिव्ये गुरुपत्न्यास्तदाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2102087, "chapter_id": 3202, "verse_number": "१४-५८-५८", "content_sanskrit": "वासुकिप्रमुकानां च नागानां जनमेजय।\nसर्वं शशंस गुरेव यथावद्द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2102088, "chapter_id": 3202, "verse_number": "१४-५८-५९", "content_sanskrit": "एवं महात्मना तेन त्रींलोकाञ्जनमेजय।\nपरिक्रम्याहृते दिव्ये ततस्ते मणिकुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2102089, "chapter_id": 3202, "verse_number": "१४-५८-६०", "content_sanskrit": "एवंप्रभावः स मुनिरुदङ्को भरतर्षभ।\nपरेण तपसा युक्तो यन्मां त्वं परिपृच्छसि। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2102090, "chapter_id": 3202, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अष्टपञ्चासोऽध्यायः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]