[{"id": 2081295, "chapter_id": 2727, "verse_number": "१२-२३२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081296, "chapter_id": 2727, "verse_number": "१२-२३२-१", "content_sanskrit": "शतक्रतुरथापश्यद्बलेर्दीप्तां महात्मनः।\nस्वरूपिणीं शरीराद्धि निष्क्रामन्तीं तदा श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081297, "chapter_id": 2727, "verse_number": "१२-२३२-२", "content_sanskrit": "तां दृष्ट्वा प्रभया दीप्तां भगवान्पाककशासनः।\nविस्मयोत्फुल्लनयनो बलिं पप्रच्छ वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081298, "chapter_id": 2727, "verse_number": "१२-२३२-३", "content_sanskrit": "बले केयमपक्रान्ता रोचमाना शिखण्डिनी।\nत्वत्तः स्थिता सकेयूरा दीप्यमाना स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081299, "chapter_id": 2727, "verse_number": "१२-२३२-४x", "content_sanskrit": "बलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081300, "chapter_id": 2727, "verse_number": "१२-२३२-४", "content_sanskrit": "न हीमामासुरीं वेद्मि न दैवीं च न मानुषीम्।\nत्वमेनां पृच्छ वा मा वा यथेष्टं कुरु वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081301, "chapter_id": 2727, "verse_number": "१२-२३२-५x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081302, "chapter_id": 2727, "verse_number": "१२-२३२-५", "content_sanskrit": "का त्वं बलेरपक्रान्ता रोचमाना शिखण्डिनी।\nअजानतो ममाचक्ष्व नामधेयं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081303, "chapter_id": 2727, "verse_number": "१२-२३२-६", "content_sanskrit": "का त्वं तिष्ठसि मामेवं दीप्यमाना स्वतेजसा।\nहित्वा दैत्यवरं सुभ्रु तन्ममाचक्ष्व पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081304, "chapter_id": 2727, "verse_number": "१२-२३२-७x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081305, "chapter_id": 2727, "verse_number": "१२-२३२-७", "content_sanskrit": "न मां विरोचनो वेद नायं वैरोचनो बलिः।\nआहुर्मां दुःसहेत्येवं विधित्सेति च मां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081306, "chapter_id": 2727, "verse_number": "१२-२३२-८", "content_sanskrit": "भूतिर्लक्ष्मीति मामाहुः श्रीरित्येव च वासव।\nत्वं मां शक्र न जानीषे सर्वे देवा न मां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081307, "chapter_id": 2727, "verse_number": "१२-२३२-९x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081308, "chapter_id": 2727, "verse_number": "१२-२३२-९", "content_sanskrit": "किमिदं त्वं मम कृते उताहो बलिनः कृते।\nदुःसहे विजहास्येनं चिरसंवासिनी सती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081309, "chapter_id": 2727, "verse_number": "१२-२३२-१०x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081310, "chapter_id": 2727, "verse_number": "१२-२३२-१०", "content_sanskrit": "नो धाता न विधाता मां विदधाति कथंचन।\nकालस्तु शक्र पर्यागान्मैवं शक्रावमन्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081311, "chapter_id": 2727, "verse_number": "१२-२३२-११x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081312, "chapter_id": 2727, "verse_number": "१२-२३२-११", "content_sanskrit": "कथं त्वया बलिस्त्यक्तः किमर्थं वा शिखण्डिनि।\nकथं च मां न जह्यास्त्वं तन्मे ब्रूहि शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081313, "chapter_id": 2727, "verse_number": "१२-२३२-१२x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081314, "chapter_id": 2727, "verse_number": "१२-२३२-१२", "content_sanskrit": "सत्ये स्थिताऽस्मि दाने च व्रते तपसि चैव हि।\nपराक्रमे च धर्मे च पराचीनस्ततो बलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081315, "chapter_id": 2727, "verse_number": "१२-२३२-१३", "content_sanskrit": "ब्रह्मण्योऽयं पुरा भूत्वा सत्यवादी जितेन्द्रियः।\nअभ्यसूयन्ब्राह्मणान्वै उच्छिष्टश्चास्पृशद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081316, "chapter_id": 2727, "verse_number": "१२-२३२-१४", "content_sanskrit": "यज्ञशीलः सदा भूत्वा मामेव यजते स्वयम्।\nततः प्रहाय मूढात्मा कालेनोपनिपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081317, "chapter_id": 2727, "verse_number": "१२-२३२-१५", "content_sanskrit": "अपक्रान्ता ततः शक्र त्वयि वत्स्यामि वासव।\nअप्रमत्तेन धार्याऽस्मि तपसा विक्रमेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081318, "chapter_id": 2727, "verse_number": "१२-२३२-१६x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081319, "chapter_id": 2727, "verse_number": "१२-२३२-१६", "content_sanskrit": "कोऽस्ति देवमनुष्येषु सर्वभूतेषु वा पुमान्।\nयस्त्वामेको विषहितुं शक्नुयात्कमलालये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081320, "chapter_id": 2727, "verse_number": "१२-२३२-१७x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081321, "chapter_id": 2727, "verse_number": "१२-२३२-१७", "content_sanskrit": "नैव देवो न गन्धर्वो नासुरो नं च न्राक्षसः।\nयो मामेको विषहितुं शक्तः कश्चित्पुरंदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081322, "chapter_id": 2727, "verse_number": "१२-२३२-१८x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081323, "chapter_id": 2727, "verse_number": "१२-२३२-१८", "content_sanskrit": "तिष्ठेथा मयि नित्यं त्वं यथा तद्ब्रूहि मे शुभे।\nतत्करिष्यामि ते वाक्यमृतं तद्वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081324, "chapter_id": 2727, "verse_number": "१२-२३२-१९x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081325, "chapter_id": 2727, "verse_number": "१२-२३२-१९", "content_sanskrit": "स्थास्यामि नित्यं देवेन्द्र यथा त्वयि निबोध तत्।\nविधिना वेददृष्टेन चतुर्धा विभजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081326, "chapter_id": 2727, "verse_number": "१२-२३२-२०x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081327, "chapter_id": 2727, "verse_number": "१२-२३२-२०", "content_sanskrit": "अहं वै त्वां निधास्यामि यथाशक्ति यथाबलम्।\nन तु मेऽतिक्रमः स्याद्वै सदा लक्ष्मि तवान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081328, "chapter_id": 2727, "verse_number": "१२-२३२-२१", "content_sanskrit": "भूमिरेव मनुष्येषु धारिणी भूतभाविनी।\nसा ते पादं तितिक्षेत समर्था हीति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081329, "chapter_id": 2727, "verse_number": "१२-२३२-२२x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081330, "chapter_id": 2727, "verse_number": "१२-२३२-२२", "content_sanskrit": "एष मे निहितः पादो योऽयं भूमौ प्रतिष्ठितः।\nद्वितीयं शक्र पादं मे तस्मात्सुनिहितं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081331, "chapter_id": 2727, "verse_number": "१२-२३२-२३x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081332, "chapter_id": 2727, "verse_number": "१२-२३२-२३", "content_sanskrit": "आप एव मनुष्येषु द्रवन्त्यः परिधारणे।\nतास्ते पादं तितिक्षन्तामलमापस्तितिक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081333, "chapter_id": 2727, "verse_number": "१२-२३२-२४x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081334, "chapter_id": 2727, "verse_number": "१२-२३२-२४", "content_sanskrit": "एष मे निहितः पादो योऽयमप्सु प्रतिष्ठितः।\nतृतीयं शक्र पादं मे तस्मात्सुनिहितं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081335, "chapter_id": 2727, "verse_number": "१२-२३२-२५x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081336, "chapter_id": 2727, "verse_number": "१२-२३२-२५", "content_sanskrit": "यस्मिन्वेदाश्च यज्ञाश्च यस्मिन्देवाः प्रतिष्ठिताः।\nतृतीयं पादमग्निस्ते सुधृतं धारयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081337, "chapter_id": 2727, "verse_number": "१२-२३२-२६x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081338, "chapter_id": 2727, "verse_number": "१२-२३२-२६", "content_sanskrit": "एष मे निहितः पादो योऽयमग्नौ प्रतिष्ठितः।\nचतुर्थं शक्र पादं मे तस्मात्सुनिहितं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081339, "chapter_id": 2727, "verse_number": "१२-२३२-२७x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081340, "chapter_id": 2727, "verse_number": "१२-२३२-२७", "content_sanskrit": "ये वै सन्तो मनुष्येषु ब्रह्मण्याः सत्यवादिनः।\nतेते पादं तितिक्षन्तामलं सन्तस्तितिक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081341, "chapter_id": 2727, "verse_number": "१२-२३२-२८x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081342, "chapter_id": 2727, "verse_number": "१२-२३२-२८", "content_sanskrit": "एष मे निहितः पादो योऽयं सत्सु प्रतिष्ठितः।\nएवं हि निहितां शक्र भूतेषु परिधत्स्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081343, "chapter_id": 2727, "verse_number": "१२-२३२-२९x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081344, "chapter_id": 2727, "verse_number": "१२-२३२-२९", "content_sanskrit": "`भूमिशुद्धिं ततः कृत्वा अद्भिः संतर्पयन्ति ये।\nभूतानि च यजन्त्यग्नौ तेषां त्वमनपायिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081345, "chapter_id": 2727, "verse_number": "१२-२३२-३०", "content_sanskrit": "ये क्रियाभिः सुरक्ताभिर्हेतुयुक्ताः समाहिताः।\nज्ञानवन्तो विवत्सायां लब्धा माद्यन्ति योगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081346, "chapter_id": 2727, "verse_number": "१२-२३२-३१", "content_sanskrit": "भूतानामिह यो वै त्वां मया विनिहितां सतीम्।\nउपहन्यात्स मे द्वेष्यस्तथा शृण्वन्तु मे वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2081347, "chapter_id": 2727, "verse_number": "१२-२३२-३२x", "content_sanskrit": "`भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2081348, "chapter_id": 2727, "verse_number": "१२-२३२-३२", "content_sanskrit": "तथेति चोक्त्वा सा भ्रष्टा सर्वलोकनमस्कृता।\nवासवं पालयामास सा देवी कमलालया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2081349, "chapter_id": 2727, "verse_number": "१२-२३२-३३", "content_sanskrit": "ततस्त्यक्तः श्रिया राजा दैत्यानां बलिरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2081350, "chapter_id": 2727, "verse_number": "१२-२३२-३४", "content_sanskrit": "यावत्पुरस्तात्प्रतपेत्तावद्वै दक्षिणां दिशम्।\nपश्चिमां तावदेवापि तथोदीचीं दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2081351, "chapter_id": 2727, "verse_number": "१२-२३२-३५", "content_sanskrit": "तथा मध्यंदिने सूर्यो नास्तमेति यदा तदा।\nपुनर्देवासुरं युद्धं भावि जेताऽस्मि वस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2081352, "chapter_id": 2727, "verse_number": "१२-२३२-३६", "content_sanskrit": "सर्वलोकान्यदाऽऽदित्यो मध्यस्थस्तापयिष्यति।\nतदा देवासुरे युद्धे जेताऽहं त्वां शतक्रतो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2081353, "chapter_id": 2727, "verse_number": "१२-२३२-३७x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2081354, "chapter_id": 2727, "verse_number": "१२-२३२-३७", "content_sanskrit": "ब्रह्मणाऽस्मि समादिष्टो न हन्तव्यो भवानिति।\nतेन तेऽहं बले वज्रं न विमुञ्जामि मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2081355, "chapter_id": 2727, "verse_number": "१२-२३२-३८", "content_sanskrit": "यथेष्टं गच्छ दैत्येन्द्र स्वस्ति तेऽस्तु महासुर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2081356, "chapter_id": 2727, "verse_number": "१२-२३२-३९", "content_sanskrit": "आदित्यो नैव तपिता कदाचिन्मध्यतः स्थितः।\nस्थापितो ह्यस्य समयः पूर्वमेव स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2081357, "chapter_id": 2727, "verse_number": "१२-२३२-४०", "content_sanskrit": "अजस्रं परियात्येष सत्येनावतपन्प्रजाः।\nअयनं तस्य षण्मासा उत्तरं दक्षिणं तथा।\nयेन संयाति लोकेषु शीतोष्णे विसृजन्रविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2081358, "chapter_id": 2727, "verse_number": "१२-२३२-४१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2081359, "chapter_id": 2727, "verse_number": "१२-२३२-४१", "content_sanskrit": "एवमुक्तस्तु दैत्येन्द्रो बलिरिन्द्रेण भारत।\nजगाम दक्षिणामाशामुदीचीं तु पुरंदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2081360, "chapter_id": 2727, "verse_number": "१२-२३२-४२", "content_sanskrit": "इत्येतद्बलिना गीतमनहंकारसंज्ञितम्।\nवाक्यं श्रुत्वा सहस्राक्षः स्वमेवारुरुहे तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2081361, "chapter_id": 2727, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्वात्रिंशदधिकद्विशततमोऽध्यायः॥ २३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]