[{"id": 7003982000, "chapter_id": 23982, "verse_number": "३-१-४५-१", "content_sanskrit": "श्रीसूत उवाच ।\nएवं प्रतिष्ठिते लिंगे रामेणाक्लिष्टकारिणा ।\nलिंगं वरं समादाय मारुतिः सहसाऽययौ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003982001, "chapter_id": 23982, "verse_number": "३-१-४५-२", "content_sanskrit": "रामं दाशरथिं वीरमभिवाद्य स मारुतिः ।\nवैदेहीलक्ष्मणौ पश्चात्सुग्रीवं प्रणनाम च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003982002, "chapter_id": 23982, "verse_number": "३-१-४५-३", "content_sanskrit": "सीता सैकतलिंगं तत्पूजयंतं रघूद्वहम् ।\nदृष्ट्वाथ मुनिभिः सार्द्धं चुकोप पवनात्मजः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003982003, "chapter_id": 23982, "verse_number": "३-१-४५-४", "content_sanskrit": "अत्यंतं खेदखिन्नः सन्वृथाकृतपरिश्रमः ।\nउवाच रामं धर्मज्ञं हनूमानंजनात्मजः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003982004, "chapter_id": 23982, "verse_number": "३-१-४५-५", "content_sanskrit": "हनूमानुवाच ।\nदुर्जातोऽहं वृथा राम लोके क्लेशाय केवलम् ।\nखिन्नोऽस्मि बहुशो देव राक्षसैः क्रूरकर्मभिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003982005, "chapter_id": 23982, "verse_number": "३-१-४५-६", "content_sanskrit": "मा स्म सीमंतिनी काचिज्जनयेन्मादृशं सुतम् ।\nयतोऽनुभूयते दुःखमनंतं भवसागरे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003982006, "chapter_id": 23982, "verse_number": "३-१-४५-७", "content_sanskrit": "खिन्नोऽस्मि सेवया पूर्वं युद्धेनापि ततोधिकम् ।\nअनन्तं दुःखमधुना यतो मामवमन्यसे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003982007, "chapter_id": 23982, "verse_number": "३-१-४५-८", "content_sanskrit": "सुग्रीवेण च भार्यार्थं राज्यार्थं राक्षसेन च ।\nरावणावरजेन त्वं सेवितो ऽसि रघूद्वह॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003982008, "chapter_id": 23982, "verse_number": "३-१-४५-९", "content_sanskrit": "मया निर्हेतुकं राम सेवितोऽसि महामते ।\nवानराणामनेकेषु त्वयाज्ञप्तोऽहमद्य वै॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003982009, "chapter_id": 23982, "verse_number": "३-१-४५-१०", "content_sanskrit": "शिवलिंगं समानेतुं कैलासात्पर्वतो त्तमात् ।\nकैलासं त्वरितो गत्वा न चापश्यं पिनाकिनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003982010, "chapter_id": 23982, "verse_number": "३-१-४५-११", "content_sanskrit": "तपसा प्रीणयित्वा तं सांबं वृषभवाहनम् ।\nप्राप्तलिंगो रघुपते त्वरितः समु पागतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003982011, "chapter_id": 23982, "verse_number": "३-१-४५-१२", "content_sanskrit": "अन्यलिंगं त्वमधुना प्रतिष्ठाप्य तु सैकतम् ।\nमुनिभिर्देवगन्धर्वैः साकं पूजयसे विभो॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003982012, "chapter_id": 23982, "verse_number": "३-१-४५-१३", "content_sanskrit": "मयानीतमिदं लिंगं कैलासा त्पर्वताद्वृथा ।\nअहो भाराय मे देहो मन्दभाग्यस्यजायते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003982013, "chapter_id": 23982, "verse_number": "३-१-४५-१४", "content_sanskrit": "भूतलस्य महाराज जानकीरमण प्रभो ।\nइदं दुःखमहं सोढुं न शक्नोमि रघूद्वह॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003982014, "chapter_id": 23982, "verse_number": "३-१-४५-१५", "content_sanskrit": "किं करिष्यामि कुत्राहं गमिष्यामि न मे गतिः ।\nअतः शरीरं त्यक्ष्यामि त्वयाहमवमानितः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003982015, "chapter_id": 23982, "verse_number": "३-१-४५-१६", "content_sanskrit": "श्रीसूत उवाच ।\nएवं स बहुशो विप्राः क्रुशित्वा पवनात्मजः ।\nदण्डवत्प्रणतो भूमौ क्रोधशोकाकुलोऽभवत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003982016, "chapter_id": 23982, "verse_number": "३-१-४५-१७", "content_sanskrit": "तं दृष्ट्वा रघुनाथोऽपि प्रहसन्निदमब्रवीत् ।\nपश्यतां सवदेवानां मुनीनां कपिरक्षसाम् ।\nसांत्वयन्मारुतिं तत्र दुःखं चास्य प्रमार्जयन्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003982017, "chapter_id": 23982, "verse_number": "३-१-४५-१८", "content_sanskrit": "श्रीराम उवाच ।\nसर्वं जानाम्यहं कार्यमात्मनोऽपि परस्य च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003982018, "chapter_id": 23982, "verse_number": "३-१-४५-१९", "content_sanskrit": "जातस्य जायमानस्य मृतस्यापि सदा कपे ।\nजायते म्रियते जन्तुरेक एव स्वकर्मणा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003982019, "chapter_id": 23982, "verse_number": "३-१-४५-२०", "content_sanskrit": "प्रयाति नरकं चापि परमात्मा तु निर्गुणः ।\nएवं तत्त्वं विनिश्चित्य शोकं मा कुरु वानर॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003982020, "chapter_id": 23982, "verse_number": "३-१-४५-२१", "content_sanskrit": "लिंगत्रयविनिर्मुक्तं ज्योतिरेकं निरंजनम् ।\nनिराश्रयं निर्विकारमात्मानं पश्य नित्यशः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003982021, "chapter_id": 23982, "verse_number": "३-१-४५-२२", "content_sanskrit": "किमर्थं कुरुषे शोकं तत्त्वज्ञानस्य बाधकम् ।\nतत्त्वज्ञाने सदा निष्ठां कुरु वानरसत्तम॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003982022, "chapter_id": 23982, "verse_number": "३-१-४५-२३", "content_sanskrit": "स्वयंप्रकाशमात्मानं ध्यायस्व सततं कपे ।\nदेहादौ ममतां मुंच तत्त्वज्ञानविरोधिनीम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003982023, "chapter_id": 23982, "verse_number": "३-१-४५-२४", "content_sanskrit": "धर्मं भजस्व सततं प्राणिहिंसां परित्यज ।\nसेवस्व साधुपुरुषाञ्जहि सर्वेंद्रियाणि च॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003982024, "chapter_id": 23982, "verse_number": "३-१-४५-२५", "content_sanskrit": "परित्यजस्व सततमन्येषां दोषकीर्तनम् ।\nशिवविष्ण्वादिदेवानामर्चां कुरु सदा कपे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003982025, "chapter_id": 23982, "verse_number": "३-१-४५-२६", "content_sanskrit": "सत्यं वदस्व सततं परित्यज शुचं कपे ।\nप्रत्यग्ब्रह्मैकताज्ञानं मोहवस्तुसमुद्गतम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003982026, "chapter_id": 23982, "verse_number": "३-१-४५-२७", "content_sanskrit": "शोभनाशोभना भ्रांतिः कल्पि तास्मिन्यथार्थवत् ।\nअध्यास्ते शोभनत्वेन पदार्थे मोहवैभवात्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003982027, "chapter_id": 23982, "verse_number": "३-१-४५-२८", "content_sanskrit": "रोगो विजायते नृणां भ्रांतानां कपिसत्तम ।\nरागद्वेषबलाद्बद्धा धर्मा धर्मवशंगताः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003982028, "chapter_id": 23982, "verse_number": "३-१-४५-२९", "content_sanskrit": "देवतिर्यङ्मनुष्याद्या निरयं यांति मानवाः ।\nचंदनागरुकर्पूरप्रमुखा अतिशोभनाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003982029, "chapter_id": 23982, "verse_number": "३-१-४५-३०", "content_sanskrit": "मलं भवंति यत्स्पर्शात्तच्छरीरं कथं सुखम् ।\nभक्ष्यभोज्यादयः सर्वे पदार्था अतिशोभनाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003982030, "chapter_id": 23982, "verse_number": "३-१-४५-३१", "content_sanskrit": "विष्ठा भवंति यत्संगात्तच्छरीरं कथं सुखम् ।\nसुगंधि शीतलं तोयं मूत्रं यत्संगमाद्भवेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003982031, "chapter_id": 23982, "verse_number": "३-१-४५-३२", "content_sanskrit": "तत्कथं शोभनं पिंडं भवेद्ब्रूहि कपेऽधुना ।\nअतीव धवलाः शुद्धाः पटा यत्संगमेनहि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003982032, "chapter_id": 23982, "verse_number": "३-१-४५-३३", "content_sanskrit": "भवंति मलिनाः स्वेदात्तत्कथं शोभनं भवेत ।\nश्रूयतां परमार्थो मे हनूमन्वायुनंदन॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003982033, "chapter_id": 23982, "verse_number": "३-१-४५-३४", "content_sanskrit": "अस्मिन्संसारगर्ते तु किंचित्सौख्यं न विद्यते ।\nप्रथमं जंतुराप्नोति जन्म बाल्यं ततः परम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003982034, "chapter_id": 23982, "verse_number": "३-१-४५-३५", "content_sanskrit": "पश्चाद्यौवनमाप्नोति ततो वार्धक्यमश्नुते ।\nपश्चान्मृत्युमवाप्नोति पुनर्जन्म तदश्नुते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003982035, "chapter_id": 23982, "verse_number": "३-१-४५-३६", "content_sanskrit": "अज्ञानवैभवादेव दुःखमाप्नोति मानवः ।\nतदज्ञान निवृत्तौ तु प्राप्नोति सुखमुत्तमम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003982036, "chapter_id": 23982, "verse_number": "३-१-४५-३७", "content_sanskrit": "अज्ञानस्य निवृत्तिस्तु ज्ञानादेव न कर्मणा ।\nज्ञानं नाम परं ब्रह्म ज्ञानं वेदांतवाक्यजम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003982037, "chapter_id": 23982, "verse_number": "३-१-४५-३८", "content_sanskrit": "तज्ज्ञानं च विरक्तस्य जायते नेतरस्य हि ।\nमुख्याधिकारिणः सत्यमाचार्यस्य प्रसादतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003982038, "chapter_id": 23982, "verse_number": "३-१-४५-३९", "content_sanskrit": "यदा सर्वे प्रमुच्यंते कामा येऽस्य हृदि स्थिताः ।\nतदा मर्त्योऽमृतोऽत्रैव परं ब्रह्म समश्नुते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003982039, "chapter_id": 23982, "verse_number": "३-१-४५-४०", "content_sanskrit": "जाग्रतं च स्वपंतं च भुंजंतं च स्थितं तथा ।\nइमं जनं सदा क्रूरः कृतांतः परिकर्षति॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003982040, "chapter_id": 23982, "verse_number": "३-१-४५-४१", "content_sanskrit": "सर्वे क्षयांता निचयाः पतनांताः समुच्छ्रयाः ।\nसंयोगा विप्रयोगांता मरणांतं च जीवितम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003982041, "chapter_id": 23982, "verse_number": "३-१-४५-४२", "content_sanskrit": "यथा फलानां पक्वानां नान्यत्र पतनाद्भयम् ।\nयथा नराणां जातानां नान्यत्र पतनाद्भयम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003982042, "chapter_id": 23982, "verse_number": "३-१-४५-४३", "content_sanskrit": "यथा गृहं दृढस्तंभं जीर्णं काले विनश्यति ।\nएवं विनश्यंति नरा जरामृत्युवशंगताः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003982043, "chapter_id": 23982, "verse_number": "३-१-४५-४४", "content_sanskrit": "अहोरात्रस्य गमनान्नृणामायुर्विनश्यति ।\nआत्मानमनुशोच त्वं किमन्यमनुशोचसि॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003982044, "chapter_id": 23982, "verse_number": "३-१-४५-४५", "content_sanskrit": "नश्यत्यायुः स्थितस्यापि धावतोऽपि कपीश्वर ।\nसहैव मृत्युर्व्रजति सह मृत्युर्निषीदति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003982045, "chapter_id": 23982, "verse_number": "३-१-४५-४६", "content_sanskrit": "चरित्वा दूरदेशं च सह मृत्युर्निवर्तते ।\nशरीरे वलयः प्राप्ताः श्वेता जाताः शिरोरुहाः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003982046, "chapter_id": 23982, "verse_number": "३-१-४५-४७", "content_sanskrit": "जीर्यते जरया देहः श्वासकासादिना तथा ।\nयथा काष्ठं च काष्ठं च समेयातां महोदधौ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003982047, "chapter_id": 23982, "verse_number": "३-१-४५-४८", "content_sanskrit": "समेत्य च व्यपेयातां कालयोगेन वानर ।\nएवं भार्या च पुत्रश्च वधुक्षेत्रधनानि च॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003982048, "chapter_id": 23982, "verse_number": "३-१-४५-४९", "content_sanskrit": "क्वचित्संभूय गच्छंति पुनरन्यत्र वानर ।\nयथा हि पांथं गच्छंतं पथि कश्चित्पथि स्थितः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003982049, "chapter_id": 23982, "verse_number": "३-१-४५-५०", "content_sanskrit": "अहमप्या गमिष्यामि भवद्भिः साकमित्यथ ।\nकंचित्कालं समेतौ तौ पुनरन्यत्र गच्छतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003982050, "chapter_id": 23982, "verse_number": "३-१-४५-५१", "content_sanskrit": "एवं भार्यासुतादीनां संगमो नश्वरः कपे ।\nशरीरजन्मना साकं मृत्युः संजायते ध्रुवम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003982051, "chapter_id": 23982, "verse_number": "३-१-४५-५२", "content_sanskrit": "अवश्यंभाविमरणे न हि जातु प्रतिक्रिया ।\nएतच्छरीरपाते तु देही कर्मगतिं गतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003982052, "chapter_id": 23982, "verse_number": "३-१-४५-५३", "content_sanskrit": "प्राप्य पिंडांतरं वत्स पूर्वपिंडं त्यजत्यसौ ।\nप्राणिनां न सदैकत्र वासो भवति वानर॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003982053, "chapter_id": 23982, "verse_number": "३-१-४५-५४", "content_sanskrit": "स्वस्वकर्मवशात्सर्वे वियुज्यंते पृथक्पृथक् ।\nयथा प्राणिशरीराणि नश्यंति च भवंति च॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003982054, "chapter_id": 23982, "verse_number": "३-१-४५-५५", "content_sanskrit": "आत्मनो जन्ममरणे नैव स्तः कपिसत्तम ।\nअतस्त्वमंजनासूनो विशोकं ज्ञानमद्वयं॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003982055, "chapter_id": 23982, "verse_number": "३-१-४५-५६", "content_sanskrit": "सद्रूपममलं ब्रह्म चिंतयस्व दिवानिशम् ।\nत्वत्कृतं मत्कृतं कर्म मत्कृतं त्वाकृतं तथा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003982056, "chapter_id": 23982, "verse_number": "३-१-४५-५७", "content_sanskrit": "मल्लिंगस्थापनं तस्मात्त्वल्लिंग स्थापनं कपे ।\nमुहूर्तातिक्रमाल्लिंगं सैकतं सीतया कृतम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003982057, "chapter_id": 23982, "verse_number": "३-१-४५-५८", "content_sanskrit": "मयात्र स्थापितं तस्मात्कोपं दुःखं च मा कुरु ।\nकैलासादागतं लिंगं स्थापयास्मिच्छुभे दिने॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003982058, "chapter_id": 23982, "verse_number": "३-१-४५-५९", "content_sanskrit": "तव नाम्ना त्विदं लिंगं यातु लोकत्रये प्रथाम् ।\nहनूमदीश्वरं दृष्ट्वा द्रष्टव्यो राघवेश्वरः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003982059, "chapter_id": 23982, "verse_number": "३-१-४५-६०", "content_sanskrit": "ब्रह्मराक्षसयूथानि हतानि भवता कपे ।\nअतः स्वनाम्ना लिंगस्य स्थापनात्त्वं प्रमोक्ष्यसे॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003982060, "chapter_id": 23982, "verse_number": "३-१-४५-६१", "content_sanskrit": "स्वयं हरेण दत्तं तु हनूमन्नामकं शिवम् ।\nसंपश्यन्रामनाथं च कृतकृत्यो भवेन्नरः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003982061, "chapter_id": 23982, "verse_number": "३-१-४५-६२", "content_sanskrit": "योजनानां सहस्रेऽपि स्मृत्वा लिंगं हनूमतः ।\nरामनाथेश्वरं चापि स्मृत्वा सायुज्यमाप्नुयात्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003982062, "chapter_id": 23982, "verse_number": "३-१-४५-६३", "content_sanskrit": "तेनेष्टं सर्वयज्ञैश्च तपश्चाकारि कृत्स्नशः ।\nयेन दृष्टौ महादेवौ हनूमद्राघवेश्वरौ॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003982063, "chapter_id": 23982, "verse_number": "३-१-४५-६४", "content_sanskrit": "हनूमता कृतं लिंगं यच्च लिंगं मया कृतम् ।\nजानकीयं च यल्लिंगं यल्लिंगं लक्ष्मणेश्वरम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003982064, "chapter_id": 23982, "verse_number": "३-१-४५-६५", "content_sanskrit": "सुग्रीवेण कृतं यच्च सेतुकर्त्रा नलेन च ।\nअंगदेन च नीलेन तथा जांबवता कृतम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003982065, "chapter_id": 23982, "verse_number": "३-१-४५-६६", "content_sanskrit": "विभीषणेन यच्चापि रत्नलिंगं प्रतिष्ठितम् ।\nइन्द्राद्यैश्च कृतं लिंगं यच्छेषाद्यैः प्रतिष्ठितम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003982066, "chapter_id": 23982, "verse_number": "३-१-४५-६७", "content_sanskrit": "इत्येकादशरूपोऽयं शिवः साक्षाद्विभासते ।\nसदा ह्येतेषु लिंगेषु संनिधत्ते महेश्वरः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003982067, "chapter_id": 23982, "verse_number": "३-१-४५-६८", "content_sanskrit": "तत्स्वपापौघशुद्ध्यर्थं स्थापयस्व महेश्वरम् ।\nअथ चेत्त्वं महाभाग लिंगमुत्सादयिष्यसि॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003982068, "chapter_id": 23982, "verse_number": "३-१-४५-६९", "content_sanskrit": "मयात्र स्थापितं वत्स सीतया सैकतं कृतम् ।\nस्थापयिष्यामि च ततो लिंगमेतत्त्वया कृतम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003982069, "chapter_id": 23982, "verse_number": "३-१-४५-७०", "content_sanskrit": "पातालं सुतलं प्राप्य वितलं च रसातलम् ।\nतलातलं च तदिदं भेदयित्वा तु तिष्ठति॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003982070, "chapter_id": 23982, "verse_number": "३-१-४५-७१", "content_sanskrit": "प्रतिष्ठितं मया लिंगं भेत्तुं कस्य बलं भवेत् ।\nउत्तिष्ठ लिंगमुद्वास्य मयैतत्स्थापितं कपे॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003982071, "chapter_id": 23982, "verse_number": "३-१-४५-७२", "content_sanskrit": "त्वया समाहृतं लिंगं स्थापयस्वाशु मा शुचः ।\nइत्युक्तस्तं प्रणम्याथाज्ञातसत्त्वोऽथ वानरः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003982072, "chapter_id": 23982, "verse_number": "३-१-४५-७३", "content_sanskrit": "उद्वासयामि वेगेन सैकतं लिंगमुत्त मम् ।\nसंस्थापयामि कैलासादानीतं लिंगमादरात्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003982073, "chapter_id": 23982, "verse_number": "३-१-४५-७४", "content_sanskrit": "उद्वासने सैकतस्य कियान्भारो भवेन्मम ।\nचेतसैवं विचार्यायं हनूमान्मारुता त्मजः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003982074, "chapter_id": 23982, "verse_number": "३-१-४५-७५", "content_sanskrit": "पश्यतां सर्वदेवानां मुनीनां कपिरक्षसाम् ।\nपश्यतो रामचन्द्रस्य लक्ष्मणस्यापि पश्यतः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003982075, "chapter_id": 23982, "verse_number": "३-१-४५-७६", "content_sanskrit": "पश्यंत्या अपि वैदेह्या लिंगं तत्सैकतं बलात् ।\nपाणिना सर्वयत्नेन जग्राह तरसा बली॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003982076, "chapter_id": 23982, "verse_number": "३-१-४५-७७", "content_sanskrit": "यत्नेन महता चायं चालयन्नपि मारुतिः ।\nनालं चालयितुं ह्यासीत्सैकतं लिंगमोजसा॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003982077, "chapter_id": 23982, "verse_number": "३-१-४५-७८", "content_sanskrit": "ततः किलकिलाशब्दं कुर्वन्वानरपुंगवः ।\nपुच्छमुद्यम्य पाणिभ्यां निरास्थत्तन्निजौजसा॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003982078, "chapter_id": 23982, "verse_number": "३-१-४५-७९", "content_sanskrit": "इत्यनेकप्रकारेण चाल यन्नपि वानरः ।\nनैव चालयितुं शक्तो बभूव पवनात्मजः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003982079, "chapter_id": 23982, "verse_number": "३-१-४५-८०", "content_sanskrit": "तद्वेष्टयित्वा पुच्छेन पाणिभ्यां धरणीं स्पृशन् ।\nउत्पपाताथ तरसा व्योम्नि वायुसुतः कपिः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003982080, "chapter_id": 23982, "verse_number": "३-१-४५-८१", "content_sanskrit": "कंपयन्स धरां सर्वां सप्तद्वीपां सपर्वतम् ।\nलिंगस्य क्रोशमात्रे तु मूर्च्छितो रुधिरं वमन्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003982081, "chapter_id": 23982, "verse_number": "३-१-४५-८२", "content_sanskrit": "पपात हनुमान्विप्राः कंपितांगो धरातले ।\nपततो वायुपुत्रस्य वक्त्राच्च नयनद्वयात्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003982082, "chapter_id": 23982, "verse_number": "३-१-४५-८३", "content_sanskrit": "नासापुटाच्छ्रोत्ररंध्रादपानाच्च द्विजोत्तमाः ।\nरुधिरौघः प्रसुस्राव रक्तकुण्ड मभूच्च तत्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003982083, "chapter_id": 23982, "verse_number": "३-१-४५-८४", "content_sanskrit": "ततो हाहाकृतं सर्वं सदेवासुरमानुषम् ।\nधावंतौ कपिभिः सार्द्धमुभौ तौ रामलक्ष्मणौ॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003982084, "chapter_id": 23982, "verse_number": "३-१-४५-८५", "content_sanskrit": "जानकीसहितौ विप्रा ह्यास्तां शोकाकुलौ तदा ।\nसीतया सहितौ वीरौ वानरैश्च महाबलौ॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003982085, "chapter_id": 23982, "verse_number": "३-१-४५-८६", "content_sanskrit": "रुरुचाते तदा विप्रा गन्धमादनपर्वते ।\nयथा तारागणयुतौ रजन्यां शशि भास्करौ॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003982086, "chapter_id": 23982, "verse_number": "३-१-४५-८७", "content_sanskrit": "ददर्शतुर्हनूमंतं चूर्णीकृतकलेवरम् ।\nमूर्च्छितं पतितं भूमौ वमन्तं रुधिरं मुखात्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003982087, "chapter_id": 23982, "verse_number": "३-१-४५-८८", "content_sanskrit": "विलोक्य कपयः सर्वे हाहाकृत्वाऽपतन्भुवि ।\nकराभ्यां सदयं सीता हनूमंतं मरुत्सुतम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003982088, "chapter_id": 23982, "verse_number": "३-१-४५-८९", "content_sanskrit": "ताततातेति पस्पर्श पतितं धरणीतले ।\nरामोऽपि दृष्ट्वा पतितं हनूमंतं कपीश्वरम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003982089, "chapter_id": 23982, "verse_number": "३-१-४५-९०", "content_sanskrit": "आरोप्यांकं स्वपाणिभ्यामाममर्श कलेवरम् ।\nविमुंचन्नेत्रजं वारि वायुजं चाव्रवीद्द्विजाः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]