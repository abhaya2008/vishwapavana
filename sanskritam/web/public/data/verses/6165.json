[
  {
    "id": 16765001,
    "chapter_id": 6165,
    "verse_number": "17.1",
    "content_sanskrit": "अर्जुन उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C17_V01"
  },
  {
    "id": 16765002,
    "chapter_id": 6165,
    "verse_number": "17.2",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C17_V02"
  },
  {
    "id": 16765003,
    "chapter_id": 6165,
    "verse_number": "17.3",
    "content_sanskrit": "सत्त्वानुरूपा सर्वस्य\nश्रद्धा भवति भारत ।\nश्रद्धामयोऽयं पुरुषो\nयो यच्छ्रद्धः स एव सः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C17_V03"
  },
  {
    "id": 16765004,
    "chapter_id": 6165,
    "verse_number": "17.4",
    "content_sanskrit": "यजन्ते सात्त्विका देवान्यक्षरक्षांसि राजसाः ।\nप्रेतान्भूतगणांश्चान्ये यजन्ते तामसा जनाः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C17_V04"
  },
  {
    "id": 16765005,
    "chapter_id": 6165,
    "verse_number": "17.5",
    "content_sanskrit": "अशास्त्रविहितं घोरं तप्यन्ते ये तपो जनाः ।\nदम्भाहङ्कारसंयुक्ताः कामरागबलान्विताः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C17_V05"
  },
  {
    "id": 16765006,
    "chapter_id": 6165,
    "verse_number": "17.6",
    "content_sanskrit": "कर्शयन्तः शरीरस्थं\nभूतग्राममचेतसः ।\nमां चैवान्तःशरीरस्थं\nतान्विद्ध्यासुरनिश्चयान् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C17_V06"
  },
  {
    "id": 16765007,
    "chapter_id": 6165,
    "verse_number": "17.7",
    "content_sanskrit": "आहारस्त्वपि सर्वस्य त्रिविधो भवति प्रियः ।\nयज्ञस्तपस्तथा दानं तेषां भेदमिमं शृणु ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C17_V07"
  },
  {
    "id": 16765008,
    "chapter_id": 6165,
    "verse_number": "17.8",
    "content_sanskrit": "आयुःसत्त्वबलारोग्यसुखप्रीतिविवर्धनाः ।\nरस्याः स्निग्धाः स्थिरा हृद्या आहाराः सात्त्विकप्रियाः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C17_V08"
  },
  {
    "id": 16765009,
    "chapter_id": 6165,
    "verse_number": "17.9",
    "content_sanskrit": "कट्वम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः ।\nआहारा राजसस्येष्टा दुःखशोकामयप्रदाः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C17_V09"
  },
  {
    "id": 16765010,
    "chapter_id": 6165,
    "verse_number": "17.10",
    "content_sanskrit": "यातयामं गतरसं पूति पर्युषितं च यत् ।\nउच्छिष्टमपि चामेध्यं भोजनं तामसप्रियम् ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C17_V10"
  },
  {
    "id": 16765011,
    "chapter_id": 6165,
    "verse_number": "17.11",
    "content_sanskrit": "अफलाकाङ्क्षिभिर्यज्ञो विधिदृष्टो य इज्यते ।\nयष्टव्यमेवेति मनः समाधाय स सात्त्विकः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C17_V11"
  },
  {
    "id": 16765012,
    "chapter_id": 6165,
    "verse_number": "17.12",
    "content_sanskrit": "अभिसन्धाय तु फलं दम्भार्थमपि चैव यत् ।\nइज्यते भरतश्रेष्ठ तं यज्ञं विद्धि राजसम् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C17_V12"
  },
  {
    "id": 16765013,
    "chapter_id": 6165,
    "verse_number": "17.13",
    "content_sanskrit": "विधिहीनमसृष्टान्नं मन्त्रहीनमदक्षिणम् ।\nश्रद्धाविरहितं यज्ञं तामसं परिचक्षते ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C17_V13"
  },
  {
    "id": 16765014,
    "chapter_id": 6165,
    "verse_number": "17.14",
    "content_sanskrit": "देवद्विजगुरुप्राज्ञपूजनं शौचमार्जवम् ।\nब्रह्मचर्यमहिंसा च शारीरं तप उच्यते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C17_V14"
  },
  {
    "id": 16765015,
    "chapter_id": 6165,
    "verse_number": "17.15",
    "content_sanskrit": "अनुद्वेगकरं वाक्यं सत्यं प्रियहितं च यत् ।\nस्वाध्यायाभ्यसनं चैव वाङ्मयं तप उच्यते ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C17_V15"
  },
  {
    "id": 16765016,
    "chapter_id": 6165,
    "verse_number": "17.16",
    "content_sanskrit": "मनःप्रसादः सौम्यत्वं मौनमात्मविनिग्रहः ।\nभावसंशुद्धिरित्येतत्तपो मानसमुच्यते ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C17_V16"
  },
  {
    "id": 16765017,
    "chapter_id": 6165,
    "verse_number": "17.17",
    "content_sanskrit": "श्रद्धया परया तप्तं तपस्तत्त्रिविधं नरैः ।\nअफलकाङ्क्षिभिर्युक्तैः सात्त्विकं परिचक्षते ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C17_V17"
  },
  {
    "id": 16765018,
    "chapter_id": 6165,
    "verse_number": "17.18",
    "content_sanskrit": "सत्कारमानपूजार्थं तपो दम्भेन चैव यत् ।\nक्रियते तदिह प्रोक्तं राजसं चलमध्रुवम् ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C17_V18"
  },
  {
    "id": 16765019,
    "chapter_id": 6165,
    "verse_number": "17.19",
    "content_sanskrit": "मूढग्राहेणात्मनो यत्पीडया क्रियते तपः ।\nपरस्योत्सादनार्थं वा तत्तामसमुदाहृतम् ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C17_V19"
  },
  {
    "id": 16765020,
    "chapter_id": 6165,
    "verse_number": "17.20",
    "content_sanskrit": "दातव्यमिति यद्दानं\nदीयतेऽनुपकारिणे ।\nदेशे काले च पात्रे च\nतद्दानं सात्त्विकं स्मृतम् ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C17_V20"
  },
  {
    "id": 16765021,
    "chapter_id": 6165,
    "verse_number": "17.21",
    "content_sanskrit": "यत्तु प्रत्युपकारार्थं\nफलमुद्दिश्य वा पुनः ।\nदीयते च परिक्लिष्टं\nतद्दानं राजसं स्मृतम् ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C17_V21"
  },
  {
    "id": 16765022,
    "chapter_id": 6165,
    "verse_number": "17.22",
    "content_sanskrit": "अदेशकाले यद्दानमपात्रेभ्यश्च दीयते ।\nअसत्कृतमवज्ञातं तत्तामसमुदाहृतम् ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C17_V22"
  },
  {
    "id": 16765023,
    "chapter_id": 6165,
    "verse_number": "17.23",
    "content_sanskrit": "ओं तत्सदिति निर्देशो ब्रह्मणस्त्रिविधः स्मृतः ।\nब्राह्मणास्तेन वेदाश्च यज्ञाश्च विहिताः पुरा ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C17_V23"
  },
  {
    "id": 16765024,
    "chapter_id": 6165,
    "verse_number": "17.24",
    "content_sanskrit": "तस्मादोमित्युदाहृत्य यज्ञदानतपःक्रियाः ।\nप्रवर्तन्ते विधानोक्ताः सततं ब्रह्मवादिनाम् ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C17_V24"
  },
  {
    "id": 16765025,
    "chapter_id": 6165,
    "verse_number": "17.25",
    "content_sanskrit": "तदित्यनभिसन्धाय\nफलं यज्ञतपःक्रियाः ।\nदानक्रियाश्च विविधाः\nक्रियन्ते मोक्षकाङ्क्षिभिः ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C17_V25"
  },
  {
    "id": 16765026,
    "chapter_id": 6165,
    "verse_number": "17.26",
    "content_sanskrit": "सद्भावे साधुभावे च सदित्येतत्प्रयुज्यते ।\nप्रशस्ते कर्मणि तथा सच्छब्दः पार्थ युज्यते ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C17_V26"
  },
  {
    "id": 16765027,
    "chapter_id": 6165,
    "verse_number": "17.27",
    "content_sanskrit": "यज्ञे तपसि दाने च स्थितिः सदिति चोच्यते ।\nकर्म चैव तदर्थीयं सदित्येवाभिधीयते ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C17_V27"
  },
  {
    "id": 16765028,
    "chapter_id": 6165,
    "verse_number": "17.28",
    "content_sanskrit": "अश्रद्धया हुतं दत्तं तपस्तप्तं कृतं च यत् ।\nअसदित्युच्यते पार्थ न च तत्प्रेत्य नो इह ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C17_V28"
  }
]