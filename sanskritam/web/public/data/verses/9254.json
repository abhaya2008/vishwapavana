[{"id": 40016803, "chapter_id": 9254, "verse_number": "1", "content_sanskrit": "स लङ्घयित्वाप्राकारंगिरिकूटोपमोमहान् । निर्ययौनगरात्तूर्णंकुम्भकर्णोमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016804, "chapter_id": 9254, "verse_number": "2", "content_sanskrit": "ननाद च महानादंसमुद्रमभिनादयन् । विजयन्निवनिर्घातन्विधमन्निवपर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016805, "chapter_id": 9254, "verse_number": "3", "content_sanskrit": "तमवध्यंमघवतायमेनवरुणेनवा । प्रेक्ष्यभीमाक्षमायान्तंवानराविप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016806, "chapter_id": 9254, "verse_number": "4", "content_sanskrit": "तांस्तुविप्रद्रुतान् दृष्टवाराजपुत्रोऽङ्गदोऽब्रवीत् । नलंनीलंगवाक्षं च कुमुदं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016807, "chapter_id": 9254, "verse_number": "5", "content_sanskrit": "आत्मानमत्रविस्मृत्यवीर्याण्यभिजनानि च । क्वगच्छतभयत्रस्ताःप्राकृताहरयोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016808, "chapter_id": 9254, "verse_number": "6", "content_sanskrit": "साधुसौम्या निवर्तध्वंकिप्राणान्परिरक्षथ । नालंयुद्धायवैरक्षोमहतीयंबिभीषका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016809, "chapter_id": 9254, "verse_number": "7", "content_sanskrit": "महतीमुथतितामेनांराक्षसानांबिभीषिकाम् । विक्रमाद्विधमिष्यामोनिवर्तध्वंप्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016810, "chapter_id": 9254, "verse_number": "8", "content_sanskrit": "कृच्छ्रेणतुसमाश्वस्यसङ्गम्य च ततस्ततः । वृक्षाद्रिहस्ताहरयस्सम्प्रतस्थूरणाजिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016811, "chapter_id": 9254, "verse_number": "9", "content_sanskrit": "तेनिवृत्यतुसङ्कृद्धाःकुम्भकर्णंवनौकसः । निर्जघ्नुःपरमक्रुद्धास्समदाइवकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016812, "chapter_id": 9254, "verse_number": "10", "content_sanskrit": "प्रांशुभिर्गिरिशृङ्गैश्चशिलाभिश्चमहाबलः । पादपैःपुष्पिताग्रैश्चहन्यमानो न कम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016813, "chapter_id": 9254, "verse_number": "11", "content_sanskrit": "तस्यगात्रेषुपतिताभिद्यन्तेशतशश्शिलाः । पादपाःपुष्पिताग्राश्चभग्नाःपेतुर्महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016814, "chapter_id": 9254, "verse_number": "12", "content_sanskrit": "सोऽपिसैन्यानिसङ्क्रुद्धोवानराणांमहौजसाम् । ममन्थपरमायत्तोवनान्यग्निरिवोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016815, "chapter_id": 9254, "verse_number": "13", "content_sanskrit": "लोहितार्द्रास्तुबहवश्शेरतेवानरर्षभाः । निरस्तांपतिताभूमौताम्रपुष्पाइवद्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016816, "chapter_id": 9254, "verse_number": "14", "content_sanskrit": "लङ्घयन्तःप्रधावन्तोवानरानावलोकयन् । केचित्समुद्रेपतिताःकेचिद्गगनमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016817, "chapter_id": 9254, "verse_number": "15", "content_sanskrit": "वध्यमानास्तुतेवीराराक्षसेन च लीलया । सागरंयेनतेतीर्णाःपथातेनदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016818, "chapter_id": 9254, "verse_number": "16", "content_sanskrit": "तेस्थलानितदानिम्नंविवर्णमानाभयात् । ऋक्षावृक्षान् समारूढाःकेचित्पर्वतमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016819, "chapter_id": 9254, "verse_number": "17", "content_sanskrit": "ममज्जुरर्णवेकेचिद्गुहाःकेचित्समाश्रिताः । निपेतुःकेचिदपरेकेचिन्नैवावतस्थिरे ॥ केचिद्भूमौनिपतिताःकेचित्सुप्तामृताइव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016820, "chapter_id": 9254, "verse_number": "18", "content_sanskrit": "तान्समीक्ष्याङ्गदोभग्नान्वानरानिदमब्रवीत् ॥ अवतिष्ठतयुध्यामोनिवर्तध्वंप्लवङ्गमाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016821, "chapter_id": 9254, "verse_number": "19", "content_sanskrit": "भग्नानांवो न पश्यामिपरिगम्यमहीमिमाम् ॥ स्थानंसर्वेनिवर्तध्वंकिंप्राणान् परिरक्षथ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016822, "chapter_id": 9254, "verse_number": "20", "content_sanskrit": "निरायुधानांद्रवतामसङ्गगतिपौरुषाः ॥ दाराह्युपहसिष्यन्ति स वैघातस्तुजीवताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016823, "chapter_id": 9254, "verse_number": "21", "content_sanskrit": "कुलेषुजातास्सर्वेस्मविस्तीर्णेषुमहत्सु च ॥ क्वगच्छतभयत्रस्ताःहरयःप्राकृतायथा । अनार्याःखलुयद्भीतास्त्यक्त्वावीर्यंप्रधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016824, "chapter_id": 9254, "verse_number": "22", "content_sanskrit": "कुलेषुजातास्सर्वेस्मविस्तीर्णेषुमहत्सु च ॥ क्वगच्छतभयत्रस्ताःहरयःप्राकृतायथा । अनार्याःखलुयद्भीतास्त्यक्त्वावीर्यंप्रधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016825, "chapter_id": 9254, "verse_number": "23", "content_sanskrit": "विकत्थनानिवोयानि तदावैजनसंसदि । तानिवःक्वनुयातानिसोदग्राणिम हितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016826, "chapter_id": 9254, "verse_number": "24", "content_sanskrit": "भीरुप्रवादाश्श्रूयन्तेयस्तुजीवतिधिक्कृतः । मार्गस्सत्पुरुषैर्जष्टःसेव्यतांत्यज्यतांभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016827, "chapter_id": 9254, "verse_number": "25", "content_sanskrit": "शयामहेऽनिहताःपृथिव्यामल्पजीविताः । दुष्प्रापंब्रह्मलोकंवाप्राप्नुयामोयुधिसूदिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016828, "chapter_id": 9254, "verse_number": "26", "content_sanskrit": "सम्प्राप्नुयामःकीर्तिंवानिहत्वाशत्रुमाहवे । जीवितंवीरलोकस्यमोक्ष्यामोवसुवानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016829, "chapter_id": 9254, "verse_number": "27", "content_sanskrit": "न कुम्भकर्णःकाकुत्स्थंदृष्टवाजीवन् गमिष्यति । दीप्यमानमिवासाद्यपतङ्गोज्वलनंयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016830, "chapter_id": 9254, "verse_number": "28", "content_sanskrit": "लायनेनचोद्धिष्टाःप्राणान् रक्षामहेवयम् । एकेनबहवोभग्नायशोनाशंगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016831, "chapter_id": 9254, "verse_number": "29", "content_sanskrit": "एवंब्रुवाणंतंशूरमङ्गदंकनकाङ्गदम् । द्रवमाणास्ततोवाक्यमूचुःशूरुविगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016832, "chapter_id": 9254, "verse_number": "30", "content_sanskrit": "कृतंनःकदनंघोरंकुम्भकर्णेनरक्षसा । न स्थानकालोगच्छामोदयितंजीवितंहिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016833, "chapter_id": 9254, "verse_number": "31", "content_sanskrit": "एतावदुक्त्वावचनंसर्वेतेभेजिरेदिशः । भीमंभीमाक्षमायान्तंदृष्टवावानरयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016834, "chapter_id": 9254, "verse_number": "32", "content_sanskrit": "द्रवमाणस्तुतेवीराअङ्गदेनवलीमुखाः । सान्त्वैश्चैहनुमानैश्चततस्सर्वेनिवर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016835, "chapter_id": 9254, "verse_number": "33", "content_sanskrit": "प्रहर्षमुपनीताश्चवालिपुत्रेणधीमता । आज्ञाप्रतीक्षास्तस्थुश्चसर्वेवानरयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016836, "chapter_id": 9254, "verse_number": "34", "content_sanskrit": "ऋषभशरभमैन्दधूम्रनीलाःकुमुदसुषेणगवाक्षरम्भताराः । द्विविदपनसवायुपुत्रमुख्यास्त्वरिततराभिमुखंरणं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]