[{"id": 2031317, "chapter_id": 1682, "verse_number": "४-५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031318, "chapter_id": 1682, "verse_number": "४-५-१", "content_sanskrit": "कर्माण्युक्तानि युष्माभिर्यानि तानि चरिष्यथ।\nमम चापि यथा बुद्धिरुचिता हि विनिश्चयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031319, "chapter_id": 1682, "verse_number": "४-५-२", "content_sanskrit": "पुरोहितोऽयमस्माकमग्निहोत्राणि रक्षतु।\nसूतपौरोगवैः सार्धं द्रुपदस्य निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031320, "chapter_id": 1682, "verse_number": "४-५-३", "content_sanskrit": "इन्द्रसेनमुखाश्चेमे रथानादाय केवलान् ।\nयान्तु द्वारवतीं शीघ्रमिति मे वर्तते मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031321, "chapter_id": 1682, "verse_number": "४-५-४", "content_sanskrit": "इमाश्च नार्यो द्रौपद्याः सर्वाश्च परिचारिका ।\nपाञ्चालानेव गच्छन्तु सूतपौरोगवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031322, "chapter_id": 1682, "verse_number": "४-५-५", "content_sanskrit": "सर्वैरपि च वक्तव्यं न प्राज्ञायन्त पाण्डवाः ।\nअर्धरात्रे महात्मानो भिक्षादान्ब्राह्मणानपि।\nगता ह्यस्मानपाहाय सर्वे द्वैतवनादिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031323, "chapter_id": 1682, "verse_number": "४-५-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031324, "chapter_id": 1682, "verse_number": "४-५-६", "content_sanskrit": "एवं तेऽन्योन्यमामन्त्र्य कर्माण्युक्त्वा पृथक्पृथक्।\nधौम्यमामन्त्रयामासुः स च तान्मन्त्रमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031325, "chapter_id": 1682, "verse_number": "४-५-७", "content_sanskrit": "तानन्वशात्स धर्मात्मा सर्वधर्मविशेषवित् ।\nधौम्यः पुरोहितो राजन्पाण्डवान्पुरुषर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031326, "chapter_id": 1682, "verse_number": "४-५-८x", "content_sanskrit": "धौम्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031327, "chapter_id": 1682, "verse_number": "४-५-८", "content_sanskrit": "विदितं वै यथा सर्वं लोके वृत्तमिदं नृप।\nविदिते चापि वक्तव्यं सुहृद्भिरनुरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031328, "chapter_id": 1682, "verse_number": "४-५-९", "content_sanskrit": "अतोऽहमभिवक्ष्यामि हेतुमात्रं निबोधत।\nहन्तेमां राजवसतिं राजपुत्रा ब्रवीमि वः।\nयथा राजकुलं प्राप्य चरन्प्रोष्य न रिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031329, "chapter_id": 1682, "verse_number": "४-५-१०", "content_sanskrit": "दुर्वासमेव कौरव्य जातेन कुरुवेश्मनि ।\nअमानितेन मानार्ह गूढेन परिवत्सरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031330, "chapter_id": 1682, "verse_number": "४-५-११", "content_sanskrit": "दिष्टद्वारो लभेद्द्रष्टुं राजस्वेषु न विश्वसेत्।\nन चानुशिष्याद्राजानमपृच्छन्तं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031331, "chapter_id": 1682, "verse_number": "४-५-१२", "content_sanskrit": "तूष्णीं त्वेनमुपासीत काले समभिपूजयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031332, "chapter_id": 1682, "verse_number": "४-५-१३", "content_sanskrit": "असूयन्ति हि राजानो जनाननृतवादिनः।\nतथैव चावमन्यन्ते मन्त्रिणं वादिनं मृषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031333, "chapter_id": 1682, "verse_number": "४-५-१४", "content_sanskrit": "विदिते चास्य कुर्वीत कार्याणि सुलघून्यपि।\nएवं विचरतो राज्ञि न क्षतिर्जायते क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031334, "chapter_id": 1682, "verse_number": "४-५-१५", "content_sanskrit": "पाण्डवाग्निरयं लोके सर्वशस्त्रमयो महान ।\nभर्ता गोप्ता च भूतानां राजा पुरुषविग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031335, "chapter_id": 1682, "verse_number": "४-५-१६", "content_sanskrit": "सर्वात्मना वर्तमानं यथा दोषो न संस्पृशेत् ।\nराजानमुपतिष्ठन्तं तस्य वृत्तं निबोधत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031336, "chapter_id": 1682, "verse_number": "४-५-१७", "content_sanskrit": "क्षत्रियं चैव सर्पं च ब्राह्मणं च बहुश्रुतम् ।\nनावमन्येत मेधावी कृशानपि कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031337, "chapter_id": 1682, "verse_number": "४-५-१८", "content_sanskrit": "एतत्रयं च पुरुषं निर्दहेदवमानितम्।\nराजा तस्माद्बुधैर्नित्यं पूजनीयः प्रयत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031338, "chapter_id": 1682, "verse_number": "४-५-१९", "content_sanskrit": "नातिवर्तेत मर्यादां पुरुषो राजसंमतः।\nव्यवहारं पुनर्लोके मर्यादां पण्डिता विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031339, "chapter_id": 1682, "verse_number": "४-५-२०", "content_sanskrit": "न हि पुत्रं न नप्तारं न भ्रातरमरिन्दम।\nसमतिक्रान्तमर्यादं पूजयन्ति पराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031340, "chapter_id": 1682, "verse_number": "४-५-२१", "content_sanskrit": "गच्छन्नपि परां भूतिं भूमिपालनियोजितः।\nजात्यन्ध इव मन्येत मर्यादामनुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031341, "chapter_id": 1682, "verse_number": "४-५-२२", "content_sanskrit": "धृष्टो द्वारं सदा पश्यन्न च राजसु विश्वसेत् ।\nतदेवासनमन्विच्छेद्यत्र नाभिलषेत्परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031342, "chapter_id": 1682, "verse_number": "४-५-२३", "content_sanskrit": "यत्रोपविष्टः संकल्पं नोपहन्याद्बलीयसः ।\nतदासनं राजकुले ईप्सेत पुरुषो वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031343, "chapter_id": 1682, "verse_number": "४-५-२४", "content_sanskrit": "यथैनं यत्र चासीनं शङ्कयेद्दुष्टचरिणम् ।\nन तत्रोपविशेज्जातु यो राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031344, "chapter_id": 1682, "verse_number": "४-५-२५", "content_sanskrit": "स्वभूमौ काममासीत तिष्ठेद्वा राजसन्निधौ।\nन त्वेवासनमन्यस्य प्रार्थयेत कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031345, "chapter_id": 1682, "verse_number": "४-५-२६", "content_sanskrit": "परासनगतं ह्येनं परस्य परिचारकाः ।\nपरिषद्यपकर्षेयुः परिहास्येत शत्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031346, "chapter_id": 1682, "verse_number": "४-५-२७", "content_sanskrit": "नित्यं विप्रतिषिद्धं तत्पुरस्तादासनं मतम् ।\nअर्थार्थं हि यदा भृत्यो राजानमुपतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031347, "chapter_id": 1682, "verse_number": "४-५-२८", "content_sanskrit": "दक्षिणं वाऽथ वामं वा भागमाश्रित्य पण्डितः।\nतिष्ठेद्विनीतवद्राजन्न पुरस्तान्न पृष्ठतः।\nराक्षिणामात्तशस्त्राणां पश्चात्स्थानं विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031348, "chapter_id": 1682, "verse_number": "४-५-२९", "content_sanskrit": "मातृगोत्रे स्वगोत्रे वा नाम्ना शीलेन वा पुनः ।\nसंग्रहार्थं मनुष्याणां नित्यमाभाषिता भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031349, "chapter_id": 1682, "verse_number": "४-५-३०", "content_sanskrit": "पूज्यमानोपि यो राज्ञा नरो न प्रतिपूजयेत्।\nनैनमाराधयेज्जातु शास्ता शिष्यानिवालसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031350, "chapter_id": 1682, "verse_number": "४-५-३१", "content_sanskrit": "नास्य युग्यं न पर्यङ्कं नासनं न रथं तथा।\nआरोहेत्संमतोऽस्मीति यो राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031351, "chapter_id": 1682, "verse_number": "४-५-३२", "content_sanskrit": "यो वै गृहेभ्यः प्रवसन्क्रियमाणमनुस्मरन् ।\nउत्थाने नित्यसंकल्पो निस्तन्द्रीः संघतात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031352, "chapter_id": 1682, "verse_number": "४-५-३३", "content_sanskrit": "परीतः क्षुत्पिपासाभ्यां विहाय परिदेवनम् ।\nदुःखेन सुखमन्विच्छेद्यो राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031353, "chapter_id": 1682, "verse_number": "४-५-३४", "content_sanskrit": "अन्येषु प्रेष्यमाणेषु पुरस्ताद्धीर उत्पतेत् ।\nकरिष्याम्यहमित्येव यः स राजसु सिध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031354, "chapter_id": 1682, "verse_number": "४-५-३५", "content_sanskrit": "उष्णे वा यदि वा शीते रात्रौ वा यदि वा दिवा ।\nआदिष्टो न विकल्पेत यः स राजसु सिद्ध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2031355, "chapter_id": 1682, "verse_number": "४-५-३६", "content_sanskrit": "नैव प्राप्तोऽवमन्येत सदाऽमात्यो विशारदः ।\nमानं प्राप्तो न हृष्येत न व्यथेच्च विमानितः ।\nऋदुर्मृदुः सत्यवादो यः स राजसु सिद्ध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2031356, "chapter_id": 1682, "verse_number": "४-५-३७", "content_sanskrit": "नैव लाभाद्धर्षमियान्न व्यथेच्च विमानितः।\nसमः पूर्णतुलेव स्याद्यो राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2031357, "chapter_id": 1682, "verse_number": "४-५-३८", "content_sanskrit": "अल्पेच्छो धृतिमान्राजञ्छायेवानुगतः सदा।\nदक्षः प्रदक्षिणो धीरः स राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2031358, "chapter_id": 1682, "verse_number": "४-५-३९", "content_sanskrit": "इतिहासपुराणज्ञः कुशलः सत्कथासु च।\nवदान्यः सत्यवाक्वापि यो राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2031359, "chapter_id": 1682, "verse_number": "४-५-४०", "content_sanskrit": "न मिथो भाषितं राज्ञो मनुष्येषु प्रकाशयेत् ।\nयं चासूयन्ति राजानः पुरुषं नो वदेच्च तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2031360, "chapter_id": 1682, "verse_number": "४-५-४१", "content_sanskrit": "नैषां कर्मसु संयुक्तो धनं किंचिदुपस्पृशेत्।\nप्राप्नुयादाददानो वा बन्धं वा वधमेव वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2031361, "chapter_id": 1682, "verse_number": "४-५-४२", "content_sanskrit": "हुल्योपस्थितयोः पश्य मम चान्यस्य चोभयोः ।\nअन्यं पुष्णाति मद्धीनमिति धीरो न मुह्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2031362, "chapter_id": 1682, "verse_number": "४-५-४३", "content_sanskrit": "श्रेयांसं हि परित्यज्य वैद्यं कर्मणिकर्मणि ।\nपापीयांसं प्रकुर्वीरञ्शीलमेषां तथाविधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2031363, "chapter_id": 1682, "verse_number": "४-५-४४", "content_sanskrit": "नैषां दारेषु कुर्वीत प्राज्ञो मैत्रीं कथंचन ।\nरक्षणं तु न सेवेत यो राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2031364, "chapter_id": 1682, "verse_number": "४-५-४५", "content_sanskrit": "यदा ह्यभिसमीक्षेत प्रेष्यं स्त्रीभिः समागतम् ।\nबुद्धिः परिभवेत्तस्य राजा शङ्केत वा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2031365, "chapter_id": 1682, "verse_number": "४-५-४६", "content_sanskrit": "शङ्कितस्य पुनः स्त्रीषु कस्य भृत्यस्य भूमिपः।\nजीवितं साधु मन्येत प्रकृतिस्थो बलात्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2031366, "chapter_id": 1682, "verse_number": "४-५-४७", "content_sanskrit": "हर्षवस्तुषु चाप्यत्र वर्तमानेषु केषु चित्।\nनातिगाढं प्रहृष्येत तान्येवास्यानुपूजयेत् ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2031367, "chapter_id": 1682, "verse_number": "४-५-४८", "content_sanskrit": "हर्षाद्धि मन्दः पुरुषः स्वैरं कुर्वीत वैकृतम् ।\nतदस्यान्तःपुरे वृत्तमीक्षां कुर्वीत भूमिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2031368, "chapter_id": 1682, "verse_number": "४-५-४९", "content_sanskrit": "अन्तःपुरगतं ह्येनं स्त्रियः क्लीबाश्च सर्वतः ।\nवर्तमानं यथावच्च कुत्सयेयुरसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2031369, "chapter_id": 1682, "verse_number": "४-५-५०", "content_sanskrit": "तस्माद्गम्भीरमात्मानं कृत्वा हर्षं नियम्य च।\nनित्यमन्तःपुरे राज्ञो न वृत्तं कीर्तयेद्बहिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2031370, "chapter_id": 1682, "verse_number": "४-५-५१", "content_sanskrit": "यथा हि सुमहामन्त्रो भिद्यमानो हरेत्सुखम्।\nएवमन्तःपुरे वृत्तं श्रूयमाणं बहिर्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2031371, "chapter_id": 1682, "verse_number": "४-५-५२", "content_sanskrit": "या तु वृत्तिरबाह्यानां बाह्यानामपि केवलम्।\nउभयेषां समस्तानां शृणु राजोपजीविनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2031372, "chapter_id": 1682, "verse_number": "४-५-५३", "content_sanskrit": "न स्त्रियो जातु मन्येत बाह्ये वाभ्यन्तरेऽपि वा ।\nअनुजीविनां नरेन्द्रस्तु सृजेद्धि सुमहद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2031373, "chapter_id": 1682, "verse_number": "४-५-५४", "content_sanskrit": "मत्वाऽस्य प्रियमात्मानं राजरत्नानि राजवत्।\nअराजा राजयोग्यानि नोपयुञ्जीत पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2031374, "chapter_id": 1682, "verse_number": "४-५-५५", "content_sanskrit": "अराजानं हि रत्नानि राजकान्तानि राजवत्।\nभुञ्जानं तं नरं राजा न तितिक्षेत जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2031375, "chapter_id": 1682, "verse_number": "४-५-५६", "content_sanskrit": "तस्मादव्यक्तभोगेन भोक्तव्यं भूतिमिच्छता ।\nतुल्यभोगं हि राजा तु भृत्यं कोपेन योजयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2031376, "chapter_id": 1682, "verse_number": "४-५-५७", "content_sanskrit": "न चापत्येन संप्रीतिं राज्ञः कुर्वीत केनचित् ।\nअधिक्षिप्तमनर्थं च द्वेष्यं च परिवर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2031377, "chapter_id": 1682, "verse_number": "४-५-५८", "content_sanskrit": "एतां हि सेवमानस्य नरसीमां चतुर्विधाम्।\nद्विधा विच्छिद्यते मूलं राजमूलोपसेविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2031378, "chapter_id": 1682, "verse_number": "४-५-५९", "content_sanskrit": "एतैस्तु विपरीता या नरसीमा नराधमैः ।\nतथा कुर्वीत संसर्गं न विरोधं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2031379, "chapter_id": 1682, "verse_number": "४-५-६०", "content_sanskrit": "बन्धुभिश्च नरेन्द्रस्य बलवद्भिश्च मानवैः ।\nसाधु मन्येत संसर्गं न विरोधं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2031380, "chapter_id": 1682, "verse_number": "४-५-६१", "content_sanskrit": "ताभ्यां तु नरसीमाभ्यां विरुद्धस्याल्पतेजसः ।\nप्रथमं छिद्यते मूलं द्वितीयं जायते भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2031381, "chapter_id": 1682, "verse_number": "४-५-६२", "content_sanskrit": "उद्धतानां च यो वेषः कुहकानां च यो भवेत् ।\nराजवेषं च विस्पष्टं सेवमानो न वर्धते।\nइतराभ्यां तु वेषाभ्यां परिहास्येत बान्धवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2031382, "chapter_id": 1682, "verse_number": "४-५-६३", "content_sanskrit": "अपुंभिश्चैव पुंभिश्च स्त्रीभिः स्त्रीदर्शिभिर्नरैः ।\nशक्ये सति न संभाषां जातु कुर्वीत कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2031383, "chapter_id": 1682, "verse_number": "४-५-६४", "content_sanskrit": "प्रतिसंभाषमाणो हि त्रिभिरेतैरचेतनः।\nश्येनः पेशीमिवादत्ते पुरुषो भूतिमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2031384, "chapter_id": 1682, "verse_number": "४-५-६५", "content_sanskrit": "ये च राज्ञाऽभिसत्कारं लभेरन्कारणादिव।\nतैश्च सामन्तदूतैश्च न संसज्येत कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2031385, "chapter_id": 1682, "verse_number": "४-५-६६", "content_sanskrit": "न चान्याचरितां भूमिमसंदिष्टो महीपतेः।\nउपसेवेत मेधावी यो राजवसतिं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2031386, "chapter_id": 1682, "verse_number": "४-५-६७", "content_sanskrit": "न च संदर्शने राज्ञां प्रबन्धमभिसंजपेत् ।\nअपि चैतद्दरिद्राणां व्यलीकस्थानमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2031387, "chapter_id": 1682, "verse_number": "४-५-६८", "content_sanskrit": "अर्थकामा च या नारी राजानं स्यादुपस्थिता।\nअनुजीवी तथायुक्तां निध्यायन्दुष्यते च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2031388, "chapter_id": 1682, "verse_number": "४-५-६९", "content_sanskrit": "तस्मान्नारीं न निध्यायेत्तथायुक्तां विचक्षणः।\nतथा क्षुतं च वातं च निष्ठीवं चाचरेच्छनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2031389, "chapter_id": 1682, "verse_number": "४-५-७०", "content_sanskrit": "न नर्मसु हसेज्जातु मूढवृत्तिर्हि सा स्मृता ।\nस्मितं तु मृदुपूर्वेण दर्शयीत प्रसादजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2031390, "chapter_id": 1682, "verse_number": "४-५-७१", "content_sanskrit": "न चाक्षौ न भुजौ जातु न च वाक्यं समाक्षिपेत्।\nन च तिर्यगवेक्षेत चक्षुर्भ्यां सम्यगाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2031391, "chapter_id": 1682, "verse_number": "४-५-७२", "content_sanskrit": "भ्रुकुटिं च न कुर्वीत न चाङ्गुष्ठैर्लिखेन्महीम्।\nन च गाढं विजृम्भेत जातु राज्ञः समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2031392, "chapter_id": 1682, "verse_number": "४-५-७३", "content_sanskrit": "न प्रशंसेन्ना चासूयेत्प्रियेषु च हितेषु च ।\nस्तूयमानेषु वा तत्र दूष्यमानेषु वा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2031393, "chapter_id": 1682, "verse_number": "४-५-७४", "content_sanskrit": "अथ संदृश्यमानेषु प्रियेषु च हितेषु च।\nश्रूयमाणेषु वाक्येषु वर्णयेदमृतं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2031394, "chapter_id": 1682, "verse_number": "४-५-७५", "content_sanskrit": "न राज्ञः प्रतिकूलानि सेवमानः सुखी भवेत्।\nपुत्रो वा यदि वा भ्राता यद्यप्यात्मसमो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2031395, "chapter_id": 1682, "verse_number": "४-५-७६", "content_sanskrit": "अप्रमत्तो हि राजानं रञ्जयेच्छीलसंपदा।\nउत्थानेन तु मेधावी शौचेन विविधेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2031396, "chapter_id": 1682, "verse_number": "४-५-७७", "content_sanskrit": "स्नानं हि वस्त्रशुद्धिश्च शारीरं शौचमुच्यते।\nअसक्तिः प्राकृतार्थेषु द्वितीयं शौचमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2031397, "chapter_id": 1682, "verse_number": "४-५-७८", "content_sanskrit": "राजा भोजो विराट् सम्राट् क्षत्रियो भूपतिर्नृपः ।\nय एतैः स्तूयते शब्दैः कस्तं नार्चितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2031398, "chapter_id": 1682, "verse_number": "४-५-७९", "content_sanskrit": "तस्माद्भक्त्या च युक्तः सन्सत्यवादी जितेन्द्रियः ।\nमेधावी धृतिमान्प्राज्ञः संश्रयीत महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2031399, "chapter_id": 1682, "verse_number": "४-५-८०", "content_sanskrit": "कृतज्ञं प्राज्ञमक्षुद्रं दृढभक्तिं जितेन्द्रियम् ।\nवर्धमानं स्थितं स्थाने संश्रयीत महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2031400, "chapter_id": 1682, "verse_number": "४-५-८१", "content_sanskrit": "एष वः समुदाचारः समुद्दिष्टो यथाविधि ।\nयथार्थान्संप्रपत्स्यन्ते पार्थ राजोपजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2031401, "chapter_id": 1682, "verse_number": "४-५-८२", "content_sanskrit": "संवत्सरमिमं तावदेवंशीला बुभूषथः ।\nततः स्वविषयं प्राप्य यथाकामं चरिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2031402, "chapter_id": 1682, "verse_number": "४-५-८३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2031403, "chapter_id": 1682, "verse_number": "४-५-८३", "content_sanskrit": "तं तथेत्यब्रुवन्पार्थाः पितृकल्पं यशस्विनम्।\nप्रहृष्टाश्चाभिवाद्यैनमुपातिष्ठन्परंतपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2031404, "chapter_id": 1682, "verse_number": "४-५-८४", "content_sanskrit": "तेषां प्रतिष्ठमानानां मन्त्रांश्च ब्राह्मणोऽजपत्।\nभवाय राज्यलाभाय वीर्याय विजयाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2031405, "chapter_id": 1682, "verse_number": "४-५-८४", "content_sanskrit": "ततोऽब्रवीदसौ विप्रो वाचमाशीः प्रयुज्य च।\nस्वद्रव्यप्रतिलाभाय शत्रूणां मर्दनाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2031406, "chapter_id": 1682, "verse_number": "४-५-८५", "content_sanskrit": "स्वस्ति वोस्तु शिवः पन्था द्रक्ष्यामि पुनरागतान्।\nइत्युक्ता हृष्टमनसो गुरुणा तेन धीमता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2031407, "chapter_id": 1682, "verse_number": "४-५-८६", "content_sanskrit": "युधिष्ठिरमुखाः सर्वे गन्तुं समुपचक्रमुः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2031408, "chapter_id": 1682, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि पाण्डवप्रवेशपर्वणि पञ्चमोऽध्यायः ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]