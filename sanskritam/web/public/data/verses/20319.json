[{"id": 7000319000, "chapter_id": 20319, "verse_number": "१-७३-१", "content_sanskrit": "व्यास उवाच ।\nततो वृत्रो महातेजा दैत्यानां प्रवरो युधि ।\nदिग्गजाढ्यं गजारूढः प्राद्रवद्बलसूदनम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000319001, "chapter_id": 20319, "verse_number": "१-७३-२", "content_sanskrit": "आगच्छंतं ततो वृत्रं शरैः कालानलप्रभैः ।\nविव्याध सर्वगात्रेषु द्विरदस्थो महाहवे॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000319002, "chapter_id": 20319, "verse_number": "१-७३-३", "content_sanskrit": "ततो वृत्रस्तु शीर्षं च जिष्णोरेव पतत्रिणा ।\nविव्याध सहसा तेन स चचाल महाबलः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000319003, "chapter_id": 20319, "verse_number": "१-७३-४", "content_sanskrit": "आत्मानं च समाश्वास्य धनुरुद्यम्य वीर्यवान् ।\nववर्ष शरवर्षेण तस्य दैत्यस्य विग्रहे॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000319004, "chapter_id": 20319, "verse_number": "१-७३-५", "content_sanskrit": "शरांश्छित्वा बिभेदाशु शरैराशीविषोपमैः ।\nशतक्रतुं महावीर्यः सर्वदेवाधिपं युधि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000319005, "chapter_id": 20319, "verse_number": "१-७३-६", "content_sanskrit": "ततः शरसहस्रैस्तु दैत्यं विव्याध देवराट् ।\nपरस्परं शरा यांति यथा सप्ताश्व रश्मयः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000319006, "chapter_id": 20319, "verse_number": "१-७३-७", "content_sanskrit": "एवं शरसहस्रैस्तु बिभिदाते परस्परम् ।\nमनोजवसमाः शीघ्रा गाढाः शिखरिणो यथा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000319007, "chapter_id": 20319, "verse_number": "१-७३-८", "content_sanskrit": "बडवानलसंस्पर्शाः खगा वज्रारभेदकाः ।\nतयोर्धनुष्मतोर्युद्धे शरास्तुल्यगुणान्विताः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000319008, "chapter_id": 20319, "verse_number": "१-७३-९", "content_sanskrit": "एवं क्रमेण युद्धे च अहोरात्रमवर्तत ।\nमहेंद्रो द्विरदं तस्य शूलेनैव जघान ह॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000319009, "chapter_id": 20319, "verse_number": "१-७३-१०", "content_sanskrit": "स निपत्य महीपृष्ठे लाघवात्स्वरथं ययौ ।\nरथस्थस्तस्य देवस्य शक्त्या चैरावणं दृढम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000319010, "chapter_id": 20319, "verse_number": "१-७३-११", "content_sanskrit": "बिभेद लाघवेनाशु वज्रेणेव महागिरिं ।\nशुशुभे कंपमानस्तु सेंद्रः स च महागजः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000319011, "chapter_id": 20319, "verse_number": "१-७३-१२", "content_sanskrit": "ततः शक्तिं समादाय आविध्य मघवाऽसुरम् ।\nबिभेदोरसि दैत्यस्य स पपात रथोपरि॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000319012, "chapter_id": 20319, "verse_number": "१-७३-१३", "content_sanskrit": "क्षणात्संज्ञां समालंब्य स विनद्य पतत्त्रिणा ।\nबिभेद समरे शक्रं स ततः कश्मलं गतः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000319013, "chapter_id": 20319, "verse_number": "१-७३-१४", "content_sanskrit": "इंद्रः संज्ञां पुनः प्राप्य जघान विशिखैः शितैः ।\nशतकोटिसमैर्बाणैरर्दितो व्यथयान्वितः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000319014, "chapter_id": 20319, "verse_number": "१-७३-१५", "content_sanskrit": "ततो वृत्रो महाशूलं प्राक्षिपन्निर्जरेश्वरे ।\nशांभवास्त्रेण देवेशो वैष्णवास्त्रं मुमोच ह॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000319015, "chapter_id": 20319, "verse_number": "१-७३-१६", "content_sanskrit": "उभयोरंबरे चास्त्रे वह्निकूटसमप्रभे ।\nअन्योन्यं जघ्नतुस्तत्र स्फुलिगानि विमुंचती॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000319016, "chapter_id": 20319, "verse_number": "१-७३-१७", "content_sanskrit": "स्पर्शने च स्फुलिंगानामुभयोः सेनयोर्भटाः ।\nन शक्ताः संमुखे स्थातुं शलभा ज्वलने यथा॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000319017, "chapter_id": 20319, "verse_number": "१-७३-१८", "content_sanskrit": "दग्धाः पेतुः पृथिव्यां च दिशस्सर्वाः प्रदुद्रुवुः ।\nदेवदानवयोर्वीराः शून्यस्तत्राभवद्रणः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000319018, "chapter_id": 20319, "verse_number": "१-७३-१९", "content_sanskrit": "अस्त्रं निरस्तकं दृष्ट्वा स दैत्यः क्रोधमूर्च्छितः ।\nमायया शैलसंदोहमस्त्रं शक्रे मुमोच ह॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000319019, "chapter_id": 20319, "verse_number": "१-७३-२०", "content_sanskrit": "बाणौघैः शैलसंघातं प्रचिच्छेद रणे हरिः ।\nअघोरं प्रासृजद्दैत्यः पुरुहूते महाबले॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000319020, "chapter_id": 20319, "verse_number": "१-७३-२१", "content_sanskrit": "कोटिकोटिसहस्राणि जंतूनां प्रवराणि च ।\nसिंहशार्दूलभल्लूक वृक व्याघ्र महागजाः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000319021, "chapter_id": 20319, "verse_number": "१-७३-२२", "content_sanskrit": "दंदशूकादयः सत्वाः प्रधावंति सुरेश्वरं ।\nक्षुरप्रैरर्धचंद्रैश्च भल्लैः शिलीमुखैस्तथा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000319022, "chapter_id": 20319, "verse_number": "१-७३-२३", "content_sanskrit": "असंप्राप्तान्प्रचिच्छेद मघवा परवीरहा ।\nततो वृत्रो महाबाहुर्धनुरुद्यम्य वीर्यवान्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000319023, "chapter_id": 20319, "verse_number": "१-७३-२४", "content_sanskrit": "बिभेद शरसाहस्रैर्वज्रकल्पैः शतक्रतुं ।\nछित्वा क्षुरप्रैश्शक्रश्च धनुस्तस्य चकर्त च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000319024, "chapter_id": 20319, "verse_number": "१-७३-२५", "content_sanskrit": "सूतं चाश्वान्पृथिव्यां च पातयामास तत्क्षणात् ।\nसकंटकांगदां भीमां संपूज्यासुरसत्तमः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000319025, "chapter_id": 20319, "verse_number": "१-७३-२६", "content_sanskrit": "जघान पद्मिनः शीर्षे मोहाद्दंती क्षितिं ययौ ।\nसगदः सर्वदेवेशो धरणीं समुपस्थितः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000319026, "chapter_id": 20319, "verse_number": "१-७३-२७", "content_sanskrit": "ततस्तयोर्गदायुद्धमवर्तत मुहुर्मुहुः ।\nतयोः प्रहरतोः शब्दो गदापातोद्भवो ध्रुवं॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000319027, "chapter_id": 20319, "verse_number": "१-७३-२८", "content_sanskrit": "आवर्तं परिवर्तं च चक्रतुस्तौ पुनः पुनः ।\nअध ऊर्ध्वं प्रहारं च पार्श्वयोरतिभीषणं॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000319028, "chapter_id": 20319, "verse_number": "१-७३-२९", "content_sanskrit": "बभूवैवं तयोर्युद्धं लोकालोकभयंकरं ।\nदृष्ट्वा देवगणाः सिद्धा दानवा विस्मयं गताः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000319029, "chapter_id": 20319, "verse_number": "१-७३-३०", "content_sanskrit": "युद्ध्यमानौ तु तौ वीरौ मृत्युसंशयमागतौ ।\nदेवदानववीराश्च द्रष्टुं नैव तदीशिरे॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000319030, "chapter_id": 20319, "verse_number": "१-७३-३१", "content_sanskrit": "ईशब्रह्मादयः खे तु स्थिता द्रष्टुं तदद्भुतं ।\nतयोर्हुंकारशब्देन गदापातस्वनेन च॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000319031, "chapter_id": 20319, "verse_number": "१-७३-३२", "content_sanskrit": "ऊर्ध्वोर्ध्वमगमच्छब्दो ह्यशनेश्चोपजायते ।\nभग्ने गदे द्वयोरेव करः संपुटितस्तयोः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000319032, "chapter_id": 20319, "verse_number": "१-७३-३३", "content_sanskrit": "एवं चैवार्धयामेन तयोरस्त्रे निपेततुः ।\nएतस्मिंन्नन्तरे वीरौ खड्गचर्मधरौ तदा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000319033, "chapter_id": 20319, "verse_number": "१-७३-३४", "content_sanskrit": "प्रतियोद्धुं महाघोरमाहवे संप्रचेरतुः ।\nनिस्त्रिंशौ विद्युदुल्काभौ तयोर्गात्रे च चर्मणी॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000319034, "chapter_id": 20319, "verse_number": "१-७३-३५", "content_sanskrit": "दृश्येते सर्वलोकैश्च लाघवं विस्मयं गतैः ।\nचिच्छिदाते तयोरेव चर्मणी बहुवर्णके॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000319035, "chapter_id": 20319, "verse_number": "१-७३-३६", "content_sanskrit": "भीष्मकं बलयुद्धं च तयोरेवं प्रवर्तते ।\nमंडलं चक्रधन्वं च लाघवं च परिप्लुतं॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000319036, "chapter_id": 20319, "verse_number": "१-७३-३७", "content_sanskrit": "वृत्रवासवयोर्युद्धं वृत्रवासवयोरिव ।\nकेशान्वृत्रस्य उत्प्लुत्य संप्रधृत्यासिना द्रुतं॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000319037, "chapter_id": 20319, "verse_number": "१-७३-३८", "content_sanskrit": "शिरश्चिच्छेद सहसा मघवा रणमूर्धनि ।\nजयशब्दस्ततस्त्वासीद्देवानां च समंततः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000319038, "chapter_id": 20319, "verse_number": "१-७३-३९", "content_sanskrit": "प्रोत्फुल्लहृदया देवा मघवंतमपूजयन् ।\nदेवदुंदुभयो नेदुर्ननृतुश्चाप्सरोगणाः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000319039, "chapter_id": 20319, "verse_number": "१-७३-४०", "content_sanskrit": "गीतं गायंति गंधर्वा मुनयः स्तुतिपाठकाः ।\nभीताः पलायिताः सर्वे दैत्यास्त्यक्तायुधा दिशः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]