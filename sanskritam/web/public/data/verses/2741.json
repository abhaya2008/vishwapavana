[{"id": 2082105, "chapter_id": 2741, "verse_number": "१२-२४६-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082106, "chapter_id": 2741, "verse_number": "१२-२४६-१", "content_sanskrit": "पृच्छतस्तव सत्पुत्र यथावदिह तत्त्वतः।\nसाङ्ख्यन्यायेन संयुक्तं यदेतत्कीर्तितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082107, "chapter_id": 2741, "verse_number": "१२-२४६-२", "content_sanskrit": "योगकृत्यं तु ते कृत्स्नं वर्तयिष्यामि तच्छृणु।\nएकत्वं बुद्धिमनसोरिन्द्रियाणां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082108, "chapter_id": 2741, "verse_number": "१२-२४६-३", "content_sanskrit": "आत्मनोऽव्यथिनस्तात् ज्ञानमेतदनुत्तमम्।\nतदेतदुपशान्तेन दान्तेनाध्यात्मशीलिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082109, "chapter_id": 2741, "verse_number": "१२-२४६-४", "content_sanskrit": "आत्मारामेण बुद्धेन बोद्धव्यं शुचिकर्मणा।\nयोगदोषान्समुच्छिन्द्यात्पञ्च यान्कवयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082110, "chapter_id": 2741, "verse_number": "१२-२४६-५", "content_sanskrit": "कामं क्रोधं त्त लोभं च भयं स्वप्नं च पञ्चमम्।\nक्रोधं शमेन जयति कामं संकल्पवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082111, "chapter_id": 2741, "verse_number": "१२-२४६-६", "content_sanskrit": "सत्त्वसंसेवनाद्धीरो निद्रामुच्छेत्तुमर्हति।\nधृत्या शिश्नोदरं रक्षेत्पाणिपादं च चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082112, "chapter_id": 2741, "verse_number": "१२-२४६-७", "content_sanskrit": "चक्षुःश्रोत्रे च मनसा मनो वाचं च कर्मणा।\nअप्रमादाद्भयं जह्याल्लोभं प्राज्ञोपसेवनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082113, "chapter_id": 2741, "verse_number": "१२-२४६-८", "content_sanskrit": "एवमेतान्योगदोषाञ्चयेन्नित्यमतन्द्रितः।\nअग्नींश्च ब्राह्मणांश्चार्चेद्देवताः प्रणमेत च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082114, "chapter_id": 2741, "verse_number": "१२-२४६-९", "content_sanskrit": "वर्जयेदुशतीं वाचं हिंसायुक्तां मनोनुदाम्।\nब्रह्म तेजोमयं शुक्रं यस्य सर्वमिदं ततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082115, "chapter_id": 2741, "verse_number": "१२-२४६-१०", "content_sanskrit": "एतस्य सूत्रभूतस्य द्वयं स्थावरजङ्गमम्।\nध्यानमध्ययनं दानं सत्यं ह्रीरार्जवं क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082116, "chapter_id": 2741, "verse_number": "१२-२४६-११", "content_sanskrit": "शोचमाहारसंशुद्धिरिन्द्रियाणां च निग्रहः।\nएतैर्विवर्धते तेजः पाप्मानं चापकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082117, "chapter_id": 2741, "verse_number": "१२-२४६-१२", "content_sanskrit": "सिद्ध्यन्ति चास्य सर्वार्था विज्ञानं च प्रवर्धते।\nसमः सर्वेषु भूतेषु लब्धालब्धेन वर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082118, "chapter_id": 2741, "verse_number": "१२-२४६-१३", "content_sanskrit": "धूतपाप्मा तु तेजस्वी लघ्वाहारो जितेन्द्रियः।\nकामक्रोधौ वशे कृत्वा निनीषेद्ब्रह्मणः पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082119, "chapter_id": 2741, "verse_number": "१२-२४६-१४", "content_sanskrit": "मनसश्चेन्द्रियाणां च कृत्वैकाग्र्यं समाहितः।\nपूर्वरात्रेऽपरात्रे च धारयेन्मन आत्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082120, "chapter_id": 2741, "verse_number": "१२-२४६-१५", "content_sanskrit": "जन्तोः पञ्चेन्द्रियस्यास्य यदेकं छिद्रमिन्द्रियम्।\nततोऽस्य स्रवते प्रज्ञा दृतेः पादादिवोदकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082121, "chapter_id": 2741, "verse_number": "१२-२४६-१६", "content_sanskrit": "मनस्तु पूर्वमादद्यात्कुमीनमिव मत्स्यहा।\nततः श्रोत्रं ततश्चक्षुर्जिह्वा घ्राणं च योगवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082122, "chapter_id": 2741, "verse_number": "१२-२४६-१७", "content_sanskrit": "तत एतानि संयम्य मनसि स्थापयेद्यतिः।\nतथैवापो ह्यसंकल्पान्मनो ह्यात्मनि धारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082123, "chapter_id": 2741, "verse_number": "१२-२४६-१८", "content_sanskrit": "पञ्चेन्द्रियाणि संधाय मनसि स्थापयेद्यतिः।\nयदैतान्यवतिष्ठन्ति मनःषष्ठानि चात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082124, "chapter_id": 2741, "verse_number": "१२-२४६-१९", "content_sanskrit": "प्रसीदन्ति च संस्थाय तदा ब्रह्म प्रकाशते।\nविधूम इव सप्तार्चिरादित्य इव दीप्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082125, "chapter_id": 2741, "verse_number": "१२-२४६-२०", "content_sanskrit": "वैद्युतोऽग्निरिवाकाशे दृश्यतेऽऽत्मा तथाऽऽत्मनि।\nसर्वस्तत्र स सर्वत्र व्यापकत्वाच्च दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082126, "chapter_id": 2741, "verse_number": "१२-२४६-२१", "content_sanskrit": "तं पश्यन्ति महात्मानो ब्राह्मणा ये मनीषिणः।\nधृतिमन्तो महाप्राज्ञाः सर्वभूतहिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082127, "chapter_id": 2741, "verse_number": "१२-२४६-२२", "content_sanskrit": "एवं परिमितं कालमाचरन्संशितव्रतः।\nआसीनो हि रहस्येको गच्छेदक्षरसाम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082128, "chapter_id": 2741, "verse_number": "१२-२४६-२३", "content_sanskrit": "विमोहो भ्रम आवर्तो घ्राणं श्रवणदर्शने।\nअद्भुतानि रसस्पर्शे शीतोष्णे मारुताकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082129, "chapter_id": 2741, "verse_number": "१२-२४६-२४", "content_sanskrit": "प्रतिभामुपसर्गांश्चाप्युपसंगृह्य योगतः।\nतांस्तत्त्वविदनादृत्य आत्मन्येव निवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082130, "chapter_id": 2741, "verse_number": "१२-२४६-२५", "content_sanskrit": "कुर्यात्परिचयं योगे त्रैकाल्ये नियतो मुनिः।\nगिरिशृङ्गे तथा चैत्ये वृक्षाग्रेषु च योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082131, "chapter_id": 2741, "verse_number": "१२-२४६-२६", "content_sanskrit": "संनियम्येन्द्रियग्रामं कोष्ठे भाण्डमना इव।\nएकाग्रं चिन्तयेन्नित्यं योगान्नोद्वेजयेन्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082132, "chapter_id": 2741, "verse_number": "१२-२४६-२७", "content_sanskrit": "येनोपायेन शक्येत संनियन्तुं चलं मनः।\nतत्तद्युक्तो निषेवेत न चैव विचलेत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082133, "chapter_id": 2741, "verse_number": "१२-२४६-२८", "content_sanskrit": "शून्या गिरि---श्वैव देवतायतनानि च।\nशून्यागारा---काग्रो निवासार्थमुपक्रमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082134, "chapter_id": 2741, "verse_number": "१२-२४६-२९", "content_sanskrit": "नाभिष्व---वाचा कर्मणा मनसाऽपि वा।\nउपे-----रो लब्धालब्धे समो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082135, "chapter_id": 2741, "verse_number": "१२-२४६-३०", "content_sanskrit": "यश्चैन-----न्देत यश्चैनमभिवादयेत्।\nसमस्त-----भयोर्नाभिध्यायेच्छुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082136, "chapter_id": 2741, "verse_number": "१२-२४६-३१", "content_sanskrit": "न प्रहृ---भेषु नालाभेषु च चिन्तयेत्।\nसमः स-------षु सधर्मा मातरिश्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082137, "chapter_id": 2741, "verse_number": "१२-२४६-३२", "content_sanskrit": "एवं सर्वात्मनः साधोः सर्वत्र समदर्शिनः।\nषण्मासान्नित्ययुक्तस्य शब्दब्रह्मातिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082138, "chapter_id": 2741, "verse_number": "१२-२४६-३३", "content_sanskrit": "वेदनार्ताः प्रजा दृष्ट्वा समलोष्टाश्मकाञ्चनः।\nएतस्मिन्निरतो मार्गे विरमेन्न च मोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082139, "chapter_id": 2741, "verse_number": "१२-२४६-३४", "content_sanskrit": "अपि वर्णावकृष्टस्तु नारी वा धर्मकाङ्क्षिणी।\nतावप्येतेन मार्गेण गच्छेतां परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082140, "chapter_id": 2741, "verse_number": "१२-२४६-३५", "content_sanskrit": "अजं पुराणमजरं सनातनं\nयदिन्द्रियैरुपलभेत निश्चलैः।\nअणोरणीयो महतो महत्तरं\nतदात्मना पश्यति युक्तमात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082141, "chapter_id": 2741, "verse_number": "१२-२४६-३६", "content_sanskrit": "इदं महर्षेर्वचनं महात्मनो\nयथावदुक्तं मनसाऽनुदृश्य च।\nअवेक्ष्य चेमां परमेष्ठिसाम्यतां\nप्रयान्ति यां भूतगतिं मनीषिणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082142, "chapter_id": 2741, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षट्चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]