[{"id": 900001652, "chapter_id": 8245, "verse_number": "2.1", "content_sanskrit": "दृप्तबालाकिर्हानूचानो गार्ग्य आस स होवाचाजातशत्रुं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001653, "chapter_id": 8245, "verse_number": "2.2", "content_sanskrit": "यो ह वै शिशुं साधानं सप्रत्याधानं सस्थूणं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001654, "chapter_id": 8245, "verse_number": "2.3", "content_sanskrit": "द्वे वाव ब्रह्मणो रूपे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001655, "chapter_id": 8245, "verse_number": "2.4", "content_sanskrit": "मैत्रेयीति होवाच याज्ञवल्क्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001656, "chapter_id": 8245, "verse_number": "2.5", "content_sanskrit": "इयं पृथिवी सर्वेषां भूतानां मध्वस्यै पृथिव्यै सर्वाणि भूतानि मधु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001657, "chapter_id": 8245, "verse_number": "2.6", "content_sanskrit": "अथ वंशः पौतिमाष्यो गौपवनात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]