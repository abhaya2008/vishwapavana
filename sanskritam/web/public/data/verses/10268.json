[{"id": 6000268000, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "अथ द्विसप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000268001, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.001.m4a", "display_order": 2}, {"id": 6000268002, "chapter_id": 10268, "verse_number": "१०-७२-१", "content_sanskrit": "श्रुत्वा पृथा सुबलपुत्र्यथ याज्ञसेनी माधव्य इत्थमनु याः परमप्रतीताः।\nकृष्णेऽखिलात्मनि हरौ प्रणयानुबन्धं सर्वा विसिस्म्युरलमश्रुकलाकुलाक्ष्यः॥ १०/७२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.002.m4a", "display_order": 3, "topics": [{"text": "वसिष्ठगालवादिमुनयः समन्तपञ्चके कृष्णमुपाजग्मुः", "range": "१–८"}]}, {"id": 6000268003, "chapter_id": 10268, "verse_number": "१०-७२-२", "content_sanskrit": "इति सम्भाष्यमाणासु स्‍त्रीभिः स्‍त्रीषु नृभिर्नृषु।\nआययुर्मुनयस्तत्र कृष्णरामदिदृक्षया॥ १०/७२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.003.m4a", "display_order": 4}, {"id": 6000268004, "chapter_id": 10268, "verse_number": "१०-७२-३", "content_sanskrit": "द्वैपायनो नारदश्च च्यवनो देवलोऽसितः।\nविश्वामित्रः शतानन्दो भरद्वाजोऽथ गौतमः॥ १०/७२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.004.m4a", "display_order": 5}, {"id": 6000268005, "chapter_id": 10268, "verse_number": "१०-७२-४", "content_sanskrit": "रामः सशिष्यो भगवान् वसिष्ठो गालवो भृगुः।\nपुलस्त्यः काश्यपोऽत्रिश्च मार्कण्डेयो बृहस्पतिः॥ १०/७२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.005.m4a", "display_order": 6}, {"id": 6000268006, "chapter_id": 10268, "verse_number": "१०-७२-५", "content_sanskrit": "द्वितस्‍त्रितश्चैकतश्च ब्रह्मपुत्रस्तथाऽङ्गिराः।\nअगस्त्यो याज्ञवल्क्यश्च वामदेवादयोऽपरे॥ १०/७२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.006.m4a", "display_order": 7}, {"id": 6000268007, "chapter_id": 10268, "verse_number": "१०-७२-६", "content_sanskrit": "तान् दृष्ट्वा सहसोत्थाय प्रागासीना नृपादयः।\nपाण्डवाः कृष्णरामोै च प्रणेमुर्लोकवन्दितान्॥ १०/७२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.007.m4a", "display_order": 8}, {"id": 6000268008, "chapter_id": 10268, "verse_number": "१०-७२-७", "content_sanskrit": "तानानर्चुर्यथा सर्वे सहरामोऽच्युतोऽर्चयत्।\nस्वागतासनपाद्यार्घ्यमाल्यधूपानुलेपनैः॥ १०/७२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.008.m4a", "display_order": 9}, {"id": 6000268009, "chapter_id": 10268, "verse_number": "१०-७२-८", "content_sanskrit": "उवाच सुखमासीनान् भगवान् धर्मगुप्तनुः।\nसदसस्तस्य महतो यतवाचोऽनुशृण्वतः॥ १०/७२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.009.m4a", "display_order": 10}, {"id": 6000268010, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.010.m4a", "display_order": 11}, {"id": 6000268011, "chapter_id": 10268, "verse_number": "१०-७२-९", "content_sanskrit": "अहो वयं जन्मभृतो लब्धं कार्त्स्न्येन तत्फलम्।\nदेवानामपि दुष्प्राप्यं यद् योगेश्वरदर्शनम्॥ १०/७२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.011.m4a", "display_order": 12, "topics": [{"text": "कृष्णेयोगेश्वरदर्शनमहिमावर्णनम्", "range": "९–१३"}]}, {"id": 6000268012, "chapter_id": 10268, "verse_number": "१०-७२-१०", "content_sanskrit": "किं स्वल्पतपसां नॄॄणामर्चायां देवचक्षुषाम्।\nदर्शनस्पर्शनप्रश्नप्रह्वपादार्चनादिकम्॥ १०/७२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.012.m4a", "display_order": 13}, {"id": 6000268013, "chapter_id": 10268, "verse_number": "१०-७२-११", "content_sanskrit": "न ह्यम्मयानि तीर्थानि न देवा मृच्छिलामयाः।\nते पुनन्त्युरुकालेन दर्शनादेव साधवः॥ १०/७२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.013.m4a", "display_order": 14}, {"id": 6000268014, "chapter_id": 10268, "verse_number": "१०-७२-१२", "content_sanskrit": "नाग्निर्न सूर्यो न च चन्द्रतारकं न भूर्जलं खं श्वसनोऽथ वाङ्मनः।\nउपासिता भेदकृतो हरन्त्यघं विपश्चितो घ्नन्ति मुहूर्तसेवया॥ १०/७२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.014.m4a", "display_order": 15}, {"id": 6000268015, "chapter_id": 10268, "verse_number": "१०-७२-१३", "content_sanskrit": "यस्यात्मबुद्धिः कुणपे त्रिधातुके, स्वधीः कलत्रादिषु भौम इज्यधीः।\nयत्तीर्थबुद्धिश्च जले, न कर्हिचित् जनेष्वभिज्ञेषु, स एव गोखरः॥ १०/७२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.015.m4a", "display_order": 16}, {"id": 6000268016, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.016.m4a", "display_order": 17}, {"id": 6000268017, "chapter_id": 10268, "verse_number": "१०-७२-१४", "content_sanskrit": "निशम्येत्थं भगवतः कृष्णस्याकुण्ठमेधसः।\nवचो दुरन्वयं विप्रास्तूष्णीमासन् भ्रमद्धियः॥ १०/७२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.017.m4a", "display_order": 18}, {"id": 6000268018, "chapter_id": 10268, "verse_number": "१०-७२-१५", "content_sanskrit": "चिरं विमृश्य मुनय ईश्वरस्येशितव्यताम्।\nजनसङ्ग्रह इत्यूचुः स्मयन्तस्तं जगद्गुरुम्॥ १०/७२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.018.m4a", "display_order": 19}, {"id": 6000268019, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "ऋषय उचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.019.m4a", "display_order": 20}, {"id": 6000268020, "chapter_id": 10268, "verse_number": "१०-७२-१६", "content_sanskrit": "यन्मायया तत्त्वविदुत्तमा वयं विमोहिता विश्वसृजामधीश्वर।\nयदीशितव्यायति गूढ ईहया अहो विचित्रं भगवद्विचेष्टितम्॥ १०/७२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.020.m4a", "display_order": 21, "topics": [{"text": "ऋषिभिः भगवन्मायाकथनम्", "range": "१६–२४"}]}, {"id": 6000268021, "chapter_id": 10268, "verse_number": "१०-७२-१७", "content_sanskrit": "अनीह एतद् बहुधैक आत्मना सृजत्यवत्यत्ति न बद्ध्यते यथा।\nभौमैर्हि भूमिर्बहुनामरूपिणी अहो विभूम्नश्चरितं विडम्बनम्॥ १०/७२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.021.m4a", "display_order": 22}, {"id": 6000268022, "chapter_id": 10268, "verse_number": "१०-७२-१८", "content_sanskrit": "अथापि काले स्वजनाभिगुप्त्यै बिभर्षि स त्वं खलनिग्रहाय।\nस्वलीलया वेदपथं सनातनं वर्णाश्रमात्मा पुरुषः परो भवान्॥ १०/७२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.022.m4a", "display_order": 23}, {"id": 6000268023, "chapter_id": 10268, "verse_number": "१०-७२-१९", "content_sanskrit": "ब्रह्म ते हृदयं शुक्लं तपःस्वाध्यायसंयमैः।\nयत्रोपलब्धं सुव्यक्तमव्यक्तं च ततः परम्॥ १०/७२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.023.m4a", "display_order": 24}, {"id": 6000268024, "chapter_id": 10268, "verse_number": "१०-७२-२०", "content_sanskrit": "तस्माद्ब्रह्मकुलं ब्रह्मन् शास्त्रयोनेस्तवात्मनः।\nसभाजयसि सद्धाम तद्ब्रह्मण्यगुणो भवान्॥ १०/७२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.024.m4a", "display_order": 25}, {"id": 6000268025, "chapter_id": 10268, "verse_number": "१०-७२-२१", "content_sanskrit": "अद्य नो जन्मसाफल्यं विद्यायास्तपसो दृशः।\nत्वया सङ्गम्य सङ्गत्या यत् त्वं नः श्रेयसां परः॥ १०/७२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.025.m4a", "display_order": 26}, {"id": 6000268026, "chapter_id": 10268, "verse_number": "१०-७२-२२", "content_sanskrit": "नमस्तस्मै भगवते कृष्णायाकुण्ठमेधसे।\nस्वयोगमायया च्छन्नमहिम्ने परमात्मने॥ १०/७२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.026.m4a", "display_order": 27}, {"id": 6000268027, "chapter_id": 10268, "verse_number": "१०-७२-२३", "content_sanskrit": "न यं विदन्त्यमी भूपा एकारामाश्च वृष्णयः।\nमायाजवनिकाच्छन्नमात्मानं कालमीश्वरम्॥ १०/७२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.027.m4a", "display_order": 28}, {"id": 6000268028, "chapter_id": 10268, "verse_number": "१०-७२-२४", "content_sanskrit": "तस्याद्य ते ददृशिमाङ्घ्रिमघौघमर्षतीर्थास्पदं हृदि धृतं सुविपक्‍वयोगैः।\nउत्सिक्तभक्त्युपहृताशयजीवकोशा आपुर्भवद्गतिमथानुगृहाण भक्तान्॥ १०/७२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.028.m4a", "display_order": 29}, {"id": 6000268029, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.029.m4a", "display_order": 30}, {"id": 6000268030, "chapter_id": 10268, "verse_number": "१०-७२-२५", "content_sanskrit": "इत्यनुज्ञाप्य दाशार्हं धृतराष्ट्रं युधिष्ठिरम्।\nराजर्षिवर्यांस्तान् गन्तुं मुनयो दधिरे मनः॥ १०/७२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.030.m4a", "display_order": 31}, {"id": 6000268031, "chapter_id": 10268, "verse_number": "१०-७२-२६", "content_sanskrit": "तद् वीक्ष्य ताननुव्रज्य वसुदेवो महायशाः।\nप्रणम्य चोपसङ्गृह्य बभाषेदं सुयन्त्रितः॥ १०/७२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.031.m4a", "display_order": 32}, {"id": 6000268032, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "वसुदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.032.m4a", "display_order": 33}, {"id": 6000268033, "chapter_id": 10268, "verse_number": "१०-७२-२७", "content_sanskrit": "नमो वः सर्वदेवेभ्यो ऋषयः श्रोतुमर्हथ।\nकर्मणा कर्मनिर्हारो यथा स्यान्नस्तदुच्यताम्॥ १०/७२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.033.m4a", "display_order": 34}, {"id": 6000268034, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.034.m4a", "display_order": 35}, {"id": 6000268035, "chapter_id": 10268, "verse_number": "१०-७२-२८", "content_sanskrit": "नातिचित्रमिदं विप्रा वसुदेवो बुभुत्सया।\nकृष्णं मत्वाऽर्भकं यन्नः पृच्छति श्रेय आत्मनः॥ १०/७२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.035.m4a", "display_order": 36, "topics": [{"text": "ऋषिभिः वसुदेवं प्रति कर्मनिर्हारोपायकथनम्", "range": "२८–३९"}]}, {"id": 6000268036, "chapter_id": 10268, "verse_number": "१०-७२-२९", "content_sanskrit": "सन्निकर्षो हि मर्त्यानामनादरणकारणम्।\nगाङ्गं हित्वा यथाऽन्योऽम्भस्तत्रत्यो याति शुद्धये॥ १०/७२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.036.m4a", "display_order": 37}, {"id": 6000268037, "chapter_id": 10268, "verse_number": "१०-७२-३०", "content_sanskrit": "यस्यानुभूतिः कालेन लयोत्पत्त्यादिनाऽस्य वै।\nस्वतोऽन्यस्माच्च गुणतो न कुतश्चन रिष्यति॥ १०/७२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.037.m4a", "display_order": 38}, {"id": 6000268038, "chapter_id": 10268, "verse_number": "१०-७२-३१", "content_sanskrit": "तं क्लेशकर्मपरिपाकगुणप्रवाहैरव्याहतानुभवमीश्वरमद्वितीयम्।\nप्राणादिभिः स्वविषयैरुपगूढमज्ञो मेने स सूर्यमिव मेघहिमोपरागैः॥ १०/७२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.038.m4a", "display_order": 39}, {"id": 6000268039, "chapter_id": 10268, "verse_number": "१०-७२-३२", "content_sanskrit": "अथोचुर्मुनयो राजन्नाभाष्यानकदुन्दुभिम्।\nसर्वेषां शृण्वतां राज्ञां तथैवाच्युतरामयोः॥ १०/७२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.039.m4a", "display_order": 40}, {"id": 6000268040, "chapter_id": 10268, "verse_number": "१०-७२-३३", "content_sanskrit": "कर्मणा कर्मनिर्हार एष साधुनिरूपितः।\nयच्छ्रद्धया यजेद् विष्णुं सर्वयज्ञेश्वरं मखैः॥ १०/७२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.040.m4a", "display_order": 41}, {"id": 6000268041, "chapter_id": 10268, "verse_number": "१०-७२-३४", "content_sanskrit": "चित्तस्योपशमो यो वै कविभिः शास्‍त्रचक्षुषा।\nदर्शितः सुगमो योगो धर्मश्चात्ममुदावहः॥ १०/७२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.041.m4a", "display_order": 42}, {"id": 6000268042, "chapter_id": 10268, "verse_number": "१०-७२-३५", "content_sanskrit": "अयं स्वस्त्ययनः पन्था द्विजातेर्गृहमेधिनः।\nयच्छ्रद्धयाऽऽप्तवित्तेन शुक्लेनेज्येत पूरुषः॥ १०/७२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.042.m4a", "display_order": 43}, {"id": 6000268043, "chapter_id": 10268, "verse_number": "१०-७२-३६", "content_sanskrit": "वित्तैषणां यज्ञदानैर्गृहैर्दारसुतैषणाम्। आत्मलोकैषणामेवं कालेन विसृजेद् बुधः।\nग्रामे त्यक्तैषणाः सर्वे ययुर्धीरास्तपोवनम्॥ १०/७२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.043.m4a", "display_order": 44}, {"id": 6000268044, "chapter_id": 10268, "verse_number": "१०-७२-३७", "content_sanskrit": "ऋणैस्‍त्रिभिर्द्विजो जातो देवर्षिपितृणां प्रभो।\nयज्ञाध्ययनपुत्रैस्ताननिस्तीर्य त्यजन् पतेत्॥ १०/७२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.044.m4a", "display_order": 45}, {"id": 6000268045, "chapter_id": 10268, "verse_number": "१०-७२-३८", "content_sanskrit": "ब्रह्मचर्यसुताभ्यां वै ऋषिपित्रोर्महामते।\nयज्ञैर्देवर्णमुन्मुच्य निर्ऋणोऽशरणो भवेत्॥ १०/७२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.045.m4a", "display_order": 46}, {"id": 6000268046, "chapter_id": 10268, "verse_number": "१०-७२-३९", "content_sanskrit": "वसुदेव भवान् नूनं भक्त्या परमया हरिम्।\nजगतामीश्वरं भेजे स यद् वां पुत्रतां गतः॥ १०/७२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_072/BhP_10.072.046.m4a", "display_order": 47}, {"id": 6000268047, "chapter_id": 10268, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे द्विसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]