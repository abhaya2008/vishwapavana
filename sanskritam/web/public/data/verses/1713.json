[{"id": 2033059, "chapter_id": 1713, "verse_number": "४-३६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033060, "chapter_id": 1713, "verse_number": "४-३६-१", "content_sanskrit": "ततो विराटः कौन्तेयानतिमानुषविक्रमान्।\nअर्चयामास वित्तेन मानेन च महारथान्।\nवचसा चैव सान्त्वेन स्नेहेन च मुदाऽन्वितः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033061, "chapter_id": 1713, "verse_number": "४-३६-२x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033062, "chapter_id": 1713, "verse_number": "४-३६-२", "content_sanskrit": "यथैव मम रत्नानि युष्माकं तानि वै तथा।\nकार्यं कुरुत तैः सर्वैर्यथाकामं यथासुखम् ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033063, "chapter_id": 1713, "verse_number": "४-३६-३", "content_sanskrit": "ददाम्यलंकृताः कन्या वसूनि विविधानि च।\nमनसा चाप्यभिप्रेतं यद्वः शत्रुनिबर्हणाः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033064, "chapter_id": 1713, "verse_number": "४-३६-४", "content_sanskrit": "युष्माकं विक्रमादद्य मुक्तोऽहं स्वस्तिमानिह ।\nतस्माद्भवन्तो मत्स्यानामीश्वराः सर्व एव हि ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033065, "chapter_id": 1713, "verse_number": "४-३६-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033066, "chapter_id": 1713, "verse_number": "४-३६-५", "content_sanskrit": "तं तथावादिनं तत्र कौरवेयाः पृथक्पृथक्।\nऊचुः प्रहृष्टमनसो युधिष्ठिरपुरोगमाः ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033067, "chapter_id": 1713, "verse_number": "४-३६-६", "content_sanskrit": "प्रतिनन्दामहे वाचं सर्वथैव विशांपते।\nएतावताऽद्य प्रीताःस्मो यत्त्वं मुक्तोसि शत्रुभिः ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033068, "chapter_id": 1713, "verse_number": "४-३६-७", "content_sanskrit": "यत्त्वं मुक्तोसि शत्रुभ्यो ह्येतत्कार्यं हितं हि नः ।\nन किंचित्कार्यमस्माकं न धनं मृगयामहे ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033069, "chapter_id": 1713, "verse_number": "४-३६-८", "content_sanskrit": "अथाब्रवीत्प्रीतमना मात्स्यराजो युधिष्ठिरम्।\nनिर्भरः प्रीतिपूरेण हर्षगद्गदया गिरा ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033070, "chapter_id": 1713, "verse_number": "४-३६-९", "content_sanskrit": "पुनरेव महाबाहुर्विराटो राजसत्तमः ।\nएहि त्वामभिषेक्ष्यामि मत्स्यराजस्तु नो भवान् ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033071, "chapter_id": 1713, "verse_number": "४-३६-१०", "content_sanskrit": "मनसा चाप्यभिप्रेतं यत्ते शत्रुनिबर्हण।\nतत्तेऽहं संप्रदास्यामि सर्वमर्हति नो भवान् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033072, "chapter_id": 1713, "verse_number": "४-३६-११", "content_sanskrit": "रत्नानि गाः सुवर्णं च मणिमुक्तमथापि वा।\nवैयाघ्रपद्य विप्रेन्द्र सर्वथैव नमोस्तु ते ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033073, "chapter_id": 1713, "verse_number": "४-३६-१२", "content_sanskrit": "त्वत्कृते ह्यद्य पश्यामि राज्यमात्मानमेव च।\nयतश्च जातः संरम्भः स च शत्रुर्वशं गतः ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033074, "chapter_id": 1713, "verse_number": "४-३६-१३", "content_sanskrit": "ततो युधिष्ठिरो मात्स्यं पुनरेवाब्रवीद्वचः।\nप्रतिनन्दामि ते वाचं मनोज्ञां मात्स्य भाषितां ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033075, "chapter_id": 1713, "verse_number": "४-३६-१४", "content_sanskrit": "आनृशंस्यपरो नित्यं सुमुखः सततं भवान् ।\nपुनरेव विराटश्च राजा कङ्कमभाषत ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033076, "chapter_id": 1713, "verse_number": "४-३६-१५", "content_sanskrit": "अहो शूद्रस्य कर्माणि वललस्य द्विजोत्तम ।\nसोहं शूद्रेण संग्रामे वललेनाभिरक्षितः ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033077, "chapter_id": 1713, "verse_number": "४-३६-१६", "content_sanskrit": "त्वत्कृते सर्वमेवैतदुपपन्नं ममानघ।\nवरं वृष्णीष्व भद्रं ते ब्रूहि किं करवाणि ते ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033078, "chapter_id": 1713, "verse_number": "४-३६-१७", "content_sanskrit": "ददामि ते महाप्रीत्या रत्नान्युच्चावचान्यहम्।\nशयनासनयानानि कन्याश्च समलंकुताः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033079, "chapter_id": 1713, "verse_number": "४-३६-१८", "content_sanskrit": "हस्त्यश्वरथसङ्घाश्च राष्ट्राणि विविधानि च।\nएतानि च मम प्रीत्या प्रतिगृह्ण ममान्तिके ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033080, "chapter_id": 1713, "verse_number": "४-३६-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033081, "chapter_id": 1713, "verse_number": "४-३६-१९", "content_sanskrit": "तं तथावादिनं तत्र कौरव्यः प्रत्यभाषत।\nएषैव तु मम प्रीतिर्यत्त्वं मुक्तोसि शत्रुभिः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033082, "chapter_id": 1713, "verse_number": "४-३६-२०", "content_sanskrit": "प्रतीतश्चेत्पुरं तुष्टः प्रविशाद्य परंतप।\nदारैः पुत्रैश्च संश्लिष्य सा हि प्रीतिर्ममातुला ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033083, "chapter_id": 1713, "verse_number": "४-३६-२१", "content_sanskrit": "सुशर्माणं तु राजेन्द्र सभृत्यबलवाहनम् ।\nविसर्जय नरश्रेष्ठं वरमेतदहं वृणे ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033084, "chapter_id": 1713, "verse_number": "४-३६-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033085, "chapter_id": 1713, "verse_number": "४-३६-२२", "content_sanskrit": "एवमुक्ते तु कङ्केन विराटो राजसत्तमः ।\nप्रत्युवाच ततः कङ्कं सुशर्मा यातु चेष्टतः ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033086, "chapter_id": 1713, "verse_number": "४-३६-२३x", "content_sanskrit": "कङ्ख उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033087, "chapter_id": 1713, "verse_number": "४-३६-२३", "content_sanskrit": "गच्छन्तु दूतास्त्वरिता नगरं तव पार्थिव।\nसुहृदां प्रियमाख्यातुं घोषयन्तु च ते जयम् ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033088, "chapter_id": 1713, "verse_number": "४-३६-२४", "content_sanskrit": "ततस्तद्वचनान्मात्स्यो दूतान्राजा समादिशत्।\nआचक्षध्वं पुरं सत्वा संग्रामे विजयं मम ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033089, "chapter_id": 1713, "verse_number": "४-३६-२५", "content_sanskrit": "कुमार्यः समलंकृत्य प्रयागच्छन्तु मे पुरात् ।\nवादित्राणि च सर्वाणि गणिकाश्च स्वलंकृताः ।\nप्रत्यायान्तु च मे शीघ्रं नागराः सर्व एव ते ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033090, "chapter_id": 1713, "verse_number": "४-३६-२६", "content_sanskrit": "एवमुक्तास्तथा दूता रात्रौ यात्वा तु केवलम् ।\nततोऽन्तरे चानुषिता दूताः शीघ्रानुयायिनः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033091, "chapter_id": 1713, "verse_number": "४-३६-२७", "content_sanskrit": "नगरं प्राविशंस्ते वै सूर्ये सम्यगथोदिते।\nविराटनगरं प्राप्य शीघ्रं नान्दीमघोषयन् ।\nपताकोच्छ्रयमाल्याढ्यं पुरमप्रतिमं यथा ॥ २७ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033092, "chapter_id": 1713, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि षट्त्रिंशोऽध्यायः ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]