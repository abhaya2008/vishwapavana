[{"id": 50012597, "chapter_id": 11495, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012598, "chapter_id": 11495, "verse_number": "2", "content_sanskrit": "यतश्चान्तर्हितोऽनन्तस्तस्यै कृत्वा दिशे नमः। विद्याधरश्चित्रकेतुश्चचार गगनेचरः॥ ६/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012599, "chapter_id": 11495, "verse_number": "3", "content_sanskrit": "स लक्षं वर्षलक्षाणामव्याहतबलेन्द्रियः। स्तूयमानो महायोगी मुनिभिः सिद्धचारणैः॥ ६/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012600, "chapter_id": 11495, "verse_number": "4", "content_sanskrit": "कुलाचलेन्द्रद्रोणीषु नानासङ्कल्पसिद्धिषु। रेमे विद्याधरस्त्रीभिर्गाययन् हरिमीश्वरम्॥ ६/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012601, "chapter_id": 11495, "verse_number": "5", "content_sanskrit": "एकदा स्वविमानेन विष्णुदत्तेन भास्वता। गिरीशं ददृशे गच्छन् परीतं सिद्धचारणैः॥ ६/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012602, "chapter_id": 11495, "verse_number": "6", "content_sanskrit": "आलिङ्ग्याङ्के कृतां देवीं बाहुना मुनिसंसदि। उवाच देव्यां शृण्वन्त्यां जहासोच्चैस्तदन्तिके॥ ६/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012603, "chapter_id": 11495, "verse_number": "7", "content_sanskrit": "चित्रकेतुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012604, "chapter_id": 11495, "verse_number": "8", "content_sanskrit": "एष लोकगुरुः साक्षाद् धर्मवक्ता शरीरिणाम्। आस्ते मुख्यसभायां वै मिथुनीभूय भार्यया॥ ६/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012605, "chapter_id": 11495, "verse_number": "9", "content_sanskrit": "जटाधरस्तीव्रतपा ब्रह्मवादी सतां पतिः। अङ्के कृत्य स्त्रियं ह्यास्ते गतह्वीः प्राकृतो यथा॥ ६/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012606, "chapter_id": 11495, "verse_number": "10", "content_sanskrit": "प्रायशः प्राकृताश्चापि स्त्रियं रहसि बिभ्रति। अयं महाव्रतधरो बिभर्ति सदसि स्त्रियम्॥ ६/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012607, "chapter_id": 11495, "verse_number": "11", "content_sanskrit": "भगवानपि तच्छ्रुत्वा प्रहस्यागाधधीर्नृप। तूष्णीं बभूव सदसि सभ्याश्च तमनुव्रताः॥ ६/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012608, "chapter_id": 11495, "verse_number": "12", "content_sanskrit": "इत्यतद्वीर्यविदुषि ब्रुवाणे बह्वशोभनम्। रुषाऽऽह देवी धृष्टाय निर्जितात्माभिमानिने॥ ६/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012609, "chapter_id": 11495, "verse_number": "13", "content_sanskrit": "पार्वत्युवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012610, "chapter_id": 11495, "verse_number": "14", "content_sanskrit": "अयं किमधुना लोके शास्ता दण्डधरः प्रभुः। अस्मद्विधानां दुष्टानां निर्लज्जानां निषेधकृत्॥ ६/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012611, "chapter_id": 11495, "verse_number": "15", "content_sanskrit": "न वेद धर्मं किल पदम्योनिर्न ब्रह्मपुत्रा भृगुनारदाद्याः। न वै कुमारः कपिलो मनुश्च ये नो निषेधन्त्यतिवर्तिनं हरम्॥ ६/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012612, "chapter_id": 11495, "verse_number": "16", "content_sanskrit": "एषामनुध्येयपदाब्जयुग्मं जगद्गुरुं मङ्गलमङ्गलं स्वयम्। यः क्षत्रबन्धुः परिभूय सूरीन् प्रशास्ति धृष्टस्तदयं हि दण्ड्यः॥ ६/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012613, "chapter_id": 11495, "verse_number": "17", "content_sanskrit": "नायमर्हति वैकुण्ठपादमूलोपसर्पणम्। सम्भावितात्मा निस्तब्धः साधुभिः पर्युपासितम्॥ ६/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012614, "chapter_id": 11495, "verse_number": "18", "content_sanskrit": "अतः पापीयसीं योनिमासुरीं याहि दुर्मते। यथेह भूयो महतां न कर्ताऽमुत्र किल्बिषम्॥ ६/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012615, "chapter_id": 11495, "verse_number": "19", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012616, "chapter_id": 11495, "verse_number": "20", "content_sanskrit": "एवं शप्तश्चित्रकेतुर्विमानादवरुह्य सः। प्रसादयामास सतीं मूर्ध्ना नम्रेण भारत॥ ६/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012617, "chapter_id": 11495, "verse_number": "21", "content_sanskrit": "चित्रकेतुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012618, "chapter_id": 11495, "verse_number": "22", "content_sanskrit": "प्रतिगृह्णामि ते शापमात्मनोऽञ्जलिनाऽम्बिके। देवैर्मर्त्याय यत् प्रोक्तं पूर्वदिष्टं हि तस्य तत्॥ ६/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012619, "chapter_id": 11495, "verse_number": "23", "content_sanskrit": "संसारचक्र एतस्मिन् जन्तुरज्ञानमोहितः। भ्राम्यन् सुखं च दुःखं च भुङ्क्ते सर्वत्र सर्वदा॥ ६/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012620, "chapter_id": 11495, "verse_number": "24", "content_sanskrit": "नैवात्मा न परश्चापि कर्ता स्यात् सुखदुःखयोः। कर्तारं मन्यतेऽत्राज्ञ आत्मानं परमेव च॥ ६/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012621, "chapter_id": 11495, "verse_number": "25", "content_sanskrit": "गुणप्रवाह एतस्मिन् कः शापः को न्वनुग्रहः। कः स्वर्गो नरकः को वा किं दुःखं सुखमेव च॥ ६/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012622, "chapter_id": 11495, "verse_number": "26", "content_sanskrit": "एकः सृजति भूतानि भगवानात्ममायया। एषां बन्धं च मोक्षं च सुखं दुःखं च निष्कळः॥ ६/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012623, "chapter_id": 11495, "verse_number": "27", "content_sanskrit": "न चास्य कश्चिद् दयितो न प्रतीपो न ज्ञातिबन्धुर्न परो न च स्वः। समस्य सर्वत्र निरञ्जनस्य कुतोऽनुरागः कुत एव रोषः॥ ६/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012624, "chapter_id": 11495, "verse_number": "28", "content_sanskrit": "तथाऽपि तच्छक्तिविसर्ग एषां सुखाय दुःखाय हिताहिताय। बन्धाय मोक्षाय च मृत्युजन्मनोः शरीरिणां संसृतये च कल्पते॥ ६/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012625, "chapter_id": 11495, "verse_number": "29", "content_sanskrit": "अथ प्रसादये न त्वां शापमोक्षाय भामिनि। यन्मन्यसे असाधूक्तं मम तत् क्षम्यतां सति॥ ६/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50012626, "chapter_id": 11495, "verse_number": "30", "content_sanskrit": "बादरायणिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50012627, "chapter_id": 11495, "verse_number": "31", "content_sanskrit": "इति प्रसाद्य गिरिशौ चित्रकेतुररिन्दम। जगाम स्वविमानेन पश्यतोः स्मयतोस्तयोः॥ ६/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50012628, "chapter_id": 11495, "verse_number": "32", "content_sanskrit": "ततस्तु भगवान् रुद्रो रुद्राणीमिदमब्रवीत्। देवर्षिदैत्यसिद्धानां पार्षदानां च शृण्वताम्॥ ६/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50012629, "chapter_id": 11495, "verse_number": "33", "content_sanskrit": "रुद्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50012630, "chapter_id": 11495, "verse_number": "34", "content_sanskrit": "दृष्टवत्यसि सुश्रोणि हरेरद्भुतकर्मणः। माहात्म्यं भृत्यभृत्यानां निःस्पृहाणां महात्मनाम्॥ ६/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50012631, "chapter_id": 11495, "verse_number": "35", "content_sanskrit": "नारायणपराः सर्वे न कुतश्चन बिभ्यति। स्वर्गापवर्गनरकेष्वपि तुल्यार्थदर्शिनः॥ ६/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50012632, "chapter_id": 11495, "verse_number": "36", "content_sanskrit": "देहिनां देहसंयोगाद् द्वन्द्वानीश्वरमायया। सुखं दुःखं मृतिर्जन्म शापोऽनुग्रह एव च॥ ६/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50012633, "chapter_id": 11495, "verse_number": "37", "content_sanskrit": "अविवेककृतः पुंसो ह्यर्थभेद इहात्मनि। गुणदोषविकल्पश्च भिदेव स्वप्नकल्पिता॥ ६/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50012634, "chapter_id": 11495, "verse_number": "38", "content_sanskrit": "वासुदेवे भगवति भक्तिमुद्वहतां नृणाम्। ज्ञानवैराग्यवीर्याणां न हि कश्चिद् व्यपाश्रयः॥ ६/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50012635, "chapter_id": 11495, "verse_number": "39", "content_sanskrit": "नाहं विरिञ्चो न कुमारनारदौ न ब्रह्मपुत्रा मुनयः सुरेशाः। विदाम यस्येहितमंशकांशका न तत्स्वरूपं पृथगीशमानिनः॥ ६/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50012636, "chapter_id": 11495, "verse_number": "40", "content_sanskrit": "न ह्यस्यातिप्रियः कश्चिन्नाप्रियः स्वः परोऽपि वा। आत्मत्वात् सर्वभूतानां सर्वभूतप्रियो हरिः॥ ६/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50012637, "chapter_id": 11495, "verse_number": "41", "content_sanskrit": "तस्य चायं महाभागश्चित्रकेतुः प्रियोऽनुगः। सर्वत्र समदृक् शान्तो ह्यहं चैवाच्युतप्रियः॥ ६/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50012638, "chapter_id": 11495, "verse_number": "42", "content_sanskrit": "तस्मान्न विस्मयः कार्यः पुरुषेषु महात्मसु। महापुरुषभक्तेषु शान्तेषु समदर्शिषु॥ ६/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50012639, "chapter_id": 11495, "verse_number": "43", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50012640, "chapter_id": 11495, "verse_number": "44", "content_sanskrit": "इति श्रुत्वा भगवतः शिवस्योमाऽभिभाषितम्। बभूव शान्तधी राजन् देवी विगतविस्मया॥ ६/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50012641, "chapter_id": 11495, "verse_number": "45", "content_sanskrit": "इति भागवतो देव्याः प्रतिशप्तुमलन्तमः। मूर्ध्ना सञ्जगृहे शापमेतावत् साधुलक्षणम्॥ ६/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50012642, "chapter_id": 11495, "verse_number": "46", "content_sanskrit": "जज्ञे त्वष्टुर्दक्षिणाग्नौ दानवीं योनिमाश्रितः। वृत्र इत्यभिविख्यातो ज्ञानविज्ञानसंयुतः॥ ६/१७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50012643, "chapter_id": 11495, "verse_number": "47", "content_sanskrit": "एतत् ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि। वृत्रस्यासुरजातेश्च कारणं भगवन्मतेः॥ ६/१७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50012644, "chapter_id": 11495, "verse_number": "48", "content_sanskrit": "इतिहासमिमं पुण्यं चित्रकेतोर्महात्मनः। माहात्म्यं विष्णुभक्तानां श्रुत्वा बन्धाद् विमुच्यते॥ ६/१७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50012645, "chapter_id": 11495, "verse_number": "49", "content_sanskrit": "य एतत् प्रातरुत्थाय श्रद्धया वाग्यतः पठेत्। इतिहासं हरिं स्मृत्वा स याति परमां गतिम्॥ ६/१७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50012646, "chapter_id": 11495, "verse_number": "50", "content_sanskrit": "इति श्रीमद्भागवते षष्ठस्कन्धे सप्तदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]