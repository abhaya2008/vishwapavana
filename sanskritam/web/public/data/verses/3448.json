[{"id": 2113865, "chapter_id": 3448, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113866, "chapter_id": 3448, "verse_number": "१", "content_sanskrit": "कृपस्यापि मम ब्रह्मन् सम्भवं वक्तुमर्हसि ।\nशरस्तम्बात् कथं जातः कथं चास्त्राण्यवाप्तवान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113867, "chapter_id": 3448, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113868, "chapter_id": 3448, "verse_number": "२", "content_sanskrit": "महर्षेर्गौतमस्यासीत् शरद्वान्नाम नामतः ।\nपुत्रः किल महाराज जातः सह शरैर्विभो\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113869, "chapter_id": 3448, "verse_number": "३", "content_sanskrit": "न तस्य वेदाध्ययने तथा बुद्धिरजायत ।\nयथाऽस्य बुद्धिरभवद् धनुर्वेदे परन्तप \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113870, "chapter_id": 3448, "verse_number": "४", "content_sanskrit": "अधिजग्मुर्यथा वेदान् तपसा ब्रह्मवादिनः ।\nतथा स तपसोपेतः सर्वाण्यस्त्राण्यवाप ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113871, "chapter_id": 3448, "verse_number": "५", "content_sanskrit": "धनुर्वेदपरत्वाच्च तपसा विपुलेन च ।\nभृशं सन्तापयामास देवराजं स गौतमः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113872, "chapter_id": 3448, "verse_number": "६", "content_sanskrit": "ततो जालवतीं नाम देवकन्यां सुरेश्वरः ।\nप्राहिणोत् तपसो विघ्नं कुरु तस्येति कौरव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113873, "chapter_id": 3448, "verse_number": "७", "content_sanskrit": "साऽभिगम्याऽऽश्रमं तस्य रमणीयं शरद्वतः ।\nधनुर्बाणधरं दृष्ट्वा लोभयामास गौतमम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113874, "chapter_id": 3448, "verse_number": "८", "content_sanskrit": "तामेकान्तचरां दृष्ट्वा गौतमोऽप्सरसं वने ।\nलोकेऽप्रतिमसंस्थानामुत्फुल्लनयनोऽभवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113875, "chapter_id": 3448, "verse_number": "९", "content_sanskrit": "धनुश्च हि शरास्तस्य कराभ्यां प्रापतन् भुवि ।\nवेपथुश्चास्य सहसा शरीरे समजायत \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113876, "chapter_id": 3448, "verse_number": "१०", "content_sanskrit": "स तु ज्ञानगरीयस्त्वात् तपसश्च समन्वयात् ।\nअवतस्थे महाप्रज्ञो धैर्येण परमेण ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113877, "chapter_id": 3448, "verse_number": "११", "content_sanskrit": "शस्तस्य सहसा राजन् विकारः समजायत ।\nतेन सुस्राव रेतोऽस्य स च तन्नावबुध्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113878, "chapter_id": 3448, "verse_number": "१२", "content_sanskrit": "तं विहायाश्रमं चापि तां चैवाप्सरसं मुनिः ।\nजगाम रेतस्तत् तस्य शरस्तम्बे पपात ह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113879, "chapter_id": 3448, "verse_number": "१३", "content_sanskrit": "शरस्तम्बे च पतितं द्विधा तदभवन्नृप ।\nतस्याथ मिथुनं जज्ञे गौतमस्य शरद्वतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113880, "chapter_id": 3448, "verse_number": "१४", "content_sanskrit": "महर्षेर्गौतमस्यास्य आश्रमस्य समीपतः ।\nमृगयां चरतो राज्ञः शन्तनोस्तु यदृच्छया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113881, "chapter_id": 3448, "verse_number": "१५", "content_sanskrit": "कश्चित्सेनाचरोऽरण्ये मिथुनं तदपश्यत ।\nधनुश्च सशरं दृष्ट्वा तथा कृष्णाजिनानि च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113882, "chapter_id": 3448, "verse_number": "१६", "content_sanskrit": "व्यवस्य ब्राह्मणापत्यं धनुर्वेदान्तगस्य च ।\nस राज्ञो दर्शयामास मिथुनं सशरं तदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113883, "chapter_id": 3448, "verse_number": "१७", "content_sanskrit": "स तदादाय मिथुनं राजा च कृपयाऽन्वितः ।\nआजगाम गृहानेव मम पुत्राविति ब्रुवन् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113884, "chapter_id": 3448, "verse_number": "१८", "content_sanskrit": "प्रीतियुक्तो नरश्रेष्ठो मिथुनं गौतमस्य तत् ।\nततः संवर्धयामास संस्कारैश्चाप्ययोजयत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113885, "chapter_id": 3448, "verse_number": "१९", "content_sanskrit": "कृपया यन्मया बालाविमौ संवर्धिताविति ।\nतस्मात्तयोर्नाम चक्रे तदेव स महीपतिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113886, "chapter_id": 3448, "verse_number": "२०", "content_sanskrit": "तस्मात् कृप इति ख्यातः कृपी कन्या च साऽभवत् ।\nपिताऽपि गौतमस्तत्र तपसा तावविन्दत \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113887, "chapter_id": 3448, "verse_number": "२१", "content_sanskrit": "आगम्य चास्मै गोत्रादि सर्वमाख्यातवांस्तदा ।\nगौतमोऽपि च तदा राजन् धनुर्वेदपरोऽभवत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113888, "chapter_id": 3448, "verse_number": "२२", "content_sanskrit": "चतुर्विधं धनुर्वेदमस्त्राणि विविधानि च ।\nनिखिलेनास्य तत् सर्वं गुह्यमाख्यातवान् पिता\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113889, "chapter_id": 3448, "verse_number": "२३", "content_sanskrit": "सोऽचिरेणैव कालेन परमाचार्यतां गतः ।\nकृपमाहूय गाङ्गेयः तव शिष्या इति ब्रुवन् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113890, "chapter_id": 3448, "verse_number": "२४", "content_sanskrit": "पौत्रान् परिसमादाय कृपमाराधयत् तदा ।\nततोऽधिजग्मुः सर्वे ते धनुर्वेदं महारथाः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113891, "chapter_id": 3448, "verse_number": "२५", "content_sanskrit": "धृतराष्ट्रात्मजाश्चैव पाण्डवाश्च महाबलाः ।\nवृष्णयश्च नृपाश्चान्ये नानादेशसमागताः ।\nकृपमाचार्यमासाद्य परमास्त्रज्ञतां गताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113892, "chapter_id": 3448, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113893, "chapter_id": 3448, "verse_number": "२६", "content_sanskrit": "विशेषार्थी ततो भीष्मः पौत्राणां हितकाम्यया ।\nइष्वस्त्रज्ञान् पर्यपृच्छदाचार्यान् वीर्यसङ्गतान् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113894, "chapter_id": 3448, "verse_number": "२७", "content_sanskrit": "नाल्पधीर्नामहाभागः तथाऽनानास्त्रकोविदः ।\nनादेवसत्वो विनयेत् कुरूनस्त्रे महाबलान् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113895, "chapter_id": 3448, "verse_number": "१२७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तविंशत्यधिकशततमोऽध्यायः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113896, "chapter_id": 3448, "verse_number": "७५", "content_sanskrit": "॥ इति सम्भवपर्वणि पञ्चसप्ततितमोऽध्यायः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113897, "chapter_id": 3448, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]