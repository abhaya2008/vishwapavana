[{"id": 2029400, "chapter_id": 1642, "verse_number": "३-२८०-०x", "content_sanskrit": "गार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029401, "chapter_id": 1642, "verse_number": "३-२८०-१", "content_sanskrit": "सखा दशरथस्यासीज्जटायुररुणात्मजः।\nगृध्रराजो महावीरः संपातिर्यस् सोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029402, "chapter_id": 1642, "verse_number": "३-२८०-२", "content_sanskrit": "स ददर्श तदा सीतां रावणाङ्कगतां स्नुषाम्।\nसक्रोधोऽभ्यद्रवत्पक्षी रावणं राक्षसेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029403, "chapter_id": 1642, "verse_number": "३-२८०-३", "content_sanskrit": "अथैनमब्रवीद्गृध्रो मुञ्चमुञ्चेति मैथिलीम्।\nध्रियमाणे मयि कथं हरिष्यसि निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029404, "chapter_id": 1642, "verse_number": "३-२८०-४", "content_sanskrit": "न हिमे मोक्ष्यसे जीवन्यदि नोत्सृजसे वधूम्।\nउक्त्वैवं राक्षसेन्द्रं तं चकर्त नखरैर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029405, "chapter_id": 1642, "verse_number": "३-२८०-५", "content_sanskrit": "पक्षतुण्डप्रहारैश्च शतशो जर्जरीकृतम्।\nचक्षार रुधिरं भूरि गिरिः प्रस्रवणैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029406, "chapter_id": 1642, "verse_number": "३-२८०-६", "content_sanskrit": "स वध्यमानो गृध्रेण रामप्रियहितैषिणा।\nखङ्गमादाय चिच्छेद भुजौ तस् पतत्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029407, "chapter_id": 1642, "verse_number": "३-२८०-७", "content_sanskrit": "निहत्य गृध्रराजं सभिन्नाभ्रशिखरोपमम्।\nऊर्ध्वमाचक्रमे सीतां गृहीत्वाऽङ्केन राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029408, "chapter_id": 1642, "verse_number": "३-२८०-८", "content_sanskrit": "यत्रयत्रतु वैदेही पश्यत्याश्रममण्डलम्।\nसरोवा सरितो वाऽपि तत्र मुञ्चति भूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029409, "chapter_id": 1642, "verse_number": "३-२८०-९", "content_sanskrit": "सा ददर्श गिरिप्रस्थे पञ्च वानरपुङ्गवान्।\nतत्र वासो महद्दिव्यमुत्ससर्ज मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029410, "chapter_id": 1642, "verse_number": "३-२८०-१०", "content_sanskrit": "तत्तेषां वानरेन्द्राणां पपात पवनोद्धतम्।\nमध्ये सुपीतं पञ्चानां विद्युन्मेघान्तरे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029411, "chapter_id": 1642, "verse_number": "३-२८०-११", "content_sanskrit": "अचिरेणातिचक्राम खेचरः खे चरन्निव।\nददर्शाथ पुरीं रम्यां बहुद्वारां मनोरमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029412, "chapter_id": 1642, "verse_number": "३-२८०-१२", "content_sanskrit": "प्राकारवप्रसंबाधां निर्मितां विश्वकर्मणा।\nप्रविवेशपुरीं लङ्कां ससीतो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029413, "chapter_id": 1642, "verse_number": "३-२८०-१३", "content_sanskrit": "एवं हृतायां वैदेह्यां रामो हत्वा महामृगम्।\nनिवृत्तो ददृशे दूराद्भ्रातरं लक्ष्मणं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029414, "chapter_id": 1642, "verse_number": "३-२८०-१४", "content_sanskrit": "कथमुत्सृज्य वैदेहीं वने राक्षससेविते।\nइति तं भ्रातरं दृष्ट्वा प्राप्तोऽसीति व्यगर्हयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029415, "chapter_id": 1642, "verse_number": "३-२८०-१५", "content_sanskrit": "मृगरूपधरेणाथ रक्षसासोपकर्षणम्।\nभ्रातुरागमनं चैवचिन्तयन्पर्यतप्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029416, "chapter_id": 1642, "verse_number": "३-२८०-१६", "content_sanskrit": "गर्हयन्नेव रामस्तु त्वरितस्तं समासदत्।\nअपि जीवति वैदेहीमिति पश्यामि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029417, "chapter_id": 1642, "verse_number": "३-२८०-१७", "content_sanskrit": "तस् तत्सर्वमाचख्यौ सीताया लक्ष्मणो वचः।\nयदुक्तवत्यसदृशं वैदेही पश्चिमं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029418, "chapter_id": 1642, "verse_number": "३-२८०-१८", "content_sanskrit": "दह्यमानेन तु हृदा रामोऽभ्यपतदाश्रमम्।\nस ददर्श रतदा गृध्रं निहतं पर्वतोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029419, "chapter_id": 1642, "verse_number": "३-२८०-१९", "content_sanskrit": "राक्षसं शङ्कमानस्तं विकृष्य बलवद्धनुः।\nअभ्यधावत काकुत्स्थस्ततस्तं सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029420, "chapter_id": 1642, "verse_number": "३-२८०-२०", "content_sanskrit": "स तावुवाच तेजस्वी सहितौ रामलक्ष्मणौ।\nगृध्रराजेस्मि भद्रंवां सखा दशरथस् वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029421, "chapter_id": 1642, "verse_number": "३-२८०-२१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा संगृह्य धनुषी शुभे।\nकोयं पितरमस्माकं नाम्नाऽऽहेत्यूचतुश्च तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029422, "chapter_id": 1642, "verse_number": "३-२८०-२२", "content_sanskrit": "ततो ददृशतुस्तौ तं छिननपक्षद्वयं खगम्।\nतयोः शशंस गृध्रस्तु सीतार्थे रावणाद्वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029423, "chapter_id": 1642, "verse_number": "३-२८०-२३", "content_sanskrit": "अपृच्छद्राघवो गृध्रं रावणः कां दिशं गतः।\nतस् गृध्रः शिरःकम्पैराचचक्षे ममार च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029424, "chapter_id": 1642, "verse_number": "३-२८०-२४", "content_sanskrit": "दक्षिणामिति काकुत्स्थो विदित्वाऽस्य तदिङ्गितम्।\nसंस्कारं लम्भयामास सखायं पूजयन्पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029425, "chapter_id": 1642, "verse_number": "३-२८०-२५", "content_sanskrit": "ततो दृष्ट्वाऽऽश्रमपदं व्यपविद्धबृसीकटम्।\nविध्वस्तकलशं शून्यं गोमायुशतसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029426, "chapter_id": 1642, "verse_number": "३-२८०-२६", "content_sanskrit": "दुःखशोकसमाविष्टौ वैदेहीहरणार्दितौ।\nजग्मतुर्दण्डकारण्यं दक्षिणेन परंतपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029427, "chapter_id": 1642, "verse_number": "३-२८०-२७", "content_sanskrit": "वने महति तस्मिंस्तु रामः सौमित्रिणा सह।\nददर्श मृगयूथनि द्रवमाणानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029428, "chapter_id": 1642, "verse_number": "३-२८०-२८", "content_sanskrit": "शब्दं च घोरं सत्वानां दावाग्नरिववर्धतः।\nअपश्येतां मुहूर्ताच्च कबन्धं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029429, "chapter_id": 1642, "verse_number": "३-२८०-२९", "content_sanskrit": "मेघपर्वतसंकाशं सालस्कन्धं महाभूजम्।\nउरोगतविशालाक्षं महोदरमहामुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029430, "chapter_id": 1642, "verse_number": "३-२८०-३०", "content_sanskrit": "यदृच्छयाथ तद्रक्षः करे जग्राह लक्ष्मणम्।\nविषादमगमत्सद्यः सौमित्रिरथ भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029431, "chapter_id": 1642, "verse_number": "३-२८०-३१", "content_sanskrit": "स राममभिसंप्रेक्ष्य कृष्यते येन तन्मुखम्।\nविषण्णश्चाब्रवीद्रामं पश्यावस्थामिमां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029432, "chapter_id": 1642, "verse_number": "३-२८०-३२", "content_sanskrit": "हरणं चैववैदेह्या मम चायमुपप्लवः।\nराज्यभ्रंशश्च भवतस्तातस्य मरणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029433, "chapter_id": 1642, "verse_number": "३-२८०-३३", "content_sanskrit": "नाहं त्वां मह वैदेह्या समेतं कोसलागतम्।\nद्रक्ष्यामि प्रथिते राज्येपितृपैतामहे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029434, "chapter_id": 1642, "verse_number": "३-२८०-३४", "content_sanskrit": "द्रक्ष्यन्त्यार्यस्य धन्या ये कुशलाजशमीदलैः।\nअभिषिक्तस् वदनं सोमं शान्तघनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029435, "chapter_id": 1642, "verse_number": "३-२८०-३५", "content_sanskrit": "एवं बहुविधं धीमान्विललाप स लक्ष्मणः।\nतमुवाचाथकाकुत्स्थः संभ्रमेष्वप्यसंभ्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029436, "chapter_id": 1642, "verse_number": "३-२८०-३६", "content_sanskrit": "मा विषीद नरव्याघ्र नैष कश्चिन्मयि स्थिते।\n`शक्तो धर्षयितुं वीर सुमित्रानन्दवर्धन।\nछिन्ध्यस्य दक्षिणं बाहुं छिन्नः सव्यो मया भुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029437, "chapter_id": 1642, "verse_number": "३-२८०-३७", "content_sanskrit": "इत्येवं वदता तस् भुजो रामेण पातितः।\nखङ्गेन भृशतीक्ष्णेन निकृत्तस्तिलकाण्डवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029438, "chapter_id": 1642, "verse_number": "३-२८०-३८", "content_sanskrit": "ततोऽस्य दक्षिणं बाहुं स्वङ्गेनाजघ्निवान्बली।\nसौमित्रिरपि संप्रेक्ष्यभ्रातरं राघवं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029439, "chapter_id": 1642, "verse_number": "३-२८०-३९", "content_sanskrit": "पुनर्जघान पार्श्वे वै तद्रक्षो लक्ष्मणो भृशम्।\nगतासुरपतद्भूमौ कबन्धः सुमहांस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029440, "chapter_id": 1642, "verse_number": "३-२८०-४०", "content_sanskrit": "तस्य देहाद्विनिःसृत्य पुरुषो दिव्यदर्शनः।\nददृशे दिवमास्थाय दिवि सूर्य इव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029441, "chapter_id": 1642, "verse_number": "३-२८०-४१", "content_sanskrit": "पप्रच्छ रामस्तं वाग्मी कस्त्वं प्रब्रूहि पृच्छतः।\nकामया किमिदं चित्रमाश्चर्यं प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029442, "chapter_id": 1642, "verse_number": "३-२८०-४२", "content_sanskrit": "तस्याचचक्षेगन्धर्वोविश्वावसुरहं नृप।\nप्राप्तो ब्राह्मणशपेन योनिं राक्षससेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029443, "chapter_id": 1642, "verse_number": "३-२८०-४३", "content_sanskrit": "रावणेन हृतासीता लङ्कायां संनिवेशिता।\nसुग्रीवमभिगच्छस्वस ते साह्यं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029444, "chapter_id": 1642, "verse_number": "३-२८०-४४", "content_sanskrit": "एषा पम्पा शिवजला हंसकारण्डवायुता।\nऋश्यमूकस्य शैलस्य संनिकर्षे तटाकिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029445, "chapter_id": 1642, "verse_number": "३-२८०-४५", "content_sanskrit": "वसते तत्रसुग्रीवश्चतुर्भिः सचिवैः सह।\nभ्राता बानरराजस् वालिनो हेममालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029446, "chapter_id": 1642, "verse_number": "३-२८०-४६", "content_sanskrit": "तेन त्वं सहसंगम्य दुःखमूलं निवेदय।\nसमानशीलो भवतः साहाय्यं स करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029447, "chapter_id": 1642, "verse_number": "३-२८०-४७", "content_sanskrit": "एतावच्छक्यमस्माभिर्वक्तुं द्रष्टासि जानकीम्।\nध्रुवं वानरराजस् विदितो रावणालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029448, "chapter_id": 1642, "verse_number": "३-२८०-४८", "content_sanskrit": "इत्युक्त्वाऽन्तर्हितो दिव्यः पुरुषः स महाप्रभः।\nविस्मयं जग्मतुश्चोभौ प्रवीरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2029449, "chapter_id": 1642, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि अशीत्यधिकद्विशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]