[{"id": 2130666, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130667, "chapter_id": 3819, "verse_number": "१", "content_sanskrit": "निहते राक्षसे तस्मिन् पुनर्नारायणाश्रमम् ।\nअभ्येत्य राजा कौन्तेयो निवासमकरोत् प्रभुः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130668, "chapter_id": 3819, "verse_number": "२", "content_sanskrit": "स समानीय तान् सर्वान् भ्रातॄनित्यब्रवीद् वचः ।\nद्रौपद्या सहितान् काले संस्मरन् भ्रातरं जयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130669, "chapter_id": 3819, "verse_number": "३", "content_sanskrit": "समाश्चतस्रोऽभिगताः शिवेन चरतां वने ।\nकृतोद्देशस्तु(शः स) बीभत्सुः पञ्चमीमभितः समाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130670, "chapter_id": 3819, "verse_number": "४", "content_sanskrit": "प्राप्य पर्वतराजानं श्वेतं शिखरिणां वरम् ।\nतत्रापि च कृतोद्देशः समागमदिदृक्षुभिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130671, "chapter_id": 3819, "verse_number": "५", "content_sanskrit": "कृतश्च समयस्तेन पार्थेनामिततेजसा ।\nपञ्चवर्षाणि वत्स्यामि विद्यार्थीति पुरा मयि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130672, "chapter_id": 3819, "verse_number": "६", "content_sanskrit": "त(अ)त्र गाण्डीवधन्वानमवाप्तास्त्रमरिन्दमम् ।\nदेवलोकादिमं लोकं द्रक्ष्यामः पुनरागतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130673, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130674, "chapter_id": 3819, "verse_number": "७", "content_sanskrit": "इत्युक्त्वा ब्राह्मणान् सर्वानामन्त्रयत पाण्डवः ।\nकारणं चैव तत् तेषामाचचक्षे तपस्विनाम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130675, "chapter_id": 3819, "verse_number": "८", "content_sanskrit": "तानुग्रतपसः प्रीतान् कृत्वा पार्थाः प्रदक्षिणम् ।\nब्राह्मणास्तेऽन्वमोदन्त शिवेन कुशलेन च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130676, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "ब्रह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130677, "chapter_id": 3819, "verse_number": "९", "content_sanskrit": "सुखोदर्कमिमं क्लेशमचिराद् भरतर्षभ ।\nक्षत्रधर्मेण धर्मज्ञ तीर्त्वा गां पालयिष्यसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130678, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130679, "chapter_id": 3819, "verse_number": "१०", "content_sanskrit": "तत् तु राजा वचस्तेषां प्रतिगृह्य तपस्विनाम् ।\nप्रतस्थे सह विप्रैस्तैर्भ्रातृभिश्च परन्तपः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130680, "chapter_id": 3819, "verse_number": "११", "content_sanskrit": "द्रौपद्या सहितः श्रीमान् हैडिम्बेयादिभिस्तदा ।\nराक्षसैरनुयातो वै लोमशेनाभिरक्षितः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130681, "chapter_id": 3819, "verse_number": "१२", "content_sanskrit": "क्वचित् पद्भ्यां ततोऽगच्छद् राक्षसैरुह्यते क्वचित् ।\nतत्र तत्र महातेजा भ्रातृभिः सह सुव्रतः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130682, "chapter_id": 3819, "verse_number": "१३", "content_sanskrit": "ततो युधिष्ठिरो राजा बहून् क्लेशान् विचिन्तयन् ।\nसिंहव्याघ्रगजाकीर्णामुदीचीं प्रययौ दिशम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130683, "chapter_id": 3819, "verse_number": "१४", "content_sanskrit": "अवेक्षमाणः कैलासं मैनाकं चैव पर्वतम् ।\nगन्धमादनपादांश्च श्वेतं चापि शिलोच्चयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130684, "chapter_id": 3819, "verse_number": "१५", "content_sanskrit": "उपर्युपरि शैलस्य बह्वीश्च सरितः शिवाः ।\nपृष्ठं हिमवतः पुण्यं ययौ सप्तदशेऽहनि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130685, "chapter_id": 3819, "verse_number": "१६", "content_sanskrit": "ददृशुः पाण्डवा राजन् गन्धमादनमन्तिकात् ।\nपृष्ठे हिमवतः पुण्ये नानाद्रुमलतावृते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130686, "chapter_id": 3819, "verse_number": "१७", "content_sanskrit": "सलिलावर्तसञ्जातैः पुष्पितैश्च महीरुहैः ।\nसमावृतं पुण्यतममाश्रमं वृषपर्वणः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130687, "chapter_id": 3819, "verse_number": "१८", "content_sanskrit": "तमुपागम्य राजर्षिं धर्मात्मानमरिन्दमाः ।\nपाण्डवा वृषपर्वाणमवन्दन्त गतक्लमाः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130688, "chapter_id": 3819, "verse_number": "१९", "content_sanskrit": "अभ्यनन्दत् स राजर्षिः पुत्रवद् भरतर्षभान् ।\nपूजिताश्चावसंस्तत्र सप्तरात्रमरिन्दमाः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130689, "chapter_id": 3819, "verse_number": "२०", "content_sanskrit": "अष्टमेऽहनि सम्प्राप्ते तमृषिं लोकविश्रुतम् ।\nआमन्त्र्य वृषपर्वाणं प्रस्थानं प्रत्यरोचयन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130690, "chapter_id": 3819, "verse_number": "२१", "content_sanskrit": "एकैकशश्च तान् विप्रान् निवेद्य वृषपर्वणि ।\nन्यासभूतान् यथाकालं बन्धूनिव सुसत्कृतान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130691, "chapter_id": 3819, "verse_number": "२२", "content_sanskrit": "पारिबर्हं च तं शेषं परिदाय महात्मने ।\nततस्ते यज्ञपात्राणि रत्नान्याभरणानि च ।\nन्यदधुः पाण्डवा राजन्नाश्रमे वृषपर्वणः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130692, "chapter_id": 3819, "verse_number": "२३", "content_sanskrit": "अतीतानागते विद्वान् कुशलः सर्वधर्मवित् ।\nअन्वशासत् स धर्मज्ञः पुत्रवद् भरतर्षभान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130693, "chapter_id": 3819, "verse_number": "२४", "content_sanskrit": "तेऽनुज्ञाता महात्मानः प्रययुर्दिशमुत्तराम् ।\nकृष्णया सहिता वीरा ब्राह्मणैश्च महात्मभिः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130694, "chapter_id": 3819, "verse_number": "२५", "content_sanskrit": "तान् प्रस्थितानभ्यगच्छद् वृषपर्वा महीपतिः ।\nउपन्यस्य महातेजा विप्रेभ्यः पाण्डवांस्तदा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130695, "chapter_id": 3819, "verse_number": "२६", "content_sanskrit": "अनुसंसार्य कौन्तेयानाशीर्भिरभिनन्द्य च ।\nवृषपर्वा निववृते पन्थानमुपदिश्य च \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130696, "chapter_id": 3819, "verse_number": "२७", "content_sanskrit": "नानामृगगणैर्जुष्टं कौन्तेयः सत्यविक्रमः ।\nपदातिर्भ्रातृभिः सार्धं प्रातिष्ठत युधिष्ठिरः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130697, "chapter_id": 3819, "verse_number": "२८", "content_sanskrit": "नानाद्रुमनिरोधेषु वसन्तः शैलसानुषु ।\nपर्वतं विविशुः श्वेतं चतुर्थेऽहनि पाण्डवाः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130698, "chapter_id": 3819, "verse_number": "२९", "content_sanskrit": "महाभ्रघनसङ्काशं सलिलोपहितं शुभम् ।\nमणिकाञ्चनरूप्यस्य शिलानां च समुच्चयम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130699, "chapter_id": 3819, "verse_number": "३०", "content_sanskrit": "रूपं हिमवतः प्रस्थं बहुकन्दरनिर्झरम् ।\nशिलाविभङ्गविकटं लतापादपसङ्कुलम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130700, "chapter_id": 3819, "verse_number": "३१", "content_sanskrit": "ते समासाद्य पन्थानं यथोक्तं वृषपर्वणा ।\nअनुसस्रुर्यथोद्देशं पश्यन्तो विविधान्नगान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130701, "chapter_id": 3819, "verse_number": "३२", "content_sanskrit": "उपर्युपरि शैलस्य गुहाः परमदुर्गमाः ।\nसुदुर्गमांस्ते सुबहून् सुखेनैवाभिचक्रमुः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130702, "chapter_id": 3819, "verse_number": "३३", "content_sanskrit": "धौम्यः कृष्णा च पार्थाश्च लोमशश्च महानृषिः ।\nअगच्छन् सहितास्तत्र न कश्चिदवहीयते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130703, "chapter_id": 3819, "verse_number": "३४", "content_sanskrit": "ते मृगद्विजसङ्घुष्टं नानाद्रुमलतायुतम् ।\nशाखामृगगणैश्चैव सेवितं सुमनोरमम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130704, "chapter_id": 3819, "verse_number": "३५", "content_sanskrit": "पुण्यं पद्मसरोयुक्तं सपल्वलमहावनम् ।\nउपतस्थुर्महाभागा माल्यवन्तं महागिरिम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130705, "chapter_id": 3819, "verse_number": "३६", "content_sanskrit": "ततः किम्पुरुषावासं सिद्धचारणसेवितम् ।\nददृशुर्हृष्टरोमाणः पर्वतं गन्धमादनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130706, "chapter_id": 3819, "verse_number": "३७", "content_sanskrit": "विद्याधरानुचरितं किन्नरीभिस्तथैव च ।\nगजसङ्घसमावासं सिंहव्याघ्रगणायुतम् ।\nशरभोन्नादसङ्घुष्टं नानामृगनिषेवितम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130707, "chapter_id": 3819, "verse_number": "३८", "content_sanskrit": "ते गन्धमादनवनं तन्नन्दनवनोपमम् ।\nमुदिताः पाण्डुतनया मनोहृदयनन्दनम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130708, "chapter_id": 3819, "verse_number": "३९", "content_sanskrit": "विविशुः क्रमशो वीराः शरण्यं शुभकाननम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130709, "chapter_id": 3819, "verse_number": "४०", "content_sanskrit": "द्रौपदीसहिता वीरास्तैश्च विप्रैर्महात्मभिः ।\nशृण्वन्तः प्रीतिजननान् वल्गून् मदकलान् शुभान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130710, "chapter_id": 3819, "verse_number": "४१", "content_sanskrit": "श्रोत्ररम्यान्सुमधुरान् शब्दान् खगमुखेरितान् ।\nसर्वर्तुफलभाराढ्यान् सर्वर्तुकुसुमोज्ज्वलान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130711, "chapter_id": 3819, "verse_number": "४२", "content_sanskrit": "पश्यन्तः पादपांश्चापि फलभारावनामितान् ।\nआम्रानाम्रातकान् भव्यान् नारिकेलान् सतिन्दुकान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130712, "chapter_id": 3819, "verse_number": "४३", "content_sanskrit": "मुञ्जातकांस्तथाञ्जीरान् दाडिमान् बीजपूरकान् ।\nपनसाँल्लकुचान् मोचान् खर्जूरानाम्लवेतसान्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130713, "chapter_id": 3819, "verse_number": "४४", "content_sanskrit": "पारावतांस्तथा क्षौद्रान् नीपांश्चापि मनोरमान् ।\nबिल्वान् कपित्थाञ्जम्बूंश्च काश्मरीर्बदरीस्तथा \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2130714, "chapter_id": 3819, "verse_number": "४५", "content_sanskrit": "प्लक्षानुदुम्बरवटानश्वत्थान् क्षीरिकांस्तथा ।\nभल्लातकानामलकीर्हरीतकबिभीतकान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2130715, "chapter_id": 3819, "verse_number": "४६", "content_sanskrit": "इङ्गुदान् करमर्दांश्च तिन्दुकांश्च महाफलान् ।\nएतानन्यांश्च विविधान् गन्धमादनसानुषु ।\nफलैरमृतकल्पैस्तानाचितान् स्वादुभिस्तरून्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2130716, "chapter_id": 3819, "verse_number": "४७", "content_sanskrit": "तथैव चम्पकाशोकान् केतकान् बकुलांस्तथा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2130717, "chapter_id": 3819, "verse_number": "४८", "content_sanskrit": "पुन्नागान् सप्तपर्णांश्च कर्णिकारान् सकेतकान् ।\nपाटलान् कुटजान् रम्यान् मन्दारेन्दीवरांस्तथा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2130718, "chapter_id": 3819, "verse_number": "४९", "content_sanskrit": "पारिजातान् कोविदारान् देवदारुद्रुमांस्तथा ।\nशालांस्तालांस्तमालांश्च पिप्पलान् हिङ्गुकांस्तथा ।\nशाल्मलीः किंशुकाशोकाञ्छिंशपाः सरलांस्तथा \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2130719, "chapter_id": 3819, "verse_number": "५०", "content_sanskrit": "चकोरैः शतपत्रैश्च भृङ्गराजैस्तथा शुकैः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2130720, "chapter_id": 3819, "verse_number": "५१", "content_sanskrit": "कोकिलैः कलविङ्कैश्च हारितैर्जीवजीविकैः ।\nप्रियकैश्चातकैश्चैव तथान्यैर्विविधैः खगैः।\nश्रोत्ररम्यं सुमधुरं कूजद्भिश्चाप्यधिष्ठितान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2130721, "chapter_id": 3819, "verse_number": "५२", "content_sanskrit": "सरांसि च मनोज्ञानि समन्ताज्जलचारिभिः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2130722, "chapter_id": 3819, "verse_number": "५३", "content_sanskrit": "कुमुदैः पुण्डरीकैश्च तथा कोकनदोत्पलैः ।\nकह्लारैः कमलैश्चैव आचितानि समन्ततः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2130723, "chapter_id": 3819, "verse_number": "५४", "content_sanskrit": "कादम्बैश्चक्रवाकैश्च कुररैर्जलकुक्कुटैः ।\nकारण्डवैः प्लवैर्हंसैर्बकैर्मद्गुभिरेव च \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2130724, "chapter_id": 3819, "verse_number": "५५", "content_sanskrit": "एतैश्चान्यैश्च कीर्णानि समन्ताज्जलचारिभिः ।\nहृष्टैस्तथा तामरसरसासवमदालसैः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2130725, "chapter_id": 3819, "verse_number": "५६", "content_sanskrit": "पद्मोदरच्युतरजःकिञ्जल्कारुणरञ्जितैः ।\nमञ्जुस्वरैर्मधुकरैर्विरुतान् कमलाकरान् ।\nअपश्यंस्ते नरव्याघ्रा गन्धमादनसानुषु\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2130726, "chapter_id": 3819, "verse_number": "५७", "content_sanskrit": "तथैव पद्मषण्डैश्च मण्डितांश्च समन्ततः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2130727, "chapter_id": 3819, "verse_number": "५८", "content_sanskrit": "शिखण्डिनीभिः सहिताँल्लतामण्डलकेषु च ।\nमेघतूर्यरवोद्दाममदनाकुलितान् भृशम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2130728, "chapter_id": 3819, "verse_number": "५९", "content_sanskrit": "कृत्वैव केकामधुरं सङ्गीतं मधुरस्वरम् ।\nचित्रान् कलापान् विस्तीर्य सविलासान् मदालसान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2130729, "chapter_id": 3819, "verse_number": "६०", "content_sanskrit": "मयूरान् ददृशुर्हृष्टान् नृत्यतो वनलालसान् ।\nकान्ताभिः सहितानन्यानपश्यन् रमतस्सुखम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2130730, "chapter_id": 3819, "verse_number": "६१", "content_sanskrit": "वल्लीलतासङ्कटेषु कुटजेषु स्थितांस्तथा ।\nकांश्चित् प्रियाभिः सहितान् रममाणान् कलापिनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2130731, "chapter_id": 3819, "verse_number": "६२", "content_sanskrit": "कलापरुचिराटोपनिचितान् मुकुटानिव ।\nविवरेषु तरूणां च रुचिरान् ददृशुश्च ते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2130732, "chapter_id": 3819, "verse_number": "६३", "content_sanskrit": "सिन्धुवारांस्तथोदारान् मन्मथस्येव तोमरान् ।\nसुवर्णवर्णकुसुमान् गिरीणां शिखरेषु च ।\nकर्णिकारान् विकसितान्कर्णपूरानिवोत्तमान्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2130733, "chapter_id": 3819, "verse_number": "६४", "content_sanskrit": "तथापश्यन् कुरबकान् वनराजिषु पुष्पितान् ।\nकामवश्यौत्सुक्यकरान् कामस्येव शरोत्करान्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2130734, "chapter_id": 3819, "verse_number": "६५", "content_sanskrit": "तथैव वनराजीनामुदारान् रचितानिव ।\nविराजमानांस्तेऽपश्यंस्तिलकांस्तिलकानिव \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2130735, "chapter_id": 3819, "verse_number": "६६", "content_sanskrit": "तथानङ्गशराकारान् सहकारान्मनोरमान् ।\nअपश्यन् भ्रमरारावान् मञ्जरीभिर्विराजितान्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2130736, "chapter_id": 3819, "verse_number": "६७", "content_sanskrit": "हिरण्यसदृशैः पुष्पैर्दावाग्निसदृशैरपि ।\nलोहितैरञ्जनाभैश्च वैदूर्यसदृशैरपि\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2130737, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "अतीव वृक्षा राजन्ते पुष्पिताः शैलसानुषु ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2130738, "chapter_id": 3819, "verse_number": "६८", "content_sanskrit": "तथा शालांस्तमालांश्च पाटलान् बकुलानपि ।\nमाला इव समासक्ताः शैलानां शिखरेषु च \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2130739, "chapter_id": 3819, "verse_number": "६९", "content_sanskrit": "एवं क्रमेण ते वीरा वीक्षमाणाः समन्ततः ।\nगजसङ्घसमाकीर्णं सिंहव्याघ्रसमाकुलम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2130740, "chapter_id": 3819, "verse_number": "७०", "content_sanskrit": "पीता भास्करवर्णाभा बभूवुर्वनराजयः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2130741, "chapter_id": 3819, "verse_number": "७१", "content_sanskrit": "नात्र कण्टकिनः केचिन्न च विद्यन्त्यपुष्पिताः ।\nस्निग्धपत्रफला वृक्षा गन्धमादनसानुषु\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2130742, "chapter_id": 3819, "verse_number": "७१", "content_sanskrit": "सर्वर्तुफलपुष्पाढ्या गन्धमादनसानुषु ।\nभ्रमरारावमधुरा नळिनीः फुल्लपङ्कजाः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2130743, "chapter_id": 3819, "verse_number": "७३", "content_sanskrit": "पश्यन्ती विविधान् वृक्षांस्तत्र कृष्णा मनोहरान् ।\nअन्तिकस्थमथ प्रीत्या भीमसेनमुवाच ह\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2130744, "chapter_id": 3819, "verse_number": "७४", "content_sanskrit": "विविशुः पाण्डवाः सर्वे विस्मयोत्फुल्ललोचनाः ।\nकमलोत्पलकह्लारपुण्डरीकसुगन्धिना ।\nसरांसि च मनोज्ञानि वृक्षांश्चातिमनोरमान् \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2130745, "chapter_id": 3819, "verse_number": "७५", "content_sanskrit": "सेव्यमाना वने तस्मिन् सुखस्पर्शेन वायुना ।\nततो युधिष्ठिरो भीममाहेदं प्रीतिमद् वचः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2130746, "chapter_id": 3819, "verse_number": "७६", "content_sanskrit": "विलोड्यमानाः पश्येमाः करिभिः सकरेणुभिः ।\nपश्येमां नळिनीं चान्यां कमलोत्पलमालिनीम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2130747, "chapter_id": 3819, "verse_number": "७७", "content_sanskrit": "स्रग्धरां विग्रहवतीं साक्षाच्छ्रियमिवापराम् ।\nनानाकुसुमगन्धाढ्यान् पश्येमाः काननोत्तमे ।\nउपगीयमाना भ्रमरै राजन्ते वनराजयः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2130748, "chapter_id": 3819, "verse_number": "७८", "content_sanskrit": "विमलस्फाटिकाभानि पाण्डरच्छदनैर्द्विजैः ।\nकलहंसैरुपेतानि सारसाभिरुतानि च \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2130749, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "सरांसि सरितः पार्थाः पश्यन्तः शैलसानुषु ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2130750, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "विविशुः क्रमशो वीरा अनन्यं शुभकाननम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2130751, "chapter_id": 3819, "verse_number": "७९", "content_sanskrit": "पद्मोत्पलविमिश्राणि सुखशीतजलानि च \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2130752, "chapter_id": 3819, "verse_number": "८०", "content_sanskrit": "गन्धवन्ति च माल्यानि रसवन्ति फलानि च ।\nअतीव वृक्षा राजन्ते पुष्पिताः शैलसानुषु\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2130753, "chapter_id": 3819, "verse_number": "८१", "content_sanskrit": "युधिष्ठिरस्तु तान् वृक्षान् पश्यमानो नगोत्तमे ।\nभीमसेनमिदं वाक्यमब्रवीन् मधुराक्षरम् \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2130754, "chapter_id": 3819, "verse_number": "८२", "content_sanskrit": "पश्य भीम शुभान् देशान् देवाक्रीडान् समन्ततः ।\nअमानुषगतिं प्राप्ताः संसिद्धाः स्म वृकोदर\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2130755, "chapter_id": 3819, "verse_number": "८३", "content_sanskrit": "लताभिः पुष्पिताग्राभिः पुष्पिताः पादपोत्तमाः ।\nसंश्लिष्टाः पार्थ शोभन्ते गन्धमादनसानुषु\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2130756, "chapter_id": 3819, "verse_number": "८४", "content_sanskrit": "शिखण्डिनीभिश्चरतां सहितानां शिखण्डिनाम् ।\nनदतां शृणु निर्घोषं भीम पर्वतसानुषु\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2130757, "chapter_id": 3819, "verse_number": "८५", "content_sanskrit": "चकोराः शतपत्राश्च मत्तकोकिलसारिकाः ।\nपत्रिणः पुष्पितानेतान् सम्पतन्ति महाद्रुमान्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2130758, "chapter_id": 3819, "verse_number": "८६", "content_sanskrit": "रक्तपीतारुणाः पार्थ पादपाग्रगताः खगाः ।\nपरस्परमुदीक्षन्ते बहवो जीवजीवकाः \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2130759, "chapter_id": 3819, "verse_number": "८७", "content_sanskrit": "हरितारुणवर्णानां शाद्वलानां समीपतः ।\nसारसाः प्रतिदृश्यन्ते शैलप्रस्रवणेष्वपि\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2130760, "chapter_id": 3819, "verse_number": "८८", "content_sanskrit": "वदन्ति मधुरा वाचः सर्वभूतमनोरमाः ।\nभृङ्गराजोपचक्राश्च लोहपृष्ठाः पतत्त्रिणः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2130761, "chapter_id": 3819, "verse_number": "८९", "content_sanskrit": "चतुर्विषाणाः पद्माभाः कुञ्जराः सकरेणवः ।\nएते वैदूर्यवर्णाभं क्षोभयन्ति महत्सरः \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2130762, "chapter_id": 3819, "verse_number": "९०", "content_sanskrit": "बहुतालसमुत्सेधाः शैलशृङ्गपरिच्युताः ।\nनानाप्रस्रवणेभ्यश्च वारिधाराः पतन्ति च \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2130763, "chapter_id": 3819, "verse_number": "९१", "content_sanskrit": "भास्कराभाः प्रभाभीमाः शारदाभ्रघनोपमाः ।\nशोभयन्ति महाशैलं नानारजतधातवः \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2130764, "chapter_id": 3819, "verse_number": "९२", "content_sanskrit": "क्वचिदञ्जनवर्णाभाः क्वचित्काञ्चनसन्निभाः ।\nधातवो हरितालस्य क्वचिद्धिङ्गुलकस्य च \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2130765, "chapter_id": 3819, "verse_number": "९३", "content_sanskrit": "मनःशिलागुहाश्चैव सन्ध्याभ्रनिकरोपमाः ।\nशशलोहितवर्णाभाः क्वचिद् गैरिकधातवः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2130766, "chapter_id": 3819, "verse_number": "९४", "content_sanskrit": "सितासिताभ्रप्रतिमा बालसूर्यसमप्रभाः ।\nएते बहुविधाः शैलं शोभयन्ति महाप्रभाः \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2130767, "chapter_id": 3819, "verse_number": "९५", "content_sanskrit": "गन्धर्वाः सह कान्ताभिर्यथोक्तं वृषपर्वणा ।\nदृश्यन्ते शैलशृङ्गेषु पार्थ किम्पुरुषैः सह \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2130768, "chapter_id": 3819, "verse_number": "९६", "content_sanskrit": "गीतानां समतालानां तथा साम्नां च निस्वनः ।\nश्रूयते बहुधा भीम सर्वभूतमनोहरः \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2130769, "chapter_id": 3819, "verse_number": "९७", "content_sanskrit": "महागङ्गामुदीक्षस्व पुण्यां देवनदीं शुभाम्।\nकलहंसगणैर्जुष्टामृषिकिन्नरसेविताम्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2130770, "chapter_id": 3819, "verse_number": "९८", "content_sanskrit": "धातुभिश्च सरिद्भिश्च किन्नरैर्मृगपक्षिभिः ।\nगन्धर्वैरप्सरोभिश्च काननैश्च मनोरमैः \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2130771, "chapter_id": 3819, "verse_number": "९९", "content_sanskrit": "व्यालैश्च विविधाकारैः शतशीर्षैः समन्ततः ।\nउपेतं पश्य कौन्तेय शैलराजमरिन्दम\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2130772, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2130773, "chapter_id": 3819, "verse_number": "१००", "content_sanskrit": "ते प्रीतमनसः शूराः प्राप्ता गतिमनुत्तमाम् ।\nनातृप्यन् पर्वतेन्द्रस्य दर्शनेन परन्तपाः \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2130774, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "द्रौपद्या सहिता वीरास्तैश्च विप्रैर्महात्मभिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2130775, "chapter_id": 3819, "verse_number": "१०१", "content_sanskrit": "उपेतमथ माल्यैश्च फलवद्भिश्च पादपैः ।\nआर्ष्टिषेणस्य राजर्षेराश्रमं ददृशुस्तदा\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2130776, "chapter_id": 3819, "verse_number": "१०२", "content_sanskrit": "ततस्ते तिग्मतपसं कृशं धमनिसन्ततम् ।\nपारगं सर्वधर्माणामार्ष्टिषेणमुपागमन्\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2130777, "chapter_id": 3819, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुःपञ्चाशदधिकशततमोऽध्यायः ॥१५४॥ यक्षयुद्धपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2130778, "chapter_id": 3819, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]