[{"id": 2131573, "chapter_id": 3842, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131574, "chapter_id": 3842, "verse_number": "१", "content_sanskrit": "ततो मामतिविश्वस्तं संरूढशरविक्षतम् ।\nदेवराजोऽनुगृह्येदं काले वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131575, "chapter_id": 3842, "verse_number": "२", "content_sanskrit": "दिव्यान्यस्त्राणि सर्वाणि त्वयि तिष्ठन्ति भारत ।\nन त्वाभिभवितुं शक्तो मानुषो भुवि कश्चन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131576, "chapter_id": 3842, "verse_number": "३", "content_sanskrit": "भीष्मो द्रोणः कृपः कर्णः शकुनिः सह राजभिः ।\nसङ्ग्रामस्थस्य ते पुत्र कलां नार्हन्ति षोडशीम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131577, "chapter_id": 3842, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131578, "chapter_id": 3842, "verse_number": "४", "content_sanskrit": "इदं च मे तनुत्राणं प्रायच्छन् मघवान् प्रभुः ।\nअभेद्यं कवचं दिव्यं स्रजं चैव हिरण्मयीम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131579, "chapter_id": 3842, "verse_number": "५", "content_sanskrit": "देवदत्तं च मे शङ्खं पुनः प्रादान्महारवम् ।\nदिव्यं चेदं किरीटं मे स्वयमिन्द्रो युयोज ह \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131580, "chapter_id": 3842, "verse_number": "६", "content_sanskrit": "ततो दिव्यानि वस्त्राणि दिव्यान्याभरणानि च ।\nप्रादाच्छक्रो ममैतानि रुचिराणि बृहन्ति च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131581, "chapter_id": 3842, "verse_number": "७", "content_sanskrit": "एवं सम्पूजितस्तत्र सुखमस्म्युषितो नृप ।\nइन्द्रस्य भवने पुण्ये गन्धर्वशिशुभिः सह ।\nततो मामब्रवीच्छक्रः प्रीतिमानमरैः सह \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131582, "chapter_id": 3842, "verse_number": "८", "content_sanskrit": "समयोऽर्जुन गन्तुं ते भ्रातरो हि स्मरन्ति ते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131583, "chapter_id": 3842, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131584, "chapter_id": 3842, "verse_number": "९", "content_sanskrit": "एवमिन्द्रस्य भवने पञ्च वर्षाणि भारत ।\nउषितानि मया राजन् स्मरता द्यूतजं कलिम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131585, "chapter_id": 3842, "verse_number": "१०", "content_sanskrit": "ततो भवन्तमद्राक्षं भ्रातृभिः परिवारितम् ।\nगन्धमादनपादस्य पर्वतस्यास्य मूर्धनि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131586, "chapter_id": 3842, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131587, "chapter_id": 3842, "verse_number": "११", "content_sanskrit": "दिष्ट्या धनञ्जयास्त्राणि त्वया प्राप्तानि भारत ।\nदिष्ट्या चाराधितो राजा देवानामीश्वरः प्रभुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131588, "chapter_id": 3842, "verse_number": "१२", "content_sanskrit": "दिष्ट्या च भगवान् स्थाणुर्देव्या सह परन्तप ।\nसाक्षाद् दृष्टः स्वयुद्धेन तोषितश्च त्वयाऽनघ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131589, "chapter_id": 3842, "verse_number": "१३", "content_sanskrit": "दिष्ट्या च लोकपालैस्त्वं समेतो भरतर्षभ ।\nदिष्ट्या वर्धामहे पार्थ दिष्ट्याऽसि पुनरागतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131590, "chapter_id": 3842, "verse_number": "१४", "content_sanskrit": "अद्य कृत्स्नां महीं देवीं विजितां पुरमालिनीम् ।\nमन्ये च धृतराष्ट्रस्य पुत्रानपि वशीकृतान् ।\nपश्यामि भूमिं कौन्तेय त्वया मे प्रतिपादिताम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131591, "chapter_id": 3842, "verse_number": "१५", "content_sanskrit": "इच्छामि तानि चास्त्राणि द्रष्टुं दिव्यानि भारत ।\nयैस्तथा वीर्यवन्तस्ते निवातकवचा हताः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131592, "chapter_id": 3842, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131593, "chapter_id": 3842, "verse_number": "१६", "content_sanskrit": "श्वः प्रभाते भवान् द्रष्टा दिव्यान्यस्त्राणि सर्वशः ।\nनिवातकवचा घोरा यैर्मया विनिपातिताः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131594, "chapter_id": 3842, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131595, "chapter_id": 3842, "verse_number": "१७", "content_sanskrit": "एवमागमनं तत्र कथयित्वा धनञ्जयः ।\nभ्रातृभिः सहितः सर्वै रजनीं तामुवास ह \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131596, "chapter_id": 3842, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोनसप्तत्यधिकशततमोऽध्यायः ॥१६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131597, "chapter_id": 3842, "verse_number": "", "content_sanskrit": "यक्षयुद्धपर्वणि षोडशोऽध्यायः ॥१६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]