[{"id": 2149678, "chapter_id": 4242, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149679, "chapter_id": 4242, "verse_number": "१", "content_sanskrit": "ततोऽहं समनुज्ञाप्य काळीं सत्यवतीं तदा ।\nमन्त्रिणश्चर्त्विजश्चैव तथैव च पुरोहितान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149680, "chapter_id": 4242, "verse_number": "२", "content_sanskrit": "समनुज्ञासिषं कन्यामम्बां ज्येष्ठां नराधिप\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149681, "chapter_id": 4242, "verse_number": "३", "content_sanskrit": "अनुज्ञाता ययौ सा तु कन्या साल्वपतेः पुरम् ।\nवृद्धैर्द्विजातिभिर्गुप्ता धात्र्या चानुगता तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149682, "chapter_id": 4242, "verse_number": "४", "content_sanskrit": "अतीत्य च तमध्वानमाससाद नराधिपम् ।\nसा तमासाद्य राजानं साल्वं वचनमब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149683, "chapter_id": 4242, "verse_number": "५", "content_sanskrit": "आगताऽहं महाबाहो त्वामुद्दिश्य महामते ।\nअभिनन्दस्व मां राजन् सदा प्रियहिते रताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149684, "chapter_id": 4242, "verse_number": "६", "content_sanskrit": "त्वं हि मे मनसा ध्यातस्त्वया चाप्युपमन्त्रिता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149685, "chapter_id": 4242, "verse_number": "७", "content_sanskrit": "तमब्रवीत् साल्वपतिः स्मयन्निव विशाम्पते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149686, "chapter_id": 4242, "verse_number": "८", "content_sanskrit": "त्वयाऽन्यपूर्वया नाहं भार्यार्थी वरवर्णिनि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149687, "chapter_id": 4242, "verse_number": "९", "content_sanskrit": "गच्छ भद्रे पुनस्तत्र सकाशं भीष्मकस्य वै ।\nनाहमिच्छामि भीष्मेण गृहीतां त्वां प्रसँह्य वै\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149688, "chapter_id": 4242, "verse_number": "१०", "content_sanskrit": "त्वं हि भीष्मेण निर्जित्य नीता प्रीतिमती तदा ।\nपरामृष्टा महायुद्धे निर्जित्य पृथिवीपतीन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149689, "chapter_id": 4242, "verse_number": "११", "content_sanskrit": "नाहं त्वय्यन्यपूर्वायां भार्यार्थी वरवर्णिनि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149690, "chapter_id": 4242, "verse_number": "१२", "content_sanskrit": "कथमस्मद्विधो राजा परपूर्वां प्रवेशयेत् ।\nनारीं विदितविज्ञानः परेषां धर्ममादिशन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149691, "chapter_id": 4242, "verse_number": "१३", "content_sanskrit": "यथेष्टं गम्यतां भद्रे मा त्वां कालोऽत्यगादयम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149692, "chapter_id": 4242, "verse_number": "१४", "content_sanskrit": "अम्बा तमब्रवीद् राजन् अनङ्गशरपीडिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149693, "chapter_id": 4242, "verse_number": "१५", "content_sanskrit": "नैवं वद महीपाल नैतदेवं कथञ्चन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149694, "chapter_id": 4242, "verse_number": "१६", "content_sanskrit": "नास्मि प्रीतिमती नीता भीष्मेणामित्रकर्शन ।\nबलान्नीताऽस्मि रुदती विद्राव्य पृथिवीपतीन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149695, "chapter_id": 4242, "verse_number": "१७", "content_sanskrit": "भजस्व मां साल्वपते भक्तां बालामनागसीम् ।\nभक्तानां हि परित्यागो न धर्मेषु प्रशस्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149696, "chapter_id": 4242, "verse_number": "१८", "content_sanskrit": "साऽहमामन्त्र्य गाङ्गेयं समरेष्वनिवर्तिनम् ।\nअनुज्ञाता च तेनैव ततोऽहं भृशमागता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149697, "chapter_id": 4242, "verse_number": "१९", "content_sanskrit": "न स भीष्मो महाबाहुर्मामिच्छति विशाम्पते ।\nभ्रातृहेतोः समारम्भो भीष्मस्येति श्रुतं मया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149698, "chapter_id": 4242, "verse_number": "२०", "content_sanskrit": "भगिन्यौ मम ये नीते अम्बिकाम्बालिके नृप ।\nप्रादाद् विचित्रवीर्याय गाङ्गेयो हि यवीयसे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149699, "chapter_id": 4242, "verse_number": "२१", "content_sanskrit": "यथा साल्वपते नान्यं नरं यामि कथञ्चन ।\nत्वामृते पुरुषव्याघ्रं तथा मूर्धानमालभे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149700, "chapter_id": 4242, "verse_number": "२२", "content_sanskrit": "न चान्यपूर्वा राजेन्द्र त्वामहं समुपस्थिता ।\nसा त्वा ब्रवीमि साल्वैतत् सत्येनात्मानमालभे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149701, "chapter_id": 4242, "verse_number": "२३", "content_sanskrit": "भजस्व मां विशालाक्ष स्वयं कन्यामुपस्थिताम् ।\nअनन्यपूर्वां राजेन्द्र त्वत्प्रसादाभिकाङ्क्षिणीम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149702, "chapter_id": 4242, "verse_number": "२४", "content_sanskrit": "तामेवं भाषमाणां तु साल्वः काशीपतेः सुताम् ।\nअत्यजद् भरतश्रेष्ठ जीर्णां त्वचमिवोरगः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149703, "chapter_id": 4242, "verse_number": "२५", "content_sanskrit": "एवं बहुविधैर्वाक्यैर्याच्यमानस्तयाऽनघ ।\nनाश्रद्दधत् साल्वपतिः कन्यायां भरतर्षभ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149704, "chapter_id": 4242, "verse_number": "२६", "content_sanskrit": "ततः सा मन्युनाऽऽविष्टा ज्येष्ठा काशिपतेः सुता ।\nअब्रवीत् साश्रुनयना बाष्पविह्वलया गिरा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149705, "chapter_id": 4242, "verse_number": "२७", "content_sanskrit": "त्वया त्यक्ता गमिष्यामि यत्र तत्र विशाम्पते ।\nतत्र मे सन्तु गतयः सन्तः सत्यं यथा ध्रुवम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149706, "chapter_id": 4242, "verse_number": "२८", "content_sanskrit": "एवं तां भाषमाणां तु नृशंसः साल्वराट् तदा ।\nपरितत्याज कौरव्य करुणं परिदेविनीम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149707, "chapter_id": 4242, "verse_number": "२९", "content_sanskrit": "गच्छ गच्छेति तां साल्वः पुनः पुनरभाषत ।\nबिभेमि भीष्मात् सुश्रोणि त्वं च भीष्मपरिग्रहः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149708, "chapter_id": 4242, "verse_number": "३०", "content_sanskrit": "एवमुक्ता तु सा तेन साल्वेनादीर्घदर्शिना ।\nनिश्चक्राम पुराद् दीना रुदती कुररी यथा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149709, "chapter_id": 4242, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिसप्तत्युत्तरशततमोऽध्यायः ॥१७३॥\nअम्बोपाख्यानपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]