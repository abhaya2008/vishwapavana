[{"id": 2024910, "chapter_id": 1534, "verse_number": "३-१७२-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024911, "chapter_id": 1534, "verse_number": "३-१७२-१", "content_sanskrit": "ततो निवातकवचाः सर्वेवेगेन भारत।\nअभ्यद्रवन्मां सहिताः प्रगृहीतायुधा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024912, "chapter_id": 1534, "verse_number": "३-१७२-२", "content_sanskrit": "आच्छाद्य रथपन्थानमुत्क्रोशन्तो महारथाः।\nअवृत्य सर्वतस्ते मां शरवर्षैरवाकिरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024913, "chapter_id": 1534, "verse_number": "३-१७२-३", "content_sanskrit": "ततोऽपरे महावीर्याः शूलपट्टसपाणयः।\nशूलानि च भुशुण्डीश्च मुमुचुर्दानवा मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024914, "chapter_id": 1534, "verse_number": "३-१७२-४", "content_sanskrit": "सुमहत्तुमुलं वर्षं गदाशक्तिसमाकुलम्।\nअनिशं सृज्यमानं तैरपतन्मद्रथोपरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024915, "chapter_id": 1534, "verse_number": "३-१७२-५", "content_sanskrit": "अन्ये मामभ्यधावन्त निवातकवचा सुधि।\nशितशस्त्रायुधा रौद्राः कालरूपाः प्रहारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024916, "chapter_id": 1534, "verse_number": "३-१७२-६", "content_sanskrit": "तानहं विविधैर्बाणैर्वेगवद्भिरजिह्मगैः।\nगाण्डीवमुक्तैरभ्यघ्नमेकैकं दशभिर्मृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024917, "chapter_id": 1534, "verse_number": "३-१७२-७", "content_sanskrit": "ते कृता विमुखाः सर्वे मत्प्रयुक्तैः शिलाशितैः।\nततो मातलिना तूर्णं हयास्ते संप्रयोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024918, "chapter_id": 1534, "verse_number": "३-१७२-८", "content_sanskrit": "अथ मार्गान्बहूस्तत्र विचेरुर्वातरंहसः।\nसुसंयता मातलिना प्रामथ्नन्त दितेःसुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024919, "chapter_id": 1534, "verse_number": "३-१७२-९", "content_sanskrit": "शतं शतास्ते हरयस्तस्मिन्युक्ता महारथे।\nतदा मातलिना यथ्ता व्यचरन्नल्पका इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024920, "chapter_id": 1534, "verse_number": "३-१७२-१०", "content_sanskrit": "तेषां चरणपातेन रथनेमिस्वनेन च।\nमम बाणनिपातैश्च हतास्ते शतशोऽसुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024921, "chapter_id": 1534, "verse_number": "३-१७२-११", "content_sanskrit": "गतासवस्तथैवान्ये दानवाः पाण्डवर्षभ।\nहतसारथयस्तत्र व्यकृष्यन्त तुरंगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024922, "chapter_id": 1534, "verse_number": "३-१७२-१२", "content_sanskrit": "ते दिशो विदिशः सर्वे प्रतिरुध्य प्रहारिणः।\nअभ्यघ्नन्विविधैः शस्त्रैस्ततो मे व्यथितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024923, "chapter_id": 1534, "verse_number": "३-१७२-१३", "content_sanskrit": "ततोऽहं मातलेर्वीर्यमद्भुतं समदर्शयम्।\nअश्वांस्तथा वेगवतो यदयत्नादधारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024924, "chapter_id": 1534, "verse_number": "३-१७२-१४", "content_sanskrit": "ततोऽहं लघुभिश्चित्रैरस्त्रैस्तानसुरान्रणे।\nचिच्छेद सायुधान्राजञ्छतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024925, "chapter_id": 1534, "verse_number": "३-१७२-१५", "content_sanskrit": "एवं मे चरतस्तत्र सर्वयत्नेन शत्रुहन्।\nप्रीतिमानभवद्वीरो मातलिः शक्रसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024926, "chapter_id": 1534, "verse_number": "३-१७२-१६", "content_sanskrit": "वध्यमानास्ततस्तैस्तु हयैस्तेन रथेन च।\nअगमन्प्रक्षयं केचिन्न्यवर्तन्त तथाऽपरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024927, "chapter_id": 1534, "verse_number": "३-१७२-१७", "content_sanskrit": "स्पर्धमाना इवास्माभिर्निवातकवचा रणे।\nशरवर्षैः शरार्तं मां महद्भिः प्रत्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024928, "chapter_id": 1534, "verse_number": "३-१७२-१८", "content_sanskrit": "शरवेगैर्निहत्याहमस्त्रैः शरविघातिभिः।\nज्वलद्भिः परमैः शीघ्रैस्तानविध्यं सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024929, "chapter_id": 1534, "verse_number": "३-१७२-१९", "content_sanskrit": "ततः संपीड्यमानास्ते क्रोधाविष्टा महासुराः।\nअपीडयन्मां सहिताः शक्तिशूलासिवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024930, "chapter_id": 1534, "verse_number": "३-१७२-२०", "content_sanskrit": "ततोऽहमस्त्रं प्रायुञ्जं गान्धर्वं नाम भारत।\nदयितं देवराजस् माधवं नाम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024931, "chapter_id": 1534, "verse_number": "३-१७२-२१", "content_sanskrit": "ततः खङ्गांस्त्रिशूलांश्च तोमरांशच् सहस्रशः।\nअस्त्रवीर्येण शतधा तैर्मुक्तानहमच्छिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024932, "chapter_id": 1534, "verse_number": "३-१७२-२२", "content_sanskrit": "छित्त्वा प्रहरणान्येषां ततस्तानपि सर्वशः।\nप्रत्यविध्यमहं रोषाद्दशभिर्दशभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024933, "chapter_id": 1534, "verse_number": "३-१७२-२३", "content_sanskrit": "गाण्डीवाद्धि तदा सङ्ख्ये यथा भ्रमरपङ्क्तयः।\nनिष्पतन्ति महाबाणास्तन्मातलिरपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024934, "chapter_id": 1534, "verse_number": "३-१७२-२४", "content_sanskrit": "तेषामपि तु बाणास्ते बहुत्वाच्छलभा इव।\nअवाकिरन्मां बलवत्तानहं व्यधमं शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024935, "chapter_id": 1534, "verse_number": "३-१७२-२५", "content_sanskrit": "वध्यमानास्ततस्ते तु निवातकवचाः पुनः।\nशरवर्षैर्महद्भिर्मां समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024936, "chapter_id": 1534, "verse_number": "३-१७२-२६", "content_sanskrit": "शरवेगान्निहत्याहमस्त्रैरस्त्रविघातिभिः।\nज्वलद्भिः परमैः शीघ्रैस्तानविध्यं सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024937, "chapter_id": 1534, "verse_number": "३-१७२-२७", "content_sanskrit": "तेषां छिन्नानि गात्राणि विसृजन्तिस्म शोणितम्।\nप्रावृषीवाभिवृष्टानि शृङ्गाण्यथ धराभृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024938, "chapter_id": 1534, "verse_number": "३-१७२-२८", "content_sanskrit": "इन्द्राशनिसमस्पर्शैर्वेगवद्भिरजिह्मगैः।\nमद्वाणैर्वध्यमानास्ते समुद्विग्राः स्म दानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024939, "chapter_id": 1534, "verse_number": "३-१७२-२९", "content_sanskrit": "शतधा भिन्नदेहास्ते क्षीणप्रहरणौजसः।\nततो निवातकवचा मामयुध्यन्त मायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024940, "chapter_id": 1534, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि द्विसप्तत्यधिकशततमोऽध्यायः ॥ १७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]