[{"id": 2139895, "chapter_id": 4020, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139896, "chapter_id": 4020, "verse_number": "१", "content_sanskrit": "कीचके तु हते राजा विराटः परवीरहा ।\nशोकमाहारयत् तीव्रं सामात्यः सपुरोहितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139897, "chapter_id": 4020, "verse_number": "२", "content_sanskrit": "कीचकस्य वधं घोरं सानुजस्य विशाम्पते ।\nआत्माहितं चिन्तयित्वा व्यस्मयन्त पृथग्जनाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139898, "chapter_id": 4020, "verse_number": "३", "content_sanskrit": "तस्मिन् पुरे जनपदे जजल्पुश्चापि सर्वशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139899, "chapter_id": 4020, "verse_number": "४", "content_sanskrit": "वीर्यवान् दयितो राज्ञो दर्पोत्सिक्तश्च कीचकः ।\nसाम्परायारिल्किष्टो बलवान् दुर्जयो रणे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139900, "chapter_id": 4020, "verse_number": "५", "content_sanskrit": "आसीत् प्रहर्ता शत्रूणां चारुदर्शी च दुर्मतिः ।\nस हतः किल गन्धर्वैः सैरन्ध्रीकारणान्निशि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139901, "chapter_id": 4020, "verse_number": "६", "content_sanskrit": "इत्यजल्पन् महाराज कीचकानां महावधम् ।\nदेशे देशे मनुष्याश्च व्यस्मयन् कीचके हते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139902, "chapter_id": 4020, "verse_number": "७", "content_sanskrit": "अथ ते धार्तराष्ट्रेण प्रयुक्ता बहवश्चराः ।\nमृगयित्वा बहून् देशान् ग्रामांश्च नगराणि च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139903, "chapter_id": 4020, "verse_number": "८", "content_sanskrit": "संविधाय यथाऽऽदिष्टं यथादेशं सदेशकाः ।\nकृतसङ्केतनाः सर्वे न्यवर्तन्त पुरं प्रति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139904, "chapter_id": 4020, "verse_number": "९", "content_sanskrit": "आगम्य हस्तिनपुरं धार्तराष्ट्रमरिन्दम ।\nतत्र दृष्ट्वा तु राजानं कौरव्यं धृतराष्ट्रजम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139905, "chapter_id": 4020, "verse_number": "१०", "content_sanskrit": "प्रणम्य शिरसा भूमौ वर्धयित्वा जयाशिषा ।\nआसीनं सूर्यसङ्काशे काञ्चने परमासने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139906, "chapter_id": 4020, "verse_number": "११", "content_sanskrit": "उपास्यमानं सचिवैर्मरुद्भिरिव वासवम् ।\nद्रोणकर्णकृपैः सार्धं भीष्मेण च महात्मना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139907, "chapter_id": 4020, "verse_number": "१२", "content_sanskrit": "सङ्गतं भ्रातृभिश्चापि त्रिगर्तैश्च महारथैः ।\nदुर्योधनं सभामध्ये आसीनमिदमब्रुवन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139908, "chapter_id": 4020, "verse_number": "१३", "content_sanskrit": "कृतोऽस्माभिः परो यत्नस्तेषामन्वेषणे सदा ।\nपाण्डवानां मनुष्येन्द्र तस्मिन् महति कानने\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139909, "chapter_id": 4020, "verse_number": "१४", "content_sanskrit": "निर्जने व्यालसङ्कीर्णे नानाद्रुमलताकुले ।\nलताप्रतानबहळे नानागुल्मसमाकुले\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139910, "chapter_id": 4020, "verse_number": "१५", "content_sanskrit": "न च विद्मो गतिं तेषां पाण्डवानामरिन्दम ।\nमार्गमाणाः पदन्यासम् आश्रमेषु वनेषु च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139911, "chapter_id": 4020, "verse_number": "१६", "content_sanskrit": "गिरिकूटेषु दुर्गेषु नानाजनपदेषु च ।\nजनाकीर्णेषु सर्वेषु चत्वरेषु पुरेषु च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139912, "chapter_id": 4020, "verse_number": "१७", "content_sanskrit": "नरेन्द्र सभयान् नष्टान् न च विद्मश्च पाण्डवान् ।\nअत्यन्तं वा विनष्टास्ते भद्रं तुभ्यं नरर्षभ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139913, "chapter_id": 4020, "verse_number": "१८", "content_sanskrit": "गिरीणां कूटकुञ्जेषु कन्दरान्तरसानुषु ।\nनदीप्रस्रवणेष्वेव ह्रदेषु च सरस्सु च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139914, "chapter_id": 4020, "verse_number": "१९", "content_sanskrit": "गह्वरेषु च दुर्गेषु ग्रामेषु च वनेषु च ।\nदुर्विज्ञेया गतिस्तेषां मृग्यतेऽस्माभिरेव च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139915, "chapter_id": 4020, "verse_number": "२०", "content_sanskrit": "गजव्याघ्रसमीपेषु सिंहान्ते शरभान्तरे ।\nपदान्यन्विच्छमानास्तु रथानां रथिसत्तम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139916, "chapter_id": 4020, "verse_number": "२१", "content_sanskrit": "कञ्चित् कालं मनुष्येन्द्र सूताननुगता वयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139917, "chapter_id": 4020, "verse_number": "२२", "content_sanskrit": "मृगयित्वा यथान्यायं विदितार्थाश्च तत्त्वतः ।\nप्राप्ता द्वारावतीं पार्थान् ऋते सूताः परन्तप\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139918, "chapter_id": 4020, "verse_number": "२३", "content_sanskrit": "न तत्र पाण्डवा राजन् नापि कृष्णा महाव्रता ।\nसर्वथा विप्रनष्टास्ते नमस्ते भरतर्षभ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139919, "chapter_id": 4020, "verse_number": "२४", "content_sanskrit": "नरदेव यथा दृष्टं न च विद्मात्र पाण्डवान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139920, "chapter_id": 4020, "verse_number": "२५", "content_sanskrit": "निर्वृतो भव नष्टास्ते स्वस्थो भव परन्तप ।\nसर्वथैव प्रणष्टास्ते नमस्ते भरतर्षभ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139921, "chapter_id": 4020, "verse_number": "२६", "content_sanskrit": "सर्वा च पृथिवी कृत्स्ना सशैलवनकानना ।\nसराष्ट्रनगरग्रामा पट्टणैश्च समन्विता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139922, "chapter_id": 4020, "verse_number": "२७", "content_sanskrit": "अन्वेषिता च सर्वत्र न च पश्याम पाण्डवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139923, "chapter_id": 4020, "verse_number": "२८", "content_sanskrit": "पुनः शाधि मनुष्येन्द्र अत ऊर्ध्वं विशाम्पते ।\nअन्वेषणे पाण्डवानां भूयः किं करवामहे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139924, "chapter_id": 4020, "verse_number": "२९", "content_sanskrit": "इमां च नः प्रियामीषद् वाचं भद्रवतीं शृणु\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139925, "chapter_id": 4020, "verse_number": "३०", "content_sanskrit": "येन त्रिगर्ता निकृता बलेन बहुशो नृप ।\nसूतेन राज्ञो मत्स्यस्य कीचकेन महात्मना\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139926, "chapter_id": 4020, "verse_number": "३१", "content_sanskrit": "स हतः पतितः शेते गन्धर्वैर्निशि भारत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139927, "chapter_id": 4020, "verse_number": "३२", "content_sanskrit": "स्यालो राज्ञो विराटस्य सेनापतिरुदारधीः ।\nसुदेष्णावरजः श्रेष्ठः शूरो वीर गतव्यथः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139928, "chapter_id": 4020, "verse_number": "३३", "content_sanskrit": "उत्साहवान् महावीर्यो नीतिमान् बलवानपि ।\nयुद्धज्ञो रिपुवीरघ्नः सिंहतुल्यपराक्रमः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139929, "chapter_id": 4020, "verse_number": "३४", "content_sanskrit": "प्रजारक्षणदक्षश्च शत्रुग्रहणशक्तिमान् ।\nविजितारिर्महायुद्धे प्रचण्डो मानतत्परः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139930, "chapter_id": 4020, "verse_number": "३५", "content_sanskrit": "नरनारीमनोह्लादी वीरो वाग्मी रणप्रियः ।\nपुण्यो धर्मार्ऽथकामानां भाजनं मनुजोत्तमः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139931, "chapter_id": 4020, "verse_number": "३६", "content_sanskrit": "स हतो निशि गन्धर्वैः स्त्रीनिमित्तं नराधिप ।\nअदृश्यमानैर्दुष्टात्मा निशीथे सह सोदरैः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139932, "chapter_id": 4020, "verse_number": "३७", "content_sanskrit": "सुहृदश्चात्र निहता योधाश्च प्रवरा हताः ।\nइत्येवं श्रुतमस्माभिर्गन्धर्वैर्निहतोऽभवत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139933, "chapter_id": 4020, "verse_number": "३८", "content_sanskrit": "बान्धवैर्बहुभिः सार्धं कीचको निहतो निशि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139934, "chapter_id": 4020, "verse_number": "३९", "content_sanskrit": "अद्यप्रभृति राजेन्द्र पाण्डवान्वेषणं प्रति ।\nचारांश्च सर्वतः स त्वं प्रेषयेति मतिर्हि नः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139935, "chapter_id": 4020, "verse_number": "४०", "content_sanskrit": "निहतो निशि गन्धर्वैर्दुष्टात्मा भ्रातृभिः सह\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139936, "chapter_id": 4020, "verse_number": "४१", "content_sanskrit": "प्रियं तदुपसंश्रुत्य शत्रूणां तु पराभवम् ।\nकृतकृत्यस्तु कौरव्य विधिवत् स्यादनन्तरम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139937, "chapter_id": 4020, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि अष्टाविंशोऽध्यायः ॥२८॥\nगोग्रहणपर्वणि प्रथमोऽध्यायः ॥१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]