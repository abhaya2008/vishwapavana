[{"id": 2019003, "chapter_id": 1397, "verse_number": "३-३५-०x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019004, "chapter_id": 1397, "verse_number": "३-३५-१", "content_sanskrit": "सन्धिं कृत्वैव कालेन ह्यन्तकेन पतत्रिणा।\nअनन्तेनाप्रमेयेण स्रोतसा सर्वहारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019005, "chapter_id": 1397, "verse_number": "३-३५-२", "content_sanskrit": "प्रत्यक्षं मन्यसे कालं मर्त्यः सन्कालबन्धनः।\nफेनधर्मा महाराज फलधर्मा तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019006, "chapter_id": 1397, "verse_number": "३-३५-३", "content_sanskrit": "निमेषादपि कौन्तेय यस्यायुरपचीयते।\nसूच्येवाञ्जनचूर्णानि किमिति प्रतिपालयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019007, "chapter_id": 1397, "verse_number": "३-३५-४", "content_sanskrit": "यो नूनममितायुः स्यादथवाऽऽयुःप्रमाणवित्।\nस कालं वै प्रतीक्षेत सर्वप्रत्यक्षदर्शिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019008, "chapter_id": 1397, "verse_number": "३-३५-५", "content_sanskrit": "प्रतीक्ष्यमाणः कालो नः समा राजंस्त्रयोदश।\nआयुषोपचयं कृत्वा मरणायोपनेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019009, "chapter_id": 1397, "verse_number": "३-३५-६", "content_sanskrit": "शरीरिणां हि मरणं शरीरे नित्यमाश्रितम्।\nप्रागेव मरणात्तस्माद्राज्यायैव घटामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019010, "chapter_id": 1397, "verse_number": "३-३५-७", "content_sanskrit": "यो न याति प्रसंख्यानमस्पष्टो भूमिवर्धनः।\nअयातयित्वा वैराणि सोऽवसीदति गौरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019011, "chapter_id": 1397, "verse_number": "३-३५-८", "content_sanskrit": "यो न यातयते वैरमल्पसत्वोद्यमः पुमान्।\nअफलं जन्म तस्याहं मन्ये दुर्जातजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019012, "chapter_id": 1397, "verse_number": "३-३५-९", "content_sanskrit": "हैरण्यौ भवतो बाहू श्रुतिर्भवति पार्थिवी।\nहत्वा द्विषन्तं संग्रामे भुङ्क्ष्व बाहुजितं वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019013, "chapter_id": 1397, "verse_number": "३-३५-१०", "content_sanskrit": "हत्वा वै पुरुषो राजन्निकर्तारमरिंदम्।\nअह्नाय नरकं गच्छेत्स्वर्गेणास्य स संमितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019014, "chapter_id": 1397, "verse_number": "३-३५-११", "content_sanskrit": "अमर्षजो हि संतापः पावकाद्दीप्तिमत्तरः।\nयेनाहमभिसंतप्तो न नक्तं न दिवा शये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019015, "chapter_id": 1397, "verse_number": "३-३५-१२", "content_sanskrit": "अयं च पार्थो बीभत्सुर्वरिष्ठो ज्याविकर्षणे।\nआस्ते परमसंतप्तो नूनं सिंह इवाशये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019016, "chapter_id": 1397, "verse_number": "३-३५-१३", "content_sanskrit": "योऽयमेको नुदेत्सर्वांल्लोके राजन्धनुर्भृतः।\nसोयमात्मजमूष्माणं ग्रहाहस्तीव यच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019017, "chapter_id": 1397, "verse_number": "३-३५-१४", "content_sanskrit": "नकुलः सहदेवश्च वृद्धा माता च वीरसूः।\nतवैव प्रियमिच्छन्त आसते जडमूकवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019018, "chapter_id": 1397, "verse_number": "३-३५-१५", "content_sanskrit": "सर्वे तेऽप्रियमिच्छन्ति बान्धवाः सह सृञ्जयैः।\nअहमेकश्च संतप्तो माता च प्रतिबिन्ध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019019, "chapter_id": 1397, "verse_number": "३-३५-१६", "content_sanskrit": "प्रियमेव तु सर्वेषां यद्ब्रवीम्युत किंचन।\nसर्वे हि व्यसनं प्राप्ताः सर्वे युद्धाभिनन्दिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019020, "chapter_id": 1397, "verse_number": "३-३५-१७", "content_sanskrit": "नातः पापीयसी काचिदापद्राजन्भविष्यति।\nयन्नो नीचैरल्पबलै राज्यमाच्छिद्य भुज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019021, "chapter_id": 1397, "verse_number": "३-३५-१८", "content_sanskrit": "शीलदोषाद्धृणाविष्ट आनृशंस्यात्परंतप।\nक्लेशांस्तितिक्षसे राजन्नान्यः कश्चित्प्रशंसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019022, "chapter_id": 1397, "verse_number": "३-३५-१९", "content_sanskrit": "श्रोत्रियस्येव ते राजन्मन्दकस्याविपश्चितः।\nअनुवाकहता बुद्धिर्नैषा तत्त्वार्थदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019023, "chapter_id": 1397, "verse_number": "३-३५-२०", "content_sanskrit": "घृणी ब्राह्मणरूपोसि कथं क्षत्रेष्वजायथाः।\nअस्यां हि योनौ जायन्ते प्रायशः क्रूरबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019024, "chapter_id": 1397, "verse_number": "३-३५-२१", "content_sanskrit": "अश्रौषीस्त्वं राजधर्मान्यथा वै मनुरब्रवीत्।\nक्रूरान्निकृतिसंपन्नान्विहितानशमात्मकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019025, "chapter_id": 1397, "verse_number": "३-३५-२२", "content_sanskrit": "धार्तराष्ट्रान्महाराज क्षमसे किं दुरात्मनः।\nकर्तव्ये पुरुषव्याघ्र किमास्से पीठसर्पवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019026, "chapter_id": 1397, "verse_number": "३-३५-२३", "content_sanskrit": "बुद्ध्या वीर्येण संयुक्तः श्रुतेनाभिजनेन च।\nतृणानां मुष्टिनैकेन हिमवन्तं च पर्वतम्।\nछन्नमिच्छसि कौन्तेय योऽस्मान्संवर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019027, "chapter_id": 1397, "verse_number": "३-३५-२४", "content_sanskrit": "अज्ञातचर्यागूढेन पृथिव्यां विश्रुतेन च।\nदिवीव पार्थ सूर्येण न शक्याऽऽचरितुं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019028, "chapter_id": 1397, "verse_number": "३-३५-२५", "content_sanskrit": "बृहत्साल इवानूपे शाखापुष्पपलावान्।\nहस्ती श्वेत इवाज्ञातः कथं जिष्णुश्चरिष्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019029, "chapter_id": 1397, "verse_number": "३-३५-२६", "content_sanskrit": "इमौ च सिंहसंकाशौ भ्रातरौ सहितौ शिशू।\nनकुलः सहदेवश्च कथं पार्थ चरिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019030, "chapter_id": 1397, "verse_number": "३-३५-२७", "content_sanskrit": "पुण्यकीर्ती राजपुत्री द्रौपदी वीरसूरियम्।\nविश्रुता कथमज्ञाता कृष्णा पार्थ चरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019031, "chapter_id": 1397, "verse_number": "३-३५-२८", "content_sanskrit": "मां चापि राजञ्जानन्ति ह्याकुमारमिमाः प्रजाः।\nअज्ञातचर्यां पश्यन्ति मेरोरिव निगूहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019032, "chapter_id": 1397, "verse_number": "३-३५-२९", "content_sanskrit": "तथैव बहव्रोऽस्माभी राष्ट्रेभ्यो विप्रवासिताः।\nराजानो राजपुत्राश्च धार्तराष्ट्रमनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019033, "chapter_id": 1397, "verse_number": "३-३५-३०", "content_sanskrit": "न हि तेऽप्युपशाम्यन्ति निकृता वा निराकृताः।\nअवश्यं तैर्निकर्तव्यमस्माकं तत्प्रियैषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019034, "chapter_id": 1397, "verse_number": "३-३५-३१", "content_sanskrit": "तेऽप्यस्मासु प्रयुञ्जीरन्प्रच्छन्नान्सुबहूंश्चरान्।\nआचक्षीरंश्च नो ज्ञात्वा ततः स्यात्सुमहद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019035, "chapter_id": 1397, "verse_number": "३-३५-३२", "content_sanskrit": "अस्माभिरुषिताः सम्यग्वने मासास्त्रयोदश।\nपरिमाणएन तान्पश्य तावतः परिवत्सरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019036, "chapter_id": 1397, "verse_number": "३-३५-३३", "content_sanskrit": "अस्ति मासः प्रतिनिधिर्यथा प्राहुर्मनीषिणः।\nपूतिकानिव सोमस्य तथेदं क्रियतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019037, "chapter_id": 1397, "verse_number": "३-३५-३४", "content_sanskrit": "अथवाऽनडुहे राजन्साधने साधुवाहिने।\nसौहित्यदानादेतस्मादेनसः प्रतिमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019038, "chapter_id": 1397, "verse_number": "३-३५-३५", "content_sanskrit": "तस्माच्छत्रुवधे राजन्क्रियतां निश्चयस्त्वया।\nक्षत्रियस्य हि सर्वस्य नान्यो धर्मोस्ति संयुगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019039, "chapter_id": 1397, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारेत अरण्यपर्वणि अर्जुनाभिगमनपर्वणि पञ्चस्त्रिंशोऽध्यायः ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]