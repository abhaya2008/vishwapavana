[{"id": 7001192000, "chapter_id": 21192, "verse_number": "२-३-४०-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथ शम्भुः समाहूय नन्द्यादीन् सकलान्गणान् ।\nआज्ञापयामास मुदा गन्तुं स्वेन च तत्र वै॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001192001, "chapter_id": 21192, "verse_number": "२-३-४०-२", "content_sanskrit": "॥ शिव उवाच  ।\nअपि यूयं सह मया संगच्छध्वं गिरेः पुरम् ।\nकियद्गणानिहास्थाप्य महोत्सवपुरस्सरम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001192002, "chapter_id": 21192, "verse_number": "२-३-४०-३", "content_sanskrit": "ब्रह्मोवाच ।\nअथ ते समनुज्ञप्ता गणेशा निर्ययुर्मुदा ।\nस्वंस्वं बलमुपादाय तान् कथंचिद्वदाम्यहम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001192003, "chapter_id": 21192, "verse_number": "२-३-४०-४", "content_sanskrit": "अभ्यगाच्छंखकर्णश्च गणकोट्या गणेश्वरः ।\nशिवेन सार्द्धं संगन्तुं हिमाचलपुरम्प्रति॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001192004, "chapter_id": 21192, "verse_number": "२-३-४०-५", "content_sanskrit": "दशकोट्या केकराक्षो गणानां समहोत्सवः ।\nअष्टकोट्या च विकृतो गणानां गणनायकः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001192005, "chapter_id": 21192, "verse_number": "२-३-४०-६", "content_sanskrit": "चतुष्कोट्या विशाखश्च गणानां गणनायकः ।\nपारिजातश्च नवभिः कोटिभिर्गणपुंगवः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001192006, "chapter_id": 21192, "verse_number": "२-३-४०-७", "content_sanskrit": "षष्टिस्सर्वान्तकः श्रीमान्तथैव विकृताननः ।\nगणानान्दुन्दुभोष्टाभिः कोटिकोटिभिर्गणनायकः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001192007, "chapter_id": 21192, "verse_number": "२-३-४०-८", "content_sanskrit": "पञ्चभिश्च कपालाख्यो गणेशः कोटिभिस्तथा ।\nषड्भिस्सन्दारको वीरो गणानां कोटिभिर्मुने॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001192008, "chapter_id": 21192, "verse_number": "२-३-४०-९", "content_sanskrit": "कोटिकोटिभिरेवेह कन्दुकः कुण्डकस्तथा ।\nविष्टम्भो गणपोऽष्टाभिर्गणानां कोटिभिस्तथा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001192009, "chapter_id": 21192, "verse_number": "२-३-४०-१०", "content_sanskrit": "सहस्रकोट्या गणपः पिप्पलो मुदितो ययौ ।\nतथा संनादको वीरो गणेशो मुनिसत्तम॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001192010, "chapter_id": 21192, "verse_number": "२-३-४०-११", "content_sanskrit": "आवेशनस्तथाष्टाभिः कोटिभिर्गणनायकः ।\nमहाकेशस्सहस्रेण कोटीनां गणपो ययौ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001192011, "chapter_id": 21192, "verse_number": "२-३-४०-१२", "content_sanskrit": "कुण्डो द्वादशकोट्या हि तथा पर्वतको मुने ।\nअष्टाभिः कोटिभिर्वीरस्समगाच्चन्द्रतापनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001192012, "chapter_id": 21192, "verse_number": "२-३-४०-१३", "content_sanskrit": "कालश्च कालकश्चैव महाकालश्शतेन वै ।\nकोटीनां गणनाथो हि तथैवाग्निकनामकः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001192013, "chapter_id": 21192, "verse_number": "२-३-४०-१४", "content_sanskrit": "कोट्यग्निमुख एवागाद् गणानां गणनायकः ।\nआदित्यमूर्द्धा कोट्या च तथा चैव घनावहः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001192014, "chapter_id": 21192, "verse_number": "२-३-४०-१५", "content_sanskrit": "सन्नाहश्शतकोट्या हि कुमुदो गणपस्तथा ।\nअमोघः कोकिलश्चैव शतकोट्या गणाधिपः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001192015, "chapter_id": 21192, "verse_number": "२-३-४०-१६", "content_sanskrit": "सुमन्त्रः कोटिकोट्या च गणानां गणानायकः ।\nकाकपादोदरः कोटिषष्ट्या सन्तानकस्तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001192016, "chapter_id": 21192, "verse_number": "२-३-४०-१७", "content_sanskrit": "महाबलश्च नवभिर्मधुपिंगश्च कोकिलः ।\nनीलो नवत्या कोटीनां पूर्णभद्रस्तथैव च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001192017, "chapter_id": 21192, "verse_number": "२-३-४०-१८", "content_sanskrit": "सप्तकोट्या चतुर्वक्त्रः करणो विंशकोटिभिः ।\nययौ नवतिकोट्या तु गणेशानो हि रोमकः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001192018, "chapter_id": 21192, "verse_number": "२-३-४०-१९", "content_sanskrit": "यज्वाशश्शतमन्युश्च मेघमन्युश्च नारद ।\nतावत्कोट्या ययुस्सर्वे गणेशा हि पृथक्पृथक्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001192019, "chapter_id": 21192, "verse_number": "२-३-४०-२०", "content_sanskrit": "काष्ठाङ्गुष्ठश्चतुष्षष्ट्या कोटीनां गणनायकः ।\nविरूपाक्षस्सुकेशश्च वृषाभश्च सनातनः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001192020, "chapter_id": 21192, "verse_number": "२-३-४०-२१", "content_sanskrit": "तालकेतुः षडास्यश्च चञ्च्वास्यश्च सनातनः ।\nसम्वर्तकस्तथा चैत्रो लकुलीशस्स्वयम्प्रभुः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001192021, "chapter_id": 21192, "verse_number": "२-३-४०-२२", "content_sanskrit": "लोकान्तकश्च दीप्तात्मा तथा दैत्यान्तको मुने ।\nदेवो भृंगिरिटिश्श्रीमान्देवदेवप्रियस्तथा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001192022, "chapter_id": 21192, "verse_number": "२-३-४०-२३", "content_sanskrit": "अशनिर्भानुकश्चैव चतुष्षष्ट्या सहस्रशः ।\nययुश्शिवविवाहार्थं शिवेन सहसोत्सवाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001192023, "chapter_id": 21192, "verse_number": "२-३-४०-२४", "content_sanskrit": "भूतकोटिसहस्रेण प्रमथाः कोटिभिस्त्रिभिः ।\nवीरभद्रश्चतुष्षष्ट्या रोमजानान्त्रिकोटिभिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001192024, "chapter_id": 21192, "verse_number": "२-३-४०-२५", "content_sanskrit": "कोटिकोटिसहस्राणां शतैर्विंशतिभिर्वृताः ।\nतत्र जग्मुश्च नन्द्याद्या गणपाश्शंकरोत्सवे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001192025, "chapter_id": 21192, "verse_number": "२-३-४०-२६", "content_sanskrit": "क्षेत्रपालो भैरवश्च कोटिकोटिगणैर्युतः ।\nउद्वाहश्शंकरस्येत्याययौ प्रीत्या महोत्सवे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001192026, "chapter_id": 21192, "verse_number": "२-३-४०-२७", "content_sanskrit": "एते चान्ये च गणपा असङ्ख्याता महाबलाः ।\nतत्र जग्मुर्महाप्रीत्या सोत्साहाश्शंकरोत्सवे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001192027, "chapter_id": 21192, "verse_number": "२-३-४०-२८", "content_sanskrit": "सर्वे सहस्रहस्ताश्च जटामुकुटधारिणः ।\nचन्द्ररेखावतंसाश्च नीलकण्ठास्त्रिलोचनाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001192028, "chapter_id": 21192, "verse_number": "२-३-४०-२९", "content_sanskrit": "रुद्राक्षाभरणास्सर्वे तथा सद्भस्मधारिणः ।\nहारकुण्डलकेयूरमुकुटाद्यैरलंकृताः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001192029, "chapter_id": 21192, "verse_number": "२-३-४०-३०", "content_sanskrit": "ब्रह्मविष्ण्विन्द्रसंकाशा अणिमादिगुणैर्युताः ।\nसूर्य्यकोटिप्रतीकाशास्तत्र रेजुर्गणेश्वराः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001192030, "chapter_id": 21192, "verse_number": "२-३-४०-३१", "content_sanskrit": "पृथिवीचारिणः केचित् केचित्पातालचारिणः ।\nकेचिद्व्योमचराः केचित्सप्तस्वर्गचरा मुने॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001192031, "chapter_id": 21192, "verse_number": "२-३-४०-३२", "content_sanskrit": "किम्बहूक्तेन देवर्षे सर्वलोकनिवासिनः ।\nआययुस्स्वगणाश्शम्भोः प्रीत्या वै शङ्करोत्सवे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001192032, "chapter_id": 21192, "verse_number": "२-३-४०-३३", "content_sanskrit": "इत्थं देवैर्गणैश्चान्यैस्सहितश्शङ्करः प्रभुः ।\nययौ हिमगिरिपुरं विवाहार्थं निजस्य वै॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001192033, "chapter_id": 21192, "verse_number": "२-३-४०-३४", "content_sanskrit": "यदाजगाम सर्वेशो विवाहार्थे सुरादिभिः ।\nतदा तत्र ह्यभूद्वृत्तं तच्छृणु त्वं मुनीश्वर॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001192034, "chapter_id": 21192, "verse_number": "२-३-४०-३५", "content_sanskrit": "रुद्रस्य भगिनी भूत्वा चण्डी सूत्सवसंयुता ।\nतत्राजगाम सुप्रीत्या परेषां सुंभयावहा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001192035, "chapter_id": 21192, "verse_number": "२-३-४०-३६", "content_sanskrit": "प्रेतासनसमारूढा सर्पाभरणभूषिता ।\nपूर्णं कलशमादाय हैमं मूर्ध्नि महाप्रभम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001192036, "chapter_id": 21192, "verse_number": "२-३-४०-३७", "content_sanskrit": "स्वपरीवारसंयुक्ता दीप्तास्या दीप्तलोचना ।\nकुतूहलम्प्रकुर्वन्ती जातहर्षा महाबला॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001192037, "chapter_id": 21192, "verse_number": "२-३-४०-३८", "content_sanskrit": "तत्र भूतगणा दिव्या विरूपः कोटिशो मुने ।\nविराजन्ते स्म बहुशस्तथा नानाविधास्तदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001192038, "chapter_id": 21192, "verse_number": "२-३-४०-३९", "content_sanskrit": "तैस्समेताग्रतश्चण्डी जगाम विकृतानना ।\nकुतूहलान्विता प्रीता प्रीत्युपद्रव कारिणी॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001192039, "chapter_id": 21192, "verse_number": "२-३-४०-४०", "content_sanskrit": "चण्ड्या सर्वे रुद्रगणाः पृष्ठतश्च कृतास्तदा ।\nकोट्येकादशसंख्याका रौद्ररुद्रप्रियाश्च ते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001192040, "chapter_id": 21192, "verse_number": "२-३-४०-४१", "content_sanskrit": "तदा डमरुनिर्घोषैर्व्याप्तमासीज्जगत्त्रयम् ।\nभेरीझंकारशब्देन शंखानां निनदेन च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001192041, "chapter_id": 21192, "verse_number": "२-३-४०-४२", "content_sanskrit": "तथा दुन्दुभिनिर्घोषैश्शब्दः कोलाहलोऽभवत् ।\nकुर्वञ्जगन्मंगलं च नाशयेन्मंगलेतरत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001192042, "chapter_id": 21192, "verse_number": "२-३-४०-४३", "content_sanskrit": "गणानां पृष्ठतो भूत्वा सर्वे देवास्समुत्सुकाः ।\nअन्वयुस्सर्वसिद्धाश्च लोकपालादिका मुने॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001192043, "chapter_id": 21192, "verse_number": "२-३-४०-४४", "content_sanskrit": "मध्ये व्रजन् रमेशोऽथ गरुडासनमाश्रितः ।\nशुशुभे ध्रियमाणेन क्षत्रेण महता मुने॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001192044, "chapter_id": 21192, "verse_number": "२-३-४०-४५", "content_sanskrit": "चामरैर्वीज्यमानोऽसौ स्वगणैः परिवारितः ।\nपार्षदैर्विलसद्भिश्च स्वभूषाविधिभूषितः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001192045, "chapter_id": 21192, "verse_number": "२-३-४०-४६", "content_sanskrit": "तथाऽहमप्यशोभम्वै व्रजन्मार्गे विराजितः ।\nवेदैर्मूर्तिधरैश्शास्त्रैः पुराणैरागमैस्तथा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001192046, "chapter_id": 21192, "verse_number": "२-३-४०-४७", "content_sanskrit": "सनकादिमहासिद्धैस्सप्रजापतिभिस्सुतैः ।\nपरिवारैस्संयुतो हि शिवसेवनतत्परः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001192047, "chapter_id": 21192, "verse_number": "२-३-४०-४८", "content_sanskrit": "स्वसैन्यमध्यगश्शक्र ऐरावतगज स्थितः ।\nनामाविभूषितोऽत्यन्तं व्रजन् रेजे सुरेश्वरः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001192048, "chapter_id": 21192, "verse_number": "२-३-४०-४९", "content_sanskrit": "तदा तु व्रजमानास्ते ऋषयो बहवश्च ते ।\nविरेजुरतिसोत्कण्ठश्शिवस्योद्वाहनम्प्रति॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001192049, "chapter_id": 21192, "verse_number": "२-३-४०-५०", "content_sanskrit": "शाकिन्यो यातुधानाश्च वेताला ब्रह्मराक्षसाः ।\nभूतप्रेतपिशाचाश्च तथान्ये प्रमथादयः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001192050, "chapter_id": 21192, "verse_number": "२-३-४०-५१", "content_sanskrit": "तुम्बुरुर्नारदो हाहा हूहूश्चेत्यादयो वराः ।\nगन्धर्वाः किन्नरा जग्मुर्वाद्यानाध्माय हर्षिताः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001192051, "chapter_id": 21192, "verse_number": "२-३-४०-५२", "content_sanskrit": "जगतो मातरस्सर्वा देवकन्याश्च सर्वशः ।\nगायत्री चैव सावित्री लक्ष्मीरन्यास्सुरस्त्रियः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001192052, "chapter_id": 21192, "verse_number": "२-३-४०-५३", "content_sanskrit": "एताश्चान्याश्च देवानां पत्नयो भवमातरः ।\nउद्वाहश्शंकरस्येति जग्मुस्सर्वा मुदान्विताः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001192053, "chapter_id": 21192, "verse_number": "२-३-४०-५४", "content_sanskrit": "शुद्धस्फटिकसंकाशो वृषभस्सर्वसुन्दरः ।\nयो धर्म उच्यते वेदैश्शास्त्रैस्सिद्धमहर्षिभिः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001192054, "chapter_id": 21192, "verse_number": "२-३-४०-५५", "content_sanskrit": "तमारूढो महादेवो वृषभं धर्मवत्सलः ।\nशुशुभेतीव देवर्षिसेवितस्सकलैर्व्रजन्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001192055, "chapter_id": 21192, "verse_number": "२-३-४०-५६", "content_sanskrit": "एभिस्समेतैस्सफलैमहर्षिभिर्बभौ महेशो बहुशोत्यलंकृतः ।\nहिमालयाह्वस्य धरस्य संव्रजन् पाणिग्रहार्थं सदनं शिवायाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001192056, "chapter_id": 21192, "verse_number": "२-३-४०-५७", "content_sanskrit": "इत्युक्तं शम्भुचरितं गमनम्परमोत्सवम् ।\nहिमालयपुरोद्भूतं सद्वृत्तं शृणु नारद॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]