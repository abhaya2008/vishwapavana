[{"id": 2129463, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129464, "chapter_id": 3787, "verse_number": "१", "content_sanskrit": "अन्धस्य पन्था बधिरस्य पन्थाः\nस्त्रियः पन्था भारवहस्य पन्थाः ।\nराज्ञः पन्था ब्राह्मणेनासमेत्य\nसमेत्य तु ब्राह्मणस्यैव पन्थाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129465, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129466, "chapter_id": 3787, "verse_number": "२", "content_sanskrit": "पन्था अयं तेऽद्य मया विसृष्टो\nयेनेच्छसे तेन कामं व्रजस्व ।\nन पावको विद्यते वै लघीयान्\nइन्द्रोऽपि नित्यं नमते ब्राह्मणानाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129467, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129468, "chapter_id": 3787, "verse_number": "३", "content_sanskrit": "स एवमुक्तो मातुलेनैव सार्धं\nयथेष्टमार्गो यज्ञनिवेशनं तत् ।\nसम्प्राप्य धर्मेण निवारितः सन्\nद्वारि द्वाःस्थं वाक्यमिदं बभाषे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129469, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129470, "chapter_id": 3787, "verse_number": "४", "content_sanskrit": "यज्ञं द्रष्टुं प्राप्तवन्तौ स्म तात\nकौतूहलं बलवद्वै विवृद्धम् ।\nआवां प्राप्तावतिथी सम्प्रवेशं\nकाङ्क्षावहे द्वारपते तवाज्ञाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129471, "chapter_id": 3787, "verse_number": "५", "content_sanskrit": "ऐन्द्रद्युम्नेर्यज्ञदृशाविहावां\nविवक्षू वै जनकेन्द्रं दिदृक्षू ।\nन वै क्रोधाद् व्याधिना वोत्तमेन\nसंयोजयावां द्वारपाल क्षणेन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129472, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "द्वारपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129473, "chapter_id": 3787, "verse_number": "६", "content_sanskrit": "वन्देः समादेशकरा वयं स्म\nनिबोध मद्वाक्यमथोऽधिगम्य ।\nन वै बालाः प्रविशन्त्यत्र वृद्धा\nविप्रा ह्यत्र प्रविशन्ति द्विजाग्र्याः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129474, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129475, "chapter_id": 3787, "verse_number": "७", "content_sanskrit": "यद्यत्र वृद्धेषु कृतः प्रवेशो\nयुक्तं मया द्वारपाल प्रवेष्टुम् ।\nवयं हि वृद्धाश्चरितव्रताश्च\nतपःप्रभावेण निवेशनार्हाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129476, "chapter_id": 3787, "verse_number": "८", "content_sanskrit": "शुश्रूषवश्चातिजितेन्द्रियाश्च\nज्ञानागमे चैव परं निविष्टाः ।\nन बाल इत्यवमन्तव्यमाहुः\nबालोऽप्यग्निर्दहते स्पृश्यमानः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129477, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "द्वारपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129478, "chapter_id": 3787, "verse_number": "९", "content_sanskrit": "सरस्वतीमीरय वेदजुष्टाम्\nएकाक्षरां ब्रह्मरूपां विराजाम् ।\nअङ्गात्मानं समवेक्षस्व बालं\nकिं श्लाघसे दुर्लभा वादसिद्धिः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129479, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129480, "chapter_id": 3787, "verse_number": "१०", "content_sanskrit": "न ज्ञायते कायवृद्ध्या विवृद्धिः\nयथाऽष्ठीला शाल्मली सम्प्रवृद्धा ।\nह्रस्वोऽल्पकः फलते स्म वृद्धो\nयश्चाफलस्तस्य नो वृद्धभावः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129481, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "द्वारपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129482, "chapter_id": 3787, "verse_number": "११", "content_sanskrit": "वृद्धेभ्य एवेह मतिं स्म बाला\nगृह्णन्ति कालेन भवन्ति वृद्धाः ।\nन हि ते ज्ञातुमल्पकालेन शक्यं\nकस्माद् बाल प्राज्ञ इवावभाषसे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129483, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129484, "chapter_id": 3787, "verse_number": "१२", "content_sanskrit": "न तेन स्थविरो भवति येनास्य पलितं शिरः ।\nबालोऽपि यः प्रजानाति तं देवाः स्थविरं विदुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129485, "chapter_id": 3787, "verse_number": "१३", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तैर्न च बन्धुभिः ।\nऋषयश्चक्रिरे धर्मं योऽनूचानः स नो महान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129486, "chapter_id": 3787, "verse_number": "१४", "content_sanskrit": "दिदृक्षुरस्मि सम्प्राप्तो वन्दिनं राजसंसदि ।\nनिवेदयस्व मां राज्ञे द्वास्स्थ पुष्करमालिने\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129487, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "श्वेतकेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129488, "chapter_id": 3787, "verse_number": "१५", "content_sanskrit": "द्रष्टासि ते द्वारपाल प्रवेश्य\nमनीषिभिः सह वादे प्रवृद्धे ।\nउताहो वाऽप्युच्चतां नीचतां वा\nतूष्णीम्भूतेष्वेषु सर्वेष्वथाद्य\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129489, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "द्वारपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129490, "chapter_id": 3787, "verse_number": "१६", "content_sanskrit": "कथं यज्ञं दशवर्षो विशेस्त्वं\nविनीतानां विदुषां सम्प्रवेशम् ।\nउपायतः प्रयतिष्ये तवाहं\nप्रवेशने कुरु यत्नं यथावत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129491, "chapter_id": 3787, "verse_number": "१७", "content_sanskrit": "एष राजा संश्रवणे स्थितः स्यात्\nश्रोष्यत्येवं वचसा संस्कृतेन ।\nस चानुज्ञां दास्यति प्रीतियुक्तः\nप्रवेशने यच्च किञ्चित्तवेष्टम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129492, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129493, "chapter_id": 3787, "verse_number": "१८", "content_sanskrit": "भो भो राजन् जनकानां वरिष्ठ\nत्वं वै सम्राट् त्वयि सर्वं समृद्धम् ।\nत्वं हि कर्ता कर्मणां याज्ञियानां\nययातिरेको नृपतिर्वा पुरस्तात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129494, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "विद्वान् वन्दी वादविदो निगृह्य वादे भग्नानप्रतिशङ्कमानः ।\nत्वया निसृष्टैः पुरुषैराप्तकृद्भिः \tजले सर्वान्मज्जयतीति नः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129495, "chapter_id": 3787, "verse_number": "२०", "content_sanskrit": "स तच्छ्रुत्वा ब्राह्मणानां समीपाद्\nब्रह्मोद्यं वै कथयितुमागतोऽस्मि ।\nक्वासौ वन्दी यावदेनं समेत्य\nनक्षत्राणीव सविता नाशयामि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129496, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129497, "chapter_id": 3787, "verse_number": "२१", "content_sanskrit": "आशंससे वन्दिनं त्वं विजेतुं न च ज्ञात्वा वाक्यबलं त्वमस्य ।\nविज्ञातवीर्यैः शक्यमेवं प्रवक्तुं दृष्टश्चासौ ब्राह्मणैर्वादशीलैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129498, "chapter_id": 3787, "verse_number": "२२", "content_sanskrit": "आशंसमाना वन्दिनं वै कुमारा\nअविज्ञानात्ते ह्यशक्ता विजेतुम् ।\nसमागता ब्राह्मणास्तेन पूर्वं\nन शोभन्ते भास्करेणेव ताराः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129499, "chapter_id": 3787, "verse_number": "२३", "content_sanskrit": "आशानुबन्धो हि तवात्र यस्तं स वन्दिमासाद्य तथा विनश्यति ।\nविज्ञानवन्तो निकृतास्तु तात कथं सदस्तर्तुमिदं समर्थः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129500, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129501, "chapter_id": 3787, "verse_number": "२४", "content_sanskrit": "विवादितोऽसौ न तु मादृशैर्हि\nसिंहीकृतस्तेन वदत्यभीतः ।\nसमेत्य मां निहतः शेष्यतेऽद्य\nमार्गे भग्नं शकटमिवाबलाक्षम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129502, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129503, "chapter_id": 3787, "verse_number": "२५", "content_sanskrit": "षण्णाभेर्द्वादशाक्षस्य चतुर्विंशतिपर्वणः ।\nकस्त्रिषष्टिशतारस्य वेदार्थं स परः कविः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129504, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2129505, "chapter_id": 3787, "verse_number": "२६", "content_sanskrit": "चतुर्विंशतिपर्व त्वां षण्णाभि द्वादशप्रधि ।\nतत्त्रिषष्टिशतारं वै चक्रं पातु सदागति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2129506, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2129507, "chapter_id": 3787, "verse_number": "२७", "content_sanskrit": "बडबे इव सम्पृक्ते शैन्ये पाते दिवौकसाम् ।\nकस्तयोर्गर्भमाधत्ते गर्भं सुषुवतुश्च कम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2129508, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2129509, "chapter_id": 3787, "verse_number": "२८", "content_sanskrit": "मा स्म भूः स्वगृहे राजन् शात्रवाणामपि ध्रुवम् ।\nवातसारथिराहर्ता गर्भं सुषुवतुश्च कम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2129510, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2129511, "chapter_id": 3787, "verse_number": "२९", "content_sanskrit": "किं स्वित् सुप्तं न निमिषेदण्डजातं न चोत्पति ।\nकस्य स्विद्हृदयं नास्ति किं स्विद्वेगेन वर्धते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2129512, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2129513, "chapter_id": 3787, "verse_number": "३०", "content_sanskrit": "मत्स्यः सुप्तो न निमिषेदण्ड जातं न चोत्पति ।\nअश्मनो हृदयं नास्ति नदी वेगेन वर्धते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2129514, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2129515, "chapter_id": 3787, "verse_number": "३१", "content_sanskrit": "न त्वां मन्ये मानुषं देवरूप\nन त्वं बालः स्थविरस्त्वं ततो मे ।\nन ते तुल्यो विद्यते वाक्प्रलापे\nतस्माद् द्वारं वितरामुष्य वन्दिन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2129516, "chapter_id": 3787, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोनत्रिंशोत्तरशततमोऽध्यायः ॥१२९॥\n॥ तीर्थयात्रापर्वणि पञ्चाशीतितमोऽध्यायः ॥८५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]