[{"id": 2006368, "chapter_id": 1127, "verse_number": "१-१२८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006369, "chapter_id": 1127, "verse_number": "१-१२८-१", "content_sanskrit": "एवमुक्तस्तया राजा तां देवीं पुनरब्रवीत्।\nधर्मविद्धर्मसंयुक्तमिदं वचनमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006370, "chapter_id": 1127, "verse_number": "१-१२८-२x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006371, "chapter_id": 1127, "verse_number": "१-१२८-२", "content_sanskrit": "एवमेतत्पुरा कुन्ति व्युषिताश्वश्चकार ह।\nयथा त्वयोक्तं कल्याणि स ह्यासीदमरोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006372, "chapter_id": 1127, "verse_number": "१-१२८-३", "content_sanskrit": "अथ त्विदं प्रवक्ष्यामि धर्मतत्त्वं निबोध मे।\nपुराणमृषिभिर्दृष्टं धर्मविद्भिर्महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006373, "chapter_id": 1127, "verse_number": "१-१२८-४", "content_sanskrit": "अनावृताः किल पुरा स्त्रिय आसन्वरानने।\nकामचारविहारिण्यः स्वतन्त्राश्चारुहासिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006374, "chapter_id": 1127, "verse_number": "१-१२८-५", "content_sanskrit": "तासां व्युच्चरमाणानां कौमारात्सुभगे पतीन्।\nनाधर्मोऽभूद्वरारोहे स हि धर्मः पुराऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006375, "chapter_id": 1127, "verse_number": "१-१२८-६", "content_sanskrit": "तं चैव धर्मं पौराणं तिर्यग्योनिगताः प्रजाः।\nअद्याप्यनुविधीयन्ते कामक्रोधविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006376, "chapter_id": 1127, "verse_number": "१-१२८-७", "content_sanskrit": "प्रमाणदृष्टो धर्मोऽयं पूज्यते च महर्षिभिः।\nउत्तरेषु च रम्भोरु कुरुष्वद्यापि पूज्यते।\nस्त्रीणामनुग्रहकरः स हि धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006377, "chapter_id": 1127, "verse_number": "१-१२८-८", "content_sanskrit": "नाग्निस्तृप्यति काष्ठानां नापगानां महोदधिः।\nनान्तकः सर्वभूतानां न पुंसां वामलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006378, "chapter_id": 1127, "verse_number": "१-१२८-९", "content_sanskrit": "एवं तृष्णा तु नारीणां पुरुषं पुरुषं प्रति।\nअगम्यागमनं स्त्रीणां नास्ति नित्यं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006379, "chapter_id": 1127, "verse_number": "१-१२८-१०", "content_sanskrit": "पुत्रं वा किल पौत्रं वा कासांचिद्धातरं तथा।\nरहसीह नरं दृष्ट्वा योनिरुत्क्लिद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006380, "chapter_id": 1127, "verse_number": "१-१२८-११", "content_sanskrit": "एतत्स्वाभाविकं स्त्रीणां न निमित्तकृतं शुभे।\nअस्मिंस्तु लोके नचिरान्मर्यादेयं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006381, "chapter_id": 1127, "verse_number": "१-१२८-१२", "content_sanskrit": "स्थापिता येन यस्माच्च तन्मे विस्तरतः शृणु।\nबभूवोद्दालको नाम महर्षिरिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006382, "chapter_id": 1127, "verse_number": "१-१२८-१३", "content_sanskrit": "श्वेतकेतुरिति ख्यातः पुत्रस्तस्याभवन्मुनिः।\nमर्यादेयं कृता तेन धर्म्या वै श्वेतकेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006383, "chapter_id": 1127, "verse_number": "१-१२८-१४", "content_sanskrit": "कोपात्कमलपत्राक्षि यदर्थं तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006384, "chapter_id": 1127, "verse_number": "१-१२८-१५", "content_sanskrit": "श्वेतकेतोः पिता देवि तप उग्रं समास्थितः।\nग्रीष्मे पञ्चतपा भूत्वा वर्षास्वाकाशगोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006385, "chapter_id": 1127, "verse_number": "१-१२८-१६", "content_sanskrit": "शिशइरे सलिलस्थायी सह पत्न्या महातपाः।\nउद्दालकं तपस्यन्तं नियमेन समाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006386, "chapter_id": 1127, "verse_number": "१-१२८-१७", "content_sanskrit": "तस्य पुत्रः श्वेतकेतुः परिचर्यां चकार ह।\nअभ्यागच्छद्द्विजः कश्चिद्वलीपलितसंततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006387, "chapter_id": 1127, "verse_number": "१-१२८-१८", "content_sanskrit": "तं दृष्ट्वैव मुनिः प्रीतः पूजयामास शास्त्रतः।\nस्वागतेन च पाद्येन मृदुवाक्यैश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006388, "chapter_id": 1127, "verse_number": "१-१२८-१९", "content_sanskrit": "शाकमूलफलाद्यैश्च वन्यैरन्यैरपूजयत्।\nक्षुत्पिपासाश्रमेंणार्तः पूजितश्च महर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006389, "chapter_id": 1127, "verse_number": "१-१२८-२०", "content_sanskrit": "विश्रान्तो मुनिमासाद्य पर्यपृच्छद्द्विजस्तदा।\nउद्दालक महर्षे त्वं सत्यं मे ब्रूहि माऽनृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006390, "chapter_id": 1127, "verse_number": "१-१२८-२१", "content_sanskrit": "ऋषिपुत्रः कुमारोऽयं दर्शनीयो विशेषतः।\nतव पुत्रमिमं मन्ये कृतकृत्योऽसि तद्वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006391, "chapter_id": 1127, "verse_number": "१-१२८-२२x", "content_sanskrit": "उद्दालक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006392, "chapter_id": 1127, "verse_number": "१-१२८-२२", "content_sanskrit": "मम पत्नी महाप्राज्ञ कुशिकस्य सुता मता।\nमामेवानुगता पत्नी मम नित्यमनुव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006393, "chapter_id": 1127, "verse_number": "१-१२८-२३", "content_sanskrit": "अरुन्धतीव पत्नीनां तपसा कर्शितस्तनी।\nअस्यां जातः श्वेतकेतुर्मम पुत्रो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006394, "chapter_id": 1127, "verse_number": "१-१२८-२४", "content_sanskrit": "वेदवेदाङ्गविद्विप्र मच्छासनपरायणः।\nलोकज्ञः सर्वलोकेषु विश्रुतः सत्यवाग्घृणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006395, "chapter_id": 1127, "verse_number": "१-१२८-२५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006396, "chapter_id": 1127, "verse_number": "१-१२८-२५", "content_sanskrit": "अपुत्री भार्यया चार्थी वृद्धोऽहं मन्दचाक्षुषः।\nपित्र्यादृणादनिर्मुक्तः पूर्वमेवाकृतस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006397, "chapter_id": 1127, "verse_number": "१-१२८-२६", "content_sanskrit": "प्रजारणिस्तु पत्नी ते कुलशीलसमन्विता।\nसदृशी मम गोत्रेण वहाम्येनां क्षमस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006398, "chapter_id": 1127, "verse_number": "१-१२८-२७x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006399, "chapter_id": 1127, "verse_number": "१-१२८-२७", "content_sanskrit": "इत्युक्त्वा मृगशावाक्षीं चीरकृष्णाजिनाम्बराम्।\nयष्ट्याधारः स्रस्तगात्रो मन्दचक्षुरबुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006400, "chapter_id": 1127, "verse_number": "१-१२८-२८", "content_sanskrit": "स्वव्यापाराक्षमां श्रेष्ठमचित्तामात्मनि द्विजः।\nश्वेतकेतोः किल पुरा समक्षं मातरं पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006401, "chapter_id": 1127, "verse_number": "१-१२८-२९", "content_sanskrit": "जग्राह ब्राह्मणः पापौ गच्छाव इति चाब्रवीत्।\nऋषिपुत्रस्तदा कोपं चकारामर्षितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006402, "chapter_id": 1127, "verse_number": "१-१२८-३०", "content_sanskrit": "मातरं तां तथा दृष्ट्वा नीयमानां बलादिव।\nतपसा दीप्तवीर्यो हि श्वेतकेतुर्न चक्षमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006403, "chapter_id": 1127, "verse_number": "१-१२८-३१", "content_sanskrit": "संगृह्य मातरं हस्ते श्वेतकेतुरभाषत।\nदुर्ब्राह्मण विमुञ्च त्वं मातरं मे पतिव्रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006404, "chapter_id": 1127, "verse_number": "१-१२८-३२", "content_sanskrit": "स्वयं पिता मे ब्रह्मर्षिः क्षमावान्ब्रह्मवित्तमः।\nशापानुग्रहयोः शक्तः तूष्णींभूतो महाव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006405, "chapter_id": 1127, "verse_number": "१-१२८-३३", "content_sanskrit": "तस्य पत्नी दमोपेता मम माता विशेषतः।\nपतिव्रतां तपोवृद्धां साध्वाचारैरलङ्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006406, "chapter_id": 1127, "verse_number": "१-१२८-३४", "content_sanskrit": "अप्रमादेन ते ब्रह्मन्मातृभूतां विमुञ्च वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006407, "chapter_id": 1127, "verse_number": "१-१२८-३५", "content_sanskrit": "एवमुक्त्वा तु याचन्तं विमुञ्चेति मुहुर्मुहुः।\nप्रत्यवोचद्द्विजो राजन्नप्रगल्भमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006408, "chapter_id": 1127, "verse_number": "१-१२८-३६x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006409, "chapter_id": 1127, "verse_number": "१-१२८-३६", "content_sanskrit": "अपत्यार्थी श्वेतकेतो वृद्धोऽहं मन्दचाक्षुषः।\nपिता ते ऋणनिर्मुक्तस्त्वया पुत्रेण काश्यप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006410, "chapter_id": 1127, "verse_number": "१-१२८-३७", "content_sanskrit": "ऋणादहमनिर्मुक्तो वृद्धोऽहं विगतस्पृहः।\nमम को दास्यति सुतां कन्यां संप्राप्तयौवनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006411, "chapter_id": 1127, "verse_number": "१-१२८-३८", "content_sanskrit": "प्रजारणिमिमां पत्नीं विमुञ्च त्वं महातपः।\nएकया प्रजया प्रीतो मातरं ते ददाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006412, "chapter_id": 1127, "verse_number": "१-१२८-३९", "content_sanskrit": "एवमुक्तः श्वेतकेतुर्लज्जया क्रोधमेयिवान्।\nक्रुद्धं तं तु पिता दृष्ट्वा श्वेतकेतुमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006413, "chapter_id": 1127, "verse_number": "१-१२८-४०", "content_sanskrit": "मा तात कोपं कार्षीस्त्वमेष धर्मः सनातनः।\nअनावृता हि सर्वेषां वर्णानामङ्गना भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006414, "chapter_id": 1127, "verse_number": "१-१२८-४१", "content_sanskrit": "यथा गावः स्थिताः पुत्र स्वेस्वे वर्णे तथा प्रजाः।\nतथैव च कुटुम्बेषु न प्रमाद्यन्ति कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006415, "chapter_id": 1127, "verse_number": "१-१२८-४२", "content_sanskrit": "ऋतुकाले तु संप्राप्ते भर्तारं न जहुस्तदा।\nऋषिपुत्रोऽथ तं धर्मं श्वेतकेतुर्न चक्षमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006416, "chapter_id": 1127, "verse_number": "१-१२८-४३", "content_sanskrit": "चकार चैव मर्यादामिमां स्त्रीपुंसयोर्भुवि।\nमानुषेषु महाभागे न त्वेवान्येषु जन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006417, "chapter_id": 1127, "verse_number": "१-१२८-४४", "content_sanskrit": "तदाप्रभृति मर्यादा स्थितेयमिति नः श्रुतम्।\nव्युच्चरन्त्याः पतिं नार्या अद्यप्रभृति पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006418, "chapter_id": 1127, "verse_number": "१-१२८-४५", "content_sanskrit": "भ्रूणहत्यासमं घोरं भविष्यत्यसुखावहम्।\nअद्याप्यनुविधीयन्ते कामक्रोधविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006419, "chapter_id": 1127, "verse_number": "१-१२८-४६", "content_sanskrit": "उत्तरेषु महाभागे कुरुष्वेवं यशस्विनि।\nपुराणदृष्टो धर्मोऽयं पूज्यते च महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006420, "chapter_id": 1127, "verse_number": "१-१२८-४७", "content_sanskrit": "भार्यां तथा व्युच्चरतः कौमारब्रह्मचारिणीम्।\nपतिव्रतामेतदेव भविता पातकं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2006421, "chapter_id": 1127, "verse_number": "१-१२८-४८", "content_sanskrit": "नियुक्ता पतिना भार्या यद्यपत्यस्य कारणात्।\nन कुर्यात्तत्तथा भीरु सैनः सुमहदाप्नुयात्।\nइति तेन पुरा भीरु मर्यादा स्थापिता बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2006422, "chapter_id": 1127, "verse_number": "१-१२८-४९", "content_sanskrit": "उद्दालकस्य पुत्रेण धर्म्या वै श्वेतकेतुना।\nसौदासेन च रम्भोरु नियुक्ता पुत्रजन्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2006423, "chapter_id": 1127, "verse_number": "१-१२८-५०", "content_sanskrit": "मदयन्ती जगामर्षिं वसिष्ठमिति नः श्रुतम्।\nतस्माल्लेभे च सा पुत्रमश्मकं नाम भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2006424, "chapter_id": 1127, "verse_number": "१-१२८-५१", "content_sanskrit": "एवं कृतवती सापि भर्तुः प्रियचिकीर्षया।\nअस्माकमपि ते जन्म विदितं कमलेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2006425, "chapter_id": 1127, "verse_number": "१-१२८-५२", "content_sanskrit": "कृष्णद्वैपायनाद्भीरु कुरूणां वंशवृद्धये।\nअत एतानि सर्वाणि कारणानि समीक्ष्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2006426, "chapter_id": 1127, "verse_number": "१-१२८-५३", "content_sanskrit": "ममैतद्वचनं धर्म्यं कर्तुमर्हस्यनिन्दिते।\nऋतावृतौ राजपुत्रि स्त्रिया भर्ता पतिव्रते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2006427, "chapter_id": 1127, "verse_number": "१-१२८-५४", "content_sanskrit": "नातिवर्तव्य इत्येवं धर्मं धर्मविदो विदुः।\nशेषेष्वन्येषु कालेषु स्वातन्त्र्यं स्त्री किलार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2006428, "chapter_id": 1127, "verse_number": "१-१२८-५५", "content_sanskrit": "धर्ममेवं जनाः सन्तः पुराणं परिचक्षते।\nभर्ता भार्यां राजपुत्रि धर्म्यं वाऽधर्म्यमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2006429, "chapter_id": 1127, "verse_number": "१-१२८-५६", "content_sanskrit": "यद्ब्रूयात्तत्तथा कार्यमिति वेदविदो विदुः।\nविशेषतः पुत्रगृद्धी हीनः प्रजननात्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2006430, "chapter_id": 1127, "verse_number": "१-१२८-५७", "content_sanskrit": "यथाऽहमनवद्याङ्गि पुत्रदर्शनलालसः।\nअयं रक्ताङ्गुलिनखः पद्मपत्रनिभः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2006431, "chapter_id": 1127, "verse_number": "१-१२८-५८", "content_sanskrit": "प्रसादनार्थं सुश्रोणि शिरस्यभ्युद्यतोऽञ्जलिः।\nमन्नियोगात्सुकेशान्ते द्विजातेस्तपसाऽधिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2006432, "chapter_id": 1127, "verse_number": "१-१२८-५९", "content_sanskrit": "पुत्रान्गुणसमायुक्तानुत्पादयितुमर्हसि।\nत्वत्कृतेऽहं पृथुश्रोणि गच्छेयं पुत्रिणां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2006433, "chapter_id": 1127, "verse_number": "१-१२८-६०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2006434, "chapter_id": 1127, "verse_number": "१-१२८-६०", "content_sanskrit": "एवमुक्ता ततः कुन्ती पाण्डुं परपुरञ्जयम्।\nप्रत्युवाच वरारोहा भर्तुः प्रियहिते रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2006435, "chapter_id": 1127, "verse_number": "१-१२८-६१", "content_sanskrit": "अधर्मः सुमहानेषु स्त्रीणां भरतसत्तम।\nयत्प्रसादयते भर्ता प्रसाद्यः क्षत्रियर्षभ।\nशृणु चेदं महाबाहो मम प्रीतिकरं चः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2006436, "chapter_id": 1127, "verse_number": "१-१२८-६२", "content_sanskrit": "पितृवेश्मन्यहं बाला नियुक्ताऽतिथिपूजने।\nउग्रं पर्यचरं तत्र ब्राह्मणं संशितव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2006437, "chapter_id": 1127, "verse_number": "१-१२८-६३", "content_sanskrit": "निगूढनिश्चयं धर्मे यं तं दुर्वाससं विदुः।\nतमहं संशितात्मानं सर्वयत्नैरतोषयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2006438, "chapter_id": 1127, "verse_number": "१-१२८-६४", "content_sanskrit": "स मेऽभिचारसंयुक्तमाचष्ट भगवान्वरम्।\nमन्त्रं त्विमं च मे प्रादादब्रवीच्चैव मामिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2006439, "chapter_id": 1127, "verse_number": "१-१२८-६५", "content_sanskrit": "यं यं देवं त्वमेतेन मन्त्रेणावाहयिष्यसि।\nअकामो वा सकामो वा वशं ते समुपैष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2006440, "chapter_id": 1127, "verse_number": "१-१२८-६६", "content_sanskrit": "तस्य तस्य प्रसादात्ते राज्ञि पुत्रो भविष्यति।\nइत्युक्ताऽहं तदा तेन पितृवेश्मनि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2006441, "chapter_id": 1127, "verse_number": "१-१२८-६७", "content_sanskrit": "ब्राह्मणस्य वचस्तथ्यं तस्य कालोऽयमागतः।\nअनुज्ञाता त्वया देवमाह्वयेयमहं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2006442, "chapter_id": 1127, "verse_number": "१-१२८-६८", "content_sanskrit": "यां मे विद्यां महाराज अददात्स महायशाः।\nतयाऽऽहूतः सुरः पुत्रं प्रदास्यति सुरोपमम्।\nअनपत्यकृतं यस्ते शोकं वीर विनेष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2006443, "chapter_id": 1127, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टाविंशत्यधिकशततमोऽध्यायः॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]