[{"id": 7002505000, "chapter_id": 22505, "verse_number": "१-१६७-१", "content_sanskrit": "सुमंतुरुवाच ।\nषष्ठ्यां चाप्यथ सप्तम्यां नियता ब्रह्मचारिणी ।\nवर्षमेकं न भुंक्ते या महाभागजिगीषया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002505001, "chapter_id": 22505, "verse_number": "१-१६७-२", "content_sanskrit": "वर्षांति प्रतिमां कृत्वा निक्षुभांकेति विश्रुताम् ।\nस्नानाद्यं च विधिं कृत्वा पूर्वोक्तं लभते गुणम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002505002, "chapter_id": 22505, "verse_number": "१-१६७-३", "content_sanskrit": "जांबूनदमयैर्यानैश्चतुर्द्वारैरलंकृते ।\nगत्वादित्यपुरे रम्ये अशेषं विंदते फलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002505003, "chapter_id": 22505, "verse_number": "१-१६७-४", "content_sanskrit": "सौरादिसर्वलोकेषु भोगान्भुक्त्वा यथेप्सितान् ।\nक्रमादागत्य लोकेऽस्मिन्राजानं पतिमाप्नुयात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002505004, "chapter_id": 22505, "verse_number": "१-१६७-५", "content_sanskrit": "या नार्युपवसेदेवं कृष्णामेकां तु सप्तमीम् ।\nसा गच्छेत्परमं स्थानं भानोरमिततेजसः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002505005, "chapter_id": 22505, "verse_number": "१-१६७-६", "content_sanskrit": "वर्षांते प्रतिमां कृत्वा शालिपिष्टमयीं शुभाम् ।\nपीतानुलेपनैर्माल्यैः पीतवस्त्रैश्च पूजयेत् ।\nपूर्वोक्तमखिलं कृत्वा भास्कराय निवेदयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002505006, "chapter_id": 22505, "verse_number": "१-१६७-७", "content_sanskrit": "सप्तभीमैर्महायानैर्दंतिचामीकरप्रभैः ।\nवर्षकोटिशतं साग्रं सूर्यलोके महीयते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002505007, "chapter_id": 22505, "verse_number": "१-१६७-८", "content_sanskrit": "सौरलोकादिलोकेषु भुक्त्वा भोगान्नराधिप ।\nक्रमादागत्य लोकेऽस्मिन्य थेष्टं विंदते पतिम् ।\nसर्वलक्षणसंपन्नं धनधान्यसमन्वितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002505008, "chapter_id": 22505, "verse_number": "१-१६७-९", "content_sanskrit": "कृष्णपक्षे तु सप्तम्यां या नारी तु दृढव्रता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002505009, "chapter_id": 22505, "verse_number": "१-१६७-१०", "content_sanskrit": "वर्षांते सर्वगंधाढ्यं निक्षुभार्कं निवेदयेत्  ।\nसुवर्णमणिमुक्ताभ्यां भोजयित्वा मगांगनाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002505010, "chapter_id": 22505, "verse_number": "१-१६७-११", "content_sanskrit": "सुविचित्रैर्महायानैर्दिव्यगंधर्वशोभितैः ।\nसा वै युगसहस्राणि सूरलोके नराधिप ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002505011, "chapter_id": 22505, "verse_number": "१-१६७-१२", "content_sanskrit": "यथेष्टं भानवे लोके भोगान्भुक्त्वा तु कृत्स्नशः ।\nक्रमादागत्य लोकेस्मिन्राजन्तं विंदते पतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002505012, "chapter_id": 22505, "verse_number": "१-१६७-१३", "content_sanskrit": "एवं या कुरुते राजन्व्रतं पापभयापहम् ।\nनिक्षुभार्कमिदं पुण्यं सा याति परमं पदम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002505013, "chapter_id": 22505, "verse_number": "१-१६७-१४", "content_sanskrit": "वर्षमेकं महाबाहो श्रद्धया परयान्वितः ।\nवर्षांते वै भोजयेद्वीर दांपत्यं भोजकेषु वै ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002505014, "chapter_id": 22505, "verse_number": "१-१६७-१५", "content_sanskrit": "भोजयित्वा तु दांपत्यं भोगकानां महाबलैः ।\nपूजयेद्गंधमाल्यैस्तु वासोभिः कुरुनंदन ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002505015, "chapter_id": 22505, "verse_number": "१-१६७-१६", "content_sanskrit": "कृत्वा ताम्रमये पात्रे वज्रपूर्णैरलंकृतम् ।\nनिक्षुभार्कं तु सौवर्णं दत्त्वा ताभ्यां तु शक्तितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002505016, "chapter_id": 22505, "verse_number": "१-१६७-१७", "content_sanskrit": "निक्षुभा भोजिका ज्ञेया भोजकोऽर्कः प्रकीर्तितः ।\nतस्मात्तौ पूजयेत्सौरीश्वरवच्छ्रद्धयान्वितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]