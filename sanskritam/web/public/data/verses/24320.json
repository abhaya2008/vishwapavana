[{"id": 7004320000, "chapter_id": 24320, "verse_number": "५-३-१४-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nततस्त ऋषयः सर्वे महाभागास्तपोधनाः ।\nगतास्तु परमं लोकं ततः किं जातमद्भुतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004320001, "chapter_id": 24320, "verse_number": "५-३-१४-२", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततस्तेषु प्रयातेषु नर्मदातीरवासिषु ।\nबभूव रौद्रसंहारः सर्वभूतक्षयंकरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004320002, "chapter_id": 24320, "verse_number": "५-३-१४-३", "content_sanskrit": "कैलासशिखरस्थं तु महादेवं सनातनम् ।\nब्रह्माद्याः प्रास्तुवन् देवमृग्यजुःसामभिः शिवम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004320003, "chapter_id": 24320, "verse_number": "५-३-१४-४", "content_sanskrit": "संहर त्वं जगद्देव सदेवासुरमानुषम् ।\nप्राप्तो युगसहस्रान्तः कालः संहरणक्षमः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004320004, "chapter_id": 24320, "verse_number": "५-३-१४-५", "content_sanskrit": "मद्रूपं तु समास्थाय त्वया चैतद्विनिर्मितम् ।\nवैष्णवीं मूर्तिमास्थाय त्वयैतत्परिपालितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004320005, "chapter_id": 24320, "verse_number": "५-३-१४-६", "content_sanskrit": "एका मूर्तिस्त्रिधा जाता ब्राह्मी शैवी च वैष्णवी ।\nसृष्टिसंहाररक्षार्थं भवेदेवं महेश्वर॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004320006, "chapter_id": 24320, "verse_number": "५-३-१४-७", "content_sanskrit": "एतच्छ्रुत्वा वचस्तथ्यं विष्णोश्च परमेष्ठिनः ।\nसगणः सपरीवारः सह ताभ्यां सहोमया॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004320007, "chapter_id": 24320, "verse_number": "५-३-१४-८", "content_sanskrit": "समलोकान्विभिद्येमान्भगवान्नीललोहितः ।\nभूराद्यब्रह्मलोकान्तं भित्त्वाण्डं परतः परम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004320008, "chapter_id": 24320, "verse_number": "५-३-१४-९", "content_sanskrit": "शैवं पदमजं दिव्यमाविशत्सह तैर्विभुः ।\nन तत्र वायुर्नाकाशं नाग्निस्तत्र न भूतलम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004320009, "chapter_id": 24320, "verse_number": "५-३-१४-१०", "content_sanskrit": "यत्र संतिष्ठे देव उमया सह शङ्करः ।\nन सूर्यो न ग्रहास्तत्र न ऋक्षाणि दिशस्तथा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004320010, "chapter_id": 24320, "verse_number": "५-३-१४-११", "content_sanskrit": "न लोकपाला न सुखं न च दुःखं नृपोत्तम॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004320011, "chapter_id": 24320, "verse_number": "५-३-१४-१२", "content_sanskrit": "ब्राह्मं पदं यत्कवयो वदन्ति शैवं पदं यत्कवयो वदन्ति ।\nक्षेत्रज्ञमीशं प्रवदन्ति चान्ये सांख्याश्च गायन्ति किलादिमोक्षम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004320012, "chapter_id": 24320, "verse_number": "५-३-१४-१३", "content_sanskrit": "यद्ब्रह्म आद्यं प्रवदन्ति केचिद्यं सर्वमीशानमजं पुराणम् ।\nतमेकरूपं तमनेकरूपमरूपमाद्यं परमव्ययाख्यम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004320013, "chapter_id": 24320, "verse_number": "५-३-१४-१४", "content_sanskrit": "अवर्णमप्यर्थमनामगोत्रं तुर्यं पदं यत्कवयो वदन्ति ।\nध्यानार्थविज्ञानमयं सुसूक्ष्ममात्मस्थमीशानवरं वरेण्यम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004320014, "chapter_id": 24320, "verse_number": "५-३-१४-१५", "content_sanskrit": "ततस्त्रयस्ते भगवन्तमीशं सम्प्राप्य संक्षिप्य भवन्त्यर्थकम् ।\nपृथक्स्वरूपैस्तु पुनस्त एव जगत्समस्तं परिपालयन्ति॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004320015, "chapter_id": 24320, "verse_number": "५-३-१४-१६", "content_sanskrit": "संहारं सर्वभूतानां रुद्रत्वे कुरुते प्रभुः ।\nविष्णुत्वे पालयेल्लोकान्ब्रह्मत्वे सृष्टिकारकः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004320016, "chapter_id": 24320, "verse_number": "५-३-१४-१७", "content_sanskrit": "प्रकृत्या सह संयुक्तः कालो भूत्वा महेश्वरः ।\nविश्वरूपा महाभागा तस्य पार्श्वे व्यवस्थिता॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004320017, "chapter_id": 24320, "verse_number": "५-३-१४-१८", "content_sanskrit": "यामाहुः प्रकृतिं तज्ज्ञाः पदार्थानां विचक्षणाः ।\nपुरुषत्वे प्रकृतित्वे च कारणं परमेश्वरः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004320018, "chapter_id": 24320, "verse_number": "५-३-१४-१९", "content_sanskrit": "तस्मादेतज्जगत्सर्वं चराचरम् ।\nतस्मिन्नेव लयं याति युगान्ते समुपस्थिते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004320019, "chapter_id": 24320, "verse_number": "५-३-१४-२०", "content_sanskrit": "भगलिङ्गाङ्कितं सर्वं व्याप्तं वै परमेष्ठिना ।\nभगरूपो भवेद्विष्णुर्लिङ्गरूपो महेश्वरः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004320020, "chapter_id": 24320, "verse_number": "५-३-१४-२१", "content_sanskrit": "भाति सर्वेषु लोकेषु गीयते भूर्भुवादिषु ।\nप्रविष्टः सर्वभूतेषु तेन विष्णुर्भगः स्मृतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004320021, "chapter_id": 24320, "verse_number": "५-३-१४-२२", "content_sanskrit": "विशनाद्विष्णुरित्युक्तः सर्वदेवमयो महान् ।\nभासनाद्गमनाच्चैव भगसंज्ञा प्रकीर्तिता॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004320022, "chapter_id": 24320, "verse_number": "५-३-१४-२३", "content_sanskrit": "ब्रह्मादिस्तम्बपर्यन्तं यस्मिन्नेति लयं जगत् ।\nएकभावं समापन्नं लिङ्गं तस्माद्विदुर्बुधाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004320023, "chapter_id": 24320, "verse_number": "५-३-१४-२४", "content_sanskrit": "महादेवस्ततो देवीमाह पार्श्वे स्थितां तदा ।\nसंहरस्व जगत्सर्वं मा विलम्बस्व शोभने॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004320024, "chapter_id": 24320, "verse_number": "५-३-१४-२५", "content_sanskrit": "त्यज सौम्यमिदं रूपं सितचन्द्रांशुनिर्मलम् ।\nरुद्रं रूपं समास्थाय संहरस्व चराचरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004320025, "chapter_id": 24320, "verse_number": "५-३-१४-२६", "content_sanskrit": "रौद्रैर्भूतगणैर्घोरैर्देवि त्वं परिवारिता ।\nजीवलोकमिमं सर्वं भक्षयस्वाम्बुजेक्षणे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004320026, "chapter_id": 24320, "verse_number": "५-३-१४-२७", "content_sanskrit": "ततोऽहं मर्दयिष्यामि प्लावयिष्ये तथा जगत् ।\nकृत्वा चैकार्णवं भूयः सुखं स्वप्स्ये त्वया सह॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004320027, "chapter_id": 24320, "verse_number": "५-३-१४-२८", "content_sanskrit": "श्रीदेव्युवाच ।\nनाहं देव जगच्चैतत्संहरामि महाद्युते ।\nअम्बा भूत्वा विचेष्टं न भक्षयामि भृशातुरम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004320028, "chapter_id": 24320, "verse_number": "५-३-१४-२९", "content_sanskrit": "स्त्रीस्वभावेन कारुण्यं करोति हृदयं मम ।\nकथं वै निर्दहिष्यामि जगदेतज्जगत्पते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004320029, "chapter_id": 24320, "verse_number": "५-३-१४-३०", "content_sanskrit": "तस्मात्त्वं स्वयमेवेदं जगत्संहर शङ्कर ।\nअथैवमुक्तस्तां देवीं धूर्जटिर्नीललोहितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004320030, "chapter_id": 24320, "verse_number": "५-३-१४-३१", "content_sanskrit": "क्रुद्धो निर्भर्त्सयामास हुङ्कारेण महेश्वरीम् ।\nॐ हुंफट्त्वं स इत्याह कोपाविष्टैरथेक्षणैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004320031, "chapter_id": 24320, "verse_number": "५-३-१४-३२", "content_sanskrit": "हुंकारिता विशालाक्षी पीनोरुजघनस्थला ।\nतत्क्षणाच्चाभवद्रौद्रा कालरात्रीव भारत॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004320032, "chapter_id": 24320, "verse_number": "५-३-१४-३३", "content_sanskrit": "हुंकुर्वती महानादैर्नादयन्ती दिशो दश ।\nव्यवर्धत महारौद्रा विद्युत्सौदामिनी यथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004320033, "chapter_id": 24320, "verse_number": "५-३-१४-३४", "content_sanskrit": "विद्युत्सम्पातदुष्प्रेक्ष्या विद्युत्संघातचञ्चला ।\nविद्युज्ज्वालाकुला रौद्रा विद्युदग्निनिभेक्षणा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004320034, "chapter_id": 24320, "verse_number": "५-३-१४-३५", "content_sanskrit": "मुक्तकेशी विशालाक्षी कृशग्रीवा कृशोदरी ।\nव्याघ्रचर्माम्बरधरा व्यालयज्ञोपवीतिनी॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004320035, "chapter_id": 24320, "verse_number": "५-३-१४-३६", "content_sanskrit": "वृश्चिकैरग्निपुञ्जाभैर्गोनसैश्च विभूषिता ।\nत्रैलोक्यं पूरयामास विस्तारेणोच्छ्रयेण च॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004320036, "chapter_id": 24320, "verse_number": "५-३-१४-३७", "content_sanskrit": "भासुराङ्गा तु संवृत्ता कृष्णसर्पैककुण्डला ।\nचित्रदण्डोद्यतकरा व्याघ्रचर्मोपसेविता॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004320037, "chapter_id": 24320, "verse_number": "५-३-१४-३८", "content_sanskrit": "व्यवर्धत महारौद्रा जगत्संहारकारिणी ।\nसृक्किणी लेलिहाना च क्रूरफूत्कारकारिणी॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004320038, "chapter_id": 24320, "verse_number": "५-३-१४-३९", "content_sanskrit": "व्यात्तास्या घुर्घुरारावा जगत्संक्षोभकारिणी ।\nखेलद्भूतानुगा क्रूरा निःश्वासोच्छ्वासकारिणी॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004320039, "chapter_id": 24320, "verse_number": "५-३-१४-४०", "content_sanskrit": "जाताट्टअहासा दुर्नासा वह्निकुण्डसमेक्षणा ।\nप्रोद्यत्किलकिलारावा ददाह सकलं जगत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004320040, "chapter_id": 24320, "verse_number": "५-३-१४-४१", "content_sanskrit": "दह्यमानाः सुरास्तत्र पतन्ति धरणीतले ।\nपतन्ति यक्षगन्धर्वाः सकिन्नरमहोरगाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004320041, "chapter_id": 24320, "verse_number": "५-३-१४-४२", "content_sanskrit": "पतन्ति भूतसङ्घाश्च हाहाहैहैविराविणः ।\nबुम्बापातैः सनिर्घातैरुदितार्तस्वरैरपि॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004320042, "chapter_id": 24320, "verse_number": "५-३-१४-४३", "content_sanskrit": "व्याप्तमासीत्तदा विश्वं त्रैलोक्यं सचराचरम् ।\nसंपतद्भिः पतद्भिश्च ज्वलद्भूतगणैर्मही॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004320043, "chapter_id": 24320, "verse_number": "५-३-१४-४४", "content_sanskrit": "जातैश्चटचटाशब्दैः पतद्भिर्गिरिसानुभिः ।\nतत्र रौद्रोत्सवे जाता रुद्रानन्दविवर्धिनी॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004320044, "chapter_id": 24320, "verse_number": "५-३-१४-४५", "content_sanskrit": "विहिंसमाना भूतानि चर्वमाणाचरानपि ।\nतत्तद्गन्धमुपादाय शिवारावविराविणी॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004320045, "chapter_id": 24320, "verse_number": "५-३-१४-४६", "content_sanskrit": "गलच्छोणितधाराभिमुखा दिग्धकलेवरा ।\nचण्डशीलाभवच्चण्डी जगत्संहारकर्मणि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004320046, "chapter_id": 24320, "verse_number": "५-३-१४-४७", "content_sanskrit": "येऽपि प्राप्ता महर्लोकं भृग्वाद्याश्च महर्षयः ।\nतेऽपि नश्यन्ति शतशो ब्रह्मक्षत्त्रविशादयः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004320047, "chapter_id": 24320, "verse_number": "५-३-१४-४८", "content_sanskrit": "देवासुरा भयत्रस्ताः सयक्षोरगराक्षसाः ।\nविशन्ति केऽपि पातालं लीयन्ते च गुहादिषु॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004320048, "chapter_id": 24320, "verse_number": "५-३-१४-४९", "content_sanskrit": "सा च देवी दिशः सर्वा व्याप्य मृत्युरिव स्थिता ।\nयुगक्षयकरे काले देवेन विनियोजिता॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004320049, "chapter_id": 24320, "verse_number": "५-३-१४-५०", "content_sanskrit": "एकापि नवधा जाता दशधा दशधा तथा ।\nचतुःषष्टिस्वरूपा च शतरूपाट्टहासिनी॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004320050, "chapter_id": 24320, "verse_number": "५-३-१४-५१", "content_sanskrit": "जज्ञे सहस्ररूपा च लक्षकोटितनुः शिवा ।\nनानारूपायुधाकारा नानावादनचारिणी॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004320051, "chapter_id": 24320, "verse_number": "५-३-१४-५२", "content_sanskrit": "एवंरूपाऽभवद्देवी शिवस्यानुज्ञया नृप ।\nदिक्षु सर्वासु गगने विकटायुधशीलिनः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004320052, "chapter_id": 24320, "verse_number": "५-३-१४-५३", "content_sanskrit": "रुन्धन्तो नश्यमानांस्तान्गणा माहेश्वराः स्थिताः ।\nविचरन्ति तया सार्द्धं शूलपट्टिशपाणयः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004320053, "chapter_id": 24320, "verse_number": "५-३-१४-५४", "content_sanskrit": "ततो मातृगणाः केचिद्विनायकगणैः सह ।\nव्यवर्धन्त महारौद्रा जगत्संहारकारिणः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004320054, "chapter_id": 24320, "verse_number": "५-३-१४-५५", "content_sanskrit": "ततस्तस्या व्यवर्धन्त दंष्ट्राः कुन्देन्दुसन्निभाः ।\nयोजनानां सहस्राणि अयुतान्यर्बुदानि च॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004320055, "chapter_id": 24320, "verse_number": "५-३-१४-५६", "content_sanskrit": "दंष्ट्रावलिः कररुहाः क्रूरास्तीक्ष्णाश्च कर्कशाः ।\nवियद्दिशो लिखन्त्येव सप्तद्वीपां वसुंधराम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004320056, "chapter_id": 24320, "verse_number": "५-३-१४-५७", "content_sanskrit": "तस्या दंष्ट्राभिसम्पातैश्चूर्णिता वनपर्वताः ।\nशिलासंचयसंघाता विशीर्यते सहस्रशः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004320057, "chapter_id": 24320, "verse_number": "५-३-१४-५८", "content_sanskrit": "हिमवान्हेमकूटश्च निषधो गन्धमादनः ।\nमाल्यवांश्चैव नीलश्च श्वेतश्चैव महागिरिः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004320058, "chapter_id": 24320, "verse_number": "५-३-१४-५९", "content_sanskrit": "मेरुमध्यमिलापीठं सप्तद्वीपं च सार्णवम् ।\nलोकालोकेन सहितं प्राकम्पत नृपोत्तम॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004320059, "chapter_id": 24320, "verse_number": "५-३-१४-६०", "content_sanskrit": "दंष्ट्राशनिविस्पृष्टाश्च विशीर्यन्ते महाद्रुमाः ।\nउत्पातैश्च दिशो व्याप्ता घोररूपैः समन्ततः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004320060, "chapter_id": 24320, "verse_number": "५-३-१४-६१", "content_sanskrit": "तारा ग्रहगणाः सर्वे ये च वैमानिका गणाः ।\nशिवासहस्रैराकीर्णा महामातृगणैस्तथा॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004320061, "chapter_id": 24320, "verse_number": "५-३-१४-६२", "content_sanskrit": "सा चचार जगत्कृत्स्नं युगान्ते समुपस्थिते ।\nभ्रमद्भिश्च ब्रुवद्भिश्च क्रोशद्भिश्च समन्ततः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004320062, "chapter_id": 24320, "verse_number": "५-३-१४-६३", "content_sanskrit": "प्रमथद्भिर्ज्वलद्भिश्च रौद्रैर्व्याप्ता दिशो दश ।\nविस्तीर्णं शैलसङ्घातं विघूर्णितगिरिद्रुमम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004320063, "chapter_id": 24320, "verse_number": "५-३-१४-६४", "content_sanskrit": "प्रभिन्नगोपुरद्वारं केशशुष्कास्थिसंकुलम् ।\nप्रदग्धग्रामनगरं भस्मपुंजाभिसंवृतम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004320064, "chapter_id": 24320, "verse_number": "५-३-१४-६५", "content_sanskrit": "चिताधूमाकुलं सर्वं त्रैलोक्यं सचराचरम् ।\nहाहाकाराकुलं सर्वमहहस्वननिस्वनम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004320065, "chapter_id": 24320, "verse_number": "५-३-१४-६६", "content_sanskrit": "जगदेतदभूत्सर्वमशरण्यं निराश्रयम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]