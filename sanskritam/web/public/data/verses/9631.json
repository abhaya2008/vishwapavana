[{"id": 5000631000, "chapter_id": 9631, "verse_number": "७-९६-१", "content_sanskrit": "तस्यां रजन्यां व्युष्टायां यज्ञवाटगतो नृपः ।\nऋषीन्सर्वान्महातेजाः शब्दापयति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000631001, "chapter_id": 9631, "verse_number": "७-९६-२", "content_sanskrit": "वसिष्ठो वामदेवश्च जाबालिरथ काश्यपः ।\nविश्वामित्रो दीर्घतपा दुर्वासाश्च महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000631002, "chapter_id": 9631, "verse_number": "७-९६-३", "content_sanskrit": "पुलस्त्यो ऽपि तथा शक्तिर्भार्गवश्चैव वामनः ।\nमार्कण्डेयश्च दीर्घायुर्मौद्गल्यश्च महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000631003, "chapter_id": 9631, "verse_number": "७-९६-४", "content_sanskrit": "गर्गश्च च्यवनश्चैव शतानन्दश्च धर्मवित् ।\nभरद्वाजश्च तेजस्वी ह्यग्निपुत्रश्च सुप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000631004, "chapter_id": 9631, "verse_number": "७-९६-५", "content_sanskrit": "नारदः पर्वतश्चैव गौतमश्च महायशाः ।\nकात्यायनः सुयज्ञश्च ह्यगस्त्यस्तपसां निधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000631005, "chapter_id": 9631, "verse_number": "७-९६-६", "content_sanskrit": "एते चान्ये च बहवो मुनयः संशितव्रताः ।\nकौतूहलसमाविष्टाः सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000631006, "chapter_id": 9631, "verse_number": "७-९६-७", "content_sanskrit": "राक्षसाश्च महावीर्या वानराश्च महाबलाः ।\nसर्व एव समाजग्मुर्महात्मानः कुतूहलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000631007, "chapter_id": 9631, "verse_number": "७-९६-८", "content_sanskrit": "क्षत्रिया ये च शूद्राश्च वैश्याश्चैव सहस्रशः ।\nनानादेशगताश्चैव ब्राह्मणाः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000631008, "chapter_id": 9631, "verse_number": "७-९६-९", "content_sanskrit": "ज्ञाननिष्ठाः कर्मनिष्ठाः योगनिष्ठास्तथापरे ।\nसीताशपथवीक्षार्थं सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000631009, "chapter_id": 9631, "verse_number": "७-९६-१०", "content_sanskrit": "तदा समागतं सर्वमश्मभूतमिवाचलम् ।\nश्रुत्वा मुनिवरस्तूर्णं ससीतः समुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000631010, "chapter_id": 9631, "verse_number": "७-९६-११", "content_sanskrit": "तमृषिं पृष्ठतः सीता त्वन्वगच्छदवाङ्मुखी ।\nकृताञ्जलिर्बाष्पगला कृत्वा रामं मनोगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000631011, "chapter_id": 9631, "verse_number": "७-९६-१२", "content_sanskrit": "दृष्ट्वा श्रुतिमिवायान्तीं ब्रह्माणमनुगामिनीम् ।\nवाल्मीकेः पृष्ठतः सीतां साधुवादो महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000631012, "chapter_id": 9631, "verse_number": "७-९६-१३", "content_sanskrit": "ततो हलहलाशब्दः सर्वेषामेवमाबभौ ।\nदुःखजन्मविशालेन शोकेनाकुलितात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000631013, "chapter_id": 9631, "verse_number": "७-९६-१४", "content_sanskrit": "साधु रामेति केचित्तु साधु सीतेति चापरे ।\nउभावेव च तत्रान्ये प्रेक्षकाः सम्प्रचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000631014, "chapter_id": 9631, "verse_number": "७-९६-१५", "content_sanskrit": "ततो मध्ये जनौघस्य प्रविश्य मुनिपुङ्गवः ।\nसीतासहायो वाल्मीकिरिति होवाच राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000631015, "chapter_id": 9631, "verse_number": "७-९६-१६", "content_sanskrit": "इयं दाशरथे सीता सुव्रता धर्मचारिणी ।\nअपवादैः परित्यक्ता ममाश्रमसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000631016, "chapter_id": 9631, "verse_number": "७-९६-१७", "content_sanskrit": "लोकापवादभीतस्य तव राम महाव्रत ।\nप्रत्ययं दास्यते सीता तदनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000631017, "chapter_id": 9631, "verse_number": "७-९६-१८", "content_sanskrit": "इमौ तु जानकीपुत्रावुभौ च यमजातकौ ।\nसुतौ तवैव दुर्धर्षौ सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000631018, "chapter_id": 9631, "verse_number": "७-९६-१९", "content_sanskrit": "प्रचेतसो ऽहं दशमः पुत्रो राघवनन्दन ।\nन स्मराम्यनृतं वाक्यमिमौ तु तव पुत्रकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000631019, "chapter_id": 9631, "verse_number": "७-९६-२०", "content_sanskrit": "बहुवर्षसहस्राणि तपश्चर्या मया कृता ।\nनोपाश्नीयां फलं तस्या दुष्टेयं यदि मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000631020, "chapter_id": 9631, "verse_number": "७-९६-२१", "content_sanskrit": "मनसा कर्मणा वाचा भूतपूर्वं न किल्बिषम् ।\nतस्याः फलमुपाश्नीयामपापा मैथिली यदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000631021, "chapter_id": 9631, "verse_number": "७-९६-२२", "content_sanskrit": "अहं पञ्चसु भूतेषु मनष्षष्ठेषु राघव ।\nविचिन्त्य सीतां शुद्धेति जग्राह वननिर्झरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000631022, "chapter_id": 9631, "verse_number": "७-९६-२३", "content_sanskrit": "इयं शुद्धसमाचारा अपापा पतिदेवता ।\nलोकापवादभीतस्य प्रत्ययं तव दास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000631023, "chapter_id": 9631, "verse_number": "७-९६-२४", "content_sanskrit": "तस्मादियं नरवरात्मज शुद्धभावा दिव्येन दृष्टिविषयेण तदा प्रविष्टा ।\nलोकापवादकलुषीकृतचेतसा या त्यक्ता त्वया प्रियतमा विदिता ऽपि शुद्धा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000631024, "chapter_id": 9631, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षण्णवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]