[{"id": 2157101, "chapter_id": 4406, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157102, "chapter_id": 4406, "verse_number": "१", "content_sanskrit": "सेनापतित्वं सम्प्राप्य द्रोणो हर्षमुपेयिवान् ।\nमध्ये सैन्यस्य राजानमिदं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157103, "chapter_id": 4406, "verse_number": "२", "content_sanskrit": "यत् कौरवाणामृषभादापगेयादनन्तरम् ।\nसेनापत्येन मां राजन्नद्य सत्कृतवानसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157104, "chapter_id": 4406, "verse_number": "३", "content_sanskrit": "अनुरूपं फलं तस्य कर्मणो लभ्यतां त्वया ।\nसदृशं कर्मणस्तस्य फलमाप्नुहि पार्थिव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157105, "chapter_id": 4406, "verse_number": "", "content_sanskrit": "करोमि कामं कं तेऽद्य प्रवृणीष्व यमिच्छसि \t॥४॥\nसञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157106, "chapter_id": 4406, "verse_number": "५", "content_sanskrit": "ततो दुर्योधनो राजा कर्णदुःशासनादिभिः ।\nसम्मन्त्र्योवाच दुर्धर्षमाचार्यं जयतां वरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157107, "chapter_id": 4406, "verse_number": "६", "content_sanskrit": "ददासि चेद् वरं मह्यं जीवग्राहं युधिष्ठिरम् ।\nगृहीत्वा रथिनां श्रेष्ठं मत्सकाशमिहानय\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157108, "chapter_id": 4406, "verse_number": "७", "content_sanskrit": "इच्छेयं वै महाराजं धर्मात्मानं युधिष्ठिरम् ।\nभ्रातॄणां पश्यतामेव जीवग्राहेण मे द्विज\nप्रीणाम्यनेन कार्येण ससुहृज्जनबान्धवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157109, "chapter_id": 4406, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157110, "chapter_id": 4406, "verse_number": "८", "content_sanskrit": "ततः कुरूणामाचार्यः श्रुत्वा पुत्रस्य ते वचः ।\nसेनां प्रहर्षयन् सर्वामिदं वचनमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157111, "chapter_id": 4406, "verse_number": "९", "content_sanskrit": "धन्यः कुन्तीसुतो राजन् यस्य ग्रहणमिच्छसि ।\nन वधं तस्य दुर्धर्ष वरमद्य प्रयाचसे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157112, "chapter_id": 4406, "verse_number": "१०", "content_sanskrit": "किमर्थं च नरव्याघ्र न वधं तस्य काङ्क्षसे \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157113, "chapter_id": 4406, "verse_number": "११", "content_sanskrit": "नाशंससे क्रियामेतां मयि दुर्योधन ध्रुवम् ।\nआहोस्विद् धर्मराजस्य द्वेष्टा कश्चिन्न विद्यते\nतमिच्छसि त्वं जीवन्तं कुलं रक्षसि चात्मनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157114, "chapter_id": 4406, "verse_number": "१२", "content_sanskrit": "अथवा भरतश्रेष्ठ निर्जित्य युधि पाण्डवान् ।\nराज्यांशं प्रति दत्वा च सौभ्रात्रं कर्तुमिच्छसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157115, "chapter_id": 4406, "verse_number": "१३", "content_sanskrit": "धन्यः कुन्तीसुतो राजा सुजाता तस्य धीमतः ।\nअजातशत्रुता यस्य येन संस्निह्यते भवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157116, "chapter_id": 4406, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157117, "chapter_id": 4406, "verse_number": "१४", "content_sanskrit": "द्रोणेन चैवमुक्तस्य तव पुत्रस्य भारत ।\nसहसा निःसृतो भावो योऽस्य नित्यं प्रवर्तते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157118, "chapter_id": 4406, "verse_number": "१५", "content_sanskrit": "नाकारो गूहितुं शक्यो बृहस्पतिसमैरपि ।\nतस्मात् तव सुतो राजन् प्रहृष्टो वाक्यमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157119, "chapter_id": 4406, "verse_number": "१६", "content_sanskrit": "वधे कुन्तीसुतस्याजावाचार्य न जयो मम ।\nहते युधिष्ठिरे पार्थो हन्यान् सर्वान् हि नो ध्रुवम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157120, "chapter_id": 4406, "verse_number": "१७", "content_sanskrit": "नैव शक्यो रणे सर्वैर्निहन्तुममरैरपि \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157121, "chapter_id": 4406, "verse_number": "१८", "content_sanskrit": "यदि सर्वे हनिष्यन्ते पाण्डवाः ससुता मृधे ।\nततः कृत्स्नं वशे कृत्वा निःशेषं नृपमण्डलम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157122, "chapter_id": 4406, "verse_number": "१९", "content_sanskrit": "ससागरवनां स्फीतां विजित्य वसुधामिमाम् ।\nविष्णुर्दास्यति कृष्णायै कुन्त्यै वा पुरुषोत्तमः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157123, "chapter_id": 4406, "verse_number": "२०", "content_sanskrit": "यद्येष चैषां शेषः स्यात् स एवास्मान्न शेषयेत् ।\nसत्यप्रतिज्ञे त्वानीते पुनर्द्यूतेन निर्जिते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2157124, "chapter_id": 4406, "verse_number": "२१", "content_sanskrit": "तस्मिन् जीवति चानीते ह्युपायैर्बहुभिः कृतैः ।\nपुनर्यास्यन्त्यरण्याय कौन्तेयास्तमनुव्रताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2157125, "chapter_id": 4406, "verse_number": "२२", "content_sanskrit": "सोऽयं मम जयो नित्यो दीर्घकालं भविष्यति ।\nअतो न वधमिच्छामि धर्मराजस्य कर्हिचित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2157126, "chapter_id": 4406, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2157127, "chapter_id": 4406, "verse_number": "२३", "content_sanskrit": "तस्य जिह्ममभिप्रायं ज्ञात्वा द्रोणोऽर्थतत्त्ववित् ।\nतं वरं सान्तरं तस्मै ददौ सञ्चिन्त्य बुद्धिमान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2157128, "chapter_id": 4406, "verse_number": "२४", "content_sanskrit": "न चेद् युधिष्ठिरं वीरः पालयेदर्जुनो युधि ।\nमन्यस्व पाण्डवश्रेष्ठमानीतं वशमात्मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2157129, "chapter_id": 4406, "verse_number": "२५", "content_sanskrit": "न हि पार्थो रणे यत्तः शक्यो देवासुरैरपि ।\nप्रत्युद्यातुमतस्तात नैतस्माद्धर्षयाम्यहम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2157130, "chapter_id": 4406, "verse_number": "२६", "content_sanskrit": "असंशयं स शिष्यो मे मत्पूर्वः शस्त्रकर्मणि ।\nतरुणः सुकृती युक्त एकायनगतश्च सः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2157131, "chapter_id": 4406, "verse_number": "२७", "content_sanskrit": "अस्त्राणीन्द्राच्च रुद्राच्च भूयांसि समवाप्तवान् ।\nअमर्षितश्च ते राजन् सततं मर्षयाम्यहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2157132, "chapter_id": 4406, "verse_number": "२८", "content_sanskrit": "स त्वपक्रम्यतां युद्धाद् येनोपायेन शक्यते ।\nअपनीते ततः पार्थे धर्मराजो जितस्त्वया\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2157133, "chapter_id": 4406, "verse_number": "२९", "content_sanskrit": "ग्रहणं हि वधात् तस्य धर्मराजस्य मन्यसे ।\nअनेनैवाभ्युपायेन ध्रुवं ग्रहणमेष्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2157134, "chapter_id": 4406, "verse_number": "३०", "content_sanskrit": "अहं गृहीत्वा राजानं सत्यवादिनमाहवे ।\nआनयिष्यामि ते राजन् वशमद्य न संशयः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2157135, "chapter_id": 4406, "verse_number": "३१", "content_sanskrit": "यदि स्थास्यति सङ्ग्रामे मुहूर्तमपि मेऽग्रतः ।\nअपनीते नरव्याघ्रे कुन्तीपुत्रे धनञ्जये\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2157136, "chapter_id": 4406, "verse_number": "३२", "content_sanskrit": "फल्गुनस्य समक्षं तु नहि शक्यो युधिष्ठिरः ।\nग्रहीतुं समरे राजन् सेन्द्रैरपि सुरासुरैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2157137, "chapter_id": 4406, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2157138, "chapter_id": 4406, "verse_number": "३३", "content_sanskrit": "एवमुक्ते तदा तस्मिन् युद्धे देवासुरोपमे ।\nसान्तरं तु प्रतिज्ञाते राज्ञो द्रोणेन निग्रहे\nगृहीतमेवामन्यन्त तव पुत्राः सुबालिशाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2157139, "chapter_id": 4406, "verse_number": "३४", "content_sanskrit": "ततो दुर्योधनश्चापि ग्रहणं पाण्डवस्य तत् ।\nस्कन्धावरेषु सर्वेषु यथास्थानेषु मारिष\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2157140, "chapter_id": 4406, "verse_number": "३५", "content_sanskrit": "सैन्यस्थानेषु सर्वेषु घोषयामास पार्थिवः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2157141, "chapter_id": 4406, "verse_number": "३६", "content_sanskrit": "पाण्डवेषु च सापेक्षं द्रोणं जानाति ते सुतः ।\nततः प्रतिज्ञास्थैर्यार्थं स मन्त्रो बहुलीकृतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2157142, "chapter_id": 4406, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि एकादशोऽध्यायः ॥ ११ ॥\nद्रोणाभिषेकपर्वणि एकादशोऽध्यायः ॥ ११ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]