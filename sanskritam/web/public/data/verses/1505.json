[{"id": 2023577, "chapter_id": 1505, "verse_number": "३-१४३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023578, "chapter_id": 1505, "verse_number": "३-१४३-१", "content_sanskrit": "भीमसेनयमौ चोभौ पाञ्चालि च निबोधत।\nनास्ति भूतस्य नाशो वै पश्यतास्मान्वनेचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023579, "chapter_id": 1505, "verse_number": "३-१४३-२", "content_sanskrit": "दुर्बलाः क्लेशिताः स्मेति यद्ब्रुवामेतरेतरम्।\nअशक्येऽपि व्रजामो यद्नंजयदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023580, "chapter_id": 1505, "verse_number": "३-१४३-३", "content_sanskrit": "तन्मे दहति गात्राणि तूलराशिमिवानलः।\nयच्च वीरं न पश्यामि धनंजयमुपान्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023581, "chapter_id": 1505, "verse_number": "३-१४३-४", "content_sanskrit": "तस्यादर्शनतप्तं मां सानुजं वनमास्थितम्।\nयाज्ञसेन्याः परामर्शः स च वीर दहत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023582, "chapter_id": 1505, "verse_number": "३-१४३-५", "content_sanskrit": "नकुलात्पूर्वजं पार्थं न पश्याम्यमितौजसम्।\nअजेयमुग्रधन्वानं तेन तप्ये वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023583, "chapter_id": 1505, "verse_number": "३-१४३-६", "content_sanskrit": "तीर्थानि चैव रम्याणि वनानि च सरांसि च।\nचरामि सह युष्माभिस्तस्य दर्शनकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023584, "chapter_id": 1505, "verse_number": "३-१४३-७", "content_sanskrit": "पञ्चवर्षाण्यहं वीरं सत्यसन्धं धनंजयम्।\nयन्न पश्यामि बीभत्सुं तेन तप्ये वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023585, "chapter_id": 1505, "verse_number": "३-१४३-८", "content_sanskrit": "तं वै श्यामं गुडाकेशं सिंहविक्रान्तगामिनम्।\nन पश्यामि महाबाहुं तेन तप्ये वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023586, "chapter_id": 1505, "verse_number": "३-१४३-९", "content_sanskrit": "कृतास्त्रं निपुणं युद्देऽव्रतिमानं धनुष्मताम्।\nन पश्यामि कुरुश्रेष्ठ तेन तप्ये वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023587, "chapter_id": 1505, "verse_number": "३-१४३-१०", "content_sanskrit": "चरन्तमरिसङ्घेषु क्रुद्धं कालमिवानघ।\nप्रभिन्नमिव मातङ्गं सिंहस्कन्धं धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023588, "chapter_id": 1505, "verse_number": "३-१४३-११", "content_sanskrit": "यः स शक्रादनवरो वीर्येण च बलेन च।\nयमयोः पूर्वजः पार्थः श्वेताश्वोऽमितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023589, "chapter_id": 1505, "verse_number": "३-१४३-१२", "content_sanskrit": "`नारायणसमो युद्धे सत्यसन्धो दृढव्रतः।\nतं ममापश्यतो भीम न शान्तिर्हृदयस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023590, "chapter_id": 1505, "verse_number": "३-१४३-१३", "content_sanskrit": "दुःखेन महताऽऽविष्टश्चिन्तयामि दिवानिशम्।\nअजेयमुग्रधन्वानं तेन तप्ये वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023591, "chapter_id": 1505, "verse_number": "३-१४३-१४", "content_sanskrit": "सततं यः क्षमाशीलः क्षिप्यमाणोऽप्यणीयसा।\nऋजुमार्गप्रपन्नस्य शर्मदाता भयस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023592, "chapter_id": 1505, "verse_number": "३-१४३-१५", "content_sanskrit": "स तु जिह्मप्रवृत्तस्य माययाऽभिजिघांसतः।\nअपि वज्रधरस्यापि भवेत्कालविषोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023593, "chapter_id": 1505, "verse_number": "३-१४३-१६", "content_sanskrit": "शत्रोरपि प्रपन्नस्य सोऽनृशंसः प्रतापवान्।\nदाताऽभयस् बीभत्सुरमितात्मा महाहलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023594, "chapter_id": 1505, "verse_number": "३-१४३-१७", "content_sanskrit": "सर्वेषामाश्रयोऽस्माकं रणेऽरीणां प्रमर्दिता।\nआहर्ता सर्वरत्नानां सर्वेषां नः सुखावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023595, "chapter_id": 1505, "verse_number": "३-१४३-१८", "content_sanskrit": "रत्नानि यस्य वीर्येण दिव्यान्यासत्पुरा मम।\nबहूनि बहुजातीनि यानि प्राप्तः सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023596, "chapter_id": 1505, "verse_number": "३-१४३-१९", "content_sanskrit": "यस्य बाहुबलाद्वीर सभा चासीत्पुरा मम।\nसर्वरत्नमयी ख्याता त्रिषु लोकेषु पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023597, "chapter_id": 1505, "verse_number": "३-१४३-२०", "content_sanskrit": "वासुदेवसमं वीर्ये कार्तवीर्यसमं युधि।\nअजेयममितं युद्धे तं न पश्यामि फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023598, "chapter_id": 1505, "verse_number": "३-१४३-२१", "content_sanskrit": "संकर्षणं महावीर्यं त्वां च भीमापराजितम्।\nअनुयातः स्ववीर्येण वासुदेवं च शत्रुहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023599, "chapter_id": 1505, "verse_number": "३-१४३-२२", "content_sanskrit": "यस् बाहुबले तुल्यः प्रभावे च पुरंदरः।\nजवे वायुर्मुखे सोमः क्रोधे मृत्युः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023600, "chapter_id": 1505, "verse_number": "३-१४३-२३", "content_sanskrit": "ते वयं तं नरव्याघ्रं सर्वेवीर दिदृक्षवः।\nप्रवेक्ष्यामो महाबाहो पर्वतं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023601, "chapter_id": 1505, "verse_number": "३-१४३-२४", "content_sanskrit": "विशाला बदरी यत्रनरनारायणाश्रमः।\nतं सदाऽध्युषितं यक्षैर्द्रक्ष्यामो गिरिसुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023602, "chapter_id": 1505, "verse_number": "३-१४३-२५", "content_sanskrit": "कुबेरनलिनीं रम्यां राक्षसैरभिसेविताम्।\nपद्भिरेव गमिष्यामस्तप्यभाना महत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023603, "chapter_id": 1505, "verse_number": "३-१४३-२६", "content_sanskrit": "नातप्ततपसा शक्यो गन्तुं देशो वृकोदर।\nन नृशंसेन लुब्धेन नाप्रशान्तेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023604, "chapter_id": 1505, "verse_number": "३-१४३-२७", "content_sanskrit": "तत्र सर्वेगमिष्यामो भीमार्जुपदैषिणः।\nसायुधा बद्धनिस्त्रिंशाः सार्धं विप्रैर्महाव्रतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023605, "chapter_id": 1505, "verse_number": "३-१४३-२८", "content_sanskrit": "मक्षिकादंशमशकान्सिंहान्व्याघ्रान्सरीसृपान्।\nप्राप्नोत्यनियतः पार्थ नियतस्तान्न पश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023606, "chapter_id": 1505, "verse_number": "३-१४३-२९", "content_sanskrit": "ते वयं नियतात्मानः पर्वतं गन्धमादनम्।\nप्रवेक्ष्यामो मिताहारा धनंजयदिदृक्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023607, "chapter_id": 1505, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि त्रिचत्वारिंशदधिकशततमोऽध्यायः ॥ १४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]