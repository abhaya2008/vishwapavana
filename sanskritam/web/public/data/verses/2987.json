[{"id": 2093199, "chapter_id": 2987, "verse_number": "१३-११७-१", "content_sanskrit": "`*युधिष्ठिर उवाच।\nसुराणामसुराणां च भूतानां च पितामह।\nप्रभुः स्रष्टा च भगवान्मुनिभिः स्तूयते भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093200, "chapter_id": 2987, "verse_number": "१३-११७-२", "content_sanskrit": "तस्योपरि कथं ह्येष गोलोकः स्थानतां गतः।\nसंशयो मे महानेष तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093201, "chapter_id": 2987, "verse_number": "१३-११७-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093202, "chapter_id": 2987, "verse_number": "१३-११७-३", "content_sanskrit": "मनोवाग्बुद्धयस्तावदेकस्थाः कुरुसत्तम।\nततो मे शृणु कार्त्स्न्येन गोमहाभाग्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093203, "chapter_id": 2987, "verse_number": "१३-११७-४", "content_sanskrit": "पुण्यं यशस्यमायुष्यं तथा स्वस्त्ययनं महत्।\nकीर्तिर्विहरता लोके गवां यो गोषु भक्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093204, "chapter_id": 2987, "verse_number": "१३-११७-५", "content_sanskrit": "श्रूयते हि पुराणेषु महर्षीणां महात्मनाम्।\nसंस्थाने सर्वलोकानां देवानां चापि सम्भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093205, "chapter_id": 2987, "verse_number": "१३-११७-६", "content_sanskrit": "देवतार्थेऽमृतार्थे च यज्ञार्थे चैव भारत।\nसुरभिर्नाम विख्याता रोहिणी कामरूपिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093206, "chapter_id": 2987, "verse_number": "१३-११७-७", "content_sanskrit": "सङ्कल्प्य मनसा पूर्वं रोहिणी ह्यमृतात्मना।\nघोरं तपः समास्थाय निर्मिती विस्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093207, "chapter_id": 2987, "verse_number": "१३-११७-८", "content_sanskrit": "पुरुषं चासृजद्भूस्तेजसा तपसा च ह।\nदेदीप्यमानं वपुषा समिद्धमिव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093208, "chapter_id": 2987, "verse_number": "१३-११७-९", "content_sanskrit": "सोऽपश्यदिष्टरूपां तां सुरभिं रोहिणीं तदा।\nदृष्ट्वैव चातिविमनाः सोऽभवत्काममोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093209, "chapter_id": 2987, "verse_number": "१३-११७-१०", "content_sanskrit": "तं कामार्तमथो ज्ञात्वा स्वयंभूर्लोकभावनः।\nमाऽऽर्तो भव तथा चैष भगवानभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093210, "chapter_id": 2987, "verse_number": "१३-११७-११", "content_sanskrit": "ततः स भगवांस्तत्र मार्ताण्ड इति विश्रुतः।\nचकार नाम तं दृष्ट्वा तस्यार्तीभावमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093211, "chapter_id": 2987, "verse_number": "१३-११७-१२", "content_sanskrit": "सोऽददाद्भगवांस्तस्मै मार्ताण्डाय महात्मने।\nसुरूपां सुरभिं कन्यां तपस्तेजोमयीं शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093212, "chapter_id": 2987, "verse_number": "१३-११७-१३", "content_sanskrit": "यथा मयैष चोद्भूतस्त्वं चैवषा च रोहिणी।\nमैथुनं गतवन्तौ च तथा चोत्पत्स्यति प्रजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093213, "chapter_id": 2987, "verse_number": "१३-११७-१४", "content_sanskrit": "प्रजा भविष्यते पुण्या पवित्रं परमं च वाम्।\nन चाप्यगम्यागमनाद्दोषं प्राप्स्यसि कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093214, "chapter_id": 2987, "verse_number": "१३-११७-१५", "content_sanskrit": "त्वत्प्रजासम्भवं क्षीरं भविष्यति परं हविः।\nयज्ञेषु चाज्यभागानां त्वत्प्रजामूलजो विधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093215, "chapter_id": 2987, "verse_number": "१३-११७-१६", "content_sanskrit": "प्रजाशुश्रूषवश्चैव ये भविष्यन्ति रोहिणि।\nतव तेनैव पुण्येनि गोलोकं यान्तु मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093216, "chapter_id": 2987, "verse_number": "१३-११७-१७", "content_sanskrit": "इदं पवित्रं परममृषभं नाम कर्हिचित्।\nयद्वै ज्ञात्वा द्विजा लोके मोक्ष्यन्ते योनिसङ्करात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093217, "chapter_id": 2987, "verse_number": "१३-११७-१८", "content_sanskrit": "एतत्क्रियाः प्रवर्तन्ते मन्त्रब्राह्मणसंस्कृताः।\nदेवतानां वितॄणां च हव्यकव्यपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093218, "chapter_id": 2987, "verse_number": "१३-११७-१९", "content_sanskrit": "तत एतेन पुण्येन प्रजास्तव तु रोहिणि।\nऊर्ध्वं ममापि लोकस्य वत्स्यन्ते निरुपद्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093219, "chapter_id": 2987, "verse_number": "१३-११७-२०", "content_sanskrit": "भद्रं तेभ्यश्च भद्रं ते ये प्रजासु भवन्ति वै।\nयुगन्धराश्च ते पुत्राः सन्तु लोकस्य धारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093220, "chapter_id": 2987, "verse_number": "१३-११७-२१", "content_sanskrit": "यान्यान्कामयसे लोकांस्ताँल्लोकाननुयास्यसि।\nसर्वदेवगणश्चैव तव यास्यन्ति पुत्रताम्।\nतव स्तनसमुद्भूतं पिबन्तोऽमृतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093221, "chapter_id": 2987, "verse_number": "१३-११७-२२", "content_sanskrit": "एवमेतान्वरान्सर्वानगृह्णात्सुरभिस्तदा।\nब्रुवतः सर्वलोकेशान्निर्वृतिं चागमत्पराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093222, "chapter_id": 2987, "verse_number": "१३-११७-२३", "content_sanskrit": "सृष्ट्वा प्रजाश्च विपुला लोकसन्धारणाय वै।\nब्रह्मणा समनुज्ञाता सुरभिर्लोकमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093223, "chapter_id": 2987, "verse_number": "१३-११७-२४", "content_sanskrit": "एवं वरप्रदानेन स्वयंभोरेव भारत।\nउपरिष्टाद्गवां लोकः प्रोक्तस्ते सर्वमादितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093224, "chapter_id": 2987, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तदशाधिकशततमोऽध्यायः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]