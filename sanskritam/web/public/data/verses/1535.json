[{"id": 2024941, "chapter_id": 1535, "verse_number": "३-१७३-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024942, "chapter_id": 1535, "verse_number": "३-१७३-१", "content_sanskrit": "ततोऽश्मवर्षं सुमहत्प्रादुरासीत्समन्ततः।\nनगमात्रैः शिलाखण्डैस्तन्मां दृढमपीडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024943, "chapter_id": 1535, "verse_number": "३-१७३-२", "content_sanskrit": "तदहं वज्रसंकाशैः शरैरिनद्रास्त्रचोदितैः।\nअचूर्णयं वेगवद्भिः शतधैकैकमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024944, "chapter_id": 1535, "verse_number": "३-१७३-३", "content_sanskrit": "चूर्ण्यमानेऽश्मवर्षे तु यावकः समजायत।\nतत्राश्मचूर्णा न्यपतन्पावकप्रकरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024945, "chapter_id": 1535, "verse_number": "३-१७३-४", "content_sanskrit": "ततोऽश्मवर्षे विहते जलवर्षं महत्तरम्।\nधाराभिरक्षमात्राभिः प्रादुरासीनममान्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024946, "chapter_id": 1535, "verse_number": "३-१७३-५", "content_sanskrit": "नभस प्रच्युता धारास्तिग्मवीर्याः सहस्रशः।\nआवृण्वन्सर्वतो व्योम दिशश्चोपदिशस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024947, "chapter_id": 1535, "verse_number": "३-१७३-६", "content_sanskrit": "धाराणां च निपातेन वायोर्विष्फूर्जितेन च।\nगर्जितेन च मेघानां न प्राज्ञायत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024948, "chapter_id": 1535, "verse_number": "३-१७३-७", "content_sanskrit": "धारा दिवि च संबद्धा वसुधायां च सर्वशः।\nव्यामोहयन्त मां तत्रनिपतन्त्योऽनिशं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024949, "chapter_id": 1535, "verse_number": "३-१७३-८", "content_sanskrit": "तत्रोपदिष्टमिन्द्रेण दिव्यमस्त्रं विशोषणम्।\nदीप्तं प्राहिणवं घोरमशुप्यत्तेन तज्जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024950, "chapter_id": 1535, "verse_number": "३-१७३-९", "content_sanskrit": "हतेऽश्मवर्षे च मया जलवर्षे च शोषिते।\nमुमुचुर्दानवा मायामग्निं वायुं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024951, "chapter_id": 1535, "verse_number": "३-१७३-१०", "content_sanskrit": "ततोऽहमग्निं व्यधमं सलिलास्त्रेण सर्वशः।\nशैलेन च महास्त्रेण वायोरवेगमधारयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024952, "chapter_id": 1535, "verse_number": "३-१७३-११", "content_sanskrit": "तस्यां प्रतिहतायां ते दानवा युद्धदुर्मदाः।\nप्राकुर्वन्विविधां मायां यौगपद्येन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024953, "chapter_id": 1535, "verse_number": "३-१७३-१२", "content_sanskrit": "ततो वर्षं प्रादुरभूत्सुमहद्रोमहर्षणम्।\nअस्त्राणां घोररूपाणामग्नेर्वायोस्तथाऽश्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024954, "chapter_id": 1535, "verse_number": "३-१७३-१३", "content_sanskrit": "सा तु मायामयी वृष्टिः पीडयामास मां युधि।\nअथ घोरं तमस्तीव्रं प्रादुरासीत्समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024955, "chapter_id": 1535, "verse_number": "३-१७३-१४", "content_sanskrit": "तमसा संवृतेलोके घोरेण परुषेण च।\nहरयो विमुखाश्चासन्प्रास्खलच्चापि मातलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024956, "chapter_id": 1535, "verse_number": "३-१७३-१५", "content_sanskrit": "हस्ताद्धिरण्मयश्चास्य प्रतोदः प्रापतद्भुवि।\nअसकृच्चाह मां भीतः किं करिष्याव इत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024957, "chapter_id": 1535, "verse_number": "३-१७३-१६", "content_sanskrit": "मां च भीराविशत्तीव्रा तस्मिन्विगतचेतसि।\nस च मां विगतज्ञानः संत्रस्तमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024958, "chapter_id": 1535, "verse_number": "३-१७३-१७", "content_sanskrit": "सुराणामसुराणां च संग्रामः सुमहानभूत्।\nअमृतार्थं पुरा पार्त स च दृष्टो मयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024959, "chapter_id": 1535, "verse_number": "३-१७३-१८", "content_sanskrit": "शम्बरस्य वधे घोरः संग्रामः सुमहानभूत्।\nसारथ्यं देवराजस्य तत्रापि कृतवानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024960, "chapter_id": 1535, "verse_number": "३-१७३-१९", "content_sanskrit": "तथैव वृत्रस्य वधे संगृहीता हया मया।\nवैरोचनेर्मया युद्धं दृष्टं चापि सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024961, "chapter_id": 1535, "verse_number": "३-१७३-२०", "content_sanskrit": "एते मया महाघोरः संग्रामाः पर्युपासिताः।\nन चापि विगतज्ञानो भूतपूर्वोस्मि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024962, "chapter_id": 1535, "verse_number": "३-१७३-२१", "content_sanskrit": "पितामहेन संहारः प्रजानां विहितो ध्रुवम्।\nन हि युद्धमिदं युक्तमन्यत्र जगतः क्षयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024963, "chapter_id": 1535, "verse_number": "३-१७३-२२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा संस्तभ्यात्मानमात्मना।\nमोहयिष्यन्दानवानामहं मायाबलं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024964, "chapter_id": 1535, "verse_number": "३-१७३-२३", "content_sanskrit": "अब्रुवं मातलिं भीतं पश्य मे बुजयोर्बलम्।\nअस्त्राणां च प्रभावं वै धनुषो गाण्डिवस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024965, "chapter_id": 1535, "verse_number": "३-१७३-२४", "content_sanskrit": "अद्यास्त्रमाययैतैषां मायामेतां सुदारुणाम्।\nविनिहन्मि तमश्चोग्रं मा भैः सूत स्तिरो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024966, "chapter_id": 1535, "verse_number": "३-१७३-२५", "content_sanskrit": "एवमुक्त्वाहमसृजमस्त्रमायां नराधिप।\nमोहनीं सर्वभूतानां हिताय त्रिदिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024967, "chapter_id": 1535, "verse_number": "३-१७३-२६", "content_sanskrit": "पीड्यमानासु मायासु तासु तास्वसुरोत्तमाः।\nपुनर्बहुविधा मायाः प्राकुर्वन्नमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024968, "chapter_id": 1535, "verse_number": "३-१७३-२७", "content_sanskrit": "पुनः प्रकाशमभवत्तमसा ग्रस्यते पुनः।\nभवत्यदर्शनो लोकः पुनरप्सु निमज्जति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024969, "chapter_id": 1535, "verse_number": "३-१७३-२८", "content_sanskrit": "सुसंगृहीतैर्हरिभिः प्रकाशे सति मातलिः।\nव्यचरत्स्यन्दनाग्र्येण संग्रामे रोमहर्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024970, "chapter_id": 1535, "verse_number": "३-१७३-२९", "content_sanskrit": "ततः पर्यपतन्नुग्रा निवातकवचा मयि।\nतानहं विवरं दृष्ट्वा प्राहण्वं यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024971, "chapter_id": 1535, "verse_number": "", "content_sanskrit": "वर्तमाने तथा युद्धे निवातकवचान्तके।\nनापश्यं सहसा सर्वान्दानवान्मायया वृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]