[{"id": 5000035000, "chapter_id": 9035, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000035001, "chapter_id": 9035, "verse_number": "१-३५-१", "content_sanskrit": "उपास्य रात्रिशेषं तु शोणाकूले महर्षिभिः ।\nनिशायां सुप्रभातायां विश्वामित्रोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000035002, "chapter_id": 9035, "verse_number": "१-३५-२", "content_sanskrit": "सुप्रभाता निशा राम पूर्वा संध्या प्रवर्तते ।\nउत्तिष्ठोत्तिष्ठ भद्रं ते गमनायाभिरोचय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000035003, "chapter_id": 9035, "verse_number": "१-३५-३", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य कृतपूर्वाह्णिकक्रियः ।\nगमनं रोचयामास वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000035004, "chapter_id": 9035, "verse_number": "१-३५-४", "content_sanskrit": "अयं शोणः शुभजलोऽगाधः पुलिनमण्डितः ।\nकतरेण पथा ब्रह्मन् संतरिष्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000035005, "chapter_id": 9035, "verse_number": "१-३५-५", "content_sanskrit": "एवमुक्तस्तु रामेण विश्वामित्रोऽब्रवीदिदम् ।\nएष पन्था मयोद्दिष्टो येन यान्ति महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000035006, "chapter_id": 9035, "verse_number": "१-३५-६", "content_sanskrit": "एवमुक्ता महर्षयो विश्वामित्रेण धीमता ।\nपश्यन्तस्ते प्रयाता वै वनानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000035007, "chapter_id": 9035, "verse_number": "१-३५-७", "content_sanskrit": "ते गत्वा दूरमध्वानं गतेऽर्धदिवसे तदा ।\nजाह्नवीं सरितां श्रेष्ठां ददृशुर्मुनिसेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000035008, "chapter_id": 9035, "verse_number": "१-३५-८", "content_sanskrit": "तां दृष्ट्वा पुण्यसलिलां हंससारससेविताम् ।\nबभूवुर्मुनयः सर्वे मुदिताः सहराघवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000035009, "chapter_id": 9035, "verse_number": "१-३५-९", "content_sanskrit": "तस्यास्तीरे तदा सर्वे चक्रुर्वासपरिग्रहम् ।\nततः स्नात्वा यथान्यायं संतर्प्य पितृदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000035010, "chapter_id": 9035, "verse_number": "१-३५-१०", "content_sanskrit": "हुत्वा चैवाग्निहोत्राणि प्राश्य चामृतवद्धविः ।\nविविशुर्जाह्नवीतीरे शुभा मुदितमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000035011, "chapter_id": 9035, "verse_number": "१-३५-११", "content_sanskrit": "विश्वामित्रं महात्मानं परिवार्य समन्ततः ।\nविष्ठिताश्च यथान्यायं राघवौ च यथार्हतः ।\nसंप्रहृष्टमना रामो विश्वामित्रमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000035012, "chapter_id": 9035, "verse_number": "१-३५-१२", "content_sanskrit": "भगवञ्छ्रोतुमिच्छामि गङ्गां त्रिपथगां नदीम् ।\nत्रैलोक्यं कथमाक्रम्य गता नदनदीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000035013, "chapter_id": 9035, "verse_number": "१-३५-१३", "content_sanskrit": "चोदितो रामवाक्येन विश्वामित्रो महामुनिः ।\nवृद्धिं जन्म च गङ्गाया वक्तुमेवोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000035014, "chapter_id": 9035, "verse_number": "१-३५-१४", "content_sanskrit": "शैलेन्द्रो हिमवान् राम धातूनामाकरो महान् ।\nतस्य कन्याद्वयं राम रूपेणाप्रतिमं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000035015, "chapter_id": 9035, "verse_number": "१-३५-१५", "content_sanskrit": "या मेरुदुहिता राम तयोर्माता सुमध्यमा ।\nनाम्ना मेना मनोज्ञा वै पत्नी हिमवतः प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000035016, "chapter_id": 9035, "verse_number": "१-३५-१६", "content_sanskrit": "तस्यां गङ्गेयमभवज्ज्येष्ठा हिमवतः सुता ।\nउमा नाम द्वितीयाभूत् कन्या तस्यैव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000035017, "chapter_id": 9035, "verse_number": "१-३५-१७", "content_sanskrit": "अथ ज्येष्ठां सुराः सर्वे देवकार्यचिकीर्षया ।\nशैलेन्द्रं वरयामासुर्गङ्गां त्रिपथगां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000035018, "chapter_id": 9035, "verse_number": "१-३५-१८", "content_sanskrit": "ददौ धर्मेण हिमवांस्तनयां लोकपावनीम् ।\nस्वच्छन्दपथगां गङ्गां त्रैलोक्यहितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000035019, "chapter_id": 9035, "verse_number": "१-३५-१९", "content_sanskrit": "प्रतिगृह्य त्रिलोकार्थं त्रिलोकहितकांक्षिणः ।\nगङ्गामादाय तेऽगच्छन् कृतार्थेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000035020, "chapter_id": 9035, "verse_number": "१-३५-२०", "content_sanskrit": "या चान्या शैलदुहिता कन्याऽसीद् रघुनन्दन ।\nउग्रं सुव्रतमास्थाय तपस्तेपे तपोधना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000035021, "chapter_id": 9035, "verse_number": "१-३५-२१", "content_sanskrit": "उग्रेण तपसा युक्तां ददौ शैलवरः सुताम् ।\nरुद्रायाप्रतिरूपाय उमां लोकनमस्कृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000035022, "chapter_id": 9035, "verse_number": "१-३५-२२", "content_sanskrit": "एते ते शैलराजस्य सुते लोकनमस्कृते ।\nगङ्गा च सरितां श्रेष्ठा उमादेवी च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000035023, "chapter_id": 9035, "verse_number": "१-३५-२३", "content_sanskrit": "एतत् ते सर्वमाख्यातं यथा त्रिपथगामिनी ।\nखं गता प्रथमं तात गतिं गतिमतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000035024, "chapter_id": 9035, "verse_number": "१-३५-२४", "content_sanskrit": "सैषा सुरनदी रम्या शैलेन्द्रतनया तदा ।\nसुरलोकं समारूढा विपापा जलवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000035025, "chapter_id": 9035, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]