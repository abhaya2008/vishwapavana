[{"id": 900009151, "chapter_id": 8731, "verse_number": "21.1", "content_sanskrit": "किञ्च स्थूलमुत्पन्नं, स्थूलं नष्टं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009152, "chapter_id": 8731, "verse_number": "21.2", "content_sanskrit": "किं च यथा द्रव्ये सत्येव पाकेन नीलरक्तरूपयोर्नाशोत्पादौ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009153, "chapter_id": 8731, "verse_number": "21.3", "content_sanskrit": "किं च तत्समवेतस्य तुदत्पत्तेः पूर्वं तन्नाशानन्तरं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009154, "chapter_id": 8731, "verse_number": "21.4", "content_sanskrit": "अपिच– महापातकादिना ब्राह्मणत्वादिजातिनाशेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009155, "chapter_id": 8731, "verse_number": "21.5", "content_sanskrit": "भिन्नाश्च भिन्नधर्माश्च पदार्था अखिला अपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009156, "chapter_id": 8731, "verse_number": "21.6", "content_sanskrit": "ऐतेन लाघवाज्जातिरेकैवेति निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]