[{"id": 6000254000, "chapter_id": 10254, "verse_number": null, "content_sanskrit": "अथ अष्टपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000254001, "chapter_id": 10254, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.001.m4a", "display_order": 2}, {"id": 6000254002, "chapter_id": 10254, "verse_number": "१०-५८-१", "content_sanskrit": "वैदर्भ्याः स तु सन्देशं निशम्य यदुनन्दनः।\nप्रगृह्य पाणिना पाणिं प्रहसन् द्विजमब्रवीत्॥ १०/५८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णः विदर्भान् प्रति अगमत्", "range": "१–६"}]}, {"id": 6000254003, "chapter_id": 10254, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.003.m4a", "display_order": 4}, {"id": 6000254004, "chapter_id": 10254, "verse_number": "१०-५८-२", "content_sanskrit": "तथाऽहमपि तच्चित्तो निद्रां नाध्यगमं निशि।\nवेदाहं रुग्मिणा द्वेषान्ममोद्वाहो निवारितः॥ १०/५८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.004.m4a", "display_order": 5}, {"id": 6000254005, "chapter_id": 10254, "verse_number": "१०-५८-३", "content_sanskrit": "तामानयिष्य उन्मथ्य राजन्यापसदान् मृधे।\nमत्परामनवद्याङ्गीमेधसोऽग्नेः शिखामिव॥ १०/५८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.005.m4a", "display_order": 6}, {"id": 6000254006, "chapter_id": 10254, "verse_number": "१०-५८-४", "content_sanskrit": "उद्वाहर्क्षं च विज्ञाय रुग्मिण्या मधुसूदनः।\nरथः संयुज्यतामाशु दारुकेत्याह सारथिम्॥ १०/५८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.006.m4a", "display_order": 7}, {"id": 6000254007, "chapter_id": 10254, "verse_number": "१०-५८-५", "content_sanskrit": "स चाश्वैः शैब्यसुग्रीवमेघपुष्पबलाहकैः।\nयुक्तं रथमुपानीय तस्थौ प्राञ्जलिरग्रतः॥ १०/५८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.007.m4a", "display_order": 8}, {"id": 6000254008, "chapter_id": 10254, "verse_number": "१०-५८-६", "content_sanskrit": "आरुह्य स्यन्दनं शौरिर्द्विजमारोप्य तूर्णगैः।\nआनर्तादेकरात्रेण विदर्भानगमद्धयैः॥ १०/५८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.008.m4a", "display_order": 9}, {"id": 6000254009, "chapter_id": 10254, "verse_number": "१०-५८-७", "content_sanskrit": "राजा स कुण्डिनपतिः पुत्रस्नेहवशंगतः।\nशिशुपालाय स्वां कन्यां दास्यन् कार्याण्यकारयत्॥ १०/५८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.009.m4a", "display_order": 10, "topics": [{"text": "रुग्मिणीविवाहे सर्वे राजानः कृष्णं वारयितुं सन्नद्धाः", "range": "७–२०"}]}, {"id": 6000254010, "chapter_id": 10254, "verse_number": "१०-५८-८", "content_sanskrit": "पुरं सम्मृष्टसंसिक्तमार्गरथ्याचतुष्पथम्।\nचित्रध्वजपताकाभिस्तोरणैः समलङ्कृतम्॥ १०/५८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.010.m4a", "display_order": 11}, {"id": 6000254011, "chapter_id": 10254, "verse_number": "१०-५८-९", "content_sanskrit": "स्रग्गन्धमाल्याभरणैर्विरजाम्बरभूषणैः।\nजुष्टं स्‍त्रीपुरुषैः श्रीमद्‍गृहैरगरुधूपितैः॥ १०/५८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.011.m4a", "display_order": 12}, {"id": 6000254012, "chapter_id": 10254, "verse_number": "१०-५८-१०", "content_sanskrit": "पितृृन् देवान् समभ्यर्च्य विप्रांश्च विधिवन्नृपः।\nभोजयित्वा यथान्यायं वाचयामास मङ्गलम्॥ १०/५८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.012.m4a", "display_order": 13}, {"id": 6000254013, "chapter_id": 10254, "verse_number": "१०-५८-११", "content_sanskrit": "सुस्नाता सुदती कन्या कृतकौतुकमङ्गला।\nअहतांशुकयुग्मेन भूषिता भूषणोत्तमैः॥ १०/५८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.013.m4a", "display_order": 14}, {"id": 6000254014, "chapter_id": 10254, "verse_number": "१०-५८-१२", "content_sanskrit": "चक्रुः सामर्ग्यजुर्मन्त्रैर्वध्वा रक्षां द्विजोत्तमाः।\nपुरोहितोऽथर्वमन्त्रैर्जुहाव ग्रहशान्तये॥ १०/५८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.014.m4a", "display_order": 15}, {"id": 6000254015, "chapter_id": 10254, "verse_number": "१०-५८-१३", "content_sanskrit": "हिरण्यरूप्यवासांसि तिलांश्च गुडमिश्रितान्।\nप्रादाद् धेनूश्च विप्रेभ्यो राजा विधिविदां वरः॥ १०/५८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.015.m4a", "display_order": 16}, {"id": 6000254016, "chapter_id": 10254, "verse_number": "१०-५८-१४", "content_sanskrit": "एवं चेदिपती राजा दमघोषः सुताय वै।\nकारयामास मन्त्रज्ञैः सर्वमभ्युदयोचितम्॥ १०/५८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.016.m4a", "display_order": 17}, {"id": 6000254017, "chapter_id": 10254, "verse_number": "१०-५८-१५", "content_sanskrit": "मदच्युद्भिर्गजानीकैः स्यन्दनैर्हेममालिभिः।\nपत्त्यश्वसङ्कुलैः सैन्यैः परीतः कुण्डिनं ययौ॥ १०/५८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.017.m4a", "display_order": 18}, {"id": 6000254018, "chapter_id": 10254, "verse_number": "१०-५८-१६", "content_sanskrit": "तं वै विदर्भाधिपतिः समेत्याभिप्रपूज्य च।\nनिवेशयामास मुदा कल्पितान्यनिवेशने॥ १०/५८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.018.m4a", "display_order": 19}, {"id": 6000254019, "chapter_id": 10254, "verse_number": "१०-५८-१७", "content_sanskrit": "तत्र साल्वो जरासन्धो दन्तवक्रो विदूरथः।\nआजग्मुश्चैद्यपक्षीयाः पौण्ड्रकाद्याः सहस्रशः॥ १०/५८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.019.m4a", "display_order": 20}, {"id": 6000254020, "chapter_id": 10254, "verse_number": "१०-५८-१८", "content_sanskrit": "कृष्णरामद्विषो यत्ताः कन्यां चैद्याय साधितुम्।\nयद्यागत्य हरेत् कृष्णो रामाद्यैर्यदुभिर्वृतः॥ १०/५८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.020.m4a", "display_order": 21}, {"id": 6000254021, "chapter_id": 10254, "verse_number": "१०-५८-१९", "content_sanskrit": "योत्स्यामः सहिताः सर्वे इति निश्चितमानसाः।\nआजग्मुर्भूभुजः सर्वे समग्रबलवाहनाः॥ १०/५८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.021.m4a", "display_order": 22}, {"id": 6000254022, "chapter_id": 10254, "verse_number": "१०-५८-२०", "content_sanskrit": "श्रुत्वैतद् भगवान् रामो विपक्षीयनृपोद्यमम्।\nकृष्णं चैकं गतं हर्तुं कन्यां कलहशङ्कितः॥ १०/५८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.022.m4a", "display_order": 23}, {"id": 6000254023, "chapter_id": 10254, "verse_number": "१०-५८-२१", "content_sanskrit": "बलेन महता सार्धं भ्रातृस्नेहपरिप्लुतः।\nत्वरितः कुण्डिनं प्रायाद् गजाश्वरथपत्तिभिः॥ १०/५८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.023.m4a", "display_order": 24, "topics": [{"text": "कलहशङ्कितः बलरामः कुण्डिनपुरं प्रायात्", "range": "२१"}]}, {"id": 6000254024, "chapter_id": 10254, "verse_number": "१०-५८-२२", "content_sanskrit": "भीष्मकन्या वरारोहा काङ्क्षन्त्यागमनं हरेः।\nप्रत्यापत्तिमपश्यन्ती द्विजस्याचिन्तयत् तदा॥ १०/५८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.024.m4a", "display_order": 25}, {"id": 6000254025, "chapter_id": 10254, "verse_number": "१०-५८-२३", "content_sanskrit": "अहो त्रियामान्तरित उद्वाहो मेऽल्पराधसः।\nनागच्छत्यरविन्दाक्षो नाहं वेद्मत्र कारणम्॥ १०/५८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.025.m4a", "display_order": 26}, {"id": 6000254026, "chapter_id": 10254, "verse_number": "१०-५८-२४", "content_sanskrit": "सोऽपि नावर्ततेऽद्यापि मत्सन्देशहरो द्विजः।\nअपि मय्यनवद्यात्मा दृष्ट्वा किञ्चिज्जुगुप्सितम्॥ १०/५८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.026.m4a", "display_order": 27}, {"id": 6000254027, "chapter_id": 10254, "verse_number": "१०-५८-२५", "content_sanskrit": "मत्पाणिग्रहणे नूनं नायाति हि कृतोद्यमः।\nदुर्भगाया न मे भ्राता नानुकूलो महेश्वरः॥ १०/५८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.027.m4a", "display_order": 28}, {"id": 6000254028, "chapter_id": 10254, "verse_number": "१०-५८-२६", "content_sanskrit": "देवी वा विमुखा गौरी रुद्राणी गिरिजा सती। एवं चिन्तयती बाला गोविन्दहृतमानसा।\nन्यमीलयत कालज्ञा नेत्रे अश्रुकलाकुले॥ १०/५८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.028.m4a", "display_order": 29}, {"id": 6000254029, "chapter_id": 10254, "verse_number": "१०-५८-२७", "content_sanskrit": "एवं वध्वाः प्रतीक्षन्त्या गोविन्दागमनं नृप।\nवाम ऊरुर्भुजो नेत्रमस्फुरन् प्रियभाषिणः॥ १०/५८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.029.m4a", "display_order": 30}, {"id": 6000254030, "chapter_id": 10254, "verse_number": "१०-५८-२८", "content_sanskrit": "अथ कृष्णविनिर्दिष्टः स एव द्विजसत्तमः।\nअन्तःपुरचरां देवीं राजपुत्रीं ददर्श ह॥ १०/५८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.030.m4a", "display_order": 31}, {"id": 6000254031, "chapter_id": 10254, "verse_number": "१०-५८-२९", "content_sanskrit": "सा तं प्रहृष्टवदनमव्यग्रात्मगतिं सती।\nआलक्ष्य लक्षणाभिज्ञा तमपृच्छच्छुचिस्मिता॥ १०/५८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.031.m4a", "display_order": 32}, {"id": 6000254032, "chapter_id": 10254, "verse_number": "१०-५८-३०", "content_sanskrit": "आवेदयामास तस्यै सम्प्राप्तं यदुनन्दनम्।\nउक्तं च सत्यवचनमात्मोपनयनं प्रति॥ १०/५८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.032.m4a", "display_order": 33}, {"id": 6000254033, "chapter_id": 10254, "verse_number": "१०-५८-३१", "content_sanskrit": "तमागतं समाज्ञाय वैदर्भी हृष्टमानसा।\nन पश्यन्ती ब्राह्मणाय प्रियमन्यन्ननाम सा॥ १०/५८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.033.m4a", "display_order": 34}, {"id": 6000254034, "chapter_id": 10254, "verse_number": "१०-५८-३२", "content_sanskrit": "प्राप्तौ श्रुत्वा स्वदुहितुरुद्वाहप्रेक्षणोत्सुकौ।\nअभ्ययात् तूर्यघोषेण रामकृष्णौ समर्हणैः॥ १०/५८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.034.m4a", "display_order": 35}, {"id": 6000254035, "chapter_id": 10254, "verse_number": "१०-५८-३३", "content_sanskrit": "मधुपर्कमुपानीय वासांसि रुचिराणि सः।\nउपायनान्यभीष्टानि विधिवत् समपूजयत्॥ १०/५८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.035.m4a", "display_order": 36}, {"id": 6000254036, "chapter_id": 10254, "verse_number": "१०-५८-३४", "content_sanskrit": "तयोर्निवेशनं श्रीमदुपकल्प्य महामतिः।\nबाह्योद्याने कुण्डिनस्य यथायोगं सुविस्तृतम्॥ १०/५८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.036.m4a", "display_order": 37}, {"id": 6000254037, "chapter_id": 10254, "verse_number": "१०-५८-३५", "content_sanskrit": "आवेद्य पूर्णं नगरं जरासन्धादिभिर्नृपैः।\nससैन्ययोः सानुगयोरातिथ्यं विदधे यथा॥ १०/५८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.037.m4a", "display_order": 38}, {"id": 6000254038, "chapter_id": 10254, "verse_number": "१०-५८-३६", "content_sanskrit": "एवं राज्ञां समेतानां यथावीर्यं यथावयः।\nयथाबलं यथावित्तं सर्वैः कामैः समर्हयत्॥ १०/५८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.038.m4a", "display_order": 39}, {"id": 6000254039, "chapter_id": 10254, "verse_number": "१०-५८-३७", "content_sanskrit": "कृष्णमागतमाकर्ण्य विदर्भपुरवासिनः।\nआगत्य नेत्राञ्जलिभिः पपुस्तन्मुखपङ्कजम्॥ १०/५८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.039.m4a", "display_order": 40}, {"id": 6000254040, "chapter_id": 10254, "verse_number": "१०-५८-३८", "content_sanskrit": "अस्यैव भार्या भवितुं रुग्मिण्यर्हति नापरा।\nअसावप्यनवद्यात्मा भैष्म्याः समुचितः पतिः॥ १०/५८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.040.m4a", "display_order": 41}, {"id": 6000254041, "chapter_id": 10254, "verse_number": "१०-५८-३९", "content_sanskrit": "किञ्चित् सुचरितं यन्नस्तेन तुष्टस्‍त्रिलोककृत्।\nअनुगृह्णातु गृह्णातु वैदर्भ्याः पाणिमच्युतः॥ १०/५८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.041.m4a", "display_order": 42}, {"id": 6000254042, "chapter_id": 10254, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.042.m4a", "display_order": 43}, {"id": 6000254043, "chapter_id": 10254, "verse_number": "१०-५८-४०", "content_sanskrit": "एवं प्रेमकलाबद्धा वदन्ति स्म पुरौकसः।\nकन्या चान्तःपुरात् प्रागाद् भटैर्गुप्ताऽम्बिकालयम्॥ १०/५८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.043.m4a", "display_order": 44}, {"id": 6000254044, "chapter_id": 10254, "verse_number": "१०-५८-४१", "content_sanskrit": "पद्भ्यां विनिर्ययौ द्रष्टुं भवान्याः पादपङ्कजम्।\nसा चानुध्यायती सम्यङ् मुकुन्दचरणाम्बुजम्॥ १०/५८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.044.m4a", "display_order": 45}, {"id": 6000254045, "chapter_id": 10254, "verse_number": "१०-५८-४२", "content_sanskrit": "यतवाङ् मातृभिः सार्धं सखीभिः परिवारिता।\nगुप्ता राजभटैः शूरैः सन्नद्धैरुद्यतायुधैः॥ १०/५८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.045.m4a", "display_order": 46}, {"id": 6000254046, "chapter_id": 10254, "verse_number": "१०-५८-४३", "content_sanskrit": "वेत्रझर्झरहस्तैश्च वृद्धैः कञ्चुकिभिस्तथा।\nमृदङ्गशङ्खपणवांस्तूर्यभेरीश्च जघ्निरे॥ १०/५८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.046.m4a", "display_order": 47}, {"id": 6000254047, "chapter_id": 10254, "verse_number": "१०-५८-४४", "content_sanskrit": "नानोपहारबलिभिर्वारमुख्याः सहस्रशः।\nस्रग्गन्धवस्‍त्राभरणैर्द्विजपत्न्यः स्वलङ्कृताः॥ १०/५८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.047.m4a", "display_order": 48}, {"id": 6000254048, "chapter_id": 10254, "verse_number": "१०-५८-४५", "content_sanskrit": "गायन्तश्च स्तुवन्तश्च गायका वाद्यवादकाः।\nपरिवार्य वधूं जग्मुः सूतमागधवन्दिभिः॥ १०/५८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.048.m4a", "display_order": 49}, {"id": 6000254049, "chapter_id": 10254, "verse_number": "१०-५८-४६", "content_sanskrit": "आसाद्य देवसदनं धौतपादकराम्बुजा।\nउपस्पृश्य शुचिः शान्ता प्रविवेशाम्बिकान्तिकम्॥ १०/५८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.049.m4a", "display_order": 50, "topics": [{"text": "रुग्मिण्याः पूजादिकर्म", "range": "४६–५३"}]}, {"id": 6000254050, "chapter_id": 10254, "verse_number": "१०-५८-४७", "content_sanskrit": "तां वै प्रवयसो बालां विधिज्ञा विप्रयोषितः।\nभवानीं वन्दयाञ्चक्रुर्भवपत्नीं भवान्विताम्॥ १०/५८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.050.m4a", "display_order": 51}, {"id": 6000254051, "chapter_id": 10254, "verse_number": "१०-५८-४८", "content_sanskrit": "नमस्ये त्वाऽम्बिकेऽभीक्ष्णं स्वसन्तानयुतां शिवाम्।\nभूयात्पतिर्मे भगवान् कृष्णस्तदनुमोदताम्॥ १०/५८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.051.m4a", "display_order": 52}, {"id": 6000254052, "chapter_id": 10254, "verse_number": "१०-५८-४९", "content_sanskrit": "अद्भिर्गन्धाक्षतैर्धूपैर्वस्‍त्रमाल्यविभूषणैः।\nनानोपहारबलिभिः प्रदीपावलिभिः पृथक्॥ १०/५८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.052.m4a", "display_order": 53}, {"id": 6000254053, "chapter_id": 10254, "verse_number": "१०-५८-५०", "content_sanskrit": "विप्रस्‍त्रियः पतिमतीस्तथा तैः समपूजयत्।\nलवणापूपताम्बूलकण्ठसूत्रफलेक्षुभिः॥ १०/५८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.053.m4a", "display_order": 54}, {"id": 6000254054, "chapter_id": 10254, "verse_number": "१०-५८-५१", "content_sanskrit": "तस्यै स्‍त्रियस्ताः प्रददुः शेषा युयुजुराशिषः।\nताभ्यो देव्यै नमश्चक्रे शेषाश्च जगृहे वधूः॥ १०/५८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.054.m4a", "display_order": 55}, {"id": 6000254055, "chapter_id": 10254, "verse_number": "१०-५८-५२", "content_sanskrit": "मुनिव्रतमथ त्यक्त्वा निश्चक्रामाम्बिकागृहात्।\nउपकण्ठे सुरेशस्य पौलोम्याश्च निकेतनम्॥ १०/५८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.055.m4a", "display_order": 56}, {"id": 6000254056, "chapter_id": 10254, "verse_number": "१०-५८-५३", "content_sanskrit": "तौ विदर्भप्रसूतानां नृपाणां कुलदेवते।\nतदन्तिकमुपागम्य शचीं सुरपतिप्रियाम्॥ १०/५८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.056.m4a", "display_order": 57}, {"id": 6000254057, "chapter_id": 10254, "verse_number": "१०-५८-५४", "content_sanskrit": "चिराराधितापादाब्जां सा प्रणम्य विनिर्ययौ। प्रगृह्य पाणिना धात्रीं रत्नमुद्रोपशोभिना।\nधृतानेकातपत्राढ्या वीजच्चामरसङ्कुला॥ १०/५८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.057.m4a", "display_order": 58, "topics": [{"text": "कृष्णः रुग्मिणीं रथे समारोप्य ययौ", "range": "५४–६०"}]}, {"id": 6000254058, "chapter_id": 10254, "verse_number": "१०-५८-५५", "content_sanskrit": "तां देवमायामिव वीरमोहिनीं सुमध्यमां कुण्डलमण्डिताननाम्।\nश्यामां नितम्बार्पितरत्नमेखलां व्यञ्जत्स्तनां कुन्तलशङ्कितेक्षणाम्॥ १०/५८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.058.m4a", "display_order": 59}, {"id": 6000254059, "chapter_id": 10254, "verse_number": "१०-५८-५६", "content_sanskrit": "शुचिस्मितां बिम्बफलाधरद्युतिशोणायमानद्विजकुन्दकुड्मलाम्।\nपदा चलन्तीं कलहंसगामिनीं सिञ्जत्क्‍वणन्नूपुरपादशोभिताम्॥ १०/५८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.059.m4a", "display_order": 60}, {"id": 6000254060, "chapter_id": 10254, "verse_number": "१०-५८-५७", "content_sanskrit": "विलोक्य वीरा मुमुहुः समागता यशस्विनस्तत्कृतहृच्छयार्दिताः।\nयां वीक्ष्य ते नृपतयस्तदुदारहासव्रीडावलोकहृतचेतस उज्झितास्‍त्राः॥ १०/५८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.060.m4a", "display_order": 61}, {"id": 6000254061, "chapter_id": 10254, "verse_number": "१०-५८-५८", "content_sanskrit": "पेतुः क्षितौ गजरथाश्वगता विमूढा यात्राच्छलेन हरयेऽर्पयतीं स्वशोभाम्।\nसैवं शनैश्चलयती पदपद्मकोशैः प्राप्तिं तदा भगवतः प्रसमीक्षमाणा॥ १०/५८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.061.m4a", "display_order": 62}, {"id": 6000254062, "chapter_id": 10254, "verse_number": "१०-५८-५९", "content_sanskrit": "उत्सार्य वामकरजैरलकानपाङ्गैः प्राप्तह्रियैक्षत नृपान् ददृशेऽच्युतं सा।\nतां राजकन्यां रथमारुरुक्षतीं जहार कृष्णो द्विषतां समीक्षताम्॥ १०/५८/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.062.m4a", "display_order": 63}, {"id": 6000254063, "chapter_id": 10254, "verse_number": "१०-५८-६०", "content_sanskrit": "रथं समारोप्य सुपर्णलक्षणं राजन्यचक्रं परिभूय माधवः।\nततो ययौ रामपुरोगमैः शनैः सृगालमध्यादिव नागहृद्धरिः॥ १०/५८/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_058/BhP_10.058.063.m4a", "display_order": 64}, {"id": 6000254064, "chapter_id": 10254, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धेऽष्टपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]