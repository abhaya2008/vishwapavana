[{"id": 5000065000, "chapter_id": 9065, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000065001, "chapter_id": 9065, "verse_number": "१-६५-१", "content_sanskrit": "अथ हैमवतीं राम दिशं त्यक्त्वा महामुनिः।\nपूर्वां दिशमनुप्राप्य तपस्तेपे सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000065002, "chapter_id": 9065, "verse_number": "१-६५-२", "content_sanskrit": "मौनं वर्षसहस्रस्य कृत्वा व्रतमनुत्तमम्।\nचकाराप्रतिमं राम तपः परमदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000065003, "chapter_id": 9065, "verse_number": "१-६५-३", "content_sanskrit": "पूर्णे वर्षसहस्रे तु काष्ठभूतं महामुनिम्।\nविघ्नैर्बहुभिराधूतं क्रोधो नान्तरमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000065004, "chapter_id": 9065, "verse_number": "१-६५-४", "content_sanskrit": "स कृत्वा निश्चयं राम तप आतिष्ठताव्ययम्।\nतस्य वर्षसहस्रस्य व्रते पूर्णे महाव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000065005, "chapter_id": 9065, "verse_number": "१-६५-५", "content_sanskrit": "भोक्तुमारब्धवानन्नं तस्मिन् काले रघूत्तम।\nइन्द्रो द्विजातिर्भूत्वा तं सिद्धमन्नमयाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000065006, "chapter_id": 9065, "verse_number": "१-६५-६", "content_sanskrit": "तस्मै दत्त्वा तदा सिद्धं सर्वं विप्राय निश्चितः।\nनिःशेषितेऽन्ने भगवानभुक्त्वैव महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000065007, "chapter_id": 9065, "verse_number": "१-६५-७", "content_sanskrit": "न किंचिदवदद् विप्रं मौनव्रतमुपास्थितः।\nतथैवासीत् पुनर्मौनमनुच्छ्वासं चकार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000065008, "chapter_id": 9065, "verse_number": "१-६५-८", "content_sanskrit": "अथ वर्षसहस्रं च नोच्छ्वसन् मुनिपुंगवः।\nतस्यानुच्छ्वसमानस्य मूर्ध्नि धूमो व्यजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000065009, "chapter_id": 9065, "verse_number": "१-६५-९", "content_sanskrit": "त्रैलोक्यं येन सम्भ्रान्तमातापितमिवाभवत्।\nततो देवर्षिगन्धर्वाः पन्नगोरगराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000065010, "chapter_id": 9065, "verse_number": "१-६५-१०", "content_sanskrit": "मोहितास्तपसा तस्य तेजसा मन्दरश्मयः।\nकश्मलोपहताः सर्वे पितामहमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000065011, "chapter_id": 9065, "verse_number": "१-६५-११", "content_sanskrit": "बहुभिः कारणैर्देव विश्वामित्रो महामुनिः।\nलोभितः क्रोधितश्चैव तपसा चाभिवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000065012, "chapter_id": 9065, "verse_number": "१-६५-१२", "content_sanskrit": "नह्यस्य वृजिनं किंचिद् दृश्यते सूक्ष्ममप्युत।\nन दीयते यदि त्वस्य मनसा यदभीप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000065013, "chapter_id": 9065, "verse_number": "१-६५-१३", "content_sanskrit": "विनाशयति त्रैलोक्यं तपसा सचराचरम्।\nव्याकुलाश्च दिशः सर्वा न च किंचित् प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000065014, "chapter_id": 9065, "verse_number": "१-६५-१४", "content_sanskrit": "सागराः क्षुभिताः सर्वे विशीर्यन्ते च पर्वताः।\nप्रकम्पते च वसुधा वायुर्वातीह संकुलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000065015, "chapter_id": 9065, "verse_number": "१-६५-१५", "content_sanskrit": "ब्रह्मन् न प्रतिजानीमो नास्तिको जायते जनः।\nसम्मूढमिव त्रैलोक्यं सम्प्रक्षुभितमानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000065016, "chapter_id": 9065, "verse_number": "१-६५-१६", "content_sanskrit": "भास्करो निष्प्रभश्चैव महर्षेस्तस्य तेजसा।\nबुद्धिं न कुरुते यावन्नाशे देव महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000065017, "chapter_id": 9065, "verse_number": "१-६५-१७", "content_sanskrit": "तावत् प्रसादो भगवन्नग्निरूपो महाद्युतिः।\nकालाग्निना यथा पूर्वं त्रैलोक्यं दह्यतेऽखिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000065018, "chapter_id": 9065, "verse_number": "१-६५-१८", "content_sanskrit": "देवराज्यं चिकीर्षेत दीयतामस्य यन्मनः।\nततः सुरगणाः सर्वे पितामहपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000065019, "chapter_id": 9065, "verse_number": "१-६५-१९", "content_sanskrit": "विश्वामित्रं महात्मानं वाक्यं मधुरमब्रुवन्।\nब्रह्मर्षे स्वागतं तेऽस्तु तपसा स्म सुतोषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000065020, "chapter_id": 9065, "verse_number": "१-६५-२०", "content_sanskrit": "ब्राह्मण्यं तपसोग्रेण प्राप्तवानसि कौशिक।\nदीर्घमायुश्च ते ब्रह्मन् ददामि समरुद्‍गणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000065021, "chapter_id": 9065, "verse_number": "१-६५-२१", "content_sanskrit": "स्वस्ति प्राप्नुहि भद्रं ते गच्छ सौम्य यथासुखम्।\nपितामहवचः श्रुत्वा सर्वेषां त्रिदिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000065022, "chapter_id": 9065, "verse_number": "१-६५-२२", "content_sanskrit": "कृत्वा प्रणामं मुदितो व्याजहार महामुनिः।\nब्राह्मण्यं यदि मे प्राप्तं दीर्घमायुस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000065023, "chapter_id": 9065, "verse_number": "१-६५-२३", "content_sanskrit": "ॐकारोऽथ वषट्कारो वेदाश्च वरयन्तु माम्।\nक्षत्रवेदविदां श्रेष्ठो ब्रह्मवेदविदामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000065024, "chapter_id": 9065, "verse_number": "१-६५-२४", "content_sanskrit": "ब्रह्मपुत्रो वसिष्ठो मामेवं वदतु देवताः।\nयद्येवं परमः कामः कृतो यान्तु सुरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000065025, "chapter_id": 9065, "verse_number": "१-६५-२५", "content_sanskrit": "ततः प्रसादितो देवैर्वसिष्ठो जपतां वरः।\nसख्यं चकार ब्रह्मर्षिरेवमस्त्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000065026, "chapter_id": 9065, "verse_number": "१-६५-२६", "content_sanskrit": "ब्रह्मर्षिस्त्वं न संदेहः सर्वं सम्पद्यते तव।\nइत्युक्त्वा देवताश्चापि सर्वा जग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000065027, "chapter_id": 9065, "verse_number": "१-६५-२७", "content_sanskrit": "विश्वामित्रोऽपि धर्मात्मा लब्ध्वा ब्राह्मण्यमुत्तमम्।\nपूजयामास ब्रह्मर्षिं वसिष्ठं जपतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000065028, "chapter_id": 9065, "verse_number": "१-६५-२८", "content_sanskrit": "कृतकामो महीं सर्वां चचार तपसि स्थितः।\nएवं त्वनेन ब्राह्मण्यं प्राप्तं राम महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000065029, "chapter_id": 9065, "verse_number": "१-६५-२९", "content_sanskrit": "एष राम मुनिश्रेष्ठ एष विग्रहवांस्तपः।\nएष धर्मः परो नित्यं वीर्यस्यैष परायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000065030, "chapter_id": 9065, "verse_number": "१-६५-३०", "content_sanskrit": "एवमुक्त्वा महातेजा विरराम द्विजोत्तमः।\nशतानन्दवचः श्रुत्वा रामलक्ष्मणसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000065031, "chapter_id": 9065, "verse_number": "१-६५-३१", "content_sanskrit": "जनकः प्राञ्जलिर्वाक्यमुवाच कुशिकात्मजम्।\nधन्योऽस्म्यनुगृहीतोऽस्मि यस्य मे मुनिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000065032, "chapter_id": 9065, "verse_number": "१-६५-३२", "content_sanskrit": "यज्ञं काकुत्स्थसहितः प्राप्तवानसि कौशिक।\nपावितोऽहं त्वया ब्रह्मन् दर्शनेन महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000065033, "chapter_id": 9065, "verse_number": "१-६५-३३", "content_sanskrit": "गुणा बहुविधाः प्राप्तास्तव संदर्शनान्मया।\nविस्तरेण च वै ब्रह्मन् कीर्त्यमानं महत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000065034, "chapter_id": 9065, "verse_number": "१-६५-३४", "content_sanskrit": "श्रुतं मया महातेजो रामेण च महात्मना।\nसदस्यैः प्राप्य च सदः श्रुतास्ते बहवो गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000065035, "chapter_id": 9065, "verse_number": "१-६५-३५", "content_sanskrit": "अप्रमेयं तपस्तुभ्यमप्रमेयं च ते बलम्।\nअप्रमेया गुणाश्चैव नित्यं ते कुशिकात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000065036, "chapter_id": 9065, "verse_number": "१-६५-३६", "content_sanskrit": "तृप्तिराश्चर्यभूतानां कथानां नास्ति मे विभो।\nकर्मकालो मुनिश्रेष्ठ लम्बते रविमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000065037, "chapter_id": 9065, "verse_number": "१-६५-३७", "content_sanskrit": "श्वः प्रभाते महातेजो द्रष्टुमर्हसि मां पुनः।\nस्वागतं जपतां श्रेष्ठ मामनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000065038, "chapter_id": 9065, "verse_number": "१-६५-३८", "content_sanskrit": "एवमुक्तो मुनिवरः प्रशस्य पुरुषर्षभम्।\nविससर्जाशु जनकं प्रीतं प्रीतमनास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000065039, "chapter_id": 9065, "verse_number": "१-६५-३९", "content_sanskrit": "एवमुक्त्वा मुनिश्रेष्ठं वैदेहो मिथिलाधिपः।\nप्रदक्षिणं चकाराशु सोपाध्यायः सबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000065040, "chapter_id": 9065, "verse_number": "१-६५-४०", "content_sanskrit": "विश्वामित्रोऽपि धर्मात्मा सहरामः सलक्ष्मणः।\nस्ववासमभिचक्राम पूज्यमानो महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000065041, "chapter_id": 9065, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]