[{"id": 6000202000, "chapter_id": 10202, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000202001, "chapter_id": 10202, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.001.m4a", "display_order": 2}, {"id": 6000202002, "chapter_id": 10202, "verse_number": "१०-६-१", "content_sanskrit": "नन्दस्त्वात्मज उत्पन्ने जाताह्लादो महामनाः।\nआहूय विप्रान् वेदज्ञान् स्नातः शुचिरलङ्कृतः॥ १०/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.002.m4a", "display_order": 3, "topics": [{"text": "नन्देन श्रीकृष्णस्य जातकर्मकरणं महोत्सवश्च", "range": "१–१८"}]}, {"id": 6000202003, "chapter_id": 10202, "verse_number": "१०-६-२", "content_sanskrit": "वाचयित्वा स्वस्त्ययनं जातकर्मात्मजस्य वै।\nकारयामास विधिना पितृदेवार्चनं तथा॥ १०/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.003.m4a", "display_order": 4}, {"id": 6000202004, "chapter_id": 10202, "verse_number": "१०-६-३", "content_sanskrit": "धेनूनां नियुते प्रादाद् विप्रेभ्यः समलङ्कृते।\nतिलाद्रीन् सप्त रत्नौघान् शातकुम्भान्तरावृतान्॥ १०/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.004.m4a", "display_order": 5}, {"id": 6000202005, "chapter_id": 10202, "verse_number": "१०-६-४", "content_sanskrit": "कालेन स्नानशौचाभ्यां संस्कारैस्तपसेज्यया।\nशुद्ध्यन्ति दानैः संतुष्ट्या द्रव्याण्यात्माऽऽत्मविद्यया॥ १०/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.005.m4a", "display_order": 6}, {"id": 6000202006, "chapter_id": 10202, "verse_number": "१०-६-५", "content_sanskrit": "सौमङ्गल्यगिरो विप्राः सूतमागधबन्दिनः।\nगायकाश्च जगुर्नेदुर्भेर्यो दुन्दुभयो मुहुः॥ १०/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.006.m4a", "display_order": 7}, {"id": 6000202007, "chapter_id": 10202, "verse_number": "१०-६-६", "content_sanskrit": "प्रजाः सम्मृष्टसंसिक्तद्वाराजिरगृहान्तराः।\nचित्रध्वजपताकास्रक्चैलपल्लवतोरणाः॥ १०/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.007.m4a", "display_order": 8}, {"id": 6000202008, "chapter_id": 10202, "verse_number": "१०-६-७", "content_sanskrit": "गावो वृषाश्च वत्साश्च हरिद्रातैलरूषिताः।\nविचित्रधातुबर्हस्रग्वस्‍त्रकाञ्चनमालिनः॥ १०/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.008.m4a", "display_order": 9}, {"id": 6000202009, "chapter_id": 10202, "verse_number": "१०-६-८", "content_sanskrit": "महार्हवस्‍त्राभरणकञ्चुकोष्णीषभूषणाः।\nगोपाः समाययू राजन् नानोपायनपाणयः॥ १०/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.009.m4a", "display_order": 10}, {"id": 6000202010, "chapter_id": 10202, "verse_number": "१०-६-९", "content_sanskrit": "गोप्यश्चाकर्ण्य मुदिता यशोदायाः सुतोद्भवम्।\nआत्मानं भूषयाञ्चक्रुर्वस्‍त्राकल्पाञ्जनादिभिः॥ १०/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.010.m4a", "display_order": 11}, {"id": 6000202011, "chapter_id": 10202, "verse_number": "१०-६-१०", "content_sanskrit": "नवकुङ्कुमकिञ्जल्कमुखपङ्कजभूतयः।\nबलिभिस्त्वरितं जग्मुः पृथुश्रोण्यश्चलत्कुचाः॥ १०/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.011.m4a", "display_order": 12}, {"id": 6000202012, "chapter_id": 10202, "verse_number": "१०-६-११", "content_sanskrit": "गोप्यः सुमृष्टमणिकुण्डलनिष्ककण्ठ्यः चित्राम्बराः पथि शिखाच्युतमाल्यवर्षाः।\nनन्दालयं सवलया व्रजतीर्विरेजुः व्यालोलकुण्डलपयोधरहारशोभाः॥ १०/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.012.m4a", "display_order": 13}, {"id": 6000202013, "chapter_id": 10202, "verse_number": "१०-६-१२", "content_sanskrit": "ता आशिषः प्रयुञ्जानाश्चिरं पाहीति बालके।\nहरिद्राचूर्णतैलाद्भिः सिञ्चन्त्योऽजनमुज्जगुः॥ १०/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.013.m4a", "display_order": 14}, {"id": 6000202014, "chapter_id": 10202, "verse_number": "१०-६-१३", "content_sanskrit": "अवाद्यन्त विचित्राणि वादित्राणि महोत्सवे।\nकृष्णे विश्वेश्वरेऽनन्ते नन्दव्रजमुपेयुषि॥ १०/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.014.m4a", "display_order": 15}, {"id": 6000202015, "chapter_id": 10202, "verse_number": "१०-६-१४", "content_sanskrit": "गोपाः परस्परं हृष्टा दधिक्षीरघृताम्बुभिः।\nआसिञ्चन्तो विलिम्पन्तो नवनीतैश्च चिक्षिपुः॥ १०/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.015.m4a", "display_order": 16}, {"id": 6000202016, "chapter_id": 10202, "verse_number": "१०-६-१५", "content_sanskrit": "नन्दो महामनास्तेभ्यो वासोऽलङ्कारगोधनैः।\nसूतमागधबन्दिभ्यो येऽन्ये विद्योपजीविनः॥ १०/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.016.m4a", "display_order": 17}, {"id": 6000202017, "chapter_id": 10202, "verse_number": "१०-६-१६", "content_sanskrit": "तैस्तैः कामैरदीनात्मा यथोचितमपूजयत्।\nविष्णोराराधनार्थाय स्वपुत्रस्योदयाय च॥ १०/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.017.m4a", "display_order": 18}, {"id": 6000202018, "chapter_id": 10202, "verse_number": "१०-६-१७", "content_sanskrit": "रोहिणी च महाभागा नन्दगोपाभिनन्दिता।\nव्यचरद् दिव्यवासःस्रक्कण्ठाभरणभूषिता॥ १०/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.018.m4a", "display_order": 19}, {"id": 6000202019, "chapter_id": 10202, "verse_number": "१०-६-१८", "content_sanskrit": "तत आरभ्य नन्दस्य व्रजः सर्वसमृद्धिमान्।\nहरेर्निवासानुगुणै रमाक्रीडमभून्नृप॥ १०/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.019.m4a", "display_order": 20}, {"id": 6000202020, "chapter_id": 10202, "verse_number": "१०-६-१९", "content_sanskrit": "गोपान् गोकुलरक्षायां निरूप्य मधुरां गतः।\nनन्दः कंसस्य वार्षिक्यं करं दातुं कुरूद्वह॥ १०/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.020.m4a", "display_order": 21, "topics": [{"text": "करदानार्थं मधुरां गतस्य नन्दस्य वसुदेवदर्शनम्", "range": "१९–२०"}]}, {"id": 6000202021, "chapter_id": 10202, "verse_number": "१०-६-२०", "content_sanskrit": "वसुदेव उपश्रुत्य भ्रातरं नन्दमागतम्।\nज्ञात्वा दत्तकरं राज्ञे ययौ तदवलोकनः॥ १०/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.021.m4a", "display_order": 22}, {"id": 6000202022, "chapter_id": 10202, "verse_number": "१०-६-२१", "content_sanskrit": "तं दृष्ट्वा सहसोत्थाय देहः प्राणमिवागतम्।\nप्रीतः प्रियतमं दोर्भ्यां सस्वजे प्रेमविह्वलः॥ १०/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.022.m4a", "display_order": 23, "topics": [{"text": "नन्दवसुदेवसंवादः", "range": "२१–३०"}]}, {"id": 6000202023, "chapter_id": 10202, "verse_number": "१०-६-२२", "content_sanskrit": "पूजितः सुखमासीनः पृष्ट्वाऽनामयमादितः।\nप्रसक्तधीः स्वात्मजयोरिदमाह विशाम्पते॥ १०/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.023.m4a", "display_order": 24}, {"id": 6000202024, "chapter_id": 10202, "verse_number": "१०-६-२३", "content_sanskrit": "दिष्ट्या भ्रातः प्रवयस इदानीमप्रजस्य ते।\nप्रजाशाया निवृत्तस्य प्रजा यत् समजायत॥ १०/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.024.m4a", "display_order": 25}, {"id": 6000202025, "chapter_id": 10202, "verse_number": "१०-६-२४", "content_sanskrit": "दिष्ट्या संसारचक्रेऽस्मिन् वर्तमानः पुनर्भवे।\nउपलब्धो भवानद्य दुर्लभं प्रियदर्शनम्॥ १०/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.025.m4a", "display_order": 26}, {"id": 6000202026, "chapter_id": 10202, "verse_number": "१०-६-२५", "content_sanskrit": "नैकत्र प्रियसंवासः सुहृदां चित्रकर्मणाम्।\nओघेन व्यूह्यमानानां प्लवानां स्रोतसो यथा॥ १०/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.026.m4a", "display_order": 27}, {"id": 6000202027, "chapter_id": 10202, "verse_number": "१०-६-२६", "content_sanskrit": "कच्चित् पशव्यं निरुजं भूर्यम्बुतृणवीरुधम्।\nबृहद्वनं तदधुना यत्रास्से त्वं सुहृद्वृतः॥ १०/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.027.m4a", "display_order": 28}, {"id": 6000202028, "chapter_id": 10202, "verse_number": "१०-६-२७", "content_sanskrit": "भ्रातर्मम सुतः कच्चिन्मात्रा सह भवद्व्रजे।\nतातं भवन्तं मन्वानो भवद्भ्यामुपलालितः॥ १०/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.028.m4a", "display_order": 29}, {"id": 6000202029, "chapter_id": 10202, "verse_number": "१०-६-२८", "content_sanskrit": "पुंसस्‍त्रिवर्गो विहितः सुहृदां ह्यनुभावतः।\nन तेषु क्लिश्यमानेषु त्रिवर्गोऽर्थाय कल्पते॥ १०/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.029.m4a", "display_order": 30}, {"id": 6000202030, "chapter_id": 10202, "verse_number": null, "content_sanskrit": "नन्द उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.030.m4a", "display_order": 31}, {"id": 6000202031, "chapter_id": 10202, "verse_number": "१०-६-२९", "content_sanskrit": "अहो ते देवकीपुत्राः कंसेन बहवो हताः।\nएकाऽवशिष्टाऽवरजा कन्या सापि दिवं गता॥ १०/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.031.m4a", "display_order": 32}, {"id": 6000202032, "chapter_id": 10202, "verse_number": "१०-६-३०", "content_sanskrit": "नूनं हि दृष्टनिष्ठोऽयं नादृष्टपरमो जनः।\nअदृष्टमात्मनस्तत्त्वं यो वेद न स मुह्यति॥ १०/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.032.m4a", "display_order": 33}, {"id": 6000202033, "chapter_id": 10202, "verse_number": null, "content_sanskrit": "वसुदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.033.m4a", "display_order": 34}, {"id": 6000202034, "chapter_id": 10202, "verse_number": "१०-६-३१", "content_sanskrit": "करो वै वार्षिको दत्तो राज्ञे दृष्टा वयं च वः।\nनेह स्थेयं बहुदिनं सन्त्युत्पाताश्च गोकुले॥ १०/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.034.m4a", "display_order": 35, "topics": [{"text": "वसुदेवचोदनया शीघ्रमेव नन्दस्य गोकुलं प्रति निवर्तनम्", "range": "३१–३२"}]}, {"id": 6000202035, "chapter_id": 10202, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.035.m4a", "display_order": 36}, {"id": 6000202036, "chapter_id": 10202, "verse_number": "१०-६-३२", "content_sanskrit": "इति नन्दादयो गोपाः प्रोक्तास्ते शौरिणा ययुः।\nअनोभिरनडुद्युक्तैस्तमनुज्ञाप्य गोकुलम्॥ १०/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_006/BhP_10.006.036.m4a", "display_order": 37}, {"id": 6000202037, "chapter_id": 10202, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]