[{"id": 6000233000, "chapter_id": 10233, "verse_number": null, "content_sanskrit": "अथ सप्तत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000233001, "chapter_id": 10233, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.001.m4a", "display_order": 2}, {"id": 6000233002, "chapter_id": 10233, "verse_number": "१०-३७-१", "content_sanskrit": "सुखोपविष्टः पर्यङ्के रामकृष्णानुमोदितः।\nलेभे मनोरथान् सर्वान् पथि यान् स चकार ह॥ १०/३७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.002.m4a", "display_order": 3, "topics": [{"text": "अक्रूरस्य रामकृष्णाभ्यां सह रात्रौ भोजनं संवादश्च", "range": "१–९"}]}, {"id": 6000233003, "chapter_id": 10233, "verse_number": "१०-३७-२", "content_sanskrit": "किमलभ्यं भगवति प्रसन्ने श्रीनिकेतने।\nतथापि तत्परा राजन् नैव वाञ्छन्ति किञ्चन॥ १०/३७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.003.m4a", "display_order": 4}, {"id": 6000233004, "chapter_id": 10233, "verse_number": "१०-३७-३", "content_sanskrit": "सायन्तनाशनं कृत्वा भगवान् देवकीसुतः।\nसुहृत्सु वृत्तिं कंसस्य पप्रच्छान्यच्चिकीर्षितम्॥ १०/३७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.004.m4a", "display_order": 5}, {"id": 6000233005, "chapter_id": 10233, "verse_number": "१०-३७-४", "content_sanskrit": "पृष्टो भगवता सर्वं वर्णयामास माधवः।\nवैरानुबन्धं यदुषु वसुदेववधोद्यमम्॥ १०/३७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.005.m4a", "display_order": 6}, {"id": 6000233006, "chapter_id": 10233, "verse_number": "१०-३७-५", "content_sanskrit": "यत्सन्देशो यदर्थे वा दूतः सम्प्रेषितः स्वयम्।\nयदुक्तं नारदेनास्य स्वजन्मानकदुन्दुभेः॥ १०/३७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.006.m4a", "display_order": 7}, {"id": 6000233007, "chapter_id": 10233, "verse_number": "१०-३७-६", "content_sanskrit": "श्रुत्वाऽक्रूरवचः कृष्णो बलश्च परवीरहा।\nप्रहस्य नन्दं पितरं राज्ञाऽऽदिष्टं विजज्ञतुः॥ १०/३७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.007.m4a", "display_order": 8}, {"id": 6000233008, "chapter_id": 10233, "verse_number": "१०-३७-७", "content_sanskrit": "गोपान् समादिशत् सोऽपि गृह्यतां सर्वगोरसः।\nउपायनानि गृह्णीध्वं युज्यन्तां शकटानि च॥ १०/३७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.008.m4a", "display_order": 9}, {"id": 6000233009, "chapter_id": 10233, "verse_number": "१०-३७-८", "content_sanskrit": "यास्यामः श्वो मधुपुरीं दास्यामो नृपते रसान्।\nद्रक्ष्यामः सुमहत् पर्व यान्ति जानपदाः किल॥ १०/३७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.009.m4a", "display_order": 10}, {"id": 6000233010, "chapter_id": 10233, "verse_number": "१०-३७-९", "content_sanskrit": "एवमाघोषयत् क्षत्रा नन्दगोपः स्वगोकुले।\nगोप्यस्तास्तदुपश्रुत्य बभूवुर्व्यथिताशयाः॥ १०/३७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.010.m4a", "display_order": 11}, {"id": 6000233011, "chapter_id": 10233, "verse_number": "१०-३७-१०", "content_sanskrit": "रामकृष्णौ पुरीं नेतुमक्रूरं व्रजमागतम्।\nकाश्चित् तत्कृतहृत्तापश्वासम्लानमुखश्रियः॥ १०/३७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.011.m4a", "display_order": 12, "topics": [{"text": "श्रीकृष्णस्य मथुरागमनं श्रुतवतां गोपिकानां व्यसनोक्तयः", "range": "१०–३६"}]}, {"id": 6000233012, "chapter_id": 10233, "verse_number": "१०-३७-११", "content_sanskrit": "स्रंसद्दुकूलवलयकेशग्रन्थ्यश्च काश्चन।\nअन्याश्च तदनुध्याननिवृत्ताशेषवृत्तयः॥ १०/३७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.012.m4a", "display_order": 13}, {"id": 6000233013, "chapter_id": 10233, "verse_number": "१०-३७-१२", "content_sanskrit": "नाभ्यजानन्निमं लोकमात्मलोकं गता इव।\nस्मरन्त्यश्चापराः शौरेरनुरागस्मितेरिताः॥ १०/३७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.013.m4a", "display_order": 14}, {"id": 6000233014, "chapter_id": 10233, "verse_number": "१०-३७-१३", "content_sanskrit": "हृदिस्पृशश्चित्रपदा गिरः संमुमुहुः स्‍त्रियः।\nगतिं सुललितां चेष्टां स्निग्धहासावलोकनम्॥ १०/३७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.014.m4a", "display_order": 15}, {"id": 6000233015, "chapter_id": 10233, "verse_number": "१०-३७-१४", "content_sanskrit": "शोकापहानि नर्माणि प्रोद्दामचरितानि च।\nचिन्तयन्त्यो मुकुन्दस्य भीता विरहकातराः॥ १०/३७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.015.m4a", "display_order": 16}, {"id": 6000233016, "chapter_id": 10233, "verse_number": "१०-३७-१५", "content_sanskrit": "समेताः सङ्घशः प्रोचुरश्रुमुख्योऽच्युताशयाः॥ १०/३७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.016.m4a", "display_order": 17}, {"id": 6000233017, "chapter_id": 10233, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.017.m4a", "display_order": 18}, {"id": 6000233018, "chapter_id": 10233, "verse_number": "१०-३७-१६", "content_sanskrit": "अहो विधातस्तव नक्‍वचिद् दया संयोज्य मैत्र्या प्रणयेन देहिनः।\nतांश्चाकृतार्थान् वियुनङ्क्ष्यपार्थकं विचेष्टितं तेऽर्भकचेष्टितं यथा॥ १०/३७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.018.m4a", "display_order": 19}, {"id": 6000233019, "chapter_id": 10233, "verse_number": "१०-३७-१७", "content_sanskrit": "यस्त्वं प्रदर्श्यासितकुन्तलावृतं मुकुन्दवक्त्रं सुकपोलमुन्नसम्।\nशोकापनोदस्मितलेशसुन्दरं करोषि पारोक्ष्यमसाधु ते कृतम्॥ १०/३७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.019.m4a", "display_order": 20}, {"id": 6000233020, "chapter_id": 10233, "verse_number": "१०-३७-१८", "content_sanskrit": "क्रूरस्त्वमक्रूरसमाख्यया स्मृतश्चक्षुर्हि दत्तं हरसे बताज्ञवत्।\nयेनैकदेशेऽखिलसर्गसौष्ठवं तदीयमद्राक्ष्म वयं मधुद्विषः॥ १०/३७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.020.m4a", "display_order": 21}, {"id": 6000233021, "chapter_id": 10233, "verse_number": "१०-३७-१९", "content_sanskrit": "न नन्दसूनुः क्षणभङ्गसौहृदः समीक्षते नः स्वकृतातुरा अपि।\nविहाय गेहान् स्वजनान् सुतान् पतीन् स्वदास्यमद्धोपगता नवप्रियः॥ १०/३७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.021.m4a", "display_order": 22}, {"id": 6000233022, "chapter_id": 10233, "verse_number": "१०-३७-२०", "content_sanskrit": "सुखं प्रभाता रजनीयमाशिषः सत्या बभूवुः पुरयोषितां ध्रुवम्।\nयाः सम्प्रविष्टस्य मुखं व्रजस्पतेः पास्यन्त्यपाङ्गोत्कलितस्मितासवम्॥ १०/३७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.022.m4a", "display_order": 23}, {"id": 6000233023, "chapter_id": 10233, "verse_number": "१०-३७-२१", "content_sanskrit": "तासां मुकुन्दो मधुमञ्जुभाषितैर्गृहीतचित्तः परवान् मनस्व्यपि।\nकथं पुनर्नः प्रतियास्यतेऽबला ग्राम्या अलज्जाः स्मितविभ्रमद्भ्रुवः॥ १०/३७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.023.m4a", "display_order": 24}, {"id": 6000233024, "chapter_id": 10233, "verse_number": "१०-३७-२२", "content_sanskrit": "अद्य ध्रुवं तत्र दृशां महोत्सवो दाशार्हभोजान्धकवृष्णिसात्वताम्।\nमहोत्सवं श्रीरमणं गुणास्पदं द्रक्ष्यन्ति ये चाध्वनि देवकीसुतम्॥ १०/३७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.024.m4a", "display_order": 25}, {"id": 6000233025, "chapter_id": 10233, "verse_number": "१०-३७-२३", "content_sanskrit": "मैतद्विधस्याकरुणस्य नाम भूदक्रूर इत्येतदतीव दारुणः।\nयोऽसावनाश्वास्य सुदुःखितं जनं प्रियात् प्रियं नेष्यति पारमध्वनः॥ १०/३७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.025.m4a", "display_order": 26}, {"id": 6000233026, "chapter_id": 10233, "verse_number": "१०-३७-२४", "content_sanskrit": "अनार्द्रधीरेष समास्थितो रथं तमन्वमी च त्वरयन्ति दुर्मदाः।\nगोपा अनोभिः स्थविरैरुपेक्षितं दैवं च नोऽद्य प्रतिकूलमीहते॥ १०/३७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.026.m4a", "display_order": 27}, {"id": 6000233027, "chapter_id": 10233, "verse_number": "१०-३७-२५", "content_sanskrit": "निवारयामः समुपेत्य माधवं किं नोऽकरिष्यन् कुलवृद्धबान्धवाः।\nमुकुन्दसङ्गान्निमिषार्धदुस्त्यजाद् दैवेन विभ्रंशितदीनचेतसाम्॥ १०/३७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.027.m4a", "display_order": 28}, {"id": 6000233028, "chapter_id": 10233, "verse_number": "१०-३७-२६", "content_sanskrit": "यस्यानुरागललितस्मितवल्गुमन्त्रलीलावलोकपरिरम्भणरासगोष्ठ्याम्।\nनीताः स्म नः क्षणमिव क्षणदा विना तं गोप्यः कथं न्वतितरेम तमो दुरन्तम्॥ १०/३७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.028.m4a", "display_order": 29}, {"id": 6000233029, "chapter_id": 10233, "verse_number": "१०-३७-२७", "content_sanskrit": "योऽह्नः क्षये व्रजमनन्तसखः परीतो गोपैर्विशन् खुररजश्छुरितालकस्रक्।\nवेणुं क्‍वणन् स्मितकटाक्षनिरीक्षणेन चित्तं क्षिणोति तमृतेऽम्ब कथं भवेम॥ १०/३७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.029.m4a", "display_order": 30}, {"id": 6000233030, "chapter_id": 10233, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.030.m4a", "display_order": 31}, {"id": 6000233031, "chapter_id": 10233, "verse_number": "१०-३७-२८", "content_sanskrit": "एवं ब्रुवाणा विरहातुरा भृशं व्रजस्‍त्रियः कृष्णनिषक्तमानसाः।\nविसृज्य लज्जां रुरुदुः स्म सुस्वरं गोविन्द दामोदर माधवेति॥ १०/३७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.031.m4a", "display_order": 32}, {"id": 6000233032, "chapter_id": 10233, "verse_number": "१०-३७-२९", "content_sanskrit": "स्‍त्रीणामेवं रुदन्तीनामुदिते सवितर्यथ।\nअक्रूरश्चोदयामास कृतमैत्र्यादिको रथम्॥ १०/३७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.032.m4a", "display_order": 33}, {"id": 6000233033, "chapter_id": 10233, "verse_number": "१०-३७-३०", "content_sanskrit": "गोपास्तमन्वसज्जन्त नन्दाद्याः शकटैस्ततः।\nआदायोपायनं भूरि कुम्भान् गोरससम्भृतान्॥ १०/३७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.033.m4a", "display_order": 34}, {"id": 6000233034, "chapter_id": 10233, "verse_number": "१०-३७-३१", "content_sanskrit": "गोप्यश्च दयितं कृष्णमनुव्रज्यानुरञ्जिताः।\nप्रत्यादेशं भगवतः काङ्क्षन्त्यश्चावतस्थिरे॥ १०/३७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.034.m4a", "display_order": 35}, {"id": 6000233035, "chapter_id": 10233, "verse_number": "१०-३७-३२", "content_sanskrit": "तास्तथा तप्यतीर्वीक्ष्य स्वप्रस्थाने यदूत्तमः।\nसान्त्वयामास सम्प्रेष्यैरायास्य इति दौत्यकैः॥ १०/३७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.035.m4a", "display_order": 36}, {"id": 6000233036, "chapter_id": 10233, "verse_number": "१०-३७-३३", "content_sanskrit": "यावदालक्ष्यते केतुर्यावद् रेणू रथस्य च।\nअनुप्रस्थापितात्मानो लेख्यानीवोपतस्थिरे॥ १०/३७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.036.m4a", "display_order": 37}, {"id": 6000233037, "chapter_id": 10233, "verse_number": "१०-३७-३४", "content_sanskrit": "ता निराशा निववृतुर्गोविन्दविनिवर्तने।\nविशोका अहनी निन्युर्गायन्त्यः प्रियचेष्टितम्॥ १०/३७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.037.m4a", "display_order": 38}, {"id": 6000233038, "chapter_id": 10233, "verse_number": "१०-३७-३५", "content_sanskrit": "भगवानपि सम्प्राप्तो रामाक्रूरौ तथा नृप।\nरथेन वायुवेगेन कालिन्दीमघनाशिनीम्॥ १०/३७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.038.m4a", "display_order": 39}, {"id": 6000233039, "chapter_id": 10233, "verse_number": "१०-३७-३६", "content_sanskrit": "तत्रोपस्पृश्य पानीयं पीत्वा मृष्टं मणिप्रभम्।\nवृक्षषण्डमुपव्रज्य सरामो रथमाविशत्॥ १०/३७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.039.m4a", "display_order": 40}, {"id": 6000233040, "chapter_id": 10233, "verse_number": "१०-३७-३७", "content_sanskrit": "अक्रूरस्तावुपामन्त्र्य निवेश्य च रथोपरि।\nकालिन्द्या ह्रदमागम्य स्नानं विधिवदाचरन्॥ १०/३७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.040.m4a", "display_order": 41, "topics": [{"text": "कालिन्द्यां स्नानार्थं मग्नेनाक्रूरेण जलान्तर्विष्णुलोकदर्शनम्", "range": "३७–५४"}]}, {"id": 6000233041, "chapter_id": 10233, "verse_number": "१०-३७-३८", "content_sanskrit": "निमज्य तस्मिन् सलिले जपन् ब्रह्म सनातनम्।\nतावेव ददृशेऽक्रूरो रामकृष्णौ समन्वितौ॥ १०/३७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.041.m4a", "display_order": 42}, {"id": 6000233042, "chapter_id": 10233, "verse_number": "१०-३७-३९", "content_sanskrit": "तौ रथस्थौ कथमिह सुतावानकदुन्दुभेः।\nतर्हि स्वित् स्यन्दने न स्त इत्युन्मज्य व्यचष्ट सः॥ १०/३७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.042.m4a", "display_order": 43}, {"id": 6000233043, "chapter_id": 10233, "verse_number": "१०-३७-४०", "content_sanskrit": "तत्रापि च यथापूर्वमासीनौ पुनरेव सः।\nन्यमज्जद् दर्शनं यन्मे मृषा किं सलिले तयोः॥ १०/३७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.043.m4a", "display_order": 44}, {"id": 6000233044, "chapter_id": 10233, "verse_number": "१०-३७-४१", "content_sanskrit": "भूयस्तत्रापि सोऽद्राक्षीत् स्तूयमानमहीश्वरम्।\nसिद्धैर्भुजङ्गपतिभिरसुरैर्नतकन्धरैः॥ १०/३७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.044.m4a", "display_order": 45}, {"id": 6000233045, "chapter_id": 10233, "verse_number": "१०-३७-४२", "content_sanskrit": "सहस्रशिरसं देवं सहस्रफणमौलिनम्।\nनीलाम्बरं बिसश्वेतं शृङ्गैः श्वेतमिव स्थितम्॥ १०/३७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.045.m4a", "display_order": 46}, {"id": 6000233046, "chapter_id": 10233, "verse_number": "१०-३७-४३", "content_sanskrit": "तस्योत्सङ्गे घनश्यामं पीतकौशेयवाससम्।\nपुरुषं चतुर्भुजं शान्तं पद्मपत्रारुणेक्षणम्॥ १०/३७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.046.m4a", "display_order": 47}, {"id": 6000233047, "chapter_id": 10233, "verse_number": "१०-३७-४४", "content_sanskrit": "चारुप्रसन्नवदनं चारुहासनिरीक्षणम्।\nसुभ्रून्नसं चारुकर्णं सुकपोलारुणाधरम्॥ १०/३७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.047.m4a", "display_order": 48}, {"id": 6000233048, "chapter_id": 10233, "verse_number": "१०-३७-४५", "content_sanskrit": "प्रलम्बपीवरभुजं तुङ्गांसोरःस्थलश्रियम्।\nकम्बुकण्ठं निम्ननाभिं वलिमत्पल्लवोदरम्॥ १०/३७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.048.m4a", "display_order": 49}, {"id": 6000233049, "chapter_id": 10233, "verse_number": "१०-३७-४६", "content_sanskrit": "बृहत्कटितटश्रोणिकरभोरुद्वयान्वितम्।\nचारुजानुयुगं चारुजङ्घायुगलसंयुतम्॥ १०/३७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.049.m4a", "display_order": 50}, {"id": 6000233050, "chapter_id": 10233, "verse_number": "१०-३७-४७", "content_sanskrit": "तुङ्गगुल्फारुणनखव्रातदीधितिभिर्वृतम्।\nनवाङ्गुल्यङ्गुष्ठदलैर्विलसत्पादपङ्कजम्॥ १०/३७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.050.m4a", "display_order": 51}, {"id": 6000233051, "chapter_id": 10233, "verse_number": "१०-३७-४८", "content_sanskrit": "महार्हमणिविभ्राजत्किरीटकटकाङ्गदैः।\nकटिसूत्रब्रह्मसूत्रहारनूपुरकुण्डलैः॥ १०/३७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.051.m4a", "display_order": 52}, {"id": 6000233052, "chapter_id": 10233, "verse_number": "१०-३७-४९", "content_sanskrit": "भ्राजमानं पद्मकरं शङ्खचक्रगदाधरम्।\nश्रीवत्सवक्षसं भ्राजत्कौस्तुभं वनमालिनम्॥ १०/३७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.052.m4a", "display_order": 53}, {"id": 6000233053, "chapter_id": 10233, "verse_number": "१०-३७-५०", "content_sanskrit": "सुनन्दनन्दप्रमुखैः पार्षदैः सनकादिभिः।\nसुरेशैर्ब्रह्मरुद्राद्यैर्नवभिश्च द्विजोत्तमैः॥ १०/३७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.053.m4a", "display_order": 54}, {"id": 6000233054, "chapter_id": 10233, "verse_number": "१०-३७-५१", "content_sanskrit": "प्रह्लादनारदवसुमुखैर्भागवतोत्तमैः।\nस्तूयमानं पृथङ्मार्गैर्वचोभिरमलात्मभिः॥ १०/३७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.054.m4a", "display_order": 55}, {"id": 6000233055, "chapter_id": 10233, "verse_number": "१०-३७-५२", "content_sanskrit": "श्रिया पुष्ट्या गिरा कान्त्या कीर्त्या तुष्ट्येलयाऽजया।\nविद्ययाऽविद्यया शक्त्या मायया च निषेवितम्॥ १०/३७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.055.m4a", "display_order": 56}, {"id": 6000233056, "chapter_id": 10233, "verse_number": "१०-३७-५३", "content_sanskrit": "विलोक्य सुभृशं प्रीतो भक्त्या परमया युतः।\nहृष्यत्तनूरुहो भावपरिक्लिन्नात्मलोचनः॥ १०/३७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.056.m4a", "display_order": 57}, {"id": 6000233057, "chapter_id": 10233, "verse_number": "१०-३७-५४", "content_sanskrit": "गिरा गद्गदयाऽस्तौषीत्सत्त्वमालम्ब्य सात्त्वतः।\nप्रणम्य मूर्ध्नाऽवहितः कृताञ्जलिपुटः शनैः॥ १०/३७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_037/BhP_10.037.057.m4a", "display_order": 58}, {"id": 6000233058, "chapter_id": 10233, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे सप्तत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]