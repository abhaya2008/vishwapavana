[{"id": 7000313000, "chapter_id": 20313, "verse_number": "१-६७-१", "content_sanskrit": "व्यास उवाच ।\nएतच्छ्रुत्वा तु दैत्येंद्रो हिरण्याक्षो महाबलः ।\nसरोषश्चातिताम्राक्षो ह्यसुरानादिदेश ह॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000313001, "chapter_id": 20313, "verse_number": "१-६७-२", "content_sanskrit": "स्वयं गच्छामि युद्धाय देवानां विजिघांसया ।\nनागच्छंति न युद्ध्यंते तेन मार्गाद्विशन्त्वितः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000313002, "chapter_id": 20313, "verse_number": "१-६७-३", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं शेषा दैत्यगणाधिपाः ।\nयुद्धाय प्रययुः सर्वे शूलपाशातिपंडिताः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000313003, "chapter_id": 20313, "verse_number": "१-६७-४", "content_sanskrit": "अधिकं पूर्वसैन्याश्च तथा शतगुणैरपि ।\nनिरंतरं तथाकाशं प्रययुर्युद्धकांक्षिणः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000313004, "chapter_id": 20313, "verse_number": "१-६७-५", "content_sanskrit": "ततो रुद्रास्स साध्याश्च विश्वे च वसवस्तथा ।\nस्कंदश्च गणपश्चैव विष्णुजिष्णुपुरोगमाः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000313005, "chapter_id": 20313, "verse_number": "१-६७-६", "content_sanskrit": "सर्वे योद्धुं गतास्ते च हृष्टा रणसमुत्सुकाः ।\nएतस्मिन्नंतरे युद्धं देवदानवयोरपि॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000313006, "chapter_id": 20313, "verse_number": "१-६७-७", "content_sanskrit": "न भूतं न श्रुतं पूर्वं सर्वलोकभयंकरम् ।\nशस्त्रास्त्रैबर्हुधा युक्तं शिशिरेणेव काननम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000313007, "chapter_id": 20313, "verse_number": "१-६७-८", "content_sanskrit": "धरां स्वर्गौक आकाशं संरुध्य युद्धमाबभौ ।\nअन्योन्यं जघ्नुराकाशे तथान्योन्यं महीतले॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000313008, "chapter_id": 20313, "verse_number": "१-६७-९", "content_sanskrit": "शक्तिभिर्मुसलैर्भल्लैर्बहुभिः शरवृष्टिभिः ।\nदारुणैः खड्गपातैश्च तथा चक्रपरःश्वधैः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000313009, "chapter_id": 20313, "verse_number": "१-६७-१०", "content_sanskrit": "अन्यायुधैश्च विविधैर्निर्जघ्नुस्ते परस्परम् ।\nअभवन्घोररूपाणि धराकाशे व्ययानि च॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000313010, "chapter_id": 20313, "verse_number": "१-६७-११", "content_sanskrit": "शस्त्रैः शरैरसृक्पातैः कंकवायसजंबुकैः ।\nयथा मुसलधाराभिर्घना वर्षंति लोहितम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000313011, "chapter_id": 20313, "verse_number": "१-६७-१२", "content_sanskrit": "तथैव क्षतजैः स्रस्तैः स्वाङ्गाच्च देवदानवाः ।\nकेचित्पतंति मुह्यंति स्खलंति च हसंति च॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000313012, "chapter_id": 20313, "verse_number": "१-६७-१३", "content_sanskrit": "मुंचंति चार्तनादांश्च सिंहनादं मुहुर्मुहुः ।\nकेषांचिद्बाहवश्छिन्नाश्छिन्नपादास्तथापरे॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000313013, "chapter_id": 20313, "verse_number": "१-६७-१४", "content_sanskrit": "छिन्नपार्श्वोदराः केचिन्निपेतुः शतशो भुवि ।\nकोटिकोटिसहस्राणि गजवाज्यसुराणि च॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000313014, "chapter_id": 20313, "verse_number": "१-६७-१५", "content_sanskrit": "अपतन्धरणीपृष्ठे रक्तौघे बहुधा भुवि ।\nततस्तु धरणीपृष्ठे त्वभवल्लोहितार्णवः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000313015, "chapter_id": 20313, "verse_number": "१-६७-१६", "content_sanskrit": "विपरीतास्ततो नद्यः सद्यस्तत्र विसुस्रुवुः ।\nतृणकाष्ठपरास्तत्र शक्तयो दारुसंचयाः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000313016, "chapter_id": 20313, "verse_number": "१-६७-१७", "content_sanskrit": "मुद्गरा मुसलाः शूला मकराद्या भवंति च ।\nजयंतिका ध्वजा मीनाः कमठाश्चर्मकायकाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000313017, "chapter_id": 20313, "verse_number": "१-६७-१८", "content_sanskrit": "शरादिभिर्महोष्ट्रैश्च निरुद्धाः प्रचुरैस्तथा ।\nकेशचामरशैवालाः संपूर्णास्तास्ततःस्ततः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000313018, "chapter_id": 20313, "verse_number": "१-६७-१९", "content_sanskrit": "पतद्भिश्च तथान्यैश्च विविधैः क्षतजार्णवः ।\nतदा वसुंधरा सर्वा सशैलवनकानना॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000313019, "chapter_id": 20313, "verse_number": "१-६७-२०", "content_sanskrit": "रुधिरौघा महाघोरा सर्वलोकभयंकरा ।\nस्कंदस्य शक्तिपातेन गता दैत्या यमक्षयम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000313020, "chapter_id": 20313, "verse_number": "१-६७-२१", "content_sanskrit": "पर्शुना परमेणैव अग्निनाग्निशिखैः शरैः ।\nवरुणस्य च पाशेन बद्धा मग्ना यमक्षये॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000313021, "chapter_id": 20313, "verse_number": "१-६७-२२", "content_sanskrit": "येषां पुत्रैश्च पौत्रैश्च पुरोगैः सचिवैस्तथा ।\nनिपातिताश्च दैतेयाः शरशक्त्यृष्टिवृष्टिभिः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000313022, "chapter_id": 20313, "verse_number": "१-६७-२३", "content_sanskrit": "ग्रहैश्च श्वसनैरेव यक्षगंधर्वकिन्नरैः ।\nमहत्या गदया चैव कुबेरेण च धीमता॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000313023, "chapter_id": 20313, "verse_number": "१-६७-२४", "content_sanskrit": "घनानां निकरैर्वज्रैस्तुषारैर्विधुनेरितैः ।\nपन्नगानां विषैर्घोरैर्दैत्याः पेतुर्धरातले॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000313024, "chapter_id": 20313, "verse_number": "१-६७-२५", "content_sanskrit": "अन्यैश्च विविधैर्देवैः कोटिकोटिसहस्रशः ।\nपातिताः प्रययुस्सर्वे धरण्यां तु गतासवः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000313025, "chapter_id": 20313, "verse_number": "१-६७-२६", "content_sanskrit": "देहांस्त्यक्त्वा दिवं यांति केचिच्च यममंदिरम् ।\nकेचिद्गच्छंति पातालं पुण्यापुण्यप्रयोगतः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000313026, "chapter_id": 20313, "verse_number": "१-६७-२७", "content_sanskrit": "एतस्मिन्नंतरे वेदाञ्जजल्पुः परमर्षयः ।\nस्वस्त्यस्तु ब्राह्मणेभ्यश्च गोभ्यः स्त्रीभ्यस्तपस्विषु॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000313027, "chapter_id": 20313, "verse_number": "१-६७-२८", "content_sanskrit": "प्रयुध्यमानेष्वन्येषु सांप्रतं सर्वजंतुषु ।\nविबुधैरर्दिता दैत्याः शेषाः पर्वतमाश्रिताः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000313028, "chapter_id": 20313, "verse_number": "१-६७-२९", "content_sanskrit": "प्रजग्मुश्च दिशः सर्वाः कातरा रणभीरवः ।\nदैत्यव्यूहे प्रभग्ने च बलो नाम महाबलः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000313029, "chapter_id": 20313, "verse_number": "१-६७-३०", "content_sanskrit": "अर्दयामास देवांश्च संयम्याग्निसमैः शरैः ।\nतस्य बाणार्दिता देवा बहवो बलदर्पिताः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000313030, "chapter_id": 20313, "verse_number": "१-६७-३१", "content_sanskrit": "पतिता धरणीपृष्ठे केचिद्भग्ना रणाजिरे ।\nदृष्ट्वा तस्य महत्कर्म दारुणं लोकभीषणम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000313031, "chapter_id": 20313, "verse_number": "१-६७-३२", "content_sanskrit": "शशंसुरृषयो देवास्तत्र शिष्टाः प्रचुक्रुशुः ।\nअथ क्रुद्धो महातेजाश्शतक्रतुररिंदमः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000313032, "chapter_id": 20313, "verse_number": "१-६७-३३", "content_sanskrit": "जघान शरसंदोहैर्बलं बलवतां वरम् ।\nसोपि क्रुद्धो बलो युद्धे तथा शक्रं ससंभ्रमः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000313033, "chapter_id": 20313, "verse_number": "१-६७-३४", "content_sanskrit": "रुधिरेणावसिक्तांगौ प्रसृतेन महाबलौ ।\nतौ यथा माधवे मासि पुष्पितौ किंशुकद्रुमौ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000313034, "chapter_id": 20313, "verse_number": "१-६७-३५", "content_sanskrit": "चक्राणि च सहस्राणि शूलानि मुसलानि च ।\nनिचखान रणे शक्रे चपले चासुरोत्तमः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000313035, "chapter_id": 20313, "verse_number": "१-६७-३६", "content_sanskrit": "तानि चक्राणि शूलानि निचकर्त्त शरोत्तमैः ।\nसुरराट्सहसा भ्रांतो लीलया समरे बली॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000313036, "chapter_id": 20313, "verse_number": "१-६७-३७", "content_sanskrit": "स च दैत्यो महातेजाः शक्त्या चैव पुरंदरम् ।\nनिजघान तदा तूर्णं गजस्थं च स्तनांतरे॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000313037, "chapter_id": 20313, "verse_number": "१-६७-३८", "content_sanskrit": "तया विनिहतः शक्रः प्रचचाल गजोपरि ।\nलब्धसंज्ञो बलं जिष्णुर्बिभेद दनुजं क्षणात्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000313038, "chapter_id": 20313, "verse_number": "१-६७-३९", "content_sanskrit": "रथसंस्थस्य हस्तौ च धनुश्चिच्छेद चेषुणा ।\nचर्मतीक्ष्णं ध्वजं तस्य शरेणैकेन वीरहा॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000313039, "chapter_id": 20313, "verse_number": "१-६७-४०", "content_sanskrit": "चतुर्भिर्निशितैर्बाणैर्विव्याध चतुरो हयान् ।\nशरेणैकेन सूतस्य शिरश्चिच्छेद तत्क्षणात्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000313040, "chapter_id": 20313, "verse_number": "१-६७-४१", "content_sanskrit": "छिन्नधन्वा हतरथो हताश्वो हतसारथिः ।\nनिपत्य मूर्च्छितः पृथ्व्यां मुहूर्तान्मृत्युमाप सः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000313041, "chapter_id": 20313, "verse_number": "१-६७-४२", "content_sanskrit": "अथ क्रुद्धो महादैत्यो नमुचिः सुरदर्पहा ।\nगदामादाय सहसा स जघान महागजम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000313042, "chapter_id": 20313, "verse_number": "१-६७-४३", "content_sanskrit": "यथा मेरुगिरेः शृंगे वज्रपातो भवेद्ध्रुवम् ।\nतथैव च महाशब्दो ह्यभवल्लोमहर्षणः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000313043, "chapter_id": 20313, "verse_number": "१-६७-४४", "content_sanskrit": "प्रहारेणार्दितः पद्मी संचचाल स विह्वलः ।\nरुधिरेणावसिक्तांगो विमुखो वेदनातुरः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000313044, "chapter_id": 20313, "verse_number": "१-६७-४५", "content_sanskrit": "शतक्रतुं विधावंति शतशोथ सहस्रशः ।\nअर्धचंद्रैक्षुःरप्रैश्च चिच्छेद पाकशासनः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000313045, "chapter_id": 20313, "verse_number": "१-६७-४६", "content_sanskrit": "जंतुभिस्तस्य मायाभिरर्दितास्सुरपुंगवाः ।\nभूमौ निपतिताः केचित्केचित्सुप्ता रथोपरि॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000313046, "chapter_id": 20313, "verse_number": "१-६७-४७", "content_sanskrit": "दृष्ट्वा तस्य महत्कर्म माधवो विशिखांस्तथा ।\nजंतुभूतान्स चक्रेण चिच्छेद देहलग्नकान्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000313047, "chapter_id": 20313, "verse_number": "१-६७-४८", "content_sanskrit": "ततो जिष्णुस्त्रिभिर्बाणैः पातयामास भूतले ।\nपृथिव्यां पतितो दैत्यो मूर्च्छितस्खलितः पुनः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000313048, "chapter_id": 20313, "verse_number": "१-६७-४९", "content_sanskrit": "दधार मुद्गरं घोरं शक्रं हंतुं समुद्यतः ।\nततो जघान मघवा कुलिशेन महासुरम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000313049, "chapter_id": 20313, "verse_number": "१-६७-५०", "content_sanskrit": "स पपात महीपृष्ठे क्षतवक्षा महाबलः ।\nसाधुसाध्विति देवाश्च सिद्धाश्चैव महर्षयः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000313050, "chapter_id": 20313, "verse_number": "१-६७-५१", "content_sanskrit": "अपूजयंस्तदा शक्रं बहुभिः पुष्पवृष्टिभिः ।\nततो दैत्यगणाः सर्वे भीतास्तत्र प्रदुद्रुवुः ।\nगीतं गायंति गंधर्वा ननृतुश्चाप्सरोगणाः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]