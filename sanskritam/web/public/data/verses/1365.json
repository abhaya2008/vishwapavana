[{"id": 2017616, "chapter_id": 1365, "verse_number": "३-३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017617, "chapter_id": 1365, "verse_number": "३-३-१", "content_sanskrit": "शौनकेनैवमुक्तस्तु कुन्तीपुत्रो युधिष्ठिः।\n`प्रणम्य द्विजशार्दूलं पूज्यवाक्यं सुभाषितम्।\nपुरोहितमुपागम्य भ्रातृमध्येऽब्रवीषिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017618, "chapter_id": 1365, "verse_number": "३-३-२", "content_sanskrit": "प्रस्थिताननुयातारो ब्राह्मणा वेदपारनाः।\nन चास्मि पोषणे शक्तो बहुदुःखसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017619, "chapter_id": 1365, "verse_number": "३-३-३", "content_sanskrit": "परित्यक्तुं न शक्नोमि दानशक्तिश्च नास्ति मे।\nकथमत्र मया कार्यं तद्बूहि भगवन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017620, "chapter_id": 1365, "verse_number": "३-३-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017621, "chapter_id": 1365, "verse_number": "३-३-४", "content_sanskrit": "मुहूर्तमिव स ध्यात्वा धर्मेणान्वीक्ष्य तां गतिम्।\nयुधिष्ठिरमुवाचैदं धौम्यो धर्मभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017622, "chapter_id": 1365, "verse_number": "३-३-५", "content_sanskrit": "पुरा सृष्टानि भूतानि पीड्यन्ते क्षुधया भृशम्।\nततोऽनुकम्पंयां तेषां सविता स्वपिता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017623, "chapter_id": 1365, "verse_number": "३-३-६", "content_sanskrit": "गत्वोत्तसयणं तेजो रसानुद्धृत्य रश्मिभिः।\nदक्षिणायनमावृत्तो महीं वर्षति वारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017624, "chapter_id": 1365, "verse_number": "३-३-७", "content_sanskrit": "क्षेत्रभूते ततस्तस्मिन्नोषधीरोषधीयतिः।\nरवेस्तेजः समुद्धृत्य जनयामास वारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017625, "chapter_id": 1365, "verse_number": "३-३-८", "content_sanskrit": "निषिक्तश्चन्द्तेजोभिः सूयते जगतो रविः।\nओषध्यः षड्रसा मेध्यास्तदन्नं प्राणिनां भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017626, "chapter_id": 1365, "verse_number": "३-३-९", "content_sanskrit": "एवं भानुमयं ह्यन्नं भूतानां प्राणधारणम्।\nनाथोऽयं सर्वभूतानां तस्मात्तं शरणं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017627, "chapter_id": 1365, "verse_number": "३-३-१०", "content_sanskrit": "राजानो हि महात्मानो योनिकर्मविशोधिताः।\nउद्धरन्ति प्रजाः सर्वास्तप आस्थाय पुष्कलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017628, "chapter_id": 1365, "verse_number": "३-३-११", "content_sanskrit": "भौमेन कार्तवीर्येण वैन्येन नहुषेण च।\nतपोयोगसमाधिस्थैरुद्धृता ह्यापदः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017629, "chapter_id": 1365, "verse_number": "३-३-१२", "content_sanskrit": "तथा त्वमपि धर्मात्मन्कर्मणा च विशोधितः।\nतप आस्थाय धर्मेण द्विजातीन्भर भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017630, "chapter_id": 1365, "verse_number": "३-३-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017631, "chapter_id": 1365, "verse_number": "३-३-१३", "content_sanskrit": "एवमुक्तस्तु धौम्येन तत्कालसदृशं वचः।\nततस्त्वध्यापयामास मन्त्रं सर्वार्थसाधकम्।\nअष्टाक्षरं परं मन्त्रमार्तस्य सततं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017632, "chapter_id": 1365, "verse_number": "३-३-१४", "content_sanskrit": "[विप्रत्यागसमाधिस्थः संयतात्मा दृढव्रतः।\nधर्मराजो विशुद्धात्मा तप आतिष्ठदुत्तमम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017633, "chapter_id": 1365, "verse_number": "३-३-१५", "content_sanskrit": "पुष्पोपहारैर्बलिभिरर्चयित्वा दिवाकरम्।\nसोऽवगाह्य जलं राजा देवस्याभिमुखोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017634, "chapter_id": 1365, "verse_number": "३-३-१६", "content_sanskrit": "गाङ्गेयं वार्युपस्पृश्य प्राणायामेन तस्थिवान्।\n[शुचिः प्रयतवाग्भूत्वा स्तोत्रमारब्धवांस्ततः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017635, "chapter_id": 1365, "verse_number": "३-३-१७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017636, "chapter_id": 1365, "verse_number": "३-३-१७", "content_sanskrit": "त्वं भानो जगतश्चक्षुस्त्वमात्मा सर्वदेहिनाम्।\nत्वं योनिः सर्वभूतानां त्वमाचारः क्रियावतां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017637, "chapter_id": 1365, "verse_number": "३-३-१८", "content_sanskrit": "त्वं गतिः सर्वसाङ्ख्यानां योगिनां त्वं परायणम्।\nअनावृतार्गलद्वारं त्वं गतिस्त्वं मुमुक्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017638, "chapter_id": 1365, "verse_number": "३-३-१९", "content_sanskrit": "त्वया संधार्यते लोकस्त्वया लोकः प्रकाश्यते।\nत्वयापवित्रीक्रियते निर्व्याजं पाल्यते त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017639, "chapter_id": 1365, "verse_number": "३-३-२०", "content_sanskrit": "त्वामुपस्थाय काले तु ब्राह्मणा वेदपारगाः।\nस्वशाखाविहितैर्मन्त्रैरर्चन्त्यृषिगणार्चित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017640, "chapter_id": 1365, "verse_number": "३-३-२१", "content_sanskrit": "तव दिव्यं रथं यान्तमनुयान्ति वरार्थिनः।\nसिद्धचारणगन्धर्वा यक्षगुह्यकपन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017641, "chapter_id": 1365, "verse_number": "३-३-२२", "content_sanskrit": "त्रयस्त्रिंशच्च वै देवास्तथा वैमानिका गणाः।\nसोपेन्द्राः समहेन्द्राश्च त्वामिष्ट्वासिद्धिमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017642, "chapter_id": 1365, "verse_number": "३-३-२३", "content_sanskrit": "उपयान्त्यर्चयित्वा तु त्वां वै प्राप्तमनोरथाः।\nदिव्यमन्दारमालाभिस्तूर्णं विद्याधरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017643, "chapter_id": 1365, "verse_number": "३-३-२४", "content_sanskrit": "गुह्याः पितृगणाः सप्त ये दिव्या ये च मानुषाः।\nते पूजयित्वा त्वामेव गच्छन्त्याशु प्रधानताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017644, "chapter_id": 1365, "verse_number": "३-३-२५", "content_sanskrit": "वसवो मरुतो रुद्रा ये च साध्या मरीचिपाः।\nवालखिल्यादयः सिद्धाः श्रेष्ठत्वं प्राणिनां गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017645, "chapter_id": 1365, "verse_number": "३-३-२६", "content_sanskrit": "सब्रह्मकेषु लोकेषु सप्तस्वप्यखिलेषु च।\nन तद्भूतमहं मन्ये यदर्कादतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017646, "chapter_id": 1365, "verse_number": "३-३-२७", "content_sanskrit": "सन्ति चान्यानि सत्वानिवीर्यवन्ति महान्ति च।\nन तु तेषां तथा दीप्तिः प्रभावो वायथा तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017647, "chapter_id": 1365, "verse_number": "३-३-२८", "content_sanskrit": "ज्योतीषित्वयि सर्वाणि त्वं सर्वज्योतिषां पतिः।\nत्वयिसत्त्वं च सत्त्वं च सर्वेभावाश्च सात्त्विकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017648, "chapter_id": 1365, "verse_number": "३-३-२९", "content_sanskrit": "त्वत्तेजसा कृतंचक्रं सुनाभं विश्वकर्मणा।\nदेवारीणां मदो येन नाशितः शार्ङ्गधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017649, "chapter_id": 1365, "verse_number": "३-३-३०", "content_sanskrit": "त्वमादायांशुभिस्तेजो निदाघे सर्वदेहिनाम्।\nसर्वौषधिरसानां च पुनर्वर्षासु मुञ्चसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017650, "chapter_id": 1365, "verse_number": "३-३-३१", "content_sanskrit": "तपन्त्यन्ते दहन्त्यन्ये गर्जन्त्यन्ये तथा घनाः।\nविद्योतन्ते प्रवर्षन्ति तव प्रावृषि रश्मयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017651, "chapter_id": 1365, "verse_number": "३-३-३२", "content_sanskrit": "न तथा सुखयत्यग्निर्न प्रावारा न कम्बलाः।\nशीतवातार्दितं लोकं यथा तव मरीचयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017652, "chapter_id": 1365, "verse_number": "३-३-३३", "content_sanskrit": "त्रयोदशद्वीपवतीं गोभिर्भासयसे महीम्।\nत्रयाणामपि लोकानां हितायैकः प्रवर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017653, "chapter_id": 1365, "verse_number": "३-३-३४", "content_sanskrit": "तव यद्युदयो न स्यादन्धं जगदिदं भवेत्।\nन च धर्मार्थकामेषु प्रवर्तेरन्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017654, "chapter_id": 1365, "verse_number": "३-३-३५", "content_sanskrit": "आधानपशुबन्धेष्टिमन्त्रयज्ञतपःक्रियाः।\nत्वत्प्रसादादवाप्यन्ते ब्रह्मक्षत्रविशां गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017655, "chapter_id": 1365, "verse_number": "३-३-३६", "content_sanskrit": "यदहर्ब्रह्मणः प्रोक्तं सहस्रयुगसंमितम्।\nतस्य त्वमादिरन्तश्च कालज्ञैः परिकीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017656, "chapter_id": 1365, "verse_number": "३-३-३७", "content_sanskrit": "मनूनां मनुपुत्राणां जगतोऽमानवस्य च।\nमन्वन्तराणां सर्वेषामीश्वराणां त्वमीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017657, "chapter_id": 1365, "verse_number": "३-३-३८", "content_sanskrit": "संहारकाले संप्राप्ते तव क्रोधविनिःसृतः।\nसंवर्तकाग्निस्त्रैलोक्यं भस्मीकृत्यावतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017658, "chapter_id": 1365, "verse_number": "३-३-३९", "content_sanskrit": "त्वद्दीधितिसमुत्पन्ना नानावर्ण महाघनाः।\nसैरावताः साशनयः कुर्वन्त्याभूतसंप्लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017659, "chapter_id": 1365, "verse_number": "३-३-४०", "content_sanskrit": "कृत्वा द्वादशधाऽऽत्मानं द्वादशादित्यतां गतः।\nसंहृत्यैकार्णवं सर्वं त्वं शोषयसि रश्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017660, "chapter_id": 1365, "verse_number": "३-३-४१", "content_sanskrit": "त्वामिन्द्रमाहुस्त्वं रुद्रस्त्वं विष्णुस्त्वं प्रजापतिः।\nत्वमग्निस्त्वं मनः सूक्ष्मं प्रभुस्त्वं ब्रह्मशाश्वतं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017661, "chapter_id": 1365, "verse_number": "३-३-४२", "content_sanskrit": "त्वं हंसः सविता भानुरंशुमाली वृषाकपिः।\nविवस्वान्मिहिरः पूषा मित्रो धर्मस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017662, "chapter_id": 1365, "verse_number": "३-३-४३", "content_sanskrit": "सहस्ररश्मिरादित्यस्तपनस्त्वं गवां पतिः।\nमार्तण्डोऽर्को रविः सूर्यः शरण्यो दिनकृत्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017663, "chapter_id": 1365, "verse_number": "३-३-४४", "content_sanskrit": "दिवाकरः सप्तसप्तिर्धामकेशी विरोचनः।\nआशुगामी तमोघ्नश्च हरिताश्वश्च कीर्त्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017664, "chapter_id": 1365, "verse_number": "३-३-४५", "content_sanskrit": "सप्तम्यागथवा षष्ठ्यां भक्त्या पूजां करोति यः।\nअनिर्विण्णोऽनहंकारी तं लक्ष्मीर्भजते नरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017665, "chapter_id": 1365, "verse_number": "३-३-४६", "content_sanskrit": "न तेषामापदः सन्ति नाधयो व्याधयस्तथा।\nये तवानन्यमनसा कुर्वन्त्यर्चनवन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017666, "chapter_id": 1365, "verse_number": "३-३-४७", "content_sanskrit": "सर्वरोगैर्विरहिताः सर्वपापाविवर्जिताः।\nत्वद्भावभक्ताः सुखिनो भवन्ति चिरजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017667, "chapter_id": 1365, "verse_number": "३-३-४८", "content_sanskrit": "त्वं ममापन्नकामस्य सर्वातिथ्यं चिकीर्षतः।\nअन्नमन्नपते दातुमभितः श्रद्धयाऽर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017668, "chapter_id": 1365, "verse_number": "३-३-४९", "content_sanskrit": "येच तेऽनुचराः सर्वे पादोपान्तं समाश्रिताः।\nमाठरारुणदण्डाद्यास्तांस्तान्वन्देऽशनिक्षुभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017669, "chapter_id": 1365, "verse_number": "३-३-५०", "content_sanskrit": "क्षुभया सहिता मैत्री याश्चान्या भूतमातरः।\nताश्च सर्वा नमस्यामि पान्तु मां शरणागतम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017670, "chapter_id": 1365, "verse_number": "३-३-५१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017671, "chapter_id": 1365, "verse_number": "३-३-५१", "content_sanskrit": "कण्ठदघ्ने जले स्थित्वा मन्त्रैः स्तोत्रैश्च तोषितः।\nततो दिवाकरः प्रीतो दर्शयामास पाण्डवम्।\nदीप्यमानः स्ववपुषा ज्वलन्निव हुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017672, "chapter_id": 1365, "verse_number": "३-३-५२x", "content_sanskrit": "विवस्वानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017673, "chapter_id": 1365, "verse_number": "३-३-५२", "content_sanskrit": "यत्तेऽभिलषितं किंचित्तत्त्वं सर्वमवाप्स्यसि।\nअहमन्नं प्रदास्यामि सप्त पञ्च च ते समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017674, "chapter_id": 1365, "verse_number": "३-३-५३", "content_sanskrit": "गृह्णीष्व पिठरं ताम्रं मया दत्तं नराधिप।\nयावद्वर्त्स्यति पाञ्चाली पात्रेणानेन सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2017675, "chapter_id": 1365, "verse_number": "३-३-५४", "content_sanskrit": "फलमूलामिषं शाकं संस्कृतं यन्महानसे।\nचतुर्विधं तदन्नाद्यमक्षय्यं ते भविष्यति।\nइतश्चतुर्दशे वर्षे भूयो राज्यमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2017676, "chapter_id": 1365, "verse_number": "३-३-५५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2017677, "chapter_id": 1365, "verse_number": "३-३-५५", "content_sanskrit": "एवमुक्त्वा तु भगवांस्तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2017678, "chapter_id": 1365, "verse_number": "३-३-५६", "content_sanskrit": "लब्ध्वा वरं तु कौन्तेयो जलादुत्तीर्य धर्मवित्।\nजग्राह पादौ धौम्यस्य भ्रातॄंश्च परिषस्वजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2017679, "chapter_id": 1365, "verse_number": "३-३-५७", "content_sanskrit": "द्रौपद्या सह-संगम्य पश्यमानोऽपयात्प्राभुः।\nमहानसे तदान्नं तु साधयामास पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2017680, "chapter_id": 1365, "verse_number": "३-३-५८", "content_sanskrit": "संस्कृतं प्रसवं याति स्वल्पमन्नं चतुर्विधम्।\nअक्षय्यं वर्धते चान्नं तेनाभोजयत द्विजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2017681, "chapter_id": 1365, "verse_number": "३-३-५९", "content_sanskrit": "भुक्तवत्सु च विप्रेषु भोजयित्वाऽनुजानपि।\nशेषं विघससंज्ञं तुपश्चाद्भुङ्क्ते युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2017682, "chapter_id": 1365, "verse_number": "३-३-६०", "content_sanskrit": "युधिष्ठिरं भोजयित्वा शेषमश्नाति पार्षती।\n[द्रौपद्यां भुज्यमानायां तदन्नं क्षयमेति च ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2017683, "chapter_id": 1365, "verse_number": "३-३-६१", "content_sanskrit": "एवं दिवाकरात्प्राप्य दिवाकरसमप्रभः।\nकामान्मनोभिलषितान्ब्राह्मणेभ्योऽददात्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2017684, "chapter_id": 1365, "verse_number": "३-३-६२", "content_sanskrit": "पुरोहितपुरोगाश्च तिथिनक्षत्रपर्वसु।\nइज्यार्थे संप्रवर्तन्ते विधिमन्त्रप्रमाणतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2017685, "chapter_id": 1365, "verse_number": "३-३-६३", "content_sanskrit": "ततः कृतस्वस्त्ययना धौम्येन सह पाण्डवाः।\nद्विजसङ्घैः परिवृताः प्रययुः काम्यकं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2017686, "chapter_id": 1365, "verse_number": "३-३-६४x", "content_sanskrit": "`जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2017687, "chapter_id": 1365, "verse_number": "३-३-६४", "content_sanskrit": "पुष्पोपहारबलिभिर्बहुशश्च यथाविधि।\nसर्वात्मभूतं संपूज्य यतप्राणो जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2017688, "chapter_id": 1365, "verse_number": "३-३-६५", "content_sanskrit": "स्तवेन केन विप्रर्षे स तु राजा युधिष्ठिरः।\nविप्रार्थमाराधितवान्सूर्यमद्भुतविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2017689, "chapter_id": 1365, "verse_number": "३-३-६६", "content_sanskrit": "मयि स्नेहोऽस्ति चेद्ब्रह्मन्यद्यनुग्रहभागहम्।\nभगवन्नास्ति चेद्गुद्यं तच्च मे ब्रूहि सांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2017690, "chapter_id": 1365, "verse_number": "३-३-६७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2017691, "chapter_id": 1365, "verse_number": "३-३-६७", "content_sanskrit": "शृणुष्वांवहितो राजञ्शुचिर्भूत्वा समाहितः।\nक्षणं च कुरु राजेन्द्र गुह्यं वक्ष्यामि ते हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2017692, "chapter_id": 1365, "verse_number": "३-३-६८", "content_sanskrit": "धौम्येन तु यथाप्रोक्तं पार्थाय सुमहात्मने।\nनाम्नामष्टोत्तरं पुण्यं शतं तच्छृणु भूपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2017693, "chapter_id": 1365, "verse_number": "३-३-६९", "content_sanskrit": "सूर्योऽर्यभा भगस्त्वष्टा पूषाऽर्कः सविता रविः।\nगभस्तिमानजः कालो मृत्युर्धाता प्रभाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2017694, "chapter_id": 1365, "verse_number": "३-३-७०", "content_sanskrit": "पृथिव्यापश्च तेजश्च खं वायुश्च परायणम्।\nसोमो बृहस्पतिः शुक्रो बुधोऽङ्गारक एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2017695, "chapter_id": 1365, "verse_number": "३-३-७१", "content_sanskrit": "इन्द्रो विवस्वान्दीप्तांशुः शुचिः शौरिः शनैश्चरः।\nब्रह्मा विष्णुश्च रुद्रश्च स्कन्दो वैश्रवणो यमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2017696, "chapter_id": 1365, "verse_number": "३-३-७२", "content_sanskrit": "वैद्युतो जाठरश्चाग्निरैन्धनस्तेजसां पतिः।\nधर्मध्वजो वेदकर्ता वेगाङ्गो वेदवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2017697, "chapter_id": 1365, "verse_number": "३-३-७३", "content_sanskrit": "कृतं त्रेता द्वापरश्च कलिः सर्वामराश्रयः।\nकला काष्ठा मुहूर्ताश्च पक्षा मासा ऋतुस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2017698, "chapter_id": 1365, "verse_number": "३-३-७४", "content_sanskrit": "संवत्सरकरोऽश्वत्थः कालचक्रो विभावसुः।\nपुरुषः शाश्वतो योगी व्यक्ताव्यक्तः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2017699, "chapter_id": 1365, "verse_number": "३-३-७५", "content_sanskrit": "लोकाध्यक्षः सुराध्यक्षो विश्वकर्मा तमोनुदः।\nवरुणः सागरोंशश्च जीमूतो जीवनोऽरिहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2017700, "chapter_id": 1365, "verse_number": "३-३-७६", "content_sanskrit": "भूताश्रयो भूतपति- सर्वभूतनिषेवितः।\n`मणिः सुवर्णो भूतात्मा कामदः सर्वतोमुखः।\n[स्रष्टा संवर्तको वह्निः सर्वस्यादिरलोलुपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2017701, "chapter_id": 1365, "verse_number": "३-३-७७", "content_sanskrit": "अनन्तः कपिलो भानुः कामदः सर्वतोमुखः।]\nजयो विशालो वरदः सर्वधातुनिषेचिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2017702, "chapter_id": 1365, "verse_number": "३-३-७८", "content_sanskrit": "मनः सुपर्णो भूतादिः शीघ्रगः प्राणधारकः।\nधन्वन्तरिर्धूमकेतुरादिदेवोऽदितेः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2017703, "chapter_id": 1365, "verse_number": "३-३-७९", "content_sanskrit": "द्वादशात्माऽरविन्दाक्षः पिता माता पितामहः।\nस्वर्गद्वारं प्रजाद्वारं मोक्षद्वारं त्रिविष्टपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2017704, "chapter_id": 1365, "verse_number": "३-३-८०", "content_sanskrit": "देवकर्ता प्रशान्तात्मा विश्वात्मा विश्वतोमुखः।\nचराचरात्मा सूक्ष्मात्मा मैत्रेण वपुषाऽन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2017705, "chapter_id": 1365, "verse_number": "३-३-८१", "content_sanskrit": "एतद्वै कीर्तनीयस्य सूर्यस्यामिततेजसः।\nनाम्नामष्टशतं पुण्यं शक्रेणोक्तं महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2017706, "chapter_id": 1365, "verse_number": "३-३-८२", "content_sanskrit": "शक्राच्च नारदः प्राप्तो धौम्यश्च तदन्तरम्।\nधौम्याद्युधिष्ठरः प्राप्य सर्वान्कमानवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2017707, "chapter_id": 1365, "verse_number": "३-३-८३", "content_sanskrit": "सुरगणपितृयक्षसेवितं\nह्यसुरनिशाचरसिद्धवन्दितम्।\nवरकनकहुताशनप्रभं\nत्वमपि मनस्यभिधेहि भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2017708, "chapter_id": 1365, "verse_number": "३-३-८४", "content_sanskrit": "सूर्योदये यः सुसमाहितः पठे-\nत्त पुत्रदारान्धनरत्नसंचयान्।\nलभेत जातिस्मरतां नरः सदा\nधृतिं च मेधां च स विन्दते पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2017709, "chapter_id": 1365, "verse_number": "३-३-८५", "content_sanskrit": "[इमं स्तवं देववरस्य यो नरः\nप्रकीर्तयेच्छुचिसुमनाः समाहितः।\nस मुच्यते शोकदवाग्निसागरा-\nल्लभेत कामान्मनसा यथेप्सितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2017710, "chapter_id": 1365, "verse_number": "३-३-८६", "content_sanskrit": "[इमं स्तवं प्रयतमनाः समाधिना\nपछेदिहान्योऽपि वरं समर्थयन्।\nतत्त्स्य दद्याच्च रविर्मनीषितं\nतदाऽऽप्नुयाद्यद्यपि तत्सुदुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2017711, "chapter_id": 1365, "verse_number": "३-३-८७", "content_sanskrit": "यश्चेदं धारयेन्नित्यं शृणुयाद्वाप्यभीक्ष्णशः।\nपुत्रार्थी लभते पुत्रं धनार्थी लभते धनम्।\nविद्यार्थी लभते विद्यां पुरुषोप्यथवा स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2017712, "chapter_id": 1365, "verse_number": "३-३-८८", "content_sanskrit": "उभे संध्ये पठेन्नित्यं नारी वा पुरुषो यदि।\nआपदं प्राप्य मुच्येत बद्धो मुच्येत बन्धनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2017713, "chapter_id": 1365, "verse_number": "३-३-८९", "content_sanskrit": "संग्रामे च जयेन्नित्यं विपुलं चाप्नुयाद्वसु।\nमुच्यते सर्वपापेभ्यः सूर्यलोकं स गच्छति ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2017714, "chapter_id": 1365, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि किर्मीरवधपर्वणि तृतीयोऽध्यायः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]