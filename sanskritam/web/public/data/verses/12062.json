[{"id": 50026109, "chapter_id": 12062, "verse_number": "1", "content_sanskrit": "स्वयमुद्देशवान् पूर्ववर्णपूर्वो नमोयुतः। सतारोऽष्टाक्षरश्चैव नवार्णश्च मनू स्मृतौ॥ ५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026110, "chapter_id": 12062, "verse_number": "2", "content_sanskrit": "प्रोद्यद्दिवाकरसमानतनुं सहस्रसूर्योरुदीधितिभिराप्तसमस्तलोकम्। ज्ञानाभयाङ्कितकरं कपिलं च दत्तं ध्यायेदजादिसमितिं प्रतिबोधयन्तम्॥ ५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026111, "chapter_id": 12062, "verse_number": "3", "content_sanskrit": "अधृष्यताज्ञानमोक्षप्रदौ भक्तेष्विमौ सदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]