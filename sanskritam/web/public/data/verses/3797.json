[{"id": 2129845, "chapter_id": 3797, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129846, "chapter_id": 3797, "verse_number": "१", "content_sanskrit": "भीमसेन यमौ चोभौ पाञ्चालि च निबोधत ।\nनास्ति भूतस्य नाशो वै पश्यतास्मान् वनेचरान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129847, "chapter_id": 3797, "verse_number": "२", "content_sanskrit": "दुर्बलाः क्लेशिताः स्मेति यद् ध्रुवामेतरेतरम् ।\nअशक्येऽपि व्रजामो यद् धनञ्जयदिदृक्षया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129848, "chapter_id": 3797, "verse_number": "३", "content_sanskrit": "तन्मे दहति गात्राणि तूलराशिमिवानलः ।\nयच्च वीरं न पश्यामि धनञ्जयमुपान्तिकात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129849, "chapter_id": 3797, "verse_number": "४", "content_sanskrit": "तस्य दर्शनतृष्णं मां सानुजं वनमास्थितम् ।\nयाज्ञसेन्याः परामर्शः स च वीर दहत्युत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129850, "chapter_id": 3797, "verse_number": "५", "content_sanskrit": "नकुलात् पूर्वजं पार्थं न पश्याम्यमितौजसम् ।\nअजेयमुग्रधन्वानं तेन तप्ये वृकोदर \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129851, "chapter_id": 3797, "verse_number": "६", "content_sanskrit": "तीर्थानि चैव रम्याणि वनानि च सरांसि च ।\nचरामि सह युष्माभिस्तस्य दर्शनकाङ्क्षया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129852, "chapter_id": 3797, "verse_number": "७", "content_sanskrit": "पञ्चवर्षाण्यहं वीरं सत्यसन्धं धनञ्जयम्।\nयन्न पश्यामि बीभत्सुं तेन तप्ये वृकोदर\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129853, "chapter_id": 3797, "verse_number": "८", "content_sanskrit": "तं वै श्यामं गुडाकेशं सिंहविक्रान्तगामिनम् ।\nन पश्यामि महाबाहुं तेन तप्ये वृकोदर\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129854, "chapter_id": 3797, "verse_number": "९", "content_sanskrit": "कृतास्त्रं निपुणं युद्धेऽप्रतिमानं धनुष्मताम् ।\nन पश्यामि कुरुश्रेष्ठ तेन तप्ये वृकोदर \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129855, "chapter_id": 3797, "verse_number": "१०", "content_sanskrit": "चरन्तमरिसङ्घेषु काले क्रुद्धमिवान्तकम् ।\nप्रभिन्नमिव मातङ्गं सिंहस्कन्धं धनञ्जयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129856, "chapter_id": 3797, "verse_number": "११", "content_sanskrit": "यः स शक्रादनवरो वीर्येण द्रविणेन च ।\nयमयोः पूर्वजः पार्थः श्वेताश्वोऽमितविक्रमः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129857, "chapter_id": 3797, "verse_number": "१२", "content_sanskrit": "नारायणसमो युद्धे सत्यसन्धो दृढव्रतः ।\nतं ममापश्यतो भीम न शान्तिर्हृदयस्य वै \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129858, "chapter_id": 3797, "verse_number": "१३", "content_sanskrit": "दुःखेन महताऽऽविष्टस्तं न पश्यामि फल्गुनम् ।\nअजेयमुग्रधन्वानं तेन तप्ये वृकोदर \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129859, "chapter_id": 3797, "verse_number": "१४", "content_sanskrit": "सततं यः क्षमाशीलः क्षिप्यमाणोऽप्यणीयसा ।\nऋजुमार्गप्रपन्नस्य शर्मदाताभयस्य च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129860, "chapter_id": 3797, "verse_number": "१५", "content_sanskrit": "स तु जिह्मप्रवृत्तस्य माययाऽभिजिघांसतः ।\nअपि वज्रधरस्यापि भवेत्कालविषोपमः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129861, "chapter_id": 3797, "verse_number": "", "content_sanskrit": "शत्रोरपि प्रपन्नस्य सोऽनृशंसः प्रतापवान् ।\nदाताऽभयस्य बीभत्सुरमितात्मा महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129862, "chapter_id": 3797, "verse_number": "१६", "content_sanskrit": "सदा जिष्णुरदीनात्मा महात्मा पाकशासनिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129863, "chapter_id": 3797, "verse_number": "१७", "content_sanskrit": "सर्वेषामाश्रयोऽस्माकं रणेऽरीणां प्रमर्दिता ।\nआहर्ता सर्वरत्नानां सर्वेषां नः सुखावहः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129864, "chapter_id": 3797, "verse_number": "१८", "content_sanskrit": "रत्नानि यस्य वीर्येण दिव्यान्यासन् पुरा मम ।\nबहूनि बहुजातीनि यानि प्राप्तः सुयोधनः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129865, "chapter_id": 3797, "verse_number": "१९", "content_sanskrit": "यस्य बाहुबलाद् वीर सभा चासीत् पुरा मम ।\nसर्वरत्नमयी ख्याता त्रिषु लोकेषु पाण्डव \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129866, "chapter_id": 3797, "verse_number": "२०", "content_sanskrit": "वासुदेवसमं वीर्ये कार्तवीर्यसमं युधि ।\nअजेयममितं युद्धे तं न पश्यामि फल्गुनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129867, "chapter_id": 3797, "verse_number": "२१", "content_sanskrit": "सङ्कर्षणं महावीर्यं त्वां च भीमापराजितम् ।\nअनुयातः स्ववीर्येण वासुदेवं च शत्रुहा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129868, "chapter_id": 3797, "verse_number": "२२", "content_sanskrit": "यस्य बाहुबले तुल्यः प्रभावे च पुरन्दरः ।\nजवे वायुर्मुखे सोमः क्रोधे मृत्युः सनातनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129869, "chapter_id": 3797, "verse_number": "२३", "content_sanskrit": "ते वयं तं नरव्याघ्रं सर्वे वीर दिदृक्षवः ।\nप्रवेक्ष्यामो महाबाहो पर्वतं गन्धमादनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129870, "chapter_id": 3797, "verse_number": "२४", "content_sanskrit": "विशाला बदरी यत्र नरनारायणाश्रमः ।\nतं सदाऽध्युषितं यक्षैर्द्रक्ष्यामो गिरिमुत्तमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129871, "chapter_id": 3797, "verse_number": "२५", "content_sanskrit": "कुबेरनळिनीं रम्यां राक्षसैरभिसेविताम् ।\nपद्भिरेव गमिष्यामस्तप्यमाना महत्तपः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129872, "chapter_id": 3797, "verse_number": "२६", "content_sanskrit": "न च यानवता शक्यो गन्तुं देशो वृकोदर ।\nन नृशंसेन लुब्धेन नाप्रशान्तेन भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129873, "chapter_id": 3797, "verse_number": "२७", "content_sanskrit": "तत्र सर्वे गमिष्यामो भीमार्जुनगवेषिणः ।\nसायुधा बद्धनिस्त्रिंशाः सार्धं विप्रैर्महाव्रतैः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129874, "chapter_id": 3797, "verse_number": "२८", "content_sanskrit": "मक्षिकादंशमशकान् सिंहान् व्याघ्रान् सरीसृपान् ।\nप्राप्नोत्यनियतः पार्थ नियतस्तान् न पश्यति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129875, "chapter_id": 3797, "verse_number": "२९", "content_sanskrit": "ते वयं नियतात्मानः पर्वतं गन्धमादनम् ।\nप्रवेक्ष्यामो मिताहारा धनञ्जयदिदृक्षया(वः)\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129876, "chapter_id": 3797, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टत्रिंशदधिकशततमोऽध्यायः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129877, "chapter_id": 3797, "verse_number": "९४", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि चतुर्नवतितमोऽध्यायः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]