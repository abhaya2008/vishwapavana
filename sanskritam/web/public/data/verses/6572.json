    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20001460,
    "chapter_id": 6572,
    "verse_number": "3.10",
    "content_sanskrit": "(चेटी) आर्ये ! मेदानीमन्यच्चिन्तयित्वा । एष जामातृको मणिभूमौ स्नायति । शीघ्रं तावद् गुम्फत्वार्या ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
