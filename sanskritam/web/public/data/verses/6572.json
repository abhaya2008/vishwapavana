[
  {
    "id": 20001451,
    "chapter_id": 6572,
    "verse_number": "3.1",
    "content_sanskrit": "(ततः प्रविशति विचिन्तयन्ती वासवदत्ता)",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20001452,
    "chapter_id": 6572,
    "verse_number": "3.2",
    "content_sanskrit": "(वासवदत्ता) विवाहामोदसङ्कुलेऽन्तःपुरचतुःशाले परित्यज्य पद्मावतीमिहागतास्मि प्रमदवनम् । यावदिदानीं भागधेयनिर्वृत्तं दुःखं विनोदयामि । अहो अत्याहितम् । आर्यपुत्रोऽपि नाम परकीयः संवृत्तः । यावदुपविशामि । धन्या खलु चक्रवाकवधूः यान्योन्यविरहिता न जीवति । न खल्वहं प्राणान् परित्यजामि । आर्यपुत्रं प्रेक्ष इत्यनेन मनोरथेन जीवामि मन्दभागा ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20001453,
    "chapter_id": 6572,
    "verse_number": "3.3",
    "content_sanskrit": "(ततः प्रविशति पुष्पाणि गृहीत्वा चेटी)",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20001454,
    "chapter_id": 6572,
    "verse_number": "3.4",
    "content_sanskrit": "(चेटी) कुत्र नु खलु गता आर्यावन्तिका । अम्मो इयं चिन्ताशून्यहृदया नीहारप्रतिहतचन्द्रलेखेवामण्डितभद्रकं वेषं धारयन्ती प्रियङ्गुशिलापट्टके उपविष्टा । यावदुपसर्पामि । आर्ये ! आवन्तिके ! कः कालः, त्वामन्विष्यामि ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20001455,
    "chapter_id": 6572,
    "verse_number": "3.5",
    "content_sanskrit": "(वासवदत्ता) किं निमित्तम् ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20001456,
    "chapter_id": 6572,
    "verse_number": "3.6",
    "content_sanskrit": "(चेटी) अस्माकं भर्त्री भणति 'महाकुलप्रसूता स्निग्धा निपुणा' इति । इमां तावत् कौतुकमालिकां गुम्फत्वार्या ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20001457,
    "chapter_id": 6572,
    "verse_number": "3.7",
    "content_sanskrit": "(वासवदत्ता) अथ कस्मै किल गुम्फितव्यम् ।",
