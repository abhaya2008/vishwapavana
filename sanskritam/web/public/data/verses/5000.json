[{"id": 2188189, "chapter_id": 5000, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188190, "chapter_id": 5000, "verse_number": "१", "content_sanskrit": "केन वृत्तेन वृत्तज्ञो जनको मिथिलाधिपः ।\nजगाम मोक्षं धर्मज्ञो भोगानुत्सृज्य मानुषान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188191, "chapter_id": 5000, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188192, "chapter_id": 5000, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nयेन वृत्तेन वृत्तज्ञः स जगाम महत् सुखम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188193, "chapter_id": 5000, "verse_number": "३", "content_sanskrit": "जनको जनदेवस्तु मिथिलायां जनाधिपः ।\nऔर्ध्वदेहिकधर्माणामासीद्युक्तो विचिन्तने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188194, "chapter_id": 5000, "verse_number": "४", "content_sanskrit": "तस्य स्म शतमाचार्या वसन्ति सततं गृहे ।\nदर्शयन्तः पृथग्धर्मान्नानापाषण्डवादिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188195, "chapter_id": 5000, "verse_number": "५", "content_sanskrit": "स तेषां प्रेत्यभावेन प्रेत्यजातौ विनिश्चये ।\nआगमस्थः स भूयिष्ठमात्मतत्त्वे न तुष्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188196, "chapter_id": 5000, "verse_number": "६", "content_sanskrit": "तत्र पञ्चशिखो नाम कापिलेयो महामुनिः ।\nपरिधावन्महीं कृत्स्नां जगाम मिथिलामपि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188197, "chapter_id": 5000, "verse_number": "७", "content_sanskrit": "सर्वसंन्यासधर्माणां तत्त्वज्ञानविनिश्चये ।\nसुपर्यवसितार्थश्च निर्द्वंद्वो नष्टसंशयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188198, "chapter_id": 5000, "verse_number": "८", "content_sanskrit": "ऋषीणामाहुरेकं यं कामादवसितं नृषु ।\nशाश्वतं सुखमत्यन्तमन्विच्छन् स सुदुर्लभम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188199, "chapter_id": 5000, "verse_number": "९", "content_sanskrit": "यमाहुः कपिलं साङ्ख्याः परमर्षिं प्रजापतिम् ।\nस मन्ये तेन रूपेण विस्मापयति हि स्वयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188200, "chapter_id": 5000, "verse_number": "१०", "content_sanskrit": "आसुरेः प्रथमं शिष्यं यमाहुश्चिरजीविनम् ।\nपञ्चस्रोतसि यः सत्रमास्ते वर्षसहस्रिकम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188201, "chapter_id": 5000, "verse_number": "११", "content_sanskrit": "तं समासीनमागम्य मण्डलं कापिलं महत् ।\nपुरुषावस्थमव्यक्तं परमार्थं निबोधयत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188202, "chapter_id": 5000, "verse_number": "१२", "content_sanskrit": "इष्टिसत्रेण संसिद्धो भूयश्च तपसा मुनिः ।\nक्षेत्रक्षेत्रज्ञयोर्व्यक्तिं बुबुधे देवदर्शनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188203, "chapter_id": 5000, "verse_number": "१३", "content_sanskrit": "यत्तदेकाक्षरं ब्रह्म नानारूपं प्रदृश्यते ।\nआसुरिर्मण्डले तस्मिन् प्रतिपेदे तदव्ययम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188204, "chapter_id": 5000, "verse_number": "१४", "content_sanskrit": "तस्य पञ्चशिखः शिष्यो मानुष्या पयसा भृतः ।\nब्राह्मणी कपिला नाम काचिदासीत् कुटुम्बिनी\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188205, "chapter_id": 5000, "verse_number": "१५", "content_sanskrit": "तस्याः पुत्रत्वमागम्य स्त्रियाः स पिबति स्तनौ ।\nततः स कापिलेयत्वं लेभे बुद्धिं च नैष्ठिकीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188206, "chapter_id": 5000, "verse_number": "१६", "content_sanskrit": "एतन्मे भगवानाह कापिलेयाय सम्भवम् ।\nतस्य तत् कापिलेयत्वं सर्ववित्त्वमनुत्तमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188207, "chapter_id": 5000, "verse_number": "१७", "content_sanskrit": "सामान्यं कपिलो ज्ञात्वा धर्मज्ञानामनुत्तमम् ।\nउपेत्य शतमाचार्यान्मोहयामास हेतुभिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188208, "chapter_id": 5000, "verse_number": "१८", "content_sanskrit": "जनकस्त्वभिसंरक्तः कापिलेयानुदर्शनात् ।\nउत्सृज्य शतमाचार्यान् पृष्ठतोऽनुजगाम तम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188209, "chapter_id": 5000, "verse_number": "१९", "content_sanskrit": "तस्मै परमकल्पाय प्रणताय च धर्मतः ।\nअब्रवीत् परमं मोक्षं यत्तत् साङ्ख्यं विधीयते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188210, "chapter_id": 5000, "verse_number": "२०", "content_sanskrit": "जातिनिर्वेदमुक्त्वा हि कर्मनिर्वेदमब्रवीत् ।\nकर्मनिर्वेदमुक्त्वा च सर्वनिर्वेदमब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188211, "chapter_id": 5000, "verse_number": "२१", "content_sanskrit": "यदर्थं कर्मसंसर्गः कर्मणां च फलोदयः ।\nतदनाश्वासिकं मोघं विनाशि चलमध्रुवम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2188212, "chapter_id": 5000, "verse_number": "२२", "content_sanskrit": "दृश्यमाने विनाशे च प्रत्यक्षे लोकसाक्षिके ।\nआगमात् परमस्तीति ब्रुवन्नपि पराजितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2188213, "chapter_id": 5000, "verse_number": "२३", "content_sanskrit": "अनात्मा ह्यात्मनो मृत्युः क्लेशो मृत्युर्जरामयः ।\nआत्मानं मन्यते मोहात्तदसम्यक्परं मतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2188214, "chapter_id": 5000, "verse_number": "२४", "content_sanskrit": "अथ चेदेवमप्यस्ति यल्लोके नोपपद्यते ।\nअजरोऽयममृत्युश्च राजासौ मन्यते तथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2188215, "chapter_id": 5000, "verse_number": "२५", "content_sanskrit": "अस्ति नास्तीति चाप्येतत्तस्मिन्नसति लक्षणे ।\nकिमधिष्ठाय तद् ब्रूयाल्लोकयात्राविनिश्चयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2188216, "chapter_id": 5000, "verse_number": "", "content_sanskrit": "प्रत्यक्षं ह्येतयोर्मूलं कृतान्तैतिह्ययोरपि ।\nप्रत्यक्षो ह्यागमोऽभिन्नः कृतान्तो वा न किञ्चन\t॥२६ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2188217, "chapter_id": 5000, "verse_number": "", "content_sanskrit": "यत्र तत्रानुमानेऽस्ति कृतं भावयतेऽपि वा ।\nअन्यो जीवः शरीरस्य नास्तिकानां मते स्मृतः\t॥२७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2188218, "chapter_id": 5000, "verse_number": "२८", "content_sanskrit": "रेतो धातुर्वटकणिका घृतधूमाधिवासनम् ।\nजातिस्मृतिरयस्कान्तः सूर्यकान्तोऽम्बुभक्षणम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2188219, "chapter_id": 5000, "verse_number": "२९", "content_sanskrit": "प्रेत्य भूतात्ययश्चैव देवताभ्युपयाचनम् ।\nमृते कर्मनिवृत्तिश्च प्रमाणमिति निश्चयः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2188220, "chapter_id": 5000, "verse_number": "३०", "content_sanskrit": "न त्वेते हेतवः सन्ति ये केचिन्मूर्तिसंस्थिताः ।\nअमर्त्यस्य हि मर्त्येन सामान्यं नोपपद्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2188221, "chapter_id": 5000, "verse_number": "३१", "content_sanskrit": "अविद्याकर्मचेष्टानां केचिदाहुः पुनर्भवम् ।\nकारणं लोभमोहौ तु दोषाणां च निषेवणम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2188222, "chapter_id": 5000, "verse_number": "३२", "content_sanskrit": "अविद्यां क्षेत्रमाहुर्हि कर्म बीजं तथा कृतम् ।\nतृष्णासञ्जननं स्नेह एष तेषां पुनर्भवः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2188223, "chapter_id": 5000, "verse_number": "३३", "content_sanskrit": "तस्मिन् व्यूढे च दग्धे च चित्ते मरणधर्मिणि ।\nअन्योऽन्याज्जायते देहस्तमाहुः सत्त्वसङ्क्षयम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2188224, "chapter_id": 5000, "verse_number": "३४", "content_sanskrit": "यतः स्वरूपतश्चान्यो जातितः श्रुतितोऽर्थतः ।\nकथमस्मिन् स इत्येव सम्बन्धः स्यादसंहितः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2188225, "chapter_id": 5000, "verse_number": "३५", "content_sanskrit": "एवं सति च का प्रीतिर्दानविद्यातपोबलैः ।\nयदन्याचरितं कर्म सर्वमन्यः प्रपद्यते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2188226, "chapter_id": 5000, "verse_number": "३६", "content_sanskrit": "यदा ह्ययमिहैवान्यैः प्राकृतैर्दुःखितो भवेत् ।\nसुखितैर्दुःखितैर्वापि दृश्योऽप्यस्य विनिर्णयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2188227, "chapter_id": 5000, "verse_number": "३७", "content_sanskrit": "यदा(था) हि मुसलैर्हन्युः शरीरं तत् पुनर्भवेत् ।\nपृथग्ज्ञानं यदन्यस्य तेनैतन्नोपलभ्यते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2188228, "chapter_id": 5000, "verse_number": "३८", "content_sanskrit": "ऋतुः संवत्सरास्तिथ्यः शीतोष्णे च प्रियाप्रिये ।\nयथातीतानि पश्यन्ति तादृशः सत्त्वसङ्क्षयः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2188229, "chapter_id": 5000, "verse_number": "३९", "content_sanskrit": "जरया हि परीतस्य मृत्युना वा विनाशिना ।\nदुर्बलं दुर्बलं पूर्वं गृहस्येव विनश्यति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2188230, "chapter_id": 5000, "verse_number": "४०", "content_sanskrit": "इन्द्रियाणि मनो वायुः शोणितं मांसमस्थि च ।\nआनुपूर्व्या विनश्यन्ति स्वं धातुमुपयान्ति च\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2188231, "chapter_id": 5000, "verse_number": "४१", "content_sanskrit": "लोकयात्राविधानं च दानधर्मफलागमः ।\nयदर्थं वेदशब्दाश्च व्यवहाराश्च लौकिकाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2188232, "chapter_id": 5000, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकोनपञ्चाशोऽध्यायः ॥ ४९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]